--
--------------------------------------------------------------------------------
--
-- File:    Mdsreaddefs.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          UREADDEF
--
-- Author:    N.morris
-- Created:		Thu Sep 4
--
--
-- Description:
-- Reads Defaults file for MDS and populates form variables
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--  Form    R        Form          Form name to populate
--  Prefix  R        Array         Prefix to look for to populate with
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
-- Define Function
define function !!mdsreadDefs(!form is FORM, !prefix is ARRAY)

  --------------------------------------------------------------------
  !currentUnits = !!kgetSetUnits()
  --------------------------------------------------------------------

  -- We need to turn off the WitchHanger menu call and only turn it on
  -- if !!mdshangif eq CPL, this is later in the code.
  if !prefix[1].eq('MDS') then
    !!appdesmain.sysset.setFieldProperty('WHDBSEL', 'VISIBLE', FALSE)
    handle ANY
      -- Trap in case we are 11.4/11.5
    endhandle

    --<wd>23nov2006
    -- Set the Witch Hanger Print Utility on the MDS Utilities Menu to "INVISIBLE"
    !!appdesmain.sysutil.setFieldProperty('mdsWhPrint', 'VISIBLE', FALSE)
    handle ANY
      -- Trap in case we are 11.4/11.5
    endhandle
    --<wd>23nov2006

  endif

-- Initialise Variables
  !dtext = ARRAY()
  !rtext = ARRAY()
  !prefixes = !prefix

---------------------------------------------------------------------------------------------------
--<wd>--feb2006--<mds12>
--
-->-- Read the DES-SUPP-DEFS defaults file to load selections
-->-- Open File and read defaults
  -->  OPENFILE /$!!mdsFILES.dESCRIPTION READ !read
-->  handle any
  -->    !!alert.error('File $!!mdsFILES.dESCRIPTION could not be found in the project defaults directory')
-->--Restore Current units
  -->    !!kRestoreUnits(!currentunits)
  -->    return !aBORT
-->  endhandle
--
--<wd>--feb2006--<mds12>
---------------------------------------------------------------------------------------------------

  -- Introduction of a new form !!mdsFlangeGaps initiated from the !!mdsOptions form
-- SET the FLANGE GAP default values to 0[ZERO] as the MDS defaults file has no value
  do !loopThroughPrefixes values !prefixes
    if !loopThroughPrefixes.eq('MDS') then
      !!mdsFlangeGaps.gap1.val = 0
      !!mdsFlangeGaps.gap2.val = 0
    endif
  enddo

  do

    READFILE $!read !record
      handle (41,325)
      CLOSEFILE $!read
        break
      endhandle

    if (match(!record,|#|) eq 1)then
      skip
    endif

    if (!record eq ||)then
      skip
    endif

-- Find prefix
-- MDS will be the prefix for the globals required for design
    -- FT        = Multi Discipline Support frameworks
-- CT        = Cable Rack Frameworks
-- DT        = HVAC Frameworks
-- AT and AC = General Ancillaries
-- FH        = Fixed Hangers
-- VH        = Variable Hangers
-- GT and ST = Guides and Stops
-- MH        = Hanger
    !records = split(!record,|\|)

    do !pre values !prefixes
      if (match(!records[1].upcase().trim(),|MDS|) eq 1) and (|$!pre| eq |MDS|) then
        if (!records[1].upcase().trim() eq |MDSSUPPCL|) then
          !!mdsOptions.clear.val = !records[2].trim().real()
          skip
        elseif (!records[1].upcase().trim() eq |MDSSUPPOV|) then
          !!mdsOptions.overLap.val = !records[2].trim().real()
          skip
        elseif (!records[1].upcase().trim() eq |MDSSUPPMS|) then
          !!mdsOptions.slope.val = !records[2].trim()
          skip
        elseif (!records[1].upcase().trim() eq |MDSPACKDI|) then
          !!mdsOptions.packing.val = !records[2].trim().real()
          skip
        elseif (!records[1].upcase().trim() eq |MDSPACKMO|) then
          !!mdsOptions.maxPack.val = !records[2].trim().real()
          skip
        elseif (!records[1].upcase().trim() eq |MDSTRUNNLEN|) then
          !!mdsOptions.trunnLen.val = !records[2].trim().real()
          !!mdsOptions.trunnLen.active = FALSE
          skip
        elseif (!records[1].upcase().trim() eq |MDSMAXHANG|) then
          !maxAng = !records[2].trim()
          !!mdsOptions.maxAng = !maxAng.real()
          !!mdsOptions.pMaxAng.val   = 'Max. Pipe Angle      = $!!mdsOptions.maxAng degrees'
          skip
        elseif (!records[1].upcase().trim() eq |MDSMAXPIVA|) then
          !maxAng = !records[2].trim()
          !!mdsOptions.maxPiva = !maxAng.real()
          !!mdsOptions.pMaxPiva.val ='Max. Pivot Angle     = $!!mdsOptions.maxPiva degrees'
          skip
        elseif (!records[1].upcase().trim() eq |MDSPIVWARN|) then
          !maxAng = !records[2].trim()
          !!mdsOptions.maxPwar = !maxAng.real()
          !!mdsOptions.pMaxPwar.val = 'User Warning Angle   = $!!mdsOptions.maxPwar degrees'
          skip
        elseif (!records[1].upcase().trim() eq |MDSMINHANG|) then
          !minHang = !records[2].trim()
          !!mdsOptions.minHangRod = !minHang.real()
          !!mdsOptions.pMinHangRod.val = !minHang.real()
          -- !!mdsOptions.pMinHangRod.val = 'Min. Rod Length      = $!!mdsOptions.minHangRod'
          skip
        elseif (!records[1].upcase().trim() eq |MDSSPECPRE|) then
          !specPre = !records[2].trim()
          !!mdsOptions.specPre = !specPre.string()
          !!mdsOptions.pspecPre.val = 'Special Num. Prefix  = $!!mdsOptions.specPre'
          skip
        elseif (!records[1].upcase().trim() eq |MDSTRANPREF|) then
          !tranPref = !records[2].trim()
          !!mdsOptions.tranPref = !tranPref.string()
          !!mdsOptions.pTranPref.val = 'Transport Prefix     = $!!mdsOptions.tranPref'
          skip
          --xxx        elseif (!records[1].upcase().trim() eq |MDSTRANTEXT|) then
        elseif (!records[1].upcase().trim() eq |MDSTRANISO|) then
          !tranText = !records[2].trim().replace('#/','')
          -- !!mdsOptions.tranText = !tranText.string()
          !!mdsOptions.pPTranText.val = 'Transport Text       = '
          !!mdsOptions.pTranText.val = !tranText
          skip
        elseif (!records[1].upcase().trim() eq |MDSSPECFLA|) then
          !specFla = !records[2].trim()
          !!mdsOptions.specFla = !specFla.boolean()
          if (!!mdsOptions.specFla) then
            !!mdsOptions.pSpecFla.val = 'Special Num. Unique  = Yes'
          else
            !!mdsOptions.pSpecFla.val = 'Special Num. Unique  = No'
          endif
          skip
          --<wd>13aug2004
        elseif (!records[1].upcase().trim() eq |MDSSPECON|) then
          !!mdsSPECON.delete()
          handle ANY
          endhandle
          !!mdsSPECON = !records[2].trim().boolean()
          skip
          --<wd>13aug2004
        elseif (!records[1].upcase().trim() eq |MDSCONNS|) then
          !conntype = !records[2].trim()
          !!mdsOptions.createCons.select('RTEXT',!conntype)
        elseif (!records[1].upcase().trim() eq |MDSCONNMODS|) then
          !connmod = !records[2].trim()
          !!mdsOptions.connMods.select('RTEXT',!connmod)
-- SJR 12/09/02 - Added new representation level default
        elseif (!records[1].upcase().trim() eq |MDSLEVCHANGE|) then
          if (!records[2].trim().eq('')) then
            !!alert.error('Level change contains invalid value - default of level 7 assumed')
            !levChange = 7
          else
            !levChange = !records[2].trim().real()
            handle ANY
              !!alert.error('Level change contains invalid value - default of level 7 assumed')
              !levChange = 7
            endhandle
          endif
          !!mdsOptions.levChange = !levChange
          !!mdsOptions.pLevChange.val = 'Alternate Repr Level = ' + !levChange.string()
        elseif (!records[1].upcase().trim() eq |MDSOFFSET|) then
          !offset = !records[2].trim()
          !!mdsOptions.offset.val = !offset.real()
        elseif (!records[1].upcase().trim() eq |MDSWEITAG|) then
          !!mdsWEITAG = !records[2].trim()
        elseif (!records[1].upcase().trim() eq |MDSWEIUNIT|) then
          !!mdsWEIUNIT = !records[2].trim()
        elseif (!records[1].upcase().trim() eq |MDSFLAGAP|) then
          !offset = !records[2].trim()
          !!mdsFlangeGaps.gap1.val = !offset.real()
          !!mdsFlangeGaps.gap2.val = !offset.real()
        else
--> Added by <ab> to read any additional global variable - Apr 8 2002
          !!$!records[1] = !records[2].trim()
--< Added by <ab> to read any additional global variable - Apr 8 2002
          -- If its the MDSHANGIF variable then we need to check if its CPL
          -- and if so activate the menu call to the WitchHanger DB selection
          -- The menu pick has been set turned off earlier in the code
          if !records[1].eq('MDSHANGIF') and !records[2].trim().eq('CPL') then
            !!appdesmain.sysset.setFieldProperty('WHDBSEL', 'VISIBLE', TRUE)
            -- <GE> 15/11/06 removed this >>--->  !!alert.error('on')

            --<wd>23nov2006
            -- Using "CPL" Witch Hanger/MDSInterface, so set the Print Utility on the MDS Utilities Menu to "VISIBLE"
            !!appdesmain.sysutil.setFieldProperty('mdsWhPrint', 'VISIBLE', TRUE)
            --<wd>23nov2006
          endif
        endif

      elseif (!records[1].upcase().trim() eq |MPU|) then
        !!mPU = !records[2].trim()
---------------------------------------------------------------------------------------------------
--<wd>mar2006--<mds12>
--
-- $!pre = THE passed PREFIX, e.g "FT" via the PML function
        -- !!mdsIFRAME() --> !!mdsPopulate(!!mdsFrame, FRAME)
--
--
--
      elseif (match(!records[1].upcase().trim(),|$!pre|) eq 1)then

        skip if (match(!records[1].trim(),'SPECIAL') gt 0) and !prefix[1] eq 'SP'
        -- !dtext.append(!records[2].trim() & !records[3])
        !trimmed = !records[2].trim()
        if !trimmed.length().leq(8) then
          do from !trimmed.length() to 8
            !trimmed = !trimmed + ' '
          enddo
        endif
        if defined(!!mdsDEBUG) then
          !dtext.append(!records[1].trim() & '-' & !trimmed & !records[3].trim())
        else
          !dtext.append(!trimmed & !records[3].trim())
        endif
        !rtext.append(!records[1].trim())


-- Create SELECTION and RESTRICTION list apart from PIPE-REST and RACK-REST
-- Skip if default file loading encounters support that does not require
-- ancillary restrictions
        skip if (!records[1].trim() eq 'PIPE-REST')
        skip if (!records[1].trim() eq 'RACK-REST')
        --><wd>6mar2009 - Defect No. P16924
        skip if (!records[1].trim() eq 'PIPE-REST-INLINE')

        --><wd>6mar2009 - Defect No. P16924
        -- To enable the setting of the MDS ATTA NWELDS attribute all 'AT' standards will now have a MDSSELECTION object
        --skip if (match(!records[1].trim(),'AT') gt 0)
        skip if (match(!records[1].trim(),'BT') gt 0)
        -- skip if (match(!records[1].trim(),'CT') gt 0)
        -- skip if (match(!records[1].trim(),'DT') gt 0)
        skip if (match(!records[1].trim(),'FH') gt 0)
        skip if (match(!records[1].trim(),'VH') gt 0)
        skip if (match(!records[1].trim(),'HT') gt 0)
        skip if (match(!records[1].trim(),'MH') gt 0)
        if (match(!records[1].trim(),'GT') gt 0) then
          if (match(!records[1].trim(),'GT05') gt 0) then
          elseif (match(!records[1].trim(),'GT09') gt 0) then
          elseif (match(!records[1].trim(),'GT10') gt 0) then
          else
            skip
          endif
        endif
        -- skip if (match(!records[1].trim(),'GT') gt 0)

        --><wd>6mar2009 - Defect No. P16924
        -- To enable the setting of the MDS ATTA NWELDS attribute all 'ST' standards will now have a MDSSELECTION object
        --<dw>jan2009 dun1081 - To allow for shoe type selection & restriction for stop attachment - P-16048
        --          if (match(!records[1].trim(),'ST') gt 0) then
        --            if (match(!records[1].trim(),'ST43') gt 0) then
        --            elseif (match(!records[1].trim(),'ST44') gt 0) then
        --            else
        --               skip
        --            endif
        --          endif
        -- skip if (match(!records[1].trim(),'ST') gt 0)
        --<dw>jan2009 dun1081 - End of allowing for shoe type selection & restriction for stop attachment
        --<<wd>6mar2009 - Defect No. P16924

        !var = 'MdsSel' & !records[1].trim()
        var !!$!var delete
        !!$!var = object MDSSELECTION()
        !temp = object MDSSELECTION()
        !selList = split(!records[4].trim(),',')
        handle ANY
          skip
        endhandle
        do !addSel values !selList
          !temp.selection.append(!addSel.upcase())
        enddo
        !resList = split(!records[5].trim(),',')
        --><wd>6mar2009 - Defect No. P16924
        handle ANY
          skip
        endhandle
        --><wd>6mar2009 - Defect No. P16924

------------------------------------------------------------------
--<wd>feb2003
--<wd>july2003
-- ** IMPORTANT NOTE **
-- Isolation Pads 'AT40*, AT41* and AT42*' are now allowed to be selected on 'FT' MDS Framework Supports
-- ** -------------- **
--<wd>july2003
-- The Isolation Pads AT40A-F and the Slide Units At41A-F are automatically added to the RESTRICTION List for ALL 'FT' FRAMEWORKS
-- Ancillaries AT40*, AT41* and AT42 are similar to MDS 'SU*' Slip Units and these are NOT ALLOWED on MDS FRAMEWORKS
-- Ancillaries AT43, AT44, AT45 and AT46 are PIPE PENETRATION SEALS (e.g. 'BESTOBELL') for WALLS & FLOORS

          if (!records[1].matchwild('FT*')) then

-- MDS STANDARD Frameworks ONLY
-- ****************************

          -- This CODE is ONLY used when called by !!mdsPopulate(!!mdsFrame,'frame') i.e. for MDS FRAMEWORKS only
-- Always RESTRICT these groups of ANCILLARIES on 'ALL' MDS Standard TEMPLATE FRAMEWORKS <with the "FT" prefix etc...>

--<wd>29jan2004
-- AT33*, AT34*, AT35, AT59, AT68 Trunn Slides etc.. NOW allowed on MDS 'FT' FRAMEWORKS
          --!resList.append('AT33*') $* Isolation Pad for Trunnion Base Plates
          --!resList.append('AT34*') $* Slide Unit for Trunnion Base Plates
          --!resList.append('AT35')  $* Cold Isolation Pad with Cage for Trunnion Base Plates
--<wd>oct2003
          --!resList.append('AT59')  $* Cold Isolation Block with Integral Base Plate for Trunnion Base Plates
          --!resList.append('AT68')  $* Cold Isolation Block with Integral Base Plate for Trunnion Base Plates
--<wd>29jan2004

--<wd>oct2003
--<wd>july2003
-- The Isolation Pads commented out/shown below are now allowed to be selected on 'FT' MDS Framework Supports
-- Therefore they have been 'commented out' below
          --!resList.append('AT40*') $* Isolation Pads
          --!resList.append('AT41*') $* Slide Units
          --!resList.append('AT42*') $* PTFE Isolation Pad
--<wd>july2003

          !resList.append('AT43*') $* Pipe Penetration Single Seal
          !resList.append('AT44*') $* Pipe Penetration Single Seal
          !resList.append('AT45*') $* Pipe Penetration Double Seal
          !resList.append('AT46*') $* Pipe Penetration Double Seal

----------------------------------------------------------------------------------
--<wd>jan2004
-- RESTRICT MDS Standards GT11; GT12A; GT12B; GT20; ST07; ST08; AN05 which are ONLY ALLOWED on "MDS SPECIAL FRAMEWORKS"
--<wd>29jan2004

$(--<wd>feb2004
-- Commented OUT now because IMPROVED functionality i.e. 'PIPE-REST-INLINE' available
-- Therefore Trunnions are NOW allowed on MDS 'FT' FRAMEWORKS
!resList.append('GT11')  $* Trunnion Base Plate Guide
!resList.append('GT12A') $* Trunnion Base Plate Guide
!resList.append('GT12B') $* Trunnion Base Plate Guide
!resList.append('GT27A') $* Trunnion Base Plate Guide
!resList.append('GT27B') $* Trunnion Base Plate Guide
!resList.append('ST07')  $* Trunnion Base Plate Stop
!resList.append('ST08')  $* Trunnion Base Plate Stop
!resList.append('AN05*') $* Trunnion Base Plate Ancho
$)
-- RESTRICT the OLD TRUNNION ATTA Pedestals and GUIDE
          !resList.append('GT20')  $* Pedestal Base Plate Guide
          !resList.append('AT10A') $* Pedestal Atta
          !resList.append('AT10B') $* Pedestal Atta
          !resList.append('AT11A') $* Pedestal Atta
          !resList.append('AT11B') $* Pedestal Atta
          !resList.append('AN01*') $* Anchor Type Pedestal Atta
--<wd>jan2004
----------------------------------------------------------------------------------

          endif
--<wd>feb2003
------------------------------------------------------------------

        do !addRes values !resList
          !temp.restriction.append(!addRes.upcase())
          enddo
        !temp.restriction.unique()

-- Add MTOC setting (appearance on isometric)
        !temp.mtoc = !records[6].boolean()
        handle ANY
          !temp.mtoc = TRUE
            endhandle

        ------------------------------------------------------------------
        --><wd>06mar2009 - Defect No. P16924
        -- Set the MDS default SPOOLER NWELD fields for the required types of MDS ATTA type supports ONLY
        -- where the ATTAS are BRANCH members of (i) real PIPE Branch types and (ii) MDS TRUNNION Branch types
        -- EXCLUDE all the MDS STRUCTURAL FRAMEWORK and all REST Support Types
        -- ALSO Check whether to EXCLUDE the MDS Trunnions etc...-- or !records[1].matchwild('TT*').not()
        if (!records[1].replace(' ','').matchwild('FT*').not() or !records[1].matchwild('CT*').not() or !records[1].matchwild('DT*').not() or !records[1].matchwild('VT*').not() or !records[1].matchwild('*REST*').not() ) then
          !bothWelds = !records[7].replace(' ','').split(',')
          handle ANY
            -- The MDSSELECTION object Constructor method .mdsSelection() sets the appropriate object members
            -- to the MDSSELECTION default values "0,0" for the NWELDS members .pipeWeld and .trunWeld respectively.
          elsehandle NONE
            -- Set the Object member value for a real PIPE branch
            !temp.pipeWeld = !bothWelds[1].real()
            handle ANY
              --
            endhandle
            -- Set the Object member value for a MDS TRUNNION PIPE branch
            !temp.trunWeld = !bothWelds[2].real()
            handle ANY
            endhandle
          endhandle
          --$P *** MDS Std. Type *** $!var ***
        endif
        --<<wd>06mar2009 - Defect No. P16924
        ------------------------------------------------------------------

        -- Set the MDSSELECTION object for the Current MDSSupport Type
        var !!$!var delete
        !!$!var = !temp

      endif

    enddo

  enddo

-- Set Form Gadget
  !form.standard.dtext = !dtext
  handle NONE
    !form.standard.rtext = !rtext
  elsehandle ANY
    endhandle

-- If the prefix is either FH or VH then set the number of standards available
  !!mdsHangerNum(!form,!prefixes[1])

--------------------------------------------------------------------
--Restore Current units
  !!kRestoreUnits(!currentunits)
--------------------------------------------------------------------

-- End function
endfunction
