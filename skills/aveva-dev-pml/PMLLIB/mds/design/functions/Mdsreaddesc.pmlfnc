--
-- File:		Mdsreaddesc.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Tue 5 MAy
--
--
-- Description:
-- Reads Defaults file for MDS and populates a global variable with
-- the support description. This is used by Isorun to display the support
-- description in the material list.
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsReadDesc()

-- Read default file to load descriptions

-- Open File and read defaults

  OPENFILE /$!!MDSFILES.DESCRIPTION READ !READ
    handle any
      OPENFILE $!!MDSFILES.DESCRIPTION READ !READ
        handle any
          !!Alert.error('File $!!MDSFILES.DESCRIPTION could not be found in the project defaults directory')
          return !ABORT
        endhandle
    endhandle

  do !LineNumber

    READFILE $!Read !Record
      handle (41,325)
        CLOSEFILE $!Read
        break
      endhandle

    if (match(!Record,|#|) eq 1)then
      skip
    endif

    if (!Record eq ||)then
      skip
    endif

-- Find all supports except for the application defaults starting with
-- MDS

    !Records = split(!Record,'\')

    if (match(!Records[1].upcase().Trim(),|MDS|) eq 1) then
      skip
    elseif (match(!Records[1].upcase().Trim(),|MPU|) eq 1) then
      skip
    elseif (match(!Records[1].upcase().Trim(),|PIPE-REST-INLINE|) eq 1) then
      !Trimmed = !Records[3].after('-').trim()
      !!DESCPIPERESTINLINE = !Trimmed
      skip
    elseif (match(!Records[1].upcase().Trim(),|PIPE-REST|) eq 1) then
      !Trimmed = !Records[3].after('-').trim()
      !!DESCPIPEREST = !Trimmed
      skip
    elseif (match(!Records[1].upcase().Trim(),|PIPE-REST-INLINE|) eq 1) then
      skip
    elseif (match(!Records[1].upcase().Trim(),|RACK-REST|) eq 1) then
      skip
    elseif (match(!Records[1].upcase().Trim(),|HVAC-REST|) eq 1) then
      skip
    elseif (match(!Records[1].upcase().Trim(),|SPECIAL|) eq 1) then
      skip
    else
      !Trimmed = !Records[3].after('-').trim()
      !desc = '!!DESC' + !Records[1].trim()
      $!Desc = !Trimmed
      -- $!Desc = !records[3]
    endif

  enddo

-- Load the Replacement Codes as well eg. AT01 is coded as 'XAT01'
  !!Mdsreadcode()


-- End function
endfunction

-- End of file Mdsreaddefs.pml
