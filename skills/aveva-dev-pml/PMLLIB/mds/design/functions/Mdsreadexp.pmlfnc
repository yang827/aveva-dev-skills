--
--
-- Description: Read support type into default load form
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsreadexp()

-- Access to this form is controlled by the DESADMIN team membership, check and error if not a member
  if !!CDLNDESADMIN.boolean().not() then
    !!Alert.Error('Access to the dimensions control form is controlled by membership of the DESADMIN team. Access denied!')
    return
  endif

  -- Open File and read in support standards

  OPENFILE /$!!MDSFILES.DESCRIPTION READ !READ
    handle any
      !!Alert.error('File $!!MDSFILES.DESCRIPTION could not be found in the project defaults directory')
      return
    endhandle

  !!MdsExpDflts.Standard.clear()
  !Dtext = array()
  !Rtext = array()

  do !LineNumber

    READFILE $!Read !Record
      handle (41,325)
        CLOSEFILE $!Read
        break
      endhandle

    if (match(!Record,|#|) eq 1)then
      skip
    elseif (match(!Record,|SPECIAL|) eq 1)then
      skip
    endif

    !Matched = false

    if !Record.match(!!MdsExpDflts.Catagory.Selection('Rtext')).eq(1) then
      !Split = !Record.Split('\')
  -- Strip the A or B off the end of the standard if it exists
      !Test1 = !Split[1].trim().length()
      !Test2 = !Split[1].trim().substring(!test1).trim()
      !Desc = !Split[1]
      !Alphabet = 'ABCDEFGHIJKLMNOPRSTUVWXYZ'
      if !Alphabet.match(!Test2.trim()).gt(0) then
        !matched = true
        !Saved = !Split[1]
        !Split[1] = !Split[1].trim().substring(1,(!Test1 - 1))
      endif
      if !!Mdsexpdflts.viewstandard.val then
        if !matched then
          !Standard = !!Code$!Saved
            handle any
              !Dtext.append(!Desc)
            elsehandle none
              !Desc = !Desc.trim()
              !Dtext.append('$!Standard ($!Desc)')
            endhandle
          !Rtext.append(!Split[1].trim())
        else
          !Standard = !!Code$!Split[1]
            handle any
              !Dtext.append(!Split[1])
            elsehandle none
              !Desc = !desc.trim()
              !Dtext.append('$!Standard ($!Desc)')
            endhandle
          !Rtext.append(!Split[1].trim())
        endif
      else
        !Dtext.append(!Split[1])
        !Rtext.append(!Split[1].trim())
      endif

    endif

  enddo

  -- Sort array so that it removes duplicate entries

  -- !Dtext.unique()
  -- !Rtext.unique()

  -- Finally add to standard list

  !!MdsExpDflts.Standard.Dtext = !Dtext
  !!MdsExpDflts.Standard.Rtext = !Rtext

  -- Finally show form
  !!MdsExpDflts.show()

endfunction
-- End function

-- End of file Mdsreadexp.pml
