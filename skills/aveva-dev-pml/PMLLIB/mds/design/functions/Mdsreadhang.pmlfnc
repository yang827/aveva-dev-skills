--
-- File:		Mdsreadhang.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		S.Robinson
-- Created:		Wed 8 Oct
--
--
-- Description:
-- Sets passed object members with parameters passed in 2nd and 3rd arguments
--
-----------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]      [Description]
--     1     RW       OBJECT MdsHANG Parameter string
--
-- Return:
--    [Data Type]   [Description]
--    BOOLEAN       TRUE is parameters have been read correctly
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsReadHang(!Object is MdsHANG, !Vendor is STRING, !RodArray is ARRAY, !ParamString is STRING) is BOOLEAN

  !currentunits = !!kgetsetunits()

  -- Initialise Variables

  -- set vendor description
  !Object.Vendor  = !Vendor

  -- append rod selection list
  !Rod = object MdsRodMinMax()
  do !RodSel values !RodArray
     !Split   = !RodSel.Split(',')
     !Rod.ID  = !Split[1]
     !Rod.Min = !Split[2].Real()
     !Rod.Max = !Split[3].Real()
     !Object.Rods.Append(!Rod)
  enddo

  -- split parameter string into array
  !Params = !ParamString.Split('\')


  -- set design parameter array

  -- check for expressions in any of the design parameters
  if (!Params[1].Match('(') neq 0) then

    !DPs = !Params[1].Split()

    -- loop through array of design parameter values and check for
    -- expressions enclosed in ()'s, these need to be concatenated into
    -- a single expression entry in the design parameter array by matching all '()' pairs!

    !Expression      = ''
    !ExpressionLevel = 0
    !InExpression    = false
    !DesPars         = ARRAY()

    do !I index !DPs

      if (!InExpression) then

        -- check for expression level 0...i.e. we have matched all () pairs
        -- and have a complete expression to append to the output array
        if (!ExpressionLevel eq 0) then
          -- append to despar array
          !DesPars.Append(!Expression)
          -- clear out the expression string
          !Expression = ''
          -- reset the InExpression logical
          !InExpression = false

        else

          -- check for further expression levels '('
          if (!DPs[!I].Match('(') neq 0) then
            -- count number of '(' and increment counter accordingly
            !ExpressionLevel = !ExpressionLevel + !DPs[!I].Occurs('(')
            -- count number of ')' and decrement counter accordingly
            !ExpressionLevel = !ExpressionLevel - !DPs[!I].Occurs(')')
            -- update the expression string
            !Expression = !Expression + ' ' + !DPs[!I]
            if (!ExpressionLevel eq 0) then
              -- append to despar array
              !DesPars.Append(!Expression)
              -- clear out the expression string
              !Expression = ''
              -- reset the InExpression logical
              !InExpression = false
            elseif (!ExpressionLevel lt 0) then
              $p [Mdsreadhang] ERROR: Too many closing brackets in expression for design parameter
              !!kRestoreUnits(!currentunits)
              return FALSE
            endif
          elseif (!DPs[!I].Match(')') neq 0) then
            -- closing expression ')' found
            -- count number of '(' and increment counter accordingly
            !ExpressionLevel = !ExpressionLevel + !DPs[!I].Occurs('(')
            -- count number of ')' and decrement counter accordingly
            !ExpressionLevel = !ExpressionLevel - !DPs[!I].Occurs(')')
            !Expression = !Expression + ' ' + !DPs[!I]
            if (!ExpressionLevel eq 0) then
              -- append to despar array
              !DesPars.Append(!Expression)
              -- clear out the expression string
              !Expression = ''
              -- reset the InExpression logical
              !InExpression = false
            elseif (!ExpressionLevel lt 0) then
              $p [Mdsreadhang] ERROR: Too many closing brackets in expression for design parameter
              !!kRestoreUnits(!currentunits)
              return FALSE
            endif
          elseif (!ExpressionLevel lt 0) then
            $p [Mdsreadhang] ERROR: Too many closing brackets in expression for design parameter
            !!kRestoreUnits(!currentunits)
            return FALSE
          else
            -- just add this part of the expression to the last
            !Expression = !Expression + ' ' + !DPs[!I]
          endif
        endif

      else

        -- check for start of new expression
        if (!DPs[!I].Match('(') neq 0) then
          !InExpression = true
          -- count number of '(' and increment counter accordingly
          !ExpressionLevel = !ExpressionLevel + !DPs[!I].Occurs('(')
          -- count number of ')' and decrement counter accordingly
          !ExpressionLevel = !ExpressionLevel - !DPs[!I].Occurs(')')
          !Expression = !DPs[!I]
          if (!ExpressionLevel eq 0) then
            -- append to despar array
            !DesPars.Append(!Expression)
            -- clear out the expression string
            !Expression = ''
            -- reset the InExpression logical
            !InExpression = false
          elseif (!ExpressionLevel lt 0) then
            $p [Mdsreadhang] ERROR: Too many closing brackets in expression for design parameter
            !!kRestoreUnits(!currentunits)
            return FALSE
          endif
        -- check for invalid close of expression
        elseif (!DPs[!I].Match(')') neq 0) then
          $p [Mdsreadhang] WARNING: Expression contains unnecessary closing bracket ')' in design parameter definition
          !!kRestoreUnits(!currentunits)
          return FALSE
        else
          -- append to despar array
          !DesPars.Append(!DPs[!I])
        endif

      endif

    enddo

    -- check that we have left despar loop with all expressions closed
    if (!InExpression) then
      $p [Mdsreadhang] ERROR: Incomplete expression in design parameter definition
      !!kRestoreUnits(!currentunits)
      return FALSE
    elseif (!ExpressionLevel gt 0) then
      $p [Mdsreadhang] ERROR: Incomplete expression in design parameter definition
      !!kRestoreUnits(!currentunits)
      return FALSE
    elseif (!ExpressionLevel lt 0) then
      $p [Mdsreadhang] ERROR: Too many closing brackets in expression for design parameter
      !!kRestoreUnits(!currentunits)
      return FALSE
    endif

    !Object.DesPars = !Despars

  else

    !Object.DesPars = !Params[1].Split()

  endif

  -- get user editable DP numbers and associated Min and Max values
  !UDP   = OBJECT MdsDPMINMAX()
  handle (2,767) $* invalid object type
    -- attempt to load object
    !!KLoadObject('MdsDPMINMAX')
    !UDP   = OBJECT MdsDPMINMAX()
  endhandle



  !UDPs  = !Params[2].Split()
  do !Dps values !UDPs
    !SplitUDPs = !Dps.Split(',')
    if (arraysize(!SplitUDPs) neq 0) then
      !UDP.DPNum = !SplitUDPs[1].Real()
      !UDP.Min   = !SplitUDPs[2].Real()
      !UDP.Max   = !SplitUDPs[3].Real()
      !Object.UserDPs[!UDP.DPNum] = !UDP
    endif
  enddo

  -- get alternative expression
  !Expr = !Params[3].Trim()
  if (!Expr neq '') then
    !Object.AltExpr = !Params[3].Trim()
  endif

  -- get alternative design parameters
  !ADP  = OBJECT MdsDPVAL()
  handle (2,767) $* invalid object type
    -- attempt to load object
    !!KLoadObject('MdsDPVAL')
    !ADP  = OBJECT MdsDPVAL()
  endhandle
  !ADPs = !Params[4].Split()
  do !Index index !ADPs
    !SplitADPs  = !ADPs[!Index].Split(',')
    if (arraysize(!SplitADPs) neq 0) then
      !ADP.DPNum  = !SplitADPs[1].Real()
      !ADP.AltVal = !SplitADPs[2].Real()
      !Object.AltDesPars[!Index] = !ADP
    endif
  enddo

-- get material
  !Object.Material = !Params[5].Trim()

-- get weight
  !Object.Weight = !Params[6].Trim().Real()

-- get Weld/Drill size details
  !Object.WeldSize = !Params[7].Trim()

-- get PROPCON 'SOLID element type', i.e the PDMS NAME of the Material Reference
  !Object.Matref = !Params[8].Trim()

-- get material code
  !Object.PipeMaterial = !Params[9].Trim()

-- get Shop flag
  !Object.Shop = !Params[10].Trim().boolean()
  !!kRestoreUnits(!currentunits)
  return TRUE

-- End function
endfunction

-- End of file Mdsreadhang.pml
