--
-- File:		Mdsreadtrun.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		S.Robinson
-- Created:		Wed 8 Oct
--
--
-- Description:
-- Sets passed object members with parameters passed in 2nd and 3rd arguments
--
-----------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]      [Description]
--     1     RW       OBJECT MdsTRUN Parameter string
--
-- Return:
--    [Data Type]   [Description]
--    BOOLEAN       TRUE is parameters have been read correctly
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsReadTrun(!object is MdsTRUN, !Vendor is string, !RodArray is array, !ParamString is string) is boolean

  !currentunits = !!kgetsetunits()

  -- split parameter string into array
  !Temp = !ParamString.Split('\')
  !Params = !Temp[1].Split(' ')

-- Remove all empty params caused by multiple spaces

  do !RemoveSpaces from 1 to !Params.size()
    if !Params[$!RemoveSpaces].eq('') or !Params[$!RemoveSpaces].eq('') then
      !Params[$!RemoveSpaces].delete()
    endif
  enddo

  !Params.Compress()

  -- Parameters will be default size,minimum size, maximum size,available bores

  !object.Default = !Params[1].real()
    handle any
    endhandle
  !object.Minimum = !Params[2].real()
    handle any
    endhandle
  !object.Maximum = !Params[3].real()
    handle any
    endhandle
  !Counter = 1

  do !Sizes from 4 to !Params.size()
    skip if !Params[$!Sizes].string().trim().eq('')
    !object.Bores[$!Counter] = !Params[$!Sizes].before(',')
    !object.StypeS[$!Counter] = !Params[$!Sizes].after(',')
    !Counter = !Counter + 1
  enddo

--<tm addition to get user defined despars>
  -- get user editable DP numbers and associated Min and Max values
  !UDP   = object MdsDPMINMAX()
  handle (2,767) $* invalid object type
    -- attempt to load object
    !!KLoadObject('MdsDPMINMAX')
    !UDP   = object MdsDPMINMAX()
  endhandle

  !UDPs  = !temp[2].Split()
  do !Dps values !UDPs
    !SplitUDPs = !Dps.Split(',')
    if (arraysize(!SplitUDPs) neq 0) then
      !UDP.DPNum = !SplitUDPs[1].real()
      !UDP.Min   = !SplitUDPs[2].real()
      !UDP.Max   = !SplitUDPs[3].real()
      !object.UserDPs[!UDP.DPNum] = !UDP
    endif
  enddo
-- end of tm addition

-- Set pipe material settings

  !object.PipeMaterial = !Temp[9].trim()

-- Set shop flag with temp[10]

  !object.Shop = !Temp[10].trim().boolean()

  !!kRestoreUnits(!currentunits)
  return TRUE

-- End function
endfunction

-- End of file MdsReadTrun.pml
