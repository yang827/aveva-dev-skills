-- Author:		Andrew Kirkland
-- Created:		Tues 23rd June 1998
--
--
-- Description:
-- Function to extract available jlines to use.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF        [Structure of support]
-- Return:
--    [Data Type]   [Description]
--    [Boolean]     [Return whether or not there were any failures]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsRealignNodes(!Structure is dbref) is boolean

  -- Initialise Variables
     !Refe = !!CE
     !OK = TRUE

   -- get all the snodes
      !Snodes = !!KcollectAllFor('SNOD','',!Structure)

      if(!Snodes.unset().not()) then
         do !Si values !Snodes
            !!CE = !Si
            zdist thro cref of sjoi 1
            handle any
            !OK = FALSE
            endhandle
         enddo
      endif



!!CE = !Refe

Return !OK

-- End function
endfunction

-- End of file MdsRealignNodes.pml
