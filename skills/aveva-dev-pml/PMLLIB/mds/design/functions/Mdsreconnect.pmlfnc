--
--
-- Description:
-- Function to reconnect the joints to the verticals.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        Array        [joints to be reconnected]
-- Return:
--    [Data Type]   [Description]
--    [Boolean]     [Was there any errors.]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsReConnect(!Joints is array) is boolean

!Refe = !!CE
!Return = True

  do !Joint values !Joints

   !!CE = !Joint

   Reconn Recalc

    handle any
      !Return = False
    endhandle

  enddo





!!CE = !Refe

Return !Return

-- End function
endfunction

-- End of file MdsReConnect.pml
