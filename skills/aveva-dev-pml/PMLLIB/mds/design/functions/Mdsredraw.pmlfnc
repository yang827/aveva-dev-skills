--
-- File:		MdsReDraw.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Mon 13th July 1998
--
--
-- Description:
-- Function to get colour of passed dbref (temporary while graphics dont update
-- used only on items below sctn
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF        [Dbref of item to interrogate]
-- Return:
--    [Data Type]   [Description]
--    [String]      [command string to re add into the draw list]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsReDraw(!Item is dbref) is string

  -- Initialise Variables

     !Refe = !!CE
     sctn
      handle any
       !ReturnCommand = 'rem ce add ce'
      elsehandle none
       !ItemOwner = !!CE
        -- check if item is named
        if(!ItemOwner.Refe.string().eq(!ItemOwner.namn)) then
        -- not named
           !TestString = !ItemOwner.refe.string()
        else
        -- named
           !TestString = !ItemOwner.name
        endif

        -- load system form with drawlist
           VAR SELECTOR !!KSelector.Select
           CLEAR
           Drawlist full
           EXIT

         !Find = !!KSelector.Select.dtext.findfirst(!TestString)
         if(!Find.unset()) then
            !ReturnCommand = 'rem ce add ce'
         else
            !ColourNo = !Find + 2
            !Colour   = !!KSelector.Select.dtext[!ColourNo].before(')')
            !ReturnCommand = 'rem $!ItemOwner add $!ItemOwner colour $!Colour'
         endif
      endhandle


      !!CE = !Refe


      Return !ReturnCommand


-- End function
endfunction

-- End of file MdsReDraw.pml
