-- Created:		Wed Jul 02
--
--
-- Description:
-- function to set the reinforcing pad option for AN06
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsReinPad(!Form is FORM)

  -- Initialise variables
    !Support = !Form.Support

  -- Check that atta exists
    if (!Support.Datum.badref())then
      !Form.ReinPad.val = false
      !!Alert.message('Support datum has to exist before setting the reinforcing pad option')
      return
    endif

  -- The pad option cannot be turned on if the :MDSPipeMat of the pipe spec is not eq SS

    if !Support.Datum.Owner.Pspe.:MDSPipeMat.neq('SS') then
      !Form.ReinPad.val = false
      !!Alert.message('Can only select a reinforcing pad if the owning pipe is SS')
      return
    endif

  -- Access the atta and change the :MDSPad uda

    !!MdsDacControl(true)

    !!CE = !Form.Support.Datum
    if !Form.Reinpad.val then
      :MDSPad '-PAD'
    else
      :MDSPad ''
    endif

    !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdsreinpad.pml
