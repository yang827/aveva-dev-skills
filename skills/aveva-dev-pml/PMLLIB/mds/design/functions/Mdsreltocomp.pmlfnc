--
-- File:		Mdsreltocomp.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 17th December 1997
--
--
-- Description:
-- Function to Check if the Identified Element is SUITABLE for Supporting a
-- FRAMEWORK type 'VT01'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         DBREF        Support Datum
--     2     R         DBREF        Identified element to support from.
--                                  Vertical Panels are allowed and
--                                  Vertical Cylinders may be Identified when
--                                  Building Vessel Framework Types ONLY
--     3     R        DIRECTION     Direction from datum point
--     4     R         REAL         Tolerance for positional data
--     5     R         FORM         Form name
--     6     R         STRING       First or Second Pick
--     7     R         REAL         Halfwidth of Framework
--
-- Return:
--    [Data Type]   [Description]
--      ARRAY        1. Return one of the following:
--                      ''         = Element Unsuitable to Support From.
--                      'unset'    = Element Unsuitable to Support From.
--                      'UPPER'    = Element will NOT Support Upper Framework
--                                   members with sufficient Clearance
--                      'LOWER'    = Element will NOT Support Framework Bracing
--                                   members(either on FIRST or SECOND Elements Identified
--                      'DIAMETER' = Cylinder Diameter is NOT large enough to Support Framework
--                                   members with sufficient Clearance
--                      'WIDTH'    = Panel Width s NOT large enough to Support Framework
--                                   members with sufficient Clearance
--                      'OK'       = FIRST and/or SECOND Element is 'OK' to Support Framework
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsreltocomp(!datum is DBREF, !element is DBREF, !dir is DIRECTION, !clear is REAL, !form is FORM, !picknum is STRING, !halfwidth is REAL) is ARRAY

------------------------------------
    !currentunits = !!kgetsetunits()
------------------------------------
-- Initialise variables
    !array = ARRAY()

-- Store Pin 1 Position and Direction
    var !p1pos pin 1 pos wrt /*
    var !p1dir pin 1 dir wrt /*
    !pin1pos = !p1pos.position()
    !pin1dir = !p1dir.direction()

-- Store Pin 2 Position and Direction
    var !p2pos pin 2 pos wrt /*
    var !p2dir pin 2 dir wrt /*
    !pin2pos = !p2pos.position()
    !pin2dir = !p2dir.direction()

-- Check that the element is suitable
--xxx    if (!element.type inset('SCTN', 'PANE', 'BOX', 'CYLI')) then
    if (!element.hardtype inset('PANE','CYLI')) then
      golabel /Start
    else
--xxx      !!alert.error('Picked element is not suitable to support from. Identify Cylinders, Sections, Panels or Boxes only.')
      !!alert.error('Picked element is not suitable to support from. Identify Cylinders or Panels only.')
      !array[1] = ''
      !!kRestoreUnits(!currentunits)
      return !array
    endif

  label /Start

-- Navigate to datum point and get positional data
    !!ce = !datum
    var !datumline cons line $!dir thro P0

-- Navigate back
    !!ce = !element

-----------------------------------------------------------------------------
-----------------------------------------------------------------------------

-- ############################# CYLINDERS #################################

    if (!!ce.type eq 'CYLI')then

-----------------------------------------------------------------------------
-- 'FIRST' Cylinder Pin Positions
-- Note Pin Positions are CURRENTLY Determined in MdsCREATEVT01 function
-- Pin 1 at P1 of DATUM
-- Pin 2 on CL Pipe, level with 'P0' Origin of the Cylinder
-- Pin 7 at Bottom of Cylinder
-- Pin 8 at Top of Cylinder
-- Pin 9 on the 'Normal' Face of the Cylinder (Between the Cylinder P0 and the Trunnion Atta P0)
-- Pin 10 at the 'P0' Origin of the Cylinder
-----------------------------------------------------------------------------
-- 'SECOND' Cylinder Pin Positions
-- Note Pin Positions are CURRENTLY Determined in MdsCREATEVT01 function
-- Pin 1 at P1 of DATUM
-- Pin 2 on CL Pipe, level with 'P0' Origin of the 'SECOND' Cylinder
-- Pin 3 at the 'P0' Origin of the 'SECOND' Cylinder
-- Pin 4 at the 'Normal' Face of the 'SECOND' Cylinder (Between the Cylinder P0 and the Trunnion Atta P0)
-- Pin 7 at Bottom of 'FIRST' Cylinder
-- Pin 8 at Bottom of 'SECOND' Cylinder
-- Pin 9 on the 'Normal' Face of the 'FIRST' Cylinder (Between the Cylinder P0 and the Trunnion Atta P0)
-- Pin 10 at the 'P0' Origin of the 'FIRST' Cylinder
-----------------------------------------------------------------------------

-- General Check Cylinder has a Large Enough Diameter for the Framework Width
      if (!!ce.diameter.real().lt(!halfwidth * 2 + !clear * 2)) then
        !array[1] = 'DIAMETER'
        !!kRestoreUnits(!currentunits)
        return !array
      endif

-- Determine Distances between Pins
      var !pin7pin8dist cons dist pin 7 to plane pin 8
      var !pin1pin7dist cons dist pin 1 to plane pin 7
      var !pin1pin8dist cons dist pin 1 to plane pin 8

-- Determine Support Type and Size
      !supptype  = !form.support.type
      -- !selection = !form.size.selection('rtext')
      !Selection = !!MdsSetSteel.Size.Selection('Rtext')

-- Determine the Cross Bar Depth of {*-BAR-1}
      !!ce = /MDS/$!<supptype>/$!<selection>-BAR-1
--xxx
      pin 1 at stru
      pin 2 copy pin 1
      pin 2 dir d wrt /*
      pin 2 plane pin 2 clear 0 beh ce

      !dept = !!kstrreal('cons dist pin 1 to plane pin 2')
--Reset Pin 1 and 2 back to their Previous positions
      pin 1 dire $!pin1dir
      pin 1 at $!pin1pos
      pin 2 dire $!pin2dir
      pin 2 at $!pin2pos
-----------------------------------------------------------------------------
-- Framework Types VT01 and VT02 are Trunnions and have Vertical Bracings
      if (!supptype inset('VT01','VT02')) then

-- Distance from CL Datum to 'Normal' Face of Cylinder
        var !pin1pin9dist cons dist pin 1 to plane pin 9

-- Position pin 6 at P9 of Datum
        pin 6 copy p9 of $!datum

-- Trunnion Size for VT01 and VT02 Type Frameworks
        --!tsize = !datum.catref.param[5]
        !tsref = !!mdsgetsuppname(!form.support.packs[1]) & '/SREF'
        !tsize = !tsref.dbref().abor.real()

-- Navigate to Template '*-V1'
-- Determine the Vertical Angle(Longest Leg) Bracing Depth mitred at 45 degrees
        !!ce = /MDS/$!<supptype>/$!<selection>-V1

        pin 1 at stru
        pin 2 copy pin 1
        pin 2 dir e wrt /*
        pin 2 plane pin 2 clear 0 beh ce

        !yleg = !!kstrreal('cons dist pin 1 to plane pin 2')
--Reset Pin 1 and 2 back to their Previous positions
      pin 1 dire $!pin1dir
      pin 1 at $!pin1pos
      pin 2 dire $!pin2dir
      pin 2 at $!pin2pos

        !mitre    = !yleg.real() / (cos(45))

-----------------------------------------------------------------------------
-- Framework Types VT01 and VT02 are Trunnions and have Vertical Bracings
      elseif (!supptype inset('VT03','VT04','VT05','VT06')) then
        !tsize = 0
        !mitre = 0
-- Distance from CL Datum to 'Normal' Face of Cylinder
        var !pin1pin9dist '0'

-- Position pin 6 at P2 of Datum
        pin 6 copy p2 of $!datum

      endif

-----------------------------------------------------------------------------
-- Framework Types VT01 and VT02 MAY have ONE(FIRST) or TWO(SECOND) Picks
-- Framework Types VT03 and VT04 will ONLY ever have ONE(FIRST) Pick
      if (!picknum.upcase() eq 'FIRST') then
-----------------------------------------------------------------------------

--xxx$P !picknum is **$!picknum**
--xxx$P*********************

-- First Simple Test if CL of Trunnion Lies within the
-- Height of the Cylinder + Trunnion Diameter + Clearance

        if (!pin1pin7dist.real().int() + !pin1pin8dist.real().int() ge !pin7pin8dist.real() + !tsize + !clear) then
          !array[1] = 'unset'
          !!kRestoreUnits(!currentunits)
          return !array

        else
-- Check if Cross Bar and Vertical Bracing Fit On the Identified 'FIRST' Cylinder
-- with sufficient clearance as determined in the 'Clearance' gadget on the defaults form

-- Distance from Pin 6 to Top of Cylinder
          var !pin6pin8dist cons dist pin 6 to plane pin 8

-- Position Pin 5 at Bottom of Vertical Angle + Clearance
          pin 5 copy pin 6
          pin 5 dist ($!pin1pin9dist + $!dept + $!mitre + $!clear)

-- Distance from CL Datum to Bottom of Vertical Bracing + Clearance
          var !pin1pin5dist cons dist pin1 to plane pin 5

-- Check if Bottom of Vertical Bracing is 'Clearance' Above Bottom of Identified Cylinder
          if (!pin1pin5dist.real().int() gt !pin1pin7dist.real()) then
            !array[1] = 'LOWER'
            !!kRestoreUnits(!currentunits)
            return !array

-- Check if Bottom of Trunnion is at least 'Clearance' from the Top of the Cylinder
          elseif (!pin6pin8dist.real() lt !clear ) then
            !array[1] = 'UPPER'
            !!kRestoreUnits(!currentunits)
            return !array
          else
            !array[1] = 'OK'
            !!kRestoreUnits(!currentunits)
            return !array
          endif
        endif

-----------------------------------------------------------------------------
      elseif (!picknum.upcase() eq 'SECOND') then
-- Check 'Vertical Bracings' Fit onto the 'SECOND' Cylinder Pick
-----------------------------------------------------------------------------

--xxx$P !picknum is **$!picknum**
--xxx$P*********************

        var !pin7pos pin 7 pos wrt /*
        var !pin8pos pin 8 pos wrt /*

-- Check Bottom of 'SECOND' Cylinder is 'BELOW' the Bottom of the 'FIRST' Cylinder Pick
        if (!pin7pos.position().up lt !pin8pos.position().up) then
           !array[1] = 'LOWER'
           !!kRestoreUnits(!currentunits)
           return !array
        else

-- Position Pin 7 at top of 'SECOND' Cylinder
          pin 7 copy pin 8
          pin 7 plane pin 7 clear 0 inf $!element
          var !pin1pin7dist cons dist pin 1 to plane pin 7

-- Check if Vertical Bracing Fit On the Identified 'SECOND' Cylinder
-- with sufficient clearance as determined in the 'Clearance' gadget on the defaults form

-- Distance from CL Datum to 'Normal' Face of Cylinder
          var !pin1pin4dist cons dist pin 1 to plane pin 4

-- Position pin 6 at P9 of Datum
          pin 6 copy p9 of $!datum

-- Distance from Pin 6 to Top of 'SECOND' Cylinder
          var !pin6pin8dist cons dist pin 6 to plane pin 7

-- Position Pin 5 at Bottom of Vertical Angle + Clearance
          pin 5 copy pin 6
          pin 5 dist ($!pin1pin4dist + $!dept + $!mitre + $!clear)

-- Distance from CL Datum to Bottom of Vertical Bracing + Clearance
          var !pin1pin5dist cons dist pin1 to plane pin 5

-- Check if Bottom of Vertical Bracing is 'Clearance' Above Bottom of 'SECOND' Cylinder
          if (!pin1pin5dist.real().int() gt !pin1pin8dist.real()) then
            !array[1] = 'LOWER'
            !!kRestoreUnits(!currentunits)
            return !array

-- Check if Bottom of Vertical Bracing is 'Clearance' Below Top of 'SECOND' Cylinder
          elseif (!pin1pin7dist.real().int() gt !pin1pin5dist.real() - !mitre.real() - !clear - !clear ) then

            !array[1] = 'UPPER'
            !!kRestoreUnits(!currentunits)
            return !array
          else
            !array[1] = 'OK'
            !!kRestoreUnits(!currentunits)
            return !array
          endif

        endif
-----------------------------------------------------------------------------
      endif
-----------------------------------------------------------------------------

-- ############################## PANELS #################################
    elseif (!!ce.hardtype eq 'PANE')then

-----------------------------------------------------------------------------
-- 'FIRST' Panel Pin Positions
-- Note Pin Positions are CURRENTLY Determined in MdsCREATEVT01 function
-- Pin 1 at Origin of Panel
-- Pin 2 on CL Pipe, directed to the Vertical Face of the PANEL
-- Pins 5 and 6 on the Vertical Edges of the PANEL
-- Pin 7 at Bottom of Panel
-- Pin 8 at Top of Panel
-- Pin 9 on the 'Normal' Face of the Panel (Between the Nearest Face of the Panel and the Trunnion Atta P0)
-- Pin 10 at Intersection Point on CL Pipe and the Origin of the Panel(through Pin 1)
--        and directed the same as Pin 2
-----------------------------------------------------------------------------
-- 'SECOND' Panel Pin Positions
-- Note Pin Positions are CURRENTLY Determined in MdsCREATEVT01 function
-- Pin 1 at Origin of Panel
-- Pin 2 on CL Pipe, directed to the Vertical Face of the 'SECOND' Panel
-- Pin 4 at the 'Normal' Face of the 'SECOND' PANEL (Between the Nearest Face of the Panel and the Trunnion Atta P0)
-- Pins 5 and 6 on the Vertical Edges of the SECOND PANEL
-- Pin 7 at Bottom of 'FIRST' PANEL
-- Pin 8 at Bottom of 'SECOND' PANEL
-- Pin 9 on the 'Normal' Face of the 'FIRST' PANEL (Between the Nearest Face of the Panel and the Trunnion Atta P0)
-- Pin 10 at the 'P0' Origin of the 'FIRST' PANEL
-----------------------------------------------------------------------------

-- Check Framework will fit onto the WIDTH of Identified Panel
      var !pin2pin5dist cons dist pin 2 to plane pin 5
      var !pin2pin6dist cons dist pin 2 to plane pin 6
      var !pin5pin6dist cons dist pin 5 to plane pin 6
      if (!pin2pin5dist.real().nint() + !pin2pin6dist.real().nint() gt !pin5pin6dist.real().nint()) then
        !array[1] = 'WIDTH'
        !!kRestoreUnits(!currentunits)
        return !array
      else
-- Check if Framework is NOt to Close to Either Edge of the Panel
        if (!pin2pin5dist.real().nint() lt !halfwidth + !clear.real() or !pin2pin5dist.real().nint() lt !halfwidth + !clear.real()) then
          !array[1] = 'WIDTH'
          !!kRestoreUnits(!currentunits)
          return !array
        endif
      endif

-- Determine Distances between Top and Bottom of the Identified Panel
      var !pin7pin8dist cons dist pin 7 to plane pin 8
      var !pin2pin7dist cons dist pin 2 to plane pin 7
      var !pin2pin8dist cons dist pin 2 to plane pin 8

-- Determine Support Type and Size
      !supptype  = !form.support.type
      --!selection = !form.size.selection('rtext')
      !selection = !!MdsSetSteel.Size.Selection('Rtext')


-- Determine the Main Channel Cross Bar Depth
      !!ce = /MDS/$!<supptype>/$!<selection>-BAR-1
--xxx
      pin 1 at stru
      pin 2 copy pin 1
      pin 2 dir d wrt /*
      pin 2 plane pin 2 clear 0 beh ce

      !dept = !!kstrreal('cons dist pin 1 to plane pin 2')
--Reset Pin 1 and 2 back to their Previous positions
      pin 1 dire $!pin1dir
      pin 1 at $!pin1pos
      pin 2 dire $!pin2dir
      pin 2 at $!pin2pos
--xxx
--xxx      var !dept (prop DEPT of ce)
-----------------------------------------------------------------------------
-- Framework Types VT01 and VT02 are Trunnions and have Vertical Bracings
      if (!supptype inset('VT01','VT02')) then

-- Distance from CL Datum to 'Normal' Face of Panel
        var !pin2pin9dist cons dist pin 2 to plane pin 9

-- Position pin 6 at P9 of Datum
        pin 6 copy p9 of $!datum

-- Trunnion Size for VT01 and VT02 Type Frameworks
        --!tsize = !datum.catref.param[5]
        !tsref = '/' & !form.support.packs[1].name.part(3,'/') & '/SREF'
        !tsize = !tsref.dbref().abor.real()

-- Navigate to Template '*-V1'
-- Determine the Vertical Angle(Longest Leg) Bracing Depth mitred at 45 degrees
        !!ce = /MDS/$!<supptype>/$!<selection>-V1
--xxx
        pin 1 at stru
        pin 2 copy pin 1
        pin 2 dir e wrt /*
        pin 2 plane pin 2 clear 0 beh ce

        !yleg = !!kstrreal('cons dist pin 1 to plane pin 2')
--Reset Pin 1 and 2 back to their Previous positions
      pin 1 dire $!pin1dir
      pin 1 at $!pin1pos
      pin 2 dire $!pin2dir
      pin 2 at $!pin2pos
--xxx
--xxx        var !yleg (prop YLEG of ce)

        !mitre    = !yleg.real() / (cos(45))

-----------------------------------------------------------------------------
-- Framework Types VT03 and VT04 are Guides using AT01 and AT02 Shoes
-- and do NOT have any Vertical Bracings
      elseif (!supptype inset('VT03','VT04','VT05','VT06')) then

-- Distance from CL Datum to 'Normal' Face of Panel
        var !pin2pin9dist  '0'

-- Position pin 6 at P9 of Datum
        pin 6 copy p2 of $!datum

        !tsize = 0
        !mitre = 0

      endif

-----------------------------------------------------------------------------
-- Framework Types VT01 and VT02 MAY have ONE(FIRST) or TWO(SECOND) Picks
-- Framework Types VT03 and VT04 will ONLY ever have ONE(FIRST) Pick
      if (!picknum.upcase() eq 'FIRST') then
-----------------------------------------------------------------------------

--xxx$P !picknum is **$!picknum**
--xxx$P*********************

-- First Simple Test if CL of Trunnion Lies within the
-- Height of the Panel + Trunnion Diameter + Clearance

        if (!pin2pin7dist.real().int() + !pin2pin8dist.real().int() ge !pin7pin8dist.real() + !tsize + !clear) then
          !array[1] = 'unset'
          !!kRestoreUnits(!currentunits)
          return !array

        else
-- Check if Cross Bar and Vertical Bracing Fit On the Identified 'FIRST' Panel
-- with sufficient clearance as determined in the 'Clearance' gadget on the defaults form

--xxx-- Distance from CL Datum to 'Normal' Face of Panel
--xxx          var !pin2pin9dist cons dist pin 2 to plane pin 9
--xxx
--xxx-- Position pin 6 at P9 of Datum
--xxx          pin 6 copy p9 of $!datum

-- Distance from Pin 6 to Top of Panel
          var !pin6pin8dist cons dist pin 6 to plane pin 8

-- Position Pin 5 at Bottom of Vertical Angle + Clearance
          pin 5 copy pin 6
          pin 5 dist ($!pin2pin9dist + $!dept + $!mitre + $!clear)

-- Distance from CL Datum to Bottom of Vertical Bracing + Clearance
          var !pin2pin5dist cons dist pin2 to plane pin 5

-- Check if Bottom of Vertical Bracing is 'Clearance' Above Bottom of Identified Panel
          if (!pin2pin5dist.real().int() gt !pin2pin7dist.real()) then
            !array[1] = 'LOWER'
            !!kRestoreUnits(!currentunits)
            return !array

-- Check if Bottom of Trunnion is at least 'Clearance' from the Top of the Panel
          elseif (!pin6pin8dist.real() lt !clear ) then
            !array[1] = 'UPPER'
            !!kRestoreUnits(!currentunits)
            return !array
          else
            !array[1] = 'OK'
            !!kRestoreUnits(!currentunits)
            return !array
          endif
        endif

-----------------------------------------------------------------------------
      elseif (!picknum.upcase() eq 'SECOND') then
-- Check 'Vertical Bracings' Fit onto the 'SECOND' Panel Pick
-----------------------------------------------------------------------------

--xxx$P !picknum is **$!picknum**
--xxx$P*********************

        var !pin7pos pin 7 pos wrt /*
        var !pin8pos pin 8 pos wrt /*

-- Check Bottom of 'SECOND' Panel is 'BELOW' the Bottom of the 'FIRST' Panel Pick
        if (!pin7pos.position().up lt !pin8pos.position().up) then
           !array[1] = 'LOWER'
           !!kRestoreUnits(!currentunits)
           return !array
        else

-- Position Pin 7 at top of 'SECOND' Panel
          pin 7 copy pin 8
          pin 7 plane pin 7 clear 0 inf $!element
          var !pin7newpos pin 7 pos wrt /*
          !p7 = !pin7newpos.position()
          !p8 = !pin8pos.position()
          if (!p7.up eq !p8.up) then
             pin 7 plane pin 7 clear 0 beh $!element
          endif
          var !pin2pin7dist cons dist pin 2 to plane pin 7

-- Check if Vertical Bracing Fit On the Identified 'SECOND' Panel
-- with sufficient clearance as determined in the 'Clearance' gadget on the defaults form

-- Distance from CL Datum to 'Normal' Face of Panel
          var !pin2pin4dist cons dist pin 2 to plane pin 4

-- Position pin 6 at P9 of Datum
          pin 6 copy p9 of $!datum

-- Distance from Pin 6 to Top of 'SECOND' Panel
          var !pin6pin8dist cons dist pin 6 to plane pin 7

-- Position Pin 5 at Bottom of Vertical Angle + Clearance
          pin 5 copy pin 6
          pin 5 dist ($!pin2pin4dist + $!dept + $!mitre + $!clear)

-- Distance from CL Datum to Bottom of Vertical Bracing + Clearance
          var !pin2pin5dist cons dist pin2 to plane pin 5

-- Check if Bottom of Vertical Bracing is 'Clearance' Above Bottom of 'SECOND' Panel
          if (!pin2pin5dist.real().int() gt !pin2pin8dist.real()) then
            !array[1] = 'LOWER'
            !!kRestoreUnits(!currentunits)
            return !array

-- Check if Bottom of Vertical Bracing is 'Clearance' Below Top of 'SECOND' Panel
          elseif (!pin2pin7dist.real().int() gt !pin2pin5dist.real() - !mitre.real() - !clear - !clear ) then

            !array[1] = 'UPPER'
            !!kRestoreUnits(!currentunits)
            return !array
          else
            !array[1] = 'OK'
            !!kRestoreUnits(!currentunits)
            return !array
          endif

        endif

      endif

-----------------------------------------------------------------------------
-- These Elements NOT Required - WD/NM - Jan1998
--xxx    elseif (!!ce.type eq 'BOX')then
--xxx    elseif (!!ce.type eq 'SCTN')then
-----------------------------------------------------------------------------
    endif
-----------------------------------------------------------------------------

    !!kRestoreUnits(!currentunits)

  endfunction
-- End function

-- End of file Mdsreltocomp.pml
