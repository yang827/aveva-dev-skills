--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Thu Mar 08
--
--
-- Description:
-- function to rem and add an element to the drawlist
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          DBREF      Element to be removed and added
--     2     R          DBREF      Colour number
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsRemAdd(!Element is STRING,!Colour is REAL)

  rem $!Element
    handle any
      return
    endhandle
  if (!Colour gt 0 and !Colour lt 129) then
    add $!Element !Colour
      handle (16,212)
      endhandle
  else
    add $!Element
      handle (16,212)
      endhandle
  endif

-- End function
endfunction

-- End of file Mdsremadd.pml
