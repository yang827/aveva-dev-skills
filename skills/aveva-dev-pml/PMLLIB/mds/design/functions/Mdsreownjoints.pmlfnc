--
-- File:		Mdsreownjoints.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Tues 7th July 1998
--
--
-- Description:
-- Function to check to see if joints are owned by the correct sctns, and re-own
-- under the correct sctn if they are incorrect.
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1    [R]      [ARRAY]       [Joints to Check]
--     2    [R]      [ARRAY]       [Connections to check against]
--     3    [R]      [MdsSUPPORT] [Support reference]
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsreownjoints(!Joints is array, !Connections is array, !Support is Mdssupport)

  -- Initialise Variables
     !Refe = !!CE

   do !Jind indices !joints
      !CurrentOwner    = !Joints[!Jind].owner.owner
      !Cref            = !Joints[!Jind].cref
      !CheckUnderConns = !Connections.findfirst(!CurrentOwner)
      -- get vertical bars of the support

     -- if checkunderconns is unset then the joint is not under the correct sctn

        if(!CheckUnderConns.unset()) then

               !NewOwner = !!MdsGetBeamConn(!Support,!Cref)
               !!CE = !Newowner
               incl $!Joints[$!Jind].owner
               !!CE = !Joints[!Jind].owner
               !SnodePos =    !!MdsPosInterSctn(!Newowner,!Cref)
               zdist thro $!SnodePos

                !!CE = !Joints[!Jind]
                !WhichEnd = !!MdsNearestEnd(!Joints[!Jind], !Cref)

                if(!WhichEnd.eq('START')) then
                 !Position = POSS of $!cref wrt worl
                else
                 !Position = POSE of $!cref wrt worl
                endif

               -- if the posl is not recognised then find out nearest
                  !Pline = !!MdsNearestPline(!Joints[!Jind],!Position,'MID')
                  POSL $!Pline
                   var !Plindir ppline $!Pline of sctn dir wrt worl
                   CUTP $!Plindir wrt worl
                  reconn recalc
                  handle any
                  -- incase the wrong pline is used
                  -- on cancel problems occur (to sort out)
                  endhandle
        else
               -- if cancel is used set zdist back
               !!CE = !Joints[!Jind].owner
               !SnodePos =    !!MdsPosInterSctn(!CurrentOwner,!Cref)
               zdist thro $!SnodePos
               !!CE = !Joints[!Jind]
               reconn recalc
               handle (73,202)
               -- Structural Geometry Error if Joint is PARALLEL to the  ATTACHED MDS Vertical SCTN
               -- This ERROR will occur on VERTICAL Pipes when trying to RESTORE MDS Framework Joints etc...
               endhandle
        endif

   enddo

!!CE = !Refe
-- End function
endfunction

-- End of file kreownjoints.pml
