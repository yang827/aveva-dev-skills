--
--
-- Description:
-- Function to reset the modify anc form if a new spref is choosen
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsResetAnc()

-------------------------------------
  !currentunits = !!kgetsetunits()
-------------------------------------

-- Reset design parameters

  !Bore = pa bore
  !SuppType = !!CE.styp
  !Name = !!CE.name
  !ParVar = '!!MdsPar' + !SuppType

-- Reset height if neccesary

  var !Hei (prop HEI of ce )
    handle none
      !!MdsModAt.Height.Active = true
      !!MdsModAt.PHeight.Active = true
      !DpNum = !!MdsGetDesp('HEI')
      if (!!MdsAncill.SavedPars[1].set()) then
        !!MdsSetDesPar(!!CE,!dpnum,!!MdsAncill.SavedPars[1])
        !!MdsModAt.Height.val = !!MdsAncill.SavedPars[1]
      else
        var !dpval despar $!dpnum
        !!MdsSetDesPar(!!CE,!dpnum,!dpval)
        !!MdsModAt.Height.val = !dpval
      endif
    elsehandle any
      !!MdsModAt.Height.val = 0
      !!MdsModAt.Height.Active = false
      !!MdsModAt.PHeight.Active = false
    endhandle

-- Reset length if neccesary

  var !SaveLen (prop LEN of ce )
    handle none
      !!MdsModAt.Length.Active = true
      !!MdsModAt.PLength.Active = true
      !Dpnum = !!MdsGetDesp('LEN')
      if (!!MdsAncill.SavedPars[2].set()) then
        !!MdsSetDesPar(!!CE,!dpnum,!!MdsAncill.SavedPars[2])
        !!MdsModAt.Length.val = !!MdsAncill.SavedPars[2]
      else
        var !dpval despar $!dpnum
        !!MdsSetDesPar(!!CE,!dpnum,!dpval)
        !!MdsModAt.Length.val = !dpval
      endif
    elsehandle any
      !!MdsModAt.Length.val = 0
      !!MdsModAt.Length.Active = false
      !!MdsModAt.PLength.Active = false
    endhandle

-- Reset thickness if neccesary

  var !SaveThk (prop THK of ce )
    handle none
      !!MdsModAt.Thickness.Active = true
      !!MdsModAt.PThickness.Active = true
      !DpNum = !!MdsGetDesp('THK')
      if (!!MdsAncill.SavedPars[3].set()) then
        -- !Dpnum = $!ParVar[$!Bore].userdps[$!num].dpnum
        !!MdsSetDesPar(!!CE,!dpnum,!!MdsAncill.SavedPars[3])
        !!MdsModAt.Thickness.val = !!MdsAncill.SavedPars[3]
      else
        -- !Dpnum = $!ParVar[$!Bore].userdps[$!num].dpnum
        var !dpval despar $!dpnum
        !!MdsSetDesPar(!!CE,!dpnum,!dpval)
        !!MdsModAt.Thickness.val = !dpval
      endif
    elsehandle any
      !!MdsModAt.Thickness.val = 0
      !!MdsModAt.Thickness.Active = false
      !!MdsModAt.PThickness.Active = false
    endhandle


-- Reset clamp angle if neccesary

  var !SaveThk (prop ADEG of ce )
    handle none
      !!MdsModAt.Angle.Active = true
      !!MdsModAt.PAngle.Active = true
      !DpNum = !!MdsGetDesp('ADEG')
      if (!!MdsAncill.SavedPars[4].set()) then
        -- !Dpnum = $!ParVar[$!Bore].userdps[$!num].dpnum
        !!MdsSetDesPar(!!CE,!dpnum,!!MdsAncill.SavedPars[4])
        !!MdsModAt.Thickness.val = !!MdsAncill.SavedPars[4]
      else
        -- !Dpnum = $!ParVar[$!Bore].userdps[$!num].dpnum
        var !dpval despar $!dpnum
        !!MdsSetDesPar(!!CE,!dpnum,!dpval)
        !!MdsModAt.Thickness.val = !dpval
      endif
    elsehandle any
      !!MdsModAt.Angle.val = '0'
      !!MdsModAt.Angle.Active = false
      !!MdsModAt.PAngle.Active = false
    endhandle


-- Reset support centres if neccesary

  var !SaveCen (prop SCEN of ce )
    handle none
      !DpNum = !!MdsGetDesp('SCEN')
      if (!!MdsAncill.SavedPars[5].set()) then
        -- !Dpnum = $!ParVar[$!Bore].userdps[5].dpnum
        !!MdsSetDesPar(!!CE,!dpnum,!!MdsAncill.SavedPars[5])
      endif
    elsehandle any
    endhandle

  !!MdsResetGuide()

  !!kRestoreUnits(!currentunits)

-- End function
endfunction

-- End of file Mdsresetanc.pml
