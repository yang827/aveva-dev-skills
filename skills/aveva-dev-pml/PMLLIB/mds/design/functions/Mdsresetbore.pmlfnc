--
-- File:  Mdsresetbore.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Neale Morris
-- Created:  Wed 8 Oct
--
--
-- Description:
-- Sets passed object members with parameters passed in 2nd and 3rd arguments
--
-----------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]      [Description]
--     1     RW      FORM             The calling FORM
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsResetBore(!form is FORM)

  !currentUnits = !!kGetSetUnits()
  !!mdsDacControl(true)

  -- Access branch
  !!ce = !form.support.datum
  -- #####################################################################################################
  --<wd>08nov2007 -- TEMPORARY FIX applied until the OPTION gadget BEHAVIUOR is FIXED to work correctly!!!!
  -- This will be a problem for MOST MDS TRUNNIONS and may be a problem for PDMS in GENERAL -- Robin Langridge is investigating 08Nov2007
  handle ANY
    return
  endhandle
  -- DUN767 -- Problem (found by Bryn Tootell 07Nov2007) CREATING a TT04 TRUNNION on PIPE
  -- The ERROR raised is:
  --
  --  -->(2,822)   Cannot set current element to an unset reference
  --  --> In line 39 of PML function mdsresetbore
  --  -->  !!ce = !form.support.datum
  --  --> Called from line 1 of Command/Form Callback Command
  --  -->call !!mdsResetBore(!!mdsTT04)
  --  --> Called from line 321 of PML function mdssetdattt04
  --  -->    !callingForm.bore.dtext = !unitBore
  --  --> Called from line 1 of Command/Form Callback Command
  --  -->call !!mdssetdattt04(!!mdsTT04,'CREATE','TUBE')
  --
  -- The option gadget !!mdsTT04.bore is running this callback function when all that is being done
  -- is setting the !!mdsTT04.bore.dtext = !unitBore with an array of VALID bore sizes for the TRUNNIONS
  --
  -- This will be a problem for MOST MDS TRUNNIONS and may be a problem for PDMS in GENERAL -- Robin Langridge is investigating 08Nov2007
  --<wd>08nov2007 -- TEMPORARY FIX applied until the OPTION gadget BEHAVIOUR is FIXED to work correctly!!!!
  -- #####################################################################################################
  branch

  -- Can only reset the bore of a trunnion if it does not contain any other supports
  !mem = mem count
  !supportMem = 0
  !otherSupports = ARRAY()
  do !listMem from 1 to $!mem
    bran
    $!listMem
    !tempName = !!mdsgetsuppname(!!ce)
    if !!ce.owner.name.match(!tempName).eq(0) then
      !supportMem = !supportMem + 1
      !otherSupports.append(!!ce.name)
    endif
  enddo

  -- if !supportMem.gt(0) then
  -- !!alert.error('Cannot reset the bore of the support because it contains other supports')
  -- !bore = ptbore
  -- !form.bore.select('RTEXT',!bore.string().before('mm'))
  -- return
  -- endif

  !!ce = !form.support.datum
  branch
  tbor $!form.bore
  sel hstu

  -- The make up piece will require reseting to the new bore
  !!ce = !form.support.datum
  !supportName = !!ce.name.before('/DATUM')
  $!supportName/MAKEUP
  despar n1 $!form.bore
  sel lstu

  bran
  goto href
  !type = type
  !element = name
  var !radius const dist p0 to p1
  !od = pa od
  $!supportName/MAKEUP
  !tod = pl od

  if !type.eq('ELBO') then
    !hyp = !radius.real() + (!od / 2)
    !side1 = !radius.real() + (!tod / 2)
    !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))
  else
    -- Find smallest bore if redu
    if !type.eq('REDU') then
      !rb1 = pod 1 of $!element
      !rb2 = pod 2 of $!element
      if !rb1.gt(!rb2) then
        !od = !rb2
      else
        !od = !rb1
      endif
    endif
    !hyp = (!od / 2)
    if !form.support.type.eq('TT10') or !form.support.type.eq('TT11') or !form.support.type.eq('TT12') or !form.support.type.eq('TT13') or !form.support.type.eq('TT22') or !form.support.type.eq('TT26') or !form.support.type.eq('TT28') then
      !pthk = (prop pthk of prev)
      !hyp = !hyp + !pthk.real()
    endif
    !side1 = (!tod / 2)
    !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))
  endif

  despar n2 $!offset
  bran

  !members = !!ce.members
  !stypeCounter = 1
  do !reselect from 1 to !members.size()
    bran
    $!reselect

    --<wd>feb2003
    -- For Trunnion TYpe !!mdsTT23 Only
    -- Get the Existing Spec of the LSTU of the Existing Element and Select it at the end if Possible
    if (!form.eq(!!mdsTT23)) then
      !spec = name of spec of lstu
    endif
    --<wd>feb2003

    -- The first member may be a reinforcing plate AT29,AT31, or stop ST08
    -- if so skip it but change despars to the new od
    if !!ce.styp.match('AT29').gt(0) or !!ce.styp.match('AT31').gt(0) or !!ce.styp.match('AT105').gt(0) then
      !dps = despar
      !!mdsSetDesPars(!!ce)
      !!mdsDacControl(true)
      despar n1 $!dps[1]
      despar n2 $!tod
      despar n3 $!dps[3]
      skip
    elseif !!ce.styp.match('ST08').gt(0) or !!ce.styp.match('AN05').gt(0) or !!ce.styp.match('GT11').gt(0) or !!ce.styp.match('ST07').gt(0) then
      !stopStype = styp
      select spref with styp '$!stopStype' spec /MDS
      !!mdsSetDesPars(!!ce)
      !!mdsDacControl(true)
      skip
    endif
    -- It may be another support so of so change the bore of the support and reselect it with default parameters
    if (!otherSupports.find(!!ce.name).size().gt(0)) then
      !stype = styp
      !spec =  spec of spref

      if !spec.name eq '/MDS' then
        select spref with styp '$!stype' spec /MDS
        !!mdsSetDesPars(!!ce)
        !!mdsDacControl(true)
      elseif !spec.name eq '/MDF' then
        select spref with styp '$!stype' spec /MDF
        !!mdsSetDesPars(!!ce)
        !!mdsDacControl(true)
      endif
      sel lstu
      skip
    endif
    if !!ce.styp.match('MAKEUP').gt(0) then
      skip
    elseif !!ce.styp.match('FFW').gt(0) then
      --<wd>june2003
      select spref with styp '$!!ce.styp' spec /MDS
      --<wd>june2003
      skip
    elseif !!ce.name.match('NOTE').neq(0) then
      !stype = styp
      select spref with styp '$!stype' spec /MDS
    elseif !!ce.name.match('SREF').neq(0) then
      !stype = styp
      --<wd>feb2003
      if (!!ce.owner.:mdstrun) then
        select spref with styp '$!stype' spec /MDS
      else
        --<wd>feb2003
        select spref with styp '$!stype' spec /MDF
      endif
    else
      -- If its an AC45 save design para 15 as this is the angle
      if !!ce.styp.eq('AC45') then
        !savedDP = despar
      endif
      !stype = styp
      -- The trunnion may have a guide added so if its not the same support name select with the same styp
      if !!ce.stype.match('GT12').gt(0) or !!ce.stype.match('GT27').gt(0) then
        select spref with styp '$!stype' spec /MDS
      else
        bran
        !bore = ph bore
        same
        -- !bore = pa bore

        ---------------------------------------------------------------------------------------------------
        --<wd>apr2006<mds12>
        --!sstype = !!mdspar$!form.support.type[$!bore].stypes[!form.bore.val]
        --
        -- Available Trunnion Bores are NOW determined from the MDS DEFAULTS stored in the PARAGON DB CATALOGUE
        !mdsstd = !form.support.type.upcase()
        !rbore  = !bore.real().value()
        !mdstrunobj  = object MDSREADTRUNDATA()
        !mdstrundata = !mdstrunobj.mdstrundata(!mdsstd, !rbore)

        -- Check if the Trunnion type and bore is ACTIVE for the current PDMS Project
        if (!mdstrundata.not()) then
          -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
          if (!mdstrunobj.mdsstd.sactive.not()) then
            -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
            !errormessage = !mdstrunobj.mdsstd.smess
          elseif (!mdstrunobj.mdsstd.cactive.not()) then
            -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
            !errormessage = !mdstrunobj.mdsstd.cmess
          endif

          -- Advise USER and EXIT Trunnion Support Modification
          !!alert.error(!errormessage)
          unenhance all
          !!kRestoreUnits(!currentUnits)
          return

        else
          -- List the Available Trunnion Bore Sizes for the Current TRUNNION
          --!availbores = !mdstrunobj.bores
          !sstype = !mdstrunobj.stypes[!form.bore.val]

        endif
        --<wd>apr2006<mds12>



        --<wd>apr2006<mds12>
        ---------------------------------------------------------------------------------------------------

        !nStype = !sstype.split(',')
        select spref with styp '$!nStype[$!stypeCounter]' spec /MDS

        handle(42,501)(42,64)
          !!alert.error('Cannot select this STYPE $!nStype[$!stypeCounter] for the Trunnion Bore of the support')
          return
        endhandle

        -- Changing the bore size changes the plate size refresh the dimenions in the form
        -- if !stypeCounter.eq(1) then
        !savedElement = !!ce
        !savedStype = styp
        !stypeCounter = !stypeCounter + 1
      endif
      -- endif
      -- if the styp is AC20 then the size is worked from the pl bore
      -- flip the componet and then back again
      if !stype.eq('AC20') then
        flip
        !!mdsSetDesPars(!!ce)
        !!mdsDacControl(true)
        !allow = desp
        desp n4 0mm
        prev weld
        allow $!allow[4]
        nex
        flip
      else
        !!mdsSetDesPars(!!ce)
        !!mdsDacControl(true)
      endif
      -- If its an AC45 save design para 15 as this is the angle
      if !!ce.styp.eq('AC45') then
        despar n15 $!savedDP[15]
      endif
    endif
    --<wd>feb2003
    if (!form.eq(!!mdsTT23)) then
      sel lstu with spec $!spec
    else
      --<wd>feb2003
      sel lstu
    endif
  enddo

  $!supportName/SREF
  !bore = pa bore

  -- Reset position of members
  !atta = /$!form.name.val
  if !form.support.type.eq('TT21') then
    !!mdsSetTrunLen('GADGET',!form.tlength.val,!atta,'U WRT /*',!form.support.type,!form)
  elseif !form.support.type.upcase().eq('TT27') then
    !!mdsSetTrunLen('GADGET',!form.tlength.val,!atta,!form.direction.val,!form.support.type,!form)
  elseif !form.support.type.upcase().eq('TT37') then
    !!mdsSetTrunLen('GADGET',!form.tlength.val,!atta,!form.direction.val,!form.support.type,!form)
  else
    !!mdsSetTrunLen('GADGET',!form.tlength.val,!atta,'D WRT /*',!form.support.type,!form)
  endif


  if !form.support.type.eq('TT10') or !form.support.type.eq('TT11') or !form.support.type.eq('TT12') or !form.support.type.eq('TT13') or !form.support.type.eq('TT22') or !form.support.type.eq('TT28')then
    !!mdsDacControl(true)
    $!supportName/MAKEUP
    -- Design para 10 of the prev comp needs to be to the pl od of the make up piece
    -- to spread the clamps apart
    !plOdClamp = pl od
    prev
    despar n10 $!plOdClamp
    same
  endif


  -- Changing the bore size changes the plate size refresh the dimenions in the form
  !!ce = !savedElement
  !!mdsGetProp(!form.pLength,!form.pLength,'PLEN',!bore,'$!savedStype')
  !!mdsGetProp(!form.pWidth,!form.pWidth,'PWID',!bore,'$!savedStype')
  !!mdsGetProp(!form.pthk,!form.pthk,'pthk',!bore,'$!savedStype')
  !!mdsGetProp(!form.ilen,!form.ilen,'ILEN',!bore,'$!savedStype')
  handle any
  endhandle
  !!mdsGetProp(!form.clea,!form.clea,'CLEA',!bore,'$!savedStype')
  handle any
  endhandle

  !form.member.val = 1
  handle any
  endhandle
  call !!mdsselectatta(!form)
  handle any
  endhandle

  !!mdsDacControl(false)

  -- Reset units back
  !!kRestoreUnits(!currentUnits)

endfunction
