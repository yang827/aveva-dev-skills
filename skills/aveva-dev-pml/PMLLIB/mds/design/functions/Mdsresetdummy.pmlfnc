--
-- File: Mdsresetdummy.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author: N.morris
-- Created:  Wed 8 Oct
--
-- Description:
--
-----------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]      [Description]
--     1     RW       OBJECT MdsTRUN Parameter string
--
-- Return:
--    [Data Type]   [Description]
--    BOOLEAN       TRUE is parameters have been read correctly
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsresetdummy(!form is FORM)

  !!mdsDacControl(TRUE)

  !currentUnits = !!kGetSetUnits()

  -- Access branch
  !!ce = !form.support.datum
  branch

  -- Before the re-bore takes place find out if any other support exist on the trunnion
$(
  !mem = mem count
  !supportName = ARRAY()
  do !getSuppNames from 1 to !mem
    bran
    $!getSuppNames
    !supportName.append(!!mdsGetSuppName(!!ce))
  enddo
  !supportName.unique()
  if !supportName.size().gt(1) then
    !!alert.error('Unable to resize trunnion as it contains other supports')
    !!kRestoreUnits(!currentUnits)
    !!mdsDacControl(FALSE)
    bran
    mm bore
    !ptBore = pt bore
    !form.bore.select('RTEXT',!ptBore.string().before('mm'))
    !!kRestoreUnits(!currentUnits)
    return
  endif
$)

  -- Fix for HPD0028688
  !mem = mem count
  !supportName = ARRAY()
  do !getSuppNames from 1 to !mem
    bran
    $!getSuppNames
    !supportName.append(!!mdsGetSuppName(!!ce))
  enddo
  !supportName.unique()
  if !supportName.size().gt(1) then
    !!alert.message('Resizing trunnion, that contains other supports means they may need resizing')
  endif
  -- EOF

  bran
  tbor $!form.bore
  sel hstu

  -- The make up piece will require resetting to the new bore
  !!ce = !form.support.datum
  bran
  !mem = mem count
  do !findMakeup from 1 to !mem
    bran
    $!findMakeup
    if !!ce.styp.eq('MAKEUP') or !!ce.styp.eq('MAKEUPOFF') then
      break
    endif
  enddo
  despar n1 $!form.bore
  sel lstu
  !makeUp = !!ce

  bran
  --  !suppName = !!mdsGetSuppName(!!ce)
  !members = !!ce.members
  do !reselect from 1 to !members.size()
    bran
    $!reselect
    !styp = styp
    select with styp '$!styp' spec /MDS
    if !!ce.styp.match('TT').eq(0) and !!ce.type.neq('REDU') then
      !!mdsSetDesPars(!!ce)
      !!mdsDacControl(TRUE)
    endif
  enddo

  bran
  last mem
  conn to pt
  prev
  conn to next
  handle (7,3)
    fconn to next
  endhandle

  !!ce = !makeUp

  -- Work out the adjustment needed for the exact length to be added to the iso
  -- Work out horizontal offset
  -- and put in gadget
  bran
  goto href
  var !radius const dist p0 to p1
  !od = pa od
  !!ce = !makeUp
  !tOd = pl od

  !hyp = !radius.real() + (!od / 2)

  if !form.support.type.eq('TT24') or !form.support.type.eq('TT31') or !form.support.type.eq('TT32') then
    !pthk = (prop PTHK of prev)
    !hyp = !hyp + !pthk.real()
  endif

  if !form.support.type.eq('TT14') then
    !side1 = !radius.real() + (!tOd / 2) - !form.pOffSet.val
  elseif !form.support.type.eq('TT15') then
    !side1 = !radius.real() + (!tOd / 2) + !form.pOffSet.val
  elseif !form.support.type.eq('TT17') or !form.support.type.eq('TT24') or !form.support.type.eq('TT31') or !form.support.type.eq('TT32') then
    !side1 = (!tOd / 2)
  else
    !side1 = !radius.real() + (!tOd / 2) + !form.pOffSet.val
  endif
  !offSet = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))
  handle any
    !offSet = 0
  endhandle

  -- If its a TT16 then the offset is always 0
  if !form.string().eq('MDSTT16') then
    !offSet = 0
    !form.pOffSet.val = $!offSet
  endif

  despar n2 $!offSet
  nex
  conn
  handle (7,3)
    fconn
  endhandle

  bran
  last mem
  !bore =  pa bore
  !!mdsGetProp(!form.pLength,!form.pLength,'POD',!bore,'AC25')
  !!mdsGetProp(!form.pWidth,!form.pWidth,'PTHK',!bore,'AC25')

  -- despar 2 of the sref atta stores the bore so reset it
  $!form.support.datum.name$n/SREF
  despar n2 $!bore

  branch

  -- We will need to reset the offset if the bore changes
  !hOd = ph od
  !tOd = pt od
  !offSet = ((!hOd - !tOd) / 2)

  -- If its a TT16 then the offset is always 0
  if !form.string().eq('MDSTT16') then
    !offSet = 0
    !form.pOffSet.val = $!offSet
  endif

  if !form.support.type.neq('TT17') and !form.support.type.neq('TT24') and !form.support.type.neq('TT31') and !form.support.type.neq('TT32') then
    !form.pOffSet.val = $!offSet
    !!noOffsetMessage = false
    !!mdsModOffset(!form,'PWID',!form.pOffSet)
    !!noOffsetMessage = true
  endif

  !!mdsDacControl(FALSE)

  -- Reset units back
  !!kRestoreUnits(!currentUnits)

endfunction
