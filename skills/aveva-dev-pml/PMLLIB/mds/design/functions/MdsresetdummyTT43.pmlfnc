--
-- File: MdsresetdummyTT43.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: David Whiteside
-- Created: Thursday 11th September 2008
--
-- Description: Reset dummy TT43.  Dun979 MDS12 addition
--
-----------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]      [Description]
--     1     RW       OBJECT MdsTRUN Parameter string
--
-- Return:
--    [Data Type]   [Description]
--    BOOLEAN       TRUE is parameters have been read correctly
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsresetdummyTT43(!form is FORM)

  !!mdsDacControl(TRUE)
  !currentUnits = !!kGetSetUnits()

  -- Access branch
  !!ce = !form.support.datum
  branch

  -- Fix for HPD0028688
  !mem = mem count
  !supportName = ARRAY()
  do !getSuppNames from 1 to !mem
    bran
    $!getSuppNames
    !supportName.append(!!mdsGetSuppName(!!ce))
  enddo
  !supportName.unique()
  if !supportName.size().gt(1) then
    !!alert.message('Resizing trunnion, that contains other supports means they may need resizing')
  endif
  -- EOFix for HPD0028688

  bran
  tbor $!form.bore
  !unusedHbore = Hbore
  sel hstu

  -- The make up piece will require resetting to the new bore
  !!ce = !form.support.datum
  bran
  !mem = mem count
  do !findMakeup from 1 to !mem
    bran
    $!findMakeup
    if !!ce.styp.eq('MAKEUP') or !!ce.styp.eq('MAKEUPOFF') then
      break
    endif
  enddo
  despar n1 $!form.bore
  sel lstu

  !makeUp = !!ce
  --  !tBore = !form.bore.selection().real()
  bran
  --  !suppName = !!mdsGetSuppName(!!ce)
  !members = !!ce.members
  ---------------------------------------------------------------------------------------------------
  --<wd>apr2006<mds12>
  -- CHECK if TRUNNION STANDARD Available for the MAIN PIPE Bore
  branch
  !mBore  = !!ce.phbore.real().value()
  !mdsStd = 'TT43'
  !mdsTrunObj  = object MDSREADTRUNDATA()
  !mdsTrunData = !mdsTrunObj.mdsTrunData(!mdsStd, !mBore)

  if (!mdsTrunData.not()) then
    -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
    if (!mdsTrunObj.mdsStd.sactive.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
      !errormessage = !mdsTrunObj.mdsStd.smess
    elseif (!mdsTrunObj.mdsStd.cactive.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
      !errormessage = !mdsTrunObj.mdsStd.cmess
    endif
    !!alert.error(!errormessage)
    !!kRestoreUnits(!currentUnits)
    return
  endif
  --<wd>apr2006<mds12>
  ---------------------------------------------------------------------------------------------------
  do !reselect from 1 to !members.size()
    bran
    $!reselect
    !styp = styp

    if !!ce.type.eq('PLAT') then
      ---------------------------------------------------------------------------------------------------
      --<wd>apr2006<mds12>
      -- Determine the "!sStyp" via the new <mds12> TRUNNION Object and the NUMBER VALUE
      -- in the TRUNNION BORES AVAILABLE OPTION GADGET, i.e. !form.bore.val = [1], or [2], or [3] etc...
      !sStyp = !mdsTrunObj.stypes[!form.bore.val]
      --<wd>apr2006<mds12>
      ---------------------------------------------------------------------------------------------------
      !nStyp = !sStyp.split(',')
      --<dw>mar2009 dun1119 dun1052 - Maintain base plate orientation after re-connection to PT.
      --also allow for the existence of a stop and/or guide and frame datum as the last member(s)
      --position note for 'weep hole',third from last, a set distance above base plate.
      !plateDir  = p3 dir
      despara n7 70mm
      select with styp '$!nStyp[1]' spec /MDS
      !!mdsSetDesPars(!!ce)
      --<dw>oct2008 dun979 - End modification to maintain base plate orientation.
    else
      select with styp '$!styp' spec /MDS
      handle(42,501)
      endhandle
    endif
  enddo

  back
  do !reselect from 1 to 3
    bran
    $!reselect
    if !!ce.type.eq('PLAT') then
      conn and p3 is $!plateDir
    else
      conn
      handle (7,3)
        fconn
      endhandle
    endif
    if ($!reselect eq 3) then
      !note2dist = !form.setup[3].real().abs()
      dist $!note2dist from prev
    endif
  enddo
  forward
  next
  --<dw>mar2009 dun1119 - End modification to maintain base plate orientation.
  !!ce = !makeUp

  -- Work out the adjustment needed for the exact length to be added to the iso
  -- Work out horizontal offset
  -- and put in gadget

  bran
  !tOd = pt od
  goto href

  if !!ce.type.eq('REDU') or !!ce.type.eq('CROS') then
    !rb1 = pod 1
    !rb2 = pod 2
    if !rb1.gt(!rb2) then
      !od = !rb2
    else
      !od = !rb1
    endif
    !hyp = (!od / 2)
    !side1 = (!tOd / 2)
    !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))
    --><wd>16oct2009 - DFN - P-25077 (SI-15935)
    -- FIX when !offset is UNABLE to get a NEGATIVE SQRT
    -- An error occurs on a TEE when the arrive is P1 and the leave is P3.
    -- This does NOT occur using a TEE if the arrive is P1 and the leave is P2.
    handle ANY
      !offset = (sqrt ((!side1 * !side1) - (!hyp * !hyp)))
    endhandle
    --<<wd>16oct2009 - DFN - P-25077 (SI-15935)

  else
    var !radius const dist p0 to p1
    !od = pa od
    !!ce = !makeUp
    !tOd = pl od
    !hyp = !radius.real() + (!od / 2)
    !side1 = !radius.real() + (!tOd / 2) + !form.pOffset.val
    !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))
    handle ANY
      !offset = (sqrt ((!side1 * !side1) - (!hyp * !hyp)))
    endhandle
  endif

  !!ce = !makeUp

  despar n2 $!offset

  --<dw>mar2009 dun1119 Reconnect not required as next component already positioned above.
$(
  nex
  conn
  handle (7,3)
    fconn
  endhandle
$)
  bran
  last mem
  !bore =  pa bore

  if !nStyp[1] inset('AC60','AC64','AC65') then
    !form.pLength.tag = 'Base Length'
    !form.pLength.active = TRUE
    !!mdsGetProp(!form.pLength,!form.pLength,'PLEN',!bore,'AC64')
    !!mdsGetProp(!form.pWidth,!form.pWidth,'PWID',!bore,'AC64')
  endif

  -- despar 2 of the sref atta stores the bore so reset it
  $!form.support.datum.name$n/SREF
  !!mdsDacControl(TRUE)

  despar n2 $!bore
  branch

  -- We will need to reset the offset if the bore changes
  !hOd = ph od
  !tOd = pt od
  !offset = ((!hOd - !tOd) / 2)

  -- Position Texts
  !!ce = !form.support.datum
  !!ce = !!ce.owner.href
  --<wd>oct2003
  if (!!ce.type.eq('REDU')) then
    if (!!ce.abor.gt(!!ce.lbor)) then
      !pos = !!ce.apos.string()
    else
      !pos = !!ce.lpos.string()
    endif
  else
    var !pos pos wrt world
  endif

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Trunnion $<$!pos$>
  !!ce = !form.support.datum
  var !pos pos wrt world
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 211 Datum $<$!pos$>

  !!mdsDacControl(FALSE)

  -- Reset units back
  !!kRestoreUnits(!currentUnits)

endfunction
