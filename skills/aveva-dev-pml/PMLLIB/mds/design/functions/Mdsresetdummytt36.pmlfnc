--
-- File: Mdsresetdummytt36.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Wed 8 Oct
--
--
-- Description:
--
--
-----------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]      [Description]
--     1     RW       MDS TRUNNION TYPE FORM, i.e !!mdsTT36

--
-- Return:
--    [Data Type]   [Description]
--    BOOLEAN       TRUE if parameters have been read correctly
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsresetdummytt36(!form is FORM)

  !!mdsDacControl(TRUE)
  !currentUnits = !!kGetSetUnits()

  -- Access branch
  !!ce = !form.support.datum
  branch

  ---------------------------------------------------------------------------------------------------
$(
  -- Before the re-bore takes place find out if any other support exist on the trunnion
  -- Check if the bore has changed as we may be just changing the endplate type
  if !!mdsTT36.bore.selection().bore().neq(!!ce.tbore) then
    !mem = mem count
    !supportName = ARRAY()
    do !getSuppNames from 1 to !mem
      bran
      $!getSuppNames
      !supportName.append(!!mdsGetSuppName(!!ce))
    enddo
    !supportName.unique()
    if !supportName.size().gt(1) then
      !!alert.error('Unable to resize trunnion as it contains other supports')
      !!kRestoreUnits(!currentUnits)
      !!mdsDacControl(FALSE)
      bran
      mm bore
      !ptBore = pt bore
      -- Check if the plate is circular and select the correct one
      var !plat Coll all PLAT wi stype eq 'AC56' for ce
      if !plat.size().gt(0) then
        !sel = !ptBore.string() & ' C'
        !!mdsTT36.bore.select('DTEXT',!sel)
      else
        !form.bore.select('RTEXT',!ptBore.string().before('mm'))
      endif
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endif
$)
  ---------------------------------------------------------------------------------------------------

  -----------------------------
  -- Fix for HPD0028688
  !mem = mem count
  !supportName = ARRAY()
  do !getSuppNames from 1 to !mem
    bran
    $!getSuppNames
    !supportName.append(!!mdsGetSuppName(!!ce))
  enddo
  !supportName.unique()
  if !supportName.size().gt(1) then
    !!alert.message('Resizing trunnion, that contains other supports means they may need resizing')
  endif
  -- EOFix for HPD0028688
  -----------------------------

  bran
  tbor $!form.bore
  --  !hBore = HBore
  sel hstu

  -- The make up piece will require resetting to the new bore
  !!ce = !form.support.datum
  bran
  !mem = mem count
  do !findMakeup from 1 to !mem
    bran
    $!findMakeup
    if !!ce.styp.eq('MAKEUP') or !!ce.styp.eq('MAKEUPOFF') then
      break
    endif
  enddo
  despar n1 $!form.bore
  sel lstu

  !makeUp = !!ce
  --  !tBore = !form.bore.selection().real()
  bran
  --  !suppName = !!mdsGetSuppName(!!ce)
  !members  = !!ce.members

  ---------------------------------------------------------------------------------------------------
  --<wd>apr2006<mds12>
  -- CHECK if TRUNNION STANDARD Available for the MAIN PIPE Bore
  branch
  !mBore  = !!ce.phbore.real().value()
  !mdsStd = 'TT36'
  !mdsTrunObj  = object MDSREADTRUNDATA()
  !mdsTrunData = !mdsTrunObj.mdsTrunData(!mdsStd, !mBore)

  if (!mdsTrunData.not()) then
    -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
    if (!mdsTrunObj.mdsStd.sactive.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
      !errormessage = !mdsTrunObj.mdsStd.smess
    elseif (!mdsTrunObj.mdsStd.cactive.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
      !errormessage = !mdsTrunObj.mdsStd.cmess
    endif
    !!alert.error(!errormessage)
    !!kRestoreUnits(!currentUnits)
    return
  endif
  --<wd>apr2006<mds12>
  ---------------------------------------------------------------------------------------------------

  do !reselect from 1 to !members.size()
    bran
    $!reselect
    !styp = styp

    if !!ce.type.eq('PLAT') then

      ---------------------------------------------------------------------------------------------------
      --<wd>apr2006<mds12>
      -- Determine the "!sStyp" via the new <mds12> TRUNNION Object and the NUMBER VALUE
      -- in the TRUNNION BORES AVAILABLE OPTION GADGET, i.e. !form.bore.val = [1], or [2], or [3] etc...
      --!sStyp = !!mdsParTT36[!hBore.real()].stypes[!form.bore.val]
      !sStyp = !mdsTrunObj.stypes[!form.bore.val]
      --<wd>apr2006<mds12>
      ---------------------------------------------------------------------------------------------------

      !nStyp = !sStyp.split(',')
      select with styp '$!nStyp[1]' spec /MDS
      --!!mdsSetDesPars(!!ce)
      --handle ANY
      --endhandle
    else
      select with styp '$!styp' spec /MDS
    endif

    skip if (!styp eq 'ST14')

    if !!ce.styp.match('TT').eq(0) and !!ce.type.neq('REDU') and !!ce.styp.match('AT29A').eq(0) and !!ce.styp.match('AT29B').eq(0)then
      !!mdsSetDesPars(!!ce)
      !!mdsDacControl(TRUE)
    endif

  enddo

  bran
  last mem
  conn to pt
  prev
  conn to next
  handle (7,3)
    fconn to next
  endhandle

  !!ce = !makeUp

  -- Work out the adjustment needed for the exact length to be added to the iso
  -- Work out horizontal offset
  -- and put in gadget
  bran
  !tOd = pt od
  goto href

  if !!ce.type.eq('REDU') or !!ce.type.eq('CROS') then
    !rb1 = pod 1
    !rb2 = pod 2
    if !rb1.gt(!rb2) then
      !od = !rb2
    else
      !od = !rb1
    endif
    !hyp = (!od / 2)
    !side1 = (!tOd / 2)
    !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))
  else
    var !radius const dist p0 to p1
    !od = pa od
    !!ce = !makeUp
    !tOd = pl od
    !hyp = !radius.real() + (!od / 2)
    !side1 = !radius.real() + (!tOd / 2) + !form.pOffset.val
    !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))
    handle ANY
      !offset = (sqrt ((!side1 * !side1) - (!hyp * !hyp)))
    endhandle
  endif

  !!ce = !makeUp
  despar n2 $!offset

  nex
  conn
  handle (7,3)
    fconn
  endhandle

  bran
  last mem
  !bore =  pa bore

  if !nStyp[1].eq('AC56') then
    !form.pLength.tag = 'Base Diam'
    !form.pWidth.active = FALSE
    !form.pWidth.val = 0
    !!mdsGetProp(!form.pLength,!form.pLength,'PLEN',!bore,'AC56')
  else
    !form.pLength.tag = 'Base Length'
    !form.pLength.active = TRUE
    !!mdsGetProp(!form.pLength,!form.pLength,'PLEN',!bore,'AC18A')
    !!mdsGetProp(!form.pWidth,!form.pWidth,'PWID',!bore,'AC18A')
  endif

  -- despar 2 of the sref atta stores the bore so reset it
  $!form.support.datum.name$n/SREF
  !!mdsDacControl(TRUE)
  despar n2 $!bore

  branch
  -- We will need to reset the offset if the bore changes
  !hOd = ph od
  !tOd = pt od
  !offset = ((!hOd - !tOd) / 2)

  -- Position Texts
  !!ce = !form.support.datum
  !!ce = !!ce.owner.href
  --<wd>oct2003
  if (!!ce.type.eq('REDU')) then
    if (!!ce.abor.gt(!!ce.lbor)) then
      !pos = !!ce.apos.string()
    else
      !pos = !!ce.lpos.string()
    endif
  else
    var !pos pos wrt world
  endif

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Trunnion $<$!pos$>
  !!ce = !form.support.datum
  var !pos pos wrt world
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 211 Datum $<$!pos$>

  !!mdsDacControl(FALSE)

  -- Reset units back
  !!kRestoreUnits(!currentUnits)

endfunction
