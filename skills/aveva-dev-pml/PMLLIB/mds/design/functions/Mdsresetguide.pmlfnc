--
-- File:    Mdsresetguide.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Wed Oct 29
--
--
-- Description:
-- function to modify a guide if a shoe is modified
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsResetGuide()

  !start = !!ce
  !guide = :MDSGuideRef

-- Navigate to guide
  !!ce = !guide
    handle any
      return
    elsehandle none
      same
    !shoe = !!ce
      !!ce  = !guide
    endhandle

  !currentUnits = !!kGetSetUnits()

-- included GT500 to GT569 as shoe type guides
-- included GT570 to GT639 as pipe type guides
-- Some standards has trailing characters so get rid of them

  !std = !!mdsGetStdNum(!guide.styp)
  !bore = pa bore

  if !shoe.:MDSSuppType inset ('ST01','ST02','ST04','ST05') then
    var !propWidth (Prop SWID of $!shoe.name )
    !prop1 = 'WID'
    --<GE>aug2006 Added test to see if the shoe is an AT25 as it has specific named properties that are used
  elseif !shoe.:MDSSuppType inset ('AT73','AT25') then
    var !propWidth (Prop BWID of $!shoe.name )
    !prop1 = 'WID'
  elseif !shoe.stype inset ('AT25') then
    var !propWidth (Prop BWID of $!shoe.name )
    !prop1 = 'WID'
    --<GE>aug2006
  else
    var !propWidth (Prop FWID of $!shoe.name )
    handle (2,207)
      var !propWidth (Prop THK of $!shoe.name )
      handle any
      endhandle
      !prop1 = 'THK'
      elsehandle none
-- added this code to include functionality for GT19 RM (23/05/06)
      if !!ce.styp inset('GT19') then
        !prop1 = 'SWID'
        else
        !prop1 = 'WID'
        endif
      endhandle
  endif

  var !propHeight (Prop HEI of $!shoe.name )
     handle (2,207)
    var !propHeight (Prop THK of $!shoe.name )
       handle any
       endhandle
    !prop2 = 'THK'
     elsehandle none
    !prop2 = 'HEI'
     endhandle

   -- included GT19 RM (23/05/06)
  if !std[1].eq('GT') and !std[2].real().geq(500) and !std[2].real().leq(569) then
     !gtce = !!ce
    !!ce = !guide
    var !propHeight (Prop HEI of $!shoe.name )
    var !propWidth (PROP FWID of $!shoe.name )
    !!ce = !gtce
    !dpNum = !!mdsGetDesp('HEI')
    !!mdsSetDespar(!!ce,!dpNum,!propHeight.real())
    !dpNum = !!mdsGetDesp('WID')
    !!mdsSetDespar(!!ce,!dpNum,!propWidth.real())
    --<dw>mar2009 dun1119 GT62 to GT64, GT70 to GT72, ST43 & ST44 added
  elseif (!!ce.styp inset('GT01','GT03','GT06','GT07','GT08','GT21','GT18','GT19','GT62','GT63','GT64','GT70','GT71','GT72','ST43','ST44')) then
    !dpNum = !!mdsGetDesp('$!prop1')
    !!mdsSetDespar(!!ce,!dpNum,!propWidth.real())
    !dpNum = !!mdsGetDesp('$!prop2')
    !!mdsSetDespar(!!ce,!dpNum,!propHeight.real())
    if (!!ce.styp inset('GT07')) then
       if (!bore.lt(400)) then
-- Thickness of Shoe Flange
        var !propFthk (Prop FTHK of $!shoe.name )
-- Bottom Clearance Gap for Guide GT07
        var !propCLRB (Prop CLRB of $!guide.name )
-- Thickness of Top Flange of Angle Section
        var !propSTLT (Prop STLT of $!guide.name )
-- Set the DesPar Number associated with the Property STLH (Guide Steel Height)
        !ghei  = !propFthk.real() + !propCLRB.real() + !propSTLT.real()
        !dpNum = !!mdsGetDesp('STLH')
        !!mdsSetDespar(!!ce,!dpNum,!ghei)
       endif
     endif

--------------
--<wd>jan2004
     if (!!ce.styp inset('GT21')) then
-- Get the Thickness of Shoe Flange and Set the Value of the Despar Number on the GT21 guide
      !pfthk = !shoe.prop.fthk.real()
      !dpNum = !!mdsGetDesp('BPTH')
      !!mdsSetDespar(!!ce,!dpNum,!pfthk)
     endif
--<wd>jan2004
-------------

  elseif (!!ce.styp inset('GT26','GT28')) then

    !dpNum = !!mdsGetDesp('$!prop1')
    !!mdsSetDespar(!!ce,!dpNum,!propWidth.real())
    !dpNum = !!mdsGetDesp('$!prop2')
    !!mdsSetDespar(!!ce,!dpNum,!propHeight.real())

    -- Thickness of Shoe Flange
    --<GE>aug2006 Added test to see if the shoe is an AT25 as it has specific named properties that are used
    if !shoe.:MDSSuppType inset ('AT25') then
      var !propFthk (Prop BPTH of $!shoe.name )
      !dpNum = !!mdsGetDesp('FHEI')
      !!mdsSetDespar(!!ce,!dpNum,!propFthk.real())
    elseif !shoe.stype inset ('AT25') then
      var !propFthk (Prop BPTH of $!shoe.name )
      !dpNum = !!mdsGetDesp('FHEI')
      !!mdsSetDespar(!!ce,!dpNum,!propFthk.real())
      --<GE>aug2006
    else
      var !propFthk (Prop FTHK of $!shoe.name )
      !dpNum = !!mdsGetDesp('FHEI')
      !!mdsSetDespar(!!ce,!dpNum,!propFthk.real())
    endif

  elseif (match(!!ce.styp,'GT04') gt 0) then
    !dpNum = !!mdsGetDesp('$!prop2')
    !!mdsSetDespar(!!ce,!dpNum,!propHeight.real())
   elseif (!!ce.styp inset('ST06','ST20')) then
    !dpNum = !!mdsGetDesp('HEI')
    !!mdsSetDespar(!!ce,!dpNum,!propHeight.real())

--<wd>feb2003
   -- elseif (!!ce.styp inset('AT40A','AT40B','AT40C','AT40D','AT40E','AT40F','AT41A','AT41B','AT40C','AT41D','AT41E','AT41F','AT42')) then
   elseif (!!ce.styp inset('AT40A','AT40B','AT40C','AT40D','AT40E','AT40F','AT41A','AT41B','AT40C','AT41D','AT41E','AT41F','AT42','AT100A','AT100B','AT101A','AT101B')) then
    !dpNum = !!mdsGetDesp('XHEI')
    !!mdsSetDespar(!!ce,!dpNum,!propHeight.real())
--<wd>feb2003
   endif

-- Has the shoe a property called GNOT if so turn it on to give a notch for the
  !!ce = !shoe
  !dpNum = !!mdsGetDesp('GNOT')
  if !dpNum.neq(0) then
    despar n$!dpNum 1mm
   endif

  !!ce = !start

  !!kRestoreUnits(!currentunits)

return

endfunction
