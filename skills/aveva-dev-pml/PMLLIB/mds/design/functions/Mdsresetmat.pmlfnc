-- Created:		Thu Nov 16 2000
--
--
-- Description:
-- Reset the material settings of the sections
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        Form          Array of commands to run that resets the material
-- Return:
--    [Data Type]   [Description]
--     array         returned material values
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsResetMat(!Commands is ARRAY)

    do !ResetMaterial values !Commands
      if !ResetMaterial.upcase().match('MDSPOSNUM').gt(1) then
        !split = !ResetMaterial.split(' ')
        !value = ARRAY()
        !value.append(!split[3].real())
        $!split[1]
        !!ce.:MDSPOSNUM = !value
      else
        $!ResetMaterial
        handle any
          -- This has been added if for instance ft01 with two cross bars
          -- is created with one cross bar
        endhandle
      endif
    enddo

-- End function
endfunction

-- End of file Mdsresetmat.pml
