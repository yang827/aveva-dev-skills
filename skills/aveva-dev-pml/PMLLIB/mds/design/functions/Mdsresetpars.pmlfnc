----
-- File: Mdsresetpars.pmlfnc
--   Type:    Function Definition
--   Group:    Multi Discipline Supports Application
--     Keyword:    MDS
--   Module:    design
--   Replaces:
--
-- Author:    I.Osborne
-- Created:    Fri Mar 09
--
--
-- Description:
-- Function to reset all modifiable design parameters when modifying the
-- MDS ancillary type
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsResetPars()

  -------------------------------------
  !currentUnits = !!kGetSetUnits()
  -------------------------------------

  -- Reset design parameters

  if (!!ce.type.eq('CTSUPP')) then
    !bore = !!ce.ppbor[1]
  else
    !bore = pa bore
  endif
  --!suppType = !!ce.styp
  --!name = !!ce.name

  --<mjb> 23.03.06 <mds12>
  --!parVar = '!!mdsPar' + !suppType
  !realBore = !bore.real().value()
  !mdsAttaObj  = object MDSREADPARSDATA()
  !unusedMdsAttaDefs = !mdsAttaObj.mdsdefsdata(!!ce.stype,!realBore)
  --<mjb> 23.03.06 <mds12>

  -- Reset height if necessary

  var !unusedHei (prop HEI of ce )
  handle NONE
    if (!!mdsAncill.savedPars[1] neq 0) then
      !dpNum = !!mdsGetDesp('HEI')
      !!mdsSetDesPar(!!ce,!dpNum,!!mdsAncill.savedPars[1])

      -- Is there an alternative expression to modify
      --<mjb> 23.03.06 <mds12>
      !expr = !mdsAttaObj.altExpr
      !altDespar = !mdsAttaObj.altDespars

      !exprCounter = 1

      --!expr = $!parVar[$!bore].altExpr
      --!altDespar = $!parVar[$!bore].altDespars
      --<mjb> 23.03.06 <mds12>
      if (!expr.set()) then
        --!splitExpr = !expr.split(',')
        !splitExpr = !expr
        do !loop values !splitExpr
          --$p test1
          --q var !loop
          var !test ($!loop)
          --q desp[5]
          if (!test.boolean()) then
            do !set values !altDespar[!exprCounter]
              --$p test2
              --q var !set
              !!mdsSetDesPar(!!ce,!set.dpNum,!set.altVal.real())
            enddo
          endif
          !exprCounter = !exprCounter + 1
        enddo
      endif
    endif
  elsehandle any
  endhandle

  -- Reset length if necessary
  var !unusedSaveLen (prop LEN of ce )
  handle none
    if (!!mdsAncill.savedPars[2] neq 0) then
      !dpNum = !!mdsGetDesp('LEN')
      !!mdsSetDesPar(!!ce,!dpNum,!!mdsAncill.savedPars[2])
    endif
  elsehandle any
  endhandle

  -- Reset thickness if neccesary
  var !unusedSaveThick (prop THK of ce )
  handle none
    if (!!mdsAncill.savedPars[3] neq 0) then
      !dpNum = !!mdsGetDesp('THK')
      !!mdsSetDesPar(!!ce,!dpNum,!!mdsAncill.savedPars[3])
    endif
  elsehandle any
  endhandle

  -- Reset support centres if neccesary
  var !unusedSaveCen (prop SCEN of ce )
  handle none
    if (!!mdsAncill.savedPars[4] neq 0) then
      !dpNum = !!mdsGetDesp('SCEN')
      !!mdsSetDesPar(!!ce,!dpNum,!!mdsAncill.savedPars[4])
    endif
  elsehandle any
  endhandle

  !!kRestoreUnits(!currentUnits)

  -- End function
endfunction
