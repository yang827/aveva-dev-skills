--
-- File:		Mdsresetpins.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MPINRESET
--
-- Author:		I.Osborne
-- Created:		Fri Mar 09
--
--
-- Description:
-- function to reset all pins between arguments passed
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          REAL        Number of Pin to be reset From
--     1     R          REAL        Number of Pin to be reset To
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsResetPins(!From is REAL, !To is REAL)

-- Reset pin to N0 and DIR U

  do !Num from !From to !To
    PIN $!Num AT N0 WRT WORLD
    PIN $!Num DIR U WRT WORLD
    PIN $!Num OFF
  enddo

-- End function
endfunction

-- End of file Mdsresetpins.pml
