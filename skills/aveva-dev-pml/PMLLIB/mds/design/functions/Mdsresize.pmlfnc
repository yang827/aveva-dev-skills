--
-- File:  Mdsresize.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Fri Oct 1997
--
--
-- Description:
-- Function to rebuild the support when the steelwork size is\ changed.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      Form name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsReSize(!form is FORM)

  -- Check the current template allows cross bars, :mdsbars at stru with the new selected template
  -- Only need to check if the number of cross bars exceed 1

  if !form.support.bars.size().gt(1) then
    -- Extra cross bars have been created
    !struBars = !form.support.stru.:MdsBars
    -- Find selected template
    !struDesc = !form.support.stru.desc
    !type = !form.support.type
    !templateZoneName = '/MDS/FRAMES/$!type'
    !unusedZoneTest = name of $!templateZoneName
    handle ANY
      !templateZoneName = '/MDS/FRAMES/$!type-HORI'
    endhandle
    var !prevTemp coll all stru with desc eq '$!struDesc' for $!templateZoneName
    !prevTempOrder = !prevTemp[1].dbref().order
    !newbars = :Mdsbars of stru $!!mdsSetSteel.size.val of $!templateZoneName

    if not !newbars and $!struBars then
      !!alert.error('The selected template is not allowed to have additional cross bars and there are additional cross bars created')
      -- Reset original templates
      !!mdsSetSteel.size.val = !prevTempOrder
      return
    endif

  endif

  ------------ *** Connexion Warnings *** -------------
  !support = !form.support
  !errorMessage = STRING()
  if(!!mdsCheckConns(!form, !errorMessage).eq('UNJOINTED')) then
    -- nothing to do
  elseif(!!mdsCheckConns(!form, !errorMessage).eq('WARNING')) then
    !continue = !!alert.confirm(!errorMessage)
    if(!continue.eq('NO')) then
      return
    else
      !!mdsSelectJoints(!form,'DISCONNECT','')
      !support.joints.clear()
    endif
  elseif(!!mdsCheckConns(!form, !errorMessage).eq('ERROR')) then
    !!alert.error(!errorMessage)
    return
  else
    -- continue
    !!mdsSelectJoints(!form,'DISCONNECT','')
    !support.joints.clear()
  endif

  -- Initialise variables
  !type  = !form.support.type
  !datum = !form.support.datum
  !sref  = !datum.name.replace('/DATUM','/SREF').dbref()
  handle ANY
  endhandle
  !stru  = !form.support.stru

  !type = !!mdsAliasList(!type)


  -- The support code has to change because the user has selected another size

  !!mdsSetSuppCode('SELECT',!stru.name,!type,'XXXXXX')
  handle ANY
  endhandle


  -- Check that Datum atta has been created
  if (!datum.set().not())then
    -- Reset the form title
    !!mdsSetSteel.setTitle()
    return
  endif

  -- Check that Datum atta has been positioned
  if (!form.support.position.not())then
    -- Reset the form title
    !!mdsSetSteel.setTitle()
    return
  endif

  -- Reset the form title

  !!mdsSetSteel.setTitle()

  -- Check to see if a cross-bar has been created by checking the first barlen
  -- For support type FT23 & FT48 this does not exist so check the existence of V1
  if (!type inset ('FT23', 'FT47', 'FT48')) then
    !vertBar = !stru.name & '-V1'
    !!ce = !vertBar.dbref()

    handle any
      --        return
    elsehandle none
      same
    endhandle
  else
    !unusedtest = !form.support.barlen[1]
    handle (2,752)
      -- Array element 1 does not exist
      return
    endhandle
  endif

  -- If any of the dimension are unset then return
  -- There are special circumstances where a dimension can be set to 0
  -- They are
  -- Dim 1 for FT17 FT18(CT08) FT19(CT07) FT23
  -- Dim 3 for FT15 if config 2
  -- Dim 3 for FT15 if config 3
  -- Dim 4 for FT15 if config 3
  -- Dim 3 for FT15 if config 4
  -- Dim 4 for FT15 if config 4

  do !checkDim from 1
    skip if (!checkDim eq 1 and !form.support.alias eq 'FT17')
    skip if (!checkDim eq 1 and !form.support.alias eq 'FT40')
    skip if (!checkDim eq 1 and !form.support.alias eq 'FT18')
    skip if (!checkDim eq 1 and !form.support.alias eq 'CT08')
    skip if (!checkDim eq 1 and !form.support.alias eq 'FT19')
    skip if (!checkDim eq 1 and !form.support.alias eq 'CT07')
    skip if (!checkDim eq 1 and !form.support.alias eq 'FT21')
    skip if (!checkDim eq 1 and !form.support.alias eq 'FT23')
    skip if (!checkDim eq 3 and !form.support.alias eq 'FT15' and !form.support.config eq 2)
    skip if (!checkDim eq 3 and !form.support.alias eq 'FT15' and !form.support.config eq 3)
    skip if (!checkDim eq 4 and !form.support.alias eq 'FT15' and !form.support.config eq 3)
    skip if (!checkDim eq 3 and !form.support.alias eq 'FT15' and !form.support.config eq 4)
    skip if (!checkDim eq 4 and !form.support.alias eq 'FT15' and !form.support.config eq 4)
    !checkString = !form.dim$!checkDim
    handle (2,759)
      break
    endhandle
    -- Only check value if active
    !formName = !form.string()
    !gadgetActive =  '!!' & !formName & '.dim' & $!checkDim & '.active'
    if ($!gadgetActive) then
    else
      break
    endif
    if ($!checkString eq 0) then
      return
    endif
  enddo

  --<tm fix to stop the inappropriate resizing of the steelwork
  if !type.eq('FT50') or !type.eq('VT24') or !type.eq('VT23') then
    !supseq = !!mdsgettempnumber(/MDS/FRAMES/$!type , !sref.lbor)
    if !supseq neq !!mdsSetSteel.size.val then
      !!alert.error('Standard not available at this bore! ($!sref.lbor)')
      if !supseq neq (0) then
        !!mdsSetSteel.size.val = !supseq
      endif
      return
    endif
  endif

  -- regeneration of support happens every time, because all the members
  -- may not be the same size. Do not rebuild a FT25

  if !type.neq('FT25') then
    if !type.eq('FT48') then
      Call !!mdsCreate$!type('DIMENSION,RESIZE')
    else
      Call !!mdsCreate$!type('DIMENSION')
    endif
  endif

  -- Reset the form title

  !!mdsSetSteel.setTitle()

endfunction
