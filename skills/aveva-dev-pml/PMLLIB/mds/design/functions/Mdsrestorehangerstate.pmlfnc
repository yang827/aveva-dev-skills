--------------------------------------------------------------------------------
--
-- File:    Mdsrestorehangerstate.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    A.boudjnah
-- Created:   Fri 22 2002
--
--
-- Description:
-- Restores the hanger and associated elements (hanger, hanger mem, fitt, atta) states
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        FORM of current Hanger type
--
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------


-- Define Function
define function !!mdsrestorehangerstate(!form is FORM)
  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.traceIn(1, '!!mdsrestorehangerstate($!form is FORM)')
  endif

-- Initialise variables

  if(!form.oldsupport.unset()) then
    -- Nothing to restore
    return
  endif
  !currentunits = !!kgetsetunits()
  units mm bore mm dist
  !form.support     = !form.oldsupport
  !support = !form.support
  !datum       = !support.datum
  !cecomp = !!ce

-- atta name
  !!ce = !datum

-- Save the atta data
  if(!support.oldOrientation.set()) then
    ori $!support.oldOrientation
    endif
  if(!support.oldPosition.set()) then
    at $!support.oldPosition
  endif
  if(!support.oldSpref.set()) then
    spref $!support.oldSpref
  endif
  if(!support.oldType.set()) then
    :MDSSuppType '$!support.oldType'
    endif

$(
  if(!support.oldCref.set()) then
    cref $!support.oldCref
      handle any
      !!alert.error('Hanger $!support.oldCref has been deleted and can not be reconnected to the atta')
      endhandle
    endif
$)
-- Restores Hanger data
-- Save Hanger data
   !oRest = !support.rest
  if(!support.oldCref.set()) then
    !oRest.attaConnRef.cref = !support.oldCref
    handle ANY
      !!alert.error('Can not restore atta connection reference')
     endhandle
   endif

   !hangers = !oRest.hangers
  do !h indices !hangers
    -- Current element is hanger no !i
    !oHang = !hangers[!h]
    !!ce = !oHang.ref
    handle ANY
       skip
     endhandle


     -- Hanger head data
    !!ce.hpos = !oHang.hpos
    handle ANY
    endhandle
    !!ce.hdir = !oHang.hdir
    handle ANY
    endhandle
    !!ce.hbor = !oHang.hbor
    handle ANY
    endhandle
    !!ce.hcon = !oHang.hcon
    handle ANY
    endhandle
    --!!ce.href = !oHang.href
-- >>> dtf 11.08.04
--11.5 gets the connection of hanger 3 head wrong ie connects it to
    --hanger 1 head so it is in pml 1 style
     if !h eq 3 then
      var !hngname $!oHang.href.name
        --q var !hngname
        conn hh to ht of $!hngname
       handle ANY
       endhandle
     else
      !!ce.href = !oHang.href
       handle ANY
       endhandle
     endif
-- <<< end of mod

     -- Hanger tail data
    !!ce.tpos = !oHang.tpos
    handle ANY
    endhandle
    !!ce.tdir = !oHang.tdir
    handle ANY
    endhandle
    !!ce.tbor = !oHang.tbor
    handle ANY
    endhandle
    !!ce.tcon = !oHang.tcon
    handle ANY
    endhandle
    !!ce.tref = !oHang.tref
    handle ANY
    endhandle


    !hangMem = !oHang.hangMem

    do !i
      $!i
      handle ANY
         break
       endhandle
      !ohangMem = !hangMem [!i]
         handle NONE
        !ohangMem .rotated = 0
        !ohangMem .rotateCur = FALSE

        if(!ohangMem.height.set()) then
          height $!ohangMem.height
          handle ANY
          endhandle
        endif
        if(!ohangMem.spref.set()) then
          spref $!ohangMem.spref
        endif
        if(!ohangMem.lsrod.set()) then
          lsrod $!ohangMem.lsrod
        endif
        if(!ohangMem.desp.set()) then
          !!ce.despara = !ohangMem.desp
        endif
        if(!ohangMem.position.set()) then
          at $!ohangMem.position
        endif
        if(!ohangMem.orientation.set()) then
          ori $!ohangMem.orientation
        endif
        !hangMem [!i] = !ohangMem
           hang
         elsehandle ANY
         endhandle
     enddo

    !oHang.hangMem = !hangMem
     if(!oHang.fitt.set()) then
       !oFitt = !oHang.fitt
       if(!oFitt.set() and !oFitt.ref.set() and (not !oFitt.ref.badref()) and !oFitt.ref.type.eq('FITT')) then
        !!ce = !oFitt.ref
        !!ce.name = !oFitt.name
        handle ANY
        endhandle

        --dun1218 added this check because if we are restoring a hanger fitting that is in a db without write access
        --then it will not have moved from the previous version since everything is handled by virtual fittings - start
        if dbwrite then
-- dtf >>> 3.02.05 !delpos on needs to be set locally not WRT /*
         !delpos = !oFitt.delpos.string().before('WRT')
         if(!delpos.set()) then
           delpos $!delpos
         endif
         !zdist = !oFitt.zdist
         if(!zdist.set()) then
           zdist $!oFitt.zdist
         endif
        endif
        --dun1218 added this check because if we are restoring a hanger fitting that is in a db without write a
        --then it will not have moved from the previous version since everything is handled by virtual fittings - end
      else
        if(defined(!!mdsDEBUG)) then
          !!mdsDEBUG.traceError('Hanger object does not have a valid fitting')
        endif
      endif
    endif
    !hangers[!h] = !oHang
   enddo
   !oRest.hangers = !hangers
   !support.rest = !oRest

   !support.alias = !support.rest.styp
   !form.support = !support
   -- Unsetting the oldsupport member variable
  ---------   !form.oldsupport = object MDSSUPPORT()
-- End of Hanger restoring

  !!ce = !cecomp
   !!kRestoreUnits(!currentunits)
  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.traceOut(1, '!!mdsrestorehangerstate($!form is FORM)')
   endif

  endfunction
