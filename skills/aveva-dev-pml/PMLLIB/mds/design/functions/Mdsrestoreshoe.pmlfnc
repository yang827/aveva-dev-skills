--
-- File:  Mdsrestoreshoe.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  I.osborne
-- Created:  Thu May 15
--
--
-- Description:
-- Restore support prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Support Form to be restored
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsRestoreShoe(!form is FORM)

  !currentunits = !!kgetsetunits()

  -- Initialise variables

  !usrSuppName = !form.support.replace

  -- Test Decision

  if (!!alert.confirm(|Ok to cancel Support "$!usrSuppName". This will reset the support prior to modifying?|) eq 'NO')then
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- If the atta is a AT29/AT31 there is nothing to reset except the design parameters

  if !form.support.type.match('AT29').gt(0) or !form.support.type.match('AT31').gt(0) or !form.support.type.match('AT105').gt(0) then
    !!mdsDacControl(true)
    do !count from 1
      despar n $!count  $!form.support.oldDespars[$!count]
      handle any
        break
      endhandle
    enddo
    !!mdsDacControl(false)
    golabel /exit
  endif

  -- MdsAT01 only- Multiple GENERAL Ancillaries (SHOES, REINFORCING PADS etc..) in MDS3.0.0 saved via the function !!mdssaveattainf.pmlfnc
  -- Added user defined for MDSat500

  !!mdsDacControl(TRUE)

  if ( (!form.eq(!!mdsat01)) or (!form.eq(!!mdslt04)) or (!form.eq(!!mdsat500)) )then
    !actions = !form.store
    -- Loop through ACTIONS
    do !i indices !actions
      !!mdsDacControl(true)
      $!actions[$!i]
    enddo

    !!ce = !form.support.datum
    !!mdsDacControl(true)
    !!mdsResetGuide()
    !!ce = !form.support.datum
    !slip = object FORM()
    !!mdsDacControl(true)
    !!mdsAlignSUnit(!slip)

  else

    -- ALL other SINGLE ANCILLARY only FORMS - i.e. ANCHORS, HANGERS, GUIDES, SLIP UNITS, SPRINGS and STOPS
    -- Initialise existing variables before regenerating data

    !!mdsDacControl(true)
    !!ce = !form.support.datum
    at $!form.support.oldPosition
    handle any
      golabel /exit
    endhandle
    thro ce
    do !count from 1
      despar n $!count  $!form.support.oldDespars[$!count]
      handle any
        break
      endhandle
    enddo
    ori $!form.support.oldOrientation

    -- Reset the ori on the stex of required
    !!mdsTransport(!!ce,!!ce.namn)

    -- flip if necessary for SP03
    if(!form.support.datum.stype.eq('SP03A')) then
      if(!form.flips) then
        FLIP
      endif
    endif

    if (!form.support.oldSpref.set()) then
      spref $!form.support.oldSpref
    endif

    !!mdsDacControl(true)
    !!mdsResetGuide()
    !!mdsDacControl(true)

    -- Check BedPlate references
    if (!form.struBpref.size() gt 0)then
      !bprefs  = !form.struBpref
      !setting = !form.storeBpref
      !bprefs.invert()
      !setting.invert()
      do !i indices !bprefs
        !!ce = !bprefs[!i]
        $!setting[$!i]
        handle any
          break
        endhandle
      enddo
    endif

    !!ce = !form.support.datum

    if(!form.support.datum.:MDSGuideRef.badref().not() and !form.support.datum.:MDSGuideRef.neq(Nulref) and !form.support.datum.:MDSGuideRef.catref.owner.:MdsType.eq('SLIP')) then
      !slip = object FORM()
      !!mdsAlignSUnit(!slip)
    elseif(!form.support.datum.:MDSGuideRef.badref().not() and !form.support.datum.:MDSGuideRef.neq(Nulref) and !form.support.datum.:MDSGuideRef.stype inset('SP01')) then
      !offset = !form.support.datum.despar[1] + !form.support.datum.param[2] / 2
      !!ce = !form.support.datum.:MDSGuideRef
      despar n 5 $!offset
      handle any
      endhandle
      !!ce = !form.support.datum
    elseif(!form.support.datum.:MDSGuideRef.badref().not() and !form.support.datum.:MDSGuideRef.neq(Nulref) and !form.support.datum.:MDSGuideRef.stype inset('SP01A')) then
      !offset = !form.support.datum.despar[1] + !form.support.datum.despar[2]
      !!ce = !form.support.datum.:MDSGuideRef
      despar n 5 $!offset
      handle any
      endhandle
      !!ce = !form.support.datum
    endif

    -- try this
    if(!form.support.datum.stype.eq('SP01') and !form.dist.active.eq(TRUE)) then
      !form.dist.val = !form.store[1]
    endif

  endif

  -- Spherical Washer

  if (!form.support.swasher.set()) then
    :MDSSwasher $!form.support.swasher
  endif

  !!mdsDacControl(false)

  label /exit

  !!mdsDacControl(false)

  -- Clear form gadgets
  Call !!mdsClearGadgets(!form)

  -- Reactivate cancel button on modify form
  if (!!mdsModifySupp.cancel.active.not())then
    !!mdsModifySupp.cancel.active = true
  endif

  -- Reset design representation if required
  --q var !form.repre
  Call !!kActionCommands(!form.repre)

  -- Hide form
  !form.hide()

  !!kRestoreUnits(!currentunits)

  -- End function
endfunction
