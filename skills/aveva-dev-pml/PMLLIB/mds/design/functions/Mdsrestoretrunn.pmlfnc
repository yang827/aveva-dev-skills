--
-- File:		Mdsrestoretrunn.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:	        Wayne Dodwell
-- Created:		Wednesday 18th February 1998
--
--
-- Description:
-- Restore Trunnion Support prior to ANY modifications
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          form        Trunnion Support to be restored
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsrestoretrunn(!form is form)

-- Find current units and set the distance unit to metric
    !currentunits = !!kgetsetunits()

--------------------------------------------------------------------------------
-- Check the support has not been deleted
    if(!form.support.stru.badref()) then
      !!alert.error('Unable to Restore Trunnion as it has been deleted')
      !form.hide()
      return
    endif

--------------------------------------------------------------------------------
-- Initialise variables
    !UsrSuppName = !form.Support.Stru.namn

-- Test Decision
    if (!!alert.confirm(|Ok to cancel Support "$!UsrSuppName". This will reset the support prior to modifying?|) eq 'NO')then
      !!kRestoreUnits(!currentunits)
      return
    endif

-- Initialise existing variables before regenerating data
    !actions     = !form.store
    !existattas  = !form.support.atta
    !existangle  = !form.support.rotated
    !name        = !form.support.stru.name

--------------------------------------------------------------------------------
-- Loop through actions to do
    do !I indices !actions
      $!actions[$!I]
    enddo

-- Swap support object information
    !form.support = !form.backup

-- Initialise new variables
    !currattas = !form.support.atta
    !diffattas = !existattas.difference(!currattas)
    !currangle = !form.support.rotated

--------------------------------------------------------------------------------
-- Check to see if supports have been added
    if (!diffAttas.empty().not())then
      do !V values !diffattas
        !!ce = !V
        delete atta
      enddo
    endif

--------------------------------------------------------------------------------
-- Check to see if the attas have been rotated
    if (!currangle ne !existangle)then
      !turn = 360 - (!existangle - !currangle)

-- Set gadget with angle to rotate
      !form.rotan.val = !turn.string()
      !form.rotan.val = 0
      !function = !form.rotate.callback

-- Run function
      $!function

-- Re-set angle gadget
      !form.rotan.val = !currangle.string()

-- Make sure that the support.rotated member is reset for FT23
-- as the function just run resets this member.....
      !form.support.rotated = !form.backup.rotated

    endif

--------------------------------------------------------------------------------
 -- Reset design representation if required
    call !!kactioncommands(!form.repre)

-- Clear form gadgets
    call !!Mdscleargadgets(!form)

-- Reactivate cancel button on modify form
    if (!!Mdsmodifysupp.cancel.active.not())then
      !!Mdsmodifysupp.cancel.active = true
    endif

-- Hide form
    !form.hide()

-- Hide Marker Text
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210

-- Reset All Pins
    !!Mdsresetpins(1,10)

-- Reset Units
    !!kRestoreUnits(!currentunits)

  endfunction
-- End function

-- End of file Mdsrestoretrunn.pml
