--
-- File:		Mdsrevdims.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MREVPS***
--
-- Author:		I.Osborne
-- Created:		Thu Mar 08
--
--
-- Description:
-- function to reverse dimensions on all support frame types and then regenerate
-- the support.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         GADGET       Dimension Gadget
--     2     R         GADGET       Dimension Gadget
--     3     R         STRING       Function to regenerate framework
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsRevDims(!Gadget1 is GADGET, !Gadget2 is GADGET, !Function is STRING)

  !Form = !Gadget1.owner()

-- Can we write to all components of the support

  if !!MdsCheckAccess(!Form,'DACMOD','POS').not() then
    !!CE = !Form.Support.Datum
      handle any
      endhandle
    return
  endif
------------ *** Connexion Warnings *** -------------

  !Support = !Form.Support
  !ErrorMessage = string()

---------------------------------------------
-- Initialise variables
  !FormName = !Gadget1.owner()
  !Name1    = !Gadget1.name()
  !Name2    = !Gadget2.name()
  !Val1     = !Gadget1.Val
  !Val2     = !Gadget2.Val

  if (!Name1 eq 'DIM1' and !Name2 eq 'DIM2') then
    if (!Val1 eq 0 or !Val2 eq 0) then
      !!Alert.error('Cannot reverse dimensions 1 and 2')
      return
    elseif (!Val1 eq !Val2) THEN
      !!Alert.error('Dimensions are the same')
      return
    endif
    !Dimension = !Val1 - !Val2
    !Gadget2.Val = !Dimension
  elseif (!Name1 eq 'DIM3' and !Name2 eq 'DIM4') then
    if (!Val1 eq 0 or !Val2 eq 0) then
      !!Alert.error('Cannot reverse dimensions 3 and 4')
      return
    elseif (!Val1 eq !Val2) THEN
      !!Alert.error('Dimensions are the same')
      return
    endif
    !Gadget1.Val = !Val2
    !Gadget2.Val = !Val1
  endif

-- Regenerate steelwork
  -- Run the passed function
  $!Function

-- End function
endfunction

-- End of file Mdsrevdims.pml
