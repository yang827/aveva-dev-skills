--
-- File:		Mdsrotateat01.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Wed Oct 29
--
--
-- Description:
-- function to rotate general ancillary type at01 (Vertical pipes only)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsRotateAt01()

  -- Initialise variables
    !Support = !!MdsAt01.Support
    !Angle   = !!MdsRotan.Angle.val.real()

  -- Check that Datum atta has been created
    if (!Support.Datum.set().not())then
      !!Alert.message('Datum support atta has not been created')
      return
    endif
    !!MdsDacControl(true)
  -- Rotate all attas
    do !V values !Support.Atta
      !!CE = !V
      ROTATE THROUGH CE ABOUT PL BY $!Angle
--<wd>may2003
-- Update the STEX to contain the ORIENTATION to be output on the Isometric Drawing
      skip if (!v.name.match('/SREF').gt(0))
      !!mdstransport(!v,!v.name)
--<wd>may2003
--<wd>mar2003
-- Rotate the Associated SHOE/PAD if the :MDSSREF is set and it is valid
      if (!!ce.:mdssref.badref().not()) then
        !!ce = !!ce.:mdssref
        rotate through ce about pl by $!angle
--<wd>may2003
-- Update the STEX to contain the ORIENTATION to be output on the Isometric Drawing
        !!mdstransport(!!ce,!!ce.name)
--<wd>may2003
     endif
     !!CE = !V
--<wd>mar2003
    enddo

  -- Update Support Data
    !!CE = !Support.Datum
    !Support.PADir  = Pa Dir wrt world
    !Support.PLDir  = Pl Dir wrt world
    !Support.P9Dir  = P9 Dir wrt world
    -- !Support.P10Dir = P10 Dir wrt world
    -- !Support.P11Dir = P11 Dir wrt world
    !OldDeg = !Support.Rotated
    !NewDeg = !OldDeg + !Angle
    if (!NewDeg geq 360)then
      !NewDeg = !NewDeg - 360
    endif
    !Support.Rotated = !NewDeg

    !!MdsAt01.Support = !Support

-- Update Graphical Aid Text
    !!Mdsaidtext(!!Mdsat01)

-- If the shoe has a :MDsGuideref make sure it rotates withit
   if !!CE.:MDSGuideRef.badref().Not() then
     goto :MDSGuideRef
     ROTATE THROUGH CE ABOUT PL BY $!Angle
--<wd>may2003
-- Update the STEX to contain the ORIENTATION to be output on the Isometric Drawing
     !!mdstransport(!!ce,!!ce.name)
--<wd>may2003
   endif

  !!MdsDacControl(TRUE)
  !Attaname = !!MdsAt01.Support.datum.name
  do !Loop from 1 to 4
    $!Attaname$n/LUG$!Loop
      handle NONE
        rotate about pl by $!Angle
      elsehandle ANY
      endhandle
  enddo

  !!ce = !!MdsAt01.Support.datum

  !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdsrotateat01.pml
