--
-- File:		Mdsrotateframe.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Wed Jul 09
--
--
-- Description:
-- function to rotate steelwork in support frame
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Support frame form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsRotateFrame(!Form is FORM)
    !!MdsDacControl(true)
  -- Initialise variables
    !Support  = !Form.Support
    !Type     = !Support.Type
    !Type = !!MdsAliasList(!Type)

  -- There will be several frames that if they are connected
  -- it will not be possible to rotate them.

    !NoNoList = array()
    !NoNoList.Append('FT03')
    !NoNoList.Append('FT04')
    !NoNoList.Append('FT05')
    !NoNoList.Append('FT06')
    !NoNoList.Append('FT10')
    !NoNoList.Append('FT11')
    !NoNoList.Append('FT12')
    !NoNoList.Append('FT13')
    !NoNoList.Append('FT14')
    !NoNoList.Append('FT17')
    !NoNoList.Append('FT18')
    !NoNoList.Append('FT19')
    !NoNoList.Append('FT23')
    !NoNoList.Append('FT28')
    !NoNoList.Append('FT38')
    !NoNoList.Append('FT62')
    !NoNoList.Append('FT63')

    if !NoNoList.findfirst(!Type).neq(0) then
      if not !Form.Support.Joints.empty() then
        !!Alert.Error('Unable to rotate framework as it is connected to steelwork')
        return
      endif
    endif

   !Function = |!!MdsCreate| & !Type & |('DIMENSION')|

  -- Check that framework has been created
    if (!Support.Stru.Mcount() eq 0)then
      !!Alert.error('Support structure has not been created')
      return
    endif

  -- Check current rotation
    if (!Support.RotateCur)then
      !Support.RotateCur = false
    else
      !Support.RotateCur = true
    endif

  -- Update support data held in form
    !Form.Support = !Support

-- Always hide Packing Piece Form
    !!Mdsft25.hide()

  -- Run create by dimensions to regenerate support
    call $!Function
    !!MdsDacControl(false)
-- End function
endfunction

-- End of file Mdsrotateframe.pml
