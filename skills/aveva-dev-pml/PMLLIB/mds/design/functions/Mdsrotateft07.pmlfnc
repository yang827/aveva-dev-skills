--
--
-- Description:
-- function to rotate frame type ft07
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsRotateFt07()

  -- Initialise variables
    !Support = !!MdsFt07.Support



   -- !Angle   = !!MdsRotan.Angle.val.real()

  -- Check that Datum atta has been created
    if (!Support.Datum.set().not())then
      !!Alert.message('Datum support atta has not been created')
      return
    endif

-- Can only rotate framwork if we can write to the stru

    if !!MdsComClaimDac(!support.stru,'DACMOD','POS').not() then
      !!Alert.Error('Unable to rotate support as write access to the support structure is not available')
      return
    endif

------------ *** Connexion Warnings *** -------------
  !form = !!MdsFT07
  !ErrorMessage = string()
--$(
  if(!!MdsCheckConns(!Form, !ErrorMessage).eq('UNJOINTED')) then
     -- nothing to do
  elseif(!!MdsCheckConns(!Form, !ErrorMessage).eq('WARNING')) then
    !Continue = !!Alert.Confirm(!ErrorMessage)
     if(!Continue.eq('NO')) then
        Return
     else
       !!MdsSelectJoints(!Form,'DISCONNECT','')
       !Support.Joints.clear()
     endif
  elseif(!!MdsCheckConns(!Form, !ErrorMessage).eq('ERROR')) then
      !!Alert.Error(!ErrorMessage)
      Return
  else
-- continue
      !!MdsSelectJoints(!Form,'DISCONNECT','')
      !Support.Joints.clear()
  endif
--$)
---------------------------------------------

if !!MdsFt07.Support.rotatecur then
     !!MdsFt07.Support.rotatecur  = TRUE
else
     !!MdsFt07.Support.rotatecur = FALSE
endif
!!MdsCreateFt07(DIMENSION)







$(
     !!MdsDacControl(true)
  -- Rotate all attas
    do !V values !Support.Atta
      !!CE = !V
      ROTATE THROUGH CE ABOUT PL OF $!Support.datum BY $!Angle
--<wd>may2003
-- Update the STEX to contain the ORIENTATION to be output on the Isometric Drawing
      skip if (!v.name.match('/SREF').gt(0))
      !!mdstransport(!v,!v.name)
      !!MdsCreateLugs()
      !!ce = !v
--<wd>may2003
    enddo

  -- Update Support Data
    !!CE = !Support.Datum
    !Support.PADir  = Pa Dir wrt world
    !Support.PLDir  = Pl Dir wrt world
    !Support.P9Dir  = P9 Dir wrt world
    !Support.P10Dir = P10 Dir wrt world
    !Support.P11Dir = P11 Dir wrt world
    !OldDeg = !Support.Rotated
    !NewDeg = !OldDeg + !Angle
    if (!NewDeg geq 360)then
      !NewDeg = !NewDeg - 360
    endif
    !Support.Rotated = !NewDeg

    !!MdsFt07.Support = !Support

  -- Navigate to stru
    !!CE = !Support.Stru
    !!MdsDacControl(false)

    $)
-- End function
endfunction

-- End of file Mdsrotateft07.pml
