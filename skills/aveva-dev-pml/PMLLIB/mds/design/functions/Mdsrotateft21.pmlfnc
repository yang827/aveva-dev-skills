--
-- File:		Mdsrotateft21.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MROTPS130
--
-- Author:		Wayne Dodwell
-- Created:		Friday 31st October 1997
--
--
-- Description:
-- function to rotate frame type 'FT21'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsrotateft21()

-- Initialise variables
    !support = !!Mdsft21.support
    !angle   = !!Mdsrotan.angle.val.real()

-- Check that Datum atta has been created
    if (!support.datum.set().not())then
      !!alert.message('Datum support atta has not been created')
      return
    endif

-- Can only rotate framwork if we can write to the stru

    if !!MdsComClaimDac(!support.stru,'DACMOD','POS').not() then
      !!Alert.Error('Unable to rotate support as write access to the support structure is not available')
      return
    endif

-- If more than ONE Support Atta on *-BAR-1
-- Angle may ONLY be '180'
    if (!support.bars[1].size().gt(1) ) then

      if (!!Mdsrotan.angle.val.real() neq 180) then
        if (!!Mdsrotan.angle.val.real() neq 0) then
          !!alert.message('Angle of Rotation  may ONLY be 180 degrees if more than ONE Pipe is being supported on the Cross Bar')
          !!Mdsrotan.angle.val = 0
          return
        endif
      endif


-- If Only ONE atta is currently on Cross Bar the Angle of Rotation may be '0' to '180'

    endif

--xxx    if (!support.rotated neq 0 or !support.rotated neq 180) then
--xxx      !support.rotated = 0
--xxx    endif
    !!MdsDacControl(true)

-- Rotate all attas
    do !V values !support.atta
      !!ce = !v
      rotate through ce about pa by $!angle
--<wd>may2003
-- Update the STEX to contain the ORIENTATION to be output on the Isometric Drawing
      skip if (!v.name.match('/SREF').gt(0))
      !!mdstransport(!v,!v.name)
--<wd>may2003
    enddo

-- Update Support Data
    !!ce = !support.datum
    !support.padir  = pa dir wrt world
    !support.pldir  = pl dir wrt world
    !support.p9dir  = p9 dir wrt world
    !support.p10dir = p10 dir wrt world
    !support.p11dir = p11 dir wrt world
    !olddeg = !support.rotated
    !newdeg = !olddeg + !angle

    if (!newdeg geq 360)then
      !newdeg = !newdeg - 360
    endif

    !support.rotated = !newdeg
    !!Mdsft21.support = !support

-- Navigate to stru
    !!ce = !support.stru

-- Position structure at p9 of datum
    !!ce = !support.stru
    at p9 of $!support.datum

    pin1 copy p10 of $!support.datum
    pin 1 at p9 of $!support.datum

-- Rotate Cross Bar if it exists
    !name = '$!support.stru.name' & '-BAR-1'

    !!ce = !name.dbref()
    handle none

     if (!support.bars[1].size().gt(1) ) then
          var !midp deri midp
          pin 1 plane pin1 thro $!midp
          pin 1 dire $!support.padir
          rotate through pin 1 about pin1 by $!angle
     else
          !Posi = !Support.Datum.position.wrt(worl)
          !Dir  = !Support.padir
          stru
          rotate through $!posi about $!Dir  by $!angle
     endif
    elsehandle (2,109) $* Undefined Name
      -- Cross Bar has NOT yet been created
    endhandle

  !!MdsResetPins(1,1)
  !!MdsDacControl(false)
-- End function
endfunction

-- End of file Mdsrotateft21.pml
