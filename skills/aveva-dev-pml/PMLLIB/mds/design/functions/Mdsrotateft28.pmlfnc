--
-- File:		Mdsrotateft28.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Thursday 13th November 1997
--
--
-- Description:
-- function to rotate frame type 'FT28'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsrotateft28()

-- Initialise variables
    !support = !!Mdsft28.support
    !padir   = !support.padir
    !angle   = !!Mdsrotan.angle.val.real()
    !name    = !support.stru.name
    !frame   = !name & '/MAIN'
    !datum   = !support.datum
    var !supportframe exists $!frame

-- Do nothing if Angle is '0'
    if (!angle eq 0) then
      return
    endif

-- Check that Datum atta has been created
    if (!support.datum.set().not())then
      !!alert.message('Datum support atta has not been created')
      return
    endif

-- Can only rotate framwork if we can write to the stru

    if !!MdsComClaimDac(!support.Stru,'DACMOD','POS').not() then
      !!Alert.Error('Unable to rotate support as write access to the support structure is not available')
      return
    endif

-- Check that support structure has been created
    if (!supportframe neq 'FALSEA')then
      if (!padir neq U and !padir neq D) then
        !!alert.message('Support structure has been created. - Unable to Rotate this type of framework.')
        return
      endif
    endif

-- If Framework has NOT been created and Pipe is NOT Horizontal
-- Allow Datum Atta to be Rotated.
    !!MdsDacControl(true)
    !!ce = !datum
    if (!padir eq U or !padir eq D) then
      if (!supportframe eq 'TRUEA')then
        !!alert.message('Unable to Rotate Support, after Framework has been created.')
        return
      else
-- Rotate all attas (Datum & Sref)
        do !V values !support.atta
          !!ce = !v
          rotate through ce ABOUT PL OF $!Support.datum by $!angle
--<wd>may2003
-- Update the STEX to contain the ORIENTATION to be output on the Isometric Drawing
          skip if (!v.name.match('/SREF').gt(0))
          !!mdstransport(!v,!v.name)
--<wd>may2003
        enddo
      endif
    else
      !!alert.error('This type of Support may NOT be rotated if Pipe is NOT Vertical')
      return
    endif

-- Update Support Data
    !!ce = !support.datum
    !support.padir  = pa dir wrt world
    !support.pldir  = pl dir wrt world
    !support.p9dir  = p9 dir wrt world
    !support.p10dir = p10 dir wrt world
    !support.p11dir = p11 dir wrt world
    !olddeg = !support.rotated
    !newdeg = !olddeg + !angle

    if (!newdeg geq 360)then
      !newdeg = !newdeg - 360
    endif

    !support.rotated = !newdeg
    !!Mdsft28.support = !support

-- Navigate to stru
    !!ce = !support.stru
    !!MdsDacControl(false)
-- End function
endfunction

-- End of file Mdsrotateft28.pml
