--
-- File:		mdsrotateft41.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MROTPS147
--
-- Author:		I.Osborne
-- Created:		Mon Aug 04
--
--
-- Description:
-- function to rotate steelwork in support frame ft41
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsRotateFt41()

  -- Initialise variables
    !Support = !!mdsft41.Support
    -- !Angle   = !!mdsRotan.Angle.val.real()
    !Angle   = 90
    !Axis    = D

  -- Check that framework has been created
    if (!Support.Stru.Mcount() eq 0)then
      !!Alert.error('Create framework before rotating.')
      return
    endif

-- Can only rotate framwork if we can write to the stru

    if !!MdsComClaimDac(!support.Stru,'DACMOD','POS').not() then
      !!Alert.Error('Unable to rotate support as write access to the support structure is not available')
      return
    endif

  -- Rotate framework

    !!CE = !Support.Stru
    ROTATE THROUGH CE ABOUT $!Axis BY $!Angle

  -- Update Support Data
    !OldDeg = !Support.Rotated
    !NewDeg = !OldDeg + !Angle
    if (!NewDeg geq 360)then
      !NewDeg = !NewDeg - 360
    endif
    !Support.Rotated = !NewDeg

    !!mdsFt41.Support = !Support

-- End function
endfunction

-- End of file mdsrotateft41.pml
