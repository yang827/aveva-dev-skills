--
-- File:		MdsrotateFT57.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MROTPS147
--
-- Author:		I.Osborne
-- Created:		Mon Aug 04
--
--
-- Description:
-- function to rotate steelwork in support frame FT57
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsRotateFT57()

-- Initialise variables
  !Support = !!MdsFT57.Support
  !Angle   = 90
  !Axis    = D

-- Check that framework has been created
  if (!Support.Stru.Mcount() eq 0)then
    !!Alert.error('Create framework before rotating.')
    return
  endif

-- Can only rotate framwork if we can write to the stru

  if !!MdsComClaimDac(!support.Stru,'DACMOD','POS').not() then
    !!Alert.Error('Unable to rotate support as write access to the support structure is not available')
    return
  endif

------------ *** Connexion Warnings *** -------------
  !form = !!MdsFT57
  !ErrorMessage = string()
--$(
   if(!!MdsCheckConns(!Form, !ErrorMessage).eq('UNJOINTED')) then
     -- nothing to do
   elseif(!!MdsCheckConns(!Form, !ErrorMessage).eq('WARNING')) then
     !Continue = !!Alert.Confirm(!ErrorMessage)
     if(!Continue.eq('NO')) then
       Return
     else
       !!MdsSelectJoints(!Form,'DISCONNECT','')
       !Support.Joints.clear()
     endif
   elseif(!!MdsCheckConns(!Form, !ErrorMessage).eq('ERROR')) then
     !!Alert.Error(!ErrorMessage)
     Return
   else
-- continue
     !!MdsSelectJoints(!Form,'DISCONNECT','')
     !Support.Joints.clear()
   endif
--$)
---------------------------------------------
    !!MdsDacControl(true)
  -- Rotate framework

    !!CE = !Support.Stru
    ROTATE THROUGH CE ABOUT $!Axis BY $!Angle

  -- Update Support Data
    !OldDeg = !Support.Rotated
    !NewDeg = !OldDeg + !Angle
    if (!NewDeg geq 360)then
      !NewDeg = !NewDeg - 360
    endif
    !Support.Rotated = !NewDeg

    !!MdsFT57.Support = !Support
    !!MdsDacControl(false)
-- End function
endfunction

-- End of file MdsrotateFT57.pml
