--
-- File:		Mdsrotategt05.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Thur Dec 18
--
--
-- Description:
-- function to rotate guide type gt05. On vertical pipes the default direction
-- will be north, and horizontal pipes it will be d. You can only then rotate
-- atta in 90 degrees steps
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsRotateGt05()

  -- Initialise variables
    !Support = !!MdsGt05.Support

  -- Check that Datum atta has been created
    if (!Support.Datum.set().not())then
      !!Alert.message('Datum support atta has not been created')
      return
    endif

-- Can only rotate framwork if we can write to the stru

    if !!MdsComClaimDac(!support.stru,'DACMOD','POS').not() then
      !!Alert.Error('Unable to rotate support as write access to the support structure is not available')
      return
    endif
------------ *** Connexion Warnings *** -------------
    !form = !!MdsGT05
    !ErrorMessage = string()

--$(
    if(!!MdsCheckConns(!Form, !ErrorMessage).eq('UNJOINTED')) then
     -- nothing to do
    elseif(!!MdsCheckConns(!Form, !ErrorMessage).eq('WARNING')) then
      !Continue = !!Alert.Confirm(!ErrorMessage)
      if(!Continue.eq('NO')) then
        Return
      else
        !!MdsSelectJoints(!Form,'DISCONNECT','')
        !Support.Joints.clear()
      endif
    elseif(!!MdsCheckConns(!Form, !ErrorMessage).eq('ERROR')) then
      !!Alert.Error(!ErrorMessage)
      Return
    else
    -- continue
      !!MdsSelectJoints(!Form,'DISCONNECT','')
      !Support.Joints.clear()
    endif
--$)
---------------------------------------------
    !!MdsDacControl(true)

  -- Rotate all attas

    do !V values !Support.Atta
      !!CE = !V
      ROTATE THROUGH CE ABOUT PL BY 90
--<wd>may2003
-- Update the STEX to contain the ORIENTATION to be output on the Isometric Drawing
      skip if (!v.name.match('/SREF').gt(0))
      !!mdstransport(!v,!v.name)
--<wd>may2003
    enddo

    !!CE = !Support.datum

    !OpenDir = P9 dir wrt /*
    !NewDir = !!KSnapOrth(!OpenDir)
    !!MdsGt05.OpenDir.val = 'Open End Direction = $!NewDir'

  -- Rotate stru if it has been created

    !BarName = !Support.Stru.name + '-BAR-1'
    !!CE = !BarName.dbref()
      handle none
        stru
        rotate about y through $!Support.Datum by 90
      elsehandle any
      endhandle

  -- Update Support Data
    !!CE = !Support.Datum
    !Support.PADir  = Pa Dir wrt world
    !Support.PLDir  = Pl Dir wrt world
    !Support.P9Dir  = P9 Dir wrt world
    !Support.P10Dir = P10 Dir wrt world
    !Support.P11Dir = P11 Dir wrt world
    !OldDeg = !Support.Rotated
    !NewDeg = !OldDeg + 90
    if (!NewDeg geq 360)then
      !NewDeg = !NewDeg - 360
    endif
    !Support.Rotated = !NewDeg

    !!MdsGt05.Support = !Support

  -- Rebuild support

    !!MdsCreateGt05('DIMENSION')

  -- Navigate to stru
    !!CE = !Support.Stru
    !!MdsDacControl(false)
-- End function
endfunction

-- End of file Mdsrotategt05.pml
