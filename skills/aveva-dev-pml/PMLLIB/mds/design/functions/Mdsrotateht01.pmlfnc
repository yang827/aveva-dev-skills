--
-- Description:
-- function to rotate hanger ht01 and ht02
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsRotateHt01()

  -- Initialise variables
    !Support = !!MdsHt01.Support
    !Angle   = !!MdsRotan.Angle.val.real()

  -- Check that Datum atta has been created
    if (!Support.Datum.set().not())then
      !!Alert.message('Datum support atta has not been created')
      return
    endif

  -- Rotate atta
    !!MdsDacControl(true)
    do !V values !Support.Atta
      !!CE = !V
      ROTATE BY $!Angle
    enddo
    !!MdsDacControl(false)
-- End function
endfunction

-- End of file Mdsrotateht01.pml
