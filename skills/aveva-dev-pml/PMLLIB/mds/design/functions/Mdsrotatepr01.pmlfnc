--
-- File:		MdsrotatePr01.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Wed Oct 29
--
--
-- Description:
-- function to rotate general ancillary type Pr01 (Vertical pipes only)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsRotatePr01()

-- Initialise variables

  !Support = !!MdsPr01.Support
  !Angle   = !!MdsRotan.Angle.val.real()

-- Check that Datum atta has been created

  if (!Support.Datum.set().not())then
    !!Alert.message('Datum support atta has not been created')
    return
  endif

  !!MdsDacControl(true)

-- Rotate all attas
  do !V values !Support.Atta
    !!CE = !V
    ROTATE THROUGH CE ABOUT PL BY $!Angle
    skip if (!v.name.match('/SREF').gt(0))
    !!mdstransport(!v,!v.name)
    if (!!ce.:mdssref.badref().not()) then
      !!ce = !!ce.:mdssref
      rotate through ce about pl by $!angle
      !!mdstransport(!!ce,!!ce.name)
    endif
    !!CE = !V
  enddo

-- Update Support Data
  !!CE = !Support.Datum
  !Support.PADir  = Pa Dir wrt world
  !Support.PLDir  = Pl Dir wrt world
  !Support.P9Dir  = P9 Dir wrt world
  !OldDeg = !Support.Rotated
  !NewDeg = !OldDeg + !Angle

  if (!NewDeg geq 360)then
    !NewDeg = !NewDeg - 360
  endif
  !Support.Rotated = !NewDeg

  !!MdsPr01.Support = !Support

-- Update Graphical Aid Text

  !!Mdsaidtext(!!MdsPr01)

  !!MdsDacControl(false)

-- End function
endfunction

-- End of file MdsrotatePr01.pmlfnc
