--
-- File:		MdsrotateSp03xe.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Monday 8th June 1998
--
--
-- Description:
-- function to rotate Spring Atta type SP03 pedestals only
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsrotateSp03()

-- Initialise variables
    !Refe = !!CE
    !support = !!MdsSP03.support
    !angle   = !!MdsSP03.rotan.val.real()
    !select  = !!MdsSP03.type.selection('rtext')

-- Check that Datum atta has been created
    if (!support.datum.set().not())then
      !!alert.message('Datum support atta has not been created')
      return
    endif

-- Only rotate if type E , F
   !Match = 'EF'
   if(!Match.match(!Select).eq(0)) then
        !!alert.message('Can only rotate if spring is supporting a pedestal')
   endif
   !!MdsDacControl(true)
-- Update Support Data
    !!ce = !support.datum
      rotate through ce ABOUT PL OF $!Support.datum by $!angle
--<wd>may2003
-- Update the STEX to contain the ORIENTATION to be output on the Isometric Drawing
      !!mdstransport(!!ce,!!ce.name)
--<wd>may2003

    !olddeg = !support.rotated
    !newdeg = !olddeg + !angle
    if (!newdeg geq 360)then
      !newdeg = !newdeg - 360
    endif
    !support.rotated = !newdeg

    !!MdsSP03.support = !support


    !!CE = !REFE
    !!MdsDacControl(false)
  endfunction
-- End function

-- End of file MdsrotateSp03.pml
