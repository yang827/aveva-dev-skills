--
-- File:		Mdsrotatett01.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Thursday 12th February 1998
--
--
-- Description:
-- Function to rotate TRUNNION type 'TT01' on Vertical pipes only
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsrotatett01()

-- Initialise variables
    !support = !!Mdstt01.support
    !angle   = !!Mdsrotan.angle.val.real()

-- Check that Datum atta has been created
    if (!support.datum.set().not())then
      !!alert.message('Trunnion Support atta has not been created')
      return
    endif

-- Only rotate if pa or pl is u or d
    if (!support.padir neq U and !support.pldir neq U)then
      !!alert.message('Can only rotate if pipe is vertical')
      return
    endif
    !!MdsDacControl(true)
-- Rotate all attas
    do !v values !support.atta
      !!ce = !v
      rotate through ce about pl by $!angle
--<wd>may2003
-- Update the STEX to contain the ORIENTATION to be output on the Isometric Drawing
      skip if (!v.name.match('/SREF').gt(0))
      !!mdstransport(!v,!v.name)
--<wd>may2003
    enddo

-- Update Support Data
    !!ce = !support.datum
    !support.padir  = pa dir wrt world
    !support.pldir  = pl dir wrt world
    !support.p9dir  = p9 dir wrt world
    !support.p10dir = p10 dir wrt world
    !support.p11dir = p11 dir wrt world
    !olddeg = !support.rotated
    !newdeg = !olddeg + !angle
    if (!newdeg geq 360)then
      !newdeg = !newdeg - 360
    endif
    !support.rotated = !newdeg

-- Reset new note for isometric

    var !trundir p3 dir
    !trunlen = despar
    !suppname = !Support.stru.namn
    stex '$!Suppname
Direction = $!trundir
Length = $!trunlen[4]
Offset = 0
WELDED ATTACHMENT DO
NOT CUT HOLE IN PIPE'

    !!Mdstt01.support = !support

-- Navigate to stru
    !!ce = !support.stru
    !!MdsDacControl(false)
  endfunction
-- End function

-- End of file Mdsrotatett01.pml
