--
-- File:		Mdsrotatett02.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 25th February 1998
--
--
-- Description:
-- Function to Change the Orientation of Trunnion type 'TT02-C',
-- ONLY Used on Horizontal Elbow Piping Components
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Form holding pipe support data
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsrotatett02(!form is FORM)

    !!MdsDacControl(true)

 -- Find current units and set the distance unit to metric
    !currentunits = !!kgetsetunits()

-- Initialise variables
    !support = !form.support
    !where   = ''
    !to      = ''
    !elbo    = !form.elboref
    !atta    = !support.datum
    !stype   = !atta.stype

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Check Orientation of Trunnion 'pl' to ELBO 'pl'
    !!ce    = !elbo
    !epldir = pl dir wrt /*
    !eorder = order
    !elstu  = lstu
    !!ce    = !atta
    !apldir = pl dir wrt /*
    !aorder = order

-- Set the Data to Change the Orientation of the Trunnion Atta
    if (!stype.match('TT02-C').eq(1)) then
      if (!epldir eq !apldir) then
        !where = 'before'
        !to    = 'to next'
        !end   = 'pa'
      else
        !where = 'after'
        !to    = ''
        !end   = 'pl'
      endif
    else
      !!kRestoreUnits(!currentunits)
      !!alert.error('The Orientation of this Trunnion type may NOT be modified')
      return
    endif

-- Modify  Orientation of Existing Trunnion Type 'TT02-C' ONLY.
--------------------------------------------------------------------------------
-- Reorder Atta 'before or after' Attched Elbo
    !!ce = !atta.owner
    reorder $!aorder $!where $!eorder

    !!ce = !atta
    if (!where.eq('before')) then
      arrive 1 leave 2
    else
      arrive 2 leave 1
    endif

    fconn $!to
    ori and p12 is down

-- Restate LSTU for ELBO as the TUBE sometimes disappears in the Graphical Display
    !!ce = !elbo
    lstu $!elstu

--------------------------------------------------------------------------------
-- Always add atta to support object
    !!ce = !atta
    !form.support.padir  = pa dir wrt world
    !form.support.pldir  = pl dir wrt world
    !form.support.p9dir  = p9 dir wrt world
    !form.support.p11dir = p11 dir wrt world

-- Add marker text
    !pos = pos wrt world
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Trunnion $<$!pos$>

    var !trundir p3 dir
    !trunlen = despar
    var !trunoff const dir p31 to p12
if !trunlen[2].eq(0) then
  stex '$!form.name
Direction = $!trundir
Length = $!trunlen[4]
Offset = $!trunlen[2]
WELDED ATTACHMENT DO
NOT CUT HOLE IN PIPE'
else
  stex '$!form.name
Direction = $!trundir
Length = $!trunlen[4]
Offset = $!trunlen[2]
Offset Dir. = $!trunoff
WELDED ATTACHMENT DO
NOT CUT HOLE IN PIPE'
endif

  !!MdsDacControl(false)
  endfunction
-- End function

-- End of file Mdsrotatett02.pml
