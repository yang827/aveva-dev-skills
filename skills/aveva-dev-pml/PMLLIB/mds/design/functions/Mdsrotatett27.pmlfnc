--
-- File:		MdsrotatettTT27.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Friday 20th February 1998
--
--
-- Description:
-- Function to rotate TRUNNION type 'TT27' on Vertical pipes only
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsrotateTT27()
    !!MdsDacControl(true)
-- Initialise variables
    !support = !!MdsTT27.support
    !angle   = !!Mdsrotan.angle.val.real()

-- Check that Datum atta has been created
    if (!support.datum.set().not())then
      !!alert.message('Trunnion Support atta has not been created')
      return
    endif

-- Rotate all attas
    do !v values !support.atta
      skip if !v.type.neq('PLAT')
      !!ce = !v
      rotate through ce about pl by $!angle
      !!ce.:mdsrotdir = !!ce.pdir[3]
      !!ce.:mdsrotated = true
    enddo

-- Update Support Data
    !!ce = !support.datum
    !support.padir  = pa dir wrt world
    !support.pldir  = pl dir wrt world
    !support.p9dir  = p9 dir wrt world
    !support.p10dir = p10 dir wrt world
    !support.p11dir = p11 dir wrt world
    !olddeg = !support.rotated
    !newdeg = !olddeg + !angle
    if (!newdeg geq 360)then
      !newdeg = !newdeg - 360
    endif
    !support.rotated = !newdeg

    !!MdsTT27.support = !support
    !!MdsDacControl(false)

  endfunction
-- End function

-- End of file MdsrotateTT27.pml
