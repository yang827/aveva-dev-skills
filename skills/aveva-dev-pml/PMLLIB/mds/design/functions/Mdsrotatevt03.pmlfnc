--
-- File:		Mdsrotatevt03.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 13th January 1998
--
--
-- Description:
-- function to rotate frame type VT03 (Vertical pipes only)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsrotatevt03()

-- Initialise variables
    !support = !!Mdsvt03.support
    !angle   = !!Mdsrotan.angle.val.real()
    -- !select  = !!Mdsvt03.create.selection('rtext')

-- Check that Datum atta has been created
    if (!support.datum.set().not())then
      !!alert.message('Datum support atta has not been created')
      return
    endif

-- Can only rotate framwork if we can write to the stru

    if !!MdsComClaimDac(!support.stru,'DACMOD','POS').not() then
      !!Alert.Error('Unable to rotate support as write access to the support structure is not available')
      return
    endif

-- Only rotate if pa or pl is u or d
    if (!support.padir neq U and !support.pldir neq U)then
      !!alert.message('Can only rotate if pipe is vertical')
      return
    endif
    !!MdsDacControl(true)
-- Rotate all attas
    do !v values !support.atta
      !!ce = !v
      rotate through ce about pl by $!angle
--<wd>may2003
-- Update the STEX to contain the ORIENTATION to be output on the Isometric Drawing
      skip if (!v.name.match('/SREF').gt(0))
      !!mdstransport(!v,!v.name)
--<wd>may2003
    enddo

-- Update Support Data
    !!ce = !support.datum
    !support.padir  = pa dir wrt world
    !support.pldir  = pl dir wrt world
    !support.p9dir  = p9 dir wrt world
    !support.p10dir = p10 dir wrt world
    !support.p11dir = p11 dir wrt world
    !olddeg = !support.rotated
    !newdeg = !olddeg + !angle
    if (!newdeg geq 360)then
      !newdeg = !newdeg - 360
    endif
    !support.rotated = !newdeg

    !!Mdsvt03.support = !support

-- Navigate to stru
    !!ce = !support.stru
    rotate through p0 of $!support.datum about pl of $!support.datum by $!angle
    !!MdsDacControl(false)
  endfunction
-- End function

-- End of file Mdsrotatevt03.pml
