--
-- File:    Mdssaveattainf.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:    I.osborne
-- Created:		Wed Jul 02
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSaveAttaInf(!form is FORM)

  !orig = !!ce.name

  do !atta values !form.support.atta
    !!ce = !atta
    var !despar despar
    !orientation = ori wrt /*
    !position = pos wrt /*
    !spref = spref
    !cp1   = :MDSCp1
-- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
-- the matref attribute has been added to atta. Find the correct attribute to use
    -- The variable !matrefatt will be set to either REF for matref or UDA for :MdsMatref
    !matrefatt = !!mdsUseMatref(!!ce)
    if !matrefatt.eq('UDA') then
        !matr = :MdsMatRef
      else
        !matr = MatRef
      endif
      !offset = :mdsnudgedist
      !rotate = :MDSRotated
      !rotdir =:MDSRotDir
      if (!!ce.:MDSGuideRef.badref().not()) then
        !guide = !!ce.:MDSGuideRef
        !!ce   = !guide
        !gdpos = pos wrt /*
        !gdori = ori wrt /*
        !!ce   = !atta
      endif

    !form.store.append(|$!atta|)
    !form.store.append(|Spref $!spref|)
    !form.store.append(|despar $!despar|)
    !form.store.append(|ori $!orientation|)
    if !form.string().eq('MDSSPECIAL').not() then
      !form.store.append(|at $!position|)
      endif
--<<ak>> added to avoid rounding errors when pipe is not in orthogonal dirs
    if !atta.type.neq('CTSUPP') then
      !form.store.append(|thro ce|)
    endif
    !form.store.append(|:MDSCp1 '$!cp1'|)
    if !matrefatt.eq('UDA') then
        !form.store.append(|:MDSMatRef $!matr|)
      else
        !form.store.append(|MatRef $!matr|)
      endif
      !form.store.append(|:mdsnudgedist  $!offset|)
      !form.store.append(|:MDSRotated $!rotate|)
      !form.store.append(|:MDSRotDir $!rotdir|)

    !form.store.append(|!!mdsResetGuide()|)
      if (!!ce.:MDSGuideRef.badref().not()) then
        !form.store.append(|$!guide|)
        !form.store.append(|ori $!gdori|)
        !form.store.append(|at $!gdpos|)
      endif
      !form.store.append(||)
    enddo

  !!ce = !orig.dbref()
  !!mdsDacControl(false)
endfunction
