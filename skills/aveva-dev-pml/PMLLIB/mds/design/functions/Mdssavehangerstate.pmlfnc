--
-- File:    Mdssavehangerstate.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    A.boudjnah
-- Created:   Fri 22 2002
--
--
-- Description:
-- Saves the hanger and associated elements (hanger, hanger mem, fitt, atta) states
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        FORM of current Hanger type
--
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------


-- Define Function
define function !!mdssavehangerstate(!form is FORM)
  if(define(!!mdsDEBUG)) then
    !!mdsDEBUG.traceIn(1, '!!mdssavehangerstate($!form is FORM)')
  endif

-- Initialise variables
  if(!form.oldsupport.set() and !form.oldsupport.datum eq !form.support.datum) then
    -- hanger state has already been set
    if(define(!!mdsDEBUG)) then
      !!mdsDEBUG.traceOut(1, 'No Saving in !!mdssavehangerstate($!form is FORM)')
    endif
    return
  endif
  !currentunits = !!kgetsetunits()
  units mm bore mm dist
  !form.oldsupport = !form.support
  !support     = !form.oldsupport
  !cecomp      = !!ce


-- Hanger atta
  if !!mdshangif.eq('MDS') then
    !datum = !support.datum
    !!ce = !datum
  endif

-- Save the atta data
  if(!support.oldPosition.unset()) then
    !support.oldPosition = pos wrt /*
    endif
  if(!support.oldOrientation.unset()) then
    !support.oldOrientation = ori wrt /*
  endif
  if(!support.oldSpref.unset()) then
    !support.oldSpref = spref
  endif
  if(!support.oldType.unset()) then
    !support.oldType = :MDSSuppType
    endif

-- Get hanger reference
  !hangRef = !!ce.cref
    -- Goto restr
  !!ce = !hangRef.owner
    handle any
      -- try to go to the restr by its name
    !!ce = !support.rest.ref
      handle any
      !!alert.error('Unable to reach restr in !!mdssavehangerstate')
        !!kRestoreUnits(!currentunits)
      return error 1 'Unable to reach restr in !!mdssavehangerstate' noalert
      endhandle
    endhandle

-- Save Hanger data
   !oRest = !support.rest
  if(!support.oldCref.unset()) then
    !support.oldCref = !oRest.attaConnRef.cref
      handle any
        !!alert.error('Hanger is not connected to an atta')
        !!kRestoreUnits(!currentunits)
        return error 1 'Hanger is not connected to an atta' noalert
      endhandle

    endif
   !hangers = !oRest.hangers
  do !h
    -- Current element is hanger no !i
    $!h
      handle any
        break
      endhandle
    !oHang = !hangers[!h]
     !oHang.name = name
    !oHang.ref = !!ce

     -- Hanger head data
     !oHang.hpos = hpos
     !oHang.hdir = hdir
     !oHang.hbor = hbor
     !oHang.hcon = hcon
     !oHang.href = href

     -- Hanger tail data
     !oHang.tpos = tpos
     !oHang.tdir = tdir
     !oHang.tbor = tbor
     !oHang.tcon = tcon
     !oHang.tref = tref
-- End of Hanger saving
    !oFitt = object MDSFITT()
     !fittRef = !oHang.tref
    !!ce = !fittRef
     handle any
     elsehandle none
     -- Save current Fitting
      if(!!ce.type.eq('FITT')) then
         -- we store only the original fitting
         -- otherwise, if the user try to reconnect the hanger several times without accepting it
         -- the original fitting reference will be lost and overidden by other new temporary fittings
        !oFitt.ref = !!ce
        !oFitt.name = !!ce.name
        if(define(!!mdsDEBUG)) then
          !!mdsDEBUG.traceIn(1, 'Saving fitt name $!oFitt.name')
          endif
        !oFitt.spref = !!ce.spref
         var !delpos delpos of $!fittRef
        !oFitt.delpos = object POSITION('$!delpos')
        !oFitt.zDist = !fittRef.zDist
       endif
      !!ce = !oHang.ref
     endhandle
     !oHang.fitt = !oFitt

    !hangMem = !oHang.hangMem
    do !i
      -- Current element is the hanger member no $!i
      $!i
       handle any
         break
       endhandle
      !ohangMem = !hangMem[!i]
      if(!ohangMem.position.unset()) then
        !ohangMem.position = pos
       endif
      if(!ohangMem.orientation.unset()) then
        !ohangMem.orientation = ori
      endif
      if(!ohangMem.spref.unset()) then
        !ohangMem.spref = spref
      endif
      if(!ohangMem.lsrod.unset()) then
        !ohangMem.lsrod = lsrod
      endif
      if(!ohangMem.desp.unset()) then
        !ohangMem.desp = !!ce.desparam
      endif
      if(!ohangMem.height.unset()) then
        !ohangMem.height = height
        handle any
        endhandle
      endif
      !hangMem[!i] = !ohangMem
       hang
     enddo
    !oHang.hangMem = !hangMem
    !hangers[!h] = !oHang
     rest
   enddo
   !oRest.hangers = !hangers

   !support.rest = !oRest
   !form.oldsupport = !support
   !form.support = !support
  !!ce = !cecomp
   !!kRestoreUnits(!currentunits)
  if(define(!!mdsDEBUG)) then
    !!mdsDEBUG.traceOut(1, '!!mdssavehangerstate($!form is FORM)')
   endif

  endfunction
