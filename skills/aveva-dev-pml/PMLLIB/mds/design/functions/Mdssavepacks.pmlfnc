--
-- File:		Mdssavepacks.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 25th November 1997
--
--
-- Description:
-- Store Packing Piece form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        FORM         Name of Form called from
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdssavepacks(!form is FORM)

-- Initialise Variables
    !orig    = !!ce.name
    !support = !form.support
    !stru    = !support.stru
    !frame   = !stru.name & '/MAIN'

-- Collect All Packing Pieces
    if (!form eq !!Mdsft25) then
      !ppacks  = !!kcollectallfor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !stru)
    else
      !ppacks  = !!kcollectallfor('SCTN', '((match(name, |-PP-|) gt 0) and type of owner eq |FRMW|)', !stru)
    endif

-- Store Attributes for  all Packing Pieces
    do !pack values !ppacks
      !!ce      = !pack
      !name     = !!ce.name
      var !despar despar
      !posstart = poss wrt /*
      !posend   = pose wrt /*
      !drns     = drns wrt /*
      !drne     = drne wrt /*
      !bang     = bang wrt /*
      !spref    = spref
      !attaref  = :MDSAttaRef[1]
      handle  any
-- Unable to set !attaref to :MDSAttaRef[1] as the uda reference is invalid
-- Therefore do not store the data
        skip
      endhandle
      !!ce      = !attaref
      !packnam  = name of :MDSPackRef
      handle any
      endhandle
      !packref  = :MDSPackRef

      !form.ppack.append('!!ce = $!frame')
      !form.ppack.append('new sctn $!name')
      !form.ppack.append('spref $!spref')
      !form.ppack.append('poss ' & !posstart.string())
      !form.ppack.append('pose ' & !posend.string())
      !form.ppack.append('drns $!drns')
      !form.ppack.append('drne $!drne')
      !form.ppack.append('bang $!bang')
      !form.ppack.append(':MDSAttaRef $!attaref')
      !form.ppack.append('desp $!despar')
      !form.ppack.append('!!ce = $!attaref')
      if (!packref.badref()) then
        !form.ppack.append(':MDSPackRef unset')
      else
        !form.ppack.append(':MDSPackRef $!packnam')
      endif

    enddo

    !!ce = !orig.dbref()

  endfunction

-- End of file Mdssavepacks.pml
