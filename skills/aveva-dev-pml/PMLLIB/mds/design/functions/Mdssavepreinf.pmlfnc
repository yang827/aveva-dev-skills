--
-- File:    Mdssavepreinf.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    I.osborne
-- Created:   Wed Jul 02
--
--
-- Description:
-- Store preliminary data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSavePreInf(!atta is DBREF) is ARRAY

  !store = ARRAY()
  if !atta.sequ.eq(1) then
  	!prev = !atta.owner
  else
  	!prev = !atta.owner.memb[!atta.sequ - 1]
  endif
  !store.append(!prev.string())
  !store.append('new atta ref ' & !atta)
  !store.append(!atta.string())
  !store.append('ori ' & !atta.ori)
  !store.append('pos ' & !atta.pos)
  !store.append('name ' & !atta.name)
  !store.append('spre ' & !atta.spre)
  !store.append('lstu ' & !atta.lstu)
  !store.append('ispe ' & !atta.ispe)
  !store.append('hrel ' & !atta.hrel)
  !store.append('shop ' & !atta.shop)
  !store.append('spkbrk ' & !atta.spkbrk)
  !store.append('stext ''' & !atta.stext & '''')
--<<ak>> added to avoid rounding errors when pipe is not in orthogonal dirs
  if !atta.type.neq('CTSUPP') then
    !store.append('thro ce')
  endif

  -- now store only those UDA's that have been modified
  !udaset = !atta.udaset
  do !uda values !udaset
  	!attribute= object ATTRIBUTE(!uda)
  	!atttype = !attribute.type()
  	!attlen = !attribute.length()
  	if !atttype.eq('TEXT') then
  	  !store.append(!uda & ' ''' & !atta.attribute(!uda) & '''')
  	else
  		if !attlen.eq(1) then
  			!udaval = !uda & ' ' & !atta.attribute(!uda)
  		else
  			!udaval = !uda
  			do !c from 1 to !attlen
  				!singleval = !atta.attribute(!uda)[!c].string()
  				handle ANY
  					break
  				endhandle
  				break if !singleval.eq('DBATT')
  				if !atttype.eq('REFERENCE') then
  					if !atta.attribute(!uda)[!c].badref() then
  						skip
  					endif
  				endif
  				!udaval = !udaval & ' ' & !singleval
  			enddo
  		endif
  		!store.append(!udaval)
  	endif
  enddo

  return !store

endfunction
