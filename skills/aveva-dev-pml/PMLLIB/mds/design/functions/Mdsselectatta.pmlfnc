--
--
-- Description:
-- function to modify a pipe shoe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Form name
--     2     R        STRING        Key from dataset
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSelectAtta(!Form is FORM)

  !CurrentUnits = !!KGetSetUnits()

  if !form eq !!mdstt27 then
    if !form.member.val.eq(3) then $* its a gusset plate activate the gadget
      !form.pdepth.active = true
    else
      !form.pdepth.active = false
    endif
  endif

-- Access correct member
  label /reset
  !Name = !Form.member.rtext[$!Form.member.val]
  !Atta = $!Name
   handle any
-- Include bearing Plate for styp AC19A into array
     !Bplate = !!collectallfor('atta','styp eq |AC19A| or styp eq |AC19B|',!!ce.owner)
     !!Mdstt13.support.atta.append($!Bplate[1])
     golabel /reset
   endhandle

   !!CE = !Atta

  !Styp = styp
--$p ** !styp is $!styp **
-- If its a AC20 then the pl bore must be used
  if !Styp.eq('AC20') then
    !Bore = pl bore
  else
    !Bore = pa bore
  endif
--$p****** bore size is
--q var !bore

-- Get the DTSE Property Values and Set the Relevant Form Gadgets
  !!MdsGetProp(!Form.Plength,!Form.PLength,'PLEN',!Bore,'$!Styp')
  !!MdsGetProp(!Form.PWidth,!Form.PWidth,'PWID',!Bore,'$!Styp')
  !!MdsGetProp(!Form.PThk,!Form.PThk,'PTHK',!Bore,'$!Styp')
  !!MdsGetProp(!Form.Ilen,!Form.Ilen,'ILEN',!Bore,'$!Styp')
  handle any
  endhandle
  !!MdsGetProp(!Form.Clea,!Form.Clea,'CLEA',!Bore,'$!Styp')
  handle any
  endhandle
  !!MdsGetProp(!Form.pdepth,!Form.pdepth,'DPTH',!Bore,'$!Styp')
  handle any
  endhandle

  --< tm addition to activate deactivate the plate depth gadget
  if !form eq !!mdstt27 then
    if !form.member.val.eq(3) then $* its a fillet plate activate the gadget
      !form.pdepth.active = true
    else
      !form.pdepth.active = false
      !form.pdepth.val = object real()
    endif
  endif




-- Reset units back
  !!kRestoreUnits(!currentunits)

return

endfunction
