--
-- File:		Mdsselecttrim.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Nov 9th 2001
--
-- Description:
-- function to select if trimmer steel is required
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        Form          Passing form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSelectTrim(!Form is FORM)

  -- Has the datum been selected yet

  if !Form.Support.datum.unset() then
    !!Alert.error('Unable to set the trimmer requirement as the datum atta has not been selected')
    return
  endif

  -- If the framework is connected there can be no requirement for a trimmer so reject selection

  if !Form.Support.Joints.Size().gt(0) then
    !!Alert.error('Unable to set the trimmer reqirement as the framework is connected to a steelwork member')
    return
  endif

-- Can only modify the trimmer requirement if we can write to the datum atta

    if !!MdsComClaimDac(!form.support.datum,'DACMOD','POS').not() then
      !!Alert.Error('Unable to modify the trimmer requirement as write access is not available to the datum atta')
      return
    endif

  -- Save current position

  !ce = !!CE

  -- Find out the current value
  -- For hangers the atta will store the value under the uda :MDSTrimmer
  -- For frameworks the atta will store the value under the uda :MDSTrimmer

  -- Find the type

  if !Form.Support.Type.match('HT').eq(1) then
    !Current = !Form.Support.Datum.:MDSTrimmer
    !Element = !Form.Support.Datum
  else
    !Current = !Form.Support.Stru.:MDSTrimmer
    !Element = !Form.Support.Stru
  endif

  -- Display appropiate message to user

  if !Current then
    if !!Alert.confirm('Are you sure you want to remove the trimmer steel requirement?').eq('YES') then
      !!CE = !Element
      :MDSTrimmer false
      !Active = true
    else
      return
    endif
  else
    if !!Alert.confirm('Are you sure you want to add the trimmer steel requirement?').eq('YES') then
      !!CE = !Element
      :MDSTrimmer true
      !Active = false
    else
      return
    endif
  endif

  -- Set the joint icons to the active state in var !Active
  -- If joints allowed

  if not !Form.Support.Type inset('FT01','FT02','FT21','FT22','FT24','FT25','FT28','VT') then
      !Form.connect.active = $!Active
      !Form.modify.active = $!Active
      !Form.forcecon.active = $!Active
      !Form.disconn.active = $!Active
  endif

  -- Reset to initial db position

  !!CE = !ce

-- End function
endfunction

-- End of file Mdsselecttrim.pml
