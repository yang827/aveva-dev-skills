--
-- File:      Mdssellstu.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MPS134
--
-- Author:    I.osborne
-- Created:		Mon Jul 14
--
--
-- Description:
-- function to select the passed components lstu
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         DBREF        Element
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSelLstu(!element is DBREF)

  --<KP> Oct 2008
  -- handle CTSUPP
  if !element.type.eq('CTSUPP') then
    return
  endif

  !!mdsDacControl(true)
  -- Try to select lstu

    sel lstu
      handle any
    !lstu = LSTU OF PREV
           handle any
      !lstu = HSTU OF BRAN
           endhandle
      endhandle

  LSTU $!lstu
      handle (46,28)
      endhandle

--<wd>8may2003
-- Check that the Current ATTA is a valid MDS Cradle/Reinforcing/Wear Pad
     --if (!element.stype inset ('AT05','AT09','AT23','AT52A','AT52B','AT52C','AT52D','AT52E','AT52F')) then
     if (!element.stype inset ('AT05','AT09','AT23','AT24','AT52A','AT52B','AT52C','AT52D','AT52E','AT52F','AT65')) then
-- Set the MTOREF array[1] attribute at the ATTA to be the same as the LSTU as the ATTA
       !!ce.mtoref[1] = !!ce.lstu
     endif
--<wd>8may2003

  !!mdsDacControl(false)

-- End function
endfunction
