--
-- File:		Mdssetbedplate.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MSETBP
--
-- Author:		I.Osborne
-- Created:		Wed Jun 18
--
--
-- Description:
-- function to reference bed plate to support. Max number of references equal 2.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Support Form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetBedPlate(!Form is FORM,!Reference is REAL)

-- The reference variable will be the bedplate reference to set

  if !!MdsBedPlate.BedpType eq 'FRAME' then
    if !Reference eq 1 then
      !Sctn = !!MdsBedPlate.Sctn1.val
      if (!sctn.match('/').eq(1)) then
        !sctn = !sctn.after('/')
      endif
    else
      !Sctn = !!MdsBedPlate.Sctn2.val
      if (!sctn.match('/').eq(1)) then
        !sctn = !sctn.after('/')
      endif
    endif
  else
    !Sctn = !!Mdsbedplate.name.val.after('/')
  endif

  !Prompt = |Identify base/anchor plate to reference.|

-- Check to see if the current bpref uda (at the STRU etc...)
-- is already used and confirm with user that it is OK to modify

  if !!MdsBedPlate.BedpType eq 'FRAME' then
    !!CE = !Form.Support.Stru
  else
    /$!Sctn
  endif

-- Can only modify the atta if we can write to it

  if !!MdsComClaimDac(!!ce,'DACMOD','POS').not() then
    !!Alert.Error('Unable to set the bed/anchor plate references as write access is not available')
    return
  endif

  !ref = :MDSBPREF$!<Reference>
  if (!ref.badref().not()) then
    if !Sctn.eq('N/A') then
      !DisplayText = 'Support is already referenced to a bed/anchor plate. OK to modify?'
    else
      !DisplayText = 'Section $!Sctn is already referenced to a bed/anchor plate. OK to modify?'
    endif
    if (!!Alert.confirm('$!DisplayText') eq |NO|)then
      golabel /exit
    else
-- Store STRU Existing Bedplate References in case Support is Cancelled
      if !Ref.type.eq('STRU') then
        !form.strubpref.append(!!ce)
        !form.storebpref.append(':MDSbpref$!<reference> $!ref')
-- Unset Current Stru Bedplate Reference
        :MDSbpref$!<reference> default
-- Navigate to Bedplate
        !!ce = !ref
        !struref = :MDSbpref$!<reference>
-- Store Current Bedplate Reference in case Support is Cancelled
        !form.strubpref.append(!!ce)
        !form.storebpref.append(':MDSbpref$!<reference> $!struref')
-- Unset Current Bedplate Stru Reference - Always :MDSBpref1 at the BedPlate Stru
        :MDSBpref1 default
      else
-- Sbfi ref
-- Remove the references at SBFI
-- Get the current references if any
        :MDSbpref$!<reference> default
        !!ce = !ref
        !SupportRefs = :MdsAncRef
        if !!MdsBedPlate.BedpType eq 'FRAME' then
          !FindSupp = !SupportRefs.find(!Form.Support.Stru)
        else
          !FindSupp = !SupportRefs.find(!Form.Support.Datum)
        endif
        if !FindSupp.size().gt(0) then
          !SupportRefs[$!FindSupp[1]].delete()
        endif
        do !Count from 1 to !Supportrefs.size()
          if !SupportRefs[$!Count].badref() then
            !SupportRefs[$!Count].delete()
          endif
        enddo
        !Supportrefs.compress()
        if !SupportRefs.size().eq(0) then
          :mdsancref default
        else
          !!ce.:MdsAncRef = !SupportRefs
        endif
      endif
    endif

  else

-- Store Default value for Current STRU Bedplate Reference
    !form.strubpref.append(!!ce)
    !form.storebpref.append(':MDSbpref$!<reference> default')
  endif

-- Set reference

label /again

-- Enhance member that is being referenced unless special

  if !Form.support.type.neq('SPECIAL') then

    if type of /$!Sctn eq 'SUBS' then
      enhance mem of /$!Sctn colour 2
    else
      enhance /$!Sctn colour 2
    endif
    refresh

  endif

    prompt off
    prompt load escape |$!Prompt|
    id sbfi stru @
      handle (61,528)
        prompt dismiss
        prompt on
        !!CE = !Form.Support.Stru
          handle (2,106)
            !!CE = !Form.Support.Datum
          endhandle
        !form.strubpref.removelast()
        !form.storebpref.removelast()
        golabel /exit
      endhandle
    prompt dismiss
    prompt on
    !Picked = !!CE

-- Is the identified stru a bedplate

  if !Picked.type.eq('STRU') then
    if (!Picked.skey ne 'BEDP')then
      !!Alert.error('Item picked is not a bedplate')
      golabel /again
    endif
  endif

-- Is the bedplate identified referenced to another support, if its a stru
-- Subfitting can have multiple references

  if !!ce.type.eq('STRU') then

    !IdBedRef = !!CE.:MDSBpref1

    if (!IdBedRef.badref().not()) then

      if (!!Alert.confirm('The Bed Plate picked is already referenced to another support. Ok to reset reference?') eq |YES|)then
-- Navigate to the OTHER Support
        !!ce      = !idbedref
        !xsupref1 = :MDSBpref1

        if (!!ce.type.neq('ATTA')) then
          !xsupref2 = :MDSBpref2
        else
          !xsupref2 = nulref
        endif

-- Store the Already Referenced Support Bedplate References
        if (!picked.eq(!xsupref1)) then
          !form.strubpref.append(!!ce)
          !form.storebpref.append(':MDSBpref1 $!xsupref1')
-- Unset Reference to Bedplate
          :MDSBpref1 default
        elseif (!picked.eq(!xsupref2)) then
          !form.strubpref.append(!!ce)
          !form.storebpref.append(':MDSBpref1 $!xsupref2')
-- Unset Reference to Bedplate at the Already Referenced Support
          :MDSBpref2 default
        endif
-- Navigate to Selected Bedplate
        !!ce = !picked
 -- Store the Existing Refs. at the BedPlate.
        !form.strubpref.append(!!ce)
        !form.storebpref.append(':MDSBpref1 $!idbedref')
      else
        golabel /exit
      endif

    endif

-- Set Reference at BEDPLATE
    if !!MdsBedPlate.BedpType eq 'FRAME' then
      !SetBpRef = !Form.Support.Stru.name
--xxx      :MDSBpref$!Reference $!SetBpRef
      :MDSBpref1 $!SetBpRef
    else
      --!SetBpRef = !Form.Support.Datum.name
      !SetBpRef = /$!sctn
--xxx      :MDSBpref$!Reference $!SetBpRef
      :MDSBpref1 $!SetBpRef
    endif

-- Set  Reference at Support Framework etc...
    if !!MdsBedPlate.BedpType eq 'FRAME' then
      !!CE = !Form.Support.Stru
    else
      /$!Sctn
    endif

    !!MdsDacControl(true)
    !Bpref = !picked
    :MDSBpref$!Reference $!Bpref

  -- Update form
    !!MdsBedPlate.Ref$!<Reference>.val = !Bpref.namn

  -- Update Support Object
    !Form.Support.Bedplate$!Reference = !Bpref

    else

      !Bpref = !picked

-- Set references at SBFI
-- Get the current references if any

      !SupportRefs = :MdsAncRef
      if !!MdsBedPlate.BedpType eq 'FRAME' then
        !SupportRefs.append(!Form.Support.Stru)
        !SupportRefs.unique()
      else
        !SupportRefs.append(!Form.Support.datum)
        !SupportRefs.unique()
      endif
-- Remove any invalid sprefs
      do !Count from 1 to !Supportrefs.size()
        if !SupportRefs[$!Count].badref() then
          !SupportRefs[$!Count].delete()
        endif
      enddo
      !Supportrefs.compress()
      !!ce.:MdsAncRef = !SupportRefs

-- Set  Reference at Support Framework etc...

      if !!MdsBedPlate.BedpType eq 'FRAME' then
        !!CE = !Form.Support.Stru
      else
        /$!Sctn
      endif

      !!MdsDacControl(true)
      if !!MdsBedPlate.BedpType eq 'FRAME' then
        !!ce = !Form.Support.Stru
      else
        !!ce = !Form.Support.Datum
      endif
      :MDSBpref$!Reference $!Bpref
      !Bpref = !picked

      -- Update form
      !!MdsBedPlate.Ref$!<Reference>.val = !Bpref.namn
      !Form.Support.bedplate1 = !BPref

    endif

label /exit

  -- UnEnhance member that is being referenced and reenhance the whole support

  if !Form.Support.type.neq('SPECIAL') then

    if type of /$!Sctn eq 'SUBS' then
      unenhance mem of /$!Sctn
    else
      unenhance /$!Sctn
    endif

    !!CE = /$!Sctn
    !ColourList = array()
    !ColourList.append(!!CE.ref)
    Call !!KEnhanceList(!ColourList)

  endif

  !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdssetbedplate.pml
