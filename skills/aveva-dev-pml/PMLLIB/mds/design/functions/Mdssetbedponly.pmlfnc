--
-- File:		Mdssetbedponly.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MSETBP
--
-- Author:		I.Osborne
-- Created:		Wed Jun 18
--
--
-- Description:
-- function to reference bed plate to support. Max number of references equal 2.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Support Form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetBedPonly(!Form is FORM)

  -- Initialise variables
    !Support     = !Form.Support
    !BedPlateNum = !Support.BPNum

  -- Check that framework has been created
    if (!Support.Atta.Size() eq 0)then
      !!Alert.error('Support has not been created')
      return
    endif

    !Prompt = |Identify baseplate to reference to.|

Label /again

    PROMPT OFF
    PROMPT LOAD ESCAPE |$!Prompt|
    ID STRU @
      handle (61,528)
        PROMPT DISMISS
        PROMPT ON
        return
      endhandle
    PROMPT DISMISS
    PROMPT ON
    !Picked = !!CE

    if (!Picked.skey ne 'BEDP')then
      !!Alert.error('Item picked is not a bedplate')
      golabel /again
    endif

  -- OK we have found our bedplate


    -- Initialise variables

    !ExistingBpref1 = :MDSBpref1
    !!CE = !Support.Atta[1]
    !ExistingAtref1 = :MDSBpref1

    if (!ExistingAtref1 eq !Picked) then

-- Already referenced

      !!Alert.error('Support is already referenced to this bedplate!')
      return


    elseif (!ExistingAtref1.badref()) then

-- New reference

      -- Store existing reference on bedplate
        !Form.StruBpref.clear()
        !Form.StruBpref.append(!Support.Atta[1])
        !Form.StruBpref.append(!Picked)
        !Form.StoreBpref.clear()
        !Form.StoreBpref.append(':MDSBpref1 DEFAULT')
      -- Set reference on bedplate
        !!CE = !Picked
        :MDSBpref1 $!Support.Atta[1]
      -- Set reference on atta
        !!CE = !Support.Atta[1]
        :MDSBpref1 SAME

    else

-- Atta is referenced to another bedplate

      if (!!Alert.confirm('Support is already referenced to another bedplate. Ok to reset references?') eq |YES|)then

      -- Navigate to support that has been referenced
        !!CE = !ExistingAtref1
        :MDSBpref1 def

      -- Reset bpref
        !Form.StruBpref.removelast()
        !Form.StruBpref.append(!Picked)

      -- Set reference on bedplate
        !!CE = !Picked
        :MDSBpref1 $!Support.Atta[1]
      -- Set reference on atta
        !!CE = !Support.Atta[1]
        :MDSBpref1 SAME

      -- Set reference on Current Support
        !Support.bedplate1 = !Picked

    endif

  endif

  -- Update support information
    !Form.Support = !Support

-- End function
endfunction

-- End of file Mdssetbedponly.pml
