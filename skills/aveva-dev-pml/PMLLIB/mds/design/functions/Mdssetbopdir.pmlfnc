--
-- File:  Mdssetbopdir.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MBOPDIR
--
-- Author:  I.osborne
-- Created:  Tue Jun 03
--
--
-- Description:
-- Set direction of ancillary component
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Support Form to modify
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetBopDir(!form is FORM)

  !cecomp = !!ce

  !!ce = !!mdsBopDir.dirElement
  handle ANY
    --if this errors then dirElement has not been explicitly set. this is not a problem but is required for FT21
  endhandle

  -- Initialise variables
  !direction = !!mdsBopDir.dir.val
  !!mdsdaccontrol(true)
  ORI AND P3 IS $!direction WRT WORLD
  handle any
    same
    !!mdsdaccontrol(false)
    !!alert.error('Unable to orientate in direction given')

    -- Re-Show this FORM until a VALID Ancillary Direction is Entered into the '.dIR' gadget
    !!kshowform(!!mdsBopDir)

  elsehandle none
    !newatta = !!ce
    !name = !!mdsGetSuppName(!!ce)
    -- !name    = !!ce.name
    -- Update the STEX to contain the ORIENTATION to be output on the Isometric Drawing
    !!mdstransport(!newatta,!name.string())

  endhandle

  -- Adjust Support details held in form
  !form.support.pADir  = Pa Dir wrt world
  !form.support.pLDir  = Pl Dir wrt world
  !form.support.p9Dir  = P9 Dir wrt world
  !form.support.p10Dir = P10 Dir wrt world
  !form.support.p11Dir = P11 Dir wrt world

  --<tm>25/08/2004 go and orientate lugs if it needs them
  !!mdsCreateLugs()

  Axes Delete

  !!ce = !cecomp

endfunction
