--
-- File: Mdssetdatan01.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: N.morris
-- Created: Tue Oct 28
--
--
-- Description:
-- Creation function for anchors
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatAn01()

  -- Find current units and set the distance unit to metric
  !currentunits = !!kgetSetUnits()

  -- Initialise variables
  !tubeType    = !!mdsoptions.pipes
  !datum       = !!mdsan01.support.datum
  !name        = !!mdsan01.name.val
  !alias       = !!mdsan01.support.alias
  !fromAtta    = !!mdsan01.support.preliminaryStore.set()
  !!mdsan01.bedplate.active = true

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Select tube
  if (!alias inset('AN01A')) then
    !tubeType = 'ELBO'
    !pipeType = 'elbo'
    !idType = 'pipe'
    !purp = 'PIPE'
    -- 01.03.02 added by A.b. to change the prompt to 'Identify shoe of pipe'
  elseif (!alias inset('AN04')) then
    !pipeType = 'shoe'
    !idType = 'pipe'
    !purp = 'PIPE'
    -- End of addition by A.b.
  else
    if (!tubeType eq 'FTUB')then
      !pipeType = 'lined section'
    else
      !pipeType = 'tube'
    endif
    !idType = 'pipe'
    !purp = 'PIPE'
  endif

  label /again

  -- <ak> 20/06/2012
  if (!fromAtta.not()) then
    if (!!mdsIdTube(!tubeType, 'Identify $!pipeType of $!idType',!purp).not())then
      !!kRestoreUnits(!currentunits)
      return
    endif
  else
    if (!alias inset('AN01A')) then
      if (defined (!!mdsAutoTubePicker) AND !!mdsAutoTubePicker.enabled()) then

        -- return if limit of pick tries exceeded
        if (!!mdsAutoTubePicker.allowedPicks.eq(0)) then
          !!mdsAutoTubePicker.cancel()
          return FALSE
        endif

        !picked = !!mdsAutoTubePicker.pick('ELBO','')
        if unset(!picked) then
          !!alert.warning ('There is no elbow suitable for this type of ANCHOR support.')
          !!mdsAutoTubePicker.cancel()
          !!kRestoreUnits(!currentunits)
          return false
        else
          !!ce = !picked
        endif
      endif
    elseif (!alias inset('AN04')) then
      if (defined (!!mdsAutoTubePicker) AND !!mdsAutoTubePicker.enabled()) then

        -- return if limit of pick tries exceeded
        if (!!mdsAutoTubePicker.allowedPicks.eq(0)) then
          !!mdsAutoTubePicker.cancel()
          return FALSE
        endif

        !picked = !!mdsAutoTubePicker.pickShoe()
        if unset(!picked) then
          !!alert.warning ('There is no pipe shoe suitable for this type of ANCHOR support.')
          !!mdsAutoTubePicker.cancel()
          !!kRestoreUnits(!currentunits)
          return false
        else
          !!ce = !picked
        endif
      endif
    else
      !!ce = object DBREF('/' & !name & '_Pre')
    endif
  endif
  -- </ak> 20/06/2012

  --var !mode mode
  forwards
  !where = ''
  !to = ''

  ------------------------------------------------------------------------------------------
  -- Identified elbo must have it's pa or pl pointing u if types AN01A
  if (!alias inset('AN01A')) then
    !patest = pa dir wrt /*
    !pltest = pl dir wrt /*
    if ('$!patest' eq 'U WRT /*' or '$!patest' eq 'Z WRT /*') then
      !where = 'before'
      !to = 'to next'
      !p5dir = pl dir wrt /*
    elseif ('$!pltest' eq 'U WRT /*' or '$!pltest' eq 'Z WRT /*') then
      !where = ''
      !to = ''
      !p5dir = pa dir wrt /*
    else
      !!alert.error('Identified elbow is not suitable')
      -- <ak> 20/06/2012
      if (!fromAtta) then
        !!mdsAutoTubePicker.cancel()
        !!kRestoreUnits(!currentunits)
        return false
      else
        golabel /again
      endif
      -- </ak> 20/06/2012
    endif
    -- An extra despar has to be calculated when these types are used
    -- which is the leg-length + 1/2 * OD
    !ll = !!kstrReal('const dist p0 to p2')
    !od = pl od
    !dp2 = (0.5 * !od + !ll)

    ------------------------------------------------------------------------------------------
  elseif (!alias.eq('AN04')) then
    --<wd>oct2002
    -- Check if Identified Type is a PIPE SHOE
    !stype     = !!ce.stype
    if (!!ce.type.eq('ATTA')) then
      if (!!ce.catref.owner.:mdstype.upcase().trim().neq('SHOE')) then
        -- <ak> 20/06/2012
        if (!fromAtta) then
          !!mdsAutoTubePicker.cancel()
          !!kRestoreUnits(!currentunits)
          return false
        else
          golabel /again
        endif
        -- </ak> 20/06/2012
      endif
      !dpnum = !!mdsgetdesp('BWID')
      if (!dpnum.eq(0)) then
        -- DKEY BWID (Bolt c/c for SHOE width) does NOT exist in the DATASET of the Identified SHOE
        !!alert.error ('Identified Pipe Shoe [ Type: $!stype ] is NOT suitable for this type of ANCHOR support.')
        -- <ak> 20/06/2012
        if (!fromAtta) then
          !!mdsAutoTubePicker.cancel()
          !!kRestoreUnits(!currentunits)
          return false
        else
          golabel /again
        endif
        -- </ak> 20/06/2012
      endif
    else
      -- <ak> 20/06/2012
      if (!fromAtta) then
        !!mdsAutoTubePicker.cancel()
        !!kRestoreUnits(!currentunits)
        return false
      else
        golabel /again
      endif
      -- </ak> 20/06/2012
    endif

    --<wd>may2006<mds12>
    -- New CHECK Required here for the ANCHOR "AN04" -- "SELECTION" and "RESTRICTION" Pipe Shoe types
    !mdssele = object MDSSELECTION(|AN04|)
    if (!mdssele.continue.not()) then
      -- Unable to Continue the creation of an ANCHOR type "AN04"
      ---------------------------------------------------------------------------------------------------
      --<wd>dec2006<mds12>
      --!anctype = !!codean04
      --handle ANY
      --  !anctype = |AN04|
      --endhandle
      --
      -- Determine the Client Code from the PARAGON MDS12 Defaults
      !anctype = !!mdsgetdefprop('ATTA', 'AN04', 'CCOD')
      if (!anctype.eq(|ERROR|)) or (!anctype.trim().eq(||)) then
        -- Use the AVEVA MDS STANDARD NAME
        !anctype = |AN04|
      endif
      --<wd>dec2006<mds12>
      ---------------------------------------------------------------------------------------------------

      !!alert.error(|The SELECTION and/or the RESTRICTION DEFAULT DATA elements do NOT exist for the ANCHOR type "$!<anctype>" in the MDS PARAGON DEFAULTS DB.
      ABORTING creation of the ANCHOR support.
      Please contact your MDS ADMINISTRATOR...|)
      !!ce = !cecomp
      !!kRestoreUnits(!currentunits)
      return
    endif

    -- Identified element is an MDS PIPE SHOE
    -- Get a List of Valid Support Types for an AN04 type anchor
    --!select    = !!mdsselan04.selection
    !select    = !mdssele.selection
    --!restrict  = !!mdsselan04.restriction
    !restrict  = !mdssele.restriction
    --
    !valid     = !select.difference(!restrict)

    ---------------------------------------------------------------------------------------------------
    --<wd>dec2006<mds12>
    --!xtype     = !!code$!stype
    -- Get the Identified Pipe Shoe Client CODE
    !xtype = !!mdsgetdefprop('ATTA', !stype, 'CCOD')
    --   $P !xtype = $!xtype
    --<wd>dec2006<mds12>
    ---------------------------------------------------------------------------------------------------

    !vtypes    = ''
    !validshoe = FALSE
    --<wd>may2006<mds12>

    -- Check the Ancillary RESTRICTION List First to see if Identified Shoe is of a Valid Type
    if (!restrict.empty().not()) then
      do !rtyp values !restrict
        if (!rtyp.match(!stype).gt(0)) then
          !!alert.error ('Identified Pipe Shoe [ Type: $!stype ] has been RESTRICTED, and may NOT used with this type of ANCHOR support.')
          -- <ak> 20/06/2012
          if (!fromAtta) then
            !!mdsAutoTubePicker.cancel()
            !!kRestoreUnits(!currentunits)
            return false
          else
            golabel /again
          endif
          -- </ak> 20/06/2012
        endif
      enddo
    endif

    -- Check Ancillary Selection List to see if Identified Shoe is of a Valid Type
    if (!valid[1].eq('*')) then
      !validshoe = true
    else
      do !vtyp values !valid

        ---------------------------------------------------------------------------------------------------
        --<wd>dec2006<mds12>
        --!vtyper = '!!code' & !vtyp.before('*')
        -- Get the Client CODE of the Ancillary in the Selection List
        !xstype = !vtyp.before('*')
        !vtyper = !!mdsgetdefprop('ATTA', !xstype, 'CCOD')
        --!atypes = $!vtyper
        !atypes = !vtyper
        --<wd>dec2006<mds12>
        ---------------------------------------------------------------------------------------------------

        if (!vtypes.eq('')) then
          !vtypes = !atypes
        else
          !vtypes = !vtypes & ', ' & !atypes
        endif
        if (!vtyp.match(!stype).eq(1)) then
          !validshoe = TRUE
        endif
      enddo
    endif

    if (!validshoe.not()) then
      !!alert.error ('Identified Pipe Shoe [ Type: $!xtype ] may NOT be selected for this type of ANCHOR support. valid Shoe Types are [ $!vtypes ].')
      -- <ak> 20/06/2012
      if (!fromAtta) then
        !!mdsAutoTubePicker.cancel()
        !!kRestoreUnits(!currentunits)
        return false
      else
        golabel /again
      endif
      -- </ak> 20/06/2012
    endif

    -- Get SHOE property values
    !atta    = !!ce
    !shoewid = (prop SWID)
    handle ANY
      !shoewid = (prop FWID)
    endhandle
    !shoehei = (prop HEI)
    ------------------------------------------------------------------------------------------

  else
    -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
    -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.
    !currcomp = !!ce
    if (!!ce.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
    endif

    if (!hdir neq U and !hdir neq D ) then
      if (!!mdsgradient(!currcomp)) then
        !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsoptions.slope.val)')
        !!ce = !cecomp
        !!kRestoreUnits(!currentunits)
        return
      endif
    endif

  endif
  ------------------------------------------------------------------------------------------

  -- Select ancillary
  if(!!kgetBoreUnits()) then
    UNITS INCH BORE
  endif

  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  -- <ak> 20/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsan01.support.datum = !!ce
    !!mdsDistance(!!mdsan01)
  else
    new atta $!where
  endif
  -- </ak> 20/06/2012
  SPKBRK TRUE

  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsan01.support.replace
    !!alert.error('Unable to select anchor $!projStandard at this bore($!bore)')
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsan01, true)
      return
    endif
    delete atta
    !!kRestoreUnits(!currentunits)
    return
  elsehandle none
    -- The element may exist in the specification but the project may not contain the size in the parameters file
    ------------------------------------------------------------------------------
    -- mjb >>> 03.05.06 <mds12>
    --if undefined(!!mdspar$!alias[$!bore]) then
    units mm bore
    spref $!choice[1]
    !lbor = !!ce.lbor.real().value()
    !mds12test = !!mdssetdespars(!!ce)
    if (!mds12test.not()) then

      !projStandard = !!mdsan01.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <ak> 20/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsan01, true)
        return
      endif
      delete atta
      !!kRestoreUnits(!currentunits)
      return
    endif
  endhandle
  --mm bore
  --spref $!choice[1]

  !!mdssetdespars(!!ce)

  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!!ce.stype,!lbor)
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsan01, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif

  !check = object MDSCHECKSTD(!mdsattaobj)
  --!check = object MDSCHECKSTD()
  -- mjb <<< 03.05.06 end of mod
  ------------------------------------------------------------------------------

  !min = STRING()
  !max = STRING()
  !materror = STRING()

  if (!check.material(!materror).not()) then
    !!alert.error (!materror)
    !!kRestoreUnits(!currentunits)
    !!mdsDacControl(true)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsan01, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  endif

  if (!check.insu(!alias,!min,!max).not()) then
    !!mdsInsulationError(!currentunits, !min, !max, '')
    !!kRestoreUnits(!currentunits)
    !!mdsDacControl(true)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsan01, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  endif

  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below
  !tmin = STRING()
  !tmax = STRING()
  if (!check.temp(!alias,!tmin,!tmax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tmin / $!tmax)')
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsan01, true)
      return
    endif
    delete atta
    return
  endif

  -- Test if the ancillary is available at this elevation
  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedElevation = !position.up
    ------------------------------------------------------------------------------
    -- mjb >>> 03.05.06 <mds12>
    !minimumelevation = !mdsattaobj.elevation
    --!minimumelevation = !!mdspar$!alias[0].despars[1]
    -- mjb <<< 03.05.06 end of mod
    ------------------------------------------------------------------------------

    !!alert.message ('The elevation selected is unsuitable for this ancillary. selected elevation $!selectedElevation Minimum elevation $!minimumelevation')
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsan01, true)
      return
    endif
    delete atta
    return
  endif

  -- Set the ATTA - (UDA :MDSMatRef at MDS11.6) The NEW PDMS12 ATTA ATTRIBUTE at MDS12 with the PROPCON Property found in the MDS12 PARAGON DEFAULT DTSE
  !!mdssetmatref(!!ce)

  if (!alias inset('AN01A')) then
    despar n2 $!dp2
  endif

  --<dw>oct2008 dun979 - Dac control added to allow anchor to be named
  !!mdsDacControl(true)
  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsan01.support.type|

  !!mdsSetIspe()

  --  Add stex for isometrics
  !satta = !!ce

  !!mdsSelLstu(!!ce)

  !!mdsDacControl(true)

  if (!fromAtta.not()) then
    if (!alias inset('AN01A')) then
      fconn $!to and p5 is $!p5dir
      !p3dir = p3 dir wrt /*
      if ('$!p3dir' neq 'D WRT /*' and '$!p3dir' neq '-Z WRT /*') then
        flip ori
        fconn $!to and p5 is $!p5dir
      endif
    elseif (!alias inset('AN01B')) then
      pos at pl of prev
      handle any
        pos at ph
      endhandle
      ori
    else
      POS AT PREV
      handle any
        pos at ph
      endhandle
      ori
    endif
  endif

  Call !!mdsTransport(!satta,!name)

  -- Add marker text
  VAR !pos POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  -- Always add atta to support object
  !!mdsan01.support.atta.clear()
  !!mdsan01.support.atta.append(!!ce)
  !!mdsan01.support.datum  = !!ce
  !!mdsan01.support.paDir  = Pa Dir wrt world
  !!mdsan01.support.plDir  = Pl Dir wrt world
  !!mdsan01.support.p9Dir  = P9 Dir wrt world

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.appendarray(!!mdsan01.support.atta)

  -- Colour Support
  Call !!kenhanceList(!colourlist)

  -- When finished grey out datum gadget and reset height,length and setsteel
  !!mdsSetGadgets(!!mdsan01,!!ce,!!mdsan01.support.type)

  !!mdsan01.datum.active = false

  if (!alias inset('AN01A')) then
    !!mdsan01.bdist.active = false
    !!mdsan01.dist.active = false
    !!mdsan01.bthro.active = false
    !!mdsan01.select.active = false
    !!mdsan01.nudge.active = false
    !!mdsan01.bedplate.active = true
    --!!mdsan01.rotate.active = false
  elseif (!alias inset('AN01B')) then
    !!mdsan01.bdist.active = true
    !!mdsan01.dist.active = true
    !!mdsan01.bthro.active = true
    !!mdsan01.select.active = true
    !!mdsan01.nudge.active = true
    !!mdsan01.bedplate.active = true
    --!!mdsan01.rotate.active = false
  else
    !!mdsan01.bdist.active = true
    !!mdsan01.dist.active = true
    !!mdsan01.bthro.active = true
    !!mdsan01.select.active = true
    !!mdsan01.nudge.active = true
    !!mdsan01.bedplate.active = true
    !!mdsan01.rotate.active = true
  endif

  !!mdsDacControl(true)

  --------------------------------------------------------------------------------
  -- Special for AN04 is the requirement of setting the BLEN dkey to the width
  -- of the beam it is sitting on
  if !!mdsan01.support.type.eq('AN04') then
    -- Identify beam to bolt guide to
    despar num 1 $!shoehei
    prompt off
    prompt load escape 'Identify section to bolt guide to'
    !boltdia = despa num 4

    --<wd>17jan2008 -- Defect No. P-4407
    --    ID SCTN @
    ID SCTN HSTIFF @
    --<wd>17jan2008 -- Defect No. P-4407
    handle (61,528)
      -- User has cancelled insert dummy values
      prompt on
      var !prop coll all data with dkey eq 'SBFT' for dtre
      var !ccprop coll all data with dkey eq 'BLEN' for dtre
      var !num1 eval num for all from !ccprop
      var !num2 eval num for all from !prop
      despar n$!num1[1] 100mm
      despar n$!num2[1] 100mm
      despar n2 ($!shoewid - ($!boltdia[1] * 1.5))
    endhandle

    prompt on
    -- TBHL to TBHR for the cross centres
    -- Also the flange thickness is needed
    var !cc const dist ppline TBHL start to ppline TBHR start
    handle any
      -- 01.03.02 A.b. Find beam width
      var !cc const dist ppline LTOS start to ppline RTOS start
      handle any
        var !cc 100
        !!alert.error('Unable to find bolt cross centres from identified section')
      endhandle
      -- 01.03.02 A.b. Used 1.5 bolt diam from beam edge.
      !cc = STRING(Real(!cc) - $!boltdia[1] * 3)
    endhandle
    !flanThk = (prop FLG)
    handle any
      !flanThk = 10
    endhandle

    same
    var !prop coll all data with dkey eq 'SBFT' for dtre
    var !ccprop coll all data with dkey eq 'BLEN' for dtre
    var !num1 eval num for all from !ccprop
    var !num2 eval num for all from !prop
    despar n$!num1[1]  $!cc
    handle any
    endhandle
    despar n$!num2[1]  $!flanThk
    -- !!mdsan01.height.active = false
    -- !!mdsan01.length.active = false

    --<wd>may2006<mds12>
    -- Determine the DATA DEFAULT Bolt c/crs on the Anchor 'AN04' just created
    -- Identified by the Dataset Dkey = BWID
    !!ce    = !satta
    !stypes = !!ce.stype
    !dpnum  = !!mdsgetdesp('BWID')
    !bwid   = !!ce.desp[!dpnum]
    --<wd>may2006<mds12>

    -- Set the Bolt c/crs on the Identified Pipe Shoe
    -- Identified by the Dataset Dkey = BWID
    !!ce   = !atta
    !real  = !atta.abor.real()
    !dpnum = !!mdsgetdesp('BWID')

    -- Determine the Bolt c/c for the Identified Pipe Shoe
    --<wd>may2006<mds12>
    -- Determine the MDS ATTA DATA object for the IDENTIFIED Pipe Shoe
    --!bwid  = !!mdspar$!<stype>[!real].despars[!dpnum]
    !mdsshoeobj = object MDSREADPARSDATA()
    !mdsshoedef = !mdsshoeobj.mdsdefsdata(!!ce.stype, !real)
    if (!mdsshoedef.not()) then
      -- ERROR -- UNABLE to Determine the Bolt c/c DATA value for the IDENTIFIED Pipe Shoe,
      -- but WARN USER and CONTINUE!!!
      !!alert.error(|Unable to Determine the Bolt c/c DATA DEFAULT value for the IDENTIFIED Pipe Shoe.
      The Bolt c/c value for the identified Pipe Shoe has been set to the DEFAULT value set at the ANCHOR.
      i.e. bolt c/c = $!<bwid> |)

    else
      -- Valid Bolt c/c DATA value found for the IDENTIFIED Pipe Shoe
      !shoecc = !mdsshoeobj.despars[!dpnum]
      !bwid   = $!shoecc

    endif
    --<wd>may2006<mds12>

    -- Set the Bolt c/c for the Identified Pipe Shoe
    desp num $!dpnum  $!bwid

    --$P ***  desp num $!dpnum $!bwid
    -- Now Set the Bolt c/crs on this Anchor 'AN04' just created
    -- Identified by the Dataset Dkey = BWID
    !!ce    = !satta
    !stypes = !!ce.stype
    !dpnum  = !!mdsgetdesp('BWID')
    -- Set the Bolt c/c for the Anchor 'AN04' just created to be the SAME as the Identified PIPE SHOE
    desp num $!dpnum  $!bwid

    --------------------------------------------------------------------------------

  elseif !!mdsan01.support.type.eq('AN06') then

    -- Identify beam to bolt guide to
    prompt off

    --<wd>jan2004
    --    prompt load escape 'Identify section to bolt guide to'
    prompt load escape 'Identify section to use as stop'

    --<wd>17jan2008 -- Defect No. P-4407
    --    ID SCTN @
    ID SCTN HSTIFF @
    --<wd>17jan2008 -- Defect No. P-4407
    handle (61,528)
      prompt on
      -- golabel /end
    endhandle
    prompt on
    -- TBHL to TBHR for the cross centres
    -- Also the flange thickness is needed
    !flanThk = (prop WIDT)
    same
    var !ccprop coll all data with dkey eq 'SSMW' for dtre
    var !num1 eval num for all from !ccprop
    despar n$!num1[1]  $!flanThk

    -- We also need to set the insulation thickness from the pipe
    var !ithkprop coll all data with dkey eq 'ITHK' for dtre
    var !num1 eval num for all from !ithkprop
    var !insu insu
    despar n$!num1[1]  $!insu

  elseif !!mdsan01.support.type.eq('AN11') or !!mdsan01.support.type.eq('AN10') then
    -- Identify beam to use as stop
    prompt off
    prompt load escape 'Identify section or box to use as stop'
    --<wd>17jan2008 -- Defect No. P-4407
    --    ID SCTN BOX @
    ID SCTN BOX HSTIFF @
    --<wd>17jan2008 -- Defect No. P-4407
    handle (61,528)
      prompt on
      golabel /end
    endhandle
    prompt on
    --<wd>17jan2008 -- Defect No. P-4407
    --   if !!ce.type EQ 'SCTN' then
    if !!ce.type EQ 'SCTN' or !!ce.type EQ 'HSTIFF'   then
      --<wd>17jan2008 -- Defect No. P-4407
      !beamWidth = (prop WIDT)
      same
      var !ccprop coll all data with dkey eq 'WID' for dtre
      var !num1 eval num for all from !ccprop
      despar n$!num1[1]  $!beamWidth
    endif
    if !!ce.type EQ 'BOX' then
      !box = !!ce
      same
      pin 2 copy pl
      pin 3 copy pl
      pin 2 plane pin 2 clear 0 infront $!box
      pin 3 plane pin 3 clear 0 behind $!box
      !boxWidth = !!kstrReal('const dist pin 2 to pin 3')
      var !ccprop coll all data with dkey eq 'WID' for dtre
      var !num1 eval num for all from !ccprop
      despar n$!num1[1]  $!boxWidth
      !!mdsresetpins(2,3)
    endif
  endif

  label /end

  !!mdsan01.adjust.active = false
  if !!mdsan01.support.type.eq('AN06') or !!mdsan01.support.type.eq('AN10') or !!mdsan01.support.type.eq('AN11') then
    !!mdsan01.adjust.active = true
  elseif !!mdsan01.support.type.eq('AN04') then
    !!mdsan01.adjust.active = true
  endif

  -- Reset Units
  !!mdsDacControl(false)
  !!kRestoreUnits(!currentunits)

  -- set focus to the distance text gadget
  !!mdsan01.dist.setFocus()

endfunction
-- End of function definition for !!mdsSetDatAn01
