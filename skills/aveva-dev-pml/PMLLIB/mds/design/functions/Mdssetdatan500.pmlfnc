--
-- File: Mdssetdatan500.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: N.morris
-- Created: Tue Oct 28
--
--
-- Description:
-- Creation function for user defined anchor An500
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatAn500()

  -- Force into forwards mode
  FORWARDS

  -- Find current units and set the distance unit to metric
  !currentunits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType    = !!mdsOptions.pipes
  !datum       = !!mdsan500.support.datum
  !name        = !!mdsan500.name.val
  !alias       = !!mdsan500.support.alias
  !fromAtta    = !!mdsan500.support.preliminaryStore.set()
  -- This will set !std[1] to the std text and !std[2] to the std number.
  !std         = !!mdsGetStdNum(!!mdsan500.support.alias)

  !unusedcecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- User defined anchor for shoes AN500 to AN569
  -- User defined guides for shoes AN500 to AN569
  if (!std[1].eq('GT')) then
    !displaytext = 'Guide'
  elseif (!std[1].eq('ST')) then
    !displaytext = 'Stop'
  else
    !displaytext = 'Anchor'
  endif

  if (!std[2].real().geq(500) and !std[2].real().lt(570)) then

    if (!fromAtta.not()) then
      -- Identify shoe to attach anchor to
      prompt off
      prompt load escape 'Identify pipe shoe to $!displaytext'
      ID ATTA @
      handle (61,528)
        prompt on
        !!kRestoreUnits(!currentunits)
        return false
      endhandle
      prompt on

    else

      if (defined (!!mdsAutoTubePicker) AND !!mdsAutoTubePicker.enabled()) then

        -- return if limit of pick tries exceeded
        if (!!mdsAutoTubePicker.allowedPicks.eq(0)) then
          !!mdsAutoTubePicker.cancel()
          return FALSE
        endif

        !picked = !!mdsAutoTubePicker.pickShoe()
        if (unset(!picked)) then
          !!alert.warning ('There is no suitable pipe shoe.')
          !!mdsAutoTubePicker.cancel()
          !!kRestoreUnits(!currentunits)
          return false
        else
          !!ce = !picked
        endif
      endif
    endif

    -- Is it a shoe?
    -- Get properties from shoe and set at anchor
    !shei = prop hei
    handle ANY
      !!alert.error('Identified element is not a shoe')
      return
    endhandle
    !swid = prop fwid
    handle ANY
      !!alert.error('Identified element is not a shoe')
      return
    endhandle
    !atta = !!ce

    !type = 'shoe'

    -- User defined anchor for pipes AN570 to AN639
  elseif (!std[2].real().geq(570) and !std[2].real().lt(640)) then

    -- Select tube type required options form
    if (!tubeType eq 'FTUB')then
      !pipeType = 'lined section'
    else
      !pipeType = 'tube'
    endif
    !iDType = 'pipe'
    !purp = 'PIPE'

    if (!fromAtta.not()) then
      if (!!mdsIdTube(!tubeType, 'Identify $!pipeType of $!iDType',!purp).not())then
        !!kRestoreUnits(!currentunits)
        return
      endif
    else
      !!ce = object DBREF('/' & !name & '_Pre')
    endif

    !type = 'pipe'

  endif

  -- Select ancillary
  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  !!mdsdaccontrol(true)

  if (!fromAtta) then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsan500.support.datum = !!ce
  else
    new atta
  endif

  SPKBRK TRUE

  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsan500.support.replace
    !!alert.error('Unable to select ancillary $!projStandard at this bore($!bore)')
    if (!fromAtta) then
      !!mdsRestorePre(!!mdsan500, true)
      return
    endif
    delete atta
    !!kRestoreUnits(!currentunits)
    return
  elsehandle NONE
    -- The element may exist in the specification but the project may not contain the size in the parameters file
    spref $!choice[1]
    !guideatta = !!ce
    !lbor = !guideatta.lbor.real().value()
    !mds12test = !!mdssetdespars(!guideatta)
    if (!mds12test.not()) then
      !projStandard = !!mdsan500.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      !!mdsdaccontrol(false)
      if (!fromAtta) then
        !!mdsRestorePre(!!mdsan500, true)
        return
      endif
      delete atta
      !!kRestoreUnits(!currentunits)
      return
    endif
  endhandle

  !!mdsdaccontrol(true)

  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!guideatta.stype,!lbor)

  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentunits)
    if (!fromAtta) then
      !!mdsRestorePre(!!mdsan500, true)
      return
    endif
    delete atta
    !!mdsdaccontrol(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)
  !min = STRING()
  !max = STRING()
  !matError = STRING()

  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentunits)
    if (!fromAtta) then
      !!mdsRestorePre(!!mdsan500, true)
      return
    endif
    delete atta
    return
  endif

  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentunits)
    if (!fromAtta) then
      !!mdsRestorePre(!!mdsan500, true)
      return
    endif
    delete atta
    return
  endif

  if (!check.insu(!alias,!min,!max).not()) then
    !!mdsInsulationError(!currentunits, !min, !max, '')
    !!kRestoreUnits(!currentunits)
    if (!fromAtta) then
      !!mdsRestorePre(!!mdsan500, true)
      return
    endif
    delete atta
    return
  endif

  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below
  !tmin = STRING()
  !tmax = STRING()
  if (!check.temp(!alias,!tmin,!tmax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tmin / $!tmax)')
    !!kRestoreUnits(!currentunits)
    if (!fromAtta) then
      !!mdsRestorePre(!!mdsan500, true)
      return
    endif
    delete atta
    return
  endif

  -- Test if the ancillary is available at this elevation
  if (!check.elevation(!alias).not()) then
    !position = !!ce.position.wrt(/* )
    !selectedelevation = !position.up
    !minimumelevation = !mdsattaobj.elevation
    !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedelevation Minimum elevation $!minimumelevation')
    !!kRestoreUnits(!currentunits)
    if (!fromAtta) then
      !!mdsRestorePre(!!mdsan500, true)
      return
    endif
    delete atta
    return
  endif

  -- Set the material
  !!mdssetmatref(!!ce)

  !!mdsdaccontrol(TRUE)

  -- Name support
  :MDSSuppType |$!!mdsan500.support.type|
  Name /$!name

  -- Set Anchor Atta :MDSGuideRef to Shoe Atta only if !type is shoe
  if (!type.eq('shoe')) then
    :MDSGuideRef $!atta
    !guide = !!ce
    -- Navigate back to Shoe Atta and Set :MDSGuideRef to Anchor Atta
    !!ce  = !atta
    :MDSGuideRef $!guide
    handle ANY
      claim ce
      :MDSGuideRef $!guide
    elsehandle NONE
    endhandle
    --------------------------------------------------------------------------------
    -- Set Anchor dims to the shoe that it is supporting
    !!mdsResetGuide()
    !!ce = !guide
  else
    -- Set the distance gadgets
    !!mdsan500.dist.active = TRUE
    !!mdsan500.bDist.active = TRUE
    !!mdsan500.bThro.active = TRUE
    !!mdsan500.select.active = TRUE
  endif

  !!mdsSetIspe()

  --  Add stex for isometrics
  call !!mdsTransport(!!ce,!name)

  !!mdsSelLstu(!!ce)

  !!mdsdaccontrol(true)

  POS AT PREV
  handle ANY
    POS AT PH OF BRAN
  endhandle
  ori and p3 is p3 of prev
  handle ANY
    ori
  endhandle

  -- Add marker text
  VAR !pos POS P9 WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  -- Always add atta to support object
  !!mdsan500.support.atta.clear()
  !!mdsan500.support.atta.append(!!ce)
  !!mdsan500.support.datum  = !!ce
  !!mdsan500.support.pADir  = Pa Dir wrt world
  !!mdsan500.support.pLDir  = Pl Dir wrt world
  !!mdsan500.support.p9Dir  = P9 Dir wrt world
  !!mdsan500.support.position = true

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.appendarray(!!mdsan500.support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourlist)

  -- When finished grey out datum gadget and reset gadgets
  !!mdsSetGadgets(!!mdsan500,!!ce,!!mdsan500.support.type)
  !!mdsan500.datum.active = FALSE

  !!mdsdaccontrol(true)

  -- User Defined Anchor for shoe
  if ((!std[1].eq('AN') and !type.eq('shoe')) or (!std[1].eq('ST') and !type.eq('shoe'))) then

    -- Identify beam to sit on, this can be either a sctn or box
    prompt off
    !lcdisplaytext = !displaytext.lowcase()
    prompt load escape 'Identify section or box to use as $!lcdisplaytext'
    ID SCTN BOX HSTIFF @
    handle (61,528)
      prompt on
      var !hprop coll all data with dkey eq 'HEI' for dtre
      var !num2 eval num for all from !hprop
      despar n$!num2[1]  $!shei
      !!mdsdaccontrol(false)
      !!kRestoreUnits(!currentunits)
      golabel /end
    endhandle
    prompt on

    if (!!ce.type EQ 'SCTN' or !!ce.type EQ 'HSTIFF') then
      !width = prop widt
      same
      var !prop coll all data with dkey eq 'SBFW' for dtre
      var !hprop coll all data with dkey eq 'HEI' for dtre
      var !wprop coll all data with dkey eq 'WID' for dtre
      var !num1 eval num for all from !prop
      var !num2 eval num for all from !hprop
      var !num3 eval num for all from !wprop
      if (!num1.size().gt(0)) then
        despar n$!num1[1]  $!width
      endif
      if (!num2.size().gt(0)) then
        despar n$!num2[1]  $!shei
      endif
      if (!num3.size().gt(0)) then
        despar n$!num3[1]  $!swid
      endif
    elseif (!!ce.type EQ 'BOX') then
      !box = !!ce
      same
      pin 2 copy pl
      pin 3 copy pl
      pin 2 plane pin 2 clear 0 infront $!box
      pin 3 plane pin 3 clear 0 behind $!box
      !width = !!kStrReal('const dist pin 2 to pin 3')
      var !prop coll all data with dkey eq 'SBFW' for dtre
      var !hprop coll all data with dkey eq 'HEI' for dtre
      var !num1 eval num for all from !prop
      var !num2 eval num for all from !hprop
      if (!num1.size().gt(0)) then
        despar n$!num1[1]  $!width
      endif
      if (!num2.size().gt(0)) then
        despar n$!num2[1]  $!shei
      endif
      !!mdsresetpins(2,3)
    endif

  endif

  !!mdsdaccontrol(false)
  !!kRestoreUnits(!currentunits)

  label /end

  !!mdsdaccontrol(false)

endfunction
