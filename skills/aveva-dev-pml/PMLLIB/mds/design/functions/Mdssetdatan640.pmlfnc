--
-- File:  Mdssetdatan640.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Creation function for guide an640
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatan640()

  -- This standards is available on a baseplate AC18A / B and AC30/AC57

  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  --  !tubeType = !!mdsOptions.pipes
  !datum       = !!mdsAN640.support.datum
  !name        = !!mdsAN640.name.val
  !alias         = !!mdsAN640.support.alias
  !fromAtta    = !!mdsAN640.support.preliminaryStore.set()
  !currentunits = !!kgetsetunits()

  -- Get std and number
  !std = !!mdsGetStdNum(!alias)
  if !std[1].eq('AN') then
    !displayText = 'Anchor'
  elseif !std[1].eq('GT') then
    !displayText = 'Guide'
  else
    !displayText = 'Stop'
  endif

  --  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    return
  endif

  -- <ak> 21/06/2012
  if (!fromAtta AND defined (!!mdsAutoTubePicker) AND !!mdsAutoTubePicker.enabled()) then
    -- return if limit of pick tries exceeded
    if (!!mdsAutoTubePicker.allowedPicks.eq(0)) then
      !!mdsAutoTubePicker.cancel()
      return FALSE
    endif

    !picked = !!mdsAutoTubePicker.pick('PLAT','')
    if (unset(!picked) OR !picked.styp.match('AC18').lt(1) and !picked.styp.match('AC30').lt(1) and !picked.styp.match('AC57').lt(1)) then
      !!alert.warning ('There is no suitable baseplate next to preliminary support.')
      !!mdsAutoTubePicker.cancel()
      !!kRestoreUnits(!currentunits)
      return false
    else
      !!ce = !picked
    endif
  else
    -- Identify baseplate to attach guide to
    prompt off
    prompt load escape 'Identify baseplate to $!displayText'
    ID PLAT ATTA @
    handle (61,528)
      prompt on
      return false
    endhandle
    prompt on
    --  !cestyp = !!ce.styp

    if !!ce.styp.match('AC18').lt(1) and !!ce.styp.match('AC30').lt(1) and !!ce.styp.match('AC57').lt(1) then
      !!alert.error('The identified element is not suitable with this type, it must be a baseplate')
      return
    endif
  endif
  -- <ak>

  --  !bedPlateStyp = !!ce.styp
  --  !bedPlate = !!ce
  !p3dir = p3 dir wrt /*

  !atta = !!ce

  -- Select ancillary
  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  !!mdsDacControl(TRUE)

  -- <ak> 20/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsAN640.support.datum = !!ce
  else
    new atta
    handle (2,18)
      !!alert.error('Identified element is locked')
      !!mdsDacControl(false)
      !!kRestoreUnits(!currentunits)
      return
    endhandle
  endif
  -- </ak> 20/06/2012


  SPKBRK TRUE

  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !!mdsDacControl(false)
    !!kRestoreUnits(!currentunits)
    !projStandard = !!mdsAN640.support.replace
    !!alert.error('Unable to select ancillary $!projStandard at this bore($!bore)')
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAN640, true)
      return
    endif
    delete atta
    return
  elsehandle NONE

    !lbor = !atta.lbor.real()
    !gt12atta = !!ce
    spref $!choice[1]

    !mds12test = !!mdssetdespars(!gt12atta)
    if (!mds12test.not()) then

      !!mdsDacControl(false)
      !projStandard = !!mdsAN640.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <ak> 20/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsAN640, true)
        return
      endif
      delete atta
      !!kRestoreUnits(!currentunits)
      return
    endif
  endhandle
  !!mdsDacControl(true)

  -- If the baseplate uses a non standards size we need to read the PWID abnd PLEN and then
  -- set the PWID PLEN of the guide.

  !pwid = (prop PWID of $!atta)
  handle NONE
    var !whichData coll all data with dkey eq 'PLEN' for dtre of ce
    !despNum = !whichData[1].dbref().num
    handle NONE
      desp N$!despNum  $!pwid
    elsehandle ANY
    endhandle
  elsehandle ANY
  endhandle
  !plen = (prop PLEN of $!atta)
  handle NONE
    var !whichData coll all data with dkey eq 'PWID' for dtre of ce
    !despNum = !whichData[1].dbref().num
    handle NONE
      desp N$!despNum  $!plen
    elsehandle ANY
    endhandle
  elsehandle ANY
  endhandle
  !pthk = (prop PTHK of $!atta)
  handle NONE
    var !whichData coll all data with dkey eq 'PTHK' for dtre of ce
    !despNum = !whichData[1].dbref().num
    handle NONE
      desp N$!despNum  $!pthk
    elsehandle ANY
    endhandle
  elsehandle ANY
  endhandle

  ori and p11 is $!p3dir

  !!mdsDacControl(TRUE)

  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below
  !check = object MDSCHECKSTD()
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!gt12atta.stype,!lbor.real().value())
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAN640, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)
  !min = STRING()
  !max = STRING()
  !matError = STRING()

  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAN640, true)
      return
    endif
    delete atta
    return
  endif

  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentunits)
    -- <sk> 04/07/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAN640, true)
      return
    endif
    delete atta
    return
  endif

  if (!check.insu(!alias,!min,!max).not()) then
    !!mdsInsulationError(!currentunits, !min, !max, '')
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAN640, true)
      return
    endif
    delete atta
    return
  endif

  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below

  !!mdsDacControl(true)
  !tmin = STRING()
  !tmax = STRING()
  if (!check.temp(!alias,!tmin,!tmax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tmin / $!tmax)')
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAN640, true)
      return
    endif
    delete atta
    return
  endif

  -- Test if the ancillary is available at this elevation

  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedElevation = !position.up
    ---------------------------------------------------------------------------------
    -- mjb >>> 26.04.06 <mds12>
    !minimumElevation = !mdsattaobj.elevation
    --!minimumElevation = !!mdsPar$!alias[0].despars[1]
    -- mjb <<< 26.04.06 <mds12> end of mod
    ---------------------------------------------------------------------------------
    !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedElevation Minimum elevation $!minimumElevation')
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAN640, true)
      return
    endif
    delete atta
    return
  endif

  -- Set the material
  !!mdssetmatref(!!ce)

  -- Name support
  !!mdsDacControl(true)
  :MDSSuppType |$!!mdsAN640.support.type|
  Name /$!name
  !!ce.:mdsguideref = !atta
  handle ANY
    claim ce
    !!ce.:mdsguideref = !atta
  elsehandle NONE
  endhandle
  --<wd>24apr2003
  !!ce = !atta
  :MDSGuideRef same
  /$!name
  !atta = !!ce

  !!mdsSetIspe()

  !saveori = ori
  CONN
  ori $!saveori

  --  Add stex for isometrics

  call !!mdsTransport(!atta,!name)

  !!mdsSelLstu(!!ce)

  !!mdsDacControl(TRUE)

  -- Add marker text
  VAR !pOS POS P9 WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  -- Always add atta to support object
  !!mdsAN640.support.atta.clear()
  !!mdsAN640.support.atta.append(!!ce)
  !!mdsAN640.support.datum  = !!ce
  !!mdsAN640.support.pADir  = Pa Dir wrt world
  !!mdsAN640.support.pLDir  = Pl Dir wrt world
  !!mdsAN640.support.p9Dir  = P9 Dir wrt world
  !!mdsAN640.support.position = true

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsAN640.support.atta)

  -- Colour Support
  Call !!kEnhanceList(!colourList)

  -- When finished grey out datum gadget and reset gadgets
  !!mdsSetGadgets(!!mdsAN640,!!ce,!!mdsAN640.support.type)
  !!mdsAN640.datum.active = false
  !!mdsAN640.rotAtt.active = TRUE
  !!mdsAN640.modatta.active = TRUE

  !!mdsDacControl(false)

  !!kRestoreUnits(!currentunits)

  -- End function
endfunction
