--
-- File: Mdssetdatat01.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: N.morris
-- Created: Tue Oct 28
--
--
--

-- Description:
-- Creation function for general ancillary at01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatAt01()

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kgetsetunits()

  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !datum    = !!mdsAT01.support.datum
  !name     = !!mdsAT01.name.val
  !alias    = !!mdsAT01.support.alias
  !!mdsAT01.bedplate.active = true
  !fromAtta = !!mdsAT01.support.preliminaryStore.set()

  !replace  = !!mdsAT01.support.replace

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif
  if (!alias inset('LT01A','LT01B','LT01C','AT61','AT116','AT117','AT118','AT119','AT120','AT121','AT122','AT123','AT124','AT125','AT32','AT63','AT64','AT65','LT15','LT16A','LT16B')) then
    !!mdsAT01.bedplate.active = FALSE
  endif

  -- Select tube
  if (!alias inset('AT10A','AT11A')) then
    !tubeType = 'ELBO'
    !pipeType = 'elbo'
    !idType = 'pipe'
    !purp = 'PIPE'
  elseif !alias inset('AT53A','AT53B','LT10','LT11','LT12') then
    !pipeType = 'Support Atta'
    !idType = 'pipe'
    !purp = 'PIPE'
  elseif !alias inset('AT185') then
    --<kp>may2011
    !pipeType = 'VALV'
    !idType = 'pipe'
    !tubeType = 'VALV'
    !purp = 'PIPE'
  elseif !alias inset('ST62') then
    !pipeType = 'PCOM'
    !idType = 'pipe'
    !tubeType = 'PCOM'
    !purp = 'PIPE'
  else
    if (!tubeType eq 'FTUB')then
      !pipeType = 'lined section'
    else
      !pipeType = 'tube'
    endif
    !idType = 'pipe'
    !purp = 'PIPE'
  endif

  label /again

  if (!!mdsIdTube(!tubeType, 'Identify $!pipeType of $!idType',!purp).not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif
  var !unusedmode mode
  forwards
  !where = ''
  !to = ''
  !trunclamp = FALSE

  -- Identified elbo must have it's pa or pl pointing u if types AT10A or AT11A
  -- or if AT10A or AT10B leg must be horizontal

  if (!alias inset('AT10A','AT11A')) then
    !patest = pa dir wrt /*
    !pltest = pl dir wrt /*
    if ('$!patest' eq 'U WRT /*' or '$!patest' eq 'Z WRT /*') then
      !where = 'before'
      !to = 'to next'
      !p5dir = pl dir wrt /*
    elseif ('$!pltest' eq 'U WRT /*' or '$!pltest' eq 'Z WRT /*') then
      !where = ''
      !to = ''
      !p5dir = pa dir wrt /*
    else
      !!alert.error('Identified elbow is not suitable')
      golabel /again
    endif
    -- An extra despar has to be calculated when these types are used
    -- which is the leg-length + 1/2 * OD
    !ll = !!kStrReal('const dist p0 to p2')
    !od = pl od
    !dp2 = (0.5 * !od + !ll)
  elseif (!alias inset('AT10B','AT11B')) then
    if (!!ce.type eq 'BRAN') then
      pin 9 copy ph
      var !p9dir pin 9 dir wrt /*
      !!mdsResetPins(9,9)
      if (match('$!p9dir',|U|) gt 0) or (match('$!p9dir',|D|) gt 0) then
        !!alert.error('Identified tube must be horizontal')
        golabel /again
      endif
    else
      !pltest = pl dir wrt /*
      if (match('$!pltest',|U|) gt 0) or (match('$!pltest',|D|) gt 0) then
        !!alert.error('Identified tube must be horizontal')
        golabel /again
      endif
    endif
    --elseif (!alias inset('LT01A','LT01B','LT01C','LT02','LT03A','LT03B','LT03C','LT03D','LT04','AT27','LT06','AT61','LT14A','LT14B','LT15')) then
    --<wd>dec2004
    --  elseif (!alias inset('LT01A','LT01B','LT01C','LT02','LT03A','LT03B','LT03C','LT03D','LT04','AT27','LT06','AT61','LT15')) then
  elseif (!alias inset('LT01A','LT01B','LT01C','LT02','LT03A','LT03B','LT03C','LT03D','LT04','AT27','LT06','AT61','AT116','AT117','AT118','AT119','AT120','AT121','AT122','AT123','AT124','AT125')) then
    --<wd>dec2004
    if (!!ce.type eq 'BRAN') then
      pin 9 copy ph
      var !p9dir pin 9 dir wrt /*
      !!mdsResetPins(9,9)
      if ('$!p9dir' neq |U|) and ('$!p9dir' neq |D|) then
        !!alert.error('Identified tube must be vertical')
        golabel /again
      endif
    else
      !pltest = pl dir wrt /*
      if ('$!pltest' eq |U WRT /*|) or ('$!pltest' eq |D WRT /*|) then
      else
        !!alert.error('Identified tube must be vertical')
        golabel /again
      endif
    endif
  elseif !alias inset('AT53A','AT53B') then
    if match('AT55A AT55B AT55C AT56 AT06 AT03 AT16 AC45 AC29 AC44 AC53',!!ce.stype) eq 0 then
      !!alert.error('You must identify a clamp ')
      golabel /again
    endif
    !identifiedStype = !!ce.styp
    if match('AC45 AC29 AC44 AC53',!!ce.stype) gt 0 then
      !trunclamp = TRUE
      !trunclampname = !!ce
    endif
  elseif !alias inset('LT10') then
    if (!!ce.type neq 'ATTA') then
      !!alert.error('You must identify a clamp')
      golabel /again
    endif
    !where = ''
    !to = ''
    if match('AC53 AC54 AT93 AT94',!!ce.stype) eq 0 then
      !!alert.error('You must identify a clamp of the correct type')
      golabel /again
    endif
    --Only create on vertical pipes
    !pltest = p41 dir wrt /*
    if ('$!pltest' eq |U WRT /*|) or ('$!pltest' eq |D WRT /*|) then
    else
      !!alert.error('Identified clamp must be vertical')
      golabel /again
    endif
    --Get Pos of Clamp
    !p41dir = p41 dir wrt /*
    if ('$!p41dir' eq |U WRT /*|) then
      !where = 'Before'
      !to = 'To next'
      !poslug = P41 pos wrt /*
    else
      !where = ''
      !to = ''
      !poslug = P40 pos wrt /*
    endif
  elseif !alias inset('LT11','LT12') then
    if (!!ce.type neq 'ATTA') then
      !!alert.error('You must identify a clamp')
      golabel /again
    endif
    !where = ''
    !to = ''
    if match('AC53 AC54 AT72 AT73 AT87 AT93 AT94',!!ce.stype) eq 0 then
      !!alert.error('You must identify a clamp of the correct type')
      golabel /again
    endif
    --Only create on horizontal pipes
    !pltest = pl dir of href of owne wrt /*
    handle(2,257)
      !pltest = pl dir
    endhandle
    if ('$!pltest' eq |U WRT /*|) or ('$!pltest' eq |D WRT /*|) then
      !!alert.error('Identified clamp must be horizontal')
      golabel /again
    endif
    !poslug = Pos wrt worl
    !length = Prop Clen
  elseif !alias.eq('AT185') then
    --<kp>may2011  Butterfly valve support AT185
    !message = STRING()
    if !!ce.type.eq('VALV') then
      if !!ce.lcon.matchwild('W*').not() then
        !message = 'Identified component must be a wafer VALV.'
      endif
    else
      !message = 'Identified component must be a VALV.'
    endif

    if !message.unset() then
      -- check if support is not already there
      !next = next
      handle NONE
        if !next.type.eq('ATTA').and(!next.styp.eq('AT185')) then
          !message = 'Support already exists for the VALV picked.'
        endif
      elsehandle ANY
      endhandle
    endif

    if !message.unset() then
      -- check if PIPE is not vertical and within the slope tolerance
      !currcomp = !!ce
      if !!mdsgradient(!currcomp) then
        !message = 'The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)'
      endif
    endif

    if !message.set() then
      -- pick VALV again
      !!alert.error(!message)
      golabel /again
    endif
  elseif !alias inset('ST62') then
    --<kp>nov2010
    -- Fix point support ST62 added
    !message = STRING()
    if !!ce.type.eq('PCOM') then
      if !!ce.styp.eq('FIPO').not() then
        !message = 'Identified component must be a PCOM of stype FIPO'
      endif
    else
      !message = 'Identified component must be a PCOM'
    endif
    if !message.unset() then
      -- check if support is not already there
      !next = next
      handle NONE
        if !next.type.eq('ATTA').and(!next.styp.eq('ST62')) then
          !message = 'Support already exists for the PCOM picked'
        endif
      elsehandle ANY
      endhandle
    endif
    if !message.unset() then
      -- check if PIPE is not vertical and within the slope tolerance
      !currcomp = !!ce
      if !!mdsgradient(!currcomp) then
        !message = 'The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)'
      endif
    endif
    if !message.set() then
      -- pick PCOM again
      !!alert.error(!message)
      golabel /again
    endif
  else
    -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
    -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

    !currcomp = !!ce
    if (!!ce.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
    endif

    if (!hdir neq U and !hdir neq D ) then
      if (!!mdsgradient(!currcomp)) then
        !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
        !!ce = !cecomp
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          -- cancel autopicker and restore preliminary
          !!mdsAutoTubePicker.cancel()
        endif
        return
      endif
    endif

  endif

  if !trunclamp then
    bran
    goto href
  endif

  -- Select ancillary
  if(!!kGetBoreUnits()) then
    UNITS INCH BORE
  endif

  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  --<wd>oct2004 -- Revert Back to 'mm bore' ONLY whilst in this function
  units mm bore
  --  !currentUnits = !!kgetsetunits()
  --<wd>oct2004

  !!mdsDacControl(true)
  --Navigate to Href of owne for all support types apart from these
  if !alias inset('LT10','LT11','LT12') then
    if match('AT72 AT73 AT87 AT93 AT94',!!ce.stype) eq 0 then
      goto href of owne
    endif
  endif
  -- <sk> 04/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsAT01.support.datum = !!ce
    -- Set distance gadget before changing orientation
    !!mdsDistance(!!mdsAT01)
    -- <sk> 21/06/2012 orientation problems
    -- reset orientation
    ori Y is N WRT $!!ce.owner and Z is U WRT $!!ce.owner
  else
    new atta $!where
  endif
  -- <sk> 04/06/2012
  spkbrk true

  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsAT01.support.replace
    !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT01, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    !!kRestoreUnits(!currentUnits)
    return

  elsehandle NONE
    ---------------------------------------------------------------------------------------------------
    --<wd>feb2006<mds12>
    --
    -- The element may exist in the specification but the project may not contain the size in the parameters file
    --      if undefined(!!mdspar$!alias[$!bore]) then
    --
    -- Set the MDS ATTA SPREF & Check the MDS DEFAULTS CATALOGUE DESPARS Data is OK
    units mm bore
    spref $!choice[1]
    !atta = !!ce
    !lbor = !atta.lbor.real().value()
    !mds12test = !!mdssetdespars(!atta)
    if (!mds12test.not()) then
      --
      --<wd>feb2006<mds12>
      ---------------------------------------------------------------------------------------------------
      !projStandard = !!mdsAT01.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <sk> 04/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsAT01, true)
        return
      endif
      delete atta
      !!mdsDacControl(FALSE)
      !!kRestoreUnits(!currentUnits)
      return

    endif

  endhandle

  --<kp>may2011
  -- check if AT185 support fits to supported valv
  if !alias.eq('AT185') then
    !valv = prev
    !length = !valv.apos.distance(!valv.lpos)
    !message = STRING()
    if !!ce.rpro.dimm.lt(!length) then
      !message = 'Valve picked is longer than support length. Do you wish to keep the support?'
    endif
    if !message.set() then
      if !!alert.confirm(!message).boolean().not() then
        delete ATTA
        !!mdsDacControl(FALSE)
        !!kRestoreUnits(!currentUnits)
        return
      endif
    endif
  endif

  ---------------------------------------------------------------------------------------------------
  --<wd>feb2006<mds12> This CODE has been REPLACED by the CODE at approx. line 290 above. i.e.
  --
  --  mm bore
  --  spref $!choice[1]
  --  !!mdssetdespars(!!ce)
  --
  --<wd>feb2006<mds12>
  ---------------------------------------------------------------------------------------------------

  !!mdsDacControl(true)

  -- CHECK various DATA values for the current MDS ATTA Ancillary
  -- Set up the PML Object and  variables
  !!ce = !atta

  ---------------------------------------------------------------------------------------------------
  --<wd>feb2006<mds12>
  --
  --  !check    = object MDSCHECKSTD()
  !attastype   = !atta.stype
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!attastype, !lbor)

  --Temporary Global Variable
  !!obja = !mdsattaobj
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT01, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj )
  !!ce   = !atta
  --
  --<wd>feb2006<mds12>
  ---------------------------------------------------------------------------------------------------

  -- Variables associated with the Object calls shown below
  !min      = STRING()
  !max      = STRING()
  !materror = STRING()

  -- Check the PIPE MATERIAL
  if (!check.material(!materror).not()) then
    !!alert.error (!materror)
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT01, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif

  -- Navigate to the New MDS ATTA
  !!ce = !atta
  -- Check PIPE INSULATION THICKNESS is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below
  if (!check.insu(!alias,!min,!max).not()) then
    !!mdsInsulationError(!currentUnits, !min, !max, !replace)
    !!mdsDacControl(FALSE)
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT01, true)
      return
    endif
    delete atta
    return
  endif

  -- Navigate to the New MDS ATTA
  !!ce = !atta
  -- Check BRANCH TEMPERATURE is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below
  !tmin = STRING()
  !tmax = STRING()
  if (!check.temp(!alias,!tmin,!tmax).not()) then
    var !temp temp of branch
    !!alert.message ('The TEMPERATURE of the identified pipe ($!temp) is not within the MINIMUM/MAXIMUM temperatures ($!tmin / $!tmax)')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT01, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif

  -- Navigate to the New MDS ATTA
  !!ce = !atta
  -- Test if the ANCILLARY is available at this ELEVATION
  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedelevation = !position.up

    ---------------------------------------------------------------------------------------------------
    --<wd>feb2006<mds12>
    --
    -- -->    !minimumelevation = !!mdspar$!alias[0].despars[1]
    -- ************
    -- *** NOTE ***
    -- ************
    -- The ELEVATION data is DETERMINED "live" during the creation of the DATA in the "mdsreadparsdata" PML object,
    -- which is stored in the current Object variable !mdsattaobj
    --
    !minimumelevation = !mdsattaobj.elevation
    --
    --<wd>feb2006<mds12>
    ---------------------------------------------------------------------------------------------------

    !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedelevation , Minimum elevation $!minimumelevation')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT01, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif

  -- <sk> 06/07/2012 Check user criteria
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT01, true)
      return
    endif
    delete atta
    return
  endif
  -- <sk> 06/07/2012

  -- Set the ATTA material
  !!mdssetmatref(!!ce)

  !!mdsDacControl(TRUE)

  if (!alias inset('AT10A','AT11A')) then
    despar n2 $!dp2
  endif

  !!mdsDacControl(true)
  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsAT01.support.type|

  !!mdsSetIspe()

  --  Add stex for isometrics
  -- set stex for atta
  !satta = !!ce

  !!mdsSelLstu(!!ce)

  -- If type is a AT98 then we need to add the tube material to the iso
  --<dw>oct2008 dun979 - Also to allow for additional tube material on shoe AT141

  !!mdsDacControl(TRUE)

  if (!alias inset('AT98','AT141')) then
    !!ce.mtoref[1] = !!ce.lstu
  endif

  if (!alias inset('AT10A','AT11A')) then
    fconn $!to and p5 is $!p5dir
    !p3dir = p3 dir wrt /*
    if ('$!p3dir' neq 'D WRT /*' and '$!p3dir' neq '-Z WRT /*') then
      flip ori
      fconn $!to and p5 is $!p5dir
    endif
  elseif (!alias inset('AT10B','AT11B')) then
    POS AT PL OF PREV
    handle any
      pos at ph
    endhandle
    ori and p3 is d
  elseif (!alias inset('LT01A','LT01B','LT01C')) then
    fconn to prev
    handle (7,35)
      pos at prev
      ori
    elsehandle any
      fconn
    endhandle
    -- Lugs must be above clamp therefore p5 must always be U
    if (!alias inset('LT01B','LT01C')) then
      !testori = p5 dir wrt /*
      if ('$!testori' neq |U WRT /*|) then
        flip ori
      endif
    endif
  elseif (!alias inset('LT13A','LT13B')) then
    POS AT PREV
    handle any
      pos at ph
    endhandle
    ori
    !testori = p5 dir wrt /*
    if ('$!testori' neq |D WRT /*|) then
      flip ori
    endif
  elseif (!alias inset('AT53A','AT53B')) then
    -- Get the length from the identified elements if the property exists
    prev
    if !identifiedStype.eq('AC45') then
      var !mem coll all dtse mem with (PURP eq 'DESP' and DKEY eq 'BRWB') for dtref of $!trunclampname
      var !numbers eval num for all from !mem
      !length = desp[$!numbers[1]] of $!trunclampname
    elseif !identifiedStype.eq('AC29') then
      var !mem coll all dtse mem with (PURP eq 'DESP' and DKEY eq 'BROD') for dtref of $!trunclampname
      var !numbers eval num for all from !mem
      !length = desp[$!numbers[1]] of $!trunclampname
      !length = !length / 2
      var !mem coll all dtse mem with (PURP eq 'DESP' and DKEY eq 'ODED') for dtref of $!trunclampname
      var !numbers eval num for all from !mem
      !lengthP = desp[$!numbers[1]] of $!trunclampname
      !length = !length + !lengthP
      var !mem coll all dtse mem with (PURP eq 'DESP' and DKEY eq 'CWID') for dtref of $!trunclampname
      var !numbers eval num for all from !mem
      !lengthP = desp[$!numbers[1]] of $!trunclampname
      !length = !length + !lengthP
      !length = !length * 2
    elseif !identifiedStype.eq('AC44') then
      var !mem coll all dtse mem with (PURP eq 'DESP' and DKEY eq 'BRWH') for dtref of $!trunclampname
      var !numbers eval num for all from !mem
      !length = desp[$!numbers[1]] of $!trunclampname
    elseif !identifiedStype.eq('AC53') then
      var !mem coll all dtse mem with (PURP eq 'DESP' and DKEY eq 'CLEN') for dtref of $!trunclampname
      var !numbers eval num for all from !mem
      !length = desp[$!numbers[1]] of $!trunclampname
    else
      var !mem coll all dtse mem with (PURP eq 'DESP' and DKEY eq 'LEN') for dtref
      var !numbers eval num for all from !mem
      !length = desp[$!numbers[1]]
    endif
    next
    desp n5 $!length
    conn
  elseif (!alias inset('LT10')) then
    conn $!to
    --Ppoint 1 must always point up
    if !!ce.pdir[1].string().match('U WRT').neq(1) and !!ce.pdir[1].string().match('Z WRT').neq(1) then
      flip ori conn
    endif
    Pos $!poslug
  elseif (!alias inset('LT11','LT12')) then
    conn $!to
    Desp Num 3 $!length
    Pos $!poslug
  elseif !alias.eq('AT185') then
    --<kp>may2011
    fconn
  else
    !!mdsDacControl(true)
    -- <sk> 04/06/2012
    -- do not modify POS and ORI in atta from preliminary
    if !fromAtta.not() then
      POS AT PREV
      handle any
        pos at ph
      endhandle
    endif
    ori
    if !alias inset('AT27') then
      -- Ppoint 10 must always point up
      if !!ce.pdir[10].string().match('U WRT').neq(1) and !!ce.pdir[10].string().match('Z WRT').neq(1) then
        flip ori
      endif
    endif
  endif
  call !!mdsTransport(!satta,!name)

  if (!alias inset('LT01A','LT01B','LT01C','AT61','AT63','AT64','AT65','AT116','AT117','AT118','AT119','AT120','AT121','AT122','AT123','AT124','AT125')) then
    !!mdsAT01.bedplate.active = false
  endif

  -- Always add atta to support object
  !!mdsAT01.support.atta.clear()
  !!mdsAT01.support.atta.append(!!ce)
  !!mdsAT01.support.datum  = !!ce
  !!mdsAT01.support.pADir  = Pa Dir wrt world
  !!mdsAT01.support.pLDir  = Pl Dir wrt world
  !!mdsAT01.support.p9Dir  = P9 Dir wrt world
  -- !!mdsAT01.support.p10dir = p10 dir wrt world
  -- !!mdsAT01.support.p11dir = p11 dir wrt world

  -- Add marker text
  !!mdsaidtext(!!mdsAT01)
  --VAR !pOS POS WRT WORLD
  --$M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.appendarray(!!mdsAT01.support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourlist)

  -- When finished grey out datum gadget and reset height,length and setsteel
  !!mdsSetGadgets(!!mdsAT01,!!ce,!!mdsAT01.support.type)
  !!mdsAT01.datum.active = false

  !!mdsDacControl(true)

  -- Need to set the insu thickness for AT26 and GT13
  if !!mdsAT01.support.type.eq('AT26') or !!mdsAT01.support.type.eq('GT13') or !!mdsAT01.support.type.match('AT25').gt(0) then
    var !insu insu
    var !dinsu coll all data with dkey eq 'INSU' for dtre
    var !num1 eval num for all from !dinsu
    despar n$!num1[1]  $!insu
  endif

  -- Special for AT21/AT22 is the requirement of setting the BLEN dkey to the width
  -- of the beam it is sitting on
  if !!mdsAT01.support.type.eq('AT21') or !!mdsAT01.support.type.eq('AT22') then
    -- Identify beam to bolt strap to
    prompt off
    prompt load escape 'Identify section to bolt guide to'
    --<wd>17jan2008 -- Defect No. P-4407
    --    ID SCTN @
    ID SCTN HSTIFF @
    --<wd>17jan2008 -- Defect No. P-4407
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentUnits)
      return false
    endhandle
    prompt on
    !flanThk = (prop FLG)
    same
    var !prop coll all data with dkey eq 'SSTH' for dtre
    var !num1 eval num for all from !prop
    despar n$!num1[1]  $!flanThk
  elseif !!mdsAT01.support.type.match('LT03').gt(0) or !!mdsAT01.support.type.match('LT04').gt(0) then
    -- P1 of this atta always has to be up if not flip ori it and set the :MDSPad uda for the type
    if !!ce.pdir[1].wrt(/* ).string().eq('D WRT /*') or !!ce.pdir[1].wrt(/* ).string().eq('-Z WRT /*') then
      flip ori
    endif
    !type = !!ce.styp.substring(5,5)
    :MdsPad '$!type'
  elseif !!mdsAT01.support.type.match('LT06').gt(0)then
    -- P1 of this atta always has to be up if not flip ori it and set the :MDSPad uda for the type
    if !!ce.pdir[1].wrt(/* ).string().eq('U WRT /*') or !!ce.pdir[1].wrt(/* ).string().eq('Z WRT /*') then
      flip ori
    endif
    !type = !!ce.styp.substring(5,5)
    :MdsPad '$!type'
    --elseif !!mdsAT01.support.type.match('AT61').gt(0)then
  elseif (!alias inset('AT61','AT116','AT117','AT118','AT119')) then
    -- P1 of this atta always has to be DOWN if not flip ori it and set the :MDSPad uda for the type
    if !!ce.pdir[1].wrt(/* ).string().eq('U WRT /*') or !!ce.pdir[1].wrt(/* ).string().eq('Z WRT /*') then
      flip ori
    endif
  elseif (!alias inset('AT120','AT121','AT122','AT123','AT124','AT125')) then
    -- P1 of this atta always has to be UP if not flip ori it and set the :MDSPad uda for the type
    if !!ce.pdir[1].wrt(/* ).string().eq('D WRT /*') or !!ce.pdir[1].wrt(/* ).string().eq('-Z WRT /*') then
      flip ori
    endif
    !type = !!ce.styp.substring(5,5)
    :MdsPad '$!type'

    --<wd>nov2003
    -- Set the MTOREF attribute of the DATUM Atta to the LSTU value
    !lstu          = !!ce.lstu
    !!ce.mtoref[1] = !lstu
    --<wd>nov2003
  elseif !!mdsAT01.support.type.matchwild('LT14*') then
    -- P1 of this atta always has to be DOWN if not flip ori it
    if !!ce.pdir[1].wrt(/* ).string().eq('U WRT /*') or !!ce.pdir[1].wrt(/* ).string().eq('Z WRT /*') then
      flip ori
    endif
  endif

  --<kp> Fix point support ST62
  if !alias inset('ST62') then
    !!mdsAT01.support.position = true

    --<kp>may2011
  elseif !alias inset('AT185') then
    !!mdsAT01.support.position = true
  endif
  -- Standards ST19, ST21, ST22 and ST23 require the automatic generation of LUGS
  !!ce = !satta
  !!mdsCreateLugs()

  -- Fix for HPD0026150 GE 24/09/04
  if(!alias inset('AT99')) then
    DESPAR N16 ( PL OD )
    handle ANY
    endhandle
  endif
  -- EOF

  -- Reset Units
  !!kRestoreUnits(!currentUnits)
  -- set focus to the distance text gadget
  !!mdsAT01.dist.setFocus()

  !!mdsDacControl(false)

  -- End function
endfunction
