--
--
-- Function for Shoe Type AT144-- Author: D.whiteside
-- Created: 20 November 2008 Clearcase DUN1052
-- Transferred: 16 March 2009 for MDS12.0SP5 DUN1119
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatAT144()

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kgetSetUnits()

  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !datum    = !!mdsAT144.support.datum
  !name     = !!mdsAT144.name.val
  !alias    = !!mdsAT144.support.alias
  !replace  = !!mdsAT144.support.replace
  !fromAtta = !!mdsAT144.support.preliminaryStore.set()

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif


  -- Select tube

  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif
  !idType = 'pipe'
  !purp = 'PIPE'

  if (!!mdsIdTube(!tubeType, 'Identify $!pipeType of $!idType',!purp).not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif
  var !unusedMode mode
  forwards
  !where = ''

  -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
  -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

  !currcomp = !!ce
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!hdir neq U and !hdir neq D ) then
    if (!!mdsgradient(!currcomp)) then
      !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
      !!ce = !cecomp
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        -- cancel autopicker and restore preliminary
        !!mdsAutoTubePicker.cancel()
      endif
      return
    endif
  endif


  -- Select ancillary
  if(!!kgetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif

  $!boreUnits
  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  --<wd>oct2004 -- Revert Back to 'mm bore' ONLY whilst in this function
  units mm bore
  --  !currentUnits = !!kgetSetUnits()
  --<wd>oct2004

  !!mdsDacControl(true)
  --Navigate to Href of owne for all support types apart from these
  -- <sk> 04/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsAT144.support.datum = !!ce
    -- Set distance gadget
    !!mdsDistance(!!mdsAT144)
  else
    new atta $!where
  endif
  -- <sk> 04/06/2012
  spkbrk true

  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsAT144.support.replace
    !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
    -- <sk> 04/06/2012
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT144, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  elsehandle none

    spref $!choice[1]
    !atta = !!ce
    !lbor = !atta.lbor.real().value()
    !mds12test = !!mdsSetDesPars(!!ce)

    -- The element may exist in the specification but the project may not contain the size in the parameters file
    --    if undefined(!!mdsPar$!alias[$!bore]) then
    if (!mds12test.not()) then
      !projStandard = !!mdsAT144.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <sk> 04/06/2012
      !!kRestoreUnits(!currentUnits)
      if !fromAtta then
        !!mdsRestorePre(!!mdsAT144, true)
        return
      endif
      delete atta
      !!mdsDacControl(FALSE)
      return
    endif
  endhandle
  units mm bore
  spref $!choice[1]

  !!mdsSetDesPars(!!ce)
  !!mdsDacControl(true)

  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below

  !check = object MDSCHECKSTD()
  !mdsattadefs = !check.mdsdefaults.mdsdefsdata(!atta.stype,!lbor)
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT144, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif

  !min = STRING()
  !max = STRING()
  !matError = STRING()
  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT144, true)
      return
    endif
    delete atta
    return
  endif

  if (!check.insu(!alias,!min,!max).not()) then
    var !insu insu
    if (!currentUnits.isImperialSavedDist().not()) then
      !units = 'mm'
    else
      !units = 'in'
    endif
    !!kformattext.text.val  = $!max$nmm
    !maxval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!min
    !minval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!insu
    !insval = !!kformattext.text.val.string(!!distancefmt)
    !!alert.message ('The INSULATION on the identified pipe ($!<insval>$!<units>) is not within the MIN ($!<minval>$!<units>) and MAX ($!<maxval>$!<units>) limits of the Insulation Thickness Values for the selected ancillary support type, i.e. $!replace')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT144, true)
      return
    endif
    delete atta
    return
  endif

  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below

  !tmin = STRING()
  !tmax = STRING()
  if (!check.temp(!alias,!tmin,!tmax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tmin / $!tmax)')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT144, true)
      return
    endif
    delete atta
    return
  endif

  -- Test if the ancillary is available at this elevation

  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedElevation = !position.up
    !minimumElevation = !!mdsPar$!alias[0].despars[1]
    !!alert.message ('The elevation selected is unsuitable for this ancillary. selected elevation $!selectedElevation Minimum elevation $!minimumElevation')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT144, true)
      return
    endif
    delete atta
    return
  endif

  -- <sk> 06/07/2012 Check user criteria
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT144, true)
      return
    endif
    delete atta
    return
  endif
  -- <sk> 06/07/2012

  -- Set the ATTA - UDA :MDSMatRef with the PROPCON Property, if it is declared in the dimensions default file
  !!mdssetmatref(!!ce)
  !!mdsDacControl(TRUE)

  !!mdsDacControl(true)
  -- Name support
  name /$!name
  :MDSSuppType |$!!mdsAT144.support.type|

  !satta = !!ce
  -- Find length,height,temp range of shoe
  !lendpnum  = !!mdsGetDesp('LEN')
  !lengshoe  = !satta.desp[$!lendpnum]
  !!mdsAT144.length.val = !lengshoe.value()
  !heidpnum  = !!mdsGetDesp('HEI')
  !heigshoe  = !satta.desp[$!heidpnum]
  !!mdsAT144.height.val = !heigshoe.value()
  !mintemp   = !!mdsGetDesp('MINT')
  !mindpnum  = !satta.desp[$!mintemp]
  !maxtemp   = !!mdsGetDesp('MAXT')
  !maxdpnum  = !satta.desp[$!maxtemp]
  !!mdsAT144.rangtemp.active = true
  !!mdsAT144.notetemp.val    = 'Min. $!mindpnum  Max. $!maxdpnum'

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)

  -- If type is a AT98 then we need to add the tube material to the iso
  --<dw>sep2008 dun1028 - Also to allow for additional tube material on shoe AT141

  !!mdsDacControl(TRUE)

  if !alias inset('AT98','AT141') then
    !!ce.mtoref[1] = !!ce.lstu
  endif

  !!mdsDacControl(true)
  -- <sk> 04/06/2012
  -- do not modify POS and ORI in atta from preliminary
  if !fromAtta.not() then
    POS AT PREV
    handle any
      pos at ph
    endhandle
    ori
  endif

  call !!mdsTransport(!satta,!name)

  -- Always add atta to support object
  !!mdsAT144.support.atta.clear()
  !!mdsAT144.support.atta.append(!!ce)
  !!mdsAT144.support.datum  = !!ce
  !!mdsAT144.support.paDir  = Pa Dir wrt world
  !!mdsAT144.support.plDir  = Pl Dir wrt world
  !!mdsAT144.support.p9Dir  = P9 Dir wrt world

  -- Add marker text
  !!mdsaidtext(!!mdsAT144)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsAT144.support.atta)

  -- Colour Support
  call !!kenhanceList(!colourList)

  -- When finished grey out datum gadget and reset height,length & gussets
  !!mdsSetGadgets(!!mdsAT144,!!ce,!!mdsAT144.support.type)
  !!mdsAT144.datum.active = false
  if !alias inset('AT144','AT146','AT147','AT148','AT150','AT151') then
    --   !parVar     = '!!mdsPar' & !satta.styp
    !abore      = !satta.abor
    !gussdpthk  = !!mdsGetDesp('STHK')
    --   !gussetthk  = $!parVar[$!abore].despars[$!gussdpthk].real()

    --<dw>mar2009 dun1119 - Object applied to extract design parameter
    !mdsattaobj = object MDSREADPARSDATA()
    !mdsattadefs = !mdsattaobj.mdsdefsdata(!satta.stype,!abore.real().value())
    !gussetthk  = !mdsattaobj.despars[$!gussdpthk].real()

    if (!gussetthk gt 0) then
      !!mdsAT144.rpad.active  = true
    endif
  endif

  !!mdsDacControl(true)

  -- Reset Units
  !!kRestoreUnits(!currentUnits)
  -- set focus to the distance text gadget
  !!mdsAT144.dist.setFocus()

  !!mdsDacControl(false)

endfunction
