--
-- File:  Mdssetdatat29.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
--

-- Description:
-- Creation function for general ancillary at29
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatat29()

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !datum    = !!mdsAT29.support.datum
  !name     = !!mdsAT29.name.val
  !alias    = !!mdsAT29.support.alias
  !!mdsAT29.bedplate.active = false
  --<sk> 19/06/2012
  !fromAtta = !!mdsAT29.support.preliminaryStore.set()
  !replace  = !!mdsAT29.support.replace

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  !purp = 'PIPE'

  label /again

  if (!!mdsIdTube(!tubeType, 'Identify trunnion',!purp).not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  bran
  handle any
    --<sk> prevent loop
    if (!fromAtta) then
      !!alert.error('The Identified preliminary support is not at a trunnion. Aborting creation')
      !!kRestoreUnits(!currentUnits)
      -- no changes apart name made so no need to restore
      !!mdsAutoTubePicker.cancel()
      return
    endif
    !!alert.error('The Identified preliminary support is not at a trunnion. Select another')
    golabel /again
  elsehandle none
    if !!ce.:MdsTrun.not() then
      --<sk> prevent loop
      if (!fromAtta) then
        !!alert.error('The Identified element is not a trunnion standard. Aborting creation')
        !!kRestoreUnits(!currentUnits)
        -- no changes apart name made so no need to restore
        !!mdsAutoTubePicker.cancel()
        return
      endif
      !!alert.error('The Identified element is not a trunnion standard. Select another')
      golabel /again
    endif
  endhandle

  -- <sk> 18/06/2012
  if !fromAtta then
    -- expected preliminary auto-identified by mdsIdTube
    !pre = object DBREF('/' & !name & '_Pre')
    handle any
    elsehandle none
      -- check if preliminary support is at the start of branch (ce is branch)
      if (!pre.sequ.neq(1) and !pre.owner.hpos.near(!pre.ppos,0)) then
        -- reorder to first at branch level
        $!pre.owner
        REORDER $!pre BEFORE 1
        handle any
        endhandle
      endif
      -- cannot reorder or reorder failed
      if (!pre.sequ.neq(1)) then
        !!kRestoreUnits(!currentUnits)
        !!alert.error('Preliminary support for this ancillary must be the first element of branch!  Aborting creation')
        !!mdsRestorePre(!!mdsAT29, true)
        return
      endif
    endhandle
  endif
  -- <sk> 18/06/2012

  -- What type of element is the branch connected to

  !connectedType = !!ce.href.type

  -- If the connected type is a redu then abort as common practice is not to

  if !connectedType.eq('REDU') then
    !!kRestoreUnits(!currentUnits)
    !!alert.error('Cannot weld a repad to a reducer! Aborting creation')
    return
  elseif !connectedType.eq('CROS') then
    !!kRestoreUnits(!currentUnits)
    !!alert.error('Cannot weld a repad to a cros! Aborting creation')
    return
  endif

  --var !mode mode
  forwards

  -- Select ancillary
  if(!!kGetBoreUnits()) then
    UNITS INCH BORE
  endif

  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  -- Find out the element type the branch head is connected to, this will determine the type
  -- of reinforcing plate to create

  bran
  !connectedType = !!ce.href.type
  !connectedRef  = !!ce.href.ref
  var !connectedDir dir p2 of href wrt /*
  ---------------------------------------------------------------------------------------------------------------
  -- mjb >>> 13.04.06 <mds12> AT29A and AT29B are separate STYP at <mds12>
  --if !connectedType.eq('ELBO') then
  --  !stypCode = 'B'
  --else
  --  !stypCode = 'A'
  --endif
  -- mjb <<< end of mod
  ---------------------------------------------------------------------------------------------------------------
  -- Make sure we create the atta first by losing the current position

  bran
  pipe
  same

  !currentUnits = !!kGetSetUnits()

  -- <sk> 18/06/2012
  if (!fromAtta and defined(!pre)) then
    !!ce = !pre
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsAT29.support.datum = !!ce
  else
    new atta
  endif
  -- <sk> 18/06/2012
  spkbrk true

  !styp = !!mdsAT29.support.type
  ---------------------------------------------------------------------------------------------------------------
  -- mjb >>> 13.04.06 <mds12> AT29A and AT29B are separate STYP at <mds12>
  if (!styp.eq('AT29A') AND !connectedType.eq('ELBO')) then
    -- <sk> 04/06/2012 messages added + preliminary support handling
    !!alert.error('Cannot create an ' & !styp & ' on a trunnion on an elbow')
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT29, true)
      return
    endif
    delete atta
    return
  elseif (!styp.eq('AT29B') AND !connectedType.neq('ELBO')) then
    -- <sk> 18/06/2012 messages added + preliminary support handling
    !!alert.error('Must be a trunnion on an elbow for a ' & !styp)
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT29, true)
      return
    endif
    delete atta
    return
  endif

  --!choice = SELECT SPEC /MDS WITH STYP '$!styp$!stypCode'
  -- mjb <<< end of mod
  ---------------------------------------------------------------------------------------------------------------

  !choice = SELECT SPEC /MDS WITH STYP '$!styp'
  handle ANY
    !projStandard = !!mdsAT29.support.replace
    !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 18/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT29, true)
      return
    endif
    delete atta
    return
  elsehandle NONE

    ---------------------------------------------------------------------------------------------------------------
    -- mjb >>> 13.04.06 <mds12>
    -- The element may exist in the specification but the project may not contain the size in the parameters file

    -- Set the MDS ATTA SPREF & Check the MDS DEFAULTS CATALOGUE DESPARS Data is OK
    units mm bore
    spref $!choice[1]
    !atta = !!ce
    !lbor = !atta.lbor.real().value()
    !mds12test = !!mdsSetDespars(!atta)
    if (!mds12test.not()) then
      --if undefined(!!mdsPar$!styp$!stypCode[$!bore]) then

      -- mjb <<< end of mod
      ---------------------------------------------------------------------------------------------------------------
      !projStandard = !!mdsAT29.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      !!kRestoreUnits(!currentUnits)
      -- <sk> 18/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsAT29, true)
        return
      endif
      delete atta
      return
    endif
  endhandle

  ---------------------------------------------------------------------------------------------------------------
  -- mjb >>> 13.04.06 <mds12>
  --mm bore
  --spref $!choice[1]

  --!!mdsSetDespars(!!ce)
  -- mjb <<< end of mod
  ---------------------------------------------------------------------------------------------------------------

  ---------------------------------------------------------------------------------------------------------------
  -- mjb >>> 13.04.06 <mds12>
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!atta.stype,!lbor)
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentUnits)
    -- <sk> 18/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT29, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)
  --!check = object MDSCHECKSTD()
  -- mjb <<< end of mod
  ---------------------------------------------------------------------------------------------------------------
  !matError = STRING()
  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentUnits)
    -- <sk> 18/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT29, true)
      return
    endif
    delete atta
    return
  endif

  -- This type of reinforcing plate requires design parameters 2 and 3 to be set
  -- 2 will be the branch OD
  -- 3 will be the leg length of the elbo
  !save = !!ce
  bran
  !branSuppName = !!mdsGetSuppName(!!ce)
  $!branSuppName/SREF
  if !!ce.styp.eq('TT06') or !!ce.styp.eq('TT07') then
    $!branSuppName/MAKEUP
    var !dp2 pl od
  else
    bran
    var !dp2 pt od
  endif
  var !dp3 const dist p0 of $!connectedRef to p1 of $!connectedRef
  !!ce = !save
  !!mdsDacControl(true)
  despar n2 $!dp2
  despar n3 $!dp3
  !!mdsDacControl(false)


  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below
  ---------------------------------------------------------------------------------------------------------------
  -- mjb >>> 13.04.06 <mds12> !check already set previously (line 211 approx.)
  --!check = object MDSCHECKSTD()
  -- mjb <<< end of mod
  ---------------------------------------------------------------------------------------------------------------
  !min = STRING()
  !max = STRING()
  !matError = STRING()

  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentUnits)
    -- <sk> 18/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT29, true)
      return
    endif
    !!mdsDacControl(true)
    delete atta
    !!mdsDacControl(false)
    return
  endif

  if (!check.insu(!alias,!min,!max).not()) then
    var !insu insu
    if (!currentUnits.isImperialSavedUnits()) then
      !units = 'mm'
    else
      !units = 'in'
    endif
    !!kformattext.text.val  = $!max
    !maxval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!min
    !minval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!insu
    !insval = !!kformattext.text.val.string(!!distancefmt)
    !!alert.message ('The INSULATION on the identified pipe ($!<insval>$!<units>) is not within the MIN ($!<minval>$!<units>) and MAX ($!<maxval>$!<units>) limits of the Insulation Thickness Values for the selected ancillary support type, i.e. $!replace')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 18/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT29, true)
      return
    endif
    !!mdsDacControl(true)
    delete atta
    !!mdsDacControl(false)
    return
  endif

  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below

  !tmin = STRING()
  !tmax = STRING()
  if (!check.temp(!alias,!tmin,!tmax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tmin / $!tmax)')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 18/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT29, true)
      return
    endif
    delete atta
    return
  endif

  -- Test if the ancillary is available at this elevation

  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedElevation = !position.up
    ------------------------------------------------------------------------------
    -- mjb >>> 12.04.06 <mds12>
    !minimumElevation = !mdsattaobj.elevation
    --!minimumElevation = !!mdsPar$!alias[0].despars[1]
    -- mjb <<< end of mod
    ------------------------------------------------------------------------------
    !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedElevation Minimum elevation $!minimumElevation')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 18/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT29, true)
      return
    endif
    delete atta
    return
  endif

  -- <sk> 06/07/2012 Check user criteria
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT29, true)
      return
    endif
    delete atta
    return
  endif
  -- <sk> 06/07/2012

  -- Set the ATTA material
  !!mdssetmatref(!!ce)

  !!mdsDacControl(TRUE)

  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsAT29.support.type|

  !!mdsSetIspe()

  --  Add stex for isometrics
  -- set stex for atta
  !sAtta = !!ce
  Call !!mdsTransport(!sAtta,!name)

  !!mdsSelLstu(!!ce)

  -- Connect the plate to the branch head

  !!mdsDacControl(true)
  conn and p3 is $!connectedDir wrt /*

  -- Extra material is required for the reinforcing pad depending on the branch href type

  !ce = !!ce
  !!ce = !connectedRef
  if !connectedType.eq('ELBO') then
    !spref = !!ce.spref
    /$!name
    if (!!ce.owner.pspec.purp neq 'TRUN' ) then
      Mtor $!spref
    endif
  else
    !spref = !!ce.lstu
    /$!name
    Mtor $!spref
  endif
  !!ce = !ce

  -- Always add atta to support object
  !!mdsAT29.support.atta.clear()
  !!mdsAT29.support.atta.append(!!ce)
  !!mdsAT29.support.datum  = !!ce
  !!mdsAT29.support.pADir  = Pa Dir wrt world
  !!mdsAT29.support.pLDir  = Pl Dir wrt world
  -- !!mdsAT29.support.p9Dir  = P9 Dir wrt world
  -- !!mdsAT29.support.p10Dir = P10 Dir wrt world
  -- !!mdsAT29.support.p11Dir = P11 Dir wrt world

  -- Active the modify icon
  !!mdsAT29.modAtta.active = true
  !!mdsAT29.viewStd.active = true
  !!mdsAT29.zoom.active = true
  !!mdsAT29.ancMat.active = true

  -- Add marker text
  !!mdsaidtext(!!mdsAT29)
  --VAR !pOS POS WRT WORLD
  --$M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsAT29.support.atta)

  -- Colour Support
  Call !!kEnhanceList(!colourList)

  -- When finished grey out datum gadget and reset height,length and setsteel
  !!mdsSetGadgets(!!mdsAT29,!!ce,!!mdsAT29.support.type)
  !!mdsAT29.datum.active = false
  !!mdsAT29.oK.active = true

  -- Need to set the insu thickness for AT26 and GT13

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- set focus to the distance text gadget
  !!mdsAT29.dist.setFocus()

  !!mdsDacControl(false)

  !!ce = !cecomp

endfunction
