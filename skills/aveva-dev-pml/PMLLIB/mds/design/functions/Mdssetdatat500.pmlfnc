--
-- File:    Mdssetdatat500.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.morris
-- Created:   Tue Oct 28
--
--
--

-- Description:
-- Creation function for general ancillary at500
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatat500()

  -- Find current units and set the distance unit to metric

  !currentunits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !datum    = !!mdsat500.support.datum
  !name     = !!mdsat500.name.val
  !alias    = !!mdsat500.support.alias
  !!mdsat500.bedplate.active = true
  !replace  = !!mdsat500.support.replace
  !cecomp = !!ce
  !fromAtta = !!mdsat500.support.preliminaryStore.set()

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif
  !iDType = 'pipe'
  !purp = 'PIPE'

  label /again

  if (!!mdsIdTube(!tubeType, 'Identify $!pipeType of $!iDType',!purp).not())then
    !!kRestoreUnits(!currentunits)
    return
  endif

  forwards
  !where = ''

  !currcomp = !!ce
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!hdir neq U and !hdir neq D ) then
    if (!!mdsgradient(!currcomp)) then
      !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
      !!ce = !cecomp
      !!kRestoreUnits(!currentunits)
      if (!fromAtta) then
        -- cancel autopicker and restore preliminary
        !!mdsAutoTubePicker.cancel()
      endif
      return
    endif
  endif

  -- Select ancillary
  if(!!kGetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif

  $!boreUnits
  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  --<wd>oct2004 -- Revert Back to 'mm bore' ONLY whilst in this function
  units mm bore
  --  !currentunits = !!kGetSetUnits()
  --<wd>oct2004

  !!mdsDacControl(true)
  --Navigate to Href of owne for all support types apart from these
  -- <sk> 04/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsat500.support.datum = !!ce
    -- Set distance gadget
    !!mdsDistance(!!mdsat500)
  else
    new atta $!where
  endif
  -- <sk> 04/06/2012
  spkbrk true

  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsat500.support.replace
    !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsat500, true)
      return
    endif
    delete atta
    -- <sk>
    !!mdsDacControl(FALSE)
    !!kRestoreUnits(!currentunits)
    return
  elsehandle NONE
    -- Set the MDS ATTA SPREF & Check the MDS DEFAULTS CATALOGUE DESPARS Data is OK
    units mm bore
    spref $!choice[1]
    !atta = !!ce
    !lbor = !atta.lbor.real().value()
    !mds12test = !!mdssetdespars(!atta)
    if (!mds12test.not()) then
      !projStandard = !!mdsat500.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <sk> 04/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsat500, true)
        return
      endif
      delete atta
      !!mdsDacControl(FALSE)
      !!kRestoreUnits(!currentunits)
      return
    endif

  endhandle

  !!mdsDacControl(true)

  -- CHECK various DATA values for the current MDS ATTA Ancillary
  -- Set up the PML Object and  variables
  !!ce = !atta

  !attastype   = !atta.stype
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!attastype, !lbor)

  --Temporary Global Variable
  !!obja = !mdsattaobj
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentunits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsat500, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj )
  !!ce   = !atta

  -- Variables associated with the Object calls shown below
  !min      = STRING()
  !max      = STRING()
  !materror = STRING()

  -- Check the PIPE MATERIAL
  if (!check.material(!materror).not()) then
    !!alert.error (!materror)
    !!kRestoreUnits(!currentunits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsat500, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif

  -- Navigate to the New MDS ATTA
  !!ce = !atta
  -- Check PIPE INSULATION THICKNESS is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below
  if (!check.insu(!alias,!min,!max).not()) then
    !!mdsInsulationError(!currentunits, !min, !max, !replace)
    !!mdsDacControl(FALSE)
    !!kRestoreUnits(!currentunits)
    delete atta
    return
  endif

  -- Navigate to the New MDS ATTA
  !!ce = !atta
  -- Check BRANCH TEMPERATURE is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below
  !tmin = STRING()
  !tmax = STRING()
  if (!check.temp(!alias,!tmin,!tmax).not()) then
    var !temp temp of branch
    !!alert.message ('The TEMPERATURE of the identified pipe ($!temp) is not within the MINIMUM/MAXIMUM temperatures ($!tmin / $!tmax)')
    !!kRestoreUnits(!currentunits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsat500, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif

  -- Navigate to the New MDS ATTA
  !!ce = !atta
  -- Test if the ANCILLARY is available at this ELEVATION
  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedElevation = !position.up

    -- The ELEVATION data is DETERMINED "live" during the creation of the DATA in the "mdsreadparsdata" PML object,
    -- which is stored in the current Object variable !mdsattaobj
    !minimumElevation = !mdsattaobj.elevation
    ---------------------------------------------------------------------------------------------------

    !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedElevation , Minimum elevation $!minimumElevation')
    !!kRestoreUnits(!currentunits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsat500, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif

-- <sk> 04/07/2012 Check user criteria
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentunits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsat500, true)
      return
    endif
    delete atta
    return
  endif
-- <sk> 04/07/2012

  -- Set the ATTA material
  !!mdssetmatref(!!ce)

  !!mdsDacControl(TRUE)

  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsat500.support.type|

  !!mdsSetIspe()

  --  Add stex for isometrics
  -- set stex for atta
  !sAtta = !!ce

  !!mdsSelLstu(!!ce)

  -- If type is a AT98 then we need to add the tube material to the iso

  !!mdsDacControl(TRUE)
  -- <sk> 04/06/2012
  -- do not modify POS and ORI in atta from preliminary
  if !fromAtta.not() then
    POS AT PREV
    handle any
      pos at ph
    endhandle
    ori
  endif
  call !!mdsTransport(!sAtta,!name)


  -- Always add atta to support object
  !!mdsat500.support.atta.clear()
  !!mdsat500.support.atta.append(!!ce)
  !!mdsat500.support.datum  = !!ce
  !!mdsat500.support.pADir  = Pa Dir wrt world
  !!mdsat500.support.pLDir  = Pl Dir wrt world
  !!mdsat500.support.p9Dir  = P9 Dir wrt world

  -- Add marker text
  !!mdsaidtext(!!mdsat500)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsat500.support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- When finished grey out datum gadget and reset height,length and setsteel
  !!mdsSetGadgets(!!mdsat500,!!ce,!!mdsat500.support.type)
  !!mdsat500.datum.active = false

  !!mdsDacControl(true)

  -- Reset Units
  !!kRestoreUnits(!currentunits)
  -- set focus to the distance text gadget
  !!mdsat500.dist.setFocus()
  !!mdsDacControl(false)

  -- End function
endfunction
