--
-- Author:    N.morris
-- Created:   Tue Oct 28
--
--
--

-- Description:
-- Creation function for general ancillary AT62
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatAT62()

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !datum    = !!mdsAT62.support.datum
  !name     = !!mdsAT62.name.val
  !alias    = !!mdsAT62.support.alias
  !!mdsAT62.bedplate.active = true
  !fromAtta = !!mdsAT62.support.preliminaryStore.set()
  !replace  = !!mdsAT62.support.replace

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif
  !!mdsAT62.bedplate.active = false

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif
  !iDType = 'pipe'
  !purp = 'PIPE'

  label /again

  if (!!mdsIdTube(!tubeType, 'Identify $!pipeType of $!iDType',!purp).not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif
  --var !mode mode
  forwards
  !where = ''

  -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
  -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

  !currcomp = !!ce
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!hdir neq U and !hdir neq D ) then
    if (!!mdsgradient(!currcomp)) then
      !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
      !!ce = !cecomp
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        -- no changes apart from name made so no need to restore
        !!mdsAutoTubePicker.cancel()
      endif
      return
    endif
  endif


  -- Select ancillary
  if(!!kGetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif

  $!boreUnits
  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  !currentUnits = !!kGetSetUnits()

  -- <sk> 04/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsAT62.support.datum = !!ce
    -- Set distance gadget
    !!mdsDistance(!!mdsAT62)
  else
    new atta $!where
  endif
  -- <sk> 04/06/2012

  spkbrk true
  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsAT62.support.replace
    !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT62, true)
      return
    endif
    delete atta
    return
  elsehandle none
    -- The element may exist in the specification but the project may not contain the size in the parameters file
    ------------------------------------------------------------------------------
    -- mjb >>> 25.04.06 <mds12>

    --if undefined(!!mdsPar$!alias[$!bore]) then

    units mm bore
    spref $!choice[1]

    !atta = !!ce
    !lbor = !atta.lbor.real().value()
    !mds12test = !!mdsSetDesPars(!atta)

    if (!mds12test.not()) then
      !projStandard = !!mdsAT62.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <sk> 04/06/2012
      !!kRestoreUnits(!currentUnits)
      if !fromAtta then
        !!mdsRestorePre(!!mdsAT62, true)
        return
      endif
      delete atta
      return
    endif
  endhandle

  --mm bore
  --spref $!choice[1]

  --!!mdsSetDesPars(!!ce)

  !!mdsDacControl(true)

  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!atta.stype,!lbor)
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT62, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif

  !check = object MDSCHECKSTD(!mdsattaobj)

  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below
  --!check = object MDSCHECKSTD()

  -- mjb 25.04.06 <<< end of mod
  ------------------------------------------------------------------------------

  !min = STRING()
  !max = STRING()
  !matError = STRING()

  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT62, true)
      return
    endif
    delete atta
    return
  endif

  if (!check.insu(!alias,!min,!max).not()) then
    !!mdsInsulationError(!currentUnits, !min, !max, !replace)
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT62, true)
      return
    endif
    delete atta
    return
  endif

  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below

  !tmin = STRING()
  !tmax = STRING()
  if (!check.temp(!alias,!tmin,!tmax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tmin / $!tmax)')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT62, true)
      return
    endif
    delete atta
    return
  endif

  -- Test if the ancillary is available at this elevation

  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedElevation = !position.up
    ------------------------------------------------------------------------------
    -- mjb >>> 25.04.06 <mds12>
    --!minimumElevation = !!mdsPar$!alias[0].despars[1]
    !minimumElevation = !mdsattaobj.elevation
    -- mjb <<< 25.04.06 end of mod
    ------------------------------------------------------------------------------
    !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedElevation Minimum elevation $!minimumElevation')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT62, true)
      return
    endif
    delete atta
    return
  endif
  -- <sk> 06/07/2012 Check user criteria
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT62, true)
      return
    endif
    delete atta
    return
  endif
  -- <sk> 06/07/2012

  -- Set the ATTA material
  !!mdssetmatref(!!ce)

  !!mdsDacControl(true)
  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsAT62.support.type|

  !!mdsSetIspe()

  --  Add stex for isometrics
  -- set stex for atta
  !sAtta = !!ce

  !!mdsSelLstu(!!ce)

  !!mdsDacControl(true)

  -- <sk> 04/06/2012
  -- do not modify POS and ORI in atta from preliminary
  if !fromAtta.not() then
    POS AT PREV
    handle any
      pos at ph
    endhandle
    ori
    if !alias inset('AT27') then
      -- Ppoint 10 must always point up
      if !!ce.pdir[10].string().match('U WRT').neq(1) and !!ce.pdir[10].string().match('Z WRT').neq(1) then
        flip ori
      endif
    endif
  endif
  call !!mdsTransport(!sAtta,!name)

  -- Always add atta to support object
  !!mdsAT62.support.atta.clear()
  !!mdsAT62.support.atta.append(!!ce)
  !!mdsAT62.support.datum  = !!ce
  !!mdsAT62.support.pADir  = Pa Dir wrt world
  !!mdsAT62.support.pLDir  = Pl Dir wrt world
  !!mdsAT62.support.p9Dir  = P9 Dir wrt world
  -- !!mdsAT62.support.p10Dir = P10 Dir wrt world
  -- !!mdsAT62.support.p11Dir = P11 Dir wrt world

  -- Add marker text
  !!mdsaidtext(!!mdsAT62)
  --VAR !pOS POS WRT WORLD
  --$M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsAT62.support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- When finished grey out datum gadget and reset height,length and setsteel
  !!mdsSetGadgets(!!mdsAT62,!!ce,!!mdsAT62.support.type)
  !!mdsAT62.datum.active = false

  !!mdsDacControl(true)

  -- Need to set the insu thickness for AT26 and GT13

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- set focus to the distance text gadget
  !!mdsAT62.dist.setFocus()

  !!mdsDacControl(false)

endfunction
