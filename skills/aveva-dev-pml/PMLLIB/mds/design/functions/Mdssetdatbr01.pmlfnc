--
-- File: Mdssetdatbr01.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.morris
-- Created:   Tue Oct 28
--
-- Revision:
--
-- Description:
-- Creation function for general ancillary Br01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatBr01()

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kgetSetUnits()

  -- Initialise variables

  !tubeType = !!mdsOptions.pipes
  !datum    = !!mdsBr01.support.datum
  !name     = !!mdsBr01.name.val
  !alias    = !!mdsBr01.support.alias
  !form     = !!mdsBr01
  !fromAtta    = !form.support.preliminaryStore.set()

  !unusedreplace  = !!mdsBr01.support.replace

  !unusedcecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  !unusedidType = 'pipe'
  !pipeType = 'tube'
  !purp = 'PIPE'

  label /again

  if (!!mdsIdTube(!tubeType, 'Identify Header $!pipeType ',!purp).not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif
  -- Must be a tee

  if !!ce.type.neq('TEE') and !!ce.type.neq('OLET') and !!ce.type.neq('REDU') then
    !!alert.error('Identified element must be a tee,olet or redu, unable to continue')
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary
      !!mdsAutoTubePicker.cancel()
    endif
    return
  endif

  var !unusedmode mode
  forwards
  !where = ''
  !unusedto = ''

  !currcomp = !!ce


  -- check if the tee is connected and what direction the branch is going in
  if !!ce.cend.unset() then
    !!alert.error('Identified is not Connected to a Branch, Unable to Continue')
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary
      !!mdsAutoTubePicker.cancel()
    endif
    return
  elseif !!ce.cend.eq('HEAD') then
    !forw = true
  else
    !forw = false
  endif

  !p3dir = !!ce.pdir[3]
  !plDir1 = pl dir
  !plod1 = pl od

  if (!fromAtta) then
    -- turn off autopicker
    !!mdsAutoTubePicker.disable()
  endif

  if (!!mdsIdTube(!tubeType, 'Identify Second Branch $!pipeType ',!purp).not())then
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary
      !!mdsAutoTubePicker.cancel()
    endif
    return
  endif

  -- Cannot identify a branch as there must be a change of direction in the branch

  if !!ce.type.eq('BRAN') then
    !!alert.error('Identified element cannot be a branch as there must be a change in direction')
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary
      !!mdsAutoTubePicker.cancel()
    endif
    return
  endif

  -- Is the identified branch connected to the identified tee

  if !!ce.owner.href.neq(!currcomp) and !!ce.owner.tref.neq(!currcomp) then
    !!alert.error('identified element is not connected to the identified tee')
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary
      !!mdsAutoTubePicker.cancel()
    endif
    return
  endif


  -- get the direction for orientation purposes
  !legcomp = !!ce
  if !forw then
    !matchdir = !!ce.ldir
  else
    !matchdir = !!ce.adir
  endif
  !lea = lea
  !legcompdir = pl dir
  -- get offset of second branch
  if !currcomp.type.eq('REDU') then
    !desp3 = abs(!currcomp.ppos[2].up - !!ce.position.up)
  else
    !desp3 = abs(!currcomp.position.up - !!ce.position.up)
  endif

  !desp4 = !desp3
  !desp6 = !!ce.aod

  -- Select ancillary
  if(!!kgetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif

  !plDir2 = pl dir

  !!ce = !currcomp
  $!boreUnits
  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  !!mdsDacControl(true)

  -- <ak> 19/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsBr01.support.datum = !!ce
  else
    new atta $!where
  endif
  -- </ak> 19/06/2012

  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsBr01.support.replace
    !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
    -- <ak> 13/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsBr01, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    !!kRestoreUnits(!currentUnits)
    return
  elsehandle NONE
    ------------------------------------------------------------------------------
    -- mjb >>> 11.04.06 <mds12>
    -- The element may exist in the specification but the project may not contain the size in the parameters file
    spkbrk TRUE
    units mm bore
    spref $!choice[1]
    sel lstu
    handle ANY
    endhandle
    !lbor = !!ce.lbor.real().value()
    !mds12test = !!mdsSetDesPars(!!ce)
    if (!mds12test.not()) then
      --if undefined(!!mdspar$!alias[$!bore]) then
      -- mjb <<< end of mod
      ------------------------------------------------------------------------------
      !projStandard = !!mdsBr01.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <ak> 13/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsBr01, true)
        return
      endif
      delete atta
      !!mdsDacControl(false)
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endhandle
  ------------------------------------------------------------------------------
  -- mjb >>> 11.04.06 <mds12>
  --spkbrk TRUE
  --mm bore
  --spref $!choice[1]
  --sel lstu
  --  handle ANY
  --  endhandle

  --!!mdsSetDesPars(!!ce)

  -- mjb <<< end of mod
  ------------------------------------------------------------------------------
  !!mdsDacControl(true)
  despar n3 $!desp3
  despar n4 $!desp4
  despar n6 $!desp6
  -- Design parameter will be the angle from the main pipe to the branch, this can only be 0 or 90
  -- depentant on if the branch is perpendicular or parallel
  !angle = !plDir1.angle(!plDir2)
  if !angle.geq(40) and !angle.leq(95) then
    !angle = 0
  else
    !angle = 90
    -- If the angle is 90 we need to work out a new angle from the od of the pipe which is despar 5
    !newAngle = (atan(!desp3 / (!plod1 / 2)))
    despar n5 $!newAngle
  endif
  despar n7 $!angle
  --<dw>aug2008 dun979-repad addition default settings
  despar n12 A
  !!mdsBr01.rpad.active = true
  --<dw>aug2008 dun979-end of repad addition settings

  !!mdsDacControl(true)

  ------------------------------------------------------------------------------
  -- mjb >>> 11.04.06 <mds12>
  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!!ce.stype,!lbor)
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 13/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsBr01, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)
  --!check = object MDSCHECKSTD()
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------

  !unusedmin      = STRING()
  !unusedmax      = STRING()
  !matError = STRING()

  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 13/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsBr01, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  endif
  !!mdsDacControl(TRUE)

  conn and p3 is $!p3dir
  handle any
    conn
  endhandle
  -- Need to check if the atta is pointing in the right direction

  -- Parallel Branch

  if !angle.eq(90) then
    -- Check if the p1 direction without any z component is the same if so flip conn
    !p1DirNoZ = !legcompdir
    !p1DirNoZ.up = 0
    !p15DirNoZ = !!ce.pdir[15]
    !p15DirNoZ.up = 0
    if !forw then
      if !lea.eq(2) then
        if !p1DirNoZ.string().before('WRT').eq(!p15DirNoZ.string().before('WRT')) then
          flip conn
        endif
      else
        if !p1DirNoZ.string().before('WRT').neq(!p15DirNoZ.string().before('WRT')) then
          flip conn
        endif
      endif
    else
      if !lea.eq(1) then
        if !p1DirNoZ.string().before('WRT').eq(!p15DirNoZ.string().before('WRT')) then
          flip conn
        endif
      else
        if !p1DirNoZ.string().before('WRT').eq(!p15DirNoZ.string().before('WRT')) then
          flip conn
        endif
      endif
    endif
    -- Perpendicular Branch
  elseif !angle.eq(0) then
    conn and p10 is pl of $!legcomp
    -- Check to see if the p3 is higher than the p0 if so flip it
    -- Leg is higher that header
    if !legcomp.ppos[0].up.gt(!!ce.ppos[0].up) then
      if !!ce.ppos[3].up.lt(!!ce.ppos[0].up) then
        flip conn and p10 is pl of $!legcomp
      endif
    else
      -- Leg is lower
      if !!ce.ppos[3].up.gt(!!ce.ppos[0].up) then
        flip conn and p10 is pl of $!legcomp
      endif
    endif
  endif

  -- if !forw.not() then
  --flip conn
  --endif

  sel lstu
  -- Set the ATTA - UDA :MDSMatRef with the PROPCON Property, if it is declared in the dimensions default file
  !!mdssetmatref(!!ce)
  !!mdsDacControl(true)
  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsBr01.support.type|

  !!mdsSetIspe()

  --  Add stex for isometrics
  -- set stex for atta
  !satta = !!ce

  !!mdsSelLstu(!!ce)

  -- Test user criteria
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !projStandard = !form.support.replace
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!form, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  endif

  !!mdsDacControl(true)
  POS AT PREV
  handle any
    pos at ph
  endhandle
  -- thro $!legcomp
  call !!mdsTransport(!satta,!name)

  !!mdsDacControl(true)
  if !currcomp.type.eq('REDU') then
    thro ph of cref of prev
  endif

  -- Always add atta to support object
  !!mdsBr01.support.atta.clear()
  !!mdsBr01.support.atta.append(!!ce)
  !!mdsBr01.support.datum  = !!ce
  !!mdsBr01.support.paDir  = Pa Dir wrt world
  !!mdsBr01.support.plDir  = Pl Dir wrt world
  !!mdsBr01.support.p9Dir  = P9 Dir wrt world

  -- Add marker text
  !!mdsaidtext(!!mdsBr01)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsBr01.support.atta)

  -- Colour Support
  call !!kenhanceList(!colourList)

  -- When finished grey out datum gadget and reset height,length and setsteel
  !!mdsSetGadgets(!!mdsBr01,!!ce,!!mdsBr01.support.type)
  !!mdsBr01.datum.active = false

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- set focus to the distance text gadget
  !!mdsBr01.dist.setfocus()

  !!mdsDacControl(false)

  -- End function
endfunction
