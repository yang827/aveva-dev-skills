--
-- File: Mdssetdatbr02.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.morris
-- Created:   Tue Oct 28
--
-- Revision:
--
-- Description:
-- Creation function for general ancillary Br02
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatBr02()

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kgetSetUnits()

  -- Initialise variables

  !tubeType = !!mdsOptions.pipes
  !datum    = !!mdsBr02.support.datum
  !name     = !!mdsBr02.name.val
  !alias    = !!mdsBr02.support.alias
  !form     = !!mdsBr02
  !fromAtta    = !form.support.preliminaryStore.set()

  !unusedreplace  = !!mdsBr02.support.replace

  !unusedcecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  !unusedidType   = 'pipe'
  !pipeType       = 'tube'
  !unusedflanType = 'flan'
  !purp = 'PIPE'

  label /again

  if (!!mdsIdTube(!tubeType, 'Identify Header $!pipeType ',!purp).not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif
  -- Must be a tee/olet/redu

  if !!ce.type.neq('TEE') and !!ce.type.neq('OLET') and !!ce.type.neq('REDU') then
    !!alert.error('Identified element must be a tee,olet or redu, unable to continue')
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary name
      !!mdsAutoTubePicker.cancel()
    endif
    return
  endif

  var !unusedmode mode
  forwards
  !where = ''
  !unusedto = ''

  !currcomp = !!ce



  -- check if the tee is connected and what direction the branch is going in
  if !!ce.cend.unset() then
    !!alert.error('Identified is not Connected to a Branch, Unable to Continue')
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary
      !!mdsAutoTubePicker.cancel()
    endif
    return
  elseif !!ce.cend.eq('HEAD') then
    !forw = true
  else
    !forw = false
  endif

  !p3dir = !!ce.pdir[3]
  !plDir1 = pl dir
  !plod1 = pl od

  if (!fromAtta) then
    -- turn off autopicker temporarily
    !!mdsAutoTubePicker.disable()
  endif

  if (!!mdsIdTube('FLAN', 'Identify Flange on Second Branch $!pipeType ',!purp).not())then
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary
      !!mdsAutoTubePicker.cancel()
    endif
    return
  endif

  -- Cannot identify a branch as there must be a change of direction in the branch

  if !!ce.type.eq('BRAN') then
    !!alert.error('Identified element cannot be a branch as there must be a change in direction')
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary
      !!mdsAutoTubePicker.cancel()
    endif
    return
  endif

  -- Is the identified branch connected to the identified tee

  if !!ce.owner.href.neq(!currcomp) and !!ce.owner.tref.neq(!currcomp) then
    !!alert.error('identified element is not connected to the identified tee')
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary
      !!mdsAutoTubePicker.cancel()
    endif
    return
  endif
  -- get the direction for orientation purposes
  !legcomp = !!ce
  if !forw then
    !matchdir = !!ce.ldir
  else
    !matchdir = !!ce.adir
  endif
  !lea = lea
  !legcompdir = p$!lea dir
  -- get offset of second branch
  if !currcomp.type.eq('REDU') then
    !desp3 = abs(!currcomp.ppos[2].up - !!ce.position.up)
  else
    !desp3 = abs(!currcomp.position.up - !!ce.position.up)
  endif
  pin 1 copy p1
  pin 2 copy pin 1
  pin 2 plane pin 2 thro $!currcomp
  var !desp4 const dist pin 1 to pin 2
  !!mdsResetPins(1,2)
  -- !desp4 = !desp3

  -- Find flange o/d by getting the largest parameter from the list.

  !newParams = ARRAY()
  var !param cpar
  !params = !param.split()
  !params.sort().invert()
  do !killwords from 1 to !params.size()
    !test = !params[$!killwords].real()
    handle any
    elsehandle none
      !newParams.append(!test)
    endhandle
  enddo

  !newParams.sort().invert()
  !flangeOd = !newParams[1]

  -- Select ancillary
  if(!!kgetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif

  !plDir2 = pl dir

  !!ce = !currcomp
  $!boreUnits
  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  !!mdsDacControl(true)
  -- <ak> 19/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsBr02.support.datum = !!ce
  else
    new atta $!where
  endif
  -- </ak> 19/06/2012
  spkbrk TRUE
  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsBr02.support.replace
    !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
    -- <ak> 13/06/2012
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsBr02, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  elsehandle NONE
    ------------------------------------------------------------------------------
    -- mjb >>> 11.04.06 <mds12>
    -- The element may exist in the specification but the project may not contain the size in the parameters file
    units mm bore
    spref $!choice[1]
    !lbor = !!ce.lbor.real().value()
    !mds12test = !!mdsSetDesPars(!!ce)
    if (!mds12test.not()) then
      --if undefined(!!mdspar$!alias[$!bore]) then
      -- mjb <<< end of mod
      ------------------------------------------------------------------------------
      !projStandard = !!mdsBr02.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <ak> 13/06/2012
      !!kRestoreUnits(!currentUnits)
      if !fromAtta then
        !!mdsRestorePre(!!mdsBr02, true)
        return
      endif
      delete atta
      !!mdsDacControl(false)
      return
    endif
  endhandle
  ------------------------------------------------------------------------------
  -- mjb >>> 11.04.06 <mds12>
  --mm bore
  --spref $!choice[1]

  --!!mdsSetDesPars(!!ce)
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------
  !!mdsDacControl(true)
  despar n3 $!desp3
  despar n4 $!desp4
  despar n6 $!flangeOd
  -- Design parameter will be the angle from the main pipe to the branch, this can only be 0 or 90
  -- dependant on if the branch is perpendicular or parallel
  !angle = !plDir1.angle(!plDir2)
  if !angle.geq(40) and !angle.leq(95) then
    !angle = 0
  else
    !angle = 90
    -- If the angle is 90 we need to work out a new angle from the od of the pipe which is despar 5
    !newAngle = (atan(!desp3 / (!plod1 / 2)))
    despar n5 $!newAngle
  endif
  despar n7 $!angle
  --<dw>aug2008 dun979-repad addition default settings
  despar n12 A
  !!mdsBr02.rpad.active = true
  --<dw>aug2008 dun979-end of repad addition settings

  !!mdsDacControl(true)
  ------------------------------------------------------------------------------
  -- mjb >>> 11.04.06 <mds12>
  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!!ce.stype,!lbor)
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 13/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsBr02, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)
  --!check = object MDSCHECKSTD()
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------

  !unusedmin      = STRING()
  !unusedmax      = STRING()
  !matError = STRING()

  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 13/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsBr02, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  endif
  !!mdsDacControl(true)
  sel lstu
  conn and p3 is $!p3dir
  handle any
    conn
  endhandle


  -- Need to check if the atta is pointing in the right direction

  -- Parallel Branch
  if !angle.eq(90) then
    -- Check if the p1 direction without any z component is the same if so flip conn
    !p1DirNoZ = !legcompdir
    !p1DirNoZ.up = 0
    !p15DirNoZ = !!ce.pdir[15]
    !p15DirNoZ.up = 0
    if !lea.eq(2) then
      if !p1DirNoZ.string().before('WRT').neq(!p15DirNoZ.string().before('WRT')) then
        flip conn
      endif
    else
      if !p1DirNoZ.string().before('WRT').eq(!p15DirNoZ.string().before('WRT')) then
        flip conn
      endif
    endif
    -- Perpendicular Branch
  elseif !angle.eq(0) then
    conn and p10 is p1 of $!legcomp
    -- Check to see if the p3 is higher than the p0 if so flip it
    if !!ce.ppos[3].up.gt(!!ce.ppos[0].up) then
      flip conn and p10 is p1 of $!legcomp
      handle any
        flip conn
      endhandle
    endif
  endif

  -- Set the ATTA - UDA :MDSMatRef with the PROPCON Property, if it is declared in the dimensions default file
  !!mdssetmatref(!!ce)
  !!mdsDacControl(true)
  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsBr02.support.type|

  !!mdsSetIspe()

  --  Add stex for isometrics
  -- set stex for atta
  !satta = !!ce

  !!mdsSelLstu(!!ce)

  -- Test user criteria
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !projStandard = !form.support.replace
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!form, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  endif

  !!mdsDacControl(true)
  POS AT PREV
  handle any
    pos at ph
  endhandle

  call !!mdsTransport(!satta,!name)

  !!mdsDacControl(true)
  if !currcomp.type.eq('REDU') then
    thro ph of cref of prev
  endif

  -- Always add atta to support object
  !!mdsBr02.support.atta.clear()
  !!mdsBr02.support.atta.append(!!ce)
  !!mdsBr02.support.datum  = !!ce
  !!mdsBr02.support.paDir  = Pa Dir wrt world
  !!mdsBr02.support.plDir  = Pl Dir wrt world
  !!mdsBr02.support.p9Dir  = P9 Dir wrt world

  -- Add marker text
  !!mdsaidtext(!!mdsBr02)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsBr02.support.atta)

  -- Colour Support
  call !!kenhanceList(!colourList)

  -- When finished grey out datum gadget and reset height,length and setsteel
  !!mdsSetGadgets(!!mdsBr02,!!ce,!!mdsBr02.support.type)
  !!mdsBr02.datum.active = false

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- set focus to the distance text gadget
  !!mdsBr02.dist.setFocus()

  !!mdsDacControl(false)

  -- End function
endfunction
