--
-- File:    Mdssetdatbr03.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.morris
-- Created:   Tue Oct 28
--
-- Revision:
--
-- Description:
-- Creation function for general ancillary Br03
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatBr03()

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise variables

  !tubeType = !!mdsOptions.pipes
  !datum    = !!mdsBr03.support.datum
  !name     = !!mdsBr03.name.val
  !alias    = !!mdsBr03.support.alias
  !form     = !!mdsBr03
  !fromAtta    = !form.support.preliminaryStore.set()

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  !pipeType = 'flan'
  !purp = 'PIPE'

  label /again

  if (!!mdsIdTube(!tubeType, 'Identify Header $!pipeType ',!purp).not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif
  -- Must be a tee

  if !!ce.type.neq('FLAN') and !!ce.type.neq('PCOM') and !!ce.type.neq('COUP')then
    !!alert.error('Identified element must have a GTYP of Flange Pcom or Coupling, unable to continue.')
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary name
      !!mdsAutoTubePicker.cancel()
    endif
    return
  endif

  --var !mode mode
  forwards
  !where = ''

  !currcomp = !!ce
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!fromAtta) then
    -- turn off autopicker temporarily
    !!mdsAutoTubePicker.disable()
  endif

  -- Must be a branch connected to a flange

  if (!!mdsIdTube('FLAN', 'Identify Flange on Second Branch $!pipeType ',!purp).not())then
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary name
      !!mdsAutoTubePicker.cancel()
    endif
    return
  endif

  !legcomp = !!ce
  -- get offset of second branch
  --!desp3 = !currcomp.position.up - !!ce.position.up
  --!desp3 = !desp3.abs()
  pin 1 copy pl  $* ce is branch flan
  pin 2 copy pin 1
  pin 2 plane pin 2 thro $!currcomp
  var !desp3 const dist pin 1 to pin 2
  pin 2 dir from pin2 to pin1

  -- Find flange o/d by getting the largest parameter from the list.

  !newParams = ARRAY()
  var !param cpar
  !params = !param.split()
  !params.sort().invert()
  do !killwords from 1 to !params.size()
    !test = !params[$!killwords].real()
    handle any
    elsehandle none
      !newParams.append(!test)
    endhandle
  enddo

  !newParams.sort().invert()
  !flangeOD = !newParams[1]

  -- Select ancillary
  if(!!kGetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif

  !!ce = !currcomp
  $!boreUnits
  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  !!mdsDacControl(true)
  -- <ak> 19/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsBr03.support.datum = !!ce
  else
    new atta $!where
  endif
  -- </ak> 19/06/2012
  -- spkbrk TRUE
  -- ge 06/02/05 Fix for HPD0027614.
  -- spkbrk FALSE
  -- ge 06/02/05
  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsBr03.support.replace
    !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
    -- <ak> 13/06/2012
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsBr03, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  elsehandle none
    ------------------------------------------------------------------------------
    -- mjb >>> 12.04.06 <mds12>
    -- The element may exist in the specification but the project may not contain the size in the parameters file
    spkbrk FALSE
    units mm bore
    spref $!choice[1]
    sel lstu
    handle ANY
    endhandle
    !lbor = !!ce.lbor.real().value()
    !mds12test = !!mdsSetDespars(!!ce)
    if (!mds12test.not()) then
      --if undefined(!!mdspar$!alias[$!bore]) then
      -- mjb <<< end of mod
      ------------------------------------------------------------------------------
      -- <ak> 13/06/2012
      !projStandard = !!mdsBr03.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      !!kRestoreUnits(!currentUnits)
      if !fromAtta then
        !!mdsRestorePre(!!mdsBr03, true)
        return
      endif
      return
    endif
  endhandle
  ------------------------------------------------------------------------------
  -- mjb >>> 12.04.06 <mds12>
  --spkbrk FALSE
  --mm bore
  --spref $!choice[1]
  --sel lstu
  --handle ANY
  --endhandle

  --!!mdsSetDespars(!!ce)
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------
  !!mdsDacControl(true)
  despar n3 $!desp3
  despar n4 $!flangeOD
  var !angle const angle p0 to p22 to p23
  -- If the angle is gt 90 then take 180 off and make it absolute
  if !angle.real().gt(90) then
    !newAngle = !angle.real() - 180
    !newAngle = !newAngle.abs()
  else
    !newAngle = !angle.real()
    !newAngle = !newAngle.abs()
  endif
  despar n5 $!newAngle
  !!mdsDacControl(true)
  ------------------------------------------------------------------------------
  -- mjb >>> 11.04.06 <mds12>
  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!!ce.stype,!lbor)
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 13/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsBr03, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)
  --!check = object MDSCHECKSTD()
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------
  !matError = STRING()

  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 13/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsBr03, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  endif
  !!mdsDacControl(true)
  ori and p3 is pin 2
  sel lstu
  thro $!legcomp
  -- Set the ATTA material
  !!mdssetmatref(!!ce)
  !!mdsDacControl(true)
  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsBr03.support.type|

  !!mdsSetIspe()

  --  Add stex for isometrics
  -- set stex for atta
  !sAtta = !!ce

  !!mdsSelLstu(!!ce)

  -- Test user criteria
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !projStandard = !form.support.replace
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!form, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  endif

  !!mdsDacControl(true)

  !!mdsResetPins(1,2)
  call !!mdsTransport(!sAtta,!name)

  -- Always add atta to support object
  !!mdsBr03.support.atta.clear()
  !!mdsBr03.support.atta.append(!!ce)
  !!mdsBr03.support.datum  = !!ce
  !!mdsBr03.support.pADir  = Pa Dir wrt world
  !!mdsBr03.support.pLDir  = Pl Dir wrt world
  !!mdsBr03.support.p9Dir  = P9 Dir wrt world

  -- Add marker text
  !!mdsaidtext(!!mdsBr03)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsBr03.support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- When finished grey out datum gadget and reset height,length and setsteel
  !!mdsSetGadgets(!!mdsBr03,!!ce,!!mdsBr03.support.type)
  !!mdsBr03.datum.active = false

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- set focus to the distance text gadget
  !!mdsBr03.dist.setFocus()

  !!mdsDacControl(false)

  !!ce = !cecomp

endfunction
