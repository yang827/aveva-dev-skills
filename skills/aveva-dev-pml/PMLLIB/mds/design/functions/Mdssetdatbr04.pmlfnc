--
-- File: Mdssetdatbr04.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.morris
-- Created:   Tue Oct 28
--
-- Revision:
--
-- Description:
-- Creation function for general ancillary Br04
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatBr04()

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kgetSetUnits()

  -- Initialise variables

  !tubeType = !!mdsOptions.pipes
  !datum    = !!mdsBr04.support.datum
  !name     = !!mdsBr04.name.val
  !alias    = !!mdsBr04.support.alias
  !form     = !!mdsBr04
  !fromAtta    = !form.support.preliminaryStore.set()

  !unusedreplace  = !!mdsBr04.support.replace

  !unusedcecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  !unusedidType = 'pipe'
  !pipeType = 'tube'
  !purp = 'PIPE'

  label /again

  if (!!mdsIdTube(!tubeType, 'Identify Header $!pipeType ',!purp).not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif
  -- Must be a tee

  if !!ce.type.neq('TEE') and !!ce.type.neq('OLET') and !!ce.type.neq('REDU') then
    !!alert.error('Identified element must be a tee,olet or redu, unable to continue')
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary name
      !!mdsAutoTubePicker.cancel()
    endif
    return
  endif

  !currcomp = !!ce
  var !unusedmode mode
  forwards
  !where = ''
  !unusedto = ''
  !headerOD = !!ce.lod
  handle any
    !headerOD = !!ce.phod
  endhandle
  if !!ce.type.eq('REDU') then
    !headerOD = min(!!ce.lod,!!ce.aod)
  endif

  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif



  pin 3 copy p3

  goto cref
  handle any
    !!alert.error('Identified tee does not have any connection, unable to continue')
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary name
      !!mdsAutoTubePicker.cancel()
    endif
    !!kRestoreUnits(!currentUnits)
    return
  endhandle

  if (!fromAtta) then
    -- turn off autopicker temporarily
    !!mdsAutoTubePicker.disable()
  endif

  if (!!mdsIdTube(!tubeType, 'Identify Second Branch $!pipeType ',!purp).not())then
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary
      !!mdsAutoTubePicker.cancel()
    endif
    return
  endif

  !unusedlegcomp = !!ce
  -- offset is half the main od + 150mm
  !desp3 = !headerOD / 2 + 150mm
  !desp5 = !!ce.aod
  handle any
    !desp5 = !!ce.phod
  endhandle

  -- Select ancillary
  if(!!kgetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif

  !!ce = !currcomp
  $!boreUnits
  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  !!mdsDacControl(true)

  -- <ak> 19/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsBr04.support.datum = !!ce
  else
    new atta $!where
  endif
  -- </ak> 19/06/2012

  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsBr04.support.replace
    !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
    -- <ak> 13/06/2012
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsBr04, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  elsehandle NONE
    ------------------------------------------------------------------------------
    -- mjb >>> 12.04.06 <mds12>
    -- The element may exist in the specification but the project may not contain the size in the parameters file
    spkbrk TRUE
    units mm bore
    spref $!choice[1]
    sel lstu
    handle ANY
    endhandle
    !lbor = !!ce.lbor.real().value()
    !mds12test = !!mdsSetDesPars(!!ce)
    if (!mds12test.not()) then
      --if undefined(!!mdspar$!alias[$!bore]) then
      -- mjb <<< end of mod
      ------------------------------------------------------------------------------
      !projStandard = !!mdsBr04.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <ak> 13/06/2012
      !!kRestoreUnits(!currentUnits)
      if !fromAtta then
        !!mdsRestorePre(!!mdsBr04, true)
        return
      endif
      delete atta
      !!mdsDacControl(false)
      return
    endif
  endhandle
  ------------------------------------------------------------------------------
  -- mjb >>> 12.04.06 <mds12>
  --spkbrk TRUE
  --mm bore
  --spref $!choice[1]
  --sel lstu
  --handle ANY
  --endhandle

  --!!mdsSetDesPars(!!ce)
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------
  !!mdsDacControl(true)
  despar n3 $!desp3
  despar n5 $!desp5
  var !angle const angle p0 to p25 to p15
  despar n4 $!angle
  --<dw>aug2008 dun979-repad addition default settings
  despar n12 A
  !!mdsBr04.rpad.active = true
  --<dw>aug2008 dun979-end of repad addition settings
  !!mdsDacControl(true)
  ------------------------------------------------------------------------------
  -- mjb >>> 12.04.06 <mds12>
  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!!ce.stype,!lbor)
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 13/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsBr04, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)
  --!check = object MDSCHECKSTD()
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------
  !unusedmin      = STRING()
  !unusedmax      = STRING()
  !matError = STRING()

  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 13/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsBr04, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  endif
  !!mdsDacControl(true)
  conn
  sel lstu
  -- Set the ATTA - UDA :MDSMatRef with the PROPCON Property, if it is declared in the dimensions default file
  !!mdssetmatref(!!ce)
  !!mdsDacControl(true)
  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsBr04.support.type|

  !!mdsSetIspe()

  --  Add stex for isometrics
  -- set stex for atta
  !satta = !!ce

  !!mdsSelLstu(!!ce)

  -- Test user criteria
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !projStandard = !form.support.replace
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!form, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  endif

  !!mdsDacControl(true)
  POS AT PREV
  handle any
    pos at ph
  endhandle
  ori and p3 is pin 3
  pin 3 off
  -- thro $!legcomp
  call !!mdsTransport(!satta,!name)

  !!mdsDacControl(true)
  if !currcomp.type.eq('REDU') then
    thro ph of cref of prev
  endif

  -- Always add atta to support object
  !!mdsBr04.support.atta.clear()
  !!mdsBr04.support.atta.append(!!ce)
  !!mdsBr04.support.datum  = !!ce
  !!mdsBr04.support.paDir  = Pa Dir wrt world
  !!mdsBr04.support.plDir  = Pl Dir wrt world
  !!mdsBr04.support.p9Dir  = P9 Dir wrt world

  -- Add marker text
  !!mdsaidtext(!!mdsBr04)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsBr04.support.atta)

  -- Colour Support
  call !!kenhanceList(!colourList)

  -- When finished grey out datum gadget and reset height,length and setsteel
  !!mdsSetGadgets(!!mdsBr04,!!ce,!!mdsBr04.support.type)
  !!mdsBr04.datum.active = false

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- set focus to the distance text gadget
  !!mdsBr04.dist.setfocus()

  !!mdsDacControl(false)

  -- End function
endfunction
