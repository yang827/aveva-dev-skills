--
-- File: Mdssetdatbr05.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.morris
-- Created:   Tue Oct 28
--
-- Revision:
--
-- Description:
-- Creation function for general ancillary br05
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatbr05()

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kgetSetUnits()

  -- Initialise variables

  !tubeType = 'ELBO'
  !datum    = !!mdsBr05.support.datum
  !name     = !!mdsBr05.name.val
  !alias    = !!mdsBr05.support.alias
  !form     = !!mdsBr05
  !fromAtta    = !form.support.preliminaryStore.set()

  !unusedreplace  = !!mdsBr05.support.replace

  !unusedcecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  !unusedidType   = 'Elbo'
  !unusedpipeType = 'elbo'
  !unusedflanType = 'flan coup'
  !purp = 'PIPE'

  label /again

  if (!!mdsIdTube(!tubeType, 'Identify Header Elbow ',!purp).not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif
  -- Must be an elbo

  if !!ce.type.neq('ELBO') then
    !!alert.error('Identified element must be an Elbow, unable to continue')
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary
      !!mdsAutoTubePicker.cancel()
    endif
    return
  endif

  var !unusedmode mode
  forwards
  !where = ''
  !unusedto = ''

  !elbow = !!ce
  -- Must be an elbo


  if !!ce.cref.badref() then
    !!alert.error('Identified elbow is not connected, unable to continue')
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary
      !!mdsAutoTubePicker.cancel()
    endif
    return
  endif

  -- The last component must be a flan or coup

  --  Now get the Flange/Coupling to connect to
  -- ge 15/12/04 fix for HPD0027406
  do
    prompt off
    prompt load escape 'Identify Flange/Coupling on Second Branch '
    ID @
    handle (61,528)
      prompt on
      if (!fromAtta) then
        -- cancel autopicker and restore preliminary
        !!mdsAutoTubePicker.cancel()
      endif
      return
    endhandle
    if (!!ce.type eq 'FLAN' or !!ce.type eq 'COUP') then
      break
    endif
  enddo
  prompt dismiss
  -- ge 15/12/04 end of fix for HPD0027406

  if !!ce.type.neq('FLAN') and !!ce.type.neq('COUP') then
    !!alert.error('The last member of the branch connected to the ELBOW is not a flange or coupling, unable to continue')
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary
      !!mdsAutoTubePicker.cancel()
    endif
    return
  endif

  -- now get the flange to connect to
  --if (!!mdsIdTube('FLAN COUP', 'Identify Flange/Coupling on Second Branch ',!purp).not())then
  --!!kRestoreUnits(!currentUnits)
  --return
  --endif

  -- need to insert the component either before the elbo or after the elbo
  -- if its after the elbo, it needs to be flipped


  !legcomp = !!ce
  -- get offset of second branch
  --!desp3 = !elbow.position.up - !!ce.position.up
  --!desp3 = !desp3.abs()

  if !legcomp.adir eq !elbow.adir then
    !where = 'before'
    var !desp3 const dist pa of $!elbow to pl of $!legcomp
  elseif !legcomp.adir eq !elbow.ldir then
    !where = 'after'
    var !desp3 const dist pl of $!elbow to pl of $!legcomp
  else $* the items dont match so return an error
    !!alert.error('Flange and Elbow are Out of Line - Creation aborted')
    return
  endif

  -- Find flange o/d by getting the largest parameter from the list.

  !newParams = ARRAY()
  var !param cpar
  !params = !param.split()
  !params.sort().invert()
  do !killwords from 1 to !params.size()
    !test = !params[$!killwords].real()
    handle any
    elsehandle none
      !newParams.append(!test)
    endhandle
  enddo

  !newParams.sort().invert()
  !flangeOd = !newParams[1]
  if !legcomp.type eq 'COUP' then
    var !dist const dist p0 to pl
    if !dist.real() eq !flangeOd then
      !flangeOd = !newParams[3]
    endif
    -- KBR specific parameter number for olets
    !flangeOd = cpar[8]
    handle any
    endhandle
  endif

  -- Select ancillary
  if(!!kgetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif

  !!ce = !elbow
  $!boreUnits
  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  !!mdsDacControl(true)
  bran
  -- <ak> 19/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsBr05.support.datum = !!ce
  else
    new atta $!where $!elbow
  endif
  -- </ak> 19/06/2012

  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsBr05.support.replace
    !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
    -- <ak> 13/06/2012
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsBr05, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  elsehandle NONE
    ------------------------------------------------------------------------------
    -- mjb >>> 11.04.06 <mds12>
    -- The element may exist in the specification but the project may not contain the size in the parameters file
    spkbrk TRUE
    units mm bore
    spref $!choice[1]
    sel lstu
    handle ANY
    endhandle
    !lbor = !!ce.lbor.real().value()
    !mds12test = !!mdsSetDesPars(!!ce)
    if (!mds12test.not()) then
      --if undefined(!!mdspar$!alias[$!bore]) then
      -- mjb <<< end of mod
      ------------------------------------------------------------------------------
      !projStandard = !!mdsBr05.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <ak> 13/06/2012
      !!kRestoreUnits(!currentUnits)
      if !fromAtta then
        !!mdsRestorePre(!!mdsBr05, true)
        return
      endif
      delete atta
      return
    endif
  endhandle
  ------------------------------------------------------------------------------
  -- mjb >>> 12.04.06 <mds12>
  --spkbrk TRUE
  --mm bore
  --spref $!choice[1]
  --sel lstu
  --handle ANY
  --endhandle

  --!!mdsSetDesPars(!!ce)
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------
  !!mdsDacControl(true)
  despar n3 $!desp3
  despar n4 $!flangeOd

  var !angle const angle  p0 to p13 to p16
  despar n5 $!angle
  --<dw>aug2008 dun979-repad addition default settings
  despar n12 A
  !!mdsBr05.rpad.active = true
  --<dw>aug2008 dun979-end of repad addition settings
  !!mdsDacControl(true)
  ------------------------------------------------------------------------------
  -- mjb >>> 12.04.06 <mds12>
  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!!ce.stype,!lbor)
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 13/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsBr05, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)
  --!check = object MDSCHECKSTD()
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------
  !unusedmin      = STRING()
  !unusedmax      = STRING()
  !matError = STRING()

  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 13/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsBr05, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  endif
  !!mdsDacControl(true)
  if !where eq 'before' then
    Conn to next
    ori and p3 is $!elbow.ldir
  else
    flip
    conn and p3 is $!elbow.adir
  endif
  sel lstu
  -- Set the ATTA - UDA :MDSMatRef with the PROPCON Property, if it is declared in the dimensions default file
  !!mdssetmatref(!!ce)
  !!mdsDacControl(true)
  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsBr05.support.type|

  !!mdsSetIspe()

  --  Add stex for isometrics
  -- set stex for atta
  !satta = !!ce

  !!mdsSelLstu(!!ce)

  -- Test user criteria
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !projStandard = !form.support.replace
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!form, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  endif

  !!mdsResetPins(1,2)
  call !!mdsTransport(!satta,!name)

  -- Always add atta to support object
  !!mdsBr05.support.atta.clear()
  !!mdsBr05.support.atta.append(!!ce)
  !!mdsBr05.support.datum  = !!ce
  !!mdsBr05.support.paDir  = Pa Dir wrt world
  !!mdsBr05.support.plDir  = Pl Dir wrt world
  !!mdsBr05.support.p9Dir  = P9 Dir wrt world

  -- Add marker text
  !!mdsaidtext(!!mdsBr05)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsBr05.support.atta)

  -- Colour Support
  call !!kenhanceList(!colourList)

  -- When finished grey out datum gadget and reset height,length and setsteel
  !!mdsSetGadgets(!!mdsBr05,!!ce,!!mdsBr05.support.type)
  !!mdsBr05.datum.active = false

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- set focus to the distance text gadget
  !!mdsBr05.dist.setfocus()

  !!mdsDacControl(false)

  -- End function
endfunction
