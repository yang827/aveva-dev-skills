--
-- File: Mdssetdatbr09.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: D.whiteside
-- Created: Tue Apr 01 2008
--
-- Revision:
--
-- Description: Dun861-As for type Br06 but 2 stiffeners only (KBR requirement)
-- Creation function for general ancillary br09
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatbr09()

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kgetSetUnits()

  -- Initialise variables

  !tubeType = !!mdsOptions.pipes
  !datum    = !!mdsBr09.support.datum
  !name     = !!mdsBr09.name.val
  !alias    = !!mdsBr09.support.alias
  !form     = !!mdsBr09
  !fromAtta    = !form.support.preliminaryStore.set()

  !unusedreplace  = !!mdsBr09.support.replace

  !unusedcecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  !unusedidType = 'pipe'
  !pipeType = 'tube'
  !unusedflanType = 'flan olet coup'
  !purp = 'PIPE'

  label /again

  if (!!mdsIdTube(!tubeType, 'Identify Header $!pipeType ',!purp).not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Must be a tee/olet/redu
  if !!ce.type.neq('TEE') and !!ce.type.neq('OLET') and !!ce.type.neq('REDU') then
    !!alert.error('Identified element must be a tee,olet or redu, unable to continue')
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      -- cancel autopicker and restore preliminary
      !!mdsAutoTubePicker.cancel()
    endif
    return
  endif

  var !unusedmode mode
  forwards
  !where = ''
  !unusedto = ''

  !currcomp = !!ce
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif



  !p3dir = !!ce.pdir[3]

  do
    prompt off
    prompt load escape 'Identify Flange on Second Branch'
    ID @
    handle (61,528)
      prompt on
      if (!fromAtta) then
        -- cancel autopicker and restore preliminary
        !!mdsAutoTubePicker.cancel()
      endif
      return
    endhandle
    if (!!ce.type eq 'FLAN' or !!ce.type eq 'OLET' or !!ce.type eq 'COUP') then
      break
    endif
  enddo
  prompt dismiss

  !legcomp = !!ce


  -- get offset of second branch
  --!desp3 = !currcomp.position.up - !!ce.position.up
  --!desp3 = !desp3.abs()
  if !legcomp.type eq 'OLET' then
    pin 1 copy p3
  else
    pin 1 copy pl
  endif
  pin 2 copy pin 1
  if !currcomp.type.eq('REDU') then
    pin 2 plane pin 2 thro p2 of $!currcomp
  else
    pin 2 plane pin 2 thro $!currcomp
  endif

  var !desp3 const dist pin 1 to pin 2
  -- Find flange o/d by getting the largest parameter from the list.

  !newParams = ARRAY()
  var !param cpar
  !params = !param.split()
  !params.sort().invert()
  do !killwords from 1 to !params.size()
    !test = !params[$!killwords].real()
    handle any
    elsehandle none
      !newParams.append(!test)
    endhandle
  enddo

  !newParams.sort().invert()
  !flangeOd = !newParams[1]
  if !legcomp.type eq 'OLET' or !!ce.type eq 'COUP' then
    var !dist const dist p0 to pl
    if !dist.real() eq !flangeOd then
      !flangeOd = !newParams[3]
    endif
    -- KBR specific parameter number for olets
    !flangeOd = cpar[8]
    handle any
    endhandle
  endif
  -- Select ancillary
  if(!!kgetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif

  !!ce = !currcomp
  $!boreUnits
  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  !!mdsDacControl(true)
  -- <ak> 19/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsBr09.support.datum = !!ce
  else
    new atta $!where
  endif
  -- </ak> 19/06/2012
  spkbrk true
  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsBr09.support.replace
    !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
    -- <ak> 13/06/2012
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsBr09, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  elsehandle none

    -- The element may exist in the specification but the project may not contain the size in the parameters file
    units mm bore
    spref $!choice[1]
    !lbor = !!ce.lbor.real().value()
    !mds12test = !!mdsSetDesPars(!!ce)
    if (!mds12test.not()) then
      !projStandard = !!mdsBr09.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <ak> 13/06/2012
      !!kRestoreUnits(!currentUnits)
      if !fromAtta then
        !!mdsRestorePre(!!mdsBr09, true)
        return
      endif
      delete atta
      return
    endif
  endhandle

  !!mdsDacControl(true)
  despar n3 $!desp3
  despar n4 $!flangeOd
  -- var !angle const angle p0 to p16 to p10
  var !angle const angle p0 to p16 to p15
  -- If the angle is gt 90 then take 180 off and make it absolute
  if !angle.real().gt(90) then
    !newAngle = !angle.real() - 180
    !newAngle = !newAngle.abs() + 1
  else
    !newAngle = !angle.real().abs() + 1
  endif
  despar n5 $!newAngle
  despar n14 A
  !!mdsBr09.rpad.active = true
  !!mdsDacControl(true)

  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!!ce.stype,!lbor)
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 13/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsBr09, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif
  !check    = object MDSCHECKSTD(!mdsattaobj)
  !unusedmin      = STRING()
  !unusedmax      = STRING()
  !matError = STRING()

  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 13/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsBr09, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  endif
  !!mdsDacControl(true)
  conn and p3 is $!p3dir
  sel lstu
  -- Set the ATTA - UDA :MDSMatRef with the PROPCON Property, if it is declared in the dimensions default file
  !!mdssetmatref(!!ce)
  !!mdsDacControl(true)
  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsBr09.support.type|

  !!mdsSetIspe()

  --  Add stex for isometrics
  -- set stex for atta
  !satta = !!ce

  !!mdsSelLstu(!!ce)

  -- Test user criteria
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !projStandard = !form.support.replace
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!form, true)
      return
    endif
    delete atta
    !!mdsDacControl(false)
    return
  endif

  !!mdsDacControl(true)
  POS AT PREV
  handle any
    pos at ph
  endhandle
  conn and p3 is pin 1
  !!mdsResetPins(1,2)
  call !!mdsTransport(!satta,!name)

  !!mdsDacControl(true)
  if !currcomp.type.eq('REDU') then
    thro ph of cref of prev
  endif

  -- Always add atta to support object
  !!mdsBr09.support.atta.clear()
  !!mdsBr09.support.atta.append(!!ce)
  !!mdsBr09.support.datum  = !!ce
  !!mdsBr09.support.paDir  = Pa Dir wrt world
  !!mdsBr09.support.plDir  = Pl Dir wrt world
  !!mdsBr09.support.p9Dir  = P9 Dir wrt world

  -- Add marker text
  !!mdsaidtext(!!mdsBr09)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsBr09.support.atta)

  -- Colour Support
  call !!kenhanceList(!colourList)

  -- When finished grey out datum gadget and reset height,length and setsteel
  !!mdsSetGadgets(!!mdsBr09,!!ce,!!mdsBr09.support.type)
  !!mdsBr09.datum.active = false

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- set focus to the distance text gadget
  !!mdsBr09.dist.setfocus()

  !!mdsDacControl(false)

  -- End function
endfunction
