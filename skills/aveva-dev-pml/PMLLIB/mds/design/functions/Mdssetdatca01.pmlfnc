--
-- File:  Mdssetdatca01.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATPS127
--
-- Author:  Neale Morris
-- Created:  Thurs 23 Oct 2003
--
-- Description:
-- Create a tray atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatCa01()

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise variables

  !tubeType    = !!mdsOptions.pipes
  !datum       = !!mdsCA01.support.datum
  !name        = !!mdsCA01.name.val
  !type        = !!mdsCA01.support.type

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  !pipeType = 'tray section'
  !iDType = 'cable rack'
  !purp = 'TRAY'

  label /again

  if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of datum $!iDType', '$!purp').not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Check that RACK is within the Maximum Slope Allowed,
  -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

  !currcomp = !!ce

  if (!!mdsgradient(!currcomp)) then
    !!alert.message ('The rack identified is not within the maximum slope for horizontal rack as defined in the application defaults ($!!mdsOptions.slope.val)')
    !!ce = !cecomp
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Store the Current/Identified Element DBREF

  !xce = !currcomp
  new atta sel spref with styp '$!type' spec /MDS
  !!mdsSetDesPars(!!ce)
  !!mdsDacControl(true)
  name /$!name
  :MDSSuppType |$!!mdsCA01.support.alias|
  SPKBRK TRUE
  !order = order
  !xat = !!ce
  if (!currcomp.type.eq('FTUB')) then
    !!ce    = !currcomp
    !width  = !!mdsSetWid()
    !height = 0
  else
    if (!order.eq(1)) then
      dist 100
    else
      dist 100 from pl of prev
    endif

    !!ce = !currcomp
    if (!currcomp.type.eq('BRAN')) then
      head
      !hdir = hdir wrt /*
      ileave tube
      !tori = ori wrt /*
      !odir = !tori.string().after('/* ')
      !ori  = 'ori Y is ' & !hdir & ' ' & !odir
      !!ce = !xat
      ori $!ori
    else
      !!ce  = !currcomp
      !hdir = ldir wrt /*
      ileave tube
      !tori = ori wrt /*
      !odir = !tori.string().after('/* ')
      !ori  = 'ori Y is ' & !hdir & ' ' & !odir
      !!ce  = !xat
      ori $!ori
    endif
    !!ce = !currcomp
    !height = 0
    !width  = !!mdstraywidth(!xat, !xce, !height)
  endif
  !!ce = !xat

  -- set stex for atta
  !sAtta = !!ce
  Call !!mdsTransport(!sAtta,!name)

  !!mdsDacControl(true)
  !!mdssetmatref(!!ce)

  !!mdsDacControl(true)
  despar n1 $!width
  despar n2 $!height

  if (!order.eq(1)) then
    fconn
    ori $!ori
    sel lstu
  else
    fconn and p30 is p30 of prev
  endif

  !!mdsCA01.datum.active = false
  !!mdsCA01.support.atta.clear()
  !!mdsCA01.support.atta.append(!!ce)
  !!mdsCA01.support.datum  = !!ce

  !!mdsSelLstu(!!ce)

  !colourList = ARRAY()
  do !addrepre values !!mdsCA01.support.atta
    !!ce = !addrepre
    skip if (match(Name,'SREF') gt 0)
    !colour = !!kFindDrawColour(!!ce)
    !branName = !!ce.owner.string()
    !!mdsCA01.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
    -- Add to model at level set by !!mdsOptions.levChange value
    Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
    !colourList.append(!!ce.name.dbref())
  enddo
  Call !!kEnhanceList(!colourList)

  -- Reset Units

  !!kRestoreUnits(!currentUnits)

  -- set focus to the distance text gadget

  !!mdsCA01.dist.setFocus()
  !!mdsDacControl(false)

endfunction
