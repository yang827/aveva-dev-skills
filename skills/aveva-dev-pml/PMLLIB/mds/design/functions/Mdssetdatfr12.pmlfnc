--
-- File:		MdssetdatFR12.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS127
--
-- Author:		I.Osborne
-- Created:		Mon Jun 23
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetDatFR12()

  -- Find current units and set the distance unit to metric

    !CurrentUnits = !!KGetSetUnits()

  -- Initialise variables
    !TubeType    = !!MdsOptions.Pipes
    !Datum       = !!MdsFR12.Support.Datum
    !Name        = !!MdsFR12.Support.Stru.name
    !Namn        = !!MdsFR12.Support.Stru.namn
    !Alias       = !!MdsFR12.Support.Alias

    !cecomp = !!CE

    if (!Datum.set()) then
      !!Alert.error('Datum atta for support $!Name already exists')
      !!kRestoreUnits(!currentunits)
      return
    endif

  -- Select tube
    !PipeType = 'tray section'
    !IDType = 'cable rack'
    !Purp = 'TRAY'

label /again

    if (!!MdsIdTube('$!TubeType', 'Identify $!PipeType of datum $!IDType', '$!Purp').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

-- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsFR12.support.idcomp = !idcomp
  !!MdsFR12.support.idbran = !idbran

-- Check that RACK is within the Maximum Slope Allowed,
-- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

    !currcomp = !!ce

    if (!!Mdsgradient(!currcomp)) then
      !!Alert.message ('The rack identified is not within the maximum slope for horizontal rack as defined in the application defaults ($!!Mdsoptions.slope.val)')
      !!ce = !cecomp
      !!kRestoreUnits(!currentunits)
      return
    endif


 -- Change callback on apply button then show ancillary form


    !!MdsAncill.Action.Clear()
    !!MdsAncill.Action[1] = |Call !!MdsCrAncill(!!MdsFR12)|
    !!MdsAncill.Action[2] = |Call !!MdsCrDatFR12()|
    !!KShowForm(!!MdsAncill)
    !!MdsIAncill('FR12')

-- Reset Units

   !!kRestoreUnits(!currentunits)

-- set focus to the distance text gadget
   !!MdsFR12.Dist.SetFocus()
   !!MdsDacControl(false)
-- End function
endfunction

-- End of file MdssetdatFR12.pml
