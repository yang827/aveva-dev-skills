--
-- File:    Mdssetdatft03.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MDATPS126
--
-- Author:    I.osborne
-- Created:   Tue Jun 03
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatFt03()

  -- Find current units and set the distance unit to metric

  !currentunits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType    = !!mdsoptions.pipes
  !datum       = !!mdsFT03.support.datum
  !name        = !!mdsFT03.support.stru.name
  !alias       = !!mdsFT03.support.alias
  !fromAtta    = !!mdsFT03.support.preliminaryStore.set()
  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Select tube
  if (!alias eq 'FT03') then
    if (!tubeType eq 'FTUB')then
      !pipeType = 'lined section'
    else
      !pipeType = 'tube'
    endif
    !idtype = 'pipe'
    !purp = 'PIPE'
  elseif (!alias eq 'CT02') then
    !pipeType = 'tray section'
    !idtype = 'cable rack'
    !purp = 'TRAY'
  endif


  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998

  if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of datum $!idtype','$!purp').not())then
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsFT03.support.idcomp = !idcomp
  !!mdsFT03.support.idbran = !idbran



  if (!alias eq 'FT03') then

    -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
    -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

    !currcomp = !!ce
    if (!!ce.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
    endif




    -- Check that the :MDSHv attribute of the template zone to see if horizontal
    -- or vertical pipes are allowed

    if !!mdschecktemp('/MDS/FRAMES/FT03-HORI','$!hdir').not() then
      !!kRestoreUnits(!currentunits)
      if !fromAtta then
        !!mdsCancelSupp(!!mdsFT03)
      endif
      return
    endif

  elseif (!alias eq 'CT02') then

    -- Check that PIPE is within the Maximum Slope Allowed,
    -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

    !currcomp = !!ce

    if (!!mdsgradient(!currcomp)) then
      !!alert.message ('The rack identified is not within the maximum slope for horizontal rack as defined in the application defaults ($!!mdsoptions.slope.val)')
      !!ce = !cecomp
      !!kRestoreUnits(!currentunits)
      if !fromAtta then
        !!mdsCancelSupp(!!mdsFT03)
      endif
      return
    endif

  endif

  -- Change callback on apply button then show ancillary form
  if (!alias eq 'FT03') then
    !!mdsAncill.action.clear()
    !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT03)|
    !!mdsAncill.action[2] = |Call !!mdsCrDatFt03()|
    !!kShowForm(!!mdsAncill)
    !!mdsIAncill('FT03')
  elseif (!alias eq 'CT02') then
    !!mdsAncill.action.clear()
    !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT03)|
    !!mdsAncill.action[2] = |Call !!mdsCrDatFt03()|
    !!kShowForm(!!mdsAncill)
    !!mdsIAncill('CT02')






  endif

  -- Reset Units

  !!kRestoreUnits(!currentunits)

  -- set focus to the distance text gadget
  !!mdsFT03.dist.setFocus()
  !!mdsDacControl(false)
  -- End function
endfunction
