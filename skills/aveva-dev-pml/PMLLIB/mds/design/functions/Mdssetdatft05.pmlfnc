--
-- File:    Mdssetdatft05.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MDATPS128
--
-- Author:    I.osborne
-- Created:   Tue Jun 24
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatFt05()

  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  !tubeType = !!mdsoptions.pipes
  !support  = !!mdsFT05.support
  !datum    = !support.datum
  !name     = !support.stru.name
  !alias    = !!mdsFT05.support.alias
  !fromAtta = !!mdsFT05.support.preliminaryStore.set()
  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    return
  endif

  -- Select tube
  if (!alias eq 'FT05') then
    if (!tubeType eq 'FTUB')then
      !pipeType = 'lined section'
    else
      !pipeType = 'tube'
    endif
    !idtype = 'pipe'
    !purp = 'PIPE'
  elseif (!alias eq 'CT03') then
    !pipeType = 'tray section'
    !idtype = 'cable rack'
    !purp = 'TRAY'
  endif

  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998

  if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of datum pipe','$!purp').not())then
    return
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsFT05.support.idcomp = !idcomp
  !!mdsFT05.support.idbran = !idbran


  if (!alias eq 'FT05') then

    -- Check that PIPE is within the Maximum Slope Allowed,
    -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

    !currcomp = !!ce

    if (!!mdsgradient(!currcomp)) then
      !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsoptions.slope.val)')
      !!ce = !cecomp
      if !fromAtta then
        !!mdsCancelSupp(!!mdsFT05)
      endif
      return
    endif

  elseif (!alias eq 'CT03') then

    -- Only racks that are on their side may be supported with this FRAMEwork/

    !currcomp = !!ce

    !padir = pa dir wrt world
    handle any
      !padir = p1 dir wrt world
    endhandle
    !p30dir = p30 dir wrt world

    if (match(!padir.string(),'U') gt 0) or (match(!padir.string(),'D') gt 0) or (match(!p30dir.string(),'U') gt 0) or (match(!p30dir.string(),'D') gt 0) or (match(!padir.string(),'Z') gt 0) or (match(!padir.string(),'-Z') gt 0) or (match(!p30dir.string(),'Z') gt 0) or (match(!p30dir.string(),'-Z') gt 0)  then
      !!alert.message ('The rack identified is not supportable with this type of framework')
      FTUB
      handle any
      endhandle
      !!ce = !cecomp
      if !fromAtta then
        !!mdsCancelSupp(!!mdsFT05)
      endif
      return
    endif

  endif

  -- Change callback on apply button then show ancillary form
  if (!alias eq 'FT05') then
    !!mdsAncill.action.clear()
    !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT05)|
    !!mdsAncill.action[2] = |Call !!mdsCrDatFt05()|
    !!kShowForm(!!mdsAncill)
    !!mdsIAncill('FT05')
  elseif (!alias eq 'CT03') then
    !!mdsAncill.action.clear()
    !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT05)|
    !!mdsAncill.action[2] = |Call !!mdsCrDatFt05()|
    !!kShowForm(!!mdsAncill)
    !!mdsIAncill('CT03')









  endif


  -- set focus to the distance text gadget
  !!mdsFT05.dist.setFocus()
  -- End function
endfunction
