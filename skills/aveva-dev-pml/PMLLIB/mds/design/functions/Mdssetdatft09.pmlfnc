--
-- File:    Mdssetdatft09.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MDATPS132
--
-- Author:    I.osborne
-- Created:   Wed Jul 02
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatFt09()

  -- Find current units and set the distance unit to metric
  !currentunits = !!kGetSetUnits()

  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  !tubeType = !!mdsoptions.pipes
  !support  = !!mdsFT09.support
  !datum    = !support.datum
  !name     = !support.stru.name
  !alias    = !!mdsFT09.support.alias
  !fromAtta = !!mdsFT09.support.preliminaryStore.set()

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Select tube
  if (!alias eq 'FT09' or !alias.eq('FT36') or !alias.eq('FT64') or !alias.eq('FT65')) then
    if (!tubeType eq 'FTUB')then
      !pipeType = 'lined section'
    else
      !pipeType = 'tube'
    endif
    !idtype = 'pipe'
    !purp = 'PIPE'
  elseif (!alias eq 'CT05') then
    !pipeType = 'tray section'
    !idtype = 'cable rack'
    !purp = 'TRAY'
  elseif (!alias eq 'DT01') then
    !pipeType = 'HVAC section'
    !idtype = 'HVAC'
    !purp = 'HVAC'
  endif

  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998

  if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of datum $!idtype','$!purp').not())then
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsFT09.support.idcomp = !idcomp
  !!mdsFT09.support.idbran = !idbran


  if (!alias eq 'FT09' or !alias.eq('FT36') or !alias.eq('FT64') or !alias.eq('FT65')) then

    -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
    -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

    !currcomp = !!ce
    if (!!ce.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
    endif

    -- Check that the :MDSHv attribute of the template zone to see if horizontal
    -- or vertical pipes are allowed

    if !!mdschecktemp('/MDS/FRAMES/$!alias','$!hdir').not() then
      !!kRestoreUnits(!currentunits)
      if !fromAtta then
        !!mdsCancelSupp(!!mdsFT09)
      endif
      return
    endif

    -- Check if the bore of the identified pipe does not exceed the maximum allowed bore

    !template = '/MDS/FRAMES/$!alias'
    ------------------------------------------------------------------------------
    -- mjb >>> 05.05.06 <mds12>
    !checkBore = object MDSCHECKFRAME()
    --!checkBore = object MDSCHECKSTD()
    -- mjb <<< 05.05.06 end of mod
    ------------------------------------------------------------------------------
    if !checkBore.bores('$!template').not() then
      !!kRestoreUnits(!currentunits)
      !bore = abore
      handle any
        !bore = hbore
      endhandle
      !minBore = :MDSMinBore of $!template
      !maxBore = :MDSMaxBore of $!template
      if(!currentunits.isImperialSavedBore().not()) then
        !sMinBore = !minBore
        !sMaxBore = !maxBore
      else
        !sMinBore = ( DIST ( NOMBORE ( false , $!minBore ) , false , false , true , 4 , false ) )
        !sMaxBore = ( DIST ( NOMBORE ( false , $!maxBore ) , false , false , true , 4 , false ) )
      endif
      !!alert.error('Standard not available at this bore! ($!bore). Minimum ($!sMinBore) Maximum ($!sMaxBore)')
      !!kRestoreUnits(!currentunits)
      if !fromAtta then
        !!mdsCancelSupp(!!mdsFT09)
      endif
      return
    endif

  elseif (!alias eq 'CT05') then

    -- Check that RACK is within the Maximum Slope Allowed,
    -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.
    !currcomp = !!ce

    if (!!ce.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
      handle any
        !hdir = !!ce.pdir[2].wrt(world)
      endhandle
    endif

    if (!hdir neq U and !hdir neq D ) then
      if (!!mdsgradient(!currcomp)) then
        !!alert.message ('The rack identified is not within the maximum slope for horizontal rack as defined in the application defaults ($!!mdsoptions.slope.val)')
        !!ce = !cecomp
        !!kRestoreUnits(!currentunits)
        if !fromAtta then
          !!mdsCancelSupp(!!mdsFT09)
        endif
        return
      endif
    endif

    -- Check that the :MDSHv attribute of the template zone to see if horizontal,
    -- vertical pipes or both are allowed
    if !!mdschecktemp('/MDS/FRAMES/$!alias','$!hdir').not() then
      !!kRestoreUnits(!currentunits)
      if !fromAtta then
        !!mdsCancelSupp(!!mdsFT09)
      endif
      return
    endif

  elseif (!alias eq 'DT01') then

    -- Check that HVAC is within the Maximum Slope Allowed,
    -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.
    !currcomp = !!ce

    if (!!mdsgradient(!currcomp)) then
      !!alert.message ('The HVAC identified is not within the maximum slope for horizontal HVAC as defined in the application defaults ($!!mdsoptions.slope.val)')
      !!ce = !cecomp
      !!kRestoreUnits(!currentunits)
      if !fromAtta then
        !!mdsCancelSupp(!!mdsFT09)
      endif
      return
    endif

  endif

  -- Change callback on apply button then show ancillary form
  if (!alias eq 'FT09' or !alias.eq('FT36') or !alias.eq('FT64') or !alias.eq('FT65')) then
    !!mdsAncill.action.clear()
    !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT09)|
    !!mdsAncill.action[2] = |Call !!mdsCrDatFt09()|
    !!kShowForm(!!mdsAncill)
    !!mdsIAncill('$!alias')

  elseif (!alias eq 'CT05') then
    !!mdsAncill.action.clear()
    !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT09)|
    !!mdsAncill.action[2] = |Call !!mdsCrDatFt09()|
    !!kShowForm(!!mdsAncill)
    !!mdsIAncill('CT05')







  elseif (!alias eq 'DT01') then
    -- No ancillaries on HVAC so go into the CrDat straight away
    -- after creating atta set setting the attributes
    -- Height and width will be despar 1 and 2
    Call !!mdsResetPins(8,9)
    bran
    same
    !readHVAC = !!ce
    if !fromAtta then
      !!ce = object DBREF(!name & '_Pre')
      :mdssupptype default
      :mdssuppfunc default
      sel spref with styp 'HVAC-REST' spec /MDS
      handle (42,64) (42,66)
        spref /MDS/.HVAC-REST.1
      endhandle
    else
    new atta sel spref with styp 'HVAC-REST' spec /MDS
    handle (42,64) (42,66)
        spref /MDS/.HVAC-REST.1
    endhandle
    endif
    SPKBRK FALSE
    !writeHVAC = !!ce

    -- set stex for atta
    !sAtta = !!ce
    Call !!mdsTransport(!sAtta,!name)
    !!mdsDacControl(true)

    despar 100mm 100mm

    --> Modified -<wd>- 4nov1998
    if (!support.alias inset ('DT01','DT02','DT03','DT04')) then
      if (!fromAtta.not()) then
        fconn
      endif
      ori and p3 is d wrt /*
    else
      -- P30 for KJB HVAC and P61 for CADC
      fconn and p30 is p30 of prev
      --xxx        handle (61,1) (42,94) (2,201)
      --xxx          fconn and p20 is p61 of prev
      --xxx        endhandle
    endif
    --< Modified -<wd>- 4nov1998

    !!mdsSetHvac(!readHVAC,!writeHVAC)

    !!mdsSelLstu(!!ce)
    -- Always add atta to datum cross bar
    !!mdsFT09.support.bars[1][1] = !!ce.name.dbref()
    !!mdsFT09.support.atta.append(!!ce)
    !!ce = !writeHVAC
    Call !!mdsCrDatFt09()
    if (!fromAtta) then
      !!mdsSetDatumAtta(!!ft09)
    endif
  endif

  -- Reset Units
  !!kRestoreUnits(!currentunits)

  -- set focus to the distance text gadget
  !!mdsFT09.dist.setFocus()
  !!mdsDacControl(false)

  -- End function
endfunction
