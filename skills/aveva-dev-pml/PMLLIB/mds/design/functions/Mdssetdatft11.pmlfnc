--
-- File:    Mdssetdatft11.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS134
--
-- Author:  I.osborne
-- Created:		Mon Jul 14
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatFt11()

-- Force into forwards mode
   FORWARDS

  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !support  = !!mdsFT11.support
  !datum    = !support.datum
  !name     = !support.stru.name
  !alias    = !!mdsFT11.support.alias
  !fromAtta = !!mdsFT11.support.preliminaryStore.set()

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
      return
    endif

  -- Select tube
  if (!alias eq 'FT11' or !alias eq 'FT38' or !alias eq 'FT62' or !alias eq 'FT63' ) then
    if (!tubeType eq 'FTUB')then
      !pipeType = 'lined section'
    else
      !pipeType = 'tube'
    endif
    !idType = 'pipe'
    !purp = 'PIPE'
  elseif (!alias eq 'DT02') then
    !pipeType = 'HVAC section'
    !idType = 'HVAC'
    !purp = 'HVAC'
  endif

  if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of datum $!idType','$!purp').not())then
    return
  endif

-- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsFT11.support.idcomp = !idcomp
  !!mdsFT11.support.idbran = !idbran

-- Check that PIPE is within the Maximum Slope Allowed,
-- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

--<wd>nov2004
    if (!!ce.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
    endif

-- Change callback on apply button then show ancillary form
  if (!alias eq 'FT11' or !alias eq 'FT38' or !alias eq 'FT62' or !alias eq 'FT63') then
    !!mdsAncill.action.clear()
    !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT11)|
    !!mdsAncill.action[2] = |Call !!mdsCrDatFt11()|
    !!kShowForm(!!mdsAncill)
    !!mdsIAncill('$!alias')
  elseif (!alias eq 'DT02') then
    -- First check if the HVAC is on a slope
    -- This is not allowed P30 must be up for KJB HVAC
    -- and P61 must be UP or down on CADC HVAC
    var !p30dir P30 Dir
        handle (42,94) (2,201)

      var !p30dir P61 Dir
      --<RM> 09/10/09 P-25531, replaced the old up/down direction check so that this will work in xyz mode in marine
      if (!p30Dir.direction().up.eq(1)) then
        !checkString = 1
      elseif (!p30Dir.direction().up.eq(-1)) then
        !checkString = -1
      else
        -- invalid checkstring when p30 dir is not up or down
        !checkString = 1234
      endif

    elsehandle NONE

      !checkString = 1

    endhandle

    if (!p30dir.direction().up.neq(!checkString)) then
      !!alert.error('Only available for horizontal HVAC')
      if !fromAtta then
        !!mdsCancelSupp(!!mdsFT11)
      endif
      return
    endif
    --<RM> 09/10/09 -- end of fix

    -- No ancillaries on HVAC so go into the CrDat straight away
    -- after creating atta set setting the attributes
    -- Height and width will be despar 1 and 2
    Call !!mdsResetPins(8,9)
      bran
      same
    !readHVAC = !!ce
    if !fromAtta then
      !!ce = object DBREF(!name & '_Pre')
      :mdssupptype default
      :mdssuppfunc default
      sel spref with styp 'HVAC-REST' spec /MDS
      handle (42,64) (42,66)
        spref /MDS/.HVAC-REST.1
      endhandle
    else
      new atta sel spref with styp 'HVAC-REST' spec /MDS
      handle (42,64) (42,66)
        spref /MDS/.HVAC-REST.1
      endhandle
    endif
      SPKBRK TRUE
    !writeHVAC = !!ce

    -- set stex for atta
    !sAtta = !!ce
    Call !!mdsTransport(!sAtta,!name)
    !!mdsDacControl(TRUE)
    --!conn = pa conn of prev

      !currentunits = !!kgetsetunits()

      despar 100mm 100mm

      !!kRestoreUnits(!currentunits)

--> Modified -<wd>- 4nov1998
-- P30 for KJB HVAC and P6 for CADC
    --xxx      !ppointList = ppls
    --xxx      if !ppointList.find(30).size() gt 0 then
--xxx        fconn and p30 is p30 of prev
--xxx      else
--xxx        fconn and p20 is p61 of prev
--xxx      endif
      if (!support.alias inset ('DT01','DT02','DT03','DT04')) then
      if (!fromAtta.not()) then
        fconn
      endif
        ori and p3 is d wrt /*
      spkbrk FALSE
      else
-- P30 for KJB HVAC and P61 for CADC
        fconn and p30 is p30 of prev
      endif
--< Modified -<wd>- 4nov1998

    !!mdsSetHvac(!readHVAC,!writeHVAC)
    !!mdsSelLstu(!!ce)
      -- Always add atta to datum cross bar
    !!mdsFT11.support.bars[1][1] = !!ce.name.dbref()
    !!mdsFT11.support.atta.append(!!ce)
    !!ce = !writeHVAC
    Call !!mdsCrDatFt11()
    if (!fromAtta) then
      !!mdsSetDatumAtta(!!ft11)
    endif
  endif

-- set focus to the distance text gadget
  !!mdsFT11.dist.setFocus()
  !!mdsDacControl(FALSE)

endfunction
