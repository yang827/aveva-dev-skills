--
-- File:  Mdssetdatft13.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATPS137
--
-- Author:  I.osborne
-- Created:  Wed Jul 16
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatFt13()

  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !support  = !!mdsFT13.support
  !datum    = !support.datum
  !name     = !support.stru.name
  !alias    = !support.alias
  !fromAtta = !!mdsFT13.support.preliminaryStore.set()

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    return
  endif

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif

  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998

  if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of datum pipe','PIPE').not())then
    return
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsFT13.support.idcomp = !idcomp
  !!mdsFT13.support.idbran = !idbran


  -- Check that PIPE is within the Maximum Slope Allowed,
  -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

  !currcomp = !!ce

  if (!!mdsgradient(!currcomp)) then
    !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
    !!ce = !cecomp
    if !fromAtta then
      !!mdsCancelSupp(!!mdsFT13)
    endif
    return
  endif

  -- Change callback on apply button then show ancillary form
  !!mdsAncill.action.clear()
  !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT13)|
  !!mdsAncill.action[2] = |Call !!mdsCrDatFt13()|

  !!kShowForm(!!mdsAncill)
  !!mdsIAncill('$!alias')


  -- set focus to the distance text gadget
  !!mdsFT13.dist.setFocus()

endfunction
