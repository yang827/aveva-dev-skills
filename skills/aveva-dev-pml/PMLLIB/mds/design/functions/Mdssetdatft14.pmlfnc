--
-- File:    Mdssetdatft14.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MDATPS138
--
-- Author:    I.osborne
-- Created:   Tue Jul 22
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatFt14()

  !currentunits = !!kgetsetunits()

  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  !tubeType = !!mdsoptions.pipes
  !datum    = !!mdsFT14.support.datum
  !name     = !!mdsFT14.support.stru.name
  !alias    = !!mdsFT14.support.alias
  !fromAtta = !!mdsFT14.support.preliminaryStore.set()

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Select tube

  if (!alias eq 'FT14') then
    if (!tubeType eq 'FTUB')then
      !pipeType = 'lined section'
    else
      !pipeType = 'tube'
    endif
    !idtype = 'pipe'
    !purp = 'PIPE'
  elseif (!alias inset('CT06','CT09')) then
    !pipeType = 'tray section'
    !idtype = 'cable rack'
    !purp = 'TRAY'
  elseif (!alias eq 'DT03') then
    !pipeType = 'HVAC section'
    !idtype = 'HVAC'
    !purp = 'HVAC'
  endif

  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998

  if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of datum $!idtype','$!purp').not())then
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsFT14.support.idcomp = !idcomp
  !!mdsFT14.support.idbran = !idbran

  if (!alias eq 'FT14') then

    -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
    -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

    !currcomp = !!ce
    if (!!ce.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
    endif

    if (!hdir neq U and !hdir neq D ) then
      if (!!mdsgradient(!currcomp)) then
        !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsoptions.slope.val)')
        !!ce = !cecomp
        !!kRestoreUnits(!currentunits)
        if !fromAtta then
          !!mdsCancelSupp(!!mdsFT14)
        endif
        return
      endif
    endif

    -- Check that the :MDSHv attribute of the template zone to see if horizontal
    -- or vertical pipes are allowed

    if !!mdschecktemp('/MDS/FRAMES/FT14-HORI','$!hdir').not() then
      !!kRestoreUnits(!currentunits)
      return
    endif


  elseif (!alias inset('CT06','CT09')) then

    -- Check that RACK is within the Maximum Slope Allowed,
    -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

    !currcomp = !!ce

    if (!!mdsgradient(!currcomp)) then
      !!alert.message ('The rack identified is not within the maximum slope for horizontal rack as defined in the application defaults ($!!mdsoptions.slope.val)')
      !!ce = !cecomp
      !!kRestoreUnits(!currentunits)
      if !fromAtta then
        !!mdsCancelSupp(!!mdsFT14)
      endif
      return
    endif

  elseif (!alias eq 'DT03') then

    -- Check that HVAC is within the Maximum Slope Allowed,
    -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

    !currcomp = !!ce

    if (!!mdsgradient(!currcomp)) then
      !!alert.message ('The HVAC identified is not within the maximum slope for horizontal HVAC as defined in the application defaults ($!!mdsoptions.slope.val)')
      !!ce = !cecomp
      !!kRestoreUnits(!currentunits)
      if !fromAtta then
        !!mdsCancelSupp(!!mdsFT14)
      endif
      return
    endif

  endif

  -- Change callback on apply button then show ancillary form
  if (!alias eq 'FT14') then
    !!mdsAncill.action.clear()
    !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT14)|
    !!mdsAncill.action[2] = |Call !!mdsCrDatFt14()|
    !!kShowForm(!!mdsAncill)
    !!mdsIAncill('FT14')
  elseif (!alias eq 'CT06') then
    !!mdsAncill.action.clear()
    !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT14)|
    !!mdsAncill.action[2] = |Call !!mdsCrDatFt14()|
    !!kShowForm(!!mdsAncill)
    !!mdsIAncill('CT06')
  elseif (!alias eq 'CT09') then
    !!mdsAncill.action.clear()
    !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT14)|
    !!mdsAncill.action[2] = |Call !!mdsCrDatFt14()|
    !!kShowForm(!!mdsAncill)
    !!mdsIAncill('CT09')






  elseif (!alias eq 'DT03') then
    -- No ancillaries on HVAC so go into the CrDat straight away
    -- after creating atta set setting the attributes
    -- Height and width will be despar 1 and 2
    Call !!mdsResetPins(8,9)
    bran
    same
    !readHVAC = !!ce
    if !fromAtta then
      !!ce = object DBREF(!name & '_Pre')
      :mdssupptype default
      :mdssuppfunc default
      sel spref with styp 'HVAC-REST' spec /MDS
      handle (42,64) (42,66)
        spref /MDS/.HVAC-REST.1
      endhandle
    else
    new atta sel spref with styp 'HVAC-REST' spec /MDS
    handle (42,64) (42,66)
        spref /MDS/.HVAC-REST.1
    endhandle
    endif
    SPKBRK false
    !writeHVAC = !!ce

    -- set stex for atta
    !sAtta = !!ce
    Call !!mdsTransport(!sAtta,!name)
    !!mdsDacControl(true)
    despar 100mm 100mm

    --> Modified -<wd>- 4nov1998
    if (!!mdsFT14.support.alias inset ('DT01','DT02','DT03','DT04')) then
      if (!fromAtta.not()) then
        fconn
      endif
      ori and p3 is d wrt /*
    else
      -- P30 for KJB HVAC and P61 for CADC
      fconn and p30 is p30 of prev
      --xxx        handle (61,1) (42,94) (2,201)
      --xxx          fconn and p20 is p61 of prev
      --xxx        endhandle
    endif
    --< Modified -<wd>- 4nov1998

    !!mdsSetHvac(!readHVAC,!writeHVAC)
    !!mdsSelLstu(!!ce)
    -- Always add atta to datum cross bar
    !!mdsFT14.support.bars[1][1] = !!ce.name.dbref()
    !!mdsFT14.support.atta.append(!!ce)
    !!ce = !writeHVAC
    Call !!mdsCrDatFt14()
    if (!fromAtta) then
      !!mdsSetDatumAtta(!!ft14)
    endif
  endif


  -- set focus to the distance text gadget
  !!mdsFT14.dist.setFocus()

  !!kRestoreUnits(!currentunits)
  !!mdsDacControl(false)
  -- End function
endfunction
