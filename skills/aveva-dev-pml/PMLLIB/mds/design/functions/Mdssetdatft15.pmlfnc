--
-- File:  Mdssetdatft15.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDAT139
--
-- Author:  Wayne Dodwell
-- Created:  Tuesday 30th September 1997
--
--
-- Description:
-- Sets Datum Atta on Pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatFt15()

  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !support  = !!mdsFT15.support
  !datum    = !support.datum
  !name     = !support.stru.name
  !fromAtta = !!mdsFT15.support.preliminaryStore.set()

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    return
  endif

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif

  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998

  if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of datum pipe','PIPE').not())then
    return
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsFT15.support.idcomp = !idcomp
  !!mdsFT15.support.idbran = !idbran

  -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
  -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

  !currcomp = !!ce
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!hdir neq U and !hdir neq D ) then
    if (!!mdsgradient(!currcomp)) then
      !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
      !!ce = !cecomp
      if !fromAtta then
        !!mdsCancelSupp(!!mdsFT15)
      endif
      return
    endif
  endif

  -- Change callback on apply button then show ancillary form
  !!mdsAncill.action.clear()
  !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT15)|
  !!mdsAncill.action[2] = |Call !!mdsCrDatFt15()|

  !!kShowForm(!!mdsAncill)
  !!mdsIAncill('FT15')


  -- set focus to the distance text gadget
  !!mdsFT15.dist.setFocus()

endfunction
