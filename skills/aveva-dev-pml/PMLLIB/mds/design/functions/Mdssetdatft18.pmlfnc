--
-- File:    Mdssetdatft18.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MDATPS142
--
-- Author:    Wayne Dodwell
-- Created:   Wednesday 27 August 1997
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatFt18()

  -- Find current units and set the distance unit to metric

  !currentunits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType    = !!mdsoptions.pipes
  !datum       = !!mdsFT18.support.datum
  !name        = !!mdsFT18.support.stru.name
  !alias       = !!mdsFT18.support.alias
  !fromAtta    = !!mdsFT18.support.preliminaryStore.set()

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Select tube
  if (!alias eq 'FT18') then
    if (!tubeType eq 'FTUB')then
      !pipeType = 'lined section'
    else
      !pipeType = 'tube'
    endif
    !iDType = 'pipe'
    !purp = 'PIPE'
  elseif (!alias inset ('CT08','CT11')) then
    !pipeType = 'tray section'
    !iDType = 'cable rack'
    !purp = 'TRAY'
  endif

  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998

  if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of datum $!pipeType','$!purp').not())then
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsFT18.support.idcomp = !idcomp
  !!mdsFT18.support.idbran = !idbran

  if (!alias eq 'FT18') then

    -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
    -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

    if (!!ce.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
    endif


    -- Check that the :MDSHv attribute of the template zone to see if horizontal
    -- or vertical pipes are allowed

    if !!mdschecktemp('/MDS/FRAMES/FT18-HORI','$!hdir').not() then
      !!kRestoreUnits(!currentunits)
      if !fromAtta then



        !!mdsCancelSupp(!!mdsFT18)
      endif
      return
    endif

  endif

  -- Change callback on apply button then show ancillary form
  if (!alias eq 'FT18') then
    !!mdsAncill.action.clear()
    !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT18)|
    !!mdsAncill.action[2] = |Call !!mdsCrDatFt18()|
    !!kShowForm(!!mdsAncill)
    !!mdsIAncill('FT18')
  elseif (!alias eq 'CT08') then
    !!mdsAncill.action.clear()
    !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT18)|
    !!mdsAncill.action[2] = |Call !!mdsCrDatFt18()|
    !!kShowForm(!!mdsAncill)
    !!mdsIAncill('CT08')
  elseif (!alias eq 'CT11') then
    !!mdsAncill.action.clear()
    !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT18)|
    !!mdsAncill.action[2] = |Call !!mdsCrDatFt18()|
    !!kShowForm(!!mdsAncill)
    !!mdsIAncill('CT11')
  endif







  -- Reset Units
  !!kRestoreUnits(!currentunits)

  -- set focus to the distance text gadget
  !!mdsFT18.dist.setFocus()

endfunction
