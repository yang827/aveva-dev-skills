--
-- File:  Mdssetdatft19.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATPS143
--
-- Author:  Wayne Dodwell
-- Created:  Monday 15 September 1997
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatFt19()

  -- Find current units and set the distance unit to metric

  !currentunits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType    = !!mdsoptions.pipes
  !datum       = !!mdsFT19.support.datum
  !name        = !!mdsFT19.support.stru.name
  !alias       = !!mdsFT19.support.alias
  !fromAtta    = !!mdsFT19.support.preliminaryStore.set()

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Select tube
  if (!alias eq 'FT19') then
    if (!tubeType eq 'FTUB')then
      !pipeType = 'lined section'
    else
      !pipeType = 'tube'
    endif
    !iDType = 'pipe'
    !purp = 'PIPE'
  elseif (!alias inset ('CT07','CT10')) then
    !pipeType = 'tray section'
    !iDType = 'cable rack'
    !purp = 'TRAY'
  endif

  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998

  if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of datum $!pipeType','$!purp').not())then
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsFT19.support.idcomp = !idcomp
  !!mdsFT19.support.idbran = !idbran

  if (!alias eq 'FT19') then

    -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
    -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

    !currcomp = !!ce
    if (!!ce.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
    endif

    if (!hdir neq U and !hdir neq D ) then
      if (!!mdsgradient(!currcomp)) then
        !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsoptions.slope.val)')
        !!ce = !cecomp
        !!kRestoreUnits(!currentunits)
        if !fromAtta then
          !!mdsCancelSupp(!!mdsFT19)
        endif
        return
      endif
    endif

    -- Check that the :MDSHv attribute of the template zone to see if horizontal
    -- or vertical pipes are allowed

    if !!mdschecktemp('/MDS/FRAMES/FT19-HORI','$!hdir').not() then
      !!kRestoreUnits(!currentunits)
      if !fromAtta then



        !!mdsCancelSupp(!!mdsFT19)
      endif
      return
    endif

  endif

  -- Change callback on apply button then show ancillary form
  if (!alias eq 'FT19') then
    !!mdsAncill.action.clear()
    !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT19)|
    !!mdsAncill.action[2] = |Call !!mdsCrDatFt19()|
    !!kShowForm(!!mdsAncill)
    !!mdsIAncill('FT19')
  elseif (!alias eq 'CT07') then
    !!mdsAncill.action.clear()
    !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT19)|
    !!mdsAncill.action[2] = |Call !!mdsCrDatFt19()|
    !!kShowForm(!!mdsAncill)
    !!mdsIAncill('CT07')






  elseif (!alias eq 'CT10') then
    !!mdsAncill.action.clear()
    !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT19)|
    !!mdsAncill.action[2] = |Call !!mdsCrDatFt19()|
    !!kShowForm(!!mdsAncill)
    !!mdsIAncill('CT10')
  endif

  -- Reset Units
  !!kRestoreUnits(!currentunits)

  -- set focus to the distance text gadget
  !!mdsFT19.dist.setFocus()

endfunction
