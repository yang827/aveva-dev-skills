--
-- File:  Mdssetdatft29.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATPS142
--
-- Author:  Wayne Dodwell
-- Created:  Wednesday 27 August 1997
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatFt29()

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType    = !!mdsOptions.pipes
  !datum       = !!mdsFT29.support.datum
  !name        = !!mdsFT29.support.stru.name
  !fromAtta    = !!mdsFT29.support.preliminaryStore.set()

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif

  !purp = 'PIPE'

  label /again

  if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of datum $!pipeType','$!purp').not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsFT29.support.idcomp = !idcomp
  !!mdsFT29.support.idbran = !idbran

  -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
  -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.
  --<wd>dec2004 -- Vertical Pipes now included
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif


  -- Check that the :MDSHv attribute of the template zone to see if horizontal
  -- or vertical pipes are allowed
  !template = '/MDS/FRAMES/FT29'

  if !!mdschecktemp('$!template','$!hdir').not() then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Check if the bore of the identified pipe does not exceed the maximum allowed bore
  ------------------------------------------------------------------------------
  -- mjb >>> 05.05.06 <mds12>
  !checkBore = object MDSCHECKFRAME()
  --!checkBore = object MDSCHECKSTD()
  -- mjb <<< 05.05.06 end of mod
  ------------------------------------------------------------------------------
  if !checkBore.bores('$!template').not() then
    !!kRestoreUnits(!currentUnits)
    !bore = abore
    handle any
      !bore = hbore
    endhandle
    !minBore = :MDSMinBore of $!template
    !maxBore = :MDSMaxBore of $!template
    !minBore = $!minBore
    !maxBore = $!maxBore
    !!kRestoreUnits(!currentUnits)
    !uMinBore = !minBore.nearestbore()
    !uMaxBore = !maxBore.nearestbore()
    !!alert.error('Standard not available at this bore! ($!bore). Minimum ($!uMinBore) Maximum ($!uMaxBore)')
    if !fromAtta then
      !!mdsCancelSupp(!!mdsFT29)
    endif
    return
  endif

  -- Change callback on apply button then show ancillary form
  !!mdsAncill.action.clear()
  !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT29)|
  !!mdsAncill.action[2] = |Call !!mdsCrDatFt29()|
  !!kShowForm(!!mdsAncill)
  !!mdsIAncill('FT29')

  -- Reset Units

  !!kRestoreUnits(!currentUnits)

  -- set focus to the distance text gadget
  !!mdsFT29.dist.setFocus()

endfunction
