--
-- File:  Mdssetdatft30.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATPS133
--
-- Author:  I.osborne
-- Created:  Thu Jul 03
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatft30()

  -- Force into forwards mode
  FORWARDS
  !currentunits = !!kgetsetunits()
  -- Initialise variables
  !support  = !!mdsft30.support
  !datum    = !support.datum
  !name     = !support.stru.name

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    return
  endif

  -- Select Elbo to support

  prompt off
  prompt load escape 'Identify elbow to support'
  ID elbo bend @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return false
  endhandle
  prompt on

  !elbow = !!ce
  -- Check to see if the elbo is of the correct type for a connection
  !patest = pa dir wrt /*
  !pltest = pl dir wrt /*
  if !patest.string().before(' WRT').eq('U').not() and !pltest.string().before(' WRT').eq('U').not() and !patest.string().before(' WRT').eq('Z').not() and !pltest.string().before(' WRT').eq('Z').not() then
    !!alert.error('The identified elbow is not suitable for this support.')
    !!kRestoreUnits(!currentunits)
    return
  endif
  !!mdsDacControl(true)


  if !!mdsSelectComp(!!ce.type).not() then
    !!alert.error('Unable to find a suitable elbow in the current specification')
    !!kRestoreUnits(!currentunits)
    !!mdsDacControl(false)
    return
  endif


  -- Select tube to support

  label /again

  prompt off
  prompt load escape 'Identify tube to support'
  ID tube @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return false
  endhandle
  prompt on

  if (!!ce.type eq 'BRAN') then
    pin 9 copy ph
    var !p9dir pin 9 dir wrt /*
    if ('$!p9dir' neq |U|) and ('$!p9dir' neq |D|) then
      !!alert.error('Identified tube must be vertical')
      golabel /again
    endif
    !!mdsResetPins(9,9)
  else
    !pltest = pl dir wrt /*
    if ('$!pltest' eq |U WRT /*|) or ('$!pltest' eq |D WRT /*|) then
    else
      !!alert.error('Identified tube must be vertical')
      golabel /again
    endif
  endif

  !tube = !!ce

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsft30.support.idcomp = !idcomp
  !!mdsft30.support.idbran = !idbran

  !!mdsft30.support.atta[1] = !elbow
  !!mdsft30.support.atta[2] = !tube

  -- Change callback on apply button then show ancillary form
  !!mdsAncill.action.clear()
  !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsft30)|
  !!mdsAncill.action[2] = |Call !!mdsCrDatft30()|

  !!kShowForm(!!mdsAncill)
  !!mdsIAncill('FT30')

  -- set focus to the distance text gadget
  !!mdsft30.dist.setFocus()

  -- End function
endfunction
