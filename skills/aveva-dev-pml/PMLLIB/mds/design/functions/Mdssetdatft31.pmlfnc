--
-- File:  Mdssetdatft31.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATPS127
--
-- Author:  I.osborne
-- Created:  Mon Jun 23
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatFt31()

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType    = !!mdsOptions.pipes
  !datum       = !!mdsFT31.support.datum
  !name        = !!mdsFT31.support.stru.name

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif
  !idtype = 'pipe'
  !purp = 'PIPE'

  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998

  if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of datum $!idtype', '$!purp').not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsFT31.support.idcomp = !idcomp
  !!mdsFT31.support.idbran = !idbran

  -- This standard is only availble for uninsulated lines so check

  var !ceInsu insu
  if !ceInsu.real().gt(0) then
    !!alert.error('This standard is only available for uninsulated lines. The identified line has $!ceInsu of insulation.')
    !!kRestoreUnits(!currentUnits)
    return
  endif
$(
  ------------------------------
  --> Modified - <wd> - 14sep1998
  !write = STRING()
  !lock  = STRING()
  if (!!kcheckwrite(!!ce, !lock , !write).not()) then
    -- READ ONLY Access to the '!idtype'
    if (!write.eq('R')) then
      !!alert.error('The Identified $!idtype is in a READ ONLY Database. Select another $!idtype.')
      golabel /again
      -- WRITE Access to the '!idtype', BUT it is LOCKED
    elseif (!lock.eq('Locked')) then
      !!alert.error('The Identified $!idtype is LOCKED. Select another $!idtype.')
      golabel /again
    endif
  endif
  --< Modified - <wd> - 14sep1998
  ------------------------------
$)

  -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
  -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

$(
  --<tm> fix to open up the angle to be in line with the pipe    if (!hdir neq U and !hdir neq D ) then
  if (!!mdsgradient(!currcomp)) then
    !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
    !!ce = !cecomp
    !!kRestoreUnits(!currentUnits)
    return
  endif
endif
$)

-- Check that the :MDSHv attribute of the template zone to see if horizontal
-- or vertical pipes are allowed

!template = '/MDS/FRAMES/FT31'

if !!mdschecktemp('$!template','$!hdir').not() then
  !!kRestoreUnits(!currentUnits)
  return
endif

-- Check if the bore of the identified pipe does not exceed the maximum allowed bore
------------------------------------------------------------------------------
-- mjb >>> 05.05.06 <mds12>
!checkBore = object MDSCHECKFRAME()
--!checkBore = object MDSCHECKSTD()
-- mjb <<< 05.05.06 end of mod
------------------------------------------------------------------------------
if !checkBore.bores('$!template').not() then
  !!kRestoreUnits(!currentUnits)
  !bore = abore
  handle any
    !bore = hbore
  endhandle
  !minBore = :MDSMinBore of $!template
  !maxBore = :MDSMaxBore of $!template
  !minBore = $!minBore
  !maxBore = $!maxBore
  !!kRestoreUnits(!currentUnits)
  !uMinBore = !minBore.nearestbore()
  !uMaxBore = !maxBore.nearestbore()
  !!alert.error('Standard not available at this bore! ($!bore). Minimum ($!uMinBore) Maximum ($!uMaxBore)')
  return
endif

-- Change callback on apply button then show ancillary form
!!mdsAncill.action.clear()
!!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT31)|
!!mdsAncill.action[2] = |Call !!mdsCrDatFt31()|
!!kShowForm(!!mdsAncill)
!!mdsIAncill('FT31')


-- Reset Units

!!kRestoreUnits(!currentUnits)

-- set focus to the distance text gadget
!!mdsFT31.dist.setFocus()
-- End function
endfunction
