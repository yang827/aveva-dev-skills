--
-- File:		Mdssetdatft33.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS138
--
-- Author:		I.Osborne
-- Created:		Tue Jul 22
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetDatFt33()

   !currentunits = !!kgetsetunits()

-- Force into forwards mode
   FORWARDS

  -- Initialise variables
    !TubeType = !!MdsOptions.Pipes
    !Datum    = !!MdsFt33.Support.Datum
    !Name     = !!MdsFt33.Support.Stru.name
    !Namn     = !!MdsFt33.Support.Stru.Namn
    !Alias    = !!MdsFt33.Support.Alias

    !cecomp = !!CE

    if (!Datum.set()) then
      !!Alert.error('Datum atta for support $!Name already exists')
      !!kRestoreUnits(!currentunits)
      return
    endif

  -- Select tube

  if (!TubeType eq 'FTUB')then
    !PipeType = 'lined section'
  else
    !PipeType = 'tube'
  endif
  !IDType = 'pipe'
  !Purp = 'PIPE'

--> Modified - <wd> - 33sep1998
    label /again
--< Modified - <wd> - 33sep1998

  if (!!MdsIdTube('$!TubeType', 'Identify $!PipeType of datum $!IDtype','$!PURP').not())then
      !!kRestoreUnits(!currentunits)
    return
  endif

-- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsft33.support.idcomp = !idcomp
  !!MdsFt33.support.idbran = !idbran

-- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
-- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

  !currcomp = !!ce
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!hdir neq U and !hdir neq D ) then
    if (!!Mdsgradient(!currcomp)) then
      !!Alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!Mdsoptions.slope.val)')
      !!ce = !cecomp
    !!kRestoreUnits(!currentunits)
      return
    endif
  endif

-- If there is insulation then abort creation

  var !Insu insu
  if !Insu.real().gt(0) then
    !!Alert.message ('The pipe identified is insulated and is not allowable on this support type')
    !!ce = !cecomp
    !!kRestoreUnits(!currentunits)
    return
  endif

-- Check that the :MDSHv attribute of the template zone to see if horizontal
-- or vertical pipes are allowed

 if !!Mdschecktemp('/MDS/FRAMES/FT33','$!Hdir').not() then
    !!kRestoreUnits(!currentunits)
   return
 endif


-- Change callback on apply button then show ancillary form
    !!MdsAncill.Action.Clear()
    !!MdsAncill.Action[1] = |Call !!MdsCrAncill(!!MdsFt33)|
    !!MdsAncill.Action[2] = |Call !!MdsCrDatFt33()|
    !!KShowForm(!!MdsAncill)
    !!MdsIAncill('FT33')

-- set focus to the distance text gadget
   !!Mdsft33.Dist.SetFocus()

   !!kRestoreUnits(!currentunits)
   !!MdsDacControl(false)

-- End function
endfunction

-- End of file Mdssetdatft33.pml
