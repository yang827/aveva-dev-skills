--
-- File:  Mdssetdatft35.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATPS131
--
-- Author:  I.osborne
-- Created:  Tue Jul 01
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatft35()

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !support  = !!mdsFT35.support
  !datum    = !support.datum
  !name     = !support.stru.name

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif
  !purp = 'PIPE'

  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998

  if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of datum pipe','$!purp').not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsFT35.support.idcomp = !idcomp
  !!mdsFT35.support.idbran = !idbran

  -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
  -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  -- Check that the :MDSHv attribute of the template zone to see if horizontal
  -- or vertical pipes are allowed

  !template = '/MDS/FRAMES/FT35'

  if !!mdschecktemp('$!template','$!hdir').not() then
    !!kRestoreUnits(!currentUnits)
    return
  endif
  ------------------------------------------------------------------------------
  -- mjb >>> 05.05.06 <mds12>
  !checkBore = object MDSCHECKFRAME()
  --!checkBore = object MDSCHECKSTD()
  -- mjb <<< 05.05.06 end of mod
  ------------------------------------------------------------------------------
  if !checkBore.bores('$!template').not() then
    !!kRestoreUnits(!currentUnits)
    !bore = abore
    handle any
      !bore = hbore
    endhandle
    -- $P ** !minBore = :MDSMinBore of $!template
    !minBore = :MDSMinBore of $!template
    -- $P ** !maxBore = :MDSMaxBore of $!template
    !maxBore = :MDSMaxBore of $!template
    !minBore = $!minBore
    !maxBore = $!maxBore
    !!kRestoreUnits(!currentUnits)
    !uMinBore = !minBore.nearestbore()
    !uMaxBore = !maxBore.nearestbore()
    !!alert.error('Standard not available at this bore! ($!bore). Minimum ($!uMinBore) Maximum ($!uMaxBore)')
    return
  endif

  -- Change callback on apply button then show ancillary form

  !!mdsAncill.action.clear()
  !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT35)|
  !!mdsAncill.action[2] = |Call !!mdsCrDatft35()|
  !!kShowForm(!!mdsAncill)
  !!mdsIAncill('FT35')

  -- Reset Units

  !!kRestoreUnits(!currentUnits)

  -- set focus to the distance text gadget
  !!mdsFT35.dist.setFocus()

endfunction
