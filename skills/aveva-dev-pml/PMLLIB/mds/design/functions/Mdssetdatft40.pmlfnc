--
-- File:  Mdssetdatft40.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATPS135
--
-- Author:  Wayne Dodwell
-- Created:  Monday 21 July 1997
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatft40()

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !support  = !!mdsft40.support
  !datum    = !support.datum
  !name     = !support.stru.name

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    return
  endif

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif

  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998

  if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of datum pipe','PIPE').not())then
    return
  endif

  -- In case we id a different element when second pick set the first id
  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsft40.support.idcomp = !idcomp
  !!mdsft40.support.idbran = !idbran

$(
  ------------------------------
  --> Modified - <wd> - 14sep1998
  !write = STRING()
  !lock  = STRING()
  if (!!kcheckwrite(!!ce, !lock , !write).not()) then
    -- READ ONLY Access to the PIPE
    if (!write.eq('R')) then
      !!alert.error('The Identified PIPE is in a READ ONLY Database. Select another PIPE.')
      golabel /again
      -- WRITE Access to the PIPE, BUT it is LOCKED
    elseif (!lock.eq('Locked')) then
      !!alert.error('The Identified PIPE is LOCKED. Select another PIPE.')
      golabel /again
    endif
  endif
  --< Modified - <wd> - 14sep1998
  ------------------------------
$)

  -- Check that PIPE is NOT Vertical and within the Maximum Slope Allowed,
  -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.
  -------------------------------------------------
  --<wd>dec2004
  -- Vertical Pipes now included
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  -------------------------------------------------
  --<wd>dec2004 -- :MDSHV and Bore Checks added
  -- Check that the :MDSHv attribute of the template zone to see if horizontal
  -- or vertical pipes are allowed
  !template = '/MDS/FRAMES/FT40'

  if !!mdschecktemp('$!template','$!hdir').not() then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Check if the bore of the identified pipe does not exceed the maximum allowed bore
  ------------------------------------------------------------------------------
  -- mjb >>> 05.05.06 <mds12>
  !checkBore = object MDSCHECKFRAME()
  --!checkBore = object MDSCHECKSTD()
  -- mjb <<< 05.05.06 end of mod
  ------------------------------------------------------------------------------
  if !checkBore.bores('$!template').not() then
    !!kRestoreUnits(!currentUnits)
    !bore = abore
    handle any
      !bore = hbore
    endhandle
    !minbore = :mdsminbore of $!template
    !maxbore = :mdsmaxbore of $!template
    !minbore = $!minbore
    !maxbore = $!maxbore
    !!kRestoreUnits(!currentUnits)
    !uMinBore = !minbore.nearestbore()
    !uMaxBore = !maxbore.nearestbore()
    !!alert.error('Standard not available at this bore! ($!bore). Minimum ($!uMinBore) Maximum ($!uMaxBore)')
    return
  endif
  --<wd>dec2004
  -------------------------------------------------


  -- *********************************************************************************

  -- Change callback on apply button then show ancillary form
  !!mdsAncill.action.clear()
  !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsft40)|
  !!mdsAncill.action[2] = |Call !!mdsCrDatft40()|

  !!kShowForm(!!mdsAncill)
  !!mdsIAncill('FT40')


  -- Set focus to distance text gadget
  !!mdsft40.dist.setFocus()
  handle any
    -- incase dont exist
  endhandle


  -- set focus to the distance text gadget
  !!mdsft40.dist.setFocus()

  !!ce = !cecomp

endfunction
