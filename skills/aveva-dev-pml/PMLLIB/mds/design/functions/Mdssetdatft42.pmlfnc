--
-- File:		Mdssetdatft42.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS132
--
-- Author:		I.Osborne
-- Created:		Wed Jul 02
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetDatFt42()

-- Find current units and set the distance unit to metric
    !currentunits = !!KGetSetUnits()

-- Force into forwards mode
   FORWARDS

  -- Initialise variables
    !TubeType = !!MdsOptions.Pipes
    !Support  = !!MdsFt42.Support
    !Datum    = !Support.Datum
    !Name     = !Support.Stru.name
    !Namn     = !!MdsFt42.Support.Stru.Namn
    !Alias    = !!MdsFt42.Support.Alias

    !cecomp = !!CE

    if (!Datum.set()) then
      !!Alert.error('Datum atta for support $!Name already exists')
      !!kRestoreUnits(!currentunits)
      return
    endif

  -- Select tube

  if (!TubeType eq 'FTUB')then
    !PipeType = 'lined section'
  else
    !PipeType = 'tube'
  endif
  !IDType = 'pipe'
  !Purp = 'PIPE'

--> Modified - <wd> - 14sep1998
    label /again
--< Modified - <wd> - 14sep1998

  if (!!MdsIdTube('$!TubeType', 'Identify $!PipeType of datum $!IDType','$!PURP').not())then
    !!kRestoreUnits(!currentunits)
    return
  endif

-- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsft42.support.idcomp = !idcomp
  !!MdsFt42.support.idbran = !idbran

$(
------------------------------
--> Modified - <wd> - 14sep1998
    !write = STRING()
    !lock  = STRING()
    if (!!kcheckwrite(!!ce, !lock , !write).not()) then
-- READ ONLY Access to the $!idtype
      if (!write.eq('R')) then
        !!alert.error('The Identified $!idtype is in a READ ONLY Database. Select another $!idtype')
        golabel /again
-- WRITE Access to the $!idtype, BUT it is LOCKED
      elseif (!lock.eq('Locked')) then
        !!alert.error('The Identified $!idtype is LOCKED. Select another $!idtype')
        golabel /again
      endif
    endif
--< Modified - <wd> - 14sep1998
------------------------------
$)

-- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
-- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

  !currcomp = !!ce
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!hdir neq U and !hdir neq D ) then
    if (!!Mdsgradient(!currcomp)) then
      !!Alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!Mdsoptions.slope.val)')
      !!ce = !cecomp
      !!kRestoreUnits(!currentunits)
      return
    endif
  endif

-- Check that the :MDSHv attribute of the template zone to see if horizontal
-- or vertical pipes are allowed

  if !!Mdschecktemp('/MDS/FRAMES/$!Alias','$!Hdir').not() then
    !!kRestoreUnits(!currentunits)
    return
  endif

-- Check if the bore of the identified pipe does not exceed the maximum allowed bore

 !Template = '/MDS/FRAMES/$!Alias'

------------------------------------------------------------------------------
-- mjb >>> 08.05.06 <mds12>
   !CheckBore = object mdscheckframe()
   --!CheckBore = object Mdscheckstd()
-- mjb <<< 08.05.06 end of mod
------------------------------------------------------------------------------
  if !CheckBore.bores('$!Template').not() then
    !!kRestoreUnits(!currentunits)
    !Bore = abore
      handle any
        !Bore = hbore
      endhandle
    !MinBore = :MDSMinBore of $!Template
    !MaxBore = :MDSMaxBore of $!Template
    if(!currentunits.isImperialSavedBore().not()) then
      SMinBore = !MinBore
     !SMaxBore = !MaxBore
     else
    !SMinBore = ( DIST ( NOMBORE ( false , $!MinBore ) , false , false , true , 4 , false ) )
     !SMaxBore = ( DIST ( NOMBORE ( false , $!MaxBore ) , false , false , true , 4 , false ) )
    endif
    !!Alert.Error('Standard not available at this bore! ($!Bore). Minimum ($!SMinBore) Maximum ($!SMaxBore)')
      -- !!Alert.Error('Standard not available at this bore! ($!Bore). Minimum ($!MinBore) Maximum ($!MaxBore)')
    !!kRestoreUnits(!currentunits)
    return
   endif

-- Change callback on apply button then show ancillary form

  !!MdsAncill.Action.Clear()
  !!MdsAncill.Action[1] = |Call !!MdsCrAncill(!!MdsFt42)|
  !!MdsAncill.Action[2] = |Call !!MdsCrDatFt42()|
  !!KShowForm(!!MdsAncill)
  !!MdsIAncill('$!Alias')

-- Reset Units
   !!kRestoreUnits(!currentunits)

-- set focus to the distance text gadget
   !!Mdsft42.Dist.SetFocus()
   !!MdsDacControl(false)

-- End function
endfunction
