--
-- File:  Mdssetdatft43.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATPS131
--
-- Author:  I.osborne
-- Created:  Tue Jul 01
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatFT43()

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !support  = !!mdsFT43.support
  !datum    = !support.datum
  !name     = !support.stru.name
  !alias    = !!mdsFT43.support.alias

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Select tube
  if (!alias eq 'FT43' or !alias eq 'FT37') then
    if (!tubeType eq 'FTUB')then
      !pipeType = 'lined section'
    else
      !pipeType = 'tube'
    endif
    !idtype = 'pipe'
    !purp = 'PIPE'
  elseif (!alias eq 'CT04') then
    !pipeType = 'tray section'
    !idtype = 'cable rack'
    !purp = 'TRAY'
  endif

  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998

  if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of datum pipe','$!purp').not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsFT43.support.idcomp = !idcomp
  !!mdsFT43.support.idbran = !idbran

  if (!alias eq 'FT43' or !alias eq 'FT37') then

    -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
    -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

    !currcomp = !!ce
    if (!!ce.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
    endif

    if (!hdir neq U and !hdir neq D ) then
      if (!!mdsgradient(!currcomp)) then
        !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
        !!ce = !cecomp
        !!kRestoreUnits(!currentUnits)
        return
      endif
    endif

    -- Check that the :MDSHv attribute of the template zone to see if horizontal
    -- or vertical pipes are allowed

    if !!mdschecktemp('/MDS/FRAMES/$!alias','$!hdir').not() then
      !!kRestoreUnits(!currentUnits)
      return
    endif

  elseif (!alias eq 'CT04') then

    -- Check that RACK is within the Maximum Slope Allowed,
    -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

    !currcomp = !!ce
    if (!!ce.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
    endif

    if (!hdir neq U and !hdir neq D ) then
      if (!!mdsgradient(!currcomp)) then
        !!alert.message ('The rack identified is not within the maximum slope for horizontal rack as defined in the application defaults ($!!mdsOptions.slope.val)')
        !!ce = !cecomp
        !!kRestoreUnits(!currentUnits)
        return
      endif
    endif

    -- Check that the :MDSHv attribute of the template zone to see if horizontal,
    -- vertical pipes or both are allowed
    if !!mdschecktemp('/MDS/FRAMES/$!alias','$!hdir').not() then
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endif

  -- Change callback on apply button then show ancillary form
  if (!alias eq 'FT43' or !alias eq 'FT37') then
    !!mdsAncill.action.clear()
    !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsFT43)|
    !!mdsAncill.action[2] = |Call !!mdsCrDatFT43()|
    !!kShowForm(!!mdsAncill)
    !!mdsIAncill('$!alias')
  elseif (!alias eq 'CT04') then
    -- No ancillaries on cable racks so go into the CrDat straight away
    -- after creating atta set setting the attributes
    --------------------------------------------------------------------------
    --!width  = !!mdsSetWid()
    -- Store the Current/Identified Element DBREF
    !xce = !currcomp
    new atta sel spref with styp 'RACK-REST' spec /MDS
    SPKBRK TRUE
    !order = order
    -- The Atta Order number in the BRANCH will always be greater than > 1 if FTUBS are used
    !xat = !!ce
    if (!currcomp.type.eq('FTUB')) then
      !!ce    = !currcomp
      !width  = !!mdsSetWid()
      !height = 0
    else
      if (!order.eq(1)) then
        dist 100
      else
        dist 100 from pl of prev
      endif

      !!ce = !currcomp
      if (!currcomp.type.eq('BRAN')) then
        head
        !hdir = hdir wrt /*
        ileave tube
        !tori = ori wrt /*
        !odir = !tori.string().after('/* ')
        !ori  = 'ori Y is ' & !hdir & ' ' & !odir
        !!ce = !xat
        ori $!ori
      else
        !!ce  = !currcomp
        !hdir = ldir wrt /*
        ileave tube
        !tori = ori wrt /*
        !odir = !tori.string().after('/* ')
        !ori  = 'ori Y is ' & !hdir & ' ' & !odir
        !!ce  = !xat
        ori $!ori
      endif
      !!ce = !currcomp
      !height = 0
      !width  = !!mdstraywidth(!xat, !xce, !height)
    endif
    !!ce = !xat

    --      new atta sel spref with styp 'RACK-REST' spec /MDS
    --      SPKBRK TRUE
    ---------------------------------------------------------------------------

    -- set stex for atta
    !sAtta = !!ce
    Call !!mdsTransport(!sAtta,!name)

    ---------------------------------------------------------------------------
    -- despar $!width $!height
    !!mdsDacControl(true)
    despar $!width $!height
    --despar $!width 0

    if (!currcomp.type.eq('FTUB')) then
      fconn and p30 is p30 of prev
    else
      --  if (!order.eq(1)) then
      fconn
      ori $!ori
      sel lstu
      --  endif
    endif
    ---------------------------------------------------------------------------

    --fconn and p30 is p30 of prev
    !!mdsSelLstu(!!ce)
    -- Always add atta to datum cross bar
    !!mdsFT43.support.bars[1][1] = !!ce.name.dbref()
    !!mdsFT43.support.atta.append(!!ce)
    !!mdsDacControl(false)
    Call !!mdsCrDatFT43()
  endif

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- set focus to the distance text gadget
  !!mdsFT43.dist.setFocus()

endfunction
