--
-- File:		MdssetdatFT47.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS147
--
-- Author:		Wayne Dodwell
-- Created:		Monday 10th May 2004
--
--
-- Description:
-- Sets Datum Atta on the VALVE type FLANGE
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!mdssetdatft47()

-- Force into forwards mode
    forwards

-- Save Current Units
    !currentunits = !!kgetsetunits()

-- Initialise variables
    !support = !!mdsft47.support
    !stru    = !support.stru
    !datum   = !support.datum
    !name    = !support.stru.name
    !cecomp  = !!ce

    if (!datum.set()) then
      !!alert.error('Datum atta for support $!Name already exists')
      return
    endif

-- Identify a Flanged Valve type Component from the list of PDMS "Valve" like GTYPES i.e.- VALV, VTWA, VFWA, INST or PCOM
    label /identify
    prompt off
    prompt load escape |Identify Flange component to support|
--    id FLAN FBLI VALV VTWA VFWA INST PCOM  @
    id FLAN FBLI @
    handle (61,528)
      prompt on
      !!ce = !stru
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    prompt dismiss
    prompt on
    !pick = !!ce
    !ptyp = !pick.fulltype

-- Check if a VALID "Flange/Valve" type Component has been Identified

-- Check the Arrive Connection Type is either 'Flanged' or 'Wafer Flanged'
    if ( (!pick.acon.match('F').eq(1).not()) and (!pick.acon.match('WF').eq(1).not()) ) then
      !acon = FALSE
    else
      !acon = TRUE
    endif
-- Check the Leave Connection Type is either 'Flanged' or 'Wafer Flanged'
    if ( (!pick.lcon.match('F').eq(1).not()) and (!pick.lcon.match('WF').eq(1).not()) ) then
      !lcon = FALSE
    else
      !lcon = TRUE
    endif
-- Error if both the Arrive and Leave Connections are NOT 'Flanged' or 'Wafer Flanged'
    if ((!acon.not()) and (!lcon.not())) then
      !!alert.error('Identified ''$!ptyp'' does NOT have Flange type connections. Please identify a Flange component to support.' )
      golabel /identify
    endif

    label /again

-- In case we id a different element when second pick set the first id
    if (!!ce.type.eq('BRAN')) then
      !idbran = !!ce
    else
      !idbran = !!ce.owner
    endif
    !idcomp = !!ce
    !!mdsft47.support.idcomp = !idcomp
    !!mdsft47.support.idbran = !idbran


$(
------------------------------
--> Modified - <wd> - 14sep1998
    !write = STRING()
    !lock  = STRING()
    if (!!kcheckwrite(!!ce, !lock , !write).not()) then
-- READ ONLY Access to the PIPE
      if (!write.eq('R')) then
        !!alert.error('The Identified PIPE is in a READ ONLY Database. Select another PIPE.')
        golabel /again
-- WRITE Access to the PIPE, BUT it is LOCKED
      elseif (!lock.eq('Locked')) then
        !!alert.error('The Identified PIPE is LOCKED. Select another PIPE.')
        golabel /again
      endif
    endif
--< Modified - <wd> - 14sep1998
------------------------------
$)

-- Check the identified PIPE is within the Maximum Slope Allowed,
-- for Horizontal Pipes, displayed on the 'Settings>Options...' form.
    !currcomp = !!ce
    if !!ce.owner.:mdstrun.not() then
      if (!!mdsgradient(!currcomp)) then
        !!alert.message ('The identified ''$!ptyp'' is NOT within the allowable slope for HORIZONTAL pipes, as defined in the application defaults (i.e. $!!Mdsoptions.slope.val)')
        !!ce = !cecomp
        golabel /identify
      endif
    endif

-- Automatically Create the DATUM Atta < a PIPE REST > and the SREF Atta required on
-- the MDS Frame Support Type 'FT47' in the CORRECT Location i.e. the CENTRE of the Connected GASKET
    units mm bore
    units mm dist
    !!mdscrdatft47()

-- Provisionally Always Locate the DATUM and SREF Attas IF POSSIBLE at the Arrive of the Identified Component.
-- Alternatively Locate the DATUM and SREF Attas at the Leave of the Identified Component if the Arrive is NOT suitable.
    !!mdsft47.flange = !pick
    !support  = !!mdsft47.support
    !datum    = !support.datum
    !srefname = !support.stru.name & '/' & 'SREF'
    !srefatta = !srefname.dbref()

    if (!acon) then
-- When the Arrive is a Flange type Connection
      !support.datum.position = !pick.apos
      !srefatta.position      = !pick.apos
      !!ce = !support.datum
-- Navigate to the GASKET if Possible
      previous 2
      handle ANY
-- Do Nothing -  Leave DATUM and SREF Attas where they are.
      elsehandle NONE
-- If type is a GASKET - Automatically Reposition DATUM and SREF Attas in the CENTRE of the GASKET
        if (!!ce.type.eq('GASK')) then
-- Move the ATTAS backwards into the CENTRE of the GASKET
          !tlen = !!kstrreal('const dist pa to pl')
          !hlen = ( !tlen / 2 )
          !!ce  = !support.datum
          !dire = !support.padir.string().before(' WRT')
          by $!dire $!hlen
          !!ce  = !srefatta
          by $!dire $!hlen
        endif
      endhandle

    elseif (!lcon) then
-- Otherwise the Leave is a Flange type Connection
      !support.datum.position = !pick.lpos
      !srefatta.position      = !pick.lpos
      !!ce = !support.datum
-- Navigate to the GASKET if Possible
      next 2
      handle ANY
-- Do Nothing -  Leave DATUM and SREF Attas where they are.
      elsehandle NONE
-- If type is a GASKET - Automatically Reposition DATUM and SREF Attas in the CENTRE of the GASKET
        if (!!ce.type.eq('GASK')) then
-- Move the ATTAS backwards into the CENTRE of the GASKET
          !tlen = !!kstrreal('const dist pa to pl')
          !hlen = ( !tlen / 2 )
          !!ce  = !support.datum
          !dire = !support.pldir.string().before(' WRT')
          by $!dire $!hlen
          !!ce  = !srefatta
          by $!dire $!hlen
        endif
      endhandle
    endif

-- Set the Support Object DATUM Atta Position Flag to TRUE
    !support.position = TRUE

-- Set SREF Atta DESPARS for FT47 Support Type
-- Despar Num 1 = Dimension 1 - Nominal Steel Height (H) - Provisional ONLY
   !srefatta.despar[1] = 500

-- Despar Num 2 = Identified Flange Outside Diameter
   !!ce = !!mdsft47.flange
-- Find flange o/d by getting the largest parameter from the list.
   !newparams = array()
   var !param cpar
   !params = !param.split()
   !params.sort().invert()
   do !killwords from 1 to !params.size()
     !test = !params[$!killwords].real()
     handle any
     elsehandle none
       !newparams.append(!test)
     endhandle
   enddo
   !newparams.sort().invert()
   !flangeod = !newparams[1]

-- Despar Num 2 = Identified Flange Outside Diameter (2 * R)
   !srefatta.despar[2] = !flangeod

-- Despar Num 3 = DATUM Atta Bore Size
   !srefatta.despar[3] = !datum.abor.real()

--$Pxxxxxxxxxxxxxxxxxxxxxxxxxxxx
   !!ce = !srefatta
--   q name type desp

-- Add marker text to DATUM Atta
    !!ce = !support.datum
    var !pos pos wrt world
    $m/%pdmsui%/des/clib/gaidtext 210 Datum $<$!pos$>

-- Set focus to the Dimension 1 text gadget
    !!mdsft47.dim1.setfocus()

-- Finally Update the MDSFT47 Support Object
    !!mdsft47.support = !support

-- Reset Units
    !!kRestoreUnits(!currentunits)

-- End function
  endfunction

-- End of file MdssetdatFT47.pml
