--
-- File:		MdssetdatFT48.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Mon Aug 04
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetDatFT48()

-- Force into forwards mode
   FORWARDS

  -- Initialise variables
    !TubeType = !!MdsOptions.Pipes
    !Support  = !!MdsFT48.Support
    !Datum    = !Support.Datum
    !Name     = !Support.Stru.name
    !Alias    = !!MdsFT48.Support.Alias

    !cecomp = !!CE

    if (!Datum.set()) then
      !!Alert.error('Datum atta for support $!Name already exists')
      return
    endif

  -- Select tube
    if (!TubeType eq 'FTUB')then
      !PipeType = 'lined section'
    else
      !PipeType = 'tube'
    endif

--> Modified - <wd> - 14sep1998
    label /again
--< Modified - <wd> - 14sep1998

    if (!!MdsIdTube('$!TubeType', 'Identify $!PipeType of datum pipe','PIPE').not())then
      return
    endif

    -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsFT48.support.idcomp = !idcomp
  !!MdsFT48.support.idbran = !idbran

-- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
    !idcomp = !!ce
    !!mdsFT48.support.idcomp = !idcomp
    !!MdsFT48.support.idbran = !idbran



$(
------------------------------
--> Modified - <wd> - 14sep1998
    !write = STRING()
    !lock  = STRING()
    if (!!kcheckwrite(!!ce, !lock , !write).not()) then
-- READ ONLY Access to the PIPE
      if (!write.eq('R')) then
        !!alert.error('The Identified PIPE is in a READ ONLY Database. Select another PIPE.')
        golabel /again
-- WRITE Access to the PIPE, BUT it is LOCKED
      elseif (!lock.eq('Locked')) then
        !!alert.error('The Identified PIPE is LOCKED. Select another PIPE.')
        golabel /again
      endif
    endif
--< Modified - <wd> - 14sep1998
------------------------------
$)
-- Check that PIPE is within the Maximum Slope Allowed,
-- for Horizontal Pipes, displayed on the 'Settings>Options...' form.
  !currcomp = !!ce

--<wd>dec2004
    if (!!ce.type eq 'BRAN') then
      !hdir = hdir wrt /*
      !bran = !!ce
    else
      !hdir = pl dir wrt /*
      !bran = !!ce.owner
    endif

$(
--<tm> fix to open up the angle to be in line with the pipe
    if (!hdir neq U and !hdir neq D ) then
      --if !!ce.owner.:MdsTrun.not() then
      if !bran.:mdstrun.not() then
--<wd>dec2004
        if (!!Mdsgradient(!currcomp)) then
          !!Alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!Mdsoptions.slope.val)')
          !!ce = !cecomp
          return
        endif
      endif

--<wd>dec2004
    endif
--<wd>dec2004
$)

-- Check if the bore of the identified pipe does not exceed the maximum allowed bore
  !Template = '/MDS/FRAMES/$!Alias'

  !currentunits = !!kgetsetunits()
------------------------------------------------------------------------------
-- mjb >>> 08.05.06 <mds12>
   !CheckBore = object mdscheckframe()
   --!CheckBore = object Mdscheckstd()
-- mjb <<< 08.05.06 end of mod
------------------------------------------------------------------------------
  if !CheckBore.bores('$!Template').not() then
    !!kRestoreUnits(!currentunits)
    var !Bore abore
      handle any
        var !Bore hbore
      endhandle
     -- q var !Bore
    !MinBore = :MDSMinBore of $!Template
    !MaxBore = :MDSMaxBore of $!Template
    if(!currentunits.isImperialSavedBore().not()) then
     !SMinBore = !MinBore
     !SMaxBore = !MaxBore
    else
     !SMinBore = ( DIST ( NOMBORE ( false , $!MinBore ) , false , false , true , 4 , false ) )
     !SMaxBore = ( DIST ( NOMBORE ( false , $!MaxBore ) , false , false , true , 4 , false ) )
    endif
    !!Alert.Error('Standard not available at this bore! ($!Bore). Minimum ($!SMinBore) Maximum ($!SMaxBore)')
    return
  endif
    !!kRestoreUnits(!currentunits)

    -- Change callback on apply button then show ancillary form
    !!MdsAncill.Action.Clear()
    !!MdsAncill.Action[1] = |Call !!MdsCrAncill(!!MdsFT48)|
    !!MdsAncill.Action[2] = |Call !!MdsCrDatFT48()|

    !!KShowForm(!!MdsAncill)
    !!MdsIAncill(!ALIAS)


-- set focus to the distance text gadget
   !!MdsFT48.Dist.SetFocus()
-- End function
endfunction
