--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetDatFT49()

-- Force into forwards mode
  FORWARDS

-- Initialise variables
  !TubeType = !!MdsOptions.Pipes
  !Support  = !!MdsFT49.Support
  !Datum    = !Support.Datum
  !Name     = !Support.Stru.name
  !Namn     = !!MdsFT49.Support.Stru.Namn
  !Alias    = !!MdsFT49.Support.Alias

  !cecomp = !!CE
  if (!Datum.set()) then
    !!Alert.error('Datum atta for support $!Name already exists')
    return
  endif

-- Select tube
  if (!TubeType eq 'FTUB')then
    !PipeType = 'lined section'
  else
    !PipeType = 'tube'
  endif
  !IDType = 'pipe'
  !Purp = 'PIPE'

  label /again

  if (!!MdsIdTube('$!TubeType', 'Identify $!PipeType of datum $!IDType','$!PURP').not())then
    return
  endif

-- In case we id a different element when second pick set the first id
  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsFT49.support.idcomp = !idcomp
  !!MdsFT49.support.idbran = !idbran

$(
  !write = string()
  !lock  = string()
  if (!!kcheckwrite(!!ce, !lock , !write).not()) then
-- READ ONLY Access to the $!idtype
    if (!write.eq('R')) then
      !!alert.error('The Identified $!idtype is in a READ ONLY Database. Select another $!idtype')
      golabel /again
-- WRITE Access to the $!idtype, BUT it is LOCKED
    elseif (!lock.eq('Locked')) then
      !!alert.error('The Identified $!idtype is LOCKED. Select another $!idtype')
      golabel /again
    endif
  endif
--< Modified - <wd> - 14sep1998
------------------------------
$)

-- Check if PIPE is Vertical
  !currcomp = !!ce
--<wd>dec2004 -- Both Horiz/Sloping and Vertical Pipes now allowed
$(
  if (!!CE.type eq 'BRAN') then
    pin 9 copy ph
    var !p9dir pin 9 dir wrt /*
    if ('$!p9dir' neq |U|) and ('$!p9dir' neq |D|) then
      !!Alert.error('Identified tube must be vertical')
      golabel /again
    endif
    !!MdsResetPins(9,9)
  else
    !pltest = pl dir wrt /*
    if ('$!pltest' eq |U WRT /*|) or ('$!pltest' eq |D WRT /*|) then
    else
      !!Alert.error('Identified tube must be vertical')
      golabel /again
    endif
  endif

  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif
$)
--<wd>dec2004

-------------------------------------------------
--<wd>dec2004
-- Pipes may now be VERTICAL and HORIZONTAL/SLOPING within the MDS default limits
    if (!!ce.type eq 'BRAN') then
      !hdir = hdir wrt /*
      !bran = !!ce
    else
      !hdir = pl dir wrt /*
      !bran = !!ce.owner
    endif
$(
--<tm> fix to open up the angle to be in line with the pipe
    if (!hdir neq U and !hdir neq D ) then
      if !bran.:mdstrun.not() then
        if (!!Mdsgradient(!currcomp)) then
          !!Alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!Mdsoptions.slope.val)')
          !!ce = !cecomp
          return
        endif
      endif
    endif
--<wd>dec2004
-------------------------------------------------
$)

-- Check if the bore of the identified pipe does not exceed the maximum allowed bore
  !Template = '/MDS/FRAMES/$!Alias'
  !currentunits = !!kgetsetunits()
------------------------------------------------------------------------------
-- mjb >>> 08.05.06 <mds12>
   !CheckBore = object mdscheckframe()
   --!CheckBore = object Mdscheckstd()
-- mjb <<< 08.05.06 end of mod
------------------------------------------------------------------------------
  if !CheckBore.bores('$!Template').not() then
    !!kRestoreUnits(!currentunits)
    var !Bore abore
      handle any
        var !Bore hbore
      endhandle
    !MinBore = :MDSMinBore of $!Template
    !MaxBore = :MDSMaxBore of $!Template
    if(!currentunits.isImperialSavedBore().not()) then
     !SMinBore = !MinBore
     !SMaxBore = !MaxBore
    else
     !SMinBore = ( DIST ( NOMBORE ( false , $!MinBore ) , false , false , true , 4 , false ) )
     !SMaxBore = ( DIST ( NOMBORE ( false , $!MaxBore ) , false , false , true , 4 , false ) )
    endif
    !!Alert.Error('Standard not available at this bore! ($!Bore). Minimum ($!SMinBore) Maximum ($!SMaxBore)')
    return
  endif

  !!kRestoreUnits(!currentunits)

-- Change callback on apply button then show ancillary form
  -- !!MdsAncill.Action.Clear()
  -- !!MdsAncill.Action[1] = |Call !!MdsCrAncill(!!MdsFT49)|
  -- !!MdsAncill.Action[2] = |Call !!MdsCrDatFT49()|
  -- !!KShowForm(!!MdsAncill)
  -- !!MdsIAncill('$!Alias')

  !!MdsCrDatFT49()
-- set focus to the distance text gadget
  !!MdsFT49.Dist.SetFocus()

-- End function
endfunction
