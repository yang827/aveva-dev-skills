--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetDatFT50()

-- Find current units and set the distance unit to metric
  !currentunits = !!kgetsetunits()
-- Force into forwards mode
  FORWARDS

-- Initialise variables
  !TubeType = !!MdsOptions.Pipes
  !Support  = !!MdsFT50.Support
  !Datum    = !Support.Datum
  !Name     = !Support.Stru.name
  !Namn     = !!MdsFT50.Support.Stru.Namn
  !Alias    = !!MdsFT50.Support.Alias

  !cecomp = !!CE

  if (!Datum.set()) then
    !!Alert.error('Datum atta for support $!Name already exists')
    return
  endif

-- Select tube
-------------------------------------------------
--<wd>dec2004
-- Select tube CODE added
    if (!TubeType eq 'FTUB')then
      !PipeType = 'lined section'
    else
      !PipeType = 'tube'
    endif

    label /again
    --label /Element0
--<wd>dec2004
-------------------------------------------------

-------------------------------------------------
--<wd>dec2004
-- Added below the Standard MDS CODE for Identifying a Pipe

--  prompt off
--  prompt load escape |Identify existing support lugs on pipe|
--  id ATTA @
--    handle (61,528)
--      prompt on
--      !!kRestoreUnits(!currentunits)
--      return
--    endhandle
--    prompt dismiss
--    prompt on

  if (!!MdsIdTube('$!TubeType', 'Identify $!PipeType of datum pipe','PIPE').not())then
    return
  endif
--<wd>dec2004
-------------------------------------------------

  !SupLug = !!ce

-- Is the identified atta owned by same branch as the datum atta
  bran
  !SupLugBran = !!ce
  ---$!datum
  same

  !!mdsFT50.support.idcomp = !SupLug
  !!MdsFT50.support.idbran = !SupLugBran

-- Check if PIPE is Vertical
  !currcomp = !!ce

-------------------------------------------------
--<wd>dec2004 -- Both Horiz/Sloping and Vertical Pipes now allowed
$(
  if (!!CE.type eq 'BRAN') then
    pin 9 copy ph
    var !p9dir pin 9 dir wrt /*
    if ('$!p9dir' neq |U|) and ('$!p9dir' neq |D|) then
      !!Alert.error('Identified tube must be vertical')
      golabel /again
    endif
    !!MdsResetPins(9,9)
  else
    !pltest = pl dir wrt /*
    if ('$!pltest' eq |U WRT /*|) or ('$!pltest' eq |D WRT /*|) then
    else
      !!Alert.error('Identified tube must be vertical')
      golabel /again
    endif
  endif
$)
--<wd>dec2004
-------------------------------------------------

-------------------------------------------------
--<wd>dec2004
  --if (!!ce.type eq 'BRAN') then
  --  !hdir = hdir wrt /*
  --else
  --  !hdir = pl dir wrt /*
  --endif

-- Pipes may now be VERTICAL and HORIZONTAL/SLOPING within the MDS default limits
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
    !bran = !!ce
  else
    !hdir = pl dir wrt /*
    !bran = !!ce.owner
  endif

$(
--<tm> fix to open up the angle to be in line with the pipe
  if (!hdir neq U and !hdir neq D ) then
    if !bran.:mdstrun.not() then
      if (!!Mdsgradient(!currcomp)) then
        !!Alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!Mdsoptions.slope.val)')
        !!ce = !cecomp
        return
      endif
    endif
  endif
--<wd>dec2004
-------------------------------------------------
$)

-- Check if the bore of the identified pipe does not exceed the maximum allowed bore
  !Template = '/MDS/FRAMES/$!Alias'

  !currentunits = !!kgetsetunits()
------------------------------------------------------------------------------
-- mjb >>> 08.05.06 <mds12>
   !CheckBore = object mdscheckframe()
   --!CheckBore = object Mdscheckstd()
-- mjb <<< 08.05.06 end of mod
------------------------------------------------------------------------------
  if !CheckBore.bores('$!Template').not() then
    !!kRestoreUnits(!currentunits)
    var !Bore abore
      handle any
        var !Bore hbore
      endhandle
     -- q var !Bore
    !MinBore = :MDSMinBore of $!Template
    !MaxBore = :MDSMaxBore of $!Template
    if(!currentunits.isImperialSavedBore().not()) then
     !SMinBore = !MinBore
     !SMaxBore = !MaxBore
    else
     !SMinBore = ( DIST ( NOMBORE ( false , $!MinBore ) , false , false , true , 4 , false ) )
     !SMaxBore = ( DIST ( NOMBORE ( false , $!MaxBore ) , false , false , true , 4 , false ) )
    endif
    !!Alert.Error('Standard not available at this bore! ($!Bore). Minimum ($!SMinBore) Maximum ($!SMaxBore)')
    return
  endif
    !!kRestoreUnits(!currentunits)

-- Change callback on apply button then show ancillary form
  -- !!MdsAncill.Action.Clear()
  -- !!MdsAncill.Action[1] = |Call !!MdsCrAncill(!!MdsFT50)|
  -- !!MdsAncill.Action[2] = |Call !!MdsCrDatFT50()|
  -- !!KShowForm(!!MdsAncill)
  -- !!MdsIAncill('$!Alias')

  units mm bore
  units mm dist
  !!MdsCrDatFT50()
  !!kRestoreUnits(!currentunits)

-- set focus to the distance text gadget
   !!MdsFT50.Dist.SetFocus()
-- End function
endfunction
