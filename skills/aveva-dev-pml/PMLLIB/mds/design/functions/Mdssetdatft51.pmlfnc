--
-- File:		MdssetdatFT51.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS131
--
-- Author:		I.Osborne
-- Created:		Tue Jul 01
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetDatFT51()

-- Find current units and set the distance unit to metric
    !CurrentUnits = !!KGetSetUnits()

  -- Initialise variables
    !TubeType = !!MdsOptions.Pipes
    !Support  = !!MdsFT51.Support
    !Datum    = !Support.Datum
    !Name     = !Support.Stru.name
    !Namn     = !!MdsFT51.Support.Stru.Namn
    !Alias    = !!MdsFT51.Support.Alias

    !cecomp = !!CE

    if (!Datum.set()) then
      !!Alert.error('Datum atta for support $!Name already exists')
      !!kRestoreUnits(!currentunits)
      return
    endif

  -- Select tube
    if (!Alias eq 'FT51' or !Alias eq 'FT37') then
      if (!TubeType eq 'FTUB')then
      !PipeType = 'lined section'
      else
        !PipeType = 'tube'
      endif
      !IDType = 'pipe'
      !Purp = 'PIPE'
    elseif (!Alias eq 'CT04') then
      !PipeType = 'tray section'
      !IDType = 'cable rack'
      !Purp = 'TRAY'
    endif

--> Modified - <wd> - 14sep1998
    label /again
--< Modified - <wd> - 14sep1998

    if (!!MdsIdTube('$!TubeType', 'Identify $!PipeType of datum pipe','$!PURP').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

-- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
    !idcomp = !!ce
    !!mdsFT51.support.idcomp = !idcomp
  !!MdsFT51.support.idbran = !idbran

$(
------------------------------
--> Modified - <wd> - 14sep1998
    !write = STRING()
    !lock  = STRING()
    if (!!kcheckwrite(!!ce, !lock , !write).not()) then
-- READ ONLY Access to the '!idtype'
      if (!write.eq('R')) then
        !!alert.error('The Identified $!idtype is in a READ ONLY Database. Select another $!idtype.')
        golabel /again
-- WRITE Access to the '!idtype', BUT it is LOCKED
      elseif (!lock.eq('Locked')) then
        !!alert.error('The Identified $!idtype is LOCKED. Select another $!idtype.')
        golabel /again
      endif
    endif
--< Modified - <wd> - 14sep1998
------------------------------
$)
  if (!Alias eq 'FT51' or !Alias eq 'FT37') then

-- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
-- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

    !currcomp = !!ce
    if (!!ce.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
    endif

$(
--<tm> fix to open up the angle to be in line with the pipe
    if (!hdir neq U and !hdir neq D ) then
      if (!!Mdsgradient(!currcomp)) then
        !!Alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!Mdsoptions.slope.val)')
        !!ce = !cecomp
        !!kRestoreUnits(!currentunits)
      return
      endif
    endif
$)

-- Check that the :MDSHv attribute of the template zone to see if horizontal
-- or vertical pipes are allowed

   if !!Mdschecktemp('/MDS/FRAMES/$!Alias','$!Hdir').not() then
     !!kRestoreUnits(!currentunits)
     return
   endif

  elseif (!Alias eq 'CT04') then

-- Check that RACK is within the Maximum Slope Allowed,
-- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

    !currcomp = !!ce
    if (!!ce.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
    endif

    if (!hdir neq U and !hdir neq D ) then
      if (!!Mdsgradient(!currcomp)) then
        !!Alert.message ('The rack identified is not within the maximum slope for horizontal rack as defined in the application defaults ($!!Mdsoptions.slope.val)')
        !!ce = !cecomp
        !!kRestoreUnits(!currentunits)
        return
      endif
    endif

-- Check that the :MDSHv attribute of the template zone to see if horizontal,
-- vertical pipes or both are allowed
    if !!Mdschecktemp('/MDS/FRAMES/$!Alias','$!Hdir').not() then
     !!kRestoreUnits(!currentunits)
      return
    endif
  endif

  -- Change callback on apply button then show ancillary form
  if (!Alias eq 'FT51' or !Alias eq 'FT37') then
    !!MdsAncill.Action.Clear()
    !!MdsAncill.Action[1] = |Call !!MdsCrAncill(!!MdsFT51)|
    !!MdsAncill.Action[2] = |Call !!MdsCrDatFT51()|
    !!KShowForm(!!MdsAncill)
    !!MdsIAncill('$!Alias')
  elseif (!Alias eq 'CT04') then
      !!MdsAncill.Action.Clear()
      !!MdsAncill.Action[1] = |Call !!MdsCrAncill(!!MdsFT51)|
      !!MdsAncill.Action[2] = |Call !!MdsCrDatFT51()|
      !!KShowForm(!!MdsAncill)
      !!MdsIAncill('CT04')
$(
    -- No ancillaries on cable racks so go into the CrDat straight away
    -- after creating atta set setting the attributes
--------------------------------------------------------------------------
      --!Width  = !!MdsSetWid()
-- Store the Current/Identified Element DBREF
      !xce = !currcomp
      new atta sel spref with styp 'RACK-REST' spec /MDS
      SPKBRK TRUE
      !order = order
-- The Atta Order number in the BRANCH will always be greater than > 1 if FTUBS are used
      !xat = !!ce
      if (!currcomp.type.eq('FTUB')) then
        !!ce    = !currcomp
        !Width  = !!MdsSetWid()
        !height = 0
      else
        if (!order.eq(1)) then
          dist 100
        else
          dist 100 from pl of prev
        endif

        !!ce = !currcomp
        if (!currcomp.type.eq('BRAN')) then
          head
          !hdir = hdir wrt /*
          ileave tube
          !tori = ori wrt /*
          !odir = !tori.string().after('/* ')
          !ori  = 'ori Y is ' & !hdir & ' ' & !odir
          !!ce = !xat
          ori $!ori
        else
          !!ce  = !currcomp
          !hdir = ldir wrt /*
          ileave tube
          !tori = ori wrt /*
          !odir = !tori.string().after('/* ')
          !ori  = 'ori Y is ' & !hdir & ' ' & !odir
          !!ce  = !xat
          ori $!ori
        endif
        !!ce = !currcomp
        !height = 0
        !width  = !!mdstraywidth(!xat, !xce, !height)
      endif
      !!ce = !xat

--      new atta sel spref with styp 'RACK-REST' spec /MDS
--      SPKBRK TRUE
---------------------------------------------------------------------------

    -- set stex for atta
      !SAtta = !!CE
      Call !!MdsTransport(!SAtta,!Name)

---------------------------------------------------------------------------
      -- despar $!Width $!Height
      !!MdsDacControl(true)
      despar $!Width $!Height
      --despar $!Width 0

      if (!currcomp.type.eq('FTUB')) then
        fconn and p30 is p30 of prev
      else
      --  if (!order.eq(1)) then
          fconn
          ori $!ori
          sel lstu
      --  endif
      endif
---------------------------------------------------------------------------

      --fconn and p30 is p30 of prev
      !!MdsSelLstu(!!CE)
      -- Always add atta to datum cross bar
      !!MdsFT51.Support.bars[1][1] = !!CE.Name.dbref()
      !!MdsFT51.Support.Atta.append(!!CE)
      !!MdsDacControl(false)
      Call !!MdsCrDatFT51()
$)

  endif

-- Reset Units
   !!kRestoreUnits(!currentunits)

-- set focus to the distance text gadget
   !!MdsFT51.Dist.SetFocus()

-- End function
endfunction

-- End of file MdssetdatFT51.pml
