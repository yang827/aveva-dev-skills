--
-- File:		MdssetdatFT54C.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Richard Martin
-- Created:		January 2006
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetDatFT54C()

  -- Force into forwards mode
  FORWARDS
  !currentunits = !!kgetsetunits()

  -- Initialise variables
  !TubeType = !!MdsOptions.Pipes
  !Support  = !!MdsFT54C.Support
  !Datum    = !Support.Datum
  !Name     = !Support.Stru.name
  !Type     = !!MdsFT54C.Support.Type
  !cecomp = !!CE

  if (!Datum.set()) then
    !!Alert.error('Datum atta for support $!Name already exists')
    return
  endif

  -- Select tube to support
  label /again

  prompt off
  prompt load escape 'Identify tube to support from'
  ID TUBE @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return false
    endhandle
  prompt on

  if (!!CE.type eq 'BRAN') then
    pin 9 copy ph
    var !p9dir pin 9 dir wrt /*
    if ('$!p9dir' eq |U|) or ('$!p9dir' eq |D|) then
      !!Alert.error('Identified tube must be Horizontal')
      golabel /again
    endif
  else
    !pltest = pl dir wrt /*
    if ('$!pltest' neq |U WRT /*|) or ('$!pltest' neq |D WRT /*|) then
    else
      !!Alert.error('Identified tube must be Horizontal')
      golabel /again
    endif
  endif

  handle ANY
    !!Alert.error('Incorrect Support Component Picked')
    golabel /again
  endhandle

  !Tee = !!Ce
  !idcomp = !!ce
  !!mdsFT54C.support.idcomp = !idcomp
  !!mdsFT54C.support.atta[1] = !Tee
  -- Change callback on apply button then show ancillary form

  !!MdsAncill.Action.Clear()
  !!MdsAncill.Action[1] = |Call !!MdsCrAncill(!!MdsFT54C)|
  !!MdsAncill.Action[2] = |Call !!MdsCrDatFT54C()|

  !!KShowForm(!!MdsAncill)
  !!MdsIAncill('FT54C')

  -- set focus to the distance text gadget
  !!MdsFT54C.Dist.SetFocus()

-- End function
endfunction

-- End of file MdssetdatFT54C.pml
