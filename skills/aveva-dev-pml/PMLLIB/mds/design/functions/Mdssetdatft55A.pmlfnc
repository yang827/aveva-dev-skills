--
-- File:		MdssetdatFT55A.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS133
--
-- Author:		I.Osborne
-- Created:		Thu Jul 03
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetDatFT55A()

-- Force into forwards mode
  FORWARDS
  !currentunits = !!kgetsetunits()
  -- Initialise variables
  !TubeType = !!MdsOptions.Pipes
  !Support  = !!MdsFT55A.Support
  !Datum    = !Support.Datum
  !Name     = !Support.Stru.name
  !Type     = !!MdsFT55A.Support.Type
  !cecomp = !!CE

  if (!Datum.set()) then
    !!Alert.error('Datum atta for support $!Name already exists')
    return
  endif

-- Select tube to support

  label /again

  prompt off
  prompt load escape 'Identify tube to support'
  ID tube @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return false
    endhandle
  prompt on

  if (!!CE.type eq 'BRAN') then
    pin 9 copy ph
    var !p9dir pin 9 dir wrt /*
    if ('$!p9dir' neq |U|) and ('$!p9dir' neq |D|) then
      !!Alert.error('Identified tube must be vertical')
      golabel /again
    endif
    !!MdsResetPins(9,9)
  else
    !pltest = pl dir wrt /*
    if ('$!pltest' eq |U WRT /*|) or ('$!pltest' eq |D WRT /*|) then
    else
      !!Alert.error('Identified tube must be vertical')
      golabel /again
    endif
  endif

  handle ANY
    !!Alert.error('Incorrect Support Component Picked')
    golabel /again
  endhandle

  !Tube = !!Ce
  !idcomp = !!ce
  !!mdsFT55A.support.idcomp = !idcomp
--  !!MdsFT55A.support.idbran = !idbran
  !!mdsFT55A.support.atta[1] = !tube

-- Change callback on apply button then show ancillary form
  !!MdsAncill.Action.Clear()
  !!MdsAncill.Action[1] = |Call !!MdsCrAncill(!!MdsFT55A)|
  !!MdsAncill.Action[2] = |Call !!MdsCrDatFT55A()|

  !!KShowForm(!!MdsAncill)
  !!MdsIAncill('FT55A')

-- set focus to the distance text gadget
  !!MdsFT55A.Dist.SetFocus()

-- End function
endfunction

-- End of file MdssetdatFT55A.pml
