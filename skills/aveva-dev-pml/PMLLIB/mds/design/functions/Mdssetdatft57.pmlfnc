--
-- File:		MdssetdatFT57.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MDATPS147
--
-- Author:		I.Osborne
-- Created:		Mon Aug 04
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetDatFT57()

-- Force into forwards mode
  FORWARDS

-- Initialise variables
  !TubeType = !!MdsOptions.Pipes
  !Support  = !!MdsFT57.Support
  !Datum    = !Support.Datum
  !Name     = !Support.Stru.name

  !cecomp = !!CE

  if (!Datum.set()) then
    !!Alert.error('Datum atta for support $!Name already exists')
    return
  endif

-- Select tube
  if (!TubeType eq 'FTUB')then
    !PipeType = 'lined section'
  else
    !PipeType = 'tube'
  endif

label /again

  if (!!MdsIdTube('$!TubeType', 'Identify $!PipeType of datum pipe','PIPE').not())then
    return
  endif

-- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsFT57.support.idcomp = !idcomp
  !!MdsFT57.support.idbran = !idbran
--  $P 1

-- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsFT57.support.idcomp = !idcomp
  !!MdsFT57.support.idbran = !idbran
--  $p 2

$(
------------------------------
--> Modified - <wd> - 14sep1998
    !write = STRING()
    !lock  = STRING()
    if (!!kcheckwrite(!!ce, !lock , !write).not()) then
-- READ ONLY Access to the PIPE
      if (!write.eq('R')) then
        !!alert.error('The Identified PIPE is in a READ ONLY Database. Select another PIPE.')
        golabel /again
-- WRITE Access to the PIPE, BUT it is LOCKED
      elseif (!lock.eq('Locked')) then
        !!alert.error('The Identified PIPE is LOCKED. Select another PIPE.')
        golabel /again
      endif
    endif
--< Modified - <wd> - 14sep1998
------------------------------
$)

-- Check that PIPE is within the Maximum Slope Allowed,
-- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

$(
    !currcomp = !!ce

--<wd>13jul2004 -- FT57 upgraded for use on VERTICAL Pipes as well as HORIZONTAL Pipes
    !ldir = !!ce.ldir.wrt(/* )
    handle ANY
      !ldir = !!ce.hdir.wrt(/* )
    endhandle
-- Identified Pipe is Horizontal - vertical Pipes DO NOT need a gradient check
    if (not !ldir.string() inset ('D WRT /*', 'U WRT /*')) then
--<wd>13jul2004


--<tm> fix to open up the angle to be in line with the pipe
      if !!ce.type.eq('BRAN') then
        if !!ce.:MdsTrun.not() then
          if (!!Mdsgradient(!currcomp)) then
            !!Alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!Mdsoptions.slope.val)')
            !!ce = !cecomp
            return
          endif
        endif
      else
        if !!ce.owner.:MdsTrun.not() then
          if (!!Mdsgradient(!currcomp)) then
            !!Alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!Mdsoptions.slope.val)')
            !!ce = !cecomp
            return
          endif
        endif
      endif

--<wd>13jul2004
    endif
--<wd>13jul2004
$)

    -- Change callback on apply button then show ancillary form
    !!MdsAncill.Action.Clear()
    !!MdsAncill.Action[1] = |Call !!MdsCrAncill(!!MdsFT57)|
    !!MdsAncill.Action[2] = |Call !!MdsCrDatFT57()|

    !!KShowForm(!!MdsAncill)
    !!MdsIAncill('FT57')


-- set focus to the distance text gadget
   !!MdsFT57.Dist.SetFocus()
-- End function
endfunction

-- End of file MdssetdatFT57.pml
