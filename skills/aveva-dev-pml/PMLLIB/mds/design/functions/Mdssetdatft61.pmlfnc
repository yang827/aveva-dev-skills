--
--
-- Description:
-- Create FT61 datum atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdssetdatft61()

-- Force into forwards mode
  FORWARDS

-- Initialise variables
  !tubeType = !!mdsoptions.pipes
  !support  = !!MdsFt61.support
  !datum    = !support.datum
  !name     = !support.stru.name

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    return
  endif

-- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif

  if (!!MdsIdTube('$!tubeType', 'Identify $!pipeType of datum pipe','PIPE').not())then
    return
  endif

-- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!MdsFt61.support.idcomp = !idcomp
  !!MdsFt61.support.idbran = !idbran

-- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!MdsFt61.support.idcomp = !idcomp
  !!MdsFt61.support.idbran = !idbran

   Call !!MdsCrDatFT61()

-- set focus to the distance text gadget
   !!MdsFt61.dist.setFocus()

 -- Call the create macro so we can create the support

   !!MdsCreateFt61('CURSOR')

-- End function
endfunction
