--
-- File: Mdssetdatgt01.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: N.morris
-- Created: Tue Oct 28
--
--
-- Description:
-- Creation function for guide gt01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatGt01()

  -- Force into forwards mode
  FORWARDS

  -- Find current units and set the distance unit to metric

  !currentunits = !!kGetSetUnits()

  -- Initialise variables
  !unusedtubeType    = !!mdsoptions.pipes
  !datum       = !!mdsGT01.support.datum
  !name        = !!mdsGT01.name.val
  !alias       = !!mdsGT01.support.alias
  !fromAtta    = !!mdsGT01.support.preliminaryStore.set()

  !unusedcecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Identify shoe to attach guide to
  -- <sk> 06/06/2012
  if (defined (!!mdsAutoTubePicker) AND !!mdsAutoTubePicker.enabled()) then

    -- return if limit of pick tries exceeded
    if (!!mdsAutoTubePicker.allowedPicks.eq(0)) then
      !!mdsAutoTubePicker.cancel()
      return FALSE
    endif

    !picked = !!mdsAutoTubePicker.pickShoe()
    if unset(!picked) then
      !!alert.warning ('There is no pipe shoe suitable to guide next to preliminary support.')
      !!mdsAutoTubePicker.cancel()
      !!kRestoreUnits(!currentunits)
      return false
    else
      !!ce = !picked
    endif

  else
    prompt off
    prompt load escape 'Identify pipe shoe to guide'
    ID ATTA @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return false
    endhandle
    prompt on
  endif
  -- <sk> 06/06/2012

  if !!mdsGT01.support.type.eq('GT08') then
    !sfthk = prop fthk
  elseif !!mdsGT01.support.type.eq('ST06') then
    !shei = prop hei
    --<dw>mar2009 dun1119 GT63,GT64,GT70 & GT71 added
  elseif (!!mdsGT01.support.type inset('GT44','GT46','GT47','GT48','GT49','GT60A','GT60B','GT63','GT64','GT70','GT71')) then
    --<GE>aug2006 Added test to see if the shoe is an AT25 as it has specific named properties that are used
    if !!ce.styp.eq('AT25') then
      !shei = prop hei
      !sfthk = prop bpth
      !swid = prop bwid
    else
      !shei = prop hei
      !sfthk = prop fthk
      !swid = prop fwid
    endif
    --<GE>aug2006
  endif

  !atta = !!ce

  ---------------------------------------------------------------------------------------------------
  --<wd>aug2006 -- These TWO tests shown below have been commented out to allow USERS
  --               to ADD any GUIDE to an AT25 Cryogenic Support, if they want to!
  --
  --
  -- ---------------------------------------------------------------------------------------------------
  -- --<wd>dec2006<mds12>
  -- The <wd>dec2006<mds12> CODE in the adjacent blocks for the MDS12 changes was done before the FILES were MERGED so it remains, in case it is required later!!
  -- -- Get the AT25 and GT14 Client CODES in MDS12
  --     !at25code = !!mdsgetdefprop('ATTA', 'AT25', 'CCOD')
  --     !gt14code = !!mdsgetdefprop('ATTA', 'GT14', 'CCOD')
  -- --<wd>dec2006<mds12>
  -- ---------------------------------------------------------------------------------------------------

  -- -- If its a GT14 then this can only be placed on a AT25 shoe
  --     if !!mdsGT01.support.alias.eq('GT14') then
  --       if !!ce.styp.neq('AT25') then

  -- --<wd>dec2006<mds12>
  --         --!!alert.error('Only the Guide standard $!!cODEGT14 may be placed on a $!!cODEAT25 shoe. Creation aborted!')
  --         !!alert.error('Only the Guide standard $!gt14code may be placed on a $!at25code shoe. Creation aborted!')
  -- --<wd>dec2006<mds12>

  --         !!kRestoreUnits(!currentunits)
  --         return
  --       endif
  --     endif
  -- --------------------------------------------------
  -- --<wd>jan2004
  -- -- Check if Identified Pipe Shoe is an AT25, then ONLY allow a GT14 Guide to be associated with it.
  --     if (!!ce.styp.eq('AT25')) then
  --       if (!!mdsGT01.support.alias.neq('GT14')) then

  -- --<wd>dec2006<mds12>
  --         --!!alert.error('The Pipe Shoe standard $!!cODEAT25 may only be associated with a $!!cODEGT14 guide. Creation aborted!')
  --         !!alert.error('The Pipe Shoe standard $!at25code may only be associated with a $!gt14code guide. Creation aborted!')
  -- --<wd>dec2006<mds12>

  --         !!kRestoreUnits(!currentunits)
  --         return
  --       endif
  --     endif
  -- --<wd>jan2004
  -- --------------------------------------------------
  --
  --
  --<wd>aug2006 -- The TWO tests shown above have been commented out to allow USERS
  --               to ADD any GUIDE to an AT25 Cryogenic Support, if they want to!
  ---------------------------------------------------------------------------------------------------

  -- Is it a shoe (already tested for preliminary support in mdsAutoPicker)
  if !!ce.catref.owner.:MdsGuidable then
  else
    !!alert.error('The identified element is not suitable to guide with this type, it must be a pipe shoe')
    !!kRestoreUnits(!currentunits)
    return
  endif

  --------------------------------------------------------------------------------
  --xxx  :Guide 'Guide $!name'

  -- Select ancillary

  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  !!mdsdaccontrol(true)

  -- <sk> 06/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsGT01.support.datum = !!ce
  else
    new atta
  endif
  -- <sk> 06/06/2012

  SPKBRK TRUE

  --xxx  :Guide '$!attaNamn'

  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsGT01.support.replace
    !!alert.error('Unable to select ancillary $!projStandard at this bore($!bore)')
    !!mdsdaccontrol(false)
    !!kRestoreUnits(!currentunits)
    -- <sk> 06/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT01, true)
      return
    endif
    delete atta
    return
  elsehandle NONE
    ---------------------------------------------------------------------------------------------------------------
    -- mjb >>> 05.04.06 <mds12>
    -- The element may exist in the specification but the project may not contain the size in the parameters file
    spref $!choice[1]
    !guideatta = !!ce
    !lbor = !guideatta.lbor.real().value()
    !mds12test = !!mdssetdespars(!guideatta)

    if (!mds12test.not()) then
      --if undefined(!!mdspar$!alias[$!bore]) then
      -- mjb <<< end of mod
      ---------------------------------------------------------------------------------------------------------------
      !projStandard = !!mdsGT01.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      !!kRestoreUnits(!currentunits)
      -- <sk> 06/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsGT01, true)
        return
      endif
      delete atta
      !!mdsdaccontrol(false)
      return
    endif
  endhandle

  ------------------------------------------------------------------------------
  -- mjb >>> 05.04.06 <mds12>
  --spref $!choice[1]

  --!!mdssetdespars(!!ce)
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------

  --<wd>dec2003->>>
  !!mdsdaccontrol(true)

  ------------------------------------------------------------------------------
  -- mjb >>> 05.04.06 <mds12>
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!guideatta.stype,!lbor)

  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentunits)
    -- <sk> 06/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT01, true)
      return
    endif
    delete atta
    !!mdsdaccontrol(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)


  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'mdscheckstd.insu()' will return 'TRUE' and skip the code shown below

  --!check = object MDSCHECKSTD()

  -- mjb <<< end of mod
  ------------------------------------------------------------------------------

  !min = STRING()
  !max = STRING()
  !materror = STRING()

  if (!check.material(!materror).not()) then
    !!alert.error (!materror)
    !!kRestoreUnits(!currentunits)
    -- <sk> 06/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT01, true)
      return
    endif
    delete atta
    return
  endif

  -- <ak> 03/07/2012
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentunits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT01, true)
      return
    endif
    delete atta
    return
  endif
  -- </ak> 03/07/2012

  if (!check.insu(!alias,!min,!max).not()) then
    var !insu insu
    !!kformattext.text.val  = $!max
    !maxval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!min
    !minval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!insu
    !insval = !!kformattext.text.val.string(!!distancefmt)
    !!alert.message ('The INSULATION on the identified pipe ($!<insval>$!<units>) is not within the MIN ($!<minval>$!<units>) and MAX ($!<maxval>$!<units>) limits of the Insulation Thickness Values for the selected ancillary support type')
    !!kRestoreUnits(!currentunits)
    -- <sk> 06/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT01, true)
      return
    endif
    delete atta
    return
  endif

  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below

  !tmin = STRING()
  !tmax = STRING()
  if (!check.temp(!alias,!tmin,!tmax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tmin / $!tmax)')
    !!kRestoreUnits(!currentunits)
    -- <sk> 06/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT01, true)
      return
    endif
    delete atta
    return
  endif

  -- Test if the ancillary is available at this elevation

  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedelevation = !position.up
    !minimumelevation = !mdsattaobj.elevation

    !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedelevation Minimum elevation $!minimumelevation')
    !!kRestoreUnits(!currentunits)
    -- <sk> 06/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT01, true)
      return
    endif
    delete atta
    return
  endif

  --<wd>dec2003-<<<

  -- Set the ATTA - UDA :MDSMatRef with the PROPCON Property, if it is declared in the dimensions default file
  !!mdssetmatref(!!ce)

  --<ge>03nov2004
  !!mdsdaccontrol(TRUE)

  -- Name support
  :MDSSuppType |$!!mdsGT01.support.type|
  Name /$!name
  --xxx  !!ce = !attaname.dbref()

  -- Set Guide Atta :MDSGuideRef to Shoe Atta
  :MDSGuideRef $!atta
  !guide = !!ce

  -- Navigate back to Shoe Atta and Set :MDSGuideRef to Guide Atta

  !!ce  = !atta
  :MDSGuideRef $!guide
  handle ANY
    claim ce
    :MDSGuideRef $!guide
  elsehandle NONE
  endhandle

  --------------------------------------------------------------------------------
  -- Set guide dims to the shoe that it is supporting
  !!mdsResetGuide()
  !!ce = !guide

  !!mdsSetIspe()

  --  Add stex for isometrics
  call !!mdsTransport(!!ce,!name)

  -- !stex = after(!name, '/')
  -- !tran = subs(!stex, 1, 1)
  -- STEX '$!stex'

  !!mdsSelLstu(!!ce)

  !!mdsdaccontrol(true)

  if (!fromAtta) then
    POS AT $!picked
    ori and p3 is p3 of $!picked
  else
    POS AT PREV
    ori and p3 is p3 of prev
  endif

  -- Add marker text
  VAR !pos POS P9 WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  -- Always add atta to support object
  !!mdsGT01.support.atta.clear()
  !!mdsGT01.support.atta.append(!!ce)
  !!mdsGT01.support.datum  = !!ce
  !!mdsGT01.support.pADir  = Pa Dir wrt world
  !!mdsGT01.support.pLDir  = Pl Dir wrt world
  !!mdsGT01.support.p9Dir  = P9 Dir wrt world
  !!mdsGT01.support.position = true

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.appendarray(!!mdsGT01.support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourlist)

  -- When finished grey out datum gadget and reset gadgets

  !!mdsSetGadgets(!!mdsGT01,!!ce,!!mdsGT01.support.type)

  !!mdsGT01.datum.active = false

  -- Special for GT08 is the requirement of setting the BCCL dkey to the cross
  -- centre of the beam it is sitting on
  -- Special for ST06 is the requirement of setting the SBFW dkey to the width
  -- of the beam it is sitting on

  !!mdsdaccontrol(true)

  if !!mdsGT01.support.type.eq('GT08') then
    -- Identify beam to bolt guide to
    prompt off
    prompt load escape 'Identify section to bolt guide to'
    !boltDia = despa num 10
    --<wd>17jan2008 -- Defect No. P-4407
    --    ID SCTN @
    ID SCTN HSTIFF @
    --<wd>17jan2008 -- Defect No. P-4407
    handle (61,528)
      !!mdsdaccontrol(false)
      prompt on
      !!kRestoreUnits(!currentunits)
      if !fromAtta then
        !!mdsRestorePre(!!mdsGT01, true)
        return false
      endif
      return false
    endhandle
    prompt on
    -- TBHL to TBHR for the cross centres
    -- Also the flange thickness is needed
    var !cc const dist ppline TBHL start to ppline TBHR start
    handle any
      -- 01.03.02 A.b. Find beam width
      var !cc const dist ppline LTOS start to ppline RTOS start
      handle any
        !!mdsdaccontrol(false)
        !!alert.error('Unable to find bolt cross centres from identified section')
        !!kRestoreUnits(!currentunits)
        golabel /end
      endhandle
      -- 01.03.02 A.b. Used 1.5 times bolt diam from bean edge.
      !cc = STRING(real(!cc) - $!boltDia[1] * 3)
    endhandle
    !flanThk = (prop FLG)
    same
    var !prop coll all data with dkey eq 'SBFT' for dtre
    var !ccprop coll all data with dkey eq 'BCCL' for dtre
    var !bpprop coll all data with dkey eq 'BPLT' for dtre
    var !num1 eval num for all from !ccprop
    var !num2 eval num for all from !prop
    var !num3 eval num for all from !bpprop
    despar n$!num1[1]  $!cc
    despar n$!num2[1]  $!flanThk
    despar n$!num3[1]  $!sfthk
  elseif (!!mdsGT01.support.type inset('ST06','GT47','GT48')) then
    -- Identify beam to sit on
    prompt off

    prompt load escape 'Identify section or box to use as stop'
    --<wd>17jan2008 -- Defect No. P-4407
    --     ID SCTN BOX @
    ID SCTN BOX HSTIFF @
    --<wd>17jan2008 -- Defect No. P-4407
    handle (61,528)
      prompt on
      var !hprop coll all data with dkey eq 'HEI' for dtre
      var !num2 eval num for all from !hprop
      despar n$!num2[1]  $!shei
      !!mdsdaccontrol(false)
      !!kRestoreUnits(!currentunits)
      golabel /end
    endhandle
    prompt on

    --<wd>17jan2008 -- Defect No. P-4407
    --   if !!ce.type EQ 'SCTN' then
    if !!ce.type EQ 'SCTN' or !!ce.type EQ 'HSTIFF' then
      --<wd>17jan2008 -- Defect No. P-4407
      !width = prop widt
      same
      var !prop coll all data with dkey eq 'SBFW' for dtre
      var !hprop coll all data with dkey eq 'HEI' for dtre
      var !num1 eval num for all from !prop
      var !num2 eval num for all from !hprop
      despar n$!num1[1]  $!width
      despar n$!num2[1]  $!shei
    endif
    if !!ce.type EQ 'BOX' then
      !box = !!ce
      same
      pin 2 copy pl
      pin 3 copy pl
      pin 2 plane pin 2 clear 0 infront $!box
      pin 3 plane pin 3 clear 0 behind $!box
      !width = !!kStrReal('const dist pin 2 to pin 3')
      var !prop coll all data with dkey eq 'SBFW' for dtre
      var !hprop coll all data with dkey eq 'HEI' for dtre
      var !num1 eval num for all from !prop
      var !num2 eval num for all from !hprop
      despar n$!num1[1]  $!width
      despar n$!num2[1]  $!shei
      !!mdsresetpins(2,3)
    endif

    if(!!mdsGT01.support.type inset ('GT47','GT48')) then

      !dpnumb = !!mdsGetDesp('FWID')
      !dpnuma = !!mdsGetDesp('HEI')
      despa numb $!dpnuma  $!shei
      despa numb $!dpnumb  $!swid
    endif

  elseif !!mdsGT01.support.type.eq('GT14') then
    -- The width of the clamp is controlled by the insulation so therefore
    -- we need to set the width with ( ATTRIB PARA[2 ] + 2 * ATTRIB DESP[25 ] + 2 * ATTRIB DESP[15 ] )
    if (!fromAtta) then
      !current = !!ce
      $!picked
    else
      prev
    endif
    !despar1 = ( ATTRIB para[2 ] + 2 * ATTRIB DESP[25 ] + 2 * ATTRIB DESP[15 ] )
    !height = (prop hei)
    if (!fromAtta) then
      $!current
    else
      next
    endif
    despar n1 $!despar1
    despar n2 $!height
    --<dw>mar2009 dun1119 GT62 to GT64, GT70 to GT72 added
  elseif (!!mdsGT01.support.type inset ('GT44','GT46','GT49','GT60A','GT60B','GT63','GT64','GT70','GT71')) then
    !dpnuma = !!mdsGetDesp('HEI')
    !dpnumb = !!mdsGetDesp('FWID')
    !dpnumc = !!mdsGetDesp('FTHK')

    despa numb $!dpnuma  $!shei
    despa numb $!dpnumb  $!swid
    --<dw>mar2009 dun1119 GT62 to GT64, GT70 to GT72 added
    if (!!mdsGT01.support.type inset ('GT44','GT63','GT64','GT70','GT71')) then
      despa numb $!dpnumc  $!sfthk
    endif
  endif

  !!mdsdaccontrol(false)

  !!kRestoreUnits(!currentunits)

  label /end

  !!mdsGT01.setdefault.active = true
  if !!mdsGT01.support.type.eq('GT06') or !!mdsGT01.support.type.eq('GT14') or !!mdsGT01.support.type.eq('ST06') or !!mdsGT01.support.type.eq('GT46') or !!mdsGT01.support.type.eq('GT49')then
    !!mdsGT01.setdefault.active = false
  endif
  !!mdsGT01.adjust.active = false
  if (!!mdsGT01.support.type inset('ST06','GT46','GT49')) then
    !!mdsGT01.adjust.active = true
  endif

  !!mdsdaccontrol(false)

endfunction
