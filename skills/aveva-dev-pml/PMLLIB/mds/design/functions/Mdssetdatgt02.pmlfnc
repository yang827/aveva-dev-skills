--
-- File:  Mdssetdatgt02.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Creation function for guide Gt02
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatGt02()

  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  !tubeType    = !!mdsOptions.pipes
  !datum       = !!mdsGT02.support.datum
  !name        = !!mdsGT02.name.val
  !alias       = !!mdsGT02.support.alias
  !fromAtta    = !!mdsGT02.support.preliminaryStore.set()

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    return
  endif

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif
  !idtype = 'pipe'
  !purp = 'PIPE'


  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998
  if (!fromAtta.not()) then
    if (!!mdsIdTube(!tubeType, 'Identify $!pipeType of datum $!idtype',!purp).not())then
      return
    endif
  else
    !!ce = object DBREF('/' & !name & '_Pre')
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsGT02.support.idcomp = !idcomp
  !!mdsGT02.support.idbran = !idbran

  -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
  -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

  !currcomp = !!ce
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!hdir neq U and !hdir neq D ) then
    if (!!mdsgradient(!currcomp)) then
      !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
      !!ce = !cecomp
      return
      -- mjb >>> 06.04.06 Stop creation if vertical pipe selected
    endif
  else
    !!alert.message ('Unable to create on vertical pipe')
    !!ce = !cecomp
    return
    -- mjb <<< end of mod
    --endif
  endif


  -- Set Units

  !currentunits = !!kgetsetunits()

  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  -- <ak> 20/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsGT02.support.datum = !!ce
    !!mdsDistance(!!mdsGT02)
  else
    new atta
  endif
  -- </ak> 20/06/2012

  SPKBRK TRUE

  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsGT02.support.replace
    !!alert.error('Unable to select ancillary $!projStandard at this bore($!bore)')
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT02, true)
      return
    endif
    delete atta
    !!kRestoreUnits(!currentunits)
    return
  elsehandle NONE

    ------------------------------------------------------------------------------
    -- mjb >>> 05.04.06 <mds12>
    spref $!choice[1]

    !atta = !!ce

    !lbor = !atta.lbor.real().value()
    !mds12test = !!mdsSetDespars(!atta)

    if (!mds12test.not()) then
      -- The element may exist in the specification but the project may not contain the size in the parameters file
      --if undefined(!!mdsPar$!alias[$!bore]) then
      -- mjb <<< end of mod
      ------------------------------------------------------------------------------
      !projStandard = !!mdsGT02.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <ak> 20/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsGT02, true)
        return
      endif
      delete atta
      !!kRestoreUnits(!currentunits)
      return
    endif
  endhandle
  ------------------------------------------------------------------------------
  -- mjb >>> 05.04.06 <mds12>
  --spref $!choice[1]

  --!!mdsSetDespars(!!ce)
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------

  --<wd>dec2003->>>
  !!mdsDacControl(true)
  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below

  ------------------------------------------------------------------------------
  -- mjb >>> 05.04.06 <mds12>
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!atta.stype,!lbor)

  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT02, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)
  --!check = object MDSCHECKSTD()
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------

  !min = STRING()
  !max = STRING()
  !matError = STRING()

  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT02, true)
      return
    endif
    delete atta
    return
  endif

  -- <ak> 03/07/2012
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentunits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT02, true)
      return
    endif
    delete atta
    return
  endif
  -- </ak> 03/07/2012

  if (!check.insu(!alias,!min,!max).not()) then
    var !insu insu
    !!kformattext.text.val  = $!max
    !maxval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!min
    !minval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!insu
    !insval = !!kformattext.text.val.string(!!distancefmt)
    !!alert.message ('The INSULATION on the identified pipe ($!<insval>$!<units>) is not within the MIN ($!<minval>$!<units>) and MAX ($!<maxval>$!<units>) limits of the Insulation Thickness Values for the selected ancillary support type')
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT02, true)
      return
    endif
    delete atta
    return
  endif

  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below

  !tMin = STRING()
  !tMax = STRING()
  if (!check.temp(!alias,!tMin,!tMax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tMin / $!tMax)')
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT02, true)
      return
    endif
    delete atta
    return
  endif

  -- Test if the ancillary is available at this elevation

  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedElevation = !position.up
    ------------------------------------------------------------------------------
    -- mjb >>> 05.04.06 <mds12>
    !minimumElevation = !mdsattaobj.elevation
    --MJB!minimumElevation = !!mdsPar$!alias[0].despars[1]
    -- mjb <<< end of mod
    ------------------------------------------------------------------------------
    !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedElevation Minimum elevation $!minimumElevation')
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT02, true)
      return
    endif
    delete atta
    return
  endif

  --<wd>dec2003-<<<

  -- Set the ATTA material
  !!mdssetmatref(!!ce)

  !!kRestoreUnits(!currentunits)
  !!mdsDacControl(true)
  -- Name support
  :MDSSuppType |$!!mdsGT02.support.type|
  Name /$!name

  !!mdsSetIspe()

  --  Add stex for isometrics
  call !!mdsTransport(!!ce,!name)

  -- if !name.match('/').eq(1) then
  -- !stex = after(!name, '/')
  -- else
  -- !stex = !name
  -- endif
  -- !tran = subs(!stex, 1, 1)
  -- STEX '$!stex'
  -- $P $!stex

  !!mdsSelLstu(!!ce)
  !!mdsDacControl(true)
  -- Connect to previous member or head
  if (!fromAtta.not()) then
    fconn to prev
    handle any
      pos at prev
      handle any
        pos at ph
      endhandle
    endhandle
  endif

  ori and p3 is d wrt /*

  -- ori p3 is p3 of prev
  -- handle any
  -- ori p3 is d wrt /*
  -- endhandle

  -- Add marker text
  VAR !pOS POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  -- Always add atta to support object
  !!mdsGT02.support.atta.clear()
  !!mdsGT02.support.atta.append(!!ce)
  !!mdsGT02.support.datum  = !!ce
  !!mdsGT02.support.pADir  = Pa Dir wrt world
  !!mdsGT02.support.pLDir  = Pl Dir wrt world
  !!mdsGT02.support.p9Dir  = P9 Dir wrt world

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsGT02.support.atta)

  -- Colour Support
  Call !!kEnhanceList(!colourList)

  -- When finished grey out datum gadget and reset gadgets

  !!mdsSetGadgets(!!mdsGT02,!!ce,!!mdsGT02.support.type)

  !!mdsGT02.datum.active = false
  !!mdsGT02.setDefault.active = true


  -- set focus to the distance text gadget
  !!mdsGT02.dist.setFocus()
  !!mdsDacControl(false)

  -- Reset Units
  !!kRestoreUnits(!currentunits)

endfunction
