--
-- File:  Mdssetdatgt03.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Creation function for guide Gt03
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatGt03()

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  !datum       = !!mdsGT03.support.datum
  !name        = !!mdsGT03.name.val
  !alias       = !!mdsGT03.support.alias
  !fromAtta    = !!mdsGT03.support.preliminaryStore.set()

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- <ak> 21/06/2012
  if (!fromAtta AND defined (!!mdsAutoTubePicker) AND !!mdsAutoTubePicker.enabled()) then
    -- return if limit of pick tries exceeded
    if (!!mdsAutoTubePicker.allowedPicks.eq(0)) then
      !!mdsAutoTubePicker.cancel()
      !!kRestoreUnits(!currentUnits)
      return FALSE
    endif

    !picked = !!mdsAutoTubePicker.pick('ATTA','')
    if unset(!picked) then
      !!alert.warning ('There is no reinforcing plate suitable to guide next to preliminary support.')
      !!mdsAutoTubePicker.cancel()
      !!kRestoreUnits(!currentUnits)
      return false
    else
      !!ce = !picked
    endif

    -- <ak>
  else
    -- Identify reinforcing plate to attach guide to
    prompt off
    prompt load escape 'Identify reinforcing plate to guide'
    ID ATTA @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentUnits)
      return false
    endhandle
    prompt on
  endif

  --xxx    !attaNamn = !!ce.namn
  --xxx    !attaName = !!ce.name
  !atta = !!ce

  -- Is it a reinforcing plate
  -- The styp has to be one of the following
  -- AT05,AT09

  !styp = !!ce.styp

  if (!styp.upcase() inset('AT05','AT09')) then
  else
    !!alert.error('The identified element is not suitable to guide with this type, it must be a reinforcing plate')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  --------------------------------------------------------------------------------
  --xxx  :Guide 'Guide $!name'

  -- Select ancillary

  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle


  -- <ak> 20/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsGT03.support.datum = !!ce
  else
    new atta
  endif
  -- </ak> 20/06/2012

  SPKBRK TRUE

  --xxx  :Guide '$!attaNamn'

  !choice = SELECT SPEC /MDS WITH STYP 'GT03'
  handle any
    !projStandard = !!mdsGT03.support.replace
    !!alert.error('Unable to select ancillary $!projStandard at this bore($!bore)')
    -- <ak> 20/06/2012
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT03, true)
      return
    endif
    delete atta
    return
  elsehandle NONE

    ------------------------------------------------------------------------------
    -- mjb >>> 05.04.06 <mds12>
    spref $!choice[1]

    !guideatta = !!ce

    !lbor = !guideatta.lbor.real().value()
    !mds12test = !!mdsSetDesPars(!guideatta)

    if (!mds12test.not()) then

      -- The element may exist in the specification but the project may not contain the size in the parameters file
      --if undefined(!!mdsparGt03[$!bore]) then
      -- mjb <<< end of mod
      ------------------------------------------------------------------------------
      !projStandard = !!mdsGT03.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      !!kRestoreUnits(!currentUnits)
      -- <ak> 20/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsGT03, true)
        return
      endif
      delete atta
      return
    endif
  endhandle

  ------------------------------------------------------------------------------
  -- mjb >>> 05.04.06 <mds12>
  spref $!choice[1]

  !!mdsSetDesPars(!!ce)
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------

  --<wd>dec2003->>>
  !!mdsDacControl(true)

  ------------------------------------------------------------------------------
  -- mjb >>> 05.04.06 <mds12>
  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!guideatta.stype,!lbor)

  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT03, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)

  --!check = object MDSCHECKSTD()
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------

  !min = STRING()
  !max = STRING()
  !matError = STRING()

  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT03, true)
      return
    endif
    delete atta
    return
  endif

  -- <ak> 03/07/2012
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT03, true)
      return
    endif
    delete atta
    return
  endif
  -- </ak> 03/07/2012

  if (!check.insu(!alias,!min,!max).not()) then
    var !insu insu
    !!kformattext.text.val  = $!max
    !maxval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!min
    !minval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!insu
    !insval = !!kformattext.text.val.string(!!distancefmt)
    !!alert.message ('The INSULATION on the identified pipe ($!<insval>$!<units>) is not within the MIN ($!<minval>$!<units>) and MAX ($!<maxval>$!<units>) limits of the Insulation Thickness Values for the selected ancillary support type')
    !!kRestoreUnits(!currentUnits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT03, true)
      return
    endif
    delete atta
    return
  endif
  --<wd>dec2003-<<<

  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below

  !tMin = STRING()
  !tMax = STRING()
  if (!check.temp(!alias,!tMin,!tMax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tMin / $!tMax)')
    !!kRestoreUnits(!currentUnits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT03, true)
      return
    endif
    delete atta
    return
  endif

  -- Test if the ancillary is available at this elevation

  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedElevation = !position.up
    ------------------------------------------------------------------------------
    -- mjb >>> 05.04.06 <mds12>
    !minimumElevation = !mdsattaobj.elevation
    --!minimumElevation = !!mdsPar$!alias[0].despars[1]
    -- mjb <<< end of mod
    ------------------------------------------------------------------------------
    !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedElevation Minimum elevation $!minimumElevation')
    !!kRestoreUnits(!currentUnits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT03, true)
      return
    endif
    delete atta
    return
  endif

  -- Set the ATTA material
  !!mdssetmatref(!!ce)

  -- Name support
  :MDSSuppType |$!!mdsGT03.support.type|
  Name /$!name
  --xxx  !!ce = !attaName.dbref()

  -- Set Guide Atta :MDSGuideRef to Shoe Atta
  :MDSGuideRef $!atta
  !guide = !!ce

  -- Navigate back to Shoe Atta and Set :MDSGuideRef to Guide Atta
  !!ce  = !atta
  :MDSGuideRef $!guide
  handle ANY
    claim ce
    :MDSGuideRef $!guide
  elsehandle NONE
  endhandle

  --------------------------------------------------------------------------------
  !!mdsResetGuide()
  --xxx  same
  !!ce = !guide

  !!mdsSetIspe()

  --  Add stex for isometrics
  call !!mdsTransport(!!ce,!name)

  -- !stex = after(!name, '/')
  -- !tran = subs(!stex, 1, 1)
  -- STEX '$!stex'

  !!mdsSelLstu(!!ce)

  -- Position atta
  POS AT PREV
  ori and p3 is p3 of prev

  -- Add marker text
  VAR !pOS POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  -- Always add atta to support object
  !!mdsGT03.support.atta.clear()
  !!mdsGT03.support.atta.append(!!ce)
  !!mdsGT03.support.datum  = !!ce
  !!mdsGT03.support.pADir  = Pa Dir wrt world
  !!mdsGT03.support.pLDir  = Pl Dir wrt world
  !!mdsGT03.support.p9Dir  = P9 Dir wrt world

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsGT03.support.atta)

  -- Colour Support
  Call !!kEnhanceList(!colourList)

  -- When finished grey out datum gadget and reset gadgets

  !!mdsSetGadgets(!!mdsGT03,!!ce,!!mdsGT03.support.type)

  !!mdsGT03.datum.active = false

  !!kRestoreUnits(!currentUnits)

  !!ce = !cecomp

endfunction
