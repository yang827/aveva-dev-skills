--
-- File:  Mdssetdatgt04.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Creation function for guide Gt04
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatGt04()

  ------------------------------------
  !currentUnits = !!kGetSetUnits()
  ------------------------------------
  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  !datum       = !!mdsGT04.support.datum
  !name        = !!mdsGT04.name.val
  !alias       = !!mdsGT04.support.alias
  !fromAtta    = !!mdsGT04.support.preliminaryStore.set()

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- <ak> 21/06/2012
  if (!fromAtta AND defined (!!mdsAutoTubePicker) AND !!mdsAutoTubePicker.enabled()) then
    -- return if limit of pick tries exceeded
    if (!!mdsAutoTubePicker.allowedPicks.eq(0)) then
      !!mdsAutoTubePicker.cancel()
      return FALSE
    endif

    !picked = !!mdsAutoTubePicker.pick('PLAT','')
    if unset(!picked) then
      !!alert.warning ('There is no pedestal suitable to stop next to preliminary support.')
      !!mdsAutoTubePicker.cancel()
      !!kRestoreUnits(!currentUnits)
      return false
    else
      !!ce = !picked
    endif
  else
    -- <ak>

    -- Identify pedestal to attach guide to
    prompt off
    prompt load escape 'Identify pedestal to guide'
    ID PLAT ATTA @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentUnits)
      return false
    endhandle
    prompt on

  endif

  --xxx    !attaNamn = !!ce.namn
  --xxx    !attaName = !!ce.name
  !atta = !!ce

  !despar1 = despar[1]
  !styp = !!ce.styp
  if (match(!styp,'10A') gt 0) then
    !despar2 = despar[2]
  elseif (match(!styp,'11A') gt 0) then
    !despar2 = despar[2]
  endif

  -- Is it a pedestal
  -- The styp has to be one of the following
  -- AT10A, AT10B, AT11A, AT11B

  !styp = !!ce.styp

  if (!styp.upcase() inset('AT10A','AT10B','AT11A','AT11B')) then
  else
    !!alert.error('The identified element is not suitable to guide with this type, it must be a pedestal')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  --------------------------------------------------------------------------------
  --xxx  :Guide 'Guide $!name'

  -- Select ancillary

  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  !currentUnits = !!kGetSetUnits()

  -- <ak> 20/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsGT04.support.datum = !!ce
  else
    new atta
  endif
  -- </ak> 20/06/2012

  SPKBRK TRUE
  !!mdsGT04.support.datum  = !!ce

  --xxx  :Guide '$!attaNamn'

  -- The styp to be selected by default is dependant on the pedestal identified

  !!ce = !atta

  !!mdsSetGuideDir('NEW')
  handle any
    -- $P *** $!!error.text **
    !!mdsGT04.support.datum  = nulref
    !projStandard = !!mdsGT04.support.replace
    !!alert.error('Unable to select ancillary $!projStandard at this bore($!bore)')
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT04, true)
      return
    endif
    delete atta
    !!kRestoreUnits(!currentUnits)
    return
  elsehandle none
    -- The element may exist in the specification but the project may not contain the size in the parameters file
    if undefined(!!mdsparGt04[$!bore]) then
      !projStandard = !!mdsGT04.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <ak> 20/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsGT04, true)
        return
      endif
      delete atta
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endhandle

  !!ce = !!mdsGT04.support.datum

  !!mdsSetDesPars(!!ce)
  despar n1 $!despar1
  despar n2 $!despar2
  handle any
  endhandle

  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below
  !check = object MDSCHECKSTD()
  !tMin = STRING()
  !tMax = STRING()
  if (!check.temp(!alias,!tMin,!tMax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tMin / $!tMax)')
    !!kRestoreUnits(!currentUnits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT04, true)
      return
    endif
    delete atta
    return
  endif

  -- <ak> 03/07/2012
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT04, true)
      return
    endif
    delete atta
    return
  endif
  -- </ak> 03/07/2012

  -- Test if the ancillary is available at this elevation

  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedElevation = !position.up
    !minimumElevation = !!mdsPar$!alias[0].despars[1]
    !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedElevation Minimum elevation $!minimumElevation')
    !!kRestoreUnits(!currentUnits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT04, true)
      return
    endif
    delete atta
    return
  endif


  -- Set the ATTA material
  !!mdssetmatref(!!ce)

  -- Name support
  :MDSSuppType |$!!mdsGT04.support.type|
  Name /$!name

  -- Set Guide Atta :MDSGuideRef to Shoe Atta
  :MDSGuideRef $!atta
  !guide = !!ce

  -- Navigate back to Shoe Atta and Set :MDSGuideRef to Guide Atta
  !!ce  = !atta
  :MDSGuideRef $!guide
  handle ANY
    claim ce
    :MDSGuideRef $!guide
  elsehandle NONE
  endhandle

  --> Modified -<wd>-12oct1998
  !pedpldir = pl dir wrt /*
  --< Modified -<wd>-12oct1998

  -- Navigate back to Guide Atta
  !!ce = !guide

  --> Modified -<wd>-12oct1998
  if (!!ce.:MDSGuideRef.styp.upcase().eq('AT10A') or !!ce.:MDSGuideRef.styp.upcase().eq('AT11A')) then
    if (!pedpldir.eq(U WRT /* )) then
      flip
    endif
  endif
  --< Modified -<wd>-12oct1998

  --------------------------------------------------------------------------------
  !!mdsSetIspe()

  --  Add stex for isometrics
  call !!mdsTransport(!!ce,!name)

  -- !stex = after(!name, '/')
  -- !tran = subs(!stex, 1, 1)
  -- STEX '$!stex'

  !!mdsSelLstu(!!ce)

  -- Position atta
  POS AT PREV
  ori and p3 is p3 of prev
  handle any
    ori p3 is p3 of prev
  endhandle

  -- Add marker text
  VAR !pOS POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  -- Always add atta to support object
  !!mdsGT04.support.atta.clear()
  !!mdsGT04.support.atta.append(!!ce)
  !!mdsGT04.support.pADir  = Pa Dir wrt world
  !!mdsGT04.support.pLDir  = Pl Dir wrt world
  !!mdsGT04.support.p9Dir  = P9 Dir wrt world

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsGT04.support.atta)

  -- Colour Support
  Call !!kEnhanceList(!colourList)

  -- When finished grey out datum gadget and reset gadgets

  !!mdsSetGadgets(!!mdsGT04,!!ce,!!mdsGT04.support.type)

  !!mdsGT04.datum.active = false
  !!mdsGT04.guideDir.active = true

  !!kRestoreUnits(!currentUnits)

  !!ce = !cecomp

endfunction
