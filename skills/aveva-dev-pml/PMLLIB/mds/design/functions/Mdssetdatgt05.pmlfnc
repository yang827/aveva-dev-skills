--
-- File:  Mdssetdatgt05.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Thur Dec 18
--
--
-- Description:
-- Sets Datum atta on pipe for guide gt05
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatGt05()


  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()



  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !support  = !!mdsGT05.support
  !datum    = !support.datum
  !name     = !support.stru.name
  !alias    = !!mdsGT05.support.alias
  !fromAtta    = !!mdsGT05.support.preliminaryStore.set()

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif
  !iDType = 'pipe'
  !purp = 'PIPE'

  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998
  if (!fromAtta.not()) then
    if (!!mdsIdTube(!tubeType, 'Identify $!pipeType of datum $!iDType',!purp).not())then
      !!kRestoreUnits(!currentUnits)
      return
    endif
  else
    !!ce = object DBREF(!name & '_Pre')
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsGT05.support.idcomp = !idcomp
  !!mdsGT05.support.idbran = !idbran

  -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
  -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

  !currcomp = !!ce
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!hdir neq U and !hdir neq D ) then
    if (!!mdsgradient(!currcomp)) then
      !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
      !!ce = !cecomp
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endif

  -- The selection of the atta depends on if the pipe is insulated or not

  var !insu insu
  if (!insu.real() eq 0) then
    !styp = 'PIPE-REST'
  else
    !styp = 'AC10'
  endif

  -- <ak> 20/06/2012
  if !fromAtta then
    !!ce = object DBREF(!name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    sel spref with styp '$!styp' spec /MDS
    -- set datum in the form for distance
    !!mdsGT05.support.datum = !!ce
    !!mdsDistance(!!mdsGT05)
  else
    new atta sel spref with styp '$!styp' spec /MDS
  endif
  -- </ak> 20/06/2012


  SPKBRK TRUE
  !!mdsSetDesPars(!!ce)
  !openDir = P9 dir wrt /*
  !open = !openDir.string().split()
  !openVal = !open[1].string()
  !!mdsGT05.openDir.val = 'Open End Direction = $!openVal'

  -- mjb >>> 26.04.06 if not a pipe-rest then run code below (to endif at approx line 202)
  if !!ce.stype.neq('PIPE-REST') then

    -- Check branch temperature is within the limits of the Selected ancillary Standard
    -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
    -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below

    ---------------------------------------------------------------------------------------------------------------
    -- mjb >>> 25.04.06 <mds12>
    !atta = !!ce
    !lbor = !atta.lbor.real().value()
    !mdsattaobj  = object MDSREADPARSDATA()

    !mdsattadefs = !mdsattaobj.mdsdefsdata(!atta.stype,!lbor)
    if (!mdsattadefs.not()) then

      !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
      !!kRestoreUnits(!currentUnits)
      -- <ak> 20/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsGT05, true)
        return
      endif
      delete atta
      !!mdsdaccontrol(FALSE)
      return
    endif
    !check = object MDSCHECKSTD(!mdsattaobj)

    --!check = object MDSCHECKSTD()
    -- mjb <<< 25.04.06 end of mod
    ---------------------------------------------------------------------------------------------------------------
    !tmin = STRING()
    !tmax = STRING()
    if (!check.temp(!alias,!tmin,!tmax).not()) then
      var !temp temp of branch
      !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tmin / $!tmax)')
      !!kRestoreUnits(!currentUnits)
      -- <ak> 20/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsGT05, true)
        return
      endif
      delete atta
      return
    endif

    -- <ak> 03/07/2012
    !criteria = !check.criteria()
    if (!criteria.empty().not()) then
      !!alert.error (!criteria)
      !!kRestoreUnits(!currentUnits)
      if !fromAtta then
        !!mdsRestorePre(!!mdsGT05, true)
        return
      endif
      delete atta
      return
    endif
    -- </ak> 03/07/2012

    -- Test if the ancillary is available at this elevation

    if !check.elevation(!alias).not() then
      !position = !!ce.position.wrt(/* )
      !selectedElevation = !position.up

      ------------------------------------------------------------------------------
      -- mjb >>> 25.04.06 <mds12>
      --!minimumElevation = !!mdsPar$!alias[0].despars[1]
      !minimumElevation = !mdsattaobj.elevation
      -- mjb <<< 25.04.06 end of mod
      ------------------------------------------------------------------------------

      !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedElevation Minimum elevation $!minimumElevation')
      !!kRestoreUnits(!currentUnits)
      -- <ak> 20/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsGT05, true)
        return
      endif
      delete atta
      return
    endif


    -- Set the ATTA material
    !!mdssetmatref(!!ce)

  endif
  -- mjb >>> 26.04.06 end of if not a pipe-rest if statement (starts at approx line 143 above)

  -- set stex for atta
  !sAtta = !!ce
  Call !!mdsTransport(!sAtta,!name)


  !!mdsSelLstu(!!ce)

  -- Always add atta to datum cross bar
  !!mdsGT05.support.bars[1][1] = !!ce.name.dbref()
  !!mdsGT05.support.atta.append(!!ce)
  Call !!mdsCrDatGt05(!insu.real())

  -- Reset Units

  !!kRestoreUnits(!currentUnits)



  -- set focus to the distance text gadget
  !!mdsGT05.dist.setFocus()

endfunction
