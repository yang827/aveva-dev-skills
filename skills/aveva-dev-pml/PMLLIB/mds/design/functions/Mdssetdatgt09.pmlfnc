--
-- File:  Mdssetdatgt09.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATPS131
--
-- Author:  I.osborne
-- Created:  Tue Jul 01
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatGt09()

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !support  = !!mdsGT09.support
  !datum    = !support.datum
  !name     = !support.stru.name
  !fromAtta    = !!mdsGT09.support.preliminaryStore.set()

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif
  !idtype = 'pipe'
  !purp = 'PIPE'

  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998

  if (!fromAtta.not()) then
    if (!!mdsIdTube(!tubeType, 'Identify $!pipeType of datum $!idtype',!purp).not())then
      !!kRestoreUnits(!currentUnits)
      return
    endif
  else
    !!ce = object DBREF(!name & '_Pre')
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsGT09.support.idcomp = !idcomp
  !!mdsGT09.support.idbran = !idbran

  -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
  -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

  !currcomp = !!ce
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!hdir neq U and !hdir neq D ) then
    if (!!mdsgradient(!currcomp)) then
      !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
      !!ce = !cecomp
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endif

  -- Check that the :MDSHv attribute of the template zone to see if horizontal
  -- or vertical pipes are allowed

  if !!mdschecktemp('/MDS/FRAMES/GT09','$!hdir').not() then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- <ak> 20/06/2012
  if !fromAtta then
    !!ce = object DBREF(!name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    sel spref with styp 'PIPE-REST' spec /MDS
    -- set datum in the form for distance
    !!mdsGT09.support.datum = !!ce
    !!mdsDistance(!!mdsGT09)
  else
    new atta sel spref with styp 'PIPE-REST' spec /MDS
  endif
  -- </ak> 20/06/2012


  SPKBRK TRUE
  !!mdsSetDesPars(!!ce)

  --<wd>may2006<mds12>
  -- ****************************************************************************
  -- There is no requirement in MDS or ISODRAFT to SET the MATERIAL etc...
  -- for any type of MDS ANCILLARY "REST" ATTA -- HARD CODED at line 129 above.
  -- Therefore the call to !!mdsetmatref(!!ce) has been commented out.
  -- *** DO NOT UNDO this FIX *** as it will cause a PROBLEMS in MDS12DEV
  -- with UNDEFINED DESPARS DTSE for EVERY BORE size of a PIPE-REST ATTA!!!
  -- ****************************************************************************
  --
  -- Set the ATTA material
  --!!mdssetmatref(!!ce)
  --<wd>may2006<mds12>

  -- set stex for atta
  !sAtta = !!ce
  Call !!mdsTransport(!sAtta,!name)

  !!mdsSelLstu(!!ce)

  -- Always add atta to datum cross bar
  !!mdsGT09.support.bars[1][1] = !!ce.name.dbref()
  !!mdsGT09.support.atta.append(!!ce)
  Call !!mdsCrDatGt09()

  -- If the current element is not an atta then gt09 cannot be selected at this bore
  if !!ce.type.neq('ATTA') then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- The default dimensions are held in the global variables !!mdspargt09[bore].despars
  -- Fill in dimensions 1 2 and 3

  var !bore pa bore

  ---------------------------------------------------------------------------------------------------------------
  -- mjb >>> 25.04.06 <mds12>

  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata('GT09',!bore.real().value())
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT09, true)
      return
    endif
    delete atta
    !!mdsdaccontrol(FALSE)
    return
  endif

  -- <ak> 03/07/2012
  !check = object MDSCHECKSTD(!mdsattaobj)
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT09, true)
      return
    endif
    delete atta
    return
  endif
  -- </ak> 03/07/2012

  !!mdsGT09.dim1.val = !mdsattaobj.despars[1].real()
  !!mdsGT09.dim2.val = !mdsattaobj.despars[2].real()
  !!mdsGT09.dim3.val = !mdsattaobj.despars[3].real()
  !!mdsGT09.dim4.val = !mdsattaobj.despars[4].real()


  -- You can now activate the dimensions gadget if the min/max values are not the same

  if !mdsattaobj.userdps[1].min.neq(!mdsattaobj.userdps[1].max) then
    !!mdsGT09.dim1.active = true
  endif
  if !mdsattaobj.userdps[2].min.neq(!mdsattaobj.userdps[2].max) then
    !!mdsGT09.dim2.active = true
  endif
  if !mdsattaobj.userdps[3].min.neq(!mdsattaobj.userdps[3].max) then
    !!mdsGT09.dim3.active = true
  endif
  if !mdsattaobj.userdps[4].min.neq(!mdsattaobj.userdps[4].max) then
    !!mdsGT09.dim4.active = true
  endif

  -- mjb <<< 25.04.06 end of mod
  ---------------------------------------------------------------------------------------------------------------
  -- Reset Units

  !!kRestoreUnits(!currentUnits)

  -- set focus to the distance text gadget
  !!mdsGT09.dist.setFocus()

endfunction
