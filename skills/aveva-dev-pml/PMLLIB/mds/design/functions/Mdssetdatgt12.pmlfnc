--
-- File: Mdssetdatgt12.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.morris
-- Created:   Tue Oct 28
--
--
-- Description:
-- Creation function for guide gt12
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatGt12()

  -- This standards is available on a baseplate AC18A / B and AC30/AC57

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  !unusedTubeType    = !!mdsOptions.pipes
  !datum       = !!mdsGT12.support.datum
  !name        = !!mdsGT12.name.val
  !alias       = !!mdsGT12.support.alias
  !fromAtta    = !!mdsGT12.support.preliminaryStore.set()

  !unusedCecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- <ak> 21/06/2012
  if (!fromAtta AND defined (!!mdsAutoTubePicker) AND !!mdsAutoTubePicker.enabled()) then
    -- return if limit of pick tries exceeded
    if (!!mdsAutoTubePicker.allowedPicks.eq(0)) then
      !!mdsAutoTubePicker.cancel()
      !!kRestoreUnits(!currentUnits)
      return FALSE
    endif

    !picked = !!mdsAutoTubePicker.pick('PLAT','')
    if unset(!picked) then
      !!alert.warning ('There is no plate suitable to stop next to preliminary support.')
      !!mdsAutoTubePicker.cancel()
      !!kRestoreUnits(!currentUnits)
      return false
    else
      !!ce = !picked
    endif
    -- <ak>
  else
    -- Identify baseplate to attach guide to
    prompt off
    prompt load escape 'Identify baseplate to guide'
    ID PLAT ATTA @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentUnits)
      return false
    endhandle
    prompt on
    !unusedCestyp = !!ce.styp
  endif

  if (!!ce.styp inset('AC18A','AC18B','AC30','AC57','AC60','AC61','AC62','AC63','AC64','AC65','AC67')) then
    -- Allow GUIDES and STOPS on the MDS TRUNNION Base Plate types shown here
  else
    !!alert.error('The identified element is not suitable to guide with this type, it must be a baseplate')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  !unusedBedPlateStyp = !!ce.styp
  !bedPlate = !!ce
  !p3dir = p3 dir wrt /*

  !atta = !!ce

  -- Select ancillary
  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  !!mdsDacControl(true)

  -- <ak> 20/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsGT12.support.datum = !!ce
  else
    new atta
    handle (2,18)
      !!alert.error('Identified element is locked')
      !!mdsDacControl(false)
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
  endif
  -- </ak> 20/06/2012

  SPKBRK TRUE

  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !!mdsDacControl(false)
    !!kRestoreUnits(!currentUnits)
    !projStandard = !!mdsGT12.support.replace
    !!alert.error('Unable to select ancillary $!projStandard at this bore($!bore)')
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT12, true)
      return
    endif
    delete atta
    return
  elsehandle NONE

    -- The element may exist in the specification but the project may not contain the size in the parameters file
    !lbor = !atta.lbor.real()
    !gt12atta = !!ce
    spref $!choice[1]

    !mds12test = !!mdsSetDesPars(!gt12atta)
    if (!mds12test.not()) then

      !!mdsDacControl(false)
      !projStandard = !!mdsGT12.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <ak> 20/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsGT12, true)
        return
      endif
      delete atta
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endhandle

  !!mdsDacControl(true)

  -- If the baseplate uses a non standards size we need to read the PWID abnd PLEN and then
  -- set the PWID PLEN of the guide.
  if !alias inset ('GT11','GT65','GT66','GT67','GT84','ST07','ST33','ST45','ST46','ST47','ST48') then
    !pwid = (prop PWID of $!atta)
    handle NONE
      var !whichData coll all data with dkey eq 'PLEN' for dtre of ce
      !despNum = !whichData[1].dbref().num
      handle NONE
        desp N$!despNum  $!pwid
      elsehandle ANY
      endhandle
    elsehandle ANY
    endhandle
    !plen = (prop PLEN of $!atta)
    handle NONE
      var !whichData coll all data with dkey eq 'PWID' for dtre of ce
      !despNum = !whichData[1].dbref().num
      handle NONE
        desp N$!despNum  $!plen
      elsehandle ANY
      endhandle
    elsehandle ANY
    endhandle

    if !alias inset ('GT11','GT65','GT66','GT67','GT84','ST07','ST45','ST46','ST47','ST48') then
      if !plen.real() GT !pwid.real() then
        var !whichData coll all data with dkey eq 'PLEN' for dtre of ce
        !despNum = !whichData[1].dbref().num
        handle NONE
          desp n$!despNum  $!plen
        elsehandle ANY
        endhandle
      endif
    endif

    ori and p11 is $!p3dir
  else
    !pwid = (prop PWID of $!atta)
    handle NONE
      var !whichData coll all data with dkey eq 'BPWD' for dtre of ce
      !despNum = !whichData[1].dbref().num
      handle NONE
        desp N$!despNum  $!pwid
      elsehandle ANY
      endhandle
    elsehandle ANY
    endhandle
    ori and p11 is $!p3dir
  endif

  if !alias.eq('GT12A') or !alias.eq('GT12B') then
    !pthk = (prop pthk of $!bedPlate)
    handle NONE
      !bpth = (prop bpth of ce)
      !hei = (prop hei of ce)
      !thkDIFF = !hei.real() - !bpth.real()
      !thk = !pthk.real() + !thkDIFF.real()
      !clr = (prop clR of ce)
      desp n19 $!clr
      desp n8 $!thk
    elsehandle ANY
    endhandle
  endif

  !!mdsDacControl(true)

  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!gt12atta.stype,!lbor.real().value())
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT12, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)
  !min = STRING()
  !max = STRING()
  !matError = STRING()

  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT12, true)
      return
    endif
    delete atta
    return
  endif

  -- <ak> 03/07/2012
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT12, true)
      return
    endif
    delete atta
    return
  endif
  -- </ak> 03/07/2012

  if (!check.insu(!alias,!min,!max).not()) then
    var !insu insu
    !!kformattext.text.val  = $!max
    !maxval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!min
    !minval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!insu
    !insval = !!kformattext.text.val.string(!!distancefmt)
    !!alert.message ('The INSULATION on the identified pipe ($!<insval>$!<units>) is not within the MIN ($!<minval>$!<units>) and MAX ($!<maxval>$!<units>) limits of the Insulation Thickness Values for the selected ancillary support type, i.e. $!projStandard')
    !!kRestoreUnits(!currentUnits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT12, true)
      return
    endif
    delete atta
    return
  endif

  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below
  !!mdsDacControl(true)
  !tmin = STRING()
  !tmax = STRING()
  if (!check.temp(!alias,!tmin,!tmax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tmin / $!tmax)')
    !!kRestoreUnits(!currentUnits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT12, true)
      return
    endif
    delete atta
    return
  endif

  -- Test if the ancillary is available at this elevation
  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedElevation = !position.up
    !minimumElevation = !mdsattaobj.elevation
    !!alert.message ('The elevation selected is unsuitable for this ancillary. selected elevation $!selectedElevation Minimum elevation $!minimumElevation')
    !!kRestoreUnits(!currentUnits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT12, true)
      return
    endif
    delete atta
    return
  endif

  -- Set the ATTA material
  !!mdssetmatref(!!ce)

  -- Name support
  !!mdsDacControl(true)
  :MDSSuppType |$!!mdsGT12.support.type|
  name /$!name
  !!ce.:mdsguideref = !atta
  handle ANY
    claim ce
    !!ce.:mdsguideref = !atta
  elsehandle NONE
  endhandle
  !!ce = !atta
  :MDSGuideRef same
  /$!name
  !atta = !!ce

  !!mdsSetIspe()

  !saveori = ori
  CONN
  ori $!saveori

  --  Add stex for isometrics
  call !!mdsTransport(!atta,!name)

  !!mdsSelLstu(!!ce)

  !!mdsDacControl(true)

  !!mdsGetProp(!!mdsGT12.length,!!mdsGT12.plength,'LEN',!bore,!!mdsGT12.support.type)
  !!mdsGetProp(!!mdsGT12.clearance,!!mdsGT12.pclearance,'CLR',!bore,!!mdsGT12.support.type)
  !!mdsGetProp(!!mdsGT12.overlap,!!mdsGT12.poverlap,'OVER',!bore,!!mdsGT12.support.type)

  -- Add marker text
  VAR !pos poS P9 WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  -- Always add atta to support object
  !!mdsGT12.support.atta.clear()
  !!mdsGT12.support.atta.append(!!ce)
  !!mdsGT12.support.datum  = !!ce
  !!mdsGT12.support.paDir  = Pa Dir wrt world
  !!mdsGT12.support.plDir  = Pl Dir wrt world
  !!mdsGT12.support.p9Dir  = P9 Dir wrt world
  !!mdsGT12.support.position = true

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsGT12.support.atta)

  -- Colour Support
  Call !!kenhanceList(!colourList)

  -- When finished grey out datum gadget and reset gadgets
  -- Running This PML function for GT11 and ST07 **incorrectly** resets the
  --'LENGTH' gadget(DKEY 'LEN') to active = false instead of active = true
  -- when DESPAR Numbers 3 and/or 4 are NOT of FIXED LENGTH and MODIFIABLE
  if !alias inset ('GT11','GT65','GT66','GT67','GT84','ST07','ST33','ST45','ST46','ST47','ST48') then
    !!mdsSetGadgets(!!mdsGT12,!!ce,!!mdsGT12.support.type)
  endif

  !!mdsGT12.datum.active = false
  !!mdsGT12.rotAtt.active = TRUE
  !!mdsGT12.setDefault.active = TRUE

  !!mdsDacControl(false)

  !!kRestoreUnits(!currentUnits)

endfunction
