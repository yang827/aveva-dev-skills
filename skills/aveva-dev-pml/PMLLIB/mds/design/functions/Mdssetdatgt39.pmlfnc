--
-- File:  Mdssetdatgt39.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Creation function for guide Gt39
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatGt39()

  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  !tubeType    = !!mdsOptions.pipes
  !datum       = !!mdsGT39.support.datum
  !name        = !!mdsGT39.name.val
  !alias       = !!mdsGT39.support.alias
  !fromAtta    = !!mdsGT39.support.preliminaryStore.set()


  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    return
  endif

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif

  -- <ak> 21/06/2012
  if (!fromAtta AND defined (!!mdsAutoTubePicker) AND !!mdsAutoTubePicker.enabled()) then
    -- return if limit of pick tries exceeded
    if (!!mdsAutoTubePicker.allowedPicks.eq(0)) then
      !!mdsAutoTubePicker.cancel()
      return FALSE
    endif

    !picked = !!mdsAutoTubePicker.pick('ATTA','')
    if unset(!picked) then
      !!mdsGT39.type.val = 2
      !!ce = object DBREF('/' & !name & '_Pre')
    else
      if (!picked.stype inset ('AT52A','AT52B','AT52C','AT52D','AT52E','AT52F','RT01','AT05','AT09','AT23','AT95B','AT65')) then
        !!mdsGT39.type.val = 1
        !!ce = !picked
      else
        return error 1 |The identified atta '$!picked.name' is not a wear plate|
      endif
    endif
  endif
  -- <ak>

  if (!alias eq 'GT39' ) then
    --      $P |find out if we need to id pipe or atta from .type
    if (!!mdsGT39.type.val eq 2 )  then
      -- pipe
      !idtype = 'pipe'
      !!mdsGT39.select.active = TRUE
      !!mdsGT39.dist.active = TRUE
      !!mdsGT39.bthro.active = TRUE
      !!mdsGT39.bdist.active = TRUE
    else
      --atta
      !idtype = 'atta'
      !pipeType = 'Wear Plate Atta'
      !!mdsGT39.select.active = FALSE
      !!mdsGT39.dist.active = FALSE
      !!mdsGT39.bthro.active = FALSE
      !!mdsGT39.bdist.active = FALSE
    endif
  endif
  --!idtype = 'pipe'
  !purp = 'PIPE'

  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998


  --<wd>apr2004
  --    if (!!mdsIdTube(!tubeType, 'Identify $!pipeType of datum $!idtype',!purp).not())then

  if (!fromAtta.not()) then
    if (!!mdsIdTube(!tubeType, 'Identify $!pipeType',!purp).not())then
      return
    endif
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsGT39.support.idcomp = !idcomp
  !!mdsGT39.support.idbran = !idbran

  --<wd>apr2004
  -- CHECK when !idtype is a WEAR PAD that the Identified ATTA is a VALID Wear Pad
  --if (!idcomp.type eq 'ATTA' ) then
  if ((!idtype.upcase().eq('ATTA')) and (!idcomp.type eq 'ATTA' )) then
    --<wd>apr2004

    -- check it is one of the following
    --<wd>16jun2004
    --if (!idcomp.stype inset ('AT52A','AT52B','AT52C','AT52D','AT52E','AT52F','RT01','AT05','AT09','AT23','AT95B')) then
    if (!idcomp.stype inset ('AT52A','AT52B','AT52C','AT52D','AT52E','AT52F','RT01','AT05','AT09','AT23','AT95B','AT65')) then
      --<wd>16jun2004
      --     $P |Yes it is|
    else
      return error 1 |The identified atta '$!idcomp.name' is not a wear plate|
    endif
  endif

  -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
  -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

  !currcomp = !!ce
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!hdir neq U and !hdir neq D ) then
    if (!!mdsgradient(!currcomp)) then
      !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
      !!ce = !cecomp
      return
    endif
  endif

  -- Select ancillary

  -- Set Units

  !currentunits = !!kgetsetunits()

  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  ---------------------------------------------------------------------------------------------------
  --<wd>dec2006<mds12>
  -- Get the GT39 Client CODE in MDS12
  !gt39code = !!mdsgetdefprop('ATTA', 'GT39', 'CCOD')
  --<wd>dec2006<mds12>
  ---------------------------------------------------------------------------------------------------

  --<wd>apr2004 -- Additional CHECKS added to the CODE
  -- Abort Creation if WEAR PAD selected and ATTA bore inset 250 - BEFORE the ATTA is created
  if (!idtype.upcase().eq('ATTA')) then
    if (!bore inset ( 250 )) then
      --<wd>dec2006<mds12>
      --!!alert.error('The MDS standard $!!codegt39 is NOT available on a Wear Plate at this bore($!bore)')
      !!alert.error('The MDS standard $!gt39code is NOT available on a Wear Plate at this bore($!bore)')
      --<wd>dec2006<mds12>
      !!kRestoreUnits(!currentunits)
      return
    endif
  elseif (!idtype.upcase().eq('PIPE')) then
    -- Warn User that a Wear Plate has been Identified
    if (!bore inset ( 250 )) then
      --<wd>16jun2004
      --if (!idcomp.stype inset ('AT52A','AT52B','AT52C','AT52D','AT52E','AT52F','RT01','AT05','AT09','AT23','AT95B')) then
      if (!idcomp.stype inset ('AT52A','AT52B','AT52C','AT52D','AT52E','AT52F','RT01','AT05','AT09','AT23','AT95B','AT65')) then
        --<wd>16jun2004

        --<wd>dec2006<mds12>
        --if (!!alert.confirm('The identified atta is a Wear Plate. At this bore($!bore) a ''$!!codegt39'' is NOT available on a Wear Plate. Do you want to continue?') eq 'NO') then
        if (!!alert.confirm('The identified atta is a Wear Plate. At this bore($!bore) a ''$!gt39code'' is NOT available on a Wear Plate. Do you want to continue?') eq 'NO') then
          --<wd>dec2006<mds12>
          -- Abort Creation of the GUIDE ATTA
          !!kRestoreUnits(!currentunits)
          return
        endif
      endif
    endif
  endif
  --<wd>apr2004

  !!mdsDacControl(true)

  -- <ak> 20/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsGT39.support.datum = !!ce
    !!mdsDistance(!!mdsGT39)
  else
    new atta
  endif
  -- </ak> 20/06/2012

  SPKBRK TRUE

  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsGT39.support.replace
    !!alert.error('Unable to select ancillary ''$!gt39code'' at this bore($!bore)')
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT39, true)
      return
    endif
    delete atta
    !!kRestoreUnits(!currentunits)
    return
  elsehandle NONE
    ------------------------------------------------------------------------------
    -- mjb >>> 07.04.06 <mds12>
    spref $!choice[1]

    !atta = !!ce

    !lbor = !atta.lbor.real().value()
    !mds12test = !!mdsSetDespars(!atta)

    if (!mds12test.not()) then

      -- The element may exist in the specification but the project may not contain the size in the parameters file
      --if undefined(!!mdsPar$!alias[$!bore]) then
      -- mjb <<< end of mod
      ------------------------------------------------------------------------------
      !projStandard = !!mdsGT39.support.replace
      --<wd>apr2004
      --!!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      --<wd>dec2006<mds12>
      --!!alert.error('Unable to select ancillary ' & !!codegt39 & ' at this bore(' & !bore & ')')
      !!alert.error('Unable to select ancillary ' & !gt39code & ' at this bore(' & !bore & ')')
      --<wd>dec2006<mds12>
      --<wd>apr2004
      -- <ak> 20/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsGT39, true)
        return
      endif
      delete atta
      !!kRestoreUnits(!currentunits)
      return
    endif
  endhandle

  ------------------------------------------------------------------------------
  -- mjb >>> 07.04.06 <mds12>
  --spref $!choice[1]

  --!!mdsSetDespars(!!ce)
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------

  --<wd>apr2004
  -- Calculate the ANGLE and set the ANGLE for DESPAR number 12
  !angle  = atan (!!ce.despar[1] / !!ce.despar[2])
  !!ce.despar[12] = !angle

  -- Calculate and set the Horizontal and Vertical OFFSETS/DIFFERENCES for DESPAR numbers 7 & 13 respectively
  !vertp = sin (!angle) * (!!ce.lod / 2 + !!ce.despar[9] + !!ce.despar[4])
  !vertg = (!!ce.lod / 2 + !!ce.despar[9]) - (!!ce.despar[2] / 2 )

  -- Determine if P18 and P19 (at the centre of the GUIDE FACE ) is ABOVE or BELOW the Guides' Tangential Point ON the PIPE OD
  -- Calculate the Vertical Difference and Determine if the Horizontal difference is '-' or '+'
  if (!vertg.gt(!vertp)) then
    !vdiff = +(!vertg - !vertp)
    !hsign = '-'
  else
    !vdiff = -(!vertp - !vertg)
    !hsign = '+'
  endif

  --Calculate the Horizontal difference
  !hdiff = !vdiff * tan (!angle)

  -- Set DESPARS 7 & 13
  !!ce.despar[7]  = !hdiff
  !!ce.despar[13] = !vdiff
  --<wd>apr2004


  -- If atta eq wear plate reset num 9 to plate thickness
  --<wd>apr2004
  --  if (!idcomp.type eq 'ATTA' ) then
  if ((!idtype.upcase().eq('ATTA')) and (!idcomp.type eq 'ATTA' )) then
    --<wd>apr2004
    !wpThk = !!mdsGT39.support.idcomp.prop.tHK
  else
    !wpThk = 0
  endif
  desp n 9 $!wpThk

  !!mdsDacControl(true)
  ------------------------------------------------------------------------------
  -- mjb >>> 07.04.06 <mds12>
  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below

  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!atta.stype,!lbor)

  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT39, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)

  --!check = object MDSCHECKSTD()
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------

  !min = STRING()
  !max = STRING()
  !matError = STRING()

  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT39, true)
      return
    endif
    delete atta
    return
  endif

  -- <ak> 03/07/2012
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentunits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT39, true)
      return
    endif
    delete atta
    return
  endif
  -- </ak> 03/07/2012

  if (!check.insu(!alias,!min,!max).not()) then
    var !insu insu

    !!kformattext.text.val  = $!max
    !maxval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!min
    !minval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!insu
    !insval = !!kformattext.text.val.string(!!distancefmt)
    !!alert.message ('The INSULATION on the identified pipe ($!<insval>$!<units>) is not within the MIN ($!<minval>$!<units>) and MAX ($!<maxval>$!<units>) limits of the Insulation Thickness Values for the selected ancillary support type')
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT39, true)
      return
    endif
    delete atta
    return
  endif

  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below

  !tMin = STRING()
  !tMax = STRING()
  if (!check.temp(!alias,!tMin,!tMax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tMin / $!tMax)')
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT39, true)
      return
    endif
    delete atta
    return
  endif

  -- Test if the ancillary is available at this elevation

  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedElevation = !position.up
    ------------------------------------------------------------------------------
    -- mjb >>> 26.04.06 <mds12>
    !minimumElevation = !mdsattaobj.elevation
    --!minimumElevation = !!mdsPar$!alias[0].despars[1]
    -- mjb <<< end of mod
    ------------------------------------------------------------------------------
    !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedElevation Minimum elevation $!minimumElevation')
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsGT39, true)
      return
    endif
    delete atta
    return
  endif


  -- Set the ATTA - UDA :MDSMatRef with the PROPCON Property, if it is declared in the dimensions default file
  !!mdssetmatref(!!ce)

  !!kRestoreUnits(!currentunits)
  !!mdsDacControl(true)
  -- Name support
  :MDSSuppType |$!!mdsGT39.support.type|
  Name /$!name

  !!mdsSetIspe()

  --  Add stex for isometrics
  call !!mdsTransport(!!ce,!name)

  -- if !name.match('/').eq(1) then
  -- !stex = after(!name, '/')
  -- else
  -- !stex = !name
  -- endif
  -- !tran = subs(!stex, 1, 1)
  -- STEX '$!stex'
  -- $P $!stex

  !!mdsSelLstu(!!ce)
  !!mdsDacControl(true)
  -- Connect to previous member or head
  if (!fromAtta.not()) then
    fconn to prev
    handle any
      pos at prev
      handle any
        pos at ph
      endhandle
    endhandle
  endif

  ori and p3 is d wrt /*

  -- ori p3 is p3 of prev
  -- handle any
  -- ori p3 is d wrt /*
  -- endhandle

  -- Add marker text
  VAR !pOS POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  -- Always add atta to support object
  !!mdsGT39.support.atta.clear()
  !!mdsGT39.support.atta.append(!!ce)
  !!mdsGT39.support.datum  = !!ce
  !!mdsGT39.support.pADir  = Pa Dir wrt world
  !!mdsGT39.support.pLDir  = Pl Dir wrt world
  !!mdsGT39.support.p9Dir  = P9 Dir wrt world

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsGT39.support.atta)

  -- Colour Support
  Call !!kEnhanceList(!colourList)

  -- When finished grey out datum gadget and reset gadgets

  !!mdsSetGadgets(!!mdsGT39,!!ce,!!mdsGT39.support.type)

  !!mdsGT39.datum.active = FALSE

  --<wd>apr2004 -- Deactivate TYPE gadget
  --  !!mdsGT39.setDefault.active = true
  !!mdsGT39.type.active = FALSE
  --<wd>apr2004

  -- set focus to the distance text gadget
  !!mdsGT39.dist.setFocus()
  !!mdsDacControl(false)

  -- Reset Units
  !!kRestoreUnits(!currentunits)

endfunction
