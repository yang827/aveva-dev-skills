--
-- File:  Mdssetdatht01.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Creation function for hanger ht01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatHt01()

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  !datum       = !!mdsht01.support.datum
  !name        = !!mdsht01.name.val
  !alias       = !!mdsht01.support.alias

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  prompt off
  prompt load escape 'Identify trunnion to support hanger from'
  ID ATTA @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentUnits)
    return false
  endhandle
  prompt on

  -- The identified atta must be be a tt02 trunnion type d for this hanger type

  !spref = !!ce.spref.name
  !trunnionName = !!ce

  if (Match(|$!spref|,|TT02-D|) eq 0) then
    !!alert.error('Identified trunnion is not suitable')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  !trunnionSize = !!ce.styp.after('TT02-D-').before('-')
  -- !trunnionSize = !trunnionSize.before('-')

  -- The available clevis size can be worked out from the at08 standard
  -- Load the appropiate suffix codes for ht01 or ht02

  !codes = ARRAY()

  if (!trunnionSize eq '2') then
    !codes.append('B')
    !codes.append('C')
  elseif (!trunnionSize eq '3') then
    !codes.append('D')
    !codes.append('E')
  elseif (!trunnionSize eq '4') then
    !codes.append('F')
    !codes.append('G')
  elseif (!trunnionSize eq '6') then
    !codes.append('H')
    !codes.append('J')
  elseif (!trunnionSize eq '8') then
    !codes.append('K')
    !codes.append('L')
  elseif (!trunnionSize eq '10') then
    !codes.append('M')
  elseif (!trunnionSize eq '12') then
    !codes.append('N')
    !codes.append('P')
  elseif (!trunnionSize eq '14') then
    !codes.append('Q')
  elseif (!trunnionSize eq '16') then
    !codes.append('R')
  elseif (!trunnionSize eq '18') then
    !codes.append('S')
  else
    !!alert.error('Unable to find a clevis to match the trunnion bore')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  !!mdsht01.clevis.dtext = !codes
  !!mdsht01.clevis.rtext = !codes

  --var !mode mode
  forwards
  !where = ''
  !to = ''

  -- Identified trunnion must have it's pa or pl pointing down
  -- to position support
  !patest = pa dir wrt /*
  !pltest = pl dir wrt /*
  if ('$!patest' eq 'D WRT /*' or '$!patest' eq '-Z WRT /*') then
    !where = 'before'
    !to = 'to next'
  elseif ('$!pltest' eq 'D WRT /*' or '$!pltest' eq '-Z WRT /*') then
    !where = ''
    !to = ''
  else
    !!alert.error('Identified trunnion is not in the correct orientation to use this support')
  endif

  -- Select anciliary
  if(!!kGetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif
  $!boreUnits
  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  -- get despar 1 from trunnion to set at the hanger

  var !dp2 despar 1

  new atta $!where
  SPKBRK TRUE

  :MDSSref $!trunnionName
  !code = !!mdsht01.clevis.selection('RTEXT')

  !choice = SELECT SPEC /MDS WITH STYP '$!alias-$!code-A'
  handle any
    delete atta
    !projStandard = !!mdsht01.support.replace
    !!alert.error('Unable to select anciliary $!projStandard at this bore($!bore)')
    !!kRestoreUnits(!currentUnits)
    return
  endhandle
  units mm bore
  spref $!choice[1]

  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsht01.support.type|

  !!mdsSetIspe()

  --  Add stex for isometrics


  -- set stex for atta
  !sAtta = !!ce
  Call !!mdsTransport(!sAtta,!name)


  !!mdsSelLstu(!!ce)

  fconn $!to
  handle (7,35)
    pos at next
    ori
  endhandle

  -- Make sure p3 is pointing u, if not flip ori

  !p3udir = p3 dir wrt /*
  if (!p3udir.string() neq 'U WRT /*' and !p3udir.string() neq 'Z WRT /*') then
    flip
    ori
  endif

  -- Set design pars
  -- Set rodlength to minimum value as defined in the default file

  despar 500mm $!dp2
  -- The rod length is the distance between p41 and and p42 not design para
  -- 2 so sort out the diff and add it
  !p41p42 = !!kStrReal('const dist p41 to p42')
  !diff = (500 - !p41p42)
  !dp1  = (500 + !diff)
  !dp1  = (!dp1 - (500 - !!mdsOptions.minHangRod))
  despar $!dp1 $!dp2
  !rodLength = !!mdsOptions.minHangRod
  !!mdsht01.rodLength.val = !rodLength

  -- Add marker text
  VAR !pOS POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  -- Always add atta to support object
  !!mdsht01.support.atta.clear()
  !!mdsht01.support.atta.append(!!ce)
  !!mdsht01.support.datum  = !!ce
  !!mdsht01.support.pADir  = Pa Dir wrt world
  !!mdsht01.support.pLDir  = Pl Dir wrt world

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsht01.support.atta)

  -- Colour Support
  Call !!kEnhanceList(!colourList)

  -- When finished grey out datum gadget and reset the other gadgets
  !!mdsht01.datum.active = false
  !!mdsht01.bedplate.active = true
  !!mdsht01.setSteel.active = true
  !!mdsht01.rotate.active = true
  !!mdsht01.rodLength.active = true
  !!mdsht01.pRodLength.active = true
  !!mdsht01.clevis.active = true
  --!!mdsht01.washer.active = true
  --wd-aug2000
  !!mdsht01.washer.active = false

  -- Reset Units

  !!kRestoreUnits(!currentUnits)

  -- End function
endfunction
