--
-- File:  Mdssetdatht03.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Creation function for hanger ht03
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatHt03()

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType    = !!mdsoptions.pipes
  !datum       = !!mdsHT03.support.datum
  !name        = !!mdsHT03.name.val
  !alias       = !!mdsHT03.support.alias

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif
  !idtype = 'pipe'
  !purp = 'PIPE'

  label /again

  if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of $!idtype','$!purp').not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif

$(
  ------------------------------
  --> Modified - <wd> - 14sep1998
  !write = STRING()
  !lock  = STRING()
  if (!!kcheckwrite(!!ce, !lock , !write).not()) then
    -- READ ONLY Access to the '!idtype'
    if (!write.eq('R')) then
      !!alert.error('The Identified $!idtype is in a READ ONLY Database. Select another $!idtype')
      golabel /again
      -- WRITE Access to the '!idtype', BUT it is LOCKED
    elseif (!lock.eq('Locked')) then
      !!alert.error('The Identified $!idtype is LOCKED. Select another $!idtype')
      golabel /again
    endif
  endif
  --< Modified - <wd> - 14sep1998
  ------------------------------
$)
  -- Check if pipe is on a slope, there are two variables (members of Mdsoptions)
  -- that it uses. .maxpiva is the maximum pivit angle that is allowed and
  -- .maxpwar is the angle at which we should warn the user. Also the .maxHang
  -- which is the minimum distance from a hanger pivot point to the under side of
  -- the steelwork

  !identified = !!ce
  !identifiedPldir = pl dir wrt world of $!identified
  handle (2,201) (2,252)
    !identifiedPldir = ph dir wrt world of $!identified
  endhandle

  var !atline  const line $!identifiedPldir thro pl of $!identified.name
  handle (2,252)
    var !atline const line $!identifiedPldir thro ph
  endhandle
  var !nat const line project $!atline on plane u wrt /* thro e0n0u0 wrt /*
  var !angle const angle $!nat $!atline
  handle (47,62)
    -- Vertical line
    var !angle '90'
  endhandle

  if (!angle.real() ge !!mdsoptions.maxpwar and !angle.real() lt !!mdsoptions.maxpiva) then
    if (!!alert.confirm ('The pipe identified is at an angle of $!angle Are you sure you want to continue?') eq 'NO') then
      !!ce = !cecomp
      !!kRestoreUnits(!currentUnits)
      return
    endif
  elseif (!angle.real() gt !!mdsoptions.maxpiva) then
    !!alert.message ('The pipe identified is not within the maximum angle for supportable pipes as defined in the application defaults ($!!mdsoptions.maxpiva)')
    !!ce = !cecomp
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Select anciliary

  if(!!kGetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif
  $!boreUnits

  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  new atta
  SPKBRK TRUE

  -- Spref will be selected from the alias name i.e the first 4 chars
  -- HT03A,HT03B,HT04A,HT04B,HT05A,HT05B,HT06A,HT06B
  -- HT07,HT08,HT09,HT10

  !part1 = (subs('$!alias',1,4))
  !part2 = (subs('$!alias',5,5))
  if (!part2 eq '') then
    !styp = !part1
  else
    !styp = !part1 + '-' + !part2
  endif
  !choice = SELECT SPEC /MDS WITH STYP '$!styp-A'
  handle any
    delete atta
    !projStandard = !!mdsHT03.support.replace
    !!alert.error('Unable to select hanger $!projStandard at this bore($!bore)')
    !!kRestoreUnits(!currentUnits)
    return
  endhandle
  units mm bore
  spref $!choice[1]

  -- Initally set height to 500mm and angle to 0
  !height = 500
  despar $!height 0mm

  -- connect to prev member and set distance gadget

  fconn to prev
  handle any
    fconn
  endhandle

  !!mdsDistance(!!mdsHT03)

  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsHT03.support.type|

  !!mdsSetIspe()

  --  Add stex for isometrics

  -- set stex for atta
  !sAtta = !!ce
  Call !!mdsTransport(!sAtta,!name)


  !!mdsSelLstu(!!ce)

  -- Add marker text
  VAR !pOS POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  -- Always add atta to support object
  !!mdsHT03.support.atta.clear()
  !!mdsHT03.support.atta.append(!!ce)
  !!mdsHT03.support.datum  = !!ce
  !!mdsHT03.support.pADir  = Pa Dir wrt world
  !!mdsHT03.support.pLDir  = Pl Dir wrt world

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsHT03.support.atta)

  -- Colour Support
  Call !!kEnhanceList(!colourList)

  -- When finished grey out datum gadget and reset height,length and setsteel

  -- !!mdsSetGadgets(!!mdsHT03,!!ce,!!mdsHT03.support.type)

  !!mdsHT03.datum.active = false
  !!mdsHT03.bedplate.active = true
  !!mdsHT03.setSteel.active = true
  !!mdsHT03.pRodLength.active = true
  !!mdsHT03.rodLength.active = true
  !!mdsHT03.pCAngle.active = true
  !!mdsHT03.cAngle.active = true
  !!mdsHT03.washer.active = true

  -- Set rodlength to minimum value as defined in the default file
  -- Set angle and check if rod is up if not negate angle
  -- The rod length is the distance between p41 and and p42
  -- so sort out the diff and add it

  despar 500mm $!angle
  !p41p42 = !!kStrReal('const dist p41 to p42')
  !diff = (500 - !p41p42)
  !dp1 = (500 + !diff)
  !dp1 = (!dp1 - (500 - !!mdsoptions.minHangRod))
  despar $!dp1 $!angle
  var !p42dir P42 dir wrt /*
  if (!p42dir neq 'U' and !p42dir neq 'Z') then
    despar $!dp1 -$!angle
  endif
  !!mdsHT03.rodLength.val = !!mdsoptions.minHangRod
  !!mdsHT03.cAngle.val = !angle


  -- Reset Units

  !!kRestoreUnits(!currentUnits)


  -- set focus to the distance text gadget
  !!mdsHT03.dist.setFocus()
  -- End function
endfunction
