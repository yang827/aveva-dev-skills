--
-- File:    Mdssetdatlt04.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.morris
-- Created:   Tue Oct 28
--
--
--

-- Description:
-- Creation function for general ancillary lt04
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatlt04()

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !datum    = !!mdsLT04.support.datum
  !name     = !!mdsLT04.name.val
  !alias    = !!mdsLT04.support.alias
  !replace  = !!mdsLT04.support.replace
  !isImperial   = !!isImperialLength('DIST')

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif
  !iDType = 'pipe'
  !purp = 'PIPE'

  label /again
  if (!!mdsIdTube(!tubeType, 'Identify $!pipeType of $!iDType',!purp).not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  forwards
  !where = ''

  -- Check Pipe is Vertical
  if (!!ce.type eq 'BRAN') then
    pin 9 copy ph
    !pltest = ph dir wrt /*
    var !p9dir pin 9 dir wrt /*
    if ('$!p9dir' neq |U|) and ('$!p9dir' neq |D|) then
      !!alert.error('Identified tube must be vertical')
      !!mdsResetPins(9,9)
      golabel /again
    endif
    !!mdsResetPins(9,9)
  else
    !pltest = pl dir wrt /*
    if ('$!pltest' eq |U WRT /*|) or ('$!pltest' eq |D WRT /*|) then
    else
      !!alert.error('Identified tube must be vertical')
      !!mdsResetPins(9,9)
      golabel /again
    endif
    !!mdsResetPins(9,9)
  endif

  -- Select ancillary
  if(!!kGetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif

  $!boreUnits
  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  !currentUnits = !!kGetSetUnits()

  -- <sk> 05/06/2012
  !fromAtta = !!mdsLT04.support.preliminaryStore.set()
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsLT04.support.datum = !!ce
    -- Set distance gadget
    !!mdsDistance(!!mdsLT04)
  else
    new atta $!where
  endif
  -- <sk> 05/06/2012

  spkbrk true
  --$P SELECT SPEC /MDS WITH STYP '$!alias'
  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsLT04.support.replace
    !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsLT04, true)
      return
    endif
    delete atta
    return
  elsehandle none
    -- The element may exist in the specification but the project may not contain the size in the parameters file
    ------------------------------------------------------------------------------
    -- mjb >>> 02.05.06 <mds12>

    --if undefined(!!mdsPar$!alias[$!bore]) then
    units mm bore
    spref $!choice[1]

    !atta = !!ce
    !lbor = !atta.lbor.real().value()
    !mds12test = !!mdsSetDespars(!atta)
    if (!mds12test.not()) then
      -- <sk> 04/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsLT04, true)
        return
      endif
      !projStandard = !!mdsLT04.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      !!kRestoreUnits(!currentUnits)
      -- <sk> 04/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsLT04, true)
        return
      endif
      delete atta
      return
    endif
  endhandle
  --mm bore
  --spref $!choice[1]

  --!!mdsSetDespars(!!ce)
  !!mdsDacControl(true)

  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below

  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!atta.stype,!lbor)
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsLT04, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)

  --!check = object MDSCHECKSTD()

  -- mjb <<< 02.05.06 end of mod
  ------------------------------------------------------------------------------

  !min = STRING()
  !max = STRING()
  !matError = STRING()


  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsLT04, true)
      return
    endif
    delete atta
    return
  endif

  if (!check.insu(!alias,!min,!max).not()) then
    var !insu insu
    if( !isImperial ) then
      !units = 'mm'
    else
      !units = 'in'
    endif
    !!kformattext.text.val  = $!max$n
    !maxval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!min$n
    !minval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!insu$n
    !insval = !!kformattext.text.val.string(!!distancefmt)
    !!alert.message ('The INSULATION on the identified pipe ($!<insval>$!<units>) is not within the MIN ($!<minval>$!<units>) and MAX ($!<maxval>$!<units>) limits of the Insulation Thickness Values for the selected ancillary support type, i.e. $!replace')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsLT04, true)
      return
    endif
    delete atta
    return
  endif

  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below

  !tMin = STRING()
  !tMax = STRING()
  if (!check.temp(!alias,!tMin,!tMax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tMin / $!tMax)')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsLT04, true)
      return
    endif
    delete atta
    return
  endif

  -- Test if the ancillary is available at this elevation

  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedElevation = !position.up
    ------------------------------------------------------------------------------
    -- mjb >>> 02.05.06 <mds12>
    --!minimumElevation = !!mdsPar$!alias[0].despars[1]
    !minimumElevation = !mdsattaobj.elevation
    -- mjb <<< 02.05.06 end of mod
    ------------------------------------------------------------------------------

    !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedElevation Minimum elevation $!minimumElevation')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsLT04, true)
      return
    endif
    delete atta
    return
  endif

  -- <sk> 06/07/2012 Check user criteria
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsLT04, true)
      return
    endif
    delete atta
    return
  endif
  -- <sk> 06/07/2012

  -- Set the ATTA material
  !!mdssetmatref(!!ce)

  !!mdsDacControl(true)
  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsLT04.support.type|

  !!mdsSetIspe()

  --  Add stex for isometrics
  -- set stex for atta
  !sAtta = !!ce
  Call !!mdsTransport(!sAtta,!name)

  !!mdsSelLstu(!!ce)

  !!mdsDacControl(true)
  -- <sk> 04/06/2012
  -- do not modify POS in atta from preliminary
  if !fromAtta.not() then
    POS AT PREV
    handle any
      pos at ph
    endhandle
  endif

  -->>>-<wd>aug2002
  --ori
  if (|$!pltest| eq |U WRT /*|) then
    flip ori
  else
    ori
  endif
  --<<<-<wd>aug2002

  -- Always add atta to support object
  !!mdsLT04.support.atta.clear()
  !!mdsLT04.support.atta.append(!!ce)
  !!mdsLT04.support.datum  = !!ce
  !!mdsLT04.support.pADir  = Pa Dir wrt world
  !!mdsLT04.support.pLDir  = Pl Dir wrt world
  !!mdsLT04.support.p9Dir  = P9 Dir wrt world

  -- Add marker text
  !!mdsaidtext(!!mdsLT04)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsLT04.support.atta)

  -- Colour Support
  Call !!kEnhanceList(!colourList)

  -- When finished grey out datum gadget and reset height,length and setsteel
  !!mdsSetGadgets(!!mdsLT04,!!ce,!!mdsLT04.support.type)
  !!mdsLT04.datum.active = false


  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- set focus to the distance text gadget
  !!mdsLT04.dist.setFocus()

  !!mdsDacControl(false)

  -- End function
endfunction
