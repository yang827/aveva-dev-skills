--
-- File: Mdssetdatlt05.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.morris
-- Created:   Tue Oct 28
--
--
-- Description:
-- Creation function for general ancillary lt05
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatlt05(!onType is STRING)

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kgetSetUnits()

  -- Initialise variables
  !unusedDatum       = !!mdsLt05.support.datum
  !unusedName        = !!mdsLt05.name.val
  !type        = !!mdsLt05.support.type
  !alias       = !!mdsLt05.support.alias
  !fromAtta    = !!mdsLt05.support.preliminaryStore.set()

  -- if (!datum.set()) then
  --   !!alert.error('Atta for support $!name already exists')
  --   !!kRestoreUnits(!currentUnits)
  --   return
  -- endif

  if !onType.eq('ELBO') then
    if (!!mdsIdTube('ELBO','Identify elbow of pipe','PIPE').not())then
      !!kRestoreUnits(!currentUnits)
      return
    endif
  else
    if (!!mdsIdTube('TUBE','Identify tube of pipe','PIPE').not())then
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endif

  forwards


  if !onType.eq('ELBO') then
    -- Identified elbo must have either the pa or pl pointing D
    !patest = pa dir wrt /*
    !pltest = pl dir wrt /*
    var !radius const dist p0 to p1
    if ('$!patest' eq 'D WRT /*') or ('$!pltest' eq 'D WRT /*') or ('$!patest' eq '-Z WRT /*') or ('$!pltest' eq '-Z WRT /*') then
    else
      !!alert.error('Identified elbow is not suitable for a hanger lug')
      !!kRestoreUnits(!currentUnits)
      -- <sk> 04/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsLt05, true)
      endif
      return
    endif
  else
    !patest = pa dir wrt /*
    handle (2,252) $* selected hstu
      !patest = pa dir of first mem wrt /*
      handle any
        !patest =  tdir wrt /*
      endhandle
    endhandle
    !pltest = pl dir wrt /*
    handle (2,252) $* selected hstu
      !pltest = hdir wrt /*
    endhandle
    var !radius pl od
    handle (2,252)
      var !radius ph od
    endhandle
    !rradius = (!radius.real() / 2)
    !radius = !rradius.string()
  endif

  -- Check pipe material

  !pipeMat = !!ce.owner.pspe.:MDSPipeMat
  handle any
    !pipeMat = !!ce.pspe.:MDSPipeMat
  endhandle
  !bore   = pa bore
  handle any
    var !bore ph bore
  endhandle

  -- Check if current selected bore is available

  ------------------------------------------------------------------------------
  -- mjb >>> 02.05.06 <mds12>

  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!alias,!bore.real().value())

  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsLt05, true)
    endif
    !!mdsDacControl(FALSE)
    return
  endif

  !unusedBoreCheck = !mdsattaobj.pipeMaterial
  handle any
    !!kRestoreUnits(!currentUnits)
    !!alert.error('Bore $!bore is not within the available bores')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsLt05, true)
    endif
    return
  endhandle

  -- Get material types

  !stanMat = !mdsattaobj.pipeMaterial

  --!stanMat = !!mdsParlt05a[0].pipeMaterial
  --  handle any
  --    !stanMat = !!mdsParlt05a[$!bore].pipeMaterial
  --  endhandle

  -- mjb <<< 02.05.06 end of mod
  ------------------------------------------------------------------------------

  !matList = !stanMat.split(',')
  !findIt  =  !matList.findfirst(!pipeMat)

  if !findIt.string().eq('') then
    !findIt = 0
  endif

  if !stanMat.upcase().eq('UNSET') then
    !!alert.error('The MDS material code of the MDS standard is unset. Aborting creation!')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsLt05, true)
    endif
    return
  endif

  if !pipeMat.upcase().eq('UNSET') then
    !!alert.error('The MDS material code of the pipe specification is unset. Aborting creation!')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsLt05, true)
    endif
    return
  endif

  if !findIt.eq(0) then
    !!alert.error('The identified pipe specification has a MDS material code of $!pipeMat and does not match the MDS standards material code/s of $!stanMat')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsLt05, true)
    endif
    return
  endif

  -- Finished material checking

  forwards

  -- Check to see if the elbo is of the correct type for a connection
  !!mdsDacControl(true)
  if !onType.eq('ELBO') then
    if !!mdsSelectComp(!!ce.type).not() then
      !!alert.error('Unable to find a suitable elbow in the current specification')
      !!kRestoreUnits(!currentUnits)
      !!mdsDacControl(false)
      -- <sk> 04/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsLt05, true)
      endif
      return
    endif
  else
    -- dtf >>> removed to allow plate to be added to sloping lines
    !unusedCurrcomp = !!ce
    --if !!mdsgradient(!currcomp) then
    --  !!mdsResetPins(9,9)
    --  !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsoptions.slope.val)')
    --  !!kRestoreUnits(!currentUnits)
    --  return
    --endif
    -- dtf <<< End of Mod
  endif

  !!mdsDacControl(true)

  if !onType.eq('ELBO') then
    !patest = pa dir wrt /*
    !pltest = pl dir wrt /*
    if !!ce.ppos[3].up.gt(!!ce.ppos[2].up) then
      flip ori
      ori pa is $!patest and pl is $!pltest
    endif

    -- Create branch and select elements
    --<dw>aug2008 dun979 - flow direction turned off
    new bran flowdir OFF
    :MDSTrun true
    connect ph to p3 of same
    handle (42,64)
    endhandle

  else
    !teeOD = pl bore
    handle (2,252)
      !teeOD = ph bore
    endhandle
    new tee
    if !!mdsSelectComp(!!ce.type).not() then
      !!alert.error('Unable to find a suitable tee in the current specification')
      !!mdsDacControl(true)
      delete tee
      !!mdsDacControl(false)
      !!kRestoreUnits(!currentUnits)
      -- <sk> 04/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsLt05, true)
      endif
      return
    endif
    !!mdsDacControl(true)

    -- spref $!foundTee
    sel lstu
    lea 3
    dir d
    lea 2
    !paod = pa od
    !dist = !paod / 2 + 100mm
    dist $!dist from pl of prev
    handle any
      dist $!dist from ph
    endhandle
    !!mdsLt05.dist.val = $!dist
    !unusedP5dir = pl dir wrt /*

    --<dw>aug2008 dun979 - flow direction turned off
    new bran flowdir OFF
    :MDSTrun true
    conn ph to same
  endif



  hdir u tdir d
  sel hstu
  pipe
  -- <sk> 05/06/2012 error with unnamed pipes
  if isnamed then
    !branName = name & '/' & !!mdsLt05.name
  else
    !branName = '//' & !!mdsLt05.name
  endif
  same
  name $!branName
  -- <sk> 05/06/2012 end

  !unusedTod = ph od
  !phBore = ph bore

  -- !hyp = !radius.real() + (!od / 2)
  -- !side1 = !radius.real() + (!tod / 2)
  -- !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))

  -- makeup piece
  ------------------
  --<wd>sep2003-- MAKEUP Piece now uses a REDUCER and NOT an ATTA
  --new atta select spref with styp 'MAKEUP' spec /MDS
  new redu select spref with styp 'MAKEUP' spec /MDS
  mtoc off

  despar $!phBore  $!radius 0mm
  -- If the ontype is tube set dp2 to 0
  if !onType.eq('TUBE') then
    despar n2 0mm
  endif
  ------------------
  --<wd>sep2003-- MAKEUP Piece now uses a REDUCER and NOT an ATTA

  --spkbrk true

  sel lstu
  connect
  handle (7,3)
    fconnect
  endhandle

  ------------------
  --<wd>sep2003-- MAKEUP Piece now uses a REDUCER and NOT an ATTA
  --atty CCNN

  name /$!!mdsLt05.name.val/MAKEUP
  !!mdsLt05.support.atta.append(!!ce)

  -- Lug atta
  --<sk> reference saving in lug atta when from preliminary support
  !attaCreated = false
  if (!fromAtta) then
    !oldCe = !!ce
    !!ce = object DBREF('/$!!mdsLt05.name.val' & '_Pre')
    handle any
    elsehandle none
      !refno = !!ce.refno.string()
      -- delete old one
      delete ATTA
      handle any
        !!ce = !oldCe
      elsehandle none
        !!ce = !oldCe
        !attaCreated = true
        new atta ref $!refno despar 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm
      endhandle
    endhandle
  endif

  if (NOT !attaCreated) then
    new atta despar 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm
  endif
  stext '$!!mdsLt05.name.val'
  !!mdsLt05.support.datum = !!ce
  spkbrk true
  select spref with styp '$!type' spec /MDS
  sel lstu

  if !patest.string().eq('U WRT /*') or !patest.string().eq('D WRT /*') or !patest.string().eq('Z WRT /*') or !patest.string().eq('-Z WRT /*') then
    !directionP5 = !pltest
  else
    !directionP5 = !patest
  endif

  connect and p5 is $!directionP5
  handle ANY
    connect and p5 is $!directionP5
  endhandle

  connect and p5 is pa of href of bran
  handle ANY
    connect and p5 is pl of href of bran
  endhandle

  name /$!!mdsLt05.name.val

  !!mdsLt05.support.atta.append(!!ce)

  --<wd>nov2003
  --:MDSSuppType 'LT05'
  :MDSSuppType '$!type'

  !!mdsSetDesPars(!!ce)
  !!mdsDacControl(true)


  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below
  !check = object MDSCHECKSTD(!mdsattaobj)
  !tmin = STRING()
  !tmax = STRING()
  if (!check.temp(!alias,!tmin,!tmax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tmin / $!tmax)')
    !!kRestoreUnits(!currentUnits)
    delete atta
    bran
    delete bran
    !!mdsLt05.support.atta[1].delete()
    !!mdsLt05.support.atta[2].delete()
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsLt05, true)
    endif
    return
  endif

  -- Test if the ancillary is available at this elevation

  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedElevation = !position.up
    ------------------------------------------------------------------------------
    -- mjb >>> 02.05.06 <mds12>
    !minimumElevation = !mdsattaobj.elevation
    --!minimumElevation = !!mdsPar$!alias[0].despars[1]
    -- mjb <<< 02.05.06 end of mod
    ------------------------------------------------------------------------------
    !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedElevation Minimum elevation $!minimumElevation')
    !!kRestoreUnits(!currentUnits)
    delete atta
    -- <sk> 04/06/2012
    bran
    delete bran
    !!mdsLt05.support.atta[1].delete()
    !!mdsLt05.support.atta[2].delete()
    if !fromAtta then
      !!mdsRestorePre(!!mdsLt05, true)
    endif
    return
  endif

  -- <sk> 06/07/2012 Check user criteria
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentUnits)
    delete atta
    -- <sk> 04/06/2012
    bran
    delete bran
    !!mdsLt05.support.atta[1].delete()
    !!mdsLt05.support.atta[2].delete()
    if !fromAtta then
      !!mdsRestorePre(!!mdsLt05, true)
    endif
    return
  endif
  -- <sk> 06/07/2012


  -- If the lug in attached to tube rather that an elbow we need to set a cutback
  -- value in design parameter 9

  if !onType.eq('ELBO') then
    despar n9 0mm
  else
    !dp = despar
    --<wd>nov2003 - LT08A-H Pipe Lugs -  NOW Use a Different Geomset so DESP 9 NOT USED in DATA SET
    --!dp9 = (!radius.real() + !dp[3] - !dp[5] - !dp[4])
    !dp9 =  0
    despar n9 $!dp9
  endif

  !unusedCe = !!ce
  bran
  conn pt to last mem
  tconn clos

  !!mdsDacControl(true)

  -- Set the material and shop flags for all comps except the notes
  -- and remove the insulation automatically
  bran
  ispe =0
  !members = mem count
  do !set from 1 to !members
    bran
    $!set
    !!mdssetmatref(!!ce)
    handle any
    endhandle
    !!mdsDacControl(TRUE)
    ispe =0
  enddo

  !!mdsDacControl(TRUE)

  bran
  ------------------------------------------------------------------------------
  -- mjb >>> 02.05.06 <mds12>
  !shop = !mdsattaobj.shop
  --!shop = !!mdsPar$!type[$!phBore].shop
  -- mjb <<< 02.05.06 end of mod
  ------------------------------------------------------------------------------
  shop $!shop

  do !set from 1 to !members
    bran
    $!set
    shop $!shop
  enddo

  -- Add marker text
  !!mdsaidtext(!!mdsLt05)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsLt05.support.atta)

  -- Colour Support
  call !!kenhanceList(!colourList)

  -- When finished grey out datum gadget and reset height,length and setsteel
  !!mdsLt05.crElbo.active = false
  !!mdsLt05.crTube.active = false

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- Deactivate gadgets

  !!mdsLt05.rotate.active = false
  !!mdsLt05.rotatt.active = false
  !!mdsLt05.bedplate.active = false
  !!mdsLt05.modatta.active = false
  !!mdsLt05.deleteatta.active = false
  !!mdsLt05.nudge.active = false
  !!mdsLt05.anccopy.active = false
  !!mdsLt05.ancnudge.active = false

  if !onType.eq('ELBO') then
    !!mdsLt05.bdist.active = false
    !!mdsLt05.dist.active = false
    !!mdsLt05.bthro.active = false
    !!mdsLt05.select.active = false
    !!mdsLt05.rotate.active = false
  else
    !!mdsLt05.bdist.active = true
    !!mdsLt05.dist.active = true
    !!mdsLt05.bthro.active = true
    !!mdsLt05.select.active = true
    !!mdsLt05.rotate.active = true
  endif

  -- set focus to the distance text gadget
  !!mdsLt05.dist.setFocus()

  !!mdsDacControl(false)

  -- End function
endfunction
