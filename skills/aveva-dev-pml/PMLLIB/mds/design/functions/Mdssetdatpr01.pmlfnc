--
-- File:    Mdssetdatpr01.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--   Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.morris
-- Created:   Tue Oct 28
--
--

-- Description:
-- Creation function for general ancillary Pr01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatPr01(!form is FORM)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !datum    = !form.support.datum
  !name     = !form.name.val
  !alias    = !form.support.alias
  !form.bedplate.active = true
  handle any
    -- in Design form !!createPreSupport, this icon is omitted
  endhandle

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif
  !iDType = 'pipe'
  !purp = 'PIPE'

  if (!!mdsIdTube(!tubeType, 'Identify $!pipeType of $!iDType',!purp).not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  forwards
  !where = ''

  -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
  -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.
  !currcomp = !!ce
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!hdir neq U and !hdir neq D ) then
    if (!!mdsgradient(!currcomp)) then
      !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
      !!ce = !cecomp
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endif

  -- Select ancillary
  if(!!kGetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif

  $!boreUnits
  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  !!mdsDacControl(true)

  --Navigate to Href of owne for all support types apart from these
  new atta $!where
  spkbrk TRUE
  !choice = SELECT SPEC /MDP WITH STYP '$!alias'
  handle any
    delete atta
    !projStandard = !form.support.replace
    !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
    !!mdsDacControl(FALSE)
    !!kRestoreUnits(!currentUnits)
    return
  elsehandle none
  endhandle

  units mm bore
  spref $!choice[1]

  !!mdsSetDesPars(!!ce)
  !!mdsDacControl(true)

  -- Name support

  Name /$!name
  :MDSSuppType |$!form.support.type|

  !!mdsSetIspe()

  --  Add stex for isometrics

  !sAtta = !!ce
  !!mdsSelLstu(!!ce)

  !!mdsDacControl(true)
  POS AT PREV
  handle any
    pos at ph
  endhandle
  ori

  call !!mdsTransport(!sAtta,!name)

  -- Always add atta to support object
  !form.support.atta.clear()
  !form.support.atta.append(!!ce)
  !form.support.datum  = !!ce
  !form.support.pADir  = Pa Dir wrt world
  !form.support.pLDir  = Pl Dir wrt world
  !form.support.p9Dir  = P9 Dir wrt world

  -- Add marker text
  !!mdsaidtext(!form)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!form.support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- When finished grey out datum gadget and reset height,length and setsteel
  !!mdsSetGadgets(!form,!!ce,!form.support.type)
  !form.datum.active = FALSE
  !form.modType.active = TRUE
  handle ANY
    -- in Design form !!createPreSupport, this BUTTON is omitted
  endhandle

  !!mdsDacControl(true)

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- set focus to the distance text gadget
  !form.dist.setFocus()
  !!mdsDacControl(false)

endfunction
