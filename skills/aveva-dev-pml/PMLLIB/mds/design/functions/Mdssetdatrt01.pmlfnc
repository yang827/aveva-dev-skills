--
-- File:    Mdssetdatrt01.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.morris
-- Created:   Tue Oct 28
--
-- Description:
-- Creation function for general ancillary Rt01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatRt01()

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !datum    = !!mdsRt01.support.datum
  !name     = !!mdsRt01.name.val
  !alias    = !!mdsRt01.support.alias


  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif
  !iDType = 'pipe'
  !purp = 'PIPE'

  label /again

  if (!!mdsIdTube(!tubeType, 'Identify $!pipeType of $!iDType',!purp).not())then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  forwards
  !where = ''

  -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
  -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

  !currcomp = !!ce
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!hdir neq U and !hdir neq D ) then
    if (!!mdsgradient(!currcomp)) then
      !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
      !!ce = !cecomp
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endif

  -- Select ancillary
  if(!!kGetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif

  $!boreUnits
  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  -- <sk> 06/06/2012
  !fromAtta = !!mdsRt01.support.preliminaryStore.set()
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsRt01.support.datum = !!ce
    -- Set distance gadget
    !!mdsDistance(!!mdsRt01)
  else
    new atta $!where
  endif
  -- <sk> 06/06/2012

  spkbrk true
  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsRt01.support.replace
    !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
    !!kRestoreUnits(!currentUnits)
    -- <sk> 06/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsRt01, true)
      return
    endif
    delete atta
    return
  endhandle
  units mm bore
  spref $!choice[1]

  -- <sk> 06/07/2012 Check user criteria
  -- Criteria test do not use MDS DEFAULTS so no need to set MDSREADPARSDATA members
  !check = object MDSCHECKSTD(object MDSREADPARSDATA())
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsRt01, true)
      return
    endif
    delete atta
    return
  endif
  -- <sk> 06/07/2012

  !!mdsDacControl(true)
  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsRt01.support.type|

  !!mdsSetIspe()

  --  Add stex for isometrics
  -- set stex for atta
  !sAtta = !!ce
  call !!mdsTransport(!sAtta,!name)

  !!mdsSelLstu(!!ce)

  !!mdsDacControl(true)
  -- <sk> 06/06/2012
  -- do not modify POS and ORI in atta from preliminary
  if !fromAtta.not() then
    POS AT PREV
    handle any
      POS AT PH
    endhandle
    ORI
  endif

  -- Always add atta to support object
  !!mdsRt01.support.atta.clear()
  !!mdsRt01.support.atta.append(!!ce)
  !!mdsRt01.support.datum  = !!ce
  !!mdsRt01.support.pADir  = Pa Dir wrt world
  !!mdsRt01.support.pLDir  = Pl Dir wrt world
  !!mdsRt01.support.p9Dir  = P9 Dir wrt world

  -- Add marker text
  !!mdsaidtext(!!mdsRt01)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsRt01.support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  !!mdsRt01.datum.active = false

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- set focus to the distance text gadget
  !!mdsRt01.dist.setFocus()

  !!mdsDacControl(false)

endfunction
