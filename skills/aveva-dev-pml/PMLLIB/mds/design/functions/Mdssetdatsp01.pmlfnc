--
-- File:  Mdssetdatsp01.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Andrew Kirkland
-- Created:  Tues 19 May 1998
--
--
-- Description:
-- Creation function for Variable Spring Support SP01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatSP01()

  --> Modified - <wd> - 17sep1998
  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()
  --< Modified - <wd> - 17sep1998

  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  !tubeType    = !!mdsOptions.pipes
  !datum       = !!mdsSP01.support.datum
  !name        = !!mdsSP01.name.val

  !cecomp = !!ce
  !fromAtta = !!mdsSP01.support.preliminaryStore.set()

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsSP01, true)
    endif
    return
  endif

  --------------------------------------------------------------------------------
  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipetype = 'lined section'
  else
    !pipetype = 'tube'
  endif

  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998

  if (!!mdsidtube('$!tubeType', 'Identify Pedestal or $!pipetype to add Spring To :-','PIPE').not())then
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsSP01, true)
    endif
    return
  endif

  !pickedItem = !!ce


  !search = 'AT11A AT10A'
  !search1 = 'AT01 AT02 AT03 AT04 AT05 AT06 AT07 AT08 AT09'
  !search2 = 'AT10B AT11B'
  !styp   = !pickedItem.styp
  handle ANY
    -- if it is a branch
    !styp = 'BRANCH'
  endhandle

  --> Modified - <wd> - 21sep1998
  -- Check if Selected Item is a Trunnion and if so, It's of the Correct Type'
  if (!styp.matchwild('TT0*')) then
    !!alert.error('Unable to Support this type of Trunnion with this Spring Type. Select Another Trunnion.')
    golabel /again
  endif
  --< Modified - <wd> - 21sep1998


  if (!search.match(!styp).neq(0)) then
    -- Get height of atta for positioning the spring unit

    !offset = despar[1] + Despar[2]

    -- Check if valid selection has a Spring unit already ??

    if(!pickedItem.:MDSGuideRef.badref().not() and !pickedItem.:MDSGuideRef.neq(Nulref) and !pickedItem.:MDSGuideRef.:MDSSuppType inset('SP01','SP01')) then
      !!alert.error('Selected Pedestal already has a spring unit attached.')
      !!kRestoreUnits(!currentUnits)
      if !fromAtta then
        !!mdsRestorePre(!!mdsSP01, true)
      endif
      return
    endif

    !stype = 'SP01A'
    !pedestal = TRUE

  elseif (!search1.match(!styp).neq(0)) then
    -- Identified element is a shoe, require to adjust the spring height
    -- if the user requires to

    if !!alert.confirm('Identified support is a shoe/reinforcing plate. Do you require to adjust the spring to cater for this').eq('YES') then
      var !shoeHeight prop hei
      handle (2,207)
        var !shoeHeight prop thk
      endhandle
      var !lea lea
      var !odia pod $!lea
      !offset = !odia.real() / 2 + !shoeHeight.real()
      !stype = 'SP01'
      !pedestal = FALSE
    else
      var !lea lea
      var !odia pod $!lea
      !offset = !odia.real() / 2
      !stype = 'SP01'
      !pedestal = FALSE
    endif

  elseif (!search2.match(!styp).neq(0)) then
    -- Get height of atta for positioning the spring unit

    var !lea lea
    var !odia pod $!lea

    handle ANY
      -- if no components, use head od
      var !odia phod
    endhandle

    !offset = despar[1] + !odia.real() / 2

    -- Check if valid selection has a Spring unit already ??

    if(!pickedItem.:MDSGuideRef.badref().not() and !pickedItem.:MDSGuideRef.neq(Nulref) and !pickedItem.:MDSGuideRef.:MDSSuppType inset('SP01','SP01')) then
      !!alert.error('Selected Pedestal already has a spring unit attached.')
      !!kRestoreUnits(!currentUnits)
      if !fromAtta then
        !!mdsRestorePre(!!mdsSP01, true)
      endif
      return
    endif

    !stype = 'SP01'
    !pedestal = TRUE

  else
    -- Tubing in-line type

    -- Check that Selected PIPE is not VERTICAL

    !stype = 'SP01'
    !pedestal = FALSE

    if (!pickedItem.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
    endif

    if (!hdir.eq(U) or !hdir.eq(D) ) then
      --> Modified - <wd> - 21sep1998
      !replace =  !!mdsSP01.support.replace
      --xxx      !!alert.message ('VERTICAL Pipes may be supported with the support spring type "' & !stype & '"')
      !!alert.message ('VERTICAL Pipes may NOT be supported with the support spring type "' & !replace & '"')
      !!ce = !cecomp
      !!kRestoreUnits(!currentUnits)
      if !fromAtta then
        !!mdsRestorePre(!!mdsSP01, true)
      endif
      return
    endif

    -- Get Offset dimension from tube OD

    var !lea lea
    var !odia pod $!lea

    handle ANY
      -- if no components, use head od
      var !odia phod
    endhandle

    !offset = (!odia.real() / 2)

  endif

  -- Select Spring unit

  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  -- <sk> 04/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsSP01.support.datum = !!ce
    -- Set distance gadget before changing orientation
    !!mdsDistance(!!mdsSP01)
    -- <sk> 21/06/2012 orientation problems
    -- reset orientation
    ori Y is N WRT $!!ce.owner and Z is U WRT $!!ce.owner
  else
    new atta
  endif
  SPKBRK TRUE
  !!mdsSP01.support.datum  = !!ce

  -- select spref for spring unit

  !suppType = !!mdsSP01.support.type

  sel with styp '$!stype' spec /MDS

  !!mdsSetDesPars(!!ce)
  !!mdsDacControl(true)
  despar n5 $!offset
  handle any
  endhandle


  -- Name support
  :MDSSuppType |$!suppType|
  Name /$!name

  -- only set guideref if a pedestal is picked
  if(!pedestal) then

    --     Set Spring Atta :MDSGuideRef to Pedestal Atta
    :MDSGuideRef $!pickedItem
    !spring = !!ce

    --     Navigate back to Shoe Atta and Set :MDSGuideRef to Guide Atta
    !!ce  = !pickedItem
    :MDSGuideRef  $!spring
    handle ANY
      claim ce
      :MDSGuideRef $!spring
    elsehandle NONE
    endhandle


    --     Navigate back to Spring Atta
    !!ce = !spring

    !!mdsSP01.align.active = TRUE

  else
    --     only activate the distance gadgets if the in-line type is selected

    !!mdsSP01.dist.active = TRUE
    !!mdsSP01.bDist.active = TRUE
    !!mdsSP01.bThro.active = TRUE
    !!mdsSP01.select.active = TRUE

  endif
  --------------------------------------------------------------------------------
  !!mdsSetIspe()

  --  Add stex for isometrics

  -- !stex = after(!name, '/')
  -- !tran = subs(!stex, 1, 1)
  -- STEX '$!stex'

  call !!mdsTransport(!!ce,!name)

  -- position at the pedestal or the prev component
  -- <sk> 04/06/2012
  -- do not modify POS and ORI in atta from preliminary
  if !fromAtta.not() then
    POS AT PREV
    handle any
      pos at ph
    endhandle
  endif
  ori

  !p3dir = p3 dir wrt /*
  if ('$!p3dir' neq 'D WRT /*') and ('$!p3dir' neq '-Z WRT /*') then
    flip ori
    pos at prev
    --> Modified -<wd> - 15sep1998
    handle any
      pos at ph
    endhandle
    --< Modified -<wd> - 15sep1998
  endif

  !!mdsSelLstu(!!ce)


  -- Add marker text
  VAR !pOS POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  -- Always add atta to support object
  !!mdsSP01.support.atta.clear()
  !!mdsSP01.support.atta.append(!!ce)
  !!mdsSP01.support.pADir  = Pa Dir wrt world
  !!mdsSP01.support.pLDir  = Pl Dir wrt world
  !!mdsSP01.support.p9Dir  = P9 Dir wrt world

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsSP01.support.atta)

  -- Colour Support
  Call !!kEnhanceList(!colourList)

  !!mdsSetGadgets(!!mdsSP01,!!ce,!!mdsSP01.support.type)

  -- When finished grey out datum gadget and reset gadgets

  !!mdsSP01.datum.active = false

  --> Modified - <wd> - 17sep1998
  -- Reset Units
  !!kRestoreUnits(!currentUnits)
  --< Modified - <wd> - 17sep1998
  !!mdsDacControl(false)
  -- End function
endfunction
