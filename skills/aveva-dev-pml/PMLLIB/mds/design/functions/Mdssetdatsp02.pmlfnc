--------------------------------------------------------------------------------
--
-- File:  Mdssetdatsp02.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Andrew Kirkland
-- Created:  Tues 19 May 1998
--
--
-- Description:
-- Creation function for Variable Spring Support SP02
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatSP02()

  --> Modified - <wd> - 17sep1998
  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()
  --< Modified - <wd> - 17sep1998

  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  !tubeType    = !!mdsoptions.pipes
  !datum       = !!mdsSP02.support.datum
  !name        = !!mdsSP02.name.val

  !cecomp = !!ce
  !fromAtta = !!mdsSP02.support.preliminaryStore.set()

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsSP02, true)
    endif
    return
  endif

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipetype = 'lined section'
  else
    !pipetype = 'tube'
  endif

  ------------------------------
  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998

  if (!!mdsidtube('$!tubeType', 'Identify Trunnion or $!pipetype to add Spring Support To :-','PIPE').not())then
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsSP02, true)
    endif
    return
  endif

  !pickedItem = !!ce

  --> Modified - <wd> - 21sep1998
  !xstyp = !pickedItem.stype
  handle any
    -- Pickeditem  is type 'BRAN'
    !xstyp = 'BRANCH'
  endhandle

  -- Check if Selected Item is a Trunnion and if so, It's of the Correct Type'
  if (!xstyp.matchwild('TT0*') or !xstyp.matchwild('AT10*') or !xstyp.matchwild('AT11*')) then
    if (!xstyp.matchwild('TT02-D*').not()) then
      !!alert.error('Unable to Support this type of Trunnion with this Spring Type. Select Another Trunnion.')
      golabel /again
    endif
  endif

  --xxx  if (!pickedItem.stype.match('TT02-D').neq(0)) then
  if (!xstyp.match('TT02-D').neq(0)) then
    -- Trunnion Type is 'TT02 type -D'
    --< Modified - <wd> - 21sep1998

    !offset = !pickedItem.desp[1]
    !trunDia = !pickedItem.para[5]

    if(!pickedItem.:MDSGuideRef.badref().not() and !pickedItem.:MDSGuideRef.neq(Nulref) and !pickedItem.:MDSGuideRef.:MDSSuppType inset('SP01','SP02')) then
      !!alert.error('Selected Pedestal already has a spring unit attached.')
      !!kRestoreUnits(!currentUnits)
      if !fromAtta then
        !!mdsRestorePre(!!mdsSP02, true)
      endif
      return
    endif

    !stype = 'SP02A'
    !trunnion = TRUE
  else
    -- Tubing in-line type

    -- Check that Selected PIPE is not VERTICAL

    !stype = 'SP02'
    !trunnion = FALSE

    if (!pickedItem.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
    endif

    if (!hdir.eq(U) or !hdir.eq(D) ) then
      --> Modified - <wd> - 21sep1998
      !replace = !!mdsSP02.support.replace
      --xxx      !!alert.message ('VERTICAL Pipes may be supported with the support spring type "' & !stype & '"')
      !!alert.message ('VERTICAL Pipes may NOT be supported with the support spring type "' & !replace & '"')
      !!ce = !cecomp
      !!kRestoreUnits(!currentUnits)
      if !fromAtta then
        !!mdsRestorePre(!!mdsSP02, true)
      endif
      return
    endif

    -- Get Offset dimension from tube OD

    var !lea lea
    var !odia pod $!lea

    handle ANY
      -- if no components, use head od
      var !odia phod
    endhandle

    !offset = (!odia.real() / 2)

    -- Check if pipe is on a slope, there are two variables (members of Mdsoptions)
    -- that it uses. .maxpiva is the maximum pivit angle that is allowed and
    -- .maxpwar is the angle at which we should warn the user. Also the .maxHang
    -- which is the minimum distance from a hanger pivot point to the under side of
    -- the steelwork

    !pickedItem = !!ce
    !pickedItemPldir = pl dir wrt world of $!pickedItem
    handle (2,201) (2,252)
      !pickedItemPldir = ph dir wrt world of $!pickedItem
    endhandle

    var !atline  const line $!pickedItemPldir thro pl of $!pickedItem
    handle (2,252)
      var !atline const line $!pickedItemPldir thro ph
    endhandle
    var !nat const line project $!atline on plane u wrt /* thro e0n0u0 wrt /*
    var !angle const angle $!nat $!atline
    handle (47,62)
      -- Vertical line
      var !angle '90'
    endhandle

    if (!angle.real() ge !!mdsoptions.maxpwar and !angle.real() lt !!mdsoptions.maxpiva) then
      if (!!alert.confirm ('The pipe identified is at an angle of $!angle Are you sure you want to continue?') eq 'NO') then
        !!ce = !cecomp
        !!kRestoreUnits(!currentUnits)
        if !fromAtta then
          !!mdsRestorePre(!!mdsSP02, true)
        endif
        return
      endif
    elseif (!angle.real() gt !!mdsoptions.maxpiva) then
      !!alert.message ('The pipe identified is not within the maximum angle for supportable pipes as defined in the application defaults ($!!mdsoptions.maxpiva)')
      !!ce = !cecomp
      !!kRestoreUnits(!currentUnits)
      if !fromAtta then
        !!mdsRestorePre(!!mdsSP02, true)
      endif
      return
    endif

  endif
  --------------------------------------------------------------------------------

  -- Select Spring unit

  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  -- <sk> 04/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsSP02.support.datum = !!ce
    -- Set distance gadget before changing orientation
    !!mdsDistance(!!mdsSP02)
    -- <sk> 21/06/2012 orientation problems
    -- reset orientation
    ori Y is N WRT $!!ce.owner and Z is U WRT $!!ce.owner
  else
    new atta
  endif
  SPKBRK TRUE
  !!mdsSP02.support.datum  = !!ce

  -- select spref for spring unit

  !suppType = !!mdsSP02.support.type

  sel with styp '$!stype' spec /MDS

  !!mdsSetDesPars(!!ce)

  despar n6 $!offset
  handle any
  endhandle

  despar n7 $!trunDia
  handle any
  endhandle

  despar n8 $!angle
  handle any
  endhandle
  -----------------------------
  -- set angle so rod is vertical

  var !p42dir P42 dir wrt /*
  handle any
    --  not used on SP02A
  elsehandle NONE
    if (!p42dir neq 'U') and (!p42dir neq 'Z') then
      despar n8 -$!angle
    endif
  endhandle
  -----------------------------
  !!mdsDacControl(true)
  -- Name support
  :MDSSuppType |$!suppType|
  Name /$!name

  -- only set guideref if a pedestal is picked
  if(!trunnion) then

    --     Set Spring Atta :MDSGuideRef to Pedestal Atta
    :MDSGuideRef $!pickedItem
    !spring = !!ce

    --     Navigate back to Shoe Atta and Set :MDSGuideRef to Guide Atta
    !!ce  = !pickedItem
    :MDSGuideRef  $!spring
    handle ANY
      claim ce
      :MDSGuideRef $!spring
    elsehandle NONE
    endhandle


    --     Navigate back to Spring Atta
    !!ce = !spring

    !!mdsSP02.align.active = TRUE

  else
    --     only activate the distance gadgets if the in-line type is selected

    !!mdsSP02.dist.active = TRUE
    !!mdsSP02.bDist.active = TRUE
    !!mdsSP02.bThro.active = TRUE
    !!mdsSP02.select.active = TRUE

  endif
  --------------------------------------------------------------------------------
  !!mdsSetIspe()

  --  Add stex for isometrics

  -- !stex = after(!name, '/')
  -- !tran = subs(!stex, 1, 1)
  -- STEX '$!stex'

  call !!mdsTransport(!!ce,!name)

  -- position at the trunnion or the prev component
  -- <sk> 04/06/2012
  -- do not modify POS and ORI in atta from preliminary
  if !fromAtta.not() then
    POS AT PREV
    handle any
      pos at ph
    endhandle
  endif
  ori
  !p3dir = p3 dir wrt /*
  if(!trunnion) then
    if ('$!p3dir' neq 'U WRT /*') and ('$!p3dir' neq 'Z WRT /*') then
      flip ori
      pos at prev
      --> Modified -<wd> - 21sep1998
      handle any
        pos at ph
      endhandle
      --< Modified -<wd> - 21sep1998
    endif
  else
    if ('$!p3dir' neq 'U WRT /*') and ('$!p3dir' neq 'Z WRT /*') then
      ori and p3 is u wrt worl
    endif
  endif


  !!mdsSelLstu(!!ce)


  -- Add marker text
  VAR !pOS POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  -- Always add atta to support object
  !!mdsSP02.support.atta.clear()
  !!mdsSP02.support.atta.append(!!ce)
  !!mdsSP02.support.pADir  = Pa Dir wrt world
  !!mdsSP02.support.pLDir  = Pl Dir wrt world
  !!mdsSP02.support.p9Dir  = P9 Dir wrt world

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsSP02.support.atta)

  -- Colour Support
  Call !!kEnhanceList(!colourList)

  !!mdsSetGadgets(!!mdsSP02,!!ce,!!mdsSP02.support.type)

  -- When finished grey out datum gadget and reset gadgets

  !!mdsSP02.datum.active = false

  --> Modified - <wd> - 17sep1998
  -- Reset Units
  !!kRestoreUnits(!currentUnits)
  --< Modified - <wd> - 17sep1998
  !!mdsDacControl(false)
  -- End function
endfunction
