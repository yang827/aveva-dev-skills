--
-- File:  Mdssetdatsp03.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Andrew Kirkland
-- Created:  Tues 2nd June 1998
--
--
-- Description:
-- Creation function for Variable Spring Support SP03
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatSP03()

  --> Modified - <wd> - 17sep1998
  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()
  --< Modified - <wd> - 17sep1998

  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  !tubeType    = !!mdsoptions.pipes
  !datum       = !!mdsSP03.support.datum
  !name        = !!mdsSP03.name.val
  !cType       = !!mdsSP03.type.selection()
  !cecomp = !!ce
  !fromAtta = !!mdsSP03.support.preliminaryStore.set()

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsSP03, true)
    endif
    return
  endif

  --------------------------------------------------------------------------------
  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipetype = 'lined section'
  else
    !pipetype = 'tube'
  endif

  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998

  if (!!mdsidtube('$!tubeType', 'Identify Trunnion or $!pipetype to add Spring Support To :-','PIPE').not())then
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsSP03, true)
    endif
    return
  endif

  !pickedItem = !!ce

  --> Modified - <wd> - 21sep1998
  !xstyp = !pickedItem.stype
  handle any
    -- Pickeditem  is type 'BRAN'
    !xstyp = 'BRANCH'
  endhandle
  if (!xstyp.matchwild('TT0*')) then
    !!alert.error('Currently Unable to Support this type of Trunnion with this Spring Type. Select Another Trunnion/Pipe')
    golabel /again
  endif

  --xxx  if (!pickedItem.stype inset('AT11B','AT10B')) then
  if (!xstyp inset('AT11B','AT10B')) then
    --< Modified - <wd> - 21sep1998

    !offset = (!pickedItem.desp[1] + !pickedItem.para[2] / 2)

    if(!pickedItem.:MDSGuideRef.badref().not() and !pickedItem.:MDSGuideRef.neq(Nulref) and !pickedItem.:MDSGuideRef.:MDSSuppType inset('SP01','SP03')) then
      !!alert.error('Selected Pedestal already has a spring unit attached.')
      !!kRestoreUnits(!currentUnits)
      if !fromAtta then
        !!mdsRestorePre(!!mdsSP03, true)
      endif
      return
    endif

    -- populate type option gadget with available spring types
    !validTypes = 'E F'
    !validDtext = 'C54 (E)\C55 (F)'
    !dtext = !validDtext.split(|\|)
    !rtext = !validTypes.split()
    !!mdsSP03.type.dtext = !dtext
    !!mdsSP03.type.rtext = !rtext
    !!mdsSP03.type.select('rtext',!cType)
    handle any
      -- in case not E or F
    endhandle
    !stype = 'SP03' & !!mdsSP03.type.selection()
    !trunnion = TRUE

    --> Modified - <wd> - 21sep1998
    --xxx  elseif (!pickedItem.stype inset('AT11A','AT10A')) then
  elseif (!xstyp inset('AT11A','AT10A')) then
    --< Modified - <wd> - 21sep1998

    !offset = !pickedItem.desp[1] + !pickedItem.desp[2]

    if(!pickedItem.:MDSGuideRef.badref().not() and !pickedItem.:MDSGuideRef.neq(Nulref) and !pickedItem.:MDSGuideRef.:MDSSuppType inset('SP01','SP03')) then
      !!alert.error('Selected Pedestal already has a spring unit attached.')
      !!kRestoreUnits(!currentUnits)
      if !fromAtta then
        !!mdsRestorePre(!!mdsSP03, true)
      endif
      return
    endif

    -- populate type option gadget with available spring types
    !validTypes = 'E F'
    !validDtext = 'C54 (E)\C55 (F)'
    !dtext = !validDtext.split(|\|)
    !rtext = !validTypes.split()
    !!mdsSP03.type.dtext = !dtext
    !!mdsSP03.type.rtext = !rtext
    !!mdsSP03.type.select('rtext',!cType)
    handle any
      -- in case not E or F
    endhandle
    !stype = 'SP03' & !!mdsSP03.type.selection() & 'A'
    !trunnion = TRUE

  else
    -- Tubing in-line type

    -- populate type option gadget with available spring types
    !validTypes = 'A B C D E F G'
    !validDtext = 'C50 (A)\C51 (B)\C52 (C)\C53 (D)\C54 (E)\C55 (F)\C56 (G)'
    !dtext = !validDtext.split(|\|)
    !rtext = !validTypes.split()
    !!mdsSP03.type.dtext = !dtext
    !!mdsSP03.type.rtext = !rtext
    !!mdsSP03.type.select('rtext',!cType)
    !stype = 'SP03' & !!mdsSP03.type.selection()

    --          !stype = 'SP03'
    !trunnion = FALSE

    -- Check that Selected PIPE is not VERTICAL

    if (!pickedItem.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
    endif

    if (!hdir.eq(U) or !hdir.eq(D) ) then
      --> Modified - <wd> - 21sep1998
      !replace = !!mdsSP03.support.replace
      --xxx      !!alert.message ('VERTICAL Pipes may be supported with the support spring type "' & !stype & '"')
      !!alert.message ('VERTICAL Pipes may NOT be supported with the support spring type "' & !replace & '"')
      !!ce = !cecomp
      !!kRestoreUnits(!currentUnits)
      if !fromAtta then
        !!mdsRestorePre(!!mdsSP03, true)
      endif
      return
    endif

    -- Get Offset dimension from tube OD

    var !lea lea
    var !odia pod $!lea

    handle ANY
      -- if no components, use head od
      var !odia phod
    endhandle

    !offset = (!odia.real() / 2)

    -- Check if pipe is on a slope, there are two variables (members of Mdsoptions)
    -- that it uses. .maxpiva is the maximum pivit angle that is allowed and
    -- .maxpwar is the angle at which we should warn the user. Also the .maxHang
    -- which is the minimum distance from a hanger pivot point to the under side of
    -- the steelwork

  endif

  -- Select Spring unit

  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  -- <sk> 04/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsSP03.support.datum = !!ce
    -- Set distance gadget before changing orientation
    !!mdsDistance(!!mdsSP03)
    -- <sk> 21/06/2012 orientation problems
    -- reset orientation
    ori Y is N WRT $!!ce.owner and Z is U WRT $!!ce.owner
  else
    new atta
  endif
  SPKBRK TRUE
  !!mdsSP03.support.datum  = !!ce

  -- select spref for spring unit

  !suppType = !!mdsSP03.support.type

  sel with styp '$!stype' spec /MDS

  !!mdsSetDesPars(!!ce)

  despar n5 $!offset
  handle any
  endhandle

  --despar n7 $!trunDia
  -- handle any
  -- endhandle

  --despar n8 $!angle
  -- handle any
  -- endhandle

  -----------------------------
  -- set angle so rod is vertical

  -----------------------------
  !!mdsDacControl(true)
  -- Name support
  :MDSSuppType |$!suppType|
  Name /$!name

  -- only set guideref if a pedestal is picked
  if(!trunnion) then

    --     Set Spring Atta :MDSGuideRef to Pedestal Atta
    :MDSGuideRef $!pickedItem
    !spring = !!ce

    --     Navigate back to Shoe Atta and Set :MDSGuideRef to Guide Atta
    !!ce  = !pickedItem
    :MDSGuideRef  $!spring
    handle ANY
      claim ce
      :MDSGuideRef $!spring
    elsehandle NONE
    endhandle


    --     Navigate back to Spring Atta
    !!ce = !spring

    !!mdsSP03.align.active      = TRUE
    --> Modified - <wd> - 21sep1998
    --xxx      if(!pickedItem.stype inset('AT10B', 'AT11B')) then
    if (!xstyp inset('AT10B','AT11B')) then
      --< Modified - <wd> - 21sep1998
      !!mdsSP03.flip.active     = True
      !!mdsSP03.rotate.active     = False
    else
      !!mdsSP03.flip.active     = FALSE
      !!mdsSP03.rotate.active     = True
    endif

  else
    --     only activate the distance gadgets if the in-line type is selected

    !!mdsSP03.dist.active = TRUE
    !!mdsSP03.bDist.active = TRUE
    !!mdsSP03.bThro.active = TRUE
    !!mdsSP03.select.active = TRUE
    !!mdsSP03.flip.active     = True
    !!mdsSP03.rotate.active     = False

  endif
  --------------------------------------------------------------------------------
  !!mdsSetIspe()

  --  Add stex for isometrics

  -- !stex = after(!name, '/')
  -- !tran = subs(!stex, 1, 1)
  -- STEX '$!stex'

  call !!mdsTransport(!!ce,!name)

  -- position at the trunnion or the prev component
  -- <sk> 04/06/2012
  -- do not modify POS and ORI in atta from preliminary
  if !fromAtta.not() then
    POS AT PREV
    handle any
      pos at ph
    endhandle
  endif
  ori
  !p3dir = p3 dir wrt /*

  if(!trunnion) then
    if ('$!p3dir' neq 'D WRT /*') and ('$!p3dir' neq '-Z WRT /*') then
      flip ori
      pos at prev
      --> Modified -<wd> - 21sep1998
      handle any
        pos at ph
      endhandle
      --< Modified -<wd> - 21sep1998
    endif
  else
    if ('$!p3dir' neq 'U WRT /*') and ('$!p3dir' neq 'Z WRT /*') then
      ori and p3 is u wrt worl
    endif
  endif

  !!mdsSelLstu(!!ce)


  -- Add marker text
  VAR !pOS POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  -- Always add atta to support object
  !!mdsSP03.support.atta.clear()
  !!mdsSP03.support.atta.append(!!ce)
  !!mdsSP03.support.pADir  = Pa Dir wrt world
  !!mdsSP03.support.pLDir  = Pl Dir wrt world
  !!mdsSP03.support.p9Dir  = P9 Dir wrt world

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsSP03.support.atta)

  -- Colour Support
  Call !!kEnhanceList(!colourList)

  !type = !!mdsSP03.support.datum.stype.substring(1,5)

  !!mdsSetGadgets(!!mdsSP03,!!ce,!type)

  -- When finished grey out datum gadget and reset gadgets

  !!mdsSP03.datum.active = false
  !!mdsSP03.angle.active = true
  !!mdsSP03.setSteel.active = true
  !!mdsSP03.setDefault.active = true

  --> Modified - <wd> - 17sep1998
  -- Reset Units
  !!kRestoreUnits(!currentUnits)
  --< Modified - <wd> - 17sep1998
  !!mdsDacControl(false)

  -- End function
endfunction
