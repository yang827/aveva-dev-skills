--
-- File:  Mdssetdatspl.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Thu Dec 11
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatSpl()

  -- Force into forwards mode
  FORWARDS

  !currentunits = !!kgetsetunits()

  -- Initialise variables
  !tubeType    = !!mdsOptions.pipes
  !datum       = !!mdsSpecial.support.datum
  !name        = !!mdsSpecial.support.stru.name

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Select tube
  if (!!mdsSpecial.type eq 'MULTI') then
    if (!tubeType eq 'FTUB')then
      !pipeType = 'lined section'
    else
      !pipeType = 'tube'
    endif
    !iDType = 'pipe'
    !purp = 'PIPE'
  elseif (!!mdsSpecial.type eq 'RACK') then
    !pipeType = 'tray section'
    !iDType = 'cable rack'
    !purp = 'TRAY'
  elseif (!!mdsSpecial.type eq 'HVAC') then
    !pipeType = 'HVAC section'
    !iDType = 'HVAC'
    !purp = 'HVAC'
  endif

  --> Modified - <wd> - 14sep1998
  label /again
  --< Modified - <wd> - 14sep1998

  if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of datum $!iDType', '$!purp').not())then
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- In case we id a different element when second pick set the first id
  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsSpecial.support.idcomp = !idcomp
  !!mdsSpecial.support.idbran = !idbran

  if (!!mdsSpecial.type eq 'MULTI') then
    -- Change callback on apply button then show ancillary form
    !!mdsAncill.action.clear()
    !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsSpecial)|
    !!mdsAncill.action[2] = |Call !!mdsCrDatSpl()|
    !!kShowForm(!!mdsAncill)
    !!mdsIAncill('SPECIAL')
  elseif (!!mdsSpecial.type eq 'RACK') then
    -- No ancillaries on cable racks so go into the CrDat straight away
    -- after creating atta set setting the attributes
    pin 9 copy P10
    handle none
      pin 8 copy P10
      pin 8 dist -10mm
      pin 8 dir from pin 9 to pin 8
      pin 9 clear 0 behind ce
      pin 8 clear 0 behind ce
      Var !width Const dist pin 9 to pin 8
      pin 9 copy p9
      pin 8 copy p9
      pin 9 clear 0 behind ce
      pin 8 clear 0 infront ce
      Call !!mdsResetPins(8,9)
    elsehandle any
      var !width pl bore
      handle any
        var !width ph bore
      endhandle
    endhandle

    -- GE 10/03/05 Fix for HPD0028314 for DAC'st
    !!mdsDacControl(true)
    new atta sel spref with styp 'RACK-REST' spec /MDS
    SPKBRK TRUE
    -- GE 02/02/05 Fix for HPD0027839 where the MTOC was unset
    MTOC OFF

    -- set stex for atta
    !sAtta = !!ce

    despar $!width 0mm

    -- <GE> 31/10/06 Fix for HPD0033213 where the DATUM atta was not being
    -- orientated correctly
    fconn and p30 is p30 of prev
    handle ANY
      fconn and p30 is p31 of prev
      handle ANY
        fconn
      endhandle
    endhandle
    -- <GE> 31/10/06

    handle ANY
      --<wd>oct2004 -- For ORIENTATING the first atta on BOXI implied "tube" racking
      if (!!ce.order.eq(1)) then
        -- DATUM ATTA is the FIRST Branch Member
        !bmem = !!ce.owner.mcount()
        if (!bmem.gt(1)) then
          !xce  = !!ce
          fconn and p30 is p30 of next
          handle ANY
            fconn and p30 is p31 of next
            handle ANY
              fconn
            endhandle
          endhandle
          !!ce = !xce
        else
          fconn
        endif
      else
        fconn
      endif
      --<wd>oct2004
    endhandle
    !!mdsDacControl(false)
    -- GE 10/03/05 HPD0028314

    !!mdsSelLstu(!!ce)
    Call !!mdsTransport(!sAtta,!name)
    !!mdsSpecial.support.atta.append(!!ce)
    Call !!mdsCrDatSpl()

  elseif (!!mdsSpecial.type eq 'HVAC') then
    -- No ancillaries on HVAC so go into the CrDat straight away
    -- after creating atta set setting the attributes
    -- Height and width will be despar 1 and 2
    Call !!mdsResetPins(8,9)
    bran
    same
    !readHVAC = !!ce
    new atta sel spref with styp 'HVAC-REST' spec /MDS
    handle (42,64) (42,66)
      spref /MDS/.HVAC-REST.1
    endhandle
    --<wd>17apr2003
    --SPKBRK TRUE
    SPKBRK FALSE
    --<wd>17apr2003
    !writeHVAC = !!ce

    -- set stex for atta
    !sAtta = !!ce

    --!conn = pa conn of prev
    despar 100mm 100mm
    -- P30 for KJB HVAC and P6 for CADC
    fconn and p30 is p30 of prev
    handle (61,1) (42,94) (2,201) (2,360)
      fconn and p20 is p61 of prev
    endhandle
    !!mdsSetHvac(!readHVAC,!writeHVAC)
    !!mdsSelLstu(!!ce)
    !!mdsSpecial.support.atta.append(!!ce)
    Call !!mdsTransport(!sAtta,!name)
    !!ce = !writeHVAC
    Call !!mdsCrDatSpl()
  endif

  -- If we are on a vertical duct make sure the correct height/width is set
  if (!!mdsSpecial.type eq 'HVAC') then
    pin 1 copy pl
    var !pin1dir pin 1 dir
    if !pin1dir.eq('U') or !pin1dir.eq('D') or !pin1dir.eq('Z') or !pin1dir.eq('-Z') then
      var !duct6162 const direction p61 of $!readHVAC to p62 of $!readHVAC
      var !datum6162 const direction p61 of $!writeHVAC to p62 of $!writeHVAC
      var !datum6261 const direction p62 of $!writeHVAC to p61 of $!writeHVAC
      if !duct6162.eq(!datum6162) or !duct6162.eq(!datum6261) then
        !desp = desp
        desp n1 $!desp[2]
        desp n2 $!desp[1]
      endif
    endif
  endif

  -- set focus to the distance text gadget
  !!mdsSpecial.dist.setFocus()

  !!kRestoreUnits(!currentunits)

  -- End function
endfunction
