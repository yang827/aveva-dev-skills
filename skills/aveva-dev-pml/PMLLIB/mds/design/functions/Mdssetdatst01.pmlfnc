--
-- File: Mdssetdatst01.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword:
--   Module: design
--   Replaces:
--
-- Author: N.morris
-- Created: Tue Oct 28
--
--
-- Description:
-- Creation function for general ancillary st01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatSt01()

  -- Find current units and set the distance unit to metric

  !currentunits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType    = !!mdsOptions.pipes
  !datum       = !!mdsST01.support.datum
  !name        = !!mdsST01.name.val
  !alias       = !!mdsST01.support.alias
  !fromAtta    = !!mdsST01.support.preliminaryStore.set()

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif
  !iDType = 'pipe'
  !purp = 'PIPE'

  label /again
  -- <ak> 20/06/2012
  if (!fromAtta.not()) then
    if (!!mdsIdTube(!tubeType, 'Identify $!pipeType of $!iDType',!purp).not())then
      !!kRestoreUnits(!currentunits)
      return
    endif
  else
    if !alias.eq('ST11A') or !alias.eq('ST11B') or !alias.eq('ST12') or !alias.eq('ST20') then
      if (defined (!!mdsAutoTubePicker) AND !!mdsAutoTubePicker.enabled()) then

        -- return if limit of pick tries exceeded
        if (!!mdsAutoTubePicker.allowedPicks.eq(0)) then
          !!mdsAutoTubePicker.cancel()
          return FALSE
        endif

        !picked = !!mdsAutoTubePicker.pickShoe()
        if unset(!picked) then
          !!alert.warning ('There is no pipe shoe suitable to guide next to preliminary support.')
          !!mdsAutoTubePicker.cancel()
          !!kRestoreUnits(!currentunits)
          return false
        else
          !!ce = !picked
        endif
      endif
    else
      !!ce = object DBREF('/' & !name & '_Pre')
    endif
  endif
  -- </ak> 20/06/2012

  --<wd>jan2004
  --    if !alias.eq('ST11A') or !alias.eq('ST11B') or !alias.eq('ST12') then
  if !alias.eq('ST11A') or !alias.eq('ST11B') or !alias.eq('ST12') or !alias.eq('ST20') then
    --<wd>jan2004
    if !!ce.type.eq('BRAN') then
      !!alert.error('You must identify a shoe for this stop')
      golabel /again
    else
      !mdsType = :MDStype of owner of catref
      if !mdsType.neq('SHOE') then
        !!alert.error('You must identify a shoe for this stop')
        golabel /again
      endif
    endif
    -- Get the height of the shoe to reset it later
    !existingdespar = !!mdsgetdesp('HEI')
    var !existingheight despar $!existingdespar
  endif

  -- Select ancillary
  if(!!kGetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif
  $!boreUnits

  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  !currentunits = !!kGetSetUnits()

  -- <ak> 20/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsST01.support.datum = !!ce
  else
    new atta
  endif
  -- </ak> 20/06/2012

  SPKBRK TRUE
  !datum = !!ce

  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsST01.support.replace
    !!alert.error('Unable to select ancillary $!projStandard at this bore($!bore)')
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST01, true)
      return
    endif
    delete atta
    !!kRestoreUnits(!currentunits)
    return
  elsehandle NONE

    ------------------------------------------------------------------------------
    -- mjb >>> 07.04.06 <mds12>
    -- The element may exist in the specification but the project may not contain the size in the parameters file
    units mm bore
    spref $!choice[1]

    !lbor = !datum.lbor.real().value()
    !mds12test = !!mdssetdespars(!datum)

    if (!mds12test.not()) then
      --if undefined(!!mdspar$!alias[$!bore]) then
      -- mjb <<< end of mod
      ------------------------------------------------------------------------------

      !projStandard = !!mdsST01.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <ak> 20/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsST01, true)
        return
      endif
      delete atta
      !!kRestoreUnits(!currentunits)
      return
    endif
  endhandle

  ------------------------------------------------------------------------------
  -- mjb >>> 07.04.06 <mds12>
  --mm bore
  --spref $!choice[1]

  --!!mdssetdespars(!!ce)
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------

  !!mdsdaccontrol(true)

  ------------------------------------------------------------------------------
  -- mjb >>> 07.04.06 <mds12>
  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below

  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!datum.stype,!lbor)

  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST01, true)
      return
    endif
    delete atta
    !!mdsdaccontrol(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)

  --!check = object MDSCHECKSTD()

  -- mjb <<< end of mod
  ------------------------------------------------------------------------------


  !min = STRING()
  !max = STRING()
  !materror = STRING()

  if (!check.material(!materror).not()) then
    !!alert.error (!materror)
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST01, true)
      return
    endif
    delete atta
    return
  endif

  -- <ak> 03/07/2012
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentunits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsST01, true)
      return
    endif
    delete atta
    return
  endif
  -- </ak> 03/07/2012

  if (!check.insu(!alias,!min,!max).not()) then
    var !insu insu
    !!kformattext.text.val  = $!max
    !maxval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!min
    !minval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!insu
    !insval = !!kformattext.text.val.string(!!distancefmt)
    !!alert.message ('The INSULATION on the identified pipe ($!<insval>$!<units>) is not within the MIN ($!<minval>$!<units>) and MAX ($!<maxval>$!<units>) limits of the Insulation Thickness Values for the selected ancillary support type.')
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST01, true)
      return
    endif
    delete atta
    return
  endif

  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below

  !tmin = STRING()
  !tmax = STRING()
  if (!check.temp(!alias,!tmin,!tmax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tmin / $!tmax)')
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST01, true)
      return
    endif
    delete atta
    return
  endif

  -- Test if the ancillary is available at this elevation

  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedelevation = !position.up
    ------------------------------------------------------------------------------
    -- mjb >>> 07.04.06 <mds12>
    !minimumelevation = !mdsattaobj.elevation
    --!minimumelevation = !!mdspar$!alias[0].despars[1]
    -- mjb <<< end of mod
    ------------------------------------------------------------------------------
    !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedelevation Minimum elevation $!minimumelevation')
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST01, true)
      return
    endif
    delete atta
    return
  endif


  -- Set the ATTA material
  !!mdssetmatref(!!ce)


  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsST01.support.type|

  !!mdsSetIspe()

  --  Add stex for isometrics

  -- set stex for atta
  !satta = !!ce

  !!mdsSelLstu(!!ce)

  pos at prev
  handle any
    pos at ph
  endhandle
  ori
  call !!mdsTransport(!satta,!name)
  refresh

  label /sagain

  prompt off
  prompt load escape |Identify steelwork to guide from|
  --<wd>17jan2008 -- Defect No. P-4407
  --    id sctn @
  id sctn hstiff @
  --<wd>17jan2008 -- Defect No. P-4407
  handle (61,528)
    prompt on
    !!ce = !datum
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST01, true)
      return
    endif
    delete atta
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  prompt dismiss
  prompt on
  !pick = !!ce

  pin 9 at poss
  pin 8 at pose
  pin 9 dir u wrt /*
  pin 9 plane pin 9 thro pin 8
  pin 9 dir from pin 9 to pin 8
  pin 7 copy pin 9
  pin 7 plane pin 7 thro $!datum
  pin 6 copy pl of $!datum
  pin 6 dist 100mm
  pin 9 dir u wrt /*
  pin 8 dir u wrt /*
  pin 7 dir u wrt /*
  pin 6 dir u wrt /*
  pin 8 plane pin 8 thro pin 9
  pin 7 plane pin 7 thro pin 9
  pin 6 plane pin 6 thro pin 9
  if !!kStrReal('const angle pin 9 to pin 7 to pin 6').neq(90) then
    !!mdsResetPins(6,9)
    !!alert.error('Identified steelwork is not perpendicular to pipe!')
    golabel /sagain
  endif
  --<wd>nov2000

  !centre = !!mdsBeamCentre(!pick)
  !!ce = !datum
  plane pl thro $!centre

  --  plane pl thro $!pick
  -- the above assumes the beam is symetrical about poss/pose line (AK)
  --<wd>nov2000

  if (!!mdsModStop(!!mdsST01,'CREATE',!datum,!pick).not())then
    !!ce = !datum
    !!mdsResetPins(6,9)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST01, true)
      return
    endif
    delete atta
    !!kRestoreUnits(!currentunits)
    return
  endif

  !bore = pa bore

  -- Set The GADGETS with the DESPAR value represented by the DKEY in the ATTA Despars, e.g. 'HEI'= DESP NUM 5 at the !alias type of STOP e.g 'ST01'
  !!mdsGetProp(!!mdsST01.height,!!mdsST01.pHeight,'HEI',!bore,'$!alias')
  !!mdsGetProp(!!mdsST01.overlap,!!mdsST01.pOverlap,'OVER',!bore,'$!alias')
  !!mdsGetProp(!!mdsST01.clearance,!!mdsST01.pClearance,'CLR',!bore,'$!alias')

  --<wd>jan2004
  --  if !alias.eq('ST11A') or !alias.eq('ST11B') or !alias.eq('ST12') then
  if !alias.eq('ST11A') or !alias.eq('ST11B') or !alias.eq('ST12') or !alias.eq('ST20') then
    --despar n$!existingdespar $!existingheight
    -- Modify the STOP DESPAR number where the STOP property dkey = 'HEI' - i.e. Identified Pipe SHOE Height
    !!ce = !datum
    !dpn = !!mdsgetdesp('HEI')
    despar num $!dpn  $!existingheight
  endif
  --<wd>jan2004

  -- Add marker text
  VAR !pos POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  -- Always add atta to support object
  !!mdsST01.support.atta.clear()
  !!mdsST01.support.atta.append(!!ce)
  !!mdsST01.support.datum  = !!ce
  !!mdsST01.support.pADir  = Pa Dir wrt world
  !!mdsST01.support.pLDir  = Pl Dir wrt world
  !!mdsST01.support.p9Dir  = P9 Dir wrt world

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.appendarray(!!mdsST01.support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourlist)

  -- When finished grey out datum gadget and reset height,length and setsteel

  !!mdsSetGadgets(!!mdsST01,!!ce,!!mdsST01.support.type)

  !!mdsST01.datum.active = false

  if !alias.eq('ST12') or !alias.eq('ST09A') or !alias.eq('ST09B') then
    !!mdsST01.setSteel.active = true
    !!mdsST01.setDefault.active = true
  endif


  -- Reset Units

  !!kRestoreUnits(!currentunits)

  -- End function
endfunction
-- End of function definition for !!mdsSetDatSt01
