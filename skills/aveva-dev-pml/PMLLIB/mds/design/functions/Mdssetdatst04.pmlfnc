--
-- File: Mdssetdatst04.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Andrew Kirkland
-- Created: Wed 11 Feb
--
--
-- Description:
-- Creation function for general ancillary st04
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatSt04()

  -- Find current units and set the distance unit to metric

  !currentunits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType    = !!mdsoptions.pipes
  !datum       = !!mdsST04.support.datum
  !name        = !!mdsST04.name.val
  !alias       = !!mdsST04.support.alias
  !fromAtta    = !!mdsST02.support.preliminaryStore.set()

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif
  !iDType = 'pipe'
  !purp = 'PIPE'

  label /again

  if (!fromAtta.not()) then
    if (!!mdsIdTube(!tubeType, 'Identify $!pipeType of $!iDType',!purp).not())then
      !!kRestoreUnits(!currentunits)
      return
    endif
  else
    !!ce = object DBREF('/' & !name & '_Pre')
  endif

  -- Select ancillary
  if(!!kGetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif
  $!boreUnits

  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  !currentunits = !!kGetSetUnits()

  -- <ak> 20/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsST04.support.datum = !!ce
  else
    new atta
  endif

  -- </ak> 20/06/2012
  SPKBRK TRUE
  !datum = !!ce

  !choice = SELECT SPEC /MDS WITH STYP 'ST04'
  handle any
    !projStandard = !!mdsST04.support.replace
    !!alert.error('Unable to select ancillary $!projStandard at this bore($!bore)')
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST04, true)
      return
    endif
    delete atta
    !!kRestoreUnits(!currentunits)
    return
  elsehandle none
    ------------------------------------------------------------------------------
    -- mjb >>> 10.04.06 <mds12>
    -- The element may exist in the specification but the project may not contain the size in the parameters file
    units mm bore
    spref $!choice[1]
    !lbor = !datum.lbor.real().value()
    !mds12test = !!mdssetdespars(!datum)
    if (!mds12test.not()) then
      --if undefined(!!mdsparst04[$!bore]) then
      -- mjb <<< end of mod
      ------------------------------------------------------------------------------
      !projStandard = !!mdsST04.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <ak> 20/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsST04, true)
        return
      endif
      delete atta
      !!kRestoreUnits(!currentunits)
      return
    endif
  endhandle
  ------------------------------------------------------------------------------
  -- mjb >>> 10.04.06 <mds12>
  --mm bore
  --spref $!choice[1]

  --!!mdssetdespars(!!ce)
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------

  ------------------------------------------------------------------------------
  -- mjb >>> 10.04.06 <mds12
  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!datum.stype,!lbor)
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST04, true)
      return
    endif
    delete atta
    !!mdsdaccontrol(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)
  --!check = object MDSCHECKSTD()
  -- mjb <<< end of mod
  ------------------------------------------------------------------------------
  !tmin = STRING()
  !tmax = STRING()
  if (!check.temp(!alias,!tmin,!tmax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tmin / $!tmax)')
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST04, true)
      return
    endif
    delete atta
    return
  endif

-- <ak> 03/07/2012
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentunits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsST04, true)
      return
    endif
    delete atta
    return
  endif
  -- </ak> 03/07/2012

  -- Test if the ancillary is available at this elevation

  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedelevation = !position.up
    ------------------------------------------------------------------------------
    -- mjb >>> 10.04.06 <mds12>
    !minimumelevation = !mdsattaobj.elevation
    --!minimumelevation = !!mdspar$!alias[0].despars[1]
    -- mjb <<< end of mod
    ------------------------------------------------------------------------------
    !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedelevation Minimum elevation $!minimumelevation')
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST04, true)
      return
    endif
    delete atta
    return
  endif

  -- Set the ATTA material
  !!mdssetmatref(!!ce)

  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsST04.support.type|

  !!mdsSetIspe()

  --  Add stex for isometrics
  -- set stex for atta
  !satta = !!ce

  !!mdsSelLstu(!!ce)

  pos at prev
  handle any
    pos at ph
  endhandle
  ori
  Call !!mdsTransport(!satta,!name)
  refresh

  label /sagain

  prompt off
  prompt load escape |Identify steelwork to guide from|
  --<wd>17jan2008 -- Defect No. P-4407
  --  id sctn @
  id sctn hstiff @
  --<wd>17jan2008 -- Defect No. P-4407
  handle (61,528)
    prompt on
    !!ce = !datum
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST04, true)
      return
    endif
    delete atta
    !!kRestoreUnits(!currentunits)
    return
  endhandle
  prompt dismiss
  prompt on
  !pick = !!ce

  pin 9 at poss
  pin 8 at pose
  pin 9 dir u wrt /*
  pin 9 plane pin 9 thro pin 8
  pin 9 dir from pin 9 to pin 8
  pin 7 copy pin 9
  pin 7 plane pin 7 thro $!datum
  pin 6 copy pl of $!datum
  pin 6 dist 100mm
  pin 9 dir u wrt /*
  pin 8 dir u wrt /*
  pin 7 dir u wrt /*
  pin 6 dir u wrt /*
  pin 8 plane pin 8 thro pin 9
  pin 7 plane pin 7 thro pin 9
  pin 6 plane pin 6 thro pin 9
  if !!kStrReal('const angle pin 9 to pin 7 to pin 6').neq(90) then
    !!mdsResetPins(6,9)
    !!alert.error('Identified steelwork is not perpendicluar to pipe!')
    golabel /sagain
  endif

  --<wd>nov2000
  !centre = !!mdsBeamCentre(!pick)
  !!ce = !datum
  plane pl thro $!centre
  --!!ce = !datum
  --thro $!pick
  --<wd>nov2000

  if (!!mdsModStop(!!mdsST04,'CREATE',!datum,!pick).not())then
    !!ce = !datum
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST04, true)
      return
    endif
    delete atta
    !!kRestoreUnits(!currentunits)
    return
  endif

  !bore = pa bore

  !!mdsGetProp(!!mdsST04.height,!!mdsST04.pHeight,'HEI',!bore,'ST04')
  !!mdsGetProp(!!mdsST04.overlap,!!mdsST04.pOverlap,'OVER',!bore,'ST04')
  !!mdsGetProp(!!mdsST04.clearance,!!mdsST04.pClearance,'CLR',!bore,'ST04')

  -- Add marker text
  VAR !pos POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  -- Always add atta to support object
  !!mdsST04.support.atta.clear()
  !!mdsST04.support.atta.append(!!ce)
  !!mdsST04.support.datum  = !!ce
  !!mdsST04.support.pADir  = Pa Dir wrt world
  !!mdsST04.support.pLDir  = Pl Dir wrt world
  !!mdsST04.support.p9Dir  = P9 Dir wrt world

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.appendarray(!!mdsST04.support.atta)

  -- Colour Support
  Call !!kEnhanceList(!colourlist)

  -- When finished grey out datum gadget and reset height,length and setsteel

  !!mdsSetGadgets(!!mdsST04,!!ce,!!mdsST04.support.type)
  !!mdsST04.datum.active = false

  -- Reset Units

  !!kRestoreUnits(!currentunits)

  -- End function
endfunction
-- End of function definition for !!mdsSetDatSt04
