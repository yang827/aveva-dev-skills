--
-- File: Mdssetdatst08.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Andrew Kirkland
-- Created: Thu 12 Feb
--
--
-- Description:
-- Creation function for general ancillary st08
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatSt08()

  -- Find current units and set the distance unit to metric

  !currentunits = !!kGetSetUnits()

  -- Initialise variables
  !unusedtubeType    = !!mdsOptions.pipes
  !datum       = !!mdsST08.support.datum
  !name        = !!mdsST08.name.val
  !alias       = !!mdsST08.support.alias
  !fromAtta    = !!mdsST08.support.preliminaryStore.set()

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- unused label /again

  -- <ak> 21/06/2012
  if (!fromAtta AND defined (!!mdsAutoTubePicker) AND !!mdsAutoTubePicker.enabled()) then
    -- return if limit of pick tries exceeded
    if (!!mdsAutoTubePicker.allowedPicks.eq(0)) then
      !!mdsAutoTubePicker.cancel()
      return FALSE
    endif

    !picked = !!mdsAutoTubePicker.pick('PLAT','')
    if unset(!picked) then
      !!alert.warning ('There is no plate suitable to stop next to preliminary support.')
      !!mdsAutoTubePicker.cancel()
      !!kRestoreUnits(!currentunits)
      return false
    else
      !!ce = !picked
    endif
  endif
  -- <ak>

  if !alias.eq('ST14') or !alias.eq('ST15') or !alias.eq('ST16') then

    -- Identify pedestal to attach guide to
    -- <ak> 21/06/2012
    if (!fromAtta.not()) then
      prompt off
      prompt load escape 'Identify baseplate plate'
      ID PLAT ATTA @
      handle (61,528)
        prompt on
        !!kRestoreUnits(!currentunits)
        return false
      endhandle
      prompt on
    endif
    -- <ak>

    !plat = !!ce
    -- The styp has to be the following
    -- AC18

    !styp = !!ce.styp

    if (!styp.upcase() inset('AC18A','AC18B')) then
    else
      !!alert.error('The identified element is not a base plate')
      !!kRestoreUnits(!currentunits)
      return
    endif
    -- Check that the bran does not include a bearing plate
    var !bplates coll all (PLAT ATTA) with matchwild(Stype,'AC19*') FOR BRAN
    if !bplates.empty() eq FALSE then
      !!alert.error('The identified element has a bearing plate and is not suitable for this support')
      return
    endif
    -- Get the P2 direction of the Elbow (p2 never up), Cross or Tee as we need this later
    !pipdir = p2 dir of href of owner
    !pipdir.up = 0  $* Remove the fall

  else

    -- Identify pedestal to attach guide to
    -- <ak> 21/06/2012
    if (!fromAtta.not()) then
      prompt off
      prompt load escape 'Identify bearing plate'
      ID PLAT ATTA @
      handle (61,528)
        prompt on
        !!kRestoreUnits(!currentunits)
        return false
      endhandle
      prompt on
    endif

    -- The styp has to be the following
    -- AC19
    !plat = !!ce
    !styp = !!ce.styp

    if (!styp.upcase() inset('AC19A','AC19B')) then
    else
      !!alert.error('The identified element is not a bearing plate')
      !!kRestoreUnits(!currentunits)
      return
    endif

  endif

  !bore = pl bore
  !p3dir = p3 dir wrt /*

  !!mdsdaccontrol(true)


  -- <ak> 20/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsST08.support.datum = !!ce
  else
    if !alias.eq('ST14') or !alias.eq('ST15') or !alias.eq('ST16') then
      new atta
    else
      new atta before
    endif
  endif
  -- </ak> 20/06/2012

  spkbrk true

  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsST08.support.replace
    !!alert.error('Unable to select stop $!projStandard at this bore($!bore)')
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST08, true)
      return
    endif
    delete atta
    !!kRestoreUnits(!currentunits)
    !!mdsdaccontrol(FALSE)
    return
  elsehandle NONE

    ------------------------------------------------------------------------------------------
    -- mjb >>> 28.04.06 <mds12>
    -- The element may exist in the specification but the project may not contain the size in the parameters file
    units mm bore
    spref $!choice[1]
    !cratta = !!ce
    !lbor = !cratta.lbor.real().value()
    !mds12test = !!mdssetdespars(!cratta)
    if (!mds12test.not()) then
      --if undefined(!!mdspar$!alias[$!bore]) then

      -- mjb <<< 28.04.06 <mds12> end of mod
      ------------------------------------------------------------------------------------------
      !projStandard = !!mdsST08.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <ak> 20/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsST08, true)
        return
      endif
      delete atta
      !!kRestoreUnits(!currentunits)
      !!mdsdaccontrol(true)
      return
    endif
  endhandle
  ------------------------------------------------------------------------------------------
  -- mjb >>> 28.04.06 <mds12>
  --mm bore
  --spref $!choice[1]

  --!!mdssetdespars(!!ce)

  --!cratta = !!ce

  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below
  --!check = object MDSCHECKSTD()
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!cratta.stype,!lbor)
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST08, true)
      return
    endif
    delete atta
    !!mdsdaccontrol(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)
  -- mjb <<< 28.04.06 <mds12> end of mod
  ------------------------------------------------------------------------------------------

  !tmin = STRING()
  !tmax = STRING()
  if (!check.temp(!alias,!tmin,!tmax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tmin / $!tmax)')
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST08, true)
      return
    endif
    delete atta
    return
  endif

-- <ak> 03/07/2012
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentunits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsST08, true)
      return
    endif
    delete atta
    return
  endif
  -- </ak> 03/07/2012

  -- Test if the ancillary is available at this elevation

  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedelevation = !position.up
    ------------------------------------------------------------------------------------------
    -- mjb >>> 28.04.06 <mds12>
    !minimumelevation = !mdsattaobj.elevation
    --!minimumelevation = !!mdspar$!alias[0].despars[1]
    -- mjb <<< 28.04.06 <mds12> end of mod
    ------------------------------------------------------------------------------------------
    !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedelevation Minimum elevation $!minimumelevation')
    !!kRestoreUnits(!currentunits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST08, true)
      return
    endif
    delete atta
    return
  endif

  -- Set the ATTA material
  !!mdssetmatref(!!ce)

  !!mdsdaccontrol(TRUE)

  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsST08.support.type|

  !!mdsSetIspe()

  conn
  ori and p11 is $!p3dir

  --  Add stex for isometrics
  !satta = !!ce
  Call !!mdsTransport(!satta,!name)

  !!mdsSelLstu(!!ce)

  !!mdsdaccontrol(true)


  -- Read the parameters of the baseplate/bearing plate to resize the stop

  if !alias.eq('ST14') or !alias.eq('ST15') or !alias.eq('ST16') then

    if !alias.eq('ST14') then
      -- Identify beam or box to size stop
      prompt off
      prompt load escape 'Identify section or box to use as stop'
      --<wd>17jan2008 -- Defect No. P-4407
      --    ID SCTN BOX @
      ID SCTN BOX HSTIFF @
      --<wd>17jan2008 -- Defect No. P-4407
      handle (61,528)
        golabel /cancel
        prompt on
        !!kRestoreUnits(!currentunits)
        return false
      endhandle
    else
      -- Identify beam to size stop
      prompt off
      prompt load escape 'Identify steel section for stop'
      --<wd>17jan2008 -- Defect No. P-4407
      --   ID SCTN @
      ID SCTN HSTIFF @
      --<wd>17jan2008 -- Defect No. P-4407
      handle (61,528)
        golabel /cancel
        prompt on
        !!kRestoreUnits(!currentunits)
        return false
      endhandle
    endif

    prompt on
    !unusedelement = !!ce
    -- Check that the sctn is in correct plane for Support Type
    -- For ST14 type - pipe must be perpendicular to beam. ST15 - pipe must be parallel
    --<wd>17jan2008 -- Defect No. P-4407
    --   if !!ce.type EQ 'SCTN' then
    if !!ce.type EQ 'SCTN' or !!ce.type EQ 'HSTIFF' then
      --<wd>17jan2008 -- Defect No. P-4407
      !beam = !!ce
      !zdir = Zdir wrt /*
      if !alias.eq('ST14') then
        if !pipdir.isParallel(!zdir) eq False then
          --This is ok for ST14
        else
          !!alert.error('Unable to create STOP ST14 as pipe and beam are Parallel')
          !!ce = !satta
          -- <ak> 20/06/2012
          if !fromAtta then
            !!mdsRestorePre(!!mdsST08, true)
            return
          endif
          delete atta
          return False
        endif
      elseif !alias.eq('ST15') then
        if !pipdir.isParallel(!zdir) then
          --This is ok for ST15
        else
          !!alert.error('Unable to create GUIDE ST15 as pipe and beam must be Parallel')
          !!ce = !satta
          -- <ak> 20/06/2012
          if !fromAtta then
            !!mdsRestorePre(!!mdsST08, true)
            return
          endif
          delete atta
          return False
        endif
      endif
      -- Get the plate width because if sctn width is wider than plate width move stop up
      -- Check for rotation of atta
      if !zdir.isParallel(!plat.pdir[10])  then
        !pwid = !plat.prop.pwid
        !plen = !plat.prop.plen
      else
        !pwid = !plat.prop.plen
        !plen = !plat.prop.pwid
      endif

      -- Get width of beam from property WIDT
      if (!beam.gtype inset ('BEAM','TEE','DINI','DINT','BOX')) then
        !width  = !beam.prop.widt
        !!ce = !cratta
        despar n6 $!width
      else
        !!ce = !cratta
        pin 8 copy pl
        pin 9 copy pl
        pin 8 plane pin 8 clear 0 inf same
        pin 9 plane pin 9 clear 0 beh same
        var !width  const dist pin 8 to pin 9
      endif
      same
      -- Orientate stop in same dir as beam
      conn and p10 is zdir of same
      handle ANY
      endhandle
      -- Check the width of the Beam compared to the plate. !pwid is Plate width
      -- If width of beam is wider than plate move stopper up by setting despar1 to 0
      -- and change despar n6
    else
      -- The id element is a box
      !box = !!ce
      $!plat
      bran
      goto href
      pin 2 copy pl
      pin 3 copy pl
      pin 2 plane pin 2 clear 0 infront $!box
      pin 3 plane pin 3 clear 0 behind $!box
      !boxWidth = !!kStrReal('const dist pin 2 to pin 3')
      $!satta
      despar n6 $!boxWidth
      !width = !!kStrReal('const dist pin 2 to pin 3')
      var !dir const dir pin 2 to pin 3
      !!mdsresetpins(2,5)
      !zdir = !dir.direction()
      if !zdir.isParallel(!plat.pdir[10])  then
        !pwid = !plat.prop.pwid
        !plen = !plat.prop.plen
      else
        !pwid = !plat.prop.plen
        !plen = !plat.prop.pwid
      endif
      -- Orientate stop
      conn and p30 is $!dir
      handle ANY
      endhandle
    endif

    if !alias.eq('ST14') or !alias.eq('ST15') then
      if !plen.real() gt !width.real() then
        despar n6 $!width
      else
        despar n6 $!plen
        !desp5 = Desp[5]
        despar n5 -$!desp5
      endif
    elseif !alias.eq('ST16') then
      if !pwid.real() gt !width.real() and !plen.real() gt !width.real() then
        --$p 1ST
        despar n6 $!width
        despar n7 $!pwid
      elseif !pwid.real() le !width.real() and !plen.real() gt !width.real()  then
        --$p 2rd
        despar n6 $!width
        despar n7 $!pwid
      elseif !pwid.real() gt !width.real() and !plen.real() lt !width.real() then
        --$p 3rd
        despar n1 0mm
        despar n6 $!plen
        despar n7 $!pwid
      elseif !pwid.real() le !width.real()  then
        --$p 4th
        despar n1 0mm
        despar n6 $!plen
        despar n7 $!pwid
      endif
    endif


    --Set extra despar for ST16
    if !alias.eq('ST16') then
      --Check if the atta has been rotated
      $!satta
      !p10Dir = p10 dir
    endif
    label /cancel
    !!mdsGetProp(!!mdsST08.height,!!mdsST08.pHeight,'HEI',!bore,!!mdsST08.support.type)
    handle any
    endhandle
    !!mdsGetProp(!!mdsST08.overlap,!!mdsST08.pOverlap,'CLR',!bore,!!mdsST08.support.type)
    handle any
    endhandle

    !!mdsST08.rotatt.active = FALSE

  else
    if (!fromAtta) then
      owner
      reorder $!!mdsST08.support.datum.refno before $!plat.refno
      !!ce = !!mdsST08.support.datum
    endif
    prev
    !basePlateLength    = (prop PLEN)
    !basePlateWidth     = (prop PWID)
    !unusedbaseplate = !!ce
    :MdsGuideRef next
    next2
    !bearingPlateLength = (prop PLEN)
    !bearingPlateWidth  = (prop PWID)
    prev
    :MdsGuideRef prev
    despar n1 $!bearingPlateLength
    despar n2 $!bearingPlateWidth
    despar n3 $!basePlateWidth
    despar n4 $!basePlateLength

    -- Set height and length gadgets

    !bore = pa bore
    !!mdsGetProp(!!mdsST08.height,!!mdsST08.pHeight,'SWID',!bore,!!mdsST08.support.type)
    handle any
    endhandle
    !!mdsGetProp(!!mdsST08.overlap,!!mdsST08.pOverlap,'STHK',!bore,!!mdsST08.support.type)
    handle any
    endhandle

    !!mdsST08.rotatt.active = TRUE
  endif
  if !!mdsST08.support.alias.eq('ST14') then
    !!mdsST08.rotatt.active = true
  else
    !!mdsST08.rotatt.active = false
  endif

  -- Add marker text
  VAR !pos POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  $!cratta
  -- Always add atta to support object
  !!mdsST08.support.atta.clear()
  !!mdsST08.support.atta.append(!!ce)
  !!mdsST08.support.datum  = !!ce
  !!mdsST08.support.pADir  = Pa Dir wrt world
  !!mdsST08.support.pLDir  = Pl Dir wrt world

  -- Enhance elements using colour set for highlight
  !colourlist = ARRAY()
  !colourlist.appendarray(!!mdsST08.support.atta)

  -- Colour Support
  Call !!kEnhanceList(!colourlist)

  -- When finished grey out datum gadget and reset height,length and setsteel

  !!mdsST08.datum.active = FALSE
  !!mdsST08.setDefault.active = TRUE

  !!mdsdaccontrol(false)

  -- Reset Units

  !!kRestoreUnits(!currentunits)

  -- End function
endfunction
-- End of function definition for !!mdsSetDatSt08
