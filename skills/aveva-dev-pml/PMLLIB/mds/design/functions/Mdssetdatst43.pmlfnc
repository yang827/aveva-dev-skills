--
-- File: Mdssetdatst43.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: D.whiteside
-- Created: 6 November 2008
--
--
-- Description:
-- Creation function for guide ST43  (dun1052)
-- Transferred: 16 March 2009 for MDS12.0SP5 DUN1119
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatST43()

  -- Force into forwards mode
  FORWARDS

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kgetSetUnits()

  -- Initialise variables
  !tubeType    = !!mdsOptions.pipes
  !datum       = !!mdsST43.support.datum
  !name        = !!mdsST43.name.val
  !alias       = !!mdsST43.support.alias
  !fromAtta    = !!mdsST43.support.preliminaryStore.set()
  !supportType = !!mdsGuide.standard.selection('Rtext')
  !lineStop    = TRUE
  if !supportType inset ('ST43','ST44') then
    !lineStop = FALSE
  endif

  !unusedCecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif
  !idType = 'pipe'
  !purp = 'PIPE'

  if !lineStop eq TRUE then
    -- Identify pipe for stop attachment
    if (!fromAtta.not()) then
      if (!!mdsIdTube(!tubeType, 'Identify $!pipeType of datum $!idType',!purp).not())then
        return
      endif
    else
      !!ce = object DBREF('/' & !name & '_Pre')
    endif

    -- In case we id a different element when second pick set the first id
    if (!!ce.type.eq('BRAN')) then
      !idbran = !!ce
    else
      !idbran = !!ce.owner
    endif
    !idcomp = !!ce
    !pipeMat = !idcomp.owner.pspe.:MDSPipeMat
    if !pipeMat inset ('CS','LTCS') then
    else
      !answer = !!alert.confirm('Wear pad on pipe as material is neither CS or LTCS')
      if !answer eq 'YES' then
        prompt off
        prompt load escape |Identify wear pad for attachment|
        ID ATTA @
        !picked = !!ce
        prompt dismiss
        prompt on
        if !picked.stype inset ('AT174','AT175') then
          same
        else
          !!alert.error('Identified element must be a Wear pad type AT174 or AT175')
          return
        endif
      else
        !!alert.error('Wear pad type AT174 or AT175 must be added')
        return
      endif
    endif
    !!mdsST43.support.idcomp = !idcomp
    !!mdsST43.support.idbran = !idbran
  else
    -- Identify shoe to attach guide to
    -- <ak> 21/06/2012
    if (!fromAtta AND defined (!!mdsAutoTubePicker) AND !!mdsAutoTubePicker.enabled()) then

      -- return if limit of pick tries exceeded
      if (!!mdsAutoTubePicker.allowedPicks.eq(0)) then
        !!mdsAutoTubePicker.cancel()
        return FALSE
      endif

      !picked = !!mdsAutoTubePicker.pickShoe()
      if unset(!picked) then
        !!alert.warning ('There is no pipe shoe suitable to guide next to preliminary support.')
        !!mdsAutoTubePicker.cancel()
        !!kRestoreUnits(!currentUnits)
        return false
      else
        !!ce = !picked
      endif

    else
      -- Identify shoe for stop attachment
      prompt off
      prompt load escape 'Identify pipe shoe to stop'
      ID ATTA @
      handle (61,528)
        prompt dismiss
        prompt on
        !!kRestoreUnits(!currentUnits)
        return FALSE
      endhandle
      prompt dismiss
      prompt on
    endif
    -- </ak>

    !atta = !!ce

    --<RM 31/07/09> replaced selection/restriction code with the !!mdsValidComponent function which uses the
    --mdsSelection object to find the component selections and restrictions and then brings up the mdsSelectionList messagebox to warn of
    --incompatibility
    if (!!mdsValidComponent('ST43', !!ce).not()) then
      return
    endif
    --<RM 31/07/09> - END

    --<dw>jan2009 dun1081 - End of shoe type selection & restriction
    -- Is it a shoe
    if !!ce.catref.owner.:mdsGuidable then
    else
      !!alert.error('The identified element is not suitable to guide with this type, it must be a pipe shoe')
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endif

  --------------------------------------------------------------------------------

  -- Select ancillary

  !bore = Pl bore
  handle ANY
    !bore = ph bore
  endhandle

  !!mdsDacControl(TRUE)

  -- <ak> 20/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsST43.support.datum = !!ce
  else
    new atta
  endif
  -- </ak> 20/06/2012

  SPKBRK TRUE
  !datum = !!ce

  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle ANY
    !projStandard = !!mdsST43.support.replace
    !!alert.error('Unable to select ancillary $!projStandard at this bore($!bore)')
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST43, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    !!kRestoreUnits(!currentUnits)
    return
  elsehandle NONE
    -- The element may exist in the specification but the project may not contain the size in the parameters file
    units mm bore
    spref $!choice[1]
    !lbor = !datum.lbor.real().value()
    !mds12test = !!mdsSetDespars(!datum)
    if (!mds12test.not()) then
      --if undefined(!!mdspar$!alias[$!bore]) then
      !projStandard = !!mdsST43.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <ak> 20/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsST43, true)
        return
      endif
      delete atta
      !!mdsDacControl(FALSE)
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endhandle
  spref $!choice[1]

  !!mdsSetDespars(!!ce)

  --<wd>dec2003->>>
  !!mdsDacControl(TRUE)
  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below
  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!datum.stype,!lbor)

  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST43, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)
  !min = STRING()
  !max = STRING()
  !matError = STRING()

  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentUnits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST43, true)
      return
    endif
    delete atta
    return
  endif

  -- <ak> 03/07/2012
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentUnits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsST43, true)
      return
    endif
    delete atta
    return
  endif
  -- </ak> 03/07/2012

  if (!check.insu(!alias,!min,!max).not()) then
    var !insu insu
    !!kformattext.text.val  = $!max
    !maxval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!min
    !minval = !!kformattext.text.val.string(!!distancefmt)
    !!kformattext.text.val = $!insu
    !insval = !!kformattext.text.val.string(!!distancefmt)
    !!alert.message ('The INSULATION on the identified pipe ($!<insval>$!<units>) is not within the MIN ($!<minval>$!<units>) and MAX ($!<maxval>$!<units>) limits of the Insulation Thickness Values for the selected ancillary support type, i.e. replace')
    !!kRestoreUnits(!currentUnits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST43, true)
      return
    endif
    delete atta
    return
  endif

  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below

  !tmin = STRING()
  !tmax = STRING()
  if (!check.temp(!alias,!tmin,!tmax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tmin / $!tmax)')
    !!kRestoreUnits(!currentUnits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST43, true)
      return
    endif
    delete atta
    return
  endif

  -- Test if the ancillary is available at this elevation

  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedElevation = !position.up
    !minimumElevation = !mdsattaobj.elevation
    --!minimumElevation = !!mdspar$!alias[0].despars[1]
    !!alert.message ('The elevation selected is unsuitable for this ancillary. selected elevation $!selectedElevation Minimum elevation $!minimumElevation')
    !!kRestoreUnits(!currentUnits)
    -- <ak> 20/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsST43, true)
      return
    endif
    delete atta
    return
  endif

  -- Set the ATTA - UDA :MDSMatRef with the PROPCON Property, if it is declared in the dimensions default file
  !!mdssetmatref(!!ce)

  --<ge>03nov2004
  !!mdsDacControl(TRUE)

  -- Name support
  :MDSSuppType |$!!mdsST43.support.type|
  name /$!name
  !stop = !!ce
  POS AT PREV
  ori

  -- Set steelwork gap
  if !supportType inset('GT85','GT86A','GT86B','GT87A','GT87B','GT87C','GT87D','ST59') then
    !promptext = 'for alignment'
  else
    !promptext = 'to set steelwork gap'
  endif
  prompt off
  prompt load escape 'Identify section $!promptext '
  ID SCTN @
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentUnits)
    return
  endhandle
  prompt on
  !pick = !!ce

  pin 9 at poss
  pin 8 at pose
  pin 9 dir u wrt /*
  pin 9 plane pin 9 thro pin 8
  pin 9 dir from pin 9 to pin 8
  pin 7 copy pin 9
  pin 7 plane pin 7 thro $!datum
  pin 6 copy pl of $!datum
  pin 6 dist 100mm
  pin 9 dir u wrt /*
  pin 8 dir u wrt /*
  pin 7 dir u wrt /*
  pin 6 dir u wrt /*
  pin 8 plane pin 8 thro pin 9
  pin 7 plane pin 7 thro pin 9
  pin 6 plane pin 6 thro pin 9
  if !!kstrReal('const angle pin 9 to pin 7 to pin 6').neq(90) then
    !!alert.error('Identified steelwork is not perpendicular to pipe!')
    return
  endif

  !steelWidth = (prop WIDT)
  handle ANY
    !!kRestoreUnits(!currentUnits)
    !!alert.error('Unable to find member width property WIDT')
    return
  endhandle

  !centre = !!mdsBeamcentre(!pick)
  !!ce = !stop

  !adjustplate = FALSE
  if !supportType inset('GT85','GT86A','GT86B','GT87A','GT87B','GT87C','GT87D') then
    plane pl thro $!pick
    !adjustplate = TRUE
  else
    plane pl thro $!centre
  endif

  !desp = !!mdsGetDesp('SBFW')
  if !desp.eq(0) then
    !desp = !!mdsGetDesp('SSMW')
  endif
  if !desp.eq(0) then
    !desp = !!mdsGetDesp('WID')
  endif

  if !lineStop eq TRUE then
    if !adjustplate eq FALSE then
      despar n$!desp  $!steelWidth
    endif
  else
    --Set Guide Atta :MDSGuideRef to Shoe Atta
    :MDSGuideRef $!atta

    --Find length of stop
    !gapdpnum  = !!mdsGetDesp('WID')
    !lendpnum  = !!mdsGetDesp('LEN')
    !cledpnum  = !!mdsGetDesp('WID')
    !gapvalue  = !stop.desp[$!gapdpnum]
    !lenvalue  = !stop.desp[$!lendpnum]
    !clevalue  = !stop.desp[$!cledpnum]
    !lengstop  = (!gapvalue + 2 * (!lenvalue + !clevalue))
    -- Navigate back to Shoe Atta and Set :MDSGuideRef to Guide Atta
    !!ce  = !atta
    :MDSGuideRef $!stop
    handle ANY
      claim ce
      :MDSGuideRef $!stop
    elsehandle NONE
    endhandle
    -- Find length of shoe
    !lendpnum  = !!mdsGetDesp('LEN')
    !lengshoe  = !atta.desp[$!lendpnum]
    !!mdsST43.shoelen.active = TRUE
    !!mdsST43.shoelen.val    = |Adjust Shoe where Stop = $!lengstop|
    !!mdsST43.shoeadj.active = TRUE
    !!mdsST43.shoeadj.val    = $!lengshoe
    -- Set stop dims to the shoe that it is supporting
    !!mdsResetGuide()
    !!ce = !stop
    despar n$!desp  $!steelWidth
    ori and p3 is p3 of prev
    !!mdsST43.boltedlen.active  = FALSE
    !!mdsST43.pboltedlen.active = FALSE
    !!mdsST43.boltedlen.val     = 0
  endif

  !!mdsSetIspe()

  --  Add stex for isometrics
  call !!mdsTransport(!!ce,!name)

  !!mdsSelLstu(!!ce)

  !!mdsDacControl(TRUE)

  -- Add marker text
  VAR !pos pos P9 WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

  -- Always add atta to support object
  !!mdsST43.support.atta.clear()
  !!mdsST43.support.atta.append(!!ce)
  !!mdsST43.support.datum  = !!ce
  !!mdsST43.support.paDir  = Pa Dir wrt world
  !!mdsST43.support.plDir  = Pl Dir wrt world
  !!mdsST43.support.p9Dir  = P9 Dir wrt world
  !!mdsST43.support.position = TRUE

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsST43.support.atta)

  -- Colour Support
  call !!kenhanceList(!colourList)

  -- When finished grey out datum gadget and reset gadgets

  !!mdsSetGadgets(!!mdsST43,!!ce,!!mdsST43.support.type)

  !!mdsST43.datum.active = FALSE

  !!mdsDacControl(TRUE)

  --!!mdsST43.setdefault.active = false
  --!!mdsST43.adjust.active     = true
  if !adjustplate then
    !!mdsST43.height.val        = 0
    !!mdsST43.offset.active     = TRUE
    !!mdsST43.poffset.active    = TRUE
    !!mdsST43.offset.val        = 0
  elseif !supportType inset('ST43','ST44','ST57','ST58') then
    !!mdsST43.boltedlen.active  = FALSE
    !!mdsST43.pboltedlen.active = FALSE
    !!mdsST43.boltedlen.val     = 0
  else
    !!mdsST43.height.active = TRUE
  endif
  !!mdsResetPins(1,9)
  !!mdsDacControl(FALSE)
  -- End function
endfunction
