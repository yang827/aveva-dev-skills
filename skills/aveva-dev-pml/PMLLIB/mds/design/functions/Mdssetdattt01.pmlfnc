--------------------------------------------------------------------------------
--
-- File:  Mdssetdattt01.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Wayne Dodwell
-- Created:  Thursday 12th February 1998
--
--
-- Description:
-- Creation function for Trunnion Type 'TT01' and  'TT03'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        FORM of current Trunnion Type
--     2     R        STRING       CREATE - for Creating the Datum Atta - Trunnion Type and Size
--                              or MODIFY - for Reselecting the Datum Atta - Trunnion Type and Size
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------


-- Define Function
define function !!mdssetdattt01(!form is FORM, !mode is STRING)

  -- Find current units and set the distance unit to metric
  !currentunits = !!kgetsetunits()
  !fromAtta    = !form.support.preliminaryStore.set()

  -- Initialise variables
  !support     = !form.support
  !tubetype    = !!mdsoptions.pipes
  !datum       = !form.support.datum
  !name        = !form.name.val
  !alias       = !form.support.alias
  !cecomp      = !!ce
  !formname    = '!!' & !form


  --------------------------------------------------------------------------------
  -- Create the Datum - Trunnion Atta
  if (!mode.upcase() eq 'CREATE') then
    if (!datum.set()) then
      !!alert.error('Atta for support $!name already exists')
      !!kRestoreUnits(!currentunits)
      return
    endif

    -- Select Elbo or Tube
    if (!alias inset('TT02')) then
      !tubetype = 'ELBO'
      !pipeType = 'elbo'
      !idtype = 'pipe'
      !purp = 'PIPE'
    else
      if (!tubetype eq 'FTUB')then
        !pipeType = 'lined section'
      else
        !pipeType = 'tube'
      endif
      !idtype = 'pipe'
      !purp = 'PIPE'
    endif

    --------------------------------------------------------------------------------
    label /again

    if (!!mdsidtube(!tubetype, 'Identify $!pipeType of $!idtype',!purp).not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    --------------------------------------------------------------------------------
    forwards
    --------------------------------------------------------------------------------
    -- Check Angle of Elbo is NOT less than the permitted minimum
    -- for Trunnion Type 'TT02'
    -- Despar 1 is Length of Trunnion + ELbo Leg Length + 1/2 Pipe O/D
    -- Despar 2 is Offset
    --------------------------------------------------------------------------------
    --------------------------------------------------------------------------------
    if (!alias.eq('TT02')) then
      !angle = angle

      if (!angle.neq(90)) then
        !!alert.error('Angle of Identified Elbow MUST be 90 degrees for Trunnion type ''TT02''')
        golabel /again
      endif

      !comp = !!ce
      !form.elboref = !comp
      --------------------------------------------------------------------------------
    else

      -- Check PIPE is Vertical if Trunnion Type is 'TT01' or 'TT03'
      if (!!ce.type eq 'BRAN') then
        !hdir = hdir wrt /*
      else
        !hdir = pl dir wrt /*
      endif

      if (!hdir neq U and !hdir neq D ) then
        !!alert.message ('Only VERTICAL Pipes may be supported with the Trunnion Type ''$!support.type''')
        !!ce = !cecomp
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        !!kRestoreUnits(!currentunits)
        return
      endif

      !comp = !!ce
    endif

    --------------------------------------------------------------------------------
    -- Get Session Bore Units
    if(!!kGetBoreUnits()) then
      !boreUnits = 'inch bore'
    else
      !boreUnits = ''
    endif
    $!boreUnits

    !bore = pl bore
    handle any
      !bore = ph bore
    endhandle

    -- Create a Temporary Support Atta
    --------------------------------------------------------------------------------
    new atta
    SPKBRK TRUE

    -- Get the Current Pipe Size and Get the Array Name, eg: '!!mdstrunnions.pdia10' '!!mdstrunnions.pdia12' etc...,
    -- which is used to load the  COMMON Trunnion form gadget '!!mdstrunnvt01.standard'
    -- from '!!mdstrunnval()'
    --------------------------------------------------------------------------------
    !atta     = !!ce
    !function = !!mdstrunnval(!atta)

    if (!function eq 'false') then
      delete atta
      !!ce = !cecomp
      !!alert.error('Trunnion Type ' & !support.replace & ' is NOT available at the Selected Pipe Size('& !bore.string().trim() &')')
      !!kRestoreUnits(!currentunits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    else
      !list = $!function
      if (!list.empty()) then
        delete atta
        !!ce = !cecomp
        !!alert.error('Trunnion Type ' & !support.replace & ' is NOT available for the Selected Pipe Size('& !bore.string().trim() &')')
        !!kRestoreUnits(!currentunits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      endif
    endif

    --------------------------------------------------------------------------------

    -- Temporarily Select the First available Trunnion in the hidden form member array
    -- '!!mdstrunnions.pdia{size}' to suit the Trunnion Type(!alias) required and the
    --  bore size of the Identified Pipe
    !block = object BLOCK('!list[!evalindex].match(!alias).eq(1)')
    !exist = !list.evaluate(!block)
    !rtext = ARRAY()
    !dtext = ARRAY()

    do !index indices !exist
      skip if (!exist[!index].not())
      !rtext.append(!list[!index])
      !part2 = !list[!index].part(2,'-')
      !part3 = !list[!index].part(3,'-')
      if (!!kGetBoreUnits()) then
        -- Imperial bores
        !dtext.append('Type ' & !part2 & '  -  ' & !part3 & 'inch Diameter trunnion ')
      else
        -- Metric Bores
        !impbore = !part3.real()
        !mmbore = !!kborelookup(!impbore,'MM')
        if (!mmbore.eq(0)) then
          !dtext.append(!list[!index])
        else
          !boremm = !mmbore.string()
          !dtext.append('Type ' & !part2 & '  -  ' & !boremm & 'mm Diameter trunnion ')
        endif
      endif
    enddo

    -- Ensure Metric Bore Units
    units mm bore

    !unusedchoice = select spec /MDS with styp '$!rtext[1]'
    --------------------------------------------------------------------------------
    handle any
      delete atta
      !!ce = !cecomp
      !!alert.error('Trunnion Type ' & !support.replace & ' is NOT available for the Selected Pipe Size('& !bore.string().trim() &')')
      !!kRestoreUnits(!currentunits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return

    elsehandle none
      -- Reset Bore Units to 'MM'
      units mm bore

      -- Delete Temporary ATTA
      delete atta
      !!ce = !comp

      --------------------------------------------------------------------------------
      -- Form '!!mdstrunnvt01' is USED for Selection of all 'TRUNNION' Types
      -- The List of Available Trunnions for the type '!alias' is contained in the
      -- Array Variable '!rtext'  - Load the '!!mdstrunnvt01.standard' gadget

      -- Trunnion Descriptions 'dtext' are derived from their 'stype' which are the '!rtext'
      !!mdstrunnvt01.standard.dtext = !dtext
      !!mdstrunnvt01.standard.rtext = !rtext

      -- Set the Callback actions on the Common Trunnion Selection
      -- form '!!mdstrunnvt01.ok'  - OK gadget
      if (!alias.eq('TT02')) then
        !!mdstrunnvt01.action.clear()
        !!mdstrunnvt01.action[1] = |call !!mdscrdattt02($!formname,'CREATE')|
        !!mdstrunnvt01.action[2] = ||
      else
        -- Trunnion types 'TT01' and 'TT03'
        !!mdstrunnvt01.action.clear()
        !!mdstrunnvt01.action[1] = |call !!mdscrdattt01($!formname,'CREATE')|
        !!mdstrunnvt01.action[2] = ||
      endif

      !!mdstrunnvt01.cancel.callback = ||

      -- Edit Form Title and Show
      !!mdstrunnvt01.formtitle = 'Trunnion '& !support.replace &' Selection'
      !!kshowform (!!mdstrunnvt01)

    endhandle

    --------------------------------------------------------------------------------
    --------------------------------------------------------------------------------
    --------------------------------------------------------------------------------

  elseif (!mode.upcase() eq 'MODIFY') then
    !!ce = !datum
    if (!alias.eq('TT02')) then
      if (!datum.:MDSSref.badref()) then
        !!alert.error('The Elbow for the Trunnion ''$!datum.name'' does NOT exist. Aborting modification of trunnion')
        !!kRestoreUnits(!currentunits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      else
        !form.elboref = :MDSSref
      endif
    endif

    -- Get the Current Pipe Size and Get the Array Name, eg: '!!mdstrunnions.pdia10' '!!mdstrunnions.pdia12' etc...,
    -- which is used to load the  COMMON Trunnion form gadget '!!mdstrunnvt01.standard'
    -- from '!!mdstrunnval()'
    --------------------------------------------------------------------------------
    -- Get Session Bore Units
    if(!!kGetBoreUnits()) then
      !boreUnits = 'inch bore'
    else
      !boreUnits = ''
    endif
    $!boreUnits

    !bore = pl bore
    handle any
      !bore = ph bore
    endhandle

    !atta     = !!ce
    !function = !!mdstrunnval(!atta)

    -- Check if Trunnions are available at the Current Pipe Size
    if (!function eq 'false') then
      !!alert.error('Trunnion Type ' & !support.replace & ' is NOT available at the Selected Pipe Size('& !bore.string().trim() &')')
      !!kRestoreUnits(!currentunits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    else
      !list = $!function
      if (!list.empty()) then
        !!alert.error('Trunnion Type ' & !support.replace & ' is NOT available for the Selected Pipe Size('& !bore.string().trim() &')')
        !!kRestoreUnits(!currentunits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      endif
    endif

    -- Reset Bore Units to 'MM'
    units mm bore

    -- Determine from the hidden form member array '!!mdstrunnions.pdia{size}'
    -- the Trunnion Type(!alias) list required with the bore size of the Current Pipe
    !block = object BLOCK('!list[!evalindex].match(!alias).eq(1)')
    !exist = !list.evaluate(!block)
    !rtext = ARRAY()
    !dtext = ARRAY()

    do !index indices !exist
      skip if (!exist[!index].not())
      !rtext.append(!list[!index])
      !part2 = !list[!index].part(2,'-')
      !part3 = !list[!index].part(3,'-')
      if (!!kGetBoreUnits()) then
        -- Imperial bores
        !dtext.append('Type ' & !part2 & '  -  ' & !part3 & 'inch Diameter trunnion ')
      else
        -- Metric Bores
        !impbore = !part3.real()
        !mmbore = !!kborelookup(!impbore,'MM')
        if (!mmbore.eq(0)) then
          !dtext.append(!list[!index])
        else
          !boremm = !mmbore.string()
          !dtext.append('Type ' & !part2 & '  -  ' & !boremm & 'mm Diameter trunnion ')
        endif
      endif
    enddo

    -- Ensure Metric Bore Units
    units mm bore

    --------------------------------------------------------------------------------
    -- Form '!!mdstrunnvt01' is USED for Selection of all 'TRUNNION' Types
    -- The List of Available Trunnions for the type '!alias' is contained in the
    -- Array Variable '!rtext'  - Load the '!!mdstrunnvt01.standard' gadget

    -- Trunnion Descriptions 'dtext' are derived from their 'stype' which are the '!rtext'
    !!mdstrunnvt01.standard.dtext = !dtext
    !!mdstrunnvt01.standard.rtext = !rtext

    -- Set the Callback actions on the Common Trunnion Selection
    -- form '!!mdstrunnvt01.ok'  - OK gadget
    if (!alias.eq('TT02')) then
      !!mdstrunnvt01.action.clear()
      !!mdstrunnvt01.action[1] = |call !!mdscrdattt02($!formname,'MODIFY')|
      !!mdstrunnvt01.action[2] = ||
    else
      -- Trunnion types 'TT01' and 'TT03'
      !!mdstrunnvt01.action.clear()
      !!mdstrunnvt01.action[1] = |call !!mdscrdattt01($!formname,'MODIFY')|
      !!mdstrunnvt01.action[2] = ||
    endif

    !!mdstrunnvt01.cancel.callback = ||

    -- Edit Form Title and Show
    !!mdstrunnvt01.formtitle = 'Trunnion '& !support.replace &' Selection'
    !!kshowform (!!mdstrunnvt01)

    -- Select Current Trunnion in Selection List
    !stype = !form.support.datum.stype
    !!mdstrunnvt01.standard.select('rtext',!stype)

  endif

  --------------------------------------------------------------------------------
  --------------------------------------------------------------------------------
  --------------------------------------------------------------------------------
  -- Reset Units
  !!kRestoreUnits(!currentunits)


  -- set focus to the distance text gadget
  if (!alias.eq('TT02')) then
    !form.length.setfocus()
  else
    !form.dist.setfocus()
  endif
  --------------------------------------------------------------------------------
endfunction
