--------------------------------------------------------------------------------
--
-- File: Mdssetdattt16.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Neale Morris
-- Created:
--
--
-- Description:
-- Creation function for Trunnion Type 'TT16'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        FORM of current Trunnion Type
--     2     R        STRING       CREATE - for Creating the Datum Atta - Trunnion Type and Size
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Define Function
define function !!mdssetdatTT16(!form is FORM, !mode is STRING,!onType is STRING)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kgetsetunits()

  -->>>-<wd>oct2002
  -- Set calling form name
  !callingForm = !form
  !fromAtta    = !form.support.preliminaryStore.set()
  --<<<-<wd>oct2002

  -- Initialise variables
  !unusedSupport     = !form.support
  !unusedName        = !form.name.val
  !name     = !form.name.val
  !ceComp      = !!ce
  !unusedFormName    = '!!' & !form

  --------------------------------------------------------------------------------
  -- Create the Datum - Trunnion Atta
  if (!mode.upcase() eq 'CREATE') then

    -- Select Elbo or Tube, this will determine what type of base support is created.
    if !onType.eq('CROS') then
      !idType = 'CROS TEE'
    else
      !idType = !onType
    endif

    --if we have an idtype of TUBE and are creating from an existing prelim support
    --then do not id anything just use the existing prelim atta
    if !fromAtta and !idType.eq('TUBE') then
      !prelimName = '/' & !name & '_Pre'
      !datumRef = object DBREF(!prelimName)
      handle ANY
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      elsehandle NONE
        !!ce = !datumRef
      endhandle
    else
      prompt off
      prompt load escape 'Identify $!onType to create dummy extension support'
      ID $!onType @
      handle (61,528)
        prompt on
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return FALSE
      endhandle
      prompt on
    endif
    !element = !!ce

    -- Check that pipe is named
    pipe
    if (!!ce.ref.string().eq(!!ce.name)) then
      !!alert.error('Pipe must be named to create MDS trunnion')
      !!ce = !ceComp
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif
    !!ce = !element



    -- Check pipe material
    !pipeMat = !!ce.owner.pspe.:MDSPipeMat
    !lea = lea
    !bore   = p$!lea bore
    handle ANY
      !bore = ph bore
    endhandle

    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12> -- REDUNDANT and INCORRECT CODE -- See Code ABOVE
    --
    -- Check pipe material
    --!pipeMat = !!ce.owner.pspe.:MDSPipeMat
    --!bore   = pa bore
    --handle any
    --  !bore = ph bore
    --endhandle
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------

    -- Check if current selected bore is available
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --
    --    !boreCheck = !!mdsParTT16[$!bore].pipeMaterial
    --    handle any
    --
    -- NOTHING Created or Selected YET, so CHECK if TRUNNION STANDARD Available for the MAIN PIPE Bore
    --><wd>14may09 - DFN P-17079 - ERROR raised if PIPE BORE parameters are actual IMPERIAL bore sizes, e.g. 152.4mm = 6in and NOT 150mm
    --    !mBore  = !bore.real()
    !mBore  = !bore.string().lowcase().before('mm').real().value()
    --<<wd>14may09 - DFN P-17079

    !mdsStd = 'TT16'
    !mdsTrunObj  = object MDSREADTRUNDATA()
    !mdsTrunData = !mdsTrunObj.mdsTrunData(!mdsStd, !mBore)

    if (!mdsTrunData.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
      if (!mdsTrunObj.mdsStd.sactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
        !errormessage = !mdsTrunObj.mdsStd.smess
      elseif (!mdsTrunObj.mdsStd.cactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
        !errormessage = !mdsTrunObj.mdsStd.cmess
      endif

      !!kRestoreUnits(!currentUnits)
      --      !!alert.error('bore $!bore is not within the available bores')
      !!alert.error(!errormessage)
      !callingForm.bore.clear()
      !callingForm.mainBore.val = 'Main Bore'
      !callingForm.tlength.val = 0
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
      --    endhandle
    endif

    -- Get Allowable PIPE Specification Material types
    --    !stanMat = !!mdsParTT16[0].pipeMaterial
    --    handle any
    --      !stanMat = !!mdsParTT16[$!bore].pipeMaterial
    --    endhandle
    --
    -- At <mds12> the "ACTIVE" .pipeMaterial is STORED,
    -- i.e. The ACTUAL BORE .pipeMaterial, if it's SET, always overrides the ZERO[0] BORE .pipeMaterial
    !stanMat = !mdsTrunObj.pipeMaterial
    --
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------

    !matList = !stanMat.split(',')
    !findIt  =  !matList.findfirst(!pipeMat)

    if !findIt.string().eq('') then
      !findIt = 0
    endif

    if !stanMat.upcase().eq('UNSET') then
      !!alert.error('The MDS material code of the MDS standard is unset. aborting creation!')
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    if !pipeMat.upcase().eq('UNSET') then
      !!alert.error('The MDS material code of the pipe specification is unset. aborting creation!')
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    if !stanMat.neq('ALL') then
      if !findIt.eq(0) then
        !!alert.error('The identified pipe specification has a MDS material code of $!pipeMat and does not match the MDS standards material code/s of $!stanMat')
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      endif
    endif

    -- Finished material checking
    forwards

    var !radius const dist p0 to p1
    !od = pa od

    --------------------------------------------------------------------------------
    -- Check if element identified is suitable for this type of dummy extension support
    --------------------------------------------------------------------------------
    !!ce = !element

    ---------------------------------------------------------------------------------------------------
    --<wd>dec2006<mds12>
    -- Get the TT15 and TT16 Client CODES in MDS12
    !tt15code = !!mdsgetdefprop('ATTA', 'TT15', 'CCOD')
    !tt16code = !!mdsgetdefprop('ATTA', 'TT16', 'CCOD')
    --<wd>dec2006<mds12>
    ---------------------------------------------------------------------------------------------------

    !paTest = pa dir wrt /*
    !plTest = pl dir wrt /*
    if !paTest.string().eq('U WRT /*') or !plTest.string().eq('U WRT /*') or !paTest.string().eq('Z WRT /*') or !plTest.string().eq('Z WRT /*') then
      --<wd>dec2006<mds12>
      --!!alert.error('Identified elbow is not suitable. please use $!!coDETT15 Type B')
      !!alert.error('Identified elbow is not suitable. please use $!tt15code Type B')
      --<wd>dec2006<mds12>
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    elseif !paTest.string().eq('D WRT /*') or !plTest.string().eq('D WRT /*') or !paTest.string().eq('-Z WRT /*') or !plTest.string().eq('-Z WRT /*') then
      --<wd>dec2006<mds12>
      --!!alert.error('Identified elbow is not suitable. please use $!!coDETT16 Type A')
      !!alert.error('Identified elbow is not suitable. please use $!tt16code Type A')
      --<wd>dec2006<mds12>
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    -- Get Session Bore Units
    if(!!kgetBoreUnits()) then
      !boreUnits = 'inch bore'
    else
      !boreUnits = ''
    endif
    !bore = pl bore
    handle ANY
      !bore = ph bore
    endhandle

    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --<mds12> The available Trunnion Bore Sizes are now stored in the object member !mdsTrunObj.bores
    --
    -- The available bores will be stored in the object for TT16 !!mdsParTT16[Bore]
    -- Fill the selection gadget with these available bores and the styp to be used
    --    !availBores = !!mdsParTT16[$!bore].bores
    !availBores = !mdsTrunObj.bores
    if (!availBores.empty()) then
      --    handle any
      !!kRestoreUnits(!currentUnits)
      --      !!alert.error('bore $!bore is not within the available bores')
      !!alert.error('There are NO available Trunnion bores. aborting Trunnion creation.')
      !callingForm.bore.clear()
      !callingForm.mainBore.val = 'Main Bore'
      !callingForm.tlength.val = 0
      !!mdsDacControl(FALSE)
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
      --    endhandle
    endif
    --
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------

    !!kRestoreUnits(!currentUnits)
    !unitBore = ARRAY()
    do !setUnitBores from 1 to !availBores.size()
      !mmBore = !availBores[$!setUnitBores] & 'mm'
      !unitBore.append(!mmBore.bore(!!boreFmt).string())
    enddo
    !currentUnits = !!kgetsetunits()
    !!mdsTT16.bore.dtext = !unitBore
    !!mdsTT16.bore.rtext = !availBores
    !mmBore = !bore.string()
    !!kRestoreUnits(!currentUnits)
    !mainBore = !mmBore
    !!mdsTT16.mainBore.val = 'Main     Bore =     $!mainBore'
    !currentUnits = !!kgetsetunits()

    -- Get the default length if in create mode
    if !mode.upcase()eq('CREATE') then
      ---------------------------------------------------------------------------------------------------
      --<wd>apr2006<mds12>
      --!!mdsTT16.tlength.val = !!mdsParTT16[$!availBores[1]].default
      !callingForm.tlength.val = !mdsTrunObj.deflength
      --<wd>apr2006<mds12>
      ---------------------------------------------------------------------------------------------------
    endif

    -->>>-<wd>oct2002
    -- Scan for CORRECT ELBOW type
    if (!!mdsselectcomp(!!ce.type).not()) then
      !!alert.error('Unable to find a suitable elbow in the current specification')
      !callingForm.bore.clear()
      !callingForm.mainBore.val = 'Main Bore'
      !callingForm.tlength.val = 0
      !!kRestoreUnits(!currentUnits)
      !!mdsDacControl(FALSE)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif
    --<<<-<wd>oct2002

    -- The support is created as a branch create branch and connect to appropriate member

    -- The new branch will be connected to the p3 of the elbo, it will need to be on the correct
    -- side as p3 is in the same place as p1 but in the opposite direction. Therefore the p3 will
    -- be higher exit point.

    -- With this configuration you will need to pick which p-point is to be used the arrive or leave
    -- Add some text so the user can choose
    !paPos = pa pos
    !plPos = pl pos

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 280 Arrive $<$!paPos$>
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 281 Leave $<$!plPos$>

    !where = !!alert.confirm('Create dummy extension from, YES for arrive, NO for leave',0,0)

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 280
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 281

    !!mdsDacControl(TRUE)

    if !where.eq('NO') then
      flip ori
      handle ANY
        !!alert.error('The identified elbow requires to be flipped but access to the elbow has been denied. please flip the elbow and try again!.')
        !!mdsDacControl(FALSE)
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      endhandle
      ori pa is $!paTest and pl is $!plTest
    endif
    var !ll const dist p3 to p0
    !hOd = pa od

    --<dw>aug2008 dun955 - flow direction turned off
    new bran flowdir OFF
    :MDSTrun TRUE
    connect ph to p3 of same

    Hbor $!!mdsTT16.bore
    Tbor $!!mdsTT16.bore

    Tcon ATT
    sel hstu
    pipe
    !pipeName = name
    same
    name $!pipeName/$!!mdsTT16.name

    !tOd = ph od

    -- Work out the adjustment needed for the exact length to be added to the iso
    -- Work out horizontal offset
    -- and put in gadget
    !tOd = pt od
    !hoff = ((!hOd - !tOd) / 2)
    !hyp = !radius.real() + (!od / 2)
    !side1 = !radius.real() + (!tOd / 2) + !hoff
    !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))

    !tOd = pt od
    !hoff = 0
    !hyp = !radius.real() + (!od / 2)
    !side1 = !radius.real() + (!tOd / 2) + !hoff
    !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))
    hbor $!bore

    !desc = desc of /MDS/TEMPLATES

    if (!desc eq 'Initec Industrial Templates') then
      !!mdsTT16.poffset.val = $!hoff
      !!mdsTT16.poffset.active = TRUE
    else
      !!mdsTT16.poffset.val = 0
      !!mdsTT16.poffset.active = FALSE
    endif

    -- makeup piece
    new REDU select spref with styp 'MAKEUP' spec /MDS
    -- despar $!!mdsTT16.bore $!offset $!hoff
    despar $!!mdsTT16.bore $!offset  0mm
    -- spkbrk true
    sel lstu
    connect and p3 is d
    -- atty CCNN
    mtoc off
    name /$!!mdsTT16.name.val/MAKEUP
    !!mdsTT16.support.atta.append(!!ce)

    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    !bore = pa bore
    handle ANY
      !bore = pa bore of prev
    endhandle

    !sType = !mdsTrunObj.sTypes[!callingForm.bore.val]
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------

    !splitStype = !sType.split(',')
    --><wd>25sep2009 - DFN P-22636 (SI-9969)
    -- Locate this ATTA at the PLEAVE of the MAKEUP REDUCER on ELBO TRUNNION ONLY to POSITION the NOTE CORRECTLY on the ISOMETRIC
    -- Cut hole comment atta
    new atta select spref with styp 'COMMENT' spec /MDS
    sel lstu
    connect
    handle (7,3)
      fconnect
    endhandle
    -- if !!mdsTrunNotes.boolean() then
    stex 'DO NOT CUT HOLE IN PIPE'
    -- endif
    atty CCNN
    name /$!callingForm.name.val/NOTE1
    !callingForm.support.atta.append(!!ce)
    --<<wd>25sep2009 - DFN P-22636 (SI-9969)

    -- Weep hole comment atta
    new atta select spref with styp 'COMMENT' spec /MDS
    sel lstu
    connect
    handle (7,3)
      fconn
    endhandle
    if !!mdsTrunNotes.boolean() then
      stex '6mm WEEP HOLE'
    endif
    atty CCNN
    name /$!!mdsTT16.name.val/NOTE2
    !!mdsTT16.support.atta.append(!!ce)

    -- Create end plate
    new PLAT despar 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm
    -- spkbrk true
    select spref with styp '$!splitStype[1]' spec /MDS
    sel lstu
    conn
    handle (7,3)
      fconn
    endhandle
    name /$!!mdsTT16.name.val
    !!mdsSetDesPars(!!ce)
    !!mdsDacControl(TRUE)
    !overallLength = !!mdsTT16.tlength.val + !ll.real()
    pos pl dist $!overallLength from PH
    !!mdsTT16.support.datum = !!ce
    bran
    conn pt to last mem
    TCON CLOS
    !tbor = pt bore

    -- Sref atta
    new atta before
    stext '$!!mdsTT16.name.val'
    spkbrk TRUE
    select spref with styp 'TT16' spec /MDS
    sel lstu
    connect to next
    shop TRUE
    name /$!!mdsTT16.name.val/SREF
    :MDSSuppType 'TT16'
    !!mdsTT16.support.atta.append(!!ce)
    nex
    !!mdsTT16.support.atta.append(!!ce)

    /$!!mdsTT16.name.val
    !!mdsGetProp(!!mdsTT16.plength,!!mdsTT16.plength,'POD',!tbor,'$!splitStype[1]')
    !!mdsGetProp(!!mdsTT16.pwidth,!!mdsTT16.pwidth,'PTHK',!tbor,'$!splitStype[1]')

    bran
    sel hstu

    !!mdsResetPins(9,9)

    -- Set the correct design parameters
    /$!!mdsTT16.name.val/SREF
    !hbor =  ph bore
    -- despar $!hbor $!tbor C $!hoff $!!mdsTT16.tlength.val
    despar $!hbor $!tbor C 0mm $!!mdsTT16.tlength.val

    -- Set the material and shop flags for all comps except the notes
    -- and remove the insulation
    !!mdsDacControl(TRUE)
    bran
    ispe =0
    !members = mem count
    do !set from 1 to !members
      bran
      $!set
      !!mdssetmatref(!!ce)
      handle ANY
      endhandle
      ispe =0
    enddo

    !!mdsDacControl(TRUE)

    bran
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --    !shop = !!mdsParTT16[$!phBore].shop
    !shop = !mdsTrunObj.shop
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------
    shop $!shop

    do !set from 1 to !members
      bran
      $!set
      shop $!shop
    enddo


    -- Show the pipe material form automatically
    !!mdsTrunMat.init(!!mdsTT16)

    -->>>-<wd>-nov2002
    -- Show the Trunnion Material Form
    !!mdsTrunMat.init(!!mdsTT16)
    --<<<-<wd>-nov2002

    -- Activate/Deactivate gadgets
    !!mdsTT16.crElbo.active = FALSE
    !!mdsTT16.tlength.active = TRUE
    !!mdsTT16.setLen.active = TRUE
    !!mdsTT16.bore.active = TRUE
    !!mdsTT16.setLen.active = FALSE
    !!mdsTT16.trunMat.active = TRUE
    !!mdsTT16.zoom.active = TRUE
    !!mdsTT16.ok.active = TRUE
    !!mdsTT16.member.active = FALSE

    --------------------------------------------------------------------------------
    -- Reset Units
    !!kRestoreUnits(!currentUnits)

  endif

endfunction
