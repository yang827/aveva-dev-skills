--------------------------------------------------------------------------------
--
-- File: Mdssetdattt17.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Neale Morris
-- Created:
--
--
-- Description:
-- Creation function for Trunnion Type 'TT17'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        FORM of current Trunnion Type
--     2     R        STRING       CREATE - for Creating the Datum Atta - Trunnion Type and Size
--                              or MODIFY - for Reselecting the Datum Atta - Trunnion Type and Size
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Define Function
define function !!mdssetdatTT17(!form is FORM, !mode is STRING,!onType is STRING)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kgetsetunits()

  -- Set calling form name
  !callingForm = !form
  !fromAtta    = !form.support.preliminaryStore.set()

  -- Initialise variables
  !unusedSupport     = !form.support
  !unusedName        = !form.name.val
  !name     = !form.name.val
  !ceComp      = !!ce
  !unusedFormName    = '!!' & !form

  --------------------------------------------------------------------------------
  -- Create the Datum - Trunnion Atta
  if (!mode.upcase() eq 'CREATE') then

    -- Select Elbo or Tube, this will determine what type of base support is created.
    if !onType.eq('CROS') then
      !idType = 'CROS TEE'
    else
      !idType = !onType
    endif

    --if we have an idtype of TUBE and are creating from an existing prelim support
    --then do not id anything just use the existing prelim atta
    if !fromAtta and !idType.eq('TUBE') then
      !prelimName = '/' & !name & '_Pre'
      !datumRef = object DBREF(!prelimName)
      handle ANY
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      elsehandle NONE
        !!ce = !datumRef
      endhandle
    else
      prompt off
      prompt load escape 'Identify $!onType to create dummy extension support'
      ID $!onType @
      handle (61,528)
        prompt on
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return FALSE
      endhandle
      prompt on
    endif
    !element = !!ce

    -- Check that pipe is named
    pipe
    if (!!ce.ref.string().eq(!!ce.name)) then
      !!alert.error('Pipe must be named to create MDS trunnion')
      !!ce = !ceComp
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif
    !!ce = !element

    -- Get ispe to SET at the SET-ON TEE ONLY
    if (!!ce.type.eq('BRAN')) then
      !ispe = !!ce.ispe
      handle ANY
        -- ispe is unset
      endhandle
    else
      !ispe = !!ce.ispe
      handle ANY
        -- ispe is unset
      endhandle
    endif



    -- Check pipe material
    !pipeMat = !!ce.owner.pspe.:MDSPipeMat
    !bore   = pl bore
    handle any
      !bore = ph bore
    endhandle

    -- Check if current selected bore is available
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --
    --    !boreCheck = !!mdsParTT17[$!bore].pipeMaterial
    --    handle any
    --
    -- NOTHING Created or Selected YET, so CHECK if TRUNNION STANDARD Available for the MAIN PIPE Bore
    --><wd>14may09 - DFN P-17079 - ERROR raised if PIPE BORE parameters are actual IMPERIAL bore sizes, e.g. 152.4mm = 6in and NOT 150mm
    --    !mBore  = !bore.real()
    !mBore  = !bore.string().lowcase().before('mm').real().value()
    --<<wd>14may09 - DFN P-17079

    !mdsStd = 'TT17'
    !mdsTrunObj  = object MDSREADTRUNDATA()
    !mdsTrunData = !mdsTrunObj.mdsTrunData(!mdsStd, !mBore)

    if (!mdsTrunData.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
      if (!mdsTrunObj.mdsStd.sactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
        !errormessage = !mdsTrunObj.mdsStd.smess
      elseif (!mdsTrunObj.mdsStd.cactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
        !errormessage = !mdsTrunObj.mdsStd.cmess
      endif

      !!kRestoreUnits(!currentUnits)
      --      !!alert.error('Bore $!bore is not within the available bores')
      !!alert.error(!errormessage)
      !callingForm.bore.clear()
      !callingForm.mainBore.val = 'Main Bore'
      !callingForm.tlength.val = 0
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
      --    endhandle
    endif

    -- Get Allowable PIPE Specification Material types
    --    !stanMat = !!mdsParTT17[0].pipeMaterial
    --    handle any
    --      !stanMat = !!mdsParTT17[$!bore].pipeMaterial
    --    endhandle
    --
    -- At <mds12> the "ACTIVE" .pipeMaterial is STORED,
    -- i.e. The ACTUAL BORE .pipeMaterial, if it's SET, always overrides the ZERO[0] BORE .pipeMaterial
    !stanMat = !mdsTrunObj.pipeMaterial
    --
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------

    !matList = !stanMat.split(',')
    !findIt  =  !matList.findfirst(!pipeMat)

    if !findIt.string().eq('') then
      !findIt = 0
    endif

    if !stanMat.upcase().eq('UNSET') then
      !!alert.error('The MDS material code of the MDS standard is unset. Aborting creation!')
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    if !pipeMat.upcase().eq('UNSET') then
      !!alert.error('The MDS material code of the pipe specification is unset. Aborting creation!')
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    if !stanMat.neq('ALL') then
      if !findIt.eq(0) then
        !!alert.error('The identified pipe specification has a MDS material code of $!pipeMat and does not match the MDS standards material code/s of $!stanMat')
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      endif
    endif

    -- Finished material checking
    forwards

    --------------------------------------------------------------------------------
    -- Check if element identified is suitable for this type of dummy extension support
    --------------------------------------------------------------------------------
    !!ce = !element

    if (!!ce.type eq 'BRAN') then
      !od = ph od
    else
      !od = pa od
    endif

    --    !paTest = pa dir wrt /*
    --    !plTest = pl dir wrt /*
    --    if !paTest.string().eq('U WRT /*') then
    --    elseif !plTest.string().eq('U WRT /*') then
    --    elseif !paTest.string().eq('D WRT /*') then
    --    elseif !plTest.string().eq('D WRT /*') then
    --    else
    --      !!alert.error('Identified tube is not vertical')
    --      return

  endif  $* end of create if statement ??


  -- Get Session Bore Units
  if(!!kgetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif
  !bore = pl bore
  handle any
    var !hbor hbor
    !bore = !hbor.bore()
  endhandle

  ---------------------------------------------------------------------------------------------------
  --<wd>apr2006<mds12>
  --<mds12> The available Trunnion Bore Sizes are now stored in the object member !mdsTrunObj.bores
  --
  -- The available bores will be stored in the object for TT17 !!mdsParTT17[Bore]
  -- Fill the selection gadget with these available bores and the styp to be used
  --    !availBores = !!mdsParTT17[$!bore].bores
  !availBores = !mdsTrunObj.bores
  if (!availBores.empty()) then
    --    handle any
    !!kRestoreUnits(!currentUnits)
    --      !!alert.error('Bore $!bore is not within the available bores')
    !!alert.error('There are NO available Trunnion bores. Aborting Trunnion creation.')
    !callingForm.bore.clear()
    !callingForm.mainBore.val = 'Main Bore'
    !callingForm.tlength.val = 0
    !!mdsDacControl(false)
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      !!mdsCancelSupp(!form)
    endif
    return
    --    endhandle
  endif
  --
  --<wd>apr2006<mds12>
  ---------------------------------------------------------------------------------------------------

  !!kRestoreUnits(!currentUnits)
  !unitBore = ARRAY()
  do !setUnitBores from 1 to !availBores.size()
    !mmbore = !availBores[$!setUnitBores] & 'mm'
    !unitBore.append(!mmbore.bore(!!boreFmt).string())
  enddo
  !currentUnits = !!kgetsetunits()
  !!mdsTT17.bore.dtext = !unitBore
  !!mdsTT17.bore.rtext = !availBores
  !mmbore = !bore.string()
  !!kRestoreUnits(!currentUnits)
  !mainBore = !mmbore
  !!mdsTT17.mainBore.val = 'Main     Bore =     $!mainBore'
  !currentUnits = !!kgetsetunits()

  -- Get the default length if in create mode
  if !mode.upcase()eq('CREATE') then
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --!!mdsTT17.tlength.val = !!mdsParTT17[$!availBores[1]].default
    !callingForm.tlength.val = !mdsTrunObj.deflength
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------
  endif

  !!mdsDacControl(true)

  !teeOd = pl bore
  handle any
    var !hbor hbor
    !teeOd = !hbor.bore()
  endhandle

  new tee
  if !!mdsSelectComp(!!ce.type).not() then
    !!alert.error('Unable to find a suitable tee in the current specification')
    !callingForm.bore.clear()
    !callingForm.mainBore.val = 'Main Bore'
    !callingForm.tlength.val = 0
    !!mdsDacControl(true)
    delete tee
    !!mdsDacControl(false)
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      !!mdsCancelSupp(!form)
    endif
    return
  endif

  !!mdsDacControl(true)

  -- spref $!foundTee
  sel lstu
  ori
  !paOd = pa od
  !dist = !paOd / 2 + 100mm
  dist $!dist from pl of prev
  handle any
    dist $!dist from ph
  endhandle
  !dist.delete()
  var !dist const dist p0 to p0 of prev
  handle ANY
    var !dist const dist p0 to ph
  endhandle

  -- Set the ISPE at the SET-ON TEE ONLY
  !!ce.ispe = !ispe
  handle ANY
    ispe =0
  endhandle

  !form.dist.val = $!dist

  --<dw>aug2008 dun979 - flow direction turned off
  new bran flowdir OFF
  :MDSTrun true
  conn ph to same
  !hdir = ph dir
  !form.direction.val = !hdir.string().before(' WRT')

  Tbor $!!mdsTT17.bore
  Tcon ATT
  sel hstu
  pipe
  !pipeName = name
  same
  name $!pipeName/$!!mdsTT17.name

  -- Cut hole comment atta
  new atta select spref with styp 'COMMENT' spec /MDS
  sel lstu
  connect
  -- if !!mdsTrunNotes.boolean() then
  stex 'DO NOT CUT HOLE IN PIPE'
  -- endif
  atty CCNN
  name /$!!mdsTT17.name.val/NOTE1

  -- makeup piece
  new REDU select spref with styp 'MAKEUPOFF' spec /MDS
  despar $!!mdsTT17.bore 0mm 0mm
  -- spkbrk true
  sel lstu

  !tOd = pl od
  !od = pa od

  -- Work out the adjustment needed for the exact length to be added to the iso
  -- and put in gadget
  !hyp = (!od / 2)
  !side1 = (!tOd / 2)
  !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))

  despar $!!mdsTT17.bore $!offset  0mm
  -- connect and p3 is d
  connect
  -- atty CCNN
  mtoc OFF
  name /$!!mdsTT17.name.val/MAKEUP

  -- Sref atta
  new atta
  stext '$!!mdsTT17.name.val'
  spkbrk true
  select spref with styp 'TT17' spec /MDS
  sel lstu
  connect
  shop true
  name /$!!mdsTT17.name.val/SREF
  :MDSSuppType 'TT17'

  !bore = pa bore
  handle any
    !bore = pa bore of prev
  endhandle

  ---------------------------------------------------------------------------------------------------
  --<wd>apr2006<mds12>
  --!sType = !!mdsParTT17[$!bore].sTypes[!!mdsTT17.bore.val]
  !sType = !mdsTrunObj.sTypes[!callingForm.bore.val]
  --<wd>apr2006<mds12>
  ---------------------------------------------------------------------------------------------------
  !splitStype = !sType.split(',')

  -- Weep hole comment atta
  new atta select spref with styp 'COMMENT' spec /MDS
  sel lstu
  connect
  if !!mdsTrunNotes.boolean() then
    stex '6mm WEEP HOLE'
  endif
  atty CCNN
  name /$!!mdsTT17.name.val/NOTE2

  -- Create end plate
  new PLAT despar 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm
  -- spkbrk true
  select spref with styp '$!splitStype[1]' spec /MDS
  sel lstu
  conn
  name /$!!mdsTT17.name.val
  !!mdsSetDesPars(!!ce)
  !!mdsDacControl(true)
  !overallLength = !!mdsTT17.tlength.val
  pos pl dist $!overallLength from PH
  !!mdsTT17.support.datum = !!ce
  bran
  conn pt to last mem
  TCON CLOS
  !tbor = pt bore

  /$!!mdsTT17.name.val
  !!mdsGetProp(!!mdsTT17.plength,!!mdsTT17.plength,'POD',!tbor,'$!splitStype[1]')
  !!mdsGetProp(!!mdsTT17.pwidth,!!mdsTT17.pwidth,'PTHK',!tbor,'$!splitStype[1]')

  bran
  sel hstu

  !!mdsResetPins(9,9)

  -- Set the correct design parameters
  /$!!mdsTT17.name.val/SREF
  var !hBorX hbor of bran
  despar $!hBorX $!tbor $!!mdsTT17.tlength.val

  -- Set the material and shop flags for all comps except the notes
  -- And remove insulation automatically
  !!mdsDacControl(true)
  bran
  ispe =0
  !members = mem count
  do !set from 1 to !members
    bran
    $!set
    !!mdssetmatref(!!ce)
    handle any
    endhandle
    ispe =0
  enddo

  bran

  -- Add ATTAS to support object
  !branMem = mem count
  do !add from 1 to !branMem
    bran
    $!add
    !!mdsTT17.support.atta.append(!!ce)
  enddo

  -- The end cap is part of the IPMSCODE so turn off the material output
  --<wd>may2003
  --mtoc off
  mtoc off
  --<wd>may2003

  bran
  ---------------------------------------------------------------------------------------------------
  --<wd>apr2006<mds12>
  --    !shop = !!mdsParTT17[$!phBore].shop
  !shop = !mdsTrunObj.shop
  --<wd>apr2006<mds12>
  ---------------------------------------------------------------------------------------------------
  shop $!shop

  do !set from 1 to !members
    bran
    $!set
    shop $!shop
  enddo

  bran

  -- Show the pipe material form automatically
  !!mdsTrunMat.init(!!mdsTT17)

  -- Activate/Deactivate gadgets
  !!mdsTT17.crTube.active = false
  !!mdsTT17.tlength.active = true
  !!mdsTT17.setLen.active = true
  !!mdsTT17.bore.active = true
  !!mdsTT17.setLen.active = false
  !!mdsTT17.trunMat.active = true
  !!mdsTT17.zoom.active = true
  !!mdsTT17.ok.active = true
  !!mdsTT17.member.active = false
  !!mdsTT17.bdist.active = true
  !!mdsTT17.bthro.active = true
  !!mdsTT17.bdirection.active = true
  !!mdsTT17.direction.active = true
  !!mdsTT17.dist.active = true
  !!mdsTT17.select.active = true
  !!mdsTT17.setLen.active = true

  -->>>-<wd>-nov2002
  -- Show the Trunnion Material Form
  !!mdsTrunMat.init(!!mdsTT17)
  --<<<-<wd>-nov2002

  !!mdsDacControl(false)

  --------------------------------------------------------------------------------
  -- Reset Units
  !!kRestoreUnits(!currentUnits)

endfunction
-- End function
