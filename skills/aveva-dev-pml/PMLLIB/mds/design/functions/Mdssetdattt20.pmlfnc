--
-- File: Mdssetdattt20.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Neale Morris
-- Created:
--
--
-- Description:
-- Creation function for Trunnion Type 'TT20'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        FORM of current Trunnion Type
--     2     R        STRING       CREATE - for Creating the Datum Atta - Trunnion Type and Size
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Define Function
define function !!mdssetdattt20(!form is FORM, !mode is STRING,!dummyOnType is STRING)

  -- Find current units and set the distance unit to metric
  !currentunits = !!kgetsetunits()

  -- Set calling form name
  !callingForm = !form
  !fromAtta    = !form.support.preliminaryStore.set()

  -- Initialise variables
  --  !support     = !form.support
  --  !tubeType    = !!mdsOptions.pipes
  --  !datum       = !form.support.datum
  --  !name        = !form.name.val
  --  !alias       = !form.support.alias
  !ceComp      = !!ce
  --  !formName    = '!!' & !form

  --------------------------------------------------------------------------------
  -- Create the Datum - Trunnion Atta
  if (!mode.upcase() eq 'CREATE') then
    -- Select Elbo to support
    prompt off
    prompt load escape 'Identify elbow to support'
    ID elbo bend @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return false
    endhandle
    prompt on

    !elbow = !!ce
    !bore = !!ce.lbor

    -- Check that pipe is named
    pipe
    if (!!ce.ref.string().eq(!!ce.name)) then
      !!alert.error('Pipe must be named to create MDS trunnion')
      !!ce = !ceComp
      !!kRestoreUnits(!currentunits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif
    !!ce = !elbow

    --<wd>>june2003
    -- Check Bore of the Identified Elbow as this is the Valve Discharge Pipe Size
    --    !eBore   = pa bore
    -- Check if current selected ELBO bore is available
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --
    --    !boreCheck = !!mdsParTT20[$!eBore].pipeMaterial
    --    handle any
    --
    -- NOTHING Created or Selected YET, so CHECK if TRUNNION STANDARD Available for the MAIN PIPE Bore
    --><wd>14may09 - DFN P-17079 - ERROR raised if PIPE BORE parameters are actual IMPERIAL bore sizes, e.g. 152.4mm = 6in and NOT 150mm
    --    !mBore  = !bore.real()
    !mBore  = !bore.real().value()
    --<<wd>14may09 - DFN P-17079

    !mdsStd = 'TT20'
    !mdsTrunObj  = object MDSREADTRUNDATA()
    !mdsTrunData = !mdsTrunObj.mdsTrunData(!mdsStd, !mBore)

    if (!mdsTrunData.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
      if (!mdsTrunObj.mdsStd.sactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
        !errormessage = !mdsTrunObj.mdsStd.smess
      elseif (!mdsTrunObj.mdsStd.cactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
        !errormessage = !mdsTrunObj.mdsStd.cmess
      endif

      !!kRestoreUnits(!currentunits)
      --      !!alert.error('Bore $!eBore is not within the available bores')
      !!alert.error(!errormessage)
      !callingForm.bore.clear()
      !callingForm.mainBore.val = 'Main Bore'
      !callingForm.tlength.val = 0
      !!kRestoreUnits(!currentunits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
      --    endhandle
    endif
    --<<wd>june2003
    --
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------



    -- Check to see if the elbo has a vertical section
    !paTest = pa dir wrt /*
    !plTest = pl dir wrt /*
    --<wd>15jan2008 -- Defect No. P-4534
    -- Modified to suit both COORD ENU and COORD XYZ, so check the UP member of the !paTest and !plTest DIRECTION objects
    -- The check here is to test if the either the PLEAVE or the PARRIVE direction of the identified ELBO is in
    -- the UP or Z direction to enable a trunnion to be created.
    --  if !paTest.string().before(' WRT').eq('U').not() and !plTest.string().before(' WRT').eq('U').not() then
    if (!paTest.up.neq(1) and !plTest.up.neq(1) ) then
      --<wd>15jan2008 -- Defect No. P-4534
      !!alert.error('The identified elbow is not suitable for this support.')
      !!kRestoreUnits(!currentunits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    -- Select tube to support
    prompt off
    prompt load escape 'Identify tube to support'
    ID tube @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return false
    endhandle
    prompt on

    !tube = !!ce


    -- Check to see if the tube is within the horizontal limits
    if (!!mdsGradient(!tube)) then
      !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
      !!kRestoreUnits(!currentunits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    -- Check to see if the tube is below the identified elbo
    pin 9 at $!elbow
    pin 9 direction d wrt /*
    pin 9 plane pin 9 thro ce
    pin 8 copy pl
    handle any
      pin 8 copy ph
    endhandle
    pin 8 plane pin 8 thro pin 9
    var !pin8pin9dist const dist pin 9 to pin 8
    !!mdsResetPins(8,9)

    var !pin8pin9dist const dist pin 9 to pin 8
    --wd<nov2002
    --    if !pin8pin9dist.real().neq(0) then
    if !pin8pin9dist.real().gt(0.5) then
      --wd<nov2002
      !!alert.message ('The identified elbow and tube are not in the same vertical plane to use this standard')
      !!kRestoreUnits(!currentunits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    -- Check pipe material
    !pipeMat = !!ce.owner.pspe.:MDSPipeMat
    --<wd>>june2003
    -- The Main Header Pipe Size does NOT need to CHECKED as it is the ELBOW bore
    -- <i.e. the Discharge Pipe Bore Size which is important>
    --<<wd>june2003

    -- At <mds12> the "ACTIVE" .pipeMaterial is STORED,
    -- i.e. The ACTUAL ELBO BORE .pipeMaterial, if it's SET, always overrides the ZERO[0] BORE .pipeMaterial
    !stanMat = !mdsTrunObj.pipeMaterial
    --
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------

    -- Check to see if the horizontal distance is greater than the maximum stored in design parameter 1
    -- of TT20
    !elbowUp = !elbow.up
    !tubeUp = !tube.up
    --<wd>>june2003
    handle any
      -- May have identified the Branch Pipe Head
      !tubeUp = !tube.hpos.wrt(/* ).up
    endhandle
    --<<wd>june2003

    !elevDiff = !elbowUp - !tubeUp

    --<wd>>june2003
    -- Check against the Elbow Bore Size for the Discharge Pipe
    --!min = !!mdsParTT20[$!bore].minimum
    --!max = !!mdsParTT20[$!bore].maximum
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --!min = !!mdsParTT20[$!eBore].minimum
    --!max = !!mdsParTT20[$!eBore].maximum
    !min = !mdsTrunObj.minlength
    !max = !mdsTrunObj.maxlength
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------
    --<<wd>june2003

    if !elevDiff.abs().nint().lt(!min) then
      !uMin = !min.string(!!distanceFmt)
      !uTrunLen = !elevDiff.string(!!distanceFmt)
      !!alert.error(|Elevation difference of $!uTrunLen is less than the minimum of $!uMin$n. Aborting creation!|)
      !callingForm.bore.clear()
      !callingForm.mainBore.val = 'Main Bore'
      !callingForm.tlength.val = 0
      !!kRestoreUnits(!currentunits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    elseif !elevDiff.abs().nint().gt(!max) then
      !uMax = !max.string(!!distanceFmt)
      !uTrunLen = !elevDiff.string(!!distanceFmt)
      !!alert.error(|Elevation difference of $!uTrunLen is more than the maximum of $!uMax$n. Aborting creation!|)
      !callingForm.bore.clear()
      !callingForm.mainBore.val = 'Main Bore'
      !callingForm.tlength.val = 0
      !!kRestoreUnits(!currentunits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    !matList = !stanMat.split(',')
    !findIt  =  !matList.findfirst(!pipeMat)

    if !findIt.string().eq('') then
      !findIt = 0
    endif

    if !stanMat.upcase().eq('UNSET') then
      !!alert.error('The MDS material code of the MDS standard is unset. Aborting creation!')
      !!kRestoreUnits(!currentunits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    if !pipeMat.upcase().eq('UNSET') then
      !!alert.error('The MDS material code of the pipe specification is unset. Aborting creation!')
      !!kRestoreUnits(!currentunits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    if !stanMat.neq('ALL') then
      if !findIt.eq(0) then
        !!alert.error('The identified pipe specification has a MDS material code of $!pipeMat and does not match the MDS standards material code/s of $!stanMat')
        !!kRestoreUnits(!currentunits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      endif
    endif

    -- Finished material checking
    forwards

    -- Get Session Bore Units
    if(!!kGetBoreUnits()) then
      !boreUnits = 'inch bore'
    else
      !boreUnits = ''
    endif

    !!ce = !elbow
    !bore = pl bore
    handle any
      !bore = ph bore
    endhandle

    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --<mds12> The available ELBO Trunnion Bore Sizes are now stored in the object member !mdsTrunObj.bores
    --
    -- The available ELBO bores will be stored in the object for TT20 !!mdsParTT20[Bore]
    -- Fill the selection gadget with these available bores and the styp to be used
    --    !availBores = !!mdsParTT20[$!bore].bores
    !availBores = !mdsTrunObj.bores
    if (!availBores.empty()) then
      --    handle any
      !!kRestoreUnits(!currentunits)
      --      !!alert.error('Bore $!bore is not within the available bores')
      !!alert.error('There are NO available Trunnion bores. Aborting Trunnion creation.')
      !callingForm.bore.clear()
      !callingForm.mainBore.val = 'Main Bore'
      !callingForm.tlength.val = 0
      !!mdsDacControl(false)
      !!kRestoreUnits(!currentunits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
      --    endhandle
    endif
    --
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------

    !!kRestoreUnits(!currentunits)
    !unitBore = ARRAY()
    do !setUnitBores from 1 to !availBores.size()
      !mmbore = !availBores[$!setUnitBores] & 'mm'
      !unitBore.append(!mmbore.bore(!!boreFmt).string())
    enddo
    !currentunits = !!kgetsetunits()
    !callingForm.bore.dtext = !unitBore
    !callingForm.bore.rtext = !availBores
    !mmbore = !bore.string()
    !!kRestoreUnits(!currentunits)
    !mainBore = !mmbore
    !callingForm.mainBore.val = 'Main     Bore =     $!mainBore'
    !currentunits = !!kgetsetunits()

    -- Get the default length if in create mode
    if !mode.upcase()eq('CREATE') then
      ---------------------------------------------------------------------------------------------------
      --<wd>apr2006<mds12>
      --      !callingForm.tlength.val = !!mdsParTT20[$!bore].default
      !callingForm.tlength.val = !mdsTrunObj.deflength
      --<wd>apr2006<mds12>
      ---------------------------------------------------------------------------------------------------
    endif

    -- The new branch will be connected to the p3 of the elbo, it will need to be on the correct
    -- side as p3 is in the same place as p1 but in the opposite direction. Therefore the p3 will
    -- be higher exit point.
    !!ce = !elbow



    if !!mdsSelectComp(!!ce.type).not() then
      !!alert.error('Unable to find a suitable elbow in the current specification')
      !callingForm.bore.clear()
      !callingForm.mainBore.val = 'Main Bore'
      !callingForm.tlength.val = 0
      !!kRestoreUnits(!currentunits)
      !!mdsDacControl(false)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    if !elbow.ppos[3].up.lt(!elbow.ppos[1].up) or !elbow.ppos[3].up.lt(!elbow.ppos[2].up) then
      !!mdsDacControl(true)
      flip ori
      handle any
        !!alert.error('The identified elbow requires to be flipped but access to the elbow has been denied. Please flip the elbow and try again!.')
        !!kRestoreUnits(!currentunits)
        !!mdsDacControl(false)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      endhandle
      ori pa is $!paTest and pl is $!plTest
    endif

    !!mdsDacControl(true)

    -- Create branch
    --<dw>aug2008 dun979 - flow direction turned off
    new bran flowdir OFF
    !bran = !!ce
    :MDSTrun true
    connect ph to p3 of $!elbow
    handle (42,64)
    endhandle

    !!ce = !tube
    !teeOd = pl bore
    handle (2,252)
      !teeOd = ph bore
    endhandle

    -- The support is created as a branch create branch and connect to appropriate member
    !!mdsDacControl(true)

    !teeOd = pl bore
    handle (2,252)
      !teeOd = ph bore
    endhandle

    new tee
    !tee = !!ce

    if !!mdsSelectComp(!!ce.type).not() then
      !!alert.error('Unable to find a suitable tee in the current specification')
      !!mdsDacControl(true)
      delete tee
      !!ce = !bran
      delete bran
      !!mdsDacControl(false)
      !!kRestoreUnits(!currentunits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    !!mdsDacControl(true)

    -- spref $!foundTee
    sel lstu
    lea 3
    dir u wrt /*
    lea 2
    --    !paOd = pa od
    plane pl thro $!elbow
    pin 7 at ph of bran of $!bran
    pin 7 dir d
    pin 7 thro ce
    plane pl thro pin 7
    !!mdsResetPins(7,7)

    !!ce = !bran
    conn pt to same
    !ptBore = pt bore

    -- Name branch
    pipe
    !pipeName = name
    same
    name $!pipeName/$!callingForm.name

    --><wd>25sep2009 - DFN P-22636 (SI-9969)
    -- Locate this ATTA at the PLEAVE of the ELBO MAKEUP REDUCER on ELBO TRUNNION ONLY to POSITION the NOTE CORRECTLY on the ISOMETRIC
    -- Cut hole comment atta
    --    new atta select spref with styp 'COMMENT' spec /MDS
    --    sel lstu
    --    connect
    --    -- if !!mdsTrunNotes.boolean() then
    --    stex 'DO NOT CUT HOLE IN PIPE'
    --    -- endif
    --    atty CCNN
    --    name /$!callingForm.name.val/NOTE1
    --    !callingForm.support.atta[2] = !!ce
    --<<wd>25sep2009 - DFN P-22636 (SI-9969)

    -- Create make up piece at head - connection to elbow
    new REDU select spref with styp 'MAKEUP' spec /MDS
    despar $!callingForm.bore 0mm 0mm
    -- spkbrk true
    sel lstu
    connect
    -- atty CCNN
    mtoc off
    name /$!callingForm.name.val/MAKEUP1
    !callingForm.support.atta[3] = !!ce

    !od = ph od
    !tOd = pl od

    !hyp = (!od )
    !side1 = (!tOd)
    !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))
    despar n2 $!offset

    --><wd>25sep2009 - DFN P-22636 (SI-9969)
    -- Locate this ATTA at the PLEAVE of the MAKEUP REDUCER on ELBO TRUNNION ONLY to POSITION the NOTE CORRECTLY on the ISOMETRIC
    -- Cut hole comment atta for UPPER PIPE ELBO Connection
    new atta select spref with styp 'COMMENT' spec /MDS
    sel lstu
    connect
    handle (7,3)
      fconnect
    endhandle
    -- if !!mdsTrunNotes.boolean() then
    stex 'DO NOT CUT HOLE IN PIPE'
    -- endif
    atty CCNN
    name /$!callingForm.name.val/NOTE1
    !callingForm.support.atta.append(!!ce)
    --<<wd>25sep2009 - DFN P-22636 (SI-9969)

    -- Cut hole comment atta for LOWER PIPE TUBE Connection
    new atta select spref with styp 'COMMENT' spec /MDS
    sel lstu
    fconnect to pt
    -- if !!mdsTrunNotes.boolean() then
    stex 'DO NOT CUT HOLE IN PIPE'
    -- endif
    atty CCNN
    name /$!callingForm.name.val/NOTE2
    !callingForm.support.atta[5] = !!ce

    -- Create make up piece at tail - connection to tee
    new REDU select spref with styp 'MAKEUPOFF' spec /MDS
    despar $!ptBore 0mm 0mm
    -- spkbrk true
    sel lstu
    connect to pt
    -- atty CCNN
    mtoc off
    name /$!callingForm.name.val/MAKEUP2
    !callingForm.support.atta[6] = !!ce

    !od = pa od
    !tOd = pt od

    !hyp = (!od / 2)
    !side1 = (!tOd / 2)
    !offset = (sqrt ((!side1 * !side1) - (!hyp * !hyp)))
    despar n2 $!offset

    -- Create plates
    redu 1
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12> !bore = ELBO BORE --> see above
    --!sType = !!mdsParTT20[$!bore].sTypes[!callingForm.bore.val]
    !sType = !mdsTrunObj.sTypes[!callingForm.bore.val]
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------

    new PLAT select spref with styp '$!sType' spec /MDS
    despar 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm
    -- spkbrk true
    sel lstu
    !!mdsSetDesPars(!!ce)
    !!mdsDacControl(true)
    pin 9 copy pt
    pin 9 dist ($!tOd / 2)
    !dp = despar
    pin 9 dist $!dp[7]
    flip ori
    pos at pt
    plane pl thro pin 9
    -- atty CCNN
    name /$!callingForm.name.val
    !callingForm.support.atta[4] = !!ce
    !callingForm.support.datum = !!ce
    !!mdsResetPins(9,9)
    !pBore = pl bore
    !!mdsGetProp(!callingForm.plength,!callingForm.plength,'PLEN',!pBore,'$!sType')
    !!mdsGetProp(!callingForm.pwidth,!callingForm.pwidth,'PWID',!pBore,'$!sType')
    !!mdsGetProp(!callingForm.pThk,!callingForm.pThk,'PTHK',!pBore,'$!sType')

    -- Sref atta
    bran
    pipe
    same
    !!mdsDacControl(true)

    new atta
    stex '$!callingForm.name'
    spkbrk true
    select spref with styp 'TT20' spec /MDS
    sel lstu
    connect
    shop true
    name /$!callingForm.name.val/SREF
    :MDSSuppType 'TT20'
    !callingForm.support.atta[1] = !!ce
    !dp1 = pa bore
    --    !dp2 = !form.support.replace.subString(1,1)
    --    !dp3 = !form.support.replace.subString(2,4)
    var !dp4 const dist p0 of $!tee to p0 of $!elbow
    despar $!dp1 0mm 0mm $!dp4

    !callingForm.tlength.val = $!dp4

    bran
    last mem
    conn to pt
    prev
    conn to next

    -- Set the material and shop flags for all comps except the notes
    -- and remove the insulation automatically
    !!mdsDacControl(true)
    bran
    ispe =0
    !members = mem count
    do !set from 1 to !members
      bran
      $!set
      !!mdssetmatref(!!ce)
      handle any
      endhandle
      ispe =0
    enddo

    bran
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --    !shop = !!mdsParTT20[$!phbore].shop
    !shop = !mdsTrunObj.shop
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------
    shop $!shop

    do !set from 1 to !members
      bran
      $!set
      shop $!shop
    enddo

    -- Activate/Deactivate gadgets
    !callingForm.tlength.active = true
    !callingForm.setLen.active = true
    !callingForm.bore.active = true
    !callingForm.setLen.active = false
    !callingForm.trunMat.active = TRUE
    !callingForm.rotAtt.active = TRUE
    !callingForm.bdist.active = false
    !callingForm.dist.active = false
    !callingForm.bthro.active = false
    !callingForm.select.active = false
    !callingForm.crElbo.active = false
    !callingForm.zoom.active = true
    !callingForm.tlength.active = false
    !callingForm.ok.active = true

    -->>>-<wd>-nov2002
    -- Show the Trunnion Material Form
    !!mdsTrunMat.init(!!mdstt20)
    --<<<-<wd>-nov2002

    !!mdsDacControl(false)

    --------------------------------------------------------------------------------
    -- Reset Units
    !!kRestoreUnits(!currentunits)

  endif

endfunction
