--
-- File: Mdssetdattt32.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Neale Morris
-- Created:
--
--
-- Description:
-- Creation function for Trunnion Type 'TT32'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        FORM of current Trunnion Type
--     2     R        STRING       CREATE - for Creating the Datum Atta - Trunnion Type and Size
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Define Function
define function !!mdssetdatTT32(!form is FORM, !mode is STRING,!onType is STRING)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kgetsetunits()

  -- Set calling form name
  !callingForm = !form
  !fromAtta    = !form.support.preliminaryStore.set()

  -- Initialise variables
  !unusedSupport     = !form.support
  !name = !form.name.val
  !unusedAlias       = !form.support.alias
  !ceComp      = !!ce
  !unusedFormName    = '!!' & !form

  --------------------------------------------------------------------------------
  -- Create the Datum - Trunnion Atta
  if (!mode.upcase() eq 'CREATE') then
    -- Select tube to create dummy extension support
    if !onType.eq('CROS') then
      !idType = 'CROS TEE'
    else
      !idType = !onType
    endif

    --if we have an idtype of TUBE and are creating from an existing prelim support
    --then do not id anything just use the existing prelim atta
    if !fromAtta and !idType.eq('TUBE') then
      !prelimName = '/' & !name & '_Pre'
      !datumRef = object DBREF(!prelimName)
      handle ANY
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      elsehandle NONE
        !!ce = !datumRef
      endhandle
    else
      prompt off
      prompt load escape 'Identify $!onType to create dummy extension support'
      ID $!onType @
      handle (61,528)
        prompt on
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return FALSE
      endhandle
      prompt on
    endif
    !element = !!ce

    -- Check that pipe is named
    pipe
    if (!!ce.ref.string().eq(!!ce.name)) then
      !!alert.error('Pipe must be named to create MDS trunnion')
      !!ce = !ceComp
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif
    !!ce = !element

    -- Check pipe material
    !pipeMat = !!ce.owner.pspe.:MDSPipeMat
    !bore   = pl bore
    handle ANY
      !bore = ph bore
    endhandle

    -- Check if current selected bore is available
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --
    --    !boreCheck = !!mdsParTT32[$!bore].pipeMaterial
    --    handle any
    --
    -- NOTHING Created or Selected YET, so CHECK if TRUNNION STANDARD Available for the MAIN PIPE Bore
    --><wd>15may09 - DFN P-17079 - ERROR raised if PIPE BORE parameters are actual IMPERIAL bore sizes, e.g. 152.4mm = 6in and NOT 150mm
    --    !mBore  = !bore.real()
    !mBore  = !bore.string().lowcase().before('mm').real().value()
    --<<wd>15may09 - DFN P-17079

    !mdsStd = 'TT32'
    !mdsTrunObj  = object MDSREADTRUNDATA()
    !mdsTrunData = !mdsTrunObj.mdsTrunData(!mdsStd, !mBore)

    if (!mdsTrunData.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
      if (!mdsTrunObj.mdsStd.sactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
        !errormessage = !mdsTrunObj.mdsStd.smess
      elseif (!mdsTrunObj.mdsStd.cactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
        !errormessage = !mdsTrunObj.mdsStd.cmess
      endif

      !!kRestoreUnits(!currentUnits)
      --      !!alert.error('bore $!bore is not within the available bores')
      !!alert.error(!errormessage)
      !callingForm.bore.clear()
      !callingForm.mainBore.val = 'Main Bore'
      !callingForm.tlength.val = 0
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
      --    endhandle
    endif

    -- Get Allowable PIPE Specification Material types
    --    !stanMat = !!mdsParTT32[0].pipeMaterial
    --    handle any
    --      !stanMat = !!mdsParTT32[$!bore].pipeMaterial
    --    endhandle
    --
    -- At <mds12> the "ACTIVE" .pipeMaterial is STORED,
    -- i.e. The ACTUAL BORE .pipeMaterial, if it's SET, always overrides the ZERO[0] BORE .pipeMaterial
    !stanMat = !mdsTrunObj.pipeMaterial
    --
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------

    !matList = !stanMat.split(',')
    !findIt  =  !matList.findfirst(!pipeMat)

    if !findIt.string().eq('') then
      !findIt = 0
    endif

    if !stanMat.upcase().eq('UNSET') then
      !!alert.error('The MDS material code of the MDS standard is unset. aborting creation!')
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    if !pipeMat.upcase().eq('UNSET') then
      !!alert.error('The MDS material code of the pipe specification is unset. aborting creation!')
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    if !stanMat.neq('ALL') then
      if !findIt.eq(0) then
        !!alert.error('The identified pipe specification has a MDS material code of $!pipeMat and does not match the MDS standards material code/s of $!stanMat')
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      endif
    endif

    -- Finished material checking
    forwards

    --------------------------------------------------------------------------------
    -- Check if element identified is suitable for this type of dummy extension support
    --------------------------------------------------------------------------------
    !!ce = !element
    if (!!ce.type eq 'BRAN') then
      !od = ph od
    else
      !od = pa od
    endif

    -- Get Session Bore Units
    if(!!kgetBoreUnits()) then
      !boreUnits = 'inch bore'
    else
      !boreUnits = ''
    endif
    !bore = pl bore
    handle ANY
      var !hbor hbor
      !bore = !hbor.bore()
    endhandle

    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --<mds12> The available Trunnion Bore Sizes are now stored in the object member !mdsTrunObj.bores
    --
    -- The available bores will be stored in the object for TT32 !!mdsParTT32[Bore]
    -- Fill the selection gadget with these available bores and the styp to be used
    --    !availBores = !!mdsParTT32[$!bore].bores
    !availBores = !mdsTrunObj.bores
    if (!availBores.empty()) then
      --    handle any
      !!kRestoreUnits(!currentUnits)
      --      !!alert.error('bore $!bore is not within the available bores')
      !!alert.error('There are NO available Trunnion bores. aborting Trunnion creation.')
      !callingForm.bore.clear()
      !callingForm.mainBore.val = 'Main Bore'
      !callingForm.tlength.val = 0
      !!mdsDacControl(FALSE)
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
      --    endhandle
    endif
    --
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------
    !!kRestoreUnits(!currentUnits)
    !unitBore = ARRAY()
    do !setUnitBores from 1 to !availBores.size()
      !mmBore = !availBores[$!setUnitBores] & 'mm'
      !unitBore.append(!mmBore.bore(!!boreFmt).string())
    enddo
    !currentUnits = !!kgetsetunits()
    !!mdsTT32.bore.dtext = !unitBore
    !!mdsTT32.bore.rtext = !availBores
    !mmBore = !bore.string()
    !!kRestoreUnits(!currentUnits)
    !mainBore = !mmBore
    !!mdsTT32.mainBore.val = 'Main     Bore =     $!mainBore'
    !currentUnits = !!kgetsetunits()

    -- Get the default length if in create mode
    if !mode.upcase()eq('CREATE') then
      ---------------------------------------------------------------------------------------------------
      --<wd>apr2006<mds12>
      --!!mdsTT32.tlength.val = !!mdsParTT32[$!mainBore].default
      !callingForm.tlength.val = !mdsTrunObj.deflength
      --<wd>apr2006<mds12>
      ---------------------------------------------------------------------------------------------------
    endif

    !!mdsDacControl(TRUE)

    !teeOd = pl bore
    handle ANY
      var !hbor hbor
      !teeOd = !hbor.bore()
    endhandle

    new tee
    if !!mdsSelectComp(!!ce.type).not() then
      !!alert.error('Unable to find a suitable tee in the current specification')
      !callingForm.bore.clear()
      !callingForm.mainBore.val = 'Main Bore'
      !callingForm.tlength.val = 0
      !!mdsDacControl(TRUE)
      delete tee
      !!mdsDacControl(FALSE)
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    !!mdsDacControl(TRUE)
    -- spref $!foundTee
    sel lstu
    ori
    !paOd = pa od
    !dist = !paOd / 2 + 100mm
    dist $!dist from pl of prev
    handle ANY
      dist $!dist from ph
    endhandle
    !dist.delete()
    var !dist const dist p0 to p0 of prev
    handle ANY
      var !dist const dist p0 to ph
    endhandle
    !form.dist.val = $!dist

    --<dw>aug2008 dun979 - flow direction turned off
    new bran flowdir OFF
    :MDSTrun TRUE
    conn ph to same
    !hdir = ph dir
    !form.direction.val = !hdir.string().before(' WRT')

    Tbor $!!mdsTT32.bore
    Tcon ATT
    sel hstu
    pipe
    !pipeName = name
    same
    name $!pipeName/$!!mdsTT32.name

    -- Cut hole comment atta
    new atta select spref with styp 'COMMENT' spec /MDS
    sel lstu
    connect
    -- if !!mdsTrunNotes.boolean() then
    stex 'DO NOT CUT HOLE IN PIPE'
    -- endif
    atty CCNN
    name /$!!mdsTT32.name.val/NOTE1

    -- Setup sTypes for trunnion
    bran
    !unusedPhBore = ph bore
    same
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --!sType = !!mdsParTT32[$!phBore].sTypes[!callingForm.bore.val]
    !sType = !mdsTrunObj.sTypes[!callingForm.bore.val]
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------
    !splitStype = !sType.split(',')

    -- Create strap on clamp
    new atta despar 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm
    spkbrk TRUE
    select spref with styp '$!splitStype[1]' spec /MDS
    sel lstu
    conn and p3 is pl of href of bran
    handle (7,3)
      fconnect and p3 is pl of href of bran
    endhandle
    name /$!callingForm.name.val$n.1

    !!mdsSetDesPars(!!ce)
    --   !tubeOd = pl od
    -- work out the angle
    !p3dir = p3 dir

    if !p3dir.string().split()[3] eq 'U' or !p3dir.string().split()[3] eq 'Z' then
      -- !angOffset = -1 * !angOffset
      !backMark = -1 * !backMark
    endif

    !!mdsDacControl(TRUE)
    !pThk = (prop PTHK)

    !tOd = pt od
    !od = pa od

    -- Work out the adjustment needed for the exact length to be added to the iso
    -- and put in gadget
    !hyp = (!od / 2)
    !hyp = !hyp + !pThk.real()
    !side1 = (!tOd.real() / 2)
    !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))

    -- makeup piece
    new REDU select spref with styp 'MAKEUP' spec /MDS
    despar $!!mdsTT32.bore  $!offset  0mm
    sel lstu
    -- spkbrk true
    connect and p3 is d
    -- atty CCNN
    mtoc off
    name /$!!mdsTT32.name.val/MAKEUP

    -- Sref atta
    new atta
    stext '$!callingForm.name.val'
    spkbrk TRUE
    select spref with styp 'TT32' spec /MDS
    sel lstu
    connect
    shop TRUE
    name /$!!mdsTT32.name.val/SREF
    :MDSSuppType 'TT32'

    !bore = pa bore
    handle ANY
      !bore = pa bore of prev
    endhandle
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --!sType = !!mdsParTT32[$!mainBore].sTypes[!!mdsTT32.bore.val]
    !sType = !mdsTrunObj.sTypes[!callingForm.bore.val]
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------
    !splitStype = !sType.split(',')

    -- Weep hole comment atta
    new atta select spref with styp 'COMMENT' spec /MDS
    sel lstu
    connect
    if !!mdsTrunNotes.boolean() then
      stex '6mm WEEP HOLE'
    endif
    atty CCNN
    name /$!!mdsTT32.name.val/NOTE2

    -- Create end plate
    new PLAT despar 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm
    -- stext '$!!mdsTT32.name.val'
    -- spkbrk true
    select spref with styp '$!splitStype[2]' spec /MDS
    sel lstu
    conn
    name /$!!mdsTT32.name.val
    !!mdsSetDesPars(!!ce)
    !!mdsDacControl(TRUE)
    !overallLength = !!mdsTT32.tlength.val
    pos pl dist $!overallLength from PH
    !!mdsTT32.support.datum = !!ce

    bran
    conn pt to last mem
    TCON CLOS
    !tbor = pt bore

    /$!!mdsTT32.name.val
    !!mdsGetProp(!!mdsTT32.plength,!!mdsTT32.plength,'POD',!bore,'$!splitStype[2]')
    !!mdsGetProp(!!mdsTT32.pwidth,!!mdsTT32.pwidth,'PTHK',!bore,'$!splitStype[2]')

    bran
    sel hstu
    !!mdsResetPins(9,9)

    -- Set the correct design parameters
    /$!!mdsTT32.name.val/SREF
    var !hBorX hbor of bran
    despar $!hBorX $!tbor $!!mdsTT32.tlength.val

    -- Set the material and shop flags for all comps except the notes
    -- And remove insulation automatically
    !!mdsDacControl(TRUE)
    bran
    ispe =0
    !members = mem count
    do !set from 1 to !members
      bran
      $!set
      !!mdssetmatref(!!ce)
      handle ANY
      endhandle
      ispe =0
    enddo

    bran
    -- Add ATTAS to support object
    !branMem = mem count
    do !add from 1 to !branMem
      bran
      $!add
      !!mdsTT32.support.atta.append(!!ce)
    enddo

    -- The end cap is part of the IPMSCODE so turn off the material output
    --<wd>may2003
    --mtoc off
    -- mtoc off
    --<wd>may2003

    bran
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --!shop = !!mdsParTT32[$!mainBore].shop
    !shop = !mdsTrunObj.shop
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------
    shop $!shop

    do !set from 1 to !members
      bran
      $!set
      shop $!shop
    enddo

    bran
    -- Show the pipe material form automatically
    !!mdsTrunMat.init(!!mdsTT32)

    -- Activate/Deactivate gadgets
    !!mdsTT32.crTube.active = FALSE
    !!mdsTT32.tlength.active = TRUE
    --<wd>apr2006<mds12>  !!mdsTT32.setLen.active = true
    !!mdsTT32.bore.active = TRUE
    !!mdsTT32.setLen.active = FALSE
    !!mdsTT32.trunMat.active = TRUE
    !!mdsTT32.zoom.active = TRUE
    !!mdsTT32.ok.active = TRUE
    !!mdsTT32.member.active = FALSE
    !!mdsTT32.bdist.active = TRUE
    !!mdsTT32.bthro.active = TRUE
    !!mdsTT32.bdirection.active = TRUE
    !!mdsTT32.direction.active = TRUE
    !!mdsTT32.dist.active = TRUE
    !!mdsTT32.select.active = TRUE
    --<wd>apr2006<mds12>  !!mdsTT32.setLen.active = true

    -->>>-<wd>-nov2002
    -- Show the Trunnion Material Form
    !!mdsTrunMat.init(!!mdsTT32)
    --<<<-<wd>-nov2002

    -- This call had been added because there is a bug that reports the PT OD incorrectly
    call !!mdsResetDummy(!!mdsTT32)

    !!mdsDacControl(FALSE)

    --------------------------------------------------------------------------------
    -- Reset Units
    !!kRestoreUnits(!currentUnits)

  endif

endfunction
