--------------------------------------------------------------------------------
--
-- File: Mdssetdattt34.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Neale Morris
-- Created:
--
--
-- Description:
-- Creation function for Trunnion Type 'TT34'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        FORM of current Trunnion Type
--     2     R        STRING       CREATE - for Creating the Datum Atta - Trunnion Type and Size
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Define Function
define function !!mdssetdatTT34(!form is FORM, !mode is STRING,!onType is STRING)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kgetsetunits()

  -- Set calling form name
  !callingForm = !form
  !fromAtta    = !form.support.preliminaryStore.set()

  -- Initialise variables
  --  !support     = !form.support
  !name = !form.name.val
  --  !alias       = !form.support.alias
  !ceComp      = !!ce
  --  !formName    = '!!' & !form

  --------------------------------------------------------------------------------
  -- Create the Datum - Trunnion Atta
  if (!mode.upcase() eq 'CREATE') then
    -- Select tube to create dummy extension support
    if !onType.eq('CROS') then
      !idType = 'CROS TEE'
    else
      !idType = !onType
    endif

    --if we have an idtype of TUBE and are creating from an existing prelim support
    --then do not id anything just use the existing prelim atta
    if !fromAtta and !idType.eq('TUBE') then
      !prelimName = '/' & !name & '_Pre'
      !datumRef = object DBREF(!prelimName)
      handle ANY
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      elsehandle NONE
        !!ce = !datumRef
      endhandle
    else
      prompt off
      prompt load escape 'Identify $!onType to create dummy extension support'
      ID $!onType @
      handle (61,528)
        prompt on
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return FALSE
      endhandle
      prompt on
    endif
    !element = !!ce

    -- Check that pipe is named
    pipe
    if (!!ce.ref.string().eq(!!ce.name)) then
      !!alert.error('Pipe must be named to create MDS trunnion')
      !!ce = !ceComp
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif
    !!ce = !element

    -- Check pipe material
    !pipeMat = !!ce.owner.pspe.:MDSPipeMat
    !bore   = pl bore
    handle any
      !bore = ph bore
    endhandle

    -- Check if current selected bore is available
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --
    --    !boreCheck = !!mdsParTT34[$!bore].pipeMaterial
    --    handle any
    --
    -- NOTHING Created or Selected YET, so CHECK if TRUNNION STANDARD Available for the MAIN PIPE Bore
    --><wd>15may09 - DFN P-17079 - ERROR raised if PIPE BORE parameters are actual IMPERIAL bore sizes, e.g. 152.4mm = 6in and NOT 150mm
    --    !mBore  = !bore.real()
    !mBore  = !bore.string().lowcase().before('mm').real().value()
    --<<wd>15may09 - DFN P-17079

    !mdsStd = 'TT34'
    !mdsTrunObj  = object MDSREADTRUNDATA()
    !mdsTrunData = !mdsTrunObj.mdsTrunData(!mdsStd, !mBore)

    if (!mdsTrunData.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
      if (!mdsTrunObj.mdsStd.sactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
        !errormessage = !mdsTrunObj.mdsStd.smess
      elseif (!mdsTrunObj.mdsStd.cactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
        !errormessage = !mdsTrunObj.mdsStd.cmess
      endif

      !!kRestoreUnits(!currentUnits)
      --      !!alert.error('Bore $!bore is not within the available bores')
      !!alert.error(!errormessage)
      !callingForm.bore.clear()
      !callingForm.mainBore.val = 'Main Bore'
      !callingForm.tlength.val = 0
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
      --    endhandle
    endif

    -- Get Allowable PIPE Specification Material types
    --    !stanMat = !!mdsParTT34[0].pipeMaterial
    --    handle any
    --      !stanMat = !!mdsParTT34[$!bore].pipeMaterial
    --    endhandle
    --
    -- At <mds12> the "ACTIVE" .pipeMaterial is STORED,
    -- i.e. The ACTUAL BORE .pipeMaterial, if it's SET, always overrides the ZERO[0] BORE .pipeMaterial
    !stanMat = !mdsTrunObj.pipeMaterial
    --
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------

    !matList = !stanMat.split(',')
    !findIt  =  !matList.findfirst(!pipeMat)

    if !findIt.string().eq('') then
      !findIt = 0
    endif

    if !stanMat.upcase().eq('UNSET') then
      !!alert.error('The MDS material code of the MDS standard is unset. Aborting creation!')
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    if !pipeMat.upcase().eq('UNSET') then
      !!alert.error('The MDS material code of the pipe specification is unset. Aborting creation!')
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    if !stanMat.neq('ALL') then
      if !findIt.eq(0) then
        !!alert.error('The identified pipe specification has a MDS material code of $!pipeMat and does not match the MDS standards material code/s of $!stanMat')
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      endif
    endif

    -- Finished material checking
    forwards

    --------------------------------------------------------------------------------
    -- Check if element identified is suitable for this type of dummy extension support
    --------------------------------------------------------------------------------
    if (!!ce.type eq 'BRAN') then
      !od = ph od
    else
      !od = pa od
    endif

    --    !paTest = pa dir wrt /*
    --    !plTest = pl dir wrt /*
    --    if !paTest.string().eq('U WRT /*') then
    --    elseif !plTest.string().eq('U WRT /*') then
    --    elseif !paTest.string().eq('D WRT /*') then
    --    elseif !plTest.string().eq('D WRT /*') then
    --    else
    --      !!alert.error('Identified tube is not vertical')
    --      return

  endif

  -- Get Session Bore Units
  if(!!kGetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif
  !bore = pl bore
  handle any
    var !hbor hbor
    !bore = !hbor.bore()
  endhandle

  ---------------------------------------------------------------------------------------------------
  --<wd>apr2006<mds12>
  --<mds12> The available Trunnion Bore Sizes are now stored in the object member !mdsTrunObj.bores
  --
  -- The available bores will be stored in the object for TT34 !!mdsParTT34[Bore]
  -- Fill the selection gadget with these available bores and the styp to be used
  --    !availBores = !!mdsParTT34[$!bore].bores
  !availBores = !mdsTrunObj.bores
  if (!availBores.empty()) then
    --    handle any
    !!kRestoreUnits(!currentUnits)
    --      !!alert.error('Bore $!bore is not within the available bores')
    !!alert.error('There are NO available Trunnion bores. Aborting Trunnion creation.')
    !callingForm.bore.clear()
    !callingForm.mainBore.val = 'Main Bore'
    !callingForm.tlength.val = 0
    !!mdsdaccontrol(false)
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      !!mdsCancelSupp(!form)
    endif
    return
    --    endhandle
  endif
  --
  --<wd>apr2006<mds12>
  ---------------------------------------------------------------------------------------------------
  !!kRestoreUnits(!currentUnits)
  !unitBore = ARRAY()

  do !setUnitBores from 1 to !availBores.size()
    !mmbore = !availBores[$!setUnitBores] & 'mm'
    !unitBore.append(!mmbore.bore(!!boreFmt).string())
  enddo
  !currentUnits = !!kgetsetunits()
  !!mdsTT34.bore.dtext = !unitBore
  !!mdsTT34.bore.rtext = !availBores
  !mmbore = !bore.string()
  !!kRestoreUnits(!currentUnits)
  !mainBore = !mmbore
  !!mdsTT34.mainBore.val = 'Main     Bore =     $!mainBore'
  !currentUnits = !!kgetsetunits()

  -- Get the default length if in create mode
  if !mode.upcase()eq('CREATE') then
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --!!mdsTT34.tHeight.val = !!mdsParTT34[$!availBores[1]].default
    --!!mdsTT34.clear.val = !!mdsParTT34[$!availBores[1]].userDps[4].min
    !callingForm.tHeight.val = !mdsTrunObj.deflength
    !callingForm.clear.val   = !mdsTrunObj.userDps[4].min
    --<wd>apr2006<mds12>

  endif

  !!mdsdaccontrol(true)

  !teeOd = pl bore
  handle any
    var !hbor hbor
    !teeOd = !hbor.bore()
  endhandle

  new tee
  if !!mdsSelectComp(!!ce.type).not() then
    !!alert.error('Unable to find a suitable tee in the current specification')
    !callingForm.bore.clear()
    !callingForm.mainBore.val = 'Main Bore'
    !callingForm.tHeight.val = 0
    !!mdsdaccontrol(true)
    delete tee
    !!mdsdaccontrol(false)
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      !!mdsCancelSupp(!form)
    endif
    return
  endif

  !!mdsdaccontrol(true)

  -- spref $!foundTee
  sel lstu
  ori
  !paOd = pa od
  !dist = !paOd / 2 + 100mm
  dist $!dist from pl of prev
  handle any
    dist $!dist from ph
  endhandle
  !dist.delete()
  var !dist const dist p0 to p0 of prev
  handle ANY
    var !dist const dist p0 to ph
  endhandle
  !form.dist.val = $!dist

  --<dw>aug2008 dun979 - flow direction turned off
  new bran flowdir OFF
  :MDSTrun true
  conn ph to same
  !hdir = ph dir
  !form.direction.val = !hdir.string().before(' WRT')

  Tbor $!!mdsTT34.bore
  Tcon ATT
  sel hstu
  pipe
  !pipeName = name
  same
  name $!pipeName/$!!mdsTT34.name

  --New Stuff by BC
  -- Cut hole comment atta
  new atta select spref with styp 'COMMENT' spec /MDS
  sel lstu
  connect
  -- if !!mdsTrunNotes.boolean() then
  stex 'DO NOT CUT HOLE IN PIPE'
  -- endif
  atty CCNN
  name /$!!mdsTT34.name.val/NOTE1

  -- Setup sTypes for trunnion
  bran
  --    !phbore = ph bore
  same
  ---------------------------------------------------------------------------------------------------
  --<wd>apr2006<mds12>
  --!sType = !!mdsParTT34[$!mainBore].sTypes[!!mdsTT34.bore.val]
  !sType = !mdsTrunObj.sTypes[!callingForm.bore.val]
  --<wd>apr2006<mds12>
  ---------------------------------------------------------------------------------------------------
  !splitStype = !sType.split(',')

  -- Create strap on clamp

  new atta despar 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm
  spkbrk true
  select spref with styp '$!splitStype[1]' spec /MDS
  arri 2 lea 1 $* Turn clamp around as bolts should be away from trunnion
  sel lstu
  conn and p3 is pl of href of bran
  handle (7,3)
    fconnect and p3 is pl of href of bran
  endhandle
  name /$!callingForm.name.val$n.1

  !clamp = !!ce

  !!mdsSetDesPars(!!ce)
  --End of new stuff

  -- makeup piece
  new REDU select spref with styp 'MAKEUPOFF' spec /MDS
  despar $!!mdsTT34.bore 0mm 0mm
  sel lstu

  !tOd = pl od
  !od = pa od

  -- Work out the adjustment needed for the exact length to be added to the iso
  -- and put in gadget
  !hyp = (!od / 2)
  !side1 = (!tOd / 2)
  !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))
  despar $!!mdsTT34.bore $!offset  0mm
  -- spkbrk true
  connect and p3 is d
  -- atty CCNN
  mtoc off
  name /$!!mdsTT34.name.val/MAKEUP

  -- Sref atta
  new atta
  stext '$!!mdsTT34.name.val'
  spkbrk true
  select spref with styp 'TT34' spec /MDS
  sel lstu
  connect
  shop true
  name /$!!mdsTT34.name.val/SREF
  :MDSSuppType 'TT34'

  !bore = pa bore
  handle any
    !bore = pa bore of prev
  endhandle

  -- create mitred bend
  --<wd>16jan2008
  -- The Piping Spec. now needs to have a BEND with STYP of 'CUTA'
  -- to use the NEW 12 version of a PIPING MITRED BENDS
  --  new bend sel spref with styp 'CUT'
  new bend sel spref with styp 'CUTA'
  --<wd>16jan2008
  handle any
    !!alert.error('cannot find mitred elbo')
    if (!fromAtta) then
      !!mdsCancelSupp(!form)
    endif
    return
    --<wd>16jan2008
    -- The NEW 12 MITRED BEND radius attribute needs to be AUTOMATICALLY set to HALF the PIPE OD
  elsehandle NONE
    !bendrad = !!ce.pod[1] / 2
    radius $!bendrad
    --<wd>16jan2008
  endhandle
  name /$!!mdsTT34.name.val$n.2
  conn and pl is d
  --Calculate position from centre of clamp including the thickness of the pad
  !clear = !clamp.para[2] / 2 + !clamp.prop.pThk.real() + !form.clear.val
  clear $!clear from $!clamp
  sel lstu

  -- Weep hole comment atta
  new atta select spref with styp 'COMMENT' spec /MDS
  sel lstu
  connect
  handle (7,3)
    fconnect
  endhandle
  if !!mdsTrunNotes.boolean() then
    stex '6mm WEEP HOLE'
  endif
  atty CCNN
  name /$!callingForm.name.val/NOTE2
  !callingForm.support.atta.append(!!ce)

  -- Free to slide comment atta
  new atta select spref with styp 'COMMENT' spec /MDS
  sel lstu
  connect
  handle (7,3)
    fconnect
  endhandle
  if !!mdsTrunNotes.boolean() then
    stex 'FREE TO SLIDE'
  endif
  atty CCNN
  name /$!callingForm.name.val/NOTE3
  !callingForm.support.atta.append(!!ce)

  -- Create end plate
  new PLAT despar 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm
  -- spkbrk true
  select spref with styp '$!splitStype[2]' spec /MDS
  sel lstu
  conn
  name /$!!mdsTT34.name.val
  !!mdsSetDesPars(!!ce)
  !!mdsdaccontrol(true)
  !overallLength = !!mdsTT34.tHeight.val
  pos pl dist $!overallLength from prev bend
  !!mdsTT34.support.datum = !!ce
  bran
  conn pt to last mem
  TCON CLOS
  !tbor = pt bore

  /$!!mdsTT34.name.val
  !!mdsGetProp(!!mdsTT34.plength,!!mdsTT34.plength,'PLEN',!bore,'$!splitStype[2]')
  !!mdsGetProp(!!mdsTT34.pWidth,!!mdsTT34.pWidth,'PWID',!bore,'$!splitStype[2]')
  !!mdsGetProp(!!mdsTT34.pThk,!!mdsTT34.pThk,'PTHK',!bore,'$!splitStype[2]')
  bran
  sel hstu

  !!mdsResetPins(9,9)

  -- Set the correct design parameters
  /$!!mdsTT34.name.val/SREF
  var !hBorX hbor of bran
  despar $!hBorX $!tbor  $!!mdsTT34.tHeight.val $!!mdsTT34.clear.val

  -- Set the material and shop flags for all comps except the notes
  -- And remove insulation automatically
  !!mdsdaccontrol(true)
  bran
  ispe =0
  !members = mem count
  do !set from 1 to !members
    bran
    $!set
    !!mdssetmatref(!!ce)
    handle any
    endhandle
    ispe =0
  enddo

  bran
  -- Add ATTAS to support object
  !branMem = mem count
  do !add from 1 to !branMem
    bran
    $!add
    !!mdsTT34.support.atta.append(!!ce)
  enddo

  -- The end cap is part of the IMPSCODE so turn off the material output
  mtoc off

  bran
  ---------------------------------------------------------------------------------------------------
  --<wd>apr2006<mds12>
  --!shop = !!mdsParTT34[$!bore].shop
  !shop = !mdsTrunObj.shop
  --<wd>apr2006<mds12>
  ---------------------------------------------------------------------------------------------------
  shop $!shop

  do !set from 1 to !members
    bran
    $!set
    shop $!shop
  enddo

  bran
  call !!mdspostruntt34(!!mdsTT34,'SECT')
  -- Show the pipe material form automatically

  !!mdsTrunMat.init(!!mdsTT34)

  -- Activate/Deactivate gadgets
  !!mdsTT34.crTube.active = false
  !!mdsTT34.tHeight.active = true
  !!mdsTT34.setLen.active = true
  !!mdsTT34.bore.active = true
  !!mdsTT34.setLen.active = false
  !!mdsTT34.trunMat.active = TRUE
  !!mdsTT34.rotAtt.active = TRUE
  !!mdsTT34.zoom.active = true
  !!mdsTT34.ok.active = true
  !!mdsTT34.member.active = false
  !!mdsTT34.bdist.active = TRUE
  !!mdsTT34.bthro.active = true
  !!mdsTT34.bdirection.active = true
  !!mdsTT34.direction.active = true
  !!mdsTT34.dist.active = true
  !!mdsTT34.select.active = true
  !!mdsTT34.setLen.active = true
  !!mdsTT34.clear.active = true

  -->>>-<wd>-nov2002
  -- Show the Trunnion Material Form
  !!mdsTrunMat.init(!!mdsTT34)
  --<<<-<wd>-nov2002

  !!mdsdaccontrol(false)

  --------------------------------------------------------------------------------
  -- Reset Units
  !!kRestoreUnits(!currentUnits)

endfunction
-- End of function definition for !!mdssetdatTT34
