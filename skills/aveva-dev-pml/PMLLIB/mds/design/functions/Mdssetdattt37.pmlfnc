--------------------------------------------------------------------------------
--
-- File: Mdssetdattt37.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Neale Morris
-- Created: 2004
--
--
-- Description:
-- Creation function for Trunnion Type 'TT37'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        FORM of current Trunnion Type
--     2     R        STRING       CREATE - for Creating the Datum Atta - Trunnion Type and Size
--                              or MODIFY - for Reselecting the Datum Atta - Trunnion Type and Size
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Define Function
define function !!mdssetdattt37(!form is FORM, !mode is STRING,!onType is STRING)

-- Find current units and set the distance unit to metric
  !currentUnits = !!kgetsetunits()
-- Set calling form name
  !callingForm = !form
  !fromAtta    = !form.support.preliminaryStore.set()
  if !onType.eq('ELBO') and !fromAtta then
    !doNotID = TRUE
    !waitonform = !!mdsTT36selprelim
  else
    !doNotID = FALSE
    !waitonform = !!mdsTT36sel
  endif

-- Initialise variables
  !name = !form.name.val
  !ceComp      = !!ce
  !dir         = 'V'
--------------------------------------------------------------------------------
-- Create the Datum - Trunnion Atta
  if (!mode.upcase() eq 'CREATE') then
-- Select Elbo or Tube, this will determine what type of base support is created.
    if !onType.eq('CROS') then
      !idType = 'CROS TEE'
    else
      !idType = !onType
    endif

    --if we have an idtype of TUBE and are creating from an existing prelim support
    --then do not id anything just use the existing prelim atta
    if !fromAtta and !idType.eq('TUBE') then
      !prelimName = '/' & !name & '_Pre'
      !datumRef = object DBREF(!prelimName)
      handle ANY
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      elsehandle NONE
        !!ce = !datumRef
      endhandle
    else
      if !doNotID.not() then
    prompt off
    prompt load escape 'Identify $!idType to create base support'
    ID $!idType @
      handle (61,528)
        prompt on
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return FALSE
      endhandle
      prompt on
      endif
    endif
    !element = !!ce

-- Check that pipe is named
    pipe
    if (!!ce.ref.string().eq(!!ce.name)) then
        !!alert.error('Pipe must be named to create MDS trunnion')
        !!ce = !ceComp
        !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
        return
    endif
    !!ce = !element

-- Check pipe material
    !pipeMat = !!ce.owner.pspe.:MDSPipeMat
---------------------------------------------------------------------------------------------------
--<wd>apr2006<mds12>
--
    --!bore   = pl bore
    --handle any
    --  !bore = ph bore
    --endhandle
-- Determine the SMALLEST BORE if !onType is a REDUCER
    if !onType.eq('REDU') then
      !abor = !element.abor
      !lbor = !element.lbor
      if !abor.gt(!lbor) then
        !bore = !lbor
      else
        !bore = !abor
      endif

    else
      !bore   = pl bore
      handle any
        !bore = ph bore
      endhandle

    endif
--
--<wd>apr2006<mds12>
---------------------------------------------------------------------------------------------------

-- ge-08/11/04 Fix for HPD0025270
    if !bore.unset() then
     !bore = ppbore2
    endif
-- ge-08/11/04

-- Check if current selected bore is available
---------------------------------------------------------------------------------------------------
--<wd>apr2006<mds12>
--
--    !boreCheck = !!mdsParTT37[$!bore].pipeMaterial
--    handle any
--
-- NOTHING Created or Selected YET, so CHECK if TRUNNION STANDARD Available for the MAIN PIPE Bore
--><wd>15may09 - DFN P-17079 - ERROR raised if PIPE BORE parameters are actual IMPERIAL bore sizes, e.g. 152.4mm = 6in and NOT 150mm
--    !mBore  = !bore.real()
    !mBore  = !bore.string().lowcase().before('mm').real().value()
--<<wd>15may09 - DFN P-17079

    !mdsStd = 'TT37'
    !mdsTrunObj  = object MDSREADTRUNDATA()
    !mdsTrunData = !mdsTrunObj.mdsTrunData(!mdsStd, !mBore)

-- Temporary Variable ONLY
--!!t37obj = !mdsTrunObj

    if (!mdsTrunData.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
      if (!mdsTrunObj.mdsStd.sactive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
        !errormessage = !mdsTrunObj.mdsStd.smess
      elseif (!mdsTrunObj.mdsStd.cactive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
        !errormessage = !mdsTrunObj.mdsStd.cmess
      endif
--      !!alert.error('bore $!bore is not within the available bores')
      !!alert.error(!errormessage)
      !callingForm.bore.clear()
      !callingForm.mainBore.val = 'Main Bore'
      !callingForm.tlength.val = 0
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
--    endhandle
    endif

-- Get Allowable PIPE Specification Material types
--    !stanMat = !!mdsParTT37[0].pipeMaterial
--    handle any
--      !stanMat = !!mdsParTT37[$!bore].pipeMaterial
--    endhandle
--
-- At <mds12> the "ACTIVE" .pipeMaterial is STORED,
-- i.e. The ACTUAL BORE .pipeMaterial, if it's SET, always overrides the ZERO[0] BORE .pipeMaterial
    !stanMat = !mdsTrunObj.pipeMaterial
--
--<wd>apr2006<mds12>
---------------------------------------------------------------------------------------------------

    !matList = !stanMat.split(',')
    !findIt  =  !matList.findfirst(!pipeMat)

    if !findIt.string().eq('') then
      !findIt = 0
    endif

    if !stanMat.upcase().eq('UNSET') then
      !!alert.error('The MDS material code of the MDS standard is unset. aborting creation!')
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    if !pipeMat.upcase().eq('UNSET') then
      !!alert.error('The MDS material code of the pipe specification is unset. aborting creation!')
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    if !stanMat.neq('ALL') then
      if !findIt.eq(0) then
        !!alert.error('The identified pipe specification has a MDS material code of $!pipeMat and does not match the MDS standards material code/s of $!stanMat')
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      endif
    endif

-- Finished material checking
    forwards

--------------------------------------------------------------------------------
-- Check if element identified is suitable for this type of base support
--------------------------------------------------------------------------------
    !!ce = !element
    if !onType.eq('ELBO') then
      !paTest = pa dir wrt /*
      !plTest = pl dir wrt /*
      var !radius const dist p0 to p1
    elseif !onType.eq('REDU') then
      pin 1 copy pa
      pin 2 copy pl
      pin 1 plane pa thro pin 2
      var !pin1Pos pin 1 pos
      var !pin2Pos pin 2 pos
      !!mdsResetPins(1,2)
      if !pin1Pos.eq(!pin2Pos) then
        !!alert.error('Identified redu must be eccentric')
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      endif
      !spref = !!ce.spref.name
      !!mdsDacControl(TRUE)
      :MDSComment '$!spref'
-- Extract claim of branch error
        handle (2,605)
          !ce = !!ce
          bran
          extract claim ce
        handle (43,383)
          --this is not an extract just claim the branch
          claim ce
          handle ANY
            !!alert.error(!!error.text)
            return
          endhandle
        elsehandle ANY
              !!alert.error(!!error.text)
          if (!fromAtta) then
            !!mdsCancelSupp(!form)
          endif
              return
            elsehandle NONE
              claim ce
                handle ANY
                  !!alert.error(!!error.text)
            if (!fromAtta) then
              !!mdsCancelSupp(!form)
            endif
                  return
                endhandle
            endhandle
          !!ce = !ce
        endhandle

    elseif !onType.eq('CROS') then
--<wd>03jun2004
-- Create the GLOBAL Variable
      if(defined(!!tt37truncros)) then
        !!tt37truncros.delete()
      else
-- NOTE: Both Trunnion Types TT37 and TT37 set this global variable to 'TT37'
        !!tt37truncros = 'TT37'
      endif
--<wd>03jun2004
-- Scan for correct type
      if !!mdsSelectComp('CROS').not() then
--<wd>03jun2004 - DELETE the GLOBAL Variable
        !!tt37truncros.delete()
        handle ANY
        endhandle
--<wd>03jun2004

        !!alert.error('Unable to find a suitable cross in the current specification')
        !callingForm.bore.clear()
        !callingForm.mainBore.val = 'Main Bore'
        !callingForm.tlength.val = 0
        !!kRestoreUnits(!currentUnits)
        !!mdsDacControl(false)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      endif

--<wd>03jun2004 - DELETE the COPIED TEE
      !!tt37truncros.delete()
      handle ANY
      endhandle
--<wd>03jun2004
    endif

--<wd>nov2002
    --!od = pa od
    !od = pl od
      handle (2,252)
--<wd>nov2002
        !od = ph od
      endhandle

    !!mdsResetPins(1,1)

-- Get Session Bore Units
    if(!!kgetBoreUnits()) then
      !boreUnits = 'inch bore'
    else
      !boreUnits = ''
    endif

-- If REDUCER then get the Smallest Bore Size
   if (!onType.eq('REDU')) then
     if (!element.abor.gt(!element.lbor)) then
       !sBor = 'pl'
     else
       !sBor = 'pa'
     endif
   else
     !sBor = 'pl'
   endif
    --!bore = pl bore
    !bore = $!sBor bore
    handle any
      !bore = ph bore
    endhandle

---------------------------------------------------------------------------------------------------
--<wd>apr2006<mds12>
--<mds12> The available Trunnion Bore Sizes are now stored in the object member !mdsTrunObj.bores
--
-- The available bores will be stored in the object for TT37 !!mdsParTT37[Bore]
-- Fill the selection gadget with these available bores and the styp to be used
--    !availBores = !!mdsParTT37[$!bore].bores
    !availBores = !mdsTrunObj.bores
    if (!availBores.empty()) then
--    handle any
      !!kRestoreUnits(!currentUnits)
--      !!alert.error('bore $!bore is not within the available bores')
      !!alert.error('There are NO available Trunnion bores. aborting Trunnion creation.')
      !callingForm.bore.clear()
      !callingForm.mainBore.val = 'Main Bore'
      !callingForm.tlength.val = 0
      !!mdsDacControl(false)
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
--    endhandle
    endif
--
--<wd>apr2006<mds12>
---------------------------------------------------------------------------------------------------

   !!kRestoreUnits(!currentUnits)
   !unitBore = ARRAY()
   do !setUnitBores from 1 to !availBores.size()
     !mmBore = !availBores[$!setUnitBores] & 'mm'
     !unitBore.append(!mmBore.bore(!!boreFmt).string())
   enddo
   !currentUnits = !!kgetsetunits()
   !callingForm.bore.dtext = !unitBore
   !callingForm.bore.rtext = !availBores
   !mmBore = !bore.string()
    !!kRestoreUnits(!currentUnits)
   !mainBore = !mmBore
   !callingForm.mainBore.val = 'Main     Bore =     $!mainBore'
   !currentUnits = !!kgetsetunits()

-- Get the default length if in create mode
   if !mode.upcase()eq('CREATE') then
---------------------------------------------------------------------------------------------------
--<wd>apr2006<mds12>
--      !callingForm.tlength.val = !!mdsParTT37[$!bore].default
      !callingForm.tlength.val = !mdsTrunObj.deflength
--<wd>apr2006<mds12>
---------------------------------------------------------------------------------------------------
   endif

-- The support is created as a branch create branch and connect to appropriate member
    if !onType.eq('ELBO') or !onType.eq('REDU') then
-- The new branch will be connected to the p3 of the elbo, it will need to be on the correct
-- side as p3 is in the same place as p1 but in the opposite direction. Therefore the p3 will
-- be higher exit point.
      if !onType.eq('ELBO') then
-- Scan for correct elbow type
        if !!mdsSelectComp(!!ce.type).not() then
          !!alert.error('Unable to find a suitable elbow in the current specification')
          !callingForm.bore.clear()
          !callingForm.mainBore.val = 'Main Bore'
          !callingForm.tlength.val = 0
          !!kRestoreUnits(!currentUnits)
          !!mdsDacControl(false)
          if (!fromAtta) then
            !!mdsCancelSupp(!form)
          endif
          return
        endif

        if !doNotID.not() then
-- With this configuration you will need to choose Vertical or Horizontal but only for Elbows
        -- !where = !!alert.confirm('Create dummy extension from, YES for Vertical, NO for Horizontal',0,0)---------------------------------------------------------------------------------------------------
          !waitonform.direction1.tag = !!ce.adir.opposite().string()
          !waitonform.direction2.tag = !!ce.ldir.opposite().string()
          waiton !!$!waitonform
          if !waitonform.pressed.eq(0) then
          if (!fromAtta) then
            !!mdsCancelSupp(!form)
            endif
            return
          endif
        endif

        -- if ((!where.eq('YES')) and (!element.ppos[3].up.lt(!element.ppos[2].up))) then
        if ((!waitonform.direction.eq('D WRT /*') and (!element.ppos[3].up.lt(!element.ppos[2].up)))) then
          !!mdsDacControl(TRUE)
          flip ori
            handle any
              !!alert.error('The identified elbow requires to be flipped but access to the elbow has been denied. please flip the elbow and try again!.')
              !!kRestoreUnits(!currentUnits)
              !!mdsDacControl(FALSE)
            if (!fromAtta) then
              !!mdsCancelSupp(!form)
            endif
              return
            endhandle
            ori pa is $!paTest and pl is $!plTest
        else
          if !element.pdir[3].wrt(/* ).string().neq(!waitonform.direction) then
            !!mdsDacControl(TRUE)
            flip ori
              handle any
                !!alert.error('The identified elbow requires to be flipped but access to the elbow has been denied. please flip the elbow and try again!.')
                !!kRestoreUnits(!currentUnits)
                !!mdsDacControl(FALSE)
              if (!fromAtta) then
                !!mdsCancelSupp(!form)
              endif
                return
              endhandle
            ori pa is $!paTest and pl is $!plTest
          endif
        endif

        if ((!element.ppos[3].up.gt(!element.ppos[2].up))) then
          !dir = 'V'
        endif

        if ((!element.ppos[3].up.lt(!element.ppos[2].up))) then
          !dir = 'H'
        endif

      elseif !onType.eq('REDU') then
-- Scan for correct redu type
        if !!mdsSelectComp(!!ce.type).not() then
          !!alert.error('Unable to find a suitable reducer in the current specification')
          !callingForm.bore.clear()
          !callingForm.mainBore.val = 'Main Bore'
          !callingForm.tlength.val = 0
          !!kRestoreUnits(!currentUnits)
          !!mdsDacControl(false)
          if (!fromAtta) then
            !!mdsCancelSupp(!form)
          endif
          return
        endif
      endif

      !!mdsDacControl(true)


--<dw>aug2008 dun979 - flow direction turned off
      new bran flowdir OFF
      :MDSTrun true
      connect ph to p3 of same
      handle (42,64)
      endhandle
--<wd>03jun2004
-- Get the HDIR of the TRUNNION Branch for the Setting the Trunnion height
      if !onType.eq('REDU') then
        !tdir = !!ce.hdir.wrt(/* )
      endif
--<wd>03jun2004
    elseif !onType.eq('CROS') then
      !!mdsDacControl(true)
--<dw>aug2008 dun979 - flow direction turned off
      new bran flowdir OFF
      :MDSTrun true
      connect ph to p4 of same
        handle (42,64)
        endhandle
--<wd>03jun2004
-- Get the HDIR of the TRUNNION Branch for the Setting the Trunnion height
      !tdir = !!ce.hdir.wrt(/* )
--<wd>03jun2004
    else
-- This is a trunnion connected to a straight pipe, we need to select an equal tee with
-- an skey of TESO. If not abort

     !!mdsDacControl(true)

     !teeOd = pl bore
       handle (2,252)
         !teeOd = ph bore
       endhandle
     new tee
-- Extract claim of branch error
       handle (2,605)
         !ce = !!ce
         bran
         extract claim ce
        handle (43,383)
          --this is not an extract just claim the branch
          claim ce
          handle ANY
            !!alert.error(!!error.text)
            return
          endhandle
        elsehandle ANY
             !!alert.error(!!error.text)
          if (!fromAtta) then
            !!mdsCancelSupp(!form)
          endif
             return
           elsehandle NONE
             claim ce
               handle ANY
                 !!alert.error(!!error.text)
            if (!fromAtta) then
              !!mdsCancelSupp(!form)
            endif
                 return
               endhandle
           endhandle
         !!ce = !ce
       endhandle

     if !!mdsSelectComp(!!ce.type).not() then
       !!alert.error('Unable to find a suitable tee in the current specification')
       !callingForm.bore.clear()
       !callingForm.mainBore.val = 'Main Bore'
       !callingForm.tlength.val = 0
       !!mdsDacControl(true)
       delete tee
       !!mdsDacControl(false)
       !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
       return
     endif

     !!mdsDacControl(true)

     sel lstu
     lea 3
     dir d
     handle ANY  $* Pipe must be vertical so set direction N
      !dir = 'H'
      dir n
     endhandle
     lea 2
     !paOd = pa od
     !dist = !paOd / 2 + 100mm
      dist $!dist from pl of prev
        handle any
          dist $!dist from ph
        endhandle
        !dist.delete()
      var !dist const dist p0 to p0 of prev
        handle ANY
          var !dist const dist p0 to ph
        endhandle
      !form.dist.val = $!dist
--<dw>aug2008 dun979 - flow direction turned off
      new bran flowdir OFF
      :MDSTrun true
      conn ph to same
--<wd>03jun2004
-- Get the HDIR of the TRUNNION Branch for the Setting the Trunnion height
      !tdir = !!ce.hdir.wrt(/* )
--<wd>03jun2004
    endif

    !!mdsDacControl(true)

    --hdir d tdir u
    Hbor $!callingForm.bore
    Tbor $!callingForm.bore
    Tcon ATT
    sel hstu
    pipe
    !pipeName = name
    same
    name $!pipeName/$!callingForm.name

    !tOd = ph od

-- Work out the adjustment needed for the exact length to be added to the iso
    if !onType.eq('ELBO') then
      !hyp = !radius.real() + (!od / 2)
      !side1 = !radius.real() + (!tOd / 2)
      !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))
    else
-- Find smallest bore if redu
      if !onType.eq('REDU') then
        !rb1 = pod 1 of $!element
        !rb2 = pod 2 of $!element
        if !rb1.gt(!rb2) then
          !od = !rb2
        else
          !od = !rb1
        endif
      endif
      !hyp = (!od / 2)
      !side1 = (!tOd / 2)
      !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))
    endif
    hbor $!bore

    --><wd>25sep2009 - DFN P-22636 (SI-9969)
    -- Keep this ATTA at its CURRENT POSITION on types TUBE, REDU and TEE(CROS) to POSITION the NOTE CORRECTLY on the ISOMETRIC
    -- Cut Hole Comment Atta
    if (!onType.neq('ELBO')) then
      new atta select spref with styp 'COMMENT' spec /MDS
      sel lstu
      connect
      handle (7,3)
        fconnect
      endhandle
      -- if !!mdsTrunNotes.boolean() then
      stex 'DO NOT CUT HOLE IN PIPE'
      -- endif
      atty CCNN
      name /$!callingForm.name.val/NOTE1
      !callingForm.support.atta.append(!!ce)
    endif
    --<<wd>25sep2009 - DFN P-22636 (SI-9969)

-- makeup piece
    if !onType.eq('ELBO') or !onType.eq('REDU') then
      new REDU select spref with styp 'MAKEUP' spec /MDS
    else
      new REDU select spref with styp 'MAKEUPOFF' spec /MDS
    endif
    despar $!callingForm.bore $!offset  0mm
    -- spkbrk true
    sel lstu
    connect
      handle (7,3)
        fconnect
      endhandle
-- If the onType is an elbo we need to direct the p3 of the makeup in the correct direction
-- so that if a offset is applied it will offset in the correct direction
    if !onType.eq('ELBO') then
      !p2ElboDir = p2 dir of $!element wrt /*
      ori and p3 is $!p2ElboDir
    endif
    -- atty CCNN
    mtoc off
    name /$!callingForm.name.val/MAKEUP
    !callingForm.support.atta.append(!!ce)

    --><wd>25sep2009 - DFN P-22636 (SI-9969)
    -- Locate this ATTA at the PLEAVE of the MAKEUP REDUCER on ELBO TRUNNION ONLY to POSITION the NOTE CORRECTLY on the ISOMETRIC
    -- Cut hole comment atta
    if (!onType.eq('ELBO')) then
      new atta select spref with styp 'COMMENT' spec /MDS
      sel lstu
      connect
      handle (7,3)
        fconnect
      endhandle
      -- if !!mdsTrunNotes.boolean() then
      stex 'DO NOT CUT HOLE IN PIPE'
      -- endif
      atty CCNN
      name /$!callingForm.name.val/NOTE1
      !callingForm.support.atta.append(!!ce)
    endif
    --<<wd>25sep2009 - DFN P-22636 (SI-9969)

-- Weep hole comment atta
    new atta select spref with styp 'COMMENT' spec /MDS
    sel lstu
    connect
      handle (7,3)
        fconnect
      endhandle
    if !!mdsTrunNotes.boolean() then
      stex '6mm WEEP HOLE'
    endif
    atty CCNN
    name /$!callingForm.name.val/NOTE2
    !callingForm.support.atta.append(!!ce)

-- Free to slide comment atta
    new atta select spref with styp 'COMMENT' spec /MDS
    sel lstu
    connect
      handle (7,3)
        fconnect
      endhandle
    if !!mdsTrunNotes.boolean() then
      stex 'FREE TO SLIDE'
    endif
    atty CCNN
    name /$!callingForm.name.val/NOTE3
    !callingForm.support.atta.append(!!ce)

-- Sref atta
    new atta
    stext '$!callingForm.name.val'
    spkbrk true
    select spref with styp 'TT37' spec /MDS
    sel lstu
    connect
      handle (7,3)
        fconnect
      endhandle
    shop true
    name /$!callingForm.name.val/SREF
    :MDSSuppType 'TT37'
    !callingForm.support.atta.append(!!ce)

-- Baseplate atta
    new PLAT despar 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm
    !callingForm.support.datum = !!ce
    -- spkbrk true
---------------------------------------------------------------------------------------------------
--<wd>apr2006<mds12>
    !bore = pa bore
      handle any
        !bore = pa bore of prev
      endhandle
    bran
-- SET the variable for MAIN PIPE Bore Size -- NOT REQUIRED at <mds12>
--    !phBore = ph bore
    same
--    !sType = !!mdsParTT37[$!phBore].sTypes[!callingForm.bore.val]
    !sType = !mdsTrunObj.sTypes[!callingForm.bore.val]
--<wd>apr2006<mds12>
---------------------------------------------------------------------------------------------------
    select spref with styp '$!sType' spec /MDS
    sel lstu
    ori
    name /$!callingForm.name.val
    !callingForm.support.atta.append(!!ce)
    !!mdsSetDesPars(!!ce)
    !ce = !!ce

    !!mdsGetProp(!callingForm.plength,!callingForm.plength,'PLEN',!bore,'$!sType')
    !!mdsGetProp(!callingForm.pwidth,!callingForm.pwidth,'PWID',!bore,'$!sType')
    !!mdsGetProp(!callingForm.pThk,!callingForm.pThk,'PTHK',!bore,'$!sType')
---------------------------------------------------------------------------------------------------
--<wd>apr2006<mds12>
--    !length = !!mdsParTT37[$!phBore].default
    !length = !mdsTrunObj.deflength
--<wd>apr2006<mds12>
---------------------------------------------------------------------------------------------------

-- Create the array to position the component in the line
-- If the Pipe is vertical set the trunnion to point N else point it D
    if !onType.eq('ELBO') then
      !!mdsSetTrunLen('GADGET',!length,!!ce,!waitonform.direction,'TT37',!callingForm)
--<wd>03jun2004
    elseif (!onType.eq('CROS') or !onType.eq('REDU') ) then
      !!mdsSetTrunLen('GADGET',!length,!!ce,'$!tdir','TT37',!callingForm)
--<wd>03jun2004
    elseif !dir.eq('H') then
      !!mdsSetTrunLen('GADGET',!length,!!ce,'N WRT /*','TT37',!callingForm)
    else
      !!mdsSetTrunLen('GADGET',!length,!!ce,'D WRT /*','TT37',!callingForm)
    endif
    !!mdsResetPins(9,9)

    !!mdsDacControl(true)
-- Set the material and shop flags for all comps except the notes
-- and remove the insulation automatically
    bran
    ispe =0
    !members = mem count
    do !set from 1 to !members
      bran
      $!set
      !!mdssetmatref(!!ce)
        handle any
        endhandle
      !!mdsDacControl(true)
      ispe =0
    enddo

    bran
    !!mdsDacControl(TRUE)
---------------------------------------------------------------------------------------------------
--<wd>apr2006<mds12>
--    !shop = !!mdsParTT37[$!phBore].shop
    !shop = !mdsTrunObj.shop
--<wd>apr2006<mds12>
---------------------------------------------------------------------------------------------------
    shop $!shop

    do !set from 1 to !members
      bran
      $!set
      !!mdsDacControl(TRUE)
      shop $!shop
      !!mdsDacControl(FALSE)
    enddo

-- Activate/Deactivate gadgets
    !callingForm.tlength.active = true
    !callingForm.setLen.active = true
    !callingForm.bore.active = true
    !callingForm.setLen.active = true
    !callingForm.trunMat.active = TRUE
    !callingForm.rotAtt.active = TRUE
    if !onType.eq('TUBE') then
      !callingForm.bdist.active = true
      !callingForm.dist.active = true
      !callingForm.bthro.active = true
      !callingForm.select.active = true
    endif
    !callingForm.bdirection.active = true
    !callingForm.direction.active = true
    !hdir = ph dir
    !callingForm.direction.val = !hdir.string().before(' WRT')
    !callingForm.crElbo.active = false
    !callingForm.crTube.active = false
    !callingForm.crRedu.active = false
    !callingForm.crCros.active = false
    !callingForm.zoom.active = true
    !callingForm.ok.active = true

--------------------------------------------------------------------------------
-- Initiate the set trunnion length to steel form
   if !onType.eq('ELBO') then
     --if !where.eq('YES') then
      --!!mdsSetTrunLen('STEEL',!callingForm.tlength.val,!callingForm.support.datum,'D WRT /*','TT37',!callingForm)
     --endif
      !!mdsSetTrunLen('STEEL',!callingForm.tlength.val,!callingForm.support.datum,!waitonform.direction,'TT37',!callingForm)
      !!mdsTT37.tdirection = !waitonform.direction
--<wd>03jun2004
   elseif (!onType.eq('CROS') or !onType.eq('REDU') ) then
     !!mdsSetTrunLen('STEEL',!callingForm.tlength.val,!callingForm.support.datum,'$!tdir','TT37',!callingForm)
     !!mdsTT37.tdirection = '$!tdir'
   elseif !dir.eq('H') then
     !txDir = !form.direction.val & ' WRT /*'
     !tdir  = !txDir.direction()
     !!mdsSetTrunLen('STEEL',!callingForm.tlength.val,!callingForm.support.datum,'$!tdir','TT37',!callingForm)
--     !!mdsTT37.tdirection = !!mdsTT37.direction
     !!mdsTT37.tdirection = '$!tdir'
--<wd>03jun2004
   elseif !dir.eq('V') then
     !!mdsSetTrunLen('STEEL',!callingForm.tlength.val,!callingForm.support.datum,'D WRT /*','TT37',!callingForm)
     !!mdsTT37.tdirection = 'D WRT /*'
   else
--<wd>03jun2004 -- This CODE should NOT be USED, but has been left in the function JUST in CASE -- ???????????????
     !!mdsSetTrunHei(!!mdsTT37)
   endif

-- Check the trunnion bore compared to the main bore.
-- Offset button can only be active if it is a line size trunnion
   if !mainBore.bore().eq(!bore) then
     !!mdsTT37.poffset.active = true
   endif

-- State the trunnion direction
-- Show the Trunnion Material Form
    !!mdsTrunMat.init(!!mdsTT37)
--<<<-<wd>-nov2002

-- Deactivate MDS DAC control variable
    !!mdsDacControl(false)

-- Reset Units
    !!kRestoreUnits(!currentUnits)

-- Reset Pins
    !!mdsResetPins(1,10)
--<wd>03jun2004
-- ENSURE the GLOBAL Variable is always DELETED
      if(defined(!!tt37truncros)) then
        !!tt37truncros.delete()
      endif
--<wd>03jun2004

  endif

endfunction
