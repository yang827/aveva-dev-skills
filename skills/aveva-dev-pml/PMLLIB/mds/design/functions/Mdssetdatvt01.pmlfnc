--
-- File:  Mdssetdatvt01.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATVS101
--
-- Author:  Wayne Dodwell
-- Created:  Wednesday 11th December 1997
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdssetdatvt01()

  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  !tubeType = !!mdsoptions.pipes
  !support  = !!mdsVT01.support
  !datum    = !support.datum
  !name     = !support.stru.name
  !alias    = !support.alias
  !fromAtta    = !!mdsVT01.support.preliminaryStore.set()

  !cecomp = !!ce

  --------------------------------------------------------------------------------
  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    return
  endif

  --------------------------------------------------------------------------------
  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipetype = 'lined section'
  else
    !pipetype = 'tube'
  endif

  --> Modified - <wd> - 14sep1998
  label /again
  --< modified - <wd> - 14sep1998

  if (!fromAtta.not()) then
    if (!!mdsidtube('$!tubeType', 'Identify $!pipetype of datum pipe','PIPE').not())then
      return
    endif
  else
    !!ce = object DBREF(!name & '_Pre')
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsVT01.support.idcomp = !idcomp
  !!mdsVT01.support.idbran = !idbran


  -- Check that Selected PIPE is VERTICAL
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!hdir neq U and !hdir neq D ) then
    !!alert.message ('Only VERTICAL Pipes may be supported with the Vessel Framework Type ''$!support.type''')
    !!ce = !cecomp
    if (!fromAtta) then
      !!ce = object DBREF(!name)
      delete stru
      !!ce = object DBREF(!name & '_Pre')
      !!ce.name = !name
      !!mdsVT01.hide()
    endif
    return
  endif

  -- Check if the bore of the identified pipe does not exceed the maximum allowed bore
  !template = '/MDS/FRAMES/$!alias'
  !currentUnits = !!kgetsetunits()
  ------------------------------------------------------------------------------
  -- mjb >>> 08.05.06 <mds12>
  !checkbore = object MDSCHECKFRAME()
  --!checkbore = object MDSCHECKSTD()
  -- mjb <<< 08.05.06 end of mod
  ------------------------------------------------------------------------------
  if !checkbore.bores('$!template').not() then
    !!kRestoreUnits(!currentUnits)
    var !bore lbore
    handle any
      var !bore hbore
    endhandle
    !minbore = :mdsminbore of $!template
    !maxbore = :mdsmaxbore of $!template
    if !currentUnits.isimperialsavedbore().not() then
      !sminbore = !minbore
      !smaxbore = !maxbore
    else
      !sminbore = ( dist ( nombore ( false , $!minbore ) , false , false , true , 4 , false ) )
      !smaxbore = ( dist ( nombore ( false , $!maxbore ) , false , false , true , 4 , false ) )
    endif
    !!alert.error('Standard ''$!alias'' not available at this bore($!bore). Minimum ($!sminbore) Maximum ($!smaxbore)')
    if (!fromAtta) then
      !!ce = object DBREF(!name)
      delete stru
      !!ce = object DBREF(!name & '_Pre')
      !!ce.name = !name
      !!mdsVT01.hide()
    endif
    return
  else
    !!kRestoreUnits(!currentUnits)
  endif

  -- Create the Datum Atta
  !!mdsCrdatvt01()

  -- Set focus to the distance text gadget
  !!mdsVT01.dist.setfocus()

endfunction
