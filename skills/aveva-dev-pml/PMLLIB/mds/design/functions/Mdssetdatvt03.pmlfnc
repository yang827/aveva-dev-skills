--
-- File:    Mdssetdatvt03.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATVS103
--
-- Author:  Wayne Dodwell
-- Created:  Tuesday 13th January 1998
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatVT03()


  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()



  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  !tubeType = !!mdsoptions.pipes
  !support  = !!mdsVT03.support
  !datum    = !support.datum
  !name     = !support.stru.name
  !fromAtta    = !!mdsVT03.support.preliminaryStore.set()

  !cecomp = !!ce

  --------------------------------------------------------------------------------
  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  --------------------------------------------------------------------------------
  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipetype = 'lined section'
  else
    !pipetype = 'tube'
  endif

  --> Modified - <wd> - 14sep1998
  --  label /again
  --< Modified - <wd> - 14sep1998


  if (!fromAtta.not()) then
    if (!!mdsidtube('$!tubeType', 'Identify $!pipetype of datum pipe','PIPE').not())then
      !!kRestoreUnits(!currentUnits)
      return
    endif
  else
    !!ce = object DBREF(!name & '_Pre')
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsVT03.support.idcomp = !idcomp
  !!mdsVT03.support.idbran = !idbran

  -- Get Alternate Vessel Type Framework to use if PIPE is NOT Insulated

  !noEquiv = FALSE
  !substitute = trim (before (!!mdsvess.standard.dtext[!!mdsvess.standard.rtext.findfirst('VT04')], '-'))
  handle ANY
    !noEquiv = TRUE
    !substitute = 'Identified element is unsuitable to support from'
  endhandle

  -- Check that Selected PIPE has INSULATION and is VERTICAL
  var !insu insu
  if (!insu.real().eq(0)) then
    if !noEquiv.not() then
      !!alert.error('The Selected PIPE has ''$!insu''(zero) Insulation. For this PIPE Use Vessel Framework Type ''$!substitute''')
    else
      !!alert.error('The Selected PIPE has ''$!insu''(zero) Insulation. Aborting creation')
    endif
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      !!ce = object DBREF(!name)
      delete stru
      !!ce = object DBREF(!name & '_Pre')
      !!ce.name = !name
      !!mdsVT03.hide()
    endif
    return
  endif

  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!hdir neq U and !hdir neq D ) then
    !!alert.message ('Only VERTICAL Pipes may be supported with the Vessel Framework Type ''$!support.type''')
    !!ce = !cecomp
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      !!ce = object DBREF(!name)
      delete stru
      !!ce = object DBREF(!name & '_Pre')
      !!ce.name = !name
      !!mdsVT03.hide()
    endif
    return
  endif

  --------------------------------------------------------------------------------

  -- Change callback for apply button on form 'Mdsancill'
  !!mdsancill.action.clear()
  -- The function 'Mdscrancill' will Create the Datum Atta
  !!mdsancill.action[1] = |call !!mdscrancill(!!mdsVT03)|
  -- The function 'Mdscrdatvt03' will Copy the Datum Atta 3(three times),
  -- Name and Rotate each one by 90 degrees.
  !!mdsancill.action[2] = |call !!mdscrdatvt03()|

  -- Show Available SHOES in 'Mdsancill' form for Current Pipe Size Only
  -- and SHOES allowed for this type of Vessel Framework
  !comp = !!ce
  !plbor = pl bore
  handle ANY
    !plbor = hbor
  endhandle
  new atta sel wi styp 'VT03' spec /MDF
  handle ANY
    delete atta
    !!ce = !comp
    !!alert.error('Framework type ''$!support.type'' is NOT available for the $!<plbor> Pipe Selected')
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      !!ce = object DBREF(!name)
      delete stru
      !!ce = object DBREF(!name & '_Pre')
      !!ce.name = !name
      !!mdsVT03.hide()
    endif
    return
  elsehandle NONE
    delete atta
    !!ce = !comp
    !!kshowform(!!mdsancill)
    !!mdsiancill('VT03')

    -- <RM 05/08/01> commented the below out because the selection lists are determined above in mdsiancill and the !!mdsreaddefs call causes an error
    -- Update Selection and Restriction List eg. 'Mdsselvt03', 'Mdsselvt04', etc. for Vessel Frameworks
    -- that are to use a selection of the Standard 'Ancillary' Types
    --!prefix = ARRAY()
    --!prefix.append('VT03')
    --!prefix.append('VT04')
    --xxx      !prefix.append('VT05')
    --xxx      !prefix.append('VT06')

    --!!mdsreaddefs(!!mdstrunnvt01,!prefix)
    -- <RM 05/08/01> - end

  endhandle

  if (!!ce.type.eq('ATTA')) then
    SPKBRK TRUE
  endif
  --------------------------------------------------------------------------------
  -- Change the Callback on the Three Gadgets 'HEIGHT', 'LENGTH' and 'THICKNESS'
  -- On the 'MdsMODAT' form
  !!mdsmodat.actionheight[2]    = |call !!mdsattavt03('HEIGHT',!!mdsVT03)|
  !!mdsmodat.actionlength[2]    = |call !!mdsattavt03('LENGTH',!!mdsVT03)|
  !!mdsmodat.actionthickness[2] = |call !!mdsattavt03('THICKNESS',!!mdsVT03)|


  -- set focus to distance text gadget
  !!mdsVT03.dist.setFocus()

  -- set focus to distance text gadget
  !!mdsVT03.dist.setFocus()

  -- Reset Units

  !!kRestoreUnits(!currentUnits)

endfunction
