--
-- File:    Mdssetdatvt04.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATVS104
--
-- Author:  Wayne Dodwell
-- Created:  Tuesday 20th January 1998
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdssetdatvt04()

  -- Force into forwards mode
  FORWARDS

  !currentunits = !!kgetsetunits()
  -- Initialise variables
  !tubeType = !!mdsoptions.pipes
  !support  = !!mdsVT04.support
  !datum    = !support.datum
  !name     = !support.stru.name
  !fromAtta    = !!mdsVT04.support.preliminaryStore.set()

  !cecomp = !!ce

  --------------------------------------------------------------------------------
  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  --------------------------------------------------------------------------------
  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipetype = 'lined section'
  else
    !pipetype = 'tube'
  endif

  --> Modified - <wd> - 14sep1998
  --label /again
  --< Modified - <wd> - 14sep1998


  if (!fromAtta.not()) then
    if (!!mdsidtube('$!tubeType', 'Identify $!pipetype of datum pipe','PIPE').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif
  else
    !!ce = object DBREF(!name & '_Pre')
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsVT04.support.idcomp = !idcomp
  !!mdsVT04.support.idbran = !idbran

  -- Get Alternate Vessel Type Framework to use if PIPE is INSULATED
  !noEquiv = FALSE
  !substitute = trim (before (!!mdsvess.standard.dtext[!!mdsvess.standard.rtext.findfirst('VT03')], '-'))
  handle ANY
    !noEquiv = TRUE
    !substitute = 'Identified element is unsuitable to support from'
  endhandle

  -- Check that Selected PIPE has INSULATION and is VERTICAL
  var !insu insu
  if (!insu.real().gt(0)) then
    !!kFormatText.text.val = !insu.real()
    !fInsu = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    if !noEquiv.not() then
      !!alert.error('The Selected PIPE has an INSULATION Thickness of **' $
      &  !fInsu & '  **. For this PIPE Use Vessel Framework Type ' & !substitute)
    else
      !!alert.error('The Selected PIPE has an INSULATION Thickness of **' $
      &  !fInsu & '  **. Aborting creation')
    endif
    !!kRestoreUnits(!currentunits)
    if (!fromAtta) then
      !!ce = object DBREF(!name)
      delete stru
      !!ce = object DBREF(!name & '_Pre')
      !!ce.name = !name
      !!mdsVT04.hide()
    endif
    return
  endif

  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!hdir neq U and !hdir neq D ) then
    !!alert.message ('Only VERTICAL Pipes may be supported with the Vessel Framework Type ''$!support.type''')
    !!ce = !cecomp
    !!kRestoreUnits(!currentunits)
    if (!fromAtta) then
      !!ce = object DBREF(!name)
      delete stru
      !!ce = object DBREF(!name & '_Pre')
      !!ce.name = !name
      !!mdsVT04.hide()
    endif
    return
  endif

  --------------------------------------------------------------------------------

  -- Change callback for apply button on form 'Mdsancill'
  !!mdsancill.action.clear()
  -- The function 'Mdscrancill' will Create the Datum Atta
  !!mdsancill.action[1] = |call !!mdscrancill(!!mdsVT04)|
  -- The function 'Mdscrdatvt04' will Copy the Datum Atta 3(three times),
  -- Name and Rotate each one by 90 degrees.
  !!mdsancill.action[2] = |call !!mdscrdatvt04()|

  -- Show Available SHOES in 'Mdsancill' form for Current Pipe Size Only
  -- and SHOES allowed for this type of Vessel Framework
  !comp = !!ce
  !plbor = pl bore
  handle ANY
    !plbor = hbor
  endhandle
  new atta sel wi styp 'VT04' spec /MDF
  handle ANY
    delete atta
    !!ce = !comp
    !!alert.error('Framework type ''$!support.type'' is NOT available for the $!<plbor> Pipe Selected')
    --> Modified -<wd>-23sep1998
    !!kRestoreUnits(!currentunits)
    if (!fromAtta) then
      !!ce = object DBREF(!name)
      delete stru
      !!ce = object DBREF(!name & '_Pre')
      !!ce.name = !name
      !!mdsVT04.hide()
    endif
    --< Modified -<wd>-23sep1998
    return
  elsehandle NONE
    delete atta
    !!ce = !comp
    !!kshowform(!!mdsancill)
    !!mdsiancill('VT04')
  endhandle

  if (!!ce.type.eq('ATTA')) then
    SPKBRK TRUE
  endif

  --------------------------------------------------------------------------------
  --xxx-- Change the Callback on the Three Gadgets 'HEIGHT', 'LENGTH' and 'THICKNESS'
  --xxx-- On the 'MdsMODAT' form
  --xxx    !!mdsmodat.actionheight[2]    = |call !!mdsattavt04('HEIGHT',!!mdsVT04)|
  --xxx    !!mdsmodat.actionlength[2]    = |call !!mdsattavt04('LENGTH',!!mdsVT04)|
  --xxx    !!mdsmodat.actionthickness[2] = |call !!mdsattavt04('THICKNESS',!!mdsVT04)|

  -- set focus to the distance text gadget
  !!mdsVT04.dist.setFocus()

  !!kRestoreUnits(!currentunits)
endfunction
