--
-- File:    Mdssetdatvt06.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MDATVS105
--
-- Author:    Andrew Kirkland
-- Created:   Wednesday 13th May 1998
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdssetdatvt06()

  -- Force into forwards mode
  FORWARDS

  !currentunits = !!kgetsetunits()
  -- Initialise variables
  !tubeType = !!mdsoptions.pipes
  !support  = !!mdsVT06.support
  !datum    = !support.datum
  !name     = !support.stru.name
  !fromAtta    = !!mdsVT06.support.preliminaryStore.set()

  !cecomp = !!ce

  --------------------------------------------------------------------------------
  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  --------------------------------------------------------------------------------
  -- Select tube
  if (!tubeType eq 'FTUB')then
    !pipetype = 'lined section'
  else
    !pipetype = 'tube'
  endif

  --> Modified - <wd> - 14sep1998
  --    label /again
  --< Modified - <wd> - 14sep1998

  if (!fromAtta.not()) then
    if (!!mdsidtube('$!tubeType', 'Identify $!pipetype of datum pipe','PIPE').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif
  else
    !!ce = object DBREF(!name & '_Pre')
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsVT06.support.idcomp = !idcomp
  !!mdsVT06.support.idbran = !idbran


  -- Check that Selected PIPE is VERTICAL
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!hdir neq U and !hdir neq D ) then
    !!alert.message ('Only VERTICAL Pipes may be supported with the Vessel Framework Type '' & !support.type & ''')
    !!ce = !cecomp
    !!kRestoreUnits(!currentunits)
    if (!fromAtta) then
      !!ce = object DBREF(!name)
      delete stru
      !!ce = object DBREF(!name & '_Pre')
      !!ce.name = !name
      !!mdsVT06.hide()
    endif
    return
  endif

  --------------------------------------------------------------------------------

  --!comp = !!ce
  !plbor = pl bore
  handle ANY
    !plbor = hbor
  endhandle

  -------------------------------------------------------------------------------
  -- select Non gripped type (no option to select others)
  --<dw>mar2009 dun1119 - HPD0038470 Allow for selection of Non gripped U-bolts
  -- Change callback on apply button then show ancillary form
  !!mdsAncill.action.clear()
  !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsVT06)|
  !!mdsAncill.action[2] = |Call !!mdsCrDatVT06()|


  --<dw>mar2009 dun1119 - HPD0038470 This section no longer applies

  -- Get Bore size in inches
  !units = object COMUNITS(TRUE)
  units inch bores
  units inch dist
  !comp = !!ce
  !boreSize = pl bore
  handle ANY
    !boreSize = hbor
  endhandle
  -- Convert the bore size into a string
  -- !boreSize = !boreSizeIN.string().before('in')
  !newBoreSize = !boreSize.real().distance(FALSE,FALSE,TRUE,32,FALSE).trim()
  !units.restoreSavedBoreDist()

  -- Get Support size
  -- !selection = !!mdsVT06.size.selection()
  !selection = !!mdsSetSteel.size.selection('Rtext')

  -- Create the atta Component
  new atta sel spref with styp 'VT06-$!newBoreSize-$!selection' spec /MDF
  handle ANY
    delete atta
    !!ce = !comp
    !!alert.error(|Framework type '$!support.replace' is not available for the $!<plbor> Pipe Selected|)
    !!kRestoreUnits(!currentunits)
    if (!fromAtta) then
      !!ce = object DBREF(!name)
      delete stru
      !!ce = object DBREF(!name & '_Pre')
      !!ce.name = !name
      !!mdsVT06.hide()
    endif
    return
  elsehandle NONE
    delete atta
    !!ce = !comp
    !!kshowForm(!!mdsAncill)
    !!mdsIAncill('VT06')
    --call !!mdscrtattavt06(!!mdsVT06)
    --call !!mdsCrDatVT06()
  endhandle

  if (!!ce.type.eq('ATTA')) then
    SPKBRK TRUE
  endif

  --<dw>mar2009 dun1119 - HPD0038470 End of modification allowing for selection of U-bolts

  -- Check to see if the vt06 is available


  --------------------------------------------------------------------------------

  -- set focus to the distance text gadget
  !!mdsVT06.dist.setFocus()

  !!kRestoreUnits(!currentunits)
endfunction
