--
-- File:  Mdssetdatvt07.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATPS132
--
-- Author:  I.osborne
-- Created:  Wed Jul 02
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatVt07()

  -- Force into forwards mode
  FORWARDS

  !currentunits = !!kgetsetunits()
  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !support  = !!mdsVT07.support
  !datum    = !support.datum
  !name     = !support.stru.name
  !alias    = !!mdsVT07.support.alias
  !fromAtta    = !!mdsVT07.support.preliminaryStore.set()

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Select tube

  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif
  !idType = 'pipe'
  !purp = 'PIPE'

  label /again

  if (!fromAtta.not()) then
    if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of datum $!idType','$!purp').not())then
      !!kRestoreUnits(!currentunits)
      return
    endif
  else
    !!ce = object DBREF(!name & '_Pre')
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsVT07.support.idcomp = !idcomp
  !!mdsVT07.support.idbran = !idbran

  -- Check if PIPE is Vertical

  if (!!ce.type eq 'BRAN') then
    pin 9 copy ph
    var !p9dir pin 9 dir wrt /*
    if ('$!p9dir' neq |U|) and ('$!p9dir' neq |D|) then
      !!alert.error('Identified tube must be vertical')
      if (!fromAtta.not()) then
        golabel /again
      else
        !!ce = object DBREF(!name)
        delete stru
        !!ce = object DBREF(!name & '_Pre')
        !!ce.name = !name
        !!mdsVT07.hide()
        !!kRestoreUnits(!currentunits)
        return
      endif
    endif
    !!mdsResetPins(9,9)
  else
    !pltest = pl dir wrt /*
    if ('$!pltest' eq |U WRT /*|) or ('$!pltest' eq |D WRT /*|) then
    else
      !!alert.error('Identified tube must be vertical')
      if (!fromAtta.not()) then
        golabel /again
      else
        !!ce = object DBREF(!name)
        delete stru
        !!ce = object DBREF(!name & '_Pre')
        !!ce.name = !name
        !!mdsVT07.hide()
        !!kRestoreUnits(!currentunits)
        return
      endif
    endif
  endif

  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  -- Check if the bore of the identified pipe does not exceed the maximum allowed bore

  !template = '/MDS/FRAMES/$!alias'

  --<dw>sep2008 dun979 - To operate with defaults in Paragon for mds12
  !checkBore = object MDSCHECKFRAME()
  --!checkBore = object MDSCHECKSTD()
  --<dw>sep2008 dun979 - End of mod

  if !checkBore.bores('$!template').not() then
    !!kRestoreUnits(!currentunits)
    var !bore abore
    handle any
      var !bore hbore
    endhandle
    !minBore = :MDSMinBore of $!template
    !maxBore = :MDSMaxBore of $!template
    if (!currentunits.isImperialSavedBore().not()) then
      !sMinBore = !minBore
      !sMaxBore = !maxBore
    else
      !sMinBore = ( DIST ( NOMBORE ( false , $!minBore ) , false , false , true , 4 , false ) )
      !sMaxBore = ( DIST ( NOMBORE ( false , $!maxBore ) , false , false , true , 4 , false ) )
    endif
    !!alert.error('Standard not available at this bore! ($!bore). Minimum ($!sMinBore) Maximum ($!sMaxBore)')
    if (!fromAtta) then
      !!ce = object DBREF(!name)
      delete stru
      !!ce = object DBREF(!name & '_Pre')
      !!ce.name = !name
      !!mdsVT07.hide()
    endif
    !!kRestoreUnits(!currentunits)
    return
  endif
  --------------------------------------------------------------------------------

  !!mdsCrDatVt07()

  -- set focus to the distance text gadget
  !!mdsVT07.dist.setFocus()

  !!kRestoreUnits(!currentunits)
endfunction
