--
-- File:    Mdssetdatvt15.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MDATPS132
--
-- Author:    I.osborne
-- Created:   Wed Jul 02
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatvt15()

  -- Force into forwards mode
  FORWARDS

  !currentUnits = !!kgetsetunits()
  -- Initialise variables
  --!tubeType = !!mdsOptions.pipes
  !support  = !!mdsVT15.support
  !datum    = !support.datum
  !name     = !support.stru.name
  !alias    = !!mdsVT15.support.alias
  !fromAtta    = !!mdsVT15.support.preliminaryStore.set()

  --!cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Select u-bolt

  -- <ak> 21/06/2012
  if (!fromAtta AND defined (!!mdsAutoTubePicker) AND !!mdsAutoTubePicker.enabled()) then
    -- return if limit of pick tries exceeded
    if (!!mdsAutoTubePicker.allowedPicks.eq(0)) then
      !!ce = object DBREF(!name)
      delete stru
      !!mdsAutoTubePicker.cancel()
      !!kRestoreUnits(!currentUnits)
      return FALSE
    endif

    !picked = !!mdsAutoTubePicker.pick('ATTA','')
    if unset(!picked) then
      !!alert.warning ('There is no U-Bolt to support next to preliminary support.')
      !!ce = object DBREF(!name)
      delete stru
      !!mdsAutoTubePicker.cancel()
      !!kRestoreUnits(!currentUnits)
      return false
    else
      !!ce = !picked
    endif
  else
    -- <ak>

    -- Identify pedestal to attach guide to
    prompt off
    prompt load escape 'Identify U-Bolt to support'
    id atta @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentUnits)
      return false
    endhandle
    prompt on
  endif


  -- Check if u-bolt is in a vertical leg

  if (!!ce.type eq 'BRAN') then
    pin 9 copy ph
    var !p9dir pin 9 dir wrt /*
    if ('$!p9dir' neq |U|) and ('$!p9dir' neq |D|) then
      !!alert.error('Identified tube must be vertical')
      if (!fromAtta) then
        !!ce = object DBREF(!name)
        delete stru
        !!ce = object DBREF(!name & '_Pre')
        !!ce.name = !name
        !!mdsVT15.hide()
      endif
      !!kRestoreUnits(!currentUnits)
      return
    endif
    !!mdsResetPins(9,9)
  else
    !pltest = pl dir wrt /*
    if ('$!pltest' eq |U WRT /*|) or ('$!pltest' eq |D WRT /*|) then
    else
      !!alert.error('Identified tube must be vertical')
      if (!fromAtta) then
        !!ce = object DBREF(!name)
        delete stru
        !!ce = object DBREF(!name & '_Pre')
        !!ce.name = !name
        !!mdsVT15.hide()
      endif
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endif

  --<RM 06/08/09> replaced selection/restriction code with the !!mdsValidComponent function which uses the
  --mdsSelection object to find the component selections and restrictions and then brings up the mdsSelectionList messagebox to warn of
  --incompatibility
  if (!!mdsValidComponent('VT15', !!ce).not()) then
    if (!fromAtta) then
      !!ce = object DBREF(!name)
      delete stru
      !!ce = object DBREF(!name & '_Pre')
      !!ce.name = !name
      !!mdsVT15.hide()
    endif
    !!kRestoreUnits(!currentUnits)
    return
  endif

  --<RM 31/07/09> - END

  -- Check if the bore of the identified pipe does not exceed the maximum allowed bore

  !template = '/MDS/FRAMES/$!alias'

  --<dw>sep2008 dun979 - To operate with defaults in Paragon for mds12
  !checkBore = object MDSCHECKFRAME()
  --!checkBore = object MDSCHECKSTD()
  --<dw>sep2008 dun979 - End of mod

  if !checkBore.bores('$!template').not() then
    !!kRestoreUnits(!currentUnits)
    var !bore abore
    handle any
      var !bore hbore
    endhandle
    !minBore = :MDSMinBore of $!template
    !maxBore = :MDSMaxBore of $!template
    if !currentUnits.isimperialsavedbore().not() then
      !sMinBore = !minBore
      !sMaxBore = !maxBore
    else
      !sMinBore = ( DIST ( NOMBORE ( false , $!minBore ) , false , false , true , 4 , false ) )
      !sMaxBore = ( DIST ( NOMBORE ( false , $!maxBore ) , false , false , true , 4 , false ) )
    endif
    !!alert.error('Standard not available at this bore! ($!bore). Minimum ($!sMinBore) Maximum ($!sMaxBore)')
    if (!fromAtta) then
      !!ce = object DBREF(!name)
      delete stru
      !!ce = object DBREF(!name & '_Pre')
      !!ce.name = !name
      !!mdsVT15.hide()
    endif
    !!kRestoreUnits(!currentUnits)
    return
  endif
  --------------------------------------------------------------------------------

  -- Change callback on apply button then show ancillary form

  !!mdsCrDatvt15()

  -- set focus to the distance text gadget
  !!mdsVT15.dist.setFocus()

  !!kRestoreUnits(!currentUnits)
endfunction
