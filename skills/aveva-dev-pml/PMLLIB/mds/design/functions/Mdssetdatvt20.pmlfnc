--
-- File:  Mdssetdatvt20.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MDATPS132
--
-- Author:  Gordon Evans
-- Created:  Wednesday 22nd Oct 2003
--
--
-- Description:
-- Sets Datum atta on pipe
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatvt20()

  -- Force into forwards mode
  FORWARDS

  !currentUnits = !!kgetsetunits()
  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !support  = !!mdsVT20.support
  !datum    = !support.datum
  !name     = !support.stru.name
  !alias    = !!mdsVT20.support.alias
  !fromAtta    = !!mdsVT20.support.preliminaryStore.set()

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Datum atta for support $!name already exists')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Select tube

  if (!tubeType eq 'FTUB')then
    !pipeType = 'lined section'
  else
    !pipeType = 'tube'
  endif
  !iDType = 'pipe'
  !purp = 'PIPE'

  label /again

  if (!fromAtta.not()) then
    if (!!mdsIdTube('$!tubeType', 'Identify $!pipeType of datum $!iDType','$!purp').not())then
      !!kRestoreUnits(!currentUnits)
      return
    endif
  else
    !!ce = object DBREF(!name & '_Pre')
  endif

  -- In case we id a different element when second pick set the first id

  if (!!ce.type.eq('BRAN')) then
    !idbran = !!ce
  else
    !idbran = !!ce.owner
  endif
  !idcomp = !!ce
  !!mdsVT20.support.idcomp = !idcomp
  !!mdsVT20.support.idbran = !idbran

  -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
  -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.

  !currcomp = !!ce

  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!hdir neq U and !hdir neq D ) then
    !template = '/MDS/FRAMES/VT20-HORI'
  else
    !template = '/MDS/FRAMES/VT20-VERT'
  endif

  if (!hdir neq U and !hdir neq D ) then
    if (!!mdsgradient(!currcomp)) then
      !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
      !!ce = !cecomp
      if (!fromAtta) then
        !!ce = object DBREF(!name)
        delete stru
        !!ce = object DBREF(!name & '_Pre')
        !!ce.name = !name
        !!mdsVT20.hide()
      endif
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endif


  -- Check that the :MDSHv attribute of the template zone to see if horizontal
  -- or vertical pipes are allowed

  if !!mdschecktemp('/MDS/FRAMES/VT20-HORI','$!hdir').not() then
    !!kRestoreUnits(!currentUnits)
    if (!fromAtta) then
      !!ce = object DBREF(!name)
      delete stru
      !!ce = object DBREF(!name & '_Pre')
      !!ce.name = !name
      !!mdsVT20.hide()
    endif
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Check if the bore of the identified pipe does not exceed the maximum allowed bore
  -- !template = '/MDS/FRAMES/$!alias'

  ------------------------------------------------------------------------------
  -- mjb >>> 08.05.06 <mds12>
  !checkBore = object MDSCHECKFRAME()
  --!checkBore = object MDSCHECKSTD()
  -- mjb <<< 08.05.06 end of mod
  ------------------------------------------------------------------------------
  if !checkBore.bores('$!template').not() then
    !!kRestoreUnits(!currentUnits)
    var !bore abore
    handle any
      var !bore hbore
    endhandle
    !minBore = :MDSMinBore of $!template
    !maxBore = :MDSMaxBore of $!template
    if !currentUnits.isimperialsavedbore().not() then
      !sMinBore = !minBore
      !sMaxBore = !maxBore
    else
      !sMinBore = ( DIST ( NOMBORE ( false , $!minBore ) , false , false , true , 4 , false ) )
      !sMaxBore = ( DIST ( NOMBORE ( false , $!maxBore ) , false , false , true , 4 , false ) )
    endif
    !!alert.error('Standard not available at this bore! ($!bore). Minimum ($!sMinBore) Maximum ($!sMaxBore)')
    if (!fromAtta) then
      !!ce = object DBREF(!name)
      delete stru
      !!ce = object DBREF(!name & '_Pre')
      !!ce.name = !name
      !!mdsVT20.hide()
    endif
    !!kRestoreUnits(!currentUnits)
    return
  endif
  --------------------------------------------------------------------------------

  -- Change callback on apply button then show ancillary form

  !!mdsAncill.action.clear()
  !!mdsAncill.action[1] = |Call !!mdsCrAncill(!!mdsVT20)|

  -- Create the Datum Atta

  !!mdsAncill.action[2] = |Call !!mdsCrDatvt20()|

  !!kShowForm(!!mdsAncill)
  !!mdsIAncill('$!alias')
  -- set focus to the distance text gadget
  !!mdsVT20.dist.setFocus()

  !!kRestoreUnits(!currentUnits)
endfunction
