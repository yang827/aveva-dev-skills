--
-- File: Mdssetdef.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: N.morris
-- Created: Tue Oct 28
--
--
-- Description:
-- Creation function for general ancillary at01 and anchor an01
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDef(!dummyAlias is STRING, !atta is DBREF,!confirm is STRING)

-- Get current units and set working units to mm.
  !currentUnits = !!kGetSetUnits()
  !!ce = !atta
  !type = !!ce.:MDSSuppType
  !sType = !!ce.styp

--<wd>feb2004
-- Check if an Association Exists Between a SHOE Atta and a RPAD Atta - Warn User & Discontinue if TRUE
  if (!atta.:MDSSRef.badref().not()) then
    !!alert.error('Unable to reset to default parameters, as there is an association between a pipe SHOE and a pipe Re-enforcing/Cradle PAD.')
    return
  endif
--<wd>feb2004

-- Confirm with user that he is sure.
  if !confirm.eq('CONFIRM') then
    if (!!alert.confirm('Are you sure you want to set the support to it''s default parameters?') eq 'NO') then
      return
    endif
  endif

-- There are some standards which we have to save parameters and reset then after setting default pars
  if (!type inset('AT10A','AT11A','AN01A','ST01','ST02','ST03')) then
    !saved = despar[2]
  endif

  if (!type inset('ST12')) then
    !saved = despar[4]
  endif

  if (!type inset('ST09A','ST09B')) then
    !saved = despar[8]
  endif


  if (match(!type,|GT04|) gt 0) then
    !saved = despar[1]
  endif

  if (match(!type,|GT20|) gt 0) then
    !saved1 = despar[1]
    !saved2 = despar[2]
  endif

  if (match(!sType,|AT29|) gt 0) then
    !saved2 = despar[2]
    !saved3 = despar[3]
  endif

  if (match(!sType,|AT30|) gt 0) then
    !saved1 = despar[1]
    !saved2 = despar[2]
  endif

  if (match(!sType,|AT26|) gt 0) then
    !saved = despar[8]
  endif

  if (match(!sType,|GT13|) gt 0) then
    !saved = despar[13]
  endif

  if !type.eq('SP01') then
    !currentDPs = despar
    !offsetFromCL = !currentDPs[5]
  endif

  if !type.match('AN06').gt(0) then
  -- mjb >>> 14.03.06 AT25 does not have a despar with dkey INSU or ITHK
  --or !type.match('AT25').gt(0)
  -- mjb <<< end of mod
    !saved = (prop INSU)
      handle none
        !dpNum = !!mdsGetDesp('INSU')
      elsehandle any
        !saved = (prop ITHK)
        !dpNum = !!mdsGetDesp('ITHK')
      endhandle
  endif

  if !type.match('AT53A').gt(0) or !type.match('AT53B').gt(0) then
    !dpNum = !!mdsGetDesp('SPLE')
    !saved = (prop SPLE)
  endif

  if !type.eq('BR01') then
    !saved1 = despar[3]
    !saved2 = despar[4]
    !saved3 = despar[6]
  endif

  if !type.eq('BR02') then
    !saved1 = despar[3]
    !saved2 = despar[4]
    !saved3 = despar[6]
  endif

  if !type.eq('BR03') then
    !saved1 = despar[3]
    !saved2 = despar[4]
    !saved3 = despar[5]
  endif

  if !type.eq('BR04') then
    !saved1 = despar[3]
    !saved2 = despar[4]
    !saved3 = despar[5]
  endif

  if !type.eq('BR05') then
    !saved1 = despar[3]
    !saved2 = despar[4]
    !saved3 = despar[5]
  endif

  if !type.eq('BR06') then
    !saved1 = despar[3]
    !saved2 = despar[4]
    !saved3 = despar[5]
  endif
--<dw>aug2008 dun979 - BR07 to BR09 added
  if !type.eq('BR07') then
    !saved1 = despar[3]
    !saved2 = despar[4]
    !saved3 = despar[5]
  endif

  if !type.eq('BR08') then
    !saved1 = despar[3]
    !saved2 = despar[4]
    !saved3 = despar[5]
  endif

  if !type.eq('BR09') then
    !saved1 = despar[3]
    !saved2 = despar[4]
    !saved3 = despar[5]
  endif

  if !type.eq('AT60') then
    !saved = despar[8]
  endif

  if !!ce.styp.eq('AC34') then
    !saved = despar[1]
  endif

  if (!type inset('AT62','AT69','AT70','AT71')) then
    !saved = despar[1]
  endif

  if (!type inset('ST08','ST14','ST15','ST16')) then
    !saved = despar[6]
    if !type.eq('ST16') then
      !saved4 = despar[6]
      !saved1 = despar[7]
    endif
    if !type.eq('ST08') then
      !saved2 = despar[3]
      !saved3 = despar[4]
    endif
  endif

  if (!type inset('GT11','GT12A','GT12B')) then
    !saved1 = despar[1]
    !saved2 = despar[2]
  endif

  if (!type inset('GT12')) then
    !saved = despar[2]
  endif

  if (!sType inset('GT12A','GT12B')) then
    !saved19 = despar[19]
    handle ANY
     !saved19 = despar[3]
    endhandle
  endif
  if (!type inset('ST07')) then
    !saved1 = despar[1]
    !saved2 = despar[2]
  endif

  if (!type inset('GT27A','GT27B')) then
    !saved = despar[2]
  endif

  if (!type inset('ST24A','ST24B','ST24C','ST24D')) then
    !saved = despar[2]
  endif

----------------------------------------------------
-- Set values to default
----------------------------------------------------

  --<kp>may2011
  -- store current mode and switch to FORWARD in order to correct evaluation of expressions
  var !mode mode
  forward

  !!mdsSetDesPars(!atta)

  -- reinstate original mode
  $!mode

----------------------------------------------------
----------------------------------------------------

  !!mdsDacControl(true)


-- Reset saved values
  if (!type inset('AT10A','AT11A','AN01A','ST01','ST02','ST03')) then
    despar n 2 $!saved
  endif

  if (!sType inset('AT29A','AT29B')) then
    despar n 2 $!saved2
    despar n 3 $!saved3
  endif

  if (!sType inset('AT30')) then
    despar n 1 $!saved1
    despar n 2 $!saved2
  endif

  if (match(!type,|GT04|) gt 0) then
    !type = !!ce.styp
    despar n 1 $!saved
  endif

  if (match(!type,|GT20|) gt 0) then
    !type = !!ce.styp
    despar n 1 $!saved1
    despar n 2 $!saved2
  endif

  if (match(!type,|AT26|) gt 0) then
    despar n 8 $!saved
  endif

  if (match(!type,|GT13|) gt 0) then
    despar n 13 $!saved
  endif

  if(!type.eq('SP03')) then
     -- sp03 uses types A to G *******(need to change this for pedestal types)************
    !type = !atta.styp.substring(1,5)
  endif

  if !type.match('AN06').gt(0) then
  -- mjb >>> 14.03.06 AT25 does not have a despar with dkey INSU or ITHK (see line 108)
  --or !type.match('AT25').gt(0)
  -- mjb <<< end of mod
    despar n$!dpNum $!saved
  endif

  if (!type inset('ST12')) then
    despar n4 $!saved
  endif

  if (!type inset('ST09A','ST09B')) then
    despar n8 $!saved
  endif

-- For the RPad Atta AC34 on LT04 Support Lug
  if (!sType inset ('AC34')) then
    !type = !sType
  endif

  if !!ce.styp.eq('AC34') then
    despar n1 $!saved
  endif

  if(!type.eq('AT53A') or !type.eq('AT53B')) then
    despar n$!dpNum $!saved
  endif

  if !type.eq('BR01') then
    despar n3 $!saved1
    despar n4 $!saved2
    despar n6 $!saved3
  endif

  if !type.eq('BR02') then
    despar n3 $!saved1
    despar n4 $!saved2
    despar n6 $!saved3
  endif

  if !type.eq('BR03') then
    despar n3 $!saved1
    despar n4 $!saved2
    despar n5 $!saved3
  endif

  if !type.eq('BR04') then
    despar n3 $!saved1
    despar n4 $!saved2
    despar n5 $!saved3
  endif

  if !type.eq('BR05') then
    despar n3 $!saved1
    despar n4 $!saved2
    despar n5 $!saved3
  endif

  if !type.eq('BR06') then
    despar n3 $!saved1
    despar n4 $!saved2
    despar n5 $!saved3
  endif
--<dw>aug2008 dun955 - BR07 to BR09 added
  if !type.eq('BR07') then
    despar n3 $!saved1
    despar n4 $!saved2
    despar n5 $!saved3
  endif

  if !type.eq('BR08') then
    despar n3 $!saved1
    despar n4 $!saved2
    despar n5 $!saved3
  endif

  if !type.eq('BR09') then
    despar n3 $!saved1
    despar n4 $!saved2
    despar n5 $!saved3
  endif

  if !type.eq('AT60') then
    despar n8 $!saved
  endif

  if (!type inset('AT62','AT69','AT70','AT71')) then
    despar n1 $!saved
  endif

  if (!type inset('ST08','ST14','ST15','ST16')) then
    despar n6 $!saved
    if !type.eq('ST16') then
      despar n6 $!saved4
      despar n7 $!saved1
    endif
    if !type.eq('ST08') then
      despar n3 $!saved2
      despar n4 $!saved3
    endif
  endif

  if (!type inset('GT11','GT12A','GT12B')) then
    despar n1 $!saved1
    despar n2 $!saved2
  endif

  if (!type inset('GT12')) then
    despar n2 $!saved
  -- mjb >>> 16.03.06 missing endif added (found when working on <mds12> upgrade)
  endif
  -- mjb <<< 16.03.06 END

  if (!sType inset('GT12A','GT12B')) then
    despar n19 $!saved19
    handle ANY
      despar n19 $!saved3
    endhandle
  endif

  if (!type inset('ST07')) then
    despar n1 $!saved1
    despar n2 $!saved2
  endif


  if (!type inset('GT27A','GT27B')) then
    despar n2 $!saved
  endif

  if (!type inset('ST24A','ST24B','ST24C','ST24D')) then
    despar n2 $!saved
  endif

-- Reset the Modify ATTA form to new values
  !bore = pa bore

  !!mdsGetProp(_height,_height,'HEIG',!bore,!type)
    handle ANY
    endhandle

  if defined(_height) then
    if _height.val.eq(0) then
    !!mdsGetProp(_height,_pHeight,'HEI',!bore,!type)
      handle any
      endhandle
    endif
  endif

  if defined(_height) then
    if _height.val.eq(0) then
      !!mdsGetProp(_height,_pHeight,'PWID',!bore,!type)
        handle any
        endhandle
    endif
  endif

  if defined(_height) then
    if _height.val.eq(0) then
      !!mdsGetProp(_height,_pHeight,'FHEI',!bore,!type)
        handle any
        endhandle
    endif
  endif

  !!mdsGetProp(_length,_pLength,'LEN',!bore,!type)
    handle any
    endhandle

  !!mdsGetProp(_extra,_pExtra,'ECLR',!bore,!type)
    handle any
    endhandle

  if defined(_length) then
    if _length.val.eq(0) then
      !!mdsGetProp(_length,_pLength,'PLEN',!bore,!type)
        handle any
        endhandle
    endif
  endif

  if defined(_length) then
    if _length.val.eq(0) then
      !!mdsGetProp(_length,_pLength,'GDEP',!bore,!type)
        handle any
        endhandle
    endif
  endif

  !x = (prop THK)
    handle none
      !!mdsGetProp(_thickness,_pThickness,'THK',!bore,!type)
        handle any
        endhandle
    elsehandle any
    endhandle

  !x = (prop THK)
    handle none
      if defined(_thickness) then
        if _thickness.val.eq(0) then
          !!mdsGetProp(_thickness,_pThickness,'THK',!bore,!sType)
            handle any
            endhandle
        endif
      endif
    elsehandle any
    endhandle

  !x = (prop PTHK)
    handle none
      if defined(_thickness) then
        !!mdsGetProp(_thickness,_pThickness,'PTHK',!bore,!type)
          handle any
          endhandle
      endif
    elsehandle any
    endhandle

  !x = (prop FWID)
    handle none
      if defined(_thickness) then
        if _thickness.val.eq(0) then
          !!mdsGetProp(_thickness,_pThickness,'FWID',!bore,!type)
            handle any
            endhandle
        endif
      endif
    elsehandle any
    endhandle

  !!mdsGetProp(_case,_case,'CHEI',!bore,!type)
    handle any
    endhandle

  !!mdsGetProp(_caseDia,_caseDia,'CDIA',!bore,!type)
    handle any
    endhandle

  !!mdsGetProp(_squa,_squa,'SQUA',!bore,!type)
    handle any
    endhandle

  !!mdsGetProp(_caseLen,_caseLen,'CLEN',!bore,!type)
    handle any
    endhandle

  !!mdsGetProp(_houWid,_houWid,'HWID',!bore,!type)
    handle any
    endhandle

  !!mdsGetProp(_houThk,_houThk,'HTHK',!bore,!type)
    handle any
    endhandle

  !!mdsGetProp(_arm,_arm,'ARM',!bore,!type)
    handle any
    endhandle

  !!mdsGetProp(_houDep,_houDep,'HDEP',!bore,!type)
    handle any
    endhandle

  !!mdsGetProp(_centreL,_centreL,'CENL',!bore,!type)
    handle any
    endhandle

  !!mdsGetProp(_houLen,_houLen,'HLEN',!bore,!type)
    handle any
    endhandle

  !!mdsGetProp(_clearance,_pClearance,'CLR',!bore,!type)
    handle any
    endhandle

  !!mdsGetProp(_overlap,_pOverlap,'CLR',!bore,!type)
    handle any
    endhandle
  !!mdsGetProp(_overlap,_pOverlap,'OVER',!bore,!type)
    handle any
    endhandle

  !!mdsGetProp(_rodCl,_pRodCl,'SDIS',!bore,!type)
    handle any
    endhandle

  !unusedTest = (prop CLR)
  handle ANY
    !!mdsGetProp(_overlap,_pOverlap,'OVER',!bore,!type)
      handle any
      endhandle
  elsehandle NONE
  endhandle

  !!mdsGetProp(_angle,_pAngle,'WSIZ',!bore,!type)
    handle any
    endhandle

  !!mdsGetProp(_angle,_pAngle,'ADEG',!bore,!type)
    handle any
    endhandle

-- If the shoe has a guide attached to it we may have to update the guide
-- design parameters

  !!mdsResetGuide()

  !!mdsDacControl(true)

  !!ce = !atta

-- ditto for slip units

  if(!atta.:MDSGuideRef.badref().not() and !atta.:MDSGuideRef.neq(Nulref) and !atta.:MDSGuideRef.catref.owner.:MDSType.eq('SLIP')) then
    -- if(not (!atta.:MDSSuppType inset('SU01','SU02','SU03','SU04','SP01'))) then
--<wd>feb2003
    if ((!atta.:MDSGuideRef.sType.matchwild('AT40*').not()) and (!atta.:MDSGuideRef.sType.matchwild('AT41*').not()) ) then
--<wd>feb2003
      !slip = object FORM()
      !!mdsAlignSUnit(!slip)
    -- endif
      !!ce = !atta
--<wd>feb2003
    elseif (!atta.:MDSGuideRef.sType.matchwild('AT42').not()) then
      !slip = object FORM()
      !!mdsAlignSUnit(!slip)
      !!ce = !atta
    endif
--<wd>feb2003

  elseif(!atta.:MDSGuideRef.badref().not() and !atta.:MDSGuideRef.neq(Nulref) and !atta.:MDSGuideRef.sType inset('SP01')) then
    !offset = !atta.despar[1] + !atta.para[2] / 2
    !!ce = !atta.:MDSGuideRef
    despar n 5 $!offset
      handle any
      endhandle
    !!ce = !atta
  elseif(!atta.:MDSGuideRef.badref().not() and !atta.:MDSGuideRef.neq(Nulref) and !atta.:MDSGuideRef.sType inset('SP01A','SP03EA','SP03FA')) then
    !offset = !atta.despar[1] + !atta.despar[2]
    !!ce = !atta.:MDSGuideRef
    despar n 5 $!offset
      handle any
      endhandle
    !!ce = !atta
  endif

-- If we are setting the defaults of a guide we should goto the shoe and reset
-- the guide
  !shoe = !!ce.:MDSGuideRef

  /$!shoe
    handle any
    elsehandle none
      !!mdsResetGuide()
      !!ce = !atta
    endhandle

  $!shoe
    handle any
    elsehandle none
      !!mdsResetGuide()
      !!ce = !atta
    endhandle

-- If the type is a SP01 then it may be referenced to a show/reinforcing plate
-- If so reset the offset
  if !type.eq('SP01') then
    despar n5 $!offsetFromCL
  endif

-- If the standards height is controlled via the insulation then hide the height gadget
  if !type.match('AT25').gt(0) then
    _height.active = false
  endif

--<wd>nov2002
  if !type.match('AN06').gt(0) then
    _height.active = false
  endif
--<wd>nov2002

  if !!ce.sType inset('AT55A','AT55B','AT55C') and (!!ce.order + 1) lt !!ce.owner.members.size() then
-- check to see if the next atta is a type AT53A/B
    !nextSType = stype of next
    if !nextSType inset('AT53A','AT53B')then
-- modify the length to suit
      next
      !dpNum = !!mdsGetDesp('LEN')
      !!mdsSetDesPar(!!ce,!dpNum,_length.val.real())
      !!mdsDacControl(true)
      prev
      endif
  endif

  if !sType.eq('GT11') or !sType.eq('ST07') then
    !!mdsGetProp(_length,_pLength,'PLEN',!bore,!type)
    handle ANY
    endhandle
  endif

  !!mdsDacControl(false)

-- Reset Units
  !!kRestoreUnits(!currentUnits)

endfunction
