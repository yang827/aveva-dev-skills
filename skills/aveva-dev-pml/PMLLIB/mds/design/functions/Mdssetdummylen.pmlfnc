--
-- File:    Mdssetdummylen.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    Neale Morris
-- Created:   Thursday 12th February 1998
--
--
-- Description:
-- Function to set the length of a trunnion
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      Length
--     2     R         DIRECTION   Direction of trunnion
--     3     R         POSITION    Start Position
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Define Function
define function !!mdssetdummylen(!dummyID is STRING,!length is REAL,!dummyElement is DBREF,!dummyDir is STRING,!type is STRING,!form is FORM)

-- If the units are imperial convert !length to mm
  !!mdsDacControl(TRUE)

  !units = object COMUNITS(TRUE)

  !tLength = !length

-- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

-- Access the datum atta and goto branch
  !!ce = !form.support.datum
  branch
--  var !hBor ph bore
  goto href

  var !ll const dist p3 to p0

-- Overall length will be the !ll + the form value
-- Check min/max lengths
---------------------------------------------------------------------------------------------------
--<wd>apr2006<mds12>
  --!min = !!mdsPar$!form.support.type$n[$!hBor].minimum
  --!max = !!mdsPar$!form.support.type$n[$!hBor].maximum
-- CHECK if TRUNNION STANDARD Available for the MAIN PIPE Bore
    !xce    = !!ce

--><wd>09jun09 - DFN P-17079 - ERROR raised if PIPE BORE parameters are actual IMPERIAL bore sizes, e.g. 152.4mm = 6in and NOT 150mm
--    !mBore  = !!ce.lbore.real()
    !mBore  = !!ce.lbore.string().lowcase().before('mm').real().value()
--<<wd>09jun09 - DFN P-17079

    !mdsStd = !type
    !mdsTrunObj  = object MDSREADTRUNDATA()
    !mdsTrunData = !mdsTrunObj.mdsTrunData(!mdsStd, !mBore)

      if (!mdsTrunData.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
      if (!mdsTrunObj.mdsStd.sactive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
        !errormessage = !mdsTrunObj.mdsStd.smess
      elseif (!mdsTrunObj.mdsStd.cactive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
        !errormessage = !mdsTrunObj.mdsStd.cmess
      endif

      !!kRestoreUnits(!currentUnits)
      !!alert.error(!errormessage)
      !form.bore.clear()
      !form.mainbore.val = 'Main Bore'
      !form.tLength.val = 0
      !!kRestoreUnits(!currentUnits)
      return

    else
-- Determine the Trunnion MINIMUM and MAXIMUM Lengths
      !min = !mdsTrunObj.minlength
      !max = !mdsTrunObj.maxlength

    endif

    !!ce = !xce
--<wd>apr2006<mds12>
---------------------------------------------------------------------------------------------------

  if !tLength.gt(!max) then
    !sLength = !tLength.string(!!distanceFMT)
    !tCurrentUnits = !!kGetSetUnits()
    !mLength = !max.string(!!distanceFMT)
    !!alert.error(|Length of $!sLength is more than the maximum allowed. Setting length to maximum of $!mLength|)
    !form.tLength.val = !max.real()
  endif

  if !tLength.lt(!min) then
    !sLength = !tLength.string(!!distanceFMT)
    !tCurrentUnits = !!kGetSetUnits()
    !mLength = !min.string(!!distanceFMT)
    !!alert.error(|Length of $!sLength is less than the minimum allowed. Setting length to minimum of $!mLength|)
    !form.tLength.val = !min.real()
  endif

---------------------------------------------------------------------------------------------------
--<wd>apr2006<mds12>
-- ENSURE the TRUNNION BRANCH is the CURRENT Element by FIRST Navigating to the TRUNNION DATUM ATTA
  --same
  !!ce = !form.support.datum
  branch
--<wd>apr2006<mds12>
---------------------------------------------------------------------------------------------------

  !overallLength = !ll.real() + !form.tLength.val

  last mem
  pos pl dist $!overallLength from ph
  prev
  conn to next
    handle (7,3)
      fconn to next
    endhandle
  bran
  conn pt to last mem
  tcon CLOS

-- Despar 5 stores the branch length so reset it except TT17 which is 3
--<wd>03aug2004 -- Despar 3 also applies to TT32
  $!form.support.datum.name$n/SREF
--  if !form.support.type.eq('TT17') then
  if !form.support.type inset ('TT17','TT32') then
--<wd>03aug2004
    despar n3 $!form.tLength.val
  else
    despar n5 $!form.tLength.val
  endif

  bran

  !!kRestoreUnits(!currentUnits)

endfunction
-- End function
