--
-- File:		Mdssetformname.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          USETNAME
--
-- Author:		I.Osborne
-- Created:		Thu May 01
--
--
-- Description:
-- Modify form name title
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM       Name of form who's title is to change
--     2     R         STRING      Support type
--     3     R         STRING      Users replacement name for support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetFormName(!Form is FORM, !Type is STRING, !Name is STRING)

-- Because a replacement name could have a - in it we can use the !!code(type) variable to set the
-- form title

  !SupportType = !Form.Support.Type
   handle ANY
--<wd>17may2004
    if (!form.name().upcase().matchwild('*CONFIG*')) then
-- MDS Framework Config Form Does NOT have a SUPPORT object member, so get the MAIN FORM Support Object
      !fnam  = !form.name().upcase().before('CONFIG')
      !nfnam = '!!' & !fnam
      !supporttype = $!<nfnam>.support.type
    else
      !!alert.error('$!!error.text - ABORTING Creation of Support')
      return
    endif
  endhandle
--<wd>17may2004

--------------------
--<wd>jan2007<mds12>
-- Determine the MDS Support DEFAULT Type for the MDS12 DEFAULT DATASETS stored in PARAGON
--
-- MDS STRUCTURE PARAGON DEFAULT DATASETS
  if (!type.upcase() eq 'PIPE') then
-- MDS Framework
    !mdsdeftype = 'STRUCTURE'
  elseif (!type.upcase() eq 'TRAY') then
-- MDS Cable Rack Framework Support
    !mdsdeftype = 'STRUCTURE'
  elseif (!type.upcase() eq 'HVAC') then
-- MDS HVAC Framework Support
    !mdsdeftype = 'STRUCTURE'
  elseif (!type.upcase() eq 'SPECIAL') then
--  MDS Special FrameworkSupport
    !mdsdeftype = 'STRUCTURE'

-- MDS ATTA PARAGON DEFAULT DATASETS
  elseif (!type.upcase() eq 'GENERAL') then
-- MDS General Ancillary
    !mdsdeftype = 'ATTA'
  elseif (!type.upcase() eq 'ANCHOR') then
-- MDS Ancillary Anchor
    !mdsdeftype = 'ATTA'
  elseif (!type.upcase() eq 'GUIDE') then
-- MDS Ancillary Guide
    !mdsdeftype = 'ATTA'

--<wd>feb2007<mds12>
--q var !form.name()
    if (!form.name().matchwild('*GT05*')) or (!form.name().matchwild('*GT09*')) or (!form.name().matchwild('*GT10*')) then
      !mdsdeftype = 'STRUCTURE'
    endif
--<wd>feb2007<mds12>


  elseif (!type.upcase() eq 'SLIP') then
-- MDS Ancillary Slip
    !mdsdeftype = 'ATTA'
  elseif (!type.upcase() eq 'SHIM') then
-- MDS Ancillary Shim
    !mdsdeftype = 'ATTA'
  elseif (!type.upcase() eq 'SPRING') then
-- MDS Ancillary Spring
    !mdsdeftype = 'ATTA'
  elseif (!type.upcase() eq 'STOP') then
-- MDS Ancillary Stop
    !mdsdeftype = 'ATTA'

-- MDS HANGER PARAGON DEFAULT DATASETS
  elseif (!type.upcase() eq 'HANGER') then
-- MDS Hanger
    !mdsdeftype = 'HANGER'
  elseif (!type.upcase() eq 'FIXED HANGER') then
-- MDS Fixed Hanger
    !mdsdeftype = 'HANGER'
  elseif (!type.upcase() eq 'VARIABLE HANGER') then
--MDS Variable Hanger
    !mdsdeftype = 'HANGER'

-- MDS TRUNNION PARAGON DEFAULT DATASETS
  elseif (!type.upcase() eq 'TRUNNION') then
-- MDS Trunnion Type|
    !mdsdeftype = 'TRUNNION'
  elseif (!type.upcase() eq 'BASE SUPPORT') then
-- MDS Base Support|
    !mdsdeftype = 'TRUNNION'

-- MDS PRELIMINARY PARAGON DEFAULT DATASETS
  elseif (!type.upcase() eq 'PRELIMSUPP') then
-- MDS Preliminary Support
    !mdsdeftype = 'PRELIMINARY'

  endif

-- Determine the Client Code from the the MDS12 DEFAULT DATASETS stored in PARAGON
  !supportType = !supportType.replace('-','').upCase()
--  !CodeVar = '!!CODE' + !SupportType

  !codevar = !!mdsgetdefprop(!mdsdeftype, !supportType , 'CCOD')

--
--<wd>jan2007<mds12>
--------------------

  if !SupportType.eq('SPECIAL') then
    !NewName = 'SPECIAL'
  else

--<wd>jan2007<mds12>
--    !NewName = $!CodeVar
    !NewName = '$!CodeVar'
--<wd>jan2007<mds12>
      handle (2,751)
        !NewName = ''
      endhandle
  endif
  if !NewName.eq('') then
    !NewName = !Name
  endif

-- If errors were found with the !!MDSErrors form then we need to deactivate the cancel gadget

  if !!MdsErrors.disablecancel then
    !Form.cancel.active = false
    !!MdsErrors.disablecancel = false
  endif

  -- !SizeRange = !!MdsGetSizeRange(!Form)
--$P xxxxxxxxxxxxx
--q var !newname
--$P xxxxxxxxxxxxx
  if (!type.upcase() eq 'PIPE') then
    !Form.formtitle = |$!NewName - MDS Framework|
  elseif (!type.upcase() eq 'TRAY') then
    !Form.formtitle = |$!NewName - Cable Rack Support|
  elseif (!type.upcase() eq 'HVAC') then
    !Form.formtitle = |$!NewName - HVAC Support|
  elseif (!type.upcase() eq 'GENERAL') then
    !Form.formtitle = |$!NewName - General Ancillary|
  elseif (!type.upcase() eq 'ANCHOR') then
    !Form.formtitle = |$!NewName - Anchor|
  elseif (!type.upcase() eq 'HANGER') then
    !Form.formtitle = |$!NewName - Hanger|
  elseif (!type.upcase() eq 'FIXED HANGER') then
    !Form.formtitle = |$!NewName - Fixed Hanger|
  elseif (!type.upcase() eq 'VARIABLE HANGER') then
    !Form.formtitle = |$!NewName - Variable Hanger|
  elseif (!type.upcase() eq 'GUIDE') then
    !Form.formtitle = |$!NewName - Guide|
  elseif (!type.upcase() eq 'SLIP') then
    !Form.formtitle = |$!NewName - Slip|
  elseif (!type.upcase() eq 'SHIM') then
    !Form.formtitle = |$!NewName - Shim|
  elseif (!type.upcase() eq 'SPRING') then
    !Form.formtitle = |$!NewName - Spring|
  elseif (!type.upcase() eq 'STOP') then
    !Form.formtitle = |$!NewName - Stop|
  elseif (!type.upcase() eq 'TRUNNION') then
    !form.formtitle = |$!NewName - Trunnion Type|
  elseif (!type.upcase() eq 'BASE SUPPORT') then
    !form.formtitle = |$!NewName - Base Support|
  elseif (!type.upcase() eq 'SPECIAL') then
    !form.formtitle = |Special Support|
  elseif (!type.upcase() eq 'PRELIMSUPP') then
    !form.formtitle = |$!NewName - Preliminary|
  endif

-- This is called by all standards, call a project specific function to set
-- user attributes if it exists, it must be in %[project]dflts called
-- MdsUserData.pmldat and is called with the form as an argument

  var !ProjectCode proj code
  $M/%$!ProjectCode$ndflts%/MdsUserData.pmldat
   handle ANY
   endhandle

-- End function
endfunction

-- End of file Mdssetformname.pmlfnc
