-- Description:
-- Set frame configuration for frame type 04
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetFt04Con(!Number is REAL)

  -- Set configuration in form
    !!MdsFt04.Support.config = !Number

  -- Call create function
    -- Call !!MdsCreateFt04(!!MdsFt04.Create.selection('Rtext'))
    Call !!MdsCreateFt04(!!MdsFt04.Method)

-- End function
endfunction

