-- Description:
-- Set frame configuration for frame type 18
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetFt18Con(!Number is REAL)

  -- Set configuration in form
    !!MdsFt18.Support.config = !Number

  -- Call create function
    -- Call !!MdsCreateFt18(!!MdsFt18.Create.selection('Rtext'))
    Call !!MdsCreateFt18(!!MdsFt18.Method)

-- End function
endfunction

