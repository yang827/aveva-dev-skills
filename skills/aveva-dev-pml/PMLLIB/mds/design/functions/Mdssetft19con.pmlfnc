-- Description:
-- Set frame configuration for frame type 19
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetFt19Con(!Number is REAL)

  -- Set configuration in form
    !!MdsFt19.Support.config = !Number

  -- Call create function
    -- Call !!MdsCreateFt19(!!MdsFt19.Create.selection('Rtext'))
    Call !!MdsCreateFt19(!!MdsFt19.Method)

-- End function
endfunction

