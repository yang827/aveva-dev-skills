--------------------------------------------------------------------------------
--
-- File:    Mdssetgadgets.pmlfnc
--   Type:    Function Definition
--   Group:    Multi Discipline Supports Application
--     Keyword:    MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.Morris
-- Created:    Tue Oct 28
--
--
-- Description:
-- Macro to set the 'at' global form with the current design parameters
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetGadgets(!form is FORM,!atta is DBREF,!alias is STRING)

  !!ce = !atta
  !currentUnits = !!kGetSetUnits()
  if (!!ce.type.eq('CTSUPP')) then
    !bore = !!ce.ppbor[1]
  else
    !bore = pa bore
  endif
  !type = !alias

  --------------------------------------------------------------------------------
  -- Inactivate '!!mdsmodat.setSteel' if Initialised from !!mdsvt03
  if (!form eq !!mdsvt03) then
    !!mdsmodat.setSteel.active = false
    return
  endif

  -- Inactivate '!!mdsmodat.setSteel' if Initialised from !!mdsST20
  --<wd>jan2004
  --    if (!form eq !!mdsST20) then
  if (!form eq !!mdsST01) then
    --      !!mdsST20.setSteel.active = false
    --      !!mdsST20.pHeight.active = false
    --      !!mdsST20.height.active = FALSE
    if (!form.support.alias eq 'ST20') then
      !!mdsST01.setSteel.active = false
      !!mdsST01.pHeight.active = false
      !!mdsST01.height.active = FALSE
      return
    endif
    --<wd>jan2004
  endif

  --------------------------------------------------------------------------------

  if (!type inset('GT04','SP03')) then
    !type = !!ce.styp
  endif

  -- Clear and deactivate all gadgets before trying to set them

  !list = ARRAY()


  !list.append(!form.height)
  handle any
  endhandle
  !list.append(!form.length)
  handle any
  endhandle
  !list.append(!form.thickness)
  handle any
  endhandle
  !list.append(!form.case)
  handle any
  endhandle
  !list.append(!form.caseDia)
  handle any
  endhandle
  !list.append(!form.squa)
  handle any
  endhandle
  !list.append(!form.rod)
  handle any
  endhandle
  !list.append(!form.topRod)
  handle any
  endhandle
  !list.append(!form.clearance)
  handle any
  endhandle
  !list.append(!form.rodCl)
  handle any
  endhandle
  !list.append(!form.caseLen)
  handle any
  endhandle
  !list.append(!form.houWid)
  handle any
  endhandle
  !list.append(!form.houThk)
  handle any
  endhandle
  !list.append(!form.houDep)
  handle any
  endhandle
  !list.append(!form.houLen)
  handle any
  endhandle
  !list.append(!form.arm)
  handle any
  endhandle
  !list.append(!form.centreL)
  handle any
  endhandle
  !list.append(!form.angle)
  handle any
  endhandle

  do !clear values !list
    !clear.active = false
    handle any
    endhandle
    !clear.val = 0
    handle any
      !clear.val = '0'
      handle any
      endhandle
    endhandle
  enddo

  -- Heights

  !!mdsGetProp(!form.height,!form.height,'HEIG',!bore,!type)
  handle any
  endhandle

  --<dw>mar2009 dun1119 To account for height of stop
  if (defined(!form.height)) then
    if (!form.height.val.eq(0)) then
      !!mdsGetProp(!form.height,!form.pHeight,'STLH',!bore,!type)
      handle any
      endhandle
    endif
  endif
  if (defined(!form.boltedlen)) then
    if (!form.boltedlen.val.eq(0)) then
      !!mdsGetProp(!form.boltedlen,!form.pboltedlen,'WID',!bore,!type)
      handle any
      endhandle
    endif
  endif
  --<dw>mar2009 dun1119 End accounting for height of stop

  if (defined(!form.height)) then
    if (!form.height.val.eq(0)) then
      !!mdsGetProp(!form.height,!form.pHeight,'HEI',!bore,!type)
      handle any
      endhandle
    endif
  endif

  if (defined(!form.height)) then
    if (!form.height.val.eq(0)) then
      !!mdsGetProp(!form.height,!form.pHeight,'PWID',!bore,!type)
      handle any
      endhandle
    endif
  endif

  if (defined(!form.height)) then
    if (!form.height.val.eq(0)) then
      !!mdsGetProp(!form.height,!form.pHeight,'FHEI',!bore,!type)
      handle any
      endhandle
    endif
  endif

  -- Lengths

  !!mdsGetProp(!form.length,!form.pLength,'PLEN',!bore,!type)
  handle any
  endhandle

  if (defined(!form.length)) then
    if (!form.length.val.eq(0)) then
      !!mdsGetProp(!form.length,!form.pLength,'LEN',!bore,!type)
      handle any
      endhandle
    endif
  endif

  if (!type.neq('AT70') and !type.neq('AT71') and !type.neq('AT62') and  !type.neq('AT69')) then
    if (defined(!form.length)) then
      if (!form.length.val.eq(0)) then
        !!mdsGetProp(!form.length,!form.pLength,'GDEP',!bore,!type)
        handle any
        endhandle
      endif
    endif
  endif

  -- Thickness

  !x = (prop THK)
  handle none
    !!mdsGetProp(!form.thickness,!form.pThickness,'THK',!bore,!type)
    handle any
    endhandle
  elsehandle any
  endhandle

  !x = (prop PTHK)
  handle none
    if (defined(!form.thickness)) then
      if (!form.thickness.val.eq(0)) then
        !!mdsGetProp(!form.thickness,!form.pThickness,'PTHK',!bore,!type)
        handle any
        endhandle
      endif
    endif
  elsehandle any
  endhandle

  !x = (prop FWID)
  handle none
    if (defined(!form.thickness)) then
      if (!form.thickness.val.eq(0)) then
        !!mdsGetProp(!form.thickness,!form.pThickness,'FWID',!bore,!type)
        handle any
        endhandle
      endif
    endif
  elsehandle any
  endhandle

  !!mdsGetProp(!form.case,!form.case,'CHEI',!bore,!type)
  handle any
  endhandle
  !!mdsGetProp(!form.caseDia,!form.caseDia,'CDIA',!bore,!type)
  handle any
  endhandle
  !!mdsGetProp(!form.squa,!form.squa,'SQUA',!bore,!type)
  handle any
  endhandle
  !!mdsGetProp(!form.rod,!form.rod,'RODD',!bore,!type)
  handle any
  endhandle
  !!mdsGetProp(!form.topRod,!form.topRod,'RODL',!bore,!type)
  handle any
  endhandle
  !!mdsGetProp(!form.clearance,!form.pClearance,'CLR',!bore,!type)
  handle any
  endhandle
  !!mdsGetProp(!form.extra,!form.pExtra,'ECLR',!bore,!type)
  handle any
  endhandle
  !!mdsGetProp(!form.rodCl,!form.pRodCl,'SDIS',!bore,!type)
  handle any
  endhandle
  -- sp03
  !!mdsGetProp(!form.caseLen,!form.caseLen,'CLEN',!bore,!type)
  handle any
  endhandle
  !!mdsGetProp(!form.houWid,!form.houWid,'HWID',!bore,!type)
  handle any
  endhandle
  !!mdsGetProp(!form.houThk,!form.houThk,'HTHK',!bore,!type)
  handle any
  endhandle
  !!mdsGetProp(!form.houDep,!form.houDep,'HDEP',!bore,!type)
  handle any
  endhandle
  !!mdsGetProp(!form.houLen,!form.houLen,'HLEN',!bore,!type)
  handle any
  endhandle
  !!mdsGetProp(!form.arm,!form.arm,'ARM',!bore,!type)
  handle any
  endhandle
  !!mdsGetProp(!form.centreL,!form.centreL,'CENL',!bore,!type)
  handle any
  endhandle
  !!mdsGetProp(!form.angle,!form.angle,'WSIZ',!bore,!type)
  handle any
  endhandle
  !!mdsGetProp(!form.angle,!form.angle,'ADEG',!bore,!type)
  handle any
  endhandle

  !!kRestoreUnits(!currentUnits)

  if (!alias inset('BT01A','BT01B','BT02','BT03')) then
    -- Buttons
    -- !form.setSteel.active = false
    -- !form.setDefault.active = false
  elseif (!alias inset('AT05','AT09','LT01A','LT01B','LT01C')) then
    -- Buttons
    -- !form.setSteel.active = false
    -- !form.setDefault.active = true
  elseif ((!alias eq 'PIPE-REST') or (!alias eq 'PIPE-REST-INLINE')) then
    -- Buttons
    -- !form.setSteel.active = false
    -- !form.setDefault.active = false
  elseif (!alias inset('GT01','GT02','GT03','GT04','GT06','GT07','GT20','GT21')) then
    -- !form.setDefault.active = true
  elseif (!alias inset('SU01','SU02','SU03','SU04')) then
    --> Modified -<wd>-23sep1998
    --xxx      !form.setDefault.active = true
    --< Modified -<wd>-23sep1998
    !form.align.active = TRUE
    handle ANY
      --<wd>jan2004
    endhandle
  else
    --> Modified -<wd>-23sep1998
    -- Check if Form is a VESSEL Type Support
    if (!form.name().matchwild('*VT0*').not()) then
      -- Buttons
      -- !form.setSteel.active = true
      handle any
      endhandle
      -- !form.setDefault.active = true
    endif
    --< Modified -<wd>-23sep1998
  endif

endfunction
