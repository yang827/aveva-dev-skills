--
-- File:		Mdssetguiddir.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Tue Oct 28
--
--
-- Description:
-- Function to set the correct styp for the guide direction selected
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetGuideDir(!Mode is STRING)

  -- Initialise variables
    !Datum = !!MdsGt04.Support.Datum

  -- Find last character of styp from pedestal reference

    if (!Mode.upcase() eq 'NEW') then

      !Styp = styp

      !Length = !Styp.length()
      !SubLeng = !Length.real() - 2
      !LastChar = !Styp.substring($!Length)
      !TypePed = !Styp.substring($!SubLeng,2)
      if (!TypePed eq '10') then
        !Type = 'A'
      else
        !Type = 'B'
      endif

      if (!!MdsGT04.GuideDir.Selection('DTEXT').trim() eq 'Both Directions') then
        !Option = '3'
      else
        !Option = '4'
      endif

      if (!Option eq '3' and !Lastchar eq 'A') then
        !Config = 'A'
      elseif (!Option eq '3' and !Lastchar eq 'B') then
        !Config = 'B'
      endif

      if (!Option eq '4' and !Lastchar eq 'A' and !!MdsGT04.GuideDir.Selection('DTEXT').trim() eq 'With Flow') then
        !Config = 'A'
      elseif (!Option eq '4' and !Lastchar eq 'A' and !!MdsGT04.GuideDir.Selection('DTEXT').trim() eq 'Parallel to Flow') then
        !Config = 'B'
      elseif (!Option eq '4' and !Lastchar eq 'B' and !!MdsGT04.GuideDir.Selection('DTEXT').trim() eq 'With Flow') then
        !Config = 'C'
      elseif (!Option eq '4' and !Lastchar eq 'B' and !!MdsGT04.GuideDir.Selection('DTEXT').trim() eq 'Parallel to Flow') then
        !Config = 'D'
      endif

      !NewStyp = 'GT04' + !Type + !Option + !Config
      !!CE = !Datum
      sel with styp '$!NewStyp' SPEC /MDS

  elseif (!Mode.upcase() eq 'MODI') then

      !!CE = !Datum

      -- Find last char of :MDSGuideRef for type

      !Styp = !!CE.:MDSGuideRef.styp

      !Length = !Styp.length()
      !SubLeng = !Length.real() - 2
      !LastChar = !Styp.substring($!Length)
      !TypePed = !Styp.substring($!SubLeng,2)
      if (!TypePed eq '10') then
        !Type = 'A'
      else
        !Type = 'B'
      endif

      if (!!MdsGT04.GuideDir.Selection('DTEXT').trim() eq 'Both Directions') then
        !Option = '3'
      else
        !Option = '4'
      endif

      if (!Option eq '3' and !Lastchar eq 'A') then
        !Config = 'A'
      elseif (!Option eq '3' and !Lastchar eq 'B') then
        !Config = 'B'
      endif

      if (!Option eq '4' and !Lastchar eq 'A' and !!MdsGT04.GuideDir.Selection('DTEXT').trim() eq 'With Flow') then
        !Config = 'A'
      elseif (!Option eq '4' and !Lastchar eq 'A' and !!MdsGT04.GuideDir.Selection('DTEXT').trim() eq 'Parallel to Flow') then
        !Config = 'B'
      elseif (!Option eq '4' and !Lastchar eq 'B' and !!MdsGT04.GuideDir.Selection('DTEXT').trim() eq 'With Flow') then
        !Config = 'C'
      elseif (!Option eq '4' and !Lastchar eq 'B' and !!MdsGT04.GuideDir.Selection('DTEXT').trim() eq 'Parallel to Flow') then
        !Config = 'D'
      else
        !Config = !Lastchar
      endif

      !NewStyp = 'GT04' + !Type + !Option + !Config
      sel with styp '$!NewStyp' SPEC /MDS

--> Modified -<wd>-12oct1998
-- Orientate 'With Flow' or 'Parallel to Flow' for Guides on
-- Elbo Pedestals Only - 'AT10A' and 'AT11A'
      !!ce  = !datum
      !ldir = ldir wrt /*

      if (!!ce.:MDSGuideRef.styp.upcase().eq('AT10A') or !!ce.:MDSGuideRef.styp.upcase().eq('AT11A')) then
        if (!ldir.eq(U WRT /* )) then
          !oridir = adir of prev elbo wrt /*
        else
          !oridir = ldir of next elbo wrt /*
        endif
        ori Y is D wrt /* and Z is $!oridir
      endif


--< Modified -<wd>-12oct1998

    else

      !!CE = !Datum
      !Styp = !!CE.styp
      !Strip = !Styp.substring(5)
      !First = !Strip.substring(1,1)
      !Second = !Strip.substring(2,1)
      !Third = !Strip.substring(3,1)

      if (!First eq 'A' and !Second eq '4' and !Third eq 'A') then
        !!MdsGt04.GuideDir.Select('Dtext','With Flow')
      elseif (!First eq 'A' and !Second eq '4' and !Third eq 'B') then
        !!MdsGt04.GuideDir.Select('Dtext','Parallel to Flow')
      elseif (!First eq 'A' and !Second eq '4' and !Third eq 'C') then
        !!MdsGt04.GuideDir.Select('Dtext','With Flow')
      elseif (!First eq 'A' and !Second eq '4' and !Third eq 'D') then
        !!MdsGt04.GuideDir.Select('Dtext','Parallel to Flow')
      elseif (!First eq 'A' and !Second eq '3' and !Third eq 'A') then
        !!MdsGt04.GuideDir.Select('Dtext','Both Directions')
      elseif (!First eq 'A' and !Second eq '3' and !Third eq 'B') then
        !!MdsGt04.GuideDir.Select('Dtext','Both Directions')
      elseif (!First eq 'B' and !Second eq '4' and !Third eq 'A') then
        !!MdsGt04.GuideDir.Select('Dtext','With Flow')
      elseif (!First eq 'B' and !Second eq '4' and !Third eq 'B') then
        !!MdsGt04.GuideDir.Select('Dtext','Parallel to Flow')
      elseif (!First eq 'B' and !Second eq '4' and !Third eq 'C') then
        !!MdsGt04.GuideDir.Select('Dtext','With Flow')
      elseif (!First eq 'B' and !Second eq '4' and !Third eq 'D') then
        !!MdsGt04.GuideDir.Select('Dtext','Parallel to Flow')
      elseif (!First eq 'B' and !Second eq '3' and !Third eq 'A') then
        !!MdsGt04.GuideDir.Select('Dtext','Both Directions')
      elseif (!First eq 'B' and !Second eq '3' and !Third eq 'B') then
        !!MdsGt04.GuideDir.Select('Dtext','Both Directions')
      endif

    endif



-- End function
endfunction

-- End of file MdssetdatGt04.pml
