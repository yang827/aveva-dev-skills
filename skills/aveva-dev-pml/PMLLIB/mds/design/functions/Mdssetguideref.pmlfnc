--
-- File:		Mdssetguideref.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 10th September 1998
--
--
-- Description:
-- Function to  set the UDA ':MDSGuideRef' at the GUIDE and ASSOCIATED Support ATTA
-- for Uninsulated Pipes, if BOTH Attas are in the SAME Position
-- (Currently ONLY for Guide Type 'GT02')
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        MdsSUPPORT   Support Object
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdssetguideref (!support is MdsSUPPORT)

-- Get Position of the Guide Datum Atta
    !datpos = !support.datum.pos.wrt(world)
    !origin = !!ce

-- Get Position of Previous Atta on the Branch
    !prepos = pos of prev atta wrt world
    handle (2,113) $* List Exhausted
      !prepos = e0n0u0 wrt /*
    elsehandle none
-- Check if Previous Atta is a Support Atta
      !prespr = spre of prev atta
      !preatt = prev atta
-- ge 25/11/04 Fix for GT16/17 Test to see if !prespr is set
     if !prespr.set() then
      if (!prespr.name.match('/MDS').eq(0)) then
        !prepos = e0n0u0 wrt /*
      endif
     endif
    endhandle

-- Get Position of Next Atta on the Branch
    !nexpos = pos of next atta wrt world
    handle (2,113) $* List Exhausted
      !nexpos = e0n0u0 wrt /*
    elsehandle none
-- Check if Next Atta is a Support Atta
      !nexspr = spre of next atta
      !nexatt = next atta
      if (!nexspr.name.match('/MDS').eq(0)) then
        !nexpos = e0n0u0 wrt /*
      endif
    endhandle

-- Check if the Guide DATUM Atta is in the SAME Position
-- as the PREVIOUS or NEXT Support Atta of the Branch
-- Set the UDA ':MDSGuideRef' at the DATUM and the PREVIOUS/NEXT Attas to Reference EACH other.
    if (!datpos.eq(!prepos)) then
      !!ce = !support.datum
      :MDSGuideRef $!preatt
        handle ANY
          claim ce
          :MDSGuideRef $!preatt
        elsehandle NONE
        endhandle
      !!ce = !preatt
      :MDSGuideRef $!support.datum
        handle ANY
          claim ce
          :MDSGuideRef $!support.datum
        elsehandle NONE
        endhandle
    elseif (!datpos.eq(!nexpos)) then
      !!ce = !support.datum
      :MDSGuideRef $!nexatt
        handle ANY
          claim ce
          :MDSGuideRef $!nexatt
        elsehandle NONE
        endhandle
      !!ce = !nexatt
      :MDSGuideRef $!support.datum
        handle ANY
          claim ce
          :MDSGuideRef $!support.datum
        elsehandle NONE
        endhandle
    endif

-- Navigate to Original Element
    !!ce = !origin

  endfunction
-- End function

-- End of file Mdssetguideref.pml
