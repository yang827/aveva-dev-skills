--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetHang(!Option is STRING)

    !hangertype = !!Mdsft16.hanger.selection('RTEXT')

    -- First select the correct styp to select for the relevant type
    -- HT05A should be HT05-A-A
    -- HT05B should be HT05-B-A
    -- HT06A should be HT06-A-A
    -- HT06B should be HT06-B-A
    -- HT09  should be HT09-A
    -- HT010 should be HT010-A

    if !Option.eq('MODIFY') then
      !String = ''
      !!CE = !!MdsFT16.support.datum
    else
      !String = 'NEW ATTA'
    endif

    if !Hangertype.eq('HT05A') then
      $!String SEL SPREF WITH STYP 'HT05-A-A' SPEC /MDS
    elseif !Hangertype.eq('HT06A') then
      $!String SEL SPREF WITH STYP 'HT06-A-A' SPEC /MDS
    elseif !Hangertype.eq('HT05B') then
      $!String SEL SPREF WITH STYP 'HT05-B-A' SPEC /MDS
    elseif !Hangertype.eq('HT06B') then
      $!String SEL SPREF WITH STYP 'HT06-B-A' SPEC /MDS
    else
      $!String SEL SPREF WITH STYP '$!hangertype-A' SPEC /MDS
    endif

-- If the cross bar exists then reset the height

    !BarName = !!Mdsft16.Support.Stru.name + '-BAR-1'

    !!CE = !BarName.dbref()
      handle none
        !!MdsModHangFt16(!!Mdsft16.Support.Stru,!!MdsFt16.Support.Datum)
      elsehandle any
      endhandle

endfunction
