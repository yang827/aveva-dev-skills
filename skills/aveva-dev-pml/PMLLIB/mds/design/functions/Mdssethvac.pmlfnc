--
-- File:      Mdssethvac.pmlfnc
-- Type:      Function Definition
-- Group:     Multi Discipline Supports Application
-- Keyword:   MDS
-- Module:    design
-- Replaces:
--
-- Author:    N.morris
-- Created:   Fri Dec 5 1997
--
--
-- Description:
-- function to set the correct design parameters for the HVAC Rest Support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          DBREF      Element to read conn and despars
--     2     R          DBREF      Element to write despars to
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetHvac(!readHVAC is DBREF, !writeHVAC is DBREF)

  !currentunits = !!kgetsetunits()

  !!ce = !readHVAC
  !conn = pa conn
  var !insu insu

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
--<wd>march2003
-- PREVIOUSLY -
-- INCORRECTLY - ONLY a SINGLE Insulation Thickness was being ADDED to the HVAC Ducting Size(s)
--
-- MODIFIED NOW so that -
-- CORRECTLY - TWICE the Insulation Thickness is being ADDED to the HVAC Ducting Size(s)
--<wd>march2003
-------------------------------------------------------------------------------
-------------------------------------------------------------------------------

  if (!conn eq |HVAC|) then
-- KJB Circ Duct type
    !radius = DESPAR[1]
--<wd>march2003
    --!dpar1 = !radius + !insu.real()
    !dpar1 = !radius + (2 * !insu.real())
--<wd>march2003
    !dpar2 = !dpar1
    !dpar3 = 0
  elseif (!conn eq |HVAR|) then
-- KJB Rect Duct type
    !width  = DESPAR[1]
    !height = DESPAR[2]
--<wd>march2003
    --!dpar1  = !width + !insu.real()
    --!dpar2  = !height + !insu.real()
    !dpar1 = !width + (2 * !insu.real())
    !dpar2 = !height + (2 * !insu.real())
    --<wd>march2003
    !dpar3  = 0.5 * !dpar2
  elseif (!conn eq |RECT|) then
-- AVEVA Rect Duct type
    !width = DESPAR[2]
    !height = DESPAR[3]
--<wd>march2003
    --!dpar1 = !width + !insu.real()
    --!dpar2 = !height + !insu.real()
    --!dpar1 = !width + (2 * !insu.real())
    --!dpar2 = !height + (2 * !insu.real())
    !dpar1 = !width
    !dpar2 = !height
    --<wd>march2003
    !dpar3 = 0
      pin 1 copy p61
      pin 2 copy p62
      pin 3 copy p63
      pin 4 copy p64

      pin 1 dir from p61 to p62
    var !pin1Dir pin 1 dir
    if !pin1Dir.eq('U') or !pin1Dir.eq('D') or !pin1Dir.eq('Z') or !pin1Dir.eq('-Z') then
      --!dpar1 = !height + (2 * !insu.real())
      --!dpar2 = !width + (2 * !insu.real())
      !dpar1 = !height
      !dpar2 = !width
    endif

    --check that the calculated width of this section is the same (within tolerance) as the despar width
      var !check const dist p61 to p62
    !tolerance = 0.01
    !testEqual = !dpar1 - !check.real()
    if !testEqual.abs().geq(!tolerance) then
      --swap the height and width values
      !dpar1 = !height
      !dpar2 = !width
    endif

    !!mdsResetPins(1,4)

  elseif (!conn eq |CIRC|) then
-- AVEVA Circ Duct type
    !width = DESPAR[2]
    !height = DESPAR[2]
--<wd>march2003
    --!dpar1 = !width + !insu.real()
    --!dpar2 = !height + !insu.real()
    !dpar1 = !width + (2 * !insu.real())
    !dpar2 = !height + (2 * !insu.real())
    --<wd>march2003
    !dpar3 = 0
  elseif (!conn eq |OVAL|) then
-- AVEVA Oval Duct Type
    !width = DESPAR[2]
    !height = DESPAR[3]
--<wd>march2003
    --!dpar1 = !width + !insu.real()
    --!dpar2 = !height + !insu.real()
    !dpar1 = !width + (2 * !insu.real())
    !dpar2 = !height + (2 * !insu.real())
    --<wd>march2003
    !dpar3 = 0
  endif

  !!ce = !writeHVAC
  DESPAR $!dpar1 $!dpar2 $!dpar3 0mm 0mm

  !!kRestoreUnits(!currentunits)

endfunction
