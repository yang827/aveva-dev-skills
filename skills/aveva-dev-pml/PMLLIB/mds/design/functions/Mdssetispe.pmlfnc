--
-- File             : Mdssetispe.pml
--   Type           : Function Definition
--   Group          : Multi Discipline Supports Application
--     Keyword      : MDS
--   Module         : design
--   Replaces       :
--
-- Author:          : Neale Morris
-- Created:         : Dec 23 1998
--
--
-- Description:
-- Set the insulation/tracing specification of the support atta if the previous element
-- or the branch has its ispe/tspe set
--
----------------------------------------------------------------------------------
-- Arguments:
--    [#]   [R/RW] [Data Type] [Description]
--
-- Return:
--    [Data Type]   [Description]
--
-- Define Function
define function !!mdsSetIspe()

  --<KP> Oct 2008 Handling of CTSUPP added
  if !!ce.type.eq('CTSUPP') then
    return
  endif

  if !!ce.sequ.gt(1) then
    attrib ispe = ispe of prev
    attrib tspe = tspe of prev
  else
    attrib ispe = ispe of owner
    attrib tspe = tspe of owner
  endif

endfunction
