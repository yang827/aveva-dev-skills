--
--
-- Description:
-- Initialisation
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetJGadgets()

-- Find current units and set the distance unit to metric

  !currentUnits = !!kgetSetUnits()

-- initilise Variables

  !refe      = !!ce
  !selected  = !!mdsJointSpec.spre.selection().dbref()
  !spref     = !!mdsJointSpec.jlist.selection().dbref().spref
     handle ANY
-- Apply to all joints
         !spref = !!mdsJointSpec.jlist.rtext.first().dbref().spref
     endhandle
--<dw>aug2008 Dun979-Flip setting for single plate joints
   !specname    = !selected.fullname.after('/')
   if (!specname.eq('MDS-SingleOneSide_Stiffeners')) then
      !!mdsJointSpec.flip.active = TRUE
   else
      !!mdsJointSpec.flip.active = FALSE
   endif
--<dw>aug2008 Dun979-end of plate joint flip setting

  !jlineTest = !!mdsgetJlines(!selected)

-- set gadgets up (if modify joints is included, this will have to get the atts from the joint)

  !!ce = !!mdsJointSpec.jlist.selection().dbref()
    handle any
-- incase ALL is selected, then use joint 1
      !!ce = !!mdsJointSpec.jlist.rtext[1].dbref()
    endhandle

  !!mdsJointSpec.cutb.val    = !!ce.cutb
  !!mdsJointSpec.bang.val    = !!ce.bang.string()

  if(!jlineTest.neq(!!mdsJointSpec.just.dtext)) then
    !!mdsJointSpec.just.dtext = !!mdsgetJlines(!!mdsJointSpec.spre.selection().dbref())
    !!mdsJointSpec.just.rtext = !!mdsgetJlines(!!mdsJointSpec.spre.selection().dbref())
  endif

-- set dataset information (if desps exist)

   var !dataSets coll all data with purp eq 'DESP' for $!selected.dtre
     handle ANY
-- in case there are no datasets of that type
       return
     endhandle

-- grey out gadgets if there are no desps

  if(!dataSets.unset()) then

--<dw>aug2008 Dun979-additional settings for plate joints
-- Flip and Pang added

    !!mdsJointSpec.flip.active = FALSE
    !!mdsJointSpec.leng.active = FALSE
    !!mdsJointSpec.widt.active = FALSE
    !!mdsJointSpec.thkn.active = FALSE
    !!mdsJointSpec.default.active = FALSE
    !!mdsJointSpec.leng.val    = 0
    !!mdsJointSpec.widt.val    = 0
    !!mdsJointSpec.thkn.val    = 0
    !!mdsJointSpec.owcc.active = FALSE
    !!mdsJointSpec.atcc.active = FALSE
    !!mdsJointSpec.bdia.active = FALSE
    !!mdsJointSpec.pang.active = FALSE
    !!mdsJointSpec.owcc.val    = 0
    !!mdsJointSpec.atcc.val    = 0
    !!mdsJointSpec.bdia.val    = 0
    !!mdsJointSpec.pang.val    = 0

  else

    var !dkey eval dkey for all from !dataSets
    !properties = prls
    !desp = Despar

    if(defined(!spref) and !spref.unset().not() and !desp.unset().not()) then

      do !d indices !desp
        !!mdsJointSpec.$!dkey[$!d]$n.active = TRUE
          handle any
          endhandle
        !!mdsJointSpec.$!dkey[$!d]$n.val = $!desp[$!d]
          handle any
          endhandle
      enddo

-- Temporarily set Joint Spref to the Selected Joint to get DTSET properties

      !!mdsDacControl(TRUE)

      !savedSpref = !!ce.spref
      SPREF $!selected

      if (defined(!dkey[4])) then
        if (!dkey[4].eq('OWCC')) then
          if (!!mdsJointSpec.owcc.val.eq(0)) then
            var !dflt4 prde OWCC
            !dfltValue4 = !dflt4.real()
              handle any
-- Handle ERROR if the JOINT Owning SCTN does NOT have the OPAR defined in the DTSE
                var !para10 (para num 10 of $!!ce.cref)
                !dfltValue4 = !para10.real() * 2
                  handle any
                    !dfltValue4 = 90
                  endhandle
              endhandle
            !!mdsJointSpec.owcc.val = !dfltValue4
          endif
        endif
      endif

      if (defined(!dkey[5])) then
        if (!dkey[5].eq('ATCC')) then
          if (!!mdsJointSpec.atcc.val.eq(0)) then
            var !dflt5 prde ATCC
            !dfltValue5 = !dflt5.real()
               handle any
-- Handle ERROR if the JOINT Attached SCTN does NOT have the APAR defined in the DTSE
                 var !para10 (para num 10 of $!!ce.cref)
                 !dfltValue5 = !para10.real() * 2
                   handle any
                     !dfltValue5 = 90
                   endhandle
               endhandle
            !!mdsJointSpec.atcc.val = !dfltValue5
          endif
        endif
      endif

      if (defined(!dkey[6])) then
        if (!dkey[6].eq('BDIA')) then
          if (!!mdsJointSpec.bdia.val.eq(0)) then
            var !dflt6 prde BDIA
            !dfltValue6 = !dflt6.real()
            !!mdsJointSpec.bdia.val = !dfltValue6
          endif
        endif
      endif

--Reset original Joint Spref

      !!mdsDacControl(TRUE)

      SPREF $!savedSpref

-- Deactivate Gadgets if a Welded Despar Joint is Selected(Only 3 DKEYS)
         if (!dkey.size().lt(4)) then
           !!mdsJointSpec.owcc.active = FALSE
           !!mdsJointSpec.atcc.active = FALSE
           !!mdsJointSpec.bdia.active = FALSE
           !!mdsJointSpec.pang.active = FALSE
           !!mdsJointSpec.owcc.val    = 0
           !!mdsJointSpec.atcc.val    = 0
           !!mdsJointSpec.bdia.val    = 0
           !!mdsJointSpec.pang.val    = 0
         endif

       else
       -- yukky bit to get the value of the default expressions

         !!ce = !!mdsJointSpec.jlist.selection().dbref()
         handle any
         -- incase ALL is selected, then use joint 1
           !!ce = !!mdsJointSpec.jlist.rtext[1].dbref()
         endhandle

         -- temporarily set spre to get properties
         !savedSpref = !!ce.spref
         !!mdsDacControl(true)
         SPREF $!selected
         !!mdsDacControl(false)
         -- get dflts values and properties
--<dw>aug2008 Dun979-to account for Doubler plate joint
         var !dataSets coll all data with purp eq 'DESP' for $!selected.dtre
         var !properties eval dkey for all from !dataSets
--<dw>aug2008 Dun979-end of Doubler plate joint
         !properties = prls
         do !pind indices !properties
         -- this line don't work in PML2
           var !dflt[$!pind] prde $!properties[$!pind]
           -- convert to real
           !dfltValue[!pind] = !dflt[!pind].real()
           handle any
-- Handle ERROR if the JOINT Owning SCTN does NOT have the OPAR defined in the DTSE
             var !para10 (para num 10 of $!!ce.cref)
             !dfltValue[!pind] = !para10.real() * 2
             handle any
               !dfltValue[!pind] = 90
             endhandle
           endhandle

            -- set those that are desps active
           !!mdsJointSpec.$!dkey[$!pind]$n.active = TRUE
           !!mdsJointSpec.$!dkey[$!pind]$n.val = !dfltValue[!pind]
         enddo

-- Deactivate Gadgets if a Welded Despar Joint is Selected(Only 3 DKEYS)
         if (!properties.size().lt(4)) then
           !!mdsJointSpec.owcc.active = FALSE
           !!mdsJointSpec.atcc.active = FALSE
           !!mdsJointSpec.bdia.active = FALSE
           !!mdsJointSpec.pang.active = FALSE
           !!mdsJointSpec.owcc.val    = 0
           !!mdsJointSpec.atcc.val    = 0
           !!mdsJointSpec.bdia.val    = 0
           !!mdsJointSpec.pang.val    = 0
         endif
         !!mdsDacControl(true)
         SPREF $!savedSpref
         !!mdsDacControl(false)
       endif
       !!mdsJointSpec.default.active = TRUE
     endif

   !!mdsDacControl(FALSE)


-- Reset Units

   !!kRestoreUnits(!currentunits)

-- return to original

   !!ce = !refe

-- End function
endfunction
