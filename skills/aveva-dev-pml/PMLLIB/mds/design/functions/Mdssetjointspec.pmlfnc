--------------------------------------------------------------------------------
--
-- File: Mdssetjointspec.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Andrew Kirkland
-- Created:  Mon 23rd June 1998
--
--
-- Description:
-- Set joint details as set in the form.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        STRING       [String to recognise justl or all (apply) option]
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetJointSpec(!option is STRING)

  -- Clear Field Weld aidtext from Graphical display
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 300
  handle any
  endhandle

  -- Initialise Variables
  !refe     = !!ce
  !jline    = !!mdsJointSpec.just.selection()
  !joints   = !!mdsJointSpec.jlist.rtext
  !joint    = !!mdsJointSpec.jlist.selection()
  !desp     = ARRAY()

  !support  = !!mdsJointSpec.support
  if (!support.type inset ('FT14')) then
    if (!support.config.eq(4)) then
      !movemem  = false
    else
      !movemem  = true
    endif
  elseif (!support.type inset ('FT19')) then
    if (!support.config.eq(4)) then
      !movemem  = true
    else
      !movemem  = false
    endif
  else
    !movemem  = true
  endif

  !jlistval = !!mdsJointSpec.jlist.val
  if (!support.type.eq('FT15')) then
    if (!jlistval.eq(2) or !jlistval.eq(3)) then
      !num = 2
    else
      !num = 1
    endif
  else
    !num = 1
  endif

  -- check if desps are to be used (assume if leng inactive all are for now)
  if(!!mdsJointSpec.pang.active) then
    !desp[1] = !!mdsJointSpec.leng.val
    !desp[2] = !!mdsJointSpec.widt.val
    !desp[3] = !!mdsJointSpec.thkn.val
    !desp[4] = !!mdsJointSpec.pang.val
  elseif(!!mdsJointSpec.leng.active) then
    !desp[1] = !!mdsJointSpec.leng.val
    !desp[2] = !!mdsJointSpec.widt.val
    !desp[3] = !!mdsJointSpec.thkn.val
    !desp[4] = !!mdsJointSpec.owcc.val
    !desp[5] = !!mdsJointSpec.atcc.val
    !desp[6] = !!mdsJointSpec.bdia.val
    !desp[7] = !!mdsJointSpec.pang.val
  endif

  -----------------------------------------------------------------------------------------------------
  -- Store EXISTING Single Joint SPREF and Existing Joint PLATE Thickness if it is appropriate for;
  -- FT03 FT04 FT18 FT19 -> ONLY Config '4' - applies to these MDS FRAMEWORKS - (Config '5' does NOT exist)
  --                FT13 -> Config '4' or Config '5' applies to this MDS FRAMEWORK
  --                FT14 -> Configs '2', '3' or '5' applies to this MDS FRAMEWORK - (Config '4' EXISTS but is NOT applicable)
  --                FT15 -> Configs '2', '3' or '4' applies to this MDS Framework - (Config '1' EXISTS but is NOT applicable)

  !ceref   = !!ce
  !ethkn   = ARRAY()

  if (!support.type.eq('FT15')) then
    if (!support.config.eq(4)) then
      !j  = 1
      !j2 = 2
    else
      if (!support.config.eq(2) and !jlistval.eq(1)) then
        !movemem = false
        !j = 1
      else
        !j = 2
      endif
    endif
  else
    !j = 1
  endif

  if ((!support.type inset ('FT03','FT04','FT18','FT19') and (!support.config.eq(4))) or (!support.type inset('FT13','FT14') and !support.config.eq(5)) or (!support.type inset('FT14') and !support.config.eq(2)) or (!support.type inset('FT14') and !support.config.eq(3)) or (!support.type inset('FT15') and !support.config.eq(2) or !support.config.eq(3) or !support.config.eq(4)) ) then

    if (!support.joints[!num].spref.unset().not()) then
      if (!support.type.eq('FT15')) then
        if (!support.config.eq(4)) then
          !jspref  = !support.joints[1].spref
          !jspref2 = !support.joints[2].spref
        else
          if (!jlistval.eq(2) or !jlistval.eq(3)) then
            !jspref = !support.joints[2].spref
          else
            !jspref = !support.joints[1].spref
          endif
        endif
      else
        !jspref = !support.joints[1].spref
      endif

      -- Determine EXISTING Joint Plate Thickness from its Dataset
      !edata = !!kcollectallfor('DATA', 'DKEY eq |THKN|' , !jspref.dtref )
      !edkey = object BLOCK('!edata[!evalindex].dkey')
      !unusededval = !edata.evaluate(!edkey)
      !epurp = object BLOCK('!edata[!evalindex].purp')
      !epval = !edata.evaluate(!epurp)
      !enumb = object BLOCK('!edata[!evalindex].numb')
      !enval = !edata.evaluate(!enumb)
      if (!epval[1].eq('DESP')) then
        !!ce = !support.joints[!j]
        --            !!ce = !support.joints[1]
      else
        !!ce  = !jspref
      endif
      !ethkn = $!epval[1] number $!enval[1]
    else
      !ethkn[1] = 0
    endif

    !ceref = !!ce
  endif
  -----------------------------------------------------------------------------------------------------

  -- goto joint
  !!ce = !joint.dbref()
  handle any
    -- incase all is chosen
  endhandle

  if(!option.eq('APPLY')) then
    !spref    = !!mdsJointSpec.spre.selection()
    !bang     = !!mdsJointSpec.bang.val
    !cutBack  = !!mdsJointSpec.cutb.val
    -- set attributes and spref
    !!mdsDacControl(true)
    if(!joint.eq('ALL')) then
      do !ind indices !joints
        !!ce = !joints[!ind].dbref()
        handle any
          -- last one is all
          break
        endhandle
        SPREF $!spref
        handle ANY
          -- in case there inst any geometry to select
        elsehandle none
          JLINE $!jline
        endhandle
        BANG  $!bang
        CUTB  $!cutBack
        do !despar indices !desp
          desp num $!despar  $!desp[$!despar]
          -- GE 07/04/05 Handle if there are no despars to be set
          handle any
          endhandle
          -- GE End of fix
        enddo
        RECONN RECALC
        handle any
          -- incase the pline is not playing
        endhandle
        --<dwjan2008 Dun815 for Oglaend joints
        !jointname = !joints[!ind].dbref().fullname
        !jointcatr = !spref.dbref().catref.fullname
        !jointpart = !jointcatr.part(2,'/')
        if (!jointpart inset('O-49-70','O-49-80','80466','80921','84283') and $!ind gt 1) then
          $!jointname
          show !!mdsJointAngle
          return
          --<dwjan2008 end of Oglaend joints
          --<dw>aug2008 Dun979-Additional settings for Plate joints
          -- elseif (!jointcatr eq '/Doubler_plate_rolled') then
          -- goto cref
          -- !defaultdir = N
          -- !line       = object LINE()
          -- !line.startposition = poss wrt world
          -- !line.endposition   = pose wrt world
          -- !direction = !line.direction()
          -- !angle     = !defaultdir.angle(!direction)
          -- same
          -- desp num4 $!angle
        elseif (!jointcatr eq '/SingleOneSide_Stiffener_Joint') then
          desp num 4 0mm
          desp num 5 1mm
        endif
        --<dw>aug2008 Dun979-end additional plate joint settings
      enddo
    else
      SPREF $!spref
      handle ANY
        -- in case there isn't any geometry to select
      elsehandle none
        JLINE $!jline
      endhandle
      BANG  $!bang
      CUTB  $!cutBack
      if(!desp.unset()) then
        desp unset
      else
        do !despar indices !desp
          desp num $!despar  $!desp[$!despar]
        enddo
      endif
    endif

    -- Support type (1)->'FT03', 'FT04', 'FT18', 'FT19' and Config is No. '4'
    -- Support type (2)->'FT13' and the Config No. is '4' or '5'
    -- Support type (3)->'FT14' and the Config No. is '2', '3' or '5'
    -- Support type (4)->'FT15' and the Config No. is '2', '3' or '4'
    -- Move the MDS Framework and Associated ATTAs 'UP or DOWN' or 'INFRONT or BEHIND'
    -- to suit the NEW Selected Joint's Plate Thickness

    if ((!support.type inset ('FT03','FT04','FT18','FT19') and (!support.config.eq(4))) or (!support.type inset('FT13','FT14') and !support.config.eq(5)) or (!support.type inset('FT14') and !support.config.eq(2)) or (!support.type inset('FT14') and !support.config.eq(3)) or (!support.type inset('FT15') and !support.config.eq(2) or !support.config.eq(3) or !support.config.eq(4)) ) then

      -- Determine NEW Joint Plate Thickness from its Dataset
      !sjoi = !support.joints[!j].dtref
      !data = !!kcollectallfor('DATA', 'DKEY eq |THKN|' , !sjoi )
      !dkey = object BLOCK('!data[!evalindex].dkey')
      !unuseddval = !data.evaluate(!dkey)
      !purp = object BLOCK('!data[!evalindex].purp')
      !pval = !data.evaluate(!purp)
      !numb = object BLOCK('!data[!evalindex].numb')
      !nval = !data.evaluate(!numb)

      !!ce  = !support.joints[!num]
      !thkn = $!pval[1] number $!nval[1]

      if (!support.type inset ('FT03', 'FT04', 'FT18', 'FT19')) then
        -- Determine the Location of the Support, at 'TOS' or 'BOS' of Connecting Beam
        -- and the Direction to Move Support, 'UP' or 'DOWN'
        !postos = object POSITION()
        var !tpos pplin TOS start of $!support.connections[1] wrt /*
        !postos = !tpos.position()
        !uptos  = !postos.up

        !posbos = object POSITION()
        var !bpos pplin BOS start of $!support.connections[1] wrt /*
        !posbos = !bpos.position()
        !upbos  = !posbos.up

        !joipos = !support.joints[1].pos.wrt( /* )
        !upjoi  = !joipos.up

        !diftos = !uptos - !upjoi
        !difbos = !upbos - !upjoi

        if (!diftos.abs().lt(!difbos.abs())) then
          !movedir = U
        else
          !movedir = D
        endif

      elseif ( (!support.type.eq('FT13') or !support.type.eq('FT14') or !support.type.eq('FT15') and !support.config.eq(2) or !support.config.eq(3) or !support.config.eq(5) ) or (!support.type.eq('FT15') and !support.config.eq(4)) ) then

        !!ce  = !support.joints[!j]
        !posl = !!ce.posl
        var !posldir pplin $!posl dir of $!support.connections[$!j] wrt /*
        !movedir = $!posldir
      endif

      !movedist = !thkn[1]

      -- Get all the MDS Support members
      !memb = ARRAY()
      !memb.append(!support.stru)
      if (!support.type.neq('FT15')) then
        !memb.appendarray(!support.atta)
      endif

      -- If Existing Joint with Plate Thickness Exists ONLY move the Difference in Thicknesses
      if (!ethkn[1].neq(0)) then
        if (!thkn[1].gt(!ethkn[1])) then
          !movedist = (!thkn[1] - !ethkn[1])
        elseif (!ethkn[1].gt(!thkn[1])) then
          !movedist = -(!ethkn[1] - !thkn[1])
        elseif (!ethkn[1].eq(!thkn[1])) then
          !movedist = 0
        endif
      endif

      -- Move ALL of the MDS members
      if (!movemem) then
        do !val values !memb
          !!ce = !val
          if ((!support.type.eq('FT14')) and (!support.config.eq(5))) then
            skip if (!!ce.type.neq('STRU'))
          endif
          --  move $!movedir dist $!thkn[1]
          --$P            move $!movedir dist $!movedist
          move $!movedir dist $!movedist
        enddo
      endif

      -- Set the forms Distance Gadget to the Correct Value
      if ( (!support.type.neq('FT14') and !support.config.neq(5)) or (!support.type.neq('FT15')) ) then
        !type = !support.type
        !fnam = '!!mds' & !type
        !form = $!fnam
        !unusededis = !form.dist.val
        !!ce  = !support.datum

        -- Find current units and set the distance unit to metric to write back to the current forms !form.dist.val' gadget member
        !currentUnits = !!kgetSetUnits()

        var !cdis cons dist p0 to p0 of prev
        handle (2,113)
          var !cdis cons dist p0 to ph
        endhandle
        !form.dist.val = !cdis.real().nint()

        -- Reset the Units
        !!kRestoreUnits(!currentUnits)

        !!ce = !ceref
      endif
    endif

    -- For Support Type 'FT14' Configs '4' and '5' -- The SUBS Stiffener Plate is NOT REQUIRED when
    -- an EXTERNAL Joint is attached to the Cross BAR member of the MDS Framework.
    -- As the SUBS element needs to exist for modification purposes etc...,
    -- the BOX element size attributes of the SUBS element will automatically be set to XLEN 0, YLEN 0 and ZLEN 0.

    if ((!support.type.eq('FT14')) and (!support.config.eq(4)) or (!support.config.eq(5))) then
      -- Navigate to BOX 1 of the SUBS of the MDS STRUCTURE
      !subs = !support.stru.name & '/SUBS1'
      !!ce  = !subs.dbref()
      !!ce  = box 1
      -- Get Existing Data and Save it
      !xlen = !!ce.xlen
      !ylen = !!ce.ylen
      !zlen = !!ce.zlen
      !!ce  = !subs.dbref()
      if (!xlen.neq(0)) then
        :MDSCp2 '$!xlen;$!ylen;$!zlen'
        !type = !support.type
        !fnam = '!!mds' & !type
        !form = $!fnam
        !form.oldstiffener[1] = !xlen.string()
        !form.oldstiffener[2] = !ylen.string()
        !form.oldstiffener[3] = !zlen.string()
      endif
      !!ce  = box 1
      xlen0 ylen0 zlen 0
      !!ce = !ceref
    endif

  else

    if(!joint.eq('ALL')) then
      do !ind indices !joints
        !!ce = !joints[!ind].dbref()
        handle any
          -- last one is all
          break
        endhandle
        JLINE $!jline
        RECONN RECALC
        handle any
          -- incase the pline is not playing
        endhandle
      enddo
    else
      JLINE $!jline
    endif
  endif

  --<dw>aug2008 Dun979-Additional settings for Plate joints
  if(!option.eq('FLIP')) then
    do !ind indices !joints
      !jointref = !joints[!ind].dbref()
      handle any
        break
      endhandle
      !jointspre = !jointref.spre.string()
      if (!jointspre.neq('Unset')) then
        $!jointref
        desp num 4 1mm
        desp num 5 0mm
      endif
    enddo
  endif
  --<dw>aug2008 Dun979-end additional plate joint settings

  --    RECONN
  RECONN RECALC
  handle any
    -- incase the pline is not playing
  endhandle

  --   !!mdsReloadDims(!!mdsJointSpec.form)
  !!mdsDacControl(false)
  -- back to original element
  !!ce = !refe

  -- End function
endfunction
