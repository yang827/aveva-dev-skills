--
--
-- Description:
-- function to set the lego bricks for demo purposes only
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Name of stru
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetLego(!stru is STRING)


  !bricks = !!kCollectAllFor('FITT', '', $!stru)

  do !set values !bricks

    !dp = ARRAY()

    !!ce = !set
    sctn
    var !length deri length
    same
    !howmany = !length.real() / 30
    !value = (0)
    do from 1 to !howmany.int()
      !value = !value + 30
      !dp.append('$!value')
    enddo

    !dpnum = !dp.size()
    do from !dpnum to 50
      !dp.append('30')
    enddo
    !!ce = !set
    despar $!dp[1] $!dp[2] $!dp[3] $!dp[4] $!dp[5] $!dp[6] $!dp[7] $!dp[8] $!dp[9] $!dp[10] $!dp[11] $!dp[12] $!dp[13] $!dp[14] $!dp[15] $!dp[16] $!dp[17] $!dp[18] $!dp[19] $!dp[20] $!dp[21] $!dp[22] $!dp[23] $!dp[24] $!dp[25]  $!dp[26] $!dp[27] $!dp[28]  $!dp[29] $!dp[30] $!dp[31] $!dp[32] $!dp[33] $!dp[34] $!dp[35] $!dp[36] $!dp[37] $!dp[38] $!dp[39] $!dp[40] $!dp[41] $!dp[42] $!dp[43] $!dp[44] $!dp[45] $!dp[46] $!dp[47] $!dp[48] $!dp[49] $!dp[50]
    same

  enddo

  return
