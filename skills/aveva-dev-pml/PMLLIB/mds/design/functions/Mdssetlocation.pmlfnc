--
--
-- Description:
-- Function to Invoke the Alignment Utility for MDS Frameworks
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetLocation(!form is FORM)

-- Initialise variables
    !support  = !form.support
    !datum    = !support.datum
--> Modified <ab>  for Fixed & Variable Hangers April 02 2002
$( was
    !name     = !support.stru.name
    !frame    = !name & '/MAIN'
    var !Supportframe EXISTS $!frame
$)
    !frame = ||
    !Supportframe = ||
    !stru     = !support.stru
    if(!stru.set()) then
      var !sections coll all sctn for $!stru
      if !sections.size().eq(0) then
        !Supportframe = 'FALSEA'
      else
        !SupportFrame = 'TRUEA'
      endif
      !name = !stru.name
      !frame    = !name & '/MAIN'
      -- var !Supportframe EXISTS $!frame
    endif
--< Modified <ab>  for Fixed & Variable Hangers April 02 2002

-- Check that Datum Atta has been Created
    if (!datum.set().not())then
      !!alert.message('Datum Support Atta has NOT been created')
      return
    endif

-- Check that Support Structure has been Created
--> Modified <ab>  for Fixed & Variable Hangers April 02 2002
--    if (!SupportFrame eq 'FALSEA')then
    if (!frame.neq(||) and !SupportFrame eq 'FALSEA')then
--< Modified <ab>  for Fixed & Variable Hangers April 02 2002
      !!Alert.message('Support Structure MUST be Created before repositioning the ADP location')
      return
    endif

-- Check that Datum Atta has been positioned
    if (!support.position.not())then
      !!alert.message('Datum Atta MUST be Positioned before repositioning the ADP location')
      return
    endif

--<wd>18aug2004
-- Can only modify the datum atta if we can write to it
    --if !!MdsComClaimDac(!form.support.datum,'DACMOD','POS').not() then
      --!!Alert.Error('Unable to modify the adp location as write access is not available to the datum atta')

-- Can only modify the MDS SUPPORT STRUCTURE if we can write to it
    if !!MdsComClaimDac(!form.support.stru,'DACMOD','POS').not() then
      !!Alert.Error('Unable to modify the ADP location as write access is not available to the MDS Support Structure')
--<wd>18aug2004
      return
    endif

-- Load form before using for first time
   if undefined(!!Loc3dexplicit) then
      pml load form !!Loc3DExplicit
   endif

-- Show edg position for for location
    -- !!CE = !Form.support.datum
    !!CE = !Form.support.stru
    !!Loc3dexplicit.Loc3dexplicit()
--<wd>18aug2004
-- Commented out this line as the uda :MDSADPLOC is now located at the MDS Support STRUCTURE, not the DATUM ATTA
    --!!Loc3dexplicit.setup(!Form.support.datum)
    !!Loc3dexplicit.setup(!Form.support.stru)
--<wd>18aug2004
    !!Loc3dexplicit.edit(!!CE)

  endfunction
-- End of function

-- End of file MdsSetLocation.pml
