--
-- Description:
-- function to display the standard steelwork material setting form
-- for use with the MDS application.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetMat(!Form is FORM)

-- Initialise variables

  !ce = !!ce

-- Enhanced to set the wpad material of hangers

  if !Form.string().upcase().eq('MDSFH01') then
    !Hang  = !Form.Support.Datum.cref.owner
-- Collect all wpad elements and get their material if set
    !!CE = !hang
    var !Wpads coll all wpad for $!Hang
    if !Wpads.empty() then
      !!ce = !ce
      !!Alert.Error('Hangers does not contain any plates to modify. Unable to set material')
      return
    endif
  else
    !Stru    = !Form.Support.Stru
-- Collect all stru element and get their material if set
    !!CE = !Stru
    var !Sctns coll all sctn for $!Stru
    if !Sctns.empty() then
      !!ce = !ce
      !!Alert.Error('Support structure has not been created. Unable to set material')
      return
    endif
  endif

-- Now uses MDS form for setting steelwork material and not the standard steelwork form

  !!MdsSteelMat.init(!Form)

$(

  var !Material eval matref for all from !Sctns
  !Material.unique()

-- if the material is unique then try to set the material on the form

    show _CDsetmatr

    -- This show now replaces the show's further down the file
    -- When a user first went into this form it initialized to the
    -- first material in the list and not the correct material

    !MaterialForm = !!CDSETMATR
    if !Material.size().eq(1) then
      if !Material[1].dbref().badref().not() then
        !SetMaterial = !Material[1].dbref().ref
    -- Locate material in list
        !IsItThere = !MaterialForm.Matr.Rtext.FindFirst(!Setmaterial.string())
    -- Set it on the form, show the form first
      --  show _CDsetmatr
         !MaterialForm.Matr.Select('RTEXT',!MaterialForm.Matr.Rtext[!IsItThere])
          handle any
          endhandle
        !MaterialForm.Casc.val = true
      else
      -- show _CDsetmatr
        !MaterialForm.Casc.val = true
      endif
    else
      !!Alert.Message('The material of the framework sections is not unique, selecting the first available material')
     -- show _CDsetmatr
      !MaterialForm.Casc.val = true
    endif

$)


-- End function
endfunction

-- End of file Mdssetmat.pml
