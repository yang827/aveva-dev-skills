--
-- File: Mdssetmatref.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   mds
--   Module:    design
--   Replaces:
--
-- Author:    Neale Morris
-- Created:   Wednesday 14th November 2001
--
-- Description:
-- Function to set the :mdsMatref and the SHOP flag of any mds Ancillary
-- ATTA Support with the default values stored in the dimensions default file
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        STRING        DBREF of Current Ancillary Type - ATTA
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Define Function
define function !!mdssetmatref(!dbref is DBREF)

  --><wd>09feb2009  -- Always work in METRIC units is this PML function
  -- Set Units
  !currentunits = !!kGetSetUnits()
  --<<wd>09feb2009

  -- Get the Support Type of the Passed ATTA Support Ancillary
  !type = !dbref.styp

  -------------------------------------------------------------------------------
  --<wd>may2006<mds12>
  -- NO MATERIAL to SET for ANY type of REST ATTAS and NO DESPAR values etc... are available
  -- in the MDS PARAGON DEFAULTS DB via the object MDSREADPARSDATA() introduced at <mds12>
  -- RETURN from this FUNCTION for ALL REST type ATTAS -- Check their STYPE values
  if ( !type.eq('PIPE-REST') or !type.eq('RACK-REST') or !type.eq('PIPE-REST-INLINE') or !type.eq('HVAC-REST') )  then
    --><wd>09feb2009 - Reset Units
    !!kRestoreUnits(!currentunits)
    --<<wd>09feb2009
    return
  endif
  --<wd>may2006<mds12>
  -------------------------------------------------------------------------------
  -- Delete hyphen '-' characters found in STYP
  !replace = !type.replace('-','')
  !type = !replace

  -- Get Ancillary Bore in Millimetres (Already in MM from Calling Function)
  --<wd>jan2004 -- ??? !bore = pl bore was NOT being recognised on an AN04 anchor????
  --!bore = pl bore
  !bore = !dbref.lbore
  handle any
    !bore = p1bor of own of $!dbref
  endhandle
  -----------------------------------------------------------------------------------
  -- mjb >>> 17.03.06 <mds12> Global variable !!mdsParxxx replaced with object MDSREADPARSDATA()
  !realBore = !bore.real().value()
  !mdsAttaObj  = object MDSREADPARSDATA()

  !stype = !dbref.stype
  if !stype.match('AC17-').neq(0) then
    -- get the stype without '-'
    !stypeNew = !stype.before('-') & !stype.after('-').before('-') & !stype.substring(-1,1)
    !stype = !stypeNew.replace('/','')
  endif

  !unusedMdsAttaDefs = !mdsAttaObj.mdsdefsdata(!stype,!realBore)
  -- Set the UDA :mdsMatref with the default PROPCON Property declared in the dimensions default file
  if !type.neq('PIPE-REST') and !type.neq('RACK-REST') and !type.neq('PIPE-REST-INLINE') and !type.neq('PIPEREST') then
    --mjb--if statement commented out - do not need to look at 0 bore line and actual bore
    --mjb--matref is taken from object
    --mjb--if defined(!!mdsPar$!type$n[0]) then
    -- Find the correct material for the pipe material
    !specOfComp = pspe of bran
    handle any
    elsehandle none
      !materialOfSpec = !specOfComp.:mdsPipeMat
    endhandle
    --!!m = !mdsAttaObj

    !materials = !mdsAttaObj.pipeMaterial.split(',')
    handle (2,754)
    endhandle

    --mjb--!materials = !!mdsPar$!type$n[0].pipeMaterial.split(',')
    if !materials[1].eq('ALL') then
      !matRefs = !mdsAttaObj.matRef.split(',')
      --mjb--!matRefs = !!mdsPar$!type$n[0].matRef.split(',')

      !mdsType = !matRefs[1]
    else
      !matRefs = !mdsAttaObj.matRef.split(',')
      --mjb--!matRefs = !!mdsPar$!type$n[0].matRef.split(',')
      !posInArray = !materials.find(!materialOfSpec)
      !mdsType = !matRefs[$!posInArray[1]]
      handle any
        -- If the :mdsMatref has not been set print a message to the window
        !name = !dbref.name
        write '----- Warning ----- Warning ----- Warning ----- Warning ----- Warning ----- Warning ----- Warning ------'
        write 'It was not possible to set the material of the component $!name because no mdsMatref is set in paragon'
        write '----- Warning ----- Warning ----- Warning ----- Warning ----- Warning ----- Warning ----- Warning ------'
        --><wd>09feb2009 - Reset Units
        !!kRestoreUnits(!currentunits)
        --<<wd>09feb2009
        return
      endhandle
    endif
    --mjb--else
    --mjb--!mdsType = '!!mdsPar' & !type & '[' & !bore.real() & '].matRef.dbref()'
    --mjb--endif
  endif

  !!mdsdaccontrol(true)
  !matRefAtt = !!mdsUseMatref(!dbref)

  if !matRefAtt.eq('UDA') then
    !dbref.:mdsMatref = $!mdsType
    handle any
      !!ce = !dbref
      :mdsMatref def
    endhandle
  else
    !dbref.matRef = $!mdsType
    handle any
      !!ce = !dbref
      MatRef def
    endhandle
  endif

  if (!type inset ('PIPE-REST','PIPE-REST-INLINE','PIPEREST','PIPERESTINLINE' )) then
    if !matRefAtt.eq('UDA') then
      :mdsMatref default
    else
      MatRef default
    endif
    !!mdsdaccontrol(false)
    return
  elseif (!type inset ('RACK-REST')) or (!type inset ('RACKREST')) then
    if !matRefAtt.eq('UDA') then
      :mdsMatref default
    else
      MatRef default
    endif
    !!mdsdaccontrol(false)
    return
  endif

  -- Set the MTOC attribute as defined in the dimensions default file
  --mjb--if defined(!!mdsPar$!type$n[0]) then
  --mjb--!mtoc = !!mdsPar$!type[0].shop
  !mtoc = !mdsAttaObj.mtoc.trim().boolean()
  if !mtoc.unset() then
  elseif !mtoc.not() then
    !dbref.mtoc = 'off'
    handle any
    endhandle
  elseif !mtoc then
    !dbref.mtoc = 'on'
    handle any
    endhandle
  endif
  --mjb--endif

  -- Set the default SHOP flag for the ATTA declared in the dimensions default file
  --mjb--!mdsShop = '!!mdsPar' & !type & '[' & !bore.real() & '].shop'
  !mdsShop = !mdsAttaObj.shop

  -- mjb <<< 17.03.06 <mds12> end of mods
  -----------------------------------------------------------------------------------

  !dbref.shop = $!mdsShop
  handle any
  endhandle

  !!mdsdaccontrol(false)
  --------------------------------------------------------------------------------
  --------------------------------------------------------------------------------

  --><wd>09feb2009 - Reset Units
  !!kRestoreUnits(!currentunits)
  --<<wd>09feb2009

endfunction
