-- Author:              Andrew Kirkland
-- Created:             20 Mar 1998
--
--
-- Description:
-- Function to set the mtor reference to the spre of the current pipe spec
-- or out of spec if reqd, for  extra details on the isometric.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       [DBREF]       [Spec to search]
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------




define function !!MdsSetMtor(!Spco is dbref)

-- if !spco is set then there is only one selection : use it

   if(!Spco.set()) then

          MTOR $!Spco

   else
          !SpcoFromForm = !!MdsTubeSel.Specs.Selection()
          MTOR $!SpcoFromForm
   endif



endfunction

-- end function MdsSetMtor
