--
-- File             : Mdssetnonmdb.pml
--   Type           : Function Definition
--   Group          : Multi Discipline Supports Application
--     Keyword      : MDS
--   Module         : design
--   Replaces       :
--
-- Author:          : Steve Robinson
-- Created:         : Oct 7 1997
--
--
-- Description:
-- set design parameters for all attachment types
--
----------------------------------------------------------------------------------
-- Arguments:
--    [#]   [R/RW] [Data Type] [Description]
--
-- Return:
--    [Data Type]   [Description]
--
-- Define Function
define function !!MdsSetNonMdb()

  -- Confirm changes with user

    if !!Alert.confirm('Are you sure you want to set all non user parameters to their default values?') eq 'NO' then
      return
    endif

  -- Collect all supports

    !Attas = !!KCollectAllFor('ATTA','(match(name of spref,|/MDS/|)) gt 0 ',=0/0)

  !CE = !!CE
  do !Process values !Attas
    !!CE = !Process
    !Despar = Despar
    if !Despar.set() then
      !!MdsSetNonUser(!!CE)
    endif
  enddo
  !!CE = !CE

endfunction

-- End of file Mdssetnonmdb.pml
