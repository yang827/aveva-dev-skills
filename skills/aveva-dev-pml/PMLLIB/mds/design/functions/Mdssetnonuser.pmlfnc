--
-- File             : Mdssetnonuser.pmlfnc
--   Type           : Function Definition
--   Group          : Multi Discipline Supports Application
--     Keyword      : MDS
--   Module         : design
--   Replaces       :
--
-- Author:          : Steve Robinson
-- Created:         : Oct 7 1997
--
--
-- Description:
-- set design parameters for a given attachement type and bore
--
----------------------------------------------------------------------------------
-- Arguments:
--    [#]   [R/RW] [Data Type] [Description]
--     1     R      DBREF       Reference of ATTA at which design params will be set
--
-- Return:
--    [Data Type]   [Description]
--
-- Define Function
define function !!mdsSetNonUser(!atta is DBREF) is BOOLEAN

  !currentunits = !!kgetsetunits()

  -- Save current despars
  !despars = despar
  handle (2,201) (2,252)
    !!kRestoreUnits(!currentunits)
    return error 1 |Unable to set non user parameters for current element|
  endhandle

  -- Is it a support atta

  !spref = Spref
  if !spref.name.string().match('/MDS').neq(1) then
    !!kRestoreUnits(!currentunits)
    return error 1 |Selected atta is not a support|
  endif

  -- Is there any non user attributes

  !unusedtest = '$!despars[1]'
  handle any
    !!kRestoreUnits(!currentunits)
    return error 1 |No non user definable defaults associated with this support type|
  endhandle


  -- Run MdsSetDespars to reset all design parameters

  !!noExpMessage = false
  !!mdsSetDesPars(!!ce)
  !!noExpMessage = true

  -- Find out which despars are user definable and reset them

  -- if its a spring only get first four chars of stype

  !stype = styp

  if(!stype inset('SP01A','SP02A','SP03EA','SP03FA')) then
    !stype = !stype.before('A')
  elseif(!stype.match('SU01').neq(0) or !stype.match('SU02').neq(0)) then
    -- get the stype without '-'
    !stypeNew = !stype.before('-') & !stype.after('-').before('-') & !stype.substring(-1,1)
    !stype = !stypeNew
  elseif !stype.match('AC17-').neq(0) then
    -- get the stype without '-'
    !stypeNew = !stype.before('-') & !stype.after('-').before('-') & !stype.substring(-1,1)
    !stype = !stypeNew
  endif

  -- check if this atta type has been defined in parameters file
  !check = !!mdsPAR$!stype
  handle any
    !!kRestoreUnits(!currentunits)
    return
  elsehandle none
  endhandle

  !nomBore = !!ce.catref.param[1]

  -- The handle has been added because of the addition of the trunnion object that
  -- does not have a userdps object
  !resetPars = !check[$!nomBore].userdps
  handle any
    !!kRestoreUnits(!currentunits)
    return
  endhandle


  !expressions = !check[$!nomBore].despars
  handle any
    !!kRestoreUnits(!currentunits)
    return
  endhandle

  !!mdsDacControl(TRUE)

  do !reset indices !resetPars
    despar n $!reset  $!despars[$!reset]
  enddo

  -- cycle through default design parameter values and execute any DP expressions
  do !index index !expressions
    if (!expressions[!index].match('(') neq 0) then
      -- this DP is an expression, re-execute incase DP set above is contained in the expression
      -- Replace DESP string in default with the despar varaible (work with
      -- current attribute dimensions not default
      !newPars = !expressions[$!index].replace('DESP','$$!despars')
      DESPAR N $!index  $!newPars
    endif
  enddo

  !tempList = !!mdsExpDflts.reports.dtext
  !num = !!mdsExpDflts.reports.dtext.size()
  !num = !num + 1
  !attaName = !atta.name
  !tempList.append('[$!num] Des Dims - Set non user parameters to default for $!attaName')
  !!mdsExpDflts.reports.dtext = !tempList
  !numOff = !!mdsExpDflts.reports.dtext.size()
  !selectLast = !!mdsExpDflts.reports.dtext[$!numOff]
  !!mdsExpDflts.reports.select('DTEXT','$!selectLast')

  !!mdsDacControl(FALSE)

  -- Reset Units
  !!kRestoreUnits(!currentunits)

endfunction
