-- Define Function
define function !!MdsSetNote(!form is FORM)

-- Load form before using for first time

  if undefined(!!Note3dexplicit) then
    pml load form !!Note3DExplicit
  endif

  !ce = !!CE

-- Show edg position for for Note

  !!CE = !!MdsAncNote.Ancill.Selection().dbref()
-- If the note text is unset then abort

  if !!CE.:MDSNote.eq('unset') then
    !!CE = !ce
    !!Alert.Error('Cannot modify the note position as there is no note')
    return
  endif

  !!Note3dexplicit.Note3dexplicit()
  !!Note3dexplicit.setup(!!CE)
  !!Note3dexplicit.edit(!!CE)

  !!CE = !ce

  endfunction
-- End of function

-- End of file MdsSetNote.pml
