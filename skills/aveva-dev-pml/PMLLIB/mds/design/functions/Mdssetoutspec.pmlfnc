--
-- Description:
-- Function to set the form.inout gadget to the name of the out spec
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
--    [1]   [R]      [GADGET]      [Gadget of TT0* form]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------




define function !!MdsSetOutSpec(!Gadget is Gadget)

  !Gadget = !!kdmsTubeSel.Specs.Selection().dbref()

endfunction

-- end function MdsSetOutSpec
