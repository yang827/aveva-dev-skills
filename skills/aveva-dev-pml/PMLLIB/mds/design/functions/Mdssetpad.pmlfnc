-- Define Function
  define function !!Mdssetpad(!Form is FORM)

-- Initialise variables
    !Datum   = !Form.Support.Datum
    !Spref   = !Form.Support.Datum.Spref.Name

-- Set despar 2 for pad thickness.

    !!CE = !Form.Support.Datum
    despar n2 $!Form.Padt.val

-- End function
  endfunction

