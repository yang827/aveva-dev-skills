--
-- File             : Mdssetparpars.pml
--   Type           : Function Definition
--   Group          : Multi Discipline Supports Application
--     Keyword      : MDS
--   Module         : paragon
--   Replaces       :
--
-- Author:          : Steve Robinson
-- Created:         : Nov 18th 1997
--
--
-- Description:
-- set paragon model design paramters for a given support type and bore
--
----------------------------------------------------------------------------------
-- Arguments:
--    [#]   [R/RW] [Data Type] [Description]
--     1     R      STRING      Support type e.g. AT01,GT01,AN02...
--     1     R      REAL        Nominal Bore of associated pipe
--
-- Return:
--    [Data Type]   [Description]
--
-- Define Function
define function !!MdsSetParPars(!SupType is STRING, !NB is REAL) is BOOLEAN

  -- check if this support type has been defined in parameters file
  !Check = !!MdsPAR$!SupType
  handle any
    !!Alert.Error('Support type "$!SupType" not found in the parameters array')
    return false
  endhandle

  -- get despars for this size and type
  !DesPars = !!MdsPAR$!SupType$n[$!NB].Despars
  handle any
    !!Alert.Warning('Design paramters have not been defined for support "$!SupType" with N.B. $!NB')
    return false
  endhandle

  $* set model design parameters for Scomponent
  -- cycle through default design parameter values and ignore any DP expressions (set to ZERO)
  do !Index index !DesPars
    if (!DesPars[!Index].Match('(') neq 0) then
      -- this DP is an expression, set value to ZERO and re-evaluate later
      MODEL SET DESIGN PARAM $!Index 0
    else
      MODEL SET DESIGN PARAM $!Index $!DesPars[$!Index]
    endif
  enddo

  -- cycle through default design parameter values and execute any DP expressions
  do !Index index !DesPars
    if (!DesPars[!Index].Match('(') neq 0) then
      -- this DP is an expression, substitute despar values into expression
      !Expression = !DesPars[!Index]
      do
        if (!Expression.Match('[') neq 0) then
          -- locate despar[n] in expression and substitue with actual value
          !Before  = !Expression.Before('DESP[')
          !After   = !Expression.After(']')
          !DPIndex = !Expression.After('[').Before(']').Real()
          !DPValue = !DesPars[!DPIndex]
          -- substitute the required DP value into the expression
          !Expression = !Before + !DPValue + !After
        else
          break
        endif
      enddo
      -- evaluate the final expression
      !Eval = ($!Expression)
      MODEL SET DESIGN PARAM $!Index $!Eval
    endif
  enddo

  return true

-- End function
endfunction

-- End of file Mdssetparpars.pml
