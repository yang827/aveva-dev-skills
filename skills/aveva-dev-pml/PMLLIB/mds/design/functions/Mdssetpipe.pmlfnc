--
-- File:		Mdssetpipe.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MSETPIPE
--
-- Author:		I.Osborne
-- Created:		Wed Apr 30
--
--
-- Description:
-- function to set default pipework type
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetPipe()

  -- Initialise variables
    !Setting = !!MdsOptions.ptype.val

  -- Set gadgets
    if (!Setting eq 1) then
      !!MdsOptions.Pipes = |TUBE|
    else
      !!MdsOptions.Pipes = |FTUB|
    endif

-- End function
endfunction

-- End of file Mdssetpipe.pml
