--
-- File:                Mdssetsize.pml
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:
--
-- Author:              N.Morris
-- Created:             Mon Aug 24
--
--
-- Description:
-- Initialisation for the steelwork sizes
--
----------------------------------------------------------------------------------
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      CREATE or SELECT
--     2     R         FORM        Form name
--     3     R         FORM        Cross bar suffix
--     4     R         FORM        Vertical suffix
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
-- Define Function
define function !!MdsSetSize(!Mode is STRING,!Form is FORM,!Cross is STRING,!Vert is STRING)

 -- Create list

  if !Mode eq 'CREATE' then
    !Form.Size.Clear()
    !Dtext = ARRAY()
    !Rtext = ARRAY()

 -- Collect bar sizes
    !BTypes = !!KCollectAllFor('SCTN', '((match(name, |$!Cross|) gt 0) and type of owner eq |FRMW|)', !!CE)
    !Block = object block('!BTypes[!EvalIndex].Spref.Catref.:MDSSizeTag')
    -- !Block = object block('!BTypes[!EvalIndex].Owner.Owner.Desc')
    !BDtext = !BTypes.evaluate(!Block)

 -- Collect vert sizes

    !VTypes = !!KCollectAllFor('SCTN', '((match(name, |$!Vert|) gt 0) and type of owner eq |FRMW|)', !!CE)
    !VBlock = object block('!VTypes[!EvalIndex].Spref.Catref.:MDSSizeTag')
    -- !VBlock = object block('!VTypes[!EvalIndex].Owner.Owner.desc')
    !VDtext = !VTypes.evaluate(!VBlock)

 -- If the sizes are the same display one size if not display both sizes
 -- in the display text. Set the rtext values to a numerical list.

    do !I from 1 to !BDtext.size()
      if !BDText[!I] eq !VDText[!I] then
        !Dtext.append(!BDText[!I].string())
      else
        !Dtext.append(!BDText[!I].string() + ' & ' + !VDText[!I].string())
      endif
      !Rtext.append(!I.string())
    enddo

    !Form.Size.Dtext = !Dtext
    !Form.Size.Rtext = !Rtext

  else

 -- Collect steel size

    !BarName = !!CE.name + !Cross
    !VerName = !!CE.name + !Vert
    !BarSpref = !BarName.dbref().spref.catref.:MDSSizeTag
    !VerSpref = !VerName.dbref().spref.catref.:MDSSizeTag
    -- !BarSpref = !BarName.dbref().Owner.Owner.Desc
    -- !VerSpref = !VerName.dbref().Owner.Owner.Desc

    if !BarSpref eq !VerSpref then
      !SelectString = !BarSpref
    else
      !SelectString = !BarSpref + ' & ' + !VerSpref
    endif

    !Form.Size.select('DTEXT', !SelectString)

  endif

endfunction
