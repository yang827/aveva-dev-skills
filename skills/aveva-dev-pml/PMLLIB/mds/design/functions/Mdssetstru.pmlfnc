--
-- File:		Mdssetstru.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MSETMOD
--
-- Author:		I.Osborne
-- Created:		Wed Apr 30
--
--
-- Description:
-- function to set default steelwork type
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetStru()

  -- Initialise variables
    !Setting = !!MdsOptions.stype.val

  -- Set gadgets
    if (!Setting eq 1) then
      !!MdsOptions.Structure = |SCTN|
    else
      !!MdsOptions.Structure = |BOX|
    endif

-- End function
endfunction

-- End of file Mdssetstru.pml
