--
-- Author:		Andrew Kirkland
-- Created:		Wed 29 Apr 1998
--
--
-- Description:
-- Function to set the correct styp for the slip unit selected.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
--    [1]   [R]      [STRING]      [Slip Unit Type SU01 / SU02]
--
-- Return:
--    [Data Type]   [Description]
--
--    [String]      [Return Stype of SLIP Units]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsSetSUnits(!SuppType is string) is string


-- Initailise Variables

  if !SuppType.eq('SU01') or !SuppType.eq('SU02') then

   !SelectionSunit = !!Mds$!<SuppType>.Stype
   !Type           = !SelectionSUnit.upcase().After('TYPE').Before('SIZE').trim()
   !Size           = !SelectionSUnit.upcase().After('SIZE').trim().substring(1,1)
   !Stype          = !Supptype & '-' & !Type & '-' & !Size

  else
   !Stype = !SuppType
  endif

 Return !Stype


-- End function
endfunction

-- End of file MdssetSunits.pml
