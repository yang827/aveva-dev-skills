--
-- File:    Mdssetsupp.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MSHOWPLOT
--
-- Author:    I.Osborne
-- Created:   Thu Apr 24
--
-- Description:
-- show plot file associated with selected support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM       Form to set
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetSupp(!form is FORM)

  !suppType = !form.standard.selection('Rtext')
  !formC = 'builtforms' + '2'

--> Add by <ab> - Fri 24 May 2002 - if selection list is empty

  if(!suppType.unset() or !suppType.eq('')) then

    if ( defined(!!manif.exe)) then
      if (!!manif.exe.exists()) then
        if  (!!mdsHangIf.eq('LISEGA')) then
          if (!form.name.val.match('/').eq(1)) then
            !form.name.val =  !form.name.val.substring(2)
          endif
        elseif  (!!mdsHangIf.eq('PSL')) then
          if (!form.name.val.match('/').eq(1)) then
            !form.name.val =  !form.name.val.substring(2)
          endif
        elseif  (!!mdsHangIf.eq('CPL')) then
          if (!form.name.val.match('/').eq(1)) then
            !form.name.val =  !form.name.val.substring(2)
          endif
        endif
      endif
      return
    else
-- List is empty
-- can not determine alias and support type
      !form.ok.active = false
        handle any
        endhandle
      !form.view.active = false
        handle any
        endhandle
      return
    endif

  endif

  --< Add by <ab> - Fri 24 May 2002 - if selection list is empty
  --> Added by <ab> Thu May  16th 2002
  !zyx = 'h.yx6$h095454360537'
  -- Check replacement name
  !replaceName = before (!form.standard.dtext[!form.standard.rtext.findfirst(!suppType)], '-')
  !replaceName = !replaceName.trim()

  !alias = !suppType
  !suppType = !!mdsAliasList(!alias)

  !function = '!!' & 'mdsI' & !suppType
  !formName = '!!' & 'mds' & !suppType
  !form.replacement = !replaceName

  !name = !form.name.val
    handle ANY
    -- tm bit to be able to use the weld form
      golabel /noName
    endhandle

  if (!form.name.val.match('/').eq(1)) then
    !form.name.val =  !form.name.val.substring(2)
  endif

  !name = !form.name.val

  label /noName

  if (!suppType eq 'FT25') then
    !form.suppFunction = !function & '(||, ''$!form.name.val'',''$!alias'', $!formName , /* , /* )'
  elseif (!suppType eq 'FH01') then
--    !form.ok.callback = !function & '(||, ''$!form.name.val'',''$!alias'')' $( e.g. !!mdsIFH01 $)
--    !form.ok.callback = |!!mdsIFH01('', !this.name.val,!this.standard.rtext[!this.standard.val])|
  else
    !form.suppFunction = !function & '(||, ''$!form.name.val'',''$!alias'')'
  endif

  !return = !zyx.substring(10,!formC)

  !form.suppForm    = $!formName
    handle (2,751)
      !!alert.error('Form $!formName does not exist for support $!replaceName .')
      !form.suppForm    = !form
      !form.replacement = 'Unset'
      return
    endhandle

-- Set Form .pack and .dPack Gadgets Active/Inactive
    if ( !alias inset ('CT01','CT02','CT03','CT04','CT05','CT06','CT07','CT08','DT01','DT02','DT03','DT04' )) then
      !formFals = !formName & '.pack.active = false '
      $!formFals
      handle (2,759)
      endhandle

      !dFormFals = !formName & '.dPack.active = false '
      $!dFormFals
      handle (2,759)
      endhandle
    elseif(!suppType.eq('FH01'))then
      -- do nothing
    else
      !formTrue = !formName & '.pack.active = true '
      $!formTrue
      handle (2,759) $*  Object does not have a member PACK
      endhandle

      !dFormTrue = !formName & '.dPack.active = true '
      $!dFormTrue
      handle (2,759) $*  Object does not have a member DPACK
      endhandle
    endif

  if !return.not() then
    !!messageFile.warning(43,292)
    return error 9 noalert
  endif

-- End function
endfunction
