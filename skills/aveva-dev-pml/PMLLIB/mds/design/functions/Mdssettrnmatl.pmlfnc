--
-- File: Mdssettrnmatl.pmlfnc
--   Type:              Process
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            Design
--   Replaces:
--
-- Author:              Andrew Kirkland
-- Created:             17 Mar 1998
--
--
-- Description:
-- Function to set the mtor reference to the spre of the current pipe spec
-- or out of spec if required, for  extra details on the isometric.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       [DBREF]       [Atta to set spre details to]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

define function !!mdsSetTrnMatl(!form is FORM, !atta is DBREF)

-- where are you
   !currentPos = !!ce

-- Goto Atta
   !!ce = !atta

-- Initialise variables
--   !attaSpre = !atta.spref
--   !bran     = !atta.owner

   if(!form.material.selection().eq('INSPEC')) then
      !branSpc  = !atta.owner.pspec
   else

      -- Bran spec becomes the selection from out spec selection
      -- Use this form for both spec and spco of tube selection

      !branSpc = !!mdsTubeSel.specs.selection().dbref()

   endif
   !attaType = !atta.:MDSSuppType
   !tube     = |TUBE|
   if(!attaType.empty()) then
      -- get from the stype
      !attaType = !atta.styp.before('-')
   endif
-- Bore size of the trunnion is para[5] for TT02 and para[4] for TT01/03, So:-
   if(!attaType.eq('TT02')) then
      !para = 5
   else
      !para = 4
   endif

   !bore     = !atta.para[!para]

-- From passed spec get tubing selection or trunnion bore size
   !selection = ARRAY()
   if(!!mdsManGetSpre(!branSpc,!tube,!bore,!selection)) then
      if(!selection.size().eq(1)) then
         !!mdsSetMtor(!selection[1])
      else
       !dText = ARRAY()
       !rText = ARRAY()
       !!mdsTubeSel.specs.clear()
       !!mdsTubeSel.specs.clear()

      do !ind indices !selection
       !dText.append(!selection[!ind].name.string() & '  ' & !selection[1].detr.rText)
       !rText.append(!selection[!ind].name.string())
      enddo

      !!mdsTubeSel.specs.dText = !dText
      !!mdsTubeSel.specs.rText = !rText


-- set action for form .specDbref will be unset and handled in setMtor
      !!mdsTubeSel.action.clear()
      !!mdsTubeSel.action[1] = |call !!mdsSetMtor(!!mdsTubeSel.specDbref)|
      !!mdsTubeSel.action[2] = ||

      !!kShowForm(!!mdsTubeSel)

      endif
   endif

-- Go back to original element
   !!ce = !currentPos

endfunction
