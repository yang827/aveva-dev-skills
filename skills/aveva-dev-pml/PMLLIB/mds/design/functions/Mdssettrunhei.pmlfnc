--
-- File: Mdssettrunhei.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Neale Morris
-- Created: Thursday 12th February 1998
--
-- Description:
-- Function to set the length of a trunnion
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      Length
--     2     R         DIRECTION   Direction of trunnion
--     3     R         POSITION    Start Position
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetTrunHei(!form is FORM)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Set pin 9 to lower od of trunnion
  !!ce = !form.support.datum
  bran

  --><wd>17mar2009 - Defect No. 16924
  -- Determine the Pipe and Trunnion Weld Values at the ATTA/PLAT elements from the Specific MDSSELECTION object
  !trunnionBranch = !!ce
  if (!trunnionBranch.:mdsTrun) then
    !members = !trunnionBranch.members
    do !element values !members
      if (!element.type.eq('ATTA') and !element.atty.eq('')) then
        skip if !element.name.matchwild('*/SREF')
        !!mdsNWelds(!element)
      elseif (!element.type.eq('PLAT')) then
        !!mdsNWelds(!element)
--><wd>26jun2009 - Defect No. 22278
-- Determine the Pipe Weld Value for a Trunnion attached to the MAIN PIPE at the MDS Trunnion REDU element from the Specific MDSSELECTION object
-- This 'VIRTUAL' MDS Trunnion REDUCER element which is 'WELDED' to the MAIN PIPE for ISOMETRIC/SPOOLER WELD NUMBERING purposes
      elseif ((!element.type.eq('REDU')) and (!element.spref.name.matchwild('*/MDS/.*MAKEUP*')) ) then
        !!mdsNWelds(!element)
--<<wd>26jun2009 - Defect No. 22278
      else
        skip
      endif
    enddo
  endif
  --<<wd>17mar2009 - Defect No. 16924

  -- Find SREF ATTA because DATUM ATA has a PLATE bigger than the Pipe OD
  !suppName = !!mdsGetSuppName(!!ce)
  !sref = !suppName + '/SREF'
  !!ce = !sref.dbref()
  pin 9 at ph
  pin 9 dir d wrt /*
  pin 9 plane pin 9 clear 0 beh ce
  !plod = pl od
  pin 9 by d ($!plod / 2)
  pin 9 off

  -- Identify steel
  prompt off
  prompt load escape 'Identify steelwork to set trunnion to'
  --<wd>10jan2008 -- Defect No. P-4407
  --  ID BOX SCTN FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL PANE @
  ID BOX SCTN FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL PANE HSTIFF HPLATE @
  --<wd>10jan2008 -- Defect No. P-4407
  handle (61,528)
    prompt on
    !!kRestoreUnits(!currentunits)
    return FALSE
  endhandle
  prompt on
  pin 8 copy pin 9
  pin 8 plane d clear 0 inf ce

  -- Work out distance to move
  var !distance const dist pin 9 to pin 8

  !!ce = !form.support.datum
  bran

  var !dir const dir pin 9 to pin 8

  if !dir.neq('') then
    by $!dir $!distance
  endif

  -- Reset distance gadget
  bran

  goto href
  if !dir.neq('') then
    by $!dir $!distance
    var !dist const dist p0 to pl of prev
    handle (2,113)
      var !dist const dist p0 to ph
    endhandle
    !!mdsTT17.dist.val = !dist.real()
    same
  endif
  !!mdsResetPins(8,9)
  !!kRestoreUnits(!currentunits)

endfunction
