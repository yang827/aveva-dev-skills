--
--
-- Description:
-- PML Function for set  the tray width
--
--------------------------------------------------------------------------------

define function !!mdsSetWid() is REAL

  ------------------------------------------------------------------------------------
  -- NOTE: Calculations are carried out for the Current Element and NOT the DATUM ATTA
  ------------------------------------------------------------------------------------
  -- Calculate the Width Adjustment
  !current = !!ce
  goto catref
  cata
  !cataName = !!ce.name
  !!ce = !current

  if !cataName.match('VANTRUNK').gt(0) or !cataName.match('OGLAEND').gt(0) then

    !rack = !!ce
    new atta /tempRackRest
    desp 0 0
    sel spref with styp 'RACK-REST' spec /MDS
    fconn
    pin 8 copy p10
    pin 9 copy p11
    /tempRackRest
    delete atta
    !!ce = !rack

    pin 9 clear 0 behind ce
    pin 8 clear 0 behind ce

    !width = !!kStrReal('Const dist pin 9 to pin 8')

  else

    pin 9 copy P10
    handle (42,94)(61,53)
      pin 9 copy p3
      handle (42,94)
        --<RM> P-35784 04/03/2011 added this handle block to correctly set width if the tray has no P3 ppoint
        !paras = !!ce.catref.para
        var !width $!paras[1]
        return !width.real()
      endhandle
      var !dir const dir p3 to p4
      handle (2,201)
        --<RM> P-35784 04/03/2011 added this handle block to correctly set width if the tray has no P4 ppoint
        !paras = !!ce.catref.para
        var !width $!paras[1]
        return !width.real()
      endhandle
      pin 9 dir $!dir
    endhandle
    pin 8 copy P10
    handle (42,94)(61,53)
      pin 8 copy pin 9
    endhandle
    pin 8 dist -10
    pin 8 dir from pin 9 to pin 8
    pin 9 clear 0 behind ce
    pin 8 clear 0 behind ce
    !width = !!kStrReal('Const dist pin 9 to pin 8')

    -- Calculate the Height Adjustment
    pin 9 copy p9
    handle (42,94)(61,53)
      pin 9 copy p3
    endhandle
    --  pin 8 copy p9
    pin 8 copy p0
    handle (42,94)(61,53)
      pin 8 copy pin 9
    endhandle
    pin 9 clear 0 behind ce
    pin 8 clear 0 infront ce
    -- (ak) height not used.
    -- !height = !!kStrReal('Const dist pin 9 to pin 8')

  endif

  Call !!mdsResetPins(8,9)

  return !width

endfunction
