--   Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:      T.martin
-- Created:     15/09/2004 11:55
--
--
-- Description:
-- Show the associated connections for Framatome cable supports
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         DBREF       support as a dbref
--     2     R         BOOLEAN      true to add labels/false to remove them
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsShowFRconn(!stru is dbref,!action is BOOLEAN)
!save = !!ce
!basenumber = !stru.refno.string().after('/').real()
-- if action is true then display the aid lines
var !fitt coll all fitt for $!stru
do !a index !fitt
  !number = !basenumber + !A
  if !action then
   -- display aid text at the fitting
   !!ce = !fitt[!a].dbref()
   !cref = !!ce.cref
   if !cref.unset() or !cref.badref() then
    aid text number $!number 'unset' at $!!ce.position
   else
    aid text number $!number 'Connected' at $!!ce.position
   endif
  else
   -- hide aid text at the fitting
   aid clear text $!number
  endif
enddo

!!ce = !save

endfunction
