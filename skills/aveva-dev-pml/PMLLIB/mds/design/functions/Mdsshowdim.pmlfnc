    !show1 = true
    !show2 = true
    !show3 = true
    !show4 = TRUE
    if !form.dim5.val.neq(0) then
      !show5 = TRUE
    endif
    if !form.dim6.val.neq(0) then
       !show6 = TRUE
    endif

  elseif !method.eq(29) then

    -- FT56
    -- Dim 1 is overall either size of datum, default 1000mm
    -- Dim 2 is !form.support.p10dir, default 500mm
    -- Dim 3 is vertical dimension using p10dir, default 1000mm
    -- Dim 4 is vertical dimension using p11dir, default 1000mm

    -- Check to see if dimension are set, if so overwrite defaults

    if !form.dim1.val.neq(0) then
      !dim1 = !form.dim1.val
    endif
    if !form.dim2.val.neq(0) then
      !dim2 = !form.dim2.val
    endif
    if !form.dim3.val.neq(0) then
      !dim3 = !form.dim3.val
    endif
    if !form.dim4.val.neq(0) then
      !dim4 = !form.dim4.val
    endif

    !origin = object POINTVECTOR()
    -- !origin.position = !form.support.datum.ppos[9]
    pin 9 at $!form.support.stru
    pin 9 dir u wrt /*
    --pin 9 plane pin 9 clear 0 beh $!form.support.stru.name$n-BAR-1
      --handle ANY
        pin 9 at $!form.support.datum
        pin 9 plane pin 9 thro $!form.support.stru.name$n/DATUM
        !origin.position = !form.support.datum.position
      --elsehandle NONE
        --!origin.position = !form.support.stru.position
      --endhandle
    var !pin9pos pin 9 pos wrt /*
    !origin.position = $!pin9pos
    !origin.direction = !form.support.p10dir
    pin 9 off

    -- Dimension 1 start
    !line1 = !origin.line(!dim2)
    !dim1S = object POINTVECTOR()
    !dim1S.position = !line1.endposition
    !dim1S.direction = u WRT /*
    --!dim1S.direction = !form.support.p9dir

    -- Dimension 1 end
    !line2 = !origin.line(!dim2 - !dim1)
    !dim1E = object POINTVECTOR()
    !dim1E.position = !line2.endposition
    !dim1E.direction = u WRT /*
    -- !dim1E.direction = !form.support.p9dir

    -- Dimension 2 start
    !dim2S = !dim1S

    -- Dimension 2 end
    !dim2E = object POINTVECTOR()
    !dim2E.position = !line1.startposition
    !dim2E.direction = u WRT /*
    --!dim2E.direction = !form.support.p9dir

    -- Dimension 3 start
    !dim3S = object POINTVECTOR()
    !dim3S.position = !line1.endposition
    !dim3S.direction = !form.support.p10dir

    -- Dimension 3 end
    !constt = !dim3S
    var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum
    -- !constt.direction = !p3p9dir.direction()
    !constt.direction = d WRT /*
    !line2 = !constt.line(!dim3)
    !dim3E = object POINTVECTOR()
    !dim3E.position = !line2.endposition
    !dim3E.direction = !origin.direction

    -- Dimension 4 start
    !dim4S = !dim1E
    !dim4S.direction = !form.support.p11dir

    -- Dimension 4 end
    !constt = !dim4S
    !constt.direction = !p3p9dir.direction()
    !constt.direction = d WRT /*
    !line3 = !constt.line(!dim4)
    !dim4E = object POINTVECTOR()
    !dim4E.position = !line3.endposition
    !dim4E.direction = !form.support.p11dir

    !show1 = true
    !show2 = true
    !show3 = TRUE
    !show4 = TRUE
    !show5 = FALSE

  elseif !method.eq(30) then

    -- Dim 1 is from cl of pipe to start of steel
    -- Dim 2 is from cl of pipe to start of steel
    -- Dim 3 is clearance

    -- Check to see if dimension are set, if so overwrite defaults
    !offset2 = 600mm

    if !form.dim1.val.neq(0) then
      !dim1 = !form.dim1.val
    endif
    if !form.dim2.val.neq(0) then
      !dim2 = !form.dim2.val
    endif
    if !form.dim3.val.neq(0) then
      !dim3 = !form.dim3.val
    endif

    !origin = object POINTVECTOR()
    !origin.position = !form.support.datum.ppos[0]
    !origin.direction = !form.support.p9dir
    var !p3p9dir const direction p10 of $!form.support.datum to p11 of $!form.support.datum

    -- Dimension 1 start

    !line1 = !origin.line(!dim1)
    !dim1S = object POINTVECTOR()
    !dim1S.position = !line1.endposition
    !dim1S.direction = !p3p9dir.direction()

    -- Dimension 1 end
    !line2 = !origin.line(!dim2 - !dim1)
    !dim1E = object POINTVECTOR()
    !dim1E.position = !line1.startposition
    !dim1E.direction = !p3p9dir.direction()

    -- Dimension 2 start
    !dim2S = !dim1E

    -- Dimension 2 end
    !dim2E = object POINTVECTOR()
    !line3 = !origin.line(!dim2 * -1)
    !dim2E.position = !line3.endposition
    !dim2E.direction = !p3p9dir.direction()

    -- Dimension 3 start
    !dim3S = object POINTVECTOR()
    !dim3S.position = !line1.startposition
    !dim3S.position = !form.support.datum.ppos[10]
    var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum
    -- !dim3S.direction = !form.support.p9dir
    !dim3S.direction = !p3p9dir.direction()

    -- Dimension 3 end
    !constt = !dim3S
    var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum
    !constt.direction = !form.support.p10dir
    !line2 = !constt.line(!dim3)
    !dim3E = object POINTVECTOR()
    -- !dim3E.position = !line2.endposition
    !dim3E.position = !form.support.datum.ppos[10]
    !line4 = !dim3S.line(!dim3)
    !dim3E.position = !line2.endposition
    -- !dim3E.direction = !form.support.p9dir
    !dim3E.direction = !p3p9dir.direction()

    !show1 = true
    !show2 = TRUE
    !show3 = FALSE
    !show4 = false
    !show5 = false

  elseif !method.eq(31) then

    !dim1 = !form.dim1.val
    !stru = !form.support.stru
    !xdir = !stru.ori.xdir()
    !ydir = !stru.ori.ydir()
    !datum = !form.support.datum
    !pos = !datum.ppos[9]
    !offset1 = 200mm + !datum.lod * 0.5

    !dim1S = object POINTVECTOR(!pos.offset(!ydir,!dim1 * 0.5),!xdir)
    !dim1E = object POINTVECTOR(!pos.offset(!ydir,!dim1 * -0.5),!xdir)

    !show1 = true
    !show2 = false
    !show3 = false
    !show4 = false
    !show5 = false

  elseif !method.eq(32) then

    if !form.dim1.val.neq(0) then
      !dim1 = !form.dim1.val
    endif
    if !form.dim2.val.neq(0) then
      !dim2 = !form.dim2.val
    endif

    !stru = !form.support.stru
    !xdir = !stru.ori.xdir()
    !zdir = U wrt world
    !datum = !form.support.datum
    !pos = !datum.ppos[9]
    !offset2 = 300mm
    !offset1 = !offset2 + 200mm

    !dim1S = object POINTVECTOR(!pos.offset(!zdir,!dim1 - !dim2),!xdir)
    !dim1E = object POINTVECTOR(!pos.offset(!zdir,-!dim2),!xdir)

    !dim2S = object POINTVECTOR(!pos,!xdir)
    !dim2E = !dim1E

    !show1 = true
    !show2 = true
    !show3 = false
    !show4 = false
    !show5 = false

  endif

-------------------------------------------------------------------------------------------------
--
--  Now show dimensions if required to be shown
--
-------------------------------------------------------------------------------------------------

  if !type.eq(1) then

-- Type = 1 framework

    if !show1 then

      if !form.dim1.val.nint().eq(0) then
        !dim1Text = |Dim 1|
      else
        if !alias.eq(|FT24|) then
          !dim1Text = |Dim 1 (| + !form.dim1.selection(|RTEXT|) + |)|
        else
          -- !dim1Text = |Dim 1 (| + !form.dim1.val.nint().string() + |)|
          !dim1Text = |Dim 1 (| + !form.dim1.val.string(!!distancefmt) + |)|
        endif
      endif

      !!mdsdimline(!dim1S,!dim1E,25mm,!offset1,!dim1Text,260,.5)

    endif

    if !show2 then

      if !form.dim2.val.nint().eq(0) then
        !dim2Text = |Dim 2|
      else
        !dim2Text = |Dim 2 (| + !form.dim2.val.string(!!distancefmt).string() + |)|
      endif

      !!mdsdimline(!dim2S,!dim2E,25mm,!offset2,!dim2Text,266,.5)

    endif

    if !show3 then

      if !form.dim3.val.nint().eq(0) then
        !dim3Text = |Dim 3|
      else
        !dim3Text = |Dim 3 (| + !form.dim3.val.string(!!distancefmt).string() + |)|
      endif

      !!mdsdimline(!dim3S,!dim3E,25mm,!offset3,!dim3Text,272,.5)

    endif

    if !show4 then

      if !form.dim4.val.nint().eq(0) then
        !dim4Text = |Dim 4|
      else
        !dim4Text = |Dim 4 (| + !form.dim4.val.string(!!distancefmt).string() + |)|
      endif

      !!mdsdimline(!dim4S,!dim4E,25mm,!offset4,!dim4Text,278,.5)

    endif

    if !show5 then

      if !form.dim5.val.nint().eq(0) then
        !dim5Text = |Dim 5|
      else
        !dim5Text = |Dim 5 (| + !form.dim5.val.string(!!distancefmt).string() + |)|
      endif

      !!mdsdimline(!dim5S,!dim5E,25mm,!offset5,!dim5Text,284,.5)

    endif

    if !show6 then

      if !form.dim6.val.nint().eq(0) then
        !dim6Text = |Dim 6|
      else
        !dim6Text = |Dim 6 (| + !form.dim6.val.string(!!distancefmt).string() + |)|
      endif

      !!mdsdimline(!dim6S,!dim6E,25mm,!offset6,!dim6Text,290,.5)

    endif


  else

-- Type = 2 hanger

    !aid1 = 260
    !aid2 = 265
    !offset1 = !tOffset.real() * 4
    !offset2 = !tOffset.real() * 2
    !offset3 = !tOffset.real() * 6

    do !showdim from 1 to 30 by 2 from 1
      !!mdsdimline(!dim$!showdim$nS,!dim$!showdim$nE,25mm,!offset1,!dim$!showdim$nText,!aid1,.5)
        handle any
          break
        endhandle
      !aid1 = !aid1 + 10
    enddo
    do !showdim from 1 to 30 by 2 from 2
      !!mdsdimline(!dim$!showdim$nS,!dim$!showdim$nE,25mm,!offset2,!dim$!showdim$nText,!aid2,.5)
        handle any
          break
        endhandle
      !aid2 = !aid2 + 10
    enddo

    !overallDim = !endposition.position.up - !startposition.position.up
    !!mdsdimline(!startposition,!endposition,25mm,!offset3,'Overall = ' + !overallDim.string(),355,.5)
    !!mdsdimline(!startposition,!endposition,25mm,!offset3,'Pipe CL = EL ' + !startposition.position.up.string(),355,0)
    !!mdsdimline(!startposition,!endposition,25mm,!offset3,'Top of Hanger = EL ' + !endposition.position.up.string(),355,1)

  endif

endfunction
