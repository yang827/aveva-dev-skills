    -- We have to work the origin direction out because
    -- we are not sure which way the atta has been directed
    -- This is not 100% but should work most of the time

    !!ce = !form.support.datum

    !direction = p10 dir wrt /*

    !origin.direction = p9 dir wrt /*
    if (!alias.eq('VT19')) then
      !origin.direction = drne of /$!form.name-BAR-1
    else
      !origin.direction = drns of /$!form.name-BAR-1
    endif

    var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum

    -- Dimension 1 start
    !line1 = !origin.line(!dim1)
    !dim1S = object POINTVECTOR()
    !dim1S.position = !line1.startposition
    !dim1S.direction = !direction

    -- Dimension 1 end
    !dim1E = object POINTVECTOR()
    !dim1E.position = !line1.endposition
    !dim1E.direction = !direction

    !show1 = true
    !show2 = false
    !show3 = false
    !show4 = false
    !show5 = false

  elseif !method.eq(17) then

    -- This will string a set of dimensions for a hanger

    !!ce = !form.support.datum
      handle any
        !!alert.error('Support not yet created')
      endhandle

    !origin = object POINTVECTOR()
    !origin.position = !form.support.datum.ppos[0]


    !direction = w
    -- !direction = p10 dir wrt /*

    !origin.direction = u

    goto cref
    handle any
      -- hanger is connected to a standard support
      -- current atta is a dummy atta for that hanger
      -- try to navigate to the hanger using the atta name
      !hangName = !!ce.name + '/H1'
      !!ce = !hangName.dbref()
      handle any
        !!alert.error('Cannot navigate to $!hangName')
        return
      endhandle
    endhandle

    -- goto restr
    rest
    var !numOfHangers mem hanger count
    do !hanger from 1 to !numOfHangers.real()
        -- do not dimension first hanger in a double hanger rest
        -- This type of hanger has three hanger members
        skip if(!hanger eq 1 and !numOfHangers.real() gt 1)
        hanger $!hanger

        !mem = mem count
        --!dimnum = 1

        !tOffset = ph bore

        --!pointvectorarray = ARRAY()

        do !dim from 1 to !mem

          hang
    --      !tpos = !!ce.tpos.up
          $!dim
          !arr = arr
          !lea = lea
          !origin.position = !!ce.ppos[$!arr]
          var !tdim$!dim const dist p$!arr to p$!lea

          !dim$!dim$nText = !tdim$!dim$n.real().string()
            handle any
              !dim$!dim$nText = !tdim$!dim$n.string()
            endhandle
          !dim$!dim$nText = !dim$!dim$nText + ' (' + !!ce.type + ')'

        -- Dimension start

          -- !line$!dim = !origin.line(!dim$!dim$nText$n.real())
          !line$!dim = !origin.line(!tdim$!dim$n.real())
            handle any
              !test = !tdim$!dim
              !line$!dim = !origin.line($!test)
            endhandle

          !dim$!dim$nS = object POINTVECTOR()
          !dim$!dim$nS.position = !line$!dim$n.startposition
          !dim$!dim$nS.direction = !direction

        -- Dimension end

          !dim$!dim$nE = object POINTVECTOR()
          !dim$!dim$nE.position = !line$!dim$n.endposition
          !dim$!dim$nE.direction = !direction

 --         !pointvectorarray.append(!dim$!dim$nE)

 --         q var !pointvectorarray

  --        if ((!dim$!dim$nS.position EQ !dim$!dim$nE.position) AND (!tpos EQ !!CE.pos.up)) then
  --          !arraySize = !pointvectorarray.size()

  --          !last = !arraySize - 1
  --           !endposition = !pointvectorarray[!last]
  --              if (!endposition EQ !pointvectorarray[!last]) then
  --            !last = !arraySize - 2
  --            endif
  --          !endposition = !pointvectorarray[!last]
  --          skip
 --         endif

          if !dim.eq(1) then
            !startposition = !dim1S
            if !dim.eq(!mem) then
              !endposition = !dim$!dim$nE
            endif
            elseif !dim.eq(!mem) then
            !endposition = !dim$!dim$nE
          endif

          if (!!ce.type eq 'RCPL') then
           !endposition = !dim$!dim$nS
             !show$!dim = true
           break
          endif

          if (!!ce.type eq 'VSPR') then
           !endposition = !dim$!dim$nS
       --    q var !endposition
             !show$!dim = true
           break
          endif

          !show$!dim = true

        enddo

        hang
        !aid1 = 260
        !aid2 = 265
        !offset1 = !tOffset.real() * 4
        !offset2 = !tOffset.real() * 2
        !offset3 = !tOffset.real() * 6

        do !showdim from 1 to 30 by 2 from 1
          !!mdsdimline(!dim$!showdim$nS,!dim$!showdim$nE,25mm,!offset1,!dim$!showdim$nText,!aid1,.5)
            handle any
              break
            endhandle
          !aid1 = !aid1 + 10
        enddo

        do !showdim from 1 to 30 by 2 from 2
          !!mdsdimline(!dim$!showdim$nS,!dim$!showdim$nE,25mm,!offset2,!dim$!showdim$nText,!aid2,.5)
            handle any
              break
            endhandle
          !aid2 = !aid2 + 10
        enddo

        !overallDim = !endposition.position.up - !startposition.position.up
        !!mdsdimline(!startposition,!endposition,25mm,!offset3,'Overall = ' + !overallDim.string(),355,.5)
        !!mdsdimline(!startposition,!endposition,25mm,!offset3,'Pipe CL = EL ' + !startposition.position.up.string(),355,0)
        !!mdsdimline(!startposition,!endposition,25mm,!offset3,'Top of Hanger = EL ' + !endposition.position.up.string(),355,1)
        rest
    enddo


  elseif !method.eq(20) then

    -- Dim 1 is overall from the datum to the vessel wall

    -- Check to see if dimension are set, if so overwrite defaults

    if !form.dim1.val.neq(0) then
      !dim1 = !form.dim1.val
    endif

    !origin = object POINTVECTOR()
    !origin.position = !form.support.datum.ppos[0]

    -- We have to work the origin direction out because
    -- we are not sure which way the atta has been directed
