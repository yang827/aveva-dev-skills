    !offset1 = 200mm
    !offset2 = 300mm
    !offset3 = 200mm

    !show1 = true
    !show2 = true
    !show3 = true
    !show4 = false
    !show5 = false

  elseif !method.eq(15) then

    -- Dim 1 is overall either size of datum, default 1000mm
    -- Dim 2 is !form.support.p10dir, default 500mm

    -- Check to see if dimension are set, if so overwrite defaults
    -- If alias is ft18 dim 0 may be set to 0 so check dim 2, set it to .5mm if so
    -- this will stop a zero divide with a zero dimension

    if !form.dim1.val.neq(0) then
      !dim1 = !form.dim1.val
