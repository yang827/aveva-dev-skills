--
-- File: Mdsshowdim.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Neale Morris
-- Created: Friday 15th Dec 2000
--
--
-- Description: Dimensions fixed for T-4 and Spring Hangers
-- Function to show the standards dimensions with the graphical aids
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- define function

define function !!mdsshowdim(!form is FORM)

--##############################################################################
-- ******************************
-- ******* IMPORTANT NOTE *******
-- ******************************
--<wd>27sep2007 -- Defect No. P-2330
--------------------------------------------------------------------------------
-- ALL occurrences of the syntax similar to -->
-- <variable>.direction = !p3p9dir.direction()
-- cause *** "ERROR (2,779) Method <DIRECTION>.UNARY -() not found" ***
-- when co-ordinates are set to "COORD XYZ",
-- e.g. -Y raises the ERROR when used as an expanded STRING DIRECTION variable "$!p3p9dir etc...
--
-- Therefore ALL occurrences of this syntax have been REPLACED with the syntax -->
-- <variable>.direction = !p3p9dir.direction()
-- in all of the PML function code below.
--------------------------------------------------------------------------------
--<wd>27sep2007 -- Defect No. P-2330
--##############################################################################


  -- Dimensions will user aid numbers between 260 and 360

  -- Datum atta must be created therefore check existence

    if !form.support.datum.badref() then
      !!alert.error('Datum atta must be created in order to display dimensions')
      return
    endif

   if !form.support.position.not() then
     !!alert.error('Position DATUM atta first.')
     return
   endif

  -- Set default dimensions if none are set on the form

    !dim1 = 1000mm
    !dim2 = 500mm
    !dim3 = 1000mm
    !dim4 = 1000mm
    !dim5 = 1000mm
    !dim6 = 500mm

  -- Set the display setting for each dimension

    !show1 = false
    !show2 = false
    !show3 = false
    !show4 = false
    !show5 = FALSE
    !show6 = FALSE

  -- Clear any previously displayed dimensions

    call !!mdsClearDim()

  -- Set standard Offset for dim 1 and 2

    !offset1 = 600mm
    !offset2 = 400mm
    !offset3 = 300mm
    !offset4 = 300mm
    !offset5 = 300mm
    !offset6 = 600mm

  -- Define method required dependent on standard

    !alias = !!mdsAliasList(!form.support.alias)

  -- Type setting for hanger via framework
  -- 1 = framework
  -- 2 = hanger

    !type = 1
    if !alias.eq('FT01') or !alias.eq('FT02') then
      !method = 1
    elseif !alias.eq('FT03') or !alias.eq('FT05') then
      !method = 3
    elseif !alias.eq('FT04') or !alias.eq('FT06') then
      !method = 4
    elseif !alias.eq('FT07') then
      !method = 5
    elseif !alias.eq('FT08') or !alias.eq('FT35') then
      !method = 2
    elseif !alias.eq('FT09') then
      !method = 1
    elseif !alias.eq('FT10') then
      !method = 6
    elseif !alias.eq('FT11') or !alias.eq('FT38') or !alias.eq('FT62') or !alias.eq('FT63') then
      !method = 7
    elseif !alias.eq('FT12') then
      !method = 2
    elseif !alias.eq('FT13') then
      !method = 8
    elseif !alias.eq('FT14') or !alias.eq('FT34') then
      !method = 8
    elseif !alias.eq('FT15') then
      !method = 9
    --elseif !alias.eq('FT17') then
    elseif !alias.eq('FT17') or !alias.eq('FT40') then
      !method = 10
    elseif !alias.eq('FT18') then
      !method = 3
    elseif !alias.eq('FT19') then
      !method = 4
--<dw>aug2008 dun979 - to include FT61 dimensioning
    elseif !alias.eq('FT23') or !alias.eq('FT57') or !alias.eq('FT61') then
      !method = 11
    elseif !alias.eq('FT24') then
      !method = 12
    elseif !alias.eq('GT05') then
      !method = 13
    elseif !alias.eq('FT16') then
      !method = 14
    elseif !alias.eq('FT29') then
      !method = 15
    elseif !alias.eq('FT31') then
      -- !method = 16
      !method = 4
    elseif !alias.eq('FT32') then
     -- !method = 16
      !method = 4
    elseif !alias.eq('FT33') then
      !method = 8
    elseif !alias.eq('VT07') or !alias.eq('VT11') or !alias.eq('VT12') then
      !method = 19
    elseif !alias.eq('VT15') then
      !method = 20
    elseif !alias.eq('VT17') then
      !method = 21
    elseif !alias.eq('FT41') then
      !method = 22
    elseif !alias.eq('VT10') then
      !method = 23
    elseif !alias.eq('VT13') or !alias.eq('VT14') or !alias.eq('VT16') or !alias.eq('VT18') or !alias.eq('VT19') then
      !method = 24
--> Added <ab> for fixed hangers
    elseif !alias.matchwild('FH*') then
      !method = 17
      !type = 2
    elseif !alias.matchwild('VH*') then
      !method = 18
      !type = 2
    elseif !alias.eq('FT42') then
      !method = 25
    elseif !alias.eq('FT30') then
      !method = 26
    elseif !alias.eq('FT43') then
      !method = 27
    elseif !alias.eq('FT51') then
      !method = 28
    elseif !alias.eq('FT52') then
      !method = 30
    elseif !alias.eq('FT69') then
      !method = 31
    elseif !alias.eq('FT70') then
      !method = 32
    else
      !!alert.error('Dimensioning facility unavailable for this standard, please refer to the relevant plot file')
      return
    endif

    if !form.support.alias.eq('FT56') then
      !method = 29
    endif

    -- $P type is $!type method is $!method

  if !method.eq(1) then

    -- Dim 1 is overall either size of datum, default 1000mm
    -- Dim 2 is !form.support.p10dir, default 500mm
    -- Dim 3 is vertical dimension using p10dir, default 1000mm
    -- Dim 4 is vertical dimension using p11dir, default 1000mm

    -- Check to see if dimension are set, if so overwrite defaults

    if !form.dim1.val.neq(0) then
      !dim1 = !form.dim1.val
    endif
    if !form.dim2.val.neq(0) then
      !dim2 = !form.dim2.val
    endif
    if !form.dim3.val.neq(0) then
      !dim3 = !form.dim3.val
    endif
    if !form.dim4.val.neq(0) then
      !dim4 = !form.dim4.val
    endif

    !origin = object POINTVECTOR()
    !origin.position = !form.support.datum.ppos[9]
    !origin.direction = !form.support.p10dir

    -- Dimension 1 start
    !line1 = !origin.line(!dim2)
    !dim1S = object POINTVECTOR()
    !dim1S.position = !line1.endposition
    !dim1S.direction = !form.support.p9dir

    -- Dimension 1 end
    !line2 = !origin.line(!dim2 - !dim1)
    !dim1E = object POINTVECTOR()
    !dim1E.position = !line2.endposition
    !dim1E.direction = !form.support.p9dir

    -- Dimension 2 start
    !dim2S = !dim1S

    -- Dimension 2 end
    !dim2E = object POINTVECTOR()
    !dim2E.position = !line1.startposition
    !dim2E.direction = !form.support.p9dir

    -- Dimension 3 start
    !dim3S = object POINTVECTOR()
    !dim3S.position = !line1.endposition
    !dim3S.direction = !form.support.p10dir

    -- Dimension 3 end
    !constt = !dim3S
    var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum
    !constt.direction = !p3p9dir.direction()
    !line2 = !constt.line(!dim3)
    !dim3E = object POINTVECTOR()
    !dim3E.position = !line2.endposition
    !dim3E.direction = !origin.direction

    -- Dimension 4 start
    !dim4S = !dim1E
    !dim4S.direction = !form.support.p11dir

    -- Dimension 4 end
    !constt = !dim4S
    !constt.direction = !p3p9dir.direction()
    !line3 = !constt.line(!dim4)
    !dim4E = object POINTVECTOR()
    !dim4E.position = !line3.endposition
    !dim4E.direction = !form.support.p11dir

    !show1 = true
    !show2 = true
    !show3 = true
    !show4 = true
    !show5 = false

  elseif !method.eq(2) then

    -- Dim 1 is overall either size of datum, default 1000mm
    -- Dim 2 is !form.support.p10dir, default 500mm
    -- Dim 3 is vertical dimension using p10dir, default 1000mm
    -- Dim 4 is vertical dimension using p11dir, default 1000mm

    -- Check to see if dimension are set, if so overwrite defaults

    if !form.dim1.val.neq(0) then
      !dim1 = !form.dim1.val
    endif
    if !form.dim2.val.neq(0) then
      !dim2 = !form.dim2.val
    endif
    if !form.dim3.val.neq(0) then
      !dim3 = !form.dim3.val
    endif
    if !form.dim4.val.neq(0) then
      !dim4 = !form.dim4.val
    endif

    !origin = object POINTVECTOR()
    !origin.position = !form.support.datum.ppos[9]
    !origin.direction = !form.support.p10dir
    var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum

    -- Dimension 1 start
    !line1 = !origin.line(!dim2)
    !dim1S = object POINTVECTOR()
    !dim1S.position = !line1.endposition
    !dim1S.direction = !p3p9dir.direction()

    -- Dimension 1 end
    !line2 = !origin.line(!dim2 - !dim1)
    !dim1E = object POINTVECTOR()
    !dim1E.position = !line2.endposition
    !dim1E.direction = !p3p9dir.direction()

    -- Dimension 2 start
    !dim2S = !dim1S

    -- Dimension 2 end
    !dim2E = object POINTVECTOR()
    !dim2E.position = !line1.startposition
    !dim2E.direction = !p3p9dir.direction()

    -- Dimension 3 start
    !dim3S = object POINTVECTOR()
    !dim3S.position = !line1.endposition
    !dim3S.direction = !form.support.p10dir

    -- Dimension 3 end
    !constt = !dim3S
    var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum
    !constt.direction = !form.support.p9dir
    !line2 = !constt.line(!dim3)
    !dim3E = object POINTVECTOR()
    !dim3E.position = !line2.endposition
    !dim3E.direction = !origin.direction

    -- Dimension 4 start
    !dim4S = !dim1E
    !dim4S.direction = !form.support.p11dir

    -- Dimension 4 end
    !constt = !dim4S
    !constt.direction = !form.support.p9dir
    !line3 = !constt.line(!dim4)
    !dim4E = object POINTVECTOR()
    !dim4E.position = !line3.endposition
    !dim4E.direction = !form.support.p11dir

    !show1 = true
    !show2 = true
    !show3 = true
    !show4 = true
    !show5 = false

  elseif !method.eq(3) then

    -- Dim 1 is overall either size of datum, default 1000mm
    -- Dim 2 is !form.support.p10dir, default 500mm

    -- Check to see if dimension are set, if so overwrite defaults
    -- If alias is ft18 dim 0 may be set to 0 so check dim 2, set it to .5mm if so
    -- this will stop a zero divide with a zero dimension

    if !alias.eq('FT18') then
      if !form.dim2.val.neq(0) then
        !dim1 = !form.dim1.val
        if !dim1.eq(0) then
          !dim1 = .5mm
        endif
        !dim2 = !form.dim2.val
      endif
    else
      if !form.dim1.val.neq(0) then
        !dim1 = !form.dim1.val
      endif
      if !form.dim2.val.neq(0) then
        !dim2 = !form.dim2.val
      endif
    endif

    !origin = object POINTVECTOR()
    !origin.position = !form.support.datum.ppos[9]
    if !form.support.alias.eq('CT03') then
      !origin.direction = !form.support.p11dir
    else
      !origin.direction = !form.support.p10dir
    endif

--<wd>nov2004
    --var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum
    if (!alias.eq('FT18')) then
      if (!form.support.config.eq(2)) then
        var !p3p9dir 'U'
      else
        var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum
      endif
    else
      var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum
    endif
--<wd>nov2004

    -- Dimension 1 start
    if !form.support.rotatecur then
      !line1 = !origin.line(-!dim1)
    else
      !line1 = !origin.line(!dim1)
    endif
    !dim1S = object POINTVECTOR()
    !dim1S.position = !line1.endposition
    !dim1S.direction = !p3p9dir.direction()

    -- Dimension 1 end
    !dim1E = object POINTVECTOR()
    !dim1E.position = !line1.startposition
    !dim1E.direction = !p3p9dir.direction()

    -- Dimension 2 start
    !dim2S = !dim1S
    if !form.support.rotatecur then
      !dim2S.direction = !form.support.p11dir
    else
      !dim2S.direction = !form.support.p10dir
    endif

    if !form.support.alias.eq('CT03') then
      !dim2S.direction = D
    endif

    -- Dimension 2 end
    !line2 = !dim1S.line(-!dim2)
    !dim2E = object POINTVECTOR()
    !dim2E.position = !line2.endposition
    if !form.support.rotatecur then
      !dim2E.direction = !form.support.p11dir
    else
      !dim2E.direction = !form.support.p10dir
    endif

    if !form.support.alias.eq('CT03') then
      !dim2E.direction = D
    endif

    !show1 = true
    !show2 = true
    !show3 = false
    !show4 = false
    !show5 = false

  elseif !method.eq(4) then

    -- Dim 1 is overall either size of datum, default 1000mm
    -- Dim 2 is !form.support.p10dir, default 500mm

    -- If alias is ft19 dim 0 may be set to 0 so check dim 2, set it to .5mm if so
    -- this will stop a zero divide with a zero dimension

    if !alias.eq('FT19') then
      if !form.dim2.val.neq(0) then
        !dim1 = !form.dim1.val
        if !dim1.eq(0) then
          !dim1 = .5mm
        endif
        !dim2 = !form.dim2.val
      endif
    else
      if !form.dim1.val.neq(0) then
        !dim1 = !form.dim1.val
      endif
      if !form.dim2.val.neq(0) then
        !dim2 = !form.dim2.val
      endif
    endif

    !origin = object POINTVECTOR()
    !origin.position = !form.support.datum.ppos[9]
    !origin.direction = !form.support.p10dir

--<wd>nov2004
    --var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum
    if (!alias.eq('FT19')) then
      if (!form.support.config.eq(2)) then
        var !p3p9dir 'D'
      else
        var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum
      endif
    else
      var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum
    endif
--<wd>nov2004

    -- Dimension 1 start
    if !form.support.rotatecur then
      !line1 = !origin.line(-!dim1)
    else
      !line1 = !origin.line(!dim1)
    endif
    !dim1S = object POINTVECTOR()
    !dim1S.position = !line1.endposition
--<wd>nov2004
    --!dim1S.direction = !form.support.p9dir
    !dim1S.direction = !p3p9dir.direction()
--<wd>nov2004

    -- Dimension 1 end
    !dim1E = object POINTVECTOR()
    !dim1E.position = !line1.startposition
--<wd>nov2004
    --!dim1E.direction = !form.support.p9dir
    !dim1E.direction = !p3p9dir.direction()
--<wd>nov2004

    -- Dimension 2 start
    !dim2S = !dim1S
    if !form.support.rotatecur then
      !dim2S.direction = !form.support.p11dir
    else
      !dim2S.direction = !form.support.p10dir
    endif

    -- Dimension 2 end
    --<tm> 20/04/2005 11:40 minus removed
--    !line2 = !dim1S.line(-!dim2)
    !line2 = !dim1S.line(!dim2)
    !dim2E = object POINTVECTOR()
    !dim2E.position = !line2.endposition
    if !form.support.rotatecur then
      !dim2E.direction = !form.support.p11dir
    else
      !dim2E.direction = !form.support.p10dir
    endif

    !show1 = true
    !show2 = true
    !show3 = false
    !show4 = false
    !show5 = false

  elseif !method.eq(5) then

    -- Dim 1 is overall either size of datum, default 1000mm
    -- Check to see if dimension are set, if so overwrite defaults
    if !form.dim1.val.neq(0) then
      !dim1 = !form.dim1.val
    endif

    !origin = object POINTVECTOR()
    !origin.position = !form.support.datum.ppos[9]

    -- We have to work the origin direction out because
    -- we are not sure which way the atta has been directed
    -- This is not 100% but should work most of the time
    if !form.support.barLen.size().eq(0) then
      !direction = D
    else
--<wd>nov2002
      !currentunits = !!kgetsetunits()
--<wd>nov2002

      !!ce = sctn 1 of frmw 1 of $!form.support.stru
      !poss = poss
      !pose = pose
      same
      var !start const distance p0 of $!form.support.datum to $!poss
      var !end   const distance p0 of $!form.support.datum to $!pose
      pin 9 copy p0 of $!form.support.datum
      pin 8 copy p10 of $!form.support.datum
      if not !form.dim1.val.lt(0) then
        if !start.real().gt(!end.real()) then
          pin 8 plane pin8 through $!poss
        else
          pin 8 plane pin8 through $!pose
        endif
      else
        if !start.real().gt(!end.real()) then
          pin 8 plane pin8 through $!pose
        else
          pin 8 plane pin8 through $!poss
        endif
      endif
      var !direction const direction pin 9 to pin 8
      !!mdsresetpins(8,9)

--<wd>nov2002
      !!kRestoreUnits(!currentunits)
--<wd>nov2002

    endif
    !origin.direction = $!direction
    handle (2,779)
      !origin.direction = axis $!direction
    endhandle

    -- if !form.support.rotatecur then
    --   !origin.direction = !form.support.p10dir
    -- else
    --   !origin.direction = !form.support.p11dir
    -- endif
    var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum

    -- Dimension 1 start
  --  if !form.support.rotatecur then
  --    !line1 = !origin.line(-!dim1)
  --  else
  --    !line1 = !origin.line(!dim1)
  --  endif
--<GE> 01/02/07 Fix for Defect No: 10178
    !line1 = !origin.line(!dim1)
--<GE> 01/02/07
    !dim1S = object POINTVECTOR()
    !dim1S.position = !line1.endposition
    !dim1S.direction = !form.support.p9dir

    -- Dimension 1 end
    !dim1E = object POINTVECTOR()
    !dim1E.position = !line1.startposition
    !dim1E.direction = !form.support.p9dir

    !show1 = true
    !show2 = false
    !show3 = false
    !show4 = false
    !show5 = false

  elseif !method.eq(6) then

    -- Dim 1 is overall either size of datum, default 1000mm
    -- Dim 2 is !form.support.p10dir, default 500mm
    -- Dim 3 is vertical dimension using p10dir, default 1000mm

    -- Check to see if dimension are set, if so overwrite defaults

    if !form.dim1.val.neq(0) then
      !dim1 = !form.dim1.val
    endif
    if !form.dim2.val.neq(0) then
      !dim2 = !form.dim2.val
    endif
    if !form.dim3.val.neq(0) then
      !dim3 = !form.dim3.val
    endif

    !origin = object POINTVECTOR()
    !origin.position = !form.support.datum.ppos[9]
    if !form.support.rotatecur then
      !origin.direction = !form.support.p11dir
    else
      !origin.direction = !form.support.p10dir
    endif
    var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum

    -- Dimension 1 start
    !line1 = !origin.line(!dim2)
    !dim1S = object POINTVECTOR()
    !dim1S.position = !line1.endposition
    !dim1S.direction = !p3p9dir.direction()

    -- Dimension 1 end
    !line2 = !origin.line(!dim2 - !dim1)
    !dim1E = object POINTVECTOR()
    !dim1E.position = !line2.endposition
    !dim1E.direction = !p3p9dir.direction()

    -- Dimension 2 start
    !dim2S = !dim1S

    -- Dimension 2 end
    !dim2E = object POINTVECTOR()
    !dim2E.position = !line1.startposition
    !dim2E.direction = !p3p9dir.direction()

    -- Dimension 3 start
    !dim3S = object POINTVECTOR()
    !dim3S.position = !line1.endposition
    if !form.support.rotatecur then
      !dim3S.direction = !form.support.p11dir
    else
      !dim3S.direction = !form.support.p10dir
    endif

    -- Dimension 3 end
    !constt = !dim3S
    var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum
    !constt.direction = !form.support.p9dir
    !line2 = !constt.line(!dim3)
    !dim3E = object POINTVECTOR()
    !dim3E.position = !line2.endposition
    if !form.support.rotatecur then
      !dim3E.direction = !form.support.p11dir
    else
      !dim3E.direction = !form.support.p10dir
    endif

    !show1 = true
    !show2 = true
    !show3 = true
    !show4 = false
    !show5 = false

  elseif !method.eq(7) then

    -- Dim 1 is overall either size of datum, default 1000mm
    -- Dim 2 is !form.support.p10dir, default 500mm
    -- Dim 3 is vertical dimension using p10dir, default 1000mm

    -- Check to see if dimension are set, if so overwrite defaults

    if !form.dim1.val.neq(0) then
      !dim1 = !form.dim1.val
    endif
    if !form.dim2.val.neq(0) then
      !dim2 = !form.dim2.val
    endif
    if !form.dim3.val.neq(0) then
      !dim3 = !form.dim3.val
    endif

    !origin = object POINTVECTOR()
    !origin.position = !form.support.datum.ppos[9]
    if !form.support.rotatecur then
      !origin.direction = !form.support.p11dir
    else
      !origin.direction = !form.support.p10dir
    endif
    var !p3p9dir const direction p9 of $!form.support.datum to p3 of $!form.support.datum

    -- Dimension 1 start
    !line1 = !origin.line(!dim2)
    !dim1S = object POINTVECTOR()
    !dim1S.position = !line1.endposition
    !dim1S.direction = !p3p9dir.direction()

    -- Dimension 1 end
    !line2 = !origin.line(!dim2 - !dim1)
    !dim1E = object POINTVECTOR()
    !dim1E.position = !line2.endposition
    !dim1E.direction = !p3p9dir.direction()

    -- Dimension 2 start
    !dim2S = !dim1S

    -- Dimension 2 end
    !dim2E = object POINTVECTOR()
    !dim2E.position = !line1.startposition
    !dim2E.direction = !p3p9dir.direction()

    -- Dimension 3 start
    !dim3S = object POINTVECTOR()
    !dim3S.position = !line1.endposition
    if !form.support.rotatecur then
      !dim3S.direction = !form.support.p11dir
    else
      !dim3S.direction = !form.support.p10dir
    endif

    -- Dimension 3 end
    !constt = !dim3S
    var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum
    !constt.direction = !form.support.p9dir
    !line2 = !constt.line(-!dim3)
    !dim3E = object POINTVECTOR()
    !dim3E.position = !line2.endposition
    if !form.support.rotatecur then
      !dim3E.direction = !form.support.p11dir
    else
      !dim3E.direction = !form.support.p10dir
    endif

    !show1 = true
    !show2 = true
    !show3 = true
    !show4 = false
    !show5 = false

  elseif !method.eq(8) then

    -- Dim 1 is datum to end, default 500mm
    -- Dim 2 is overall , default 1000mm

    !dim1 = 500mm
    !dim2 = 1000mm
    !dim3 = 200mm

    -- Check to see if dimension are set, if so overwrite defaults

    if !form.dim1.val.neq(0) then
      !dim1 = !form.dim1.val
    endif
    if !form.dim2.val.neq(0) then
      !dim2 = !form.dim2.val
    endif
    if !alias.neq('FT14') and !alias.neq('FT34') then
      if !form.dim3.val.neq(0) then
        !dim3 = !form.dim3.val
      endif
    endif
    !origin = object POINTVECTOR()
    !origin.position = !form.support.datum.ppos[9]
    if !form.support.rotatecur then
      !origin.direction = !form.support.p11dir
    else
      !origin.direction = !form.support.p10dir
    endif
    var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum

    -- Dimension 1 start
    !line1 = !origin.line(!dim1)
    !dim1S = object POINTVECTOR()
    !dim1S.position = !line1.startposition
    !dim1S.direction = !form.support.p9dir

    -- Dimension 1 end
    !dim1E = object POINTVECTOR()
    !dim1E.position = !line1.endposition
    !dim1E.direction = !form.support.p9dir

    -- Dimension 2 start
    !dim2S = !dim1E

    -- Dimension 2 end
    !line2 = !origin.line(!dim1 - !dim2)
    !dim2E = object POINTVECTOR()
    !dim2E.position = !line2.endposition
    !dim2E.direction = !form.support.p9dir

    !offset1 = 400mm
    !offset2 = 600mm

    if !alias.eq('FT13') then
      !offset3 = 200mm
-- Dimension 3 end
      !dim3E = !dim2E
-- Dimension 3 start
      !test = !dim3 - (!dim2  - !dim1)
      if !test.neq(0) then
        !line4 = !origin.line( !dim3 - (!dim2 - !dim1))
      else
        !line4 = !origin.line(1)
      endif
      !dim3S = object POINTVECTOR()
      !dim3S.position = !line4.endposition
      !dim3S.direction = !form.support.p9dir
    endif

    if !alias.neq('FT13').or(!form.support.alias.eq('FT68')) then
      !show1 = true
      !show2 = true
      !show3 = false
      !show4 = false
      !show5 = false
    else
      !show1 = true
      !show2 = true
      !show3 = TRUE
      !show4 = false
      !show5 = FALSE
    endif

  elseif !method.eq(9) then

    -- Dim 1 is overall either size of datum, default 1000mm
    -- Dim 2 is !form.support.p10dir, default 500mm
    -- Dim 3 is vertical dimension using p10dir, default 1000mm

    -- Check to see if dimension are set, if so overwrite defaults

    !dim1 = 500mm
    !dim2 = 1000mm
    !dim3 = 500mm
    !dim4 = 500mm
    !dim5 = 200mm

    if !form.dim1.val.neq(0) then
      !dim1 = !form.dim1.val
    endif
    if !form.dim2.val.neq(0) then
      !dim2 = !form.dim2.val
    endif
    !dim3 = 200mm
    if !form.dim3.val.neq(0) then
      !dim3 = !form.dim3.val
    endif

    !origin = object POINTVECTOR()
    !origin.position = !form.support.datum.ppos[9]
    if !form.support.rotatecur then
      !origin.direction = !form.support.p11dir
    else
      !origin.direction = !form.support.p10dir
    endif
    var !p3p9dir const direction p9 of $!form.support.datum to p3 of $!form.support.datum
    var !p9p3dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum

    -- Dimension 1 start
    !line1 = !origin.line(!dim1)
    !dim1S = object POINTVECTOR()
    !dim1S.position = !origin.position
    !dim1S.direction = $!p9p3dir
    handle (2,779)
      !dim1S.direction = axis $!p9p3dir
    endhandle

    -- Dimension 1 end
    !line2 = !origin.line(!dim2 - !dim1)
    !dim1E = object POINTVECTOR()
    !dim1E.position = !line1.endposition
    !dim1E.direction = $!p9p3dir
    handle (2,779)
      !dim1E.direction = axis $!p9p3dir
    endhandle

    !offset1 = 300mm

    -- Dimension 2 start
    !dim2S = !dim1E
    !dim2S.direction = !p3p9dir.direction()

    -- Dimension 2 end
    !line2 = !origin.line(-!dim2 + !dim1)
    !dim2E = object POINTVECTOR()
    !dim2E.position = !line2.endposition
    !dim2E.direction = !p3p9dir.direction()

    !show1 = true
    !show2 = true

    if !!mdsFt15.slide.val.eq(1) then

      -- Dimension 3 start
      !dim3S = object POINTVECTOR()
      !dim3S.position = !line1.endposition
      if !form.support.rotatecur then
        !dim3S.direction = !form.support.p11dir
      else
        !dim3S.direction = !form.support.p10dir
      endif

      -- Dimension 3 end
      !constt = !dim3S
      var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum
      !constt.direction = !form.support.p9dir
      !line2 = !constt.line(-!dim3)
      !dim3E = object POINTVECTOR()
      !dim3E.position = !line2.endposition
      if !form.support.rotatecur then
        !dim3E.direction = !form.support.p11dir
      else
        !dim3E.direction = !form.support.p10dir
      endif

      !show3 = true
      !show4 = false
      !show5 = false

    elseif !!mdsFt15.slide.val.eq(2) then

      -- Dimension 3 start
      !dim3S = !dim2E

      -- Dimension 3 end
      !dim3E = !dim2E
      !dim3E.direction = !form.support.p10dir
      !line3 = !dim3E.line(-!dim3)
      !dim3E.position = !line3.endposition
      !dim3E.direction = !dim2E.direction

      !offset3 = 400mm

      !show3 = true
      !show4 = false
      !show5 = false

    elseif !!mdsFt15.slide.val.eq(3) then

      -- Dimension 3 start
      !dim3S = !dim2E

      -- Dimension 3 end
      !dim3E = !dim2E
      !dim3E.direction = !form.support.p10dir
      !line3 = !dim3E.line(-!dim3)
      !dim3E.position = !line3.endposition
      !dim3E.direction = !dim2E.direction

      !offset3 = 400mm

      if !form.dim4.val.neq(0) then
        !dim4 = !form.dim4.val
      endif

      -- Dimension 4 start
      !dim4S = !dim2S

      -- Dimension 4 end
      !dim4E = !dim2S
      !dim4E.direction = !form.support.p10dir
      !line4 = !dim4E.line(!dim4)
      !dim4E.position = !line4.endposition
      !dim4E.direction = !dim2E.direction

      !offset4 = 400mm

      !show3 = true
      !show4 = true
      !show5 = false

    elseif !!mdsFt15.slide.val.eq(4) then

      -- Dimension 3 start
      !dim3S = !dim2E

      -- Dimension 3 end
      !dim3E = !dim2E
      !dim3E.direction = !form.support.p10dir
      !line3 = !dim3E.line(-!dim3)
      !dim3E.position = !line3.endposition
      !dim3E.direction = !dim2E.direction

      !offset3 = 400mm

      if !form.dim4.val.neq(0) then
        !dim4 = !form.dim4.val
      endif

      -- Dimension 4 start
      !dim4S = !dim2S

      -- Dimension 4 end
      !dim4E = !dim2S
      !dim4E.direction = !form.support.p10dir
      !line4 = !dim4E.line(!dim4)
      !dim4E.position = !line4.endposition
      !dim4E.direction = !dim2E.direction

      !offset4 = 400mm

      if !form.dim5.val.neq(0) then
        !dim5 = !form.dim5.val
      endif

    -- Dimension 5 start
      !dim5S = object POINTVECTOR()
      !dim5S.position = !line1.endposition
      if !form.support.rotatecur then
        !dim5S.direction = !form.support.p11dir
      else
        !dim5S.direction = !form.support.p10dir
      endif

      -- Dimension 5 end
      !constt = !dim5S
      var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum
      !constt.direction = !form.support.p9dir
      !line2 = !constt.line(-!dim5)
      !dim5E = object POINTVECTOR()
      !dim5E.position = !line2.endposition
      if !form.support.rotatecur then
        !dim5E.direction = !form.support.p11dir
      else
        !dim5E.direction = !form.support.p10dir
      endif

      !show3 = true
      !show4 = true
      !show5 = true

    endif

  elseif !method.eq(10) then

-- Dim 1 is overall either size of datum, default 1000mm
-- Dim 2 is !form.support.p10dir, default 500mm
-- Dim 3 is vertical dimension using p10dir, default 1000mm
-- Dim 4 is vertical dimension using p11dir, default 1000mm
-- Check to see if dimension are set, if so overwrite defaults

    !dim1 = 0

    if !form.dim1.val.neq(0) then
      !dim1 = !form.dim1.val
