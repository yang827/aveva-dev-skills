    !!ce = !form.support.datum

    !direction = p10 dir wrt /*

    !origin.direction = p9 dir wrt /*
--    !origin.direction = !origin.direction.opposite()

    var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum

    -- Dimension 1 start
    !line1 = !origin.line(!dim1)
    !dim1S = object POINTVECTOR()
    !dim1S.position = !line1.startposition
    !dim1S.direction = !direction

