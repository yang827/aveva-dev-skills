    !origin = object POINTVECTOR()
    !bar1 = !form.support.stru.name + '-BAR-1'
    if !form.support.rotatecur then
      pin 9 at poss of $!bar1
      pin 9 dir u
      pin 9 clear 0 beh $!bar1
      pin 9 dir $!form.support.p10dir
    else
      pin 9 at pose of $!bar1
      pin 9 dir u
      pin 9 clear 0 beh $!bar1
      pin 9 dir $!form.support.p11dir
    endif
    -- pin 9 dist ($!dim2 / 2)
    var !pin9pos pin 9 pos wrt /*
    !origin.position = !pin9Pos.position()
