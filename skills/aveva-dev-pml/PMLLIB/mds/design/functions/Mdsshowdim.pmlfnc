        pin 8 at poss of /$!form.name-BAR-1
        pin 7 at pose of /$!form.name-BAR-1
        pin 8 dir drns of /$!form.name-BAR-1
        pin 7 dir drne of /$!form.name-BAR-1
        pin 6 copy pin 8
        pin 6 plane pin 6 thro pin 9
        !currentunits = !!kgetsetunits()
        var !dist1 const dist pin 6 to pin 8
        var !dist2 const dist pin 6 to pin 7
        !!kRestoreUnits(!currentunits)
        if !dist1.real().gt(!dist2.real()) then
          !origin.direction = drne of /$!form.name-BAR-1 wrt /*
        else
          !origin.direction = drns of /$!form.name-BAR-1 wrt /*
        endif
      endhandle
      !!mdsresetpins(6,9)

    var !p3p9dir const direction p3 of $!form.support.datum to p9 of $!form.support.datum

    -- Dimension 1 start
    !line1 = !origin.line(!dim1)
    !dim1S = object POINTVECTOR()
