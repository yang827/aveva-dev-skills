--
-- File:		Mdsshowframe.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Thu sept 11
--
--
-- Description:
-- Show the requested framework form, but first checks to see of any other frame
-- work forms are shown
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsShowFrame(!Form is Form)

-- Check to see if the other framework form are shown

  !List = Array()
  !List.append(!!MdsFrame)
  !List.append(!!MdsCable)
  !List.append(!!MdsHvac)
  !List.append(!!MdsVess)

  !Desc = Array()
  !Desc.append('Multi Discipline Framework')
  !Desc.append('Cable Rack Framework')
  !Desc.append('HVAC Framework')
  !Desc.append('Vessel Frameworks')

  !Error = Boolean()
  !Error = !!Mdscheckform(!List,!Form,!Desc)

  if (!Error.not()) then
    !Form.show()
  endif

-- End function
endfunction

-- End of file Mdsshowframe.pml
