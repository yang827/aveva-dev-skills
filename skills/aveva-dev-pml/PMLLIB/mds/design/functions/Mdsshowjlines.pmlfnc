--
-- File:		MdsShowJlines.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Tues 26th June 1998
--
--
-- Description:
-- Function to show jlines available on a joint for alignment
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        STRING         [Joint in JLIST (as a string())]
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsShowJlines(!Joint is string)

if(!!Mdsjointspec.ShowJ.Val) then
  -- Initialise Variables
     !Jnt = !Joint
     !Refe = !!ce
     !Spref = !!MdsJointSpec.Spre.Selection()
     !!CE = !Joint.dbref()
       handle any
       -- ALl is selected so use first in the list
       !!CE   = !!MdsJointSpec.Jlist.Rtext.first().dbref()
       !Jnt = !!MdsJointSpec.Jlist.Rtext.first()
       endhandle


  -- get all jlines for joint

  -- yukky bit to get jlins if spref not set yet

     !SavedSpref = !Jnt.dbref().Spref
     SPREF $!Spref
     !Jline = plnam


     do !Ind indices !Jline
        skip if(!Jline[!Ind].eq('NA'))

---------------------------------------------------------------------
--ERRORS HERE when trying to Display Jlines of a joint --<wd>nov2000

-- $P-------------------
-- q var !jline[!ind]
-- $P-------------------
-- $P-------------------
-- $P
--        !pos[!ind] = plstart $!Jline[$!Ind] wrt worl
        !pos[!ind] = plstart $!Jline[$!Ind] wrt worl
-- q var !pos[!ind]
--ERRORS HERE --<wd>nov2000
---------------------------------------------------------------------

        var !dir[$!Ind] pplin $!Jline[$!Ind] x dir wrt worl
        !d = !dir[!Ind].direction()
        -- convert to opposite dir (make a function)

           !up = !d.up * -1
           !north = !d.north * -1
           !east = !d.east * -1
           !d.up = !up
           !d.east = !east
           !d.north = !north

        aid arrow num 1002 at $!Pos[$!Ind] dir $!D  hei 200mm
        aid sphere num 1002 $!Pos[$!Ind] dia 25mm
        pin 1 at $!pos[$!ind]
        pin 1 dir $!D
        pin 1 plane pin 1 dist 200 mm
        var !Tpos pin 1 pos wrt worl
        aid text num 1002 '$!Jline[$!Ind]' at $!Tpos wrt worl
     enddo

     !!MdsResetPins(1,10)
     SPREF $!SavedSpref

!!CE = !Refe
else
!!KAidClear('1002','ALL')
endif
-- End function
endfunction

-- End of file MdsShowJlines.pml
