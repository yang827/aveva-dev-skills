--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Mon Jul 07
--
--
-- Description:
-- add plot file associated with selected support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       MdsSUPPORT    Support object holding frame information
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsshowjoinfile()

  -- Initialise variables
    !PlotFileName = !!Mdsjointspec.spre.rtext[!!Mdsjointspec.spre.val].dbref().catref.owner.cplot

  -- Load required plotfile

    var !PlotPath file /%MDSPLOTS%/$!PlotFileName
      handle any
        var !PlotPath file /%PDMSUI%/DES/MDS/PLOT/$!PlotFileName
          handle any
            !!Alert.Warning(|Cannot access plotfile for reading?|)
            return
          endhandle
      endhandle

    edit !!MdsShowPlot.Plot PLOT
      add /$!PlotPath
        handle (61,251)
          !!Alert.Warning(|Cannot access plotfile for reading?|)
          return
        endhandle
    exit

    call !!KshowForm(!!MdsShowPlot)

return

  !ProjectStandard = !Support.Replace

  -- Modify project support type para gadget

  !!Mdsshowplot.projtype.val = 'Project Standard = $!ProjectStandard'

    call !!KshowForm(!!MdsShowPlot)

-- End function
endfunction

-- End of file Mdsshowjoinfile.pml
