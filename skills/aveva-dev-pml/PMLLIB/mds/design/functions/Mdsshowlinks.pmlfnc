--
-- File:		Mdsshowlinks.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Wed Sept 17
--
--
-- Description:
-- Show the associated atta's with a cross bar
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      Name of support as a string
--     2     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsShowLinks(!Form is FORM)

  -- Initialise Variables
    !Name = !Form.support.stru.name
    !Namn = !Form.support.stru.namn

  -- Check that Datum atta has been created
  if (!Form.Support.Datum.set().not())then
    !!Alert.message('Datum support atta has not been created')
    return
  endif

  -- Check that framework has been created
  if (!Form.Support.Stru.Mcount() eq 0)then
    !!Alert.error('Support structure has not been created')
    return
  endif

  -- Show the first cross-bar links by default
  -- If the support type is FT23 then the section will be named V1
  if !Form.support.type neq 'FT23' then
    !FirstBar = !Form.Support.Stru.name & '-BAR-1'
  else
    !FirstBar = !Form.Support.Stru.name & '-V1'
  endif
  !!CE = !FirstBar.dbref()

  -- Enhance elements using colour set for highlight
  !ColourList = ARRAY()
  if (defined (!Form.support.stru))then
    !ColourList.append(!Form.support.stru)
  endif
  if (!Form.support.atta.empty().not())then
    !ColourList.appendarray(!Form.support.atta)
  endif

  -- Colour Support
  Call !!KEnhanceList(!ColourList)

  !Attarefs = :MDSAttaRef
  !Num = 300
  var !Colour colour aids
  colour aids red

  do !Enhance values !Attarefs
     !!CE = !Enhance
     if (matchwild(!!CE.Spref.name,|*.REST.*|)) then
       pin 9 copy p9 of $!Enhance
       pin 9 dir from pin 9 to p0
       pin 9 clear 0 beh ce
       var !pos pin 9 pos wrt /*
       var !dir pin 9 dir wrt /*
       aid arrow num $!num at $!pos dir $!dir hei 100mm prop 1
       !Num = !Num + 1
     else
       unenhance $!Enhance
       ENHANCE $!Enhance COLOUR 2
       if (!enhance.:MDSPackRef.badref().not()) then
         unenhance $!enhance.:MDSPackRef
         enhance $!enhance.:MDSPackRef col 2
       endif
     endif
  enddo

  !!MdsResetPins(9,9)

  UNENHANCE $!FirstBar
  ENHANCE $!FirstBar COLOUR 2
  refresh

  do from 1

  -- Identify cross-bar
    prompt off
    prompt load escape |Identify cross bar belonging to support $!Namn|
    id sctn @
      handle (61,528)
        prompt dismiss
        prompt on
        do !remove values !List
          unenhance $!Remove
        enddo
        break
      endhandle
    prompt dismiss
    prompt on

    !Picked = !!CE

  -- Is it a cross bar

    if (match(!!CE.Name,'-BAR-') lt 1) then
      !!Alert.error('Identified section is not a cross bar')
      skip
    endif

  -- If it is does it belong
    if (match(!!CE.Name,'$!Namn-BAR-') lt 1) then
      !!Alert.error('Identified section is not a cross bar that belongs to $!Namn')
      skip
    endif

  -- Enhance elements using colour set for highlight
    !ColourList = ARRAY()
    if (defined (!Form.support.stru))then
      !ColourList.append(!Form.support.stru)
    endif
    if (!Form.support.atta.empty().not())then
      !ColourList.appendarray(!Form.support.atta)
    endif

  -- Colour Support
    Call !!KEnhanceList(!ColourList)

    do !reset from 300
      aid clear arrow $!reset
        handle (41,6)
          break
        endhandle
    enddo

    !Attarefs = :MDSAttaRef

    -- do !Enhance values !Attarefs
       -- unenhance $!Enhance
       -- ENHANCE $!Enhance COLOUR 2
    -- enddo

    !Num = 300

    do !Enhance values !Attarefs
      !!CE = !Enhance
      if (matchwild(!!CE.Spref.name,|*.REST.*|)) then
        pin 9 copy p9 of $!Enhance
        pin 9 dir from pin 9 to p0
        pin 9 clear 0 beh ce
        var !pos pin 9 pos wrt /*
        var !dir pin 9 dir wrt /*
        aid arrow num $!num at $!pos dir $!dir hei 100mm prop 1
        !Num = !Num + 1
      else
        unenhance $!Enhance
        ENHANCE $!Enhance COLOUR 2
        if (!enhance.:MDSPackRef.badref().not()) then
          unenhance $!enhance.:MDSPackRef
          enhance $!enhance.:MDSPackRef col 2
        endif
      endif
    enddo

    !!MdsResetPins(9,9)

    UNENHANCE $!Picked
    ENHANCE $!Picked COLOUR 2
    refresh

  enddo

  colour aids $!colour
  do !reset from 300
    aid clear arrow $!reset
      handle (41,6)
        break
      endhandle
  enddo

  -- Enhance elements using colour set for highlight
    !ColourList = ARRAY()
    if (defined (!Form.support.stru))then
      !ColourList.append(!Form.support.stru)
    endif
    if (!Form.support.atta.empty().not())then
      !ColourList.appendarray(!Form.support.atta)
    endif

  -- Colour Support
    Call !!KEnhanceList(!ColourList)

-- End function
endfunction

-- End of file Mdsshowlinks.pml
