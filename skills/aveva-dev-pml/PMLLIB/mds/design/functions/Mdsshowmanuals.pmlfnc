--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsShowManuals()

-- The manuals are stored in the mds software directory
-- This can be located through the pmllib path but because this is
-- a search path we have to locate the mds part first
-- We can use the file buildmdsforms.pmlfnc to locate it

!PathOfFile = !!PML.getPathName('buildmdsforms.pmlfnc')

-- Get the path before the pmllib and this will locate the manuals

!BeforePmllib = !PathOfFile.Before('pmllib')

-- Bring up the index sheet

syscom |$!BeforePmllib\manuals\mds\iindex.htm &|

-- End function
endfunction

-- End of file MdsShowManuals.pml
