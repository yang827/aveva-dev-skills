--
-- File:		Mdsshownextancill.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Mon Jul 07
--
--
-- Description:
-- add plot file associated with selected support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       MdsSUPPORT    Support object holding frame information
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsshownextancill(!NextPrev is STRING)

  !Currentplot = !!Mdsshowancill.sheet
  if !NextPrev.eq('NEXT') then
    !NextPlot = !CurrentPlot + 1
  else
    !NextPlot = !CurrentPlot - 1
  endif

  edit !!MdsShowancill.Plot PLOT
    add /$!!MdsShowancill.Plots[1][$!NextPlot]
  exit

  !Sheets = !!MdsShowancill.Plots[1].size()
  !!MdsShowancill.Sheet = !Nextplot

  !!Mdsshowancill.sheets.val = 'Displaying Sheet $!!Mdsshowancill.sheet of $!Sheets'

  if !!MdsShowancill.Plots[1].size().eq(!NextPlot) then
    !!MdsShowancill.Next.Active = false
    !!MdsShowancill.Prev.Active = true
  endif

  if !!MdsShowancill.Sheet.eq(1) then
    !!MdsShowancill.Next.Active = true
    !!MdsShowancill.Prev.Active = false
  endif

-- End function
endfunction

-- End of file Mdsshownextancill.pml
