--
-- File:		Mdsshownextplot.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Mon Jul 07
--
--
-- Description:
-- add plot file associated with selected support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       MdsSUPPORT    Support object holding frame information
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsshownextplot(!NextPrev is STRING)

  !CurrentPlot = !!Mdsshowplot.sheet
  if !NextPrev.eq('NEXT') then
    !NextPlot = !CurrentPlot + 1
  else
    !NextPlot = !CurrentPlot - 1
  endif

  edit !!MdsShowPlot.Plot PLOT
    add /$!!MdsShowPlot.Plots[1][$!NextPlot]
  exit

  !Sheets = !!MdsShowPlot.Plots[1].size()
  !!MdsShowPlot.Sheet = !NextPlot

  !!Mdsshowplot.sheets.val = 'Displaying Sheet $!!Mdsshowplot.sheet of $!Sheets'

  if !!MdsShowPlot.Plots[1].size().eq(1) then
    !!MdsShowPlot.Next.Active = false
    !!MdsShowPlot.Prev.Active = false
  elseif !!Mdsshowplot.sheet.eq(!!MdsShowPlot.Plots[1].size()) then
    !!MdsShowPlot.Next.Active = false
    !!MdsShowPlot.Prev.Active = true
  elseif !!Mdsshowplot.sheet.eq(1) then
    !!MdsShowPlot.Next.Active = true
    !!MdsShowPlot.Prev.Active = false
  else
    !!MdsShowPlot.Next.Active = true
    !!MdsShowPlot.Prev.Active = true
  endif

-- End function
endfunction

-- End of file Mdsshownextplot.pml
