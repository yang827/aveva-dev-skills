--
-- File:      Mdsshowplotfile.pmlfnc
-- Type:      Function Definition
-- Group:     Multi Discipline Supports Application
-- Keyword:   MDS
-- Module:    design
-- Replaces:
--
-- Author:    I.osborne
-- Created:   Mon Jul 07
--
--
-- Description:
-- add plot file associated with selected support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       MdsSUPPORT    Support object holding frame information
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsShowPlotFile(!support is ANY)

-- Initialise variables

  !frameType = !support.type

  if !support.type.match('FH').gt(0) then
    !frameType = 'VH01'
  elseif !support.type.match('VH').gt(0) then
    !frameType = 'VH01'
  elseif !support.type.match('PIPE-REST').gt(0) then
    !frameType = 'RT01'
  elseif !support.type.match('PIPE-REST-INLINE').gt(0) then
    !frameType = 'RT02'
  elseif !support.type.match('RACK-REST').gt(0) then
    !frameType = 'CA01'
  endif

  !files = !!mdsgetplot(!frameType)

  if !files.size().eq(1) then
    !!mdsShowPlot.prev.active = false
    !!mdsShowPlot.next.active = false
  else
    !!mdsShowPlot.prev.active = false
    !!mdsShowPlot.next.active = true
  endif

  if !files.unset() then
    !!alert.warning(|Cannot access plotfile for reading?|)
    return
  endif

  edit !!mdsShowPlot.plot PLOT
  add /$!files[1]
      handle (61,251)
    !!alert.warning(|Cannot access plotfile for reading?|)
        return
      endhandle
  exit

!!mdsShowPlot.plots.clear()
!!mdsShowPlot.plots.append(!files)
!!mdsShowPlot.sheet = 1
!sheets = !files.size()
!!mdsShowPlot.sheets.val = 'Displaying Sheet $!!mdsShowPlot.sheet of $!sheets'

-- Modify project support type para gadget

!projectStandard = !support.replace
!!mdsShowPlot.projtype.val = 'Project Standard = $!projectStandard'

-- Modify project support type para gadget

!!mdsShowPlot.projtype.val = 'Project Standard = $!projectStandard'

call !!kshowForm(!!mdsShowPlot)

-- End function
endfunction
