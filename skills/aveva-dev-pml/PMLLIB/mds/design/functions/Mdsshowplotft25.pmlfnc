--
--
-- Description:
-- add plot file associated with selected support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R       STRING        Name of Form Called From
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsshowplotft25(!Support is STRING)

-- Initialise variables
    !frametype =  !support

-- Load required plotfile
    --!plotfilename = 'MDS-Standards-' & !frametype & '.plt'
    !plotfilename = 'MDS-Standards-' & !frametype & '-1' & '.plt'

  var !PlotPath file /%MDSPLOTS%/$!PlotFileName
    handle any
      var !PlotPath file /%PDMSUI%/DES/MDS/PLOT/$!PlotFileName
      handle any
      endhandle
    endhandle

    edit !!Mdsshowplot.Plot PLOT
      add /$!PlotPath
        handle any
          !!alert.warning(|Cannot access plotfile for reading?|)
          return
        endhandle
    exit

    call !!kshowform(!!Mdsshowplot)

-- End function
  endfunction

-- End of file Mdsshowplotft25.pml
