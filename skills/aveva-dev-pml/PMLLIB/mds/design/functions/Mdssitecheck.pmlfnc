-- File:       Mdssitecheck.pmlfnc
-- Type:       Function Definition
-- Group:      Multi Discipline Supports Application
-- Keyword:    MDS
-- Module:     design
-- Replaces:
--
-- Author:     Wayne Dodwell
-- Created:    Tuesday 12th December 2000
--
--
-- Description:
-- Function to Check User Access to the Currently Selected MDS Default Creation Site.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        FORM
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--
-- THIS CODE NEEDS TO CALLED from
-- (a) The MAJORITY of CREATE ICONS and OPTIONS in the MDS TOP BAR MENU
-- and
-- (b) The Modify, Copy, Modify Name etc..., and the remainder of other FORMS shown
--     via the SAME top bar menu ICONS and OPTIONS.
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Define Function
define function !!mdssitecheck(!form is FORM)

  -- Check and ABORT the MDS Creation Procedure if the Currently Selected MDS Default Site is READ ONLY.
  -- Store the reference to the Current Element
  !cecurr = !!ce

  -- Get the name of the Currently Selected MDS Default Site
  !site = !!mdsdefaultsite.site.selection('dtext')
  -- Is there anything in the variable
  if !site.eq('') then
    !!alert.error('The current MDS Default Zone ''/$!site'' does not exist.')
    return
  endif

  -- Check if the site EXISTS
  var !sitexist EXISTS /$!site ZONE

  if (!sitexist eq 'FALSEA')then
    !!alert.error('The current MDS Default Zone ''/$!site'' does not exist.')
    --     return
  elseif (!sitexist eq 'FALSEB')then
    !!alert.error('The element ''/$!site'' exists but it is not a Zone.')
    return
  elseif (!sitexist eq 'FALSEC')then
    !!alert.error('The current MDS Default Zone ''/$!site'' exists, but you do NOT have WRITE access to it.')
    return
  endif

  -- Check the ACCESS to the Currently Selected MDS Default Site
  if (!!mdsmovetosite('').not()) then
    !!ce = !cecurr
    return
  endif

  !write = STRING()
  !lock  = STRING()

  !siteName = '/' + !site
  !siteRef = !siteName.dbref()
  handle ANY
    !siteRef = !!ce
  endhandle

  if (!!kcheckwrite(!siteRef, !lock , !write).not()) then
    -- READ ONLY Access to the $!idtype
    if (!write.eq('R')) then
      !!alert.error('The currently selected MDS Default SITE is in a READ ONLY Database. Select another MDS Default SITE. Aborting MDS Support Creation/Modification')
      !!ce = !cecurr
      return
      -- WRITE Access to the $!idtype, BUT it is LOCKED
    elseif (!lock.eq('Locked')) then
      !!alert.error('The currently selected MDS Default SITE is LOCKED. Aborting MDS Support Creation/Modification')
      !!ce = !cecurr
      return
    endif

  else
    -- User has WRITE access and the SITE is NOT Locked
    -- Therefore allow the USER to continue and Show the Passed Form

    !form.show('At',0,0.07)
  endif

  -- Return to the reference of the previous Current Element
  !!ce = !cecurr

endfunction
