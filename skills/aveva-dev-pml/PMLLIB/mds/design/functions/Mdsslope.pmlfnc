--
-- File:		Mdsslope.pml
-- Type:		Function Definition
-- Group:		Multi Discipline Supports Application
-- Keyword:		MDS
-- Module:		design
-- Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Fri Aug 22
--
--
-- Description:         Function to test for the Max Slope allowed on HORIZ Pipes
--
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Support Options form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsslope(!Form is form)

-- Initialise variables
    !slope  = !Form.slope.val

-- Check that Horiz Slope does NOT exceed 1 in 10
    if (match (!slope,|/|) eq 0) then
      !slope = '1/10'
      !form.slope.setfocus()
      !!alert.message('Invalid format for pipe slope - Reset to the maximum/default value 1/10')
    else
      !split  = split(!slope, '/')
      !first  = !split[1].real()
      !second = !split[2].real()
      if (!first neq 1) then
        !slope = '1/10'
        !form.slope.setfocus()
        !!alert.message('Invalid Pipe Slope - Reset to the maximum/default value 1/10')
      elseif (!second lt 10) then
        !slope = '1/10'
        !form.slope.setfocus()
        !!alert.message('Invalid Pipe Slope - Reset to the maximum/default value 1/10')
      endif
    endif

-- Accept/Set Pipe Slope Gadget to passed value
    !form.slope.val = !slope.string()

-- End function
endfunction

-- End of file Mdsslope.pml
