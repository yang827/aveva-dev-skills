--
-- File: Mdssnipe.pmlfnc
--   Type: Function Definition
--   Group:Multi Discipline Supports Application
--     Keyword: MDS
--   Module: DESIGN
--   Replaces:
--
-- Author: K.Pleschner
-- Created: 06/03/2007 10:52
--
--
-- Description:
-- Handle snipes of all sections below passed db position that have :mdsconn set
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--    1     R        DBREF         Db postion
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdssnipe(!id is DBREF)

-- get list of all sections that could have snipe
  !session = current session

--<wd>may2007<mds12>
--  if !session.module().upcase().match('DESIGN') then
-- Modified for defect 10596
  if !session.module().upcase().match('DESIGN').gt(0) then
--<wd>may2007<mds12>
    var !allangl collect all ( SCTN ) with gtyp of catr eq 'ANG' and (not(badref(:mdsconn))) for $!id
  else
    var !allangl collect all ( SCTN HSTIFF ) with gtyp of catr eq 'ANG' and (not(badref(:mdsconn))) for $!id
--<wd>jul2007<mds12> -- Append to the Collection ARRAY !allangl ALL HSTIFF with GTYP eq to 'EANG' or 'UEAN'
    var !allangl append collect all ( HSTIFF ) with gtyp of catr eq 'EANG' and (not(badref(:mdsconn))) for $!id
    var !allangl append collect all ( HSTIFF ) with gtyp of catr eq 'UEAN' and (not(badref(:mdsconn))) for $!id
--<wd>jul2007<mds12>
  endif

-- exit if non of above found
  if !allangl.unset() then
    return
  endif

  !storece = !!ce

--$R110
-- process sections
  do !val values !allangl
    !angl = !val.dbref()
--$P=========*** Start ***==========
--!xstiff = !angl.:mdsconn
--$P Processing MDS SCTN ... $!angl.fullname and ... $!xstiff.fullname
    !snipe = object MDSSNIPE(!angl,!angl.:mdsconn)
       handle ANY
--q var !!error
        skip
      endhandle

    !snipe.resolve()
      handle ANY
--q var !!error
        skip
      endhandle
--$P=============================>>>>>>>>>>>>>...
  enddo

--<wd>aug2007<mds12>
-- Ensure that ALL the ATTRIBUTE RULES are EXECUTED for all SNIPE FITTINGS on a MDS STRUCTURE
  if (!id.type.eq('STRU')) then
    !!ce = !id
--$P  rule execute all on all fitt for $!id
    rule execute all on all fitt for $!id
    handle ANY
--<wd>oct2007<mds12> -- "handle any" etc... added here when NO SNIPES EXIST - ERROR found during fixing of Defect No. P-2386
    endhandle
  endif
--<wd>aug2007<mds12>

  !!ce = !storece

-- End function
endfunction
