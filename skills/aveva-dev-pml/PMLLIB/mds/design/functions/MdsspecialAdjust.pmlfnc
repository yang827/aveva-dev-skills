--
-- File:  MdsspecialAdjust.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--   Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Tony Martin
-- Created:  12/01/2005 10:52
--
--
-- Description:
-- function to adjust the weld positions on an ancillary with ppoints 301 onwards
-----------------------------------------------------------------------------------
-- method
-- from the bar, check to see if the ancilliary is close to the bar and if it
-- needs to be cut back. This is defined by the length along the pipe compared
-- with the width of the supporting bar.
-- Assumptions
-- 1) The bar is 90 degrees to the pipe direction
-- 2) The atta has properties bwid and boff for bearing width and bearing offset
-- 3) bwid and boff use despar 7 and 8 respectively
-- 4) bwid is set to the full length of the atta by default
-- 5) if the position of the atta does not lie near the beam, no values are set


-- Define Function
define function !!mdsSpecialAdjust(!form is FORM)

  !save = !!ce

  !stru = !form.support.stru
  var !bars coll all sctn for $!stru

  !attalist = ARRAY()
  !attas = !form.support.atta
  do !a values !attas
    !plist = !a.ppls
    do !b values !plist
      if !b.gt(300)then
        !attalist.append(!a)
        break
      endif
    enddo
  enddo

  !resetlist = ARRAY()
  do !a values !attalist
    !obj = object MDSPLINES(!a,!bars)
    if !obj.sctn.unset() then
      skip
    else
      !data[1] = !obj.sctn
      !data[2] = !a
      !resetlist.append(!data)
    endif
  enddo
  -- get a list of attas and do each one in turn
  -- find the nearest suitable sctn and do what with it????????

  -- now loop through the attas to find out if there is a suitable sctn

  !barlist = ARRAY()
  do !a values !resetlist
    -- go and get the offset and weld length values from the section
    !obj = object MDSPLINES(!a)
    !barlist.append(!obj)
  enddo

  -- need to check if the weld is on the plate or less than the width of the steel
  do !b values !barlist
    !!ce = !b.atta
    !lenpar = !!mdsGetDesp('BWID')
    if !lenpar eq 0 then
      skip
    endif
    desp n$!lenpar $!b.bearinglength
    --$p desp n$!lenpar $!b.bearinglength
    !offspar =  !!mdsGetDesp('BWOF')
    if !offspar eq 0 then
      skip
    endif
    --$p   desp n$!offspar $!b.bearingoffset
    desp n$!offspar $!b.bearingoffset
  enddo

  -- go back to where we started
  !!ce = !save

endfunction
