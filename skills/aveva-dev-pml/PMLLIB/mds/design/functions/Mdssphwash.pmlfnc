--
-- File:		Mdssphwash.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MWAS***
--
-- Author:		I.Osborne
-- Created:		Thu Mar 08
--
--
-- Description:
-- Function to add spherical washers to support framework types 'FT01' and 'FT02',
-- and hanger types 'HT01' to 'HT10' inclusive
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Framework support form.
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdssphwash(!form is FORM)

-- Initialise variables
    !support   = !form.support
    !datum     = !support.datum
    !selection = !form.washer.val

-- Set UDA :MDSSwasher at Datum Atta for Spherical Washers selection
    !!MdsDacControl(true)
    if !selection then
      !!ce = !datum
      :MDSSwasher true
    else
      !!ce = !datum
      :MDSSwasher false
    endif
   !!MdsDacControl(false)
-- End function
endfunction

-- End of file Mdssphwash.pml
