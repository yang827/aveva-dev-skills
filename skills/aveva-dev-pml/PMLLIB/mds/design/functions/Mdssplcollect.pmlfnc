--
-- Author:		Wayne Dodwell
-- Created:	        Tuesday 16th June 1998
--
--
-- Description:
-- Function to Collect STRUCTURE(s) and/or ATTA(s) elements for all Existing MDS Supports
-- shown in the selected list to Create a Special in form gadget '!!Mdssplframe.list'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        ARRAY        An array of STRINGS
--
-- Return:
--    [Data Type]   [Description]
--      ARRAY         An array of DBREFS (Structures and/or Attas) in gadget '!!Mdssplframe.list'
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdssplcollect(!array is ARRAY) is ARRAY

-- Modified code to add by name rather than collecting, this proves
-- to be extremely slow on large databases.

-- Initialise Variables
    !data = array()
    !list = !array

--------------------------------------------------------------------------------
-- Append all Structures and/or Attas into an array
    do !index index !list
      !cecomp = '/' & !list[!index]
      !cedbrf = !cecomp.dbref()

      if (!cedbrf.type.string().eq('STRU')) then
-- Get All Attas Associated with a MDS SUPPORT with an Associated Structure
        !data1 = !cedbrf
        !data2 = Array()
        !data3 = Array()
      $!<cecomp>/DATUM
        handle none
          !data2.append(!!CE)
          same
        elsehandle any
        endhandle
      $!<cecomp>/SREF
        handle none
          !data2.append(!!CE)
          same
        elsehandle any
        endhandle

      do !Count from 1
        $!<cecomp>.$!Count
          handle none
            if !!CE.type.eq('ATTA') then
              !data3.append(!!CE)
            endif
            same
          elsehandle any
            break
          endhandle
      enddo

        -- !data2 = !!kcollectallfor('ATTA', '(matchwild(name,|$!<cecomp>/*|))', =0/0)
        -- !data3 = !!kcollectallfor('ATTA', '(matchwild(name,|$!<cecomp>.*|))', =0/0)
-- Put all associated attas into a Single array
        !data.append(!data1)
        !data.appendarray(!data2)
        !data.appendarray(!data3)

      else
-- Get All Attas Associated with a MDS SUPPORT without an Associated Structure
        --!data4 = !!kcollectallfor('ATTA', '(matchwild(name,|$!cecomp|))', =0/0)
        !data4 = Array()
-- Put all associated attas into a Single array
      $!<cecomp>
        handle none
          !data4.append(!!CE)
          same
        elsehandle any
        endhandle
      $!<cecomp>/DATUM
        handle none
          !data4.append(!!CE)
          same
        elsehandle any
        endhandle
      $!<cecomp>/SREF
        handle none
          !data4.append(!!CE)
          same
        elsehandle any
        endhandle

      do !Count from 1
        $!<cecomp>.$!Count
          handle none
            if !!CE.type.eq('ATTA') then
              !data4.append(!!CE)
            endif
            same
          elsehandle any
            break
          endhandle
      enddo

        !data.appendarray(!data4)
      endif

    enddo

-- Return ARRAY of DBREFS
      !spldata = !data
      return !spldata

--------------------------------------------------------------------------------

  endfunction
-- End function

-- End of file Mdssplcollect.pml
