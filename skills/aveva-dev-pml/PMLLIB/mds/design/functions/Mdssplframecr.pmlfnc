--
-- File:		Mdssplframecr.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 22nd April 1998
--
--
-- Description:
-- Function to Create a SPECIAL Support (Structural Members and Attas) from
-- the STANDARD Framework Type Supports found in the list gadget '!!Mdssplframe.list'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdssplframecr()

-- Check if List gadget has more than One Support in the List
    if (!!Mdssplframe.list.dtext.empty()) then
      !!alert.error('No Supports in the list to create a SPECIAL Support.')
      return
    elseif (!!Mdssplframe.list.dtext.size().eq(1)) then
      if (!!alert.confirm('Only ONE Support in the list to create a SPECIAL Support. Do you want to Continue?') eq 'NO') then
        return
      endif
    endif

-- Check if User wishes to Continue.
    if (!!Mdssplframe.list.dtext.size().gt(1)) then
      if (!!alert.confirm('Include all the Supports HIGHLIGHTED in the graphical view and shown in the List to Create a SPECIAL Support?') eq 'NO') then
        return
      endif
    endif
-- Find current units and set the distance unit to metric
    !currentunits = !!kgetsetunits()

--------------------------------------------------------------------------------------
-- Generating Support Message.. Prompt to Screen
    !!Mdscreatemess(true)

--------------------------------------------------------------------------------------
-- Initialise variables
    !form    = !!Mdssplframe
    !support = !!Mdssplframe.support
    !stru    = !support.stru
    !name    = !stru.name
    !frame   = !name & '/MAIN'


---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
--<GE> 06-08-06 HPD0033412 The VPRM Code only needs to be executed for a Framatome Project
--
-- This is ONLY!!!!! a temporary fix for other customers that have the Gateway loaded
 if (desc of /MDS/TEMPLATES eq 'Framatome Templates') then

-- *************************************************************************************************************
-- *** MDS VPRM MTO "DELETE" DATA to BE COLLECTED ***BEFORE*** the MDS SUPPORTS are actually DELETED in PDMS ***
-- *************************************************************************************************************
--
-- Get an ARRAY of the MDS SUPPORT DBREFS to be "DELETED" from the ".list" gadget
    !supparr = ARRAY()
    !zlist   = !form.list.dtext
    do !zdstru indices !zlist
      !zstru = '/' & !zlist[!zdstru]
      !zdbref = !zstru.dbref()
      !supparr.append(!zdbref)
    enddo

-- CHECK if VPRM is ACCESSIBLE and being used on the Current PDMS Project for the AUTOMATIC VPRM UPDATE
-- ONLY need to set up the VPRM object if VPRM is being used on the PDMS Project
    !mdstype     = !!mdsabatype(!supparr[1])
    !vprmprocess = FALSE

-- <GE> 07-08-06 added check for VPRM discipline as set in the Gateway config file
-- Project Code & Session data
   !proj    = current project
   !code    = !proj.code()
   !projlow = !code.lowcase()
   !projup  = !code
   !projdir = object file ('%$!<projlow>iso%')

-- Read the VPRM Gateway Config File into a "VPRMCONFIG" OBJECT
   !vprmfilegen  = FALSE
   if (defined(!!vprmexists)) then
     if !!vprmexists then
       !projcfg = object file ('$!projdir/pdsc01.cfg')
       !vprmcfile = object vprmconfig()
       !vprmcfile.read(!projcfg)
       if !mdstype.eq('FRAME') then
         !mdsdatumname = !supparr[1].name & '/DATUM'
         !mdsdatumdbrf = !mdsdatumname.dbref()
         if (!mdsdatumdbrf.owner.pspe.purp.upcase().eq('HVAC')) then
           if !vprmcfile.mdshvacdelrename then
             !vprmfilegen  = TRUE
--    $P HVAC Framework
           endif
         elseif (!mdsdatumdbrf.owner.pspe.purp.upcase().eq('TRAY')) then
           if !vprmcfile.mdselecdelrename then
             !vprmfilegen  = TRUE
--    $P TRAY Framework
           endif
         elseif (!mdsdatumdbrf.owner.pspe.purp.upcase().eq('PIPE')) then
           if !vprmcfile.mdspipedelrename then
             !vprmfilegen  = TRUE
--    $P PIPE Framework
           endif
         endif
       else
         if !vprmcfile.mdspipedelrename then
           !vprmfilegen  = TRUE
--    $P PIPE
         endif
       endif
     endif
   endif

--   q var !vprmcfile.mdshvacdelrename
--   q var !vprmcfile.mdspipedelrename
--   q var !vprmcfile.mdselecdelrename

-- <GE> 07-08-06

-- IGNORE any TRUNNION type MDS supports, as they are NOT PASSED to VPRM via the MDS VPRM Interface
    if (!mdstype.neq('TRUNNION')) then

-- ************************************************************************************************
-- **********************
-- *** IMPORTANT NOTE ***
-- **********************
-- FRAMATOME<Wolfgang Umnig> & AVEVA<Neale Morris> -- Telecon Monday 21jan2006
-- FRAMATOME request a TEMPORARY SOLUTION ONLY for
-- MDS HVAC DUCTING and MDS ELECTRICAL TRAY FRAMEWORK Supports
-- *** DO NOT *** CREATE and/or AUTOMATICALLY TRANSFER a
-- MDS VPRM MTO file to the VPRM Project TRANSFER
-- DATABASE for MDS HVAC and TRAY FRAMEWORK Supports
--
-- i.e. TEMPORARILY IGNORE and DO NOT PROCESS a MDS VPRM MTO "DELETE or "RENAME"
--      FOR any MDS HVAC and MDS TRAY -- STRUCTURE Supports --
--
---------------------------------------------------------------------
-- *** DO NOT PROCESS *** a MDS VPRM MTO file if the !!mdstype = FRAME
-- and the SUPPORT type is a MDS HVAC or TRAY FRAMEWORK Support
---------------------------------------------------------------------
--
-- Only Process MDS STRUCTURE Supports when CONVERTING EXISTING MDS SUPPORT STRUCTURES into a MDS SPECIAL
      if (!mdstype inset ('FRAME')) then
-- Determine the PURPOSE of the MDS ATTA's OWNING BRANCH PSPE
-- Get the MDS DATUM ATTA set for utilising the MDS DESIGN Application
        !mdsdatumnam = !supparr[1].name & '/DATUM'
-- Get the PURPOSE of the PSPE of the OWNER of the DATUM SUPPORT ATTA, i.e. the BRANCH
        !mdsdatumdbf = !mdsdatumnam.dbref()
        !mdsdatumown = !mdsdatumdbf.owner.pspe.purp
     endif

-- Only Process MDS STRUCTURE Supports when CONVERTING EXISTING MDS SUPPORT STRUCTURES into a MDS SPECIAL
--      if (!mdstype inset ('FRAME')) then
---------------------------------------------------------------------
-- ONLY Process when the FIRST MDS FRAMEWORK SUPPORT, i.e. !supparr[1],
-- DATUM ATTA belongs to a MDS FRAMEWORK for a PIPE SUPPORT
---------------------------------------------------------------------
-- *** DO NOT *** Create or Process a MDS VPRM MTO file
-- for any MDS HVAC or MDS TRAY FRAMEWORK SUPPORTS
--<GE>aug06      if ((!mdstype.eq(|FRAME|)) and (!mdsdatumown.eq(|PIPE|))) then
      if ((!mdstype.eq(|FRAME|) and (!mdsdatumown.eq(|PIPE|) and (!vprmfilegen)))) then
---------------------------------------------------------------------
-- ************************************************************************************************

-- When the VPRM FILE "%PDMSEXE%\pdsc01.exe" EXISTS on ENTRY to PDMS,
-- the global variable !!VPRMEXISTS = TRUE is set via the PDMS ENTRY login file,
-- ...\PDMS-VPRM4.2\pdmsui\MON\ADMIN\LOGIN
        if (defined(!!vprmexists)) then
          if (!!vprmexists) then
            !vprmprocess = TRUE
-- Check, Populate and Store the "MDS VPRM MTO" objects of the MDS SUPPORT about to be DELETED.
-- <The objects are MDSVPRMMTO, MDSVPRMOBJECT and MDSVPRMDELETE>
            !newsuppname = !!mdssplframe.strname.val
            !mdsvprmdelsupp = object mdsvprmdelete(!supparr, 'DELETE', !mdstype, !newsuppname)
-- Temporary Global variable used for INTERROGATION etc... ONLY
            !!mdsx = !mdsvprmdelsupp
          endif
        endif

      elseif (!mdstype.eq('ERROR')) then
-- MDS SUPPORT TYPE is NOT Valid. Therefore MDS VPRM MTO file is NOT to be GENERATED
        !vprmprocess = FALSE

      endif
    endif

 endif
--<GE> 06-08-06 HPD0033412
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------


--------------------------------------------------------------------------------
-- Master Datum Atta - Always the First Standard Support shown in the gadget '!!Mdssplframe.list'
    !mdatum        = '/' & !form.list.dtext[1] & '/DATUM'
    !datum         = !mdatum.dbref()
    !support.datum = !datum
    !msref         = '/' & !form.list.dtext[1] & '/SREF'
    !sref          = !msref.dbref()
-- Reselect Master SREF Atta 'spref' to be a SPECIAL
    !!ce           = !sref
    !!MdsDacControl(true)
    sel spref with styp 'SPECIAL' spec /MDS

-- Master Datum Structure is '!!Mdssplframe.list.dtext[1]'
    !mstring       = '/' & !form.list.dtext[1]
    !mstru         = !mstring.dbref()
    !!ce           = !mstru
    !mstrori       = ori wrt world

-- Split Form Array member '.specialmem' into Different Elements Types
-- ie. 'Attas' and 'Strus'
    !special  = !form.specialmem
    !specatta = array()
    !specstru = array()

    do !gtyp index !special
      !!ce = !special[!gtyp]
      if (!!ce.type.string().eq('ATTA')) then
-- Set an Array of Attas in the SPECIAL
        !specatta.append(!special[!gtyp])
      elseif (!!ce.type.string().eq('STRU')) then
-- Set an Array of Structures in the SPECIAL
        !specstru.append(!special[!gtyp])
      endif
    enddo

-- Rename the Master DATUM ATTA and store any unwanted 'SREF' Attas
-- and UNNAME all other ATTAs
    !!MdsDacControl(true)
    !srefdelete = array()
    do !numb index !specatta
      !!ce = !specatta[!numb]
      if (!specatta[!numb].name.eq(!mdatum)) then
        -- dtf rename OLETs before and after if required
        !Atta = !!ce
        !oldattaname = !!ce.name
        prev olet
        handle ANY
        elsehandle NONE
          if !!ce.name.match(!oldattaname).gt(0) then
            !extn = !!ce.name.after(!oldattaname)
            !newname = !name & '/DATUM' & !extn
            !!ce.name =!newname
            prev olet
            handle ANY
            elsehandle NONE
              if !!ce.name.match(!oldattaname).gt(0) then
                !extn = !!ce.name.after(!oldattaname)
                !newname = !name & '/DATUM' &!extn
                !!ce.name =!newname
              endif
            endhandle
          endif
        endhandle
        !!ce = !Atta
        name $!<name>/DATUM
        !DatumAtta = !!ce
        nex olet
        handle ANY
        elsehandle NONE
          if !!ce.name.match(!oldattaname).gt(0) then
            !extn = !!ce.name.after(!oldattaname)
            !newname = !name & '/DATUM' &!extn
            !!ce.name =!newname
            nex olet
            handle ANY
            elsehandle NONE
              if !!ce.name.match(!oldattaname).gt(0) then
                !extn = !!ce.name.after(!oldattaname)
                !newname = !name & '/DATUM' &!extn
                !!ce.name =!newname
              endif
            endhandle
          endif
        endhandle
        !!ce = !DatumAtta
      elseif (!specatta[!numb].name.match('SREF').gt(0)) then
        if (!specatta[!numb].name.eq(!msref)) then
          name $!<name>/SREF
        else
          !srefdelete.append(!specatta[!numb])
        endif
      else
-- dtf don't unname because we need it later to rename OLETS/LUGS
--unname
      endif
    enddo

-- Delete any unwanted 'SREF' Attas
    do !xsref values !srefdelete
      !!ce = !xsref
      delete atta
    enddo

-- Rename All ATTAs except the new DATUM and SREF Attas
    !count = 0
    do !index indices !specatta
      !!ce = !specatta[!index]
      handle any
        skip
      endhandle
      if (!specatta[!index].name.eq(!datum.name)) then
        !!MdsTransport(!!CE,!name)
        skip
      elseif (!specatta[!index].name.eq(!sref.name)) then
        skip
      else
        !count = !count + 1
        !!MdsDacControl(true)

-- dtf rename OLETs before and after if required
        !Atta = !!ce
        !oldattaname = !!ce.name
        prev olet
        handle ANY
        elsehandle NONE
          if !!ce.name.match(!oldattaname).gt(0) then
            !extn = !!ce.name.after(!oldattaname)
            !newname = !name & '.$!count' & !extn
            !!ce.name =!newname
            prev olet
            if !!ce.name.match(!oldattaname).gt(0) then
              !extn = !!ce.name.after(!oldattaname)
              !newname = !name & '.$!count' & !extn
              !!ce.name =!newname
            endif
          endif
        endhandle
        !!ce = !Atta
        name $!<name>.$!count
        !!MdsTransport(!!CE,!name)
        !Atta = !!ce
        nex olet
        handle ANY
        elsehandle NONE
          if !!ce.name.match(!oldattaname).gt(0) then
            !extn = !!ce.name.after(!oldattaname)
            !newname = !name & '.$!count' & !extn
            !!ce.name =!newname
            nex olet
            if !!ce.name.match(!oldattaname).gt(0) then
              !extn = !!ce.name.after(!oldattaname)
              !newname = !name & '.$!count' & !extn
              !!ce.name =!newname
            endif
          endif
        endhandle
        !!ce = !Atta
      endif
    enddo

-------------------------------------------------------------------------------------------
-- Need to collect and store all SUBS and SCTNS in seperate single arrays
-------------------------------------------------------------------------------------------
-- Get All Structural Members for Including into the SPECIAL Structure Support
    !subsmem = array()
    !frmwmem = array()
    !tmplmem = ARRAY()
    do !xmem indices !specstru
      !subsmem.append(!!kcollectallfor('SUBS','',!specstru[!xmem]))
      !frmwmem.append(!!kcollectallfor('FRMW mem','',!specstru[!xmem]))
      !tmplmem.append(!!kcollectallfor('TMPL mem','',!specstru[!xmem]))
    enddo
-----------------------------
-- Store all Structural SCTNs and SUBS Positional and Orientational Data wrt world
-- To enable all Structural elements to be returned to position, ori etc.
-- All arguments are arrays

--------------------------------------------------------------------------------------------------
-- The function below 'Mdssplreset.pml' is currently actioned, but NOTHING is DONE with the DATA
-- it sets in the form ARRAY member '!!Mdssplframe.reset' .
-- It was to be USED to ask USERS if they wanted to RESET the SPECIAL SUPPORT just CREATED
-- back to the EXISTING MDS Supports that have just been MERGED into the SPECIAL. This has NOT been DONE.
--xxx
    !!MdsDacControl(true)
    !!Mdssplreset(!specstru,!frmwmem,!subsmem)
--xxx
-- The function above 'Mdssplreset.pml' is currently actioned, but NOTHING is DONE with the DATA
--------------------------------------------------------------------------------------------------

    !!MdsDacControl(true)
    !!Mdssplstrumem(!frmwmem,!subsmem)

-----------------------------

-- Include all Standard Framework members (SCTNs) into the SPECIAL Structure Framework
    !!MdsDacControl(true)
    do !fmem indices !frmwmem
      do !xfram values !frmwmem[!fmem]
        !!ce = !frame.dbref()
        include $!xfram
        !!ce = $!xfram
        -- unname
        -- handle (41,25)
-- (41,25)   Current element has no name, * unchanged
        -- endhandle
        -- Rename the sections using the V1 naming convention
        do !Rename from 1 to 50
          if !!ce.type.eq('SCTN') then
            name $!<Name>-V$!Rename
              handle any
              elsehandle none
                break
              endhandle
              -- resets this because desp holds min and max lengths in standard frameworks
              if !!ce.gtype.neq('PLAT') then
                despar 0mm
              endif
                handle ANY
                endhandle

          elseif !!ce.type.eq('PNOD') then
--$P rename PNOD's and PJOIS here
            pjoi 1
            !Crefname = !!ce.cref.name
            end
            !Pnodnum = !!ce.name.after('/PNOD')
            !NewName = !Crefname & '/PNOD' & !pnodnum
            unname
            handle ANY
            endhandle
            name $!NewName
            pjoi 1
            !NewPJOIname = !newname.replace('PNOD','PJOI')
            name $!NewPJOIName
          endif
        enddo
-- dtf >> 28.07.06 moved to line 372 not applicable for pjoi etc
--        despar 0
--          handle ANY
--          endhandle
      enddo
    enddo

-- Reorder renamed elements
    !!MdsDacControl(true)
    frmw
    !NewFrmwMem = mem count
    !from = !NewFrmwMem - 1
    do !reorder from !from to 1 by -1
      reorder 1 after $!reorder
    enddo
    reorder $!NewFrmwMem before 1
      handle any
      endhandle

-- Include all Standard Structural SUBS into the SPECIAL Structure
    do !smem indices !subsmem
      do !xsubs values !subsmem[!smem]
        !!ce = !support.stru
        include $!xsubs
        !!ce = $!xsubs
        -- unname
        -- handle (41,25)
-- (41,25)   Current element has no name, * unchanged
        -- endhandle
-- Rename the subs using the -SUBS1 naming convention
        do !Rename from 1 to 50
          name $!<Name>-SUBS$!Rename
            handle any
            elsehandle none
              break
            endhandle
        enddo
$(

-- Unname all MEMBERS of Current SUBS
        do !index
          $!index
          handle any
            break
          elsehandle none
            unname
            handle (41,25)
-- (41,25)   Current element has no name, * unchanged
            endhandle
            subs
          endhandle
        enddo
$)
      enddo
    enddo

-- Reorder renamed elements
    STRU
    !NewSubsMem = mem count
    !from = !NewSubsMem - 1
    do !reorder from !from to 1 by -1
      reorder subs 1 after subs $!reorder
    enddo
    reorder subs $!NewSubsMem before subs 1
      handle any
      endhandle
    reorder frmw 1 before 1

-- include the welds into a new template so that the weld references are maintained
    if !tmplmem.size().gt(0) then
        Stru
        !tmpln = !name & '/TMPL'
        new TMPL $!tmpln after last mem
        do !welds values !tmplmem
           do !weld values !welds
             include $!weld
             handle ANY
                -- possibly a weld which is not included properly
                -- ie a master weld
             endhandle
           enddo
        enddo
    endif

-- now rename the welds
    STRU
    var !sctns collect all sctn for ce
    do !sctn values !sctns
      !a = object mdsweldlist(!sctn.dbref(),true)
    enddo

-- rename the temporary welds to proper ones
    tmpl
    handle ANY
      -- no welds on this support
    elsehandle NONE
      rename all /SWELD /WELD
    endhandle

    Stru

--------------------------------------------------------------------------------
-- Delete the STRU elements shown in the list gadget '!!Mdssplframe.list'
-- whose 'Framework Members' and 'SUBS' have been included into the SPECIAL Support
    !list = !form.list.dtext
    do !dstru indices !list
      !xstru = '/' & !list[!dstru]
      !dbstr = !xstru.dbref()
      handle any
        skip
-- STRU Element does NOT exist - Element in gadget '.list' is a MDS Atta (ONLY) without a Structure
-- and has already been incorporated INTO the SPECIAL Support by changing the name of the Original ATTA
      endhandle
      !!ce   = !dbstr

      delete stru
        handle (41,229)
          delete atta
        endhandle

    enddo

--------------------------------------------------------------------------------
-- Navigate to Stru
    !!ce = !stru

-- Reset all teh :MDSAttarefs for all sctns
    var !AllSctns coll all sctn for ce

    !!MdsDacControl(true)
    do !ResetRefs values !AllSctns
      !!ce = !ResetRefs.dbref()
      :MDSAttaRef default
    enddo

    !!ce = !Stru
-- Position Special Stru at P9 of Selected Master Support Datum Atta
    at p9 of $!datum
    ori $!mstrori

-- All Structural Members - RePosition, ReOri etc. wrt World
-- from the form member !!Mdsplframe.store
    !!Mdssplrestore(!form)
    !!ce = !stru


---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
--<GE> 06-08-06 HPD0033412 The VPRM Code only needs to be executed for a Framatome Project
-- This is ONLY!!!!! a temporary fix for other customers that have the Gateway loaded
 if (desc of /MDS/TEMPLATES eq 'Framatome Templates') then
--<wd>oct2005
---------------------------------------------------------------------------------------------------
-- Populate the Object member !mdsvprmdelsupp.vprmrecords with
-- the MDS VPRM MTO FILE DATA for the "RENAMED" MDS Support
---------------------------------------------------------------------------------------------------

-- IGNORE any TRUNNION type MDS supports, as they are NOT PASSED to VPRM via the MDS VPRM Interface
    if (!mdstype.neq('TRUNNION')) then
      if (!vprmprocess) then

-- Check, Populate and Store the "MDS VPRM MTO" objects of the MDS SUPPORT about to be DELETED.
-- <The objects are MDSVPRMMTO, MDSVPRMOBJECT and MDSVPRMDELETE>
-- Get the DBREF of the Support to be DELETED in VPRM, but RENAMED in PDMS
        if (!newsuppname.match('/').eq(1)) then
          !rensupp = !newsuppname.dbref()
        else
          !newname = '/' & !newsuppname
          !rensupp = !newname.dbref()
        endif

        !!ce      = !rensupp
        !supplist = ARRAY()
        !supplist.append(!rensupp)
        !mdsvprmrename = object mdsvprmdelete(!supplist, 'RENAME', !mdstype, !newsuppname)
-- Temporary Global variable used for INTERROGATION during DEVELOPMEMT etc... ONLY
        !!mdsr.delete()
        handle ANY
        endhandle
        !!mdsr = !mdsvprmrename

---------------------------------------------------------------------------------------------------
-- *******************************************************************************
-- Write and AUTOMATICALLY LOAD into VPRM -- the MDS VPRM MTO "RENAME" Output File
-- *******************************************************************************
--
-- MDS VPRM MTO files are about to be GENERATED and "AUTOMATICALLY LOADED" into the VPRM Database
-- So SAVEWORK in the PDMS Database to UPDATE and reflect that the MDS SUPPORT has been DELETED
        savework

-- CHECK if VPRM is ACCESSIBLE etc... for the Automatic UPDATE
        !vprmerr  = ARRAY()
        !mdsnamn  = !mdsvprmrename.mdsvprmmto[1].suppname
        !vprmtest = !mdsvprmrename.vprmdbtest(!vprmerr, !mdsnamn)
        if (!vprmtest.not()) then
-- Append ERRORS to the Beginning of the ARRAY !mdsvprmdelsupp.errarr
          !mdsvprmrename.errarray.insertarray(1, !vprmerr)
         -- q var !vprmerr[2]
         -- q var !vprmerr[3]
         -- !alertuser = !vprmerr[2] & !vprmerr[3]
-- <GE> (04-08-06) modified the alert error as the string was too long.
          !alertuser = !vprmerr[3]
        endif

-- In ALL Cases -- Write the MDS VPRM MTO "DELETE" File and the MDS VPRM LOG File
-- Pass the OPTION "RENAME" and the ORIGINAL PML "DELETE" Object created above for the
-- ORIGINAL MDS Support RENAMED above and represented by "DELETE" Record in the !mdsvprmdelsupp object
        !mdsvprmrename.vprmfiles('RENAME',!mdsvprmdelsupp)

-- Check if the VPRM System is AVAILABLE etc...
        if (!vprmtest.not()) then
-- Alert User that the VPRM System is NOT AVAILABLE for whatever reason!
          !!alert.error(!alertuser)

        else
-- !vprmtest = TRUE
-- This means that the VPRM DB is AVAILABLE  for AUTOMATIC LOADING of MDS VPRM MTO Files
-- Perform the Automatic UPDATE of the VPRM Database with the MDS VPRM MTO file of the DELETED MDS Support
          !pdsc02exeobj = object file('%pdmsexe%/pdsc02.exe')
          !pdsc02exefil = !pdsc02exeobj.fullname()

-- Load the MDS VPRM MTO "$!mdsvprmrename.option" file into VPRM
          --syscom '$!pdsc02exeobj $!mdsvprmrename.mtofile'
          syscom '$!pdsc02exefil $!mdsvprmrename.mtofile'

-- Echo Messages to the PDMS Windows Shell
          syscom 'echo MESSAGE -- VPRM DB AUTOMATIC LOADING of MDS SUPPORT MTO "$!mdsvprmrename.option" file:'
          syscom 'echo MESSAGE -- $!mdsvprmrename.mtofile'

        endif

      else
---------------------------------------------------------------------
-- The VPRM System is NOT Available -- The Project is NOT using VPRM
-- Therefore there is NOTHING TO DO
---------------------------------------------------------------------
      endif
    endif
--<wd>oct2005
 endif
--<GE> 06-08-06 HPD0033412
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------


-- Add to Graphical View in the Default Colours
    add ce

--------------------------------------------------------------------------------
-- UnEnhance All Elements
    unenhance all

-- Reset Form Gadgets
    !dtext = array()
    !form.list.dtext  = !dtext
    !form.tmaster.val = ''

-- Update support data held in form
    !!Mdssplframe.support = !support

--------------------------------------------------------------------------------------
-- Remove Wait.. Prompt from Screen
    !!Mdscreatemess(false)

-- Hide form
    !!Mdssplframe.hide()

-- Clear form data
  !!MdsDacControl(false)

-- Reset Units
    !!kRestoreUnits(!currentunits)

--------------------------------------------------------------------------------------
  endfunction
