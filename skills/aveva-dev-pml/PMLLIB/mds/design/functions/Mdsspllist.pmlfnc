--
-- File:		Mdsspllist.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:	        Tuesday 21st April 1998
--
--
-- Description:
-- Function to ADD or REMOVE an Existing Support to Create a Special
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       ADD    - Add existing support to the list
--                              or  REMOVE - Remove selected support from the list
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsspllist(!option is STRING)

-- Initialise Variables
    !form  = !!Mdssplframe
    !dtext = !form.list.dtext
    !stru  = false

-- Check that SPECIAL Structure Currently being Created is NOT Added to the List
    if (!form.strname.val.trim() eq !form.name.val.trim()) then
      !!alert.error('Cannot $!option the SPECIAL Structure being Created to the Support List')
      return
    endif

-- Add Existing Standard Support to List
--------------------------------------------------------------------------------
    if (!option.eq('ADD')) then

      if (!form.name.val.eq('unset')) then
        !!alert.error('Nothing to Add. Select a Standard Support')
        !form.name.val   = 'unset'
        return
      else
        !string = '/' & !form.name.val
        !dbref  = !string.dbref()
        if (!dbref.badref()) then
-- Invalid DBREF
          !!alert.error('Element does NOT exist. Nothing to Add. Select a Standard Support')
          !form.name.val   = 'unset'
          return
        else
-- Check for WRITE access to database
          var !write exists $!dbref update
          if ('$!write' neq 'TRUEC') then
            !!alert.error('The selected support is in a READ Only database and may NOT be included in this SPECIAL Support')
            !form.name.val   = 'unset'
            return
          endif
-- Valid DBREF
          !dtext.append(!form.name.val)
          !dtext.unique()
          !form.list.dtext = !dtext
          !form.name.val   = 'unset'
        endif
-- Enhance All Support Members Included in Special Framework Support Type
        !spldata = !!Mdssplcollect(!dtext)
        !form.specialmem = !spldata
        !form.specialmem.unique()
        !!kenhancelist(!form.specialmem)
        !form.supportmem.clear()
      endif

    elseif (!option.eq('REMOVE')) then

-- Remove Existing Standard Support from List
--------------------------------------------------------------------------------
      if (!form.list.dtext.empty().not()) then

------------------------------------
-- Added code - 16june1998 - wd -

-- Check if REMOVING '1st' in List that the NEW '1st' in LIST(ie. the new MASTER Support),
-- eg. 2nd in List, has an ASSOCIATED STRUCTURE

        if (!form.list.dtext.size().gt(1)) then
          if (!!Mdssplframe.list.val.eq(1)) then
-- Check type of 2nd in List is a STRU and not an ATTA only Support
            !numtwo = '/' & !form.list.dtext[2]
------------------------------------
            if (!numtwo.dbref().type.string().neq('STRU')) then
              if (!form.list.dtext.size().eq(2)) then
                !!alert.error('Unable to REMOVE the Selected Support, as the remaining Support in the list does NOT have an Associated Structure.')
                return
              else
-- Make the next Support with a Structure and of the Correct Support Type the MASTER, or if 'ATTA' ONLY supports exist, ABORT
                do !num index !dtext
--xxx                  skip if (!num.eq(1) or !num.eq(2))
                  skip if (!num.eq(1))
                  !string$!num = '/' & !dtext[!num]
                  !currname  = !string$!num
                  !currdbref = !currname.dbref()
                  if (!currdbref.type.string().eq('STRU')) then
                    !xsupptyp = !!Mdsnamespl.type.selection('dtext').upcase()
                    !spectype  = !!Mdsspltype(!!Mdsnamespl.type.selection('rtext'),!currdbref,'REMOVE')
                    if (!spectype[1]) then
                      !stru = true
-- The !master variable contains the name of the the new MASTER Support, which is to be made FIRST
-- in the LIST at the end of this function.
                      !master = !currdbref.namn
                      break
                    else
                      !stru = false
                      skip
                    endif
                  endif
                enddo
                if (!stru.not()) then
                  !!alert.error('Unable to REMOVE the Selected Support, as NONE of the remaining Supports in the list have an Associated Structure, or NONE are of the CORRECT Type to be the MASTER for a $!xsupptyp')
                  return
                endif
              endif
------------------------------------

            else
-- Element '!numtwo.dbref().type.string().eq('STRU')'
              !xsupptyp = !!Mdsnamespl.type.selection('dtext').upcase()
              if (!form.list.dtext.size().eq(2)) then
-- Support is a Structure - However Is the Support Type Allowable in the Current Special being Constructed
                !currdbref = !numtwo.dbref()
                !spectype  = !!Mdsspltype(!!Mdsnamespl.type.selection('rtext'),!currdbref,'REMOVE')
                if (!spectype[1]) then
                  !stru = true
                  !master = !currdbref.namn
                else
                  !!alert.error('Unable to REMOVE the Selected Support, as the remaining Support in the list is a $!spectype[2] Support, which may NOT be the MASTER for a $!<xsupptyp>')
                  return
                endif

              else

-- If Number of Supports in List is Greater than '2'
-- Make the next 'MDS' or 'SPECIAL' Support the MASTER, or if NONE exist in the list, ABORT
                do !index index !dtext
--xxx                  skip if (!index.eq(1) or !index.eq(2))
                  skip if (!index.eq(1))
                  !next$!index = '/' & !dtext[!index]
                  !currname      = !next$!index
                  !currdbref     = !currname.dbref()
                  !spectype      = !!Mdsspltype(!!Mdsnamespl.type.selection('rtext'),!currdbref,'REMOVE')
                  if (!spectype[1]) then
                    !stru = true
-- The !master variable contains the name of the the new MASTER Support, which is to be made FIRST
-- in the LIST at the end of this function.
                    !master = !currdbref.namn
                    break
                  else
                    !stru = false
                    skip
                  endif
                enddo
                if (!stru.not()) then
                  !!alert.error('Unable to REMOVE the Selected Support, as ALL of the remaining Supports in the list are either HVAC or RACKING Supports, which may NOT be the MASTER for a $!<xsupptyp>')
                  return
                endif
              endif
            endif
------------------------------------
          endif
        endif

-- Added code - 16june1998 -wd - END
------------------------------------





-- Enhance All Support Members Remaining in Special Framework Support Type
        unenhance all
        !removesupp   = array()
        !supportsleft = array()
        do !col index !form.specialmem
          if (!form.specialmem[!col].namn.match(!form.list.selection('dtext')).eq(1)) then

-- Put all REMOVED References into an array
            !removesupp.append(!form.specialmem[!col])

          endif
        enddo
-- Remove all References to Support being REMOVED from List
        !supportsleft    = !form.specialmem.difference(!removesupp)
        !form.specialmem = !supportsleft
        !dtext.remove(!form.list.val)
        !dtext.unique()

------------------------------------
-- Added code - 16june1998 - wd -

-- Ensure the new MASTER support is set correctly in the List gadget, ie. FIRST in the List
-- ReOrder the LIST Gadget if required, (ie: !master has an associated structure or is a 'MDS' or a 'SPECIAL' Support).
        if (!stru) then
          !xnum = !dtext.findfirst(!master)
          !dtext.remove(!xnum)
          !dtext.insert(1,!master)
        endif

-- Added code - 16june1998 - wd - END
------------------------------------

-- Reset Display List of Support Names
        !form.list.dtext = !dtext
        !form.specialmem.unique()
-- Reset Master Support to the First in the List
        if (!form.list.dtext.empty().not()) then
          !form.tmaster.val = '  ' & !form.list.dtext[1]
        endif
-- Enhance Remaining SPECIAL Support References
--xxx        !!kenhancelist(!form.specialmem)
      else
-- Empty Gadget
        !form.supportmem.clear()
        !form.specialmem.clear()
        !form.tmaster.val = ''
        unenhance all
      endif
    endif

--------------------------------------------------------------------------------

-- Set Support Master if Only One Support in the List
    if (!form.list.dtext.size().eq(1)) then
      !form.tmaster.val = '  ' & !form.list.dtext[1]
    elseif (!form.list.dtext.empty()) then
      !form.tmaster.val = ''
    endif

  endfunction
-- End function

-- End of file Mdsspllist.pml
