--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:	        Thursday 23rd April 1998
--
--
-- Description:
-- Function to Select a Master Existing Standard Support
-- from the selected list to Create a Special
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
--
-- Return:
--    [Data Type]   [Description]
--
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdssplmaster()

--------------------------------------------------------------------------------

-- Check if List is Empty
    if (!!Mdssplframe.list.dtext.empty()) then
      !!alert.error('Nothing in List to Select')
      return
    endif

-- Initialise Variables
    !form   = !!Mdssplframe
    !dtext  = !form.list.dtext
    !master = !form.list.selection('dtext')
    !string = '/' & !master
    !dbref  = !string.dbref()

-- Check that Selected Support has an Associated Structure
    if (!dbref.type.neq('STRU')) then
      !!alert.error('The Selected Support MUST have an Associated Structure to become the MASTER Support')
      return
    endif

-- Check that Selected Support is a 'MDS' or 'SPECIAL' Support Type for 'MULTI' SPECIAL Support ONLY
    !xsupptyp = !!Mdsnamespl.type.selection('dtext').upcase()
    !spectype = !!Mdsspltype(!!Mdsnamespl.type.selection('rtext'), !dbref, 'MASTER')
--xxxq var !spectype
    if (!spectype[1].not()) then
      !!alert.error('The Selected Support is a $!spectype[2] Support and may NOT be the MASTER for a SPECIAL $!xsupptyp')
      return
    endif
--------------------------------------------------------------------------------

-- Get All Attas Associated with a SUPPORT Framework
    !data1 = !!kcollectallfor('ATTA', '(matchwild(name,|/$!<master>/*|))', =0/0)
    !data2 = !!kcollectallfor('ATTA', '(matchwild(name,|/$!<master>.*|))', =0/0)

-- Put all associated attas into a Single array
    !data = array()
    !data.appendarray(!data1)
    !data.appendarray(!data2)

-- Enhance Intendedi MASTER Support in RED
    unenhance all for $!dbref
    enhance all for $!dbref col 2
    do !val values !data
      !!ce = !val
      unenhance ce
      enhance ce col 2
    enddo

-- Ask User if Sure to Set Master Support as Selected and Highlighted in RED
    if (!!alert.confirm('Are you sure you want to make the Support highlighted in RED, the MASTER Support?') eq 'NO') then
      golabel /ENHANCE
    endif
--------------------------------------------------------------------------------

-- Set Selected Existing Standard Support as The MASTER Support
-- Put it First in The Selected List
    !dtext.insert(1,!master)
    !dtext.unique()
    !form.list.dtext = !dtext

-- Set Master Support Text
    !form.tmaster.val = '  ' & !master

--------------------------------------------------------------------------------

-- Re Enhance All Supports in the Selected List to the Default Highlight colour
    label /ENHANCE

    !!kenhancelist(!form.specialmem)

--------------------------------------------------------------------------------

  endfunction
-- End function

-- End of file Mdssplmaster.pml
