--
-- File:		Mdssplreset.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 22nd April 1998
--
--
-- Description:
-- Reset Structural data for all Existing STANDARD Framework Types to be
-- included into the SPECIAL Support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R         ARRAY       An array containing ONLY Structure Elements
--     2      R         ARRAY       An array containing Arrays ONLY of Framework Member Elements
--     3      R         ARRAY       An array containing Arrays ONLY of SubStructure Elements
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--
--
--
--   ************** READ THIS ************** READ THIS ************** READ THIS ************** READ THIS
--
--
--  The ability to RESET a SPECIAL back to the ORIGINAL Structures etc. is NOT yet Available.
--  This Function Stores all the DATA  required to RESET etc. but is NOT 100% COMPLETE eg:
--  Still NEED to write a function to RE-INCLUDE STRU MEMBERS to their ORIGINAL STRUCTURES and RENAME ATTA'a
--  back to their ORIGINAL Names etc.  - This HAS NOT Been DONE Yet
--
--
--   ************** READ THIS ************** READ THIS ************** READ THIS ************** READ THIS
--
--
--
--
-- Define Function
  define function !!Mdssplreset(!suppstru is ARRAY, !suppfrmem is ARRAY, !subs is ARRAY)

-- Initialise variables
    !!Mdssplframe.reset.clear()

--  Reset all of the Standard Structures Dbref, Position and Ori wrt World
    do !stnum index !suppstru
      !!ce = !suppstru[!stnum]
      !!Mdssplframe.reset.append(|$!suppstru[$!stnum]|)
      !ori = ori wrt /*
      !!Mdssplframe.reset.append(|ori $!ori|)
      !stp = pos wrt /*
      !!Mdssplframe.reset.append(|at $!stp|)
    enddo

-- Reset Framework Members Positions and Directions wrt World
    do !xfmem indices !suppfrmem
      do !frmem values !suppfrmem[!xfmem]
        !!ce  = !frmem
        !poss = poss wrt /*
          handle ANY
            skip
          endhandle
        !drns = drns wrt /*
        !pose = pose wrt /*
        !drne = drne wrt /*
        !bang = bang wrt /*
        !spre = spref
        !!Mdssplframe.reset.append(|$!frmem|)
        !!Mdssplframe.reset.append(|poss $!poss|)
        !!Mdssplframe.reset.append(|drns $!drns|)
        !!Mdssplframe.reset.append(|pose $!pose|)
        !!Mdssplframe.reset.append(|drne $!drne|)
        !!Mdssplframe.reset.append(|bang $!bang|)
        !!Mdssplframe.reset.append(|spre $!spre|)
      enddo
    enddo

-- Reset SubStructures Position and Ori wrt World
    do !xsmem indices !subs
      do !suppsubs values !subs[!xsmem]
        !!ce  = !suppsubs
        !spos = pos wrt /*
        !sori = ori wrt /*
        !!Mdssplframe.reset.append(|$!suppsubs|)
        !!Mdssplframe.reset.append(|at  $!spos|)
        !!Mdssplframe.reset.append(|ori $!sori|)
      enddo
    enddo

  endfunction
-- End function

-- End of file Mdssplreset.pml
