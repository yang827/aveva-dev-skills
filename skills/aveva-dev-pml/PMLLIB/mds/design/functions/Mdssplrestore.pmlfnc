--
-- File:		Mdssplrestore.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:	        Wayne Dodwell
-- Created:		Wednesday 28th April 1998
--
--
-- Description:
-- Restore SPECIAL Support SUBS and SCTNS to their ORIGINAL Positions and
-- Orientations etc. when they were members of MDS Standard Framework Types.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          form       Special Support Form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdssplrestore(!form is form)

-- Find current units and set the distance unit to metric
    !currentunits = !!kgetsetunits()

--------------------------------------------------------------------------------
-- Initialise existing variables before regenerating data
    !support = !form.support
    !actions = !form.store

--------------------------------------------------------------------------------
-- Navigate to SPECIAL Structure
    !!ce = !support.stru

-- Loop through actions to do
    do !I indices !actions
      $!actions[$!I]
    enddo

--------------------------------------------------------------------------------
-- Reset Units
    !!kRestoreUnits(!currentunits)

--------------------------------------------------------------------------------
-- Navigate to SPECIAL Structure
    !!ce = !support.stru

  endfunction
-- End function

-- End of file Mdssplrestore.pml
