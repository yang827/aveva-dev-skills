--
-- File:		Mdssplsctnori.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 17th June 1998
--
--
-- Description:
-- Clears all Arrays in the passed form
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        DBREF         Database reference of SCTN
--     1      R        ORIENTATION   Orientation object of SCTN in Original Structure
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdssplsctnori(!sctn is DBREF, !ORIG is ORIENTATION)

--------------------------------------------------------------------------------
-- Navigate to SCTN
    !!ce = !sctn

-- Initialise Variables
    !newori  = ori wrt /*
    !oldori  = !orig
    !oldbang = bangle
    !count   = 0

-- Check if SCTN New Ori is same as the SCTN Original Ori WRT World
    if (!newori eq !oldori) then
-- NO Action Required as the SCTN is CORRECTLY Orientated.
      return
    endif

    do !index from -180 by 90 to 180
      bangle $!index
      !testori = ori wrt /*
      if (!testori eq !oldori) then
-- SCTN Test Ori is same as the SCTN Original Ori WRT World
-- No Other Action required
        break
      else
        !count = !count + 1
        if (!count eq 5) then
-- Return SCTN ori back to !oldori ie. Original Bangle Attibute Value
          bangle $!oldbang
          break
        else
          skip
        endif
      endif
    enddo

  endfunction
-- End function

-- End of file Mdssplsctnori.pml
