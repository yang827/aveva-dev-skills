--
-- File:		Mdssplstrumem.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 22nd April 1998
--
--
-- Description:
-- Store Structural data for all Existing STANDARD Framework Types to be
-- included into the SPECIAL Support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R         ARRAY       An array containing Arrays ONLY of Framework Member Elements
--     2      R         ARRAY       An array containing Arrays ONLY of SubStructure Elements
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdssplstrumem(!suppfrmem is ARRAY, !subs is ARRAY)

-- Initialise variables
    !!Mdssplframe.store.clear()

--------------------------------------------------------------------------------

-- Store Framework Sections - Positions, Directions and Orientations wrt World
    !numb = 0
    do !xfmem indices !suppfrmem
      do !frmem values !suppfrmem[!xfmem]
        !numb = !numb + 1
        !!ce  = !frmem
        if !!ce.type.eq('SCTN') then
          !poss = poss wrt /*
          !drns = drns wrt /*
          !pose = pose wrt /*
          !drne = drne wrt /*
          !bang = bang wrt /*
          !oris = ori wrt /*
          !!Mdssplframe.sctnori[$!numb] = !oris
          !spre = spref
          !!Mdssplframe.store.append(|$!frmem|)
          !!Mdssplframe.store.append(|poss $!poss|)
          !!Mdssplframe.store.append(|drns $!drns|)
          !!Mdssplframe.store.append(|pose $!pose|)
          !!Mdssplframe.store.append(|drne $!drne|)
          !!Mdssplframe.store.append(|bang $!bang|)
          !!Mdssplframe.store.append(|spre $!spre|)
          !!Mdssplframe.store.append(|!!Mdssplsctnori($!frmem,!!Mdssplframe.sctnori[$!numb])|)
        elseif !!CE.type.eq('PNOD') then
          !pos = pos wrt /*
          !!Mdssplframe.store.append(|$!frmem|)
          !!Mdssplframe.store.append(|pos $!pos|)
        else
        endif

      enddo
    enddo

-- Store SubStructures Position and Ori wrt World
    do !xsmem indices !subs
      do !suppsubs values !subs[!xsmem]
        !!ce   = !suppsubs
        !spos  = pos wrt /*
        !sori  = ori wrt /*
--        !orstg = !!Mdswrtori(!sori)
        !!Mdssplframe.store.append(|$!suppsubs|)
        !!Mdssplframe.store.append(|at  $!spos|)
        !!Mdssplframe.store.append(|ori $!sori|)
--        !!Mdssplframe.store.append(|ori $!orstg|)
      enddo
    enddo

  endfunction
-- End function

-- End of file Mdssplstrumem.pml
