--
-- File:		Mdsspltype.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Friday 19th June 1998
--
--
-- Description:
-- Checks if Selected Support is of an Allowable Type for the SPECIAL Support Type.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        STRING        Type of SPECIAL Support Required
--     2      R        DBREF         Database Reference of Selected Support
--     3      R        STRING        INCLUDE - if Selecting a Support, TEST if Support is Allowed
--                            or     REMOVE  - if Removing from the Support List
--                            or     MASTER  - if Selecting a Support to be the MASTER from the Support List
--
--
-- Return:
--    [Data Type]   [Description]
--      ARRAY       [1] - TRUE or FALSE if Selected Support is allowable.
--                  [2] - Generic type of Selected Support (eg: 'HVAC', 'RACKING')
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsspltype(!string is STRING, !dbref is DBREF, !test is STRING) is ARRAY

--------------------------------------------------------------------------------

-- Initialise Variables
    !formname = !!Mdsnamespl
    !formspec = !!Mdssplframe
    !supptype = !dbref.:MDSSuppType
    !array    = array()
    !select   = !test

    if (!supptype inset ('DT01','DT02','DT03','DT04')) then
      !type = 'NONPIPE'
      !array[2] = 'HVAC'
    elseif (!supptype inset ('CT01','CT02','CT03','CT04','CT05','CT06','CT07','CT08')) then
      !type = 'NONPIPE'
      !array[2] = 'RACKING'

--<wd>aug2006 --- FRAMATOME ONLY RACKING/TRAY SUPPORTS
    elseif (!supptype.matchwild('FR*')) then
-- FRAMATOME RACKING SUPPORTS
      !type = 'NONPIPE'
      !array[2] = 'RACKING'
--<wd>aug2006 --- FRAMATOME ONLY RACKING/TRAY SUPPORTS

    elseif (!supptype.eq('SPECIAL')) then
      !type = 'SPECIAL'
      !array[2] = 'SPECIAL'
    else
      !type = 'MULTI'
      !array[2] = 'MULTI DISCIPLINE SUPPORT '
    endif

--------------------------------------------------------------------------------

    if (!select.upcase().eq('INCLUDE')) then
-- Check if Selected Support is Allowable for Inclusion to the SPECIAL Support
-- Multi Discipline Special Support Required
      if (!string.eq('MULTI')) then
        if (!formspec.list.dtext.empty()) then
-- Check if 1st in List, Support type is NOT an 'HVAC' or 'RACKING' Support, as NEITHER may be the MASTER Support for a MDS Special
          if (!type inset ('NONPIPE')) then
            !array[1] = false
            return !array
          else
            !array[1] = true
            return !array
          endif
        else
          !array[1] = true
          return !array
        endif
-- Hvac Special Support Required
      elseif (!string.eq('HVAC')) then
        if (!type inset ('NONPIPE','SPECIAL')) then
          !array[1] = true
          return !array
        else
          !array[1] = false
          return !array
        endif
-- Racking Special Support Required
      elseif (!string.eq('RACK')) then
        if (!type inset ('NONPIPE','SPECIAL')) then
          !array[1] = true
          return !array
        else
          !array[1] = false
          return !array
        endif
      endif

    elseif (!select.upcase().eq('REMOVE')  or !select.upcase().eq('MASTER')) then
--------------------------------------------------------------------------------
-- Check if Selected Support for REMOVAL
-- Multi Discipline Special Support Required
      if (!string.eq('MULTI')) then
        if (!type inset ('NONPIPE')) then
          !array[1] = false
          return !array
        else
          !array[1] = true
          return !array
        endif
-- Hvac Special Support Required
      elseif (!string.eq('HVAC')) then
        if (!type inset ('NONPIPE','SPECIAL')) then
          !array[1] = true
          return !array
        else
          !array[1] = false
          return !array
        endif
-- Racking Special Support Required
      elseif (!string.eq('RACK')) then
        if (!type inset ('NONPIPE','SPECIAL')) then
          !array[1] = true
          return !array
        else
          !array[1] = false
          return !array
        endif
      endif
    endif

--------------------------------------------------------------------------------

  endfunction
-- End function

-- End of file Mdsspltype.pml
