-- Define Function
define function !!Mdsstartvendor()

if !!ce.type.neq('HANG') then
  HANG
  handle any
    !!alert.error('You Must Be at a Hanger or Hanger Member' )
    return
  endhandle
endif

show !!mdsvendor

