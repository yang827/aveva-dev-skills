--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsstoreFT50()

-- Initialise variables
    !!MdsFT50.store.clear()
-- Required option gadgets
    -- !size  = !!MdsFT50.Size.selection()
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

-- Store original atta despars, orientation
    !!MdssaveattaInf(!!MdsFT50)

----------------------------------------------------------------------------
-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--    !!Mdssavepacks(!!MdsFT50)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!MdsFT50.store.append(|!!MdsFT50.dist.val = $!!MdsFT50.dist.val|)
    !!MdsFT50.store.append(|call !!Mdsposdist(!!MdsFT50)|)
    -- !!MdsFT50.store.append(|!!MdsFT50.Size.select('RTEXT', '$!Size')|)
    !!MdsFT50.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFT50.store.append(|!!MdsFT50.Dim1.val = $!!MdsFT50.Dim1.val|)

-- Store support object
    !!MdsFT50.backup = !!MdsFT50.support

-- Navigate back to structure store Stru Dbref and Ori
    !!ce = !!MdsFT50.support.stru
    !!MdsFT50.store.append(|$!!MdsFT50.support.stru|)
    !ori = ori wrt /*
    !!MdsFT50.store.append(|ori $!ori|)
    !stp = pos wrt /*
    !!MdsFT50.store.append(|at $!stp|)

  endfunction
-- End function

-- End of file MdsstoreFT50.pml
