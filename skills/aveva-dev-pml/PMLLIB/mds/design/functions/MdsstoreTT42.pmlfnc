-- Define Function
  define function !!mdsstoreTT42()

-- Initialise variables
    !!mdsTT42.store.clear()

-- Store original atta despars, orientation
    !!mdssaveattainf(!!mdsTT42)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!mdssavepacks(!!mdsTT42)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!mdsTT42.store.append(|!!mdsTT42.dist.val = $!!mdsTT42.dist.val|)
    !!mdsTT42.store.append(|call !!mdsposdonly(!!mdsTT42)|)
    !!mdsTT42.store.append(|!!mdsTT42.length.val = $!!mdsTT42.length.val|)
    !!mdsTT42.store.append(|!!mdsTT42.plate.val = $!!mdsTT42.plate.val|)
    !!mdsTT42.store.append(|!!mdsTT42.clear.val = $!!mdsTT42.clear.val|)
    !!mdsTT42.store.append(|!!mdsTT42.material.select('rtext','$!!mdsTT42.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!mdsTT42.store.append(|!!mdsSetTrnMatl(!!GlobalForm,!!mdsTT42.support.datum)|)
    !!mdsTT42.store.append(|!!mdsSetTrnMatl(!!mdsTT42,!!mdsTT42.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!mdsTT42.backup = !!mdsTT42.support

  endfunction
-- End function
