-- Define Function
  define function !!mdsstoreTT43()

-- Initialise variables
    !!mdsTT43.store.clear()

-- Store original atta despars, orientation
    !!mdssaveattainf(!!mdsTT43)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!mdssavepacks(!!mdsTT43)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!mdsTT43.store.append(|!!mdsTT43.dist.val = $!!mdsTT43.dist.val|)
    !!mdsTT43.store.append(|call !!mdsposdonly(!!mdsTT43)|)
    !!mdsTT43.store.append(|!!mdsTT43.length.val = $!!mdsTT43.length.val|)
    !!mdsTT43.store.append(|!!mdsTT43.plate.val = $!!mdsTT43.plate.val|)
    !!mdsTT43.store.append(|!!mdsTT43.clear.val = $!!mdsTT43.clear.val|)
    !!mdsTT43.store.append(|!!mdsTT43.material.select('rtext','$!!mdsTT43.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!mdsTT43.store.append(|!!mdsSetTrnMatl(!!GlobalForm,!!mdsTT43.support.datum)|)
    !!mdsTT43.store.append(|!!mdsSetTrnMatl(!!mdsTT43,!!mdsTT43.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!mdsTT43.backup = !!mdsTT43.support

  endfunction
-- End function
