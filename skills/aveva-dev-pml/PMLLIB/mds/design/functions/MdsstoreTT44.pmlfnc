-- Define Function
  define function !!mdsstoreTT44()

-- Initialise variables
    !!mdsTT44.store.clear()

-- Store original atta despars, orientation
    !!mdssaveattainf(!!mdsTT44)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!mdssavepacks(!!mdsTT44)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!mdsTT44.store.append(|!!mdsTT44.dist.val = $!!mdsTT44.dist.val|)
    !!mdsTT44.store.append(|call !!mdsposdonly(!!mdsTT44)|)
    !!mdsTT44.store.append(|!!mdsTT44.length.val = $!!mdsTT44.length.val|)
    !!mdsTT44.store.append(|!!mdsTT44.plate.val = $!!mdsTT44.plate.val|)
    !!mdsTT44.store.append(|!!mdsTT44.clear.val = $!!mdsTT44.clear.val|)
    !!mdsTT44.store.append(|!!mdsTT44.material.select('rtext','$!!mdsTT44.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!mdsTT44.store.append(|!!mdsSetTrnMatl(!!GlobalForm,!!mdsTT44.support.datum)|)
    !!mdsTT44.store.append(|!!mdsSetTrnMatl(!!mdsTT44,!!mdsTT44.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!mdsTT44.backup = !!mdsTT44.support

  endfunction
-- End function
