--
-- File:		MdsstoreVT24.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Wed Jul 02
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreVT24()

  -- Initialise variables
    !!MdsVT24.Store.clear()
    -- Required option gadgets
    -- !Size = !!MdsVT24.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsVT24)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!MdsVT24)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!MdsVT24.Store.append(|!!MdsVT24.Dist.val = $!!MdsVT24.Dist.val|)
    !!MdsVT24.Store.append(|Call !!MdsPosDist(!!MdsVT24)|)
    !!MdsVT24.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsVT24.Store.append(|!!MdsVT24.Dim1.val = $!!MdsVT24.Dim1.val|)
    !!MdsVT24.Store.append(|!!MdsVT24.Dim2.val = $!!MdsVT24.Dim2.val|)
    !!MdsVT24.Store.append(|!!MdsVT24.Dim3.val = $!!MdsVT24.Dim3.val|)

------------------------------******* Connexions ****** --------------------
--$(
if(!!MdsVT24.Support.Joints.unset().not()) then

  !Joints = !!MdsVT24.Support.Joints
   do !Ind indices !Joints
      !Attributes = array()
      !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')

      !!MdsVT24.Store.append(|$!Joints[$!Ind].name|)
      !!MdsVT24.Store.append(|POSL $!Attributes[$!ind][1]|)
      !!MdsVT24.Store.append(|DESP $!Attributes[$!Ind][2]|)
      !!MdsVT24.Store.append(|BANG $!Attributes[$!Ind][3]|)
      !!MdsVT24.Store.append(|SPRE $!Attributes[$!ind][4]|)
      !!MdsVT24.Store.append(|JLIN $!Attributes[$!Ind][5]|)
      !!MdsVT24.Store.append(|CUTP $!Attributes[$!Ind][6]|)
      !!MdsVT24.Store.append(|CUTB $!Attributes[$!Ind][7]|)

   enddo
else
  -- !!MdsVT24.Store.append(|!!MdsSelectjoints(!!MdsVT24,'DISCONNECT','')|)
endif
--$)
------------------------------------------------------------------------

  -- Store support object
    !!MdsVT24.Backup = !!MdsVT24.Support


-- End function
endfunction

-- End of file MdsstoreVT24.pml
