-- Define Function
define function !!MdsStorean500()

  -- Initialise variables
    !!Mdsan500.Store.clear()

  -- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdsan500)

  -- Store relavent gadget information
    !!Mdsan500.Store.append(|!!Mdsan500.Dist.val = $!!Mdsan500.Dist.val|)
    !!Mdsan500.Store.append(|Call !!MdsPosDist(!!Mdsan500)|)

  -- Store support object
    !!Mdsan500.Backup = !!Mdsan500.Support

-- End function
endfunction

-- End of file Mdsstorean500.pmlfnc
