--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreat29()

  -- Initialise variables
    !!Mdsat29.Store.clear()

  -- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdsat29)

  -- Store relavent gadget information
    !!Mdsat29.Store.append(|!!Mdsat29.Dist.val = $!!Mdsat29.Dist.val|)
    !!Mdsat29.Store.append(|Call !!MdsPosDist(!!Mdsat29)|)

  -- Store support object
    !!Mdsat29.Backup = !!Mdsat29.Support

-- End function
endfunction

