-- Define Function
define function !!MdsStoreat500()

-- Initialise variables
  !!Mdsat500.Store.clear()

-- Store original atta despars, orientation
  !!Mdssaveattainf(!!Mdsat500)

-- Store relavent gadget information
  !!Mdsat500.Store.append(|!!Mdsat500.Dist.val = $!!Mdsat500.Dist.val|)
  !!Mdsat500.Store.append(|Call !!MdsPosDist(!!Mdsat500)|)

-- Store support object
  !!Mdsat500.Backup = !!Mdsat500.Support

-- End function
endfunction

-- End of file Mdsstoreat500.pml
