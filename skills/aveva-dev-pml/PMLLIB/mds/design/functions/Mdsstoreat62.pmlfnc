-- Define Function
define function !!MdsStoreAT62()

  -- Initialise variables
    !!MdsAT62.Store.clear()

  -- Store original atta despars, orientation
    !!Mdssaveattainf(!!MdsAT62)

  -- Store relavent gadget information
    !!MdsAT62.Store.append(|!!MdsAT62.Dist.val = $!!MdsAT62.Dist.val|)
    !!MdsAT62.Store.append(|Call !!MdsPosDist(!!MdsAT62)|)

  -- Store support object
    !!MdsAT62.Backup = !!MdsAT62.Support

-- End function
endfunction

