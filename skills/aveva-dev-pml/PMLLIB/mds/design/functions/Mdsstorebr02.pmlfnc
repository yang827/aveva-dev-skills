-- Define Function
define function !!MdsStoreBr02()

  -- Initialise variables
    !!MdsBr02.Store.clear()

  -- Store original atta despars, orientation
    !!Mdssaveattainf(!!MdsBr02)

  -- Store relavent gadget information
    !!MdsBr02.Store.append(|!!MdsBr02.Dist.val = $!!MdsBr02.Dist.val|)
    !!MdsBr02.Store.append(|Call !!MdsPosDist(!!MdsBr02)|)

  -- Store support object
    !!MdsBr02.Backup = !!MdsBr02.Support

-- End function
endfunction

