-- Define Function
define function !!MdsStorebr03()

  -- Initialise variables
    !!Mdsbr03.Store.clear()

  -- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdsbr03)

  -- Store relavent gadget information
    !!Mdsbr03.Store.append(|!!Mdsbr03.Dist.val = $!!Mdsbr03.Dist.val|)
    !!Mdsbr03.Store.append(|Call !!MdsPosDist(!!Mdsbr03)|)

  -- Store support object
    !!Mdsbr03.Backup = !!Mdsbr03.Support

-- End function
endfunction

