-- Define Function
define function !!MdsStoreBr04()

  -- Initialise variables
    !!MdsBr04.Store.clear()

  -- Store original atta despars, orientation
    !!Mdssaveattainf(!!MdsBr04)

  -- Store relavent gadget information
    !!MdsBr04.Store.append(|!!MdsBr04.Dist.val = $!!MdsBr04.Dist.val|)
    !!MdsBr04.Store.append(|Call !!MdsPosDist(!!MdsBr04)|)

  -- Store support object
    !!MdsBr04.Backup = !!MdsBr04.Support

-- End function
endfunction

