--
-- Description: Dun979-As for type Br05 but 2 stiffeners only.
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsStoreBr08()

  -- Initialise variables
    !!mdsBr08.store.clear()

  -- Store original atta despars, orientation
    !!mdssaveattainf(!!mdsBr08)

  -- Store relevant gadget information
    !!mdsBr08.store.append(|!!mdsBr08.dist.val = $!!mdsBr08.dist.val|)
    !!mdsBr08.store.append(|Call !!mdsPosDist(!!mdsBr08)|)

  -- Store support object
    !!mdsBr08.backup = !!mdsBr08.support

-- End function
endfunction
