--
-- Description: Dun979-As for type Br06 but 2 stiffeners only.
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsStoreBr09()

  -- Initialise variables
    !!mdsBr09.store.clear()

  -- Store original atta despars, orientation
    !!mdssaveattainf(!!mdsBr09)

  -- Store relevant gadget information
    !!mdsBr09.store.append(|!!mdsBr09.dist.val = $!!mdsBr09.dist.val|)
    !!mdsBr09.store.append(|Call !!mdsPosDist(!!mdsBr09)|)

  -- Store support object
    !!mdsBr09.backup = !!mdsBr09.support

-- End function
endfunction
