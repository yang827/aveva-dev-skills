--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreCa01()

  -- Initialise variables
    !!MdsCa01.Store.clear()

  -- Store original atta despars, orientation
    !!Mdssaveattainf(!!MdsCa01)

  -- Store relavent gadget information
    !!MdsCa01.Store.append(|!!MdsCa01.Dist.val = $!!MdsCa01.Dist.val|)
    !!MdsCa01.Store.append(|Call !!MdsPosDist(!!MdsCa01)|)

  -- Store support object
    !!MdsCa01.Backup = !!MdsCa01.Support

-- End function
endfunction

-- End of file MdsstoreCa01.pml
