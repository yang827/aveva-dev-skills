-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStorefh01()

  -- Initialise variables
    !!Mdsfh01.Store.clear()

  -- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdsfh01)

  -- Store relevant gadget information
    !!Mdsfh01.Store.append(|!!Mdsfh01.Dist.val = $!!Mdsfh01.Dist.val|)
    !!Mdsfh01.Store.append(|Call !!MdsPosDist(!!Mdsfh01)|)

  -- Store support object
    !!Mdsfh01.Backup = !!Mdsfh01.Support

-- End function
endfunction

-- End of file Mdsstorefh01.pml
