--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFR06()

  -- Initialise variables
    !!MdsFR06.Store.clear()
    -- Required option gadgets
    -- !Size = !!MdsFR06.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFR06)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!MdsFR06)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!MdsFR06.Store.append(|!!MdsFR06.Dist.val = $!!MdsFR06.Dist.val|)
    !!MdsFR06.Store.append(|Call !!MdsPosDist(!!MdsFR06)|)
    -- !!MdsFR06.Store.append(|!!MdsFR06.Size.select('RTEXT', '$!Size')|)
    !!MdsFR06.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFR06.Store.append(|!!MdsFR06.Dim1.val = $!!MdsFR06.Dim1.val|)
    !!MdsFR06.Store.append(|!!MdsFR06.Dim2.val = $!!MdsFR06.Dim2.val|)

------------------------------******* Connexions ****** --------------------
--$(
    if(!!MdsFR06.Support.Joints.unset().not()) then
      !Joints = !!MdsFR06.Support.Joints
      do !Ind indices !Joints
        !Attributes = array()
        !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
        !!MdsFR06.Store.append(|$!Joints[$!Ind].name|)
        !!MdsFR06.Store.append(|POSL $!Attributes[$!ind][1]|)
        !!MdsFR06.Store.append(|DESP $!Attributes[$!Ind][2]|)
        !!MdsFR06.Store.append(|BANG $!Attributes[$!Ind][3]|)
        !!MdsFR06.Store.append(|SPRE $!Attributes[$!ind][4]|)
        !!MdsFR06.Store.append(|JLIN $!Attributes[$!Ind][5]|)
        !!MdsFR06.Store.append(|CUTP $!Attributes[$!Ind][6]|)
        !!MdsFR06.Store.append(|CUTB $!Attributes[$!Ind][7]|)
     enddo
   else
     !!MdsFR06.Store.append(|!!MdsSelectjoints(!!MdsFR06,'IGNORE','')|)
   endif
--$)
------------------------------------------------------------------------

  -- Store support object
    !!MdsFR06.Backup = !!MdsFR06.Support

-- End function
endfunction

-- End of file MdsstoreFR06.pml
