--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFR07()

  -- Initialise variables
    !!MdsFR07.Store.clear()
    -- Required option gadgets
    -- !Size = !!MdsFR07.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFR07)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!MdsFR07)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!MdsFR07.Store.append(|!!MdsFR07.Dist.val = $!!MdsFR07.Dist.val|)
    !!MdsFR07.Store.append(|Call !!MdsPosDist(!!MdsFR07)|)
    -- !!MdsFR07.Store.append(|!!MdsFR07.Size.select('RTEXT', '$!Size')|)
    !!MdsFR07.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFR07.Store.append(|!!MdsFR07.Dim1.val = $!!MdsFR07.Dim1.val|)
    !!MdsFR07.Store.append(|!!MdsFR07.Dim2.val = $!!MdsFR07.Dim2.val|)

------------------------------******* Connexions ****** --------------------
--$(
    if(!!MdsFR07.Support.Joints.unset().not()) then
      !Joints = !!MdsFR07.Support.Joints
      do !Ind indices !Joints
        !Attributes = array()
        !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
        !!MdsFR07.Store.append(|$!Joints[$!Ind].name|)
        !!MdsFR07.Store.append(|POSL $!Attributes[$!ind][1]|)
        !!MdsFR07.Store.append(|DESP $!Attributes[$!Ind][2]|)
        !!MdsFR07.Store.append(|BANG $!Attributes[$!Ind][3]|)
        !!MdsFR07.Store.append(|SPRE $!Attributes[$!ind][4]|)
        !!MdsFR07.Store.append(|JLIN $!Attributes[$!Ind][5]|)
        !!MdsFR07.Store.append(|CUTP $!Attributes[$!Ind][6]|)
        !!MdsFR07.Store.append(|CUTB $!Attributes[$!Ind][7]|)
     enddo
   else
     !!MdsFR07.Store.append(|!!MdsSelectjoints(!!MdsFR07,'IGNORE','')|)
   endif
--$)
------------------------------------------------------------------------

  -- Store support object
    !!MdsFR07.Backup = !!MdsFR07.Support

-- End function
endfunction

-- End of file MdsstoreFR07.pml
