--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFR08()

  -- Initialise variables
    !!MdsFR08.Store.clear()
    -- Required option gadgets
    -- !Size = !!MdsFR08.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFR08)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!MdsFR08)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!MdsFR08.Store.append(|!!MdsFR08.Dist.val = $!!MdsFR08.Dist.val|)
    !!MdsFR08.Store.append(|Call !!MdsPosDist(!!MdsFR08)|)
    -- !!MdsFR08.Store.append(|!!MdsFR08.Size.select('RTEXT', '$!Size')|)
    !!MdsFR08.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFR08.Store.append(|!!MdsFR08.Dim1.val = $!!MdsFR08.Dim1.val|)
    !!MdsFR08.Store.append(|!!MdsFR08.Dim2.val = $!!MdsFR08.Dim2.val|)

------------------------------******* Connexions ****** --------------------
--$(
    if(!!MdsFR08.Support.Joints.unset().not()) then
      !Joints = !!MdsFR08.Support.Joints
      do !Ind indices !Joints
        !Attributes = array()
        !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
        !!MdsFR08.Store.append(|$!Joints[$!Ind].name|)
        !!MdsFR08.Store.append(|POSL $!Attributes[$!ind][1]|)
        !!MdsFR08.Store.append(|DESP $!Attributes[$!Ind][2]|)
        !!MdsFR08.Store.append(|BANG $!Attributes[$!Ind][3]|)
        !!MdsFR08.Store.append(|SPRE $!Attributes[$!ind][4]|)
        !!MdsFR08.Store.append(|JLIN $!Attributes[$!Ind][5]|)
        !!MdsFR08.Store.append(|CUTP $!Attributes[$!Ind][6]|)
        !!MdsFR08.Store.append(|CUTB $!Attributes[$!Ind][7]|)
     enddo
   else
     !!MdsFR08.Store.append(|!!MdsSelectjoints(!!MdsFR08,'IGNORE','')|)
   endif
--$)
------------------------------------------------------------------------

  -- Store support object
    !!MdsFR08.Backup = !!MdsFR08.Support

-- End function
endfunction

-- End of file MdsstoreFR08.pml
