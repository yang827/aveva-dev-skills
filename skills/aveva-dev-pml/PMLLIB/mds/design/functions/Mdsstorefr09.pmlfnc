--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFR09()

  -- Initialise variables
    !!MdsFR09.Store.clear()
    -- Required option gadgets
    -- !Size = !!MdsFR09.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFR09)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!MdsFR09)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!MdsFR09.Store.append(|!!MdsFR09.Dist.val = $!!MdsFR09.Dist.val|)
    !!MdsFR09.Store.append(|Call !!MdsPosDist(!!MdsFR09)|)
    -- !!MdsFR09.Store.append(|!!MdsFR09.Size.select('RTEXT', '$!Size')|)
    !!MdsFR09.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFR09.Store.append(|!!MdsFR09.Dim1.val = $!!MdsFR09.Dim1.val|)
    !!MdsFR09.Store.append(|!!MdsFR09.Dim2.val = $!!MdsFR09.Dim2.val|)
    !!MdsFR09.Store.append(|!!MdsFR09.Dim3.val = $!!MdsFR09.Dim3.val|)

------------------------------******* Connexions ****** --------------------
--$(
    if(!!MdsFR09.Support.Joints.unset().not()) then
      !Joints = !!MdsFR09.Support.Joints
      do !Ind indices !Joints
        !Attributes = array()
        !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
        !!MdsFR09.Store.append(|$!Joints[$!Ind].name|)
        !!MdsFR09.Store.append(|POSL $!Attributes[$!ind][1]|)
        !!MdsFR09.Store.append(|DESP $!Attributes[$!Ind][2]|)
        !!MdsFR09.Store.append(|BANG $!Attributes[$!Ind][3]|)
        !!MdsFR09.Store.append(|SPRE $!Attributes[$!ind][4]|)
        !!MdsFR09.Store.append(|JLIN $!Attributes[$!Ind][5]|)
        !!MdsFR09.Store.append(|CUTP $!Attributes[$!Ind][6]|)
        !!MdsFR09.Store.append(|CUTB $!Attributes[$!Ind][7]|)
     enddo
   else
     !!MdsFR09.Store.append(|!!MdsSelectjoints(!!MdsFR09,'IGNORE','')|)
   endif
--$)
------------------------------------------------------------------------

  -- Store support object
    !!MdsFR09.Backup = !!MdsFR09.Support

-- End function
endfunction

-- End of file MdsstoreFR09.pml
