--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFR10()

  -- Initialise variables
    !!MdsFR10.Store.clear()
    -- Required option gadgets
    -- !Size = !!MdsFR10.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFR10)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!MdsFR10)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!MdsFR10.Store.append(|!!MdsFR10.Dist.val = $!!MdsFR10.Dist.val|)
    !!MdsFR10.Store.append(|Call !!MdsPosDist(!!MdsFR10)|)
    -- !!MdsFR10.Store.append(|!!MdsFR10.Size.select('RTEXT', '$!Size')|)
    !!MdsFR10.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim1.val =  $!!MdsFR10.Dim1.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim2.val =  $!!MdsFR10.Dim2.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim3.val =  $!!MdsFR10.Dim3.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim4.val =  $!!MdsFR10.Dim4.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim5.val =  $!!MdsFR10.Dim5.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim6.val =  $!!MdsFR10.Dim6.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim7.val =  $!!MdsFR10.Dim7.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim8.val =  $!!MdsFR10.Dim8.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim9.val =  $!!MdsFR10.Dim9.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim10.val = $!!MdsFR10.Dim10.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim11.val = $!!MdsFR10.Dim11.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim12.val = $!!MdsFR10.Dim12.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim13.val = $!!MdsFR10.Dim13.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim14.val = $!!MdsFR10.Dim14.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim15.val = $!!MdsFR10.Dim15.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim16.val = $!!MdsFR10.Dim16.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim17.val = $!!MdsFR10.Dim17.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim18.val = $!!MdsFR10.Dim18.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim19.val = $!!MdsFR10.Dim19.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.Dim20.val = $!!MdsFR10.Dim20.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.bottoverlap.val = $!!MdsFR10.bottoverlap.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.topoverlap.val  = $!!MdsFR10.topoverlap.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.nposts.val      = '$!!MdsFR10.nposts.val'|)
    !!MdsFR10.Store.append(|!!MdsFR10.upoffs.val      = $!!MdsFR10.upoffs.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.lowoffs.val     = $!!MdsFR10.lowoffs.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.nbars.val       = $!!MdsFR10.nbars.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.L2.val          = $!!MdsFR10.L2.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.L3.val          = $!!MdsFR10.L3.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.postoffset.val  = $!!MdsFR10.postoffset.val|)
    !!MdsFR10.Store.append(|!!MdsFR10.sense.val       = $!!MdsFR10.sense.val|)



------------------------------******* Connexions ****** --------------------
--$(
    if(!!MdsFR10.Support.Joints.unset().not()) then
      !Joints = !!MdsFR10.Support.Joints
      do !Ind indices !Joints
        !Attributes = array()
        !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
        !!MdsFR10.Store.append(|$!Joints[$!Ind].name|)
        !!MdsFR10.Store.append(|POSL $!Attributes[$!ind][1]|)
        !!MdsFR10.Store.append(|DESP $!Attributes[$!Ind][2]|)
        !!MdsFR10.Store.append(|BANG $!Attributes[$!Ind][3]|)
        !!MdsFR10.Store.append(|SPRE $!Attributes[$!ind][4]|)
        !!MdsFR10.Store.append(|JLIN $!Attributes[$!Ind][5]|)
        !!MdsFR10.Store.append(|CUTP $!Attributes[$!Ind][6]|)
        !!MdsFR10.Store.append(|CUTB $!Attributes[$!Ind][7]|)
     enddo
   else
     !!MdsFR10.Store.append(|!!MdsSelectjoints(!!MdsFR10,'IGNORE','')|)
   endif
--$)
------------------------------------------------------------------------

  -- Store support object
    !!MdsFR10.Backup = !!MdsFR10.Support

-- End function
endfunction

-- End of file MdsstoreFR10.pml
