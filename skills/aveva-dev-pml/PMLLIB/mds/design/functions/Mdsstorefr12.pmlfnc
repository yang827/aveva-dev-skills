--
-- File:		MdsstoreFR12.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Mon Jun 23
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFR12()

  -- Initialise variables
    !!MdsFR12.Store.clear()
    -- Required option gadgets
    -- !Size = !!MdsFR12.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFR12)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!MdsFR12)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!MdsFR12.Store.append(|!!MdsFR12.Dist.val = $!!MdsFR12.Dist.val|)
    !!MdsFR12.Store.append(|Call !!MdsPosDist(!!MdsFR12)|)
    -- !!MdsFR12.Store.append(|!!MdsFR12.Size.select('RTEXT', '$!Size')|)
    !!MdsFR12.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFR12.Store.append(|!!MdsFR12.Dim1.val = $!!MdsFR12.Dim1.val|)
    !!MdsFR12.Store.append(|!!MdsFR12.Dim2.val = $!!MdsFR12.Dim2.val|)
    !!MdsFR12.Store.append(|!!MdsFR12.Dim3.val = $!!MdsFR12.Dim3.val|)

------------------------------******* Connexions ****** --------------------
--$(
    if(!!MdsFR12.Support.Joints.unset().not()) then
      !Joints = !!MdsFR12.Support.Joints
      do !Ind indices !Joints
        !Attributes = array()
        !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
        !!MdsFR12.Store.append(|$!Joints[$!Ind].name|)
        !!MdsFR12.Store.append(|POSL $!Attributes[$!ind][1]|)
        !!MdsFR12.Store.append(|DESP $!Attributes[$!Ind][2]|)
        !!MdsFR12.Store.append(|BANG $!Attributes[$!Ind][3]|)
        !!MdsFR12.Store.append(|SPRE $!Attributes[$!ind][4]|)
        !!MdsFR12.Store.append(|JLIN $!Attributes[$!Ind][5]|)
        !!MdsFR12.Store.append(|CUTP $!Attributes[$!Ind][6]|)
        !!MdsFR12.Store.append(|CUTB $!Attributes[$!Ind][7]|)
     enddo
   else
     !!MdsFR12.Store.append(|!!MdsSelectjoints(!!MdsFR12,'IGNORE','')|)
   endif
--$)
------------------------------------------------------------------------

  -- Store support object
    !!MdsFR12.Backup = !!MdsFR12.Support

-- End function
endfunction

-- End of file MdsstoreFR12.pml
