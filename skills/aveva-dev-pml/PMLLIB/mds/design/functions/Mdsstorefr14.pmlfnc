--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFR14()

  -- Initialise variables
    !!MdsFR14.Store.clear()
    -- Required option gadgets
    -- !Size = !!MdsFR14.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFR14)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!MdsFR14)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!MdsFR14.Store.append(|!!MdsFR14.Dist.val = $!!MdsFR14.Dist.val|)
    !!MdsFR14.Store.append(|Call !!MdsPosDist(!!MdsFR14)|)
    -- !!MdsFR14.Store.append(|!!MdsFR14.Size.select('RTEXT', '$!Size')|)
    !!MdsFR14.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim1.val =  $!!MdsFR14.Dim1.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim2.val =  $!!MdsFR14.Dim2.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim3.val =  $!!MdsFR14.Dim3.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim4.val =  $!!MdsFR14.Dim4.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim5.val =  $!!MdsFR14.Dim5.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim6.val =  $!!MdsFR14.Dim6.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim7.val =  $!!MdsFR14.Dim7.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim8.val =  $!!MdsFR14.Dim8.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim9.val =  $!!MdsFR14.Dim9.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim10.val = $!!MdsFR14.Dim10.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim11.val = $!!MdsFR14.Dim11.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim12.val = $!!MdsFR14.Dim12.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim13.val = $!!MdsFR14.Dim13.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim14.val = $!!MdsFR14.Dim14.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim15.val = $!!MdsFR14.Dim15.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim16.val = $!!MdsFR14.Dim16.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim17.val = $!!MdsFR14.Dim17.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim18.val = $!!MdsFR14.Dim18.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim19.val = $!!MdsFR14.Dim19.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.Dim20.val = $!!MdsFR14.Dim20.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.bottoverlap.val = $!!MdsFR14.bottoverlap.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.topoverlap.val  = $!!MdsFR14.topoverlap.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.nposts.val      = '$!!MdsFR14.nposts.val'|)
    !!MdsFR14.Store.append(|!!MdsFR14.upoffs.val      = $!!MdsFR14.upoffs.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.lowoffs.val     = $!!MdsFR14.lowoffs.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.nbars.val       = $!!MdsFR14.nbars.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.L2.val          = $!!MdsFR14.L2.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.L3.val          = $!!MdsFR14.L3.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.postoffset.val  = $!!MdsFR14.postoffset.val|)
    !!MdsFR14.Store.append(|!!MdsFR14.sense.val       = $!!MdsFR14.sense.val|)



------------------------------******* Connexions ****** --------------------
--$(
    if(!!MdsFR14.Support.Joints.unset().not()) then
      !Joints = !!MdsFR14.Support.Joints
      do !Ind indices !Joints
        !Attributes = array()
        !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
        !!MdsFR14.Store.append(|$!Joints[$!Ind].name|)
        !!MdsFR14.Store.append(|POSL $!Attributes[$!ind][1]|)
        !!MdsFR14.Store.append(|DESP $!Attributes[$!Ind][2]|)
        !!MdsFR14.Store.append(|BANG $!Attributes[$!Ind][3]|)
        !!MdsFR14.Store.append(|SPRE $!Attributes[$!ind][4]|)
        !!MdsFR14.Store.append(|JLIN $!Attributes[$!Ind][5]|)
        !!MdsFR14.Store.append(|CUTP $!Attributes[$!Ind][6]|)
        !!MdsFR14.Store.append(|CUTB $!Attributes[$!Ind][7]|)
     enddo
   else
     !!MdsFR14.Store.append(|!!MdsSelectjoints(!!MdsFR14,'IGNORE','')|)
   endif
--$)
------------------------------------------------------------------------

  -- Store support object
    !!MdsFR14.Backup = !!MdsFR14.Support

-- End function
endfunction

-- End of file MdsstoreFR14.pml
