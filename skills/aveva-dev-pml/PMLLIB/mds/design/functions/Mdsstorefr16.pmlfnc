--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFR16()

  -- Initialise variables
    !!MdsFR16.Store.clear()
    -- Required option gadgets
    -- !Size = !!MdsFR16.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFR16)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!MdsFR16)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!MdsFR16.Store.append(|!!MdsFR16.Dist.val = $!!MdsFR16.Dist.val|)
    !!MdsFR16.Store.append(|Call !!MdsPosDist(!!MdsFR16)|)
    -- !!MdsFR16.Store.append(|!!MdsFR16.Size.select('RTEXT', '$!Size')|)
    !!MdsFR16.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFR16.Store.append(|!!MdsFR16.Dim1.val = $!!MdsFR16.Dim1.val|)
    !!MdsFR16.Store.append(|!!MdsFR16.Dim2.val = $!!MdsFR16.Dim2.val|)
    !!MdsFR16.Store.append(|!!MdsFR16.Dim3.val = $!!MdsFR16.Dim3.val|)

------------------------------******* Connexions ****** --------------------
--$(
    if(!!MdsFR16.Support.Joints.unset().not()) then
      !Joints = !!MdsFR16.Support.Joints
      do !Ind indices !Joints
        !Attributes = array()
        !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
        !!MdsFR16.Store.append(|$!Joints[$!Ind].name|)
        !!MdsFR16.Store.append(|POSL $!Attributes[$!ind][1]|)
        !!MdsFR16.Store.append(|DESP $!Attributes[$!Ind][2]|)
        !!MdsFR16.Store.append(|BANG $!Attributes[$!Ind][3]|)
        !!MdsFR16.Store.append(|SPRE $!Attributes[$!ind][4]|)
        !!MdsFR16.Store.append(|JLIN $!Attributes[$!Ind][5]|)
        !!MdsFR16.Store.append(|CUTP $!Attributes[$!Ind][6]|)
        !!MdsFR16.Store.append(|CUTB $!Attributes[$!Ind][7]|)
     enddo
   else
     !!MdsFR16.Store.append(|!!MdsSelectjoints(!!MdsFR16,'IGNORE','')|)
   endif
--$)
------------------------------------------------------------------------

  -- Store support object
    !!MdsFR16.Backup = !!MdsFR16.Support

-- End function
endfunction

-- End of file MdsstoreFR16.pml
