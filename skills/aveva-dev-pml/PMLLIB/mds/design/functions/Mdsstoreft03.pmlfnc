--
-- File: Mdsstoreft03.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: I.Osborne
-- Created: Tue Jun 03
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsStoreFt03()

  -- Initialise variables
    !!mdsft03.store.clear()

--<wd>aug2007<mds12>
-- Store the MDS STRU UDA :MDSTMPLORI setting
   !mdstmplori = !!mdsft03.support.stru.:mdstmplori
--<wd>aug2007<mds12>

    -- Required option gadgets
    -- !size = !!mdsft03.size.selection('RTEXT')
    !size = !!mdsSetSteel.size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!mdsSaveAttaInf(!!mdsft03)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!mdssavepacks(!!mdsft03)
----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!mdsft03.store.append(|!!mdsft03.dist.val = $!!mdsft03.dist.val|)
    !!mdsft03.store.append(|Call !!mdsPosDist(!!mdsft03)|)

--<wd>aug2007<mds12>
-- Store the ORIGINAL MDS STRUCTURE and its UDA :MDSTMPLORI setting
    !!mdsft03.store.append(|!!ce = !!mdsft03.support.stru|)
    !!mdsft03.store.append(|!!ce.:mdstmplori = $!mdstmplori |)
--<wd>aug2007<mds12>

    -- !!mdsft03.store.append(|!!mdsft03.size.select('RTEXT', '$!size')|)
    !!mdsft03.store.append(|!!mdsSetSteel.size.select('RTEXT', '$!size')|)
    !!mdsft03.store.append(|!!mdsft03.dim1.val = $!!mdsft03.dim1.val|)
    !!mdsft03.store.append(|!!mdsft03.dim2.val = $!!mdsft03.dim2.val|)

------------------------------******* Connexions ****** --------------------
--

------------------------------------------------------------------------

  -- Store support object
    !!mdsft03.backup = !!mdsft03.support

-- End function
endfunction
