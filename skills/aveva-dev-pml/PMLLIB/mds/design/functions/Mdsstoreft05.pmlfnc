--
-- File: Mdsstoreft05.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: I.Osborne
-- Created: Mon Jun 23
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsStoreFt05()

  -- Initialise variables
    !!mdsft05.store.clear()

--<wd>aug2007<mds12>
-- Store the MDS STRU UDA :MDSTMPLORI setting
   !mdstmplori = !!mdsft05.support.stru.:mdstmplori
--<wd>aug2007<mds12>

    -- Required option gadgets
    -- !size = !!mdsft05.size.selection('RTEXT')
    !size = !!mdsSetSteel.size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!mdsSaveAttaInf(!!mdsft05)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!mdssavepacks(!!mdsft05)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!mdsft05.store.append(|!!mdsft05.dist.val = $!!mdsft05.dist.val|)
    !!mdsft05.store.append(|Call !!mdsPosDist(!!mdsft05)|)

--<wd>aug2007<mds12>
-- Store the ORIGINAL MDS STRUCTURE and its UDA :MDSTMPLORI setting
    !!mdsft05.store.append(|!!ce = !!mdsft05.support.stru|)
    !!mdsft05.store.append(|!!ce.:mdstmplori = $!mdstmplori |)
--<wd>aug2007<mds12>

    -- !!mdsft05.store.append(|!!mdsft05.size.select('RTEXT', '$!size')|)
    !!mdsft05.store.append(|!!mdsSetSteel.size.select('RTEXT', '$!size')|)
    !!mdsft05.store.append(|!!mdsft05.dim1.val = $!!mdsft05.dim1.val|)
    !!mdsft05.store.append(|!!mdsft05.dim2.val = $!!mdsft05.dim2.val|)

------------------------------******* Connexions ****** --------------------
--

------------------------------------------------------------------------

  -- Store support object
    !!mdsft05.backup = !!mdsft05.support

-- End function
endfunction
-- End of function definition for !!mdsStoreFt05
