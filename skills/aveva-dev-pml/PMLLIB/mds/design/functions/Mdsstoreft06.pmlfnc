--
-- File: Mdsstoreft06.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: I.Osborne
-- Created: Thu Jun 26
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsStoreFt06()

  -- Initialise variables
    !!mdsft06.store.clear()

--<wd>aug2007<mds12>
-- Store the MDS STRU UDA :MDSTMPLORI setting
    !mdstmplori = !!mdsft06.support.stru.:mdstmplori
--<wd>aug2007<mds12>

    -- Required option gadgets
    -- !size = !!mdsft06.size.selection('RTEXT')
    !size = !!mdsSetSteel.size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!mdsSaveAttaInf(!!mdsft06)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!mdssavepacks(!!mdsft06)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!mdsft06.store.append(|!!mdsft06.dist.val = $!!mdsft06.dist.val|)
    !!mdsft06.store.append(|Call !!mdsPosDist(!!mdsft06)|)

--<wd>aug2007<mds12>
-- Store the ORIGINAL MDS STRUCTURE and its UDA :MDSTMPLORI setting
    !!mdsft06.store.append(|!!ce = !!mdsft06.support.stru|)
    !!mdsft06.store.append(|!!ce.:mdstmplori = $!mdstmplori |)
--<wd>aug2007<mds12>

    -- !!mdsft06.store.append(|!!mdsft06.size.select('RTEXT', '$!size')|)
    !!mdsft06.store.append(|!!mdsSetSteel.size.select('RTEXT', '$!size')|)
    !!mdsft06.store.append(|!!mdsft06.dim1.val = $!!mdsft06.dim1.val|)
    !!mdsft06.store.append(|!!mdsft06.dim2.val = $!!mdsft06.dim2.val|)

------------------------------******* Connexions ****** --------------------
--

------------------------------------------------------------------------

  -- Store support object
    !!mdsft06.backup = !!mdsft06.support

-- End function
endfunction
-- End of function definition for !!mdsStoreFt06
