--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsStoreFt07()

  -- Initialise variables
    !!mdsft07.store.clear()

--<wd>aug2007<mds12>
-- Store the MDS STRU UDA :MDSTMPLORI setting
    !mdstmplori = !!mdsft07.support.stru.:mdstmplori
--<wd>aug2007<mds12>

    -- Required option gadgets
    --!size = !!mdsft07.size.selection('RTEXT')
    !size = !!mdsSetSteel.size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!mdsSaveAttaInf(!!mdsft07)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!mdssavepacks(!!mdsft07)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!mdsft07.store.append(|!!mdsft07.dist.val = $!!mdsft07.dist.val|)
    !!mdsft07.store.append(|Call !!mdsPosDist(!!mdsft07)|)

--<wd>aug2007<mds12>
-- Store the ORIGINAL MDS STRUCTURE and its UDA :MDSTMPLORI setting
    !!mdsft07.store.append(|!!ce = !!mdsft07.support.stru|)
    !!mdsft07.store.append(|!!ce.:mdstmplori = $!mdstmplori |)
--<wd>aug2007<mds12>


    --!!mdsft07.store.append(|!!mdsft07.size.select('RTEXT', '$!size')|)
    !!mdsft07.store.append(|!!mdsSetSteel.size.select('RTEXT', '$!size')|)
    !!mdsft07.store.append(|!!mdsft07.dim1.val = $!!mdsft07.dim1.val|)

------------------------------******* Connexions ****** --------------------
--

------------------------------------------------------------------------

  -- Store support object
    !!mdsft07.backup = !!mdsft07.support

-- End function
endfunction
