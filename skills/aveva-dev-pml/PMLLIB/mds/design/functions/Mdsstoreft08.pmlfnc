--
-- File: Mdsstoreft08.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: I.Osborne
-- Created: Mon Jun 30
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsStoreFt08()

  -- Initialise variables
    !!mdsft08.store.clear()

--<wd>aug2007<mds12>
-- Store the MDS STRU UDA :MDSTMPLORI setting
    !mdstmplori = !!mdsft08.support.stru.:mdstmplori
--<wd>aug2007<mds12>

    -- Required option gadgets
    --!size = !!mdsft08.size.selection('RTEXT')
    !size = !!mdsSetSteel.size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!mdsSaveAttaInf(!!mdsft08)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!mdssavepacks(!!mdsft08)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!mdsft08.store.append(|!!mdsft08.dist.val = $!!mdsft08.dist.val|)
    !!mdsft08.store.append(|Call !!mdsPosDist(!!mdsft08)|)

--<wd>aug2007<mds12>
-- Store the ORIGINAL MDS STRUCTURE and its UDA :MDSTMPLORI setting
    !!mdsft08.store.append(|!!ce = !!mdsft08.support.stru|)
    !!mdsft08.store.append(|!!ce.:mdstmplori = $!mdstmplori |)
--<wd>aug2007<mds12>

    -- !!mdsft08.store.append(|!!mdsft08.size.select('RTEXT', '$!size')|)
    !!mdsft08.store.append(|!!mdsSetSteel.size.select('RTEXT', '$!size')|)
    !!mdsft08.store.append(|!!mdsft08.dim1.val = $!!mdsft08.dim1.val|)
    !!mdsft08.store.append(|!!mdsft08.dim2.val = $!!mdsft08.dim2.val|)
    !!mdsft08.store.append(|!!mdsft08.dim3.val = $!!mdsft08.dim3.val|)
    !!mdsft08.store.append(|!!mdsft08.dim4.val = $!!mdsft08.dim4.val|)

------------------------------******* Connexions ****** --------------------
--

------------------------------------------------------------------------

  -- Store support object
    !!mdsft08.backup = !!mdsft08.support

-- End function
endfunction
