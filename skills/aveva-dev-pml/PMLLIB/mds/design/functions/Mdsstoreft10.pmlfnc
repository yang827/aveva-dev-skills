--
-- File: Mdsstoreft10.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: I.Osborne
-- Created: Thu Jul 03
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsStoreFt10()

  -- Initialise variables
    !!mdsft10.store.clear()

--<wd>aug2007<mds12>
-- Store the MDS STRU UDA :MDSTMPLORI setting
    !mdstmplori = !!mdsft10.support.stru.:mdstmplori
--<wd>aug2007<mds12>

    -- Required option gadgets
    -- !size = !!mdsft10.size.selection('RTEXT')
    !size = !!mdsSetSteel.size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!mdsSaveAttaInf(!!mdsft10)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!mdssavepacks(!!mdsft10)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!mdsft10.store.append(|!!mdsft10.dist.val = $!!mdsft10.dist.val|)
    !!mdsft10.store.append(|Call !!mdsPosDist(!!mdsft10)|)

--<wd>aug2007<mds12>
-- Store the ORIGINAL MDS STRUCTURE and its UDA :MDSTMPLORI setting
    !!mdsft10.store.append(|!!ce = !!mdsft10.support.stru|)
    !!mdsft10.store.append(|!!ce.:mdstmplori = $!mdstmplori |)
--<wd>aug2007<mds12>

    !!mdsft10.store.append(|!!mdsSetSteel.size.select('RTEXT', '$!size')|)
    !!mdsft10.store.append(|!!mdsft10.dim1.val = $!!mdsft10.dim1.val|)
    !!mdsft10.store.append(|!!mdsft10.dim2.val = $!!mdsft10.dim2.val|)
    !!mdsft10.store.append(|!!mdsft10.dim3.val = $!!mdsft10.dim3.val|)

------------------------------******* Connexions ****** --------------------

--


------------------------------------------------------------------------

  -- Store support object
    !!mdsft10.backup = !!mdsft10.support

-- End function
endfunction
