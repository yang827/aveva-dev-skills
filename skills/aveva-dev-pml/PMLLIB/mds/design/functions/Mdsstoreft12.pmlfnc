--
-- File:		Mdsstoreft12.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Tue Jul 15
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFt12()

  -- Initialise variables
    !!MdsFt12.Store.clear()
    -- Required option gadgets
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFt12)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!Mdsft12)

----------------------------------------------------------------------------
  -- Store relavent gadget information
    !!MdsFt12.Store.append(|!!MdsFt12.Dist.val = $!!MdsFt12.Dist.val|)
    !!MdsFt12.Store.append(|Call !!MdsPosDist(!!MdsFt12)|)
    !!MdsFt12.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFt12.Store.append(|!!MdsFt12.Dim1.val = $!!MdsFt12.Dim1.val|)
    !!MdsFt12.Store.append(|!!MdsFt12.Dim2.val = $!!MdsFt12.Dim2.val|)
    !!MdsFt12.Store.append(|!!MdsFt12.Dim3.val = $!!MdsFt12.Dim3.val|)
    !!MdsFt12.Store.append(|!!MdsFt12.Dim4.val = $!!MdsFt12.Dim4.val|)

------------------------------******* Connexions ****** --------------------
--$(
if(!!Mdsft12.Support.Joints.unset().not()) then
  !Joints = !!MdsFt12.Support.Joints
   do !Ind indices !Joints
      !Attributes = array()
      !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
      !!MdsFt12.Store.append(|$!Joints[$!Ind].name|)
      !!MdsFt12.Store.append(|POSL $!Attributes[$!ind][1]|)
      !!MdsFt12.Store.append(|DESP $!Attributes[$!Ind][2]|)
      !!MdsFt12.Store.append(|BANG $!Attributes[$!Ind][3]|)
      !!MdsFt12.Store.append(|SPRE $!Attributes[$!ind][4]|)
      !!MdsFt12.Store.append(|JLIN $!Attributes[$!Ind][5]|)
      !!MdsFt12.Store.append(|CUTP $!Attributes[$!Ind][6]|)
      !!MdsFt12.Store.append(|CUTB $!Attributes[$!Ind][7]|)
   enddo
else
  !!MdsFt12.Store.append(|!!MdsSelectjoints(!!Mdsft12,'DISCONNECT','')|)
endif
--$)
------------------------------------------------------------------------


  -- Store support object
    !!MdsFt12.Backup = !!MdsFt12.Support

-- End function
endfunction

-- End of file Mdsstoreft12.pml
