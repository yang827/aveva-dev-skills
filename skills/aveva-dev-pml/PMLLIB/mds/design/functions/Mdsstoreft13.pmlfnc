-- Created:		Wed Jul 16
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFt13()

  -- Initialise variables
    !!MdsFt13.Store.clear()
    -- Required option gadgets
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFt13)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!Mdsft13)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!MdsFt13.Store.append(|!!MdsFt13.Dist.val = $!!MdsFt13.Dist.val|)
    !!MdsFt13.Store.append(|Call !!MdsPosDist(!!MdsFt13)|)
    !!MdsFt13.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFt13.Store.append(|!!MdsFt13.Dim1.val = $!!MdsFt13.Dim1.val|)
    !!MdsFt13.Store.append(|!!MdsFt13.Dim2.val = $!!MdsFt13.Dim2.val|)
    !!MdsFt13.Store.append(|!!MdsFt13.Dim3.val = $!!MdsFt13.Dim3.val|)


------------------------------******* Connexions ****** --------------------
--$(

if(!!Mdsft13.Support.Joints.unset().not()) then

  !Joints = !!MdsFt13.Support.Joints
   do !Ind indices !Joints
      !Attributes = array()
      !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')

      !!MdsFt13.Store.append(|$!Joints[$!Ind].name|)
      !!MdsFt13.Store.append(|POSL $!Attributes[$!ind][1]|)
      !!MdsFt13.Store.append(|DESP $!Attributes[$!Ind][2]|)
      !!MdsFt13.Store.append(|BANG $!Attributes[$!Ind][3]|)
      !!MdsFt13.Store.append(|SPRE $!Attributes[$!ind][4]|)
      !!MdsFt13.Store.append(|JLIN $!Attributes[$!Ind][5]|)
      !!MdsFt13.Store.append(|CUTP $!Attributes[$!Ind][6]|)
      !!MdsFt13.Store.append(|CUTB $!Attributes[$!Ind][7]|)

   enddo
else
  !!MdsFt13.Store.append(|!!MdsSelectjoints(!!Mdsft13,'DISCONNECT','')|)
endif

--$)

------------------------------------------------------------------------


  -- Store support object
    !!MdsFt13.Backup = !!MdsFt13.Support

-- End function
endfunction

-- End of file Mdsstoreft13.pml
