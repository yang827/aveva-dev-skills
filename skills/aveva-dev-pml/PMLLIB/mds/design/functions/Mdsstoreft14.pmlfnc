--
-- File: Mdsstoreft14.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: I.Osborne
-- Created: Tue Jul 22
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsStoreFt14()

  -- Initialise variables
    !!mdsft14.store.clear()

--<wd>aug2007<mds12>
-- Store the MDS STRU UDA :MDSTMPLORI setting
    !mdstmplori = !!mdsft14.support.stru.:mdstmplori
--<wd>aug2007<mds12>

    -- Required option gadgets
    !size = !!mdsSetSteel.size.selection('RTEXT')
    !build = !!mdsft14.slide.selection('RTEXT')

  -- Store original atta despars, orientation
    !!mdsSaveAttaInf(!!mdsft14)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!mdssavepacks(!!mdsft14)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!mdsft14.store.append(|!!mdsft14.dist.val = $!!mdsft14.dist.val|)
    !!mdsft14.store.append(|Call !!mdsPosDist(!!mdsft14)|)

--<wd>aug2007<mds12>
-- Store the ORIGINAL MDS STRUCTURE and its UDA :MDSTMPLORI setting
    !!mdsft14.store.append(|!!ce = !!mdsft14.support.stru|)
    !!mdsft14.store.append(|!!ce.:mdstmplori = $!mdstmplori |)
--<wd>aug2007<mds12>

    !!mdsft14.store.append(|!!mdsSetSteel.size.select('RTEXT', '$!size')|)
    !!mdsft14.store.append(|!!mdsft14.slide.select('RTEXT', '$!build')|)
 --   !!mdsft14.store.append(|!!mdsft14.Create.select('RTEXT', 'CURSOR')|)
    !!mdsft14.store.append(|!!mdsft14.dim1.val = $!!mdsft14.dim1.val|)
    !!mdsft14.store.append(|!!mdsft14.dim2.val = $!!mdsft14.dim2.val|)

------------------------------******* Connexions ****** --------------------
--

------------------------------------------------------------------------

  -- Store support object
    !!mdsft14.backup = !!mdsft14.support

  -- Special storage requirements for this frame type
  -- If we are storing configuration 4 or 5 then get data about stiffener
  -- and store in the form member 'STIFFENER'

    !!mdsft14.stiffener.clear()
    if (!!mdsft14.support.config eq 4 or !!mdsft14.support.config eq 5)then
      if(!!mdsft14.support.alias.neq('CT06') and !!mdsft14.support.alias.neq('DT03')) then

-- Find current units and set the distance unit to metric
        !currentUnits = !!kGetSetUnits()

        !name = !!mdsft14.support.stru.name
        !!ce = $!<name>/SUBS1
        BOX 1
        !xlen = !!ce.xlen
        !ylen = !!ce.ylen
        !zlen = !!ce.zlen
        !ori  = !!ce.ori
        !pos  = !!ce.pos.wrt(world)

      -- Store data
        !!mdsft14.stiffener.append(|XLEN $!xlen YLEN $!ylen ZLEN $!zlen|)
        !!mdsft14.stiffener.append(|ORI $!ori|)
        !!mdsft14.stiffener.append(|SUBS|)
        !!mdsft14.stiffener.append(|AT $!pos|)

-- Get Stiffener Data from the SUBS attribute  - UDA :MDSCp2 if it has been set
        !data  = !!ce.owner.:MDSCp2
        !split = !data.split(';')
        !!mdsft14.oldstiffener.clear()
        if (!split[1].eq('unset')) then
          !!mdsft14.oldstiffener.append(|$!xlen|)
          !!mdsft14.oldstiffener.append(|$!ylen|)
          !!mdsft14.oldstiffener.append(|$!zlen|)
        else
          !!mdsft14.oldstiffener.append(|$!split[1]|)
          !!mdsft14.oldstiffener.append(|$!split[2]|)
          !!mdsft14.oldstiffener.append(|$!split[3]|)
        endif

-- Navigate back to structure
        !!ce = !!mdsft14.support.stru

-- Reset Units
        !!kRestoreUnits(!currentunits)
      endif

    endif

-- End function
endfunction
