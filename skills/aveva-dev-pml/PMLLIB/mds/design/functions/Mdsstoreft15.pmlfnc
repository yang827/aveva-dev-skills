--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 1st October 1997
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreft15()

-- Initialise variables
    !!Mdsft15.Store.clear()

-- Required option gadgets
    !Size = !!MdsSetSteel.Size.selection('RTEXT')
    !Build = !!Mdsft15.Slide.selection('RTEXT')

-- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFt15)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!Mdsft15)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdsft15.Store.append(|!!Mdsft15.Dist.val = $!!Mdsft15.Dist.val|)
    !!Mdsft15.Store.append(|Call !!MdsPosDist(!!Mdsft15)|)
    !!MdsFt15.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!Mdsft15.Store.append(|!!Mdsft15.Slide.select('RTEXT', '$!Build')|)
--    !!Mdsft15.Store.append(|!!Mdsft15.Create.select('RTEXT', 'CURSOR')|)
    !!Mdsft15.Store.append(|!!Mdsft15.Dim1.val = $!!Mdsft15.Dim1.val|)
    !!Mdsft15.Store.append(|!!Mdsft15.Dim2.val = $!!Mdsft15.Dim2.val|)
    !!Mdsft15.Store.append(|!!Mdsft15.Dim3.val = $!!Mdsft15.Dim3.val|)
    !!Mdsft15.Store.append(|!!Mdsft15.Dim4.val = $!!Mdsft15.Dim4.val|)
    !!Mdsft15.Store.append(|!!Mdsft15.Dim5.val = $!!Mdsft15.Dim5.val|)

------------------------------******* Connexions ****** --------------------
--$(
    if(!!MdsFT15.Support.Joints.unset().not()) then

      !Joints = !!MdsFT15.Support.Joints
      do !Ind indices !Joints
        !Attributes = array()
        !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')

        !!MdsFT15.Store.append(|$!Joints[$!Ind].name|)
        !!MdsFT15.Store.append(|POSL $!Attributes[$!ind][1]|)
        !!MdsFT15.Store.append(|DESP $!Attributes[$!Ind][2]|)
        !!MdsFT15.Store.append(|BANG $!Attributes[$!Ind][3]|)
        !!MdsFT15.Store.append(|SPRE $!Attributes[$!ind][4]|)
        !!MdsFT15.Store.append(|JLIN $!Attributes[$!Ind][5]|)
        !!MdsFT15.Store.append(|CUTP $!Attributes[$!Ind][6]|)
        !!MdsFT15.Store.append(|CUTB $!Attributes[$!Ind][7]|)

      enddo
    else
      !!MdsFT15.Store.append(|!!MdsSelectjoints(!!Mdsft15,'DISCONNECT','')|)
    endif

--$)
------------------------------------------------------------------------

-- Store support object
    !!Mdsft15.Backup = !!Mdsft15.Support

-- Navigate back to structure
    !!CE = !!Mdsft15.Support.Stru

-- Store Position and Direction of Cross Bar (and Vertical Section if Config is '4')
    !Types = !!KCollectAllFor('SCTN', '(type of owner eq |FRMW|)', !!CE)
    !sectn = object BLOCK('!types[!evalindex].name')
    !sname = !types.evaluate(!sectn)

    do !data values !sname
       !!ce = !data.dbref()
       !poss = poss wrt /*
       !drns = drns wrt /*
       !pose = pose wrt /*
       !drne = drne wrt /*
       !bang = bang
       !!Mdsft15.Store.append(|$!data|)
       !!Mdsft15.Store.append(|poss $!poss|)
       !!Mdsft15.Store.append(|drns $!drns|)
       !!Mdsft15.Store.append(|pose $!pose|)
       !!Mdsft15.Store.append(|drne $!drne|)
       !!Mdsft15.Store.append(|bang $!bang|)
    enddo

-- End function
endfunction

-- End of file Mdsstoreft15.pml
