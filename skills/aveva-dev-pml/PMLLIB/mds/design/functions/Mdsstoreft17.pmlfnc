-- Created:		Monday 21 July 1997
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreft17()

  -- Initialise variables
    !!Mdsft17.Store.clear()
    -- Required option gadgets
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFt17)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!Mdsft17)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!Mdsft17.Store.append(|!!Mdsft17.Dist.val = $!!Mdsft17.Dist.val|)
    !!Mdsft17.Store.append(|Call !!MdsPosDist(!!Mdsft17)|)
    !!MdsFt17.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!Mdsft17.Store.append(|!!Mdsft17.Dim1.val = $!!Mdsft17.Dim1.val|)
    !!Mdsft17.Store.append(|!!Mdsft17.Dim2.val = $!!Mdsft17.Dim2.val|)
    !!Mdsft17.Store.append(|!!Mdsft17.Dim3.val = $!!Mdsft17.Dim3.val|)
    !!Mdsft17.Store.append(|!!Mdsft17.Dim4.val = $!!Mdsft17.Dim4.val|)

------------------------------******* Connexions ****** --------------------
--$(
    if(!!Mdsft17.Support.Joints.unset().not()) then
      !Joints = !!MdsFt17.Support.Joints
      do !Ind indices !Joints
        !Attributes = array()
        !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
        !!MdsFt17.Store.append(|$!Joints[$!Ind].name|)
        !!MdsFt17.Store.append(|POSL $!Attributes[$!ind][1]|)
        !!MdsFt17.Store.append(|DESP $!Attributes[$!Ind][2]|)
        !!MdsFt17.Store.append(|BANG $!Attributes[$!Ind][3]|)
        !!MdsFt17.Store.append(|SPRE $!Attributes[$!ind][4]|)
        !!MdsFt17.Store.append(|JLIN $!Attributes[$!Ind][5]|)
        !!MdsFt17.Store.append(|CUTP $!Attributes[$!Ind][6]|)
       !!MdsFt17.Store.append(|CUTB $!Attributes[$!Ind][7]|)
     enddo
   else
     !!MdsFt17.Store.append(|!!MdsSelectjoints(!!Mdsft17,'DISCONNECT','')|)
   endif
--$)
------------------------------------------------------------------------

  -- Store support object
    !!Mdsft17.Backup = !!Mdsft17.Support

-- End function
endfunction

-- End of file Mdsstoreft17.pml
