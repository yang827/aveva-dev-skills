--
-- File: Mdsstoreft18.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword:MDS
--   Module: design
--   Replaces:
--
-- Author: Wayne Dodwell
-- Created: Wednesday 27 August 1997
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsStoreFt18()

  -- Initialise variables
    !!mdsft18.store.clear()

--<wd>aug2007<mds12>
-- Store the MDS STRU UDA :MDSTMPLORI setting
    !mdstmplori = !!mdsft18.support.stru.:mdstmplori
--<wd>aug2007<mds12>

    -- Required option gadgets
    !size = !!mdsSetSteel.size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!mdsSaveAttaInf(!!mdsft18)

  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!mdssavepacks(!!mdsft18)

  -- Store relavent gadget information
    !!mdsft18.store.append(|!!mdsft18.dist.val = $!!mdsft18.dist.val|)
    !!mdsft18.store.append(|Call !!mdsPosDist(!!mdsft18)|)

--<wd>aug2007<mds12>
-- Store the ORIGINAL MDS STRUCTURE and its UDA :MDSTMPLORI setting
    !!mdsft18.store.append(|!!ce = !!mdsft18.support.stru|)
    !!mdsft18.store.append(|!!ce.:mdstmplori = $!mdstmplori |)
--<wd>aug2007<mds12>

    !!mdsft18.store.append(|!!mdsSetSteel.size.select('RTEXT', '$!size')|)
    !!mdsft18.store.append(|!!mdsft18.dim1.val = $!!mdsft18.dim1.val|)
    !!mdsft18.store.append(|!!mdsft18.dim2.val = $!!mdsft18.dim2.val|)

------------------------------******* Connexions ****** --------------------
--

------------------------------------------------------------------------

  -- Store support object
    !!mdsft18.backup = !!mdsft18.support

-- End function
endfunction
