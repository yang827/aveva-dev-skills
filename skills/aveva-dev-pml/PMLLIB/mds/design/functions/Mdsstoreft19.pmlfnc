--
-- File: Mdsstoreft19.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Wayne Dodwell
-- Created: Monday 15 September 1997
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsStoreFt19()

  -- Initialise variables
    !!mdsft19.store.clear()

--<wd>aug2007<mds12>
-- Store the MDS STRU UDA :MDSTMPLORI setting
    !mdstmplori = !!mdsft19.support.stru.:mdstmplori
--<wd>aug2007<mds12>

    -- Required option gadgets
    !size = !!mdsSetSteel.size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!mdsSaveAttaInf(!!mdsft19)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!mdssavepacks(!!mdsft19)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!mdsft19.store.append(|!!mdsft19.dist.val = $!!mdsft19.dist.val|)
    !!mdsft19.store.append(|Call !!mdsPosDist(!!mdsft19)|)

--<wd>aug2007<mds12>
-- Store the ORIGINAL MDS STRUCTURE and its UDA :MDSTMPLORI setting
    !!mdsft19.store.append(|!!ce = !!mdsft19.support.stru|)
    !!mdsft19.store.append(|!!ce.:mdstmplori = $!mdstmplori |)
--<wd>aug2007<mds12>

    !!mdsft19.store.append(|!!mdsSetSteel.size.select('RTEXT', '$!size')|)
    !!mdsft19.store.append(|!!mdsft19.dim1.val = $!!mdsft19.dim1.val|)
    !!mdsft19.store.append(|!!mdsft19.dim2.val = $!!mdsft19.dim2.val|)

------------------------------******* Connexions ****** --------------------
--

------------------------------------------------------------------------

  -- Store support object
    !!mdsft19.backup = !!mdsft19.support

-- End function
endfunction
