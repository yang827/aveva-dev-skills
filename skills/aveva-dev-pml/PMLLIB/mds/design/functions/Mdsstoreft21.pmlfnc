--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreft21()

-- Initialise variables
    !!Mdsft21.Store.clear()

-- Required option gadgets
    -- !Size  = !!Mdsft21.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.Selection('Rtext')

-- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFt21)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!Mdsft21)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdsft21.Store.append(|!!Mdsft21.Dist.val = $!!Mdsft21.Dist.val|)
    !!Mdsft21.Store.append(|Call !!MdsPosDist(!!Mdsft21)|)
    -- !!Mdsft21.Store.append(|!!Mdsft21.Size.select('RTEXT', '$!Size')|)
    !!MdsFt21.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
--    !!Mdsft21.Store.append(|!!Mdsft21.Create.select('RTEXT', 'CURSOR')|)
    !!Mdsft21.Store.append(|!!Mdsft21.dim1.val = !!kformattext.text.val.string(!!$!!kFormattext.text.format)|)

-- Store support object
    !!Mdsft21.Backup = !!Mdsft21.Support

-- Navigate back to structure
    !!CE = !!Mdsft21.Support.Stru

-- Store Position and Direction of Cross Bar (and Vertical Section if Config is '4')
    !Types = !!KCollectAllFor('SCTN', '(type of owner eq |FRMW|)', !!CE)
    !sectn = object BLOCK('!types[!evalindex].name')
    !sname = !types.evaluate(!sectn)

    do !data values !sname
       !!ce = !data.dbref()
       !poss = poss wrt /*
       !drns = drns wrt /*
       !pose = pose wrt /*
       !drne = drne wrt /*
       !bang = bang
       !!Mdsft21.Store.append(|$!data|)
       !!Mdsft21.Store.append(|poss $!poss|)
       !!Mdsft21.Store.append(|drns $!drns|)
       !!Mdsft21.Store.append(|pose $!pose|)
       !!Mdsft21.Store.append(|drne $!drne|)
       !!Mdsft21.Store.append(|bang $!bang|)
    enddo

-- End function
endfunction

-- End of file Mdsstoreft21.pml
