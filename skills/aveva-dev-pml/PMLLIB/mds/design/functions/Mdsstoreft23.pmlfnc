--
-- File: Mdsstoreft23.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: I.Osborne
-- Created: Mon Aug 04
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsStoreFt23()

  -- Initialise variables
    !!mdsft23.store.clear()

--<wd>aug2007<mds12>
-- Store the MDS STRU UDA :MDSTMPLORI setting
    !mdstmplori = !!mdsft23.support.stru.:mdstmplori
--<wd>aug2007<mds12>

    -- Required option gadgets
    -- !size = !!mdsft23.size.selection('RTEXT')
    !size = !!mdsSetSteel.size.selection('RTEXT')
    !cap  = !!mdsft23.cap.selection('RTEXT')

-- Store original atta despars, orientation
    !!mdsSaveAttaInf(!!mdsft23)

  -- Store relavent gadget information
    !!mdsft23.store.append(|!!mdsft23.dist.val = $!!mdsft23.dist.val|)
    !!mdsft23.store.append(|Call !!mdsPosDist(!!mdsft23)|)

--<wd>aug2007<mds12>
-- Store the ORIGINAL MDS STRUCTURE and its UDA :MDSTMPLORI setting
    !!mdsft23.store.append(|!!ce = !!mdsft23.support.stru|)
    !!mdsft23.store.append(|!!ce.:mdstmplori = $!mdstmplori |)
--<wd>aug2007<mds12>

    -- !!mdsft23.store.append(|!!mdsft23.size.select('RTEXT', '$!Size')|)
    !!mdsft23.store.append(|!!mdsSetSteel.size.select('RTEXT', '$!size')|)
    !!mdsft23.store.append(|!!mdsft23.cap.select('RTEXT', '$!cap')|)
    !!mdsft23.store.append(|!!mdsft23.dim1.val = $!!mdsft23.dim1.val|)


------------------------------******* Connexions ****** --------------------
--

------------------------------------------------------------------------


  -- Store support object
    !!mdsft23.backup = !!mdsft23.support

-- End function
endfunction
