--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFt24()

  -- Initialise variables
    !!MdsFt24.Store.clear()
    -- Required option gadgets
    -- !Size = !!MdsFt24.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')
    !Dim1 = !!MdsFt24.Dim1.selection('RTEXT')

-- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFt24)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!Mdsft24)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!MdsFt24.Store.append(|!!MdsFt24.Dist.val = $!!MdsFt24.Dist.val|)
    !!MdsFt24.Store.append(|Call !!MdsPosDist(!!MdsFt24)|)
    -- !!MdsFt24.Store.append(|!!MdsFt24.Size.select('RTEXT', '$!Size')|)
    !!MdsFt24.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFt24.Store.append(|!!MdsFt24.Dim1.select('RTEXT', '$!Dim1')|)
    !!MdsFt24.Store.append(|!!MdsFt24.Dim2.val = $!!MdsFt24.Dim2.val|)

  -- Store support object
    !!MdsFt24.Backup = !!MdsFt24.Support

-- End function
endfunction

-- End of file Mdsstoreft24.pml
