--
-- File:		Mdsstoreft25.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 25th November 1997
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        STRING        CREATE - If 'FT25' is Independant in Create Mode
--                                   FRAME  - If 'FT25' called from a foreign Framework
--                                   MODIFY - If 'FT25' is Independant in Modify Mode
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstoreft25(!method is STRING)


-- Find current units and set the distance unit to metric

    !CurrentUnits = !!KGetSetUnits()




-- Initialise variables
    !!Mdsft25.store.clear()
    !stru    = !!Mdsft25.support.stru
    !frame   = !stru.name & '/MAIN'

-- Required option gadgets
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

-- Store original Atta despars, orientation etc. ONLY
-- when Packing Pieces are Independant of Any Other Framework Type
--------------------------------------------------------------------------------
    if (!method.upcase() ne 'FRAME') then
-- Form 'FT25' called as an Independant Framework ('MODIFY' or 'CREATE')

      !!Mdssaveattainf(!!Mdsft25)

-- Store relavent gadget information
      !!Mdsft25.store.append(|!!Mdsft25.dist.val = $!!Mdsft25.dist.val|)
      !!Mdsft25.store.append(|Call !!Mdsposdist(!!Mdsft25)|)
      -- !!Mdsft25.store.append(|!!Mdsft25.size.select('RTEXT', '$!Size')|)
      !!MdsFt25.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)

-- Store original Cross Bar/Packing Piece Despars, Spref, :MDSAttaRef etc
      !!Mdssavepacks(!!Mdsft25)

-- Store support object
      !!Mdsft25.backup = !!Mdsft25.support

--------------------------------------------------------------------------------
-- Form 'FT25' called from a 'foreign' Framework
    elseif (!method.upcase() eq 'FRAME') then

-- Clear and Data from Form member .Ppack
      !!Mdsft25.ppack.clear()

-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
      !!ce = !!Mdsft25.fatta

      if (!!ce.:MDSPackRef.badref().not() ) then
        !!ce      = !!ce.:MDSPackRef
        !name     = !!ce.name
        var !despar despar
        !posstart = poss wrt /*
        !posend   = pose wrt /*
        !drns     = drns wrt /*
        !drne     = drne wrt /*
        !bang     = bang wrt /*
        !spref    = spref
        !attaref  = :MDSAttaRef[1]
        !!ce      = !attaref
        !attapos  = pos wrt /*
        !packnam  = name of :MDSPackRef
        handle any
        endhandle
        !packref  = :MDSPackRef

        !!Mdsft25.ppack.append('!!ce = $!frame')
        !!Mdsft25.ppack.append('new sctn $!name')
        !!Mdsft25.ppack.append('spref $!spref')
        !!Mdsft25.ppack.append('poss $!posstart')
        !!Mdsft25.ppack.append('pose $!posend')
        !!Mdsft25.ppack.append('drns $!drns')
        !!Mdsft25.ppack.append('drne $!drne')
        !!Mdsft25.ppack.append('bang $!bang')
        !!Mdsft25.ppack.append(':MDSAttaRef $!attaref')
        !!Mdsft25.ppack.append('desp $!despar')
        !!Mdsft25.ppack.append('!!ce = $!attaref')
        !!Mdsft25.ppack.append('at $!attapos')
        if (!packref.badref()) then
          !!Mdsft25.ppack.append(':MDSPackRef unset')
        else
          !!Mdsft25.ppack.append(':MDSPackRef $!packnam')
        endif

      else

        !!ce = !!Mdsft25.fatta
        !attapos  = pos wrt /*
        !packref  = :MDSPackRef
        !!Mdsft25.ppack.append('!!ce = !!Mdsft25.fatta')
        !!Mdsft25.ppack.append('at $!attapos')
        !!Mdsft25.ppack.append(':MDSPackRef unset')

      endif

    endif


-- Reset Units

   !!kRestoreUnits(!currentunits)


--------------------------------------------------------------------------------

-- End function
  endfunction

-- End of file Mdsstoreft25.pml
