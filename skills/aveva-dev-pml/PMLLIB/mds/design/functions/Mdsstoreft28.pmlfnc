--
-- File:		Mdsstoreft28.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 4th November 1997
--
--
-- Description:
-- store form data prior to modification for Framework type 'FT28'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsstoreft28()

-- Initialise variables
    !!Mdsft28.store.clear()

-- Required option gadgets
    -- !size  = !!Mdsft28.size.selection('rtext')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

-- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFt28)

-- Store relavent gadget information
    !!Mdsft28.store.append(|!!Mdsft28.dist.val = $!!Mdsft28.dist.val|)
    !!Mdsft28.store.append(|call !!Mdsposdist(!!Mdsft28)|)
    -- !!Mdsft28.store.append(|!!Mdsft28.size.select('rtext', '$!size')|)
    !!MdsFt28.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
--    !!Mdsft28.store.append(|!!Mdsft28.Create.select('rtext', 'CURSOR')|)
    !!Mdsft28.store.append(|!!Mdsft28.clear.val = $!!Mdsft28.clear.val|)
    !!Mdsft28.store.append(|!!Mdsft28.fcler.val = $!!Mdsft28.fcler.val|)

-- Store support object
    !!Mdsft28.backup = !!Mdsft28.support

-- Navigate back to structure store Stru Dbref and Ori
    !!ce = !!Mdsft28.support.stru
    !!Mdsft28.store.append(|$!!Mdsft28.support.stru|)
    !ori = ori wrt /*
    !!Mdsft28.store.append(|ori $!ori|)
    !stp = pos wrt /*
    !!Mdsft28.store.append(|at $!stp|)

------------------------------******* Connexions ****** --------------------
--$(
    if(!!MdsFT28.Support.Joints.unset().not()) then

      !Joints = !!MdsFT28.Support.Joints
      do !Ind indices !Joints
        !Attributes = array()
        !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')

        !!MdsFT28.Store.append(|$!Joints[$!Ind].name|)
        !!MdsFT28.Store.append(|POSL $!Attributes[$!ind][1]|)
        !!MdsFT28.Store.append(|DESP $!Attributes[$!Ind][2]|)
        !!MdsFT28.Store.append(|BANG $!Attributes[$!Ind][3]|)
        !!MdsFT28.Store.append(|SPRE $!Attributes[$!ind][4]|)
        !!MdsFT28.Store.append(|JLIN $!Attributes[$!Ind][5]|)
        !!MdsFT28.Store.append(|CUTP $!Attributes[$!Ind][6]|)
        !!MdsFT28.Store.append(|CUTB $!Attributes[$!Ind][7]|)

      enddo
    else
      !!MdsFT28.Store.append(|!!MdsSelectjoints(!!MdsFT28,'DISCONNECT','')|)
    endif

--$)
------------------------------------------------------------------------


-- Store Position and Direction of Cross Bar and Vertical Sections
    !types = !!kcollectallfor('SCTN', '(type of owner eq |FRMW|)', !!CE)
    !sectn = object BLOCK('!types[!evalindex].name')
    !sname = !types.evaluate(!sectn)

    do !data values !sname
      !!ce = !data.dbref()
      !poss = poss wrt /*
      !drns = drns wrt /*
      !pose = pose wrt /*
      !drne = drne wrt /*
      !bang = bang wrt /*
      !spre = spref
      !!Mdsft28.store.append(|$!data|)
      !!Mdsft28.store.append(|poss $!poss|)
      !!Mdsft28.store.append(|drns $!drns|)
      !!Mdsft28.store.append(|pose $!pose|)
      !!Mdsft28.store.append(|drne $!drne|)
      !!Mdsft28.store.append(|bang $!bang|)
      !!Mdsft28.store.append(|spre $!spre|)
    enddo

-- End function
endfunction

-- End of file Mdsstoreft28.pml
