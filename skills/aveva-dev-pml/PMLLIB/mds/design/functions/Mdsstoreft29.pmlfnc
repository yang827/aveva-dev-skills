--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFt29()

  -- Initialise variables
    !!MdsFt29.Store.clear()
    -- Required option gadgets
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFt29)

  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!MdsFt29)

  -- Store relavent gadget information
    !!MdsFt29.Store.append(|!!MdsFt29.Dist.val = $!!MdsFt29.Dist.val|)
    !!MdsFt29.Store.append(|Call !!MdsPosDist(!!MdsFt29)|)
    !!MdsFt29.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFt29.Store.append(|!!MdsFt29.Dim1.val = $!!MdsFt29.Dim1.val|)
    !!MdsFt29.Store.append(|!!MdsFt29.Dim2.val = $!!MdsFt29.Dim2.val|)

------------------------------******* Connexions ****** --------------------
$(
    if(!!MdsFt29.Support.Joints.unset().not()) then
      !Joints = !!MdsFt29.Support.Joints
      do !Ind indices !Joints
        !Attributes = array()
        !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
        !!MdsFt29.Store.append(|$!Joints[$!Ind].name|)
        !!MdsFt29.Store.append(|POSL $!Attributes[$!ind][1]|)
        !!MdsFt29.Store.append(|DESP $!Attributes[$!Ind][2]|)
        !!MdsFt29.Store.append(|BANG $!Attributes[$!Ind][3]|)
        !!MdsFt29.Store.append(|SPRE $!Attributes[$!ind][4]|)
        !!MdsFt29.Store.append(|JLIN $!Attributes[$!Ind][5]|)
        !!MdsFt29.Store.append(|CUTP $!Attributes[$!Ind][6]|)
       !!MdsFt29.Store.append(|CUTB $!Attributes[$!Ind][7]|)
     enddo
   else
     !!MdsFt29.Store.append(|!!MdsSelectjoints(!!MdsFt29,'DISCONNECT','')|)
   endif
$)
------------------------------------------------------------------------

  -- Store support object
    !!MdsFt29.Backup = !!MdsFt29.Support

-- End function
endfunction

-- End of file MdsstoreFt29.pml
