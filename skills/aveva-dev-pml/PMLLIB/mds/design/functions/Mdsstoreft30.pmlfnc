--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreft30()

  -- Initialise variables
    !!Mdsft30.Store.clear()
    -- Required option gadgets
    -- !Size = !!Mdsft30.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!Mdsft30)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!Mdsft30)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!Mdsft30.Store.append(|!!Mdsft30.Dist.val = $!!Mdsft30.Dist.val|)
    !!Mdsft30.Store.append(|Call !!MdsPosDist(!!Mdsft30)|)
    !!Mdsft30.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!Mdsft30.Store.append(|!!Mdsft30.Dim1.val = $!!Mdsft30.Dim1.val|)

------------------------------******* Connexions ****** --------------------

--$(

if(!!Mdsft30.Support.Joints.unset().not()) then

  !Joints = !!Mdsft30.Support.Joints
   do !Ind indices !Joints
      !Attributes = array()
      !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')

      !!Mdsft30.Store.append(|$!Joints[$!Ind].name|)
      !!Mdsft30.Store.append(|POSL $!Attributes[$!ind][1]|)
      !!Mdsft30.Store.append(|DESP $!Attributes[$!Ind][2]|)
      !!Mdsft30.Store.append(|BANG $!Attributes[$!Ind][3]|)
      !!Mdsft30.Store.append(|SPRE $!Attributes[$!ind][4]|)
      !!Mdsft30.Store.append(|JLIN $!Attributes[$!Ind][5]|)
      !!Mdsft30.Store.append(|CUTP $!Attributes[$!Ind][6]|)
      !!Mdsft30.Store.append(|CUTB $!Attributes[$!Ind][7]|)

   enddo
else
  !!Mdsft30.Store.append(|!!MdsSelectjoints(!!Mdsft30,'DISCONNECT','')|)
endif

--$)

------------------------------------------------------------------------

  -- Store support object
    !!Mdsft30.Backup = !!Mdsft30.Support

-- End function
endfunction

-- End of file Mdsstoreft30.pml
