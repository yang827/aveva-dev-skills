--
-- File: MdsstoreFT34.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: I.Osborne
-- Created: Tue Jul 22
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsstoreft34()

  -- Initialise variables
    !!mdsft34.store.clear()

--<wd>aug2007<mds12>
-- Store the MDS STRU UDA :MDSTMPLORI setting
    !mdstmplori = !!mdsft34.support.stru.:mdstmplori
--<wd>aug2007<mds12>

    -- Required option gadgets
    !size = !!mdsSetSteel.size.selection('RTEXT')
    !build = !!mdsft34.slide.selection('RTEXT')

  -- Store original atta despars, orientation
    !!mdsSaveAttaInf(!!mdsft34)

  -- Store relavent gadget information
    !!mdsft34.store.append(|!!mdsft34.dist.val = $!!mdsft34.dist.val|)
    !!mdsft34.store.append(|Call !!mdsPosDist(!!mdsft34)|)

--<wd>aug2007<mds12>
-- Store the ORIGINAL MDS STRUCTURE and its UDA :MDSTMPLORI setting
    !!mdsft34.store.append(|!!ce = !!mdsft34.support.stru|)
    !!mdsft34.store.append(|!!ce.:mdstmplori = $!mdstmplori |)
--<wd>aug2007<mds12>

    !!mdsft34.store.append(|!!mdsSetSteel.size.select('RTEXT', '$!size')|)
    !!mdsft34.store.append(|!!mdsft34.slide.select('RTEXT', '$!build')|)
    !!mdsft34.store.append(|!!mdsft34.dim1.val = $!!mdsft34.dim1.val|)
    !!mdsft34.store.append(|!!mdsft34.dim2.val = $!!mdsft34.dim2.val|)
    !!mdsft34.store.append(|!!mdsSelectjoints(!!mdsft34,'DISCONNECT','')|)

  -- Store support object
    !!mdsft34.backup = !!mdsft34.support

-- End function
endfunction
