--
-- File: Mdsstoreft35.pml
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: I.Osborne
-- Created: Mon June 30
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsStoreft35()

  -- Initialise variables
    !!mdsft35.store.clear()

--<wd>aug2007<mds12>
-- Store the MDS STRU UDA :MDSTMPLORI setting
    !mdstmplori = !!mdsft35.support.stru.:mdstmplori
--<wd>aug2007<mds12>

    -- Required option gadgets
    --!size = !!mdsft35.size.selection('RTEXT')
    !size = !!mdssetsteel.size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!mdsSaveAttaInf(!!mdsft35)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!mdssavepacks(!!mdsft35)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!mdsft35.store.append(|!!mdsft35.dist.val = $!!mdsft35.dist.val|)
    !!mdsft35.store.append(|Call !!mdsPosDist(!!mdsft35)|)

--<wd>aug2007<mds12>
-- Store the ORIGINAL MDS STRUCTURE and its UDA :MDSTMPLORI setting
    !!mdsft35.store.append(|!!ce = !!mdsft35.support.stru|)
    !!mdsft35.store.append(|!!ce.:mdstmplori = $!mdstmplori |)
--<wd>aug2007<mds12>

    -- !!mdsft35.store.append(|!!mdsft35.size.select('RTEXT', '$!size')|)
    !!mdsft35.store.append(|!!mdssetsteel.size.select('RTEXT', '$!size')|)
    !!mdsft35.store.append(|!!mdsft35.dim1.val = $!!mdsft35.dim1.val|)
    !!mdsft35.store.append(|!!mdsft35.dim2.val = $!!mdsft35.dim2.val|)
    !!mdsft35.store.append(|!!mdsft35.dim3.val = $!!mdsft35.dim3.val|)
    !!mdsft35.store.append(|!!mdsft35.dim4.val = $!!mdsft35.dim4.val|)

------------------------------******* Connexions ****** --------------------
--

------------------------------------------------------------------------

  -- Store support object
    !!mdsft35.backup = !!mdsft35.support

-- End function
endfunction
