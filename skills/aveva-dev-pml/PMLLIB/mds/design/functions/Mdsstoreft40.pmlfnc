--
-- File: mdsstoreft40.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Wayne Dodwell
-- Created: Monday 21 July 1997
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsStoreft40()

  -- Initialise variables
    !!mdsft40.store.clear()

--<wd>aug2007<mds12>
-- Store the MDS STRU UDA :MDSTMPLORI setting
    !mdstmplori = !!mdsft40.support.stru.:mdstmplori
--<wd>aug2007<mds12>

    -- Required option gadgets
    !size = !!mdsSetSteel.size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!mdsSaveAttaInf(!!mdsft40)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!mdssavepacks(!!mdsft40)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!mdsft40.store.append(|!!mdsft40.dist.val = $!!mdsft40.dist.val|)
    !!mdsft40.store.append(|Call !!mdsPosDist(!!mdsft40)|)

--<wd>aug2007<mds12>
-- Store the ORIGINAL MDS STRUCTURE and its UDA :MDSTMPLORI setting
    !!mdsft40.store.append(|!!ce = !!mdsft40.support.stru|)
    !!mdsft40.store.append(|!!ce.:mdstmplori = $!mdstmplori |)
--<wd>aug2007<mds12>

    !!mdsft40.store.append(|!!mdsSetSteel.size.select('RTEXT', '$!size')|)
    !!mdsft40.store.append(|!!mdsft40.dim1.val = $!!mdsft40.dim1.val|)
    !!mdsft40.store.append(|!!mdsft40.dim2.val = $!!mdsft40.dim2.val|)
    !!mdsft40.store.append(|!!mdsft40.dim3.val = $!!mdsft40.dim3.val|)
    !!mdsft40.store.append(|!!mdsft40.dim4.val = $!!mdsft40.dim4.val|)

------------------------------******* Connexions ****** --------------------
--

------------------------------------------------------------------------

  -- Store support object
    !!mdsft40.backup = !!mdsft40.support

-- End function
endfunction
