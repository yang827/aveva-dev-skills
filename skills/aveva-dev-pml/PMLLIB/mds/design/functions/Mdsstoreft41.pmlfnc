--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsStoreFt41()

  -- Initialise variables
    !!mdsFt41.Store.clear()
    -- Required option gadgets
    -- !Size = !!mdsFt41.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')
    !Cap  = !!mdsFt41.Cap.selection('RTEXT')

-- Store original atta despars, orientation
    !!mdsSaveAttaInf(!!mdsFt41)

  -- Store relavent gadget information
    !!mdsFt41.Store.append(|!!mdsFt41.Dist.val = $!!mdsFt41.Dist.val|)
    !!mdsFt41.Store.append(|Call !!mdsPosDist(!!mdsFt41)|)
    !!mdsFt41.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!mdsFt41.Store.append(|!!mdsFt41.Cap.select('RTEXT', '$!Cap')|)
    !!mdsFt41.Store.append(|!!mdsFt41.Dim1.val = $!!mdsFt41.Dim1.val|)

  -- Store support object
    !!mdsFt41.Backup = !!mdsFt41.Support

-- End function
endfunction

-- End of file mdsstoreft41.pml
