--
-- File: Mdsstoreft42.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: I.Osborne
-- Created: Wed Jul 02
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsStoreFt42()

  -- Initialise variables
    !!mdsft42.store.clear()

--<wd>aug2007<mds12>
-- Store the MDS STRU UDA :MDSTMPLORI setting
    !mdstmplori = !!mdsft42.support.stru.:mdstmplori
--<wd>aug2007<mds12>

    -- Required option gadgets
    -- !size = !!mdsft42.size.selection('RTEXT')
    !size = !!mdsSetSteel.size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!mdsSaveAttaInf(!!mdsft42)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!mdssavepacks(!!mdsft42)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!mdsft42.store.append(|!!mdsft42.dist.val = $!!mdsft42.dist.val|)
    !!mdsft42.store.append(|Call !!mdsPosDist(!!mdsft42)|)

--<wd>aug2007<mds12>
-- Store the ORIGINAL MDS STRUCTURE and its UDA :MDSTMPLORI setting
    !!mdsft42.store.append(|!!ce = !!mdsft42.support.stru|)
    !!mdsft42.store.append(|!!ce.:mdstmplori = $!mdstmplori |)
--<wd>aug2007<mds12>

    !!mdsft42.store.append(|!!mdsSetSteel.size.select('RTEXT', '$!size')|)
    !!mdsft42.store.append(|!!mdsft42.dim1.val = $!!mdsft42.dim1.val|)
    !!mdsft42.store.append(|!!mdsft42.dim2.val = $!!mdsft42.dim2.val|)
    !!mdsft42.store.append(|!!mdsft42.dim3.val = $!!mdsft42.dim3.val|)
    !!mdsft42.store.append(|!!mdsft42.dim4.val = $!!mdsft42.dim4.val|)

------------------------------******* Connexions ****** --------------------
--

------------------------------------------------------------------------

  -- Store support object
    !!mdsft42.backup = !!mdsft42.support

-- End function
endfunction
