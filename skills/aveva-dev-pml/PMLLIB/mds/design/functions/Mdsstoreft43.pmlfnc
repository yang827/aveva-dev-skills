--
-- File:		MdsstoreFt43.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Mon Jun 30
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFt43()

  -- Initialise variables
    !!MdsFt43.Store.clear()
    -- Required option gadgets
    --!Size = !!MdsFt43.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFt43)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!MdsFt43)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!MdsFt43.Store.append(|!!MdsFt43.Dist.val = $!!MdsFt43.Dist.val|)
    !!MdsFt43.Store.append(|Call !!MdsPosDist(!!MdsFt43)|)
    -- !!MdsFt43.Store.append(|!!MdsFt43.Size.select('RTEXT', '$!Size')|)
    !!MdsFt43.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFt43.Store.append(|!!MdsFt43.Dim1.val = $!!MdsFt43.Dim1.val|)
    !!MdsFt43.Store.append(|!!MdsFt43.Dim2.val = $!!MdsFt43.Dim2.val|)
    !!MdsFt43.Store.append(|!!MdsFt43.Dim3.val = $!!MdsFt43.Dim3.val|)

------------------------------******* Connexions ****** --------------------
--$(
if(!!MdsFt43.Support.Joints.unset().not()) then
  !Joints = !!MdsFt43.Support.Joints
   do !Ind indices !Joints
      !Attributes = array()
      !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')

      !!MdsFt43.Store.append(|$!Joints[$!Ind].name|)
      !!MdsFt43.Store.append(|POSL $!Attributes[$!ind][1]|)
      !!MdsFt43.Store.append(|DESP $!Attributes[$!Ind][2]|)
      !!MdsFt43.Store.append(|BANG $!Attributes[$!Ind][3]|)
      !!MdsFt43.Store.append(|SPRE $!Attributes[$!ind][4]|)
      !!MdsFt43.Store.append(|JLIN $!Attributes[$!Ind][5]|)
      !!MdsFt43.Store.append(|CUTP $!Attributes[$!Ind][6]|)
      !!MdsFt43.Store.append(|CUTB $!Attributes[$!Ind][7]|)
   enddo
else
  !!MdsFt43.Store.append(|!!MdsSelectjoints(!!MdsFt43,'DISCONNECT','CANCEL')|)
endif
--$)
------------------------------------------------------------------------

  -- Store support object
    !!MdsFt43.Backup = !!MdsFt43.Support

-- End function
endfunction

-- End of file MdsstoreFt43.pml
