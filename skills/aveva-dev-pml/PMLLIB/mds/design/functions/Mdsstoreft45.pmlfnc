--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFt45()

  -- Initialise variables
    !!MdsFt45.Store.clear()
    -- Required option gadgets
    -- !Size = !!MdsFt45.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

-- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFt45)

  -- Store relavent gadget information
    !!MdsFt45.Store.append(|!!MdsFt45.Dist.val = $!!MdsFt45.Dist.val|)
    !!MdsFt45.Store.append(|Call !!MdsPosDist(!!MdsFt45)|)
    -- !!MdsFt45.Store.append(|!!MdsFt45.Size.select('RTEXT', '$!Size')|)
    !!MdsFt45.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFt45.Store.append(|!!MdsFt45.Dim1.val = $!!MdsFt45.Dim1.val|)


------------------------------******* Connexions ****** --------------------
--$(
    if(!!MdsFT45.Support.Joints.unset().not()) then
      !Joints = !!MdsFT45.Support.Joints
      do !Ind indices !Joints
        !Attributes = array()
        !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
        !!MdsFT45.Store.append(|$!Joints[$!Ind].name|)
        !!MdsFT45.Store.append(|POSL $!Attributes[$!ind][1]|)
        !!MdsFT45.Store.append(|DESP $!Attributes[$!Ind][2]|)
        !!MdsFT45.Store.append(|BANG $!Attributes[$!Ind][3]|)
        !!MdsFT45.Store.append(|SPRE $!Attributes[$!ind][4]|)
        !!MdsFT45.Store.append(|JLIN $!Attributes[$!Ind][5]|)
        !!MdsFT45.Store.append(|CUTP $!Attributes[$!Ind][6]|)
        !!MdsFT45.Store.append(|CUTB $!Attributes[$!Ind][7]|)
      enddo
    else
      !!MdsFT45.Store.append(|!!MdsSelectjoints(!!MdsFT45,'DISCONNECT','')|)
    endif
--$)
------------------------------------------------------------------------


  -- Store support object
    !!MdsFt45.Backup = !!MdsFt45.Support

-- End function
endfunction

-- End of file Mdsstoreft45.pml
