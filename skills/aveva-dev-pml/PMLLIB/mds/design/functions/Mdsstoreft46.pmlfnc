--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFt46()

  -- Initialise variables
    !!MdsFt46.Store.clear()
    -- Required option gadgets
    -- !Size = !!MdsFt46.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

-- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFt46)

  -- Store relavent gadget information
    !!MdsFt46.Store.append(|!!MdsFt46.Dist.val = $!!MdsFt46.Dist.val|)
    !!MdsFt46.Store.append(|Call !!MdsPosDist(!!MdsFt46)|)
    -- !!MdsFt46.Store.append(|!!MdsFt46.Size.select('RTEXT', '$!Size')|)
    !!MdsFt46.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFt46.Store.append(|!!MdsFt46.Dim1.val = $!!MdsFt46.Dim1.val|)


------------------------------******* Connexions ****** --------------------
--$(
    if(!!MdsFT46.Support.Joints.unset().not()) then
      !Joints = !!MdsFT46.Support.Joints
      do !Ind indices !Joints
        !Attributes = array()
        !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
        !!MdsFT46.Store.append(|$!Joints[$!Ind].name|)
        !!MdsFT46.Store.append(|POSL $!Attributes[$!ind][1]|)
        !!MdsFT46.Store.append(|DESP $!Attributes[$!Ind][2]|)
        !!MdsFT46.Store.append(|BANG $!Attributes[$!Ind][3]|)
        !!MdsFT46.Store.append(|SPRE $!Attributes[$!ind][4]|)
        !!MdsFT46.Store.append(|JLIN $!Attributes[$!Ind][5]|)
        !!MdsFT46.Store.append(|CUTP $!Attributes[$!Ind][6]|)
        !!MdsFT46.Store.append(|CUTB $!Attributes[$!Ind][7]|)
      enddo
    else
      !!MdsFT46.Store.append(|!!MdsSelectjoints(!!MdsFT46,'DISCONNECT','')|)
    endif
--$)
------------------------------------------------------------------------


  -- Store support object
    !!MdsFt46.Backup = !!MdsFt46.Support

-- End function
endfunction

-- End of file Mdsstoreft46.pml
