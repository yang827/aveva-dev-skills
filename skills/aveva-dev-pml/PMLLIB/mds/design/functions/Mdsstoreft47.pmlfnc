-- Created:		Mon Aug 04
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFT47()

-- Initialise variables
    !!MdsFT47.Store.clear()
-- Required option gadgets
    !Size = !!MdsSetSteel.Size.selection('RTEXT')


-- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFT47)

  -- Store relavent gadget information
    !!MdsFT47.Store.append(|!!MdsFT47.Dist.val = $!!MdsFT47.Dist.val|)
    !!MdsFT47.Store.append(|Call !!MdsPosDist(!!MdsFT47)|)
    !!MdsFT47.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFT47.Store.append(|!!MdsFT47.Dim1.val = $!!MdsFT47.Dim1.val|)


------------------------------******* Connexions ****** --------------------
--$(
    if(!!MdsFT47.Support.Joints.unset().not()) then
      !Joints = !!MdsFT47.Support.Joints
      do !Ind indices !Joints
        !Attributes = array()
        !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
        !!MdsFT47.Store.append(|$!Joints[$!Ind].name|)
        !!MdsFT47.Store.append(|POSL $!Attributes[$!ind][1]|)
        !!MdsFT47.Store.append(|DESP $!Attributes[$!Ind][2]|)
        !!MdsFT47.Store.append(|BANG $!Attributes[$!Ind][3]|)
        !!MdsFT47.Store.append(|SPRE $!Attributes[$!ind][4]|)
        !!MdsFT47.Store.append(|JLIN $!Attributes[$!Ind][5]|)
        !!MdsFT47.Store.append(|CUTP $!Attributes[$!Ind][6]|)
        !!MdsFT47.Store.append(|CUTB $!Attributes[$!Ind][7]|)
      enddo
    else
      !!MdsFT47.Store.append(|!!MdsSelectjoints(!!MdsFT47,'DISCONNECT','')|)
    endif
--$)
------------------------------------------------------------------------


  -- Store support object
    !!MdsFT47.Backup = !!MdsFT47.Support

-- End function
endfunction

-- End of file MdsstoreFT47.pml
