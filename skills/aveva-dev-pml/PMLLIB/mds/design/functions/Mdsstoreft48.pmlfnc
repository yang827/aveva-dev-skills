-- Created:		Mon Aug 04
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFT48()

  -- Initialise variables
    !!MdsFT48.Store.clear()
    -- Required option gadgets
    -- !Size = !!MdsFT48.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

-- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFT48)

  -- Store relavent gadget information
    !!MdsFT48.Store.append(|!!MdsFT48.Dist.val = $!!MdsFT48.Dist.val|)
    !!MdsFT48.Store.append(|Call !!MdsPosDist(!!MdsFT48)|)
    -- !!MdsFT48.Store.append(|!!MdsFT48.Size.select('RTEXT', '$!Size')|)
    !!MdsFT48.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFT48.Store.append(|!!MdsFT48.Dim1.val = $!!MdsFT48.Dim1.val|)
    !!MdsFT48.Store.append(|!!MdsFT48.Dim2.val = $!!MdsFT48.Dim2.val|)
    !!MdsFT48.Store.append(|!!MdsFT48.Dim3.val = $!!MdsFT48.Dim3.val|)


------------------------------******* Connexions ****** --------------------
--$(
    if(!!MdsFT48.Support.Joints.unset().not()) then
      !Joints = !!MdsFT48.Support.Joints
      do !Ind indices !Joints
        !Attributes = array()
        !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
        !!MdsFT48.Store.append(|$!Joints[$!Ind].name|)
        !!MdsFT48.Store.append(|POSL $!Attributes[$!ind][1]|)
        !!MdsFT48.Store.append(|DESP $!Attributes[$!Ind][2]|)
        !!MdsFT48.Store.append(|BANG $!Attributes[$!Ind][3]|)
        !!MdsFT48.Store.append(|SPRE $!Attributes[$!ind][4]|)
        !!MdsFT48.Store.append(|JLIN $!Attributes[$!Ind][5]|)
        !!MdsFT48.Store.append(|CUTP $!Attributes[$!Ind][6]|)
        !!MdsFT48.Store.append(|CUTB $!Attributes[$!Ind][7]|)
      enddo
    else
      !!MdsFT48.Store.append(|!!MdsSelectjoints(!!MdsFT48,'DISCONNECT','')|)
    endif
--$)
------------------------------------------------------------------------


  -- Store support object
    !!MdsFT48.Backup = !!MdsFT48.Support

-- End function
endfunction

-- End of file MdsstoreFT48.pml
