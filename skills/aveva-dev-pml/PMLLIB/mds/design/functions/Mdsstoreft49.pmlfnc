-- Created:		Wed Jul 02
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFT49()

  -- Initialise variables
    !!MdsFT49.Store.clear()
    -- Required option gadgets
    -- !Size = !!MdsFT49.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFT49)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!MdsFT49)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!MdsFT49.Store.append(|!!MdsFT49.Dist.val = $!!MdsFT49.Dist.val|)
    !!MdsFT49.Store.append(|Call !!MdsPosDist(!!MdsFT49)|)
    !!MdsFT49.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFT49.Store.append(|!!MdsFT49.Dim1.val = $!!MdsFT49.Dim1.val|)
    !!MdsFT49.Store.append(|!!MdsFT49.Dim2.val = $!!MdsFT49.Dim2.val|)

------------------------------******* Connexions ****** --------------------
--$(
if(!!MdsFT49.Support.Joints.unset().not()) then

  !Joints = !!MdsFT49.Support.Joints
   do !Ind indices !Joints
      !Attributes = array()
      !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')

      !!MdsFT49.Store.append(|$!Joints[$!Ind].name|)
      !!MdsFT49.Store.append(|POSL $!Attributes[$!ind][1]|)
      !!MdsFT49.Store.append(|DESP $!Attributes[$!Ind][2]|)
      !!MdsFT49.Store.append(|BANG $!Attributes[$!Ind][3]|)
      !!MdsFT49.Store.append(|SPRE $!Attributes[$!ind][4]|)
      !!MdsFT49.Store.append(|JLIN $!Attributes[$!Ind][5]|)
      !!MdsFT49.Store.append(|CUTP $!Attributes[$!Ind][6]|)
      !!MdsFT49.Store.append(|CUTB $!Attributes[$!Ind][7]|)

   enddo
else
  -- !!MdsFT49.Store.append(|!!MdsSelectjoints(!!MdsFT49,'DISCONNECT','')|)
endif
--$)
------------------------------------------------------------------------

  -- Store support object
    !!MdsFT49.Backup = !!MdsFT49.Support


-- End function
endfunction

-- End of file MdsstoreFT49.pml
