--
-- File:		Mdsstoreft51.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Mon Jun 30
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreft51()

  -- Initialise variables
    !!Mdsft51.Store.clear()
    -- Required option gadgets
    --!Size = !!Mdsft51.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!Mdsft51)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!Mdsft51)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!Mdsft51.Store.append(|!!Mdsft51.Dist.val = $!!Mdsft51.Dist.val|)
    !!Mdsft51.Store.append(|Call !!MdsPosDist(!!Mdsft51)|)
    -- !!Mdsft51.Store.append(|!!Mdsft51.Size.select('RTEXT', '$!Size')|)
    !!Mdsft51.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!Mdsft51.Store.append(|!!Mdsft51.Dim1.val = $!!Mdsft51.Dim1.val|)
    !!Mdsft51.Store.append(|!!Mdsft51.Dim2.val = $!!Mdsft51.Dim2.val|)
    !!Mdsft51.Store.append(|!!Mdsft51.Dim3.val = $!!Mdsft51.Dim3.val|)
    !!Mdsft51.Store.append(|!!Mdsft51.Dim4.val = $!!Mdsft51.Dim4.val|)

------------------------------******* Connexions ****** --------------------
--$(
if(!!Mdsft51.Support.Joints.unset().not()) then
  !Joints = !!Mdsft51.Support.Joints
   do !Ind indices !Joints
      !Attributes = array()
      !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')

      !!Mdsft51.Store.append(|$!Joints[$!Ind].name|)
      !!Mdsft51.Store.append(|POSL $!Attributes[$!ind][1]|)
      !!Mdsft51.Store.append(|DESP $!Attributes[$!Ind][2]|)
      !!Mdsft51.Store.append(|BANG $!Attributes[$!Ind][3]|)
      !!Mdsft51.Store.append(|SPRE $!Attributes[$!ind][4]|)
      !!Mdsft51.Store.append(|JLIN $!Attributes[$!Ind][5]|)
      !!Mdsft51.Store.append(|CUTP $!Attributes[$!Ind][6]|)
      !!Mdsft51.Store.append(|CUTB $!Attributes[$!Ind][7]|)
   enddo
else
  !!Mdsft51.Store.append(|!!MdsSelectjoints(!!Mdsft51,'DISCONNECT','CANCEL')|)
endif
--$)
------------------------------------------------------------------------

  -- Store support object
    !!Mdsft51.Backup = !!Mdsft51.Support

-- End function
endfunction

-- End of file Mdsstoreft51.pml
