--
-- File: Mdsstoreft52.pmlfnc
--   Type :Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword:MDS
--   Module:DESIGN
--   Replaces:
--
-- Author: I.Osborne
-- Created: Wed Jul 02
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsStoreFT52()

  -- Initialise variables
  !!mdsft52.store.clear()

  --<wd>aug2007<mds12>
  -- Store the MDS STRU UDA :MDSTMPLORI setting
  !mdstmplori = !!mdsft52.support.stru.:mdstmplori
  --<wd>aug2007<mds12>

  -- Required option gadgets
  -- !size = !!mdsft52.size.selection('RTEXT')
  !size = !!mdssetsteel.size.selection('RTEXT')

  -- Store original atta despars, orientation
  !!mdsSaveAttaInf(!!mdsft52)

  ----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
  !!mdssavepacks(!!mdsft52)

  ----------------------------------------------------------------------------

  -- Store relevant gadget information
  !!mdsft52.store.append(|!!mdsft52.dist.val = $!!mdsft52.dist.val|)
  !!mdsft52.store.append(|Call !!mdsPosDist(!!mdsft52)|)

  --<wd>aug2007<mds12>
  -- Store the ORIGINAL MDS STRUCTURE and its UDA :MDSTMPLORI setting
  !!mdsft52.store.append(|!!ce = !!mdsft52.support.stru|)
  !!mdsft52.store.append(|!!ce.:mdstmplori = $!mdstmplori |)
  --<wd>aug2007<mds12>

  !!mdsft52.store.append(|!!mdssetsteel.size.select('RTEXT', '$!size')|)
  !!mdsft52.store.append(|!!mdsft52.dim1.val = $!!mdsft52.dim1.val|)
  !!mdsft52.store.append(|!!mdsft52.dim2.val = $!!mdsft52.dim2.val|)
  !!mdsft52.store.append(|!!mdsft52.dim3.val = $!!mdsft52.dim3.val|)
  !!mdsft52.store.append(|!!mdsft52.dim4.val = $!!mdsft52.dim4.val|)

  ------------------------------******* Connexions ****** --------------------

  -- Store support object
  !!mdsft52.backup = !!mdsft52.support

endfunction
