--
-- File:		MdsstoreFT55C.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Thu Jul 03
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFT55C()

  -- Initialise variables
    !!MdsFT55C.Store.clear()
    -- Required option gadgets
    -- !Size = !!MdsFT55C.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsFT55C)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!MdsFT55C)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!MdsFT55C.Store.append(|!!MdsFT55C.Dist.val = $!!MdsFT55C.Dist.val|)
    !!MdsFT55C.Store.append(|Call !!MdsPosDist(!!MdsFT55C)|)
    !!MdsFT55C.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsFT55C.Store.append(|!!MdsFT55C.Dim1.val = $!!MdsFT55C.Dim1.val|)

------------------------------******* Connexions ****** --------------------

--$(

if(!!MdsFT55C.Support.Joints.unset().not()) then

  !Joints = !!MdsFT55C.Support.Joints
   do !Ind indices !Joints
      !Attributes = array()
      !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')

      !!MdsFT55C.Store.append(|$!Joints[$!Ind].name|)
      !!MdsFT55C.Store.append(|POSL $!Attributes[$!ind][1]|)
      !!MdsFT55C.Store.append(|DESP $!Attributes[$!Ind][2]|)
      !!MdsFT55C.Store.append(|BANG $!Attributes[$!Ind][3]|)
      !!MdsFT55C.Store.append(|SPRE $!Attributes[$!ind][4]|)
      !!MdsFT55C.Store.append(|JLIN $!Attributes[$!Ind][5]|)
      !!MdsFT55C.Store.append(|CUTP $!Attributes[$!Ind][6]|)
      !!MdsFT55C.Store.append(|CUTB $!Attributes[$!Ind][7]|)

   enddo
else
  !!MdsFT55C.Store.append(|!!MdsSelectjoints(!!MdsFT55C,'DISCONNECT','')|)
endif

--$)

------------------------------------------------------------------------

  -- Store support object
    !!MdsFT55C.Backup = !!MdsFT55C.Support

-- End function
endfunction

-- End of file MdsstoreFT55C.pml
