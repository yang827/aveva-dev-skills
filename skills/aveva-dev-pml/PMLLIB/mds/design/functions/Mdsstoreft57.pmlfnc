-- Created:		Mon Aug 04
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreFT57()

-- Initialise variables
  !!MdsFT57.Store.clear()
-- Required option gadgets
  !Size = !!MdsSetSteel.Size.selection('RTEXT')

-- Store original atta despars, orientation
  !!MdsSaveAttaInf(!!MdsFT57)

-- Store relavent gadget information
  !!MdsFT57.Store.append(|!!MdsFT57.Dist.val = $!!MdsFT57.Dist.val|)
  !!MdsFT57.Store.append(|Call !!MdsPosDist(!!MdsFT57)|)
  !!MdsFT57.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
  !!MdsFT57.Store.append(|!!MdsFT57.Dim1.val = $!!MdsFT57.Dim1.val|)

------------------------------******* Connexions ****** --------------------
--$(
    if(!!MdsFT57.Support.Joints.unset().not()) then
      !Joints = !!MdsFT57.Support.Joints
      do !Ind indices !Joints
        !Attributes = array()
        !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')
        !!MdsFT57.Store.append(|$!Joints[$!Ind].name|)
        !!MdsFT57.Store.append(|POSL $!Attributes[$!ind][1]|)
        !!MdsFT57.Store.append(|DESP $!Attributes[$!Ind][2]|)
        !!MdsFT57.Store.append(|BANG $!Attributes[$!Ind][3]|)
        !!MdsFT57.Store.append(|SPRE $!Attributes[$!ind][4]|)
        !!MdsFT57.Store.append(|JLIN $!Attributes[$!Ind][5]|)
        !!MdsFT57.Store.append(|CUTP $!Attributes[$!Ind][6]|)
        !!MdsFT57.Store.append(|CUTB $!Attributes[$!Ind][7]|)
      enddo
    else
      !!MdsFT57.Store.append(|!!MdsSelectjoints(!!MdsFT57,'DISCONNECT','')|)
    endif
--$)
------------------------------------------------------------------------


  -- Store support object
    !!MdsFT57.Backup = !!MdsFT57.Support

-- End function
endfunction

-- End of file MdsstoreFT57.pml
