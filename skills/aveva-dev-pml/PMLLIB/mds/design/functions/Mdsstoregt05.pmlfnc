-- Created:		Wed Dec 17
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreGt05()

  -- Initialise variables
    !!MdsGt05.Store.clear()
    -- Required option gadgets
    !Size = !!MdsGt05.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsGt05)

  -- Store relavent gadget information
    !!MdsGt05.Store.append(|!!MdsGt05.Dist.val = $!!MdsGt05.Dist.val|)
    !!MdsGt05.Store.append(|Call !!MdsPosDist(!!MdsGt05)|)
    !!MdsGt05.Store.append(|!!MdsGt05.Size.select('RTEXT', '$!Size')|)
    !!MdsGt05.Store.append(|!!MdsGt05.Dim1.val = $!!MdsGt05.Dim1.val|)
------------------------------******* Connexions ****** --------------------
--$(
    if(!!MdsGT05.Support.Joints.unset().not()) then

      !Joints = !!MdsGT05.Support.Joints
      do !Ind indices !Joints
        !Attributes = array()
        !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')

        !!MdsGT05.Store.append(|$!Joints[$!Ind].name|)
        !!MdsGT05.Store.append(|POSL $!Attributes[$!ind][1]|)
        !!MdsGT05.Store.append(|DESP $!Attributes[$!Ind][2]|)
        !!MdsGT05.Store.append(|BANG $!Attributes[$!Ind][3]|)
        !!MdsGT05.Store.append(|SPRE $!Attributes[$!ind][4]|)
        !!MdsGT05.Store.append(|JLIN $!Attributes[$!Ind][5]|)
        !!MdsGT05.Store.append(|CUTP $!Attributes[$!Ind][6]|)
        !!MdsGT05.Store.append(|CUTB $!Attributes[$!Ind][7]|)
      enddo
    else
      !!MdsGT05.Store.append(|!!MdsSelectjoints(!!MdsGT05,'DISCONNECT','')|)
    endif
--$)
------------------------------------------------------------------------


  -- Store support object
    !!MdsGt05.Backup = !!MdsGt05.Support

-- End function
endfunction

-- End of file Mdsstoregt05.pml
