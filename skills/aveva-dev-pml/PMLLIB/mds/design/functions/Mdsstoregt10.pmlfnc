--
-- File:		MdsstoreGt10.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Mon Jun 30
--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreGt10()

  -- Initialise variables
    !!MdsGt10.Store.clear()
    -- Required option gadgets
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsGt10)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!MdsGt10)

----------------------------------------------------------------------------

  -- Store relavent gadget information
    !!MdsGt10.Store.append(|!!MdsGt10.Dist.val = $!!MdsGt10.Dist.val|)
    !!MdsGt10.Store.append(|Call !!MdsPosDist(!!MdsGt10)|)
    !!MdsGt10.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsGt10.Store.append(|!!MdsGt10.Dim1.val = $!!MdsGt10.Dim1.val|)
    !!MdsGt10.Store.append(|!!MdsGt10.Dim2.val = $!!MdsGt10.Dim2.val|)
    !!MdsGt10.Store.append(|!!MdsGt10.Dim3.val = $!!MdsGt10.Dim3.val|)
    !!MdsGt10.Store.append(|!!MdsGt10.Dim4.val = $!!MdsGt10.Dim4.val|)

------------------------------******* Connexions ****** --------------------
if(!!MdsGt10.Support.Joints.unset().not()) then
  !Joints = !!MdsGt10.Support.Joints
   do !Ind indices !Joints
      !Attributes = array()
      !HaveJoints = !!KRestoreJoints(!Joints,!Attributes,'SAVE','')

      !!MdsGt10.Store.append(|$!Joints[$!Ind].name|)
      !!MdsGt10.Store.append(|POSL $!Attributes[$!ind][1]|)
      !!MdsGt10.Store.append(|DESP $!Attributes[$!Ind][2]|)
      !!MdsGt10.Store.append(|BANG $!Attributes[$!Ind][3]|)
      !!MdsGt10.Store.append(|SPRE $!Attributes[$!ind][4]|)
      !!MdsGt10.Store.append(|JLIN $!Attributes[$!Ind][5]|)
      !!MdsGt10.Store.append(|CUTP $!Attributes[$!Ind][6]|)
      !!MdsGt10.Store.append(|CUTB $!Attributes[$!Ind][7]|)
   enddo
else
  !!MdsGt10.Store.append(|!!MdsSelectjoints(!!MdsGt10,'DISCONNECT','CANCEL')|)
endif
------------------------------------------------------------------------

  -- Store support object
    !!MdsGt10.Backup = !!MdsGt10.Support

-- End function
endfunction

-- End of file MdsstoreGt10.pml
