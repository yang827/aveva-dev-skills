--
--
-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreHt03(!Mode is STRING)

  -- Initialise variables
    !!MdsHt03.Store.clear()

  -- Store relavent gadget information
    !!MdsHt03.Store.append(|!!MdsHt03.Dist.val = $!!MdsHt03.Dist.val|)
    !!MdsHt03.Store.append(|Call !!MdsPosDist(!!MdsHt03)|)
    if (!mode eq 'MODIFY') then
      !Spref = !!CE.spref
      !!MdsHt03.Store.append(|SPREF $!SPREF|)
    endif

  -- Store support object
    !!MdsHt03.Backup = !!MdsHt03.Support

-- End function
endfunction

-- End of file Mdsstoreft03.pml
