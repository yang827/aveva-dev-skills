-- Define Function
define function !!MdsStorelt04()

  -- Initialise variables
    !!Mdslt04.Store.clear()

  -- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdslt04)

  -- Store relavent gadget information
    !!Mdslt04.Store.append(|!!Mdslt04.Dist.val = $!!Mdslt04.Dist.val|)
    !!Mdslt04.Store.append(|Call !!MdsPosDist(!!Mdslt04)|)

  -- Store support object
    !!Mdslt04.Backup = !!Mdslt04.Support

-- End function
endfunction

-- End of file Mdsstorelt04.pmlfnc
