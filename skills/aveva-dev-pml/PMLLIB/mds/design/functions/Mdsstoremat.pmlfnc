-- Created:		Thu Nov 16 2000
--
--
-- Description:
-- Stores the current material settings of the sections
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        Form          Passed form
-- Return:
--    [Data Type]   [Description]
--     array         returned material values
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreMat(!Name is STRING) is ARRAY

  !MDSFixNum = FALSE
  !Store = Array()

  var !Sctns coll all sctn for $!Name

  do !SetMat values !Sctns
     !Matref.delete()
       handle (2,751)
       endhandle
     !SctnName = !SetMat.dbref().Name
     !Mat = !SetMat.dbref().Matr
     !SpoolNum = !SetMat.dbref().:MDSSpool
     if !Mat.badref() then
       !Matref = !SetMat.dbref().Matr
     else
       !Matref = !SetMat.dbref().Matr.Name
     endif
     !MDSPosNum = !SetMat.dbref().:MDSPosNum
     handle ANY
     elsehandle NONE
       if !mdsposnum.size().gt(0) then
         !Store.Append('$!SctnName MATR $!MatRef :MDSSpool |$!SpoolNum|')
         !store.Append('$!SctnName :mdsposnum $!mdsposnum[1]')
         !MDSFixNum = TRUE
       endif
     endhandle
  enddo

  if !MDSFixNum then
    var !Pjois coll all pjoi for $!Name
    do !Pjoival values !Pjois
      !PjoiName  = !Pjoival.dbref().name
      !MDSPosNum = !PjoiVal.dbref().:MDSPosNum
      if !mdsposnum.size().gt(0) and !mdsposnum[1].unset().not() then
        !store.Append('$!PjoiName :mdsposnum $!mdsposnum[1]')
      endif
    enddo
  endif
  return !Store

-- End function
endfunction

