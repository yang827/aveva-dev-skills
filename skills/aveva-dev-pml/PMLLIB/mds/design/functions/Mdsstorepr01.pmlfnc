--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStorePr01()

-- Initialise variables

  !!MdsPr01.Store.clear()

-- Store original atta despars, orientation

  !!Mdssaveattainf(!!MdsPr01)

-- Store relavent gadget information

  !!MdsPr01.Store.append(|!!MdsPr01.Dist.val = $!!MdsPr01.Dist.val|)
  !!MdsPr01.Store.append(|Call !!MdsPosDist(!!MdsPr01)|)

-- Store support object

  !!MdsPr01.Backup = !!MdsPr01.Support

-- End function
endfunction

-- End of file Mdsstorepr01.pmlfnc
