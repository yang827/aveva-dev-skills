-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreRt01()

  -- Initialise variables
    !!MdsRt01.Store.clear()

  -- Store original atta despars, orientation
    !!Mdssaveattainf(!!MdsRt01)

  -- Store relavent gadget information
    !!MdsRt01.Store.append(|!!MdsRt01.Dist.val = $!!MdsRt01.Dist.val|)
    !!MdsRt01.Store.append(|Call !!MdsPosDist(!!MdsRt01)|)

  -- Store support object
    !!MdsRt01.Backup = !!MdsRt01.Support

-- End function
endfunction

-- End of file MdsstoreRt01.pml
