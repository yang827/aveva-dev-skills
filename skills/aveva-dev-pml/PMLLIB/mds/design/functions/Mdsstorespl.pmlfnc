-- Description:
-- Store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreSpl()

  -- Initialise variables
    !!MdsSpecial.Store.clear()
    -- Required option gadgets

  -- Store original atta despars, orientation
    !!MdsSaveAttaInf(!!MdsSpecial)

----------------------------------------------------------------------------
  -- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!MdsSpecial)

----------------------------------------------------------------------------

  -- Store relavent gadget information
-- Gadget value for - !!Mdsspecial.dist - changed to REAL from STRING
-- Wayne Dodwell - 11june1998
--    !!MdsSpecial.Store.append(|!!MdsSpecial.Dist.val = '$!!MdsSpecial.Dist.val'|)
    !!MdsSpecial.Store.append(|!!MdsSpecial.Dist.val = $!!MdsSpecial.Dist.val|)
    !!MdsSpecial.Store.append(|Call !!MdsPosDist(!!MdsSpecial)|)

  -- Store support object
    !!MdsSpecial.Backup = !!MdsSpecial.Support

-- End function
endfunction

-- End of file Mdsstorespl.pml
