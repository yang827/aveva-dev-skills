-- Define Function
define function !!MdsStoreSt03()

  -- Initialise variables
    !!MdsSt03.Store.clear()

  -- Store relavent gadget information
    !!MdsSt03.Store.append(|!!MdsSt03.Dist.val = $!!MdsSt03.Dist.val|)
    !!MdsSt03.Store.append(|Call !!MdsPosDist(!!MdsSt03)|)

  -- Store support object
    !!MdsSt03.Backup = !!MdsSt03.Support

-- End function
endfunction

