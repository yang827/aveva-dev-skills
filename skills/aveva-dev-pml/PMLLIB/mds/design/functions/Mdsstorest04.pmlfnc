--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreSt04()

  -- Initialise variables
    !!MdsSt04.Store.clear()

  -- Store relavent gadget information
    !!MdsSt04.Store.append(|!!MdsSt04.Dist.val = $!!MdsSt04.Dist.val|)
    !!MdsSt04.Store.append(|Call !!MdsPosDist(!!MdsSt04)|)

  -- Store support object
    !!MdsSt04.Backup = !!MdsSt04.Support

-- End function
endfunction

-- End of file Mdsstorest04.pml
