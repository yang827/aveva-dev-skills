--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreSt08()

  -- Initialise variables
    !!MdsSt08.Store.clear()

  -- Store relavent gadget information
    !!MdsSt08.Store.append(|!!MdsSt08.Dist.val = $!!MdsSt08.Dist.val|)
    !!MdsSt08.Store.append(|Call !!MdsPosDist(!!MdsSt08)|)

  -- Store support object
    !!MdsSt08.Backup = !!MdsSt08.Support

-- End function
endfunction

-- End of file Mdsstorest08.pml
