--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreST24()

  -- Initialise variables
    !!MdsST24.Store.clear()

  -- Store relavent gadget information
    !!MdsST24.Store.append(|!!MdsST24.Dist.val = $!!MdsST24.Dist.val|)
    !!MdsST24.Store.append(|Call !!MdsPosDist(!!MdsST24)|)

  -- Store support object
    !!MdsST24.Backup = !!MdsST24.Support

-- End function
endfunction

-- End of file MdsstoreST24.pml
