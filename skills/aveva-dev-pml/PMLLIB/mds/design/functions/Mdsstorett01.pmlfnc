-- Description:
-- Store form '!!Mdstt01' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett01()

-- Initialise variables
    !!Mdstt01.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt01)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt01)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt01.store.append(|!!Mdstt01.dist.val = $!!Mdstt01.dist.val|)
    !!Mdstt01.store.append(|call !!Mdsposdonly(!!Mdstt01)|)
    !!Mdstt01.store.append(|!!Mdstt01.length.val = $!!Mdstt01.length.val|)
    !!Mdstt01.store.append(|!!Mdstt01.plate.val = $!!Mdstt01.plate.val|)
    !!Mdstt01.store.append(|!!Mdstt01.clear.val = $!!Mdstt01.clear.val|)
    !!Mdstt01.store.append(|!!Mdstt01.material.select('rtext','$!!Mdstt01.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt01.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt01.support.datum)|)
    !!Mdstt01.store.append(|!!MdsSetTrnMatl(!!Mdstt01,!!Mdstt01.support.datum)|)
--< Modified - <wd> - 15sep1998
-- Store support object
    !!Mdstt01.backup = !!Mdstt01.support

  endfunction
-- End function

-- End of file Mdsstorett01.pml
