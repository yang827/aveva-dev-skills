--
--
-- Description:
-- Store form '!!Mdstt02' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett02()

-- Initialise variables
    !!Mdstt02.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt02)

-- Store relavent gadget information
    !!Mdstt02.store.append(|!!Mdstt02.length.val = $!!Mdstt02.length.val|)

-- Store original elbo and atta order, and atta arrive and leave data
    !!ce    = !!Mdstt02.elboref
    !epldir = pl dir wrt /*
    !elstu  = lstu
    !!ce    = !!Mdstt02.support.datum
    !apldir = pl dir wrt /*
    !arrive = arrive
    !leave  = leave
    !where  = 'after'
    !to     = ''
    !p12dir = p12 dir wrt /*

--xxx    if (!!Mdstt02.support.datum.stype.match('TT02-C').eq(1)) then
      if(!epldir neq !apldir) then
        !where = 'before'
        !to    = 'to next'
      endif
--xxx    endif

    !!Mdstt02.store.append(|!!ce = !!Mdstt02.support.datum.owner|)
    !!Mdstt02.store.append(|reorder $!!Mdstt02.support.datum $!where $!!Mdstt02.elboref|)
    !!Mdstt02.store.append(|!!ce = !!Mdstt02.support.datum|)
    !!Mdstt02.store.append(|!!Mdstt02.support.datum.:MDSSref $!!Mdstt02.elboref|)
    !!Mdstt02.store.append(|!!ce = !!Mdstt02.support.datum|)
    !!Mdstt02.store.append(|fconn $!to|)
    !!Mdstt02.store.append(|arrive $!arrive leave $!leave|)
    !!Mdstt02.store.append(|ori and p12 is $!p12dir|)
    !!Mdstt02.store.append(|!!ce = !!Mdstt02.elboref|)
    !!Mdstt02.store.append(|lstu $!elstu|)
    !!Mdstt02.store.append(|!!ce = !!Mdstt02.support.datum|)
    !!Mdstt02.store.append(|!!Mdstt02.material.select('rtext','$!!Mdstt02.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt02.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt02.support.datum)|)
    !!Mdstt02.store.append(|!!MdsSetTrnMatl(!!Mdstt02,!!Mdstt02.support.datum)|)
--< Modified - <wd> - 15sep1998


-- Store support object
    !!Mdstt02.backup = !!Mdstt02.support

  endfunction
-- End function

-- End of file Mdsstorett02.pml
