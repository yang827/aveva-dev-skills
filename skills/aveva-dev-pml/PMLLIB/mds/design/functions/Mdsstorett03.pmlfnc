-- Description:
-- Store form '!!Mdstt03' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett03()

-- Initialise variables
    !!Mdstt03.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt03)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt03)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt03.store.append(|!!Mdstt03.dist.val = $!!Mdstt03.dist.val|)
    !!Mdstt03.store.append(|call !!Mdsposdonly(!!Mdstt03)|)
    !!Mdstt03.store.append(|!!Mdstt03.length.val = $!!Mdstt03.length.val|)
    !!Mdstt03.store.append(|!!Mdstt03.plate.val = $!!Mdstt03.plate.val|)
    !!Mdstt03.store.append(|!!Mdstt03.clear.val = $!!Mdstt03.clear.val|)
    !!Mdstt03.store.append(|!!Mdstt03.material.select('rtext','$!!Mdstt03.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt03.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt03.support.datum)|)
    !!Mdstt03.store.append(|!!MdsSetTrnMatl(!!Mdstt03,!!Mdstt03.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt03.backup = !!Mdstt03.support

  endfunction
-- End function

-- End of file Mdsstorett03.pml
