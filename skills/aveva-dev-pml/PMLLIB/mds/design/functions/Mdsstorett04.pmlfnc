--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett04()

-- Initialise variables
    !!Mdstt04.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt04)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt04)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt04.store.append(|!!Mdstt04.dist.val = $!!Mdstt04.dist.val|)
    !!Mdstt04.store.append(|call !!Mdsposdonly(!!Mdstt04)|)
    !!Mdstt04.store.append(|!!Mdstt04.length.val = $!!Mdstt04.length.val|)
    !!Mdstt04.store.append(|!!Mdstt04.plate.val = $!!Mdstt04.plate.val|)
    !!Mdstt04.store.append(|!!Mdstt04.clear.val = $!!Mdstt04.clear.val|)
    !!Mdstt04.store.append(|!!Mdstt04.material.select('rtext','$!!Mdstt04.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt04.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt04.support.datum)|)
    !!Mdstt04.store.append(|!!MdsSetTrnMatl(!!Mdstt04,!!Mdstt04.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt04.backup = !!Mdstt04.support

  endfunction
-- End function

-- End of file Mdsstorett04.pml
