-- Description:
-- Store form '!!Mdstt05' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett05()

-- Initialise variables
    !!Mdstt05.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt05)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt05)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt05.store.append(|!!Mdstt05.dist.val = $!!Mdstt05.dist.val|)
    !!Mdstt05.store.append(|call !!Mdsposdonly(!!Mdstt05)|)
    !!Mdstt05.store.append(|!!Mdstt05.length.val = $!!Mdstt05.length.val|)
    !!Mdstt05.store.append(|!!Mdstt05.plate.val = $!!Mdstt05.plate.val|)
    !!Mdstt05.store.append(|!!Mdstt05.clear.val = $!!Mdstt05.clear.val|)
    !!Mdstt05.store.append(|!!Mdstt05.material.select('rtext','$!!Mdstt05.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt05.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt05.support.datum)|)
    !!Mdstt05.store.append(|!!MdsSetTrnMatl(!!Mdstt05,!!Mdstt05.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt05.backup = !!Mdstt05.support

  endfunction
-- End function

-- End of file Mdsstorett05.pml
