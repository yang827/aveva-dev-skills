-- Description:
-- Store form '!!Mdstt06' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett06()

-- Initialise variables
    !!Mdstt06.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt06)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt06)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt06.store.append(|!!Mdstt06.dist.val = $!!Mdstt06.dist.val|)
    !!Mdstt06.store.append(|call !!Mdsposdonly(!!Mdstt06)|)
    !!Mdstt06.store.append(|!!Mdstt06.length.val = $!!Mdstt06.length.val|)
    !!Mdstt06.store.append(|!!Mdstt06.plate.val = $!!Mdstt06.plate.val|)
    !!Mdstt06.store.append(|!!Mdstt06.clear.val = $!!Mdstt06.clear.val|)
    !!Mdstt06.store.append(|!!Mdstt06.material.select('rtext','$!!Mdstt06.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt06.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt06.support.datum)|)
    !!Mdstt06.store.append(|!!MdsSetTrnMatl(!!Mdstt06,!!Mdstt06.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt06.backup = !!Mdstt06.support

  endfunction
-- End function

-- End of file Mdsstorett06.pml
