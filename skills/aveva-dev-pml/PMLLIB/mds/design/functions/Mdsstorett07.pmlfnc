-- Description:
-- Store form '!!Mdstt07' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett07()

-- Initialise variables
    !!Mdstt07.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt07)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt07)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt07.store.append(|!!Mdstt07.dist.val = $!!Mdstt07.dist.val|)
    !!Mdstt07.store.append(|call !!Mdsposdonly(!!Mdstt07)|)
    !!Mdstt07.store.append(|!!Mdstt07.length.val = $!!Mdstt07.length.val|)
    !!Mdstt07.store.append(|!!Mdstt07.plate.val = $!!Mdstt07.plate.val|)
    !!Mdstt07.store.append(|!!Mdstt07.clear.val = $!!Mdstt07.clear.val|)
    !!Mdstt07.store.append(|!!Mdstt07.material.select('rtext','$!!Mdstt07.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt07.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt07.support.datum)|)
    !!Mdstt07.store.append(|!!MdsSetTrnMatl(!!Mdstt07,!!Mdstt07.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt07.backup = !!Mdstt07.support

  endfunction
-- End function

-- End of file Mdsstorett07.pml
