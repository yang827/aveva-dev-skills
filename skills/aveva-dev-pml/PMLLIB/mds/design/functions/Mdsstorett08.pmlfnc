-- Description:
-- Store form '!!Mdstt08' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett08()

-- Initialise variables
    !!Mdstt08.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt08)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt08)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt08.store.append(|!!Mdstt08.dist.val = $!!Mdstt08.dist.val|)
    !!Mdstt08.store.append(|call !!Mdsposdonly(!!Mdstt08)|)
    !!Mdstt08.store.append(|!!Mdstt08.length.val = $!!Mdstt08.length.val|)
    !!Mdstt08.store.append(|!!Mdstt08.plate.val = $!!Mdstt08.plate.val|)
    !!Mdstt08.store.append(|!!Mdstt08.clear.val = $!!Mdstt08.clear.val|)
    !!Mdstt08.store.append(|!!Mdstt08.material.select('rtext','$!!Mdstt08.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt08.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt08.support.datum)|)
    !!Mdstt08.store.append(|!!MdsSetTrnMatl(!!Mdstt08,!!Mdstt08.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt08.backup = !!Mdstt08.support

  endfunction
-- End function

-- End of file Mdsstorett08.pml
