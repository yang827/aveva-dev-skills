--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett09()

-- Initialise variables
    !!Mdstt09.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt09)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt09)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt09.store.append(|!!Mdstt09.dist.val = $!!Mdstt09.dist.val|)
    !!Mdstt09.store.append(|call !!Mdsposdonly(!!Mdstt09)|)
    !!Mdstt09.store.append(|!!Mdstt09.length.val = $!!Mdstt09.length.val|)
    !!Mdstt09.store.append(|!!Mdstt09.plate.val = $!!Mdstt09.plate.val|)
    !!Mdstt09.store.append(|!!Mdstt09.clear.val = $!!Mdstt09.clear.val|)
    !!Mdstt09.store.append(|!!Mdstt09.material.select('rtext','$!!Mdstt09.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt09.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt09.support.datum)|)
    !!Mdstt09.store.append(|!!MdsSetTrnMatl(!!Mdstt09,!!Mdstt09.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt09.backup = !!Mdstt09.support

  endfunction
-- End function

-- End of file Mdsstorett09.pml
