-- Description:
-- Store form '!!Mdstt10' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett10()

-- Initialise variables
    !!Mdstt10.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt10)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt10)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt10.store.append(|!!Mdstt10.dist.val = $!!Mdstt10.dist.val|)
    !!Mdstt10.store.append(|call !!Mdsposdonly(!!Mdstt10)|)
    !!Mdstt10.store.append(|!!Mdstt10.length.val = $!!Mdstt10.length.val|)
    !!Mdstt10.store.append(|!!Mdstt10.plate.val = $!!Mdstt10.plate.val|)
    !!Mdstt10.store.append(|!!Mdstt10.clear.val = $!!Mdstt10.clear.val|)
    !!Mdstt10.store.append(|!!Mdstt10.material.select('rtext','$!!Mdstt10.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt10.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt10.support.datum)|)
    !!Mdstt10.store.append(|!!MdsSetTrnMatl(!!Mdstt10,!!Mdstt10.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt10.backup = !!Mdstt10.support

  endfunction
-- End function

-- End of file Mdsstorett10.pml
