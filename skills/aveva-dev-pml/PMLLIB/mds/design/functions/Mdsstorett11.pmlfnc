-- Description:
-- Store form '!!Mdstt11' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett11()

-- Initialise variables
    !!Mdstt11.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt11)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt11)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt11.store.append(|!!Mdstt11.dist.val = $!!Mdstt11.dist.val|)
    !!Mdstt11.store.append(|call !!Mdsposdonly(!!Mdstt11)|)
    !!Mdstt11.store.append(|!!Mdstt11.length.val = $!!Mdstt11.length.val|)
    !!Mdstt11.store.append(|!!Mdstt11.plate.val = $!!Mdstt11.plate.val|)
    !!Mdstt11.store.append(|!!Mdstt11.clear.val = $!!Mdstt11.clear.val|)
    !!Mdstt11.store.append(|!!Mdstt11.material.select('rtext','$!!Mdstt11.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt11.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt11.support.datum)|)
    !!Mdstt11.store.append(|!!MdsSetTrnMatl(!!Mdstt11,!!Mdstt11.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt11.backup = !!Mdstt11.support

  endfunction
-- End function

-- End of file Mdsstorett11.pml
