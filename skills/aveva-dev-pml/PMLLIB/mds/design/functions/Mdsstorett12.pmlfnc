-- Description:
-- Store form '!!Mdstt12' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett12()

-- Initialise variables
    !!Mdstt12.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt12)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt12)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt12.store.append(|!!Mdstt12.dist.val = $!!Mdstt12.dist.val|)
    !!Mdstt12.store.append(|call !!Mdsposdonly(!!Mdstt12)|)
    !!Mdstt12.store.append(|!!Mdstt12.length.val = $!!Mdstt12.length.val|)
    !!Mdstt12.store.append(|!!Mdstt12.plate.val = $!!Mdstt12.plate.val|)
    !!Mdstt12.store.append(|!!Mdstt12.clear.val = $!!Mdstt12.clear.val|)
    !!Mdstt12.store.append(|!!Mdstt12.material.select('rtext','$!!Mdstt12.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt12.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt12.support.datum)|)
    !!Mdstt12.store.append(|!!MdsSetTrnMatl(!!Mdstt12,!!Mdstt12.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt12.backup = !!Mdstt12.support

  endfunction
-- End function

-- End of file Mdsstorett12.pml
