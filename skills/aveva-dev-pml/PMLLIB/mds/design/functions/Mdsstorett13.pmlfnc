-- Description:
-- Store form '!!Mdstt13' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett13()

-- Initialise variables
    !!Mdstt13.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt13)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt13)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt13.store.append(|!!Mdstt13.dist.val = $!!Mdstt13.dist.val|)
    !!Mdstt13.store.append(|call !!Mdsposdonly(!!Mdstt13)|)
    !!Mdstt13.store.append(|!!Mdstt13.length.val = $!!Mdstt13.length.val|)
    !!Mdstt13.store.append(|!!Mdstt13.plate.val = $!!Mdstt13.plate.val|)
    !!Mdstt13.store.append(|!!Mdstt13.clear.val = $!!Mdstt13.clear.val|)
    !!Mdstt13.store.append(|!!Mdstt13.material.select('rtext','$!!Mdstt13.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt13.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt13.support.datum)|)
    !!Mdstt13.store.append(|!!MdsSetTrnMatl(!!Mdstt13,!!Mdstt13.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt13.backup = !!Mdstt13.support

  endfunction
-- End function

-- End of file Mdsstorett13.pml
