-- Description:
-- Store form '!!Mdstt14' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett14()

-- Initialise variables
    !!Mdstt14.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt14)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt14)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt14.store.append(|!!Mdstt14.dist.val = $!!Mdstt14.dist.val|)
    !!Mdstt14.store.append(|call !!Mdsposdonly(!!Mdstt14)|)
    !!Mdstt14.store.append(|!!Mdstt14.length.val = $!!Mdstt14.length.val|)
    !!Mdstt14.store.append(|!!Mdstt14.plate.val = $!!Mdstt14.plate.val|)
    !!Mdstt14.store.append(|!!Mdstt14.clear.val = $!!Mdstt14.clear.val|)
    !!Mdstt14.store.append(|!!Mdstt14.material.select('rtext','$!!Mdstt14.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt14.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt14.support.datum)|)
    !!Mdstt14.store.append(|!!MdsSetTrnMatl(!!Mdstt14,!!Mdstt14.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt14.backup = !!Mdstt14.support

  endfunction
-- End function

-- End of file Mdsstorett14.pml
