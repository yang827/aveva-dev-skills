--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsstoreTT15()

-- Initialise variables
    !!MdsTT15.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!MdsTT15)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!MdsTT15)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!MdsTT15.store.append(|!!MdsTT15.dist.val = $!!MdsTT15.dist.val|)
    !!MdsTT15.store.append(|call !!Mdsposdonly(!!MdsTT15)|)
    !!MdsTT15.store.append(|!!MdsTT15.length.val = $!!MdsTT15.length.val|)
    !!MdsTT15.store.append(|!!MdsTT15.plate.val = $!!MdsTT15.plate.val|)
    !!MdsTT15.store.append(|!!MdsTT15.clear.val = $!!MdsTT15.clear.val|)
    !!MdsTT15.store.append(|!!MdsTT15.material.select('rtext','$!!MdsTT15.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!MdsTT15.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!MdsTT15.support.datum)|)
    !!MdsTT15.store.append(|!!MdsSetTrnMatl(!!MdsTT15,!!MdsTT15.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!MdsTT15.backup = !!MdsTT15.support

  endfunction
-- End function

-- End of file MdsstoreTT15.pml
