-- Description:
-- Store form '!!MdsTT16' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsstoreTT16()

-- Initialise variables
    !!MdsTT16.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!MdsTT16)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!MdsTT16)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!MdsTT16.store.append(|!!MdsTT16.dist.val = $!!MdsTT16.dist.val|)
    !!MdsTT16.store.append(|call !!Mdsposdonly(!!MdsTT16)|)
    !!MdsTT16.store.append(|!!MdsTT16.length.val = $!!MdsTT16.length.val|)
    !!MdsTT16.store.append(|!!MdsTT16.plate.val = $!!MdsTT16.plate.val|)
    !!MdsTT16.store.append(|!!MdsTT16.clear.val = $!!MdsTT16.clear.val|)
    !!MdsTT16.store.append(|!!MdsTT16.material.select('rtext','$!!MdsTT16.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!MdsTT16.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!MdsTT16.support.datum)|)
    !!MdsTT16.store.append(|!!MdsSetTrnMatl(!!MdsTT16,!!MdsTT16.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!MdsTT16.backup = !!MdsTT16.support

  endfunction
-- End function

-- End of file MdsstoreTT16.pml
