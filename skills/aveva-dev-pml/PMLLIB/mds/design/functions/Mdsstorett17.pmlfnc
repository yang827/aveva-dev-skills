--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsstoreTT17()

-- Initialise variables
    !!MdsTT17.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!MdsTT17)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!MdsTT17)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!MdsTT17.store.append(|!!MdsTT17.dist.val = $!!MdsTT17.dist.val|)
    !!MdsTT17.store.append(|call !!Mdsposdonly(!!MdsTT17)|)
    !!MdsTT17.store.append(|!!MdsTT17.length.val = $!!MdsTT17.length.val|)
    !!MdsTT17.store.append(|!!MdsTT17.plate.val = $!!MdsTT17.plate.val|)
    !!MdsTT17.store.append(|!!MdsTT17.clear.val = $!!MdsTT17.clear.val|)
    !!MdsTT17.store.append(|!!MdsTT17.material.select('rtext','$!!MdsTT17.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!MdsTT17.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!MdsTT17.support.datum)|)
    !!MdsTT17.store.append(|!!MdsSetTrnMatl(!!MdsTT17,!!MdsTT17.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!MdsTT17.backup = !!MdsTT17.support

  endfunction
-- End function

-- End of file MdsstoreTT17.pml
