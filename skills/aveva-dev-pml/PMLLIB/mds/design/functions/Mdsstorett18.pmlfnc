--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett18()

-- Initialise variables
    !!Mdstt18.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt18)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt18)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt18.store.append(|!!Mdstt18.dist.val = $!!Mdstt18.dist.val|)
    !!Mdstt18.store.append(|call !!Mdsposdonly(!!Mdstt18)|)
    !!Mdstt18.store.append(|!!Mdstt18.length.val = $!!Mdstt18.length.val|)
    !!Mdstt18.store.append(|!!Mdstt18.plate.val = $!!Mdstt18.plate.val|)
    !!Mdstt18.store.append(|!!Mdstt18.clear.val = $!!Mdstt18.clear.val|)
    !!Mdstt18.store.append(|!!Mdstt18.material.select('rtext','$!!Mdstt18.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt18.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt18.support.datum)|)
    !!Mdstt18.store.append(|!!MdsSetTrnMatl(!!Mdstt18,!!Mdstt18.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt18.backup = !!Mdstt18.support

  endfunction
-- End function

-- End of file Mdsstorett18.pml
