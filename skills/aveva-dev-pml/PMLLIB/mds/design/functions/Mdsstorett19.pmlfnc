-- Description:
-- Store form '!!Mdstt19' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett19()

-- Initialise variables
    !!Mdstt19.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt19)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt19)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt19.store.append(|!!Mdstt19.dist.val = $!!Mdstt19.dist.val|)
    !!Mdstt19.store.append(|call !!Mdsposdonly(!!Mdstt19)|)
    !!Mdstt19.store.append(|!!Mdstt19.length.val = $!!Mdstt19.length.val|)
    !!Mdstt19.store.append(|!!Mdstt19.plate.val = $!!Mdstt19.plate.val|)
    !!Mdstt19.store.append(|!!Mdstt19.clear.val = $!!Mdstt19.clear.val|)
    !!Mdstt19.store.append(|!!Mdstt19.material.select('rtext','$!!Mdstt19.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt19.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt19.support.datum)|)
    !!Mdstt19.store.append(|!!MdsSetTrnMatl(!!Mdstt19,!!Mdstt19.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt19.backup = !!Mdstt19.support

  endfunction
-- End function

-- End of file Mdsstorett19.pml
