-- Description:
-- Store form '!!Mdstt20' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett20()

-- Initialise variables
    !!Mdstt20.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt20)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt20)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt20.store.append(|!!Mdstt20.dist.val = $!!Mdstt20.dist.val|)
    !!Mdstt20.store.append(|call !!Mdsposdonly(!!Mdstt20)|)
    !!Mdstt20.store.append(|!!Mdstt20.length.val = $!!Mdstt20.length.val|)
    !!Mdstt20.store.append(|!!Mdstt20.plate.val = $!!Mdstt20.plate.val|)
    !!Mdstt20.store.append(|!!Mdstt20.clear.val = $!!Mdstt20.clear.val|)
    !!Mdstt20.store.append(|!!Mdstt20.material.select('rtext','$!!Mdstt20.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt20.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt20.support.datum)|)
    !!Mdstt20.store.append(|!!MdsSetTrnMatl(!!Mdstt20,!!Mdstt20.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt20.backup = !!Mdstt20.support

  endfunction
-- End function

-- End of file Mdsstorett20.pml
