-- Description:
-- Store form '!!Mdstt21' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett21()

-- Initialise variables
    !!Mdstt21.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt21)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt21)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt21.store.append(|!!Mdstt21.dist.val = $!!Mdstt21.dist.val|)
    !!Mdstt21.store.append(|call !!Mdsposdonly(!!Mdstt21)|)
    !!Mdstt21.store.append(|!!Mdstt21.length.val = $!!Mdstt21.length.val|)
    !!Mdstt21.store.append(|!!Mdstt21.plate.val = $!!Mdstt21.plate.val|)
    !!Mdstt21.store.append(|!!Mdstt21.clear.val = $!!Mdstt21.clear.val|)
    !!Mdstt21.store.append(|!!Mdstt21.material.select('rtext','$!!Mdstt21.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt21.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt21.support.datum)|)
    !!Mdstt21.store.append(|!!MdsSetTrnMatl(!!Mdstt21,!!Mdstt21.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt21.backup = !!Mdstt21.support

  endfunction
-- End function

-- End of file Mdsstorett21.pml
