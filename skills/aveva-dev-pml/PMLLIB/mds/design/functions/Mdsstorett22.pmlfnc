--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsstoreTT22()

-- Initialise variables
    !!MdsTT22.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!MdsTT22)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!MdsTT22)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!MdsTT22.store.append(|!!MdsTT22.dist.val = $!!MdsTT22.dist.val|)
    !!MdsTT22.store.append(|call !!Mdsposdonly(!!MdsTT22)|)
    !!MdsTT22.store.append(|!!MdsTT22.length.val = $!!MdsTT22.length.val|)
    !!MdsTT22.store.append(|!!MdsTT22.plate.val = $!!MdsTT22.plate.val|)
    !!MdsTT22.store.append(|!!MdsTT22.clear.val = $!!MdsTT22.clear.val|)
    !!MdsTT22.store.append(|!!MdsTT22.material.select('rtext','$!!MdsTT22.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!MdsTT22.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!MdsTT22.support.datum)|)
    !!MdsTT22.store.append(|!!MdsSetTrnMatl(!!MdsTT22,!!MdsTT22.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!MdsTT22.backup = !!MdsTT22.support

  endfunction
-- End function

-- End of file MdsstoreTT22.pml
