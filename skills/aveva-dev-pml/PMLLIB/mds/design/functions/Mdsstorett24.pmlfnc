--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsstoreTT24()

-- Initialise variables
    !!MdsTT24.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!MdsTT24)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!MdsTT24)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!MdsTT24.store.append(|!!MdsTT24.dist.val = $!!MdsTT24.dist.val|)
    !!MdsTT24.store.append(|call !!Mdsposdonly(!!MdsTT24)|)
    !!MdsTT24.store.append(|!!MdsTT24.length.val = $!!MdsTT24.length.val|)
    !!MdsTT24.store.append(|!!MdsTT24.plate.val = $!!MdsTT24.plate.val|)
    !!MdsTT24.store.append(|!!MdsTT24.clear.val = $!!MdsTT24.clear.val|)
    !!MdsTT24.store.append(|!!MdsTT24.material.select('rtext','$!!MdsTT24.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!MdsTT24.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!MdsTT24.support.datum)|)
    !!MdsTT24.store.append(|!!MdsSetTrnMatl(!!MdsTT24,!!MdsTT24.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!MdsTT24.backup = !!MdsTT24.support

  endfunction
-- End function

-- End of file MdsstoreTT24.pml
