--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsstoreTT25()

-- Initialise variables
    !!MdsTT25.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!MdsTT25)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!MdsTT25)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!MdsTT25.store.append(|!!MdsTT25.dist.val = $!!MdsTT25.dist.val|)
    !!MdsTT25.store.append(|call !!Mdsposdonly(!!MdsTT25)|)
    !!MdsTT25.store.append(|!!MdsTT25.length.val = $!!MdsTT25.length.val|)
    !!MdsTT25.store.append(|!!MdsTT25.plate.val = $!!MdsTT25.plate.val|)
    !!MdsTT25.store.append(|!!MdsTT25.clear.val = $!!MdsTT25.clear.val|)
    !!MdsTT25.store.append(|!!MdsTT25.material.select('rtext','$!!MdsTT25.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!MdsTT25.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!MdsTT25.support.datum)|)
    !!MdsTT25.store.append(|!!MdsSetTrnMatl(!!MdsTT25,!!MdsTT25.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!MdsTT25.backup = !!MdsTT25.support

  endfunction
-- End function

-- End of file MdsstoreTT25.pml
