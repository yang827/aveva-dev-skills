-- Description:
-- Store form '!!Mdstt26' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett26()

-- Initialise variables
    !!Mdstt26.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt26)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt26)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt26.store.append(|!!Mdstt26.dist.val = $!!Mdstt26.dist.val|)
    !!Mdstt26.store.append(|call !!Mdsposdonly(!!Mdstt26)|)
    !!Mdstt26.store.append(|!!Mdstt26.length.val = $!!Mdstt26.length.val|)
    !!Mdstt26.store.append(|!!Mdstt26.plate.val = $!!Mdstt26.plate.val|)
    !!Mdstt26.store.append(|!!Mdstt26.clear.val = $!!Mdstt26.clear.val|)
    !!Mdstt26.store.append(|!!Mdstt26.material.select('rtext','$!!Mdstt26.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt26.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt26.support.datum)|)
    !!Mdstt26.store.append(|!!MdsSetTrnMatl(!!Mdstt26,!!Mdstt26.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt26.backup = !!Mdstt26.support

  endfunction
-- End function

-- End of file Mdsstorett26.pml
