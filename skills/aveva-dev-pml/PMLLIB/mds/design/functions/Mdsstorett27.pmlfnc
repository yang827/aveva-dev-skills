--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett27()

-- Initialise variables
    !!Mdstt27.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt27)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt27)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt27.store.append(|!!Mdstt27.dist.val = $!!Mdstt27.dist.val|)
    !!Mdstt27.store.append(|call !!Mdsposdonly(!!Mdstt27)|)
    !!Mdstt27.store.append(|!!Mdstt27.length.val = $!!Mdstt27.length.val|)
    !!Mdstt27.store.append(|!!Mdstt27.plate.val = $!!Mdstt27.plate.val|)
    !!Mdstt27.store.append(|!!Mdstt27.clear.val = $!!Mdstt27.clear.val|)
    !!Mdstt27.store.append(|!!Mdstt27.material.select('rtext','$!!Mdstt27.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt27.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt27.support.datum)|)
    !!Mdstt27.store.append(|!!MdsSetTrnMatl(!!Mdstt27,!!Mdstt27.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt27.backup = !!Mdstt27.support

  endfunction
-- End function

-- End of file Mdsstorett27.pml
