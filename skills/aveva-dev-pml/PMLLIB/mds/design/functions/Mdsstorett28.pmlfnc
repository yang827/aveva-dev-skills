--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett28()

-- Initialise variables
    !!Mdstt28.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt28)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt28)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt28.store.append(|!!Mdstt28.dist.val = $!!Mdstt28.dist.val|)
    !!Mdstt28.store.append(|call !!Mdsposdonly(!!Mdstt28)|)
    !!Mdstt28.store.append(|!!Mdstt28.length.val = $!!Mdstt28.length.val|)
    !!Mdstt28.store.append(|!!Mdstt28.plate.val = $!!Mdstt28.plate.val|)
    !!Mdstt28.store.append(|!!Mdstt28.clear.val = $!!Mdstt28.clear.val|)
    !!Mdstt28.store.append(|!!Mdstt28.material.select('rtext','$!!Mdstt28.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt28.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt28.support.datum)|)
    !!Mdstt28.store.append(|!!MdsSetTrnMatl(!!Mdstt28,!!Mdstt28.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt28.backup = !!Mdstt28.support

  endfunction
-- End function

-- End of file Mdsstorett28.pml
