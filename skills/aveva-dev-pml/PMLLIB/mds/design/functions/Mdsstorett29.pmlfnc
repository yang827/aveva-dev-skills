-- Description:
-- Store form '!!Mdstt29' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett29()

-- Initialise variables
    !!Mdstt29.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt29)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt29)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt29.store.append(|!!Mdstt29.dist.val = $!!Mdstt29.dist.val|)
    !!Mdstt29.store.append(|call !!Mdsposdonly(!!Mdstt29)|)
    !!Mdstt29.store.append(|!!Mdstt29.length.val = $!!Mdstt29.length.val|)
    !!Mdstt29.store.append(|!!Mdstt29.plate.val = $!!Mdstt29.plate.val|)
    !!Mdstt29.store.append(|!!Mdstt29.clear.val = $!!Mdstt29.clear.val|)
    !!Mdstt29.store.append(|!!Mdstt29.material.select('rtext','$!!Mdstt29.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt29.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt29.support.datum)|)
    !!Mdstt29.store.append(|!!MdsSetTrnMatl(!!Mdstt29,!!Mdstt29.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt29.backup = !!Mdstt29.support

  endfunction
-- End function

-- End of file Mdsstorett29.pml
