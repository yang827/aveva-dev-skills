--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett30()

-- Initialise variables
    !!Mdstt30.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt30)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt30)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt30.store.append(|!!Mdstt30.dist.val = $!!Mdstt30.dist.val|)
    !!Mdstt30.store.append(|call !!Mdsposdonly(!!Mdstt30)|)
    !!Mdstt30.store.append(|!!Mdstt30.length.val = $!!Mdstt30.length.val|)
    !!Mdstt30.store.append(|!!Mdstt30.plate.val = $!!Mdstt30.plate.val|)
    !!Mdstt30.store.append(|!!Mdstt30.clear.val = $!!Mdstt30.clear.val|)
    !!Mdstt30.store.append(|!!Mdstt30.material.select('rtext','$!!Mdstt30.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt30.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt30.support.datum)|)
    !!Mdstt30.store.append(|!!MdsSetTrnMatl(!!Mdstt30,!!Mdstt30.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt30.backup = !!Mdstt30.support

  endfunction
-- End function

-- End of file Mdsstorett30.pml
