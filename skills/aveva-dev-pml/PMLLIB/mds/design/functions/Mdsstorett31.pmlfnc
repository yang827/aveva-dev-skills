--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsstoreTT31()

-- Initialise variables
    !!MdsTT31.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!MdsTT31)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!MdsTT31)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!MdsTT31.store.append(|!!MdsTT31.dist.val = $!!MdsTT31.dist.val|)
    !!MdsTT31.store.append(|call !!Mdsposdonly(!!MdsTT31)|)
    !!MdsTT31.store.append(|!!MdsTT31.length.val = $!!MdsTT31.length.val|)
    !!MdsTT31.store.append(|!!MdsTT31.plate.val = $!!MdsTT31.plate.val|)
    !!MdsTT31.store.append(|!!MdsTT31.clear.val = $!!MdsTT31.clear.val|)
    !!MdsTT31.store.append(|!!MdsTT31.material.select('rtext','$!!MdsTT31.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!MdsTT31.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!MdsTT31.support.datum)|)
    !!MdsTT31.store.append(|!!MdsSetTrnMatl(!!MdsTT31,!!MdsTT31.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!MdsTT31.backup = !!MdsTT31.support

  endfunction
-- End function

-- End of file MdsstoreTT31.pml
