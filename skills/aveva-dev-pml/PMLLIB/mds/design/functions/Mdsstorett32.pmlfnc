-- Description:
-- Store form '!!MdsTT32' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsstoreTT32()

-- Initialise variables
    !!MdsTT32.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!MdsTT32)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!MdsTT32)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!MdsTT32.store.append(|!!MdsTT32.dist.val = $!!MdsTT32.dist.val|)
    !!MdsTT32.store.append(|call !!Mdsposdonly(!!MdsTT32)|)
    !!MdsTT32.store.append(|!!MdsTT32.length.val = $!!MdsTT32.length.val|)
    !!MdsTT32.store.append(|!!MdsTT32.plate.val = $!!MdsTT32.plate.val|)
    !!MdsTT32.store.append(|!!MdsTT32.clear.val = $!!MdsTT32.clear.val|)
    !!MdsTT32.store.append(|!!MdsTT32.material.select('rtext','$!!MdsTT32.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!MdsTT32.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!MdsTT32.support.datum)|)
    !!MdsTT32.store.append(|!!MdsSetTrnMatl(!!MdsTT32,!!MdsTT32.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!MdsTT32.backup = !!MdsTT32.support

  endfunction
-- End function

-- End of file MdsstoreTT32.pml
