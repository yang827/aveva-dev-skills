--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsstoreTT33()

-- Initialise variables
    !!MdsTT33.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!MdsTT33)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!MdsTT33)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!MdsTT33.store.append(|!!MdsTT33.dist.val = $!!MdsTT33.dist.val|)
    !!MdsTT33.store.append(|call !!Mdsposdonly(!!MdsTT33)|)
    !!MdsTT33.store.append(|!!MdsTT33.length.val = $!!MdsTT33.length.val|)
    !!MdsTT33.store.append(|!!MdsTT33.plate.val = $!!MdsTT33.plate.val|)
    !!MdsTT33.store.append(|!!MdsTT33.clear.val = $!!MdsTT33.clear.val|)
    !!MdsTT33.store.append(|!!MdsTT33.material.select('rtext','$!!MdsTT33.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!MdsTT33.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!MdsTT33.support.datum)|)
    !!MdsTT33.store.append(|!!MdsSetTrnMatl(!!MdsTT33,!!MdsTT33.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!MdsTT33.backup = !!MdsTT33.support

  endfunction
-- End function

-- End of file MdsstoreTT33.pml
