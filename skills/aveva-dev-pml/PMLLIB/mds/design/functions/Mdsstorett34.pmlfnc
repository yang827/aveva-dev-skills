-- Description:
-- Store form '!!MdsTT34' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsstoreTT34()

-- Initialise variables
    !!MdsTT34.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!MdsTT34)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!MdsTT34)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!MdsTT34.store.append(|!!MdsTT34.dist.val = $!!MdsTT34.dist.val|)
    !!MdsTT34.store.append(|call !!Mdsposdonly(!!MdsTT34)|)
    !!MdsTT34.store.append(|!!MdsTT34.length.val = $!!MdsTT34.length.val|)
    !!MdsTT34.store.append(|!!MdsTT34.plate.val = $!!MdsTT34.plate.val|)
    !!MdsTT34.store.append(|!!MdsTT34.clear.val = $!!MdsTT34.clear.val|)
    !!MdsTT34.store.append(|!!MdsTT34.material.select('rtext','$!!MdsTT34.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!MdsTT34.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!MdsTT34.support.datum)|)
    !!MdsTT34.store.append(|!!MdsSetTrnMatl(!!MdsTT34,!!MdsTT34.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!MdsTT34.backup = !!MdsTT34.support

  endfunction
-- End function

-- End of file MdsstoreTT34.pml
