-- Description:
-- Store form '!!Mdstt35' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett35()

-- Initialise variables
    !!Mdstt35.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt35)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt35)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt35.store.append(|!!Mdstt35.dist.val = $!!Mdstt35.dist.val|)
    !!Mdstt35.store.append(|call !!Mdsposdonly(!!Mdstt35)|)
    !!Mdstt35.store.append(|!!Mdstt35.length.val = $!!Mdstt35.length.val|)
    !!Mdstt35.store.append(|!!Mdstt35.plate.val = $!!Mdstt35.plate.val|)
    !!Mdstt35.store.append(|!!Mdstt35.clear.val = $!!Mdstt35.clear.val|)
    !!Mdstt35.store.append(|!!Mdstt35.material.select('rtext','$!!Mdstt35.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt35.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt35.support.datum)|)
    !!Mdstt35.store.append(|!!MdsSetTrnMatl(!!Mdstt35,!!Mdstt35.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt35.backup = !!Mdstt35.support

  endfunction
-- End function

-- End of file Mdsstorett35.pml
