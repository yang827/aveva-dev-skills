-- Description:
-- Store form '!!Mdstt36' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett36()

-- Initialise variables
    !!Mdstt36.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt36)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt36)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt36.store.append(|!!Mdstt36.dist.val = $!!Mdstt36.dist.val|)
    !!Mdstt36.store.append(|call !!Mdsposdonly(!!Mdstt36)|)
    !!Mdstt36.store.append(|!!Mdstt36.length.val = $!!Mdstt36.length.val|)
    !!Mdstt36.store.append(|!!Mdstt36.plate.val = $!!Mdstt36.plate.val|)
    !!Mdstt36.store.append(|!!Mdstt36.clear.val = $!!Mdstt36.clear.val|)
    !!Mdstt36.store.append(|!!Mdstt36.material.select('rtext','$!!Mdstt36.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt36.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt36.support.datum)|)
    !!Mdstt36.store.append(|!!MdsSetTrnMatl(!!Mdstt36,!!Mdstt36.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt36.backup = !!Mdstt36.support

  endfunction
-- End function

-- End of file Mdsstorett36.pml
