-- Description:
-- Store form '!!Mdstt37' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett37()

-- Initialise variables
    !!Mdstt37.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt37)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt37)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt37.store.append(|!!Mdstt37.dist.val = $!!Mdstt37.dist.val|)
    !!Mdstt37.store.append(|call !!Mdsposdonly(!!Mdstt37)|)
    !!Mdstt37.store.append(|!!Mdstt37.length.val = $!!Mdstt37.length.val|)
    !!Mdstt37.store.append(|!!Mdstt37.plate.val = $!!Mdstt37.plate.val|)
    !!Mdstt37.store.append(|!!Mdstt37.clear.val = $!!Mdstt37.clear.val|)
    !!Mdstt37.store.append(|!!Mdstt37.material.select('rtext','$!!Mdstt37.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt37.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt37.support.datum)|)
    !!Mdstt37.store.append(|!!MdsSetTrnMatl(!!Mdstt37,!!Mdstt37.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt37.backup = !!Mdstt37.support

  endfunction
-- End function

-- End of file Mdsstorett37.pml
