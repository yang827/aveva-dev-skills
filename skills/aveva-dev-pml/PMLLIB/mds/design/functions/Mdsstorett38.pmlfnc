--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett38()

-- Initialise variables
    !!Mdstt38.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt38)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt38)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt38.store.append(|!!Mdstt38.dist.val = $!!Mdstt38.dist.val|)
    !!Mdstt38.store.append(|call !!Mdsposdonly(!!Mdstt38)|)
    !!Mdstt38.store.append(|!!Mdstt38.length.val = $!!Mdstt38.length.val|)
    !!Mdstt38.store.append(|!!Mdstt38.plate.val = $!!Mdstt38.plate.val|)
    !!Mdstt38.store.append(|!!Mdstt38.clear.val = $!!Mdstt38.clear.val|)
    !!Mdstt38.store.append(|!!Mdstt38.material.select('rtext','$!!Mdstt38.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt38.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt38.support.datum)|)
    !!Mdstt38.store.append(|!!MdsSetTrnMatl(!!Mdstt38,!!Mdstt38.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt38.backup = !!Mdstt38.support

  endfunction
-- End function

-- End of file Mdsstorett38.pml
