--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett39()

-- Initialise variables
    !!Mdstt39.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt39)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt39)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt39.store.append(|!!Mdstt39.dist.val = $!!Mdstt39.dist.val|)
    !!Mdstt39.store.append(|call !!Mdsposdonly(!!Mdstt39)|)
    !!Mdstt39.store.append(|!!Mdstt39.length.val = $!!Mdstt39.length.val|)
    !!Mdstt39.store.append(|!!Mdstt39.plate.val = $!!Mdstt39.plate.val|)
    !!Mdstt39.store.append(|!!Mdstt39.clear.val = $!!Mdstt39.clear.val|)
    !!Mdstt39.store.append(|!!Mdstt39.material.select('rtext','$!!Mdstt39.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt39.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt39.support.datum)|)
    !!Mdstt39.store.append(|!!MdsSetTrnMatl(!!Mdstt39,!!Mdstt39.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt39.backup = !!Mdstt39.support

  endfunction
-- End function

-- End of file Mdsstorett39.pml
