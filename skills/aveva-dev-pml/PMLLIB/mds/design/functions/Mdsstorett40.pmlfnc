-- Description:
-- Store form '!!Mdstt40' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett40()

-- Initialise variables
    !!Mdstt40.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt40)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt40)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt40.store.append(|!!Mdstt40.dist.val = $!!Mdstt40.dist.val|)
    !!Mdstt40.store.append(|call !!Mdsposdonly(!!Mdstt40)|)
    !!Mdstt40.store.append(|!!Mdstt40.length.val = $!!Mdstt40.length.val|)
    !!Mdstt40.store.append(|!!Mdstt40.plate.val = $!!Mdstt40.plate.val|)
    !!Mdstt40.store.append(|!!Mdstt40.clear.val = $!!Mdstt40.clear.val|)
    !!Mdstt40.store.append(|!!Mdstt40.material.select('rtext','$!!Mdstt40.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt40.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt40.support.datum)|)
    !!Mdstt40.store.append(|!!MdsSetTrnMatl(!!Mdstt40,!!Mdstt40.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt40.backup = !!Mdstt40.support

  endfunction
-- End function

-- End of file Mdsstorett40.pml
