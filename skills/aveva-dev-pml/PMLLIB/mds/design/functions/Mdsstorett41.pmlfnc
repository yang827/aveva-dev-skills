-- Description:
-- Store form '!!Mdstt41' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorett41()

-- Initialise variables
    !!Mdstt41.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdstt41)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!Mdstt41)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdstt41.store.append(|!!Mdstt41.dist.val = $!!Mdstt41.dist.val|)
    !!Mdstt41.store.append(|call !!Mdsposdonly(!!Mdstt41)|)
    !!Mdstt41.store.append(|!!Mdstt41.length.val = $!!Mdstt41.length.val|)
    !!Mdstt41.store.append(|!!Mdstt41.plate.val = $!!Mdstt41.plate.val|)
    !!Mdstt41.store.append(|!!Mdstt41.clear.val = $!!Mdstt41.clear.val|)
    !!Mdstt41.store.append(|!!Mdstt41.material.select('rtext','$!!Mdstt41.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdstt41.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdstt41.support.datum)|)
    !!Mdstt41.store.append(|!!MdsSetTrnMatl(!!Mdstt41,!!Mdstt41.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdstt41.backup = !!Mdstt41.support

  endfunction
-- End function

-- End of file Mdsstorett41.pml
