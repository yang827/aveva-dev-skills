-- Define Function
  define function !!Mdsstorevt01()

-- Initialise variables
    !!Mdsvt01.store.clear()
-- Required option gadgets
    -- !size  = !!Mdsvt01.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

-- Store original atta despars, orientation
    !!MdssaveattaInf(!!Mdsvt01)

----------------------------------------------------------------------------
-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!Mdsvt01)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdsvt01.store.append(|!!Mdsvt01.dist.val = $!!Mdsvt01.dist.val|)
    !!Mdsvt01.store.append(|call !!Mdsposdist(!!Mdsvt01)|)
    -- !!Mdsvt01.store.append(|!!Mdsvt01.Size.select('RTEXT', '$!Size')|)
    !!Mdsvt01.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!Mdsvt01.store.append(|!!Mdsvt01.Dim1.val = $!!Mdsvt01.Dim1.val|)
    !!Mdsvt01.store.append(|!!Mdsvt01.Dim2.val = $!!Mdsvt01.Dim2.val|)
    !!Mdsvt01.store.append(|!!Mdsvt01.Dim3.val = $!!Mdsvt01.Dim3.val|)
    --!!Mdsvt01.store.append(|!!Mdsvt01.material.select('rtext','$!!Mdsvt01.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdsvt01.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdsvt01.support.datum)|)
    --!!Mdsvt01.store.append(|!!MdsSetTrnMatl(!!Mdsvt01,!!Mdsvt01.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdsvt01.backup = !!Mdsvt01.support

-- Navigate back to structure store Stru Dbref and Ori
    !!ce = !!Mdsvt01.support.stru
    !!Mdsvt01.store.append(|$!!Mdsvt01.support.stru|)
    !ori = ori wrt /*
    !!Mdsvt01.store.append(|ori $!ori|)
    !stp = pos wrt /*
    !!Mdsvt01.store.append(|at $!stp|)


  endfunction
-- End function

-- End of file Mdsstorevt01.pml
