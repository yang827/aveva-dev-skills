-- Define Function
  define function !!Mdsstorevt02()

-- Initialise variables
    !!Mdsvt02.store.clear()
-- Required option gadgets
    -- !size  = !!Mdsvt02.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

-- Store original atta despars, orientation
    !!MdssaveattaInf(!!Mdsvt02)

----------------------------------------------------------------------------
-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!Mdsvt02)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdsvt02.store.append(|!!Mdsvt02.dist.val = $!!Mdsvt02.dist.val|)
    !!Mdsvt02.store.append(|call !!Mdsposdist(!!Mdsvt02)|)
    -- !!Mdsvt02.store.append(|!!Mdsvt02.Size.select('RTEXT', '$!Size')|)
    !!Mdsvt02.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!Mdsvt02.store.append(|!!Mdsvt02.Dim1.val = $!!Mdsvt02.Dim1.val|)
    !!Mdsvt02.store.append(|!!Mdsvt02.Dim2.val = $!!Mdsvt02.Dim2.val|)
    !!Mdsvt02.store.append(|!!Mdsvt02.Dim3.val = $!!Mdsvt02.Dim3.val|)
    --!!Mdsvt02.store.append(|!!Mdsvt02.material.select('rtext','$!!Mdsvt02.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!Mdsvt02.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!Mdsvt02.support.datum)|)
    --!!Mdsvt02.store.append(|!!MdsSetTrnMatl(!!Mdsvt02,!!Mdsvt02.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!Mdsvt02.backup = !!Mdsvt02.support

-- Navigate back to structure store Stru Dbref and Ori
    !!ce = !!Mdsvt02.support.stru
    !!Mdsvt02.store.append(|$!!Mdsvt02.support.stru|)
    !ori = ori wrt /*
    !!Mdsvt02.store.append(|ori $!ori|)
    !stp = pos wrt /*
    !!Mdsvt02.store.append(|at $!stp|)


  endfunction
-- End function

-- End of file Mdsstorevt02.pml
