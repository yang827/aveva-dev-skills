--
--
-- Description:
-- store form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorevt03()

-- Initialise variables
    !!Mdsvt03.store.clear()
-- Required option gadgets
    -- !size  = !!Mdsvt03.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

-- Store original atta despars, orientation
    !!MdssaveattaInf(!!Mdsvt03)

----------------------------------------------------------------------------
-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!Mdsvt03)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdsvt03.store.append(|!!Mdsvt03.dist.val = $!!Mdsvt03.dist.val|)
    !!Mdsvt03.store.append(|call !!Mdsposdist(!!Mdsvt03)|)
    -- !!Mdsvt03.store.append(|!!Mdsvt03.Size.select('RTEXT', '$!Size')|)
    !!Mdsvt03.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!Mdsvt03.store.append(|!!Mdsvt03.Dim1.val = $!!Mdsvt03.Dim1.val|)
    !!Mdsvt03.store.append(|!!Mdsvt03.Dim2.val = $!!Mdsvt03.Dim2.val|)

-- Store support object
    !!Mdsvt03.backup = !!Mdsvt03.support

-- Navigate back to structure store Stru Dbref and Ori
    !!ce = !!Mdsvt03.support.stru
    !!Mdsvt03.store.append(|$!!Mdsvt03.support.stru|)
    !ori = ori wrt /*
    !!Mdsvt03.store.append(|ori $!ori|)
    !stp = pos wrt /*
    !!Mdsvt03.store.append(|at $!stp|)


  endfunction
-- End function

-- End of file Mdsstorevt03.pml
