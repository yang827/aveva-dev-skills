--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorevt05()

-- Initialise variables
    !!Mdsvt05.store.clear()
-- Required option gadgets
    -- !size  = !!Mdsvt05.Size.selection('RTEXT')
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

-- Store original atta despars, orientation
    !!MdssaveattaInf(!!Mdsvt05)

----------------------------------------------------------------------------
-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
    !!Mdssavepacks(!!Mdsvt05)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdsvt05.store.append(|!!Mdsvt05.dist.val = $!!Mdsvt05.dist.val|)
    !!Mdsvt05.store.append(|call !!Mdsposdist(!!Mdsvt05)|)
    -- !!Mdsvt05.store.append(|!!Mdsvt05.Size.select('RTEXT', '$!Size')|)
    !!Mdsvt05.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!Mdsvt05.store.append(|!!Mdsvt05.Dim1.val = $!!Mdsvt05.Dim1.val|)
    !!Mdsvt05.store.append(|!!Mdsvt05.Dim2.val = $!!Mdsvt05.Dim2.val|)


-- Store support object
    !!Mdsvt05.backup = !!Mdsvt05.support

-- Navigate back to structure store Stru Dbref and Ori
    !!ce = !!Mdsvt05.support.stru
    !!Mdsvt05.store.append(|$!!Mdsvt05.support.stru|)
    !ori = ori wrt /*
    !!Mdsvt05.store.append(|ori $!ori|)
    !stp = pos wrt /*
    !!Mdsvt05.store.append(|at $!stp|)


  endfunction
-- End function

-- End of file Mdsstorevt05.pml
