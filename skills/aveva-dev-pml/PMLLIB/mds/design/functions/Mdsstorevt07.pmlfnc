--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorevt07()

-- Initialise variables
    !!Mdsvt07.store.clear()
-- Required option gadgets
    -- !size  = !!Mdsvt07.Size.selection()
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

-- Store original atta despars, orientation
    !!MdssaveattaInf(!!Mdsvt07)

----------------------------------------------------------------------------
-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--    !!Mdssavepacks(!!Mdsvt07)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdsvt07.store.append(|!!Mdsvt07.dist.val = $!!Mdsvt07.dist.val|)
    !!Mdsvt07.store.append(|call !!Mdsposdist(!!Mdsvt07)|)
    -- !!Mdsvt07.store.append(|!!Mdsvt07.Size.select('RTEXT', '$!Size')|)
    !!Mdsvt07.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!Mdsvt07.store.append(|!!Mdsvt07.Dim1.val = $!!Mdsvt07.Dim1.val|)


-- Store support object
    !!Mdsvt07.backup = !!Mdsvt07.support

-- Navigate back to structure store Stru Dbref and Ori
    !!ce = !!Mdsvt07.support.stru
    !!Mdsvt07.store.append(|$!!Mdsvt07.support.stru|)
    !ori = ori wrt /*
    !!Mdsvt07.store.append(|ori $!ori|)
    !stp = pos wrt /*
    !!Mdsvt07.store.append(|at $!stp|)


  endfunction
-- End function

-- End of file Mdsstorevt07.pml
