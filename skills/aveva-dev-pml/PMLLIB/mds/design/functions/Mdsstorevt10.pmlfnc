--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsstoreVT10()

-- Initialise variables
    !!MdsVT10.store.clear()
-- Required option gadgets
    -- !size  = !!MdsVT10.Size.selection()
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

-- Store original atta despars, orientation
    !!MdssaveattaInf(!!MdsVT10)

----------------------------------------------------------------------------
-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--    !!Mdssavepacks(!!MdsVT10)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!MdsVT10.store.append(|!!MdsVT10.dist.val = $!!MdsVT10.dist.val|)
    !!MdsVT10.store.append(|call !!Mdsposdist(!!MdsVT10)|)
    -- !!MdsVT10.store.append(|!!MdsVT10.Size.select('RTEXT', '$!Size')|)
    !!MdsVT10.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsVT10.store.append(|!!MdsVT10.Dim1.val = $!!MdsVT10.Dim1.val|)
    !!MdsVT10.store.append(|!!MdsVT10.Dim2.val = $!!MdsVT10.Dim2.val|)
    !!MdsVT10.store.append(|!!MdsVT10.Dim3.val = $!!MdsVT10.Dim3.val|)

-- Store support object
    !!MdsVT10.backup = !!MdsVT10.support

-- Navigate back to structure store Stru Dbref and Ori
    !!ce = !!MdsVT10.support.stru
    !!MdsVT10.store.append(|$!!MdsVT10.support.stru|)
    !ori = ori wrt /*
    !!MdsVT10.store.append(|ori $!ori|)
    !stp = pos wrt /*
    !!MdsVT10.store.append(|at $!stp|)

  endfunction
-- End function

-- End of file MdsstoreVT10.pml
