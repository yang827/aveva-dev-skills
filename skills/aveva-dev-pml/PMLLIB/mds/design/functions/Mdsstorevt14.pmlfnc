--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsstoreVT14()

-- Initialise variables
    !!MdsVT14.store.clear()
-- Required option gadgets
    -- !size  = !!MdsVT14.Size.selection()
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

-- Store original atta despars, orientation
    !!MdssaveattaInf(!!MdsVT14)

----------------------------------------------------------------------------
-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--    !!Mdssavepacks(!!MdsVT14)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!MdsVT14.store.append(|!!MdsVT14.dist.val = $!!MdsVT14.dist.val|)
    !!MdsVT14.store.append(|call !!Mdsposdist(!!MdsVT14)|)
    -- !!MdsVT14.store.append(|!!MdsVT14.Size.select('RTEXT', '$!Size')|)
    !!MdsVT14.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!MdsVT14.store.append(|!!MdsVT14.Dim1.val = $!!MdsVT14.Dim1.val|)

-- Store support object
    !!MdsVT14.backup = !!MdsVT14.support

-- Navigate back to structure store Stru Dbref and Ori
    !!ce = !!MdsVT14.support.stru
    !!MdsVT14.store.append(|$!!MdsVT14.support.stru|)
    !ori = ori wrt /*
    !!MdsVT14.store.append(|ori $!ori|)
    !stp = pos wrt /*
    !!MdsVT14.store.append(|at $!stp|)

  endfunction
-- End function

-- End of file MdsstoreVT14.pml
