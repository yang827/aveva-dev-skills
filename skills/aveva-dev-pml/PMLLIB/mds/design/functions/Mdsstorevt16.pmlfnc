-- Description:
-- Store form '!!MdsVT16' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!MdsstoreVT16()

-- Initialise variables
    !!MdsVT16.store.clear()

-- Store original atta despars, orientation
    !!Mdssaveattainf(!!MdsVT16)

----------------------------------------------------------------------------
--xxx-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--xxx    !!Mdssavepacks(!!MdsVT16)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!MdsVT16.store.append(|!!MdsVT16.dist.val = $!!MdsVT16.dist.val|)
    !!MdsVT16.store.append(|!!MdsVT16.dim1.val = $!!MdsVT16.dim1.val|)
    !!MdsVT16.store.append(|call !!Mdsposdonly(!!MdsVT16)|)
    !!MdsVT16.store.append(|!!MdsVT16.material.select('rtext','$!!MdsVT16.material')|)
--> Modified - <wd> - 15sep1998
--xxx    !!MdsVT16.store.append(|!!MdsSetTrnMatl(!!GlobalForm,!!MdsVT16.support.datum)|)
    !!MdsVT16.store.append(|!!MdsSetTrnMatl(!!MdsVT16,!!MdsVT16.support.datum)|)
--< Modified - <wd> - 15sep1998

-- Store support object
    !!MdsVT16.backup = !!MdsVT16.support

  endfunction
-- End function

-- End of file MdsstoreVT16.pml
