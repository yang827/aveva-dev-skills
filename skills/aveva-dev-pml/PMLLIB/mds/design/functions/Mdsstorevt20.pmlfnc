--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorevt20()

-- Initialise variables
    !!Mdsvt20.store.clear()
-- Required option gadgets
    -- !size  = !!Mdsvt20.Size.selection()
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

-- Store original atta despars, orientation
    !!MdssaveattaInf(!!Mdsvt20)

----------------------------------------------------------------------------
-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--    !!Mdssavepacks(!!Mdsvt20)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdsvt20.store.append(|!!Mdsvt20.dist.val = $!!Mdsvt20.dist.val|)
    !!Mdsvt20.store.append(|call !!Mdsposdist(!!Mdsvt20)|)
    -- !!Mdsvt20.store.append(|!!Mdsvt20.Size.select('RTEXT', '$!Size')|)
    !!Mdsvt20.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!Mdsvt20.store.append(|!!Mdsvt20.Dim1.val = $!!Mdsvt20.Dim1.val|)


-- Store support object
    !!Mdsvt20.backup = !!Mdsvt20.support

-- Navigate back to structure store Stru Dbref and Ori
    !!ce = !!Mdsvt20.support.stru
    !!Mdsvt20.store.append(|$!!Mdsvt20.support.stru|)
    !ori = ori wrt /*
    !!Mdsvt20.store.append(|ori $!ori|)
    !stp = pos wrt /*
    !!Mdsvt20.store.append(|at $!stp|)


  endfunction
-- End function

-- End of file Mdsstorevt20.pml
