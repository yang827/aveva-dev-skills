--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsstorevt21()

-- Initialise variables
    !!Mdsvt21.store.clear()
-- Required option gadgets
    -- !size  = !!Mdsvt21.Size.selection()
    !Size = !!MdsSetSteel.Size.selection('RTEXT')

-- Store original atta despars, orientation
    !!MdssaveattaInf(!!Mdsvt21)

----------------------------------------------------------------------------
-- Store original Packing Piece Despars, Spref, :MDSAttaRef etc
--    !!Mdssavepacks(!!Mdsvt21)

----------------------------------------------------------------------------

-- Store relavent gadget information
    !!Mdsvt21.store.append(|!!Mdsvt21.dist.val = $!!Mdsvt21.dist.val|)
    !!Mdsvt21.store.append(|call !!Mdsposdist(!!Mdsvt21)|)
    -- !!Mdsvt21.store.append(|!!Mdsvt21.Size.select('RTEXT', '$!Size')|)
    !!Mdsvt21.Store.append(|!!MdsSetSteel.Size.select('RTEXT', '$!Size')|)
    !!Mdsvt21.store.append(|!!Mdsvt21.Dim1.val = $!!Mdsvt21.Dim1.val|)


-- Store support object
    !!Mdsvt21.backup = !!Mdsvt21.support

-- Navigate back to structure store Stru Dbref and Ori
    !!ce = !!Mdsvt21.support.stru
    !!Mdsvt21.store.append(|$!!Mdsvt21.support.stru|)
    !ori = ori wrt /*
    !!Mdsvt21.store.append(|ori $!ori|)
    !stp = pos wrt /*
    !!Mdsvt21.store.append(|at $!stp|)


  endfunction
-- End function

-- End of file Mdsstorevt21.pml
