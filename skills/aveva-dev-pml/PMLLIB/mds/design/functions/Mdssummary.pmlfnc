if (|$1| eq |PROMPT| or |$1| eq ||) then
   $M/%PDMSUI%/CLIB/REP/RSELECT RUN $0  $<$!!<kmdbdir>/MDS-SUMMARY1-$!!<kdts>$> $<atta stru$> $<(match(name of spref,'/MDS') eq 1) or (:MDSSuppType eq 'FT22')$> $<$> $<Off$> $<$> $<MDB$>
   return
endif
var !filename (trim(|$2|))
var !seltype (trim(|$3|))
var !selfilter (trim(|$4|))
var !selhierarchy (trim(|$5|))
var !selvolspec (trim(|$6|))
var !selvolume (trim(|$7|))
var !selfrom (trim(|$8|))
if(vtext(!seltype) eq ||) then
   var !criteria |ALL|
else
   var !criteria (|ALL (| + vtext(!seltype) + |)|)
endif
if(vtext(!selfilter) ne ||) then
   var !criteria (vtext(!criteria) + | WITH (| + vtext(!selfilter) + | )|)
endif
if(vtext(!selvolspec) eq |Completely Within...|) then
   var !criteria (vtext(!criteria) + | EXCL WITHIN | + vtext(!selvolume))
elseif(vtext(!selvolspec) eq |Partially Within...|) then
   var !criteria (vtext(!criteria) + | WITHIN | + vtext(!selvolume))
endif
if(vtext(!selhierarchy) ne ||) then
   var !criteria (vtext(!criteria) + | FOR | + vtext(!selhierarchy))
endif
if(vtext(!selfrom) eq |Drawlist|) then
   var !criteria (vtext(!criteria) + | FROM DRAWLIST|)
elseif(vtext(!selfrom) eq |Obstruction List|) then
   var !criteria (vtext(!criteria) + | FROM OBST|)
endif
!units = object COMUNITS(TRUE)
units mm bore mm distance
var !date clock date
var !time clock time
if (vtext(!filename) ne ||) then
   openfile /$!filename overwrite length 41 pagecount !pageno !output
   handle (41,324)
      confirm |OK to overwrite $!filename?|
      handle (61,115)
         !units.restoreSavedBoreDist()
         return error 1 'File $!filename exists. Use OVERWRITE mode to force write.'
      endhandle
      if(not $_CALERT_USERDATA) then
         !units.restoreSavedBoreDist()
         return
      endif
      openfile /$!filename overwrite length 41 pagecount !pageno !output
      handle any
         !units.restoreSavedBoreDist()
         return error 1 |Unable to open file $!filename|
      endhandle
   elsehandle any
      !units.restoreSavedBoreDist()
      return error 1 |Unable to open file $!filename|
   endhandle
   var !write |writefile $!output|
else
   var !isshown form _CADCBTH display
   handle any
   elsehandle none
      if(|$!isshown| eq |Off|) then
         show _CADCREQ
      endif
   endhandle
   var !write |write|
endif
onerror golabel /closefile
var !selection collect $!criteria
handle any
   if(vtext(!filename) ne ||) then
      closefile $!output
   endif
   !units.restoreSavedBoreDist()
   return error 1 |Selection is invalid
$!!ERROR.TEXT|
endhandle
var !selsize (arraysize(!selection))
onerror golabel /badeval
var !evalcol 1
var !col1 raw evaluate ((after(namn of spref ,'MDS/'))) for all from !selection count !selno$
 ignore any |FT22|
var !evalcol 2
var !col2 raw evaluate ((after(namn of spref , 'MDS/'))) for all from !selection count !selno$
 ignore any |---|
var !evalcol 3
var !col3 raw evaluate ((replace(:MDSSuppDesc of detref,'!',' '))) for all from !selection count !selno$
 ignore any |BEDPLATE|
var !evalcol 4
-----------------------------------
if (!!isImperialLength('BORE').not()) then
  var !col4 raw evaluate (string((p1 bore),'D0')) for all from !selection count !selno$
  ignore any |---|
else
  var !col4 raw evaluate (DIST (NOMBORE(false,p1 bore),false,true,true,8,false)) for all from !selection count !selno$
  ignore any |---|
endif
-----------------------------------
var !evalcol 5
var !colunf5 raw evaluate (quantity) for all from !selection count !selno$
 ignore any ||
var !col5 raw evaluate (string((quantity),'D0')) for all from !selection count !selno$
 ignore any ||
onerror golabel /closefile
var !sortorder sort !col1 CIASCII ASCENDING LASTINGROUP !lastingroup1 FIRSTINGROUP !firstingroup1 $
 !col3 CIASCII ASCENDING $

var !maxwid[1] 0
var !maxwid[1] (max($!maxwid[1],(arraywidth(!col1))))
var !maxwid[2] 0
var !maxwid[2] (max($!maxwid[2],(arraywidth(!col2))))
var !maxwid[3] 0
var !maxwid[3] (max($!maxwid[3],(arraywidth(!col3))))
var !maxwid[4] 0
var !maxwid[4] (max($!maxwid[4],(arraywidth(!col4))))
var !maxwid[5] 0
var !maxwid[5] (max($!maxwid[5],(arraywidth(!col5))))
var !subtotunf5 subtotal !colunf5 !sortorder !lastingroup1
var !subtotals5 raw evaluate (string((vval(!subtotunf5,vval(!index))),'D0')) indices !subtotunf5 count !index ignore any ''
var !maxwid[5] (max($!maxwid[5],(arraywidth(!subtotals5))))
var !selsize (arraysize(!selection))
var !lastentry delete
var !lastentry[$!selsize] '1'
var !totalunf5 subtotal !colunf5 !sortorder !lastentry
var !total5 raw (string((vval(!totalunf5,vval(!selsize))),'D0'))
var !maxwid[5] (max($!maxwid[5],(dlen(vtext(!total5)))))
$!write ('???----------------------------------------------------------------------------------------------------')
$!write ('???----------------------------------------------------------------------------------------------------')
$!write ('???----------------------------   Multi Discipline Supports Summary Index  -----------------------------')
$!write ('???----------------------------------------------------------------------------------------------------')
$!write ('???----------------------------------------------------------------------------------------------------')
$!write ('???-- Date & Time of Report : $!!<kdts> --')
$!write ('???----------------------------------------------------------')
$!write ('???----------------------------------------------------------')
var !maxwid[1] (max($!maxwid[1],8))
var !maxwid[2] (max($!maxwid[2],10))
var !maxwid[3] (max($!maxwid[3],11))
var !maxwid[4] (max($!maxwid[4],9))
var !maxwid[5] (max($!maxwid[5],8))
--$P*****************************************
-- q var !maxwid[1] (max($!maxwid[1],8))
-- q var !maxwid[2] (max($!maxwid[2],10))
-- q var !maxwid[3] (max($!maxwid[3],11))
-- q var !maxwid[4] (max($!maxwid[4],9))
-- q var !maxwid[5] (max($!maxwid[5],8))

!!kcol1 = 2
!!kcol2 = !!kcol1 + !maxwid[1].real() + 2
!!kcol3 = !!kcol2 + !maxwid[2].real() + 2
!!kcol4 = !!kcol3 + !maxwid[3].real() + 2
!!kcol5 = !!kcol4 + !maxwid[4].real() + 2

--q var !!kcol1 !!kcol2 !!kcol3 !!kcol4 !!kcol5
--$P*****************************************
var !headings compose $
spa 2 |
Standard
--------| wid $!maxwid[1] L $
spa 2 |
Spec. Ref.
----------| wid $!maxwid[2] L $
spa 2 |
Description
-----------| wid $!maxwid[3] L $
spa 2 |
Line Size
---------| wid $!maxwid[4] R $
spa 2 |
Quantity
--------| wid $!maxwid[5] R $

do !line values !headings
   $!write |$!line|
enddo
if (vtext(!filename) ne ||) then
   do !line values !headings
      fileheader $!output add |$!line|
   enddo
endif
do !i indexes !sortorder
   var !index $!sortorder[$!i]
   if(defined(!firstingroup1,$!i)) then
      var !value[1] raw (vtext(!col1,$!index))
   endif
   if( $
      defined(!lastingroup1[$!i]) or $
      false) then
      var !value[2] raw (vtext(!col2,$!index))
      var !value[3] raw (vtext(!col3,$!index))
      var !value[4] raw (vtext(!col4,$!index))
      if(defined(!lastingroup1[$!i]))then
         var !value[5] raw (vtext(!subtotals5,$!i))
      else
         var !value[5] ||
      endif
      var !lines compose $
         spa 2 |$!value[1]| wid $!maxwid[1] L $
         spa 2 |$!value[2]| wid $!maxwid[2] L $
         spa 2 |$!value[3]| wid $!maxwid[3] L $
         spa 2 |$!value[4]| wid $!maxwid[4] R $
         spa 2 |$!value[5]| wid $!maxwid[5] R $

      var !value[1] ||
      do !line values !lines
         $!write |$!line|
      enddo
   endif
enddo
var !lines compose $
   spa 2 spa $!maxwid[1] $
   spa 2 spa $!maxwid[2] $
   spa 2 spa $!maxwid[3] $
   spa 2 spa $!maxwid[4] $
   spa 2 (substr(|=====================|,1,$!maxwid[5])) wid $!maxwid[5] R $

do !line values !lines
   $!write |$!line|
enddo
var !lines compose $
   spa 2 spa $!maxwid[1] $
   spa 2 spa $!maxwid[2] $
   spa 2 spa $!maxwid[3] $
   spa 2 spa $!maxwid[4] $
   spa 2 (vtext(!total5)) wid $!maxwid[5] R $

do !line values !lines
   $!write |$!line|
enddo
if (vtext(!filename) ne ||) then
   fileheader $!output clear
endif
$!write ('???')
$!write ('???-------------------')
$!write ('???-------------------')
$!write ('???-- End of Report --')
$!write ('???-------------------')
$!write ('???-------------------')
$!write ('???')
if (vtext(!filename) ne ||) then
   closefile $!output
endif
onerror golabel /restoreunits
!units.restoreSavedBoreDist()
return
label /badeval
handle any
   if(vtext(!filename) ne ||) then
      closefile $!output
   endif
   !units.restoreSavedBoreDist()
   return error 2 |Unable to evaluate expression for column $!evalcol
$!!ERROR.TEXT|
endhandle
label /closefile
handle any
   if (vtext(!filename) ne ||) then
      closefile $!output
   endif
   !units.restoreSavedBoreDist()
   return error
endhandle
label /restoreunits
handle any
   !units.restoreSavedBoreDist()
   return error
endhandle
