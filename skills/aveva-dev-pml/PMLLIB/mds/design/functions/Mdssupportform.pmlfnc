--
-- File:		Mdssupportform.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		I.Osborne
-- Created:		Wed Apr 30
--
--
-- Description:
-- Checks to see if the required support form is available
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------


-- Define Function
define function !!MdsSupportForm(!Form is FORM)

  -- !!MdsModifyname.cancel.active = true

  if (!form.string().upcase() eq 'MDSMODIFYNAME') then
    !check  = (match(!form.newname.string(),|.|))
    !check1 = (match(!form.newname.string().upcase(),|/DATUM|))
    !check2 = (match(!form.newname.string().upcase(),|/SREF|))
  else
    !Check = (match(!Form.Name.string(),|.|))
    !check1 = (match(!form.name.string().upcase(),|/DATUM|))
    !check2 = (match(!form.name.string().upcase(),|/SREF|))
  endif

  if (!Check gt 0) then
    !!Alert.Error('Supports cannot have a period embedded in their name')
    if (!form.string().upcase() neq 'MDSMODIFYNAME') then
      !Form.Name.val = 'unset'
      !Form.Ok.Active = False
      !form.name.setfocus()
    else
      !form.newname.val = 'unset'
      !form.newname.setfocus()
    endif
    return
  endif

  if (!Check1 gt 0) then
    !!Alert.Error('Supports can not have ''/DATUM'' embedded in their name')
    if (!form.string().upcase() neq 'MDSMODIFYNAME') then
      !Form.Name.val = 'unset'
      !Form.Ok.Active = False
      !form.name.setfocus()
    else
      !form.newname.val = 'unset'
      !form.newname.setfocus()
    endif
    return
  endif

  if (!Check2 gt 0) then
    !!Alert.Error('Supports cannot have ''/SREF'' embedded in their name')
    if (!form.string().upcase() neq 'MDSMODIFYNAME') then
      !Form.Name.val = 'unset'
      !Form.Ok.Active = False
      !form.name.setfocus()
    else
      !form.newname.val = 'unset'
      !form.newname.setfocus()
    endif
    return
  endif

  -- Check Form gadget contents
  if (!form.string().upcase() neq 'MDSMODIFYNAME') then
    if (!Form.SuppForm.set().not()) then
      call !!MdsNameGadget(!Form)
    elseif (!Form.SuppForm.name() eq !Form.name()) then
      !Form.Ok.Active = False
      return
    else
      call !!MdsNameGadget(!Form)
    endif
  endif



-- set focus to name gadget

   !Form.name.setfocus()


-- End function
endfunction

-- End of file Mdssupportform.pml
