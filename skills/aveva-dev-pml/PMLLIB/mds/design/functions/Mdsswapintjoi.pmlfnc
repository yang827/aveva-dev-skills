--
-- File:  Mdsswapintjoi.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		Wednesday 22nd November 2000
--
--
-- Description:
-- Function to swap the internal joint if required
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsswapintjoi(!stru is DBREF,!mirror is BOOLEAN,!alias is STRING)

  !!ce = !stru
  rule execute all on all pnod for frmw 1
    handle any
    endhandle
  !intJoints = !!kCollectAllFor('SJOI', '', !!ce)

  if !mirror then
    do !resetJoints values !intJoints
      !!ce = !resetJoints
      !altJoi = !!ce.catref.:MdsMirror
      handle any
        skip
      endhandle
      if !altJoi.eq('IGNORE') then
        skip
      elseif !altJoi.eq('') or !altJoi.eq('unset') then
        -- This code sets the original angle from the template
        -- Find the template that was used originally
        !size = !!mdsSetSteel.size.selection()
        !name = !!ce.owner.owner.name.after(!stru.name.string())
        copy sjoi 1 of snod 1 of /MDS/$!alias/$!size$!name
        handle (2,109)
          -- This maybe because it is one of the H or V templates
          !struName = !stru.name
          !paDir = pa dir of $!struName/DATUM
          !plDir = pl dir of $!struName/DATUM
          if !paDir.string().eq('U') or !plDir.string().eq('D') or !paDir.string().eq('Z') or !plDir.string().eq('-Z') then
            copy sjoi 1 of snod 1 of /MDS/$!alias$nV/$!size$!name
          else
            copy sjoi 1 of snod 1 of /MDS/$!alias$nH/$!size$!name
            endif
          endhandle
      else
-- This code sets the alternative spref and bang
        spref $!altJoi
        !bang = !!ce.bang
        if !bang.eq(0) then
          bang 180
        elseif !bang.eq(180) then
          bang 0
        else
          bang 180
        endif
      endif
      stru
      reconn recalc
        handle any
        endhandle
      same
    enddo
  else
    do !resetJoints values !intJoints
      !!ce = !resetJoints
      !altJoi = !!ce.catref.:MdsMirror
        handle any
          skip
        endhandle
      if !altJoi.eq('IGNORE') then
        skip
      endif
-- This code sets the original angle from the template
-- Find the template that was used originally
      !size = !!mdsSetSteel.size.selection()
      !name = !!ce.owner.owner.name.after(!stru.name.string())
      copy sjoi 1 of snod 1 of /MDS/$!alias/$!size$!name
         handle (2,109)
          --  This maybe because it is one of the H or V templates
        !struName = !stru.name
        !paDir = pa dir of $!struName/DATUM
        !plDir = pl dir of $!struName/DATUM
        if !paDir.string().eq('U') or !plDir.string().eq('D') or !paDir.string().eq('Z') or !plDir.string().eq('-Z') then
          copy sjoi 1 of snod 1 of /MDS/$!alias$nV/$!size$!name
        else
          copy sjoi 1 of snod 1 of /MDS/$!alias$nH/$!size$!name
          endif
        endhandle
      stru
      reconn recalc
        handle any
        endhandle
      same
    enddo
  endif

endfunction
