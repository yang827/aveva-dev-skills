--
-- File:  Mdstagft21.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Wayne Dodwell
-- Created:  Thursday 3rd September 1998
--
--
-- Description:
-- Function to Give the User chance to Change the P9 Orientation of the DATUM Atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        Form being called from
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdstagft21(!form is FORM)

  -- Initialise Variables
  !cecomp  = !!ce
  !support = !form.support
  !datum   = !support.datum
  !select  = !form.type.selection()
  !!ce     = !datum

  -- Show Datum Atta Orientation Form if 'Square' is Selected
  -- and Redesign the Structure
  if (!select.eq('S')) then

    -- Set Callback on the Apply Button of the form MdsBOPDIR
    !!mdsbopdir.apply.callback = 'call !!kactioncommands(!!mdsft21.rgaction)'
    !!mdsibopdir(!datum, !form)
    show !!mdsbopdir

  elseif (!select.eq('T')) then
    -- The 'True' option is selected so Redesign the Structure

    -- Recreate Support
    !!mdscreateft21('DIMENSION')
  endif
  !!ce = !cecomp

endfunction
