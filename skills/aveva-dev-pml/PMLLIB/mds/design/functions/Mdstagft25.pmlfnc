--
-- File:		Mdstagft25.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 18th November 1997
--
--
-- Description:
-- function to select the correct template sizes for support Packing Piece 'FT25'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Type of Packing Piece Required
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdstagft25(!type is STRING)

-- Initialise Variables
    !support = !!Mdsft25.support
    !select  = !type

-- Generate Steel Size List
    !!Mdsft25.size.clear()
    !dtext = ARRAY()
    !rtext = ARRAY()

-- Collect all supports for frame type 'FT25'
    !!ce = /MDS/FRAMES/FT25$!select
      handle (2,109)
        !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
        return
      endhandle
    !types = !!kcollectallfor('SCTN', '((match(name, |BAR-1|) gt 0) and type of owner eq |FRMW|)', !!CE)
    !block = object block('!types[!evalindex].spref.catref.:MDSSizeTag')
    !dtext = !types.evaluate(!block)

    do !I from 1 to !dtext.size()
      !rtext.append(!I.string())
    enddo

    !!ce = !support.stru

    !!Mdsft25.size.dtext = !dtext
    !!Mdsft25.size.rtext = !rtext


-- Update support data held in form
    !!Mdsft25.Support = !Support

-- Update support code
    !!MdsSetSuppCode('SELECT',!!Mdsft25.support.stru.name.string(),'FT25','XXXXXX')
      handle any
      endhandle

-- End function
  endfunction

-- End of file Mdstagft25.pml
