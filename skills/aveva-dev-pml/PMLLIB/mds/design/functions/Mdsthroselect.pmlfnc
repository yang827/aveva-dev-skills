--
-- File:		Mdsposthro.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          UNP
--
-- Author:		I.Osborne
-- Created:		Wed Mar 07
--
--
-- Description:
-- Function for use with picking position for support datum
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Support Form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsThroSelect(!Form is FORM)

  -- Initialise variables
    !Selection = !Form.Select.selection('Rtext')
    !Form.p.val = ''
     handle (61,122)
     endhandle

    if (!Selection eq |NAME|) then
       VAR USER _CDNNAME |_$!Form|
       SHOW _CDNNAME
       return
    elseif (!Selection eq |PIN|) then
       VAR USER _CDEPIN |_$!Form|
       SHOW _CDEPIN
       return
    elseif (!Selection eq |COORD|) then
       VAR USER _CDCOORD |_$!Form|
       SHOW _CDCOORD
       return
    elseif (!Selection eq |PLANE|) then
       Call !!MdsIThroPlane(!Form, !!CE)
       return
    endif

-- End function
endfunction

-- End of file Mdsthroselect.pml
