--
-- File:		MdsTidyNodes.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Tues 30th June 1998
--
--
-- Description:
-- Function to delete unwanted nodes from a sctn
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF        [Sctn to clear snodes, dbref could be stru,zone etc]
--     2     R        STRING       [String to suppress the confirm action]
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsTidyNodes(!Element is dbref,!Option is string)

  -- Initialise Variables

  !Refe = !!ce
  !Deletions = Array()
  !Found = False

  var !Nodes coll all snodes for $!Element
  -- will only work for one sjoi under snode (to do)
  do !i indices !Nodes
     var !Sjoints coll all sjoi for $!Nodes[$!i]
     var !Eval eval cref for all from !Sjoints
     var !pos eval pos wrt worl for all from !Sjoints
     !Nulref = !Eval.findfirst('=0/0')
     if(!Nulref.Unset().not()) then
      aid text numb 1003 'SNODE[$!i]' at $!pos[$!Nulref] wrt worl
      !Deletions.append(!Sjoints[!Nulref].dbref())
      !Found = true
     endif

  enddo

  if(!Option.eq('NOERROR').not()) then
   if(!Found) then
      !Confirm = !!Alert.Confirm('Unused Snodes are displayed for ' & !Element.string() & '. Do you wish to delete them?')
   else
     Return
   endif
  endif

  if(defined(!Confirm) and !Confirm.eq('NO')) then
     !!KaidClear('1003','ALL')
     return
  else
    do !Sj indices !Deletions
       !!CE = !Deletions[!Sj]
       DELETE SJOI
       if(!!CE.Mcount.eq(0)) then
       DELETE SNOD
       endif
-------------------------------------------------------remove when graphics works----------------
       !String = !!MdsRedraw(!!CE)
       $!String
-------------------------------------------------------------------------------------------------
    enddo
       !!KaidClear('1003','ALL')
  endif

-- clean view (graphics are not updating properly)

!!CE = !refe
    handle any
    -- in case deleted element
    endhandle

-- End function
endfunction

-- End of file MdsTidyNodes.pml
