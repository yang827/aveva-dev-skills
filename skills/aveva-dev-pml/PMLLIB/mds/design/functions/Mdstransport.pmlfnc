--------------------------------------------------------------------------------
--
-- File:                Mdstransport.pmlfnc
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:
--
-- Author:              S.robinson
-- Created:             Thu 29th Jan
--
-- Description:
-- Function to add transportation text
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         DBREF        Atta at which transportation text will be set
--     2     R         STRING       Name of support to be checked for transportation prefix
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsTransport(!atta is DBREF, !sName is STRING)

  --><wd>10mar2009 - Defect No. - P16924
  -- Store the DBREF of the Current Element
  !ceElement = !!ce
  --<<wd>10mar2009 - Defect No. - P16924

  -- The ability to add/remove the orientation note from the support tag is controlled by the
  -- variable !!mdsOriNot, check to see if it exists and set the flag
  if (undefined(!!mdsOriNot)) then
    !mdsOriNot = TRUE
  else
    !mdsOriNot = !!mdsOriNot.boolean()
  endif

  -- The variable !!mdsOriWrt will contain the element to which the orientation is to
  -- be set to.
  if (undefined(!!mdsOriWrt)) then
    !mdsOriWrt = WORLD
  else
    !mdsOriWrt = !!mdsOriWrt
  endif

  !name = !sName

  if !name.match('/DATUM').gt(0) then
    !name = !name.before('/DATUM')
  endif

  !!mdsDacControl(TRUE)

  --<wd>may2003
  -- Get the P9 orientation of the ATTA and ADD it to the STEX value for Output onto the ISOMETRIC Drawing
  !p9dir = !atta.pdir[9].wrt($!mdsOriWrt )
  handle ANY
    !ori = ''
  elsehandle NONE
    !ori = 'ORI = ' & !p9dir.string().before(' WRT')
  endhandle

  if (!atta.spref.set()) then
    if ((!atta.spref.name.matchwild('/MDS/*LT03*'))) then
      !p9dir = !atta.pdir[10].wrt($!mdsOriWrt )
      !ori = 'ORI = ' & !p9dir.string().before(' WRT')
    endif
  endif

  if (!atta.styp inset ('GT11','GT12A','GT12B','GT27A','GT27B','ST08')) then
    !p9dir = !atta.pdir[40].wrt($!mdsOriWrt )
    !p41dir = !atta.pdir[41].wrt($!mdsOriWrt )
    !ori = 'FREE TO SLIDE = ' & !p9dir.string().before(' WRT') & '/' & !p41dir.string().before(' WRT')
    if !ori.eq('FREE TO SLIDE = S/N') then
      !ori = 'FREE TO SLIDE = N/S'
    elseif !ori.eq('FREE TO SLIDE = W/E') then
      !ori = 'FREE TO SLIDE = E/W'
    endif
  elseif (!atta.styp inset ('LT14A','LT14B')) then
    !p9dir = !atta.pdir[10].wrt($!mdsOriWrt )
    !ori = 'ORI = ' & !p9dir.string().before(' WRT')
  endif

  --<wd>21jul2004
  -- BY DEFAULT - Set the UDA :mdsSuppFunc at the NEW ATTA to be the same as the
  -- OWNING 'CATE' element of the ATTA 'CATREF<SCOM>' element in the CATALOGUE.
  -- but not if a hanger
  if (!atta.spref.unset() or !atta.spref.name.matchwild('/MDS/MH01*').not()) then
    if (!atta.:MDSSuppType.set() and !atta.:MDSSuppType.substring(1,2) eq 'PR') then
      !defaultPreliminary = /MDS/PRELIMINARY/DEFAULTS/$!atta.:MDSSuppType/GEN/SUPF
      handle any
      elsehandle none
        !supf = !defaultPreliminary.pproperty.after(|( '|).before(|' )|)
        if (!defaultPreliminary.pproperty.set() and !supf.set() and (!supf neq '')) then
          !atta.:mdssuppfunc = !supf
        endif
      endhandle
    endif
  endif
  --<wd>21jul2004

  !suppFunc = ''
  if ((Desc of /MDS/TEMPLATES ) eq 'Framatome Templates') then
    !suppFunc = !atta.:MdsSuppFunc
    !suppFunc = '-' + !suppFunc
  endif

  -- If suppFunc eq '-', blank it
  if !suppFunc.eq('-') then
    !suppFunc = ''
  endif

  --<wd>may2003
  !!ce = !atta
  --<wd>may2003
  ------------------------------------------------------------------------
  if ( (!atta.spref.name.matchwild('/MDS/*REST*')) or (!atta.spref.name.matchwild('/MDS/AC*')) $
    or (!atta.spref.name.matchwild('/MDS/FH*')) or (!atta.spref.name.matchwild('/MDS/VH*')) $
    or (!atta.spref.name.matchwild('/MDS/AT29*')) or (!atta.spref.name.matchwild('/MDS/AT65*')) ) then

    -- Do NOT set the ORI in the STEX for ANY HVAC, TRAY or PIPE REST ATTAS,
    -- ANY Fixed or Variable Hanger ATTAS or ANY Composite MDS Ancillary e.g. with a SPREF of /MDS/AC*
    ------------------------------------------------------------------------

    -- Check if passed name contains the transportation prefix
    if (!name.after('/').match(!!mdsOptions.tranPref).eq(1)) then
      -- add transportation text into atta STEX
      !aName = !name.after('/')
      -- If the support is part of a group if will be suffixed with [?], get rid of the [/]
      if !aName.match('[').gt(0) then
        !aName = !aName.before('[')
      endif
      --$P 1
      STEX |$!aName$!suppFunc
      $!!mdsOptions.pTranText.val|
    else
      if (!name.match('/').eq(1)) then
        !aName = !name.after('/').before('.')
        -- If the support is part of a group if will be suffixed with [?], get rid of the [/]
        if !aName.match('[').gt(0) then
          !aName = !aName.before('[')
        endif
        --$p 2
        STEX |$!aName$!suppFunc|
      else
        -- If the support is part of a group if will be suffixed with [?], get rid of the [/]
        if !name.match('[').gt(0) then
          !name = !name.before('[')
        endif
        --$P 3
        STEX |$!name$!suppFunc|
      endif
    endif

    ------------------------------------------------------------------------
  else
    -- Set the ORI in the STEX for the REMAINDER of ATTAS
    ------------------------------------------------------------------------

    -- check if passed name contains the transportation prefix
    if (!name.after('/').match(!!mdsOptions.tranPref).eq(1)) then
      -- add transportation text into atta STEX
      !aName = !name.after('/')
      -- If the support is part of a group if will be suffixed with [?], get rid of the [/]
      if !aName.match('[').gt(0) then
        !aName = !aName.before('[')
      endif
      --$p 4
      if !mdsOriNot then
        STEX |$!aName$!suppFunc
        $!!mdsOptions.pTranText.val
        $!ori|
      else
        STEX |$!aName$!suppFunc
        $!!mdsOptions.pTranText.val|
      endif
    else
      if (!name.match('/').eq(1)) then
        !aName = !name.after('/').before('.')
        -- If the support is part of a group if will be suffixed with [?], get rid of the [/]
        if !aName.match('[').gt(0) then
          !aName = !aName.before('[')
        endif
        --$p 5
        if !mdsOriNot then

          -- Fix for HPD0026233 GE 03/05/06 NOTE1  -  Removes current stext 'Do not cut hole in pipe' and replaces it with
          -- <support number>/NOTE1 and wrong orientation of trunnion.
          -- e.g. PS/430/1234/NOTE1
          if !!ce.spref.name.matchwild('*COMMENT*').not() then
            STEX |$!aName$!suppFunc
            $!ori|
          endif
          -- End of fix

        else
          if ((Desc of /MDS/TEMPLATES ) eq 'Framatome Templates') then
            if !!ce.name.match('/SREF').gt(0) then
              STEX ||
            else
              STEX |$!aName$!suppFunc|
            endif
          else
            STEX |$!aName$!suppFunc|
          endif
        endif
      else
        -- If the support is part of a group if will be suffixed with [?], get rid of the [/]
        if !name.match('[').gt(0) then
          !name = !name.before('[')
        endif
        --$p 6
        if !mdsOriNot then
          STEX |$!name$!suppFunc
          $!ori|
        else
          STEX |$!name$!suppFunc|
        endif
      endif
    endif

  endif
  ------------------------------------------------------------------------
  --<wd>may2003

  --><wd>10mar2009 - Defect No. - P16924
  -- Determine the Pipe and Trunnion Weld Values at the ATTA from the Specific MDSSELECTION object
  !!mdsNWelds(!atta)
  -- Return to the DBREF of the Current Element at the TOP of this PML function
  !!ce = !ceElement
  --<<wd>10mar2009 - Defect No. - P16924

  !!mdsDacControl(FALSE)

  -- End function
endfunction
