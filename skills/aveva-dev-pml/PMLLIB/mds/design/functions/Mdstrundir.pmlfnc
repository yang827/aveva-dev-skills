--
-- File:  Mdstrundir.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Wayne Dodwell
-- Created:  Thursday 12th February 1998
--
--
-- Description:
-- Function to set the length of a trunnion
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      Length
--     2     R         DIRECTION   Direction of trunnion
--     3     R         POSITION    Start Position
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Define Function
define function !!mdstrundir(!form is FORM)

  -- Find current units and set the distance unit to metric

  !currentunits = !!kgetsetunits()

  -- Check to see if the direction is valid

  -- No up or down component can be present in the direction
  -- A TT17 on a horizontal pipe is allowed to be directed up

  if !form.string().upcase().eq('MDSTT17') or !form.string().upcase().eq('MDSTT27') then
    if !form.support.datum.owner.href.pdir[!form.support.datum.arrive].string().before(' WRT').eq('D') or !form.support.datum.owner.href.pdir[!form.support.datum.leave].string().before(' WRT').eq('D') or !form.support.datum.owner.href.pdir[!form.support.datum.arrive].string().before(' WRT').eq('-Z') or !form.support.datum.owner.href.pdir[!form.support.datum.leave].string().before(' WRT').eq('-Z') then
      if !form.direction.val.upcase().match('D').gt(0) or !form.direction.val.upcase().match('U').gt(0) or !form.direction.val.upcase().match('-Z').gt(0) or !form.direction.val.upcase().match('Z').gt(0) then
        !!alert.error('Direction must be horizontal. Aborting direction change')
        !!kRestoreUnits(!currentunits)
        return
      endif
    endif
  else
    if !form.direction.val.upcase().match('D').gt(0) or !form.direction.val.upcase().match('U').gt(0) or !form.direction.val.upcase().match('-Z').gt(0) or !form.direction.val.upcase().match('Z').gt(0) then
      !!alert.error('Direction must be horizontal. Aborting direction change')
      !!kRestoreUnits(!currentunits)
      return
    endif
  endif



  !testdir = !form.direction.val
  !unuseddirobj  = !testdir.direction()
  handle any
    !!alert.error('Direction is NOT valid. Aborting direction change')
    !!kRestoreUnits(!currentunits)
    return
  endhandle

  !!ce = !form.support.datum
  branch
  goto href
  !!mdsDacControl(true)
  ori and p3 is $!form.direction.val
  same
  hdir $!form.direction.val

  -- Save current distances from ph

  !mem = mem count
  !savedist = ARRAY()
  do !dist from 1 to $!mem
    bran
    $!dist
    pin 9 at ce
    pin 8 at ph
    var !currDist const dist pin 9 to pin 8
    !savedist.append(!currDist)
    dist $!currDist from ph
    !p3dir = p3 dir wrt world
    handle any
    endhandle
    !p9dir = p9 dir wrt world
    handle any
    endhandle
    ori and p9 is $!p9dir
    handle any
      ori
    endhandle
    --<wd>apr2006
    --if !!ce.stype.eq('AC44')
    if !!ce.stype.eq('AC44') or !!ce.stype.eq('AC54') then
      ori and p3 is $!p3dir
    endif

  enddo

  !!mdsresetpins(8,9)

  -- Finally connect to new tail pos
  bran
  conn pt to last mem
  tcon clos

  !!mdsDacControl(false)

  !!kRestoreUnits(!currentunits)

endfunction
