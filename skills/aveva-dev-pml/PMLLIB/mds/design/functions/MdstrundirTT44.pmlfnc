--
-- File: MdstrundirTT44.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Wayne Dodwell
-- Created: Thursday 12th February 1998
--
--
-- Description:
-- Function to set the length of a trunnion.  Dun979 MDS12 addition
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      Length
--     2     R         DIRECTION   Direction of trunnion
--     3     R         POSITION    Start Position
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Define Function
define function !!mdstrundirTT44(!form is FORM)

-- Find current units and set the distance unit to metric

  !currentUnits = !!kgetsetunits()

--<wd>03jun2004
-- Navigating to the BRANCH moved to TOP of this file

-- Check to see if the direction is valid
  !!ce = !form.support.datum
  branch
--<wd>03jun2004
  !tdir = !!ce.hdir.wrt(/* )
--<wd>03jun2004
  goto href

  !testdir = !form.direction.val
  !unuseddirobj  = !testdir.direction()
    handle any
      !!alert.error('Direction is NOT valid. Aborting direction change')
--<wd>03jun2004
      !form.direction.val = !tdir.string().upcase().before('WRT ').trim()
--<wd>03jun2004      !!kRestoreUnits(!currentunits)
      return
    endhandle

  -- Added trap to stop redirection on anything but tee

  if !!ce.type.neq('TEE') then
--<wd>03jun2004
    !!alert.error('Can only change the direction of trunnions on straight pipes. Aborting direction change ')
    !form.direction.val = !tdir.string().upcase().before('WRT ').trim()
--<wd>03jun2004
    !!kRestoreUnits(!currentunits)
    return
  endif
  !!mdsDacControl(true)
  if !!ce.type.eq('ELBO') then
    !paTest = pa dir wrt /*
    plTest = pl dir wrt /*
    !p3Test = p3 dir wrt /*
    --If the direction of the p3 of the elbow is different than
    --the form direction, flip and ori it
    if !p3Test.string().before(' ').neq(!form.direction.val.upcase()) then
      flip ori
      ori pa is $!paTest and pl is $plTest
       --Check the direction again. If it is not the same as the form
       --then the elbow cannot be orientated in the required direction
       !p3Test = p3 dir wrt /*
       --If the direction of the p3 of the elbow is different than
       --the form direction, flip and ori it
      if !p3Test.string().before(' ').neq(!form.direction.val.upcase()) then
        flip ori
        ori pa is $!paTest and pl is $plTest
        same
        !hdir = Hdir
        !form.direction.val = !hdir.string().before(' ')
        !!alert.error('Unable to orientate Elbow in required direction')
        return
      else
        --Move Branch the difference of p1 to p2
        !north = !!ce.ppos[1].north - !!ce.ppos[2].north
        !east  = !!ce.ppos[1].east  - !!ce.ppos[2].east
        !up    = !!ce.ppos[1].up    - !!ce.ppos[2].up
        same
        By N $!north E $!east U $!up
        same
      endif

    endif


  else
    ori and p3 is $!form.direction.val
      handle (61,7)
        !!ce = !form.support.datum
        branch
        !hdir = Hdir
        !form.direction.val = !hdir.string().before(' ')
        !!alert.error('Unable to orientate Elbow in required direction')
        return
      endhandle
  endif
  same
  hdir $!form.direction.val

-- Save current distances from ph

  !mem = mem count
  !savedist = ARRAY()
  do !dist from 1 to $!mem
    bran
    $!dist
    pin 9 at ce
    pin 8 at ph
    var !currDist const dist pin 9 to pin 8
    !savedist.append(!currDist)
    dist $!currDist from ph
    !p3dir = p3 dir wrt world
    handle any
    endhandle
    !p9dir = p9 dir wrt world
    handle any
    endhandle
      ori and p9 is $!p9dir
      handle any
        ori
      endhandle

      if !!ce.stype.eq('AC44') or !!ce.stype.eq('AT29A') or !!ce.stype.eq('AT29B') then
         ori and p3 is $!p3dir
      handle(61,7) $* handle the error if we are at an elbo. The p3 needs to be same as P2 of elbo
         !p3dir = !!ce.owne.href.pdir[2]
          ori and p3 is $!p3dir
      endhandle
      endif
  enddo

  !!mdsresetpins(8,9)

-- Finally connect to new tail pos
  bran
  conn pt to last mem
  tcon clos

--<wd>03jun2004
-- Set the Form Member .tdirection to the value displayed in the Form DIRECTION gadget

  -- additional code added to account for when the user types a direction which includes WRT
  -- RM 13/03/06
  !dirSplit = !form.direction.val.split()
  !arrlen = !dirSplit.size()
  !wrtflag = 0

  do !i to !arrlen
    if !dirSplit[!i] eq 'WRT' or !dirSplit[!i] eq 'wrt'  then
      !wrtflag = 1
      do !j to !i - 1
        if !j eq 1 then
          !temparr = !dirSplit[!j]
        else
          !temparr = !temparr & '' & !dirSplit[!j]
        endif
      enddo

      !setdir = !temparr & ' WRT'

    elseif !wrtflag eq 1 then
      !setdir = !setdir & '' & !dirSplit[!i]
    else
      !setdir = !form.direction.val & ' WRT /*'
    endif
  enddo
  -- end of changes RM 13/03/06

  !form.tdirection =!setdir
--<wd>03jun2004

-- Position Texts
  !!ce = !form.support.datum
  !!ce = !!ce.owner.href
--<wd>oct2003
  if (!!ce.type.eq('REDU')) then
    if (!!ce.abor.gt(!!ce.lbor)) then
      !pos = !!ce.apos.string()
    else
      !pos = !!ce.lpos.string()
    endif
  else
    var !pos pos wrt world
  endif

  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Trunnion $<$!pos$>
  !!ce = !form.support.datum
  var !pos pos wrt world
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 211 Datum $<$!pos$>

  !!mdsDacControl(false)

  !!kRestoreUnits(!currentunits)

endfunction
-- End function
