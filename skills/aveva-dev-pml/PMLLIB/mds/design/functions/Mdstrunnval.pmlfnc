--
-- File:		Mdstrunnval.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Thursday 11th December 1997
--
--
-- Description:
-- Function to Derive Current Pipe Size and which Array to use to
-- load the form gadget '!!Mdstrunnvt01.standard'
--
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        DBREF        Reference of atta created temporarily in the
--                                  Identified Pipe
--
-- Return:
--    [Data Type]   [Description]
--     String        Name of Array
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdstrunnval(!atta is DBREF) is STRING

-- Initialise Variables
    !cecomp = !atta
    !units = object COMUNITS(TRUE)

-- Get the Current Pipe Size and Set the Array used to
-- load the form gadget '!!Mdstrunnvt01.standard'
    if (!!isImperialLength('DIST').not()) then
      units MM bores
      units MM dist
    endif

    !!ce = !cecomp
    if (!!ce.order eq 1) then
      head
      !plbore = hbore
      handle any
        golabel /abort
      endhandle
    else
      previous
      !plbore = pl bore
      handle any
        golabel /abort
      endhandle
    endif

-- Return the name of the Array to determine the Trunnions to be loaded
    if (!plbore.real() eq 50) then
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return '!!Mdstrunnions.pdia2'
    elseif (!plbore.real() eq 80) then
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return '!!Mdstrunnions.pdia3'
    elseif (!plbore.real() eq 100) then
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return '!!Mdstrunnions.pdia4'
    elseif (!plbore.real() eq 125) then
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return '!!Mdstrunnions.pdia5'
    elseif (!plbore.real() eq 150) then
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return '!!Mdstrunnions.pdia6'
    elseif (!plbore.real() eq 200) then
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return '!!Mdstrunnions.pdia8'
    elseif (!plbore.real() eq 250) then
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return '!!Mdstrunnions.pdia10'
    elseif (!plbore.real() eq 300) then
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return '!!Mdstrunnions.pdia12'
    elseif (!plbore.real() eq 350) then
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return '!!Mdstrunnions.pdia14'
    elseif (!plbore.real() eq 400) then
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return '!!Mdstrunnions.pdia16'
    elseif (!plbore.real() eq 450) then
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return '!!Mdstrunnions.pdia18'
    elseif (!plbore.real() eq 500) then
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return '!!Mdstrunnions.pdia20'
    elseif (!plbore.real() eq 550) then
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return '!!Mdstrunnions.pdia22'
    elseif (!plbore.real() eq 600) then
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return '!!Mdstrunnions.pdia24'
    elseif (!plbore.real() eq 750) then
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return '!!Mdstrunnions.pdia30'
    elseif (!plbore.real() eq 900) then
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return '!!Mdstrunnions.pdia36'
    elseif (!plbore.real() eq 1050) then
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return '!!Mdstrunnions.pdia42'
    elseif (!plbore.real() eq 1200) then
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return '!!Mdstrunnions.pdia48'
    else
      golabel /abort
    endif

-- Return Units back to Original Units
    label /abort
      !!ce = !cecomp
      !units.restoreSavedBoreDist()
      return 'false'

  endfunction
-- End function

-- End of file Mdstrunnval.pml
