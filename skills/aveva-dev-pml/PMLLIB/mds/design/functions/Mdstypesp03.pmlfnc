--
-- Author:		Andrew Kirkland
-- Created:		Tues 3rd June 1998
--
--
-- Description:
-- Change type of Variable Spring Support SP03
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsTypeSP03()

-- Force into forwards mode
   FORWARDS

  -- Initialise variables
--    !TubeType    = !!MdsOptions.Pipes
    !Datum       = !!MdsSP03.Support.Datum
    !Name        = !!MdsSP03.Name.val
    !Alias       = !!MdsSP03.Support.Alias
    !ElbTrn      = ''


-- check if atta created
   if(!Datum.Unset() )then
      -- do nothing except set type gadet for the create option
      return
   else
    !!CE = !Datum
   endif

-- Get stype from option gadget value
    !Type = !!MdsSP03.Type.Selection()

-- Get offset depending on the type selected

    if(!Type inset('A','B','C','D','G')) then

       !Offset = (!Datum.Desp[1] + !Datum.Para[3] / 2)
-- $p
-- $p
-- $P---------------------------
-- $P---------------------------
-- $P---------------------------
-- q desp
-- $P line 63  !offset is ** $!offset **
-- $P---------------------------
    else
       if(!Datum.:MDSGuideRef.unset().not()) then
         if(!Datum.:MDSGuideRef.stype.eq('AT11A') or !Datum.:MDSGuideRef.stype.eq('AT10A') ) then
          !ElbTrn = 'A'
          !OFFset = !Datum.:MDSGuideRef.Desp[1] + !Datum.:MDSGuideRef.Desp[2]
         elseif(!Datum.:MDSGuideRef.stype.eq('AT11B') or !Datum.:MDSGuideRef.stype.eq('AT10B') ) then
          !OFFset = !Datum.:MDSGuideRef.Desp[1] + !Datum.Para[3] / 2
         endif
       else
          !OFFset =  !Datum.Para[3] / 2
       endif
    endif

    !Stype = 'SP03' & !Type & !ElbTrn

    sel with styp '$!Stype' spec /MDS


    !!MdsSetDesPars(!Datum)

    -- despar n5 $!Offset
      -- handle any
      -- endhandle

-- $P---------------------------
-- $P line 95  !offset is ** $!offset **
-- $P---------------------------
-- q desp

    !Bore = pa bore
    !Type = !Datum.styp.substring(1,5)

    !!MdsGetProp(_Height,_Height,'HEIG',!Bore,!Type)
      handle any
      endhandle
    !!MdsGetProp(_Case,_Case,'CHEI',!Bore,!Type)
      handle any
      endhandle
    !!MdsGetProp(_CaseDia,_CaseDia,'CDIA',!Bore,!Type)
      handle any
      endhandle
    !!MdsGetProp(_CaseLen,_CaseLen,'CLEN',!Bore,!Type)
      handle any
      endhandle
    !!MdsGetProp(_HouWid,_HouWid,'HWID',!Bore,!Type)
      handle any
      endhandle
    !!MdsGetProp(_HouThk,_HouThk,'HTHK',!Bore,!Type)
      handle any
      endhandle
    !!MdsGetProp(_ARM,_ARM,'ARM',!Bore,!Type)
      handle any
      endhandle
    !!MdsGetProp(_HouDep,_HouDep,'HDEP',!Bore,!Type)
      handle any
      endhandle
    !!MdsGetProp(_CentreL,_CentreL,'CENL',!Bore,!Type)
      handle any
      endhandle
    !!MdsGetProp(_HouLen,_HouLen,'HLEN',!Bore,!Type)
      handle any
      endhandle
    !!KMDSGetProp(_Angle,_Angle,'ANG',!Bore,!Type)
      handle any
      endhandle

-- $P--------------
-- q desp
-- $P--------------
-- ********this to do
--if(!Trunnion) then
--     Set Spring Atta :MDSGuideRef to Pedestal Atta
  --     :MDSGuideRef $!Datum
    --   !Spring = !!ce
--endif
-- End function
endfunction

-- End of file MdsTypeSP03.pml
