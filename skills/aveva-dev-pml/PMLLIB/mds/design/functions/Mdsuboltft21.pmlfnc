--
-- File:		Mdsuboltft21.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 29th October 1997
--
--
-- Description:
-- function to Select a U-Bolt and Check its type for Framework Type 'FT21'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!Mdsuboltft21()

-- Initialise variables
  !support = !!Mdsft21.support

-- Check U-Bolt stype is NOT 'BT01A'(Gripped)
  !styp = object BLOCK ('!support.bars[1][!evalindex].styp')
  !ubol = !support.bars[1].evaluate(!styp)
  !dupl = !ubol.find('BT01A')

  if (!dupl.size().gt(1)) then

-- More than ONE 'Gripped' type U-Bolt exists on the framework.
    !!alert.error('A ''Gripped'' type U-Bolt already exists on this framework. Only ONE ''Gripped'' type U-Bolt is permitted. Please select another type')
    !last = !ubol.last()

-- Navigate to the last U-Bolt(Atta) created
    !!ce = !support.bars[1].last()

-- Remove Aidtext from the Graphical View for the Atta to be deleted
    !name = after(!!ce.name, '.')
    !num  = (210 + $!name)
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!num

-- Delete the last selected U-Bolt(Atta)
    delete atta

-- Update object MdsSUPPORT to remove deleted atta
    !support.atta.removelast()
    !support.bars[1].removelast()
    refresh

-- Reset pins
    Call !!Mdsresetpins(1,10)

-- Update support data held in form
    !!Mdsft21.support = !support

-- Re-Initialise Add Pipe/Ubolt Process
    call !!Mdsaddpipe(!!Mdsft21)
    return
  endif

-- End function
endfunction

-- End of file Mdsuboltft21.pml
