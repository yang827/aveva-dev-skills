--
-- File:		Mdsudfltsite.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          UDEFSITE
--
-- Author:		I.Osborne
-- Created:		Wed Apr 30
--
--
-- Description:
-- When a site is selected from the list of available sites we need to set the
-- type toggle to the right setting
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsUDfltSite()

  -- Initialise variables
    !Origin     = !!CE
    !Current    = '/' & !!MdsDefaultSite.Site.selection('DTEXT')
    !Individual = !Current & '-SUPPORTS'

  -- Check if the selected site is combined or individual
    !!CE = !Individual.dbref()
      handle any
        !!CE = !Current.dbref()
        !Zones = (!!KCollectAllFor('ZONE', 'match(Name, |-SUPP|) gt 0', !!CE))
        if (!Zones.size() eq 0)then
          !!MdsDefaultSite.Group.Val = 1
        else
          !!MdsDefaultSite.Group.Val = 2
        endif
      elsehandle none
        !!CE = !Origin
        !!MdsDefaultSite.Group.Val = 1
      endhandle

-- End function
endfunction

-- End of file Mdsudfltsite.pml
