--
-- Author:		I.Osborne
-- Created:		Fri Jun 13
--
--
-- Description:
-- function to disassociate an atta from a cross bar on a support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Support form
--     2     R        DBREF         Atta to be disassociated from a bar
--
-- Return:
--    [Data Type]   [Description]
--     REAL          Bar Number to be adjusted in length
--                   Returns 0 if atta is not associated with a bar
--                   Returns 100 if the atta being removed is the only atta associated
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsUnLinkAtta(!Form is FORM, !Atta is DBREF) is REAL

  -- Initialise variables
    !Origin = !!CE
    !Bars   = !Form.Support.Bars
    !Name   = !Form.Support.Stru.name
    !References = ''

  -- Loop thro support bars to find out which cross bar the atta is on
    do !I indices !Bars
      if (!Bars[!I].find(!Atta).size() gt 0)then
        !BarNumber = !I
        !List = !Bars[!I]
        if (!List.size() eq 1)then
          return 100
        endif
        !Index = !List.findfirst(!Atta)
        !List.remove(!Index)
        !Form.Support.Bars[!I] = !List

      -- Navigate to bar and remove reference
        !!CE = $!<Name>-BAR-$!I
           handle (2,109)
             return 0
           endhandle
        do !Count Indices !List
          !Ref = !List[!Count].string()
          !References = !References & ' ' & !Ref
        enddo

        :MDSAttaRef $!References

      endif
    enddo

    !!CE = !Origin
    if (defined(!BarNumber))then
      return !BarNumber
    else
      return 0
    endif

-- End function
endfunction

-- End of file Mdsunlinkatta.pml
