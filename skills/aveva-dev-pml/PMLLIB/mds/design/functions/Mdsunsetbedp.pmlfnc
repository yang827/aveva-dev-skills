--
-- File:		Mdsunsetbedp.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:          MSETBP
--
-- Author:		I.Osborne
-- Created:		Wed Jun 18
--
--
-- Description:
-- function to reference bed plate to support. Max number of references equal 2.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Support Form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsUnsetBedp(!Form is FORM,!Reference is REAL)

-- Can only modify the stru if we can write to it

    if !Form.Support.Stru.set() then
      if !!MdsComClaimDac(!Form.Support.Stru,'DACMOD','POS').not() then
        !!Alert.Error('Unable to unset the bed/anchor plate references as write access is not available')
        return
      endif
    else
      if !!MdsComClaimDac(!Form.Support.Datum,'DACMOD','POS').not() then
        !!Alert.Error('Unable to unset the bed/anchor plate references as write access is not available')
        return
      endif
    endif

  -- The reference variable will be the bedplate reference to unset
    if !Reference eq 1 then
      !Sctn = !!MdsBedPlate.Sctn1.val
    else
      !Sctn = !!MdsBedPlate.Sctn2.val
    endif

-- Substitute Support Name for Section Name '!sctn' for an 'ATTA' - Only type Support
    if (!sctn.trim().eq('N/A')) then
      !sctn = !!Mdsbedplate.name.val
    endif

  -- Is already unset
    if !!MdsBedPlate.Ref$!<Reference>.val eq 'unset' then
      return error 1 |Bed/Anchor plate reference for $!Sctn is already unset!|
    endif

    !Prompt = |Are you sure you want to clear the base/anchor plate reference for $!Sctn|

    if (!!Alert.confirm('$!Prompt') eq |NO|)then
      return
    endif

-- Unset support and bedplate references



    !!CE = !Form.Support.Stru.:MDSBpref$!reference
    handle (2,754)
-- Support does NOT have a STRUCTURE ie. 'ATTA' - Only type Support
      --!!ce = !form.support.datum.:MDSBpref1
      !!ce = !!Mdsbedplate.name.val.dbref().:MDSbpref$!reference
    endhandle


    if !!ce.type.eq('SBFI') then
      !Supportrefs = :MdsAncRef
      if !Form.Support.Stru.set() then
        !Check = !Supportrefs.find(!Form.Support.Stru)
      else
        !Check = !Supportrefs.find(!Form.Support.datum)
      endif
      !Supportrefs.remove($!Check[1])
        handle ANY
        elsehandle NONE
          !!ce.:MdsAncRef = !SupportRefs
            handle ANY
             :Mdsancref def
            endhandle
        endhandle
    else
      :MDSBpref1 default
    endif

    !!CE = !Form.Support.Stru
    handle (2,106) (2,822)
-- The current element cannot be =0/0
-- or Support does NOT have a STRUCTURE ie. 'ATTA' - Only type Support
     -- !!ce = !form.support.datum
      !!ce = !!Mdsbedplate.name.val.dbref()
    endhandle
    :MDSBpref$!Reference default

  -- Update form
    !!MdsBedPlate.Ref$!<Reference>.val = 'unset'

  -- Update Support Object
    !Form.Support.Bedplate$!Reference = =0/0

-- End function
endfunction

-- End of file Mdsunsetbedp.pml
