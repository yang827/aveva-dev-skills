--
-- File:  Mdsvtdummylen.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Wayne Dodwell
-- Created:  Tuesday 9th December 2003
--
--
-- Description:
-- Function to set the length of a trunnion/dummy leg for Veseel Supports VT01, VT02
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         REAL        Length
--     2     R         DBREF       Trunnion Branch
--     3     R         DBREF       Trunnion SREF Atta
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsvtdummylen(!length is REAL,!trunbran is DBREF,!trunsref is DBREF)

  --If the units are imperial convert !length to mm
  !!mdsdaccontrol(true)
  !units = object COMUNITS(TRUE)

  !tlength = !length

  -- Goto the Trunnion Branch
  !!ce   = !trunbran
  !abor  = !trunsref.abor
  !ttype = !trunsref.:mdssupptype
  -- Goto the Set On tee
  goto href

  -- Overall length will be !inter + !length
  !inter = !!kstrreal('const dist p3 to p0')

  -- Set and Check Trunnion Min/Max lengths
  ------------------------------------------------------------------------------
  -- mjb >>> 02.05.06 <mds12>

  !mdstrunobj  = object MDSREADTRUNDATA()
  !mdstrundata = !mdstrunobj.mdstrundata(!ttype, !abor.real().value())

  if (!mdstrundata.not()) then
    -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
    if (!mdstrunobj.mdsstd.sactive.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
      !errormessage = !mdstrunobj.mdsstd.smess
    elseif (!mdstrunobj.mdsstd.cactive.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
      !errormessage = !mdstrunobj.mdsstd.cmess
    endif
    !!alert.error(!errormessage)
    return
  endif

  !min = !mdstrunobj.minlength
  !max = !mdstrunobj.maxlength

  --!min = !!mdspar$!ttype$n[$!abor].minimum
  --!max = !!mdspar$!ttype$n[$!abor].maximum
  -- mjb <<< 02.05.06 end of mod
  ------------------------------------------------------------------------------
  if (!tlength.gt(!max)) then
    !slength       = !tlength.string(!!distancefmt)
    !tcurrentunits = !!kgetsetunits()
    !mlength       = !max.string(!!distancefmt)
    !tlength       = !max
    !!alert.error(|Length of $!slength is more than the maximum allowed. Setting Trunnion length to maximum of $!mlength|)
  endif
  if (!tlength.lt(!min)) then
    !slength       = !tlength.string(!!distancefmt)
    !tcurrentunits = !!kgetsetunits()
    !mlength       = !min.string(!!distancefmt)
    !tlength       = !min
    !!alert.error(|Length of $!slength is less than the minimum allowed. Setting Trunnion length to minimum of $!mlength|)
  endif

  -- Return to the Trunnion Branch
  !!ce     = !trunbran
  !olength = !inter + !tlength
  -- Reconnect the Trunnion Members
  last mem
  pos pl dist $!olength from ph
  prev
  conn to next
  handle (7,3)
    fconn to next
  endhandle
  !!ce = !trunsref
  conn to next
  handle (7,3)
    fconn to next
  endhandle
  bran
  conn pt to last mem
  tcon CLOS

  -- Vessel Supports VT01 and VT02 ONLY use Trunnion types 'TT17' and
  -- Despar num 3 of the Trunnion SREF Atta stores the trunnion length so reset it.
  !!ce = !trunsref
  if (!trunsref.:mdssupptype.eq('TT17')) then
    despar n3 $!tlength
  endif

endfunction
