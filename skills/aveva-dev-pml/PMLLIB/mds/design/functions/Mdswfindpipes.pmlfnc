--
--
-- Description:
-- function to select supportable pipes around the working section
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdswfindpipes()

  -- Is working elemnt defined

  if !!mdsWizard.setElement.not() then
    !!alert.error('No working element has been identified')
    return
  endif

  !form = !!mdsWizard

  !fromX = ' ' & !form.fx.selection('DTEXT') & ' ' & !form.fxval.val.string()
  !fromY = ' ' & !form.fy.selection('DTEXT') & ' ' & !form.fyval.val.string()
  !fromZ = ' ' & !form.fz.selection('DTEXT') & ' ' & !form.fzval.val.string()
  !toX   = ' ' & !form.tx.selection('DTEXT') & ' ' & !form.txval.val.string()
  !toY   = ' ' & !form.ty.selection('DTEXT') & ' ' & !form.tyval.val.string()
  !toZ   = ' ' & !form.tz.selection('DTEXT') & ' ' & !form.tzval.val.string()
  !limits = !fromX & !fromY & !fromZ + ' to ' & !toX & !toY & !toZ

  if !!mdsWizard.pipe.val then
    add all bran with (purp of pspe eq 'PIPE' or purp of pspe eq 'TRAY' or purp of pspe eq 'DUCT' or purp of pspe eq 'HVAC') within $!limits
  elseif !!mdsWizard.equip.val then
    add all (equi) within $!limits
  elseif !!mdsWizard.steel.val then
    add all (SCTN GENSEC) within $!limits
  else
    add all within $!limits
  endif

endfunction
