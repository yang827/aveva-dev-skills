--
-- File:		Mdswidsctn.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Thu 24th September 1998
--
--
-- Description:
-- function to select the working element for the MDS Wizard
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R      STRING        ID or REACH
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsWidSctn(!Mode is STRING)


  if !Mode.eq('ID') then

-- Identify element, we can use any element that has a volume

    prompt off
    prompt load escape 'Identify element to use as a volume'
    id @
      handle (61,528)
          prompt dismiss
          prompt on
          return
        endhandle
      prompt on

-- if the identified element has a ileave tube then use that as the volume

    ileave tube
      handle any
      endhandle

    var !TestForVolume volume ce
      handle any
        !!Alert.Error('Identified element does not have a volume!')
        return
      endhandle

-- OK the identified element has a volume, we now have to add the reach to the volume

    !Volume = object volume()
    !Volume.volume(!!CE)
    !Volume.From.East  = !Volume.From.East - !!MdsWizard.reach.val.real()
    !Volume.To.East    = !Volume.To.East + !!MdsWizard.reach.val.real()
    !Volume.From.North = !Volume.From.North - !!MdsWizard.reach.val.real()
    !Volume.To.North   = !Volume.To.North + !!MdsWizard.reach.val.real()
    !Volume.From.Up    = !Volume.From.Up - !!MdsWizard.reach.val.real()
    !Volume.To.Up      = !Volume.To.Up + !!MdsWizard.reach.val.real()

-- Update from to gadget on form

    !!MdsWizard.FxVal.val = !Volume.From.East.String()
    !!MdsWizard.FyVal.val = !Volume.From.North.String()
    !!MdsWizard.FzVal.val = !Volume.From.Up.String()
    !!MdsWizard.TxVal.val = !Volume.To.East.String()
    !!MdsWizard.TyVal.val = !Volume.To.North.String()
    !!MdsWizard.TzVal.val = !Volume.To.Up.String()

    !!AidVolumeDraw(5000,!Volume,false)

    !!MdsWizard.SetElement = true

  elseif !Mode.eq('REACH') then

    if !!MdsWizard.SetElement.not() then
      !!Alert.error('No working element has been identified')
      return
    endif

-- Take off the last reach value and add the new

    !Tmp = !!MdsWizard.FxVal.val.real() + !!MdsWizard.LastReach.real() - !!MdsWizard.reach.val.real()
    !!MdsWizard.FxVal.val = !Tmp.String()
    !Tmp = !!MdsWizard.FyVal.val.real() + !!MdsWizard.LastReach.real() - !!MdsWizard.reach.val.real()
    !!MdsWizard.FyVal.val = !Tmp.String()
    !Tmp = !!MdsWizard.FzVal.val.real() + !!MdsWizard.LastReach.real() - !!MdsWizard.reach.val.real()
    !!MdsWizard.FzVal.val = !Tmp.String()
    !Tmp = !!MdsWizard.TxVal.val.real() - !!MdsWizard.LastReach.real() + !!MdsWizard.reach.val.real()
    !!MdsWizard.TxVal.val = !Tmp.String()
    !Tmp = !!MdsWizard.TyVal.val.real() - !!MdsWizard.LastReach.real() + !!MdsWizard.reach.val.real()
    !!MdsWizard.TyVal.val = !Tmp.String()
    !Tmp = !!MdsWizard.TzVal.val.real() - !!MdsWizard.LastReach.real() + !!MdsWizard.reach.val.real()
    !!MdsWizard.TzVal.val = !Tmp.String()

-- Reset the last reach value

    !!MdsWizard.Lastreach = !!MdsWizard.reach.val.real()

-- Update volume and box

    !From = object position()
    !From.East  = !!MdsWizard.FxVal.val.real()
    !From.North = !!MdsWizard.FyVal.val.real()
    !From.Up    = !!MdsWizard.FzVal.val.real()
    !From.Origin = world
    !To = object position()
    !To.East    = !!MdsWizard.TxVal.val.real()
    !To.North   = !!MdsWizard.TyVal.val.real()
    !To.Up      = !!MdsWizard.TzVal.val.real()
    !To.Origin = world
    !NVolume = object volume()
    !NVolume.From  = !From
    !NVolume.To    = !To

    !!AidVolumeDraw(5000,!NVolume,false)

  endif

-- End function
endfunction

-- End of file Mdswidsctn.pml
