--
-- File:		Mdswrtori.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Thursday 18th June 1998
--
--
-- Description:
-- Inserts the 'WRT /{element}' text after the first part of the orientation statement.
-- (eg: ori Y is N and Z is U WRT /* becomes ori Y is N WRT /* and Z is U WRT /*)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R         ANY          Orientation OBJECT of a relevant element
--                                or Orientation STRING of a relevant element
--
-- Return:
--    [Data Type]   [Description]
--      ANY        Input Syntax to give the CORRECT Orientation of the relevant element
--             or  ARGUMENT [1] passed to this function if NOT of the CORRECT type
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdswrtori(!ORI is ANY) is ANY

--------------------------------------------------------------------------------

-- Initialise Variables
    !objtype = !ori.objecttype()

-- Check Objecttype()

--------------------------------------------------------------------------------
    if (!objtype.eq('ORIENTATION')) then

      !origori   = '$!ori'
      !partone   = !origori.lowcase().before(' and ')
      !parttwo   = !origori.lowcase().after(' and ')

-- Get the WRT component for Orientation purposes

      !wrtcomp   = !ori.origin.name

-- Reformat the Orientation INPUT syntax to include the WRT element in BOTH parts of the ORI Command

      !stringori = !partone.upcase() & ' WRT ' & !wrtcomp & ' ' & ' and ' & !parttwo.upcase()

-- Return the Ori Command as a STRING

      return !stringori

--------------------------------------------------------------------------------
    elseif (!objtype.eq('STRING')) then

-- Check Passed STRING is PDMS Orientation Syntax

      if ( (!ori.upcase().match('Y IS ') ge(1)) or (!ori.upcase().match('X IS ') ge(1)) or (!ori.upcase().match('Z IS ') ge(1)) ) then
-- Passed STRING is an Orientation Command

        !origori = !ori

        if (!origori.upcase().occurs(' WRT ') gt (1)) then

-- Orientation already has WRT {element} against BOTH parts of the ORI Command
-- No Action Required, so Return back the Passed ARGUMENT

          return !ori

        endif

-- Determine the CORRECT ORI Input Syntax

        !partone = !origori.lowcase().before(' and ')
        !parttwo = !origori.lowcase().after(' and ')
        !wrtcomp = !origori.upcase().after(' WRT ')

-- Reformat the Orientation INPUT syntax to include the WRT element in BOTH parts of the ORI Command

        !stringori = !partone.upcase() & ' WRT ' & !wrtcomp & ' ' & ' and ' & !parttwo.upcase()

-- Return the Ori Command as a STRING

        return !stringori

      else

-- Argument is NOT an Orientation STRING so Return back the Passed ARGUMENT

        return !ori

      endif

--------------------------------------------------------------------------------
    else

-- Argument is NOT of the CORRECT Objecttype() so Return back the Passed ARGUMENT

      return !ori

    endif

--------------------------------------------------------------------------------

  endfunction
-- End function

-- End of file Mdswrtori.pml
