--
-- File:		Mdsxalign.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 29th September 1998
--
--
-- Description:
-- Function to Invoke the Alignment Utility for MDS Frameworks
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdsxalign(!form is FORM)

-- Can we move all components of the support

  if !!MdsCheckAccess(!Form,'DACMOD','POS').not() then
    !!CE = !Form.Support.Datum
      handle any
      endhandle
    return
  endif

-- Initialise variables
    call !!Mdsresetpins(1,10)
    !support  = !form.support
    !datum    = !support.datum
    !name     = !support.stru.name
    if !Form.string().eq('MDSSPECIAL').not() then
      !frame    = !name & '/MAIN'
      var !Supportframe EXISTS $!frame
    else
      var !sctns coll all sctn for $!name
      if !Sctns.size().gt(0) then
        !Supportframe = 'TRUEA'
      else
        !Supportframe = 'FALSEA'
      endif

    endif

-- Check that Datum Atta has been Created
    if (!datum.set().not())then
      !!alert.message('Datum Support Atta has NOT been created')
      return
    endif

-- Check that Support Structure has been Created
    if (!SupportFrame eq 'FALSEA')then
      !!Alert.message('Support Structure MUST be Created before invoking the Alignment Utility')
      return
    endif

-- Check that Datum Atta has been positioned
    if (!support.position.not())then
      !!alert.message('Datum Atta MUST be Positioned before invoking the Alignment Utility')
      return
    endif

-- If the framework contains trunnion members then we cannot align it because it
-- then aligns in two planes.
   !Ce = !!ce
   !InvalidMembers = FALSE
   do !Check values !Form.Support.Atta
     if (!Check.styp inset ('PIPE-REST-INLINE','AT35','AT59','AT68','GT11','GT12A','GT12B','GT27A','GT27B','ST07','ST08')) then
       !!Alert.message('Unable to align support as it has a trunnion associated with it.')
       return
     elseif (!Check.styp.matchwild('AT33*')) then
       !!Alert.message('Unable to align support as it has a trunnion associated with it.')
       return
     elseif (!Check.styp.matchwild('AT34*')) then
       !!Alert.message('Unable to align support as it has a trunnion associated with it.')
       return
     elseif (!check.styp inset ('AT60')) then
       if (!check.name.matchwild('*/DATUM')) then
         !!alert.message('Unable to align support as the DATUM atta is a pipe flange type support.')
         return
       endif
     endif
   enddo
   !!ce = !ce


-- Setup Event Driven Graphics and/or Forms
    !!currentalignform = !form
    !!gphviews.align('DISTANCE')

-- Show Support Alignment Form
    !!Mdsalign.show('at',0.69,0.42)

-- Setup Support Alignment form
    !!Mdsialign(!form)

  endfunction
-- End of function

-- End of file Mdsxalign.pml
