--
--
-- Description:
-- Centre support in centre of graphical view
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsZoomSupp(!Form is FORM)

  -- Find current units and set the distance unit to metric
    !currentunits = !!kgetsetunits()

  -- Find passed support name from passed form

  if !Form.String().upcase().eq('MDSMODIFYSUPP') or !Form.String().upcase().eq('MDSDELETESUPP') then

    if !Form.Name.val.eq('unset') then
      !!Alert.Error('No support selected to centre view through')
      !!kRestoreUnits(!currentunits)
      return
    endif
    !DatumName = !Form.Name.val + '/DATUM'
    /$!DatumName
      handle none
        !DatumPos = !!CE.Position.Wrt(WORLD)
      elsehandle any
        !DatumName = !Form.Name.val
        /$!DatumName
          handle any
            !!Alert.Error('Unable to locate support to centre view through')
            !!kRestoreUnits(!currentunits)
            return
          endhandle
        !DatumPos = !!CE.Position.Wrt(WORLD)
      endhandle
  else

    !DatumPos = !Form.Support.Datum.Position.Wrt(WORLD)
      handle any
        !!Alert.Error(|Datum atta not yet created, therefore unable to zoom to support location!|)
        !!kRestoreUnits(!currentunits)
        return
      endhandle
  endif

  -- Set new through point
  !Pos[1] = !DatumPos.East.real()
  !Pos[2] = !DatumPos.North.real()
  !Pos[3] = !DatumPos.Up.real()

  !!Gph3DDesign1.View.Through = !Pos
  !!kRestoreUnits(!currentunits)

-- End function
endfunction

-- End of file Mdszoomsupp.pml
