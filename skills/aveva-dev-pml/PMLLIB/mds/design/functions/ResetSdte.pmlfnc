define function !!ResetSdte()

cate
!cate = name
var !text coll all sdte for ce
var !eval eval rtext for all from !text
if !eval.unique().size().neq(1) then
$P Skipped $!cate
!!Alert.error('problems')
return
endif

1
!sdte = !!ce.owner.name.after('/MDS-')
name /$!sdte
!search = !sdte.after('SDTE-')

/MDS

var !find coll all spco with matchwild(name of detref,'*$!search*') for ce

var !names eval name for all from !find

do !reset values !names
  !reset.dbref().detref = /$!sdte
enddo

!size = !names.size()
$P Modified $!size

/$!sdte

end
!members = mem count

do !delete from $!members to 2 by -1
  $!delete
  delete sdte
enddo

nex

endfunction
