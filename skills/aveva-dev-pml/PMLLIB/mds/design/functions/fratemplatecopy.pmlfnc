--
-- Description:
-- Function for Copying a MDS Framework
--
--------------------------------------------------------------------------------
  define function !!fratemplatecopy()

    /FRA/TEMPLATES
    handle ANY
      return
    endhandle

    var !zones collect all zones for ce

    do !val values !zones
      !!ce = !val.dbref()
      !zn  = !!ce.name.replace('/FRAMES','')
      last stru

      new stru $!<zn>/4 copy $!<zn>/1 rename $!<zn>/1 $!<zn>/4
      var !s1 coll all for ce
      do !v1 values !s1
        !!ce = !v1.dbref()
        matref /STAINLESS/STEEL
        handle ANY
          skip
        endhandle
      enddo
      stru

      new stru $!<zn>/5 copy $!<zn>/2 rename $!<zn>/2 $!<zn>/5
      var !s2 coll all for ce
      do !v2 values !s2
        !!ce = !v2.dbref()
        matref /STAINLESS/STEEL
        handle ANY
          skip
        endhandle
      enddo
      stru

      new stru $!<zn>/6 copy $!<zn>/3 rename $!<zn>/3 $!<zn>/6
      var !s3 coll all for ce
      do !v3 values !s3
        !!ce = !v3.dbref()
        matref /STAINLESS/STEEL
        handle ANY
          skip
        endhandle
      enddo
      stru

    enddo

--------------------------------------------------------------------------------
-- End of Function - !!fratemplatecopy
  endfunction
