  define function !!fratemplatedesc()

    /FRA/TEMPLATES
    handle ANY
      return
    endhandle

    var !stru collect all (stru) for ce

    do !val values !stru
      !!ce = !val.dbref()
      skip if (!!ce.name.matchwild('*/1'))
      skip if (!!ce.name.matchwild('*/2'))
      skip if (!!ce.name.matchwild('*/3'))
      !desc = !!ce.description
      !desc = !desc & ' (SS)'
      !!ce.description = !desc
      q name type desc
    enddo

--------------------------------------------------------------------------------
-- End of Function - !!fratemplatedesc()
  endfunction
