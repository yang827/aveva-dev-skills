  define function !!fratemplatemove()

    /FRA/TEMPLATES
    handle ANY
      return
    endhandle

    var !mem collect all (sctn fitt sjoi) for ce

    do !val values !mem
      !!ce = !val.dbref()
      skip if (!!ce.matref.neq(=0/0))
      matref /CARBON/STEEL

    enddo

--------------------------------------------------------------------------------
-- End of Function - !!fratemplatemove
  endfunction
