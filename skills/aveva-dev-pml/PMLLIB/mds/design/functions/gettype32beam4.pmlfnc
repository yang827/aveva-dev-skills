--
-- File:    gettype32beam4.pmlfnc
--   Type:    Object Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    R.Martin
-- Created:   January 2010
--
--
-- Description:
-- select channel 2 for a type 32 hanger (second beam of second channel pair)
-- input
-- (1) the dbref of the first channel beam that was selected for the type 32 hanger
-- (2) a list of suitable steelwork types that the selected steelwork must match
-- output
-- (1) the dbref of the suitable section
------------------------------------------------------------------------

-- Define function
define function !!gettype32beam4(!beam1Ref is DBREF, !allowableBeamTypes is STRING) is DBREF

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist

  --do the selection process until we break with a suitable beam type or error and return
  do
    !beamType = ''
    !prompt = 'Identify channel 2 of second channel pair to connect hanger to'

    if defined(!!licadautotestenabled) then
      !!ce = !!licadautotest.steel
    else
      prompt off
      prompt load escape '$!prompt'
      ID BOX SCTN FLOOR WALL GWALL SCREED CSCREED CWALL PANE CFLOOR @
      handle ANY
        prompt on
        !!kRestoreUnits(!currentUnits)
        return error 1 '$!!error.text'
      endhandle
    endif

    !steelRef = !!ce

    if !steelRef.eq(!beam1Ref) then
      !!alert.message('selection of this member has already been made please choose another')
      skip
    endif

    !type = !steelRef.gtype
    handle ANY
      skip
    endhandle

    if (!!ce.hardtype eq 'PANE') then
      !type = 'PANE'
    endif

    if(!type.eq(''))then
      !type = 'BEAM'
    endif
    !beamType = !beamType + !type

    if (!allowableBeamTypes.match(!beamType).gt(0)) then
      --we have a valid section so break so that we can return !steelRef
      break
    else
      !!alert.message('Beam of type $!beamType is not suitable for this type of hanger')
      skip
    endif
  enddo

  !!kRestoreUnits(!currentUnits)
  return !steelRef

endmethod
