-- File:    initForms.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   mds
--   Module:    design
--   Replaces:
--
-- Author:    R.Martin
-- Created:   16/02/2010
--
--
-- Description:
-- Initialises all of the required forms for the mds hanger interfaces
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!initForms(!type is STRING)

  --!type is used to figure out which hanger forms we want to load/reload
  --if !type == 'ALL' then all types will be loaded

  --init !!mdsinterfacehanger
  if undefined(!!mdsinterfacehanger) then
    pml load form !!mdsinterfacehanger
  endif

  --initialise required forms start with mdshangertype
  if undefined(!!mdsHangerType1) and !type.eq('ALL') or !type.eq('TYPE1') then
    pml load form !!mdsHangerType1
  elseif !type.eq('TYPE1') or !type.eq('ALL') then
    pml reload form !!mdsHangerType1
  endif

  if undefined(!!mdsHangerType2) and !type.eq('ALL') or !type.eq('TYPE2') then
    pml load form !!mdsHangerType2
  elseif !type.eq('TYPE2') or !type.eq('ALL') then
    pml reload form !!mdsHangerType2
  endif

  if undefined(!!mdsHangerType6) and !type.eq('ALL') or !type.eq('TYPE6') then
    pml load form !!mdsHangerType6
  elseif !type.eq('TYPE6') or !type.eq('ALL') then
    pml reload form !!mdsHangerType6
  endif

  if undefined(!!mdsHangerType7) and !type.eq('ALL') or !type.eq('TYPE7') then
    pml load form !!mdsHangerType7
  elseif !type.eq('TYPE7') or !type.eq('ALL') then
    pml reload form !!mdsHangerType7
  endif

  if undefined(!!mdsHangerType18) and !type.eq('ALL') or !type.eq('TYPE18') then
    pml load form !!mdsHangerType18
  elseif !type.eq('TYPE18') or !type.eq('ALL') then
    pml reload form !!mdsHangerType18
  endif

  if undefined(!!mdsHangerType19) and !type.eq('ALL') or !type.eq('TYPE19') then
    pml load form !!mdsHangerType19
  elseif !type.eq('TYPE19') or !type.eq('ALL') then
    pml reload form !!mdsHangerType19
  endif

  if undefined(!!mdsHangerType20) and !type.eq('ALL') or !type.eq('TYPE20') then
    pml load form !!mdsHangerType20
  elseif !type.eq('TYPE20') or !type.eq('ALL') then
    pml reload form !!mdsHangerType20
  endif

  if undefined(!!mdsHangerType21) and !type.eq('ALL') or !type.eq('TYPE21') then
    pml load form !!mdsHangerType21
  elseif !type.eq('TYPE21') or !type.eq('ALL') then
    pml reload form !!mdsHangerType21
  endif

  if undefined(!!mdsHangerType25) and !type.eq('ALL') or !type.eq('TYPE25') then
    pml load form !!mdsHangerType25
  elseif !type.eq('TYPE25') or !type.eq('ALL') then
    pml reload form !!mdsHangerType25
  endif

  if undefined(!!mdsHangerType31) and !type.eq('ALL') or !type.eq('TYPE31') then
    pml load form !!mdsHangerType31
  elseif !type.eq('TYPE31') or !type.eq('ALL') then
    pml reload form !!mdsHangerType31
  endif

  if undefined(!!mdsHangerType32) and !type.eq('ALL') or !type.eq('TYPE32') then
    pml load form !!mdsHangerType32
  elseif !type.eq('TYPE32') or !type.eq('ALL') then
    pml reload form !!mdsHangerType32
  endif

  if undefined(!!mdsHangerType600) and !type.eq('ALL') or !type.eq('TYPE600') then
    pml load form !!mdsHangerType600
  elseif !type.eq('TYPE600') or !type.eq('ALL') then
    pml reload form !!mdsHangerType600
  endif

  --initialise the vendor forms
  if undefined(!!mdsVendorHangerType1) and !type.eq('ALL') or !type.eq('TYPE1') then
    pml load form !!mdsVendorHangerType1
  elseif !type.eq('TYPE1') or !type.eq('ALL') then
    pml reload form !!mdsVendorHangerType1
  endif

  if undefined(!!mdsVendorHangerType2) and !type.eq('ALL') or !type.eq('TYPE2') then
    pml load form !!mdsVendorHangerType2
  elseif !type.eq('TYPE2') or !type.eq('ALL') then
    pml reload form !!mdsVendorHangerType2
  endif

  if undefined(!!mdsVendorHangerType6) and !type.eq('ALL') or !type.eq('TYPE6') then
    pml load form !!mdsVendorHangerType6
  elseif !type.eq('TYPE6') or !type.eq('ALL') then
    pml reload form !!mdsVendorHangerType6
  endif

  if undefined(!!mdsVendorHangerType7) and !type.eq('ALL') or !type.eq('TYPE7') then
    pml load form !!mdsVendorHangerType7
  elseif !type.eq('TYPE7') or !type.eq('ALL') then
    pml reload form !!mdsVendorHangerType7
  endif

  if undefined(!!mdsVendorHangerType18) and !type.eq('ALL') or !type.eq('TYPE18') then
    pml load form !!mdsVendorHangerType18
  elseif !type.eq('TYPE18') or !type.eq('ALL') then
    pml reload form !!mdsVendorHangerType18
  endif

  if undefined(!!mdsVendorHangerType19) and !type.eq('ALL') or !type.eq('TYPE19') then
    pml load form !!mdsVendorHangerType19
  elseif !type.eq('TYPE19') or !type.eq('ALL') then
    pml reload form !!mdsVendorHangerType19
  endif

  if undefined(!!mdsVendorHangerType20) and !type.eq('ALL') or !type.eq('TYPE20') then
    pml load form !!mdsVendorHangerType20
  elseif !type.eq('TYPE20') or !type.eq('ALL') then
    pml reload form !!mdsVendorHangerType20
  endif

  if undefined(!!mdsVendorHangerType21) and !type.eq('ALL') or !type.eq('TYPE21') then
    pml load form !!mdsVendorHangerType21
  elseif !type.eq('TYPE21') or !type.eq('ALL') then
    pml reload form !!mdsVendorHangerType21
  endif

  if undefined(!!mdsVendorHangerType25) and !type.eq('ALL') or !type.eq('TYPE25') then
    pml load form !!mdsVendorHangerType25
  elseif !type.eq('TYPE25') or !type.eq('ALL') then
    pml reload form !!mdsVendorHangerType25
  endif

  if undefined(!!mdsVendorHangerType31) and !type.eq('ALL') or !type.eq('TYPE31') then
    pml load form !!mdsVendorHangerType31
  elseif !type.eq('TYPE31') or !type.eq('ALL') then
    pml reload form !!mdsVendorHangerType31
  endif

  if undefined(!!mdsVendorHangerType32) and !type.eq('ALL') or !type.eq('TYPE32') then
    pml load form !!mdsVendorHangerType32
  elseif !type.eq('TYPE32') or !type.eq('ALL') then
    pml reload form !!mdsVendorHangerType32
  endif

  if undefined(!!mdsVendorHangerType600) and !type.eq('ALL') or !type.eq('TYPE600') then
    pml load form !!mdsVendorHangerType600
  elseif !type.eq('TYPE600') or !type.eq('ALL') then
    pml reload form !!mdsVendorHangerType600
  endif

  --init !!mdsInterfaceDynOffset
  if undefined(!!mdsInterfaceDynOffset) then
    pml load form !!mdsInterfaceDynOffset
  else
    pml reload form !!mdsInterfaceDynOffset
  endif

  --init !!mdsinterfacehanger
  if undefined(!!qryUserAcr) then
    pml load form !!qryUserAcr
  endif

endfunction
