--
-- File:    kcalcorthdir.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    Andrew Kirkland
-- Created:   Wed 10th June 1998
--
--
-- Description:
-- Function to calculate the direction of the pipe/tube taking account of
-- the slope.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         [DBREF]     [Atta to calculate direction]
--
-- Return:
--    [Data Type]   [Description]
--    [DIRECTION]   [Horizontal direction of the atta passed]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!kCalcOrthDir(!atta is DBREF) is DIRECTION

-- save origin
   !refe = !!ce
   !direction = object DIRECTION()
-- goto passed atta
   !!ce = !atta
   !pos = !atta.position.wrt(/* )

if !atta.type.neq('CTSUPP') then
-- geometric calculation to find direction
   var !paToPl const line pl to pa
   handle any
   -- in case passed dbref is not a piping component
      !!alert.error('Passed element is not a piping component')
      return !direction
   endhandle
   var !hori const line project $!paToPl on plane U thro $!pos
   var !dir const dir $!hori
   handle any
   -- in case it is u/d
      !direction = pl dir wrt worl
   elsehandle none
-- convert string to Direction

   !direction = !dir.direction()
   endhandle
-- return to origin
else
    !p2Dir = p2dir wrt worl
    --!ori = object ORIENTATION()
    --!ori.origin = /*
    --!ori.alpha = 0
    --!ori.beta = 0
    --!ori.gamma = 0
    !plane = object PLANE(!pos,y is n and z is u)
    !direction = !p2Dir.projected(!plane)
endif

!!ce = !refe

return !direction

-- End function
endfunction
