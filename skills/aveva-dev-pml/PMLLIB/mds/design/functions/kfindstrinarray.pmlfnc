--
--
-- Description:
-- Function to extract available jlines to use.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--    [1]   R        [ARRAY]       [array to search]
--    [2]   R        [STRING]      [Find string]
--    [3]   R        [STRING]      [First occurrence, All Occurrences]
-- Return:
--    [Data Type]   [Description]
--    [Array]       [indices of array string found]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!KFindStrInArray(!Array is Array, !String is string, !Option is string) is array

  -- Initialise Variables
  -- *******do for first occurence for now*********

  !Find = array()

  do !i indices !Array

     if(!Array[!i].upcase().match(!String.upcase()).neq(0)) then
        !Find.append(!i)
         if(!Option.eq('FIRST')) then
           break
         else
          -- should do it
         endif
     endif

  enddo



Return !Find



-- End function
endfunction

-- End of file kFindStrInArray.pml
