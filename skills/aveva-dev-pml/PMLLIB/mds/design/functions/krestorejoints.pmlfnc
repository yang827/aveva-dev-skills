--
-- File:		kRestoreJoints.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Andrew Kirkland
-- Created:		Wed 1st July 1998
--
--
-- Description:
-- Function to restore joints when cancel is used
-- I have put the attributes into an array to keep restoreforms tidy
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1    [R]      [ARRAY]       [Joints to save or restore]
--     2    [RW]     [ARRAY]       [Array of saved attributes]
--     3    [R]      [STRING]      [Save or restore connections]
--     4    [R]      [STRING]      [Whether called from cancel or not]
-- Return:
--    [Data Type]   [Description]
--    [BOOLEAN]     [Set true when savings joints that exist and false
--                   when restoring]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!KRestoreJoints(!Joints is array, !Array is array, !Option is string, !cancel is string) is boolean

  -- Initialise Variables

   !HaveJoints   = FALSE

   !!MDSDacControl(true)

if(!Option.eq('SAVE')) then

      !HaveJoints = TRUE

     do !ind indices !Joints
      !Array[!ind][1]  = posl of $!Joints[$!Ind]

-- best as a string
      var !dummy   Desp of $!Joints[$!Ind]
      !Array[!Ind][2] = !Dummy

      !Array[!Ind][3]  = Bang of $!Joints[$!Ind]
      !Array[!Ind][4]  = spref of $!Joints[$!Ind]
      !Array[!Ind][5]  = Jline of $!Joints[$!Ind]
      if(!Array[!ind][5].eq('')) then
        !Array[!Ind][5] = 'unset'
      endif

      !Array[!Ind][6]  = cutp of $!Joints[$!Ind]
      !Array[!ind][7]  = cutb of $!Joints[$!Ind]
      !Array[!Ind][8]  = !Joints[!Ind].cref.name
      !Array[!Ind][9]  = !Joints[!Ind].cref.joie
      !Array[!Ind][10] = !Joints[!Ind].cref.jois
     enddo

---------------------------------------------------------------------------------

else

    do !i indices !Joints
          -- goto by name cos its been deleted once
          $!Joints[$!i]
        if(!Cancel.upcase().neq('CANCEL')) then
        -- if cancel then use stored values in the form
          POSL  $!Array[$!i][1]
          DESP  $!Array[$!i][2]
          BANG  $!Array[$!i][3]
          SPREF $!Array[$!i][4]
          JLINE $!Array[$!i][5]
          handle any
            -- errors if var jlin is unset
          endhandle
          CUTP  $!Array[$!i][6]
          CUTB  $!Array[$!i][7]
       endif
          $!Array[$!i][8]
          handle (2,109) $* Undefined Name (for FT15)
            skip
          endhandle
         -- find out which is closest
            !WhichEnd = !!MdsNearestEnd(!Joints[!i], !Array[!i][8].dbref())

         if(!WhichEnd.eq('START')) then
             JOIS $!Joints[$!i]
             !Joie = JOIE
             !Jois = JOIS
              -- revisit this will give sctns zero length when  mirroring supports
               if(!Joie.eq(!jois)) then
                 JOIE nulref
               endif
         else
             JOIE $!Joints[$!i]
             !Jois = JOIS
             !Joie = JOIE
               if(!Joie.eq(!jois)) then
                  JOIS nulref
               endif
         endif
    enddo

endif

   !!MDSDacControl(false)

Return !HaveJoints

-- End function
endfunction

-- End of file kRestoreJoints.pml
