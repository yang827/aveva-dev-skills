--------------------------------------------------------------------------------
--
-- File:      mds116DesignFor12Upgrade.pmlfnc
--   Type:    Function
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Design
--   Replaces:
--
-- Author:    Wayne Dodwell
-- Created:   Tuesday 25th August 2009
--
-- Description:
-- 1. Function to determine the MDS ATTAS and PLAT Elements in a MDB
---2. Store the SPREF NAME of ALL EXISTING MDS116 ATTA Elements
---3. Store the UDA :MDSMatref of ALL EXISTING MDS116 ATTA Elements
--
--------------------------------------------------------------------------------
--
define function !!mds116DesignFor12Upgrade()

---------------------------------------------------------------------------------------------------
--START of PART <1A>

-- Initialise the Collection Object data for the MDS ATTA and PLAT Element Types
  !type  = |ATTA PLAT|
  !filt  = object EXPRESSION('matchwild ( name of spref , |/MD?/*| )')
--  !SCOPE = ARRAY()
--  !SCOPE.APPEND(/* )

-- Collect ALL of the MDS116 ATTA and PLAT Elements
  !data  = object COLLECTION()
  !data.filter(!filt)
  !data.scope()
  !data.type(!type)

-- Collection Results Array contains MDS116 ATTA and PLAT DBREFS
-- Initialise the MAIN MDS116 ATTA Array
  !mds116AttaResults = ARRAY()

--ARRAY of MDS116 ATTA or PLAT DBREF Elements
  !mds116AttaResults[1] = !data.results()

--ARRAY of MDS116 ATTA or PLAT SPREF Names
  !mds116AttaResults[2] = ARRAY()

--ARRAY of MDS116 ATTA or PLAT :MDSMatref Names
  !mds116AttaResults[3] = ARRAY()

-- Check Array Size and Process
  if (!mds116AttaResults[1].size().gt(0)) then

-- Process the MDS116 ATTA and PLAT DBREF Elements Array !mds116AttaResults[1]
    do !index indices !mds116AttaResults[1]

-- Populate the MDS116 ATTA and PLAT SPREF Name Array !mds116AttaResults[2]
      !mds116AttaResults[2][!index]  = !mds116AttaResults[1][!index].spref.name
      handle ANY
-- Current MDS116 ATTA and PLAT SPREF Value is unset so store 'default' as the current value
        !mds116AttaResults[3][!index] = 'default'
      endhandle

-- Populate the MDS116 ATTA and PLAT UDA :MDSMatref Name Array !mds116AttaResults[3]
      !mds116AttaResults[3][!index] = !mds116AttaResults[1][!index].:MDSMatref.name
      handle ANY
-- Current MDS116 ATTA and PLAT UDA :MDSMatref Value is unset so store 'default' as the current value
        !mds116AttaResults[3][!index] = 'default'
      endhandle

    enddo

  else
-- NO MDS116 ATTA and PLAT DBREF Elements Found
    !!alert.error('ERROR: The current MDB does NOT contain ANY MDS116 ATTA DBREF elements.
    Therefore the current project will be NOT require to be UPGRADED in the MDS application DESIGN module in the 12 version of the project')

  endif
-- END of PART <1A>
---------------------------------------------------------------------------------------------------
-- START of PART <1B>

-- Store all the MDS116 ATTA and PLAT Attribute Values in an INPUT FILE type PDMS Macro in the Project
-- Initialise Variables
  !project = current project
  !prjCode = !project.code()
  !session = current session
  !user    = !session.user().name
  !mdbName = !session.mdb().name

-- Get the Start DATE & TIME Object Data
  !dateTime  = object MDSDATETIMEOBJ()
  !mdsDate = !dateTime.datestring
  !mdsTime = !dateTime.timestring

-- Determine the Project INFO directory and the MDS116 ATTA and PLAT Attributes MACRO FILE as the Storage Directory
-- Store the MDS116 ATTA and PLAT Attribute MACRO FILE in the %$!<prjCode>INFO% or %PDMSUSER% Directory LOCATION
  !infoDir = object FILE(|%$!<prjCode>info%|)
  if (!infoDir.exists()) then
    !mds12dir = object FILE(|%$!<prjCode>info%\MDS12DesignAttaUpgrade|)
    if (!mds12dir.exists().not()) then
-- Create the Atta Upgrade Directory
      syscom |MKDIR $!mds12dir|
    endif

  else
-- ONLY when the MDS PROJECT INFO Directory DOES NOT EXIST, i.e. !infoDir
-- Use the %PDMSUSER% Directory to create the MDS116 ATTA and PLAT Attribute MACRO FILE as the Storage Directory
    !mds12dir = object FILE(|%pdmsuser%\MDS12DesignAttaUpgrade|)
    if (!mds12dir.exists().not()) then
-- Create the ATTA and PLAT Upgrade Directory
      syscom |MKDIR $!mds12dir|
    endif
  endif

-- Create the MDS116 DESIGN ATTA and PLAT Attribute to MDS12 DESIGN ATTA and PLAT Attributes UPGRADE MACRO FILE
  !mds12DesignAttaFile = object FILE(|$!<mds12dir>/MDS116-to-MDS12-DESIGN-ATTA-UPGRADE-MACRO-$!<mdsDate>-$!<mdsTime>.pmlmac|)

-- Write the File HEADER for the MDS116 DESIGN ATTA and PLAT Attribute to MDS12 DESIGN ATTA and PLAT Attributes UPGRADE MACRO FILE
  !mds12DesignAttaFileArray = ARRAY()
  !mds12DesignAttaFileArray.append(|--|)
  !mds12DesignAttaFileArray.append(|--#####################################################################################################|)
  !mds12DesignAttaFileArray.append(|--#|)
  !mds12DesignAttaFileArray.append(|--#    ************************************************************************************************************************************|)
  !mds12DesignAttaFileArray.append(|--#    **** STARTED **** Writing the MDS116 DESIGN ATTA and PLAT Attribute to MDS12 DESIGN ATTA and PLAT Attributes UPGRADE MACRO FILE ****|)
  !mds12DesignAttaFileArray.append(|--#    ************************************************************************************************************************************|)
  !mds12DesignAttaFileArray.append(|--#|)
  !mds12DesignAttaFileArray.append(|--# -- File Name      : $!<mds12dir>/MDS116-to-MDS12-DESIGN-ATTA-UPGRADE-MACRO-$!<mdsDate>-$!<mdsTime>.pmlmac|)
  !mds12DesignAttaFileArray.append(|--# -- File Description: MDS116 DESIGN ATTA and PLAT Attribute to MDS12 DESIGN ATTA and PLAT Attributes UPGRADE MACRO FILE|)
  !mds12DesignAttaFileArray.append(|--#|)
  !mds12DesignAttaFileArray.append(|--# -- PDMS Project   : $!prjCode |)
  !mds12DesignAttaFileArray.append(|--# -- MDB Name       : $!mdbName |)
  !mds12DesignAttaFileArray.append(|--# -- Login ID       : $!session.login |)
  !mds12DesignAttaFileArray.append(|--# -- PDMS User      : $!user |)
  !mds12DesignAttaFileArray.append(|--# -- PDMS Process ID: $!session.uniqueid() |)
  !mds12DesignAttaFileArray.append(|--#|)
  !mds12DesignAttaFileArray.append(|--# -- Date           : $!mdsDate |)
  !mds12DesignAttaFileArray.append(|--# -- Time           : $!mdsTime |)
  !mds12DesignAttaFileArray.append(|--#|)
  !mds12DesignAttaFileArray.append(|--##########################################|)
  !mds12DesignAttaFileArray.append(|--#    ********************************    #|)
  !mds12DesignAttaFileArray.append(|--#    *** SEE IMPORTANT NOTE BELOW ***    #|)
  !mds12DesignAttaFileArray.append(|--#    ********************************    #|)
  !mds12DesignAttaFileArray.append(|--##########################################|)
  !mds12DesignAttaFileArray.append(|--#|)
  !mds12DesignAttaFileArray.append(|--#    *** BEFORE RUNNING this UPGRADE MACRO *** in the 12 version of the PDMS PROJECT, the following MUST have already been COMPLETED|)
  !mds12DesignAttaFileArray.append(|--#    STEP No.<1> - The current PDMS 11.6 project $!prjCode MUST have been successfully UPGRADED to a PDMS12 Project version via the STANDARD AVEVA PDMS 12 Project UPGRADE MACRO|)
  !mds12DesignAttaFileArray.append(|--#    STEP No.<2> - The current project MUST be a PDMS 12 version project and the MDS12 DEFAULTS UPGRADE MUST have been successfully COMPLETED in the PARAGON MODULE |)
  !mds12DesignAttaFileArray.append(|--#|)
  !mds12DesignAttaFileArray.append(|--#    *** ONLY RUN this UPGRADE MACRO *** via the COMMAND LINE in the 12 version of the PDMS Project |)
  !mds12DesignAttaFileArray.append(|--#     in the MDS DESIGN Application AFTER successfully completing STEP No.<1> and then STEP No.<2> shown above |)
  !mds12DesignAttaFileArray.append(|--#|)
  !mds12DesignAttaFileArray.append(|--#####################################################################################################|)
  !mds12DesignAttaFileArray.append(|--|)

-- OPEN and CLOSE the UPGRADE file
  !mds12DesignAttaFile.open(|WRITE|)
  !mds12DesignAttaFile.writerecord(||)
  !mds12DesignAttaFile.close()
  handle ANY
  endhandle

-- Append to the ARRAY to OPEN the ALPHA LOG FILE for CAPTURING MDS12 ATTA and PLAT UPGRADE OUTPUT in the MDS12 UPGRADE LOG FILE
  !mds12DesignAttaFileArray.append(|--______________________________________________________________________|)
  !mds12DesignAttaFileArray.append(|--|)
  !mds12DesignAttaFileArray.append(|  alpha log end|)
  !mds12DesignAttaFileArray.append(|  handle ANY|)
  !mds12DesignAttaFileArray.append(|  endhandle|)
  !mds12DesignAttaFileArray.append(|  alpha log /$!<mds12dir>/MDS12-DESIGN-ATTA-UPGRADE-LOG-FILE-$!<mdsDate>-$!<mdsTime>.pmllog|)
  !mds12DesignAttaFileArray.append(|   $P <START of MDS12 DESIGN Module PROJECT UPGRADE LOG FILE>|)
  !mds12DesignAttaFileArray.append(|--______________________________________________________________________|)

-- Now Write the contents of UPGRADE MACRO FILE to be RUN in the MDS12 version of the current project to UPGRADE the necessary MDS12 ATTA Attributes
-- i.e. the MDS12 ATTA and PLAT Attributes SPREF and from MDS116 the UDA :MDSMatref to the new MDS12 ATTA Matref standard Attribute
--
-- START the Processing of the !mds116AttaResults Array
  do !count indices !mds116AttaResults[1]
--$P-----------------------------------------------------------------------------------
--$P ***  Processing the MDS ATTA/PLAT Name = $!mds116AttaResults[1][$!count].name ***
--$P
-- Append Message for each ATTA to the MDS UPGRADE MACRO File
    !mds12DesignAttaFileArray.append(|--______________________________________________________________________|)
    !mds12DesignAttaFileArray.append(|--  Processing the MDS ATTA/PLAT Name = $!mds116AttaResults[1][$!count].name |)
    !mds12DesignAttaFileArray.append(|--|)
    !mds12DesignAttaFileArray.append(|-- Navigate to the MDS12 ATTA/PLAT|)
    !mds12DesignAttaFileArray.append(|  !!ce = $!mds116AttaResults[1][$!count].name|)
    !mds12DesignAttaFileArray.append(|  handle ANY|)
    !mds12DesignAttaFileArray.append(|  endhandle|)
    !mds12DesignAttaFileArray.append(|--|)
    !mds12DesignAttaFileArray.append(|-- Reset the SPREF Attribute of the MDS12 ATTA/PLAT|)
    !mds12DesignAttaFileArray.append(|  SPREF $!mds116AttaResults[2][$!count]|)
    !mds12DesignAttaFileArray.append(|  handle ANY|)
    !mds12DesignAttaFileArray.append(|  endhandle|)
    !mds12DesignAttaFileArray.append(|--|)
    !mds12DesignAttaFileArray.append(|-- Reset the ATTA MATREF Attribute or leave the PLAT UDA :MDSMatref Attribute as is from the MDS 116 UDA :MDSMatref for the MDS12 ATTA/PLAT|)
    !mds12DesignAttaFileArray.append(|  MATREF $!mds116AttaResults[3][$!count]|)
    !mds12DesignAttaFileArray.append(|  handle ANY|)
    !mds12DesignAttaFileArray.append(|  endhandle|)
    !mds12DesignAttaFileArray.append(|--|)
    !mds12DesignAttaFileArray.append(|--|)

  enddo
-- END the Processing of the !mds116AttaResults Array

-- Append to the ARRAY to CLOSE the ALPHA LOG FILE for CAPTURING MDS12 ATTA and PLAT UPGRADE OUTPUT in the MDS12 UPGRADE LOG FILE
  !mds12DesignAttaFileArray.append(|--______________________________________________________________________|)
  !mds12DesignAttaFileArray.append(|--|)
  !mds12DesignAttaFileArray.append(|   $P|)
  !mds12DesignAttaFileArray.append(|   $P *** If there are NO SCREEN ERRORS and the UPGRADE LOG FILE is EMPTY the MDS ATTA and PLAT DESIGN Module PROJECT UPGRADE was SUCCESSFUL *** |)
  !mds12DesignAttaFileArray.append(|   $P|)
  !mds12DesignAttaFileArray.append(|--|)
  !mds12DesignAttaFileArray.append(|   $P <END of MDS12 DESIGN Module PROJECT UPGRADE LOG FILE>|)
  !mds12DesignAttaFileArray.append(|  alpha log end|)
  !mds12DesignAttaFileArray.append(|--______________________________________________________________________|)

-- Get the Finish DATE & TIME Object Data
  !xDateTime  = object MDSDATETIMEOBJ()
  !xDate = !xDateTime.datestring
  !xTime = !xDateTime.timestring

-- Write the File FOOTER for the MDS116 DESIGN ATTA and PLAT Attribute to MDS12 DESIGN ATTA and PLAT Attributes UPGRADE MACRO FILE
  !mds12DesignAttaFileArray.append(|--______________________________________________________________________|)
  !mds12DesignAttaFileArray.append(|--|)
  !mds12DesignAttaFileArray.append(|--#####################################################################################################|)
  !mds12DesignAttaFileArray.append(|--#|)
  !mds12DesignAttaFileArray.append(|--#    *************************************************************************************************************************************|)
  !mds12DesignAttaFileArray.append(|--#    **** FINISHED **** Writing the MDS116 DESIGN ATTA and PLAT Attribute to MDS12 DESIGN ATTA and PLAT Attributes UPGRADE MACRO FILE ****|)
  !mds12DesignAttaFileArray.append(|--#    *************************************************************************************************************************************|)
  !mds12DesignAttaFileArray.append(|--#|)
  !mds12DesignAttaFileArray.append(|--# -- UPGRADE MACRO File Name: $!<mds12dir>/MDS116-to-MDS12-DESIGN-ATTA-UPGRADE-MACRO-$!<mdsDate>-$!<mdsTime>.pmlmac|)
  !mds12DesignAttaFileArray.append(|--# --         File Description: MDS116 DESIGN ATTA and PLAT Attribute to MDS12 DESIGN ATTA and PLAT Attributes UPGRADE MACRO FILE|)
  !mds12DesignAttaFileArray.append(|--#|)
  !mds12DesignAttaFileArray.append(|--# -- PDMS Project   : $!prjCode |)
  !mds12DesignAttaFileArray.append(|--# -- MDB Name       : $!mdbName |)
  !mds12DesignAttaFileArray.append(|--#|)
  !mds12DesignAttaFileArray.append(|--#|)
  !mds12DesignAttaFileArray.append(|--#    ************************|)
  !mds12DesignAttaFileArray.append(|--#    ***    STARTED at    ***|)
  !mds12DesignAttaFileArray.append(|--#    *** Date: $!<mdsDate> ***|)
  !mds12DesignAttaFileArray.append(|--#    *** Time: $!<mdsTime> ***|)
  !mds12DesignAttaFileArray.append(|--#    ************************|)
  !mds12DesignAttaFileArray.append(|--#    ***    FINISHED at   ***|)
  !mds12DesignAttaFileArray.append(|--#    ***  Date: $!<xDate>  ***|)
  !mds12DesignAttaFileArray.append(|--#    ***  Time: $!<xTime>  ***|)
  !mds12DesignAttaFileArray.append(|--#    ************************|)
  !mds12DesignAttaFileArray.append(|--#|)
  !mds12DesignAttaFileArray.append(|--##########################################|)
  !mds12DesignAttaFileArray.append(|--#    ********************************    #|)
  !mds12DesignAttaFileArray.append(|--#    *** SEE IMPORTANT NOTE BELOW ***    #|)
  !mds12DesignAttaFileArray.append(|--#    ********************************    #|)
  !mds12DesignAttaFileArray.append(|--##########################################|)
  !mds12DesignAttaFileArray.append(|--#|)
  !mds12DesignAttaFileArray.append(|--#    *** BEFORE RUNNING this UPGRADE MACRO *** in the 12 version of the PDMS PROJECT, the following MUST have already been COMPLETED|)
  !mds12DesignAttaFileArray.append(|--#    STEP No.<1> - The current PDMS 11.6 project $!prjCode MUST have been successfully UPGRADED to a PDMS12 Project version via the STANDARD AVEVA PDMS 12 Project UPGRADE MACRO|)
  !mds12DesignAttaFileArray.append(|--#    STEP No.<2> - The current project MUST be a PDMS 12 version project and the MDS12 DEFAULTS UPGRADE MUST have been successfully COMPLETED in the PARAGON MODULE |)
  !mds12DesignAttaFileArray.append(|--#|)
  !mds12DesignAttaFileArray.append(|--#    *** ONLY RUN this UPGRADE MACRO *** via the COMMAND LINE in the 12 version of the PDMS Project |)
  !mds12DesignAttaFileArray.append(|--#     in the MDS DESIGN Application AFTER successfully completing STEP No.<1> and then STEP No.<2> shown above |)
  !mds12DesignAttaFileArray.append(|--#|)
  !mds12DesignAttaFileArray.append(|--#    *** RUN this UPGRADE MACRO from the COMMAND LINE in the DESIGN MODULE of the UPGRADED 12 PDMS PROJECT *** $!prjCode *** |)
  !mds12DesignAttaFileArray.append(|--#    i.e.|)
  !mds12DesignAttaFileArray.append(|--#    $M/$!<mds12DesignAttaFile> |)
  !mds12DesignAttaFileArray.append(|--#|)
  !mds12DesignAttaFileArray.append(|--#####################################################################################################|)
  !mds12DesignAttaFileArray.append(|--|)
  !mds12DesignAttaFileArray.append(|--|)
  !mds12DesignAttaFileArray.append(|    !!alert.message('The MDS12 DESIGN Module PROJECT UPGRADE MACRO has COMPLETED. See the UPGRADE LOG file: $!<mds12dir>/MDS12-DESIGN-ATTA-UPGRADE-LOG-FILE-$!<mdsDate>-$!<mdsTime>.pmllog')|)
  !mds12DesignAttaFileArray.append(|--|)
  !mds12DesignAttaFileArray.append(|--|)
  !mds12DesignAttaFileArray.append(|--<EOF>|)

-- Write the UPGRADE MACRO FILE for the COMPLTE MDS116 DESIGN ATTA and PLAT Attribute to MDS12 DESIGN ATTA and PLAT Attributes
  !mds12DesignAttaFile.writefile(|APPEND|,!mds12DesignAttaFileArray)
  !mds12DesignAttaFile.close()
  handle ANY
  endhandle
-- END of PART <1B>
---------------------------------------------------------------------------------------------------

-- Issue an Alert Message to the USER to advise the COMPLETION of the WRITING the UPGRADE MACRO file
  !!alert.message(|The writing of the MDS116 DESIGN ATTA and PLAT Attributes to MDS12 DESIGN ATTA and PLAT Attributes UPGRADE MACRO FILE has completed.
  i.e. File Name:
  $!<mds12DesignAttaFile>|)

endfunction
