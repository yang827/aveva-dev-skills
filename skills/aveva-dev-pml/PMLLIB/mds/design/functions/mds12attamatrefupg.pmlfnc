-- Function to REMOVE the UDA :MDSMATREF material setting and MOVE the material setting to the ATTA MATREF attribute
define function !!mds12attamatrefupg()

  var !coll coll all atta where ((match (name of spref, '/MDS/')) eq (1))
  do !indx indices !coll
--    if !coll[!indx].dbref().:mdsmatref.unset() then
--      :mdsmatref /CARBON/STEEL
--    endif
    !!ce     = !coll[!indx].dbref()
    !mdsmatr = :mdsmatref
    handle ANY
      $P ** ERROR ** getting :MDSMATREF for ATTA *** $!!ce.fullname() *** Set to /CARBON/STEEL ***
      matref /CARBON/STEEL
      :mdsmatref unset
    elsehandle NONE
--q name type :mdsmatref
--q var !mdsmatr
--$P *** matref $!mdsmatr ***
      matref $!mdsmatr
      handle ANY
        $P ** ERROR ** ILLEGAL :MDSMATREF for ATTA *** $!!ce.fullname() *** Set to /CARBON/STEEL ***
        matref /CARBON/STEEL
        :mdsmatref unset
      endhandle
    endhandle
    :mdsmatref unset

    if !!ce.matref.unset() then
      matref /CARBON/STEEL
    endif

    q matref
  enddo

endfunction
