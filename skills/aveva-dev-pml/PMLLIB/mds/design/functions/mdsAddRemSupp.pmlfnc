define function !!mdsAddRemSupp(!action is STRING)

  !updater = object MDSDRAWLISTUPDATER()
  !list[1] = !!ce

  if (!action.lowCase().eq(|add|)) then
    !updater.addToDrawlist(!list, false)
  elseif (!action.lowCase().eq(|remove|)) then
    !updater.removeFromDrawlist(!list, false)
  elseif (!action.lowCase().eq(|addref|)) then
    !updater.addToDrawlist(!list, true)
  elseif (!action.lowCase().eq(|removeref|)) then
    !updater.removeFromDrawlist(!list, true)
  endif

endfunction
