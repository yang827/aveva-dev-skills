--
-- File: mdsCopyMemberAttributes.pmlfnc
--   Type:Function Definition
--   Group:Multi Discipline Supports Application
--     Keyword:MDS
--   Module:design
--
-- Author:R.Martin
-- Created: 02/11/2010
--
-- Description:
-- recursive function that can be used to copy attributes for entire member trees
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         DBREF        element that the copied member attributes will be copied to
--     2     R         ARRAY        member list to get the current element attributes from
--     3     R         STRING       existing name format to change
--     4     R         STRING       new name format to change the copy name to
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
define function !!mdsCopyMemberAttributes(!copyTarget is DBREF, !memberListToCopy is ARRAY, !currentNameFormat is STRING, !newName is STRING)
  !currentElement = !!ce
  do !i from 1 to !memberListToCopy.size()
    !!ce = !copyTarget.members[!i]
    !attributes = !memberListToCopy[!i].attributes()
    --now attempt to set all attributes apart from spref back to the the element using the template
    do !j from 1 to !attributes.size()
      !attribute = !attributes[!j]
      !value = !memberListToCopy[!i].attribute(!attributes[!j])
      --we need to reset any position attributes to the appropriate origin
      if !value.objecttype().eq('POSITION') or !value.objecttype().eq('DIRECTION') then
        !currentOriginName = !value.origin.name
        !newOriginName = !currentOriginName.replace(!currentNameFormat, !newName)
        !newPos = !value
        !newPos.origin = $!newOriginName
        !newPos.east = !value.east
        !newPos.north = !value.north
        !newPos.up = !value.up
        !value = !newPos
        !newPos.delete()
      elseif !value.objecttype().eq('DBREF') then
        !oldValue = !value
        !currentRefName = !value.name
        handle ANY
          !value = !oldValue
        elsehandle NONE
          !newRefName = !currentRefName.replace(!currentNameFormat, !newName)
          !value = $!newRefName
          handle ANY
            !value = !oldValue
          endhandle
        endhandle
      endif
      !!ce.$!attribute = !value
      handle ANY
      endhandle
      !value.delete()
    enddo

    -- call this function regressively if the current member has it's own member list
    if !memberListToCopy[!i].members.size().gt(0) then
      !!mdsCreateMemberLists(!!ce, !memberListToCopy.members, !currentNameFormat, !newName)
    endif
  enddo
  !!ce = !currentElement
endfunction
