-- Author:          Wojciech Sakowicz
-- Created:         20/05/2012
--
--
--
--  Description:    Function create datum atta from preliminary support. Works for supports with additional
--                  non blocking forms during datum callback execution.
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--    1   R      Form                  form for chosen support type
--    2   R      DBRef                 preliminary support reference
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsCrDatumFromPS(!form is FORM, !atta is DBREF)

  if (undefined(!!mdsAutoTubePicker)) then
    !!mdsAutoTubePicker = object MDSAUTOPICKER()
  endif

  !!mdsAutoTubePicker.set(!atta, !form)
  !preSuppFunc = !atta.:mdssuppfunc
  $!form.datum.callback
  !!mdsAutoTubePicker.clear()
  !atta.:mdssuppfunc = !preSuppFunc

endfunction
