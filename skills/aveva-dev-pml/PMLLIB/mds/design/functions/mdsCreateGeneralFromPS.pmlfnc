--  File:           mdsCreateGeneralFromPS.pmlfnc
--    Type:         Function Definition
--   Group:
--     Keyword:
--   Module:        design
--   Replaces:
-- Author:          Wojciech Sakowicz
-- Created:         20/05/2012
--
--
--
--  Description:    Function create datum atta from preliminary support. Works for supports without additional
--                  non blocking forms during datum callback execution.
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--    1   R      Form                  form for chosen support type
--    2   R      String                name of preliminary support
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsCreateGeneralFromPS(!form is FORM, !name is STRING)

  -- check if form works in MODIFY state
  if !form.support.modify then
    return
  endif

  --<sk> 04/06/2012
  -- Check if support with given name exists already (can be preliminary support)
  !datum = object DBREF(!name)
  handle NONE
    !form.support.preliminaryStore = !!mdsSavePreInf(!datum)
    -- rename preliminary support
    !datum.name = !name & '_Pre'
    !preSuppFunc = !datum.:mdssuppfunc
  elsehandle ANY
    return
  endhandle
  --<sk> 04/06/2012

  if (undefined(!!mdsAutoTubePicker)) then
    !!mdsAutoTubePicker = object MDSAUTOPICKER()
  endif

  !!mdsAutoTubePicker.set(!datum, !form)

  -- STANDARD ----------------------------------------------
  -- form with datum on tube
  if (defined(!form.datum)) then
    -- set branch as picked
    $!form.datum.callback
    !!mdsAutoTubePicker.clear()

    --try and find the SUPF entry for the current ancillary type in the MDS/APPDEFAULTS db
    !choice = !datum.spref.tans
    if !choice.match('PR').eq(0) then
      !appDefName = '/MDS/ATTA/DEFAULTS/' + '$!choice' + '/GEN/SUPF'
      !appDefRef = !appDefName.dbref()
      handle ANY
        !ancilSuppFunc = 'UNDEFINED'
      elsehandle NONE
        !ancilSuppFunc = $!appDefRef.ppro
      endhandle

      --if the ancilSuppFunc does not match the prelim value then the user has
      --opted to change the original type specified by the ancillary so reset the suppfunc value to
      --the appdefaults definition of the ancillary supf
      if !ancilSuppFunc.neq(!preSuppFunc) then
        :mdssuppfunc '$!ancilSuppFunc'
        handle any
        endhandle
      else
        :mdssuppfunc '$!preSuppFunc'
        handle any
        endhandle
      endif
    else
      :mdssuppfunc '$!preSuppFunc'
      handle any
      endhandle
    endif

    return
  endif

  !!mdsAutoTubePicker.clear()

  !form.hide()

  -- ELBOW/TUBING ----------------------------------------------
  -- form with datum on elbow/tube i.e. trunnion

  -- determine which to fire if two are active
  !crelbo = defined(!form.crelbo) and !form.crelbo.active
  handle ANY
    !crelbo = FALSE
  endhandle
  !crtube = defined(!form.crtube) and !form.crtube.active
  handle ANY
    !crtube = FALSE
  endhandle
  !crcros = defined(!form.crcros) and !form.crcros.active
  handle ANY
    !crcros = FALSE
  endhandle
  !crredu = defined(!form.crredu) and !form.crredu.active
  handle ANY
    !crredu = FALSE
  endhandle

  --from the current prelim atta we can determine which of the above options are available to us
  --we will then populate a new form with these options which will give us the correct callback that needs to be fired
  if (undefined(!!mdsTrunnionTypePicker)) then
    pml load form !!mdsTrunnionTypePicker
  endif

  if !crelbo.not() and !crtube.not() and !crcros.not() and !crredu.not() then
    !!alert.warning ('Cannot create chosen support from this preliminary support')
    -- reset name
    !datum.name = !name
    !form.hide()
    return
  else
    !!mdsTrunnionTypePicker.init(!form, !name, !datum, !crelbo, !crtube, !crcros, !crredu, !preSuppFunc)
  endif

endmethod
