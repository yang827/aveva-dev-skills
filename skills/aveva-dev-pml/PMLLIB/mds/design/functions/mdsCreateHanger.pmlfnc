--
-- File:                mdsCreateHanger.pmlfnc
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:
--
-- Author:              R.Martin
-- Created:             17/02/2010
--
--
-- Description:
-- function to determine which type of hanger creation method we should be using
-- if any hanger interfaces are being used then the new hanger creation mechanism will be used
-- that was created during the refactor. otherwise use the original mds templates version
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'VH' or 'FH'
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
define function !!mdsCreateHanger(!type is STRING)

  if !!mdshangif.trim().eq('MDS') or !!mdshangif.trim().eq('') then
    --we have no interface so use the old method
    !!mdsfhanger.sitecheck(!type)
  else
    --we have an interface do a check on the users setup to ensure that we have all the required
    --folders and executable paths to build a hanger
    !checkOk = !!mdsCheckInterface(!!mdshangif.trim())
    if !checkOk.not() then
      --the prerequisites for creating a hanger using the current interface have not been met so exit
      return
    endif

    --now use the initforms method to make
    --sure the relevant forms are initialised
    !!initForms('ALL')
    !!mdsInterfaceHanger.sitecheck('FH')
  endif

endfunction
