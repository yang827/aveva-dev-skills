--
-- File: mdsCreateMemberLists.pmlfnc
--   Type:Function Definition
--   Group:Multi Discipline Supports Application
--     Keyword:MDS
--   Module:design
--
-- Author:R.Martin
-- Created: 02/11/2010
--
-- Description:
-- recursive function that can be used to copy whole member trees (without attributes)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         DBREF        current copied element that the new member will be copied under
--     2     R         ARRAY        member list that will be copied under the target member
--     3     R         STRING       existing name format to change
--     4     R         STRING       new name format to change the copy name to
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
define function !!mdsCreateMemberLists(!copyTarget is DBREF, !memberListToCopy is ARRAY, !currentNameFormat is STRING, !newName is STRING)
  !currentElement = !!ce
  !!ce = !copyTarget
  do !i from 1 to !memberListToCopy.size()
    !name = !memberListToCopy[!i].name.replace(!currentNameFormat, !newName)
    new $!memberListToCopy[$!i].type $!name
    -- call this function recursively if the new member has it's own member list
    if !memberListToCopy[!i].members.size().gt(0) then
      !!mdsCreateMemberLists(!!ce, !memberListToCopy.members, !currentNameFormat, !newName)
    endif
  enddo
  !!ce = !currentElement
endfunction
