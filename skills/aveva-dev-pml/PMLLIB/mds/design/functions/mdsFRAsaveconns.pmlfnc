-- Define function

define function !!mdsFRAsaveconns(!form is form, !mode is STRING)


  -- read the support connections by checking the
  !support = !form.support

  if !mode eq 'READ' then
    -- set support object connections
    --collect all of the vertical sections
      !support.connections = ARRAY()
      !current = ARRAY()
      var !verts coll all sctn with match(name,'-V')gt 0 and (mcount fitt) gt 0 for $!Support.Stru
      do !v values !verts
         !vert = ARRAY()
         !vert[1] = !v.dbref().name
         var !fitts coll all fitt for $!v
         !current = ARRAY()
         do !a values !fitts
             var !cref cref of $!a
             !current.append(!cref.dbref())
         enddo
        !vert.append(!current)
        !support.connections.append(!vert)
      enddo
      -- reset the form support connections
      if !form inset(!!mdsfr12,!!mdsfr04) then
          !form.support.connections = !current
      else
          !form.support.connections = !support.connections
          !form.backup.connections = !support.connections
          handle ANY
            -- in case the backup does not exist at this point
          endhandle
      endif
  endif


   -- write the values back to the support items
   -- apply the saved values to the appropriate section

      do !a values !support.connections

        !connectionstring = ''
        !!ce = !a[1].dbref()
        handle ANY
          skip
        endhandle
        do !b index !a[2]
           fitt $!b
           cref $!a[2][$!b]
           !connectionstring = !connectionstring & ' ' & '$!a[2][$!b]'
        enddo
        !connectionstring = !connectionstring.replace('Unset','=0')
        -- go to the vertical member
        !!ce = !a[1].dbref()
        :mdspconn $!connectionstring
        handle ANY
          $p $!!error.text
        endhandle
     enddo

   stru
endfunction
