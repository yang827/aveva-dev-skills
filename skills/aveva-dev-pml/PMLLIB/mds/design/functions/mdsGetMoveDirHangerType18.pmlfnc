--
-- File:  mdsGetMoveDirHangerType18.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  D.Flannery
-- Created:  Apr 26 2005
--
--
-- Description:
-- function to get direction to move atta on sloping pipes
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function

define function !!mdsGetMoveDirHangertype18(!atta is DBREF,!mode is STRING ) is ARRAY

  !result = ARRAY()

  $!atta
  !getdirs = !!mdsremovegrad(!!ce)
  !plDir = !getdirs[1]
  !crossdir = !getdirs[6]

  pin 1 copy pl
  !tpos = !!mdsHangertype18.support.tposition
  pin 2 copy P1
  !tdir = !!mdsHangertype18.support.tdir.string().before('WRT ').trim()
  pin 2 dir $!tdir
  pin 2 plane pin 2 thro $!tpos
  var !dist1 constr dist pin 1 to pin 2

  if !tdir.eq('U') or !tdir.eq('D') or !tdir.eq('Z') or !tdir.eq('-Z') then
    !dirx  = !tdir.direction().cross(!crossdir)
  elseif !tdir.match('U').gt(0) or !tdir.match('D').gt(0) or !tdir.match('Z').gt(0) or !tdir.match('-Z').gt(0) then
    if !tdir.match('N').gt(0) or !tdir.match('S').gt(0) or !tdir.match('Y').gt(0) or !tdir.match('-Y').gt(0) then
      !dirx  = E
    else
      !dirx = N
    endif
  else
    !dirx  = !tdir.direction().cross(U wrt world)
  endif

  pin 3 copy pin 1
  pin 3 plane pin 3 dist 1000
  pin 4 copy pin 3
  !optdir = !!mdsHangertype18.support.tdir.opposite().string().before('WRT')
  pin 4 dir $!optdir
  pin 4 plane pin 4 thr pin 2

  -- we need to plane u if dynoffset x set
  !xoff = !!mdsHangertype18.support.atta[1].cref.:mdsdynoffset
  handle ANY
  elsehandle NONE
    if !xoff.neq(0) then
      pin 4 dir u
      pin 4 plane pin 4 thr pin 2
    endif
  endhandle

  --dun1218 dynamic parallel in this instance also applies to situations where we have a vertical pipe being supported by steelwork above it
  --in this case we have to keep the dynamic parallel test below otherwise the software fails - start
  -- test if we have a dynamic parallel situation, if we do then we need to ignore
  -- the !testangle test as it will return an error due to dir2to4 not having a direction richard martin [21/08/06]
  !tempdirs = !!mdsremovegrad(!atta)
  !pin9dir = !tdir
  !pin9diropp = !pin9dir.direction().opposite()
  if !tempdirs[1].eq(!pin9dirOpp) or !tempdirs[1].eq(!pin9dir.direction()) or !tempdirs[2].eq(!pin9dirOpp) or !tempdirs[2].eq(!pin9dir.direction()) then
    -- Pipe and support direction parallel dynamic
    !dynamicparallel =  TRUE
  else
    !dynamicparallel =  FALSE
  endif

  var !dist2 constr dist pin 3 to pin 4

  -- if dynamic parallel then ignore the next test richard martin [21/08/06]
  if !dynamicparallel.eq(FALSE) then
    --   >> dtf 27.07.06 Test for angle on sloping steel & sloping pipe
    var !dir2to4 const dir pin 2 to pin 4
    var !dir1to3 const dir pin 1 to pin 3
    !testangle = !dir2to4.direction().angle(!dir1to3.direction())
  else
    -- set a deliberate fail value for testangle so that we ignore it for the dynamic parallel case
    -- richard martin [21/08/06]
    !testangle = 999
  endif
  --dun1218 dynamic parallel in this instance also applies to situations where we have a vertical pip
  --in this case we have to keep the dynamic parallel test below otherwise the software fails - end

  if !dist1.real().nint().eq(!dist2.real().nint()) then
    !result.append(TRUE)
    !result.append('')
    !result.append(0)
  elseif (!testangle.gt(-.1) and !testangle.lt(.1)) or (!testangle.gt(179.9) and !testangle.lt(180.1)) then
    --   dtf >> 27.07.06 test to see if almost parallel
    !result.append(TRUE)
    !result.append('')
    !result.append(0)
  elseif !dist1.real().nint().gt(!dist2.real().nint()) then
    -- if second dist greater than first clamp will need to move in the leave dir of atta
    !result.append(FALSE)
    !memsize = !!ce.cref.members.size()
    if !memsize.neq(0) then
      if ( !!ce.cref.members[2].lDir.neq(!!ce.cref.members[2].aDir.opposite() ) and !!ce.cref.owner.members.size().gt(1) )  then
        --if hanger has a cross member with the same arrive and leave direction reverse the !movedir
        if !mode.eq('CREATE') then
          !movedir = !!ce.aDir.string().before('WRT')
        else
          !movedir = !!ce.lDir.string().before('WRT')
        endif
      elseif !mode.eq('CREATE') then
        !movedir = !!ce.lDir.string().before('WRT')
      elseif !mode.eq('MODIFY') then
        !movedir = !!ce.aDir.string().before('WRT')
      endif
    else
      if !mode.eq('CREATE') then
        !movedir = !!ce.lDir.string().before('WRT')
      elseif !mode.eq('MODIFY') then
        !movedir = !!ce.aDir.string().before('WRT')
      endif
    endif

    !result.append(!movedir)
    !angle =  (!plDir.dot(!dirx))
    !invangle =  (acos(!angle))
    handle ANY
      -- <RM> 26 March 09 -- this was put in because i was having problems with the
      -- calculated value for angle, even though q var showed -1 i was getting an error
      -- saying that acos was not in the range -1 to +1, made it nearest integer and its
      -- ok, any problems and refinement may be necessary.
      !angle = !angle.nint()
      -- <RM> 4 December 06 -- end of fix
      !invangle =  (acos(!angle))
    endhandle
    !result.append(!invangle)

  elseif !dist1.real().nint().lt(!dist2.real().nint()) then
    -- if second dist less than first clamp will need to move in the arrive dir of atta
    !result.append(FALSE)
    !memsize = !!ce.cref.members.size()
    if !memsize.neq(0) then
      if ( !!ce.cref.members[2].lDir.neq(!!ce.cref.members[2].aDir.opposite() ) and !!ce.cref.owner.members.size().gt(1) ) then
        --if hanger has a cross member with the same arrive and leave direction reverse the !movedir
        if !mode.eq('CREATE') then
          !movedir = !!ce.lDir.string().before('WRT')
        else
          !movedir = !!ce.aDir.string().before('WRT')
        endif
      elseif !mode.eq('CREATE') then
        !movedir = !!ce.aDir.string().before('WRT')
      elseif !mode.eq('MODIFY') then
        !movedir = !!ce.lDir.string().before('WRT')
      endif
    else
      if !mode.eq('CREATE') then
        !movedir = !!ce.aDir.string().before('WRT')
      elseif !mode.eq('MODIFY') then
        !movedir = !!ce.lDir.string().before('WRT')
      endif
    endif
    !result.append(!movedir)

    !angle =  (!plDir.dot(!dirx))
    !invangle =  (acos(!angle))
    handle ANY
      -- <RM> 26 March 09 -- this was put in because i was having problems with the
      -- calculated value for angle, even though q var showed -1 i was getting an error
      -- saying that acos was not in the range -1 to +1, made it nearest integer and its
      -- ok, any problems and refinement may be necessary.
      !angle = !angle.nint()
      -- <RM> 4 December 06 -- end of fix
      !invangle =  (acos(!angle))
    endhandle
    !result.append(!invangle)
  endif

  !!mdsresetpins(1,4)
  return !result

endfunction
