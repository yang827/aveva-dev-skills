-- File:    mdsInterfaceGetBeamRefs.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   mds
--   Module:    design
--   Replaces:
--
-- Author:    R.martin
-- Created:   Tue Mar 20 2002
--
--
-- Description:
-- this is a function that looks at an existing hanger to determine what beams or civils it is attached to
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         DBREF       dbref of the hanger atta that is being modified
--     2     R         REAL        real number indicating what hanger type is being modified
--
-- Return:
--    [Data Type]   [Description]
--       ARRAY       returns an array containing dbrefs of the beams or civils that the hanger is attached to
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsInterfaceGetBeamRefs(!attaname is DBREF, !confignumber is REAL) is ARRAY

  !beamArray = object ARRAY()

  !hanger1Name = !attaname.name + '/H1'
  !hanger1 = !hanger1Name.dbref()
  handle ANY
    return !beamArray
  endhandle

  if !confignumber.eq(32) then

    !ce = !!ce
    --double steel channels
    --we need to get the reference of the supporting civil or sctn that the hanger is connected to, we will do this by checking the following:-
    --do we have a tref set on the hanger?
    --if no then we will search for the :MDSCIVREF uda and if this is set then we will use it to set the beam ref array
    --if yes then we have to check that it tallies with the :MDSCIVREF uda, if it doesn't then a reconnect has occured and
    --the existing tref is incorrect because a connection macro is pending.
    --if it doesn't match the UDA then we use the UDA value

    !!ce = !hanger1.tref
    handle (2,822)

      if !hanger1.:MDSCIVREF.set() then
        !beamArray.append(!hanger1.:MDSCIVREF[2])
        !beamArray.append(!hanger1.:MDSCIVREF[1])
      else
        return error 1
      endif

    elsehandle NONE

      if !hanger1.:MDSCIVREF.set() then
        if !hanger1.:MDSCIVREF[1].eq(!!ce.owner) then
          !beamArray.append(!!ce.:mdsConnect[2])
          !beamArray.append(!!ce.owner)
        else
          !beamArray.append(!hanger1.:MDSCIVREF[2])
          !beamArray.append(!hanger1.:MDSCIVREF[1])
        endif
      else
        return
      endif

    endhandle

    !hanger2Name = !attaname.name + '/H2'
    !hanger2 = !hanger2Name.dbref()
    handle ANY
      return !beamArray
    endhandle

    !!ce = !hanger2.tref
    handle (2,822)

      if !hanger2.:MDSCIVREF.set() then
        !beamArray.append(!hanger2.:MDSCIVREF[2])
        !beamArray.append(!hanger2.:MDSCIVREF[1])
      else
        return error 1
      endif

    elsehandle NONE

      if !hanger2.:MDSCIVREF.set() then
        if !hanger2.:MDSCIVREF[1].eq(!!ce.owner) then
          !beamArray.append(!!ce.:mdsConnect[2])
          !beamArray.append(!!ce.owner)
        else
          !beamArray.append(!hanger2.:MDSCIVREF[2])
          !beamArray.append(!hanger2.:MDSCIVREF[1])
        endif
      else
        return
      endif

    endhandle

    !!ce = !ce

  elseif !confignumber.eq(2) then

    !ce = !!ce
    --double steel channels
    --we need to get the reference of the supporting civil or sctn that the hanger is connected to, we will do this by checking the following:-
    --do we have a tref set on the hanger?
    --if no then we will search for the :MDSCIVREF uda and if this is set then we will use it to set the beam ref array
    --if yes then we have to check that it tallies with the :MDSCIVREF uda, if it doesn't then a reconnect has occured and
    --the existing tref is incorrect because a connection macro is pending.
    --if it doesn't match the UDA then we use the UDA value

    !!ce = !hanger1.tref
    handle (2,822)

      if !hanger1.:MDSCIVREF.set() then
        !beamArray.append(!hanger1.:MDSCIVREF[2])
        !beamArray.append(!hanger1.:MDSCIVREF[1])
      else
        return error 1
      endif

    elsehandle NONE

      if !hanger1.:MDSCIVREF.set() then
        if !hanger1.:MDSCIVREF[1].eq(!!ce.owner) then
          !beamArray.append(!!ce.:mdsConnectN.dbref())
          !beamArray.append(!!ce.owner)
        else
          !beamArray.append(!hanger1.:MDSCIVREF[2])
          !beamArray.append(!hanger1.:MDSCIVREF[1])
        endif
      else
        return
      endif

    endhandle
    !!ce = !ce

  elseif !confignumber.eq(31) then

    --double steel beams
    !hanger2Name = !attaname.name + '/H2'
    !hanger2 = !hanger2Name.dbref()
    handle ANY
      return !beamArray
    endhandle

    --we need to get the reference of the supporting civil or sctn that the hanger is connected to, we will do this by checking the following:-
    --do we have a tref set on the hanger?
    --if no then we will search for the :MDSCIVREF uda and if this is set then we will use it to set the beam ref array
    --if yes then we have to check that it tallies with the :MDSCIVREF uda, if it doesn't then a reconnect has occured and
    --the existing tref is incorrect because a connection macro is pending.
    --if it doesn't match the UDA then we use the UDA value

    -- add the hanger 1 beam references
    !!ce = !hanger1.tref
    handle (2,822)

      if !hanger1.:MDSCIVREF.set() then
        !beamArray.append(!hanger1.:MDSCIVREF[1])
      else
        return error 1
      endif

    elsehandle NONE

      if !hanger1.:MDSCIVREF.set() then
        if !hanger1.:MDSCIVREF[1].eq(!!ce.owner) then
          !beamArray.append(!!ce.owner)
        else
          !beamArray.append(!hanger1.:MDSCIVREF[1])
        endif
      else
        !beamArray.append(!hanger1.tref.owner)
      endif

    endhandle


    -- add the hanger 2 beam references
    !!ce = !hanger2.tref
    handle (2,822)

      if !hanger2.:MDSCIVREF.set() then
        !beamArray.append(!hanger2.:MDSCIVREF[1])
      else
        return error 1
      endif

    elsehandle NONE

      if !hanger2.:MDSCIVREF.set() then
        if !hanger2.:MDSCIVREF[1].eq(!!ce.owner) then
          !beamArray.append(!!ce.owner)
        else
          !beamArray.append(!hanger2.:MDSCIVREF[1])
        endif
      else
        !beamArray.append(!hanger2.tref.owner)
      endif

    endhandle

  elseif !confignumber.eq(19) then

    --double hanger on civils
    !hanger2Name = !attaname.name + '/H2'
    !hanger2 = !hanger2Name.dbref()
    handle ANY
      return !beamArray
    endhandle

    -- add the hanger 1 beam references
    !!ce = !hanger1.tref.owner.owner
    handle (2,754)

      if !hanger1.:MDSCIVREF.set() then
        !beamArray.append(!hanger1.:MDSCIVREF[1])
      else
        return error 1
      endif

    elsehandle NONE

      if !hanger1.:MDSCIVREF.set() then
        if !hanger1.:MDSCIVREF[1].eq(!!ce.owner) then
          !beamArray.append(!!ce.owner)
        else
          !beamArray.append(!hanger1.:MDSCIVREF[1])
        endif
      else
        !beamArray.append(!hanger1.tref.owner)
      endif

    endhandle

    -- add the hanger 2 beam references
    !!ce = !hanger2.tref.owner.owner
    handle (2,754)

      if !hanger2.:MDSCIVREF.set() then
        !beamArray.append(!hanger2.:MDSCIVREF[1])
      else
        return error 1
      endif

    elsehandle NONE

      if !hanger2.:MDSCIVREF.set() then
        if !hanger2.:MDSCIVREF[1].eq(!!ce.owner) then
          !beamArray.append(!!ce.owner)
        else
          !beamArray.append(!hanger2.:MDSCIVREF[1])
        endif
      else
        !beamArray.append(!hanger2.tref.owner)
      endif

    endhandle

  elseif !confignumber.eq(18) or !confignumber.eq(20) or !confignumber.eq(25) then
    --single hanger on civils

    --we need to get the reference of the supporting civil or sctn that the hanger is connected to, we will do this by checking the following:-
    --do we have a tref set on the hanger?
    --if no then we will search for the :MDSCIVREF uda and if this is set then we will use it to set the beam ref array
    --if yes then we have to check that it tallies with the :MDSCIVREF uda, if it doesn't then a reconnect has occured and
    --the existing tref is incorrect because a connection macro is pending.
    --if it doesn't match the UDA then we use the UDA value

    -- add the hanger 1 beam references
    !!ce = !hanger1.tref.owner.owner
    handle (2,754)

      if !hanger1.:MDSCIVREF.set() then
        !beamArray.append(!hanger1.:MDSCIVREF[1])
      else
        return error 1
      endif

    elsehandle NONE

      if !hanger1.:MDSCIVREF.set() then
        if !hanger1.:MDSCIVREF[1].eq(!!ce.owner) then
          !beamArray.append(!!ce.owner)
        else
          !beamArray.append(!hanger1.:MDSCIVREF[1])
        endif
      else
        !beamArray.append(!hanger1.tref.owner)
      endif

    endhandle

  elseif !confignumber.eq(6) or !confignumber.eq(600) then

    !!ce = !hanger1.tref
    handle (2,822)
      if !hanger1.:MDSCIVREF.set() then
        !beamArray.append(!hanger1.:MDSCIVREF[1])
      else
        --because some type 6 and 600 can exist without hanger connection return a blank dbref
        !beamArray.append(object dbref())
      endif
    elsehandle NONE
      !beamArray.append(!hanger1.tref.owner)
    endhandle

  else
    --single hanger on steel

    --we need to get the reference of the supporting civil or sctn that the hanger is connected to, we will do this by checking the following:-
    --do we have a tref set on the hanger?
    --if no then we will search for the :MDSCIVREF uda and if this is set then we will use it to set the beam ref array
    --if yes then we have to check that it tallies with the :MDSCIVREF uda, if it doesn't then a reconnect has occured and
    --the existing tref is incorrect because a connection macro is pending.
    --if it doesn't match the UDA then we use the UDA value
    !!ce = !hanger1.tref
    handle (2,822)

      if !hanger1.:MDSCIVREF.set() then
        !beamArray.append(!hanger1.:MDSCIVREF[1])
      else
        return error 1
      endif

    elsehandle NONE

      if !hanger1.:MDSCIVREF.set() then
        if !hanger1.:MDSCIVREF[1].eq(!!ce.owner) then
          !beamArray.append(!!ce.owner)
        else
          !beamArray.append(!hanger1.:MDSCIVREF[1])
        endif
      else
        !beamArray.append(!hanger1.tref.owner)
      endif

    endhandle
  endif

  return !beamArray

endfunction
