--
-- File:    mdsInterfaceHangerClearGadgets.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    I.osborne
-- Created:   Wed May 07
--
--
-- Description:
-- Function to clear standard pipe support form gadgets
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM       Name of pipe support form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsInterfaceHangerClearGadgets(!form is FORM)

  -- Clear Support object
  if (!form.fullname().upcase().eq('MDSHANGERTYPE1')) then
    !form.support = object MDSSUPPORTTYPE1()
  elseif (!form.fullname().upcase().eq('MDSHANGERTYPE2')) then
    !form.support = object MDSSUPPORTTYPE2()
  elseif (!form.fullname().upcase().eq('MDSHANGERTYPE31')) then
    !form.support = object MDSSUPPORTTYPE31()
  elseif (!form.fullname().upcase().eq('MDSHANGERTYPE32')) then
    !form.support = object MDSSUPPORTTYPE32()
  elseif (!form.fullname().upcase().eq('MDSHANGERTYPE7')) then
    !form.support = object MDSSUPPORTTYPE7()
  elseif (!form.fullname().upcase().eq('MDSHANGERTYPE21')) then
    !form.support = object MDSSUPPORTTYPE21()
  elseif (!form.fullname().upcase().eq('MDSHANGERTYPE18')) then
    !form.support = object MDSSUPPORTTYPE18()
  elseif (!form.fullname().upcase().eq('MDSHANGERTYPE19')) then
    !form.support = object MDSSUPPORTTYPE19()
  elseif (!form.fullname().upcase().eq('MDSHANGERTYPE20')) then
    !form.support = object MDSSUPPORTTYPE20()
  elseif (!form.fullname().upcase().eq('MDSHANGERTYPE25')) then
    !form.support = object MDSSUPPORTTYPE25()
  elseif (!form.fullname().upcase().eq('MDSHANGERTYPE6')) then
    !form.support = object MDSSUPPORTTYPE6()
  elseif (!form.fullname().upcase().eq('MDSHANGERTYPE600')) then
    !form.support = object MDSSUPPORTTYPE600()
  endif

  -- Clear Array Gadgets
  !form.repre.clear()
  handle any
  endhandle
  !form.store.clear()
  handle any
  endhandle
  !form.storeBpref.clear()
  handle any
  endhandle
  !form.struBpref.clear()
  handle any
  endhandle
  !form.ppack.clear()
  handle any
  endhandle
  !form.stiffener.clear()
  handle any
  endhandle
  !form.oldStiffener.clear()
  handle any
  endhandle

  -- Reset Index No. 2 of the ARRAYS to DEFAULT Callback on the form gadgets
  -- '!!mdsmodat.height, .length and .thickness'
  !!mdsmodat.actionheight[2]    = ||
  !!mdsmodat.actionlength[2]    = ||
  !!mdsmodat.actionthickness[2] = ||

  -- Clear String Gadgets
  !form.name.val = ||

  -- Clear form userdata
  VAR USER _$!form CLEAR

  -- Remove highlighted colours
  UNENHANCE ALL

  -- Remove aid text
  do !count from 210 to 259
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!count
  enddo

  --> Modified -<wd>29sep1998
  -- Dismiss the EDG forms for the Alignment Utility, if they are shown
  if (!!mdsalign.shown()) then
    !!kactioncommands(!!mdsalign.dismissform)
  endif
  --< Modified -<wd>29sep1998

endfunction
