--
-- File:    mdsInterfaceIdSingleHangerSteel.pmlfnc
--   Type:    Object Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    R.martin
-- Created:   Tue March 23rd 2010
--
--
-- Description:
-- id a tube to connect a hanger to
--
-- input, !allowableBeamTypes is a list of hardtypes that can
--        connected to, this comes from !!mdsinterfaceallhangertypes.groupbeamtypes for the selected hangertype
--        !prompt is the prompt being used to ask the user to pick something
-- output, the dbref of the selected tube
------------------------------------------------------------------------
define function !!mdsInterfaceIdSingleHangerSteel(!allowableBeamTypes is STRING, !prompt is STRING) is DBREF

  !beamType = ''
  --!prompt = 'Identify steelwork to connect hanger to'

  if defined(!!licadautotestenabled) then
    !!ce = !!licadautotest.steel
  else
    prompt off
    prompt load escape '$!prompt'
    ID BOX SCTN FLOOR WALL GWALL STWALL SCREED CSCREED CWALL PANE CFLOOR @
    handle ANY
      prompt on
      return error 1 '$!!error.text'
    endhandle
  endif

  !beamRef = !!ce
  --  !type = !steelRef.catref.owner.owner.purpose
  !type = !beamRef.gtype
  handle ANY
  endhandle

  if (!beamRef.hardtype eq 'PANE') then
    !type = 'PANE'
  endif

  if(!type.eq(''))then
    !type = 'BEAM'
  endif

  !beamType = !beamType + !type
  if(!beamType inset $!allowableBeamTypes) then
    if !beamType inset ('WALL') then
      -- wall must be stwall
      !stwallconn = TRUE
    else
      !stwallconn = FALSE
    endif
    -- beam type is suitable for double channel
  else
    !!alert.message('Beam of type $!beamType is not suitable for this type of hanger')
    --restart
    return error 2
  endif

  return !beamRef

endfunction
