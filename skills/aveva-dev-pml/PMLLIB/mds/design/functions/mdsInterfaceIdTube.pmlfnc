-- File:    mdsInterfaceIdTube.pmlfnc
--   Type:    Object Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    R.martin
-- Created:   Tue March 23rd 2010
--
--
-- Description:
-- id a tube to connect a hanger to
--
-- input, !hangerType ie, 1,2,6,7,18,19,20,21,25,31,32 or 600
-- output, the dbref of the selected tube
------------------------------------------------------------------------
define function !!mdsInterfaceIdTube(!hangerType is REAL) is DBREF

  !existCE = !!ce

  prompt off
  prompt load escape 'Identify tube to be supported'
  ID TUBE @
  handle ANY
    prompt on
    !!ce = !existCE
    return error 1 '$!!error.text'

    --><wd>17nov2009 - DFN-P25277 (SI-17086)
    -- When a Support Type 6 or 600 has been selected Check if a MDS Trunnion branch etc... has been Identified
  elsehandle NONE
    !tubeRef = !!ce
    !unusedValidCheck = !!mdscheckinterfacetube(!tubeRef, !hangerType)
    handle 1
      !text = !!error.text
      !!ce = !existCE
      return error 1 |$!text|
    elsehandle 2
      --re-identify
      return error 2
    elsehandle NONE
      !!ce = !existCE
      return !tubeRef
    endhandle

  endhandle

endfunction
