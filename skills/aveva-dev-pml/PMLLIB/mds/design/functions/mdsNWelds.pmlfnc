--
-- File: mdsNWelds.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: DESIGN
--   Replaces:
--
-- Author: Wayne Dodwell
-- Created: 10th March 2009
--
-- Description:
-- Function to determine the NWelds attribute value for the passed ATTA DBREF
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsNWelds(!atta is DBREF)

  !!mdsDacControl(TRUE)

  -- Ensure the Current element is !atta
  !!ce = !atta

  -- Determine the object MDSSELECTION values for the Pipe and/or the Trunnion Welds at !atta
  !sType = !atta.sType
  -- A few MDS Support "sTypes" selected from the /MDS specification differ from Mds Support "Types"
  -- found in the DES-SUPP-DEFS default file: e.g. the /MDS specification stype = "AC18A" or "AC18B"
  -- but the MDS application type = "AC18" - Therefore reset the !sType variable for these SPECIAL ATTA CASES
  if (!sType inset ('AC18A', 'AC18B')) then
    !sType = 'AC18'
  elseif (!sType inset ('AC19A', 'AC19B')) then
    !sType = 'AC19'
  elseif (!sType inset ('AC19A', 'AC19B')) then
    !sType = 'AC18'
  elseif (!sType inset ('AT29A', 'AT29B')) then
    !sType = 'AC29'
  elseif (!sType inset ('AT31A', 'AT31B')) then
    !sType = 'AT31'
  elseif (!sType inset ('AT105A', 'AT105B')) then
    !sType = 'AT105'
    --><wd>26jun2009 - Defect No. 22278
  elseif (!atta.spref.name.matchwild('*/MDS/.*MAKEUP*')) then
    -- The passed !atta.type is a 'VIRTUAL' MDS Trunnion REDUCER element which is 'WELDED'
    -- to the MAIN PIPE for ISOMETRIC/SPOOLER WELD NUMBERING purposes
    -- Determine the MDS Trunnion Type from the ATTA named "<trunnion-name>/SREF" in order to set the correct MDS Trunnion Specific MDSSELECTION object
    !supportName = !!mdsGetSuppName(!atta)
    !sRefName    = !supportName & '/SREF'
    !sRefAtta    = !sRefName.dbref()
    !sType       = !sRefAtta.sType
    --<<wd>26jun2009 - Defect No. 22278
  endif

  --<RM 18/08/09> -- updated this to return the nweld data from the mds defaults section of the database
  --Set the MDSSELECTION object
  --!objectName = '!!mdsSel' & !sType
  --!object     = $!objectName
  --nwelds attribute is now stored in the catalogue so find it in there
  if (!sType.matchwild(|AC*|) or !sType.matchwild(|AN*|) or !sType.matchwild(|AT*|) or !sType.matchwild(|gt*|) or !sType.matchwild(|SU*|) or !sType.matchwild(|ST*|)) then
    -- Determine the available MDS ANCILLARIES on which the MDS ATTA "AN04" ANCHOR ANCILLARY is ALLOWED
    !sectref = '/MDS/ATTA/DEFAULTS/' & !sType
  elseif (!atta.spref.name.matchwild('*/MDS/.*MAKEUP*')) then
    -- Determine the available MDS ANCILLARIES ALLOWED on the MDS FRAMEWORK STANDARD
    !sectref = '/MDS/TRUNNION/DEFAULTS/' & !sType
  else
    -- Determine the available MDS ANCILLARIES ALLOWED on the MDS FRAMEWORK STANDARD
    !sectref = '/MDS/STRUCTURE/DEFAULTS/' & !sType
  endif

  -- Determine if the MDS Standard SELECTION Data Element EXISTS
  !nwelddata = !sectref & |/GEN/NWEL|
  !nwelddbrf = !nwelddata.dbref()
  handle ANY
    -- Undefined OBJECT $!objectName for this type of MDS Support
    !!mdsDacControl(FALSE)
    return
  endhandle
  !nweld = !nwelddbrf.pprop
  !nweldValues = $!nweld
  if (!nweldValues eq '') then
    !nweldPipeWeld = '0'
    !nweldTrunWeld = '0'
  else
    !nweldPipeWeld = !nweldValues.split(',')[1]
    handle ANY
      !nweldPipeWeld = '0'
    elsehandle NONE
      if !nweldPipeWeld.eq('') then
        !nweldPipeWeld = '0'
      endif
    endhandle

    !nweldTrunWeld = !nweldValues.split(',')[2]
    handle ANY
      !nweldTrunWeld = '0'
    elsehandle NONE
      if !nweldTrunWeld.eq('') then
        !nweldTrunWeld = '0'
      endif
    endhandle
  endif
  -- Determine if the Owning Branch of !atta is an Actual Pipe Branch or a MDS Trunnion Pipe Branch
  !branchType = !atta.owner.:mdsTrun
  if (!branchType.not()) then
    -- The Owning Branch of !atta is an Actual Pipe Branch, i.e. :mdsTrun FALSE
    !atta.nWelds = !nweldPipeWeld.real()
  else
    -- The Owning Branch of !atta is a MDS Trunnion Pipe Branch, i.e. :mdsTrun TRUE
    -- There are EXCEPTIONS in the MDS "AC" Standard Types where MDS TRUNNION INTEGRAL RPAD ATTAS etc.. where
    -- the ATTA NWELDS attribute is required to READ the OBJECT .pipeWeld member and NOT the .trunWeld member,
    -- and set INTEGRAL RPAD ATTA NWELDS attribute accordingly
    -- i.e. The "AC68" RPAD is an integral ATTA of the MDS TRUNNION Support Type "TT44"
    if (!atta.sType inset('AC68')) then
      -- Treat the Owning Trunnion Branch of !atta as an Actual Pipe Branch instead of a Trunnion Branch even though :mdsTrun TRUE
      -- Use the OBJECT .pipeWeld to set INTEGRAL RPAD ATTA NWELDS attribute
      !atta.nWelds = !nweldPipeWeld.real()
      --><wd>26jun2009 - Defect No. 22278
      -- Determine the Pipe Weld Value for a Trunnion attached to the MAIN PIPE at the MDS Trunnion REDU element from the Specific MDSSELECTION object
    elseif (!atta.spref.name.matchwild('*/MDS/.*MAKEUP*')) then
      -- Element !atta is a 'VIRTUAL' MDS Trunnion REDUCER element which is 'WELDED' to the MAIN PIPE for ISOMETRIC/SPOOLER WELD NUMBERING purposes
      !atta.nWelds = !nweldPipeWeld.real()
      --<<wd>26jun2009 - Defect No. 22278
    else
      -- The Owning Branch of !atta is a MDS Trunnion Pipe Branch, i.e. :mdsTrun TRUE
      !atta.nWelds = !nweldTrunWeld.real()
    endif
  endif
  --<RM 18/08/09> -- end of fix

  !!mdsDacControl(FALSE)

endfunction
