--
-- File:                mdsRemoveAutopadRules.pmlfnc
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:
--
-- Author:              R.Martin
-- Created:             30/06/11
--
--
-- Description:
-- function to remove the rule sets from mdsautopad PNOD and PJOI elements. this is required because of an error that was highlighted in defect number P-38756
-- where the mdscreateftxx.pmlfnc would run (delete stru mem). this command would cause errors due to the interconnected dynamic rule references of the PNOD and PJOI
-- IMPORTANT NOTE: the passed element should be no higher in ther hierarchy than a support STRU. if it is higher then the rule sets of multiple existing supports could be removed.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       stru element (or lower in the hierarchy to search through and delete rule sets from
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
define function !!mdsRemoveAutopadRules(!element is DBREF)

  !currentElement = !!ce

  --first check if this is being done on a single element or every member of an owning element. it is assumed that if a pnod is passed then this is a single element removal
  if !element.type.eq('PNOD') then
    !!ce = !element
    rule delete all
    !mem = !element.members
    do !i from 1 to !mem.size()
      if !mem[!i].type.eq('PJOI') then
        !!ce = !mem[!i]
        rule delete all
      endif
    enddo
  else
    --remove the pnod rules using this function recursively
    !mem = !element.members
    do !i from 1 to !mem.size()
      if !element.type.eq('STRU') and !mem[!i].type.neq('FRMW') then
        --this should only be performed on a FRMW element under a stru
        skip
      endif
      !!mdsRemoveAutopadRules(!mem[!i])
    enddo
  endif

  !!ce = !currentElement

endfunction
