-- Created:         30/05/2012 14:55:15
--
--
--
--  Description:  Restore preliminary support from which another support was created
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        FORM          Form with preliminary support object data
--     2     R        BOOLEAN       If form should close on end
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
define function !!mdsRestorePre(!form is FORM, !closeForm is BOOLEAN)

  !!mdsDacControl(true)
  !orig = !!ce

  !!mdsDacControl(true)
  !actions = !form.support.preliminaryStore
  -- First delete old instance if exists (because hierarchy could be changed too)
  if (not badref(!form.support.datum)) then
    !!ce = !form.support.datum
    delete atta
  endif

  -- Loop through ACTIONS
  do !i indices !actions
    $!actions[$!i]
    handle any
      skip
    endhandle
  enddo

  !!ce = !orig
  handle any
    -- orig was the one deleted
  endhandle
  !!mdsDacControl(false)

  if !closeForm then
    !form.hide()
  endif

endfunction
