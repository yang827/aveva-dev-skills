--
-- File:    mdsRotateInterfaceHanger.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.morris
-- Created:   Wed Oct 29
--
--
-- Description:
-- function to rotate general ancillary type FH01 (Vertical pipes only)
-- and rotate the MDS Witch Hanger interface CONSTANT Spring Hanger Types
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R/RW     FORM          The support form e.g. !form
--     2     R        REAL          Angle of rotation
--     3     R        BOOLEAN       true  - Rotate all hanger members
--                                  false - Rotate only selected member
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsRotateInterfaceHanger(!form is FORM, !angle is REAL, !all is BOOLEAN)

  !!mdsDacControl(TRUE)

  if(!angle.unset()) then
    !!mdsDacControl(FALSE)
    !!alert.message('Please type an angle value for rotation')
    return
  endif

  !ce = !!ce
  -- Initialise variables
  !support = !form.support
  !datum = !support.datum

  -- Check that Datum atta has been created
  if (!support.datum.set().not())then
    !!mdsDacControl(FALSE)
    !!alert.message('Datum support atta has not been created')
    return
  endif

  -- Go to datum
  !!ce = !datum

  -- If the atta is a manufacturers atta then just rotate the atta by the angle and exit, unless vertical

  if !!ce.styp.eq('MH01') then
    if !!mdsHangIF.eq('CPL') then
      -- Only rotate hangers with a constant in them.
      PROMPT OFF
      PROMPT LOAD ESCAPE |Identify constant to rotate|
      ID VSPR @
      handle (61,528)
        PROMPT ON
        return
      endhandle
      PROMPT DISMISS
      PROMPT ON
      !constant = !!ce
      if !!ce.catref.owner.:MdsType.neq('CONS') then
        !!alert.error('Identified element is not a constant')
        return
      endif

      --><wd>16jul2009 - DFN P-21516 (SI-12441)
      -- On a Witch Hanger "C52G" TRAPEZE type Configuration "113A/94/C52G/384" - DO NOT allow ANY ROTATION of the "TWO" CONSTANT SPRINGS
      -- as the whole RESTRAINT for the Witch Hanger CONSTANT SPRING TRAPEZE ASSEMBLY shows "TWO CONSTANT SPRINGS plus the TRAPEZE CROSS BAR"
      -- However it is ONLY REPRESENTED in PDMS/MDS as a SINGLE VSPR component referencing a SINGLE SPREF component in th /MDS-CPL specification
      if (!constant.spref.name.matchwild('/MDS-CPL/C52-G*')) then
        !!alert.error('The Identified ''Trapeze-Constant Spring Assembly'' may NOT be rotated')
        return
      endif
      --<<wd>16jul2009 - DFN P-21516 (SI-12441)

      rotate about pa by $!!mdsRothanger.angle.val
      do from 1 to 100
        next
        handle NONE
          thro ce
          conn
          handle ANY
          endhandle
        elsehandle ANY
          hang
          pos pt at pl of last mem
          break
        endhandle
      enddo
      !!ce = !constant

      --><wd>13nov2009 - DFN P-25277 (SI-17086) - ERROR raised when the CE variable !!ce.crfa[3] is UNDEFINED at the CONSTANT SPRING
      if (defined(!!ce.crfa[3])) then
        --<<wd>13nov2009 - DFN P-25277 (SI-17086)
        if !!ce.crfa[3].badref().not() then
          !crfa = crfa
          $!crfa[3]
          conn ph to p3 of href
          do !reset from 1 to !!ce.mcount()
            hang
            $!reset
            thro ce
            conn
            handle ANY
            endhandle
          enddo
          hang
          pos pt at pl of last mem
        endif
        --><wd>13nov2009 - DFN P-25277 (SI-17086) - ERROR raised if !!ce.crfa[3] is UNDEFINED at the CONSTANT SPRING
      endif
      --<<wd>13nov2009 - DFN P-25277 (SI-17086)

      --><wd>22jul2009 - DFN P-21516 (SI-12441)
      !existCE = !!ce
      -- Collect all EXISTING CONSTANT SPRINGS in the EXISTING RESTRAINT
      !restraint = !form.support.rest.name
      var !constantSprings collect all VSPR where (:MDSType of owner of catref eq 'CONS') for $!restraint
      -- At least ONE Constant Spring (VSPR) Exists as Identified above
      -- Therefore Store the FullName and P10 Direction WRT /* of each CONSTANT after it has been ROTATED above
      do !spring indices !constantSprings
        -- There could be ONE or TWO CONSTANT SPRING (VSPR) type elements in the EXISTING RESTRAINT.
        -- This depends on the type of EXISTING Witch Hanger Configuration originally selected
        !constantIDFullName = !constant.fullName
        -- Store the Data for the Identified CONSTANT SPRING
        if (!spring.eq(1) and !constantSprings[!spring].dbref().fullName.trim().eq(!constantIDFullName.trim())) then
          -- This CONSTANT SPRING will always be the FIRST in DB list order in the RESTRAINT
          !fullNameOne  = !constantSprings[!spring].dbref().fullName
          !directionOne = !constantSprings[!spring].dbref().pdir[10].wrt(/* )
          !form.constantNameOne      = !fullNameOne
          !form.constantDirectionOne = !directionOne
        elseif (!spring.eq(2) and !constantSprings[!spring].dbref().fullName.trim().eq(!constantIDFullName.trim())) then
          -- This CONSTANT SPRING will always be the SECOND in DB list order in the RESTRAINT
          !fullNameTwo  = !constantSprings[!spring].dbref().fullName
          !directionTwo = !constantSprings[!spring].dbref().pdir[10].wrt(/* )
          !form.constantNameTwo      = !fullNameTwo
          !form.constantDirectionTwo = !directionTwo
        endif
      enddo
      !!ce = !existCE
      --<<wd>22jul2009 - DFN P-21516 (SI-12441)

      return
    else
      if  !!mdsremovegrad(!!ce)[1].eq(!!ce.cref.tdir.opposite()) or !!mdsremovegrad(!!ce)[2].eq(!!ce.cref.tdir.opposite()) then
        rotate about pl by $!!mdsRothanger.angle.val
      else
        rotate thro pl by $!!mdsRothanger.angle.val
      endif
      -- Rotate all hanger by given value if vertical
      !pldir = pl dir
      if !pldir.string().before(' WRT').eq('U') or !pldir.string().before(' WRT').eq('D') or !pldir.string().before(' WRT').eq('Z') or !pldir.string().before(' WRT').eq('-Z') then
        !datumName = !datum.name
        do !hanger from 1 to 5
          $!datumName/H$!hanger
          handle NONE
            rotate about pl of $!datum by $!!mdsRothanger.angle.val through pl of $!datum
          elsehandle ANY
          endhandle
        enddo
        do !rotateOlets from 1 to 6
          $!datumName/LUG$!rotateOlets
          handle NONE
            rotate about pl of $!datum by $!!mdsRothanger.angle.val through pl of $!datum
          elsehandle ANY
          endhandle
        enddo
      elseif  !!mdsremovegrad(!!ce)[1].eq(!!ce.cref.tdir.opposite()) or !!mdsremovegrad(!!ce)[2].eq(!!ce.cref.tdir.opposite()) then
        !datumName = !datum.name
        do !hanger from 1 to 5
          $!datumName/H$!hanger
          handle NONE
            !oriTdir = tdir
            rotate  about pl of $!datum by $!!mdsRothanger.angle.val through $!datum
            tdir $!oriTdir
          elsehandle ANY
          endhandle
        enddo
        do !rotateOlets from 1 to 6
          $!datumName/LUG$!rotateOlets
          handle NONE
            rotate about pl of $!datum by $!!mdsRothanger.angle.val through pl of $!datum
          elsehandle ANY
          endhandle
        enddo
      endif
      !!ce = !ce

      -- <RM> 20/02/07 -- update offset directions for dynamic types
      !config = !!mdsfhanger.confignumber
      handle ANY
      elsehandle NONE
        if !config.eq(7) or !config.eq(20) then
          !!mdsSetOffsetDir(!support.datum)
        endif
      endhandle

      -- <RM> 20/02/07 -- end of fix

      -- for FRAMATOME LICAD hangers only we need to intersect back to the connecting wall or beam when rotating because if the pipe is sloping.
      -- the rotation will introduce a small distance between the tpos and the wall. therefore we need to be able to reconnect to it in the correct
      -- location once we have been through LICAD again.
      !desc = desc of /MDS/TEMPLATES
      if !!mdsHangIF.eq('LISEGA') and !desc.eq('Framatome Templates') then

        -- only do this if we have 1 hanger
        !hanger2name = !datumName + '/H2'
        -- !hanger2 - DO NOT CHANGE this VARIABLE name if INSTRUCTED to do so by the APPSPAG utility etc...
        !hanger2 = !hanger2name.dbref()
        handle ANY
          -- do nothing
        elsehandle NONE
          -- there are two hangers so return
          return
        endhandle

        -- now get the reference to the connected section or plate
        !hanger1 = !datumName + '/H1'
        !tref = !hanger1.dbref().tref
        handle ANY
          -- hanger not yet built so return
          return
        elsehandle NONE
          if !tref.unset() then
            return
          endif
        endhandle

        --construct plane at the tref with direction tdir
        !fittingPos = !tref.position.wrt( /* )
        !tailDir = !hanger1.dbref().tdir.wrt( /* )
        !tailPV = object POINTVECTOR(!fittingPos, !tailDir)

        -- construct point vector at the hanger tail pointing in the slope direction of the pipe
        !pipeDir = !datum.ldir.wrt( /* )
        !tpos = !hanger1.dbref().tpos.wrt( /* )
        !tposPV = object POINTVECTOR(!tpos, !pipeDir)

        !intersect = !tposPV.intersection(!tailPV.plane())
        !hanger1.dbref().tpos = !intersect

      endif
      return
    endif
  endif

  -- Go to Hanger connected to datum (Atta)
  goto cref
  handle ANY
    -- Atta does not have an hanger connected to it
    --      !!alert.message('Datum support atta does not have an hanger connected to it')
    !oRest = !support.rest
    -- get array of hangers
    !hangers = !oRest.hangers
    !oHang1 = !hangers[1]
    !!ce = !oHang1.ref
    handle ANY
      !!mdsDacControl(FALSE)
      !!alert.message('Unable to reach the first hanger')
      return
    endhandle
  endhandle
  !!mdsDacControl(TRUE)
  -- Get the associated support object for that component
  !oRest = !support.rest
  !oHangType = !!mdsAllHangerTypes.gethangertype(!oRest.styp)
  !oHangType.setRotDefinition()

  if (not !all) then
    -- Rotate only one member
    label /IDENTIFY
    prompt off
    prompt load escape 'Identify hanger member to rotate'
    ID @
    handle (61,528)
      !form.support = !support
      prompt on
      !!ce = !ce
      !!mdsDacControl(FALSE)
      return FALSE
    endhandle
    prompt on

    !element = !!ce
    if (!element.own.type.neq('HANG')) then
      golabel /IDENTIFY
    endif
    -- get list order of the hang in the restr hangers list
    hang
    !hangListNum = order

    !!ce = !element
    !listNum = order
    var !adapterOrders evaluate order for all hang mem with (styp eq 'PIPE CLAMP ADAPTER') for owner
    -- Get the number of adapters preceding the current element.
    -- These adapters are ignored for rotation definition

    !numOfAdapters = 0
    do !i indices !adapterOrders
      if(!listNum gt !adapterOrders[!i].real()) then
        -- current element is POSITIONed after the adapter in the member list
        !numOfAdapters = !numOfAdapters + 1
      elseif(!listNum eq !adapterOrders[!i].real()) then
        -- current element is an adapter
        golabel /exit
      else
        -- current element is POSITIONed before the adapter in the member list
        -- no need to continue
        break
      endif

    enddo

    !hangMemForRot = !oHangType.rotDefinition[!hangListNum]
    handle ANY
      -- There is no rotation definition for this hanger
      -- All hanger elements can be rotated independently
      !hangMemForRot = ARRAY()
    endhandle
    !hangers = !oRest.hangers
    !oHang = !hangers[!hangListNum]
    !hangMem = !oHang.hangMem
    !oHangMem = !hangMemForRot[!listNum - !numOfAdapters]
    handle ANY
      -- there is no rotation definition for this hanger member
      -- So we can rotate it as a single unit
      -- we will create an empty object
      !oHangMem = object MDSHANGMEM()
    endhandle

    if(!oHangMem.canRotate.set() and (not !oHangMem.canRotate)) then
      !!alert.message('This component can not be rotated')
      golabel /IDENTIFY
    endif
    -- If the identified component is contained in a pack
    -- we will rotate all the members of that pack
    -- Get the pack number for that component
    !packNo = !oHangMem.packNo
    -- get the pack array
    !pack = ARRAY()
    if(!packNo.set()) then
      -- Identified component is part of a pack
      !pack = !form.getPack(!hangListNum, !packNo)
    endif
    if(!pack.size() eq 0) then
      -- pack is empty. Identified component is not part of a pack.
      -- we will add the identified component to this ARRAY
      -- so the next loop will be executed at least once on the identified component.
      !pack.append(!listNum - !numOfAdapters)
    endif
    -- Rotate all elements that are in the same pack with the identified element
    -- including the current element
    do !i indices !pack
      hang
      -- Go to hang member. The order numbers in the list are stored
      -- in the pack for the identified component
      $!pack[$!i]

      -- For each adapter that is before the current element in the list
      -- we go to the next element to reach to the original template element
      !numOfAdapters = 0
      do !j indices !adapterOrders
        if(!pack[!i].real() ge !adapterOrders[!j].real()) then
          -- current element is POSITIONed after the adapter in the member list
          -- new list number has increment by one for each adapter
          next
        endif
      enddo

      !listNum = order
      !oHangMem = !hangMem[!listNum]
      if(!oHangMem.orientation.unset()) then
        !oHangMem.orientation = ori wrt /*
      endif
      ROTATE THROUGH CE ABOUT Z wrt /* BY $!angle
      refresh
      -- Update suppMem Data
      !oldDeg = !oHangMem.rotated
      !newDeg = !oldDeg + !angle
      if (!newDeg geq 360)then
        !newDeg = !newDeg - 360
      endif
      !oHangMem.rotated = !newDeg
      !hangMem[!listNum] = !oHangMem
    enddo
    !oHang.hangMem = !hangMem
    !oRest.hangers[!hangListNum] = !oHang
    !support.rest = !oRest
    golabel /IDENTIFY

  else
    -- Rotate all hanger
    !oRest = !support.rest
    -- get array of hangers
    !hangers = !oRest.hangers
    label /IDENTIFYHANG
    if(!hangers.size() gt 1) then
      -- we have more than one hanger
      -- ask the user to identify the hanger
      prompt off
      prompt load escape 'Identify hanger to rotate'
      ID HANG @
      handle (61,528)
        !form.support = !support
        prompt on
        !!ce = !ce
        !!mdsDacControl(FALSE)
        return FALSE
      endhandle
      prompt on

      !element = !!ce
      if (!element.type.neq('HANG') or !element.owner.name.neq(!oRest.ref.name)) then
        golabel /IDENTIFYHANG
      endif
    endif
    -- Current element is the hanger

    !mem = mem
    -- get list order of the hang in the restr hangers list
    !hangListNum = order
    -- Get the associated support object for that component
    !oRest = !support.rest
    -- get array of hangers
    !hangers = !oRest.hangers
    !oHang = !hangers[!hangListNum]
    -- get array of hang members
    !hangMem = !oHang.hangMem
    -- Rotate all hanger members

    !hangMemForRot = !oHangType.rotDefinition[!hangListNum]
    handle ANY
      -- There is no rotation definition for this hanger
      -- All hanger elements can be rotated independently
      !hangMemForRot = ARRAY()
    endhandle

    !fromI = 1
    !numOfAdapters = 0
    !lastI = !mem.size()
    !restart = FALSE
    label /SKIPPCLAMPADAPTER
    do !i from $!fromI to $!lastI
      !restart = FALSE
      !!ce = !mem[$!i]
      if(!!ce.styp.eq('PIPE CLAMP ADAPTER')) then
        -- Ignore bor size adapter for the pclamp
        -- continue loop for the rest of the hanger members
        !fromI = !i + 1 !fromI
        !restart = TRUE
        !numOfAdapters = !numOfAdapters + 1

        break
      endif

      --12/2002 <ab>        !oHangMem = !hangMemForRot[!listNum ]

      !oHangMem = !hangMemForRot[!i - !numOfAdapters ]
      handle ANY
        -- there is no rotation definition for this hanger member
        -- So we can rotate it as a single unit
        -- we will create an empty object
        !oHangMem = object MDSHANGMEM()
      endhandle
      if(!oHangMem.canRotate.set() and (not !oHangMem.canRotate)) then
        skip
      endif
      !oHangMem = !hangMem[!i - !numOfAdapters ]
      if(!oHangMem.orientation.unset()) then
        !oHangMem.orientation = ori wrt /*
      endif
      ROTATE THROUGH CE ABOUT Z wrt /* BY $!angle
      refresh
      -- Update !oHangMem Data
      !oldDeg = !oHangMem.rotated
      !newDeg = !oldDeg + !angle
      if (!newDeg geq 360)then
        !newDeg = !newDeg - 360
      endif
      !oHangMem.rotated = !newDeg
      !hangMem[!i - !numOfAdapters] = !oHangMem
    enddo
    golabel /SKIPPCLAMPADAPTER if(!restart)

    -- Update Support Data
    !oldDeg = !support.rotated
    !newDeg = !oldDeg + !angle
    if (!newDeg geq 360)then
      !newDeg = !newDeg - 360
    endif
    !oHang.hangMem = !hangMem
    !hangers[!hangListNum] = !oHang
    !oRest.hangers = !hangers
    !support.rest = !oRest
    !support.rotated = !newDeg
    !form.support = !support
  endif
  label /exit
  -- Update Graphical Aid Text
  !!mdsaidtext(!form)
  !!ce = !ce
  !!mdsDacControl(FALSE)

endfunction
