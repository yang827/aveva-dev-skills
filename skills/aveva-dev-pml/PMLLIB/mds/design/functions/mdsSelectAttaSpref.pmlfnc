--  Description:    Select sprec.ref. of ATTA/CTSUPP
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsSelectAttaSpref(!styp is STRING,!spec is DBREF)

  if !!ce.type.eq('ATTA') then
    SEL SPREF WITH STYP '$!<styp>' SPEC $!<spec.name>
  else
    !!ce.spref = !!mdsSelectSpref('ATTA',!!ce.owner.ppbor[1],!styp,!spec)[1]
  endif

endfunction
