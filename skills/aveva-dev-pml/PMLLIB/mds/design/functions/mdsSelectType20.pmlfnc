--
-- File:    mdsSelectType20.pmlfnc
--   Type:    Object Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    R.martin
-- Created:   January 2010
--
--
-- Description:
-- id's and returns the tube reference and beam reference for the type 20 hanger
------------------------------------------------------------------------

-- Define Object
define function !!mdsSelectType20(!selectTube is BOOLEAN) is ARRAY

  ---------------------------------------------------------------------------------------------
  --ID THE TUBE - START OF CODE BLOCK----------------------------------------------------------
  ---------------------------------------------------------------------------------------------
  !currentUnits = !!kGetSetUnits()
  mm bore mm dist

  if !selectTube then
    --call the new idtuberef function for interfaces only
    do
      !tubeRef = !!mdsInterfaceIdTube(20)
      handle 1
        !!kRestoreUnits(!currentUnits)
        !text = !!error.text
        return error 1 |$!text|
      elsehandle 2
        --re-identify
        skip
      elsehandle NONE
        break
      endhandle
    enddo
  else
    !tubeRef = object DBREF()
  endif
  ---------------------------------------------------------------------------------------------
  --ID THE TUBE - END OF CODE BLOCK------------------------------------------------------------
  ---------------------------------------------------------------------------------------------

  ---------------------------------------------------------------------------------------------
  --ID THE BEAM - START OF CODE BLOCK----------------------------------------------------------
  ---------------------------------------------------------------------------------------------
  !allowableBeamTypes = !!mdsinterfaceallhangertypes.groupbeamtypes[20]
  !prompt = 'Identify civils to connect hanger to'
  --call the new mdsInterfaceIdSingleHangerSteel function for interfaces only
  do
    !beamRef = !!mdsInterfaceIdSingleHangerSteel(!allowableBeamTypes, !prompt)
    handle 1
      !!kRestoreUnits(!currentUnits)
      !text = !!error.text
      return error 1 |$!text|
    elsehandle 2
      --re-identify
      skip
    elsehandle NONE
      break
    endhandle
  enddo

  --check that we have write access to the selected steelwork
  if !beamRef.dbwrite.not() then
    --if we do not have write access then check whether or not MDS is set up to use hanger connection macros
    if !!mdshangvfitt.eq('DISABLED') then
      !!alert.error('The selected steelwork is write protected. Hangers may be created on write protected steelwork using hanger connection macros but this is not currently enabled - please consult your administrator if this is required')
      return error 1
    endif
  endif
  ---------------------------------------------------------------------------------------------
  --ID THE BEAM - END OF CODE BLOCK------------------------------------------------------------
  ---------------------------------------------------------------------------------------------

  !!kRestoreUnits(!currentUnits)
  !returnArray = object ARRAY()
  !returnArray.append(!tubeRef)
  !returnArray.append(!beamRef)
  return !returnArray

endmethod
