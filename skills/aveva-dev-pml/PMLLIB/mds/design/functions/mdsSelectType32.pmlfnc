--
-- File:    mdsSelectType32.pmlfnc
--   Type:    Object Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    R.martin
-- Created:   January 2010
--
--
-- Description:
-- Multi Discipline Support mdsInterfaceHangerTypes object. Used as a container for all available hanger types.
------------------------------------------------------------------------

-- Define Object
define function !!mdsSelectType32(!selectTube is BOOLEAN) is ARRAY

  ---------------------------------------------------------------------------------------------
  --ID THE TUBE - START OF CODE BLOCK----------------------------------------------------------
  ---------------------------------------------------------------------------------------------
  !currentUnits = !!kGetSetUnits()
  mm bore mm dist

  if !selectTube then
    --call the new idtuberef function for interfaces only
    do
      !tubeRef = !!mdsInterfaceIdTube(2)
      handle 1
        !!kRestoreUnits(!currentUnits)
        !text = !!error.text
        return error 1 |$!text|
      elsehandle 2
        --re-identify
        skip
      elsehandle NONE
        break
      endhandle
    enddo
  else
    !tubeRef = object DBREF()
  endif
  ---------------------------------------------------------------------------------------------
  --ID THE TUBE - END OF CODE BLOCK------------------------------------------------------------
  ---------------------------------------------------------------------------------------------

  ---------------------------------------------------------------------------------------------
  --ID THE BEAMS - START OF CODE BLOCK---------------------------------------------------------
  ---------------------------------------------------------------------------------------------
  !allowableBeamTypes = !!mdsinterfaceallhangertypes.groupbeamtypes[2]
  --do the beam selection until a valid set of channels are available - CHANNEL PAIR 1
  do
    !beam1 = !!getType32Beam1(!allowableBeamTypes)
    handle 1
      !!kRestoreUnits(!currentUnits)
      !text = !!error.text
      return error 1 |$!text|
    endhandle
    !beam2 = !!getType32Beam2(!beam1, !allowableBeamTypes)
    handle 1
      !!kRestoreUnits(!currentUnits)
      !text = !!error.text
      return error 1 |$!text|
    endhandle
    !combinedBeamType = !beam1.gtype + '-' + !beam2.gtype
    if (!allowableBeamTypes.match(!combinedBeamType).gt(0)) then
      --we have a suitable channel selection so break
      break
    else
      !!alert.message('Beams of type $!combinedBeamType are not suitable for this type of hanger')
      !!alert.message('Types, ' + !allowableBeamTypes + ' should be used. Please reselect channels')
      skip
    endif
  enddo

  --do the beam selection until a valid set of channels are available - CHANNEL PAIR 2
  do
    !beam3 = !!getType32Beam3(!allowableBeamTypes)
    handle 1
      !!kRestoreUnits(!currentUnits)
      !text = !!error.text
      return error 1 |$!text|
    endhandle
    !beam4 = !!getType32Beam4(!beam3, !allowableBeamTypes)
    handle 1
      !!kRestoreUnits(!currentUnits)
      !text = !!error.text
      return error 1 |$!text|
    endhandle
    !combinedBeamType = !beam3.gtype + '-' + !beam4.gtype
    if (!allowableBeamTypes.match(!combinedBeamType).gt(0)) then
      --we have a suitable channel selection so break
      break
    else
      !!alert.message('Beams of type $!combinedBeamType are not suitable for this type of hanger')
      !!alert.message('Types, ' + !allowableBeamTypes + ' should be used. Please reselect channels')
      skip
    endif
  enddo

  if !beam1.dbwrite.not() or !beam2.dbwrite.not() or !beam3.dbwrite.not() or !beam4.dbwrite.not() then
    --if we do not have write access then check whether or not MDS is set up to use hanger connection macros
    if !!mdshangvfitt.eq('DISABLED') then
      !!alert.error('The selected steelwork is write protected. Hangers may be created on write protected steelwork using hanger connection macros but this is not currently enabled - please consult your administrator if this is required')
      return error 1
    endif
  endif

  !beamRef = ARRAY()
  !beamRef.append(!beam1)
  !beamRef.append(!beam2)
  !beamRef.append(!beam3)
  !beamRef.append(!beam4)
  ---------------------------------------------------------------------------------------------
  --ID THE BEAM - END OF CODE BLOCK----------------------------------------------------------
  ---------------------------------------------------------------------------------------------

  !!kRestoreUnits(!currentUnits)

  !returnArray = object ARRAY()
  !returnArray.append(!tubeRef)

  -- only return valid navigable references as we are not interested in blank objects
  do !i from 1 to !beamRef.size()
    if !beamRef[!i].badref().not() then
      !returnArray.append(!beamRef[!i])
    endif
  enddo

  return !returnArray

endmethod
