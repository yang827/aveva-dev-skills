--
-- File:    mdsSelectType600.pmlfnc
--   Type:    Object Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    R.martin
-- Created:   January 2010
--
--
-- Description:
-- id's and returns the tube reference and beam reference for the type 7 hanger
------------------------------------------------------------------------

-- Define Object
define function !!mdsSelectType600(!selectTube is BOOLEAN) is ARRAY

  ---------------------------------------------------------------------------------------------
  --ID THE TUBE - START OF CODE BLOCK----------------------------------------------------------
  ---------------------------------------------------------------------------------------------
  !currentUnits = !!kGetSetUnits()
  mm bore mm dist

  if !selectTube then
  --call the new idtuberef function for interfaces only
  do
    !tubeRef = !!mdsInterfaceIdTube(600)
    handle 1
      !!kRestoreUnits(!currentUnits)
      !text = !!error.text
      return error 1 |$!text|
    elsehandle 2
      --re-identify
      skip
    elsehandle NONE
      break
    endhandle
  enddo
  else
    !tubeRef = object DBREF()
  endif
  ---------------------------------------------------------------------------------------------
  --ID THE TUBE - END OF CODE BLOCK------------------------------------------------------------
  ---------------------------------------------------------------------------------------------

  ---------------------------------------------------------------------------------------------
  --ID THE BEAM - START OF CODE BLOCK----------------------------------------------------------
  ---------------------------------------------------------------------------------------------
  !allowableBeamTypes = !!mdsinterfaceallhangertypes.groupbeamtypes[600]
  handle (2,752)
    if !!mdshangif.eq('LISEGA') then
      !beamRef = object DBREF()
    else
      !!kRestoreUnits(!currentUnits)
      !text = !!error.text
      return error 1 |$!text|
    endif
  elsehandle NONE
    !prompt = 'Identify steelwork to connect hanger to'
    --call the new mdsInterfaceIdSingleHangerSteel function for interfaces only
    do
      !beamRef = !!mdsInterfaceIdSingleHangerSteel(!allowableBeamTypes, !prompt)
      handle 1
        !!kRestoreUnits(!currentUnits)
        !text = !!error.text
        return error 1 |$!text|
      elsehandle 2
        --re-identify
        skip
      elsehandle NONE
        break
      endhandle
    enddo
  endhandle
  ---------------------------------------------------------------------------------------------
  --ID THE BEAM - END OF CODE BLOCK------------------------------------------------------------
  ---------------------------------------------------------------------------------------------
  !!kRestoreUnits(!currentUnits)
  !returnArray = object ARRAY()
  !returnArray.append(!tubeRef)

  -- only return valid navigable references as we are not interested in blank objects
  if !!mdshangif.neq('LISEGA') then
    if !beamRef.badref().not() then
      !returnArray.append(!beamRef)
    endif
  else
    !returnArray.append(!beamRef)
  endif

  return !returnArray

endmethod
