-- Created:         20/05/2012
--
--
--
--  Description:    Function set datum atta from preliminary support atta.
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--    1   R      Form                  form for chosen support type
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsSetDatumAtta(!form is FORM)

  -- Exit when user not picked ancillary correctly
  if (badref(!form.support.datum)) then
    -- User probably cancelled while identifying ancillary data in MDSFRAMEANCILLS (for example guide)
    -- so need to cancel whole action and close support form
    !!mdsCancelSupp(!form)
    return
  endif
  !!ce = !form.support.datum
  -- restore position and orientation
  !store = !form.support.preliminaryStore
  --set ori the same as Preliminary
  $!store[4]
  --set pos the same as Preliminary
  $!store[5]

  !sref = !form.support.sref()
  if (not badref(!sref)) then
    !posString = !store[5].after(' ')
    !sref.pos = object POSITION(!posString)
  endif

  --set :MDSSuppFunc the same as Preliminary
  $!store[16]
  handle ANY
    --this error occurs because the suppfunction is unset at this time meaning that the supptype is in array position 15 instead of 16
    $!store[15]
  endhandle

  !preSuppFunc = !!ce.:MDSSuppFunc

  --try and find the SUPF entry for the current ancillary type in the MDS/APPDEFAULTS db
  !choice = !!ce.spref.tans
  if !choice.match('PR').eq(0) then
    !appDefName = '/MDS/ATTA/DEFAULTS/' + '$!choice' + '/GEN/SUPF'
    !appDefRef = !appDefName.dbref()
    handle ANY
      !ancilSuppFunc = 'UNDEFINED'
    elsehandle NONE
      !ancilSuppFunc = $!appDefRef.ppro
    endhandle

    --if the ancilSuppFunc does not match the prelim value then the user has
    --opted to change the original type specified by the ancillary so reset the suppfunc value to
    --the appdefaults definition of the ancillary supf
    if !ancilSuppFunc.neq(!preSuppFunc) then
      :mdssuppfunc '$!ancilSuppFunc'
      handle any
      endhandle
      !!ce.:mdssupptype = !choice
      handle ANY
      endhandle
    else
      !!ce.:mdssupptype = !choice
      handle ANY
      endhandle
    endif
  endif

  !!mdsDistance(!form)
  !form.support.position = true
  !!mdsaidtext(!form)


endfunction
