------------------------------------------------------------------------
--
-- Method:      !!mdsSwitchHangerIf
--
-- Description: Change active hanger interface
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!mdsSwitchHangerIf(!hangIf is STRING) is BOOLEAN

  --check that a hanger is not currently being created - start
  !continue = TRUE
  !types = '1,2,6,7,18,19,20,21,25,31,32,600'
  !typeArray = !types.split(',')
  do !i from 1 to !typeArray.size()
    !number = !typeArray[!i]
    !form = !!mdsHangerType$!<number>
    handle ANY
    elsehandle NONE
      if !form.shown() then
        !continue = FALSE
        break
      endif
    endhandle
  enddo

  if (defined (!!mdsInterfaceHanger)) then
    if !!mdsInterfaceHanger.shown() then
      !continue = FALSE
    endif
  endif

  if (defined (!!mdsFhanger)) then
    if !!mdsFhanger.shown() then
      !continue = FALSE
    endif
  endif

  if (defined (!!mdsFH01)) then
    if !!mdsFH01.shown() then
      !continue = FALSE
    endif
  endif

  if !continue.not() then
    !!alert.warning('Hanger support generation is currently in progress, Please complete or cancel this operation and try again')
    return FALSE
  endif
  --check that a hanger is not currently being created - end

  !!mdsHangIf = !hangIf

  if (defined(!!mdsAllHangerTypes)) then
    !!mdsAllHangerTypes.delete()
  endif

  if (defined(!!manIf)) then
    !!manIf.delete()
  endif

  return TRUE

endfunction
