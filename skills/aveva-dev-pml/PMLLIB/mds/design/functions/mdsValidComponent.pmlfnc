--
-- File: mdsValidComponent.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: R.Martin
-- Created: 31/07/09
--
--
-- Description:
-- returns whether or not the selected item is compatible with the passed component name that is being created
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsValidComponent(!componentName is STRING, !selectedItem is DBREF) is BOOLEAN

  --!componentName is the name of the component we want to create
  --!selectedItem is the name of the item we have picked to check against i.e. a shoe when we are trying to create a guide or stop

  !validComponent = FALSE
  !mdssele = object MDSSELECTION(!componentName)
  !select     = !mdssele.selection
  !restrict   = !mdssele.restriction
  !selectxt   = object ARRAY()
  --!restrtxt   = ''
  !selection  = ''
  --!restrictn  = ''
  if (!select.empty().not()) then
    do !ltyp values !select

      !validComponent = FALSE
      !mdsCode = !selectedItem.prop.desc
      do !i from 1 to !select.size()
        if (!mdsCode.before('*').matchwild(!select[!i])) then
          !validComponent = TRUE
        endif
      enddo

      if !ltyp.match('*').gt(0) then
        !selection = 'Any ' & !ltyp.substring(0,!ltyp.match('*')) & ' type'
      else
        !selection = !!mdsgetdefprop('ATTA', !ltyp, 'CCOD')
      endif
      !replacement = !selection
      --if !replacement.match('-').neq(0) then
      --  !replacement = !replacement.before('-')
      --endif
      !selectxt.append(!replacement)
    enddo
  else
    !selectxt = 'Not specified'
  endif

  if !validComponent eq FALSE then
    !idncomponent = !selectedItem.prop.rnam
    show !!mdsSelectionList
    !!mdsSelectionList.populate(!mdssele.rnam, !idncomponent, !selectxt)
    return FALSE
  endif

  if !restrict.size().gt(0) then
    !restricted = FALSE
    !mdsCode = !selectedItem.prop.desc
    do !i from 1 to !restrict.size()
      if (!mdsCode.before('*').matchwild(!restrict[!i])) then
        !restricted = TRUE
      endif
    enddo
  endif

  if (!restricted) then
    !!alert.message('Selected component restricted for ' + !mdssele.rnam)
    return FALSE
  endif

  return TRUE

endfunction
