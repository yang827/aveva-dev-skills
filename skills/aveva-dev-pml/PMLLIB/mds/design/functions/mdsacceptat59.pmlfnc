--
-- File:		mdsacceptat59.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		8th October 2003
--
--
-- Description:
-- function to check that created support AT59 is acceptable
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!mdsacceptat59()

-- Initialise variables
    !support = !!mdsat59.support

-- Check that creation is complete
    if (not defined(!support.atta[1]))then
      !!alert.message('Support has to exist before creation can be ended')
      return
    endif

-- Check if length of steelwork members exceed maximum of template
    !!mdscheckpar(!!mdsat59)
    if (!!mdscheckLen.accept.not()) then
      return
    endif

    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210

-- Clear form gadgets
    call !!mdscleargadgets(!!mdsat59)

-- If form has been used to modify a support then reactivate cancel button
-- on modify form
    if (!!mdsmodifysupp.cancel.active.not())then
      !!mdsmodifysupp.applyform.remove(5)
        handle (2,752)
        endhandle
      !!mdsmodifysupp.cancel.active = true
    endif

-- Hide Form
    !!mdsat59.hide()

    !!mdsdaccontrol(false)

-- End function
  endfunction

-- End of file mdsacceptat59.pmlfnc
