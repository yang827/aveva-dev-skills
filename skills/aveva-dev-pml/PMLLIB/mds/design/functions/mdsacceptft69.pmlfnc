--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsAcceptFt69()

  -- Initialise variables
  !form = !!mdsft69
  !support = !form.support
  !frmw   = !support.frmw()


  -- Check that creation is complete
  if !support.datum.badref().and(!frmw.badref())then
    !!alert.message('Support frame and datum atta have to exist before creation can be ended')
    return
  endif

  if !support.datum.badref() then
    !!alert.message('Support datum has to exist before creation can be ended')
    return
  endif

  if !frmw.badref() then
    !!alert.message('Support frame has to exist before creation can be ended')
    return
  endif

  -- Check if length of steelwork members exceed maximum of template
  !!mdsCheckLen(!form)

  if (!!mdsCheckLen.accept.not()) then
    return
  endif

  -- Clear graphical tags
  !!mdsClearTags()

  -- Reset design representation if required
  Call !!kActionCommands(!form.repre)


  !!ce = !support.stru

  -- If form has been used to modify a support then reactivate cancel button
  -- on modify form
  if (!!mdsModifySupp.cancel.active.not())then
    !!mdsModifySupp.applyForm.remove(5)
    handle (2,752)
    endhandle
    !!mdsModifySupp.cancel.active = true
  endif

  -- Hide dimensions if shown
  !!mdsClearDim()


  -- Hide Form
  !form.hide()

endfunction
