--
-- File:  mdsaddpad.pmlfnc
--   Type:  Function
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  Design
--   Replaces:
--
-- Author:  Michael Board
-- Created:  Friday 11th December 2009
--
--
-- Description:
-- Function to automatically add pads
--
------------------------------------------------------------------------
--
-----------------------------------------------------------------------------------------------------
define function !!mdsaddpad(!support is MDSSUPPORT,!whichVerticals is STRING)

  --pass support object and string of which verticals to add pads to (ALL, V1, or V2)

  --check if !!mdsoptions.addpad is true of false before running the function

  --collect vertical members

  --loop through, adding pads to CORRECT END

  --choose spec based on type (e.g. GTYP eg ANG)

  --then use design parameters

  !sctns = !support.mdssctns

  !verticalMembers = ARRAY()

  do !i values !sctns
    if !i.name.matchwild('*BAR*').not() AND !whichVerticals.eq('ALL') then
      !verticalMembers.append(!i.sctn)
    elseif !whichVerticals.eq('V2') AND !i.name.matchwild('*-V2') then
      !verticalMembers.append(!i.sctn)
    elseif !whichVerticals.eq('V1') AND !i.name.matchwild('*-V1') then
      !verticalMembers.append(!i.sctn)
    elseif !support.type.eq('FT07') then
      !verticalMembers.append(!i.sctn)
    endif
  enddo

  !datumAtta = !support.datum

  --get direction 'up' from atta, using opposite of p9 direction
  if (!support.type inset('FT08','FT03','FT18','FT35','FT10','FT64','CT04','CT02','CT08')) then
    !dir = !datumAtta.pdir[9].wrt(!datumAtta)
  else
    !dir = !datumAtta.pdir[9].wrt(!datumAtta).opposite()
  endif

  do !j values !verticalMembers

    --<RM> amended the original code that relied upon p9 direction and named standards to determine which end the pad was applied to
    --the new code chooses the furthest end of the steelwork V1, V2 member away from p9 of the datum atta
    !pvP9 = object POINTVECTOR(!datumAtta.ppos[9], !datumAtta.pdir[9].wrt( /* ))
    !pv1 = !pvP9
    !pv2 = !pvP9
    !pv2.direction = !pvP9.direction.opposite()
    !pinStart = !j.posstart.wrt( /* )
    !pinEnd = !j.posend.wrt( /* )
    !pv1 = !pv1.through(!pinStart)
    !pv2 = !pv2.through(!pinEnd)
    !dist1 = !pvP9.position.distance(!pv1.position)
    !dist2 = !pvP9.position.distance(!pv2.position)

    --for each vert member, determine which end to use
    if !dist1.real().geq(!dist2.real()) then
      !whichEnd = 'S'
    else
      !whichEnd = 'E'
    endif

    !!ce = !j

    if !whichEnd.eq('E') then
      !end = 'END'
      !endPos = 'POSE'
      !endDir = 'DRNE'
      !sign = '+'
    else
      !end = 'START'
      !endPos = 'POSS'
      !endDir = 'DRNS'
      !sign = '-'
    endif

    !size = !!ce.para[1]
    !para2 = !!ce.para[2]
    !para3 = !!ce.para[3]
    !para4 = !!ce.para[4]

    !root = '/MDS-Internal_Joints-Spec/'

    !sctnType = !!ce.catr.gtyp
    -- choose the spref of the pad (i.e. shape for different section types)
    -- and choose design parameters
    if !!ce.catr.gtyp.eq('ANG') then

      !spref = $!<root>End_Pad_for_Angle

      if !size.leq(30) then
        !desp1 = 50
        !desp2 = 8
        !desp3 = 11
        --!spref = $!<root>50x8
      elseif  !size.leq(40) then
        !desp1 = 60
        !desp2 = 8
        !desp3 = 10
        --!spref = $!<root>60x8
      elseif  !size.leq(50) then
        !desp1 = 70
        !desp2 = 8
        !desp3 = 10
        --!spref = $!<root>70x8
      elseif  !size.leq(65) then
        !desp1 = 90
        !desp2 = 8
        !desp3 = 12.5
        --!spref = $!<root>90x8
      elseif  !size.leq(75) then
        !desp1 = 100
        !desp2 = 10
        !desp3 = 12.5
        --!spref = $!<root>100x10
      elseif  !size.leq(90) then
        !desp1 = 120
        !desp2 = 10
        !desp3 = 15
        --!spref = $!<root>120x10
      elseif  !size.leq(100) then
        !desp1 = 130
        !desp2 = 10
        !desp3 = 15
        --!spref = $!<root>130x10
      elseif  !size.leq(130) then
        !desp1 = 160
        !desp2 = 10
        !desp3 = 15
        --!spref = $!<root>160x10
      elseif  !size.leq(150) then
        !desp1 = 180
        !desp2 = 10
        !desp3 = 15
        --!spref = $!<root>180x10
      elseif  !size.leq(200) then
        !desp1 = 230
        !desp2 = 15
        !desp3 = 20
      else
        --!!alert.error('Section size is too big for pad!')
        return
      endif

      !despString = !desp1 & ' ' & !desp2 & ' ' & !desp3
    elseif !!ce.catr.gtyp.eq('DINU') OR !!ce.catr.gtyp.eq('BSC') then

      if !endDir.eq('DRNS') then
        !spref = $!<root>End_Pad_for_Channel
        !desp1 = !para2 + 40
        !desp2 = !size + 40
        !desp3 = 15
        !desp4 = !para3

      else
        !spref = $!<root>End_Pad_for_Channel_D
        !desp1 = !para2 + 40
        !desp2 = !size + 40
        !desp3 = 15
        !desp4 = !para3
      endif
      !despString = !desp1 & ' ' & !desp2 & ' ' & !desp3 & ' ' & !desp4

    elseif !!ce.catr.gtyp.eq('FBAR') then

      !spref = $!<root>End_Pad_for_Flatbar
      --!desp1 = !size + 20
      !desp1 = !size + 50
      !desp2 = !para2 * 6
      !desp3 = 25
      --!desp4 = !para2 * 4
      !desp4 = !para2

      !despString = !desp1 & ' ' & !desp2 & ' ' & !desp3 & ' ' & !desp4
    elseif !!ce.catr.gtyp.eq('BEAM') then

      !spref = $!<root>End_Pad_for_Flatbar
      !desp1 = !size + 20
      !desp2 = !para2 + 20
      !desp3 = 15
      !desp4 = !para3

      !despString = !desp1 & ' ' & !desp2 & ' ' & !desp3 & ' ' & !desp4
    elseif !!ce.catr.gtyp.eq('TUBE') then

      !spref = $!<root>End_Pad_for_Tube
      !desp1 = !size + 20
      !desp2 = !para2
      !desp3 = 15

      !despString = !desp1 & ' ' & !desp2 & ' ' & !desp3
    else

      --use flat bar pad as generic pad
      !spref = $!<root>End_Pad_for_Flatbar
      !desp1 = !size + 20
      !desp2 = !size + 20
      !desp3 = 15
      !desp4 = !para3

      !despString = !desp1 & ' ' & !desp2 & ' ' & !desp3 & ' ' & !desp4
    endif

    !sctnName = !!ce.name
    !ce = !!ce
    var !fittColl coll all PJOI with gtyp eq 'APAD' for stru
    do !ii values !fittColl
      $!ii
      end
      var !pnodRule rule
      if (!ii.dbref().cref.eq(!sctnName.dbref()) and match(!pnodRule, '$!endPos') gt 0)  then
        if !!alert.confirm('Identified SCTN $!end already has a PAD, Do you want it to be recreated?').eq('YES') then
          $!ii
          rule delete all
          end
          !npos = !!ce.npos
          rule delete all
          delete PNOD
          !!ce = !ce
          extend $!end through $!npos recalculate
        else
          return
        endif
      endif
    enddo

    !!ce = !ce
    new PNOD
    handle ANY
    elsehandle NONE
      do !i to 20
        name $!sctnName/pnod$!i
        handle ANY
          skip
        elsehandle NONE
          at $!endPos of prev sctn
          SET
          new pjoi
          Name */pjoi1
          break
        endhandle
      enddo

      spref $!spref
      gtype APAD
      jlin na
      cref  $!sctnName $!end

      --!!ce.cutb = !!ce.rpro.tHKN
      if !sctnType.eq('ANG') or !sctnType.eq('TUBE') then
        !!ce.cutb = !desp2
      else
        !!ce.cutb = !desp4
      endif
      rule set  cutplane dynamic $!endDir of cref
      rule set  opdir dynamic $!endDir of cref
      rule set  delp dynamic (e 0 n 0 u 0 )
      reconn
      -- set bang of join
      !!mdssetjoinbang(ce)
      --!this.setBang(ce)
      -- set despars
      desp $!despString
      pnod
      --rule set npos dynamic $!endPos of cref of 1
      rule set npos (e(comp e of $!endPos of cref of 1 wrt cref of 1) n(comp n of $!endPos of cref of 1 wrt cref of 1) u(comp u of $!endPos of cref of 1 wrt cref of 1 $!sign cutb of 1) wrt cref of 1)
      rule set npos dynamic

    endhandle

  enddo

endfunction
