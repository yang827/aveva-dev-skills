--
--   File: mdsadjtrunlen.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--   Keyword: MDS
--   Module: DESIGN
--
--   Replaces:

--   Author: Wayne Dodwell
--   Created: Wednesday 26th February 2003


-- Description:
--             Function for ADJUSTING a Trunnion Length when Adding an ISOLATION Pad,
--             i.e. AT33, AT34, AT35, AT59, to a suitable Trunnion Base Plate
--
--------------------------------------------------------------------------------
-- Arguments:
--
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        DBREF         Existing Trunnion Base Plate Atta
--     2      R        DBREF         New Isolation Pad Atta
--     3      R        DBREF         Existing Trunnion SREF Atta
--     4      R        FORM          Calling Form for Isolation Pad
--     5      R        STRING        'CREATE', 'ADJUST' or 'DELETE'
--     6      R        STRING        Trunnion Length Warning Message
--
--- Return:
--    [Data Type]   [Description]
--
--     BOOLEAN       Returns 'true'  if the Trunnion Length is within the MDS Standards Permissible MIN/MAX Height Range
--              or   Returns 'false' if the Trunnion Length is out of the MDS Standards Permissible MIN/MAX Height Range
--
--     STRING        Returns the variable !trunLenWarn by association from the calling function-

--------------------------------------------------------------------------------
--
-- Define Function
  define function !!mdsAdjTrunLen(!bPlt is DBREF, !iPad is DBREF, !trun is DBREF, !form is FORM, !action is STRING, !trunLenWarn is STRING) is BOOLEAN

-- Initialise Variables
    !xistCe = !!ce

--<wd>oct2003
  if (!action inset ('CREATE','ADJUST')) then
    if (!action.eq('CREATE')) then
-- Create a Trunnion Isolation/Slide Pad Ancillary
      !xtrLen = !form.tLength
    elseif (!action.eq('ADJUST')) then
-- Adjust the Length of a Trunnion from a Trunnion Form
      !xtrLen = !form.tLength.val.real()
      handle any
        !xtrLen = !form.tLength
      endhandle
    endif

    !!ce    = !bPlt
    !unusedBpltLn = !!kStrReal('cons dist p1 to p2')
-- Navigate to the  Cold Isolation Block/Isolation Pad etc...
    !!ce    = !iPad
--<wd>feb2004
    if (!iPad.stype inset ('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT59','AT68','AT100A','AT100B','AT101A','AT101B')) then
-- Trunnion Base Plate Isolation Pad or Slide Unit etc...
      !iPadLn = !!kStrReal('cons dist p12 to p13')
    else
-- Trunnion Base Plate Guide, Stop or Anchor etc...
      !iPadLn = 0
    endif
--<wd>feb2004
    !trnTyp = !trun.styp
    !branch = !trun.owner

-- Get the Min and Max Length Values of the Trunnion Bore Length
--<wd>oct2003
-- The !trn.abor was getting the SREF atta ABOR which is the INCORRECT pipe size.
-- When determining the MIN and MAX trunnion lengths the MAIN BRANCH HBOR size MUST be USED.
    --!trnABor = !trun.abor
    --!minLen  = !!mdsPar$!trnTyp[$!trnABor].minimum
    --!maxLen  = !!mdsPar$!trnTyp[$!trnABor].maximum

-------------------------------------------------------------------------------
-- mjb >>> 24.04.06 <mds12>

    !braHBor = !branch.hbor
    !mdsTrunObj  = object MDSREADTRUNDATA()
    !mdsTrunData = !mdsTrunObj.mdsTrunData(!trnTyp,!braHBor.real().value())

     if (!mdsTrunData.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
      if (!mdsTrunObj.mdsStd.sactive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
        !errormessage = !mdsTrunObj.mdsStd.smess
      elseif (!mdsTrunObj.mdsStd.cactive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
        !errormessage = !mdsTrunObj.mdsStd.cmess
      endif
      !!alert.error(!errormessage)
      return
    endif

    !minLen = !mdsTrunObj.minlength
    !maxLen = !mdsTrunObj.maxlength

    --!minLen  = !!mdsPar$!trnTyp[$!braHBor].minimum
    --!maxLen  = !!mdsPar$!trnTyp[$!braHBor].maximum
--mjb <<< 24.04.06 end
-------------------------------------------------------------------------------

--<wd>oct2003

--<wd>oct2003
-- Set Trunnion SREF Atta Despar for Trunnion Length - Currently Always DESP[6]
    -- !dpNum   = 6
-- Determine the Trunnion SREF Atta Despar used to store the Trunnion Length -
-- The MDS Trunnions DO NOT have a DATA element with a DKEY in order to extract the Trunnion Length DESPAR NUMBER
    if (!trun.:MDSSuppType.eq('TT25')) then
      !dpNum = 3
--  elseif (!trun.:MDSSuppType inset ('TT04','TT05','TT06','TT07','TT08','TT09','TT10','TT11','TT12','TT13','TT22','TT28','TT26','TT36')) then
--ge/07/12/04 Fix for HPD0027087 Added TT37 to the list
--<dw>oct2008 dun979 - Also to allow for additional trunnion types TT42 to TT44
    elseif (!trun.:MDSSuppType inset ('TT04','TT05','TT06','TT07','TT08','TT09','TT10','TT11','TT12','TT13','TT18','TT22','TT28','TT26','TT36','TT37','TT42','TT43','TT44')) then
      !dpNum = 5
    endif
--<wd>oct2003


-- Get the Despar Number for the !iPad for the DKEY XHEI
    !!ce   = !iPad
    !ipNum = !!mdsGetDesp('XHEI')

----------------------------------`----------------------------------------------
-- Adjust Trunnion Length on Creation of Isolation Pad/Cold Block if within Trunnion Length MIN/MAX Limits
    --if ((!action.eq('CREATE')) or (!action.eq('ADJUST'))) then
-- Set the value of the NEW Trunnion Length Required
--<wd>oct2003
      if (!iPad.styp inset ('AT59','AT68')) then
        if (!action.eq('ADJUST')) then
          !ntrLen = (!xtrLen)
        elseif (!action.eq('CREATE')) then
          !ntrLen = (!xtrLen - !iPadLn)
        endif
--<wd>oct2003
      else
        !ntrLen = (!xtrLen - !iPadLn)
      endif

--Check if New Trunnion Length is within the MIN/MAX Limits
      if(!ntrLen.lt(!minLen)) then
        !!kFormatText.text.val = !minLen
        !minVal = true
        !frmLen = !ntrLen.string(!!distanceFMT)
        !minFMT = !minLen.string(!!distanceFMT)

        if (!action.eq('CREATE')) then
          !trunLenWarn = |The NEW Trunnion Length $!frmLen is less than the minimum allowed. setting Trunnion Length to the minimum of $!<minFMT>|
        elseif (!action.eq('ADJUST')) then
          !trunLenWarn = |The Trunnion Length is set to its minimum. therefore the Pad has been appended to the bottom of the Trunnion Base Plate.|
        endif

        !!mdsSetDesPar(!trun,!dpNum,!minLen)
        !!mdsSetDesPar(!iPad,!ipNum,!minLen)
        !!ce    = !xistCe
        !return = false
      else
        !minVal = false
      endif

-- Check New Trunnion Length Against the Permissible MAXIMUM Height
      if (!ntrLen.gt(!maxLen)) then
        !!kFormatText.text.val = !maxLen
        !maxVal = true
        !frmLen = !ntrLen.string(!!distanceFMT)
        !maxFMT = !maxLen.string(!!distanceFMT)

        if (!action.eq('CREATE')) then
          !trunLenWarn = |The NEW Trunnion Length $!frmLen is greater than the maximum allowed. setting Trunnion Length to the maximum of $!<maxFMT>|
        elseif (!action.eq('ADJUST')) then
          !trunLenWarn = |The Trunnion Length is set to its maximum. therefore the Pad has been appended to the bottom of the Trunnion Base Plate.|
        endif

        !!mdsSetDesPar(!trun,!dpNum,!maxLen)
        !!mdsSetDesPar(!iPad,!ipNum,!maxLen)
        !!ce    = !xistCe
        !return = false
      else
        !maxVal = false
      endif
-- Trunnion Length is within the Permissible Range, so silently set the despar for the
-- Trunnion Length here if value is within the Permissible Min/Max Trunnion Length limits
      if (!minVal.not() and !maxVal.not()) then
        !!mdsSetDesPar(!trun,!dpNum,!ntrLen)
        !!mdsSetDesPar(!iPad,!ipNum,!ntrLen)
        !!ce    = !xistCe
        !return = true
--$P-Case-1 - BETWEEN MIN  & MAX values ** !trnDif = ($!iPadLn)
        !trnDif = !iPadLn
      elseif (!minVal) then
--$P-Case-2 - !minVal is $!minVal** !trnDif = ($!minLen - $!xtrLen)
        !trnDif = (!minLen - !xtrLen)
      elseif (!maxVal) then
--$P-Case-3 - !maxVal is $!maxVal ** !trnDif = ($!iPadLn)
        !trnDif = (!iPadLn)
      endif

--<wd>oct2003
      if (!iPad.styp inset ('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT100A','AT100B','AT101A','AT101B')) then
-- These Trunnion Isolation/Slide-Unit Pads have ZERO LENGTH (PA and PL have identical positions) and are NOT allowed on Trunnions with BEARING PLATES
--<wd>oct2003

-- Adjust Tail Position of Trunnion Branch and Reconnect Isolation Pad and Trunnion Base Plate
        !!ce = !branch
        tail
        move pt dist $!trnDif

-- Move Trunnion Base Plate in line with Pipe Tail
        !!ce = !bPlt
        drag move pl thro pt
        handle any
        endhandle
-- Move ATTA 2 back to avoid DATACON errors Mod by BC 22/04/04
        Atta 2
        Conn
-- Connect New Isolation Pad to Trunnion Base Plate
        !!ce = !iPad
        conn
        handle any
          fconn
        endhandle

--<wd>oct2003
      elseif (!iPad.styp inset ('AT59','AT68')) then
-- This Trunnion Cold Isolation Block DOES HAVE a component length GREATER than ZERO i.e.(PA and PL DO NOT have identical positions)
-- Also the 'AT59' is allowed on BOTH Trunnions with BASE PLATE and with or without a BEARING PLATE.
--<dw>oct2008 dun979 - Also to allow for additional trunnion types TT42 to TT44
        if (!trun.:MDSSuppType inset ('TT04','TT06','TT08','TT10','TT12','TT22','TT25','TT26','TT36','TT42','TT43','TT44')) then
-- These Trunnions ONLY have a BASE PLATE
-- Move Trunnion Base Plate
          !!ce = !bPlt
          if (!minVal) then
            if (!trnDif.lt(0)) then
              !trnDif = !trnDif.abs()
              tail
              move pt dist $!trnDif
            endif
            !!ce = !bPlt
            drag move pl d thro pt
            handle any
            endhandle
          elseif (!maxVal) then
            drag move pl d thro pt
            handle any
            endhandle
            by d $!trnDif
          elseif (!minVal.not() and !maxVal.not()) then
            drag move pl d thro pt
            handle any
            endhandle
            by u $!iPadLn
          endif

-- Connect New Isolation Block to Trunnion Base Plate
          !!ce = !iPad
          conn
          handle any
            fconn
          endhandle
--<wd>jan2004
-- Check if the New Isolation Block is a DATUM Atta of a MDS FRAMEWORK
          if (!!ce.name.match('/DATUM').gt(1)) then
            next
-- Goto SREF Atta of MDS Framework
            conn
            handle ANY
              fconn
            endhandle
          endif
--<wd>jan2004

-- Adjust Tail Position of Trunnion Branch and Reconnect Isolation Pad and Trunnion Base Plate
          !!ce = !branch
          tail
          conn pt to last mem
          handle any
            fconn pt to last mem
          endhandle

-- Move the last 2 ATTAS belonging to the TRUNNION <i.e. same name> to avoid DATACON Errors
--<wd>feb2004
          !!ce = !bPlt
          prev atta
          --last atta
--<wd>feb2004
          at pa of next
          prev atta
          conn to next

-- On Necessary Trunnion Types Adjust Collar Plate and the WELD (FFW) Position
          if (!trun.:MDSSuppType inset ('TT06','TT10','TT22')) then
            prev atta
            conn to next
            by u 50
            prev plat
            move pa d thro pl of $!bPlt
            by u 230
            prev
            conn to next
            atta 1
            conn
          endif

        elseif (!trun.:MDSSuppType inset ('TT05','TT07','TT09','TT11','TT13','TT28')) then
-- These Trunnions have BOTH a BASE PLATE and BEARING PLATE
          !!ce = !bPlt
-- Bearing Plate Thickness
          next2
          !bearLn = !!kStrReal('cons dist p1 to p2')
          branch
          pin 7 copy ph
          if (!!ce.href.type.neq('REDU')) then
            pin 7 plane pin 7 thro p0 of href
          endif

-- Move Trunnion Base Plate
          !!ce = !bPlt
          if (!minVal) then
--$P ** MINVAL
            --drag move pl d thro pt
            pin 7 dist $!minLen
            drag move pl d thro pin 7
            handle any
            endhandle
          elseif (!maxVal) then
--$P ** MAXVAL
            drag move pl d thro pt
            handle any
            endhandle
            by d ( $!trnDif - $!bearLn )
          elseif (!minVal.not() and !maxVal.not()) then
--$P ** NOT MINVAL and NOT MAXVAL
            drag move pl d thro pt
            handle any
            endhandle
            by u ( $!iPadLn + $!bearLn )
          endif

-- Connect New Isolation Block to Trunnion Base Plate
          !!ce = !iPad
          conn
          handle any
            fconn
          endhandle

-- Connect Bearing Plate to the New Isolation Block
          next
          conn
          handle any
            fconn
          endhandle

-- Adjust Tail Position of Trunnion Branch and Reconnect Isolation Pad and Trunnion Base Plate
          !!ce = !branch
          tail
          conn pt to last mem
          handle any
            fconn pt to last mem
          endhandle

--<wd>dec2006<mds12>
-- Navigating to the LAST ATTA when on a MDS FRAMEWORK, e.g. RAISES the ERORR = (2,113) List exhausted for BRANCH /<trunnion branch name>
-- So Navigate to the Trunnion Base Plate (NOT the Bearing plate) and then access the previous ATTA(which is the ATTA required),
-- i.e. prev atta etc...
          !!ce = !bPlt
          prev atta
-- Move the last 3 ATTAS to avoid DATACON Errors
--<wd>dec2006<mds12> this code RAISES the ERORR = (2,113) List exhausted for BRANCH /<trunnion branch name>
--          last atta
--<wd>dec2006<mds12>
          at pa of next
          prev atta
          conn to next
          prev atta
          conn to next
          by u 50

-- On Necessary Trunnion Types Adjust Collar Plate and the WELD (FFW) Position
          if (!trun.:MDSSuppType inset ('TT07','TT11','TT28')) then
            prev plat
            move pa d thro pl of $!bPlt
            --by u $!iPadLn
            by u 230
            prev
            conn to next
          endif

        endif
        branch
        tail
        tcon CLOS
      endif
--<wd>oct2003

      !!ce = !xistCe

-- OK to Adjust the Trunnion Length
      return !return

  endif

endfunction
