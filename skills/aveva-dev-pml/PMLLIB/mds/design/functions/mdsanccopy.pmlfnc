--------------------------------------------------------------------------------
--
-- File:		mdsanccopy.pmlfnc
--   Type:		Form
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 27th November 2001
--
--
-- Description:
-- Function for Copying a MDS Pipe Ancillary Support (ATTA) onto the
-- Same Pipe as the Selected Ancillary on the Same MDS Framework
--
--------------------------------------------------------------------------------
  define function !!mdsanccopy(!form is form)

-- Check that Datum atta has been created
    if (!form.support.datum.set().not())then
      !!alert.message('Datum support atta has not been created')
      return
    endif

$(
--<wd>4dec2002 -- This CODE ERRORS when Copying INDIVIDUAL ANCILLARY Attas NOT on a FRAMEWORK!!!
-- Check that the support stru has been created
    if (!form.support.stru.mcount.eq(0))then
      !!alert.message('Support structure has not been created')
      return
    endif
$)

-- Select Label
    label /select

-- Identify atta on current support only
    prompt off
    prompt load escape |Identify ancillary to copy|
    id atta @
    handle (61,528)
      prompt dismiss
      prompt on
      return
    endhandle
    !atta = !!ce
    prompt dismiss
    prompt on

-- Is it on this MDS support
    if (!!mdschecksupp(!form, !atta).not()) then
      !!alert.error('Identified ancillary does not belong to this support.Select another ancillary')
      golabel /select
      return
    endif

-- Is it the Sref Atta
    if (!!ce.name.match('/SREF').gt(0)) then
      !!alert.error('The ''/SREF'' atta cannot be copied. Select another ancillary')
      golabel /select
    endif

-- Check to see if you can copy the identified ancillary
   if !!mdscomclaimdac(!!ce,'DACCRE','ATTA').not() then
     prompt dismiss
     prompt on
     !!alert.error(!!error.text)
     return
   endif

-- Temporarily Enhance the Selected Ancillary in the Colour RED
    enhance $!atta col 2
    if (!!alert.confirm('Copy the Ancillary highlighted in RED?', 0.4, 0.1).eq('NO')) then
      unenhance $!atta
      enhance $!atta col $!!gphcolopt.highlight.code
      golabel /select
    endif

-- Copy Selected Ancillary, Name, Add to the Support Object,
-- Update the Graphical Display Text and Rotate by 90 degrees
-- so user can Easily Identify the NEW Ancillary.

-- Create a NEW ATTA by copying the identified atta
    !rotang = true
    if (!form.support.stru.set()) then
      !p9dir = !form.support.p9dir
    else
      !!ce = !atta
      !p9dir = p9 dir wrt /*
    endif
   !!mdsdaccontrol(true)
    new atta copy $!atta
    !newatta = !!ce
    !!ce.:mdsrotated = !rotang
    !!ce.:mdsrotdir  = !p9dir
-- Unset the relevant MDS Reference UDAs
    :mdspackref  nulref
    :mdsguideref nulref
    :mdsbpref1   nulref

-- Name the NEW ATTA with the next available number
    !num = 1
    do
      if (!form.name.val.match('/').neq(1)) then
        !suppname = '/' & !form.name.val
      else
        !suppname = !form.name.val
      endif
      name $!<suppname>.$!<num>
      handle (41,12)
-- Name already used
        !num = !num + 1
        skip
      elsehandle none
--<wd>may2003
        !name = $!<suppname>.$!<num>
--<wd>may2003
        break
      endhandle
    enddo

-- Add the Copied Ancillary to the Suppport Object Member 'ATTA'
    !form.support.atta.append(!newatta)
    !!ce = !newatta


-- Add the Copied Ancillary to the Correct Support Object Member 'BARS'
-- And also add it to the same X-BAR SCTN as the original ATTA being copied
    !bars = !form.support.bars
    !added = false
    do !indx indices !bars
      do !numb indices !bars[!indx]
        if (!bars[!indx][!numb].eq(!atta)) then
-- Support Object
          !form.support.bars[!indx].append(!newatta)
-- Support Cross Bar
          !xbar  = !suppname & '-BAR-' & !indx
          !!ce   = !xbar.dbref()
            handle ANY
              !xbar  = !suppname & '-V' & !indx
              !!ce   = !xbar.dbref()
--<wd>feb2004>
              handle ANY
-- MDS Framework currently doesn't have ANY SCTN Members
                !added = TRUE
                break
              endhandle
--<wd>feb2004>
            endhandle
          !!ce.:mdsattaref = !form.support.bars[!indx]
          !added = TRUE
          break
        endif
      enddo
      break if (!added)
    enddo

-- Rotate the Copied Atta by 90 degrees for Graphical Clarity ONLY
    !!ce = !newatta
    rotate through ce about p1 by -90

    --<tm> addition to create lugs on the copied ancillary
    if (!!ce.styp inset('ST19','ST21','ST22','ST23')) then
        !!MdsCreateLugs()
    endif
    !!ce = !newatta
   --<tm> end of lug code addition


--<wd>may2003
-- Update the STEX to contain the ORIENTATION to be output on the Isometric Drawing
    !!mdstransport(!newatta,!name.string())
--<wd>may2003

    !!mdsdaccontrol(false)

-- Advise User of the New Name and Enhance to the Normal Highlight Colour
    !!alert.message('The Copied Ancillary has been ROTATED 90 Deg. from it''s original position')
    unenhance $!newatta
    enhance $!newatta col $!!gphcolopt.highlight.code
    unenhance $!atta
    enhance $!atta col $!!gphcolopt.highlight.code
    unenhance $!suppname
    enhance $!suppname col $!!gphcolopt.highlight.code

-- Update the Graphical Aid Text
    !!mdsaidtext(!form)
    !!ce = !newatta
$(
    var !apos ppos9 wrt world
    !aname = after(!!ce.name, '.')
    var !anum (210 + $!aname)
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!anum $!aname $<$!apos$>
$)

--------------------------------------------------------------------------------
-- End of Function - !!mdsanccopy
  endfunction
