-------------------------------------------------------------------------------
-- Description:
---------------
-- Function to create an Association (ASSOC) and its owning ASSOGP etc... for a graphically selected
--  MDS STRUCTURE FRAMEWORK Support SCTN member and a graphically selected MAIN structure element
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------

-- Define Function
define function !!mdsassociations()

-- FIRST - Select a valid MDS Structure Support SCTN member
  !xce = !!ce
  do from 1 to 5
    prompt off
    prompt load escape |Identify a MDS Support SCTN element to Associate|
--IDENTIFY the MDS Support SCTN element required
    id SCTN @
    handle (61,528) $* User has clicked the 'ESC' key to exit
      prompt on
      !!ce = !xce
      prompt dismiss
      prompt on
      return
    endhandle
    prompt dismiss
    prompt on
-- Store the !mdspick
    !mdspick = !!ce

-- Check the owning STRU is a VALID MDS Support
    if (!mdspick.owner.owner.:mdssupptype.unset()) then
-- Invalid SCTN selected as the owning STRUCTURE :mdssupptype is "unset"
      !!alert.error('The selected SCTN element does NOT belong to a MDS STRUCTURE Support')
      skip
    endif

-- Check the MDS Support ZONE attributes
    !zoneatt = !!mdsidsatt
    !zoneval = !!mdsidsval
    if (!mdspick.owner.owner.owner.$!<zoneatt>.neq(!zoneval ) ) then
-- Invalid SCTN selected as the owning ZONE is not a valid ZONE for MDS Structure Supports
      !!alert.error('The selected SCTN element does NOT belong to a valid ZONE for MDS STRUCTURE Supports')
      skip
    else
-- Valid MDS Support SCTN selected
      !mdsstru = !mdspick.owner.owner
      !mdsname = !mdsstru.name
    endif

-- Check User has DBWRITE Database Access to Continue
    if (!mdspick.dbwrite.not()) then
      !!alert.error('The selected MDS Support SCTN belongs to a READ ONLY database. Unable to continue.')
      return
    else
-- User is able to continue as the database has DBWRITE Access
      break
    endif

  enddo

-- SECOND - Select a MAIN Structure element to Associate with the selected MDS SCTN
  !session   = current session
  if !session.module().upcase().match('DESIGN').gt(0) then
    !IDType    = 'GENSEC SCTN SBFI PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX'
  elseif  !session.module().upcase().match('OUTFITTING').gt(0) then
    !IDType    = 'GENSEC SCTN SBFI PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX HSTIFF HPLATE'
  endif

--IDENTIFY the MAIN Structure element required
  prompt off
  prompt load escape |Identify a MAIN Structure element to Associate with the MDS SCTN element|
  id $!idtype @
  handle (61,528) $* User has clicked the 'ESC' key to exit
    prompt on
    !!ce = !xce
    prompt dismiss
    prompt on
    return
  endhandle
  prompt dismiss
  prompt on
-- Store the !mainpick
  !mainpick = !!ce

-- Store the current MDS STRUCTURE creation ZONE set in the form !!mdsoptions to RESET it later
  !xstzonename = !!mdsoptions.site.val

-- Temporarily SET the MDS ZONE name for the Current selected MDS STRUCTURE Support in the form !!mdsoptions
-- for the Creation of the MDS SCTN Association (ASSOC) element etc...
  !newzonename = !mdsstru.owner.name
  !!mdsoptions.site.val = !newzonename

-- Create the Cross Reference ASSOCIATION between the selected MDS SUPPORT SCTN member
-- and the selected MAIN Structure element:
-- <a> for this PML function the create MODE will always be 'CLEARANCE' mode
--
-- Initialise the MDS Associations Data Creation Object MDSASSOC
  !mdsassoc = object mdsassoc()
  !mdsassoc.mode  ='CLEARANCE'
  !mdsassoc.pick3 = !mainpick

-- Check if ANY MDS Cross Reference Associations (ASSOCs) already EXIST for the selected MDS Structure Support
  !assogpname  = !mdsname & |-MDS-ASSOGP|
  !assogpdbref = !assogpname.dbref()
  handle (2,109)
-- Undefined Name so there aren't ANT EXISTING MDS Cross Reference Associations (ASSOCs
    !mdsassoc.mdsmember[1] = !mdspick
    !nextxref = 1
  elsehandle NONE
-- Check how many MDS Cross Reference Associations (ASSOCs) already EXIST in the EXISTING ASSOGP
    !!ce = !assogpdbref
    !xstassoc = !assogpdbref.mcount('ASSOC')
    !nextxref  = !xstassoc + 1
    !mdsassoc.mdsmember[!nextxref] = !mdspick
  endhandle

-- Initialising the MDSASSOWL object below will always Create an ADDITIONAL Cross Reference Association
-- (ASSOC) element for the passed Current MDS STRUCTURE Support, i.e. !mdsstru
  !mdsassowl = object mdsassowl(!mdsstru)
  !mdsassowl.mdsassoc = !mdsassoc

-- Create the Association (ASSOC) for the Selected SCTN member for the Current MDS Support
  !mdsassowl.mdsassoc(!mdsassoc, !nextxref)

-- Navigate back to the Original Current Element
  !!ce = !xce

-- RESET the !!mdsoptions.site GADGET value to its ORIGINAL value
  !!mdsoptions.site.val = !xstzonename

-- Return to the ORIGINAL element in the Database
  !!ce = !xce

-- End Function
endfunction
