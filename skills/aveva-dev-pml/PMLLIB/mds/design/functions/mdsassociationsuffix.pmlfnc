--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsAssociationSuffix(!type is STRING) is STRING

  -- hard-coded defaults
  !assowl = '-MDS-ASSOWL'
  !assogp = '-MDS-ASSOGP'
  !assoc = '-MDS-ASSOC-CROSS-REF-'

  !var = '!' & !type
  !suffix = !var.block().evaluate()
  handle ANY
    return error 1 'Invalid element type!'
  endhandle

  return !suffix

endfunction
