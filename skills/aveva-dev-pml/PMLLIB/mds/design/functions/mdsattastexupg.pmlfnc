--
-- File: mdsattastexupg.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Wayne Dodwell
-- Created: Tuesday 6th May 2003
--
--
-- Description:
-- Upgrade ALL necessary MDS Attas on PIPES only (not TRAYS or HVAC or PIPE REST ATTAs)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!mdsattastexupg()

-- Check in DESIGN Module
    !sess = current session
--<wd>30jan2008
-- DUN808 P-125 -- All instances of the evars "PDMS_MARINE and "MARINE" changed to "AVEVA_MARINE"
--    var !ismarine evar 'PDMS_MARINE'
    var !ismarine evar 'AVEVA_MARINE'
--
-- This 'if' statement is NOT working as required, so the 'or' operator changed to 'and' -- which is now OK
--    if (!sess.module().upcase().neq('DESIGN')) or (!sess.module().upcase().neq('OUTFITTING')) then
    if (!sess.module().upcase().neq('DESIGN')) and (!sess.module().upcase().neq('OUTFITTING')) then
--<wd>30jan2008
      if !ismarine.boolean() then
        !!alert.error(|The function 'mdsattstexupg()' may only be called from within the Outfitting Module|)
      else
        !!alert.error(|The function 'mdsattstexupg()' may only be called from within the Design Module|)
      endif
      return
--<wd>30jan2008 -- Check USER is in the MDS Application
    else
      if (!!appdesmain.formtitle.matchwild('*Multi Discipline Supports*').not()) then
        !!alert.error(|The function 'mdsattstexupg()' may only be called from within the Multi Discipline Supports Application|)
        return
      endif
--<wd>30jan2008
    endif

-- Confirm that MDS ATTAS STEX is to be Upgraded with The ORIENTATION of the P9 direction of the MDS ATTA
    if(!!alert.confirm('This PML function will upgrade the STEX of the relevant MDS ATTAS with the ORIENTATION of the ATTA. Do you want to continue?').eq('NO')) then
      return
    endif

-- Initialise Arrays
    !project  = current project
    !prjcode  = !project.code()
    !datetime = object DATETIME()
    !errors = ARRAY()
    !errors.append('')
    !errors.append('******************************************************************************************************')
    !errors.append('*** START of MDS Atta STEX upgrade ***')
    !errors.append('******************************************************************************************************')
    !errors.append('')
    !errors.append('------------------------------------------------------------------------------------------------------')
    !errors.append('------------------------------------------------------------------------------------------------------')
    !errors.append('-- PDMS Project - ' & !prjcode & ' --')
    !errors.append('-- Date & Time: ' & !datetime & ' --')
    !errors.append('')
    !errors.append('------------------------------------------------------------------------------------------------------')
    !errors.append('------------------------------------------------------------------------------------------------------')
    !errors.append('-- MDS ATTA STEX Upgrade to Include ORIENTATION of the relevant MDS ATTAS')
    !errors.append('-- ONLY MODIFY STEX of MDS ATTAS --')
    !errors.append(|-- where (purp of pspe of pipe eq 'PIPE' and atty eq '' and (not matchwild(name,'*/SREF')) |)
    !errors.append(|-- and (not matchwild(name of spref,'*/MDS/*REST*')) and (not matchwild(name of spref,'*/MDS/AC*')))|)
    !errors.append('-- ALL MDS Fixed and Variable Spring Hanger Attas are IGNORED in this PML Function')
    !errors.append('')
    !errors.append('------------------------------------------------------------------------------------------------------')
    !errors.append('------------------------------------------------------------------------------------------------------')
    !errors.append('-- START of ERRORS >>>> --')

-- Collect all Necessary MDS Support Atts to Set the ORI in the STEX of the ATTA for output on the ISOMETRIC DRAWING
    !ceorig = !!ce
    var !attas coll all atta where (purp of pspe of pipe eq 'PIPE' and atty eq '' and (not matchwild(name,'*/SREF')) and (not matchwild(name of spref,'*/MDS/*REST*')) and (not matchwild(name of spref,'*/MDS/AC*')))

-- Reset STEX on ALL collected MDS ATTAS to INCLUDE the ORIENTATION
    do !val values !attas
      !!ce   = !val.dbref()
      !name  = !!ce.name

-- Skip if MDS SPREF is a MDS HANGER element i.e. /MDS/FH* or /MDS/VH*
      skip if (!!ce.spref.name.matchwild('/MDS/FH*'))
      skip if (!!ce.spref.name.matchwild('/MDS/VH*'))

-- Get the P9 orientation of the Atta and ADD it to the STEX value for Output onto the ISOMETRIC Drawing
      !p9dir = !!ce.pdir[9].wrt(/* )
      handle any
        !ori = ''
      elsehandle none
        !ori = 'ORI = ' & !p9dir.string().before(' WRT')
      endhandle

------------------------------------------------------------------------
-- Set the ORI in the STEX for the REMAINDER of ATTAs
-- Check if passed name contains the transportation prefix
      if (!name.after('/').match(!!mdsoptions.tranpref).eq(1)) then
-- Add transportation text into atta STEX
        !aname = !name.after('/')
        STEX |$!aname
$!!mdsoptions.ptrantext.val
$!ori|
        handle any
          !errors.append('')
          !errors.append('------------------------------------------------------------------------------------------------------')
          !errors.append('ERROR: The STEX for Atta Name - ' & !!ce.name & ' - has NOT been UPDATED.')
          !errors.append('ERROR: ' & !!error.text)
        endhandle
      else
        if (!name.match('/').eq(1)) then
          !aname = !name.after('/').before('.')
          STEX |$!aname
$!ori|
          handle any
            !errors.append('')
            !errors.append('------------------------------------------------------------------------------------------------------')
            !errors.append('ERROR: The STEX for Atta Name - ' & !!ce.name & ' - has NOT been UPDATED.')
            !errors.append('ERROR: ' & !!error.text)
          endhandle
        else
          STEX |$!name
$!ori|
          handle any
            !errors.append('')
            !errors.append('------------------------------------------------------------------------------------------------------')
            !errors.append('ERROR: The STEX for Atta Name - ' & !!ce.name & ' - has NOT been UPDATED.')
            !errors.append('ERROR: ' & !!error.text)
          endhandle
        endif
      endif

    enddo

-- Write the ERRORS to an ERROR file in the %PDMSUSER% directory
    !errors.append('--   END of ERRORS <<<< --')
    !errors.append('------------------------------------------------------------------------------------------------------')
    !errors.append('------------------------------------------------------------------------------------------------------')
    !errors.append('')
    !errors.append('******************************************************************************************************')
    !errors.append('*** END of MDS Atta STEX upgrade ***')
    !errors.append('******************************************************************************************************')
    !errors.append('')
    !errorfile = object FILE('%PDMSUSER%/MDS-ATTA-STEX-UPG-ERRORS.file')
    !errorfile.writefile('APPEND',!errors)

-- Return to Original Element
    !!ce = !ceorig

-- Advise Users ATTA Upgrade is complete
    !!alert.message('The MDS Atta STEX Upgrade PML function mdsattastexupg() has finished. Before proceeding any further please CHECK for any ERRORS in the error file %PDMSUSER%/MDS-ATTA-STEX-UPG-ERRORS.file')

  endfunction
-- End of function mdsattastexupg.pmlfnc
