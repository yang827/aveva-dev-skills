--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsBestPline(!sctn is DBREF, !dir is DIRECTION, !pos is POSITION, !tolang is REAL) is STRING

  !key = STRING()
  !plnam = split('TOS BOS TOC BOC NAL NAR FOC IOC LEFT RIGH NAT NAB OBOW OTOW IBOW ITOW')

  !dist = ARRAY()
  do !c indices !plnam
    !pkey = !plnam[!c]
    !zdir = !sctn.plor.attribute(!pkey).zdir()
    handle ANY
      !plnam[!c].delete()
      skip
    endhandle
    if !zdir.angle(!dir).lt(180 - !tolang) then
      !plnam[!c].delete()
      skip
    endif
    !pline = !sctn.plst.attribute(!pkey).line(!sctn.plen.attribute(!pkey))
    !dist[!c] = !pos.distance(!pline)
  enddo
  !plnam.compress()
  !dist.compress()
  !newIndex = !dist.sortedIndices()
  !plnam.reindex(!newIndex)
  !dist.reindex(!newIndex)
  !key = !plnam.first()
  handle ANY
  endhandle

  return !key

endfunction
