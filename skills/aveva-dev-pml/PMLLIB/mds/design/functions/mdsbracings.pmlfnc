--
--
-- Description:
-- Multi Discipline support bracing function
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsbracings(!form is FORM)

   !brarray    = ARRAY()
   !!ce = !form.support.stru
   !struname   = !!ce.fullname
   var !y collect all sctn for ce
   do !x values !y
      !sctname = !x.dbref().fullname
      if (!sctname.match(!struname & '-BR') neq 0) then
         !sctn = !x.dbref()
         !brac = object MDSBRACING(!form,!sctn)
         !brarray.append(!brac)
      endif
   enddo

   !form.support.bracings = !brarray

-- End function
endfunction
