--
-- File:		mdscheckbadref.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--
-- Author:		D.Flannery
-- Created:		Mon 7th Aug
--
--
-- Description:
-- Check array and Ignore any elements with bad or unset catref.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          ARRAY      Array of strings to check
-- Return:
--    [Data Type]   [Description]
--     ARRAy        array without bad or unset refs
--------------------------------------------------------------------------------

  define function !!mdscheckbadref( !elements is array )is array

 !newarray = ARRAY()

   do !I values !elements
     !testforcatref = !i.dbref().catref
     handle ANY
       skip
     elsehandle NONE
       if !testforcatref.badref() then
         skip
       else
         !newarray.append(!i)
       endif
     endhandle
   enddo

   return !newarray

  endfunction
