--
-- File:        mdscheckfitting.pmlfnc
--   Type:      Function Definition
--   Group:     Multi Discipline Supports Application
--   Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:  T.martin
-- Created: 18/12/03
--
--
-- Description:
-- Multi Discipline support function for checking joints lie within wallplates
--
--------------------------------------------------------------------------------
define function !!mdscheckfitting(!form is FORM,!bracket is DBREF, !plate is DBREF)is BOOLEAN

    !bracketvol = !bracket.wvol
    !platevol = !plate.wvol
    if !form neq !!mdsfr03 then $* its a top or bottom plate
      if !bracketvol[1] lt !platevol[1] or !bracketvol[4] gt !platevol[4] then
          return FALSE
      elseif !bracketvol[2] lt !platevol[2] or !bracketvol[5] gt !platevol[5] then
          return FALSE
      else
          return TRUE
      endif
    else  $* its a wall plate
      ---use the p leave of the datum atta to decide which of the north south coordinates to use
      !ldir = ldir of $!form.support.datum
      !dir = !ldir.string().substring(1,1)
    if !dir eq 'E' or !dir eq 'W' OR !dir eq 'X' or !dir eq '-X' then
         if !bracketvol[1] lt !platevol[1] or !bracketvol[4] gt !platevol[4] then
            return FALSE
         elseif !bracketvol[3] lt !platevol[3] or !bracketvol[6] gt !platevol[6] then
            return FALSE
         else
            return TRUE
         endif
      else $* its north
         if !bracketvol[2] lt !platevol[2] or !bracketvol[5] gt !platevol[5] then
            return FALSE
         elseif !bracketvol[3] lt !platevol[3] or !bracketvol[6] gt !platevol[6] then
            return FALSE
         else
            return TRUE
         endif
    endif
  endif

endfunction
