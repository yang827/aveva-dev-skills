--------------------------------------------------------------------------------
-- File:  mdscheckinterface.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  R.martin
-- Created:  01/2012
--
--
-- Description:
-- function to check whether or not the mds manufacturers interfaces are set up correctly
-- this checks:- the input,output and dat folders
--               the .exe file path
--               whether or not the correct databases are loaded in the MDB
--               if the virtualFittings mechanism is enabled (via the /MDS/OPTION/DEFAULTS/MDSHANGVFITT, default in the catalogue app defaults) then the following are also checked
--               the folder location of the mdshangermacros evar (if it is set) where the hanger connection macros are stored
--               the existence of the new udas /MDS-Uda-MDSCIVREF, /MDS-Uda-MDSCIVREFPOSL and /MDS-Uda-MDSTREF
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        STRING        manufacturer name whose interface is currently in use ('LISEGA', 'PSL', 'CPL')
-- Return:
--    [Data Type]   [Description]
--     boolean       return false if there are errors in the current interface configuration
--------------------------------------------------------------------------------
define function !!mdscheckinterface(!manufacturer is STRING) is BOOLEAN

  !configErrors = 0

  !errorArray = object ARRAY()

  if !manufacturer.eq('LISEGA') then
    !interface = 'Licad'
    !evar = 'licadmdsexe'
    !databases = object ARRAY()
    !proj = 'LIS'
    !databases.append('LISEGA/LS_CATA')
    !databases.append('LISEGA/LS_DICT')
  elseif !manufacturer.eq('CPL') then
    !interface = 'Witchhanger'
    !evar = 'cplmdsexe'
    !databases = object ARRAY()
    !proj = 'CPL'
    !databases.append('CPLMDS/CPLCATA')
  else
    --else it's PSL
    !interface = 'PS Designer'
    !evar = 'pslmdsexe'
    !databases = object ARRAY()
    !proj = 'PSL'
    !databases.append('MDS/PSL2001')
  endif
  var !exe evar $!evar

  --get the file paths of the input and output files
  var !projCode proj code
  !lifString =  !projCode + 'LIF'
  !lofString =  !projCode + 'LOF'
  !datString =  !projCode + 'DAT'
  !hangMacrosString =  'MDShangerMacros'
  var !lifPath evar $!lifString
  var !lofPath evar $!lofString
  var !datPath evar $!datString
  var !hangMacrosPath evar $!hangMacrosString
  !hangMacrosPath = !hangMacrosPath
  !virtualFittingsUDAs = object ARRAY()
  !virtualFittingsUDAs.append(|/MDS-Uda-MDSCIVREF|)
  !virtualFittingsUDAs.append(|/MDS-Uda-MDSCIVREFPOSL|)
  !virtualFittingsUDAs.append(|/MDS-Uda-MDSTREF|)

  --first check the path to the current exe file
  !exefile = object FILE(!exe)
  if !exefile.exists().not() then
    !configErrors = !configErrors + 1
    !error1 = object ARRAY()
    !error1.append('Interface Executable Path')
    !errorString = !interface + ' Interface executable file cannot be found at ' + !exe + ' please ensure that path to the interface referenced by the ' + !evar + ' environment variable is correct'
    !error1.append(!errorString)
    !error1.append('A full install of the current manufacturers interface is required to proceed - please contact the manufacturer for details if you do not have access to this')
    !errorArray.append(!error1)
  endif

  --now check the current project lif lof and dat locations
  !liffile = object FILE(!lifPath)
  !error2 = object ARRAY()
  !error2[1] = 'Lif File Environment Variable'
  !error2[3] = 'The LIF folder is set with the <project>LIF evar (for example set MDSLIF = c:\Aveva\Projects\MDS\SupportInterface\LIF)'
  !lifExists = !liffile.exists()
  handle (160,46)
    !configErrors = !configErrors + 1
    !errorString = 'The ' + !lifString + ' environment variable has not yet been defined for the current project, please define the path to an empty folder that will contain input files'
    !error2[2] = !errorString
    !errorArray.append(!error2)
  elsehandle NONE
    if !lifExists.not() then
      !configErrors = !configErrors + 1
      !errorString = 'The folder ' + !lifPath + ' does not exist for the defined environment variable ' + !lifString
      !error2[2] = !errorString
      !errorArray.append(!error2)
    else
      --check for badly formatted file paths, pdms accepts strings such 'C:\AVEVA\Plant\MDS120~1.SP6\\project\MDS\interface\lif' but the interfaces do not
      if !lifPath.substring(1,2).eq('\\') then
        --we have a unc filepath and this needs to be omitted from the test
        !lifCheckPath = !lifPath.substring(3)
      else
        !lifCheckPath = !lifPath
      endif
      if !lifCheckPath.match(|\\|).gt(0) or !lifCheckPath.match(|//|).gt(0) or !lifCheckPath.match(|/\|).gt(0) or !lifCheckPath.match(|\/|).gt(0) then
        !configErrors = !configErrors + 1
        !errorString = 'The folder ' + !lifCheckPath + ' is not valid for the manufacturers interface, please remove any double slashes from the evar path ' + !lifString
        !error2[2] = !errorString
        !errorArray.append(!error2)
      endif
    endif
  endhandle

  !loffile = object FILE(!lofPath)
  !error3 = object ARRAY()
  !error3[1] = 'Lof File Environment Variable'
  !error3[3] = 'The LOF folder is set with the <project>LOF evar (for example set MDSLOF = c:\Aveva\Projects\MDS\SupportInterface\LOF)'
  !lofExists = !loffile.exists()
  handle (160,46)
    !configErrors = !configErrors + 1
    !errorString = 'The ' + !lofString + ' environment variable has not yet been defined for the current project, please define the path to an empty folder that will contain output files'
    !error3[2] = !errorString
    !errorArray.append(!error3)
  elsehandle NONE
    if !lofExists.not() then
      !configErrors = !configErrors + 1
      !errorString = 'The folder ' + !lofPath + ' does not exist for the defined environment variable ' + !lofString
      !error3[2] = !errorString
      !errorArray.append(!error3)
    else
      --check for badly formatted file paths, pdms accepts strings such 'C:\AVEVA\Plant\MDS120~1.SP6\\project\MDS\interface\lif' but the interfaces do not
      if !lofPath.substring(1,2).eq('\\') then
        --we have a unc filepath and this needs to be ommitted from the test
        !lofCheckPath = !lofPath.substring(3)
      else
        !lofCheckPath = !lofPath
      endif
      if !lofCheckPath.match(|\\|).gt(0) or !lofCheckPath.match(|//|).gt(0) or !lofCheckPath.match(|/\|).gt(0) or !lofCheckPath.match(|\/|).gt(0) then
        !configErrors = !configErrors + 1
        !errorString = 'The folder ' + !lofCheckPath + ' is not valid for the manufacturers interface, please remove any double slashes from the evar path ' + !lofString
        !error3[2] = !errorString
        !errorArray.append(!error3)
      endif
    endif
  endhandle

  !datfile = object FILE(!datPath)
  !error4 = object ARRAY()
  !error4[1] = 'Dat File Environment Variable'
  !error4[3] = 'The DAT folder is set with the <project>DAT evar (for example set MDSDAT = c:\Aveva\Projects\MDS\SupportInterface\DAT)'
  !datExists = !datfile.exists()
  handle (160,46)
    !configErrors = !configErrors + 1
    !errorString = 'The ' + !datString + ' environment variable has not yet been defined for the current project, please define the path to an empty folder that will contain data files'
    !error4[2] = !errorString
    !errorArray.append(!error4)
  elsehandle NONE
    if !datExists.not() then
      !configErrors = !configErrors + 1
      !errorString = 'The folder ' + !datPath + ' does not exist for the defined environment variable ' + !datString
      !error4[2] = !errorString
      !errorArray.append(!error4)
    else
      --check for badly formatted file paths, pdms accepts strings such 'C:\AVEVA\Plant\MDS120~1.SP6\\project\MDS\interface\lif' but the interfaces do not
      if !datPath.substring(1,2).eq('\\') then
        --we have a unc filepath and this needs to be ommitted from the test
        !datCheckPath = !datPath.substring(3)
      else
        !datCheckPath = !datPath
      endif
      if !datCheckPath.match(|\\|).gt(0) or !datCheckPath.match(|//|).gt(0) or !datCheckPath.match(|/\|).gt(0) or !datCheckPath.match(|\/|).gt(0) then
        !configErrors = !configErrors + 1
        !errorString = 'The folder ' + !datCheckPath + ' is not valid for the manufacturers interface, please remove any double slashes from the evar path ' + !datString
        !error4[2] = !errorString
        !errorArray.append(!error4)
      endif
    endif
  endhandle

  --now check that the prerequisite interface databases are present in the current MDB
  !categoryString = 'Interface Reference Projects'
  !setupNote = 'Manufacturers project databases are needed to build specified hanger components in MDS'
  !current = !!ce
  !session = CURRENT SESSION
  !currentDbs = !session.current()
  !deferredDbs = !session.deferred()
  do !i from 1 to !databases.size()

    !currentDB = FALSE
    do !j from 1 to !currentDbs.size()
      !checkName = !databases[!i]
      !currentDBName = !currentDbs[!j].name
      if !currentDBName.eq(!checkName) then
        !currentDB = TRUE
        break
      endif
    enddo

    !deferredDB = FALSE
    if !currentDB.not() then
      do !j from 1 to !deferredDbs.size()
        !checkName = !databases[!i]
        !deferredDBName = !deferredDbs[!j].name
        if !deferredDBName.eq(!checkName) then
          !deferredDB = TRUE
          break
        endif
      enddo
    endif

    if !currentDB.not() and !deferredDB.not() then
      --the database is not present in this MDB
      !configErrors = !configErrors + 1
      !error = object ARRAY()
      !error.append(!categoryString)
      !error.append('$!proj Project Database ' + !databases[!i] + ' is not present in the current MDB')
      !error.append(!setupNote)
      !errorArray.append(!error)
    elseif !deferredDB then
      !configErrors = !configErrors + 1
      !error = object ARRAY()
      !error.append(!categoryString)
      !error.append('$!proj Project Database ' + !databases[!i] + ' is deferred in the current MDB')
      !error.append(!setupNote)
      !errorArray.append(!error)
    endif
  enddo
  !!ce = !current

  --now check that the prerequisite virtual fitting UDA's are present in the MAS project
  !current = !!ce
  !udaErrors = object ARRAY()
  do !i from 1 to !virtualFittingsUDAs.size()
    --navigate to virtualFittingsUDAs[!i]
    $!virtualFittingsUDAs[$!i]
    handle (2,109)
      !udaErrors.append(!virtualFittingsUDAs[!i])
    endhandle
  enddo
  !!ce = !current

  !categoryString = 'MAS project UDAs'
  !setupNote = 'The highlighted UDAs are required at this release - if they are missing, please run the MAS-UDA-UPDATE.mac update from the MDS pdmsdata directory'
  do !i from 1 to !udaErrors.size()
    !configErrors = !configErrors + 1
    !errorString = |the $!udaErrors[$!i] UDA is missing from the MAS project|
    !error = object ARRAY()
    !error.append(!categoryString)
    !error.append(!errorString)
    !error.append(!setupNote)
    !errorArray.append(!error)
  enddo
  !!ce = !current

  --we now need to check virtual fitting settings but only if the !!mdshangvfitt setting is set to 'ENABLED'
  !unusedTestmdshangvfitt = !!mdshangvfitt
  handle (2,751)
    --if mdshangvfitt does not exist then default it to 'DISABLED', the most likely cause of this is a missing default /MDS/OPTION/DEFAULTS/MDSHANGVFITT
    --in the mdsappdefaults catalogue
    !!mdshangvfitt = 'DISABLED'
  endhandle

  if !!mdshangvfitt.eq('ENABLED') then
    --now check for missing virtual fitting hangermacros directory
    !categoryString = 'Virtual Fittings Connection Macros'
    !setupNote = 'A single project wide storage folder is required to write hanger connection macros (where write access is not available for supporting steelwork)'
    !hangMacrosfile = object FILE(!hangMacrosPath)
    !hangMacrosFileExists = !hangMacrosfile.exists()
    handle (160,46)
      !configErrors = !configErrors + 1
      !errorString = 'The ' + !hangMacrosString + ' environment variable has not yet been defined for the current project, please define the path to an empty folder that will contain hanger connection macros'
      !error = object ARRAY()
      !error.append(!categoryString)
      !error.append(!errorString)
      !error.append(!setupNote)
      !errorArray.append(!error)
    elsehandle NONE
      if !hangMacrosFileExists.not() then
        !configErrors = !configErrors + 1
        !errorString = 'The folder ' + !hangMacrosPath + ' does not exist for the defined environment variable ' + !hangMacrosString
        !error = object ARRAY()
        !error.append(!categoryString)
        !error.append(!errorString)
        !error.append(!setupNote)
        !errorArray.append(!error)
      else
        --check for badly formatted file paths, pdms accepts strings such 'C:\AVEVA\Plant\MDS120~1.SP6\\project\MDS\interface\lif' but the interfaces do not
        if !hangMacrosPath.substring(1,2).eq('\\') then
          --we have a unc filepath and this needs to be ommitted from the test
          !hangMacrosCheckPath = !hangMacrosPath.substring(3)
        else
          !hangMacrosCheckPath = !hangMacrosPath
        endif
        if !hangMacrosCheckPath.match(|\\|).gt(0) or !hangMacrosCheckPath.match(|//|).gt(0) or !hangMacrosCheckPath.match(|/\|).gt(0) or !hangMacrosCheckPath.match(|\/|).gt(0) then
          !configErrors = !configErrors + 1
          !errorString = 'The folder ' + !hangMacrosCheckPath + ' is not valid for the manufacturers interface, please remove any double slashes from the evar path ' + !hangMacrosString
          !error = object ARRAY()
          !error.append(!categoryString)
          !error.append(!errorString)
          !error.append(!setupNote)
          !errorArray.append(!error)
        endif
      endif
    endhandle
  endif

  --START <CP 15/11/2012> If the uda MDSTREF exists check to make sure the UDA Length is correct and not too small

  !mdstrefExists = TRUE
  $!virtualFittingsUDAs[3]
  handle (2,109)
    !mdstrefExists = FALSE
  endhandle

  if !mdstrefExists then
    var !coll COLLECT ALL UDA with udname eq 'MDSTREF'
    !mdstref = object DBREF(!coll[1])
    if !mdstref.badRef() eq FALSE then
      if !mdstref.uLength neq 100 then
        !configErrors = !configErrors + 1
        !categoryString = 'UDA :MDSTREF, UDA Length Correction'
        !setupNote = 'A correction to the maximum UDA length of :MDSTREF is required - please run the update macro called MAS-UDA-UPDATE.mac, found in the pdmsdata folder in the install directory'
        !errorString = 'The UDA, :MDSTREF has an incorrect UDA Length. The maximum length should be set to 100 - please run the update macro called MAS-UDA-UPDATE.mac, found in the pdmsdata folder in the install directory'
        !error = object ARRAY()
        !error.append(!categoryString)
        !error.append(!errorString)
        !error.append(!setupNote)
        !errorArray.append(!error)
      endif
    endif
  endif

  !!ce = !current
  --START <CP 15/11/2012> If the uda MDSTREF exists check to make sure the UDA Length is correct and not too small

  if !configErrors.eq(0) then
    return TRUE
  else
    show !!mdscheckinterface
    !!mdscheckinterface.initmessages(!interface, !errorArray)
    return FALSE
  endif

endfunction
