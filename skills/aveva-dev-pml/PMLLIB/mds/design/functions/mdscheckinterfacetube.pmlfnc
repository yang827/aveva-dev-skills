--      Keyword:
--    Module:        design
--  Author:          richard martin
--  Created:         Wed Jun  5 16:07:50 2013

--
--  Description:     performs validation on supplied tube references for mds interface hangers
--                   if all is well TRUE is returned otherwise alert messages will be displayed and errors returned
--
----------------------------------------------------------------------
define function !!mdscheckinterfacetube(!tubeRef is DBREF, !hangerType is REAL) is BOOLEAN

  !!ce = !tubeRef

  if (!hangerType.eq(6) or !hangerType.eq(600)) then
    -- Check the Identified TUBE is NOT a MDS TRUNNION BRANC which is NOT HORIZONTAL, i.e. VERTICAL
    if (!tubeRef.type.eq('BRAN')) then
      !leaveDirection = !!ce.hdir.wrt(/* )
      !owningBranch = !tubeRef
    else
      -- Branch Component Selected
      !leaveDirection = !!ce.ldir.wrt(/* )
      !owningBranch = !tubeRef.owner
    endif

    !leaveDirectionUp = !leaveDirection.up
    if (!owningBranch.:MDSTRUN) then
      if ((!leaveDirectionUp.between(-1, -0.2)) or (!leaveDirectionUp.between(0.2, 1))) then
        --P-37906 allow pedestal support creation on a vertical trunnion base for witchhanger only - start
        if !!mdsHangIf.eq('CPL') then
          --do nothing
        else
          prompt on
          return error 1 'A NON-Horizontal MDS Trunnion Branch may NOT be supported from a PEDESTAL type support'
          --P-37906 allow pedestal support creation on a vertical trunnion base for witchhanger only - end
        endif
      endif
    else
      -- A REAL PDMS PIPE has been identified and NOT a MDS TRUNNION Branch
      if ((!leaveDirectionUp.between(-1, -0.2)) or (!leaveDirectionUp.between(0.2, 1))) then
        prompt on
        return error 1 'A NON-Horizontal Pipe Branch may NOT be supported from a PEDESTAL type support'
      endif
    endif
  endif
  -- When a Support Type 6 or 600 has been selected Check if a MDS Trunnion branch etc... has been Identified
  --<<wd>17nov2009 - DFN-P25277 (SI-17086)

  -- Check to see if we can write to the branch and it is not claimed out
  -- Although we create an atta and this is allowed because its a significant element
  -- we reorder the ATTAS in the line and also create lugs so we need access to the branch

  !!mdsDacControl(TRUE)
  new olet
  handle NONE
    delete olet
  elsehandle (41,8)
  elsehandle ANY
    prompt on
    !!mdsDacControl(FALSE)
    !!alert.error('$!!error.text')
    return error 1 '$!!error.text'
  endhandle
  !!mdsDacControl(FALSE)
  !!ce = !tubeRef

  -- if the filter type is 1 2 and 7 and we are FANP and LISEGA then block the vertical pipes
  if  (!!mdsHangIf.upcase().eq('LISEGA')) then
    !tempDesc = (desc of /MDS/TEMPLATES )
    if !tempDesc.upcase().eq('FRAMATOME TEMPLATES') then
      if !hangerType.eq(1) or !hangerType.eq(2) or !hangerType.eq(18) then
        !ldir = !!ce.ldir
        handle ANY
          !ldir = !!ce.hdir
        endhandle
        if !ldir.up.eq(1) or !ldir.up.eq(-1) then
          !!alert.message('Cannot identify a vertical pipe in this configuration - Hanger Creation Aborted')
          return error 1 'Cannot identify a vertical pipe in this configuration'
        endif
      endif
    endif
  elseif  (!!mdsHangIf.upcase().eq('PSL')) then
    !tempDesc = (desc of /MDS/TEMPLATES )
    if !tempDesc.upcase().eq('FRAMATOME TEMPLATES') then
      if !hangerType.eq(1) or !hangerType.eq(2) or !hangerType.eq(18) then
        !ldir = !!ce.ldir
        handle ANY
          !ldir = !!ce.hdir
        endhandle
        if !ldir.up.eq(1) or !ldir.up.eq(-1) then
          !!alert.message('Cannot identify a vertical pipe in this configuration - Hanger Creation Aborted')
          return error 1 'Cannot identify a vertical pipe in this configuration'
        endif
      endif
    endif
  elseif  (!!mdsHangIf.upcase().eq('CPL')) then
    !tempDesc = (desc of /MDS/TEMPLATES )
    if !tempDesc.upcase().eq('FRAMATOME TEMPLATES') then
      if !hangerType.eq(1) or !hangerType.eq(2) or !hangerType.eq(18) then
        !ldir = !!ce.ldir
        handle ANY
          !ldir = !!ce.hdir
        endhandle
        if !ldir.up.eq(1) or !ldir.up.eq(-1) then
          !!alert.message('Cannot identify a vertical pipe in this configuration - Hanger Creation Aborted')
          return error 1 'Cannot identify a vertical pipe in this configuration'
        endif
      endif
    endif
  endif

  if(!tubeRef.owner.type.eq('BRAN') or !tubeRef.type.eq('BRAN')) then
    --do nothing
  else
    -- this is not a pipe component
    -- re-identify
    !!alert.error('The selected item is not a piping branch, please reselect a valid branch')
    return error 2
  endif
  -- If using the LISEGA interface then the minimum temperature is -20, check and about

  if  (!!mdsHangIf.upcase().eq('LISEGA')) then
    branch
    handle NONE
      !temp = !!ce.temp
      if !temp.lt(-20) then
        !!alert.message('Temperature of branch is less than the acceptable minimum of -20 for LICAD')
        same
        return error 2
      endif
    elsehandle ANY
    endhandle
  elseif  (!!mdsHangIf.upcase().eq('PSL')) then
    branch
    handle NONE
      !temp = !!ce.temp
      if !temp.lt(-20) then
        !!alert.message('Temperature of branch is less than the acceptable minimum of -20 for PSL')
        same
        return error 2
      endif
    elsehandle ANY
    endhandle
  elseif  (!!mdsHangIf.upcase().eq('CPL')) then
    branch
    handle NONE
      !temp = !!ce.temp
      if !temp.lt(-20) then
        !!alert.message('Temperature of branch is less than the acceptable minimum of -20 for C&P')
        same
        return error 2
      endif
    elsehandle ANY
    endhandle
  endif

  --if we get here then the branch is valid
  return TRUE

endfunction
