-- File:    mdscheckld09.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   mds
--   Module:    design
--   Replaces:
--
-- Author:    R.Martin
-- Created:   Tue Mar 17 2009
--
--
-- Description:
-- this function has been primarily written to deal with a bug in licad for Areva in which the posline of the fitting on the supporting steelwork was different
-- to that expected by MDS, this is therefore provided to ensure that user modification of the supporting steelwork does not impact on the steelwork fitting configuration.
-- it is envisaged that this function could be expanded at a later date to deal with other potential model related modification issues.
-- this function only works in modify mode of the mdsifh01 function.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         DBREF       DBREF of the current hangers atta reference
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

define function !!mdsCheckLD09(!attaRef is DBREF)

  -- return if we are attached to a panel
  !type = !attaRef.cref.tref.owner.type.neq('SCTN')
  handle any
    return
  endhandle

  -- return if we don't have a sctn
  if !type then
    return
  endif

  -- get the posline of the steelwork fitting associated with the hanger
  !fitt = !attaRef.cref.tref
  !fittPosl = !fitt.posline

  -- get the sclamp reference of the hanger
  !!ce = !attaRef.cref
  scla 1
  !sclamp = !!ce

  -- get the direction between parrive and pleave of the hanger sclamp and also the position of parrive of the sclamp
  !sclampParrivePos = !sclamp.pposition[1].wrt( /* )
  !sclampPleavePos = !sclamp.pposition[2].wrt( /* )

  !sclampDir = !sclampParrivePos.direction(!sclampPleavePos)

  -- do kclosest pline from parrive of the sclamp to the sctn in the direction defined above
  !closestPline = !!kClosestPline(!fitt.owner,!sclampParrivePos,!sclampDir)

  -- We only need the pline that can be connected to, these are
  -- TOS, BOS, TOC, BOC, LEFT, RIGH
  do !getPlineNumber from 1 to !closestPline.size() by 2
    if !closestPline[$!getPlineNumber].pkey inset ('TOS','BOS','TOC','BOC','LEFT','RIGH','OBOW','OTOW','IBOW','ITOW') then
      !plineNumber = !getPlineNumber
      break
    endif
  enddo
  !plineName = pkey of $!closestPline[$!plineNumber]

  -- if the pline obtained above is different to the existing posline then reset the existing posline to the new value as it would seem that the support steel has ben moved.
  if !plineName.neq(!fittPosl) then
    !fitt.posline = !plineName
  endif

endfunction
