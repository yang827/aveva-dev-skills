--
-- File:  mdscheckpbores.pmlfnc
--   Type:  Form
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  Design
--   Replaces:
--
-- Author:  Neale Morris
-- Created:  Wednesday 9th October 2002
--
--
-- Description:
-- Function to Check if the Selected Pipe Size is Allowed on the
-- Support Currently being Created or Modified by the MDS Application.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        FORM       Form Object where the MDS Support is being Selected from.
--     2      R        DBREF      Identified Pipe Component
--     3      R        STRING     Error Message
--     4      R        STRING     Current Project Units
--
-- Return:
--    [Data Type]   [Description]
--      BOOLEAN      Returns TRUE if the Identified Pipe Bore EXCEEDS the Allowable
--                   Minimum or Maximum Nominal Pipe Size (NPS)
--                   on the CURRENT MDS Steelwork Template
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--
--Define Function
define function !!mdscheckpbores(!form is FORM, !pipecomp is DBREF, !error is STRING,!currentUnits is COMUNITS) is BOOLEAN

  -- Initialise Variables
  !alias       = !form.support.alias.upcase()
  if !form.name().eq('MDSFT24') then
  	!!ce = object DBREF('STRU ' & !!mdssetsteel.size.val & ' of /MDS/FRAMES/FT24')
  else
    !selection   = !!mdssetsteel.size.selection('rtext')
    !mdstemplate = '/MDS/$!alias/$!selection'
    !altmdstemplate = '/MDS/$!alias$nH/$!selection'

    -- Navigate to the MDS Template Structure
    !!ce         = !mdstemplate.dbref()
    handle any
      !!ce = !altmdstemplate.dbref()
    endhandle
  endif

  !maxbore     = !!ce.:mdsmaxbore
  !minbore     = !!ce.:mdsminbore
  !range       = !!ce.:mdsrange
  !stru        = !form.support.stru

  -- Navigate to Identified Pipe Component
  !!ce = !pipecomp
  !pclbor = !!ce.lbor
  handle (2,201) $* At Branch head
    !pclbor = !!ce.hbor
  endhandle

  --<wd>nov2003>>>
  ----------------------------------------------------------------------------
  -- Do we need to use the :MDSRANGE or the :MINBORE and :MAXBORE uda settings
  ----------------------------------------------------------------------------
  if !range.neq('unset') then
    ---------------------------------------------------------------------------------------------------------
    -- Check Support Atta Bore Sizes and/or STRUCTURAL Template MIN/MAX - Dimensions using the UDA :MSDSRANGE
    ---------------------------------------------------------------------------------------------------------
    -- START Checking the :MDSRANGE values of the Selected MDS Template
    -- Format should be "dimension number,from value,to value,max bore" and EACH Range delimited by a backslash
    -- i.e. :MDSRANGE = 1,0,1830,80\1,0,610,250\(3/4),0,900,250

    -- Find largest bore on support
    !lBore = ARRAY()
    !lBore.append(!pclbor.real())
    !largestbore = !lBore[1]
    !ranges = !range.split(|\|)

    -- Get the Bores from the :MDSRANGE
    !bores = ARRAY()
    do !a values !ranges
      !bores.append(!a.split(',')[4].real())
    enddo
    -- Organise the !ranges array so that the <DIMENSION>a nd <BORE> values are in Ascending Order
    !index = !bores.sortedindices()
    !ranges.reindex(!index)

    -- Sort !bores array so that the LARGEST size is the LAST index in the array
    -- Get the Maximum Pipe Bore Size allowed on the Selected MDS template from the LAST iteration of the array !bores
    !bores.sort()
    !templatemaxb = !bores.last()


    ----------------------------------------------------------------------------------
    -- FIRST Check that the MAXIMUM Bore is NOT EXCEEDED for the Selected MDS Template
    ----------------------------------------------------------------------------------
    if (!largestbore.gt(!templatemaxb)) then
      !metmaxbor = !templatemaxb.bore()
      if !currentUnits.isimperialsavedbore() then
        INCH BORE
        !!ce   = !pipecomp
        !pclbor = !!ce.lbor
        handle (2,201) $* At Branch head
          !pclbor = !!ce.hbor
        endhandle
        !impmaxbor  = !metmaxbor
        --<wd>nov2003
        !error ='The Identified Pipe Bore Size of $!<pclbor> EXCEEDS the Maximum allowed Pipe Bore Size of $!<impmaxbor> for the currently selected MDS Template.
        ** ABORTING **  the "Add Pipe" option.'
        --<wd>nov2003
        -- Return Bore Units to MM
        MM BORE

      else
        --<wd>nov2003
        !error ='The Identified Pipe Bore Size of $!<pclbor> EXCEEDS the Maximum allowed Pipe Bore Size of $!<metmaxbor> for the currently selected MDS Template.
        ** ABORTING ** the "Add Pipe" option.'
        --<wd>nov2003
      endif
      !!ce = !stru
      return true
    endif
    --<wd>nov2003<<<

  else
    -- Check Minimum & Maximum Bore Settings of the current MDS Structural/Framework Template
    if (!pclbor.real().lt(!minbore)) then
      -- Check Minimum Bore
      !metminbore = !minbore.bore()
      if !currentUnits.isimperialsavedbore() then
        INCH BORE
        !!ce   = !pipecomp
        !pclbor = !!ce.lbor
        handle (2,201) $* At Branch head
          !pclbor = !!ce.hbor
        endhandle
        !impminbor = !metminbore
        --<wd>nov2003
        !error ='The Identified Pipe Bore Size of $!<pclbor> EXCEEDS the Maximum allowed Pipe Bore Size of $!<impminbor> for the currently selected MDS Template.
        ** ABORTING **  the "Add Pipe" option.'
        --<wd>nov2003
        MM BORE
      else
        !!ce   = !pipecomp
        !pclbor = !!ce.lbor
        handle (2,201) $* At Branch head
          !pclbor = !!ce.hbor
        endhandle
        --<wd>nov2003
        !error ='The Identified Pipe Bore Size of $!<pclbor> EXCEEDS the Maximum allowed Pipe Bore Size of $!<metminbore> for the currently selected MDS Template.
        ** ABORTING **  the "Add Pipe" option.'
        --<wd>nov2003
      endif
      return true
    elseif (!pclbor.real().gt(!maxbore)) then
      -- Check Maximum Bore
      !metmaxbor = !maxbore.bore()
      if !currentUnits.isimperialsavedbore() then
        INCH BORE
        !!ce   = !pipecomp
        !pclbor = !!ce.lbor
        handle (2,201) $* At Branch head
          !pclbor = !!ce.hbor
        endhandle
        !impmaxbor = !metmaxbor
        --<wd>nov2003
        !error ='The Identified Pipe Bore Size of $!<pclbor> EXCEEDS the Maximum allowed Pipe Bore Size of $!<impmaxbor> for the currently selected MDS Template.
        ** ABORTING **  the "Add Pipe" option.'
        --<wd>nov2003
        MM BORE
      else
        !!ce   = !pipecomp
        !pclbor = !!ce.lbor
        handle (2,201) $* At Branch head
          !pclbor = !!ce.hbor
        endhandle
        !error ='The Identified Pipe Bore Size of $!<pclbor> EXCEEDS the Maximum allowed Pipe Bore Size of $!<metmaxbor> for the currently selected MDS Template.
        ** ABORTING **  the "Add Pipe" option.'
      endif
      return true
    endif
  endif

  -- Return False if Identified Pipe NPS is within limits of MDS Steelwork template
  return false

endfunction
-- End of Function Definition for mdscheckpbores.pmlfnc
