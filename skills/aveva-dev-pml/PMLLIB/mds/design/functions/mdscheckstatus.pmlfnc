--
-- File:		mdscheckstatus.pmlfnc
--   Type:		Form
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Monday 18th March 2002
--
--
-- Description:
--  Function to Check if the Selected Support is Currently being Created or
--  Modified by the MDS Application.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        FORM       Form Object where the MDS Support is being Selected from.
--     2      R        STRING     Name of the Selected MDS Support
--     3      R        STRING     Error String returned by Association from calling function.
--
-- Return:
--    [Data Type]   [Description]
--      BOOLEAN      Returns TRUE if MDS Application is Currently Active on the Selected Support
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--
--Define Function
  define function !!mdscheckstatus(!form is form, !suppname is string, !error is string) is boolean

-- Check and Reject Selected Support If the Element Belongs to a
-- MDS Support CURRENTLY in the process of Creation or Modification
-- Form value
    --q var !suppname

-- Get forms
    !foundforms = !!fmsys.shownforms()
    !filter     = '*MDS*'

-- Get all MDS forms ONLY
    !forms = array()
    do !i indices !foundforms
      skip if(!foundforms[!i].name().matchwild(!filter).not())
      !forms.append(!foundforms[!i])
    enddo

   !break = false

-- Get the MDS Forms
    if !forms.size().gt(1) then
      do !i indices !forms
        !test = !forms[!i].name.val
          handle any
            !break = false
            skip
          elsehandle none
            if (!suppname.match(!forms[!i].name.val).lt(1)) then
              !break = false
              skip
            elseif !forms[!i] ne !form then
              !error = 'The Selected Support  belongs to the MDS Support ''$!suppname'' currently being Created/Modified by the MDS application. Therefore MDS will NOT allow ANY Item on this Support to be MODIFIED by other MDS application options.'
              if (defined(!form.name)) then
                !form.name.val = 'unset'
              endif
              !break = true
              break
            endif
          endhandle
      enddo
    endif

    if (!break) then
      return true
    else
      return false
    endif

  endfunction
-- End of Function Definition for mdscheckstatus.pmlfnc
