-- Created:		Tuesday 27th November 2001
--
--
-- Description:
-- Function to check if selected ATTA belongs to the current framework
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Framework support form.
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!mdschecksupp(!form is form, !atta is dbref) is boolean

-- Initialise variables
    !attas = !form.support.atta

-- Check current ATTA against existing supported object
    !check = !attas.findfirst(!atta)
    if (!check.set())then
      return true
    else
      return false
    endif

-- End function
 endfunction

--------------------------------------------------------------------------------
-- End of file mdschecksupp.pmlfnc
