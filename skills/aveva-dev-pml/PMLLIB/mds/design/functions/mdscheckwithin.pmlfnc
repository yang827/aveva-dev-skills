--
-- File:		mdscheckwithin.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Sat 13 July 2002
--
--
-- Description:
-- Checks to see if the new position is within the elements lstu and prev comps lstu
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        Position      New Position
--     2     R        Direction     Move Direction
--     3     R        Boolean       Is the Move Direction Forwards (TRUE) or Backwards (FALSE)
--
-- Return:
--    [Data Type]   [Description]
--
-----------------------------------------e---------------------------------------

-- Define Function
define function !!MdsCheckWithin(!NewPos is POSITION, !movedir is DIRECTION, !oppdirb is BOOLEAN) is BOOLEAN

-- Initialise Variables
  !SaveCe   = !!CE

-- Get the Current ATTA or Element Name <TEE etc...>
  if (!!ce.type.eq('ATTA')) then
    !suppname = !!ce.name.before('/DATUM')
    handle any
      !suppname = !!ce.name
    endhandle
  else
    !suppname = !!ce.name
  endif

-- If the atta belongs to HVAC or Cable tray do not check

  if !!ce.styp.eq('HVAC-REST') or !!ce.styp.eq('RACK-REST') or !!ce.styp.match('CA').eq(1) then
    return true
  endif

-- get the reference item :MdsGuireRef

  !GuideRef = !!ce.:mdsguideref
    handle any
      !Guideref = object dbref()
    endhandle

---------------------------------------------------------------------------------
-- If the PREV or NEXT elements belong to the Current/Same MDS Support IGNORE
-- any ATTA with the SAME NAME as the DATUM Atta on the DATUM ATTA Pipe.
-- e.g. /SUPPNAME/DATUM, /SUPPNAME/SREF or /SUPPNAME.x etc...
---------------------------------------------------------------------------------
-- Any MDS Ancillary ATTA with the SAME NAME Prefix and on the SAME PIPE MUST be IGNORED as the PREVIOUS Component
-- Previous component leave position

--    prev
--    handle none
--      !PrevLeaPos = pl pos wrt /*
--    elsehandle any
-- No Previous Element, so go to the Pipe Branch Head
--      !PrevLeaPos = ph pos wrt /*
--    endhandle

-- Check the Previous Component and SKIP if it is ON the Same MDS Support or a comment atta
    do !indx
      !!ce = !savece
      prev $!indx
      handle none
        if (!!ce.name.match(!suppname).gt(0)) then
          skip
        elseif (!!ce.eq(!Guideref)) then
          skip
        else
          if !!ce.type.eq('ATTA') then
            if !!ce.atty.empty().not() then
              skip
            endif
          endif
          !prevleapos = pl pos wrt /*
          handle none
            break
          elsehandle any
-- No INDEPENDENT Previous Element, so go to the Pipe Branch Head
            !prevleapos = ph pos wrt /*
            break
          endhandle
        endif
      elsehandle any
-- No Previous Element, so go to the Pipe Branch Head
        !prevleapos = ph pos wrt /*
        break
      endhandle
    enddo

  !!CE = !SaveCe

-- get the reference item :MdsGuireRef

  !GuideRef = !!ce.:mdsguideref
    handle any
      !Guideref = object dbref()
    endhandle

---------------------------------------------------------------------------------
-- Any MDS Ancillary ATTA with the SAME NAME Prefix and on the SAME PIPE MUST be IGNORED as the NEXT Component
-- Next component arrive position

--    next
--    handle none
--      !NextArrPos = pa pos wrt /*
--    elsehandle any
-- No Next Element, so go to Pipe Branch Tail
--      !NextArrPos = pt pos wrt /*
--    endhandle

-- Check the Next Component and SKIP if it is ON the Same MDS Support or a comment atta
    do !indx
      !!ce = !savece
      next $!indx
      handle none
        if (!!ce.name.match(!suppname).gt(0)) then
          skip
        elseif (!!ce.eq(!Guideref)) then
          skip
        else
          if !!ce.type.eq('ATTA') then
            if !!ce.atty.empty().not() then
              skip
            endif
          endif
          !nextarrpos = pa pos wrt /*
          handle none
            break
          elsehandle any
-- No INDEPENDENT Next Element, so go to the Pipe Branch Tail
            !nextarrpos = pt pos wrt /*
            break
          endhandle
        endif
      elsehandle any
-- No Next Element, so go to the Pipe Branch Tail
        !nextarrpos = pt pos wrt /*
        break
      endhandle
    enddo
---------------------------------------------------------------------------------
-- We now have the three positions, find the distance between the start and end of the tube
-- Then find the distance from the start to the new position and the end to the new position
-- If the distance is greater than the start end distance then it lies outside the available
-- tube

  !!CE = !SaveCe

------------------------------------------------------------------------------------------
-->>>-<wd>oct2002

-- Set Units
  !currentunits = !!kgetsetunits()

-- Current Component Position and Existing Tube Lengths to Previous(or Pipe Head) and Next(or Pipe Tail) Components
  !existpos  = !!ce.pos.wrt(/* )
  !prevtulen = !!kstrreal('cons dist $!existpos to $!prevleapos')
  !nexttulen = !!kstrreal('cons dist $!existpos to $!nextarrpos')

--  var !StartEndDist const dist $!PrevLeaPos to $!NextArrPos
--  var !StartToNewPos const dist $!PrevLeaPos to $!NewPos
--  var !EndToNewPos const dist $!NextArrPos to $!NewPos
-- Convert  Variables to REAL type values
  !StartEndDist  = !!kstrreal('const dist $!PrevLeaPos to $!NextArrPos')
  !StartToNewPos = !!kstrreal('const dist $!PrevLeaPos to $!NewPos')
  !EndToNewPos   = !!kstrreal('const dist $!NextArrPos to $!NewPos')

-- Construct New Position Tubelength Required
  if (!oppdirb) then
-- Move Backwards of Previous VALID Component
    !expostonewpos = !!kstrreal('const dist $!existpos to $!prevleapos')
  else
-- Move Forwards of Previous VALID Component
    !expostonewpos = !!kstrreal('const dist $!existpos to $!nextarrpos')
  endif

-- Check if the MOVE Direction is Forwards or Backwards
-- with Regard to the Pleave Direction of the Valid PREVIOUS Component
  if (!oppdirb) then
-- Move Direction is Backwards
    !movetest = (!prevtulen.leq(!expostonewpos))
    --!movetest = (!expostonewpos.leq(!prevtulen))
  else
-- Move Direction is Forwards
    !cetopin10dist = !!kstrreal('cons dist p0 to plane pin 10')
    !movetest = (!starttonewpos.leq(!startenddist).not())
    --!movetest = (!cetopin10dist.leq(!prevtulen).not())
  endif

-- Check if MDS Support is to be Moved or NOT
--  if !StartEndDist.real().lt(!StartToNewPos.real() + !EndToNewPos.real()) then
--  if ( (!StartToNewPos.lt(!startenddist()).not()) ) then

   if  (!!MdsHangIf.upcase().neq('LISEGA')) then
    handle ANY
    endhandle
-- When using the LISEGA interface the atta needs to be positioned
-- outside the tube for Weld-on lugs for pipe elbows and also need
-- to make the atta to be Spkbrk FALSE

     if (!movetest) then
-- Do NOT allow User to move MDS Support
--<<<-<wd>oct2002
------------------------------------------------------------------------------------------
       Call !!MdsResetPins(8,10)
       !!kRestoreUnits(!currentunits)
       Aid text num 400 'New Position' at $!NewPos

       !!Alert.Error('The New Position does NOT lie WITHIN the existing tube start and end')
       Aid clear text 400
       return FALSE
     else
       !!kRestoreUnits(!currentunits)
       return true
     endif

   else

    !!kRestoreUnits(!currentunits)
   --  Spkbrk FALSE
      -- handle ANY
      -- endhandle

    return TRUE

   endif


-- End of file mdscheckwithin.pmlfnc
