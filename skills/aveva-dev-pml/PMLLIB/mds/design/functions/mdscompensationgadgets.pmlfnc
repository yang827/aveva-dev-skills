--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsCompensationGadgets()

	!compensationOn = !!mdsCompplateDflts.loadError.unset()
	handle ANY
		!compensationOn = false
	endhandle

	if !compensationOn then
    button .createCompplate at xmax+0.5 ymin tooltip 'Create Compensation' pixmap width 19 height 19 callback '!!mdsCompplateDflts.createCompplate(!this)'
    button .modifyCompplate at xmax ymin tooltip 'Modify Compensations' pixmap width 19 height 19 callback '!!mdsCompplateDflts.modifyCompplates(!this)'
    button .deleteCompplate at xmax ymin tooltip 'Delete Compensation' pixmap width 19 height 19 callback '!!mdsCompplateDflts.deleteCompplate(!this)'
  endif


endfunction
