--
--
--  Description:    Function to create either ATTA (below BRAN) or CTSUPP (below CTRAY)
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsCreateAtta(!styp is STRING, !spec is DBREF)

  !type = !!ce.type
  if !type.eq('CTSUPP').or(!type.eq('CTRAY')) then
    !lbor = !!ce.ppbor[1]
    new CTSUPP
    !spref = !!mdsSelectSpref('ATTA',!lbor,!styp,!spec).first()
  else
    new ATTA
    !select = SELECT SPEC $!<spec.name> WITH STYP '$!<styp>'
    !spref = !select[1]
  endif

  if !spref.styp.eq('RACK-REST') then
    desp 0 0
  endif

  !!ce.spref = !spref

endfunction
