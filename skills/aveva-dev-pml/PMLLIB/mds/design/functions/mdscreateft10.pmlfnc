--------------------------------------------------------------------------------
--
-- File:                mdscreateft10.pmlfnc
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:          MPS133
--
-- Author:              I.osborne
-- Created:             Thu Jul 03
--
--
-- Description:
-- function to create support frame type 10
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCreateFt10(!method is STRING)

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  call !!mdsResetPins(1,9)

  --<wd>may2007<mds12>
  --  !iDType    = 'GENSEC SCTN SBFI PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX'
  !session = current session
  if !session.module().upcase().match('DESIGN').gt(0) then
    !iDType = 'GENSEC SCTN SBFI PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX'
  elseif  !session.module().upcase().match('OUTFITTING').gt(0) then
    !iDType = 'GENSEC SCTN SBFI PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX HSTIFF HPLATE'
  endif
  --<wd>may2007<mds12>

  !support   = !!mdsFt10.support
  --!clearance = !!mdsOptions.clear.val
  !overlap   = !!mdsOptions.overlap.val
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !datum     = !support.datum

  -- Check that Datum atta has been created
  -- Moved here because of the datum atta is not created the Bars[1]
  -- variable set below is not set and the function fails
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  --<k.pleschner>Apr06
  !datumDflts = object MDSANCGEOMDFLTS(!datum)
  !clearance = !datumDflts.cend
  --<k.pleschner>

  !stru      = !support.stru
  !name      = !stru.name
  !atta      = !support.bars[1]
  !p10Dir    = !support.p10Dir
  !p11Dir    = !support.p11Dir
  !pLDir     = !support.pLDir
  !pADir     = !support.pADir
  !buildStyle = :MdsBuildStyl of $!stru
  !struIsOld  = !stru.mcount.boolean()

  var !pjoiColl coll all pjoi with gtyp eq 'APAD' for $!stru
  if !pjoiColl.size().neq(0) then
    !padsExist = TRUE
  else
    !padsExist = FALSE
  endif

  -- Does the support have attached/Associated supports

  if !!mdsgetconnectedsupp(!stru) then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  ----------------------------- **** connexions **** -----------------------------

  !refe         = !!ce
  !form      = !!mdsFt10

  --<kp>jan2012 MDS associations
  !unusedAssociation = !support.associations
  !picks = ARRAY()

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru
  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  !haveJoints = FALSE

  if(!form.support.joints.unset().not()) then
    !joints     = !support.joints
    !attributes = ARRAY()
    !haveJoints = !!kRestoreJoints(!joints,!attributes,'SAVE','')
    handle ANY
      !haveJoints = FALSE
      !support.joints.clear()
      -- in case they have been deleted and cancel is used
    endhandle
  endif

  ---------------------------------------------------------------------------------
  -- Check that Datum atta has been positioned
  if (!support.position.not())then
    !!alert.message('Position atta before identifying supporting steelwork')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  !noEquiv = false

  -- Evaluate replacement support name for frame type 11
  !substitute = trim (before (!!mdsFrame.standard.dtext[!!mdsFrame.standard.rtext.findfirst('FT11')], '-'))
  handle any
    !noEquiv = true
    !substitute = 'Identified element is unsuitable to support from'
  endhandle
  -- store compensations
  !complates = !!mdsCompplateDflts.compensatingPlates(!form)


  ------------------------------------------------------------------------------------------------------
  --<wd>aug2007<mds12>
  -- ENSURE ALL the current MDS SNIPES(FITTINGS) that EXIST on the current MDS STRUCTURE SCTN elements are STORED,
  -- so "UPDATE" the FORM MDSSUPPORT object member "!form.support.mdssctns" to represent the current MDS STRUCTURE.
  -- *** IMPORTANT*** The object needs to be UPDATED before CREATIIN/MODIFICATION of the MDS STRUCTURE commences,
  -- as ADDITIONAL MDS SNIPES may have been ADDED/MODIFIED/DELETED by the USER since the FORM was initialised,
  -- via the !!mdsSnipe form utility from the MAIN "MDS DESIGN application" BAR menu option... "Modify>Snipe on Angle..."
  --
  -- REGENERATE the DATA stored in the FORM MDSSUPPORT object member "!form.support.mdssctns"
  -- for ALL of the current MDS Support SCTNS and ALL the associated MDS SNIPE(FITTING) members
  !!mdssupportsctns(!form)

  -- UPDATE the local !support object variable with the latest MDSSNIPE DATA
  !support.mdssctns      = !form.support.mdssctns
  !support.mdssctnsstore = !form.support.mdssctnsstore

  --<wd>aug2007<mds12>
  ------------------------------------------------------------------------------------------------------

  -------------------------------------------------
  --<wd>oct2004
  -- !dDir and !udir variables are now always defined form the ACTUAL P9 direction of the DATUM Atta
  --------------------------------------------------------------------------------------------------

  -- Always read the P9direction for the TRUE !dDir of the DATUM ATTA
  -- on HORIZONTAL and VERTICAL PIPES -- SLOPING PIPES need the TRUE ORTHOGONAL DIRECTIONS!!!!!!!!
  --    !dDir = !support.p9dir.wrt(/* )
  --    VAR !p3P9Dir CONST DIR P3 OF $!datum TO P9 OF $!datum
  --    !udir = !p3P9Dir.direction().wrt(/* )

  --<wd>oct2004
  -------------------------------------------------
  --<wd>oct2004
  !directions = !!mdsremovegrad(!datum)
  !support.datumorthdirs = !directions
  !udir = !directions[4]
  !dDir = !directions[3]
  if (!support.rotateCur)then
    !orixd = !directions[5]
  else
    !orixd = !directions[6]
  endif
  --!orixd = !directions[5]
  !orizd = !directions[4]
  --<wd>oct2004
  -------------------------------------------------

  -------------------------------------------------

  -- Store section name and matref for each member
  -- for resetting later
  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)

  -- Generate pin positions for each creation type

  if (!method eq |CURSOR|)then

    !errorMessage = STRING()
    !dummyS       = ''

    if(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('UNJOINTED')) then
      -- nothing to do
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('WARNING')) then
      !continue = !!alert.confirm(!errorMessage)
      if(!continue.eq('NO')) then
        !!kRestoreUnits(!currentUnits)
        return
      endif
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('ERROR')) then
      !!alert.error(!errorMessage)
      !!kRestoreUnits(!currentUnits)
      return
    endif


    label /Element1

    !pick1 = !support.singlePick(!iDType,'Identify element to support vertical leg')
    if !pick1.unset() then
      !!ce = !stru
      !!kRestoreUnits(!currentUnits)
      return
    endif

    !testCe = !!mdsRelToDatum(!datum, !pick1, !dDir, !clearance.real())

    if (!testCe[1].upcase() eq 'UNSET')then
      !!alert.error('Identified element is unsuitable to support from.')
      golabel /Element1
    elseif (!testCe[1].upcase() eq '')then
      golabel /Element1
    endif
    if (!pADir eq U or !pLDir eq U)then
      if (!testCe[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('Identified element is infront of pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'Identified element is infront of pipe.')
        endif
        golabel /Element1
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is in line with the datum atta')
        golabel /Element1
      endif
    else
      if (!testCe[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('Identified element is above pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'Identified element is above pipe.')
        endif
        golabel /Element1
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is at the same elevation as the datum atta')
        golabel /Element1
      endif
    endif

    --<wd>may2007<mds12>
    --    if (!pick1.hardType eq 'PANE' or !pick1.type eq 'BOX' or !pick1.type.eq('SBFI'))then
    if (!pick1.hardType eq 'PANE' or !pick1.type eq 'BOX' or !pick1.type.eq('SBFI') or !pick1.type.eq('HPLATE')) then
      --<wd>may2007<mds12>

      !plane1 = !testCe[2]
      VAR !pDir1 CONST DIR $!plane1
    endif

    label /Element2

    !pick2 = !support.singlePick(!iDType,'Identify element to support cross member')
    if !pick2.unset() then
      !!ce = !stru
      !!kRestoreUnits(!currentUnits)
      return
    endif

    !testCeBAR = !!mdsRelToDatum(!datum, !pick2, !p11Dir, !clearance.real())
    if (!testCeBAR[1].upcase() eq 'UNSET')then
      !!alert.error('Identified element is unsuitable to support from.')
      golabel /Element2
    elseif (!testCeBAR[1].upcase() eq '')then
      golabel /Element2
    elseif (!testCeBAR[1].upcase() eq 'EQUAL')then
      !!alert.error('Identified element is in line with the datum atta')
      golabel /Element2
    elseif (!testCeBAR[1].upcase() eq 'ABOVE')then
      !sideDir = !p10Dir
      !legDir  = !p11Dir
      !support.rotateCur = TRUE
      --<tm>04/07/2005 15:41
      --<tm>swap the orientation if the support is rotated
      !orixd = !directions[5]
    elseif (!testCeBAR[1].upcase() eq 'BELOW')then
      !sideDir = !p11Dir
      !legDir  = !p10Dir
      !support.rotateCur = false
    endif

    --<wd>may2007<mds12>
    --    if (!pick2.hardType eq 'PANE' or !pick2.type eq 'BOX' or !pick2.type eq 'SBFI') then
    if (!pick2.hardType eq 'PANE' or !pick2.type eq 'BOX' or !pick2.type eq 'SBFI' or !pick2.type.eq('HPLATE')) then
      --<wd>may2007<mds12>

      !plane2 = !testCeBAR[2]
      VAR !pDir2 CONST DIR $!plane2
    endif

    !!mdsCreateMess(true)

    -- Position Pins for Vertical leg first

    !!ce = !pick1

    -- Check to see if first item picked is a bedplate

    --<wd>may2007<mds12>
    --      if (!pick1.hardType eq 'PANE' or !pick1.type eq 'BOX' or !pick1.type.eq('SBFI')) then
    if (!pick1.hardType eq 'PANE' or !pick1.type eq 'BOX' or !pick1.type.eq('SBFI') or !pick1.type.eq('HPLATE')) then
      --      STRU
      --      !type = !!ce.:MDSSuppType
      STRU
      handle NONE
        !type = !!ce.:MDSSuppType
      elsehandle ANY
        !type = ''
      endhandle
      --<wd>may2007<mds12>

      if (!type eq 'FT22')then
        !bedPlate = true
        PIN 1 AT $!pick1
        PIN 1 DIR $!pDir1
        VAR !tempInter CONS POS INT PIN 1 $!plane1
        !inter = !tempInter.position()
      elseif !pick1.type.eq('SBFI') then
        PIN 1 AT P1 of $!pick1
        PIN 1 DIR $!pDir1
        VAR !tempInter CONS POS INT PIN 1 $!plane1
        !inter = !tempInter.position()
        VAR !pin1Up PIN 1 U
        if (!pin1Up.real().gt(!datum.position.wrt(/* ).up))then
          !!mdsCreateMess(false)
          !!alert.error('Identified anchor plate is above pipe')
          PIN 1 OFF
          !!kRestoreUnits(!currentUnits)
          return
        endif
      else
        -- Position pins clear of attas
        PIN 1 AT P0 of $!datum
        PIN 1 DIR $!legDir
        PIN 2 COPY PIN 1
        !dim = 0
        do !iref values !support.atta
          --<k.pleschner>Apr06
          -- avoid SREF atta
          skip if !iref.name.substring(-1,-5).eq('/SREF')
          !i = object MDSANCGEOMDFLTS(!iref)

          --PIN 2 plane PIN 2 CLEAR $!clearance BEH $!i
          if !i.clge.eq('GEOM') then
            -- use clearance from geometry
            PIN 2 plane PIN 2 CLEAR $!i.cend BEH $!i
          else
            -- use distance from centreline
            PIN 2 plane PIN 2 THR $!i
            PIN 2 plane PIN 2 DIST $!i.cend
          endif
          handle (2,109)
            break
          endhandle
          VAR !cDIR CONST DIR PIN 1 TO PIN 2
          !cdim = !!kStrReal('CONST DIST PIN 1 TO PIN 2')
          -- Set object definition
          !direction = object KEQUALDIR()
          !direction.directionA = !cDIR.direction()
          !direction.directionB = !legDir
          !direction.tolerance  = 0.05

          if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
            PIN 2 AT $!datum
            PIN 2 DIST $!cdim
            !dim = !cdim
          else
            PIN 2 AT $!datum
            PIN 2 DIST $!dim
          endif
        enddo
        PIN 1 COPY PIN 2
        PIN 1 DIR $!dDir
        VAR !tempInter CONS POS INT PIN 1 $!plane1
        !inter = !tempInter.position()
      endif

      --<wd>may2007<mds12>
      --      elseif (!pick1.type eq 'SCTN') or !pick1.type.eq('GENSEC') then
    elseif (!pick1.type eq 'SCTN') or !pick1.type.eq('GENSEC') or !pick1.type.eq('HSTIFF') then
      --<wd>may2007<mds12>

      -- ************************ Connexions ***********************
      !support.connections[1] = !pick1
      !support.connections[2] = !pick2
      --        !!mdsFt10.lineUp.active = False

      !start = plstart NA wrt world
      !end   = plend NA wrt world
      var !lineA CONS line JOIN $!start to $!end
      var !lineB CONS line P10 of $!datum
      var !tempInter CONS POS INT $!lineA $!lineB
      !inter = !tempInter.position()

      -------------------------------------------------
      --<wd>nov2004
      -- Get the Directions of the Constructed Lines and Check if they are Parallel within a Tolerance Angle of (+/-) 5 degrees
      -- Set KEQUALDIR object definition
      !dira = !lineA.after('line ').before( 'through').direction()
      !dirb = !lineB.after('line ').before( 'through').direction()
      !checkdir = object KEQUALDIR()
      !checkdir.directionA = !dira
      !checkdir.directionB = !dirb
      !checkdir.tolerance  = 5
      -- Only DO this if the variable "!inter" has been "set".
      if (!inter.set())then
        -- Check if directions are Parallel within a Tolerance Anlge of (+/-) 5 degrees
        if (!!mdsdirequaldir(!checkdir)) then
          -- TRUE so set the "!inter" variable to "unset" which will automatically
          -- FORCE the !parallel variable to be set to TRUE in the CODE below
          !inter = object POSITION()
        endif
      endif
      --<wd>nov2004
      -------------------------------------------------
      if (!inter.unset())then
        !parallel = true

        -- Direction to move leg is along the length of a beam
        -- position pin 9 clear of all attas
        PIN 1 AT P0 of $!datum
        PIN 1 DIR $!legDir
        PIN 2 COPY PIN 1
        !dim = 0
        do !iref values !atta
          --<k.pleschner>Apr06
          -- avoid SREF atta
          skip if !iref.name.substring(-1,-5).eq('/SREF')
          !i = object MDSANCGEOMDFLTS(!iref)

          --PIN 2 plane PIN 2 CLEAR $!clearance BEH $!i
          if !i.clge.eq('GEOM') then
            -- use clearance from geometry
            PIN 2 plane PIN 2 CLEAR $!i.cend BEH $!i
          else
            -- use distance from centreline
            PIN 2 plane PIN 2 THR $!i
            PIN 2 plane PIN 2 DISTANCE $!i.cend
          endif
          handle (2,109)
            break
          endhandle
          VAR !cDIR CONST DIR PIN 1 TO PIN 2
          !cdim = !!kStrReal('CONST DIST PIN 1 TO PIN 2')

          -- Set object definition
          !direction = object KEQUALDIR()
          !direction.directionA = !cDIR.direction()
          !direction.directionB = !legDir
          !direction.tolerance  = 0.05

          if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
            PIN 2 AT $!datum
            PIN 2 DIST $!cdim
            !dim = !cdim
          else
            PIN 2 AT $!datum
            PIN 2 DIST $!dim
          endif
        enddo
        PIN 1 COPY PIN 2
        PIN 1 DIR $!dDir
      else
        !parallel = false
        PIN 1 AT $!inter
        PIN 1 DIR $!dDir
        PIN 1 plane PIN 1 THRO P9 OF $!datum
      endif
      VAR !pin1Pos PIN 1 POS WRT WORLD
      !inter = !!kFlangeOrWeb(!pick1, !pin1Pos.position(), !dDir)
    endif

    --<kp>jan2012 Store pick for association
    !picks[1][1] = !pick1
    !picks[1][2] = !inter

    PIN 9 AT $!inter
    PIN 9 DIR $!udir

    -- Test position of pin 9 relative to datum to see if the intersection point
    -- is the wrong side of the vertical member
    PIN 8 AT P0 of $!datum
    PIN 8 dir $!legDir

    --<wd>may2007<mds12>
    --      if (!pick2.hardType eq 'SCTN') or !pick2.type.eq('GENSEC') then
    if (!pick2.hardType eq 'SCTN') or !pick2.type.eq('GENSEC') or !pick2.type.eq('HSTIFF') then
      --<wd>may2007<mds12>

      PIN 8 plane PIN 8 thro $!pick2
    else
      VAR !tempInter CONS POS INT PIN 8 $!plane2
      !inter = !tempInter.position()
      PIN 1 AT $!inter
      PIN 8 plane PIN 8 THRO PIN 1
    endif
    PIN 4 AT P0 of $!datum
    PIN 4 dir $!legDir
    PIN 4 plane PIN 4 thro PIN 9

    -------------------------------------------------
    --<wd>nov2004
    -- Direct Pin 8 to the DATUM ATTA and Re Plane thro $!pick2 if it's a SCTN

    --<wd>may2007<mds12>
    --      if (!pick2.hardType eq 'SCTN') or !pick2.type.eq('GENSEC') then
    if (!pick2.hardType eq 'SCTN') or !pick2.type.eq('GENSEC') or !pick2.type.eq('HSTIFF') then
      --<wd>may2007<mds12>

      pin 8 dir to $!datum
      pin 8 plane pin 8 thro $!pick2
    endif
    --<wd>nov2004
    -------------------------------------------------

    var !testPin8 CONS DIR P0 of $!datum to PIN 8
    var !testPin4 CONS DIR P0 of $!datum to PIN 4

    -- Set object definition
    !direction = object KEQUALDIR()
    !direction.directionA = !testPin8.direction()
    !direction.directionB = !testPin4.direction()
    !direction.tolerance  = 0.05

    -- Check directions
    if (!!kDirEqualDir(!direction)) then

      -------------------------------------------------
      --<wd>nov2004
      -- Pipe may be Vertical or Horizontal and may also be a Horizontal SLOPING Pipe
      -- Before SENDING error to USER on Supports where the DATUM ATTA has been ROTATED from its DEFAULT Orientation
      -- PLANE pin 8 thro POSE of $!pick2 and pin 8 dir to $!datum and RE-CHECK Directions
      pin 8 plane pin 8 thro pose of $!pick2
      pin 8 dir to $!datum
      var !testPin8 cons dir p0 of $!datum to pin 8
      !direction.directionA = !testPin8.direction()
      if (!!kDirEqualDir(!direction)) then
        !!mdsCreateMess(false)
        -- Reset all pins associated with this support
        !!mdsResetPins(1,9)
        !!alert.error('Second element picked will leave the datum atta off the supporting framework')
        !!kRestoreUnits(!currentUnits)
        return
      else
        -- leg on correct side
        pin 7 copy pin 4
      endif
    else
      -- leg on correct side
      PIN 7 COPY PIN 4
    endif
    --<wd>nov2004
    -------------------------------------------------

    PIN 7 DIR $!dDir
    PIN 7 plane PIN 7 THRO PIN 9
    PIN 7 DIR $!udir
    PIN 9 COPY PIN 7
    PIN 9 DIR $!udir
    PIN 9 plane PIN 9 THRO P9 of $!datum
    PIN 9 DIR $!legDir

    -- Position pins for end of horizontal bar

    --<wd>may2007<mds12>
    --      if (!pick2.hardType eq 'SCTN') or !pick2.type.eq('GENSEC') then
    if (!pick2.hardType eq 'SCTN') or !pick2.type.eq('GENSEC') or !pick2.type.eq('HSTIFF') then
      --<wd>may2007<mds12>

      !inter = !!kFlangeOrWeb(!pick2, !datum.pos, !sideDir)
      PIN 6 AT $!inter
      PIN 6 DIR $!sideDir
    else
      PIN 6 AT P9 OF $!datum
      PIN 6 DIR $!sideDir
      PIN 6 plane PIN 6 THRO PIN 8
    endif

    --<kp>jan2012 Store pick for association
    !picks[2][1] = !pick2
    !picks[2][2] = !inter

  elseif (!method eq |DIMENSION|)then

    !!ce = $!<name>-V1
    handle(2,109)
    elsehandle NONE
      if (!support.mirror) then
        !farend = 0
      else
        !farend = 1
      endif
      !saveV1 = object MDSSAVEENDS(!!ce,!datum,!farend)
    endhandle
    !!ce = $!<name>-BAR-1
    handle(2,109)
    elsehandle NONE
      if (!support.mirror) then
        !farend = 0
      else
        !farend = 1
      endif
      !saveV2 = object MDSSAVEENDS(!!ce,!datum,!farend)
    endhandle

    -- Initialise variables for dimension check
    !d1 = !!mdsFt10.dim1.val
    !d2 = !!mdsFt10.dim2.val
    !d3 = !!mdsFt10.dim3.val

    if (!d1.eq(0) or !d2.eq(0) or !d3.eq(0)) then
      !!alert.error('Not all of the dimensions have been completed.')
      !!kRestoreUnits(!currentUnits)
      return
    endif

    !!mdsCreateMess(true)

    -- Get correct orientation
    if (!support.rotateCur)then
      !sideDir = !p10Dir
      !legDir  = !p11Dir
    else
      !sideDir = !p11Dir
      !legDir  = !p10Dir
    endif

    -- Position pins
    -- PIN 9 will be at the point where crossbar (BAR-1) meets vertical leg (V1)
    -- PIN 6 will be at the other end of crossbar
    !!ce = !datum
    PIN 9 COPY P9
    PIN 9 DIR $!legDir
    PIN 6 COPY PIN9
    PIN 6 DIR $!sideDir

    PIN 9 plane PIN 9 THRO CE
    PIN 6 plane PIN 6 THRO CE
    PIN 9 DIST $!d2
    PIN 9 DIR $!dDir
    PIN 7 COPY PIN 9
    PIN 7 DIST $!d3
    PIN 7 DIR $!udir
    PIN 6 DIST ($!d1 - $!d2)

    --<k.pleschner>Apr06
    --PIN 6 DIR FROM PIN 6 TO PIN 9
    --PIN 9 DIR FROM PIN 6 TO PIN 9
    PIN 9 DIR $!legDir
    PIN 6 DIR $!sideDir

  elseif (!method eq |CLEARANCE|)then
    ------------ *** Connexion Warnings *** -------------

    --$(

    !errorMessage = STRING()
    !dummyS       = ''

    if(!!kErrorsForConns(!form, !errorMessage,!dummyS).eq('UNJOINTED')) then
      -- nothing to do
    elseif(!!kErrorsForConns(!form, !errorMessage,!dummyS).eq('WARNING')) then
      !continue = !!alert.confirm(!errorMessage)
      if(!continue.eq('NO')) then
        !!kRestoreUnits(!currentUnits)
        return
      endif
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('ERROR')) then
      !!alert.error(!errorMessage)
      !!kRestoreUnits(!currentUnits)
      return
    else
      -- leave in case
    endif

    --$)

    ---------------------------------------------

    label /Element3

    !pick3 = !support.singlePick(!iDType,'Identify element to support vertical member')
    if !pick3.unset() then
      !!ce = !stru
      !!kRestoreUnits(!currentUnits)
      return
    endif

    !testCe = !!mdsRelToDatum(!datum, !pick3, !dDir, !clearance.real())
    if (!testCe[1].upcase() eq 'UNSET')then
      !!alert.error('Identified element is unsuitable to support from.')
      golabel /Element3
    elseif (!testCe[1].upcase() eq '')then
      golabel /Element3
    endif
    if (!pADir eq U or !pLDir eq U)then
      if (!testCe[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('Identified element is infront of pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'Identified element is infront of pipe.')
        endif
        golabel /Element3
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is in line with the datum atta')
        golabel /Element3
      endif
    else
      if (!testCe[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('Identified element is above pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'Identified element is above pipe.')
        endif
        golabel /Element3
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is at the same elevation as the datum atta')
        golabel /Element3
      endif
    endif

    --<wd>may2007<mds12>
    --      if (!pick3.hardType eq 'PANE' or !pick3.type eq 'BOX' or !pick3.type.eq('SBFI'))then
    if (!pick3.hardType eq 'PANE' or !pick3.type eq 'BOX' or !pick3.type.eq('SBFI') or !pick3.type.eq('HPLATE'))then
      --<wd>may2007<mds12>

      !plane3 = !testCe[2]
      VAR !pDir3 CONST DIR $!plane3
    endif

    -- Get correct orientation
    if (!support.rotateCur)then
      !sideDir = !p10Dir
      !legDir  = !p11Dir
    else
      !sideDir = !p11Dir
      !legDir  = !p10Dir
    endif

    !!mdsCreateMess(true)

    -- Position pins
    -- Set first direction for vertical leg

    !!ce = !datum
    PIN 9 AT P9 of $!datum
    PIN 9 DIR $!legDir
    PIN 7 COPY PIN 9
    !dim = 0

    do !iref values !support.atta
      --<k.pleschner>Apr06
      --avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)

      --PIN 7 plane PIN 7 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 7 plane PIN 7 CLEAR $!i.cend BEH $!i
      else
        -- use distance from centreline
        PIN 7 plane PIN 7 THR $!i
        PIN 7 plane PIN 7 DISTANCE $!i.cend
      endif
      handle (2,109)
        break
      endhandle
      VAR !cDIR CONST DIR PIN 9 TO PIN 7
      !cdim = !!kStrReal('CONST DIST PIN 9 TO PIN 7')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cDIR.direction()
      !direction.directionB = !legDir
      !direction.tolerance  = 0.05

      if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 7 AT P9 of $!datum
        PIN 7 DIST $!cdim
        !dim = !cdim
      else
        PIN 7 AT P9 of $!datum
        PIN 7 DIST $!dim
      endif
    enddo

    PIN 7 DIR $!dDir
    VAR !pin7Pos PIN 7 POS WRT WORLD

    --<wd>may2007<mds12>
    --      if (!pick3.type eq 'SCTN') or !pick3.type.eq('GENSEC') then
    if (!pick3.type eq 'SCTN') or !pick3.type.eq('GENSEC') or !pick3.type.eq('HSTIFF') then
      --<wd>may2007<mds12>

      !inter = !!kFlangeOrWeb(!pick3, !pin7Pos.position(), !dDir)
      PIN 7 AT $!inter
      ---------------****** Connexions ******----------------------
      !support.connections.clear()
      !support.connections[1] = !pick3
      !support.connections[2] = !pick3
      -- don't need for ft11        !support.connections[2] = !pick3
      --           !!mdsFt10.lineUp.active = True
      ------------------this bit will stop clearance being used if support is not under picked sctn-----------------------
      if(!haveJoints) then
        !connected = !!mdsGetBeamConn(!support,!attributes[1][8].dbref())
        if(!connected.unset()) then
          !!alert.error('Support is not positioned correctly through the new joints. Position "Through", before continuing.')
          !!ce = !refe
          return
        endif
      endif
      ------------------------take it out and it will create joints however far apart the support and steel is------------

    else
      VAR !tempInter CONS POS INT PIN 7 $!plane3
      !inter = !tempInter.position()
      PIN 1 AT $!inter
      PIN 7 plane PIN 7 THRO PIN 1
    endif

    PIN 7 DIR $!udir
    PIN 9 AT P9 of $!datum
    PIN 9 plane PIN 9 THRO PIN 7

    -- set second direction
    !!ce = !datum
    PIN 6 AT P9 of $!datum
    PIN 6 DIR $!sideDir
    PIN 8 COPY PIN 6
    !dim = 0

    do !iref values !support.atta
      --<k.pleschner>Apr06
      --avoid SREF atta
      !i = object MDSANCGEOMDFLTS(!iref)

      --PIN 8 plane PIN 8 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        --use clearance from geometry
        PIN 8 plane PIN 8 CLEAR $!i.cend BEH $!i
      else
        --use distance from centreline
        PIN 8 plane PIN 8 THR $!i
        PIN 8 plane PIN 8 DISTANCE $!i.cend
      endif
      handle (2,109)
        break
      endhandle
      VAR !cDIR CONST DIR PIN 6 TO PIN 8
      !cdim = !!kStrReal('CONST DIST PIN 6 TO PIN 8')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cDIR.direction()
      !direction.directionB = !sideDir
      !direction.tolerance  = 0.05

      if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 8 AT P9 of $!datum
        PIN 8 DIST $!cdim
        !dim = !cdim
      else
        PIN 8 AT P9 of $!datum
        PIN 8 DIST $!dim
      endif
    enddo

    PIN 6 plane PIN 6 THRO PIN 8

  endif

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  -- Create and ARRAY of Attas with Packing Pieces (PDMS Names ONLY)
  -- and the Type and Size of the Packing Pieces to Recreate
  !attapp = !!mdspackers(!support)

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  !!ce = !stru
  --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
  !!mdsRemoveAutoPadRules(!stru)
  --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end

  -- Pins now in position create framework
  delete STRU MEM
  handle (41,66) (2,113) (2,113)
  endhandle

  --<wd>oct2000
  !mdstemp = /MDS/FT10/$!selection
  :mdscheck $!mdstemp.:mdscheck
  :mdsframirror $!mdstemp.:mdsframirror

  --<wd>oct2000

  --<wd>feb2004
  -- Position the MDS STRU
  --AT $!datum
  if (!datum.styp inset ('AT60')) then
    at p9 of $!datum
  else
    at $!datum
  endif
  --<wd>feb2004

  NEW FRMW $!name/MAIN
  !frmwSupport = !!ce

  -- Copy required template/s
  !!ce = /MDS/FT10/$!selection
  --<k.pleschner>Apr06
  -- get :mdsbuildstyl (INSIDE/OUTSIDE/NONE) from template structure
  !buildStyleNew = :mdsbuildstyl

  !subs = !!kCollectAllFor('SUBS', '', !!ce)
  !frmw = !!kCollectAllFor('FRMW', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')

  -- Navigate back to support and create template elements
  !!ce = !frmwSupport
  COPY ATTRIB OF $!frmw[1]
  COPY MEM OF $!frmw[1] RENAME $!frameFormat $!name
  do !i indices !subs
    NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
    COPY MEM OF $!subs[$!i] RENAME $!frameFormat $!name
  enddo

  -- Get direction of P9 of datum atta and dist between p9 and p0
  !!ce = !stru

  -- Set stru description for template recognition
  !desc = desc of /MDS/FT10/$!selection
  !mdsBars = :mdsbars of /MDS/FT10/$!selection
  desc '$!desc'
  :MdsBars $!mdsBars

  -- <k.pleschner>Apr06 set stru :mdsbuildstyl
  :mdsbuildstyl $!buildStyleNew

  MOVE $!dDir THRO P9 OF $!datum
  if !datum.:mdsguideref.set() and !datum.:mdsguideref.badref().not() then
    !mdsGuideRef = !datum.:mdsguideref
    --<wd>20may2004
    --MOVE $!dDir thro p9 of $!mdsGuideRef
    -- Do NOT Move the STRU if the GUIDE is a TRUNNION GUIDE/STOP etc...
    if (!datum.catref.owner.:mdstrun.not()) then
      MOVE $!dDir thro p9 of $!mdsGuideRef
    endif
    --<wd>20may2004
  endif

  -- Orientate Structure

  ori x is $!orixd and z is $!orizd


  -- If a trunnion is added to a support then we need to store the direction in a
  -- uda for later use
  var !oriFrame dir y wrt /*
  :MdsFrameDir $!oriFrame
  -- Extend and move vertical leg
  !!ce = $!<name>-V1
  EXTEND END THRO PIN 7
  !flush = :MdsOlap
  if !flush eq 'FLUSH' then
  elseif !flush eq 'OVERLAP' then
    !num = :MdsOnum
    if !num.lt(0) then
      !num = !num.abs()
      EXTEND START $!num
    else
      EXTEND START -$!num
    endif
    -- EXTEND START -$!num
  else
    EXTEND START -$!overlap
  endif

  --------------------------------------------------------------------------------------------------
  -- If we are using FANP templates to a SBFI we need to centre the vertical leg with cursor mode
  if ((desc of /MDS/TEMPLATES ) eq ('Framatome Templates') and !method.eq('CURSOR')) then
    if !pick1.type.eq('SBFI') then
      var !savePin1Pos pin 1 pos
      var !savePin1Dir pin 1 dir
      new sctn copy prev
      delete sctn mem
      handle any
      endhandle
      pin 1 copy pin 9
      pin 1 plane pin 1 clear 0 inf ce
      var !xPin1Pos1 pin 1 pos
      pin 1 plane pin 1 clear 0 beh ce
      var !xPin1Pos2 pin 1 pos
      var !sctnV1Dist const dist $!xPin1Pos1 to $!xPin1Pos2
      pin 1 pos $!savePin1Pos
      pin 1 dir $!savePin1Dir
      delete sctn
      !!ce = $!<name>-V1
      pin 9 dist (-$!sctnV1Dist / 2)
      !!mdsFt10.dim1.val = !!mdsFt10.dim1.val - (!sctnV1Dist.real() / 2)
    endif
  endif
  --------------------------------------------------------------------------------------------------

  -- If the flange gap toggle is switched on then adjust the positions
  if !method.eq('CURSOR') then
    -- The form is obviously this FORM, !pick1 is the first picked element
    -- !pick2 is the second picked element, !vertLeg is a logical to see if
    -- we have moved the pins onto the correct size or not
    !!mdsGapFlange(!form,!pick1,!pick1,TRUE)
  endif

  VAR !dIR PIN 9 DIR WRT WORLD
  MOVE $!dIR WRT WORLD THRO PIN 9
  PIN 5 COPY PIN 9
  PIN 3 COPY PIN 9
  !realSctn = !!ce
  new sctn copy prev
  delete sctn mem
  handle ANY
  endhandle
  PIN 5 plane PIN 5 CLEAR 0 BEH CE
  PIN 3 plane PIN 3 CLEAR 0 INF CE
  delete sctn

  !!ce = !realSctn
  !d59 = !!kStrReal('CONST DIST PIN 5 TO PIN 9')
  !d39 = !!kStrReal('CONST DIST PIN 3 TO PIN 9')
  !d35 = !!kStrReal('CONST DIST PIN 3 TO PIN 5')
  !diff = ((!d39 - !d59) / 2)

  if (!method eq 'CURSOR')then

    --<wd>may2007<mds12>
    --      if (!pick1.type eq 'SCTN') or !pick1.type.eq('GENSEC') then
    if (!pick1.type eq 'SCTN') or !pick1.type.eq('GENSEC')  or !pick1.type.eq('HSTIFF')then
      --<wd>may2007<mds12>

      if (!parallel)then
        MOVE $!dIR WRT WORLD DIST $!d39
      else
        MOVE $!dIR WRT WORLD DIST $!diff
      endif
    elseif (defined(!bedPlate))then
      MOVE $!dIR WRT WORLD DIST $!diff
    else
      MOVE $!dIR WRT WORLD DIST $!d39
    endif
  else
    MOVE $!dIR WRT WORLD DIST $!d39
    --<k.pleschner>Apr06
    -- reflect INSIDE/OUTSIDE build style
    if !buildStyleNew.eq('OUTSIDE').and(!method.eq('DIMENSION')) then
      MOVE $!dIR wrt world distance -$!d35
    endif
  endif

  PIN 3 plane PIN 3 CLEAR 0 INF CE

  ------------------****** connexions *******----------------------
  if(!support.connections.unset()) then
    -- dimensions are being used first
    :MDSConn default
  else
    !vertical1 = !!ce
    !connected = !!mdsGetBeamConn(!support,!vertical1)
    :MDSConn $!connected
    handle any
    endhandle
  endif
  --------------------*******************--------------------------


  -- Extend and move bar 1

  !!ce = $!<name>-BAR-1
  !tempOverlap = :MdsOlap
  !tempNum = :MdsOnum
  if !tempOverlap neq 'OVERLAP' then
    PIN 5 plane PIN 5 CLEAR $!overlap BEH $!<name>-V1
  else
    PIN 5 plane PIN 5 CLEAR $!tempNum BEH $!<name>-V1
  endif
  EXTEND START THRO PIN 5
  EXTEND END THRO PIN 6

  -------------------------------------------------
  --<wd>nov2004
  ----------------------- ****** connexions ******* --------------------
  if(!support.connections.unset()) then
    -- dimensions are being used first
    :MDSConn default
  else
    !bar1 = !!ce
    !connected = !!mdsGetBeamConn(!support,!bar1)
    :MDSConn $!connected
    handle ANY
    endhandle
  endif
  ---------------------------********************-----------------------
  --<wd>nov2004
  -------------------------------------------------

  -- Set dimensions
  if (!method eq |CURSOR| or !method eq |CLEARANCE|)then

    -- Dimension 1

    PIN 8 COPY PIN 3
    PIN 8 plane PIN 8 THRO PIN 6
    !dim1 = !!kStrReal('CONST DIST PIN 3 TO PIN 8')
    !!mdsFt10.dim1.val = !dim1

    -- Dimension 2

    PIN 8 COPY PIN 9
    PIN 8 plane PIN 8 THRO $!datum
    !dim2 = !!kStrReal('CONST DIST PIN 3 TO PIN 8')
    !!mdsFt10.dim2.val = !dim2

    -- Dimension 3

    !dim3 = !!kStrReal('CONST DIST PIN 9 TO PIN 7')
    !!mdsFt10.dim3.val = !dim3

  endif

  -- Select correct spref

  !!ce = $!<name>/SREF

  !!mdsDacControl(true)
  SEL SPREF WITH STYP 'FT10-C-$!selection' SPEC /MDF
  !!mdsSetSuppCode('MODIFY',!name,'FT10','FT10-C-1')

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)
  !!mdsDacControl(TRUE)

  !!ce = !stru

  -- Associate attas to bar

  !list = !support.bars[1]
  !references = ''
  do !i indices !list
    !references = !references & ' ' & !list[!i].string()
  enddo

  -- Set atta references to datum cross bar
  !!ce = $!<name>-BAR-1
  :MDSAttaRef $!references
  !support.barLen[1] = deri length of CE

  -- Check to see if support is mirrored
  !!ce = !stru
  if (!support.mirror)then
    call !!mdsMirrorFt10()
    !support.mirror = true
  endif

  -- Adjust for slope on horizontal lines only

  if (!pADir neq U and !pLDir neq U)then

    -- Check to see if the line is sloping
    !adjust = 0
    do !v values !atta
      !!ce = !v

      --<wd>oct2004
      skip if !!ce.name.match('/SREF').gt(0)
      --<wd>oct2004

      skip if !!ce.:mdsrotdir.east.set()
      !grad = pl grad
      if (!grad.neq(0))then

        --<wd>oct2004
        if (!!ce.pDir[9].wrt(/* ).east.abs().eq(1)) then
          !vHeight = 0
        elseif (!!ce.pDir[9].wrt(/* ).up.eq(0)) then
          !vHeight = 0
        else
          --<wd>oct2004
          !strucElement = ARRAY()
          !ref = $!name-BAR-1
          !strucElement.append(!ref)
          !vHeight = !!mdsAdjustSlope(!strucElement, !v)
          --<wd>oct2004
        endif
        --<wd>oct2004

      else
        !vHeight = 0
      endif
      if (!vHeight.gt(!adjust))then
        !adjust = !vHeight
      endif
    enddo

    -- Adjust required elements
    !!ce = $!<name>-BAR-1

    --<wd>oct2004
    --MOVE D WRT WORLD DIST $!adjust
    MOVE $!directions[3] DIST $!adjust
    --<wd>oct2004

    -------------------------------------------------
    --<wd>nov2004 -- Moved out of this CODE Block up to line 940 approx
$(
    ----------------------- ****** connexions ******* --------------------
    if(!support.connections.unset()) then
      -- dimensions are being used first
      :MDSConn default
    else
      !bar1 = !!ce
      !connected = !!mdsGetBeamConn(!support,!bar1)
      :MDSConn $!connected
      handle any
      endhandle
    endif
    ---------------------------********************-----------------------
$)
    --<wd>nov2004
    -------------------------------------------------

    !!ce = $!<name>-V1

    !end   = Posend wrt world
    !start = Posstart wrt world

    if (!support.mirror)then
      PIN 6 AT $!start
      PIN 8 AT $!end
    else
      PIN 6 AT $!end
      PIN 8 AT $!start
    endif

    PIN 6 DIR TO PIN 8
    PIN 8 COPY PIN 6
    PIN 8 plane PIN 8 CLEAR 0 BEH $!<name>-BAR-1

    if (!support.mirror)then
      if !flush eq 'OVERLAP' then
        !num = :MdsOnum
        EXTEND END THRO pin 8
        -- EXTEND END -$!num
        if !num.lt(0) then
          !num = !num.abs()
          EXTEND END $!num
        else
          EXTEND END -$!num
        endif
      elseif !flush neq 'FLUSH' then
        EXTEND END THRO pin 8
        EXTEND END -$!overlap
      endif
    else
      if !flush eq 'OVERLAP' then
        !num = :MdsOnum
        EXTEND START THRO pin 8
        if !num.lt(0) then
          !num = !num.abs()
          EXTEND START $!num
        else
          EXTEND START -$!num
        endif
        -- EXTEND START -$!num
      elseif !flush neq 'FLUSH' then
        EXTEND START THRO pin 8
        EXTEND START -$!overlap
      endif
    endif

    ------------------------- ****** connexions ******* -----------------------
    --<wd>oct2004 -- This CODE is NOT required and CONFUSING
    -- FT10 uses !bar1 and !vertical1 in the CODE above!!!!!!!
    -- What is this CODE doing ONLY setting !vertical?????????????
$(
    if(!support.connections.unset()) then
      -- dimensions are being used first
      :MDSConn default
    else
      !vertical = !!ce
      !connected = !!mdsGetBeamConn(!support,!vertical)
      :MDSConn $!connected
      handle any
      endhandle
    endif
$)
    -----------------------------********************--------------------------

    if (!method eq |DIMENSION|)then
      -- Extend vertical leg to account for the required adjustment

      if (!support.mirror)then
        !sctnEnd = 'START'
      else
        !sctnEnd = 'END'
      endif

      PIN 6 plane PIN 6 DIST -$!adjust
      EXTEND $!sctnEnd THRO PIN 6

    else

      -- Adjust dimensions on form
      !dim3Exist = !!mdsFt10.dim3.val - !adjust

      -- reset dimensions on form
      !!mdsFt10.dim3.val = !dim3Exist

    endif
  endif

  -- Reset materials of sections

  !!mdsResetMat(!storeMat)


  !!ce = !stru

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  -- Set 'FT25' form Support Object to be the same as 'FT10' form Support Object
  !!mdsFt25.support = !support

  -- Clear packs from 'BOTH forms' Support Objects as the SCTNs have already been deleted
  -- During the Framework Creation above
  !!mdsFt25.support.packs.clear()
  !support.packs.clear()

  -- Create Required Packing Pieces(SCTNs) at the Necessary Attas
  call !!mdscrpacksft25(!attapp, !!mdsFt10)

  -- Update 'FT10' support.packs data to that held in form 'FT25'
  !support.packs = !!mdsFt25.support.packs

  -- Navigate to Main Structure of Framework
  !!ce = !stru

  ----------------------------------------------------------------------
  ----------------------***** connexions *****--------------------------

  if(!haveJoints) then
    do !index indices !joints

      if(!joints[!index].badref().not() and !attributes[!index][8].dbref().:MDSConn.eq(!joints[!index].owner.owner)) then
        !mainStl = !attributes[!index][8].dbref().:MDSConn
        !support.joints[!index] =  !!mdsCreateJoint(!mainStl, !attributes[!index][8].dbref(),!joints[!index],!attributes[!index])
      else
        !dummy = object DBREF()
        !dummyA = ARRAY()
        !mainStl = !support.connections[!index]
        !support.joints[!index] =  !!mdsCreateJoint(!mainStl, !attributes[!index][8].dbref(),!dummy,!dummyA)

      endif
    enddo
  endif

  ----------------------------------------------------------------------

  -- If a joint is being used and it is handed then their will be a alternative spref of the
  -- opposite hand joint and the bang to set separated by a ,

  !!mdsSwapIntJoi(!support.stru,!support.mirror,!support.alias)

  !!ce = !stru

  -- Reset all pins associated with this support
  call !!mdsResetPins(1,9)

  -- Update support data held in form
  !!mdsFt10.support = !support

  !!mdsCreateMess(false)

  -- Does the item require bearing plates (Framatome Only)

  !!ce = !support.stru
  !!mdsAddBearing(!support.datum)
  !!ce = !support.stru

  -- Make sure the overlap is maintained when bearing plates are added

  if (desc of /MDS/TEMPLATES ) eq 'Framatome Templates' then
    do !verts from 1 to 1
      $!name-V$!verts
      if !!ce.:mdsolap.eq('OVERLAP') and !!ce.gtyp.eq('BOX') then
        !num = !!ce.:mdsonum
        !barNum = STRING()
        !length = 0
        do !loop from 1 to 6
          extend start inf $!name-BAR-$!loop
          handle ANY
            break
          endhandle
          !nLength = deri leng
          if !nLength.gt(!length) then
            !barNum = !loop.string()
            !length = !nLength
          endif
        enddo
        extend start inf $!name-BAR-$!barNum
        extend start -$!num
      endif
    enddo
    Stru
    var !sctns coll all sctn with matchwild(name,'*BAR*') for ce
    do !loop values !sctns
      !!ce = !loop.dbref()
      if !support.rotateCur then
        goto jois
        handle NONE
          pnod
          handle ANY
          elsehandle NONE
            rule set NPOS Dynamic ( ATTRIB POSE OF PREV  )
            prev
            joie pjoi 1 of next
            if !!ce.joie.eq(!!ce.jois) then
              jois def
            endif
          endhandle
        elsehandle ANY
        endhandle
        !!ce = !loop.dbref()
        goto joie
        handle NONE
          pnod
          handle ANY
          elsehandle NONE
            rule set NPOS Dynamic ( ATTRIB POSS OF PREV  )
            prev
            jois pjoi 1 of next
            if !!ce.joie.eq(!!ce.jois) then
              joie def
            endif
          endhandle
        elsehandle ANY
        endhandle
      else
        goto jois
        handle NONE
          pnod
          handle ANY
          elsehandle NONE
            rule set NPOS Dynamic ( ATTRIB POSS OF PREV  )
            prev
            jois pjoi 1 of next
            if !!ce.joie.eq(!!ce.jois) then
              joie def
            endif
          endhandle
        elsehandle ANY
        endhandle
        !!ce = !loop.dbref()
        goto joie
        handle NONE
          pnod
          handle ANY
          elsehandle NONE
            rule set NPOS Dynamic ( ATTRIB POSE OF PREV  )
            prev
            joie pjoi 1 of next
            if !!ce.joie.eq(!!ce.jois) then
              jois def
            endif
          endhandle
        elsehandle ANY
        endhandle
      endif
    enddo
  endif

  stru
  reconn recalc
  handle ANY
  endhandle


  !!ce = !support.stru
  -- Code for sloping decks
  if (!method eq |CURSOR|)then
    if defined(!testCe[3]) then
      !!mdstrimplane($!name-V1 ,!support.mirror, !testCe[2],'end')
      -- we have trimmed the length of the vertical section to suit the panel
      -- now we need to reset the dimension
      !!mdsFt10.dim3.val = !!mdsgetoverdim($!datum , $!name-V1 ,0)
    endif
    if defined(!testCeBAR[3]) then
      !!mdstrimplane($!name-BAR-1 ,!support.mirror, !testCeBAR[2],'end')
      -- we have trimmed the length of the vertical section to suit the panel
      -- now we need to reset the dimension
      if !support.rotateCur then
        !!mdsFt10.dim1.val = !!mdsgetoverdim($!datum , $!name-BAR-1 ,2) + !!mdsFt10.dim2.val
      else
        !!mdsFt10.dim1.val = !!mdsgetoverdim($!datum , $!name-BAR-1 ,3) + !!mdsFt10.dim2.val
      endif
    endif
  elseif (!method eq |CLEARANCE|)then

    if defined(!testCe[3]) then
      !!mdstrimplane($!name-V1 ,!support.mirror, !testCe[2],'end')
      -- we have trimmed the length of the vertical section to suit the panel
      -- now we need to reset the dimension
      !!mdsFt10.dim3.val = !!mdsgetoverdim($!datum , $!name-V1 ,0)
    endif
  elseif  !method eq |DIMENSION| then
    if defined(!saveV1) then
      !saveV1.restoreplane(!!mdsFt10.dim3.val ,0)
    endif
    if defined(!saveV2) then

      --<k.pleschner>Apr06 - commented out - it causes length of crossbar is wrong (shorter)
$(
      if !support.rotateCur then
        !saveV2.restoreplane(!!mdsFt10.dim1.val  - !!mdsFt10.dim2.val,3)
      else
        !saveV2.restoreplane(!!mdsFt10.dim1.val  - !!mdsFt10.dim2.val,2)
      endif
$)
    endif
  endif

  if undefined(!testCe[3]) then
    if (!method eq |CLEARANCE|)then

      --<wd>may2007<mds12>
      --      if !pick3.hardType.eq('SCTN') or !pick3.hardType.eq('GENSEC') then
      if !pick3.hardType.eq('SCTN') or !pick3.hardType.eq('GENSEC') or !pick3.hardType.eq('HSTIFF') then
        --<wd>may2007<mds12>

        !x = object MDSPLINES(!pick3,$!name-V1 ,TRUE )
        !x = object MDSPLINES(!pick3,$!name-BAR-1 ,TRUE )
      endif
    elseif (!method eq |CURSOR|)then

      --<wd>may2007<mds12>
      --      if !pick1.hardType.eq('SCTN') or !pick1.hardType.eq('GENSEC') then
      if !pick1.hardType.eq('SCTN') or !pick1.hardType.eq('GENSEC') or !pick1.hardType.eq('HSTIFF') then
        --<wd>may2007<mds12>

        !x = object MDSPLINES(!pick1,$!name-V1 ,TRUE )
      endif

      --<wd>may2007<mds12>
      --      if !pick2.hardType.eq('SCTN') or !pick2.hardType.eq('GENSEC') then
      if !pick2.hardType.eq('SCTN') or !pick2.hardType.eq('GENSEC') or !pick2.hardType.eq('HSTIFF') then
        --<wd>may2007<mds12>

        !x = object MDSPLINES(!pick2,$!name-BAR-1 ,TRUE )
        handle ANY
          !!alert.error(!!error.text)
        endhandle
      endif
    endif


    if !method neq |DIMENSION| then
      !!mdsFt10.dim3.val = !!mdsgetoverdim($!datum , $!name-V1 ,0)
      if !support.rotateCur then
        !!mdsFt10.dim1.val = !!mdsgetoverdim($!datum , $!name-BAR-1 ,2) + !!mdsFt10.dim2.val
      else
        !!mdsFt10.dim1.val = !!mdsgetoverdim($!datum , $!name-BAR-1 ,3) + !!mdsFt10.dim2.val
      endif
    endif
  endif

  --<k.pleschner>Apr06 modify Dim1 and Dim2 to reflect INSIDE/OUTSIDE build style when method is CLEARANCE or CURSOR
  if !buildStyleNew.eq('OUTSIDE').and(!method.eq('CURSOR').or(!method.eq('CLEARANCE'))) then
    !!mdsFt10.dim1.val = !!mdsFt10.dim1.val + !d35
    !!mdsFt10.dim2.val = !!mdsFt10.dim2.val + !d35
  endif

  -- Copy weld locally
  !copyWelds = object MDSWELDLIST(!!ce,!form)

  -- reset :mdsancref attributes if set
  !support.plateconns.restoreconns()

  -- restore compensation
  -- We only need to restore the compensations if were re creating the framework by e.g. cursor, and not when were cancelling the form.
  -- The global variable !!cancellingForm is set in !!mdsRestoreForm as this was the only way to do the check
  if defined(!!cancellingForm) then
    if !!cancellingForm.not() then
      !!mdsCompplateDflts.compensatingPlates(!complates)
    endif
  else
    !!mdsCompplateDflts.compensatingPlates(!complates)
  endif

  --<kp>mar07 Handle snipes
  !!mdsSnipe(!support.stru)

  ---------------------------------------------------------------------------------------------------
  --<wd>aug2007<mds12>
  -- Update the MDSSCTN and MDSFITTING Objects to the latest DATA in the MDSSUPPORT object member .mdssctns,
  -- i.e. !form.support.mdsctns, where any MDS SNIPES(FITTINGS) exist on the MDS SUPPORT SCTNS where the GTYP of CATREF is 'ANG'
  -- and the MDS SNIPE/FITTING element PURPOSE attribute is set to 'XGUI'
  --
  -- ALL OTHER MDS SNIPES are generated automatically or from the MDS TEMPLATE during the MDS STRUCTURE creation/modification.
  -- ** NOTE ** The SNIPE UPDATE applies to ALL METHODS(!method) of Creation,
  -- i.e. 'CREATE by CURSOR/DIMENSION/CLEARANCE and RESIZING of the MDS TEMPLATE
  !!mdsrestoresnipe(!form, 'DIMENSION')

  -- REGENERATE the DATA stored in the FORM MDSSUPPORT object member "!form.support.mdssctns"
  -- for ALL of the MDS Support SCTNS and ALL the associated MDS SNIPE(FITTING) members
  !!mdssupportsctns(!form)
  --<wd>aug2007<mds12>
  ---------------------------------------------------------------------------------------------------

  !!ce = !support.stru

  -- adjust ancillary welds to suit the beams they sit on
  !!mdsWeldAdjust(!!mdsFt10)

  -- Store dimensions in design parameters
  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  DESPAR $!!mdsFt10.dim1.val   $!!mdsFt10.dim2.val   $!!mdsFt10.dim3.val
  !!mdsDacControl(FALSE)

  -- Show dimensions on graphics if required

  if !!mdsFt10.graphicalDim then
    !!mdsshowdim(!!mdsFt10)
  endif

  --<dw>sep2007 Restore bracing
  !!mdsrestorebracing(!form)
  --<dw>sep2007

  !!ce = !support.stru

  --<.pleschner>Apr06 Message displayed if buildstyle has changed
  if !buildStyle.neq(!buildStyleNew).and(!struIsOld) then
    refresh
    !!alert.warning('Building style of the support has been changed - check Dimension 1')
  endif
$(
  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  --<wd>jun2007<mds12>
  -- Create the Cross Reference ASSOCIATIONS between the MDS SUPPORT SCTN members $!name-V1 and $!name-BAR-1
  -- and the Main Structure supporting elements for:
  -- <a> CURSOR mode !pick1 and !pick2 -- or -- <b> CLEARANCE mode !pick3
  --
  -- Store the Original Current Element
  !xce = !!ce

  -- Store the Array of MDS Support Members in the MDSASSOC Object
  !mdsassoc.mdsmember[1] = $!name-V1
  !mdsassoc.mdsmember[2] = $!name-BAR-1

  -- Initialising the MDSASSOWL object always DELETES ALL of the EXISTING Cross Reference Associations
  -- (ASSOC) elements for the Current MDS Support, irrespective of the Creation MODE (!method)
  !mdsassowl = object MDSASSOWL(!form)
  !mdsassowl.mdsform  = !form
  !mdsassowl.mdsassoc = !mdsassoc

  -- Create the Association (ASSOCs) for the Current Support
  !mdsassowl.mdsassoc(!mdsassoc)

  -- Update the FORM SUPPORT object to reference the current MDSASSOWL Associations object
  !form.support.associations[1] = !mdsassowl
  !support = !form.support

  -- Navigate back to the Original Current Element
  !!ce = !xce

  --<wd>jun2007<mds12>
  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
$)

  --<kp>jan2012 MDS associations
  !form.support.associations(!picks)

  !support = !form.support

  -- Add pads if automatic pads option is on and a PANE or HPLATE has been picked
  if !!mdsOptions.autopads.selection().eq('ON') then
    !whichVerticals = 'ALL'
    if !method.eq('CURSOR') and (!pick1.hardType.eq('PANE') or !pick1.hardType.eq('HPLATE') or !pick2.hardType.eq('PANE') or !pick2.hardType.eq('HPLATE')) then
      !!mdsaddpad(!support,!whichVerticals)
    elseif !method.eq('CLEARANCE') and (!pick3.hardType.eq('PANE') or !pick3.hardType.eq('HPLATE')) then
      !!mdsaddpad(!support,!whichVerticals)
    elseif !method.eq('DIMENSION') and !padsExist then
      !!mdsaddpad(!support,!whichVerticals)
    endif
  endif

  !!ce = !support.stru

  --<kp>jan2012
  -- Enhance elements
  !support.enhance(on)

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- End function
endfunction
