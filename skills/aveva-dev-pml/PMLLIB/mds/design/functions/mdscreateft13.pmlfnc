--------------------------------------------------------------------------------
--
-- File:      mdscreateft13.pmlfnc
-- Type:      Function Definition
-- Group:     Multi Discipline Supports Application
-- Keyword:   MDS
-- Module:    design
-- Replaces:  MPS137
--
-- Author:    I.osborne
-- Created:   Wed Jul 16
--
--
-- Description:
-- function to create support frame type 13
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCreateFt13(!method is STRING)

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise variables

  --<wd>may2007<mds12>
  --  !iDType = 'GENSEC SCTN PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL'
  !session  = current session
  if !session.module().upcase().match('DESIGN').gt(0) then
    !iDType = 'GENSEC SCTN PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL '
  elseif  !session.module().upcase().match('OUTFITTING').gt(0) then
    !iDType = 'GENSEC SCTN PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL HSTIFF HPLATE'
  endif
  --<wd>may2007<mds12>

  !support   = !!mdsFt13.support
  --!clearance = !!mdsOptions.clear.val
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !slide     = !!mdsFt13.slide.selection('Rtext')
  !datum     = !support.datum
  !stru      = !support.stru
  !name      = !stru.name
  !p10Dir    = !support.p10Dir
  !p11Dir    = !support.p11Dir
  !pLDir     = !support.pLDir
  !pADir     = !support.pADir
  !alias     = !support.alias
  --<k.pleschner>May06
  !datumDflts = object MDSANCGEOMDFLTS(!datum)
  !clearance = !datumDflts.cend
  --<k.pleschner>May06

  var !pjoiColl coll all pjoi with gtyp eq 'APAD' for $!stru
  if !pjoiColl.size().neq(0) then
    !padsExist = TRUE
  else
    !padsExist = FALSE
  endif

  -- Does the support have attached/Associated supports

  if !!mdsgetconnectedsupp(!stru) then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  --<wd>jun2001 - Config used For Joint Creation Identification
  -- Store value in datum atta :MDSCp1 attribute

  if (!slide.eq('MID')) then
    !support.config = 0
  elseif (!slide.eq('FRONT')) then
    !support.config = 4
  elseif (!slide.eq('BACK')) then
    !support.config = 5
  endif
  --<wd>jun2001

  ----------------------------- **** connexions **** -----------------------------

  --!refe = !!ce
  !form = !!mdsFt13

  --<kp>jan2012 MDS associations
  !picks = ARRAY()

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru

  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  --!haveJoints = FALSE

  ---------------------------------------------------------------------------------

  -- Check that Datum atta has been created

  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Check that Datum atta has been positioned

  if (!support.position.not())then
    !!alert.message('Position atta before identifying supporting steelwork')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- store compensations
  !complates = !!mdsCompplateDflts.compensatingPlates(!form)

  -- Check which attas to work from
  if (!support.bars.size() leq 1)then
    !atta = !support.atta
  else
    !atta = !support.bars[1]
  endif

  -- Set initial orientation
  !dDir = D wrt world
  !udir = U wrt world

  -- Store section name and matref for each member
  -- for resetting later

  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)

  -- Generate pin positions for each creation type

  if (!method eq |CURSOR|)then

    !errorMessage = STRING()
    if(!!mdsCheckConns(!form, !errorMessage).eq('UNJOINTED')) then
      -- nothing to do
    elseif(!!mdsCheckConns(!form, !errorMessage).eq('WARNING')) then
      !continue = !!alert.confirm(!errorMessage)
      if(!continue.eq('NO')) then
        return
      else
        !!mdsSelectJoints(!form,'DISCONNECT','')
        !support.joints.clear()
      endif
    elseif(!!mdsCheckConns(!form, !errorMessage).eq('ERROR')) then
      !!alert.error(!errorMessage)
      !!kRestoreUnits(!currentUnits)
      return
    else
      -- continue
      !!mdsSelectJoints(!form,'DISCONNECT','')
      !support.joints.clear()
    endif

    label /Element1

    !pick = !support.singlePick(!iDType,'Identify element to support from')
    if !pick.unset() then
      !!ce = !stru
      !!kRestoreUnits(!currentUnits)
      return
    endif

    !testCe = !!mdsRelToDatum(!datum, !pick, !p10Dir, !clearance.real())
    if (!testCe[1].upcase() eq 'UNSET')then
      !!alert.error('Identified element is unsuitable to support from.')
      golabel /Element1
    elseif (!testCe[1].upcase() eq '')then
      golabel /Element1
    elseif (!testCe[1].upcase() eq 'EQUAL')then
      !!alert.error('Identified element is in line with the datum atta')
      golabel /Element1
    elseif (!testCe[1].upcase() eq 'ABOVE')then
      !columnDir  = !p11Dir
      !freeEndDir = !p10Dir
      !support.rotateCur = true
    elseif (!testCe[1].upcase() eq 'BELOW')then
      !columnDir  = !p10Dir
      !freeEndDir = !p11Dir
      !support.rotateCur = false
    endif

    --<wd>may2007<mds12>
    --    if (!pick.hardType eq 'PANE') then
    if (!pick.hardType eq 'PANE') or (!pick.hardType eq 'HPLATE') then
      --<wd>may2007<mds12>

      !plane = !testCe[2]
      --VAR !pDir CONST DIR $!plane
    endif

    !!mdsCreateMess(true)

    -- Position Pins
    !!ce = !pick

    -- Connection to element picked
    PIN 8 AT P9 of $!datum
    PIN 8 DIR $!columnDir
    VAR !pin8Pos PIN 8 POS WRT WORLD

    --<wd>may2007<mds12>
    --    if (!pick.hardType eq 'PANE') then
    if (!pick.hardType eq 'PANE') or (!pick.hardType eq 'HPLATE') then
      --<wd>may2007<mds12>

      VAR !tempInter CONS POS INT PIN 8 $!plane
      !inter = !tempInter.position()
      -- Reset Slide gadget if required (pureley cosmetic)
      if (!slide ne 'MID')then
        !!mdsFt13.slide.select('RTEXT', 'MID')
        !slide = 'MID'
      endif

      --<wd>may2007<mds12>
      --    elseif (!pick.type eq 'SCTN' or !pick.type.eq('STWALL') or !pick.type.eq('GENSEC')) then
    elseif (!pick.type eq 'SCTN' or !pick.type.eq('STWALL') or !pick.type.eq('GENSEC') or !pick.type.eq('HSTIFF')) then
      --<wd>may2007<mds12>

      ------------------- ***** Connexions *****-------------------
      !support.connections[1] = !pick
      !support.connections[2] = !pick
      !inter = !!kFlangeOrWeb(!pick, !pin8Pos.position(), !columnDir)

    endif

    --<kp>jan2012 Store pick for association
    !picks[1] = !pick

    PIN 9 AT $!inter
    PIN 9 DIR $!columnDir
    -- pin 9 plane pin 9 thro $!datum
    if (!slide ne 'MID')then
      -- !!ce = $!<name>-BAR-1
      pin 9 plane pin 9 clear 0 inf $!pick
      pin 9 dist 150mm
    endif

    -- Free end

    PIN 8 DIR $!freeEndDir
    PIN 4 copy PIN 8
    !dim = 0
    --<k.pleschner>May06
    --do !i values !atta
    do !iref values !atta
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)

      --PIN 4 plane PIN 4 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 4 plane PIN 4 CLEAR $!i.oend BEH $!i
      else
        -- use distance from centreline
        PIN 4 plane PIN 4 THR $!i
        PIN 4 plane PIN 4 DIST $!i.oend
      endif
      handle (2,109)
        break
      endhandle
      VAR !cDIR CONST DIR PIN 8 TO PIN 4
      !cdim = !!kStrReal('CONST DIST PIN 8 TO PIN 4')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cDIR.direction()
      !direction.directionB = !freeEndDir
      !direction.tolerance  = 0.05

      if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 4 AT PIN 8
        PIN 4 DIST $!cdim
        !dim = !cdim
      else
        PIN 4 AT PIN 8
        PIN 4 DIST $!dim
      endif
    enddo

  elseif (!method eq |DIMENSION|)then

    -- Initialise variables for dimension check
    !d1 = !!mdsFt13.dim1.val
    !d2 = !!mdsFt13.dim2.val

    if (!d1.eq(0) or !d2.eq(0)) then
      !!alert.error('Not all of the dimensions have been completed.')
      !!kRestoreUnits(!currentUnits)
      return
    endif

    if (!d1.gt(!d2)) then
      !!alert.error('Cannot create from given dimensions. Dim 1 must be less that Dim 2.')
      !!kRestoreUnits(!currentUnits)
      return
    endif

    !!mdsCreateMess(true)

    -- Get correct orientation
    if (!support.rotateCur)then
      !columnDir  = !p11Dir
      !freeEndDir = !p10Dir
    else
      !columnDir  = !p10Dir
      !freeEndDir = !p11Dir
    endif

    -- Position pins

    !!ce = !datum
    PIN 9 COPY P9
    PIN 9 DIR $!columnDir
    PIN 8 COPY PIN9
    PIN 8 DIR $!freeEndDir

    PIN 9 plane PIN 9 THRO CE
    PIN 8 plane PIN 8 THRO CE
    PIN 9 DIST $!d1
    PIN 4 COPY PIN 8
    PIN 4 DIST ($!d2 - $!d1)

  endif

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  -- Create and ARRAY of Attas with Packing Pieces (PDMS Names ONLY)
  -- and the Type and Size of the Packing Pieces to Recreate
  !attapp = !!mdspackers(!support)

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  !!ce = !stru
  --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
  !!mdsRemoveAutoPadRules(!stru)
  --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end

  -- Pins now in position create framework

  delete STRU MEM
  handle (41,66) (2,113) (2,113)
  endhandle

  --<wd>oct2000
  !mdstemp = /MDS/$!alias/$!selection
  :mdscheck $!mdstemp.:mdscheck
  :mdsframirror $!mdstemp.:mdsframirror

  --<wd>oct2000

  --<wd>feb2004
  -- Position the MDS STRU
  --AT $!datum
  if (!datum.styp inset ('AT60')) then
    at p9 of $!datum
  else
    at $!datum
  endif
  --<wd>feb2004

  NEW FRMW $!name/MAIN
  !frmwSupport = !!ce

  -- Copy required template/s
  !!ce = /MDS/$!alias/$!selection
  !subs = !!kCollectAllFor('SUBS', '', !!ce)
  !frmw = !!kCollectAllFor('FRMW', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')

  -- Navigate back to support and create template elements
  !!ce = !frmwSupport
  COPY ATTRIB OF $!frmw[1]
  COPY MEM OF $!frmw[1] RENAME $!frameFormat $!name
  do !i indices !subs
    NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
    COPY MEM OF $!subs[$!i] RENAME $!frameFormat $!name
  enddo

  -- Get direction of P9 of datum atta and dist between p9 and p0

  !!ce = !stru

  -- Set stru description for template recognition

  !desc = desc of /MDS/$!alias/$!selection
  !mdsBars = :mdsbars of /MDS/$!alias/$!selection
  desc '$!desc'
  :MdsBars $!mdsBars

  MOVE $!dDir THRO P9 OF $!datum
  --<wd>20may2004
  if !datum.:mdsguideref.set() and !datum.:mdsguideref.badref().not() then
    !mdsGuideRef = !datum.:mdsguideref
    -- Do NOT Move the STRU if the GUIDE is a TRUNNION GUIDE/STOP etc...
    if (!datum.catref.owner.:mdstrun.not()) then
      MOVE $!dDir thro p9 of $!mdsGuideRef
    endif
  endif
  --<wd>20may2004


  !oRIX = !freeEndDir
  !oRIZ = !udir

  ORI X IS $!oRIX AND Z IS $!oRIZ

  -- If a trunnion is added to a support then we need to store the direction in a
  -- uda for later use

  var !oriFrame dir y wrt /*
  :MdsFrameDir $!oriFrame

  -- Get Distance from datum to end of cross bar
  !dIST = !!kStrReal('CONST DIST PIN 8 TO PIN 4')

  -- move steelplate of FT68
  if !alias.eq('FT68') then
    !!ce = $!<name>-PLT1
    move $!freeEndDir clear behind pin9
    !plthk = !!ce.lohe
    !plate = !!ce
  endif

  -- Extend and move cross bar
  !!ce = $!<name>-BAR-1
  MOVE $!freeEndDir DIST $!dIST
  -- <ge 14/06/04> to handle pnode
  !joiendpnode = !!ce.jOIEND
  $!joiendpnode
  handle NONE
    Delposition E 0mm N 0mm U 0mm
    !!ce = $!<name>-BAR-1
    $!!ce
  elsehandle ANY
  endhandle
  -- end of pnode handle
  !overlap = :MDSOlap
  if !overlap eq 'OVERLAP' and !method neq 'DIMENSION' then
    if (!slide ne 'MID')then
      !onum = :MDSOnum
      pin 9 dist -150mm
      pin 9 dist $!onum
    endif
  endif
  EXTEND END THRO PIN 9
  var !pin7pos pin 9 pos wrt /*

  -- trim end of FT68
  if !alias.eq('FT68') then
    extend end -$!plthk
  endif

  ----------------------- ****** connexions ******* --------------------
  --if(!support.connections.unset()) then
  if(!support.connections.set().not()) then
    -- dimensions are being used first
    :MDSConn default
  else
    --!bar1 = !!ce
    --!connected = !!mdsGetBeamConn(!support,!bar1)
    !!ce.:MDSConn = !support.connections[1]
    handle ANY
    endhandle
  endif
  ---------------------------********************-----------------------

  -- Extend and move bracing
  !!ce = $!<name>-V1
  if !alias.eq('FT68') then
    move $!freeEndDir clear behind $!plate
  else
    MOVE $!freeEndDir DIST $!dIST
    MOVE $!freeEndDir thro pin 4
  endif

  -- Set dimensions

  if (!method eq |CURSOR|)then

    -- Dimension 1
    !dim1 = !!kStrReal('CONST DIST PIN 9 TO PIN 8')
    !!mdsFt13.dim1.val = !dim1

    -- Dimension 2

    !dim2 = !!kStrReal('CONST DIST PIN 9 TO PIN 4')
    !!mdsFt13.dim2.val = !dim2

  endif

  if !alias.neq('FT68') then
    if !method.eq('DIMENSION') then
      MOVE $!freeEndDir dist -$!!mdsFt13.dim3.val
    else
      !!mdsFt13.dim3.val = !!mdsFt13.dim2.val - !!mdsFt13.dim1.val
      -- !!mdsFt13.dim3.val = !d2 - !d1
      MOVE $!freeEndDir dist -$!!mdsFt13.dim3.val
    endif
    EXTEND END plane $!columnDir THRO PIN 9
  endif

  ------------------****** connections *******----------------------
  if(!support.connections.set().not()) then
    -- dimensions are being used first
    :MDSConn default
  else
    --!vertical1 = !!ce
    --!connected = !!mdsGetBeamConn(!support,!vertical1)
    !!ce.:MDSConn = !support.connections[1]
    handle any
    endhandle
  endif

  -- Move stiffeners if type ft13
  if !alias.eq('FT13') then
    !!ce = $!<name>/SUBS1
    handle none
      MOVE $!freeEndDir DIST $!dIST
    elsehandle any
    endhandle
  endif


  -- Select correct spref

  !!ce = $!<name>/SREF
  !!mdsDacControl(true)

  if !alias.eq('FT13') then
    SEL SPREF WITH STYP '$!alias-A-$!selection' SPEC /MDF
    !!mdsSetSuppCode('MODIFY',!name,'$!alias','$!alias-A-1')
  elseif !alias.eq('FT68') then
    sel spref with styp 'FT68-1-$!selection' spec /MDF
    !!mdsSetSuppCode('MODIFY',!name,'FT68','FT68-1-1')
  elseif !alias.eq('FT39') then
    SEL SPREF WITH STYP '$!alias-$!selection' SPEC /MDF
    !!mdsSetSuppCode('MODIFY',!name,'$!alias','$!alias-1')
  endif

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)
  !!mdsDacControl(true)
  !!ce = !stru

  -- Associate attas to bar

  !list = !support.bars[1]
  !references = ''
  do !i indices !list
    !references = !references & ' ' & !list[!i].string()
  enddo

  -- Set atta references to datum cross bar
  !!ce = $!<name>-BAR-1
  :MDSAttaRef $!references
  !support.barLen[1] = deri length of CE

  -- Check to see if support is mirrored
  !!ce = !stru
  if (!support.mirror)then
    call !!mdsMirrorFt13()

    -- Update form directly and not variable support as the slide function
    -- may need to use this information.
    !!mdsFt13.support.mirror = true
    --      !support.mirror = true
  endif


  -- Adjust for slope on horizontal lines only
  if (!pADir neq !udir and !pLDir neq !udir)then
    -- Check to see if the line is sloping

    !adjust = 0
    do !v values !atta
      !!ce = !v
      skip if !!ce.:mdsrotdir.east.set()
      !grad = pl grad
      if (!grad.neq(0))then
        !strucElement = ARRAY()
        !ref = $!name-BAR-1
        !strucElement.append(!ref)
        !vHeight = !!mdsAdjustSlope(!strucElement, !v)
      else
        !vHeight = 0
      endif
      if (!vHeight gt !adjust)then
        !adjust = !vHeight
      endif
    enddo

    if (!adjust.neq(0))then
      -- Adjust required elements
      !!ce = $!<name>-BAR-1
      MOVE D WRT WORLD DIST $!adjust
      !!ce = $!<name>-V1
      MOVE D WRT WORLD DIST $!adjust
      !!ce = $!<name>/SUBS1
      handle none
        if !alias.eq('FT13') then
          MOVE D WRT WORLD DIST $!adjust
        endif
      elsehandle any
      endhandle
    endif
  endif

  !!ce = $!<name>/SREF

  !!mdsDacControl(true)

  -- Despar 3 will store the dim3 only of FT39
  -- The largest bore on the pipe will need to be stored in despar 4 for
  -- the code

  if !alias.eq('FT13') then
    DESPAR $!!mdsFt13.dim1.val  $!!mdsFt13.dim2.val   $!!mdsFt13.dim3.val
  else
    !despar3 = !!mdsFt13.dim3.val
    !despar4 = despar 4
    if !despar4.unset() then
      !despar4[1] = 0
    endif
    DESPAR $!!mdsFt13.dim1.val  $!!mdsFt13.dim2.val  $!despar3  $!despar4[1]
    !!mdsFt13.dim3.val = $!despar3
    !largestBore = object BORE()
    !largestBore = !support.datum.abore
    do !loop values !!mdsFt13.support.atta
      !largestBore = !loop.abore
      if !loop.abore.gt(!largestBore) then
        !largestBore = !loop.abore
      endif
    enddo
    -- Only set the largest bore if greater than the bore already stored
    !isNow = despara 4
    if !largestBore.real().lt(!isNow[1]) then
      !largestBore = !isNow[1].bore()
    endif
    DESPAR $!!mdsFt13.dim1.val   $!!mdsFt13.dim2.val   $!despar3  $!largestBore
  endif

  ------------------------------------------------------------------------------------------------------
  --<wd>nov2003>>>
  !!mdsDacControl(true)
  -- Check if ATTAS Created on The Support are Within the Allowable Bores for the STRUCTURE SCTN SIZES.
  !cecomp = !!ce
  !error  = STRING()
  if (!!mdscheckbores(!form,!selection,!error,!currentUnits)) then
    !!alert.error(!error)
    !!ce = !stru
    --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
    !!mdsRemoveAutoPadRules(!stru)
    --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end
    delete STRU MEM
    handle (41,66) (2,113) (2,113)
    endhandle
    -- Reset SREF Despars to ZERO as the STRU MEM have been DELETED
    !!ce = $!<name>/SREF
    handle none
      -- Only RESET the DESPARS for the DIMENSION GADGETS -
      -- DESPAR num 4 stores the LARGEST PIPE BORE SIZE on the SUPPORT and is still VALID
      desp num 1 0mm
      desp num 2 0mm
      desp num 3 0mm
    elsehandle any
    endhandle
    -- Reset all pins associated with this support
    !!mdsResetPins(1,9)
    !!ce = !cecomp
    handle any
    endhandle
    !!mdsCreateMess(false)
    !!kRestoreUnits(!currentUnits)
    return
  endif
  --<wd>nov2003<<<
  ------------------------------------------------------------------------------------------------------


  !!mdsDacControl(false)

  -- Reset materials of sections

  !!mdsResetMat(!storeMat)

  !!ce = !stru

  -- Move Support to correct position relative to the supporting structure

  if (!method eq 'CURSOR')then

    --<wd>may2007<mds12>
    --      if (!pick.type eq 'SCTN') or !pick.type.eq('GENSEC')then
    if (!pick.type eq 'SCTN') or !pick.type.eq('GENSEC') or !pick.type.eq('HSTIFF') then
      --<wd>may2007<mds12>

      if (!pADir neq !udir and !pLDir neq !udir)then
        call !!mdsSlideFt13(!slide, !pick)
      endif

      -- Select correct spref for this configuration
      !!ce = $!<name>/SREF
      !!mdsDacControl(true)
      if !alias.eq('FT13') then
        SEL SPREF WITH STYP 'FT13-D-$!selection' SPEC /MDF
      elseif !alias.eq('FT68') then
        sel spref with styp 'FT68-1-$!selection' spec /MDF
      else
        SEL SPREF WITH STYP 'FT39-$!selection' SPEC /MDF
      endif
      !!mdsDacControl(false)
      !!ce = !stru
    endif

    if !alias.neq('FT68') then
      -- Extend ends
      !!ce = $!<name>-BAR-1
      pin 7 at $!pin7pos wrt /*
      if (!support.mirror)then
        extend start thro pin 7
      else
        extend end thro pin 7
      endif
      !!ce = $!<name>-V1
      if (!support.mirror)then
        extend start plane $!p10Dir thro pin 7
      else
        extend end plane $!p10Dir thro pin 7
      endif
    endif
  endif

  !!ce = !stru

  -- Set :MDSOrigin at stru level to tell draft how the support is welded/connected

  :MDSOrigin '$!!mdsFt13.slide'

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  -- Set 'FT25' form Support Object to be the same as 'FT13' form Support Object
  !!mdsFt25.support = !support

  -- Clear packs from 'BOTH forms' Support Objects as the SCTNs have already been deleted
  -- During the Framework Creation above
  !!mdsFt25.support.packs.clear()
  !support.packs.clear()

  -- Create Required Packing Pieces(SCTNs) at the Necessary Attas
  call !!mdscrpacksft25(!attapp, !!mdsFt13)

  -- Update 'FT13' support.packs data to that held in form 'FT25'
  !support.packs = !!mdsFt25.support.packs

  -- Navigate to Main Structure of Framework
  !!ce = !stru

  -- If the creation is by cursor and before or after column. Move bracing onto
  -- column

  if !!mdsFt13.slide.val gt 1 and !method eq 'CURSOR' then
    !!ce = $!<name>-V1
    pin 6 copy pin 5
    pin 7 copy pin 5
    pin 6 plane pin 6 thro $!<name>/DATUM
    pin 7 plane pin 7 thro $!pick
    var !pin7dir const dir pin 7 to pin 6
    pin 6 dir $!pin7dir wrt /*
    pin 7 dir $!pin7dir wrt /*
    pin 6 plane pin 6 clear 0 beh $!pick
    move $!pin7dir wrt /* clear 0 beh pin 6
  endif

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  -- If a joint is being used and it is handed then their will be a alternative spref of the
  -- opposite hand joint and the bang to set separated by a ,

  !!mdsSwapIntJoi(!support.stru,!support.mirror,!support.alias)

  -- Navigate to Main Structure of Framework
  !!ce = !stru

  -- Position plate only if FT39
  if !alias.eq('FT39') then
    !!ce = $!<name>/SUBS1
    handle none
      if !support.mirror then
        MOVE $!freeEndDir thro pose of $!<name>-BAR-1
        MOVE $!freeEndDir dist -16mm
      else
        MOVE $!freeEndDir thro poss of $!<name>-BAR-1
        MOVE $!freeEndDir dist -16mm
      endif
    elsehandle any
    endhandle
  endif

  -- Reposition brace for FT39 only
  if !alias.eq('FT39') then
    snod 1 of $!<name>-BAR-1
    handle none
      if !support.mirror then
        if !support.rotateCur then
          zdist 300mm
        else
          zdist 300mm from end
        endif
      else
        if !support.rotateCur then
          zdist 300mm from end
        else
          zdist 300mm
        endif
      endif
    elsehandle any
    endhandle
  endif

  -- Reset all pins associated with this support
  call !!mdsResetPins(1,9)

  -- Update support data held in form
  !!mdsFt13.support = !support

  !!mdsCreateMess(false)

  -- For vertical pipes make sure members are infront of the 9 of the datum
  !iamHere = !!ce
  if !datum.adir.wrt(/* ).string().eq('U WRT /*') or !datum.adir.wrt(/* ).string().eq('D WRT /*') or !datum.adir.wrt(/* ).string().eq('Z WRT /*') or !datum.adir.wrt(/* ).string().eq('-Z WRT /*') then
    Stru
    var !sctns coll all sctn with matchwild(name,'*BAR*') for ce
    !p9dir = p9 dir of $!support.datum
    pin 8 copy p9 of $!support.datum
    pin 7 copy pin 8
    do !movesctns values !sctns
      !!ce = !movesctns.dbref()
      pin 7 plane pin 7 clear 0 inf ce
      move $!p9dir clear 0 beh p9 of $!support.datum
      pin 8 plane pin 8 clear 0 inf ce
    enddo
    --var !moved const dist pin 8 to pin 7
    stru
    var !sctnsv coll all sctn with matchwild(name,'*-V*') for ce
    do !movesctnsv values !sctnsv
      !!ce = !movesctnsv.dbref()
      --pin 7 plane pin 7 clear 0 inf ce
      --move $!p9dir clear 0 beh p9 of $!support.datum
      --pin 8 plane pin 8 clear 0 inf ce
      --move $!p9dir $!moved
    enddo

    -- GE added 12/01/05
    -- Need to execute design rules and recon

    !desc = desc of /MDS/TEMPLATES
    handle ANY
      !desc = ''
    endhandle
    if !desc.eq('Zimmer Templates') then
      var !coll coll all pnod for stru
      do !a values !coll
        $!a
        rule execute all
      enddo
      stru
    endif
    -- eof

    --if (!support.rotateCur.not()) then
    reconn recalc
    --endif
    pin 7 off
    pin 8 off
  endif
  !!ce = !iamHere

  -- Reset all pins associated with this support
  call !!mdsResetPins(1,10)

  --dtf end

  -- Does the item require bearing plates (Framatome Only)

  !!ce = !support.stru
  !!mdsAddBearing(!support.datum)
  !!ce = !support.stru

  if !method.neq('DIMENSION').and(!alias.neq('FT68')) then

    if !columnDir.eq(!p10Dir) then
      !pNum = 2
    else
      !pNum = 3
    endif

    !!mdsFt13.dim1.val = !!mdsgetoverdim($!datum , $!name-BAR-1 , !pNum)
    !!mdsFt13.dim2.val = !!mdsFt13.dim1.val + !!mdsFt13.dim3.val
    if (!!mdsFt13.dim1.val eq !!mdsFt13.dim3.val) then
      !!mdsFt13.dim1.val = !!mdsgetoverdim($!datum , $!name-BAR-1 ,2)
      !!mdsFt13.dim2.val = !!mdsFt13.dim1.val + !!mdsFt13.dim3.val
    endif
  endif


  -- Copy weld locally

  !unusedCopyWelds = object MDSWELDLIST(!!ce,!form)
  !!ce = !support.stru

  -- reset :mdsancref attributes if set
  !support.plateconns.restoreconns()

  -- adjust ancillary welds to suit the beams they sit on
  !!mdsWeldAdjust(!!mdsFt13)

  -- restore compensation
  -- We only need to restore the compensations if were re creating the framework by e.g. cursor, and not when were cancelling the form.
  -- The global variable !!cancellingForm is set in !!mdsRestoreForm as this was the only way to do the check
  if defined(!!cancellingForm) then
    if !!cancellingForm.not() then
      !!mdsCompplateDflts.compensatingPlates(!complates)
    endif
  else
    !!mdsCompplateDflts.compensatingPlates(!complates)
  endif

  !ce = !!ce
  frmw 1
  pjoi 1 of pnod 1
  handle ANY
  elsehandle NONE
    delp n0
  endhandle
  !!ce = !ce

  -- Show dimensions on graphics if required

  if !!mdsFt13.graphicalDim then
    !!mdsshowdim(!!mdsFt13)
  endif

  !!ce = !support.stru

  --<kp>jan2012 MDS associations
  !form.support.associations(!picks)

  !support = !form.support
  -- Add pads if automatic pads option is on and a PANE or HPLATE has been picked
  if !!mdsOptions.autopads.selection().eq('ON') then
    !whichVerticals = 'ALL'
    if !method.eq('CURSOR') or !method.eq('CLEARANCE') then
      if !pick.hardType.eq('PANE') or !pick.hardType.eq('HPLATE') then
        !!mdsaddpad(!support,!whichVerticals)
      endif
    elseif !method.eq('DIMENSION') and !padsExist then
      !!mdsaddpad(!support,!whichVerticals)
    endif
  endif

  !!ce = !support.stru

  --<kp>jan2012
  -- Enhance elements
  !support.enhance(on)

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- End function
endfunction
