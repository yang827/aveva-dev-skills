--------------------------------------------------------------------------------
--
-- File:    mdscreateft19.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MPS143
--
-- Author:  Wayne Dodwell
-- Created:  Monday 15 September 1997
--
--
-- Description:
-- function to create support frame type 19
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCreateFt19(!method is STRING)

  -- Find current units and set the distance unit to metric
  !currentunits = !!kGetSetUnits()

  -- Initialise variables
  call !!mdsResetPins(1,9)
  !support    = !!mdsFT19.support
  !config     = !support.config
  --<wd>may2007<mds12>
  --    if (!config.eq(4))then
  --      !iDType = 'GENSEC SCTN'
  --    else
  --      !iDType = 'GENSEC SCTN PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX'
  --    endif
  !session   = current session
  if !session.module().upcase().match('DESIGN').gt(0) then
    if (!config eq 4)then
      !iDType = 'GENSEC SCTN'
    else
      !iDType = 'GENSEC SCTN PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX'
    endif
  elseif  !session.module().upcase().match('OUTFITTING').gt(0) then
    if (!config eq 4)then
      !iDType = 'GENSEC SCTN HSTIFF'
    else
      !iDType = 'GENSEC SCTN PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX HSTIFF HPLATE'
    endif
  endif
  --<wd>may2007<mds12>
  --!clearance  = !!mdsOptions.clear.val
  !overlap    = !!mdsOptions.overlap.val
  --!selection  = !!mdsFT19.size.selection('Rtext')
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !datum      = !support.datum
  !stru       = !support.stru
  !name       = !stru.name
  !p10Dir     = !support.p10Dir
  !p11Dir     = !support.p11Dir
  !alias      = !support.alias

  --<k.pleschner>Jun06
  !datumDflts = object MDSANCGEOMDFLTS(!datum)
  !clearance = !datumDflts.oend
  !dim1IsZero  = !!mdsFT19.dim1.val.int().boolean().not()
  --<k.pleschner>

  var !pjoiColl coll all pjoi with gtyp eq 'APAD' for $!stru
  if !pjoiColl.size().neq(0) then
    !padsExist = TRUE
  else
    !padsExist = FALSE
  endif

  -- Does the support have attached/Associated supports
  if !!mdsgetconnectedsupp(!stru) then
    !!kRestoreUnits(!currentunits)
    return
  endif

  !tempdesc = desc of /MDS/TEMPLATES
  handle ANY
    !tempdesc = ''
  endhandle

  ----------------------------- **** connexions **** -----------------------------
  !refe         = !!ce
  !form      = !!mdsFT19

  --<wd>jun2007<mds12>
  -- Initialise the MDS Associations Data Creation Object MDSASSOC
  !mdsassoc = object MDSASSOC()
  !mdsassoc.mode = !method
  --<wd>jun2007<mds12>
  -- Can we write to the spref attribute of the SREF atta and the stru
  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentunits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  !haveJoints = FALSE
  if(!form.support.joints.unset().not()) then
    !joints     = !support.joints
    !attributes = ARRAY()
    !haveJoints = !!kRestoreJoints(!joints,!attributes,'SAVE','')
    handle ANY
      !haveJoints = FALSE
      !support.joints.clear()
      -- in case they have been deleted and cancel is used
    endhandle
  endif
  ---------------------------------------------------------------------------------

  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Check that Datum atta has been positioned
  if (!support.position.not())then
    !!alert.message('Position atta before identifying supporting steelwork')
    !!kRestoreUnits(!currentunits)
    return
  endif

  !noEquiv = FALSE

  -- Evaluate replacement support name for frame type FT19
  if (!alias eq 'FT19') then
    !substitute = trim (before (!!mdsFrame.standard.dtext[!!mdsFrame.standard.rtext.findfirst('FT18')], '-'))
    handle ANY
      !noEquiv = TRUE
      !substitute = 'Identified element is unsuitable to support from'
    endhandle
  elseif (!alias eq 'CT07') then
    !substitute = trim (before (!!mdsCable.standard.dtext[!!mdsCable.standard.rtext.findfirst('CT07')], '-'))
    handle ANY
      !noEquiv = TRUE
      !substitute = 'Identified element is unsuitable to support from'
    endhandle
  endif

  ------------------------------------------------------------------------------------------------------
  --<wd>aug2007<mds12>
  -- ENSURE ALL the current MDS SNIPES(FITTINGS) that EXIST on the current MDS STRUCTURE SCTN elements are STORED,
  -- so "UPDATE" the FORM MDSSUPPORT object member "!form.support.mdssctns" to represent the current MDS STRUCTURE.
  -- *** IMPORTANT*** The object needs to be UPDATED before CREATIIN/MODIFICATION of the MDS STRUCTURE commences,
  -- as ADDITIONAL MDS SNIPES may have been ADDED/MODIFIED/DELETED by the USER since the FORM was initialised,
  -- via the !!mdsSnipe form utility from the MAIN "MDS DESIGN application" BAR menu option... "Modify>Snipe on Angle..."
  --
  -- REGENERATE the DATA stored in the FORM MDSSUPPORT object member "!form.support.mdssctns"
  -- for ALL of the current MDS Support SCTNS and ALL the associated MDS SNIPE(FITTING) members
  !!mdssupportsctns(!form)
  -- UPDATE the local !support object variable with the latest MDSSNIPE DATA
  !support.mdssctns      = !form.support.mdssctns
  !support.mdssctnsstore = !form.support.mdssctnsstore
  --<wd>aug2007<mds12>
  ------------------------------------------------------------------------------------------------------
  -- Check which attas to work from
  if (!support.bars.size().leq(1))then
    !atta = !support.atta
  else
    !atta = !support.bars[1]
  endif

  -------------------------------------------------
  --<wd>nov2004
  -- !dDir and !uDir variables are now always defined from the ACTUAL P9 direction of the DATUM Atta
  --------------------------------------------------------------------------------------------------

$(
  -- Set up Orientation
  if (!config.eq(3) or !config.eq(4))then
    !uDir = !support.p9dir
    VAR !p3P9Dir CONST DIR P3 OF $!datum TO P9 OF $!datum
    !dDir = !p3P9Dir.direction()
  else
    !uDir = d wrt world
    !dDir = u wrt world
  endif
$)

  -- Added nov 2004 - Always read the P9direction for the TRUE !dDir of the DATUM ATTA
  -- on HORIZONTAL and VERTICAL PIPES -- SLOPING PIPES need the TRUE ORTHOGONAL DIRECTIONS

  if (!config.eq(2)) then
    -- This configuration is ONLY allowed on VERTICAL Pipes and the !dDir is ALWAYS "D wrt /* " etc...
    -- The standard MDS/FT18V... STRU templates are used for Config No. 2
    !dDir = u wrt world
    !uDir = d wrt world

    -- Always Set the Support.mirror object member for Config No.2
    if (!support.plDir.up.eq(1)) then
      !support.mirror = FALSE
    else
      !support.mirror = TRUE
    endif
$(
  else
    -- Configuration 1 is for HORIZONTAL & SLOPING Pipes & Configurations 3 and 4 are for use on VERTICAL Pipes ONLY
    -- The standard MDS/FT18H... STRU templates are used for Config Nos. 1,3 and 4
    !uDir = !support.p9dir
    var !p3P9Dir const dir p3 of $!datum to p9 of $!datum
    !dDir = !p3P9Dir.direction()
$)
  endif

  --<wd>nov2004
  -------------------------------------------------

  ----------------------------------------------
  --<wd>nov2004
  -- For Vertical Pipes, Sloping and True Horizontal Pipes
  !directions = !!mdsremovegrad(!datum)
  !support.datumorthdirs = !directions
  !uDir = !directions[3]
  !dDir = !directions[4]

  if (!config.eq(2)) then
    if (!support.rotateCur)then
      var !orix const dir pin 8 to pin 9
      !oriz = !uDir
    else
      var !orix const dir pin 9 to pin 8
      !oriz = !uDir
    endif
  else
    if (!support.rotateCur)then
      !orix = !directions[5]
    else
      !orix = !directions[6]
    endif
    !oriz = !directions[4]
  endif


  -- Check for frame type FT19 configurations form and hide if necessary
  if (!!mdsFT19Configs.shown())then
    !!mdsFT19Configs.hide()
  endif

  -- Store section name and matref for each member
  -- for resetting later

  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)

  -- Generate pin positions for each creation type

  -- Cursor Mode
  -- ***********
  if (!method eq |CURSOR|)then

    if (!config.eq(4))then
      !!alert.error('Cursor Option not available for this configuration')
      !!kRestoreUnits(!currentunits)
      return
    endif
    ------------ *** Connexion Warnings *** -------------
    !errorMessage = STRING()
    !dummyS       = ''

    if(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('UNJOINTED')) then
      -- nothing to do
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('WARNING')) then
      !continue = !!alert.confirm(!errorMessage)
      if(!continue.eq('NO')) then
        !!kRestoreUnits(!currentunits)
        return
      endif
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('ERROR')) then
      !!alert.error(!errorMessage)
      !!kRestoreUnits(!currentunits)
      return
    endif
    ---------------------------------------------
    label /Element1

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify element to support from|
    ID $!iDType @
    handle (61,528)
      PROMPT ON
      !!ce = !stru
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    PROMPT DISMISS
    PROMPT ON
    !pick = !!ce
    !testCE = !!mdsRelToDatum(!datum, !pick, !dDir, !clearance)

    if (!testCE[1].upcase() eq 'UNSET')then
      !!alert.error('Identified element is unsuitable to support from.')
      golabel /Element1
    elseif (!testCE[1].upcase() eq '')then
      golabel /Element1
    endif

    if (!config.eq(3))then
      if (!testCE[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('Identified element is infront pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'Identified element is infront of pipe.')
        endif
        golabel /Element1
      elseif (!testCE[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is in line with the datum atta')
        golabel /Element1
      endif
    else
      if (!testCE[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('Identified element is below pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'Identified element is below pipe.')
        endif
        golabel /Element1
      elseif (!testCE[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is at the same elevation as the datum atta')
        golabel /Element1
      endif
    endif

    --<wd>may2007<mds12>
    --      if (!pick.hardType eq 'PANE' or !pick.type eq 'BOX')then
    if (!pick.hardType eq 'PANE' or !pick.type eq 'BOX' or !pick.type.eq('HPLATE')) then
      --<wd>may2007<mds12>
      !plane = !testCE[2]
      VAR !pDir CONST DIR $!plane
    endif

    -- Check for framework orientation
    if (!support.rotateCur)then
      !toVert   = !p11Dir
      !fromVert = !p10Dir
    else
      !toVert   = !p10Dir
      !fromVert = !p11Dir
    endif

    !!mdsCreateMess(TRUE)

    -- <k.pleschner>Nov06
    -- get suitable orientation of template
    !mdsTmplOri = !!mdsGetTmplOri(!datum,!pick,!pick)
    -- Position Pins
    !!ce = !pick

    -- Check to see if item picked is a bedplate
    --<wd>may2007<mds12>
    --      if (!pick.hardType eq 'PANE' or !pick.type eq 'BOX')then
    if (!pick.hardType eq 'PANE' or !pick.type eq 'BOX' or !pick.type.eq('HPLATE')) then
      --        STRU
      --        !frameType = !!ce.:MDSSuppType
      STRU
      handle NONE
        !frameType = !!ce.:MDSSuppType
      elsehandle ANY
        !frameType = ''
      endhandle
      --<wd>may2007<mds12>
      if (!frameType eq 'FT22')then
        !bedplate = TRUE
        PIN 1 AT $!pick
        PIN 1 DIR $!pDir
        VAR !tempInter CONS POS int PIN 1 $!plane
        !inter = !tempInter.position()

      else

        -- Cursor Mode for PANEL or BOX
        -- ****************************

        -- Position pins clear of attas
        PIN 1 AT P0 of $!datum
        PIN 1 DIR $!toVert
        PIN 2 COPY PIN 1
        !dim = 0

        --<k.pleschner>Jun06
        --do !i values !support.atta
        do !iref values !support.atta
          -- avoid SREF atta
          skip if !iref.name.substring(-1,-5).eq('/SREF')
          !i = object MDSANCGEOMDFLTS(!iref)
          --PIN 2 plane PIN 2 CLEAR $!clearance BEH $!i
          if !i.clge.eq('GEOM') then
            -- use clearance from geometry
            PIN 2 plane PIN 2 CLEAR $!i.oend BEH $!i
          else
            -- use distance from centreline
            PIN 2 plane PIN 2 THR $!i
            PIN 2 plane PIN 2 DIST $!i.oend
          endif
          handle (2,109)
            break
          endhandle
          VAR !cDir CONST DIR PIN 1 TO PIN 2
          !cDim = !!kStrReal('CONST DIST PIN 1 TO PIN 2')

          -- Set object definition
          !direction = object KEQUALDIR()
          !direction.directionA = !cDir.direction()
          !direction.directionB = !toVert
          !direction.tolerance  = 0.05

          if (!cDim.gt(!dim) and !!kDirEqualDir(!direction)) then
            PIN 2 AT $!datum
            PIN 2 DIST $!cDim
            !dim = !cDim
          else
            PIN 2 AT $!datum
            PIN 2 DIST $!dim
          endif
        enddo

        PIN 1 COPY PIN 2
        --          pin 1 at $!datum
        PIN 1 DIR $!uDir
        VAR !tempInter CONS POS int PIN 1 $!plane
        !inter = !tempInter.position()
      endif

      -- start of CURSOR mode SCTN
      -- *************************

      --<wd>may2007<mds12>
      --      elseif (!pick.type eq 'SCTN') or (!pick.hardType eq 'GENSEC') then
    elseif (!pick.type eq 'SCTN') or (!pick.hardType.eq('GENSEC') or !pick.hardType.eq('HSTIFF')) then
      --<wd>may2007<mds12>

      -- ************************ Connexions ***********************
      !support.connections[1] = !pick
      -- !!mdsFT19.lineUp.active = False

      !start = plstart NA wrt world
      !end   = plend NA wrt world
      --        !start = PosStart wrt world
      --        !end   = PosEnd wrt world
      var !lineA CONS line JOIN $!start to $!end
      var !lineB CONS line P10 of $!datum
      var !lineC CONS line PAR $!lineB THROUGH P9 of $!datum
      var !tempInter CONS POS int $!lineA $!lineC
      !inter = !tempInter.position()

      -- Exit CURSOR creation if SCTN at right angles to Pipe/Branch Direction
      -- GE 26/05/06 Trap for when the Datum is rotated and an intersection can be created
      -- therefore making the user generate via clearance
      var !angle CONS ANGL $!lineA $!lineC
      if (!inter.unset() or !angle.neq('90'))then
        -- if (!inter.unset())then
        -- GE 26/05/06
        !!mdsCreateMess(FALSE)
        !!alert.error('Unable to create support from identified section using this method. Use clearance or dimensions')
        !!kRestoreUnits(!currentunits)
        !!mdsResetPins(1,10)
        return

        -------------------------------------------------
        --<wd>nov2004
      else
        -- Check if Picked SCTN is Parallel to P10 direction of DATUM atta within a tolerance angle of +/- 5 degrees
        -- Get the Directions of the Constructed Lines and Check if they are Parallel within a Tolerance Angle of (+/-) 5 degrees
        -- Set KEQUALDIR object definition
        !dira = !lineA.after('line ').before( 'through').direction()
        !dirb = !lineB.after('line ').before( 'through').direction()
        !checkdir = object KEQUALDIR()
        !checkdir.directionA = !dira
        !checkdir.directionB = !dirb
        !checkdir.tolerance  = 5

        -- Only DO this if the variable "!inter" has been "set".
        -- Check if directions are Parallel within a Tolerance Angle of (+/-) 5 degrees
        if (!!mdsdirequaldir(!checkdir)) then
          -- TRUE so treat the "!inter" variable as if it is "unset" and
          -- Exit CURSOR creation because the SCTN is at right angles to Pipe/Branch Direction
          !!mdsCreateMess(FALSE)
          !!alert.error('Unable to create support from the identified section using this method. use ''create by'' clearance or dimensions')
          !!kRestoreUnits(!currentunits)
          !!mdsResetPins(1,10)
          return
        endif
        --<wd>nov2004
        -------------------------------------------------
      endif

      -- PIN 1 AT $!inter wrt worl
      PIN 1 AT $!inter
      PIN 1 DIR $!dDir
      PIN 1 plane PIN 1 THRO P9 OF $!datum
      VAR !pin1Pos PIN 1 POS WRT WORLD
      --        !array = !!kClosestPline(!pick, !pin1Pos.position(), !uDir)
      --        !inter = !array[2]
      !inter = !!kFlangeOrWeb(!pick, !pin1Pos.position(), !dDir)

    endif

    -- END of CURSOR mode for SCTN option
    -- **********************************

    -- ****************************************************
    -- COMMON Pin POSITIONS for CURSOR mode for all OPTIONS
    -- ****************************************************

    --<wd>jun2007<mds12>
    -- Save !pick and for Associations
    !mdsassoc.pick1 = !pick
    --<wd>jun2007<mds12>
    -- PIN 9 AT $!inter wrt worl
    PIN 9 AT $!inter
    PIN 9 DIR $!dDir

    -- Test position of pin 9 relative to determine orientation
    pin1 copy p10 of $!datum
    pin1 plane pin1 thro pin9
    var !testDir CONS DIR P10 of $!datum to Pin 1

    -- Set object definition
    !direction = object KEQUALDIR()
    !direction.directionA = !testDir.direction()
    !direction.directionB = !support.p10dir
    !direction.tolerance  = 0.05

    -- Check directions
    if (!!kDirEqualDir(!direction)) then
      !support.rotateCur = FALSE
    else
      !support.rotateCur = TRUE
    endif

    PIN 7 AT P0 OF $!datum
    PIN 7 DIR $!toVert
    PIN 7 plane PIN 7 THRO PIN 9
    PIN 7 DIR $!uDir
    PIN 7 plane PIN 7 THRO PIN 9
    PIN 9 COPY PIN 7
    PIN 9 plane PIN 9 THRO P9 OF $!datum
    PIN 9 DIR $!toVert
    PIN 8 COPY PIN9
    PIN 8 plane PIN 8 THRO P9 OF $!datum
    PIN 9 DIR FROM PIN 8 TO PIN 9
    PIN 8 DIR FROM PIN 9 TO PIN 8

    !dim = 0
    VAR !tempPin8Dir PIN8 DIR
    var !tempPin9Dir pin9 dir

    --<k.pleschner>Jun06
    --do !i values !atta
    do !iref values !atta
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)
      PIN 4 COPY PIN 8
      PIN 4 AT $!datum
      --PIN 4 plane PIN 4 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 4 plane PIN 4 CLEAR $!i.oend BEH $!i
      else
        -- use distance from centreline
        PIN 4 plane PIN 4 THR $!i
        PIN 4 plane PIN 4 DIST $!i.oend
      endif
      handle (2,109)
        break
      endhandle
      VAR !cDir CONST DIR P0 of $!datum TO PIN 4
      !cDim = !!kStrReal('CONST DIST P0 of $!datum TO PIN 4')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cDir.direction()
      !direction.directionB = !tempPin8Dir.direction()
      !direction.tolerance  = 0.05

      if (!cDim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 4 AT $!datum
        PIN 4 DIST $!cDim
        !dim = !cDim
      else
        PIN 4 AT $!datum
        PIN 4 DIST $!dim
      endif
    enddo

    PIN 4 DIR FROM PIN 8 TO PIN 9
    !dim = 0

    --<k.pleschner>Jun06
    --do !i values !atta
    do !iref values !atta
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)
      PIN 3 COPY PIN 9
      PIN 3 AT $!datum
      --PIN 3 plane PIN 3 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 3 plane PIN 3 CLEAR $!i.oend BEH $!i
      else
        -- use distance from centreline
        PIN 3 plane PIN 3 THR $!i
        PIN 3 plane PIN 3 DIST $!i.oend
      endif
      handle (2,109)
        break
      endhandle
      VAR !cDir CONST DIR P0 of $!datum TO PIN 3
      !cDim = !!kStrReal('CONST DIST P0 of $!datum TO PIN 3')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cDir.direction()
      !direction.directionB = !tempPin9Dir.direction()
      !direction.tolerance  = 0.05

      if (!cDim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 3 AT $!datum
        PIN 3 DIST $!cDim
        !dim = !cDim
      else
        PIN 3 AT $!datum
        PIN 3 DIST $!dim
      endif
    enddo

    pin 3 dir from pin 9 to pin 8

    -- End COMMON Pin POSITIONS for CURSOR mode for all OPTIONS
    -- ********************************************************
    --
    -- PINS 3 and PIN 4 are in the CORRECT POSITIONS for HORIZ SCTN e.g. '*-BAR-1'
    -- *************************************************************************
    -- for CURSOR mode ID 'SCTN' option.
    -- ********************************
    --

    -- ********************************
  elseif (!method eq |DIMENSION|)then
    -- ********************************
    --<BC>Apr2005
    --Check to see if V1 exists and save the end and start directions for sloping decks
    !!ce = $!<name>-V1
    handle(2,109)
    elsehandle NONE
      if (!support.mirror) then
        !farend = 0
      else
        !farend = 1
      endif
      -- because we are building by dimension, we need to save the plane of the ends
      -- mdssaveends stores the end to trim !farend and the method used bt mdsoverdim
      !saveV1 = object MDSSAVEENDS(!!ce,!datum,!farend)
      --  !v1SctnDrne = Drne wrt worl
      -- !v1SctnDrns = Drns wrt worl
    endhandle

    -- Initialise variables for dimension check
    !d1 = !!mdsFT19.dim1.val
    !d2 = !!mdsFT19.dim2.val

    if !tempdesc.eq('Zimmer Templates') or (!alias inset ('CT10')) then
      if (!alias inset ('CT07','CT10')) then
        !supseq = !!mdsgettempnumber(/MDS/FRAMES/$!form.support.alias , !srefName.dbref().lbor)
        --!length = desp 1 of /MDS/$!form.support.alias/$!supseq-BAR-1
        !bktthk = desp 6 of /MDS/$!form.support.alias/$!supseq-BAR-1/PJOI
        handle ANY
          !bktthk[1] = 0
        endhandle
        --!a =  !srefName.dbref().lbor.real() / 2
        !dim3 = !!mdsFT19.dim1.val + (!srefName.dbref().lbor.real() / 2) + !clearance
        if (!alias eq 'CT07') then
          var !strucoll coll all stru with matchwild(name,'*CT07*') for /MDS/TEMPLATES
        elseif (!alias eq 'CT10') then
          var !strucoll coll all stru with matchwild(name,'*CT10*') for /MDS/TEMPLATES
        endif
        var !strunames eval name for all from !strucoll
        !lengarray = ARRAY()
        do !index indices !strunames
          !leng = desp 1 of $!strunames[$!index]-BAR-1
          if (!dim3.leq(!leng[1])) then
            !struname = !strunames[$!index]
            !selection = !index.string()
            -- !x = !leng[1] - (!srefName.dbref().lbor.real() / 2) - !clearance
            -- !!mdsFT19.dim1.val = !x
            !dim3 = !leng[1]
            !flag = TRUE
            break
          else
            !flag = FALSE
          endif
        enddo
        if (!flag.eq(FALSE)) then
          !!alert.error('Unable to find any wall brackets long enough to support this width')
          !!mdsFT19.dim1.val = 0
          !!mdsFT19.dim2.val = 0
          STRU
          --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
          !!mdsRemoveAutoPadRules(!!ce)
          --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end
          delete STRU MEM
          handle (41,66) (2,113) (2,113)
          endhandle
          return
        endif
      endif
    endif

    -- Framework FT19 is a 'T' Post type Pipe Support.
    -- Only Dimension1 'D1' may be set to '0' or a minus dimension (-300),
    -- i.e. on CentreLine of Vertical Leg

    --      if (!d1 eq '0' or !d2 eq '0')then
    if (!d2.eq(0))then
      !!alert.error('Dimension 2 may NOT be set to 0(zero).')
      !!kRestoreUnits(!currentunits)
      return
    elseif (!d1.lt(0) or !d2.lt(0)) then
      !!alert.error('Dimensions may NOT be set to a negative figure. Create as NORMAL and then Rotate and/or Mirror Framework as required.')
      !!kRestoreUnits(!currentunits)
      return
    endif

    !!mdsCreateMess(TRUE)

    -- Position pins
    !!ce = !datum

    -- Position pin 9 at bottom of the datum Pipe Ancillary
    ----------------------------------------------------
    PIN 9 COPY P9

    if (!support.rotateCur)then
      !tempPin9Dir = !p11Dir
      !tempPin8Dir = !p10Dir
    else
      !tempPin9Dir = !p10Dir
      !tempPin8Dir = !p11Dir
    endif
    ----------------------------------------------------

    PIN 9 DIR $!tempPin9Dir

    pin 1 at $!datum
    pin 1 dir $!tempPin9Dir
    pin 1 dist $!d1

    PIN 8 COPY PIN9
    PIN 8 DIR $!tempPin8Dir

    PIN 9 plane PIN 9 THRO CE
    PIN 8 plane PIN 8 THRO CE

    --      PIN 9 DIST $!d1
    --      PIN 9 DIR $!dDir

    --      PIN 7 COPY PIN 9
    --      PIN 7 DIST $!d2
    --      PIN 7 DIR $!uDir

    --      PIN 9 DIR FROM PIN 8 TO PIN 9
    --      PIN 8 DIR FROM PIN 9 TO PIN 8

    pin 9 plane pin 9 thro pin 1

    pin 2 at p9 of $!datum
    pin 2 dir $!tempPin9Dir

    --------------------------------------------------------
    -- Check if pin 9 and pin 8 are at the same position.
    --------------------------------------------------------
    !pin8pin9 = !!kStrReal('const dist pin 8 to pin 9')
    !pin8pin9dist = !pin8pin9

    if (!pin8pin9dist.leq(0) ) then
      !samepos = TRUE
      var !pin9pos pin 9 pos
      var !pin8pos pin 8 pos
      pin 9 dist 20
      pin 8 dist 10

      PIN 9 DIR FROM PIN 8 TO PIN 9
      PIN 8 DIR FROM PIN 9 TO PIN 8

      --        pin 9 at $!pin9pos
      --        pin 8 at $!pin8pos
      ----

    else

      !samepos = FALSE
      PIN 9 DIR FROM PIN 8 TO PIN 9
      PIN 8 DIR FROM PIN 9 TO PIN 8

    endif
    ---------------------------------------------------------------------------------------
    --      pin 9 dist $!d1

    pin 1 dir $!dDir
    pin 1 plane pin 1 thro p9 of $!datum

    --vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv
    -- Used datum instead of bar 'cos it don't exist when first creating
    pin 1 plane pin 1 clear 0 INF $!datum   $* $!<name>-BAR-1
    pin 10 copy p9 of $!datum
    pin 10 plane pin 10 clear 0 beh $!datum $* $!<name>-BAR-1
    pin 7 copy pin 10
    pin 7 plane pin 7 clear 0 INF $!datum   $* $!<name>-BAR-1

    --^^^^^^^^^^^^^^^^^^

    !p9p10 = !!kStrReal('const dist p9 of $!datum to plane pin 10')
    !p9p7 = !!kStrReal('const dist p9 of $!datum to plane pin 7')
    !p1p10 = !!kStrReal('const dist pin 1 to plane pin 10')
    !p1p7 = !!kStrReal('const dist pin 1 to plane pin 7')
    !p7p10 = !!kStrReal('const dist pin 7 to plane pin 10')

    !calc = 0

    if (!p1p7.eq(0) ) then
      !calc = !p7p10
    else
      !calc = !p9p10
    endif

    pin 7 copy pin 1

    PIN 7 DIST  ($!d2 + $!calc)
    --      PIN 7 DIST $!d2
    PIN 7 DIR $!uDir

    ---------------------------------------------------------------------------------------

    !dim = 0
    --<k.pleschner>Jun06
    --do !i values !atta
    do !iref values !atta
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)
      PIN 4 COPY PIN 8
      PIN 4 AT $!datum
      --PIN 4 plane PIN 4 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 4 plane PIN 4 CLEAR $!i.oend BEH $!i
      else
        -- use distance from centreline
        PIN 4 plane PIN 4 THR $!i
        PIN 4 plane PIN 4 DIST $!i.oend
      endif
      handle (2,109)
        break
      endhandle
      VAR !cDir CONST DIR P0 of $!datum TO PIN 4
      !cDim = !!kStrReal('CONST DIST P0 of $!datum TO PIN 4')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cDir.direction()
      if (!d1.geq(0) ) then
        !direction.directionB = !tempPin8Dir
      else
        !direction.directionB = !tempPin9Dir
      endif
      !direction.tolerance  = 0.05

      if (!cDim.gt(!dim) and !!kDirEqualDir(!direction)) then

        --        !attaname = name of $!i
        --          if (match('$!attaname','/DATUM') eq 0 ) and (match('$!attaname','/SREF') eq 0 ) then
        --
        --  Ignore the DATUM and SREF attas as Dimension 1
        --  is from the CL of the Vertical Leg to CL of the DATUM atta.
        --            !bran = !i.owner.name
        --            enhance solely $!bran col 35
        --            !!alert.warning ('Branch $!bran ( highlighted in springgreen ) will also be supported on this FRAMEwork.')
        --            unenhance $!bran
        --
        --          endif

        PIN 4 AT $!datum
        PIN 4 DIST $!cDim
        !dim = !cDim

        !d1 = !!kStrReal('const dist p0 of $!datum to plane pin 4')
        --            !!mdsFT19.dim1.val = !d1
        --
      else

        PIN 4 AT $!datum
        PIN 4 DIST $!dim

      endif

    enddo

    ----------------------------------------------------
    if (!d1.geq(0) ) then
      PIN 4 DIR FROM PIN 8 TO PIN 9
    else
      PIN 4 DIR FROM PIN 9 TO PIN 8
    endif
    ----------------------------------------------------


    !dim = 0

    --<k.pleschner>Jun06
    --do !i values !atta
    do !iref values !atta
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)
      PIN 3 COPY PIN 9
      PIN 3 AT $!datum
      --PIN 3 plane PIN 3 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 3 plane PIN 3 CLEAR $!i.oend BEH $!i
      else
        -- use distance from centreline
        PIN 3 plane PIN 3 THR $!i
        PIN 3 plane PIN 3 DIST $!i.oend
      endif
      handle (2,109)
        break
      endhandle
      VAR !cDir CONST DIR P0 of $!datum TO PIN 3
      !cDim = !!kStrReal('CONST DIST P0 of $!datum TO PIN 3')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cDir.direction()
      if (!d1.geq(0) ) then
        !direction.directionB = !tempPin9Dir
      else
        !direction.directionB = !tempPin8Dir
      endif
      !direction.tolerance  = 0.05
      --
      if (!cDim.gt(!dim) and !!kDirEqualDir(!direction)) then

        --          !attaname = name of $!i
        --          if (match('$!attaname','/DATUM') eq 0 ) and (match('$!attaname','/SREF') eq 0 ) then
        --
        --  Ignore the DATUM and SREF attas as Dimension 1
        --  is from the CL of the Vertical Leg to CL of the DATUM atta.
        --
        --            !bran = !i.owner.name
        --            enhance solely $!bran col 35
        --            !!alert.warning ('Branch $!bran ( highlighted in springgreen ) will also be supported on this FRAMEwork.')
        --             unenhance $!bran
        --
        --          endif

        PIN 3 AT $!datum
        PIN 3 DIST $!cDim
        !dim = !cDim

        !d1 = !!kStrReal('const dist p0 of $!datum to plane pin 3')
        --          !!mdsFT19.dim1.val = !d1

      else

        PIN 3 AT $!datum
        PIN 3 DIST $!dim

      endif

    enddo

    ----------------------------------------------------
    if (!d1.geq(0) ) then
      PIN 3 DIR FROM PIN 9 TO PIN 8
    else
      PIN 3 DIR FROM PIN 8 TO PIN 9
    endif
    ----------------------------------------------------
    --        pin 8 at $!pin8pos
    --        pin 9 at $!pin9pos


    -- *********************************
  elseif (!method eq |CLEARANCE|)then
    -- *********************************

    ------------ *** Connexion Warnings *** -------------
    !errorMessage = STRING()
    !dummyS       = ''
    if(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('UNJOINTED')) then
      -- nothing to do
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('WARNING')) then
      !continue = !!alert.confirm(!errorMessage)
      if(!continue.eq('NO')) then
        !!kRestoreUnits(!currentunits)
        !!mdsResetPins(1,10)
        return
      endif
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('ERROR')) then
      !!alert.error(!errorMessage)
      !!kRestoreUnits(!currentunits)
      !!mdsResetPins(1,10)
      return
    else
      -- leave in case
    endif
    ---------------------------------------------

    label /Element2

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify element to support from|
    ID $!iDType @
    handle (61,528)
      PROMPT ON
      !!ce = !stru
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    PROMPT DISMISS
    PROMPT ON
    !pick = !!ce
    !testCE = !!mdsRelToDatum(!datum, !pick, !dDir, !clearance)

    if (!testCE[1].upcase() eq 'UNSET')then
      !!alert.error('Identified element is unsuitable to support from.')
      golabel /Element2
    elseif (!testCE[1].upcase() eq '')then
      golabel /Element2
    endif

    if (!config.eq(3) or !config.eq(4))then
      if (!testCE[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('Identified element is infront pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'Identified element is infront of pipe.')
        endif
        golabel /Element2
      elseif (!testCE[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is in line with the datum atta')
        golabel /Element2
      endif
    else
      if (!testCE[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('Identified element is below pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'Identified element is below pipe.')
        endif
        golabel /Element2
      elseif (!testCE[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is at the same elevation as the datum atta')
        golabel /Element2
      endif
    endif

    --<wd>may2007<mds12>
    --      if (!pick.hardType eq 'PANE' or !pick.type eq 'BOX')then
    if (!pick.hardType eq 'PANE' or !pick.type eq 'BOX' or !pick.type eq 'HPLATE') then
      --<wd>may2007<mds12>
      !plane = !testCE[2]
      VAR !pDir CONST DIR $!plane
    endif

    !!mdsCreateMess(TRUE)

    -- Position pins
    PIN 9 COPY P9 of $!datum
    if (!support.rotateCur)then
      PIN 9 COPY P11 of $!datum
      !tempPin9Dir = !p11Dir
      PIN 8 COPY P10 of $!datum
      !tempPin8Dir = !p10Dir
    else
      PIN 9 COPY P10 of $!datum
      !tempPin9Dir = !p10Dir
      PIN 8 COPY P11 of $!datum
      !tempPin8Dir = !p11Dir
    endif

    PIN 9 plane PIN 9 THRO P0 of $!datum
    PIN 8 plane PIN 8 THRO P0 of $!datum

    -- set first direction
    PIN 7 COPY PIN 9
    !dim = 0

    --<k.pleschner>Jun06
    --do !i values !support.atta
    do !iref values !support.atta
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)
      --PIN 7 plane PIN 7 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 7 plane PIN 7 CLEAR $!i.oend BEH $!i
      else
        -- use distance from centreline
        PIN 7 plane PIN 7 THR $!i
        PIN 7 plane PIN 7 DIST $!i.oend
      endif
      handle (2,109)
        break
      endhandle
      VAR !cDir CONST DIR PIN 9 TO PIN 7
      !cDim = !!kStrReal('CONST DIST PIN 9 TO PIN 7')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cDir.direction()
      !direction.directionB = !tempPin9Dir
      !direction.tolerance  = 0.05

      if (!cDim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 7 AT $!datum
        PIN 7 DIST $!cDim
        !dim = !cDim
      else
        PIN 7 AT $!datum
        PIN 7 DIST $!dim
      endif
    enddo

    PIN 7 DIR $!dDir

    -- CLEARANCE method for SCTN pick
    -- ************************************
    --<wd>may2007<mds12>
    --      if (!pick.type eq 'SCTN') or (!pick.hardType eq 'GENSEC') then
    if (!pick.type eq 'SCTN') or (!pick.hardType eq 'GENSEC') or !pick.hardType.eq('HSTIFF') then
      --<wd>may2007<mds12>

      !start = plstart NA wrt world
      !end   = plend NA wrt world
      --        !start = PosStart wrt world
      --        !end   = PosEnd wrt world
      var !lineA CONS line JOIN $!start to $!end

      if (!config.eq(4))then
        var !lineB CONS line P9 of $!datum
        var !lineC CONS line PAR $!lineB THROUGH PIN 7
        var !tempInter CONS POS int $!lineA $!lineC
        !inter = !tempInter.position()
        !intersection = !inter
      else
        var !lineB CONS line P10 of $!datum
        var !lineC CONS line PAR $!lineB THROUGH P9 of $!datum
        var !tempInter CONS POS int $!lineA $!lineC
        !inter = !tempInter.position()
      endif

      -------------------------------------------------
      --<wd>nov2004
      -- Get the Directions of the Constructed Lines and Check if they are Parallel within a Tolerance Angle of (+/-) 5 degrees
      -- Set KEQUALDIR object definition
      !dira = !lineA.after('line ').before( 'through').direction()
      !dirb = !lineB.after('line ').before( 'through').direction()
      !checkdir = object KEQUALDIR()
      !checkdir.directionA = !dira
      !checkdir.directionB = !dirb
      !checkdir.tolerance  = 45

      -- Only DO this if the variable "!inter" has been "set".
      if (!inter.set())then

        -- Check if directions are Parallel within a Tolerance Angle of (+/-) 5 degrees
        if (!!mdsdirequaldir(!checkdir)) then
          -- When BELOW 45 degrees = TRUE so set the "!inter" variable to "unset" which will automatically
          -- FORCE the intersection point, i.e. !inter to be on th DATUM atta centreline along the P9 direction of the DATUM atta,
          -- which is where the centreline of the SCTN POST should be when creating by the CLEARANCE mode.

          !inter = object POSITION()
          -- This however may require the "vertical" SCTN Post to be CONNECTED via
          -- the Create Connections icon to achieve the correct geometry for connecting to the SCTN

        else
          -- 45 and Over 45 degrees out of parallel to the P10 direction of the DATUM atta

          -- Leave !inter as calculated and allow user to continue.
          -- This however may give unsatisfactory framework geometry, i.e. the "vertical" SCTN Post
          -- will need to be CONNECTED via the Create Connections icon to achieve the desirable geometry

        endif
      endif
      --<wd>nov2004
      -------------------------------------------------

      if (!inter.unset())then
        var !lineB CONS line P9 of $!datum
        var !tempInter CONS POS int $!lineA $!lineB
        !inter = !tempInter.position()
      endif

      PIN 1 AT $!inter
      PIN 1 DIR $!dDir
      PIN 1 plane PIN 1 THRO P9 OF $!datum
      VAR !pin1Pos PIN 1 POS WRT WORLD
      --        !array = !!kClosestPline(!pick, !pin1Pos.position(), !uDir)
      --        !inter = !array[2]
      !inter = !!kFlangeOrWeb(!pick, !pin1Pos.position(), !dDir)

      ---------------****** Connexions ******----------------------
      !support.connections[1] = !pick
      --!!mdsFT19.lineUp.active = True

      ------------------this bit will stop clearance being used if support is not under picked sctn-----------------------
      if(!haveJoints) then
        !connected = !!mdsGetBeamConn(!support,!attributes[1][8].dbref())
        if(!connected.unset()) then
          !!alert.error('Support is not positioned correctly through the new joints. Position "Through", before continuing.')
          !!ce = !refe
          !!mdsResetPins(1,10)
          return
        endif
      endif
      ------------------------take it out and it will create joints however far apart the support and steel is------------
      -------------------------------------------------------------

    else

      -- PANEL or BOX or FT22 bedplate(box)
      -- ***************************************
      PIN 1 AT $!pick
      PIN 1 DIR $!pDir
      VAR !tempInter CONS POS int PIN 1 $!plane
      !inter = !tempInter.position()
    endif

    if (!config.eq(4))then
      pin 1 at $!intersection
    else
      pin 1 at $!inter
    endif

    -- Common Code for CLEARANCE
    -- *************************

    PIN 7 plane PIN 7 THRO PIN 1
    --      PIN 7 copy pin1
    PIN 7 DIR $!uDir

    VAR !pin9Dir PIN 9 DIR WRT WORLD
    PIN 9 plane PIN 9 THRO PIN 7
    PIN 9 DIR $!dDir
    PIN 9 plane PIN 9 THRO P9 OF $!datum
    PIN 9 DIR $!pin9Dir WRT WORLD

    -- Set second direction
    --      PIN 6 COPY PIN 8
    !dim = 0

    --<k.pleschner>Jun06
    --do !i values !atta
    do !iref values !atta
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)
      --<wd>nov2004
      --skip if !i.name.match('/SREF').gt(1)
      --<wd>nov2004
      pin 6 copy pin 8
      --PIN 6 plane PIN 6 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 6 plane PIN 6 CLEAR $!i.oend BEH $!i
      else
        -- use distance from centreline
        PIN 6 plane PIN 6 THR $!i
        PIN 6 plane PIN 6 DIST $!i.oend
      endif
      handle (2,109)
        break
      endhandle
      VAR !cDir CONST DIR PIN 8 TO PIN 6
      !cDim = !!kStrReal('CONST DIST PIN 8 TO PIN 6')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cDir.direction()
      !direction.directionB = !tempPin8Dir
      !direction.tolerance  = 0.05

      if (!cDim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 6 AT $!datum
        PIN 6 DIST $!cDim
        !dim = !cDim
      else
        PIN 6 AT $!datum
        PIN 6 DIST $!dim
      endif
    enddo

    PIN 6 DIR $!dDir
    PIN 6 plane PIN 6 THRO PIN 9
    PIN 6 DIR FROM PIN 6 TO PIN 9
    PIN 8 DIR $!dDir
    PIN 8 plane PIN 8 THRO P9 of $!datum
    PIN 8 DIR FROM PIN 9 TO PIN 8
    PIN 4 COPY PIN 6

    -- PIN 3 added for CLEARANCE mode
    -- *******************************
    !dim = 0

    --<k.pleschner>Jun06
    ---do !i values !atta
    do !iref values !atta
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)
      PIN 3 COPY PIN 9
      PIN 3 AT $!datum
      --PIN 3 plane PIN 3 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 3 plane PIN 3 CLEAR $!i.oend BEH $!i
      else
        -- use distance from centreline
        PIN 3 plane PIN 3 THR $!i
        PIN 3 plane PIN 3 DIST $!i.oend
      endif
      handle (2,109)
        break
      endhandle
      VAR !cDir CONST DIR P0 of $!datum TO PIN 3
      !cDim = !!kStrReal('CONST DIST P0 of $!datum TO PIN 3')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cDir.direction()
      !direction.directionB = !tempPin9Dir
      !direction.tolerance  = 0.05

      if (!cDim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 3 AT $!datum
        PIN 3 DIST $!cDim
        !dim = !cDim
      else
        PIN 3 AT $!datum
        PIN 3 DIST $!dim
      endif
    enddo

    pin 3 dir from pin 9 to pin 8

    --<wd>jun2007<mds12>
    -- Save !pick and for Associations
    !mdsassoc.pick1 = !pick
    --<wd>jun2007<mds12>
    -- End COMMON Pin POSITIONS for CLEARANCE  mode for all OPTIONS
  endif

  --  END of CURSOR/DIMENSION/CLEARANCE block of CODE
  --  ***********************************************

  -- Create and ARRAY of Attas with Packing Pieces (PDMS Names ONLY)
  -- and the Type and Size of the Packing Pieces to Recreate
  !attapp = !!mdspackers(!support)
  ----------------------------------------------------------------------
  !!ce = !stru
  --<dw>feb2009 dun1081 - 'if' expression updated for CT10 - HPD0038695
  -- if !tempdesc.neq('Zimmer Templates') or (!alias inset ('CT10')) then
  if !tempdesc.eq('Zimmer Templates') or (!alias inset ('CT10')) then
    !bars = !!kCollectAllFor('SCTN', '((match(name, |-BAR-|) gt 0) and type of owner eq |FRMW|)', !!ce)
    -- Pins now in position to create framework
    if (!bars.size().lt(2)) then
      --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
      !!mdsRemoveAutoPadRules(!stru)
      --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end
      delete STRU MEM
      handle (41,66) (2,113) (2,113)
      endhandle

      if (!alias inset ('CT07','CT10')) then
        if (!!mdsFT19.dim1.val.eq(0)) then
          --$p alias is $!alias srefname is $!srefName
          !selection = !!mdsgettempnumber(/MDS/FRAMES/$!alias , !srefName.dbref().lbor).string()
        else
          if (!alias eq 'CT07') then
            var !strucoll coll all stru with matchwild(name,'*CT07*') for /MDS/TEMPLATES
          elseif (!alias eq 'CT10') then
            var !strucoll coll all stru with matchwild(name,'*CT10*') for /MDS/TEMPLATES
          endif
          var !strunames eval name for all from !strucoll
          !dim3 = !!mdsFT19.dim1.val + (!srefName.dbref().lbor.real() / 2) + !clearance
          !lengarray = ARRAY()
          do !index indices !strunames
            !leng = desp 1 of $!strunames[$!index]-BAR-1
            if (!dim3.leq(!leng[1])) then
              !struname = !strunames[$!index]
              !selection = !index.string()
              !dim3 = !leng[1]
              !flag = TRUE
              break
            else
              !flag = FALSE
            endif
          enddo
          if (!flag.eq(FALSE)) then
            !!alert.error('Unable to find any wall brackets long enough to support this width Dim 2')
            !!mdsFT14.dim1.val = 0
            !!mdsFT14.dim2.val = 0
            return
          endif
        endif
      endif
    endif
  else
    -- Pins now in position to create framework
    --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
    !!mdsRemoveAutoPadRules(!stru)
    --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end
    delete STRU MEM
    handle (41,66) (2,113) (2,113)
    endhandle
  endif

  --<wd>oct2000
  if (!alias eq 'FT19') then
    if (!support.paDir eq U or !support.plDir eq U)then
      if (!config.eq(2))then
        !mdstemp = /MDS/FT19V/$!selection
      else
        !mdstemp = /MDS/FT19H/$!selection
      endif
      !type = 'VERT'
    else
      !mdstemp = /MDS/FT19H/$!selection
      !type = 'HORI'
    endif
  elseif (!alias eq 'CT07') then
    !mdstemp = /MDS/CT07/$!selection
    !type = 'HORI'
  elseif (!alias eq 'CT10') then
    !mdstemp = /MDS/CT10/$!selection
    !type = 'HORI'
  endif
  :mdscheck $!mdstemp.:mdscheck
  :mdsframirror $!mdstemp.:mdsframirror
  --<wd>oct2000

  AT $!datum
  NEW FRMW $!name/MAIN
  !frmwSupport = !!ce

  if (!alias eq 'FT19') then
    if (!support.paDir eq U or !support.plDir eq U)then
      if (!config.eq(2))then
        !!ce = /MDS/FT19V/$!selection
      else
        !!ce = /MDS/FT19H/$!selection
      endif
      !type = 'VERT'
    else
      !!ce = /MDS/FT19H/$!selection
      !type = 'HORI'
    endif
  elseif (!alias eq 'CT07') then
    !!ce = /MDS/CT07/$!selection
    !type = 'HORI'
  elseif (!alias eq 'CT10') then
    !!ce = /MDS/CT10/$!selection
    !type = 'HORI'
  endif

  !desc = desc
  !mdsBars = :MdsBars

  -- <k.pleschner>nov06
  -- check for existence of !mdsTmplOri
  if undefined(!mdsTmplOri) then
    !mdsTmplOri = !stru.:Mdstmplori
  endif
  -- check orientation
  if !mdsTmplOri.eq(3) then
    !mdsTmplOri = 2
  elseif !mdsTmplOri.eq(4) then
    !mdsTmplOri = 1
  endif
  -- then try to select an "oriented" alternative of template
  !orientedTmpl = FALSE
  if !mdsTmplOri.boolean() then
    !!ce = /MDS/$!alias/$!selection/$!mdsTmplOri
    handle NONE
      !orientedTmpl = TRUE
    elsehandle ANY
    endhandle
  endif

  !frmw = !!kCollectAllFor('FRMW', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')

  -- Navigate back to support and create template elements
  if !tempdesc.eq('Zimmer Templates') or (!alias inset ('CT10')) then
    if (!bars.size().lt(2)) then
      !!ce = !frmwSupport
      COPY ATTRIB OF $!frmw[1]
      COPY MEM OF $!frmw[1] RENAME $!frameFormat $!name
    endif
  else
    !!ce = !frmwSupport
    COPY ATTRIB OF $!frmw[1]
    COPY MEM OF $!frmw[1] RENAME $!frameFormat $!name
  endif

  -- Get direction of P9 of datum atta and dist between p9 and p0
  var !p0p9dir cons dire p0 of $!datum to p9 of $!datum

  -- Set stru description for template recognition
  !!ce = !stru
  desc '$!desc'
  :MdsBars $!mdsBars

  -- <k.pleschner>oct06 Set stru :mdstmplori
  if !method.eq('CURSOR') then
    !!ce.:mdstmplori = !mdsTmplOri
  endif

  -- Added for Creating by Dimensions.
  if (undefined(!d1)) then
    !d1 = 0
  endif

  -- Locates Config '2' framework correctly
  if (!config.eq(2) ) then
    at p9 of $!datum
    MOVE $!uDir THRO P9 OF $!datum
    move $!p0p9dir thro p9 of $!datum
  else
    MOVE $!uDir THRO P9 OF $!datum
  endif


  --<wd>20may2004
  if !datum.:mdsguideref.set() and !datum.:mdsguideref.badref().not() then
    !mdsGuideRef = !datum.:mdsguideref
    if (!config eq 2) then
      -- Do NOT Move the STRU if the GUIDE is a TRUNNION GUIDE/STOP etc...
      if (!datum.catref.owner.:mdstrun.not()) then
        move $!p0p9dir thro p9 of $!mdsGuideRef
      endif
    else
      -- Do NOT Move the STRU if the GUIDE is a TRUNNION GUIDE/STOP etc...
      if (!datum.catref.owner.:mdstrun.not()) then
        MOVE $!uDir THRO P9 OF $!mdsGuideRef
      endif
    endif
  endif
  --<wd>20may2004


  -- Orientate MDS Structure
  ori x is $!orix and z is $!oriz

$(
  if (!config.eq(2))then
    if (!support.rotateCur)then
      VAR !orix CONST DIR PIN 8 TO PIN 9
      --        VAR !orix CONST DIR PIN 9 TO PIN 8
      !oriz = !dDir
    else
      VAR !orix CONST DIR PIN 9 TO PIN 8
      --        VAR !orix CONST DIR PIN 8 TO PIN 9
      !oriz = !dDir
    endif

  else
    if (!d1.geq(0) ) then
      VAR !orix CONST DIR PIN 9 TO PIN 8
      !oriz = !dDir
    else
      VAR !orix CONST DIR PIN 8 TO PIN 9
      !oriz = !dDir
    endif
  endif

  ORI X IS $!orix wrt world AND Z IS $!oriz
$)
  --<wd>nov2004
  ----------------------------------------------

  if (defined(!pin8pos)) then
    pin 8 at $!pin8pos
    pin 9 at $!pin9pos
  endif

  -- If the flange gap toggle is switched on then adjust the positions
  if !method.eq('CURSOR') then
    -- The form is obviously this FORM, !pick1 is the first picked element
    -- !pick2 is the second picked element, !vertLeg is a logical to see if
    -- we have moved the pins onto the correct size or not
    !!mdsGapFlange(!form,!pick,!pick,TRUE)
  endif

  -- Set dimensions
  if (!method eq |CURSOR| or !method eq |CLEARANCE|)then

    -- Dimension 1
    !dim1 = !!kStrReal('CONST DIST PIN 8 TO PIN 9')
    !!mdsFT19.dim1.val = !dim1
    --<wd>nov2004
    !d1 = !dim1
    --<wd>nov2004

    -- Dimension 2
    if (!type eq |VERT|)then
      PIN 1 COPY PIN 7
      if (!config.eq(3) ) then
        PIN 1 plane PIN 1 CLEAR 0 INF $!name-BAR-1
      else
        PIN 1 plane PIN 1 CLEAR 0 BEH $!name-BAR-1
      endif
      pin 10 copy pin 7
      pin 10 dir $!dDir
      pin 10 plane pin 10 clear 0 INF $!name-BAR-1
      !dim2 = !!kStrReal('CONST DIST PIN 7 TO PIN 10')
      --        !dim2 = !!kStrReal('CONST DIST PIN 7 TO PIN 1')
      !!mdsFT19.dim2.val = !dim2

    else
      !dim2 = !!kStrReal('CONST DIST PIN 7 TO PIN 9')
      !!mdsFT19.dim2.val = !dim2
    endif
  endif

  -- Extend and move V1
  --*******************
  !!ce = $!<name>-V1
  EXTEND END THRO PIN 7

  if (!config.eq(1)) then
    extend start thro pin 9
  else
    extend start thro pin 1
  endif

  !flush = :MdsOlap
  if !flush eq 'FLUSH' then
  elseif !flush eq 'OVERLAP' then
    !num = :MdsOnum
    EXTEND START $!num
  else
    EXTEND START $!overlap
  endif

  --    EXTEND START -$!overlap
  --xxx
  --xxx

  VAR !dir PIN 9 DIR WRT WORLD
  MOVE $!dir WRT WORLD THRO PIN 9
  PIN 5 COPY PIN 9
  --    PIN 3 COPY PIN 9
  PIN 2 COPY PIN 9


  -- Put pin 2(was pin3)(nearest to datum atta) and pin 5(furthest from datum atta),
  -- on each extremity of the angle leg(to obtain the leg width).

  -- We copy and delete the  vertical member because the BEH/INF code
  -- includes any joints that may be there.

  !sctn = !!ce
  new sctn copy prev
  delete sctn mem
  handle ANY
  endhandle

  PIN 5 plane PIN 5 CLEAR 0 BEH CE
  --    PIN 3 PLANE PIN 3 CLEAR 0 INF CE
  PIN 2 plane PIN 2 CLEAR 0 INF CE

  delete sctn
  !!ce = !sctn

  !d59 = !!kStrReal('CONST DIST PIN 5 TO PIN 9')
  !d29 = !!kStrReal('CONST DIST PIN 2 TO PIN 9')
  !d25 = !!kStrReal('CONST DIST PIN 2 TO PIN 5')
  !diff = ((!d29 - !d59) / 2)
  -- Adjust for dimension 1
  -- ********************************
  if (!method eq |CURSOR|)then

    --<wd>may2007<mds12>
    --      if (!pick.type eq 'SCTN' or defined(!bedplate))then
    if (!pick.type eq 'SCTN' or !pick.type eq 'HSTIFF' or defined(!bedplate))then
      --<wd>may2007<mds12>

      MOVE $!dir WRT WORLD DIST $!diff

      -- Remove half of V1 from DIM1
      --        !tempDim = !!mdsFT19.dim1.val - (!d25 / 2)
      --        !!mdsFT19.dim1.val = !tempDim.string()
    elseif (!pick.hardType eq 'GENSEC' or defined(!bedplate))then
      MOVE $!dir WRT WORLD DIST $!diff
    else

      --        MOVE $!dir WRT WORLD DIST $!d29

      -- *** *if type PANE  or BOX ****
      -- Move SCTN origin inline with  p9 of datum atta and position
      -- vertical leg equal about datum atta.

      move $!dir wrt world thro p9 of $!datum
      move $!dir wrt world dist $!diff
      --<k.pleschner>Jun06
      -- use !datumDflts to calculate DIM1
      -- set pin10 to calculate dim1 and actual distance to move V1
      pin10 at pin8
      pin10 dir $!dir wrt worl
      if !datumDflts.clge.eq('GEOM') then
        PIN 10 plane PIN 10 clear $!datumDflts.cend behind $!datum
      else
        PIN 10 plane PIN 10 distance $!datumDflts.cend
      endif
      !dim1 = !!kStrReal('CONST DIST PIN 8 TO PIN 10') + ( !d25 / 2 )
      move $!dir wrt world distance $!dim1
      !!mdsFT19.dim1.val = !dim1
      --<k.pleschner>
      pin 5 plane pin 5 clear 0 beh ce
      pin 2 plane pin 2 clear 0 inf ce
      --!!mdsFT19.dim1.val = 0
    endif

  elseif (!method eq |CLEARANCE|) then
    -- Method is CLEARANCE
    -- *******************

    --     MOVE $!dir WRT WORLD DIST $!d29
    --      MOVE $!dir WRT WORLD thro p9 of $!datum

    -- *** *if type SCTN, FT22 BEDPLATE(BOX), PANEL or BOX ****
    -- Move SCTN origin inline with p9 of datum atta and position
    -- vertical leg equal about datum atta.
    move $!dir wrt world thro p9 of $!datum
    move $!dir wrt world dist $!diff
    --<k.pleschner>Jun06
    -- use !datumDflts to calculate DIM1
    -- set pin10 to calculate dim1 and actual distance to move V1
    pin10 at pin8
    pin10 dir $!dir wrt worl
    if !datumDflts.clge.eq('GEOM') then
      PIN 10 plane PIN 10 clear $!datumDflts.cend behind $!datum
    else
      PIN 10 plane PIN 10 distance $!datumDflts.cend
    endif
    !dim1 = !!kStrReal('CONST DIST PIN 8 TO PIN 10') + ( !d25 / 2 )
    move $!dir wrt world distance $!dim1
    !!mdsFT19.dim1.val = !dim1
    --<k.pleschner>
    pin 5 plane pin 5 clear 0 beh ce
    pin 2 plane pin 2 clear 0 inf ce
    --!!mdsFT19.dim1.val = 0

  elseif (!method eq |DIMENSION|) then
    -- Method is DIMENSION
    -- *******************

    if (!config.eq(2) ) then
      move $!dir wrt world thro p9 of $!datum
      !difx = !diff
      !dify = !difx.abs()
      !dms1 = !!mdsFT19.dim1.val
      !dmn1 = !dms1.abs()

      if (!d1.geq(0) ) then
        if (!support.rotateCur) then
          move $!dir wrt world dist ($!dmn1 + $!dify)
        else
          move $!dir wrt world dist ($!dmn1 - $!dify)
        endif
      else
        move $!dir wrt world dist ($!dmn1 - $!dify)
      endif

    else
      move $!dir wrt world thro p9 of $!datum
      !difx = !diff
      !dify = !difx.abs()
      !dms1 = !!mdsFT19.dim1.val
      !dmn1 = !dms1.abs()

      -----------------------------------------------------------------
      --<kp>nov06 Correct position of V1 in case of "oriented" template
      if !orientedTmpl then
        !natzdir = !!ce.plori.nAT.zdir().wrt(stru)
        if !mdsTmplOri.eq(1).and(!natzdir.eq(W wrt stru)) then
          if !difx.gt(0) then
            !dify = !difx * -1
          endif
        endif
      endif
      ----------------------------------------------------------------

      if (!d1.geq(0) ) then
        move $!dir wrt world dist ($!dmn1 - $!dify)
      else
        move $!dir wrt world dist ($!dmn1 + $!dify)
      endif

    endif

    if !tempdesc.eq('Zimmer Templates') or (!alias eq 'CT11') then
      !d29 = !!kStrReal('CONST DIST PIN 2 TO PIN 9')
      move $!dir wrt world dist $!d29
    endif
    pin 5 plane pin 5 clear 0 beh ce
    pin 2 plane pin 2 clear 0 inf ce
  endif

  ------------------****** connexions *******----------------------
  if(!support.connections.unset()) then
    -- dimensions are being used first
    :MDSConn default
  else
    !vertical1 = !!ce
    !connected = !!mdsGetBeamConn(!support,!vertical1)
    :MDSConn $!connected
    handle ANY
    endhandle
  endif
  ------------------****** connexions *******----------------------

  -- Extend and move bar 1
  !!ce = $!<name>-BAR-1

  !tempOverlap = :MdsOlap
  if !tempOverlap eq 'OVERLAP' then
    !num = :MdsOnum
    PIN 9 plane PIN 9 CLEAR $!num BEH $!name-V1
  else
    PIN 9 plane PIN 9 CLEAR $!overlap BEH $!name-V1
  endif

  !pd49 = !!kStrReal('const dist pin 4 to plane pin 9')
  !pd43 = !!kStrReal('const dist pin 4 to plane pin 3')

  if (!pd43 ge !pd49) then
    pin 9 plane pin 9 thro pin 3
  else
    if !tempOverlap eq 'OVERLAP' then
      pin 9 plane pin 9 clear $!num BEH $!name-V1
    else
      pin 9 plane pin 9 clear $!overlap beh $!name-V1
    endif
    !pd49 = !!kStrReal('const dist pin 4 to plane pin 9')
    if (!pd43 ge !pd49) then
      pin 9 plane pin 9 thro pin 3
    endif
  endif


  if !tempdesc.eq('Zimmer Templates') or (!alias inset ('CT10')) then
    if (!method neq (|CLEARANCE|)) then
      -- if (!tempdesc.eq('Zimmer Templates') and (!method neq |CLEARANCE|))  then
      EXTEND START THRO PIN 1
      !p4dim = !!kStrReal('CONST DIST PIN 1 TO PIN 4')
      EXTEND END THRO PIN 4
      !extdim = !dim3 - !p4dim
      EXTEND END $!extdim
      --return
    endif
  endif

  if !tempdesc.neq('Zimmer Templates') or (!alias neq 'CT10') then
    --if !tempdesc.neq('Zimmer Templates') then
    if (!config.eq(2))then
      if (!support.rotateCur)then
        EXTEND END THRO PIN 9
        EXTEND START THRO PIN 4
      else
        EXTEND START THRO PIN 9
        EXTEND END THRO PIN 4
      endif

    else

      if (!d1.geq(0) ) then
        --EXTEND START THRO PIN 9
        --EXTEND END THRO PIN 4
        --<wd>nov2004
        -- Ensure the Cross Bar is extended in the Correct direction
        -------------------------------------------------------------

        if (!support.paDir eq U or !support.plDir eq U) then
          if (!support.rotateCur) then
            EXTEND START THRO PIN 9
            EXTEND END THRO PIN 4

          else
            EXTEND START THRO PIN 4
            EXTEND END THRO PIN 9
          endif

        else
          EXTEND START THRO PIN 9
          EXTEND END THRO PIN 4
        endif
        --<wd>nov2004

      else
        EXTEND START THRO PIN 4
        EXTEND END THRO PIN 9
        --<wd>nov2004
      endif
      --<wd>nov2004
    endif
  endif
  --(ge 08-03-05)

  --<kp>nov06 correct wrong orientation of bar in case of "oriented" template
  if !orientedTmpl then
    if !!ce.plori.nAL.zdir().wrt(stru).eq(N wrt stru) then
      flip
    endif
  endif
  --<kp>nov06
  -- For configuration 2 adjust height of vertical leg as dim2 is from
  -- Top of cross member and not the center point of the datum atta
  if (!config.eq(2))then
    if (!method eq |DIMENSION|)then
      PIN 7 plane PIN 7 CLEAR 0 BEH $!name-BAR-1
      pin 1 copy pin 7
      --<wd>nov2004
      --PIN 7 DIR U WRT WORLD
      pin 7 dir $!dDir
      PIN 7 DIST $!d2
      --PIN 7 DIR D WRT WORLD
      pin 7 dir $!uDir
      --<wd>nov2004
      !!ce = $!<name>-V1
      EXTEND END THRO PIN7
      extend start thro pin 1
      extend start $!overlap
      --          extend start -$!overlap
      SAME
    endif
  endif

  --<wd>nov2004
  -- Adjust SCTN "V1" vertical leg if config type 3 for CURSOR and CLEARANCE MODE
  if (!config.eq(3)) then
    --if (!method inset (|CURSOR|,|CLEARANCE|)) then
    !!ce = $!<name>-V1
    extend start thro pin 10
    extend start $!overlap
    --endif
  endif
  --<wd>nov2004

  -- Select correct spref
  !!ce = $!<name>/SREF
  !!mdsDacControl(TRUE)
  --!styp = !alias & '-1-1'
  !styp = !alias & '-1-' & !selection
  !spec = /MDF
  if !alias.eq('CT07') then
    --SEL SPREF WITH STYP '$!alias-1-$!selection' SPEC /MDF
    !!mdsSelectAttaSpref(!styp,!spec)
    !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-1-1')
  elseif !alias.eq('CT10') then
    --SEL SPREF WITH STYP '$!alias-1-$!selection' SPEC /MDF
    !!mdsSelectAttaSpref(!styp,!spec)
    !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-1-1')
  else
    --SEL SPREF WITH STYP '$!alias-1-$!selection' SPEC /MDF
    !!mdsSelectAttaSpref(!styp,!spec)
    !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-1-1')
  endif

  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)
  !!mdsDacControl(TRUE)

  !!ce = !stru

  -- Check to see if support is mirrored
  if (!support.mirror)then
    call !!mdsMirrorFt19()
    !support.mirror = TRUE
  endif


  -- Check for  Additional Cross Bars
  -- If cross-bars existed replace them
  if (!support.bars.empty().not())then

    do !i indices !support.bars
      skip if (!i.eq(1))
      call !!mdsAddBarFt19(!support, 'OLD')
    enddo
    !support.barLen = !!mdsFT19.support.barLen

  endif

  !list = !support.bars[1]
  !references = ''

  do !i indices !list
    !list[$!i].spkbrk = FALSE
    handle ANY
    endhandle
    !references = !references & ' ' & !list[!i].string()
  enddo

  -- Set atta reference to datum cross bar
  !!ce = $!<name>-BAR-1
  :MDSAttaRef $!references
  !support.barLen[1] = deri length of CE

  !!ce = !stru

  -- Adjust for slope on horizontal lines only
  if (!type eq |HORI|)then
    -- Check to see if the line is sloping
    !adjust = 0
    do !v values !atta
      !!ce = !v
      --<wd>nov2004
      skip if !!ce.name.match('/SREF').gt(0)
      --<wd>nov2004
      skip if !!ce.:mdsrotdir.east.set()
      !grad = pl grad
      handle ANY
        !grad = p2 grad
      endhandle
      if (!grad.neq(0))then
        --<wd>nov2004
        if (!!ce.pDir[9].wrt(/* ).east.abs().eq(1)) then
          !vHeight = 0
        elseif (!!ce.pDir[9].wrt(/* ).up.eq(0)) then
          !vHeight = 0
        else
          --<wd>nov2004

          !strucElement = ARRAY()
          !ref = $!name-BAR-1
          !strucElement.append(!ref)
          !vHeight = !!mdsAdjustSlope(!strucElement, !v)

          --<wd>nov2004
        endif
        --<wd>nov2004

      else
        !vHeight = 0
      endif
      if (!vHeight.gt(!adjust))then
        !adjust = !vHeight
      endif
    enddo

    -- Adjust required elements
    -- Adjust Height of Cross Bar Number 1.

    !!ce = $!<name>-BAR-1
    --<wd>nov2004
    --MOVE D WRT WORLD DIST $!adjust
    MOVE $!directions[3] DIST $!adjust
    --<wd>nov2004

    -- Vertical LEG Adjustment
    !!ce = $!<name>-V1
    !start = Posend wrt world
    !end   = Posstart wrt world

    if (!support.mirror)then
      PIN 7 AT $!end
      PIN 8 AT $!start
    else
      PIN 7 AT $!start
      PIN 8 AT $!end
    endif

    PIN 7 DIR TO PIN 8
    !toBar = 0

    do !indx indices !support.bars
      PIN 8 COPY PIN 7
      PIN 8 plane PIN 8 THRO $!<name>-BAR-$!indx
      handle ANY
      elsehandle NONE
        !toBar1 = !!kStrReal('CONST DIST PIN 7 TO PIN 8')
        if (!toBar1.gt(!toBar))then
          !toBar = !toBar1
          !index = !indx
        endif
      endhandle
    enddo

    PIN 8 plane PIN 8 CLEAR 0 beh $!<name>-BAR-$!index

    if !flush neq 'FLUSH' then
      if (!support.mirror)then
        EXTEND END THRO pin 8
        if !flush eq 'OVERLAP' then
          !num = :MdsOnum
          EXTEND END $!num
        else
          EXTEND END $!overlap
        endif
      else
        EXTEND START THRO pin 8
        if !flush eq 'OVERLAP' then
          !num = :MdsOnum
          EXTEND START $!num
        else
          EXTEND START $!overlap
        endif
      endif
    endif

    ------------------****** connexions *******----------------------
    if(!support.connections.unset()) then
      -- dimensions are being used first
      :MDSConn default
    else
      !vertical1 = !!ce
      !connected = !!mdsGetBeamConn(!support,!vertical1)
      :MDSConn $!connected
      handle ANY
      endhandle
    endif
    --------------------*******************--------------------------

    -- Extend vertical leg to account for the required adjustment
    if (!method eq |DIMENSION|)then

      if (!support.mirror)then
        !sctnEnd = 'START'
      else
        !sctnEnd = 'END'
      endif

      --        PIN 7 PLANE PIN 7 DIST $!adjust
      --        PIN 7 PLANE PIN 7 DIST -$!adjust
      EXTEND $!sctnEnd THRO PIN 7

    elseif (!method eq |CURSOR| or !method eq |CLEARANCE|) then
      -- Adjust dimensions on form
      !dim2Exist = !!mdsFT19.dim2.val + !adjust
      --        !dim2Exist = !!mdsFT19.dim2.val - !adjust

      -- reset dimensions on form
      !!mdsFT19.dim2.val = !dim2Exist
    endif
  endif

  -- Reset materials of sections
  !!mdsResetMat(!storeMat)

  -- Ensure  all Horizontal Cross Bars are Orientated the same way as the
  -- Main Cross Bar i.e., '/{struname}-BAR-1'
  if !tempdesc.neq('Zimmer Templates') or (!alias neq 'CT10') then
    -- if !tempdesc.neq('Zimmer Templates')then
    if (!support.bars.size().gt(1)) then
      call !!mdsflip( !stru , !support )
    endif
  endif

  -- Navigate to Main Structure of Framework
  !!ce = !stru

  -- Set 'FT25' form Support Object to be the same as 'FT19' form Support Object
  !!mdsFT25.support = !support

  -- Clear packs from 'BOTH forms' Support Objects as the SCTNs have already been deleted
  -- During the Framework Creation above
  !!mdsFT25.support.packs.clear()
  !support.packs.clear()

  -- Create Required Packing Pieces(SCTNs) at the Necessary Attas
  call !!mdscrpacksFT25(!attapp, !!mdsFT19)

  -- Update 'FT19' support.packs data to that held in form 'FT25'
  !support.packs = !!mdsFT25.support.packs

  -- Navigate to Main Structure of Framework
  !!ce = !stru

  ----------------------***** connexions *****--------------------------
  if(!haveJoints) then
    do !index indices !joints
      -- if support cursor picking is too unlike the existing then the connections will fail
      -- if(!joints[!index].badref()) then
      --  !!alert.error('Reconnection is not possible, connections will be deleted.')
      --!!mdsSelectJoints(!form,'DISCONNECT','')
      --!support.joints.clear()
      --  break
      --endif
      if(!joints[!index].badref().not() and !attributes[!index][8].dbref().:MDSConn.eq(!joints[!index].owner.owner)) then
        !mainStl = !attributes[!index][8].dbref().:MDSConn
        !support.joints[!index] =  !!mdsCreateJoint(!mainStl, !attributes[!index][8].dbref(),!joints[!index],!attributes[!index])
      else
        !dummy = object DBREF()
        !dummyA = ARRAY()
        !mainStl = !support.connections[!index]
        !support.joints[!index] =  !!mdsCreateJoint(!mainStl, !attributes[!index][8].dbref(),!dummy,!dummyA)
      endif
    enddo
  endif
  ----------------------------------------------------------------------

  -- If a joint is being used and it is handed then their will be a alternative spref of the
  -- opposite hand joint and the bang to set separated by a ,
  !!mdsSwapIntJoi(!support.stru,!support.mirror,!support.alias)

  -- The vertical member holds the internal joints and therefore has to be realigned
  -- with the crossbars, it needs to be planed through the centre of the cross bar
  !!ce = $!<name>-V1
  !poss = poss
  !pose = pose
  pin 9 at $!poss
  pin 8 at $!pose
  !drns = drns
  pin 9 dir $!drns
  pin 8 dir $!drns
  var !sjoi coll all sjoi for ce
  do !resetZdist values !sjoi
    !!ce = !resetZdist.dbref()
    !cref = cref
    end
    pin 9 clear 0 inf $!cref
    pin 8 clear 0 beh $!cref
    var !dist const dist pin 9 to pin 8
    pin 9 dir from pin 9 to pin 8
    pin 9 dist ($!dist 2 d)
    zdist thro pin 9
  enddo

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.append(!!ce)
  !colourList.appendarray(!support.atta)
  !colourList.appendarray(!support.joints)
  !!ce = !support.stru

  -- Copy welds locally
  --!copyWelds = object MDSWELDLIST(!!ce,!form)
  !!ce = !support.stru
  if defined(!saveV1) then
    !saveV1.restoreplane(!!mdsFT19.dim2.val ,1)
  endif

  --<kp>mar07 Handle snipes
  !!mdsSnipe(!support.stru)

  ---------------------------------------------------------------------------------------------------
  --<wd>aug2007<mds12>
  -- Update the MDSSCTN and MDSFITTING Objects to the latest DATA in the MDSSUPPORT object member .mdssctns,
  -- i.e. !form.support.mdsctns, where any MDS SNIPES(FITTINGS) exist on the MDS SUPPORT SCTNS where the GTYP of CATREF is 'ANG'
  -- and the MDS SNIPE/FITTING element PURPOSE attribute is set to 'XGUI'
  --
  -- ALL OTHER MDS SNIPES are generated automatically or from the MDS TEMPLATE during the MDS STRUCTURE creation/modification.
  -- ** NOTE ** The SNIPE UPDATE applies to ALL METHODS(!method) of Creation,
  -- i.e. 'CREATE by CURSOR/DIMENSION/CLEARANCE and RESIZING of the MDS TEMPLATE
  !!mdsrestoresnipe(!form, 'DIMENSION')

  -- REGENERATE the DATA stored in the FORM MDSSUPPORT object member "!form.support.mdssctns"
  -- for ALL of the MDS Support SCTNS and ALL the associated MDS SNIPE(FITTING) members
  !!mdssupportsctns(!form)
  --<wd>aug2007<mds12>
  ---------------------------------------------------------------------------------------------------

  !!ce = !support.stru

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- Reset all pins associated with this support
  call !!mdsResetPins(1,10)

  -- reset :mdsancref attributes if set
  !support.plateconns.restoreconns()
  -- Update support data held in form
  !!mdsFT19.support = !support

  !!mdsCreateMess(FALSE)

  -- Code for sloping decks
  if defined(!testCE[3]) then
    !!mdstrimplane($!name-V1 ,!support.mirror, !testCE[2],'end')
    -- we have trimmed the length of the vertical section to suit the panel
    -- now we need to reset the dimension
    !!mdsFT19.dim2.val = !!mdsgetoverdim($!datum , $!name-V1 ,1)
  else
    if !method neq |DIMENSION| then

      --<wd>may2007<mds12>
      --       if !pick.hardType.eq('SCTN') or !pick.hardType.eq('GENSEC') then
      if !pick.hardType.eq('SCTN') or !pick.hardType.eq('GENSEC') or !pick.hardType.eq('HSTIFF')then
        --<wd>may2007<mds12>

        --!x = object MDSPLINES(!pick,$!name-V1 ,TRUE )
      endif
      !!mdsFT19.dim2.val = !!mdsgetoverdim($!datum , $!name-V1 ,1)
    endif
  endif

  -- Show dimensions on graphics if required
  if !!mdsFT19.graphicalDim then
    !!mdsshowdim(!!mdsFT19)
  endif

  --<dw>sep2007 Restore bracing
  !!mdsrestorebracing(!form)
  --<dw>sep2007
  -- Store dimensions in design parameters

  !!ce = $!<name>/SREF
  !!mdsDacControl(TRUE)
  DESPAR $!!mdsFT19.dim1.val  $!!mdsFT19.dim2.val
  !!mdsDacControl(FALSE)

  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  --<wd>jun2007<mds12>
  -- Create the Cross Reference ASSOCIATIONS between the MDS SUPPORT SCTN members $!name-V1
  -- and the Main Structure supporting elements for:
  -- <a> CURSOR mode !pick -- or -- <b> CLEARANCE mode !pick
  --
  -- Store the Original Current Element
  !xce = !!ce

  -- Store the Array of MDS Support Members in the MDSASSOC Object
  !mdsassoc.mdsmember[1] = $!name-V1

  -- Initialising the MDSASSOWL object always DELETES ALL of the EXISTING Cross Reference Associations
  -- (ASSOC) elements for the Current MDS Support, irrespective of the Creation MODE (!method)
  !mdsassowl = object MDSASSOWL(!form)
  !mdsassowl.mdsform  = !form
  !mdsassowl.mdsassoc = !mdsassoc

  -- Create the Association (ASSOCs) for the Current Support
  !mdsassowl.mdsassoc(!mdsassoc)

  -- Update the FORM SUPPORT object to reference the current MDSASSOWL Associations object
  !form.support.associations[1] = !mdsassowl
  !support = !form.support

  -- Navigate back to the Original Current Element
  !!ce = !xce

  --<wd>jun2007<mds12>
  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------

  -- Add pads if automatic pads option is on and a PANE or HPLATE has been picked
  if !!mdsOptions.autopads.selection().eq('ON') then
    !whichVerticals = 'ALL'
    if !method.eq('CURSOR') or !method.eq('CLEARANCE') then
      if !pick.hardType.eq('PANE') or !pick.hardType.eq('HPLATE') then
        !!mdsaddpad(!support,!whichVerticals)
      endif
    elseif !method.eq('DIMENSION') and !padsExist then
      !!mdsaddpad(!support,!whichVerticals)
    endif
  endif

  -- Reset Units
  !!kRestoreUnits(!currentunits)

  -- End function
endfunction
