---------------------------------------------------------------------------------
--
-- File:                Mdscreateft25.pml
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:          MPS149
--
-- Author:              Wayne Dodwell
-- Created:             Tuesday 18th November 1997
--
--
-- Description:
-- function to create support Packing Piece 'FT25'
-- for a Support Atta on ANY Standard Framework Cross Bar
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R         FORM        Name of Form being called by
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!Mdscreateft25(!form is FORM)

-- Find current units and set the distance unit to metric
    !CurrentUnits = !!KGetSetUnits()

-- Reset all pins associated with this support
    call !!Mdsresetpins(1,10)

-- Initialise Variables
    !origin  = !!ce
    !support = !!Mdsft25.support
    !stru    = !support.stru
    !datum   = !support.datum
    !name    = !stru.name
    !frame   = !name & '/MAIN'
    --<k.pleschner>May06
    !Ancdef = object MDSANCGEOMDFLTS(!!Mdsft25.fatta)
    --<k.pleschner>May06

--> Modified - <wd - 2sep1998
    !rotft17   = false
--xxx    !clearance  = !!Mdsoptions.clear.val
    !clearance = !!Mdsft25.clear.val
    if (!clearance.unset()) then
      --<k.pleschner>May06
      --!clearance = !!Mdsoptions.clear.val
      !Clearance = !Ancdef.oend
    endif
--< Modified - <wd - 2sep1998

    !selection = !!Mdsft25.size.selection('rtext')
    -- !Selection = !!MdsSetSteel.Size.Selection('Rtext')
    !select    = !!Mdsft25.type.selection()
    !p10dir    = !support.p10dir
    !p11dir    = !support.p11dir
    !alias     = !support.alias

-- Store section name and matref for each member
-- for reseting later

    !StoreMat = array()
    !StoreMat = !!MdsStoreMat(!Name)


--------------------------------------------------------------------------------
    if (!support.type inset ('FT17')) then
      if (!support.rotatecur) then
        if (!form.dim1.val eq 0) then
          !form.support.rotatecur = false
          !!Mdsft25.support.rotatecur = false
          !support = !!Mdsft25.support
          !rotft17 = true
        endif
      endif
    endif

--------------------------------------------------------------------------------
    if (!form eq !!Mdsft25) then

--<wd>jun2007<mds12> -- ONLY if FT25 packer is an INDEPENDENT MDS Support
-- Initialise the MDS Associations Data Creation Object MDSASSOC
  !mdsassoc = object mdsassoc()
-- Ensure !method is always 'CLEARANCE' for Creating the Associations ONLY
  !mdsassoc.mode = 'CLEARANCE'
--<wd>jun2007<mds12>

-- Check that Datum atta has been created
      if (!datum.set().not())then
        !!Alert.message('Datum support atta has not been created')
        !!kRestoreUnits(!currentunits)
        return
      endif

-- Check that Datum atta has been positioned
      if (!Support.position.not())then
        !!Alert.message('Position Datum support atta before proceeding')
        !!kRestoreUnits(!currentunits)
        return
      endif

--------------------------------------------------------------------------------

-- Identify Structural Section to Associate with Packing Piece
      label /Pick1
      prompt off
      prompt load escape |Identify Structural Section to Add Packing Piece to|

--<wd>may2007<mds12>
      --id SCTN @
      !session   = current session
      if !session.module().upcase().match('DESIGN').gt(0) then
        !IDType  = 'GENSEC SCTN'
      elseif  !session.module().upcase().match('OUTFITTING').gt(0) then
        !IDType  = 'GENSEC SCTN HSTIFF'
      endif
      ID $!IDType @
--<wd>may2007<mds12>

      handle (61,528)
        prompt on
        !!ce = !origin
        !!kRestoreUnits(!currentunits)
        return
      endhandle
--<wd>may2007<mds12>
      prompt dismiss
      prompt on
      !sctn = !!ce

      !!Mdsft25.crbar = !sctn

--<wd>jun2007<mds12>
-- Save !sctn for Associations
      !mdsassoc.pick1 = !sctn
--<wd>jun2007<mds12>

    endif

    !!MdsCreateMess(true)

--------------------------------------------------------------------------------
-- Selected Atta and Cross Bar to add Packing Piece FT25
    !atta = !!Mdsft25.fatta
    !xbar = !!Mdsft25.crbar

--------------------------------------------------------------------------------
-- Get general direction of pleave of datum atta
-- General Pleave direction is nearest value to 1 or -1
    !!ce   = !support.datum
    !pldir = pl dir wrt world
    !padir = pa dir wrt world
    !up    = (abs(!pldir.up))
    !east  = (abs(!pldir.east))
    !north = (abs(!pldir.north))
    !max   = max((abs(!up)), (abs(!east)), (abs(!north)))
    if (!max.eq(!up))then
      if (!pldir.up.lt(0)) then
        !planedir = D wrt /*
      else
        !planedir = U wrt /*
      endif
    elseif (!max.eq(!east))then
      if (!pldir.east.lt(0)) then
        !planedir = W wrt /*
      else
        !planedir = E wrt /*
      endif
    else
      if (!pldir.north.lt(0)) then
        !planedir = S wrt /*
      else
        !planedir = N wrt /*
      endif
    endif

-- Set up Orientation of Selected Atta
-- Navigate to Selected Atta
    !!ce     = !atta
    !sap9dir = p9 dir wrt /*
    !sapldir = pl dire wrt /*
    !sapadir = pa dire wrt /*

-- Get general direction of pleave of selected atta
-- General Pleave direction is nearest value to 1 or -1
    !saup    = (abs(!sapldir.up))
    !saeast  = (abs(!sapldir.east))
    !sanorth = (abs(!sapldir.north))
    !samax   = max((abs(!saup)), (abs(!saeast)) , (abs(!sanorth)))
    if (!samax.eq(!saup))then
      if (!sapldir.up.lt(0)) then
        !saplanedir = D wrt /*
      else
        !saplanedir = U wrt /*
      endif
    elseif (!samax.eq(!saeast))then
      if (!sapldir.east.lt(0)) then
        !saplanedir = W wrt /*
      else
        !saplanedir = E wrt /*
      endif
    else
      if (!sapldir.north.lt(0)) then
        !saplanedir = S wrt /*
      else
        !saplanedir = N wrt /*
      endif
    endif

--------------------------------------------------------------------------------
-- Set Directions
    if (!sapldir eq U or !sapldir eq D) then
      !ddir = !sap9dir
      var !p3p9dir const dir p3 of $!atta to p9 of $!atta
      !udir = !p3p9dir.direction()
      !type = 'VERT'
--xxx      !sap10dir = p10 dir wrt /*
--xxx      !sap11dir = p11 dir wrt /*

--> Modified -<wd>-24sep1998
-- Set object definition
      !direction = object KEQUALDIR()
      !direction.directiona = !pldir
      !direction.directionb = !sapldir
      !direction.tolerance  = 0.05

-- Check directions
      if (!!kdirequaldir(!direction)) then
        if (!support.rotatecur) then
          !sap10dir = p11 dir wrt /*
          !sap11dir = p10 dir wrt /*
        else
          !sap10dir = p10 dir wrt /*
          !sap11dir = p11 dir wrt /*
        endif
        !orpadir  = !sapadir
        !orpldir  = !sapldir
      else
        if (!support.rotatecur) then
          !sap10dir = p10 dir wrt /*
          !sap11dir = p11 dir wrt /*
        else
          !sap10dir = p11 dir wrt /*
          !sap11dir = p10 dir wrt /*
        endif
        !orpadir  = !sapldir
        !orpldir  = !sapadir
      endif
--< Modified -<wd>-24sep1998

--------------------------------------------------------------------------------
    else
      !type = 'HORI'

--> Modified -<wd>- 28aug1998
      if (!support.type inset ('FT05','FT06','FT07','FT21')) then
        !ddir = !sap9dir
        var !p3p9dir const dir p3 of $!atta to p9 of $!atta
        !udir = !p3p9dir.direction()
        !sap10dir = p10 dir wrt /*
        !sap11dir = p11 dir wrt /*
--< Modified -<wd>- 28aug1998

      else
        !ddir = D wrt /*
        !udir = U wrt /*
      endif

--------------------------------------------------------------------------------

-- Set Orthogonal PL ans PA directions of Atta on Horizontal Pipe
-- Set Packing Piece SCTN Directions
      if (!support.mirror and !support.rotatecur.not() or !support.mirror.not() and !support.rotatecur) then
--
        !!ce = !atta
        if (!planedir eq !saplanedir) then
          !sapadir  = pa dir wrt world
          !sapldir  = pl dir wrt world
          !sap10dir = p10 dir wrt /*
          !sap11dir = p11 dir wrt /*
        else
          !sapadir  = pl dir wrt world
          !sapldir  = pa dir wrt world
          !sap10dir = p11 dir wrt /*
          !sap11dir = p10 dir wrt /*
        endif
--

        !xrpldir = !sapadir.string().split()
        !orpldir = !xrpldir[1].direction().wrt(world )
        !orpldir = !sapadir
        !xrpadir = !sapldir.string().split()
        !orpadir = !xrpadir[1].direction().wrt(world )

      else
--
        !!ce = !atta
        if (!planedir eq !saplanedir) then
          !sapadir  = pa dir wrt world
          !sapldir  = pl dir wrt world
          !sap10dir = p10 dir wrt /*
          !sap11dir = p11 dir wrt /*
        else
          !sapadir  = pl dir wrt world
          !sapldir  = pa dir wrt world
          !sap10dir = p11 dir wrt /*
          !sap11dir = p10 dir wrt /*
        endif
--

        !xrpldir = !sapldir.string().split()
        !orpldir = !xrpldir[1].direction().wrt(world )
        !xrpadir = !sapadir.string().split()
        !orpadir = !xrpadir[1].direction().wrt(world )


      endif
    endif

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Check if Atta has Packing Piece Already
    if (!atta.:MDSPackRef.badref().not()) then

--> Modified - <wd> - 2sep1998
      !confirm = !!alert.confirm ('Packing Piece already exists on the Support $!<atta.name>. **RE-BUILD** the Packing Piece using the ''Size, Type and Clearance'' shown on the form?')
--< Modified - <wd> - 2sep1998

      if (!confirm eq 'NO') then
        !!MdsCreateMess(false)
        !!kRestoreUnits(!currentunits)
        return
      else
        !!MdsDacControl(TRUE)
        !!ce = !atta.:MDSPackRef
        !ppnam = !!ce.name
        delete sctn
        !!ce = !atta
        :MDSPackRef unset
      endif
    endif

    !!MdsDacControl(TRUE)

--------------------------------------------------------------------------------
-- Move Stru to Datum Atta Position if an Independent FT25 Structure

    if (!support.type eq 'FT25') then
      !!ce = !stru
      at p9 of $!datum
    endif

--------------------------------------------------------------------------------
-- Temporarily (Re-)Position P9 of Selected Atta Inline with Structure
    !!ce = !atta
    move p9 $!pldir thro $!stru
    if (!type eq 'VERT') then
      ori and p9 is $!ddir
    else
      ori and p9 is $!sap9dir
    endif
    plane $!sapldir thro ce

--------------------------------------------------------------------------------
-- Check the Picked Atta(!atta) is above it's Associated Beam/Cross Bar(!xbar)
-- Goto Cross Bar
    !!ce = !xbar

--> Modified - <wd> - 19aug1998
    !xbarname = !xbar.name
--< Modified - <wd> - 19aug1998

    !start = poss wrt world
    !end   = pose wrt world
    pin 9 at $!start
    pin 8 at $!end

-- Goto Picked Atta
    !!ce  = !atta
    !anam = !atta.name

--> Modified - <wd> - 19aug1998
--> Position pin 7 at p9 Selected Atta and NOT the DATUM Atta
--    pin 7 copy p9 of $!datum
    pin 7 copy p9 of $!atta
--< Modified - <wd> - 19aug1998

    pin 7 plane pin 7 thro $!start

    if (!type eq 'HORI') then
-- Check Dimensions
      !checkdist = !!KStrReal('const dist pin 9 to pin 8')
      !dist1     = !!KStrReal('const dist pin 9 to pin 7')
      !dist2     = !!KStrReal('const dist pin 8 to pin 7')
      if (!dist1.gt(!checkdist) or !dist2.gt(!checkdist)) then
        !!Mdscreatemess(false)
        !!Mdsresetpins(1,10)

--> Modified - <wd> - 19aug1998
        !!MdsDacControl(FALSE)
        !!alert.error('Atta $!anam is NOT located within the Length of the Associated Beam/Cross Bar $!xbarname')
--< Modified - <wd> - 19aug1998

        !!kRestoreUnits(!currentunits)
        return
      endif
    endif

--------------------------------------------------------------------------------

-- NOW Determine what has to be created and where.
--------------------------------------------------

------------------------------------------------------------------------------
------------------------------------------------------------------------------
-- Packing Piece is NOT a part of an INDIVIDUAL 'FT25' Structure
--------------------------------------------------------------------------------
    if (!support.type neq 'FT25') then

-- Navigate to the Framework of the Owning Structure
      !!ce = !frame.dbref()

-- Create Packing Piece as a member of ANOTHER Original Framework Type
      new sctn copy /MDS/FT25$!<select>/$!<selection>-BAR-1

-- Try to name NEW Sctn with the original NAME
      name $!ppnam
      handle none
        !enam = true
        !pack = !!ce
      elsehandle any
        do !cnt
          name $!<name>-PP-$!<cnt>
          handle any
            skip
          elsehandle none
            !pack = !!ce
            !enam = false
            break
          endhandle
        enddo
      endhandle

------------------------------------------------------------------------------
------------------------------------------------------------------------------
-- FT25 is to have its OWN Structure ie. - Framework '!support.type' is 'FT25'
------------------------------------------------------------------------------
    else

      !!ce = !stru
      delete stru mem
      handle (41,66) (2,113) (2,113)
      endhandle

--<wd>oct2000
    !mdstemp = /MDS/FT25$!<select>/$!<selection>
    :mdscheck $!mdstemp.:mdscheck
    :mdsframirror $!mdstemp.:mdsframirror

--<wd>oct2000


-- Position Structure and Create Framework
      at p9 of $!datum
      new frmw $!name/MAIN
      !frmwsupport = !!CE

      !!ce = /MDS/FT25$!<select>/$!<selection>
      !desc = desc
      !MdsBars = :MdsBars

      !frmw = !!kcollectallfor('FRMW', '', !!CE)
      !frameformat = before(!frmw[1].name, '-FRMW')

-- Navigate back to support and create template elements
      !!ce = !frmwsupport
      copy attrib of $!frmw[1]
      copy mem of $!frmw[1] rename $!frameformat $!name

      !!ce = !stru

-- Select correct spref
      !!ce = $!<name>/SREF
      !!MdsDacControl(true)
      sel spref with styp '$!<alias>-$!<select>-$!<selection>' spec /MDF
      !!MdsSetSuppCode('MODIFY',!Name,!Alias,'FT25-A-1')

      !!MdsSetIspe()
      !!MdsDacControl(TRUE)
      !!MdsSelLstu(!!CE)

-- Set atta reference to datum cross bar
      !!ce   = $!<name>-BAR-1
      !ppnam = !!ce.name
      !enam  = true
      !pack  = !!ce
      :MDSAttaRef $!datum
      !support.barLen[1] = deri length of ce
      !!ce   = !stru

-- Set stru description for template recognition

      desc '$!Desc'
      :MdsBars $!MdsBars


--Navigate to Stru and Orientate
      !!ce = !stru
      ori y is $!orpldir and z is $!udir

    endif

-- End of 'if'/'else' whether Support Type is 'FT25' or Not
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- Common Code for All Frameworks Including 'FT25' Independent Structures
--------------------------------------------------------------------------------

-- Position Top of Packing Piece at 'p9' of Selected Atta
    !!ce = !pack
    pin 1 copy p9 of $!atta
    pin 1 dir $!ddir
-- Position Pack at Pin 1
    at pin 1

-- Rotate Packing Piece if Framework is MIRRORED
    if (!form neq !!Mdsft25) then
      if (!support.mirror) then
        rotate thro pin 1 about pin 1 by 180
      endif
    endif

-- Set midpoint of Packing Piece
    var !midp deri midp wrt /*

-----------------------------------------------------------------------------------
--xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
-- Determine Packing Piece 'Horizontal BACKMARK' from the Template Member '*-BAR-1'
-----------------------------------------------------------------------------------
-- Store Pin 1 Position and Direction
    var !p1pos pin 1 pos wrt /*
    var !p1dir pin 1 dir wrt /*
    !pin1pos = !p1pos.position()
    !pin1dir = !p1dir.direction()

-- Store Pin 2 Position and Direction
    var !p2pos pin 2 pos wrt /*
    var !p2dir pin 2 dir wrt /*
    !pin2pos = !p2pos.position()
    !pin2dir = !p2dir.direction()

-----------------------------------------------------
-- Navigate to Template  Member '*-BAR-1'
-- Determine the Main Channel Cross Bar Width
    !!ce = /MDS/FT25$!<select>/$!<selection>-BAR-1
    if (!select eq 'A') then
      !tdir = s wrt /*
    elseif (!select eq 'B') then
      !tdir = n wrt /*
    endif
-----------------------------------------------------

    pin 1 at stru
    pin 2 copy pin 1
    pin 2 dir $!tdir
    pin 2 plane pin 2 clear 0 beh ce

-- Set value of Packing Piece Backmark
    !hbmk = !!kstrreal('cons dist pin 1 to plane pin 2')

-- Navigate back to the Packing Piece
    !!ce = !pack
--Reset Pin 1 and 2 back to their Previous positions
    pin 1 dire $!pin1dir
    pin 1 at $!pin1pos
    pin 2 dire $!pin2dir
    pin 2 at $!pin2pos

-----------------------------------------------------------------------------------
-- Packing Piece 'Horizontal BACKMARK' from the Template Member '*-BAR-1' - above
--xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
-----------------------------------------------------------------------------------


--------------------------------------
-- Select Packing Piece 'Type'
-- Position Packing Piece and Move Atta
-----------------------------------------------------------------------------------
    if (!select eq 'A') then
-- Packing Piece Type 'A'
-----------------------------------------------------------------------------------
      if (!support.type.matchwild('FT14').not()) then
        if (!support.mirror and !support.rotatecur.not() or !support.mirror.not() and !support.rotatecur) then
          !zldir = !pldir
          !pldir = !padir
          !padir = !zldir
        endif
      endif

--> Modified -<wd>- 1sep1998
      !gdir  = U wrt /*
      if (!support.type inset ('FT05')) then
        if (!sap10dir eq !gdir) then
          !zldir = !pldir
          !pldir = !padir
          !padir = !zldir
        endif
      elseif (!support.type inset ('FT06')) then
        if (!sap10dir neq !gdir) then
          !zldir = !pldir
          !pldir = !padir
          !padir = !zldir
        endif
      endif
--< Modified -<wd>- 1sep1998

      pin 4 at $!midp wrt /*
      pin 4 dir $!pldir

--<wd>oct2002
      if (!type.eq('HORI')) then
        !pldirstr  = !pldir.string().before(' ')
        handle any
          !orthpldir = !pldir
        elsehandle none
          !orthpldir =  !pldirstr.direction().wrt(/* )
           pin 4 dir $!orthpldir
        endhandle
      endif
--<wd>oct2002

      pin 6 copy pin 4
      pin 6 plane pin 6 thro pin 1
      pin 6 dir to pin 1
      var !pin6dir dire pin 6 wrt /*

---------------------------------------------
-- Move Top of Packing Piece to Bottom of Atta and CL of Packing Piece
      !hderi = deri len / 2
      move $!pin6dir wrt /* dist $!hderi
      move $!ddir clear 0 beh p9 of $!atta

--> Modified -<wd>- 28aug1998
      if (!support.type inset ('FT05','FT06','FT07','FT21')) then
        if (!support.type inset ('FT05','FT07','FT21')) then
          flip
          rotate thro pin 4 about pin 4 by -90
        elseif (!support.type inset ('FT06')) then
          flip
          rotate thro pin 4 about pin 4 by 90
        endif
      endif
--< Modified -<wd>- 28aug1998

---------------------------------------------
-- Move Packing Piece to the Correct Position
      pin 6 copy pin 4
      pin 4 plane pin 4 clear 0 beh $!pack
      pin 6 plane pin 6 clear 0 inf $!pack
      pin 7 copy pin 4
      pin 7 plane pin7 clear 0 beh $!xbar
      !pin6pin7dist = !!kstrreal('cons dist pin 6 to plane pin 7')

-- Determine whether to Move The Stru or the Packing Piece
      if (!form eq !!Mdsft25) then
        !!ce = !stru
      endif

--<wd>oct2002
      !sign = '+'
      if (!form.support.mirror.not() and !form.support.rotatecur) then
        !sign = '-'
      endif

      if (!sign.eq('+')) then
        move $!pldir dist $!pin6pin7dist
      else
        !pldiropp = !pldir.opposite()
        move $!pldiropp dist $!pin6pin7dist
      endif
--<wd>oct2002
-------------------------------------------------------------------------------
      if (!support.type inset('FT01','FT02')) then
        !bar2 = !support.stru.name & '-BAR-2'
        !!ce  = !bar2.dbref()
        handle none
-- TWO Cross Bars for 'FT01' or 'FT02' Framework type
          !!ce = !pack
          if (!support.mirror) then
            move $!pldir clear 0 inf pin 7
          else
            move $!pldir clear 0 beh pin 7
          endif
        elsehandle any
          !!ce = !pack
-- Only ONE Cross Bar for 'FT01' or 'FT02' Framework type
-- Do Nothing
        endhandle
-------------------------
      elseif (!support.type inset('FT17')) then
        !!ce = !pack
        if (!support.mirror) then
          move $!pldir clear 0 inf pin 7
        else
          move $!pldir clear 0 beh pin 7
        endif
-------------------------
      endif

      !!MdsDacControl(true)

-- Move Atta to the Correct Position
------------------------------------
      !!ce = !atta
-->>>-<wd>nov2002 FT14 in Correct ORI if -- Mirror = false and RotateCur = true
      if (!form.eq(!!mdsft14)) then
        pin 5 copy pin 6
        pin 5 dist $!hbmk
        if (!support.mirror.not() and !support.rotatecur) then
          move along $!pldiropp dist $!pin6pin7dist
        else
          move along $!pldir dist $!pin6pin7dist
        endif
--<<<-<wd>nov2002 FT14 in Correct ORI if -- Mirror = false and RotateCur = true

      else
        pin 5 copy pin 7
        pin 5 dist $!hbmk
        move along $!pldir thro pin 5
      endif

      if (!type eq 'VERT') then
        ori and p9 is $!ddir
      else
        ori and p9 is $!sap9dir
      endif
      plane $!sapldir thro ce

-- If Selected Atta is the DATUM Atta
-- ONLY applies to Packers on Other Framework Types
      if (match(!atta.name,'DATUM') gt 0) then
-- Navigate to SREF Atta and Reposition it at the DATUM Atta
        !SrefName = !Atta.Name.before('DATUM') + 'SREF'
        !DatumName = !Atta.Name
        !!CE = !SrefName.dbref()
        at $!DatumName
        ori
        thro ce
        !!ce = !atta
      endif

-- End of Type 'A' Packing Piece
-------------------------------------------------------------------------------
    elseif (!select eq 'B') then
-- Packing Piece Type 'B'
-------------------------------------------------------------------------------

      !!MdsDacControl(TRUE)

--> Modified -<wd>-25sep1998
      if (!support.type.matchwild('FT14') and !support.rotatecur) then
        !!ce  = !pack
        flip
      endif
--< Modified -<wd>-25sep1998

      if (!support.type.matchwild('FT14').not()) then
        if (!support.mirror and !support.rotatecur.not() or !support.mirror.not() and !support.rotatecur) then
          !zldir = !pldir
          !pldir = !padir
          !padir = !zldir
        endif
      endif

--> Modified -<wd>- 1sep1998
      !gdir  = U wrt /*
      if (!support.type inset ('FT05')) then
        if (!sap10dir eq !gdir) then
          !zldir = !pldir
          !pldir = !padir
          !padir = !zldir
        endif
      elseif (!support.type inset ('FT06')) then
        if (!sap10dir neq !gdir) then
          !zldir = !pldir
          !pldir = !padir
          !padir = !zldir
        endif
      endif
--< Modified -<wd>- 1sep1998

      pin 4 at $!midp wrt /*
      pin 4 dir $!pldir
--<wd>oct2002
      if (!type.eq('HORI')) then
        !pldirstr  = !pldir.string().before(' ')
        handle any
          !orthpldir = !pldir
        elsehandle none
          !orthpldir = !pldirstr.direction().wrt(/* )
           pin 4 dir $!orthpldir
        endhandle
      endif
--<wd>oct2002

      pin 6 copy pin 4
      pin 6 plane pin 6 thro pin 1
      pin 6 dir to pin 1
      var !pin6dir dire pin 6 wrt /*

-- Move Top of Packing Piece to Bottom of Atta and CL of Packing Piece
      !hderi = deri len / 2
      move $!pin6dir wrt /* dist $!hderi
      move $!ddir clear 0 beh p9 of $!atta

-------------------------------------------
--> Modified -<wd>- 1sep1998
      if (!support.type inset ('FT05','FT06','FT07','FT21')) then
        flip
        rotate thro pin 4 about pin 4 by -90
      endif
--< Modified -<wd>- 1sep1998
-------------------------------------------

-- Move Packing Piece to the Correct Position
-- Get Angle Thickness
      var !pin4dir pin 4 dir wrt /*
      !adir = !pin4dir.direction()
      pin 8 at ppline na start
      pin 8 dir $!adir
      var !pin8pos pin 8 pos wrt /*
-- Position Pin 8 on Inside face of Angle
      !array = !!kclosestpline(!pack, !pin8pos.position(), !adir)
      !inter = !array[4]
      pin 8 at $!inter

      pin 6 copy pin 4
      pin 4 plane pin 4 clear 0 beh $!pack
      pin 6 plane pin 6 clear 0 inf $!pack
      pin 7 copy pin 4
-- Position Pin 7 on Edge of Cross Bar
      pin 7 plane pin 7 clear 0 beh $!xbar
      pin 5 copy pin 4
      pin 5 dir $!padir

-- Distance from Edge of Cross bar to Edge of Packer
      !pin4pin7dist = !!KStrReal('cons dist pin 4 to plane pin 7')

-- Thickness of Packer
      !pin4pin8dist = !!KStrReal('cons dist pin 4 to plane pin 8')

-- Determine whether to Move The Stru or the Packing Piece
      if (!form eq !!Mdsft25) then
        !!ce = !stru
      endif
------------------------------------------------------------------------
      if (!support.type inset ('FT01', 'FT02')) then
        !pin7pin8dist = !!kstrreal('cons dist pin 7 to plane pin 8')
        !bar2 = !support.stru.name & '-BAR-2'
        !!ce  = !bar2.dbref()

        handle none
-- TWO Cross Bars for 'FT01' or 'FT02' Framework type
          !!ce = !pack
          if (!support.mirror) then
            move $!pldir dist -$!pin7pin8dist
          else
            move $!padir dist $!pin7pin8dist
          endif

        elsehandle any
-- Only ONE Cross Bar for 'FT01' or 'FT02' Framework type
          !!ce = !pack
          move $!pldir dist ($!pin4pin7dist  + $!pin4pin8dist)

        endhandle
-------------------------
      else

-- All Other Framework Types
        !!ce = !pack
        movE $!pldir dist ($!pin4pin7dist  + $!pin4pin8dist)
      endif
------------------------------------------------------------------------

-- Move Atta to the Correct Position
      !!ce = !atta
      pin 5 plane pin 5 clear 0 inf $!xbar
      pin 5 dist ($!hbmk - $!pin4pin8dist)
      move along $!pldir thro pin 5
      if (!type eq 'VERT') then
        ori and p9 is $!ddir
      else
        ori and p9 is $!sap9dir
      endif
      plane $!sapldir thro ce

-- If Selected Atta is the DATUM Atta
-- ONLY applies to Packers on Other Framework Types
      if (match(!atta.name,'DATUM') gt 0) then
-- Navigate to SREF Atta and Reposition it at the DATUM Atta
        !SrefName = !Atta.Name.before('DATUM') + 'SREF'
        !DatumName = !Atta.Name
        !!CE = !SrefName.dbref()
        at $!DatumName
        ori
        thro ce
        !!ce = !atta
      endif

-------------------------------------------------------------------------------
-- End of Type 'B' Packing Piece
-------------------------------------------------------------------------------
    endif

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------

-------------------------------------------------------------------------------
-- If form is !!MDSFT25, i.e. an Independent 'FT25' move Origin of Stru to P9 of Datum Atta
-- and Adjust Location of !pack ie. $!<name>-BAR-1
-------------------------------------------------------------------------------
    if (!form eq !!Mdsft25) then
      !!ce = !stru
      pin 9 at stru
      pin 9 dir $!udir
      at $!datum
      move $!ddir thro p9 of $!datum
      !!ce  = !pack
      if (!select eq 'A') then
        move $!orpadir clear 0 inf pin 7
      elseif (!select eq 'B') then
        move $!orpldir  clear 0 inf pin 7
        move $!orpldir dist $!pin4pin8dist
      endif
      pin 9 at stru
      pin 9 dir $!udir

-- Move Attas to the Correct Position
      !!ce = !datum
      !DatumName = !!CE.Name
      !SrefName = !DatumName.Before('/DATUM') + '/SREF'

      move p9 along $!orpldir thro pin 5
      if (!type eq 'VERT') then
        ori and p9 is $!ddir
      else
        ori and P9 is $!sap9dir
      endif
      plane $!sapldir thro ce
-- Navigate to SREF Atta and Reposition it at the DATUM Atta
      !!CE = !SrefName.dbref()
      at $!DatumName
      ori
      thro ce
      !!ce = !datum

-- Reset the Distance Gadget on the Form
      call !!Mdsdistance(!!Mdsft25)
    endif

    !!MdsDacControl(TRUE)

-------------------------------------------------------------------------------

-- Common for Type 'A' and 'B' Packing Pieces
-------------------------------------------------------------------------------
-------------------------------------------------------------------------------

-- Adjust Position 'TOS' to be at P9 of !atta
-- Determine whether to Move The Stru or the Packing Piece
    if (!form eq !!Mdsft25) then
      !!ce = !stru
    else
      !!ce = !pack
    endif
    move $!ddir clear 0 beh p9 of $!atta

-------------------------------------------------------------------------------
-- Adjust Length of Packing Piece Using the Default Clearance Value
    !!ce = !pack
    pin 1 at $!atta
    pin 1 dire $!sap10dir
    pin 2 at $!atta
    pin 2 dire $!sap11dir

------------------------------
--> Modified - <wd> - 2sep1998

-- Navigate to the Selected Atta
    !!ce     = !atta
-- Get Despar Number of Dataset Dkey 'FWID'
    !despnum = !!Mdsgetdesp('FWID')
-- Check if the Support Atta is a SHOE Type by Checking for the dkey 'FWID' (Flange Width)
    if (!despnum neq 0) then
-- Dkey 'FWID' exists at the Dataset
      !despval =  despar num $!despnum
      pin 1 distance ($!despval[1] / 2 + $!clearance)
      pin 2 distance ($!despval[1] / 2 + $!clearance)
    else
      if !Ancdef.Clge.eq('GEOM') then
         --<k.pleschner>May06 use clearance from geometry
         pin 1 plane pin 1 clear $!clearance beh $!atta
         pin 2 plane pin 2 clear $!clearance beh $!atta
      else
         --<k.pleschner>May06 use distance from centreline
         pin 1 plane pin 1 distance $!clearance
         pin 2 plane pin 2 distance $!clearance
      endif
    endif

-- Navigate back to the Packing Piece
    !!ce = !pack
--< Modified - <wd> - 2sep1998
------------------------------

-------------------------
-------------------------
-- Packing Piece Type 'A'
-------------------------
-------------------------
    if (!select eq 'A') then
      extend start thro pin 2
      extend end thro pin 1

--<wd>-nov2002
      if (!form.eq(!!mdsft14)) then
        if (!support.mirror and !support.rotatecur.not() or !support.mirror.not() and !support.rotatecur) then
        --if (!support.mirror.not() and !support.rotatecur) then
          flip
          !orthpadir = !orthpldir.opposite()
          pin 6 dir $!orthpadir
          pin 6 plane pin 6 clear beh $!xbar
          move $!orthpadir clear 0 beh pin 6
          !!ce = !atta
          !pldiropp = !pldir.opposite()
          move along $!pldiropp thro pin 6
          move along $!pldiropp dist $!hbmk
          !!ce = !pack
        elseif (!support.mirror.not() and !support.rotatecur.not() or !support.mirror and !support.rotatecur) then
          move $!padir clear 0 inf pin 7
          !!ce = !atta
          move along $!pldir thro pin 7
          move along $!pldir dist $!hbmk
          !!ce = !pack
        endif
--<wd>-nov2002

      elseif (!support.mirror and !support.rotatecur.not() or !support.mirror.not() and !support.rotatecur) then
        move $!padir clear 0 inf pin 7
      else
        if (!support.mirror and !support.rotatecur.not() or !support.mirror.not() and !support.rotatecur) then
          flip
          move $!padir clear 0 inf pin 7
        endif
      endif

 -----------------

      if (!support.type eq 'FT17') then
        if (!support.mirror) then
          move $!padir clear 0 inf pin 7
        endif
      endif

 -----------------
--> Modified -<wd>- 1sep1998
      if (!support.type inset ('FT05')) then
        if (!sap10dir eq !gdir) then
          flip
        endif
      elseif (!support.type inset ('FT06')) then
        if (!sap10dir neq !gdir) then
          flip
          move $!ddir clear 0 beh p9 of $!atta
        endif
      endif
--< Modified -<wd>- 1sep1998
 -----------------

-------------------------
-------------------------
-- Packing Piece Type 'B'
-------------------------
-------------------------
    elseif (!select eq 'B') then

      extend start thro pin 1
      extend end thro pin 2

      if (!support.type eq 'FT17') then
        if (!support.mirror) then
          flip
        endif

--------------------------------------------------------------------------------
-->>>-<wd>-nov2002
      elseif (!form.eq(!!mdsft14)) then
        if (!support.mirror and !support.rotatecur) then
-- Leg Size of Angle
          !const = !!kstrreal('const dist pin 4 to plane pin 6')
-- Thickness of Angle
          !thkns = (!const - !pin4pin8dist)
-- Move Packer into the Correct Position
          move $!pldir clear 0 beh $!xbar
          move $!pldir dist -$!pin4pin8dist
-- Move Atta into Correct Position
          !!ce = !atta
          pin 7 plane pin 7 clear 0 beh $!pack
          pin 7 dist -$!hbmk
          move along $!padir thro pin 7
-- Navigate To Packer
          !!ce = !pack

        elseif (!support.mirror and !support.rotatecur.not() or !support.mirror.not() and !support.rotatecur) then
          flip
-- Leg Size of Angle
          !const = !!kstrreal('const dist pin 4 to plane pin 6')
-- Thickness of Angle
          !thkns = (!const - !pin4pin8dist)

          if (!support.mirror and !support.rotatecur.not() ) then
-- Move Packer into the Correct Position
            move $!padir clear 0 beh $!xbar
            move $!pldir dist $!pin4pin8dist
          elseif (!support.mirror.not() and !support.rotatecur) then
            move $!pldir clear 0 inf $!xbar
            move $!pldir dist $!thkns
          endif
-- Move Atta into Correct Position
          !!ce = !atta
          pin 7 plane pin 7 clear 0 inf $!pack
          pin 7 dist $!hbmk
          move along $!padir thro pin 7
-- Navigate To Packer
          !!ce = !pack

        endif
--<<<-<wd>-nov2002

      else
        if (!support.mirror and !support.rotatecur.not() or !support.mirror.not() and !support.rotatecur) then
          flip
        endif
      endif

 -----------------
--> Modified -<wd>- 1sep1998
      if (!support.type inset ('FT05')) then
        if (!sap10dir eq !gdir) then
          flip
        endif
      elseif (!support.type inset ('FT06')) then
        if (!sap10dir eq !gdir) then
          move $!ddir clear 0 beh p9 of $!atta
        else
          flip
          move $!ddir clear 0 beh p9 of $!atta
        endif
      endif
--< Modified -<wd>- 1sep1998

    endif


    !!MdsDacControl(true)
    !!ce = !pack
    !derlen  = deri len
    !sctnlen = !derlen
    despar $!sctnlen $!select $!selection $!clearance

--<wd>mar2007<mds12> -- Set DESPARS at the SREF ATTA for Independant STRUCTURE "FT25" ONLY
    if (!form eq !!mdsft25) then
      !!ce = $!<name>/SREF
      despar $!sctnlen $!select $!selection $!clearance
      !!ce = !pack
    endif
--<wd>mar2007<mds12>


    !!MdsDacControl(false)
  -- Reset materials of sections

    !!MdsResetMat(!StoreMat)

    if (!support.type inset ('FT17')) then
      if (!rotft17) then
          !form.support.rotatecur = true
          !!Mdsft25.support.rotatecur = true
          !support = !!Mdsft25.support
          !rotft17 = false
      endif
    endif

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Common Code for all Packing Pieces and Cross Bar Sections
--------------------------------------------------------------------------------
   !!MdsDacControl(true)
-- Navigate to the Atta and set the Packing Piece Reference to the Correct name
    !!ce = !atta
    if (!enam) then
      :MDSPackRef $!ppnam
    else
      :MDSPackRef $!<name>-PP-$!<cnt>
    endif
    !!ce = !pack
    :MDSAttaRef $!atta.name

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--$P-------------------------------
--$P !TYPE is **$!<type>**
--$P !FORM is **$!<form>**
--$P-------------------------------

-- Adjust for slope on horizontal lines only
    if (!type eq 'HORI')then
-- Check to see if the line is sloping
--wd<oct2002>
      --if (!form eq !!Mdsft25) then
--wd<oct2002>
        !adjust = 0
        !!ce = !datum
        !grad = pl grad

--wd<oct2002>
        if (!form eq !!Mdsft25) then
          !ref = !datum.:MDSPackRef
        else
          !ref = !atta.:MDSPackRef
        endif

-- q var !grad
-- $P**********
        if (!grad neq 0)then
          !strucelement = array()
          if (!form eq !!Mdsft25) then
            !packatta = !datum
          else
            !packatta = !atta
          endif
--wd<oct2002>

          !strucelement.append(!Ref)
--wd<oct2002>
          --!vheight = !!Mdsadjustslope(!strucelement, !datum)
          !vheight = !!Mdsadjustslope(!strucelement, !packatta)
--wd<oct2002>
        else
          !vheight = 0
        endif

        if (!vheight gt !adjust)then
          !adjust = !vheight
        endif

--$P-------------------------------
--$P !ADJUST is $!adjust
--$P-------------------------------
-- Adjust Height of Packing Pieces
--wd<oct2002>
        --!!ce = !datum.:MDSPackRef
        !!ce = !ref
--wd<oct2002>
        move d wrt world dist $!adjust

--wd<oct2002>
      --endif
--wd<oct2002>
    endif

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- Append NEW Packing Piece to the 'FT25 Support' Object ARRAY
    !support.packs.append(!pack)

-- Find and Remove Badrefs in !support.packs ARRAY
    !packers =  !support.packs
-- Find Packing Piece Badrefs
    do !xpak index !packers
      if (!packers[!xpak].badref()) then
        !store = array()
        !store.append(!support.packs.remove(!xpak))
        handle any
          skip
        endhandle
     endif
    enddo
-- Remove Badrefs from the ARRAY
    do !xdel index !store
      !store[!xdel]
      handle any
        skip
      endhandle
    enddo

-- Check to see if support is mirrored
    if (!form eq !!Mdsft25) then
      if (!support.mirror) then
        if (!type eq 'VERT') then
          call !!Mdsmirrorft25(!!Mdsft25, 'OWNER')
          !support.mirror = true
        endif
      endif
    endif

-- Set '!form.Support' Object ARRAY to the NEW 'FT25' Packing Piece ARRAY
-- if called via a Framework Type other than 'FT25'
    if (!form.string().upcase() ne 'MdsFT25') then
      !form.support.packs = !support.packs
    endif
-- Set OK button active when Packing Piece has been built
    !!Mdsft25.ok.active = true

--------------------------------------------------------------------------------
 -- Move Aid Text
    !!ce = !datum
    !pos = !!ce.pos.wrt(world)
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!POS$>

-- Navigate to Main Structure of Framework
    !!CE = !Stru

-- Enhance elements using colour set for highlight
    !ColourList = array()
    !ColourList.append(!!CE)
    !ColourList.appendarray(!Support.Atta)

-- Colour Support
    call !!KEnhanceList(!ColourList)

-- Reset all pins associated with this support
    call !!MdsResetPins(1,10)

-- Update support data held in form
    !!Mdsft25.Support = !Support


    !!ce = !Support.stru
    -- Copy welds locally
    !CopyWelds = object MdsWeldList(!!ce,!form)
    !!ce = !Support.stru

-- Remove Prompt from Status Bar
    !!MdsCreateMess(false)

---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
--<wd>jun2007<mds12>
-- Create Associations for an Independant MDS Support STRUCTURE "FT25" ONLY
    if (!form eq !!mdsft25) then
-- Create the Cross Reference ASSOCIATIONS between the MDS SUPPORT SCTN members $!name-BAR-1
-- and the Main Structure supporting elements for:
-- <a> CLEARANCE mode !pick3
--
-- Store the Original Current Element
      !xce = !!ce

-- Store the Array of MDS Support Members in the MDSASSOC Object
      !mdsassoc.mdsmember[1] = $!name-BAR-1

-- Initialising the MDSASSOWL object always DELETES ALL of the EXISTING Cross Reference Associations
-- (ASSOC) elements for the Current MDS Support, irrespective of the Creation MODE (!method)
      !mdsassowl = object mdsassowl(!form)
      !mdsassowl.mdsform  = !form
      !mdsassowl.mdsassoc = !mdsassoc

-- Create the Association (ASSOCs) for the Current Support
      !mdsassowl.mdsassoc(!mdsassoc)

-- Update the FORM SUPPORT object to reference the current MDSASSOWL Associations object
      !form.support.associations[1] = !mdsassowl
      !support = !form.support

-- Navigate back to the Original Current Element
      !!ce = !xce
    endif
--<wd>jun2007<mds12>
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------

-- Reset Units
    !!kRestoreUnits(!currentunits)

    !!MdsDacControl(false)

-- End function
  endfunction

-- End of file Mdscreateft25.pml
