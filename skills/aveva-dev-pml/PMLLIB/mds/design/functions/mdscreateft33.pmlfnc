--
-- File:  mdscreateft33.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MPS138
--
-- Author:  I.osborne
-- Created:  Tue Jul 22
--
--
-- Description:
-- function to create support frame type 33
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCreateFt33(!method is STRING)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  call !!mdsResetPins(1,10)

  !support   = !!mdsFt33.support
  --!clearance = !!mdsOptions.clear.val
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !slide     = !!mdsFt33.slide.selection('Rtext')
  !datum     = !support.datum
  !stru      = !support.stru
  !name      = !stru.name
  !p10Dir    = !support.p10Dir
  !p11Dir    = !support.p11Dir
  !pLDir     = !support.pLDir
  !pADir     = !support.pADir
  !alias     = !support.alias
  !p9dir     = !support.p9dir
  --<k.pleschner>May06
  !datumDflts = object MDSANCGEOMDFLTS(!datum)
  !clearance = !datumDflts.cend
  --<k.pleschner>May06

  var !pjoiColl coll all pjoi with gtyp eq 'APAD' for $!stru
  if !pjoiColl.size().neq(0) then
    !padsExist = TRUE
  else
    !padsExist = FALSE
  endif

  -- Does the support have attached/Associated supports

  if !!mdsgetconnectedsupp(!stru) then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Get configuration support is to be built to.
  !config = !!mdsFt33.slide.val.real()

  !form = !!mdsFt33

  --<wd>jun2007<mds12>
  -- Initialise the MDS Associations Data Creation Object MDSASSOC
  !mdsassoc = object MDSASSOC()
  !mdsassoc.mode = !method
  --<wd>jun2007<mds12>

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru

  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  --!haveJoints = FALSE

  ------------------------------------------------------------------------------------------------------
  --<wd>nov2003>>>
  ------------------------------------------------------------------------------------------------------
  -- The CODE below has been MOVED to near the BOTTOM of this function. This ENSURES that the CHECKING
  -- is PERFORMED on the CURRENT 'DIMENSION' values and NOT the PREVIOUS values.
  -- This is MORE CRITICAL when CREATING by CURSOR or CLEARANCE rather than by DIMENSIONS
$(
  -- Check if ATTAS Created on The Support are Within the Allowable Bores for the STRUCTURE SCTN SIZES.
  !cecomp = !!ce
  !error  = STRING()
  if (!!mdscheckbores(!form,!selection,!error,!currentUnits)) then
    !!alert.error(!error)
    !!ce = !stru
    delete STRU MEM
    handle (41,66) (2,113) (2,113)
    endhandle
    !!ce = !cecomp
    handle any
    endhandle
    !!kRestoreUnits(!currentUnits)
    return
  endif
$)
  ------------------------------------------------------------------------------------------------------
  --<wd>nov2003<<<
  ------------------------------------------------------------------------------------------------------

  -- Check configuration against method of creation
  if (!method eq 'DIMENSION')then
    if (!config.gt(3))then
      !!alert.warning('Cannot create this configuration by Dimensions. Use Create by Cursor.')
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endif

  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Check that Datum atta has been positioned
  if (!support.position.not())then
    !!alert.message('Position atta before identifying supporting steelwork')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  ------------------------------------------------------------------------------------------------------
  --<wd>aug2007<mds12>
  -- ENSURE ALL the current MDS SNIPES(FITTINGS) that EXIST on the current MDS STRUCTURE SCTN elements are STORED,
  -- so "UPDATE" the FORM MDSSUPPORT object member "!form.support.mdssctns" to represent the current MDS STRUCTURE.
  -- *** IMPORTANT*** The object needs to be UPDATED before CREATIIN/MODIFICATION of the MDS STRUCTURE commences,
  -- as ADDITIONAL MDS SNIPES may have been ADDED/MODIFIED/DELETED by the USER since the FORM was initialised,
  -- via the !!mdsSnipe form utility from the MAIN "MDS DESIGN application" BAR menu option... "Modify>Snipe on Angle..."
  --
  -- REGENERATE the DATA stored in the FORM MDSSUPPORT object member "!form.support.mdssctns"
  -- for ALL of the current MDS Support SCTNS and ALL the associated MDS SNIPE(FITTING) members
  !!mdssupportsctns(!form)

  -- UPDATE the local !support object variable with the latest MDSSNIPE DATA
  !support.mdssctns      = !form.support.mdssctns
  !support.mdssctnsstore = !form.support.mdssctnsstore

  --<wd>aug2007<mds12>
  ------------------------------------------------------------------------------------------------------

  -- Check which attas to work from
  if (!support.bars.size().leq(1))then
    !atta = !support.atta
  else
    !atta = !support.bars[1]
  endif

  -- Set initial orientation
  !ddir = D wrt world
  !udir = U wrt world

  -- Store section name and matref for each member
  -- for resetting later

  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)


  -- Get general direction of pleave of datum atta
  -- Plane direction is nearest value to 1

  !up = (abs(!pLDir.up))
  !east = (abs(!pLDir.east))
  !north = (abs(!pLDir.north))
  !max = max((abs(!up)), (abs(!east)), (abs(!north)))
  if (!max.eq(!up))then
    !planeDir = U wrt world
  elseif (!max.eq(!east))then
    !planeDir = E wrt world
  else
    !planeDir = N wrt world
  endif

  -- Determine the general Pleave direction of the datum atta
  PIN 1 COPY PL OF $!datum
  PIN 1 plane PIN 1 CLEAR 0 BEH $!datum
  PIN 1 DIR $!planeDir
  PIN 2 COPY PIN 1
  PIN 2 plane PIN 2 THRO $!datum
  --VAR !genPLDir CONS DIR PIN 2 TO PIN 1
  PIN 1 OFF
  PIN 2 OFF

  -- Generate pin positions for each creation type
  if (!method eq |CURSOR|)then

    -- Check for Configs 6,7 and 8 - NO External Connections
    -- possible for MDS frames attached to FT22 Bedplates.

    if (!support.config.lt(6)) then

      !errorMessage = STRING()
      if(!!mdsCheckConns(!form, !errorMessage).eq('UNJOINTED')) then
        -- nothing to do
      elseif(!!mdsCheckConns(!form, !errorMessage).eq('WARNING')) then
        !continue = !!alert.confirm(!errorMessage)
        if(!continue.eq('NO')) then
          return
        else
          !!mdsSelectJoints(!form,'DISCONNECT','')
          !support.joints.clear()
        endif
      elseif(!!mdsCheckConns(!form, !errorMessage).eq('ERROR')) then
        !!alert.error(!errorMessage)
        !!kRestoreUnits(!currentUnits)
        return
      else
        -- continue
        !!mdsSelectJoints(!form,'DISCONNECT','')
        !support.joints.clear()
      endif
    endif

    label /Element1

    --<wd>may2007<mds12>
    !session  = current session
    --<wd>may2007<mds12>

    PROMPT OFF
    if (!config.eq(6) or !config.eq(7) or !config.eq(8)) then
      !iDType = 'BOX'
      prompt load escape |Identify Bed Plate to support from|
    else

      --<wd>may2007<mds12>
      --    !iDType = 'GENSEC SCTN'
      if !session.module().upcase().match('DESIGN').gt(0) then
        !iDType = 'GENSEC SCTN'
      elseif  !session.module().upcase().match('OUTFITTING').gt(0) then
        !iDType = 'GENSEC SCTN HSTIFF'
      endif
      --<wd>may2007<mds12>

      PROMPT LOAD ESCAPE |Identify Section to support from|
    endif

    ID $!iDType @
    handle (61,528)
      PROMPT ON
      !!ce = !stru
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    PROMPT DISMISS
    PROMPT ON

    !pick = !!ce

    --------------------------------------------------
    -- Check if Picked BOX is a FT22 Bed Plate for configs 6,7 and 8
    if (!pick.type.eq('BOX')) then
      if (!pick.owner.owner.:MDSSuppType.trim().neq('FT22')) then
        !krealnum = !!mdsframe.standard.rtext.findfirst('FT22')
        handle any
          golabel /ERROR
        endhandle
        !kdescrip = !!mdsframe.standard.dtext[!krealnum]
        handle any
          golabel /ERROR
        endhandle
        !!alert.error('The identified ELEMENT is NOT a $!<kdescrip>')
        golabel /Element1
        label /ERROR
        !!alert.error('The identified ELEMENT is NOT a MDS BedPlate')
        golabel /Element1
      endif

      -- The Code BELOW is OK when the idtype is a FT22 BEDPLATE BOX

      if (!config.eq(6) or !config.eq(7) or !config.eq(8)) then
        !testCe = !!mdsFt33tobpl(!!mdsFt33, !datum, !pick, !p10Dir, !clearance.real())
        if (!testCe[1].eq(''))then
          !!alert.error('Identified Bed Plate is unsuitable for the selected Support Configuration.')
          golabel /Element1
        endif
        if (!config.eq(6) or !config.eq(8)) then
          if (!testCe[1].upcase().eq('PARALLEL')) then
            if (!testCe[2].upcase().eq('LEFT')) then
              !columnDir  = !p11Dir
              !freeEndDir = !p10Dir
              !support.rotateCur =  false
            elseif (!testCe[2].upcase().eq('RIGHT')) then
              !columnDir  = !p10Dir
              !freeEndDir = !p11Dir
              !support.rotateCur = true
            elseif (!testCe[2].upcase().eq('UNSET')) then
              !!alert.error('Identified Bed Plate is unsuitable for the selected Support Configuration.')
              golabel /Element1
            endif
          endif
        elseif (!config.eq(7)) then
          if (!testCe[1].upcase().eq('RIGHTANGLE')) then
            if (!testCe[2].upcase().eq('LEFT')) then
              !columnDir  = !p11Dir
              !freeEndDir = !p10Dir
              !support.rotateCur = true
            elseif (!testCe[2].upcase().eq('RIGHT')) then
              !columnDir  = !p10Dir
              !freeEndDir = !p11Dir
              !support.rotateCur = false
            elseif (!testCe[2].upcase().eq('UNSET')) then
              !!alert.error('Identified Bed Plate is unsuitable for the selected Support Configuration.')
              golabel /Element1
            endif
          endif
        endif
      endif
      --------------------------------------------------
      --------------------------------------------------

      -- For MDS Support type 'FT33' ONLY the UDA ':MDSBpref1' is considered
      if (!pick.owner.owner.:MDSBpref1.badref().not()) then
        if (!!alert.confirm('The identified Bed Plate is already referenced by another MDS Support. Do you wish to modify this reference to the current Support and Continue?').eq('NO')) then
          golabel /Element1
        else
          -- Store BedPlate Variables etc. in case Support is Cancelled
          -- Navigate to Structure/Atta
          !!ce    = !pick.owner.owner.:MDSBpref1
          !bpref1 = !!ce.:MDSBpref1
          !!mdsFt33.strubpref.append(!!ce)
          !!mdsFt33.storebpref.append(':MDSBpref1 $!bpref1')
          -- Unset Structure/Atta BedPlate Reference
          :MDSBpref1 default
          -- Navigate to BedPlate
          !!ce   = !pick.owner.owner
          !stref = !!ce.:MDSBpref1
          !!mdsFt33.strubpref.append(!!ce)
          !!mdsFt33.storebpref.append(':MDSBpref1 $!stref')
          -- Unset Current BedPlate Structure/Atta Reference
          :MDSBpref1 default
        endif
      else
        -- Store Default Value for Current STRU BedPlate Reference
        !!mdsFt33.strubpref.append(!pick.owner.owner)
        !!mdsFt33.storebpref.append(':MDSBpref1 default')
      endif

      -- Set New reference at the BedPlate
      !!ce     = !pick.owner.owner
      !newbedp = !!ce
      if (!!mdsFt33.name.val.match('/').eq(1)) then
        !newstru = !!mdsFt33.name.val.dbref()
      else
        !xxxstru = '/' & !!mdsFt33.name.val
        !newstru = !xxxstru.dbref()
      endif
      :MDSBpref1  $!newstru
      -- Set New reference at the Support Structure
      !!ce     = !newstru
      :MDSBpref1 $!newbedp

      -- Position Pins for Picked FT22 BedPlate
      !!mdsCreateMess(true)

      !plane = !testCe[3]
      var !pdir cons dir $!plane
      pin 1 at $!pick
      pin 1 dir $!pdir
      var !tempinter cons pos int pin 1 $!plane
      !inter = !tempinter.position()
      pin 8 at p9 of $!datum
      pin 8 dir $!columnDir
      var !pin8Pos pin 8 pos wrt world

      --<wd>jun2007<mds12>
      -- Save !pick and for Associations
      !mdsassoc.pick1 = !pick
      --<wd>jun2007<mds12>

      pin 9 at $!inter
      pin 9 dir $!ddir
      pin 5 copy pin 9
      pin 10 at pin 8
      pin 10 dir $!columnDir
      pin 10 plane pin 10 clear 0 infront $!pick

      -- Position Pin 9 with Overlap on BedPlate at 'Column End' of FT33
      if (!config.eq(6) or !config.eq(8)) then
        pin 9 copy pin 10
        !!ce = /MDS/FT33/$!selection-BAR-1
        !overLap = deri len
        same
        pin 9 dist $!overLap
      elseif (!config.eq(7)) then
        pin 9 copy pin 10
      endif

      -- Position Pin 4 at Free End of FT33
      pin 4 copy pin 8
      pin 4 dir $!freeEndDir
      !dim = 0

      !!ce = /MDS/FT33/$!selection-BAR-1
      !override = :MDSOlap
      if !override.eq('OVERLAP') then
        !clearance = :MDSOnum
      endif
      same
      -- q var !clearance

      --<k.pleschner>May06
      --do !i values !atta
      do !iref values !atta
        -- avoid SREF atta
        skip if !iref.name.substring(-1,-5).eq('/SREF')
        !i = object MDSANCGEOMDFLTS(!iref)

        --pin 4 plane pin 4 clear $!clearance beh $!i
        if !i.clge.eq('GEOM') then
          -- use clearance from geometry
          PIN 4 plane PIN 4 CLEAR $!i.oend BEH $!i
        else
          -- use distance from centreline
          PIN 4 plane PIN 4 THR $!i
          PIN 4 plane PIN 4 DIST $!i.oend
        endif
        handle (2,109)
          break
        endhandle
        var !cdir const dir pin 8 to pin 4
        !cdim = !!kStrReal('const dist pin 8 to pin 4')

        -- Set object definition
        !direction = object KEQUALDIR()
        !direction.directionA = !cdir.direction()
        !direction.directionB = !freeEndDir
        !direction.tolerance  = 0.05

        if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
          pin 4 at pin 8
          pin 4 dist $!cdim
          !dim = !cdim
        else
          pin 4 at pin 8
          pin 4 dist $!dim
        endif
      enddo

      --RETURN
      --------------------------------------------------
      -- The Code BELOW is OK when the idtype is a SCTN

      --<wd>may2007<mds12>
      --      elseif (!pick.type.eq('SCTN') or !pick.hardType.eq('GENSEC')) then
    elseif (!pick.type.eq('SCTN') or !pick.hardType.eq('GENSEC') or !pick.type.eq('HSTIFF')) then
      --<wd>may2007<mds12>

      ------------------- ***** Connexions *****-------------------
      --$(
      !support.connections[1] = !pick
      -- !!mdsFt33.lineUp.active = False
      --$)
      !testCe = !!mdsRelToDatum(!datum, !pick, !p10Dir, !clearance.real())
      if (!testCe[1].upcase() eq 'UNSET')then
        !!alert.error('Identified element is unsuitable to support from.')
        golabel /Element1
      elseif (!testCe[1].upcase() eq '')then
        golabel /Element1
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is in line with the datum atta')
        golabel /Element1
      elseif (!testCe[1].upcase() eq 'ABOVE')then
        !columnDir  = !p11Dir
        !freeEndDir = !p10Dir
        !support.rotateCur = true
      elseif (!testCe[1].upcase() eq 'BELOW')then
        !columnDir  = !p10Dir
        !freeEndDir = !p11Dir
        !support.rotateCur = false
      endif

      ---------------------------------------------------------------------------------------------------
      !!ce = !pick

      -- Check to see if picked section is a beam or a column
      !posstart = Posstart
      !posend   = posend
      VAR !dir CONS DIR $!posstart to $!posend

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !dir.direction()
      !direction.directionB = !udir
      !direction.tolerance  = 0.05

      if (!!kDirEqualDir(!direction)) then
        !pickedType = 'COLUMN'
      endif

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !dir.direction()
      !direction.directionB = !ddir
      !direction.tolerance  = 0.05

      if (!!kDirEqualDir(!direction)) then
        !pickedType = 'COLUMN'
      endif

      if (undefined(!pickedType)) then
        !pickedType = 'BEAM'
      endif
      ---------------------------------------------------------------------------------------------------

      -- Check configuration of support against picked type

      if (!config.eq(4) or !config.eq(5))then
        if (!pickedType eq 'COLUMN') then
          !!alert.error('Identified section must be a beam for this configuration.')
          !!ce = !stru
          !!kRestoreUnits(!currentUnits)
          return
        endif
      else
        if (!pickedType eq 'BEAM')then
          !!alert.error('Identified section must be a column for this configuration.')
          !!ce = !stru
          !!kRestoreUnits(!currentUnits)
          return
        endif
      endif

      -- Position Pins

      !!mdsCreateMess(true)

      -- Connection to element picked

      PIN 8 AT P9 of $!datum
      PIN 8 DIR $!columnDir
      VAR !pin8Pos PIN 8 POS WRT WORLD

      -- See if we are connecting to the web or flange of the section
      -- ONLY FOR CONFIGURATION 1

      -- Set object definition
      if (!config.eq(1))then
        !inter = !!kFlangeOrWeb(!pick, !pin8Pos.position(), !columnDir)
      else
        -- Get closest point on section picked
        !array = !!kClosestPline(!pick, !pin8Pos.position(), !columnDir)
        !inter = !array[2]
      endif

      --<wd>jun2007<mds12>
      -- Save !pick and for Associations
      !mdsassoc.pick1 = !pick
      --<wd>jun2007<mds12>

      PIN 9 AT $!inter
      PIN 9 DIR $!columnDir

      if (!pADir eq !udir or !pLDir eq !udir)then
        if (!config.lt(4))then
          !!mdsCreateMess(false)
          !!alert.warning('Cannot automatically align support to column. Position support manually')
        endif
        if (!config.eq(2) or !config.eq(3))then
          -- Reposition pin 9 the required overlap on the column
          !!ce = /MDS/FT33/$!selection-BAR-1
          !overLap = DERI LEN
          SAME
          PIN 9 plane PIN 9 DIST $!overLap
        endif
      endif

      -- Free end

      PIN 8 DIR $!freeEndDir
      PIN 4 copy PIN 8
      !dim = 0

      !!ce = /MDS/FT33/$!selection-BAR-1
      !override = :MDSOlap
      if !override.eq('OVERLAP') then
        !clearance = :MDSOnum
      endif
      same
      -- q var !clearance
      --<k.pleschner>May06
      --do !i values !atta
      do !iref values !atta
        -- avoid SREF atta
        skip if !iref.name.substring(-1,-5).eq('/SREF')
        !i = object MDSANCGEOMDFLTS(!iref)
        --PIN 4 plane PIN 4 CLEAR $!clearance BEH $!i
        if !i.clge.eq('GEOM') then
          -- use clearance from geometry
          PIN 4 plane PIN 4 CLEAR $!i.oend BEH $!i
        else
          -- use distance from centreline
          PIN 4 plane PIN 4 THR $!i
          PIN 4 plane PIN 4 DIST $!i.oend
        endif
        handle (2,109)
          break
        endhandle
        VAR !cdir CONST DIR PIN 8 TO PIN 4
        !cdim = !!kStrReal('CONST DIST PIN 8 TO PIN 4')

        -- Set object definition
        !direction = object KEQUALDIR()
        !direction.directionA = !cdir.direction()
        !direction.directionB = !freeEndDir
        !direction.tolerance  = 0.05

        if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
          PIN 4 AT PIN 8
          PIN 4 DIST $!cdim
          !dim = !cdim
        else
          PIN 4 AT PIN 8
          PIN 4 DIST $!dim
        endif
      enddo

      -- Position pins for configuration 4 and 5
      if (!config.eq(4) or !config.eq(5))then

        -- Check that the datum atta is above the bottom flange of the beam
        VAR !pin9Pos PIN 9 POS WRT WORLD
        !array = !!kFarPline(!pick, !pin9Pos.position(), !udir)
        PIN 1 AT $!array[2]
        VAR !pin1Pos PIN 1 POS WRT WORLD
        !array = !!kFarPline(!pick, !pin1Pos.position(), !udir)
        PIN 2 AT $!array[2]
        VAR !pin2Pos PIN 2 POS WRT WORLD

        -- Test that the datum atta is above bottom of beam
        if (!config.eq(5))then
          !lowest = min(!pin1Pos.position().up, !pin2Pos.position().up)
          if (!lowest.gt(!pin9Pos.position().up))then
            if (!pADir neq !udir and !pLDir neq !udir)then

              -- Reset all pins used so far
              call !!mdsResetPins(1,10)
              !!mdsCreateMess(false)
              !!alert.error('Datum atta must be above lowest point on beam')
              !!kRestoreUnits(!currentUnits)
              return
            endif
          endif

          -- Position pin 7 at lowest point and pin 9 at mid point of beam
          PIN 7 COPY PIN 1
          PIN 7 DIR $!ddir
          if (!lowest.eq(!pin2Pos.position().up))then
            PIN 7 plane PIN 7 THRO PIN 2
          endif
          !d21 = !!kStrReal('CONST DIST PIN 2 TO PIN 1')
          PIN 9 DIR $!ddir
          PIN 9 plane PIN 9 THRO PIN 7
          PIN 9 DIR $!udir
          PIN 9 DIST ($!d21 / 2)
          PIN 9 DIR $!columnDir
        endif
        VAR !pin9Pos PIN 9 POS WRT WORLD
        !array = !!kClosestPline(!pick, !pin1Pos.position(), !udir)
        PIN 1 AT $!array[4]
        !array = !!kClosestPline(!pick, !pin2Pos.position(), !udir)
        PIN 2 AT $!array[4]
        PIN 1 DIR TO PIN 2
        PIN 2 DIR TO PIN 1
        PIN 3 COPY PIN 2
        PIN 3 plane PIN 3 THRO PIN 9
        !d23 = !!kStrReal('CONST DIST PIN 2 TO PIN 3')
        !d31 = !!kStrReal('CONST DIST PIN 3 TO PIN 1')
        !d21 = !!kStrReal('CONST DIST PIN 2 TO PIN 1')
        !diff = ((!d21 - (!d23 * 2)) / 2)

        -- Test that cross bar will locate on the web of the beam
        if (!config.eq(4))then
          !sum = !d31 + !d23
          if (!!kRealEqualReal(!sum, !d21, 0.5).not())then
            if (!pADir eq !udir or !pLDir eq !udir)then
              -- Use middle of beam
              PIN 3 COPY PIN 2
              PIN 3 DIST ($!d21 / 2)
              !diff = 0
            else
              -- Reset all pins associated with this support
              call !!mdsResetPins(1,10)

              !!alert.error('Support is outside the depth of the identified section')
              !!ce = !stru
              !!mdsCreateMess(false)
              !!kRestoreUnits(!currentUnits)
              return
            endif
          endif
        endif

        PIN 3 plane PIN 3 DIST $!diff
        PIN 5 COPY PIN 9
        PIN 5 plane PIN 5 THRO $!pick
        PIN 5 DIR FROM PIN 5 TO PIN 9

        -- Get position on web
        VAR !pin5Pos PIN 5 POS WRT WORLD

        !array = !!kOrderPlinePos(!pick, !pin5Pos.position(), !columnDir)

        do !i from 2 to !array.size() by 2

          PIN 6 AT $!array[$!i]
          !tempDist = !!kStrReal('CONST DIST PIN 5 TO PIN 6')

          skip if (!tempDist.eq(0))

          VAR !testDir CONS DIR $!array[$!i] to $!pin5Pos

          -- Test to see if constructed direction equals the direction from the datum
          -- to the column.
          -- If they are equal then PIN 6 is on the correct side of the web

          -- Set object definition
          !direction = object KEQUALDIR()
          !direction.directionA = !testDir.direction()
          !direction.directionB = !columnDir
          !direction.tolerance  = 0.05

          if (!!kDirEqualDir(!direction)) then
            break
          endif
        enddo

        PIN 5 plane PIN 5 THRO PIN 6
        !dist = !!kStrReal('CONST DIST PIN 5 TO PIN 9')
        PIN 5 DIST ($!dist / 2)

        -- Reposition PIN 9 to correct position
        if (!config.eq(4))then
          PIN 9 plane PIN 9 THRO PIN 6
        else
          PIN 9 plane PIN 9 THRO $!pick

          -- Get Overlap required on connection from template
          !!ce = /MDS/FT33/$!selection-BAR-1
          !overLap = DERI LEN
          SAME
          PIN 9 DIST $!overLap
        endif
      endif

    endif
    --<wd>jan2000

  elseif (!method eq |DIMENSION|)then

    -- Initialise variables for dimension check
    !d1 = !!mdsFt33.dim1.val
    !d2 = !!mdsFt33.dim2.val

    if (!d1.eq(0) or !d2.eq(0)) then
      !!alert.error('Not all of the dimensions have been completed.')
      !!kRestoreUnits(!currentUnits)
      return
    endif

    if (!d1.gt(!d2)) then
      !!alert.error('Cannot create from given dimensions. Dim 1 must be less than Dim 2.')
      !!kRestoreUnits(!currentUnits)
      return
    endif

    !!mdsCreateMess(true)

    -- Get correct orientation
    if (!support.rotateCur)then
      !columnDir  = !p11Dir
      !freeEndDir = !p10Dir
    else
      !columnDir  = !p10Dir
      !freeEndDir = !p11Dir
    endif

    -- Position pins

    !!ce = !datum
    PIN 9 COPY P9
    PIN 9 DIR $!columnDir
    PIN 8 COPY PIN9
    PIN 8 DIR $!freeEndDir

    PIN 9 plane PIN 9 THRO CE
    PIN 8 plane PIN 8 THRO CE
    PIN 9 DIST $!d1
    PIN 4 COPY PIN 8
    PIN 4 DIST ($!d2 - $!d1)

  endif

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  -- Create and ARRAY of Attas with Packing Pieces (PDMS Names ONLY)
  -- and the Type and Size of the Packing Pieces to Recreate
  !attapp = !!mdspackers(!support)

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  !!ce = !stru
  --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
  !!mdsRemoveAutoPadRules(!stru)
  --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end

  -- Pins now in position create framework

  delete STRU MEM
  handle (41,66) (2,113) (2,113)
  endhandle

  --<wd>oct2000
  !mdstemp = /MDS/FT33/$!selection
  :mdscheck $!mdstemp.:mdscheck
  :mdsframirror $!mdstemp.:mdsframirror

  --<wd>oct2000


  AT $!datum

  NEW FRMW $!name/MAIN
  !frmwSupport = !!ce

  -- Copy required template/s
  !!ce = /MDS/FT33/$!selection
  !desc = desc
  !mdsbars = :mdsbars
  !subs = !!kCollectAllFor('SUBS', '', !!ce)
  !frmw = !!kCollectAllFor('FRMW', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')

  -- Navigate back to support and create template elements
  !!ce = !frmwSupport
  COPY ATTRIB OF $!frmw[1]
  COPY MEM OF $!frmw[1] RENAME $!frameFormat $!name

  do !i indices !subs
    NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
    COPY MEM OF $!subs[$!i] RENAME $!frameFormat $!name
  enddo

  -- Get direction of P9 of datum atta and dist between p9 and p0

  !!ce = !stru

  -- Set stru description for template recognition

  desc '$!desc'
  :mdsbars $!mdsbars

  if (!pADir eq !udir or !pLDir eq !udir)then
    !moveDir = !support.p9Dir
    !oriz    = !support.p9Dir
    !oriz.up    = !support.p9Dir.up * -1
    !oriz.east  = !support.p9Dir.east * -1
    !oriz.north = !support.p9Dir.north * -1
  else
    !moveDir = !ddir
    !oriz    = !udir
  endif
  !orix    = !freeEndDir

  MOVE $!moveDir THRO P9 OF $!datum


  ORI X IS $!orix AND Z IS $!oriz


  -- Move stiffener plate
$(
  if (!method eq 'CURSOR')then
    -- if (!config.eq(4) or !config.eq(5))then
    -- Move subs into position
    !!ce = $!<name>/SUBS1
    MOVE $!freeEndDir THRO PIN 5
    MOVE $!udir THRO PIN 3

    -- Size stiffener to suit beam
    !!ce = first box
    ORI P6 IS $!udir
    ZLEN $!d21
    XLEN $!dist

    if (!pADir eq !udir or !pLDir eq !udir)then
      !nudgeDir = !support.p9dir
    else
      !nudgeDir = !genPLDir.direction().wrt(world)
    endif

    -- Slide stiffener to back of supporting member
    !!ce = $!<name>/SUBS1
    PIN 1 AT CE
    PIN 1 DIR $!nudgeDir

    if (!config.eq(4))then
      if (!pADir eq !udir or !pLDir eq !udir)then
        PIN 1 plane PIN 1 CLEAR 0 INF $!<name>-BAR-1
        MOVE $!nudgeDir THRO PIN 1
        PIN 1 plane PIN 1 CLEAR 0 INF CE
        MOVE $!nudgeDir THRO PIN 1
      else
        if (!support.rotateCur)then
          PIN 1 plane PIN 1 CLEAR 0 INF $!<name>-BAR-1
          MOVE $!nudgeDir THRO PIN 1
          PIN 1 plane PIN 1 CLEAR 0 INF CE
          MOVE $!nudgeDir THRO PIN 1
        else
          PIN 1 plane PIN 1 CLEAR 0 BEH $!<name>-BAR-1
          MOVE $!nudgeDir THRO PIN 1
          PIN 1 plane PIN 1 CLEAR 0 BEH CE
          MOVE $!nudgeDir THRO PIN 1
        endif
      endif
    elseif (!config.eq(5))then
      if (!pADir eq !udir or !pLDir eq !udir)then
        PIN 1 plane PIN 1 THRO $!<name>-BAR-1
      else
        PIN 1 plane PIN 1 THRO P0 of $!datum
      endif
      MOVE $!nudgeDir THRO PIN 1
    endif
    -- endif
  elseif (!method eq 'DIMENSION')then
    if (!config eq 4 or !config eq 5)then
      -- get stored data on  stiffener from form member 'STIFFENER'
      !!ce = $!<name>/SUBS1
      BOX 1
      call !!kActionCommands(!!mdsFt33.stiffener)
    endif
  endif
$)

  -- Extend and move cross bar
  !!ce = $!<name>-BAR-1
  EXTEND END THRO PIN 4
  EXTEND START THRO PIN 9

  ----------------------- ****** connexions ******* --------------------
  if(!support.connections.unset()) then
    -- dimensions are being used first
    :MDSConn default
  else
    !bar1 = !!ce
    !connected = !!mdsGetBeamConn(!support,!bar1)
    :MDSConn $!connected
  endif
  ---------------------------********************-----------------------


  if (!pADir eq !udir or !pLDir eq !udir)then
    if (!support.rotateCur)then
      -- Reorientate cross bar
      !midp = MIDP OF CE
      PIN 1 AT $!datum
      PIN 1 DIR $!moveDir
      PIN 2 AT $!midp
      PIN 2 DIR $!moveDir
      PIN 1 plane PIN 1 THRO PIN 2
      PIN 1 DIR $!freeEndDir
      PIN 1 plane PIN 1 THRO PIN 2
      PIN 1 DIR $!moveDir
      ROTATE THRO PIN 1 ABOUT PIN 1 BY 180
    endif
  endif

  -- Check to see if support is mirrored
  if (!support.mirror)then
    call !!mdsMirrorFt33()

    -- Update form directly and not variable support as the slide function
    -- may need to use this information.
    !!mdsFt33.support.mirror = true
  endif

  if (!config.eq(4) and !method eq 'CURSOR')then
    if (!pADir eq !udir or !pLDir eq !udir)then
      !!ce = !datum
      plane $!udir THRO PIN 3

      !!ce = $!<name>/SREF

      !!mdsMConn('ORI','ORI')
      POS PA AT PREV
      SAME

      !pos = !!ce.pos.wrt(world)

      $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

      do !count from 1
        $!<name>.$!count
        handle any
          break
        endhandle

        THRO PIN 3
        !pos = !!ce.pos.wrt(world)
        !num = 210 + !count

        $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!num $!count $<$!pos$>

      enddo

      -- Move support to new position
      !!ce = !stru
      MOVE $!udir THRO $!datum
$(
      -- Move stiffener back to original position
      !!ce = $!<name>/SUBS1
      MOVE $!udir THRO PIN 3
$)

    endif
  elseif (!config.eq(5) and !method eq 'CURSOR')then

    if (!pADir eq !udir or !pLDir eq !udir)then

      PIN 6 COPY PIN 7
      PIN 6 plane PIN 6 CLEAR 0 INF CE
      !drop = !!kStrReal('CONST DIST PIN 6 TO PIN 7')
      if (!drop.gt(0))then

        -- Move to correct position
        VAR !dir CONS DIR PIN 6 TO PIN 7
        !dropDir = !dir.direction().wrt(world)
        !!ce = !datum
        MOVE $!dropDir DIST $!drop
        PIN 6 plane PIN 6 THRO CE

        !!ce = $!<name>/SREF

        !!mdsMConn('ORI','ORI')
        POS PA AT PREV
        SAME

        !pos = !!ce.pos.wrt(world)

        $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pos$>

        do !count from 1
          $!<name>.$!count
          handle any
            break
          endhandle

          THRO PIN 6
          !pos = !!ce.pos.wrt(world)
          !num = 210 + !count

          $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!num $!count $<$!pos$>

        enddo

        -- Move support to new position
        !!ce = !stru
        MOVE $!dropDir THRO $!datum

$(
        -- Move stiffener back to original position
        !!ce = $!<name>/SUBS1
        MOVE $!dropDir DIST -$!drop
$)
      endif
    else
      MOVE $!ddir CLEAR 0 BEH PIN 7
    endif

  endif

  -- Set dimensions

  if (!method eq |CURSOR|)then

    -- Dimension 1
    !dim1 = !!kStrReal('CONST DIST PIN 9 TO PIN 8')
    !!mdsFt33.dim1.val = !dim1

    -- Dimension 2

    !dim2 = !!kStrReal('CONST DIST PIN 9 TO PIN 4')
    !!mdsFt33.dim2.val = !dim2

  endif

  -- Select correct spref

  !!ce = $!<name>/SREF

  --<wd>dec1999

  !!mdsDacControl(true)
  SEL SPREF WITH STYP '$!alias-$!selection' SPEC /MDF
  !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-$!selection')

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)
  !!mdsDacControl(TRUE)
  !!ce = !stru

  -- Associate attas to bar

  !list = !support.bars[1]
  !references = ''
  do !i indices !list
    !references = !references & ' ' & !list[!i].string()
  enddo

  -- Set atta references to datum cross bar
  !!ce = $!<name>-BAR-1
  :MDSAttaRef $!references
  !support.barLen[1] = deri length of CE

  -- Despar 4 will store the maximum bore size on the support

  !srefName = !!mdsFt33.support.stru.name + '/SREF'
  !!ce = !srefName.dbref()
  !largestBore = object BORE()
  !largestBore = !form.support.datum.abore
  do !loop values !!mdsFt33.support.atta
    !largestBore = !loop.abore
    if !loop.abore.gt(!largestBore) then
      !largestBore = !loop.abore
    endif
  enddo

  -- Only set the largest bore is greater than the bore already stored
  !isNow = despara 4
  if !largestBore.real().lt(!isNow[1]) then
    !largestBore = !isNow[1].bore()
  endif

  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  DESPAR $!!mdsFt33.dim1.val   $!!mdsFt33.dim2.val  $!support.barLen[1]  $!largestBore

  ------------------------------------------------------------------------------------------------------
  --<wd>nov2003>>>
  !!mdsDacControl(true)
  -- Check if ATTAS Created on The Support are Within the Allowable Bores for the STRUCTURE SCTN SIZES.
  !cecomp = !!ce
  !error  = STRING()
  if (!!mdscheckbores(!form,!selection,!error,!currentUnits)) then
    !!alert.error(!error)
    !!ce = !stru
    --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
    !!mdsRemoveAutoPadRules(!stru)
    --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end
    delete STRU MEM
    handle (41,66) (2,113) (2,113)
    endhandle
    -- Reset SREF Despars to ZERO as the STRU MEM have been DELETED
    !!ce = $!<name>/SREF
    handle none
      -- Only RESET the DESPARS for the DIMENSION GADGETS -
      -- DESPAR num 4 stores the LARGEST PIPE BORE SIZE on the SUPPORT and is still VALID
      desp num 1 0mm
      desp num 2 0mm
      desp num 3 0mm
    elsehandle any
    endhandle
    -- Reset all pins associated with this support
    !!mdsResetPins(1,9)
    !!ce = !cecomp
    handle any
    endhandle
    !!mdsCreateMess(false)
    !!kRestoreUnits(!currentUnits)
    return
  endif
  --<wd>nov2003<<<
  ------------------------------------------------------------------------------------------------------

  !!mdsDacControl(false)
  -- Reset materials of sections
  !!mdsResetMat(!storeMat)


  !!ce = !stru

  -- Move Support to correct position relative to the supporting structure

  if (!method eq 'CURSOR')then
    if (!config.lt(4))then
      if (!pADir neq !udir and !pLDir neq !udir)then
        call !!mdsSlideFt33(!slide, !pick)
      endif

      -- Select correct spref for configurations 2 and 3
      if (!config.gt(1))then
        !!ce = $!<name>/SREF
        !!mdsDacControl(true)
        SEL SPREF WITH STYP '$!alias-$!selection' SPEC /MDF
        !!mdsDacControl(false)
      endif
      !!ce = !stru
    endif
  endif

  -- Adjust for slope on horizontal lines only
  if (!pADir neq !udir and !pLDir neq !udir)then
    -- Check to see if the line is sloping
    !adjust = 0
    do !v values !atta
      !!ce = !v
      skip if !!ce.:mdsrotdir.east.set()
      !grad = pl grad
      if (!grad.neq(0))then
        !strucElement = ARRAY()
        !ref = $!name-BAR-1
        !strucElement.append(!ref)
        !vHeight = !!mdsAdjustSlope(!strucElement, !v)
      else
        !vHeight = 0
      endif
      if (!vHeight.gt(!adjust))then
        !adjust = !vHeight
      endif
    enddo

    if (!adjust.neq(0))then
      -- Adjust required elements
      !!ce = $!<name>-BAR-1
      MOVE $!ddir DIST $!adjust
    endif
  endif

  -- Move stop plate to opposite end of field weld

  !!ce = $!<name>-BAR-1
  !drns = drns wrt /*
  !!ce = $!<name>/SUBS1
  handle none
    --!mdsOrigin = !!ce.owner.:MDSOrigin
    box 1
    if (!support.mirror) then
      -- if !mdsOrigin.eq('START') then
      -- move $!drns thro pose of $!<name>-BAR-1
      -- move $!drns dist 13mm
      -- else
      move $!drns thro poss of $!<name>-BAR-1
      move $!drns dist -13mm
      -- endif
    else
      -- if !mdsOrigin.eq('START') then
      -- move $!drns thro poss of $!<name>-BAR-1
      -- move $!drns dist -13mm
      -- else
      move $!drns thro pose of $!<name>-BAR-1
      move $!drns dist 13mm
      -- endif
    endif
  elsehandle any
  endhandle

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  -- Set 'FT25' form Support Object to be the same as 'FT33' form Support Object
  !!mdsFt25.support = !support

  -- Clear packs from 'BOTH forms' Support Objects as the SCTNs have already been deleted
  -- During the Framework Creation above
  !!mdsFt25.support.packs.clear()
  !support.packs.clear()

  -- Create Required Packing Pieces(SCTNs) at the Necessary Attas
  call !!mdscrpacksft25(!attapp, !!mdsFt33)

  -- Update 'FT33' support.packs data to that held in form 'FT25'
  !support.packs = !!mdsFt25.support.packs

  -- Navigate to Main Structure of Framework
  !!ce = !stru

  ----------------------***** connexions *****--------------------------
$(
  if(!haveJoints) then
    do !index indices !joints
      if(!joints[!index].badref().not() and !attributes[!index][8].dbref().:MDSConn.eq(!joints[!index].owner.owner)) then
        !mainStl = !attributes[!index][8].dbref().:MDSConn
        !support.joints[!index] =  !!mdsCreateJoint(!mainStl, !attributes[!index][8].dbref(),!joints[!index],!attributes[!index])
      else
        !dummy = object DBREF()
        !dummyA = ARRAY()
        !mainStl = !support.connections[!index]
        !support.joints[!index] =  !!mdsCreateJoint(!mainStl, !attributes[!index][8].dbref(),!dummy,!dummyA)
      endif
    enddo
  endif
$)
  ----------------------------------------------------------------------


  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.append(!!ce)
  !colourList.appendarray(!support.atta)
  !colourList.appendarray(!support.joints)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- Now that support has been generated.
  -- Store new configuration into support object
  !support.config = !config

  -- Update support data held in form
  !!mdsFt33.support = !support

  -- Reset distance gadget
  !!ce = !datum
  call !!mdsDistance(!!mdsFt33)

  !!mdsCreateMess(false)

  -- Generate field weld position

  !!ce = $!<name>-BAR-1
  var !poss poss
  var !pose pose
  pin 9 at $!poss
  pin 8 at $!pose
  pin 7 at $!datum
  var !d97 const dist pin 9 to pin 7
  var !d98 const dist pin 9 to pin 8
  stru
  if (!d98.real() gt !d97.real()) then
    :MDSOrigin 'START'
  else
    :MDSOrigin 'END'
  endif

  --<wd>jan2000
  if (!config.eq(6) or !config.eq(8)) then
    if (!support.rotateCur) then
      :MDSOrigin 'START'
      if (!support.mirror) then
        :MDSOrigin 'END'
      endif
    else
      :MDSOrigin ' END'
      if (!support.mirror) then
        :MDSOrigin 'START'
      endif
    endif
  elseif (!config.eq(7)) then
    if (!support.rotateCur) then
      :MDSOrigin 'END'
      if (!support.mirror) then
        :MDSOrigin 'START'
      endif
    else
      :MDSOrigin 'START'
      if (!support.mirror) then
        :MDSOrigin 'END'
      endif
    endif
  endif
  --<wd>jan2000

  --<wd>jun2001 -- If statement added around the Field Weld Code
  -- Do Not Show Field Weld text if External Joint is being used
  if (!support.joints.unset()) then
    !!mdsFieldWeld(!!mdsFt33,'SHOW')
  endif
  --<wd>jun2001

  --<kp>mar07 Handle snipes
  !!mdsSnipe(!support.stru)

  ---------------------------------------------------------------------------------------------------
  --<wd>aug2007<mds12>
  -- Update the MDSSCTN and MDSFITTING Objects to the latest DATA in the MDSSUPPORT object member .mdssctns,
  -- i.e. !form.support.mdsctns, where any MDS SNIPES(FITTINGS) exist on the MDS SUPPORT SCTNS where the GTYP of CATREF is 'ANG'
  -- and the MDS SNIPE/FITTING element PURPOSE attribute is set to 'XGUI'
  --
  -- ALL OTHER MDS SNIPES are generated automatically or from the MDS TEMPLATE during the MDS STRUCTURE creation/modification.
  -- ** NOTE ** The SNIPE UPDATE applies to ALL METHODS(!method) of Creation,
  -- i.e. 'CREATE by CURSOR/DIMENSION/CLEARANCE and RESIZING of the MDS TEMPLATE
  !!mdsrestoresnipe(!form, 'DIMENSION')

  -- REGENERATE the DATA stored in the FORM MDSSUPPORT object member "!form.support.mdssctns"
  -- for ALL of the MDS Support SCTNS and ALL the associated MDS SNIPE(FITTING) members
  !!mdssupportsctns(!form)
  --<wd>aug2007<mds12>
  ---------------------------------------------------------------------------------------------------

  !!ce = !support.stru
  -- Copy welds locally
  !copyWelds = object MDSWELDLIST(!!ce,!form)
  !!ce = !support.stru

  -- Reset all pins associated with this support
  call !!mdsResetPins(1,10)

  -- Show dimensions on graphics if required
  if !!mdsFt33.graphicalDim then
    !!mdsshowdim(!!mdsFt33)
  endif

  --<dw>sep2007 Restore bracing
  !!mdsrestorebracing(!form)
  --<dw>sep2007

  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  --<wd>jun2007<mds12>
  -- Create the Cross Reference ASSOCIATIONS between the MDS SUPPORT SCTN members $!name-BAR-1
  -- and the Main Structure supporting elements for:
  -- <a> CURSOR mode !pick
  --
  -- Store the Original Current Element
  !xce = !!ce

  -- Store the Array of MDS Support Members in the MDSASSOC Object
  !mdsassoc.mdsmember[1] = $!name-BAR-1

  -- Initialising the MDSASSOWL object always DELETES ALL of the EXISTING Cross Reference Associations
  -- (ASSOC) elements for the Current MDS Support, irrespective of the Creation MODE (!method)
  !mdsassowl = object MDSASSOWL(!form)
  !mdsassowl.mdsform  = !form
  !mdsassowl.mdsassoc = !mdsassoc

  -- Create the Association (ASSOCs) for the Current Support
  !mdsassowl.mdsassoc(!mdsassoc)

  -- Update the FORM SUPPORT object to reference the current MDSASSOWL Associations object
  !form.support.associations[1] = !mdsassowl
  !support = !form.support

  -- Navigate back to the Original Current Element
  !!ce = !xce

  --<wd>jun2007<mds12>
  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------

  -- Add pads if automatic pads option is on and a PANE or HPLATE has been picked
  if !!mdsOptions.autopads.selection().eq('ON') then
    !whichVerticals = 'ALL'
    if !method.eq('CURSOR') or !method.eq('CLEARANCE') then
      if !pick.hardType.eq('PANE') or !pick.hardType.eq('HPLATE') then
        !!mdsaddpad(!support,!whichVerticals)
      endif
    elseif !method.eq('DIMENSION') and !padsExist then
      !!mdsaddpad(!support,!whichVerticals)
    endif
  endif

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- End function
endfunction
