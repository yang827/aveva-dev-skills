--------------------------------------------------------------------------------
--
-- File:                mdscreateft35.pmlfnc
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:          MPS131
--
-- Author:              I.osborne
-- Created:             Tue Jul 01
--
--
-- Description:
-- function to create support frame type 35
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCreateft35(!method is STRING)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  call !!mdsResetPins(1,9)

  --<wd>may2007<mds12>
  --    !iDType    = 'GENSEC SCTN PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX'
  !session   = current session
  if !session.module().upcase().match('DESIGN').gt(0) then
    !iDType    = 'GENSEC SCTN PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX'
  elseif  !session.module().upcase().match('OUTFITTING').gt(0) then
    !iDType    = 'GENSEC SCTN PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX HSTIFF HPLATE'
  endif
  --<wd>may2007<mds12>

  !support   = !!mdsft35.support
  --!clearance = !!mdsOptions.clear.val
  !overlap   = !!mdsOptions.overlap.val
  -- !selection = !!mdsft35.size.selection('Rtext')
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !datum     = !support.datum
  !stru      = !support.stru
  !name      = !stru.name
  !p10Dir    = !support.p10Dir
  !p11Dir    = !support.p11Dir
  !pLDir     = !support.pLDir
  !pADir     = !support.pADir
  !alias     = !support.alias
  --<k.pleschner>May06
  !datumDflts = object MDSANCGEOMDFLTS(!datum)
  !clearance = !datumDflts.cend
  !buildStyle = :MdsBuildStyl of $!stru
  !struIsOld  = !stru.mcount.boolean()
  --<k.pleschner>May06

  var !pjoiColl coll all pjoi with gtyp eq 'APAD' for $!stru
  if !pjoiColl.size().neq(0) then
    !padsExist = TRUE
  else
    !padsExist = FALSE
  endif

  -- Does the support have attached/Associated supports
  if !!mdsgetconnectedsupp(!stru) then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  ----------------------------- **** connexions **** -----------------------------
  !refe         = !!ce
  !form      = !!mdsft35

  --<wd>jun2007<mds12>
  -- Initialise the MDS Associations Data Creation Object MDSASSOC
  !mdsassoc = object MDSASSOC()
  !mdsassoc.mode = !method
  --<wd>jun2007<mds12>

  -- Can we write to the spref attribute of the SREF atta and the stru
  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  !haveJoints = FALSE
  if(!form.support.joints.unset().not()) then
    !joints     = !support.joints
    !attributes = ARRAY()
    !haveJoints = !!kRestoreJoints(!joints,!attributes,'SAVE','')
    handle ANY
      !haveJoints = FALSE
      !support.joints.clear()
      -- in case they have been deleted and cancel is used
    endhandle
  endif
  ---------------------------------------------------------------------------------

  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Check that Datum atta has been positioned
  if (!support.position.not())then
    !!alert.message('Position atta before identifying supporting steelwork')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  ------------------------------------------------------------------------------------------------------
  --<wd>nov2003>>>
  ------------------------------------------------------------------------------------------------------
  -- The CODE below has been MOVED to near the BOTTOM of this function. This ENSURES that the CHECKING
  -- is PERFORMED on the CURRENT 'DIMENSION' values and NOT the PREVIOUS values.
  -- This is MORE CRITICAL when CREATING by CURSOR or CLEARANCE rather than by DIMENSIONS
$(
  -- Check if ATTAS Created on The Support are Within the Allowable Bores for the STRUCTURE SCTN SIZES.
  !cecomp = !!ce
  !error  = STRING()
  if (!!mdscheckbores(!form,!selection,!error,!currentUnits)) then
    !!alert.error(!error)
    !!ce = !stru
    delete STRU MEM
    handle (41,66) (2,113) (2,113)
    endhandle
    !!ce = !cecomp
    handle any
    endhandle
    !!kRestoreUnits(!currentUnits)
    return
  endif
$)
  ------------------------------------------------------------------------------------------------------
  --<wd>nov2003<<<
  ------------------------------------------------------------------------------------------------------

  !noEquiv = false

  -- Evaluate replacement support name for frame type 09
  !substitute = trim (before (!!mdsFrame.standard.dtext[!!mdsFrame.standard.rtext.findfirst('FT09')], '-'))
  handle any
    !noEquiv = true
    !substitute = 'Identified element is unsuitable to support from'
  endhandle

  ------------------------------------------------------------------------------------------------------
  --<wd>aug2007<mds12>
  -- ENSURE ALL the current MDS SNIPES(FITTINGS) that EXIST on the current MDS STRUCTURE SCTN elements are STORED,
  -- so "UPDATE" the FORM MDSSUPPORT object member "!form.support.mdssctns" to represent the current MDS STRUCTURE.
  -- *** IMPORTANT*** The object needs to be UPDATED before CREATIIN/MODIFICATION of the MDS STRUCTURE commences,
  -- as ADDITIONAL MDS SNIPES may have been ADDED/MODIFIED/DELETED by the USER since the FORM was initialised,
  -- via the !!mdsSnipe form utility from the MAIN "MDS DESIGN application" BAR menu option... "Modify>Snipe on Angle..."
  --
  -- REGENERATE the DATA stored in the FORM MDSSUPPORT object member "!form.support.mdssctns"
  -- for ALL of the current MDS Support SCTNS and ALL the associated MDS SNIPE(FITTING) members
  !!mdssupportsctns(!form)

  -- UPDATE the local !support object variable with the latest MDSSNIPE DATA
  !support.mdssctns      = !form.support.mdssctns
  !support.mdssctnsstore = !form.support.mdssctnsstore

  --<wd>aug2007<mds12>
  ------------------------------------------------------------------------------------------------------

  -- Check which attas to work from
  if (!support.bars.size().leq(1))then
    !atta = !support.atta
  else
    !atta = !support.bars[1]
  endif

  --------------------------------------------------------------------------------
  --<wd>oct2004
  -- !ddir and !udir variables are now always defined form the ACTUAL P9 direction of the DATUM Atta
  --------------------------------------------------------------------------------------------------
$(
  -- Set initial orientation
  if (!pADir eq U or !pLDir eq U)then
    !ddir = !support.p9Dir
    VAR !p3P9Dir CONST DIR P3 OF $!datum TO P9 OF $!datum
    !udir = !p3P9Dir.direction()
  else
    !ddir = D wrt world
    !udir = U wrt world
  endif
$)
  -- Always read the P9direction for the TRUE !ddir of the DATUM ATTA
  -- on HORIZONTAL and VERTICAL PIPES -- SLOPING PIPES need the TRUE ORTHOGONAL DIRECTIONS!!!!!!!!
  !ddir = !support.p9dir
  VAR !p3P9Dir CONST DIR P3 OF $!datum TO P9 OF $!datum
  !udir = !p3P9Dir.direction()

  --<wd>oct2004
  --------------------------------------------------------------------------------

  -- Store section name and matref for each member for resetting later
  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)

  -- Generate pin positions for each creation type
  if (!method eq |CURSOR|)then

    ------------ *** Connexion Warnings *** -------------
    !errorMessage = STRING()
    !dummyS       = ''

    if(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('UNJOINTED')) then
      -- nothing to do
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('WARNING')) then
      !continue = !!alert.confirm(!errorMessage)
      if(!continue.eq('NO')) then
        !!kRestoreUnits(!currentUnits)
        return
      endif
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('ERROR')) then
      !!alert.error(!errorMessage)
      !!kRestoreUnits(!currentUnits)
      return
    endif
    ---------------------------------------------

    label /Element1

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify first element to support from|
    ID $!iDType @
    handle (61,528)
      PROMPT ON
      !!ce = !stru
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    PROMPT DISMISS
    PROMPT ON
    !pick1 = !!ce

    label /Element2

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify second element to support from|
    ID $!iDType @
    handle (61,528)
      PROMPT ON
      !!ce = !stru
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    PROMPT DISMISS
    PROMPT ON
    !pick2 = !!ce

    !!ce = !pick1

    if (!pick1 eq !pick2) then
      !!alert.message('Cannot hit the same element when creating by cursor. Please use create by clearance.')
      !!kRestoreUnits(!currentUnits)
      return
    endif

    !testCe = !!mdsRelToDatum(!datum, !pick1, !ddir, !clearance.real())
    !testcepick1 = !testCe $* Save the settings for pick1 as they are used later for sloping panels
    if (!testCe[1].upcase() eq 'UNSET')then
      !!alert.error('The first identified element is unsuitable to support from.')
      golabel /Element1
    elseif (!testCe[1].upcase() eq '')then
      golabel /Element1
    endif
    if (!pADir eq U or !pLDir eq U)then
      if (!testCe[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('The first identified element is behind pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'The first identified element is behind pipe.')
        endif
        golabel /Element1
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('The first identified element is in line with the datum atta')
        golabel /Element1
      endif
    else
      if (!testCe[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('The first identified element is above pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'The first identified element is above pipe.')
        endif
        golabel /Element1
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('The first identified element is at the same elevation as the datum atta')
        golabel /Element1
      endif
    endif

    --<wd>may2007<mds12>
    --      if (!pick1.hardType eq 'PANE' or !pick1.type eq 'BOX' or !pick1.type.eq('SBFI') )then
    if (!pick1.hardType eq 'PANE' or !pick1.type eq 'BOX' or !pick1.type.eq('SBFI') or !pick1.type eq 'HPLATE')then
      --<wd>may2007<mds12>

      !plane1 = !testCe[2]
      VAR !pDir1 CONST DIR $!plane1
    endif

    !!ce = !pick2

    !testCe = !!mdsRelToDatum(!datum, !pick2, !ddir, !clearance.real())
    !testcepick2 = !testCe $* Save the settings for pick2 as they are used later for sloping panels
    if (!testCe[1].upcase() eq 'UNSET')then
      !!alert.error('The second identified element is unsuitable to support from.')
      golabel /Element2
    elseif (!testCe[1].upcase() eq '')then
      golabel /Element2
    endif
    if (!pADir eq U or !pLDir eq U)then
      if (!testCe[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('The second identified element is behind pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'The second identified element is behind pipe.')
        endif
        golabel /Element2
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('The second identified element is in line with the datum atta')
        golabel /Element2
      endif
    else
      if (!testCe[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('The second identified element is above pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'The second identified element is above pipe.')
        endif
        golabel /Element2
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('The second identified element is at the same elevation as the datum atta')
        golabel /Element2
      endif
    endif

    --<wd>may2007<mds12>
    --      if (!pick2.hardType eq 'PANE' or !pick2.type eq 'BOX')then
    if (!pick2.hardType eq 'PANE' or !pick2.type eq 'BOX' or !pick2.type.eq('HPLATE'))then
      --<wd>may2007<mds12>

      !plane2 = !testCe[2]
      VAR !pDir2 CONST DIR $!plane2
    endif

    -- If the first element is a panel and the second a section then reverse the elements
    -- so the section is always the first, this stops the error message
    -- 'Second Element picked will leave the datum atta off the supporting framework'

    --<wd>may2007<mds12>
    --   if !pick1.hardType.eq('PANE') and !pick2.hardType.eq('SCTN') then
    if !pick1.hardType.eq('PANE') and !pick2.hardType.eq('SCTN') or !pick1.hardType.eq('HPLATE') and !pick2.hardType.eq('HSTIFF')then
      --<wd>may2007<mds12>

      !tempPick1 = !pick1
      !tempPick2 = !pick2
      !pick1 = !tempPick2
      !pick2 = !tempPick1
      !tempTestcepick1 = !testcepick1
      !tempTestcepick2 = !testcepick2
      !testcepick1 = !tempTestcepick2
      !testcepick2 = !tempTestcepick1
      !tempPlane1 = !plane1
      !plane2 = !plane1
      !plane1.delete()
    endif

    !!mdsCreateMess(true)

    -- Position Pins
    !!ce = !pick1

    -- Check to see if first item picked is a bedplate

    --<wd>may2007<mds12>
    --      if (!pick1.hardType eq 'PANE' or !pick1.type eq 'BOX' or !pick1.type.eq('SBFI') )then
    if (!pick1.hardType eq 'PANE' or !pick1.type eq 'BOX' or !pick1.type.eq('SBFI') or !pick1.type.eq('HPLATE'))then
      --        STRU
      --        !type = !!ce.:MDSSuppType
      STRU
      handle NONE
        !type = !!ce.:MDSSuppType
      elsehandle ANY
        !type = ''
      endhandle
      --<wd>may2007<mds12>

      if (!type eq 'FT22')then
        !bedplate = true
        PIN 1 AT $!pick1
        PIN 1 DIR $!pDir1
        VAR !tempInter CONS POS INT PIN 1 $!plane1
        !inter = !tempInter.position()
      elseif !pick1.type.eq('SBFI') then
        PIN 1 AT P1 of $!pick1
        PIN 1 DIR $!pDir1
        VAR !tempInter CONS POS INT PIN 1 $!plane1
        !inter = !tempInter.position()
        VAR !pin1Up PIN 1 U
        if (!pin1Up.real().gt(!datum.pos.up))then
          !!mdsCreateMess(false)
          !!alert.error('Identified anchor plate is below pipe')
          PIN 1 OFF
          !!kRestoreUnits(!currentUnits)
          return
        endif
      else
        -- Position pins clear of attas
        PIN 1 AT P0 of $!datum
        PIN 1 DIR $!p10Dir
        PIN 2 COPY PIN 1
        !dim = 0
        --<k.pleschner>May06
        --do !i values !support.atta
        do !iref values !support.atta
          -- avoid SREF atta
          skip if !iref.name.substring(-1,-5).eq('/SREF')
          !i = object MDSANCGEOMDFLTS(!iref)
          --PIN 2 plane PIN 2 CLEAR $!clearance BEH $!i
          if !i.clge.eq('GEOM') then
            -- use clearance from geometry
            PIN 2 plane PIN 2 CLEAR $!i.cend BEH $!i
          else
            -- use distance from centreline
            PIN 2 plane PIN 2 THR $!i
            PIN 2 plane PIN 2 DIST $!i.cend
          endif
          handle (2,109)
            break
          endhandle
          VAR !cDIR CONST DIR PIN 1 TO PIN 2
          !cdim = !!kStrReal('CONST DIST PIN 1 TO PIN 2')

          -- Set object definition
          !direction = object KEQUALDIR()
          !direction.directionA = !cDIR.direction()
          !direction.directionB = !p10Dir
          !direction.tolerance  = 0.05

          if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
            PIN 2 AT $!datum
            PIN 2 DIST $!cdim
            !dim = !cdim
          else
            PIN 2 AT $!datum
            PIN 2 DIST $!dim
          endif
        enddo
        PIN 1 COPY PIN 2
        PIN 1 DIR $!ddir
        VAR !tempInter CONS POS INT PIN 1 $!plane1
        !inter = !tempInter.position()
      endif

      --<wd>may2007<mds12>
      --      elseif (!pick1.type eq 'SCTN' or !pick1.hardType eq 'GENSEC')then
    elseif (!pick1.type eq 'SCTN' or !pick1.hardType eq 'GENSEC' or !pick1.type eq 'HSTIFF')then
      --<wd>may2007<mds12>

      -- ************************ Connexions ***********************
      !support.connections[1] = !pick1
      !support.connections[2] = !pick2
      -- !!mdsft35.lineUp.active = False

      !start = plstart NA wrt world
      !end   = plend NA wrt world
      var !lineA CONS line JOIN $!start to $!end
      var !lineB CONS line P10 of $!datum
      var !tempInter CONS POS INT $!lineA $!lineB
      !inter = !tempInter.position()

      if (!inter.unset())then
        !!mdsCreateMess(false)
        !!alert.error('Unable to create support from first identified section using this method. Use clearance or dimensions')
        call !!mdsResetPins(1,9)
        !!kRestoreUnits(!currentUnits)
        return
      endif
      PIN 1 AT $!inter
      PIN 1 DIR $!ddir
      PIN 1 plane PIN 1 THRO P9 OF $!datum
      VAR !pin1Pos PIN 1 POS WRT WORLD
      !inter = !!kFlangeOrWeb(!pick1, !pin1Pos.position(), !ddir)
    endif

    --<wd>jun2007<mds12>
    -- Save !pick1 and !inter intersection position for Associations
    !mdsassoc.pick1      = !pick1
    !mdsassoc.pick1inter = !inter
    --<wd>jun2007<mds12>

    PIN 9 AT $!inter
    PIN 9 DIR $!udir

    -- Test position of pin 9 relative to datum so that dimensions are correct
    PIN 1 copy P10 of $!datum
    PIN 1 plane PIN 1 thro PIN 9
    var !testDir CONS DIR P10 of $!datum to PIN 1

    -- Set object definition
    !direction = object KEQUALDIR()
    !direction.directionA = !testDir.direction()
    !direction.directionB = !p10Dir
    !direction.tolerance  = 0.05

    -- Check directions
    if (!!kDirEqualDir(!direction)) then
      -- First upright is on the correct side of the support
      !vertLeg = True
      PIN 7 COPY P10 OF $!datum
      PIN 7 plane PIN 7 THRO PIN 9
      PIN 7 DIR $!udir
      PIN 7 plane PIN 7 THRO PIN 9
      PIN 9 COPY PIN 7
      PIN 9 plane PIN 9 THRO P9 OF $!datum
      !tempDim = !!kStrReal('CONST DIST PIN 7 TO PIN 9')
      !!mdsft35.dim3.val = !tempDim

      !!ce = !pick2

      -- Check to see if second item picked is a bedplate

      --<wd>may2007<mds12>
      --        if (!pick2.hardType eq 'PANE' or !pick2.type eq 'BOX' or !pick2.type.eq('SBFI') )then
      if (!pick2.hardType eq 'PANE' or !pick2.type eq 'BOX' or !pick2.type.eq('SBFI') or !pick2.type.eq('HPLATE') )then
        --          STRU
        --         !type = !!ce.:MDSSuppType
        STRU
        handle NONE
          !type = !!ce.:MDSSuppType
        elsehandle ANY
          !type = ''
        endhandle
        --<wd>may2007<mds12>

        if (!type eq 'FT22')then
          !bedplate = true
          PIN 1 AT $!pick2
          PIN 1 DIR $!pDir2
          VAR !tempInter CONS POS INT PIN 1 $!plane2
          !inter = !tempInter.position()
        elseif !pick2.type.eq('SBFI') then
          PIN 1 AT P1 of $!pick2
          PIN 1 DIR $!pDir2
          VAR !tempInter CONS POS INT PIN 1 $!plane2
          !inter = !tempInter.position()
          VAR !pin1Up PIN 1 U
          if (!pin1Up.real().gt(!datum.pos.up))then
            !!mdsCreateMess(false)
            !!alert.error('Identified anchor plate is below pipe')
            PIN 1 OFF
            !!kRestoreUnits(!currentUnits)
            return
          endif
        else
          -- Position pins clear of datum atta
          PIN 1 AT P0 of $!datum
          PIN 1 DIR $!p11Dir
          PIN 2 COPY PIN 1
          !dim = 0
          --<k.pleschner>May06
          --do !i values !support.atta
          do !iref values !support.atta
            -- avoid SREF atta
            skip if !iref.name.substring(-1,-5).eq('/SREF')
            !i = object MDSANCGEOMDFLTS(!iref)
            --PIN 2 plane PIN 2 CLEAR $!clearance BEH $!i
            if !i.clge.eq('GEOM') then
              -- use clearance from geometry
              PIN 2 plane PIN 2 CLEAR $!i.cend BEH $!i
            else
              -- use distance from centreline
              PIN 2 plane PIN 2 THR $!i
              PIN 2 plane PIN 2 DIST $!i.cend
            endif
            handle (2,109)
              break
            endhandle
            VAR !cDIR CONST DIR PIN 1 TO PIN 2
            !cdim = !!kStrReal('CONST DIST PIN 1 TO PIN 2')

            -- Set object definition
            !direction = object KEQUALDIR()
            !direction.directionA = !cDIR.direction()
            !direction.directionB = !p11Dir
            !direction.tolerance  = 0.05

            if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
              PIN 2 AT $!datum
              PIN 2 DIST $!cdim
              !dim = !cdim
            else
              PIN 2 AT $!datum
              PIN 2 DIST $!dim
            endif
          enddo
          PIN 1 COPY PIN 2
          PIN 1 DIR $!ddir
          VAR !tempInter CONS POS INT PIN 1 $!plane2
          !inter = !tempInter.position()
        endif

        --<wd>may2007<mds12>
        --        elseif (!pick2.type eq 'SCTN' or !pick2.type eq 'GENSEC')then
      elseif (!pick2.type eq 'SCTN' or !pick2.type eq 'GENSEC' or !pick2.type eq 'HSTIFF')then
        --<wd>may2007<mds12>

        !start = plstart NA wrt world
        !end   = plend NA wrt world
        var !lineA CONS line JOIN $!start to $!end
        var !lineB CONS line P10 of $!datum
        var !tempInter CONS POS INT $!lineA $!lineB
        !inter = !tempInter.position()

        if (!inter.unset())then
          !!mdsCreateMess(false)
          !!alert.error('Unable to create support from second identified section using this method. Use clearance or dimensions')
          !!kRestoreUnits(!currentUnits)
          call !!mdsResetPins(1,9)
          return
        endif
        PIN 1 AT $!inter
        PIN 1 DIR $!ddir
        PIN 1 plane PIN 1 THRO P9 OF $!datum
        VAR !pin1Pos PIN 1 POS WRT WORLD
        !inter = !!kFlangeOrWeb(!pick2, !pin1Pos.position(), !ddir)
      endif

      --<wd>jun2007<mds12>
      -- Save !pick2 and !inter intersection position for Associations
      !mdsassoc.pick2      = !pick2
      !mdsassoc.pick2inter = !inter
      --<wd>jun2007<mds12>

      PIN 8 AT $!inter
      PIN 8 DIR $!udir

      -- Test position of pin 8 relative to datum to see if its on the correct side
      PIN 1 copy P11 of $!datum
      PIN 1 plane PIN 1 thro PIN 8
      var !testDir CONS DIR P11 of $!datum to PIN 1

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !testDir.direction()
      !direction.directionB = !p11Dir
      !direction.tolerance  = 0.05

      -- Check directions
      if (!!kDirEqualDir(!direction)) then
        PIN 6 COPY P11 OF $!datum
        PIN 6 plane PIN 6 THRO PIN 8
        PIN 6 DIR $!udir
        PIN 6 plane PIN 6 THRO PIN 8
        PIN 8 COPY PIN 6
        PIN 8 plane PIN 8 THRO P9 OF $!datum
        !tempDim = !!kStrReal('CONST DIST PIN 6 TO PIN 8')
        !!mdsft35.dim4.val = !tempDim
      else
        !!mdsCreateMess(false)
        -- Reset all pins associated with this support
        call !!mdsResetPins(1,9)
        !!kRestoreUnits(!currentUnits)
        !!alert.error('Second Element picked will leave the datum atta off the supporting framework')
        return
      endif

    else
      !vertLeg = False

      PIN 8 COPY PIN 9
      PIN 6 COPY PIN 8
      PIN 6 DIR $!udir
      PIN 8 plane PIN 8 THRO P9 OF $!datum
      !tempDim = !!kStrReal('CONST DIST PIN 6 TO PIN 8')
      !!mdsft35.dim4.val = !tempDim

      !!ce = !pick2

      -- Check to see if second item picked is a bedplate

      --<wd>may2007<mds12>
      --        if (!pick2.hardType eq 'PANE' or !pick2.type eq 'BOX' or !pick2.type.eq('SBFI') )then
      if (!pick2.hardType eq 'PANE' or !pick2.type eq 'BOX' or !pick2.type.eq('SBFI')  or !pick2.type.eq('HPLATE') )then
        --          STRU
        --          !type = !!ce.:MDSSuppType
        STRU
        handle NONE
          !type = !!ce.:MDSSuppType
        elsehandle ANY
          !type = ''
        endhandle
        --<wd>may2007<mds12>

        if (!type eq 'FT22')then
          !bedplate = true
          PIN 1 AT $!pick2
          PIN 1 DIR $!pDir2
          VAR !tempInter CONS POS INT PIN 1 $!plane2
          !inter = !tempInter.position()
        elseif !pick2.type.eq('SBFI') then
          PIN 1 AT P1 of $!pick2
          PIN 1 DIR $!pDir2
          VAR !tempInter CONS POS INT PIN 1 $!plane2
          !inter = !tempInter.position()
          VAR !pin1Up PIN 1 U
          if (!pin1Up.real().gt(!datum.pos.up))then
            !!mdsCreateMess(false)
            !!alert.error('Identified anchor plate is below pipe')
            PIN 1 OFF
            !!kRestoreUnits(!currentUnits)
            return
          endif
        else
          -- Position pins clear of datum atta
          PIN 1 AT P0 of $!datum
          PIN 1 DIR $!p10Dir
          PIN 2 COPY PIN 1
          !dim = 0
          --<k.pleschner>May06
          --do !i values !support.atta
          do !iref values !support.atta
            -- avoid SREF atta
            skip if !iref.name.substring(-1,-5).eq('/SREF')
            !i = object MDSANCGEOMDFLTS(!iref)
            --PIN 2 plane PIN 2 CLEAR $!clearance BEH $!i
            if !i.clge.eq('GEOM') then
              -- use clearance from geometry
              PIN 2 plane PIN 2 CLEAR $!i.cend BEH $!i
            else
              -- use distance from centreline
              PIN 2 plane PIN 2 THR $!i
              PIN 2 plane PIN 2 DIST $!i.cend
            endif
            handle (2,109)
              break
            endhandle
            VAR !cDIR CONST DIR PIN 1 TO PIN 2
            !cdim = !!kStrReal('CONST DIST PIN 1 TO PIN 2')

            -- Set object definition
            !direction = object KEQUALDIR()
            !direction.directionA = !cDIR.direction()
            !direction.directionB = !p10Dir
            !direction.tolerance  = 0.05

            if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
              PIN 2 AT $!datum
              PIN 2 DIST $!cdim
              !dim = !cdim
            else
              PIN 2 AT $!datum
              PIN 2 DIST $!dim
            endif
          enddo
          PIN 1 COPY PIN 2
          PIN 1 DIR $!ddir
          VAR !tempInter CONS POS INT PIN 1 $!plane2
          !inter = !tempInter.position()
        endif

        --<wd>may2007<mds12>
        --        elseif (!pick2.type eq 'SCTN' or !pick2.hardType eq 'GENSEC')then
      elseif (!pick2.type eq 'SCTN' or !pick2.hardType eq 'GENSEC' or !pick2.type eq 'HSTIFF')then
        --<wd>may2007<mds12>

        !start = plstart NA wrt world
        !end   = plend NA wrt world
        var !lineA CONS line JOIN $!start to $!end
        var !lineB CONS line P10 of $!datum
        var !tempInter CONS POS INT $!lineA $!lineB
        !inter = !tempInter.position()

        if (!inter.unset())then
          !!mdsCreateMess(false)
          !!alert.error('Unable to create support from second identified section using this method. Use clearance or dimensions')
          -- Reset all pins associated with this support
          call !!mdsResetPins(1,9)
          !!kRestoreUnits(!currentUnits)
          return
        endif

        PIN 1 AT $!inter
        PIN 1 DIR $!ddir
        PIN 1 plane PIN 1 THRO P9 OF $!datum
        VAR !pin1Pos PIN 1 POS WRT WORLD
        !inter = !!kFlangeOrWeb(!pick2, !pin1Pos.position(), !ddir)
      endif

      --<wd>jun2007<mds12>
      -- Save !pick2 and !inter intersection position for Associations
      !mdsassoc.pick2      = !pick2
      !mdsassoc.pick2inter = !inter
      --<wd>jun2007<mds12>

      PIN 9 AT $!inter
      PIN 9 DIR $!udir

      -- Test position of pin 9 relative to datum to see if its on the correct side
      PIN 1 copy P10 of $!datum
      PIN 1 plane PIN 1 thro PIN 9
      var !testDir CONS DIR P10 of $!datum to PIN 1

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !testDir.direction()
      !direction.directionB = !p10Dir
      !direction.tolerance  = 0.05

      -- Check directions
      if (!!kDirEqualDir(!direction)) then
        -- First vertical rod is on the correct side of the support
        PIN 7 COPY P10 OF $!datum
        PIN 7 plane PIN 7 THRO PIN 9
        PIN 7 DIR $!udir
        PIN 7 plane PIN 7 THRO PIN 9
        PIN 9 COPY PIN 7
        PIN 9 plane PIN 9 THRO P9 OF $!datum
        !tempDim = !!kStrReal('CONST DIST PIN 7 TO PIN 9')
        !!mdsft35.dim3.val = !tempDim
      else
        !!mdsCreateMess(false)
        -- Reset all pins associated with this support
        call !!mdsResetPins(1,9)
        !!kRestoreUnits(!currentUnits)
        !!alert.error('Second Element picked will leave the datum atta off the supporting framework')

        return
      endif
    endif

    --------------------------
    --> Modified-<wd>-6oct1998
    --> Code Added to ENSURE Pins 6.7,8,9 are in CORRECT Alignment
    --> when creating by CURSOR
    !datumplanedir = !!kcalcorthdir(!support.datum)
    pin 6 dir $!datumplanedir
    pin 6 plane pin 6 thro $!support.datum
    pin 8 dir $!datumplanedir
    pin 8 plane pin 8 thro $!support.datum
    pin 7 dir $!datumplanedir
    pin 7 plane pin 7 thro $!support.datum
    pin 9 dir $!datumplanedir
    pin 9 plane pin 9 thro $!support.datum

    --< Modified-<wd>-6oct1998
    --------------------------

    PIN 9 DIR FROM PIN 8 TO PIN 9
    PIN 8 DIR FROM PIN 9 TO PIN 8

  elseif (!method eq |DIMENSION|)then
    --<BC>Apr2005
    --Check to see if V1 exists and save the end and start directions for sloping decks
    !!ce = $!<name>-V1
    handle(2,109)
    elsehandle NONE
    	
      if (!support.mirror) then
        !farend = 1
      else
        !farend = 0
      endif
      -- because we are building by dimension, we need to save the plane of the ends
      -- mdssaveends stores the end to trim !farend and the method used by mdsoverdim
      !saveV1 = object MDSSAVEENDS(!!ce,!datum,!farend)
      !!ce = $!<name>-V2
      !saveV2 = object MDSSAVEENDS(!!ce,!datum,!farend)
      --  !v1SctnDrne = Drne wrt worl
      -- !v1SctnDrns = Drns wrt worl
    endhandle

    -- Initialise variables for dimension check
    !d1 = !!mdsft35.dim1.val
    !d2 = !!mdsft35.dim2.val
    !d3 = !!mdsft35.dim3.val
    !d4 = !!mdsft35.dim4.val

    if (!d1.eq(0) or !d2.eq(0) or !d3.eq(0) or !d4.eq(0)) then
      !!alert.error('Not all of the dimensions have been completed.')
      !!kRestoreUnits(!currentUnits)
      call !!mdsResetPins(1,9)
      return
    endif

    !!mdsCreateMess(true)

    -- Position pins
    !!ce = !datum
    PIN 9 COPY P9
    PIN 9 DIR $!p10Dir
    PIN 8 COPY PIN9
    PIN 8 DIR $!p11Dir

    PIN 9 plane PIN 9 THRO CE
    PIN 8 plane PIN 8 THRO CE
    PIN 9 DIST $!d2
    PIN 9 DIR $!ddir
    PIN 7 COPY PIN 9
    PIN 7 DIST $!d3
    PIN 7 DIR $!udir
    PIN 8 DIST ($!d1 - $!d2)
    PIN 8 DIR $!ddir
    PIN 6 COPY PIN 8
    PIN 6 DIST $!d4
    PIN 6 DIR $!udir

    PIN 9 DIR FROM PIN 8 TO PIN 9
    PIN 8 DIR FROM PIN 9 TO PIN 8

  elseif (!method eq |CLEARANCE|)then
    ------------ *** Connexion Warnings *** -------------
    !errorMessage = STRING()
    !dummyS       = ''

    if(!!kErrorsForConns(!form, !errorMessage,!dummyS).eq('UNJOINTED')) then
      -- nothing to do
    elseif(!!kErrorsForConns(!form, !errorMessage,!dummyS).eq('WARNING')) then
      !continue = !!alert.confirm(!errorMessage)
      if(!continue.eq('NO')) then
        call !!mdsResetPins(1,9)
        !!kRestoreUnits(!currentUnits)
        return
      endif
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('ERROR')) then
      !!alert.error(!errorMessage)
      call !!mdsResetPins(1,9)
      !!kRestoreUnits(!currentUnits)
      return
    else
      -- leave in case
    endif
    ---------------------------------------------


    label /Element3

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify element to support from|
    ID $!iDType @
    handle (61,528)
      PROMPT ON
      !!ce = !stru
      !!kRestoreUnits(!currentUnits)
      call !!mdsResetPins(1,9)
      return
    endhandle
    PROMPT DISMISS
    PROMPT ON
    !pick3 = !!ce
    !testCe = !!mdsRelToDatum(!datum, !pick3, !ddir, !clearance.real())

    if (!testCe[1].upcase() eq 'UNSET')then
      !!alert.error('Identified element is unsuitable to support from.')
      golabel /Element3
    elseif (!testCe[1].upcase() eq '')then
      golabel /Element3
    endif
    if (!pADir eq U or !pLDir eq U)then
      if (!testCe[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('Identified element is behind pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'Identified element is behind pipe.')
        endif
        golabel /Element3
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is in line with the datum atta')
        golabel /Element3
      endif
    else
      if (!testCe[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('Identified element is above pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'Identified element is above pipe.')
        endif
        golabel /Element3
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is at the same elevation as the datum atta')
        golabel /Element3
      endif
    endif

    --<wd>may2007<mds12>
    --      if (!pick3.hardType eq 'PANE' or !pick3.type eq 'BOX' )then
    if (!pick3.hardType eq 'PANE' or !pick3.type eq 'BOX' or !pick3.type eq 'SBFI' or !pick3.type eq 'HPLATE') then
      --<wd>may2007<mds12>

      !plane3 = !testCe[2]
      VAR !pDir3 CONST DIR $!plane3
    endif

    !!mdsCreateMess(true)

    -- Position pins
    -- Set first direction from P10
    !!ce = !datum
    PIN 9 AT P0 of $!datum
    PIN 9 DIR $!p10Dir
    PIN 7 COPY PIN 9
    !dim = 0

    --<k.pleschner>May06
    --do !i values !support.atta
    do !iref values !support.atta
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)
      --PIN 7 plane PIN 7 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 7 plane PIN 7 CLEAR $!i.cend BEH $!i
      else
        -- use distance from centreline
        PIN 7 plane PIN 7 THR $!i
        PIN 7 plane PIN 7 DIST $!i.cend
      endif
      handle (2,109)
        break
      endhandle
      VAR !cDIR CONST DIR PIN 9 TO PIN 7
      !cdim = !!kStrReal('CONST DIST PIN 9 TO PIN 7')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cDIR.direction()
      !direction.directionB = !p10Dir
      !direction.tolerance  = 0.05

      if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 7 AT $!datum
        PIN 7 DIST $!cdim
        !dim = !cdim
      else
        PIN 7 AT $!datum
        PIN 7 DIST $!dim
      endif
    enddo

    PIN 7 DIR $!ddir
    VAR !pin7Pos PIN 7 POS WRT WORLD

    --<wd>may2007<mds12>
    --      if (!pick3.hardType eq 'SCTN' or !pick3.hardType eq 'GENSEC')then
    if (!pick3.hardType eq 'SCTN' or !pick3.hardType eq 'GENSEC' or !pick3.type eq 'HSTIFF') then
      --<wd>may2007<mds12>

      !inter = !!kFlangeOrWeb(!pick3, !pin7Pos.position(), !ddir)
      PIN 7 AT $!inter
      ---------------****** Connexions ******----------------------
      !support.connections.clear()
      !support.connections[1] = !pick3
      !support.connections[2] = !pick3
      -- !!mdsft35.lineUp.active = True
      ------------------this bit will stop clearance being used if support is not under picked sctn-----------------------
      if(!haveJoints) then
        !connected = !!mdsGetBeamConn(!support,!attributes[1][8].dbref())
        if(!connected.unset()) then
          !!alert.error('Support is not positioned correctly through the new joints. Position "Through", before continuing.')
          !!ce = !refe
          call !!mdsResetPins(1,9)
          return
        endif
      endif
      ------------------------take it out and it will create joints however far apart the support and steel is------------

    else
      VAR !tempInter CONS POS INT PIN 7 $!plane3
      !inter = !tempInter.position()
      PIN 1 AT $!inter
      PIN 7 plane PIN 7 THRO PIN 1
    endif

    PIN 9 AT P9 of $!datum
    PIN 9 plane PIN 9 THRO PIN 7

    -- set second direction from P11
    !!ce = !datum
    PIN 8 AT P0 of $!datum
    PIN 8 DIR $!p11Dir
    PIN 6 COPY PIN 8
    !dim = 0

    --<k.pleschner>May06
    --do !i values !support.atta
    do !iref values !support.atta
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)
      --PIN 6 plane PIN 6 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 6 plane PIN 6 CLEAR $!i.cend BEH $!i
      else
        -- use distance from centreline
        PIN 6 plane PIN 6 THR $!i
        PIN 6 plane PIN 6 DIST $!i.cend
      endif
      handle (2,109)
        break
      endhandle
      VAR !cDIR CONST DIR PIN 8 TO PIN 6
      !cdim = !!kStrReal('CONST DIST PIN 8 TO PIN 6')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cDIR.direction()
      !direction.directionB = !p11Dir
      !direction.tolerance  = 0.05

      if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 6 AT $!datum
        PIN 6 DIST $!cdim
        !dim = !cdim
      else
        PIN 6 AT $!datum
        PIN 6 DIST $!dim
      endif
    enddo

    PIN 6 DIR $!ddir
    VAR !pin6Pos PIN 6 POS WRT WORLD

    --<wd>may2007<mds12>
    --      if (!pick3.hardType eq 'SCTN' or !pick3.hardType eq 'GENSEC')then
    if (!pick3.hardType eq 'SCTN' or !pick3.hardType eq 'GENSEC' or !pick3.type eq 'HSTIFF') then
      --<wd>may2007<mds12>

      !inter = !!kFlangeOrWeb(!pick3, !pin6Pos.position(), !ddir)
      PIN 6 AT $!inter
    else
      VAR !tempInter CONS POS INT PIN 6 $!plane3
      !inter = !tempInter.position()
      PIN 1 AT $!inter
      PIN 6 plane PIN 6 THRO PIN 1
    endif

    PIN 8 AT P9 of $!datum
    PIN 8 plane PIN 8 THRO PIN 6

    --<wd>jun2007<mds12>
    -- Save !pick3 for Associations
    !mdsassoc.pick3 = !pick3
    --<wd>jun2007<mds12>

  endif

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  -- Create and ARRAY of Attas with Packing Pieces (PDMS Names ONLY)
  -- and the Type and Size of the Packing Pieces to Recreate
  !attapp = !!mdspackers(!support)

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  !!ce = !stru
  --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
  !!mdsRemoveAutoPadRules(!stru)
  --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end

  -- Pins now in position create framework
  delete STRU MEM
  handle (41,66) (2,113) (2,113)
  endhandle

  --<wd>oct2000
  !mdstemp = /MDS/$!alias/$!selection
  :mdscheck $!mdstemp.:mdscheck
  :mdsframirror $!mdstemp.:mdsframirror
  --<wd>oct2000

  --<k.pleschner>may06
  -- get :mdsbuildstyl (INSIDE/OUTSIDE/NONE) from template structure
  !buildStyleNew = :mdsbuildstyl of $!mdstemp

  -- Position the MDS STRU
  --AT $!datum
  if (!datum.styp inset ('AT60','ST07','GT11')) then
    at p9 of $!datum
  else
    at $!datum
  endif

  NEW FRMW $!name/MAIN
  !frmwSupport = !!ce

  -- Copy required template/s
  !!ce = /MDS/$!alias/$!selection
  !subs = !!kCollectAllFor('SUBS', '', !!ce)
  !frmw = !!kCollectAllFor('FRMW', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')

  -- Navigate back to support and create template elements
  !!ce = !frmwSupport
  COPY ATTRIB OF $!frmw[1]
  COPY MEM OF $!frmw[1] RENAME $!frameFormat $!name
  do !i indices !subs
    NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
    COPY MEM OF $!subs[$!i] RENAME $!frameFormat $!name
  enddo

  -- Get direction of P9 of datum atta and dist between p9 and p0
  !!ce = !stru

  -- Set stru description for template recognition
  !desc = desc of /MDS/$!alias/$!selection
  !mdsBars = :mdsbars of /MDS/$!alias/$!selection
  desc '$!desc'
  :mdsbars $!mdsBars

  -- <k.pleschner>Apr06 set stru :mdsbuildstyl
  :mdsbuildstyl $!buildStyleNew

  MOVE $!ddir THRO P9 OF $!datum
  if !datum.:mdsguideref.set() and !datum.:mdsguideref.badref().not() then
    !mdsGuideRef = !datum.:mdsguideref
    --MOVE $!ddir thro p9 of $!mdsGuideRef
    -- Do NOT Move the STRU if the GUIDE is a TRUNNION GUIDE/STOP etc...
    if (!datum.catref.owner.:mdstrun.not()) then
      MOVE $!ddir thro p9 of $!mdsGuideRef
    endif
  endif

  ----------------------------------------------
  --<wd>oct2004
  --if (!support.pLDir.up.abs().neq(1))then
  -- Sloping and True Horizontal Pipes ONLY
  !directions = !!mdsremovegrad(!datum)
  !support.datumorthdirs = !directions
  !orixd = !directions[6]
  !orizd = !directions[4]
  ori x is $!orixd and z is $!orizd

  --else
  -- Vertical Pipes ONLY - Uses the Original ORIENTATION Code
  --!oRIX = !p11Dir
  --!oRIZ = !udir
  --ORI X IS $!oRIX AND Z IS $!oRIZ
  --endif
  --<wd>oct2004
  ----------------------------------------------



  -- If a trunnion is added to a support then we need to store the direction in a
  -- uda for later use
  var !oriFrame dir y wrt /*
  :MdsFrameDir $!oriFrame

  -- If the flange gap toggle is switched on then adjust the positions
  if !method.eq('CURSOR') then
    -- The form is obviously this FORM, !pick1 is the first picked element
    -- !pick2 is the second picked element, !vertLeg is a logical to see if
    -- we have moved the pins onto the correct size or not
    !!mdsGapFlange(!form,!pick1,!pick2,!vertLeg)
  endif

  -- Extend and move leg 1
  !!ce = $!<name>-V1
  !num = :MDSOnum
  EXTEND START THRO PIN 6
  !flush = :MdsOlap
  if !flush eq 'FLUSH' then
    --EXTEND END BEH $!<name>-BAR-1
  elseif !flush eq 'OVERLAP' then
    !num = :MdsOnum
    EXTEND END THRO PIN 8
    EXTEND END $!num
  else
    EXTEND END THRO PIN 8
    --> Modified-<wd>-6oct1998
    --xxx      EXTEND END $!overlap
    EXTEND END -$!overlap
  endif

  VAR !dir PIN 8 DIR WRT WORLD
  MOVE $!dir WRT WORLD THRO PIN 8
  PIN 5 COPY PIN 8
  PIN 3 COPY PIN 8
  !realSctn = !!ce
  new sctn copy prev
  delete sctn mem
  handle ANY
  endhandle
  PIN 5 plane PIN 5 CLEAR 0 BEH CE
  PIN 3 plane PIN 3 CLEAR 0 INF CE
  delete sctn
  !!ce = !realSctn
  !d58 = !!kStrReal('CONST DIST PIN 5 TO PIN 8')
  !d38 = !!kStrReal('CONST DIST PIN 3 TO PIN 8')
  !d35 = !!kStrReal('CONST DIST PIN 3 TO PIN 5')
  !diff = ((!d38 - !d58) / 2)

  if (!method eq 'CURSOR')then
    if (!vertLeg)then

      --<wd>may2007<mds12>
      --        if (!pick2.type eq 'SCTN' or !pick2.hardType eq 'GENSEC')then
      if (!pick2.hardType eq 'SCTN' or !pick2.hardType eq 'GENSEC' or !pick2.type eq 'HSTIFF') then
        --<wd>may2007<mds12>

        MOVE $!dir WRT WORLD DIST $!diff
      elseif (!pick2.type eq 'BOX' and defined(!bedplate))then
        MOVE $!dir WRT WORLD DIST $!diff
      else
        MOVE $!dir WRT WORLD DIST $!d38
      endif
    else

      --<wd>may2007<mds12>
      --        if (!pick1.type eq 'SCTN' or !pick1.hardType eq 'GENSEC')then
      if (!pick1.hardType eq 'SCTN' or !pick1.hardType eq 'GENSEC' or !pick1.type eq 'HSTIFF') then
        --<wd>may2007<mds12>

        MOVE $!dir WRT WORLD DIST $!diff
      elseif (!pick1.type eq 'BOX' and defined(!bedplate))then
        MOVE $!dir WRT WORLD DIST $!diff
      else
        MOVE $!dir WRT WORLD DIST $!d38
      endif
    endif

  else
    MOVE $!dir WRT WORLD DIST $!d38
    --<k.pleschner>may06
    -- reflect INSIDE/OUTSIDE build style
    if !buildStyleNew.eq('OUTSIDE').and(!method.eq('DIMENSION')) then
      MOVE $!dir wrt world distance -$!d35
    endif
  endif
  PIN 3 plane PIN 3 CLEAR 0 INF CE

  ------------------****** connexions *******----------------------
  if(!support.connections.unset()) then
    -- dimensions are being used first
    :MDSConn default
  else
    !vertical1 = !!ce
    !connected = !!mdsGetBeamConn(!support,!vertical1)
    :MDSConn $!connected
    handle any
    endhandle
  endif
  --------------------*******************--------------------------


  -- Extend and move leg 2
  !!ce = $!<name>-V2
  !num = :MDSOnum
  EXTEND START THRO PIN 7
  if !flush eq 'FLUSH' then
    --EXTEND END BEH $!<name>-BAR-1
  elseif !flush eq 'OVERLAP' then
    !num = :MdsOnum
    EXTEND END THRO PIN 9
    EXTEND END $!num
  else
    EXTEND END THRO PIN 9
    --> Modified-<wd>-6oct1998
    --xxx      EXTEND END $!overlap
    EXTEND END -$!overlap
  endif

  VAR !dir PIN 9 DIR WRT WORLD
  MOVE $!dir WRT WORLD THRO PIN 9
  PIN 5 COPY PIN 9
  PIN 4 COPY PIN 9
  !realSctn = !!ce
  new sctn copy prev
  delete sctn mem
  handle ANY
  endhandle
  PIN 5 plane PIN 5 CLEAR 0 BEH CE
  PIN 4 plane PIN 4 CLEAR 0 INF CE
  delete sctn
  !!ce = !realSctn
  !d59 = !!kStrReal('CONST DIST PIN 5 TO PIN 9')
  !d49 = !!kStrReal('CONST DIST PIN 4 TO PIN 9')
  !d45 = !!kStrReal('CONST DIST PIN 4 TO PIN 5')
  !diff = ((!d49 - !d59) / 2)

  if (!method eq 'CURSOR')then
    if (!vertLeg)then

      --<wd>may2007<mds12>
      --        if (!pick1.type eq 'SCTN' or !pick1.hardType eq 'GENSEC')then
      if (!pick1.hardType eq 'SCTN' or !pick1.hardType eq 'GENSEC' or !pick1.type eq 'HSTIFF') then
        --<wd>may2007<mds12>

        MOVE $!dir WRT WORLD DIST $!diff
      elseif (!pick1.type eq 'BOX' and defined(!bedplate))then
        MOVE $!dir WRT WORLD DIST $!diff
      else
        MOVE $!dir WRT WORLD DIST $!d49
      endif
    else

      --<wd>may2007<mds12>
      --        if (!pick2.type eq 'SCTN' or !pick2.hardType eq 'GENSEC')then
      if (!pick2.hardType eq 'SCTN' or !pick2.hardType eq 'GENSEC' or !pick2.type eq 'HSTIFF') then
        --<wd>may2007<mds12>

        MOVE $!dir WRT WORLD DIST $!diff
      elseif (!pick2.type eq 'BOX' and defined(!bedplate))then
        MOVE $!dir WRT WORLD DIST $!diff
      else
        MOVE $!dir WRT WORLD DIST $!d49
      endif
    endif
  else
    MOVE $!dir WRT WORLD DIST $!d49
    --<k.pleschner>may06
    -- reflect INSIDE/OUTSIDE build style
    if !buildStyleNew.eq('OUTSIDE').and(!method.eq('DIMENSION')) then
      MOVE $!dir wrt world distance -$!d45
    endif
  endif
  PIN 4 plane PIN 4 CLEAR 0 INF CE

  ----------------------- ****** connexions ******* --------------------
  if(!support.connections.unset()) then
    -- dimensions are being used first
    :MDSConn default
  else
    !vertical2 = !!ce
    !connected = !!mdsGetBeamConn(!support,!vertical2)
    :MDSConn $!connected
    handle any
    endhandle
  endif
  ---------------------------********************-----------------------

  -- Extend and move bar 1
  !!ce = $!<name>-BAR-1
  PIN 5 COPY PIN 9
  !tempOverlap = :MdsOlap
  if !tempOverlap eq 'OVERLAP' then
    !num = :MdsOnum
    PIN 5 plane PIN 5 CLEAR $!num INF $!<name>-V1
  else
    PIN 5 plane PIN 5 CLEAR $!overlap INF $!<name>-V1
  endif

  --<wd>dec2004
  --EXTEND END THRO PIN 5
  -- Set up Pins 5 and 10 direction variables
  pin 10 copy p10 of $!datum
  pin 10 plane pin 10 thro $!name-V2
  pin 10 dir to p10 of $!datum
  var !pin10dir pin 10 dir wrt /*
  !pin10direction = !pin10dir.direction()

  -- Set KEQUALDIR object definition
  !dira     = !p10Dir
  !dirb     = !pin10direction
  !checkdir = object KEQUALDIR()
  !checkdir.directionA = !dira
  !checkdir.directionB = !dirb
  !checkdir.tolerance  = 1

  -- Check if directions are Parallel within a Tolerance Angle of (+/-) 5 degrees
  if (!!mdsdirequaldir(!checkdir)) then
    !support.mirror = FALSE
  else
    !support.mirror = TRUE
  endif

  --$P============================================
  --$P ++ !support.mirror = $!support.mirror
  if (!support.mirror) then
    extend start thro pin 5
  else
    extend end thro pin 5
  endif
  --<wd>dec2004
  --$)

  PIN 5 COPY PIN 8
  if !tempOverlap eq 'OVERLAP' then
    !num = :MdsOnum
    PIN 5 plane PIN 5 CLEAR $!num INF $!<name>-V2
  else
    PIN 5 plane PIN 5 CLEAR $!overlap INF $!<name>-V2
  endif

  --<wd>dec2004
  --$P============================================
  --$P ++ !support.mirror = $!support.mirror
  --EXTEND START THRO PIN 5
  --$(
  if (!support.mirror) then
    extend end thro pin 5
  else
    extend start thro pin 5
  endif
  --<wd>dec2004
  --$)


  -- Set dimensions
  if (!method eq |CURSOR| or !method eq |CLEARANCE|)then
    -- Dimension 1
    if (!method eq |CURSOR|)then
      !dim1 = !!kStrReal('CONST DIST PIN 3 TO PIN 4')
    else
      !dim1 = !!kStrReal('CONST DIST PIN 8 TO PIN 9')
    endif
    !!mdsft35.dim1.val = !dim1
    -- Dimension 2
    PIN 2 COPY PIN 9
    PIN 2 plane PIN 2 THRO $!datum
    if (!method eq |CURSOR|)then
      !dim2 = !!kStrReal('CONST DIST PIN 2 TO PIN 4')
    else
      !dim2 = !!kStrReal('CONST DIST PIN 2 TO PIN 9')
    endif
    !!mdsft35.dim2.val = !dim2
    -- Dimension 3 and 4
    !dim3 = !!kStrReal('CONST DIST PIN 9 TO PIN 7')
    !!mdsft35.dim3.val = !dim3
    !dim4 = !!kStrReal('CONST DIST PIN 8 TO PIN 6')
    !!mdsft35.dim4.val = !dim4
  endif

  -- Select correct spref
  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  SEL SPREF WITH STYP '$!alias-$!selection' SPEC /MDF
  !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-$!selection')

  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)
  !!mdsDacControl(TRUE)

  !!ce = !stru
  -- Check to see if support is mirrored
  if (!support.mirror)then
    call !!mdsMirrorft35()
    !support.mirror = true
  endif

  -- If cross-bars existed replace them
  if (!support.bars.empty().not())then
    do !i indices !support.bars
      skip if (!i.eq(1))
      call !!mdsAddBarft35(!support, 'OLD')
    enddo
    !support.barLen = !!mdsft35.support.barLen
  endif
  !list = !support.bars[1]
  !references = ''
  do !i indices !list
    !references = !references & ' ' & !list[!i].string()
  enddo

  -- Set atta reference to datum cross bar
  !!ce = $!<name>-BAR-1
  :MDSAttaRef $!references
  !support.barLen[1] = deri length of CE
  !!ce = !stru


  -- Adjust for slope on horizontal lines only
  if (!pADir neq U and !pLDir neq U)then
    -- Check to see if the line is sloping
    !adjust = 0
    do !v values !atta
      !!ce = !v

      --<wd>oct2004
      skip if !!ce.name.match('/SREF').gt(0)
      --<wd>oct2004

      skip if !!ce.:mdsrotdir.east.set()
      !grad = pl grad
      if (!grad.neq(0))then

        --<wd>oct2004
        if (!!ce.pDir[9].wrt(/* ).east.abs().eq(1)) then
          !vHeight = 0
        elseif (!!ce.pDir[9].wrt(/* ).up.eq(0)) then
          !vHeight = 0
        else
          --<wd>oct2004

          !strucElement = ARRAY()
          !ref = $!name-BAR-1
          !strucElement.append(!ref)
          !vHeight = !!mdsAdjustSlope(!strucElement, !v)

          --<wd>oct2004
        endif
        --<wd>oct2004

      else
        !vHeight = 0
      endif
      if (!vHeight.gt(!adjust))then
        !adjust = !vHeight
      endif
    enddo

    -- Adjust required elements
    !!ce = $!<name>-BAR-1

    --<wd>oct2004
    --MOVE D WRT WORLD DIST $!adjust
    MOVE $!directions[3] DIST $!adjust
    --<wd>oct2004

    !!ce = $!<name>-V1
    !end   = Posend wrt world
    !start = Posstart wrt world

    if (!support.mirror)then
      PIN 6 AT $!end
      PIN 8 AT $!start
    else
      PIN 6 AT $!start
      PIN 8 AT $!end
    endif

    PIN 6 DIR TO PIN 8
    !toBar = 0
    do !indx indices !support.bars
      PIN 8 COPY PIN 6
      PIN 8 plane PIN 8 THRO $!<name>-BAR-$!indx
      !toBar1 = !!kStrReal('CONST DIST PIN 6 TO PIN 8')
      if (!toBar1.gt(!toBar))then
        !toBar = !toBar1
        !index = !indx
      endif
    enddo
    PIN 8 plane PIN 8 CLEAR 0 BEH $!<name>-BAR-$!index
    !num = :MDSOnum

    if !flush neq 'FLUSH' then
      if (!support.mirror)then
        if !flush eq 'OVERLAP' then
          EXTEND START THRO pin 8
          !num = :MdsOnum
          EXTEND START $!num
        else
          EXTEND START THRO pin 8
          --> Modified-<wd>-6oct1998
          --xxx            EXTEND START $!overlap
          EXTEND START -$!overlap
        endif
      else
        if !flush eq 'OVERLAP' then
          EXTEND END THRO pin 8
          !num = :MdsOnum
          EXTEND END $!num
        else
          EXTEND END THRO pin 8
          --> Modified-<wd>-6oct1998
          --xxx            EXTEND END $!overlap
          EXTEND END -$!overlap
        endif
      endif
    endif

    ------------------------- ****** connexions ******* -----------------------
    --<wd>oct2004 -- This CODE is NOT required and CONFUSING
    -- FT08 uses !vertical1 and !vertical2 in the CODE above!!!!!!!
$(
    if(!support.connections.unset()) then
      -- dimensions are being used first
      :MDSConn default
    else
      !vertical = !!ce
      !connected = !!mdsGetBeamConn(!support,!vertical)
      :MDSConn $!connected
    endif
$)
    -----------------------------********************--------------------------

    if (!method eq |DIMENSION|)then
      -- Extend vertical leg to account for the required adjustment

      if (!support.mirror)then
        !sctnEnd = 'END'
      else
        !sctnEnd = 'START'
      endif

      PIN 6 plane PIN 6 DIST -$!adjust
      EXTEND $!sctnEnd THRO PIN 6
    endif

    !!ce = $!<name>-V2
    !end   = Posend wrt world
    !start = Posstart wrt world

    if (!support.mirror)then
      PIN 7 AT $!end
      PIN 9 AT $!start
    else
      PIN 7 AT $!start
      PIN 9 AT $!end
    endif

    PIN 7 DIR TO PIN 9
    !toBar = 0
    do !indx indices !support.bars
      PIN 9 COPY PIN 7
      PIN 9 plane PIN 9 THRO $!<name>-BAR-$!indx
      !toBar1 = !!kStrReal('CONST DIST PIN 7 TO PIN 9')
      if (!toBar1.gt(!toBar))then
        !toBar = !toBar1
        !index = !indx
      endif
    enddo
    PIN 9 plane PIN 9 CLEAR 0 BEH $!<name>-BAR-$!index
    !num = :MDSOnum

    if !flush neq 'FLUSH' then
      if (!support.mirror)then
        if !flush eq 'OVERLAP' then
          EXTEND START THRO pin 9
          !num = :MdsOnum
          EXTEND START $!num
        else
          EXTEND START THRO pin 9
          --> Modified-<wd>-6oct1998
          --xxx            EXTEND START $!overlap
          EXTEND START -$!overlap
        endif
      else
        if !flush eq 'OVERLAP' then
          EXTEND END THRO pin 9
          !num = :MdsOnum
          EXTEND END $!num
        else
          EXTEND END THRO pin 9
          --> Modified-<wd>-6oct1998
          --xxx            EXTEND END $!overlap
          EXTEND END -$!overlap
        endif
      endif
    endif

    if (!method eq |DIMENSION|)then
      -- Extend vertical leg to account for the required adjustment

      if (!support.mirror)then
        !sctnEnd = 'END'
      else
        !sctnEnd = 'START'
      endif
      PIN 7 plane PIN 7 DIST -$!adjust
      EXTEND $!sctnEnd THRO PIN 7

    else
      -- Adjust dimensions on form
      !dim3Exist = !!mdsft35.dim3.val - !adjust
      !dim4Exist = !!mdsft35.dim4.val - !adjust
      -- reset dimensions on form
      !!mdsft35.dim3.val = !dim3Exist
      !!mdsft35.dim4.val = !dim4Exist
    endif
  endif
  -- End of Adjusting for Slope on Horizontal Lines Only

  --<k.pleschner>may06 modify Dim1 and Dim2 to reflect INSIDE/OUTSIDE build style when method is CLEARANCE or CURSOR
  if !buildStyleNew.eq('OUTSIDE').and(!method.eq('CURSOR').or(!method.eq('CLEARANCE'))) then
    !!mdsft35.dim1.val = !!mdsft35.dim1.val + !d35 + !d45
    !!mdsft35.dim2.val = !!mdsft35.dim2.val + !d45
  endif

  !!ce = $!<name>/SREF
  !!mdsDacControl(true)

  -- Despar 5 will store the maximum bore size on the support
  !srefName = !!mdsft35.support.stru.name + '/SREF'
  !!ce = !srefName.dbref()
  !largestBore = object BORE()
  !largestBore = !form.support.datum.abore
  do !loop values !!mdsft35.support.atta
    !largestBore = !loop.abore
    if !loop.abore.gt(!largestBore) then
      !largestBore = !loop.abore
    endif
  enddo
  -- Only set the largest bore is greater than the bore already stored
  !isNow = despara 5
  if !largestBore.real().lt(!isNow[1]) then
    !largestBore = !isNow[1].bore()
  endif
  DESPAR $!!mdsft35.dim1.val   $!!mdsft35.dim2.val   $!!mdsft35.dim3.val   $!!mdsft35.dim4.val   $!largestBore

  ------------------------------------------------------------------------------------------------------
  --<wd>nov2003>>>
  !!mdsDacControl(true)
  -- Check if ATTAS Created on The Support are Within the Allowable Bores for the STRUCTURE SCTN SIZES.
  !cecomp = !!ce
  !error  = STRING()
  if (!!mdscheckbores(!form,!selection,!error,!currentUnits)) then
    !!alert.error(!error)
    !!ce = !stru
    --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
    !!mdsRemoveAutoPadRules(!stru)
    --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end
    delete STRU MEM
    handle (41,66) (2,113) (2,113)
    endhandle
    -- Reset SREF Despars to ZERO as the STRU MEM have been DELETED
    !!ce = $!<name>/SREF
    handle none
      -- Only RESET the DESPARS for the DIMENSION GADGETS -
      -- DESPAR num 5 stores the LARGEST PIPE BORE SIZE on the SUPPORT and is still VALID
      desp num 1 0mm
      desp num 2 0mm
      desp num 3 0mm
      desp num 4 0mm
    elsehandle any
    endhandle
    -- Reset all pins associated with this support
    !!mdsResetPins(1,10)
    !!ce = !cecomp
    handle any
    endhandle
    !!mdsCreateMess(false)
    !!kRestoreUnits(!currentUnits)
    return
  endif
  --<wd>nov2003<<<
  ------------------------------------------------------------------------------------------------------

  !!mdsDacControl(false)
  -- Reset materials of sections
  !!mdsResetMat(!storeMat)

  !!ce = !stru
  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  -- Set 'FT25' form Support Object to be the same as 'ft35' form Support Object
  !!mdsft25.support = !support

  -- Clear packs from 'BOTH forms' Support Objects as the SCTNs have already been deleted
  -- During the Framework Creation above
  !!mdsft25.support.packs.clear()
  !support.packs.clear()

  -- Create Required Packing Pieces(SCTNs) at the Necessary Attas
  call !!mdscrpacksft25(!attapp, !!mdsft35)

  -- Update 'ft35' support.packs data to that held in form 'FT25'
  !support.packs = !!mdsft25.support.packs

  -- Navigate to Main Structure of Framework
  !!ce = !stru

  ----------------------***** connexions *****--------------------------
  if(!haveJoints) then
    do !index indices !joints

      if(!joints[!index].badref().not() and !attributes[!index][8].dbref().:MDSConn.eq(!joints[!index].owner.owner)) then
        !mainStl = !attributes[!index][8].dbref().:MDSConn
        !support.joints[!index] =  !!mdsCreateJoint(!mainStl, !attributes[!index][8].dbref(),!joints[!index],!attributes[!index])
      else
        !dummy = object DBREF()
        !dummyA = ARRAY()
        !mainStl = !support.connections[!index]
        !support.joints[!index] =  !!mdsCreateJoint(!mainStl, !attributes[!index][8].dbref(),!dummy,!dummyA)
      endif
    enddo
  endif
  ----------------------------------------------------------------------

  -- If a joint is being used and it is handed then their will be a alternative spref of the
  -- opposite hand joint and the bang to set separated by a ,
  !!mdsSwapIntJoi(!support.stru,!support.mirror,!support.alias)

  -- If substructures exist and the :MDSCp1 attribute is set to 'MOVE'
  -- then move SUBS1 thro V1 and SUBS2 thro V2
  $!name/SUBS$n1
  handle any
  elsehandle none
    if !!ce.:MDScp1.eq('MOVE') then
      move $!p10Dir thro $!name-V1
    endif
  endhandle

  $!name/SUBS$n2
  handle any
  elsehandle none
    if !!ce.:MDScp1.eq('MOVE') then
      move $!p10Dir thro $!name-V2
    endif
  endhandle

  !!ce = !stru
  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.append(!!ce)
  !colourList.appendarray(!support.atta)
  !colourList.appendarray(!support.joints)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- reset :mdsancref attributes if set
  !support.plateconns.restoreconns()

  -- Update support data held in form
  !!mdsft35.support = !support

  !!mdsCreateMess(false)

  -- Move the snod of the V1 through the BAR
  !!ce = $!<name>-V1
  var !sjois coll all sjoi for ce
  do !resetZdist values !sjois
    !!ce = !resetZdist.dbref()
    !cref = !!ce.cref
    end
    zdist Through $!cref
  enddo

  !!ce = $!<name>-V2
  var !sjois coll all sjoi for ce
  do !resetZdist values !sjois
    !!ce = !resetZdist.dbref()
    !cref = !!ce.cref
    end
    zdist Through $!cref
  enddo

  ---------------------------------------------------------------------------------
  -- Move the STRU to the Offset Position relative to the setting
  -- in the UDA :MdsNudgeDist of the DATUM ATTA only.
  !checkdat = object MDSCHECKDATUM()
  !checkdat.offset(!form)

  -- Add the Aid Text to P9 of each Support Atta on the Framework
  !!mdsaidtext(!form)
  ---------------------------------------------------------------------------------


  -------------------------------------------------
  --<wd>dec2004 --
$(
  -- The DATUM ATTA will be a LUG that should sit on the face of the steelwork,
  -- work out if the framework should be moved up or down.
$)

  -- When the DATUM ATTA is a LUG, which must sit on the FACE of the SCTN $!name-BAR-1.
  -- Determine the DIRECTION and DISTANCE to move the SCTNS $!name-BAR-1, $!name-V1 and $!name-V1
  -- The ORIGIN of the STRU will remain at the P9 of the DATUM ATTA as before.
  if (!datum.styp.upcase().matchwild('*LT*')) then
    !!ce = $!name-BAR-1
    var !dir1 ppline NAL dir wrt /*
    var !dir2 ppline NAT dir wrt /*

    -- FT35 is now allowed on BOTH Horizontal/Sloping and Vertical Pipes
    --if !dir1.eq('D') or !dir2 eq ('D') then
    --!moveDir = 'U'
    --else
    --!moveDir = 'D'
    --endif

    -- Set Up the DATUM ATTA Direction Array !attadir for the SCTN pline direction check
    !attadir    = ARRAY()
    -- Set the Datum Atta ORTHOGONAL PLEAVE direction in the array !attadir
    !attadir[1] = !directions[1]
    -- Set the Datum Atta ORTHOGONAL PARRIVE direction in the array !attadir
    !attadir[2] = !directions[2]

    -- Set Up the SCTN Direction Array !plindir for the SCTN pline direction check
    !plindir    = ARRAY()
    -- Set the SCTN Pline NAL direction in the array !plindir
    !plindir[1] = !dir1.direction()
    -- Set the SCTN Pline NAT direction in the array !plindir
    !plindir[2] = !dir2.direction()

    -- Check if the SCTN Plines NAL<!dir1> or NAT<!dir2> Direction are within the allowable
    -- tolerance of "1<one> degree" to the PLEAVE or the PARRIVE directions of the DATUM ATTA
    do !attaindx indices !attadir
      do !plinindx indices !plindir
        -- Determine the !moveDir direction
        -- Set KEQUALDIR object definition
        !dira     = !attadir[!attaindx]
        !dirb     = !plindir[!plinindx]
        !checkdir = object KEQUALDIR()
        !checkdir.directionA = !dira
        !checkdir.directionB = !dirb
        !checkdir.tolerance  = 1

        -- Check if directions are Parallel within a Tolerance Angle of (+/-) 1 degree
        if (!!mdsdirequaldir(!checkdir)) then
          !attadirnum = !attaindx
          !plindirnum = !plinindx
          !breakloop  = TRUE
          break
          -- Close the this "do" loop if directions are parallel within the tolerance of 1<one> degree
        else
          !breakloop = FALSE
        endif
      enddo

      if (!breakloop) then
        -- Directions are parallel within the tolerance of 1<one> degree.
        -- Close the this "do" loop if !attadirnum and !plindirnum are defined
        break
      endif
    enddo

    --$P ** !sCTNDIR    = $!plindirnum
    --$P ** !aTTAPAorPL = $!attadirnum
    -- Determine the Direction variable !moveDir from the values set in the variables !attadirnum and !plindirnum
    --$(
    if (!attadirnum.eq(1) and !plindirnum.eq(2)) then
      -- Datum Atta ORTHOGONAL Pleave Direction and X-Bar Pline NAT Direction are in the SAME direction
      !xbarpline = 'NAT'
      if (!support.mirror) then
        !moveDir = !directions[1]
        --$P= 1a
      else
        !moveDir = !directions[2]
        --$P = 1b
      endif

    elseif (!attadirnum.eq(2) and !plindirnum.eq(2)) then
      -- Datum Atta ORTHOGONAL Parrive Direction and X-Bar Pline NAT Direction are in the SAME direction
      !xbarpline = 'NAT'
      !moveDir = !directions[2]

    elseif (!attadirnum.eq(1) and !plindirnum.eq(1)) then
      -- Datum Atta ORTHOGONAL Pleave Direction and X-Bar Pline NAL Direction are in the SAME direction
      !xbarpline = 'NAL'
      !moveDir = !directions[1]

    elseif (!attadirnum.eq(2) and !plindirnum.eq(1)) then
      -- Datum Atta ORTHOGONAL Parrive Direction and X-Bar Pline NAL Direction are in the SAME direction
      !xbarpline = 'NAL'
      !moveDir = !directions[2]

    else
      !!alert.error('Unable to determine the direction to move the SCTN members of the support. i.e. MDS template cross bar SCTN must be an ANGLE profile.')
      !moveDir = !directions[1]
    endif
    --$)

$(
    if ( (!dir1.direction().eq(!directions[1])) or (!dir2.direction().eq(!directions[1])) ) then
      -- SCTN Pline NAL<!dir1> or Pline NAT<!dir2> is in the same ORTHOGONAL direction as the DATUM ATTA PLEAVE direction
      !moveDir = !directions[2]

    elseif ( (!dir1.direction().eq(!directions[2])) or (!dir2.direction().eq(!directions[2])) ) then
      -- SCTN Pline NAL<!dir1> or Pline NAT<!dir2> is in the same ORTHOGONAL direction as the DATUM ATTA PARRIVE direction
      !moveDir = !directions[1]
    endif
$)

    --pin 1 at poss
    pin 1 at ppline $!xbarpline start
    pin 2 copy pin 1
    --pin 1 dir $!moveDir wrt /*
    --pin 2 dir $!moveDir wrt /*
    pin 1 dir $!moveDir
    pin 2 dir $!moveDir

    --if !moveDir.eq('U') then
    --pin 1 plane pin 1 clear 0 inf $!name-BAR-1
    --pin 2 plane pin 2 clear 0 beh $!name/DATUM
    --else
    --pin 1 plane pin 1 clear 0 beh $!name-BAR-1
    --pin 2 plane pin 2 clear 0 Inf $!name/DATUM
    --endif

    if (!moveDir.eq(!directions[2])) then
      -- Move the SCTNS in the Parrive direction of the DATUM ATTA
      pin 2 plane pin 2 clear 0 beh $!name/DATUM
      --$P 2 = parrive !directions[2]

    elseif (!moveDir.eq(!directions[1])) then

      -- Move the SCTNS in the Parrive direction of the DATUM ATTA
      pin 1 plane pin 1 clear 0 inf $!name-BAR-1
      pin 2 plane pin 2 clear 0 beh $!name/DATUM
      --$P 1 = pleave !directions[1]
    endif


    var !moveDist const dist pin 1 to pin 2
    --q name
    --$P ** move $!moveDir dist $!moveDist

    -- by $!moveDir $!moveDist wrt /*
    move $!moveDir dist $!moveDist

    !!ce = $!name-V1
    -- by $!moveDir $!moveDist wrt /*
    move $!moveDir dist $!moveDist

    !!ce = $!name-V2
    -- by $!moveDir $!moveDist wrt /*
    move $!moveDir dist $!moveDist
  endif

  if defined(!saveV1) then
    !saveV1.restoreplane(!!mdsft35.dim4.val ,0)
    !saveV2.restoreplane(!!mdsft35.dim3.val ,0)
  endif
  --<wd>dec2004 -- 'if' is at line 1661
  -------------------------------------------------

  !!ce = !stru
  -- Copy welds locally
  !copyWelds = object MDSWELDLIST(!!ce,!form)
  !!ce = !stru


  -- Code for sloping decks
  if defined(!testCe[3]) then

    if (!method eq |CLEARANCE|)then
      !!mdstrimplane($!name-V1 ,!support.mirror, !testCe[2],'start' )
      !!mdstrimplane($!name-V2 ,!support.mirror, !testCe[2],'start' )
    elseif (!method eq |CURSOR|)then
      if !vertLeg then
        !first = 2
        !second = 1
      else
        !first = 1
        !second = 2
      endif
      if (defined(!testcepick1[2])) then
        !!mdstrimplane($!name-V$!first ,!support.mirror, !testcepick1[2], 'start')
      endif
      if (defined(!testcepick2[2])) then
        !!mdstrimplane($!name-V$!second ,!support.mirror, !testcepick2[2], 'start')
      endif
    endif

    -- we have trimmed the length of the vertical section to suit the panel
    -- now we need to reset the dimension
    !!mdsft35.dim4.val = !!mdsgetoverdim($!datum , $!name-V1 ,0)
    !!mdsft35.dim3.val = !!mdsgetoverdim($!datum , $!name-V2 ,0)

    -- This section added to trim and extend section ends if identified element
    -- is a section/gensec on a slope
  else
    if (!method eq |CLEARANCE|)then

      --<wd>may2007<mds12>
      --      if !pick3.hardType.eq('SCTN') or !pick3.hardType.eq('GENSEC') then
      if (!pick3.hardType eq 'SCTN' or !pick3.hardType eq 'GENSEC' or !pick3.type eq 'HSTIFF') then
        --<wd>may2007<mds12>

        !x = object MDSPLINES(!pick3,$!name-V1 ,TRUE )
        !x = object MDSPLINES(!pick3,$!name-V2 ,TRUE )
      endif
    elseif (!method eq |CURSOR|)then

      --<wd>may2007<mds12>
      --      if !pick1.hardType.eq('SCTN') or !pick1.hardType.eq('GENSEC') then
      if (!pick1.hardType eq 'SCTN' or !pick1.hardType eq 'GENSEC' or !pick1.type eq 'HSTIFF') then
        --<wd>may2007<mds12>

        if !vertLeg then
          !x = object MDSPLINES(!pick1,$!name-V2 ,TRUE )
        else
          !x = object MDSPLINES(!pick1,$!name-V1 ,TRUE )
        endif
      endif

      --<wd>may2007<mds12>
      --      if !pick2.hardType.eq('SCTN') or !pick2.hardType.eq('GENSEC') then
      if (!pick2.hardType eq 'SCTN' or !pick2.hardType eq 'GENSEC' or !pick2.type eq 'HSTIFF') then
        --<wd>may2007<mds12>

        if !vertLeg then
          !x = object MDSPLINES(!pick2,$!name-V1 ,TRUE )
        else
          !x = object MDSPLINES(!pick2,$!name-V2 ,TRUE )
        endif
      endif
    endif
    if !method neq |DIMENSION| then
      !!mdsft35.dim4.val = !!mdsgetoverdim($!datum , $!name-V1 ,0)
      !!mdsft35.dim3.val = !!mdsgetoverdim($!datum , $!name-V2 ,0)
    endif

  endif
  -- Store dimensions in design parameters
  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  desp num 3 $!!mdsft35.dim3.val
  desp num 4 $!!mdsft35.dim4.val
  !!mdsDacControl(false)

  -- Show dimensions on graphics if required
  if !!mdsft35.graphicalDim then
    !!mdsshowdim(!!mdsft35)
  endif
  --<dw>sep2007 Restore bracing
  !!mdsrestorebracing(!form)
  --<dw>sep2007
  -- Reset all pins associated with this support
  call !!mdsResetPins(1,10)

  --<k.pleschner>may06 Message displayed if buildstyle has changed
  if !buildStyle.neq(!buildStyleNew).and(!struIsOld) then
    refresh
    !!alert.warning('Building style of the support has been changed - check DIM 1 and DIM 2')
  endif

  --<kp>mar07 Handle snipes
  !!mdsSnipe(!support.stru)

  ---------------------------------------------------------------------------------------------------
  --<wd>aug2007<mds12>
  -- Update the MDSSCTN and MDSFITTING Objects to the latest DATA in the MDSSUPPORT object member .mdssctns,
  -- i.e. !form.support.mdsctns, where any MDS SNIPES(FITTINGS) exist on the MDS SUPPORT SCTNS where the GTYP of CATREF is 'ANG'
  -- and the MDS SNIPE/FITTING element PURPOSE attribute is set to 'XGUI'
  --
  -- ALL OTHER MDS SNIPES are generated automatically or from the MDS TEMPLATE during the MDS STRUCTURE creation/modification.
  -- ** NOTE ** The SNIPE UPDATE applies to ALL METHODS(!method) of Creation,
  -- i.e. 'CREATE by CURSOR/DIMENSION/CLEARANCE and RESIZING of the MDS TEMPLATE
  !!mdsrestoresnipe(!form, 'DIMENSION')

  -- REGENERATE the DATA stored in the FORM MDSSUPPORT object member "!form.support.mdssctns"
  -- for ALL of the MDS Support SCTNS and ALL the associated MDS SNIPE(FITTING) members
  !!mdssupportsctns(!form)
  --<wd>aug2007<mds12>
  ---------------------------------------------------------------------------------------------------

  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  --<wd>jun2007<mds12>
  -- Create the Cross Reference ASSOCIATIONS between the MDS SUPPORT SCTN members $!name-V1 and $!name-V2
  -- and the Main Structure supporting elements for:
  -- <a> CURSOR mode !pick1 and !pick2 -- or -- <b> CLEARANCE mode !pick3
  --
  -- Store the Original Current Element
  !xce = !!ce

  -- Store the Array of MDS Support Members in the MDSASSOC Object
  !mdsassoc.mdsmember[1] = $!name-V1
  !mdsassoc.mdsmember[2] = $!name-V2

  -- Initialising the MDSASSOWL object always DELETES ALL of the EXISTING Cross Reference Associations
  -- (ASSOC) elements for the Current MDS Support, irrespective of the Creation MODE (!method)
  !mdsassowl = object MDSASSOWL(!form)
  !mdsassowl.mdsform  = !form
  !mdsassowl.mdsassoc = !mdsassoc

  -- Create the Association (ASSOCs) for the Current Support
  !mdsassowl.mdsassoc(!mdsassoc)

  -- Update the FORM SUPPORT object to reference the current MDSASSOWL Associations object
  !form.support.associations[1] = !mdsassowl
  !support = !form.support

  -- Navigate back to the Original Current Element
  !!ce = !xce

  -- Add pads if automatic pads option is on and a PANE or HPLATE has been picked
  if !!mdsOptions.autopads.selection().eq('ON') then
    !whichVerticals = 'ALL'
    if !method.eq('CURSOR') and (!pick1.hardType.eq('PANE') or !pick1.hardType.eq('HPLATE') or !pick2.hardType.eq('PANE') or !pick2.hardType.eq('HPLATE')) then
      if !pick1.hardType.eq('SCTN') and !pick2.hardType.eq('PANE') or !pick1.hardType.eq('HSTIFF') and !pick2.hardType.eq('HPLATE') or !pick2.hardType.eq('SCTN') and !pick1.hardType.eq('PANE') or !pick2.hardType.eq('HSTIFF') and !pick1.hardType.eq('HPLATE') then

        if (!pick1.hardType inset('PANE','HPLATE')) then
          !plane = object PLANE(!pick1.pos,!pick1.ori)
        elseif (!pick2.hardType inset('PANE','HPLATE')) then
          !plane = object PLANE(!pick2.pos,!pick2.ori)
        endif

        !v1 = (!name & '-V1')
        !v1ref = !v1.dbref()
        !v2 = (!name & '-V2')
        !v2ref = !v2.dbref()

        !v1Dist = !plane.near(!v1ref.poss).distance(!v1ref.poss)
        !v2Dist = !plane.near(!v2ref.poss).distance(!v2ref.poss)

        if !v1Dist.geq(!v2Dist) then
      	  !whichVerticals = 'V2'
        else
      	  !whichVerticals = 'V1'
        endif
      endif
    !!mdsaddpad(!support,!whichVerticals)
    elseif !method.eq('CLEARANCE') and (!pick3.hardType.eq('PANE') or !pick3.hardType.eq('HPLATE')) then
      !!mdsaddpad(!support,!whichVerticals)
    elseif !method.eq('DIMENSION') and !padsExist then
      !!mdsaddpad(!support,!whichVerticals)
    endif
  endif

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- End function
endfunction
