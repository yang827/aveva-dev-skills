--
-- File:  mdscreateft40.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MPS141
--
-- Author:              Neale Morris
-- Created:             March 2002
--
--
-- Description:
-- function to create support frame type 40
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCreateft40(!method is STRING)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  call !!mdsResetPins(1,9)

  --<wd>may2007<mds12>
  !session   = current session
  if !session.module().upcase().match('DESIGN').gt(0) then
    !iDType = 'GENSEC SCTN PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX'
  elseif  !session.module().upcase().match('OUTFITTING').gt(0) then
    !iDType = 'GENSEC SCTN PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX HSTIFF HPLATE'
  endif
  --<wd>may2007<mds12>

  !support   = !!mdsFt40.support
  --!clearance = !!mdsOptions.clear.val
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !datum     = !support.datum
  !stru      = !support.stru
  !name      = !stru.name
  !p10Dir    = !support.p10Dir
  !p11Dir    = !support.p11Dir
  !pLDir     = !support.pLDir
  !pADir     = !support.pADir

  var !pjoiColl coll all pjoi with gtyp eq 'APAD' for $!stru
  if !pjoiColl.size().neq(0) then
    !padsExist = TRUE
  else
    !padsExist = FALSE
  endif

  --<k.pleschner>Jun06
  !datumDflts = object MDSANCGEOMDFLTS(!datum)
  !clearance = !datumDflts.cend
  --<k.pleschner>

  --<wd>dec2004
  --!support.rotateCur = TRUE
  -- Horizontal Pipes are always FALSE i.e. OPPOSITE to the original code commented out above!
  --Vertical Pipes need to be determined later on in the code!
  !support.rotateCur = FALSE
  --<wd>dec2004

  -- Does the support have attached/Associated supports
  if !!mdsgetconnectedsupp(!stru) then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Connections
  !refe         = !!ce
  !form      = !!mdsFt40

  --<wd>jun2007<mds12>
  -- Initialise the MDS Associations Data Creation Object MDSASSOC
  !mdsassoc = object MDSASSOC()
  !mdsassoc.mode = !method
  --<wd>jun2007<mds12>

  -- Can we write to the spref attribute of the SREF atta and the stru
  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  !haveJoints = FALSE
  if(!form.support.joints.unset().not()) then
    !joints     = !support.joints
    !attributes = ARRAY()
    !haveJoints = !!kRestoreJoints(!joints,!attributes,'SAVE','')
    handle ANY
      !haveJoints = FALSE
      !support.joints.clear()
      -- in case they have been deleted and cancel is used
    endhandle
  endif

  ---------------------------------------------------------------------------------
  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Check that Datum atta has been positioned
  if (!support.position.not())then
    !!alert.message('Position atta before identifying supporting structural element')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Set Dimension Gadgets to ZERO if Creation is by CURSOR or CLEARANCE
  if ( (!method.eq('CURSOR')) or (!method.eq('CLEARANCE')) ) then
    !!mdsFt40.dim1.val = 0
    !!mdsFt40.dim2.val = 0
    !!mdsFt40.dim3.val = 0
    !!mdsFt40.dim4.val = 0
  endif

  ------------------------------------------------------------------------------------------------------
  --<wd>aug2007<mds12>
  -- ENSURE ALL the current MDS SNIPES(FITTINGS) that EXIST on the current MDS STRUCTURE SCTN elements are STORED,
  -- so "UPDATE" the FORM MDSSUPPORT object member "!form.support.mdssctns" to represent the current MDS STRUCTURE.
  -- *** IMPORTANT*** The object needs to be UPDATED before CREATIIN/MODIFICATION of the MDS STRUCTURE commences,
  -- as ADDITIONAL MDS SNIPES may have been ADDED/MODIFIED/DELETED by the USER since the FORM was initialised,
  -- via the !!mdsSnipe form utility from the MAIN "MDS DESIGN application" BAR menu option... "Modify>Snipe on Angle..."
  --
  -- REGENERATE the DATA stored in the FORM MDSSUPPORT object member "!form.support.mdssctns"
  -- for ALL of the current MDS Support SCTNS and ALL the associated MDS SNIPE(FITTING) members
  !!mdssupportsctns(!form)

  -- UPDATE the local !support object variable with the latest MDSSNIPE DATA
  !support.mdssctns      = !form.support.mdssctns
  !support.mdssctnsstore = !form.support.mdssctnsstore

  --<wd>aug2007<mds12>
  ------------------------------------------------------------------------------------------------------

  -- Check which attas to work from
  if (!support.bars.size() leq 1)then
    !atta = !support.atta
  else
    !atta = !support.bars[1]
  endif

  -------------------------------------------------
  --<wd>dec2004
  -- !ddir and !udir variables are now always defined from the ACTUAL P9 direction of the DATUM Atta
  --------------------------------------------------------------------------------------------------
  ----------------------------------------------
  --<wd>dec2004
  -- For Vertical Pipes, Sloping and True Horizontal Pipes
  -- [1] ORTHOGONAL Pleave Direction Object of the Piping Component, e.g.mDS Support Datum Atta
  -- [2] ORTHOGONAL Opposite Direction Object to PLeave of the Piping Component, e.g.mDS Support Datum Atta
  -- [3] ORTHOGONAL PPoint[9] Direction Object of the Piping Component, e.g.mDS Support Datum Atta
  -- [4] ORTHOGONAL Opposite Direction Object to PPoint[9] of the Piping Component, e.g.mDS Support Datum Atta
  -- [5] ORTHOGONAL PPoint[10] Direction Object of the Piping Component, e.g.mDS Support Datum Atta
  -- [6] ORTHOGONAL PPoint[11] Opposite Direction Object to PPoint[10] of the Piping Component, e.g.mDS Support Datum Atta


  !directions            = !!mdsremovegrad(!datum)
  !support.datumorthdirs = !directions
  !pLDir                 = !directions[1]
  !pADir                 = !directions[2]
  !orix                  = !directions[5]
  !oriz                  = !directions[4]
  !ddir                  = !directions[3]
  !udir                  = !directions[4]
  !p10Dir                = !directions[5]
  !p11Dir                = !directions[6]

  -- Force attas that have been offset back to centerline
  if (!support.offset ne 'MID')then
    call !!mdsslideft40('MID')
  endif

  -- Store section name and matref for each member for resetting later
  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)

  -- Create by CURSOR
  if (!method eq |CURSOR|)then
    !errorMessage = STRING()
    !dummyS       = ''

    if(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('UNJOINTED')) then
      -- nothing to do
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('WARNING')) then
      !continue = !!alert.confirm(!errorMessage)
      if(!continue.eq('NO')) then
        !!kRestoreUnits(!currentUnits)
        return
      endif
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('ERROR')) then
      !!alert.error(!errorMessage)
      !!kRestoreUnits(!currentUnits)
      return
    endif

    label /Element1

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify element to support from|
    ID $!iDType @
    handle (61,528)
      PROMPT ON
      !!ce = !stru
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    PROMPT DISMISS
    PROMPT ON
    !pick = !!ce
    !testCe = !!mdsRelToDatum(!datum, !pick, !ddir, !clearance.real())

    -- If !testCe is 'below' then carry on
    -- Check for Horiz Pipes Only
    if (!testCe[1].upcase() eq 'UNSET')then
      !!alert.error('Identified element is unsuitable to support from.')
      golabel /Element1
    elseif (!testCe[1].upcase() eq '')then
      golabel /Element1
    endif
    if (!pADir eq U or !pLDir eq U)then
      if (!testCe[1].upcase() eq 'ABOVE')then
        !!alert.error('Identified element is behind pipe.')
        golabel /Element1
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is in line with the datum atta')
        golabel /Element1
      endif
    else
      if (!testCe[1].upcase() eq 'ABOVE')then
        !!alert.error('Identified element is above pipe.')
        golabel /Element1
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is at the same elevation as the datum atta')
        golabel /Element1
      endif
    endif

    --<wd>may2007<mds12>
    --    if (!pick.hardType eq 'PANE' or !pick.type eq 'BOX')then
    if (!pick.hardType eq 'PANE' or !pick.type eq 'BOX' or !pick.type.eq('HPLATE')) then
      --<wd>may2007<mds12>

      !plane1 = !testCe[2]
      VAR !pDir1 CONST DIR $!plane1
    endif

    -- Check for framework orientation
    if (!support.rotateCur)then
      !toVert   = !p11Dir
      !fromVert = !p10Dir
    else
      !toVert   = !p10Dir
      !fromVert = !p11Dir
    endif

    !!mdsCreateMess(true)

    -- <k.pleschner>Nov06
    -- get suitable orientation of template
    !mdsTmplOri = !!mdsGetTmplOri(!datum,!pick,!pick)

    -- Position Pins
    !!ce = !pick

    -- Check to see if item picked is a bedplate, type 'FT22'.

    --<wd>may2007<mds12>
    --    if (!pick.hardType eq 'PANE' or !pick.type eq 'BOX')then
    if (!pick.hardType eq 'PANE' or !pick.type eq 'BOX' or !pick.type.eq('HPLATE')) then
      --      STRU
      --      !frameType = !!ce.:MDSSuppType
      STRU
      handle NONE
        !type = !!ce.:MDSSuppType
      elsehandle ANY
        !type = ''
      endhandle
      --<wd>may2007<mds12>

      -- Check to see if item picked is a bedplate, type 'FT22'.
      if (!type eq 'FT22')then
        !bedplate = true
        PIN 1 AT $!pick
        PIN 1 DIR $!pDir1
        VAR !tempInter CONS POS INT PIN 1 $!plane1
        !inter = !tempInter.position()
      else
        -- Position pins clear of attas
        -- if type is panel or box
        PIN 1 AT P0 of $!datum
        PIN 1 DIR $!p10Dir
        PIN 2 COPY PIN 1
        !dim = 0
        --do !i values !support.atta
        do !iref values !support.atta
          --<k.pleschner>Jun06
          -- avoid SREF atta
          skip if !iref.name.substring(-1,-5).eq('/SREF')
          !i = object MDSANCGEOMDFLTS(!iref)

          --PIN 2 plane PIN 2 CLEAR $!clearance BEH $!i
          if !i.clge.eq('GEOM') then
            -- use clearance from geometry
            PIN 2 plane PIN 2 CLEAR $!i.oend BEH $!i
          else
            -- use distance from centreline
            PIN 2 plane PIN 2 THR $!i
            PIN 2 plane PIN 2 DIST $!i.oend
          endif
          handle (2,109)
            break
          endhandle
          VAR !cdir CONST DIR PIN 1 TO PIN 2
          !cdim = !!kStrReal('CONST DIST PIN 1 TO PIN 2')
          -- Set object definition
          !direction = object KEQUALDIR()
          !direction.directionA = !cdir.direction()
          !direction.directionB = !p10Dir
          !direction.tolerance  = 0.05
          if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
            PIN 2 AT $!datum
            PIN 2 DIST $!cdim
            !dim = !cdim
          else
            PIN 2 AT $!datum
            PIN 2 DIST $!dim
          endif
        enddo
        PIN 1 DIR $!ddir
        VAR !tempInter CONS POS INT PIN 1 $!plane1
        !inter = !tempInter.position()
      endif

      --<wd>may2007<mds12>
      --    elseif (!pick.type eq 'SCTN') or (!pick.hardType eq 'GENSEC') then
    elseif (!pick.type eq 'SCTN') or (!pick.hardType.eq('GENSEC') or !pick.hardType.eq('HSTIFF')) then
      --<wd>may2007<mds12>

      !support.connections[1] = !pick
      !start = plstart NA wrt world
      !end   = plend NA wrt world
      var !lineA CONS line JOIN $!start to $!end
      var !lineB CONS line P10 of $!datum
      var !lineC CONS line PAR $!lineB THROUGH P9 of $!datum
      var !tempInter CONS POS INT $!lineA $!lineC
      !inter = !tempInter.position()
      if (!inter.unset())then
        !!mdsCreateMess(false)
        !!alert.error('Unable to create support from the identified section using this method. Use ''Create by'' Clearance or Dimensions')
        !!kRestoreUnits(!currentUnits)
        return

        -------------------------------------------------
        --<wd>dec2004
      else
        -- Check if Picked SCTN is Parallel to P10 direction of DATUM atta within a tolerance angle of +/- 5 degrees
        -- Get the Directions of the Constructed Lines and Check if they are Parallel within a Tolerance Angle of (+/-) 5 degrees
        -- Set KEQUALDIR object definition
        !dira = !lineA.after('line ').before( 'through').direction()
        !dirb = !lineB.after('line ').before( 'through').direction()
        !checkdir = object KEQUALDIR()
        !checkdir.directionA = !dira
        !checkdir.directionB = !dirb
        !checkdir.tolerance  = 5

        -- Only DO this if the variable "!inter" has been "set".
        -- Check if directions are Parallel within a Tolerance Angle of (+/-) 5 degrees
        if (!!mdsdirequaldir(!checkdir)) then
          -- TRUE so treat the "!inter" variable as if it is "unset" and
          -- Exit CURSOR creation because the SCTN is at right angles to Pipe/Branch Direction
          !!mdsCreateMess(false)
          !!alert.error('Unable to create support from the identified section using this method. use ''create by'' clearance or dimensions')
          !!kRestoreUnits(!currentUnits)
          return
        endif
        --<wd>dec2004
        -------------------------------------------------
      endif

      -- Pin 1  at top of picked sctn at intersection point.
      pin 1 at $!inter
      pin 1 dir $!ddir
      PIN 1 plane PIN 1 THRO P9 OF $!datum
      -- Pin 1 now at elevation of p9 of datum atta at intersection point
      VAR !pin1Pos PIN 1 POS wrt /*
      !inter = !!kFlangeOrWeb(!pick, !pin1Pos.position(), !ddir)
    endif
    -- END of CURSOR mode for SCTN option

    --&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&
    -- Common pin positions for all Options whilst in CURSOR mode
    --&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&

    --<wd>jun2007<mds12>
    -- Save !pick and for Associations
    !mdsassoc.pick1 = !pick
    --<wd>jun2007<mds12>

    -- Pin 9  at intersection position of nearest pline of picked sctn
    PIN 9 AT $!inter
    PIN 9 DIR $!ddir

    -- Test position of pin 1 relative to datum to determine orientation
    PIN 1 copy P10 of $!datum
    PIN 1 plane PIN 1 thro PIN 9
    var !testDir CONS DIR P10 of $!datum to PIN 1

    -- Set object definition
    !direction = object KEQUALDIR()
    !direction.directionA = !testDir.direction()
    !direction.directionB = !p10Dir
    !direction.tolerance  = 0.05

    -----------------------------------------------------
    --<wd>dec2004 -- Only Check on Vertical Pipes
    -----------------------------------------------------
    if (!pLDir.up.abs().eq(1)) then
      -----------------------------------------------------
      -- Check directions
      --$(
      if (!!kDirEqualDir(!direction)) then
        -- Vertical leg on right of p10 of datum atta looking down the PIPE flow
        !support.rotateCur = TRUE
      else
        !support.rotateCur = FALSE
        -- Vertical leg on left of p10 of datum atta looking down the PIPE flow
      endif
      --$)
      -----------------------------------------------------
    endif
    -----------------------------------------------------

    PIN 7 AT P0 OF $!datum
    PIN 7 DIR $!toVert
    PIN 7 plane PIN 7 THRO PIN 9
    PIN 7 DIR $!udir
    PIN 7 plane PIN 7 THRO PIN 9
    PIN 9 COPY PIN 7
    PIN 9 plane PIN 9 THRO P9 OF $!datum
    PIN 9 DIR $!toVert
    PIN 8 COPY PIN9
    PIN 8 plane PIN 8 THRO P9 OF $!datum
    !pin8pin9 = !!kStrReal('const dist pin 8 to pin 9')
    !pin8pin9dist = !pin8pin9

    if (!pin8pin9dist le 0 ) then
      !samepos = true
      var !pin9pos pin 9 pos wrt worl
      var !pin8pos pin 8 pos wrt worl
      pin 9 dist -20
      pin 8 dist -10
      PIN 9 DIR FROM PIN 8 TO PIN 9
      PIN 8 DIR FROM PIN 9 TO PIN 8
      pin 9 at $!pin9pos wrt worl
      pin 8 at $!pin8pos wrt worl
    else
      !samepos = false
      PIN 9 DIR FROM PIN 8 TO PIN 9
      PIN 8 DIR FROM PIN 9 TO PIN 8
    endif

    VAR !tempPin8Dir PIN8 DIR
    var !tempPin9Dir PIN9 DIR

    -- Do loop checks ATTAS on first Horiz. SCTN ( Only One for ft40 frametype )
    -----------------------------------------------------------------------------

    -- Position pin 4 on the datum atta side at the
    -- START of the HORIZ. SCTN i.e. clear of the last atta
    -- on that side of the VERTICAL SCTN.

    !dim = 0
    --do !i values !atta
    do !iref values !atta
      --<k.pleschner>Jun06
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)

      PIN 4 COPY PIN 8
      PIN 4 AT $!datum
      --PIN 4 plane PIN 4 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 4 plane PIN 4 CLEAR $!i.oend BEH $!i
      else
        -- use distance from centreline
        PIN 4 plane PIN 4 THR $!i
        PIN 4 plane PIN 4 DIST $!i.oend
      endif
      handle (2,109) (2,107) $* Undefined Name or Reference
        break
      endhandle
      VAR !cdir CONST DIR P0 of $!datum TO PIN 4
      !cdim = !!kStrReal('CONST DIST P0 of $!datum TO PIN 4')
      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cdir.direction()
      !direction.directionB = !tempPin8Dir.direction()
      !direction.tolerance  = 0.05
      if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 4 AT $!datum
        PIN 4 DIST $!cdim
        !dim = !cdim
      else
        PIN 4 AT $!datum
        PIN 4 DIST $!dim
      endif
    enddo

    if (not !samepos) then
      PIN 4 DIR FROM PIN 8 TO PIN 9
    endif

    -- Position pin 3 on the OPPOSITE side to the datum atta side at the
    -- END of the HORIZ. SCTN ie. clear of the last atta
    -- on that side of the VERTICAL SCTN.
    !cdir.delete()
    !cdim.delete()
    !dim = 0

    --do !i values !atta
    do !iref values !atta
      --<k.pleschner>Jun06
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)

      PIN 3 COPY PIN 9
      PIN 3 AT $!datum
      --PIN 3 plane PIN 3 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 3 plane PIN 3 CLEAR $!i.oend BEH $!i
      else
        -- use distance from centreline
        PIN 3 plane PIN 3 THR $!i
        PIN 3 plane PIN 3 DIST $!i.oend
      endif
      handle (2,109) (2,107) $* Undefined Name or Reference
        break
      endhandle
      VAR !cdir CONST DIR P0 of $!datum TO PIN 3
      !cdim = !!kStrReal('CONST DIST P0 of $!datum TO PIN 3')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cdir.direction()
      !direction.directionB = !tempPin9Dir.direction()
      !direction.tolerance  = 0.05

      if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 3 AT $!datum
        PIN 3 DIST $!cdim
        !dim = !cdim
      else
        PIN 3 AT $!datum
        PIN 3 DIST $!dim
      endif
    enddo

    !pin8pin9 = !!kStrReal('const dist pin 8 to pin 9')
    !pin8pin9dist = !pin8pin9
    if (!pin8pin9dist ne 0 ) then
      pin 3 dir from pin 9 to pin 8
    endif

  elseif (!method eq |DIMENSION|)then
    -----------------------------------------------------
    --<BC>Apr2005
    --Check to see if V1 exists and save the end and start directions for sloping decks
    !!ce = $!<name>-V1
    handle(2,109)
    elsehandle NONE
      if (!support.mirror) then
        !farend = 1
      else
        !farend = 0
      endif
      -- because we are building by dimension, we need to save the plane of the ends
      -- mdssaveends stores the end to trim !farend and the method used by mdsoverdim
      !saveV1 = object MDSSAVEENDS(!!ce,!datum,!farend)
      --  !v1SctnDrne = Drne wrt worl
      -- !v1SctnDrns = Drns wrt worl
    endhandle
    -- Initialise variables for dimension check
    !d1 = !!mdsFt40.dim1.val
    !d2 = !!mdsFt40.dim2.val
    !d3 = !!mdsFt40.dim3.val
    !d4 = !!mdsFt40.dim4.val

    -- Framework ft40 is a 'T' Post type Pipe Support.
    -- Only Dimension1 'D1' may be set to '0' ie. on CentreLine of Vertical Leg
    --      if (!d1.eq(0) or !d2.eq(0) or !d3.eq(0) or !d4.eq(0)) then
    --
    if (!d2.eq(0) or !d3.eq(0) or !d4.eq(0)) then
      !!alert.error('Not all of the dimensions have been completed.')
      !!kRestoreUnits(!currentUnits)
      return
    endif

    !!mdsCreateMess(true)

    -- Position pins
    !!ce = !datum
    -- Position pin 9 at bottom of the datum Pipe Ancillary
    pin 9 copy p9
    if (!support.rotateCur)then
      !tempPin9Dir = !p11Dir
      !tempPin8Dir = !p10Dir
    else
      !tempPin9Dir = !p10Dir
      !tempPin8Dir = !p11Dir
    endif

    PIN 9 DIR $!tempPin9Dir
    pin 1 at $!datum
    pin 1 dir $!tempPin9Dir
    --<tm.06/07/2005 10:55
    --    pin 1 dist $!d1
    pin 1 dist -$!d1
    PIN 8 COPY PIN9
    PIN 8 DIR $!tempPin8Dir
    PIN 9 plane PIN 9 THRO CE
    PIN 8 plane PIN 8 THRO CE
    pin 9 plane pin 9 thro pin 1
    pin 2 at p9 of $!datum
    pin 2 dir $!tempPin9Dir

    --------------------------------------------------------
    -- Check if pin 9 and pin 8 are at the same position.
    --------------------------------------------------------
    !pin8pin9 = !!kStrReal('const dist pin 8 to pin 9')
    !pin8pin9dist = !pin8pin9

    if (!pin8pin9dist le 0 ) then
      !samepos = true
      var !pin9pos pin 9 pos wrt worl
      var !pin8pos pin 8 pos wrt worl
      pin 9 dist -20
      pin 8 dist -10
      PIN 9 DIR FROM PIN 8 TO PIN 9
      PIN 8 DIR FROM PIN 9 TO PIN 8
      pin 9 at $!pin9pos wrt worl
      pin 8 at $!pin8pos wrt worl

    else
      !samepos = false
      PIN 9 DIR FROM PIN 8 TO PIN 9
      PIN 8 DIR FROM PIN 9 TO PIN 8

    endif

    --<tm>06/07/2005 14:03
    pin 9 dir $!tempPin8Dir
    --<tm>

    pin 9 dist $!d3
    pin 1 dir $!ddir
    pin 1 plane pin 1 thro p9 of $!datum
    pin 7 copy pin 1
    PIN 7 DIST $!d4
    PIN 7 DIR $!udir

    -----------------------------------------------------
    -----------------------------------------------------
    -- Position pin 4 on the datum atta side at the
    -- START of the HORIZ. SCTN ie. clear of the last atta
    -- on that side of the VERTICAL SCTN.

    !dim = 0
    --do !i values !atta
    do !iref values !atta
      --<k.pleschner>Jun06
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)

      PIN 4 COPY PIN 8
      PIN 4 AT $!datum
      --PIN 4 plane PIN 4 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 4 plane PIN 4 CLEAR $!i.oend BEH $!i
      else
        -- use distance from centreline
        PIN 4 plane PIN 4 THR $!i
        PIN 4 plane PIN 4 DIST $!i.oend
      endif
      handle (2,109) (2,107) $* Undefined Name or Reference
        break
      endhandle
      VAR !cdir CONST DIR P0 of $!datum TO PIN 4
      !cdim = !!kStrReal('CONST DIST P0 of $!datum TO PIN 4')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cdir.direction()
      !direction.directionB = !tempPin8Dir
      !direction.tolerance  = 0.05

      !dim = !d2

      if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 4 AT $!datum
        PIN 4 DIST $!dim
        --      endif
        --           unenhance $!bran
      else
        PIN 4 AT $!datum
        PIN 4 DIST $!dim
      endif
      --<<<-<wd>nov2002
    enddo

    if (not !samepos) then
      PIN 4 DIR FROM PIN 8 TO PIN 9
    endif

    -- Position pin 3 on the OPPOSITE side to the datum atta side at the
    -- END of the HORIZ. SCTN ie. clear of the last atta
    -- on that side of the VERTICAL SCTN.
    !cdir.delete()
    !cdim.delete()
    !dim = 0

    --do !i values !atta
    do !iref values !atta
      --<k.pleschner>Jun06
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)

      PIN 3 COPY PIN 9
      PIN 3 AT $!datum
      --PIN 3 plane PIN 3 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 3 plane PIN 3 CLEAR $!i.oend BEH $!i
      else
        -- use distance from centreline
        PIN 3 plane PIN 3 THR $!i
        PIN 3 plane PIN 3 DIST $!i.oend
      endif
      handle (2,109) (2,107) $* Undefined Name or Reference
        break
      endhandle
      VAR !cdir CONST DIR P0 of $!datum TO PIN 3
      !cdim = !!kStrReal('CONST DIST P0 of $!datum TO PIN 3')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cdir.direction()
      !direction.directionB = !tempPin9Dir
      !direction.tolerance  = 0.05

      !dim = (!d1 + !d3)
      -->>>-<wd>nov2002
      -- Code Commented out so the 'Confirm' CHECK is NOT DONE
      if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 3 AT $!datum
        PIN 3 DIST $!dim
        --             endif
        --           unenhance $!bran
        --        else
        PIN 3 AT $!datum
        PIN 3 DIST $!dim
      endif
      --<<<-<wd>nov2002
    enddo

    !pin8pin9 = !!kStrReal('const dist pin 8 to pin 9')
    !pin8pin9dist = !pin8pin9
    if (!pin8pin9dist ne 0 ) then
      pin 3 dir from pin 9 to pin 8
    endif

  elseif (!method eq |CLEARANCE|)then

    ------------ *** Connexion Warnings *** -------------
    !errorMessage = STRING()
    !dummyS       = ''
    if(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('UNJOINTED')) then
      -- nothing to do
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('WARNING')) then
      !continue = !!alert.confirm(!errorMessage)
      if(!continue.eq('NO')) then
        !!kRestoreUnits(!currentUnits)
        return
      endif
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('ERROR')) then
      !!alert.error(!errorMessage)
      !!kRestoreUnits(!currentUnits)
      return
    else
      -- leave in case
    endif
    ---------------------------------------------

    label /Element3

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify element to support from|
    ID $!iDType @
    handle (61,528)
      PROMPT ON
      !!ce = !stru
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    PROMPT DISMISS
    PROMPT ON
    !pick = !!ce
    !testCe = !!mdsRelToDatum(!datum, !pick, !ddir, !clearance.real())

    if (!testCe[1].upcase() eq 'UNSET')then
      !!alert.error('Identified element is unsuitable to support from.')
      golabel /Element3
    elseif (!testCe[1].upcase() eq '')then
      golabel /Element3
    endif

    if (!pADir eq U or !pLDir eq U)then
      if (!testCe[1].upcase() eq 'ABOVE')then
        !!alert.error('Identified element is behind pipe.')
        golabel /Element3
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is in line with the datum atta')
        golabel /Element3
      endif

    else
      if (!testCe[1].upcase() eq 'ABOVE')then
        !!alert.error('Identified element is above pipe.')
        golabel /Element3
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is at the same elevation as the datum atta')
        golabel /Element3
      endif
    endif

    -----------------------------------------------------

    --<wd>may2007<mds12>
    --    if (!pick.hardType eq 'PANE' or !pick.type eq 'BOX')then
    if (!pick.hardType eq 'PANE' or !pick.type eq 'BOX' or !pick.type eq 'HPLATE') then
      --<wd>may2007<mds12>

      !plane = !testCe[2]
      VAR !pDir CONST DIR $!plane
    endif

    -- Position Pins
    !!ce = !pick
    !!mdsCreateMess(true)

    -- Check to see if item picked is a bedplate, type 'FT22'.
    -----------------------------------------------------
    -----------------------------------------------------

    --<wd>may2007<mds12>
    --    if (!pick.hardType eq 'PANE' or !pick.type eq 'BOX')then
    if (!pick.hardType eq 'PANE' or !pick.type eq 'BOX' or !pick.type.eq('HPLATE')) then
      --      STRU
      --      !frameType = !!ce.:MDSSuppType
      STRU
      handle NONE
        !type = !!ce.:MDSSuppType
      elsehandle ANY
        !type = ''
      endhandle
      --<wd>may2007<mds12>

      -- Check to see if item picked is a bedplate, type 'FT22'.
      if (!type eq 'FT22')then
        !bedplate = true
        --xx          PIN 1 AT $!pick
        pin 1 copy p9 of $!datum
        PIN 1 DIR $!pDir
        VAR !tempInter CONS POS INT PIN 1 $!plane
        !inter = !tempInter.position()
        pin 1 plane pin 1 thro $!inter

      else
        -- Position pins clear of attas
        -- if type is panel or box
        -- -----------------------------------------------------
        PIN 1 AT P0 of $!datum
        PIN 1 DIR $!p10Dir
        PIN 2 COPY PIN 1

        !dim = 0
        --do !i values !support.atta
        do !iref values !support.atta
          --<k.pleschner>Jun06
          -- avoid SREF atta
          skip if !iref.name.substring(-1,-5).eq('/SREF')
          !i = object MDSANCGEOMDFLTS(!iref)

          --PIN 2 plane PIN 2 CLEAR $!clearance BEH $!i
          if !i.clge.eq('GEOM') then
            -- use clearance from geometry
            PIN 2 plane PIN 2 CLEAR $!i.oend BEH $!i
          else
            -- use distance from centreline
            PIN 2 plane PIN 2 THR $!i
            PIN 2 plane PIN 2 DIST $!i.oend
          endif
          handle (2,109)
            break
          endhandle
          VAR !cdir CONST DIR PIN 1 TO PIN 2
          !cdim = !!kStrReal('CONST DIST PIN 1 TO PIN 2')

          -- Set object definition
          !direction = object KEQUALDIR()
          !direction.directionA = !cdir.direction()
          !direction.directionB = !p10Dir
          !direction.tolerance  = 0.05

          if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
            PIN 2 AT $!datum
            PIN 2 DIST $!cdim
            !dim = !cdim
          else
            PIN 2 AT $!datum
            PIN 2 DIST $!dim
          endif
        enddo

        --xx          PIN 1 COPY PIN 2

        PIN 1 DIR $!ddir
        VAR !tempInter CONS POS INT PIN 1 $!plane
        !inter = !tempInter.position()
        pin 1 copy p9 of $!datum
        pin 1 plane pin 1 thro $!inter
        --
        --xx        PIN 1 AT $!pick
        --xx        PIN 1 DIR $!pDir
        --xx        VAR !tempInter CONS POS INT PIN 1 $!plane
        --xx        !inter = !tempInter.position()

      endif

      -- end of PANEL/BOX(not FT22 bedplate) - 'CLEARANCE'
      -----------------------------------------------------
      -----------------------------------------------------
      -- In CLEARANCE and id SCTN mode -vvv----zzzzs------
      -----------------------------------------------------

      --      if (!pick.type eq 'SCTN')then
      --<wd>may2007<mds12>
      --    elseif (!pick.type eq 'SCTN') or (!pick.hardType eq 'GENSEC') then
    elseif (!pick.type eq 'SCTN') or (!pick.hardType eq 'GENSEC') or !pick.hardType.eq('HSTIFF') then
      --<wd>may2007<mds12>

      !start = plstart NA wrt world
      !end   = plend NA wrt world
      var !lineA CONS line JOIN $!start to $!end
      var !lineB CONS line P10 of $!datum
      var !lineC CONS line PAR $!lineB THROUGH P9 of $!datum
      var !tempInter CONS POS INT $!lineA $!lineC
      !inter = !tempInter.position()

      -------------------------------------------------
      --<wd>dec2004
      -- Get the Directions of the Constructed Lines and Check if they are Parallel within a Tolerance Anlge of (+/-) 5 degrees
      -- Set KEQUALDIR object definition
      !dira = !lineA.after('line ').before( 'through').direction()
      !dirb = !lineB.after('line ').before( 'through').direction()
      !checkdir = object KEQUALDIR()
      !checkdir.directionA = !dira
      !checkdir.directionB = !dirb
      !checkdir.tolerance  = 45

      -- Only DO this if the variable "!inter" has been "set".
      if (!inter.set())then

        -- Check if directions are Parallel within a Tolerance Anlge of (+/-) 5 degrees
        if (!!mdsdirequaldir(!checkdir)) then
          -- When BELOW 45 degrees = TRUE so set the "!inter" variable to "unset" which will automatically
          -- FORCE the intersection point, i.e. !inter to be on th DATUM atta centreline along the P9 direction of the DATUM atta,
          -- which is where the centreline of the SCTN POST should be when creating by the CLEARANCE mode.

          !inter = object POSITION()
          -- This however may require the "vertical" SCTN Post to be CONNECTED via
          -- the Create Connections icon to achieve the correct geometry for connecting to the SCTN

        else
          -- 45 and Over 45 degrees out of parallel to the P10 direction of the DATUM atta

          -- Leave !inter as calculated and allow user to continue.
          -- This however may give unsatisfactory framework geometry, i.e. the "vertical" SCTN Post
          -- will need to be CONNECTED via the Create Connections icon to achieve the desirable geometry

        endif
      endif
      --<wd>dec2004
      -------------------------------------------------

      if (!inter.unset())then
        var !lineB CONS line P9 of $!datum
        var !tempInter CONS POS INT $!lineA $!lineB
        !inter = !tempInter.position()
      endif

      PIN 1 AT $!inter
      PIN 1 DIR $!ddir
      PIN 1 plane PIN 1 THRO P9 OF $!datum
      VAR !pin1Pos PIN 1 POS WRT WORLD
      ---------------------------------------------------
      !inter = !!kFlangeOrWeb(!pick, !pin1Pos.position(), !ddir)
      pin 1 at $!inter
      pin 1 copy p9 of $!datum
      pin1 plane pin 1 thro $!inter

      --xx      else

      --xx        PIN 1 AT $!pick
      --xx        PIN 1 DIR $!pDir
      --xx        VAR !tempInter CONS POS INT PIN 1 $!plane
      --xx        !inter = !tempInter.position()

      -- ************************ Connexions ***********************
      !support.connections[1] = !pick
      -- !!mdsFt40.lineUp.active = True
      --------------this bit will stop clearance being used if support is not under picked sctn-----------------------
      if(!haveJoints) then
        !connected = !!mdsGetBeamConn(!support,!attributes[1][8].dbref())
        if(!connected.unset()) then
          !!alert.error('Support is not positioned correctly through the new joints. Position "Through", before continuing.')
          !!ce = !refe
          return
        endif
      endif
      ---------------take it out and it will create joints however far apart the support and steel is------------
      -------------------------------------------------------------
    endif
    -----------------------------------------------------
    -- end of SCTN by CLEARANCE option

    --
    -----------------------------------------------------
    -- COMMON Pin placements for CLEARANCE Only shown below
    -----------------------------------------------------

    --xx      !tempPin8Dir.delete()
    --xx      !tempPin9Dir.delete()
    --------------------------------------------------------
    -- Check for framework orientation
    if (!support.rotateCur)then
      !toVert   = !p11Dir
      !fromVert = !p10Dir
    else
      !toVert   = !p10Dir
      !fromVert = !p11Dir
    endif
    --------------------------------------------------------
    -- Pin 9  at intersection position of nearest pline of picked sctn
    --      PIN 9 AT $!inter
    pin 9 copy pin 1
    PIN 9 DIR $!ddir

    -- Test position of pin 1 relative to datum to determine orientation
    PIN 1 copy P10 of $!datum
    PIN 1 plane PIN 1 thro PIN 9
    var !testDir CONS DIR P10 of $!datum to PIN 1

    -- Set object definition
    !direction = object KEQUALDIR()
    !direction.directionA = !testDir.direction()
    !direction.directionB = !p10Dir
    !direction.tolerance  = 0.05

    -----------------------------------------------------
    --<wd>dec2004 -- Only Check on Vertical Pipes
    if (!pLDir.up.abs().eq(1)) then
      -----------------------------------------------------
      -- Check directions
      if (!!kDirEqualDir(!direction)) then
        !support.rotateCur = False
        -- Vertical leg on p10 side of datum atta
      else
        !support.rotateCur = True
        -- Vertical leg on p11 side of datum atta
      endif
      -----------------------------------------------------
    endif
    --<wd>dec2004
    -----------------------------------------------------

    PIN 7 AT P0 OF $!datum
    PIN 7 DIR $!toVert
    PIN 7 plane PIN 7 THRO PIN 9
    PIN 7 DIR $!udir
    PIN 7 plane PIN 7 THRO PIN 9
    PIN 9 COPY PIN 7
    PIN 9 plane PIN 9 THRO P9 OF $!datum
    PIN 9 DIR $!toVert
    PIN 8 COPY PIN9
    PIN 8 plane PIN 8 THRO P9 OF $!datum
    !pin8pin9 = !!kStrReal('const dist pin 8 to pin 9')
    !pin8pin9dist = !pin8pin9

    if (!pin8pin9dist le 0 ) then
      !samepos = true
      var !pin9pos pin 9 pos wrt worl
      var !pin8pos pin 8 pos wrt worl
      pin 9 dist -20
      pin 8 dist -10

      PIN 9 DIR FROM PIN 8 TO PIN 9
      PIN 8 DIR FROM PIN 9 TO PIN 8

      pin 9 at $!pin9pos wrt worl
      pin 8 at $!pin8pos wrt worl
    else
      !samepos = false
      PIN 9 DIR FROM PIN 8 TO PIN 9
      PIN 8 DIR FROM PIN 9 TO PIN 8
    endif

    VAR !tempPin8Dir PIN8 DIR
    var !tempPin9Dir PIN9 DIR

    -- Do loop checks ATTAS on first Horiz. SCTN ( Only One for ft40 frametype )
    -----------------------------------------------------------------------------
    -- Position pin 4 on the datum atta side at the
    -- START of the HORIZ. SCTN ie. clear of the last atta
    -- on that side of the VERTICAL SCTN.
    !dim = 0
    --do !i values !atta
    do !iref values !atta
      --<k.pleschner>Jun06
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)

      PIN 4 COPY PIN 8
      PIN 4 AT $!datum
      --PIN 4 plane PIN 4 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 4 plane PIN 4 CLEAR $!i.oend BEH $!i
      else
        -- use distance from centreline
        PIN 4 plane PIN 4 THR $!i
        PIN 4 plane PIN 4 DIST $!i.oend
      endif
      handle (2,109) (2,107) $* Undefined Name or Reference
        break
      endhandle
      VAR !cdir CONST DIR P0 of $!datum TO PIN 4
      !cdim = !!kStrReal('CONST DIST P0 of $!datum TO PIN 4')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cdir.direction()
      !direction.directionB = !tempPin8Dir.direction()
      !direction.tolerance  = 0.05

      if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 4 AT $!datum
        PIN 4 DIST $!cdim
        !dim = !cdim
      else
        PIN 4 AT $!datum
        PIN 4 DIST $!dim
      endif
    enddo

    if (not !samepos) then
      PIN 4 DIR FROM PIN 8 TO PIN 9
    endif

    -- Position pin 3 on the OPPOSITE side to the datum atta side at the
    -- END of the HORIZ. SCTN ie. clear of the last atta
    -- on that side of the VERTICAL SCTN.
    !cdir.delete()
    !cdim.delete()
    !dim = 0

    --do !i values !atta
    do !iref values !atta
      --<k.pleschner>Jun06
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)

      PIN 3 COPY PIN 9
      PIN 3 AT $!datum
      --PIN 3 plane PIN 3 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 3 plane PIN 3 CLEAR $!i.oend BEH $!i
      else
        -- use distance from centreline
        PIN 3 plane PIN 3 THR $!i
        PIN 3 plane PIN 3 DIST $!i.oend
      endif
      handle (2,109) (2,107) $* Undefined Name or Reference
        break
      endhandle
      VAR !cdir CONST DIR P0 of $!datum TO PIN 3
      !cdim = !!kStrReal('CONST DIST P0 of $!datum TO PIN 3')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cdir.direction()
      !direction.directionB = !tempPin9Dir.direction()
      !direction.tolerance  = 0.05

      if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 3 AT $!datum
        PIN 3 DIST $!cdim
        !dim = !cdim
      else
        PIN 3 AT $!datum
        PIN 3 DIST $!dim
      endif
    enddo

    !pin8pin9 = !!kStrReal('const dist pin 8 to pin 9')
    !pin8pin9dist = !pin8pin9
    if (!pin8pin9dist ne 0 ) then
      pin 3 dir from pin 9 to pin 8
    endif
    pin 9 plane pin 9 thro pin 3

    -----------------------------------------------------
    -- COMMON Pin placements for CLEARANCE Only shown ABOVE
    -----------------------------------------------------

    --<wd>jun2007<mds12>
    -- Save !pick and for Associations
    !mdsassoc.pick1 = !pick
    --<wd>jun2007<mds12>

  endif

  -----------------------------------------------------
  -----------------------------------------------------
  -- END of if (|CURSOR|/|DIMENSION|/|CLEARANCE|) block --
  -----------------------------------------------------
  -----------------------------------------------------

  -- Create and ARRAY of Attas with Packing Pieces (PDMS Names ONLY)
  -- and the Type and Size of the Packing Pieces to Recreate
  !attapp = !!mdspackers(!support)

  -- Pins now in position create framework
  !!ce = !stru
  --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
  !!mdsRemoveAutoPadRules(!stru)
  --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end
  delete STRU MEM
  handle (41,66) (2,113) (2,113)
  endhandle

  !mdstemp = /MDS/FT40/$!selection
  :mdscheck $!mdstemp.:mdscheck
  :mdsframirror $!mdstemp.:mdsframirror
  AT $!datum

  NEW FRMW $!name/MAIN
  !frmwSupport = !!ce

  -- Copy required template/s
  !!ce = /MDS/FT40/$!selection

  -- <k.pleschner>nov06
  -- check for existence of !mdsTmplOri
  if undefined(!mdsTmplOri) then
    !mdsTmplOri = !stru.:Mdstmplori
  endif
  -- check orientation
  if !mdsTmplOri.eq(3) then
    !mdsTmplOri = 1
  elseif !mdsTmplOri.eq(4) then
    !mdsTmplOri = 2
  endif
  !orientedTmpl = false
  -- then try to select an "oriented" alternative of template
  if !mdsTmplOri.boolean() then
    !!ce = /MDS/FT40/$!selection/$!mdsTmplOri
    handle NONE
      !orientedTmpl = true
    elsehandle ANY
    endhandle
  endif


  --!subs = !!kCollectAllFor('SUBS', '', !!ce)
  !frmw = !!kCollectAllFor('FRMW', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')

  -- Navigate back to support and create template elements
  !!ce = !frmwSupport
  COPY ATTRIB OF $!frmw[1]
  COPY MEM OF $!frmw[1] RENAME $!frameFormat $!name

  --    copy /MDS/FT40/$!selection-FRMW1 rename $!frameFormat $!name

  --<wd>nov2002
$(
  do !i indices !subs
    NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
    --      new subs $!name/SUBS$!i COPY $!subs[$!i] rename $!frameFormat $!name
    COPY MEM OF $!subs[$!i] RENAME $!frameFormat $!name
  enddo
$)
  --<wd>nov2002

  -----------------------------------------------------
  -- Move Stru origin to position 'P9' of support
  -----------------------------------------------------
  !!ce = !stru

  -- Set stru description for template recognition
  !desc = desc of /MDS/FT40/$!selection
  !mdsBars = :mdsbars of /MDS/FT40/$!selection
  desc '$!desc'
  :mdsbars $!mdsBars

  -- <k.pleschner>oct06 Set stru :mdstmplori
  if !method.eq('CURSOR') then
    !!ce.:mdstmplori = !mdsTmplOri
  endif

  MOVE $!ddir THRO P9 OF $!datum
  --!strupos = pos wrt /*



  -- Orientate MDS Structure
  ori x is $!orix and z is $!oriz

  --!orix = !p11Dir
  --!oriz = !udir
  --ORI X IS $!orix AND Z IS $!oriz
  --<wd>dec2004
  ----------------------------------------------

  -- If the flange gap toggle is switched on then adjust the positions
  if !method.eq('CURSOR') then
    -- The form is obviously this FORM, !pick1 is the first picked element
    -- !pick2 is the second picked element, !vertLeg is a logical to see if
    -- we have moved the pins onto the correct size or not
    !!mdsGapFlange(!form,!pick,!pick,TRUE)
  endif

  -----------------------------------------------------------
  -- This code ensures TOS of horiz. sctn is at EXACTLY the same
  -- ELEVATION as the owning STRUCTURE for this FRAMEwork type.
  -----------------------------------------------------------
  !!ce = $!<name>-BAR-1
  -- move u thro U$!strupos.up wrt /*
  -- move ppline TOS start d thro U$!strupos.up wrt /*

  --<wd>dec2004
  --move D wrt /* clear 0 beh p9 of $!datum
  move $!directions[3] clear 0 beh p9 of $!datum
  --<wd>dec2004

  !drns = drns wrt /*
  !drne = drne wrt /*
  !!ce = !stru

  -----------------------------------------------------------
  -- This code ensures TOS of horiz. sctn is at EXACTLY the same
  -- ELEVATION as the owning STRUCTURE for this FRAMEwork type.
  -----------------------------------------------------------

  -- Derive amount of overlap from template
  -----------------------------------------------------
  -----------------------------------------------------
  -- For ft40 the overlap is fixed by the despar stored in the template
  -- The overlap is half of the despar value stored in the template
  -- section /MDS/FT40/1-BAR-1.

  !!ce     = /MDS/FT40/1-BAR-1
  !current = !!ce
  !overlap = ( !current.desp.first() / 2 )

  -- Set dimensions
  -----------------------------------------------------
  -----------------------------------------------------
  -- Extend and move Vertical leg
  !!ce = $!<name>-V1
  extend start thro pin 7
  -- extend end infront $!<name>-BAR-1

  VAR !dIR PIN 9 DIR WRT WORLD
  --<tm> lucky guess changed the following line from pin 9 to pin 7 to fix building by dimension problem
  MOVE $!dIR WRT WORLD THRO PIN 7
  --<tm>01/06/2005 14:01

  ----------------------- ****** connexions ******* --------------------
  if(!support.connections.unset()) then
    -- dimensions are being used first
    :MDSConn default
  else
    !vertical1 = !!ce
    !connected = !!mdsGetBeamConn(!support,!vertical1)
    :MDSConn $!connected
    handle ANY
    endhandle
  endif
  ---------------------------********************-----------------------

  -- Extend and move bar 1
  !!ce = $!<name>-BAR-1

  --<wd>dec2004 --vvv-- Code below commented out!!! --vvv-
  !tempOverlap = :MdsOlap
  if !tempOverlap eq 'OVERLAP' then
    !overlap = :MDSONUM
    if (!method eq |DIMENSION|) then
      if (!support.mirror)then
        !sctnEnd = 'END'
      else
        !sctnEnd = 'START'
      endif
      -- pin 4 dir from pin 4 to pin 3
      -- pin 4 plane pin 4 dist (($!clearance - ($!overlap) / 2))
      pin 3 plane pin 3 dist ($!overlap - $!clearance)
      --    else
      --      pin 4 plane pin 4 dist ($!overlap - $!clearance)
      --      pin 3 plane pin 3 dist ($!overlap - $!clearance)
    endif
  endif



  --<wd>dec2004 -- Code below --vvv-- added dec2004
  if (!method eq |CURSOR| or !method eq |CLEARANCE|) then
    var !pin3dir cons dir pin 1 to pin 3
    var !pin4dir cons dir pin 1 to pin 4
    var !pin3spos pin 3 pos wrt /*
    var !pin1spos pin 1 pos wrt /*

    --<wd>nov2004
    -- Set up Equal Direction Object definition to do the test,
    -- because FT40 not building when the pin 3 & 4 directions differ by 0.1 degrees
    !pindirections = object KEQUALDIR()
    !pindirections.directionA = !pin3dir.direction()
    !pindirections.directionB = !pin4dir.direction()
    !pindirections.tolerance  = 0.05

    -- Set Equal Position Object definition to do the test
    !pinpositions = object MDSEQUALPOS()
    !pinpositions.positiona = !pin3spos.position()
    !pinpositions.positionb = !pin1spos.position()
    !pinpositions.tolerance = 100

    if (!method eq |CURSOR|) then
      --        if (|$!pin3dir| eq |$!pin4dir|)then
      if (!!kDirEqualDir(!pindirections)) then
        --<wd>nov2004
        PIN 9 plane PIN 9 distance $!overlap from $!name-V1

        --<wd>nov2004
        --elseif (|$!pin3spos| eq |$!pin1spos|)then
      elseif (!!mdsposequalpos(!pinpositions)) then
        --<wd>nov2004
        PIN 9 plane PIN 9 distance $!overlap from $!name-V1

      else
        pin 9 plane pin9 thro pin 3
      endif
    else
      pin 9 plane pin 9 thro pin 3
    endif
    --    elseif (!method eq |CLEARANCE|) then
    --      pin 9 plane pin9 clear $!clearance BEH $!datum
  endif
  --<wd>dec2004 -- Code above --^^^-- added dec2004


  if (!method eq |DIMENSION|)then
    PIN 7 plane PIN 7 CLEAR 0 BEH $!name-BAR-1
    PIN 7 DIR D WRT WORLD
    --      PIN 7 DIST $!d2
    PIN 7 DIR U WRT WORLD
    !!ce = $!<name>-V1
    -- EXTEND END THRO PIN7
    SAME
    -- go back to BAR-1 to position pin 9
    !dim3 = !!mdsFt40.dim3.val
    --<tm>06/07/2005 14:07
    pin 9 dir $!tempPin8Dir
    PIN 9 plane PIN 9 distance $!dim3 from $!name-V1
    pin 4 at $!datum
    pin 4 direction $!tempPin9Dir
    pin 4 plane pin4 distance $!d2 from $!datum
  endif

  --$P========================================
  --$P $!support.rotateCur
  --$P----------------------
  if (!support.rotateCur)then
    EXTEND END THRO PIN 4 $* 9
    handle (73,214) $* Structural geometry error - Zero length section
      extend 1mm
      EXTEND END THRO PIN 4 $* 9
    endhandle
    EXTEND START THRO PIN 9 $* 4
    handle (73,214) $* Structural geometry error - Zero length section
      extend 1mm
      EXTEND START THRO PIN 9 $* 4
    endhandle
  else
    EXTEND END THRO PIN 9
    handle (73,214) $* Structural geometry error - Zero length section
      extend 1mm
      EXTEND END THRO PIN 9
    endhandle
    EXTEND START THRO PIN 4
    handle (73,214) $* Structural geometry error - Zero length section
      extend 1mm
      EXTEND START THRO PIN 4
    endhandle
  endif

  --<kp>nov06 correct wrong orientation of bar in case of "oriented" template
  if !orientedTmpl then
    if !!ce.plori.nAL.zdir().wrt(stru).eq(n wrt stru) then
      flip
    endif
  endif
  --<kp>nov06

  -----------------------------------------------------
  -----------------------------------------------------
  $!name/SUBS1
  handle none
    MOVE $!dIR WRT WORLD THRO $!<name>-V1
  elsehandle any
  endhandle

  -- Set dimensions for CURSOR or CLEARANCE Only!!!
  if ((!method eq |CURSOR|) or (!method eq |CLEARANCE|))then
    --<tm>07/07/2005 09:29
    -- fix to rectify dimension problem on non orthogonal supports
    pin 7 plane pin 7 through pin9
    -----------------------------------------------------
    -- Dimension 1
    !dim1 = !!kStrReal('const dist pin 7 to PLANE pin 1')

    !!mdsFt40.dim1.val = !dim1
    -----------------------------------------------------
    -- Dimension 2
    PIN 2 COPY PIN 9
    PIN 2 plane PIN 2 THRO $!datum
    !dim2 = !!kStrReal('CONST DIST PIN 2 TO plane PIN 4')
    !!mdsFt40.dim2.val = !dim2
    -----------------------------------------------------
    -- Dimension 3
    --      if (!method eq |CURSOR|) then
    -------------------------------------------------------
    -- For CURSOR modes supporting on <SCTN>-<FT22 BEDPLATE>
    pin 3 plane pin 3 thro pin 9
    !dim3 = !!kStrReal('CONST DIST PIN 7 TO plane PIN 9')
    !!mdsFt40.dim3.val = !dim3


    -- Dimension 4
    !dim4 = !!kStrReal('const dist p9 of $!datum to plane pin 7')
    !!mdsFt40.dim4.val = !dim4
  endif

  -- Select correct spref
  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  SEL SPREF WITH STYP 'FT40-$!selection' SPEC /MDF
  !!mdsSetSuppCode('MODIFY',!name,'FT40','FT40-1')

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)
  !!mdsDacControl(TRUE)
  !!ce = !stru

  -- Check to see if support is mirrored
  if (!support.mirror) then
    call !!mdsmirrorft40()
    !support.mirror = true
  endif

  -- Associate attas to bar
  !list = !support.bars[1]
  !references = ''
  do !i indices !list
    !references = !references & ' ' & !list[!i].string()
  enddo
  -----------------------------------------------------
  -----------------------------------------------------
  -- Set atta references to datum cross bar
  !!ce = $!<name>-BAR-1
  :MDSAttaRef $!references
  !support.barLen[1] = deri length of CE

  -- Adjust for SLOPING HORIZONTAL lines ONLY
  if (!pADir neq U and !pLDir neq U)then
    -- Check to see if the line is sloping
    !adjust = 0
    do !v values !atta
      !!ce = !v
      --<wd>nov2004
      skip if !!ce.name.match('/SREF').gt(0)
      --<wd>nov2004
      skip if !!ce.:mdsrotdir.east.set()
      !grad = pl grad

      if (!grad.neq(0))then
        --<wd>nov2004
        if (!!ce.pDir[9].wrt(/* ).east.abs().eq(1)) then
          !vHeight = 0
        elseif (!!ce.pDir[9].wrt(/* ).up.eq(0)) then
          !vHeight = 0
        else
          --<wd>nov2004

          !strucElement = ARRAY()
          !ref = $!name-BAR-1
          !strucElement.append(!ref)
          !vHeight = !!mdsAdjustSlope(!strucElement, !v)

          --<wd>oct2004
        endif
        --<wd>oct2004

      else
        !vHeight = 0
      endif
      if (!vHeight.gt(!adjust))then
        !adjust = !vHeight
      endif
    enddo

    -- Adjust required elements
    !!ce = $!<name>-BAR-1
    MOVE D WRT WORLD DIST $!adjust

    !!ce = $!<name>/SUBS1
    handle none
      MOVE D WRT WORLD DIST $!adjust
    elsehandle any
    endhandle
    -----------------------------------------------------
    -----------------------------------------------------
    !!ce = $!<name>-V1
    !end   = Posend wrt world
    !start = Posstart wrt world
    if (!support.mirror) then
      pin 8 at $!start
      pin 6 at $!end
    else
      pin 6 at $!start
      pin 8 at $!end
    endif
    PIN 6 DIR TO PIN 8
    !toBar = 0
    -----------------------------------------------------
    -----------------------------------------------------
    do !indx indices !support.bars
      PIN 8 COPY PIN 6
      PIN 8 plane PIN 8 THRO $!<name>-BAR-$!indx
      !toBar1 = !!kStrReal('CONST DIST PIN 6 TO PIN 8')
      if (!toBar1.gt(!toBar))then
        !toBar = !toBar1
        !index = !indx
      endif
    enddo

    PIN 8 plane PIN 8 CLEAR 0 INF $!<name>-BAR-$!index

    -----------------------------------------------------
    -----------------------------------------------------
    -- Extend vertical leg to account for the required adjustment
    if (!method eq |DIMENSION|)then
      PIN 6 plane PIN 6 DIST -$!adjust
      if (!support.mirror) then
        extend end thro pin 6
      else
        extend start thro pin 6
      endif
      --xxx        EXTEND START THRO PIN 6
    endif

    -----------------------------------------------------
    -----------------------------------------------------
    -- Adjust Dimension 4 to account for the lowest SLOPING line
    -- Dimension 4 for CURSOR on <SCTN> <FT22 BEDPLATE> <PANEL>

    pin 7 copy pin 6
    pin 7 dir $!udir
    pin 7 plane pin 7 clear 0 beh $!<name>-BAR-$!index
    !dim4 = !!kStrReal('const dist pin 7 to plane pin 6 ')
    !!mdsFt40.dim4.val = !dim4

    -- Store dimensions in design parameters in mm only
    -- at the ATTA $!<name>/SREF
    -----------------------------------------------------
    -----------------------------------------------------
    !!ce = $!<name>/SREF
  endif

  -- Despar 5 will store the maximum bore size on the support
  !srefName = !!mdsFt40.support.stru.name + '/SREF'
  !!ce = !srefName.dbref()
  !largestBore = object BORE()
  !largestBore = !form.support.datum.abore
  do !loop values !!mdsFt40.support.atta
    !largestBore = !loop.abore
    if !loop.abore.gt(!largestBore) then
      !largestBore = !loop.abore
    endif
  enddo

  -- Only set the largest bore is greater than the bore already stored
  !isNow = despara 5
  if !largestBore.real().lt(!isNow[1]) then
    !largestBore = !isNow[1].bore()
  endif

  !!mdsDacControl(true)
  DESPAR $!!mdsFt40.dim1.val  $!!mdsFt40.dim2.val  $!!mdsFt40.dim3.val  $!!mdsFt40.dim4.val   $!largestBore

  ------------------------------------------------------------------------------------------------------
  --<wd>nov2003>>>
  !!mdsDacControl(true)
  -- Check if ATTAS Created on The Support are Within the Allowable Bores for the STRUCTURE SCTN SIZES.
  !cecomp = !!ce
  !error  = STRING()
  if (!!mdscheckbores(!form,!selection,!error,!currentUnits)) then
    !!alert.error(!error)
    !!ce = !stru
    --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
    !!mdsRemoveAutoPadRules(!stru)
    --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end
    delete STRU MEM
    handle (41,66) (2,113) (2,113)
    endhandle
    -- Reset SREF Despars to ZERO as the STRU MEM have been DELETED
    !!ce = $!<name>/SREF
    handle none
      -- Only RESET the DESPARS for the DIMENSION GADGETS -
      -- DESPAR num 5 stores the LARGEST PIPE BORE SIZE on the SUPPORT and is still VALID
      desp num 1 0mm
      desp num 2 0mm
      desp num 3 0mm
      desp num 4 0mm
    elsehandle any
    endhandle
    -- Reset all pins associated with this support
    !!mdsResetPins(1,9)
    !!ce = !cecomp
    handle any
    endhandle
    !!mdsCreateMess(false)
    !!kRestoreUnits(!currentUnits)
    return
  endif
  --<wd>nov2003<<<
  ------------------------------------------------------------------------------------------------------

  !!mdsDacControl(false)

  -- Reset materials of sections
  !!mdsResetMat(!storeMat)

  ---------------------------------------------------------------------
  !!ce = !stru
  -- Check to see if the support attas have been offset
  if (!support.offset ne 'MID')then
    call !!mdsslideft40('$!support.offset')
  endif

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  -- Set 'FT25' form Support Object to be the same as 'ft40' form Support Object
  !!mdsFt25.support = !support

  -- Clear packs from 'BOTH forms' Support Objects as the SCTNs have already been deleted
  -- During the Framework Creation above
  !!mdsFt25.support.packs.clear()
  !support.packs.clear()

  -- Create Required Packing Pieces(SCTNs) at the Necessary Attas
  call !!mdscrpacksft25(!attapp, !!mdsFt40)

  -- Update 'ft40' support.packs data to that held in form 'FT25'
  !support.packs = !!mdsFt25.support.packs

  -- Navigate to Main Structure of Framework
  !!ce = !stru

  ----------------------***** connexions *****--------------------------
  if(!haveJoints) then
    do !index indices !joints
      -- if support cursor picking is too unlike the existing then the connections will fail
      -- if(!joints[!index].badref()) then
      --  !!alert.error('Reconnection is not possible, connections will be deleted.')
      --!!mdsSelectJoints(!form,'DISCONNECT','')
      --!support.joints.clear()
      --  break
      --endif
      if(!joints[!index].badref().not() and !attributes[!index][8].dbref().:MDSConn.eq(!joints[!index].owner.owner)) then
        !mainStl = !attributes[!index][8].dbref().:MDSConn
        !support.joints[!index] =  !!mdsCreateJoint(!mainStl, !attributes[!index][8].dbref(),!joints[!index],!attributes[!index])
      else
        !dummy = object DBREF()
        !dummyA = ARRAY()
        !mainStl = !support.connections[!index]
        !support.joints[!index] =  !!mdsCreateJoint(!mainStl, !attributes[!index][8].dbref(),!dummy,!dummyA)
      endif
    enddo
  endif
  ----------------------------------------------------------------------

  -- If a joint is being used and it is handed then their will be a alternative spref of the
  -- opposite hand joint and the bang to set separated by a ,
  !!mdsSwapIntJoi(!support.stru,!support.mirror,!support.alias)

  -- Move plates
  $!name-BAR-1
  -- flip

  $!name/SUBS1
  handle none
    if !support.mirror then
      move $!drne thro poss of $!name-BAR-1
      move $!drne dist 16mm
    else
      move $!drns thro poss of $!name-BAR-1
      move $!drns dist 16mm
    endif
  elsehandle any
  endhandle

  $!name/SUBS2
  handle none
    if !support.mirror then
      move $!drns thro pose of $!name-BAR-1
      move $!drns dist 16mm
    else
      move $!drne thro pose of $!name-BAR-1
      move $!drne dist 16mm
    endif
  elsehandle any
  endhandle


  -->>>-<wd>nov2002
  -- This EXTRA Check has been put in at the bottom of this FILE so as to CHECK a MDS FT40 Support
  -- created by CLEARANCE or CURSOR on the FIRST occasion after initialisation of the form
  -- when the Form Dimensions are set to '0'<zero>
  --
  -- Check if ATTAS Created on The Support are Within the Allowable Bores for the STRUCTURE SCTN SIZES.
  !cecomp = !!ce
  !error  = STRING()
  if (!!mdscheckbores(!form,!selection,!error,!currentUnits)) then
    !!alert.error(!error)
    !!ce = !stru
    --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
    !!mdsRemoveAutoPadRules(!stru)
    --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end
    delete STRU MEM
    handle (41,66) (2,113) (2,113)
    endhandle
    !!ce = !cecomp
    handle any
    endhandle
  endif
  --<<<-<wd>nov2002

  if defined(!saveV1) then
    !saveV1.restoreplane(!!mdsFt40.dim4.val ,0)
  endif

  -- Navigate to Main Structure of Framework
  !!ce = !stru
  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.append(!!ce)
  !colourList.appendarray(!support.atta)
  !colourList.appendarray(!support.joints)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- Reset all pins associated with this support
  call !!mdsResetPins(1,9)

  -- reset :mdsancref attributes if set
  !support.plateconns.restoreconns()

  -- Update support data held in form
  !!mdsFt40.support = !support

  !!ce = !support.stru
  -- Copy weld locally
  !copyWelds = object MDSWELDLIST(!!ce,!form)
  !!ce = !support.stru

  !!mdsCreateMess(false)
  -- Code for sloping decks
  if defined(!testCe[3]) then
    !!mdstrimplane($!name-V1 ,!support.mirror, !testCe[2],'start')
    -- we have trimmed the length of the vertical section to suit the panel
    -- now we need to reset the dimension
    !!mdsFt40.dim4.val = !!mdsgetoverdim($!datum , $!name-V1 ,0)
  else
    if !method neq |DIMENSION| then

      --<wd>may2007<mds12>
      --       if !pick.hardType.eq('SCTN') or !pick.hardType.eq('GENSEC') then
      if !pick.hardType.eq('SCTN') or !pick.hardType.eq('GENSEC') or !pick.hardType.eq('HSTIFF') then
        --<wd>may2007<mds12>

        !x = object MDSPLINES(!pick,$!name-V1 ,TRUE )
      endif
      !!mdsFt40.dim4.val = !!mdsgetoverdim($!datum , $!name-V1 ,0)
    endif
  endif
  -- Store dimensions in design parameters
  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  desp num 4 $!!mdsFt40.dim4.val
  !!mdsDacControl(false)

  --<kp>mar07 Handle snipes
  !!mdsSnipe(!support.stru)

  ---------------------------------------------------------------------------------------------------
  --<wd>aug2007<mds12>
  -- Update the MDSSCTN and MDSFITTING Objects to the latest DATA in the MDSSUPPORT object member .mdssctns,
  -- i.e. !form.support.mdsctns, where any MDS SNIPES(FITTINGS) exist on the MDS SUPPORT SCTNS where the GTYP of CATREF is 'ANG'
  -- and the MDS SNIPE/FITTING element PURPOSE attribute is set to 'XGUI'
  --
  -- ALL OTHER MDS SNIPES are generated automatically or from the MDS TEMPLATE during the MDS STRUCTURE creation/modification.
  -- ** NOTE ** The SNIPE UPDATE applies to ALL METHODS(!method) of Creation,
  -- i.e. 'CREATE by CURSOR/DIMENSION/CLEARANCE and RESIZING of the MDS TEMPLATE
  !!mdsrestoresnipe(!form, 'DIMENSION')

  -- REGENERATE the DATA stored in the FORM MDSSUPPORT object member "!form.support.mdssctns"
  -- for ALL of the MDS Support SCTNS and ALL the associated MDS SNIPE(FITTING) members
  !!mdssupportsctns(!form)
  --<wd>aug2007<mds12>
  ---------------------------------------------------------------------------------------------------

  !!ce = !support.stru
  -- Show dimensions on graphics if required
  if !!mdsFt40.graphicalDim then
    !!mdsshowdim(!!mdsFt40)
  endif


  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  --<wd>jun2007<mds12>
  -- Create the Cross Reference ASSOCIATIONS between the MDS SUPPORT SCTN members $!name-V1
  -- and the Main Structure supporting elements for:
  -- <a> CURSOR mode !pick -- or -- <b> CLEARANCE mode !pick
  --
  -- Store the Original Current Element
  !xce = !!ce

  -- Store the Array of MDS Support Members in the MDSASSOC Object
  !mdsassoc.mdsmember[1] = $!name-V1

  -- Initialising the MDSASSOWL object always DELETES ALL of the EXISTING Cross Reference Associations
  -- (ASSOC) elements for the Current MDS Support, irrespective of the Creation MODE (!method)
  !mdsassowl = object MDSASSOWL(!form)
  !mdsassowl.mdsform  = !form
  !mdsassowl.mdsassoc = !mdsassoc

  -- Create the Association (ASSOCs) for the Current Support
  !mdsassowl.mdsassoc(!mdsassoc)

  -- Update the FORM SUPPORT object to reference the current MDSASSOWL Associations object
  !form.support.associations[1] = !mdsassowl
  !support = !form.support

  -- Navigate back to the Original Current Element
  !!ce = !xce

  --<wd>jun2007<mds12>
  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------

  -- Add pads if automatic pads option is on and a PANE or HPLATE has been picked
  if !!mdsOptions.autopads.selection().eq('ON') then
    !whichVerticals = 'ALL'
    if !method.eq('CURSOR') or !method.eq('CLEARANCE') then
      if !pick.hardType.eq('PANE') or !pick.hardType.eq('HPLATE') then
        !!mdsaddpad(!support,!whichVerticals)
      endif
    elseif !method.eq('DIMENSION') and !padsExist then
      !!mdsaddpad(!support,!whichVerticals)
    endif
  endif

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- End function
endfunction
