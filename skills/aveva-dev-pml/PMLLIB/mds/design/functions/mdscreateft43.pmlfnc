--------------------------------------------------------------------------------
--
-- File:                mdscreateft43.pmlfnc
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:          MPS131
--
-- Author:              I.osborne
-- Created:             Tue Jul 01
--
--
-- Description:
-- function to create support frame type 08
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCreateFt43(!method is STRING)

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  call !!mdsResetPins(1,9)

  --<wd>may2007<mds12>
  --    !iDType    = 'GENSEC SCTN PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX'
  !session   = current session
  if !session.module().upcase().match('DESIGN').gt(0) then
    !iDType    = 'GENSEC SCTN PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX'
  elseif  !session.module().upcase().match('OUTFITTING').gt(0) then
    !iDType    = 'GENSEC SCTN PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX HSTIFF HPLATE'
  endif
  --<wd>may2007<mds12>

  !support   = !!mdsFt43.support
  --!clearance = !!mdsOptions.clear.val
  !overlap   = !!mdsOptions.overlap.val
  -- !selection = !!mdsFt43.size.selection('Rtext')
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !datum     = !support.datum
  !stru      = !support.stru
  !name      = !stru.name
  !p10Dir    = !support.p10Dir
  !p11Dir    = !support.p11Dir
  !pLDir     = !support.pLDir
  !pADir     = !support.pADir
  !alias     = !support.alias

  --<k.pleschner>Jun06
  !datumDflts = object MDSANCGEOMDFLTS(!datum)
  !clearance = !datumDflts.oend
  --<k.pleschner>

  !v1exists = FALSE

  var !pjoiColl coll all pjoi with gtyp eq 'APAD' for $!stru
  if !pjoiColl.size().neq(0) then
    !padsExist = TRUE
  else
    !padsExist = FALSE
  endif

  -- Does the support have attached/Associated supports

  if !!mdsgetconnectedsupp(!stru) then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  ----------------------------- **** connexions **** -----------------------------
  --$(
  !refe = !!ce
  !form = !!mdsFt43

  --<wd>jun2007<mds12>
  -- Initialise the MDS Associations Data Creation Object MDSASSOC
  !mdsassoc = object MDSASSOC()
  !mdsassoc.mode = !method
  --<wd>jun2007<mds12>

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru

  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif
  !haveJoints = FALSE
  if(!form.support.joints.unset().not()) then
    !joints     = !support.joints
    !attributes = ARRAY()
    !haveJoints = !!kRestoreJoints(!joints,!attributes,'SAVE','')
    handle ANY
      !haveJoints = FALSE
      !support.joints.clear()
      -- in case they have been deleted and cancel is used
    endhandle
  endif
  --$)
  ---------------------------------------------------------------------------------


  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Check that Datum atta has been positioned
  if (!support.position.not())then
    !!alert.message('Position atta before identifying supporting steelwork')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  ------------------------------------------------------------------------------------------------------
  --<wd>nov2003>>>
  ------------------------------------------------------------------------------------------------------
  -- The CODE below has been MOVED to near the BOTTOM of this function. This ENSURES that the CHECKING
  -- is PERFORMED on the CURRENT 'DIMENSION' values and NOT the PREVIOUS values.
  -- This is MORE CRITICAL when CREATING by CURSOR or CLEARANCE rather than by DIMENSIONS
$(
  -- Check if ATTAS Created on The Support are Within the Allowable Bores for the STRUCTURE SCTN SIZES.
  !form = !!mdsFt43
  !cecomp = !!ce
  !error  = STRING()
  if (!!mdscheckbores(!form,!selection,!error,!currentUnits)) then
    !!alert.error(!error)
    !!ce = !stru
    delete STRU MEM
    handle (41,66) (2,113) (2,113)
    endhandle
    !!ce = !cecomp
    handle any
    endhandle
    !!kRestoreUnits(!currentUnits)
    return
  endif
$)
  ------------------------------------------------------------------------------------------------------
  --<wd>nov2003<<<
  ------------------------------------------------------------------------------------------------------


  !noEquiv = false

  -- Evaluate replacement support name for frame type 09
  !substitute = trim (before (!!mdsFrame.standard.dtext[!!mdsFrame.standard.rtext.findfirst('FT09')], '-'))
  handle any
    !noEquiv = true
    !substitute = 'Identified element is unsuitable to support from'
  endhandle

  -- Check which attas to work from
  if (!support.bars.size().leq(1))then
    !atta = !support.atta
  else
    !atta = !support.bars[1]
  endif

  -- Set initial orientation
  if (!pADir eq U or !pLDir eq U)then
    !ddir = !support.p9Dir
    VAR !p3P9Dir CONST DIR P3 OF $!datum TO P9 OF $!datum
    !udir = !p3P9Dir.direction()
  else
    !ddir = D wrt world
    !udir = U wrt world
  endif

  -- Store section name and matref for each member
  -- for resetting later

  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)


  -- Generate pin positions for each creation type

  if (!method eq |DIMENSION|)then

    -- Initialise variables for dimension check
    !d1 = !!mdsFt43.dim1.val
    !d2 = !!mdsFt43.dim2.val
    !d3 = !!mdsFt43.dim3.val
    -- !d4 = !!mdsFt43.dim4.val

    if (!d1.eq(0) or !d2.eq(0) or !d3.eq(0)) then
      !!alert.error('Not all of the dimensions have been completed.')
      !!kRestoreUnits(!currentUnits)
      call !!mdsResetPins(1,9)
      return
    endif

    !!mdsCreateMess(true)

    -- Position pins

    !!ce = !datum
    PIN 9 COPY P9
    PIN 9 DIR $!p10Dir
    PIN 8 COPY PIN9
    PIN 8 DIR $!p11Dir

    PIN 9 plane PIN 9 THRO CE
    PIN 8 plane PIN 8 THRO CE
    PIN 9 DIST $!d2
    PIN 9 DIR $!ddir
    PIN 7 COPY PIN 9
    PIN 7 DIST $!d3
    PIN 7 DIR $!udir
    PIN 8 DIST ($!d1 - $!d2)
    PIN 8 DIR $!ddir
    PIN 6 COPY PIN 8
    PIN 6 DIST $!d3
    --PIN 6 DIST $!d4
    PIN 6 DIR $!udir

    PIN 9 DIR FROM PIN 8 TO PIN 9
    PIN 8 DIR FROM PIN 9 TO PIN 8

  elseif (!method eq |CLEARANCE|)then
    ------------ *** Connexion Warnings *** -------------
    --$(
    !errorMessage = STRING()
    !dummyS       = ''

    if(!!kErrorsForConns(!form, !errorMessage,!dummyS).eq('UNJOINTED')) then
      -- nothing to do
    elseif(!!kErrorsForConns(!form, !errorMessage,!dummyS).eq('WARNING')) then
      !continue = !!alert.confirm(!errorMessage)
      if(!continue.eq('NO')) then
        call !!mdsResetPins(1,9)
        !!kRestoreUnits(!currentUnits)
        return
      endif
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('ERROR')) then
      !!alert.error(!errorMessage)
      call !!mdsResetPins(1,9)
      !!kRestoreUnits(!currentUnits)
      return
    else
      -- leave in case
    endif
    --$)
    ---------------------------------------------


    label /Element3

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify element to support from|
    ID $!iDType @
    handle (61,528)
      PROMPT ON
      !!ce = !stru
      !!kRestoreUnits(!currentUnits)
      call !!mdsResetPins(1,9)
      return
    endhandle
    PROMPT DISMISS
    PROMPT ON
    !pick3 = !!ce
    !testCe = !!mdsRelToDatum(!datum, !pick3, !ddir, !clearance.real())
    if (!testCe[1].upcase() eq 'UNSET')then
      !!alert.error('Identified element is unsuitable to support from.')
      golabel /Element3
    elseif (!testCe[1].upcase() eq '')then
      golabel /Element3
    endif
    if (!pADir eq U or !pLDir eq U)then
      if (!testCe[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('Identified element is behind pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'Identified element is behind pipe.')
        endif
        golabel /Element3
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is in line with the datum atta')
        golabel /Element3
      endif
    else
      if (!testCe[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('Identified element is above pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'Identified element is above pipe.')
        endif
        golabel /Element3
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is at the same elevation as the datum atta')
        golabel /Element3
      endif
    endif

    --<wd>may2007<mds12>
    --      if (!pick3.hardType eq 'PANE' or !pick3.type eq 'BOX')then
    if (!pick3.hardType eq 'PANE' or !pick3.type eq 'BOX' or !pick3.type eq 'HPLATE')then
      --<wd>may2007<mds12>

      !plane3 = !testCe[2]
    endif

    !!mdsCreateMess(true)

    -- Position pins

    -- Set first direction from P10

    !!ce = !datum
    PIN 9 AT P0 of $!datum
    PIN 9 DIR $!p10Dir
    PIN 7 COPY PIN 9
    !dim = 0

    --<k.pleschner>Jun06
    --do !i values !support.atta
    do !iref values !support.atta
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)
      --PIN 7 plane PIN 7 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 7 plane PIN 7 CLEAR $!i.oend BEH $!i
      else
        -- use distance from centreline
        PIN 7 plane PIN 7 THR $!i
        PIN 7 plane PIN 7 DIST $!i.oend
      endif
      handle (2,109)
        break
      endhandle
      VAR !cDIR CONST DIR PIN 9 TO PIN 7
      !cdim = !!kStrReal('CONST DIST PIN 9 TO PIN 7')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cDIR.direction()
      !direction.directionB = !p10Dir
      !direction.tolerance  = 0.05

      if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 7 AT $!datum
        PIN 7 DIST $!cdim
        !dim = !cdim
      else
        PIN 7 AT $!datum
        PIN 7 DIST $!dim
      endif
    enddo

    PIN 7 DIR $!ddir
    VAR !pin7Pos PIN 7 POS WRT WORLD

    --<wd>may2007<mds12>
    --      if (!pick3.type eq 'SCTN') or (!pick3.hardType eq 'GENSEC') then
    if (!pick3.type eq 'SCTN') or (!pick3.hardType eq 'GENSEC') or  (!pick3.hardType eq 'HSTIFF') then
      --<wd>may2007<mds12>

      !inter = !!kFlangeOrWeb(!pick3, !pin7Pos.position(), !ddir)
      PIN 7 AT $!inter
      ---------------****** Connexions ******----------------------
      --$(
      !support.connections.clear()
      !support.connections[1] = !pick3
      !support.connections[2] = !pick3
      -- !!mdsFt43.lineUp.active = True
      ------------------this bit will stop clearance being used if support is not under picked sctn-----------------------
      if(!haveJoints) then
        !connected = !!mdsGetBeamConn(!support,!attributes[1][8].dbref())
        if(!connected.unset()) then
          !!alert.error('Support is not positioned correctly through the new joints. Position "Through", before continuing.')
          !!ce = !refe
          call !!mdsResetPins(1,9)
          return
        endif
      endif
      ------------------------take it out and it will create joints however far apart the support and steel is------------
      --$)
    else
      VAR !tempInter CONS POS INT PIN 7 $!plane3
      !inter = !tempInter.position()
      PIN 1 AT $!inter
      PIN 7 plane PIN 7 THRO PIN 1
    endif

    PIN 9 AT P9 of $!datum
    PIN 9 plane PIN 9 THRO PIN 7

    -- set second direction from P11

    !!ce = !datum
    PIN 8 AT P0 of $!datum
    PIN 8 DIR $!p11Dir
    PIN 6 COPY PIN 8
    !dim = 0

    --<k.pleschner>Jun06
    --do !i values !support.atta
    do !iref values !support.atta
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)

      --PIN 6 plane PIN 6 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 6 plane PIN 6 CLEAR $!i.oend BEH $!i
      else
        -- use distance from centreline
        PIN 6 plane PIN 6 THR $!i
        PIN 6 plane PIN 6 DIST $!i.oend
      endif
      handle (2,109)
        break
      endhandle
      VAR !cDIR CONST DIR PIN 8 TO PIN 6
      !cdim = !!kStrReal('CONST DIST PIN 8 TO PIN 6')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cDIR.direction()
      !direction.directionB = !p11Dir
      !direction.tolerance  = 0.05

      if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 6 AT $!datum
        PIN 6 DIST $!cdim
        !dim = !cdim
      else
        PIN 6 AT $!datum
        PIN 6 DIST $!dim
      endif
    enddo

    PIN 6 DIR $!ddir
    VAR !pin6Pos PIN 6 POS WRT WORLD

    --<wd>may2007<mds12>
    --      if (!pick3.type eq 'SCTN') or (!pick3.hardType eq 'GENSEC') then
    if (!pick3.type eq 'SCTN') or (!pick3.hardType eq 'GENSEC')  or (!pick3.hardType eq 'HSTIFF') then
      --<wd>may2007<mds12>

      !inter = !!kFlangeOrWeb(!pick3, !pin6Pos.position(), !ddir)
      PIN 6 AT $!inter
    else
      VAR !tempInter CONS POS INT PIN 6 $!plane3
      !inter = !tempInter.position()
      PIN 1 AT $!inter
      PIN 6 plane PIN 6 THRO PIN 1
    endif

    PIN 8 AT P9 of $!datum
    PIN 8 plane PIN 8 THRO PIN 6

    --<wd>jun2007<mds12>
    -- Save !pick3 for Associations
    !mdsassoc.pick3 = !pick3
    --<wd>jun2007<mds12>

  endif

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  -- Create and ARRAY of Attas with Packing Pieces (PDMS Names ONLY)
  -- and the Type and Size of the Packing Pieces to Recreate
  !attapp = !!mdspackers(!support)

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  !!ce = !stru

  -- Pins now in position create framework

  delete STRU MEM
  --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
  !!mdsRemoveAutoPadRules(!stru)
  --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end
  handle (41,66) (2,113) (2,113)
  endhandle

  --<wd>oct2000
  !mdstemp = /MDS/$!alias/$!selection
  :mdscheck $!mdstemp.:mdscheck
  :mdsframirror $!mdstemp.:mdsframirror

  --<wd>oct2000

  --<wd>feb2004
  -- Position the MDS STRU
  --AT $!datum
  if (!datum.styp inset ('AT60')) then
    at p9 of $!datum
  else
    at $!datum
  endif
  --<wd>feb2004

  NEW FRMW $!name/MAIN
  !frmwSupport = !!ce

  -- Copy required template/s
  !!ce = /MDS/$!alias/$!selection

  !subs = !!kCollectAllFor('SUBS', '', !!ce)
  !frmw = !!kCollectAllFor('FRMW', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')

  -- Navigate back to support and create template elements
  !!ce = !frmwSupport
  COPY ATTRIB OF $!frmw[1]
  COPY MEM OF $!frmw[1] RENAME $!frameFormat $!name
  do !i indices !subs
    NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
    COPY MEM OF $!subs[$!i] RENAME $!frameFormat $!name
  enddo

  -- Get direction of P9 of datum atta and dist between p9 and p0

  !!ce = !stru

  -- Set stru description for template recognition

  !desc = desc of /MDS/$!alias/$!selection
  desc '$!desc'
  :mdsbars :mdsbars

  MOVE $!ddir THRO P9 OF $!datum

  !oRIX = !p11Dir
  !oRIZ = !udir

  ORI X IS $!oRIX AND Z IS $!oRIZ

  -- If a trunnion is added to a support then we need to store the direction in a
  -- uda for later use

  var !oriFrame dir y wrt /*
  :MdsFrameDir $!oriFrame

  -- Extend and move leg 1

  !!ce = $!<name>-V1
  handle none
    !v1exists = TRUE
    !v1ref = !!ce

    !num = :MDSOnum

    EXTEND START THRO PIN 6
    !flush = :MdsOlap
    if !flush eq 'FLUSH' then
      --EXTEND END BEH $!<name>-BAR-1
    elseif !flush eq 'OVERLAP' then
      !num = :MdsOnum
      EXTEND END THRO PIN 8
      EXTEND END $!num
    else
      EXTEND END THRO PIN 8
      --> Modified-<wd>-6oct1998
      --xxx      EXTEND END $!overlap
      EXTEND END -$!overlap
    endif

    VAR !dir PIN 8 DIR WRT WORLD
    MOVE $!dir WRT WORLD THRO PIN 8
    MOVE $!dir WRT WORLD clear 0 inf pin 8
    PIN 5 COPY PIN 8
    PIN 3 COPY PIN 8
    PIN 5 plane PIN 5 CLEAR 0 BEH CE
    PIN 3 plane PIN 3 CLEAR 0 INF CE
    !d58 = !!kStrReal('CONST DIST PIN 5 TO PIN 8')
    !d38 = !!kStrReal('CONST DIST PIN 3 TO PIN 8')
    !d35 = !!kStrReal('CONST DIST PIN 3 TO PIN 5')
    !diff = ((!d38 - !d58) / 2)
    PIN 3 plane PIN 3 CLEAR 0 INF CE

    ------------------****** connexions *******----------------------
    if(!support.connections.unset()) then
      -- dimensions are being used first
      :MDSConn default
    else
      !vertical1 = !!ce
      !connected = !!mdsGetBeamConn(!support,!vertical1)
      :MDSConn $!connected
    endif
  elsehandle any
  endhandle
  --------------------*******************--------------------------


  -- Extend and move leg 2

  !!ce = $!<name>-V2
  handle none

    !num = :MDSOnum

    EXTEND START THRO PIN 7
    if !flush eq 'FLUSH' then
      --EXTEND END BEH $!<name>-BAR-1
    elseif !flush eq 'OVERLAP' then
      !num = :MdsOnum
      EXTEND END THRO PIN 9
      EXTEND END $!num
    else
      EXTEND END THRO PIN 9
      --> Modified-<wd>-6oct1998
      --xxx      EXTEND END $!overlap
      EXTEND END -$!overlap
    endif

    VAR !dir PIN 9 DIR WRT WORLD
    MOVE $!dir WRT WORLD THRO PIN 9
    MOVE $!dir WRT WORLD clear 0 inf pin 9
    PIN 5 COPY PIN 9
    PIN 4 COPY PIN 9
    PIN 5 plane PIN 5 CLEAR 0 BEH CE
    PIN 4 plane PIN 4 CLEAR 0 INF CE
    !d59 = !!kStrReal('CONST DIST PIN 5 TO PIN 9')
    !d49 = !!kStrReal('CONST DIST PIN 4 TO PIN 9')
    !d45 = !!kStrReal('CONST DIST PIN 4 TO PIN 5')
    !diff = ((!d49 - !d59) / 2)
    PIN 4 plane PIN 4 CLEAR 0 INF CE

    ----------------------- ****** connexions ******* --------------------
    --$(
    if(!support.connections.unset()) then
      -- dimensions are being used first
      :MDSConn default
    else
      !vertical2 = !!ce
      !connected = !!mdsGetBeamConn(!support,!vertical2)
      :MDSConn $!connected
    endif
    --$)
    ---------------------------********************-----------------------

  elsehandle any
  endhandle

  -- Extend and move bar 1


  !!ce = $!<name>-BAR-1

$(
  PIN 5 COPY PIN 9
  !tempOverlap = :MdsOlap
  if !tempOverlap eq 'OVERLAP' then
    !num = :MdsOnum
    PIN 5 plane PIN 5 CLEAR $!num INF $!<name>-V1
  else
    PIN 5 plane PIN 5 CLEAR $!overlap INF $!<name>-V1
  endif
  EXTEND END THRO PIN 5
  PIN 5 COPY PIN 8
  if !tempOverlap eq 'OVERLAP' then
    !num = :MdsOnum
    PIN 5 plane PIN 5 CLEAR $!num INF $!<name>-V2
  else
    PIN 5 plane PIN 5 CLEAR $!overlap INF $!<name>-V2
  endif
$)
  EXTEND START THRO PIN 8
  EXTEND END THRO PIN 9

  if !v1exists then
    if !v1ref.purp.eq('MITR') then
      !num = :mdsonum
      extend start $!num
      extend end $!num
    endif
  endif

  -- Set dimensions

  if !method eq |CLEARANCE| then

    -- Dimension 1
    !dim1 = !!kStrReal('CONST DIST PIN 8 TO PIN 9')
    !!mdsFt43.dim1.val = !dim1

    -- Dimension 2

    PIN 2 COPY PIN 9
    PIN 2 plane PIN 2 THRO $!datum
    !dim2 = !!kStrReal('CONST DIST PIN 2 TO PIN 9')
    !!mdsFt43.dim2.val = !dim2

    -- Dimension 3 and 4

    !dim3 = !!kStrReal('CONST DIST PIN 9 TO PIN 7')
    !!mdsFt43.dim3.val = !dim3
    -- !dim4 = !!kStrReal('CONST DIST PIN 8 TO PIN 6')
    -- !!mdsFt43.dim4.val = !dim4

  endif

  -- Select correct spref

  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  SEL SPREF WITH STYP '$!alias-1-$!selection' SPEC /MDF
  !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-1-1')

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)
  !!mdsDacControl(TRUE)

  !!ce = !stru

  -- Check to see if support is mirrored
  if (!support.mirror)then
    call !!mdsMirrorFt43()
    !support.mirror = true
  endif

  -- If cross-bars existed replace them

  if (!support.bars.empty().not())then
    do !i indices !support.bars
      skip if (!i.eq(1))
      call !!mdsAddBarFt43(!support, 'OLD')
    enddo
    !support.barLen = !!mdsFt43.support.barLen
  endif
  !list = !support.bars[1]
  !references = ''
  do !i indices !list
    !references = !references & ' ' & !list[!i].string()
  enddo

  -- Set atta reference to datum cross bar
  !!ce = $!<name>-BAR-1
  :MDSAttaRef $!references
  !support.barLen[1] = deri length of CE
  !!ce = !stru

  -- Adjust for slope on horizontal lines only

  if (!pADir neq U and !pLDir neq U)then

    -- Check to see if the line is sloping
    !adjust = 0
    do !v values !atta
      !!ce = !v
      skip if !!ce.:mdsrotdir.east.set()
      !grad = pl grad
      if (!grad.neq(0))then
        !strucElement = ARRAY()
        !ref = $!name-BAR-1
        !strucElement.append(!ref)
        !vHeight = !!mdsAdjustSlope(!strucElement, !v)
      else
        !vHeight = 0
      endif
      if (!vHeight.gt(!adjust))then
        !adjust = !vHeight
      endif
    enddo

    -- Adjust required elements
    !!ce = $!<name>-BAR-1
    MOVE D WRT WORLD DIST $!adjust

    $!name-V1
    handle any
    elsehandle none

      !end   = Posend wrt world
      !start = Posstart wrt world

      if (!support.mirror)then
        PIN 6 AT $!end
        PIN 8 AT $!start
      else
        PIN 6 AT $!start
        PIN 8 AT $!end
      endif

      PIN 6 DIR TO PIN 8
      !toBar = 0
      do !indx indices !support.bars
        PIN 8 COPY PIN 6
        PIN 8 plane PIN 8 THRO $!<name>-BAR-$!indx
        !toBar1 = !!kStrReal('CONST DIST PIN 6 TO PIN 8')
        if (!toBar1.gt(!toBar))then
          !toBar = !toBar1
          !index = !indx
        endif
      enddo
      PIN 8 plane PIN 8 CLEAR 0 BEH $!<name>-BAR-$!index

      !num = :MDSOnum

      if !flush neq 'FLUSH' then
        if (!support.mirror)then
          if !flush eq 'OVERLAP' then
            EXTEND START THRO pin 8
            !num = :MdsOnum
            EXTEND START $!num
          else
            EXTEND START THRO pin 8
            EXTEND START -$!overlap
          endif
        else
          if !flush eq 'OVERLAP' then
            EXTEND END THRO pin 8
            !num = :MdsOnum
            EXTEND END $!num
          else
            EXTEND END THRO pin 8
            EXTEND END -$!overlap
          endif
        endif
      endif

      if(!support.connections.unset()) then
        -- dimensions are being used first
        :MDSConn default
      else
        !vertical = !!ce
        !connected = !!mdsGetBeamConn(!support,!vertical)
        :MDSConn $!connected
      endif

      if (!method eq |DIMENSION|)then
        -- Extend vertical leg to account for the required adjustment

        if (!support.mirror)then
          !sctnEnd = 'END'
        else
          !sctnEnd = 'START'
        endif

        PIN 6 plane PIN 6 DIST -$!adjust
        EXTEND $!sctnEnd THRO PIN 6
      endif

    endhandle

    $!<name>-V2
    handle any
    elsehandle none

      !end   = Posend wrt world
      !start = Posstart wrt world

      if (!support.mirror)then
        PIN 7 AT $!end
        PIN 9 AT $!start
      else
        PIN 7 AT $!start
        PIN 9 AT $!end
      endif

      PIN 7 DIR TO PIN 9
      !toBar = 0
      do !indx indices !support.bars
        PIN 9 COPY PIN 7
        PIN 9 plane PIN 9 THRO $!<name>-BAR-$!indx
        !toBar1 = !!kStrReal('CONST DIST PIN 7 TO PIN 9')
        if (!toBar1.gt(!toBar))then
          !toBar = !toBar1
          !index = !indx
        endif
      enddo
      PIN 9 plane PIN 9 CLEAR 0 BEH $!<name>-BAR-$!index

      !num = :MDSOnum

      if !flush neq 'FLUSH' then
        if (!support.mirror)then
          if !flush eq 'OVERLAP' then
            EXTEND START THRO pin 9
            !num = :MdsOnum
            EXTEND START $!num
          else
            EXTEND START THRO pin 9
            --> Modified-<wd>-6oct1998
            --xxx            EXTEND START $!overlap
            EXTEND START -$!overlap
          endif
        else
          if !flush eq 'OVERLAP' then
            EXTEND END THRO pin 9
            !num = :MdsOnum
            EXTEND END $!num
          else
            EXTEND END THRO pin 9
            --> Modified-<wd>-6oct1998
            --xxx            EXTEND END $!overlap
            EXTEND END -$!overlap
          endif
        endif
      endif

      if (!method eq |DIMENSION|)then
        -- Extend vertical leg to account for the required adjustment

        if (!support.mirror)then
          !sctnEnd = 'END'
        else
          !sctnEnd = 'START'
        endif

        PIN 7 plane PIN 7 DIST -$!adjust
        EXTEND $!sctnEnd THRO PIN 7

      else

        -- Adjust dimensions on form
        !dim3Exist = !!mdsFt43.dim3.val - !adjust

        -- reset dimensions on form
        !!mdsFt43.dim3.val = !dim3Exist

      endif

    endhandle
  endif

  !!ce = $!<name>/SREF

  !!mdsDacControl(true)

  ------------------------------------------------------------------------------------------------------
  --<wd>nov2003>>>
  -- Despar 5 will store the maximum bore size on the support if FT37
  --    DESPAR $!!mdsFt43.dim1.val $!!mdsFt43.dim2.val $!!mdsFt43.dim3.val

  -- Despar 4 will store the maximum bore size on the support if FT43
  if !alias.eq('FT43') then
    !srefName = !form.support.stru.name + '/SREF'
    !!ce = !srefName.dbref()
    !largestBore = object BORE()
    !largestBore = !form.support.datum.abore
    do !loop values !form.support.atta
      !largestBore = !loop.abore
      if !loop.abore.gt(!largestBore) then
        !largestBore = !loop.abore
      endif
    enddo
    -- Only set the largest bore is greater than the bore already stored
    !isNow = despara 4
    if !isNow.size().neq(0) then
      if !largestBore.real().lt(!isNow[1]) then
        !largestBore = !isNow[1].bore()
      endif
    endif
    DESPAR $!!mdsFt43.dim1.val  $!!mdsFt43.dim2.val   $!!mdsFt43.dim3.val  $!largestBore
  endif
  --<wd>nov2003<<<
  ------------------------------------------------------------------------------------------------------

  ------------------------------------------------------------------------------------------------------
  --<wd>nov2003>>>
  !!mdsDacControl(true)
  -- Check if ATTAS Created on The Support are Within the Allowable Bores for the STRUCTURE SCTN SIZES.
  !cecomp = !!ce
  !error  = STRING()
  if (!!mdscheckbores(!form,!selection,!error,!currentUnits)) then
    !!alert.error(!error)
    !!ce = !stru
    --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
    !!mdsRemoveAutoPadRules(!stru)
    --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end
    delete STRU MEM
    handle (41,66) (2,113) (2,113)
    endhandle
    -- Reset SREF Despars to ZERO as the STRU MEM have been DELETED
    !!ce = $!<name>/SREF
    handle none
      -- Only RESET the DESPARS for the DIMENSION GADGETS -
      -- DESPAR num 4 stores the LARGEST PIPE BORE SIZE on the SUPPORT and is still VALID
      desp num 1 0mm
      desp num 2 0mm
      desp num 3 0mm
    elsehandle any
    endhandle
    -- Reset all pins associated with this support
    !!mdsResetPins(1,9)
    !!ce = !cecomp
    handle any
    endhandle
    !!mdsCreateMess(false)
    !!kRestoreUnits(!currentUnits)
    return
  endif
  --<wd>nov2003<<<
  ------------------------------------------------------------------------------------------------------


  !!mdsDacControl(false)
  -- Reset materials of sections

  !!mdsResetMat(!storeMat)


  !!ce = !stru

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  -- Set 'FT25' form Support Object to be the same as 'Ft43' form Support Object
  !!mdsFt25.support = !support

  -- Clear packs from 'BOTH forms' Support Objects as the SCTNs have already been deleted
  -- During the Framework Creation above
  !!mdsFt25.support.packs.clear()
  !support.packs.clear()

  -- Create Required Packing Pieces(SCTNs) at the Necessary Attas
  call !!mdscrpacksft25(!attapp, !!mdsFt43)

  -- Update 'Ft43' support.packs data to that held in form 'FT25'
  !support.packs = !!mdsFt25.support.packs

  -- Navigate to Main Structure of Framework
  !!ce = !stru

  ----------------------***** connexions *****--------------------------
  --$(
  if(!haveJoints) then
    do !index indices !joints

      if(!joints[!index].badref().not() and !attributes[!index][8].dbref().:MDSConn.eq(!joints[!index].owner.owner)) then
        !mainStl = !attributes[!index][8].dbref().:MDSConn
        !support.joints[!index] =  !!mdsCreateJoint(!mainStl, !attributes[!index][8].dbref(),!joints[!index],!attributes[!index])
      else
        !dummy = object DBREF()
        !dummyA = ARRAY()
        !mainStl = !support.connections[!index]
        !support.joints[!index] =  !!mdsCreateJoint(!mainStl, !attributes[!index][8].dbref(),!dummy,!dummyA)
      endif
    enddo
  endif

  --$)
  ----------------------------------------------------------------------

  -- If a joint is being used and it is handed then their will be a alternative spref of the
  -- opposite hand joint and the bang to set separated by a ,

  !!mdsSwapIntJoi(!support.stru,!support.mirror,!support.alias)

  !!ce = !stru

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.append(!!ce)
  !colourList.appendarray(!support.atta)
  !colourList.appendarray(!support.joints)

  -- Colour Support
  call !!kEnhanceList(!colourList)


  -- Update support data held in form
  !!mdsFt43.support = !support

  !!mdsCreateMess(false)

  -- Move the snod of the V1 through the BAR

  !!ce = $!<name>-V1
  handle none
    var !sjois coll all sjoi for ce
    do !resetZdist values !sjois
      !!ce = !resetZdist.dbref()
      !cref = !!ce.cref
      end
      zdist Through $!cref
    enddo
  elsehandle any
  endhandle

  !!ce = $!<name>-V2
  handle none
    var !sjois coll all sjoi for ce
    do !resetZdist values !sjois
      !!ce = !resetZdist.dbref()
      !cref = !!ce.cref
      end
      zdist Through $!cref
    enddo
  elsehandle any
  endhandle

  -- Find the height of the section required
  -- If a vertical section exists then this is not required

  !!ce = $!<name>-V1
  handle any
    pin 9 at p9 of $!name/DATUM
    pin 9 dir d wrt /*
    $!name/S1/IJOINT1
    if (!method eq |DIMENSION|)then
      despar n1 $!!mdsFt43.dim3.val
    else
      pin 8 copy pin 9
      pin 8 plane pin 8 clear 0 inf $!pick3
      var !height const dist pin 9 to pin 8
      despar $!height $!!mdsFt43.dim1.val
    endif
    despar n2 $!!mdsFt43.dim1.val
  elsehandle none
    same
  endhandle

  -- Work out distance between V1 and V2

  !!ce = $!<name>-V1
  handle any
  elsehandle none
    pin 9 at $!name-V2
    pin 8 at $!name-V1
    pin 9 dir u wrt /*
    pin 8 dir u wrt /*
    pin 9 plane pin 9 thro pin 8
    var !dist const dist pin 9 to pin 8
    pin 9 dir from pin 9 to pin 8
    var !dir pin 9 dir
    !howmany = !dist.real() / 500
    !tag = 3
    if !howmany.nint().gt(1) then
      $!name-V2
      do from 2 to !howmany.nint()
        new sctn $!name-V$!tag copy prev
        !tag = !tag + 1
        !moveDist = !dist.real() / !howmany.nint()
        move $!dir dist $!moveDist
      enddo
    endif

  endhandle

  -- Reset all pins associated with this support
  call !!mdsResetPins(1,9)

  $!name

  ---------------------------------------------------------------------------------
  -- Move the STRU to the Offset Position relative to the setting in the UDA
  -- :MdsNudgeDist of the DATUM ATTA only.
  !checkdat = object MDSCHECKDATUM()
  !checkdat.offset(!form)

  -- Add the Aid Text to P9 of each Support Atta on the Framework
  !!mdsaidtext(!form)
  ---------------------------------------------------------------------------------

  !!ce = !stru

  -- Copy welds locally
  !copyWelds = object MDSWELDLIST(!!ce,!form)

  !!ce = !stru

  -- Show dimensions on graphics if required
  if !!mdsFt43.graphicalDim then
    !!mdsshowdim(!!mdsFt43)
  endif

  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  --<wd>jun2007<mds12>
  -- Create the Cross Reference ASSOCIATIONS between the MDS SUPPORT SCTN members $!name-V1 and $!name-V2
  -- and the Main Structure supporting elements for:
  -- <a> CLEARANCE mode !pick3
  --
  -- Store the Original Current Element
  !xce = !!ce

  -- Loop thro the !name-V* elements in the MDS STRUCTURE to enable an Association to be made with the Identified element
  var !vsctns coll all sctn where (matchwild (name of sctn , '$!name-V*' )) for $!stru

  -- DO NOT CREATE Associations when there are NO MDS Support SCTN Members named "$!name-V*" etc...
  if (!vsctns.empty().not()) then
    -- Store the Array of MDS Support SCTN Members "$!name-V*" in the MDSASSOC Object
    do !indx indices !vsctns
      !mdsassoc.mdsmember[!indx] = $!vsctns[$!indx]
    enddo

    -- Initialising the MDSASSOWL object always DELETES ALL of the EXISTING Cross Reference Associations
    -- (ASSOC) elements for the Current MDS Support, irrespective of the Creation MODE (!method)
    !mdsassowl = object MDSASSOWL(!form)
    !mdsassowl.mdsform  = !form
    !mdsassowl.mdsassoc = !mdsassoc

    -- Create the Association (ASSOCs) for the Current Support
    !mdsassowl.mdsassoc(!mdsassoc)

    -- Update the FORM SUPPORT object to reference the current MDSASSOWL Associations object
    !form.support.associations[1] = !mdsassowl
    !support = !form.support

  endif

  -- Navigate back to the Original Current Element
  !!ce = !xce

  --<wd>jun2007<mds12>
  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------

  -- Add pads if automatic pads option is on and a PANE or HPLATE has been picked
  if !!mdsOptions.autopads.selection().eq('ON') then
    !whichVerticals = 'ALL'
    if !method.eq('CLEARANCE') then
      if !pick3.hardType.eq('PANE') or !pick3.hardType.eq('HPLATE') then
        !!mdsaddpad(!support,!whichVerticals)
      endif
    elseif !method.eq('DIMENSION') and !padsExist then
      !!mdsaddpad(!support,!whichVerticals)
    endif
  endif

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- End function
endfunction
