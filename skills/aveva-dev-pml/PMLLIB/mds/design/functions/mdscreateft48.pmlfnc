--------------------------------------------------------------------------------
--
-- File:  mdscreateft48.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          MPS147
--
-- Author:  I.osborne
-- Created:  Mon Aug 04
--
--
-- Description:
-- function to create support frame type 48
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
--<wd>dec2004
--  define function !!mdsCreateFT48(!method is STRING)
define function !!mdsCreateFT48(!methodtype is STRING)

  !method = !methodtype
  !split  = !method.split(',')

  if !split.size() gt 1 then
    !method  = !method.before(',')
    --<rm>dec2005
    !method2 = !split[2]
  else
    !method2 = |unset|
  endif

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  call !!mdsResetPins(1,9)

  --<wd>may2007<mds12>
  --    !iDType  = 'GENSEC SCTN PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX'
  !session   = current session
  if !session.module().upcase().match('DESIGN').gt(0) then
    !iDType  = 'GENSEC SCTN PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX'
  elseif  !session.module().upcase().match('OUTFITTING').gt(0) then
    !iDType  = 'GENSEC SCTN PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX HSTIFF HPLATE'
  endif
  --<wd>may2007<mds12>

  !support   = !!mdsFt48.support
  -- !selection = !!mdsFt48.size.selection('Rtext')
  --!subType   = !!mdsSetSteel.size.selection('Dtext').aFTER('Type ')
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !datum     = !support.datum
  !stru      = !support.stru
  !name      = !stru.name
  !alias     = !support.alias

  var !pjoiColl coll all pjoi with gtyp eq 'APAD' for $!stru
  if !pjoiColl.size().neq(0) then
    !padsExist = TRUE
  else
    !padsExist = FALSE
  endif

  -- Does the support have attached/Associated supports
  if !!mdsgetconnectedsupp(!stru) then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Check that Datum atta has been positioned
  if (!support.position.not())then
    !!alert.message('Position atta before identifying supporting steelwork')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Update support object for P9dir/p10dir/p11dir in case it has been rotated
  !!ce = !datum
  !support.p9Dir  = P9 Dir wrt world
  !support.p10Dir = P10 Dir wrt world
  !support.p11Dir = P11 Dir wrt world
  same

  ----------------------------- **** connexions **** -----------------------------
  --!refe         = !!ce
  !form      = !!mdsFt48

  --<wd>jun2007<mds12>
  -- Initialise the MDS Associations Data Creation Object MDSASSOC
  !mdsassoc = object MDSASSOC()
  !mdsassoc.mode = !method
  --<wd>jun2007<mds12>

  !desc = desc of /MDS/TEMPLATES
  handle ANY
    !desc = ''
  endhandle
  if !desc.eq('Zimmer Templates') and !alias.eq('FT48A') then
    !cap = !!mdsFt48.cap.selection('Rtext')
    !!mdsSetSteel.size.val = !cap.real()
    !selection = !!mdsSetSteel.size.selection('Rtext')
  endif

  !bore = !datum.abore
  -- GE 23/11/05 updated this code for Zimmer Standards
  if !desc.eq('Zimmer Templates') and !alias.eq('FT48A') then
    var !strucoll collect all stru for /MDS/FRAMES/FT48A
    handle any
      !!alert.message('The MDS Framework Templates for the MDS support standard ''FT48'' do not exist - Aborting Creation')
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    if !bore.real().lt(!strucoll[$!cap].dbref().:mdsminbore.real() ) or !bore.gt(!strucoll[$!cap].dbref().:mdsmaxbore.real() ) then
      -- bore not in range for selected framework
      !!alert.error('Selected template is not suitable for this pipe bore')
      return
    endif
  endif


  -- Can we write to the spref attribute of the SREF atta and the stru
  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  !haveJoints = FALSE
  if(!form.support.joints.unset().not()) then
    !joints     = !support.joints
    !attributes = ARRAY()
    !haveJoints = !!kRestoreJoints(!joints,!attributes,'SAVE','')
    handle ANY
      !haveJoints = FALSE
      !support.joints.clear()
      -- in case they have been deleted and cancel is used
    endhandle
  endif
  ---------------------------------------------------------------------------------

  -- First check atta pleave orientation is not pointing vertically
$(
  if (!support.pLDir eq U or !support.pADir eq U) then
    !!alert.error('Atta orientation is incorrect. cannot create horizontal posts.')
    !!kRestoreUnits(!currentUnits)
    return
  endif
$)

  -------------------------------------------------
  --<wd>dec2004 -- Determine the initial orientation,
  -- i.e. !ddir and !udir, via the P9 direction of the DATUM Atta

$(
  -- Set initial orientation
  !ddir = D
  !udir = U
$)

  -- Added nov 2004 - Always read the P9direction for the TRUE !ddir of the DATUM ATTA
  -- HORIZONTAL and VERTICAL PIPES + SLOPING PIPES need the TRUE ORTHOGONAL DIRECTIONS
  !ddir = !support.p9dir
  var !p3p9dir const dir p3 of $!datum to p9 of $!datum
  !udir = !p3p9dir.direction()
  --<wd>dec2004
  -------------------------------------------------

  -- Store section name and matref for each member for resetting later
  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)

  -- Generate pin positions for each creation type
  if (!method eq |CURSOR|)then

    ------------ *** Connexion Warnings *** -------------
    !errorMessage = STRING()
    !dummyS       = ''

    if(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('UNJOINTED')) then
      -- nothing to do
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('WARNING')) then
      !continue = !!alert.confirm(!errorMessage)
      if(!continue.eq('NO')) then
        !!kRestoreUnits(!currentUnits)
        return
      endif
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('ERROR')) then
      !!alert.error(!errorMessage)
      !!kRestoreUnits(!currentUnits)
      return
    endif
    ---------------------------------------------

    label /Element1

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify element to support off|
    ID $!iDType @
    handle (61,528)
      PROMPT ON
      !!ce = !stru
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    PROMPT DISMISS
    PROMPT ON
    !pick = !!ce
    !testCe = !!mdsRelToDatum(!datum, !pick, !ddir, 0)
    if (!testCe[1].upcase() eq 'UNSET')then
      !!alert.error('Identified element is unsuitable to support from.')
      golabel /Element1
    elseif (!testCe[1].upcase() eq '')then
      golabel /Element1
    elseif (!testCe[1].upcase() eq 'EQUAL')then
      !!alert.error('Identified element is at the same elevation as the datum atta')
      golabel /Element1
    elseif (!testCe[1].upcase() eq 'ABOVE')then
      !!alert.error('Identified element is above the datum atta')
      golabel /Element1
    endif

    --<wd>may2007<mds12>
    --      if (!pick.hardType eq 'PANE' or !pick.type eq 'BOX')then
    if (!pick.hardType eq 'PANE' or !pick.type eq 'BOX' or !pick.type.eq('HPLATE'))then
      --<wd>may2007<mds12>

      !plane = !testCe[2]
      VAR !pDir CONST DIR $!plane
    endif

    !!mdsCreateMess(true)

    -- Position Pins
    !!ce = !pick

    --<wd>may2007<mds12>
    --      if (!!ce.type eq 'SCTN') or (!!ce.type eq 'GENSEC') then
    if (!!ce.type eq 'SCTN') or !!ce.type.eq('GENSEC') or !!ce.type eq ('HSTIFF') then
      --<wd>may2007<mds12>

      -- ************************ Connexions ***********************
      !support.connections[1] = !pick

      !start = plstart NA wrt world
      !end   = plend NA wrt world
      var !lineA CONS line JOIN $!start to $!end
      var !lineB CONS line $!ddir THRO P0 of $!datum
      var !tempInter CONS POS INT $!lineA $!lineB
      !inter = !tempInter.position()

      if (!inter.unset())then
        !!mdsCreateMess(false)
        !!alert.error('Unable to create support from identified section using this method. Use Dimensions')
        !!kRestoreUnits(!currentUnits)
        return
      endif
      !inter = !!kFlangeOrWeb(!pick, !datum.pos, !ddir)

    else
      PIN 1 AT $!pick
      PIN 1 DIR $!pDir WRT WORLD
      Var !tempInter CONST POS INTER PIN 1 $!plane
      !inter = !tempInter.position()
    endif

    --<wd>jun2007<mds12>
    -- Save !pick and for Associations
    !mdsassoc.pick1 = !pick
    --<wd>jun2007<mds12>

    PIN 9 AT $!inter
    PIN 9 DIR $!ddir
    PIN 7 AT P9 of $!datum
    PIN 7 DIR $!udir
    PIN 7 plane PIN 7 THRO PIN 9
    PIN 8 AT P9 of $!datum
    PIN 8 DIR $!ddir

  elseif (!method eq |DIMENSION| or !method eq |DIMSET| )then
    --<BC>Apr2005
    --Check to see if V1 exists and save the end and start directions for sloping decks
    !!ce = $!<name>-V1
    handle(2,109)
    elsehandle NONE
      if (!support.mirror) then
        !farend = 1
      else
        !farend = 0
      endif
      -- because we are building by dimension, we need to save the plane of the ends
      -- mdssaveends stores the end to trim !farend and the method used by mdsoverdim
      !saveV1 = object MDSSAVEENDS(!!ce,!datum,!farend)
      --  !v1SctnDrne = Drne wrt worl
      -- !v1SctnDrns = Drns wrt worl
    endhandle

    -- Initialise variables for dimension check
    !d1 = !!mdsFt48.dim1.val
    if (!d1.eq(0))then
      !!alert.error('Dimension 1 has to be set.')
      !!kRestoreUnits(!currentUnits)
      return
    endif
    !!mdsCreateMess(true)

    -- Position pins
    PIN 7 AT P9 of $!datum
    PIN 7 DIR $!ddir
    PIN 7 DIST $!d1
    PIN 7 DIR $!udir
    PIN 8 AT P9 of $!datum
    PIN 8 DIR $!ddir
  endif

  !!ce = !stru
  --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
  !!mdsRemoveAutoPadRules(!stru)
  --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end
  -- Pins now in position create framework
  delete STRU MEM
  handle (41,66) (2,113) (2,113)
  endhandle

  !mdstemp = /MDS/$!alias/$!selection
  :mdscheck $!mdstemp.:mdscheck
  :mdsframirror $!mdstemp.:mdsframirror

  -- Position the MDS STRU
  --AT $!datum
  if (!datum.styp inset ('AT60')) then
    at p9 of $!datum
  else
    at $!datum
  endif

  NEW FRMW $!name/MAIN
  !frmwSupport = !!ce

  -- Copy required template/s Framework
  !!ce = /MDS/$!alias/$!selection
  !frmw = !!kCollectAllFor('FRMW', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')
  !desc = desc
  !struDesc = desc of /MDS/$!alias/$!selection
  !mdsbars = :mdsbars

  -- Navigate back to support and create template elements
  !!ce = !frmwSupport
  COPY ATTRIB OF $!frmw[1]
  COPY MEM OF $!frmw[1] RENAME $!frameFormat $!name

  -- Cap
  !!ce = /MDS/$!alias/$!selection
  !frmw = !!kCollectAllFor('FRMW', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')
  !subs = !!kCollectAllFor('SUBS', '', !!ce)

  -- Navigate back to support and create template elements
  !!ce = !stru
  do !i indices !subs
    NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
    COPY MEM OF $!subs[$!i] RENAME $!frameFormat $!name
  enddo
  $!name/SUBS1
  handle ANY
  endhandle

  -- If dims set different from default just set them
  if (!method2 eq 'RESIZE') then
    -- If the size of section has changed get the min plate sizes for that section
    !!mdsFt48.dim2.val = ( xlen of box 1 of $!subs[1] )
    handle ANY
    elsehandle none
      !!mdsFt48.dim3.val = ( zlen of box 1 of $!subs[1] )
    endhandle
  elseif (!method eq 'DIMSET') then
  endif

  !desc = desc of /MDS/TEMPLATES
  handle ANY
    !desc = ''
  endhandle
  if !desc.eq('Zimmer Templates') then
  else
    BOX1
    XLEN $!!mdsFt48.dim2.val
    YLEN $!!mdsFt48.dim2.val
    ZLEN $!!mdsFt48.dim3.val
  endif



  -- Get direction of P9 of datum atta and dist between p9 and p0
  !!ce = !stru

  -- Set stru description for template recognition
  -- if initec then select the template stru definition and not the template definition
  --<rm>dec2005
  if (!desc eq 'Initec Industrial Templates') then
    desc '$!struDesc'
  else
    desc '$!desc'
  endif
  :mdsbars $!mdsbars
  --<wd>dec2004
  MOVE $!ddir THRO P9 OF $!datum
  --<wd>dec2004

  -------------------------------------------------
  --<wd>dec2004
  if !datum.:mdsguideref.set() and !datum.:mdsguideref.badref().not() then
    !mdsGuideRef = !datum.:mdsguideref
    -- Only Move the STRU if the GUIDE is NOT on a TRUNNION Branch
    if (!datum.catref.owner.:mdstrun.not()) then
      MOVE $!ddir THRO P9 OF $!mdsGuideRef
    endif
  endif

  -- Calculate the MDS STRU orientation for Vertical, Sloping and True Horizontal Pipes
  !directions = !!mdsremovegrad(!datum)
  !support.datumorthdirs = !directions
  !orix = !directions[6]
  !oriz = !directions[3]

  -- Orientate Structure of MDS Support
  ori x is $!orix and z is $!oriz
  --<wd>dec2004
  -------------------------------------------------


  if !desc.eq('Zimmer Templates') then
    if (!support.rotatecur)then
      !orix = !directions[1]
    else
      !orix = !directions[6]
      -- q var !orix
    endif
  endif

  -------------------------------------------------
  --<wd>dec2004
$(
  MOVE $!ddir THRO P9 OF $!datum
  !orix = !support.p11Dir
  !oriz = !udir

  -- Orientate Structure of MDS Support
  ORI X IS $!orix AND Z IS $!oriz
$)
  --<wd>dec2004
  -------------------------------------------------

  ori x is $!orix and z is $!oriz

  -- If a trunnion is added to a support then we need to store the direction in a uda for later use
  var !oriFrame dir y wrt /*
  :MdsFrameDir $!oriFrame

  -- Set dimensions
  if (!method eq |CURSOR|)then
    ------------ *** Connexion Warnings *** -------------
    !errorMessage = STRING()
    !dummyS       = ''
    if(!!kErrorsForConns(!form, !errorMessage,!dummyS).eq('UNJOINTED')) then
      -- nothing to do
    elseif(!!kErrorsForConns(!form, !errorMessage,!dummyS).eq('WARNING')) then
      !continue = !!alert.confirm(!errorMessage)
      if(!continue.eq('NO')) then
        !!kRestoreUnits(!currentUnits)
        return
      endif
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('ERROR')) then
      !!alert.error(!errorMessage)
      !!kRestoreUnits(!currentUnits)
      return
    else
      -- leave in case
    endif
    ---------------------------------------------
    -- Dimension 1
    !dim1 = !!kStrReal('CONST DIST PIN 8 TO PIN 7')
    !!mdsFt48.dim1.val = !dim1
  endif

  -- Extend Vertical leg
  !!ce = $!<name>-V1
  EXTEND START THRO PIN 7
  PIN 8 plane PIN 8 CLEAR 0 BEH box 1 of $!<name>/SUBS1
  handle ANY
  endhandle
  EXTEND END THRO PIN 8

  ------------------****** connexions *******----------------------(
  if(!support.connections.unset()) then
    -- dimensions are being used first
    :MDSConn default
  else
    !vertical1 = !!ce
    !connected = !!mdsGetBeamConn(!support,!vertical1)
    :MDSConn $!connected
    handle ANY
    endhandle
  endif
  --------------------*******************--------------------------

  -- Select correct spref
  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  --!capCode = !!kNumberLetter(!cap.real())
  SEL SPREF WITH STYP '$!alias-$!selection' SPEC /MDF
  !!mdsSetSuppCode('MODIFY',!name,'FT48','$!alias-$!selection')

  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)
  !!mdsDacControl(TRUE)
  !!ce = !stru

  -------------------------------------------------
  --<wd>dec2004
  -- The code below for the rotate "do loop" is NOT required any more,
  -- as the STRU is now correctly orientated above at line 357 approx. i.e.
  -- Orientate Structure of MDS Support
  --    ori x is $!orix and z is $!oriz
$(
  -- Rotate support
  !times = !!mdsFt48.support.rotated / 90
  do from 1 to !times
    call !!mdsRotateFT48()
  enddo
$)
  --<wd>dec2004
  -------------------------------------------------

  -- Adjust for slope on horizontal lines only
  -- Check to see if the line is sloping (Datum atta only)
  !!ce = !datum
  --  skip if !!ce.:mdsrotdir.east.set()
  !grad = pl grad

  -- Vertical Pipes DO NOT need this CHECK and/or ADJUSTMENT etc...
  -- Identified Pipe is a Horizontal or Sloping Horizontal Pipe
  !adjust = 0
  --<wd>dec2004

  if (not !directions[1].string() inset ('D WRT /*', 'U WRT /*', '-Z WRT /*', 'Z WRT /*')) then
    --<wd>dec2004

    if (!grad.neq(0))then
      --<wd>dec2004
      if (!!ce.pDir[9].wrt(/* ).east.abs().eq(1)) then
        !adjust = 0
      elseif (!!ce.pDir[9].wrt(/* ).up.eq(0)) then
        !adjust = 0
      else
        --<wd>dec2004

        !strucElement = ARRAY()
        !unusedref = box 1 of $!<name>/SUBS1
        handle NONE
          --!strucElement.append(!ref)
          --!adjust = !!mdsAdjustSlope(!strucElement, !datum)

          !vleg   = $!name-V1
          !strucElement.append(!vleg)
          !vlegh  = !!mdsAdjustSlope(!strucElement, !datum)
          !adjust = !vlegh

        elsehandle ANY
          !adjust = 0
        endhandle
        --<wd>dec2004
      endif
      --<wd>dec2004

    else
      !adjust = 0
    endif
  endif

  -- Adjust required elements
  if (!adjust.gt(0))then
    !!ce = $!<name>/SUBS1
    --<wd>dec2004
    handle NONE
      --MOVE D WRT WORLD DIST $!adjust
      MOVE $!directions[3] DIST $!adjust
      --<wd>dec2004

      !!ce = $!<name>-V1
      --<wd>dec2004
      pin 8 dir $!directions[3]
      --<wd>dec2004
      PIN 8 plane PIN 8 CLEAR 0 BEH $!<name>/SUBS1
      EXTEND END THRO PIN 8
    elsehandle ANY
    endhandle
  endif

  --<wd>dec2004
  -- Extra Code required to move the Cap Plate SUBS by its plate thickness in the orthogonal P9 direction,
  -- for all Horizontal/Sloping pipes and  vertical pipes.
  -- The END of the SCTN vertical leg then needs adjusting the same amount.

  -- NOT REQUIRED-->   if ((!datum.pDir[9].wrt(/* ).up.eq(0)) or (!datum.pDir[9].wrt(/* ).up.abs().eq(1))) then
  !!ce = /MDS/$!alias/$!selection-SUBS1
  handle ANY
  elsehandle none
    !defpzlen = zlen of box 1
  endhandle

  !!ce = $!<name>/SUBS1
  handle NONE
    !platezlen = zlen of box 1
    subs
    if (!alias inset ('FT48A', 'FT48C')) then
      --$P TYPE --> !alias =>>>= $!alias
      move $!directions[3] dist $!platezlen
      !!ce = $!<name>-V1
      pin 8 dir $!directions[3]
      pin 8 plane pin 8 clear 0 beh $!<name>/SUBS1
      extend end thro pin 8
    elseif (!alias inset ('FT48B', 'FT48D')) then
      --$P TYPE --> !alias =>>>= $!alias
      if !desc eq 'Initec Industrial Templates' then
        if (!!mdsFt48.dim3.val lt !defpzlen) then
          -- move the subs up by half the difference between the original plate thickness and the new one
          !dist = !defpzlen - !!mdsFt48.dim3.val
          !adjdist = !dist / 2
          move $!directions[1] dist $!adjdist

          -- now move the stabilizer fins up
          do !i from 1 to 4 by 1
            !boxnum = !i + 1
            box $!boxnum
            move u wrt box 1 dist $!adjdist
          enddo
        elseif (!!mdsFt48.dim3.val gt !defpzlen) then
          -- move the subs down by half the difference between the original plate thickness and the new one
          !dist = !!mdsFt48.dim3.val - !defpzlen
          !adjdist = !dist / 2
          move $!directions[3] dist $!adjdist

          -- now move the stabilizer fins down
          do !i from 1 to 4 by 1
            !boxnum = !i + 1
            box $!boxnum
            move d wrt box 1 dist $!adjdist
          enddo
        endif
      endif
      subs
      pin 10 at p9 of $!datum
      pin 10 dir $!directions[5]
      rotate through ce about pin 10 by 180
      !!ce = $!<name>-V1
      pin 8 dir $!directions[3]
      pin 8 plane pin 8 clear 0 beh box 1 of $!<name>/SUBS1
      extend end thro pin 8

    endif
  elsehandle ANY
  endhandle

  -- NOT REQUIRED-->   endif
  --<wd>dec2004

  !!ce = $!<name>-V1
  -- Set atta references
  :MDSAttaRef $!<name>/DATUM
  !support.barLen[1] = deri length of CE
  !pose = POSE WRT WORLD
  !poss = POSS WRT WORLD

  !!ce = !stru
  -- Store dimensions in design parameters
  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  if !desc.eq('Zimmer Templates') then
    !!ce = $!<name>/SUBS2
    handle NONE
      !platezlen = zlen of box 1
      frmw 1
      sctn 1
      extend start -$!platezlen
      !poss = poss wrt /*
      !pose = pose wrt /*
      var !dir const direction $!poss to $!pose
      var !dist const dist $!poss to $!pose
      !!ce = $!<name>/SUBS2
      move $!dir dist $!dist
      move $!dir dist $!platezlen
      move $!dir dist $!platezlen
    elsehandle ANY
    endhandle
  else
    DESPAR $!!mdsFt48.dim1.val $!!mdsFt48.dim2.val $!!mdsFt48.dim3.val $!pose.up $!poss.up
    !!mdsDacControl(true)
    -- Check if ATTAS Created on The Support are Within the Allowable Bores for the STRUCTURE SCTN SIZES.
    !cecomp = !!ce
    !error  = STRING()
    if (!!mdscheckbores(!form,!selection,!error,!currentUnits)) then
      !!alert.error(!error)
      !!ce = !stru
      --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
      !!mdsRemoveAutoPadRules(!stru)
      --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end
      delete STRU MEM
      handle (41,66) (2,113) (2,113)
      endhandle
      -- Reset SREF Despars to ZERO as the STRU MEM have been DELETED
      !!ce = $!<name>/SREF
      handle none
        -- Only RESET the DESPARS for the DIMENSION GADGETS -
        -- DESPAR num 4 stores the LARGEST PIPE BORE SIZE on the SUPPORT and is still VALID
        desp num 1 0mm
        desp num 2 0mm
        desp num 3 0mm
      elsehandle any
      endhandle
      -- Reset all pins associated with this support
      !!mdsResetPins(1,9)
      !!ce = !cecomp
      handle any
      endhandle
      !!mdsCreateMess(false)
      !!kRestoreUnits(!currentUnits)
      return
    endif
  endif
  !!mdsDacControl(false)

  -- Reset materials of sections
  !!mdsResetMat(!storeMat)

  !!ce = !stru
  ----------------------***** connexions *****--------------------------
  if(!haveJoints) then
    do !index indices !joints

      if(!joints[!index].badref().not() and !attributes[!index][8].dbref().:MDSConn.eq(!joints[!index].owner.owner)) then
        !mainStl = !attributes[!index][8].dbref().:MDSConn
        !support.joints[!index] =  !!mdsCreateJoint(!mainStl, !attributes[!index][8].dbref(),!joints[!index],!attributes[!index])
      else
        !dummy = object DBREF()
        !dummyA = ARRAY()
        !mainStl = !support.connections[!index]
        !support.joints[!index] =  !!mdsCreateJoint(!mainStl, !attributes[!index][8].dbref(),!dummy,!dummyA)
      endif
    enddo
  endif
  ----------------------------------------------------------------------

  -- When an INTERNAL joint is being used and it is handed then their will be a alternative spref of the
  -- opposite hand joint and the bang to set separated by a ,

  !!mdsSwapIntJoi(!support.stru,!support.mirror,!support.alias)

  !!ce = !stru

  ----------------------------------------------------------------------

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.append(!!ce)
  !colourList.appendarray(!support.atta)
  !colourList.appendarray(!support.joints)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- Reset all pins associated with this support
  call !!mdsResetPins(1,10)

  -- reset :mdsancref attributes if set
  !support.plateconns.restoreconns()


  -- Update support data held in form
  !!mdsFt48.support = !support

  !!ce = !support.stru
  -- Copy welds locally
  !copyWelds = object MDSWELDLIST(!!ce,!form)

  if defined(!saveV1) then
    !saveV1.restoreplane(!!mdsFt48.dim1.val ,0)
  endif
  !!ce = !support.stru

  !!ce = !support.stru
  !!mdsCreateMess(false)

  -- Code for sloping decks
  if defined(!testCe[3]) then
    !!mdstrimplane($!name-V1 ,!support.mirror, !testCe[2],'start')

    -- we have trimmed the length of the vertical section to suit the panel
    -- now we need to reset the dimension
    !!mdsFt48.dim1.val = !!mdsgetoverdim($!datum , $!name-V1 ,0)
  endif
  -- Store dimensions in design parameters
  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  desp num 1 $!!mdsFt48.dim1.val
  !!mdsDacControl(false)

  !!ce = !support.stru

  -- Show dimensions on graphics if required
  if !!mdsFt48.graphicalDim then
    !!mdsshowdim(!!mdsFt48)
  endif

  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  --<wd>jun2007<mds12>
  -- Create the Cross Reference ASSOCIATIONS between the MDS SUPPORT SCTN members $!name-V1
  -- and the Main Structure supporting elements for:
  -- <a> CURSOR mode !pick
  --
  -- Store the Original Current Element
  !xce = !!ce

  -- Store the Array of MDS Support Members in the MDSASSOC Object
  !mdsassoc.mdsmember[1] = $!name-V1

  -- Initialising the MDSASSOWL object always DELETES ALL of the EXISTING Cross Reference Associations
  -- (ASSOC) elements for the Current MDS Support, irrespective of the Creation MODE (!method)
  !mdsassowl = object MDSASSOWL(!form)
  !mdsassowl.mdsform  = !form
  !mdsassowl.mdsassoc = !mdsassoc

  -- Create the Association (ASSOCs) for the Current Support
  !mdsassowl.mdsassoc(!mdsassoc)

  -- Update the FORM SUPPORT object to reference the current MDSASSOWL Associations object
  !form.support.associations[1] = !mdsassowl
  !support = !form.support

  -- Navigate back to the Original Current Element
  !!ce = !xce

  --<wd>jun2007<mds12>
  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------

  -- Add pads if automatic pads option is on and a PANE or HPLATE has been picked
  if !!mdsOptions.autopads.selection().eq('ON') then
    !whichVerticals = 'ALL'
    if !method.eq('CURSOR') or !method.eq('CLEARANCE') then
      if !pick.hardType.eq('PANE') or !pick.hardType.eq('HPLATE') then
        !!mdsaddpad(!support,!whichVerticals)
      endif
    elseif !method.eq('DIMENSION') and !padsExist then
      !!mdsaddpad(!support,!whichVerticals)
    endif
  endif

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- End function
endfunction
