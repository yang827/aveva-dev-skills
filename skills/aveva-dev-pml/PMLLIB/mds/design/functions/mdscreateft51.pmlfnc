--------------------------------------------------------------------------------
--
-- File:                mdscreateft51.pmlfnc
--   Type:              Function Definition
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            design
--   Replaces:          MPS131
--
-- Author:              t.martin
-- Created:             27/04/2005 16:24
-- Description:
-- function to create support frame type 51
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Method of creating support
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsCreateFT51(!method is STRING)

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()

  -- Initialise variables
  call !!mdsResetPins(1,9)

  --<wd>may2007<mds12>
  --    !iDType    = 'GENSEC SCTN SBFI PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX'
  !session   = current session
  if !session.module().upcase().match('DESIGN').gt(0) then
    !iDType    = 'GENSEC SCTN SBFI PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX'
  elseif  !session.module().upcase().match('OUTFITTING').gt(0) then
    !iDType    = 'GENSEC SCTN SBFI PANE FLOOR WALL GWALL STWALL SCREED CFLOOR CSCREED CWALL BOX HSTIFF HPLATE'
  endif
  --<wd>may2007<mds12>

  !support   = !!mdsFt51.support
  --!clearance = !!mdsOptions.clear.val
  !overlap   = !!mdsOptions.overlap.val
  !selection = !!mdsSetSteel.size.selection('Rtext')
  !datum     = !support.datum
  !stru      = !support.stru
  !name      = !stru.name
  !p10Dir    = !support.p10Dir
  !p11Dir    = !support.p11Dir
  !pLDir     = !support.pLDir
  !pADir     = !support.pADir
  !alias     = !support.alias

  --<k.pleschner>Jun06
  !datumDflts = object MDSANCGEOMDFLTS(!datum)
  !clearance = !datumDflts.cend
  --<k.pleschner>

  var !pjoiColl coll all pjoi with gtyp eq 'APAD' for $!stru
  if !pjoiColl.size().neq(0) then
    !padsExist = TRUE
  else
    !padsExist = FALSE
  endif

  -- Does the support have attached/Associated supports

  if !!mdsgetconnectedsupp(!stru) then
    !!kRestoreUnits(!currentUnits)
    return
  endif

  ----------------------------- **** connexions **** -----------------------------
  !refe         = !!ce
  !form      = !!mdsFt51

  --<wd>jun2007<mds12>
  -- Initialise the MDS Associations Data Creation Object MDSASSOC
  !mdsassoc = object MDSASSOC()
  !mdsassoc.mode = !method
  --<wd>jun2007<mds12>

  -- Can we write to the spref attribute of the SREF atta
  -- and the stru

  if !support.datum.badref().not() then
    !srefName = !support.datum.name.before('/DATUM') + '/SREF'
    if !!mdsComClaimDac(!support.stru,'DACMOD','POS').not() or !!mdsComClaimDac(!srefName.dbref(),'DACMOD','SPREF').not() then
      !despars = !srefName.dbref().despar
      !!mdsResetDims(!form,!despars)
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Unable to change the support as write access to the SREF atta is not available')
      return
    endif
  endif

  !haveJoints = FALSE
  if(!form.support.joints.unset().not()) then
    !joints     = !support.joints
    !attributes = ARRAY()
    !haveJoints = !!kRestoreJoints(!joints,!attributes,'SAVE','')
    handle ANY
      !haveJoints = FALSE
      !support.joints.clear()
      -- in case they have been deleted and cancel is used
    endhandle
  endif

  ---------------------------------------------------------------------------------


  -- Check that Datum atta has been created
  if (!datum.set().not())then
    !!alert.message('Datum support atta has not been created')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- Check that Datum atta has been positioned
  if (!support.position.not())then
    !!alert.message('Position atta before identifying supporting steelwork')
    !!kRestoreUnits(!currentUnits)
    return
  endif

  !noEquiv = false

  -- Evaluate replacement support name for frame type 09
  if (!alias eq 'FT51' or !alias eq 'FT37') then
    !substitute = trim (before (!!mdsFrame.standard.dtext[!!mdsFrame.standard.rtext.findfirst('FT09')], '-'))
    handle any
      !noEquiv = true
      !substitute = 'Identified element is unsuitable to support from'
    endhandle
  elseif (!alias eq 'CT04') then
    !substitute = trim (before (!!mdsCable.standard.dtext[!!mdsCable.standard.rtext.findfirst('CT05')], '-'))
    handle any
      !noEquiv = true
      !substitute = 'Identified element is unsuitable to support from'
    endhandle
  endif

  -- Check which attas to work from
  if (!support.bars.size().leq(1))then
    !atta = !support.atta
  else
    !atta = !support.bars[1]
  endif


  -- Always read the P9direction for the TRUE !ddir of the DATUM ATTA
  -- on HORIZONTAL and VERTICAL PIPES -- SLOPING PIPES need the TRUE ORTHOGONAL DIRECTIONS!!!!!!!!

  !ddir = !support.p9dir
  VAR !p3P9Dir CONST DIR P3 OF $!datum TO P9 OF $!datum
  !udir = !p3P9Dir.direction()

  --------------------------------------------------------------------------------
  -- Added 30sep2004 - Always read the P9direction for the TRUE !ddir of the DATUM ATTA
  -- on HORIZONTAL and VERTICAL PIPES -- SLOPING PIPES need the TRUE ORTHOGONAL DIRECTIONS!!!!!!!!
  ----------------------------------------------

  !directions = !!mdsremovegrad(!datum)
  !support.datumorthdirs = !directions
  !orixd = !directions[6]  $* was 5
  !orizd = !directions[4]
  ori x is $!orixd and z is $!orizd

  --------------------------------------------------------------------------------

  -- Store section name and matref for each member
  -- for resetting later

  !storeMat = ARRAY()
  !storeMat = !!mdsStoreMat(!name)
  -- Generate pin positions for each creation type

  if (!method eq |CURSOR|)then

    ------------ *** Connexion Warnings *** -------------

    !errorMessage = STRING()
    !dummyS       = ''

    if(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('UNJOINTED')) then
      -- nothing to do
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('WARNING')) then
      !continue = !!alert.confirm(!errorMessage)
      if(!continue.eq('NO')) then
        !!kRestoreUnits(!currentUnits)
        return
      endif
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('ERROR')) then
      !!alert.error(!errorMessage)
      !!kRestoreUnits(!currentUnits)
      return
    endif

    ---------------------------------------------

    label /Element1

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify first element to support from|
    ID $!iDType @
    handle (61,528)
      PROMPT ON
      !!ce = !stru
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    PROMPT DISMISS
    PROMPT ON
    !pick1 = !!ce

    label /Element2

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify second element to support from|
    ID $!iDType @
    handle (61,528)
      PROMPT ON
      !!ce = !stru
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
    PROMPT DISMISS
    PROMPT ON
    !pick2 = !!ce

    !!ce = !pick1

    if (!pick1 eq !pick2) then
      !!alert.message('Cannot hit the same element when creating by cursor. Please use create by clearance.')
      !!kRestoreUnits(!currentUnits)
      return
    endif

    !testCe = !!mdsRelToDatum(!datum, !pick1, !ddir, !clearance.real())
    !testCepick1 = !testCe $* Save the settings for pick1 as they are used later for sloping panels
    if (!testCe[1].upcase() eq 'UNSET')then
      !!alert.error('The first element identified is unsuitable to support from.')
      golabel /Element1
    elseif (!testCe[1].upcase() eq '')then
      golabel /Element1
    endif

    if (!pADir eq U or !pLDir eq U)then
      if (!testCe[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('The first element identified is behind pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'The first element identified is behind pipe.')
        endif
        golabel /Element1
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('The first element identified is in line with the datum atta')
        golabel /Element1
      endif
    else
      if (!testCe[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('The first element identified is above pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute)
          !!alert.error(!substitute + 'The first element identified is above pipe.')
        endif
        golabel /Element1
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('The first element identified is at the same elevation as the datum atta')
        golabel /Element1
      endif
    endif

    --<wd>may2007<mds12>
    --      if (!pick1.hardType eq 'PANE' or !pick1.type eq 'BOX' or !pick1.type.eq('SBFI') )then
    if (!pick1.hardType eq 'PANE' or !pick1.type eq 'BOX' or !pick1.type.eq('SBFI') or !pick1.type eq 'HPLATE')then
      --<wd>may2007<mds12>

      !plane1 = !testCe[2]
      VAR !pDir1 CONST DIR $!plane1
    endif

    !!ce = !pick2

    !testCe = !!mdsRelToDatum(!datum, !pick2, !ddir, !clearance.real())
    !testCepick2 = !testCe $* Save the settings for pick1 as they are used later for sloping panels
    if (!testCe[1].upcase() eq 'UNSET')then
      !!alert.error('The second element identified is unsuitable to support from.')
      golabel /Element2
    elseif (!testCe[1].upcase() eq '')then
      golabel /Element2
    endif
    if (!pADir eq U or !pLDir eq U)then
      if (!testCe[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('The second element identified is behind pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'The second element identified is behind pipe.')
        endif
        golabel /Element2
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('The second element identified is in line with the datum atta')
        golabel /Element2
      endif
    else
      if (!testCe[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('The second element identified is above pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'The second element identified is above pipe.')
        endif
        golabel /Element2
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('The second element identified is at the same elevation as the datum atta')
        golabel /Element2
      endif
    endif

    --<wd>may2007<mds12>
    --    if (!pick2.hardType eq 'PANE' or !pick2.type eq 'BOX' or !pick2.type.eq('SBFI') )then
    if (!pick2.hardType eq 'PANE' or !pick2.type eq 'BOX' or !pick2.type.eq('SBFI') or !pick2.type.eq('HPLATE'))then
      --<wd>may2007<mds12>

      !plane2 = !testCe[2]
      VAR !pDir2 CONST DIR $!plane2
    endif

    -- If the first element is a panel and the second a section then reverse the elements
    -- so the section is always the first, this stops the error message
    -- 'Second Element picked will leave the datum atta off the supporting framework'

    --<wd>may2007<mds12>
    --   if !pick1.hardType.eq('PANE') and !pick2.hardType.eq('SCTN') then
    if !pick1.hardType.eq('PANE') and !pick2.hardType.eq('SCTN') or !pick1.hardType.eq('HPLATE') and !pick2.hardType.eq('HSTIFF')then
      --<wd>may2007<mds12>

      !tempPick1 = !pick1
      !tempPick2 = !pick2
      !pick1 = !tempPick2
      !pick2 = !tempPick1
      !tempTestcepick1 = !testCepick1
      !tempTestcepick2 = !testCepick2
      !testCepick1 = !tempTestcepick2
      !testCepick2 = !tempTestcepick1
      !plane2 = !plane1
      !plane1.delete()
    endif

    !!mdsCreateMess(true)

    -- Position Pins

    !!ce = !pick1

    -- Check to see if first item picked is a bedplate

    --<wd>may2007<mds12>
    --      if (!pick1.hardType eq 'PANE' or !pick1.type eq 'BOX' or !pick1.type.eq('SBFI') )then
    if (!pick1.hardType eq 'PANE' or !pick1.type eq 'BOX' or !pick1.type.eq('SBFI') or !pick1.type.eq('HPLATE'))then
      --      STRU
      --      !type = !!ce.:MDSSuppType
      STRU
      handle NONE
        !type = !!ce.:MDSSuppType
      elsehandle ANY
        !type = ''
      endhandle
      --<wd>may2007<mds12>

      if (!type eq 'FT22')then
        !bedplate = true
        PIN 1 AT $!pick1
        PIN 1 DIR $!pDir1
        VAR !tempInter CONS POS INT PIN 1 $!plane1
        !inter = !tempInter.position()
      elseif !pick1.type.eq('SBFI') then
        PIN 1 AT P1 of $!pick1
        PIN 1 DIR $!pDir1
        VAR !tempInter CONS POS INT PIN 1 $!plane1
        !inter = !tempInter.position()
        VAR !pin1Up PIN 1 U
        if (!pin1Up.real().gt(!datum.pos.up))then
          !!mdsCreateMess(false)
          !!alert.error('Identified anchor plate is below pipe')
          PIN 1 OFF
          !!kRestoreUnits(!currentUnits)
          return
        endif
      else
        -- Position pins clear of attas
        PIN 1 AT P0 of $!datum
        PIN 1 DIR $!p10Dir
        PIN 2 COPY PIN 1
        !dim = 0
        --<k.pleschner>Jun06
        --do !i values !support.atta
        do !iref values !support.atta
          -- avoid SREF atta
          skip if !iref.name.substring(-1,-5).eq('/SREF')
          !i = object MDSANCGEOMDFLTS(!iref)

          --PIN 2 plane PIN 2 CLEAR $!clearance BEH $!i
          if !i.clge.eq('GEOM') then
            -- use clearance from geometry
            PIN 2 plane PIN 2 CLEAR $!i.cend BEH $!i
          else
            -- use distance from centreline
            PIN 2 plane PIN 2 THR $!i
            PIN 2 plane PIN 2 DIST $!i.cend
          endif
          handle (2,109)
            break
          endhandle
          VAR !cDIR CONST DIR PIN 1 TO PIN 2
          !cdim = !!kStrReal('CONST DIST PIN 1 TO PIN 2')

          -- Set object definition
          !direction = object KEQUALDIR()
          !direction.directionA = !cDIR.direction()
          !direction.directionB = !p10Dir
          !direction.tolerance  = 0.05

          if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
            PIN 2 AT $!datum
            PIN 2 DIST $!cdim
            !dim = !cdim
          else
            PIN 2 AT $!datum
            PIN 2 DIST $!dim
          endif
        enddo
        PIN 1 COPY PIN 2
        PIN 1 DIR $!ddir
        VAR !tempInter CONS POS INT PIN 1 $!plane1
        !inter = !tempInter.position()
      endif

      --<wd>may2007<mds12>
      --      elseif (!pick1.type eq 'SCTN' or !pick1.hardType eq 'GENSEC')then
    elseif (!pick1.type eq 'SCTN' or !pick1.hardType eq 'GENSEC' or !pick1.type eq 'HSTIFF')then
      --<wd>may2007<mds12>

      -- ************************ Connexions ***********************
      !support.connections[1] = !pick1
      !support.connections[2] = !pick2
      -- !!mdsFt51.lineUp.active = False

      !start = plstart NA wrt world
      !end   = plend NA wrt world
      var !lineA CONS line JOIN $!start to $!end
      var !lineB CONS line P10 of $!datum
      var !tempInter CONS POS INT $!lineA $!lineB
      !inter = !tempInter.position()

      if (!inter.unset())then
        !!mdsCreateMess(false)
        !!alert.error('Unable to create support from first identified section using this method. Use clearance or dimensions')
        call !!mdsResetPins(1,9)
        !!kRestoreUnits(!currentUnits)
        return
      endif
      PIN 1 AT $!inter
      PIN 1 DIR $!ddir
      PIN 1 plane PIN 1 THRO P9 OF $!datum
      VAR !pin1Pos PIN 1 POS WRT WORLD
      !inter = !!kFlangeOrWeb(!pick1, !pin1Pos.position(), !ddir)
    endif

    --<wd>jun2007<mds12>
    -- Save !pick1 and !inter intersection position for Associations
    !mdsassoc.pick1      = !pick1
    !mdsassoc.pick1inter = !inter
    --<wd>jun2007<mds12>

    PIN 9 AT $!inter
    PIN 9 DIR $!udir

    -- Test position of pin 9 relative to datum so that dimensions are correct
    PIN 1 copy P10 of $!datum
    PIN 1 plane PIN 1 thro PIN 9
    var !testDir CONS DIR P10 of $!datum to PIN 1

    -- Set object definition
    !direction = object KEQUALDIR()
    !direction.directionA = !testDir.direction()
    !direction.directionB = !p10Dir
    !direction.tolerance  = 0.05

    -- Check directions
    if (!!kDirEqualDir(!direction)) then
      -- First upright is on the correct side of the support
      !vertLeg = True
      PIN 7 COPY P10 OF $!datum
      PIN 7 plane PIN 7 THRO PIN 9
      PIN 7 DIR $!udir
      PIN 7 plane PIN 7 THRO PIN 9
      PIN 9 COPY PIN 7
      PIN 9 plane PIN 9 THRO P9 OF $!datum
      !tempDim = !!kStrReal('CONST DIST PIN 7 TO PIN 9')
      !!mdsFt51.dim3.val = !tempDim

      !!ce = !pick2

      -- Check to see if second item picked is a bedplate

      --<wd>may2007<mds12>
      --        if (!pick2.hardType eq 'PANE' or !pick2.type eq 'BOX' or !pick2.type.eq('SBFI') )then
      if (!pick2.hardType eq 'PANE' or !pick2.type eq 'BOX' or !pick2.type.eq('SBFI') or !pick2.type.eq('HPLATE') )then
        --          STRU
        --          !type = !!ce.:MDSSuppType
        STRU
        handle NONE
          !type = !!ce.:MDSSuppType
        elsehandle ANY
          !type = ''
        endhandle
        --<wd>may2007<mds12>

        if (!type eq 'FT22')then
          !bedplate = true
          PIN 1 AT $!pick2
          PIN 1 DIR $!pDir2
          VAR !tempInter CONS POS INT PIN 1 $!plane2
          !inter = !tempInter.position()
        elseif !pick2.type.eq('SBFI') then
          PIN 1 AT P1 of $!pick2
          PIN 1 DIR $!pDir2
          VAR !tempInter CONS POS INT PIN 1 $!plane2
          !inter = !tempInter.position()
          VAR !pin1Up PIN 1 U
          if (!pin1Up.real().gt(!datum.pos.up))then
            !!mdsCreateMess(false)
            !!alert.error('Identified anchor plate is below pipe')
            PIN 1 OFF
            !!kRestoreUnits(!currentUnits)
            return
          endif
        else
          -- Position pins clear of datum atta
          PIN 1 AT P0 of $!datum
          PIN 1 DIR $!p11Dir
          PIN 2 COPY PIN 1
          !dim = 0
          --<k.pleschner>Jun06
          --do !i values !support.atta
          do !iref values !support.atta
            -- avoid SREF atta
            skip if !iref.name.substring(-1,-5).eq('/SREF')
            !i = object MDSANCGEOMDFLTS(!iref)

            --PIN 2 plane PIN 2 CLEAR $!clearance BEH $!i
            if !i.clge.eq('GEOM') then
              -- use clearance from geometry
              PIN 2 plane PIN 2 CLEAR $!i.cend BEH $!i
            else
              -- use distance from centreline
              PIN 2 plane PIN 2 THR $!i
              PIN 2 plane PIN 2 DIST $!i.cend
            endif
            handle (2,109)
              break
            endhandle
            VAR !cDIR CONST DIR PIN 1 TO PIN 2
            !cdim = !!kStrReal('CONST DIST PIN 1 TO PIN 2')

            -- Set object definition
            !direction = object KEQUALDIR()
            !direction.directionA = !cDIR.direction()
            !direction.directionB = !p11Dir
            !direction.tolerance  = 0.05

            if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
              PIN 2 AT $!datum
              PIN 2 DIST $!cdim
              !dim = !cdim
            else
              PIN 2 AT $!datum
              PIN 2 DIST $!dim
            endif
          enddo
          PIN 1 COPY PIN 2
          PIN 1 DIR $!ddir
          VAR !tempInter CONS POS INT PIN 1 $!plane2
          !inter = !tempInter.position()
        endif

        --<wd>may2007<mds12>
        --        elseif (!pick2.type eq 'SCTN' or !pick2.hardType eq 'GENSEC')then
      elseif (!pick2.type eq 'SCTN' or !pick2.hardType eq 'GENSEC' or !pick2.type eq 'HSTIFF')then
        --<wd>may2007<mds12>

        !start = plstart NA wrt world
        !end   = plend NA wrt world
        var !lineA CONS line JOIN $!start to $!end
        var !lineB CONS line P10 of $!datum
        var !tempInter CONS POS INT $!lineA $!lineB
        !inter = !tempInter.position()

        if (!inter.unset())then
          !!mdsCreateMess(false)
          !!alert.error('Unable to create support from second identified section using this method. Use clearance or dimensions')
          !!kRestoreUnits(!currentUnits)
          call !!mdsResetPins(1,9)
          return
        endif
        PIN 1 AT $!inter
        PIN 1 DIR $!ddir
        PIN 1 plane PIN 1 THRO P9 OF $!datum
        VAR !pin1Pos PIN 1 POS WRT WORLD
        !inter = !!kFlangeOrWeb(!pick2, !pin1Pos.position(), !ddir)
      endif

      --<wd>jun2007<mds12>
      -- Save !pick2 and !inter intersection position for Associations
      !mdsassoc.pick2      = !pick2
      !mdsassoc.pick2inter = !inter
      --<wd>jun2007<mds12>

      PIN 8 AT $!inter
      PIN 8 DIR $!udir

      -- Test position of pin 8 relative to datum to see if its on the correct side
      PIN 1 copy P11 of $!datum
      PIN 1 plane PIN 1 thro PIN 8
      var !testDir CONS DIR P11 of $!datum to PIN 1

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !testDir.direction()
      !direction.directionB = !p11Dir
      !direction.tolerance  = 0.05

      -- Check directions
      if (!!kDirEqualDir(!direction)) then
        PIN 6 COPY P11 OF $!datum
        PIN 6 plane PIN 6 THRO PIN 8
        PIN 6 DIR $!udir
        PIN 6 plane PIN 6 THRO PIN 8
        PIN 8 COPY PIN 6
        PIN 8 plane PIN 8 THRO P9 OF $!datum
        !tempDim = !!kStrReal('CONST DIST PIN 6 TO PIN 8')
        !!mdsFt51.dim4.val = !tempDim
      else
        !!mdsCreateMess(false)
        -- Reset all pins associated with this support
        call !!mdsResetPins(1,9)
        !!kRestoreUnits(!currentUnits)
        !!alert.error('Second Element picked will leave the datum atta off the supporting framework')
        return
      endif

    else
      !vertLeg = False

      PIN 8 COPY PIN 9
      PIN 6 COPY PIN 8
      PIN 6 DIR $!udir
      PIN 8 plane PIN 8 THRO P9 OF $!datum
      !tempDim = !!kStrReal('CONST DIST PIN 6 TO PIN 8')
      !!mdsFt51.dim4.val = !tempDim

      !!ce = !pick2

      -- Check to see if second item picked is a bedplate

      --<wd>may2007<mds12>
      --        if (!pick2.hardType eq 'PANE' or !pick2.type eq 'BOX' or !pick2.type.eq('SBFI') )then
      if (!pick2.hardType eq 'PANE' or !pick2.type eq 'BOX' or !pick2.type.eq('SBFI')  or !pick2.type.eq('HPLATE') )then
        --          STRU
        --          !type = !!ce.:MDSSuppType
        STRU
        handle NONE
          !type = !!ce.:MDSSuppType
        elsehandle ANY
          !type = ''
        endhandle
        --<wd>may2007<mds12>

        if (!type eq 'FT22')then
          !bedplate = true
          PIN 1 AT $!pick2
          PIN 1 DIR $!pDir2
          VAR !tempInter CONS POS INT PIN 1 $!plane2
          !inter = !tempInter.position()
        elseif !pick2.type.eq('SBFI') then
          PIN 1 AT P1 of $!pick2
          PIN 1 DIR $!pDir2
          VAR !tempInter CONS POS INT PIN 1 $!plane2
          !inter = !tempInter.position()
          VAR !pin1Up PIN 1 U
          if (!pin1Up.real().gt(!datum.pos.up))then
            !!mdsCreateMess(false)
            !!alert.error('Identified anchor plate is below pipe')
            PIN 1 OFF
            !!kRestoreUnits(!currentUnits)
            return
          endif
        else
          -- Position pins clear of datum atta
          PIN 1 AT P0 of $!datum
          PIN 1 DIR $!p10Dir
          PIN 2 COPY PIN 1
          !dim = 0
          --<k.pleschner>Jun06
          --do !i values !support.atta
          do !iref values !support.atta
            -- avoid SREF atta
            skip if !iref.name.substring(-1,-5).eq('/SREF')
            !i = object MDSANCGEOMDFLTS(!iref)

            --PIN 2 plane PIN 2 CLEAR $!clearance BEH $!i
            if !i.clge.eq('GEOM') then
              -- use clearance from geometry
              PIN 2 plane PIN 2 CLEAR $!i.cend BEH $!i
            else
              -- use distance from centreline
              PIN 2 plane PIN 2 THR $!i
              PIN 2 plane PIN 2 DIST $!i.cend
            endif
            handle (2,109)
              break
            endhandle
            VAR !cDIR CONST DIR PIN 1 TO PIN 2
            !cdim = !!kStrReal('CONST DIST PIN 1 TO PIN 2')

            -- Set object definition
            !direction = object KEQUALDIR()
            !direction.directionA = !cDIR.direction()
            !direction.directionB = !p10Dir
            !direction.tolerance  = 0.05

            if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
              PIN 2 AT $!datum
              PIN 2 DIST $!cdim
              !dim = !cdim
            else
              PIN 2 AT $!datum
              PIN 2 DIST $!dim
            endif
          enddo
          PIN 1 COPY PIN 2
          PIN 1 DIR $!ddir
          VAR !tempInter CONS POS INT PIN 1 $!plane2
          !inter = !tempInter.position()
        endif

        --<wd>may2007<mds12>
        --        elseif (!pick2.type eq 'SCTN' or !pick2.type eq 'GENSEC')then
      elseif (!pick2.type eq 'SCTN' or !pick2.type eq 'GENSEC' or !pick2.type eq 'HSTIFF')then
        --<wd>may2007<mds12>

        !start = plstart NA wrt world
        !end   = plend NA wrt world
        var !lineA CONS line JOIN $!start to $!end
        var !lineB CONS line P10 of $!datum
        var !tempInter CONS POS INT $!lineA $!lineB
        !inter = !tempInter.position()
        if (!inter.unset())then
          !!mdsCreateMess(false)
          !!alert.error('Unable to create support from second identified section using this method. Use clearance or dimensions')

          -- Reset all pins associated with this support
          call !!mdsResetPins(1,9)
          !!kRestoreUnits(!currentUnits)
          return
        endif
        PIN 1 AT $!inter
        PIN 1 DIR $!ddir
        PIN 1 plane PIN 1 THRO P9 OF $!datum
        VAR !pin1Pos PIN 1 POS WRT WORLD
        !inter = !!kFlangeOrWeb(!pick2, !pin1Pos.position(), !ddir)
      endif

      --<wd>jun2007<mds12>
      -- Save !pick2 and !inter intersection position for Associations
      !mdsassoc.pick2      = !pick2
      !mdsassoc.pick2inter = !inter
      --<wd>jun2007<mds12>

      PIN 9 AT $!inter
      PIN 9 DIR $!udir

      -- Test position of pin 9 relative to datum to see if its on the correct side
      PIN 1 copy P10 of $!datum
      PIN 1 plane PIN 1 thro PIN 9
      var !testDir CONS DIR P10 of $!datum to PIN 1

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !testDir.direction()
      !direction.directionB = !p10Dir
      !direction.tolerance  = 0.05

      -- Check directions
      if (!!kDirEqualDir(!direction)) then
        -- First vertical rod is on the correct side of the support
        PIN 7 COPY P10 OF $!datum
        PIN 7 plane PIN 7 THRO PIN 9
        PIN 7 DIR $!udir
        PIN 7 plane PIN 7 THRO PIN 9
        PIN 9 COPY PIN 7
        PIN 9 plane PIN 9 THRO P9 OF $!datum
        !tempDim = !!kStrReal('CONST DIST PIN 7 TO PIN 9')
        !!mdsFt51.dim3.val = !tempDim
      else
        !!mdsCreateMess(false)
        -- Reset all pins associated with this support
        call !!mdsResetPins(1,9)
        !!kRestoreUnits(!currentUnits)
        !!alert.error('Second Element picked will leave the datum atta off the supporting framework')
        return
      endif
    endif

    --------------------------
    --> Code Added to ENSURE Pins 6.7,8,9 are in CORRECT Alignment
    --> when creating by CURSOR
    !datumplanedir = !!kcalcorthdir(!support.datum)
    pin 6 dir $!datumplanedir
    pin 6 plane pin 6 thro $!support.datum
    pin 8 dir $!datumplanedir
    pin 8 plane pin 8 thro $!support.datum
    pin 7 dir $!datumplanedir
    pin 7 plane pin 7 thro $!support.datum
    pin 9 dir $!datumplanedir
    pin 9 plane pin 9 thro $!support.datum
    --------------------------

    PIN 9 DIR FROM PIN 8 TO PIN 9
    PIN 8 DIR FROM PIN 9 TO PIN 8

  elseif (!method eq |DIMENSION|)then

    -- Initialise variables for dimension check
    !d1 = !!mdsFt51.dim1.val
    !d2 = !!mdsFt51.dim2.val
    !d3 = !!mdsFt51.dim3.val
    !d4 = !!mdsFt51.dim4.val
    -- not necessary for dim 5 and 6 as they can be zero anyway
    if (!d1.eq(0) or !d2.eq(0) or !d3.eq(0) or !d4.eq(0)) then
      !!alert.error('Not all of the dimensions have been completed.')
      !!kRestoreUnits(!currentUnits)
      call !!mdsResetPins(1,9)
      return
    endif

    --<BC>Apr2005
    --Check to see if V1 exists and save the end and start directions for sloping decks
    -- because we are building by dimension, we need to save the plane of the ends
    -- mdssaveends stores the end to trim !farend and the method used by mdsoverdi
    !!ce = $!<name>-V1
    handle(2,109)
    elsehandle NONE
      if (!support.mirror) then
        !farend = 1
      else
        !farend = 0
      endif
      !saveV1 = object MDSSAVEENDS(!!ce,!datum,!farend)
    endhandle
    !!ce = $!<name>-V2
    handle(2,109)
    elsehandle NONE
      if (!support.mirror) then
        !farend = 1
      else
        !farend = 0
      endif
      !saveV2 = object MDSSAVEENDS(!!ce,!datum,!farend)
    endhandle

    !!mdsCreateMess(true)

    -- Position pins

    !!ce = !datum
    PIN 9 COPY P9
    PIN 9 DIR $!p10Dir
    PIN 8 COPY PIN9
    PIN 8 DIR $!p11Dir

    PIN 9 plane PIN 9 THRO CE
    PIN 8 plane PIN 8 THRO CE
    PIN 9 DIST $!d2
    PIN 9 DIR $!ddir
    PIN 7 COPY PIN 9
    PIN 7 DIST $!d3
    PIN 7 DIR $!udir
    PIN 8 DIST ($!d1 - $!d2)
    PIN 8 DIR $!ddir
    PIN 6 COPY PIN 8
    PIN 6 DIST $!d4
    PIN 6 DIR $!udir

    PIN 9 DIR FROM PIN 8 TO PIN 9
    PIN 8 DIR FROM PIN 9 TO PIN 8

    -- at this point pin 6 and 7 are at the base of the structure on the desired outside
    -- pin 8 and 9 are at the extent of the dimensions

  elseif (!method eq |CLEARANCE|)then
    ------------ *** Connexion Warnings *** -------------

    !errorMessage = STRING()
    !dummyS       = ''

    if(!!kErrorsForConns(!form, !errorMessage,!dummyS).eq('UNJOINTED')) then
      -- nothing to do
    elseif(!!kErrorsForConns(!form, !errorMessage,!dummyS).eq('WARNING')) then
      !continue = !!alert.confirm(!errorMessage)
      if(!continue.eq('NO')) then
        call !!mdsResetPins(1,9)
        !!kRestoreUnits(!currentUnits)
        return
      endif
    elseif(!!kErrorsForConns(!form, !errorMessage, !dummyS).eq('ERROR')) then
      !!alert.error(!errorMessage)
      call !!mdsResetPins(1,9)
      !!kRestoreUnits(!currentUnits)
      return
    else
      -- leave in case
    endif

    ---------------------------------------------


    label /Element3

    PROMPT OFF
    PROMPT LOAD ESCAPE |Identify element to support from|
    ID $!iDType @
    handle (61,528)
      PROMPT ON
      !!ce = !stru
      !!kRestoreUnits(!currentUnits)
      call !!mdsResetPins(1,9)
      return
    endhandle
    PROMPT DISMISS
    PROMPT ON
    !pick3 = !!ce
    !testCe = !!mdsRelToDatum(!datum, !pick3, !ddir, !clearance.real())
    if (!testCe[1].upcase() eq 'UNSET')then
      !!alert.error('Identified element is unsuitable to support from.')
      golabel /Element3
    elseif (!testCe[1].upcase() eq '')then
      golabel /Element3
    endif
    if (!pADir eq U or !pLDir eq U)then
      if (!testCe[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('Identified element is behind pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'Identified element is behind pipe.')
        endif
        golabel /Element3
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is in line with the datum atta')
        golabel /Element3
      endif
    else
      if (!testCe[1].upcase() eq 'ABOVE')then
        if !noEquiv.not() then
          !!alert.error('Identified element is above pipe. Use standard $!substitute')
        else
          !!alert.error(!substitute + 'Identified element is above pipe.')
        endif
        golabel /Element3
      elseif (!testCe[1].upcase() eq 'EQUAL')then
        !!alert.error('Identified element is at the same elevation as the datum atta')
        golabel /Element3
      endif
    endif

    --<wd>may2007<mds12>
    --      if (!pick3.hardType eq 'PANE' or !pick3.type eq 'BOX' )then
    if (!pick3.hardType eq 'PANE' or !pick3.type eq 'BOX' or !pick3.type eq 'SBFI' or !pick3.type eq 'HPLATE') then
      --<wd>may2007<mds12>

      !plane3 = !testCe[2]
      VAR !pDir3 CONST DIR $!plane3
    endif

    !!mdsCreateMess(true)

    -- Position pins
    -- Set first direction from P10

    !!ce = !datum
    PIN 9 AT P0 of $!datum
    PIN 9 DIR $!p10Dir
    PIN 7 COPY PIN 9
    !dim = 0

    --<k.pleschner>Jun06
    --do !i values !support.atta
    do !iref values !support.atta
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)

      --PIN 7 plane PIN 7 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 7 plane PIN 7 CLEAR $!i.cend BEH $!i
      else
        -- use distance from centreline
        PIN 7 plane PIN 7 THR $!i
        PIN 7 plane PIN 7 DIST $!i.cend
      endif
      handle (2,109)
        break
      endhandle
      VAR !cDIR CONST DIR PIN 9 TO PIN 7
      !cdim = !!kStrReal('CONST DIST PIN 9 TO PIN 7')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cDIR.direction()
      !direction.directionB = !p10Dir
      !direction.tolerance  = 0.05

      if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 7 AT $!datum
        PIN 7 DIST $!cdim
        !dim = !cdim
      else
        PIN 7 AT $!datum
        PIN 7 DIST $!dim
      endif
    enddo

    PIN 7 DIR $!ddir
    VAR !pin7Pos PIN 7 POS WRT WORLD

    --<wd>may2007<mds12>
    --      if (!pick3.hardType eq 'SCTN' or !pick3.hardType eq 'GENSEC')then
    if (!pick3.hardType eq 'SCTN' or !pick3.hardType eq 'GENSEC' or !pick3.type eq 'HSTIFF') then
      --<wd>may2007<mds12>

      -- what does this do
      !inter = !!kFlangeOrWeb(!pick3, !pin7Pos.position(), !ddir)
      PIN 7 AT $!inter
      ---------------****** Connexions ******----------------------

      !support.connections.clear()
      !support.connections[1] = !pick3
      !support.connections[2] = !pick3
      -- !!mdsFt51.lineUp.active = True
      ------------------this bit will stop clearance being used if support is not under picked sctn-----------------------
      if(!haveJoints) then
        !connected = !!mdsGetBeamConn(!support,!attributes[1][8].dbref())
        if(!connected.unset()) then
          !!alert.error('Support is not positioned correctly through the new joints. Position "Through", before continuing.')
          !!ce = !refe
          call !!mdsResetPins(1,9)
          return
        endif
      endif
      ------------------------take it out and it will create joints however far apart the support and steel is------------

    else
      VAR !tempInter CONS POS INT PIN 7 $!plane3
      !inter = !tempInter.position()
      PIN 1 AT $!inter
      PIN 7 plane PIN 7 THRO PIN 1
    endif

    PIN 9 AT P9 of $!datum
    PIN 9 plane PIN 9 THRO PIN 7

    -- set second direction from P11

    !!ce = !datum
    PIN 8 AT P0 of $!datum
    PIN 8 DIR $!p11Dir
    PIN 6 COPY PIN 8
    !dim = 0

    --<k.pleschner>Jun06
    --do !i values !support.atta
    do !iref values !support.atta
      -- avoid SREF atta
      skip if !iref.name.substring(-1,-5).eq('/SREF')
      !i = object MDSANCGEOMDFLTS(!iref)

      --PIN 6 plane PIN 6 CLEAR $!clearance BEH $!i
      if !i.clge.eq('GEOM') then
        -- use clearance from geometry
        PIN 6 plane PIN 6 CLEAR $!i.cend BEH $!i
      else
        -- use distance from centreline
        PIN 6 plane PIN 6 THR $!i
        PIN 6 plane PIN 6 DIST $!i.cend
      endif
      handle (2,109)
        break
      endhandle
      VAR !cDIR CONST DIR PIN 8 TO PIN 6
      !cdim = !!kStrReal('CONST DIST PIN 8 TO PIN 6')

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !cDIR.direction()
      !direction.directionB = !p11Dir
      !direction.tolerance  = 0.05

      if (!cdim.gt(!dim) and !!kDirEqualDir(!direction)) then
        PIN 6 AT $!datum
        PIN 6 DIST $!cdim
        !dim = !cdim
      else
        PIN 6 AT $!datum
        PIN 6 DIST $!dim
      endif
    enddo

    PIN 6 DIR $!ddir
    VAR !pin6Pos PIN 6 POS WRT WORLD

    --<wd>may2007<mds12>
    --      if (!pick3.hardType eq 'SCTN' or !pick3.hardType eq 'GENSEC')then
    if (!pick3.hardType eq 'SCTN' or !pick3.hardType eq 'GENSEC' or !pick3.type eq 'HSTIFF') then
      --<wd>may2007<mds12>

      !inter = !!kFlangeOrWeb(!pick3, !pin6Pos.position(), !ddir)
      PIN 6 AT $!inter
    else
      VAR !tempInter CONS POS INT PIN 6 $!plane3
      !inter = !tempInter.position()
      PIN 1 AT $!inter
      PIN 6 plane PIN 6 THRO PIN 1
    endif

    PIN 8 AT P9 of $!datum
    PIN 8 plane PIN 8 THRO PIN 6

    --<wd>jun2007<mds12>
    -- Save !pick3 for Associations
    !mdsassoc.pick3 = !pick3
    --<wd>jun2007<mds12>

  endif
  -- end of pin setup if else statement
  -- pins should all be in position

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  -- Create and ARRAY of Attas with Packing Pieces (PDMS Names ONLY)
  -- and the Type and Size of the Packing Pieces to Recreate
  !unusedattapp = !!mdspackers(!support)

  ----------------------------------------------------------------------
  ----------------------------------------------------------------------

  !!ce = !stru
  --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
  !!mdsRemoveAutoPadRules(!stru)
  --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end
  -- Pins now in position create framework

  delete STRU MEM
  handle (41,66) (2,113) (2,113)
  endhandle
  !mdstemp = /MDS/$!alias/$!selection
  :mdscheck $!mdstemp.:mdscheck
  :mdsframirror $!mdstemp.:mdsframirror

  -- Position the MDS STRU
  --AT $!datum
  if (!datum.styp inset ('AT60','ST07','GT11')) then
    at p9 of $!datum
  else
    at $!datum
  endif

  NEW FRMW $!name/MAIN
  !frmwSupport = !!ce

  -- Copy required template/s
  if (!alias eq 'FT51' or !alias eq 'FT37') then
    !!ce = /MDS/$!alias/$!selection
  elseif (!alias eq 'CT04') then
    !!ce = /MDS/CT04/$!selection
  endif

  !subs = !!kCollectAllFor('SUBS', '', !!ce)
  !frmw = !!kCollectAllFor('FRMW', '', !!ce)
  !frameFormat = before(!frmw[1].name, '-FRMW')

  -- Navigate back to support and create template elements
  !!ce = !frmwSupport
  COPY ATTRIB OF $!frmw[1]
  COPY MEM OF $!frmw[1] RENAME $!frameFormat $!name
  do !i indices !subs
    NEW SUBS $!name/SUBS$!i COPY ATTRIB OF $!subs[$!i]
    COPY MEM OF $!subs[$!i] RENAME $!frameFormat $!name
  enddo

  -- Get direction of P9 of datum atta and dist between p9 and p0

  !!ce = !stru

  -- Set stru description for template recognition

  !desc = desc of /MDS/$!alias/$!selection
  !mdsBars = :mdsbars of /MDS/$!alias/$!selection
  desc '$!desc'
  :Mdsbars $!mdsBars

  MOVE $!ddir THRO P9 OF $!datum
  if !datum.:mdsguideref.set() and !datum.:mdsguideref.badref().not() then
    !mdsGuideRef = !datum.:mdsguideref
    -- Do NOT Move the STRU if the GUIDE is a TRUNNION GUIDE/STOP etc...
    if (!datum.catref.owner.:mdstrun.not()) then
      MOVE $!ddir thro p9 of $!mdsGuideRef
    endif
  endif


  -- If a trunnion is added to a support then we need to store the direction in a
  -- uda for later use

  var !oriFrame dir y wrt /*
  :MdsFrameDir $!oriFrame

$( Not suitable for flang gap
  -- If the flange gap toggle is switched on then adjust the positions
  if !method.eq('CURSOR') then
    -- The form is obviously this FORM, !pick1 is the first picked element
    -- !pick2 is the second picked element, !vertLeg is a logical to see if
    -- we have moved the pins onto the correct size or not
    !!mdsGapFlange(!form,!pick1,!pick2,!vertLeg)
  endif
$)

  -- Extend and move leg 1

  !!ce = $!<name>-V1

  !num = :MDSOnum

  EXTEND START THRO PIN 6
  !flush = :MdsOlap
  if !flush eq 'FLUSH' then
    EXTEND END BEH $!<name>-BAR-1
  elseif !flush eq 'OVERLAP' then
    !num = :MdsOnum
    EXTEND END THRO PIN 8
    EXTEND END $!num
  else
    EXTEND END THRO PIN 8
    EXTEND END -$!overlap
  endif

  VAR !dIR PIN 8 DIR WRT WORLD
  MOVE $!dIR WRT WORLD THRO PIN 8
  PIN 5 COPY PIN 8
  PIN 3 COPY PIN 8
  !realSctn = !!ce
  new sctn copy prev
  delete sctn mem
  handle ANY
  endhandle
  PIN 5 plane PIN 5 CLEAR 0 BEH CE
  PIN 3 plane PIN 3 CLEAR 0 INF CE
  delete sctn
  !!ce = !realSctn
  !d58 = !!kStrReal('CONST DIST PIN 5 TO PIN 8')
  !d38 = !!kStrReal('CONST DIST PIN 3 TO PIN 8')
  !d35 = !!kStrReal('CONST DIST PIN 3 TO PIN 5')
  !diff = ((!d38 - !d58) / 2)


$(
  if (!method eq 'CURSOR')then
    if (!vertLeg)then
      if (!pick2.type eq 'SCTN')then
        MOVE $!dIR WRT WORLD DIST $!diff
      elseif (!pick2.type eq 'BOX' and defined(!bedplate))then
        MOVE $!dIR WRT WORLD DIST $!diff
      else
        MOVE $!dIR WRT WORLD DIST $!d38
      endif
    else
      if (!pick1.type eq 'SCTN')then
        MOVE $!dIR WRT WORLD DIST $!diff
      elseif (!pick1.type eq 'BOX' and defined(!bedplate))then
        MOVE $!dIR WRT WORLD DIST $!diff
      else
        MOVE $!dIR WRT WORLD DIST $!d38
      endif
    endif

  else
    MOVE $!dIR WRT WORLD DIST $!d38
  endif
$)
  -- at this point V1 has been moved into place
  PIN 3 plane PIN 3 CLEAR 0 INF CE

  ------------------****** connexions *******----------------------
  if(!support.connections.unset()) then
    -- dimensions are being used first
    :MDSConn default
  else
    !vertical1 = !!ce
    !connected = !!mdsGetBeamConn(!support,!vertical1)
    :MDSConn $!connected
    handle any
    endhandle
  endif
  --------------------*******************--------------------------

  -- Extend and move leg 2
  !!ce = $!<name>-V2
  !num = :MDSOnum
  EXTEND START THRO PIN 7

  if !flush eq 'FLUSH' then
    --EXTEND END BEH $!<name>-BAR-1
  elseif !flush eq 'OVERLAP' then
    !num = :MdsOnum
    EXTEND END THRO PIN 9
    EXTEND END $!num
  else
    EXTEND END THRO PIN 9
    EXTEND END -$!overlap
  endif

  VAR !dIR PIN 9 DIR WRT WORLD
  MOVE $!dIR WRT WORLD THRO PIN 9
  PIN 5 COPY PIN 9
  PIN 4 COPY PIN 9
  !realSctn = !!ce
  new sctn copy prev
  delete sctn mem
  handle ANY
  endhandle
  PIN 5 plane PIN 5 CLEAR 0 BEH CE
  PIN 4 plane PIN 4 CLEAR 0 INF CE
  delete sctn
  !!ce = !realSctn
  !d59 = !!kStrReal('CONST DIST PIN 5 TO PIN 9')
  !d49 = !!kStrReal('CONST DIST PIN 4 TO PIN 9')
  !d45 = !!kStrReal('CONST DIST PIN 4 TO PIN 5')
  !diff = ((!d49 - !d59) / 2)
$(
  if (!method eq 'CURSOR')then
    if (!vertLeg)then
      if (!pick1.type eq 'SCTN')then
        MOVE $!dIR WRT WORLD DIST $!diff
      elseif (!pick1.type eq 'BOX' and defined(!bedplate))then
        MOVE $!dIR WRT WORLD DIST $!diff
      else
        MOVE $!dIR WRT WORLD DIST $!d49
      endif
    else
      if (!pick2.type eq 'SCTN')then
        MOVE $!dIR WRT WORLD DIST $!diff
      elseif (!pick2.type eq 'BOX' and defined(!bedplate))then
        MOVE $!dIR WRT WORLD DIST $!diff
      else
        MOVE $!dIR WRT WORLD DIST $!d49
      endif
    endif
  else
    MOVE $!dIR WRT WORLD DIST $!d49
  endif
$)

  PIN 4 plane PIN 4 CLEAR 0 INF CE

  ----------------------- ****** connexions ******* --------------------

  if(!support.connections.unset()) then
    -- dimensions are being used first
    :MDSConn default
  else
    !vertical2 = !!ce
    !connected = !!mdsGetBeamConn(!support,!vertical2)
    :MDSConn $!connected
    handle any
    endhandle
  endif

  ---------------------------********************-----------------------

  -- Extend and move bar 1
  !!ce = $!<name>-BAR-1
  PIN 5 COPY PIN 9
  !tempOverlap = :MdsOlap
  if !tempOverlap neq 'FLUSH' then
    if !tempOverlap eq 'OVERLAP' then
      !num = :MdsOnum
      PIN 5 plane PIN 5 CLEAR $!num INF $!<name>-V1
    else
      PIN 5 plane PIN 5 CLEAR $!overlap INF $!<name>-V1
    endif
  else
    PIN 5 plane PIN 5 CLEAR 0 INF $!<name>-V1
  endif
  EXTEND END THRO PIN 5

  PIN 5 COPY PIN 8
  if !tempOverlap neq 'FLUSH' then
    if !tempOverlap eq 'OVERLAP' then
      !num = :MdsOnum
      PIN 5 plane PIN 5 CLEAR $!num INF $!<name>-V2
    else
      PIN 5 plane PIN 5 CLEAR $!overlap INF $!<name>-V2
    endif
  else
    PIN 5 plane PIN 5 CLEAR 0 INF $!<name>-V2
  endif
  EXTEND START THRO PIN 5

  -- Set dimensions

  if (!method eq |CURSOR| or !method eq |CLEARANCE|)then

    -- Dimension 1
    !dim1 = !!ce.tctl
    !!mdsFt51.dim1.val = !dim1

    --  if (!method eq |CURSOR|)then
    --    !dim1 = !!kStrReal('CONST DIST PIN 3 TO PIN 4')
    --  else
    --    !dim1 = !!kStrReal('CONST DIST PIN 8 TO PIN 9')
    --  endif


    -- Dimension 2

    PIN 2 COPY PIN 9
    PIN 2 plane PIN 2 THRO $!datum
    if (!method eq |CURSOR|)then
      !dim2 = !!kStrReal('CONST DIST PIN 2 TO PIN 5')
    else
      !dim2 = !!kStrReal('CONST DIST PIN 2 TO PIN 9')
    endif
    !!mdsFt51.dim2.val = !dim2


    -- Dimension 3 and 4

    !dim3 = !!kStrReal('CONST DIST PIN 9 TO PIN 7')
    !!mdsFt51.dim3.val = !dim3
    !dim4 = !!kStrReal('CONST DIST PIN 8 TO PIN 6')
    !!mdsFt51.dim4.val = !dim4

  endif

  -- Select correct spref

  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  if !alias.eq('CT04') then
    SEL SPREF WITH STYP '$!alias-1-$!selection' SPEC /MDF
  else
    SEL SPREF WITH STYP '$!alias-1-$!selection' SPEC /MDF
  endif
  !!mdsSetSuppCode('MODIFY',!name,!alias,'$!alias-1-1')

  !!mdsSetIspe()

  !!mdsSelLstu(!!ce)
  !!mdsDacControl(TRUE)

  !!ce = !stru

  -- Check to see if support is mirrored
  if (!support.mirror)then
    call !!mdsMirrorFT51()
    !support.mirror = true
  endif

  -- If cross-bars existed replace them

  if (!support.bars.empty().not())then
    do !i indices !support.bars
      skip if (!i.eq(1))
      call !!mdsAddBarFT51(!support, 'OLD')
    enddo
    !support.barLen = !!mdsFt51.support.barLen
  endif
  !list = !support.bars[1]
  !references = ''
  do !i indices !list
    !references = !references & ' ' & !list[!i].string()
  enddo

  -- Set atta reference to datum cross bar
  !!ce = $!<name>-BAR-1
  :MDSAttaRef $!references
  !support.barLen[1] = deri length of CE
  !!ce = !stru

  -- Adjust for slope on horizontal lines only

  if (!pADir neq U and !pLDir neq U)then

    -- Check to see if the line is sloping
    !adjust = 0
    do !v values !atta
      !!ce = !v


      skip if !!ce.name.match('/SREF').gt(0)
      skip if !!ce.:mdsrotdir.east.set()
      !grad = pl grad
      if (!grad.neq(0))then
        if (!!ce.pDir[9].wrt(/* ).east.abs().eq(1)) then
          !vHeight = 0
        elseif (!!ce.pDir[9].wrt(/* ).up.eq(0)) then
          !vHeight = 0
        else
          !strucElement = ARRAY()
          !ref = $!name-BAR-1
          !strucElement.append(!ref)
          !vHeight = !!mdsAdjustSlope(!strucElement, !v)
        endif
      else
        !vHeight = 0
      endif
      if (!vHeight.gt(!adjust))then
        !adjust = !vHeight
      endif
    enddo

    -- Adjust required elements
    !!ce = $!<name>-BAR-1
    MOVE $!directions[3] DIST $!adjust
    !!ce = $!<name>-V1

    !end   = Posend wrt world
    !start = Posstart wrt world

    if (!support.mirror)then
      PIN 6 AT $!end
      PIN 8 AT $!start
    else
      PIN 6 AT $!start
      PIN 8 AT $!end
    endif

    PIN 6 DIR TO PIN 8
    !toBar = 0
    do !indx indices !support.bars
      PIN 8 COPY PIN 6
      PIN 8 plane PIN 8 THRO $!<name>-BAR-$!indx
      !toBar1 = !!kStrReal('CONST DIST PIN 6 TO PIN 8')
      if (!toBar1.gt(!toBar))then
        !toBar = !toBar1
        !index = !indx
      endif
    enddo
    PIN 8 plane PIN 8 CLEAR 0 BEH $!<name>-BAR-$!index

    !num = :MDSOnum

    if !flush neq 'FLUSH' then
      if (!support.mirror)then
        if !flush eq 'OVERLAP' then
          EXTEND START THRO pin 8
          !num = :MdsOnum
          EXTEND START $!num
        else
          EXTEND START THRO pin 8
          EXTEND START -$!overlap
        endif
      else
        if !flush eq 'OVERLAP' then
          EXTEND END THRO pin 8
          !num = :MdsOnum
          EXTEND END $!num
        else
          EXTEND END THRO pin 8
          EXTEND END -$!overlap
        endif
      endif
    endif

    -----------------------------********************--------------------------


    if (!method eq |DIMENSION|)then
      -- Extend vertical leg to account for the required adjustment

      if (!support.mirror)then
        !sctnEnd = 'END'
      else
        !sctnEnd = 'START'
      endif

      PIN 6 plane PIN 6 DIST -$!adjust
      EXTEND $!sctnEnd THRO PIN 6
    endif

    !!ce = $!<name>-V2

    !end   = Posend wrt world
    !start = Posstart wrt world

    if (!support.mirror)then
      PIN 7 AT $!end
      PIN 9 AT $!start
    else
      PIN 7 AT $!start
      PIN 9 AT $!end
    endif

    PIN 7 DIR TO PIN 9
    !toBar = 0
    do !indx indices !support.bars
      PIN 9 COPY PIN 7
      PIN 9 plane PIN 9 THRO $!<name>-BAR-$!indx
      !toBar1 = !!kStrReal('CONST DIST PIN 7 TO PIN 9')
      if (!toBar1.gt(!toBar))then
        !toBar = !toBar1
        !index = !indx
      endif
    enddo
    PIN 9 plane PIN 9 CLEAR 0 BEH $!<name>-BAR-$!index

    !num = :MDSOnum

    if !flush neq 'FLUSH' then
      if (!support.mirror)then
        if !flush eq 'OVERLAP' then
          EXTEND START THRO pin 9
          !num = :MdsOnum
          EXTEND START $!num
        else
          EXTEND START THRO pin 9
          EXTEND START -$!overlap
        endif
      else
        if !flush eq 'OVERLAP' then
          EXTEND END THRO pin 9
          !num = :MdsOnum
          EXTEND END $!num
        else
          EXTEND END THRO pin 9
          EXTEND END -$!overlap
        endif
      endif
    endif

    if (!method eq |DIMENSION|)then
      -- Extend vertical leg to account for the required adjustment

      if (!support.mirror)then
        !sctnEnd = 'END'
      else
        !sctnEnd = 'START'
      endif

      PIN 7 plane PIN 7 DIST -$!adjust
      EXTEND $!sctnEnd THRO PIN 7

    else

      -- Adjust dimensions on form
      !dim3Exist = !!mdsFt51.dim3.val - !adjust
      !dim4Exist = !!mdsFt51.dim4.val - !adjust

      -- reset dimensions on form
      !!mdsFt51.dim3.val = !dim3Exist
      !!mdsFt51.dim4.val = !dim4Exist

    endif
  endif


  !!ce = $!<name>/SREF

  !!mdsDacControl(true)


$(
  -- Despar 9 will store the maximum bore size on the support if FT37
  if !alias.eq('FT37') then
    !srefName = !!mdsFt51.support.stru.name + '/SREF'
    !!ce = !srefName.dbref()
    !largestBore = object bore()
    !largestBore = !form.support.datum.abore
    do !loop values !!mdsFt51.support.atta
      !largestBore = !loop.abore
      if !loop.abore.gt(!largestBore) then
        !largestBore = !loop.abore
      endif
    enddo
    -- Only set the largest bore is greater than the bore already stored
    !isNow = despara 9
    if !largestBore.real().lt(!isNow[1]) then
      !largestBore = !isNow[1].bore()
    endif
    DESPAR $!!mdsFt51.dim1.val  $!!mdsFt51.dim2.val  $!!mdsFt51.dim3.val  $!!mdsFt51.dim4.val  $!!mdsFt51.dim5.val  $!!mdsFt51.dim6.vl  $!!mdsFt51.ang1.val  $!!mdsFt51.ang2.val  $!largestBore
  else
$)
    DESPAR $!!mdsFt51.dim1.val  $!!mdsFt51.dim2.val  $!!mdsFt51.dim3.val $!!mdsFt51.dim4.val  $!!mdsFt51.dim5.val  $!!mdsFt51.dim6.val  $!!mdsFt51.ang1.val  $!!mdsFt51.ang2.val
$(
  endif
$)
  ------------------------------------------------------------------------------------------------------
  !!mdsDacControl(true)
  -- Check if ATTAS Created on The Support are Within the Allowable Bores for the STRUCTURE SCTN SIZES.
  !cecomp = !!ce
  !error  = STRING()
  if (!!mdscheckbores(!form,!selection,!error,!currentUnits)) then
    !!alert.error(!error)
    !!ce = !stru
    --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - start
    !!mdsRemoveAutoPadRules(!stru)
    --<RM> 30/06/11 P-38756 add function call to remove pnod and pjoi rules that are causing errors when delete stru mem is run - end
    delete STRU MEM
    handle (41,66) (2,113) (2,113)
    endhandle
    -- Reset SREF Despars to ZERO as the STRU MEM have been DELETED
    !!ce = $!<name>/SREF
    handle none
      -- Only RESET the DESPARS for the DIMENSION GADGETS -
      -- DESPAR num 9 stores the LARGEST PIPE BORE SIZE on the SUPPORT and is still VALID
      desp num 1 0mm
      desp num 2 0mm
      desp num 3 0mm
      desp num 4 0mm
      desp num 5 0mm
      desp num 6 0mm
      desp num 7 0mm
      desp num 8 0mm
    elsehandle any
    endhandle
    -- Reset all pins associated with this support
    !!mdsResetPins(1,9)
    !!ce = !cecomp
    handle any
    endhandle
    !!mdsCreateMess(false)
    !!kRestoreUnits(!currentUnits)
    return
  endif
  ------------------------------------------------------------------------------------------------------

  !!mdsDacControl(false)
  -- Reset materials of sections

  !!mdsResetMat(!storeMat)

  !!ce = !stru

  -- Navigate to Main Structure of Framework
  !!ce = !stru

  ----------------------***** connexions *****--------------------------

  if(!haveJoints) then
    do !index indices !joints

      if(!joints[!index].badref().not() and !attributes[!index][8].dbref().:MDSConn.eq(!joints[!index].owner.owner)) then
        !mainStl = !attributes[!index][8].dbref().:MDSConn
        !support.joints[!index] =  !!mdsCreateJoint(!mainStl, !attributes[!index][8].dbref(),!joints[!index],!attributes[!index])
      else
        !dummy = object DBREF()
        !dummyA = ARRAY()
        !mainStl = !support.connections[!index]
        !support.joints[!index] =  !!mdsCreateJoint(!mainStl, !attributes[!index][8].dbref(),!dummy,!dummyA)
      endif
    enddo
  endif


  ----------------------------------------------------------------------

  -- If a joint is being used and it is handed then their will be a alternative spref of the
  -- opposite hand joint and the bang to set separated by a ,

  !!mdsSwapIntJoi(!support.stru,!support.mirror,!support.alias)

  -- If substructures exist and the :MDSCp1 attribute is set to 'MOVE'
  -- then move SUBS1 thro V1 and SUBS2 thro V2

  $!name/SUBS$n1
  handle any
  elsehandle none
    if !!ce.:MDScp1.eq('MOVE') then
      move $!p10Dir thro $!name-V1
    endif
  endhandle

  $!name/SUBS$n2
  handle any
  elsehandle none
    if !!ce.:MDScp1.eq('MOVE') then
      move $!p10Dir thro $!name-V2
    endif
  endhandle


  !!ce = !stru

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.append(!!ce)
  !colourList.appendarray(!support.atta)
  !colourList.appendarray(!support.joints)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- Reset all pins associated with this support
  call !!mdsResetPins(1,9)

  -- Update support data held in form
  !!mdsFt51.support = !support

  !!mdsCreateMess(false)

  -- Move the snod of the V1 through the BAR

  !!ce = $!<name>-V1
  var !sjois coll all sjoi for ce
  do !resetZdist values !sjois
    !!ce = !resetZdist.dbref()
    !cref = !!ce.cref
    end
    zdist Through $!cref
  enddo

  !!ce = $!<name>-V2
  var !sjois coll all sjoi for ce
  do !resetZdist values !sjois
    !!ce = !resetZdist.dbref()
    !cref = !!ce.cref
    end
    zdist Through $!cref
  enddo

  ---------------------------------------------------------------------------------
  -- Move the STRU to the Offset Position relative to the setting in the UDA
  -- :MdsNudgeDist of the DATUM ATTA only.
  !checkdat = object MDSCHECKDATUM()
  !checkdat.offset(!form)

  -- Add the Aid Text to P9 of each Support Atta on the Framework
  !!mdsaidtext(!form)
  ---------------------------------------------------------------------------------

  !!ce = !stru



  -- Does the item require bearing plates (Framatome Only)

  !!ce = !support.stru
  !!mdsAddBearing(!support.datum)
  !!ce = !support.stru


  stru
  reconn recalc
  handle ANY
  endhandle

  --------------------------------------------------------------------------------------
  -- this is the bit which rotates the vertical sections
  -- Final section lengths need to be set after these lines
  -- set the angled legs V1 first
  -- parameters are: the bar, the item to be rotated, the angle to be rotated to
  !x = object MDSANGSCTN($!name-BAR-1 , $!name-V1 , !!mdsFt51.ang1.val)
  -- now do v2
  !x = object MDSANGSCTN($!name-BAR-1 , $!name-V2 , !!mdsFt51.ang2.val)

  -------------------------------------------------------------------------------------
  -- Copy weld locally

  !copyWelds = object MDSWELDLIST(!!ce,!form)
  !!ce = !support.stru

  -- reset :mdsancref attributes if set
  !support.plateconns.restoreconns()

  -- adjust ancillary welds to suit the beams they sit on
  !!mdsWeldAdjust(!!mdsFt51)

  -- if we are building by dimension and we have a saved plane, we need to adjust the end
  -- to the correct dimension, parameter 2 of the call is the mdsoverdim method to be used
  -- to check the dimension is correct
  if defined(!saveV1) then
    !saveV1.restoreplane(!!mdsFt51.dim4.val ,0)
  endif

  if defined(!saveV2) then
    !saveV2.restoreplane(!!mdsFt51.dim3.val ,0)
  endif


  if (!method neq |DIMENSION|)then

    --for this support, we need to look at trimming the section back regardless of sloping deck or not
    -- if ang1 or ang 2 gt 90 then the appropriate end needs to be trimmed back to the section

    -- Code for sloping decks
    if defined(!testCe[3]) then
      if (!method eq |CLEARANCE|)then
        !!mdstrimplane($!name-V1 ,!support.mirror, !testCe[2],'start' )
        !!mdstrimplane($!name-V2 ,!support.mirror, !testCe[2],'start' )
      elseif (!method eq |CURSOR|)then
        if !vertLeg then
          !first = 2
          !second = 1
        else
          !first = 1
          !second = 2
        endif
        if (defined(!testCepick1[2])) then

          --<wd>may2007<mds12>
          --        if !pick1.type.neq('SCTN') then
          if !pick1.type.neq('SCTN') or !pick1.type.neq('GENSEC') or !pick1.type.neq('HSTIFF') then
            --<wd>may2007<mds12>

            !!mdstrimplane($!name-V$!first ,!support.mirror, !testCepick1[2], 'start')
          endif
        endif
        if (defined(!testCepick2[2])) then

          --<wd>may2007<mds12>
          --        if !pick2.type.neq('SCTN') then
          if !pick2.type.neq('SCTN') or !pick2.type.neq('GENSEC') or !pick2.type.neq('HSTIFF')then
            --<wd>may2007<mds12>

            !!mdstrimplane($!name-V$!second ,!support.mirror, !testCepick2[2], 'start')
          endif
        endif
      endif
      -- This section added to trim and extend section ends if identified element
      -- is a section/gensec on a slope
    else
      if (!method eq |CLEARANCE|)then

        --<wd>may2007<mds12>
        --      if !pick3.hardType.eq('SCTN') or !pick3.hardType.eq('GENSEC') then
        if (!pick3.hardType eq 'SCTN' or !pick3.hardType eq 'GENSEC' or !pick3.type eq 'HSTIFF') then
          --<wd>may2007<mds12>

          !xx = object MDSPLINES(!pick3,$!name-V1 ,TRUE )
          !xx = object MDSPLINES(!pick3,$!name-V2 ,TRUE )
        endif
      elseif (!method eq |CURSOR|)then

        --<wd>may2007<mds12>
        --      if !pick1.hardType.eq('SCTN') or !pick1.hardType.eq('GENSEC') then
        if (!pick1.hardType eq 'SCTN' or !pick1.hardType eq 'GENSEC' or !pick1.type eq 'HSTIFF') then
          --<wd>may2007<mds12>

          if !vertLeg then
            !xx = object MDSPLINES(!pick1,$!name-V2 ,TRUE )
          else
            !xx = object MDSPLINES(!pick1,$!name-V1 ,TRUE )
          endif
        endif

        --<wd>may2007<mds12>
        --      if !pick2.hardType.eq('SCTN') or !pick2.hardType.eq('GENSEC') then
        if (!pick2.hardType eq 'SCTN' or !pick2.hardType eq 'GENSEC' or !pick2.type eq 'HSTIFF') then
          --<wd>may2007<mds12>

          if !vertLeg then
            !xx = object MDSPLINES(!pick2,$!name-V1 ,TRUE )
          else
            !xx = object MDSPLINES(!pick2,$!name-V2 ,TRUE )
          endif
        endif
      endif
      if !method neq |DIMENSION| then
        !!mdsFt51.dim4.val = !!mdsgetoverdim($!datum , $!name-V1 ,0)
        !!mdsFt51.dim3.val = !!mdsgetoverdim($!datum , $!name-V2 ,0)
      endif
    endif


    !!mdsFt51.dim3.val = !!mdsgetoverdim($!datum ,$!name-V2 ,0)
    !!mdsFt51.dim5.val = !!mdsgetoverdim($!datum ,$!name-V1 ,3) - (!!mdsFt51.dim1.val -  !!mdsFt51.dim2.val)
    !!mdsFt51.dim5.val = !!mdsFt51.dim5.val.string('D0').real()
    !!mdsFt51.dim4.val = !!mdsgetoverdim($!datum ,$!name-V1 ,0)
    !!mdsFt51.dim6.val = !!mdsgetoverdim($!datum ,$!name-V2 ,2) - !!mdsFt51.dim2.val
    !!mdsFt51.dim6.val = !!mdsFt51.dim6.val.string('D0').real()

  endif

  -- Store dimensions in design parameters
  !!ce = $!<name>/SREF
  !!mdsDacControl(true)

  desp num 3 $!!mdsFt51.dim3.val
  desp num 4 $!!mdsFt51.dim4.val
  desp num 5 $!!mdsFt51.dim5.val
  desp num 6 $!!mdsFt51.dim6.val
  desp num 7 $!!mdsFt51.ang1.val
  desp num 8 $!!mdsFt51.ang2.val

  !!mdsDacControl(false)

  !!ce = !support.stru

  -- Show dimensions on graphics if required
  if !!mdsFt51.graphicalDim then
    !!mdsshowdim(!!mdsFt51)
  endif

  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  --<wd>jun2007<mds12>
  -- Create the Cross Reference ASSOCIATIONS between the MDS SUPPORT SCTN members $!name-V1 and $!name-V2
  -- and the Main Structure supporting elements for:
  -- <a> CURSOR mode !pick1 and !pick2 -- or -- <b> CLEARANCE mode !pick3
  --
  -- Store the Original Current Element
  !xce = !!ce

  -- Store the Array of MDS Support Members in the MDSASSOC Object
  !mdsassoc.mdsmember[1] = $!name-V1
  !mdsassoc.mdsmember[2] = $!name-V2

  -- Initialising the MDSASSOWL object always DELETES ALL of the EXISTING Cross Reference Associations
  -- (ASSOC) elements for the Current MDS Support, irrespective of the Creation MODE (!method)
  !mdsassowl = object MDSASSOWL(!form)
  !mdsassowl.mdsform  = !form
  !mdsassowl.mdsassoc = !mdsassoc

  -- Create the Association (ASSOCs) for the Current Support
  !mdsassowl.mdsassoc(!mdsassoc)

  -- Update the FORM SUPPORT object to reference the current MDSASSOWL Associations object
  !form.support.associations[1] = !mdsassowl
  !support = !form.support

  -- Navigate back to the Original Current Element
  !!ce = !xce

  --<wd>jun2007<mds12>
  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------

  -- Add pads if automatic pads option is on and a PANE or HPLATE has been picked
  if !!mdsOptions.autopads.selection().eq('ON') then
    !whichVerticals = 'ALL'
    if !method.eq('CURSOR') and (!pick1.hardType.eq('PANE') or !pick1.hardType.eq('HPLATE') or !pick2.hardType.eq('PANE') or !pick2.hardType.eq('HPLATE')) then
      if !pick1.hardType.eq('SCTN') and !pick2.hardType.eq('PANE') or !pick1.hardType.eq('HSTIFF') and !pick2.hardType.eq('HPLATE') then
        !whichVerticals = 'V1'
      endif
      !!mdsaddpad(!support,!whichVerticals)
    elseif !method.eq('CLEARANCE') and (!pick3.hardType.eq('PANE') or !pick3.hardType.eq('HPLATE')) then
      !!mdsaddpad(!support,!whichVerticals)
    elseif !method.eq('DIMENSION') and !padsExist then
      !!mdsaddpad(!support,!whichVerticals)
    endif
  endif

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  -- End function
endfunction
