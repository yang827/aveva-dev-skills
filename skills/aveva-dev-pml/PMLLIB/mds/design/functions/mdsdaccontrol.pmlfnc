-- Created:		Wednesday 5th June 2002
--
-- Description:
-- Function to set the DAC control variable !!MDSAccess
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        boolean      Global variable setting
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function

define function !!mdsdaccontrol(!Setting is Boolean)

  if !Setting then
    !!MDSAccess = 'TRUE'
  else
    !!MDSAccess = 'FALSE'
  endif
endfunction
-- For development purposes set the background colour to red or green
$(
-- Removed for Release Version - 27Aug02-<wd>
-- to tie in with the file </%PDMSUI%/DES/MDS/DBAR> modified on 23aug2002
  if !Setting then
    !!CDMDSAPP.dac.background = 5
      handle any
      endhandle
    !!CDMDSAPP.dac.tag = 'True'
      handle any
      endhandle
  else
    !!CDMDSAPP.dac.background = 2
      handle any
      endhandle
    !!CDMDSAPP.dac.tag = 'False'
      handle any
      endhandle
  endif
$)

endfunction

-- End function

-- End of file mdsdaccontrol.pmlfnc
