--
-- File:  mdsdeacticons.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Thurs 18th August 2002
--
-- Description:
-- Function to read DES-SUPP-ICONS default file
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsdeacticons()

  --------------------------------------------------------------------------------
  --<wd.mar2006
  -- Load the MDS DESIGN Application ICON and MENU Settings from the NEW MDS12 DEFAULTS PDMS
  -- PARAGON CATALOGUE --> "/MDS/ICON/DEFAULTS" storing the MDS ICON DEFAULT settings etc...
  --
  -- Default file added to control icons DES-SUPP-ICONS
  --  !icons = !!readpdmsfile('/$!!mdsFILES.iCONS')
  --
  -- Initialise and Load the MDS ICON DEFAULTS Object from the "/MDS/ICON/DEFAULTS" Catalogue
  !mdsicons  = object MDSICONDEFS()
  !iconcheck = !mdsicons.iconscheck
  -- ???xx NO DO NOT xx??? ABORT ??? Entry to the MDS Application and SWITCH to the "Design>General..." application
  -- when the returned variable !iconcheck is FALSE
  if (!iconcheck.not()) then
    !!alert.error(|*** WARNING *** NONE of The MDS DESIGN APPLICATION "ICON" CATALOGUE DEFAULT DATA elements exist.
    ALL of the MAIN MDS ICONS & MENUS will be ACTIVE.|)
    return
  endif

  -- Loop through the ARRAY of PML Objects for the ICONS and ACTIVATE or DEACTIVATE
  -- the MDS DESIGN APPLICATION Options on the Main DESIGN Form MENUS and ICONS
  do !indx indices !mdsicons.iconsarray
    !iconobj = !mdsicons.iconsarray[!indx]
    if (!iconobj.iconname.upcase().eq('MDS')) then
      !!appDesMain.pix1.active = $!iconobj.iconvalu
      !!appDesMain.syscrt.setactive('Multi Discipline Frame...',$!iconobj.iconvalu)
    endif
    if (!iconobj.iconname.upcase().eq('GENERAL')) then
      !!appDesMain.pix2.active = $!iconobj.iconvalu
      !!appDesMain.syscrt.setactive('General...',$!iconobj.iconvalu)
    endif
    if (!iconobj.iconname.upcase().eq('CABLE')) then
      !!appDesMain.pix3.active = $!iconobj.iconvalu
      !!appDesMain.syscrt.setactive('Cable Rack...',$!iconobj.iconvalu)
    endif
    if (!iconobj.iconname.upcase().eq('HVAC')) then
      !!appDesMain.pix4.active = $!iconobj.iconvalu
      !!appDesMain.syscrt.setactive('HVAC...',$!iconobj.iconvalu)
    endif
    if (!iconobj.iconname.upcase().eq('ANCHOR')) then
      !!appDesMain.pix5.active = $!iconobj.iconvalu
      !!appDesMain.syscrt.setactive('Anchors...',$!iconobj.iconvalu)
    endif
    if (!iconobj.iconname.upcase().eq('FIXED')) then
      !!appDesMain.pix61.active = $!iconobj.iconvalu
      !!appDesMain.syscrt.setactive('Fixed Hanger...',$!iconobj.iconvalu)
    endif
    if (!iconobj.iconname.upcase().eq('VARIABLE')) then
      !!appDesMain.pix62.active = $!iconobj.iconvalu
      !!appDesMain.syscrt.setactive('Variable Hanger...',$!iconobj.iconvalu)
    endif
    if (!iconobj.iconname.upcase().eq('CONSTANT')) then
      !!appDesMain.pix63.active = $!iconobj.iconvalu
      handle ANY
      endhandle
      !!appDesMain.syscrt.setactive('Constant Hanger...',$!iconobj.iconvalu)
      handle ANY
      endhandle
    endif
    if (!iconobj.iconname.upcase().eq('GUIDES')) then
      !!appDesMain.pix7.active = $!iconobj.iconvalu
      !!appDesMain.syscrt.setactive('Guides and Stops...',$!iconobj.iconvalu)
    endif
    if (!iconobj.iconname.upcase().eq('SLIP')) then
      !!appDesMain.pix8.active = $!iconobj.iconvalu
      !!appDesMain.syscrt.setactive('Slip Units...',$!iconobj.iconvalu)
    endif
    if (!iconobj.iconname.upcase().eq('SPECIAL')) then
      !!appDesMain.pix9.active = $!iconobj.iconvalu
      !!appDesMain.syscrt.setactive('Special...',$!iconobj.iconvalu)
    endif
    if (!iconobj.iconname.upcase().eq('SPRINGS')) then
      !!appDesMain.pix10.active = $!iconobj.iconvalu
      !!appDesMain.syscrt.setactive('Springs...',$!iconobj.iconvalu)
    endif
    if (!iconobj.iconname.upcase().eq('TRUNNIONS')) then
      !!appDesMain.pix11.active = $!iconobj.iconvalu
      !!appDesMain.syscrt.setactive('Trunnion...',$!iconobj.iconvalu)
    endif
    if (!iconobj.iconname.upcase().eq('VESSEL')) then
      !!appDesMain.syscrt.setactive('Vessels...',$!iconobj.iconvalu)
      !!appDesMain.pix12.active = $!iconobj.iconvalu
    endif
    if (!iconobj.iconname.upcase().eq('BRANCH')) then
      !!appDesMain.syscrt.setactive('Branch Reinforcements...',$!iconobj.iconvalu)
      !!appDesMain.pix21.active = $!iconobj.iconvalu
    endif
    if (!iconobj.iconname.upcase().eq('LIGHTING')) then 	
      !!appDesMain.syscrt.setactive('Lighting Support...',$!iconobj.iconvalu)
      !!appDesMain.pix23.active = $!iconobj.iconvalu
    endif
    if (!iconobj.iconname.upcase().eq('PRELIMINARY')) then   	
      !!appDesMain.syscrt.setactive('Preliminary Support...',$!iconobj.iconvalu)
      !!appDesMain.pix22.active = $!iconobj.iconvalu
    endif
  enddo

endfunction
