-- Define Function
define function !!mdsdelbraceattas(!form is FORM)

   !!mdsdaccontrol(true)
   !strufrmw = !form.support.stru
   do !x to 6
      !attaname = !strufrmw.fullname + '/BR$!x'
      $!attaname
      handle(2,109)
         skip
      endhandle
      delete atta
   enddo
   !!mdsdaccontrol(false)

-- End function
endfunction
