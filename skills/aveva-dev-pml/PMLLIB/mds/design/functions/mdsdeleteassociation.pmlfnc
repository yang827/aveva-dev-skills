--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsDeleteAssociation(!stru is DBREF)

  if (!stru.badref()) then
    return
  endif
  if (!stru.type.neq('STRU')) then
    return
  endif

  !same = !!ce
  do !rest values !stru.assos

    --get the purpose of the association world. if it's not MDS then return
    var !purp purp of assowl of $!rest
    if (!purp.neq('MDS')) then
      skip
    endif

    !!ce = !rest.owner
    delete ASSOC
    handle ANY
      !!ce = !same
      !error = 'ERROR: Unable to DELETE the Association Group and/or its Associations.' & !!ascii(10) & !!error.text
      return error 1 '$!error'
    endhandle
    if (!!ce.memb.unset()) then
      delete ASSOGP
      handle ANY
      endhandle
    endif
  enddo

  !!ce = !same
  handle ANY
  endhandle

endfunction
