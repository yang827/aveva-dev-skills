--
-- File:    MdsDeleteSuppCPL.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    Neale Morris
-- Created:   May 27th 2005
--
--
-- Description:
-- Function to delete a support hanger from WitchHanger
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Delete Support Form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function

define function !!MdsDeleteSuppCPL(!Name is String) is boolean

  !return = FALSE

  !cuproj = current project
  !proj = !cuproj.code()
  !dat = !proj & 'DAT'
  var !evardat evar $!dat
  !!MANIF.dat = object file(!evardat)

--<wd>24nov2006
-- Added the NEW Code shown below
-- Initialise the !!MANIF object members .lif and .lof for the MDS/Witch Hanger Interface
  !lif = !proj & 'LIF'
  !lof = !proj & 'LOF'
  var !evarlif evar $!lif
  var !evarlof evar $!lof
  !!MANIF.lif = object file(!evarlif)
  !!MANIF.lof = object file(!evarlof)
--<wd>24nov2006

-- The syscom command can only take 247 characters, test length of string to see if it will run correctly
-- if not inform the user of the error, and the support not being deleted

  var !CplMdsExe evar CPLMDSEXE
  !ProgLength = !CplMdsExe.length()
  !NameLength =!Name.length()
  !DBLength = !!MANIF.dat.string().length()
  !ExtraChars = 18
  !MaxChars = 229
  !OverallLength = !ProgLength + !NameLength + !DBLength + !ExtraChars

  if !OverallLength.gt(!MaxChars) then
    !!Alert.Error('Length of string $!OverallLength exceeds $!MaxChars, unable to execute delete instruction to WitchHanger for support $!Name')
  else
-- Delete the exitcode file incase it existed before
    !Exitcode = object file(!!MANIF.dat & '\Exitcode')
      handle ANY
      elsehandle NONE
        if !Exitcode.exists() then
          !Exitcode.deletefile()
        endif
      endhandle

-- Get dbname from !!MdsCplDb.db
      !FullDBname = object file(!!MdsCplDB.db)
      !DbName = !FullDBname.entry()

-- $P *** SYSCOM |""%CPLMDSEXE%"" /MDS /DEL:$!Name /PD:$!!MANIF.dat\$!DbName| ***
    SYSCOM |""%CPLMDSEXE%"" /MDS /DEL:$!Name /PD:$!!MANIF.dat\$!DbName|
-- Exitcode = 0 : Drawing deleted
-- Exitcode <> 0 : An error occured
-- Exitcode = 1 : Cann't select internal drw no
-- Exitcode = 2 : Error while deleteing (No rollback !)
-- Exitcode = 3 : Specified Drw. not found

    !Exitcode = object file(!!MANIF.dat & '\Exitcode')
      handle ANY
      endhandle

-- The exitcode file did not exist therefore there must have been a problem with WitchHanger
    if !Exitcode.exists().not() then
      !!Alert.Warning('Support /$!Name could not be deleted in WitchHanger, exitcode file does not exist, problem with WitchHanger')
      !return = FALSE
    else
      !Code = !Exitcode.readfile()
      if !Code[1].eq('1') then
        !!Alert.Warning('Support /$!Name could not be deleted, Cannot select support with WitchHanger')
      elseif !Code[1].eq('2') then
        !!Alert.Warning('Support /$!Name could not be deleted, Error while deleting in WitchHanger')
      elseif !Code[1].eq('3') then
        !!Alert.Warning('Support /$!Name could not be deleted, Specified support not found in WitchHanger')
      elseif !Code[1].eq('0') then
-- In order to keep PDMS and WitchHanger upto date we need to savework
        savework
          handle ANY
            !!Alert.Error(!!Error.Text)
          elsehandle NONE
            $P Support $!name successfuly deleted in WitchHanger
            $P Savework issued for deleted support $!name
              handle ANY
              endhandle
              !return = TRUE
          endhandle
      endif
    endif
  endif

return !Return

-- End function
endfunction

-- End of file MdsDeleteSuppCPL.pmlfnc
