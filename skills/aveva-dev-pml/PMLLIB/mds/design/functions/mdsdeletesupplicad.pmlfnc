--
-- File:    mdsdeletesupplicad.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    D.FLANNERY
-- Created:   Mon 11th October 2004
--
--
-- Description:
-- Function to delete a support hanger from Licad
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Delete Support Form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function

define function !!mdsDeleteSupplicad(!name is STRING) is BOOLEAN

  !return = FALSE

  !cuproj = current project
  !proj = !cuproj.code()
  !dat = !proj & 'DAT'
  var !evardat evar $!dat
  !!manif.dat = object FILE(!evardat)

  var !lisExe evar LICADMDSEXE
  if (!lisExe.upCase().match('LICADV10').gt(0)) then
    SYSCOM |""%LICADMDSEXE%"" /MDS /DEL:$!name /OF:$!!manif.dat/Exitcode|
  else
    SYSCOM |""%LICADMDSEXE%"" /DEL:$!name /OF:$!!manif.dat/Exitcode /PD:$!!manif.dat|
  endif
  -- Exitcode = 0 : Drawing deleted
  -- Exitcode <> 0 : An error occurred
  -- Exitcode = 1 : Can't select internal drw no
  -- Exitcode = 2 : Error while deleting (No rollback !)
  -- Exitcode = 3 : Specified Drw. not found

  !exitcode = object FILE(!!manif.dat & '\Exitcode')
  handle ANY
    return
  endhandle
  !code = !exitcode.readfile()

  if !code[1].eq('1') then
    !!alert.warning('Support /$!name could not be deleted, Cannot select support with LICAD')
  elseif !code[1].eq('2') then
    !!alert.warning('Support /$!name could not be deleted, Error while deleting in LICAD')
  elseif !code[1].eq('3') then
    if(undefined(!!licadautotestenabled)) then
      !!alert.warning('Support /$!name could not be deleted, Specified support not found in LICAD')
    endif
  elseif !code[1].eq('0') then
    -- In order to keep PDMS and LICAD upto date we need to savework
    savework
    handle ANY
      !!alert.error(!!error.text)
    elsehandle NONE
      $P Support $!name successfully deleted in LICAD
      $P Savework issued for deleted support $!name
      handle ANY
      endhandle
      !return = TRUE
    endhandle
  endif

  return !return

endfunction
