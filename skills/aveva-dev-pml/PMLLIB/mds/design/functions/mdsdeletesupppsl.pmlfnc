--
--
-- Description:
-- Function to delete a support hanger from PSL
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Delete Support Form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function

define function !!MdsDeleteSuppPSL(!Name is String) is BOOLEAN

  !return = FALSE

  !cuproj = current project
  !proj = !cuproj.code()
  !lif = !proj & 'LIF'
  !lof = !proj & 'LOF'
-- Added MartinL 14/09/06
  !Evartext = !Proj & 'DAT'
  var !lifdir evar $!lif
  var !lofdir evar $!lof
-- Added MartinL 14/09/06
  var !datdir evar $!Evartext
  !!MANIF.lif = object file(!lif)
  !!MANIF.lof = object file(!lof)

  !InputFile = object file('$!lifdir/$!name$n.psi')
  !OutputFile = object file ('$!lofdir/$!name$n.pso')
  !DatFile = object file ('$!datdir/$!name$n.dat')

  if !inputfile.exists().not() then
    !!Alert.error('Unable to delete the PSL input file $!lifdir/$!name$n.psi')
  else
    !inputfile.deletefile()
  endif

  if !outputfile.exists().not() then
    !!Alert.error('Unable to delete the PSL output file $!lofdir/$!name$n.pso')
  else
    !outputfile.deletefile()
  endif

  if !datfile.exists().not() then
    !!Alert.error('Unable to delete the PSL dat file $!datdir/$!name$n.dat')
  else
    !datfile.deletefile()
  endif

 return !Return

-- End function
endfunction

-- End of file MdsDeleteSuppPSL.pmlfnc
