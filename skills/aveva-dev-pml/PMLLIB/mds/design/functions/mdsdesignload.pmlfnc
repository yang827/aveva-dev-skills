--
--
--------------------------------------------------------------------------------
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		DESIGN
--   Replaces:          The macro S:\Dev\Mds12Dev\pdmsui12.0\des\mds\ESUPPAPP
--
--------------------------------------------------------------------------------
-- Description
--
-- Loads the MDS12 DESIGN Application Defaults from the PARAGON MDS DEFAULTS CATALOGUES
--
------------------------------------------------------------------------
--
-- Define Function
define function !!mdsdesignload()

-- Store the Project Units
  !currentunits = !!kgetsetunits()

--clock init
--$P
--$P ** Loading ** !!mdsidfltsite()**
-- Check MDS ZONE ID's and Load the MDS Default Site FORM
  !!mdsidfltsite()
  handle 999
    !!mdsdefaultsite.hide()
    !!alert.error('Aborting Entry to the MDS Application')
    return error NOALERT
  endhandle

--clock read elapsed
--$P

--clock init
--$P ** Loading ** !!mdssetpipe() **
-- Set the lined/normal pipe id setting to normal ( NO CHANGES made for MDS12DEV loading )
  !!mdssetpipe()
--clock read elapsed

-- Set the GLOBAL Variables and !!MDSOPTIONS form gadgets in the MDS DESIGN APPLICATION Defaults
-- When the MDS DESIGN Application has been previously entered,
-- DO NOT load the MDS OPTIONS defaults again
  !unusedTestload = !!mdsoptions.clear.val + 1
  handle ANY
-- LOAD the MDS DESIGN Application Default OPTIONS into GLOBAL Variables,
-- and also LOAD the form gadgets in the FORM !!MDSOPTIONS,
-- e.g. !!mdssuppcl, !!mdsweiunit, !!mpu etc...
--
-- Also store all the MDS OPTION Defaults in the PML OBJECT GLOBAL Variable !!mdsoptiondefs,
-- which represents the "MDS DESIGN Application LOADING instance" of the PML OBJECT MDSOPTIONDEFS()
--

--clock init
--$P ** Loading ** object mdsoptiondefs() **

    !!mdsoptiondefs = object mdsoptiondefs()
    if (!!mdsoptiondefs.optioncheck.not()) then
-- MDS DESIGN Application OPTIONS ***NOT*** successfully loaded
      !!mdsdefaultsite.hide()
      !!appxload('DES','GEN', FALSE)
      return error 1 |ABORTING entry to the MDS Application. The MDS Application OPTION defaults are INCOMPLETE|

    else
-- MDS DESIGN Application OPTIONS ***SUCCESSFULLY*** loaded
--
-- Now CHECK if "MDS HANGER TEMPLATES" are being used in the "MDS Application"
      if (!!mdsoptiondefs.mdshangif.upcase().eq(|MDS|)) then
-- CHECK if the /MDS/HANGERS Template SITE EXISTS in the MDB
        !xce = !!ce
        /MDS/HANGERS
        handle (2,109)
          !!mdsdefaultsite.hide()
          !!appxload('DES','GEN', FALSE)
          return error 1 |ABORTING entry to the MDS Application. The MDS HANGER TEMPLATE SITE "/MDS/HANGERS" does NOT exist.|

        endhandle
        !!ce = !xce
      endif
    endif

--clock read elapsed
--$P
  endhandle


-- LOAD the MDS Standard CLIENT DESCRIPTIONS and CLIENT CODES into the GLOBAL Variables
-- for ALL types of MDS Standard,
-- CLIENT DESCRIPTIONS -- e.g. !!descat01,!!descft09, !!desctt36 etc...
-- CLIENT CODES -- e.g. !!codeat01,!!codeft09, !!codett36 etc...
--<wd>02nov2006--REMOVED-THIS-CODE-->>>clock init
--<wd>02nov2006--REMOVED-THIS-CODE-->>>--$P ** Loading ** object mdsdescriptions() **
--<wd>02nov2006--REMOVED-THIS-CODE-->>>
--<wd>02nov2006--REMOVED-THIS-CODE-->>>  !!mdsdescdefs = object mdsdescriptions()
--<wd>02nov2006--REMOVED-THIS-CODE-->>>
--<wd>02nov2006--REMOVED-THIS-CODE-->>>clock read elapsed
--<wd>02nov2006--REMOVED-THIS-CODE-->>>--$P
--<wd>02nov2006--REMOVED-THIS-CODE-->>>  if (!!mdsdescdefs.descriptioncheck.not()) then
--<wd>02nov2006--REMOVED-THIS-CODE-->>>    !errortype = !!mdsdescdefs.descerrortype
--<wd>02nov2006--REMOVED-THIS-CODE-->>>    !errormess = !!mdsdescdefs.descerrortext
--<wd>02nov2006--REMOVED-THIS-CODE-->>>    if (!errortype.trim().eq(|ERROR|)) then
--<wd>02nov2006--REMOVED-THIS-CODE-->>>-- ABORT ENTRY to the MDS DESIGN Application
--<wd>02nov2006--REMOVED-THIS-CODE-->>>-- The CLIENT DESCRIPTIONS and CODES were NOT successfully loaded
--<wd>02nov2006--REMOVED-THIS-CODE-->>>      !!mdsdefaultsite.hide()
--<wd>02nov2006--REMOVED-THIS-CODE-->>>      !!appxload('DES','GEN', FALSE)
--<wd>02nov2006--REMOVED-THIS-CODE-->>>      return error 1 |$!<errormess>. ABORTING entry to the MDS Application.|
--<wd>02nov2006--REMOVED-THIS-CODE-->>>
--<wd>02nov2006--REMOVED-THIS-CODE-->>>    elseif(!errortype.trim().eq(|WARNING|)) then
--<wd>02nov2006--REMOVED-THIS-CODE-->>>-- Advise USER of the "MISSING" MDS DEFAULTS CATALOGUES,
--<wd>02nov2006--REMOVED-THIS-CODE-->>>-- e.g. a project may NOT use the /MDS/HANGERS/DEFAULTS <HANGER TEMPLATES>
--<wd>02nov2006--REMOVED-THIS-CODE-->>>-- However ALLOW ENTRY to the MDS DESIGN Application.
--<wd>02nov2006--REMOVED-THIS-CODE-->>>-- The CLIENT DESCRIPTIONS and CODES have been PARTIALLY loaded
--<wd>02nov2006--REMOVED-THIS-CODE-->>>      !!alert.warning(|$!<errorrmess>|
--<wd>02nov2006--REMOVED-THIS-CODE-->>>
--<wd>02nov2006--REMOVED-THIS-CODE-->>>    endif
--<wd>02nov2006--REMOVED-THIS-CODE-->>>  endif


-- LOAD the MDS FRAMEWORK ALTERNATIVE CODE Descriptions for the
-- individual MDS FRAMEWORK SUPPORT CODES "Type and Size"
--clock init
--$P ** Loading ** object mdsaltddefs() **

   !!mdsaltddefs = object mdsaltddefs()

--clock read elapsed
--$P
   !errortype = !!mdsaltddefs.altderrortype
   !errormess = !!mdsaltddefs.altderrortext
    if (!!mdsaltddefs.altdcheck.not()) then
-- MDS DESIGN Application ALTERNATIVE CODE Descriptions NOT successfully loaded
      !!mdsdefaultsite.hide()
      !!appxload('DES','GEN', FALSE)
      return error 1 |$!<errormess>. ABORTING entry to the MDS Application.|

    elseif(!errortype.trim().eq(|WARNING|)) then
-- Advise USER of a "MISSING" MDS DEFAULTS "STRUCTURAL CATALOGUES,
-- However ALLOW ENTRY to the MDS DESIGN Application.
-- The CLIENT DESCRIPTIONS and CODES have been PARTIALLY loaded
      !!alert.warning(|$!<errormess>|)

    endif


-- INITIALISE all of the MAIN MDS DESIGN Application FORMS(!!MDSFRAME etc...)
--clock init
----$P ** Loading ** !!mdsmainformsinit() **

   !!mdsmainformsinit()

--clock read elapsed

-- Navigate to the WORLD element /*
  /*

-- Reset to the Project Units
   !!kRestoreUnits(!currentunits)

endfunction
