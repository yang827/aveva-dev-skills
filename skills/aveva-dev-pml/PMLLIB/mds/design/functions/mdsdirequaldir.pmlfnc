--
-- File:		mdsdirequaldir.pmlfnc
--   Type:		Function Definition
--   Group:		Common Application
--     Keyword:
--   Module:		DESIGN
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 10th November 2004
--
--
-- Description:
-- function to check that two directions passed are equal to within passed tolerance
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        KEQUALDIR     Object holding data to be checked
--
-- Return:
--    [Data Type]   [Description]
--      BOOLEAN      TRUE if directions are equal within the passed tolerance angle
--********************
--*  IMPORTANT NOTE: *
--********************
-- This PML function is NOT the same as the function ".../mds<version>/pmllib/common/functions/kdirequaldir.pmlfnc"
-- This PML function has been written to work with MDS JOINTS on the MDS Framework SCTN members etc... and uses the
-- ABSOLUTE <REAL> Values for the JOINTS to be created sucessfully at ALL angles where a DATUM Atta may NOW be ROTATED
-- on ALL HORIZONTAL(including SLOPING Lines) and VERTICAL Pipes.
--
--------------------------------------------------------------------------------
-- Define Function
  define function !!mdsdirequaldir(!object is kequaldir) is BOOLEAN

-- Initialise variables
    !tol  = !object.tolerance
    !dira = !object.directiona
    !dirb = !object.directionb

-- Check if directions are EXCATLY the same
    if (!dira eq !dirb)then
      return TRUE
    endif

-- Check and Ensure that each of the passed directions are WRT to the SAME ORIGIN <DBREF>
    if (!dira.origin neq !dirb.origin)then
      !dirb.wrt(!dira.origin)
    endif

-- Determine if Passed Directions are Parallel to EACH OTHER within the passed tolerance ANGLE
    !angdiffdiradirb = !dira.angle(!dirb)
    !oppositedira    = !dira.opposite()
    !oppdiffdiradirb = !oppositedira.angle(!dirb)
    !minangleallowed = 180 - !tol
    !maxangleallowed = 180 + !tol

    if (!angdiffdiradirb.between(!minangleallowed,!maxangleallowed ).not()) then
      if (!oppdiffdiradirb.between(!minangleallowed,!maxangleallowed ).not()) then
--$P ---FALSE-- $!angdiffdiradirb and $!oppdiffdiradirb is "NOT" between $!minangleallowed and $!maxangleallowed
        return FALSE
      else
--$P ---TRUE-- $!oppdiffdiradirb  "IS" between $!minangleallowed and $!maxangleallowed
        return TRUE
      endif
    else
-- Directions !dira and !dirb are the same direction within the passed tolerance angle
--$P ---TRUE-- $!angdiffdiradirb "IS" between $!minangleallowed and $!maxangleallowed
      return TRUE
    endif

  endfunction
-- End of file mdsdirequaldir.pmlfnc
