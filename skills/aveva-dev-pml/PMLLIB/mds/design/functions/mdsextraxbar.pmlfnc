--
-- File:		mdsextraxbar.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Friday 20th May 2005
--
--
-- Description:
-- ******************************************************************************************
-- *** IMPORTANT NOTE: *** This FUNCTION is SPECIFIC and for use ONLY with FRAMATOME Projects
-- ******************************************************************************************
-- Function to create EXTRA CROSS BAR(S) on "FT09 or FT08" MDS STD FRAMEWOPRKS,
-- but ONLY for the FRAMATOME MDS ANCILLARIY types "V6*" and "49*G2P"
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        FORM         MDS
--     2      R        MDSSUPPORT
--     3      R        ARRAY
--
-- Return:
--     [Data Type]     [Description]
--
------------------------------------------------------------------------------------


define function !!mdsextraxbar(!form is FORM, !supportobject is MDSSUPPORT)

-- Initialise Variables
  !suppobj    = !supportobject
  !suppattas  = !suppobj.atta
  !suppbars   = !suppobj.bars
  !stru       = !suppobj.stru
  !strudirs   = !suppobj.datumorthdirs
  !strup9dir  = !strudirs[3]
  !strup9dopp = !strudirs[4]
  !strup10dir = !strudirs[5]
  !strup11dir = !strudirs[6]
  !extraxbar  = FALSE
  !v6attas    = ARRAY()
  !g2pattas   = ARRAY()

-- RETURN without doing anything if NOT Framework type "FT08" or "FT09"
  if (not !suppobj.stru.:mdssupptype inset ('FT08', 'FT09')) then
    return
  endif

-- Check if FANP ANCILLARIES Types "V6*" or "49*G2P" exist on the Support
  do !check indices !suppattas
    if (!suppattas[!check].prop.code.matchwild('V6*')) then
      !extraxbar = TRUE
      !v6attas.append(!suppattas[!check])
    elseif (!suppattas[!check].prop.code.matchwild('49*G2P')) then
      !extraxbar = TRUE
      !g2pattas.append(!suppattas[!check])
    else
      skip
    endif
  enddo

-- RETURN without doing anything if NO FANP ANCILLARIES Types "V6*" or "49*G2P" exist on the Support
  if (!extraxbar.not()) then
    return
  endif

-- Always DELETE ALL EXISTING "TOP-GUIDE" Cross bars in the Current Support
-- NEW "TOP GUIDE" Cross Bars are GENERATED for ALL ATTAS requiring them on the Current Support.
  !xtopg = !!kcollectallfor('SCTN', '((match(name, |-TOP-GUIDE-|) gt 0) and type of owner eq |FRMW|)', !stru)
  do !dsctn values !xtopg
    !!ce = !dsctn
    delete sctn
  enddo

-- Determine on which SCTN Cross Bar the "FOUND" FANP ANCILLARIES Types "V6*" or "49*G2P" reference
  !vatta = ARRAY()
  !vsbar = ARRAY()


-- ***************************************************************************************************************
  if (!v6attas.empty().not()) then
    do !vbar indices !suppbars
-- Set the !vbore variable to ZERO to START each Cross Bar
      !vbore = 0
      do !vindx indices !suppbars[!vbar]
        if (!suppbars[!vbar][!vindx].prop.code.matchwild('V6*')) then
-- Get the Largest Nominal Bore Pipe for type "V6*" Ancillaries on this Cross Bar
          !bore = !suppbars[!vbar][!vindx].abor.real()
          if (!bore.gt(!vbore)) then
-- Set the LARGEST Nominal Bore ATTA<DBREF> and the SCTN Cross Bar Number<REAL>
            --!vatta[!vbar] = !suppbars[!vbar][!vindx]
            !vatta[1] = !suppbars[!vbar][!vindx]
            !vsbar[!vbar]  = !vbar
-- Set the !vbore variable for the Maximum Bore Size on the Cross Bar
            !vbore         = !bore
          endif
        else
-- Ignore ANY OTHER ATTA Types on the Current Cross Bar
          skip
        endif
      enddo

-- Now that the Largest Bore ATTA has been found for this Cross Bar
-- Determine Data for the new EXTRA "TOP-GUIDE" Cross Bar
      !vheig = !vatta[1].prop.shei.real() * 2
        handle ANY
          !vheig = !vatta[1].prop.thei.real() * 2
        endhandle
      !vbnam = !stru.name & '-BAR-' & !vsbar[!vbar]
      !vsctn = !vbnam.dbref()

      !vdept = !vsctn.prop.dept
      !vmove = !vheig + !vdept.real()

-- Create/Copy and Position the Extra "TOP-GUIDE" SCTN Cross Bar required on the LARGEST ATTA found
      !xce   = !!ce
      !!ce   = !vsctn
      !xbnam = !stru.name & '-TOP-GUIDE-' & !vsbar[!vbar]
      new sctn $!xbnam copy $!vsctn
      move $!strup9dopp dist $!vmove
      !xsctn = !!ce
-- Reset the uda :mdsattaref to default so that PML function !!mdschecklen does NOT Check the EXTRA "TOP-GUIDE" Cross Bars
      :mdsattaref default

-- Check and Modify new EXTRA "TOP-GUIDE" Cross Bar if 45deg. Reinforcing Plates Exist on Original Cross Bar
      if (!suppobj.stru.description.upcase().matchwild('*REIN*PLAT*')) then
        !v1name = !stru.name & '-V1'
        !v1dbrf = !v1name.dbref()
        !v2name = !stru.name & '-V2'
        !v2dbrf = !v2name.dbref()
        --!v1v2na = !!kstreal('cons dist ppline NA start of $!v1dbref to ppline NA start of $!v2dbref ')
-- $P=================
-- q var !strudirs
-- $P+++++++++++++++++
        !hvdept = (!vdept.real() / 2)
        !xsctn.drns = !strudirs[5]
        !xsctn.drne = !strudirs[6]

        extend start to $!v2dbrf
        extend end to $!v1dbrf
        extend start -$!hvdept
        extend end -$!hvdept
      endif

-- Create weld data for the NEW "TOP-GUIDE" Cross Bar
      !createwelds = object mdsweldlist(!!ce,!form)

-- Navigate back to the Original PDMS Element
      !!ce = !xce
    enddo

  endif
---***************************************************************************************************************

!!va = !vatta
!!vs = !vsbar

  !gcount = 0
  if (!g2pattas.empty().not()) then
    do !gbar indices !suppbars
-- Set the !vbore variable to ZERO to START each Cross Bar
      !vbore = 0

      do !vindx indices !suppbars[!gbar]
        if (!suppbars[!gbar][!vindx].prop.code.matchwild('49*G2P')) then
-- Get the Largest Nominal Bore Pipe for type "V6*" Ancillaries on this Cross Bar
          !bore = !suppbars[!gbar][!vindx].abor.real()
          if (!bore.gt(!vbore)) then
-- Set the LARGEST Nominal Bore ATTA<DBREF> and the SCTN Cross Bar Number<REAL>
            --!vatta[!vbar] = !suppbars[!vbar][!vindx]
            !vatta[1] = !suppbars[!gbar][!vindx]
            !vsbar[!gbar]  = !gbar
-- Set the !vbore variable for the Maximum Bore Size on the Cross Bar
            !vbore         = !bore
          endif
        else
-- Ignore ANY OTHER ATTA Types on the Current Cross Bar
          skip
        endif
      enddo

-- Now that the Largest Bore ATTA has been found for this Cross Bar
-- Determine Data for the new EXTRA "TOP-GUIDE" Cross Bar
      !vheig = !vatta[1].prop.thei.real() * 2
      handle ANY
        !vheig = !vatta[1].prop.sclh.real() * 2
      endhandle
      !vbnam = !stru.name & '-BAR-' & !vsbar[!gbar]
      !vsctn = !vbnam.dbref()

      !vdept = !vsctn.prop.dept
      !vmove = !vheig + !vdept.real()

-- Create/Copy and Position the Extra "TOP-GUIDE" SCTN Cross Bar required on the LARGEST ATTA found
      !xce   = !!ce
      !!ce   = !vsctn
      !xbnam = !stru.name & '-TOP-GUIDE-' & !vsbar[!gbar]
      new sctn $!xbnam copy $!vsctn
      move $!strup9dir dist -$!vmove
      !xsctn = !!ce
-- Reset the uda :mdsattaref to default so that PML function !!mdschecklen does NOT Check the EXTRA "TOP-GUIDE" Cross Bars
      :mdsattaref default

-- Check and Modify new EXTRA "TOP-GUIDE" Cross Bar if 45deg. Reinforcing Plates Exist on Original Cross Bar
      if (!suppobj.stru.description.upcase().matchwild('*REIN*PLAT*')) then
        !v1name = !stru.name & '-V1'
        !v1dbrf = !v1name.dbref()
        !v2name = !stru.name & '-V2'
        !v2dbrf = !v2name.dbref()
        --!v1v2na = !!kstreal('cons dist ppline NA start of $!v1dbref to ppline NA start of $!v2dbref ')
--$P=================
--q var !strudirs
--$P+++++++++++++++++
        !hvdept = (!vdept.real() / 2)
        !xsctn.drns = !strudirs[5]
        !xsctn.drne = !strudirs[6]

        extend start to $!v2dbrf
        extend end to $!v1dbrf
        extend start -$!hvdept
        extend end -$!hvdept
      endif

-- Create weld data for the NEW "TOP-GUIDE" Cross Bar
      !createwelds = object mdsweldlist(!!ce,!form)

-- Navigate back to the Original PDMS Element
      !!ce = !xce
    enddo
  endif







endfunction
