--
--
-- File:		mdsflipat43
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:
--   Replaces:
--
-- Author:	        Wayne Dodwell
-- Created:	        10th February 2003
--
--
-- Description:        Function to Flip and Orientate AT43, AT44, AT45 and AT46 - Pipe Penetration Seals
--
--------------------------------------------------------------------------------------------------------
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------------------------------
-- Define Function
  define function !!mdsflipat43(!form is form)

-- Set the Current Element
    !ceorig = !!ce

--<wd>feb2004
-- Flip Atta utility is NOW required on ALL MDS 'FT' and 'SPECIAL' Frameworks for
-- the MDS Ancillaries 'AT61','AT70', 'AT71'
    if ((!form.name().match('MDSFT').eq(1)) or (!form.name().match('MDSSPECIAL').eq(1))) then
-- The Passed FORM is for a MDS Standard or Special Framework

-- Check if the DATUM Atta Exists
      !!ce = !form.support.datum
      handle(2,822)
-- Unset DBREF
        !!alert.error('No MDS Ancillaries exist on this support.')
        return
      endhandle
-- Identify MDS Ancillary to Flip Orientation
      label /idatta
      prompt off
      prompt load escape 'Identify MDS Ancillary to Flip'
      ID ATTA @
      handle (61,528)
        prompt on
        return
      endhandle
      prompt on
      !atta = !!ce
-- Check that the Identified Atta is of the Correct Type
--      if (not !atta.styp inset('AT60','AT61','AT70','AT71','HVAC-REST')) then
      if (not !atta.styp inset('AT60','AT61','AT70','AT71','HVAC-REST','GT26','GT06','GT15','ST06','AN10')) then
--        !!alert.error('Unable to FLIP the identified MDS Ancillary type on a MDS Framework - Type MUST be ''$!!codeat61'', ''$!!codeat70'', ''$!!codeat71''.')
        !!alert.error('The identified MDS Ancillary type is not suitable to FLIP on a MDS Framework')
          handle ANY
            !!alert.error('Unable to FLIP the identified MDS Ancillary type on a MDS Framework')
          endhandle
        golabel /idatta
      endif
-- Check if the Identified Atta is on The Current MDS Framework
      !suppname = !form.support.stru.name
      if (!atta.name.match(!suppname).neq(1)) then
        !!alert.error('To FLIP the Identified MDS Ancillary it MUST belong to the current MDS Framework - ''$!suppname''.')
        golabel /idatta
      endif
-- Flip and Orientate the Correct type of MDS Ancillary identified
      !!mdsdaccontrol(true)
      !!ce = !atta
      flip ori
      handle any
        !!alert.error('Unable to flip and ori the Selected Atta. $!!error.text')
      endhandle
      !!mdsdaccontrol(false)

    else

-- The Passed FORM is for a Stand-Alone MDS Ancillary
--<wd>feb2004

-- Check if DATUM Atta Exists
      !!ce = !form.support.datum
      handle(2,822)
-- Unset DBREF
        !!alert.error('Datum Atta does NOT exist.')
        return
      endhandle

      !!MdsDacControl(true)

-- Flip and Orientate the DATUM Atta
      !!ce = !form.support.datum
      flip ori
      handle any
        !!alert.error('Unable to flip and ori the Datum Atta. $!!error.text')
      endhandle

      !!MdsDacControl(false)

--<wd>feb2004
    endif
--<wd>feb2004

-- Return To Original Element
    !!ce = !ceorig

  endmethod
