--
-- File:  mdsgetconnectedsupp.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  D Flannery
-- Created:  Wed Oct 13 2004
--
--
-- Description:
-- function to get associated supports
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          FORM        Support Form
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function

define function !!mdsgetconnectedsupp(!supp is DBREF) is BOOLEAN

  -- Initialise Variables
  !groupMemberList = ARRAY()
  !supportName = !supp.name
  !return = FALSE
  !!ce = !supp
  !orice = !!ce

  if (!supportName.match('[') gt 0 and !supportName.match(']') gt 0 ) then
    --  Group support loop through names before getting physical connections
    !rootName = !supportName.before('[')
    do !gindex from 1 to 20
      $!rootName[$!gindex]
      handle (2,109)
      elsehandle NONE
        if !!ce.name.neq(!supportName) then
          !groupMemberList.append(!!ce.name)
        endif
      endhandle
    enddo
    !!ce = !orice
  endif

  -- Get all possible physical connections
  -- omit compensation fitt's
  !compgtyp = !!mdsCompplateDflts.gtyp
  var !coll coll all fitt with (not(unset(cref)) and gtyp neq '$!compgtyp') for $!supp
  var !coll append coll all sjoi with (not(unset(cref))) for $!supp
  var !connections Eval cref for all from !coll
  do !i values !connections
    $!i
    !cESuppName = !!mdsGetSuppName(!!ce)
    if !cESuppName.neq(!supportName) then
      !groupMemberList.append(!cESuppName)
    endif

  enddo

  !groupMemberList.sortunique()

  if !groupMemberList.size().gt(0) then
    !return = TRUE
  endif

  !!ce = !supp

  if !return then
    do !enhance from 1 to !groupMemberList.size()
      !!mdsAddSupp.name.val = !groupMemberList[$!enhance].replace('/','')
      !!mdsmaddsupp(!!mdsAddSupp.name)
      !!mdsAddSupp.name.val = 'unset'
      --enhance $!groupMemberList[$!enhance]
    enddo
    !!alert.error(|Unable to regenerate support $!supportName, as it has associated supports.|)
    do !enhance from 1 to !groupMemberList.size()
      --unenhance $!groupMemberList[$!enhance]
    enddo

  endif

  return !return

  -- End function
endfunction
