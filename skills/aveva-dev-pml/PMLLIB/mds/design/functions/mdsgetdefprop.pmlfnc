--   Replaces:
--
--------------------------------------------------------------------------------
-- Description
--
-- Function to RETURN the MDS12 PARAGON DEFAULTS DATA element PPROP attribute VALUE
--
-- Arguments
-- <1> -- <STRING> -- AVEVA MDS SUPPORT "PARAGON DEFAULT TYPE" -- Valid types are: <ATTA>, <HANGER>, <PRELIMINARY>, <STRUCTURE>, <TRUNNION>
-- <2> -- <STRING> -- AVEVA MDS SUPPORT STANDARD NAME-- e.g. <AT01>, <VH01>, <PR01>, <FT08>, <TT04>
-- <3> -- <STRING> -- AVEVA MDS SUPPORT DKEY for the DATA element for the passed "PARAGON DEFAULT TYPE" and MDS STANDARD SUPPORT NAME
--
-- Return
-- <1> -- <STRING> -- CLIENT MDS PARAGON DEFAULT DATA ELEMENT PROPERTY value, e.g. /MDS/ATTA/DEFAULTS/AN04/GEN/CCOD etc...
--                    e.g. 'XAN04' <for the CCOD value>
--                      or '- Bolted Anchor shoe for Hot insulated pipe or temp transport NPS 2-36.' <for the DESC value> etc...
--                      or 'ERROR' if an ERROR is raised for any problem
------------------------------------------------------------------------
--
-- Define Function
define function !!mdsgetdefprop(!deftype is STRING, !mdsstd is STRING, !dkey is STRING) is STRING
--q var !deftype !mdsstd !dkey
-- Determine if a VALID AVEVA MDS SUPPORT "PARAGON DEFAULT TYPE" has been passed
  !default = !deftype.trim().upcase()
  if (not !default inset ('ATTA', 'HANGER', 'PRELIMINARY', 'STRUCTURE', 'TRUNNION')) then
-- Invalid DEFAULT TYPE passed
    !return = 'ERROR'

  else

-- Check if the DBREF for the MDS Support Standard PARAGON MDS DEFAULTS DKEY and the PARAGON DEFAULTS DATA element exists etc...
    !defstrng = '/MDS/$!<deftype>/DEFAULTS/$!<mdsstd>/GEN/$!<dkey>'
    !defdbref = !defstrng.dbref()
    handle ANY
      !return = 'ERROR'
      return !return

    elsehandle NONE
-- Get the PPROPERTY attribute EXPRESSION value from the DATA element with the passed DKEY
      !ppropval = pprop of $!<defdbref>
-- Expand the !ppropval variable obtained from the PPROP attribute EXPRESSION to REMOVE the brackets,
-- i.e. Change <STRING>'('XAN04')' to <STRING>'XAN04'
      !return = $!ppropval

    endhandle
  endif

-- Return the !return STRING variable
  return !return

endfunction
