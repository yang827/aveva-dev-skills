--------------------------------------------------------------------------------
--
-- File:    mdsgetmovedir.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    D.Flannery
-- Created:   Apr 26 2005
--
--
-- Description:
-- function to get direction to move atta on sloping pipes
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function

define function !!mdsgetmovedir(!atta is DBREF,!mode is STRING ) is ARRAY

  !result = ARRAY()

  if !!mdsfh01.support.offsetx.unset().not() then
    -- run this method because it works for ld09 and ld01
    $!atta
    !getdirs = !!mdsremovegrad(!!ce)
    !plDir = !getdirs[1]
  !crossdir = !getdirs[6]

  -- change required in case we have vertical sloping walls
  !tpos = !!mdsfh01.support.tposition

  --!tdir = !!mdsfh01.support.tdir.string().before('WRT ').trim()
  !tdir = !!mdsfh01.support.tdir
  pin 1 copy pl
  pin 2 copy pl
  pin 2 dir $!tdir
  pin 3 at $!tpos
  pin 3 dir $!tdir
  --!c = object pointvector(!tpos,!tdir.direction())

  -- <RM> 01 Dec 06 -- added the following so that pin 2 is worked out using pointvector intersections
  -- this is because the through command was failing for certain configurations
    !c = object POINTVECTOR(!tpos,!tdir)
  !optdir = !!mdsfh01.support.tdir.opposite().string().before('WRT')
  pin 2 dir $!optdir
  var !d pos pin 2 wrt /*
  var !e dir pin 2 wrt /*
    !f = object POINTVECTOR(!d.position(),!e.direction())
  !g = !f.intersection(!c.plane())
  pin 2 at $!g
  -- <RM> 01 Dec 06 -- end of fix

  var !dist1 constr dist pin 1 to pin 2
    var !hdir const dir pin 1 to pin 2

  -- <RM> 4th December 2006 -- add check for steelwork
  -- which gets the crossdir for steel sections only
  -- this if for situations where steel is rotated out of two axes and
  -- is above and approximately in line with the pipe
  var !stref owner of tref of cref of $!!mdsfh01.support.datum
  !sctn = !stref.dbref()
  handle ANY
    !type = 'NULL'
  elsehandle NONE
    !type = !sctn.type
  endhandle

  !tdir.delete()
  !tdir = !!mdsfh01.support.tdir.string().before('WRT ').trim()
  !tdirsplit = !tdir.split()
  if !tdir.eq('U') or !tdir.eq('D') or !tdir.eq('Z') or !tdir.eq('-Z') then
    !dirx  = !tdir.direction().cross(!crossdir)
      --!dirx = !plDir
    -- dtf 6.06.05 I have made this change and put it back again
    --if you find its a problem
  elseif !tdirsplit.size().eq(5) then
    !xoffdir = !!mdsfh01.support.offsetx
        !dirx = !xoffdir.cross(!tdir.direction())
  elseif !type.eq('SCTN') then
    var !sctncrossdir const dir ppli na start of $!stref to ppli na end of $!stref
      if !sctncrossdir.direction().dot(!plDir).lt(0.5) then
      !dirx = !sctncrossdir.direction().cross(!tdir.direction())
    else
      !dirx = !sctncrossdir.direction()
    endif
    -- 4th December 2006 -- end of fix
  elseif !tdir.match('U').gt(0) or !tdir.match('D').gt(0) or !tdir.match('Z').gt(0) or !tdir.match('-Z').gt(0) then
      !xoffdir = !!mdsfh01.support.offsetx
      handle ANY
    if !tdir.match('N').gt(0) or !tdir.match('S').gt(0) or !tdir.match('Y').gt(0) or !tdir.match('-Y').gt(0) then
      !dirx  = E
    else
      !dirx = N
    endif
      elsehandle NONE
        !dirx = !xoffdir.cross(!tdir.direction())
      endhandle
  else
    !dirx  = !tdir.direction().cross(U wrt world)
  endif

---------------------------------------------------------------
-- this was included outside the above logic tests           --
-- however it is causing problems throughout hanger creation --
-- i have taken it out as i believe it is a debug line that  --
-- has not been deleted properly - Richard Martin 03/08/08   --
---------------------------------------------------------------
--!dirx  = !tdir.direction().cross(!crossdir)------------------
---------------------------------------------------------------

  $(
  pin 3 copy pin 1
  pin 3 plane pin 3 dist 1000
  pin 4 copy pin 3
--  pin 4 dir $!hdir
  !optdir = !!mdsfh01.support.tdir.opposite().string().before('WRT')
  pin 4 dir $!optdir
  pin 4 plane pin 4 thr pin 2
  $)

  -- <RM> 01 Dec 06 -- added the following so that pin 4 is worked out using pointvector intersections
  -- this is because the through command was failing for certain configurations

  pin 3 copy pin 1
    --<RM> 04/03/08 changed the offset distance from 1000 to 1 because
    --in certain situations, i.e. near dynamic parallel the 1000 could put pin 3 through
    -- the connecting surface and break the direction test
    pin 3 dist 1
    --<RM> 04/03/08 end of fix
  pin 4 copy pin 3
  pin 4 dir $!optdir
  var !d pos pin 4 wrt /*
  var !e dir pin 4 wrt /*
    !f = object POINTVECTOR(!d.position(),!e.direction())
  !g = !f.intersection(!c.plane())
  pin 4 at $!g

  -- <RM> 01 Dec 06 -- end of fix

  -- test if we have a dynamic parallel situation, if we do then we need to ignore
  -- the !testangle test as it will return an error due to dir2to4 not having a direction richard martin [21/08/06]
  !tempdirs = !!mdsremovegrad(!atta)
  !pin9dir = !tdir
  !pin9diropp = !pin9dir.direction().opposite()
    if !tempdirs[1].eq(!pin9dirOpp) or !tempdirs[1].eq(!pin9dir.direction()) or !tempdirs[2].eq(!pin9dirOpp) or !tempdirs[2].eq(!pin9dir.direction()) then
    -- Pipe and support direction parallel dynamic
    !dynamicparallel =  TRUE
  else
    !dynamicparallel =  FALSE
  endif

  var !dist2 constr dist pin 3 to pin 4
  -- if dynamic parallel then ignore the next test richard martin [21/08/06]
  if !dynamicparallel.eq(FALSE) then
-- >> dtf 27.07.06 Test for angle on sloping steel & sloping pipe
    var !dir2to4 const dir pin 2 to pin 4
    var !dir1to3 const dir pin 1 to pin 3
    !testangle = !dir2to4.direction().angle(!dir1to3.direction())
  else
      -- set a deliberate fail value for testangle so that we ignore it for the dynamic parallel case
      -- richard martin [21/08/06]
      !testangle = 999
    endif

    --q var !dist1.real().nint()
    --q var !dist2.real().nint()

    if !dist1.real().eq(!dist2.real()) then
      !result.append(TRUE)
      !result.append('')
      !result.append(0)
    elseif (!testangle.gt(-.1) and !testangle.lt(.1)) or (!testangle.gt(179.9) and !testangle.lt(180.1)) then
      -- dtf >> 27.07.06 test to see if almost parallel
      !result.append(TRUE)
      !result.append('')
      !result.append(0)
    elseif !dist1.real().gt(!dist2.real()) then
      -- if second dist greater than first clamp will need to move in the leave dir of atta
      !result.append(FALSE)
      !memsize = !!ce.cref.members.size()
      if !memsize.neq(0) then
        if ( !!ce.cref.members[2].lDir.neq(!!ce.cref.members[2].aDir.opposite() ) and !!ce.cref.owner.members.size().gt(1) )  then
          --if hanger has a cross member with the same arrive and leave direction reverse the !movedir
          if !mode.eq('CREATE') then
            !movedir = !!ce.aDir.string().before('WRT')
          else
            !movedir = !!ce.lDir.string().before('WRT')
          endif
        elseif !mode.eq('CREATE') then
          !movedir = !!ce.lDir.string().before('WRT')
        elseif !mode.eq('MODIFY') then
          !movedir = !!ce.aDir.string().before('WRT')
        endif
      else
        if !mode.eq('CREATE') then
          !movedir = !!ce.lDir.string().before('WRT')
        elseif !mode.eq('MODIFY') then
          !movedir = !!ce.aDir.string().before('WRT')
        endif
      endif

      !result.append(!movedir)

      if !type.eq('SCTN') OR !type.eq('STWALL') then
        -- get tdir and pl dir of the atta, we use this to calculate the pipe angle
        !angle = !tdir.direction().angle(!plDir)
        !invangle = abs(!angle - 90)
      else
        !angle =  (!plDir.dot(!dirx))
        !invangle =  (acos(!angle))
        handle ANY
          -- <RM> 4 December 06 -- this was put in because i was having problems with the
          -- calculated value for angle, even though q var showed -1 i was getting an error
          -- saying that acos was not in the range -1 to +1, made it nearest integer and its
          -- ok, any problems and refinement may be necessary.
          !angle = !angle.nint()
          -- <RM> 4 December 06 -- end of fix
          !invangle =  (acos(!angle))
        endhandle
      endif
      !result.append(!invangle)

    elseif !dist1.real().lt(!dist2.real()) then
      -- if second dist less than first clamp will need to move in the arrive dir of atta
      !result.append(FALSE)
      !memsize = !!ce.cref.members.size()
      if !memsize.neq(0) then
        if ( !!ce.cref.members[2].lDir.neq(!!ce.cref.members[2].aDir.opposite() ) and !!ce.cref.owner.members.size().gt(1) ) then
          --if hanger has a cross member with the same arrive and leave direction reverse the !movedir
          if !mode.eq('CREATE') then
            !movedir = !!ce.lDir.string().before('WRT')
          else
            !movedir = !!ce.aDir.string().before('WRT')
          endif
        elseif !mode.eq('CREATE') then
          !movedir = !!ce.aDir.string().before('WRT')
        elseif !mode.eq('MODIFY') then
          !movedir = !!ce.lDir.string().before('WRT')
        endif
        --    q var !mode
      else
        if !mode.eq('CREATE') then
          !movedir = !!ce.aDir.string().before('WRT')
        elseif !mode.eq('MODIFY') then
          !movedir = !!ce.lDir.string().before('WRT')
      endif
    endif

    !result.append(!movedir)

    -- For sections we get the angle by getting the angle between tdir and pleave
    -- and then subtracting 90 degrees
    if !type.eq('SCTN') OR !type.eq('STWALL') then
      -- get tdir and pl dir of the atta, we use this to calculate the pipe angle
        !angle = !tdir.direction().angle(!plDir)
      !invangle = abs(!angle - 90)
    else
        !angle =  (!plDir.dot(!dirx))
      !invangle =  (acos(!angle))
      handle ANY
        -- <RM> 4 December 06 -- this was put in because i was having problems with the
        -- calculated value for angle, even though q var showed -1 i was getting an error
        -- saying that acos was not in the range -1 to +1, made it nearest integer and its
        -- ok, any problems and refinement may be necessary.
          !angle = !angle.nint()
        -- <RM> 4 December 06 -- end of fix
        !invangle =  (acos(!angle))
        endhandle
    endif
    !result.append(!invangle)

  endif
--$R

  else

    -- run the original function
    $!atta
    !getdirs = !!mdsremovegrad(!!ce)
    !plDir = !getdirs[1]
    !crossdir = !getdirs[6]

    pin 1 copy pl
    !tpos = !!mdsfh01.support.tposition
    -- dtf >>>Modified to get original tpos before dynoffset
    --pin 2 at $!tpos
    pin 2 copy P1
    !tdir = !!mdsfh01.support.tdir.string().before('WRT ').trim()
    pin 2 dir $!tdir
    pin 2 plane pin 2 thro $!tpos
    var !dist1 constr dist pin 1 to pin 2
    var !hdir const dir pin 1 to pin 2

    if !tdir.eq('U') or !tdir.eq('D') or !tdir.eq('Z') or !tdir.eq('-Z') then
      !dirx  = !tdir.direction().cross(!crossdir)
      --!dirx = !plDir
      -- dtf 6.06.05 I have made this change and put it back again
      --if you find its a problem

    elseif !tdir.match('U').gt(0) or !tdir.match('D').gt(0) or !tdir.match('Z').gt(0) or !tdir.match('-Z').gt(0) then
      if !tdir.match('N').gt(0) or !tdir.match('S').gt(0) or !tdir.match('Y').gt(0) or !tdir.match('-Y').gt(0) then
        !dirx  = E
      else
        !dirx = N
      endif
    else
      !dirx  = !tdir.direction().cross(U wrt world)
    endif

    --  -------------------------------------------------------------
    --   this was included outside the above logic tests           --
    --   however it is causing problems throughout hanger creation --
    --   i have taken it out as i believe it is a debug line that  --
    --   has not been deleted properly - Richard Martin 03/08/08   --
    --  -------------------------------------------------------------
    --  !dirx  = !tdir.direction().cross(!crossdir)------------------
    --  -------------------------------------------------------------

    pin 3 copy pin 1
    pin 3 plane pin 3 dist 1000
    pin 4 copy pin 3
    --    pin 4 dir $!hdir
    !optdir = !!mdsfh01.support.tdir.opposite().string().before('WRT')
    pin 4 dir $!optdir
    pin 4 plane pin 4 thr pin 2

    -- we need to plane u if dynoffset x set

    !xoff = !!mdsfh01.support.atta[1].cref.:mdsdynoffset
    handle ANY
    elsehandle NONE
      if !xoff.neq(0) then
        pin 4 dir u
        pin 4 plane pin 4 thr pin 2
      endif
    endhandle

    -- test if we have a dynamic parallel situation, if we do then we need to ignore
    -- the !testangle test as it will return an error due to dir2to4 not having a direction richard martin [21/08/06]
    !tempdirs = !!mdsremovegrad(!atta)
    !pin9dir = !tdir
    !pin9diropp = !pin9dir.direction().opposite()
    if !tempdirs[1].eq(!pin9dirOpp) or !tempdirs[1].eq(!pin9dir.direction()) or !tempdirs[2].eq(!pin9dirOpp) or !tempdirs[2].eq(!pin9dir.direction()) then
      -- Pipe and support direction parallel dynamic
      !dynamicparallel =  TRUE
    else
      !dynamicparallel =  FALSE
    endif

    var !dist2 constr dist pin 3 to pin 4

    -- if dynamic parallel then ignore the next test richard martin [21/08/06]
    if !dynamicparallel.eq(FALSE) then
      --   >> dtf 27.07.06 Test for angle on sloping steel & sloping pipe
      var !dir2to4 const dir pin 2 to pin 4
      var !dir1to3 const dir pin 1 to pin 3
      !testangle = !dir2to4.direction().angle(!dir1to3.direction())
    else
      -- set a deliberate fail value for testangle so that we ignore it for the dynamic parallel case
      -- richard martin [21/08/06]
      !testangle = 999
    endif

    --q var !dist1.real().nint()
    --q var !dist2.real().nint()

    if !dist1.real().nint().eq(!dist2.real().nint()) then
      !result.append(TRUE)
      !result.append('')
      !result.append(0)
    elseif (!testangle.gt(-.1) and !testangle.lt(.1)) or (!testangle.gt(179.9) and !testangle.lt(180.1)) then
      --   dtf >> 27.07.06 test to see if almost parallel
      !result.append(TRUE)
      !result.append('')
      !result.append(0)
    elseif !dist1.real().nint().gt(!dist2.real().nint()) then
      -- if second dist greater than first clamp will need to move in the leave dir of atta
      !result.append(FALSE)
      !memsize = !!ce.cref.members.size()
      if !memsize.neq(0) then
        if ( !!ce.cref.members[2].lDir.neq(!!ce.cref.members[2].aDir.opposite() ) and !!ce.cref.owner.members.size().gt(1) )  then
          --if hanger has a cross member with the same arrive and leave direction reverse the !movedir
          if !mode.eq('CREATE') then
            !movedir = !!ce.aDir.string().before('WRT')
          else
            !movedir = !!ce.lDir.string().before('WRT')
          endif
        elseif !mode.eq('CREATE') then
          !movedir = !!ce.lDir.string().before('WRT')
        elseif !mode.eq('MODIFY') then
          !movedir = !!ce.aDir.string().before('WRT')
        endif
      else
        if !mode.eq('CREATE') then
          !movedir = !!ce.lDir.string().before('WRT')
        elseif !mode.eq('MODIFY') then
          !movedir = !!ce.aDir.string().before('WRT')
        endif
      endif

      !result.append(!movedir)

      --<RM> 03/02/2010 included this test line for Witchhanger hangers because the pipe angle being
      --returned to mds vendor was incorrect which was leading to a failure in the Witchhanger software
      --on the basis of the pipe slope being greater than 5 degrees - Start of fix
      if !!mdshangif.eq('CPL') then
        var !cplpl pl dir of $!atta wrt /*
        !cplPv1 = object POINTVECTOR(!atta.position.wrt( /* ), !cplpl.direction())
        !cplPv2 = !cplPv1.offset(1000mm)
        !dX = !cplPv2.position.east - !cplPv1.position.east
        !dY = !cplPv2.position.north - !cplPv1.position.north
        !dZ = !cplPv2.position.up - !cplPv1.position.up
        if !dX.eq(0) then
          !newDist1 = !dY
        elseif !dY.eq(0) then
          !newDist1 = !dX
        else
          !newDist1 = !dX.power(2) + !dY.power(2)
          !newDist1 = !newDist1.sqrt()
        endif

        if !dX.eq(0) and !dY.eq(0) then
          if !dZ.gt(0) then
            !invangle = 90
          else
            !invangle = -90
          endif
        else
          !thetaDivision = !dZ / !newDist1
          !invangle = !thetaDivision.atan()
        endif
      else
      !angle =  (!plDir.dot(!dirx))
      !invangle =  (acos(!angle))
      handle ANY
        -- <RM> 26 March 09 -- this was put in because i was having problems with the
        -- calculated value for angle, even though q var showed -1 i was getting an error
        -- saying that acos was not in the range -1 to +1, made it nearest integer and its
        -- ok, any problems and refinement may be necessary.
        !angle = !angle.nint()
        -- <RM> 4 December 06 -- end of fix
        !invangle =  (acos(!angle))
      endhandle
      endif
      --<RM> 03/02/2010 included this test line for Witchhanger hangers because th
      --returned to mds vendor was incorrect which was leading to a failure in the
      --on the basis of the pipe slope being greater than 5 degrees - End of fix
      !result.append(!invangle)

    elseif !dist1.real().nint().lt(!dist2.real().nint()) then
      -- if second dist less than first clamp will need to move in the arrive dir of atta
      !result.append(FALSE)
      !memsize = !!ce.cref.members.size()
      if !memsize.neq(0) then
        if ( !!ce.cref.members[2].lDir.neq(!!ce.cref.members[2].aDir.opposite() ) and !!ce.cref.owner.members.size().gt(1) ) then
          --if hanger has a cross member with the same arrive and leave direction reverse the !movedir
          if !mode.eq('CREATE') then
            !movedir = !!ce.lDir.string().before('WRT')
          else
            !movedir = !!ce.aDir.string().before('WRT')
          endif
        elseif !mode.eq('CREATE') then
          !movedir = !!ce.aDir.string().before('WRT')
        elseif !mode.eq('MODIFY') then
          !movedir = !!ce.lDir.string().before('WRT')
        endif
        --      q var !mode
      else
        if !mode.eq('CREATE') then
          !movedir = !!ce.aDir.string().before('WRT')
        elseif !mode.eq('MODIFY') then
          !movedir = !!ce.lDir.string().before('WRT')
        endif
      endif
      !result.append(!movedir)

      --<RM> 03/02/2010 included this test line for Witchhanger hangers because the pipe angle being
      --returned to mds vendor was incorrect which was leading to a failure in the Witchhanger software
      --on the basis of the pipe slope being greater than 5 degrees - Start of fix
      if !!mdshangif.eq('CPL') then
        var !cplpl pl dir of $!atta wrt /*
        !cplPv1 = object POINTVECTOR(!atta.position.wrt( /* ), !cplpl.direction())
        !cplPv2 = !cplPv1.offset(1000mm)
        !dX = !cplPv2.position.east - !cplPv1.position.east
        !dY = !cplPv2.position.north - !cplPv1.position.north
        !dZ = !cplPv2.position.up - !cplPv1.position.up
        if !dX.eq(0) then
          !newDist1 = !dY
        elseif !dY.eq(0) then
          !newDist1 = !dX
        else
          !newDist1 = !dX.power(2) + !dY.power(2)
          !newDist1 = !newDist1.sqrt()
        endif

        if !dX.eq(0) and !dY.eq(0) then
          if !dZ.gt(0) then
            !invangle = 90
          else
            !invangle = -90
          endif
        else
          !thetaDivision = !dZ / !newDist1
          !invangle = !thetaDivision.atan()
        endif
      else
      !angle =  (!plDir.dot(!dirx))
      --!angle = !angle.nint()
      !invangle =  (acos(!angle))
      handle ANY
        -- <RM> 26 March 09 -- this was put in because i was having problems with the
        -- calculated value for angle, even though q var showed -1 i was getting an error
        -- saying that acos was not in the range -1 to +1, made it nearest integer and its
        -- ok, any problems and refinement may be necessary.
        !angle = !angle.nint()
        -- <RM> 4 December 06 -- end of fix
        !invangle =  (acos(!angle))
      endhandle
      endif
      --<RM> 03/02/2010 included this test line for Witchhanger hangers because the pipe angle being
      --returned to mds vendor was incorrect which was leading to a failure in the Witchhanger software
      --on the basis of the pipe slope being greater than 5 degrees - End of fix
      !result.append(!invangle)

    endif

  endif

  !!mdsresetpins(1,4)

  return !result

endfunction
