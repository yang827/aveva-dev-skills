--
-- File:		Mdsgetoverdim.pmlfnc
-- Type:		Function Definition
-- Group:		Multi Discipline Supports Application
-- Keyword:		MDS
-- Module:		design
-- Replaces:
--
-- Author:		Tony Martin
-- Created:		04/04/2005 11:03
--
--
-- Description: Function to work out the overall dimension from the datum
--              Required for sloping supports with cutback section ends
--              Gets orthoganal dimensions in the p9 -p9 p10 and p11 directions
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        dbref        datum atta
--     2     R        dbref        section name
--     3     R        real         key for defining the direction to be used
--
-- keys are
-- 0 measure in the direction of p9 past the end of the passed section
-- 1 measure in the opposite direction to p9 past the end of the passed section
-- 2 measure in the direction of p10 to the end of the passed section
-- 3 measure in the direction of p11 to the end of the passed section
--
-- Return:
--    [Data Type]   [Description]
--    real   Returns the dimension in the direction of the passed ppoint to the end of a sctn
---------------------------------------------------------------------------------------------

-- Define Function
define function !!Mdsgetoverdim(!datum is DBREF, !currcomp is DBREF ,!End is REAL) is REAL

   -- if !end is 0 then we are going in the direction of p9 of the datum
   -- if !end is 1 we are going in the opposite direction to p1

   !pv = object pointvector()
-- End if 6 used p0 not p0
   if !End.eq(6) then
     !pv.position = !datum.ppos[0].wrt(/* )
   else
     !pv.position = !datum.ppos[9].wrt(/* )
   endif
   if !end eq 0 or !End.eq(6) then
      -- the dimension is in the direction of p9
      !pv.direction = !datum.pdir[9].wrt(/* )
   elseif !end eq 1 then
      -- the dimension is in the opposite direction to p9
      !pv.direction = !datum.pdir[9].wrt(/* ).opposite()
   elseif !end eq 2  then
      -- the dimension is in the direction of p10 but calculated from p9
      !pv.direction = !datum.pdir[10].wrt(/* )
   elseif !end eq 3  then
      -- the dimension is in the direction of p11 calculated from p9
      !pv.direction = !datum.pdir[10].wrt(/* ).opposite()
   --   $P method is 3
  --    $P direction is $!pv.direction
   elseif !end eq 4 then
-- The dimension direction is U
      !pv.direction = U WRT /*
   elseif !end eq 5 then
-- The dimension direction is D
      !pv.direction = D WRT /*
   endif

   pin 1 at $!pv.position
   pin 1 direction $!pv.direction

   pin 2 copy pin 1
   pin 2 clear behind $!currcomp
   var !a const dist pin 1 to pin 2

   -- turn pin 1 and 2 off
   !!mdsresetpins( 1,2 )

   -- return the dimension
   return !a.real().string('D0').real()

-- End function
endfunction

-- End of file Mdsgetoverdim.pmlfnc
