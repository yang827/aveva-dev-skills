-------------------------------------------------------------------------------
--
-- File:    mdsgetsuppname.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.morris
-- Created:   Thur Aug 14
--
--
-- Description:
-- function to obtain a support name from an atta
--
-------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--    !suppname     Support name
-------------------------------------------------------------------------------

-- Define Function
define function !!mdsGetSuppName(!passedName is DBREF) is STRING


  !oriRef = !!ce

  !!ce = !passedName

  --check that the the current element does not belong to an E3D series support
  SUPPO
  handle (2,111)
    --this is a standard PDMS/MDS support -- continue as normal
  elsehandle none
    --this is an E3D series support - do not continue
    !!alert.warning('The selected support was created in the Aveva Everything 3D product series (from 2.1) and cannot be modified in PDMS')
    !suppname = 'ABORT'
    golabel /exit
  endhandle

  if(!passedName.type.eq('SJOI')) then
    !!ce = !passedName.cref
    handle ANY
    endhandle
  endif

  if(!passedName.type.eq('BEND')) then
    !!ce = !passedName.owner
    handle ANY
    endhandle
  endif


  if(!passedName.type.eq('SNOD')) then
    if(!!mdsIsNodeSupp(!passedName)) then
      !sjoi = !!kCollectAllFor('SJOI','',!passedName)
      do !sj values !sjoi
        if(!sj.cref.neq(nulref)) then
          !!ce = !sj.cref
          break
        endif
      enddo
    endif
  endif

  if (!!ce.type.eq('WORL')) then
    !suppname = 'ABORT'
    -- !!alert.error('Selected element is not a support.')
    golabel /exit
  endif

  --<kp>feb07 Add ability to select lighting support from "light" side (via :mdssref) if lighting support are loaded
  if (defined (!!mdslsuppdefs) and !!mdslsuppdefs.error.unset()) then
    !lightRef = $!!mdslsuppdefs.idtype
    handle NONE
      if (!!mdslsuppdefs.idFilter.evaluate(!lightRef).and(!lightRef.:MdsSref.badref().not())) then
        !!ce = !lightRef.:MdsSref
      endif
    elsehandle ANY
    endhandle
  endif
  --<kp>feb07

  -----------------------------------------------------------------------------
  STRU
  handle(2,111)
    if (!!ce.type ne 'ATTA' and !!ce.type ne 'PLAT' and !!ce.type ne 'REDU' and !!ce.type ne 'WELD' and !!ce.type ne 'BEND' and !!ce.type ne 'CTSUPP' ) then
      -- Could be a trunnion branch
      if (!!ce.type.eq('BRAN') and :MDSTrun) then
        --> <sk> 06/06/2012 test if owner is named to support unnamed pipes
        if (!!ce.owner.isnamed) then
          !suppname = !!ce.name.after(!!ce.owner.name)
        else
          !suppname = '/' & !!ce.name.after('//')
          if (!suppname.empty()) then
            !suppname = !!ce.name
          endif
        endif
        --<sk> 06/06/2012
        -- check for /1 /2 /3 or /4 trunnion suffix used on VT19
        if (!suppname.substring(-2,2).eq('/1') or !suppname.substring(-2,2).eq('/2') or!suppname.substring(-2,2).eq('/3') or!suppname.substring(-2,2).eq('/4')) then
          !suppname = !suppname.substring(1,!suppname.length() - 2)
        endif
        golabel /exit
        --> Added <ab> Mar 13 2002
      elseif (!!ce.type.eq('HANG') or !!ce.owner.type.eq('HANG') or !!ce.type.eq('REST')) then
        -- Could be a standard rod hanger or spring
        !ce = !!ce
        rest
        !suppname = !!ce.name.before('/REST')

        !!ce = !ce
        golabel /exit
        --< Added <ab> Mar 13 2002

        --<tm>26/08/2004 added to enable a support to be identified by lug olets
      elseif (!!ce.type.eq('OLET')) then

        --<wd>oct2005
        -- LUG for ATTA for a MDS STRUCTURE SUPPORT or an INDEPENDENT MDS ANCILLARY SUPPORT
        !mdsname = !!ce.name.before('/LUG').replace('/DATUM','')
        !mdsdbrf = !mdsname.dbref()
        handle ANY
          -- TEST for <attaname>.1/LUG1 etc... on a STRU SUPPORT or an ATTA SUPPORT only
          !mdsname  = !mdsname.before('.')
          !mdsdbrf  = !mdsname.dbref()
          handle ANY
            !suppname = 'ABORT'
            golabel /exit

          elsehandle NONE
            if ((!mdsdbrf.type.neq('STRU')) or (!mdsdbrf.type.neq('ATTA'))) then
              !suppname = 'ABORT'
              golabel /exit
            endif
          endhandle

        elsehandle NONE
          !mdsname  = !mdsname.before('.')
          !mdsdbrf = !mdsname.dbref()
          handle ANY
            !suppname = 'ABORT'
            golabel /exit
          elsehandle NONE
            if ((!mdsdbrf.type.neq('STRU')) and (!mdsdbrf.type.neq('ATTA'))) then
              !suppname = 'ABORT'
              golabel /exit
            endif
          endhandle
        endhandle

        if (!mdsdbrf.type.eq('ATTA')) then
          if (!mdsdbrf.stype.eq('MH01')) then
            if ((!mdsdbrf.cref.unset()) or (!mdsdbrf.cref.badref())) then
              -- For an "INVALID" MDS HANGER Manufacturer's "INTERFACE" ATTA
              !suppname = 'ABORT'
              golabel /exit
            endif
          elseif ((!mdsdbrf.stype.matchwild('FH*')) or (!mdsdbrf.stype.matchwild('VH*'))) then
            if ((!mdsdbrf.cref.unset()) or (!mdsdbrf.cref.badref())) then
              -- For an "INVALID" MDS HANGER Manufacture's "HANGER TEMPLATES" ATTA
              !suppname = 'ABORT'
              golabel /exit
            endif
          endif
        endif
        --<wd>oct2005

        !suppname = !!ce.name.before('/LUG').replace('/DATUM','')
        --<wd>oct2005
        -- OLET belongs to a VALID Support so ensure the correct MDS SUpport name is determined.
        !suppname = !suppname.before('.')
        --<wd>oct2005
        golabel /exit
        --<tm>26/08/2004


      else
        !suppname = 'ABORT'
        if (undefined(!!mdsSilent)) then
          !!alert.error('Cannot navigate to support from picked element.')
        endif
        golabel /exit
      endif

    else
      -- !spec = (name of spec of spref)
      !spec = (purp of spec of spref)
      handle (2,115)
        !suppname = 'ABORT'
        if (undefined(!!mdsSilent)) then
          !!alert.error('Cannot navigate to support from picked element. It has an invalid spref.')
        endif
        return !suppname
        golabel /exit
      elsehandle none
        -- if (!spec neq |/MDS|) then
        if (!spec neq |MDS|) then
          --<dw>mar2009 dun1119 Avoid weld if element found
          if (!!ce.type.eq('WELD')) then
            !suppname = 'ABORT'
            golabel /exit
            --<dw>mar2009 dun1119 Avoid weld.
          else
            if (undefined(!!mdsSilent)) then
              !!alert.error('Cannot navigate to support from picked element. It has an invalid spref.')
            endif
            !suppname = 'ABORT'
            golabel /exit
          endif

        else
          if (match(!!ce.name,|/DATUM|) gt 0) then
            --<wd>oct2005
            -- DATUM ATTA for a MDS STRUCTURE SUPPORT
            if (!!ce.type.eq('ATTA') OR !!ce.type.eq('CTSUPP')) then
              !mdsname = !!ce.name.before(|/DATUM|)
              !mdsdbrf = !mdsname.dbref()
              handle ANY
                !suppname = 'ABORT'
                golabel /exit
              elsehandle NONE
                if (!mdsdbrf.type.neq('STRU')) then
                  !suppname = 'ABORT'
                  golabel /exit
                endif
              endhandle
            endif
            --<wd>oct2005

            !suppname = !!ce.name.before(|/DATUM|)
            golabel /exit

          elseif (match(!!ce.name,|/SREF|) gt 0) then

            --<wd>oct2005
            -- SREF ATTA for a MDS STRUCTURE SUPPORT or a MDS TRUNNION SUPPORT
            if (!!ce.type.eq('ATTA') OR !!ce.type.eq('CTSUPP')) then
              !mdsname = !!ce.name.before(|/SREF|)
              !mdsdbrf = !mdsname.dbref()
              handle ANY
                !suppname = 'ABORT'
                golabel /exit
              elsehandle NONE
                if ((!mdsdbrf.type.neq('STRU')) and (!mdsdbrf.type.neq('PLAT'))) then
                  !suppname = 'ABORT'
                  golabel /exit
                endif
                -- Check for a MDS TRUNNION SUPPORT
                if (!mdsdbrf.type.eq('PLAT')) then
                  if (!mdsdbrf.owner.:mdstrun.not()) then
                    !suppname = 'ABORT'
                    golabel /exit
                  endif
                endif
              endhandle
            endif
            --<wd>oct2005

            !suppname = !!ce.name.before(|/SREF|)
            golabel /exit

            --<dw>sep2007 Bracing ATTA for a MDS STRUCTURE SUPPORT
          elseif (match(!!ce.name,|/BR|) gt 0) then
            if (!!ce.type.eq('ATTA')) then
              !mdsname = !!ce.name.before(|/BR|)
              !mdsdbrf = !mdsname.dbref()
              handle ANY
                !suppname = 'ABORT'
                golabel /exit
              elsehandle NONE
                if (!mdsdbrf.type.neq('STRU')) then
                  !suppname = 'ABORT'
                  golabel /exit
                endif
              endhandle
            endif
            !suppname = !!ce.name.before(|/BR|)
            golabel /exit
            --<dw>End of bracing atta addition
          elseif (match(!!ce.name,|/MAKEUP|) gt 0) then
            !suppname = !!ce.name.before(|/MAKEUP|)
            golabel /exit
            -- Added check for ENDPLATE on trunnions: sjr 03/01/2003 15:30
          elseif (match(!!ce.name,|/ENDPLATE|) gt 0) then
            !suppname = !!ce.name.before(|/ENDPLATE|)
            golabel /exit
          elseif (match(!!ce.name,|/NOTE1|) gt 0) then
            !suppname = !!ce.name.before(|/NOTE1|)
            golabel /exit
          elseif (match(!!ce.name,|/NOTE2|) gt 0) then
            !suppname = !!ce.name.before(|/NOTE2|)
            golabel /exit
          elseif (match(!!ce.name,|/NOTE3|) gt 0) then
            !suppname = !!ce.name.before(|/NOTE3|)
            golabel /exit
          elseif (match(!!ce.name,|/NOTE4|) gt 0) then
            !suppname = !!ce.name.before(|/NOTE4|)
            golabel /exit
          elseif (match(!!ce.name,|/FFW|) gt 0) then
            !suppname = !!ce.name.before(|/FFW|)
            golabel /exit

          else
            --<wd>oct2005
            -- Check if type is a MDS ATTA that it belongs to a VALID MDS SUPPORT
            !cetype = !!ce.type
            if (!cetype.eq('ATTA')) then
              if (!!ce.name.matchwild('*.*')) then
                -- Check if ATTA belongs to a MDS TRUNNION, MDS STRUCTURE or an INDEPENDENT MDS ATTA Support
                !mdsname = !!ce.name
                !mdsdbrf = !mdsname.dbref()
                !mdsowne = !mdsdbrf.owner
                -- Test for a MDS TRUNNION Support
                if ((!mdsowne.name.match(!mdsname.before('.')).gt(0)) and (!mdsowne.type.eq('BRAN'))) then
                  if (!mdsowne.:mdstrun.not()) then
                    !suppname = 'ABORT'
                    golabel /exit
                  endif

                endif

                -- Test for a MDS STRUCTURE Support
                !mdsname = !mdsname.before('.')
                !mdsdbrf = !mdsname.dbref()
                handle ANY
                  !suppname = 'ABORT'
                  golabel /exit
                elsehandle NONE
                  -- GE 21/11/05 Added PLAT type as it was not allowing deletion of trunnions i.e. TT40
                  if (!mdsdbrf.type.neq('STRU') and !mdsdbrf.type.neq('ATTA') and !mdsdbrf.type.neq('PLAT')) then
                    !suppname = 'ABORT'
                    golabel /exit
                  endif
                endhandle

              else

                -- Check for a MDS HANGER ATTA
                !mdsname = !!ce.name
                !mdsdbrf = !mdsname.dbref()
                if (!mdsdbrf.stype.eq('MH01')) then
                  if ((!mdsdbrf.cref.unset()) or (!mdsdbrf.cref.badref())) then
                    -- For an "INVALID" MDS HANGER Manufacturer's "INTERFACE" ATTA
                    !suppname = 'ABORT'
                    golabel /exit
                  endif
                elseif ((!mdsdbrf.stype.matchwild('FH*')) or (!mdsdbrf.stype.matchwild('VH*'))) then
                  if ((!mdsdbrf.cref.unset()) or (!mdsdbrf.cref.badref())) then
                    -- For an "INVALID" MDS HANGER Manufacture's "HANGER TEMPLATES" ATTA
                    !suppname = 'ABORT'
                    golabel /exit
                  endif

                endif

              endif

            endif
            --<wd>oct2005
            !occurs = !!ce.name.occurs('.')
            !split = !!ce.name.split('.')
            !suppname = !split[1]
            do !build from 2 to !occurs
              !suppname = !suppname & '.' & !split[!build]
            enddo
            golabel /exit

          endif
        endif
      endhandle
    endif
  endhandle

  -- Check type of structure
  -- The sval may be delimited by a , for multiple support zones identifcations
  !isSupport = FALSE
  !sVal = !!mdsIdSVal.split(',')
  do !testForSupport values !sVal
    if (!!ce.owner.$!!mdsIdSatt eq |$!testForSupport|)then
      !isSupport = TRUE
    endif
  enddo

  if (!isSupport.not()) then
    !suppname = 'ABORT'
    if (undefined(!!mdsSilent)) then
      !!alert.error('Selected element is not a support.')
    endif
    golabel /exit
  endif

  !suppname = !!ce.name

  label /exit
  !!ce = !oriRef

  return !suppname

endfunction
