-- Author:              t.martin
-- Created:             04/05/2004 15:34
--
--
-- Description:
-- Initialisation for the steelwork sizes
--
----------------------------------------------------------------------------------
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         DBREF       mds template zone dbref
--     2     R         FORM        bore of current atta
--  Return:
--    [Data Type]   [Description]
--        real        support sequence number matching bore
--------------------------------------------------------------------------------
-- Define Function
define function !!mdsgettempnumber(!zone is dbref,!bore is bore)is real

 var !strus coll all stru for $!zone
 var !Maxbore eval :mdsmaxbore for all from !strus
 var !Minbore eval :mdsminbore for all from !strus
 do !a index !strus
   !max = object bore(!maxbore[!a])
   !min = object bore(!minbore[!a])
   if !bore.geq(!min).and(!bore.leq(!max)) then
     Return !a
   endif
 enddo
 return 0


 endfunction
