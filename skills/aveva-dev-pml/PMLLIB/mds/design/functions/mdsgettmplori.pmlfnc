--
-- File: mdsgettmplori.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Karel Pleschner
-- Created: 9th Oct 2006
--
--
-- Description:
-- Function to get orientation configuration code from picked angle section(s)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         DATUM atta of support
--     2     R        DBREF         first supporting steel (SCTN)
--     3     R        DBREF         second supporting steel (SCTN)
--
-- Return:
--    [Data Type]   [Description]
--    REAL           Number describing the configuration - the valid values are as follows (viewed from ldir of datum atta):
--                   1 - right
--                   2 - left
--                   3 - in
--                   4 - out
--                   0 - invalid (none of above)
--
--------------------------------------------------------------------------------
--
---------------------------------------------------------------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------------------------------------------------------------
--<wd>oct2007<mds12> -- **** IMPORTANT NOTE ****
-- *********************************************
-- Defect No. P-2386 raised to ensure the test case nos. "3-case4" and "3-case5" for the MDS Development F707 SP191 work as required.
-- Both of the test cases require a MDS STANDARD STRUCTURE SUPPORT with "TWO VERTICAL/CONNECTING SCTNS and created in CURSOR mode ONLY", e.g. FT08, FT09 etc...,
-- to be ORIENTATED correctly when "ONLY ONE" of the IDENTIFIED elements from which the MDS SUPPORT will be supported is a "HSTIFF" or "SCTN" element type
-- and the OTHER IDENTIFIED element type is either an AVEVA PLANT "PANEL" element or an AVEVA MARINE "HPLATE" element.
-- *********************************************
--<wd>oct2007<mds12>
---------------------------------------------------------------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------------------------------------------------------------
--
-- Define Function
--
-----------------------------------------
--<wd>oct2007<mds12> -- Defect No. P-2386
-- The passed !sctn1 and !sctn2 variables have changed name in order to avoid
-- CHANGING there values by association in the calling PML function!!!
--
--define function !!mdsgettmplori(!datum is DBREF,!sctn1 is DBREF,!sctn2 is DBREF) is REAL
define function !!mdsgettmplori(!datum is DBREF,!xsctn1 is DBREF,!xsctn2 is DBREF) is REAL

      !sctn1 = !xsctn1
      !sctn2 = !xsctn2
--<wd>oct2007<mds12> -- Defect No. P-2386
-----------------------------------------

      !result = 0

      if !sctn2.badref() then
         !sctn2 = !sctn1
      endif

-----------------------------------------
--<wd>oct2007<mds12> -- Defect No. P-2386
-- Check element type MAIN STEEL Supporting Steel passed in variables !sctn1 and !sctn2
-- Determine which element is a SCTN or a HSTIFF
      if (!sctn1.type.eq('SCTN').or(!sctn1.type.eq('HSTIFF'))) then
        !sctn1type = TRUE
      else
        !sctn1type = FALSE
      endif

      if (!sctn2.type.eq('SCTN').or(!sctn2.type.eq('HSTIFF'))) then
        !sctn2type = TRUE
      else
        !sctn2type = FALSE
      endif

-- When ONLY ONE of the passed variables !xsctn1 or !xsctn2 is a SCTN or a HSTIFF, set the other variable to the passed SCTN or the HSTIFF DBREF.
-- The other element passed is probably a PANEL or a HPLATE element, so in order to RETURN the correct MDS TEMPLATE ORIENTATION, TEMPORARILY set
-- the other element variable, in this function ONLY, to be the same as the SCTN or HSTIFF
      if (!sctn1type.not().or(!sctn2type.not())) then
-- Determine which Variable represents the SCTN or the HSTIFF element
        if (!sctn1type) then
          !sctn2 = !sctn1
        elseif (!sctn2type) then
          !sctn1 = !sctn2
        endif
      endif
--<wd>oct2007<mds12> -- Defect No. P-2386
-----------------------------------------

--<wd>jul2007<mds12> -- Identified MARINE HULL elements, !sctn1 and !sctn2, are type HSTIFF and NOT type SCTN
      -- first check type - must be SCTN or for MARINE must be HSTIFF

--      if !sctn1.type.eq('SCTN').and(!sctn2.type.eq('SCTN')).not() then
      if (!sctn1.type.eq('SCTN').and(!sctn2.type.eq('SCTN')).not()) and (!sctn1.type.eq('HSTIFF').and(!sctn2.type.eq('HSTIFF')).not())then
         return !result
      endif
--<wd>jul2007<mds12>


--<wd>jul2007<mds12> -- Identified MARINE HULL HSTIFF elements, !sctn1 and !sctn2, the GTYP is either 'EANG' or 'UEAN'
      -- then check gtyp - must be ANGLE

--      if !sctn1.catr.gtyp.Matchwild('*ANG*').not() then
      if (!sctn1.catr.gtyp.eq('ANG').not()) and (!sctn1.catr.gtyp.eq('EANG').not()) and (!sctn1.catr.gtyp.eq('UEAN').not()) then
         return !result
      endif

--      if !sctn2.catr.gtyp.Matchwild('*ANG*').not() then
      if (!sctn2.catr.gtyp.eq('ANG').not()) and (!sctn2.catr.gtyp.eq('EANG').not()) and (!sctn2.catr.gtyp.eq('UEAN').not()) then
         return !result
      endif
--<wd>jul2007<mds12>

      -- compose plane of DATUM
      !orthoDir = !!mdsRemoveGrad(!datum)
        handle ANY
          return !result
        endhandle
      !ydir = !orthoDir[1]
      !datumzdir = !orthoDir[3].opposite()
      -- handle vertical pipes
      if !datum.typ.neq('CTSUPP') then
        if !datum.ldir.wrt(worl).eq(D wrt worl).or(!datum.ldir.wrt(worl).eq(U wrt worl)) then
           !ydir = !datum.pdir[9].opposite()
           !datumzdir = Up
        endif
      else
        if !datum.pdir[2].wrt(worl).eq(D wrt worl).or(!datum.pdir[2].wrt(worl).eq(U wrt worl)) then
          !ydir = !datum.pdir[9].opposite()
          !datumzdir = Up
        endif	
      endif

      !plane = object PLANE(!datum.pos,Y is $!datumzdir and Z is $!ydir )

      if !plane.xYoffset(!sctn1.pos).y.gt(0) then
         !nat = 'NAB'
         !nal = 'NAR'
      else
         !nat = 'NAT'
         !nal = 'NAL'
      endif

      if !datumzdir.angle(!sctn1.plor.$!<nat>.zdir()).lt(!datumzdir.angle(!sctn1.plor.$!<nal>.zdir())) then
         !dir1 = !sctn1.plor.rtta.zdir().wrt(worl)
         !zdir = !sctn1.plor.$!<nat>.zdir().wrt(worl)
      else
         !dir1 = !sctn1.plor.lboa.zdir().wrt(worl)
         !zdir = !sctn1.plor.$!<nal>.zdir().wrt(worl)
      endif

      if !datumzdir.angle(!sctn2.plor.$!<nat>.zdir()).lt(!datumzdir.angle(!sctn2.plor.$!<nal>.zdir())) then
         !dir2 = !sctn2.plor.rtta.zdir()
      else
         !dir2 = !sctn2.plor.lboa.zdir()
      endif

      !plane = object PLANE(!datum.pos,Y is $!ydir and Z is $!zdir )
      !xdir = !plane.orientation.xdir()

      if !plane.xYoffset(!sctn1.pos).x.gt(0) then
         !rdir = !dir1
         !ldir = !dir2
      else
         !rdir = !dir2
         !ldir = !dir1
      endif


      if !ldir.angle(!xdir).lt(1) then
         !lr = 'R'
      else
         !lr = 'L'
      endif
      if !rdir.angle(!xdir).lt(1) then
         !lr = !lr + 'R'
      else
         !lr = !lr + 'L'
      endif

      if !lr.eq('RR') then
         !result = 1
      elseif !lr.eq('LL') then
         !result = 2
      elseif !lr.eq('RL') then
         !result = 3
      elseif !lr.eq('LR') then
         !result = 4
      endif

-----------------------------------------
--<wd>oct2007<mds12> -- Defect No. P-2386
-- Use the passed variables !xsctn1 and !xsctn2 to determine if the MDS SUPPORT is ONLY "connected" to ONE element, e.g. FT03, FT04 etc...
--
      -- handle situation if there is one section only
      --if !sctn1.eq(!sctn2) then
      if !xsctn1.eq(!xsctn2) then
--
--<wd>oct2007<mds12> -- Defect No. P-2386
-----------------------------------------
            if !plane.xYoffset(!sctn1.pos).x.gt(0) then
               if !result.eq(1) then
                  !result = 3
               elseif !result.eq(2) then
                  !result = 4
               endif
            endif
      endif

--$P ** mdstmplori = $!result

      -- return result
      return !result


-- end of function
endfunction
