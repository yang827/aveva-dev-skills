--     Keyword:		MDS
--   Module:		design
--
-- Author:		Neale Morris
-- Created:		Wed Sept 2002
--
--
-- Description:
-- Set the tag of the standard list to the number available
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function

define function !!MdsHangerNum(!Form is FORM,!Prefix is STRING)

  if !Prefix.eq('VH') or !Prefix.eq('FH') then
    !NumberOfStandards = !Form.Standard.Dtext.size()
    !Form.Standard.Tag = 'Available Types: ($!NumberOfStandards)'
  endif

-- End function
endfunction

-- End of file MdsHangerNum.pmlfnc
