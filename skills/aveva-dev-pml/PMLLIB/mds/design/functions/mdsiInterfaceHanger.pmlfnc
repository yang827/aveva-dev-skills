--
-- File:    mdsiInterfaceHanger.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:          MdsIHANGER
--
-- Author:    A.boudjnah
-- Created:   Wed March 20 2002
--
--
-- Description:
-- Reads Defaults file for MDS and populates form variables for mdsInterfaceHanger.frm
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsiInterfaceHanger()

  -- If we are using a manufacturers interface from 11.6 we can hide the standards list
  -- We need to add a handle because pre 11.6 the visible method does not exist

  if !!mdsHangIf.neq('MDS') then
    !!mdsInterfaceHanger.standard.visible = FALSE
    handle ANY
    endhandle
  endif

  if(defined(!!mdsDEBUG))then
    !!mdsDEBUG.traceIn(1, '!!mdsiInterfaceHanger()')
  endif

  !currentunits = !!kgetsetunits()
  mm bore mm dist

  !!mdsInterfaceHanger.name.val = 'unset'
  !!mdsInterfaceHanger.ok.active = FALSE

  if(!!mdsInterfaceHanger.tubeRef.set() and (not !!mdsInterfaceHanger.tubeRef.badref())) then
    !toUnEnhance = !!mdsInterfaceHanger.tubeRef
    unenhance pipe of $!toUnEnhance
  endif

  !!mdsInterfaceHanger.tubeRef = object DBREF()

  if(!!mdsInterfaceHanger.beamRef.set() and !!mdsInterfaceHanger.beamRef.size() gt 0) then
    -- un enhance previous beams
    do !beamToUnEnhance values !!mdsInterfaceHanger.beamRef
      if(!beamToUnEnhance.set() and (not !beamToUnEnhance.badref()))then
        unenhance $!beamToUnEnhance
      endif
    enddo
  endif

  !!mdsInterfaceHanger.beamRef = ARRAY()
  -- Reactivate the 'ALL' button
  !!mdsInterfaceHanger.oRadio.toggleDefaultRadioOn()


  --<RM>REFACTOR REMOVED !!mdsInterfaceHanger.filterData.val = 'No Filter'
  -- Do not populate list
  !populateList = false
  if(not defined(!!mdsInterfaceAllHangertypes)) then
    -- Create a hanger type container containing all available hanger types
    !prompt = 'Loading Hangers Configurations. Please Wait...'
    prompt '$!prompt'
    !!mdsInterfaceAllHangertypes = object MDSINTERFACEHANGERTYPES(true)
    -- loads the DES-SUPP-HANG file
    -- Populate list
    !populateList = true
  endif

$(
  --<RM>REFACTOR - update as necessary
  !!mdsInterfaceHanger.hangerCategory = 'FH'
  --<RM>REFACTOR

  -- set the form varaiable member to point to that container
  -- Read defaults file to load selections
  if(!!mdsInterfaceHanger.hangerCategory.eq('FH'))then
    --    if(not defined(!!mdsstandardFHDtext)) then
    if(not defined(!!mdsstandardFHDtext) or !populateList) then
      !prompt = 'Loading Fixed Hangers Configurations. Please Wait...'
      prompt '$!prompt'
      !!mdsInterfaceHanger.standard.dtext = ARRAY()
      !!mdsInterfaceHanger.standard.rtext = ARRAY()
      !!mdsPopulate(!!mdsInterfaceHanger,'FIXED HANGER')
      !!mdsstandardFHDtext = !!mdsInterfaceHanger.standard.dtext
      !!mdsstandardFHRtext = !!mdsInterfaceHanger.standard.rtext
    endif
    !!mdsInterfaceHanger.standardDtexBackup = !!mdsstandardFHDtext
    !!mdsInterfaceHanger.standardRtexBackup = !!mdsstandardFHRtext
    -- get a filtered hanger type container object containg only variable hangers ('FH')
    !!mdsInterfaceHanger.formHangerTypes = !!mdsInterfaceAllHangertypes.getHangersForCategory('FH')
    handle ANY
      if !!mdsHangIf.upcase().eq('MDS') then
        !!alert.error('No Hanger templates for Fixed hangers')
      endif
    endhandle
    -- Display in the form title the interface being used
    if !!mdsHangIf.upcase().eq('LISEGA') then
      !!mdsInterfaceHanger.formtitle    = |Hangers using Lisega Interface|
    elseif !!mdsHangIf.upcase().eq('PSL') then
      !!mdsInterfaceHanger.formtitle    = |Hangers using PSL Interface|
    elseif !!mdsHangIf.upcase().eq('CPL') then
      !!mdsInterfaceHanger.formtitle    = |Hangers using WitchHanger Interface|
    else
      !!mdsInterfaceHanger.formtitle    = |Fixed Hangers using MDS Interface|
    endif
  elseif(!!mdsInterfaceHanger.hangerCategory.eq('VH'))then
    --    if(not defined(!!mdsstandardVHDtext)) then
    if(not defined(!!mdsstandardVHDtext) or !populateList) then
      !prompt = 'Loading Variable Hangers Configurations. Please Wait...'
      prompt '$!prompt'
      !!mdsInterfaceHanger.standard.dtext = ARRAY()
      !!mdsInterfaceHanger.standard.rtext = ARRAY()
      !!mdsPopulate(!!mdsInterfaceHanger,'VARIABLE HANGER')
      !!mdsstandardVHDtext = !!mdsInterfaceHanger.standard.dtext
      !!mdsstandardVHRtext = !!mdsInterfaceHanger.standard.rtext
    endif
    !!mdsInterfaceHanger.standardDtexBackup = !!mdsstandardVHDtext
    !!mdsInterfaceHanger.standardRtexBackup = !!mdsstandardVHRtext
    -- get a filtered hanger type container object containg only variable hangers ('VH')
    !!mdsInterfaceHanger.formHangerTypes = !!mdsInterfaceAllHangertypes.getHangersForCategory('VH')
    handle ANY
      if !!mdsHangIf.upcase().eq('MDS') then
        !!alert.error('No Hanger templates for Variable hangers')
      endif
    endhandle
    -- Display in the form title the interface being used
    if !!mdsHangIf.upcase().eq('LISEGA') then
      !!mdsInterfaceHanger.formtitle    = |Hangers using Lisega Interface|
    elseif !!mdsHangIf.upcase().eq('PSL') then
      !!mdsInterfaceHanger.formtitle    = |Hangers using PSL Interface|
    elseif !!mdsHangIf.upcase().eq('CPL') then
      !!mdsInterfaceHanger.formtitle    = |Hangers using WitchHanger Interface|
    else
      !!mdsInterfaceHanger.formtitle    = |Variable Hangers using MDS Interface|
    endif
  else
    !!alert.error('Hanger Category: $!!mdsInterfaceHanger.hangerCategory is unknown')
    $!currentunits
    if(defined(!!mdsDEBUG))then

      !!mdsDEBUG.traceError(1, 'Hanger Category: $!!mdsInterfaceHanger.hangerCategory is unknown')
    endif
    return
  endif
$)
  --<RM>REFACTOR removed!prompt = 'Creating a List of Variable Hangers Configurations. Please Wait...'
  --<RM>REFACTOR removedprompt '$!prompt'
  -- Activate the default filter (e.g. 'ALL')
  -- test 24/5/02 !!mdsInterfaceHanger.activateFilter(!!mdsInterfaceHanger.oRadio.defaultOn)
  -- re-added by <ab> 27/05/02

  --<RM>REFACTOR removed !!mdsInterfaceHanger.activateFilter(!!mdsInterfaceHanger.oRadio.defaultOn, true, true)
  --<RM>REFACTORprompt ''
  ----- Read defaults file to load selections

  -----  !!mdsPopulate(!!mdsInterfaceHanger,'FIXED HANGER')

  -- If an interface is turned on then the list gadget should be cleared

  if !!mdsHangIf.upcase().eq('LISEGA') then
    --<RM>REFACTOR removed !!mdsInterfaceHanger.standard.clear()
    !!mdsInterfaceHanger.formtitle    = |Hangers using Lisega Interface|
  elseif !!mdsHangIf.upcase().eq('PSL') then
    --<RM>REFACTOR removed !!mdsInterfaceHanger.standard.clear()
    !!mdsInterfaceHanger.formtitle    = |Hangers using PSL Interface|
  elseif !!mdsHangIf.upcase().eq('CPL') then
    --<RM>REFACTOR removed !!mdsInterfaceHanger.standard.clear()
    !!mdsInterfaceHanger.formtitle    = |Hangers using WitchHanger Interface|
  endif

  -- Check to see if all the standard for this type have been commented out
  --<RM>REFACTOR removed !unusedCheckVal = !!mdsInterfaceHanger.standard.dtext[1]
  --<RM>REFACTOR removed handle (61,567) (61,615)
  --<RM>REFACTOR removed  !!mdsInterfaceHanger.view.active = false
  --<RM>REFACTOR removed  !!mdsInterfaceHanger.name.active = FALSE
    !!kRestoreUnits(!currentunits)

    -- Only activate interface manufacturers interface environment variable is set

    if !!mdsHangIf.upcase().eq('LISEGA') then
      var !manifexe evar LICADMDSEXE
      if (!manifexe NEQ '') then
        !!manif = object MANIFFILES()
        !!manif.exe = object FILE(!manifexe )
      endif
    elseif !!mdsHangIf.upcase().eq('PSL') then
      var !manifexe evar PSLMDSEXE
      if (!manifexe NEQ '') then
        !!manif = object MANIFFILES()
        !!manif.exe = object FILE(!manifexe )
      endif
    elseif !!mdsHangIf.upcase().eq('CPL') then
      var !manifexe evar CPLMDSEXE
      if (!manifexe NEQ '') then
        !!manif = object MANIFFILES()
        !!manif.exe = object FILE(!manifexe )
      endif
    endif

    if ( defined(!!manif.exe)) then
      if (!!manif.exe.exists()) then
        if  (!!mdsHangIf.eq('LISEGA')) then
          !!mdsInterfaceHanger.name.active = TRUE
          !!mdsInterfaceHanger.manifactions()
        elseif  (!!mdsHangIf.eq('PSL')) then
          !!mdsInterfaceHanger.name.active = TRUE
          !!mdsInterfaceHanger.manifactions()
        elseif  (!!mdsHangIf.eq('CPL')) then
          !!mdsInterfaceHanger.name.active = TRUE
          !!mdsInterfaceHanger.manifactions()
        endif
      endif
    endif

    return

$(
  --<RM>REFACTOR removed  elsehandle none
  --<RM>REFACTOR removed    !!mdsInterfaceHanger.view.active = true
  --<RM>REFACTOR removed    !!mdsInterfaceHanger.name.active = true
  --<RM>REFACTOR removed  endhandle

  -- Store Current Support Form name and required function in Main form for use later
  !!mdsSetSupp(!!mdsInterfaceHanger)

  -- Set the name gadget as the focus

  !!mdsInterfaceHanger.name.setFocus()
  -- Reset the DAC global variable incase it has been left set to true

  !!mdsDacControl(false)
  $!currentunits
  if(defined(!!mdsDEBUG))then
    !!mdsDEBUG.traceOut(1, '!!mdsiInterfaceHanger()')
  endif

  -- <wd>18mar2004
  -- IMPORTANT NOTE:
  -- When form !!mdsInterfaceHanger is loaded into MDS the default setting of the RGROUP
  -- !!mdsInterfaceHanger.lisegagroup = 1 - i.e. 'On'
  -- Therefore if its set to 2 ('Off') the USER has switched it 'Off' and it should be KEPT 'Off'


  -- Only activate manufacturers interface if appropiate environment variable is set

  if !!mdsHangIf.upcase().eq('LISEGA') then
    var !manifexe evar LICADMDSEXE
    if (!manifexe NEQ '') then
      !!manif = object MANIFFILES()
      !!manif.exe = object FILE(!manifexe )
    endif
  elseif !!mdsHangIf.upcase().eq('PSL') then
    var !manifexe evar PSLMDSEXE
    if (!manifexe NEQ '') then
      !!manif = object MANIFFILES()
      !!manif.exe = object FILE(!manifexe )
    endif
  elseif !!mdsHangIf.upcase().eq('CPL') then
    var !manifexe evar CAPMDSEXE
    if (!manifexe NEQ '') then
      !!manif = object MANIFFILES()
      !!manif.exe = object FILE(!manifexe )
    endif
  endif

  if ( defined(!!manif.exe)) then
    if (!!manif.exe.exists()) then
      if  (!!mdsHangIf.eq('LISEGA')) then
        !!mdsInterfaceHanger.name.active = TRUE
      elseif  (!!mdsHangIf.eq('PSL')) then
        !!mdsInterfaceHanger.name.active = TRUE
      elseif  (!!mdsHangIf.eq('CPL')) then
        !!mdsInterfaceHanger.name.active = TRUE
      endif
    endif
  endif

  !!mdsInterfaceHanger.manifactions()
  --<wd>24aug2004 - Deactivate .filt6 icon
  !!mdsInterfaceHanger.filt6.active = FALSE
  !!mdsInterfaceHanger.filt6.val    = FALSE
  --<wd>24aug2004

  -- End function
$)

endfunction
