--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:              Wayne Dodwell
-- Created:             January 2004
--
--
-- Description:
-- Initialisation for form at23
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIat23(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsAT23.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  !callingForm = !!mdsGeneral

  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsAT23

  -- Initialise Standard gadgets
  !!mdsAT23.datum.active = true
  !!mdsAT23.cancel.active = true
  !!mdsAT23.rotate.active = true
  !!mdsAT23.bDist.active = true
  !!mdsAT23.dist.active = true
  !!mdsAT23.bThro.active = true
  !!mdsAT23.select.active = true
  !!mdsAT23.nudge.active = true
  !!mdsAT23.bedplate.active = true
  !!mdsAT23.connect.active = false
  !!mdsAT23.modify.active = false
  !!mdsAT23.forcecon.active = false
  !!mdsAT23.disconn.active = false
  !!mdsAT23.newdat.active = false
  !!mdsAT23.adploc.active = false

  !!mdsAT23.graphicaldim = false

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
    !!mdsAT23.cancel.callback = |Call !!mdsCancelSupp(!!mdsAT23)|
    !support.modify = false

    -- Activate the Pipe Type Rgroup
    !!mdsAT23.type.active = true
    !!mdsAT23.type.select('PIPE')

    -- Initialise variables for new supports
    !support.replace = !callingForm.replacement
    !support.type    = !callingForm.standard.selection('Rtext')
    !struName        = !callingForm.name.val

    -- Set Paragraph gadget on form
    !!mdsAT23.name.val = !struName
    !!mdsAT23.dist.val = 0
    !!mdsAT23.p.val = ''

    !!mdsAT23.mdsadp.active = false

    !!mdsAT23.bedplate.active = false

    !callingForm.hide()

  else

    -- Set callback on cancel button and set mode member of support object
    !!mdsAT23.cancel.callback = |Call !!mdsRestoreShoe(!!mdsAT23)|
    !support.modify = true
    !!mdsAT23.datum.active = false

    -- DeActivate the Pipe Type Rgroup but Set to the Correct Support Type
    !!mdsAT23.type.active = false
    !!cecomp = !!ce
    --q name type :mdssupptype
    --!!ce = !sref.dbref()
    --!!mdsAT23.type.select(!!ce.:mdssupptype)
    !!mdsAT23.type.select(!!ce.:mdscp3)
    !!ce = !!cecomp

    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Get bedplate references if set
    var !bpref1 :MDSBpref1
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedplate1 = !bpref1.dbref()
      !!mdsAT23.struBpref.clear()
      !!mdsAT23.struBpref.append(!name.dbref())
      !!mdsAT23.struBpref.append(!bpref1.dbref())
      -- Store original ref
      !!mdsAT23.storebpref.clear()
      !string = !bpref1.dbref()
      !!mdsAT23.storebpref.append(|:MDSBpref1 $!string|)
    endif

    -- Set Form Gadgets
    !!mdsAT23.name.val = !name
    !!mdsAT23.p.val    = ''

    !!mdsAddAll('$!textName')

  endif

  -- Store support object in form
  !!mdsAT23.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Set distance gadget
    !!mdsDistance(!!mdsAT23)

    -- Add marker text markers
    !!mdsaidtext(!!mdsAT23)
    -- Store Atta reference in form
    do !count from 211 to 259
      var !num ($!count - 210)
      !attaname = !name & '.' & !num
      !!ce = !attaname.dbref()
      handle any
        skip
      endhandle
      !!mdsAT23.support.atta.append(!!ce)
    enddo


  endif

  LABEL /CONT
  -- Redefine standard support name on form title

  !index = !callingForm.standard.rtext.findfirst('$!support.type')
  !text  = !callingForm.standard.dtext[!index]
  handle (61,567) (61,615)
    if !callingForm.string().eq('MDSGENERAL') then
      !!mdsPopulate(!!mdsGeneral,'GENERAL')
      !index = !!mdsGeneral.standard.rtext.findfirst('$!support.type')
      !text  = !!mdsGeneral.standard.dtext[!index]
    else
      !!mdsPopulate(!!mdsGuide,'GUIDE')
      !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
      !text  = !!mdsGuide.standard.dtext[!index]
    endif
  endhandle
  !title = 'GENERAL'
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsAT23.support.replace = !formName

  call !!mdsSetFormName(!!mdsAT23, '$!title', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    !colourList = ARRAY()
    do !addrepre values !!mdsAT23.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF') gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsAT23.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList.append(!!ce.name.dbref())
    enddo
    Call !!kEnhanceList(!colourList)
    !!ce = !support.datum
  endif

  -- Store current form information
  Call !!mdsStoreat23()

  -- Show Form
  !!kShowForm(!!mdsAT23)

  -- Reset Units
  !!kRestoreUnits(!currentUnits)

  --<sk> for preliminary support, set insulation/no insulation type
  if (not !support.modify) then
    -- check if preliminary
    !datum = object DBREF(!name)
    handle NONE
      if !datum.inth.boolean() then
        !!mdsAT23.type.select('SHOE')
      else
        !!mdsAT23.type.select('PIPE')
      endif
    elsehandle any
    endhandle
  endif
  !!mdsCreateGeneralFromPS (!form, !name)
  -- End function
endfunction
