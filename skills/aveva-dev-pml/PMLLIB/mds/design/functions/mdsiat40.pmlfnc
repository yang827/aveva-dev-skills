--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Wayne Dodwell
-- Created:  5th February 2003
--
--
-- Description:
-- Initialisation for form at40
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIat40(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsAT40.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- Find current units and set the distance unit to metric
  !currentunits = !!kGetSetUnits()

  !callingForm = !!mdsGeneral

  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsAT40

  -- Initialise Standard gadgets
  !!mdsAT40.datum.active = true
  !!mdsAT40.cancel.active = true
  !!mdsAT40.rotate.active = false
  !!mdsAT40.nudge.active = true
  !!mdsAT40.bedplate.active = true
  !!mdsAT40.connect.active = false
  !!mdsAT40.modify.active = false
  !!mdsAT40.forcecon.active = false
  !!mdsAT40.disconn.active = false
  !!mdsAT40.newdat.active = false
  !!mdsAT40.adploc.active = false
  !!mdsAT40.anccopy.active = false
  !!mdsAT40.ancnudge.active = false
  !!mdsAT40.nudge.active = false
  !!mdsAT40.deleteatta.active = false

  !!mdsAT40.graphicaldim = false

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq 'MODIFY')then
    -- CREATE Mode
    -- Set callback on cancel button and set mode member of support object
    !!mdsAT40.cancel.callback = |Call !!mdsCancelSupp(!!mdsAT40)|
    !support.modify = false

    -- Activate the Pipe Type Rgroup and Select the Correct option
    if (!alias inset ('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT100A','AT100B')) then
      !!mdsAT40.type.select('TRUNNION')
      !!mdsAT40.type.active   = true
      !!mdsAT40.dist.active   = false
      !!mdsAT40.bdist.active  = false
      !!mdsAT40.select.active = false
      !!mdsAT40.bthro.active  = false
    elseif (!alias inset ('AT101A','AT101B')) then
      !!mdsAT40.type.active = true
      !!mdsAT40.type.select('SHOE')
      !!mdsAT40.dist.active   = true
      !!mdsAT40.bdist.active  = true
      !!mdsAT40.select.active = true
      !!mdsAT40.bthro.active  = true
    else
      !!mdsAT40.type.active = true
      !!mdsAT40.type.select('PIPE')
      !!mdsAT40.dist.active   = true
      !!mdsAT40.bdist.active  = true
      !!mdsAT40.select.active = true
      !!mdsAT40.bthro.active  = true
    endif
    !!mdsAT40.tlength = 0
    !!mdsAT40.shoeref = nulref

    -- Initialise variables for new supports
    !support.replace = !callingForm.replacement
    !support.type    = !callingForm.standard.selection('Rtext')
    !struName        = !callingForm.name.val

    -- Set Paragraph gadget on form
    !!mdsAT40.name.val = !struName
    !!mdsAT40.dist.val = 0
    !!mdsAT40.p.val = ''

    !!mdsAT40.mdsadp.active = false

    !!mdsAT40.bedplate.active = false

    !callingForm.hide()

  else
    -- MODIFY Mode
    -- Set callback on cancel button and set mode member of support object
    !!mdsAT40.cancel.callback = |Call !!mdsRestoreShoe(!!mdsAT40)|
    !support.modify = true
    !!mdsAT40.datum.active = false

    -- DeActivate the Pipe Type Rgroup but Set to the Correct Support Type
    !!mdsAT40.type.active = false
    !cecomp = !!ce
    !!mdsAT40.type.select(!!ce.:mdscp3)
    !!ce = !cecomp
    -- Activate the Pipe Type Rgroup and Select the Correct option
    --if (!alias inset('AT35')) then
    if (!!ce.:mdscp3.eq('TRUNNION')) then
      !!mdsAT40.dist.active   = false
      !!mdsAT40.bdist.active  = false
      !!mdsAT40.select.active = false
      !!mdsAT40.bthro.active  = false

      -- Get the Existing Length of the Associated Trunnion Branch
      !!ce = !cecomp.owner
      pin 9 copy ph
      pin 8 copy pt
      pin 9 dir d

      pin 9 plane d thro p0 of href
      !xtrlen = !!kstrreal('cons dist pin 9 to plane pin 8')
      !!mdsresetpins(8,9)
      !!mdsAT40.tlength = !xtrlen

    else
      !!mdsAT40.dist.active   = true
      !!mdsAT40.bdist.active  = true
      !!mdsAT40.select.active = true
      !!mdsAT40.bthro.active  = true
    endif


    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Get bedplate references if set
    var !bpref1 :MDSBpref1
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedplate1 = !bpref1.dbref()
      !!mdsAT40.struBpref.clear()
      !!mdsAT40.struBpref.append(!name.dbref())
      !!mdsAT40.struBpref.append(!bpref1.dbref())
      -- Store original ref
      !!mdsAT40.storebpref.clear()
      !string = !bpref1.dbref()
      !!mdsAT40.storebpref.append(|:MDSBpref1 $!string|)
    endif

    -- Set Form Gadgets
    !!mdsAT40.name.val = !name
    !!mdsAT40.p.val    = ''
    !!mdsAddAll('$!textName')
    !!mdsAT40.shoeref  = !support.datum.:mdsguideref

  endif

  -- Store support object in form
  !!mdsAT40.support = !support

  if (!modify.upcase() eq 'MODIFY') then
    -- Set distance gadget
    !!mdsDistance(!!mdsAT40)

    -- Add marker text markers
    !!mdsaidtext(!!mdsAT40)
    -- Store Atta reference in form
    do !count from 211 to 259
      var !num ($!count - 210)
      !attaname = !name & '.' & !num
      !!ce = !attaname.dbref()
      handle any
        skip
      endhandle
      !!mdsAT40.support.atta.append(!!ce)
    enddo


  endif

  LABEL /CONT
  -- Redefine standard support name on form title

  !index = !callingForm.standard.rtext.findfirst('$!support.type')
  !text  = !callingForm.standard.dtext[!index]
  handle (61,567) (61,615)
    if !!callingForm.string().eq('MDSGENERAL') then
      !!mdsPopulate(!!mdsGeneral,'GENERAL')
      !index = !!mdsGeneral.standard.rtext.findfirst('$!support.type')
      !text  = !!mdsGeneral.standard.dtext[!index]
    else
      !!mdsPopulate(!!mdsGuide,'GUIDE')
      !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
      !text  = !!mdsGuide.standard.dtext[!index]
    endif
  endhandle
  !title = 'GENERAL'
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsAT40.support.replace = !formName

  call !!mdsSetFormName(!!mdsAT40, '$!title', '$!formName')

  -- If modify put members into repre member of form
  if (!modify.upcase() eq 'MODIFY')then
    !colourList = ARRAY()
    do !addrepre values !!mdsAT40.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF') gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsAT40.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      Call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList.append(!!ce.name.dbref())
    enddo
    Call !!kEnhanceList(!colourList)
    !!ce = !support.datum
  endif

  -- Store current form information
  Call !!mdsStoreat40()

  -- Show Form
  !!kShowForm(!!mdsAT40)

  -- Reset Units
  !!kRestoreUnits(!currentunits)

  --<sk> for preliminary support, set insulation/no insulation type
  if (not !support.modify) then
    -- check if preliminary
    !datum = object DBREF(!name)
    handle NONE
      -- <SK> Force form mode. The following code is copied from MDSAT40.stype() method
      if (!support.alias inset ('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT100A','AT100B')) then
        -- must be trunnion
        !!mdsAT40.type.select('TRUNNION')
      elseif (!support.alias inset ('AT40A','AT40B','AT40C','AT40D','AT40E','AT40F','AT41A','AT41B','AT41C','AT41D','AT41E','AT41F','AT42','AT101A','AT101B')) then
        -- if insulated, turn on shoe mode
        if !datum.inth.boolean() then
          !!mdsAT40.type.select('SHOE')
        else
          -- pipe mode
          !!mdsAT40.type.select('PIPE')
        endif
      endif

    elsehandle any
    endhandle
  endif
  !!mdsCreateGeneralFromPS (!form, !name)

endfunction
