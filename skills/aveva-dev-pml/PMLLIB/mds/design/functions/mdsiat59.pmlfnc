-- File:  mdsiat59.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Wayne Dodwell
-- Created:  7th October 2003
--
--
-- Description:
-- Initialisation for form at59
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsiat59(!modify is STRING, !textname is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsAT59.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- Find current units and set the distance unit to metric
  !currentunits = !!kgetsetunits()

  !callingform = !!mdsgeneral

  -- Initialise Variables
  !name = '/' & !textname
  !form = !!mdsAT59

  -- Initialise Standard gadgets
  !!mdsAT59.datum.active = true
  !!mdsAT59.cancel.active = true
  !!mdsAT59.connect.active = false
  !!mdsAT59.modify.active = false
  !!mdsAT59.forcecon.active = false
  !!mdsAT59.disconn.active = false
  !!mdsAT59.newdat.active = false
  !!mdsAT59.adploc.active = false
  !!mdsAT59.anccopy.active = false
  !!mdsAT59.ancnudge.active = false
  !!mdsAT59.nudge.active = false
  !!mdsAT59.deleteatta.active = false
  !!mdsAT59.graphicaldim = false
  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotatecur = false
  !support.handedcur = false
  !support.rotated   = 0
  !support.bpnum     = 1
  !support.alias     = !alias

  !xce = !!ce
  -----------------------------------------------------------------------------------
  if (!modify.upcase() neq 'MODIFY')then
    -- CREATE Mode
    -- Set callback on cancel button and set mode member of support object
    !!mdsAT59.cancel.callback = |call !!mdscancelsupp(!!mdsAT59)|
    !support.modify = false

    -- Activate the Pipe Type Rgroup and Select the Correct option
    !!mdsAT59.dist.active   = false
    !!mdsAT59.bdist.active  = false
    !!mdsAT59.select.active = false
    !!mdsAT59.bthro.active  = false
    !!mdsAT59.tlength = 0
    !!mdsAT59.shoeref = nulref
    -- Initialise variables for new supports
    !support.replace = !callingform.replacement
    !support.type    = !callingform.standard.selection('Rtext')
    !struname        = !callingform.name.val
    -- Set Paragraph gadget on form
    !!mdsAT59.name.val = !struname
    !!mdsAT59.dist.val = 0
    !!mdsAT59.p.val = ''
    !!mdsAT59.mdsadp.active = false
    !!mdsAT59.bedplate.active = false
    !callingform.hide()

  else
    -- MODIFY Mode

    -- Set callback on cancel button and set mode member of support object
    !!mdsAT59.cancel.callback = |call !!mdsrestoreshoe(!!mdsAT59)|
    !support.modify = true
    !!mdsAT59.datum.active = false

    -- Activate the Pipe Type Rgroup and Select the Correct option
    if (!!ce.:mdscp3.eq('TRUNNION')) then
      !!mdsAT59.dist.active   = false
      !!mdsAT59.bdist.active  = false
      !!mdsAT59.select.active = false
      !!mdsAT59.bthro.active  = false
      !!mdsAT59.bedplate.active = false
      !!mdsAT59.cancel.active = false
      -- Get the Existing Length of the Associated Trunnion Branch
      !!ce = !!ce.owner
      pin 9 copy ph
      pin 8 copy pt
      pin 9 dir d
      pin 9 plane d thro p0 of href
      !xtrlen = !!kstrreal('cons dist pin 9 to plane pin 8')
      !!mdsresetpins(8,9)
      !!mdsAT59.tlength = !xtrlen
    endif

    -- Store Data in support object
    !support.type     = ( :mdssupptype of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.padir  = pa dir wrt world
    !support.pldir  = pl Dir wrt world
    !support.p9dir  = p9 dir wrt world
    !support.datum  = !name.dbref()

    -- Get bedplate references if set
    var !bpref1 :mdsbpref1
    if (!!ce.:mdsbpref1.badref().not()) then
      !support.bedplate1 = !bpref1.dbref()
      !!mdsAT59.strubpref.clear()
      !!mdsAT59.strubpref.append(!name.dbref())
      !!mdsAT59.strubpref.append(!bpref1.dbref())
      -- Store original ref
      !!mdsAT59.storebpref.clear()
      !string = !bpref1.dbref()
      !!mdsAT59.storebpref.append(|:mdsbpref1 $!string|)
    endif

    -- Set Form Gadgets
    !!mdsAT59.name.val = !name
    !!mdsAT59.p.val    = ''
    !!mdsaddall('$!textname')
    !!mdsAT59.shoeref  = !support.datum.:mdsguideref

  endif
  -- End of CREATE and MODIFY Modes
  -----------------------------------------------------------------------------------

  -- Store support object in form
  !!mdsAT59.support = !support

  if (!modify.upcase() eq 'MODIFY') then
    -- Set distance gadget
    !!mdsdistance(!!mdsAT59)
    -- Add marker text markers
    !!mdsaidtext(!!mdsAT59)
    -- Store Atta reference in form
    do !count from 211 to 259
      var !num ($!count - 210)
      !attaname = !name & '.' & !num
      !!ce = !attaname.dbref()
      handle any
        skip
      endhandle
      !!mdsAT59.support.atta.append(!!ce)
    enddo
  endif

  LABEL /CONT
  -- Redefine standard support name on form title
  !index = !callingform.standard.rtext.findfirst('$!support.type')
  !text  = !callingform.standard.dtext[!index]
  handle (61,567) (61,615)
    if (!!callingform.string().eq('MDSGENERAL')) then
      !!mdsPopulate(!!mdsgeneral,'GENERAL')
      !index = !!mdsgeneral.standard.rtext.findfirst('$!support.type')
      !text  = !!mdsgeneral.standard.dtext[!index]
    else
      !!mdsPopulate(!!mdsGuide,'GUIDE')
      !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
      !text  = !!mdsGuide.standard.dtext[!index]
    endif
  endhandle
  !title = 'GENERAL'
  !suppnumber = before(!text, '-')
  !formname   = !suppnumber.trim()
  !!mdsAT59.support.replace = !formname

  call !!mdssetformname(!!mdsAT59, '$!title', '$!formname')

  -- If modify put members into repre member of form
  if (!modify.upcase() eq 'MODIFY')then
    !colourlist = ARRAY()
    do !addrepre values !!mdsAT59.support.atta
      !!ce = !addrepre
      skip if (match(name,'SREF') gt 0)
      !colour = !!kfinddrawColour(!!ce)
      !branname = !!ce.owner.string()
      !!mdsAT59.repre.append('!!mdsremadd(|$!branname|,$!colour)')
      -- Add to model at level set by !!mdsoptions.levchange value
      call !!kreprelevel(!!ce, 'PIPE',!!mdsoptions.levchange, $!colour)
      !colourlist.append(!!ce.name.dbref())
    enddo
    call !!kenhancelist(!colourlist)
    !!ce = !support.datum
  endif

  -- Store current form information
  call !!mdsstoreat59()

  -- Show Form
  !!kshowform(!!mdsAT59)

  -- Reset Units
  !!kRestoreUnits(!currentunits)

  !!ce = !xce

  !!mdsCreateGeneralFromPS (!form, !name)

endfunction
