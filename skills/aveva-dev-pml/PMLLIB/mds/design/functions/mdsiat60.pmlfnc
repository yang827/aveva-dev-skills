--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Initialisation for form AT60
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsIAT60(!modify is STRING, !textName is STRING,!alias is STRING)

  --------------------------------------------
  -- Check to see if form is already shown
  --------------------------------------------

  if !!mdsAT60.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif
  !callingForm = !!mdsGeneral
  -- Find current units and set the distance unit to metric
  !currentunits = !!kGetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName
  !form = !!mdsAT60

  -- Initialise Standard gadgets
  !!mdsAT60.datum.active = true
  !!mdsAT60.cancel.active = true
  !!mdsAT60.rotate.active = false
  !!mdsAT60.rotatt.active = false
  !!mdsAT60.deleteatta.active = false
  !!mdsAT60.bDist.active = false
  !!mdsAT60.dist.active = false
  !!mdsAT60.bThro.active = false
  !!mdsAT60.select.active = true
  !!mdsAT60.nudge.active = false
  !!mdsAT60.bedplate.active = false
  !!mdsAT60.connect.active = false
  !!mdsAT60.modify.active = false
  !!mdsAT60.forcecon.active = false
  !!mdsAT60.disconn.active = false
  !!mdsAT60.newdat.active = false
  !!mdsAT60.adploc.active = false
  !!mdsAT60.graphicaldim = false
  !!mdsAT60.anccopy.active = false
  !!mdsAT60.ancnudge.active = false


  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
    !!mdsAT60.cancel.callback = |Call !!mdsCancelSupp(!!mdsAT60)|
    !support.modify = false
    -- Initialise variables for new supports
    !support.replace = !callingForm.replacement
    !support.type    = !callingForm.standard.selection('Rtext')
    !struName        = !callingForm.name.val

    -- Set Paragraph gadget on form
    !!mdsAT60.name.val = !struName
    !!mdsAT60.dist.val = 0
    !!mdsAT60.p.val = ''
    !callingForm.hide()

  else

    -- Set callback on cancel button and set mode member of support object
    !!mdsAT60.cancel.callback = |Call !!mdsRestoreShoe(!!mdsAT60)|
    !support.modify = true
    !!mdsAT60.datum.active = false

    -- Store Data in support object
    !support.type     = ( :MDSSuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Get bedplate references if set
    var !bpref1 :MDSBpref1
    if (!!ce.:MDSBpref1.badref().not()) then
      !support.bedplate1 = !bpref1.dbref()
      !!mdsAT60.struBpref.clear()
      !!mdsAT60.struBpref.append(!name.dbref())
      !!mdsAT60.struBpref.append(!bpref1.dbref())
      -- Store original ref
      !!mdsAT60.storebpref.clear()
      !string = !bpref1.dbref()
      !!mdsAT60.storebpref.append(|:MDSBpref1 $!string|)
    endif

    -- Set Form Gadgets
    !!mdsAT60.name.val = !name
    !!mdsAT60.p.val    = ''

    !!mdsAddAll('$!textName')

  endif

  -- Store support object in form
  !!mdsAT60.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Set distance gadget
    !!mdsDistance(!!mdsAT60)

    -- Add marker text markers
    !!mdsaidtext(!!mdsAT60)
    -- Store Atta reference in form
    do !count from 211 to 259
      var !num ($!count - 210)
      !attaname = !name & '.' & !num
      !!ce = !attaname.dbref()
      handle any
        skip
      endhandle
      !!mdsAT60.support.atta.append(!!ce)
    enddo

  endif

  label /CONT

  -- Redefine standard support name on form title

  !index = !callingForm.standard.rtext.findfirst('$!support.type')
  !text  = !callingForm.standard.dtext[!index]
  handle (61,567) (61,615)
    if !!callingForm.string().eq('MDSGENERAL') then
      !!mdsPopulate(!!mdsGeneral,'GENERAL')
      !index = !!mdsGeneral.standard.rtext.findfirst('$!support.type')
      !text  = !!mdsGeneral.standard.dtext[!index]
    else
      !!mdsPopulate(!!mdsGuide,'GUIDE')
      !index = !!mdsGuide.standard.rtext.findfirst('$!support.type')
      !text  = !!mdsGuide.standard.dtext[!index]
    endif
  endhandle
  !title = 'GENERAL'
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsAT60.support.replace = !formName

  call !!mdsSetFormName(!!mdsAT60, '$!title', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    !colourList = ARRAY()
    do !addrepre values !!mdsAT60.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF') gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsAT60.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      -- Add to model at level set by !!mdsOptions.levChange value
      call !!kRepreLevel(!!ce, 'PIPE',!!mdsOptions.levChange, $!colour)
      !colourList.append(!!ce.name.dbref())
    enddo
    call !!kEnhanceList(!colourList)
    !!ce = !support.datum
  endif

  -- Store current form information
  call !!mdsStoreAT60()

  -- Show Form
  !!kShowForm(!!mdsAT60)

  -- Reset Units
  !!kRestoreUnits(!currentunits)

  !!mdsCreateGeneralFromPS (!form, !name)

endfunction
