--
--
--
--  Description:  Function to identify preliminary support
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsIdPreliminarySupp(!form is FORM)

  do
    !atta = !!mdsSinglePick('ATTA','Identify preliminary support(ATTA)')
    if !atta.unset() then
      !!alert.error('The identified support atta is not set - cannot continue')
      return
    endif
    if !atta.spown.neq(/MDP ) then
      !!alert.error('The identified support is not a preliminary support')
      skip
    endif
    -- skip if support is readonly
    if !atta.dbwrite.not() then
      !!alert.error('The identified support must be in RW database.')
      skip
    endif
    -- check if support is locked
    if !atta.lock then
      !!alert.error('The identified support is locked - cannot continue.')
      skip
    endif

    --check for valid claim
    if !atta.okcla.not() then
      if !atta.lclm.not() then
        !!alert.error('The identified support cannot be claimed - cannot continue.')
        skip
      endif
    endif

    break
  enddo

  !form.name.val = !atta.namn
  -- Mdsnamespl has no listactions
  if (defined(!form.listactions)) then
    !!kactioncommands(!form.listactions)
  endif

endfunction
