--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsift69(!mode is STRING, !textName is STRING,!dummyAlias is STRING)

  -- Check to see if form is already shown
  if !!mdsFT69.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif
  -- <sk> 04/06/2012
  !fromAtta = false

  -- get crossbar of first template
  !crossbar = object DBREF('/MDS/FT69/1-BAR-1')
  handle ANY
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    return
  endhandle

  !name = '/' & !textName
  !support = object MDSFTSIXTYNINE()

  !currentunits = !!kgetsetunits()

  !modify = !mode.eq('MODIFY')
  --!create = !modify.not()

  -- get default dimension from crossbar of first template
  !dim1 = !crossbar.cutl


  if !modify then
  -- MODIFY mode

    !stru = !name.dbref()
    !support = object MDSFTSIXTYNINE(!stru)
    handle ANY
      !!alert.error(!!error.text)
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    !!mdsFT69.cancel.callback = |call !!mdsrestoreform(!!mdsFT69)|
    !support.modify = TRUE
    !!mdsFT69.datum.active = false
    !sref = !support.sref()
    !dim1 = !sref.desp[1]
    handle ANY
    endhandle
    !!mdsSetSuppCode('MODIFY',!name,'FT69',!sref.styp)

  else
  -- CREATE mode
    !!mdsFT69.cancel.callback = |call !!mdscancelsupp(!!mdsFT69)|
    !support.modify = false

    !!mdsFrame.hide()
    -- Navigate to correct area
    if !!mdsMoveToSite('').not() then
      !!kRestoreUnits(!currentunits)
      return
    endif
    !!mdsDacControl(true)
    -- Create Stru
    --<sk> 04/06/2012
    -- Check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      -- rename preliminary support
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --<sk> 04/06/2012
    !support.createStru(!name)
    !!mdsSetSuppCode('CREATE',!name,'FT69','FT69-1')

  endif

  !!mdsFT69.dim1.val = !dim1

  !!mdsFT69.support = !support
  !!mdsFT69.show()

  !!kRestoreUnits(!currentunits)

  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!!mdsFT69, !datum)
  endif
endfunction
