--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsift70(!mode is STRING, !textName is STRING,!dummyAlias is STRING)

  -- Check to see if form is already shown
  if !!mdsFt70.shown() then
    !!alert.error('Unable to show form as it is already displayed')
    return
  endif

  -- <sk> 04/06/2012
  !fromAtta = false

  -- check templates if exist
  !tmpl = object DBREF('/MDS/FRAMES/FT70')
  handle ANY
    !!alert.error('Cannot find templates for this configuration. Please contact your PDMS administrator')
    return
  endhandle

  !name = '/' & !textName
  !support = object MDSFTSEVENTY()
  !currentunits = !!kgetsetunits()

  !modify = !mode.eq('MODIFY')
  --!create = !modify.not()

  -- dimensions
  !dim1 = 0
  !dim2 = 0


  if !modify then
  -- MODIFY mode

    !stru = !name.dbref()
    !support = object MDSFTSEVENTY(!stru)
    handle ANY
      !!alert.error(!!error.text)
      !!kRestoreUnits(!currentunits)
      return
    endhandle

    !!mdsft70.cancel.callback = |call !!mdsrestoreform(!!mdsft70)|
    !support.modify = TRUE
    !!mdsft70.datum.active = false

    !sref = !support.sref()
    !dim1 = !sref.desp[1]
    handle ANY
    endhandle
    !dim2 = !sref.desp[2]
    handle ANY
    endhandle

    !!mdsSetSuppCode('MODIFY',!name,'FT70',!sref.styp)

  else
  -- CREATE mode

    !!mdsft70.cancel.callback = |call !!mdscancelsupp(!!mdsft70)|
    !support.modify = false

    !!mdsFrame.hide()
    -- Navigate to correct area
    if !!mdsMoveToSite('').not() then
      !!kRestoreUnits(!currentunits)
      return
    endif
    !!mdsDacControl(true)
    -- Create Stru

    --<sk> 04/06/2012
    -- Check if support with given name exists already (can be preliminary support)
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      -- rename preliminary support
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --<sk> 04/06/2012

    !support.createStru(!name)
    !!mdsSetSuppCode('CREATE',!name,'FT70','FT70-1')

  endif

  !!mdsFt70.dim1.val = !dim1
  !!mdsFt70.dim2.val = !dim2

  !!mdsFt70.support = !support
  !!mdsFt70.show()

  !!kRestoreUnits(!currentunits)


  --<sk> 04/06/2012
  if !fromAtta then
    -- call creation of support datum from given preliminary support
    !!mdsCrDatumFromPs(!!mdsft70, !datum)
  endif

endfunction
