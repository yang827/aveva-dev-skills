--
-- File:  mdsigt20.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Initialisation for form Gt20
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--

-- Define Function
define function !!mdsIGt20(!modify is STRING, !textName is STRING,!alias is STRING)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Initialise Variables
  !name = '/' & !textName
  --<ak> 21/06/2012
  !form = !!mdsGt20
  !fromAtta = false
  --</ak>

  -- Initialise Standard gadgets
  !!mdsGt20.datum.active = true
  !!mdsGt20.cancel.active = true

  -- Create Support object
  !support = object MDSSUPPORT()
  !support.position  = false
  !support.mirror    = false
  !support.rotateCur = false
  !support.handedCur = false
  !support.rotated   = 0
  !support.bPNum     = 1
  !support.alias     = !alias

  if (!modify.upcase() neq 'MODIFY')then

    -- Set callback on cancel button and set mode member of support object
    !!mdsGt20.cancel.callback = |Call !!mdsCancelSupp(!!mdsGt20)|
    !support.modify = false

    -- Initialise variables for new supports
    !support.replace = !!mdsGuide.replacement
    !support.type    = !!mdsGuide.standard.selection('Rtext')
    !struName        = !!mdsGuide.name.val

    --<ak> 21/06/2012
    !datum = object DBREF(!name)
    handle NONE
      !fromAtta = true
      !support.preliminaryStore = !!mdsSavePreInf(!datum)
      !datum.name = !name & '_Pre'
    elsehandle ANY
    endhandle
    --</ak>

    -- Set Paragraph gadget on form
    !!mdsGt20.name.val = !struName

    -- Height
    -- !!mdsGt20.height.active = false
    -- !!mdsGt20.pHeight.active = false
    -- !!mdsGt20.height.val = 0
    -- Length
    --      !!mdsGt20.length.active = false
    --     !!mdsGt20.pLength.active = false
    --     !!mdsGt20.length.val = 0
    -- Clearance
    --  !!mdsGt20.clearance.active = false
    --   !!mdsGt20.pClearance.active = false
    --    !!mdsGt20.clearance.val = 0
    -- Set buttons
    -- !!mdsGt20.setDefault.active = false

    !!mdsGuide.hide()

  else

    -- Set callback on cancel button and set mode member of support object
    !!mdsGt20.cancel.callback = |Call !!mdsRestoreShoe(!!mdsGt20)|
    !support.modify = true
    !!mdsGt20.datum.active = false

    -- Store Data in support object
    !support.type     = ( :SuppType of $!name )
    !support.position = true

    -- Store Atta reference's in object
    !support.atta.append(!name.dbref())

    -- Navigate to existing support datum
    !!ce = !name.dbref()
    !support.pADir  = Pa Dir wrt world
    !support.pLDir  = Pl Dir wrt world
    !support.p9Dir  = P9 Dir wrt world
    !support.datum  = !name.dbref()

    -- Get bedplate references if set
    var !bpref1 :BPREF1
    if (!!ce.:Bpref1.badref().not()) then
      !support.bedPlate1 = !bpref1.dbref()
      !!mdsGt20.struBpref.clear()
      !!mdsGt20.struBpref.append(!name.dbref())
      !!mdsGt20.struBpref.append(!bpref1.dbref())
      -- Store original ref
      !!mdsGt20.storebpref.clear()
      !string = !bpref1.dbref()
      !!mdsGt20.storebpref.append(|:BPREF1 $!string|)
    endif

    -- Set Form Gadgets
    !!mdsGt20.name.val = !name

    !!mdsAddAll('$!textName')

  endif

  -- Store support object in form
  !!mdsGt20.support = !support

  if (!modify.upcase() eq 'MODIFY') then

    -- Add marker text markers

    VAR !pOS POS WRT WORLD
    $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

    -- Set Length and Clearance gadgets

    !bore = pa bore

    !!mdsGetProp(!!mdsGt20.length,!!mdsGt20.pLength,'LEN',!bore,!support.type)
    !!mdsGetProp(!!mdsGt20.clearance,!!mdsGt20.pClearance,'CLR',!bore,!support.type)
    -- !!mdsGetProp(!!mdsGt20.height,!!mdsGt20.pHeight,'HEI',!bore,!support.type)

    -- Set buttons
    !!mdsGt20.setDefault.active = true

    -- Store pos.ori and despar in case user cancel form
    !!mdsGt20.support.oldposition = POS WRT /*
    !!mdsGt20.support.oldorientation = ORI WRT /*
    !!mdsGt20.support.olddespars = despar
    !!mdsGt20.support.oldspref = !!ce.spref

  endif

  LABEL /CONT

  -- Redefine standard support name on form title
  !index = !!mdsGuide.standard.rtext.findfirst('GT20')
  !text  = !!mdsGuide.standard.dtext[!index]
  handle (61,567) (61,615)
    !!mdsPopulate(!!mdsGuide,'GUIDE')
    !index = !!mdsGuide.standard.rtext.findfirst('Gt20')
    !text  = !!mdsGuide.standard.dtext[!index]
  endhandle
  !title = 'GUIDE'
  !suppNumber = before(!text, '-')
  !formName   = !suppNumber.trim()
  !!mdsGt20.support.replace = !formName

  call !!mdsSetFormName(!!mdsGt20, '$!title', '$!formName')

  -- If modify put members into repre member of form

  if (!modify.upcase() eq 'MODIFY')then
    do !addrepre values !!mdsGt20.support.atta
      !!ce = !addrepre
      skip if (match(Name,'SREF')gt 0)
      !colour = !!kFindDrawColour(!!ce)
      !branName = !!ce.owner.string()
      !!mdsGt20.repre.append('!!mdsRemAdd(|$!branName|,$!colour)')
      !!kRepreLevel(!!ce, 'PIPE', 7,$!colour)
      !colourList = ARRAY()
      !colourList.append(!!ce.name.dbref())
      Call !!kEnhanceList(!colourList)
    enddo
  endif

  -- Show Form
  !!kShowForm(!!mdsGt20)


  -- Reset Units

  !!kRestoreUnits(!currentUnits)

  if !fromAtta then
    !!mdsCrDatumFromPs(!form, !datum)
  endif

endfunction
