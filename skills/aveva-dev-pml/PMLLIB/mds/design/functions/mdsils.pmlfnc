-- Created:		27/11/2006
--
--
-- Description:
-- function to display lighting support form !!Mdsls01 in modify mode
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define function
define function !!Mdsils(!SuppName is STRING)

   if !!mdsls01.shown() then
      return error 1 'Form "$!!mdsls01.Formtitle" already displayed'
   endif

   !!ce = $!SuppName
     handle ANY
       !!ce = /$!SuppName
     endhandle

   !!mdsls01.init('modify')

-- End of function
endfunction

-- End of file mdsils.pmlfnc
