--
--  Description:     -- Function to output insulation error message--
--
----------------------------------------------------------------------
--
-- Description:
-- Function to output insulation error message
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        FORM       Form Object where the MDS Support is being Selected from.
--     2      R        DBREF      Identified Pipe Component
--     3      R        STRING     Error Message
--     4      R        STRING     Current Project Units
--
-- Return:
--    [Data Type]   [Description]
--      BOOLEAN      Returns TRUE if the Identified Pipe Bore EXCEEDS the Allowable
--                   Minimum or Maximum Nominal Pipe Size (NPS)
--                   on the CURRENT MDS Steelwork Template
--
--------------------------------------------------------------------------------

  define function !!mdsInsulationError(!currentUnits is COMUNITS, !min is STRING, !max is STRING, !replace is STRING)

  -- Initialise Variables
  VAR !insu INSU
  -- check the saved distance units (not the current units which is probably temporarily set to mm)
  if (!currentUnits.isImperialSavedDist()) then
    !units = 'in'
  else
    !units = 'mm'
  endif
  !strMaxVal = object REAL( !max )
  !maxVal    = !strMaxVal.string(!!distanceFmt)
  !strMinVal = object REAL( !min )
  !minVal    = !strMinVal.string(!!distanceFmt)
  !strInsVal = object REAL( !insu )
  !insVal    = !strInsVal.string(!!distanceFmt)
  !!alert.message ('The INSULATION on the identified pipe ($!<insVal>) is not within the MIN ($!<minVal>) and MAX ($!<maxVal>) limits of the Insulation Thickness Values for the selected ancillary support type, i.e. $!replace')

  endfunction
