--
-- Description:
-- function to get direction to move atta on sloping pipes
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function

define function !!mdsinterfacegetmovedir(!atta is DBREF,!mode is STRING, !form is FORM) is ARRAY

  --REFACTOR set units for use with imperial
  var !units units
  !!kGetSetUnits()

  !result = ARRAY()

  --find the hangertype number from the form name and run the appropriate getmovedir function
  !type = !form.name().after('MDSHANGERTYPE')
  !function = '!!mdsGetMoveDirHangerType' + !type

  !result = $!function(!atta,!mode)
  handle ANY
    --REFACTOR set units back to imperial if using
    units $!units
  elsehandle NONE
    --REFACTOR set units back to imperial if using
    units $!units
  endhandle

  return !result

endfunction
