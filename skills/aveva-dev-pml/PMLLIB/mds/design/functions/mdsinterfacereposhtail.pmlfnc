--
-- File:    mdsinterfacereposhtail.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    D.flannery
-- Created:   Mon Dec 12 2005
--
--
-- Description:
-- function to move hanger tail if dynamic parallel to pipe
-- when moving atta along pipe
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         dbref        datum
--     2
--     3
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function

define function !!mdsinterfacereposhtail(!datum is DBREF, !form is FORM)

  !htpos = !datum.cref.tposition.wrt( /* )
  !datumpos = !datum.position.wrt( /* )

  --dun1218 check for virtual fittings (fittings first then CMPF in case of panels
  if !form.virtualFitting.set() then
    !virtualFitting = TRUE
  else
    !virtualFitting = FALSE
  endif

  if !virtualFitting then
    !fittpos = !form.virtualFitting.getPosition()
    !sctnref = !form.virtualFitting.owner
  else
    !fittpos = !datum.cref.tref.position.wrt( /* )
    !sctnref = !datum.cref.tref.owner
    !fittref = !datum.cref.tref
  endif
  -- Check type of support is dynamic ( 7 only)
  if !!mdsInterfaceHanger.confignumber.eq(7) then

    pin 1 at $!htpos
    pin 2 at $!fittpos
    var !dist const dist pin 1 to pin 2
    !datumdir = !!mdsremovegrad(!datum)
    -- check tail and fitt position still in the same place.
    -- if not see if greater than 300 then smallest dynamic strut used
    if !dist.real().gt(300) then
      -- first time through to convert it to be a parallel dynamic support
      var !pin1topin2 const dir pin 1 to pin 2
      !dir = !pin1topin2.direction()
      -- if datumdir and !dir are within defined angles then hanger must be a parallel type
      if ( !dir.angle(!datumdir[1]).lt(.1) and !dir.angle(!datumdir[1]).gt(-.1) ) or ( !dir.angle(!datumdir[1]).gt(179.9) and !dir.angle(!datumdir[1]).lt(180.1)) then
        pin 3 at $!datumpos
        pin 3 dir $!datumdir[1]
        pin 4 copy pin 3
        pin 4 plane pin 4 through pin 2
        var !newhtdir const dir pin 1 to pin 3
        !closestPline = !!kClosestPline(!sctnref,!datumpos, !newhtdir.direction())
        -- We only need the pline that can be connected to, these are
        -- TOS, BOS, TOC, BOC, LEFT, RIGH
        do !getPlineNumber from 1 to !closestPline.size() by 2
          if !closestPline[$!getPlineNumber].pkey inset ('TOS','BOS','TOC','BOC','LEFT','RIGH','OBOW','OTOW','IBOW','ITOW') then
            !plineNumber = !getPlineNumber
            break
          endif
        enddo
        !plineName = pkey of $!closestPline[$!plineNumber]
        var !offsetdist const dist ppline NA start to ppline $!plineName start
        pin 4 plane pin 4 dist $!offsetdist
        var !pin4pos position pin 4 wrt /*
        !newhtpos = !pin4pos.position()
        !form.support.tposition = !newhtpos
        !datum.cref.tposition = !newhtpos

        var !newhtdir constr dir pin 4 to pin 3
        if !!mdshangif.eq('LISEGA') then
          var !plinetdir ppli $!plineName ori of $!sctnref
          !newhtdir = !plinetdir.orientation().zdir().string()
        endif
        !form.support.tdir = !newhtdir.direction()
        if !!mdshangif.eq('LISEGA') then
          !!mdsInterfaceSetOffsetDir(!datum, !form)
        endif
        !datum.cref.tdir = !newhtdir.direction()
        if !virtualFitting then
          !form.virtualFitting.posline = !plineName
        else
          !datum.cref.tref.posl = !plineName
        endif
      else
        if !!mdshangif.eq('LISEGA') then
          pin 3 at $!datum
          var !newhtdir const dir pin 1 to pin 3
          !form.support.tdir = !newhtdir.direction()
          !datum.cref.tdir = !newhtdir.direction()
          --!closestPline = !!kClosestPline(!sctnref,!datumpos,!datumdir[1])
          !closestPline = !!kClosestPline(!sctnref,!datumpos,!newhtdir.direction())
          -- We only need the pline that can be connected to, these are
          -- TOS, BOS, TOC, BOC, LEFT, RIGH
          do !getPlineNumber from 1 to !closestPline.size() by 2
            if !closestPline[$!getPlineNumber].pkey inset ('TOS','BOS','TOC','BOC','LEFT','RIGH','OBOW','OTOW','IBOW','ITOW') then
              !plineNumber = !getPlineNumber
              break
            endif
          enddo
          !plineName = pkey of $!closestPline[$!plineNumber]
          var !plinetdir ppli $!plineName ori of $!sctnref
          !newhtdir = !plinetdir.orientation().zdir().string()
          !form.support.tdir = !newhtdir.direction()
          !!mdsInterfaceSetOffsetDir(!datum, !form)
        else
          golabel /SWAP
        endif
      endif
    else
      !htpos = !datum.cref.tposition.wrt( /* )
      pin 3 at $!datum
      var !newhtdir const dir pin 1 to pin 3
      !dir = !newhtdir.direction()
      if ( !dir.angle(!datumdir[1]).lt(.1) and !dir.angle(!datumdir[1]).gt(-.1) ) or ( !dir.angle(!datumdir[1]).gt(179.9) and !dir.angle(!datumdir[1]).lt(180.1)) then
        !form.support.tdir = !newhtdir.direction()
        !datum.cref.tdir = !newhtdir.direction()
        !closestPline = !!kClosestPline(!sctnref,!datumpos,!newhtdir.direction())
        -- We only need the pline that can be connected to, these are
        -- TOS, BOS, TOC, BOC, LEFT, RIGH
        do !getPlineNumber from 1 to !closestPline.size() by 2
          if !closestPline[$!getPlineNumber].pkey inset ('TOS','BOS','TOC','BOC','LEFT','RIGH','OBOW','OTOW','IBOW','ITOW') then
            !plineNumber = !getPlineNumber
            break
          endif
        enddo
        !plineName = pkey of $!closestPline[$!plineNumber]
        if !virtualFitting then
          !position = !form.virtualFitting.getPosition()
          pin 4 at $!position
          !form.virtualFitting.posline = !plineName
          !position = !form.virtualFitting.getPosition()
          pin 4 at $!position
        else
          pin 4 at $!fittref
          !datum.cref.tref.posl = !plineName
          pin 5 at $!fittref
        endif
        var !dist const dist pin 4 to pin 5
        pin 4 at $!htpos
        pin 4 dir $!dir
        pin  4 plane pin 4 dist $!dist
        var !pin4pos position pin 4 wrt /*
        !newhtpos = !pin4pos.position()
        !form.support.tposition = !newhtpos
        !datum.cref.tposition = !newhtpos

        if !!mdshangif.eq('LISEGA') then
          var !plinetdir ppli $!plineName ori of $!sctnref wrt /*
          !newhtdir = !plinetdir.orientation().zdir().string()
          !form.support.tdir = !newhtdir.direction()
          !!mdsInterfaceSetOffsetDir(!datum, !form)
        endif

      else

        if !!mdshangif.eq('LISEGA') then

          !form.support.tdir = !newhtdir.direction()
          !datum.cref.tdir = !newhtdir.direction()
          --!closestPline = !!kClosestPline(!sctnref,!datumpos,!datumdir[1])
          !closestPline = !!kClosestPline(!sctnref,!datumpos,!newhtdir.direction())
          -- We only need the pline that can be connected to, these are
          -- TOS, BOS, TOC, BOC, LEFT, RIGH
          do !getPlineNumber from 1 to !closestPline.size() by 2
            if !closestPline[$!getPlineNumber].pkey inset ('TOS','BOS','TOC','BOC','LEFT','RIGH','OBOW','OTOW','IBOW','ITOW') then
              !plineNumber = !getPlineNumber
              break
            endif
          enddo
          !plineName = pkey of $!closestPline[$!plineNumber]
          var !plinetdir ppli $!plineName ori of $!sctnref
          !newhtdir = !plinetdir.orientation().zdir().string()
          !form.support.tdir = !newhtdir.direction()
          !!mdsInterfaceSetOffsetDir(!datum, !form)
        endif
      endif
    endif
  else

    label /SWAP
    -- >>> dtf mod to re define hanger direction & tpos if atta moves other side of wall or sctn
    !oldtdir = !form.support.tdir
    !hdir = !datum.cref.hdir.wrt( /* )
    !htpos = !datum.cref.tposition.wrt( /* )
    !hhpos = !datum.cref.hposition.wrt( /* )
    -- in Create mode hanger has no members
    if !datum.cref.members.size().eq(0) then
      !htpos = !datum.cref.tposition.wrt( /* )
      !hhpos = !datum.cref.hposition.wrt( /* )
      var !tdir constr dir $!htpos to $!hhpos
      !newtdir = !tdir.direction()
    else
      !memsize = !datum.cref.members.size()
      !lastmempos = !datum.cref.member[!memsize].lposition.wrt( /* )
      !datumpos = !datum.position.wrt( /* )
      pin 1 at $!form.support.tposition
      pin 2 at $!lastmempos
      pin 3 at $!datumpos
      var !hdist construct dist pin 1 to pin 3
      var !tdist construct dist pin 1 to pin 2
      if !hdist.real().lt(!tdist.real()) then
        !newtdir = !form.support.tdir.opposite()
      else
        !newtdir = !form.support.tdir
      endif
    endif
    -- reset hanger directions if newtdir opposite to oldtdir
    if !oldtdir.eq(!newtdir.opposite()) then
      !form.support.tdir = !newtdir
      !datum.cref.tdir = !newtdir
      !datum.cref.hdir = !hdir.opposite()

      if !sctnref.hardtype.eq('SCTN') then
        !closestPline = !!kClosestPline(!sctnref,!hhpos,!hdir.opposite())
        -- We only need the pline that can be connected to, these are
        -- TOS, BOS, TOC, BOC, LEFT, RIGH
        do !getPlineNumber from 1 to !closestPline.size() by 2
          if !closestPline[$!getPlineNumber].pkey inset ('TOS','BOS','TOC','BOC','LEFT','RIGH','OBOW','OTOW','IBOW','ITOW') then
            !plineNumber = !getPlineNumber
            break
          endif
        enddo
        !plineName = pkey of $!closestPline[$!plineNumber]
        -- reset nearest pline
        if !virtualFitting then
          !form.virtualFitting.posline = !plineName
        else
          !datum.cref.tref.posl = !plineName
        endif
      endif

      !datumdir = !!mdsremovegrad(!datum)
      if ( !newtdir.angle(!datumdir[1]).lt(.1) and !newtdir.angle(!datumdir[1]).gt(-.1) ) or ( !newtdir.angle(!datumdir[1]).gt(179.9) and !newtdir.angle(!datumdir[1]).lt(180.1)) then
        if !virtualFitting then
          --do nothing
        else
          !tref = !datum.cref.tref
        endif
        pin 1 at $!htpos
        pin 1 dir $!newtdir

        if !virtualFitting then
          !position = !form.virtualFitting.getPosition()
          pin 1 plane pin 1 thr $!position
        else
          pin 1 plane pin 1 thr $!tref
        endif

        var !newtpos pin 1 pos wrt /*
        !tpos = !newtpos.position()
        !datum.cref.tposition = !tpos
        !form.support.tposition  = !tpos
        !form.support.tdir = !newtdir
      endif
    endif
    -- <<< end of mod
  endif

  !!mdsresetpins(1,4)

endfunction
