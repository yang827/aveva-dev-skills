--
-- File: mdsitt23.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Neale Morris
-- Created: Thursday 19th February 1998
--
--
-- Description:
-- Initialisation for Trunnion form 'TT23'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsitt23(!modify is STRING,!textName is STRING,!alias is STRING)

--------------------------------------------
-- Check to see if form is already shown
--------------------------------------------

    if !!mdsTT23.shown() then
      !!alert.error('Unable to show form as it is already displayed')
      return
    endif

    !!mdsTT23.mainBore.val = 'Main     Bore'

-- Find current units and set the distance unit to metric
    !currentUnits = !!kGetSetUnits()

-- Initialise Variables
    !name = '/' & !textName
    !pad  = FALSE

-- Initialise Standard gadgets
    !!kResetActive(!!mdsTT23, FALSE)
    !!mdsTT23.tag.active     = TRUE
    !!mdsTT23.name.active    = TRUE
    !!mdsTT23.crtube.active   = TRUE
    !!mdsTT23.crelbo.active   = TRUE
    !!mdsTT23.crredu.active   = TRUE
    !!mdsTT23.crcros.active   = TRUE
    !!mdsTT23.cancel.active  = TRUE
    !!mdsTT23.connect.active = FALSE
    !!mdsTT23.modify.active = FALSE
    !!mdsTT23.forcecon.active = FALSE
    !!mdsTT23.disconn.active = FALSE
    !!mdsTT23.ancmat.active  = TRUE
--<dw>jan2009 dun1081 - To allow AC46 properties to be modified - HPD0038589.
    !!mdsTT23.modatta.active  = true
--------------------------------------------------------------------------------
-- Create Support object
    !support           = object MDSSUPPORT()
    !support.position  = FALSE
    !support.mirror    = FALSE
    !support.rotatecur = FALSE
    !support.handedcur = FALSE
    !support.rotated   = 0
    !support.bpnum     = 0
    !support.alias     = !alias
--------------------------------------------------------------------------------
-- Select member option to 1
    !!mdsTT23.member.val = 1

    if (!modify.upcase() neq |MODIFY|)then
--------------------------------------------------------------------------------
-- Create a New Trunnion Type 'TT23'

-- Set callback on cancel button
      !!mdsTT23.cancel.callback = |call !!mdsCancelSupp(!!mdsTT23)|
      !support.modify            = FALSE

-- Initialise variables for new supports
      !support.replace = !!mdsTrunn.replacement
      !support.type    = !!mdsTrunn.standard.selection('Rtext')
      !struName        = !!mdsTrunn.name.val

-- Navigate to correct area
      if (!!mdsMoveToSite('').not())then
        !!kRestoreUnits(!currentUnits)
        return
      endif

-- Set gadgets on form
      !!mdsTT23.name.val   = !struName
      !!mdsTT23.pLength.val = 0
      !!mdsTT23.pWidth.val = 0
      !!mdsTT23.pThk.val = 0
      !!mdsTT23.tlength.val  = 0
      !!mdsTT23.dist.val   = 0
      !!mdsTT23.p.val      = ''

-- Clear bore gadget if previously used
      !!mdsTT23.bore.clear()

-- Hide calling form

      hide !!mdsTrunn

-- Activate relevant gadgets
      !!mdsTT23.viewstd.active = TRUE
--------------------------------------------------------------------------------

    else
-- Modify an Existing Trunnion Type 'TT23'
--------------------------------------------------------------------------------

-- Set callback on cancel button
      !!mdsTT23.cancel.active = FALSE
      !support.modify            = TRUE
      !!kResetActive(!!mdsTT23, FALSE)
      !!mdsTT23.crelbo.active    = FALSE
      !!mdsTT23.crtube.active    = FALSE
      !!mdsTT23.rotatt.active    = TRUE

-- Initialise variables for existing supports

-- Store Data in support object
      !support.type     = 'TT23'
      !support.position = TRUE
        handle (2,109)
          !!alert.error('Support Datum does not exist')
          unenhance all
          !!mdsModifySupp.cancel.active = TRUE
          !!kRestoreUnits(!currentUnits)
          return
        endhandle

-- Navigate to existing support datum
      !datum = '/' + !!mdsModifySupp.name.val
      !!ce = !datum.dbref()
      !support.datum  = !datum.dbref()
-- Complete the OBJECT ARRAY member '!support.atta' list in the CORRECT order.
-- NOTE:- The ORDER of this list is IMPORTANT and MUST match the
-- ARRAY indices held in the FORM member '.member'
      !!ce = $!datum/NOTE1
      !support.atta.append(!!ce)
      !!ce = $!datum/MAKEUP
      !makeup = !!ce
      !support.atta.append(!!ce)
      !!ce = $!datum/NOTE2
      !support.atta.append(!!ce)
      !!ce = $!datum$n.1
      !support.atta.append(!!ce)
      !!ce = $!datum$n.2
      !support.atta.append(!!ce)
      !!ce = $!datum$n.3
      !support.atta.append(!!ce)
      !!ce = $!datum/NOTE3
      !support.atta.append(!!ce)
      !!ce = $!datum/NOTE4
      !support.atta.append(!!ce)
      !!ce = $!datum/SREF
      !support.atta.append(!!ce)
      !!ce = $!datum
      !support.atta.append(!!ce)
      !!ce = !support.datum

-- Set Form Gadgets
      !!mdsTT23.name.val   = !support.datum.namn
      !!mdsTT23.p.val      = ''

      !!mdsAddAll('$!textName')

-- If the trunnion is connected to an elbow hide the distance/through gadgets
      if !support.datum.owner.href.type.eq('ELBO') then
        !!mdsTT23.bdist.active = FALSE
        !!mdsTT23.bthro.active = FALSE
        !!mdsTT23.dist.active = FALSE
        !!mdsTT23.select.active = FALSE
        !!mdsTT23.dist.val = 0
      else
        !!mdsTT23.bdist.active = TRUE
        !!mdsTT23.bthro.active = TRUE
        !!mdsTT23.dist.active = TRUE
        !!mdsTT23.select.active = TRUE
--        !saveRef = !!ce
        !!ce = !support.datum
        branch
        goto href
        var !dist const dist p0 to pl of prev
          handle (2,113)
            var !dist const dist p0 to ph
          endhandle
        !!mdsTT23.dist.val = !dist.real()
      endif

      !!ce = !support.datum
      !styp = styp
      !bore = pa bore
-- Read the plate dimensions of the DATUM Atta
      !pLength = prop PLEN
      !!mdsTT23.pLength.val = !pLength.real()
      !pWidth = prop PWID
      !!mdsTT23.pWidth.val = !pWidth.real()
      !pThk = prop PTHK
      !!mdsTT23.pThk.val = !pThk.real()
      !!mdsGetProp(!!mdsTT23.pLength,!!mdsTT23.pLength,'PLEN',!bore,!styp)
      !!mdsGetProp(!!mdsTT23.pWidth,!!mdsTT23.pWidth,'PWID',!bore,!styp)
      !!mdsGetProp(!!mdsTT23.pThk,!!mdsTT23.pThk,'PTHK',!bore,!styp)
-- Select the Trunnion Base Plate i.e the DATUM Atta to MATCH the  Property Values/Dimensions justobtained above.
      !!mdsTT23.member.val = 4

-- Read length
      branch
      !!ce = !makeup
      !pTBore = pl bore
      branch
      last mem
      var !off '0'
      if !!ce.styp.match('AC19').gt(0) then
        var !off const dist p1 to p2
      endif
      prev
      if !!ce.styp.match('AC19').gt(0) then
        var !off const dist p1 to p2
      endif
      branch
      pin 9 at ph
      pin 8 at pt
      pin 9 dir d
      if !!ce.href.type.eq('REDU') then
        !paBore = !!ce.href.abore
        !plBore = !!ce.href.lbore
        if !paBore.gt(!plBore) then
          pin 9 plane d thro pa of href
        else
          pin 9 plane d thro pl of href
        endif
      else
        pin 9 plane d thro p0 of href
      endif
      var !height const dist pin 9 to pin 8
      !!mdsResetPins(8,9)
      !!mdsTT23.tlength.val = !height.real() - !off.real()

      !bore = pl bore
      handle ANY
        !bore = ph bore
      endhandle

-- Get Session Bore Units
      if(!!kGetBoreUnits()) then
        !boreUnits = 'inch bore'
      else
        !boreUnits = ''
      endif

---------------------------------------------------------------------------------------------------
--<wd>apr2006<mds12>
-- The available bores will be stored in the object for TT23 !!mdsParTT23[Bore]
-- Fill the selection gadget with these available bores and the styp to be used
    --!availBores = !!mdsParTT23[$!bore].bores
--
-- Available Trunnion Bores are NOW determined from the MDS DEFAULTS stored in the PARAGON DB CATALOGUE
      !mdsStd = 'TT23'
--><wd>04jun09 - DFN P-17079 - ERROR raised if PIPE BORE parameters are actual IMPERIAL bore sizes, e.g. 152.4mm = 6in and NOT 150mm
--    !rBore  = !bore.real()
    !rBore  = !bore.string().lowcase().before('mm').real().value()
--<<wd>04jun09 - DFN P-17079
      !mdsTrunObj  = object MDSREADTRUNDATA()
      !mdsTrunData = !mdsTrunObj.mdsTrunData(!mdsStd, !rBore)

-- Check if the Trunnion type and bore is ACTIVE for the current  PDMS Project
      if (!mdsTrunData.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
        if (!mdsTrunObj.mdsStd.sactive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
          !errormessage = !mdsTrunObj.mdsStd.smess
        elseif (!mdsTrunObj.mdsStd.cactive.not()) then
-- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
          !errormessage = !mdsTrunObj.mdsStd.cmess
        endif

-- Advise USER and EXIT Trunnion Support Modification
        !!alert.error(!errormessage & ' - ABORTING modification of TRUNNION support ' & !!mdsModifySupp.name.val )
        unenhance all
        !!mdsModifySupp.applyform[5]= '!!mdsModifySupp.cancel.active = TRUE'
        !!kRestoreUnits(!currentUnits)
        return

      else
-- List the Available Trunnion Bore Sizes for the Current TRUNNION
        !availBores = !mdsTrunObj.bores

      endif
--<wd>apr2006<mds12>
---------------------------------------------------------------------------------------------------

      !!kRestoreUnits(!currentUnits)
      !unitBore = ARRAY()
      do !setUnitBores from 1 to !availBores.size()
        !mmBore = !availBores[$!setUnitBores] & 'mm'
        !unitBore.append(!mmBore.bore(!!boreFmt).string())
      enddo
      !currentUnits = !!kGetSetUnits()
      !!mdsTT23.bore.dText = !unitBore
      !!mdsTT23.bore.rText = !availBores

-- Try and select the existing bore
      !!mdsTT23.bore.select('RTEXT',!pTBore.string().before('mm'))
      units mm bore
      !pHBore = ph bore
      !!kRestoreUnits(!currentUnits)
      !mainBore = !pHBore.string()
      !!mdsTT23.mainBore.val = 'Main     Bore =     $!mainBore'

-- Show available gadgets
      !!mdsTT23.bore.active = TRUE
      !!mdsTT23.viewstd.active = TRUE
      !!mdsTT23.setlen.active = TRUE
      !!mdsTT23.trunmat.active = TRUE
      !!mdsTT23.ancmat.active = TRUE
      !!mdsTT23.zoom.active = TRUE
      !!mdsTT23.tlength.active = TRUE
      !!mdsTT23.ok.active = TRUE
      !!mdsTT23.member.active = TRUE
--<dw>jan2009 dun1081 - To allow AC46 properties to be modified - HPD0038589.
      !!mdsTT23.modatta.active = true

    endif
--------------------------------------------------------------------------------

-- Store support object in form
    !!mdsTT23.support = !support

-- Store Current representations in form for use later
    var !repre repre level
    !!mdsTT23.repre.clear()
    !!mdsTT23.repre.append(|call !!kRepreLevel(nulref, '', $!repre,0)|)
    var !repre repre level pipe
    !!mdsTT23.repre.append(|call !!kRepreLevel(nulref, 'PIPE', $!repre,0)|)
    var !repre repre level nozz
    !!mdsTT23.repre.append(|call !!kRepreLevel(nulref, 'NOZZ', $!repre,0)|)
    var !repre repre level stru
    !!mdsTT23.repre.append(|call !!kRepreLevel(nulref, 'STRU', $!repre,0)|)

--------------------------------------------------------------------------------

    if (!modify.upcase() eq |MODIFY|) then
      !!ce = !!mdsTT23.support.datum

-- Set distance gadget
      -- !!mdsDistance(!!mdsTT23)

-- Goto HREF of Trunnion Branch
      !!ce = !!ce.owner.href
-- Add marker text markers
      var !pos pos wrt world
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Trunnion $<$!pos$>
      !!ce = !support.datum
      var !pos pos wrt world
      $M/%PDMSUI%/DES/CLIB/GAIDTEXT 211 Datum $<$!pos$>
      do !count from 212 to 259
        var !num ($!count - 211)
        !attaName = !name & '.' & !num
        !!ce = !attaName.dbref()
        handle ANY
          break
        endhandle
        var !pos pos wrt world
        $M/%PDMSUI%/DES/CLIB/GAIDTEXT $!count $!num $<$!pos$>
      enddo

---------------------------------------------------------------------------------------
-- Store Packing Pieces in the Support Object
-- Derived from the 'ATTAS' :MDSPackRef references in the Support.atta array
      do !atta values !!mdsTT23.support.atta
        !!ce = !atta
        if (!atta.:MDSPackRef.badref().not()) then
          !!mdsTT23.support.packs.append(!atta.:MDSPackRef)
        else
          :MDSPackRef unset
            handle ANY
            endhandle
          skip
        endif
      enddo

---------------------------------------------------------------------------------------
-- Fill in dimensions from atta (Stored in mm)
      !!ce = !!mdsTT23.support.datum
--      !despars = despar

-- Store pos.ori and despar in case user cancel form
      !!mdsTT23.support.oldPosition    = pos wrt /*
      !!mdsTT23.support.oldOrientation = ori wrt /*
      !!mdsTT23.support.oldDespars     = despar
      !!mdsTT23.support.oldSpref       = spref

-- Check if Reinforcing Plate available with Selected Trunnion
      !selection = !support.datum.stype
      if (matchwild(!selection,'*tt23-A*')) then
        !!mdsTT23.plate.val = 0
        !pad = FALSE
      elseif (matchwild(!selection,'*tt23-C*')) then
        !!mdsTT23.plate.val = 0
        !pad = FALSE
      else
        !pad = TRUE
      endif

    endif

--------------------------------------------------------------------------------
    -- label /CONT

-- Redefine Trunnion support name on formtitle

    !index = !!mdsTrunn.standard.rText.findfirst('TT23')
    !text  = !!mdsTrunn.standard.dText[!index]
      handle (61,567) (61,615)
        !!mdsPopulate(!!mdsTrunn,'TRUNN')
        !index = !!mdsTrunn.standard.rText.findfirst('TT23')
        !text  = !!mdsTrunn.standard.dText[!index]
      endhandle
    !suppNumber = before(!text, '-')
    !formName   = !suppNumber.trim()
    !!mdsTT23.support.replace = !formName

    call !!mdsSetFormName(!!mdsTT23, 'Trunnion', '$!formName')

--------------------------------------------------------------------------------
-- Store current form information
    call !!mdsStoreTT23()

-- Set the Callback actions on the Common Trunnion Selection
-- form '!!mdsTrunnVT01.ok'  - OK gadget
    !!mdsTrunnVT01.action.clear()
    !!mdsTrunnVT01.cancel.callback = ||

-- Activate/Deactivate '.pad' gadget as required
    -- !!mdsTT23.plate.active = !pa

-- Activate bedplate icon

    !!mdsTT23.bedPlate.active = TRUE

-- Deactivate icons that are not used

    !!mdsDeActivate(!!mdsTT23,'1,2,3,4,5,6,7,9,11,12,13,14,15,19,20,21,22,24')
    !!mdsTT23.mtoc.active = TRUE

-------------------------------------------------------------------------------
--<wd>26jul2004
    if (!modify.upcase() eq |MODIFY|) then
-- Check & Move Trunnion Branch HPOS and members to suit the NEW MODIFIED HREF Position
      branch
--      !trunDir = !!ce.hdir.wrt(/* )
      !form    = !!mdsTT23
      !dbref   = !!ce
      !message = ''
      !!mdsModifyTrun(!dbref, !form, !message)
      if (!message.length().neq(0)) then
-- An ERROR exists so do NOT continue
        !!mdsModifySupp.applyform.append('!!mdsModifySupp.cancel.active = TRUE')
        !!alert.error('** ERROR **: $!<message> Aborting the modification of this trunnion support')
        !!kRestoreUnits(!currentUnits)
        return
      endif
    endif
--<wd>26jul2004
-------------------------------------------------------------------------------

-- Show Form for Trunnion Type 'TT23'
    !!kShowForm(!!mdsTT23)

    !!mdsCreateGeneralFromPS (!!mdsTT23, !name)

--------------------------------------------------------------------------------
-- Reset Units
     !!kRestoreUnits(!currentUnits)

--------------------------------------------------------------------------------
  endfunction
