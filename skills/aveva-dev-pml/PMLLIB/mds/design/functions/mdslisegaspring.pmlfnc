-- Author:		Wayne Dodwell
-- Created:		Tuesday 5th April 2005
--
--
-- Description:
--
-- Function to Get Lisega Hanger "Springs"
--
--
--
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]             [Description]
--     1      R        ARRAY         ARRAY of Lisega Hanger Elements in the LISEGA HANGER
--
-- Return:
--     [Data Type]      [Description]
--       ARRAY      ARRAY of LISEGA "SPRING" Elements in the HANGER
--
--------------------------------------------------------------------------------
--
-- Define Function
  define function !!mdslisegaspring(!hangmem is ARRAY) is ARRAY

    !springs = ARRAY()

    do !findspring values !hangmem
      !spref = !findspring.dbref().spref.namn.after('/')
      if (!spref.match('R').eq(1)) then
        !spref = !Spref.after('R')
      endif
      if !spref.match('2').eq(1) then
        if (!spref.match('20').eq(1) and !Spref.match('9').eq(4)) then
        else
          !springs.append(!findspring.dbref())
        endif
      elseif !spref.match('79').eq(1) then
        if (!spref.match('5').eq(5)) then
          !springs.append(!findspring.dbref())
        endif
      endif
    enddo


-- Return Array of Lisega Springs
   return !springs

  endmethod
--------------------------------------------------------------------------------
