--
--
-- Description:
-- function to set global object !!MDSLSUPPDEFS for lighting support defaults and return it
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define function
define function !!MdsLsuppDefs() is MDSLSUPPDEFS

   if undefined(!!Mdslsuppdefs) then
      !!Mdslsuppdefs = object MDSLSUPPDEFS()
   endif

   return !!Mdslsuppdefs

-- End of function
endfunction

-- End of file mdslsuppdefs.pmlfnc
