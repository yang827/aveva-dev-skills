-- Author:  K.pleschner
-- Created:   06/02/2007 17:31
--
--
-- Description:
-- function to get property from lighting support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         Lighting support
--     2     R        STRING        Property name
--
-- Return:
--    [Data Type]   [Description]
--     ANY           Property value
--------------------------------------------------------------------------------

-- Define function
define function !!mdslsupprop(!supp is DBREF, !dkey is STRING) is ANY

  !source = !supp.:MdsProjSpec
  !oldName = !source.name
  !newName = !supp.name

  var !allData collect all DDAT with dkey eq upcase('$!dkey') for $!source
  !data = !allData[1].dbref()
  !strExp = !data.ddpr.replace(!oldName,!newName)
  !ptyp = !data.ptyp

  !exp = object EXPRESSION(!strExp)
  !result = !exp.evaluate(!supp)
  if !result.objectType().eq('REAL').and(!ptyp.eq('DIST')) then

       if (!!isImperialLength('DIST').not()) then
      !result = $!result
       endif
    endif

    return $!result

endfunction
