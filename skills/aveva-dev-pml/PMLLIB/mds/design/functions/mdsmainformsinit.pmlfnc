--     Keyword:		MDS
--   Module:		DESIGN
--   Replaces:
--
--------------------------------------------------------------------------------
-- Description
--
-- Initialises the MAIN MDS DESIGN Application FORMS, #
-- e.g. !!MDFRAME, !!MDSTRUNN, !!MDSGENERAL etc..
-- < THIS was done previously in form method !!mdsdflts.action()-- in the MDS11.6 version >
--
------------------------------------------------------------------------
--
-- Define Function
define function !!mdsmainformsinit()

-- Get the PDMS Module
  !bann = banner
  !bnam = !bann.name.upcase()

--<wd>may2007<mds12>
  !bshort = !bann.short.upcase()
--  if (!bnam.match('DESIGN').gt(0)) or (!bnam.match('OUTFITTING').gt(0))then
  if (!bshort.match('DESIGN').gt(0)) or (!bshort.match('OUTFITTING MK').gt(0))then
--<wd>may2007<mds12>

--clock init
--$P ** Loading ** form mdsallancill() **

-- CHECK, LOAD and INITIALISE the MDS <ALL ANCILLARY> SYSTEM -- <NON-USER> form !!mdsallancill
    if (undefined(!!mdsallancill)) then
      pml load form !!mdsallancill
      !!mdsiallancill()
    else
      if (!!mdsallancill.standard.dtext.empty()) then
        !!mdsiallancill()
      endif
    endif

-- ABORT entry to the MDS DESIGN Application if NO ANCILLARIES have been loaded into the form !!mdsallanacill
    if (!!mdsallancill.standard.dtext.empty()) then
      return
    endif
--clock read elapsed

-- Initialise the MAIN MDS DESIGN Application Forms,
-- i.e. !!MDSFRAME, MDSTRUNN, MDSGENERAL etc...
    if (defined(!!mdsframe)) then
     if (!!mdsframe.standard.dtext.unset()) or (!!mdsframe.standard.rtext.unset()) then
-- Initialise the MAIN MDS DESIGN Application Forms
        !initmainforms = TRUE
      else
-- The MAIN MDS Application DESIGN FORMS have ALREADY been Initialised
        !initmainforms = FALSE
      endif
    else
-- The MAIN MDS Application DESIGN FORMS have ALREADY been Initialised
      !initmainforms = FALSE
    endif


    if (!initmainforms) then
--<wd>03nov2006<mds12> -- *** FORMS are now INITIALISED when FIRST SHOWN ***
-- Initialise the MAIN USER Forms for the MDS DESIGN Application
--<wd>03nov2006<mds12>       !!mdsiframe()
--<wd>03nov2006<mds12>       !!mdsicable()
--<wd>03nov2006<mds12>       !!mdsianchor()
--<wd>03nov2006<mds12>       !!mdsigeneral()
--<wd>03nov2006<mds12>       !!mdsiguide()
--<wd>03nov2006<mds12>       !!mdsihvac()
--<wd>03nov2006<mds12>       !!mdsislip()
--<wd>03nov2006<mds12>       !!mdsitrunn()
--<wd>03nov2006<mds12>       !!mdsivess()

-- Initialise the MAIN MDS HANGER Form !!mdsfhanger if required
      if (defined(!!mdsallhangertypes)) then
--
-- MDS is ALREADY LOADED
-- Therefore LOAD the INITIALIZATION function !!mdsifhanger()
-- for the MAIN MDS HANGER FORM !!mdsfhanger
--
        --!!mdsifhanger()

      else
--
-- MDS is LOADING for the FIRST time in the PDMS SESSION
-- Therefore SKIP the INITIALIZATION function !!mdsifhanger()
-- for the MAIN MDS HANGER FORM !!mdsfhanger
--
-- When MDS is LOADING for the FIRST time in the PDMS SESSION,
-- the INITIALIZATION of the form !!mdsfhanger is SKIPPED
-- to make the initial ENTRY loading to the MDS DESIGN Application faster!!!
--
      endif

    endif

  endif

endmethod
