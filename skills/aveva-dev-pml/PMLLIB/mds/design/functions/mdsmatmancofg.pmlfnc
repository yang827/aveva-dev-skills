--
--
-- File:		mdsmatmancofg
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		
--   Replaces:
--
-- Author:	        Wayne Dodwell	
-- Created:	        27th March 2002	
--
--
-- Description:        Function to Return the COFG  wrt /* Value for the MDS Support Attas & Sctns for
--                     Imperial Distance Units
--
--------------------------------------------------------------------------------------------------------
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        ARRAY         Array of PDMS Elements Selected by the MDS REPORT
--     2      RW       ARRAY         Array of COFG values for the MDS Attas in Argument 1
--
-- Return:
--    [Data Type]   [Description]
--       ARRAY        ARRAY of COFG wrt /* Values for EACH MDS Atta
--                    and SCTN for EACH of the Selected MDS Elements
--
--------------------------------------------------------------------------------------------------------

-- Define Function
  define function !!mdsmatmancofg(!selection is array, !cofgs is array) is array

-- Get Current Distance Units


    if (!!isImperialLength('DIST').not()) then
-- Metric Distance Units
      !mmdist = true
    else
-- Imperial Distance Units
      !mmdist = false
    endif

-- Loop thro the List of Selected Items and Assign the Correct CofG wrt /*
-- ONLY if the Distance UNITS are Imperial
    if (!mmdist.not()) then
      preci var 1/16
      !x = 0
      do !val values !selection
        !x = !x + 1
        !!ce = !val.dbref()
        if (!val.dbref().type inset ('ATTA', 'SCTN')) then
          !xposn = ncofg wrt /*
          handle any
            !xcofg = 'E0N0U0'
          elsehandle none
            !xcofg = !xposn.string().before(| WRT|)
          endhandle
        endif
        !cofgs[!x] = !xcofg
      enddo
      preci var default
    endif

-- For MM Distance Units, Do NOTHING but return the ORIGINAL passed !cofgs
   return !cofgs

  endfunction

return

--------------------------------------------------------------------------------------------------------
