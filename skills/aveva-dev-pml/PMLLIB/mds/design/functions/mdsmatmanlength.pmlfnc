--
--
-- File:		mdsmatmanlength
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		
--   Replaces:
--
-- Author:	        Wayne Dodwell	
-- Created:	        27th March 2002	
--
--
-- Description:        Function to Return the a BLANK LENGTH Value for the MDS Support Attas
--
--------------------------------------------------------------------------------------------------------
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        ARRAY         Array of PDMS Elements Selected by the MDS REPORT
--     2      RW       ARRAY         Array of LENGTH values for the MDS Attas in Argument 1
--                                   and the NOT Found Empty values for the ATTAS
--
-- Return:
--    [Data Type]   [Description]
--       ARRAY        ARRAY of Blank LENGTH Values for EACH MDS Atta
--                    and the Correct Length SCTN for EACH of the
--                    Selected MDS Elements
--
--------------------------------------------------------------------------------------------------------

-- Define Function
  define function !!mdsmatmanlength(!selection is array, !lengths is array) is array

-- Get Current Distance Units


    if (!!isImperialLength('DIST').not()) then
-- Metric Distance Units
      !mmdist = true
    else
-- Imperial Distance Units
      !mmdist = false
    endif

-- Loop thro the List of Selected Items and Assign the Correct LENGTH or BLANK VALUE
    !x = 0
    do !val values !selection
      !x = !x + 1
      !!ce = !val.dbref()
      if (!val.dbref().type.eq('ATTA')) then
        !lengths[!x] = ''
      elseif (!val.dbref().type.eq('SCTN')) then
        if (!mmdist) then
          !xlen = (string((derlen),'d0'))
          handle any
            !xlen = '0'
          endhandle
        else
          !xlen =  (trim(dist(derlen,t,f,t,16,t)))
          handle any
            !xlen = '0'
          endhandle
        endif
        !lengths[!x] = !xlen
      endif
    enddo

   return !lengths

  endfunction

return

--------------------------------------------------------------------------------------------------------
