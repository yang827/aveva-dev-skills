--
--
-- File:  mdsmatmanweight.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:
--   Replaces:
--
-- Author:         Wayne Dodwell
-- Created:         27th March 2002
--
--
-- Description:        Function to Return the Weight of MDS SCTNs on a FRAMEWORK
--
--------------------------------------------------------------------------------------------------------
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        ARRAY         Array of PDMS Elements Selected by the MDS REPORT
--     2      RW       ARRAY         Array of WEIGHT values for the MDS Attas in Argument 1
--                                   and the NOT Found Empty values for the SCTNs on the MDS Framework
--
-- Return:
--    [Data Type]   [Description]
--       ARRAY        ARRAY of WEIGHT Values for EACH MDS Atta and SCTN for EACH
--                    of the Selected MDS Elements
--
--------------------------------------------------------------------------------------------------------

-- Define Function
define function !!mdsmatmanweight(!selection is ARRAY, !weights is ARRAY) is ARRAY

  -- Get Current Distance Units

  if (!!isImperialLength('DIST').not()) then
    -- Metric Distance Units
    !mmdist = true
  else
    -- Imperial Distance Units
    !mmdist = false
  endif

  -- Loop thro the List of Selected Items and Assign the Correct Weight
  !x = 0
  do !val values !selection
    !x = !x + 1
    !!ce = !val.dbref()
    if (!val.dbref().type.eq('ATTA')) then
      -- Check if Weight has already been assigned to the ARRAY '!weights'.
      -- also Ensure the OUTPUT value is to 2 Decimal Places
      !weights[!x] = (str((real(!weights[$!x1])) ,'d2'))
      handle any
        !xweight = (str((real(prop weig)),'d2'))
        handle any
          !xweight = '0'
        endhandle
      endhandle
      !weights[!x] = !xweight
    elseif (!val.dbref().type.eq('SCTN')) then
        !xweight = (string((nwei),'d2'))
        handle any
          !xweight = '0'
        endhandle
      !weights[!x] = !xweight
    endif
  enddo

  return !weights

endfunction

return

--------------------------------------------------------------------------------------------------------
