--
-- File:  mdsmodifytrun.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  Wayne Dodwell
-- Created:  Monday 26th July 2004
--
--
-- Description:
-- Function to RESET MDS a Trunnion Branch HPOS to its Connected HREF
-- and Reposition all of the Trunnion Branch members respectively.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        DBREF        Trunnion Branch DBREF
--     2      R        FORM         Calling Trunnion Form
--     3      R/W      STRING       Error Message Returned to Calling Function by Association
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsmodifytrun(!dbref is DBREF, !form is FORM, !message is STRING)
  --------------------------------------------------------------------------------

  -- Initialise variable
  !trunbran = !dbref
  !trunname = !form.name.val

  -- Get MDS Standard Trunnion Support Type
  !srefname = '/' & !trunname & '/SREF'
  !srefdbrf = !srefname.dbref()
  !truntype = !srefdbrf.:mdssupptype

  -- Get Element Type of Trunnion HREF and the PPOINT Number Connected to Trunnion Branch
  !hreftype  = !trunbran.href.type
  if (!hreftype inset ('CROS')) then
    !ppnum = 4
    -- Test1 = P4 must exist
    if (!trunbran.href.ppls.find(4).size().eq(0)) then
      !message = 'The $!hreftype connected to the trunnion does NOT have a PPoint P4.'
      return
    endif
    -- Test2 = P0 in same place as P4
    if (!trunbran.href.ppos[0].neq(!trunbran.href.ppos[4])) then
      !message = 'The $!hreftype connected to the trunnion does NOT have PPoints P0 & P4 in the same position.'
      return
    endif
    --<dw>oct2008 dun979 - To allow for additional trunnion types TT42 to TT44
    -- Test3 = P4 Direction must NORMALLY be DOWN - except TT36,TT37,TT42,TT43,TT44
    if (!trunbran.href.pdir[4].string().match('D WRT').neq(1)) and (!trunbran.href.pdir[4].string().match('-Z WRT').neq(1)) then
      -- Check for Trunnion Types TT36,TT37,TT37,TT42,TT43,TT44
      if (not !truntype inset ('TT36','TT37','TT42','TT43','TT44')) then
        !message = 'The $!hreftype connected to the trunnion is NOT in the correct orientation. i.e. PPoint P4 is NOT set to D wrt /*.'
        return
      endif
    endif
    -- Test4 = P4 Direction must be in the SAME direction as the Trunnion Branch HDIR
    if (!trunbran.href.pdir[4].wrt(/* ).string().neq(!trunbran.hdir.wrt(/* ).string()) ) then
      !message = 'The $!hreftype connected to the trunnion is NOT in the correct orientation. i.e. The $!hreftype PPoint P4 direction is NOT the same as the Trunnion Branch Head direction.'
      return
    endif

  elseif (!hreftype inset ('ELBO', 'BEND', 'TEE', 'REDU')) then
    !ppnum = 3
    -- Check to see if the HREF - current ELBO/BEND component is OK
    if (!hreftype inset('ELBO', 'BEND')) then
      -- Test1 = P3 exists
      if (!trunbran.href.ppls.find(3).size().eq(0)) then
        !message = 'The $!hreftype connected to the trunnion does NOT have a PPoint P3.'
        return
      endif
      -- Test2 = P1 and P3 in the same place
      if (!trunbran.href.ppos[1].neq(!trunbran.href.ppos[3])) then
        !message = 'The $!hreftype connected to the trunnion does NOT have PPoints P1 & P3 in the same position.'
        return
      endif
      -- Test3 = P1 and P3 in opposite directions
      if (!trunbran.href.pdir[1].opposite().neq(!trunbran.href.pdir[3])) then
        !message = 'The $!hreftype connected to the trunnion does NOT have PPoints P1 & P3 in opposite directions.'
        return
      endif
      -- Test4 = P1 and P3 with the same bore
      if (!trunbran.href.ppbor[1].neq(!trunbran.href.ppbor[3])) then
        !message = 'The $!hreftype connected to the trunnion does NOT have the same bore size for PPoints P1 & P3.'
        return
      endif

    elseif (!hreftype inset ('TEE')) then
      -- Check to see if the HREF - current TEE component is OK - i.e. MUST be a SET-ON TEE
      -- Test1 = Skey is TESO
      if (!trunbran.href.detref.skey.neq('TESO')) then
        !message = 'The $!hreftype connected to the trunnion does NOT have a detail skey of TESO.'
        return
      endif
      -- Test2 = P3 is same bore as P1
      if (!trunbran.href.ppbor[1].neq(!trunbran.href.ppbor[3])) then
        !message = 'The $!hreftype connected to the trunnion does NOT have the same bore size for PPoints P1 & P3.'
        return
      endif
      -- Test3 = P1 and P3 in the same place
      if (!trunbran.href.ppos[1].neq(!trunbran.href.ppos[3])) then
        !message = 'The $!hreftype connected to the trunnion does NOT have PPoints P1 & P3 in the same position.'
        return
      endif

    elseif (!hreftype inset ('REDU')) then
      -- Check to see if the HREF - current REDU component is OK
      -- Test1 = It has to be an Eccentric REDU with a skey of 'OTBW' or 'OTSW' or 'OTFL' etc...
      if (!trunbran.href.detref.skey.matchwild('OT**').not()) then
        !message = 'The $!hreftype connected to the trunnion does NOT have a detail skey of OT** - i.e. An Eccentric Reducer with a Connection.'
        return
      endif
      -- Test2 = P3 exists
      if (!trunbran.href.ppls.find(3).size().eq(0)) then
        !message = 'The $!hreftype connected to the trunnion does NOT have a PPoint P3.'
        return
      endif
      -- Test3 = P2 is same bore as P3
      if (!trunbran.href.ppbor[2].neq(!trunbran.href.ppbor[3])) then
        !message = 'The $!hreftype connected to the trunnion does NOT have the same bore size for PPoints P2 & P3.'
        return
      endif
      -- Test4 = P2 and P3 are on the same level
      pin 9 copy p3 of $!trunbran.href
      if (!trunbran.href.arr.eq(1)) then
        pin 8 copy pl of $!trunbran.href
      else
        pin 8 copy pa of $!trunbran.href
      endif
      pin 8 dir from pin 9 to pin 8
      var !pin9dir const dir pin 9 to pin 8

      if (!trunbran.href.arr.eq(1)) then
        var !pldir pl dir of $!trunbran.href
      else
        var !pldir pa dir of $!trunbran.href
      endif
      if (!pin9dir.neq(!pldir)) then
        !message = 'The $!hreftype connected to the trunnion does NOT have PPoints P2 & P3 on the same level.'
        return
      endif
    endif

  else
    return

  endif

  -- Get the Existing HPOS of the Trunnion Branch and the HREF Element PPOINT number Connected to the Trunnion Branch
  !xtrunhpos = !trunbran.hpos.wrt(/* )
  !ppnumhpos = !trunbran.href.ppos[!ppnum].wrt(/* )

  -- Set up Existing Trunnion HPOS Co-ordinates
  !unusedXtrunnorth = !xtrunhpos.north
  !unusedXtruneast  = !xtrunhpos.east
  !unusedXtrunup    = !xtrunhpos.up

  -- Set up Trunnion HREF !pPNUMHPOS Co-Ordinates
  !ppnumnorth = !ppnumhpos.north
  !ppnumeast  = !ppnumhpos.east
  !ppnumup    = !ppnumhpos.up

  -- Check HPOS of Trunnion Branch against the 3D Position of !pPNUMHPOS of the Connected Type is within a 1mm Diameter TOLERANCE
  !tol = 0.5
  !xtrunmaxn = ( !xtrunhpos.north + !tol )
  !xtrunmaxe = ( !xtrunhpos.east  + !tol )
  !xtrunmaxu = ( !xtrunhpos.up    + !tol )
  !xtrunminn = ( !xtrunhpos.north - !tol )
  !xtrunmine = ( !xtrunhpos.east  - !tol )
  !xtrunminu = ( !xtrunhpos.up    - !tol )

  -- Check NORTHINGS - HREF !!ppnumhpos position against the Existing Trunnion HPOS
  if ( (!ppnumnorth.geq(!xtrunminn)) and (!ppnumnorth.leq(!xtrunmaxn)) ) then
    -- NORTHING positions are WITHIN the 1mm Diameter TOLERANCE
    -- Therefore Nothing to do
    !northadj = FALSE
  else
    -- NORTHING positions are OUTSIDE the 1mm Diameter TOLERANCE
    -- Therefore NEED to ADJUST the NORTHING Position of the HPOS of the TRUNNION Branch
    !northadj = TRUE
  endif

  -- Check EASTINGS - HREF !!ppnumhpos position against the Existing Trunnion HPOS
  if ( (!ppnumeast.geq(!xtrunmine)) and (!ppnumeast.leq(!xtrunmaxe)) ) then
    -- EASTING positions are WITHIN the 1mm Diameter TOLERANCE
    -- Therefore Nothing to do
    !eastadj = FALSE
  else
    -- EASTING positions are OUTSIDE the 1mm Diameter TOLERANCE
    -- Therefore NEED to ADJUST the EASTING Position of the HPOS of the TRUNNION Branch
    !eastadj = TRUE
  endif

  -- Check UPINGS - HREF !!ppnumhpos position against the Existing Trunnion HPOS
  if ( (!ppnumup.geq(!xtrunminu)) and (!ppnumup.leq(!xtrunmaxu)) ) then
    -- UPING positions are WITHIN the 1mm Diameter TOLERANCE
    -- Therefore Nothing to do
    !upadj = FALSE
  else
    -- UPING positions are OUTSIDE the 1mm Diameter TOLERANCE
    -- Therefore NEED to ADJUST the UPING Position of the HPOS of the TRUNNION Branch
    !upadj = TRUE
  endif

  -- Check if the Trunnion Branch HPOS is in SAME position as the HREF PPoint Number
  !!ce      = !trunbran
  !tmemdbrf = ARRAY()
  !tmemdist = ARRAY()

  -- The Position of the HREF is different to the Trunnion Branch HPOS
  if (!northadj or !eastadj or !upadj) then

    -- Before Reconnecting Trunnion Branch HPOS
    -- Get All 'Trunnion Members' on the Trunnion Branch and Store their ORIGINAL DISTANCE from the Trunnion Branch HPOS etc...
    !trunmem = !trunbran.members
    !tmcount = 0
    do !val values !trunmem
      -- This TEST is NOT Required as ALL Trunnion Branch Member ORIGINAL DISTANCES from the ORIGINAL Trunnion Branch HPOS
      --if (not !form.support.type inset ('TT14','TT15','TT16','TT17','TT24','TT31','TT32')) then
      --skip if (!val.namn.match(!trunname).eq(1))
      --endif

      -- Store ORIGINAL DISTANCE of All MDS Support MEMBERS on the Trunnion Branch from the ORIGINAL Trunnion Branch HPOS
      !tmcount = !tmcount + 1
      !tmemdbrf[!tmcount] = !val
      if ((!truntype inset ('TT25','TT33','TT34')) and (!val.type.eq('PLAT'))) then
        !tmemdist[!tmcount] = !!kstrreal('cons dist p0 of $!val to p0 of BEND 1 of bran')
      else
        !tmemdist[!tmcount] = !!kstrreal('cons dist ph to p0 of $!val')
      endif
    enddo

    -- RECONNECT the TRUNNION HPOS to the HREF and Reposition ALL Trunnion Branch members in the ORIGINAL relationship
    !!mdsdaccontrol(TRUE)
    conn to p$!<ppnum> of href
    handle ANY
      !!alert.error('$!!error.text - Unable to Re-Connect the Trunnion Branch Head to its connected Head Reference')
      return
    elsehandle NONE
      !!alert.message('The Trunnion Branch Head Position is NOT in the SAME position as its connected Head Reference ''$!hreftype''.
      The Trunnion Branch and Members will be repositioned to suit the NEW location of the connected Head Reference ''$!hreftype''')

      -- Call the Trunnion Set Length function to ensure EACH Trunnion Type's Differences are AUTOMATICALLY catered for.
      !trunhdir = !form.direction.val
      handle ANY
        !trunhdir = !trunbran.hdir.wrt(/* ).string()
      endhandle

      -- This CODE is NOT NOW required as:
      -- ALL TRUNNION MEMBERS ARE NOW REPOSITIONED by RESETING the ORIGINAL DISTANCE from the NEW Trunnion Branch HPOS
      --        if (!form.support.type inset ('TT14','TT15','TT16','TT17','TT24','TT31','TT32')) then
      --          !!mdssetdummylen('GADGET',!form.tlength.val.real(),!form.support.datum,!trunhdir,!form.support.type,!form)
      --        else
      -- All OTHER MDS Trunnion Types
      --          !!mdssettrunlen('GADGET',!form.tlength.val.real(),!form.support.datum,!trunhdir,!form.support.type,!form)
      --        endif

      -- Reposition ALL Trunnion Members in the Trunnion Branch with their original distance form the Branch Head Position
      !mcount = 0
      do !mem values !tmemdbrf
        !!ce = !mem
        !mcount = !mcount + 1
        !!mdsdaccontrol(TRUE)
        if ((!truntype inset ('TT25','TT33','TT34')) and (!mem.type.eq('PLAT'))) then
          dist $!tmemdist[$!mcount] from BEND 1 of bran
        else
          dist $!tmemdist[$!mcount] from ph
        endif
      enddo

      -- Ensure the Correct Trunnion Length is Displayed in the Trunnion Form Member .tlength/.theight
      bran
      conn pt to last mem
      !!ce = !form.support.datum
      if (!hreftype.eq('REDU')) then
        !trunlen = !!kstrreal('cons dist pl to plane p3 of href of bran')
      else
        if(!truntype inset ('TT25','TT33','TT34')) then
          !trunlen = !!kstrreal('cons dist pl to p0 of bend 1 of bran')
        else
          !trunlen = !!kstrreal('cons dist pl to p0 of href of bran')
        endif
      endif
      -- Set the Correct Trunnion Length/Height Gadget
      if(!truntype inset ('TT25','TT33','TT34')) then
        !form.theight.val = !trunlen
      else
        !form.tlength.val = !trunlen
      endif
    endhandle
    !!mdsdaccontrol(FALSE)
  else
    -- No Difference in Positions so NOTHING to DO
    return
  endif

  --------------------------------------------------------------------------------
endfunction

--------------------------------------------------------------------------------
-- End of the PML function - file mdsmodifytrun.pmlfnc
--------------------------------------------------------------------------------
