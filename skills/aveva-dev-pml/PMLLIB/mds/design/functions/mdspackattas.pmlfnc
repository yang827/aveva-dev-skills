--
-- File:		mdspackattas.pmlfnc
--   Type:		Form
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Friday 23rd August 2002
--
--
-- Description:
--  Function to Populate the forms MdsSUPPORT Object member .packs for the Selected
--  Support currently being Created or Modified by the MDS Application.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        ARRAY       Form Support Object, from where the MDS Support is being called.
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--
--Define Function
  define function !!mdspackattas(!support is Mdssupport)

-- Check if array is empty
    if ( (!support.atta.empty()) or (!support.atta.size().eq(0)) ) then
      return
    endif

-- Store Packing Pieces in the Support Object
-- Derived from the 'Attas' :mdspackref references in the Support.Atta array
    do !atta values !support.atta
      !!ce = !atta
      if (!atta.:mdspackref.badref().not()) then
        !support.packs.append(!atta.:MDSPackRef)
      else
-- SKIP if :mdspackref is nulref / unset
        skip if (!atta.:mdspackref.unset())
-- Try to set the :mdspackref to nulref if set to an 'Unknown Reference' i.e. a BADREF
        !!mdsdaccontrol(true)
        :MDSPackRef unset
        handle any
-- Do Nothing and Carry on if UNABLE to set the :mdspackref to nulref - It may be CLAIMED by other users
        endhandle
        !!mdsdaccontrol(false)
      endif
    enddo

  endfunction
-- End of Function Definition for mdspackattas.pmlfnc
