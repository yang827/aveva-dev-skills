--
-- File:		mdspadshoeref.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:	        Friday 6th December 2002
--
--
-- Description:
-- Function to Associate a Cradle/Reinforcing Pad Atta to a Valid Shoe Atta
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- define function
  define function !!mdspadshoeref()

--------------------------------------------------------------------------------
-- Select Pad Label
    label /selectpad

-- Identify Pad Atta
    prompt off
    prompt load escape |Identify Cradle/Reinforcing Pad...|
    id atta @
    handle (61,528)
      prompt dismiss
      prompt on
      unenhance $!rpad
      handle any
      endhandle
      return
    endhandle
    !rpad = !!ce

-- Check that the Selected Element is an ATTA
    if (!rpad.type.neq('ATTA')) then
      !!alert.error('Selected element is NOT a Support Atta.')
      golabel /selectpad
    endif

-- Check that the Selected ATTA Element is a MDS Support ATTA
    !spec = (name of spec of spref)
    if (!spec neq |/MDS|) then
      !!alert.error('Selected Atta MUST be a MDS Support ATTA.')
      return
    endif

-- Check that the Selected ATTA is a valid MDS Cradle/Reinforcing Pad
    if (!rpad.stype inset ('AT05','AT09','AT23','AT52A','AT52B','AT52C','AT52D','AT52E','AT52F','AT65')) then
-- Valid Pad Atta has been Selected
    else
      !!alert.error('Selected Support is NOT a valid Cradle/Reinforcing Pad Support Atta for a SHOE.')
      golabel /selectpad
    endif

-- Check if the Selected Support ATTA already has a valid :mdssref SHOE Atta Reference
    if (!rpad.:mdssref.badref().not()) then
      --!!alert.error('Selected Support ATTA already has a valid SHOE Atta Reference')
      if (!!alert.confirm('Selected Support Atta already has a valid PAD Atta Reference. Do you want to reset the SHOE Atta reference?').eq('NO')) then
        golabel /selectpad
      endif
    endif

-- Determine if the Pad Atta is an Individual Ancillary or Belongs to a MDS Framework
    !rpadname = !rpad.name
    if (!rpadname.match('/DATUM').gt(0)) then
--  Selected Atta Belongs to a MDS Framework
      !rframe = true
      !rfname = !rpadname.before('/DATUM')
--<wd>feb2004
-- Changed to 'elseif' from 'if' because !rframe was being INCORRECTLY reset to FALSE at the 'else' below, when already set to TRUE above
    --endif
    --if (!rpadname.match('.').gt(0)) then
    elseif (!rpadname.match('.').gt(0)) then
--<wd>feb2004
      !rfname = !rpadname.before('.')
      !rtype  = !rfname.dbref().type
      if (!rtype.eq('STRU')) then
--  Selected Atta Belongs to a MDS Framework
        !rframe = true
      elseif (!rtype.eq('ATTA')) then
-- Selected Atta is Part of an Individual Ancillary Group
        !rframe = false
      endif
    else
-- Selected Atta is an Individual Ancillary or Part of an Individual Ancillary Group
      !rframe = false
      !rfname = !rpadname
    endif

-- Enhance Pad Atta
    enhance $!rpad col 2
    prompt dismiss
    prompt on

--------------------------------------------------------------------------------
-- Select Shoe Label
    label /selectshoe

-- Identify Shoe Atta
    prompt off
    prompt load escape |Identify Shoe...|
    id atta @
    handle (61,528)
      prompt dismiss
      prompt on
      unenhance $!rpad
      handle any
      endhandle
      unenhance $!shoe
      handle any
      endhandle
      return
    endhandle
    !shoe = !!ce

-- Check that the Selected Element is an ATTA
    if (!shoe.type.neq('ATTA')) then
      !!alert.error('Selected element is NOT a Support Atta.')
      golabel /selectshoe
    endif

-- Check that the Selected ATTA Element is a MDS Support ATTA
    !spec = (name of spec of spref)
    if (!spec neq |/MDS|) then
      !!alert.error('Selected Atta MUST be a MDS Support ATTA.')
      return
    endif

-- Check that the Selected SHOE ATTA is a VALID WELDED MDS Standard Shoe - <CLAMP ON SHOES are NOT VALID>
--<wd>16jun2004
    --if (!shoe.stype inset ('AT01', 'AT02', 'AT12', 'AT13','AT14', 'AT15', 'AT18', 'AT19')) then
    if (!shoe.stype inset ('AT01', 'AT02', 'AT12', 'AT13','AT14', 'AT15', 'AT18', 'AT19', 'AT96')) then
--<wd>16jun2004
-- Valid Shoe Atta has been Selected
    else
      !!alert.error('Selected Support is NOT a valid SHOE Support Atta.')
      golabel /selectshoe
    endif

-- Check if the Selected Support ATTA already has a valid :mdssref PAD Atta Reference
    if (!shoe.:mdssref.badref().not()) then
      --!!alert.error('Selected Support Atta already has a valid PAD Atta Reference')
      if (!!alert.confirm('Selected Support Atta already has a valid PAD Atta Reference. Do you want to reset the PAD Atta reference?').eq('NO')) then
        golabel /selectshoe
      endif
    endif

-- Check if the Shoe Atta is on the Same Pipe Branch as the Pad Atta
    if (!shoe.owner.neq(!rpad.owner)) then
      !!alert.error('Selected SHOE Atta is NOT a member of the same Pipe Branch as the PAD Atta')
      golabel /selectshoe
    endif

-----------------------------------------------------------------------------------------
--<wd>28jun2004
-- For the AT65 - a FULL ENCIRCLEMENT WRAPPER PLATE - The ORIENTATION CHECK is NOT REQUIRED
    if (not !rpad.stype inset('AT65')) then
--<wd>28jun2004

-- Check if Shoe Atta is in the Same Orientation as the Pad Atta
      !shoep9dir = !shoe.pdir[9].wrt(/* )
      !rpadp9dir = !rpad.pdir[9].wrt(/* )
-- Set object definition
      !direction = object kequaldir()
      !direction.directionA = !shoep9dir
      !direction.directionB = !rpadp9dir
      !direction.tolerance  = 0.05
      if (!!kdirequaldir(!direction).not()) then
        !!alert.error('Selected SHOE Atta is NOT in the same Orientation as the PAD Atta')
        golabel /selectshoe
      endif

--<wd>28jun2004
    endif
--<wd>28jun2004
-----------------------------------------------------------------------------------------

-- Check if Shoe Atta is in the Same Position as the Pad Atta
    pin 1 at $!shoe
    pin 2 at $!rpad
    !dist = !!kstrreal ('cons dist pin 1 to pin 2')
    if (!dist.gt(1)) then
      !!alert.error('Selected SHOE Atta is NOT in the same Position as the PAD Atta')
      golabel /selectshoe
    endif

-- Determine if the Shoe Atta is an Individual Ancillary or Belongs to a MDS Framework
    !shoename = !shoe.name
    if (!shoename.match('/DATUM').gt(0)) then
--  Selected Atta Belongs to a MDS Framework
      !sframe = true
      !sfname = !shoename.before('/DATUM')
--<wd>feb2004
-- Changed to 'elseif' from 'if' because !sframe was being INCORRECTLY reset to FALSE at the 'else' below, when already set to TRUE above
    --endif
    --if (!shoename.match('.').gt(0)) then
    elseif (!shoename.match('.').gt(0)) then
--<wd>feb2004
      !sfname = !shoename.before('.')
      !stype  = !sfname.dbref().type
      if (!stype.eq('STRU')) then
--  Selected Atta Belongs to a MDS Framework
        !sframe = true
      elseif (!stype.eq('ATTA')) then
-- Selected Atta is Part of an Individual Ancillary Group
        !sframe = false
      endif
    else
-- Selected Atta is an Individual Ancillary or Part of an Individual Ancillary Group
      !sframe = false
      !sfname = !shoename
    endif

-- Enhance Shoe Atta
    enhance $!shoe col 2
    prompt dismiss
    prompt on

--------------------------------------------------------------------------------
--- Check if BOTH Attas are ON the Same FRAMEWORK or Individual Ancillaries
    if (!rframe.not() and !sframe.not()) then
-- Both Attas are Individual Ancillaries and Association is Permissible
    elseif (!rframe and !sframe) then
-- Both Attas on a MDS Framework - MUST be on the Same Framework and Association may be Permissible
      if (!sfname.neq(!rfname)) then
        !!alert.error('Selected Shoe and Pad Attas belong to different MDS Frameworks. Aborting Pad to Shoe Association.')
        unenhance $!rpad
        unenhance $!shoe
--<wd>mar2006
--        !rpad = dbref()
--        !shoe = dbref()
        golabel /selectpad
      endif
    elseif (!rframe and !sframe.not()) then
      !!alert.error('Selected Shoe is an Individual Support and the Pad Atta belongs to a MDS Framework. Aborting Pad to Shoe Association.')
      unenhance $!rpad
      unenhance $!shoe
--<wd>mar2006
--      !rpad = dbref()
--      !shoe = dbref()
      golabel /selectpad
    elseif (!rframe.not() and !sframe) then
      !!alert.error('Selected Pad is an Individual Support and the Shoe Atta belongs to a MDS Framework. Aborting Pad to Shoe Association.')
      unenhance $!rpad
      unenhance $!shoe
--<wd>mar2006
--      !rpad = dbref()
--      !shoe = dbref()
      golabel /selectpad
    endif

--------------------------------------------------------------------------------
-- Check if the Enhanced/Selected Pad and Shoe Attas, highlighted in the Colour RED, are to be Associated
    enhance $!shoe col 2
    if (!!alert.confirm('Associate Cradle/Reinforcing Pad and Shoe highlighted in RED?', 0.4, 0.1).eq('NO')) then
-- Reject the Pad to Shoe Atta Association
      unenhance $!rpad
      unenhance $!shoe
      return
    else
-- Associate the Selected Pad and Shoe Attas
      !shoewarning = string()

---------------------------------------------------------------------------------------------------
--<wd>mar2006<mds12>
--
--      !check    = object mdscheckstd()
--
-- The SHOE variable !shoe is passed to OBJECT below, but it doesn't matter in this case.
-- It could be either the !shoe or the !rpad variable which is passed!
-- The RPAD variable !rpad could be passed instead without changing the outcome of the ASSOCIATION
      !xce  = !!ce
      !lbor = !shoe.lbor.real().value()
      !mdsattaobj  = object mdsreadparsdata()
      !mdsattadefs = !mdsattaobj.mdsdefsdata(!shoe.stype, !lbor)
      if (!mdsattadefs.not()) then
        !!alert.error (|ERROR: ABORTING Pad to Shoe Association|)
        !!kRestoreUnits(!currentunits)
        delete atta
        !!mdsdaccontrol(FALSE)
        return
      endif
      !check = object mdscheckstd(!mdsattaobj)
      !!ce   = !xce
--
--<wd>mar2006<mds12>
---------------------------------------------------------------------------------------------------

-- Cradle Pad Atta Length and Shoe Atta Height are always MODIFIED in the <!checkshoeheight(w,x,y,z) method> below
-- Issue a Warning if SHOE Height is NOT within the MDS Standards Permissible Height Range
      !!mdsdaccontrol(TRUE)
      if (!check.shoeheight(!!mdsancill,!shoe,!rpad,!shoewarning).not()) then
        !!alert.warning(!shoewarning)
      endif
-- Set the Cross Reference Attribute :mdssref at Both Attas and the Pad Atta uda .:mdscp3 to 'SHOE'
      !!MdsDacControl(TRUE)
      !shoe.:mdssref = !rpad
      !rpad.:mdssref = !shoe
      !rpad.:mdscp3  = 'SHOE'
      !!mdsdaccontrol(false)
    endif

-- Unenhance the Selected Attas
    unenhance $!rpad
    unenhance $!shoe

--------------------------------------------------------------------------------

-- Reset Pins
    !!mdsresetpins(1,2)

  endfunction
-- End function
--
-- End of file mdspadshoeref.pmlfnc
--
