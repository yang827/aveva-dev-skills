--
-- File: mdspadstopref.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: David Whiteside
-- Created: Friday 30th January 2009
--
--
-- Description:
-- Function to Associate a Reinforcing Pad Atta with a Valid Stop Atta - Dun1081 - P16049
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

-- define function
define function !!mdspadstopref()

  --------------------------------------------------------------------------------

  -- Identify Pad Atta
  prompt off
  prompt load escape |Identify Reinforcing Pad...|
  id atta @
  handle (61,528)
    prompt dismiss
    prompt on
    unenhance $!rpad
    handle ANY
    endhandle
    return
  endhandle
  !rpad = !!ce

  -- Check that the Selected Element is an ATTA
  if (!rpad.type.neq('ATTA')) then
    !!alert.error('Selected element is NOT a Support Atta.')
    return
  endif

  -- Check that the Selected ATTA Element is a MDS Support ATTA
  !spec = (name of spec of spref)
  if (!spec neq |/MDS|) then
    !!alert.error('Selected Atta MUST be a MDS Support ATTA.')
    return
  endif

  -- Check that the Selected ATTA is a valid MDS Reinforcing Pad
  if (!rpad.stype inset ('AT174','AT175')) then
    -- Valid Pad Atta has been Selected
  else
    !!alert.error('Selected Support is NOT a valid Reinforcing Pad Support Atta for a Stop.')
    return
  endif

  -- Check if the Selected Support ATTA already has a valid :mdssref Stop Atta Reference
  if (!rpad.:mdssref.badref().not()) then
    --!!alert.error('Selected Support ATTA already has a valid Stop Atta Reference')
    if (!!alert.confirm('Selected Support Atta already has a valid PAD Atta Reference. Do you want to reset the Stop Atta reference?').eq('NO')) then
      return
    endif
  endif

  -- Determine if the Pad Atta is an Individual Ancillary or Belongs to a MDS Framework
  !rpadname = !rpad.name
  if (!rpadname.match('/DATUM').gt(0)) then
    --  Selected Atta Belongs to a MDS Framework
    !rframe = TRUE
    !rfname = !rpadname.before('/DATUM')
    --<wd>feb2004
    -- Changed to 'elseif' from 'if' because !rframe was being INCORRECTLY reset to FALSE at the 'else' below, when already set to TRUE above
  elseif (!rpadname.match('.').gt(0)) then
    --<wd>feb2004
    !rfname = !rpadname.before('.')
    !rtype  = !rfname.dbref().type
    if (!rtype.eq('STRU')) then
      --  Selected Atta Belongs to a MDS Framework
      !rframe = TRUE
    elseif (!rtype.eq('ATTA')) then
      -- Selected Atta is Part of an Individual Ancillary Group
      !rframe = FALSE
    endif
  else
    -- Selected Atta is an Individual Ancillary or Part of an Individual Ancillary Group
    !rframe = FALSE
    !rfname = !rpadname
  endif

  -- Enhance Pad Atta
  enhance $!rpad col 2
  prompt dismiss
  prompt on

  --------------------------------------------------------------------------------

  -- Identify Stop Atta
  prompt off
  prompt load escape |Identify Stop...|
  id atta @
  handle (61,528)
    prompt dismiss
    prompt on
    unenhance $!rpad
    handle ANY
    endhandle
    unenhance $!stop
    handle ANY
    endhandle
    return
  endhandle
  !stop = !!ce

  -- Check that the Selected Element is an ATTA
  if (!stop.type.neq('ATTA')) then
    !!alert.error('Selected element is NOT a Support Atta.')
    unenhance $!rpad
    return
  endif

  -- Check that the Selected ATTA Element is a MDS Support ATTA
  !spec = (name of spec of spref)
  if (!spec neq |/MDS|) then
    !!alert.error('Selected Atta MUST be a MDS Support ATTA.')
    unenhance $!rpad
    return
  endif

  -- Check that the Selected Stop ATTA is a VALID WELDED MDS Standard Stop
  if (!stop.stype inset ('ST57','ST58','ST59','GT85')) then
  else
    !!alert.error('Selected Support is NOT a valid Stop Support Atta.')
    unenhance $!rpad
    return
  endif

  -- Check if the Selected Support ATTA already has a valid :mdssref PAD Atta Reference
  if (!stop.:mdssref.badref().not()) then
    if (!!alert.confirm('Selected Support Atta already has a valid PAD Atta Reference. Do you want to reset the PAD Atta reference?').eq('NO')) then
      unenhance $!rpad
      return
    endif
  endif

  -- Check if the Stop Atta is on the Same Pipe Branch as the Pad Atta
  if (!stop.owner.neq(!rpad.owner)) then
    !!alert.error('Selected Stop Atta is NOT a member of the same Pipe Branch as the PAD Atta')
    unenhance $!rpad
    return
  endif

  -----------------------------------------------------------------------------------------
  -- For the AT174 - a FULL ENCIRCLEMENT WRAPPER PLATE - The ORIENTATION CHECK is NOT REQUIRED
  if (not !rpad.stype inset('AT174')) then
    -- Check if Stop Atta is in the Same Orientation as the Pad Atta
    !stopp9dir = !stop.pdir[9].wrt(/* )
    !rpadp9dir = !rpad.pdir[9].wrt(/* )
    -- Set object definition
    !direction = object KEQUALDIR()
    !direction.directionA = !stopp9dir
    !direction.directionB = !rpadp9dir
    !direction.tolerance  = 0.05
    if (!!kdirequaldir(!direction).not()) then
      !!alert.error('Selected Stop Atta is NOT in the same Orientation as the PAD Atta')
      unenhance $!rpad
      return
    endif
  endif
  -----------------------------------------------------------------------------------------

  -- Check if Stop Atta is in the Same Position as the Pad Atta
  pin 1 at $!stop
  pin 2 at $!rpad
  !dist = !!kstrreal ('cons dist pin 1 to pin 2')
  if (!dist.gt(1)) then
    !!alert.error('Selected Stop Atta is NOT in the same Position as the PAD Atta')
    return
  endif

  -- Determine if the Stop Atta is an Individual Ancillary or Belongs to a MDS Framework
  !stopname = !stop.name
  if (!stopname.match('/DATUM').gt(0)) then
    --  Selected Atta Belongs to a MDS Framework
    !sframe = TRUE
    !sfname = !stopname.before('/DATUM')
  elseif (!stopname.match('.').gt(0)) then
    --<wd>feb2004
    !sfname = !stopname.before('.')
    !stype  = !sfname.dbref().type
    if (!stype.eq('STRU')) then
      --  Selected Atta Belongs to a MDS Framework
      !sframe = TRUE
    elseif (!stype.eq('ATTA')) then
      -- Selected Atta is Part of an Individual Ancillary Group
      !sframe = FALSE
    endif
  else
    -- Selected Atta is an Individual Ancillary or Part of an Individual Ancillary Group
    !sframe = FALSE
    !sfname = !stopname
  endif

  -- Enhance Stop Atta
  enhance $!stop col 2
  prompt dismiss
  prompt on

  --------------------------------------------------------------------------------
  --- Check if BOTH Attas are ON the Same FRAMEWORK or Individual Ancillaries
  if (!rframe.not() and !sframe.not()) then
    -- Both Attas are Individual Ancillaries and Association is Permissible
  elseif (!rframe and !sframe) then
    -- Both Attas on a MDS Framework - MUST be on the Same Framework and Association may be Permissible
    if (!sfname.neq(!rfname)) then
      !!alert.error('Selected Stop and Pad Attas belong to different MDS Frameworks. Aborting Pad to Stop Association.')
      unenhance $!rpad
      unenhance $!stop
      return
    endif
  elseif (!rframe and !sframe.not()) then
    !!alert.error('Selected Stop is an Individual Support and the Pad Atta belongs to a MDS Framework. Aborting Pad to Stop Association.')
    unenhance $!rpad
    unenhance $!stop
    return
  elseif (!rframe.not() and !sframe) then
    !!alert.error('Selected Pad is an Individual Support and the Stop Atta belongs to a MDS Framework. Aborting Pad to Stop Association.')
    unenhance $!rpad
    unenhance $!stop
    return
  endif

  --------------------------------------------------------------------------------
  -- Check if the Enhanced/Selected Pad and Stop Attas, highlighted in the Colour RED, are to be Associated
  enhance $!stop col 2
  if (!!alert.confirm('Associate Reinforcing Pad and Stop highlighted in RED?', 0.4, 0.1).eq('NO')) then
    -- Reject the Pad to Stop Atta Association
    unenhance $!rpad
    unenhance $!stop
    return
  else
    -- Associate the Selected Pad and Stop Attas
    !check       = object MDSCHECKSTD()
    -- Pad Atta Length and Stop Atta Height are always MODIFIED in the <!checkstopheight(x,y,z) method> below
    -- Issue a Warning if Stop Height is NOT within the MDS Standards Permissible Height Range
    !!mdsDacControl(TRUE)
    !check.stopheight(!!mdsancill,!stop,!rpad)
    -- Set the Cross Reference Attribute :mdssref at Both Attas and the Pad Atta uda .:mdscp3 to 'Stop'
    !!mdsDacControl(TRUE)
    !stop.:mdssref = !rpad
    !rpad.:mdssref = !stop
    !rpad.:mdscp3  = 'STOP'
    !!mdsDacControl(FALSE)
  endif

  -- Unenhance the Selected Attas
  unenhance $!rpad
  unenhance $!stop

  --------------------------------------------------------------------------------

  -- Reset Pins
  !!mdsresetpins(1,2)

endfunction
-- End function
