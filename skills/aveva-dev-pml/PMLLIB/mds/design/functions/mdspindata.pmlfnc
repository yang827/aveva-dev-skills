--
-- File:		mdspindata.pmlfnc
--   Type:		Form
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design MDS
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Monday 4th October 2004
--
--
-- Description:
-- Function to SAVE or RESTORE Pin Data
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        STRING        'SAVE' or 'RESTORE'
--     2     R        ARRAY         ARRAY of the PIN Numbers to be SAVED or RESTORED
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Define Function
  define function !!mdspindata(!action is STRING, !pindata is array)

-- Determine if GLOBAL Pin Data Variable Array !!mdspindata already exists
   if (!action.upcase().eq('SAVE')) then
     if (defined(!!mdspindata)) then
       !!mdspindata.delete()
       handle ANY
         !!mdspindata = ARRAY()
       endhandle
     endif
   elseif (!action.upcase().eq('RESTORE')) then
     if (undefined(!!mdspindata)) then
-- Return Silently as the GLOBAL Pin Data Variable Array !!mdspindata does NOT exist
       return
     endif
   else
-- Return Silently as an INCORRECT argument has been passed
     return
   endif

-- Determine which ACTION to take.
    if (!action.upcase().eq('SAVE')) then
-- SAVE ---- Pin Data for ALL Pins passed in the array !pindata
      !val = 0
      do !numb values !pindata
        !val = !val + 1
        !!mdspindata[!val] = ARRAY()
        var !pin$!<numb>pos pin $!<numb> position wrt /*
        var !pin$!<numb>dir pin $!<numb> direction wrt /*
        !!mdspindata[!val][1] = !numb
        !!mdspindata[!val][2] = !pin$!<numb>pos
        !!mdspindata[!val][3] = !pin$!<numb>dir
        pin$!<numb> off
      enddo

    elseif (!action.upcase().eq('RESTORE')) then
-- RESTORE - Pin Data for ALL Pins stored in the GLOBAL variable array !!mdspindata
      do !indx indices !!mdspindata
        pin $!!mdspindata[$!indx][1] at $!!mdspindata[$!indx][2] wrt /*
        pin $!!mdspindata[$!indx][1] direction $!!mdspindata[$!indx][3] wrt /*
      enddo
    endif

  endfunction
-- End Function
