--
-- File:		mdsposequalpos.pmlfnc
--   Type:		Function Definition
--   Group:
--     Keyword:
--   Module:		DESIGN
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Thursday 18th November 2004
--
--
-- Description:
-- function to check that two POSITIONS passed are equal to within passed tolerance
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        MDSEQUALPOS     Object holding data to be checked
--
-- Return:
--    [Data Type]   [Description]
--      BOOLEAN      True if directions are equal
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!mdsposequalpos(!object is mdsequalpos) is boolean

-- Initialise variables
    !tol  = !object.tolerance
    !posa = !object.positiona
    !posb = !object.positionb

-- Quick Check if Positions are EXACTLY the same
    if (!posa eq !posb)then
      return TRUE
    endif

-- Check frame of reference
    if (!posa.origin neq !posb.origin)then
      !posb.wrt(!posa.origin)
    endif

-- Get max and min directions
-- Only the ACTUAL Tolerance, i.e. !Tol, is ADDED and SUBTRACTED from the variables !posa.Up/East/North in order to
-- Check the variables !posb.Up/East/North etc... against the !MinUp/East/North,!MaxUp/East/North variables.
    !maxup    = !posa.up    + !tol
    !minup    = !posa.up    - !tol
    !maxeast  = !posa.east  + !tol
    !mineast  = !posa.east  - !tol
    !maxnorth = !posa.north + !tol
    !minnorth = !posa.north - !tol

--<wd>nov2004
-- Test Position B upping
    if (!posb.up geq !minup and !posb.up leq !maxup)then
    elseif (!posb.up leq !minup and !posb.up geq !maxup)then
    else
      return FALSE
    endif

-- Test Position B easting
    if (!posb.east geq !mineast and !posb.east leq !maxeast)then
    elseif (!posb.east leq !mineast and !posb.east geq !maxeast)then
    else
      return FALSE
    endif

-- Test Position B northing
    if (!posb.north geq !minnorth and !posb.north leq !maxnorth)then
    elseif (!posb.north leq !minnorth and !posb.north geq !maxnorth)then
    else
      return FALSE
    endif

-- Positions are the same within the passed Tolerance = !tol
    return TRUE

-- End function
  endfunction

-- End of file mdsposequalpos.pmlfnc
