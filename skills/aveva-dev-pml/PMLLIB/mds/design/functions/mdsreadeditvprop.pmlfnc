-- Define Function
define function !!mdsreadeditvprop() is STRING
  pml reload form !!mdseditvprop
  waiton !!mdseditvprop

  --return !!MdseditVprop.TravelGadget.val.string()
  return !!MdseditVprop.prop1.val.string()

endfunction
