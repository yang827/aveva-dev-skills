--
--
--  Description:  Add frame with tools for reference supports
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsRefSupportGadgets()

  -- IMPORTANT NOTE: this procedure can only be called when in form definition mode

  if !!mdsuniquenames() then
    frame .refsupport 'Reference Supports' at x0 ymax+0.1 width 31
      button .addReference at x1 ymax tooltip 'Add Reference Atta' pixmap width 18 height 18 call '!!mdsAddReferenceAtta(!this)'
      button .remReference at xmax+0.1 ymin tooltip 'Remove Reference Atta' pixmap width 18 height 18 call '!!mdsRemReferenceAtta(!this)'
      button .remAllReference at xmax+0.1 ymin tooltip 'Remove All Reference Atta' pixmap width 18 height 18 callback '!!mdsRemMultiReferenceAtta(!this)'
    exit
  endif

endfunction
