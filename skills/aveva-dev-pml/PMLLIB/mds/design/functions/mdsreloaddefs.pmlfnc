-- Created: Monday 23 April 2007
--
--
--------------------------------------------------------------------------------
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: DESIGN
--   Replaces:
--
--------------------------------------------------------------------------------
-- Description
--
-- RELOADS the MDS12 Application Defaults from the PARAGON MDS DEFAULTS CATALOGUES
--
--------------------------------------------------------------------------------
--
-- Define Function
define function !!mdsReloadDefs()

--<wd>08dec2009 - DFN P-27481
-- TTY mode is used for DM ISODRAFT Drawing Generation
  var !device dev
  if (!device.upcase() eq 'GRAPHICS') then
    !graphics = TRUE
  else
    !graphics = FALSE
  endif
--<wd>08dec2009 - DFN P-27481
-- Initialise the Variables for the /MDS SPEC, and the /MDS/TEMPLATES SITE.
  var !mdsSpec exists /MDS spec
  var !mdsSite exists /MDS/TEMPLATES site

-- Initialise the Variables for the PARAGON DATABASE MDS DEFAULTS CATALOGUES
  var !optn exists /MDS/OPTION/DEFAULTS cata
  var !icon exists /MDS/ICON/DEFAULTS cata
  var !lite exists /MDS/LIGHTING/DEFAULTS cata
  var !zone exists /MDS/ZONEID/DEFAULTS cata
  var !atta exists /MDS/ATTA/DEFAULTS cata
  var !trun exists /MDS/TRUNNION/DEFAULTS cata
  var !prlm exists /MDS/PRELIMINARY/DEFAULTS cata
  var !stru exists /MDS/STRUCTURE/DEFAULTS cata
  var !hang exists /MDS/HANGER/DEFAULTS cata
  !mdsCatas = ARRAY()

-- Check if /MDS exists and is a SPEC, and if /MDS/TEMPLATES exists and is a SITE.
  if ( (!mdsSpec eq 'TRUEB') and (!mdsSite eq 'TRUEB') ) then
    !specPurp = purp of /MDS
    !sitePurp = purp of /MDS/TEMPLATES
    if (!specPurp.neq('MDS') and !sitePurp.neq('NONE')) then
-- ABORT the Reload of MDS Defaults
--<wd>08dec2009 - DFN P-27481 -- TTY mode is used for DM ISODRAFT Drawing Generation
      if (!graphics) then
      !!alert.error('ABORTING the Reloading of the MDS Defaults.
      The PURPOSE attribute of ''/MDS'' specification or the ''/MDS/TEMPLATES'' site is INCORRECT')
      else
        write |ABORTING the Reloading of the MDS Defaults. The PURPOSE attribute of '/MDS' specification or the '/MDS/TEMPLATES' site is INCORRECT|
      endif
--<wd>08dec2009 - DFN P-27481
      return
    endif
  else
-- ABORT the Reload of MDS Defaults
--<wd>08dec2009 - DFN P-27481 -- TTY mode is used for DM ISODRAFT Drawing Generation
    if (!graphics) then
    !!alert.error('ABORTING the Reloading of the MDS Defaults.
    The ''/MDS'' specification or the ''/MDS/TEMPLATES'' site does NOT exist')
    else
      write |ABORTING the Reloading of the MDS Defaults. The '/MDS' specification or the '/MDS/TEMPLATES' site does NOT exist|
    endif
--<wd>08dec2009 - DFN P-27481
    return
  endif

-- Check the <9> PARAGON DATABASE MDS DEFAULTS NAMES exist and they are CATA elements, i.e 'TRUEB'
  if (!optn.neq('TRUEB')) then
    !mdsCatas.append('/MDS/OPTION/DEFAULTS')
  endif

  if (!icon.neq('TRUEB')) then
    !mdsCatas.append('/MDS/ICON/DEFAULTS')
  endif

  if (!lite.neq('TRUEB')) then
    !mdsCatas.append('/MDS/LIGHTING/DEFAULTS')
  endif

  if (!zone.neq('TRUEB')) then
    !mdsCatas.append('/MDS/ZONEID/DEFAULTS')
  endif

  if (!atta.neq('TRUEB')) then
    !mdsCatas.append('/MDS/ATTA/DEFAULTS')
  endif

  if (!trun.neq('TRUEB')) then
    !mdsCatas.append('/MDS/TRUNNION/DEFAULTS')
  endif

  if (!prlm.neq('TRUEB')) then
    !mdsCatas.append('/MDS/PRELIMINARY/DEFAULTS')
  endif

  if (!stru.neq('TRUEB')) then
    !mdsCatas.append('/MDS/STRUCTURE/DEFAULTS')
  endif

  if (!hang.neq('TRUEB')) then
    !mdsCatas.append('/MDS/HANGER/DEFAULTS')
  endif

-- Check MDS DEFAULT CATAS results
  if (!mdsCatas.size().neq(0)) then
-- Certain or ALL MDS DEFAULT CATAS do NOT exist so ABORT the RELOAD of MDS DEFAULTS
    !mdsText = ''
    do !indx indices !mdsCatas
      if (!indx.eq(1)) then
        !mdsText = !mdsCatas[!indx]
      else
        !mdsText = !mdsText & ', ' & !mdsCatas[!indx]
      endif
    enddo
    !errSize = !mdsCatas.size()
-- Concatenate the ERROR text to output to the USER
--------------------------------------------------------------------------------
    !errText = 'ABORTING the Reloading of the MDS Defaults.
    The following ** $!errSize ** MDS DEFAULT CATALOGUES do NOT exist:' & '

    $!mdsText'
--------------------------------------------------------------------------------
--<wd>08dec2009 - DFN P-27481 -- TTY mode is used for DM ISODRAFT Drawing Generation
    if (!graphics) then
    !!alert.error(!errText)
    else
      write '$!errText'
    endif
--<wd>08dec2009 - DFN P-27481
    return
  endif

--$P----------------------------------------------------------------
--clock
--clock init

--<wd>12nov2007 -- DUN767 -- This CODE has been moved into the DESIGN and OUTFITTING module CODE
-- Confirm with user to reload all MDS defaults
--  if (!!alert.confirm('Reload the MDS defaults?').eq('NO')) then
--    return
--  endif
--<wd>12nov2007 -- DUN767

-- Get the PDMS Module
  !bann = banner
  !bnam = !bann.name.upcase()

-- Check the PDMS Module is DESIGN and RELOAD the MDS Defaults
--<wd>may2007
--  if (!bnam.match('DESIGN').gt(0)) or (!bnam.match('OUTFITTING').gt(0)) then
  if (!bnam.match('DESIGN').gt(0)) or (!bann.short.upcase().match('OUTFITTING MK').gt(0)) then
--<wd>may2007

--<wd>12nov2007 -- DUN767 -- This CODE has been moved into the DESIGN and OUTFITTING module CODE from above
-- Confirm with user to reload all MDS defaults
    if (!!alert.confirm('Reload the MDS defaults?').eq('NO')) then
      return
    endif
--<wd>12nov2007 -- DUN767

--$P *** 'Reloading MDS Defaults. Please wait...' ***
    prompt dismiss
    prompt 'Reloading MDS Defaults. Please wait...'

--------------------------------------------------------------------------------
-- RELOAD required DATA from the <9> MDS DEFAULTS CATAs found in the MDS PARAGON DEFAULTS
--  Database, e.g. The "MASTER" MDS project PARAGON DEFAULTS Database "MDS/MDSAPPDEFAULTS"
--------------------------------------------------------------------------------
-- <1> -- RELOAD the MDS FORMS via the PML FUNCTION !!buildMdsForms()
    !!buildMdsForms()

-- <2> -- RELOAD ALL the MDS Application Defaults from the PARAGON DATABASE MDS DEFAULTS
    !!mdsdflts.init('')

-- <3> -- ONLY RELOAD the FORM list gadget !!mdsFHanger.standard from the PARAGON DATABASE MDS HANGER DEFAULTS when using /MDS/HANGER/TEMPLATES
    if (!!mdshangif.eq('MDS')) then
-- DELETE any EXISTING MDS HANGER TEMPLATE global variables originally set in the PML function, !!mdsIfHanger()
-- Deleting these variables forces !!mdsIfHanger, when initialised, to automatically REGENERATE them and the data within.
      if (defined(!!mdsallhangertypes)) then
        !!mdsallhangertypes.delete()
      endif
      if (defined(!!mdsstandardfhdtext)) then
        !!mdsstandardfhdtext.delete()
      endif
      if (defined(!!mdsstandardvhdtext)) then
        !!mdsstandardvhdtext.delete()
      endif
-- Reinitialise the MDS HANGER TEMPLATE OBJECTS and FORM etc... via !!mdsIfHanger()
-- **********************
-- *** IMPORTANT NOTE ***
-- **********************
-- IT IS NOT NECESSARY to run the !!mdsIfHanger() PML function here, because it is automatically
-- initialised when the FIXED and/or the VARIABLE HANGER CREATE MENUS or ICONS are activated
      --!!mdsIfHanger()
-- **********************

    endif

--<wd>12nov2007 -- DUN767 -- Defect No. P-4160
  elseif (!bnam.upcase().match('ISODRAFT').gt(0))  then
-- MDS OPTION DEFAULTS Loading for the ISODRAFT Module when required.
-- The MDS OPTION Defaults need to be LOADED in ISODRAFT to enable the MDS DESCRIPTIONS to be DISPLAYED in the ISOMETRIC MTO
-- This ONLY needs to be done when entering ISODRAFT directly without FIRST entering the MDS DESIGN or MDS DRAFT application
    if (undefined(!!mpu)) then
-- LOAD the MDS OPTION DEFAULTS in ISODRAFT via the object MDSOPTIONDEFS
      !unusedLoadMdsOptions = object MDSOPTIONDEFS()
    endif
--<wd>12nov2007 -- DUN767 -- Defect No. P-4160

  endif

--<wd>08dec2009 - DFN P-27481 -- TTY mode is used for DM ISODRAFT Drawing Generation
  if (!graphics) then
  prompt dismiss
  endif
--<wd>08dec2009 - DFN P-27481

--clock read elapsed
--clock
--$P----------------------------------------------------------------

endfunction
