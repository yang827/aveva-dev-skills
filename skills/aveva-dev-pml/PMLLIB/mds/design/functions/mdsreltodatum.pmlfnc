--------------------------------------------------------------------------------
--
-- File:  mdsreltodatum.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  I.osborne
-- Created:  Thu Jul 03
-- Description:
-- function to identify position of supporting structure relative to the datum. It
-- checks the direction from a point of intersection on the passed element relative
-- to the direction passed. if the direction oppose each other then the element is
-- considered to be below the datum in the passed direction.
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R          DBREF       Support Datum
--     2     R          DBREF       Identified element to support from
--                                  Only Sections, Panels (hardtype) and Boxes allowed.
--                                  Building Vessel Framework Types ONLY
--     3     R        DIRECTION     Direction from datum point
--     4     R           REAL       Tolerance for positional data
--
-- Return:
--    [Data Type]   [Description]
--      ARRAY        1. Determines whether the identified element is
--                      'above, below or equal' to the datum from the given
--                      direction, or returns 'unset' if element is unsuitable
--                   2. If Identified element is a box or a panel and a return
--                      of 'above or below' is defined then the plane constructed
--                      on the surface is also returned
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsRelToDatum(!datum is DBREF, !element is DBREF, !dir is DIRECTION, !tol is REAL) is ARRAY

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()

  -- Initialise variables

  !array = ARRAY()

  -- Check that the element is suitable
  --<wd>may2007<mds12>
  --  if (!element.hardType inset('GENSEC','SCTN', 'PANE', 'BOX', 'SBFI'))then
  if (!element.hardType inset('GENSEC','SCTN', 'PANE', 'BOX', 'SBFI', 'HSTIFF', 'HPLATE'))then
    --<wd>may2007<mds12>
    golabel /Start
  else
    !type = !element.type
    !!alert.error('Picked element ($!type) is not suitable to support from. Identify section, panels or boxes only.')
    !array[1] = ''
    !!kRestoreUnits(!currentUnits)
    return !array
  endif

  label /Start

  -- Navigate to datum point and get positional data

  !!ce = !datum
  var !datumLine CONS LINE $!dir thro P0

  -- Navigate back

  !!ce = !element

  -- ############################## SECTIONS #################################
  --<wd>may2007<mds12>
  --  if (!!ce.type eq 'SCTN' or !!ce.hardType.eq('SCTN') )then
  if (!!ce.type eq 'SCTN' or !!ce.hardType.eq('SCTN') or !!ce.type eq 'HSTIFF' or !!ce.hardType.eq('HSTIFF'))then
    --<wd>may2007<mds12>

    !posStart = plstart NA wrt world
    !posEnd   = plend NA wrt world

    var !sctnLine CONS LINE JOIN $!posStart to $!posEnd
    var !inter CONS POS INT $!datumLine $!sctnLine
    if (!inter eq '')then
      -- Lines are parallel
      !array[1] = 'unset'
      !!kRestoreUnits(!currentUnits)
      return !array
    else

      -- Determine direction from datum to intersection point
      PIN 9 AT $!inter WRT WORLD
      PIN 9 DIR FROM PIN 9 TO P0 of $!datum
      handle (2,357)
        !!alert.message('Unable to determine the direction. Please reposition the datum atta and try again')
        $mk
      endhandle
      !distance = !!kStrReal('CONST DIST PIN 9 TO P0 of $!datum')
      var !pin9Dir PIN 9 DIR WRT WORLD
      PIN 9 OFF

      if (!distance.leq(!tol))then
        !array[1] = 'unset'
        !!kRestoreUnits(!currentUnits)
        return !array
      endif

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !dir
      !direction.directionB = !pin9Dir.direction()
      !direction.tolerance  = 0.05
      if (!!kDirEqualDir(!direction)) then
        -- Intersection point is behind datum
        !array[1] = 'above'
        !!kRestoreUnits(!currentUnits)
        return !array
      else
        -- Intersection point is infront of datum
        !array[1] = 'below'
        !!kRestoreUnits(!currentUnits)
        return !array
      endif
    endif

  elseif !!ce.hardType.eq('GENSEC') then

    !posStart = plstart NA wrt world
    !posEnd   = plend NA wrt world

    var !sctnLine CONS LINE JOIN $!posStart to $!posEnd
    var !inter CONS POS INT $!datumLine $!sctnLine
    if (!inter eq '')then
      -- Lines are parallel
      !array[1] = 'unset'
      !!kRestoreUnits(!currentUnits)
      return !array
    else

      -- Determine direction from datum to intersection point
      PIN 9 AT $!inter WRT WORLD
      PIN 9 DIR FROM PIN 9 TO P0 of $!datum
      handle (2,357)
        !!alert.message('Unable to determine the direction. Please reposition the datum atta and try again')
        $mk
      endhandle
      !distance = !!kStrReal('CONST DIST PIN 9 TO P0 of $!datum')
      var !pin9Dir PIN 9 DIR WRT WORLD
      PIN 9 OFF

      if (!distance.leq(!tol))then
        !array[1] = 'unset'
        !!kRestoreUnits(!currentUnits)
        return !array
      endif

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !dir
      !direction.directionB = !pin9Dir.direction()
      !direction.tolerance  = 0.05

      if (!!kDirEqualDir(!direction)) then
        -- Intersection point is behind datum
        !array[1] = 'above'
        !!kRestoreUnits(!currentUnits)
        return !array
      else
        -- Intersection point is infront of datum
        !array[1] = 'below'
        !!kRestoreUnits(!currentUnits)
        return !array
      endif
    endif

    -- ############################## BOXES #################################

    --<wd>may2007<mds12>
    --  elseif (!!ce.hardType eq 'PANE' or !!ce.type eq 'BOX' or !!ce.type eq 'SBFI' )then
  elseif (!!ce.hardType eq 'PANE' or !!ce.type eq 'BOX' or !!ce.type eq 'SBFI' or !!ce.hardType eq 'HPLATE')then
    --<wd>may2007<mds12>

    if (!!ce.type eq 'BOX') then

      if (!dir eq U or !dir eq D)then

        PIN 8 AT P0 OF $!datum
        PIN 8 DIR $!dir
        PIN 9 AT P0 OF $!datum
        PIN 9 DIR $!dir
        PIN 9 PLANE PIN 9 CLEAR 0 INF $!element
        !p0Pin9Inf = !!kStrReal('CONST DIST P0 of $!datum To PIN 9')
        VAR !pin9inf PIN 9 UP WRT WORLD
        PIN 9 AT P0 OF $!datum
        PIN 9 PLANE PIN 9 CLEAR 0 BEH $!element
        !p0Pin9Beh = !!kStrReal('CONST DIST P0 of $!datum To PIN 9')
        VAR !pin9beh PIN 9 UP WRT WORLD
        if (!p0Pin9Inf.leq(!p0Pin9Beh))then
          !side = 'INF'
        else
          !side = 'BEH'
        endif
        PIN 9 AT P0 OF $!datum
        PIN 9 PLANE PIN 9 CLEAR 0 $!side $!element
        PIN 9 DIR FROM PIN 9 TO PIN 8
        VAR !planeDir PIN 9 DIR WRT WORLD
        VAR !plane CONST PLANE $!planeDir THRO PIN 9

        PIN 9 OFF
        !distance = !!kStrReal('CONST DIST PIN 9 TO P0 of $!datum')

        if (!distance.leq(!tol))then
          !array[1] = 'unset'
          !array[2] = !plane
          !!kRestoreUnits(!currentUnits)
          return !array
        endif

        -- Set object definition
        !direction = object KEQUALDIR()
        !direction.directionA = !dir
        !direction.directionB = !planeDir.direction()
        !direction.tolerance  = 0.05

        !array[2] = !plane

        if (!!kDirEqualDir(!direction)) then
          -- Intersection point is behind datum
          !array[1] = 'above'
          !!kRestoreUnits(!currentUnits)
          return !array
        else
          -- Intersection point is infront of datum
          !array[1] = 'below'
          !!kRestoreUnits(!currentUnits)
          return !array
        endif

      else

        PROMPT OFF
        PROMPT LOAD ESCAPE |Identify Ppoint on surface of box|
        VAR !point PICK pp
        handle (61,528)
          PROMPT DISMISS
          PROMPT ON
          !array[1] = ''
          !!kRestoreUnits(!currentUnits)
          return !array
        endhandle
        PROMPT DISMISS
        PROMPT ON

        var !pdir dir $!point[1] WRT WORLD
        VAR !pPos POS $!point[1] WRT WORLD

        -- Create Plane on surface
        !planePos = !pPos.position()
        !surfaceDir = !pdir.direction()
        VAR !plane CONST PLANE $!surfaceDir THRO $!planePos
        PIN 9 copy P0 OF $!datum
        PIN 9 DIR $!dir
        VAR !inter CONST POS INTER PIN 9 $!plane

        if (!inter eq '')then
          -- Plane and Direction are parallel
          Call !!mdsResetPins(9,9)
          !array[1] = 'unset'
          !array[2] = !plane
          !!kRestoreUnits(!currentUnits)
          return !array
        endif

        PIN 9 AT $!inter wrt world
        VAR !relDir CONST DIR PIN 9 TO P0 of $!datum

        PIN 9 OFF

        !distance = !!kStrReal('CONST DIST PIN 9 TO P0 of $!datum')
        if (!distance.leq(!tol))then
          !array[1] = 'unset'
          !array[2] = !plane
          !!kRestoreUnits(!currentUnits)
          return !array
        endif

        -- Set object definition
        !direction = object KEQUALDIR()
        !direction.directionA = !relDir.direction()
        !direction.directionB = !dir
        !direction.tolerance  = 0.05

        !array[2] = !plane

        if (!!kDirEqualDir(!direction)) then
          !array[1] = 'above'
          !!kRestoreUnits(!currentUnits)
          return !array
        else
          !array[1] = 'below'
          !!kRestoreUnits(!currentUnits)
          return !array
        endif

      endif

    elseif (!!ce.type eq 'SBFI') then

      -- ############################## SBFI #################################

      if (!dir eq U or !dir eq D)then

        PIN 8 AT P0 OF $!datum
        PIN 8 DIR $!dir
        PIN 9 AT P0 OF $!datum
        PIN 9 DIR $!dir
        PIN 9 PLANE PIN 9 CLEAR 0 INF $!element
        !p0Pin9Inf = !!kStrReal('CONST DIST P0 of $!datum To PIN 9')
        VAR !pin9inf PIN 9 UP WRT WORLD
        PIN 9 AT P0 OF $!datum
        PIN 9 PLANE PIN 9 CLEAR 0 BEH $!element
        !p0Pin9Beh = !!kStrReal('CONST DIST P0 of $!datum To PIN 9')
        VAR !pin9beh PIN 9 UP WRT WORLD
        if (!p0Pin9Inf.leq(!p0Pin9Beh))then
          !side = 'INF'
        else
          !side = 'BEH'
        endif
        PIN 9 AT P0 OF $!datum
        PIN 9 PLANE PIN 9 CLEAR 0 $!side $!element
        PIN 9 DIR FROM PIN 9 TO PIN 8
        VAR !planeDir PIN 9 DIR WRT WORLD
        VAR !plane CONST PLANE $!planeDir THRO PIN 9

        PIN 9 OFF
        !distance = !!kStrReal('CONST DIST PIN 9 TO P0 of $!datum')

        if (!distance.leq(!tol))then
          !array[1] = 'unset'
          !array[2] = !plane
          !!kRestoreUnits(!currentUnits)
          return !array
        endif

        -- Set object definition
        !direction = object KEQUALDIR()
        !direction.directionA = !dir
        !direction.directionB = !planeDir.direction()
        !direction.tolerance  = 0.05

        !array[2] = !plane

        if (!!kDirEqualDir(!direction)) then
          -- Intersection point is behind datum
          !array[1] = 'above'
          !!kRestoreUnits(!currentUnits)
          return !array
        else
          -- Intersection point is infront of datum
          !array[1] = 'below'
          !!kRestoreUnits(!currentUnits)
          return !array
        endif

      else


        VAR !pdir DIR P1 WRT WORLD
        VAR !pPos POS P1 WRT WORLD

        -- Create Plane on surface
        !planePos = !pPos.position()
        !surfaceDir = !pdir.direction()
        VAR !plane CONST PLANE $!surfaceDir THRO $!planePos
        PIN 9 copy P0 OF $!datum
        PIN 9 DIR $!dir
        VAR !inter CONST POS INTER PIN 9 $!plane

        if (!inter eq '')then
          -- Plane and Direction are parallel
          Call !!mdsResetPins(9,9)
          !array[1] = 'unset'
          !array[2] = !plane
          !!kRestoreUnits(!currentUnits)
          return !array
        endif

        PIN 9 AT $!inter wrt world
        VAR !relDir CONST DIR PIN 9 TO P0 of $!datum

        PIN 9 OFF

        !distance = !!kStrReal('CONST DIST PIN 9 TO P0 of $!datum')
        if (!distance.leq(!tol))then
          !array[1] = 'unset'
          !array[2] = !plane
          !!kRestoreUnits(!currentUnits)
          return !array
        endif

        -- Set object definition
        !direction = object KEQUALDIR()
        !direction.directionA = !relDir.direction()
        !direction.directionB = !dir
        !direction.tolerance  = 0.05

        !array[2] = !plane

        if (!!kDirEqualDir(!direction)) then
          !array[1] = 'above'
          !!kRestoreUnits(!currentUnits)
          return !array
        else
          !array[1] = 'below'
          !!kRestoreUnits(!currentUnits)
          return !array
        endif

      endif

      -- ############################## PANELS #################################

    else

      --we are at a panel/wall/?????
      !pv = object POINTVECTOR()
      !pv.position = !datum.position
      !pv.direction = !dir
      -- third parameter set to true draws pin 10 at the panel intersection point
      -- !test = object MDSGETWALLPLANE(!pv,!!ce,TRUE)

      --$R110
      -- call to the mdsgetwallplane object
      -- sets a position of intersection and a plane through that position on the object surface
      -- also sets the above/below details (arrangement)
      !test = object MDSGETWALLPLANE(!pv,!!ce)
      --$R

      if !test.finalpos.unset() then
        !array[1] = 'UNSET'
        !!kRestoreUnits(!currentUnits)
        return !array
      endif

      !array[1] = !test.arrangement
      !array[2] = !test.formatplane(!test.finalplane)
      !array[3] = !test.finalplane.direction()

      !!kRestoreUnits(!currentUnits)

      return !array

    endif
  endif

  -- Reset Units

  !!kRestoreUnits(!currentUnits)

endfunction
