--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsRemMultiReferenceAtta(!form is FORM)

  -- initialize variables
  !support = !form.support
  !datum    = !support.datum
  !alias = !support.alias
  !type = !support.type

  -- Check that Datum atta has been created
  if !datum.set().not() then
    !!alert.message('Datum support atta has not been created')
    return
  endif

  -- check if only DATUM atta exists
  if !support.atta.size().leq(2) then
    !!alert.message('No reference support to remove')
    return
  endif

  if !support.modify then
    if !form.cancel.active then
      if !!alert.confirm('If you remove reference atta you will not be able to cancel the changes. Do you wish to continue?').boolean().not() then
        return
      endif
    endif
  endif

$(
  do
  	if !support.atta.size().eq(3) then
  		!atta = !support.atta[3]
  		break
  	endif
    !atta = !support.singlePick('ATTA','Identify reference support (ATTA) to remove')
    if !atta.unset() then
    	return
    endif
    if !support.atta.find(!atta).unset() then
    	!!alert.error('Support picked does not belong to that frame')
    	skip
    endif
    if !atta.eq(!support.datum).or(!atta.eq(!support.sref())) then
    	!!alert.error('Datum atta cannot be deleted.')
    	skip
    endif
    break
  enddo
$)
  if !!alert.confirm('Are you sure you want to remove all reference supports from the frame?').boolean().not() then
  	return
  endif

  if !support.modify.and(!form.cancel.active) then
  	!form.cancel.active = false
  endif

  -- get number of crossbars
  !nofbars = !support.crossbars().size()
  -- get reference atta's to remove
  !attas = !support.referenceAtta()

  -- remove reference att
  do !atta values !attas
	  !!mdsRemSingleReferenceAtta(!atta,!support)
	enddo

  -- update form object
  !form.support = !support

  -- collect crossbars
  !bars = !support.crossbars()
  -- if some crossbar has been deleted then rename remaining crossbars and rebuild the frame
  if !nofbars.gt(!bars.size()) then
  	do !bar values !bars
  		!!ce = !bar
  		unname
  	enddo
  	do !c indices !bars
  		!bars[!c].name = !support.stru.name & '-BAR-' & !c
  	enddo
  	if !type.neq('SPECIAL') then
  		!functioncall = '!!mdscreate' & !alias & '(''DIMENSION'')'
  		!functioncall.block().evaluate()
  	endif
  endif

  -- Enhance elements using colour set for highlight
  !form.support.enhance(on)

  -- update aid text
  !!mdsaidtext(!form)

endfunction
