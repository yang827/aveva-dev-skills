--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsRemSingleReferenceAtta(!atta is DBREF, !support is ANY)

  -- delete compensation first
  !!mdsCompplateDflts.deleteCompplate(!atta)

  -- setup association object
  !assoc = object MDSASSOCIATION(!support.stru,false)
  -- delete association
  !assoc.remAssociation(!atta)
  -- remove atta from list
  !index = !support.atta.findfirst(!atta)
  !support.atta[!index].delete()
  !support.attaRefPositionStore[!index].delete()
  handle ANY
  endhandle
  -- reset attributes
  !atta.:mdssupptype = !atta.styp

  -- unenhance atta and remove associated aid text
  unenhance $!atta
  !aidnumb = 208 + !index
  aid clear text $!aidnumb
  handle ANY
  endhandle

  -- loop through crossbars to remove reference to removed atta
  !bars = !support.crossbars()
  do !c indices !support.bars
    !index = !support.bars[!c].findfirst(!atta)
    if !index.set() then
      !support.bars[!c].remove(!index)
      if !support.bars[!c].set() then
        -- remove reference only
        if defined(!bars[!c]) then
          !bars[!c].:mdsattaref = !support.bars[!c]
        endif
      else
        -- delete section if not a SPECIAL
        if !support.type.neq('SPECIAL') then
          !!ce = !bars[!c]
          delete SCTN
          !support.bars.remove(!c)
          !bars.remove(!c)
          !support.barlen.remove(!c)
        endif
      endif
    endif
  enddo

endfunction
