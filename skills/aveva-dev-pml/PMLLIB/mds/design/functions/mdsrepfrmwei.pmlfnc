--
--
-- File:		MdsRepFrmWei
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		
--   Replaces:
--
-- Author:	        Neale Morris
-- Created:	        16th July 2003
--
--
-- Description:        Function to return the totel weight of framework
--                     Only actioned if the atta is the SREF atta
--
--------------------------------------------------------------------------------------------------------
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        ARRAY         Array of PDMS Elements Selected by the MDS REPORT
--     2      RW       ARRAY         Array of WEIGHT values for the MDS Attas in Argument 1
--                                   these by default will always be set to 0
--
-- Return:
--    [Data Type]   [Description]
--       ARRAY        ARRAY of WEIGHT Values for EACH MDS Atta and SCTN for EACH
--                    of the Selected MDS Elements
--
--------------------------------------------------------------------------------------------------------

-- Define Function
  define function !!MdsRepFrmWei(!selection is array, !weights is array) is array

-- Get Current Distance Units


    if (!!isImperialLength('DIST').not()) then
-- Metric Distance Units
      !mmdist = true
    else
-- Imperial Distance Units
      !mmdist = false
    endif

-- Loop thro the List of Selected Items and Assign the Correct Weight
    !x = 0
    do !val values !selection
      !x = !x + 1
      !!ce = !val.dbref()
      if (!val.dbref().hardtype.eq('ATTA')) and matchwild(name,'*/SREF') then

-- We need to use the mdsabatitleblock form to calculate the weight
        if undefined(!!MdsAbaTitleBlock) then
          pml load form !!MdsAbaTitleBlock
        endif

-- Pass the name of the support to the calcweight method


        !FrmwWeight = !!mdsabatitleblock.calcweight(!!ce.name.before('/SREF'))
          handle any
            if !!ce.:MdsSuppType.matchwild(:mdssupptype,'TT*') then
              !Weights[!x] = 'N/A'
            else
              !Weights[!x] = 'ERROR'
            endif
          elsehandle none
            !FrmwWeight = (str(!frmwWeight.real()))
            !TmpWei = (str((real(!FrmwWeight)) ,'d2'))
            !Weights[!x] = !TmpWei
          endhandle

      elseif (!val.dbref().hardtype.eq('ATTA')) then

       !Weights[!x] = (STR((REAL(PROP WEIG )),'D2'))
         handle any
           !Weights[!x] = '0'
         elsehandle none
           if !Weights[!x].eq('') then
             !Weights[!x] = 'ERROR'
           endif
         endhandle

-- For plat elements
      elseif (!val.dbref().hardtype.eq('REDU')) then

       !Weights[!x] = (STR((REAL(PROP WEIG )),'D2'))
         handle any
           !Weights[!x] = '0'
         elsehandle none
           if !Weights[!x].eq('') then
             !Weights[!x] = 'ERROR'
           endif
         endhandle

      endif

    enddo

   return !weights

  endfunction

return

--------------------------------------------------------------------------------------------------------
