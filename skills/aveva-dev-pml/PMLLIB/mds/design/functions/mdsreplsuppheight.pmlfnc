--
--
-- File:		mdsreplsuppheight.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:
--   Replaces:
--
-- Author:	        Wayne Dodwell
-- Created:	        27th March 2002
--
--
-- Description:        Function to Return array of height values for lighting supports
--
--------------------------------------------------------------------------------------------------------
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        ARRAY         Array of supports Selected by the MDS REPORT
--
-- Return:
--    [Data Type]   [Description]
--       ARRAY        ARRAY of HEIGHT Values for EACH MDS lighting support
--
--
--
--------------------------------------------------------------------------------------------------------

-- Define Function
  define function !!mdsreplsuppheight(!selection is ARRAY) is ARRAY

-- Loop thro the List of Selected Items and Assign the Correct HEIGHT or BLANK VALUE
    !result = ARRAY()
    do !c indices !selection
       !supp = !selection[!c].dbref()
       !obj = object MDSLSUPPORT(!supp)
       !result[!c] = !obj.heig.string()
         handle ANY
           !result[!c] = ''
         endhandle
    enddo

   return !result

  endfunction

return

--------------------------------------------------------------------------------------------------------
