-- Author:  Tony Martin
-- Created:  04/05/2004 10:26
--
--
-- Description:
-- Function to set the length of a trunnion
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      Length
--     2     R         DIRECTION   Direction of trunnion
--     3     R         POSITION    Start Position
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
-- function to reset the length of a trunnion to steelwork
--------------------------------------------------------------------------------
-- parameters
-- para 1 is an array containing one or two ATTA DBREFS(if its two, there are two branches to resize)
-- para 2 is the width between support steel
-- para 3 is the width of steelwork members
-- para 4 is the overlap past the steelwork
--
-- Define Function
define function !!mdsResetTrunLen(!supps is ARRAY,!dim is REAL,!width is REAL,!overlap is REAL)

  !finalDim = 0.5 * (!dim + !width + !width + !overlap + !overlap)

  if !supps.size().eq(2) then $* its a double trunnion
    if not(!supps[1].stype inset('TT17','TT24')) then
      !!alert.error('This Type of Trunnion is Not Suitable for Resizing')
      return
    endif
    do !a values !supps
      !!ce = !a
      plat 1
      position pl dist $!finalDim from ph
      bran
      position pt at pl of last mem
      !!ce = !a
      desp n3 $!finalDim
    enddo
  else $* its an atta
    if not(!supps[1].stype inset('LT14A')) then
      !!alert.error('This Type of Trunnion is Not Suitable for Resizing')
      return
    endif
    !!ce = !supps[1]
    !dp5 = !finalDim - !overlap
    desp n5 $!dp5
    desp n6 $!overlap
  endif

endfunction
