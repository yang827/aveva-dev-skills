--
-- File:		mdsresetunits.pmlfnc
--   Type:		Form
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Friday 23rd August 2002
--
--
-- Description:
-- Function to Reset the PDMS UNITS to the UNITS DEFINED
-- in the Standard 'AVEVA - PDMS DESIGN Module UNITS form <!!comFormatsSelect>
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
  define function !!mdsresetunits()

-- Initialise Variables
    if (undefined(!!comFormatsSelect)) then
      pml load form !!comFormatsSelect
      !!comFormatsSelect.init()
    !formShown = FALSE
  else
    if !!comFormatsSelect.shown() then
      !formShown = TRUE
    else
      !formShown = FALSE
    endif
  endif

    !form = !!comFormatsSelect

--<RM 09/04/09> found a bug in which unit format conversions are not being done properly
-- in the program for gadgets with a format object assigned to it. this only occurs if the form is not displayed
-- i have therefore included a show and hide process for this function to ensure that no errors
-- are encountered during calls to reset the units back to the global values stored in pdms <comFormatsSelect.pmlfrm>
  if !formShown.not() then
    show !!comFormatsSelect
  endif

-- Reset PDMS Bore Units
    !form.setformat('BORE')
  handle any
    !!alert.error('an error has been detected during bore unit conversion in mdsresetunits.pmlfnc please contact an Aveva support representative')
    if !formShown.not() then
      hide !!comFormatsSelect
    endif
  endhandle

-- Reset PDMS Distance Units
    !form.setformat('DISTANCE')
  handle any
    !!alert.error('an error has been detected during distance unit conversion in mdsresetunits.pmlfnc please contact an Aveva support representative')
    if !formShown.not() then
      hide !!comFormatsSelect
    endif
  endhandle

  if !formShown.not() then
    hide !!comFormatsSelect
  endif
  --<RM 09/04/09> end of fix
  endfunction
