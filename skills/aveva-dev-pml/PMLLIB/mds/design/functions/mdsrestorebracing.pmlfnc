--
-- File: mdsrestorebracing
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: D Whiteside
-- Created: Wed Sept 25
--
--
-- Description:
-- Multi Discipline support bracing function
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsrestorebracing(!form is FORM)

   !!mdsdaccontrol(true)
   !!mdsdelbraceattas(!FORM)
   !strufrmw = !form.support.stru
   !bracings = !form.support.bracings
   !framwork = !strufrmw.fullname & '/MAIN'
   !framatta = !strufrmw.fullname & '/SREF'
   $!framwork
   last sctn
   do !indx index !bracings
      !bracemem     = !bracings[!indx]
      new sctn
      !!ce.name     = !bracemem.sctnname
      !!ce.spre     = !bracemem.sctnspre
      !!ce.poss     = !bracemem.sctnposs
      !!ce.pose     = !bracemem.sctnpose
      !!ce.drns     = !bracemem.sctndrns
      !!ce.drne     = !bracemem.sctndrne
      !!ce.bangle   = !bracemem.sctnbangle
      !!ce.jusline  = !bracemem.sctnjusline
      !!ce.despara  = !bracemem.sctndespara
      !!ce.purpose  = !bracemem.sctnpurpose
      !!ce.function = !bracemem.sctnfunction
   enddo

   if (defined(!!mdsframebracing)) then
      if (!!mdsframebracing eq 'true') then
         $!framatta
         do !indx index !bracings
            !bracemem    = !bracings[!indx]
            new atta
            !!ce.name    = !bracemem.attaname
            !!ce.spre    = !bracemem.attaspre
            !!ce.despara = !bracemem.attadespara
            !!ce.:mdscp3 = !bracemem.attamdscp3
         enddo
      endif
   endif

   !!mdsdaccontrol(false)

-- End function
endfunction
