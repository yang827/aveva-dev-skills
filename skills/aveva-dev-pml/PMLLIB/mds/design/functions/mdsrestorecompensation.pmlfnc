-------------------------------------------------------------------------------
-- Description:
---------------
--
-- Function to RESTORE the MDS Support compensation DATA for the passed FORM and RESTORE MODE,
-- for all MDS SCTN elements
--
-------------------------------------------------------------------------------
-- Arguments:
--    [#]  [R/RW] [Data Type] [Description]
--     1    R       FORM       MDS FRMW Form
--
-- Return:
--    [Data Type]   [Description]
--
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
define function !!mdsrestorecompensation(!form is FORM)

  do !atta values !form.support.atta
    skip if badref(!atta)
    -- In case user has created a compensation for an existing atta
    -- or modified an existing compensation
    -- delete all compensations
    !!mdsCompplateDflts.deleteCompplate(!atta)
  enddo

    -- restore compensations
  !!mdsCompplateDflts.compensatingPlates(!form.support.compensation)

endfunction
