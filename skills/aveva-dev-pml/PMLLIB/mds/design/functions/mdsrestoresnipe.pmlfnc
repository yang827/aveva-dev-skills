--
--   File: mdsrestoresnipe.pmlfnc
--   Type: Object Definition
--   Group:Multi Discipline Supports Application
--   Keyword: MDS
--   Module: DESIGN
--
-- Author:  Wayne Dodwell
-- Created: Friday 17th August 2007
--
--
-------------------------------------------------------------------------------
-- Description:
---------------
--
-- Function to RESTORE the MDS Support SNIPE/FITTING element DATA for the passed FORM and RESTORE MODE,
-- for all MDS SCTN elements, but ONLY where the GTYPE of the SCTN CATREF is set to 'ANG'
-- and the PURPOSE of the MDS SNIPE/FITTING is set to 'XGUI'
--
-- ***********************
-- *** IMPORTANT NOTES ***
-- ***********************
-- NOTE <1>:
-- This function run AFTER the AUTOMATICALLY generated MDS SNIPES have already been CREATED during the
-- regeneration of the MDS Support Framework Structure
--
-- NOTE <2>:
-- ALL MDS SNIPES/FITTINGS where the PURPOSE is NOT set to 'XGUI' are NOT REGENERATED via this code as they are:
-- either:
-- "AUTOMATICALLY" created for all MDS 'ANG' SCTN 'ends' associated with or connected EXTERNALLY to the
-- MDS Support to an 'ANGLE' type STRUCTURAL element,
-- or:
-- "PRE-DEFINED" on the MDS SCTNS in the relevant MDS FRAMEWORK STANDARD TEMPLATES stored in the MDS DEFAULT TEMPLATE SITE element /MDS/TEMPLATES
--
-------------------------------------------------------------------------------
-- Arguments:
--    [#]  [R/RW] [Data Type] [Description]
--     1    R       FORM       MDS FRMW Form
--     2    R       STRING     Restore Mode is either 'CANCEL' or 'DIMENSION'
--                             'CANCEL'    = Restore Original STATE of MDS FRMW Support a FORM Initialisation
--                             'DIMENSION' = Regenerate ALL MDS SNIPES with a PURPOSE of 'XGUI', all other MDS SNIPES are
--                                           created automatically when either:
--                                           <a> the MDS SCTN has a GTYP of CATREF  set to 'ANG' and its :mdsconn attribute
--                                           references either a SCTN or GENSEC which has a GTYP of CATREF set to 'ANG' or
--                                           a HSTIFF which has a GTYP of CATREF set to 'EANG' or 'UEAN',
--                                           or:
--                                           <b> the MDS SNIPES exist in the MDS TEMPLATE in the SITE /MDS/TEMPLATES or /MDS/TEMPLATES/ORI
--
-- Return:
--    [Data Type]   [Description]
--
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
define function !!mdsrestoresnipe(!form is FORM, !mode is STRING)

-- Determine the type of Restore Mode
  if (!mode.upcase().eq('CANCEL')) then
-- The CANCEL button on the MDS FRMW FORM has been clicked, so RESTORE the MDS FRMW Support back to its ORIGINAL STATE
-- Get the ARRAY of ORIGINAL MDS SCTNS etc... that existed when the FORM was initialised for the current MDS Support
    !mdssctns = !form.backup.mdssctns

  elseif  (!mode.upcase().eq('DIMENSION')) then
-- The MDS FRMW STRU TEMPLATE SIZE has been Changed, so USE the current "!form.support.mdssctnsstore" data
    !mdssctns =  !form.support.mdssctnsstore

  endif

-- Loop thro the MDS SCTNS ARRAY of MDSSCTN OBJECTS on the MDS Support and ONLY RESTORE those with a GTYP of CATREF set to 'ANG'
  do !sctn indices !mdssctns
    !sctnname   = !mdssctns[!sctn].name

-- Navigate by SCTN name as on MDS STRU regeneration the SCTNS are DELETED and RECREATED from NEW
    !!ce = $!sctnname

-- ONLY Process MDS SCTN elements where the GTYP of CATREF is set to 'ANG' -- Otherwise SKIP... --
    skip if !!ce.catref.gtype.neq('ANG')

-- Loop thro the MDS SNIPES(FITTINGS) ARRAY of MDSFITTING OBJECTS belonging to the MDS SCTN and ONLY
-- RESTORE/CREATE the SNIPES where the PURPOSE is set to 'XGUI'
    !sctnsnipes = !mdssctns[!sctn].snipes
    do !fitt indices !sctnsnipes

-- ONLY Process MDS SNIPE/FITTING elements where the PURPOSE is set to 'XGUI' -- Otherwise SKIP... --
      skip if !sctnsnipes[!fitt].purpose.neq('XGUI')
      !fittname = !sctnsnipes[!fitt].fittingname

-- Determine SCTN location of SNIPE, whether at the START or END
      if (!fittname.matchwild('*/Snipe-Start*')) then
        !endsctn  = 'START'
        !endframe = 1
      elseif (!fittname.matchwild('*/Snipe-End*')) then
        !endsctn  ='END'
        !endframe = 2
      endif

-- Determine SCTN location of SNIPE, which PLINE, TOP('RTTA') or LEFT('LBOA')
      !legpline = !sctnsnipes[!fitt].posline
      if (!legpline.eq('RTTA')) then
        !legsctn  = 'TOP'
        !legframe = 1
      elseif (!legpline.eq('LBOA')) then
        !legsctn  = 'LEFT'
        !legframe = 2
      endif

-- Initialise the MDSSNIPE <FORM> in the background, for the current SNIPE MDSFITTING OBJECT on the current MDS SCTN element
      !!ce = $!sctnname
      !!mdssnipe.init()

-- RESTORE the SNIPE by "Back Filling" the necessary MDSSNIPE <FORM> gadgets with the current SNIPE MDSFITTING OBJECT data etc...
      !!mdssnipe.endframe.val = !endframe
      !!mdssnipe.update(TRUE)
      !!mdssnipe.legframe.val = !legframe
      !!mdssnipe.update(TRUE)
      !!mdssnipe.len.val = !sctnsnipes[!fitt].despars[1]
      !!mdssnipe.hei.val = !sctnsnipes[!fitt].despars[2]

-- Recreate the MDS SNIPE/FITTING
      !!mdssnipe.create()

-- DELETE MDS SNIPE if it is NOT NAMED
      if (!!mdssnipe.current.snipe.name.match('/').neq(1)) then
        !!mdssnipe.deletefitt()
      endif

-- Remove all SNIPE AID lines and texts etc...
      !!mdssnipe.dismiss()

    enddo
  enddo

endfunction
