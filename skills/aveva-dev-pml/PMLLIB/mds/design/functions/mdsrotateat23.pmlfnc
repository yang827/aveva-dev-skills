--
-- File:		Mdsrotateat23.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Wed Oct 29
--
--
-- Description:
-- function to rotate general ancillary type at23 (Vertical pipes only)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsRotateat23()

  -- Initialise variables
    !Support = !!Mdsat23.Support
    !Angle   = !!MdsRotan.Angle.val.real()

  -- Check that Datum atta has been created
    if (!Support.Datum.set().not())then
      !!Alert.message('Datum support atta has not been created')
      return
    endif
    !!MdsDacControl(true)
  -- Rotate all attas
    do !V values !Support.Atta
      !!CE = !V
      ROTATE THROUGH CE ABOUT PL BY $!Angle
--<wd>may2003
-- Update the STEX to contain the ORIENTATION to be output on the Isometric Drawing
      skip if (!v.name.match('/SREF').gt(0))
      !!mdstransport(!v,!v.name)
--<wd>may2003
--<wd>mar2003
-- Rotate the Associated SHOE/PAD if the :MDSSREF is set and it is valid
      if (!!ce.:mdssref.badref().not()) then
        !!ce = !!ce.:mdssref
        rotate through ce about pl by $!angle


--<wd>22jun2004
-- For AT65 ONLY
-- Determine the ANGLE of PPOINT P10 ** FROM **:-
-- (a) -- the UP Direction for Horizontal Pipes  i.e. The default of 90 degrees is ALWAYS a default direction of WEST
-- (b) -- the NORTH Direction for Vertical Pipes i.e. The default of 90 degrees is ALWAYS a default direction of WEST
        !!ce = !v
        pin 1 at p0
        if (!!ce.prop.desc inset ('AT65')) then
          !ldir = !!ce.ldir.wrt(/* )
          if ((!ldir.up.eq(1)) or (!ldir.up.eq(-1))) then
-- Vertical Pipe
            pin 1 dir NORTH
          else
-- Horizontal Pipe
            pin 1 dir UP
          endif
          pin 1 dist ( param 2 / 2 )
          var !pin1str pin1 dir
          !pin1dir = !pin1str.direction()
          !p10dir  = !!ce.pdir[10]
          !xangle  = !pin1dir.angle(!p10dir)
-- Check if P10 Direction is WEST(East -xxx) or EAST(East xxx) and Set DESPAR NUM 7
          if (!p10dir.east.lt(0)) then
-- P10 direction is ON the WEST Side of UP or NORTH
            !!ce.desp[7] = !xangle
          else
-- P10 direction is ON the EAST Side of UP or NORTH
            !xangle      = 180 - !xangle
            if (!xangle.eq(180)) then
              !xangle = 0
            endif
            !!ce.desp[7] = !xangle
          endif
        endif
--<wd>22jun2004


--<wd>may2003
-- Update the STEX to contain the ORIENTATION to be output on the Isometric Drawing
        !!mdstransport(!!ce,!!ce.name)
--<wd>may2003
     endif
     !!CE = !V
--<wd>mar2003
    enddo

  -- Update Support Data
    !!CE = !Support.Datum
    !Support.PADir  = Pa Dir wrt world
    !Support.PLDir  = Pl Dir wrt world
    !Support.P9Dir  = P9 Dir wrt world
    -- !Support.P10Dir = P10 Dir wrt world
    -- !Support.P11Dir = P11 Dir wrt world
    !OldDeg = !Support.Rotated
    !NewDeg = !OldDeg + !Angle
    if (!NewDeg geq 360)then
      !NewDeg = !NewDeg - 360
    endif
    !Support.Rotated = !NewDeg

    !!Mdsat23.Support = !Support

-- Update Graphical Aid Text
    !!Mdsaidtext(!!Mdsat23)

-- If the shoe has a :MDsGuideref make sure it rotates withit
   if !!CE.:MDSGuideRef.badref().Not() then
     goto :MDSGuideRef
     ROTATE THROUGH CE ABOUT PL BY $!Angle
--<wd>may2003
-- Update the STEX to contain the ORIENTATION to be output on the Isometric Drawing
     !!mdstransport(!!ce,!!ce.name)
--<wd>may2003
   endif

   !!MdsDacControl(false)
-- End function
endfunction

-- End of file Mdsrotateat23.pml
