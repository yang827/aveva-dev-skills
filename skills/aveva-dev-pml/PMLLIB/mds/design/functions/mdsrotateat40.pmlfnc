--
-- File:		MdsrotateAt40.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		5th February 2003
--
--
-- Description:
-- function to rotate general ancillary type AT40
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsRotateAt40()

  -- Initialise variables
    !Support = !!MdsAt40.Support
    !Angle   = !!MdsRotan.Angle.val.real()

  -- Check that Datum atta has been created
    if (!Support.Datum.set().not())then
      !!Alert.message('Datum support atta has not been created')
      return
    endif
    !!MdsDacControl(true)
  -- Rotate all attas
    do !V values !Support.Atta
      !!CE = !V
      ROTATE THROUGH CE ABOUT PL BY $!Angle
--<wd>may2003
-- Update the STEX to contain the ORIENTATION to be output on the Isometric Drawing
      skip if (!v.name.match('/SREF').gt(0))
      !!mdstransport(!v,!v.name)
--<wd>may2003
    enddo

  -- Update Support Data
    !!CE = !Support.Datum
    !Support.PADir  = Pa Dir wrt world
    !Support.PLDir  = Pl Dir wrt world
    !Support.P9Dir  = P9 Dir wrt world
    -- !Support.P10Dir = P10 Dir wrt world
    -- !Support.P11Dir = P11 Dir wrt world
    !OldDeg = !Support.Rotated
    !NewDeg = !OldDeg + !Angle
    if (!NewDeg geq 360)then
      !NewDeg = !NewDeg - 360
    endif
    !Support.Rotated = !NewDeg

    !!MdsAt40.Support = !Support

-- Update Graphical Aid Text
    !!Mdsaidtext(!!MdsAt40)

-- If the shoe has a :MDsGuideref make sure it rotates with it
   if !!CE.:MDSGuideRef.badref().Not() then
     goto :MDSGuideRef
     ROTATE THROUGH CE ABOUT PL BY $!Angle
--<wd>may2003
-- Update the STEX to contain the ORIENTATION to be output on the Isometric Drawing
      !!mdstransport(!!ce,!!ce.name)
--<wd>may2003
   endif

   !!MdsDacControl(false)
-- End function
endfunction

-- End of file MdsrotateAt40.pml
