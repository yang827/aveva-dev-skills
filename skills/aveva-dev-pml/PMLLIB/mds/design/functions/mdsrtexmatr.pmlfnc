--------------------------------------------------------------------------------
--  Define Function mdsrtexmatr.pmlfnc
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Define Function
--------------------------------------------------------------------------------
define function !!mdsrtexmatr()

  !!ce = /MDS-SDTE
  handle any
    !!alert.error('SECT /MDS-SDTE does NOT exist in this PROJECT')
    return
  elsehandle none
    var !coll coll all SDTE for ce
  endhandle

  -- Modify RTEX of the REQUIRED SDTE for Outputting Material in the ISO MTO
  !sdte = ARRAY()
  do !val values !coll
    !!ce = $!val
    if (!!ce.owner.name.matchwild('/MDS-SDTE-AC*')) then
      !sdte.append(!!ce)
    elseif (!!ce.owner.name.matchwild('/MDS-SDTE-AN*')) then
      !sdte.append(!!ce)
    elseif (!!ce.owner.name.matchwild('/MDS-SDTE-AT*')) then
      !sdte.append(!!ce)
    elseif (!!ce.owner.name.matchwild('/MDS-SDTE-BT*')) then
      !sdte.append(!!ce)
    elseif (!!ce.owner.name.matchwild('/MDS-SDTE-GT*')) then
      !sdte.append(!!ce)
    elseif (!!ce.owner.name.matchwild('/MDS-SDTE-LT*')) then
      !sdte.append(!!ce)
    elseif (!!ce.owner.name.matchwild('/MDS-SDTE-ST*')) then
      !sdte.append(!!ce)
    elseif (!!ce.owner.name.matchwild('/MDS-SDTE-SU*')) then
      !sdte.append(!!ce)
    else
      -- All other SDTE Output their Material Either on the MDS ABA Drawings
      -- or the PIPE section of the ISO MTO for Trunnions
      skip
    endif
  enddo

  alpha log /c:/temp/pdmsuser/MDSRTEXmods.pmldat
  handle any
    alpha log /c:/temp/pdmsuser/MDSRTEXmods.pmldat over
  endhandle

  -- RESet the RTEX of Valid SDTEs
  do !txt indices !sdte
    !!ce  = !sdte[!txt]
    -- $P **********----------------------------------------------------------------
    -- $P **********----------------------------------------------------------------
    -- $P ** BEFORE **
    -- q name type rtex
    --!rtex = !!ce.rtex.substring(-2)
    --if (!!ce.rtex.matchwild('!!cODE*')) then
    --  !rtex = !!ce.rtex.after('(').before(')')
    --else
    !rtex = !!ce.rtex.after('(').before(')')
    !ntex = |( | & !rtex & |' '| & | + | & |PROP MATR| & | )|
    !!ce.rtex = !ntex
    handle any
      !!alert.error(!!error.text)
      -- $P ---------------------------
      -- $P ** ERROR **
      -- q name type rtex
    endhandle
    --endif
    -- $P ---------------------------
    -- $P ** AFTER **
    -- q name type rtex
    -- $P ---------------------------
    -- $P ---------------------------
  enddo

  alpha log end
endfunction
