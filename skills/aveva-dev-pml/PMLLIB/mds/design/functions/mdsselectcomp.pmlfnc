--
-- File:    mdsselectcomp.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.Morris
-- Created: Wednesday 5th June
--
--
-- Description:
-- Tries to scan the current specification for an elbow with a p3 connection
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsselectcomp(!type is STRING) is BOOLEAN

  -- Activate MDS DAC global variable

  !!mdsDacControl(true)

  !found = false
  !savedSpref = Spref
  if !type.eq('CROS') and !!ce.type.eq('TEE') then
    !p3bor = p3 bore
    :MDSCp1 '$!savedSpref'
    -- Extract claim of branch error
    handle (2,605)
      !ce = !!ce
      bran
      extract claim ce
      handle (43,383)
          --this is not an extract just claim ce
          claim ce
          handle ANY
            !!alert.error('$!!error.text')
            !claimErrors = TRUE
          endhandle
        elsehandle ANY
        !!alert.error(!!error.text)
        return FALSE
      elsehandle NONE
        claim ce
        handle ANY
          !!alert.error(!!error.text)
          return FALSE
        endhandle
      endhandle
      !!ce = !ce
    endhandle
  endif

  -- ELBO/BEND

  if !type.eq('ELBO') or !type.eq('BEND') then

    -- Scan database for correct elbo/bend
    -- Test1 = P3 exists
    -- Test2 = P1 and P3 in the same place
    -- Test3 = P1 and P3 in opposite directions
    -- Test4 = P1 and P3 with the same bore

    -- First check to see if the current elbow is OK

    if !!ce.ppls.find(3).size().gt(0) then
      if !!ce.ppos[1].eq(!!ce.ppos[3]) then
        if !!ce.pdir[1].opposite().eq(!!ce.pdir[3]) then
          if !!ce.ppbor[1].eq(!!ce.ppbor[3]) then
            !!mdsDacControl(false)
            return true
          endif
        endif
      endif
    endif

    !choice = select
    do !select values !choice
      spref $!select
      -- Extract claim of branch error
      handle (2,605)
        !ce = !!ce
        bran
        extract claim ce
        handle (43,383)
          --this is not an extract just claim ce
          claim ce
          handle ANY
            !!alert.error('$!!error.text')
            !claimErrors = TRUE
          endhandle
        elsehandle ANY
          !!alert.error(!!error.text)
          return FALSE
        elsehandle NONE
          claim ce
          handle ANY
            !!alert.error(!!error.text)
            return FALSE
          endhandle
        endhandle
        !!ce = !ce
      endhandle

      -- Test1
      if !!ce.ppls.find(3).size().eq(0) then
        skip
      endif
      -- Test2
      if !!ce.ppos[1].neq(!!ce.ppos[3]) then
        skip
      endif
      -- Test3
      if !!ce.pdir[1].opposite().neq(!!ce.pdir[3]) then
        skip
      endif
      -- Test4
      if !!ce.ppbor[1].neq(!!ce.ppbor[3]) then
        skip
      endif
      !found = true

      --<dw>mar2009 dun1119 reconnect to allow for substitution of elbows with varying default orientation
      forward
      thro ce
      --><wd>23sep2009 - DFN P-22636 (SI-9969) Added FIX for an OPEN ENDED PIPE TAIL
      --dir tow nex
      handle NONE
        dir tow nex
      elsehandle ANY
        thro pt
        dir to pt
      endhandle
      --<<wd>23sep2009 - DFN P-22636 (SI-9969) Added FIX for an OPEN ENDED PIPE TAIL
      --<dw>mar2009 dun1119 End of reconnect to allow for substitution of elbows.
      break
    enddo

    if !found.not() then
      spref $!savedSpref
      !!mdsDacControl(false)
      return false
    else
      !!mdsDacControl(false)
      return true
    endif

    -- TEE

  elseif !type.eq('TEE') then

    -- Scan database for correct tee
    -- Test1 = Skey is TESO
    -- Test2 = P3 is same bore as P1
    -- Test3 = P1 and P3 in the same place

    -- First check to see if the current elbow is OK

    if !!ce.spref.badref().not() then
      if !!ce.detref.skey.eq('TESO') then
        if !!ce.ppbor[1].eq(!!ce.ppbor[3]) then
          if !!ce.ppos[1].eq(!!ce.ppos[3]) then
            !!mdsDacControl(false)
            return true
          endif
        endif
      endif
    endif

    !choice = select
    do !select values !choice
      spref $!select
      -- Test1
      if !!ce.detref.skey.neq('TESO') then
        skip
      endif
      -- Test2
      if !!ce.ppbor[1].neq(!!ce.ppbor[3]) then
        skip
      endif
      -- Test3
      if !!ce.ppos[1].neq(!!ce.ppos[3]) then
        skip
      endif
      !found = true
      break
    enddo

    if !found.not() then
      spref $!savedSpref
      !!mdsDacControl(false)
      return false
    else
      --<wd>23oct2007 -- HPD0036504
      -- Always SET the SHOP FLAG to TRUE for a SET-ON type TEE for a MDS TRUNNION connection with the skey set to TESO
      shop TRUE
      --<wd>23oct2007 -- HPD0036504
      !!mdsDacControl(false)
      return true
    endif

    -- REDU

  elseif !type.eq('REDU') then

    -- Scan database for correct redu
    -- Test1 = P2 and P3 is identical bore
    -- Test2 = P3 and P2 are on the same level
    -- Test3 = It has to be eccentric with skey 'OTBW' or 'OTSW' or 'OTFL' etc...
    -- Test4 = Check to see if the bores match the original bores

    !arr = Arr
    !lea = Lea

    -- First check to see if the current reducer is OK

    if !!ce.spref.badref().not() then
      if !!ce.ppls.findfirst(3).gt(0) then
        if !!ce.ppbor[2].eq(!!ce.ppbor[3]) then
          if !!ce.ppos[1].eq(!!ce.ppos[3]) then
            !!mdsDacControl(false)
            return true
          endif
        endif
      endif
    endif

    !origPABore = !!ce.ppbor[$!arr]
    !origPLBore = !!ce.ppbor[$!lea]

    !choice = select
    do !select values !choice
      spref $!select
      if !!ce.ppls.findfirst(3).unset() then
        skip
      endif
      -- Test1
      if !!ce.ppbor[2].neq(!!ce.ppbor[3]) then
        skip
      endif
      -- Test2
      pin 9 copy p3
      if !!ce.arr.eq(1) then
        pin 8 copy pl
      else
        pin 8 copy pa
      endif
      pin 8 dir from pin 9 to pin 8
      var !pin9dir const dir pin 9 to pin 8

      if !!ce.arr.eq(1) then
        var !pldir pl dir
      else
        var !pldir pa dir
      endif
      if !pin9dir.neq(!pldir) then
        skip
      endif
      -- Test3
      if !!ce.detref.skey.match('OT').lt(1) then
        skip
      endif
      -- Test4
      !newPABore = !!ce.ppbor[$!arr]
      !newPLBore = !!ce.ppbor[$!lea]
      if !newPABore.eq(!origPABore) and !newPLBore.eq(!origPLBore) then
      else
        skip
      endif
      !found = true
      break
    enddo
    !!mdsResetPins(8,9)
    if !found.not() then
      spref $!savedSpref
      !!mdsDacControl(false)
      return false
    else
      !!mdsDacControl(false)
      return true
    endif

    -- CROS

  elseif !type.eq('CROS') then

    -- Scan database for correct tee/cross
    -- Test1 = P4 must exist
    -- Test2 = P4 in same place as p0
    -- Test3 = P4 must be down

    -- First check to see if the current cros is OK

    if !!ce.type.eq('CROS') then
      if !!ce.spref.badref().not() then
        if !!ce.ppls.find(4).size().eq(1) then
          if !!ce.ppos[0].eq(!!ce.ppos[4]) then
            if !!ce.pdir[4].string().match('D WRT').eq(1) or !!ce.pdir[4].string().match('-Z WRT').eq(1) then
              !!mdsDacControl(false)
              return true
            endif
          endif
        endif
      endif
    endif

    -- If the passed item is a tee then try to replace it with an appropriate cros

    !cross = object DBREF()
    !tee = !!ce
    --$P*********EXISTING TEE element****************************
    --q name spref choice

    if !!ce.type.eq('TEE') then
      --      new cros copy att of prev tee

      --$P*************************************
      --><wd>12oct2009 - DFN P-25091 (SI-14584) Check for ALL relevant MDS TRUNNION TYPES i.e. 'TT36', 'TT42','TT43' and 'TT44'
      prev
      handle ANY
        head
      endhandle
      new cros copy att of $!tee
      --><wd>12oct2009 - DFN P-25091 (SI-14584) Check for ALL relevant MDS TRUNNION TYPES i.e. 'TT36', 'TT42','TT43' and 'TT44'
      --$P*************************************

      !cross = !!ce
    endif

    --$P *************   !choice = select with pbor3 $!p3bor  ******************
    !choice = select with pbor3 $!p3bor
    handle any
      if !cross.badref().not() then
        delete cros
      endif
      !!mdsDacControl(false)
      return false
    endhandle

    do !select values !choice
      spref $!select
      --$P*************************************
      --><wd>12oct2009 - DFN P-25091 (SI-14584) Check for ALL relevant MDS TRUNNION TYPES i.e. 'TT36', 'TT42','TT43' and 'TT44'

      --      !arrivePpoint = arr of prev
      !arrivePpoint = arr of $!tee

      --      !leavePpoint = lea of prev
      !leavePpoint = lea of $!tee
      --><wd>12oct2009 - DFN P-25091 (SI-14584) Check for ALL relevant MDS TRUNNION TYPES i.e. 'TT36', 'TT42','TT43' and 'TT44'
      --$P*************************************

      arr $!arrivePpoint
      lea $!leavePpoint

      --$P*************************************
      --><wd>12oct2009 - DFN P-25091 (SI-14584) Check for ALL relevant MDS TRUNNION TYPES i.e. 'TT36', 'TT42','TT43' and 'TT44'
      --      ori and p3 is p3 of prev
      ori and p3 is p3 of $!tee
      handle ANY
        --        ori pa is pa of prev and pl is pl of prev
        ori pa is pa of $!tee and pl is pl of $!tee
      endhandle
      --><wd>12oct2009 - DFN P-25091 (SI-14584) Check for ALL relevant MDS TRUNNION TYPES i.e. 'TT36', 'TT42','TT43' and 'TT44'
      --$P*************************************

      -- Test1
      if !!ce.ppls.find(4).size().neq(1) then
        skip
      endif
      -- Test2
      if !!ce.ppos[0].neq(!!ce.ppos[4]) then
        skip
      endif
      -- Test3
      if !!ce.pdir[4].string().match('D WRT').neq(1) or !!ce.pdir[4].string().match('-Z WRT').neq(1) then

        --<wd>03jun2004 -- Check GLOBAL Variable for Trunnion Type 'TT36'
        --><wd>12oct2009 - DFN P-25091 (SI-14584) Check for ALL relevant MDS TRUNNION TYPES i.e. 'TT36', 'TT42','TT43' and 'TT44'
        --skip
        if (defined(!!tt36TrunCros)) then
          --          if (not !!tt36TrunCros inset ('TT36')) then
          if (not !!tt36TrunCros inset ('TT36', 'TT42','TT43', 'TT44')) then
            --<<wd>12oct2009 - DFN P-25091 (SI-14584) Check for ALL relevant MDS TRUNNION TYPES
            skip
          endif
        endif
        --<wd>03jun2004

      endif
      !found = true
      --$P*********NEW CROS element****************************
      --q name spref choice
      break
    enddo

    -- Use the six rule to determine the connection point the cref is connecting to
    -- 6 - Arrive 1 Leave 2 = P3
    -- 6 - Arrive 2 Leave 1 = P3
    -- 6 - Arrive 3 Leave 1 = P2
    -- 6 - Arrive 1 Leave 3 = P2
    -- 6 - Arrive 3 Leave 2 = P1
    -- 6 - Arrive 2 Leave 3 = P1

    !arrivePoint = arr
    !leavePoint  = lea
    !connectedPoint = 6 - !arrivePoint - !leavePoint
    -- goto cref of tee
    !!ce = !tee
    if !!ce.cref.badref().not() then
      goto cref
      -- Work out which end of the bran is connected
      !href = href
      !tref = tref
      if !href.eq(!tee) then
        !hcon = hcon
        conn ph to p$!connectedPoint of $!cross
        hcon $!hcon
      elseif !tref.eq(!tee) then
        !tcon = tcon
        conn pt to p$!connectedPoint of $!cross
        Tcon $!tcon
      endif
      !!ce = !cross
    endif

    if !found.not() then
      if !cross.badref().not() then
        !!ce = !cross
        delete cros
      endif
      !!ce = !tee
      spref $!savedSpref
      !!mdsDacControl(false)
      return FALSE
    else
      if !cross.badref().not() then
        !!ce = !tee
        delete tee
        !!ce = !cross
      else
      endif
      !!mdsDacControl(false)
      return true
    endif

  endif

endfunction
