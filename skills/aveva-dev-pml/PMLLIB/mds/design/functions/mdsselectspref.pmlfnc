--
--
--  Description:    Function to emulate SELECT commad
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--    1   R      STRING		       item type to be selected from spec
--    2   R      BORE                  item bore
--    3   R      STRING                styp
--    4   R      DBREF                 specification to be selected from
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsSelectSpref(!type is STRING,!pbor is BORE,!styp is STRING,!spec is DBREF) is ARRAY

  !selection = ARRAY()

  do !sele values !spec.memb
    if !sele.tansw.eq('ATTA') then
      !typeRoot = !sele
      break
    endif
  enddo

  if undefined(!typeRoot) then
    return !selection
  endif

  do !sele values !typeRoot.memb
    if !sele.answ.eq(!pbor) then
      !boreRoot = !sele
      break
    endif
  enddo

  if undefined(!boreRoot) then
    return !selection
  endif

  if !styp.unset() then
    !command = '!boreRoot.memb'
  else
    if !styp.trim().empty() then
      !command = '!boreRoot.memb'
    else
      !command = '!!kcollectAllFor(''SPCO'',''styp eq ''''$!styp'''''',!boreRoot)'
    endif
  endif

  !selection = !command.block().evaluate()

  return !selection

endfunction
