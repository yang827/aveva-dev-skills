--
-- File:    mdssetdatat23.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N.morris
-- Created:   Tue Oct 28
--
--
--

-- Description:
-- Creation function for general ancillary at23
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatat23()

  -- Find current units and set the distance unit to metric

  !currentunits = !!kGetSetUnits()

  -- Initialise variables
  !tubeType = !!mdsOptions.pipes
  !datum    = !!mdsAT23.support.datum
  !name     = !!mdsAT23.name.val
  !alias    = !!mdsAT23.support.alias
  !!mdsAT23.bedplate.active = true
  !fromAtta = !!mdsAT23.support.preliminaryStore.set()
  if (!fromAtta) then
    !pre = object DBREF('/' & !name & '_Pre')
  endif
  !replace  = !!mdsAT23.support.replace

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Set Pipe Creation Type, 'SHOE' for Insulated and 'PIPE' for UNINSULATED Pipe
  !insutype = !!mdsAT23.type.selection()

  --------------------------------------------------------------------------------------------
  --------------------------------------------------------------------------------------------
  --------------------------------------------------------------------------------------------
  -- Either -(1) Identify Pipe SHOE if Pipe is INSULATED i.e. !insutype = 'SHOE'
  if (!insutype.eq('SHOE')) then
    !id = 'Pipe Shoe'

    label /atta

    -- Identify shoe from preliminary support
    -- <sk> 22/06/2012
    if (defined (!!mdsAutoTubePicker) AND !!mdsAutoTubePicker.enabled()) then

      -- return if limit of pick tries exceeded
      if (!!mdsAutoTubePicker.allowedPicks.eq(0)) then
        !!mdsAutoTubePicker.cancel()
        return FALSE
      endif

      -- number of .allowedPicks is decreased here
      !picked = !!mdsAutoTubePicker.pick('ATTA', '')
      if unset(!picked) then
        !!alert.warning ('There is no pipe shoe next to preliminary support.')
        !!mdsAutoTubePicker.cancel()
        !!kRestoreUnits(!currentunits)
        return false
      else
        !!ce = !picked
      endif

    else

      prompt off
      prompt load escape |Identify $!id|
      id atta @
      handle (61,528)
        prompt on
        !!kRestoreUnits(!currentunits)
        return
      endhandle
      prompt dismiss
      prompt on

    endif

    -- Identified Component
    !atta = !!ce
    -- Check if a DATUM or SREF Atta
    if (!atta.name.match('/DATUM').gt(1)) then
      -- DATUM ATTA of a MDS FRAMEWORK Support Identified
      !datumnam = !atta.name
      !srefname = !atta.name.replace('/DATUM','/SREF')
      !srefatta = !srefname.dbref()
      !srefsele = true
    elseif (!atta.name.match('/SREF').gt(1)) then
      -- SREF ATTA of a MDS FRAMEWORK Support Identified
      !srefname = !atta.name
      !srefatta = !atta.name.dbref()
      !srefsele = true
      !datumnam = !atta.name.replace('/SREF','/DATUM')
      !atta = !datumnam.dbref()
    else
      -- Independent MDS Pipe Support Atta Selected
      !datumnam = !atta.name
      !srefsele = false
    endif

    --<wd>mar2006<mds12>
    -- Check that the Selected SHOE ATTA is a VALID WELDED MDS Standard Shoe - <CLAMP ON SHOES are NOT VALID>
    if (!atta.stype inset ('AT01', 'AT02', 'AT12', 'AT13','AT14', 'AT15', 'AT18', 'AT19', 'AT96')) then
      -- Valid Shoe Atta has been Selected
    else
      !!alert.error('Selected Support is NOT a valid "WELDED" MDS PIPE SHOE Support Atta.')
      golabel /atta
    endif
    --<wd>mar2006<mds12>


    -- Is it a Pipe SHOE or the SREF Atta of a DATUM Atta which is Pipe SHOE
    if (!atta.catref.owner.:MdsType.neq('SHOE')) then
      !!alert.error('Identified element is not a Pipe SHOE')
      golabel /atta
    else
      -- Is the Identified Pipe SHOE UNINSULATED
      if  !!ce.inth.unset().or(!!ce.inth.eq(0)) then
        if(!!alert.confirm('Identified SHOE is on an UNINSULATED Pipe. Do you want to continue?').eq('NO')) then
          golabel /atta
        endif
      endif
    endif
    --------------------------------------------------------------------------------------------

    -- Or -(2) Identify PIPE if PIPE is UNINSULATED i.e. !insutype = 'PIPE'
  elseif (!insutype.eq('PIPE')) then

    if (!tubeType eq 'FTUB')then
      !pipeType = 'lined section'
    else
      !pipeType = 'tube'
    endif
    !idtype = 'pipe'
    !purp = 'PIPE'

    label /again
    if (!!mdsidtube(!tubeType, 'identify $!pipeType of $!idtype',!purp).not())then
      !!kRestoreUnits(!currentunits)
      return
    endif

    -- Is the Identified Pipe UNINSULATED
    if  !!ce.inth.unset().or(!!ce.inth.eq(0)).not() then
      !!alert.error('Identified Pipe has INSULATION')
      golabel /again


    endif

    -- ALWAYS Set the Variable !srefsele to FALSE for This OPTION
    !srefsele = false

  endif

  forwards
  !where = ''

  -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
  -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.
  !currcomp = !!ce
  if (!!ce.type eq 'BRAN') then
    !hdir = hdir wrt /*
  else
    !hdir = pl dir wrt /*
  endif

  if (!hdir neq U and !hdir neq D ) then
    if (!!mdsgradient(!currcomp)) then
      !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
      !!ce = !cecomp
      !!kRestoreUnits(!currentunits)
      if (!fromAtta) then
        -- cancel autopicker and restore preliminary
        !!mdsAutoTubePicker.cancel()
      endif
      return
    endif
  endif

  -- Select ancillary
  if(!!kGetBoreUnits()) then
    UNITS INCH BORE
  endif

  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  -- Create the AT23 Atta after the SREF ATTA of a MDS FRamework Support Pipe SHOE
  if (!srefsele) then
    if (!fromAtta) then
      -- make sure preliminary is after selected one
      $!pre.owner
      REORDER $!pre AFTER $!srefatta
      handle any
      endhandle
    endif
    !!ce = !srefatta
  endif

  !currentunits = !!kGetSetUnits()

  -- Raised MDS Access for HPD0027265
  !!mdsDacControl(true)

  -- <sk> 04/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsAT23.support.datum = !!ce
    -- Set distance gadget
    !!mdsDistance(!!mdsAT23)
  else
    new atta $!where
  endif
  -- <sk> 04/06/2012

  spkbrk true
  --    $P SELECT SPEC /MDS WITH STYP '$!alias'
  !choice = SELECT SPEC /MDS WITH STYP '$!alias'
  handle any
    !projStandard = !!mdsAT23.support.replace
    !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT23, true)
      return
    endif
    delete atta
    !!kRestoreUnits(!currentunits)
    return
  elsehandle NONE

    ---------------------------------------------------------------------------------------------------------------
    -- mjb >>> 09.03.06 <mds12>

    -- The element may exist in the specification but the project may not contain the size in the parameters file
    --if undefined(!!mdspar$!alias[$!bore]) then

    -- Set the MDS ATTA SPREF & Check the MDS DEFAULTS CATALOGUE DESPARS Data is OK
    units mm bore
    spref $!choice[1]
    !rpad = !!ce
    !lbor = !rpad.lbor.real().value()
    !mds12test = !!mdssetdespars(!rpad)
    if (!mds12test.not()) then
      -- mjb <<< end of mod
      ---------------------------------------------------------------------------------------------------------------


      !projStandard = !!mdsAT23.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      !!kRestoreUnits(!currentunits)
      -- <sk> 04/06/2012
      if !fromAtta then
        !!mdsRestorePre(!!mdsAT23, true)
        return
      endif
      delete atta
      return
    endif
  endhandle

  !!mdsDacControl(true)

  -- Check Pipe Insulation Thickness is within the limits of the Selected ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.insu()' will return 'TRUE' and skip the code shown below

  ---------------------------------------------------------------------------------------------------------------
  -- mjb >>> 09.03.06 <mds12>

  --!check = object MDSCHECKSTD()

  !mdsattaobj  = object MDSREADPARSDATA()
  !mdsattadefs = !mdsattaobj.mdsdefsdata(!rpad.stype,!lbor)
  if (!mdsattadefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentunits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT23, true)
      return
    endif
    delete atta
    !!mdsDacControl(FALSE)
    return
  endif
  !check = object MDSCHECKSTD(!mdsattaobj)
  --!!ce   = !rpad

  -- mjb <<< end of mod
  ---------------------------------------------------------------------------------------------------------------

  !min = STRING()
  !max = STRING()
  !materror = STRING()

  if (!check.material(!materror).not()) then
    !!alert.error (!materror)
    !!kRestoreUnits(!currentunits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT23, true)
      return
    endif
    delete atta
    return
  endif

  if (!check.insu(!alias,!min,!max).not()) then
    !!mdsInsulationError(!currentunits, !min, !max, !replace)
    !!kRestoreUnits(!currentunits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT23, true)
      return
    endif
    delete atta
    return
  endif

  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT 'Mdscheckstd.temp()' will return 'TRUE' and skip the code shown below

  !tmin = STRING()
  !tmax = STRING()
  if (!check.temp(!alias,!tmin,!tmax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tmin / $!tmax)')
    !!kRestoreUnits(!currentunits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT23, true)
      return
    endif
    delete atta
    return
  endif

  -- Test if the ancillary is available at this elevation

  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedElevation = !position.up
    !minimumElevation = !mdsattaobj.elevation
    !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedElevation Minimum elevation $!minimumElevation')
    !!kRestoreUnits(!currentunits)
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT23, true)
      return
    endif
    delete atta
    return
  endif

  -- <sk> 06/07/2012 Check user criteria
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentunits)
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT23, true)
      return
    endif
    delete atta
    return
  endif
  -- <sk> 06/07/2012

  -- Set the ATTA material
  !!mdssetmatref(!!ce)

  -- Activate DAC Control ON
  !!mdsDacControl(true)

  --<wd>28jun2004 - Set the .datum Support member
  !!mdsAT23.support.datum  = !!ce

  ----------------------------------------------------------------------------------------------
  ----------------------------------------------------------------------------------------------
  --<wd>dec2002
  --  When !insutype is equal to 'SHOE' and the Cradle Pad default Design Parameters have already been set
  !form   = !!mdsAT23
  !at23ce = !!ce
  if (!insutype.eq('SHOE')) then
    -- Navigate to the Shoe/Datum Atta to Check and Adjust the Height of the Identified Shoe
    !!ce = !atta
    !shoewarning = STRING()
    -- Cradle Pad Atta Length and Shoe Atta Height are always MODIFIED in the <!checkshoeheight(w,x,y,z) method> below
    -- Issue a Warning if SHOE Height and/or the PAD Length is NOT within the MDS Standards Permissible Height/Length Range
    if (!check.shoeheight(!form,!atta,!at23ce,!shoewarning).not()) then
      !!alert.warning(!shoewarning)
    endif
    -- Set the Cross Reference Attribute :mdssref at Both Attas
    !atta.:mdssref   = !at23ce
    !at23ce.:mdssref = !atta
  else
    -- When !insutype.eq('PIPE') reset OLAP DESPAR num <?> to be ZERO
    --<wd>feb2003
    --      !at23ce.desp[6] = 0
    !olapnum = !!mdsgetdesp('OLAP')
    if (!olapnum.neq(0)) then
      !at23ce.desp[!olapnum] = 0
    endif
    --<wd>feb2003
  endif
  !!ce = !at23ce
  --<wd>dec2002
  ----------------------------------------------------------------------------------------------
  ----------------------------------------------------------------------------------------------

  -- Name support
  Name /$!name
  :MDSSuppType |$!!mdsAT23.support.type|
  !!ce.:mdscp3 = !!mdsAT23.type.selection()

  !!mdsSetIspe()

  --  Add stex for isometrics
  -- set stex for atta
  !sAtta = !!ce
  Call !!mdsTransport(!sAtta,!name)

  -- Select the MDS ATTA LSTU and Automatically Set the MTOREF attribute of the MDS ATTA to the same LSTU
  !!mdsSelLstu(!!ce)

  --<wd>21jun2004 -- for type AT65 the Default MATERIAL is PIPE and not PLATE i.e.
  -- the Pipe Wrapper/Cradle default material for the MTOREF attribute is the same LSTU as the Parent Pipe
  !!mdsDacControl(true)
  !mtorefspec = spec of lstu
  !!mdsrpadmat.specs.select('rtext',!mtorefspec.name)
  --<wd>28jun2004 -- RPAD Material Form unpopulated so initialise the form
  handle ANY
    !!mdsrpadmat.init(!!mdsAT23)
    !!mdsrpadmat.specs.select('rtext',!mtorefspec.name)
  endhandle
  --<wd>28jun2004

  if (!!ce.prop.desc inset ('AT65')) then
    -- The Standard Default Angle is 90 degrees
    -- i.e Horizontal Pipes = 90 deg. WEST from the UP (Top) direction
    -- and   Vertical Pipes = 90 deg. WEST from the NORTH direction
    !!ce.desp[7] = 90
    -- For AT65 the default MATERAIL is the PARENT Pipe Material and is designated by the letter 'A'
    desp num 8 A
    -- For PARENT Pipe material there is NO THICKNESS required in the MDS property CODE
    !!ce.desp[9] = 0
  endif
  --<wd>21jun2004

  !!mdsDacControl(true)
  --POS AT PREV
  -- <sk> 04/06/2012
  -- do not modify POS and ORI in atta from preliminary
  if !fromAtta.not() then
    POS AT PL of PREV
    handle any
      pos at ph
    endhandle
    ori
  endif

  -- Always add atta to support object
  !!mdsAT23.support.atta.clear()
  !!mdsAT23.support.atta.append(!!ce)
  !!mdsAT23.support.datum  = !!ce
  !!mdsAT23.support.pADir  = Pa Dir wrt world
  !!mdsAT23.support.pLDir  = Pl Dir wrt world
  !!mdsAT23.support.p9Dir  = P9 Dir wrt world

  -- Add marker text
  !!mdsaidtext(!!mdsAT23)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsAT23.support.atta)

  -- Colour Support
  Call !!kEnhanceList(!colourList)

  -- When finished grey out datum gadget and reset height,length and setsteel
  !!mdsSetGadgets(!!mdsAT23,!!ce,!!mdsAT23.support.type)
  !!mdsAT23.datum.active = false
  --DeactivatePipe Creation Type radio group
  !!mdsAT23.type.active = false

  -- Reset Units
  !!kRestoreUnits(!currentunits)

  -- set focus to the distance text gadget
  !!mdsAT23.dist.setFocus()

  !!mdsDacControl(false)

  -- End function
endfunction
