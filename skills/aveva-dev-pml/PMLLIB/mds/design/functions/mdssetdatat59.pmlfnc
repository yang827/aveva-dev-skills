--
--   Author:    Wayne Dodwell
--   Created:   7th October 2003
--
--

-- Description:
-- Creation function for General Ancillary AT59
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatAT59()

  -- Find current units and set the distance unit to metric
  !currentunits = !!kGetSetUnits()

  -- Initialise variables
  --    !tubeType = !!mdsOptions.pipes
  !datum    = !!mdsAT59.support.datum
  !name     = !!mdsAT59.name.val
  !alias    = !!mdsAT59.support.alias
  !!mdsAT59.bedplate.active = TRUE
  !replace  = !!mdsAT59.support.replace
  !ceComp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- Set Pipe Creation Type to 'TRUNNION' for Trunnion with Base Plate
  !insuType = 'TRUNNION'

  ----------------------------------------------------------------------------------------------------
  ----------------------------------------------------------------------------------------------------
  ----------------------------------------------------------------------------------------------------

  -- Identify Trunnion Base Plate if Pipe is a TRUNNION Branch i.e. !insuType = 'TRUNNION'
  if (!insuType.eq('TRUNNION')) then
    !id = 'Trunnion Base Plate'

    label /trunnion

    prompt off
    prompt load escape |Identify $!id|
    id plat @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return
    endhandle
    prompt dismiss
    prompt on

    -- Identified Trunnion Base Plate Component
    !atta = !!ce

    ----------------------------------------------------------------------------------------------------
    -- Initialise MDS Trunnion Selection Variable
    !trunSele = FALSE

    -- Check if the Selected Base Plate is on a MDS Trunnion Branch
    if (!atta.owner.:MDSTrun) then

      -- Get and Check the :MDSSuppType of the Trunnion Branch
      !datumNam = !atta.name.before('.')
      !srefName = !datumNam & '/SREF'
      !!ce      = !srefName.dbref()
      handle ANY
        !!alert.error('Identified plate is NOT on a valid MDS trunnion support')
        --golabel /trunnion
        return
      elsehandle NONE
        -- Get the Client CODE and DESCRIPTION for AT59
        ---------------------------------------------------------------------------------------------------
        --<wd>dec2006<mds12>
        -- The Global CODE and DESC variables are NO LONGER declared for MDS12 -- Use instead the new PML function !!mdsGetDefProp()
        -- Determine the Client Code from the PARAGON MDS12 Defaults
        --!code = !!code$!alias
        !code = !!mdsGetDefProp('ATTA', '!alias', 'CCOD')
        if (!code.eq(|ERROR|)) or (!code.trim().eq(||)) then
          -- Use the AVEVA MDS STANDARD NAME
          !code = !alias
        endif
        -- Determine the Client Code from the PARAGON MDS12 Defaults
        --!desc = !!desc$!alias
        !desc = !!mdsGetDefProp('ATTA', '!alias', 'DESC')
        if (!desc.eq(|ERROR|)) or (!desc.trim().eq(||)) then
          -- Use the AVEVA MDS STANDARD DESCRIPTION
          !desc = |Trunnion Cold Isolation Block with Integral Base Plate|
        endif
        --<wd>dec2006<mds12>
        ---------------------------------------------------------------------------------------------------
        -- Check if the Trunnion SREF atta LBORE is within the BORE RANGE required by the Cold Isolation Block - AT59 i.e. (38.1mm<1.1/2in.> to 406.4mm<16in>)
        if (!!ce.lbor.real().between(38.1,406.4)) then
          -- MDS AT59 Standard does NOT cater for 125/5in. NPS Trunnion Pipe Diameters
          if (!!ce.lbor.real().between(125,127)) then
            !mmBore = !!ce.lbor.real().string()
            !!alert.error('The selected trunnion has a NPS of $!<mmBore>mm<5in.> which is NOT permitted for use with this MDS standard ''$!code''.')
            golabel /trunnion
          endif
        else
          -- Selected Trunnion NPS is NOT within the permitted BORE range for - AT59
          !!alert.error('The selected trunnion has a NPS which is NOT within the permitted bore range of 40mm<1.1/2in.> to 400mm<16in.>, for this MDS standard ''$!code''.')
          golabel /trunnion
        endif

        -- Initialise Selected Trunnion SREF variables
        !srefDbrf = !srefName.dbref()
        !trunType = !!ce.:MDSSuppType
        ---------------------------------------------------------------------------------------------------
        --<wd>dec2006<mds12>
        --!trunCode = !!code$!<trunType>
        -- Determine the Client Code from the PARAGON MDS12 Defaults
        !trunCode = !!mdsGetDefProp('TRUNNION', '!trunType', 'CCOD')
        if (!trunCode.eq(|ERROR|)) or (!trunCode.trim().eq(||)) then
          -- Use the AVEVA MDS STANDARD NAME
          !trunCode = !trunType
        endif
        --<wd>dec2006<mds12>
        ---------------------------------------------------------------------------------------------------

        -- Navigate back to Identified Base Plate and Get the Branch Head Bore Size
        !!ce  = !atta
        --          !hbor = !atta.owner.hbor
      endhandle

      ----------------------------------------------------------------------------------------------------
      -- Check if MDS Trunnion Type is VALID to place an AT59-Cold Isolation Block under the Trunnion Base Plate
      ----------------------------------------------------------------------------------------------------
      if (!trunType inset ('TT18','TT19','TT25','TT37')) then
        -- Selected Trunnion Type is NOT ALLOWED to have an ** AT59 ** ancillary
        !!alert.error('A ''$!code'' is NOT permitted on the selected trunnion type ''$!trunCode''.')
        golabel /trunnion

      endif
      ----------------------------------------------------------------------------------------------------
      if (!trunType inset ('TT04','TT06','TT08','TT10','TT12','TT18','TT22','TT25','TT26','TT36','TT37')) then
        -- For these Trunnion Types - The identified base plate MUST be the LAST branch member
        if (!!ce.owner.mcount().eq(!!ce.order)) then
          -- OK to Continue with the Creation so SET the variable
          !trunSele = TRUE
        else
          !!alert.error('Identified trunnion base plate MUST be the LAST branch member of the selected trunnion type - ''$!trunCode'' ')
          golabel /trunnion
        endif

        ----------------------------------------------------------------------------------------------------
      elseif (!trunType inset ('TT05','TT07','TT09','TT11','TT13','TT19','TT28')) then
        -- For these Trunnion Types - The identified base plate MUST be the PENULTIMATE branch member (i.e. before the Bearing Plate)

        if ((!!ce.owner.mcount() - 1 ) eq (!!ce.order)) then
          -- OK to Continue with the Creation so SET the variable
          !trunSele = TRUE
        else
          !!alert.error('Identified trunnion base plate MUST be the PENULTIMATE branch member of the selected trunnion type - ''$!trunCode'' ')
          golabel /trunnion
        endif
        ----------------------------------------------------------------------------------------------------
      else
        !!alert.error('The identified plate on the MDS trunnion support is NOT suitable for use with the MDS ancillary type ''$!code'' - ''a $!desc''')
        golabel /trunnion
      endif

      ----------------------------------------------------------------------------------------------------

      -- Check if the Selected Plate is a VALID Trunnion Base Plate
      ----------------------------------------------------------------------------------------------------
      if (!trunSele) then
        ----------------------------------------------------------------------------------------------------
        if (!atta.styp inset ('AC30') or !atta.styp inset ('AC57')) then
          -- Adjustable Base Plate for TT18 and TT19 or TT37
          ---------------------------------------------------------------------------------------------------
          --<wd>dec2006<mds12>
          --!altTrunA = !!codeTT04
          !altTrunA = !!mdsGetDefProp('TRUNNION', 'TT04', 'CCOD')
          if (!altTrunA.eq(|ERROR|)) or (!altTrunA.trim().eq(||)) then
            -- Use the AVEVA MDS STANDARD NAME
            !altTrunA = |TT04|
          endif
          --!altTrunB = !!codeTT05
          !altTrunB = !!mdsGetDefProp('TRUNNION', 'TT05', 'CCOD')
          if (!altTrunB.eq(|ERROR|)) or (!altTrunB.trim().eq(||)) then
            -- Use the AVEVA MDS STANDARD NAME
            !altTrunB = |TT05|
          endif
          --<wd>dec2006<mds12>
          ---------------------------------------------------------------------------------------------------

          !!alert.error('Unable to modify the identified ADJUSTABLE Base Plate on the trunnion type ''$!trunCode''.$
          To add a ''$!code'' here you MUST :- Delete the existing trunnion type ''$!trunCode'', and replace it with a trunnion type e.g. ''$!altTrunA'' or ''$!altTrunB'' etc.')
          golabel /trunnion

          ----------------------------------------------------------------------------------------------------
        elseif (not !atta.styp inset ('AC18A','AC18B','AC47','AC49')) then
          -- Identified Plate is NOT ONE of the MDS Trunnion BASE PLATES
          !!alert.error('Identified Plate is NOT a VALID Trunnion Base Plate')
          golabel /trunnion



        endif

      endif
      -- End of !trunSele
      ----------------------------
      ----------------------------------------------------------------------------------------------------
    else
      -- Not on a Valid MDS Trunnion Support
      !!alert.error('Identified Plate is NOT on a MDS Trunnion Support')
      golabel /trunnion

    endif
    ----------------------------------------------------------------------------------------------------

  endif
  -- End of Identify Trunnion Base Plate

  ----------------------------------------------------------------------------------------------------
  ----------------------------------------------------------------------------------------------------
  ----------------------------------------------------------------------------------------------------

  -- Ensure PDMS navigation mode is FORWARDS
  --    var !mode mode
  forwards

  ----------------------------------------------------------------------------------------------------
  -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed
  -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.
  !currComp = !!ce
  if (!!ce.type eq 'BRAN') then
    !hDir = hdir wrt /*
  else
    !hDir = pl dir wrt /*
  endif

  if (!hDir neq U and !hDir neq D ) then
    if (!!mdsGradient(!currComp)) then
      !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
      !!ce = !ceComp
      !!kRestoreUnits(!currentunits)
      return
    endif
  endif
  ----------------------------------------------------------------------------------------------------

  --Determine Bore Units and Bore Variable !bore for the ERROR Message ONLY
  if(!!kGetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif
  $!boreUnits
  !bore = ph bore
  --<wd>09jun2009 - Defect No. P-17079
  -- Removed this Code as it is NOT required.
  -- It INCORRECTLY RESETS the UNITS in the CODE below when used after this code for the !bore ERROR Message
  --     !currentunits = !!kGetSetUnits()
  --<wd>09jun2009 - Defect No. P-17079


  ----------------------------------------------------------------------------------------------------
  -- Select ancillary
  -- Create the 'AT59' type support - GTYP is now a PLAT and NOT an ATTA
  --
  --new atta
  --spkbrk true
  --$P SELECT SPEC /MDS WITH STYP '$!alias'
  --!choice = SELECT SPEC /MDS WITH STYP '$!alias'

  !!mdsDacControl(TRUE)

  -- <sk> 04/06/2012
  !fromAtta = !!mdsAT59.support.preliminaryStore.set()
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    !refNoStr = !!ce.refno.string()
    DELETE ATTA
    new plat ref $!refNoStr
  else
    new plat
  endif
  -- <sk> 04/06/2012

  select spref with styp '$!alias' spec /MDS
  handle ANY
    --delete atta
    !projStandard = !!mdsAT59.support.replace
    !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
    -- <sk> 04/06/2012
    delete plat
    !!kRestoreUnits(!currentunits)
    !!mdsDacControl(FALSE)
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT59, true)
    endif
    return

  elsehandle NONE
    -- The element may exist in the specification but the project may not contain the size in the parameters file
    ---------------------------------------------------------------------------------------------------
    --<wd>dec2006<mds12>
    -- CHECK the MDS12 PARAGON DEFAULTS for the PLATE BORE SIZE
    --if undefined(!!mdsPar$!alias[$!bore]) then
    -- Check the MDS12 DEFAULTS CATALOGUE DESPARS Data is OK
    units mm bore
    !plat = !!ce
    !lbor = !plat.lbor.real().value()
    -- Set the AT59 Cold Isolation Block Design Parameters
    !mds12test = !!mdsSetDespars(!plat)
    if (!mds12test.not()) then
      --<wd>dec2006<mds12>
      ---------------------------------------------------------------------------------------------------
      --delete atta
      !projStandard = !!mdsAT59.support.replace
      !!alert.error('Unable to select ancillary ' & !projStandard & ' at this bore(' & !bore & ')')
      -- <sk> 04/06/2012
      delete plat
      !!kRestoreUnits(!currentunits)
      !!mdsDacControl(FALSE)
      if !fromAtta then
        !!mdsRestorePre(!!mdsAT59, true)
      endif
      return
    endif
  endhandle

  units mm bore

  -- This code is only OK when creating an ATTA
  --spref $!choice[1]

  ----------------------------------------------------------------------------------------------------
  --<wd>dec2006<mds12> -- This CODE has been REPLACED by the CODE at approx. line 293 above, i.e. !mds12test = !!mdsSetDespars(!plat)
  -- Set the AT59 Cold Isolation Block Design Parameters
  --    !!mdsSetDespars(!!ce)
  --<wd>dec2006<mds12>
  ----------------------------------------------------------------------------------------------------

  -- Turn DAC controls ON
  !!mdsDacControl(TRUE)

  ----------------------------------------------------------------------------------------------------
  -- Check Pipe Insulation Thickness is within the limits of the Selected Ancillary Standard
  -- If the MNIN (Minimum Insulation) data property does not exist in the ancillary's dataset
  -- the OBJECT '!!mdsCheckStd.insu()' will return 'TRUE' and skip the code shown below
  --
  ----------------------------------------------------------------------------------------------------
  --<wd>dec2006<mds12>
  !check = object MDSCHECKSTD()
  !platSType   = !plat.stype
  !mdsAttaObj  = object MDSREADPARSDATA()
  !mdsAttaDefs = !mdsAttaObj.mdsDefsData(!platSType, !lbor)

  if (!mdsAttaDefs.not()) then
    !!alert.error (|ERROR: ABORTING the creation of this MDS ANCILLARY|)
    !!kRestoreUnits(!currentunits)
    -- <sk> 04/06/2012
    delete plat
    !!mdsDacControl(FALSE)
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT59, true)
    endif
    return
  endif
  !check = object MDSCHECKSTD(!mdsAttaObj )
  !!ce   = !plat
  --<wd>dec2006<mds12>
  ----------------------------------------------------------------------------------------------------

  -- Variables associated with the Object calls shown below
  !min = STRING()
  !max = STRING()
  !matError = STRING()

  if (!check.material(!matError).not()) then
    !!alert.error (!matError)
    !!kRestoreUnits(!currentunits)
    -- <sk> 04/06/2012
    delete plat
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT59, true)
    endif
    return
  endif

  if (!check.insu(!alias,!min,!max).not()) then
    !!mdsInsulationError(!currentunits, !min, !max, !replace)
    !!kRestoreUnits(!currentunits)
    --delete atta
    -- <sk> 04/06/2012
    delete plat
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT59, true)
    endif
    return
  endif

  -- Check branch temperature is within the limits of the Selected ancillary Standard
  -- If the MINT (Minimum Temperature) data property does not exist in the ancillary's dataset
  -- the OBJECT '!!mdsCheckStd.insu()' will return 'TRUE' and skip the code shown below
  !tMin = STRING()
  !tMax = STRING()
  if (!check.temp(!alias,!tMin,!tMax).not()) then
    var !temp temp of branch
    !!alert.message ('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tMin / $!tMax)')
    !!kRestoreUnits(!currentunits)
    delete plat
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT59, true)
    endif
    return
  endif

  -- Test if the ancillary is available at this ELEVATION
  if !check.elevation(!alias).not() then
    !position = !!ce.position.wrt(/* )
    !selectedElevation = !position.up
    ----------------------------------------------------------------------------------------------------
    --<wd>dec2006<mds12>
    --!minimumElevation = !!mdsPar$!alias[0].despars[1]
    -- The ELEVATION data is DETERMINED during the creation of the DATA in the "MDSREADPARSDATA" PML object,
    -- which is stored in the current Object variable !mdsAttaObj
    !minimumElevation = !mdsAttaObj.elevation
    --<wd>dec2006<mds12>
    ----------------------------------------------------------------------------------------------------
    !!alert.message ('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedElevation Minimum elevation $!minimumElevation')
    !!kRestoreUnits(!currentunits)
    delete plat
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT59, true)
    endif
    return
  endif

  -- <sk> 06/07/2012 Check user criteria
  !criteria = !check.criteria()
  if (!criteria.empty().not()) then
    !!alert.error (!criteria)
    !!kRestoreUnits(!currentunits)
    delete plat
    -- <sk> 04/06/2012
    if !fromAtta then
      !!mdsRestorePre(!!mdsAT59, true)
    endif
    return
  endif
  -- <sk> 06/07/2012

  ----------------------------------------------------------------------------------------------------
  -- Set the ATTA - UDA :MDSMatref with the PROPCON Property, if it is declared in the MDS dimensions default file
  !!mdsSetMatref(!!ce)

  -- Ensure DAC Control is ON
  !!mdsDacControl(TRUE)

  --  Set variables
  !form   = !!mdsAT59
  !at59ce = !!ce

  -- Get The Associated Trunnion Type e.g 'TT04', from the SREF Atta in The Selected Trunnion Branch
  ----------------------------------------------------------------------------------------------------
  if (!insuType.eq('TRUNNION')) then

    -------------------------------------------------------------------------------
    -- <wd>dec2006<mds12>
    --
    -- Get the MIN and MAX Length Values of the Trunnion
    --!trunABor = !srefDbrf.abor
    --!minLen   = !!mdsPar$!trunType[$!trunABor].minimum
    --!maxLen   = !!mdsPar$!trunType[$!trunABor].maximum
    --
    -- The !trunABor was getting the SREF atta ABOR which is the INCORRECT pipe size.
    -- When determining the MIN and MAX TRUNNION lengths the MAIN BRANCH HBOR size MUST be USED.

    --><wd>05jun09 - DFN P-17079 - ERROR raised if PIPE BORE parameters are actual IMPERIAL bore sizes, e.g. 152.4mm = 6in and NOT 150mm
    --      !braHBor  = !srefDbrf.owner.hbor
    !braHBor  = !srefDbrf.owner.hbor.string().lowcase().before('mm').real().value()
    !mdsTrunObj  = object MDSREADTRUNDATA()
    !mdsTrunData = !mdsTrunObj.mdsTrunData(!trunType,!braHBor)
    --<<wd>05jun09 - DFN P-17079
    -- Check Returned Data
    if (!mdsTrunData.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
      if (!mdsTrunObj.mdsStd.sactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
        !errormessage = !mdsTrunObj.mdsStd.smess
      elseif (!mdsTrunObj.mdsStd.cactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
        !errormessage = !mdsTrunObj.mdsStd.cmess
      endif
      !!alert.error(!errormessage)
      return
    endif
    -- Set the TRUNNION- MIN and MAX Lengths
    --      !minLen = !mdsTrunObj.minLength
    --      !maxLen = !mdsTrunObj.maxLength
    -- <wd>dec2006<mds12>
    -------------------------------------------------------------------------------

    -- Get the Existing Length of the Associated Trunnion Branch
    !!ce = !atta.owner
    pin 9 copy ph
    pin 8 copy pt

    -- For trunnions with Bearing plates - Move Pin 8 UP the Branch by its thickness
    if (!trunType inset ('TT05','TT07','TT09','TT11','TT13','TT19','TT28')) then
      last mem
      -- Bearing Plate Thickness
      !bearLn = !!kStrReal ('cons dist pa to pl')
      pin 8 dist $!bearLn
      !!ce = !atta.owner
    endif

    pin 9 dir d
    if (!!ce.href.type.neq('REDU')) then
      pin 9 plane pin 9 thro p0 of href
    endif

    !xTrLen = !!kStrReal('cons dist pin 9 to plane pin 8')
    !!mdsresetpins(8,9)
    !!mdsAT59.tlength = !xTrLen

    -- Connect Cold Isolation Block to the Identified Trunnion Base Plate
    !!ce = !at59ce
    conn
    handle ANY
      fconn
    endhandle

    -- Adjust Trunnion Length within the MIN/MAX Trunnion Length Limits to Accommodate the Cold Isolation Block
    !trunLenWarn = STRING()
    if (!!mdsAdjTrunLen(!atta,!at59ce,!srefDbrf,!form,'CREATE',!trunLenWarn).not()) then
      if((!!alert.confirm(!trunLenWarn)) eq ('NO')) then
        !!alert.message('** ABORTING ** creation of ''$!code'' - ''$!desc''')
        !!ce = !at59ce
        -- <sk> 04/06/2012
        if !fromAtta then
          !!mdsRestorePre(!!mdsAT59, true)
          return
        endif
        delete plat
        return
      endif
    endif

    -- Set the Cross Reference Attribute :MDSGuideRef at Both the Trunnion Base Plate <PLAT> and Cold Isolation Block <ATTA>
    !atta.:MDSGuideRef   = !at59ce
    !at59ce.:MDSGuideRef = !atta
  endif
  ----------------------------------------------------------------------------------------------------

  -- Navigate Back to New Cold Isolation Block Atta
  !!ce = !at59ce
  -- Name support
  name /$!name
  :MDSSuppType |$!!mdsAT59.support.type|
  !!ce.:MDSCP3 = !insuType

  -- Set Insulation spec - NOT NORMALLY associated with TRUNNION type supports!
  !!mdsSetIspe()

  -- Select the LSTU for the AT59 'PLAT'
  --    !sAtta = !!ce
  !!mdsSelLstu(!!ce)
  -- Ensure DAC Control is ON
  !!mdsDacControl(TRUE)

  -- Always add PLAT to support.atta object member
  !!ce = !at59ce
  !!mdsAT59.support.atta.clear()
  !!mdsAT59.support.atta.append(!!ce)
  !!mdsAT59.support.datum  = !!ce
  !!mdsAT59.support.padir  = pa dir wrt world
  !!mdsAT59.support.pldir  = pl dir wrt world
  !!mdsAT59.support.p9dir  = p9 dir wrt world

  -- If an 'AT59' has successfully been appended to a TRUNNION - The CANCEL button is De-Activated,
  -- This is because the Trunnion Length has been MODIFIED and the Trunnion Forms DO NOT ALLOW the users to CANCEL
  !!mdsAT59.cancel.active = FALSE

  -- Add marker text
  !!mdsAidText(!!mdsAT59)

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsAT59.support.atta)

  -- Colour Support
  call !!kEnhanceList(!colourList)

  -- When finished grey out datum gadget and reset height,length and setsteel
  !!mdsAT59.datum.active = FALSE
  !!mdsSetGadgets(!!mdsAT59,!!ce,!!mdsAT59.support.type)

  -- Reset Units
  !!kRestoreUnits(!currentunits)

  -- set focus to the distance text gadget
  !!mdsAT59.dist.setFocus()

  -- Turn DAC controls OFF
  !!mdsDacControl(FALSE)

  -- Navigate to Original component
  !!ce = !ceComp

  -- End function
endfunction
