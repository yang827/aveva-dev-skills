--
-- File:  mdssetdatgt20.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:
--
-- Author:  N.morris
-- Created:  Tue Oct 28
--
--
-- Description:
-- Creation function for guide Gt20
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdsSetDatGt20()

  ------------------------------------
  !currentunits = !!kgetsetunits()
  ------------------------------------
  -- Force into forwards mode
  FORWARDS

  -- Initialise variables
  !datum       = !!mdsGT20.support.datum
  !name        = !!mdsGT20.name.val
  !fromAtta    = !!mdsGT20.support.preliminaryStore.set()

  !cecomp = !!ce

  if (!datum.set()) then
    !!alert.error('Atta for support $!name already exists')
    !!kRestoreUnits(!currentunits)
    return
  endif

  -- <ak> 21/06/2012
  if (!fromAtta AND defined (!!mdsAutoTubePicker) AND !!mdsAutoTubePicker.enabled()) then
    -- return if limit of pick tries exceeded
    if (!!mdsAutoTubePicker.allowedPicks.eq(0)) then
      !!mdsAutoTubePicker.cancel()
      return FALSE
    endif

    !picked = !!mdsAutoTubePicker.pick('PLAT','')
    if unset(!picked) then
      !!alert.warning ('There is no pedestal suitable to stop next to preliminary support.')
      !!mdsAutoTubePicker.cancel()
      !!kRestoreUnits(!currentunits)
      return false
    else
      !!ce = !picked
    endif
  else
    -- <ak>

    -- Identify pedestal to attach guide to
    prompt off
    prompt load escape 'Identify pedestal to guide'
    ID ATTA PLAT @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return false
    endhandle
    prompt on
  endif

  --xxx    !attaNamn = !!ce.namn
  --xxx    !attaName = !!ce.name
  !atta = !!ce

  !despar1 = despar[1]
  !despar5 = despar[5]
  !despar4 = despar[4]
  !styp = !!ce.styp
  if (match(!styp,'10A') gt 0) then
    !despar2 = despar[2]
  elseif (match(!styp,'11A') gt 0) then
    !despar2 = despar[2]
  endif

  -- Is it a pedestal
  -- The styp has to be one of the following
  -- AT10A, AT10B, AT11A, AT11B

  !styp = !!ce.styp

  if (!styp.upcase() inset('AT10A','AT10B','AT11A','AT11B')) then
  else
    !!alert.error('The identified element is not suitable to guide with this type, it must be a pedestal')
    !!kRestoreUnits(!currentunits)
    return
  endif

  --------------------------------------------------------------------------------
  --xxx  :mdsGuide 'Guide $!name'

  -- Select ancillary

  !bore = Pl bore
  handle any
    !bore = ph bore
  endhandle

  -- <ak> 20/06/2012
  if !fromAtta then
    !!ce = object DBREF('/' & !name & '_Pre')
    :mdssupptype default
    :mdssuppfunc default
    -- set datum in the form for distance
    !!mdsGT20.support.datum = !!ce
  else
    new atta
  endif
  -- </ak> 20/06/2012

  SPKBRK TRUE
  !!mdsGT20.support.datum  = !!ce

  --xxx  :mdsGuide '$!attaNamn'

  -- The styp to be selected by default is dependant on the pedestal identified

  !!ce = !atta
  !!ce = !!mdsGT20.support.datum
  !newStyp = 'GT20'
  sel with styp '$!newStyp' SPEC /MDS

  !!mdsSetDesPars(!!ce)
  despar n1 $!despar1
  despar n2 $!despar4
  handle any
  endhandle
  despar n9 $!despar5


  -- Name support
  :SuppType |$!!mdsGT20.support.type|
  Name /$!name

  -- Set Guide Atta :mdsguideref to Shoe Atta
  :mdsguideref $!atta
  !guide = !!ce

  -- Navigate back to Shoe Atta and Set :mdsguideref to Guide Atta
  !!ce  = !atta
  :mdsguideref $!guide
  handle ANY
    claim ce
    :MDSGuideRef $!guide
  elsehandle NONE
  endhandle

  --> Modified -<wd>-12oct1998
  !pedpldir = pl dir wrt /*
  --< Modified -<wd>-12oct1998

  -- Navigate back to Guide Atta
  !!ce = !guide

  --> Modified -<wd>-12oct1998
  if (!!ce.:mdsguideref.styp.upcase().eq('AT10A') or !!ce.:mdsguideref.styp.upcase().eq('AT11A')) then
    if (!pedpldir.eq(U WRT /* )) then
      flip
    endif
  endif
  --< Modified -<wd>-12oct1998

  --------------------------------------------------------------------------------
  !!mdsSetIspe()

  --  Add stex for isometrics
  call !!mdsTransport(!!ce,!name)

  -- !stex = after(!name, '/')
  -- !tran = subs(!stex, 1, 1)
  -- STEX '$!stex'

  !!mdsSelLstu(!!ce)

  CONN

  !!mdsGetProp(!!mdsGT20.length,!!mdsGT20.pLength,'LEN',!bore,!!mdsGT20.support.type)
  !!mdsGetProp(!!mdsGT20.clearance,!!mdsGT20.pClearance,'CLR',!bore,!!mdsGT20.support.type)

  -- Add marker text
  VAR !pOS POS WRT WORLD
  $M/%PDMSUI%/DES/CLIB/GAIDTEXT 210 Datum $<$!pOS$>

  -- Always add atta to support object
  !!mdsGT20.support.atta.clear()
  !!mdsGT20.support.atta.append(!!ce)
  !!mdsGT20.support.pADir  = Pa Dir wrt world
  !!mdsGT20.support.pLDir  = Pl Dir wrt world
  !!mdsGT20.support.p9Dir  = P9 Dir wrt world

  -- Enhance elements using colour set for highlight
  !colourList = ARRAY()
  !colourList.appendarray(!!mdsGT20.support.atta)

  -- Colour Support
  Call !!kEnhanceList(!colourList)

  -- When finished grey out datum gadget and reset gadgets

  !!mdsSetGadgets(!!mdsGT20,!!ce,!!mdsGT20.support.type)

  !!mdsGT20.datum.active = false


  !!kRestoreUnits(!currentunits)

  !!ce = !cecomp

endfunction
