--
-- File: mdssetdattt23.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: Wayne Dodwell
-- Created: February 2003
--
--
-- Description:
-- Creation function for Trunnion Type 'TT23'
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         FORM        FORM of current Trunnion Type
--     2     R        STRING       CREATE - for Creating the Datum Atta - Trunnion Type and Size
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------


-- Define Function
define function !!mdssetdattt23(!form is FORM, !mode is STRING,!onType is STRING)

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kgetsetunits()

  -- Set calling form name
  !callingForm = !form
  !fromAtta    = !form.support.preliminaryStore.set()

  -- Initialise variables
  --  !support     = !form.support
  --  !tubeType    = !!mdsOptions.pipes
  --  !datum       = !form.support.datum
  !name        = !form.name.val
  --  !alias       = !form.support.alias
  !ceComp      = !!ce
  --  !formName    = '!!' & !form

  --------------------------------------------------------------------------------
  -- Create the Datum - Trunnion Atta
  if (!mode.upcase() eq 'CREATE') then
    -- Select Elbo or Tube, this will determine what type of base support is created.
    if !onType.eq('CROS') then
      !idType = 'CROS TEE'
    else
      !idType = !onType
    endif

    --if we have an idtype of TUBE and are creating from an existing prelim support
    --then do not id anything just use the existing prelim atta
    if !fromAtta and !idType.eq('TUBE') then
      !prelimName = '/' & !name & '_Pre'
      !datumRef = object DBREF(!prelimName)
      handle ANY
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      elsehandle NONE
        !!ce = !datumRef
      endhandle
    else
      prompt off
      prompt load escape 'Identify $!idType to create base support'
      ID $!idType @
      handle (61,528)
        prompt on
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return FALSE
      endhandle
      prompt on
    endif
    !element = !!ce

    -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed,
    -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.
    !currComp = !!ce
    if (!!ce.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
    endif

    -- Check that pipe is named
    pipe
    if (!!ce.ref.string().eq(!!ce.name)) then
      !!alert.error('Pipe must be named to create MDS trunnion')
      !!ce = !ceComp
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif
    !!ce = !currComp

    --<wd>15jan2008 -- Defect No. P-4534
    -- Modified to suit both COORD ENU and COORD XYZ, so check the UP member of the !hdir DIRECTION object
    -- The check here is to test if the identified TUBI (PIPE) is truly VERTICAL
    --    if (!hdir neq U and !hdir neq D ) then
    if (!hdir.up.neq(1) and !hdir.up.neq(-1) ) then
      --<wd>15jan2008 -- Defect No. P-4534
      if (!!mdsGradient(!currComp)) then
        !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
        !!ce = !ceComp
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      endif
    endif

    -- Check pipe material
    !pipeMat = !!ce.owner.pspe.:MDSPipeMat
    !bore   = pl bore
    handle any
      !bore = ph bore
    endhandle

    -- Check if current selected bore is available
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --
    --!boreCheck = !!mdsParTT23[$!bore].pipeMaterial
    --handle any
    --
    -- NOTHING Created or Selected YET, so CHECK if TRUNNION STANDARD Available for the MAIN PIPE Bore
    --><wd>14may09 - DFN P-17079 - ERROR raised if PIPE BORE parameters are actual IMPERIAL bore sizes, e.g. 152.4mm = 6in and NOT 150mm
    --    !mBore  = !bore.real()
    !mBore  = !bore.string().lowcase().before('mm').real().value()
    --<<wd>14may09 - DFN P-17079

    !mdsStd = 'TT23'
    !mdsTrunObj  = object MDSREADTRUNDATA()
    !mdsTrunData = !mdsTrunObj.mdsTrunData(!mdsStd, !mBore)

    if (!mdsTrunData.not()) then
      -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" or "CATEGORY" element
      if (!mdsTrunObj.mdsStd.sactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "SECTION" element
        !errormessage = !mdsTrunObj.mdsStd.smess
      elseif (!mdsTrunObj.mdsStd.cactive.not()) then
        -- ERROR with the MDS DEFAULTS in the PARAGON CATALOGUE "CATEGORY" element
        !errormessage = !mdsTrunObj.mdsStd.cmess
      endif

      !!kRestoreUnits(!currentUnits)
      !!alert.error('Bore $!bore is not within the available bores')
      !callingForm.bore.clear()
      !callingForm.mainBore.val = 'Main Bore'
      !callingForm.tlength.val = 0
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
      --endhandle
    endif

    -- Get material types
    --!stanMat = !!mdsParTT23[0].pipeMaterial
    --handle any
    --!stanMat = !!mdsParTT23[$!bore].pipeMaterial
    --endhandle
    --
    -- At <mds12> the "ACTIVE" .pipeMaterial is STORED,
    -- i.e. The ACTUAL BORE .pipeMaterial, if it is SET, always overrides the ZERO[0] BORE .pipeMaterial
    !stanMat = !mdsTrunObj.pipeMaterial
    --
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------

    !matlist = !stanMat.split(',')
    !findIt  =  !matlist.findfirst(!pipeMat)

    if !findIt.string().eq('') then
      !findIt = 0
    endif

    if !stanMat.upcase().eq('UNSET') or !stanMat.eq('') then
      !!alert.error('The MDS material code of the MDS standard is unset. Aborting creation!')
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    if !pipeMat.upcase().eq('UNSET') then
      !!alert.error('The MDS material code of the pipe specification is unset. Aborting creation!')
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    if !stanMat.upcase().eq('ALL') then
      -- If the Standard TT23 allows ALL Materials then set the variable to 1
      !findIt = 1
    endif

    if !findIt.eq(0) then
      !!alert.error('The identified pipe specification has a MDS material code of $!pipeMat and does not match the MDS standards material code/s of $!stanMat')
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
    endif

    -- Finished material checking
    forwards

    --------------------------------------------------------------------------------
    -- Check if element identified is suitable for this type of base support
    --------------------------------------------------------------------------------
    !!ce = !element
    if !onType.eq('ELBO') then
      !paTest = pa dir wrt /*
      !plTest = pl dir wrt /*
      --<wd>15jan2008 -- Defect No. P-4534
      -- Modified to suit both COORD ENU and COORD XYZ, so check the UP member of the !paTest and !plTest DIRECTION objects
      -- The check here is to test if the either the PLEAVE or the PARRIVE direction of the identified ELBO is in
      -- the UP or Z direction to enable a trunnion to be created.
      --      if !paTest.string().eq('U WRT /*').not() and !plTest.string().eq('U WRT /*').not() then
      if (!paTest.up.neq(1) and !plTest.up.neq(1) ) then
        --<wd>15jan2008 -- Defect No. P-4534
        !!alert.error('Identified elbow is not suitable')
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      endif
      var !radius const dist p0 to p1
    elseif !onType.eq('REDU') then
      pin 1 copy pa
      pin 2 copy pl
      pin 1 plane pa thro pin 2
      var !pin1Pos pin 1 pos
      var !pin2Pos pin 2 pos
      !!mdsResetPins(1,2)
      if !pin1Pos.eq(!pin2Pos) then
        !!alert.error('Identified redu must be eccentric')
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      endif
    elseif !onType.eq('CROS') then
      -- Scan for correct type
      if !!mdsSelectComp('CROS').not() then
        !!alert.error('Unable to find a suitable cross in the current specification')
        !callingForm.bore.clear()
        !callingForm.mainBore.val = 'Main Bore'
        !callingForm.tlength.val = 0
        !!kRestoreUnits(!currentUnits)
        !!mdsdaccontrol(false)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      endif

    else
      if !!mdsGradient(!currComp) then
        !!mdsResetPins(9,9)
        !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsOptions.slope.val)')
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      endif
    endif

    --The value of !od should always take the PLeave Outside Diameter of the Previous Component
    -- and NOT the PArrive e.g as in a REDUCER as this gives the WRONG MAIN Pipe Bore OD
    --!od = pa od
    !od = pl od
    handle (2,252)
      !od = ph od
    endhandle

    !!mdsResetPins(1,1)

    -- Get Session Bore Units
    if(!!kGetBoreUnits()) then
      !boreUnits = 'inch bore'
    else
      !boreUnits = ''
    endif

    -- If REDUCER then get the Smallest Bore Size
    if (!onType.eq('REDU')) then
      if (!element.abor.gt(!element.lbor)) then
        !sBor = 'pl'
      else
        !sBor = 'pa'
      endif
    else
      !sBor = 'pl'
    endif
    --!bore = pl bore
    !bore = $!sBor bore
    handle any
      !bore = ph bore
    endhandle

    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --<mds12> The available Trunnion Bore Sizes are now stored in the object member !mdsTrunObj.bores
    --
    -- The available bores will be stored in the object for TT23 !!mdsParTT23[Bore]
    -- Fill the selection gadget with these available bores and the styp to be used

    --!availBores = !!mdsParTT23[$!bore].bores
    --handle any
    !availBores = !mdsTrunObj.bores
    if (!availBores.empty()) then
      !!kRestoreUnits(!currentUnits)
      !!alert.error('Bore $!bore is not within the available bores')
      !callingForm.bore.clear()
      !callingForm.mainBore.val = 'Main Bore'
      !callingForm.tlength.val = 0
      !!kRestoreUnits(!currentUnits)
      if (!fromAtta) then
        !!mdsCancelSupp(!form)
      endif
      return
      --endhandle
    endif
    --
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------

    !!kRestoreUnits(!currentUnits)
    !unitBore = ARRAY()
    do !setUnitBores from 1 to !availBores.size()
      !mmbore = !availBores[$!setUnitBores] & 'mm'
      !unitBore.append(!mmbore.bore(!!boreFmt).string())
    enddo
    !currentUnits = !!kgetsetunits()
    !callingForm.bore.dtext = !unitBore
    !callingForm.bore.rtext = !availBores
    !mmbore = !bore.string()
    !!kRestoreUnits(!currentUnits)
    !mainBore = !mmbore
    !callingForm.mainBore.val = 'Main     Bore =     $!mainBore'
    !currentUnits = !!kgetsetunits()

    -- Get the default length if in create mode
    if !mode.upcase()eq('CREATE') then
      ---------------------------------------------------------------------------------------------------
      --<wd>apr2006<mds12>
      --!callingForm.tlength.val = !!mdsParTT23[$!bore].default
      !callingForm.tlength.val = !mdsTrunObj.deflength
      --<wd>apr2006<mds12>
      ---------------------------------------------------------------------------------------------------
    endif

    -- The support is created as a branch create branch and connect to appropriate member
    if !onType.eq('ELBO') or !onType.eq('REDU') then

      -- The new branch will be connected to the p3 of the elbo, it will need to be on the correct
      -- side as p3 is in the same place as p1 but in the opposite direction. Therefore the p3 will
      -- be higher exit point.

      if !onType.eq('ELBO') then
        -- Scan for correct elbow type
        if !!mdsSelectComp(!!ce.type).not() then
          !!alert.error('Unable to find a suitable elbow in the current specification')
          !callingForm.bore.clear()
          !callingForm.mainBore.val = 'Main Bore'
          !callingForm.tlength.val = 0
          !!kRestoreUnits(!currentUnits)
          !!mdsdaccontrol(false)
          if (!fromAtta) then
            !!mdsCancelSupp(!form)
          endif
          return
        endif
      elseif !onType.eq('REDU') then
        -- Scan for correct redu type
        if !!mdsSelectComp(!!ce.type).not() then
          !!alert.error('Unable to find a suitable redu in the current specification')
          !callingForm.bore.clear()
          !callingForm.mainBore.val = 'Main Bore'
          !callingForm.tlength.val = 0
          !!kRestoreUnits(!currentUnits)
          !!mdsdaccontrol(false)
          if (!fromAtta) then
            !!mdsCancelSupp(!form)
          endif
          return
        endif
      endif
      !!mdsdaccontrol(true)

      if !element.ppos[3].up.lt(!element.ppos[2].up) then
        flip ori
        handle any
          !!alert.error('The identified elbow requires to be flipped but access to the elbow has been denied. Please flip the elbow and try again!.')
          !!kRestoreUnits(!currentUnits)
          if (!fromAtta) then
            !!mdsCancelSupp(!form)
          endif
          return
        endhandle
        ori pa is $!paTest and pl is $!plTest
      endif

      --<dw>aug2008 dun979 - flow direction turned off
      new bran flowdir OFF
      :MDSTrun true
      connect ph to p3 of same
      handle (42,64)
      endhandle
    elseif !onType.eq('CROS') then
      !!mdsdaccontrol(true)

      --<dw>aug2008 dun979 - flow direction turned off
      new bran flowdir OFF
      :MDSTrun true
      connect ph to p4 of same
      handle (42,64)
      endhandle
    else
      -- Creating on a Straight Length of Pipe
      !!mdsdaccontrol(true)
      !teeOd = pl bore
      handle (2,252)
        !teeOd = ph bore
      endhandle

      new tee
      if !!mdsSelectComp(!!ce.type).not() then
        !!alert.error('Unable to find a suitable tee in the current specification')
        !callingForm.bore.clear()
        !callingForm.mainBore.val = 'Main Bore'
        !callingForm.tlength.val = 0
        !!mdsdaccontrol(true)
        delete tee
        !!mdsdaccontrol(false)
        !!kRestoreUnits(!currentUnits)
        if (!fromAtta) then
          !!mdsCancelSupp(!form)
        endif
        return
      endif
      !!mdsdaccontrol(true)

      -- spref $!foundTee
      sel lstu
      lea 3
      dir d
      lea 2
      !paOd = pa od
      !dist = !paOd / 2 + 100mm
      dist $!dist from pl of prev
      handle any
        dist $!dist from ph
      endhandle
      !dist.delete()
      var !dist const dist p0 to p0 of prev
      handle ANY
        var !dist const dist p0 to ph
      endhandle
      !form.dist.val = $!dist

      -- Create Branch for Trunnion
      --<dw>aug2008 dun979 - flow direction turned off
      new bran flowdir OFF
      :MDSTrun true
      conn ph to same

      -- End of Branch creation
    endif

    !!mdsdaccontrol(true)
    hdir d tdir u
    Hbor $!callingForm.bore
    Tbor $!callingForm.bore
    Tcon ATT
    sel hstu
    pipe
    !pipeName = name
    same
    name $!pipeName/$!callingForm.name

    !tOd = ph od

    -- Work out the adjustment needed for the exact length to be added to the iso
    if !onType.eq('ELBO') then
      !hyp = !radius.real() + (!od / 2)
      !side1 = !radius.real() + (!tOd / 2)
      !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))
    else
      -- Find smallest bore if redu
      if !onType.eq('REDU') then
        !rb1 = pod 1 of $!element
        !rb2 = pod 2 of $!element
        if !rb1.gt(!rb2) then
          !od = !rb2
        else
          !od = !rb1
        endif
      endif
      !hyp = (!od / 2)
      !side1 = (!tOd / 2)
      !offset = (sqrt ((!hyp * !hyp) - (!side1 * !side1)))
    endif

    hbor $!bore

    --><wd>25sep2009 - DFN P-22636 (SI-9969)
    -- Keep this ATTA at its CURRENT POSITION on types TUBE, REDU and TEE(CROS) to POSITION the NOTE CORRECTLY on the ISOMETRIC
    -- Do Not Cut Hole Comment Atta
    if (!onType.neq('ELBO')) then
      new atta select spref with styp 'COMMENT' spec /MDS
      sel lstu
      connect
      handle (7,3)
        fconnect
      endhandle
      -- if !!mdsTrunNotes.boolean() then
      stex 'DO NOT CUT HOLE IN PIPE'
      -- endif
      atty CCNN
      name /$!callingForm.name.val/NOTE1
      !callingForm.support.atta.append(!!ce)
    endif
    --<<wd>25sep2009 - DFN P-22636 (SI-9969)

    -- Makeup Piece Atta
    if !onType.eq('ELBO') then
      new REDU select spref with styp 'MAKEUP' spec /MDS
    else
      new REDU select spref with styp 'MAKEUPOFF' spec /MDS
    endif
    despar $!callingForm.bore $!offset  0mm
    -- spkbrk true
    sel lstu
    connect
    handle (7,3)
      fconnect
    endhandle
    -- atty CCNN
    mtoc off
    name /$!callingForm.name.val/MAKEUP
    !callingForm.support.atta.append(!!ce)

    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    -- SET the variable for TRUNNION Bore Size
    !bore = pa bore
    handle any
      !bore = pa bore of prev
    endhandle
    bran
    -- SET the variable for MAIN PIPE Bore Size -- NOT REQUIRED at <mds12>
    --    !phbore = ph bore
    same
    --!sType = !!mdsParTT23[$!phbore].sTypes[!callingForm.bore.val]
    !sType = !mdsTrunObj.sTypes[!callingForm.bore.val]
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------

    !splitStype = !sType.split(',')

    --><wd>25sep2009 - DFN P-22636 (SI-9969)
    -- Locate this ATTA at the PLEAVE of the MAKEUP REDUCER on ELBO TRUNNION ONLY to POSITION the NOTE CORRECTLY on the ISOMETRIC
    -- Cut hole comment atta
    if (!onType.eq('ELBO')) then
      new atta select spref with styp 'COMMENT' spec /MDS
      sel lstu
      connect
      handle (7,3)
        fconnect
      endhandle
      -- if !!mdsTrunNotes.boolean() then
      stex 'DO NOT CUT HOLE IN PIPE'
      -- endif
      atty CCNN
      name /$!callingForm.name.val/NOTE1
      !callingForm.support.atta.append(!!ce)
    endif
    --<<wd>25sep2009 - DFN P-22636 (SI-9969)

    -- Vent Hole 1 Comment Atta
    new atta select spref with styp 'COMMENT' spec /MDS
    sel lstu
    connect
    handle (7,3)
      fconnect
    endhandle
    dist 200mm
    if !!mdsTrunNotes.boolean() then
      stex '3mm VENT HOLE.
      SEAL WELD AFTER FABRICATION'
    endif
    atty CCNN
    name /$!callingForm.name.val/NOTE2
    !callingForm.support.atta.append(!!ce)

    -- Create Upper Breaking Plate 1 Atta 'AC46'
    new PLAT despar 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm
    -- spkbrk true
    select spref with styp '$!splitStype[1]' spec /MDS
    sel lstu
    ori pl is d
    name /$!callingForm.name.val$n.1
    !callingForm.support.atta.append(!!ce)
    !!mdsSetDesPars(!!ce)
    !!mdsdaccontrol(true)

    -- The position of the Breaking Plate Atta is set by the 'AC46' property PDIST
    -- from the BOP of the main header. Get the value and position the breaking plate.
    !pdist = prop pdist
    !plates = !!ce
    bran
    goto href
    var !insu insu
    !!ce = !plates
    pin 9 copy ph
    pin 9 dir d

    if !onType.eq('ELBO') then
      pin 9 plane pin 9 clear 0 beh href of bran
    else
      pin 9 plane pin 9 clear 0 beh pl of href of bran
    endif
    pin 9 dist $!pdist

    if !onType.eq('ELBO') then
      pin 9 dist -$!insu
    endif
    thro pin 9

    -->>>-wd-----------------------------------------------------------
    -- Create Cold Isolation Block Atta 'AC41'
    new PLAT despar 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm
    -- stext '$!callingForm.name.val'
    -- spkbrk true
    select spref with styp '$!splitStype[2]' spec /MDS
    connect
    handle (7,3)
      fconnect
    endhandle
    sel lstu
    ori pl is d
    name /$!callingForm.name.val$n.2
    !callingForm.support.atta.append(!!ce)
    !!mdsSetDesPars(!!ce)
    !!mdsdaccontrol(true)

    -- Create Lower Breaking Plate 2 Atta 'AC48'
    new PLAT despar 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm
    -- stext '$!callingForm.name.val'
    -- spkbrk true
    select spref with styp '$!splitStype[3]' spec /MDS
    connect
    handle (7,3)
      fconnect
    endhandle
    sel lstu
    ori pl is d
    name /$!callingForm.name.val$n.3
    !callingForm.support.atta.append(!!ce)
    !!mdsSetDesPars(!!ce)
    !!mdsdaccontrol(true)
    --<<<-wd-----------------------------------------------------------

    -- Save Bottom Breaking Plate
    !collar = !!ce

    -- Vent Hole 2 Comment Atta
    new atta select spref with styp 'COMMENT' spec /MDS
    sel lstu
    connect
    handle (7,3)
      fconnect
    endhandle
    if !!mdsTrunNotes.boolean() then
      stex '3mm VENT HOLE.
      SEAL WELD AFTER FABRICATION'
    endif
    atty CCNN
    name /$!callingForm.name.val/NOTE3
    !callingForm.support.atta.append(!!ce)

    -- Free to slide comment atta
    new atta select spref with styp 'COMMENT' spec /MDS
    sel lstu
    connect
    handle (7,3)
      fconnect
    endhandle
    if !!mdsTrunNotes.boolean() then
      stex 'FREE TO SLIDE'
    endif
    atty CCNN
    name /$!callingForm.name.val/NOTE4
    !callingForm.support.atta.append(!!ce)

    -- Trunnion SREF atta
    new atta
    stext '$!callingForm.name.val'
    spkbrk true
    select spref with styp 'TT23' spec /MDS
    sel lstu
    connect
    handle (7,3)
      fconnect
    endhandle
    shop true
    name /$!callingForm.name.val/SREF
    :MDSSuppType 'TT23'
    !callingForm.support.atta.append(!!ce)

    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    -- SET the variable for TRUNNION Bore Size
    -- Baseplate atta/s
    !bore = pa bore
    handle any
      !bore = pa bore of prev
    endhandle
    --!sType = !!mdsParTT23[$!bore].sTypes[!callingForm.bore.val]
    !sType = !mdsTrunObj.sTypes[!callingForm.bore.val]
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------

    !splitStype = !sType.split(',')

    -->>>-wd-----------------------------------------------------------
    -- Create Base Plate 'AC47'
    new PLAT despar 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm 0mm
    -- stext '$!callingForm.name.val'
    !callingForm.support.datum = !!ce
    -- spkbrk true
    select spref with styp '$!splitStype[4]' spec /MDS
    sel lstu
    ori pl is d
    name /$!callingForm.name.val
    !callingForm.support.atta.append(!!ce)
    !!mdsSetDesPars(!!ce)
    !!mdsdaccontrol(true)
    conn
    handle (7,3)
      fconnect
    endhandle
    --<<<-wd-----------------------------------------------------------

    !!mdsdaccontrol(true)
    bran
    tbor (pl bore of last mem)
    same
    conn to pt
    prev
    conn to next
    handle (7,3)
      fconnect to next
    endhandle

    !ce = !!ce
    /$!callingForm.name.val$n.1
    !!mdsGetProp(!callingForm.plength,!callingForm.plength,'PLEN',!bore,'$!splitStype[1]')
    !!mdsGetProp(!callingForm.pwidth,!callingForm.pwidth,'PWID',!bore,'$!splitStype[1]')
    !!mdsGetProp(!callingForm.pThk,!callingForm.pThk,'PTHK',!bore,'$!splitStype[1]')
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --!length = !!mdsParTT23[$!phbore].default
    !length = !mdsTrunObj.deflength
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------

    ---*******************
    -- Adjust the Default Length variable !length to take account of the DISTANCE from the
    -- Main Pipe CL to the P1 Position of the ELBO
    if !onType.eq('ELBO') then
      !!ce    = !element
      !adjust = !!kstrreal('cons dist p0 to plane p1')
      !length = !length + !adjust
      !!ce    = !ce
    endif
    ---*******************
    -- >>>>>>>>>>>>>>>>>>>>>ADJUST TRUNNION LENGTH - THIS is where it GOES WRONG
    ---*******************
    -- Create the array to position the component in the line
    !!mdsSetTrunLen('GADGET',!length,!!ce,'D WRT /*','TT23',!callingForm)
    ---*******************
    -- <<<<<<<<<<<<<<<<<<<<<ADJUST TRUNNION LENGTH - THIS is where it GOES WRONG
    ---*******************
    !!mdsResetPins(9,9)

    -- Set the material and shop flags for all comps except the notes
    !!mdsdaccontrol(true)

    bran
    ispe =0
    !members = mem count
    do !set from 1 to !members
      bran
      $!set
      !!mdssetmatref(!!ce)
      handle any
      endhandle
      ispe =0
    enddo

    !!mdsdaccontrol(true)

    bran
    ---------------------------------------------------------------------------------------------------
    --<wd>apr2006<mds12>
    --    !shop = !!mdsParTT23[$!phbore].shop
    !shop = !mdsTrunObj.shop
    --<wd>apr2006<mds12>
    ---------------------------------------------------------------------------------------------------
    shop $!shop

    do !set from 1 to !members
      bran
      $!set
      shop $!shop
    enddo

    -- Activate/Deactivate gadgets
    !callingForm.tlength.active = true
    !callingForm.setLen.active = true
    !callingForm.bore.active = true
    !callingForm.setLen.active = true
    !callingForm.trunMat.active = TRUE
    !callingForm.rotAtt.active = TRUE
    if !onType.eq('TUBE') then
      !callingForm.bdist.active = true
      !callingForm.dist.active = true
      !callingForm.bthro.active = true
      !callingForm.select.active = true
    endif
    !callingForm.crElbo.active = false
    !callingForm.crTube.active = false
    !callingForm.crRedu.active = false
    !callingForm.crCros.active = false
    !callingForm.zoom.active = true
    !callingForm.ok.active = true
    !callingForm.member.active = true

    -- Initiate the set trunnion length to steel form
    !!mdsSetTrunLen('STEEL',!callingForm.tlength.val,!callingForm.support.datum,'D WRT /*','tt23',!callingForm)

    -- If the collar is 50 or 80 i.e not required set the despars again and form pars
    !!ce = !collar
    !!mdsSetDesPars(!!ce)
    !!mdsdaccontrol(true)
    !!mdsGetProp(!callingForm.plength,!callingForm.plength,'PLEN',!!ce.ppbore[1],'AC47')
    !!mdsGetProp(!callingForm.pwidth,!callingForm.pwidth,'PWID',!!ce.ppbore[1],'AC47')
    !!mdsGetProp(!callingForm.pThk,!callingForm.pThk,'PTHK',!!ce.ppbore[1],'AC47')
    same

    -- Move first weep hole atta
    /$!callingForm.name.val/NOTE2
    dist -100mm from next

    bran
    -- Show the Trunnion Material Form
    !!mdsTrunMat.init(!!mdstt23)

    -- Deactivate MDS DAC control variable
    !!mdsdaccontrol(false)

    -- Reset Units
    !!kRestoreUnits(!currentUnits)

  endif

endfunction
