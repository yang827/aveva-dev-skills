--
--
--
--  Description:  Identify item in exclusive cursor mode.
--
--
--------------------------------------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--    1   R      STRING               Type of item to be identified. Can be multiple types.
--    2   R      STRING               Prompt to be displayed
--
-- Return:
--   [Data Type]          [Description]
--    DBREF               Identified item. Nulref is returned if <escape> pressed.
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsSinglePick(!type is STRING,!prompt is STRING) is DBREF

  prompt off
  prompt load escape '$!prompt'

  !pick = ref of id $!type @
  handle ANY
    !pick = nulref
  endhandle

  prompt on

  return !pick

endfunction
