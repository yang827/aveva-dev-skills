--
-- File:  mdssizeft22.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IPS146
--
-- Author:  D Flannery
-- Created:  25 Feb 04
--
--
-- Description:
-- Function to sort sizes for form ft22
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdssizeft22(!suppType is STRING, !subType is STRING)
  !ce = !!ce
  --!!mdsFT22.size.clear()
  !dtext = ARRAY()
  !rtext = ARRAY()

  if (!suppType eq 'FT22' and !!mdsFT22.type.rtext[!!mdsFT22.type.val] eq 'G' ) then
    -- test for ft22f to set variable height
    !strudesc = desc of /MDS/TEMPLATES
    if (!strudesc eq 'Initec Industrial Templates') then
      !!mdsFT22.height.active = FALSE
    else
      !!mdsFT22.height.active = TRUE
    endif
    -- Navigate to the template and find max height top of plate 1 to bottom plate2

    if (!strudesc eq 'Initec Industrial Templates') then
      !ftype ='G'
      /MDS/FT22/1$!<ftype>-SUBS1
      !maxHeight = 0
    else
      !xCount = !!mdsFT22.size.rtext[!!mdsFT22.size.val]
      !ftype ='G'
      /MDS/FT22/$!<xCount>$!<ftype>-SUBS1
      !maxHeight = !!ce.length
    endif

    if (!suppType eq 'FT22' and !subType eq 'HEIGHT' ) then

      -- <wd>2apr2004 - WHY isn't the MINIMUM HEIGHT CHECKED for TYPE 'F'???
      --                an ATTRIBUTES at the SUBS1 needs to be SET and CHECKED for MINIMUM Height!!!!
      --                NO DIMENSIONAL DETAILS provided for checking the MINIMUM HEIGHT values
      -- <wd>2apr2004

      if (!!mdsFT22.height.val gt $!maxHeight ) then
        !!mdsFT22.height.val = !maxHeight
        $!!mdsFT22.support.stru
        box 2 of subs1
        --<wd>2apr2004 -- In CREATE MODE - BOX2 of SUBS1 Does NOT exist YET!
        handle (2,113)
          -- BOX2 of SUBS1 - NOT Built YET!
          !!alert.error('ERROR: Maximum height allowed is $!maxHeight')
          return
        endhandle
        --<wd>2apr2004

        !dist = !!mdsFT22.height.val
        RULE SET POS DYNAMIC (D ( $!dist - ( 0.5 * ATTRIB ZLEN ) ) FROM PP 3 OF BOX 1 OF SUBSTRUCTURE )
        return error 1 'Max Height for FT22 is "$!maxHeight". Height adjusted'
      else
        $!!mdsFT22.support.stru
        box 2 of subs1
        handle ANY
          -- NOT BUILT YET
          return
        elsehandle NONE
          !dist = !!mdsFT22.height.val
          RULE SET POS DYNAMIC (D ( $!dist - ( 0.5 * ATTRIB ZLEN ) ) FROM PP 3 OF BOX 1 OF SUBSTRUCTURE )
          rule execute all
          return
        endhandle
      endif
    else
      !!mdsFT22.height.val = !maxHeight

    endif

  else
    !!mdsFT22.height.clear()
    !!mdsFT22.height.active = FALSE
  endif

  !current = !!ce
  /MDS/FRAMES/FT22
  handle any
  elsehandle NONE
    var !struColl COLL all STRU for CE
  endhandle
  !!ce = !current

  do !count from 1 TO !struColl.size()
    -- Navigate to template & find sizes
    /MDS/FT22/$!<count>$!<subType>-SUBS1
    handle any
      skip
    endhandle

    !func = func of stru

    BOX1

    !xlen = XLEN
    -- get format
    !!kFormatText.text.val = !xlen
    !xFormat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !xFormat = !xFormat.replace('.00','')

    !ylen = YLEN
    -- get format
    !!kFormatText.text.val = !ylen
    !yFormat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !yFormat = !yFormat.replace('.00','')

    !zlen = ZLEN
    -- get format
    !!kFormatText.text.val = !zlen
    !zFormat = !!kFormatText.text.val.string(!!$!!kFormatText.text.format)
    !zFormat = !zFormat.replace('.00','')

    --    !dtext.append('$!xlen x $!ylen x $!zlen thk.')
    if !func.eq('') then
      !dtext.append(!xFormat & ' x ' & !yFormat & ' x ' &  !zFormat & ' thk.')
    else
      !dtext.append(!xFormat & ' x ' & !yFormat & ' x ' &  !zFormat & ' thk.' + ' ($!func)')
    endif
    !rtext.append(!count.string())

  enddo

  -- set gadgets for current size
  !!mdsFT22.size.clear()
  !!mdsFT22.size.dtext = !dtext
  !!mdsFT22.size.rtext = !rtext


  !!ce = !ce

  -- update supp code on the form
  !!mdsSetSuppCode('SELECT',!!mdsFT22.name.string(),'FT22','XXXXXX')

endfunction
