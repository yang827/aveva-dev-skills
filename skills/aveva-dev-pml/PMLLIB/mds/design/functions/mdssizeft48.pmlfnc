--
-- File:  mdssizeft48.pmlfnc
--   Type:  Function Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  design
--   Replaces:          IPS146
--
-- Author:  D Flannery
-- Created:  25 Feb 04
--
--
-- Description:
-- Function to sort sizes for form FT48
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      'Modify' is passed if the support already exists
--     2     R         STRING      Name of support as a string
--     3     R         STRING      Alias name
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!mdssizeFT48()

  !stru    = !!mdsFT48.support.stru
  !name    = !stru.name

  $!name/SUBS1

  BOX1
  XLEN $!!mdsFT48.dim2.val
  YLEN $!!mdsFT48.dim2.val
  ZLEN $!!mdsFT48.dim3.val

  !!ce = $!<name>/SREF
  !!mdsDacControl(true)
  DESPAR NUM 2 $!!mdsFT48.dim2.val
  DESPAR NUM 3 $!!mdsFT48.dim3.val
  !!mdsDacControl(false)

endfunction
