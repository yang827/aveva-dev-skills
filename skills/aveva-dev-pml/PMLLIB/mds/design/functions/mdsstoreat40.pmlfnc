--
-- Description:
-- Store AT40 form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreat40()

  -- Initialise variables
    !!Mdsat40.Store.clear()

  -- Store original atta despars, orientation
    !!Mdssaveattainf(!!Mdsat40)

  -- Store relavent gadget information
    !!Mdsat40.Store.append(|!!Mdsat40.Dist.val = $!!Mdsat40.Dist.val|)
    !!Mdsat40.Store.append(|Call !!MdsPosDist(!!Mdsat40)|)

  -- Store support object
    !!Mdsat40.Backup = !!Mdsat40.Support

-- End function
endfunction

-- End of file Mdsstoreat40.pml
