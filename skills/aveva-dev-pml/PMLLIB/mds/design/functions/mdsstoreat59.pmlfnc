--
-- File:		mdsstoreat59.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		8th October 2003
--
--
-- Description:
-- Store AT59 form data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!mdsstoreat59()

-- Initialise variables
    !!mdsat59.store.clear()

-- Store original atta despars, orientation
    !!mdssaveattainf(!!mdsat59)

-- Store relavent gadget information
    !!mdsat59.store.append(|!!mdsat59.dist.val = $!!mdsat59.dist.val|)
    !!mdsat59.store.append(|call !!mdsposdist(!!mdsat59)|)

-- Store support object
    !!mdsat59.backup = !!mdsat59.support

-- End function
  endfunction

-- End of file mdsstoreat59.pml
