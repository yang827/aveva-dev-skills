--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsStoreAT60()

  -- Initialise variables
    !!MdsAT60.Store.clear()

  -- Store original atta despars, orientation
    !!Mdssaveattainf(!!MdsAT60)

  -- Store relavent gadget information
    !!MdsAT60.Store.append(|!!MdsAT60.Dist.val = $!!MdsAT60.Dist.val|)
    !!MdsAT60.Store.append(|Call !!MdsPosDist(!!MdsAT60)|)

  -- Store support object
    !!MdsAT60.Backup = !!MdsAT60.Support

-- End function
endfunction

