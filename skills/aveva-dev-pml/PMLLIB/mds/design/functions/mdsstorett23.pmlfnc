--
-- File:		mdsstorett23.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		mds
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Tuesday 18th February 2003
--
--
-- Description:
-- Store form '!!mdstt23' data prior to modification
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!mdsstorett23()

-- Initialise variables
    !!mdstt23.store.clear()

-- Store original atta despars, orientation
    !!mdssaveattainf(!!mdstt23)

-- Store relavent gadget information
    !!mdstt23.store.append(|!!mdstt23.dist.val = $!!mdstt23.dist.val|)
    !!mdstt23.store.append(|call !!mdsposdonly(!!mdstt23)|)
    !!mdstt23.store.append(|!!mdstt23.length.val = $!!mdstt23.length.val|)
    !!mdstt23.store.append(|!!mdstt23.plate.val = $!!mdstt23.plate.val|)
    !!mdstt23.store.append(|!!mdstt23.clear.val = $!!mdstt23.clear.val|)
    !!mdstt23.store.append(|!!mdstt23.material.select('rtext','$!!mdstt23.material')|)
    !!mdstt23.store.append(|!!mdsSetTrnMatl(!!mdstt23,!!mdstt23.support.datum)|)

-- Store support object
    !!mdstt23.backup = !!mdstt23.support

  endfunction
-- End function

-- End of file mdsstorett23.pml
