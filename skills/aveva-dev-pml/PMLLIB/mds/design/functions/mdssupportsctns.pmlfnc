--
-- File: mdssupportsctns.pmlfnc
--   Type: Object Definition
--   Group: Multi Discipline Supports Application
--   Keyword: MDS
--   Module:  DESIGN
--
-- Author: Wayne Dodwell
-- Created: Friday 17th August 2007
--
--
-------------------------------------------------------------------------------
-- Description:
---------------
--
-- Function to STORE all the MDS SCTN elements and any MDS Support SNIPE/FITTING element DATA, for the passed MDS STRUCTURE,
-- in the passed FORM MDSSUPPORT OBJECT member ".mdssctns"
--
-- **********************
-- *** IMPORTANT NOTE ***
-- **********************
-- ALL MDS SNIPES/FITTINGS where the PURPOSE is NOT set to 'XGUI' are NOT REGENERATED via this code as they are:
-- either:
-- "AUTOMATICALLY" created for all MDS 'ANG' SCTN 'ends' associatedwith or connected to an 'ANGLE' type STRUCTURAL element,
-- or:
-- "PRE-DEFINED" on the MDS SCTNS in the relevant MDS FRAMEWORK STANDARD TEMPLATES stored in the SITE element /MDS/TEMPLATES
--
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
define function !!mdssupportsctns(!form is FORM)

-- Initialise Variables
  !stru = !form.support.stru

-- Collect ALL the SCTN elements owned by the MDS STRUCTURE
  !mdssctns = !!kcollectallfor('SCTN','', !stru)

--q var !mdssctns

-- Process and Store each SCTN in a MDSCTN object in the MAIN SUPPORT object ARRAY member !support.mdssctn
  !indx = 0
  !form.support.mdssctns.clear()
  do !sctn values !mdssctns
    skip if !sctn.owne.type.eq('FRMW').or(!sctn.owne.owne.type.eq('FRMW')).not().or(!sctn.isnamed.not())
    !indx = !indx + 1
    !mdssctnobject = object MDSSCTN(!sctn)
    !form.support.mdssctns.append(!mdssctnobject)
--q var !form.support.mdssctns[!indx]
  enddo

-- Update the MDS SUPPORT SCTN and SNIPE STORE Object Member
  !form.support.mdssctnsstore = !form.support.mdssctns

endfunction
