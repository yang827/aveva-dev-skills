--
--  Description:     -- Multi Discipline Supports Application  - MDS/TEMPLATES - Upgrade macro-- for Changing GTYP of all Channel SCTNS from BSC to CHAN-- This a REQUIREMENT for EXTERNAL BOLTED JOINTS so that when using-- OTHER INTERNATIONAL STEELWORK STANDARDS(eg. DIN, AISC, JIS etc.)-- the GTYP of CHAN (for CHANNEL) is used in the MDS JOINT SPEC as a-- SELECTOR rather than BSC, which is peculiar to a BRITISH STANDARD RSC
--
----------------------------------------------------------------------
--
-- Function : MDSTEMPLATESUPG.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
-- Author: Wayne Dodwell
-- Date  : 31 July 2001
--
--
-- Description:
-- Multi Discipline Supports Application  - MDS/TEMPLATES - Upgrade macro
-- for Changing GTYP of all Channel SCTNS from BSC to CHAN
-- This a REQUIREMENT for EXTERNAL BOLTED JOINTS so that when using
-- OTHER INTERNATIONAL STEELWORK STANDARDS(eg. DIN, AISC, JIS etc.)
-- the GTYP of CHAN (for CHANNEL) is used in the MDS JOINT SPEC as a
-- SELECTOR rather than BSC, which is peculiar to a BRITISH STANDARD RSC
--------------------------------------------------------------------------
--
--------------------------------------------------------------------------
--
-- define function
  define function !!mdstemplatesupg()

-- Check if in the PDMS DESIGN Module
    !bann = banner
    if (!bann.name.upcase().neq('PDMS PROFESSIONAL DESIGN')) then
      !!alert.error('This UPGRADE macro for the MDS2.1 ''/MDS/TEMPLATES'' may ONLY be RUN in
PDMS Professional Design.')
      return
    endif

-- Check if the SITE /MDS/TEMPLATES exists, is UNLOCKED and the user has WRITE ACCESS to it
    !mdstemp = '/MDS/TEMPLATES'
    var !mdstempsite exists $!mdstemp SITE UPDATE

    if (!mdstempsite eq 'FALSEA')then
      !!alert.error('The MDS Steelwork Template SITE ''$!mdstemp'' does not exist.')
      return
    elseif (!mdstempsite eq 'FALSEB')then
      !!alert.error('The element''$!mdstemp'' exists but it is not a SITE.')
      return
    elseif (!mdstempsite eq 'FALSEC')then
      !!alert.error('The SITE ''$!mdstemp'' exists but you do not have write access to it.')
      return
    elseif (!mdstempsite eq 'TRUEC')then
      !dbref = !mdstemp.dbref()
      if (!dbref.lock) then
        if (!!alert.confirm('The MDS Steelwork Template SITE ''$!mdstemp'' exists but it is LOCKED. Do you want to UNLOCK it and continue?') eq 'NO') then
          return
        else
          !!ce = !dbref
          !slock = lock
          unlock
          !!sctns = !!KCollectAllFor('SCTN', '((match(gtyp, |BSC|) gt 0) and type of owner eq |FRMW|)', !dbref)
        endif
      else
        !!ce = !dbref
        !slock = lock
        unlock
        !!sctns = !!KCollectAllFor('SCTN', '((match(gtyp, |BSC|) gt 0) and type of owner eq |FRMW|)', !dbref)
      endif
      do !val values !!sctns
        !!ce  = !val
        !xlck = lock
        unlock
        GTYP CHAN
        if (!xlck) then
          lock
        endif
      enddo
    endif

    if (!slock) then
      !!ce = !dbref
      lock
    endif

  endfunction
-- endfunction
