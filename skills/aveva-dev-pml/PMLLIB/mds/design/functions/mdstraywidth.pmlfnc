--
-- File:      mdstraywidth.pmlfnc
-- Type:      PML Function
-- Group:     MDS
-- Keyword:
-- Module:    Design
-- Replaces:
--
-- Author:    Wayne Dodwell
-- Created:   Thursday 11th July 2002
--
--
-- Description:
-- PML Function to calculate Cable Tray Overall Width and the Height from
-- the P0(Origin) to the Underside of the Cable Tray when USING - *** IMPLIED TUBE ***
--
--------------------------------------------------------------------------------

  define function !!mdstraywidth(!atta is DBREF, !unusedTray is DBREF, !height is REAL) is REAL

-- This function should already running in Millimetres from its calling function.

  if !atta.type.eq('CTSUPP') then
    -- there should be some code getting the data (from catalogue props,etc.)
    !width = !!ce.owner.ppbor[2].real()
    return !width
  endif

    if (!!ce.type.eq('BRAN')) then
-- Get the Volume of the Branch HSTU from the Temporary Design Parameters
      head
    endif


  !volume = object VOLUME(ilea tube)
  handle ANY
  endhandle

-- Place Pins at Volume Extremities
    pin 1 at $!volume.from
     handle ANY
     endhandle
    pin 2 at $!volume.to
     handle ANY
     endhandle

-- Navigate to the Atta
   !!ce = !atta

-- Get the P0 direction
    pin 3 copy p0
  --  var !pin3dirstr pin 3 dir wrt /*
  --  !pin3dir = !pin3dirstr.direction()
  --  !pin3opp = !pin3dir.opposite()

-- Place pin 10 at Correct point to calc width
    pin 10 copy p10 of $!atta
    pin 10 plane pin10 thro pin 1

-- Place pin 9  at Correct point to cal width
    pin 9  copy p11 of $!atta
    pin 9 plane pin 9 thro pin 2

-- Calculate the Overall Width of the Cable Tray
    !width  = !!kstrreal('const dist pin 9 to plane pin 10')
-- Calculate the Height from the Cable Tray Origin(P0) to the Underside
-- Assuming the Tray Obstruction Volume will be ABOVE the Tray and the Larger Value
    --!height = !!kstrreal('const dist pin 3 to plane pin 1')
    !pin1pin3hei = !!kstrreal('const dist pin 1 to plane pin 3')
    !pin2pin3hei = !!kstrreal('const dist pin 2 to plane pin 3')
    !height      = (min(!pin1pin3hei,!pin2pin3hei))

--Fix for HPD0031128 (GE 14/02/2006)
  if (not defined(!volume)) then
   !bore  = !!ce.abore
   handle ANY
     !bore = !!ce.ppbor[2]
   endhandle
     !width = !bore.real()
    !height = 0
    endif
     call !!mdsresetpins(1,10)

    return !width

  endfunction
