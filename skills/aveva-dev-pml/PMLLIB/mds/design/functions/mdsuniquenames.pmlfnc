--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]           [Description]
--
-- Return:
--   [Data Type]          [Description]
--
--------------------------------------------------------------------------------------------------------------
define function !!mdsUniqueNames() is BOOLEAN

  !result = false
  !dtse = object DBREF('/MDS/OPTION/DEFAULTS/MDSUNIQUENAMES/DTSE')
  handle NONE
  	!result = !dtse.prop.optn.boolean()
  	handle ANY
  	endhandle
  elsehandle ANY
  endhandle

  return !result

endfunction
