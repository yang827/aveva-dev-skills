--
--
-- Description:
-- function to create a unit vector from a given direction under the coordinate system X=East, Y=North, Z=Up
--
-- Background: this was created to enable the passing of unit vectors to the Licad interface
-- from mdsvendor
--
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!MdsUnitVector(!direction is direction) is ARRAY

  !dir = ARRAY()

  !up = !direction.up
  !east = !direction.east
  !north = !direction.north

  !x = !east
  !y = !north
  !z = !up

  !dir.append(!x.real())
  !dir.append(!y.real())
  !dir.append(!z.real())

  return !dir

endmethod
