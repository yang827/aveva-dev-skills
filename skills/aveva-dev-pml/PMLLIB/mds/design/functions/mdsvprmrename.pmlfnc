--
-------------------------------------------------------------------------------
--
-- File:		mdsvprmrename.pmlobj
--   Type:		Object Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:            DESIGN
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 19th October 2005
--
--
-- Description:
---------------
--
-- Function to Run the ORIGINAL "Apply" button callback array iteration No. [1]
-- on the form !!mdsmodifyname but ONLY for the mode -- 'NAMEONLY'.
-- i.e. ORIGINAL callback[1] was !!mdsmodifyform.applyform[1] = !!mdsmodifyname(1,1,'NAMEONLY')
--
-- This function replaces the ORIGINAL callback[1], shown above, to enable the MDS VPRM MTO "DELETE" and "RENAME"
-- Records to be written to a file and AUTOMATICALLY LOADED into VPRM when VPRM is being used on the PDMS Project
--
-------------------------------------------------------------------------------
-- Define Function
define function !!mdsvprmrename(!index is REAL,!numb is REAL,!mode is STRING)

-- Ensure the Callback to !!mdsmodifyname.ok, i.e. the form array members .applyform[2] and {3] are reset correctly
  !!mdsmodifyname.applyform[2] = |!!mdsmodifyname.name.val = 'unset'|
  !!mdsmodifyname.applyform[3] = |!!Mdsmodifyname.newname.val = 'unset'|

---------------------------------------------------------------------------------------------------
-- ONLY run the MDS VPRM MTO "DELETE" CODE below if VPRM is being used on the PDMS Project
---------------------------------------------------------------------------------------------------
--
-- Get the ORIGINAL NAME of the MDS SUPPORT from -- !!mdsmodifyname.name.val
  !ceorig  = !!ce
  !oldnamn = !!mdsmodifyname.name.val
  !oldname = '/' & !!mdsmodifyname.name.val
-- Get the DBREF of the Support to be DELETED in VPRM, but RENAMED in PDMS
  !support = !oldname.dbref()
  !!ce     = !oldname.dbref()

-- Check if VPRM is being used on the current PDMS Project
  !mdstype     = !!mdsabatype(!support)
  !vprmprocess = FALSE

---------------------------------------------------------------------------------------------------
------------------------
-- MDS GROUP SUPPORTS --
-- RENAMING Options etc.
---------------------------------
-- OPTIONS --<a>, <b>, <c> or <d>
---------------------------------
-- <a> -- "RENAMING" the MASTER GROUP STRUCTURE SUPPORT, e.g. <mdsgroupname>[1] ONLY
--        ONLY generate a MDS VPRM "DELETE" MTO record when RENAMING the MASTER SUPPORT <mdsgroupname>[1].
--        ALL OTHER GROUP SUPPORT Members that exist will ALSO be RENAMED.
--        i.e. "RESTRAINTS :- <mdsgroupname>[2] and/or <mdsgroupname>[3] etc...
--        Also GENERATE the COMPLETE MDS VPRM "RENAME" MTO records for ALL of the GROUP MEMBERS,
--        i.e. The MASTER GROUP SUPPORT <mdsgroupname>[1] plus ALL OTHER GROUP SUPPORT Members,
--        e.g. <mdsgroupname>[2] plus <mdsgroupname>[3] etc...
--
-- <b> -- "ADD" an existing MDS SUPPORT to an EXISTING MDS SUPPORT GROUP
--        ONLY generate a MDS VPRM "DELETE" MTO record of the ORIGINAL MDS SUPPORT
--        when RENAMING a MDS GROUP SUPPORT MEMBER, i.e. a "RESTRAINT"
--        e.g. <mdsgroupname>[2] or <mdsgroupname>[3] etc...
--
-- <c> -- "REMOVE" an existing MDS SUPPORT from an EXISTING MDS SUPPORT GROUP
--        -- NO ACTION REQUIRED --
--        DO NOT generate a MDS VPRM "DELETE" MTO record of the ORIGINAL MDS SUPPORT
--
-- <d> -- "RENAMING" a MDS GROUP SUPPORT MEMBER, i.e. NOT the MASTER GROUP SUPPORT "[1]"
--        -- NO ACTION REQUIRED --
--        When RENAMING a MDS SUPPORT GROUP MEMBER, other than the MASTER GROUP SUPPORT "[1]"
--        i.e. a "RESTRAINT",
--        e.g. <mdsgroupname>[2] or <mdsgroupname>[3] etc...
---------------------------------------------------------------------------------------------------
--
-- Get the NEW NAME of the MDS Support being RENAMED
  !newsuppname = !!mdsmodifyname.newname.val
  if (!newsuppname.match('/').eq(1) ) then
    !mdsname = '/' & !newsuppname
  else
    !mdsname = !newsuppname
  endif
  !renameok = TRUE
---------------------------------------------------------------------------------------------------
-- Check when the EXISTING NAME is a MDS MASTER GROUP SUPPORT, e.g. "<oldname>[1]",
-- that the NEW NAME is also a MDS MASTER GROUP SUPPORT,  e.g. "<newname>[1]".
--
-- However when the EXISTING NAME "<oldname>[1]" does NOT have ANY OTHER GROUP MEMBERS,
-- The NEW NAME of the EXISTING MDS MASTER GROUP SUPPORT, "<oldname>[1]",
-- DOES NOT HAVE to be a MDS GROUP NAME, i.e. "<oldname>[1]" can be changed to just "<newname>"
--
  if (!oldname.matchwild('*[1]'))then
-- The EXISTING MDS SUPPORT is the MASTER MDS GROUP Support - Check for OTHER MDS GROUP MEMBERS
    !groupname = !oldname.before('[1]')
    do !indx from 2 to 21
      !testname = !groupname & '[$!indx]'
      !testdbrf = !testname.dbref()
      handle(2,109)
-- Undefined DBREF name -- !testname.dbref()
        if (!indx.eq(21)) then
-- OTHER MDS GROUP members DO NOT exist
-- Allow the EXISTING MDS GROUP "<oldname>[1]" to be RENAMED to a NON MDS GROUP name , e.g. "<newname>"
          !renameok = TRUE
        else
          skip
        endif
      elsehandle NONE
-- The EXISTING SUPPORT has other GROUP MEMBERS, e.g. !<oldname>[2] etc...
-- ONLY allow the EXISTING MDS GROUP "<oldname>[1]" to be RENAMED to a NEW MDS GROUP name, e.g. "<newname>[1]"
        if (!newsuppname.matchwild('*[1]')) then
          !renameok = TRUE
        else
          !error = 'The EXISTING support contains GROUP members. Therefore the suffix [1], MUST be appended to the NEW NAME.'
          !renameok = FALSE
        endif
-- BREAK to maintain the value of the variable !renameok
        break
      endhandle
    enddo

  elseif (!oldname.matchwild('*[*]')) and (!newsuppname.matchwild('*[*]').not())then
-- RENAME a MDS GROUP MEMBER but NOT No.[1] to a NON MDS GROUP Support,
-- e.g. REMOVE an EXISTING Support from a MDS GROUP
    !renameok = TRUE

  elseif (!oldname.matchwild('*[*]').not()) and (!newsuppname.matchwild('*[*]'))then
-- RENAME a MDS GROUP MEMBER but NOT No.[1] e.g. ADD an EXISTING Support to a MDS GROUP
    !renameok = TRUE

  endif

-- ABORT the RENAMING Process if necessary
  if (!renameok.not()) then
    !!alert.error(!error)
    !!mdsmodifyname.applyform[2] = |!!mdsmodifyname.name.val    = '$!oldnamn'|
    !!mdsmodifyname.applyform[3] = |!!mdsmodifyname.newname.val = '$!newsuppname'|
    return
  endif


-- ONLY Generate a MDS VPRM "DELETE" and/or "RENAME" MTO File when the variables
-- are SET as DEFAULT -- Write the MDS VPRM "DELETE" and "RENAME" records File
-- The DEFAULT Settings for MDS SUPPORTS ***NOT*** belonging to a MDS GROUP are:-
  !vprmfilegen  = TRUE
  !groupmember  = FALSE
--
-- OR when a MDS SUPPORT is being "ADDED" to an existing MDS GROUP
-- i.e.!vprmfilegen  = TRUE and !groupmember  = TRUE -- <see below>
-- Option <b> -- ONLY Write the MDS VPRM "DELETE" records to File,
-- ***DO NOT*** write the "MDS VPRM "RENAME" MTO records to File
--
-- Check if the MDS SUPPORT is about to be "RENAMED belongs to" or
-- "is being ADDED to" or "is being REMOVED from" a MDS GROUP
  !renameaction = !!mdsmodifyname.addremgroup.trim()

  if (!mdsname.matchwild('*[*]')) then
-- The MDS SUPPORT belongs to a MDS GROUP Support
    if (!mdsname.matchwild('*[1]')) then
-- Option <a> --
-- RENAMING the MASTER GROUP SUPPORT [1], DEFAULT Settings Apply,
-- so "RENAME" ALL other MDS Supports belonging to the ORIGINAL MDS GROUP
-- Write the MDS VPRM "DELETE" and "RENAME" records File
      !vprmfilegen  = TRUE
      !groupmember  = FALSE

    else
-- Check the RENAME action for the MDS SUPPORT
      if (!renameaction.eq('ADD')) then
-- Option <b> --
-- "ADD" an existing MDS SUPPORT to an EXISTING MDS SUPPORT GROUP
-- ONLY Write the MDS VPRM "DELETE" records to File ,
        !vprmfilegen  = TRUE
        !groupmember  = TRUE

      else
-- Option <d> --
-- "RENAMING" a MDS GROUP SUPPORT MEMBER, i.e. NOT the MASTER GROUP SUPPORT "[1]"
-- !renameaction = '' or is the default -- unset
-- NO ACTION REQUIRED --
-- ***DO NOT*** write the "MDS VPRM "DELETE or the "RENAME" MTO records to File
        !vprmfilegen  = FALSE
        !groupmember  = TRUE

      endif
    endif

  elseif (!oldname.matchwild('*[*]')) then
-- The MDS SUPPORT belongs to a MDS GROUP Support,
-- but is NOT the MASTER GROUP SUPPORT, i.e. <mdsgroupname>[1]
    if (!oldname.matchwild('*[1]').not()) then
      if (!renameaction.eq('REMOVE')) then
-- Option <c> --
-- "REMOVE" an existing MDS SUPPORT from an EXISTING MDS SUPPORT GROUP
-- NO ACTION REQUIRED --
-- ***DO NOT*** write the "MDS VPRM "DELETE or the "RENAME" MTO records to File
        !vprmfilegen  = FALSE
        !groupmember  = TRUE

      endif
    endif

  endif


--<GE> 06-08-06 HPD0033412 The VPRM Code only needs to be executed for a Framatome Project
-- This is ONLY!!!!! a temporary fix for other customers that have the Gateway loaded
 if (desc of /MDS/TEMPLATES eq 'Framatome Templates') then
-- <GE> 07-08-06 added check for VPRM discipline as set in the Gateway config file
-- Project Code & Session data
   !proj    = current project
   !code    = !proj.code()
   !projlow = !code.lowcase()
   !projup  = !code
   !projdir = object file ('%$!<projlow>iso%')

-- Read the VPRM Gateway Config File into a "VPRMCONFIG" OBJECT
   !vprmfilegen  = FALSE
   if (defined(!!vprmexists)) then
     if !!vprmexists then
       !projcfg = object file ('$!projdir/pdsc01.cfg')
       !vprmcfile = object vprmconfig()
       !vprmcfile.read(!projcfg)
       !type = !!mdsabatype($!support)
       if !type.eq('FRAME') then
         !mdsdatumname = !support.name & '/DATUM'
         !mdsdatumdbrf = !mdsdatumname.dbref()
         if (!mdsdatumdbrf.owner.pspe.purp.upcase().eq('HVAC')) then
           if !vprmcfile.mdshvacdelrename then
             !vprmfilegen  = TRUE
--    $P HVAC Framework
           endif
         elseif (!mdsdatumdbrf.owner.pspe.purp.upcase().eq('TRAY')) then
           if !vprmcfile.mdselecdelrename then
             !vprmfilegen  = TRUE
--    $P TRAY Framework
           endif
         elseif (!mdsdatumdbrf.owner.pspe.purp.upcase().eq('PIPE')) then
           if !vprmcfile.mdspipedelrename then
             !vprmfilegen  = TRUE
--    $P PIPE Framework
           endif
         endif
       else
         if !vprmcfile.mdspipedelrename then
           !vprmfilegen  = TRUE
--    $P PIPE
         endif
       endif
     endif
   endif

--   q var !vprmcfile.mdshvacdelrename
--   q var !vprmcfile.mdspipedelrename
--   q var !vprmcfile.mdselecdelrename

-- <GE> 07-08-06

---------------------------------------------------------------------------------------------------
-- FIRST -- Check if it is OK to GENERATE the MDS VPRM "DELETE" MTO records
---------------------------------------------------------------------------------------------------
  if ((!vprmfilegen) and (!groupmember.not()))  or ((!vprmfilegen) and (!groupmember)) then
--------------------------------------------------
-- *** ONLY *** Options <a> & <b> *** Applies Here
--------------------------------------------------

-- ***********************************************************************************************************
-- *** MDS VPRM MTO "DELETE" DATA to BE COLLECTED ***BEFORE*** the MDS SUPPORT is actually RENAMED in PDMS ***
-- ***********************************************************************************************************
--
-- CHECK if VPRM is ACCESSIBLE and being used on the Current PDMS Project for the AUTOMATIC VPRM UPDATE.
-- ONLY need to set up the VPRM object if VPRM is being used on the PDMS Project
--
-- IGNORE any TRUNNION type MDS supports, as they are NOT PASSED to VPRM via the MDS VPRM Interface
    if (!mdstype.neq('TRUNNION')) then

-- ************************************************************************************************
--<wd>jan2006
-- **********************
-- *** IMPORTANT NOTE ***
-- **********************
-- FRAMATOME<Wolfgang Umnig> & AVEVA<Neale Morris> -- Telecon Monday 21jan2006
-- FRAMATOME request a TEMPORARY SOLUTION ONLY for
-- MDS HVAC DUCTING and MDS ELECTRICAL TRAY FRAMEWORK Supports
-- *** DO NOT *** CREATE and/or AUTOMATICALLY TRANSFER a
-- MDS VPRM MTO file to the VPRM Project TRANSFER
-- DATABASE for MDS HVAC and TRAY FRAMEWORK Supports
--
-- i.e. TEMPORARILY IGNORE and DO NOT PROCESS a MDS VPRM MTO "DELETE or "RENAME"
--      FOR any MDS HVAC and MDS TRAY -- STRUCTURE Supports --
--
---------------------------------------------------------------------
-- *** DO NOT PROCESS *** a MDS VPRM MTO file if the !!mdstype = FRAME
-- and the SUPPORT type is a MDS HVAC or TRAY FRAMEWORK Support
---------------------------------------------------------------------
--
-- Determine the PURPOSE of the MDS ATTA's OWNING BRANCH PSPE
      if (!mdstype.eq(|FRAME|)) then
-- Get the MDS DATUM ATTA set for utilising the MDS DESIGN Application
        !mdsdatumnam = !support.name & '/DATUM'
      elseif (!mdstype inset ('HANGER', 'ANCILL')) then
-- Get the MDS DATUM ATTA set for utilising the MDS DESIGN Application
        !mdsdatumnam = !support.name
      endif
-- Get the PURPOSE of the PSPE of the OWNER of the DATUM SUPPORT ATTA, i.e. the BRANCH
      !mdsdatumdbf = !mdsdatumnam.dbref()
      !mdsdatumown = !mdsdatumdbf.owner.pspe.purp

-- Only Process MDS STRUCTURE, HANGER and ATTA-<Stand-Alone> Supports
--      if (!mdstype inset ('FRAME', 'HANGER', 'ANCILL')) then
--
---------------------------------------------------------------------------------------------------
-- ONLY Process the MDS STRUCTURE for PIPE SUPPORTS, MDS HANGER and MDS ATTA<Stand-Alone> Supports
---------------------------------------------------------------------------------------------------
-- *** DO NOT *** Create or Process a MDS VPRM MTO file
-- for any MDS HVAC or MDS TRAY STRUCTUTE SUPPORTS
--<GE>Aug06      if ((!mdstype.eq(|FRAME|)) and (!mdsdatumown.eq(|PIPE|)) or (!mdstype inset ('HANGER', 'ANCILL'))) then
      if (!mdstype.eq(|FRAME|) or (!mdstype inset ('HANGER', 'ANCILL'))) then
---------------------------------------------------------------------
--<wd>jan2006
-- ************************************************************************************************


-- When the VPRM FILE "%PDMSEXE%\pdsc01.exe" EXISTS on ENTRY to PDMS,
-- the global variable !!VPRMEXISTS = TRUE is set via the PDMS ENTRY login file,
-- ...\PDMS-VPRM4.2\pdmsui\MON\ADMIN\LOGIN
        if (defined(!!vprmexists)) then
          if (!!vprmexists) then
            !vprmprocess = TRUE
-- Check, Populate and Store the "MDS VPRM MTO" objects of the MDS SUPPORT about to be DELETED.
-- <The objects are MDSVPRMMTO, MDSVPRMOBJECT and MDSVPRMDELETE>
            !supparr     = ARRAY()
            !newsuppname = !!mdsmodifyname.newname.val
            !supparr.append(!support)
-- 'DELETE' is Passed as the option here, as MDS VPRM MTO needs to GENERATE a VPRM "DELETE" Record
-- for the ORIGINAL MDS SUPPORT being "RENAMED" in this PML function.
            !mdsvprmdelsupp = object mdsvprmdelete(!supparr, 'DELETE', !mdstype, !newsuppname)
-- Temporary Global variable used for INTERROGATION during DEVELOPMEMT etc... ONLY
            !!mdsd.delete()
            handle ANY
            endhandle
            !!mdsd = !mdsvprmdelsupp
          endif
        endif

      elseif (!mdstype.eq('ERROR')) then
-- MDS SUPPORT TYPE is NOT Valid. Therefore MDS VPRM MTO file is NOT to be GENERATED
        !vprmprocess = FALSE

       endif
     endif
   endif
 endif
--<GE> 06-08-06 HPD0033412
---------------------------------------------------------------------------------------------------
-- ONLY run the MDS VPRM MTO "DELETE" CODE above if VPRM is being used on the PDMS Project
---------------------------------------------------------------------------------------------------



---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
-- **********************
-- *** IMPORTANT NOTE ***
-- **********************
-- This is the ONLY CODE that needs running when VPRM is NOT being used on the PDMS Project,
-- or under certain conditions, the MDS Support "belongs to" -or-
-- "is being ADDED to" -or- "is being REMOVED from" a MDS GROUP Support
---------------------------------------------------------------------------------------------------
-- Run the ORIGINAL "Apply" button callback array iteration No. [1]
--
-- i.e. !!mdsmodifyname(1,1,'NAMEONLY')
--
  !!mdsmodifyname(!index,!numb,!mode)
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------





---------------------------------------------------------------------------------------------------
-- ONLY run the MDS VPRM MTO "RENAME" CODE below if VPRM is being used on the PDMS Project
---------------------------------------------------------------------------------------------------
--
---------------------------------------------------------------------------------------------------
-- Populate the Object member !mdsvprmdelsupp.vprmrecords with
-- the MDS VPRM MTO FILE DATA for the "RENAMED" MDS Support or
-- the MDS VPRM MTO FILE DATA for the "DELETED" MDS Support
---------------------------------------------------------------------------------------------------
--
---------------------------------------------------------------------------------------------------
-- SECOND -- Check if it is OK to GENERATE a MDS VPRM "DELETE" and "RENAME" MTO records to file
---------------------------------------------------------------------------------------------------
  if ((!vprmfilegen) and (!groupmember.not())) then
--------------------------------------------------------
-- *** ONLY *** Option <a> *** Applies Here!!! ***
-- RENAMING the MASTER GROUP SUPPORT member No.[1]
-- Automatically RENAMES ALL OTHER GROUP SUPPORT MEMBERS
--------------------------------------------------------

-- IGNORE any TRUNNION type MDS supports, as they are NOT PASSED to VPRM via the MDS VPRM Interface
    if (!mdstype.neq('TRUNNION')) then
      if (!vprmprocess) then

-- Check, Populate and Store the "MDS VPRM MTO" objects of the MDS SUPPORT about to be DELETED.
-- <The objects are MDSVPRMMTO, MDSVPRMOBJECT and MDSVPRMDELETE>
-- Get the DBREF of the Support to be DELETED in VPRM, but RENAMED in PDMS
        if (!newsuppname.match('/').eq(1)) then
          !rensupp = !newsuppname.dbref()
        else
          !newname = '/' & !newsuppname
          !rensupp = !newname.dbref()
        endif

        !!ce      = !rensupp
        !supplist = ARRAY()
        !supplist.append(!rensupp)
        !mdsvprmrename = object mdsvprmdelete(!supplist, 'RENAME', !mdstype, !newsuppname)
-- Temporary Global variable used for INTERROGATION during DEVELOPMEMT etc... ONLY
        !!mdsr.delete()
        handle ANY
        endhandle
        !!mdsr = !mdsvprmrename

---------------------------------------------------------------------------------------------------

-- *******************************************************************************
-- Write and AUTOMATICALLY LOAD into VPRM -- the MDS VPRM MTO "RENAME" Output File
-- *******************************************************************************
--
-- MDS VPRM MTO files are about to be GENERATED and "AUTOMATICALLY LOADED" into the VPRM Database
-- So SAVEWORK in the PDMS Database to UPDATE and reflect that the MDS SUPPORT has been DELETED
        savework

-- CHECK if VPRM is ACCESSIBLE etc... for the Automatic UPDATE
        !vprmerr  = ARRAY()
        !mdsnamn  = !mdsvprmrename.mdsvprmmto[1].suppname
        !vprmtest = !mdsvprmrename.vprmdbtest(!vprmerr, !mdsnamn)
        if (!vprmtest.not()) then
-- Append ERRORS to the Beginning of the ARRAY !mdsvprmrename.errarr
          !mdsvprmrename.errarray.insertarray(1, !vprmerr)
          !alertuser = !vprmerr[2] & !vprmerr[3]
        endif

-- In ALL Cases -- Write the MDS VPRM MTO "DELETE" File and the MDS VPRM LOG File
-- Pass the OPTION "RENAME" and the ORIGINAL PML "DELETE" Object created above for the
-- ORIGINAL MDS Support RENAMED above and represented by "DELETE" Record in the !mdsvprmdelsupp object
        !mdsvprmrename.vprmfiles('RENAME',!mdsvprmdelsupp)

-- Check if the VPRM System is AVAILABLE etc...
        if (!vprmtest.not()) then
-- Alert User that the VPRM System is NOT AVAILABLE for whatever reason!
         !!alert.error(!alertuser)

        else
-- !vprmtest = TRUE
-- This means that the VPRM DB is AVAILABLE  for AUTOMATIC LOADING of MDS VPRM MTO Files
-- Perform the Automatic UPDATE of the VPRM Database with the MDS VPRM MTO file of the DELETED MDS Support
          !pdsc02exeobj = object file('%pdmsexe%/pdsc02.exe')
          !pdsc02exefil = !pdsc02exeobj.fullname()
-- Load the MDS VPRM MTO "$!mdsvprmrename.option" file into VPRM
--          syscom '$!pdsc02exeobj $!mdsvprmrename.mtofile'
          syscom '$!pdsc02exefil $!mdsvprmrename.mtofile'


-- Echo Messages to the PDMS Windows Shell
          syscom 'echo MESSAGE -- VPRM DB AUTOMATIC LOADING of MDS SUPPORT MTO "$!mdsvprmrename.option" file:'
          syscom 'echo MESSAGE -- $!mdsvprmrename.mtofile'

        endif

      else
---------------------------------------------------------------------
-- The VPRM System is NOT Available -- The Project is NOT using VPRM
-- Therefore there is NOTHING TO DO
---------------------------------------------------------------------
      endif
    endif


-- Check if ONLY a MDS VPRM "DELETE" MTO records file is needs to be GENERATED
  elseif ((!vprmfilegen) and (!groupmember)) then
---------------------------------------------------------------
-- *** ONLY *** Option <b> *** Applies Here!!! ***
-- ADD an EXISTING MDS SUPPORT to an EXISTING MDS GROUP SUPPORT
---------------------------------------------------------------

-- *******************************************************************************
-- Write and AUTOMATICALLY LOAD into VPRM -- the MDS VPRM MTO "DELETE" Output File
-- *******************************************************************************
--
-- IGNORE any TRUNNION type MDS supports, as they are NOT PASSED to VPRM via the MDS VPRM Interface
    if (!mdstype.neq('TRUNNION')) then
      if (!vprmprocess) then
-- MDS VPRM MTO files are about to be GENERATED and "AUTOMATICALLY LOADED" into the VPRM Database
-- So SAVEWORK in PDMS Database to UPDATE to reflect that the MDS SUPPORT has been DELETED
        savework

-- CHECK if VPRM is ACCESSIBLE etc... for the Automatic UPDATE
        !vprmerr  = ARRAY()
        !mdsnamn  = !mdsvprmdelsupp.mdsvprmmto[1].suppname
        !vprmtest = !mdsvprmdelsupp.vprmdbtest(!vprmerr, !mdsnamn)
        if (!vprmtest.not()) then
-- Append ERRORS to the Beginning of the ARRAY !mdsvprmdelsupp.errarr
          !mdsvprmdelsupp.errarray.insertarray(1, !vprmerr)
          !alertuser = !vprmerr[2] & !vprmerr[3]
        endif

-- In ALL Cases -- Write the MDS VPRM MTO "DELETE" File and the MDS VPRM LOG File
        !mdsvprmdelsupp.vprmfiles('DELETE', !mdsvprmdelsupp)

-- Check if the VPRM System is AVAILABLE etc...
        if (!vprmtest.not()) then
-- Alert User that the VPRM System is NOT AVAILABLE for whatever reason!
          !!alert.error(!alertuser)

        else
-- !vprmtest = TRUE
-- This means that the VPRM DB is AVAILABLE  for AUTOMATIC LOADING of MDS VPRM MTO Files
-- Perform the Automatic UPDATE of the VPRM Database with the MDS VPRM MTO file of the DELETED MDS Support
          !pdsc02exeobj = object file('%pdmsexe%/pdsc02.exe')
          !pdsc02exefil = !pdsc02exeobj.fullname()
-- Load the MDS VPRM MTO "$!mdsvprmdelsupp.option" file into VPRM
          --syscom '$!pdsc02exeobj $!mdsvprmdelsupp.mtofile'
          syscom '$!pdsc02exefil $!mdsvprmdelsupp.mtofile'

-- Echo Messages to the PDMS Windows Shell
          syscom 'echo MESSAGE -- VPRM DB AUTOMATIC LOADING of MDS SUPPORT MTO "$!mdsvprmdelsupp.option" file:'
          syscom 'echo MESSAGE -- $!mdsvprmdelsupp.mtofile'

        endif

      else
---------------------------------------------------------------------
-- The VPRM System is NOT Available -- The Project is NOT using VPRM
-- Therefore there is NOTHING TO DO
-------------------------------------------------------------------
      endif
    endif

  endif

-- Navigate back to the ORIGINAL PDMS element
  !!ce = !ceorig

-- Ensure the Callback to !!mdsmodifyname.ok, i.e. the form array member .applyform is reset correctly
  !!mdsmodifyname.applyform[1] = |!!mdsvprmrename(1,1,'NAMEONLY')|
  !!mdsmodifyname.applyform[2] = |!!mdsmodifyname.name.val = 'unset'|
  !!mdsmodifyname.applyform[3] = |!!Mdsmodifyname.newname.val = 'unset'|
-- RESET to Default Setting
  !!mdsmodifyname.addremgroup = ''

endfunction
