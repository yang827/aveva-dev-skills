--------------------------------------------------------------------------------
--
-- File:		MdsRemoveGrad.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		design
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 29th September 2004
--
--
-- Description:
-- -- Function to Get the ORTHOGONAL Directions of a Piping Component
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         DBREF of the Piping Component
--
-- Return:
--    [Data Type]   [Description]
--     ARRAY         [1] ORTHOGONAL Pleave Direction Object of the Piping Component, e.g.MDS Support Datum Atta
--                   [2] ORTHOGONAL Opposite Direction Object to PLeave of the Piping Component, e.g.MDS Support Datum Atta
--
--                   [3] ORTHOGONAL PPoint[9] Direction Object of the Piping Component, e.g.MDS Support Datum Atta
--                   [4] ORTHOGONAL Opposite Direction Object to PPoint[9] of the Piping Component, e.g.MDS Support Datum Atta
--
--                   [5] ORTHOGONAL PPoint[10] Direction Object of the Piping Component, e.g.MDS Support Datum Atta
--                   [6] ORTHOGONAL PPoint[11] Oppposite Direction Object to PPoint[10] of the Piping Component, e.g.MDS Support Datum Atta
--
--------------------------------------------------------------------------------

-- Define Function
  define function !!tmtestgrad(!atta is DBREF) is ARRAY

-- Initialise Variables
    !directions = ARRAY()
    !origin     = !!ce
    !direction  = object direction()

-- Check that the Passed DBREF Element is a Piping Component
    if (!atta.owner.type.neq('BRAN')) then
      !!alert.error('The passed element must be a PDMS Piping Component')
      return !directions
    endif

-- Save EXISTING DATA for 3 PINS before re-using the 3 Pins, Pin1 to Pin3 inclusive.
    !pinarray[1] = 1
    !pinarray[2] = 2
    !pinarray[3] = 3
    !!mdspindata('SAVE',!pinarray)

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Generate the Pleave and Parrive Orthogonal Directions of the Piping Component
-------------------------------------------------------------------------------
    !pvectorpl           = object pointvector()
    !pvectorpl.position  = !atta.pos.wrt(world)
    !pvectorpl.direction = !atta.ldir.wrt(world)

-- Create a LINE Object
    !linepl = !pvectorpl.line(100)

-- Create a PLANE Object
    !planepl          = object plane()
    !planepl.position = !atta.pos.wrt(world)

-- Determine if Pipe is either predominantly VERTICAL or HORIZONTAL
    !attapldir = !pvectorpl.direction
    if (!attapldir.up.abs().eq(1)) then
-- Vertical Pipe
      !planepl.orientation = Y is U wrt /* and Z is N wrt /*
    else
-- Horizontal or a Sloping Horizontal Pipe
      !planepl.orientation = Y is N wrt /* and Z is U wrt /*
    endif

-- Create a NEW LINE Object Projected onto the PLANE Object to Determine
-- the DATUM Atta ORTHOGONAL PLeave Direction and the Opposite Direction
    !projline    = !linepl.projected(!planepl)
    !directionpl = !projline.direction()
    !oppositepl  = !directionpl.opposite()

-- Populate the !directions array with the ORTHOGONAL PLeave[1] and PArrive[2] Directions
    !directions[1] = !directionpl
    !directions[2] = !oppositepl

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Determine the DATUM Atta ORTHOGONAL PPoint[9] Direction and the Opposite Direction
-- Assume for Horizontal and Sloping Horizontal Pipes that the PPiont[9] is = D wrt /*
-------------------------------------------------------------------------------

-- Position Pins to Calculate the ORTHOGONAL PPoint[9] Direction and the Opposite PPoint[9] Direction
    pin 1 at $!atta
    !attap9dir = !atta.pdir[9].wrt(/* )

    if (!attapldir.up.abs().eq(1)) then
-- Vertical Pipes Only
----------------------

-- The ATTA Pleave Direction is a TRUE ORTHOGONAL direction
-- either U or D wrt /*
-- Set the "ORTHOGONAL" PPoint[10] and Opposite Direction Variables to their Actual values
      !directionp9 = !attap9dir
      !oppositep9  = !attap9dir.opposite()

    elseif (!attapldir.up.eq(0)) then
-- Non-Sloping Horizontal Pipes Only
------------------------------------

-- The ATTA Pleave Direction is a TRUE ORTHOGONAL direction
-- E, N, W or S wrt /*, or E 45 N wrt /* etc...
-- Set the "ORTHOGONAL" PPoint[9] and Opposite Direction Variables to their Actual values
      !directionp9 = !attap9dir
      !oppositep9  = !attap9dir.opposite()

    else

-- Sloping Horizontal Pipes Only
--------------------------------

-- Split into an array the Calculated ORTHOGONAL Pleave Direction
      !splitpldir = !directions[1].string().split()
-- Redirect and Plane Pin 3 thro P9 of !atta
      if (!splitpldir.size().eq(3)) then
-----------------------------------
-- Pleave Direction is a TRUE ORTHOGONAL direction - East, North, West or South WRT /* -: e.g. N WRT /*
        if (!splitpldir[1].eq('E')) then
          !pin1dir = E (90) D wrt /*
          !pin3dir = E (90) N wrt /*
        elseif (!splitpldir[1].eq('N')) then
          !pin1dir = N (90) D wrt /*
          !pin3dir = N (90) W wrt /*
        elseif (!splitpldir[1].eq('W')) then
          !pin1dir = W (90) D wrt /*
          !pin3dir = W (90) S wrt /*
        elseif (!splitpldir[1].eq('S')) then
          !pin1dir = S (90) D wrt /*
          !pin3dir = S (90) W wrt /*
        endif

-- Position and Direct Pins 1, 2 and 3
        pin 1 dir $!pin1dir
        pin 2 copy pin 1
-- Plane Pin 2 thro P9 of !atta
        pin 2 plane pin 2 thro p9 of $!atta
        pin 3 copy pin 2
        pin 3 dir $!pin3dir

      else
-- Pleave Direction is a NOT TRUE ORTHOGONAL direction -: e.g. E 45 N WRT
        if (!attap9dir.up.eq(0)) then
          !pin1dir = $!splitpldir[1] ($!splitpldir[2] + 90) $!splitpldir[3] wrt /*
          !pin3dir = !attap9dir.opposite()

        elseif (!attap9dir.up.lt(0)) then
          !pin1dir = $!splitpldir[1] $!splitpldir[2] $!splitpldir[3] 90 D wrt /*
          !pin3dir = $!splitpldir[1] ($!splitpldir[2] + 90) $!splitpldir[3] wrt /*

        elseif (!attap9dir.up.gt(0)) then
          !pin1dir = $!splitpldir[1] $!splitpldir[2] $!splitpldir[3] 90 U wrt /*
          !pin3dir = $!splitpldir[1] ($!splitpldir[2] + 90) $!splitpldir[3] wrt /*

        endif
      endif


-- Setup Pin Positions and Directions
-- Pin 1
      pin 1 dir $!pin1dir
-- Pin 2
      pin 2 copy pin 1
      pin 2 plane pin 2 thro p9 of $!atta
      pin 2 dir $!pin3dir
-- Pin 3
      pin 3 copy pin 2
      pin 3 plane pin 3 thro p9 of $!atta
      pin 3 direct tow pin 1
-- Determine "ORTHOGONAL" PPoint[9] and Opposite Directions
      var !p9oppdir pin 3 dir wrt /*
      !oppositep9  = !p9oppdir.direction()
      !directionp9 = !oppositep9.opposite()

    endif

-- Populate the !directions array with the ORTHOGONAL PPoint[9] and Opposite PPoint[9] Directions
    !directions[3] = !directionp9
    !directions[4] = !oppositep9



      -- see what the cross product of p9 and pl is
      !newdir = !attap9dir.cross( !directionpl)
      q var !newdir
      q p10 p11


      !directions[5] = !newdir.opposite()
      !directions[6] = !newdir

      return !directions

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Determine the DATUM Atta ORTHOGONAL PPoint[10] Direction and the Opposite Direction, i.e. PPoint[10]
-------------------------------------------------------------------------------

-- Get the Atta PPoint[10] Actual direction
    !attap10dir = !atta.pdir[10].wrt(/* )
-- Split into an array the Calculated ORTHOGONAL Pleave Direction
    !splitpldir = !directions[1].string().split()

    if (!attapldir.up.abs().eq(1)) then
-- Vertical Pipes Only
----------------------
-- The ATTA Pleave Direction is a TRUE ORTHOGONAL direction
-- either U or D wrt /*
-- Set the "ORTHOGONAL" PPoint[10] and Opposite Direction Variables to their ACTUAL direction values
      !directionp10 = !attap10dir
      !oppositep10  = !attap10dir.opposite()

    elseif (!attapldir.up.eq(0)) then
-- Non-Sloping Horizontal Pipes Only
------------------------------------

-- The ATTA Pleave Direction is a TRUE ORTHOGONAL direction
-- E, N, W or S wrt /*, or E 45 N wrt /* etc...
-- Set the "ORTHOGONAL" PPoint[10] and Opposite Direction Variables to their ACTUAL direction values
      !directionp10 = !attap10dir
      !oppositep10  = !attap10dir.opposite()

    else
-- Sloping Horizontal Pipes Only
--------------------------------
-- Split the ORTHOGONAL PPoint[9] Direction into an array.
      !splitp9dir   = !directionp9.string().split()

-- Test for Pin 9 being ON and Positioned.
-- Pin 9 is normally ON and Positioned during each MDS Frameworks' creation.
-- Need to position Pin 9 so that the !directions[5] and [6] can be calculated, i.e. P10 and P11 directions.
      var !testpin9pos pin 9 pos wrt /*
      !testpin9position = !testpin9pos.position()
      var !testpin9on pin 9

      if (!testpin9on.upcase().match('OFF').gt(1)) then
-- Pin 9 is currently switched Off and NOT being used so SET its Position
        !!mdspushpin(9)
        pin 9 copy p10 of $!atta
        pin 9 dist 200mm

      elseif ( (!testpin9position.up.eq(0))and (!testpin9position.east.eq(0)) and (!testpin9position.north.eq(0)) ) then
-- Pin 9 is currently at E0 N0 U0 wrt /*, i.e. Its' default position, and NOT being used so SET its Position
        !!mdspushpin(9)
        pin 9 copy p10 of $!atta
        pin 9 dist 200mm

      else
-- Pin 9 is Currently switched On and is being used, i.e. MDS Standard Framework is being CREATED
        !!mdspushpin(9)
        !p10dir = !atta.pdir[10].wrt( /* )
-- Temporarily reset the direction of Pin 9, so that the "Plane of Pin 9" is correct for the calculation shown below
        pin 9 dir $!p10dir
      endif

-- Calculate the Distances from the atta PPoint[10] and PPoint[11] to the Plane of "Pin 9"
-- DURING STRUCTURE creation for MDS Frameworks (FT03,FT04,FT07,FT08,FT09,FT10,FT11,FT12)
-- *** IMPORTANT NOTE ***
-- The SHORTEST distance means that the Vertical SCTN on the MDS Framework is closest to PPoint[10] or PPoint[11] of the DATUM Atta
      !p10pin9dist = !!kstrreal('cons dist p10 of $!atta to plane pin 9')

      !p11pin9dist = !!kstrreal('cons dist p11 of $!atta to plane pin 9')

-- Return Pin 9 back to its ORIGINAL Position, i.e. Position for creating the current type of MDS Standard Framework
      !!mdspoppin(9)
--------------------------------

$(
$P++++++++++++++++++++++++++++++
$P---q var !directionp9
q var !directionp9
$P
$P---q var !directionpl
q var !directionpl
$P==============================
$P -- q var !p10pin9dist
q var !p10pin9dist
$P == q var !p11pin9dist
q var !p11pin9dist
$)


-- Calculate the ORTHOGONAL PPoint[10] Direction from the ORTHOGONAL Ppoint[9] direction calculated above
      if (!splitpldir.size().eq(3)) and (!splitp9dir.size().eq(3)) then
-- The Pleave    ORTHOGONAL direction contains 3 components - e.g. N WRT /*      and
-- The PPoint[9] ORTHOGONAL direction contains 3 components - e.g. E WRT /*

        if ( (!directionp9.east.eq(0)) and (!directionp9.up.eq(-1)) ) then
-- The DATUM Atta PPoint[9] is  D wrt /*
          if (!p10pin9dist.lt(!p11pin9dist)) then
               q var !p10pin9dist !p11pin9dist
               q var !splitp9dir[1]
               -- this bit of code does not deal with north south directions
            !directionp10 = $!splitp9dir[1] 90 E $!splitp9dir[2] $!splitp9dir[3]
          elseif (!p10pin9dist.gt(!p11pin9dist))  then
            !directionp10 = $!splitp9dir[1] 90 W  $!splitp9dir[2] $!splitp9dir[3]
          endif

        elseif ( (!directionp9.east.eq(0)) and (!directionp9.up.eq(1)) ) then
-- The DATUM Atta PPoint[9] is U wrt /*
          if (!p10pin9dist.lt(!p11pin9dist)) then
            !directionp10 = $!splitp9dir[1] 90 W $!splitp9dir[2] $!splitp9dir[3]
          elseif (!p10pin9dist.gt(!p11pin9dist))  then
            !directionp10 = $!splitp9dir[1] 90 E  $!splitp9dir[2] $!splitp9dir[3]
          endif

        elseif ( (!directionp9.up.eq(0)) and (!directionp9.east.eq(-1)) ) then
-- The DATUM Atta PPoint[9] is W wrt /*
          if (!p10pin9dist.lt(!p11pin9dist)) then
            !directionp10 = $!splitp9dir[1] 90 D $!splitp9dir[2] $!splitp9dir[3]
          elseif (!p10pin9dist.gt(!p11pin9dist))  then
            !directionp10 = $!splitp9dir[1] 90 U  $!splitp9dir[2] $!splitp9dir[3]
          endif

        elseif ( (!directionp9.up.eq(0)) and (!directionp9.east.eq(1)) ) then
-- The DATUM Atta PPoint[9] is E wrt /*
          if (!p10pin9dist.lt(!p11pin9dist)) then
            !directionp10 = $!splitp9dir[1] 90 U $!splitp9dir[2] $!splitp9dir[3]
          elseif (!p10pin9dist.gt(!p11pin9dist))  then
            !directionp10 = $!splitp9dir[1] 90 D  $!splitp9dir[2] $!splitp9dir[3]
          endif
        endif

      elseif (!splitpldir.size().eq(3)) and (!splitp9dir.size().eq(5)) then
-- The Pleave    ORTHOGONAL direction contains 3 components - e.g. N WRT /*      and
-- The PPoint[9] ORTHOGONAL direction contains 5 components - e.g. W 60 D WRT /*

        if ((!directionp9.east.lt(0)) and (!directionp9.up.lt(0))) then
-- The DATUM Atta PPoint[9] is W and D wrt /*
          if (!p10pin9dist.lt(!p11pin9dist)) then
            !directionp10 = $!splitp9dir[1] ($!splitp9dir[2] + 90) $!splitp9dir[3] $!splitp9dir[4] $!splitp9dir[5]
          elseif (!p10pin9dist.gt(!p11pin9dist))  then
            !directionp10 = $!splitp9dir[1] ($!splitp9dir[2] - 90) $!splitp9dir[3] $!splitp9dir[4] $!splitp9dir[5]
          endif

        elseif ((!directionp9.east.gt(0)) and (!directionp9.up.lt(0))) then
-- The DATUM Atta PPoint[9] is E and D wrt /*
          if (!p10pin9dist.lt(!p11pin9dist)) then
            !directionp10 = $!splitp9dir[1] ($!splitp9dir[2] - 90) $!splitp9dir[3] $!splitp9dir[4] $!splitp9dir[5]
          elseif (!p10pin9dist.gt(!p11pin9dist))  then
            !directionp10 = $!splitp9dir[1] ($!splitp9dir[2] + 90) $!splitp9dir[3] $!splitp9dir[4] $!splitp9dir[5]
          endif

        elseif ((!directionp9.east.lt(0)) and (!directionp9.up.gt(0))) then
-- The DATUM Atta PPoint[9] is W and U wrt /*
          if (!p10pin9dist.lt(!p11pin9dist)) then
            !directionp10 = $!splitp9dir[1] ($!splitp9dir[2] - 90) $!splitp9dir[3] $!splitp9dir[4] $!splitp9dir[5]
          elseif (!p10pin9dist.gt(!p11pin9dist))  then
            !directionp10 = $!splitp9dir[1] ($!splitp9dir[2] + 90) $!splitp9dir[3] $!splitp9dir[4] $!splitp9dir[5]
         endif

        elseif ((!directionp9.east.gt(0)) and (!directionp9.up.gt(0))) then
-- The DATUM Atta PPoint[9] is E and U wrt /*
          if (!p10pin9dist.lt(!p11pin9dist)) then
            !directionp10 = $!splitp9dir[1] ($!splitp9dir[2] + 90) $!splitp9dir[3] $!splitp9dir[4] $!splitp9dir[5]
          elseif (!p10pin9dist.gt(!p11pin9dist))  then
            !directionp10 = $!splitp9dir[1] ($!splitp9dir[2] - 90) $!splitp9dir[3] $!splitp9dir[4] $!splitp9dir[5]
          endif

        endif

      elseif (!splitpldir.size().eq(5)) and (!splitp9dir.size().eq(3)) then
-- The Pleave    ORTHOGONAL direction contains 5 components - e.g. N 30 E WRT /*      and
-- The PPoint[9] ORTHOGONAL direction contains 3 components - e.g. D WRT /*
-- e.g.

        if ( (!directionp9.east.eq(0)) and (!directionp9.up.eq(-1)) ) then
-- The DATUM Atta PPoint[9] is  D wrt /*

        --<tm> modified lt to gt and gt to lt fpr p10 direction to fix bad orientation problems

          if (!p10pin9dist.gt(!p11pin9dist)) then
            !directionp10 = !attap10dir.opposite()
          elseif (!p10pin9dist.lt(!p11pin9dist)) then
            !directionp10 = !attap10dir
          else
            !directionp10 = !attap10dir
          endif

        elseif ( (!directionp9.east.eq(0)) and (!directionp9.up.eq(1)) ) then
-- The DATUM Atta PPoint[9] is U wrt /*

          --<tm> modified lt to gt and gt to lt fpr p10 direction to fix bad orientation problems

          if (!p10pin9dist.gt(!p11pin9dist)) then
            !directionp10 = !attap10dir.opposite()
          elseif (!p10pin9dist.lt(!p11pin9dist))  then
            !directionp10 = !attap10dir
          else
            !directionp10 = !attap10dir
          endif

        endif

      elseif (!splitpldir.size().eq(5)) and (!splitp9dir.size().eq(5)) then
-- The Pleave    ORTHOGONAL direction contains 5 components - e.g. N 45 E WRT /*      and
-- The PPoint[9] ORTHOGONAL direction contains 5 components - e.g. S 45 W WRT /*

        if ( (!directionp9.up.eq(0)) and (!directionp9.east.lt(0)) ) then
-- The DATUM Atta PPoint[9] is e.g. W 45 S wrt /* etc...
          if (!p10pin9dist.lt(!p11pin9dist)) then
            !directionp10 = D wrt /*
          elseif (!p10pin9dist.gt(!p11pin9dist)) then
            !directionp10 = U wrt /*
          else
            !directionp10 = !attap10dir
          endif

        elseif ( (!directionp9.up.eq(0)) and (!directionp9.east.gt(0)) ) then
-- The DATUM Atta PPoint[9] is e.g. E 45 N wrt /* etc...
          if (!p10pin9dist.lt(!p11pin9dist)) then
            !directionp10 = U wrt /*
          elseif (!p10pin9dist.gt(!p11pin9dist)) then
           !directionp10 = D wrt /*
          else
            !directionp10 = !attap10dir
          endif

        endif

      elseif (!splitpldir.size().eq(5)) and (!splitp9dir.size().eq(7)) then
-- The Pleave    ORTHOGONAL direction contains 5 components - e.g. N 30 E WRT /*      and
-- The PPoint[9] ORTHOGONAL direction contains 7 components - e.g. S 45 W 60 D WRT /*
-- e.g.

        if ((!directionp9.east.lt(0)) and (!directionp9.up.lt(0))) then
-- The DATUM Atta PPoint[9] is W and D wrt /*
          if (!p10pin9dist.lt(!p11pin9dist)) then
            !directionp10 = $!splitp9dir[1] $!splitp9dir[2] $!splitp9dir[3] ($!splitp9dir[4] + 90) $!splitp9dir[5] $!splitp9dir[7] $!splitp9dir[7]
          elseif (!p10pin9dist.gt(!p11pin9dist)) then
            !directionp10 = $!splitp9dir[1] $!splitp9dir[2] $!splitp9dir[3] ($!splitp9dir[4] - 90) $!splitp9dir[5] $!splitp9dir[7] $!splitp9dir[7]
          else
            !directionp10 = !attap10dir
          endif

        elseif ((!directionp9.east.gt(0)) and (!directionp9.up.lt(0))) then
-- The DATUM Atta PPoint[9] is E and D wrt /*
          if (!p10pin9dist.lt(!p11pin9dist)) then
            !directionp10 = $!splitp9dir[1] $!splitp9dir[2] $!splitp9dir[3] ($!splitp9dir[4] - 90) $!splitp9dir[5] $!splitp9dir[7] $!splitp9dir[7]
          elseif (!p10pin9dist.gt(!p11pin9dist)) then
            !directionp10 = $!splitp9dir[1] $!splitp9dir[2] $!splitp9dir[3] ($!splitp9dir[4] + 90) $!splitp9dir[5] $!splitp9dir[7] $!splitp9dir[7]
          else
            !directionp10 = !attap10dir
          endif

        elseif ((!directionp9.east.lt(0)) and (!directionp9.up.gt(0))) then
-- The DATUM Atta PPoint[9] is W and U wrt /*
          if (!p10pin9dist.lt(!p11pin9dist)) then
            !directionp10 = $!splitp9dir[1] $!splitp9dir[2] $!splitp9dir[3] ($!splitp9dir[4] - 90) $!splitp9dir[5] $!splitp9dir[7] $!splitp9dir[7]
          elseif (!p10pin9dist.gt(!p11pin9dist)) then
            !directionp10 = $!splitp9dir[1] $!splitp9dir[2] $!splitp9dir[3] ($!splitp9dir[4] + 90) $!splitp9dir[5] $!splitp9dir[7] $!splitp9dir[7]
          else
            !directionp10 = !attap10dir
          endif

        elseif ((!directionp9.east.gt(0)) and (!directionp9.up.gt(0))) then
-- The DATUM Atta PPoint[9] is E and U wrt /*
          if (!p10pin9dist.lt(!p11pin9dist)) then
            !directionp10 = $!splitp9dir[1] $!splitp9dir[2] $!splitp9dir[3] ($!splitp9dir[4] + 90) $!splitp9dir[5] $!splitp9dir[7] $!splitp9dir[7]
          elseif (!p10pin9dist.gt(!p11pin9dist)) then
            !directionp10 = $!splitp9dir[1] $!splitp9dir[2] $!splitp9dir[3] ($!splitp9dir[4] - 90) $!splitp9dir[5] $!splitp9dir[7] $!splitp9dir[7]
          else
            !directionp10 = !attap10dir
          endif
        endif

      endif
-------------------------------------------------------------------------------
    endif

   --<tm> frig to swap the p10 p11 directions if they are 180 out

  !angle = !attap10dir.angle(!directionp10)

  -- Populate the !directions array with the ORTHOGONAL PPoint[10] and Opposite PPoint[10] Direction
  if !angle.gt(90) then $* its the wrong angle
    !directions[6] = !directionp10
    !directions[5] = !directionp10.opposite()
  else
    !directions[5] = !directionp10
    !directions[6] = !directionp10.opposite()
  endif
-- Set the Global Variable !!mdsdirections - ONLY used for debugging
   !!mdsdirections = !directions

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------

-- Restore ALL Pins held in the GLOBAL array !!mdspindata
    !pinarray = ARRAY()
    !!mdspindata('RESTORE',!pinarray)

-- Navigate to the Original Element in the Database
    !!ce = !origin

-- Return the !directions aray
    return !directions

  endfunction
-- End of Function
