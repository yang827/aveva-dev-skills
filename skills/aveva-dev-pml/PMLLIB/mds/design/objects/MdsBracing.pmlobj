--
--
-- Description:
-- Multi Discipline support bracing object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsbracing(form,dbref)           -
--

-- Define Object
define object MdsBracing

-- Bracing name
  member .sctnname       is string

-- Bracing spec
  member .sctnspre       is dbref

-- Bracing start
  member .sctnposs       is position

-- Bracing end
  member .sctnpose       is position

-- Bracing cut start
  member .sctndrns       is direction

-- Bracing cut end
  member .sctndrne       is direction

-- Bracing rotation
  member .sctnbangle     is real

-- Bracing justification
  member .sctnjusline    is string

-- Bracing desp
  member .sctndespara    is array

-- Bracing purp
  member .sctnpurpose    is string

-- Bracing function
  member .sctnfunction   is string

-- Bracing description
  member .sctndescript   is string

-- Atta name
  member .attaname       is string

-- Atta spec
   member .attaspre      is dbref

-- Atta desp
  member .attadespara    is array

-- Atta ori
  member .attamdscp3     is string

-- End object
endobject

define method .mdsbracing(!form is form,!sctn is dbref)

   !brsctn            = !sctn
   !this.sctnname     = !brsctn.fullname
   !this.sctnspre     = !brsctn.spre
   !this.sctnposs     = !brsctn.poss.wrt(world )
   !this.sctnpose     = !brsctn.pose.wrt(world )
   !this.sctndrns     = !brsctn.drns.wrt(world )
   !this.sctndrne     = !brsctn.drne.wrt(world )
   !this.sctnbangle   = !brsctn.bang
   !this.sctnjusline  = !brsctn.jusl
   !this.sctndespara  = !brsctn.despara
   !this.sctnpurpose  = !brsctn.purp
   !this.sctnfunction = !brsctn.func

   if (defined(!!MDSFRAMEBRACING)) then
      if (!!MDSFRAMEBRACING eq 'true') then
         !attname          = !this.sctnname.replace('-BR','/BR')
         !bratta           = !attname.dbref()
         !this.attaname    = !bratta.fullname
         !this.attaspre    = !bratta.spre
         !this.attadespara = !bratta.despara
         !this.attamdscp3  = !bratta.:mdscp3
      endif
   endif

endmethod

-- End of file MdsBracing.obj
