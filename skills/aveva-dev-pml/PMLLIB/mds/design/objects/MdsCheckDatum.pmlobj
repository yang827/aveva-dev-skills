-- Define Object
  define object MDSCHECKDATUM
-- End of Object
  endobject
--
-----------------------------------------------------------------------------------------------------------
-- Method      offset(!form is form)
--
-- Description:
--             Move the STRU to the Offset Position relative to the setting in the UDA
--             :MdsNudgeDist and the Pleave direction of the DATUM ATTA only.
--             a NEGATIVE Value indicates Move Stru in the PLEAVE direction of the DATUM ATTA and
--             a POSITIVE Value indicates Move Stru in the OPPOSITE direction of the PLEAVE of theDATUM ATTA
--
-- Arguments:
--    [#]   [R/RW]    [Data Type]  [Description]
--     1     R         FORM         The MDS Framework Form
--
-- Return:
--    [Data Type]    [Description]
--
-----------------------------------------------------------------------------------------------------------
--
  define method .offset(!form is FORM)

-- Initialise variables
    !comp   = !!ce
    !support= !form.support
    !stru   = !support.stru
    !datum  = !support.datum
    !offset = :mdsnudgedist of $!datum
    var !mode mode
    forwards

-- Check the DATUM ATTA offset value, if not set to ZERO (default).
    if (!offset.neq(0)) then
      if (!offset.string().match('-').eq(1)) then
        !offset = !offset.abs()
      else
        !offset = -!offset
      endif
-- Move the STRU in the Correct direction.
      !!ce = !stru
      move $!support.pldir dist $!offset
    endif

-- Return to Original CE component
    !!ce = !comp

  endmethod
--
-- End of method .offset(!form is form)
--
-----------------------------------------------------------------------------------------------------------
-- Method      offset(!attas is MDSSUPPPORT)
--
-- Description:
--
-- Arguments:
--    [#]   [R/RW]    [Data Type]  [Description]
--     1     R         ARRAY        The MDS Ancillaries on the MDS Support
--
-- Return:
--    [Data Type]    [Description]
--
-----------------------------------------------------------------------------------------------------------
--
  define method .offset(!support is MDSSUPPORT)

-- Initialise variables
    !comp  = !!ce
    !datum = !support.datum
    !attas = !support.atta
    if (!support.stru.set()) then
      !name = !support.stru.name
    else
      !name = !datum
    endif
    var !mode mode
    forwards

-- Start from the new datum atta
    !!ce = !datum
    :mdsnudgedist 0
    pin 1 at $!datum
    pin 1 dir $!support.pldir

-- Calculate and Set the :MDSNUDGEDIST offset distance (+ve or-ve) for
-- each Atta on the MDS Support from the NEW DATUM Atta
    do !val values !attas
      skip if (!val.eq(!datum))
      !srefname = !name & '/SREF'
      skip if (!val.name.match(!srefname).gt(0))
      !!ce = !val
      if !!ce.type.eq('CTSUPP') then
        pin2 copy p2
      else
      pin 2 copy pl
      endif
      !dist = !!kstrreal('const dist pin 1 to plane pin 2')
      var !pinsdir cons dire pin 1 to pin 2
      !attadir = !pinsdir.direction()
-- Pin 1 and Pin 2 are in the same Position so Set !attadir
      if (!attadir.unset()) then
        !attadir = !support.pldir
      endif
      if (!support.pldir.neq(!attadir)) then
        !sign = '-'
      else
        !sign = ''
      endif
      :mdsnudgedist $!<sign>$!<dist>
    enddo

-- Return to Original CE component
    !!ce = !comp

-- Reset Pins
    !!mdsresetpins(1,2)

  endmethod
--
-- End of method .offset(!support is MDSSUPPPORT)
--
------------------------------------------------------------------------------------------------------------
-- Method      branches
--
-- Description:
--
-- Arguments:
--    [#]   [R/RW]    [Data Type]  [Description]
--     1     R         ARRAY        The MDS Support Attas
--
-- Return:
--    [Data Type]    [Description]
--      ARRAY         Array of Pipe Branches Containing Attas included on the MDS Support
--
-----------------------------------------------------------------------------------------------------------
  define method .branches(!attas is ARRAY) is ARRAY

-- Get the Branches
    !block = object BLOCK('!attas[!evalindex].owner')
    !brans = !attas.evaluate(!block).unique()
    return !brans

  endmethod
--
-- End of method .branches(!attas is ARRAY)
--
------------------------------------------------------------------------------------------------------------
-- Method      branchattas
--
-- Description:
--
-- Arguments:
--    [#]   [R/RW]    [Data Type]  [Description]
--     1     R         FORM         The MDS Support Form
--
-- Return:
--    [Data Type]    [Description]
--
-----------------------------------------------------------------------------------------------------------
  define method .branchattas(!form is FORM)
-- Initialise variableso
    !support = !form.support
    !attas   = !support.atta
    if (!support.stru.set()) then
      !name = !form.support.stru.name
    else
      !name = !form.support.datum.name
    endif

-- Get the Branches
    !brans = !this.branches(!attas)

-- Get the MDS Attas on the current support from each branch on the current support
-- ReOrder the Attas on ALL of the Branches Included in the current MDS Support
    do !indx indices !brans
------------------------------------------------------------------------------------------------------------
--      !attas$!<indx> = !!kcollectallfor('ATTA', '(matchwild(name,|$!<name>*|))', !brans[!indx])
--      !this.attareorder(!brans[!indx], !attas$!indx)
------------------------------------------------------------------------------------------------------------
      !!mdsreoatta(!brans[!indx])
    enddo

  endmethod
--
-- End of method .branchattas(!form is form)
------------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------------------
-- NOT USED and unfinished - see function !!mdsreoatta(!branchdbref)
--                           called ABOVE from method .branchattas(!form is form)

-- Method      attareorder
--
-- Description:
--
-- Arguments:
--    [#]   [R/RW]    [Data Type]  [Description]
--     1     R         DBREF         The Pipe Branch containing the MDS Support Attas
--
-- Return:
--    [Data Type]    [Description]
--
-----------------------------------------------------------------------------------------------------------
-- NOT USED and unfinished - see function !!mdsreoatta(!branchdbref)
--                           called ABOVE from method .branchattas(!form is form)

  define method .attareorder(!branch is DBREF)

-- Navigate to Pipe Branch
    !!ce    = !branch
    !mcount = !!ce.mcount()

-- Determine the Order of the MDS Support Attas on the Pipe Branch
    !order = ARRAY()
    do !indx index !attas
      !!ce = !attas[!indx]
      !order[!indx] = !!ce.order
    enddo

-- Get the Attas Branch order
    do !indx indices !order
      if (!indx.eq(1)) then
        !var = !order[!indx].string()
      else
        !var = !var & ',' & !order[!indx]
      endif
    enddo

-- Find the Previous Branch Component to the Support Attas
    !min =  min($!var)
    if (!min.eq(1)) then
-- An Atta on the current MDS Support is the First Component
-- Therefore Reorder Attas from the Branch Head
      pin 1 copy phead
    else
-- Get the Previous Branch Component to the Attas on the current MDS Support
-- Then Reorder the Attas from the Previous Component
      !prev = !min - 1
      !!ce = !!ce.owner.members[!prev]
      pin 1 copy pleave
      pin 1 at p0
    endif

-- Get the Distances for the Attas
-- NOT USED and unfinished - see function !!mdsreoatta(!branchdbref)
--                           called ABOVE from method .branchattas(!form is form)


  endmethod
--
-- End of method .attareorder(!branch is dbref, !attas is array)
-- NOT USED and unfinished - see function !!mdsreoatta(!branchdbref)
--                           called ABOVE from method .branchattas(!form is form)
-----------------------------------------------------------------------------------------------------------
