--
-- Description:
-- Object to hold hanger configuration details
-- For more info see file: /$!!MDSFILES.CONFIG
--
--------------------------------------------------------------------------------

-- Define Object
define object MdsCONFIG

  -- hanger description
  member .Description is STRING

  -- Support Type (derived from ATTA STYPE)
  member .Type        is STRING

  -- Support Drill/Weld size
  member .DrillWeld   is STRING

  -- array of ancillary component details for this support configuration
  member .Ancill      is ARRAY

  -- Erection Note text (used on HT03 to HT10) Note: gently stroking this member makes it bigger!
  member .Erection    is STRING

-- End object
endobject

-- End of file Mdsconfig.obj
