----------------------------------------------------------------------------------------------------
--<wd>17dec2009 - DFN P-23513 (SI-4931) - New Method to Enable MDS to Read and Store the Weight of Witchhanger Hanger Components
define method .readWeight(!inputString is STRING) is STRING

  -- Read the Hanger Component Weight from the last field , field No. 6, on the current line
  !splitLineArray = !inputString.split(',')
  -- Check the current line is a HANGER Component line in the BOM <support name>.wof file OUTPUT from WitcHanger
  !unusedSplitReal = !splitLineArray[1].real()
  handle NONE
    -- The HANGER Component Weight is always stored in the LAST FIELD of this line ( per Martin Williams C&P Ltd - 16Nov2009)
    !splitArraySize = !splitLineArray.size()
    !lastField = !splitLineArray[!splitArraySize]
    !unusedWeightTest = !lastField.real()
    handle NONE
      !weight = !lastField
    elsehandle ANY
      !weight= 'NONE'
    endhandle
  elsehandle ANY
    -- The current line is NOT a HANGER Component line in the BOM <support name>.wof file OUTPUT from WitcHanger
    !weight= 'NONE'
  endhandle

  -- Return the HANGER Component Weight Variable
  return !weight

endmethod
--<wd>17dec2009 - DFN P-23513 (SI-4931)
----------------------------------------------------------------------------------------------------

----------------------------------------------------------------------------------------------------
define method .readDespars(!inputString is ARRAY,!counter is REAL) is STRING

  -- Read in any design parameters from the next line
  !nextLine = !counter + 1
  if !inputString[$!nextLine].match('DESPAR').eq(1) then
    !desPars = !inputString[$!nextLine]
  else
    !desPars = 'NONE'
  endif

  return !desPars

endmethod
----------------------------------------------------------------------------------------------------

----------------------------------------------------------------------------------------------------
define method .readAngle(!inputString is ARRAY,!counter is REAL) is STRING

  -- Read in any design parameters from the next line
  !nextLine = !counter + 2
  if !inputString[$!nextLine].match('ANGL').eq(1) then
    !angle = !inputString[$!nextLine]
  else
    !angle = 'NONE'
  endif

  return !angle

endmethod

----------------------------------------------------------------------------------------------------

define method .oriConstant()
  -- If we are using a beam clamp we need to orientate it correctly

  if !!ce.type.eq('VSPR') and !!ce.catref.owner.:MDSType.eq('CONS') then
--<wd>23jul2009-  CONSTANT SPRING element types ONLY (VSPR)

    if !!ce.spref.name.match('C52-G').gt(0) then
-- reset the cross centres
      desp n31 $!this.vendorForm.steelwidthval
      handle ANY
         endhandle
       fconn and p10 is pa of prev
       var !a const dist p2 to htail
       var !b const dist p3 to htail
       if !a.real().gt(!b.real()) then
          fconn and p10 is pl of prev
        handle ANY
            endhandle
       endif
    else
      !ce = !!ce
      hang
      goto tref
        handle NONE
          sctn
            handle NONE
              var !!zdir zdir wrt /*
              !!ce = !ce
--><wd>22jul2009 - DFN P-21516 (SI-12441)
          --fconn and p10 is $!!zdir wrt /*
          fconn and p10 is $!this.hangerForm.constantDirectionOne
          handle ANY
            -- Creating the RESTRAINT and not MODIFYING
            fconn and p10 is $!!zdir wrt /*
          endhandle
          --<<wd>22jul2009 - DFN P-21516 (SI-12441)
        elsehandle ANY
          !!ce = !ce
        endhandle
      elsehandle ANY
-- This is the SECOND CONSTANT SPRING (VSPR)
        !!ce = !ce
--><wd>23jul2009 - DFN P-21516 (SI-12441)
-- The SECOND CONSTANT SPRING, for a TRAPEZE type Hanger, has already been IDENTIFIED because of the "goto TREF" syntax above
-- This is because it is NOT possible to navigate to the TREF of the HANGER which is set to Nulref, i.e. this raises the ERROR
-- *** (2,106) The current element cannot be =0/0 ***
        --fconn and p10 is $!!zdir wrt /*
        fconn and p10 is $!this.hangerForm.constantDirectionTwo
        handle ANY
-- Creating the RESTRAINT and not MODIFYING
          fconn and p10 is $!!zdir wrt /*
        endhandle
--<<wd>23jul2009 - DFN P-21516 (SI-12441)
          !!zdir.delete()
        endhandle
    endif
  endif

--<wd>23jul2009 Variable Springs Below Here, i.e.??? NOT CONSTANT SPRINGS ???
  if !!ce.type.eq('VSPR') and ( !!ce.stype inset('VAR TYPE H','VAR TYPE K' )) then
    !ce = !!ce
    hang
    hdir d
    !!ce = !ce
  endif

  if !!ce.type.eq('VSPR') and ( !!ce.stype inset('VAR TYPE H','VAR TYPE K' )) then
    !ce = !!ce
    !p10dir = ldir of href of owner wrt world
    fconn and p10 is $!p10dir
      handle ANY
        fconn
      endhandle
  endif

  if !!ce.type.eq('VSPR') and ( !!ce.stype inset('VAR TYPE F')) then
    !ce = !!ce
    hang
    hdir d
    !!ce = !ce
    fconn
  endif

  if !!ce.type.eq('VSPR') and ( !!ce.dtxr.matchwild('*TYPE H*') or !!ce.dtxr.matchwild('*TYPE G*')) then

    !ce = !!ce
    !p10dir = ldir of href of owner wrt world
    fconn and p10 is $!p10dir
      handle ANY
        fconn
      endhandle
  endif

  if !!ce.type.eq('VSPR') and !!ce.dtxr.matchwild('*TYPE K*') then
    if !!ce.catref.owner.:MDSType.neq('CONS') then
      !ce = !!ce
      !p10dir = ldir of href of owner wrt world
      fconn and p11 is $!p10dir
        handle ANY
          fconn
        endhandle
     endif
  endif

  if !!ce.type.eq('SWBR') then
      conn
        handle ANY
          fconn
        endhandle
      prev
        handle NONE
          !dp = desp
          desp n1 0mm
          !hei = hei
      !newHei = !hei + !dp[1]
      hei $!newHei
          nex
          conn
        elsehandle ANY
        endhandle
  endif

endmethod
----------------------------------------------------------------------------------------------------

define method .eyrd()

-- Because the eye rod can connect to a different rod bore
-- we need to get the lbor of the prev element or the owner cref
-- if we are the first element

  DESP N2 (pl bore of prev)
    handle ANY
      if !!ce.order.eq(1) then
        DESP N2 (pl bore of cref of owner)
          handle ANY
            DESP N2 (pl bore of href of owner)
              handle ANY
              endhandle
          endhandle
      endif
    endhandle

-- If we are using an eye rod with a turnbuckle, then we need to reset the thread to a LH
  -- This is because the eye rod can be supplied as left and right hand threads.

  if !!ce.type.eq('EYRD') then
    conn
      handle ANY
--      !ceSpref = !!ce.spref.name
        !newSpref = !!ce.spref.name.replace('395','395A')
      spref $!newSpref
          handle NONE
            conn
              handle ANY
                fconn
              endhandle
          elsehandle ANY
          endhandle
      endhandle
  endif

-- Special case if eyrd 393 is being used after a constant this will need flipping
-- One eyrd will be part of the first bran, with the prev comp a cons
-- One eyrd will be the first member with the href of hang a cons
-- This is only after constants
-- C50J C50K C50O C51V C51R C51U
  !flip = FALSE
  if !!ce.type.eq('EYRD') then
    if !!ce.dtxs.matchwild('*393*') then
      if !!ce.order.eq(1) then
        !href = href of hang
        if !href.type.eq('VSPR') and !href.catref.owner.:MDSType.eq('CONS') then
          if !href.dtxr.matchwild('*C50J*') then
            !flip = TRUE
          elseif !href.dtxr.matchwild('*C50K*') then
            !flip = TRUE
          elseif !href.dtxr.matchwild('*C50O*') then
            !flip = TRUE
          elseif !href.dtxr.matchwild('*C51V*') then
            !flip = TRUE
          elseif !href.dtxr.matchwild('*C51R*') then
            !flip = TRUE
          elseif !href.dtxr.matchwild('*C51U*') then
            !flip = TRUE
          endif
          if !flip then
            flip
            fconn
          endif
        endif
      else
        !prev = prev
        if !prev.type.eq('VSPR') and !prev.catref.owner.:MDSType.eq('CONS') then
          if !prev.dtxr.matchwild('*C50J*') then
            !flip = TRUE
          elseif !prev.dtxr.matchwild('*C50K*') then
            !flip = TRUE
          elseif !prev.dtxr.matchwild('*C50O*') then
            !flip = TRUE
          elseif !prev.dtxr.matchwild('*C51V*') then
            !flip = TRUE
          elseif !prev.dtxr.matchwild('*C51R*') then
            !flip = TRUE
          elseif !prev.dtxr.matchwild('*C51U*') then
            !flip = TRUE
          endif
          if !flip then
            flip
            fconn
          endif
        endif
      endif
    endif
  endif

endmethod
----------------------------------------------------------------------------------------------------

define method .navToComp(!val is REAL)

-- If multiple hangers are created we need to navigate to the right component to connect to.
-- We will be at the right hanger when we enter this method

  !hanger = !!ce
  !counter = 0
  !breakLoop = FALSE

  rest
  !hangers = !!ce.mcount()
  do !loop from 1 to !hangers
    rest
    hang $!loop
    !hangMem = !!ce.mcount()
    do !loopMem from 1 to !hangMem
      if !breakLoop then
        break
      endif
      hang
      $!loopMem
      !counter = !counter + 1
      if !counter.eq(!val) then
        !member = !!ce
        !breakLoop = TRUE
      endif
    enddo
    if !breakLoop then
      break
    endif
  enddo

  !!ce = !member

  !!ce = !hanger

endmethod
----------------------------------------------------------------------------------------------------

define method .setInsu()

-- Height of roller is desp 1 of prev component
-- cl to top of clamp is the existing desp[3]

  !desp = desp
  prev
    handle ANY
    !rollerHeight = 0
    elsehandle NONE
    !rollerHeight = desp[1]
      next
    endhandle

  desp 0mm $!rollerHeight $!desp[3]

endmethod

define method .oriPcla()

  CONN AND P4 is U
    handle ANY
    if !this.vendorForm.hangerSelType.val.eq('6') then
        !!ce.owner.hbor = !!ce.abore
        !!ce.owner.hdir = !!ce.owner.href.ldir
        end
      !plod = (pl od of href)
        move ph by u ($!plod / 2) wrt /*
        same
        conn and p4 is u
          handle ANY
          endhandle
      endif
    elsehandle NONE
    endhandle

endmethod

define method .oriRiser()

  !paDir = pa dir wrt /*
  if !paDir.string().eq('D WRT /*') or !paDir.string().eq('-Z WRT /*') then
    !riser = !!ce
    hang
    goto href
    flip ori
    same
    conn ph to href
    !!ce = !riser
    conn
  endif

  !steel = !this.vendorForm.steelmem
  -- q var !steel
  do !i indices !steel
    if !steel[!i].unset() then
      !steel[!i].delete()
    endif
  enddo
  !steel.sortunique()
  if !steel.size().gt(1) then
     !dir1 = !steel[1].zdir.wrt( /* )
     !dir2 = u wrt /*
     !direction = !dir1.cross(!dir2)
  else
    !direction = !steel[1].zdir.wrt( /* )
      handle ANY
        return
      endhandle
  endif
  conn and p10 is $!direction

endmethod

----------------------------------------------------------------------------------------------------

define method .eynt()

-- Need to flip if prev comp is a hrod

  if !!ce.type.eq('EYNT') then
    prev
      handle NONE
        if !!ce.type.eq('HROD') then
          next
          flip
          conn
        endif
      elsehandle ANY
      endhandle
  endif

endmethod

define method .updateTypeGvspr()

  --P31687 added a check for type G VSPR in which an additional despar is required to adjust the height of the VSPR
  --we need to calculate the value of this despar using existing parameters - start
  if !!ce.type.eq('HROD') then
    !currentElement = !!ce
    vspr 1
    handle ANY
      return
    endhandle
    if !!ce.dtxr.matchwild('*TYPE G*') and (!!ce.spref.name.matchwild('*DV035*') OR !!ce.spref.name.matchwild('*DV070*') OR !!ce.spref.name.matchwild('*DV140*') OR !!ce.spref.name.matchwild('*DV210*')) then
      hrod 1
      !threadPos1 = !!ce.ppos[1]
      !threadPos2 = !!ce.ppos[11]
      !threadHeight = !threadPos1.distance(!threadPos2)
      vspr 1
      !heightToBottomOfRodFromTrapeze = !!ce.height
      !heightFromTrapezeToTopOfCan = !!ce.para[5]
      !maxLoadedLength = !!ce.para[4]
      !canHeight = !!ce.para[3]

      !adjustmentValue = !maxLoadedLength - ((!heightToBottomOfRodFromTrapeze - !heightFromTrapezeToTopOfCan) + !threadHeight + !canHeight)
      desp num 2 $!adjustmentValue
    endif
    !!ce = !currentElement
  endif
  --P31687 added a check for type G VSPR in which an additional despar is required to adjust the height of the VSPR
  --we need to calculate the value of this despar using existing parameters - end

endmethod
