--
--
-- Description:
-- Multi Discipline support fitting object. member of a kdmshang object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsfitt(DBREF)                   -
--  mdsfitt(MDSINTERFACEVIRTUALCMPF) -
--  mdsfitt(MDSINTERFACEVIRTUALFITTING) -
--

-- Define Object
define object MDSFITT

  -- Name of fitting
  member .name is STRING

  -- Name of fitting
  member .ref is DBREF

  -- Used to reposition support
  member .delpos is POSITION

  -- Used to re-orientate after modification cancel
  member .zdist is REAL

  -- User to restore a cancel support back to it's original spref & lstub
  member .spref is DBREF

  --dun1218 add virtual fitting support
  member .virtualFitting is MDSINTERFACEVIRTUALFITTING
  member .virtualCMPF is MDSINTERFACEVIRTUALCMPF

endobject

define method .mdsfitt(!fittRef is DBREF)
  !this.name = !fittRef.name
  !this.ref = !fittRef
endmethod

--dun1218 added this constructor method to allow the MDSFITT object to be created using a virtual fitting
define method .mdsfitt(!virtualFitting is MDSINTERFACEVIRTUALFITTING)
  --!this.ref = !fittRef
  !this.virtualFitting = !virtualFitting
  !this.name = !this.virtualFitting.name
endmethod
--dun1218 added this constructor method to allow the MDSFITT object to be created using a virtual fitting

--dun1218 added this constructor method to allow the MDSFITT object to be created using a virtual CMPF
define method .mdsfitt(!virtualCMPF is MDSINTERFACEVIRTUALCMPF)
  !this.virtualCMPF = !virtualCMPF
  !this.name = !this.virtualCMPF.name
endmethod
--dun1218 added this constructor method to allow the MDSFITT object to be created using a virtual CMPF
