-----------------------------------------------------------------------------------------------------------
--
-- Define Object
define object MDSFRAMEANCILLS

  -- Define the Common Object Members Required.
  member .crAtta is DBREF
  member .form   is FORM
  member .idComp is STRING
  member .return is BOOLEAN

  -- Define the 'AT60' Specific Object Members Required.
  member .offSet is REAL
  member .leave  is REAL
  member .where  is STRING

endobject

-- End of Object
--
-----------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------
-- Method:       before(!form is FORM,!selection is STRING)
--
-- Description:  Performs actions BEFORE the Creation of an ANCILLARY on a STANDARD or a SPECIAL
--               MDS FRAMEWORK and Sets Up ANY DATA required for the particular ANCILLARY
-- Arguments:
--    [#]   [R/RW]    [Data Type]   [Description]
--
--     1      R        FORM          FORM on which the MDS Ancillary is Selected
--     2      R        STRING        The RTEXT behind the SELECTION on FORM list gadget
--
-- Return:
--    [Data Type]    [Description]
--
--<dw>mar2009 dun1119 GT65 to GT69, GT84, ST43 to ST50 added to selection
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  after(STRING,DBREF)              -                   Performs actions AFTER the Creation of an ANCILLARY on a STANDARD or a SPECIAL
--  before(FORM,STRING)              -                   Performs actions BEFORE the Creation of an ANCILLARY on a STANDARD or a SPECIAL
--  guideAfter(STRING,DBREF)         -                   Performs any actions AFTER the Creation of a GUIDE ANCILLARY
--  guideBefore(FORM,STRING)         -                   Performs any actions BEFORE and AFTER the Creation of a GUIDE ANCILLARY
--  shoeAfter(STRING,DBREF)          -                   Performs any actions AFTER the Creation of a Pipe Shoe
--
define method .before(!form is FORM,!selection is STRING)
  -------------------------------------------------------------


  -- Select the correct PML code for the selected MDS Ancillary
  -------------------------------------------------------------
  !this.return = FALSE
  !this.where  = ''
  -------------------------------------------------------------

  --<wd>21oct2009 - DFN P-25095 SI-14645 - Added GT63, GT64, GT70 and GT71 "Hold Down Guides ONLY for Pipe Shoes"
  --<wd>11jan2010 - DFN P-27844 SI-19722 - Added GT62 and GT72 Guides for Pipe Shoes"
  if (!selection inset ('GT01','GT03','GT06','GT07','GT08','GT14','GT18','GT19','GT21','GT26','GT28','GT46','GT44','GT47','GT48','GT49','GT60A','GT60B','GT62','GT63','GT64','GT70','GT71','GT72')) then
    -- MDS Shoe Guides
    !this.guideBefore(!form,!selection)
    -------------------------------------------------------------

  elseif (!selection inset ('AN04','ST06','ST11A','ST11B','ST12','ST20','ST43','ST44')) then
    -- MDS Shoe Stops/Anchors
    !this.guideBefore(!form,!selection)
    -------------------------------------------------------------

  elseif (!selection inset ('GT11','GT12A','GT12B','GT27A','GT27B','GT65','GT66','GT67','GT68','GT69','GT84')) then
    -- MDS Trunnion Base Plate Guides
    !this.guideBefore(!form,!selection)
    -------------------------------------------------------------

  elseif (!selection inset ('AN05','ST07','ST08','ST33','ST45','ST46','ST47','ST48','ST49','ST50')) then
    -- MDS Trunnion Base Plate Stops/Anchors
    !this.guideBefore(!form,!selection)
    -------------------------------------------------------------

  elseif (!selection inset ('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT100A','AT100B')) then
    -- MDS Trunnion Base Plate Isolation Pads, Slide Units and Cold Isolation Block
    !this.guideBefore(!form,!selection)
    -------------------------------------------------------------

  elseif (!selection inset ('AT59','AT68')) then
    -- MDS Trunnion Base Plate Cold Isolation Blocks
    !this.guideBefore(!form,!selection)
    -------------------------------------------------------------

  elseif ((!selection inset ('AT30','SU03','SU04')) or (!selection.matchwild('SU01*')) or (!selection.matchwild('SU02*')) ) then
    -- MDS Shims and Slip Units for PIPE Shoes ONLY
    !this.guideBefore(!form,!selection)
    -------------------------------------------------------------

  elseif (!selection inset ('AT05','AT09','AT23','AT52A','AT52B','AT52C','AT52D','AT52E','AT52F','AT65')) then
    -- MDS Reinforcing Pads for Pipes and Pipe Shoes Only
    !this.guideBefore(!form,!selection)
    -------------------------------------------------------------

  elseif (!selection inset ('AT53A','AT53B')) then
    -- MDS Shear Lugs for Clamp-On Pipe Shoes Only i.e. MDS Support types 'AT55A','AT55B','AT56' ONLY
    !this.guideBefore(!form,!selection)
    -------------------------------------------------------------

  elseif (!selection inset ('AT61')) then
    -- MDS Vertical Pipe Attachment - NPS 12" to 48"
    !this.guideBefore(!form,!selection)
    -------------------------------------------------------------

  elseif (!selection inset ('AT62','AT69')) then
    -- MDS Adjustable Guide Inserts - Only the Perpendicular type may be aligned
    !this.guideBefore(!form,!selection)

    -------------------------------------------------------------

  elseif (!selection inset ('AT60', 'AT185')) then
    -- MDS Flange Support for FRP/RTR Pipes Only
    !this.guideBefore(!form,!selection)
    -------------------------------------------------------------

  elseif (!selection inset ('AT40A','AT40B','AT40C','AT40D','AT40E','AT40F','AT41A','AT41B','AT41C','AT41D','AT41E','AT41F','AT42','AT101A','AT101B')) then
    -- MDS Ancillary Isolation Pads, Slide Units
    !this.guideBefore(!form,!selection)
    -------------------------------------------------------------

  else
    -------------------------------------------------------------
    -- The Selected MDS Ancillary does NOT require any PRELIMINARY actions
    !this.return = TRUE
    !this.idComp = ''
  endif

endmethod
-----------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------
-- Method:       after(!idComp is STRING,!crAtta is DBREF)
--
-- Description:  Performs actions AFTER the Creation of an ANCILLARY on a STANDARD or a SPECIAL
--               MDS FRAMEWORK and Sets ANY DESPARS etc... required for the particular ANCILLARY
-- Arguments:
--    [#]   [R/RW]    [Data Type]   [Description]
--
--     1      R        STRING        Identified ATTA existing on the current MDS FRAMEWORK support or a
--                                   SCTN etc... associated with the ATTA !crAtta i.e DBREF passed as a STRING
--                                   or an empty STRING '' because the ATTA has NO associations
--     2      R        DBREF         ATTA created to add to the MDS Standard or Special FRAMEWORK support
--
-- Return:
--    [Data Type]    [Description]
--
-----------------------------------------------------------------------------------------------------------
define method .after(!idComp is STRING,!crAtta is DBREF)
  -------------------------------------------------------------

  -- Select the correct PML code for the selected MDS Ancillary
  --<wd>21oct2009 - DFN P-25095 SI-14645 - Added GT63, GT64, GT70 and GT71 "Hold Down Guides ONLY for Pipe Shoes"
  --<wd>11jan2010 - DFN P-27844 SI-19722 - Added GT62 and GT72 Guides ONLY for Pipe Shoes"
  if (!crAtta.stype inset ('GT01','GT06','GT07','GT08','GT14','GT18','GT19','GT21','GT26','GT28','GT44','GT46','GT47','GT48','GT49','ST06','AN04','ST24A','ST24B','ST24C','ST24D','GT60A','GT60B','GT62','GT63','GT64','GT70','GT71','GT72')) then
    -- MDS Shoe Guides/Stops
    !this.guideAfter(!idComp,!crAtta)
    -------------------------------------------------------------

    --<wd>08jan2010 - DFN P-27844 SI-19722 - Added ST43 and ST44 ONLY for Pipe Shoes and ST57 and ST58 for Uninsulated Pipes
  elseif (!crAtta.stype inset  ('AT25','AT26','GT13','AN06','AN10','AN11','ST01','ST02','ST03','ST04','ST05','ST09A','ST09B','ST10A','ST10B','ST11A','ST11B','ST12','ST13A','ST13B','ST20','ST32','ST34','ST43','ST44','ST57','ST58')) then
    -- MDS Cryogenic Pipe Shoes/Guides plus MDS Standard Anchors and Stops
    !this.shoeAfter(!idComp,!crAtta)
    -------------------------------------------------------------
    --<wd>11jan2010 - DFN P-27844 SI-19722 - Added ST45,ST46,ST47,ST48,ST49,ST50,GT65,GT66,GT67,GT68,GT69 and GT84
  elseif (!crAtta.stype inset ('GT11','GT12A','GT12B','GT27A','GT27B','ST07','ST08','AN05','ST33','ST45','ST46','ST47','ST48','ST49','ST50','GT65','GT66','GT67','GT68','GT69','GT84')) then
    -- MDS Trunnion Base Plate Guides/Stops
    !this.guideAfter(!idComp,!crAtta)
    -------------------------------------------------------------

  elseif (!crAtta.stype inset ('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT100A','AT100B')) then
    -- MDS Trunnion Base Plate Isolation Pads and Slide Units
    !this.guideAfter(!idComp,!crAtta)
    -------------------------------------------------------------

  elseif (!crAtta.stype inset ('AT59','AT68')) then
    -- MDS Trunnion Base Plate Cold Isolation Blocks
    !this.guideAfter(!idComp,!crAtta)
    -------------------------------------------------------------

  elseif (!crAtta.stype inset ('AT05','AT09','AT23','AT52A','AT52B','AT52C','AT52D','AT52E','AT52F','AT65')) then
    -- MDS Reinforcing Pads for Pipes and Pipe Shoes Only
    !this.shoeAfter(!idComp,!crAtta)
    -------------------------------------------------------------

  elseif (!crAtta.stype inset ('AT40A','AT40B','AT40C','AT40D','AT40E','AT40F','AT41A','AT41B','AT41C','AT41D','AT41E','AT41F','AT42','AT101A','AT101B')) then
    -- MDS Isolation Pads and Slide Units for Pipes and Pipe Shoes Only
    !this.shoeAfter(!idComp,!crAtta)
    -------------------------------------------------------------

  elseif (!crAtta.stype inset ('AT21','AT22')) then
    -- MDS Straps for Pipes Only
    !this.shoeAfter(!idComp,!crAtta)
    -------------------------------------------------------------

  elseif ((!crAtta.stype inset ('AT30','SU03','SU04')) or (!crAtta.stype.matchwild('SU01*')) or (!crAtta.stype.matchwild('SU02*'))) then
    -- MDS Shims and Slip Units for Pipe Shoes Only
    !this.shoeAfter(!idComp,!crAtta)
    -------------------------------------------------------------

  elseif (!crAtta.stype inset ('AT53A','AT53B')) then
    -- MDS Shear Lugs for Clamp-On Pipe Shoes Only i.e. MDS Support types 'AT55A','AT55B','AT56' ONLY
    !this.shoeAfter(!idComp,!crAtta)
    -------------------------------------------------------------

  elseif (!crAtta.stype inset ('AT62','AT69')) then
    -- MDS Adjustable Guide Inserts - Only the Perpendicular type may be aligned
    !this.shoeAfter(!idComp,!crAtta)
    -------------------------------------------------------------

  elseif (!crAtta.stype inset ('AT61')) then
    -- MDS Vertical Pipe Attachment - NPS 12" to 48"
    !this.shoeAfter(!idComp,!crAtta)
    -------------------------------------------------------------

  elseif (!crAtta.stype inset ('AT60')) then
    -- MDS Flange Support for FRP/RTR Pipes Only
    !this.shoeAfter(!idComp,!crAtta)
    -------------------------------------------------------------

  elseif (!crAtta.stype inset ('ST14')) then
    -- To allow resizing of the stop with a sctn or box
    !this.shoeAfter(!idComp,!crAtta)
    -------------------------------------------------------------

    -------------------------------------------------------------
  elseif (!crAtta.stype inset ('AT98')) then
    !this.shoeAfter(!idComp,!crAtta)
    -------------------------------------------------------------
  else
    if !this.form.string().eq('MDSMODAT') then
      !!alert.message('This standard does not require any graphical actions')
      return
    elseif !this.form.string().eq('MDSEDITPROP') then
      !!alert.message('This standard does not require any graphical actions')
      return
    endif
  endif
  -------------------------------------------------------------


  -------------------------------------------------------------
  -- Common Code for all Ancillaries
  if !this.form.string().eq('MDSMODAT') then
    !!doNotID = TRUE
    !!mdsImodat(!!mdsModAt.callingForm,!!mdsModAt)
    --------------------------------------------------------------------------------
    --<wd>20oct2008 - DUN1029 - - Defect No. P-10628 - SI. No. 4403 - "Can't modify ATTA"
    -- The USER is NOT required to Identify "AGAIN" the same MDS ATTA SUPPORT, after clicking the OK button on the FORM !!mdsAncill, when
    -- called via the 'Modify Ancillary Type' icon button on the !!mdsEditProp FORM, from a typical MDS FRAMEWORK Support FORM, e.g. !!mdsFT09
  elseif !this.form.string().eq('MDSANCILL') and !!mdsEditprop.shown().eq(TRUE) then

    !!doNotID = TRUE
    --<wd>20oct2008 - DUN1029 - - Defect No. P-10628 - SI. No. 4403 - "Can't modify ATTA"
    --------------------------------------------------------------------------------
  endif

  -------------------------------------------------------------

endmethod
-----------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------
-- Method:       guideBefore(!form is FORM,!selection is STRING)
--
-- Description:  Performs any actions BEFORE and AFTER the Creation of a GUIDE ANCILLARY
--               on a MDS STANDARD or SPECIAL FRAMEWORK
-- Arguments:
--    [#]   [R/RW]    [Data Type]   [Description]
--
--     1      R        FORM          FORM on which the MDS Ancillary is Selected
--     2      R        STRING        If the action is BEFORE then it is a STRING variable i.e.
--                                   The RTEXT behind the SELECTION on FORM list gadget
--
-- Return:
--    [Data Type]    [Description]
--
-----------------------------------------------------------------------------------------------------------
define method .guideBefore(!form is FORM,!selection is STRING)
  -------------------------------------------------------------

  --<wd>21oct2009 - DFN P-25095 SI-14645 - Added GT63, GT64, GT70 and GT71 "Hold Down Guides ONLY for Pipe Shoes"
  --<wd>11jan2010 - DFN P-27844 SI-19722 - Added ST43, ST44 and GT72 Guide ONLY for Pipe Shoes"
  -- 'AN04','GT01','GT06','GT07','GT08','GT14','GT18','GT19','GT21','GT26','GT28','ST06','ST11A','ST11B','ST12'
  -- MDS Pipe Shoe GUIDE standards selected on a MDS Framework standard need to IDENTIFY the Pipe Shoe before Proceeding
  -- Ensuring the Identified Pipe Shoe is ON the SAME Identified Pipe previously IDENTIFIED via the 'Add Pipe' ICON
  if (!selection inset ('AN04','GT01','GT06','GT07','GT08','GT14','GT18','GT19','GT21','GT26','GT28','ST06','ST11A','ST11B','ST12','ST20','ST43','ST44','GT46','GT44','GT47','GT48','GT49','GT63','GT64','GT70','GT71','GT72')) then
    -- Identify Pipe Shoe to which to attach the Guide
    label /Identify
    prompt off
    prompt load escape 'Identify Pipe Shoe to Guide/Stop'
    ID ATTA @
    handle (61,528)
      prompt on
      -- Reset OK button Callback so as NOT to SHOW the ROTATE ATTA FORM
      !!mdsAncill.action[2] = ''
      !!mdsAncill.action[3] = ''
      !!mdsAncill.action[4] = ''
      !this.return = FALSE
      return
    endhandle
    prompt on
    !shoe = !!ce
    -- "GT08", "AN04" - Check and Reject if the Identified Pipe Shoe may NOT be used with these standards
    -- Reject these Shoe Standards
    if (!selection inset ('GT08','AN04')) then
      !styp = !shoe.stype
      ---------------------------------------------------------------------------------------------------
      --<wd>dec2006<mds12> -- Remove any Reference to the !!code.... Global Variables
      --!codX = '$$' & '!!code' & !styp
      --!code = '$!codX'
      --!codZ = '$$' & '!!code' & !selection
      --!codA = '$!codZ'
      -- Determine the Client Codes from the PARAGON MDS12 Defaults for !styp and !selection
      !code = !!mdsGetDefProp('ATTA', !styp, 'CCOD')
      if (!code.eq(|ERROR|)) or (!code.trim().eq(||)) then
        -- Use the AVEVA MDS STANDARD NAME
        !code = !styp
      endif
      !codA = !!mdsGetDefProp('ATTA', !selection, 'CCOD')
      if (!codA.eq(|ERROR|)) or (!codA.trim().eq(||)) then
        -- Use the AVEVA MDS STANDARD NAME
        !codA = !selection
      endif
      --<wd>dec2006<mds12>
      ---------------------------------------------------------------------------------------------------

      if (!shoe.stype inset ('AT25','AT26','GT13')) then
        !!alert.error('The Guide/Anchor standard $!codA may NOT be placed on the identified shoe type $!<code>. Creation aborted!')
        golabel /Identify
      endif
      if (!selection inset ('AN04')) then
        !dpNum = !!mdsGetDesp('BWID')
        if (!dpNum.eq(0)) then
          -- DKEY BWID (Bolt c/c for SHOE width) does NOT exist in the DATASET of the Identified SHOE
          !!alert.error ('Identified Pipe Shoe type $!code is NOT suitable for this type of ANCHOR support. Creation aborted!')
          golabel /Identify
        endif
      endif
    endif

    ---------------------------------------------------------------------------------------------------
    --<wd>aug2006 -- These TWO tests shown below have been commented out to allow USERS
    --               to ADD any GUIDE to an AT25 Cryogenic Support, if they want to!
    --
    --
    -- -- "GT14" - Note a GT14 can only be placed on a AT25 CRYOGENIC Pipe Shoe and vice versa
    -- ---------------------------------------------------------------------------------------------------
    -- --<wd>dec2006<mds12> -- Remove any Reference to the !!code.... Global Variables
    --
    -- The <wd>dec2006<mds12> CODE in the adjacent blocks for the MDS12 changes was done before the FILES were MERGED so it remains, in case it is required later!!
    --
    -- -- Determine the Client Codes from the PARAGON MDS12 Defaults for GT14 and AT25
    --         !gt14code = !!mdsGetDefProp('ATTA', 'GT14', 'CCOD')
    --         if (!gt14code.eq(|ERROR|)) or (!gt14code.trim().eq(||)) then
    -- -- Use the AVEVA MDS STANDARD NAME
    --           !gt14code = |GT14|
    --         endif
    --         !at25code = !!mdsGetDefProp('ATTA', 'AT25', 'CCOD')
    --         if (!at25code.eq(|ERROR|)) or (!at25code.trim().eq(||)) then
    -- -- Use the AVEVA MDS STANDARD NAME
    --           !at25code = |AT25|
    --         endif
    -- --<wd>dec2006<mds12>
    -- ---------------------------------------------------------------------------------------------------
    --         if (!selection inset ('GT14')) then
    --           if (not !shoe.stype inset ('AT25')) then
    -- --<wd>dec2006<mds12>
    --             --!!alert.error('Only Guide standard $!!codeGT14 may be placed on an $!!codeAT25 shoe. Creation aborted!')
    --             !!alert.error('Only Guide standard $!gt14code may be placed on an $!at25code shoe. Creation aborted!')
    -- --<wd>dec2006<mds12>
    --             golabel /Identify
    --           endif
    --         endif
    -- -- Shoe type "AT25" - May ONLY have a "GT14" as a GUIDE
    --         if (not !selection inset ('GT14')) then
    --           if (!shoe.stype inset ('AT25')) then
    -- --<wd>dec2006<mds12>
    --             --!!alert.error('Only Guide standard $!!codeGT14 may be placed on an $!!codeAT25 shoe. Creation aborted!')
    --             !!alert.error('Only Guide standard $!gt14code may be placed on an $!at25code shoe. Creation aborted!')
    -- --<wd>dec2006<mds12>
    --             golabel /Identify
    --           endif
    --         endif
    --
    --
    --<wd>aug2006 -- The TWO tests shown above have been commented out to allow USERS
    --               to ADD any GUIDE to an AT25 Cryogenic Support, if they want to!
    ---------------------------------------------------------------------------------------------------

    -- Error if it is NOT a Pipe Shoe
    if (!!ce.catref.owner.:mdsGuidable.not()) then
      !!alert.error('The Identified element must be a Pipe Shoe for the type of GUIDE selected.')
      golabel /Identify
    endif
    -- Error if Identified Pipe Shoe is NOT on the previously Identified Branch
    if (!shoe.owner.neq(!form.support.idBran)) then
      !!alert.error('The Identified Pipe Shoe MUST be on the same Pipe Branch as previously identified')
      golabel /Identify
    endif
    if (!shoe.name.match(!form.support.stru.name).neq(1)) then
      !!alert.error('The Identified Pipe Shoe MUST be on the current MDS framework $!form.support.stru.name')
      golabel /Identify
    endif
  endif
  -------------------------------------------------------------

  -- "GT03" - Identify a Pipe Cradle/Wear Pad ONLY to which to ATTACH the Guide and proceed
  if (!selection inset ('GT03')) then
    label /IdentifyA
    prompt off
    prompt load escape 'Identify Reinforcing Plate to guide'
    ID ATTA @
    handle (61,528)
      prompt on
      -- Reset OK button Callback so as NOT to SHOW the ROTATE ATTA FORM
      !!mdsAncill.action[2] = ''
      !!mdsAncill.action[3] = ''
      !!mdsAncill.action[4] = ''
      !this.return = FALSE
      return
    endhandle
    prompt on
    !shoe = !!ce
    -- Ensure it is a reinforcing plate of STYP AT05 or AT09
    ---------------------------------------------------------------------------------------------------
    --<wd>dec2006<mds12> -- Remove any Reference to the !!code.... Global Variables
    -- Determine the Client Codes from the PARAGON MDS12 Defaults for GT03, AT05 and AT09
    !gt03code = !!mdsGetDefProp('ATTA', 'GT03', 'CCOD')
    if (!gt03code.eq(|ERROR|)) or (!gt03code.trim().eq(||)) then
      -- Use the AVEVA MDS STANDARD NAME
      !gt03code = |GT03|
    endif
    !at05code = !!mdsGetDefProp('ATTA', 'AT05', 'CCOD')
    if (!at05code.eq(|ERROR|)) or (!at05code.trim().eq(||)) then
      -- Use the AVEVA MDS STANDARD NAME
      !at05code = |AT05|
    endif
    !at09code = !!mdsGetDefProp('ATTA', 'AT09', 'CCOD')
    if (!at09code.eq(|ERROR|)) or (!at09code.trim().eq(||)) then
      -- Use the AVEVA MDS STANDARD NAME
      !at09code = |AT09|
    endif
    --<wd>dec2006<mds12>
    ---------------------------------------------------------------------------------------------------
    if (not !shoe.styp.upcase() inset('AT05','AT09')) then
      --<wd>dec2006<mds12>
      --!!alert.error('The Guide standard $!!codeGT03 may ONLY be placed on a Reinforcing Plate standard - $!!codeAT05 or $!!codeAT09')
      !!alert.error('The Guide standard $!gt03code may ONLY be placed on a Reinforcing Plate standard - $!at05code or $!at09code')
      --<wd>dec2006<mds12>
      golabel /IdentifyA
    endif
    -- Error if Identified Pad is NOT on the previously Identified Branch
    if (!shoe.owner.neq(!form.support.idBran)) then
      !!alert.error('The Identified Reinforcing Pad MUST be on the same Pipe Branch as previously identified')
      golabel /IdentifyA
    endif
    --        if (!shoe.name.match(!form.support.stru.name).neq(1)) then
    --          !!alert.error('The Identified Reinforcing Pad MUST be on the current MDS framework $!form.support.stru.name')
    --          golabel /IdentifyA
    --        endif
  endif
  -------------------------------------------------------------

  --<wd>12jan2010 - DFN P-27844 SI-19722 - Added STOPS - ST45,ST46,ST47,ST48,ST49,ST50 and GUIDES - GT65,GT66,GT67,GT68,GT69,GT84
  -- 'GT11','GT12A','GT12B','GT27A','GT27B','ST07','ST33'
  if (!selection inset ('GT11','GT12A','GT12B','GT27A','GT27B','ST07','ST33','ST45','ST46','ST47','ST48','ST49','ST50','GT65','GT66','GT67','GT68','GT69','GT84')) then
    -- MDS Trunnion Base Plate Guides/Stops
    label /IdentifyB
    prompt off
    prompt load escape 'Identify Trunnion Base Plate'
    ID PLAT @
    handle (61,528)
      prompt on
      -- Reset OK button Callback so as NOT to SHOW the ROTATE ATTA FORM
      !!mdsAncill.action[2] = ''
      !!mdsAncill.action[3] = ''
      !!mdsAncill.action[4] = ''
      !this.return = FALSE
      return
    endhandle
    prompt on
    !shoe = !!ce

    -- Error if Identified Trunnion Base Plate is NOT on the previously Identified Trunnion Branch
    if (!shoe.owner.neq(!form.support.idBran)) then
      !!alert.error('The Identified Trunnion Base Plate MUST be on the same Trunnion Pipe Branch as previously identified')
      golabel /IdentifyB
    endif
    -- Ensure Correct type of Trunnion Base Plate is Identified
    -- GE 07/04/05 Added type AC57
    --  if (not !shoe.styp inset ('AC18A','AC18B','AC30')) then
    --<wd>12jan2010 - DFN P-27844 SI-19722 - Added
    --if (not !shoe.styp inset ('AC18A','AC18B','AC30','AC57','AC60','AC61','AC62')) then
    if (not !shoe.styp inset('AC18A','AC18B','AC30','AC57','AC60','AC61','AC62','AC63','AC64','AC65','AC67')) then
      !!alert.error('This Guide/Stop may NOT be placed on the identified type of Trunnion Base Plate. Creation aborted!')
      golabel /IdentifyB
    endif

    -- GE 07/04/05 Stop the initial rotate form
    if (!shoe.styp inset ('AC57')) then
      !!mdsAncill.action[12] = ''
      !!mdsAncill.action[13] = ''
    endif
    -- End of fix

    -- Error if the :mdsGuideRef of the Identified Trunnion Base Plate is already SET to another MDS Ancillary

  endif
  -------------------------------------------------------------

  -- "ST08" and "AN05"
  if (!selection inset ('ST08','AN05')) then
    -- MDS Trunnion Base Plate Temporary Stops
    label /IdentifyC
    prompt off
    prompt load escape 'Identify Trunnion Bearing Plate'
    ID PLAT @
    handle (61,528)
      prompt on
      -- Reset OK button Callback so as NOT to SHOW the ROTATE ATTA FORM
      !!mdsAncill.action[2] = ''
      !!mdsAncill.action[3] = ''
      !!mdsAncill.action[4] = ''
      !this.return = FALSE
      return
    endhandle
    prompt on
    !shoe = !!ce
    -- Error if Identified Trunnion Base Plate is NOT on the previously Identified Trunnion Branch
    if (!shoe.owner.neq(!form.support.idBran)) then
      !!alert.error('The Identified Trunnion Bearing Plate MUST be on the same Trunnion Pipe Branch as previously identified')
      golabel /IdentifyC
    endif
    -- Ensure Correct type of Trunnion Base Plate is Identified
    if (not !shoe.styp inset ('AC19A','AC19B')) then
      !!alert.error('This Stop/Restraint may ONLY be placed on a Trunnion Bearing Plate. Creation aborted!')
      golabel /IdentifyC
    endif
  endif
  -------------------------------------------------------------

  -- 'AT30','SU03','SU04'
  -- MDS Shims and Slip Units for PIPE Shoes ONLY
  if ((!selection inset ('AT30','SU03','SU04')) or (!selection.matchwild('SU01*')) or (!selection.matchwild('SU02*')) ) then
    -- Identify Pipe Shoe to which to attach the Slip Unit
    label /IdentifyD
    prompt off
    prompt load escape 'Identify Pipe Shoe'
    ID ATTA @
    handle (61,528)
      prompt on
      -- Reset OK button Callback so as NOT to SHOW the ROTATE ATTA FORM
      !!mdsAncill.action[2] = ''
      !!mdsAncill.action[3] = ''
      !!mdsAncill.action[4] = ''
      !this.return = FALSE
      return
    endhandle
    prompt on
    !shoe = !!ce
    -- Error if it is NOT a Pipe Shoe
    if (!!ce.catref.owner.:mdsGuidable.not()) then
      !!alert.error('The Identified element must be a Pipe Shoe for the selected ancillary.')
      golabel /IdentifyD
    endif
    -- Error if Identified Pipe Shoe is NOT on the previously Identified Branch
    if (!shoe.owner.neq(!form.support.idBran)) then
      !!alert.error('The Identified Pipe Shoe MUST be on the same Pipe Branch as previously identified')
      golabel /IdentifyD
    endif
    if (!shoe.name.match(!form.support.stru.name).neq(1)) then
      !!alert.error('The Identified Pipe Shoe MUST be on the current MDS framework $!form.support.stru.name')
      golabel /IdentifyD
    endif
    -- Error if selected Pipe Shoe already references a Slip Unit, Guide etc....
    if (!shoe.:mdsGuideRef.badref().not() and !shoe.:mdsGuideRef.neq(nulref) and !shoe.:mdsGuideRef.catref.owner.:mdsType.eq('SLIP')) then
      !!alert.error('The Selected Pipe Shoe already has a Slip Unit attached. Creation aborted.')
      golabel /IdentifyD
    endif
    -- Error if Identified Pipe Shoe is the DATUM Atta on a MDS STANDARD Framework
    --        if (!form.name().neq('MDSSPECIAL')) then
    --          if ((!shoe.name.matchwild('*/DATUM')) or (!shoe.name.matchwild('*/SREF'))) then
    --            !!alert.error('The Identified Pipe Shoe is the DATUM Atta. The selected ancillary may NOT be added to the DATUM Atta.')
    --            golabel /IdentifyD
    --          endif
    --        endif
  endif
  -------------------------------------------------------------

  -- 'AT33A'to 'AT33F', 'AT34A' to 'AT34F', 'AT35','AT100A','AT100B'
  -- MDS Isolation Pads and Slide Units for Trunnion Base Plates ONLY
  if (!selection inset ('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT100A','AT100B')) then
    -- Identify Trunnion Base Plate if Pipe is a TRUNNION Branch i.e. !insuType = 'TRUNNION'
    !insuType = 'TRUNNION'
    !id = 'Trunnion Base Plate'
    label /IdentifyE
    prompt off
    prompt load escape 'Identify $!id'
    id plat @
    handle (61,528)
      prompt on
      -- Reset OK button Callback so as NOT to SHOW the ROTATE ATTA FORM
      !!mdsAncill.action[2] = ''
      !!mdsAncill.action[3] = ''
      !!mdsAncill.action[4] = ''
      return
    endhandle
    prompt dismiss
    prompt on
    -- Identified PLAT Component
    !shoe = !!ce
    -- Error if the :mdsGuideRef of the Identified Trunnion Base Plate is already SET to another MDS Ancillary
    if (!shoe.:mdsGuideRef.badref().not()) then
      --<ge 03/04/05> Fix for HPD0028026 allowing the addition of MDS Isolation Pads and Slide Units for Trunnion Base Plates
      -- even if the :mdsGuideRef is set but not too a MDS Isolation Pads and Slide Units for Trunnion Base Plates
      if (!shoe.:mdsGuideRef.stype inset ('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT100A','AT100B')) then
        if !!mdsEditProp.shown().not() then
          -- !!alert.error('The Identified Trunnion Base Plate UDA :mdsGuideRef already references another component. Creation aborted!')
          -- golabel /IdentifyE
          !!alert.error('The Identified Trunnion Base Plate UDA :mdsGuideRef already references another Isolation Pad or Slide Unit. Creation aborted!')
          !!mdsAncill.action[2] = ''
          !!mdsAncill.action[3] = ''
          !!mdsAncill.action[4] = ''
          !this.return = FALSE
          return
        endif
      endif
    endif
    -- Check if the Selected PLAT is on a Trunnion Branch
    if (!shoe.owner.:mdsTrun) then
      -- Check if the Selected PLAT is a VALID Trunnion Base Plate
      -- if (!shoe.styp inset ('AC18A','AC18B','AC30','AC47')) then
      --ge/07/12/04 Fix for HPD0027087 AC57 is not recognised as a base plate
      if (!shoe.styp inset ('AC18A','AC18B','AC30','AC47','AC57','AC60','AC61','AC62','AC63','AC64','AC65','AC66','AC67')) then
        -- Check if the Selected Atta is the LAST Member of the Trunnion Branch
        if (!!ce.owner.mcount().eq(!!ce.order)) then
          -- It is OK to Continue with the Creation as the Trunnion Base Plate is the Last member
          -- NOTHING to do Here - see below the method --> !this.guideAfter(etc...) <-- for the continuation...
        else
          --<<ge 09/10/05>>
          --if (!!ce.owner.mcount().eq(!!ce.order + 2)) then
          if (!!ce.owner.mcount().eq(!!ce.order + 3)) or (!!ce.owner.mcount().eq(!!ce.order + 2)) then
            -- ONLY continue if a PIPE-REST DATUM Atta and a MDS SPECIAL SREF Atta exists
            next
            if (!!ce.type.eq('ATTA')) then
              if (!!ce.stype inset ('PIPE-REST','PIPE-REST-INLINE')) then
                next
                if (!!ce.type.eq('ATTA')) then
                  if (!!ce.stype inset ('SPECIAL')) then
                    next
                    handle NONE
                      !!alert.error('Identified Trunnion has more than the allowable number (2) of MDS ATTAS after the Trunnion Base Plate')
                      golabel /IdentifyE
                    elsehandle (2,113) $* List Exhausted
                      -- It is OK to Continue with the Creation as ONLY the MDS SPECIAL Pipe Rest DATUM and SREF ATTAS exist
                      -- NOTHING to do Here - see below the method --> !this.guideAfter(etc...) <-- for the continuation...
                    endhandle
                  endif
                endif
              endif
            else
              !!alert.error('Unable to add an Isolation Pad/Slide Unit to the Identified Trunnion Base Plate.')
              golabel /IdentifyE
            endif
          else
            --!!alert.error('Identified Trunnion Base Plate MUST be the LAST Branch Member')
            !!alert.error('Unable to add an Isolation Pad/Slide Unit to the Identified Trunnion Base Plate.')
            golabel /IdentifyE
          endif
        endif
      else
        !!alert.error('Identified Plate is NOT a VALID Trunnion Base Plate')
        golabel /IdentifyE
      endif
    else
      !!alert.error('Identified Plate is NOT on a Trunnion Support')
      golabel /IdentifyE
    endif
  endif
  -------------------------------------------------------------

  -- 'AT05','AT09','AT23','AT52A','AT52B','AT52C','AT52D','AT52E','AT52F','AT65'
  -- MDS Reinforcing Pads for Pipes and Pipe Shoes Only
  if (!selection inset ('AT05','AT09','AT23','AT52A','AT52B','AT52C','AT52D','AT52E','AT52F','AT65')) then
    if (!selection inset ('AT23') and (!form.string().upcase().neq('MDSFT54B') and !form.string().upcase().neq('MDSFT55B'))) then
      !insuType = !!mdsreinfpad.type.selection()
      -- Either -(1) Identify Pipe SHOE if Pipe is INSULATED i.e. !insuType = 'SHOE'
      if (!insuType.eq('SHOE')) then
        !id = 'Pipe Shoe'
        label /IdentifyF
        prompt off
        prompt load escape |Identify $!id|
        id atta @
        handle (61,528)
          prompt on
          -- Reset OK button Callback so as NOT to SHOW the ROTATE ATTA FORM
          !!mdsAncill.action[2] = ''
          !!mdsAncill.action[3] = ''
          !!mdsAncill.action[4] = ''
          return
        endhandle
        prompt dismiss
        prompt on
        -- Identified Component
        !shoe = !!ce
        -- Error if it is NOT a Pipe Shoe
        if (!shoe.catref.owner.:mdsGuidable.not()) then
          !!alert.error('Identified element is NOT a Pipe SHOE.')
          golabel /IdentifyF
        endif
        -- Error if Identified Pipe Shoe is NOT on the previously Identified Branch
        if (!shoe.owner.neq(!form.support.idBran)) then
          !!alert.error('The Identified Pipe SHOE MUST be on the same Pipe Branch as previously identified')
          golabel /IdentifyF
        endif
        if (!shoe.name.match(!form.support.stru.name).neq(1)) then
          !!alert.error('The Identified Pipe SHOE MUST be on the current MDS framework $!form.support.stru.name')
          golabel /IdentifyF
        endif
        -- Check if a DATUM or SREF Atta
        if (!shoe.name.match('/DATUM').gt(1)) then
          -- DATUM ATTA of a MDS FRAMEWORK Support Identified
          !datumNam = !shoe.name
          !srefName = !shoe.name.replace('/DATUM','/SREF')
          !srefAtta = !srefName.dbref()
          !srefSele = true
        elseif (!shoe.name.match('/SREF').gt(1)) then
          -- SREF ATTA of a MDS FRAMEWORK Support Identified
          !srefName = !shoe.name
          !srefAtta = !shoe.name.dbref()
          !srefSele = true
          !datumNam = !shoe.name.replace('/SREF','/DATUM')
          !shoe     = !datumNam.dbref()
        else
          -- Independent MDS Pipe Support Atta Selected
          !datumNam = !shoe.name
          !srefSele = false
        endif
        -- Is it a Pipe SHOE or the SREF Atta of a DATUM Atta which is a Pipe SHOE
        if (!shoe.catref.owner.:mdsType.neq('SHOE')) then
          -- SEE ABOVE
          --           !!alert.error('Identified element is not a Pipe SHOE')
          --            golabel /IdentifyF
        else
          -- Is the Identified Pipe SHOE UNINSULATED
          if  !shoe.inth.unset().or(!shoe.inth.eq(0)) then
            if(!!alert.confirm('Identified SHOE is on an UNINSULATED Pipe. Do you want to continue?').eq('NO')) then
              golabel /IdentifyF
            endif
          endif
        endif
        --------------------------------------------------------------------------------------------
        -- Or -(2) Identify PIPE if PIPE is UNINSULATED i.e. !insuType = 'PIPE'
      elseif (!insuType.eq('PIPE')) then
        !tubeType = !!mdsoptions.pipes
        if (!tubeType eq 'FTUB')then
          !pipeType = 'lined section'
        else
          !pipeType = 'tube'
        endif
        !idType = 'pipe'
        !purp = 'PIPE'
        label /IdentifyG
        if (!!mdsidtube(!tubeType, 'Identify $!pipeType of $!idType',!purp).not())then
          prompt on
          !!mdsAncill.action[2] = ''
          !!mdsAncill.action[3] = ''
          !!mdsAncill.action[4] = ''
          prompt dismiss
          prompt on
          return
        endif
        -- Is the Identified Pipe UNINSULATED
        if  !!ce.inth.unset().or(!!ce.inth.eq(0)).not() then
          !!alert.error('Identified Pipe has INSULATION')
          golabel /IdentifyG
        endif
        -- ALWAYS Set the Variable !srefSele to FALSE for This OPTION
        !srefSele = false
      endif
      -- Create the PAD Atta after the SREF ATTA of a MDS Framework Support Pipe SHOE
      if (!srefSele) then
        !!ce = !srefAtta
      endif
    endif
  endif
  -------------------------------------------------------------

  -- 'AT53A','AT53B'
  -- MDS Shear Lugs for Clamp-On Pipe Shoes Only i.e. MDS Support types 'AT55A','AT55B','AT56' ONLY
  if (!selection inset ('AT53A','AT53B')) then
    -- Identify Pipe Shoe to which to attach the Shear Lugs
    label /IdentifyH
    prompt off
    prompt load escape 'Identify Pipe SHOE'
    ID ATTA @
    handle (61,528)
      prompt on
      -- Reset OK button Callback so as NOT to SHOW the ROTATE ATTA FORM
      !!mdsAncill.action[2] = ''
      !!mdsAncill.action[3] = ''
      !!mdsAncill.action[4] = ''
      !this.return = FALSE
      return
    endhandle
    prompt on
    !shoe = !!ce
    -- Error if Identified Pipe SHOE is NOT on the previously Identified Branch
    if (!shoe.owner.neq(!form.support.idBran)) then
      !!alert.error('The Identified Pipe SHOE MUST be on the same Pipe Branch as previously identified')
      golabel /IdentifyH
    endif
    if (!shoe.name.match(!form.support.stru.name).neq(1)) then
      !!alert.error('The Identified Pipe SHOE MUST be on the current MDS framework $!form.support.stru.name')
      golabel /IdentifyH
    endif
    -- Error if it is NOT the Correct Type of Pipe SHOE
    if (not !shoe.stype inset('AT55A','AT55B','AT56')) then
      ---------------------------------------------------------------------------------------------------
      --<wd>dec2006<mds12> -- Remove any Reference to the !!code.... Global Variables
      --!codeA = !!codeAT55a
      --!codeB = !!codeAT55b
      --!codeC = !!codeAT56
      -- Determine the Client Codes from the PARAGON MDS12 Defaults for AT55A, AT55B and AT56
      !codeA = !!mdsGetDefProp('ATTA', 'AT55A', 'CCOD')
      if (!codeA.eq(|ERROR|)) or (!codeA.trim().eq(||)) then
        -- Use the AVEVA MDS STANDARD NAME
        !codeA = |AT55A|
      endif
      !codeB = !!mdsGetDefProp('ATTA', 'AT55B', 'CCOD')
      if (!codeB.eq(|ERROR|)) or (!codeB.trim().eq(||)) then
        -- Use the AVEVA MDS STANDARD NAME
        !codeB = |AT55B|
      endif
      !codeC = !!mdsGetDefProp('ATTA', 'AT56', 'CCOD')
      if (!codeC.eq(|ERROR|)) or (!codeC.trim().eq(||)) then
        -- Use the AVEVA MDS STANDARD NAME
        !codeC = |AT56|
      endif
      --<wd>dec2006<mds12>
      ---------------------------------------------------------------------------------------------------
      !!alert.error('The selected Shear Lugs may ONLY be associated with the Pipe SHOE types ''$!codeA'',''$!codeB'',''$!codeC''')
      golabel /IdentifyH
    endif
  endif
  -------------------------------------------------------------

  -- 'AT59','AT68'
  -- MDS Cold Isolation Blocks for Trunnion Base Plates ONLY
  if (!selection inset ('AT59','AT68')) then
    -- Identify Trunnion Base Plate if Pipe is a TRUNNION Branch i.e. !insuType = 'TRUNNION'
    -- Set Pipe Creation Type to 'TRUNNION' for Trunnion with Base Plate
    !insuType = 'TRUNNION'
    -- Identify Trunnion Base Plate if Pipe is a TRUNNION Branch i.e. !insuType = 'TRUNNION'
    if (!insuType.eq('TRUNNION')) then
      !id = 'Trunnion Base Plate'
      label /IdentifyI
      prompt off
      prompt load escape |Identify $!id|
      id plat @
      handle (61,528)
        prompt on
        -- Reset OK button Callback so as NOT to SHOW the ROTATE ATTA FORM
        !!mdsAncill.action[2] = ''
        !!mdsAncill.action[3] = ''
        !!mdsAncill.action[4] = ''
        return
      endhandle
      prompt dismiss
      prompt on
      -- Identified Trunnion Base Plate Component
      !shoe = !!ce
      -- Error if the :mdsGuideRef of the Identified Trunnion Base Plate is already SET to another MDS Ancillary
      if (!shoe.:mdsGuideRef.badref().not()) then
        !!alert.error('The Identified Trunnion Base Plate UDA :mdsGuideRef already references another component. Creation aborted!')
        golabel /IdentifyI
      endif
      -- Initialise MDS Trunnion Selection Variable
      !trunSele = false
      -- Check if the Selected Base Plate is on a MDS Trunnion Branch
      if (!shoe.owner.:mdsTrun) then
        -- Get and Check the :mdsSuppType of the Trunnion Branch
        !datumNam = !shoe.name.before('.')
        !srefName = !datumNam & '/SREF'
        !!ce      = !srefName.dbref()
        handle any
          !!alert.error('Identified plate is NOT on a valid MDS trunnion support')
          golabel /IdentifyI
        elsehandle none
          -- Get the Client CODE and DESCRIPTION for AT59
          ---------------------------------------------------------------------------------------------------
          --<wd>dec2006<mds12>
          -- The Global CODE and DESC variables are NO LONGER declared for MDS12 -- Use instead the new PML function !!mdsGetDefProp()
          -- Determine the Client Code from the PARAGON MDS12 Defaults
          --!code = !!code$!selection
          !code = !!mdsGetDefProp('ATTA', '!selection', 'CCOD')
          if (!code.eq(|ERROR|)) or (!code.trim().eq(||)) then
            -- Use the AVEVA MDS STANDARD NAME
            !code = !selection
          endif
          -- Determine the Client Description from the PARAGON MDS12 Defaults
          --!desc = !!desc$!selection
          !desc = !!mdsGetDefProp('ATTA', '!selection', 'DESC')
          if (!desc.eq(|ERROR|)) or (!desc.trim().eq(||)) then
            -- Use the AVEVA MDS STANDARD DESCRIPTION
            !desc = |Trunnion Cold Isolation Block with Integral Base Plate|
          endif
          --<wd>dec2006<mds12>
          ---------------------------------------------------------------------------------------------------
          -- Check if the Trunnion SREF atta LBORE is within the BORE RANGE required by the Cold Isolation Block - AT59 i.e. (38.1mm<1.1/2in.> to 406.4mm<16in>)
          if (!!ce.lbor.real().between(38.1,406.4)) then
            -- MDS AT59 Standard does NOT cater for 125/5in. NPS Trunnion Pipe Diameters
            if (!!ce.lbor.real().between(125,127)) then
              !mmbore = !!ce.lbor.real().string()
              !!alert.error('The selected trunnion has a NPS of $!<mmbore>mm<5in.> which is NOT permitted for use with this MDS standard ''$!code''.')
              golabel /IdentifyI
            endif
          else
            -- Selected Trunnion NPS is NOT within the permitted BORE range for - AT59
            !!alert.error('The selected trunnion has a NPS which is NOT within the permitted bore range of 40mm<1.1/2in.> to 400mm<16in.>, for this MDS standard ''$!code''.')
            golabel /IdentifyI
          endif
          -- Initialise Selected Trunnion SREF variables
          !srefDbref = !srefName.dbref()
          !trunType  = !!ce.:mdsSuppType
          ---------------------------------------------------------------------------------------------------
          --<wd>dec2006<mds12>
          --!trunCode = !!code$!<trunType>
          -- Determine the Client Code from the PARAGON MDS12 Defaults
          !trunCode = !!mdsGetDefProp('TRUNNION', '!trunType', 'CCOD')
          if (!trunCode.eq(|ERROR|)) or (!trunCode.trim().eq(||)) then
            -- Use the AVEVA MDS STANDARD NAME
            !trunCode = !trunType
          endif
          --<wd>dec2006<mds12>
          ---------------------------------------------------------------------------------------------------

          -- Navigate back to Identified Base Plate and Get the Branch Head Bore Size
          !!ce  = !shoe
          --<wd>18jan2008--removed in appspag check              !hbor = !shoe.owner.hbor
        endhandle
        -- Check if MDS Trunnion Type is VALID to place an AT59-Cold Isolation Block under the Trunnion Base Plate
        if (!trunType inset ('TT18','TT19','TT25')) then
          -- Selected Trunnion Type is NOT ALLOWED to have an ** AT59 ** ancillary
          !!alert.error('A ''$!code'' is NOT permitted on the selected trunnion type ''$!trunCode''.')
          golabel /IdentifyI
        endif
        --ge/07/12/04 Fix for HPD0027087 Added TT37 to the list
        if (!trunType inset ('TT04','TT06','TT08','TT10','TT12','TT18','TT22','TT25','TT26','TT36','TT37')) then
          ---------------------------------------------------------------------------------------------------
          --<wd>dec2006<mds12>
          -- The TRUNNION is on a MDS FRAMEWORK so a "PIPE-REST-INLINE" DATUM and its associated SREF ATTA will EXIST as well.
          -- Therefore the Trunnion Base Plate WILL NOT be the LAST Branch Member, but the LAST Branch Member minus 2
          --
          -- For these Trunnion Types - The identified base plate MUST be the LAST branch member
          --if (!!ce.owner.mcount().eq(!!ce.order)) then
          if (!!ce.owner.mcount().eq(!!ce.order + 2)) then
            --<wd>dec2006<mds12>
            ---------------------------------------------------------------------------------------------------
            -- OK to Continue with the Creation so SET the variable
            !trunSele = TRUE
          else
            !!alert.error('Identified trunnion base plate MUST be the LAST branch member of the selected trunnion type - ''$!trunCode'' ')
            golabel /IdentifyI
          endif
        elseif (!trunType inset ('TT05','TT07','TT09','TT11','TT13','TT19','TT28')) then
          ---------------------------------------------------------------------------------------------------
          --<wd>dec2006<mds12>
          -- The TRUNNION is on a MDS FRAMEWORK so a "PIPE-REST-INLINE" DATUM and its associated SREF ATTA will EXIST as well.
          -- Therefore the Trunnion Base Plate WILL NOT be the PENULTIMATE Branch Member, but the LAST Branch Member minus 3
          --
          -- For these Trunnion Types - The identified base plate MUST be the PENULTIMATE branch member (i.e. before the Bearing Plate)
          --if ((!!ce.owner.mcount() - 1 ) eq (!!ce.order)) then
          if ((!!ce.owner.mcount() - 3 ) eq (!!ce.order)) then
            -- OK to Continue with the Creation so SET the variable
            !trunSele = true
          else
            -- $P===========
            -- q var !!ce.owner.mcount() - 1
            -- q var !!ce.order
            -- $P===========================
            !!alert.error('Identified trunnion base plate MUST be the PENULTIMATE branch member of the selected trunnion type - ''$!trunCode'' ')
            golabel /IdentifyI
          endif
        else
          !!alert.error('The identified plate on the MDS trunnion support is NOT suitable for use with the MDS ancillary type ''$!code'' - ''a $!desc''')
          golabel /IdentifyI
        endif
        -- Check if the Selected Plate is a VALID Trunnion Base Plate
        if (!trunSele) then
          if (!shoe.styp inset ('AC30')) then
            -- Adjustable Base Plate for TT18 and TT19
            ---------------------------------------------------------------------------------------------------
            --<wd>dec2006<mds12>
            --!altTrunA = !!codeTT04
            !altTrunA = !!mdsGetDefProp('TRUNNION', 'TT04', 'CCOD')
            if (!altTrunA.eq(|ERROR|)) or (!altTrunA.trim().eq(||)) then
              -- Use the AVEVA MDS STANDARD NAME
              !altTrunA = |TT04|
            endif
            --!altTrunB = !!codeTT05
            !altTrunB = !!mdsGetDefProp('TRUNNION', 'TT05', 'CCOD')
            if (!altTrunB.eq(|ERROR|)) or (!altTrunB.trim().eq(||)) then
              -- Use the AVEVA MDS STANDARD NAME
              !altTrunB = |TT05|
            endif
            --<wd>dec2006<mds12>
            ---------------------------------------------------------------------------------------------------
            !!alert.error('Unable to modify the identified ADJUSTABLE Base Plate on the trunnion type ''$!trunCode''.$
            To add a ''$!code'' here you MUST :- Delete the existing trunnion type ''$!trunCode'', and replace it with a trunnion type e.g. ''$!altTrunA'' or ''$!altTrunB'' etc.')
            golabel /IdentifyI
          elseif (not !shoe.styp inset ('AC18A','AC18B','AC47','AC49','AC60','AC61','AC62')) then
            -- Identified Plate is NOT ONE of the MDS Trunnion BASE PLATES
            !!alert.error('Identified Plate is NOT a VALID Trunnion Base Plate')
            golabel /IdentifyI
          endif
        endif
        -- End of !trunSele
      else
        -- Not on a Valid MDS Trunnion Support
        !!alert.error('Identified Plate is NOT on a MDS Trunnion Support')
        golabel /IdentifyI
      endif
    endif
    -- End of Identify Trunnion Base Plate
    -- Ensure PDMS navigation mode is FORWARDS
    --<wd>18jan2008--removed in appspag check        var !mode mode
    forwards
    -- Check if PIPE is NOT Vertical and within the Maximum Slope Allowed
    -- for Horizontal Pipes, displayed on the 'Settings>Options...' form.
    !currComp = !!ce
    if (!!ce.type eq 'BRAN') then
      !hdir = hdir wrt /*
    else
      !hdir = pl dir wrt /*
    endif
    if (!hdir neq U and !hdir neq D ) then
      if (!!mdsgradient(!currComp)) then
        !!alert.message ('The pipe identified is not within the maximum slope for horizontal pipes as defined in the application defaults ($!!mdsoptions.slope.val)')
        --<wd>18jan2008
        --           !!ce = !ceComp
        !!ce = !currComp
        --<wd>18jan2008
        !!kRestoreUnits(!currentunits)
        return
      endif
    endif
  endif
  -------------------------------------------------------------

  -- 'AT62','AT69'
  -- MDS Adjustable Guide Inserts - Only the 'AT62' or 'AT69' MDS Standard types may be aligned
  if (!selection inset ('AT62','AT69')) then
    ---------------------------------------------------------------------------------------------------
    ---------------------------------------------------------------------------------------------------
    --<wd>dec2006<mds12>
    -- The Global CODE and DESC variables are NO LONGER declared for MDS12 -- Use instead the new PML function !!mdsGetDefProp()
    -- Determine the Client Code from the PARAGON MDS12 Defaults
    --!codZ = '$$' & '!!code' & !selection
    --!codX = '$!codZ'
    !codX = !!mdsGetDefProp('ATTA', '!selection', 'CCOD')
    if (!codX.eq(|ERROR|)) or (!codX.trim().eq(||)) then
      -- Use the AVEVA MDS STANDARD NAME
      !codX = !selection
    endif
    -- Determine the Client Description from the PARAGON MDS12 Defaults
    --!desZ = '$$' & '!!desc' & !selection
    --!desX = '$!desZ'
    !desX = !!mdsGetDefProp('ATTA', '!selection', 'DESC')
    if (!desX.eq(|ERROR|)) or (!desX.trim().eq(||)) then
      -- Use the AVEVA MDS STANDARD DESCRIPTION
      !desX = |Adjustable Guide Insert Bolts - NPS 2"-48"|
    endif
    --<wd>dec2006<mds12>
    ---------------------------------------------------------------------------------------------------

    -- Identify the element you wish to ALIGN where the DATASET contains
    -- Either the DKEY prop HEI for Pipe Shoes or DKEY prop OHEI for Slip Unit heights
    if (!!alert.confirm('Do you want to ALIGN the selected ancillary type ''$!codX'' with a Pipe Shoe or Slide Unit?') eq 'YES') then
      label /IdentifyJ
      prompt off
      prompt load escape 'Identify element you wish to align the adjustable guide to'
      ID ATTA @
      handle (61,528)
        prompt on
        return
      endhandle
      prompt on
      !shoe = !!ce
      -- Make sure its not another 'AT62' or 'AT69'
      if (!shoe.styp inset ('AT62','AT69')) then
        !!alert.error('Cannot identify another ''Adjustable Guide Insert''.')
        golabel /IdentifyJ
      endif
      -- Error if Identified Pipe Shoe is NOT on the previously Identified Branch
      if (!shoe.type.eq('BRAN')) then
        if (!shoe.neq(!form.support.idBran)) then
          !!alert.error('The Identified Branch MUST be the same Pipe Branch as previously identified')
          golabel /IdentifyJ
        endif
      else
        if (!shoe.owner.neq(!form.support.idBran)) then
          !!alert.error('The Identified Element MUST be on the same Pipe Branch as previously identified')
          golabel /IdentifyJ
        endif
      endif
      if (!shoe.name.match(!form.support.stru.name).neq(1)) then
        !!alert.error('The Identified Element MUST be on the current MDS framework $!form.support.stru.name')
        golabel /IdentifyJ
      endif
      -- Check if the identified element has a property 'HEI' or 'OHEI'
      !height = !shoe.prop.hei
      handle any
        !height = !shoe.prop.ohei
        handle any
          !!alert.error('Identified element does not have a height value <i.e. a DKEY of ''HEI'' or ''OHEI''>')
          golabel /IdentifyJ
        endhandle
      endhandle
    endif
  endif
  -------------------------------------------------------------

  -- 'AT60'
  -- MDS Flange Support for FRP/RTR Pipes Only
  -- ***********************
  -- *** IMPORTANT NOTE: ***
  -- ***********************
  -- As of feb 2004 - 'AT60' is currently the ONLY MDS Ancillary Standard to use "EDG" for Identifying
  -- a "Flange Face" - This is actioned via the callback on the list gadget ".standard" on the form
  -- !!mdsAncill -- See the callback - !!mdsAncill.callb() method - for further information!
  if (!selection inset ('AT60')) then
    -- Navigate to the Identified FLANGE
    !shoe  = !!mdsAncill.flan
    !leave = !shoe.leave
    !this.offSet = !!mdsAncill.offSet
    -- Determine where to Create the Support - BEFORE or AFTER the Identified Flange
    if (!leave eq 2) then
      -- Identified the back face of the flange where PLEAVE is at P2
      !where = ' after '
    else
      -- Identified the Back face of the Flange where PLEAVE is at P1. So the 'AT60' needs to be before the flange
      !where = ' before '
    endif
    !this.where = !where
  elseif (!selection inset ('AT185')) then
    -- Navigate to the Identified valve so that an atta can be created there
    !shoe  = !!mdsAncill.flan
    !form.support.position = TRUE
    --ensure that the
    !form.support.idComp = !shoe
  endif
  -------------------------------------------------------------

  -- 'AT61'
  -- MDS Vertical Pipe Annular Attachment - NPS 12" to 48"
  if (!selection inset ('AT61')) then
    -- Error if Identified Pipe is NOT Vertical
    !comp = !!ce
    if (!comp.type eq 'BRAN') then
      pin 9 copy ph
      var !p9dir pin 9 dir wrt /*
      if ('$!p9dir' neq |U|) and ('$!p9dir' neq |D|) then
        ---------------------------------------------------------------------------------------------------
        --<wd>dec2006<mds12> -- Remove any Reference to the !!code.... Global Variables
        -- Determine the Client Codes from the PARAGON MDS12 Defaults for AT61
        !at61code = !!mdsGetDefProp('ATTA', 'AT61', 'CCOD')
        if (!at61code.eq(|ERROR|)) or (!at61code.trim().eq(||)) then
          -- Use the AVEVA MDS STANDARD NAME
          !at61code = |AT61|
        endif
        --!!alert.error('Identified Pipe is NOT vertical. Aborting creation of ''$!!codeAT61''.')
        !!alert.error('Identified Pipe is NOT vertical. Aborting creation of ''$!at61code''.')
        --<wd>dec2006<mds12>
        ---------------------------------------------------------------------------------------------------
        !this.return = FALSE
        -- Reset OK button Callback so as NOT to SHOW the ROTATE ATTA FORM
        !!mdsAncill.action[2] = ''
        !!mdsAncill.action[3] = ''
        !!mdsAncill.action[4] = ''
        return
      endif
      !!mdsResetPins(9,9)
    else
      !plTest = pl dir wrt /*
      if ('$!plTest' eq |U WRT /*|) or ('$!plTest' eq |D WRT /*|) then
      else
        --<wd>dec2006<mds12>
        --!!alert.error('Identified Pipe is NOT vertical. Aborting creation of ''$!!codeAT61''.')
        !!alert.error('Identified Pipe is NOT vertical. Aborting creation of ''$!at61code''.')
        --<wd>dec2006<mds12>
        !this.return = FALSE
        -- Reset OK button Callback so as NOT to SHOW the ROTATE ATTA FORM
        !!mdsAncill.action[2] = ''
        !!mdsAncill.action[3] = ''
        !!mdsAncill.action[4] = ''
        return
      endif
    endif
    !!ce = !comp
  endif
  -------------------------------------------------------------

  -- 'AT40A','AT40B','AT40C','AT40D','AT40E','AT40F','AT41A','AT41B','AT41C','AT41D','AT41E','AT41F','AT42','AT101A','AT101B'
  -- MDS Ancillary Isolation Pads, Slide Units
  if (!selection inset ('AT40A','AT40B','AT40C','AT40D','AT40E','AT40F','AT41A','AT41B','AT41C','AT41D','AT41E','AT41F','AT42','AT101A','AT101B')) then

    -- The 'form.support.idComp' member is set when the pipe/component is first identified via
    -- the 'Create Datum Atta' or 'Add pipe' buttons on the MDS Standard and Special Framework forms
    !shoe  = !form.support.idComp
    if !shoe.unset() then
      -- q var !shoe.stype
      !shoe = !!ce
    endif
    !abort = FALSE
    !insuType = !!mdsreinfpad.type.selection()
    -- Error if Identified Pipe Shoe is NOT on the previously Identified Branch
    if (!shoe.type.eq('BRAN')) then
      if (!shoe.neq(!form.support.idBran)) then
        !!alert.error('The Identified Branch MUST be the same Pipe Branch as previously identified')
        !abort = TRUE
        golabel /IdentifyK
      endif
    else
      if (!shoe.owner.neq(!form.support.idBran)) then
        !!alert.error('The Identified Component MUST be on the same Pipe Branch as previously identified')
        !abort = TRUE
        golabel /IdentifyK
      endif
    endif
    -- Error Only if Identified Component is a Pipe Shoe and Conditions shown below do NOT comply.
    if (!insuType.eq('SHOE')) then
      if (!shoe.name.match(!form.support.stru.name).neq(1)) then
        !!alert.error('The Identified Component MUST be on the current MDS framework $!form.support.stru.name')
        !abort = TRUE
        golabel /IdentifyK
      endif
      -- Error if selected Pipe Shoe already references a Slip Unit, Guide etc....
      -- <<ge 10/03/05 Added next line to allow users to change between A101A/AT101B for KBR
      if (!!mdsEditProp.shown().not() and not !!ce.stype inset ('AT101A','AT101B')) then
        if (!shoe.:mdsGuideRef.badref().not() and !shoe.:mdsGuideRef.neq(nulref) and !shoe.:mdsGuideRef.catref.owner.:mdsType.eq('SLIP')) then
          !!alert.error('The Selected Component already has an Isolation Pad/Slide Unit attached. Creation aborted.')
          !abort = TRUE
          golabel /IdentifyK
        endif
      endif
      -- >>ge 10/03/05

      -- Error if the Identified Component is the SREF or DATUM Atta on a MDS STANDARD Framework
      if (!form.name().neq('MDSSPECIAL')) then
        if (not !selection inset ('AT101A','AT101B')) then
          if ((!shoe.name.matchwild('*/DATUM')) or (!shoe.name.matchwild('*/SREF'))) then
            !!alert.error('The Identified Component is the DATUM Atta. The selected ancillary may NOT be added to the DATUM Atta.')
            !abort = TRUE
            golabel /IdentifyK
          endif
        endif
      endif
    endif

    -- Exit and Abort Creation and Reset OK button Callback so as NOT to SHOW the ROTATE ATTA FORM
    label /IdentifyK
    if (!abort) then
      !!mdsAncill.action[2] = ''
      !!mdsAncill.action[3] = ''
      !!mdsAncill.action[4] = ''
      !this.return = FALSE
      return
    endif
  endif

  -------------------------------------------------------------

  -- Below is the Common PML Code for ALL MDS Ancillary Types -- When the Preliminary DATA set up has been successful
  -- The Identified Pipe Shoe/Component or Trunnion Base Plate MUST always be set in the local variable *** !shoe ***
  !this.return = TRUE
  !this.idComp = !shoe.string()
  handle ANY
    -- IMPORTANT NOTE : Variable *** !shoe *** may not be defined
    !this.idComp = ''
  endhandle

endmethod
-----------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------
-- Method:       guideAfter(!idComp is STRING,!crAtta is DBREF)
--
-- Description:  Performs any actions AFTER the Creation of a GUIDE ANCILLARY
--               on a MDS STANDARD or SPECIAL FRAMEWORK
-- Arguments:
--    [#]   [R/RW]    [Data Type]   [Description]
--
--     1      R        STRING        Identified ATTA existing on the current MDS FRAMEWORK support or a
--                                   SCTN etc... associated with the ATTA !crAtta i.e DBREF passed as a STRING
--                                   or an empty STRING '' because the ATTA has NO associations
--     2      R        DBREF         The ATTA created to add to the MDS Standard or Special FRAMEWORK support
--
-- Return:
--    [Data Type]    [Description]
--
-----------------------------------------------------------------------------------------------------------
define method .guideAfter(!idComp is STRING,!crAtta is DBREF)
  -------------------------------------------------------------

  -- Convert STRING !idComp to a DBREF variable
  !idRefe = !idComp.dbref()
  handle ANY
    -- Unable to convert to a DBREF
    return
  endhandle
  -- Initialise Variable for the MDS Ancillary Form i.e. !!mdsAncill
  !form = !this.form

  -- q var !idComp !crAtta.stype
  -------------------------------------------------------------
  --<wd>21oct2009 - DFN P-25095 SI-14645 - Added GT63, GT64, GT70 and GT71 "Hold Down Guides ONLY for Pipe Shoes"
  --<wd>11jan2010 - DFN P-27844 SI-19722 - Added GT62 and GT72 Guides ONLY for Pipe Shoes"
  -- Ensure a MDS Pipe Shoe GUIDE :mdsGuideRef is set and that the guide is located correctly
  if (!crAtta.stype inset ('AN04','GT01','GT06','GT07','GT08','GT18','GT19','GT14','GT21','GT26','GT28','GT44','GT46','GT47','GT48','GT49','ST06','GT62','GT63','GT64','GT70','GT71','GT72')) then
    -- Set the Cross Reference Attribute :mdsGuideRef at Both the Guide and Pipe Shoe ATTAS
    !!mdsDacControl(TRUE)
    !idRefe.:mdsGuideRef = !crAtta
    !crAtta.:mdsGuideRef = !idRefe
    -- Reset Guide Despars to suit the Associated Pipe Shoe
    !!ce = !idRefe
    !!mdsresetguide()
  endif
  !!ce = !crAtta
  -------------------------------------------------------------

  -- "GT08", "AN04" - Special for GT08, AN04 is the requirement of setting the BCCL dkey to the cross centre of the beam it is sitting on
  if (!crAtta.stype inset ('GT08','AN04')) then
    !sFlangeThick = !idRefe.prop.fthk
    -- Identify beam to bolt guide to
    prompt off
    prompt load escape 'Identify SCTN to Bolt to'
    !boltDia = despa num 10
    --<wd>18jan2008 -- Defect No. P-4407
    --      ID SCTN @
    ID SCTN HSTIFF @
    --<wd>18jan2008 -- Defect No. P-4407
    handle (61,528)
      prompt on
      return
    endhandle
    !beam = !!ce
    if (not !beam.gtype inset ('BEAM','TEE','DINI','DINT')) then
      -- The standards "GT08", "AN04" are ONLY available on BEAM and TEE steel shapes
      ---------------------------------------------------------------------------------------------------
      --<wd>dec2006<mds12> -- Remove any Reference to the !!code.... Global Variables
      --!codX = '$$' & '!!code' & !crAtta.stype
      --!code = '$!codX'
      !code = !!mdsGetDefProp('ATTA', !crAtta.stype, 'CCOD')
      if (!code.eq(|ERROR|)) or (!code.trim().eq(||)) then
        -- Use the AVEVA MDS STANDARD NAME
        !code = !crAtta.stype
      endif
      --<wd>dec2006<mds12>
      ---------------------------------------------------------------------------------------------------
      !!alert.error('Guide/Anchor standard $!code is not suitable for the identified type of structural SCTN.
      The default values have been used for the SCTN BOLT c/c.')
      !!ce = !crAtta
      thro $!idRefe
      prompt on
      return
    endif
    prompt on
    -- TBHL to TBHR for the cross centres
    -- Also the flange thickness is needed
    var !cc const dist ppline TBHL start to ppline TBHR start
    handle any
      -- Find beam width
      var !cc const dist ppline LTOS start to ppline RTOS start
      handle ANY
        !!alert.error('Unable to find bolt cross centres from identified section')
        return
      endhandle
      -- Used 1.5 times bolt diam from beam edge
      !cc = STRING(real(!cc) - $!boltDia[1] * 3)
    endhandle
    !flangeThick = (prop FLG)
    same

    --q name type
    --<wd>may2006<mds12>
    -- ADDED Test Condition for BOTH ATTA STYPES "GT08" and "AN04" ,
    -- because they USE SOME different named DKEYS in their DTSE element
    -- The ORIGINAL CODE below ONLY satisfied a "GT08" ancillary
    --var !prop coll all data with dkey eq 'SBFT' for dtre
    --var !ccProp coll all data with dkey eq 'BCCL' for dtre
    --var !bPlateProp coll all data with dkey eq 'BPLT' for dtre
    --var !num1 eval num for all from !ccProp
    --var !num2 eval num for all from !prop
    --var !num3 eval num for all from !bPlateProp
    --despar n$!num1[1] $!cc
    --despar n$!num2[1] $!flangeThick
    --despar n$!num3[1] $!sFlangeThick

    if ((!crAtta.stype inset ('GT08'))) then
      var !prop coll all data with dkey eq 'SBFT' for dtre
      var !ccProp coll all data with dkey eq 'BCCL' for dtre
      var !bPlateProp coll all data with dkey eq 'BPLT' for dtre
      var !num1 eval num for all from !ccProp
      var !num2 eval num for all from !prop
      var !num3 eval num for all from !bPlateProp
      despar n$!num1[1]  $!cc
      despar n$!num2[1]  $!flangeThick
      despar n$!num3[1]  $!sFlangeThick

    elseif (!crAtta.stype inset ('AN04')) then
      var !prop coll all data with dkey eq 'SBFT' for dtre
      var !ccProp coll all data with dkey eq 'BLEN' for dtre
      var !num1 eval num for all from !ccProp
      var !num2 eval num for all from !prop
      despar n$!num1[1] $!cc
      handle any
      endhandle
      despar n$!num2[1] $!flangeThick

      -- Determine the DATA DEFAULT Bolt c/c on the Anchor 'AN04' just created
      -- Identified by the Dataset Dkey = BWID
      !!ce    = !crAtta
      !stypes = !!ce.stype
      !dpNum  = !!mdsGetDesp('BWID')
      !bWid   = !!ce.desp[!dpNum]

      -- Set the Bolt c/c on the Identified Pipe Shoe
      -- Identified by the Dataset Dkey = BWID
      !!ce   = !idRefe
      !real  = !idRefe.abor.real()
      !dpNum = !!mdsGetDesp('BWID')

      -- Determine the Bolt c/c for the Identified Pipe Shoe
      -- Determine the MDS ATTA DATA object for the IDENTIFIED Pipe Shoe
      --!bWid  = !!mdsPar$!<stype>[!real].despars[!dpNum]
      !mdsShoeObj = object MDSREADPARSDATA()
      !mdsShoeDef = !mdsShoeObj.mdsDefsData(!idRefe.stype, !real)
      if (!mdsShoeDef.not()) then
        -- ERROR -- UNABLE to Determine the Bolt c/c DATA value for the IDENTIFIED Pipe Shoe,
        -- but WARN USER and CONTINUE!!!
        !!alert.error(|Unable to Determine the Bolt c/c DATA DEFAULT value for the IDENTIFIED Pipe Shoe.
        The Bolt c/c value for the identified Pipe Shoe has been set to the DEFAULT value set at the ANCHOR.
        i.e. Bolt c/c = $!<bWid> |)

      else
        -- Valid Bolt c/c DATA value found for the IDENTIFIED Pipe Shoe
        !shoeCc = !mdsShoeObj.despars[!dpNum]
        !bWid   = $!shoeCc

      endif

      -- Get the PIPE SHOE HEIGHT Property value
      !shoeHei = (prop HEI)
      handle ANY
        !shoeHei = 100
      endhandle

      -- Set the Bolt c/c for the Identified Pipe Shoe
      desp num $!dpNum  $!bWid

      -- Now Set the Bolt c/c on this Anchor 'AN04' just created
      -- Identified by the Dataset Dkey = BWID
      !!ce    = !crAtta
      !stypes = !!ce.stype
      !dpNum = !!mdsGetDesp('BWID')
      -- Set the Bolt c/c for the Anchor 'AN04' just created to be the SAME as the Identified PIPE SHOE
      desp num $!dpNum  $!bWid
      -- Set the HEIGHT "DESPAR" of the PIPE SHOE at the "AN04" Anchor -- Always DESP NUM 1 for "AN04"
      despar num 1 $!shoeHei
    endif
    --<wd>may2006<mds12>

  endif

  -------------------------------------------------------------

  -- "ST06" - Special for ST06 is the requirement of setting the SBFW dkey to the width of the beam it is sitting on
  if (!crAtta.stype inset ('ST06')) then
    !sHei  = !idRefe.prop.hei
    -- Identify beam to sit on
    prompt off
    prompt load escape 'Identify section or box to use as stop'
    --<wd>18jan2008 -- Defect No. P-4407
    --      ID SCTN BOX @
    ID SCTN BOX HSTIFF @
    --<wd>18jan2008 -- Defect No. P-4407
    handle (61,528)
      prompt on
      var !hProp coll all data with dkey eq 'HEI' for dtre
      var !num2 eval num for all from !hProp
      despar n$!num2[1] $!sHei
      return
    endhandle
    prompt on
    !beam = !!ce
    --<wd>18jan2008 -- Defect No. P-4407
    --      if !!ce.type EQ 'SCTN' then
    if !!ce.type EQ 'SCTN' or !!ce.type EQ 'HSTIFF' then
      --<wd>18jan2008 -- Defect No. P-4407
      if (not !beam.gtype inset ('BEAM','TEE','DINI','DINT','DINP','ANG','BOX','JISU')) then
        -- The STOP "ST06" is ONLY available on BEAM and TEE steel shapes
        ---------------------------------------------------------------------------------------------------
        --<wd>dec2006<mds12> -- Remove any Reference to the !!code.... Global Variables
        !st06code = !!mdsGetDefProp('ATTA', !crAtta.stype, 'CCOD')
        if (!st06code.eq(|ERROR|)) or (!st06code.trim().eq(||)) then
          -- Use the AVEVA MDS STANDARD NAME
          !st06code = !crAtta.stype
        endif
        --!!alert.error('Stop standard $!!codeST06 is not suitable for the identified type of structural SCTN.
        --The STOP has been created to suit the HEIGHT of the Pipe Shoe and the default DESPARS of the STOP.')
        !!alert.error('The STOP standard $!st06code is not suitable for the identified type of structural SCTN.
        The STOP has been created to suit the HEIGHT of the Pipe Shoe and the default DESPARS of the STOP.')
        --<wd>dec2006<mds12>
        ---------------------------------------------------------------------------------------------------
        !!ce = !crAtta
        return
      endif

      -- WIDT for the width of the section and HEI of SHOE
      !width = prop widt
      handle (2,207)
        !width = prop YLEG
      endhandle
      same
      var !prop coll all data with dkey eq 'SBFW' for dtre
      var !hProp coll all data with dkey eq 'HEI' for dtre
      var !num1 eval num for all from !prop
      var !num2 eval num for all from !hProp
      despar n$!num1[1]  $!width
      despar n$!num2[1]  $!sHei
    else
      !box = !!ce
      $!crAtta
      pin 2 copy pl
      pin 3 copy pl
      pin 2 plane pin 2 clear 0 infront $!box
      pin 3 plane pin 3 clear 0 behind $!box
      !width =!!kStrReal('const dist pin 2 to pin 3')
      var !prop coll all data with dkey eq 'SBFW' for dtre
      var !num1 eval num for all from !prop
      despar n$!num1[1]  $!width
      !!mdsResetPins(2,3)
    endif
  endif
  -------------------------------------------------------------

  -- "GT14" - Ensure Guide DESPARS are set to suit the Associated Pipe Shoe type AT25
  if (!crAtta.stype inset ('GT14')) then
    -- The width of the clamp is controlled by the insulation, therefore
    -- set the width with ( ATTRIB PARA[2 ] + 2 * ATTRIB DESP[25 ] + 2 * ATTRIB DESP[15 ] )
    !!ce = !idRefe
    !despar1 = ( ATTRIB para[2 ] + 2 * ATTRIB DESP[25 ] + 2 * ATTRIB DESP[15 ] )
    !height  = (prop hei)
    !!ce     = !crAtta
    despar n1 $!despar1
    despar n2 $!height
  endif
  -------------------------------------------------------------
  --<wd>12jan2010 - DFN P-27844 SI-19722 - Added STOPS - ST45,ST46,ST47,ST48,ST49,ST50 and GUIDES - GT65,GT66,GT67,GT68,GT69,GT84
  -- 'GT11','GT12A','GT12B','GT27A','GT27B','ST07','ST33'
  -- MDS Trunnion Base Plate Guides/Stops
  --if (!crAtta.stype inset ('GT11','GT12A','GT12B','GT27A','GT27B','ST07','ST33')) then
  if (!crAtta.stype inset ('GT11','GT12A','GT12B','GT27A','GT27B','ST07','ST33','ST45','ST46','ST47','ST48','ST49','ST50','GT65','GT66','GT67','GT68','GT69','GT84')) then
    -- Set the Cross Reference Attribute :mdsGuideRef at Both the Guide and Pipe Shoe ATTAS
    !idRefe.:mdsGuideRef = !crAtta
    !crAtta.:mdsGuideRef = !idRefe
    -- When the Base Plate is a non standard size - read the 'PWID' and 'PLEN' of the Base Plate
    --  and then set the 'PWID' and 'PLEN' properties of the Guide.
    -- Raised MDSAccess for HPD0027599
    !!mdsDacControl(TRUE)
    if (!crAtta.stype inset ('GT11','ST07','ST33')) then
      !pwid = !crAtta.:mdsGuideRef.prop.pwid
      handle NONE
        var !whichData coll all data with dkey eq 'PLEN' for dtre of ce
        !despNum = !whichData[1].dbref().num
        handle NONE
          desp n$!despNum  $!pwid

        elsehandle ANY
        endhandle
      elsehandle ANY
      endhandle
      !plen = !crAtta.:mdsGuideRef.prop.plen
      handle NONE
        var !whichData coll all data with dkey eq 'PWID' for dtre of ce
        !despNum = !whichData[1].dbref().num
        handle NONE
          desp n$!despNum  $!plen
        elsehandle any
        endhandle
      elsehandle any
      endhandle

      --<< GE 09/05/05 - Fix for HPD0028687
      if (!crAtta.stype inset ('GT11','ST07')) then
        if !plen.real() GT !pwid.real() then
          var !whichData coll all data with dkey eq 'PLEN' for dtre of ce
          !despNum = !whichData[1].dbref().num
          handle NONE
            desp n$!despNum  $!plen
            -- $P Set use the largest plate either TOP or BTM
          elsehandle ANY
          endhandle
        endif
      endif
      --EOF>>

    else
      -- For types 'GT12A','GT12B','GT27A','GT27B'
      !pwid = !crAtta.:mdsGuideRef.prop.pwid
      handle NONE
        var !whichData coll all data with dkey eq 'BPWD' for dtre of ce
        !despNum = !whichData[1].dbref().num
        handle none
          desp n$!despNum  $!pwid
        elsehandle any
        endhandle
      elsehandle ANY
      endhandle
    endif
    !!ce = !crAtta
  endif
  -------------------------------------------------------------
  --<< GE 11/05/05 - Fix for HPD0028907
  if (!crAtta.styp inset ('GT12A','GT12B')) then
    !clr = (prop CLR of ce)
    handle NONE
      desp n19 $!clr
    elsehandle ANY
    endhandle
  endif
  --EOF>>

  -- "ST08" and "AN05"
  -- Get the Properties of the Trunnion Base Plate & Bearing Plate to resize the stop
  if (!crAtta.styp inset ('ST08','AN05')) then
    !!ce = !idRefe
    prev PLAT
    !basePlateLength    = (prop PLEN)
    !basePlateWidth     = (prop PWID)
    !!ce = !idRefe
    !bearingPlateLength = (prop PLEN)
    !bearingPlateWidth  = (prop PWID)
    !!ce = !crAtta
    despar n1 $!bearingPlateLength
    despar n2 $!bearingPlateWidth
    despar n3 $!basePlateLength
    despar n4 $!basePlateWidth
  endif
  !!ce = !crAtta
  -------------------------------------------------------------

  -- 'AT33A' to 'AT33F', 'AT34A' to 'AT34F', 'AT35','AT100A','AT100B'
  -- MDS Trunnion Isolation Pads and Slide Units ONLY
  if (!crAtta.stype inset ('AT33A','AT33B','AT33C','AT33D','AT33E','AT33F','AT34A','AT34B','AT34C','AT34D','AT34E','AT34F','AT35','AT100A','AT100B')) then
    -- It is now OK to Continue with the Creation
    !datumNam = !idRefe.name
    !srefName = !datumNam & '/SREF'
    !srefDbref = !srefName.dbref()
    !srefSele = false
    !insuType = 'TRUNNION'
    -- Get The Associated Trunnion Type e.g 'TT04' or 'TT23' etc..., from the SREF Atta in The Trunnion Branch
    !trunType = !srefDbref.stype
    -- Get the Min and Max Length Values of the Trunnion
    !trunAbor = !srefDbref.abor
    ------------------------------------------------------------------------------------------
    --<wd>dec2006<mds12>
    !mdsTrunObj  = object MDSREADTRUNDATA()
    !mdsTrunDefs = !mdsTrunObj.mdstRunData(!trunType,!trunAbor.real())
    !minLen = !mdsTrunObj.minLength
    !maxLen = !mdsTrunObj.maxLength
    --!minLen   = !!mdsPar$!trunType[$!trunAbor].minimum
    --!maxLen   = !!mdsPar$!trunType[$!trunAbor].maximum
    --<wd>dec2006<mds12>
    ------------------------------------------------------------------------------------------
    -- Get the Existing Length of the Associated Trunnion Branch
    !!ce = !idRefe.owner
    pin 9 copy ph
    pin 8 copy pt
    pin 9 dir d
    pin 9 plane d thro p0 of href
    !extraLen =!!kStrReal('cons dist pin 9 to plane pin 8')
    !!mdsResetPins(8,9)
    !!mdsAncill.tLength = !extraLen
    --      !this.form.tLength  = !extraLen
    -- Connect Isolation Pad to Trunnion Base Plate
    !!ce = !crAtta
    conn
    handle any
      fconn
    endhandle
    -- Determine the Trunnion SREF Atta Despar Number used to store the Trunnion Length and Set  !!mdsAncill.tLength
    -- The MDS Trunnions DO NOT have a DATA element with a DKEY in order to extract the Trunnion Length DESPAR NUMBER
    if (!srefDbref.:mdsSuppType.eq('TT25')) then
      !dpNum = 3
      --    elseif (!srefDbref.:mdsSuppType inset ('TT04','TT05','TT06','TT07','TT08','TT09','TT10','TT11','TT12','TT13','TT22','TT28','TT26','TT36')) then
      -- ge/07/12/04 Fix for HPD0027087 Added TT37 to the list
    elseif (!srefDbref.:mdsSuppType inset ('TT04','TT05','TT06','TT07','TT08','TT09','TT10','TT11','TT12','TT13','TT22','TT28','TT26','TT36','TT37')) then
      !dpNum = 5
    endif
    !this.form.tLength = !srefDbref.desp[!dpNum]
    -- Adjust trunnion length within the min/max trunnion length limits to accommodate the isolation pad
    !trunLenWarn = STRING()
    if (!!mdsAdjTrunLen(!idRefe,!crAtta,!srefDbref,!form,'CREATE',!trunLenWarn).not()) then
      !!alert.warning(!trunLenWarn)
    endif
    -- Set the Cross Reference Attribute :mdsGuideRef at Both the Trunnion Base Plate and Isolation Pad ATTAS
    !idRefe.:mdsGuideRef = !crAtta
    !crAtta.:mdsGuideRef = !idRefe
    -- Navigate Back to New Isolation Pad Atta
    !!ce = !crAtta
    -- Name support
    :mdsSuppType |$!crAtta.stype|
    !!ce.:mdsCp3 = 'TRUNNION'
  endif

  -------------------------------------------------------------

  -- 'AT59','AT68'
  -- MDS Cold Isolation Blocks for Trunnion Base Plates ONLY
  if (!crAtta.styp inset ('AT59','AT68')) then
    !insuType = 'TRUNNION'
    -- Get The Associated Trunnion Type e.g 'TT04', from the SREF Atta in The Selected Trunnion Branch
    if (!insuType.eq('TRUNNION')) then
      -- Get and Check the :mdsSuppType of the Trunnion Branch
      !datumNam = !idRefe.name.before('.')
      !srefName = !datumNam & '/SREF'
      !!ce      = !srefName.dbref()
      -- Initialise Selected Trunnion SREF variables
      !srefDbref = !srefName.dbref()
      !trunType  = !!ce.:mdsSuppType
      ---------------------------------------------------------------------------------------------------
      --<wd>dec2006<mds12>
      -- These variables are NOT used below in this <if/endif> block so they have been commented out of the PML code
      -- Get the Client CODE and DESCRIPTION for AT59, AT68
      --!code = !!code$!trunType
      --!desc = !!desc$!trunType
      --<wd>dec2006<mds12>
      ---------------------------------------------------------------------------------------------------

      -- Get the Min and Max Length Values of the Trunnion
      !trunAbor = !srefDbref.abor

      ------------------------------------------------------------------------------------------
      --<wd>dec2006<mds12>
      !mdsTrunObj  = object MDSREADTRUNDATA()
      !mdsTrunDefs = !mdsTrunObj.mdstRunData(!trunType,!trunAbor.real())
      !minLen = !mdsTrunObj.minLength
      !maxLen = !mdsTrunObj.maxLength
      --!minLen   = !!mdsPar$!trunType[$!trunAbor].minimum
      --!maxLen   = !!mdsPar$!trunType[$!trunAbor].maximum
      --<wd>dec2006<mds12>
      ------------------------------------------------------------------------------------------

      -- Get the Existing Length of the Associated Trunnion Branch
      !!ce = !idRefe.owner
      pin 9 copy ph
      pin 8 copy pt
      -- For trunnions with Bearing plates - Move Pin 8 UP the Branch by its thickness
      if (!trunType inset ('TT05','TT07','TT09','TT11','TT13','TT19','TT28')) then
        last mem
        -- Bearing Plate Thickness
        !bearLength =!!kStrReal ('cons dist pa to pl')
        pin 8 dist $!bearLength
        !!ce = !idRefe.owner
      endif
      pin 9 dir d
      if (!!ce.href.type.neq('REDU')) then
        pin 9 plane pin 9 thro p0 of href
      endif
      !extraLen =!!kStrReal('cons dist pin 9 to plane pin 8')
      !!mdsResetPins(8,9)
      !!mdsAncill.tLength = !extraLen
      --!this.form.tLength  = !extraLen
      -- Connect Cold Isolation Block to the Identified Trunnion Base Plate
      !!ce = !crAtta
      conn
      handle any
        fconn
      endhandle
      -- Adjust Trunnion Length within the MIN/MAX Trunnion Length Limits to Accommodate the Cold Isolation Block
      !trunLenWarn = STRING()
      if (!!mdsAdjTrunLen(!idRefe,!crAtta,!srefDbref,!form,'CREATE',!trunLenWarn).not()) then
        !!alert.warning(!trunLenWarn)
      endif
      -- Set the Cross Reference Attribute :mdsGuideRef at Both the Trunnion Base Plate <PLAT> and Cold Isolation Block <ATTA>
      !idRefe.:mdsGuideRef = !crAtta
      !crAtta.:mdsGuideRef = !idRefe
    endif

    -- Navigate Back to New Cold Isolation Block Atta
    !!ce = !crAtta
    :mdsSuppType |$!crAtta.styp|
    !!ce.:mdsCp3 = !insuType
  endif

  if (!crAtta.styp inset ('GT44','GT46','GT47','GT48','GT49')) then
    --<GE>aug2006 Added test to see if the shoe is an AT25 as it has specific named properties that used
    if  (!crAtta.:mdsGuideRef.styp inset ('AT25')) then
      !sHei = !crAtta.:mdsGuideRef.prop.hei
      !sfthk = !crAtta.:mdsGuideRef.prop.bpth
      !sWid = !crAtta.:mdsGuideRef.prop.bWid
    else
      !sHei = !crAtta.:mdsGuideRef.prop.hei
      !sfthk = !crAtta.:mdsGuideRef.prop.fthk
      !sWid = !crAtta.:mdsGuideRef.prop.fwid
    endif
    --<GE>aug2006
    !dpNumA = !!mdsGetDesp('HEI')
    !dpNumB = !!mdsGetDesp('FWID')
    !dpNumC = !!mdsGetDesp('FTHK')
    !dpNumD = !!mdsGetDesp('SBFW')

    --if (!!mdsGT01.support.type inset('GT47','GT48')) then
    if (!crAtta.styp inset ('GT47','GT48')) then
      -- Identify beam to sit on
      prompt off
      prompt load escape 'Identify section to place guide on'
      --<wd>18jan2008 -- Defect No. P-4407
      --        ID SCTN @
      ID SCTN HSTIFF @
      --<wd>18jan2008 -- Defect No. P-4407
      handle ANY
        prompt on
        return
      endhandle
      prompt on
      -- WIDT for the width of the section
      !width = prop widt
      same
      despa numb $!dpNumD  $!width
    endif

    despa numb $!dpNumA  $!sHei
    despa numb $!dpNumB  $!sWid
    if (!!mdsGT01.support.type inset ('GT44')) then
      despa numb $!dpNumC  $!sFlangeThick
    endif

  endif
  ------------------------------------------------------------------------------------------

  -------------------------------------------------------------

endmethod
-----------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------
-- Method:       shoeAfter(!idComp is STRING,!crAtta is DBREF)
--
-- Description:  Performs any actions AFTER the Creation of a Pipe Shoe
--               ANCILLARY on a MDS STANDARD or SPECIAL FRAMEWORK
-- Arguments:
--    [#]   [R/RW]    [Data Type]   [Description]
--
--     1      R        STRING        Identified ATTA existing on the current MDS FRAMEWORK support or a
--                                   SCTN etc... associated with the ATTA !crAtta i.e DBREF passed as a STRING
--                                   or an empty STRING '' because the ATTA has NO associations
--     2      R        DBREF         The ATTA created to add to the MDS Standard or Special FRAMEWORK support
--
-- Return:
--    [Data Type]    [Description]
--
-----------------------------------------------------------------------------------------------------------
define method .shoeAfter(!idComp is STRING,!crAtta is DBREF)
  -------------------------------------------------------------

  -- Convert STRING !idComp to a DBREF variable
  !idRefe = !idComp.dbref()
  handle ANY
    -- Unable to convert to a DBREF
    return
  endhandle
  -- Initialise Variable for the MDS Framework Form
  !form = !this.form

  -------------------------------------------------------------

  ---*********************************************************************
  if !crAtta.styp.eq('ST14') then
    prompt off
    prompt load escape 'Identify baseplate plate'
    ID PLAT ATTA @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return false
    endhandle
    prompt on
    !plat = !!ce
    -- The styp has to be the following AC18
    !styp = !!ce.styp
    if (!styp.upcase() inset('AC18A','AC18B')) then
    else
      !!alert.error('The identified element is not a base plate')
      !!kRestoreUnits(!currentunits)
      return
    endif
    -- Check that the bran does not include a bearing plate
    var !bPlates coll all (PLAT ATTA) with matchwild(Stype,'AC19*') FOR BRAN
    if !bPlates.empty() eq FALSE then
      !!alert.error('The identified element has a bearing plate and is not suitable for this support')
      return
    endif
    -- Get the P2 direction of the Elbow (p2 never up), Cross or Tee as we need this later
    !pipeDir = p2 dir of href of owner
    !pipeDir.up = 0  $* Remove the fall
  elseif !crAtta.styp.eq('ST14') then
    -- Identify pedestal to attach guide to
    prompt off
    prompt load escape 'Identify bearing plate'
    ID PLAT ATTA @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return false
    endhandle
    prompt on

    -- The styp has to be the following AC19
    !styp = !!ce.styp
    if (!styp.upcase() inset('AC19A','AC19B')) then
    else
      !!alert.error('The identified element is not a bearing plate')
      !!kRestoreUnits(!currentunits)
      return
    endif
  endif

  --<wd>18jan2008--removed in appspag check  !bore = pl bore
  !unusedP3dir = p3 dir wrt /*
  !!mdsDacControl(true)

  !!mdsSetDespars(!!ce)

  -- Read the parameters of the baseplate/bearing plate to resize the stop
  if !crAtta.styp.eq('ST14') then
    -- Identify beam or box to size stop
    prompt off
    prompt load escape 'Identify section or box to use as stop'
    --<wd>18jan2008 -- Defect No. P-4407
    --    ID SCTN BOX @
    ID SCTN BOX HSTIFF @
    --<wd>18jan2008 -- Defect No. P-4407
    handle (61,528)
      --<wd>18jan2008--removed in appspag check       golabel /cancel
      prompt on
      !!kRestoreUnits(!currentunits)
      return false
    endhandle

    prompt on
    --<wd>18jan2008--removed in appspag check   !element = !!ce
    -- Check that the sctn is in correct plane for Support Type
    -- For ST14 type - pipe must be perpendicular to beam. ST15 - pipe must be parallel
    --<wd>18jan2008 -- Defect No. P-4407
    --   if !!ce.type EQ 'SCTN' then
    if !!ce.type EQ 'SCTN' or !!ce.type EQ 'HSTIFF' then
      --<wd>18jan2008 -- Defect No. P-4407
      !beam = !!ce
      !zdir = zdir wrt /*
      if !crAtta.styp.eq('ST14') then
        if !pipeDir.isParallel(!zdir) eq False then
          --This is ok for ST14
        else
          !!alert.error('Unable to create STOP ST14 as pipe and beam are Parallel')
          !!ce = !crAtta
          Delete Atta
          return False
        endif
      endif
      -- Get the plate width because if sctn width is wider than plate width move stop up
      -- Check for rotation of atta
      if !zdir.isParallel(!plat.pdir[10])  then
        !pwid = !plat.prop.pwid
        !plen = !plat.prop.plen
      else
        !pwid = !plat.prop.plen
        !plen = !plat.prop.pwid
      endif

      -- Get width of beam from property WIDT
      if (!beam.gtype inset ('BEAM','TEE','DINI','DINT','BOX')) then
        !width  = !beam.prop.widt
        !!ce = !crAtta
        despar n6 $!width
      else
        !!ce = !crAtta
        pin 8 copy pl
        pin 9 copy pl
        pin 8 plane pin 8 clear 0 inf same
        pin 9 plane pin 9 clear 0 beh same
        var !width  const dist pin 8 to pin 9
      endif
      same
      -- Orientate stop in same dir as beam
      conn and p10 is zdir of same
      handle ANY
      endhandle
      -- Check the width of the Beam compared to the plate. !pwid is Plate width
      -- If width of beam is wider than plate move stopper up by setting despar1 to 0
      -- and change despar n6
    else
      -- The id element is a box
      !box = !!ce
      $!plat
      bran
      goto href
      pin 2 copy pl
      pin 3 copy pl
      pin 2 plane pin 2 clear 0 infront $!box
      pin 3 plane pin 3 clear 0 behind $!box
      !boxWidth =!!kStrReal('const dist pin 2 to pin 3')
      $!crAtta
      despar n6 $!boxWidth
      !width =!!kStrReal('const dist pin 2 to pin 3')
      var !dir const dir pin 2 to pin 3
      !!mdsResetPins(2,5)
      !zdir = !dir.direction()
      if !zdir.isParallel(!plat.pdir[10])  then
        !pwid = !plat.prop.pwid
        !plen = !plat.prop.plen
      else
        !pwid = !plat.prop.plen
        !plen = !plat.prop.pwid
      endif
      -- Orientate stop
      conn and p30 is $!dir
      handle ANY
      endhandle
    endif
  endif


  if !crAtta.styp.eq('ST14') then
    $!crAtta
    if !plen.real() gt !width.real() then
      despar n6 $!width
    else
      despar n6 $!plen
      !desp5 = Desp[5]
      despar n5 -$!desp5
    endif
  endif
  ---*********************************************************************

  -- "AT25, AT26 and GT13" - On these MDS Cryogenic Ancillaries it is required to set the insulation thickness
  -- to a DESPAR at the CREATED ATTA !crAtta
  if (!crAtta.stype inset('AT26','GT13','AT25')) then
    !!ce = !crAtta
    var !insu insu
    var !dInsu coll all data with dkey eq 'INSU' for dtre
    var !num1 eval num for all from !dInsu
    despar n$!num1[1]  $!insu
  endif
  -------------------------------------------------------------

  -- If type is a AT98 then we need to add the tube material to the iso

  if !crAtta.styp.eq('AT98') then
    -- GE 06/11/05 raised DAC's access HPD0029991
    !!mdsDacControl(true)
    !!ce.mtoref[1] = !!ce.lstu
    !!mdsDacControl(false)
  endif

  -- "AN06" - On this MDS Cryogenic "Anchor" it is required to set the insulation thickness
  -- and the Beam Width to the necessary DESPARS at the CREATED ATTA !crAtta
  if (!crAtta.stype inset('AN06')) then
    -- Identify SCTN for the ANCHOR
    prompt off
    prompt load escape 'Identify SCTN to use as Anchor-Stop'
    --<wd>18jan2008 -- Defect No. P-4407
    --      ID SCTN @
    ID SCTN HSTIFF @
    --<wd>18jan2008 -- Defect No. P-4407
    handle (61,528)
      prompt on
      -- Get and Set the Insulation Thickness DESPAR
      !!ce = !crAtta
      var !insu insu
      var !inThick coll all data with dkey eq 'ITHK' for dtre
      var !num2 eval num for all from !inThick
      despar n$!num2[1]  $!insu
      !!alert.message('SCTN not identified. The Anchor-Stop has been created to suit the current insulation thickness and the default DESPARS')
      return
    endhandle
    prompt on
    !beam = !!ce
    if (not !beam.gtype inset ('BEAM','TEE','DINI','DINT')) then
      -- The ANCHOR STOP "AN06" is ONLY available on BEAM and TEE steel shapes
      ---------------------------------------------------------------------------------------------------
      --<wd>dec2006<mds12> -- Remove any Reference to the !!code.... Global Variables
      !an06code = !!mdsGetDefProp('ATTA', !crAtta.stype, 'CCOD')
      if (!an06code.eq(|ERROR|)) or (!an06code.trim().eq(||)) then
        -- Use the AVEVA MDS STANDARD NAME
        !an06code = !crAtta.stype
      endif
      --!!alert.error('Anchor-Stop standard $!!codeAN06 is not suitable for the identified type of structural SCTN.
      --The ANCHOR-STOP has been created with the default DESPARS.')
      !!alert.error('Anchor-Stop standard $!an06code is not suitable for the identified type of structural SCTN.
      The ANCHOR-STOP has been created with the default DESPARS.')
      --<wd>dec2006<mds12>
      ---------------------------------------------------------------------------------------------------
      !!ce = !crAtta
      return
    endif
    -- Get the Identified SCTN's Flange WIDTH and Set the necessary DESPAR
    !fWidth = !beam.prop.widt
    !!ce = !crAtta
    var !prop coll all data with dkey eq 'SSMW' for dtre
    var !num1 eval num for all from !prop
    despar n$!num1[1]  $!fWidth
    -- Get and Set the Insulation Thickness DESPAR
    !!ce = !crAtta
    var !insu insu
    var !inThick coll all data with dkey eq 'ITHK' for dtre
    var !num2 eval num for all from !inThick
    despar n$!num2[1] $!insu
  endif
  -------------------------------------------------------------

  -- "AN10" and "AN11" - On these MDS "Anchor-Stops" it is required to get the SCTN Beam Width
  --  and set the necessary DESPAR at the CREATED ATTA !crAtta
  if (!crAtta.styp inset ('AN10','AN11')) then
    -- Identify SCTN for the ANCHOR
    prompt off
    prompt load escape 'Identify section or box to use as stop'
    --<wd>18jan2008 -- Defect No. P-4407
    --    ID SCTN BOX @
    ID SCTN BOX HSTIFF @
    --<wd>18jan2008 -- Defect No. P-4407
    handle (61,528)
      prompt on
      !!alert.message('SCTN or BOX not identified. The Anchor-Stop has been created to suit the default DESPARS')
      return
    endhandle
    prompt on
    --<wd>18jan2008 -- Defect No. P-4407
    --    if !!ce.type EQ 'SCTN' then
    if !!ce.type EQ 'SCTN' or !!ce.type EQ 'HSTIFF' then
      --<wd>18jan2008 -- Defect No. P-4407
      !beam = !!ce
      if (not !beam.gtype inset ('BEAM','TEE','DINI','DINT','ANG','BOX')) then
        ---------------------------------------------------------------------------------------------------
        --<wd>dec2006<mds12> -- Remove any Reference to the !!code.... Global Variables
        --!code = '$$!!code' & !crAtta.styp
        -- The ANCHOR STOP "AN10" is ONLY available on BEAM and TEE steel shapes
        !code = !!mdsGetDefProp('ATTA', !crAtta.stype, 'CCOD')
        if (!code.eq(|ERROR|)) or (!code.trim().eq(||)) then
          -- Use the AVEVA MDS STANDARD NAME
          !code = !crAtta.stype
        endif
        --<wd>dec2006<mds12>
        ---------------------------------------------------------------------------------------------------
        !!alert.error('Anchor-Stop standard $!code is not suitable for the identified type of structural SCTN.
        The ANCHOR-STOP has been created with the default DESPARS.')
        !!ce = !crAtta
        return
      endif
      -- Get the Identified SCTN's Flange WIDTH and Set the necessary DESPAR
      if (!beam.gtype inset ('BEAM','TEE','DINI','DINT','BOX')) then
        !fWidth = !beam.prop.widt
        !!ce = !crAtta
        var !prop coll all data with dkey eq 'WID' for dtre
        var !num1 eval num for all from !prop
        despar n$!num1[1]  $!fWidth
      else
        !!ce = !crAtta
        pin 8 copy pl
        pin 9 copy pl
        pin 8 plane pin 8 clear 0 inf same
        pin 9 plane pin 9 clear 0 beh same
        var !fWidth const dist pin 8 to pin 9
        !!mdsResetPins(8,9)
        var !prop coll all data with dkey eq 'WID' for dtre
        var !num1 eval num for all from !prop
        despar n$!num1[1]  $!fWidth
      endif
    endif
    if !!ce.type EQ 'BOX' then
      !box = !!ce
      same
      pin 2 copy pl
      pin 3 copy pl
      pin 2 plane pin 2 clear 0 infront $!box
      pin 3 plane pin 3 clear 0 behind $!box
      !boxWidth =!!kStrReal('const dist pin 2 to pin 3')
      var !ccProp coll all data with dkey eq 'WID' for dtre
      var !num1 eval num for all from !ccProp
      despar n$!num1[1]  $!boxWidth
      !!mdsResetPins(2,3)
    endif
  endif
  -------------------------------------------------------------
  --<wd>11jan2010 - DFN P-27844 SI-19722 - Added ST43 and ST44 ONLY for Pipe Shoes"
  -- 'ST01','ST02','ST03','ST04','ST05','ST09A','ST09B','ST10A','ST10B','ST11A','ST11B','ST12','ST13A','ST13B','ST20'
  -- On these MDS Stops it is required to get the SCTN position and position the Stop !crAtta at the SCTN
  -- Also get the Beam Width and set the necessary DESPAR at the CREATED ATTA !crAtta
  if (!crAtta.styp inset ('ST01','ST02','ST03','ST04','ST05','ST09A','ST09B','ST10A','ST10B','ST11A','ST11B','ST12','ST13A','ST13B','ST20','ST24A','ST24B','ST24C','ST24D','ST32','ST34','ST43','ST44','ST57','ST58')) then
    label /idSctn
    prompt off
    prompt load escape 'Identify SCTN to use as the Stop'
    --<wd>18jan2008 -- Defect No. P-4407
    --      ID SCTN @
    ID SCTN HSTIFF @
    --<wd>18jan2008 -- Defect No. P-4407
    handle (61,528)
      prompt on
      !!ce = !crAtta
      !!alert.message('SCTN not identified. The Stop has been created to suit the default DESPARS')
      return
    endhandle
    prompt dismiss
    prompt on
    !pick = !!ce
    -- Check if Identified SCTN is 90-degrees to the Identified Pipe Branch i.e. Perpendicular
    !!ce = !crAtta
    ori
    thro $!pick
    !!ce = !pick
    pin 9 at poss
    pin 8 at pose
    pin 9 dir u wrt /*
    pin 9 plane pin 9 thro pin 8
    pin 9 dir from pin 9 to pin 8
    pin 7 copy pin 9
    pin 7 plane pin 7 thro $!crAtta
    pin 6 copy pl of $!crAtta
    pin 6 dist 100mm
    pin 9 dir u wrt /*
    pin 8 dir u wrt /*
    pin 7 dir u wrt /*
    pin 6 dir u wrt /*
    pin 8 plane pin 8 thro pin 9
    pin 7 plane pin 7 thro pin 9
    pin 6 plane pin 6 thro pin 9
    if !!kStrReal('const angle pin 9 to pin 7 to pin 6').neq(90) then
      !!mdsResetPins(6,9)
      !!alert.error('Identified SCTN is not perpendicular to the PIPE.')
      golabel /idSctn
    endif
    -- Move ST01 etc... stop thro the CENTRE of the Identified SCTN
    -- ***  IMPORTANT NOTE ***:- MDSCRADDPIPE may FORCE this ATTA thro the DATUM ATTA on a MDS FRAMEWORK/SPECIAL
    !centre = !!mdsbeamcentre(!pick)
    !!ce = !crAtta
    plane pl thro $!centre
    -- Modify value of the STOP DESPAR number where the STOP property dkey = 'LEN' - i.e. Identified SCTN WIDTH
    pin 1 copy pl
    pin 2 copy pin 1
    pin 1 plane pin 1 clear 0 beh $!pick
    pin 2 plane pin 2 clear 0 inf $!pick
    !dist =!!kStrReal('const dist pin 1 to pin 2')
    if (!crAtta.styp inset ('ST20')) then
      !dpNum = !!mdsGetDesp('SBFW')
      despar num $!dpNum  $!dist

      --<wd>11jan2010 - DFN P-27844 SI-19722 - Added ST43 and ST44 ONLY for Pipe Shoes & ST57 and ST58 for Uninsulated Pipes"
    elseif (!crAtta.styp inset ('ST43','ST44','ST57','ST58')) then
      !dpNum = !!mdsGetDesp('WID')
      despar num $!dpNum  $!dist

    else
      !dpNum = !!mdsGetDesp('LEN')
      despar num $!dpNum  $!dist
    endif
    !!mdsResetPins(1,9)
    --<wd>11jan2010 - DFN P-27844 SI-19722 - Added ST43 and ST44 ONLY for Pipe Shoes"
    -- Modify the STOP DESPAR number where the STOP property dkey = 'HEI' - i.e. Identified Pipe SHOE Height
    if (!crAtta.styp inset ('ST11A','ST11B','ST12','ST20','ST43','ST44')) then
      !!ce = !idRefe
      !exDesp = !!mdsGetDesp('HEI')
      var !exHeig despar $!exDesp
      !!ce = !crAtta
      !dpNumber = !!mdsGetDesp('HEI')
      despar num $!dpNumber  $!exHeig
    endif
    !!ce = !crAtta
    -- Check If NOT Set ABOVE then the STOP Height to the Identified SCTN will DONE by the USER - via Modify Atta OPTIONS
    --<wd> Let user MODIFY HEIGHT if REQUIRED with the Modify Atta Option - i.e. Set Height to Steel
    -- NOTE:- The function call shown below requires the user to identify the SAME SCTN again!!!!!!!
    --      !!mdsModShoe(!!mdsModAt,'STEEL',!crAtta) -- ????????? Could write another METHOD to DO THIS if time allows !!!!!!!!

    --<wd>19jan2010 - DFN P-27844 SI-19722 - Added for ST43 and ST44 Pipe Shoes.
    -- Plus ST57 and ST58 Line Stops for UNINSULATED PIPE only so DO NOT CONSIDER these STOP types for setting :MDSGUIDEREF
    if (not !crAtta.styp inset ('ST57','ST58')) then
      !idRefe.:MDSGUIDEREF = !crAtta
      !crAtta.:MDSGUIDEREF = !idRefe
      -- Reset Guide Despars to suit the Associated Pipe Shoe
      !!ce = !idRefe
      !!mdsresetguide()
    endif
    --<wd>19jan2010 - DFN P-27844 SI-19722 - Added ST43 and ST44 for Pipe Shoes"

  endif
  -------------------------------------------------------------

  -- 'AT05','AT09','AT23','AT52A','AT52B','AT52C','AT52D','AT52E','AT52F','AT65'
  -- MDS Reinforcing Pads for Pipes and Pipe Shoes Only
  if (!crAtta.stype inset ('AT05','AT09','AT23','AT52A','AT52B','AT52C','AT52D','AT52E','AT52F','AT65'))  then
    if (!crAtta.stype inset ('AT23') and (!form.form.string().upcase().neq('MDSFT54B') and !form.form.string().upcase().neq('MDSFT55B'))) then
      !insuType = !!mdsreinfpad.type.selection()
      --  When !insuType is equal to 'SHOE' and the Cradle Pad default Design Parameters have already been set
      !rPad = !!ce
      if (!insuType.eq('SHOE')) then
        -- Navigate to the Shoe/Datum Atta to Check and Adjust the Height of the Identified Shoe
        !!ce  = !!mdsAncill.shoeref
        !atta = !!ce
        !shoeWarning = STRING()
        ------------------------------------------------------------------------------
        -- mjb >>> 04.05.06 <mds12>
        !mdsAttaObj  = object MDSREADPARSDATA()
        !mdsAttaDefs = !mdsAttaObj.mdsDefsData(!atta.stype,!atta.lbor.real())
        --!check       = object MDSCHECKSTD()
        !check = object MDSCHECKSTD(!mdsAttaObj)
        -- mjb <<< 04.05.06 end of mod
        ------------------------------------------------------------------------------
        -- Cradle Pad Atta Length and Shoe Atta Height are always MODIFIED in the <!check.shoeHeight(w,x,y,z) method> below
        -- Issue a Warning if SHOE Height is NOT within the MDS Standards Permissible Height Range
        if (!check.shoeHeight(!form,!atta,!rPad,!shoeWarning).not()) then
          !!alert.warning(!shoeWarning)
        endif
        -- Set the Cross Reference Attribute :mdsSref at Both ATTAS and the Pad ATTA uda .:mdsCp3 with the !insuType
        !!mdsDacControl(true)
        !atta.:mdsSref = !rPad
        !rPad.:mdsSref = !atta
        !rPad.:mdsCp3  = !insuType
        !!mdsDacControl(FALSE)
      else
        -- When !insuType.eq('PIPE') reset Property 'OLAP'<dkey> DESPAR to be ZERO
        !!mdsDacControl(true)
        !dpNum              = !!mdsGetDesp('OLAP')
        !rPad.desp[$!dpNum] = 0
        !rPad.:mdsCp3       = !insuType
        !!mdsDacControl(false)
      endif

      -----------------------------------------------------
      --<wd>28jun2004 -- for type AT65 the Default MATERIAL is PIPE and not PLATE i.e.
      -- the Pipe Wrapper/Cradle default material for the MTOREF attribute is the same LSTU as the Parent Pipe
      !!mdsDacControl(TRUE)
      --!mtoRefSpec = spec of lstu
      --!!mdsRPadMat.specs.select('rtext',!mtoRefSpec.name)
      if (!rPad.prop.desc inset ('AT65')) then
        -- The Standard Default Angle is 90 degrees
        -- i.e Horizontal Pipes = 90 deg. WEST from the UP (Top) direction
        -- and   Vertical Pipes = 90 deg. WEST from the NORTH direction
        !rPad.desp[7] = 90
        -- For AT65 the default MATERAIL is the PARENT Pipe Material and is designated by the letter 'A'
        !!ce = !rPad
        desp num 8 A
        -- For PARENT Pipe material there is NO THICKNESS required in the MDS property CODE
        !rPad.desp[9] = 0
        !!mdsDacControl(FALSE)
      endif
      --<wd>28jun2004
      -----------------------------------------------------
    endif
  endif

  !!ce = !crAtta
  -------------------------------------------------------------

  -- 'AT40A','AT40B','AT40C','AT40D','AT40E','AT40F','AT41A','AT41B','AT41C','AT41D','AT41E','AT41F','AT42'
  -- MDS Isolation Pads or Slide Units for Pipes or Pipe Shoes Only
  if (!crAtta.stype inset ('AT40A','AT40B','AT40C','AT40D','AT40E','AT40F','AT41A','AT41B','AT41C','AT41D','AT41E','AT41F','AT42')) then
    !insuType = !!mdsreinfpad.type.selection()
    -- When !insuType is equal to 'SHOE' and the Isolation or Slide Unit Pad default Design Parameters have already been set
    !rPad = !!ce
    if (!insuType.eq('SHOE')) then
      -- Navigate to the Shoe/Datum Atta to Check and Adjust the Height of the Identified Shoe
      !!ce  = !!mdsAncill.shoeref
      handle any
        !!ce = !idComp.dbref()
      endhandle
      !atta = !!ce
      !shoeWarning = STRING()
      ------------------------------------------------------------------------------
      -- mjb >>> 04.05.06 <mds12>
      !mdsAttaObj  = object MDSREADPARSDATA()
      !mdsAttaDefs = !mdsAttaObj.mdsDefsData(!atta.stype,!atta.lbor.real())
      --!check       = object MDSCHECKSTD()
      !check = object MDSCHECKSTD(!mdsAttaObj)
      -- mjb <<< 04.05.06 end of mod
      ------------------------------------------------------------------------------
      -- Shoe Atta Height is always MODIFIED in the method <!check.shoeHeight(w,x,y,z)> called below
      -- Issue a Warning if SHOE Height is NOT within the MDS Standards Permissible Height Range
      if (!check.shoeHeight(!form,!atta,!rPad,!shoeWarning).not()) then
        !!alert.warning(!shoeWarning)
      endif
      -- Set the Cross Reference Attribute :mdsGuideRef at Both ATTAS and the Pad ATTA uda .:mdsCp3 with the !insuType
      !!mdsDacControl(true)
      !atta.:mdsGuideRef = !rPad
      !rPad.:mdsGuideRef = !atta
      !rPad.:mdsCp3      = !insuType
      !!mdsDacControl(false)
    else
      -- When !insuType.eq('PIPE') reset Property 'XHEI'<dkey> DESPAR to be ZERO
      !!mdsDacControl(true)
      !dpNum              = !!mdsGetDesp('XHEI')
      !rPad.desp[$!dpNum] = 0
      !rPad.:mdsCp3       = !insuType
      !!mdsDacControl(false)
    endif
  endif
  !!ce = !crAtta
  -- 'AT101A','AT101B'
  -- MDS Isolation Pads or Slide Units for Pipe Shoes Only
  if (!crAtta.stype inset ('AT101A','AT101B')) then
    !rPad = !!ce
    -- Navigate to the Shoe/Datum Atta to Check and Adjust the Height of the Identified Shoe
    !!ce = !idComp.dbref()
    !atta = !!ce
    !shoeWarning = STRING()
    ------------------------------------------------------------------------------
    -- mjb >>> 04.05.06 <mds12>
    !mdsAttaObj  = object MDSREADPARSDATA()
    !mdsAttaDefs = !mdsAttaObj.mdsDefsData(!atta.stype,!atta.lbor.real())
    --!check       = object MDSCHECKSTD()
    !check = object MDSCHECKSTD(!mdsAttaObj)
    -- mjb <<< 04.05.06 end of mod
    ------------------------------------------------------------------------------
    -- Shoe Atta Height is always MODIFIED in the method <!check.shoeHeight(w,x,y,z)> called below
    -- Issue a Warning if SHOE Height is NOT within the MDS Standards Permissible Height Range
    if (!check.shoeHeight(!form,!atta,!rPad,!shoeWarning).not()) then
      !!alert.warning(!shoeWarning)
    endif
    -- Set the Cross Reference Attribute :mdsGuideRef at Both ATTAS and the Pad ATTA uda .:mdsCp3 with the !insuType
    !!mdsDacControl(true)
    !atta.:mdsGuideRef = !rPad
    !rPad.:mdsGuideRef = !atta
    !!mdsDacControl(false)
  endif
  --    thro $!idComp
  !!ce = !crAtta
  -------------------------------------------------------------


  -- 'AT21','AT22' - Adjust the Bolt length by setting the !crAtta SSTH dkey to the Flange THICKNESS of the Identified SCTN
  -- MDS Straps for Pipes Only
  if !crAtta.stype inset ('AT21','AT22') then
    -- Identify SCTN to Bolt Strap to
    prompt off
    prompt load escape 'Identify SCTN to Bolt Strap to'
    --<wd>18jan2008 -- Defect No. P-4407
    --      ID SCTN @
    ID SCTN HSTIFF @
    --<wd>18jan2008 -- Defect No. P-4407
    handle (61,528)
      prompt on
      !!ce = !crAtta
      !!alert.message('SCTN not identified. The Strap has been created to suit the default DESPARS')
      return
    endhandle
    prompt on
    !flangeThick = !!ce.prop.flg
    !!ce = !crAtta
    var !prop coll all data with dkey eq 'SSTH' for dtre
    var !num1 eval num for all from !prop
    despar n$!num1[1]  $!flangeThick
  endif
  -------------------------------------------------------------

  -- 'AT30','SU03','SU04'
  -- MDS Shims and Slip Units for PIPE Shoes ONLY
  if ((!crAtta.stype inset ('AT30','SU03','SU04')) or (!crAtta.stype.matchwild('SU01*')) or (!crAtta.stype.matchwild('SU02*')) ) then
    -- Get the Identified Pipe Shoe properties from the DKEYS HEI, LEN and FWID
    !!ce = !idRefe
    !tempDespar1 = !!ce.prop.hei
    !despar1 = !tempDespar1.real()
    if (!crAtta.stype inset ('SU03','SU04') )then
      !tempDespar2 = prop LEN
      !despar2     = !tempDespar2.real()
      !tempDespar3 = prop FWID
      !despar3     = !tempDespar3.real()
    elseif (!crAtta.stype inset ('AT30')) then
      !tempDespar2 = prop FWID
      !despar2     = !tempDespar2.real()
    endif
    -- Navigate to the Shim/Slip Unit
    !!ce = !crAtta
    despar n1 $!despar1
    handle any
    endhandle
    if (!crAtta.stype inset ('SU03','SU04')) then
      despar n2 $!despar2
      despar n3 $!despar3
    elseif (!crAtta.stype inset ('AT30')) then
      despar n1 $!despar1
      despar n2 $!despar2
    endif
    -- Set support type
    :mdsSuppType |$!crAtta.stype|
    -- Set Shim/Slip Atta :mdsGuideRef to Shoe Atta
    !!ce.:mdsGuideRef = !idRefe
    !crAtta = !!ce
    -- Navigate back to the Pipe Shoe and set :mdsGuideRef to Shim/Slip Atta
    !!ce = !idRefe
    !!ce.:mdsGuideRef = !crAtta
    !!ce = !crAtta
    -- Position atta
    pos at prev
    ori and p3 is p3 of prev
    handle any
      ori p3 is p3 of prev
    endhandle
  endif
  -------------------------------------------------------------

  --'AT53A','AT53B'
  -- MDS Shear Lugs for Clamp-On Pipe Shoes Only i.e. MDS Support types 'AT55A','AT55B','AT56' ONLY
  if (!crAtta.stype inset ('AT53A','AT53B')) then
    -- Get the Length <dkey = 'LEN'> from the identified Pipe SHOE
    !!ce = !idRefe
    !num = !!mdsGetDesp('LEN')
    !len = desp[!num]
    -- Set the Length <dkey = 'LEN'> for the Created Shear Lugs
    !!ce  = !crAtta
    !numX = !!mdsGetDesp('LEN')
    desp n$!numX $!len
  endif
  -------------------------------------------------------------

  -- 'AT62','AT69'
  -- MDS Adjustable Guide Inserts - Only the "Perpendicular" 'AT62','AT69' type may be aligned
  if (!crAtta.styp inset ('AT62','AT69')) then
    -- Get the type of Identified Element
    !!ce = !idRefe
    handle ANY
      -- User has chosen NOT to ALIGN with another MDS Ancillary
      !!ce = !crAtta
      return
    endhandle
    -- Get the identified element !type from the property 'HEI' or 'OHEI'
    !height = !idRefe.prop.hei
    handle any
      !height = !idRefe.prop.ohei
      handle ANY
        ---------------------------------------------------------------------------------------------------
        --<wd>dec2006<mds12> -- Remove any Reference to the !!code.... Global Variables
        --!codZ = '$$' & '!!code' & !crAtta.styp
        --!codX = '$!codZ'
        -- Determine the Client Codes from the PARAGON MDS12 Defaults for !styp and !selection
        !codZ = !!mdsGetDefProp('ATTA', !crAtta.styp, 'CCOD')
        if (!codZ.eq(|ERROR|)) or (!codZ.trim().eq(||)) then
          -- Use the AVEVA MDS STANDARD NAME
          !codZ = !crAtta.styp
        endif
        --<wd>dec2006<mds12>
        ---------------------------------------------------------------------------------------------------
        !!alert.error('Unable to ALIGN the selected ''$!codZ'' with the identified element <i.e. Property ''HEI'' or ''OHEI'' does NOT exist.')
        return
      elsehandle NONE
        !type = 'SLIP'
      endhandle
    elsehandle NONE
      !type = 'SHOE'
    endhandle
    -- If the height was identified then it might have a slip unit attached
    if !type.eq('SHOE') then
      !!ce = !!ce.:mdsGuideRef
      handle any
      elsehandle NONE
        -- Slip Unit is Attached
        !height = !!ce.prop.ohei
        handle any
        endhandle
      endhandle
    endif
    -- Align the 'AT62' or 'AT69' by Setting !crAtta design parameter for the property 'SHOE Height' <Dkey = 'LEN'>
    !!ce   = !crAtta
    !dpNum = !!mdsGetDesp('LEN')
    despar num $!dpNum  $!height
  endif
  -------------------------------------------------------------

  --'AT61'
  -- MDS Vertical Pipe Attachment - NPS 12" to 48"
  if (!crAtta.stype inset('AT61')) then
    -- P1 of the 'AT61' atta always has to be DOWN if not flip ori it and set the :mdsPad uda for the type
    if (!crAtta.pdir[1].wrt(/* ).string().eq('U WRT /*') or !crAtta.pdir[1].wrt(/* ).string().eq('Z WRT /*')) then
      flip ori
    endif
    !type = !crAtta.styp.substring(5,5)
    :mdsPad '$!type'

    -- Set the MTOREF attribute of the !crAtta Atta to the LSTU value
    !lstu = !crAtta.lstu
    !crAtta.mtoref[1] = !lstu
  endif
  -------------------------------------------------------------

  -- 'AT60'
  -- MDS Flange Support for FRP/RTR Pipes Only
  if (!crAtta.stype inset ('AT60')) then
    -- Navigate to the Identified FLANGE and Find the ARRIVE and LEAVE
    !!ce = !idRefe
    !leave = !!ce.leave
    --  Find the ARRIVE and LEAVE of the FLANGE i.e. !idRefe
    if (!leave eq 2) then
      !!ce = !crAtta
      at $!idRefe
    else
      !!ce = !crAtta
      at $!idRefe
      arrive 2 leav 1
    endif
    -- Ori the atta the same
    !!ce = !crAtta
    ori
    -- Position the Flange Support at the Identified Flange Face by Setting the
    -- Relevant Despar number to the property DKEY = FF i.e. 'Offset From Flange Face'
    !offSet = !this.offSet
    !dpNum = !!mdsGetDesp('FF')
    despar num $!dpNum  $!offSet
    at $!idRefe
  endif
  -------------------------------------------------------------

  ----------------------------------------------------------------
  --> Modified - <GE> - apr2005 copied from mdsModStop
  ----------------------------------------------------------------
  --Code for ST32 to position the support below the clamped shoe and to position the shear lugs
  --at clamp edges
  if !crAtta.styp.eq('ST32') then
    !ce = !!ce
    prompt off
    prompt load escape 'Identify clamped shoe to which support is to be welded'
    ID ATTA @
    handle (61,528)
      prompt on
      !!kRestoreUnits(!currentunits)
      return false
    endhandle
    prompt on
    --<wd>18jan2008--removed in appspag check      !clShoe = !!ce
    pin 6 at p12
    pin 7 at p9
    pin 8 copy pl
    pin 9 copy pa
    pin 8 dist 0 inf ce
    Pin 9 dist 0 inf ce
    !distA =!!kStrReal('const dist pin 6 to pin 7')
    !distB =!!kStrReal('const dist pin 8 to pin 9')
    $!ce
    !dpNumA = !!mdsGetDesp('HEI')
    !dpNumB = !!mdsGetDesp('CLEN')
    desp num $!dpNumA  $!distA
    desp num $!dpNumB  $!distB
    !!mdsResetPins(6,9)
  endif
  ----------------------------------------------------------------
  --> Modified - <GE> - apr2005 copied from mdsModStop
  ----------------------------------------------------------------

  -------------------------------------------------------------

endmethod
------------------------------------------------------------------------------------
