--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsgetwall(FORM)                 -
--  returnfromedg(ARRAY)             -
--
define object MDSGETWALL

  member .plane is PLANE
  member .item is DBREF
  member .hanger is DBREF
  member .form is FORM

endobject

define method .mdsgetwall(!form is FORM)

  !this.form = !form

  prompt  'Pick surface of wall to connect hanger to'
  -- Define event packet
  !packet = object EDGPACKET()
  !packet.description = 'WALL'

  -- Remember the element when the packet was first place in the event system
  !packet.initialisation = '!this.input[1] = !!ce'
  !packet.priority = 1

  -- Move to the element picked

  !packet.action = '!!zz.returnfromedg(!this.return)'

  -- Set the close sequence, so that the user returns to the original
  -- element

  !packet.close = ''

  !packet.remove = true $* set packet so that it deletes itself when it finished
  !pickpacket = object EDGPICKPACKET()
  !pickpacket.stdgraphic('Pick surface of wall to connect hanger to')

  -- add the new picktype to the edgpacket currently defined
  !packet.pickpacket = !pickpacket

  -- Add event packet to the system
  !!edgCntrl.add(!packet)

  -- Deactivate form until user has identified wall

  !this.form.setactive(false)

endmethod
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
define method .returnfromedg(!input is ARRAY)

  -- this method is called when the EDG returns from a valid pick
  -- first of all check to see if the item picked was a flange

  !item = !input[1].item
  if !item.type.neq('SBFI') and !item.type.neq('STWALL') and !item.type.neq('GWALL') then
    !!alert.error('Identified element is unsuitable to support from.')
    !!edgCntrl.remove('WALL')
    !this.edgentry()
    !this.form.setactive(TRUE)
    !!ce = !!gwallHanger
    goto href
    !!mdsInterfaceSetOffsetDir(!!ce, !this.form)
    !!gwallHanger.delete()
    return
  endif

  !this.plane = !input[1].positiondata().plane
  if !this.plane.unset() then
    !!alert.error('Please identify a Surface - Not an Edge or PPoint')
    !this.form.setactive(TRUE)
    !!ce = !!gwallHanger
    goto href
    !!mdsInterfaceSetOffsetDir(!!ce, !this.form)
    !!gwallHanger.delete()
    prompt dismiss
    return
  endif

  !this.item = !input[1].item

  !ce = !!ce
  !!ce = !!gwallHanger
  !tailDirection = !this.plane.orientation.zdir()
  tdir $!tailDirection
  pos pt at ph
  move pt plane pt thro $!this.plane.position

  -- Put the tail direction in the support object

  var !newTailDir const dir pt to ph
  tdir $!newTailDir
  !this.form.support.tdir = tdir wrt /*
  !!ce = !ce
  !!ce = !!gwallHanger
  goto href


  !attadirs = !!mdsremovegrad(!!ce)
  if ( !attadirs[1].angle(!newTailDir.direction()).gt(-.1) and !attadirs[1].angle(!newTailDir.direction()).lt(.1) ) or $
    !attadirs[1].angle(!newTailDir.direction()).gt(179.9) and !attadirs[1].angle(!newTailDir.direction()).lt(180.1) then
    -- support parallel to pipe so ne offsetdirections set
  else
    !!mdsInterfaceSetOffsetDir(!!ce, !this.form)
  endif
  !!gwallHanger.delete()
  prompt dismiss

  -- Activate form now user has identified wall

  !this.form.setactive(TRUE)


endmethod
