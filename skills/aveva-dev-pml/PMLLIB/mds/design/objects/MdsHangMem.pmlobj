--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  changeRodSize()                  -
--  getAvailableBores()              ARRAY
--  getAvailableReselectBores()      ARRAY
--  getCrfaPPointNum()               REAL
--  getDataForDkey(STRING)           DBREF
--  getDataParaForDkey(STRING)       ARRAY
--  mdsHangMem(DBREF)                -
--  reselectBore(REAL)               DBREF
--  reselectBore(REAL,STRING)        DBREF
--  selectInMembers(STRING,REAL,STRING) DBREF
--

-- Define Object
define object MDSHANGMEM

  -- Member PDMS Type
  member .type       is STRING

  -- database ref
  member .ref is DBREF

  -- Reference to owning hanger object
  member .hang is MDSHANG

  -- member PLeave Direction
  member .pLDir      is DIRECTION

  -- member PArrive Direction
  member .pADir      is DIRECTION

  -- Has the Member Been Mirrored
  member .mirror     is BOOLEAN

  -- Rotated Manually (Degrees)
  member .rotated    is REAL

  -- Rotated on creation by cursor
  member .rotateCur  is BOOLEAN

  -- Pack in which the component is included
  member .canRotate is BOOLEAN

  -- Height attribute (especially important for a rod)
  member .height    is REAL


  -- Used to reposition support
  member .position is POSITION

  -- Used to re-orientate after modification cancel
  member .orientation is ORIENTATION

  -- User to restore a cancel support back to it's original spref & lstub
  member .spref is DBREF

  member .lsrod is DBREF
  -- To save and restore the design parameters
  member .desp is ARRAY

  -- Pack number in which the component is included
  member .packNo is REAL

  member .styp is STRING

  -- Current rest rod size
  member .rodSize is REAL

  -- New required rod size
  member .newRodSize is REAL


  -- End object
endobject

define method  .mdsHangMem(!comp is DBREF)
  !this.ref = !comp
endmethod



define method .reselectBore(!aBore is REAL) is DBREF
  -- Reselects the current component with the same styp and the same/default other questions but with the given bore.
  !styp = styp
  handle any
    return error 1 |$!!error.text|
  endhandle
  return !this.reselectBore(!aBore, !styp)
endmethod


define method .reselectBore(!aBore is REAL, !styp is STRING) is DBREF
  -- reselects an existing hanger component or pipe component.
  -- the selection will made keeping all the existing answers but the answer to the required question
  -- e.g !elem.reselectBore(24, 'VAR TYPE A') - will reselect the component keeping the same ttyp
  -- and other questions but with question pbor0 equals to 24mm and styp equal to 'VAR TYPE A'
  !ce = !!ce
  -- Initializations
  !found = false
  !this.styp = !styp
  -- Set the current element to be the passed spcom.
  !!ce = !!ce.spref
  -- Searching the SELE element having the required question and qualifier values
  do !i to 20
    end
    !curQuestion = question
    !curQualifier = qualifier
    if(!curQuestion.eq('PBOR') and (!curQualifier eq 0)) then
      -- found the SELE with the required question
      -- all its members are the members having the answers to that question.
      -- we are looking for the first member that has that answer.
      !found = true
      break
    endif
    break if(!!ce.type.eq('SPEC'))
  enddo
  if(not !found) then
    -- There is no such PBOR0 question in the SPEC of the existing component
    !!ce = !ce
    return error 1 | No such PBOR0 question$n.|
  endif
  !spco = !this.selectInMembers('PBOR', 0, String(!aBore))
  handle any
    !!ce = !ce
    return error 2 |No answers to PBOR0. Required answer $!aBore|
  endhandle
  !!ce = !ce
  return !spco
endmethod

define method .selectInMembers(!aQuestion is STRING, !aQualifier is REAL, !anAnswer is STRING) is DBREF

  !ce = !!ce
  !found = false

  -- Loop through the answers SELE's
  -- looking for the required answer
  !question = !aQuestion

  !mem = mem
  !memSize = !mem.size()
  if(!mem.size() eq 0) then
    -- There is no answer for the given question in the SPEC of the existing component
    !!ce = !ce
    return error 1 |No more answers to question $!aQuestion qualifier $!aQualifier$n. Required answer $!anAnswer|
  endif
  -- look for the required answer
  do !seleI indices !mem
    !!ce = !mem[!seleI]
    !curAnswer = answer
    !curMaxanswer = maxanswer
    !curTanswer = Tanswer
    if(!question.eq('PBOR'))then
      !answer = !anAnswer.real()
      if(!answer ge !curAnswer.real() and !answer le !curMaxanswer.real()) then
        !found = true
        !spco = !!ce
        break
      endif
    elseif(!question.eq('STYP'))then
      !answer = !anAnswer
      if(!this.styp.eq(!curTanswer)) then
        !found = true
        !spco = !!ce
        break
      endif
    else
      -- for any other question. Take the first one
      !found = true
    endif
  enddo
  if(not !found) then
    -- There is no answer for the given question in the SPEC of the existing component
    !!ce = !ce
    return error 1 |No answers to question $!aQuestion qualifier $!aQualifier$n. Required answer $!anAnswer|
  endif
  if(!!ce.type.eq('SPCO')) then
    return !!ce
  endif
  !curQuestion = question
  !curQualifier = qualifier
  !spco = !this.selectInMembers(!curQuestion, !curQualifier, !anAnswer)
  handle any
    !!ce = !ce
    return error 2 |No answers to PBOR0. Required answer $!aBore|
  endhandle

  return !spco
endmethod

define method .getAvailableBores() is ARRAY
  -- Returns an array with all bore objects that are defined in the spec
  -- of the current element. This bores include also bores for different STYPs
  !ce = !!ce
  -- Initializations
  !found = false
  !boresArray = ARRAY()
  -- Set the current element to be the passed spcom.
  !!ce = !!ce.spref
  -- Searching the SELE element having the required question and qualifier values
  do !i to 20
    end
    !curQuestion = question
    !curQualifier = qualifier
    if(!curQuestion.eq('PBOR') and (!curQualifier eq 0)) then
      -- found the SELE with the required question
      -- all its members are the members having the answers to that question.
      -- we are looking for the first member that has that answer.
      !found = true
      break
    endif
    break if(!!ce.type.eq('SPEC'))
  enddo
  if(not !found) then
    -- There is no such PBOR0 question in the SPEC of the existing component
    !!ce = !ce
    return error 1 | No such PBOR0 question$n.|
  endif
  !mem = mem
  !memSize = !mem.size()
  if(!mem.size() eq 0) then
    -- There is no answer for the given question in the SPEC of the existing component
    !!ce = !ce
    return error 1 |No more answers to question PBOR qualifier 0.|
  endif
  -- look for the required answer
  do !seleI indices !mem
    !!ce = !mem[!seleI]
    !curAnswer = answer
    !curMaxanswer = maxanswer
    !boresArray.append(!curAnswer)
  enddo
  !!ce = !ce
  return !boresArray
endmethod

define method .getAvailableReselectBores() is ARRAY
  -- Returns an array with all bore objects that are defined in the spec
  -- and have the same styp as the current element
  !ce = !!ce
  !hangMemRef = !this.ref
  !!ce = !hangMemRef
  !bores = !this.getAvailableBores()
  !stypBores = ARRAY()
  do !bore values !bores
    !spco = !this.reselectBore(!bore.real())
    handle any
      -- no spco with current styp for that bore
      skip
    endhandle
    !stypBores.append(!bore.real())
  enddo
  !!ce = !ce
  return !stypBores
endmethod

define method .getCrfaPPointNum() is REAL
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !comp = !this.ref
  !crfa = !comp.crfa
  --!oDbref = object DBREF()
  !ppointNum = 3
  do !i indices !crfa
    if(!crfa[!i].set())then
      !ppointNum = !i
      break
    endif
  enddo
  !!kRestoreUnits(!currentunits)
  return !ppointNum
endmethod

define method .changeRodSize()
  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.traceIn(1, '$!this' + '.changeRodSize()')
  endif
  !ce = !!ce
  !hangMemRef = !this.ref
  !!ce = !hangMemRef
  --       !rodSizes = !this.getAvailableReselectBores()
  --q var !this

  !newRodSize = !this.newRodSize

  !currentSpco = spref
  -- Flag that tells us if the application tried to re-select the component
  !reselected = false
  !newSpco = spref
  if(!!ce.type.eq('PCLA')) then
    -- PCLA has only one rod size for each pipe bore
    -- it is also selected by the pipe size and not by the rod size
  elseif(!!ce.styp.eq('PIPE CLAMP ADAPTER')) then
    desp num 2 $!newRodSize
  else
    if(!!ce.owner.order eq 1 and !this.styp inset$!!mdsallhangertypes.channelAssembly) then
      -- Channel Assembly (B11)
      -- Need to update the rod sizes for the rods connections
      !hm = object MDSHANGMEM(!!ce)
      -- gets a property definition array (e.g. {'DESP',1} or {'PARA',3} or {'HEIG'} or {'DATA'})
      !paras = !hm.getDataParaForDkey('ROSZ')

      if(!paras[1].eq('DESP')) then
        $!paras[1] num $!paras[2] $!newRodSize
      elseif(!paras[1].neq('PARA')) then
        $!paras[1] $!newRodSize
      endif
    endif

    ------------------------------------
    -->>-<wd>aug2003
    ------------------------------------
    -- Channel Assembly - <B11> - <Bottom Channel Connection Type>
    -- Reset the HELE component DESPARS to suit the NEW ROD SIZE
    -- and the NEW HELE SPREF stype 'CHANNEL ASSEMBLY' SIZE to suit ONLY the
    -- GRINNELL/ANVIL Fig. 45 Trapeze - <Page PH-104>
    ------------------------------------
    -- DESP 2 = Hanger Rod Diameter       = dkey ROSZ - Set above at line 312
    -- DESP 4 = Hole for Rod 'H' dia.     = dkey HOLH  )\
    -- DESP 5 = Distance B/B Channels 'S' = dkey CHDS  ) \
    -- DESP 6 = Plate Width 'W'           = dkey PLWW  )  > Set below according to the new rod diameter
    -- DESP 7 = Plate Thickness 'T'       = dkey THKT  ) /
    -- DESP 8 = Plate End Offset          = dkey OFFL  )/
    ------------------------------------

    if (!!ce.styp.eq('CHANNEL ASSEMBLY')) then
      if (!newRodSize.leq(10)) then
        -- 3/8in Rod Diameter
        desp num 4 1/2in
        desp num 5 9/16in
        desp num 6 3in
        desp num 7 1/4in
        desp num 8 3/8in
      elseif (!newRodSize.leq(15)) then
        -- 1/2in Rod Diameter
        desp num 4 5/8in
        desp num 5 11/16in
        desp num 6 3in
        desp num 7 1/4in
        desp num 8 3/8in
      elseif (!newRodSize.leq(16)) then
        -- 5/8in Rod Diameter
        desp num 4 3/4in
        desp num 5 13/16in
        desp num 6 3in
        desp num 7 3/8in
        desp num 8 3/8in
      elseif (!newRodSize.leq(20)) then
        -- 3/4in Rod Diameter
        desp num 4 7/8in
        desp num 5 15/16in
        desp num 6 4in
        desp num 7 3/8in
        desp num 8 3/8in
      elseif (!newRodSize.leq(23)) then
        -- 7/8in Rod Diameter
        desp num 4 1in
        desp num 5 1.1/16in
        desp num 6 4in
        desp num 7 1/2in
        desp num 8 3/8in
      elseif (!newRodSize.leq(30)) then
        -- 1in Rod Diameter
        desp num 4 1.1/4in
        desp num 5 1.3/8in
        desp num 6 4in
        desp num 7 1/2in
        desp num 8 3/8in
      elseif (!newRodSize.leq(35)) then
        -- 1.1/4in Rod Diameter
        desp num 4 1.1/2in
        desp num 5 1.5/8in
        desp num 6 5in
        desp num 7 1/2in
        desp num 8 3/8in
      elseif (!newRodSize.leq(40)) then
        -- 1.1/2in Rod Diameter
        desp num 4 1.3/4in
        desp num 5 1.7/8in
        desp num 6 5in
        desp num 7 3/4in
        desp num 8 3/8in
      elseif (!newRodSize.leq(45)) then
        -- 1.3/4in Rod Diameter
        desp num 4 2in
        desp num 5 2.1/4in
        desp num 6 5in
        desp num 7 3/4in
        desp num 8 3/8in
      elseif (!newRodSize.leq(55)) then
        -- 2in Rod Diameter
        desp num 4 2.1/4in
        desp num 5 2.1/2in
        desp num 6 5in
        desp num 7 3/4in
        desp num 8 3/8in
      elseif (!newRodSize.leq(60)) then
        -- 2.1/4in Rod Diameter
        desp num 4 2.1/2in
        desp num 5 2.3/3in
        desp num 6 6in
        desp num 7 3/4in
        desp num 8 3/8in
      elseif (!newRodSize.leq(65)) then
        -- 2.1/2in Rod Diameter
        desp num 4 2.3/4in
        desp num 5 3in
        desp num 6 6in
        desp num 7 3/4in
        desp num 8 3/8in
      elseif (!newRodSize.leq(70)) then
        -- 2.3/4in Rod Diameter
        desp num 4 3in
        desp num 5 3.1/4in
        desp num 6 6in
        desp num 7 3/4in
        desp num 8 3/8in
      elseif (!newRodSize.leq(80)) then
        -- 3in Rod Diameter
        desp num 4 3.1/4in
        desp num 5 3.1/2in
        desp num 6 6in
        desp num 7 3/4in
        desp num 8 1/2in
      elseif (!newRodSize.leq(85)) then
        -- 3.1/4in Rod Diameter
        desp num 4 3.1/2in
        desp num 5 3.3/4in
        desp num 6 6in
        desp num 7 3/4in
        desp num 8 1/2in
      else
        -- 3.1/2in Rod Diameter
        desp num 4 3.3/4in
        desp num 5 4in
        desp num 6 6in
        desp num 7 3/4in
        desp num 8 1/2in
      endif
    endif
    ------------------------------------
    --<<-<wd>aug2003
    ------------------------------------

    !reselected = true
    !specName = '/' + !currentSpco.name.after('/').before('/')
    hang
    hspec $!specName
    !!ce = !hangMemRef

    ------------------------------------
    -->>-<wd>june2003
    -- Additional CODE added to reselect the correct HROD spref; i.e. the SAME HROD spref but to the NEW ROD SIZE
    if (!!ce.type.eq('HROD')) then
      -- Get the existing HROD 'TTYP' and 'UTYP' selector values before reselecting to the NEW ROD SIZE
      !ttyp = !!ce.spwd.ttyp
      !utyp = !!ce.spwd.utyp
      -- Reselect SPREF of existing HROD with the NEW ROD SIZE
      --$P **** resel spref wi spec /MDS-PSL type hele pbor0 $!newRodSize styp 'HANGER ROD' ttyp '$!ttyp' utyp '$!utyp'
      -- >>> dtf chnaged to allow PIHASA rod sizes to be used
      --resel spref wi spec /MDS-PSL type hele pbor0 $!newRodSize styp 'HANGER ROD' ttyp '$!ttyp' utyp '$!utyp'
      resel spref wi spec $!specName type hele pbor0 $!newRodSize styp 'HANGER ROD' ttyp '$!ttyp' utyp '$!utyp'
      handle any
        -- <ORIGINAL Amos Boudjnah 'handle' CODE copied from the 'else' block shown below>
        !newSpco = !this.reselectBore(!newRodSize)
        handle any
          !err = 'Rod size $!newRodSize is not available for $!!ce.type $!!ce'
          !errNo = 3
          golabel /ERROR
        endhandle
        spref $!newSpco
      endhandle
      !newSpco = spref
    else
      -- All Other HELE 'types'; i.e. HELE that are NOT equal to 'HROD'
      -- <The code below was used for ALL HELE reselection in the ORIGINAL Amos Boudjnah CODE>
      resel wi type hele pbor0 $!newRodSize
      handle any
        !newSpco = !this.reselectBore(!newRodSize)
        handle any
          !err = 'Rod size $!newRodSize is not available for $!!ce.type $!!ce'
          !errNo = 3
          golabel /ERROR
        endhandle
        spref $!newSpco
      endhandle
      !newSpco = spref
    endif
    --<<-<wd>june2003
    ------------------------------------
  endif

  if(!reselected and !currentSpco eq !newSpco) then
    !!alert.warning('Spref have not changed for $!!ce.type $!!ce $!!ce.order ($!!ce)')
  else

  endif
  !this.spref = !newSpco
  !ori = ori
  fconn
  handle any
    !err = !!error.text + ' ' + !!error.line.before('***') + ' for component ' + !!ce.order  + ' ($!!ce) hanger $!this.hang.ref.order in $!this'
    !errNo = 2
    golabel /ERROR
  endhandle
  ori $!ori
  !this.position = pos
  !this.orientation = ori
  !!ce = !ce
  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.traceOut(1, '$!this' + '.changeRodSize()')
  endif
  return
  label /ERROR
  !!ce = !ce
  if(defined(!!mdsDEBUG)) then
    !!mdsDEBUG.trace(1, '$!errNo - $!err')
    !!mdsDEBUG.traceError('$!this' + '.changeRodSize()')
  endif
  return error $!errNo |$!err|
endmethod

define method .getDataForDkey(!dkey is STRING) is DBREF
  -- Returns the ref of the data for the given dkey
  !dtref = !this.ref.dtre
  var !datas collect all with dkey eq '$!dkey' for $!dtref
  if(!datas.empty()) then
    return object DBREF()
  else
    return !datas[1].dbref()
  endif
endmethod

define method .getDataParaForDkey(!dkey is STRING) is ARRAY
  -- Returns the para type and number of the data for the given dkey

  !data = !this.getDataForDkey(!dkey)
  !paras = ARRAY()
  !paras.append(!data.purpose)
  if(!data.number gt 0) then
    !paras.append(!data.number)
  endif
  return !paras
endmethod
