--------------------
--<wd>jun2006<mds12>
-- This METHOD, .loadBottomAssociatedStandardSupports(!line is STRING), has ***CHANGED*** at MDS12

define method .loadBottomAssociatedStandardSupports(!line is STRING)
  -- Expecting lines of the following format:
  -- B7  \ LT05A,LT05B,LT05C,LT05D,LT05E,LT05F,LT05G,LT05H,LT08A,LT08B,LT08C,LT08D,LT08E,LT08F,LT08G,LT08H
  -- B9  \ LT05A,LT05B,LT05C,LT05D,LT05E,LT05F,LT05G,LT05H,LT08A,LT08B,LT08C,LT08D,LT08E,LT08F,LT08G,LT08H
  -- B8  \ TT21
  -- B10 \ LT03A,LT03B,LT03C,LT03D etc.

  !data = !line.split(|\|)
  -- Configuration name (e.g. FH01)
  !name = !data[1].trim().upcase()

  if(!name.match('B7') gt 0 or !name.match('B9') gt 0) then
    -- Standard supports styps of lugs for B7 & B9 connections
    !stdSuppArray = !data[2].upcase().split(',')
    do !i indices !stdSuppArray
      !stdSuppArray[!i] = !stdSuppArray[!i].trim()
      if(!this.weldedElbowOrPipeLugStd.unset())then
        !this.weldedElbowOrPipeLugStd = |('$!stdSuppArray[$!i]'|
      else

        --------------------
        --<wd>jun2006<mds12>
        -- Object member "!this.weldedElbowOrPipeLugStd" is already set and contains values.
        -- Therefore ANY duplicate MDS Standard ATTA LUG Types found need to be made UNIQUE.
        --
        --!this.weldedElbowOrPipeLugStd = !this.weldedElbowOrPipeLugStd + |,'$!stdSuppArray[$!i]'|
        !xstval = !this.weldedElbowOrPipeLugStd.after('(').before(')')
        !xstarr = !xstval.upcase().split(',')
        !chkxst = !xstarr.find(|'$!stdSuppArray[$!i]'|)
        if ( (!chkxst.empty()) or (!chkxst.unset()) ) then
          !this.weldedElbowOrPipeLugStd = !this.weldedElbowOrPipeLugStd + |,'$!stdSuppArray[$!i]'|
        else
          -- SKIP -- Duplicate FOUND in the EXISTING MDS Standard ATTA LUG Types,
          -- i.e. in EXISTING value of !this.weldedElbowOrPipeLugStd
          skip
        endif
        --<wd>jun2006<mds12>
        --------------------

      endif
    enddo

    --------------------
    --<wd>jun2006<mds12> -- Ensure there is ONLY ONE closing bracket, i.e. |)|, at the end of
    -- the value for "!this.weldedElbowOrPipeLugStd"
    --
    --!this.weldedElbowOrPipeLugStd = !this.weldedElbowOrPipeLugStd + |)|
    if (!this.weldedElbowOrPipeLugStd.substring(-1,1).match(|)|).eq(0)) then
      !this.weldedElbowOrPipeLugStd = !this.weldedElbowOrPipeLugStd + |)|
    endif
    --<wd>jun2006<mds12>
    --------------------

  elseif(!name.match('B8') gt 0) then
    -- Standard supports styps of trunnions for B8 connections
    !stdSuppArray = !data[2].upcase().split(',')
    do !i indices !stdSuppArray
      !stdSuppArray[!i] = !stdSuppArray[!i].trim()
      if(!this.weldedElbowtrunionStd.unset())then
        !this.weldedElbowtrunionStd = |('$!stdSuppArray[$!i]'|
      else
        !this.weldedElbowtrunionStd = !this.weldedElbowtrunionStd + |,'$!stdSuppArray[$!i]'|
      endif
    enddo
    !this.weldedElbowtrunionStd = !this.weldedElbowtrunionStd + |)|

  elseif(!name.match('B10') gt 0) then
    -- Standard supports styps of shear lugs for vertical pipes to be used with riser clamps
    !stdSuppArray = !data[2].upcase().split(',')
    do !i indices !stdSuppArray
      !stdSuppArray[!i] = !stdSuppArray[!i].trim()
      if(!this.riserClampStd.unset())then
        !this.riserClampStd = |('$!stdSuppArray[$!i]'|
      else
        !this.riserClampStd = !this.riserClampStd + |,'$!stdSuppArray[$!i]'|
      endif
    enddo
    !this.riserClampStd = !this.riserClampStd + |)|

  elseif(!name.match('B11') gt 0) then
    -- Standard supports styps of shear lugs for vertical pipes to be used with riser clamps
    !stdSuppArray = !data[2].upcase().split(',')
    do !i indices !stdSuppArray
      !stdSuppArray[!i] = !stdSuppArray[!i].trim()
      if(!this.channelAssemblyStd.unset())then
        !this.channelAssemblyStd = |('$!stdSuppArray[$!i]'|
      else
        !this.channelAssemblyStd = !this.channelAssemblyStd + |,'$!stdSuppArray[$!i]'|
      endif
    enddo
    !this.channelAssemblyStd = !this.channelAssemblyStd + |)|

  elseif(!name.match('B13') gt 0) then
    -- Standard supports styps for DS springs supporting pipe with a cradle
    !stdSuppArray = !data[2].upcase().split(',')
    do !i indices !stdSuppArray
      !stdSuppArray[!i] = !stdSuppArray[!i].trim()
      if(!this.dSSpringStd.unset())then
        !this.dSSpringStd = |('$!stdSuppArray[$!i]'|
      else
        !this.dSSpringStd = !this.dSSpringStd + |,'$!stdSuppArray[$!i]'|
      endif
    enddo
    !this.dSSpringStd = !this.dSSpringStd + |)|

  elseif(!name.match('B14') gt 0) then
    -- Standard supports styps for DS springs supporting pipe with a shoe
    !stdSuppArray = !data[2].upcase().split(',')
    do !i indices !stdSuppArray
      !stdSuppArray[!i] = !stdSuppArray[!i].trim()
      if(!this.dSSpringWithShoeStd.unset())then
        !this.dSSpringWithShoeStd = |('$!stdSuppArray[$!i]'|
      else
        !this.dSSpringWithShoeStd = !this.dSSpringWithShoeStd + |,'$!stdSuppArray[$!i]'|
      endif
    enddo
    !this.dSSpringWithShoeStd = !this.dSSpringWithShoeStd + |)|

  elseif(!name.match('B15') gt 0) then
    -- Standard supports styps for BM1 springs (shoes or cradles)
    !stdSuppArray = !data[2].upcase().split(',')
    do !i indices !stdSuppArray
      !stdSuppArray[!i] = !stdSuppArray[!i].trim()
      if(!this.bM1SpringStd.unset())then
        !this.bM1SpringStd = |('$!stdSuppArray[$!i]'|
      else
        !this.bM1SpringStd = !this.bM1SpringStd + |,'$!stdSuppArray[$!i]'|
      endif
    enddo
    !this.bM1SpringStd = !this.bM1SpringStd + |)|

  elseif(!name.match('B16') gt 0) then
    -- Standard supports styps for BM2 springs (cradles)
    !stdSuppArray = !data[2].upcase().split(',')
    do !i indices !stdSuppArray
      !stdSuppArray[!i] = !stdSuppArray[!i].trim()
      if(!this.bM2SpringStd.unset())then
        !this.bM2SpringStd = |('$!stdSuppArray[$!i]'|
      else
        !this.bM2SpringStd = !this.bM2SpringStd + |,'$!stdSuppArray[$!i]'|
      endif
    enddo
    !this.bM2SpringStd = !this.bM2SpringStd + |)|

  elseif(!name.match('B17') gt 0) then
    -- Standard supports styps of shear lugs for vertical pipes to be used with BM1 springs
    !stdSuppArray = !data[2].upcase().split(',')
    do !i indices !stdSuppArray
      !stdSuppArray[!i] = !stdSuppArray[!i].trim()
      if(!this.doubleBM1SpringStd.unset())then
        !this.doubleBM1SpringStd = |('$!stdSuppArray[$!i]'|
      else
        !this.doubleBM1SpringStd = !this.doubleBM1SpringStd + |,'$!stdSuppArray[$!i]'|
      endif
    enddo
    !this.doubleBM1SpringStd = !this.doubleBM1SpringStd + |)|

  endif
endmethod

define method .loadTemplateName(!line is STRING)

  -- Expecting lines of the following format:
  -- alias \ VH101 \ VH102 , VH103, VH105

  !data = !line.split(|\|)
  !value = !data[2].trim()
  if(!value.substring(1,2).eq('FH') or !value.substring(1,2).eq('VH')) then
    -- valid entry
  else
    -- invalid entry
    !!alert.error('Invalid entry $!line for alias')
    return error 1 'Invalid entry $!line for alias'
  endif
  !keys = !data[3].trim().split(',')
  do !key values !keys
    !this.associatedWithTemplate.append(!key.trim())
    !this.aliasTempate.append(!value)
  enddo
endmethod

define method .getTemplateName(!key is STRING) is STRING

  !index = !this.associatedWithTemplate.findFirst(!key.trim())
  if(!index.unset()) then
    return !key
  else
    return !this.aliasTempate[!index]
  endif
endmethod

define method .getAssociatedForTemplate(!key is STRING) is ARRAY
  !aliases = ARRAY()
  !indices = !this.aliasTempate.find(!key.trim())
  do !index values !indices
    !aliases.append(!this.associatedWithTemplate[!index])
  enddo
  return !aliases
endmethod

define method .loadStdRodSizes(!line is STRING)
  -- Expecting lines of the following format:
  -- ROD \ 12    \ 300 \ 12,16,20,24,30,36
  !data = !line.split(|\|)
  !sPipeSize = !data[3].trim()
  !sRodSizes = !data[4]
  !aRodSizes = !sRodSizes.split(',')
  -- Transforms rod sizes values from string to real
  !toReal = object BLOCK('!aRodSizes[!evalindex].trim().real()')
  !rRodSizes = !aRodSizes.evaluate(!toReal)
  !this.allowedRodSizesPerPipe[!sPipeSize.real()] = !rRodSizes
endmethod
