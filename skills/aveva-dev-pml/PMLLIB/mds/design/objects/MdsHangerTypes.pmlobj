--
-- File: MdsHangerTypes.pmlobj
--   Type: Object Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: A.Boudjnah
-- Created: Tue May 14th 2002
--
--
-- Description:
-- Multi Discipline Support mdsHangerTypes object. Used as a container for all available hanger types.
-- It is also offer various services for the various hanger types (e.g. filtering the hanger type according to pipe
-- bore, pipe insulation and hanger groups
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(MDSHANGERTYPES)              -
--  endHangerConfiguration()         -
--  getAssociatedForTemplate(STRING) ARRAY
--  getHangerType(STRING)            MDSHANGERTYPE
--  getHangersForBeamType(STRING)    MDSHANGERTYPES
--  getHangersForBore(REAL)          MDSHANGERTYPES
--  getHangersForCategory(STRING)    MDSHANGERTYPES
--  getHangersForGroup(REAL)         MDSHANGERTYPES
--  getHangersForInsu(STRING)        MDSHANGERTYPES
--  getTemplateName(STRING)          STRING
--  isHangerForBore(STRING,REAL)     BOOLEAN
--  isHangerForInsu(STRING,STRING)   BOOLEAN
--  loadBottomAssociatedStandardSupports(STRING) -
--  loadConfigurations()             -
--  loadHangerConfiguration(STRING)  -
--  loadStdRodSizes(STRING)          -
--  loadTemplateName(STRING)         -
--  mdshangertypes()                 -
--  mdshangertypes(BOOLEAN)          -
--  setFilterByBeam(FORM,REAL,BOOLEAN) -
--  setFilterByBeamType(FORM,STRING,BOOLEAN) -
--  setFilterByBore(FORM,REAL,BOOLEAN) -
--  setFilterByGroup(FORM,REAL,BOOLEAN) -
--  setFilterByInsu(FORM,STRING,BOOLEAN) -
--  setFilterByPipe(FORM,BOOLEAN)    -
--  sethangertype(STRING,ANY)        -
--  size()                           REAL
--  sortedIndices(STRING)            ARRAY
--

-- Define Object
define object MDSHANGERTYPES

  -- Holds the assemblies definition for rotation for each hanger
  -- Each element in the array represents a rotation definition for an hanger
  -- Each element is an array of "mdshangmem" objects
  member .rotDefinition is ARRAY

  -- hangertype objects
  member .objects is ARRAY

  -- hangertype styp name (e.g. FH01, VH19)
  member .names is ARRAY

  -- hangertype category name (e.g. VH, FH). Used to quickly filter lists according to type (VH or VH)
  member .categories is ARRAY

  -- Group number for hanger types that are connected to double channel beams
  member .doubleChannelGroupNo is REAL

  -- Group number for hanger types that are connected to one beam with one hanger
  member .oneBeamSingleHangerGroupNo is REAL

  -- Group number for hanger types that are connected to double channel beams
  member .doubleHangerGroupNoSingleBeam is REAL

  -- Group number for hanger types that are connected to double channel beams
  member .doubleHangerGroupNoDoubleChannel is REAL

  -- Group number for hanger types that are connected to double channel beams
  member .doubleHangerGroupNoCombined is REAL

  -- Group number for hanger types that are connected to an offset hanger
  member .beamOffsetHangerGroupNo is REAL

  -- Group number for hanger types that are connected to a pipe
  member .pipeHangerGroupNo is REAL

  --  Group number for hanger types that are supported from pipe bottom. No steelwork connection
  member .bottomSupportedGroupNo is REAL
  member .bottomSupportedSpringGroupNo is REAL

  --  Group number for hanger types that are supported from pipe bottom to steel
  member .dynamicGroupNo is REAL

  --  Group number for hanger types that are supported from pipe bottom to civil
  member .dynamicGroupNoCivil is REAL

  --  Group number for single civil hangers attachments.
  member .civilPlateGroupNo is REAL

  --  Group number for angulating spring to steel supports.
  member .angulatingSpringsSteelGroupNo is REAL

  --  Group number for angulating spring to civil supports.
  member .angulatingSpringsCivilGroupNo is REAL

  --  Group number for double civil hangers attachments.
  member .civilPlateDoubleHanger is REAL

  -- Array to hold the allowed beam type for each hangers group
  member .groupBeamTypes is ARRAY

  -- List of all hangers that can only be connected to a double channel beam (with a rod) (T4 connection type(see PS-095-5001))
  --  member .doubleChannelRodConnection is STRING

  -- List of all hangers that can only be connected to a double channel beam (with a rod) (T4 connection type(see PS-095-5001))
  member .doubleChannelRodConnectionVariable is ARRAY

  -- List of all hangers that can only be connected to a double channel beam (with a rod) (T4 connection type(see PS-095-5001))
  member .doubleChannelRodConnectionFixed is ARRAY

  -- List of all hangers that can only are connected to the beam through a clevis and a lug (T1 connection type(see PS-095-5001))
  member .clevisAndLugFixed is ARRAY

  -- List of all hangers that can only are connected to the beam through a clevis and a lug (T1 connection type(see PS-095-5001))
  member .clevisAndLugVariable is ARRAY

  -- List of all fixed hangers that are connected with only one rod (No Turnbuckle) (M1 connection type(see PS-095-5001))
  member .oneRodFixed is ARRAY

  -- List of all variable hangers that are connected with only one rod (No Turnbuckle) (M1 connection type(see PS-095-5001))
  member .oneRodVariable is ARRAY

  -- List of all hangers that are connected to the beam with an eye rod and a beam attachment (T3 connection type(see PS-095-5001))
  member .eyeRodFixed is ARRAY

  -- List of all hangers that are connected to the beam with an eye rod and a beam attachment (T3 connection type(see PS-095-5001))
  member .eyeRodVariable is ARRAY

  -- List of all hangers that have no rods. Hanger's height is fixed and can't be adjusted (No M1, No M2, No M3)
  member .noRods is ARRAY

  -- List of all variable springs with a TS1 spring type (M3 connection type(see PS-095-5001))
  member .tS1Spring is ARRAY

  -- List of all variable springs with a TS2 spring type (T9 connection type(see PS-095-5001))
  member .tS2Spring is STRING

  -- List of all variable springs with a TS3 spring type (T10 connection type(see PS-095-5001))
  member .tS3Spring is ARRAY

  -- List of all variable springs with a M5 Constant type (M5 connection type(see Pihasa c52 constant)
  member .m5Constant is ARRAY

  -- List of all variable springs with a TA spring type (T13 connection type(see PS-095-5001))
  member .tASpring is STRING

  -- List of all variable springs with a ES spring type (T14 connection type(see PS-095-5001))
  member .eSSpring is STRING

  -- List of all variable springs with a DS spring type (B13 & B14 connection type(see PS-095-5001))
  -- Supports the pipe with a cradle
  member .dSSpring is STRING

  -- List of all variable springs with a DS spring type (B14 connection type(see PS-095-5001))
  -- Same as .dSSpring but support the pipe with a shoe
  -- This type of hangers is a subgroup of the .dSSpring types and is used only when is differed from
  -- the .dSSpring group type.
  member .dSSpringWithShoe is STRING

  -- List of all variable springs with a BM spring type (B15 connection type(see PS-095-5001))
  member .bM1Spring is STRING

  -- List of all variable springs with a BM spring type (B16 connection type(see PS-095-5001))
  member .bM2Spring is STRING

  -- List of all variable springs with a BM spring type (B17 connection type(see PS-095-5001))
  member .doubleBM1Spring is STRING

  -- List of all variable springs with a ES spring type (B10 connection type(see PS-095-5001))
  -- member .riserClamp is STRING
  member .riserClamp is ARRAY

  -- List of all hangers connected to the pipe through a pipe clamp  (B1, B2, B5, B6 connection type(see PS-095-5301))
  member .pipeClamp is ARRAY

  -- List of all hangers connected to welded elbow lug (B7 connection type(see PS-095-5301))
  member .weldedElbowOrPipeLug is STRING

  -- List of all hangers connected to welded elbow trunnion (B8 connection type(see PS-095-5305))
  member .weldedElbowtrunion is STRING

  -- List of all double hangers with a channel assembly (not available in PSL catalog) (B11 connection type(see PS-095-5305))
  member .channelAssembly is STRING

  -- matching standard shoe code
  member .bM1SpringStd is STRING

  -- matching standard cradle code
  member .bM2SpringStd is STRING

  -- matching standard cradle code
  member .dSSpringStd is STRING

  -- matching standard shoe code
  member .dSSpringWithShoeStd is STRING

  -- matching standard shear lug code
  member .doubleBM1SpringStd is STRING

  -- matching standard lug code
  member .weldedElbowOrPipeLugStd is STRING

  -- matching standard trunnion code
  member .weldedElbowtrunionStd is STRING

  -- matching standard shear lug code
  member .riserClampStd is STRING

  -- matching standard cradle code
  member .channelAssemblyStd is STRING

  -- Array of hanger configuration names that do not have their own template but use
  -- the template of the alias configuration (e.g VH102 uses template VH101)
  member .associatedWithTemplate is ARRAY

  -- Array of hanger configuration names that have a template with the same name
  -- and are used also for similar configuration that do not have their own template(e.g. VH101)
  member .aliasTempate is ARRAY

  -- Array of allowed rod sizes for each pipe size
  member .allowedRodSizesPerPipe is ARRAY

  -- Current tube to be used for filtering
  member .tubeRef is DBREF

  -- Current beam references to be used for filtering
  member .beamRef is ARRAY

  -- stwall connection
  member .stwallconn is BOOLEAN

  -- End object
endobject

define method .mdshangertypes()

  -- Default object constructor
  -- Define groups for filtering hanger types (Valid for variable and fixed hangers)

  !this.objects = ARRAY()
  !this.names = ARRAY()
  !this.categories = ARRAY()
  !this.stwallconn = FALSE

  !this.oneBeamSingleHangerGroupNo = 1
  !this.doubleChannelGroupNo = 2
  !this.doubleHangerGroupNoSingleBeam = 31
  !this.doubleHangerGroupNoDoubleChannel = 32
  !this.doubleHangerGroupNoCombined = 33
  !this.beamOffsetHangerGroupNo = 4
  !this.pipeHangerGroupNo = 5
  !this.bottomSupportedGroupNo = 6
  !this.bottomSupportedSpringGroupNo = 600
  !this.dynamicGroupNo = 17
  !this.dynamicGroupNoCivil = 20
  !this.angulatingSpringsSteelGroupNo = 21
  !this.angulatingSpringsCivilGroupNo = 25
  !this.civilPlateGroupNo = 18
  !this.civilPlateDoubleHanger = 19

  --<wd>dec2007<mds12> -- Defect No. P-120 and P-4407 -- AVEVA MARINE HULL GTYPE 'ANG' for element types SCTN & HSTIFF added to the ID list
  --  !this.groupBeamTypes[!this.oneBeamSingleHangerGroupNo] = |('BEAM','DINI','BSC','DINU','DBEA','CHNI','CHNU','BOX','DINP','JISU','PLAT')|
  !this.groupBeamTypes[!this.oneBeamSingleHangerGroupNo] = |('ANG','BEAM','DINI','BSC','DINU','DBEA','CHNI','CHNU','BOX','DINP','JISU','PLAT')|
  --<wd>dec2007<mds12> -- Defect No. P-120 and P-4407 -- AVEVA MARINE HULL GTYPE 'ANG' for element types SCTN & HSTIFF added to the ID list

  !this.groupBeamTypes[!this.doubleChannelGroupNo] = |('BSC-BSC','DINU-DINU','CHNU-CHNU','DINP-DINP','JISU-JISU')|
  !this.groupBeamTypes[!this.doubleHangerGroupNoSingleBeam] = |('BEAM','DINI','BSC','DINU','DBEA','CHNI','CHNU','BOX','DINP','JISU','PLAT')|
  !this.groupBeamTypes[!this.doubleHangerGroupNoDoubleChannel] = |('BSC-BSC','DINU-DINU','CHNU-CHNU','DINP-DINP','JISU-JISU')|
  !this.groupBeamTypes[!this.doubleHangerGroupNoCombined] = |('BEAM','DINI','BSC','DINU','BSC-BSC','DINU-DINU','CHNU-CHNU','DBEA')|
  !this.groupBeamTypes[!this.beamOffsetHangerGroupNo] = |('BEAM','DINI','BSC','DINU','DBEA','CHNI','DINP','JISU','BOX','PLAT')|
  !this.groupBeamTypes[!this.pipeHangerGroupNo] = |()|
  if(defined(!!mdsHangIf)) then
    if !!mdsHangIf.eq('CPL') then
      !this.groupBeamTypes[!this.bottomSupportedGroupNo] = |('BEAM','DINI','BSC','DINU','DBEA','CHNI','DINP','JISU','BOX','PLAT')|
    elseif !!mdsHangIf.eq('PSL') then
      !this.groupBeamTypes[!this.bottomSupportedGroupNo] = |('BEAM','DINI','BSC','DINU','DBEA','CHNI','DINP','JISU','BOX','PLAT')|
    endif
  else
    !this.groupBeamTypes[!this.bottomSupportedGroupNo] = |()|
    !this.groupBeamTypes[!this.bottomSupportedSpringGroupNo] = |()|
  endif
  !this.groupBeamTypes[!this.dynamicGroupNo] = |('BEAM','DINI','BSC','DINU','DBEA','CHNI','CHNU','DINP','JISU','BOX','PLAT')|
  !this.groupBeamTypes[!this.dynamicGroupNoCivil] = |('FLOOR','PANE','WALL')|
  !this.groupBeamTypes[!this.angulatingSpringsSteelGroupNo] = |('BEAM','DINI','BSC','DINU','DBEA','CHNI','CHNU','DINP','JISU','BOX','PLAT')|
  !this.groupBeamTypes[!this.angulatingSpringsCivilGroupNo] = |('FLOOR','PANE','WALL')|
  !this.groupBeamTypes[!this.civilPlateGroupNo] = |('FLOOR','PANE')|
  !this.groupBeamTypes[!this.civilPlateDoubleHanger ] = |('FLOOR','PANE')|

endmethod

define method .mdshangertypes(!refresh is BOOLEAN)
  -- Constructor to create an empty or a populated Mdshangertypes container
  -- !refresh - a flag. Is true, reload the object from the design templates
  --            if false create an empty object
  -- Call the default constructor
  !this.mdshangertypes()
  if(not !refresh) then

    return
  endif
  -- Go to hanger templates site
  !ce = !!ce
  !this.loadConfigurations()
  !siteName = '/MDS/HANGERS'
  !siteRef = !siteName.dbref()
  handle ANY
    !!ce = !ce
    !!alert.error('Hanger template site $!siteName does not exist. This site is needed for the MDS hangers application.')

    return
  endhandle
  !!ce = !siteRef
  !mem = mem zone
  !index = 0
  do !zone values !mem
    !!ce = !zone
    !styp = !!ce.name.after('/MDS/')
    if(not !styp.substring(1,2) inset('FH', 'VH')) then
      skip
    endif
    !oStyp = object MDSHANGERTYPE(!styp)
    !index = !index + 1
    !this.objects[!index] = !oStyp
    !this.names[!index] = !styp
    !this.categories[!index] = !styp.substring(1,2)
    -- create aliases
    !associatedArray = !this.getAssociatedForTemplate(!styp)


    do !associatedStyp values !associatedArray
      !oAssociatedStyp = !oStyp
      !oAssociatedStyp.styp = !associatedStyp
      !index = !index + 1
      !this.objects[!index] = !oAssociatedStyp
      !this.names[!index] = !associatedStyp
      !this.categories[!index] = !associatedStyp.substring(1,2)
    enddo
  enddo
  !!ce = !ce
endmethod

define method .getHangerType(!hangerTypeName is STRING) is MDSHANGERTYPE
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !index = !this.names.findFirst(!hangerTypeName)
  if(!index.set()) then
    -- returns the hangertype object
    !!kRestoreUnits(!currentunits)
    return !this.objects[!index]
  endif
  -- returns an empty value
  !unsetObject = object MDSHANGERTYPE()
  !!kRestoreUnits(!currentunits)
  return !unsetObject
endmethod

define method .sethangertype(!hangerTypeName is STRING, !oHangType is ANY)
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !index = !this.names.findFirst(!hangerTypeName)
  if(!index.set()) then
    -- update the hangertype object
    !!kRestoreUnits(!currentunits)
    !this.objects[!index] = !oHangType
    return
  endif
  !err = 'Error in $!this' + 'setHangerType($!hangerTypeName is STRING, $!oHangType is MDSHANGERTYPE)'
  !!kRestoreUnits(!currentunits)
  return error 1 '$!err'
endmethod

define method .getHangersForCategory(!hangCategory is STRING) is MDSHANGERTYPES
  -- Returns an hangertypes object containing only the required hanger category (e.g. VH or FH)
  -- !hangCategory is a string like: 'VH' or 'FH'
  -- get an array of indices for the required category from this container
  !currentunits = !!kgetsetunits()
  mm bore mm dist

  !array = !this.categories.find(!hangCategory)
  if(!array.set()) then
    -- create an empty hangertypes object
    --    !hangerTypes = object MDSHANGERTYPES(false)
    !hangerTypes = !this
    !hangerTypes.objects = ARRAY()
    !hangerTypes.names = ARRAY()
    !hangerTypes.categories = ARRAY()
    do !i indices !array
      !hangerTypes.objects[!i] = !this.objects[!array[!i]]
      !hangerTypes.names[!i] = !this.names[!array[!i]]
      !hangerTypes.categories[!i] = !this.categories[!array[!i]]
    enddo
    !!kRestoreUnits(!currentunits)
    return !hangerTypes
  endif
  -- returns an unset value
  !!kRestoreUnits(!currentunits)
  return !array
endmethod

define method .getHangersForBore(!bore is REAL) is MDSHANGERTYPES
  -- Returns an hangertypes object containing only the hanger types that are allowed for the given bore
  -- create an empty hangertypes object
  if(defined(!!mdsdebug)) then
    !!mdsdebug.traceIn(1,'$!this' + '.getHangersForBore($!bore is REAL) is MDSHANGERTYPES')
  endif
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !hangerTypes = object MDSHANGERTYPES(FALSE)
  !j = 0
  do !i indices !this.objects
    !oHangType = !this.objects[!i]
    if(!oHangType.isHangerForBore(!bore))then
      !j = !j + 1
      !hangerTypes.objects[!j] = !this.objects[!i]
      !hangerTypes.names[!j] = !this.names[!i]
      !hangerTypes.categories[!j] = !this.categories[!i]
    endif
  enddo
  if(defined(!!mdsdebug))then
    !size = !hangerTypes.size()

    !!mdsdebug.trace(2, 'Size of hangertypes: $!size')
    !!mdsdebug.traceOut(1, '$!this' + '.getHangersForBore($!bore is REAL) is MDSHANGERTYPES')
  endif

  !!kRestoreUnits(!currentunits)
  return !hangerTypes
endmethod

define method .getHangersForGroup(!group is REAL) is MDSHANGERTYPES
  -- Returns an hangertypes object containing only the hanger types that are allowed for the given group no.
  -- create an empty hangertypes object
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !hangerTypes = object MDSHANGERTYPES(FALSE)
  !j = 0
  do !i indices !this.objects
    !oHangType = !this.objects[!i]
    if(!oHangType.group eq !group)then
      !j = !j + 1
      !hangerTypes.objects[!j] = !this.objects[!i]
      !hangerTypes.names[!j] = !this.names[!i]
      !hangerTypes.categories[!j] = !this.categories[!i]
    endif
  enddo
  !!kRestoreUnits(!currentunits)
  return !hangerTypes
endmethod

define method .getHangersForBeamType(!beamType is STRING) is MDSHANGERTYPES
  -- Returns an hangertypes object containing only the hanger types that are allowed for the given beam type
  -- create an empty hangertypes object
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !hangerTypes = object MDSHANGERTYPES(FALSE)
  !j = 0

  do !i indices !this.objects
    !oHangType = !this.objects[!i]
    !j = !j + 1
    if(!beamType inset$!this.groupBeamTypes[$!oHangType.group])then
      !hangerTypes.objects[!j] = !this.objects[!i]
      !hangerTypes.names[!j] = !this.names[!i]
      !hangerTypes.categories[!j] = !this.categories[!i]
    endif

  enddo
  !!kRestoreUnits(!currentunits)
  return !hangerTypes
endmethod

define method .isHangerForBore(!hangerType is STRING, !bore is REAL) is BOOLEAN
  -- Returns true if the given bore is within the allowed bore range for the given hanger type
  -- false if not.
  -- get the hanger type object for the given hanger type name
  if(defined(!!mdsdebug))then
    !!mdsdebug.traceIn(1, '$!this.string()' + '.isHangerForBore($!hangerType is STRING, $!bore is REAL) is BOOLEAN')
  endif
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !flag = object BOOLEAN()
  !oHangType = !this.getHangerType(!hangerType)
  if(!oHangerType.set()) then
    !flag = !oHangType.isHangerForBore(!bore)
  else
    !flag = FALSE
  endif
  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsdebug))then
    !!mdsdebug.trace(1, 'Returning $!flag')
    !!mdsdebug.traceOut(1, '$!this.string()' + '.isHangerForBore($!hangerType is STRING, $!bore is REAL) is BOOLEAN')
  endif
  return !flag
endmethod

define method .getHangersForInsu(!insuFilter is STRING) is MDSHANGERTYPES
  -- Returns an hangertypes object containing only the hanger types that are allowed for the given insulation filter
  -- criteria.
  -- create an empty hangertypes object
  !currentunits = !!kgetsetunits()
  mm bore mm dist

  !hangerTypes = object MDSHANGERTYPES(FALSE)

  --> 12/2002 <ab> Modify for better response time
  !objects = !this.objects
  !names = !this.names
  !categories = !this.categories

  if(!insuFilter.eq('INSU')) then
    !newOrder = !this.sortedIndices('insuonly')

    !objects.reIndex(!newOrder)
    !names.reIndex(!newOrder)
    !categories.reIndex(!newOrder)

    !extractKeys = object BLOCK('!objects[!evalindex].insuonly')
    !sortKeys = !objects.evaluate(!extractKeys)
    !firstTrueI = !sortKeys.findFirst(TRUE)

    !newObjects = !objects.from(!firstTrueI)
    handle ANY
      !newObjects = ARRAY()
    endhandle
    !newNames = !names.from(!firstTrueI)
    handle ANY
      !newNames = ARRAY()
    endhandle
    !newCategories = !categories.from(!firstTrueI)
    handle ANY
      !newCategories = ARRAY()
    endhandle
  elseif(!insuFilter.eq('NOINSU')) then
    !newOrder = !this.sortedIndices('noInsuOnly')

    !objects.reIndex(!newOrder)
    !names.reIndex(!newOrder)
    !categories.reIndex(!newOrder)

    !extractKeys = object BLOCK('!objects[!evalindex].noInsuOnly')
    !sortKeys = !objects.evaluate(!extractKeys)
    !firstTrueI = !sortKeys.findFirst(TRUE)

    !newObjects = !objects.from(!firstTrueI)
    handle ANY
      !newObjects = ARRAY()
    endhandle
    !newNames = !names.from(!firstTrueI)
    handle ANY
      !newNames = ARRAY()
    endhandle
    !newCategories = !categories.from(!firstTrueI)
    handle ANY
      !newCategories = ARRAY()
    endhandle
  elseif(!insuFilter.eq('INSU_NA')) then
    !newOrder = !this.sortedIndices('insuonly')

    !objects.reIndex(!newOrder)
    !names.reIndex(!newOrder)
    !categories.reIndex(!newOrder)

    !extractKeys = object BLOCK('!objects[!evalindex].insuonly')
    !sortKeys = !objects.evaluate(!extractKeys)
    !firstTrueI = !sortKeys.findFirst(TRUE)

    !newObjectsInsu = !objects.to(!firstTrueI - 1)
    handle ANY
      !newObjectsInsu = ARRAY()
    endhandle
    !newNamesInsu = !names.to(!firstTrueI - 1)
    handle ANY
      !newNamesInsu = ARRAY()
    endhandle
    !newCategoriesInsu = !categories.to(!firstTrueI - 1)
    handle ANY
      !newCategoriesInsu = ARRAY()
    endhandle

    !newOrder = !this.sortedIndices('noInsuOnly')

    !objects = !this.objects
    !names = !this.names
    !categories = !this.categories

    !objects.reIndex(!newOrder)
    !names.reIndex(!newOrder)
    !categories.reIndex(!newOrder)

    !extractKeys = object BLOCK('!objects[!evalindex].noInsuOnly')
    !sortKeys = !objects.evaluate(!extractKeys)
    !firstTrueI = !sortKeys.findFirst(TRUE)

    !newObjectsNoInsu = !objects.to(!firstTrueI - 1)
    handle ANY
      !newObjectsNoInsu = ARRAY()
    endhandle
    !newNamesNoInsu = !names.to(!firstTrueI - 1)
    handle ANY
      !newNamesNoInsu = ARRAY()
    endhandle
    !newCategoriesNoInsu = !categories.to(!firstTrueI - 1)
    handle ANY
      !newCategoriesNoInsu = ARRAY()
    endhandle

    !newObjects = !newObjectsNoInsu.intersect(!newObjectsInsu)
    !newNames = !newNamesNoInsu.intersect(!newNamesInsu)
    !newCategories = !newCategoriesNoInsu.intersect(!newCategoriesInsu)
  endif
  !hangerTypes.objects = !newObjects
  !hangerTypes.names = !newNames
  !hangerTypes.categories = !newCategories

$(
-- 12/2002 <ab> old code with bad response time

!j = 0
do !i indices !this.objects
!oHangType = !this.objects[!i]
if(!oHangType.isHangerForInsu(!insuFilter))then
!j = !j + 1
!hangerTypes.objects[!j] = !this.objects[!i]
!hangerTypes.names[!j] = !this.names[!i]
!hangerTypes.categories[!j] = !this.categories[!i]
endif
enddo
$)
  --< 12/2002 <ab> Modify for better response time

  !!kRestoreUnits(!currentunits)
  return !hangerTypes
endmethod

define method .sortedIndices(!attribute is STRING) is ARRAY
  !objects = !this.objects
  !extractKeys = object BLOCK('!objects[!evalindex].' + !attribute)
  !sortKeys = !objects.evaluate(!extractKeys)
  !newOrder = !sortKeys.sortedIndices()
  return !newOrder
endmethod

define method .isHangerForInsu(!hangerType is STRING, !insuFilter is STRING) is BOOLEAN
  -- Returns true if the given hanger type is allowed to be used for the given insulation filter criteria
  -- false if not.
  -- insuFilter - insulation filter (e.g. '', 'INSU', 'NOINSU')
  -- get the hanger type object for the given hanger type name
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !oHangType = !this.getHangerType(!hangerType)
  if(!oHangerType.set()) then
    !!kRestoreUnits(!currentunits)
    return !oHangType.isHangerForInsu(!insuFilter)
  endif
  !!kRestoreUnits(!currentunits)
  return FALSE
endmethod

define method .setFilterByPipe(!form is FORM, !refresh is BOOLEAN)

  -- Filters by pipe bore and state of pipe insulation (insulated/not insulated)
  -- !refresh - If TRUE, filter will be activated on the complete hanger list
  --            if FALSE, filter will be activated on the current form list
  --  !this.standard.dtext = !this.standardDtexBackup
  --  !this.standard.rtext = !this.standardRtexBackup

  if(defined(!!mdsdebug)) then
    !!mdsdebug.traceIn(1,'$!this.setFilterByPipe($!form is FORM, $!refresh is BOOLEAN)')
  endif

  !currentunits = !!kgetsetunits()
  mm bore mm dist

  label /IDTUBE

  --><wd>17nov2009 - DFN-P25277 (SI-17086)
  !existCE = !!ce
  --<<wd>17nov2009 - DFN-P25277 (SI-17086)

  if(!form.tubeRef.set()) then
    -- Form has the tuberef set so there is no need to id the tube
    !!ce = !form.tubeRef
  else
    if defined(!!licadautotestenabled) then
      !!ce = !!licadautotest.branch
    else
      prompt off
      prompt load escape 'Identify tube to be supported'
      ID TUBE @
      handle ANY
        prompt on
        !!kRestoreUnits(!currentunits)
        return error 1 '$!!error.text'

      --><wd>17nov2009 - DFN-P25277 (SI-17086)
      -- When a Support Type 6 or 600 has been selected Check if a MDS Trunnion branch etc... has been Identified
      elsehandle NONE
        if ((!form.oRadio.activeindex.eq(6)) or (!form.oRadio.activeindex.eq(600))) then
          -- Check the Identified TUBE is NOT a MDS TRUNNION BRANC which is NOT HORIZONTAL, i.e. VERTICAL
          !identifiedElement = !!ce
          if (!identifiedElement.type.eq('BRAN')) then
            !leaveDirection = !!ce.hdir.wrt(/* )
            !owningBranch = !identifiedElement
          else
            -- Branch Component Selected
            !leaveDirection = !!ce.ldir.wrt(/* )
            !owningBranch = !identifiedElement.owner
          endif

          !leaveDirectionUp = !leaveDirection.up
          if (!owningBranch.:MDSTRUN) then
            if ((!leaveDirectionUp.between(-1, -0.2)) or (!leaveDirectionUp.between(0.2, 1))) then
              --P-37906 allow pedestal support creation on a vertical trunnion base for witchhanger only - start
              if !!mdsHangIf.eq('CPL') then
                --do nothing
              else
                !!ce = !existCE
                prompt on
                $!currentunits
                return error 1 'A NON-Horizontal MDS Trunnion Branch may NOT be supported from a PEDESTAL type support'
              endif
              --P-37906 allow pedestal support creation on a vertical trunnion base for witchhanger only - end
            endif
          else
            -- A REAL PDMS PIPE has been identified and NOT an MDS TRUNNION Branch
            if ((!leaveDirectionUp.between(-1, -0.2)) or (!leaveDirectionUp.between(0.2, 1))) then
              !!ce = !existCE
              prompt on
              !!kRestoreUnits(!currentunits)
              return error 1 'A NON-Horizontal Pipe Branch may NOT be supported from a PEDESTAL type support'
            endif
          endif
        endif
      -- When a Support Type 6 or 600 has been selected Check if a MDS Trunnion branch etc... has been Identified
      --<<wd>17nov2009 - DFN-P25277 (SI-17086)
      endhandle
    endif
  endif

  -- Check to see if we can write to the branch and it is not claimed out
  -- Although we create an atta and this is allowed because its a significant element
  -- we reorder the attas in the line and also create lugs so we need access to the branch

  !!mdsDacControl(TRUE)
  !saveElement = !!ce
  new olet
  handle NONE
    delete olet
  elsehandle (41,8)
  elsehandle ANY
    prompt on
    !!kRestoreUnits(!currentunits)
    !!mdsDacControl(FALSE)
    !!alert.error('$!!error.text')
    return error 1 '$!!error.text'
  endhandle
  !!ce = !saveElement
  !!mdsDacControl(FALSE)

  -- if the filter type is 1 2 and 7 and we are FANP and LISEGA then block the vertical pipes

  if  (!!mdsHangIf.upcase().eq('LISEGA')) then
    !tempDesc = (desc of /MDS/TEMPLATES )
    if !tempDesc.upcase().eq('FRAMATOME TEMPLATES') then
      if !!mdsfhanger.oRadio.activeindex.eq(1) or !!mdsfhanger.oRadio.activeindex.eq(2) or !!mdsfhanger.oRadio.activeindex.eq(18) then
        --if !!mdsfhanger.oRadio.activeindex.eq(1) or !!mdsfhanger.oRadio.activeindex.eq(18) then
        --if !!mdsfhanger.oRadio.activeindex.eq(18) then
        !ldir = !!ce.ldir
        handle ANY
          !ldir = !!ce.hdir
        endhandle
        if !ldir.up.eq(1) or !ldir.up.eq(-1) then
          !!alert.error('Cannot identify a vertical pipe in this configuration')
          return error 1 'Cannot identify a vertical pipe in this configuration'
        endif
      endif
    endif
  elseif  (!!mdsHangIf.upcase().eq('PSL')) then
    !tempDesc = (desc of /MDS/TEMPLATES )
    if !tempDesc.upcase().eq('FRAMATOME TEMPLATES') then
      if !!mdsfhanger.oRadio.activeindex.eq(1) or !!mdsfhanger.oRadio.activeindex.eq(2) or !!mdsfhanger.oRadio.activeindex.eq(18) then
        !ldir = !!ce.ldir
        handle ANY
          !ldir = !!ce.hdir
        endhandle
        if !ldir.up.eq(1) or !ldir.up.eq(-1) then
          !!alert.error('Cannot identify a vertical pipe in this configuration')
          return error 1 'Cannot identify a vertical pipe in this configuration'
        endif
      endif
    endif
  elseif  (!!mdsHangIf.upcase().eq('CPL')) then
    !tempDesc = (desc of /MDS/TEMPLATES )
    if !tempDesc.upcase().eq('FRAMATOME TEMPLATES') then
      if !!mdsfhanger.oRadio.activeindex.eq(1) or !!mdsfhanger.oRadio.activeindex.eq(2) or !!mdsfhanger.oRadio.activeindex.eq(18) then
        !ldir = !!ce.ldir
        handle ANY
          !ldir = !!ce.hdir
        endhandle
        if !ldir.up.eq(1) or !ldir.up.eq(-1) then
          !!alert.error('Cannot identify a vertical pipe in this configuration')
          return error 1 'Cannot identify a vertical pipe in this configuration'
        endif
      endif
    endif
  endif

  !tubeRef = !!ce
  if(!tubeRef.owner.type.eq('BRAN') or !tubeRef.type.eq('BRAN')) then
  else
    -- this is not a pipe component
    -- re-identify
    golabel /IDTUBE
  endif

  if(defined(!!mdsdebug)) then
    !!mdsdebug.trace(2,'Selected ' + !tubeRef.type + ': ' + !tubeRef.name)
  endif

  -- If using the lisega interface then the minimum temperature is -20, check and about

  if  (!!mdsHangIf.upcase().eq('LISEGA')) then
    branch
    handle NONE
      !temp = !!ce.temp
      if !temp.lt(-20) then
        !!alert.error('Temperature of branch is less than the acceptable minimum of -20 for Licad')
        same
        golabel /IDTUBE
      endif
    elsehandle ANY
    endhandle
  elseif  (!!mdsHangIf.upcase().eq('PSL')) then
    branch
    handle NONE
      !temp = !!ce.temp
      if !temp.lt(-20) then
        !!alert.error('Temperature of branch is less than the acceptable minimum of -20 for PSL')
        same
        golabel /IDTUBE
      endif
    elsehandle ANY
    endhandle
  elseif  (!!mdsHangIf.upcase().eq('CPL')) then
    branch
    handle NONE
      !temp = !!ce.temp
--<wd>10mar2010 - DFN P-28559 (SI-21112) FIX for the MDS WitchHanger CPL reported TEMPERATURE problem
--      if !temp.lt(-20) then
      if !temp.lt(-196) then
--        !!alert.error('Temperature of branch is less than the acceptable minimum of -20 for C&P')
        !!alert.error('Temperature of branch is less than the acceptable minimum of -196 for C&P')
--<wd>10mar2010 - DFN P-28559 (SI-21112) FIX for the MDS WitchHanger CPL reported TEMPERATURE problem
        same
        golabel /IDTUBE
      endif
    elsehandle ANY
    endhandle
  endif

  if(!!ce.type.eq('BRAN')) then
    var !boreS ph bore
  else
    var !boreS pl bore
  endif
  !bore = !boreS.real()
  -- Save backup list gadget
  !this.setFilterByBore(!form, !bore, !refresh)

  var !insus insu
  if(!insus.real() gt 0) then
    -- pipe is insulated
    -- filter hangertypes to get only types that are allowed for insulated pipe
    -- and also general hangers
    !insuFilter = 'INSU_NA INSU'
    !this.setFilterByInsu(!form, !insuFilter, FALSE )
  else
    -- pipe is not insulated
    -- filter hangertypes to get only types that are allowed for non insulated hangers
    -- and also general hangers
    !insuFilter = 'INSU_NA NOINSU'
    !this.setFilterByInsu(!form, !insuFilter, FALSE )
  endif

  -->>-<wd>20may2003
  !bbore = !bore.bore()
  --  !form.filterData.val = !form.filterData.val + 'Bore: ' + !bore.string(!!borefmt)
  !form.filterData.val = !form.filterData.val + 'Bore: ' + !bbore.string(!!borefmt)
  --<<-<wd>20may2003
  !form.filterData.val = !form.filterData.val + ' Insulation: ' + !insus.real().string(!!distancefmt)
  !this.tubeRef = !tubeRef

  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsdebug)) then
    !!mdsdebug.trace(2,'Selected tube: ' + '$!this.tubeRef.name')
    !!mdsdebug.traceOut(1,'$!this.setFilterByPipe($!form is FORM, $!refresh is BOOLEAN)')
  endif

endmethod

define method .setFilterByBeam(!form is FORM, !group is REAL, !refresh is BOOLEAN)

  -- Filters by beam type and state of pipe insulation (insulated/not insulated)
  -- !refresh - If TRUE, filter will be activated on the complete hanger list
  --            if FALSE, filter will be activated on the current form list
  if(defined(!!mdsdebug)) then
    !!mdsdebug.traceIn(1,'$!this.setFilterByBeam($!form is FORM, $!group is REAL, $!refresh is BOOLEAN)')
  endif
  !currentunits = !!kgetsetunits()
  mm bore mm dist

  label /RESTART

  !beamType = ''
  !beamRef = ARRAY()
  if (!group eq 18 or !group eq 19 or !group eq 20 or !group eq 25) then
    !prompt = 'Identify civils to connect hanger to'
  else
    !prompt = 'Identify steelwork to connect hanger to'
  endif

  !hangType = !form.standard.rtext[!form.standard.val]
  handle ANY
  endhandle

  if ( defined(!!manif.exe)) then
    if (!!manif.exe.exists()) then
      if  (!!mdsHangIf.eq('LISEGA')) then
        !hangType = 'MH01'
        !!lisgroup = !group
      elseif  (!!mdsHangIf.eq('PSL')) then
        !hangType = 'MH01'
        !!lisgroup = !group
      elseif  (!!mdsHangIf.eq('CPL')) then
        !hangType = 'MH01'
        !!lisgroup = !group
      endif
    endif
  endif


  !subGroup = !group

  if(!group gt 10) then
    !subGroup = !group.string().substring(2,1).real()
  endif

  if(!subGroup eq !this.doubleChannelGroupNo or !group eq !this.doubleHangerGroupNoDoubleChannel or !group eq !this.doubleHangerGroupNoCombined) then
    !prompt = 'Identify first steelwork section beam to connect hanger to'
    if(!form.beamRef.set() and !form.beamRef.size() neq 2) then
      -- Current beamRef array should contain references to two beam for this
      -- group. Otherwise reset the reference
      !form.beamRef = ARRAY()
    endif
  endif

  !numOfBeams = 0

  label /NEXTBEAM

  !numOfBeams = !numOfBeams + 1
  if(!form.beamRef.set()) then
    !!ce = !form.beamRef[!numOfBeams]
    handle ANY
      prompt off
      prompt load escape '$!prompt'
      --<wd>dec2007<mds12> -- Defect No. P-120 and P-4407 -- AVEVA MARINE HULL element types HPLATE and HSTIFF added to the ID list
      --      ID BOX SCTN FLOOR WALL GWALL STWALL SCREED CSCREED CWALL PANE CFLOOR @
      ID BOX SCTN FLOOR WALL GWALL STWALL SCREED CSCREED CWALL PANE CFLOOR HPLATE HSTIFF @
      --<wd>dec2007<mds12> -- Defect No. P-120 and P-4407 -- AVEVA MARINE HULL element types HPLATE and HSTIFF added to the ID list
      handle ANY
        prompt on
        !!kRestoreUnits(!currentunits)
        return error 1 '$!!error.text'
      endhandle
    endhandle
  else
    if defined(!!licadautotestenabled) then
      !!ce = !!licadautotest.steel
    else
      prompt off
      prompt load escape '$!prompt'
      --<wd>dec2007<mds12> -- Defect No. P-120 and P-4407 -- AVEVA MARINE HULL element types HPLATE and HSTIFF added to the ID list
      --    ID BOX SCTN FLOOR WALL GWALL STWALL SCREED CSCREED CWALL PANE CFLOOR @
      ID BOX SCTN FLOOR WALL GWALL STWALL SCREED CSCREED CWALL PANE CFLOOR HPLATE HSTIFF @
      --<wd>dec2007<mds12> -- Defect No. P-120 and P-4407 -- AVEVA MARINE HULL element types HPLATE and HSTIFF added to the ID list
      handle ANY
        prompt on
        !!kRestoreUnits(!currentunits)
        return error 1 '$!!error.text'
      endhandle
    endif
  endif

  !steelRef = !!ce

  --  !type = !steelRef.catref.owner.owner.purpose

  !type = !steelRef.gtype
  handle ANY
  endhandle

  if (!!ce.hardtype eq 'PANE') then
    !type = 'PANE'
  endif

  if(!type.eq(''))then
    !type = 'BEAM'
  endif
  !beamType = !beamType + !type
  !beamRef[!numOfBeams] = !steelRef

  if((!subGroup eq !this.doubleChannelGroupNo or $
    !group eq !this.doubleHangerGroupNoDoubleChannel or $
    !group eq !this.doubleHangerGroupNoCombined)) then
    if(!numOfBeams eq 1) then
      !beamType = !beamType + '-'
      !prompt = 'Identify second steelwork section beam to connect hanger to'
      golabel /NEXTBEAM
    endif
  else
    -- Append an unset ref if this is not a double channel beam
    !steelNoRef = object DBREF()
    !beamRef[!numOfBeams + 1] = !steelNoRef
  endif

  if(!beamType inset$!this.groupBeamTypes[$!group]) then
    if !beamType inset ('WALL') then
      -- wall must be stwall
      !this.stwallconn = TRUE
    else
      !this.stwallconn = FALSE
    endif
    -- beam type is suitable for double channel
  else
    !!alert.message('Beam of type $!beamType is not suitable for this type of hanger')
    !form.beamRef[!numOfBeams] = object DBREF()
    golabel /RESTART

  endif
  !this.setFilterByBeamType(!form, !beamType, !refresh)
  handle ANY
    --$P Error with group type numbers
  endhandle

  -- Update the container beam references
  !this.beamRef = !beamRef

  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsdebug)) then
    !!mdsdebug.traceOut(1,'$!this.setFilterByBeam($!form is FORM, $!group is REAL, $!refresh is BOOLEAN)')
  endif
endmethod

define method .setFilterByInsu(!form is FORM, !insuFilter is STRING, !fullList is BOOLEAN)
  -- filter the list with only hanger types that confirm to the insulation filter
  -- Insulation filter can be:
  --   'INSU_NA'       - Hanger type is used for all pipes (with insualtion or without insualtion)
  --   'INSU'   - Hanger type is used ONLY for pipe WITH insulation
  --   'NOINSU' - Hanger type is used ONLY for pipe WITHOUT insulation
  --   'INSU_NA INSU' - Sum of Hangers types that are used ONLY for pipes WITH
  --                        insulation and hangers that are suitable for all pipes (with/without insu)
  --   'INSU_NA NOINSU' - Sum of Hangers types that are used ONLY for pipes WITHOUT
  --                        insulation and hangers that are suitable for all pipes (with/without insu)
  if(defined(!!mdsdebug)) then
    !!mdsdebug.traceIn(1,'$!this.setFilterByInsu($!form is FORM, $!insuFilter is STRING, $!fullList is BOOLEAN)')
  endif
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !insuFilterArray = !insuFilter.split()
  -- create an empty Mdshangertypes component
  !form.filteredHangerTypes = object MDSHANGERTYPES(FALSE)
  do !i indices !insuFilterArray
    !form.filteredHangerTypes.add(!form.formHangerTypes.getHangersForInsu(!insuFilterArray[!i]))
  enddo
  if(!fullList) then
    -- Filter will be done on complete list of available hanger types
    !dtext = !form.standardDtexBackup
    !rtext = !form.standardRtexBackup
  else
    -- Filter will be done on current, already filtered list of hanger type
    !dtext = !form.standard.dtext
    !rtext = !form.standard.rtext
  endif
  !newDtex = ARRAY()
  !newRtex = ARRAY()
  !i = 0
  do !oHangTypeName values !form.filteredHangerTypes.names
    !indexArray = !rtext.find(!oHangTypeName)
    do !index values !indexArray
      if(!index.unset())then
        skip
      endif
      !i = !i + 1
      !newDtex[!i] = !dtext[!index]
      !newRtex[!i] = !rtext[!index]
    enddo
  enddo
  !form.standard.dtext = !newDtex
  !form.standard.rtext = !newRtex
  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsdebug)) then
    !!mdsdebug.traceOut(1,'$!this.setFilterByInsu($!form is FORM, $!insuFilter is STRING, $!fullList is BOOLEAN)')
  endif
endmethod

define method .setFilterByBore(!form is FORM, !bore is REAL, !fullList is BOOLEAN)
  if(defined(!!mdsdebug)) then
    !!mdsdebug.traceIn(1,'$!this.setFilterByBore($!form is FORM, $!bore is REAL, $!fullList is BOOLEAN)')
  endif
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !form.filteredHangerTypes = !form.formHangerTypes.getHangersForBore(!bore)
  if(!fullList) then
    -- Filter will be done on complete list of available hanger types
    !dtext = !form.standardDtexBackup
    !rtext = !form.standardRtexBackup
  else
    -- Filter will be done on current, already filtered list of hanger type
    !dtext = !form.standard.dtext
    !rtext = !form.standard.rtext
  endif
  !newDtex = ARRAY()
  !newRtex = ARRAY()
  !i = 0
  do !oHangTypeName values !form.filteredHangerTypes.names
$(
!index = !rtext.findFirst(!oHangTypeName)
if(!index.unset())then
skip
endif
!i = !i + 1
!newDtex[!i] = !dtext[!index]
!newRtex[!i] = !rtext[!index]
$)
    !indexArray = !rtext.find(!oHangTypeName)
    do !index values !indexArray
      if(!index.unset())then
        skip
      endif
      !i = !i + 1
      !newDtex[!i] = !dtext[!index]
      !newRtex[!i] = !rtext[!index]
    enddo
  enddo
  !form.standard.dtext = !newDtex
  !form.standard.rtext = !newRtex
  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsdebug)) then
    !!mdsdebug.trace(2, 'Size of MDSHANGERYPES container is: ' + !newDtex.size().string())
    !!mdsdebug.traceOut(1,'$!this.setFilterByBore($!form is FORM, $!bore is REAL, $!fullList is BOOLEAN)')
  endif
endmethod

define method .setFilterByGroup(!form is FORM, !group is REAL, !fullList is BOOLEAN)

  -- Group is defined for the filtering of hanger. Each filter button define a group
  if(defined(!!mdsdebug)) then
    !!mdsdebug.traceIn(1,'$!this.setFilterByGroup($!form is FORM, $!group is REAL, $!fullList is BOOLEAN)')
  endif
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  -- !this.loadConfigurations()
  !form.filteredHangerTypes = !form.formHangerTypes.getHangersForGroup(!group)
  if(defined(!!mdsdebug)) then
    !size = !form.filteredHangerTypes.size()
    !!mdsdebug.trace(2,'Size of filteredHangerTypes is: $!size')
    !size = !form.standardDtexBackup.size()
    !!mdsdebug.trace(2,'Size of standardDtexBackup is: $!size')
  endif
  if(!fullList) then
    -- Filter will be done on complete list of available hanger types
    !dtext = !form.standardDtexBackup
    !rtext = !form.standardRtexBackup
  else
    -- Filter will be done on currnt, already filtered list of hanger type
    !dtext = !form.standard.dtext
    !rtext = !form.standard.rtext
  endif
  !newDtex = ARRAY()
  !newRtex = ARRAY()
  !i = 0
  do !oHangTypeName values !form.filteredHangerTypes.names
$(
!index = !rtext.findFirst(!oHangTypeName)
if(!index.unset())then
skip
endif
!i = !i + 1
!newDtex[!i] = !dtext[!index]
!newRtex[!i] = !rtext[!index]
$)
    -- We are looking for all the description lines
    -- which have the same name. This can happen when
    -- one configuration template is used for different connections
    -- e.g B7 & B9 use the same templates
    !indexArray = !rtext.find(!oHangTypeName)
    do !index values !indexArray
      if(!index.unset())then
        skip
      endif
      !i = !i + 1
      !newDtex[!i] = !dtext[!index]
      !newRtex[!i] = !rtext[!index]
    enddo
  enddo
  !form.standard.dtext = !newDtex
  !form.standard.rtext = !newRtex
  --  !form.filterData.val = !form.filterData.val + ' Group: $!group'
  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsdebug)) then
    !size = !newDtex.size()
    !!mdsdebug.trace(2,'Size of Dtex is: $!size')
    !!mdsdebug.traceOut(1,'$!this.setFilterByGroup($!form is FORM, $!group is REAL, $!fullList is BOOLEAN)')
  endif
endmethod

define method .setFilterByBeamType(!form is FORM, !beamType is STRING, !fullList is BOOLEAN)
  -- get an hangertypes container with all the hanger type that can be used
  -- with the given beam type
  if(defined(!!mdsdebug)) then
    !!mdsdebug.traceIn(1,'$!this.setFilterByBeamType($!form is FORM, $!beamType is STRING, $!fullList is BOOLEAN)')
  endif
  !currentunits = !!kgetsetunits()
  mm bore mm dist


  !form.filteredHangerTypes = !form.formHangerTypes.getHangersForBeamType(!beamType)

  if(!fullList) then
    -- Filter will be done on complete list of available hanger types
    !dtext = !form.standardDtexBackup
    !rtext = !form.standardRtexBackup
  else
    -- Filter will be done on currnt, already filtered list of hanger type
    !dtext = !form.standard.dtext
    !rtext = !form.standard.rtext
  endif
  !newDtex = ARRAY()
  !newRtex = ARRAY()
  !i = 0

  do !oHangTypeName values !form.filteredHangerTypes.names
$(
!index = !rtext.findFirst(!oHangTypeName)
if(!index.unset())then
skip
endif
!i = !i + 1
!newDtex[!i] = !dtext[!index]
!newRtex[!i] = !rtext[!index]
$)
    !indexArray = !rtext.find(!oHangTypeName)

    do !index values !indexArray
      if(!index.unset())then
        skip
      endif
      !i = !i + 1
      !newDtex[!i] = !dtext[!index]
      !newRtex[!i] = !rtext[!index]
    enddo
  enddo
  !form.standard.dtext = !newDtex
  !form.standard.rtext = !newRtex
  !form.filterData.val = !form.filterData.val + | Beam: $!beamType|
  !!kRestoreUnits(!currentunits)
  if(defined(!!mdsdebug)) then
    !!mdsdebug.traceOut(1,'$!this.setFilterByBeamType($!form is FORM, $!beamType is STRING, $!fullList is BOOLEAN)')
  endif
endmethod

define method .add(!hangerTypes is MDSHANGERTYPES)
  -- Append !hangerTypes container object to this Mdshangertypes container object
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !this.objects.appendArray(!hangerTypes.objects)
  !this.names.appendArray(!hangerTypes.names)
  !this.categories.appendArray(!hangerTypes.categories)
  !!kRestoreUnits(!currentunits)
endmethod

define method .size() is REAL
  return !this.objects.size()
endmethod

define method .loadConfigurations()

  --------------------
  --<wd>may2006<mds12>
  -- Commented Out the call to the METHOD "!this.inithangerconfiguration()"as it is NOT REQUIRED.
  -- The OBJECT types of ALL the OBJECT MEMBERS are always DECLARED in the OBJECT DEFINITION.
  -- I don't understand why the METHOD "!this.inithangerconfiguration()" exists???
  --
  --  !this.inithangerconfiguration()
  --
  --<wd>may2006<mds12>
  --------------------

  --var !projcode proj code
  --var !dfltsdir evar '$!projcode$ndflts'

  ---------------------------------------------------------------------------------------------------
  --------------------
  --<wd>may2006<mds12> - OBSOLETE MDS11.6 Defaults File "DES-SUPP-HANG" Loading>>>
  ---------------------------------------------------------------------
  --  -- !!mdsfiles.hangersconfigurations.File('$!dfltsdir/DES-SUPP-HANG')
  --  !ohangconffile = object FILE('$!!mdsfiles.hangersconfigurations')
  --  !lines = !ohangconffile.readfile()
  --
  ---- sets configurations
  --  do !i indices !lines
  --    !line = !lines[!i].upcase().trim()
  --    if(!line.substring(1,2).eq('FH') or !line.substring(1,2).eq('VH')) then
  --      handle any
  --        skip
  --      endhandle
  --      !this.loadHangerConfiguration(!line)
  --
  --    elseif(!line.substring(1,1).eq('B') and !line.substring(2,1).real() ge 0) then
  --      handle any
  --        skip
  --      endhandle
  --      !this.loadBottomAssociatedStandardSupports(!line)
  --
  --    elseif(!line.substring(1,5).eq('ALIAS')) then
  --      handle any
  --        skip
  --      endhandle
  --      !this.loadTemplateName(!line)
  --
  --    elseif(!line.substring(1,3).eq('ROD')) then
  --      handle any
  --        skip
  --      endhandle
  --      !this.loadStdRodSizes(!line)
  --
  --    endif
  --  enddo
  --
  --<wd>may2006<mds12> - OBSOLETE MDS11.6 Defaults File "DES-SUPP-HANG" Loading<<<
  --------------------
  ---------------------------------------------------------------------------------------------------
  --
  --*************************************************************************************************
  --
  ---------------------------------------------------------------------------------------------------
  --------------------
  --<wd>may2006<mds12> - NEW MDS12 Loading of MDS HANGER Defaults etc. from the MDS Defaults PARAGON Database>>>
  --
  -- ***MDS12*** does NOT use the MDS defaults file object "!!mdsfiles" for the LOADING of the MDS HANGER TEMPLATES,
  -- i.e. "!!mdsfiles.hangersconfigurations" which is the MDS "DES-SUPP-HANG" DEFAULTS File for the MDS HANGER Configurations.
  -- At ***MDS12*** the MDS HANGER Configurations are held in the MDS PARAGON DATABASE
  -- in the MDS HANGER DEFAULTS CATA element "/MDS/HANGER/DEFAULTS".
  -- Each MDS HANGER Configuration type is stored in a DATA element - at the Attribute "Pproperty",
  -- e.g. DATA /MDS/HANGER/DEFAULTS/****/CONFIG/DATA --> Attribute Pproperty = ( ' T1 , M1 , B1 ' )
  --      where "****" represents the MDS HANGER Type, e.g "FH01", "VH01" etc...
  --
  ---------------------------------------------------------------------------------------------------
  --<wd>jan2007<mds12> -- *** The Global Variables !!CODE.... and !!DESC... are NOT LOADED any more for the MDS12 DEVELOPMENT ***

  -- Determine the VALID MDS HANGER TYPES that are "ACTIVE" in the CURRENT PDMS PROJECT
  -- These are STORED in a GLOBAL VARIABLE PML OBJECT populated during the INITIAL/ENTRY
  -- loading of the  MDS DESIGN APPLICATION.
  -- i.e. !!mdsdescdefs = object mdsdescriptions()
  -- CLIENT DESCRIPTIONS are stored as an ARRAY of STRINGS in the PML object member !!mdsdescdefs.descgvararr
  -- e.g.'!!descfh01', '!!descvh01' etc...
  -- CLIENT CODES are stored as an ARRAY of STRING in the PML object member !!mdsdescdefs.ccodgvararr,
  -- e.g.'!!codefh01','!!codevh01'  etc...
  --
  ---------------------------------------------------------------------------------------------------

  --<wd>jan2007<mds12>----------------------------------------------------------------------
  --<wd>jan2007<mds12>-- <1> - Determine the VALID/ACTIVE "FH" and "VH" MDS HANGER TYPES
  --<wd>jan2007<mds12>-- in the current PDMS PROJECT global OBJECT !!mdsdescdefs
  --<wd>jan2007<mds12>----------------------------------------------------------------------
  --<wd>jan2007<mds12>  !mdsFixHang = ARRAY()
  --<wd>jan2007<mds12>  !mdsVarHang = ARRAY()
  --<wd>jan2007<mds12>  do !valu values !!mdsdescdefs.ccodgvararr
  --<wd>jan2007<mds12>    if (!valu.upcase().matchwild('!!CODEFH*')) then
  --<wd>jan2007<mds12>-- FIXED MDS HANGER Type
  --<wd>jan2007<mds12>      !mdsFixHang.append(!valu.upcase().after('!!CODE'))
  --<wd>jan2007<mds12>
  --<wd>jan2007<mds12>    elseif (!valu.upcase().matchwild('!!CODEVH*')) then
  --<wd>jan2007<mds12>--VARIABLE<SPRING> MDS HANGER Type
  --<wd>jan2007<mds12>      !mdsVarHang.append(!valu.upcase().after('!!CODE'))
  --<wd>jan2007<mds12>
  --<wd>jan2007<mds12>    else
  --<wd>jan2007<mds12>-- NOT a MDS HANGER Type
  --<wd>jan2007<mds12>      skip
  --<wd>jan2007<mds12>
  --<wd>jan2007<mds12>    endif
  --<wd>jan2007<mds12>  enddo

  ---------------------------------------------------------------------------------------------------
  --<wd>jan2007<mds12>

  ----------------------------------------------------------------------
  -- <1> - Determine the VALID/ACTIVE "FH" and "VH" MDS HANGER TYPES
  -- in the current PDMS PROJECT MDS HANGER DEFAULTS CATALOGUE
  ----------------------------------------------------------------------
  --
  -- Initialise the MDS HANGER TYPE Object and Variables
  !mdsTypHang = object MDSHANGTYPE()
  if (!mdsTypHang.hangcodecheck) then
    !mdsDataHang = !mdsTypHang.hangCodeArray
    !mdsFixHang  = ARRAY()
    !mdsVarHang  = ARRAY()
    do !datx indices !mdsDataHang

      if (!mdsDataHang[!datx].pprop.upcase().match('FH').gt(0)) then
        -- FIXED MDS HANGER Type
        !mdshangtype = !mdsDataHang[!datx].pprop.upcase()
        -- Need to EXPAND the variable, e.g. from !mdshangtype = '('FH01')' to !mdshangtype = 'FH01'
        !mdshangtype = $!mdshangtype
        !mdsFixHang.append(!mdshangtype)

      elseif (!mdsDataHang[!datx].pprop.upcase().match('VH').gt(0)) then
        --VARIABLE<SPRING> MDS HANGER Type
        !mdshangtype = !mdsDataHang[!datx].pprop.upcase()
        -- Need to EXPAND the variable, e.g. from !mdshangtype = '('VH01')' to !mdshangtype = 'VH01'
        !mdshangtype = $!mdshangtype
        !mdsVarHang.append(!mdshangtype)

      else
        -- NOT a VALID MDS HANGER Type
        skip

      endif

    enddo

  else
    -- ERROR code to be handled in here!!!!!!!!

  endif
  --<wd>jan2007<mds12>
  ---------------------------------------------------------------------------------------------------

  -------------------------------------------------------------------------------
  -- Determine the MDS HANGER Configuration for each VALID/ACTIVE "FH" and "VH"
  -- MDS HANGER TYPE in the current PDMS PROJECT
  -------------------------------------------------------------------------------
  -- FIXED MDS HANGER Types -- with a "FH" prefix
  !mdsfixhcfg = ARRAY()
  do !indx indices !mdsFixHang
    !mdshtyp = !mdsFixHang[!indx]
    -- Check DATA element exists for the MDS HANGER Type and EXTRACT the MDS HANGER Configuration
    !mdshcfg = /MDS/HANGER/DEFAULTS/$!<mdshtyp>/CONFIG/DATA
    handle NONE
      -- MDS HANGER Configuration DATA element exists
      -- REMOVE the PPROP initial ' and ( ) characters, e.g. '('T1 M1 B1')' to 'T1 M1 B1'
      -- Therefore expand the value by using the "$" character, e.g. !hcfg = $!mdshcfg.pproperty
      if (!mdshcfg.dkey.eq('HCFG')) then
        !hcfg = $!mdshcfg.pproperty
        !mdsfixhcfg.append(!mdsFixHang[!indx] & ' \ ' & !hcfg )
      else
        -- DATA element "DKEY is NOT correct for a MDS HANGER Configuration
        skip
      endif

    elsehandle ANY
      -- MDS HANGER Configuration DATA element does NOT exist
      skip
    endhandle

  enddo

  -- VARIABLE<SPRING> MDS HANGER Types -- with a "VH" prefix
  !mdsvarhcfg = ARRAY()
  do !indv indices !mdsVarHang
    !mdshtyp = !mdsVarHang[!indv]
    -- Check DATA element exists for the MDS HANGER Type and EXTRACT the MDS HANGER Configuration
    !mdshcfg = /MDS/HANGER/DEFAULTS/$!<mdshtyp>/CONFIG/DATA
    handle NONE
      -- MDS HANGER Configuration DATA element exists
      -- REMOVE the PPROP initial ' and ( ) characters, e.g. '('T1 M1 B1')' to 'T1 M1 B1'
      -- Therefore expand the value by using the "$" character, e.g. !hcfg = $!mdshcfg.pproperty
      if (!mdshcfg.dkey.eq('HCFG')) then
        !hcfg = $!mdshcfg.pproperty
        !mdsvarhcfg.append(!mdsVarHang[!indv] & ' \ ' & !hcfg )
      else
        -- DATA element "DKEY is NOT correct for a MDS HANGER Configuration
        skip
      endif

    elsehandle ANY
      -- MDS HANGER Configuration DATA element does NOT exist
      skip

    endhandle
  enddo

  -- Join the TWO arrays, !mdsfixhcfg and !mdsvarhcfg
  !mdshcfgs = ARRAY()
  !mdshcfgs.appendArray(!mdsfixhcfg)
  !mdshcfgs.appendArray(!mdsvarhcfg)

  -- PROCESS ALL of the MDS HANGER Configurations using the METHOD and ARGUMENT used at MDS11.6,
  -- i.e. !this.loadHangerConfiguration(!line), for determining the MDS HANGER OBJECT type
  do !cfg indices !mdshcfgs
    !line = !mdshcfgs[!cfg].upcase().trim()
    !this.loadHangerConfiguration(!line)
  enddo

  ----------------------------------------------------------------------
  -- <2> - Determine the MDS HANGER BOTTOM ASSOCIATED STANDARD SUPPORTS.
  ----------------------------------------------------------------------
  -- ONLY PROCESS each of the VALID PARAGON DATA elements found to DETERMINE
  -- the BOTTOM ASSOCIATED STANDARD Support types for MDS HANGERS
  -- i.e. in the SECTION element /MDS/HANGER/DEFAULTS/BOTTOM-ASSOC-STD
  --
  !mdssection = /MDS/HANGER/DEFAULTS/BOTTOM-ASSOC-STD
  handle NONE
    -- SECTION element EXISTS
    if (!mdssection.:mdsactive) then
      -- SECTION element is "ACTIVE" -- :mdsactive = TRUE --/MDS/HANGER/DEFAULTS/BOTTOM-ASSOC-STD
      -- Initialise the Collection Object data for the "ACTIVE" CATEGORY elements
      -- from the PARAGON SECTION element /MDS/HANGER/DEFAULTS/BOTTOM-ASSOC-STD
      -- in the current PDMS Project
      !type  = |CATE|
      !filt  = object EXPRESSION(':mdsactive eq TRUE')
      !scope = ARRAY()
      !scope.append(!mdssection)

      -- Collect ALL of the DESPARS DATA Elements
      !cate  = object COLLECTION()
      !cate.filter(!filt)
      !cate.scope(!scope)
      !cate.type(!type)

      -- CATEGORY Collection Results Array
      !results = !cate.results()
      if (!results.size().gt(0)) then
        -- Process the MDS HANGER BOTTOM ASSOCIATED STANDARDS DATA elements in the !results Array
        -- Initialise the Collection Object data
        !type = |DATA|
        !filt = object EXPRESSION('DKEY eq |ASTD| and func of owner eq |ASSOC-STD|')
        !bass = ARRAY()
        !bass.appendArray(!results)

        -- Collect ALL of the MDS HANGER BOTTOM ASSOCIATED STANDARDS DATA elements
        !data  = object COLLECTION()
        !data.filter(!filt)
        !data.scope(!bass)
        !data.type(!type)

        -- DATA Collection Results Array
        !bassresults = !data.results()
        -- Determine the MDS HANGER BOTTOM ASSOCIATED STANDARDS
        do !inda indices !bassresults
          !mdsbstd = !bassresults[!inda].owner.description.upcase().trim()
          !mdsbass = $!bassresults[$!inda].pproperty
          !line    = !mdsbstd & ' \ ' & !mdsbass
          !this.loadBottomAssociatedStandardSupports(!line)
        enddo
      endif

    else
      -- SECTION element :mdsactive = FALSE --/MDS/HANGER/DEFAULTS/BOTTOM-ASSOC-STD
      -- NO ERROR Message REQUIRED
    endif
  elsehandle ANY
    -- SECTION element does NOT EXIST -- /MDS/HANGER/DEFAULTS/BOTTOM-ASSOC-STD
    -- NO ERROR Message REQUIRED
  endhandle

  ----------------------------------------------------------------------
  -- <3> - Determine the MDS HANGER SUPPORT - "ALIASES".
  ----------------------------------------------------------------------
  --
  -- ONLY PROCESS each of the VALID PARAGON DATA elements found to DETERMINE
  -- the ALIAS Support types for MDS HANGERS
  -- i.e. in the SECTION element /MDS/HANGER/DEFAULTS/ALIAS
  --
  !mdssection = /MDS/HANGER/DEFAULTS/ALIAS
  handle NONE
    -- SECTION element EXISTS
    if (!mdssection.:mdsactive) then
      -- SECTION element is "ACTIVE" -- :mdsactive = TRUE --/MDS/HANGER/DEFAULTS/ALIAS
      -- Initialise the Collection Object data for the "ACTIVE" CATEGORY elements
      -- from the PARAGON SECTION element /MDS/HANGER/DEFAULTS/ALIAS
      -- in the current PDMS Project
      !type  = |CATE|
      !filt  = object EXPRESSION(':mdsactive eq TRUE')
      !scope = ARRAY()
      !scope.append(!mdssection)

      -- Collect ALL of the DESPARS DATA Elements
      !cate  = object COLLECTION()
      !cate.filter(!filt)
      !cate.scope(!scope)
      !cate.type(!type)

      -- CATEGORY Collection Results Array
      !results = !cate.results()
      if (!results.size().gt(0)) then
        -- Process the MDS HANGER ALIAS DATA elements in the !results Array
        -- Initialise the Collection Object data
        !type  = |DATA|
        !filt  = object EXPRESSION('DKEY eq |HALS| and func of owner eq |ALIAS|')
        !alias = ARRAY()
        !alias.appendArray(!results)

        -- Collect ALL of the MDS HANGER ALIAS DATA elements
        !data  = object COLLECTION()
        !data.filter(!filt)
        !data.scope(!alias)
        !data.type(!type)

        -- DATA Collection Results Array
        !aliasresults = !data.results()

        -- Determine the MDS HANGER ALIAS STANDARDS
        do !indb indices !aliasresults
          !mdsastd  = $!aliasresults[$!indb].dproperty
          !mdsalias = $!aliasresults[$!indb].pproperty
          !line     = 'ALIAS \ ' & !mdsastd & ' \ ' & !mdsalias
          !this.loadTemplateName(!line)
        enddo
      endif

    else
      -- SECTION element :mdsactive = FALSE --/MDS/HANGER/DEFAULTS/ALIAS
      -- NO ERROR Message REQUIRED
    endif
  elsehandle ANY
    -- SECTION element does NOT EXIST -- /MDS/HANGER/DEFAULTS/ALIAS
    -- NO ERROR Message REQUIRED
  endhandle

  ----------------------------------------------------------------------
  -- <4> - Determine the MDS HANGER SUPPORTS - "ROD SIZES".
  ----------------------------------------------------------------------
  --
  -- ONLY PROCESS each of the VALID PARAGON DATA elements found to DETERMINE
  -- the ROD-SIZE for various NPS for MDS HANGERS
  -- i.e. in the SECTION element /MDS/HANGER/DEFAULTS/ROD-SIZE
  --
  !mdssection = /MDS/HANGER/DEFAULTS/ROD-SIZE
  handle NONE
    -- SECTION element EXISTS
    if (!mdssection.:mdsactive) then
      -- SECTION element is "ACTIVE" -- :mdsactive = TRUE --/MDS/HANGER/DEFAULTS/ROD-SIZE
      -- Initialise the Collection Object data for the "ACTIVE" CATEGORY elements
      -- from the PARAGON SECTION element /MDS/HANGER/DEFAULTS/ROD-SIZE
      -- in the current PDMS Project
      !type  = |CATE|
      !filt  = object EXPRESSION(':mdsactive eq TRUE')
      !scope = ARRAY()
      !scope.append(!mdssection)

      -- Collect ALL of the DESPARS DATA Elements
      !cate  = object COLLECTION()
      !cate.filter(!filt)
      !cate.scope(!scope)
      !cate.type(!type)

      -- CATEGORY Collection Results Array
      !results = !cate.results()
      if (!results.size().gt(0)) then
        -- Process the MDS HANGER ROD-SIZE DATA elements in the !results Array
        -- Initialise the Collection Object data
        !type  = |DATA|
        !filt  = object EXPRESSION('DKEY eq |RSIZ| and func of owner eq |MM-ROD-SIZES|')
        !alias = ARRAY()
        !alias.appendArray(!results)

        -- Collect ALL of the MDS HANGER ROD-SIZE DATA elements
        !data  = object COLLECTION()
        !data.filter(!filt)
        !data.scope(!alias)
        !data.type(!type)

        -- DATA Collection Results Array
        !rsizresults = !data.results()

        -- Determine the MDS HANGER ROD-SIZE STANDARDS
        do !indc indices !rsizresults
          !npssizes = !rsizresults[!indc].owner.description.trim().upcase()
          !mdsinnps = !npssizes.before(|"|)
          !mdsmmnps = !npssizes.after(|"|).after('-').before('MM')
          !mdsrsiz  = $!rsizresults[$!indc].pproperty
          !line     = 'ROD \ ' & !mdsinnps & ' \ ' & !mdsmmnps & ' \ ' & !mdsrsiz
          !this.loadStdRodSizes(!line)
        enddo
      endif

    else
      -- SECTION element :mdsactive = FALSE --/MDS/HANGER/DEFAULTS/ROD-SIZE
      -- NO ERROR Message REQUIRED
    endif
  elsehandle ANY
    -- SECTION element does NOT EXIST -- /MDS/HANGER/DEFAULTS/ROD-SIZE
    -- NO ERROR Message REQUIRED
  endhandle

  ----------------------------------------------------------------------
  --<wd>may2006<mds12> - NEW MDS12 Loading of MDS HANGER Defaults etc. from the MDS Defaults PARAGON Database<<<
  --------------------
  --*************************************************************************************************

  -- Ensure ALL the STRING() type OBJECT Members are CORRECTLY DEFINED
  !this.endHangerConfiguration()

endmethod

--*************************************************************************************************

define method .loadHangerConfiguration(!line is STRING)
  --------------------
  --<wd>jun2006<mds12>
  -- **********************
  -- *** IMPORTANT NOTE ***
  -- **********************
  -- This METHOD, .loadHangerConfiguration(!line is STRING), is ***UNCHANGED*** at MDS12
  -- The LOADING of the MDS HANGER TEMPLATE CONFIGURATIONS etc... from the MDS PARAGON DATABASE
  -- DEFAULTS CATA element "/MDS/HANGER/DEFAULTS" is STILL DONE in this METHOD.
  -- ALL of the necessary code CHANGES for MDS12 have been made in the METHOD .loadConfigurations() shown above.
  --<wd>jun2006<mds12>
  --------------------
  --*************************************************************************************************

  !data = !line.split(|\|)
  -- Configuration name (e.g. FH01)
  !name = !data[1].trim().upcase()

  -- Set prefix value for variable name.
  !fixedVariable = ''
  if(!name.match('FH') gt 0) then
    !fixedVariable = 'Fixed'
  elseif(!name.match('VH') gt 0) then
    !fixedVariable = 'Variable'
  endif

  -- Configuration Array (e.g. {'T1','M2','B3'})
  !confArray = !data[2].split(',')

  -- Top connection (e.g. 'T1')
  !top = !confArray[1].trim().upcase()

  -- Middle connection (e.g. 'M2')
  !middle = !confArray[2].trim().upcase()

  -- Bottom connection (e.g. 'B3')
  !bottom = !confArray[3].trim().upcase()

  -- Top connection handling
  if(!top.eq('T1')) then
    if(!this.clevisAndLug$!fixedVariable$n.unset())then
      --!this.clevisAndLug$!fixedVariable = |('$!name'|
      !this.clevisAndLug$!fixedVariable$N.append(!name)
    else
      --!this.clevisAndLug$!fixedVariable = !this.clevisAndLug$!fixedVariable + |,'$!name'|
      !this.clevisAndLug$!fixedVariable$n.append(!name)
    endif
  elseif(!top.eq('T3')) then
    if(!this.eyeRod$!fixedVariable$n.unset())then
      --!this.eyeRod$!fixedVariable = |('$!name'|
      !this.eyeRod$!fixedVariable$N.append(!name)
    else
      --!this.eyeRod$!fixedVariable = !this.eyeRod$!fixedVariable + |,'$!name'|
      !this.eyeRod$!fixedVariable$N.append(!name)
    endif
  elseif(!top.eq('T4')) then
    if(!this.doubleChannelRodConnection$!fixedVariable$n.unset())then
      --!this.doubleChannelRodConnection$!fixedVariable = |('$!name'|
      !this.doubleChannelRodConnection$!fixedVariable$n.append(!name)
    else
      --!this.doubleChannelRodConnection$!fixedVariable = !this.doubleChannelRodConnection$!fixedVariable + |,'$!name'|
      --!this.doubleChannelRodConnection$!fixedVariable$n.append(!name|
      !this.doubleChannelRodConnection$!fixedVariable$n.append(!name)
    endif
  elseif(!top.eq('T9')) then
    if(!this.tS2Spring.unset())then
      !this.tS2Spring = |('$!name'|
    else
      !this.tS2Spring = !this.tS2Spring + |,'$!name'|
    endif
  elseif(!top.eq('T10')) then
    --if(!this.tS3Spring.unset())then
    --  !this.tS3Spring = |('$!name'|
    --else
    --  !this.tS3Spring = !this.tS3Spring + |,'$!name'|
    --endif
    !this.tS3Spring.append('$!name')
  elseif(!top.eq('T13')) then
    if(!this.tASpring.unset())then
      !this.tASpring = |('$!name'|
    else
      !this.tASpring = !this.tASpring + |,'$!name'|
    endif
  elseif(!top.eq('T14')) then
    if(!this.eSSpring.unset())then
      !this.eSSpring = |('$!name'|
    else
      !this.eSSpring = !this.eSSpring + |,'$!name'|
    endif
  endif
  -- Middle connection handling
  if(!middle.eq('M1')) then
$(
if(!this.oneRod$!fixedVariable$n.unset())then
!this.oneRod$!fixedVariable = |('$!name'|
else
!this.oneRod$!fixedVariable = !this.oneRod$!fixedVariable + |,'$!name'|
endif
$)
    if(!this.oneRod$!fixedVariable$n.unset())then
      !this.oneRod$!fixedVariable$n.append(|('$!name'|)
    else
      !this.oneRod$!fixedVariable$n[!this.oneRod$!fixedVariable$n.size()] = !this.oneRod$!fixedVariable$n[!this.oneRod$!fixedVariable$n.size()] + |,'$!name'|
      handle ANY
        -- Text is too long
        !this.oneRod$!fixedVariable$n.append(|('$!name'|)
      endhandle
    endif
  elseif(!middle.eq('M3')) then
    --mod to an array string too big dtf 4.05.04
    --if(!this.tS1Spring.unset())then
    --  !this.tS1Spring = |('$!name'|
    --else
    --  !this.tS1Spring = !this.tS1Spring + |,'$!name'|
    --endif
    !this.tS1Spring.append('$!name')
  elseif(!middle.eq('M5')) then
    !this.m5Constant.append('$!name')

  elseif(!middle.eq('') and (not !top.eq(''))) then
    -- Hanger has a top connection but does not have a middle connection
    -- this type of hanger has a fixed height that can't be adjusted
$(
if(!this.noRods.unset())then
!this.noRods = |('$!name'|
else
!this.noRods = !this.noRods + |,'$!name'|
endif
$)
    !this.noRods.append(!name)
  endif
  -- Bottom connection handling
  if(!bottom inset('B1','B2','B5','B6')) then
    if(!this.pipeClamp.unset())then
      !this.pipeClamp.append(|('$!name'|)
    else
      !this.pipeClamp[!this.pipeClamp.size()] = !this.pipeClamp[!this.pipeClamp.size()] + |,'$!name'|
      handle ANY
        -- Text is too long
        !this.pipeClamp.append(|('$!name'|)
      endhandle
    endif
  elseif(!bottom.eq('B7') or !bottom.eq('B9')) then
    if(!this.weldedElbowOrPipeLug.unset())then
      !this.weldedElbowOrPipeLug = |('$!name'|
    else
      !this.weldedElbowOrPipeLug = !this.weldedElbowOrPipeLug + |,'$!name'|
    endif
  elseif(!bottom.eq('B8')) then
    if(!this.weldedElbowtrunion.unset())then
      !this.weldedElbowtrunion = |('$!name'|
    else
      !this.weldedElbowtrunion = !this.weldedElbowtrunion + |,'$!name'|
    endif
  elseif(!bottom.eq('B10')) then
    -- if(!this.riserClamp.unset())then
    --!this.riserClamp = |('$!name'|
    --else
    --!this.riserClamp = !this.riserClamp + |,'$!name'|
    --endif
    !this.riserClamp.append(!name)
  elseif(!bottom.eq('B11')) then
    if(!this.channelAssembly.unset())then
      !this.channelAssembly = |('$!name'|
    else
      !this.channelAssembly = !this.channelAssembly + |,'$!name'|
    endif
  elseif(!bottom.eq('B13')) then
    if(!this.dSSpring.unset())then
      !this.dSSpring = |('$!name'|
    else
      !this.dSSpring = !this.dSSpring + |,'$!name'|
    endif
  elseif(!bottom.eq('B14')) then
    if(!this.dSSpring.unset())then
      !this.dSSpring = |('$!name'|
    else
      !this.dSSpring = !this.dSSpring + |,'$!name'|
    endif
    if(!this.dSSpringWithShoe.unset())then
      !this.dSSpringWithShoe = |('$!name'|
    else
      !this.dSSpringWithShoe = !this.dSSpringWithShoe + |,'$!name'|
    endif
  elseif(!bottom.eq('B15')) then
    if(!this.bM1Spring.unset())then
      !this.bM1Spring = |('$!name'|
    else
      !this.bM1Spring = !this.bM1Spring + |,'$!name'|
    endif
  elseif(!bottom.eq('B16')) then
    if(!this.bM2Spring.unset())then
      !this.bM2Spring = |('$!name'|
    else
      !this.bM2Spring = !this.bM2Spring + |,'$!name'|
    endif
  elseif(!bottom.eq('B17')) then
    if(!this.doubleBM1Spring.unset())then
      !this.doubleBM1Spring = |('$!name'|
    else
      !this.doubleBM1Spring = !this.doubleBM1Spring + |,'$!name'|
    endif
  endif

endmethod


