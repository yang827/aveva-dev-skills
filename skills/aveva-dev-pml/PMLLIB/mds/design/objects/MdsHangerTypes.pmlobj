--*************************************************************************************************

define method .endHangerConfiguration()
  !fixedVariable = 'Fixed'
  do to 2
    --  !this.clevisAndLug$!fixedVariable = !this.clevisAndLug$!fixedVariable + |)|
    --handle any
    --!this.clevisAndLug$!fixedVariable = |()|
    --endhandle
    --!this.eyeRod$!fixedVariable = !this.eyeRod$!fixedVariable + |)|
    --handle any
    --  !this.eyeRod$!fixedVariable = |()|
    --endhandle
    --!this.doubleChannelRodConnection$!fixedVariable = !this.doubleChannelRodConnection$!fixedVariable + |)|
    --handle any
    --  !this.doubleChannelRodConnection$!fixedVariable = |()|
    --endhandle
    --do !index indices !this.oneRod$!fixedVariable
    --!this.oneRod$!fixedVariable$n[!index] = !this.oneRod$!fixedVariable$n[!index] + |)|
    --handle any
    --!this.oneRod$!fixedVariable = |()|
    --endhandle
    --enddo
    !fixedVariable = 'Variable'
  enddo
  !this.tS2Spring = !this.tS2Spring + |)|
  handle ANY
    !this.tS2Spring = |()|
  endhandle
  --!this.tS3Spring = !this.tS3Spring + |)|
  --handle any
  --    !this.tS3Spring = |()|
  --endhandle
  !this.tASpring = !this.tASpring + |)|
  handle ANY
    !this.tASpring = |()|
  endhandle
  !this.eSSpring = !this.eSSpring + |)|
  handle ANY
    !this.eSSpring = |()|
  endhandle
  --!this.tS1Spring = !this.tS1Spring + |)|
  --handle any
  --    !this.tS1Spring = |()|
  --endhandle
  do !index indices !this.pipeClamp
    !this.pipeClamp[!index] = !this.pipeClamp[!index] + |)|
    handle ANY
      !this.pipeClamp[!index] = |()|
    endhandle
  enddo
  !this.weldedElbowOrPipeLug = !this.weldedElbowOrPipeLug + |)|
  handle ANY
    !this.weldedElbowOrPipeLug = |()|
  endhandle
  !this.weldedElbowtrunion = !this.weldedElbowtrunion + |)|
  handle ANY
    !this.weldedElbowtrunion = |()|
  endhandle
  --!this.riserClamp = !this.riserClamp + |)|
  --handle any
  --!this.riserClamp = |()|
  --endhandle
  !this.dSSpring = !this.dSSpring + |)|
  handle ANY
    !this.dSSpring = |()|
  endhandle
  !this.dSSpringWithShoe = !this.dSSpringWithShoe + |)|
  handle ANY
    !this.dSSpringWithShoe = |()|
  endhandle
  !this.channelAssembly = !this.channelAssembly + |)|
  handle ANY
    !this.channelAssembly = |()|
  endhandle

  !this.bM1Spring = !this.bM1Spring + |)|
  handle ANY
    !this.bM1Spring = |()|
  endhandle
  !this.bM2Spring = !this.bM2Spring + |)|
  handle ANY
    !this.bM2Spring = |()|
  endhandle
  !this.doubleBM1Spring = !this.doubleBM1Spring + |)|
  handle ANY
    !this.doubleBM1Spring = |()|
  endhandle
  --!this.noRods = !this.noRods + |)|
  --handle any
  --  !this.noRods = |()|
  --endhandle
endmethod

