--
-- Define Object
  define object mdsheadings

    member .headings   is array
    member .definition is mdsheadingsdata

-- End of Object
  endobject
--
-----------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------
-- Method:       set(!indx is real,!validhdg is array)
--
-- Description:  Stores the data for each Pre MDS defined Report
--
-- Arguments:
--    [#]   [R/RW]    [Data Type]   [Description]
--
-- Return:
--    [Data Type]    [Description]
--
-----------------------------------------------------------------------------------------------------------
  define method .set(!indx is real,!validhdg is array)

--  Load the member and object mdsreportdata
    !this.definition.number      = !indx
    !this.definition.description = !validhdg[1].trim()
    !this.definition.title       = !validhdg[2].trim()
    !this.definition.expression  = !validhdg[3].trim()
    !this.definition.function    = !validhdg[4].trim()
    !this.definition.justify     = !validhdg[5].trim()
    !this.definition.ccode       = !validhdg[6].trim()
    !this.definition.unset       = !validhdg[7].trim()
    !this.definition.cdesc       = !validhdg[8].trim()
    !this.definition.data        = !validhdg[9].trim()

  endmethod
-- End of method
--
-----------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------
--
-- End of file mdsheadings.pmlobj
