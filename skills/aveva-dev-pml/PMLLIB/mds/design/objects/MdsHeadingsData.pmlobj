--
-- Define Object
  define object mdsheadingsdata

    member .number      is real
    member .description is string
    member .title       is string
    member .expression  is string
    member .function    is string
    member .unset       is string
    member .ccode       is string
    member .cdesc       is string
    member .data        is string
    member .justify     is string

    -----------------------------------------------
    -- Sorting, totalling and sub-totalling options --
    -----------------------------------------------

    -- Total output flag - true = output totaling for this column (col must be numeric)
    member .total       is BOOLEAN

    -- Sorting precedence - 0 = no sorting, >0 = sort precedence for this column (1 = sort first, 2 = sort second etc)
    member .sortprec    is REAL

    -- Sort Ascending flag - true = sort ascending, false = sort descending
    member .sortascend  is BOOLEAN

    -- Generate sub totals for given sorted column - 0 = no subtotaling, >0 = subtotal this column when
    -- values change in sorted column given in this !thisvalue
    member .subSortCol  is REAL

    -- subtotal output values - options are: ON/OFF/SUB and FIRST (full desc below)
    member .subValues   is STRING

    -- .subValues controls when values in this
    -- column will be output. There are two basic options for ALL columns:
    --
    --                             ON  - column values are always ouput.
    --                             OFF - column values are not output.
    --                                   However if this column has subtotaling on
    --                                   then a subtotal value will be output when
    --                                   the associated subtotal_sort_col column
    --                                   values changes and triggers a subtotal for
    --                                   this column.
    --
    --                            There are two additional value options that are
    --                            relevant if subtotaling is in effect in the report:
    --
    --                              SUB   - column values are only output when a
    --                                      subtotal is output in any column
    --
    --                              FIRST - column values are output for the first
    --                                      row in a group of sorted values. This
    --                                      option can ONLY be used if this column
    --                                      is being sorted (sort_precedence > 0)


-- End of Object
  endobject
--
-----------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------
--


-- default constructor method
define method .mdsheadingsdata()

    !this.number      = 0
    !this.description = ''
    !this.title       = ''
    !this.expression  = ''
    !this.function    = ''
    !this.unset       = ''
    !this.ccode       = ''
    !this.cdesc       = ''
    !this.data        = ''
    !this.justify     = ''
    !this.total       = FALSE
    !this.sortprec    = 0
    !this.sortascend  = TRUE
    !this.subSortCol  = 0
    !this.subValues   = 'ON'


endmethod


--
-- End of file mdsheadingsdata.pmlobj
