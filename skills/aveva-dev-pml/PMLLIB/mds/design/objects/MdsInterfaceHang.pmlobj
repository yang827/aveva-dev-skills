    endhandle
    !!ce = !attaName.dbref()
    !!ce = !ce
    handle ANY
    endhandle
    !!kRestoreUnits(!currentUnits)
    return error 99 'user exit' noalert
  endhandle

  --REFACTOR THE BELOW STATEMENT MAY NOT BE ACCURATE FOR RECONNECTS INVESTIGATE <RM> 15/03/2010
  --REFACTOR this is not required because the beams are defined prior to entry into the hanger object and cannot change - start
  --!this.rest.beamRefArray[!beamRefIndex] = !newFittName.dbref().owner
  --REFACTOR this is not required because the beams are defined prior to entry into the hanger object and cannot change - end

  --REFACTOR dun1218 add test for whether or not this is a virtual fitting
  if !newFittName.eq('VIRTUALFITTING1') then
    !virtualFitting = TRUE
  else
    !virtualFitting = FALSE
  endif

  if !virtualFitting then
    !this.fitt = object MDSFITT(!!mdsHangerType25.virtualFitting)
  else
  !this.fitt = object MDSFITT(!newFittName.dbref())
  endif
  --REFACTOR dun1218 add test for whether or not this is a virtual fitting

  !!ce = !attaName.dbref()
  !errtext = ''
  !this.finalize(!attaName, !hangerNo, !numOfHangers)
  handle 1 9 51
    -- hanger is not vertical
    -- Unset the beamref so the user will be able to identify another beam
    if(!hangerNo eq 1) then
      !errtext = '$!!error.text'
    else
      !errtext = 'Hanger no. ' + STRING(!hangerNo - 1) + ' $!!error.text'
    endif
    !this.initForRestart(!hangerNo, !errtext)
    handle 51
      --we are going to restart the create process
      !!kRestoreUnits(!currentUnits)
      return error 51
    elsehandle NONE
      !!kRestoreUnits(!currentUnits)
    endhandle
  elsehandle ANY
    !!kRestoreUnits(!currentUnits)
    return error 90 |$!!error.text|
  endhandle

  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)

endmethod

---------------------------------------------------------------------------------------
--method     : .createType31
--description: runs the hanger object create routines for a type 31 hanger only
---------------------------------------------------------------------------------------
define method .createType31(!oRest is MDSINTERFACEREST, !form is FORM, !hangerNo is REAL, !numOfHangers is REAL)

  -- Find current units and set the distance unit to metric
  !this.rest = !oRest
  !this.form = !form
  !this.vendorForm = !form.vendorForm
  !currentUnits = !!kgetsetunits()
  mm bore mm dist

  -- Initialise variables
  !datum       = !oRest.attaRef

  --------------------------------------------------------------------------------
  -- Make atta current element

  !ce = !!ce
  !!ce = !datum
  !attaName = !this.rest.ref.name.before('/REST')
  !attaRef = !attaName.dbref()
  !bore = pl bore
  --if(!this.rest.beamRefArray.unset() or (!this.rest.beamRefArray.size() eq 0)) then
  --  !this.rest.initBeamRef()
  --endif
  !beamRefArray = !this.rest.beamRefArray

  !steelPrompt = 'Identify steelwork to connect hanger to'

  -- The beam ref array holds two place of each hanger
  if(!hangerNo leq 2) then
    --Points to the first hanger beam ref
    !beamRefIndex = 0
  else
    --Points to the second hanger beam ref
    !beamRefIndex = 2
  endif

  !beamRefArray = !this.rest.beamRefArray
  !!mdsDacControl(TRUE)
  !beamRefIndex = !beamRefIndex + 1

  -- Create the fitting to the steel
  !fittRef = object DBREF()
  !newFittName = !this.setHangSteelType31(!attaRef, !steelPrompt, !fittRef, !beamRefArray[!beamRefIndex],!hangerNo)
  handle 1
    -- READ ONLY Access to the Section
    !!ce = !attaName.dbref()
    !!ce = !ce
    handle ANY
    endhandle
    !!kRestoreUnits(!currentUnits)
    return error 1 'Read only element' noalert
  elsehandle 2
    -- WRITE Access to the Section, BUT it is LOCKED
    !!ce = !attaName.dbref()
    !!ce = !ce
    handle ANY
    endhandle
    !!kRestoreUnits(!currentUnits)
    return error 2 'The Identified element is locked.' noalert
  elsehandle 99

    -- User has clicked the Escape key

    !!ce = !firstFittRef
    handle ANY
    endhandle
    !!ce = !secondFittRef
    handle ANY
    endhandle
    !!ce = !attaName.dbref()
    !!ce = !ce
    handle ANY
    endhandle
    !!kRestoreUnits(!currentUnits)
    return error 99 'user exit' noalert
  endhandle

  --REFACTOR THE BELOW STATEMENT MAY NOT BE ACCURATE FOR RECONNECTS INVESTIGATE <RM> 15/03/2010
  --REFACTOR this is not required because the beams are defined prior to entry into the hanger object and cannot change - start
  --!this.rest.beamRefArray[!beamRefIndex] = !newFittName.dbref().owner
  --REFACTOR this is not required because the beams are defined prior to entry into the hanger object and cannot change - end

  --REFACTOR dun1218 add test for whether or not this is a virtual fitting
  if !newFittName.eq('VIRTUALFITTING1') then
    !virtualFitting = TRUE
  else
    !virtualFitting = FALSE
  endif

  if !virtualFitting then
    !this.fitt = object MDSFITT(!!mdsHangerType31.virtualFitting)
  else
  !this.fitt = object MDSFITT(!newFittName.dbref())
  endif
  --REFACTOR dun1218 add test for whether or not this is a virtual fitting

  !!ce = !attaName.dbref()
  !errtext = ''
  !this.finalize(!attaName, !hangerNo, !numOfHangers)
  handle 1 9 51
    -- hanger is not vertical
    -- Unset the beamref so the user will be able to identify another beam
    if(!hangerNo eq 1) then
      !errtext = '$!!error.text'
    else
      !errtext = 'Hanger no. ' + STRING(!hangerNo - 1) + ' $!!error.text'
    endif
    !this.initForRestart(!hangerNo, !errtext)
    handle 51
      --we are going to restart the create process
      !!kRestoreUnits(!currentUnits)
      return error 51
    elsehandle NONE
      !!kRestoreUnits(!currentUnits)
    endhandle
  elsehandle ANY
    !!kRestoreUnits(!currentUnits)
    return error 90 |$!!error.text|
  endhandle

  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)

endmethod

---------------------------------------------------------------------------------------
--method     : .createType32
--description: runs the hanger object create routines for a type 32 hanger only
---------------------------------------------------------------------------------------
define method .createType32(!oRest is MDSINTERFACEREST, !form is FORM, !hangerNo is REAL, !numOfHangers is REAL)

  -- Find current units and set the distance unit to metric
  !this.rest = !oRest
  !this.form = !form
  !this.vendorForm = !form.vendorForm
  !currentUnits = !!kgetsetunits()
  mm bore mm dist

  -- Initialise variables
  !datum       = !oRest.attaRef

  --------------------------------------------------------------------------------
  -- Make atta current element
  !ce = !!ce
  !!ce = !datum
  !attaName = !this.rest.ref.name.before('/REST')
  !attaRef = !attaName.dbref()
  !bore = pl bore
  --if(!this.rest.beamRefArray.unset() or (!this.rest.beamRefArray.size() eq 0)) then
  --  !this.rest.initBeamRef()
  --endif
  !beamRefArray = !this.rest.beamRefArray

  -- The beam ref array holds two place of each hanger
  if(!hangerNo leq 2) then
    --Points to the first hanger beam ref
    !beamRefIndex = 0
  else
    --Points to the second hanger beam ref
    !beamRefIndex = 2
  endif

  --sort out the first and second channel fittings etc.
  !firstFittRef = !this.firstChannel(!hangerNo, !beamRefIndex, !attaRef, 32)
  if !firstFittRef.eq('VIRTUALFITTING1') then
    if !hangerNo.eq(2) then
      !firstFittRef = '!!mdsHangerType32.virtualFitting2'
    else
      !firstFittRef = '!!mdsHangerType32.virtualFitting'
    endif
  endif
  !newFittName = !this.secondChannel(!hangerNo, !beamRefIndex, !attaRef, !firstFittRef, !form, 32)

  --REFACTOR THE BELOW STATEMENT MAY NOT BE ACCURATE FOR RECONNECTS INVESTIGATE <RM> 15/03/2010
  --REFACTOR this is not required because the beams are defined prior to entry into the hanger object and cannot change - start
  --!this.rest.beamRefArray[!beamRefIndex] = !newFittName.dbref().owner
  --REFACTOR this is not required because the beams are defined prior to entry into the hanger object and cannot change - end

  --REFACTOR dun1218 add test for whether or not this is a virtual fitting
  if !newFittName.eq('VIRTUALFITTING1') then
    !virtualFitting = TRUE
  else
    !virtualFitting = FALSE
  endif

  if !virtualFitting then
    if !hangerNo.eq(2) then
      !this.fitt = object MDSFITT(!!mdsHangerType32.virtualFitting2)
    else
      !this.fitt = object MDSFITT(!!mdsHangerType32.virtualFitting)
    endif
  else
    !this.fitt = object MDSFITT(!newFittName.dbref())
  endif
  --REFACTOR dun1218 add test for whether or not this is a virtual fitting

  !!ce = !attaName.dbref()

  !errtext = ''
  !this.finalize(!attaName, !hangerNo, !numOfHangers)
  handle 1 9 51
    -- hanger is not vertical
    -- Unset the beamref so the user will be able to identify another beam
    if(!hangerNo eq 1) then
      !errtext = '$!!error.text'
    else
      !errtext = 'Hanger no. ' + STRING(!hangerNo - 1) + ' $!!error.text'
    endif
    !this.initForRestart(!hangerNo, !errtext)
    handle 51
      --we are going to restart the create process
      !!kRestoreUnits(!currentUnits)
      return error 51
    elsehandle NONE
      !!kRestoreUnits(!currentUnits)
    endhandle
  elsehandle ANY
    !!kRestoreUnits(!currentUnits)
    return error 90 |$!!error.text|
  endhandle

  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)

endmethod

---------------------------------------------------------------------------------------
--method     : .secondChannel
--description: sets up the first channel in case of a type 2 or 32 hanger
---------------------------------------------------------------------------------------
define method .firstChannel(!hangerNo is REAL, !beamRefIndex is REAL, !attaRef is DBREF, !hangerType is REAL) is STRING

  !steelPrompt = 'Identify first channel beam to connect hanger no.$!hangerNo to'

  !beamRefArray = !this.rest.beamRefArray
  !!mdsDacControl(TRUE)
  !beamRefIndex = !beamRefIndex + 1

  -- Create the fitting to the steel
  !fittRef = object DBREF()

  if !hangerType.eq(2) then
    !newFittName = !this.setHangSteelType2(!attaRef, !steelPrompt, !fittRef, !beamRefArray[!beamRefIndex],!hangerNo)
    handle 1
      -- READ ONLY Access to the Section
      !!ce = !attaRef
      !!ce = !ce
      handle ANY
      endhandle
      !!kRestoreUnits(!currentUnits)
      return error 1 'Read only element' noalert
    elsehandle 2
      -- WRITE Access to the Section, BUT it is LOCKED
      !!ce = !attaRef
      !!ce = !ce
      handle ANY
      endhandle
      !!kRestoreUnits(!currentUnits)
      return error 2 'The Identified element is locked.' noalert
    elsehandle 99

      -- User has clicked the Escape key
      !!ce = !firstFittRef
      handle ANY
      endhandle
      !!ce = !secondFittRef
      handle ANY
      endhandle
      !!ce = !attaRef
      !!ce = !ce
      handle ANY
      endhandle
      !!kRestoreUnits(!currentUnits)
      return error 99 'user exit' noalert
    endhandle
  elseif !hangerType.eq(32) then
    !newFittName = !this.setHangSteelType32(!attaRef, !steelPrompt, !fittRef, !beamRefArray[!beamRefIndex],!hangerNo)
    handle 1
      -- READ ONLY Access to the Section
      !!ce = !attaRef
      !!ce = !ce
      handle ANY
      endhandle
      !!kRestoreUnits(!currentUnits)
      return error 1 'Read only element' noalert
    elsehandle 2
      -- WRITE Access to the Section, BUT it is LOCKED
      !!ce = !attaRef
      !!ce = !ce
      handle ANY
      endhandle
      !!kRestoreUnits(!currentUnits)
      return error 2 'The Identified element is locked.' noalert
    elsehandle 99

      -- User has clicked the Escape key
      !!ce = !firstFittRef
      handle ANY
      endhandle
      !!ce = !secondFittRef
      handle ANY
      endhandle
      !!ce = !attaRef
      !!ce = !ce
      handle ANY
      endhandle
      !!kRestoreUnits(!currentUnits)
      return error 99 'user exit' noalert
    endhandle
  endif

  --REFACTOR THE BELOW STATEMENT MAY NOT BE ACCURATE FOR RECONNECTS INVESTIGATE <RM> 15/03/2010
  --REFACTOR this is not required because the beams are defined prior to entry into the hanger object and cannot change - start
  --!this.rest.beamRefArray[!beamRefIndex] = !newFittName.dbref().owner
  --REFACTOR this is not required because the beams are defined prior to entry into the hanger object and cannot change - end

  --REFACTOR dun1218 add test for whether or not this is a virtual fitting
  if !newFittName.eq('VIRTUALFITTING1') then
    !virtualFitting = TRUE
  else
    !virtualFitting = FALSE
  endif

  if !virtualFitting then

    return !newFittName

  else

    !firstFittRef = !newFittName.dbref()
    !firstName = !firstFittRef.name + '/FIRST'
    !firstFittRef.name = !firstName
    handle ANY
      if(!!ce.name.eq(!firstName))then
        -- the current fitting is the one with the required name
        -- no need to rename it
      else
        -- name already exist some how...but it is another fitting
        -- we can delete the other fitting
        !cetemp = !!ce
        !!ce = !firstName.dbref()
        delete fitt
        handle ANY
          !!alert.message('Deleting fitting $!firstName$n. ' + !!error.text  + ' ' + !!error.line.before(|***|))
        endhandle
        !!ce = !cetemp
        !firstFittRef.name = !firstName
      endif
    endhandle
    enhance $!firstFittRef
    return !firstFittRef.string()

  endif

endmethod

---------------------------------------------------------------------------------------
--method     : .secondChannel
--description: sets up the second channel in case of a type 2 or 32 hanger
---------------------------------------------------------------------------------------
define method .secondChannel(!hangerNo is REAL, !beamRefIndex is REAL, !attaRef is DBREF, !firstFittRef is STRING, !form is FORM, !hangerType is REAL) is STRING

  !firstFitting = $!firstFittRef

  !steelPrompt = 'Identify second channel beam to connect hanger no. $!hangerNo to'

  !beamRefArray = !this.rest.beamRefArray
  !!mdsDacControl(TRUE)
  !beamRefIndex = !beamRefIndex + 1

  -- Create the fitting to the steel
  !fittRef = object DBREF()

  if !hangerType.eq(2) then
    !newFittName = !this.setHangSteelType2(!attaRef, !steelPrompt, !fittRef, !beamRefArray[!beamRefIndex],!hangerNo)
    handle 1
      -- READ ONLY Access to the Section
      !!ce = !attaRef
      !!ce = !ce
      handle ANY
      endhandle
      !!kRestoreUnits(!currentUnits)
      return error 1 'Read only element' noalert
    elsehandle 2
      -- WRITE Access to the Section, BUT it is LOCKED
      !!ce = !attaRef
      !!ce = !ce
      handle ANY
      endhandle
      !!kRestoreUnits(!currentUnits)
      return error 2 'The Identified element is locked.' noalert
    elsehandle 99
      -- User has clicked the Escape key
      !!ce = !firstFittRef
      handle ANY
      endhandle
      !!ce = !secondFittRef
      handle ANY
      endhandle
      !!ce = !attaRef
      !!ce = !ce
      handle ANY
      endhandle
      !!kRestoreUnits(!currentUnits)
      return error 99 'user exit' noalert
    endhandle
  elseif !hangerType.eq(32) then
    !newFittName = !this.setHangSteelType32(!attaRef, !steelPrompt, !fittRef, !beamRefArray[!beamRefIndex],!hangerNo)
    handle 1
      -- READ ONLY Access to the Section
      !!ce = !attaRef
      !!ce = !ce
      handle ANY
      endhandle
      !!kRestoreUnits(!currentUnits)
      return error 1 'Read only element' noalert
    elsehandle 2
      -- WRITE Access to the Section, BUT it is LOCKED
      !!ce = !attaRef
      !!ce = !ce
      handle ANY
      endhandle
      !!kRestoreUnits(!currentUnits)
      return error 2 'The Identified element is locked.' noalert
    elsehandle 99
      -- User has clicked the Escape key
      !!ce = !firstFittRef
      handle ANY
      endhandle
      !!ce = !secondFittRef
      handle ANY
      endhandle
      !!ce = !attaRef
      !!ce = !ce
      handle ANY
      endhandle
      !!kRestoreUnits(!currentUnits)
      return error 99 'user exit' noalert
    endhandle
  endif

  --REFACTOR THE BELOW STATEMENT MAY NOT BE ACCURATE FOR RECONNECTS INVESTIGATE <RM> 15/03/2010
  --REFACTOR this is not required because the beams are defined prior to entry into the hanger object and cannot change - start
  --!this.rest.beamRefArray[!beamRefIndex] = !newFittName.dbref().owner
  --REFACTOR this is not required because the beams are defined prior to entry into the hanger object and cannot change - end

  --REFACTOR dun1218 add test for whether or not this is a virtual fitting
  if !newFittName.eq('VIRTUALFITTING1') then
    !virtualFitting = TRUE
  else
    !virtualFitting = FALSE
  endif

  if !virtualFitting then

    -- This is the second channel
    !secondFittRef = $!firstFittRef

    -- Set the :MDSConnect array reference first member to point to the
    -- the reference of the first section
    !connections = object ARRAY()
    !connections.append(!firstFitting.owner)
    !secondFittRef.mdsConnect = !connections
    !secondFittRef.mdsConnectN = !firstFitting.owner.fullname

    !delpos = !form.getMiddleDelPos(!firstFitting, !secondFittRef)
    !secondFittRef.setDelpos($!delpos)
    handle ANY
      !secondFittRef.setDelpos(!delpos.position())
    endhandle

    if(!hangerNo le 2) then
      -- move the atta to be just below the middle distance between the channels
      !!ce = !attaRef

      if (!this.vendorForm.hangerseltype.val inset ('2V','31V','32V')) then
        -- Pipe is VERTICAL - so do NOTHING to MOVE the ATTA
      else
        --get the virtual fitting position
        !position = !secondFittRef.getPosition()

        through $!position
        handle ANY
          plan n through $!position
          handle ANY
            plan e through $!position
          endhandle
        endhandle

        !attaName = !attaRef.name
        $!attaName/H1
        conn hh to $!attaName

        tref $!attaName/SBFI/H1
        handle ANY
        endhandle

        !boreReal = !!ce.hbore.real()
        hcon ATT
        !ceMem = !!ce.mem
        -- reconnect the hanger 1 members
        do !memI indices !ceMem
          !!ce = !ceMem[!memI]

          if (!!ce.type eq 'VSPR' ) then
            desp num 30 $!boreReal
          endif

          if ((!!ce.order.eq(1) ) and (!!ce.type inset ('PCLA')) ) then
            !attldir = ldir of $!attaRef wrt /*
            !udir    = down wrt /*
            !odir = !attldir.orthogonal(!udir)
            conn and pl is $!odir
          else
            !ldir = !!ce.ldir

            conn and pl is $!ldir
            handle (61,34) $* handle degenerate ori
            elsehandle ANY
              -- 12/2002 <ab>

              ------------------------------------------------------------------------------------------------------------
              --<wd>14jun2004 -- Code to get the LDIR of the PCLA on the PIPE
              --fconn
              -- Get the PLEAVE direction of the PCLA - First hanger Component
              if ((!!ce.order.eq(1) ) and (!!ce.type inset ('PCLA')) ) then
                --!attldir = ldir of $!attaName wrt /*
                !attldir = ldir of $!attaRef wrt /*
                !udir    = down wrt /*
                !odir = !attldir.orthogonal(!udir)
                conn and pl is $!odir
              else
                fconn
              endif
              --<wd>14jun2004 -- Code to get the LDIR of the PCLA on the PIPE
              ------------------------------------------------------------------------------------------------------------
              !connPrev = pl conn of prev
              handle ANY
                !connPrev = ''
              endhandle
            endhandle
          endif
        enddo
        --REFACTOR, THIS WOULD ONLY WORK IF THERE ARE MEMBERS UNDER THE HANGER OTHERWISE IT FALLS OVER COMMENT OUT FOR NOW
        $(
        !tref = tref
        conn ht to last mem
        tref $!tref
        $)
        --REFACTOR, THIS WOULD ONLY WORK IF THERE ARE MEMBERS UNDER THE HANGER OTHERWISE IT FALLS OVER COMMENT OUT FOR NOW
      endif
    endif

    --set the appropriate form member
    if !hangerType.eq(2) then
      !!mdsHangerType2.virtualFitting = !secondFittRef
    else
      if !hangerNo.eq(2) then
        !!mdsHangerType32.virtualFitting2 = !secondFittRef
      else
        !!mdsHangerType32.virtualFitting = !secondFittRef
      endif
    endif
    return !newFittName

  else

    -- This is the second channel
    !secondFittRef = !newFittName.dbref()

    -- Set the :MDSConnect array reference first member to point to the
    -- the reference of the first section
    !connections = object ARRAY()
    !connections.append(!firstFittRef.dbref().owner)
    !secondFittRef.:MDSConnect = !connections
    !secondFittRef.:MDSConnectN = !firstFittRef.dbref().owner.fullname
    !!ce = !secondFittRef

    !delpos = !form.getMiddleDelPos(!firstFittRef.dbref() , !secondFittRef)
    delpos $!delpos

    !!ce = !firstFittRef.dbref()
    delete fitt
    if(!hangerNo le 2) then
      -- move the atta to be just below the middle distance between the channels
      !!ce = !secondFittRef.owner
      !!ce = !attaRef
      --!stypToCheck = !this.rest.styp
      if (!this.vendorForm.hangerseltype.val inset ('2V','31V','32V')) then
        -- Pipe is VERTICAL - so do NOTHING to MOVE the ATTA
      else
        through $!secondFittRef
        handle ANY
          plan n through $!secondFittRef
          handle ANY
            plan e through $!secondFittRef
          endhandle
        endhandle
        !attaName = !attaRef.name
        $!attaName/H1
        conn hh to $!attaName
        --tref $!attaName/SBFI/H1
        tref $!attaName/SBFI/H1
        handle ANY
        endhandle
        !boreReal = !!ce.hbore.real()
        hcon ATT
        !ceMem = !!ce.mem
        -- reconnect the hanger 1 members
        do !memI indices !ceMem
          !!ce = !ceMem[!memI]

          if (!!ce.type eq 'VSPR' ) then
            desp num 30 $!boreReal
          endif

          if ((!!ce.order.eq(1) ) and (!!ce.type inset ('PCLA')) ) then
            --!attldir = ldir of $!attaName wrt /*
            !attldir = ldir of $!attaRef wrt /*
            !udir    = down wrt /*
            !odir = !attldir.orthogonal(!udir)
            conn and pl is $!odir
          else
            !ldir = !!ce.ldir

            conn and pl is $!ldir
            handle (61,34) $* handle degenerate ori
            elsehandle ANY
              -- 12/2002 <ab>

              ------------------------------------------------------------------------------------------------------------
              --<wd>14jun2004 -- Code to get the LDIR of the PCLA on the PIPE
              --fconn
              -- Get the PLEAVE direction of the PCLA - First hanger Component
              if ((!!ce.order.eq(1) ) and (!!ce.type inset ('PCLA')) ) then
                --!attldir = ldir of $!attaName wrt /*
                !attldir = ldir of $!attaRef wrt /*
                !udir    = down wrt /*
                !odir = !attldir.orthogonal(!udir)
                conn and pl is $!odir
              else
                fconn
              endif
              --<wd>14jun2004 -- Code to get the LDIR of the PCLA on the PIPE
              ------------------------------------------------------------------------------------------------------------
              !connPrev = pl conn of prev
              handle ANY
                !connPrev = ''
              endhandle
            endhandle
          endif
        enddo
        --REFACTOR, THIS WOULD ONLY WORK IF THERE ARE MEMBERS UNDER THE HANGER OTHERWISE IT FALLS OVER COMMENT OUT FOR NOW
        $(
        !tref = tref
        conn ht to last mem
        tref $!tref
        $)
        --REFACTOR, THIS WOULD ONLY WORK IF THERE ARE MEMBERS UNDER THE HANGER OTHERWISE IT FALLS OVER COMMENT OUT FOR NOW
      endif
    endif
    return !newFittName
  endif

endmethod

---------------------------------------------------------------------------------------
--method     : .initForRestart
--description: initialises form members for a restart of the create process.
--             in case of error this method may try to reverse the beam array for multi
--             support hangers
---------------------------------------------------------------------------------------
define method .initForRestart(!hangerNo is REAL, !errtext is STRING)

  if(!hangerNo leq 2) then
    --Points to the first hanger beam ref
    !beamRefIndex = 1
  else
    --Points to the second hanger beam ref
    !beamRefIndex = 3
  endif
  -- Trying to reverse the beamrefarray and check again it the hanger will be vertical
  -- if not vertical after reversing it we unset it and issue an error message
  -- Unset the beamref so the user will be able to identify another beam
  if(!this.reversedBeamArray) then
    -- array was reversed
    -- unset the beamref array for this hanger no.
    !this.updateBeamRefArray(!beamRefIndex, FALSE)
    ---- 12/2002 <ab>        !!alert.message(!errtext)
    if(!!alert.confirm(!errtext + '. Do you want to accept it?').eq('YES')) then
      --exit
      refresh
      return
    endif
  else
    if !errtext.neq('') then
      if defined(!!mdsautotestrunning) then
        --exit
        refresh
        return
      else
        if(!!alert.confirm(!errtext + '. Do you want to accept it?').eq('YES')) then
          --exit
          refresh
          return
        endif
      endif
    endif
    -- array was not reversed
    -- reverse the array only if it is a double-hanger hanger
    -- if it is a single-hanger hanger it will unset the beam ref array
    -- and try again with same beams
    !this.updateBeamRefArray(!beamRefIndex, TRUE)
    if( not !this.reversedBeamArray) then
      --dtf >>> 10nov04 mod to switch off vertical error message for lisega vertical pipes
      if (!this.vendorForm.type.neq('V')) then
        if (!this.vendorForm.hangerseltype.val.before('H').real().neq(31)) then
          if defined(!!mdsautotestrunning) then
            --exit
            refresh
            return
          else
            if defined(!!mdsautotestrunning) then
              --exit
              refresh
              return
            else
              if(!!alert.confirm(!errtext + '. Do you want to accept it?').eq('YES')) then
                --exit
                refresh
                return
              endif
            endif
          endif
        else
          --exit
          refresh
          return
        endif
      else
        --exit
        refresh
        return
      endif
    endif
  endif
  --!beamRefArray = !this.rest.beamRefArray
  --var !firstFittRef delete

  --REFACTOR RETURN ERROR 51 TO SIGNIFY THAT WE WANT TO RESTART
  return error 51

endmethod

