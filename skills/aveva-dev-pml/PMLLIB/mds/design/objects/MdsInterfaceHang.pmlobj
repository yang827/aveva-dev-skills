--  createType18(MDSINTERFACEREST,FORM,REAL,REAL) -
--  createType19(MDSINTERFACEREST,FORM,REAL,REAL) -
--  createType2(MDSINTERFACEREST,FORM,REAL,REAL) -
--  createType20(MDSINTERFACEREST,FORM,REAL,REAL) -
--  createType21(MDSINTERFACEREST,FORM,REAL,REAL) -
--  createType25(MDSINTERFACEREST,FORM,REAL,REAL) -
--  createType31(MDSINTERFACEREST,FORM,REAL,REAL) -
--  createType32(MDSINTERFACEREST,FORM,REAL,REAL) -
--  createType6(MDSINTERFACEREST,FORM,REAL,REAL) -
--  createType7(MDSINTERFACEREST,FORM,REAL,REAL) -
--  finalize(STRING,REAL,REAL)       -
--  firstChannel(REAL,REAL,DBREF,REAL) STRING
--  initForRestart(REAL,STRING)      -
--  secondChannel(REAL,REAL,DBREF,STRING,FORM,REAL) STRING
--  setHangSteelType1(DBREF,STRING,DBREF,DBREF,REAL) STRING
--  setHangSteelType18(DBREF,STRING,DBREF,DBREF,REAL) STRING
--  setHangSteelType19(DBREF,STRING,DBREF,DBREF,REAL) STRING
