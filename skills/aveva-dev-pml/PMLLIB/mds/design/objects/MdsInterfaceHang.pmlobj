--  setHangSteelType25(DBREF,STRING,DBREF,DBREF,REAL) STRING
--  setHangSteelType31(DBREF,STRING,DBREF,DBREF,REAL) STRING
--  setHangSteelType32(DBREF,STRING,DBREF,DBREF,REAL) STRING
--  setHangSteelType6(DBREF,STRING,DBREF,DBREF,REAL) STRING
--  setHangSteelType600(DBREF,STRING,DBREF,DBREF,REAL) STRING
--  setHangSteelType7(DBREF,STRING,DBREF,DBREF,REAL) STRING
--  updateBeamRefArray(REAL,BOOLEAN) -
