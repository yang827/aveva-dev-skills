-- Define Object

define object MDSINTERFACEHANG

  -- member. list of hanger members (PCLA, VSPR, HROD etc.)
  member .hangmem is ARRAY

  -- Name of hanger
  member .name is STRING

  -- Ref of hanger
  member .ref    is DBREF

  -- Head data
  -- hpos
  member .hpos is POSITION

  -- hdir
  member .hdir  is DIRECTION

  -- hbor
  member .hbor is BORE

  -- hconn
  member .hcon is STRING

  -- href
  member .href is DBREF

  -- Tail data
  -- tpos
  member .tpos is POSITION

  -- tdir
  member .tdir  is DIRECTION

  -- tbor
  member .tbor is BORE

  -- tconn
  member .tcon is STRING

  -- tref
  member .tref is DBREF

  -- hsrod
  member .hsrod is DBREF

  -- fitting
  member .fitt is MDSFITT

  -- func (information about SCTN p-line or PANE face (BOTT or TOP) or BOX face (p-point number) stored when no fitting)
  member .func is STRING

  -- owner
  member .rest is MDSINTERFACEREST

  -- hanger rods array
  member .rods is ARRAY
  member .reversedBeamArray is BOOLEAN

  -- hanger form
  member .form is FORM

  --mdsvendor form for current type i.e. mdsVendorHangerType1
  member .vendorForm is FORM

  member .group is REAL

endobject

---------------------------------------------------------------------------------------
--method     : .create
--description: the entry point for the hanger creation. This setes up the hanger based
--             upon the specific type of hanger being created
---------------------------------------------------------------------------------------
define method .create(!oRest is MDSINTERFACEREST, !form is FORM, !hangerNo is REAL, !numOfHangers is REAL)
  --REFACTOR I HAVE REMOVED THE SINGLE CREATE METHOD WITH CALLS TO INDIVIDUAL METHODS FOR EACH HANGER TYPE
  --INITIALLY THIS WILL BE CUMBERSOME HOWEVER IT WILL MEAN THAT I CAN WORK ON SINGLE HANGER TYPES WITHOUT FEAR OF
  --DAMAGING OTHER TYPES. CODE WILL BE CUT FROM EACH CREATE METHOD SO THE OVERALL EFFECT WILL BE TO STREAMLINE THE PROCESS
  !hangerType = !form.fullname().upcase().after('MDSHANGER')

  !this.group = !!lisgroup
  handle ANY
    !configNumber = !this.rest.attaRef.:MdsHConfig
    handle ANY
      !configNumber = !oRest.attaRef.:MdsHConfig
    endhandle
    !this.group = !configNumber.replace('V','').replace('H','').real()
  endhandle

  --initialise variables
  !errorNumber = 0
  !this.reversedBeamArray = FALSE

  --REFACTOR HAVE REPLACED THE OLD /RESTART LABEL WITH DO LOOPS
  --THIS WORKS IN EXACTLY THE SAME WAY AS THE PREVIOUS VERSION HOWEVER IT IS
  --EASIER TO SEE EXACTLY WHEN THE CREATE METHOD RESTARTS
  if !hangerType.eq('TYPE1') then
    do
      !this.createType1(!oRest, !form, !hangerNo, !numOfHangers)
      handle 1
        !errorNumber = 1
        break
      elsehandle 2
        !errorNumber = 2
        break
      elsehandle 51
        skip
      elsehandle 99
        !errorNumber = 99
        break
      elsehandle NONE
        break
      endhandle
    enddo
  elseif !hangerType.eq('TYPE2') then
    do
      !this.createType2(!oRest, !form, !hangerNo, !numOfHangers)
      handle 1
        !errorNumber = 1
        break
      elsehandle 2
        !errorNumber = 2
        break
      elsehandle 51
        skip
      elsehandle 99
        !errorNumber = 99
        break
      elsehandle NONE
        break
      endhandle
    enddo
  elseif !hangerType.eq('TYPE6') then
    do
      !this.createType6(!oRest, !form, !hangerNo, !numOfHangers)
      handle 1
        !errorNumber = 1
        break
      elsehandle 2
        !errorNumber = 2
        break
      elsehandle 51
        skip
      elsehandle 99
        !errorNumber = 99
        break
      elsehandle NONE
        break
      endhandle
    enddo
  elseif !hangerType.eq('TYPE7') then
    do
      !this.createType7(!oRest, !form, !hangerNo, !numOfHangers)
      handle 1
        !errorNumber = 1
        break
      elsehandle 2
        !errorNumber = 2
        break
      elsehandle 51
        skip
      elsehandle 99
        !errorNumber = 99
        break
      elsehandle NONE
        break
      endhandle
    enddo
  elseif !hangerType.eq('TYPE18') then
    do
      !this.createType18(!oRest, !form, !hangerNo, !numOfHangers)
      handle 1
        !errorNumber = 1
        break
      elsehandle 2
        !errorNumber = 2
        break
      elsehandle 51
        skip
      elsehandle 99
        !errorNumber = 99
        break
      elsehandle NONE
        break
      endhandle
    enddo
  elseif !hangerType.eq('TYPE19') then
    do
      !this.createType19(!oRest, !form, !hangerNo, !numOfHangers)
      handle 1
        !errorNumber = 1
        break
      elsehandle 2
        !errorNumber = 2
        break
      elsehandle 51
        skip
      elsehandle 99
        !errorNumber = 99
        break
      elsehandle NONE
        break
      endhandle
    enddo
  elseif !hangerType.eq('TYPE20') then
    do
      !this.createType20(!oRest, !form, !hangerNo, !numOfHangers)
      handle 1
        !errorNumber = 1
        break
      elsehandle 2
        !errorNumber = 2
        break
      elsehandle 51
        skip
      elsehandle 99
        !errorNumber = 99
        break
      elsehandle NONE
        break
      endhandle
    enddo
  elseif !hangerType.eq('TYPE21') then
    do
      !this.createType21(!oRest, !form, !hangerNo, !numOfHangers)
      handle 1
        !errorNumber = 1
        break
      elsehandle 2
        !errorNumber = 2
        break
      elsehandle 51
        skip
      elsehandle 99
        !errorNumber = 99
        break
      elsehandle NONE
        break
      endhandle
    enddo
  elseif !hangerType.eq('TYPE25') then
    do
      !this.createType25(!oRest, !form, !hangerNo, !numOfHangers)
      handle 1
        !errorNumber = 1
        break
      elsehandle 2
        !errorNumber = 2
        break
      elsehandle 51
        skip
      elsehandle 99
        !errorNumber = 99
        break
      elsehandle NONE
        break
      endhandle
    enddo
  elseif !hangerType.eq('TYPE31') then
    do
      !this.createType31(!oRest, !form, !hangerNo, !numOfHangers)
      handle 1
        !errorNumber = 1
        break
      elsehandle 2
        !errorNumber = 2
        break
      elsehandle 51
        skip
      elsehandle 99
        !errorNumber = 99
        break
      elsehandle NONE
        break
      endhandle
    enddo
  elseif !hangerType.eq('TYPE32') then
    do
      !this.createType32(!oRest, !form, !hangerNo, !numOfHangers)
      handle 1
        !errorNumber = 1
        break
      elsehandle 2
        !errorNumber = 2
        break
      elsehandle 51
        skip
      elsehandle 99
        !errorNumber = 99
        break
      elsehandle NONE
        break
      endhandle
    enddo
  endif

  if !errorNumber.gt(0) then
    return error $!errorNumber
  endif

endmethod

define method .finalize(!attaName is STRING, !hangerNo is REAL, !numOfHangers is REAL)

  !currentUnits = !!kgetsetunits()
  mm bore mm dist
  !!ce = !this.rest.ref
  hang $!hangerNo
  !hangRef = !!ce
  !this.ref = !!ce
  if(!hangerNo eq 1) then
    -- Only first hanger is connected to the atta
    -- DAC's fix for HP0021504 GE 03/02/04
    !!mdsDacControl(TRUE)
    !this.rest.attaRef.cref = !hangRef
    !!mdsDacControl(FALSE)
  endif
  -- Set the fittref to unset for bottom supported hangers (no steelwork connections)
  !fittRef = object DBREF()
  if(!this.fitt.set() and !this.fitt.ref.set()) then
    !fittRef = !this.fitt.ref
  endif
  !this.form.resizeHanger(!hangRef, !fittRef)
  handle 1
    -- hanger is not vertical
    !!kRestoreUnits(!currentUnits)
    return error 1 |$!!error.text|
  elsehandle 2
    -- double channel distance
    !!kRestoreUnits(!currentUnits)
    return error 1 |$!!error.text|
  elsehandle 9
    -- beam and pipe too close or too far
    !!kRestoreUnits(!currentUnits)
    return error 9 |$!!error.text|
  elsehandle 51
    -- hanger is not vertical
    !!kRestoreUnits(!currentUnits)
    return error 51 |$!!error.text|
  elsehandle ANY
    !!kRestoreUnits(!currentUnits)
    !err = !!error.text + ' ' + !!error.line.before('***')
    return error 90 |$!err|
  endhandle

  if(!hangerNo eq 1 and !numOfHangers gt 1) then
    -- delete the fittings for the first hanger in a multi hanger rest
    !!ce = !hangRef
    !tref = tref
    conn ht to last mem
    tref $!tref
  endif

endmethod

---------------------------------------------------------------------------------------
--method     : .updateBeamRefArray
--description: reverses the beam array for double hanger types otherwise resets the beamarray
--             in order to force a pick of a new beam
---------------------------------------------------------------------------------------
define method .updateBeamRefArray(!beamRefIndex is REAL, !reverse is BOOLEAN)

  -- if it's a double hangers hanger, and the beam connection for the current hanger
  -- gives an non-vertical hanger, we try to swap the beams and try again.
  -- if the beams have been swapped then we issue an error message and force a prompt for
  -- the user to select another beam
  !currentUnits = !!kgetsetunits()
  mm bore mm dist
  !oHangTyp = !!mdsInterfaceAllHangertypes.gethangertype(!this.rest.styp)
  if(!oHangTyp.group eq !!mdsInterfaceAllHangertypes.doubleHangerGroupNoSingleBeam or $
    !oHangTyp.group eq !!mdsInterfaceAllHangertypes.doubleHangerGroupNoDoubleChannel or $
    !oHangTyp.group eq !!mdsInterfaceAllHangertypes.doubleHangerGroupNoCombined) then
    -- it's a double hangers hanger
    if((not !reverse)) then
      -- beam ref array has been reversed
      -- or we don't want to reverse it (in some other error states)
      -- unset it so the user will be able to identify another beam
      !this.rest.beamRefArray[!beamRefIndex] = object DBREF()
      !this.rest.beamRefArray[!beamRefIndex + 1] = object DBREF()

    else
      -- beam has NOT been reversed
      -- reverse it
      !newbeamRefArray = ARRAY()
      !newbeamRefArray[1] = !this.rest.beamRefArray[3]
      !newbeamRefArray[2] = !this.rest.beamRefArray[4]
      !newbeamRefArray[3] = !this.rest.beamRefArray[1]
      !newbeamRefArray[4] = !this.rest.beamRefArray[2]
      !this.rest.beamRefArray = !newbeamRefArray
      -- set the flag to reversed
      !this.reversedBeamArray = TRUE
    endif
  else
    -- it's NOT a double hangers hanger
    -- unset it so the user will be able to identify another beam
    !this.rest.beamRefArray[!beamRefIndex] = object DBREF()
    !this.rest.beamRefArray[!beamRefIndex + 1] = object DBREF()
  endif
  !!kRestoreUnits(!currentUnits)

endmethod

---------------------------------------------------------------------------------------
--method     : .createType1
--description: runs the hanger object create routines for a type 1 hanger only
---------------------------------------------------------------------------------------
define method .createType1(!oRest is MDSINTERFACEREST, !form is FORM, !hangerNo is REAL, !numOfHangers is REAL)

  -- Find current units and set the distance unit to metric
  !this.rest = !oRest
  !this.form = !form
  !this.vendorForm = !form.vendorForm
  !currentUnits = !!kgetsetunits()
  mm bore mm dist

  -- Initialise variables
  !datum       = !oRest.attaRef

  --------------------------------------------------------------------------------
  -- Make atta current element

  !ce = !!ce
  !!ce = !datum
  !attaName = !this.rest.ref.name.before('/REST')
  !attaRef = !attaName.dbref()
  !bore = pl bore
--  if(!this.rest.beamRefArray.unset() or (!this.rest.beamRefArray.size() eq 0)) then
--    !this.rest.initBeamRef()
--  endif
  !beamRefArray = !this.rest.beamRefArray

  !steelPrompt = 'Identify steelwork to connect hanger to'

  -- The beam ref array holds two place of each hanger
  if(!hangerNo leq 2) then
    --Points to the first hanger beam ref
    !beamRefIndex = 0
  else
    --Points to the second hanger beam ref
    -- !beamRefIndex = 2
    -- This was set to 2? which gave an error
    !beamRefIndex = 2
  endif

  !beamRefArray = !this.rest.beamRefArray
  !!mdsDacControl(TRUE)
  !beamRefIndex = !beamRefIndex + 1

  -- Create the fitting to the steel
  !fittRef = object DBREF()
  !newFittName = !this.setHangSteelType1(!attaRef, !steelPrompt, !fittRef, !beamRefArray[!beamRefIndex],!hangerNo)
  handle 1
    -- READ ONLY Access to the Section
    !!ce = !attaName.dbref()
    !!ce = !ce
    handle ANY
    endhandle
    !!kRestoreUnits(!currentUnits)
    return error 1 'Read only element' noalert
  elsehandle 2
    -- WRITE Access to the Section, BUT it is LOCKED
    !!ce = !attaName.dbref()
    !!ce = !ce
    handle ANY
    endhandle
    !!kRestoreUnits(!currentUnits)
    return error 2 'The Identified element is locked.' noalert
  elsehandle 99

    -- User has clicked the Escape key

    !!ce = !firstFittRef
    handle ANY
    endhandle
    !!ce = !secondFittRef
    handle ANY
    endhandle
    !!ce = !attaName.dbref()
    !!ce = !ce
    handle ANY
    endhandle
    !!kRestoreUnits(!currentUnits)
    return error 99 'user exit' noalert
  endhandle

  --REFACTOR THE BELOW STATEMENT MAY NOT BE ACCURATE FOR RECONNECTS INVESTIGATE <RM> 15/03/2010
  --REFACTOR this is not required because the beams are defined prior to entry into the hanger object and cannot change - start
  --!this.rest.beamRefArray[!beamRefIndex] = !newFittName.dbref().owner
  --REFACTOR this is not required because the beams are defined prior to entry into the hanger object and cannot change - end

  --REFACTOR dun1218 add test for whether or not this is a virtual fitting
  if !newFittName.eq('VIRTUALFITTING1') then
    !virtualFitting = TRUE
  else
    !virtualFitting = FALSE
  endif

  if !virtualFitting then
    !this.fitt = object MDSFITT(!!mdsHangerType1.virtualFitting)
  else
    !this.fitt = object MDSFITT(!newFittName.dbref())
  endif
  --REFACTOR dun1218 add test for whether or not this is a virtual fitting

  !!ce = !attaName.dbref()
  !errtext = ''
  !this.finalize(!attaName, !hangerNo, !numOfHangers)
  handle 1 9 51
    -- hanger is not vertical
    -- Unset the beamref so the user will be able to identify another beam
    if(!hangerNo eq 1) then
      !errtext = '$!!error.text'
    else
      !errtext = 'Hanger no. ' + STRING(!hangerNo - 1) + ' $!!error.text'
    endif
    !this.initForRestart(!hangerNo, !errtext)
    handle 51
      --we are going to restart the create process
      !!kRestoreUnits(!currentUnits)
      return error 51
    elsehandle NONE
      !!kRestoreUnits(!currentUnits)
    endhandle
  elsehandle ANY
    !!kRestoreUnits(!currentUnits)
    return error 90 |$!!error.text|
  endhandle

  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)

endmethod

---------------------------------------------------------------------------------------
--method     : .createType2
--description: runs the hanger object create routines for a type 2 hanger only
---------------------------------------------------------------------------------------
define method .createType2(!oRest is MDSINTERFACEREST, !form is FORM, !hangerNo is REAL, !numOfHangers is REAL)

  -- Find current units and set the distance unit to metric
  !this.rest = !oRest
  !this.form = !form
  !this.vendorForm = !form.vendorForm
  !currentUnits = !!kgetsetunits()
  mm bore mm dist

  -- Initialise variables
  !datum       = !oRest.attaRef

  --------------------------------------------------------------------------------
  -- Make atta current element
  !ce = !!ce
  !!ce = !datum
  !attaName = !this.rest.ref.name.before('/REST')
  !attaRef = !attaName.dbref()
  !bore = pl bore
  --if(!this.rest.beamRefArray.unset() or (!this.rest.beamRefArray.size() eq 0)) then
  --  !this.rest.initBeamRef()
  --endif
  !beamRefArray = !this.rest.beamRefArray

  -- The beam ref array holds two place of each hanger
  if(!hangerNo leq 2) then
    --Points to the first hanger beam ref
    !beamRefIndex = 0
  else
    --Points to the second hanger beam ref
    !beamRefIndex = 2
  endif

  --sort out the first and second channel fittings etc.
  !firstFittRef = !this.firstChannel(!hangerNo, !beamRefIndex, !attaRef, 2)
  if !firstFittRef.eq('VIRTUALFITTING1') then
    !firstFittRef = '!!mdsHangerType2.virtualFitting'
  endif
  !newFittName = !this.secondChannel(!hangerNo, !beamRefIndex, !attaRef, !firstFittRef, !form, 2)

  --REFACTOR THE BELOW STATEMENT MAY NOT BE ACCURATE FOR RECONNECTS INVESTIGATE <RM> 15/03/2010
  --REFACTOR this is not required because the beams are defined prior to entry into the hanger object and cannot change - start
  --!this.rest.beamRefArray[!beamRefIndex] = !newFittName.dbref().owner
  --REFACTOR this is not required because the beams are defined prior to entry into the hanger object and cannot change - end

  --REFACTOR dun1218 add test for whether or not this is a virtual fitting
  if !newFittName.eq('VIRTUALFITTING1') then
    !virtualFitting = TRUE
  else
    !virtualFitting = FALSE
  endif

  if !virtualFitting then
    --all of the data contained in the !newFittName virtual fitting need to be carried through to the rest of the application
    --presently !newFittName is stored as a global variable called !!<name>FITT2H1 however the virtual fitting is accessed by using
    --!!<name>FITTH1 so we need to copy the data from !!<name>FITT2H1 to !!<name>FITTH1
    !this.fitt = object MDSFITT(!!mdsHangerType2.virtualFitting)
  else
    !this.fitt = object MDSFITT(!newFittName.dbref())
  endif
  --REFACTOR dun1218 add test for whether or not this is a virtual fitting

  !!ce = !attaName.dbref()

  !errtext = ''
  !this.finalize(!attaName, !hangerNo, !numOfHangers)
  handle 1 9 51
    -- hanger is not vertical
    -- Unset the beamref so the user will be able to identify another beam
    if(!hangerNo eq 1) then
      !errtext = '$!!error.text'
    else
      !errtext = 'Hanger no. ' + STRING(!hangerNo - 1) + ' $!!error.text'
    endif
    !this.initForRestart(!hangerNo, !errtext)
    handle 51
      --we are going to restart the create process
      !!kRestoreUnits(!currentUnits)
      return error 51
    elsehandle NONE
      !!kRestoreUnits(!currentUnits)
    endhandle
  elsehandle ANY
    !!kRestoreUnits(!currentUnits)
    return error 90 |$!!error.text|
  endhandle

  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)

endmethod

---------------------------------------------------------------------------------------
--method     : .createType6
--description: runs the hanger object create routines for a type 6 hanger only
---------------------------------------------------------------------------------------
define method .createType6(!oRest is MDSINTERFACEREST, !form is FORM, !hangerNo is REAL, !numOfHangers is REAL)

  -- Find current units and set the distance unit to metric
  !this.rest = !oRest
  !this.form = !form
  !this.vendorForm = !form.vendorForm
  !currentUnits = !!kgetsetunits()
  mm bore mm dist

  -- Initialise variables
  !datum       = !oRest.attaRef

  --------------------------------------------------------------------------------
  -- Make atta current element

  !ce = !!ce
  !!ce = !datum
  !attaName = !this.rest.ref.name.before('/REST')
  !attaRef = !attaName.dbref()
  !bore = pl bore
  --if(!this.rest.beamRefArray.unset() or (!this.rest.beamRefArray.size() eq 0)) then
  --  !this.rest.initBeamRef()
  --endif
  !beamRefArray = !this.rest.beamRefArray

  !steelPrompt = 'Identify steelwork to connect hanger to'

  if !!mdsHangIf.eq('CPL') or !!mdsHangIf.eq('PSL') then
  else
    -- hanger supports the pipe from below. No steelwork fittings
    !errtext = ''
    !this.finalize(!attaName, !hangerNo, !numOfHangers)
    handle 1 9 51
      -- hanger is not vertical
      -- Unset the beamref so the user will be able to identify another beam
      if(!hangerNo eq 1) then
        !errtext = '$!!error.text'
      else
        !errtext = 'Hanger no. ' + STRING(!hangerNo - 1) + ' $!!error.text'
      endif
      !this.initForRestart(!hangerNo, !errtext)
      handle 51
        --we are going to restart the create process
        !!kRestoreUnits(!currentUnits)
        return error 51
      elsehandle NONE
        !!kRestoreUnits(!currentUnits)
      endhandle
    elsehandle ANY
      !!kRestoreUnits(!currentUnits)
      return error 90 |$!!error.text|
    endhandle

    !!mdsDacControl(FALSE)
    !!kRestoreUnits(!currentUnits)
    return
  endif

  -- The beam ref array holds two place of each hanger
  if(!hangerNo leq 2) then
    --Points to the first hanger beam ref
    !beamRefIndex = 0
  else
    --Points to the second hanger beam ref
    -- !beamRefIndex = 2
    -- This was set to 2? which gave an error
    !beamRefIndex = 2
  endif

  !beamRefArray = !this.rest.beamRefArray
  !!mdsDacControl(TRUE)
  !beamRefIndex = !beamRefIndex + 1

  -- Create the fitting to the steel
  !fittRef = object DBREF()
  !newFittName = !this.setHangSteelType6(!attaRef, !steelPrompt, !fittRef, !beamRefArray[!beamRefIndex],!hangerNo)
  handle 1
    -- READ ONLY Access to the Section
    !!ce = !attaName.dbref()
    !!ce = !ce
    handle ANY
    endhandle
    !!kRestoreUnits(!currentUnits)
    return error 1 'Read only element' noalert
  elsehandle 2
    -- WRITE Access to the Section, BUT it is LOCKED
    !!ce = !attaName.dbref()
    !!ce = !ce
    handle ANY
    endhandle
    !!kRestoreUnits(!currentUnits)
    return error 2 'The Identified element is locked.' noalert
  elsehandle 99

    -- User has clicked the Escape key
    !!ce = !firstFittRef
    handle ANY
    endhandle
    !!ce = !secondFittRef
