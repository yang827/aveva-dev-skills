      return error 1
    elsehandle 2
      !!kRestoreUnits(!currentUnits)
      return error 2
    elsehandle 51
      --re-identify the steelwork (replaces the /identify label as was
      !!mdspoppin(1)
      !!mdspoppin(3)
      !!mdspoppin(7)
      !!mdspoppin(8)
      !!mdspoppin(9)
      !beamGiven = FALSE
      !modifyFitting = FALSE
      skip
    elsehandle 99
      !!kRestoreUnits(!currentUnits)
      return error 99
    elsehandle NONE
      break
    endhandle
  enddo

  !!ce = !element
  !!kRestoreUnits(!currentUnits)

  !!mdspoppin(1)
  !!mdspoppin(3)
  !!mdspoppin(7)
  !!mdspoppin(8)
  !!mdspoppin(9)

  return !fittName.string()

endmethod
