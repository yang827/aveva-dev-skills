--
-- File:    MdsInterfaceHangerType.pmlobj
--   Type:    Object Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    A.boudjnah
-- Created:   Tue May 14th 2002
--
--
-- Description:
-- Multi Discipline Support MDSINTERFACEHANGERTYPE object.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  isHangerForBore(REAL)            BOOLEAN
--  isHangerForInsu(STRING)          BOOLEAN
--  mdsinterfacehangertype()         -
--  mdsinterfacehangertype(STRING)   -
--  setRotDefinition()               -
--

-- Define Object
define object MDSINTERFACEHANGERTYPE


  -- hangertype objects
  member .styp is STRING

  -- hangertype minimum allowed bore
  member .minBore is REAL

  -- hangertype maximum allowed bore
  member .maxBore is REAL

  -- Insulation only flag. If TRUE the hanger can only be used with insulated pipes
  member .insuOnly is BOOLEAN

  -- No Insulation only flag. If FALSE the hanger can only be used with un-insulated pipes
  member .noInsuOnly is BOOLEAN

  -- Filtering group.
  member .group is REAL

  -- Holds the assemblies definition for rotation for each hanger
  -- Each element in the array represents a rotation definition for an hanger
  -- Each element is an array of MDSINTERFACEHANGMEM objects
  member .rotDefinition is ARRAY

  -- Rotation definitin string taken from the :MDSHangRot attribute of the zone's template
  member .rotDefinitionString is STRING

  -- member. list of hanger members assemblies (Rotates as group)
  -- each componet represents a pack array for one hanger
  member .packs is ARRAY

  -- list of all available rod sizes in the catalog for this hanger configuration type.
  member .availableRodSizesInCatalog is ARRAY


  -- End object
endobject

define method .mdsinterfacehangertype()
  -- Default constructor
  !this.insuOnly = false
  !this.noInsuOnly = false
endmethod

define method .mdsinterfacehangertype(!styp is STRING)
  -- Creates an object for the given hanger type (e.g. FH01, VH02)
  -- Calls the default constructor

  !currentunits = !!kgetsetunits()
  mm bore mm dist
  !this.mdsinterfacehangertype()
  -- Go to hanger templates site
  !ce = !!ce
  !this.styp = !styp
  !this.group = !!ce.:MDSHangGroup
  !zoneName = '/MDS/$!styp'
  !zoneRef = !zoneName.dbref()
  handle any
    !!ce = !ce
    !!alert.error('Hanger template zone $!zoneName for hanger type $!styp does not exist. This zone is needed for the MDS hangers application.')
    !!kRestoreUnits(!currentUnits)
    return
  endhandle
  !!ce = !zoneRef
  !func = function
  if(!func.upcase().eq('INSU')) then
    !this.insuOnly = true
  elseif(!func.upcase().eq('NOINSU')) then
    !this.noInsuOnly = true
  endif
  -- 12/2002 <ab> To accelerate the loadin process
  --   the following 2 lines
  --  !rotDefinition = :MDSHangRot
  --  !this.setRotDefinition(!rotDefinition)
  --  were replace with one line. The loading of the rotation definition will be done when the user activate the rotate button
  !this.rotDefinitionString = :MDSHangRot

  first Restr
  handle any
    !!alert.error('Zone $!!ce.name is empty.')
    !!kRestoreUnits(!currentUnits)
    return
  endhandle
  !boreS = !!ce.name.after('/MDS/$!styp/')
  !this.minBore = !boreS.real()
  handle any
    !boreS = !boreS.before('/')
    !this.minBore = !boreS.real()
    handle any
      !!alert.error('Unable to determine bore from restraint name $!!ce.name')
      !!ce = !ce
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
  endhandle
  last restr
  !boreS = !!ce.name.after('/MDS/$!styp/')
  !this.maxBore = !boreS.real()
  handle any
    !boreS = !boreS.before('/')
    !this.maxBore = !boreS.real()
    handle any
      !!alert.error('Unable to determine bore from restraint name $!!ce.name')
      !!ce = !ce
      !!kRestoreUnits(!currentUnits)
      return
    endhandle
  endhandle
  !!ce = !ce
  !!kRestoreUnits(!currentUnits)
endmethod

define method .isHangerForBore(!bore is REAL) is BOOLEAN
  -- Returns true if the given bore is within the allowed bore range for this hanger type
  -- false if not.
  if(defined(!!mdsDEBUG))then
    !!mdsDEBUG.traceIn(3, '$!this.string()' + '.isHangerForBore($!bore is REAL) is BOOLEAN')
    !!mdsDEBUG.trace(3, 'Styp: $!this.styp Group: $!this.group Bore Range: $!this.minBore - $!this.maxBore')
    handle any
    endhandle
  endif
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  if(!this.minBore.set() and !this.maxBore.set() and (!bore ge !this.minBore and !bore le !this.maxBore)) then
    !!kRestoreUnits(!currentUnits)
    if(defined(!!mdsDEBUG))then
      !!mdsDEBUG.traceOutVal(3, '$!this.string()' + '.isHangerForBore($!bore is REAL) is BOOLEAN', 'true')
    endif
    return true
  endif
  !!kRestoreUnits(!currentUnits)
  if(defined(!!mdsDEBUG))then
    !!mdsDEBUG.traceIn(3, '$!this.string()' + '.isHangerForBore($!bore is REAL) is BOOLEAN')
  endif
  if(defined(!!mdsDEBUG))then
    !!mdsDEBUG.traceOutVal(3, '$!this.string()' + '.isHangerForBore($!bore is REAL) is BOOLEAN', 'false')
  endif
  return false
endmethod

define method .isHangerForInsu(!insuFilter is STRING) is BOOLEAN
  -- Returns true if this hanger type is suitable for the given insulation filter
  -- false if not.
  -- !insuFilter - insulation filter (e.g. '', 'INSU', 'NOINSU'
  !currentunits = !!kgetsetunits()
  mm bore mm dist
  if(!insuFilter.eq('INSU') and !this.insuOnly) then
    !!kRestoreUnits(!currentUnits)
    return true
  endif
  if(!insuFilter.eq('NOINSU') and !this.noInsuOnly) then
    !!kRestoreUnits(!currentUnits)
    return true
  endif
  if(!insuFilter.eq('INSU_NA') and (not !this.noInsuOnly) and (not !this.insuOnly)) then
    !!kRestoreUnits(!currentUnits)
    return true
  endif
  !!kRestoreUnits(!currentUnits)
  return false
endmethod

define method .setRotDefinition()
  -- !rotDefinition has the form:
  -- 1:false,1,2\2,3:false,1,2;true,3,4
  !this.rotDefinition = ARRAY()
  -- split into separate hangers definitions
  !perHanger = !this.rotDefinitionString.split(|\|)
  do !hangDef values !perHanger
    -- Loop through hanger/s having different definitions
    -- split hanger numbers from rotation pack definition
    !hangDat = !hangDef.split(':')
    -- get hanger numbers array for a rotation definition
    !hangNumbers = !hangDat[1].split(',')
    -- split rotation definition into packs
    !hangPacks = !hangDat[2].split(';')
    do !hangNum values !hangNumbers
      -- Loop through hangers sharing the same rotation definitions
      !members = object ARRAY()
      do !packNo indices !hangPacks
        !packArray = !hangPacks[!packNo].split(',')

        !canRotate = !packArray[1].boolean()
        do !i indices !packArray
          skip if(!i eq 1)
          skip if(!packArray[!i].real() eq 0)
          !hangmem = object MDSINTERFACEHANGMEM()
          !hangmem.packNo = !packNo
          !hangmem.canRotate = !canRotate
          !members[!packArray[!i].real()] = !hangmem
        enddo
      enddo
      !this.rotDefinition[!hangNum.real()] = !members
      !this.packs[!hangNum.real()] = !hangPacks
    enddo
  enddo

endmethod
