--
-- Author:    A.bOUDJNAH
-- Created:   Tue May 14th 2002
--
--
-- Description:
-- Multi Discipline Support mdsInterfaceHangerTypes object. Used as a container for all available hanger types.
-- It is also offer various services for the various hanger types (e.g. filtering the hanger type according to pipe
-- bore, pipe insulation and hanger groups
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsInterfaceHangerTypes()        -
--  mdsInterfaceHangerTypes(BOOLEAN) -
--  type18Selection(BOOLEAN)         ARRAY
--  type19Selection(BOOLEAN)         ARRAY
--  type1Selection(BOOLEAN)          ARRAY
--  type20Selection(BOOLEAN)         ARRAY
--  type21Selection(BOOLEAN)         ARRAY
--  type25Selection(BOOLEAN)         ARRAY
--  type2Selection(BOOLEAN)          ARRAY
--  type31Selection(BOOLEAN)         ARRAY
--  type32Selection(BOOLEAN)         ARRAY
--  type600Selection(BOOLEAN)        ARRAY
--  type6Selection(BOOLEAN)          ARRAY
--  type7Selection(BOOLEAN)          ARRAY
--

-- Define Object
define object MDSINTERFACEHANGERTYPES

  -- Holds the assemblies definition for rotation for each hanger
  -- Each element in the array represents a rotation definition for an hanger
  -- Each element is an array of KMDSHANGMEM objects
  member .rotDefinition is ARRAY

  -- hanger type objects
  member .objects is ARRAY

  -- hanger type styp name (e.g. FH01, VH19)
  member .names is ARRAY

  -- hanger type category name (e.g. VH, FH). Used to quickly filter lists according to type (VH or VH)
  member .categories is ARRAY

  -- Group number for hanger types that are connected to double channel beams
  member .doubleChannelGroupNo is REAL

  -- Group number for hanger types that are connected to one beam with one hanger
  member .oneBeamSingleHangerGroupNo is REAL

  -- Group number for hanger types that are connected to double channel beams
  member .doubleHangerGroupNoSingleBeam is REAL

  -- Group number for hanger types that are connected to double channel beams
  member .doubleHangerGroupNoDoubleChannel is REAL

  -- Group number for hanger types that are connected to double channel beams
  member .doubleHangerGroupNoCombined is REAL

  -- Group number for hanger types that are connected to an offset hanger
  member .beamOffsetHangerGroupNo is REAL

  -- Group number for hanger types that are connected to a pipe
  member .pipeHangerGroupNo is REAL

  --  Group number for hanger types that are supported from pipe bottom. No steelwork connection
  member .bottomSupportedGroupNo is REAL
  member .bottomSupportedSpringGroupNo is REAL

  --  Group number for hanger types that are supported from pipe bottom to steel
  member .dynamicGroupNo is REAL

  --  Group number for hanger types that are supported from pipe bottom to civil
  member .dynamicGroupNoCivil is REAL

  --  Group number for single civil hangers attachments.
  member .civilPlateGroupNo is REAL

  --  Group number for angulating spring to steel supports.
  member .angulatingSpringsSteelGroupNo is REAL

  --  Group number for angulating spring to civil supports.
  member .angulatingSpringsCivilGroupNo is REAL

  --  Group number for double civil hangers attachments.
  member .civilPlateDoubleHanger is REAL

  -- Array to hold the allowed beam type for each hangers group
  member .groupBeamTypes is ARRAY

  -- Current tube to be used for filtering
  member .tubeRef is DBREF

  -- Current beam references to be used for filtering
  member .beamRef is ARRAY

  -- stwall connection
  member .stwallconn is BOOLEAN

endobject

define method .mdsInterfaceHangerTypes()

  -- Default object constructor
  -- Define groups for filtering hanger types (Valid for variable and fixed hangers)

  !this.objects = ARRAY()
  !this.names = ARRAY()
  !this.categories = ARRAY()
  !this.stwallconn = FALSE

  !this.oneBeamSingleHangerGroupNo = 1
  !this.doubleChannelGroupNo = 2
  !this.doubleHangerGroupNoSingleBeam = 31
  !this.doubleHangerGroupNoDoubleChannel = 32
  !this.doubleHangerGroupNoCombined = 33
  !this.beamOffsetHangerGroupNo = 4
  !this.pipeHangerGroupNo = 5
  !this.bottomSupportedGroupNo = 6
  !this.bottomSupportedSpringGroupNo = 600
  !this.dynamicGroupNo = 7
  !this.dynamicGroupNoCivil = 20
  !this.angulatingSpringsSteelGroupNo = 21
  !this.angulatingSpringsCivilGroupNo = 25
  !this.civilPlateGroupNo = 18
  !this.civilPlateDoubleHanger = 19
  !this.groupBeamTypes[!this.oneBeamSingleHangerGroupNo] = |('BEAM','DINI','BSC','DINU','DBEA','CHNI','CHNU','BOX','DINP','JISU','PLAT')|
  !this.groupBeamTypes[!this.doubleChannelGroupNo] = |('BSC-BSC','DINU-DINU','CHNU-CHNU','DINP-DINP','JISU-JISU')|
  !this.groupBeamTypes[!this.doubleHangerGroupNoSingleBeam] = |('BEAM','DINI','BSC','DINU','DBEA','CHNI','CHNU','BOX','DINP','JISU','PLAT')|
  !this.groupBeamTypes[!this.doubleHangerGroupNoDoubleChannel] = |('BSC-BSC','DINU-DINU','CHNU-CHNU','DINP-DINP','JISU-JISU')|
  !this.groupBeamTypes[!this.doubleHangerGroupNoCombined] = |('BEAM','DINI','BSC','DINU','BSC-BSC','DINU-DINU','CHNU-CHNU','DBEA')|
  !this.groupBeamTypes[!this.beamOffsetHangerGroupNo] = |('BEAM','DINI','BSC','DINU','DBEA','CHNI','DINP','JISU','BOX','PLAT')|
  !this.groupBeamTypes[!this.pipeHangerGroupNo] = |()|
  if(defined(!!mdsHangIf)) then
    if !!mdsHangIf.eq('CPL') then
      !this.groupBeamTypes[!this.bottomSupportedGroupNo] = |('BEAM','DINI','BSC','DINU','DBEA','CHNI','DINP','JISU','BOX','PLAT')|
    elseif !!mdsHangIf.eq('PSL') then
      !this.groupBeamTypes[!this.bottomSupportedGroupNo] = |('BEAM','DINI','BSC','DINU','DBEA','CHNI','DINP','JISU','BOX','PLAT')|
    endif
  else
    !this.groupBeamTypes[!this.bottomSupportedGroupNo] = |()|
    !this.groupBeamTypes[!this.bottomSupportedSpringGroupNo] = |()|
  endif
  !this.groupBeamTypes[!this.dynamicGroupNo] = |('BEAM','DINI','BSC','DINU','DBEA','CHNI','CHNU','DINP','JISU','BOX','PLAT')|
  !this.groupBeamTypes[!this.dynamicGroupNoCivil] = |('FLOOR','PANE','WALL')|
  !this.groupBeamTypes[!this.angulatingSpringsSteelGroupNo] = |('BEAM','DINI','BSC','DINU','DBEA','CHNI','CHNU','DINP','JISU','BOX','PLAT')|
  !this.groupBeamTypes[!this.angulatingSpringsCivilGroupNo] = |('FLOOR','PANE','WALL')|
  !this.groupBeamTypes[!this.civilPlateGroupNo] = |('FLOOR','PANE')|
  !this.groupBeamTypes[!this.civilPlateDoubleHanger ] = |('FLOOR','PANE')|

endmethod

define method .mdsInterfaceHangerTypes(!dummyrefresh is BOOLEAN)
  -- Constructor to create an empty or a populated mdsInterfaceHangerTypes container
  -- !refresh - a flag. Is true, reload the object from the design templates
  --            if false create an empty object
  -- Call the default constructor
  !this.mdsInterfaceHangerTypes()
endmethod

--------------------------------------------------------------------------------------------------------------
------------REFACTOR METHODS BELOW ARE NEW TO ENABLE SIMPLE SELECTION FOR EACH HANGER TYPE--------------------
--------------------------------------------------------------------------------------------------------------
define method .type1Selection(!fromAtta is BOOLEAN) is ARRAY

  --if fromAtta is true then we are creating a hanger from an existing preliminary support atta, therefore the tube selection part of !!mdsSelectTypeXX is not required
  if !fromAtta then
    !idTube = FALSE
  else
    !idTube = TRUE
  endif

  --make any selections required for the type 1 hanger configuration i.e. single hanger to bottom of single beam
  !returnArray = !!mdsSelectType1(!idTube)
  handle 1
    --handle any errors that are returned by the selection routines
    if !!error.text.match('61,528').gt(0) then
      !!alert.message('hanger creation aborted by the user')
    else
      --dun1218 if we have the vertical configuration message then we don't print out another error message as this one has already been given.
      if !!error.text.upcase().neq('CANNOT IDENTIFY A VERTICAL PIPE IN THIS CONFIGURATION') then
        !!alert.error(!!error.text + ' - hanger creation aborted')
      endif
    endif
    !returnArray = object ARRAY()
  endhandle
  return !returnArray

endmethod

