------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  backUpOriginalRest(STRING)       -
--  checkTubeAccess()                -
--  checkTubeSlope()                 -
--  commonUpdate(FORM,STRING,STRING,BOOLEAN) -
--  create(FORM,FORM)                -
--  createAtta(STRING,FORM)          -
--  createRest(STRING,STRING)        -
--  finalize(FORM)                   -
--  getTubeRef()                     DBREF
--  identify(STRING,STRING,STRING)   DBREF
--  initTubeRef()                    -
--  mdsInterfaceRest()               -
--  mdsInterfaceRest(DBREF,BOOLEAN)  -
--  mdsInterfaceRest(FORM)           -
--  mdsInterfaceRest(STRING)         -
--  modify(FORM,FORM)                -
--  saveRestAsTemp(STRING)           -
--  setConnectionRefs(FORM)          -
--  setRestObject()                  -
--  setTubeBore()                    -
--  setTubeDir()                     -
--  updateAtta(STRING,STRING,BOOLEAN,FORM) -
--  updateRest(STRING,STRING)        -
--

-- Define Object
define object MDSINTERFACEREST

  -- member restraint name
  member .name is STRING

  -- member restraint styp (e.g.'VH63')
  member .styp is STRING

  -- member restraint old styp (e.g.'VH61')
  member .oldStyp is STRING

  -- member restraint ref
  member .ref is DBREF

  -- member hangers. List of hangers owned by the mdsInterfaceRest object
  member .hangers is ARRAY

  -- Has the Member Been Reconnected
  member .reconnected is BOOLEAN

  member .beamRefArray is ARRAY

  member .tubeRef is DBREF

  -- Dummy atta which has the same name as the rest. not necessarily the one that the hanger is connected to
  member .attaRef is DBREF

  -- Standard support atta to which the hanger is connected to. Could be a weld elbow lug or trunnion
  member .attaConnRef is DBREF

  member .attaConnRefLocked is BOOLEAN

  -- The identified .tubeRef leave bore
  member .bore is BORE

  -- The identified .tubeRef leave direction
  member .pldir is DIRECTION

  -- Mode of rest handling. Can be either 'MODIFY' or 'CREATE'
  member .mode is STRING

  -- Is it a newly created rest
  member .new is BOOLEAN

  -- Current rest rod size
  member .rodSize is REAL

  -- New required rod size
  member .newRodSize is REAL

  -- Current channel span size for beam channel assembly or a double hanger spring (B11, B13, B14)
  member .channelSpan is REAL

  -- required new channel span size for beam channel assembly or a double hanger spring (B11, B13, B14)
  member .newChannelSpan is REAL

  -- Reference to the rest pipe clamps (generally there is only one pipe clamp per rest)
  member .pipeClampsRefs is ARRAY

  -- End object
endobject

define method .mdsInterfaceRest()
  --REFACTOR THIS USED TO CALL INITBEAMREF AND INITTUBEREF BUT THESE ARE NOT REQUIRED
endmethod

define method .mdsInterfaceRest(!callingForm is FORM)
endmethod

define method .mdsInterfaceRest(!styp is STRING)
  !this.styp = !styp
endmethod

define method .mdsInterfaceRest(!rest is DBREF, !withMembers is BOOLEAN)
  -- If withMembers is FALSE only the rest object is created without its members
  !this.mdsInterfaceRest()
  !this.ref = !rest
  !this.name = !rest.name
  -- set the attaRef data
  !attaName = !rest.name.before('/REST')
  !attaRef = !attaName.dbref()

  handle ANY
  elsehandle NONE
    !this.attaRef = !attaRef
    !this.tubeRef = !attaRef
    !this.styp = !attaRef.styp
  endhandle
  -- set the attaConnRef
  !ce = !!ce
  -- goto the rest
  !!ce = !rest
  -- goto to first hanger
  hang1
  handle ANY
  elsehandle NONE
    !attaConnRef = !!ce.href
    !!ce = !attaConnRef
    handle ANY
    elsehandle NONE
      !this.attaConnRef = !attaConnRef
    endhandle
  endhandle
  !!ce = !ce
  if(not !withMembers) then
    return
  else
    -- create the hanger objects
  endif
endmethod

define method .modify(!form is FORM, !callingForm is FORM)

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist

  !ce = !!ce

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist

  -- Initialise variables

  !support     = !form.support
  !tubeType    = !!mdsoptions.pipes
  !this.attaRef = !form.support.datum
  !name        = !form.name.val
  !alias       = !form.support.alias
  !ceComp      = !!ce
  !formName    = '!!' & !form

  !!ce = !this.attaRef

  -- Perform actions that are common to the modify and create modes
  !this.commonUpdate(!form, !name, !alias, FALSE)
  handle 99
    !!kRestoreUnits(!currentUnits)
    return error 99
  elsehandle 1 2 3 4 5 6 10 90
    !!kRestoreUnits(!currentUnits)
    return error 90 |$!!error.text|
  elsehandle ANY
    !!kRestoreUnits(!currentUnits)
    !err = !!error.text + ' ' + !!error.command.before('***')  + ' ' + !!error.line.before('***')
    return error 100 |$!err|
  endhandle
  !!kRestoreUnits(!currentUnits)

endmethod

define method .create(!form is FORM, !callingForm is FORM)

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist
  !ce = !!ce

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist

  -- Initialise variables

  !support     = !form.support
  !tubeType    = !!mdsoptions.pipes
  !this.attaRef = !form.support.datum
  !name        = !form.name.val
  !styp      = !form.support.alias
  !ceComp      = !!ce
  !formName    = '!!' & !form

  !this.new = TRUE
  !form.support.rest = !this

  -- Copy the connection ref from the calling form to this object

  !this.setConnectionRefs(!callingForm)
  !form.support.rest = !this

  -- rest the .oldSupport so the newly created rest objects and data will be saved

  !form.oldSupport = object MDSINTERFACESUPPORT()

  -- Perform actions that are common to the modify and create modes

  !this.commonUpdate(!form, !name, !styp, TRUE)
  handle 99
    -- Update the form support atta array, so !this.cancelHanger will add the atta
    -- to the delete list
    !form.support.datum = !this.attaRef
    !form.support.atta.append(!this.attaRef)
    !!kRestoreUnits(!currentUnits)
    return error 99
  elsehandle 1 2 3 4 5 6 10 90
    -- Update the form support atta array, so !this.cancelHanger will add the atta
    -- to the delete list
    !form.support.datum = !this.attaRef
    !form.support.atta.append(!this.attaRef)
    !!kRestoreUnits(!currentUnits)
    return error 90 |$!!error.text|
  elsehandle 51
    -- user accepted error
    -- continue
  elsehandle ANY
    -- Update the form support atta array, so !this.cancelHanger will add the atta
    -- to the delete list
    !form.support.datum = !this.attaRef
    !form.support.atta.append(!this.attaRef)
    !!kRestoreUnits(!currentUnits)
    !err = !!error.text + ' ' + !!error.command.before('***')  + ' ' + !!error.line.before('***')
    return error 100 |$!err|
  endhandle

  -- Update the form support atta array.

  !form.support.datum = !this.attaRef
  !form.support.atta.append(!this.attaRef)
  !!kRestoreUnits(!currentUnits)

endmethod

define method .initTubeRef()
  !this.tubeRef = object DBREF()
endmethod

define method .setConnectionRefs(!callingForm is FORM)

  if(!callingForm eq !!mdsInterfaceHanger) then
    -- tube ref and beam/beams ref are given by the calling form
    !this.tubeRef = object DBREF()
    if(!callingForm.tubeRef.set() and (not !callingForm.tubeRef.badref())) then
      !this.tubeRef = !callingForm.tubeRef
    endif

    if(!callingForm.beamRef.set()) then
      !this.beamRefArray = !callingForm.beamRef
    endif
  endif

endmethod

define method .checkTubeAccess()

  -- Check if we can write to the pipe
  !currentUnits = !!kGetSetUnits()
  mm bore mm dist
  !write = STRING()
  !lock  = STRING()
  if (!!kcheckwrite(!this.tubeRef, !lock , !write).not()) then
    if (!write.eq('R')) then
      -- READ ONLY Access
      !!kRestoreUnits(!currentUnits)
      return error 1 'The Identified element is in a read only database.'
    elseif (!lock.eq('Locked')) then
      -- WRITE Access, BUT it is LOCKED
      !this.attaConnRefLocked = !!ce.lock
      !!kRestoreUnits(!currentUnits)
    endif
  endif
  !!kRestoreUnits(!currentUnits)

endmethod

define method .createAtta(!name is STRING, !form is FORM)

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist
  -- Hanger atta
  !!mdsDacControl(TRUE)

    --P-37906 allow bottle jack connection to vertical trunnion for CPL - for vertical trunnions only we want the atta at the last mem of the trunnion bran
    --note that this is a workaround and is intended to fool witchhanger into thinking it is creating a pedestal support on a
    --horizontal line. proper integration is required to allow these types of support to be built but this is adequate for a quick fix - start
    --i have tried to minimise the impact of this by doing the following
    --1) restricting to !!mdsHangIf = CPL only
    --2) ensuring that the atta pipe is a trunnion
    --3) ensuring that the atta pipe is vertical
    --4) ensuring that the config type is 6
    if !!mdsHangIf.eq('CPL') and !!mdsInterfaceHanger.configNumber.real().eq(6) then
      !trunnion = !!ce.owner.:MDSTrun
      handle ANY
        !trunnion = FALSE
      endhandle
      if !trunnion then
        if !!ce.ldir.up.gt(0.95) or !!ce.ldir.up.lt(-0.95) then
          --navigate to the last mem of the trunnion and create the atta
          own
          last mem
          if !form.support.preliminaryStore.set() then
            !!ce = !this.attaRef
          else
            new atta
            !this.attaRef = !!ce
          endif
          !this.attaConnRef = !!ce
        else
          if !form.support.preliminaryStore.set() then
            !!ce = !this.attaRef
          else
            new atta
            !this.attaRef = !!ce
          endif
          !this.attaConnRef = !!ce
        endif
      else
        if !form.support.preliminaryStore.set() then
          !!ce = !this.attaRef
        else
          new atta
          !this.attaRef = !!ce
        endif
        !this.attaConnRef = !!ce
      endif
    else
      if !form.support.preliminaryStore.set() then
        !!ce = !this.attaRef
      else
        new atta
        !this.attaRef = !!ce
      endif
      !this.attaConnRef = !!ce
    endif
    --P-37906 allow bottle jack connection to vertical trunnion for CPL - for vertical trunnions only we want the atta at the last mem of the trunnion bran
    --note that this is a workaround and is intended to fool witchhanger into thinking it is creating a pedestal support on a
    --horizontal line. proper integration is required to allow these types of support to be built but this is adequate for a quick fix - end

  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)

endmethod

define method .updateAtta(!name is STRING, !styp is STRING, !newAtta is BOOLEAN, !form is FORM)

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist
  !ce = !!ce

  !!ce = !this.attaRef
  !!mdsDacControl(TRUE)

  -- Hanger has its own real atta. This atta has the same name as the hanger
  if(!newAtta) then
    name /$!name
    handle ANY
      !errNo = 2
      !errText = 'Support Name already exists'
      !!ce = !ce
      !!mdsDacControl(FALSE)
      !!kRestoreUnits(!currentUnits)
    endhandle
  endif

  spkbrk TRUE

  !this.oldStyp = styp
  handle ANY
    -- new atta. Not yet selected
  endhandle
  select spref with styp '$!styp' spec /MDS
  handle ANY
    !boreString = !this.bore.real().string()
    !errNo = 1
    !errText = 'Identified tube bore $!boreString$nmm is not in the standard bores for this hanger type'
    !!ce = !ce
    !!mdsDacControl(FALSE)
    !!kRestoreUnits(!currentUnits)
  endhandle

  -->>--<wd>june2003
  -- Set the new ATTA ISPE attribute to that of the Previous Component or Branch Head <if set>.
  !hAtta = !!ce
  !!mdssetispe()
  !!ce = !hAtta
  --<<--<wd>june2003

  sel lstu
  shop FALSE
  :MDSSuppType '$!styp'
  -- stext '$!name'
  call !!mdsTransport(!!ce,!name)
  !!mdsDacControl(TRUE)
  :MDSMatRef /CARBON/STEEL
  handle ANY
    !errNo = 3
    !errText = 'Material /CARBON/STEEL is not defined. Please check your Propcon Database.'
    !!ce = !ce
    !!mdsDacControl(FALSE)
    !!kRestoreUnits(!currentUnits)
    return error $!errNo |$!errText|
  endhandle
  !mtoc = !!mdsparmh01[0].shop
  handle ANY
  elsehandle NONE
    if !mtoc.unset() then
    elseif !mtoc.not() then
      !hAtta.mtoc = 'off'
    elseif !mtoc then
      !hAtta.mtoc = 'on'
    endif
  endhandle

  --<sk> this changes position of atta so do not call on preliminary
  if (not !form.support.preliminaryStore.set()) then
    fconn
  endif
  !!ce = !ce
  refresh

  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)

endmethod

define method .createRest(!name is STRING, !styp is STRING)

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist
  !!mdsDacControl(TRUE)

  !zone = !!mdsDefaultSite.siteForHangers.selection('Dtext')
  !zoneName = '/' + !zone
  !!ce = !zoneName.dbref()
  handle (2,109) (2,813)
    -- if zone is not selected in !!mdsDefaultSite or does not exist, create REST inside PIPE
      pipe
  endhandle

  last mem
  handle (41,66) (2,113)
  endhandle

  new restr
  handle ANY
    !!kRestoreUnits(!currentUnits)
    return error 1 '$!!error.text'
  endhandle

  !this.ref = !!ce
  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)

endmethod

define method .updateRest(!name is STRING, !styp is STRING)

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist
  !ce = !!ce
  !!ce = !this.ref

  !!mdsDacControl(TRUE)
  !x = !name
  name /$!name/REST

  !boreString = !this.bore.real().string()
  --<wd>sep2003
  -- !boreString for 80mm bore pipe is returned by the line above
  -- INCORRECTLY by CORE PDMS as 76.2 and NOT 80
  if (!boreString inset ('76.2')) then
    !boreString = '80'
  endif
  --<wd>sep2003

  !tempName =  '/$!name/REST/TEMP'
  !unusedTempRef = !tempName.dbref()
  handle ANY
    -- there is no temporary rest
    -- copy the rest from the template
    !tempExists = FALSE
  elsehandle NONE
    -- we have a temporary rest
    -- we will copy it to keep the latest modifications made to the rest
    !tempExists = TRUE
  endhandle
  if((not !tempExists)) then
    refresh
    if ( defined(!!manif.exe)) then
      if (!!manif.exe.exists()) then
        if  (!!mdsHangIf.upcase().neq('MDS')) then
          if  (!styp eq 'MH01') then
            /$!x/REST
            purp MDS
            new hang name /$!x/H1
            return
          endif
        endif
      endif
    endif

    !bore = pl bore of 1 of hang1
    handle (2,113) $* list exhausted for HANGER
      -- List exhausted
      -- hanger does not have members (e.g. First hanger of doubleBM1Spring)
    elsehandle NONE
      !this.rodSize = !bore.real()
    endhandle

  else
    -- there is a temporary rest
    -- we will copy it to keep the latest modifications made to the rest
    rem $!tempName
    copy $!tempName ren /$!name/TEMP /$!name

    handle ANY
      !!kRestoreUnits(!currentUnits)
      !errText = 'Unable to copy the temporary restraint "$!tempName". Please check if it exists'
      return error 3 '$!errText'

    endhandle
  endif
  purp MDS
  -- to be done
  -- update the .rodSize value from the pl of first comp of the first hanger
  !!ce = !ce
  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)

endmethod

define method .setTubeBore()

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist
  !!ce = !this.tubeRef
  if (!!ce.type eq 'BRAN') then
    !pl = 'ph'
  else
    !pl = 'pl'
  endif
  !bore = $!pl bore
  -- In order to cater for catalogue with actual bores as parameter 1 get the nearest bore
  !bore = !bore.real().nearestbore().string().before('mm').bore()
  !this.bore =  !bore

  !!kRestoreUnits(!currentUnits)

endmethod

define method .setTubeDir()

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist
  !!ce = !this.tubeRef
  if (!!ce.type eq 'BRAN') then
    !pl = 'ph'
  else
    !pl = 'pl'
  endif
  !this.pldir = $!pl dir wrt /*
  !!kRestoreUnits(!currentUnits)

endmethod

define method .checkTubeSlope()

  -- Check that the pipe slope is within allowed limits
  !currentUnits = !!kGetSetUnits()
  mm bore mm dist
  !uDir = object DIRECTION('U')
  !angle = !this.pldir.angle(!uDir)

  if !angle gt 100 then
    !angle = !this.pldir.opposite().angle(!uDir)
  endif

  -----------------------------
  --<wd>22jul2004
  -- CHECK for Manufacturers Interface - * STYP = 'MH01' * stored in the <mdsInterfaceRest> object member '!this.styp' and
  -- CHECK if the <mdsInterfaceRest> object member value of '!this.pldir' is 'UP or DOWN wrt /*' - i.e. a VERTICAL PIPE
  if !this.styp inset ('MH01') and !this.pldir.string().eq('U WRT /*') or !this.pldir.string().eq('D WRT /*') or !this.pldir.string().eq('Z WRT /*') or !this.pldir.string().eq('-Z WRT /*') then
    -- Set !deltaAngle to suit a VERTICAL PIPE as for the '!this.styp' shown in the 'if' statement above
    !deltaAngle = !angle
    --<wd>22jul2004
    -----------------------------
  else
    -- an inline atta. The direction should be horizontal
    !deltaAngle = abs(90 - !angle)
  endif

  if !!mdsHangIf.upcase().eq('LISEGA') then
    -- <RM> 30/01/07 -- added the config 7 check so that steelwork hanger types can be used with pipe slopes greater than 60 degrees
    -- this has been done for FRAMATOME so if any problems occur it will put in a specific FRAMATOME check.
    if !!mdsInterfaceHanger.configNumber.real().eq(20) or !!mdsInterfaceHanger.configNumber.real().eq(25) or !!mdsInterfaceHanger.configNumber.real().eq(7) then
      !maxSlopeError = 90
    else
      !maxSlopeError = 60
    endif
    -- <RM> 30/01/07 -- end of fix
  else
    !maxSlopeError = !!mdsoptions.maxpiva.real()
  endif

  !maxSlopeWarning = !!mdsoptions.maxpwar.real()
  if(!deltaAngle gt !maxSlopeError) then
    !!kRestoreUnits(!currentUnits)
    return error 1 'Tube angle has a $!deltaAngle slope. This is more than the maximum allowed $!maxSlopeError angle.'
  elseif(!deltaAngle gt !maxSlopeWarning) then
    !answ = !!alert.confirm('Tube angle has a $!deltaAngle slope. This is more than the maximum recommended $!maxSlopeWarning angle. Do you want to continue?')
    if(!answ.eq('NO')) then
      !!kRestoreUnits(!currentUnits)
      return error 2 'Tube angle has a $!deltaAngle slope. This is more than the maximum recommended $!maxSlopeWarning angle. User continued'
    endif
  endif

  !!kRestoreUnits(!currentUnits)

endmethod

define method .commonUpdate(!form is FORM, !name is STRING, !styp is STRING, !newAtta is BOOLEAN)

  !ce = !!ce
  !currentUnits = !!kGetSetUnits()
  mm bore mm dist

  !this.styp = !styp
  !currentRodSize = !this.rodSize
  !form.support.rest = !this
  !!ce = !this.getTubeRef()
  handle 99
    -- User exit
    prompt on
    refresh
    !errNo = 99
    !errText = ''
    !!ce = !ce
    !!kRestoreUnits(!currentUnits)
    aid clear line 5
    handle ANY
    endhandle
    refresh
    return error $!errNo |$!errText|
  elsehandle ANY
    !errNo = 10
    !errText = !!error.text + ' ' + !!error.line.before('***')
    !!ce = !ce
    !!kRestoreUnits(!currentUnits)
    aid clear line 5
    handle ANY
    endhandle
    refresh
    return error $!errNo |$!errText|
  endhandle
  !form.support.rest = !this

  -- Check the access rights for the pipe
  !this.checkTubeAccess()
  handle ANY
    !errNo = 2
    !errText = !!error.text + ' ' + !!error.line.before('***')
    !!ce = !ce
    !!kRestoreUnits(!currentUnits)
    aid clear line 5
    handle ANY
    endhandle
    refresh
    return error $!errNo |$!errText|
  endhandle

  forward

  --------------------------------------------------------------------------------
  -- Check if element identified is suitable for this type of base support
  --------------------------------------------------------------------------------
  !this.setTubeBore()

  !form.support.rest = !this
  !this.setTubeDir()
  !form.support.rest = !this
  -- Get Session Bore Units


  if(!!kGetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif

  if undefined(!!licadautotestenabled) then
    !this.checkTubeSlope()
    handle 2
      !!ce = !ce
      !!kRestoreUnits(!currentUnits)
      aid clear line 5
      handle ANY
      endhandle
      refresh
    elsehandle ANY
      !errNo = 3
      !errText = !!error.text
      !!ce = !ce
      !!kRestoreUnits(!currentUnits)
      aid clear line 5
      handle ANY
      endhandle
      refresh
      return error $!errNo |$!errText|
    endhandle
  endif

  --< tm note this is where it creates the atta current element is the trunnion sref atta
  -- q var !!ce

  if(!newAtta) then
    !this.createAtta(!name, !form)
    handle ANY
      !form.support.rest = !this
      !form.support.datum = !this.attaRef
      !errNo = 4
      !errText = !!error.text
      !!ce = !ce
      !!kRestoreUnits(!currentUnits)
      aid clear line 5
      handle ANY
      endhandle
      refresh
      return error $!errNo |$!errText|
    endhandle
  endif
  !form.support.rest = !this
  !form.support.datum = !this.attaRef

  !this.updateAtta(!name, !styp, !newAtta, !form)
  handle ANY
    !errNo = 5
    !errText = !!error.text + ' ' + !!error.line.before('***')
    !!ce = !ce
    !!kRestoreUnits(!currentUnits)
    aid clear line 5
    handle ANY
    endhandle
    refresh
    return error $!errNo |$!errText|
  endhandle
  !form.support.rest = !this

  !!ce = !this.attaRef

  pipe

  if(not !newAtta) then
    -- in modify mode
    -- we rename the original rest to be able to create a new rest with the same name
    !this.saveRestAsTemp(!name)
    !this.backUpOriginalRest(!name)
    !form.support.rest = !this
  endif
  !this.createRest(!name, !styp)
  handle ANY
    !errNo = 2
    !errText = !!error.text
    !!ce = !ce
    !!kRestoreUnits(!currentUnits)
    aid clear line 5
    handle ANY
    endhandle
    refresh
    return error $!errNo |$!errText|
  endhandle
  !form.support.rest = !this
  !this.updateRest(!name, !styp)
  handle 3
    !errNo = 6
    !errText = !!error.text + ' ' + !!error.line.before('***')
    !!ce = !ce
    !!kRestoreUnits(!currentUnits)
    aid clear line 5
    handle ANY
    endhandle
    refresh
    return error $!errNo |$!errText|
  elsehandle ANY
    !errNo = 90
    !errText = !!error.text + ' ' + !!error.line.before('***')
    !!ce = !ce
    !!kRestoreUnits(!currentUnits)
    aid clear line 5
    handle ANY
    endhandle
    refresh
    return error $!errNo |$!errText|
  endhandle

  if (!!mdsInterfaceHanger.configNumber.string() inset ('6') or !!mdsInterfaceHanger.configNumber.string() inset ('600')) then
    if ( defined(!!manif.exe)) then
      if (!!manif.exe.exists()) then
        if !!mdsHangIf.eq('CPL') then
        elseif !!mdsHangIf.eq('PSL') then
        else
          return
        endif
      endif
    endif
  endif

  !form.support.rest = !this
  if(not !this.newRodSize.set()) then
    !this.newRodSize = !currentRodSize
  endif
  if(!this.newRodSize.set() and (!this.newRodSize neq !this.rodSize)) then
    !this.changeRodSize()
    handle ANY
      !errNo = 90
      !errText = !!error.text + ' ' + !!error.line.before('***')
      !!ce = !ce
      !!kRestoreUnits(!currentUnits)
      aid clear line 5
      handle ANY
      endhandle
      refresh
      return error $!errNo |$!errText|
    endhandle
  endif
  !this.newRodSize = REAL()

  ---------->Addition to common update

  -- Set the from support datum and atta values
  -- !form.resizeHanger uses these values to calculate the rod lengths limits
  !form.support.datum = !this.attaRef
  !form.support.atta = ARRAY()
  !form.support.atta.append(!this.attaRef)
  !form.support.atta.unique()
  -- Default number of hangers per Rest for all support type
  !numOfHangers = 1

  --if !!mdsInterfaceHanger.configNumber.string() inset ('19','31','32') then
  --  !numOfHangers = 2
  --endif
  -- Create the hangers
  !hangers = ARRAY()
  do !i to !numOfHangers

    !oHang = object MDSINTERFACEHANG()
    !oHang.create(!this, !form, !i, !numOfHangers)
    handle 99
      -- user exit
      !errNo = 99
      !errText = !!error.text
      !!ce = !ce
      !!kRestoreUnits(!currentUnits)
      aid clear line 5
      handle ANY
      endhandle
      refresh
      return error $!errNo |$!errText|
    elsehandle ANY
      -- Q VAR !!error
      !errNo = 90
      !errText = !!error.text
      !!ce = !ce
      !!kRestoreUnits(!currentUnits)
      aid clear line 5
      handle ANY
      endhandle
      refresh
      return error $!errNo |$!errText|
    endhandle

    !this = !oHang.rest
    !hangers.append(!oHang)
  enddo

  !this.hangers = !hangers
  !form.support.rest = !this

  if(!this.hangers.size() eq 3) then
    -- delete the fitting of the first hanger.
    -- Only the two last hangers are connected directly to a fitting
    /$!name/FITT/H1
    handle ANY
      /$!name/SBFI/H1
      delete sbfi
    endhandle
    delete fitt
    handle ANY
    endhandle
  elseif (!this.hangers.size() eq 2) then
    !oriRef = ref
    $!oriRef
  endif
  -- <ab> check if doest not keep redundant data for styp

  !this.styp = !this.attaRef.styp

  !form.support.rest = !this

  !this.finalize(!form)
  !form.support.rest = !this

  if(!form.graphicalDim)then
    !!mdsSetDim(!form)
    !!mdsSetDim(!form)
  endif

  !!ce = !ce
  !!kRestoreUnits(!currentUnits)
  aid clear line 5
  handle ANY
  endhandle
  refresh

endmethod

define method .finalize(!form is FORM)

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist

  -- Update the support member array
  --    !form.support.rest = object mdsInterfaceRest()
  !support = !form.setRestObject()
  --!support = !form.setSupportPacks()
  !form.support = !support
  -- Activate/Deactivate gadgets
  !form.datum.active = FALSE
  -- Saving hanger state to be able to restore it later

  !!mdsSaveHangerState(!form)

  !!kRestoreUnits(!currentUnits)
  refresh
  return
endmethod

define method .backUpOriginalRest(!name is STRING)

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist
  !!mdsDacControl(TRUE)

  -- rename current REST
  /$!name/REST/BACKUP
  handle ANY
    -- first time backup
    -- rename the original for later restoration
    /$!name/REST
    ren all /$!name /$!name/BACKUP
    name /$!name/REST/BACKUP
    rem ce
  elsehandle NONE
    -- The original have been renamed already
    -- Delete the last created temporary rest
    rem ce
    /$!name/REST
    delete restr
  endhandle

  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)

endmethod

define method .saveRestAsTemp(!name is STRING)
  -- Creates a temporary copy of the current REST
  !currentUnits = !!kGetSetUnits()
  mm bore mm dist
  !!mdsDacControl(TRUE)

  -- rename current REST
  /$!name/REST/TEMP
  handle ANY
    -- first time for making a temp
    /$!name/REST
    new rest copy /$!name/REST ren /$!name /$!name/TEMP
    name /$!name/REST/TEMP

  elsehandle NONE
    -- Delete the last created temporary rest
    delete restr mem
    copy /$!name/REST ren /$!name /$!name/TEMP

  endhandle
  rem ce

  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)

endmethod

define method .getTubeRef() is DBREF

  !currentUnits = !!kGetSetUnits()
  mm bore mm dist

  -- Hanger needs an atta to be created
  !typeToIdentify = 'TUBE'
  !typeToPrompt = 'Tube'
  !matchingStyp = '(||)'
  if(!this.tubeRef.set() and (not !this.tubeRef.badref())) then

    !!ce = !this.tubeRef
    -- Check that the current connection is not a lug or trunnion connection
    -- if it a lug or trunnion connection then the new type can not be used.
    -- Lugs and trunnion types can only be modified with types having the same connection type
    if(!this.attaConnRef.set() and (not !this.attaConnRef.badref())) then
      --------------------------------------------------------------------------------------
      --<wd>>jun2003
      -- The variable !this.tubeRef was set to the BRANCH element, which caused an error .attaConnRef
      -- with the syntax - !styp = !!ce.styp - show below on line 1394.
      -- Therefore the variable  - !this.tubeRef - is NOW set to the variable - !this. - ,
      -- as per the line 1341 shown above, to avoid getting the ERROR.
      !this.tubeRef = !this.attaConnRef
      !!ce = !this.tubeRef
      --<<wd>jun2003
      -----------------------------------------------------------------------------------------
    endif
  else
    !!ce = !this.identify(!typeToPrompt, !typeToIdentify, !matchingStyp)
    handle 99
      refresh
      !!kRestoreUnits(!currentUnits)
      return error 99
    endhandle
  endif

  !!kRestoreUnits(!currentUnits)
  return !!ce

endmethod

define method .setRestObject()

  if (!!ce.type.neq('REST')) then
    return error 1 'In $!this.setRestObject() current element is a $!!ce.type. It must be a REST'
  endif
  !this.ref = !!ce
  !this.name = !!ce.name
  !attaName = !this.name.before('/REST')
  !attaRef = !attaName.dbref()
  !this.styp = !attaRef.styp
  !this.bore = !attaRef.lbore
  !this.bore

  !hangers = !this.hangers
  !this.rodSize = REAL()

  do !h
    $!h
    handle ANY
      break
    endhandle

    !oHang = object MDSINTERFACEHANG()
    !oHang.ref = !!ce
    !oHang.func = !!ce.func

    !oHang.name = !!ce.name
    !hangMem = ARRAY()

    do !i
      $!i

      handle ANY
        break
      endhandle

      if(!!ce.type.neq('PCLA') and !this.rodSize.unset())then
        -- saves the current rest rod size
        -- when modifying the rest, the application will check if the new rod size is different than the current rod size
        -- if yes, than all the rest components will be reselected with the new rod size and reconnected
        -- This will give us a new standard hanger heigh to relate to when calling the mdsFH01.resize() method.
        !bore = pl bore
        !this.rodSize = !bore.real()
        if(!this.rodSize eq 0) then
          -- invalid rod size in this component
          -- we re-unset the value so it will be set by the next component
          !this.rodSize = REAL()
        endif
      endif

      if(!!ce.type.eq('PCLA')) then
        !this.pipeClampsRefs.append(!!ce)
      endif
      !mem = object MDSINTERFACEHANGMEM()
      !mem.mirror    = FALSE
      !mem.rotateCur = FALSE
      !mem.canRotate = TRUE
      !mem.rotated   = 0
      !mem.type = !!ce.type
      !mem.ref = !!ce
      !mem.pldir = pl dir wrt /*
      !mem.padir = pa dir wrt /*
      !mem.styp = !this.styp
      !hangMem[!i] = !mem
      hang
    enddo

    !oFitt = object MDSFITT()
    --dun1218 tightened up the test criteria here because the fitting object was being created without tref in modify mode
    --which led to the fitting on the steelwork being deleted in mdshangertype<xx> when the saved fitting differed from the new one
    if(!!ce.tref.set() and !!ce.tref.type.eq('FITT')) then
      !oFitt.ref = !!ce.tref
      !oFitt.name = !!ce.tref.name
    endif
    !oHang.fitt = !oFitt
    !oHang.hangMem = !hangMem
    !hangers[!h] = !oHang
    rest
  enddo

  !this.hangers = !hangers

endmethod

define method .identify(!typeToPrompt is STRING, !typeToIdentify is STRING, !matchingStyp is STRING) is DBREF

  -- keep identifying until a valid response is given or the user escapes
  do

    -- tubeRef is not set or is not of the required matching styp
    -- Identify the Appropriate type.
    prompt off

    prompt load escape 'Identify $!typeToPrompt to support'
    ID $!typeToIdentify @
    handle (61,528)
      -- User exit
      prompt on
      return error 99
    endhandle

    prompt on
    if(!!ce.owner.type.neq('BRAN') and !!ce.type.neq('BRAN')) then
      -- this is not a pipe component
      -- re-identify
      skip
    endif

    if(!typeToIdentify.neq('TUBE'))then
      if(not !!ce.styp inset$!matchingStyp) then
        -- The styp of the selected atta is not matching to the styp required
        skip
      else
      endif
    endif

    --if we get here we have a valid tuberef so just break out
    break

  enddo

  !this.tubeRef = !!ce
  return !!ce

endmethod
