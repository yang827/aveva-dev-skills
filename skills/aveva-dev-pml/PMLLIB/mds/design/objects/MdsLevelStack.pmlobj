--
-- Author:  T.Martin
-- Created: 03/12/03
--
--
-- Description:
-- Multi Discipline support object
--
-- Level stack object
-- used to store the attas associated with the 4 main directions for Framatome cable trays
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  alignstacks()                    -
--  buildcurrent()                   -
--  buildstack()                     -
--  getbarconfig(real)               STRING
--  init()                           -
--  mdslevelstack(dbref,form)        -
--  setdirections()                  -
--  testitem(dbref)                  BOOLEAN
--  teststack()                      BOOLEAN
--
define object mdslevelstack

member .attas         is ARRAY
member .stack1        is array
member .stack2        is array
member .stack3        is array
member .stack4        is array
member .directions    is ARRAY
member .orientations  is ARRAY
member .sctn          is dbref
member .datum         is dbref
member .obj           is mdsplines
member .levcount      is ARRAY
member .form          is form

endobject
--------------------------------------------------------------------------------
define method .mdslevelstack(!sctn is dbref,!form is form)

     !this.sctn = !sctn
     !this.datum = !form.support.datum
     handle ANY
        !!alert.error('Datum support atta not set')
     endhandle
     !this.form = !form
     !this.setdirections()
     !this.buildcurrent()
     !this.buildstack()

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- set the directions of the stack 1 to 4 clockwise from the datum ,which is 1
define method  .setdirections()

  !this.obj = object mdsplines(!this.sctn)
  !pline = !this.obj.getnearest(!this.datum)
  !direction = !this.sctn.plor.$!pline$n.zdir().wrt(/* )

  !ori = y is $!direction
  !ori.origin = /*
  !this.directions[1] = !ori.ydir()
  !this.orientations[1] = !ori.string().before('WRT')
  do !a from 2 to 4
    !ori.gamma = !ori.gamma - 90
    !this.orientations[!a] = !ori.string().before('WRT')
    !this.directions[!a] = !ori.ydir()
  enddo

endmethod
-------------------------------------------------------------------------------

-------------------------------------------------------------------------------
-- loops through the current list of attas and adds an mdstrayatta element to each
define method .buildcurrent()

  !this.attas = ARRAY()
  do !a values !this.form.support.atta
     !this.attas.append(object mdstrayatta(!a,!this.sctn,!this.orientations))
  enddo

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to test add a new item to the stack and check to see if its exceeding the levels
define method .testitem(!atta is dbref)is BOOLEAN

   !this.attas.append(object mdstrayatta(!atta,!this.sctn,!this.orientations))
   !this.buildcurrent()
   !this.buildstack()
   return !this.teststack()

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to sort through the attas and work out what goes where
define method .buildstack()

   do !i from 1 to 4
    !this.stack$!i = ARRAY()
   enddo

   do !v values !this.attas
     !stack = !v.trayno
     !this.stack$!stack$n.append(!v)
   enddo

   !this.levcount[1] = 0
   !this.levcount[2] = 0
   !this.levcount[3] = 0
   !this.levcount[4] = 0

   do !i from 1 to 4
     !levels = ARRAY()
     do !a values !this.stack$!i
       !levels.append(!a.elevation)
     enddo
     -- now sort the members of the stack into ascending order
     !sort = !levels.sortedindices()
     !this.stack$!i$n.reindex(!sort)
     !this.levcount[!i] = !levels.unique().size()
   enddo

   do !i from 1 to 4
     do !a index !this.stack$!i
       if !a eq 1 then
         !this.stack$!i[1].level = 1
           !currentlevel = 1
           !currentelevation = !this.stack$!i[1].elevation
           !this.stack$!i[1].level = 1
       else
          if !this.stack$!i$n[!a].elevation eq !currentelevation then
            !this.stack$!i$n[!a].level = !currentlevel
          else
             !currentlevel = !currentlevel + 1
             !currentelevation = !this.stack$!i$n[!a].elevation
             !this.stack$!i$n[!a].level = !currentlevel
          endif
       endif
    enddo
  enddo

-- uncomment to produce stack output
--   do !i from 1 to 4
--     !size = !this.stack$!i$n.size()
--     $p stack $!i has $!this.levcount[$!i] levels and $!size attas
--  enddo

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
-- check that stack is not full returns true if the stack is full
-- called from testitem method which is trying to insert a new item
define method .teststack()is  BOOLEAN

   do !i from 1 to 4
     !size = !this.stack$!i$n.size()
     if !this.levcount[!i] gt 15 then
       !!alert.error('Maximum Number of Levels Exceeded - Support Not Allowed on this Tray')
       return FALSE
    endif
   enddo

   return TRUE

endmethod
-------------------------------------------------------------------------------
-- method to fix a problem where the side bars are misaligned due to rebuilding
define method .alignstacks()
!save = !!ce
-- deal with stacks 2 and 4 only
  do !a from 2 to 4 by 2
    do !b values !this.stack$n$!a
      !!ce = !b.atta
      handle ANY
        skip
      endhandle
      !pdir = !this.orientations[!a - 1].after('Y is')
      plane $!pdir through $!this.sctn
    enddo
  enddo

!!ce = !save

endmethod
-------------------------------------------------------------------------------
-- method to get the direction of the main support bars depending on config
-- returns a pline name
define method .getbarconfig(!config is real)is STRING






endmethod


-------------------------------------------------------------------------------
define method .init()

endmethod
