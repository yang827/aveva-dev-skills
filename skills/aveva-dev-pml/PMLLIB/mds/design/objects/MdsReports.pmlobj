-----------------------------------------------------------------------------------------------------------
--
-- Define Object
  define object mdsreports

    member .reports     is array
    member .definition is mdsreportdata

-- End of Object
  endobject
--
-----------------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------------
-- Method:       set(!indx is real,!validline is array)
--
-- Description:  Stores the data for each Pre MDS defined Report
--
-- Arguments:
--    [#]   [R/RW]    [Data Type]   [Description]
--
-- Return:
--    [Data Type]    [Description]
--
-----------------------------------------------------------------------------------------------------------
  define method .set(!indx is real,!validline is array)

--  Load the object mdsreportdata
    !this.definition.number = !indx
    !this.definition.name   = !validline[1].trim()
    !this.definition.title  = !validline[2].trim()
    !this.definition.filter = !validline[4].trim()
    !this.definition.list   = !validline[5].trim()

    !this.definition.headings.clear()
    !array = !validline[3].trim().split(',')
    do !count indices !array

      -- check for column sorting and totalling options
      if (!array[!count].match('(').neq(0)) then

        -- get the header number
        !headerNum = !array[!count].before('(').real()

        -- get the column sort/total options and store in headings objects
        !sortTot = !array[!count].after('(').before(')').split('/')
        if (!sortTot.size().neq(5)) then
          $p Invalid definition for heading $!count - must be 5 values in sorting/totalling field ()
        else
          -- set the associated column heading object with the defined sort/total options
          if (!sortTot[1].trim().neq('')) then
            !!mdsnewreports.validhdgs.headings[!headerNum].total = $!sortTot[1]
            handle any
              $p Invalid definition for heading totaling "$!sortTot[1]" in heading $!headerNum
            endhandle
          endif
          if (!sortTot[2].trim().neq('')) then
            !!mdsnewreports.validhdgs.headings[!headerNum].sortprec = $!sortTot[2]
            handle any
              $p Invalid definition for heading sort_precedence "$!sortTot[2]" in heading $!headerNum
            endhandle
          endif
          if (!sortTot[3].trim().neq('')) then
            !!mdsnewreports.validhdgs.headings[!headerNum].sortascend = $!sortTot[3]
            handle any
              $p Invalid definition for heading sort_ascending "$!sortTot[3]" in heading $!headerNum
            endhandle
          endif
          if (!sortTot[4].trim().neq('')) then
            !!mdsnewreports.validhdgs.headings[!headerNum].subSortCol = $!sortTot[4]
            handle any
              $p Invalid definition for heading subtot_sort_col "$!sortTot[4]" in heading $!headerNum
            endhandle
          endif
          if (!sortTot[5].trim().neq('')) then
            !!mdsnewreports.validhdgs.headings[!headerNum].subValues = |$!sortTot[5]|
            handle any
              $p Invalid definition for heading subtot_values "$!sortTot[5]" in heading $!headerNum
            endhandle
          endif
        endif

      else

        !headerNum = !array[!count].real()

        -- no sort/total options; set to defaults values
        !!mdsnewreports.validhdgs.headings[!headerNum].total = FALSE
        !!mdsnewreports.validhdgs.headings[!headerNum].sortprec = 0
        !!mdsnewreports.validhdgs.headings[!headerNum].sortascend = TRUE
        !!mdsnewreports.validhdgs.headings[!headerNum].subSortCol = 0
        !!mdsnewreports.validhdgs.headings[!headerNum].subValues = |ON|

      endif

      !this.definition.headings[!count] = !headerNum

    enddo

  endmethod
-- End of method
--
-----------------------------------------------------------------------------------------------------------
-- End of file mdsreports.pmlobj
