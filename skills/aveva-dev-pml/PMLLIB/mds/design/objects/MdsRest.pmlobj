--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  backUpOriginalRest(STRING)       -
--  changeChannelSpan(REAL,BOOLEAN)  -
--  changeRodSize()                  -
--  checkInsu(STRING)                -
--  checkTubeAccess()                -
--  checkTubeSlope()                 -
--  commonUpdate(FORM,STRING,STRING,BOOLEAN) -
--  create(FORM,FORM)                -
--  createAtta(STRING)               -
--  createRest(STRING,STRING)        -
--  finalize(FORM)                   -
--  getAvailableReselectBores()      ARRAY
--  getBeamRefArray()                ARRAY
--  getCurrentOlap()                 REAL
--  getCurrentSpan()                 REAL
--  getMaxAvailableSpan()            REAL
--  getMinHangDist()                 REAL
--  getMinRequiredSpan()             REAL
--  getTubeRef()                     DBREF
--  initBeamRef()                    -
--  initTubeRef()                    -
--  insertPclaAdapter(STRING,STRING) -
--  mdsRest()                        -
--  mdsRest(DBREF,BOOLEAN)           -
--  mdsRest(STRING)                  -
--  modify(FORM,FORM)                -
--  restoreAccess()                  -
--  saveRestAsTemp(STRING)           -
--  setConnectionRefs(FORM)          -
--  setRestObject()                  -
--  setTubeBore()                    -
--  setTubeDir()                     -
