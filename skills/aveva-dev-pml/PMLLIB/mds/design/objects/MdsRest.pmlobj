-- Define Object
define object MDSREST

  -- member restraint name
  member .name is STRING

  -- member restraint styp (e.g.'VH63')
  member .styp is STRING

  -- member restraint old styp (e.g.'VH61')
  member .oldStyp is STRING

  -- member restraint ref
  member .ref is DBREF

  -- member hangers. List of hangers owned by the MDSREST object
  member .hangers is ARRAY

  -- Has the Member Been Reconnected
  member .reconnected is BOOLEAN

  member .beamRefArray is ARRAY

  member .tubeRef is DBREF

  -- Dummy atta which has the same name as the rest. not necessarily the one that the hanger is connected to
  member .attaRef is DBREF

  -- Standard support atta to which the hanger is connected to. Could be a weld elbow lug or Trunnion
  member .attaConnRef is DBREF

  member .attaConnRefLocked is BOOLEAN

  -- The identified tubref leave bore
  member .bore is BORE

  -- The identified tubref leave direction
  member .pLDir is DIRECTION

  -- Mode of rest handling. Can be either 'MODIFY' or 'CREATE'
  member .mode is STRING

  -- Is it a newly created rest
  member .new is BOOLEAN

  -- Current rest rod size
  member .rodSize is REAL

  -- New required rod size
  member .newRodSize is REAL

  -- Current channel span size for beam channel assembly or a double hanger spring (B11, B13, B14)
  member .channelSpan is REAL

  -- required new channel span size for beam channel assembly or a double hanger spring (B11, B13, B14)
  member .newChannelSpan is REAL

  -- Reference to the rest pipe clamps (generally there is only one pipe clamp per rest)
  member .pipeClampsRefs is ARRAY

  -- End object
endobject

--====================================================================================
define method .mdsRest()
  !this.initBeamRef()
  !this.initTubeRef()
endmethod
-------------------------------------------------------------------------------------------


-------------------------------------------------------------------------------------------
define method .mdsRest(!styp is STRING)
  !this.initBeamRef()
  !this.initTubeRef()
  !this.styp = !styp
endmethod
-------------------------------------------------------------------------------------------

--====================================================================================
define method .mdsRest(!rest is DBREF, !withMembers is BOOLEAN)
  -- If withMembers is FALSE only the rest object is created without its members
  !this.mdsRest()
  !this.ref = !rest
  !this.name = !rest.name
  -- set the attaRef data
  !attaName = !rest.name.before('/REST')
  !attaRef = !attaName.dbref()

  handle ANY
  elsehandle NONE
    !this.attaRef = !attaRef
    !this.tubeRef = !attaRef
    !this.styp = !attaRef.styp
  endhandle
  -- set the attaConnRef
  !ce = !!ce
  -- goto the rest
  !!ce = !rest
  -- goto to first hanger
  hang1
  handle ANY
  elsehandle NONE
    !attaConnRef = !!ce.href
    !!ce = !attaConnRef
    handle ANY
    elsehandle NONE
      !this.attaConnRef = !attaConnRef
    endhandle
  endhandle
  !!ce = !ce
  if(not !withMembers) then
    return
  else
    -- create the hanger objects
  endif
endmethod
-------------------------------------------------------------------------------------------


--====================================================================================
define method .getBeamRefArray() is ARRAY
  --><wd>17aug2009 -- DFN P-22111 (SI-13209) -- NOTE: The CODE below is ONLY called if user is at a RESTRAINT (REST) element
  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  !beamArray = ARRAY()
  !hangMem = !this.ref.mem
  -- Loop through the REST HANGER elements
  do !hanger values !hangMem
    if(!hanger.tref.set() and !hanger.tref.type.eq('FITT')) then
      !beamArray.append(!hanger.tref.owner)
      !beamArray.append(!hanger.tref.:MDSConnect[1])
      handle ANY
        -- if the :MDSConnect attribute is not set
        -- it might be a single beam restr (no double channel
        -- so just set it to an empty UNSET dbref object
        !mdsConnect = object DBREF()
        !beamArray.append(!mdsConnect)
      endhandle
    endif
  enddo
  !!kRestoreUnits(!currentUnits)
  return !beamArray
endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .updateBeamRefArray()
  --><wd>17aug2009 -- DFN P-22111 (SI-13209) -- NOTE: The CODE below is ONLY called if user is at a RESTRAINT (REST) element
  !this.beamRefArray = !this.getBeamRefArray()
endmethod
-------------------------------------------------------------------------------------------


--====================================================================================
define method .modify(!form is FORM, !callingForm is FORM)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.modify($!form is FORM, $!callingForm is FORM)')
  endif
  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist

  !ce = !!ce

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist

  -- Initialise variables

  !support     = !form.support
  !tubetype    = !!mdsOptions.pipes
  !this.attaRef = !form.support.datum
  !name        = !form.name.val
  !alias       = !form.support.alias
  !cecomp      = !!ce
  !formname    = '!!' & !form
  --------------------------------------------------------------------------------

  !!ce = !this.attaRef
  ---------------25 june  !form.support.rest = !this

  -- Perform actions that are common to the modify and create modes
  !this.commonUpdate(!form, !name, !alias, FALSE)
  handle 99
    !!kRestoreUnits(!currentUnits)
    return error 99
  elsehandle 1 2 3 4 5 6 10 90
    !!kRestoreUnits(!currentUnits)
    return error 90 |$!!error.text|
  elsehandle ANY
    !!kRestoreUnits(!currentUnits)
    !err = !!error.text + ' ' + !!error.command.before('***')  + ' ' + !!error.line.before('***')
    return error 100 |$!err|
  endhandle
  !!kRestoreUnits(!currentUnits)

endmethod
-------------------------------------------------------------------------------------------


--====================================================================================
define method .create(!form is FORM, !callingForm is FORM)

  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.create($!form is FORM, $!callingForm is FORM)')
  endif

  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  !ce = !!ce

  -- Find current units and set the distance unit to metric

  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist

  -- Initialise variables

  !support     = !form.support
  !tubetype    = !!mdsOptions.pipes
  !this.attaRef = !form.support.datum
  !name        = !form.name.val
  !styp      = !form.support.alias
  !cecomp      = !!ce
  !formname    = '!!' & !form

  --------------------------------------------------------------------------------

  !this.new = TRUE
  !form.support.rest = !this

  -- Copy the connection ref from the calling form to this object

  !this.setConnectionRefs(!callingForm)
  !form.support.rest = !this

  -- rest the oldsupport so the newly created rest objects and data will be saved

  !form.oldsupport = object MDSSUPPORT()

  -- Perform actions that are common to the modify and create modes

  !this.commonUpdate(!form, !name, !styp, TRUE)
  handle 99
    -- Update the form support atta array, so !this.cancelHanger will add the atta
    -- to the delete list
    !form.support.datum = !this.attaRef
    !form.support.atta.append(!this.attaRef)
    !!kRestoreUnits(!currentUnits)
    if(defined(!!mdsDebug)) then
      !!mdsDebug.traceError('Handling error 99. $!this' + '.create($!form is FORM, $!callingForm is FORM)')
    endif
    return error 99
  elsehandle 1 2 3 4 5 6 10 90
    -- Update the form support atta array, so !this.cancelHanger will add the atta
    -- to the delete list
    !form.support.datum = !this.attaRef
    !form.support.atta.append(!this.attaRef)
    !!kRestoreUnits(!currentUnits)
    if(defined(!!mdsDebug)) then
      !!mdsDebug.traceError('Handling error 1 2 3 4 5 6 10 90. $!this' + '.create($!form is FORM, $!callingForm is FORM)')
    endif
    return error 90 |$!!error.text|
  elsehandle 51
    -- user accepted error
    -- continue
  elsehandle ANY
    -- Update the form support atta array, so !this.cancelHanger will add the atta
    -- to the delete list
    !form.support.datum = !this.attaRef
    !form.support.atta.append(!this.attaRef)
    !!kRestoreUnits(!currentUnits)
    if(defined(!!mdsDebug)) then
      !!mdsDebug.traceError('Handling any error. $!this' + '.create($!form is FORM, $!callingForm is FORM)')
    endif
    !err = !!error.text + ' ' + !!error.command.before('***')  + ' ' + !!error.line.before('***')
    return error 100 |$!err|
  endhandle

  -- Update the form support atta array.

  !form.support.datum = !this.attaRef
  !form.support.atta.append(!this.attaRef)
  !!kRestoreUnits(!currentUnits)

  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.create($!form is FORM, $!callingForm is FORM)')
  endif

endmethod
-------------------------------------------------------------------------------------------

--====================================================================================
define method .initBeamRef()
  !beamRefArray = ARRAY()
  !beamRef = object DBREF()
  !beamRefArray.append(!beamRef)
  !beamRefArray.append(!beamRef)
  !beamRefArray.append(!beamRef)
  !beamRefArray.append(!beamRef)
  !this.beamRefArray = !beamRefArray
endmethod
-------------------------------------------------------------------------------------------

--====================================================================================
define method .initTubeRef()
  !this.tubeRef = object DBREF()
endmethod
-------------------------------------------------------------------------------------------

--====================================================================================
define method .setConnectionRefs(!callingForm is FORM)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.setConnectionRefs($!callingForm is FORM)')
  endif
  if(!callingForm eq !!mdsFHanger) then
    -- tube ref and beam/beams ref are given by the calling form
    !this.tubeRef = object DBREF()
    if(!callingForm.tubeRef.set() and (not !callingForm.tubeRef.badref())) then
      !this.tubeRef = !callingForm.tubeRef
      if(defined(!!mdsDebug)) then
        !!mdsDebug.trace(1, 'Set $!this$n.tubeRef to $!this.tubeRef (name: $!this.tubeRef.name)')
      endif
    endif
    !this.beamRefArray  = ARRAY()
    if(!callingForm.beamRef.set()) then
      do !i indices !callingForm.beamRef
        if(!callingForm.beamRef[!i].set() and (not !callingForm.beamRef[!i].badref())) then
          !this.beamRefArray[!i] = !callingForm.beamRef[!i]
          if(defined(!!mdsDebug)) then
            !!mdsDebug.trace(1, 'Set $!this$n.beamRefArray[$!i] to $!this.beamRefArray[$!i] (name: $!this.beamRefArray[$!i].name)')
          endif
        else
          !beamRef = object DBREF()
          !this.beamRefArray[!i] = !beamRef
          if(defined(!!mdsDebug)) then
            !!mdsDebug.trace(1, 'Set $!this$n.beamRefArray[$!i] to $!this.beamRefArray[$!i]')
          endif
        endif
      enddo
    endif
  endif
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.setConnectionRefs($!callingForm is FORM)')
  endif
endmethod
-------------------------------------------------------------------------------------------


--====================================================================================
define method .checkTubeAccess()
  -- Check if we can write to the pipe

  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.checkTubeAccess()')
  endif
  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  !write = STRING()
  !lock  = STRING()

  if (!!kcheckwrite(!this.tubeRef, !lock , !write).not()) then
    if (!write.eq('R')) then
      -- READ ONLY Access

      !!kRestoreUnits(!currentUnits)
      if(defined(!!mdsDebug)) then
        !!mdsDebug.traceError('The Identified element is in a read only database.')
      endif
      return error 1 'The Identified element is in a read only database.'
    elseif (!lock.eq('Locked')) then
      -- WRITE Access, BUT it is LOCKED

      !this.attaConnRefLocked = !!ce.lock
      if(!this.styp inset$!!mdsAllHangerTypes.weldedElbowTrunion) then
        -- Trunnion is always locked to prevent the user to manually change the max Trunnion length by dragging the elbo
        -- we need to unlock it and relock it
        if(!!alert.confirm('Trunnion is locked. Do you want to unlock it?').upcase().eq('YES')) then
          bran
          unlock all
        else
          !!kRestoreUnits(!currentUnits)
          if(defined(!!mdsDebug)) then
            !!mdsDebug.traceOut(1, '$!this' + '.checkTubeAccess()')
          endif
          return error 2 'The Identified element is locked.' noalert
        endif
      else
        !!kRestoreUnits(!currentUnits)
        if(defined(!!mdsDebug)) then
          !!mdsDebug.traceError('The Identified element is locked.')
        endif
        -- dtf >> 5.07.06 removed because !!mdsReoAtta can cope with this and if branch is locked
        -- we get a error message any way
        --return error 2 'The Identified element is locked.'
      endif
    endif
  endif
  !!kRestoreUnits(!currentUnits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.checkTubeAccess()')
  endif
endmethod
-------------------------------------------------------------------------------------------


--====================================================================================
define method .checkInsu(!styp is STRING)

    if(defined(!!mdsDebug)) then
      !!mdsDebug.traceIn(1, '$!this' + '.checkInsu($!styp is STRING)')
    endif
    !currentUnits = !!kGetSetUnits()
    units mm bore mm dist
    !template = !!mdsAllHangerTypes.getTemplateName(!styp)
    !aliasFunction = function of /MDS/$!template
    handle ANY

      !!kRestoreUnits(!currentUnits)
      if(defined(!!mdsDebug)) then
        !!mdsDebug.traceError('Template zone /MDS/$!template does not exist')
      endif
      return error 98 'Template zone /MDS/$!template does not exist'
    endhandle
    var !insuThk insu

    if(!aliasFunction.upcase().eq('NOINSU')) then
      -- the required support type IS NOT suitable for insulated pipes
      if(!insuThk.real() gt 0) then
        -- the selected tube is insulated

        !!kRestoreUnits(!currentUnits)
        if(defined(!!mdsDebug)) then
          !!mdsDebug.traceError('Support type is not suitable for insulated pipes')
        endif
        return error 1 'Support type is not suitable for insulated pipes'

      endif
    elseif(!aliasFunction.upcase().eq('INSU')) then
      -- the required support type IS suitable for insulated pipes only
      if(!insuThk.real() eq 0) then
        -- the selected tube is not insulated

        !!kRestoreUnits(!currentUnits)
        if(defined(!!mdsDebug)) then
          !!mdsDebug.traceError('Support type is suitable for insulated pipes only')
        endif
        return error 2 'Support type is suitable for insulated pipes only'

      endif
    endif
    !!kRestoreUnits(!currentUnits)
    if(defined(!!mdsDebug)) then
      !!mdsDebug.traceOut(1, '$!this' + '.checkInsu($!styp is STRING)')
    endif

endmethod
-------------------------------------------------------------------------------------------


--====================================================================================
define method .createAtta(!name is STRING)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.createAtta($!name is STRING)')
  endif
  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  -- Hanger atta
  !!mdsDacControl(TRUE)
  -- !this.styp inset$!!mdsAllHangerTypes.riserClamp or

  if(!this.styp inset$!!mdsAllHangerTypes.weldedElbowOrPipeLug or $
    !this.styp inset$!!mdsAllHangerTypes.weldedElbowTrunion or $
    !!mdsAllHangerTypes.riserClamp.find(!this.styp).size().gt(0) or $
    !this.styp inset$!!mdsAllHangerTypes.bM1Spring or $
    !this.styp inset$!!mdsAllHangerTypes.doubleBM1Spring or $
    !this.styp inset$!!mdsAllHangerTypes.dSSpring or $
    !this.styp inset$!!mdsAllHangerTypes.channelAssembly or $
    !this.styp inset$!!mdsAllHangerTypes.bM2Spring) then
    -- Hanger is connected to a welded elbow, a pipe lug or a riser clamp
    -- We use the selected atta for the connection
    !!ce = !this.tubeRef
    -- q var !!ce
    --< tm special case to create the atta on the plat
  if (!this.styp inset$!!mdsAllHangerTypes.weldedElbowTrunion) then
      !!ce = last
    endif
    !this.attaConnRef = !!ce
    -- Creating a dummy atta just for compatibility
    -- This hanger is connected to an existing atta which is a welded elbow or pipe lug and have its own name
    if !!mdsFH01.support.preliminaryStore.set() then
      !!ce = !this.attaRef
      name /$!name
    else
    new atta
    name /$!name
    handle ANY
      !this.attaRef = !!ce
      !errNo = 2
      !errText = 'Support Name already exists'
      golabel /ERROR
    endhandle
    endif
    !this.attaRef = !!ce
    prev
  else
    if !!mdsFH01.support.preliminaryStore.set() then
      !!ce = !this.attaRef
    else
      new atta
      !this.attaRef = !!ce
    endif
    !this.attaConnRef = !!ce
  endif

  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.createAtta($!name is STRING)')
  endif
  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)
  return
  label /ERROR
  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)
  return error $!errNo |$!errText|

endmethod
-------------------------------------------------------------------------------------------

--====================================================================================
define method .updateAtta(!name is STRING, !styp is STRING, !newAtta is BOOLEAN)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.updateAtta($!name is STRING, $!styp is STRING)')
  endif
  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  !ce = !!ce

  !!ce = !this.attaRef
  !!mdsDacControl(TRUE)
  -- !this.styp inset$!!mdsAllHangerTypes.riserClamp or
  if(!this.styp inset$!!mdsAllHangerTypes.weldedElbowOrPipeLug or $
    !this.styp inset$!!mdsAllHangerTypes.weldedElbowTrunion or $
    !!mdsAllHangerTypes.riserClamp.find(!this.styp).size().gt(0) or $
    !this.styp inset$!!mdsAllHangerTypes.bM1Spring or $
    !this.styp inset$!!mdsAllHangerTypes.doubleBM1Spring or $
    !this.styp inset$!!mdsAllHangerTypes.dSSpring or $
    !this.styp inset$!!mdsAllHangerTypes.channelAssembly or $
    !this.styp inset$!!mdsAllHangerTypes.bM2Spring) then
    -- Hanger is connected to a welded elbow or pipe lug
    !!ce.stext = 'Connected to $!name'
    -- 29/08/02
    !!ce = !this.tubeRef
    !this.attaConnRef = !!ce
    -- This hanger is connected to an existing atta which is a welded elbow or pipe lug and have its own name
    !attaName = '/$!name'
    !!ce = !attaName.dbref()
    handle ANY
      -- 29/08/02
      new atta
      name /$!name
      handle ANY
        !this.attaRef = !!ce
        !errNo = 2
        !errText = 'Support Name already exists'
        golabel /ERROR
      endhandle
      !this.attaRef = !!ce
      prev
    elsehandle NONE
      !this.attaRef = !!ce
    endhandle

  else
    -- Hanger has its own real atta. This atta has the same name as the hanger
    if(!newAtta) then
      name /$!name
      handle ANY
        !errNo = 2
        !errText = 'Support Name already exists'
        golabel /ERROR
      endhandle
    endif
    -- 29/08/02
    --   !this.attaRef = !!ce
    --   !this.attaConnRef = !!ce
  endif
  spkbrk TRUE

  !this.oldStyp = styp
  handle ANY
    -- new atta. Not yet selected
  endhandle
  select spref with styp '$!styp' spec /MDS
  handle ANY
    !boreString = !this.bore.real().value().string()
    !errNo = 1
    !errText = 'Identified tube bore $!boreString is not in the standard bores for this hanger type'
    golabel /ERROR
  endhandle

  -->>--<wd>june2003
  -- Set the new ATTA ISPE attribute to that of the Previous Component or Branch Head <if set>.
  !hatta = !!ce
  !!mdssetispe()
  !!ce = !hatta
  --<<--<wd>june2003

  sel lstu
  shop FALSE
  :MDSSuppType '$!styp'
  -- stext '$!name'
  call !!mdsTransport(!!ce,!name)
  !!mdsDacControl(TRUE)
  matref /CARBON/STEEL
  handle ANY
    :MDSMatRef /CARBON/STEEL
    handle ANY
      !errNo = 3
      !errText = 'Material /CARBON/STEEL is not defined. Please check your Propcon Database.'
      golabel /ERROR
    endhandle
  endhandle
  ------------------------------------------------------------------------------
  -- mjb >>> 10.05.06 <mds12>
  !mdsattaobj  = object MDSREADPARSDATA()
  !unusedMdsAttaDefs = !mdsattaobj.mdsdefsdata('!!ce.styp',!!ce.lbor.real())
  !!hobj = !mdsattaobj
  !mtoc = !mdsattaobj.mtoc
  --!mtoc = !!mdsparmh01[0].shop
  -- mjb <<< 10.05.06 end of mod
  ------------------------------------------------------------------------------
  handle ANY
  elsehandle NONE
    if (!mtoc.unset()) then
    elseif (!mtoc.not()) then
      !hatta.mtoc = 'off'
    elseif (!mtoc) then
      !hatta.mtoc = 'on'
    endif
  endhandle

  -- $p===== fconn line 621 MDSREST.pmlobj ==========
  -- q name type spre
  --<sk> this changes position of atta so do not call on preliminary
  if (not !!mdsFH01.support.preliminaryStore.set()) then
  fconn
  endif
  !!ce = !ce
  refresh

  !!mdsDacControl(FALSE)

  !!kRestoreUnits(!currentUnits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.updateAtta($!name is STRING, $!styp is STRING)')
  endif
  return

  label /ERROR

  !!ce = !ce
  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceError('$!this' + '.updateAtta($!name is STRING, $!styp is STRING)')
  endif
  return error $!errNo |$!errText|
endmethod
-------------------------------------------------------------------------------------------

--====================================================================================
define method .createRest(!name is STRING, !styp is STRING)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.createRest($!name is STRING, $!styp is STRING)')
  endif
  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  !!mdsDacControl(TRUE)

  !zone = !!mdsDefaultSite.siteForHangers.selection('Dtext')
  !zoneName = '/' + !zone
  !!ce = !zoneName.dbref()
  handle (2,109) (2,813)
    -- if zone is not selected in !!mdsDefaultSite or does not exist, create REST inside PIPE
    pipe
  endhandle

  last mem
  handle (41,66) (2,113)
  endhandle

  new restr
  handle ANY
    !!kRestoreUnits(!currentUnits)
    return error 1 '$!!error.text'
  endhandle

  !this.ref = !!ce
  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.createRest($!name is STRING, $!styp is STRING)')
  endif
endmethod
-------------------------------------------------------------------------------------------


--====================================================================================
define method .updateRest(!name is STRING, !styp is STRING)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.updateRest($!name is STRING, $!styp is STRING)')
  endif
  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  !ce = !!ce
  !!ce = !this.ref

  !!mdsDacControl(TRUE)
  name /$!name/REST

  !boreString = !this.bore.real().value().string()
  --<wd>sep2003
  -- !boreString for 80mm bore pipe is returned by the line above
  -- INCORRECTLY by CORE PDMS as 76.2 and NOT 80
  if (!boreString inset ('76.2')) then
    !boreString = '80'
  endif
  --<wd>sep2003

  -- Copy the restraint template
  -- Some templates have various sizes of hangers for the same pipe size
  -- we copy the proper restr using the suffix of the atta's styp where appropriate
  !suffix = ''
  --  $P $!!mdsAllHangerTypes.weldedElbowOrPipeLug
  if(!styp inset$!!mdsAllHangerTypes.weldedElbowOrPipeLug) then
    !suffix = '/' + !this.tubeRef.styp.substring(-1,1)
  endif
  !template = !!mdsAllHangerTypes.getTemplateName(!styp)
  !changeStyp = TRUE
  if(!this.oldStyp.set() and (!this.oldStyp eq !this.styp)) then
    -- we are not changing the hanger configuration type
    -- we use the temporary hanger if it exists
    !changeStyp = FALSE
  else
    -- we are changing the configuration

    -- Check to see if the old styp and the new are using the same template
    if(!this.oldStyp.set()) then
      !oldTemplate = !!mdsAllHangerTypes.getTemplateName(!this.oldStyp)
      if(!template eq !oldTemplate) then
        -- same template. No need to-copy the template
        -- use current temporary hanger
        !changeStyp = FALSE
      else
        -- we need to copy a new template
      endif
    endif

  endif

  --> new

  !tempName =  '/$!name/REST/TEMP'
  !unusedTempRef = !tempName.dbref()
  handle ANY
    -- there is no temporary rest
    -- copy the rest from the template
    !tempExists = FALSE
  elsehandle NONE
    -- we have a temporary rest
    -- we will copy it to keep the latest modifications made to the rest
    !tempExists = TRUE
  endhandle
  if(!changeStyp or (not !tempExists)) then
      copy /MDS/$!template/$!boreString$!suffix rename /MDS/$!template/$!boreString$!suffix /$!name
      handle ANY
        !!kRestoreUnits(!currentUnits)
        if(defined(!!mdsDebug)) then
          !!mdsDebug.traceError('$!this' + '.updateRest($!name is STRING, $!styp is STRING)')
        endif
        !errText = 'Unable to copy template "/MDS/$!template/$!boreString$!suffix$n". Please check if it exists (Current size may not exist)'
        return error 3 '$!errText'
      endhandle
    refresh

    -- Saves the current rod size as the new rod size. Later if the template rod size
    -- is different from the current rod size, the application will change the rod size to be as the current one
    --    !this.newRodSize = !this.rodSize
    -- The current rod size may be different from the rod size of the template.
    -- Get the template's rod size

    -- dtf >>> for PIHASA channel assembly pl is 0 therefore we need to get it from the
    -- leave of the first component of the 2nd hanger
    !descOfHangersSite = desc of /MDS/HANGERS
    if (!descOfHangersSite.eq('PIHASA Hanger Configurations') and  !this.styp inset$!!mdsAllHangerTypes.channelAssembly )then
      !bore = pl bore of 1 of hang2
    else
      !bore = pl bore of 1 of hang1
      handle (2,113) $* list exhausted for HANGER
        -- List exhausted
        -- hanger does not have members (eg. First hanger of doubleBM1Spring)
      elsehandle NONE
        !this.rodSize = !bore.real()
        -- Insert the pcla adapter
        !this.insertPclaAdapter(!name, !styp)
      endhandle
    endif
    -- dtf <<<

  else
    -- there is a temporary rest
    -- we will copy it to keep the latest modifications made to the rest
    rem $!tempName
    copy $!tempName ren /$!name/TEMP /$!name

    handle ANY
      !!kRestoreUnits(!currentUnits)
      if(defined(!!mdsDebug)) then
        !!mdsDebug.traceError('$!this' + '.updateRest($!name is STRING, $!styp is STRING)')
      endif
      !errText = 'Unable to copy the temporary restraint "$!tempName". Please check if it exists'
      return error 3 '$!errText'

    endhandle
  endif
  purp MDS
  -- to be done
  -- update the .rodSize value from the pl of first comp of the first hanger
  !!ce = !ce
  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.updateRest($!name is STRING, $!styp is STRING)')
  endif
endmethod
-------------------------------------------------------------------------------------------

--====================================================================================
define method .setTubeBore()
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.setTubeBore()')
  endif
  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  !!ce = !this.tubeRef
  if (!!ce.type eq 'BRAN') then
    !pl = 'ph'
  else
    !pl = 'pl'
  endif
  !bore = $!pl bore
  -- In order to cater for catalogue with actual bores as parameter 1 get the nearest bore
  !bore = !bore.real().nearestbore().string().before('mm').bore()
  !this.bore =  !bore

  !!kRestoreUnits(!currentUnits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.trace(1, '$!pl bore is $!this.bore')
    !!mdsDebug.traceOut(1, '$!this' + '.setTubeBore()')
  endif
endmethod
-------------------------------------------------------------------------------------------

--====================================================================================
define method .setTubeDir()
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.setTubeDir()')
  endif
  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  !!ce = !this.tubeRef
  if (!!ce.type eq 'BRAN') then
    !pl = 'ph'
  else
    !pl = 'pl'
  endif
  !this.pLDir = $!pl dir wrt /*
  !!kRestoreUnits(!currentUnits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.trace(1, '$!pl dir is $!this.pLDir')
    !!mdsDebug.traceOut(1, '$!this' + '.setTubeDir()')
  endif
endmethod
-------------------------------------------------------------------------------------------


--====================================================================================
define method .checkTubeSlope()

  -- Check that the pipe slope is within allowed limits

  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.checkTubeSlope()')
  endif

  !descOfHangersSite = desc of /MDS/HANGERS

  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  !udir = object DIRECTION('U')
  !angle = !this.pLDir.angle(!udir)

  if (!angle gt 100) then
    !angle = !this.pLDir.opposite().angle(!udir)
  endif

  if(!this.styp inset$!!mdsAllHangerTypes.weldedElbowOrPipeLug or $
    !this.styp inset$!!mdsAllHangerTypes.weldedElbowTrunion or $
    !this.styp inset$!!mdsAllHangerTypes.doubleBM1Spring or $
    !!mdsAllHangerTypes.riserClamp.find(!this.styp).size().gt(0)) then
    -- Hanger is connected to a welded elbow or pipe lug or pipe Trunnion or a riser clamp
    -- The lug is in a separate branch having an UP direction
    -- !this.styp inset$!!mdsAllHangerTypes.riserClamp) then

    !deltaAngle = !angle

    -----------------------------
    --<wd>22jul2004
    -- CHECK for Manufacturers Interface - * STYP = 'MH01' * stored in the <MDSREST> object member '!this.styp' and
    -- CHECK if the <MDSREST> object member value of '!this.pLDir' is 'UP or DOWN wrt /*' - i.e. a VERTICAL PIPE
  elseif ( (!this.styp inset ('MH01')) and ( (!this.pLDir.string().eq('U WRT /*') ) or (!this.pLDir.string().eq('D WRT /*')) or (!this.pLDir.string().eq('Z WRT /*')) or (!this.pLDir.string().eq('-Z WRT /*')) ) )then
    -- Set !deltaAngle to suit a VERTICAL PIPE as for the '!this.styp' shown in the 'if' statement above
    !deltaAngle = !angle
    --<wd>22jul2004
    -----------------------------

  elseif(!this.styp inset$!!mdsAllHangerTypes.bM1Spring or $
    !this.styp inset$!!mdsAllHangerTypes.bM2Spring) then
    -- The direction should be horizontal
    !deltaAngle = abs(90 - !angle)
    -- dtf >>> PIHASA need B15 on trunnions vertical
  if (!descOfHangersSite.eq('PIHASA Hanger Configurations')) then
      if (((!this.pLDir.string().eq('U WRT /*')) or (!this.pLDir.string().eq('D WRT /*')) or (!this.pLDir.string().eq('Z WRT /*')) or (!this.pLDir.string().eq('-Z WRT /*'))))then
        !deltaAngle =  !angle
      endif
    endif
    -- dtf <<< End of Mod
  elseif(!this.styp inset$!!mdsAllHangerTypes.channelAssembly and !descOfHangersSite.eq('PIHASA Hanger Configurations') ) then
    -- dtf >>> PIHASA need B11 on trunnions vertical
    -- The direction should be horizontal
    !deltaAngle = abs(90 - !angle)
    -- dtf >>> PIHASA need B15 on trunnions vertical
    if (((!this.pLDir.string().eq('U WRT /*')) or (!this.pLDir.string().eq('D WRT /*')) or (!this.pLDir.string().eq('Z WRT /*')) or (!this.pLDir.string().eq('-Z WRT /*')))) then
      !deltaAngle =  !angle
    endif
    -- dtf <<< End of Mod
  else
    -- an inline atta. The direction should be horizontal
    !deltaAngle = abs(90 - !angle)
  endif
!deltaAngleString = !deltaAngle.string(!!anglefmt)
    !maxSlopeError = !!mdsOptions.maxpiva.real()
  !maxSlopeWarning = !!mdsOptions.maxpwar.real()
  if(!deltaAngle gt !maxSlopeError) then
    !!kRestoreUnits(!currentUnits)
  return error 1 'Tube angle has a $!deltaAngleString slope. This is more than the maximum allowed $!maxSlopeError angle.'
  elseif(!deltaAngle gt !maxSlopeWarning) then
  !answ = !!alert.confirm('Tube angle has a $!deltaAngleString slope. This is more than the maximum recommended $!maxSlopeWarning angle. Do you want to continue?')
    if(!answ.eq('NO')) then
      !!kRestoreUnits(!currentUnits)
    return error 2 'Tube angle has a $!deltaAngleString slope. This is more than the maximum recommended $!maxSlopeWarning angle. User continued'
    endif
  endif

  !!kRestoreUnits(!currentUnits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.checkTubeSlope()')
  endif
endmethod
-------------------------------------------------------------------------------------------

--====================================================================================
define method .commonUpdate(!form is FORM, !name is STRING, !styp is STRING, !newAtta is BOOLEAN)

  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.commonUpdate($!form is FORM, $!name is STRING, $!styp is STRING, $!newAtta is BOOLEAN)')
  endif


  !ce = !!ce
  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist

  !this.styp = !styp
  !currentRodSize = !this.rodSize
  !form.support.rest = !this
  !!ce = !this.getTubeRef()
  handle 99
    -- User exit
    prompt on
    refresh
    !errNo = 99
    !errText = ''
    golabel /ERROR
  elsehandle ANY
    !errNo = 10
    !errText = !!error.text + ' ' + !!error.line.before('***')
    golabel /ERROR
  endhandle
  !form.support.rest = !this

  -- Check the support type is suitable for selected pipe (with/without insulation)

  -- Check the support type is suitable for selected pipe (with/without insulation)
  !this.checkInsu(!styp)
  handle 98
    --    !!alert.error('Template zone /MDS/$!styp does not exist')
    !errNo = 90
    !errText = 'Template zone /MDS/$!styp does not exist'
    golabel /ERROR
  elsehandle ANY
    !errNo = 1
    !errText = !!error.text + ' ' + !!error.line.before('***')
    golabel /ERROR
  endhandle
  !form.support.rest = !this


  -- Check the access rights for the pipe

  !this.checkTubeAccess()
  handle ANY
    !errNo = 2
    !errText = !!error.text + ' ' + !!error.line.before('***')
    golabel /ERROR
  endhandle


  forward

  --------------------------------------------------------------------------------
  -- Check if element identified is suitable for this type of base support
  --------------------------------------------------------------------------------


  !this.setTubeBore()

  !form.support.rest = !this
  !this.setTubeDir()
  !form.support.rest = !this
  -- Get Session Bore Units


  if(!!kGetBoreUnits()) then
    !boreUnits = 'inch bore'
  else
    !boreUnits = ''
  endif

  if (undefined(!!licadautotestenabled)) then
    !this.checkTubeSlope()
    handle 2
      golabel /exit
    elsehandle ANY
      !errNo = 3
      !errText = !!error.text
      golabel /ERROR
    endhandle
  endif

  --< tm note this is where it creates the atta current element is the trunnion sref atta
  -- q var !!ce

  if(!newAtta) then
    !this.createAtta(!name)
    handle ANY
      !form.support.rest = !this
      !form.support.datum = !this.attaRef
      !errNo = 4
      !errText = !!error.text
      golabel /ERROR
    endhandle
  endif
  !form.support.rest = !this
  !form.support.datum = !this.attaRef


  !this.updateAtta(!name, !styp, !newAtta)
  handle ANY
    !errNo = 5
    !errText = !!error.text + ' ' + !!error.line.before('***')
    golabel /ERROR
  endhandle
  !form.support.rest = !this

  !!ce = !this.attaRef

  pipe

  if(not !newAtta) then
    -- in modify mode
    -- we rename the original rest to be able to create a new rest with the same name
    !this.saveRestAsTemp(!name)
    !this.backUpOriginalRest(!name)
    !form.support.rest = !this
  endif
  !this.createRest(!name, !styp)
  handle ANY
    !errNo = 2
    !errText = !!error.text
    golabel /ERROR
  endhandle
  !form.support.rest = !this
  !this.updateRest(!name, !styp)
  handle 3
    !errNo = 6
    !errText = !!error.text + ' ' + !!error.line.before('***')
    golabel /ERROR
  elsehandle ANY
    !errNo = 90
    !errText = !!error.text + ' ' + !!error.line.before('***')
    golabel /ERROR
  endhandle

  !form.support.rest = !this
  if(not !this.newRodSize.set()) then
    !this.newRodSize = !currentRodSize
  endif
  if(!this.newRodSize.set() and (!this.newRodSize neq !this.rodSize)) then
    !this.changeRodSize()
    handle ANY
      !errNo = 90
      !errText = !!error.text + ' ' + !!error.line.before('***')
      golabel /ERROR
    endhandle
  endif
  !this.newRodSize = REAL()



  ---------->Addition to common update

  -- Set the from support datum and atta values
  -- !form.resizeHanger uses these values to calculate the rod lengths limits
  !form.support.datum = !this.attaRef
  !form.support.atta = ARRAY()
  !form.support.atta.append(!this.attaRef)
  !form.support.atta.unique()
  -- Default number of hangers per Rest for all support type

  !numOfHangers = 1

  !oHangerType = !!mdsAllHangerTypes.gethangertype(!this.attaRef.styp.upcase())

  if(!oHangerType.set() and ($
    !oHangerType.group eq !!mdsAllHangerTypes.doubleHangerGroupNoSingleBeam or $
    !oHangerType.group eq !!mdsAllHangerTypes.doubleHangerGroupNoDoubleChannel or $
    !oHangerType.group eq !!mdsAllHangerTypes.civilplatedoublehanger or $
    !oHangerType.group eq !!mdsAllHangerTypes.doubleHangerGroupNoCombined) or $
    !oHangerType.styp inset$!!mdsAllHangerTypes.doubleBM1Spring) then

    -- We have a double hangers hanger. The Restraint has 3 hangers
    !numOfHangers = 3
  endif
  if(!oHangerType.set() and !!mdsAllHangerTypes.m5Constant.findfirst(!oHangerType.styp).set()) then
    -- We have a double hangers hanger. The Restraint has 2 hangers
    !numOfHangers = 2

  endif

  -- Create the hangers
  !hangers = ARRAY()
  do !i to !numOfHangers

    if(defined(!!mdsDebug)) then
      !!mdsDebug.trace(2, 'Creating Hang Object No. $!i')
    endif

    !oHang = object MDSHANG()
    !oHang.create(!this, !form, !i, !numOfHangers)
    handle 99
      -- user exit
      !errNo = 99
      !errText = !!error.text
      golabel /ERROR
    elsehandle ANY
      !errNo = 90
      !errText = !!error.text
      golabel /ERROR
    endhandle

    -- in case the beam ref array has been reversed
    -- or if it was empty and the user clicked on a beam for hanger 1 of 3 then
    -- we need to use the same array value for hanger 2 of 3
    --> 01/08/02
    !this = !oHang.rest
    --    !this.beamRefArray = !oHang.rest.beamRefArray
    --< 01/08/02
    !hangers.append(!oHang)
  enddo



  !this.hangers = !hangers
  !form.support.rest = !this

  if(!this.hangers.size() eq 3 and $
    (not !oHangerType.styp inset$!!mdsAllHangerTypes.doubleBM1Spring)) then
    -- delete the fitting of the first hanger.
    -- Only the two last hangers are connected directly to a fitting
    /$!name/FITT/H1
    handle ANY
      /$!name/SBFI/H1
      delete sbfi
    endhandle
    delete fitt
    handle ANY
    endhandle
    if(defined(!!mdsDebug)) then
      !!mdsDebug.trace(1, 'Deleting dummy fitting /$!name/FITT/H1')
    endif
  elseif (!this.hangers.size() eq 2 and !!mdsAllHangerTypes.m5Constant.findfirst(!oHangerType.styp).set()) then
    !oriref = ref
    --/$!name/FITT/H2
    -- delete FITT
    $!oriref
  endif
  -- <ab> check if doest not keep redundant data for styp

  !this.styp = !this.attaRef.styp

  !form.support.rest = !this

  !this.finalize(!form)
  !form.support.rest = !this

  if(!oHangerType.styp inset$!!mdsAllHangerTypes.channelAssembly or $
    !oHangerType.styp inset$!!mdsAllHangerTypes.dSSpring) then
    -- we need to set the beam span to be larger than the pipe outer diam plus double the insulation thickness
    -- plus the rod size
    !span = !this.getMinRequiredSpan()
    -- find the projected horizontal distance between the fitting
    !hangDist = !this.getMinHangDist()

    !span = !span.max(!hangDist)
    if(!newAtta) then
      -- new atta change span
      !this.changeChannelSpan(!span, TRUE)
      handle 1
        !!alert.warning('$!!error.text')
      endhandle
    else

      if(!this.newChannelSpan.set() and  !this.newChannelSpan neq !this.channelSpan ) then
        -- A new channel span has been set by the user
        if(!this.newChannelSpan lt !span) then
          -- requires new span is less than the minimum possible
          !!alert.warning('Span ' + !this.newChannelSpan.string(!!distanceFmt) + ' is more than the minimum possible ' + !span.string(!!distanceFmt) + '. Span will be set to minimum possible')
          !this.changeChannelSpan(!span, TRUE)
        endif
      elseif(!this.channelSpan.set() and !this.channelSpan lt !span) then
        -- Current channel span is less than the minimum required
        -- reset it to the minimum required
        !this.changeChannelSpan(!span, TRUE)
      endif
    endif
  endif


  if(!!mdsFH01.graphicalDim)then

    !!mdsSetDim(!!mdsFH01)
    !!mdsSetDim(!!mdsFH01)
  endif

  label /exit
  --    !this.restoreAccess()

  !!ce = !ce
  !!kRestoreUnits(!currentUnits)
  aid clear line 5
  handle ANY
  endhandle
  refresh
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.commonUpdate($!form is FORM, $!name is STRING, $!styp is STRING, $!newAtta is BOOLEAN)')
  endif
  return
  label /ERROR
  --    !this.restoreAccess()
  !!ce = !ce
  !!kRestoreUnits(!currentUnits)
  aid clear line 5
  handle ANY
  endhandle
  refresh
  if(defined(!!mdsDebug)) then
    !!mdsDebug.trace(1, '$!errText')
    !!mdsDebug.traceError('$!this' + '.commonUpdate($!form is FORM, $!name is STRING, $!styp is STRING, $!newAtta is BOOLEAN)')
  endif
  return error $!errNo |$!errText|

endmethod
----------------------------------------------------------------------------------------------


---------------------------------------------------------------------------------------------
define method .finalize(!form is FORM)

  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.finalize($!form is FORM)')
  endif
  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist

  -- Update the support member array
  --    !form.support.rest = object MDSREST()
  !support = !form.setRestObject()
  !support = !form.setSupportPacks()
  !form.support = !support
  -- Activate/Deactivate gadgets
  !form.datum.active = FALSE
  -- Saving hanger state to be able to restore it later

  !!mdsSaveHangerState(!form)

  !!kRestoreUnits(!currentUnits)
  refresh
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.finalize($!form is FORM)')
  endif
  return
endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .backUpOriginalRest(!name is STRING)

  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  !!mdsDacControl(TRUE)

  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.backUpOriginalRest($!name is STRING)')
  endif
  -- rename current REST
  /$!name/REST/BACKUP
  handle ANY
    -- first time backup
    -- rename the original for later restoration
    /$!name/REST
    ren all /$!name /$!name/BACKUP
    name /$!name/REST/BACKUP
    rem ce
  elsehandle NONE
    -- The original have been renamed already
    -- Delete the last created temporary rest
    rem ce
    /$!name/REST
    delete restr
  endhandle

  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)

  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.backUpOriginalRest($!name is STRING)')
  endif
endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .saveRestAsTemp(!name is STRING)
  -- Creates a temporary copy of the current REST
  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  !!mdsDacControl(TRUE)

  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.saveRestAsTemp($!name is STRING)')
  endif
  -- rename current REST
  /$!name/REST/TEMP
  handle ANY
    -- first time for making a temp
    /$!name/REST
    new rest copy /$!name/REST ren /$!name /$!name/TEMP
    name /$!name/REST/TEMP

  elsehandle NONE
    -- Delete the last created temporary rest
    delete restr mem
    copy /$!name/REST ren /$!name /$!name/TEMP

  endhandle
  rem ce

  !!mdsDacControl(FALSE)
  !!kRestoreUnits(!currentUnits)

  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.saveRestAsTemp($!name is STRING)')
  endif
endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .getTubeRef() is DBREF

  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.getTubeRef()')
  endif
  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  !stypToCheck = !this.styp

  !connectToStd = !stypToCheck inset$!!mdsAllHangerTypes.weldedElbowOrPipeLug
  !connectToStd = !connectToStd or !stypToCheck inset$!!mdsAllHangerTypes.weldedElbowTrunion
  -- !connectToStd = !connectToStd or !stypToCheck inset$!!mdsAllHangerTypes.riserClamp
  !connectToStd =  !connectToStd or !!mdsAllHangerTypes.riserClamp.find(!stypToCheck).size().gt(0)
  !connectToStd = !connectToStd or !stypToCheck inset$!!mdsAllHangerTypes.bM1Spring
  !connectToStd = !connectToStd or !stypToCheck inset$!!mdsAllHangerTypes.dSSpring
  !connectToStd = !connectToStd or !stypToCheck inset$!!mdsAllHangerTypes.channelAssembly
  !connectToStd = !connectToStd or !stypToCheck inset$!!mdsAllHangerTypes.doubleBM1Spring
  !connectToStd = !connectToStd or !stypToCheck inset$!!mdsAllHangerTypes.bM2Spring

  if(!connectToStd) then

    !typeToIdentify = 'ATTA'
    if(!stypToCheck inset$!!mdsAllHangerTypes.weldedElbowOrPipeLug) then
      -- Hanger is connected to a welded elbow or pipe lug
      -- We need to identify an ATTA (not just a TUBE)
      !typeToPrompt = 'Welded Elbow Lug or a Pipe Welded Lug'
      -- The styp of the identified atta should match one the following type of lugs
      !matchingStyp = !!mdsAllHangerTypes.weldedElbowOrPipeLugStd
      !associatedStyps = !!mdsAllHangerTypes.weldedElbowOrPipeLug

    elseif(!stypToCheck inset$!!mdsAllHangerTypes.weldedElbowTrunion) then
      -- Hanger is connected to a welded elbow Trunnion
      ------------------------------------------------------------------------
      -- We need to identify a PLAT (not an ATTA or just the Trunnion TUBE)
      !typeToIdentify = 'PLAT'
      !typeToPrompt = 'End Plate on Welded Elbow Trunnion'
      -- The styp of the identified PLAT should match one the following type of trunnions

      -- The styp of the identified atta should match one the following type of trunnions
      --<<--<wd>june2003
      ------------------------------------------------------------------------

      !matchingStyp = !!mdsAllHangerTypes.weldedElbowTrunionStd
      !associatedStyps = !!mdsAllHangerTypes.weldedElbowTrunion


      -- elseif(!stypToCheck inset$!!mdsAllHangerTypes.riserClamp) then
    elseif (!!mdsAllHangerTypes.riserClamp.find(!stypToCheck).size().gt(0)) then
      -- Hanger is connected to a vertical shear lug
      -- We need to identify an ATTA (not just a TUBE)
      !typeToPrompt = 'Support Lug for a Vertical Pipe'
      -- The styp of the identified atta should match one the following type of trunnions
      !matchingStyp = !!mdsAllHangerTypes.riserClampStd
      !associatedStyps = !!mdsAllHangerTypes.riserClamp

    elseif(!stypToCheck inset$!!mdsAllHangerTypes.bM1Spring) then
      -- Hanger is connected to a BM1 Spring
      -- We need to identify an ATTA (not just a TUBE)
      !typeToPrompt = 'Pipe Shoe'
      -- dtf >>> mod to allow trunnions for PIHASA
      !descOfHangersSite = desc of /MDS/HANGERS
      if (!descOfHangersSite.eq('PIHASA Hanger Configurations')) then
        !typeToIdentify = 'PLAT ATTA'
        !typeToPrompt = 'Pipe Shoe or Plate of Trunnion'
      endif
      -- dtf <<< end of mod
      -- The styp of the identified atta should match one the following type of trunnions
      !matchingStyp = !!mdsAllHangerTypes.bM1SpringStd
      !associatedStyps = !!mdsAllHangerTypes.bM1Spring


    elseif(!stypToCheck inset$!!mdsAllHangerTypes.doubleBM1Spring) then
      -- Hanger is connected to a BM1 Spring
      -- We need to identify an ATTA (not just a TUBE)
      !typeToPrompt = 'Support Lug for a Vertical Pipe'
      -- The styp of the identified atta should match one the following type of trunnions
      !matchingStyp = !!mdsAllHangerTypes.doubleBM1SpringStd
      !associatedStyps = !!mdsAllHangerTypes.doubleBM1Spring

    elseif(!stypToCheck inset$!!mdsAllHangerTypes.bM2Spring) then
      -- Hanger is connected to a BM2 Spring
      -- We need to identify an ATTA (not just a TUBE)
      !typeToPrompt = 'Pipe Cradle'
      -- The styp of the identified atta should match one the following type of trunnions
      !matchingStyp = !!mdsAllHangerTypes.bM2SpringStd
      !associatedStyps = !!mdsAllHangerTypes.bM2Spring

    elseif(!stypToCheck inset$!!mdsAllHangerTypes.dSSpringWithShoe) then
      -- Hanger is connected to a double spring with a shoe (B-14)
      -- We need to identify an ATTA (not just a TUBE)
      !typeToPrompt = 'Pipe Shoe'
      -- The styp of the identified atta should match one the following type of trunnions
      !matchingStyp = !!mdsAllHangerTypes.dSSpringWithShoeStd
      !associatedStyps = !!mdsAllHangerTypes.dSSpringWithShoe

    elseif(!stypToCheck inset$!!mdsAllHangerTypes.dSSpring) then
      -- Hanger is connected to a double spring with a cradle (B-13)
      -- We need to identify an ATTA (not just a TUBE)
      !typeToPrompt = 'Pipe Cradle'
      -- The styp of the identified atta should match one the following type of trunnions
      !matchingStyp = !!mdsAllHangerTypes.dSSpringStd
      !associatedStyps = !!mdsAllHangerTypes.dSSpring

    elseif(!stypToCheck inset$!!mdsAllHangerTypes.channelAssembly) then
      -- Hanger has a channel assembly and it is connected to a cradle (B-11)
      -- We need to identify an ATTA (not just a TUBE)
      !typeToPrompt = 'Pipe Cradle'
      -- dtf >>> mod to allow trunnions for PIHASA
      !descOfHangersSite = desc of /MDS/HANGERS
      if (!descOfHangersSite.eq('PIHASA Hanger Configurations')) then
        !typeToIdentify = 'PLAT ATTA'
        !typeToPrompt = 'Pipe Shoe or Plate of Trunnion'
      endif
      -- dtf <<< end of mod
      -- The styp of the identified atta should match one the following type of trunnions
      !matchingStyp = !!mdsAllHangerTypes.channelAssemblyStd
      !associatedStyps = !!mdsAllHangerTypes.channelAssembly

    endif

    if(!this.attaConnRef.set() and (not !this.attaConnRef.badref())) then
      !this.tubeRef = !this.attaConnRef
      handle ANY
      endhandle

      !!ce = !this.attaConnRef
      -- dtf >>> 19-07-04
      -- not all !associatedStyps are arrays so convert them
      !objectType = !associatedStyps.objectType()
      if (!objectType eq 'STRING' ) then
        !aSStemp = !associatedStyps.split(',')
        !associatedStyps.delete()
        do !i indices !aSStemp
          !associatedStyps[$!i] = !aSStemp[$!i].replace('(', '').replace(')', '').replace(|'|, ||)
        enddo
      else
        --'
      endif
      -- dtf <<<<
      -- if (!!ce.styp inset$!matchingStyp and !stypToCheck inset$!associatedStyps) then
      if (!!ce.styp inset$!matchingStyp and !associatedStyps.findfirst(!stypToCheck).set()) then
        -- compatible connection types
        -- we can change configuration

      else
        !!kRestoreUnits(!currentUnits)
        --        return error 1 'Connections not compatible. Can not change to this type configuration'
        !this.attaConnRef = object DBREF()
          golabel /IDENTIFY
        endif
    else
      golabel /IDENTIFY
    endif

  else

    -- Hanger needs an atta to be created
    !typeToIdentify = 'TUBE'
    !typeToPrompt = 'Tube'
    !matchingStyp = '(||)'
    if(!this.tubeRef.set() and (not !this.tubeRef.badref())) then

      !!ce = !this.tubeRef
      -- Check that the current connection is not a lug or Trunnion connection
      -- if it a lug or Trunnion connection then the new type can not be used.
      -- Lugs and Trunnion types can only be modified with types having the same connection type
      if(!this.attaConnRef.set() and (not !this.attaConnRef.badref())) then
        --------------------------------------------------------------------------------------
        --<wd>>jun2003
        -- The variable !this.tubeRef was set to the BRANCH element, which caused an errorattaConnRef
        -- with the syntax - !styp = !!ce.styp - show below on line 1394.
        -- Therefore the variable  - !this.tubeRef - is NOW set to the variable - !this. - ,
        -- as per the line 1341 shown above, to avoid getting the ERROR.
        !this.tubeRef = !this.attaConnRef
        !!ce = !this.tubeRef
        --<<wd>jun2003
        --------------------------------------------------------------------------------------

        !styp = !!ce.styp

        if(!styp inset$!!mdsAllHangerTypes.weldedElbowOrPipeLug or $
          !!mdsAllHangerTypes.riserClamp.find(!styp).size().gt(0) or $
          !styp inset$!!mdsAllHangerTypes.bM1Spring or $
          !styp inset$!!mdsAllHangerTypes.doubleBM1Spring or $
          !styp inset$!!mdsAllHangerTypes.dSSpring or $
          !styp inset$!!mdsAllHangerTypes.channelAssembly or $
          !styp inset$!!mdsAllHangerTypes.bM2Spring) then
          -- use the dummy atta
          !!ce = !this.attaRef
          !this.tubeRef = !!ce
          !this.attaConnRef = !!ce
          -- !styp inset$!!mdsAllHangerTypes.riserClamp or

        elseif(!styp inset$!!mdsAllHangerTypes.weldedElbowTrunion) then

          !!kRestoreUnits(!currentUnits)
          return error 1 'Connections not compatible. This hanger type needs to be connected to a Welded Elbow Trunnion'
        endif
      endif
    else

      golabel /IDENTIFY
    endif
  endif

  !!kRestoreUnits(!currentUnits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.trace(1, 'Hanger styp is: $!stypToCheck')
    !!mdsDebug.traceOut(1, '$!this' + '.getTubeRef()')
  endif
  return !!ce



  label /IDENTIFY
  -- tubeRef is not set or is not of the required matching styp
  -- Identify the Appropriate type.
  prompt off

  prompt load escape 'Identify $!typeToPrompt to support'
  ID $!typeToIdentify @
  handle (61,528)
    -- User exit
    prompt on
    refresh
    !!kRestoreUnits(!currentUnits)
    return error 99
  endhandle

  prompt on
  if(!!ce.owner.type.neq('BRAN') and !!ce.type.neq('BRAN')) then
    -- this is not a pipe component
    -- re-identify
    golabel /IDENTIFY
  endif


  if(!stypToCheck inset$!!mdsAllHangerTypes.weldedElbowTrunion) then
    -- In case the user has identified any other support element of the Trunnion (e.g. the plate)
    -- we need to be sure that we check the correct atta styp
    --<tm fix???

    -- !!ce = !datumname

    --$P ** Prompt = $!typeToPrompt ** and TYPE to IDENTIFY = $!typeToIdentify

    if(!!ce.name.upcase().match('/SREF') eq 0) then
      !datumname = '/' + !!ce.name.after('/').before('/') + '/SREF'
    endif

    --$P** !datumname is :-
    --q var !datumname
    --$P------------------------------------
    !!ce = !datumname.dbref()
    handle ANY
      golabel /IDENTIFY
    endhandle
  endif


  if(!typeToIdentify.neq('TUBE'))then
    --    if(not !!ce.styp.substring(1, max(4, !!ce.styp.length() - 1)) inset$!matchingStyp) then
    --$P if(not !!ce.styp inset$!matchingStyp) then
    if(not !!ce.styp inset$!matchingStyp) then
      -- The styp of the selected atta is not matching to the styp required
      golabel /IDENTIFY
    else
      --      !this.attaConnRef = !!ce
    endif
  endif

  !this.tubeRef = !!ce
  !!kRestoreUnits(!currentUnits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.getTubeRef()')
  endif
  return !!ce
endmethod
-------------------------------------------------------------------------------------------


-------------------------------------------------------------------------------------------
define method .restoreAccess()
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.restoreAccess()')
  endif
  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  !ce = !!ce
  if(!this.attaConnRef.set() and (not !this.attaConnRef.badref()) ) then
    if(!this.attaConnRefLocked.set() and !this.attaConnRefLocked) then
      -- Connected atta was locked
      if(!this.styp inset$!!mdsAllHangerTypes.weldedElbowTrunion) then
        !!ce = !this.attaConnRef
        handle ANY
          !!kRestoreUnits(!currentUnits)
          if(defined(!!mdsDebug)) then
            !!mdsDebug.traceError('Unable to lock atta. $!this.attaConnRef not found')
          endif
          return error 1 'Unable to lock atta. $!this.attaConnRef not found'
        elsehandle NONE
          bran
          lock all
          !!kRestoreUnits(!currentUnits)
          if(defined(!!mdsDebug)) then
            !!mdsDebug.trace(1, 'Relocked atta $!this.attaConnRef.name')
          endif
          -- unlock the rest atta (the atta that has the same name)
          !!ce = !this.attaRef
          handle ANY
            -- This atta might have been deleted when the cancel button was clicked
          elsehandle NONE
            unlock ce
          endhandle
        endhandle
      endif
    endif
  endif
  !!ce = !ce
  !!kRestoreUnits(!currentUnits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.restoreAccess()')
  endif
endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .setRestObject()
  --     if(!this.ref.unset()) then
  if (!!ce.type.neq('REST')) then
    return error 1 'In $!this.setRestObject() current element is a $!!ce.type. It must be a REST'
  endif
  !this.ref = !!ce
  !this.name = !!ce.name
  !attaName = !this.name.before('/REST')
  !attaRef = !attaName.dbref()
  !this.styp = !attaRef.styp
  --> <ab> 13 aug 2002
  !this.bore = !attaRef.lbore
  --> <ab> 13 aug 2002

  !this.bore
  --     endif

  --><wd>17aug2009 -- DFN P-22111 (SI-13209) -- The CODE below is ONLY called if user is at a RESTRAINT (REST) element
  !this.updateBeamRefArray()
  !hangers = !this.hangers
  !this.rodSize = REAL()

  do !h

    $!h
    handle ANY
      break
    endhandle

    !oHang = object MDSHANG()
    !oHang.ref = !!ce
    !oHang.func = !!ce.func

    !oHang.name = !!ce.name
    !hangMem = ARRAY()


    do !i
      $!i

      handle ANY
        break
      endhandle

      if(!!ce.type.neq('PCLA') and !this.rodSize.unset())then
        -- saves the current rest rod size
        -- when modifying the rest, the application will check if the new rod size is different than the current rod size
        -- if yes, than all the rest components will be reselected with the new rod size and reconnected
        -- This will give us a new standard hanger heigh to relate to when calling the MdsFH01.resize() method.
        !bore = pl bore
        !this.rodSize = !bore.real()
        if(!this.rodSize eq 0) then
          -- invalid rod size in this component
          -- we re-unset the value so it will be set by the next component
          !this.rodSize = REAL()
        endif
      endif
      if(!i eq 1 and !!ce.type.eq('HELE') and !!ce.styp.eq('CHANNEL ASSEMBLY') and !this.styp inset$!!mdsAllHangerTypes.channelAssembly) then
        !channelSpan = prop span
        handle ANY
          !!alert.error('property SPAN is not defined for $!!ce.fullname. You will not be able to change the Channel span')
        elsehandle NONE
          !this.channelSpan = !channelSpan.real()
        endhandle
      elseif(!i eq 1 and !!ce.type.eq('HELE') and !!ce.styp.eq('ANGLE ASSEMBLY') and !this.styp inset$!!mdsAllHangerTypes.channelAssembly) then
        !channelSpan = prop span
        handle ANY
          !!alert.error('property SPAN is not defined for $!!ce.fullname. You will not be able to change the Channel span')
        elsehandle NONE
          !this.channelSpan = !channelSpan.real()
        endhandle
      elseif(!i eq 1 and !!ce.type.eq('HELE') and !!ce.styp.eq('HEB ASSEMBLY') and !this.styp inset$!!mdsAllHangerTypes.channelAssembly) then
        !channelSpan = prop span
        handle ANY
          !!alert.error('property SPAN is not defined for $!!ce.fullname. You will not be able to change the Channel span')
        elsehandle NONE
          !this.channelSpan = !channelSpan.real()
        endhandle
      elseif(!i eq 1 and !!ce.type.eq('VSPR') and !this.styp inset$!!mdsAllHangerTypes.dSSpring) then
        !channelSpan = prop span
        handle ANY
          !!alert.error('property SPAN is not defined for $!!ce.fullname. You will not be able to change the Channel span')
        elsehandle NONE
          !this.channelSpan = !channelSpan.real()
        endhandle
      endif
      if(!!ce.type.eq('PCLA')) then
        !this.pipeClampsRefs.append(!!ce)
      endif
      !mem = object MDSHANGMEM()
      !mem.mirror    = FALSE
      !mem.rotateCur = FALSE
      !mem.canRotate = TRUE
      !mem.rotated   = 0
      !mem.type = !!ce.type
      !mem.ref = !!ce
      !mem.pLDir = pl dir wrt /*
      !mem.pADir = pa dir wrt /*
      !mem.styp = !this.styp
      !hangMem[!i] = !mem
      hang
    enddo


    !oFitt = object MDSFITT()
    if(!oHang.fitt.unset() and !!ce.tref.set() and !!ce.tref.type.eq('FITT')) then
      !oFitt.ref = !!ce.tref
      !oFitt.name = !!ce.tref.name
    endif
    !oHang.fitt = !oFitt
    if(defined(!!mdsDebug)) then
      if(!oHang.fitt.ref.set())then
        !!mdsDebug.trace(1, 'Redefined the fitt object of rest object $!!ce.name to $!oHang.fitt.ref.name')
      else
        !!mdsDebug.trace(1, 'Can not redefined the fitt object of rest object $!!ce.name$n. Hanger tail does not reference a Fitting')
      endif
    endif

    !oHang.hangMem = !hangMem
    !hangers[!h] = !oHang
    rest
  enddo

  !this.hangers = !hangers
endmethod
-------------------------------------------------------------------------------------------


-------------------------------------------------------------------------------------------
define method .changeRodSize()

  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.changeRodSize()')
  endif
  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  !ce = !!ce
  -- Save the beam ref array

  !beamRefArray = !this.beamRefArray
  -- Assure that the rest objects points to the new restr and not to the original one
  -- Update the rest objects to points to the new restr with the new spref for the new rod size
  !!ce = !this.ref
  !this.setRestObject()
  !hangers = !this.hangers
  do !h indices !hangers
    !oHang = !hangers[!h]
    -- update the reference to the owning rest object
    !oHang.rest = !this

    !oHang.changeRodSize()
    handle ANY
      !err = !!error.text
      !errNo = 1
      golabel /ERROR
    endhandle
    !hangers[!h] = !oHang
  enddo
  !this.hangers = !hangers
  -- Restore the beam ref array
  !this.beamRefArray = !beamRefArray
  !!ce = !ce
  !!kRestoreUnits(!currentUnits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceOut(1, '$!this' + '.changeRodSize()')
  endif
  return
  label /ERROR
  !!kRestoreUnits(!currentUnits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.trace(1, '$!errNo - $!err')
    !!mdsDebug.traceError('$!this' + '.changeRodSize()')
  endif
  return error $!errNo |$!err|
endmethod
-------------------------------------------------------------------------------------------


-------------------------------------------------------------------------------------------
define method .insertPclaAdapter(!name is STRING, !styp is STRING)
  -- Inserts a pipe clamp adapter hele to adjust the fixed bore of the pipeclamp
  -- to the variable rod sizes
  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  !ce = !!ce
  !restName = '/' + !name + '/REST'
  !!ce = !restName.dbref()
  -- if(!styp inset$!!mdsAllHangerTypes.riserClamp) then
  if (!!mdsAllHangerTypes.riserClamp.find(!styp).size().gt(0)) then
    -- loops through hangers
    do !index from 2 to 3
      hang$!index
      !hBore = hbore
      !hBoreR = !hBore.real()
      -- gets the arrive bore of the first element
      var !lbor pa bore of 1
      head
      -- Add the pipe bore adapter
      new hele
      spref /MDS/H-00P00PR00
      -- sets the arrive bore to be the same as the leave bore of the pipe clamp
      -- sets the leave bore to be the same as the arrive bore of the next component
      desp $!hBoreR $!lbor
      conn
    enddo
    rest
  else
    do !index indices !!mdsAllHangerTypes.pipeClamp
      --<RM> 10/08/2011 it was found with large numbers of hangers available in the .pipeClamp member the inset command could fail
      --due to a memory problem. the fix included below works around this issue by splitting the long string of hanger names into an array
      --which is then searched via do loop - start
      !arr = !!mdsAllHangerTypes.pipeClamp[!index].split(',')
      !found = FALSE
      do !i from 1 to !arr.size()
        if (!arr[!i].trim().eq(!styp)) then
          !found = TRUE
        endif
      enddo
      if (!found) then
      --<RM> 10/08/2011 it was found with large numbers of hangers available in the .pipeClamp member the inset command could fail
      --due to a memory problem. the fix included below works around this issue by splitting the long string of hanger names into an array
      --which is then searched via do loop - end
        -- Goto pipe clamp
        1 of hang1
        !pclaBore = pl bore
        !pclaBoreR = !pclaBore.real()
        -- Add the pipe bore adapter
        new hele
        spref /MDS/H-00P00PR00
        -- sets the arrive and leav bore to be the same as the leave bore of the pipe clamp
        desp $!pclaBoreR $!pclaBoreR
        conn
        rest
        break
      endif
    enddo
  endif
  !!kRestoreUnits(!currentUnits)
  !!ce = !ce
endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .getAvailableReselectBores() is ARRAY
  if(defined(!!mdsDebug)) then
    !!mdsDebug.traceIn(1, '$!this' + '.getAvailableReselectBores()')
  endif
  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  -- test if the list has already been created once
  !oHangType = !!mdsAllHangerTypes.gethangertype(!this.styp)
  if(!oHangType.availableRodSizesInCatalog.set() and (not !oHangType.availableRodSizesInCatalog.empty())) then
    return !oHangType.availableRodSizesInCatalog
  endif
  !availableSizes = ARRAY()
  !hangers = !this.hangers
  do !h indices !hangers
    !oHang = !hangers[!h]
    !hAvailableSizes = !oHang.getAvailableReselectBores()
    if(!availableSizes.empty()) then
      !availableSizes = !hAvailableSizes
    else
      if(!hAvailableSizes.size() gt 1) then
        !availableSizes = !availableSizes.intersect(!hAvailableSizes)
      endif
    endif
  enddo
  -- set the oHangtype availableRodSizesInCatalog attribute and update the
  -- !!mdsAllHangerTypes object
  !oHangType.availableRodSizesInCatalog = !availableSizes
  !!mdsAllHangerTypes.sethangertype(!this.styp, !oHangType)
  !!kRestoreUnits(!currentUnits)
  if(defined(!!mdsDebug)) then
    !!mdsDebug.trace(1, 'Available Sizes Array has ' + STRING(!availableSizes.size()) + ' elements')
    !!mdsDebug.traceOut(1, '$!this' + '.getAvailableReselectBores()')
  endif
  return !availableSizes
endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .changeChannelSpan(!newSpan is REAL, !reselect is BOOLEAN)
  -- Change the span C-C for a channel assembly (GRINNELL now ANVIL) or for a dSSpring beam

  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  !ce = !!ce
  !!mdspushpin(2)
  !!mdspushpin(3)
  !!mdspushpin(4)
  !hangers = !this.hangers
  do !i indices !hangers
    if(defined(!!mdsDebug)) then
      !!mdsDebug.trace(2, 'Changing span in Hang Object No. $!i')
    endif
    !oHang = !hangers[!i]
    if(!i eq 1 and (!this.styp inset$!!mdsAllHangerTypes.dSSpring or $
      !this.styp inset$!!mdsAllHangerTypes.channelAssembly or !!mdsAllHangerTypes.riserClamp.find(!this.styp).size().gt(0))) then
      1 of $!oHang.ref
      -- Check if required span is not larger that the maximum available
      !maxSpan = prop mxsp
      if(!newSpan gt !maxSpan.real()) then
        !err = 'Required span ' + !newSpan.string(!!distanceFmt) + ' is greater than the maximum available span ' + !maxSpan.real().string(!!distanceFmt)
        return error 1 |$!err|
      endif
      !hm = object MDSHANGMEM(!!ce)
      -- gets an property definition array (e.g. {'DESP',1} or {'PARA',3} or {'HEIG'} or {'DATA'})
      !paras = !hm.getDataParaForDkey('SPAN')

      !!mdsDacControl(TRUE)
      if(!paras[1].eq('DESP')) then
        $!paras[1] num $!paras[2] $!newSpan
      elseif(!paras[1].neq('PARA')) then
        $!paras[1] $!newSpan
      endif
      !!mdsDacControl(FALSE)
      -- pin2 at connection point of the other hanger
      pin3 at pl
      !poinNum = !hm.getCrfaPPointNum()
      -- pin3 at connection point of one hanger
      pin2 at p$!poinNum
      if(!reselect) then
        if((!this.newRodSize.set() and !this.rodSize.set()) and (!this.newRodSize neq !this.rodSize)) then
          !hm.ref.spref = !hm.reselectBore(!this.newRodSize)
          handle ANY
          endhandle
        else
          !hm.ref.spref = !hm.reselectBore(!this.rodSize)
          handle ANY
          endhandle
        endif
      endif
      !!ce = !hm.ref
      end
      !!mdsDacControl(TRUE)
      conn ht to last mem
      !!mdsDacControl(FALSE)
    else

      !!ce = !oHang.fitt.ref
      -- pin4 positioned at p1 of the fitting
      pin4 copy p1
      -- pin4 direction is along the beam axis
      pin4 dir pplin na of own y dir
      -- pin !i direction set to be the same as pin4
      pin$!i dir pin4
      -- distance from start of beam to connection point of the DSspring or the channel assembly
      var !newDist const dist pplin na of own start to plan pin$!i
      zdist $!newDist
      !!mdsFH01.resizeHanger(!oHang.ref, !oHang.fitt.ref)
      -- 12/2002 <ab>
      handle 51
        -- If we reached this place, user have accepted the error
        -- so we can continue
      elsehandle ANY
        !errNo = 1
        !errText = '$!!error.text'
        golabel /ERROR
      endhandle
    endif
  enddo

  !!mdspoppin(2)
  !!mdspoppin(3)
  !!mdspoppin(4)
  !!ce = !ce
  !!kRestoreUnits(!currentUnits)
  return
  label /ERROR
  !!mdspoppin(2)
  !!mdspoppin(3)
  !!mdspoppin(4)
  !!ce = !ce
  !!kRestoreUnits(!currentUnits)
  return error $!errNo |$!errText|

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .getMinRequiredSpan() is REAL
  if(!!mdsAllHangerTypes.riserClamp.find(!this.styp).size().gt(0)  ) then
    !currentUnits = !!kGetSetUnits()
    units mm bore mm dist
    !ce = !!ce
    -- Go to PCLA of dSSpring
    pcla 1 of $!this.hangers[1].name
    handle ANY
      return -1
    endhandle
    !minSpan = prop MINS
    !!ce = !ce
    !!kRestoreUnits(!currentUnits)
    return !minSpan.real()
  else
    -- we need to set the beam span to be larger than the pipe outer diam plus double the insulation thickness
    -- plus the rod size
    !currentUnits = !!kGetSetUnits()
    units mm bore mm dist
    !ce = !!ce
    !outDia = !this.attaRef.lstub.param[2]
    !!ce = !this.attaRef
    var !insuThk insu
    !span = !outDia + 2 * !insuThk.real()
    if((!this.newRodSize.set() and !this.rodSize.set()) and (!this.newRodSize neq !this.rodSize)) then
      !span = !span + !this.newRodSize
    else
      !span = !span + !this.rodSize
      handle (2,754)
        -- !this.rodSize is unset
      endhandle
    endif
    !!ce = !ce
    !!kRestoreUnits(!currentUnits)
    return !span
  endif
endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .getMaxAvailableSpan() is REAL
  -- >>> mod to allow variable size pcla on riser clamps
  if(!!mdsAllHangerTypes.riserClamp.find(!this.styp).size().gt(0)  ) then
    !currentUnits = !!kGetSetUnits()
    units mm bore mm dist
    !ce = !!ce
    -- Go to PCLA of dSSpring
    pcla 1 of $!this.hangers[1].name
    handle ANY
      return -1
    endhandle
    !maxSpan = prop MXSP
    !!ce = !ce
    !!kRestoreUnits(!currentUnits)
    return !maxSpan.real()
  elseif(not (!this.styp inset$!!mdsAllHangerTypes.dSSpring or !this.styp inset$!!mdsAllHangerTypes.channelAssembly)) then
    return -1
  else
    !currentUnits = !!kGetSetUnits()
    units mm bore mm dist
    !ce = !!ce
    -- Go to Vspr of DSSpring
    1 of $!this.hangers[1].name
    handle ANY
      return -1
    endhandle
    !maxSpan = prop MXSP
    !!ce = !ce
    !!kRestoreUnits(!currentUnits)
    return !maxSpan.real()
  endif
endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .getCurrentSpan() is REAL
  -- >>> mod to allow variable size pcla on riser clamps
  if(!!mdsAllHangerTypes.riserClamp.find(!this.styp).size().gt(0)  ) then
    !currentUnits = !!kGetSetUnits()
    units mm bore mm dist
    !ce = !!ce
    -- Go to PCLA of dSSpring
    pcla 1 of $!this.hangers[1].name
    handle ANY
      return -1
    endhandle
    !maxSpan = prop SPAN
    !!ce = !ce
    !!kRestoreUnits(!currentUnits)
    return !maxSpan.real()
  elseif(not (!this.styp inset$!!mdsAllHangerTypes.dSSpring or !this.styp inset$!!mdsAllHangerTypes.channelAssembly)) then
    return -1
  else
    !currentUnits = !!kGetSetUnits()
    units mm bore mm dist
    !ce = !!ce
    -- Go to Vspr of DSSpring
    1 of $!this.hangers[1].name
    handle ANY
      return -1
    endhandle
    !span = prop SPAN
    !!ce = !ce
    !!kRestoreUnits(!currentUnits)
    return !span.real()
  endif
endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .getCurrentOlap() is REAL
  if(not (!this.styp inset$!!mdsAllHangerTypes.dSSpring or !this.styp inset$!!mdsAllHangerTypes.channelAssembly)) then
    return -1
  endif
  !currentUnits = !!kGetSetUnits()
  units mm bore mm dist
  !ce = !!ce
  -- Go to Vspr of DSSpring or Hele 1 of channelassembly
  1 of $!this.hangers[1].name
  handle ANY
    return -1
  endhandle
  !olap = prop OLAP
  handle (2,207)
    -- >>> dtf 040804
    -- property does not exist so set it to 0 and the form will not make gadget active
    return -1
  endhandle
  !!ce = !ce
  !!kRestoreUnits(!currentUnits)
  return !olap.real()
endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .getMinHangDist() is REAL
  -- Finds the minimum distance between two hangers axes
  !hangRef1 = !this.hangers[2].ref
  !hangRef2 = !this.hangers[3].ref
  !line1 = object LINE(!hangRef1.hpos, !hangRef1.tpos)
  !line2 = object LINE(!hangRef2.hpos, !hangRef2.tpos)
  --<GE> 08/02/07 Fix for Defect No: 10234
  if (!line1.distance(!line2) eq 0) then
    return !line1.distance(!line2.startposition)
  else
    return !line1.distance(!line2)
  endif
  -- return !line1.distance(!line2)
  --<GE> 08/02/07 Original line above returning 0
endmethod
