--
-- Author:		Wayne Dodwell
-- Created:		Thursday 11th May 2006
--
--
-- Description:
-- Object to STORE the MDS Ancillary "SELECTION" and "RESTRICTION" Ancillaries
--
-- ****************************************************************************
-- **********************
-- *** IMPORTANT NOTE ***
-- **********************
-- <wd>may2006<mds12>
-- This MDS PML OBJECT, i.e. *** mdsselection.pmlobj ***, has been rewritten for MDS12DEV,
-- and is stored in the MDS12DEV DEVELOPMENT directory:i.e.
-- s:\dev\mds12dev\pmllib12.0\design\objects\mdsselection.pmlobj
-- **********************
-- This NEW OBJECT totally replaces the EXISTING OBJECT of the same name stored
-- in the MDS11.6 DEVELOPMENT directory: i.e.
-- s:\dev\mdsdev\pmllib\design\objects\mdsselection.pmlobj
-- ****************************************************************************
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsselection(STRING)             -
--

-- Define Object
define object MDSSELECTION

-- Selection List
  member .selection is ARRAY

-- Restriction list
  member .restriction is ARRAY

-- Selection Data Element Member EXISTS
  member .selexsts is BOOLEAN

-- Restriction Data Element Member EXISTS
  member .rstrxsts is BOOLEAN

-- Continue Member
  member .continue is BOOLEAN

  -- code name and client code name of component
  member .nam is STRING
  member .rnam is STRING

  --><wd>06mar2009 - Defect No. P-16924 -- NWELDS members added for use by SPOOLER module
  member .pipeWeld is REAL
  member .trunWeld is REAL
  --<<wd>06mar2009

-- End object
endobject

------------------------------------------------------------------------------------
-- Constructor Method
--
define method .mdsselection(!mdsstd is STRING )

  --><wd>06mar2009 - Defect No. P-16924
  -- Set the object members to the EXISTING ATTA NWELDS attribute default values of 0 and 0 for use by SPOOLER module
  -- The values of 0 and 0 shown below will be OVERWRITTEN if the appropriate settings are INCLUDED in the MDS application
  -- DES-SUPP-DEFS default file
  !this.pipeWeld = 0
  !this.trunWeld = 0
  --<<wd>06mar2009

-- Set the Default Settings for the BOOLEAN Object Members
  !this.selexsts = FALSE
  !this.rstrxsts = FALSE
  !this.continue = FALSE

-- Initialise Variables
  --if (!mdsstd inset (|AN04|)) then
  if (!mdsstd.matchwild(|AC*|) or !mdsstd.matchwild(|AN*|) or !mdsstd.matchwild(|AT*|) or !mdsstd.matchwild(|gt*|) or !mdsstd.matchwild(|SU*|) or !mdsstd.matchwild(|ST*|)) then
-- Determine the available MDS ANCILLARIES on which the MDS ATTA "AN04" ANCHOR ANCILLARY is ALLOWED
    !sectref = '/MDS/ATTA/DEFAULTS/' & !mdsstd
  else
-- Determine the available MDS ANCILLARIES ALLOWED on the MDS FRAMEWORK STANDARD
    !sectref = '/MDS/STRUCTURE/DEFAULTS/' & !mdsstd
  endif

-- Determine if the MDS Standard SELECTION Data Element EXISTS
  !seledata = !sectref & |/GEN/SELE|
  !seledbrf = !seledata.dbref()
  handle NONE
    !this.selexsts = TRUE

    -- get the code name for the component
    !codeString = !sectref & |/GEN/CODE|
    !namString = !codeString.dbref().pprop
    !this.nam = $!namString

    -- get the client name for the component
    !ccodString = !sectref & |/GEN/CCOD|
    !rnamString = !ccodString.dbref().pprop
    !this.rnam = $!rnamString

-- Determine if the MDS Standard RESTRICTION Data Element EXISTS
    !rstrdata = !sectref & |/GEN/RSTR|
    !rstrdbrf = !rstrdata.dbref()
    handle NONE
      !this.rstrxsts = TRUE
    elsehandle ANY
      !this.rstrxsts = FALSE
    endhandle
  elsehandle ANY
    !this.selexsts = FALSE
  endhandle

-- ONLY continue when BOTH of the SELECTION and RESTRICTION DATA Elements exist
  if ((!this.selexsts) and (!this.rstrxsts)) then
    !this.continue = TRUE
  endif

-- Determine the MDS ANCILLARY ATTA SELECTION and RESTRICTION ARRAYS
  if (!this.continue) then
-- FIRST get the data from the MDS CATALOGUE DEFAULTS stored in the MDS PARAGON DEFAULTS DB
    !selectionpprop   = $!seledbrf.pprop
    !this.selection   = !selectionpprop.split(|,|)

    !restrictionpprop = $!rstrdbrf.pprop
    !this.restriction = !restrictionpprop.split(|,|)
-- SECOND always RESTRICT, *** on EVERY MDS SUPPORT TYPE ***,
-- the MDS ANCILLARY ATTA STANDARDS shown below:
-- RESTRICT the PIPE PENETRATION SEALS modelled as MDS ANCILLARY ATTAS
    !this.restriction.append(|AT43*|) $* Pipe Penetration Single Seal
    !this.restriction.append(|AT44*|) $* Pipe Penetration Single Seal
    !this.restriction.append(|AT45*|) $* Pipe Penetration Double Seal
    !this.restriction.append(|AT46*|) $* Pipe Penetration Double Seal

    -- <rm 31/07/09> added this to remove a blank string from the restriction list at element 1
    if (!this.restriction[1].eq('')) then
      !tempArray = !this.restriction.deletefrom(2)
      !this.restriction = !tempArray.compress()
    endif
    -- <rm 31/07/09> -- end

-- RESTRICT the OBSOLETE TRUNNION ATTA Pedestals and GUIDE
    -- <rm 30/07/09> NO DEFAULTS EXIST FOR THE ITEMS BELOW SO COMMENT THEM OUT IN CASE WE GO LOOKING FOR THE DEFAULTS
    -- AFTER THE RESTRICTION LIST HAS BEEN RETURNED
    --!this.restriction.append(|GT04|)  $* Pedestal Base Plate Guide
    --!this.restriction.append(|AT10A|) $* Pedestal Atta
    --!this.restriction.append(|AT10B|) $* Pedestal Atta
    --!this.restriction.append(|AT11A|) $* Pedestal Atta
    --!this.restriction.append(|AT11B|) $* Pedestal Atta
    --!this.restriction.append(|AN01*|) $* Anchor Type Pedestal Atta
    -- <rm 30/07/09> - END
  endif

endmethod
