--
-- File: MdsSupport.pmlobj
--   Type: Object Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: design
--   Replaces:
--
-- Author: I.osborne
-- Created: Tue Jun 10
--
--
-- Description:
-- Multi Discipline support object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  associations()                   -
--  associations(ARRAY)              -
--  checkBore(BORE,DBREF)            -
--  crossBars()                      ARRAY               returns cross-bars currently exists within support
--  dimensionsEqual(REAL,REAL)       BOOLEAN
--  enhance(BOOLEAN)                 -
--  frmw()                           DBREF               returns MAIN frmw below support structure
--  getelemforuda()                  DBREF
--  mdssupport()                     -
--  referenceAtta()                  ARRAY
--  singlePick(STRING,STRING)        DBREF
--  sref()                           DBREF               returns SREF atta
--  storeFt(FORM)                    -
--  verticals()                      ARRAY
--

-- Define Object
define object MDSSUPPORT

  -- Support Standard Type
  member .type       is STRING

  -- Support Replacement Type
  member .replace    is STRING

  -- Datum Atta
  member .datum      is DBREF

  -- Has Datum Been Position
  member .position   is BOOLEAN

  -- Datum P9 orientation
  member .p9dir      is DIRECTION

  -- Datum P10 orientation
  member .p10dir     is DIRECTION

  -- Datum P11 orientation
  member .p11dir     is DIRECTION

  -- Datum PLeave Direction
  member .pldir      is DIRECTION

  -- Datum PArrive Direction
  member .padir      is DIRECTION

  -- Steel FrameWork
  member .stru       is DBREF

  -- Additional Reference Atta's
  member .atta       is ARRAY

  -- Cross-Bars on support (Reference atta held)
  member .bars       is ARRAY

  -- Length of cross bars
  member .barlen     is ARRAY

  -- Bed Plate Reference
  member .bedplate1  is DBREF

  -- Bed Plate Reference
  member .bedplate2  is DBREF

  -- Number of allowable bedplate references
  member .bpnum      is REAL

  -- Has the Support Been Mirrored
  member .mirror     is BOOLEAN

  -- Rotated Manually (Degrees)
  member .rotated    is REAL

  -- Rotated on creation by cursor
  member .rotatecur  is BOOLEAN

  -- Handed on creation by cursor
  member .handedcur  is BOOLEAN

  -- Configuration number of support if there is more than 1
  member .config     is REAL

  -- Offset of attas on support crossbar (only available on certain supports.)
  member .offset     is STRING

  -- For those frameworks with alias frameworks
  member .alias      is STRING

  -- Used to find out if the framework is in new or modify mode
  member .modify     is BOOLEAN

  -- Used to reposition support
  member .oldposition is POSITION

  -- Used to re-orientate after modification cancel
  member .oldorientation is ORIENTATION

  -- Used to reset the design parameters after modification
  member .olddespars is ARRAY

  -- User to restore a cancel support back to it's original spref
  member .oldspref is DBREF

  member .oldSuppFunc is STRING

  -- User to restore a cancel support back to it's original type
  member .oldtype       is STRING

  -- User to restore a cancel support back to it's original connection ref to an hanger
  member .oldcref       is DBREF

  -- Stores Packing Pieces on Framework
  member .packs      is ARRAY

  -- Stores whether Spherical Washers Required on The Support
  member .swasher    is BOOLEAN

  -- Array of beams picked for cursor and clearance
  member .connections is ARRAY

  -- Array of joints used
  member .joints is ARRAY

  -- Stores material settings of framework sections
  member .material is ARRAY

  -- Stores restraint data
  member .rest is MDSREST

  -- Stores DAC queries from mdsselectsupp
  member .dac is ARRAY

  -- Rack object
  member .stack is MDSLEVELSTACK

  --<wd>jan2004
  -- DBREF of the Identified Branch when Adding a Pipe to a MDS Framework Support
  -- Required now that MOST MDS Ancillaries may be added on to a MDS Framework Support
  member .idbran is DBREF
  member .idcomp is DBREF

  --<wd>jan2004
  --<wd>nov2004
  -- ARRAY object member containing a "6" index array of DIRECTION objects for the "ORTHOGONAL" directions of the DATUM ATTA,
  -- i.e. REMOVES the "sloping" direction on a sloping HORIZONTAL "DATUM " pipe.
  -- The array indices of the DATUM Atta "ORTHOGONAL" directions are stored as follows:-
  -- [1] = PLDIR  [2] =PDIR
  -- [3] = P9DIR  [4] = P9DIR.opposite()
  -- [5] = P10DIR [6] = P11DIR which is P10DIR.opposite()
  member .datumorthdirs is ARRAY
  --<wd>nov2004

  --<tm>14/02/2005 15:10
  -- new object for dealing with :mdsancref connections
  member .plateconns is MDSBPLATECONN

  -- Tdir for hangers
  member .tdir is DIRECTION
  member .offsety is DIRECTION
  member .offsetx is DIRECTION
  member .tposition is POSITION
  member .headtoTaildir is DIRECTION

  --<tm>01/04/2005 11:15
  -- new member for recording if the slope is greater than the preset gradient
  member .overgrad is BOOLEAN

  --<wd>jun2007<mds12>
  -- New Object Member ARRAy for Storing the MDS Support Associations OBJECTS (ASSOCs etc...)
  member .associations is ARRAY
  --<wd>jun2007<mds12>

  --<wd>aug2007<mds12>
  -- New Object Member .mdssctns for Storing the CURRENET ARRAY of MDS Support SCTN 'MDSSCTN' and SNIPES 'MDSFITTING' DATA OBJECTS
  member .mdssctns is ARRAY
  -- New Object Member .mdssctnsstore for use when RESIZING/CHANGING the MDS FRMW TEMPLATE
  -- to REGENERATE and UPDATE the existing MDS SNIPES with a PURPOSE of 'XGUI'
  member .mdssctnsstore is ARRAY
  --<wd>aug2007<mds12>

  --<dw>sep2007
  -- Array to store bracing information
  member .bracings is ARRAY
  --<dw>sep2007

  -- Form Storage for positions of attas that are being added as reference attas - MDSSIE04
  member .attaRefPositionStore       is ARRAY

  -- Form Storage for preliminary restoration
  member .preliminaryStore       is ARRAY

  member .attaRefPrelimStore       is ARRAY

  -- Array to store compensation information
  member .compensation is ARRAY

  -- End object
endobject

--------------------------------------------------------------------------------

define method .mdssupport()

  !this.plateconns = object MDSBPLATECONN()
  -- MDSSIE04
  !this.attaRefPositionStore = object ARRAY()

endmethod

--------------------------------------------------------------------------------

--<kp> Jul07
--method to get target element to set some UDAs (:MdsAdp, :MdsAdpRem, :MdsViewFlip, etc.)
define method .getelemforuda() is DBREF

  if !this.stru.badref().not() then
    !target = !this.stru
  elseif !this.rest.ref.badref().not() then
    !target = !this.rest.ref
  else
    !target = !this.datum
  endif

  return !target

endmethod
--------------------------------------------------------------------------------
--<kp>jan2012
-- few methods added
------------------------------------------------------------------------
--
-- Method:      crossBars
--
-- Description: returns cross-bars currently exists within support
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .crossBars() is ARRAY

  !bars = ARRAY()
  if !this.stru.badref() then
    return !bars
  endif

  do !c from 1
    !sctn = object DBREF(!this.stru.name & '-BAR-' & !c)
    handle NONE
      !bars.append(!sctn)
    elsehandle ANY
      break
    endhandle
  enddo

  return !bars

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .verticals() is ARRAY

  !verticals = ARRAY()

  do !c from 1
    !sctn = object DBREF(!this.stru.name & '-V' & !c)
    handle NONE
      !verticals.append(!sctn)
    elsehandle ANY
      break
    endhandle
  enddo

  return !verticals

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      sref
--
-- Description: returns SREF atta
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sref() is DBREF

  !sref = object DBREF(!this.stru.name & '/SREF')
  handle ANY
    !sref = nulref
  endhandle

  return !sref

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      frmw
--
-- Description: returns MAIN frmw below support structure
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .frmw() is DBREF

  !frmw = object DBREF(!this.stru.name & '/MAIN')
  handle ANY
    !frmw = nulref
  endhandle

  return !frmw

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .associations()

  !this.associations(object ARRAY())

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Pair frame sections and picked items together and associate them
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .associations(!pick is ARRAY)

  !association = !this.associations
  --this method only works in conjunction with the mdsassociation object, mdsassowl objects
  --are not compatible
  if !association.size().gt(0) then
    if !association[1].objecttype().eq('MDSASSOWL') then
      return
    endif
  endif

  !paired = ARRAY()

  if !pick.size().eq(1) then
  	-- one pick means CLEARANCE
  	!paired[1] = !pick[1]
  	!paired[2] = !pick[1]
  elseif !pick.size().eq(2) then
  	-- CURSOR method so re-shuffle sequence of picks
  	do !c indices !association
  		!sctn = !association[!c].item()
  		!sctnline = !sctn.poss.line(!sctn.pose)
  		do !cc indices !pick
  			!dist[!cc] = !sctnline.distance(!pick[!cc][2])
  		enddo
  	  !index = !dist.sortedindices().first()
  	  !paired[!c] = !pick[!index][1]
  	enddo
  endif

  do !c indices !association
  	if defined(!paired[!c]) then
  		!association[!c].setAssociated(!paired[!c])
  	endif
  	!association[!c].associate()
  	handle ANY
  		!!alert.error(!!error.text)
  	endhandle
  enddo

  !this.associations = !association

endmethod
-- End of method

-- MDSSIE04 - End
------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dimensionsEqual(!newdim is REAL, !olddim is REAL) is BOOLEAN

  !diff = !newdim - !olddim

  return !diff.abs().leq(1mm)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .enhance(!enhanceOn is BOOLEAN)

  !col = !!gphcolopt.highlight().code

  !list = ARRAY()
  !list.append(!this.stru)
  !list.append(!this.datum)
  !list.appendarray(!this.atta)
  !list.appendarray(!this.joints)
  !list.appendarray(!this.rest.hangers)

  do !item values !list
    skip if !item.badref()
    unenhance $!item
    if !enhanceOn then
      enhance $!item colour $!col
    endif
  enddo

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .singlePick(!type is STRING,!prompt is STRING) is DBREF

  return !!mdsSinglePick(!type, !prompt)

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .storeFt(!form is FORM)

  -- clear storage area
  !form.store.clear()

  -- Store atta settings
  !!mdsSaveAttaInf(!form)

  -- Store packing pieces
  !!mdssavepacks(!form)

  -- Store the structure setting
  !form.store.append('!!ce = ' & !form.support.stru)
  !form.store.append('!!ce.pos = ' & !form.support.stru.pos)
  !form.store.append('!!ce.ori = ' & !form.support.stru.ori)
  !form.store.append('!!ce.:mdstmplori = ' & !form.support.stru.:mdstmplori)

  -- store steel template
  !form.store.append('!!mdsSetSteel.size.val = ' & !!mdsSetSteel.size.val)

  -- store dimensions
  do !c from 1
    !dim = !form.attribute('DIM' & !c)
    handle ANY
      break
    endhandle
    !form.store.append(!dim.fullname() & '.val = ' & !dim.val)
  enddo

  -- store dowel plate rotation and offset
  do !c from 1 to 2
    !plate = object DBREF(!form.support.stru.name & '-PLT-' & !c)
    handle ANY
      skip
    endhandle
    skip if !plate.type.neq('PANE')
    !form.store.append('!dowelplate = ' & !plate.name)
    !form.store.append('!dowelplate.pos = ' & !plate.pos)
    !form.store.append('!dowelplate.ori = ' & !plate.ori)
  enddo

  -- store compensation data
  !this.compensation = !!mdsCompplateDflts.compensatingPlates(!form)

  -- store support specific data
  if !form.eq(!!mdsFt14) then
    !!mdsStoreFt14()
  elseif !form.eq(!!mdsFt15) then
    !!mdsStoreFt15()
  elseif !form.eq(!!mdsFt23) then
    !cap = !form.cap.val
    if !cap.boolean() then
      !form.store.append('!!mdsFt23.cap.val = ' & !cap)
    endif
  endif


  -- Store support object
  !form.backup = !form.support

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkBore(!currentBore is BORE, !checkedTemplate is DBREF)

  !maxbore = !checkedTemplate.:mdsmaxbore.currentunits('mm').bore()
  !minbore = !checkedTemplate.:mdsminbore.currentunits('mm').bore()
  !message = 'Selected template is not suitable.' & !!ascii(10) & 'Supported pipe bore (' & !currentBore & ') is '

  if !currentBore.lt(!minbore) then
    !message = !message & 'less than allowable minimum (' & !minbore & ').'
  elseif !currentBore.gt(!maxbore) then
    !message = !message & 'greater than allowable maximum (' & !maxbore & ').'
  else
    return
  endif

  !message = !message.replace('''','''''')

  return error 1 '$!message'

endmethod
-- End of method
-- MDSSIE04 - start
------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .referenceAtta() is ARRAY

  !refatta = ARRAY()

  if (!this.stru.set()) then
    do !atta values !this.stru.dassci
    	skip if !atta.badref()
      !refatta.append(!atta)
    enddo
  endif
  return !refatta

endmethod
-- End of method
-- MDSSIE04 - end
