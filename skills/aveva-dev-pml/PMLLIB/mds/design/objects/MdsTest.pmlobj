-- Define Object
define object Mdstest

  -- Vendor info
  member .Vendor       is STRING

  -- Rod Selection
  member .Rods         is ARRAY

  -- Design parameter values for associated pipe NB
  member .DesPars      is ARRAY

  -- Design parameter numbers user can modify (number,min,max)
  member .UserDPs      is ARRAY

  -- expression used to trigger alternative design parameter values
  member .AltExpr      is STRING

  -- Array of alternative desing paramters to be used if .AltExpr evaluates to TRUE
  member .AltDesPars   is ARRAY

  -- Material description text
  member .Material     is STRING

  -- PDMS Propcon Material Reference Name, e.g. /CARBON/STEEL
  member .Matref       is STRING

  -- weight (per ancillary unit or per metre)
  member .Weight       is REAL

  -- Drill or Weld sizes
  member .WeldSize    is STRING

  -- Standard material code
  member .PipeMaterial is STRING

  -- Default SHOP Flag for the ATTA
  member .Shop         is BOOLEAN

  -- VPRM material transfer parameters
  member .Vprm         is STRING

-- End object
endobject

define method .populate(!Std is STRING)

!!MdsPar$!Std[0] = object mdsshoe()


  /MDS/PARS/$!Std
  var !size coll all ddse for ce

  do !SetSizes values !size
    !Bore = num of $!SetSizes
    if !bore.eq(0) then
      !!MdsPar$!Std[0].material = desc of /MDS/PARS/$!Std/0/MATERIAL
      !!MdsPar$!Std[0].pipematerial = desc of /MDS/PARS/$!Std/0/SPECS
      !Shop = desc of /MDS/PARS/$!Std/0/MTOC
      !!MdsPar$!Std[0].shop = !shop.boolean()
    else
      !!MdsPar$!Std[$!Bore] = object mdstest()
      !desc = desc of /MDS/PARS/$!Std/$!Bore/DESPARS
      !descs = !desc.split(' ')
      !!MdsPar$!Std[$!bore].despars = !descs
      !desc = desc of /MDS/PARS/$!Std/$!Bore/USERDPS
      !descs = !desc.split(' ')
      !!MdsPar$!Std[$!bore].userdps = !descs
      !!MdsPar$!Std[$!bore].altexpr = desc of /MDS/PARS/$!Std/$!Bore/ALTEXPR
      !desc = desc of /MDS/PARS/$!Std/$!Bore/ALTDESPARS
      !descs = !desc.split(' ')
      !Counter = 1
      do !set values !descs
        !splitagain = !set.split(',')
        !!MdsPar$!Std[$!bore].altdespars[$!splitagain[1]] = object mdsdpval()
        !!MdsPar$!Std[$!bore].altdespars[$!splitagain[1]].dpnum = !Splitagain[1].real()
        !!MdsPar$!Std[$!bore].altdespars[$!splitagain[1]].altval = !Splitagain[2].real()
        !Counter = !Counter + 1
      enddo
      !desc = desc of /MDS/PARS/$!Std/$!Bore/SHOP
      !!MdsPar$!Std[$!bore].shop = !desc.boolean()
    endif
  enddo

endmethod

define method .read()

  !Lines =   !!ReadPdmsfile('/$!!MdsFiles.dimension')

  do !Line values !Lines

    -- skip if !Line.matchwild('*VENDOR*')
    -- skip if !Line.matchwild('*RODS*')

    !TrimLine = !Line.trim()
    !Split = !TrimLine.split('\')
-- Split first field
    !SplitFirst = !Split[1].split(' ')
    do !RemoveSpaces from 1 to !SplitFirst.size()
      if !SplitFirst[$!RemoveSpaces].eq('') then
        !SplitFirst[$!RemoveSpaces].delete()
      endif
    enddo
    !SplitFirst.compress()

-- Set Standard

    !Standard = !SplitFirst[1]

-- Split second field
    if (defined(!Split[2])) then
      !SplitSecond = !Split[2].split(' ')
      do !RemoveSpaces from 1 to !SplitSecond.size()
        if !SplitSecond[$!RemoveSpaces].eq('') then
          !SplitSecond[$!RemoveSpaces].delete()
        endif
      enddo
      !SplitSecond.compress()
    endif

-- Split third field
    if (defined(!Split[3])) then
      !SplitThird = !Split[3].trim()
    endif

-- Split forth field
    if (defined(!Split[4])) then
      !SplitForth = !Split[4].split(' ')
      do !RemoveSpaces from 1 to !SplitForth.size()
        if !SplitForth[$!RemoveSpaces].eq('') then
          !SplitForth[$!RemoveSpaces].delete()
        endif
      enddo
      !SplitForth.compress()
    endif

-- Access object site

    /MDS/PARS
      handle NONE
      elsehandle ANY
        new site /MDS/PARS
      endhandle

-- Access standard zone

    last member
      handle ANY
      endhandle

    /MDS/PARS/$!Standard
      handle NONE
      elsehandle ANY
        /MDS/PARS
        last mem
          handle ANY
          endhandle
        new zone /MDS/PARS/$!Standard
      endhandle

    last member
      handle ANY
      endhandle

    if !Line.matchwild('*VENDOR*') then

      /MDS/PARS/$!Standard/VENDOR
        handle NONE
        elsehandle ANY
          new ddse /MDS/PARS/$!Standard/VENDOR
        endhandle
      new ddat
      new vvalue
      !SplitT = !TRimLIne.after('VENDOR').split()
      validvalue !SplitT

    elseif !Line.matchwild('*RODS*') then

      /MDS/PARS/$!Standard/VENDOR
        handle NONE
        elsehandle ANY
          new ddse /MDS/PARS/$!Standard/VENDOR
        endhandle
      new ddat
      new vvalue
      !SplitT = !TRimLIne.after('VENDOR').split()
      validvalue !SplitT

    elseif !Standard.trim().matchwild('TT').not() then

      /MDS/PARS/$!Standard/$!SplitFirst[3]
        handle NONE
          delete ddse mem
            handle ANY
            endhandle
        elsehandle ANY
          new ddse /MDS/PARS/$!Standard/$!SplitFirst[3]
        endhandle

      num $!SplitFirst[3]

      if !SplitFirst[3].real().eq(0) then
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/PIPEMATERIAL
        !SplitMaterial = !Split[9].split(',')
        do !SetMaterials values !SplitMaterial
          new vvalue
          validvalue '$!SetMaterials'
        enddo
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/MATREF
        !SplitMatref = !Split[8].split(',')
        do !SetMatref values !SplitMatref
          new vvalue
          validvalue '$!SetMatref'
        enddo
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/SHOP
        new vvalue
        validvalue !Split[10]
      else
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/DESPARS
        !Counter = 1
        !SaveIt = ''
        do !LoadDesPars from 4 to !SplitFirst.size()
          !SizeOfText = !SplitFirst[$!LoadDesPars].length()
          if !SplitFirst[$!LoadDesPars].match('(').eq(1) then
            !SaveIt = !SaveIt + !SplitFirst[$!LoadDesPars]
            skip
          endif
          if !Saveit.neq('') and !SplitFirst[$!LoadDesPars].match(')').neq(!SizeOfTExt) then
            !SaveIt = !SaveIt + ' ' + !SplitFirst[$!LoadDesPars]
            skip
          endif
          if !SplitFirst[$!LoadDesPars].match(')').eq(!SizeOfTExt) then
            !UseIt = !Saveit + ' ' + !SplitFirst[$!LoadDesPars]
            !SaveIt = ''
            new vvalue /MDS/PARS/$!Standard/$!SplitFirst[3]/DESPARS/$!Counter
            !TrimUseIt = !UseIt.trim()
            validvalue '$!TrimUseIt'
            !Counter = !Counter + 1
          else
            new vvalue /MDS/PARS/$!Standard/$!SplitFirst[3]/DESPARS/$!Counter
            validvalue '$!SplitFirst[$!LoadDesPars]'
            !Counter = !Counter + 1
          endif
        enddo
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/USERDPS
          do !LoopThrough values !SplitSecond
            !SplitLoop = !LoopThrough.split(',')
            new vvalue /MDS/PARS/$!Standard/$!SplitFirst[3]/USERDPS/DP/$!SplitLoop[1]
            validvalue '$!SplitLoop[1]'
            new vvalue /MDS/PARS/$!Standard/$!SplitFirst[3]/USERDPS/MIN/$!SplitLoop[1]
            validvalue '$!SplitLoop[2]'
            new vvalue /MDS/PARS/$!Standard/$!SplitFirst[3]/USERDPS/MAX/$!SplitLoop[1]
            validvalue '$!SplitLoop[3]'
          enddo
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/ALTEXPR
          !Counter = 1
          !SplitT = !SplitThird.split(',')
          do !LoopThrough values !SplitT
            new vvalue /MDS/PARS/$!Standard/$!SplitFirst[3]/ALTEXPR/VAL/$!Counter
            validvalue '$!LoopThrough'
            !Counter = !Counter + 1
          enddo
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/ALTDESPARS
          !SplitUserAltDesp = !Split[4].split(',')
          !Counter = 1
          do !LoopThrough values !SplitUserAltDesp
            new vvalue /MDS/PARS/$!Standard/$!SplitFirst[3]/ALTDESP/DP/$!Counter
            validvalue '$!LoopThrough[1]'
            new vvalue /MDS/PARS/$!Standard/$!SplitFirst[3]/ALTDESP/VALUE/$!Counter
            validvalue '$!LoopThrough[2]'
            !Counter = !Counter + 1
          enddo
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/SHOP
        new vvalue
        validvalue '$!Split[10]'
      endif

    elseif !Standard.trim().matchwild('TT').not() then

      /MDS/PARS/$!Standard/$!SplitFirst[3]
        handle NONE
          delete ddse mem
            handle ANY
            endhandle
        elsehandle ANY
          new ddse /MDS/PARS/$!Standard/$!SplitFirst[3]
        endhandle

      num $!SplitFirst[3]

      if !SplitFirst[3].real().eq(0) then
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/PIPEMATERIAL
        !SplitMaterial = !Split[9].split(',')
        do !SetMaterials values !SplitMaterial
          new vvalue
          validvalue '$!SetMaterials'
        enddo
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/SHOP
        new vvalue
        validvalue !Split[10]
      else
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/DEFAULT
        new vvalue
        validvalue !Split[4]
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/MINIMUM
        new vvalue
        validvalue !Split[5]
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/MAXIMUM
        new vvalue
        validvalue !Split[6]
        !SplitBores = !Split[7].split(' ')
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/BORE
        do !SetBores values !SplitBores
          !Bores = !SetBores.split(',')
          new vvalue
          validvalue !Bores[1]
        enddo
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/STYPE
        do !SetStype values !SplitBores
          !Stypes = !SetStypes.split(',')
          new vvalue
          validvalue !Stypes[2]
        enddo
        !Counter = 1
        !SaveIt = ''
        do !LoadDesPars from 4 to !SplitFirst.size()
          !SizeOfText = !SplitFirst[$!LoadDesPars].length()
          if !SplitFirst[$!LoadDesPars].match('(').eq(1) then
            !SaveIt = !SaveIt + !SplitFirst[$!LoadDesPars]
            skip
          endif
          if !Saveit.neq('') and !SplitFirst[$!LoadDesPars].match(')').neq(!SizeOfTExt) then
            !SaveIt = !SaveIt + ' ' + !SplitFirst[$!LoadDesPars]
            skip
          endif
          if !SplitFirst[$!LoadDesPars].match(')').eq(!SizeOfTExt) then
            !UseIt = !Saveit + ' ' + !SplitFirst[$!LoadDesPars]
            !SaveIt = ''
            new vvalue /MDS/PARS/$!Standard/$!SplitFirst[3]/DESPARS/$!Counter
            !TrimUseIt = !UseIt.trim()
            validvalue '$!TrimUseIt'
            !Counter = !Counter + 1
          else
            new vvalue /MDS/PARS/$!Standard/$!SplitFirst[3]/DESPARS/$!Counter
            validvalue '$!SplitFirst[$!LoadDesPars]'
            !Counter = !Counter + 1
          endif
        enddo
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/USERDPS
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/ALTEXPR
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/ALTDESPARS
        new ddat /MDS/PARS/$!Standard/$!SplitFirst[3]/SHOP
      endif

    endif

  enddo

endmethod

-- End of file Mdsshoe.obj
