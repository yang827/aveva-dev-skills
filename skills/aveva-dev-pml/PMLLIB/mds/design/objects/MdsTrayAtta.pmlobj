--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdstrayatta(dbref,dbref,ARRAY)   -
--  settray(dbref,ARRAY)             -
--

-- Define Object
define object mdstrayatta

member .atta is dbref
member .trayno is real
member .level is real
member .elevation is real
member .direction is direction

endobject
--------------------------------------------------------------------------------
define method .mdstrayatta(!atta is dbref,!sctn is dbref,!directions is ARRAY)
 --q var !directions
  !this.atta = !atta
  !this.settray(!sctn,!directions)

endmethod
--------------------------------------------------------------------------------

-- method to set the trayno and level of an atta
define method .settray(!sctn is dbref,!directions is ARRAY)

  !obj = object mdsplines(!sctn)
  --q var !obj
  --q var !obj.pldir
  --q var !this.atta
  !pline = !obj.getnearest(!this.atta)
  !this.direction = !sctn.plor.$!pline$n.zdir().wrt(/* )
  !ori = y is $!this.direction
  !this.trayno = !directions.findfirst(!ori.string().before('WRT'))
  !this.elevation = !this.atta.position.wrt( /* ).up

endmethod
--------------------------------------------------------------------------------

