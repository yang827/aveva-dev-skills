--
-- Description:
-- Object to hold design build parameters for trunnions
-- For more info see relevant section in the dimensions default file
--
--------------------------------------------------------------------------------

-- Define Object
define object MdsTRUN

  -- Vendor info
  member .Default     is real

  -- Minimum trunnion size
  member .Minimum     is real

  -- Maximum trunnion size
  member .Maximum     is real

  -- Available bores
  member .Bores       is array

  -- Styp to be used
  member .Stypes      is array

  -- Standard material code
  member .PipeMaterial is string

  -- Shop flag
  member .Shop        is boolean

   -- Design parameter numbers user can modify (number,min,max)
  member .UserDPs      is array


-- End object
endobject

-- End of file Mdstrun.obj
