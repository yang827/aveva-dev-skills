------------------------------------------------------------------------
-- Define Object
define object MDSWELD

  member .source is DBREF
  member .dtse is DBREF
  member .designitem is DBREF
  member .ppoints is ARRAY
  member .ppointdata is DBREF
  member .ppointstring is STRING
  member .description is STRING
  member .symbol is STRING
  member .symboldata is DBREF
  member .tagtext is STRING
  member .tagtextdata is DBREF
  member .desippoint is REAL
  member .lengths is ARRAY
  member .positions is ARRAY
  member .directions is ARRAY
  member .name is STRING
  member .startptype is STRING
  member .categoryweld is DBREF
  member .categoryname is STRING
  member .startdata is DBREF
  member .start is STRING
  member .enddata is DBREF
  member .end is STRING
  member .wpurp is STRING
  member .function is STRING
  member .form is FORM
  member .areaname is STRING
  member .threedposition is POSITION
  member .draw is BOOLEAN

endobject
--------------------------------------------------------------------------------
-- constructor method for starting at a dataset
define method .mdsweld(!dtse is DBREF)

  -- set up the default so that it is a location weld rather than start and end
  !this.startptype = 'LOC'
  !this.readdataset(!dtse)

  --get the threeDPosition of the weld
  !this.threedposition = !this.getWeldPosition()
  handle any
    !this.threedposition = object POSITION()
  endhandle

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- constructor method for starting at a dataset and owning section
define method .mdsweld(!dtse is DBREF,!sctn is DBREF)

  -- set up the default so that it is a location weld rather than start and end
  !this.startptype = 'LOC'
  !this.readdataset(!dtse)
  -- Override size of weld if needed

  !this.designitem = !sctn
  if (!this.wpurp.eq('ANCI')) then
    !this.getppoints()
  endif

  --get the threeDPosition of the weld
  !this.threedposition = !this.getWeldPosition()
  handle any
    !this.threedposition = object POSITION()
  endhandle

  !banner = banner
  if (!banner.name.upcase().match('DRAFT').gt(0) or !banner.name.upcase().match('OUTFITTINGDRAFT').gt(0)) then
    !this.draw = FALSE
    -- Passed with dummy number because this sets the 3dposition rather than draw the aids
    !this.drawframeweld(9999)
  else
    !this.draw = TRUE
  endif

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method for reading a dataset
define method .readdataset(!dtse is DBREF)

  !this.areaname = !dtse.owner.name
  handle ANY
    !this.areaname = ''
  endhandle
  -- interrogate the passed ddse
  !this.dtse = !dtse
  !this.name = !dtse.name
  !this.description = !dtse.description
  !this.wpurp = !dtse.purpose
  !this.function = !dtse.function
  if (!this.function eq '') then
    if (!dtse.owner.type.eq('TMPL')) then
      !this.function = 'SPECIFIC'
    else
      !this.function = 'GENERIC'
    endif
  endif
  -- get the ddat containing the symbol name
  var !a coll all ddat with purp eq 'SYMB' for $!dtse
  if (defined(!a[1])) then
    !this.symboldata = !a[1].dbref()
    !this.symbol = !this.striptext(!this.symboldata)
  else
    !this.symbol = 'unset'
  endif
  -- get the ddat containing the ppoint list (csv)
  var !a coll all ddat with purp eq 'PPOI' for $!dtse
  if (defined(!a[1])) then
    !this.ppointdata = !a[1].dbref()
    !ddprop = !this.striptext(!this.ppointdata)
    if (!ddprop.neq('unset')) then
      !ppoints = !ddprop.split(',')
      !this.setppointstring(!ppoints)
    endif
  endif
  -- get the ddat containing the tag text
  var !a coll all ddat with purp eq 'TAG' for $!dtse
  if (defined(!a[1])) then
    !this.tagtextdata = !a[1].dbref()
    !this.tagtext = !this.striptext(!this.tagtextdata)
  else
    !this.tagtext = 'unset'
  endif

  -- get the ddat containing the START
  var !a coll all ddat with purp eq 'STAR' for $!dtse
  if (defined(!a[1])) then
    !this.startdata = !a[1].dbref()
    !this.start = !this.striptext(!this.startdata)
    !this.startptype = !this.startdata.ptype
  else
    !this.start = 'unset'
  endif
  -- get the ddat containing the END
  var !a coll all ddat with purp eq 'END' for $!dtse
  if (defined(!a[1])) then
    !this.enddata = !a[1].dbref()
    !this.end = !this.striptext(!this.enddata)
  else
    !this.end = 'unset'
  endif


endmethod
-------------------------------------------------------------------------


---------------------------------------------------------------------------
-- method to create a standard dataset
-- type defined what kind of weld we are creating
define method .createdataset(!type is STRING)

  if (!type eq 'frame') then
    !!ce = !this.categoryname.dbref()
    handle NONE
      !this.dtse = !!ce
    elsehandle ANY
      -- take the name of the zone containing the frameworkd - /MDS/FRAMES/
      !!ce = !this.designitem
      zone
      -- !dareaname = !!ce.name.replace('/MDS/FRAMES/' , '/DDAR-')
      !this.areaname = !this.getweldname(!this.form.joints.selection(),'AREA','OLD')[1]
    endhandle
  elseif (!type eq 'Special') then
    !source = !this.form.currentstandard
    !this.areaname = !this.form.currentstandard.name & '/TMPL'
    !!ce = !this.areaname.dbref()
    handle ANY
      !!ce = !source
      if (!this.areaname.match('/').neq(1)) then
        !this.areaname = '/' & !this.areaname
      endif
      new tmpl $!this.areaname
    endhandle
  elseif (!type eq 'Convert') then
    var !stru stru of $!this.designitem
    !source = !stru.dbref()
    !this.areaname = !stru.dbref().name & '/TMPL'
    !!ce = !this.areaname.dbref()
    handle ANY
      !!ce = !source
      if (!this.areaname.match('/').neq(1)) then
        !this.areaname = '/' & !this.areaname
      endif
      new tmpl $!this.areaname after last mem
    endhandle
    return
  else  $* type = cate its a category weld based on an atta or joint

    --!this.areaname = !this.getweldname(!this.form.joints.selection(),'AREA','OLD')[1]
    -- !this.areaname = !this.designitem.name.replace('ATTA','DDAR')
  endif
  if (!this.areaname.match('/').neq(1)) then
    !this.areaname = '/' & !this.areaname
  endif
  !!ce = !this.areaname.dbref()
  handle ANY  $* area does not exist
    /MDS/DES/WELDS
    handle ANY
      !!alert.error(' Weld Template area /MDS/DES/WELDS does not exist - contact your System Administarator')
      return
    endhandle
    new DDAR $!this.areaname
  endhandle
  -- test if the weld exists
  !!ce = !this.name.dbref()
  handle ANY
    !exists = FALSE
  elsehandle NONE
    !exists = TRUE
  endhandle
  !this.createdesweld(!exists,!this.name,!this.wpurp )
  -- new ddse $!this.categoryname

endmethod
-------------------------------------------------------------------------

-------------------------------------------------------------------------
-- method to set a weldname based on the localname
define method .setlocalname(!areaname is STRING)


  !this.areaname = !areaname
  !this.name = '/DDSE-' & !this.designitem.name.after('/') & '/WELD' & !this.name.after('/WELD')

endmethod
-------------------------------------------------------------------------

-------------------------------------------------------------------------
-- method to set a weldname based on the localname
define method .setspecialname(!areaname is STRING)

  !this.areaname = !areaname
  !this.name = '/DDSE-' & !this.designitem.name.after('/') & '/WELD' & !this.name.after('/WELD')

endmethod
-------------------------------------------------------------------------


-------------------------------------------------------------------------
-- method to reset the section weld references and include the current dataset
define method .addweldtosctn()

  !!save = !!ce
  !sctn  = !this.designitem

  !welds = !sctn.:mdswelddata
  !welds.append(!this.dtse)
  !welds.unique()

  !!ce = !sctn
  if (!welds.unset()) then
    :mdswelddata unset
  else
    !sctn.:mdswelddata = !welds
  endif
  same

endmethod

-------------------------------------------------------------------------
-- method to remove the current linked weld from the section
define method .remweldfromsctn()

  !sctn = !this.designitem
  !welds = !sctn.:mdswelddata
  -- clean up any deleted welds
  do !a index !welds
    if (!welds[!a].badref()) then
      !welds.deleteto(!a,1)
    endif
  enddo
  !welds.compress()
  if (!welds.findfirst(!this.dtse).neq(0)) then
    !welds.removefrom(!welds.findfirst(!this.dtse),1)
  endif

  !!ce = !sctn
  if (!welds.unset()) then
    :mdswelddata unset
  else
    !sctn.:mdswelddata = !welds
  endif
  same


endmethod
-------------------------------------------------------------------------


-------------------------------------------------------------------------
define method .createdesweld(!modify is BOOLEAN,!weldname is STRING,!purpose is STRING )
  -- q var !modify
  -- q var !weldname
  -- q var !purpose
  -- q var !this.dtse
  !this.wpurp = !purpose
  if (!modify.not()) then $* its a new weld
    --  $p its a new weld
    !!ce = !this.areaname.dbref()
    if (!!ce.mcount.gt(0)) then
      !position = 'After last mem'
    else
      !position = ''
    endif
    !!ce = $!weldname
    handle ANY
      new ddse $!weldname $!position
      handle ANY
        !!alert.error('$!!error.text')
        if (!!ce.type eq 'DDSE' and !!ce.name.match('/').neq(1)) then
          delete ddse
        endif
        return
      endhandle
    elsehandle NONE
      delete ddse mem
    endhandle
    !this.dtse = !!ce
  else  $* its modify now used to delete ddse mem so that a clean ddse is created could remove duplication

    $!weldname
    if (!!ce.name neq '$!weldname') then $* rename it
      name $!weldname
      handle ANY $* rename existing
      endhandle
    endif
    delete ddse mem
    handle (41,54)
      !!alert.error('Cannot change a read only database')
      return
    elsehandle ANY
      !!alert.error('Unable to Replace Existing Weld')
      return
    endhandle
  endif
  --q var !!this.dtse
  !this.dtse = !!ce
  desc '$!this.description'
  purp $!this.wpurp
  function '$!this.function'

  new ddat $!<weldname>/SYMBOL
  purp SYMB
  ddprop ('$!this.symbol')
  new ddat $!<weldname>/PPOINT
  purp PPOI
  ddprop ('$!this.ppointstring')
  new ddat $!<weldname>/TAGTEXT
  purp TAG
  ddprop ('$!this.tagtext')
  new ddat  $!<weldname>/START
  purp STAR
  ddprop ('$!this.start')
  ptype $!this.startptype
  handle ANY
    -- ptype unset
  endhandle
  new ddat  $!<weldname>/END
  purp END
  ddprop ('$!this.end')

endmethod
-------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
-- get the ppoints for a catalogue weld
-- if there are no ppoints then there cannot be a weld
define method .getppoints()

  do !a values !this.ppoints
    !this.setppoints(!a.real())
  enddo

endmethod

------------------------------------------------------------------------
-- Set a single objects ppoint based on the passed ppoint number
define method .setppoints(!ppoint is REAL)

  !currentelement = !!ce
  !this.desippoint = !ppoint
  !this.directions.append(!this.designitem.pdir[!ppoint].wrt(/* ))
  !this.positions.append(!this.designitem.ppos[!ppoint].wrt(/* ))
  !ptref = !this.designitem.ptre
  var !current coll all ptca with purp eq 'MWEL' and number eq $!ppoint for $!ptref
  --!parameter = !current[1].dbref().pheight.replace('(','').replace(')','')
  !parameter = !current[1].dbref().pheight
  --$!this.designitem
  var !height $!parameter
  handle ANY
    !height = $!parameter
    handle ANY
      --$p unable to get height for $!this.designitem Set to 10
      !height = 10
    endhandle
  endhandle
  !this.lengths.append(!height.real())
  !!ce = !currentelement
endmethod
-------------------------------------------------------------------------

------------------------------------------------------------------------
-- Set a single objects ppoint based on the passed ppoint number
define method .setppoints(!atta is DBREF,!ppoint is REAL,!len is REAL)

  !this.desippoint = !ppoint
  !this.designitem = !atta
  !this.direction  = !atta.pdir[!ppoint].wrt(/* )
  !this.position   = !atta.ppos[!ppoint].wrt(/* )
  !this.length     = !len
  -- find out if there is a dataset and read it
  -- now get the rest

endmethod
-------------------------------------------------------------------------

-------------------------------------------------------------------------
-- method to set the objects ppoint list to the passed array
define method .setppointstring(!ppoints is ARRAY)

  !this.ppoints = !ppoints
  if (!ppoints.size() eq 0) then
    !this.ppointstring = 'unset'
  else
    !string = ''
    do !a values !ppoints
      !string = !string & !a & ','
    enddo
    !this.ppointstring = !string.substring(1,!string.length() - 1)
  endif

endmethod
-------------------------------------------------------------------------

-------------------------------------------------------------------------
-- method to draw aid cylinders on the ppoints of atta welds
define method .drawancilweld()

  $(
  do !a index !this.ppoints
    pin 10 at P$!this.ppoints[$!a]
    !HalfDist = !this.lengths[!a].real() / 2
    pin 10 dir $!this.directions[$!a]
    pin 10 dist $!HalfDist
    aid clear cyli $!this.ppoints[$!a]
    handle ANY
    endhandle
    var !pin10pos pin 10 pos wrt /*
    aid Cyli number $!this.ppoints[$!a] diam 6 height $!this.lengths[$!a] at locate p$!this.ppoints[$!a] of ce at ce ori z is $!this.directions[$!a] filled on
  enddo
  $)

  do !a index !this.ppoints
    !pv = object POINTVECTOR()
    !pv.position = !this.positions[!a]
    !pv.direction = !this.directions[!a]

    !newpv = !pv.offset(!this.lengths[!a] / 2)
    !position = !newpv.position
    aid clear cyli $!this.ppoints[$!a]
    handle ANY
    endhandle
    aid Cyli number $!this.ppoints[$!a] diam 6 height $!this.lengths[$!a] at $!position ori z is $!this.directions[$!a] filled on
  enddo

endmethod

--------------------------------------------------------------------------------
-- method to clear the weld aid cylinders
define method .clearweld()

  aid clear cyli $!this.ppoint

endmethod
-------------------------------------------------------------------------------

---------------------------------------------------------------------------
define method .fillform(!form is FORM)

  !form.dtsen.val = !this.name
  handle ANY
    !form.dtsen.val = 'unset'
  endhandle
  !form.symbol.val = !this.symbol
  handle ANY
    !form.symbol.val = 'unset'
  endhandle
  !form.desc.val   = !this.description
  handle ANY
    !form.desc.val = 'unset'
  endhandle
  !form.tagtext.val   = !this.tagtext
  handle ANY
    !form.tagtext.val = 'unset'
  endhandle
  !form.start.val = !this.start
  handle ANY
    !form.start.val = 'unset'
    handle ANY
    endhandle
  endhandle
  !form.end.val   = !this.end
  handle ANY
    !form.end.val = 'unset'
    handle ANY
    endhandle
  endhandle

  !form.ppoint.val = !this.ppointstring
  handle ANY
    !form.ppoint.val = 'unset'
    handle ANY
    endhandle
  endhandle

  !form.joints.select('$!this.function')
  handle any
    !form.joints.val = 1
    handle any
    endhandle
  endhandle

endmethod
--------------------------------------------------------------------------------------

-------------------------------------------------------------------------
-- method to draw aid cylinders on the ppoints of atta welds
define method .drawweld(!number is REAL)

  if (!this.wpurp eq 'SCTN') then
    -- draw the weld
    !this.drawframeweld(!number)
  else
    !this.drawancilweld()
  endif

endmethod

--------------------------------------------------------------------------------------------
-- method to get the frame welds based on the selected standard
define method .drawframeweld(!number is REAL)

  !aidnumber = 335 + !number
  -- clear any existing versions
  aid clear text $!number
  handle ANY
  endhandle

  aid clear cyli $!number
  handle ANY
  endhandle

  if (!this.startptype.eq('LOC')) then
    !pos1 = !this.drawsendweld('Start')
    handle ANY
      --!!alert.error('Weld Incorrectly Defined')
      return
    endhandle
    if (!pos1.unset()) then
      --!!alert.error('Weld Incorrectly Defined')
      return
    endif
    if (!this.draw) then
      aid text number $!aidnumber 'WELD $!number' at $!pos1
    endif
  else
    !pos1 = !this.drawsendweld('Start')
    handle ANY
      --!!alert.error('Weld Incorrectly Defined')
      return
    endhandle
    if (!pos1.unset()) then
      --!!alert.error('Weld Incorrectly Defined')
      return
    endif
    !pos2 = !this.drawsendweld('End')
    handle ANY
      --!!alert.error('Weld Incorrectly Defined')
      return
    endhandle
    if (!pos2.unset()) then
      --!!alert.error('Weld Incorrectly Defined')
      return
    endif

    if (!this.draw) then
      !this.drawiweld(!pos1,!pos2,!aidnumber,!number)
      handle (2,766)
        !!alert.error('Cannot derive weld positions from current data - Please Define Start and End')
      endhandle
    endif
  endif

endmethod
--------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to get the appropriate name for a weld
-- input parameters
-- !type 'GENERIC' returns a weld based on the catref 'STD' returns a name based on the template
-- !gtype is 'AREA' or 'STD' if its an area it returns a DDAR name to hold the DDSE
-- !mode is 'OLD' or 'NEW' and defines if a new or existing name is returned
define method .getweldname(!type is STRING,!gtype is STRING,!mode is STRING) is ARRAY

  !name = !this.designitem.flnm

  if (!this.designitem.type inset('SJOI','PJOI','FITT')) then
    if (!type.eq('GENERIC')) then
      -- use the joint or fitting name
      !name = !this.designitem.catref.flnm
    endif
  elseif (!this.designitem.type.eq('CATE')) then
    !name = !this.designitem.name.replace('ATTA-','')
  endif

  if (!name.split().size().neq(1)) then $* the item is unnamed
    !newname = '/DDSE-' & !name.split()[!name.split().size()] & '/' & !name.split()[1] & !name.split()[2]
  else
    !newname = '/DDSE-' & !name
  endif
  -- get rid of the mds bit
  !newname = !newname.replace('/MDS/','').replace('/DDSE-/','/DDSE-')

  -- we now have an  area name so we use this in the creation part
  if (!gtype eq 'AREA') then
    if (!type.eq('GENERIC')) then
      !return[1] =  !newname.replace('DDSE','DDAR')
      return !return
    else
      !stru = stru of $!this.designitem
      !return[1] = !stru.name.replace('/MDS/','DDAR-')
      return !return
    endif
  endif

  !return = ARRAY()
  do !number from 1 to 20
    !name = !newname & '/WELD' & !number
    !unusedTest = !name.dbref()
    handle NONE $* name already used
      if (!mode eq 'OLD') then
        !return.append(!name)
      endif
    elsehandle ANY $* name not found so it can be used
      if (!mode eq 'NEW') then
        !return[1] = !name
        break
      endif
    endhandle
  enddo

  return !return

endmethod
-------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------
define method .drawiweld(!pos1 is POSITION,!pos2 is POSITION,!number is REAL,!index is REAL)

  !weldline = object LINE()
  !weldline.startposition = !pos1
  !weldline.endposition = !pos2
  !weldPosition = !weldline.proportion(0.5)
  handle(2,785)
    !weldPosition =  !pos1
    !zdir = up
    !length = 1
  elsehandle NONE
    !zdir = !weldline.direction()
    !length = !weldline.length()
  endhandle
  aid Cyli number $!number diam 6 height $!length at $!weldPosition ori z is $!zdir filled on
  aid text number $!number 'WELD $!index' at $!weldPosition

endmethod
--------------------------------------------------------------------------------------------


--------------------------------------------------------------------------------------------
-- method to draw a start and end point of a weld
-- define method .drawsendweld(!aidnumber is real,!index is real,!type is STRING)is position
define method .drawsendweld(!type is STRING)is POSITION

  -- interpret the points and work out the position of the start and end
  !host = !this.designitem
  !hostpline = !this.$!<type>.split(',')[1]
  handle ANY
    return
  endhandle

  if (  !this.$!<type>.split(',').size().eq(2)) then $* its on the end of a pline
    !pline = !this.$!<type>.split(',')[1]
    !end  =  !this.$!<type>.split(',')[2]
    if (!end.eq('END')) then
      !pos = !this.designitem.plen.$!<pline>.wrt(/* )
      handle ANY
        !pos = !this.designitem.pose.wrt(/* )
      endhandle
    else
      !pos = !this.designitem.plst.$!<pline>.wrt(/* )
      handle ANY
        !pos = !this.designitem.poss.wrt(/* )
      endhandle
    endif
    return !pos

  else  $* its an intersection

    !int = !this.$!<type>.split(',')[2]
    !intersectpline = !this.$!<type>.split(',')[3]
    !hostline = object LINE()
    !hostline.startposition = !host.plst.$!<hostpline>.wrt(/* )
    !hostline.endposition = !host.plen.$!<hostpline>.wrt(/* )
    !stru = stru of $!this.designitem
    var !sctns coll all sctn for $!stru
    var !names eval name for all from !sctns

    -- loop through the other members and try and sort out which member
    do !a values !names
      if (!a.dbref() eq !host) then
        skip
      elseif (!a.match(!int).eq(!a.length() - (!int.length() - 1))) then
        !intersect = !a.dbref()
        break
      endif
    enddo

    if (undefined(!intersect)) then
      !bann = banner
      if ((!bann.short.upcase().match('DESIGN').gt(0)) or(!bann.short.upcase().match('OUTFITTING MK').gt(0))  ) then
        !!alert.error('$!host -- Cannot determine the position of weld')
      else
        !!abalogging.error('*** $!host -- Cannot determine the position of weld')
      endif
      !pos = object POSITION()
      return !pos
    endif

    !intersectline = object LINE()
    !intersectline.startposition =  !intersect.plst.$!<intersectpline>.wrt(/* )
    !intersectline.endposition   =  !intersect.plen.$!<intersectpline>.wrt(/* )
    !datumposition = !hostline.intersection(!intersectline)
  endif

  return !datumposition

endmethod

-- general method for extracting only the text of a property
define method .striptext(!item is DBREF)is STRING

  !return = !item.ddprop.replace(|(|,||).replace(|)|,||).replace(| |,||).replace(|'|,||)
  handle ANY
    !return = ''
  endhandle

  return !return

endmethod

----------------------------------------------------------------------
--
-- Method:      getWeldPosition
--
-- Description: <method to set the threeDPosition member of the weld object>
--
----------------------------------------------------------------------
define method .getWeldPosition() is POSITION

  if (!this.startptype.eq('LOC')) then
    !pos1 = !this.drawsendweld('Start')
    !weldPosition = !pos1
  else
    !pos1 = !this.drawsendweld('Start')
    !pos2 = !this.drawsendweld('End')
    if (!pos1.unset() or !pos2.unset()) then
      !weldPosition = object POSITION()
    else
      !weldline = object LINE()
      !weldline.startposition = !pos1
      !weldline.endposition = !pos2
      !weldPosition = !weldline.proportion(0.5)
    endif
  endif

  return !weldPosition

endmethod
