-- Define Object
define object mdsweldlist

  member .welds is array
  member .currentweld is mdsweld
  member .dtse is dbref
  member .designitem is dbref
  member .ppoint is real
  member .description is string
  member .symbol is string
  member .mode is string
  member .valid is boolean
  member .form is form
  -- mode can be std or des

endobject
--------------------------------------------------------------------------------
-- constructor method for starting at an area
define method .mdsweldlist(!area is dbref,!std is string)

  var !ddse coll all DDSE for $!area
  !weldarray = array()
  do !a values !ddse
    !weld = object mdsweld(!a.dbref())
    !weldarray.append(!weld)
  enddo

  !this.welds = !weldarray
  !this.currentweld = !this.welds[1]
  handle ANY
    -- !this.currentweld = object mdsweld()
  endhandle

endmethod
---------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- constructor method for starting at an atta, plat or sctn
define method .mdsweldlist(!atta is dbref)

  !this.valid = FALSE
  !this.designitem = !atta
  if !atta.type eq 'ATTA' then
    !this.getattappoints(!atta)
  elseif !atta.type inset('SJOI','PJOI','FITT') then
    !this.getplatewelds(!atta)
    -- !this.getattappoints(!atta)
  elseif !atta.type.eq('SCTN') then
    !This.getsctnwelds(!atta)
  else
    --!!alert.error('Item unsuitable for weld data')
    --return
  endif

endmethod
------------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- constructor method for starting at an atta, plat or sctn and resetting all the weld sizes to !size
define method .mdsweldlist(!atta is dbref,!size is real)

  !this.valid = FALSE
  !this.designitem = !atta
  if !atta.type eq 'ATTA' then
    !this.getattappoints(!atta)
  elseif !atta.type inset('SJOI','PJOI','FITT') then
    !this.getplatewelds(!atta)
    -- !this.getattappoints(!atta)
  elseif !atta.type.eq('SCTN') then
    !This.getsctnwelds(!atta)
  else
    --!!alert.error('Item unsuitable for weld data')
    --return
  endif
  do !a values !this.welds
    !a.tagtext = !size.string()
    !a.createdesweld(true,!a.name,!a.wpurp )
  enddo

  !!ce = !atta

endmethod
------------------------------------------------------------------------------------



--------------------------------------------------------------------------------
-- constructor method for starting at a structure
-- converts the template welds to local ones
-- this method is called by the creation routine
define method .mdsweldlist(!stru is dbref,!form is form)

!this.form = !form
!!ce = !stru
var !sctn coll all sctn for $!!ce
!welds = ARRAY()
do !a values !sctn
  !this.welds = ARRAY()
  !This.getsctnwelds(!a.dbref())
  !welds.appendarray(!this.welds)
enddo

--<wd>18aug2004
  if (!welds.empty()) then
    return
  endif
--<wd>18aug2004

-- create the tpwl for the local welds if it does not exist already
!this.currentweld = !welds[1]
!this.currentweld.form = !this.form
!this.currentweld.createdataset('Convert')

!this.welds = !welds
-- now loop through the current welds and make a new name
do !b index !this.welds
   !this.welds[!b].setlocalname(!this.currentweld.areaname)
   !this.welds[!b].remweldfromsctn()
   !this.welds[!b].createdesweld(false,!this.welds[!b].name,!this.welds[!b].wpurp )
   !this.welds[!b].addweldtosctn()
enddo

-- If weld form is show then reinitialise

  if !!MdsSpecialWelds.shown() then
    !!MdsSpecialWelds.init(!form)
  endif

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- constructor method for starting at a SPECIAL at sctn level
-- renames the welds
define method .mdsweldlist(!sctn is dbref,!rename is BOOLEAN)

!welds = !sctn.:mdswelddata
do !a index !welds
   !!ce = !welds[!a]
   handle ANY
    skip
   endhandle
   !name = '/DDSE-' & !sctn.namn & '/SWELD' & !a
   name $!name
   handle ANY
    !!alert.error('$!!error.text')
   endhandle
   do !w values !!ce.members
     !!ce = !w
     -- substitute the new name before the last part
     !!ce.name = !name.replace('DDSE','DDAT') & '/' & !!ce.name.split('/')[!!ce.name.split('/').size()]
   enddo
enddo

endmethod
------------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- constructor method for starting at a SPECIAL at sctn level
-- renames the welds
define method .mdsweldlist(!sctn is dbref,!oldnames is ARRAY,!newnames is ARRAY)

!welds = !sctn.:mdswelddata
!newname = !sctn.name
do !a index !welds
   !nointstart = FALSE
   !nointend = FALSE
   !!ce = !welds[!a]
   handle ANY
     skip
   endhandle
   !weld = object mdsweld(!!ce)
   if !weld.start.split(',').size().neq(3) then $* its an intersection
     !nointstart = TRUE
   endif
   if !weld.end.split(',').size().neq(3) then $* its an intersection
     !nointend = TRUE
   endif
   if !nointstart and !nointend then
     return
   endif

   if !nointstart.not() then
     !startcode = !weld.start.split(',')[2]
     -- loop through the old names and find the old name in the list
     do !b index !oldnames
       if !oldnames[!b].match(!startcode) eq (!oldnames[!b].length() - (!startcode.length() - 1)) then
             !partindex = !newnames[!b].match('-V') + 1
            !substring = !newnames[!b].substring(!partindex)
            !weld.start = !weld.start.replace(!weld.start.split(',')[2],!substring)
            break
       endif
     enddo
   endif

   if !nointend.not() then
     !endcode = !weld.end.split(',')[2]
     -- loop through the old names and find the old name in the list
     do !b index !oldnames
       if !oldnames[!b].match(!endcode) eq (!oldnames[!b].length() - (!endcode.length() - 1)) then
            !partindex = !newnames[!b].match('-V') + 1
            !substring = !newnames[!b].substring(!partindex)
            !weld.end = !weld.end.replace(!weld.end.split(',')[2],!substring)
            break
       endif
     enddo
   endif

   !weld.createdesweld(true,!weld.name,!weld.wpurp )
enddo

endmethod
------------------------------------------------------------------------------------

------------------------------------------------------------------------------------
--- method for creating a list of weld items based on weld references of sections
define method .getsctnwelds(!sctn is dbref)

   -- get the welds referenced by the :mdsweldref uda
   !welds = !sctn.:mdswelddata

   !weldlist = array()
   !weldarray = array()
   -- if there are no ppoints then return
   if !welds.size().gt(0) then
      do !a values !welds
        !test = !a
        if !test.badref() then
            skip
        endif
        !weldarray.append(object mdsweld(!a,!sctn))
      enddo
   else
     !this.valid = FALSE
     return
   endif

   if !weldarray.size().gt(0) then
     !this.valid = TRUE
   endif

   !this.welds = !weldarray

endmethod
------------------------------------------------------------------------------------

------------------------------------------------------------------------------------
-- method  called by the constructor method to get plate welds for pjoi sjoi atta
define method .getplatewelds(!atta is dbref)

   !dummy = object mdsweld()
   !dummy.designitem = !atta
   !welds = !dummy.getweldname('GENERIC','STD','OLD')
   do !a values !welds
     !test = !a.dbref()
     handle ANY
        break
     endhandle
     !this.welds.append(object mdsweld(!a.dbref(),!atta))
   enddo

--   if !this.welds.size().eq(0) then $* there are no generic welds so look for :mdswelds
     !welds = !atta.:mdswelddata
     if !welds.size().eq(0) then
      -- !names[1] = 'None Found'
      -- !dbref[1] = 'unset'
     else
       do !a index !welds
         if !welds[!a].badref() then
           !welds.deleteto(!a,1)
         endif
       enddo
         !welds.compress()
         do !a values !welds
            !this.welds.append(object mdsweld(!a,!atta))
            !this.valid = TRUE
         enddo
         !atta.:mdswelddata = !welds
     endif
--  endif

  if !this.welds.size().gt(0) then
     !this.valid = TRUE
  endif

endmethod
------------------------------------------------------------------------------------



------------------------------------------------------------------------------------
-- method to find the weld ppoints on an atta weld
define method .getattappoints(!atta is dbref)

  -- get the ppoints with purp of mweld
  -- if the weld list is set then go and get the
   !ptref = !atta.ptre
   var !welds coll all ptca with purp eq 'MWEL' and number gt 300 for $!ptref
   var !numbers eval number for all from  !welds
   var !heights eval pheight for all from !welds

   !weldlist = array()
   -- create a weld for each ppoint
   !weldarray = array()
   -- if there are no ppoints then return
   if !welds.size().gt(0) then
      -- find out if there are any datasets
      !stype = !atta.stype
      !datasetname = '/DDAR-' & !stype
      !ddar = !datasetname.dbref()
      handle ANY
        !this.valid = FALSE
        return
      endhandle
      var !ddse coll all DDSE for $!ddar
      if !ddse.size() eq 0 then
         !this.valid = FALSE
         return
      endif
      do !a values !ddse
        !weld = object mdsweld(!a.dbref())
        !weld.designitem = !atta
        !weld.getppoints()
        !weldarray.append(!weld)
      enddo
      if !weldarray.size().eq(0) then
         !this.valid = FALSE
         return
      else
         !this.valid = TRUE
      endif
   endif
   !this.welds = !weldarray
endmethod
-------------------------------------------------------------------------------


-------------------------------------------------------------------------------
define method .getsuitablewelds(!dir is direction,!index is real)is array

   !wdir = !dir.wrt(/* )
   !return = array()


   do !b index !this.welds[!index].directions
       if !this.welds[!index].directions[!b].angle(!wdir).lt(15) or !this.welds[!index].directions[!b].opposite().angle(!wdir).lt(15) then
        -- its a possible target
        !return.append(!b)
       endif
   enddo

   if !return.size().eq(0) then

      !return = array()
      do !a index !this.welds[!index].ppoints
        !return.append(!a)
      enddo
   endif

   return !return

endmethod
-------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .drawwelds()

  do !a values !this.welds
    !this.currentweld = !a
    !a.drawweld()
  enddo
endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .clearwelds()
  do !a values !this.welds
    !a.clearweld()
  enddo
endmethod
