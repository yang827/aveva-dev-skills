--
-- Define Object
define object MDSCHECKSTD

  ---------------------------------------------------------------------------------------------------
  --<wd>feb2006<mds12>
  --
  -- .description NOT USED or REQUIRED
  --  member .description is STRING
  --
  -- Store the passed PML Object type "mdsreadparsdata" in the new member .mdsdefaults
  member .mdsdefaults is MDSREADPARSDATA
  --
  --<wd>feb2006<mds12>
  ---------------------------------------------------------------------------------------------------
  -- End of Object
endobject

---------------------------------------------------------------------------------------------------
--<wd>feb2006<mds12>
--
-- NEW Constructor Method
define method .mdscheckstd(!mdsattaobj is MDSREADPARSDATA)
  -- Set the Object member .mdsdefaults
  !this.mdsdefaults = !mdsattaobj
endmethod
--
--<wd>feb2006<mds12>
-----------------------------------------------------------------------------------------------------------
--
-- Method            insu
--
-- Description:      Method to check the INSULATION thickness of the Identified Pipe
--                   on which the selected ATTA is to be located, is within the MINIMUM
--                   and MAXIMUM limits defined for the passed MDS Standard Type.
--
-- Arguments:
--    [#]   [R/RW]    [Data Type]   [Description]
--     1     R        STRING       The MDS Support 'Alias' name
--     2     R        STRING       The MDS Support Minimum Insulation Variable
--     3     R        STRING       The MDS Support Maximum Insulation Variable
--
-- Return:
--    [Data Type]    [Description]
--     BOOLEAN       Returns 'TRUE'  if Pipe Insulation Thickness is within the Support STANDARD limits
--              or   Returns 'FALSE' if otherwise
--
--     STRING        MINIMUM Allowed Insulation Value for the MDS Support (Set by Association with the calling function)
--     STRING        MAXIMUM Allowed Insulation Value for the MDS Support (Set by Association with the calling function)
--
--
-----------------------------------------------------------------------------------------------------------
define method .insu(!alias is STRING, !min is STRING, !max is STRING ) is BOOLEAN

  -- !this.description = 'MDS Object Method (Mdscheckstd.insu()) for Checking the Insulation Values'
  var !mode mode
  forwards

  -- Initialise variables
  -- !comp represents the MDS Standard ATTA currently being processed
  !comp = !!ce

  -- Check if the Data Property 'MNIN' (Minimum Insulation) Exists in the Dataset
  !propxs = prop MNIN
  handle (2,207)
    -- Data Property 'MNIN' does not exist, so IGNORE and return TRUE
    return TRUE
  endhandle

  -- Set insulation of prev comp or branch
  ispe ispe of prev
  handle ANY
    ispe ispe of bran
  endhandle

  -- Get the Insulation Thickness of the Selected Pipe/Component
  var !insl insu
  !insu = !insl.real()

  ---------------------------------------------------------------------------------------------------
  --<wd>feb2006<mds12>
  --
  -- Get the Insulation Despar Numbers and the Min/Max Insulation Values for the MDS Standard
  --    !parvar = '!!mdsPar' & !alias
  !bore = pa bore
  !mdsattaobj = !this.mdsdefaults
  --
  --<wd>feb2006<mds12>
  ---------------------------------------------------------------------------------------------------
  -- Determine the MINIMUM Insulation Thickness
  !dpmin = !!mdsgetdesp('MNIN')
  if (!dpmin.neq(0)) then
    ---------------------------------------------------------------------------------------------------
    --<wd>feb2006<mds12>
    --
    --      !min = $!parvar[$!bore].despars[$!dpmin]
    !min = !mdsattaobj.despars[$!dpmin]
    --
    --<wd>feb2006<mds12>
    ---------------------------------------------------------------------------------------------------
    handle ANY
      $!mode
      !!ce = !comp
      return FALSE
    endhandle
  else
    $!mode
    !!ce = !comp

    --<wd>apr2004
    !min = '0'
    --      return false

  endif
  -- Determine the MAXIMUM Insulation Thickness
  !dpmax = !!mdsgetdesp('MXIN')
  if (!dpmax.neq(0)) then
    ---------------------------------------------------------------------------------------------------
    --<wd>feb2006<mds12>
    --
    --      !max = $!parvar[$!bore].despars[$!dpmax]
    !max = !mdsattaobj.despars[$!dpmax]
    --
    --<wd>feb2006<mds12>
    ---------------------------------------------------------------------------------------------------
  else
    $!mode
    !!ce = !comp

    --<wd>apr2004
    !max = '0'
    --      return false

  endif

  -- Check if the Min/Max Values of the MDS Standard Dataset are BOTH set to the real -1
  -- These settings ALLOW the MDS Standard Ancillary to be used on ALL Pipes.
  if (!min.real().eq(-1) and !max.real().eq(-1)) then
    $!mode
    !!ce = !comp
    return TRUE
    -- Check if Selected Pipe Insulation Thickness is within the Min/Max limits of the MDS Standard
    -- <wd>apr2004 -- Now Checks Branch Insulation Thickness of 0 <zero>, against !min = 0 and !max = 0 -- SEE ABOVE
  elseif (!insu.real().geq(!min.real()) and !insu.real().leq(!max.real())) then
    $!mode
    !!ce = !comp
    return TRUE
  else
    $!mode
    !!ce = !comp
    return FALSE
  endif

endmethod
-- End of method .insu(!alias is STRING, !min is STRING , !max is STRING) is BOOLEAN

-----------------------------------------------------------------------------------------------------------
--
-- Method            material
--
-- Description:      Method to check the material of the MDS standard is equal to the pipe material
--                   This is identified by the uda :MDSPipeMat at pipespec level and the '.pipeMaterial'
--                   member of the MDS Standard !!mdsPar$<!styp>[<bore>] object.
--
-- Arguments:
--    [#]   [R/RW]    [Data Type]   [Description]
--     1       R        STRING        String where the returning error message is stored by association from
--                                    within the calling routine
-- Return:
--    [Data Type]    [Description]
--     BOOLEAN       Returns 'true'  if materials match
--              or   Returns 'false' if material do not match
--
-----------------------------------------------------------------------------------------------------------
define method .material(!matError is STRING) is BOOLEAN

  -- Initialise variables
  !comp    = !!ce

  !pipeMat = !!ce.owner.pspe.:mdspipemat
  !styp    = !!ce.styp
  !bore    = pa bore

  ---------------------------------------------------------------------------------------------------
  --<wd>feb2006<mds12>
  -- Initialise Object Variable
  !mdsattaobj = !this.mdsdefaults
  --
  --<wd>feb2006<mds12>
  ---------------------------------------------------------------------------------------------------
  -- Return true if it is a pipe rest
  if !styp.eq('PIPE-REST') or !styp.eq('SPECIAL') or !styp.eq('RACK-REST') or !styp.eq('PIPE-REST-INLINE') then
    return TRUE
  endif

  ---------------------------------------------------------------------------------------------------
  --<wd>feb2006<mds12>
  --
  --    if defined(!!mdsPar$!styp[0]) then
  --      if !!mdsPar$!styp[$!bore].pipeMaterial.trim().neq('') then
  --        !stanMat = !!mdsPar$!styp[$!bore].pipeMaterial
  --      else
  --        !stanMat = !!mdsPar$!styp[0].pipeMaterial
  --      endif
  --    else
  --      !stanMat = !!mdsPar$!styp[$!bore].pipeMaterial
  --    endif
  --
  -- ************
  -- *** NOTE ***
  -- ************
  -- The BORE SIZE CHECK for the PIPE MATERIAL is NOT Required any longer, because the CORRECT PIPE
  -- MATERIAL is DETERMINED "live" during the creation of the DATA in the "mdsreadparsdata" PML object,
  -- which is stored in the current Object member !this.mdsdefaults (!mdsattaobj)
  !stanMat = !mdsattaobj.pipeMaterial.trim()
  --
  --<wd>feb2006<mds12>
  ---------------------------------------------------------------------------------------------------
  !matList = !stanMat.split(',')
  !findIt  =  !matList.findfirst(!pipeMat)

  if !findIt.string().eq('') then
    !findIt = 0
  endif

  ---------------------------------------------------------------------------------------------------
  --<wd>feb2006<mds12>
  --
  --    if !stanMat.upcase().eq('UNSET') then
  if ((!stanMat.upcase().eq('UNSET')) or (!stanMat.upcase().eq('')) or (!stanMat.unset())) then
    --
    --<wd>feb2006<mds12>
    ---------------------------------------------------------------------------------------------------
    !matError = 'The MDS material code of the MDS standard is unset. Aborting creation!'
    return FALSE
  endif

  if !pipeMat.upcase().eq('UNSET') then
    !matError = 'The MDS material code of the pipe specification is unset. Aborting creation!'
    return FALSE
  endif

  if !stanMat.upcase().eq('ALL') or !stanMat.eq('') then
    return TRUE
  endif

  if !findIt.eq(0) then
    !matError = 'The identified pipe specification has a MDS material code of $!pipeMat and does not match the MDS standards material code/s of $!stanMat'
    return FALSE
  else
    return TRUE
  endif

endmethod
-- End of method .material() is BOOLEAN
-----------------------------------------------------------------------------------------------------------
--
-- Method            modmaterial
--
-- Description:      Method to check the material of the MDS standard is equal to the pipe material
--                   This is identified by the uda :MDSPipeMat at pipespec level and the '.pipeMaterial'
--                   member of the MDS Standard "!mdsattaobj = !this.mdsdefaults" object
--<wd>feb2006<mds12>
-- <OBSOLETE OBJECT at MDS12 = !!mdsPar$<!styp>[<bore>]>
--
-- Arguments:
--    [#]   [R/RW]    [Data Type]   [Description]
--
-- Return:
--    [Data Type]    [Description]
--     BOOLEAN       Returns 'false' if materials match
--              or   Returns 'true'  if .pipeMaterial of the MDS Standard object is set to 'ALL' or is an empty string i.e.''
--
-----------------------------------------------------------------------------------------------------------
define method .modmaterial() is BOOLEAN

  -- Initialise variables
  !comp    = !!ce

  !pipeMat = !!ce.owner.pspe.:MDSPipeMat
  !styp    = !!ce.styp

  ---------------------------------------------------------------------------------------------------
  --<wd>feb2006<mds12>
  -- Initialise Object Variable
  !mdsattaobj = !this.mdsdefaults
  --
  --<wd>feb2006<mds12>
  ---------------------------------------------------------------------------------------------------
  if !styp.eq('MAKEUP') then
    return FALSE
  endif

  -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()
  !bore   = pa bore

  -- Return Boolean as Appropriate
  if !styp.eq('PIPE-REST') or !styp.eq('SPECIAL') or !styp.eq('RACK-REST') or !styp.eq('HVAC-REST') or !styp.eq('PIPE-REST-INLINE') then
    !!kRestoreUnits(!currentUnits)
    return  FALSE
  endif

  ---------------------------------------------------------------------------------------------------
  --<wd>feb2006<mds12>
  --
  --    --!stanMat = !!mdsPar$!styp[$!bore].pipeMaterial
  --    if defined(!!mdsPar$!styp[0]) then
  --      !stanMat = !!mdsPar$!styp[0].pipeMaterial
  --    else
  --      !stanMat = !!mdsPar$!styp[$!bore].pipeMaterial
  --    endif
  --
  -- ************
  -- *** NOTE ***
  -- ************
  -- The BORE SIZE CHECK for the PIPE MATERIAL is NOT Required any longer, because the CORRECT PIPE
  -- MATERIAL is DETERMINED "live" during the creation of the DATA in the "mdsreadparsdata" PML object,
  -- which is stored in the current Object member !this.mdsdefaults (!mdsattaobj)
  !stanMat = !mdsattaobj.pipeMaterial.trim()
  --
  --<wd>feb2006<mds12>
  ---------------------------------------------------------------------------------------------------

  !!kRestoreUnits(!currentUnits)
  !matList = !stanMat.split(',')
  !findIt  = !matList.findfirst(!pipeMat)

  if !findIt.string().eq('') then
    !findIt = 0
  endif

  ---------------------------------------------------------------------------------------------------
  --<wd>feb2006<mds12>
  --
  --    if !stanMat.upcase().eq('UNSET') then
  if ((!stanMat.upcase().eq('UNSET')) or (!stanMat.upcase().eq('')) or (!stanMat.unset())) then
    --
    --<wd>feb2006<mds12>
    ---------------------------------------------------------------------------------------------------
    return FALSE
  endif

  if !pipeMat.upcase().eq('UNSET') then
    return FALSE
  endif

  if !stanMat.upcase().eq('ALL') or !stanMat.eq('') then
    return TRUE
  endif

  if !findIt.eq(0) then
    return FALSE
  else
    return TRUE
  endif

  if (!stanMat.upcase().eq(!pipeMat.upcase())) then
    return FALSE
  endif

endmethod
--
-- End of method .modmaterial() is BOOLEAN
--
-----------------------------------------------------------------------------------------------------------
--
-- Method            bores
--
-- Description:      Method to check the bore of the selected pipe
--
-- Arguments:
--    [#]   [R/RW]    [Data Type]   [Description]
--     1     R        STRING       The MDS template name
--
-- Return:
--    [Data Type]    [Description]
--     BOOLEAN       Returns 'True'  if bore is OK
--              or   Returns 'False' if bore is out of range
--
--
-----------------------------------------------------------------------------------------------------------
define method .bores(!template is STRING) is BOOLEAN

  -- !this.description = 'MDS Object Method (Mdscheckstd.bore()) for Checking bores'
  var !mode mode
  forwards

  !return = TRUE

  -- Initialise variables
  !comp = !!ce

  -- Get current bore
  --<wd>dec2002
  --var !bore abore
  --<wd>dec2002
  var !bore lbore
  handle ANY
    var !bore hbore
  endhandle

  -- get template maximum bore
  !maxBore = :MDSMaxBore of $!template
  !minBore = :MDSMinBore of $!template

  if !bore.real().gt(!maxBore) then
    !return = FALSE
  endif

  if !bore.real().lt(!minBore) then
    !return = FALSE
  endif

  return $!return

endmethod
-- End of method .bore(!template is STRING) is BOOLEAN
--
-----------------------------------------------------------------------------------------------------------
-->>>-<wd>dec2002
--
-- Method            shoeheight
--
-- Description:      Method to check the HEIGHT of selected SHOE is within the Permissible Height Range for the MDS Standard
--
-- Arguments:
--    [#]   [R/RW]  [Data Type]   [Description]
--     1     RW      FORM          The Form this method is being called from
--     2     R       DBREF         The selected/associated MDS SHOE Atta
--     3     R       DBREF         The MDS Cradle Pad Atta
--     4     RW      STRING        The Warning to Return by association from the calling function
--
-- Return:
--    [Data Type]   [Description]
--     BOOLEAN       Returns 'true'  if the SHOE Height is within the MDS Standards Permissible MIN/MAX Height Range
--              or   Returns 'false' if the SHOE Height is out of the MDS Standards Permissible MIN/MAX Height Range
--
--     STRING        Returns the variable !shoewarning by association from the calling function
--
-- This method is called when **ADDING** an Associated Cradle/Reinforcing Pad to a SHOE
--
-----------------------------------------------------------------------------------------------------------
define method .shoeheight(!form is FORM, !atta is DBREF, !rpad is DBREF, !shoewarning is STRING) is BOOLEAN

  -- Shoe Details
  -- Get the Design Parameter Number for the Property Code 'HEI'<Shoe Height> on the Selected SHOE Atta
  !existce  = !!ce
  !!ce      = !atta
  !bore     = !atta.lbor
  !supptype = !atta.stype
  ---------------------------------------------------------------------------------------------------
  --<wd>feb2006<mds12>
  --
  --    !parvar   = '!!mdsPar' & !supptype
  -- The Pipe SHOE <!atta> MUST be represented here by the MDSREADPARSDATA PML OBJECT,
  -- and NOT the RPAD<!rpad> to determine the Pipe SHOE Height, Reference etc...
  !lbor = !bore.real()
  !attastype   = !atta.stype
  !mdsattaobj = object MDSREADPARSDATA()
  !mdsattadefs  = !mdsattaobj.mdsdefsdata(!attastype, !lbor)
  !!ce = !atta
  --
  --<wd>feb2006<mds12>
  ---------------------------------------------------------------------------------------------------
  !dpnum = !!mdsgetdesp('HEI')
  -- For AN10
  if !dpnum.eq(0) then
    !dpnum = !!mdsgetdesp('FHEI')
  endif
  ---------------------------------------------------------------------------------------------------
  --<wd>feb2006<mds12>
  --
  --    !min      = $!parvar[$!bore].userdps[$!dpnum].min
  --    !max      = $!parvar[$!bore].userdps[$!dpnum].max
  --<dw>mar2009 DFN P-16466 Convert to metric for reference to mds defaults
  units mm bore
  !min = !mdsattaobj.userdps[!dpnum].min
  !max = !mdsattaobj.userdps[!dpnum].max
  --
  --<wd>feb2006<mds12>
  ---------------------------------------------------------------------------------------------------
  -- Set the Form Members Shoe Reference and Existing Height of the Shoe
  !form.shoeref = !atta
  handle (2,759)  $* Form object does not have a member SHOEREF, MUST be on FRAMEWORK so Use the form !!mdsancill
    !!mdsancill.shoeref = !atta
  endhandle
  !form.shoehei = !atta.desp[$!dpnum]
  handle (2,759)  $* Form object does not have a member SHOEHEI, MUST be on FRAMEWORK so Use the form !!mdsancill
    !!mdsancill.shoehei = !atta.desp[$!dpnum]
  endhandle

  !!mdsDacControl(TRUE)

  -->>>-<wd>feb2003
  if (!rpad.stype inset ('AT40A','AT40B','AT40C','AT40D','AT40E','AT40F','AT41A','AT41B','AT41C','AT41D','AT41E','AT41F','AT42','AT100A','AT100B','AT101A','AT101B')) then

    -- Isolation Pad Details
    -- Get the Design Parameter Number for the Property Code 'XHEI'<Isolation Pad SHOE Height> on the ISOLATION PAD Atta
    !!ce       = !rpad
    --!pxbor     = !rpad.lbor
    --!pxsupptyp = !rpad.stype
    ---------------------------------------------------------------------------------------------------
    --<wd>feb2006<mds12>
    -- REDUNDANT CODE -- The variable !pxparvar defined below is NOT used any where in this METHOD
    --      !pxparvar  = '!!mdsPar' & !pxsupptyp
    --
    --<wd>feb2006<mds12>
    ---------------------------------------------------------------------------------------------------
    !pxdpnum   = !!mdsgetdesp('XHEI')

    -- Set the Appropriate DESPAR value of the Isolation Pad referencing the Associated SHOE Height
    !shoehei   = !atta.desp[$!dpnum]
    !rpad.desp[$!pxdpnum] = !shoehei

    !return = TRUE

  else
    --<<<-<wd>feb2003

    -- Pipe Cradle/Reinforcing Pad Details
    -- Get the Design Parameter Number for the Property Code 'THK'<Cradle Pad Thickness> on the CRADLE PAD Atta
    !!ce      = !rpad
    !xbor     = !rpad.lbor
    !xsupptyp = !rpad.stype
    ---------------------------------------------------------------------------------------------------
    --<wd>feb2006<mds12>
    --
    --      !xparvar  = '!!mdsPar' & !xsupptyp
    -- Determine the MDSREADPARSDATA PML Object Data for the RPAD<!rpad> at the BORE<!xbor>
    !rpadattaobj  = object MDSREADPARSDATA()
    !unusedrpadattadefs = !rpadattaobj.mdsdefsdata(!xsupptyp,!xbor.real())
    -- Temporary GLobal Variable
    !!robj = !rpadattaobj
    --
    --<wd>feb2006<mds12>
    ---------------------------------------------------------------------------------------------------
    !xdpnum = !!mdsgetdesp('THK')
    ---------------------------------------------------------------------------------------------------
    --<wd>feb2006<mds12>
    --
    --      !xmin     = $!xparvar[$!xbor].userdps[$!xdpnum].min
    --      !xmax     = $!xparvar[$!xbor].userdps[$!xdpnum].max
    --!xmin = !rpadattaobj.userdps[!xdpnum].min
    --!xmax = !rpadattaobj.userdps[!xdpnum].max
    --
    --<wd>feb2006<mds12>
    ---------------------------------------------------------------------------------------------------
    !xthk   = !rpad.desp[$!xdpnum]

    -- Get the Design Parameter Number for the Property Code 'PTHK'<Cradle Pad Thickness> on the SHOE Atta
    !!ce    = !atta
    !pdpnum = !!mdsgetdesp('PTHK')
    -- Set the SHOE Pad Thickness Design Parameter
    !atta.desp[$!pdpnum] = $!xthk

    -- Get the Design Parameter Number and Value for the Property Code 'LEN' Shoe length on the SHOE Atta
    !!ce      = !atta
    !sldpnum  = !!mdsgetdesp('LEN')
    !shoelen  = !atta.desp[$!sldpnum]

    -- Get the Design Parameter Number and Get the Value for the Property Codes 'LEN' Pad length and 'OLAP' Shoe Overlap on the Cradle PAD Atta
    !!ce      = !rpad
    !pldpnum  = !!mdsgetdesp('LEN')
    !oldpnum  = !!mdsgetdesp('OLAP')
    ---------------------------------------------------------------------------------------------------
    --<wd>feb2006<mds12>
    --
    --      !olap     = $!xparvar[$!xbor].despars[$!oldpnum].real()
    !olap     = !rpadattaobj.despars[!oldpnum].real()
    --<wd>feb2006<mds12>
    ---------------------------------------------------------------------------------------------------
    !rpad.desp[$!oldpnum] = !olap
    --  Get the Cradle Pad Min/Max Lengths and Set Variable !padlen and the PAD Length Design Parameter to The Existing SHOE Length + Twice the Overlap Despar of the Cradle Pad
    ---------------------------------------------------------------------------------------------------
    --<wd>feb2006<mds12>
    --
    --      !plmin    = $!xparvar[$!xbor].userdps[$!pldpnum].min
    --      !plmax    = $!xparvar[$!xbor].userdps[$!pldpnum].max
    !plmin    = !rpadattaobj.userdps[!pldpnum].min
    !plmax    = !rpadattaobj.userdps[!pldpnum].max
    --
    --<wd>feb2006<mds12>
    ---------------------------------------------------------------------------------------------------
    !padlen   = !shoelen + (2 * !olap)
    !rpad.desp[$!pldpnum] = $!padlen

    -- Check if the New SHOE Height is within the Permissible Height Range
    -- when the Thickness of the  Associated Cradle Pad is SUBTRACTED
    !oldshoeh = !atta.desp[$!dpnum]
    !newshoeh = (!oldshoeh - !xthk)

    -- Check New SHOE Height Against the Permissible MINIMUM Height
    if (!newshoeh.nint().lt(!min.nint())) then
      !!kformattext.text.val = !min
      !minval = TRUE
      !frmhei = !newshoeh.string(!!distancefmt)
      !minhei = !min.string(!!distancefmt)
      !shoewarning = | - The NEW SHOE Height $!frmhei is less than the minimum allowed. Setting SHOE height to the minimum of $!minhei|
      !!mdssetdespar(!atta,!dpnum,!min.real())
      !!ce = !existce
      !return = FALSE
    else
      !minval = FALSE
    endif

    -- Check New SHOE Height Against the Permissible MAXIMUM Height
    if (!newshoeh.nint().gt(!max.nint())) then
      !!kformattext.text.val = !max
      !maxval = TRUE
      !frmhei = !newshoeh.string(!!distancefmt)
      !maxhei = !max.string(!!distancefmt)
      !shoewarning = | - The NEW SHOE Height $!frmhei is greater than the maximum allowed. Setting SHOE height to the maximum of $!maxhei|
      !!mdssetdespar(!atta,!dpnum,!max.real())
      !!ce = !existce
      !return = FALSE
    else
      !maxval = FALSE
    endif

    -- SHOE Height is within the Permissible Range, so silently
    -- Set The Despars here if value is within the Permissible Min/Max SHOE Height limits
    if (!minval.not() and !maxval.not()) then
      !!mdssetdespar(!atta,!dpnum,!newshoeh)
      !!ce = !existce
      !return = TRUE
    endif

    -- PAD LENGTH can be EXCEEDED if SHOE LENGTH is the same or near the SHOE's Min/Max Length

    -- Set the Cradle Pad Length Design Parameter to The Existing SHOE Length + Twice the Overlap Despar of the Cradle Pad
    -- Check New PAD LENGTH Against the Permissible MINIMUM LENGTH
    if (!padlen.nint().lt(!plmin.nint())) then
      !!kformattext.text.val = !plmin
      !plminval = TRUE
      !frmplen  = !padlen.string(!!distancefmt)
      !plminlen = !plmin.string(!!distancefmt)
      if (!shoewarning.unset()) then
        !shoewarning = ''
      endif
      !shoewarning = !shoewarning & | - The NEW PAD Length $!frmplen is less than the minimum allowed. Setting PAD Length to the minimum of $!plminlen |
      !!mdssetdespar(!rpad,!pldpnum,!plmin.real())
      !!ce = !existce
      !return = FALSE
    else
      !plminval = FALSE
    endif

    -- Check New PAD LENGTH Against the Permissible MAXIMUM LENGTH
    if (!padlen.nint().gt(!plmax.nint())) then
      !!kformattext.text.val = !plmax
      !plmaxval = TRUE
      !frmplen  = !padlen.string(!!distancefmt)
      !plmaxlen = !plmax.string(!!distancefmt)
      if (!shoewarning.unset()) then
        !shoewarning = ''
      endif
      !shoewarning = !shoewarning & | - The NEW PAD Length $!frmplen is greater than the maximum allowed. Setting PAD Length to the maximum of $!plmaxlen |
      !!mdssetdespar(!rpad,!pldpnum,!plmax.real())
      !!ce = !existce
      !return = FALSE
    else
      !plmaxval = FALSE
    endif

    -- PAD LENGTH is within the Permissible Range, so silently
    -- Set The Despars here if value is within the Permissible Min/Max PAD Length limits
    if (!plminval.not() and !plmaxval.not()) then
      !!mdssetdespar(!rpad,!pldpnum,!padlen)
      !!ce = !existce
      !return = TRUE
    endif

    -->>>-<wd>feb2003
  endif
  --<<<-<wd>feb2003
  --<dw>mar2009 DFN P-16466 Convert back to original units.
  if(!!kgetBoreUnits()) then
    units in bore
  endif

  !!mdsDacControl(FALSE)

  return !return

endmethod
--
-- End of method .shoeheight (!form is FORM, !atta is DBREF, !rpad is DBREF ,!shoewarning is STRING ) is BOOLEAN
--<<<-<wd>dec2002
-----------------------------------------------------------------------------------------------------------
--
-----------------------------------------------------------------------------------------------------------
--<dw>jan2009 dun1081 - New method to allow line stops to be associated with reinforcing pads - P16049
--
-- Method            stopheight
--
-- Description:      Method to check the LENGTH of selected PAD is within the Permissible Length Range for the MDS Standard
--
-- Arguments:
--    [#]   [R/RW]  [Data Type]   [Description]
--     1     RW      FORM          The Form this method is being called from
--     2     R       DBREF         The selected/associated MDS Line Stop Atta
--     3     R       DBREF         The MDS Reinforcing Pad Atta
--
-- Return:
--    [Data Type]   [Description]
--     BOOLEAN       Returns 'TRUE'  if the Pad length is within the MDS Standards Permissible MIN/MAX Height Range
--              or   Returns 'FALSE' if the Pad length is out of the MDS Standards Permissible MIN/MAX Height Range
--
-- This method is called when **ADDING** an Associated Reinforcing Pad to a Line Stop
--
-----------------------------------------------------------------------------------------------------------

define method .stopheight(!form is FORM, !atta is DBREF, !rpad is DBREF) is BOOLEAN


  -- Get the Design Parameter Number for the Property Code 'HEI'<Shoe Height> on the Selected SHOE Atta
  !existce  = !!ce
  !!ce      = !atta
  !bore     = !atta.lbor
  !supptype = !atta.stype

  --<RM 06/08/09> updated incompatible mds11.6.sp5 code to work in the 12 environment
  -- The Pipe STOP <!atta> MUST be represented here by the MDSREADPARSDATA PML OBJECT,
  -- and NOT the RPAD<!rpad> to determine the Pipe STOP Height, Reference etc...
  !lbor = !bore.real()
  !attastype   = !atta.stype
  !mdsattaobj = object MDSREADPARSDATA()
  !mdsattadefs  = !mdsattaobj.mdsdefsdata(!attastype, !lbor)
  !!ce = !atta

  -- Stop Details
  -- Get the Design Parameter Number for the Property Code 'STLH'<Guide Steel height> on the Selected STOP Atta
  !sdpnum  = !!mdsgetdesp('STLH')
  !orighei = !mdsattaobj.despars[!sdpnum]

  -- Reinforcing Pad Details
  -- Get the Design Parameter Number for the Property Code 'THK'<Pad Thickness> on the REINFORCING PAD Atta
  !!ce     = !rpad
  !rbor    = !rpad.lbor.real()
  !rsuptyp = !rpad.stype

  !mdsrpadobj = object MDSREADPARSDATA()
  !unusedmdsrpaddefs  = !mdsrpadobj.mdsdefsdata(!rsuptyp, !rbor)
  !rdpnum  = !!mdsgetdesp('THK')
  !rthk    = !mdsrpadobj.despars[!rdpnum]

  --<dw>mar2009 DFN P-16885 Apply DAC control to change attributes.
  !!mdsDacControl(TRUE)
  -- Get the Design Parameter Number for the Property Code 'PTHK'<Pad Thickness> on the STOP Atta
  !!ce     = !atta
  !pdpnum  = !!mdsgetdesp('PTHK')
  -- Set the STOP Pad Thickness Design Parameter
  !atta.desp[$!pdpnum] = !rthk.real() * 2
  -- Increase the height of the stop and the cut back volume
  !newstoph = (!orighei.real() + !rthk.real())
  !!mdssetdespar(!atta,!sdpnum,!newstoph)

  -- Get the Design Parameter Number and Value for the Stop length on the STOP Atta
  !!ce      = !atta
  !sldpnum  = !!mdsgetdesp('LEN')
  !stopstl  = !atta.desp[$!sldpnum]
  if !atta.stype inset ('ST57','ST58') then
    !swdpnum  = !!mdsgetdesp('WID')
    !stopwid  = !atta.desp[$!swdpnum]
    !scdpnum  = !!mdsgetdesp('CLR')
    !stopclr  = !atta.desp[$!scdpnum]
    !stoplen  = (!stopwid + (2 * !stopstl) + (2 * !stopclr))
  else
    !stoplen  = !stopstl
  endif

  -- Get the Design Parameter Number and Get the Value for the Property Codes 'LEN' Pad length and 'OLAP' Stop Overlap on the REINFORCING PAD Atta
  !!ce      = !rpad
  !pldpnum  = !!mdsgetdesp('LEN')
  !oldpnum  = !!mdsgetdesp('OLAP')
  !olap     = !rpad.desp[$!oldpnum]

  -- Set Variable !padlen and the PAD Length Design Parameter to The Existing STOP Length + Twice the Overlap Despar of the Pad
  --<dw>mar2009 DFN P-16466 Convert to metric for reference to mds defaults
  units mm bore
  !plmin    = !mdsrpadobj.userdps[!pldpnum].min
  !plmax    = !mdsrpadobj.userdps[!pldpnum].max
  --<RM 06/08/09> - end

  !padlen   = !stoplen + (2 * !olap)
  !rpad.desp[$!pldpnum] = $!padlen

  -- Check New PAD LENGTH Against the Permissible MAXIMUM LENGTH
  if (!padlen.nint().gt(!plmax.nint())) then
    !!kformattext.text.val = !plmax
    !plmaxval = TRUE
    !frmplen  = !padlen.string(!!distancefmt)
    !plmaxlen = !plmax.string(!!distancefmt)
    !!alert.error(|The NEW PAD Length $!frmplen is greater than the maximum allowed. setting PAD Length to the maximum of $!plmaxlen |)
    !!mdssetdespar(!rpad,!pldpnum,!plmax.real())
    !!ce = !atta
    !return = FALSE
  else
    !plmaxval = FALSE
  endif
  --<dw>mar2009 DFN P-16466 Convert back to original units.
  if(!!kgetBoreUnits()) then
    units in bore
  endif
  --<dw>mar2009 DFN P-16885 End DAC control for changing attributes.
  !!mdsDacControl(FALSE)

endmethod

--<dw>jan2009 dun1081 - End of new method allowing line stops to be associated with reinforcing pads
-----------------------------------------------------------------------------------------------------------
--
-----------------------------------------------------------------------------------------------------------
-->>>-<wd>dec2002
--
-- Method            shoeheight
--
-- Description:      Method to check the HEIGHT of the associated SHOE is within the Permissible Height Range for the MDS Standard
--
-- Arguments:
--    [#]   [R/RW]  [Data Type]   [Description]
--     1     R       DBREF         The selected/associated MDS SHOE Atta
--     2     R       DBREF         The MDS Cradle Pad Atta
--     3     RW      STRING        The Warning to Return by association from the calling function
--
-- Return:
--    [Data Type]   [Description]
--     BOOLEAN       Returns 'TRUE'  if the SHOE Height is within the MDS Standards Permissible MIN/MAX Height Range
--              or   Returns 'FALSE' if the SHOE Height is out of the MDS Standards Permissible MIN/MAX Height Range
--
--     STRING        Returns the variable !shoewarning by association from the calling function
--
-- This method is called when **DELETING** an Associated Cradle/Reinforcing Pad to a SHOE
--
-----------------------------------------------------------------------------------------------------------
define method .shoeheight(!atta is DBREF, !dummypad is DBREF, !shoewarning is STRING) is BOOLEAN

  -- Get the Design Parameter Number for the Property Code 'HEI'<Shoe Height> on the Selected SHOE Atta
  !existce  = !!ce
  !!ce      = !atta
  !bore     = !atta.lbor
  !supptype = !atta.stype
  ---------------------------------------------------------------------------------------------------
  --<wd>feb2006<mds12>
  --
  --    !parvar   = '!!mdsPar' & !supptype
  !dpnum = !!mdsgetdesp('HEI')
  --    !min = $!parvar[$!bore].userdps[$!dpnum].min
  --    !max = $!parvar[$!bore].userdps[$!dpnum].max
  -- The Pipe SHOE <!atta> MUST be represented here by the MDSREADPARSDATA PML OBJECT,
  -- and NOT the RPAD<!pad> to determine the Pipe SHOE Height, Reference etc...
  !lbor = !bore.real()
  !attastype   = !atta.stype
  !mdsattaobj = object MDSREADPARSDATA()
  !mdsattadefs  = !mdsattaobj.mdsdefsdata(!attastype, !lbor)
  !!ce = !atta
  !min = $!mdsattaobj.userdps[$!dpnum].min
  !max = $!mdsattaobj.userdps[$!dpnum].max
  --
  --<wd>feb2006<mds12>
  ---------------------------------------------------------------------------------------------------
  -- Get the Design Parameter Number for the Property Code 'PTHK'<Cradle Pad Thickness> on the SHOE Atta
  !!ce      = !atta
  !pdpnum   = !!mdsgetdesp('PTHK')
  !xpthk    = !atta.desp[$!pdpnum]
  -- Set the SHOE Atta Pad Thickness Design Parameter to ZERO
  !atta.desp[$!pdpnum] = 0
  -- Reset the SHOE Atta uda :mdssref to unset
  :mdssref unset

  -- Check if the New SHOE Height is within the Permissible Height Range
  -- when the Thickness of the  Associated Cradle Pad is SUBTRACTED
  !oldshoeh = !atta.desp[$!dpnum]
  !newshoeh = (!oldshoeh + !xpthk)

  -- Check New SHOE Height Against the Permissible MINIMUM Height
  if (!newshoeh.nint().lt(!min.nint())) then
    !!kformattext.text.val = !min
    !minval = TRUE
    !frmhei = !newshoeh.string(!!distancefmt)
    !minhei = !min.string(!!distancefmt)
    !shoewarning = |The NEW SHOE Height $!frmhei is less than the minimum allowed. Setting SHOE height to the minimum of $!minhei|
    !!mdssetdespar(!atta,!dpnum,!min.real())
    !!ce = !existce
    return FALSE
  else
    !minval = FALSE
  endif

  -- Check New SHOE Height Against the Permissible MAXIMUM Height
  if (!newshoeh.nint().gt(!max.nint())) then
    !!kformattext.text.val = !max
    !maxval = TRUE
    !frmhei = !newshoeh.string(!!distancefmt)
    !maxhei = !max.string(!!distancefmt)
    !shoewarning = |THe NEW SHOE Height $!frmhei is greater than the maximum allowed. Setting SHOE height to the maximum of $!maxhei|
    !!mdssetdespar(!atta,!dpnum,!max.real())
    !!ce = !existce
    return FALSE
  else
    !maxval = FALSE
  endif

  -- SHOE Height is within the Permissible Range, so SILENTLY Set The Despars
  -- here if value is within the Permissible Min/Max SHOE Height limits
  if (!minval.not() and !maxval.not()) then
    !!mdssetdespar(!atta,!dpnum,!newshoeh)
    !!ce = !existce
    return TRUE
  endif

endmethod


-----------------------------------------------------------------------------------------------------------
--
-- Method            temp
--
-- Description:      Method to check the temperature of the Identified Pipe
--                   on which the selected ATTA is to be located, is within the MINIMUM
--                   and MAXIMUM limits defined for the passed MDS Standard Type.
--                   Use custom selection criteria if defined by user.
--
-- Arguments:
--    [#]   [R/RW]    [Data Type]   [Description]
--     1     R        STRING       The MDS Support 'Alias' name
--     2     R        STRING       The MDS Support Minimum Temperature Variable
--     3     R        STRING       The MDS Support Maximum Temperature Variable
--
-- Return:
--    [Data Type]    [Description]
--     BOOLEAN       Returns 'TRUE'  if Pipe temperature is within the Support STANDARD limits
--              or   Returns 'FALSE' if otherwise
--
--     STRING        Minimum Allowed temperature value for the MDS Support (Set by Association with the calling function)
--     STRING        Maximum Allowed temperature value for the MDS Support (Set by Association with the calling function)
--
--
-----------------------------------------------------------------------------------------------------------
define method .temp(!alias is STRING, !tmin is STRING , !tmax is STRING) is BOOLEAN

  -- !this.description = 'MDS Object Method (Mdscheckstd.temp()) for Checking the temperatures'
  var !mode mode
  forwards

  -- Initialise variables
  !comp = !!ce
  -- Check if the Data Property 'MINT' (Minimum Temperature) Exists in the Dataset
  !propxs = prop MINT
  handle (2,207) $* Data Property 'MINT' does not exist
    return TRUE
  endhandle

  -- Get the temperature of the Selected Pipe/Component
  !bran = bran
  !temp = !!mdsSelectionCriteria.temperature(!bran)
  if (!temp.unset()) then
    return true
  endif
  ---------------------------------------------------------------------------------------------------
  --<wd>feb2006<mds12>
  --
  -- Get the Temperature Despar Numbers and the Min/Max Temperature Values for the MDS Standard
  --    !parvar = '!!mdsPar' & !alias
  !bore = pa bore
  !mdsattaobj = !this.mdsdefaults
  --
  --<wd>feb2006<mds12>
  ---------------------------------------------------------------------------------------------------
  !dpmin = !!mdsgetdesp('MINT')

  if (!dpmin.neq(0)) then
    ---------------------------------------------------------------------------------------------------
    --<wd>feb2006<mds12>
    --
    --      !tmin = $!parvar[$!bore].despars[$!dpmin]
    !tmin = !mdsattaobj.despars[$!dpmin].string()
    --
    --<wd>feb2006<mds12>
    ---------------------------------------------------------------------------------------------------
    handle ANY
      -- Default property of MINT attribute
      !tmin = (prde MINT)
      --$!mode
      --!!ce = !comp
      --return FALSE
    endhandle
  else
    $!mode
    !!ce = !comp
    !tmin = '0'
  endif

  !dpmax = !!mdsgetdesp('MAXT')
  if (!dpmax.neq(0)) then
    ---------------------------------------------------------------------------------------------------
    --<wd>feb2006<mds12>
    --
    --      !tmax = $!parvar[$!bore].despars[$!dpmax]
    !tmax = !mdsattaobj.despars[$!dpmax].string()
    --
    --<wd>feb2006<mds12>
    ---------------------------------------------------------------------------------------------------
    handle ANY
      !tmax = (prde MAXT)
    endhandle
  else
    $!mode
    !!ce = !comp
    !tmax = '0'
  endif


  -- Check if the Min/Max Values of the MDS Standard Dataset are BOTH set to the real -1
  -- These settings ALLOW the MDS Standard Ancillary to be used on ALL Pipes.
  if (!tmin.real().eq(-1) and !tmax.real().eq(-1)) then
    $!mode
    !!ce = !comp
    return TRUE
    -- Check if Selected Pipe Insulation Thickness is within the Min/Max limits of the MDS Standard
    -- <wd>apr2004 -- Now Checks Branch Insulation Thickness of 0 <zero>, against !min = 0 and !max = 0 -- SEE ABOVE
  elseif (!temp.real().geq(!tmin.real()) and !temp.real().leq(!tmax.real())) then
    $!mode
    !!ce = !comp
    return TRUE
  else
    $!mode
    !!ce = !comp
    return FALSE
  endif

endmethod

-- End of method .temp(!alias is STRING, !tmin is STRING , !tmax is STRING) is BOOLEAN

--
-----------------------------------------------------------------------------------------------------------
--

define method .elevation(!alias is STRING) is BOOLEAN

  ---------------------------------------------------------------------------------------------------
  --<wd>feb2006<mds12>
  --
  -- Find out if we have an elevation to check
  -- -- The DES-SUPP-PARS file uses the [0] bore line to store the elevation restriction if any
  -- If it is set to *, then no restriction applies
  --
  --  !elevation = !!mdsPar$!alias[0].despars[1]
  --  handle ANY
  --    return TRUE
  --  elsehandle NONE
  --  endhandle
  --
  -- ************
  -- *** NOTE ***
  -- ************
  -- The ELEVATION data is DETERMINED "live" during the creation of the DATA in the "mdsreadparsdata" PML object,
  -- which is stored in the current Object member !this.mdsdefaults (!mdsattaobj)
  --
  -- Initialise Object Variable etc...
  !mdsattaobj = !this.mdsdefaults
  !elevation   = !mdsattaobj.elevation
  --
  --<wd>feb2006<mds12>
  ---------------------------------------------------------------------------------------------------
  if !elevation.eq('*') then
    return TRUE
  endif

  -- The component may not be positioned, check the position flag attribute to see if it has
  -- if not then position at the pl of prev or head

  if !!ce.posf.not() then
    pos at pl of prev
    handle ANY
      pos at ph
    endhandle
  endif

  -- Get Elevation values from atta
  !pos = !!ce.position.wrt(/* )
  !z = !pos.up

  -- Check if the selected elevation is less than the elevation in DES-SUPP-PARS file

  if !z.lt(!elevation.real()) then
    return FALSE
  else
    return TRUE
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      criteria
--
-- Description: Checks current element on passing user defined criteria
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    STRING      Empty on pass, else contains number of failing criteria
------------------------------------------------------------------------

define method .criteria() is STRING

  -- Do not pass current element directly because method changes !!ce while working
  !testRef = !!ce
  !result = !!mdsSelectionCriteria.passed(!testRef, !testRef.owner)
  return !result

endmethod
