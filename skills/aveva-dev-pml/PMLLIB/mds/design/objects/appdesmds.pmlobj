define object APPDESMDS
endobject

define method .modifyForm()
  !this.toolbars()
endmethod

define method .barMenu()
  !bmenu = object APPBARMENU()
  !bmenu.add(|Position|, 'POSITION')
  !bmenu.add(|Orientate|, 'ORI')
  --<GE> 25/01/07 Fix for Software Defect: 10165
  -- !bmenu.add(|Connect|, 'CONN')
  --<GE> 25/01/07
  !!appMenuCntrl.addBarMenu(!bmenu, 'MDS')
endmethod

define method .displayMenu()
  !menu = object APPMENU('sysView')
  !!appMenuCntrl.addMenu(!menu, 'MDS')
endmethod

define method .graphMenu()
  !menu = object APPMENU('sysGph')
  !!appMenuCntrl.addMenu(!menu, 'MDS')
endmethod

define method .queryMenu()
  !menu = object APPMENU('sysQry')
  !!appMenuCntrl.addMenu(!menu, 'MDS')
endmethod

define method .settingsMenu()
  !menu = object APPMENU('sysSet')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |MDS Defaults|, 'DEFAULTS', 'mdsDefaults')
  !menu.add('CALLBACK', |MDS AutoNaming...|, |show !!mdsautoname|, 'mdsAutoNaming')
  !menu.add('MENU', |MDS Welds|, 'MDSWELDS', 'mdsWelds')
  -- Add the WitchHanger DB selection menu and to turn off to turn on later(See PML file mdsreadddefs.pmlfnc)
  -- If we are using the CPL interface
  !menu.add('CALLBACK', |WitchHanger DB Selection...|, '!!mdsCPlDB.setdb()', 'WHDBSEL')
  !!appMenuCntrl.addMenu(!menu, 'MDS')

endmethod

define method .utilsMenu()
  !menu = object APPMENU('sysUtil')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |MDS Reports...|, |!!mdsnewreports.init('initial')|, 'mdsReports')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |MDS Support Health Check...|, |!!mdshealthchk.show()|, 'mdshealthchk')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |Add Support/s|, 'ADDSUPP', 'mdsAddSupports')
  !menu.add('CALLBACK', |MDS Wizard...|, |!!mdsWizard.show('AT',0,0)|, 'mdsWizard')
  !menu.add('CALLBACK', |ReOrder Branch Attas|, |!!mdsreoatta(!!ce)|, 'mdsReOrderBranchAttas')
  !menu.add('CALLBACK', |Clear Dimensions/Tags|, |!!mdsClearDim()|, 'mdsClearDimensionsTags')
  !menu.add('CALLBACK', |Make Support Controlled|, |!!mdsMakeControl()|, 'mdsMakeControl')
  !menu.add('CALLBACK', |Navigate to Master member|, |!!mdsMainMember()|, 'mdsMainMember')
  --<wd>23nov2006
  !menu.add('CALLBACK', |WitchHanger Print|, |show !!mdsPrint|, 'mdsWhPrint')
  --<wd>23nov2006

  -- Framatome Electrical Report
  !ce = !!ce
  /MDS/TEMPLATES
  handle ANY
    --do nothing
  elsehandle NONE
    if (desc of /MDS/TEMPLATES eq 'Framatome Templates') then
      !menu.add('SEPARATOR')
      !menu.add('CALLBACK', |Electrical Report...|, |!!mdsTrayRep.show('AT',0,0)|, 'MdsTrayRep')
    endif
    -- Framatome Pipe & Hvac Report
    if (desc of /MDS/TEMPLATES eq 'Framatome Templates') then
      !menu.add('CALLBACK', |HVAC Report...|, |!!mdssupportrep.init('HVAC')|, 'mdsHVACsupportrep')
      !menu.add('CALLBACK', |PIPE Report...|, |!!mdssupportrep.init('PIPE')|, 'mdsPIPEsupportrep')
    endif
  endhandle
  !!ce = !ce

  --dun1218 added mdsinterfacemacromanagement tool to this MENU - start
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Hanger Connection Macro Management|, |show !!mdsInterfaceManageMacros|, 'mdsHangConnManager')
  --dun1218 added mdsinterfacemacromanagement tool to this MENU - end

  !!appMenuCntrl.addMenu(!menu, 'MDS')

endmethod

define method .createMenu()
  !menu = object APPMENU('sysCrt')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Multi Discipline frame...|, |!!mdssitecheck(!!mdsFrame)|, 'mdsMultiDisciplineFrame')
  !menu.add('CALLBACK', |General...|, |!!mdssitecheck(!!mdsGeneral)|, 'mdsGeneral')
  !menu.add('CALLBACK', |Cable Rack...|, |!!mdssitecheck(!!mdsCable)|, 'mdsCableRack')
  !menu.add('CALLBACK', |HVAC...|, |!!mdssitecheck(!!mdsHvac)|, 'mdsHVAC')
  !menu.add('CALLBACK', |Anchors...|, |!!mdssitecheck(!!mdsAnchor)|, 'mdsAnchors')
  !menu.add('CALLBACK', |Fixed Hanger...|, |!!mdsCreateHanger('FH')|, 'mdsFixedHanger')
  !menu.add('CALLBACK', |Variable Hanger...|, |!!mdsCreateHanger('VH')|, 'mdsVariableHanger')
  -- !menu.add('CALLBACK', |Constant Hanger...|, |!!alert.error('No constant hangers available at this release')|, 'mdsConstantHanger')
  !menu.add('CALLBACK', |Guides and Stops...|, |!!mdssitecheck(!!mdsGuide)|, 'mdsGuidesandStops')
--<wd>30may2006<mds12>
  !menu.add('CALLBACK', |Lighting Support...|, |!!mdsls01.init('create')|, 'mdslightingsupport')
--<wd>30may2006<mds12>
  !menu.add('CALLBACK', |Slip Units...|, |!!mdssitecheck(!!mdsSlip)|, 'mdsSlipUnits')
  !menu.add('CALLBACK', |Special...|, |!!mdsiNameSpl()|, 'mdsSpecial')
  !menu.add('CALLBACK', |Springs...|, |!!mdssitecheck(!!mdsSpring)|, 'mdsSprings')
  !menu.add('CALLBACK', |Trunnion...|, |!!mdssitecheck(!!mdsTrunn)|, 'mdsTrunnion')
  !menu.add('CALLBACK', |Vessels...|, |!!mdssitecheck(!!mdsVess)|, 'mdsVessels')
  !menu.add('CALLBACK', |Branch Reinforcements...|, |!!mdssitecheck(!!mdsBranRein)|, 'mdsBranchReinforcements')
  !menu.add('CALLBACK', |Preliminary Support...|, |!!mdssitecheck(!!mdsPrelimSupp)|, 'mdsPreliminarySupport')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Copy Support...|, |!!mdsCopySupp.show('At',0,0.07)|, 'mdsCopySupport')
--<wd>jun2007<mds12>
  !menu.add('CALLBACK', |MDS SCTN Association|, |!!mdsassociations()|, 'mdscreateidassociation')
--<wd>jun2007<mds12>
--<wd>19oct2006<mds12>
  !menu.add('CALLBACK', |Repeat MDS Ancillary Support|, |!!mdsrepeatanc()|, 'mdsrepeatidancillary')
  !menu.add('CALLBACK', |Repeat MDS Framework Support|, |!!mdsrepeatframe()|, 'mdsrepeatidframework')
--<wd>19oct2006<mds12>
  !!appMenuCntrl.addMenu(!menu, 'MDS')
endmethod

define method .modifyMenu()
  !menu = object APPMENU('sysMod')
  !menu.add('SEPARATOR')
  -- Removed this functionality because of the introduction of guides/stops to the ancillary form
  -- add |Ancillary Type...|      |Call !!mdsModAnc('Individual')|
  --<dw>feb2009 dun1081 - 'Associate Pad with Stop' added - P16049
  !menu.add('CALLBACK', |Drawing Comment...|, |Call !!kShowForm(!!mdsComm)|, 'mdsDrawingComment')
  !menu.add('CALLBACK', |Support...|, |!!mdsModifySupp.showform()|, 'mdsSupport')
  !menu.add('CALLBACK', |Support Name...|, |call !!mdsimodifyname('NAMEONLY')|, 'mdsSupportName')
  !menu.add('CALLBACK', |Align Guide to Support|, |call !!mdsalignguide()|, 'mdsAlignGuidetoSupport')
  !menu.add('CALLBACK', |Lock/Unlock Support...|, |!!mdsLockSupp.show('At',0,0.07)|, 'mdsLockUnlockSupport')
  !menu.add('CALLBACK', |Associate Pad with Shoe|, |call !!mdspadshoeref()|, 'mdsAssociatePadwithShoe')
  !menu.add('CALLBACK', |Associate Pad with Stop|, |call !!mdspadstopref()|, 'mdsAssociatePadwithStop')
  !menu.add('FORM',     |Snipe on Angle SCTN...|, 'MDSSNIPE', 'General')
  !menu.add('CALLBACK', |Convert Standard to a Special|, |!!mdsConvToSpec.init(!!ce)|, 'mdsConvertStandardtoaSpecial')
  !menu.add('CALLBACK', |Convert Support to Group|, |!!mdsconvertgroup('CONVERT' , !!ce ,'')|, 'mdsConvertSupporttoGroup')
  !!appMenuCntrl.addMenu(!menu, 'MDS')
endmethod

define method .deleteMenu()
  !menu = object APPMENU('sysDel')
  !menu.add('SEPARATOR')
  -- $*     ADD |Support...| FORM _JD.dELALL
  !menu.add('CALLBACK', |Support...|, |!!mdsDeleteSupp.show('At',0.25,0.07)|, 'MDS')
  !!appMenuCntrl.addMenu(!menu, 'MDS')
endmethod

define method .toolbars()
  frame .mdsToolbar toolbar 'Multi Discipline Supports Toolbar'
-- Build icon bar menu
    !iconSize = !!comSysOpt.iconSize()
    button .pix1  tooltip 'Multi Discipline Support' at xmax_syscla+2 ymin_mtbgetwork pixmap width $!iconSize height $!iconSize call |!!mdssitecheck(!!mdsFrame)|
    button .pix2  tooltip 'General' pixmap width $!iconSize height $!iconSize call |!!mdssitecheck(!!mdsGeneral)|
    button .pix3  tooltip 'Cable Support' pixmap width $!iconSize height $!iconSize call |!!mdssitecheck(!!mdsCable)|
   -- removed to reduce the application complexity
    button .pix4  tooltip 'HVAC Support' pixmap width $!iconSize height $!iconSize call |!!mdssitecheck(!!mdsHvac)|
    button .pix5  tooltip 'Anchor' pixmap width $!iconSize height $!iconSize call |!!mdssitecheck(!!mdsAnchor)|
    button .pix61  tooltip 'Fixed Hanger' pixmap width $!iconSize height $!iconSize call |!!mdsCreateHanger('FH')|
    button .pix62  tooltip 'Variable Hanger' pixmap width $!iconSize height $!iconSize call |!!mdsCreateHanger('VH')|
    -- button .pix63  tooltip 'Constant Hanger' pixmap width $!iconSize height $!iconSize call |!!alert.error('No constant hangers available at this release')|
    button .pix7  tooltip 'Guides and Stops' pixmap width $!iconSize height $!iconSize call |!!mdssitecheck(!!mdsGuide)|
    button .pix8  tooltip 'Slip Units' pixmap width $!iconSize height $!iconSize call |!!mdssitecheck(!!mdsSlip)|
    button .pix9  tooltip 'Specials' pixmap width $!iconSize height $!iconSize call |!!mdsiNameSpl()|
    button .pix10 tooltip 'Springs' pixmap width $!iconSize height $!iconSize call |!!mdssitecheck(!!mdsSpring)|
    if !iconSize neq 16 then
      button .pix11 tooltip 'Trunnions' at xmin.pix1 ymax.pix1 pixmap width $!iconSize height $!iconSize call |!!mdssitecheck(!!mdsTrunn)|
     else
      button .pix11 tooltip 'Trunnions' pixmap width $!iconSize height $!iconSize call |!!mdssitecheck(!!mdsTrunn)|
     endif
    button .pix12 tooltip 'Vessel Supports' pixmap width $!iconSize height $!iconSize call |!!mdssitecheck(!!mdsVess)|
    button .pix21 tooltip 'Branch Reinforcements' pixmap width $!iconSize height $!iconSize call |!!mdssitecheck(!!mdsBranRein)|
    button .pix22 tooltip 'Preliminary Support' pixmap width $!iconSize height $!iconSize call |!!mdssitecheck(!!mdsPrelimSupp)|
    button .pix23 tooltip 'Lighting Support' pixmap width $!iconSize height $!iconSize call |!!mdsls01.init('create')|
    button .pix13 tooltip 'Copy Support' pixmap width $!iconSize height $!iconSize call |!!mdsCopySupp.show('At',0,0.07)|
    button .pix14 tooltip 'Modify Support' pixmap width $!iconSize height $!iconSize call |!!mdsModifySupp.showform()|
    button .pix15 tooltip 'Delete Support' pixmap width $!iconSize height $!iconSize call |!!mdsDeleteSupp.show('At',0.25,0.07)|
    button .pix20 tooltip 'Lock/Unlock Support' pixmap width $!iconSize height $!iconSize call |!!mdsLockSupp.show('At',0,0.07)|
    button .pix16 tooltip 'Defaults' pixmap width $!iconSize height $!iconSize call |!!mdsOptions.show()|
    button .pix17 tooltip 'MDS Wizard' pixmap width $!iconSize height $!iconSize call |!!mdsWizard.show('AT',0,0)|
    --button .pix18 tooltip 'Reports' pixmap width $!iconSize height $!iconSize call |show !!mdsReport|
    button .pix18 tooltip 'Reports' pixmap width $!iconSize height $!iconSize call |!!mdsnewreports.init('initial')|
    --     button .pix19 tooltip 'Manuals' pixmap width $!iconSize height $!iconSize call |call !!mdsshowmanuals()|
    -- Development button for dac, turned off the release
    -- button .dac   'False' tooltip 'Dac Access = Green is TRUE, RED is FALSE' pixmap width $!iconSize height $!iconSize call '!!mdsDacControl(!!mdsAccess.boolean().not())'
    -- Set Pixmaps


    -- !!appDesMain = !!cDMDSAPP
    !!appDesMain.pix1.addPixmap(!!pml.getPathName('mds_' & !iconSize & '.png'))
    !!appDesMain.pix2.addPixmap(!!pml.getPathName('general_' & !iconSize & '.png'))
    !!appDesMain.pix3.addPixmap(!!pml.getPathName('cable_' & !iconSize & '.png'))
    !!appDesMain.pix4.addPixmap(!!pml.getPathName('hvac_' & !iconSize & '.png'))
    !!appDesMain.pix5.addPixmap(!!pml.getPathName('anchor_' & !iconSize & '.png'))
    !!appDesMain.pix61.addPixmap(!!pml.getPathName('fhang_' & !iconSize & '.png'))
    !!appDesMain.pix62.addPixmap(!!pml.getPathName('vhang_' & !iconSize & '.png'))
    -- !!appDesMain.pix63.addPixmap(!!pml.getPathName('chang_' & !iconSize & '.png'))
    !!appDesMain.pix7.addPixmap(!!pml.getPathName('slide_' & !iconSize & '.png'))
    !!appDesMain.pix8.addPixmap(!!pml.getPathName('slip_' & !iconSize & '.png'))
    !!appDesMain.pix9.addPixmap(!!pml.getPathName('special_' & !iconSize & '.png'))
    !!appDesMain.pix10.addPixmap(!!pml.getPathName('spring_' & !iconSize & '.png'))
    !!appDesMain.pix11.addPixmap(!!pml.getPathName('trun_' & !iconSize & '.png'))
    !!appDesMain.pix12.addPixmap(!!pml.getPathName('vess_' & !iconSize & '.png'))
    !!appDesMain.pix13.addPixmap(!!pml.getPathName('copy_' & !iconSize & '.png'))
    !!appDesMain.pix14.addPixmap(!!pml.getPathName('modify_' & !iconSize & '.png'))
    !!appDesMain.pix15.addPixmap(!!pml.getPathName('delete_' & !iconSize & '.png'))
    !!appDesMain.pix16.addPixmap(!!pml.getPathName('trim_' & !iconSize & '.png'))
    !!appDesMain.pix17.addPixmap(!!pml.getPathName('wizard_' & !iconSize & '.png'))
    !!appDesMain.pix18.addPixmap(!!pml.getPathName('report_' & !iconSize & '.png'))
    --!!appDesMain.pix19.addPixmap(!!pml.getPathName('pdf_' & !iconSize & '.png'))
    !!appDesMain.pix20.addPixmap(!!pml.getPathName('lock_' & !iconSize & '.png'))
    !!appDesMain.pix21.addPixmap(!!pml.getPathName('br_' & !iconSize & '.png'))
    !!appDesMain.pix22.addPixmap(!!pml.getPathName('prelim_' & !iconSize & '.png'))
    !!appDesMain.pix23.addPixmap(!!pml.getPathName('lightsupp' & !iconSize & '.png'))
  --> Activate Hanger icon <ab> 08.03.02
  --  !!appDesMain.pix6.active = false
    !!appDesMain.pix61.active = TRUE
    !!appDesMain.pix62.active = TRUE
  --  !!appDesMain.pix10.active = false
    !!appDesMain.pix10.active = TRUE

  --< Activate Hanger icon <ab> 08.03.02
  exit
  !!appTbarCntrl.addToolbar('mdsToolbar', 'MDS')

  -- menu for add/remove support for drawlist - MDSSIE04
  frame .mdsAddRemoveToolbar toolbar 'MDS Add/Remove Toolbar'
    !iconSize = !!comSysOpt.iconSize()

    button .pixAdd tooltip 'Add Supports' at xmax_syscla+2 ymin_mtbgetwork pixmap width $!iconSize height $!iconSize call |!!mdsAddRemSupp('add')|
    button .pixRem tooltip 'Remove Supports' pixmap width $!iconSize height $!iconSize call |!!mdsAddRemSupp('remove')|
    button .pixAddRef tooltip 'Add Reference Supports' pixmap width $!iconSize height $!iconSize call |!!mdsAddRemSupp('addref')|
    button .pixRemRef tooltip 'Remove Reference Supports' pixmap width $!iconSize height $!iconSize call |!!mdsAddRemSupp('removeref')|

    !!appDesMain.pixAdd.addPixmap(!!pml.getPathName('addce.png'))
    !!appDesMain.pixRem.addPixmap(!!pml.getPathName('remce.png'))
    !!appDesMain.pixAddRef.addPixmap(!!pml.getPathName('addceref.png'))
    !!appDesMain.pixRemRef.addPixmap(!!pml.getPathName('remceref.png'))
  exit
  !!appTbarCntrl.addToolbar('mdsAddRemoveToolbar', 'ALL', true)
endmethod

define method .menus()
  !menu = object APPMENU('ANCILL')
  !menu.add('CALLBACK', |Anchors...|, |!!mdssitecheck(!!mdsAnchor)|, 'mdsAnchors')
  !menu.add('CALLBACK', |General...|, |!!mdssitecheck(!!mdsGeneral)|, 'mdsGeneral')
  !menu.add('CALLBACK', |Guides and Stops...|, |!!mdssitecheck(!!mdsGuide)|, 'mdsGuidesandStops')
  --       $* add |Shoes on Slip Units ...|!!mdssitecheck(!!mdsSlip)|
  !!appMenuCntrl.addMenu(!menu, 'MDS')

  !menu = object APPMENU('FRAME')
  !menu.add('CALLBACK', |Cable Rack...|, |!!mdssitecheck(!!mdsCable)|, 'mdsCableRack')
  !menu.add('CALLBACK', |HVAC...|, |!!mdssitecheck(!!mdsHvac)|, 'mdsHVAC')
  !menu.add('CALLBACK', |Multi Discipline...|, |!!mdssitecheck(!!mdsFrame)|, 'mdsMultiDiscipline')
  !menu.add('CALLBACK', |Vessels...|, |!!mdssitecheck(!!mdsVess)|, 'mdsVessels')
  !!appMenuCntrl.addMenu(!menu, 'MDS')

  !menu = object APPMENU('HANGER')
  !menu.add('CALLBACK', |Fixed Hanger...|, |!!mdssitecheck(!!mdsFHanger)|, 'mdsFixedHanger')
  !menu.add('CALLBACK', |Variable Hanger...|, |!!mdssitecheck(!!mdsVHanger)|, 'mdsVariableHanger')
  -- !menu.add('CALLBACK', |Constant Hanger...|, |!!alert.error('No constant hangers available at this release')|, 'ConstantHanger')
  !!appMenuCntrl.addMenu(!menu, 'MDS')

  --<GE> 25/01/07 Fix for Software Defect: 10165
  -- !menu = object APPMENU('CONN')
        -- add |Branch...|    FORM _CDCONNBR
        -- add |Component...| FORM _CDCONN
  -- !!appMenuCntrl.addMenu(!menu, 'MDS')
  --<GE> 25/01/07

  !menu = object APPMENU('POSITION')
  !menu.add('CALLBACK', |Explicitly (AT)...|, |!!pos3DExplicit()|, 'Explicitly(AT)')
  !menu.add('CALLBACK', |Relatively (BY)...|, |CALLIBD X3DPOSR|, 'Relatively(BY)')
  --      add |At...|        |CALLIBD  X3DPOS|
  --      add |By...|        |CALLIB UFORMS POSI _CD3DPOSR|
  !menu.add('MENU', |Move|, 'MOVE', 'Move')
  !menu.add('MENU', |Drag|, 'DRAG', 'Drag')
  !menu.add('MENU', |Plane Move|, 'PLMOVE', 'PlaneMove')
  !menu.add('SEPARATOR')
        -- add |Branch|     menu _BRANPOS
        -- add |Component|  menu _COMPPOS
  !!appMenuCntrl.addMenu(!menu, 'MDS')

  !menu = object APPMENU('MOVE')
  !menu.add('FORM', |Distance...|, 'CDMOVEDIS', 'Distance')
  !menu.add('FORM', |Through...|, 'CDMOVETHR', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDMOVECLE', 'Clearance')
  !menu.add('FORM', |Towards...|, 'CDMOVETO', 'Towards')
  !!appMenuCntrl.addMenu(!menu, 'MDS')

  !menu = object APPMENU('DRAG')
  !menu.add('FORM', |Distance...|, 'CDDRAGDIS', 'Distance')
  !menu.add('FORM', |Through...|, 'CDDRAGTHR', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDDRAGCLE', 'Clearance')
  !!appMenuCntrl.addMenu(!menu, 'MDS')

  !menu = object APPMENU('PLMOVE')
  !menu.add('FORM', |Distance...|, 'CDMOPLDIS', 'Distance')
  !menu.add('FORM', |Through...|, 'CDMOPLTHR', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDMOPLCLE', 'Clearance')
  !!appMenuCntrl.addMenu(!menu, 'MDS')

  !menu = object APPMENU('BRANPOS')
  !menu.add('FORM', |General...|, 'CDBRATG', 'General')
  !menu.add('FORM', |Distance...|, 'CDBRPOSDI', 'Distance')
  !menu.add('FORM', |Through...|, 'CDBRPOSTH', 'Through')
  !menu.add('MENU', |Move|, 'BRMOVE', 'Move')
  !menu.add('MENU', |Drag|, 'BRDRAG', 'Drag')
  !!appMenuCntrl.addMenu(!menu, 'MDS')

  !menu = object APPMENU('BRMOVE')
  !menu.add('FORM', |Distance...|, 'CDBRMOVDI', 'Distance')
  !menu.add('FORM', |Through...|, 'CDBRMOVTH', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDBRMOVCL', 'Clearance')
  !!appMenuCntrl.addMenu(!menu, 'MDS')

  !menu = object APPMENU('BRDRAG')
  !menu.add('FORM', |Distance...|, 'CDBRDRADI', 'Distance')
  !menu.add('FORM', |Through...|, 'CDBRDRATH', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDBRDRACL', 'Clearance')
  !!appMenuCntrl.addMenu(!menu, 'MDS')

  !menu = object APPMENU('COMPPOS')
  !menu.add('FORM', |Distance...|, 'CDDIST', 'Distance')
  !menu.add('FORM', |Through...|, 'CDTHRO', 'Through')
  !menu.add('FORM', |Clearance...|, 'CDCLEA', 'Clearance')
  !menu.add('FORM', |BoP/ToP...|, 'CDBOP', 'BoPToP')
  !menu.add('FORM', |Plane Through...|, 'CDPLANE', 'PlaneThrough')
  !menu.add('FORM', |Plane Clearance...|, 'CDPLANECL', 'PlaneClearance')
  !menu.add('FORM', |Drag BoP/ToP...|, 'CDDRAGBOP', 'DragBoPToP')
  !!appMenuCntrl.addMenu(!menu, 'MDS')

  !menu = object APPMENU('ORI')
  !menu.add('CALLBACK', |Axes...|, |call !!oriElement(!!ce)|, 'Axes')
  !menu.add('CALLBACK', |Rotate...|, |CALLIB UFORMS ORI _CDROTAT|, 'Rotate')
  !!appMenuCntrl.addMenu(!menu, 'MDS')

  !menu = object APPMENU('BPREF')
  !menu.add('CALLBACK', |To Structure...|, |CALLMDS IMODBPREF|, 'ToStructure')
  !menu.add('CALLBACK', |To Attachment|, |CALLMDS MSETBPA|, 'ToAttachment')
  !!appMenuCntrl.addMenu(!menu, 'MDS')

  !menu = object APPMENU('ADDSUPP')
  !menu.add('CALLBACK', |Explicit...|, |Call !!kShowForm(!!mdsAddSupp)|, 'mdsExplicit')
  !menu.add('CALLBACK', |All below CE|, |Call !!mdsAddAllSupp('CE')|, 'mdsAllbelowCE')
  !menu.add('CALLBACK', |All|, |Call !!mdsAddAllSupp('ALL')|, 'mdsAll')
  !!appMenuCntrl.addMenu(!menu, 'MDS')

  !menu = object APPMENU('DEFAULTS')
  !menu.add('FORM', |Application...|, 'MdsOptions', 'mdsApplication')
