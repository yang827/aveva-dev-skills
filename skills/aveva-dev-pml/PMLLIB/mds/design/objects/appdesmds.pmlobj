  !menu = object APPMENU('MDSWELDS')
  !menu.add('FORM', |Standard Welds...|, 'mdsSTDWElds', 'mdsStandardWelds')
  !menu.add('FORM', |frame Template Welds...|, 'mdsframewelds', 'mdsFrameTemplateWelds')
