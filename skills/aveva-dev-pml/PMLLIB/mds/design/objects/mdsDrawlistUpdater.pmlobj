------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addAllSupportBelow(DBREF)        -
--  addToDrawlist(ARRAY,BOOLEAN)     -
--  getConnectedElements (DBREF)     ARRAY
--  getConnectedToAtta (DBREF)       ARRAY
--  getConnectedToSctn(DBREF)        ARRAY
--  getParent(DBREF)                 DBREF
--  getParents(ARRAY)                ARRAY
--  getRefConnectedElements (DBREF)  ARRAY
--  getRefConnectedToAtta (DBREF)    ARRAY
--  getSctnRefs (DBREF)              ARRAY
--  getStru(DBREF,BOOLEAN)           ARRAY               Return STRU,
--  mdsDrawlistUpdater()             -
--  removeFromDrawlist(ARRAY,BOOLEAN) -
--  update()                         -
--
define object MDSDRAWLISTUPDATER

  member .oldList is ARRAY

endobject

define method .mdsDrawlistUpdater()

  !this.oldList = !!gphDrawlists.drawlists[1].members()
  handle ANY
    !this.oldList = ARRAY()
  endhandle

endmethod

define method .update()

  !ce = !!ce

  !list = !!gphDrawlists.drawlists[1].members()
  !delta = !list.size() - !this.oldList.size()

  if (!delta gt 0) then
    --    $p ADD
    !this.addToDrawlist(!list.difference(!this.oldList))
  elseif (!delta lt 0) then
    --    $p REM
    !this.removeFromDrawlist(!this.oldList.difference(!list))
  endif

  !this.oldList = !!gphDrawlists.drawlists[1].members()

  !!ce = !ce

endmethod

define method .addToDrawlist(!addedElements is ARRAY, !isReference is BOOLEAN)

  -- We shouldn't be able to add supports at a world level
  if (!addedElements.size().eq(1) AND !addedElements.first().owner.badRef()) then
    !!alert.error('Cannot add supports at this level.')
    return
  endif

  !list = ARRAY()

  do !element values !addedElements
    if (!element.type.eq('ATTA')) then
      if (!isReference) then
        !connected = !this.getRefConnectedToAtta(!element)
      else
        !connected = !this.getConnectedToAtta(!element)
      endif
      !list.appendArray(!connected)
      !idx = !addedElements.findfirst(!element)
      if (!idx.set()) then
        !addedElements.remove(!idx)
      endif
    elseif (!element.owner.type.eq('BRAN') and !element.type.neq('ATTA')) then
      !idx = !addedElements.findfirst(!element)
      if (!idx.set()) then
        !addedElements.remove(!idx)
      endif
    endif
  enddo

  !skipBranch = false
  if (!addedElements.empty().not() and (!addedElements[1].type eq 'ATTA' or !addedElements[1].type eq 'BRAN' or !addedElements[1].type eq 'PIPE' or !addedElements[1].type eq 'ZONE' and !addedElements[1].purp eq 'PIPE' or !addedElements[1].type eq 'SITE' and !addedElements[1].purp eq 'PIPE')) then
    !skipBranch = true
  endif

  !mainElements = !this.getParents(!addedElements)
  do !main values !mainElements
    if (!isReference) then
      !elements = !this.getRefConnectedElements(!main)
    else
      !elements = !this.getConnectedElements(!main)
    endif
    do !elem values !elements
      skip if badref(!elem)
      if (!skipBranch.not()) then
        if (!elem.type eq 'ATTA') then
          !list.append(!elem.owner)
        else
          !list.append(!elem)
        endif
      else
        if (!elem.type eq 'ATTA' and !isReference) then
          !list.append(!elem)
        endif
        if (!elem.type neq 'ATTA' and !elem.type neq 'BRAN') then
          !list.append(!elem)
        endif
      endif
    enddo
  enddo

  !list.unique()
  --remove associated items
  do !item values !list
    if !item.type.eq('ATTA') or !item.type.eq('BRAN') then
      add only $!item
    else
      add $!item
    endif
  enddo

endmethod

define method .removeFromDrawlist(!removedElements is ARRAY, !isReference is BOOLEAN)

  -- We shouldn't be able to remove supports at a world level
  if (!removedElements.size().eq(1) AND !removedElements.first().owner.badRef()) then
    !!alert.error('Cannot remove supports at this level.')
    return
  endif

  !list = ARRAY()

  -- if it is reference case and there was SCTN selected then check only :mdsattaref without adding parents

  do !element values !removedElements
    if (!element.type.eq('ATTA')) then
      if (!isReference) then
        !connected = !this.getRefConnectedToAtta(!element)
      else
        !connected = !this.getConnectedToAtta(!element)
      endif
      !list.appendArray(!connected)
      !idx = !removedElements.findfirst(!element)
      if (!idx.set()) then
        !removedElements.remove(!idx)
      endif
    elseif (!element.owner.type.eq('BRAN') and !element.type.neq('ATTA')) then
      !idx = !removedElements.findfirst(!element)
      if (!idx.set()) then
        !removedElements.remove(!idx)
      endif
    endif
  enddo

  !skipBranch = false
  if (!removedElements.empty().not() and (!removedElements[1].type eq 'BRAN' or !removedElements[1].type eq 'ATTA' or !removedElements[1].type eq 'PIPE' or !removedElements[1].type eq 'ZONE' and !removedElements[1].purp eq 'PIPE' or !removedElements[1].type eq 'SITE' and !removedElements[1].purp eq 'PIPE')) then
    !skipBranch = true
  endif

  !mainElements = !this.getParents(!removedElements)

  do !main values !mainElements
    if (!isReference) then
      !elements = !this.getRefConnectedElements(!main)
    else
      !elements = !this.getConnectedElements(!main)
    endif
    do !elem values !elements
      skip if badref(!elem)

      !purpose = !elem.purp
      handle any
        !purpose = ''
      endhandle

      if (!skipBranch.not()) then
        if (!elem.type eq 'ATTA') then
          !list.append(!elem.owner)
        else
          !list.append(!elem)
        endif
      else
        if (!elem.type eq 'ATTA' and !isReference) then
          !list.append(!elem)
        endif
        if (!elem.type neq 'ATTA' and !elem.type neq 'BRAN') then
          !list.append(!elem)
        endif
      endif

    enddo
  enddo

  !list.unique()
  --remove associated items
  do !item values !list
    if !item.type.eq('ATTA') or !item.type.eq('BRAN') then
      remove only $!item
    else
      remove $!item
    endif
  enddo


endmethod

define method .getParent(!elem is DBREF) is DBREF

  !ce = !!ce
  !!ce = !elem

  -- check if CE is below REST, PIPE or STRU
  !main = REST
  handle NONE
    !!ce = !ce
    return !main
  elsehandle ANY
  endhandle

  !main = PIPE
  handle NONE
    -- we are below PIPE but can be BRAN
    !main = BRAN
    handle ANY
    endhandle
    !!ce = !ce
    return !main
  elsehandle ANY
  endhandle

  -- try to find STRU above
  !main = STRU
  handle NONE
    !!ce = !ce
    return !main
  elsehandle ANY
  endhandle

$( SNOD not supported
  if ((!elem.type EQ 'SNOD') and (!elem.isnamed)) then
    if (!!mdsIsNodeSupp(!elem)) then
      !sjoi = !!kCollectAllFor('SJOI','',!elem)
      do !sj values !sjoi
        if(!sj.cref.neq(nulref)) then
          !!ce = !sj.cref
          break
        endif
      enddo
    endif
  endif
$)

  if(!elem.type.eq('SJOI')) then
    !!ce = !elem.cref
    handle ANY
    elsehandle NONE
      !main = STRU
      handle NONE
        !!ce = !ce
        return !main
      elsehandle ANY
      endhandle
    endhandle
  endif

  return object DBREF()

endmethod

define method .getParents(!list is ARRAY) is ARRAY

  !ce = !!ce

  !result = ARRAY()

  do !elem values !list

    !!ce = !elem

    -- check if CE is below REST, PIPE or STRU
    !main = REST
    handle NONE
      !result.append(!main)
      skip
    elsehandle ANY
    endhandle

    !main = PIPE
    handle NONE
      -- we are below PIPE but can be BRAN
      !main = BRAN
      handle NONE
        -- add BRAN to result
        !result.append(!main)
      elsehandle ANY
        -- search for REST
        !main = REST
        handle NONE
          -- add REST to result
          !result.append(!main)
        elsehandle ANY
          -- probably we are on PIPE
          !result.appendArray(!!mdsCollectAll('BRAN', '', !elem))
          !result.appendArray(!!mdsCollectAll('REST', 'purp eq |MDS|', !elem))
        endhandle
      endhandle
      -- below PIPE always continue with next element
      skip
    elsehandle ANY
    endhandle

    -- try to find STRU above
    !main = STRU
    handle NONE
      if (!main.:MDSSuppType neq ||) then
        !result.append(!main)
      endif
      skip
    elsehandle ANY
    endhandle

    -- test any other item type - just collect all STRU, BRAN and REST below
    !unusedtmp = SITE
    handle ANY
      -- do not collect STRU and PIPE on world
    elsehandle NONE
      -- collect STRU and PIPE below !elem from !list
      !result.appendArray(!!mdsCollectAll('STRU', ':MDSSuppType neq ||', !elem))
      !result.appendArray(!!mdsCollectAll('BRAN', '', !elem))
      !result.appendArray(!!mdsCollectAll('REST', 'purp eq |MDS|', !elem))
    endhandle

  enddo

  !result.unique()
  !!ce = !ce


  return !result

endmethod

define method .getConnectedElements (!main is DBREF) is ARRAY

  !list = ARRAY()
  !type = !main.type


  if !type.eq('BRAN') then
    --add only branches without pipes
    !attas = !!mdsCollectAll('ATTA','',!main)

    do !atta values !attas
      skip if !atta.spre.badref()
      skip if ( !atta.spown.name.neq('/MDS') and !atta.spown.name.neq('/MDP') )
      skip if !atta.name.match('/SREF').gt(0)

      !list.appendArray(!this.getConnectedToAtta(!atta))
      !list.append(!atta)

    enddo
  elseif (!type.eq('REST') and !main.isnamed) then
    if (!main.name.matchwild('*/REST')) then
      !hangers = !!mdsCollectAll('HANG','',!main)
      do !hang values !hangers
        if (set(!hang.href) and not badref(!hang.href)) then
          !list.append(!hang.href)
        endif
        if (set(!hang.tref) and not badref(!hang.tref)) then
          !list.append(!hang.tref.owner)
        endif
        if (!hang.dassci.set() and !hang.dassci.empty().not()) then
          !list.appendArray(!hang.dassci)
        endif
      enddo
      if (!list.size() gt 0) then
        !list.append(!main)
      endif
    endif
  elseif (!type.eq('STRU')) then
    !list.appendArray(!this.getStru(!main, true))
  else
    -- this should never execute
    !list.append(!main)
  endif
  return !list

endmethod


define method .getConnectedToAtta (!atta is DBREF) is ARRAY

  !list = ARRAY()

  if !atta.cref.badref().not() then
    -- add to list reference to hanger owner (REST)
    !list.append(!atta.cref.owne)
  endif
  if !atta.name.match('/DATUM').gt(0) then
    -- search for owner stru of DATUM
    !stru = object DBREF(!atta.name.before('/DATUM'))
    handle any
      -- STRU of reference atta unknown
      !stru = object DBREF()
    endhandle
  else
    -- search for owner stru of reference atta
    !stru = object DBREF(!atta.name.part(1, '.'))
    handle any
      -- STRU of reference atta unknown
      !stru = object DBREF()
    endhandle
  endif

  !list.appendArray(!this.getStru(!stru, true))
  handle ANY
  endhandle

  !idx = !list.findfirst(!atta)
  if (!idx.set()) then
    !list.remove(!idx)
  endif

  return !list

endmethod


define method .getRefConnectedElements (!main is DBREF) is ARRAY

  !list = ARRAY()
  !type = !main.type

  if !type.eq('BRAN') then
    !attas = !!mdsCollectAll('ATTA','',!main)
    do !atta values !attas
      skip if !atta.spre.badref()
      skip if ( !atta.spown.name.neq('/MDS') and !atta.spown.name.neq('/MDP') and !atta.spown.name.neq('/MDF') )

      !list.appendArray(!this.getRefConnectedToAtta(!atta))
      handle ANY
      endhandle
    enddo
    do !atta values !attas
      !idx = !list.findfirst(!atta)
      if (!idx.set()) then
        !list.remove(!idx)
      endif
    enddo
  elseif (!type.eq('REST') and !main.isnamed) then
    if (!main.name.matchwild('*/REST')) then
      !hangers = !!mdsCollectAll('HANG','',!main)
      do !hang values !hangers
        if (set(!hang.href) and not badref(!hang.href)) then
          !list.append(!hang.href)
        endif
        if (set(!hang.tref) and not badref(!hang.tref)) then
          !list.append(!hang.tref.owner)
        endif
        if (!hang.dassci.set() and !hang.dassci.empty().not()) then
          !list.appendArray(!hang.dassci)
        endif
      enddo
      if (!list.size() gt 0) then
        !list.append(!main)
      endif
    endif
  elseif !type.eq('STRU') then
    !struSctns = !!mdsCollectAll('SCTN','',!main)
    do !sctn values !struSctns
      !list.appendArray(!this.getSctnRefs(!sctn))
    enddo

    !list.appendArray(!main.dassci)
    !srefAtta = object DBREF(!main.name & '/SREF')
    handle any
    elsehandle none
      !list.append(!srefAtta)
    endhandle
    !datumAtta = object DBREF(!main.name & '/DATUM')
    handle any
    elsehandle none
      !list.append(!datumAtta)
    endhandle
  else
    -- this should never execute
    !list.append(!main)
  endif

  return !list

endmethod


define method .getRefConnectedToAtta (!atta is DBREF) is ARRAY

  !list = ARRAY()

  if (!atta.cref.badref().not() and !atta.cref.type.eq('HANG')) then
    -- add to list reference to hanger owner (REST)
    !list.append(!atta.cref.owne)
    if (set(!atta.cref.tref) and not badref(!atta.cref.tref)) then
      !list.append(!atta.cref.tref.owner)
    endif
    if (!atta.cref.dassci.set() and !atta.cref.dassci.empty().not()) then
      !list.appendArray(!atta.cref.dassci)
    endif
  endif

  if !atta.dassci.empty().not() then
    -- search for owner stru of DATUM
    !stru = !atta.dassci[1]
    handle any
      !stru = object DBREF()
    endhandle
  elseif !atta.name.match('/DATUM').gt(0) then
    -- search for owner stru of DATUM
    !stru = object DBREF(!atta.name.before('/DATUM'))
    handle any
      -- STRU of reference atta unknown
      !stru = object DBREF()
    endhandle
    !srefAtta = object DBREF(!atta.name.before('/DATUM') & '/SREF')
    handle any
      -- STRU of reference atta unknown
      !srefAtta = object DBREF()
    elsehandle none
      !list.append(!srefAtta)
    endhandle
  elseif !atta.name.match('/SREF').gt(0) then
    -- search for owner stru of DATUM
    !stru = object DBREF(!atta.name.before('/SREF'))
    handle any
      -- STRU of reference atta unknown
      !stru = object DBREF()
    endhandle
    !datumAtta = object DBREF(!atta.name.before('/SREF') & '/DATUM')
    handle any
      -- STRU of reference atta unknown
      !datumAtta = object DBREF()
    elsehandle none
      !list.append(!datumAtta)
    endhandle
  else
    -- search for owner stru of reference atta
    !stru = object DBREF(!atta.name.part(1, '.'))
    handle any
      -- STRU of reference atta unknown
      !stru = object DBREF()
    endhandle
  endif

  if (!stru.:MDSSuppType neq '') then
    !list.append(!stru)
    !list.appendArray(!stru.dassci)

    !sctns = !!mdsCollectAll('SCTN', '', !stru)
    do !sctn values !sctns
      !list.appendArray(!sctn.:MDSAttaRef)
    enddo

    !srefAtta = object DBREF(!stru.name & '/SREF')
    handle any
    elsehandle none
      !list.append(!srefAtta)
    endhandle
    !datumAtta = object DBREF(!stru.name & '/DATUM')
    handle any
    elsehandle none
      !list.append(!datumAtta)
    endhandle
  endif

  !list = !list.unique()
  !idx = !list.findfirst(!atta)
  if (!idx.set()) then
    !list.remove(!idx)
  endif

  return !list

endmethod


define method .getSctnRefs (!element is DBREF) is ARRAY

  !list = ARRAY()
  do !atta values !element.:mdsattaref
    !list.append(!atta.owner)
  enddo
  do !member values !element.members
    !cref = !member.cref
    handle any
    elsehandle none
      if (!cref.set() and !cref.badref().not())  then
        if (!cref.type eq 'HANG')  then
          !list.append(!cref)
        endif
      endif
    endhandle
  enddo
  !list.appendArray(!element.dassci)

  return !list

endmethod

------------------------------------------------------------------------
--
-- Method:      getStru
--
-- Description: Return STRU,
--              all attas and hangers connected to SCTNs of this STRU (by :mdsAttaRef)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type]       [Description]
--    ARRAY of DBREF   Element references
------------------------------------------------------------------------
--

define method .getStru(!stru is DBREF, !addAttaAndHang is BOOLEAN) is ARRAY

  if (unset(!stru) or badref(!stru) or (!stru.:MDSSuppType eq '')) then
    return ARRAY()
  endif

  !isSupport = FALSE
  !sVal = !!mdsIdSVal.split(',')
  do !testForSupport values !sVal
    if (!stru.owner.$!!mdsIdSatt eq |$!testForSupport|)then
      !isSupport = TRUE
    endif
  enddo
  if (not !isSupport) then
    return ARRAY()
  endif

  !result[1] = !stru

  !sctns = !!mdsCollectAll('SCTN', '', !stru)

  if (!addAttaAndHang) then
    do !sctn values !sctns
      !result.appendArray(!this.getConnectedToSctn(!sctn))
    enddo
  endif

  !srefAtta = object DBREF(!stru.name & '/SREF')
  handle any
  elsehandle none
    !result.append(!srefAtta)
  endhandle
  !datumAtta = object DBREF(!stru.name & '/DATUM')
  handle any
  elsehandle none
    !result.append(!datumAtta)
  endhandle

  return !result

endmethod

define method .getConnectedToSctn(!sctn is DBREF) is ARRAY
  !result = ARRAY()

  -- add attas
  if (!sctn.:mdsAttaRef.set()) then
    do !atta values !sctn.:mdsAttaRef
      skip if (!atta.dassci.set() and !atta.dassci.empty().not())
      !result.append(!atta)
    enddo
  endif

  -- add hangers
  do !member values !sctn.members
    if (!member.type eq 'FITT' and !member.cref.set() and !member.badref().not()) then
      if(!member.cref.type eq 'HANG') then
        !result.append(!member.cref.owner)
      endif
    endif
  enddo

  return !result
endmethod


define method .addAllSupportBelow(!elem is DBREF)

  !list = !!mdsCollectAll('STRU', ':MDSSuppType neq ||', !elem)
  !list.appendArray(!!mdsCollectAll('REST', 'purp eq |MDS|', !elem))

  --!list.appendArray(!!mdsCollectAll('REST', 'purp eq |MDS|', !elem))

  do !supp values !list
    do !item values !this.getConnectedElements(!supp)
      add $!item
      handle ANY
      endhandle
    enddo

  enddo

endmethod
