--
--  File:            mdsGetSupportElements.pmlobj
--  Author:          Richard Martin
--  Created:         28 October 2015
--
--  Description:  <object that attempts to find all likely named elements of a support so that we can cut down the time taken in collections for big projects>
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  convertToStringArray(ARRAY)      ARRAY               <convert an array of DBREF to STRING>
--  filterElements(STRING)           -                   <filter the foundelements array against the supplied filter list so that we only return the required elements>
--  getAllElements()                 -                   <attempt to find all similarly named items from the supplied support name>
--  getDatum()                       -                   <get the datum atta>
--  getElement(STRING)               -                   <try to build a name from this.supportName and the supplied key word>
--  getExternalJoints()              -                   <get joints associated with structural elements>
--  getHanger()                      -                   <get hanger elements>
--  getHangerFittings()              -                   <get hanger fittings>
--  getMakeup()                      -                   <get the trunnion makeup reducer>
--  getNote()                        -                   <get the trunnion note attas>
--  getRest()                        -                   <get the hanger rest>
--  getSref()                        -                   <get the sref atta>
--  getSupportElements(BOOLEAN)      ARRAY               <get the support elements for the supplied name>
--  getSupportElements(BOOLEAN,STRING) ARRAY               <get the support elements for the supplied name>
--  getSupportElements(BOOLEAN,STRING,STRING) ARRAY               <get the support elements for the supplied name>
--  getTrunnionBranch()              -                   <loop through the found members array and find all owning branch members that are set :MDSTrun true>
--  mdsGetSupportElements(STRING)    -                   <constructor>
--
define object MDSGETSUPPORTELEMENTS

  member .foundElements is ARRAY
  member .supportName is STRING

  --member to allow us to search only for items in the scope of the passed support name
  --if the support name is something like /PS1[1] then if .allGroupElements is FALSE we will only search using the name /PS1[1]
  --if .allGroupElements is true we will search using the scope /PS1 and additional [n] based searches will be run such that we will be able to find
  --the items /PS1[1] and /PS1[2] in the same search
  member .allGroupElements is BOOLEAN

endobject

----------------------------------------------------------------------
--
-- Method:      mdsGetSupportElements
--
-- Description: <constructor>
--
----------------------------------------------------------------------
define method .mdsGetSupportElements(!supportName is STRING)

  !this.supportName = !supportName

endmethod

----------------------------------------------------------------------
--
-- Method:      getSupportElements
--
-- Description: <get the support elements for the supplied name>
--
----------------------------------------------------------------------
define method .getSupportElements(!allGroupElements is BOOLEAN) is ARRAY

  --set the allGroupElements option
  !this.allGroupElements = !allGroupElements

  --get all elements based upon the supplied support name and support naming conventions
  !this.getAllElements()

  return !this.foundElements

endmethod

----------------------------------------------------------------------
--
-- Method:      getSupportElements
--
-- Description: <get the support elements for the supplied name>
--
----------------------------------------------------------------------
define method .getSupportElements(!allGroupElements is BOOLEAN, !filter is STRING) is ARRAY

  --set the allGroupElements option
  !this.allGroupElements = !allGroupElements

  --get all elements based upon the supplied support name and support naming conventions
  !this.getAllElements()

  --filter against the supplied list of elements so that we only return elements of that type
  !this.filterElements(!filter)

  return !this.foundElements

endmethod

----------------------------------------------------------------------
--
-- Method:      getSupportElements
--
-- Description: <get the support elements for the supplied name>
--
----------------------------------------------------------------------
define method .getSupportElements(!allGroupElements is BOOLEAN, !filter is STRING, !returnType is STRING) is ARRAY

  --set the allGroupElements option
  !this.allGroupElements = !allGroupElements

  --get all elements based upon the supplied support name and support naming conventions
  !this.getAllElements()

  --filter against the supplied list of elements so that we only return elements of that type
  !this.filterElements(!filter)

  if (!returnType.eq('STRING')) then
    return !this.convertToStringArray(!this.foundElements)
  else
    return !this.foundElements
  endif

endmethod

----------------------------------------------------------------------
--
-- Method:      getSupportElements
--
-- Description: <get the support elements for the supplied name>
--
----------------------------------------------------------------------
define method .getSupportElements(!allGroupElements is BOOLEAN, !filter is STRING) is ARRAY

  --set the allGroupElements option
  !this.allGroupElements = !allGroupElements

  --get all elements based upon the supplied support name and support naming conventions
  !this.getAllElements()

  --filter against the supplied list of elements so that we only return elements of that type
  !this.filterElements(!filter)

  return !this.foundElements

endmethod


----------------------------------------------------------------------
--
-- Method:      getAllElements
--
-- Description: <attempt to find all similarly named items from the supplied support name>
--
----------------------------------------------------------------------
define method .getAllElements()

  --first get the supportName element, if we pass an empty string the initial supplied support name will be evaluated
  !this.getElement('')

  --now get named elements associated with the support name
  !this.getDatum()
  !this.getSref()
  !this.getNote()
  !this.getMakeup()
  !this.getRest()
  !this.getHanger()
  !this.getExternalJoints()
  !this.getHangerFittings()
  !this.getTrunnionBranch()

  !this.foundElements = !this.foundElements.unique()

endmethod

----------------------------------------------------------------------
--
-- Method:      getDatum
--
-- Description: <get the datum atta>
--
----------------------------------------------------------------------
define method .getDatum()

  !this.getElement('/DATUM')

endmethod

----------------------------------------------------------------------
--
-- Method:      getSref
--
-- Description: <get the sref atta>
--
----------------------------------------------------------------------
define method .getSref()

  !this.getElement('/SREF')

endmethod

----------------------------------------------------------------------
--
-- Method:      getNote
--
-- Description: <get the trunnion note attas>
--
----------------------------------------------------------------------
define method .getNote()

  do !i from 1 to 10
    !this.getElement('/NOTE' + !i.string())
  enddo

endmethod

----------------------------------------------------------------------
--
-- Method:      getMakeup
--
-- Description: <get the trunnion makeup reducer>
--
----------------------------------------------------------------------
define method .getMakeup()

  !this.getElement('/MAKEUP')

endmethod

----------------------------------------------------------------------
--
-- Method:      getRest
--
-- Description: <get the hanger rest>
--
----------------------------------------------------------------------
define method .getRest()

  !this.getElement('/REST')

endmethod

----------------------------------------------------------------------
--
-- Method:      getHanger
--
-- Description: <get hanger elements>
--
----------------------------------------------------------------------
define method .getHanger()

  --loop 100 times to find all hanger elements associated with this support
  do !i from 1 to 10
    !this.getElement('/H' + !i.string())
  enddo

endmethod

----------------------------------------------------------------------
--
-- Method:      getExternalJoints
--
-- Description: <get joints associated with structural elements>
--
----------------------------------------------------------------------
define method .getExternalJoints()

  --first find any STRU's
  !elementList = !this.foundElements.unique()
  !struArray = object ARRAY()
  do !element values !elementList
    if (!element.type.eq('STRU')) then
      !struArray.append(!element)
    endif
  enddo

  !sctnArray = object ARRAY()
  do !stru values !struArray
    var !sctnArray coll all SCTN for $!stru
  enddo

  --store the supportName temporarily so that we can insert the SCTN name and check for joint names /J[n]
  !supportName = !this.supportName
  do !sctn values !sctnArray

    --temporarily set the support name as the SCTN name so that we can append /J[n] to it to find our external joints
    !this.supportName = !sctn.dbref().name

    --loop 10 times to find all joint elements associated with this support
    do !i from 1 to 10
      !this.getElement('/J' + !i.string())
    enddo
  enddo
  --restore the support name
  !this.supportName = !supportName

endmethod

----------------------------------------------------------------------
--
-- Method:      getHangerFittings
--
-- Description: <get hanger fittings>
--
----------------------------------------------------------------------
define method .getHangerFittings()

  --get compound fitting under a floor or pane
  !this.getElement('CMPF')

  --loop 10 times to find all hanger elements associated with this support
  do !i from 1 to 10
    !this.getElement('/SBFI/H' + !i.string())
  enddo

  --loop 10 times to find all hanger elements associated with this support
  do !i from 1 to 10
    !this.getElement('/FITT/H' + !i.string())
  enddo

endmethod


----------------------------------------------------------------------
--
-- Method:      getElement
--
-- Description: <try to build a name from this.supportName and the supplied key word>
--
----------------------------------------------------------------------
define method .getElement(!keyWord is STRING)

  --check to see if part of a support group and we have the allGroupElements option enabled
  if (!this.supportName.matchwild('*[*]') and !this.allGroupElements) then
    --remove the groupName coding suffix since we will check for group names as part of the full process anyway
    !suppName = !this.supportName.substring(1, !this.supportName.length() - 3)
  else
    !suppName = !this.supportName
  endif

  if (!keyWord.eq('')) then
    !runDotNameCode = TRUE
  else
    !runDotNameCode = FALSE
  endif

  --try a basic name i.e. supportName + keyword
  !basicName = !suppName + !keyWord
  !basicNameRef = !basicName.dbref()
  handle (2,109)
  elsehandle NONE
    !this.foundElements.append(!basicNameRef)
  endhandle

  if (!runDotNameCode) then
    --now try for . names
    do !i from 1 to 100
      !basicName = !suppName + '.' + !i.string() + !keyWord
      !basicNameRef = !basicName.dbref()
      handle (2,109)
      elsehandle NONE
        !this.foundElements.append(!basicNameRef)
      endhandle
    enddo
  endif

  --now try for group names. we only need to run this if we are searching using the allGroupElements option
  --this is because we have already stripped the trailing [n] suffix from the supplied support name and we will be
  --substituting new [n] syntax to the support name in order to look for all items
  if (!this.allGroupElements) then
    do !i from 1 to 50
      !groupName = !suppName + '[' + !i.string() + ']' + !keyWord
      !groupNameRef = !groupName.dbref()
      handle (2,109)
      elsehandle NONE
        !this.foundElements.append(!groupNameRef)
      endhandle

      if (!runDotNameCode) then
        do !j from 1 to 100
          --do groupname with '.' name
          !groupName = !suppName + '[' + !i.string() + ']' + '.' + !j.string() + !keyWord
          !groupNameRef = !groupName.dbref()
          handle (2,109)
          elsehandle NONE
            !this.foundElements.append(!groupNameRef)
          endhandle
        enddo
      endif
    enddo
  endif

endmethod

----------------------------------------------------------------------
--
-- Method:      getTrunnionBranch
--
-- Description: <loop through the found members array and find all owning branch members that are set :MDSTrun true>
--
----------------------------------------------------------------------
define method .getTrunnionBranch()

  do !element values !this.foundElements
    !elementOwner = !element.owner
    if (!elementOwner.type.eq('BRAN')) then
      if (!elementOwner.:MDSTRUN.eq(TRUE)) then
        !this.foundElements.append(!elementOwner)
      endif
    endif
  enddo

endmethod

----------------------------------------------------------------------
--
-- Method:      filterElements
--
-- Description: <filter the foundelements array against the supplied filter list so that we only return the required elements>
--
----------------------------------------------------------------------
define method .filterElements(!filter is STRING)

  !filterArray = !filter.split(',')
  !tempArray = object ARRAY()
  do !foundItem values !this.foundElements
    if (!filterArray.find(!foundItem.type).size().gt(0)) then
      !tempArray.append(!foundItem)
    endif
  enddo

  !this.foundElements = !tempArray

endmethod

----------------------------------------------------------------------
--
-- Method:      convertToStringArray
--
-- Description: <convert an array of DBREF to STRING>
--
----------------------------------------------------------------------
define method .convertToStringArray(!inputArray is ARRAY) is ARRAY

  !returnArray = object ARRAY()
  do !item values !inputArray
    !returnArray.append(!item.ref.string())
  enddo
  return !returnArray

endmethod
