--
--
-- Description:
-- Multi Discipline support object
-- object to deal with the connections between sctn and anchor plates
-- Situations where it will be used?
-- 1) to identify a sctn and wall plate and set the connection
-- 2) to identify a fitting and a wall plate
-- 3) to save the connections and reset them at the end of modification
-- 4) to set the connections between a trunnion plat and a bedplate
-- 5) to reset the bpref1 and bpref2 attributes on all valid objects(Use once only)
-- Constructor methods
--   mdsBPlateconn(!form is FORM, !sctn is DBREF,!action is BOOLEAN)
--     This is the main method called by the mdsbedplate form to connect/disconnect
--     sections to anchor plates
--   mdsBPlateconn(!sctn is DBREF,!anchor is DBREF)
--     This method is used to reconnect a sctn to anchor plate connection
--   mdsBPlateconn(!support is DBREF)
--     This method allows the user to select a sctn on the current support and connect
--     it to an anchor plate ( Not used at present )
--   mdsBPlateconn(!support is DBREF,!modify is BOOLEAN)
-- Externally called methods
--   resetbprefs()
--     This method is used once only to delete Bpref1 and Bpref2 attributes and reset
--     them to :mdsancref attributes. It collects all the required items and goes round
--     and tidies them up automatically
-- Internal methods
--   setancref(!item is DBREF,!array is ARRAY)
--     Sets the passed array as the :mdsancref of !item
--   testposition()is BOOLEAN     ****NOT YET IMPLEMENTED****
--     This method checks the positions of the ends of the current SCTN against the anchor
--     plate if the plate is too far away, it returns false
--   tidyrefs(!item is DBREF)
--     Gets rid of badrefs and unsatisfied return references between sctn and plates
--   unsetbprefs(!current is DBREF,!refitem is DBREF,!which is REAL)
--     This is called by resetbprefs to unset :bpref1 and :bpref2 after they have been replaced
--   connectsctn()
--     Called by various methods, this connects !this.sctn to !this.anchor
--   connectfitt()
--     method to make the connection between a FITT and SBFI for Framatome Electrical
--     supports Some supports have two connections, so it will be necessary to set :mdsancrefs
--     on affected sections
--   disconnect(!sctn is DBREF)
--     This method disconnects two connected items and cleans up the :mdsancrefs
--   showconnections()
--     Displays aid text showing connections on a single item
--   hideconnections()
--     Hides connection aid text
--   iditem(!prompt is STRING,!type is STRING)is DBREF
--     This method displays the passed prompt and gets the user to identify
--     an item of the passed type. If the user presses escape an empty dbref is returned
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  connectsctn()                    -
--  mdsInterfaceBPlateconn(DBREF)    -
--  mdsInterfaceBPlateconn(DBREF,BOOLEAN) -
--  mdsInterfaceBPlateconn(DBREF,DBREF) -
--  mdsInterfaceBPlateconn(FORM,DBREF,BOOLEAN) -
--  mdsInterfaceBPlateconn(MDSINTERFACESUPPORT) -
--  mdsInterfaceBPlateconn(STRING)   -
--  mdsInterfaceBPlateconn(STRING,DBREF) -
--  restoreconns()                   -
--
define object MDSINTERFACEBPLATECONN

  member  .sctn    is DBREF
  member  .anchor  is DBREF
  member  .support is DBREF
  member  .form    is FORM
  member  .storedsctns is ARRAY
  member  .storedconns is ARRAY

endobject
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- constructor method for resetting the electrical fitting connections and
-- the bpref1 bpref2 attrubutes to use :mdsancref
-- to use, type the following on the command line:
-- !a = object MDSBPLATECONN('reset')
define method .mdsInterfaceBPlateconn(!reset is STRING)

  !this.resetbprefs()
  !this.resetfittings()
  !this.resetpconns()

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
-- constructor method for building the object in the forms modify mode
define method .mdsInterfaceBPlateconn(!support is DBREF,!dummymodify is BOOLEAN)
  !this.support = !support

  !bpref1 = !!this.support.bpref1
  !bpref2 = !!this.support.bpref2
  if !bpref1.set() then
    !this.resetbprefs(1,!bpref1)
  endif
  if !bpref2.set() then
    !this.resetbprefs(1,!bpref1)
  endif

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to connect a sctn and anchor plate
-- to set/reset defined connections
define method .mdsInterfaceBPlateconn(!sctn is DBREF,!anchor is DBREF)

  !save = !!ce
  !this.sctn   = !sctn
  !this.support = !this.sctn.owner.owner
  !this.anchor = !anchor
  !this.connectsctn()
  -- $!this.support
  !!ce = !save

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to connect a sctn to anchor plate
-- section is passed,anchor plate is identified
-- used by the new bedplate form to pass a sctn and either connect it or
-- disconnect it from an SBFI
define method .mdsInterfaceBPlateconn(!form is FORM, !sctn is DBREF,!action is BOOLEAN)

  !this.sctn   = !sctn
  !this.form   = !form
  if !action.not() then
    !this.disconnect(!sctn)
    if !!mdsbedplate.shown() then
      !!mdsbedplate.showconnections()
    endif
    return
  endif
  -- method for hitting the old type of stru
  if !sctn.type.eq('PLAT') or !sctn.type.eq('ATTA') or !sctn.type.eq('HANG') then
    !this.support = !sctn
    do
      !this.anchor = !this.iditem(|Identify base/anchor plate to reference.|, |GENSEC SBFI PANE FIXING STRU|)
      if !this.anchor.unset() then
        !!ce = !this.support
        return
      elseif !this.anchor.type.eq('STRU') and !this.anchor.skey.eq('BEDP') then
        break
      elseif !this.anchor.type.eq('SBFI') then
        break
      elseif !this.anchor.type.eq('FIXING') then
        break
      endif
    enddo
  else    $* its a sctn
    !this.support = !this.form.support.stru
    do
      !this.anchor = !this.iditem(|Identify base/anchor plate to reference.|, |GENSEC SBFI PANE FIXING FITT STRU|)
      if !this.anchor.unset() then
        !!ce = !this.support
        return
      elseif !this.anchor.type.eq('STRU') and !this.anchor.skey.eq('BEDP') then
        break
      elseif !this.anchor.type.eq('SBFI') then
        break
      elseif !this.anchor.type.eq('FITT') then
        break
      elseif !this.anchor.type.eq('PANE') then
        break
      elseif !this.anchor.type.eq('GENSEC') then
        break
      elseif !this.anchor.type.eq('FIXING') then
        break
      endif
    enddo
  endif

  if !this.anchor.unset() then
    !!ce = !this.support
    return
  endif
  !this.connectsctn()

  if !!mdsbedplate.shown() then
    !!mdsbedplate.showconnections()
  endif

  $!this.support

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to store the anchor references for rebuilding later
-- possible connection items are the support Datum (ATTA or PLAT)
-- all of the sctn elements in the support stru
-- REFACTOR ADDED THE NEW INTERFACE SUPPORT TYPE
define method .mdsInterfaceBPlateconn(!support is MDSINTERFACESUPPORT)

  if !support.datum.unset() then
    !!alert.error('Datum Not Defined Correctly')
    return
  endif

  !comps[1] = !support.datum.string()

  if !support.stru.set() then
    if !support.type.match('FR').eq(1) then
      var !comps append collect all fitt for $!support.stru
    else
      var !comps append collect all sctn for $!support.stru
    endif
  endif


  if !comps[1].dbref().cref.set() then
    !s = !comps[1].dbref().cref.type
    if !s eq 'HANG' then
      !rest = !comps[1].dbref().cref.owner
      var !comps coll all Hang for $!rest
    endif
  endif


  do !a values !comps
    !test = !a.dbref()
    handle any
      skip
    endhandle
    if !a.dbref().:mdsancref.set() then
      !this.storedsctns.append(!a.dbref().flnm)
      !this.storedconns.append(!a.dbref().:mdsancref)
    endif
  enddo

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to identify a sctn and anchor plate passed element is a support
-- used for conventional supports for one sctn to plate connection
define method .mdsInterfaceBPlateconn(!support is DBREF)

  !!ce = !support
  !this.support = !support
  var !sctns coll all sctn for $!support
  if !sctns.size().lt(1) then
    !!alert.error('This Support Contains No Sections')
    return
  endif
  label /idsctn
  !this.sctn   = !this.iditem(|Identify Section to be Connected|, |SCTN|)
  if !this.sctn.unset() then
    !!ce = !support
    return
  elseif !this.sctn.owner.owner.neq(!this.support) then
    !!alert.error('identified Section does not belong to this support')
    golabel /idsctn
  endif
  !this.anchor = !this.iditem(|Identify base/anchor plate to reference.|, |SBFI|)
  if !this.anchor.unset() then
    !!ce = !support
    return
  endif

  -- now go and make the connection
  !this.connectsctn()
  !!ce = !this.support
  $!this.support

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .mdsInterfaceBPlateconn(!action is STRING,!support is DBREF)

  !save = !!ce

  !items = ARRAY()

  var !atta  coll all ATTA for $!support
  handle any
  endhandle
  if !atta.size().gt(0) then
    do !a values !items
      !rest = !a.dbref().cref
      handle any
        skip
      endhandle
      !items.append(!rest.owner)
    enddo
  endif
  var !items append coll all SCTN for $!support
  handle any
  endhandle
  var !items append coll all FITT for $!support
  handle any
  endhandle
  var !items append coll all PLAT for $!support
  handle any
  endhandle

  !this.disconnect('f',!items)
  do !b values !items
    !!ce = !b.dbref()
    :mdsancref defa
  enddo

  !!ce = !save

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
-- method to restore the stored anchor references
-- possible connection items are the support Datum (ATTA or PLAT)
-- all of the sctn elements in the support stru
define method .restoreconns()

  !save = !!ce
  do !a index !this.storedsctns
    -- go to the item (uses fullname in case the item has been redefined
    $!this.storedsctns[$!a]
    handle ANY
      !!alert.error( 'Problem With Restoring Connections for $!a' Connections Deleted)
      !this.disconnect(!this.storedsctns)
      return
    endhandle
    -- set the ancref on the current element
    !this.setancref(!!ce,!this.storedconns[!a])
    -- loop through the stored connections and set the ancref back
    --do !b values !this.storedconns[!a]
    --  !f = object MDSBPLATECONN(!!ce,!b)
    --enddo
  enddo

  -- if the bedplate form is shown and the support has been built using dimensions
  -- then the bedplate form needs to be reinitialised
  if !!mdsbedplate.shown() then
    !!mdsbedplate.reinit()
    handle ANY
    endhandle
  endif
  !!ce = !save

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
-- method to make the connection between a SCTN and SBFI or PLAT and STRU
define method .connectsctn()
  !num = 1
  !tidyplate = object DBREF()

  --  if !this.sctn.type.eq('SCTN') and !this.anchor.type.eq('SBFI') then
  !this.tidyrefs(!this.sctn)
  if !this.sctn.:mdsancref.set() then
$(
    -- save the first connection of the section, fitt plat or whatever it is
    !tidyplate = !this.sctn.:mdsancref[1]
    -- check to see if the sctn is connected already

    if !this.sctn.:mdsancref[1].:mdsancref.findfirst(!this.sctn).set() then
      !testarray = !this.sctn.:mdsancref[1]
$)
      -- if the current item is not set to the thing its about to be connected to then warn the user
      !memory = !this.sctn.:mdsancref
      if !memory.size().eq(2) then
        -- find out which one to be connected?
        !listpos = !!mdsbedplate.sctns.rtext.findfirst(!this.sctn.string())
        if !listpos.eq(!!mdsbedplate.sctns.val) then
          -- first one
        else
          !num = 2
        endif
      endif

      !canHave2refs = !this.canHave2Refs()

      if !this.sctn.:mdsancref[!num].neq(!this.anchor) then
        !name = !this.sctn.namn
        !oldname = !this.sctn.:MDSancref[1].namn
        !oldname2 = !this.sctn.:MDSancref[2].namn
        handle ANY
        endhandle
        !type = !this.sctn.type
        if !memory.size().eq(2) or !canHave2refs.not() then
          -- already connected with 2 connections
          if !!alert.confirm('$!type $!name is already connected to $!oldname OK to Modify' ).eq('NO') then
            return
          endif
          if !memory.size().eq(2) then
            if !num.eq(2) then
              !array[1] = !this.sctn.:mdsancref[1]
            else
              !array[2] = !this.sctn.:mdsancref[2]
            endif
          endif
          !this.disconnect(!this.sctn)

        else
          -- already connected with 1 connection
          !addtest = !!alert.question('$!type $!name is already connected. Hit YES to modify existing connection,  or NO to add an extra connection.' )
          if !addtest.eq('CANCEL') then
            return
          elseif !addtest.eq('NO') then
            !array[1] = !this.sctn.:mdsancref[1]
            !num = 2
          else
            !this.disconnect(!this.sctn)
          endif
        endif
      else
        if !memory.size().eq(2) then
          if !num.eq(2) then
            !array[1] = !this.sctn.:mdsancref[1]
          else
            !array[2] = !this.sctn.:mdsancref[2]
          endif
        endif
      endif
    endif

    -- set the mdsancref on the sctn
    -- !array = !this.sctn.:mdsancref
    --!array[1] = !this.anchor
    !array[!num] = !this.anchor
    !!ce = !this.sctn
    :mdsancref defa
    :mdsconn defa
    handle ANY
    endhandle
    !this.sctn.:mdsancref = !array
    same
    if !tidyplate.set() then
      !this.tidyrefs(!tidyplate)
    endif
    -- now do the anchor plate
    !this.tidyrefs(!this.anchor)
    !array = !this.anchor.:mdsancref
    handle NONE
      !array.append(!this.sctn)
      !array.unique()
      !this.anchor.:mdsancref = !array
      handle ANY
      endhandle
    elsehandle ANY
    endhandle
    --  elseif !this.sctn.type.eq('PLAT') and !this.anchor.type.eq('STRU') then
    --     set the :mdsconn
    --     !this.sctn.:mdsconn = !this.anchor
    --  endif

    -- dtf >>> Mod to reposition tail of hanger if plate proud (9th Aug 05)
    if !this.sctn.type.eq('HANG') then
      -- its a hanger
      !this.repositiontail(!this.sctn, !this.anchor)
    endif
    -- dtf <<< end of mod
  endmethod
  --------------------------------------------------------------------------------

  -- method to disconnect the passed item
  -- unsets the current ancref and the return reference
  --------------------------------------------------------------------------------
  --
  define method .disconnect(!action is STRING,!items is DBREF)


    !save = !!ce

    !test = !items.:mdsancref
    do !a values !test
      !!ce = !a
      handle any
        skip
      endhandle
      if !!ce.:mdsancref.findfirst(!items).gt(0) then
        !anc = !!ce.:mdsancref
        !anc.remove(!!ce.:mdsancref.findfirst(!items))
        :mdsancref defa
        handle ANY
          !!alert.error('unable to modify Connection for $!sctn')
        endhandle
        !!ce.:mdsancref = !anc
      endif
    enddo

    !!ce = !save


  endmethod
  --------------------------------------------------------------------------------


  --------------------------------------------------------------------------------
  --
  define method .disconnect(!action is STRING,!items is ARRAY)

    !save = !!ce

    do !item values !items
      !test = !item.dbref().:mdsancref
      do !a values !test
        !!ce = !a
        handle any
          skip
        endhandle
        if !!ce.:mdsancref.findfirst(!item.dbref()).gt(0) then
          !anc = !!ce.:mdsancref
          !anc.remove(!!ce.:mdsancref.findfirst(!item.dbref()))
          :mdsancref defa
          handle ANY
            !!alert.error('unable to modify Connection for $!sctn')
          endhandle
          !!ce.:mdsancref = !anc
        endif
      enddo
    enddo
    !!ce = !save

  endmethod
  --------------------------------------------------------------------------------



  --------------------------------------------------------------------------------
  -- method to disconnect the passed section and reset the anchor refs on the anchor plate
  define method .disconnect(!sctns is ARRAY)

    do !a values !sctns
      !!ce = !a.dbref()
      handle ANY
        skip
      endhandle
      !this.disconnect(!!ce)
    enddo

  endmethod
  --------------------------------------------------------------------------------

  --------------------------------------------------------------------------------
  -- method to disconnect the passed section and reset the anchor refs on the anchor plate
  define method .disconnect(!sctn is DBREF)
    !num = 1
    !reset = FALSE
    !savedvalue = ARRAY()
    !memory = !sctn.:mdsancref
    if !memory.size().eq(2) then
      -- find out wich one to be disconnected?

      !listpos = !!mdsbedplate.sctns.rtext.findfirst(!sctn.string())
      if !listpos.eq(!!mdsbedplate.sctns.val) then
        !reset = TRUE
        !savedvalue.append(!memory[2])
        -- Remove first one
      else
        !reset = TRUE
        !savedvalue.append(!memory[1])
        !num = 2
      endif
    endif
    if !memory.size().gt(0) then
      !anchor = !memory[!num]
      -- goto the sctn
      !!ce = !sctn
      :mdsancref defa
      handle ANY
        !!alert.error('unable to modify Connection for $!sctn')
      endhandle
      !!ce = !anchor
      handle ANY
        write 'error going to anchor'
        return
      elsehandle NONE
        !this.tidyrefs(!!ce)
      endhandle
    endif


    if !reset then
      !!ce = !sctn
      !!ce.:mdsancref =!savedvalue
    endif
  endmethod
  --------------------------------------------------------------------------------


  --------------------------------------------------------------------------------
  -- method to make the connection between a FITT and SBFI for Framatome Electrical
  -- supports
  -- Some supports have two connections, so it will be necessary to set :mdsancrefs
  -- on affected sections
  define method .connectfitt(!order is REAL)


    if !this.sctn.:mdsancref.set() then
      !current = !this.sctn.:mdsancref
      if !this.sctn.:mdsancref.size().geq(!order) then
        -- its ok to connect
        -- check to see if the sctn is connected already
        if !this.sctn.:mdsancref[!order].neq(!this.anchor) then
          !name = !this.sctn.:mdsancref[!order].namn
          if !!alert.confirm('Section $!name is already connected. OK to modify?' ).eq('NO') then
            return
          endif
        endif
      endif
    endif


    -- set the mdsancref on the sctn
    -- !array = !this.sctn.:mdsancref
    !array[1] = !this.anchor
    !!ce = !this.sctn
    :mdsancref defa
    :mdsconn defa
    !this.sctn.:mdsancref = !array
    same
    if !tidyplate.set() then
      !this.tidyrefs(!tidyplate)
    endif
    -- now do the anchor plate
    !this.tidyrefs(!this.anchor)
    !array = !this.anchor.:mdsancref
    !array.append(!this.sctn)
    !array.unique()
    !this.anchor.:mdsancref = !array
    --elseif !this.sctn.type.eq('SCTN') and !this.anchor.type.eq('SCTN') then
    -- set the :mdsconn
    --!this.sctn.:mdsconn = !this.anchor
    --endif

  endmethod
  --------------------------------------------------------------------------------


  --------------------------------------------------------------------------------
  -- method to get rid of bad return references and clean out deleted references
  define method .tidyrefs(!item is DBREF)

    -- check for deleted items and remove them
    !final = ARRAY()
    if !item.type.neq('PANE') and !item.type.neq('GENSEC') then
      do !a index !item.:mdsancref
        if !item.:mdsancref[!a].badref().not() then
          if !item.:mdsancref[!a].type.neq('PANE') and !item.:mdsancref[!a].type.neq('GENSEC') then
            if !item.:mdsancref[!a].:mdsancref.findfirst(!item).set() then
              !final.append(!item.:mdsancref[!a])
            endif
          endif
        endif
      enddo
    endif

    !this.setancref(!item,!final)

  endmethod
  --------------------------------------------------------------------------------


  --------------------------------------------------------------------------------
  define method .setancref(!item is DBREF,!array is ARRAY)

    !array.unique()
    !!ce = !item
    :mdsancref defa
    handle NONE
      if !array.size().gt(0) then
        !item.:mdsancref = !array
      endif
      same
    elsehandle ANY
    endhandle

  endmethod
  --------------------------------------------------------------------------------

  --------------------------------------------------------------------------------
  define method .iditem(!prompt is STRING,!type is STRING)is DBREF

    !return = object DBREF()
    prompt off
    prompt load escape |$!prompt|
    do
      id $!type @
      handle (61,528)
        break
      endhandle
      if !type.match(!!ce.type).gt(0) then
        !return = !!ce
        break
      endif
    enddo
    prompt dismiss
    prompt on

    if !!mdsComClaimDac(!!ce,'DACMOD',':MdsAncRef').not() then
      if !!alert.confirm('Identified element is in a read only database. Make one way connection?').eq('YES') then
        return !return
      else
        --!!alert.error('Unable to set the bed/anchor plate references as write access is not available')
        return !return
      endif
    endif

    return !return

  endmethod
  --------------------------------------------------------------------------------

  --------------------------------------------------------------------------------
  define method .showconnections()

    !sctnpos = !this.sctn.poss.wrt(/* )
    !platepos = !this.anchor.position.wrt(/* )
    aid text number 2312 'Section' at $!sctnpos
    aid text number 2313 'Anchor plate' at $!platepos

  endmethod
  --------------------------------------------------------------------------------


  --------------------------------------------------------------------------------
  define method .hideconnections()

    aid clear text 2312
    aid clear text 2313

  endmethod
  --------------------------------------------------------------------------------

  --------------------------------------------------------------------------------
  -- method to take existing supports and copy the bprefs into :mdsanc refs
  -- it collects all of the items which can have :mdsbpref references set
  define method .resetbprefs()

    var !a coll all stru with purp of zone eq 'SUPP' and dbwrite eq TRUE
    var !a append coll all (ATTA PLAT) with purp of pspe eq 'MDS' and dbwrite eq TRUE

    do !b values !a
      !!ce = !b.dbref()
      !bpref1 = !!ce.:mdsbpref1
      -- try to go to the element to see if its a valid item
      !!ce = !bpref1
      handle ANY
        -- if bpref1 is not set then bpref2 should not be set, so its ok to skip
        skip
      elsehandle NONE
        !this.unsetbprefs(!b.dbref(),!bpref1,1)
        handle ANY
        endhandle
      endhandle
      !bpref2 = !!ce.:mdsbpref2
      handle (2,204) $* attribute not on this item
        skip
      endhandle
      -- try to go to the element to see if its a valid item
      !!ce = !bpref2
      handle ANY
      elsehandle NONE
        !this.unsetbprefs(!b.dbref(),!bpref2,2)
        handle ANY
        endhandle
      endhandle
    enddo

  endmethod
  --------------------------------------------------------------------------------

  --------------------------------------------------------------------------------
  -- method to take existing supports and copy the bprefs into :mdsanc refs
  -- it collects all of the items which can have :mdsbpref references set
  define method .resetpconns()

    var !sctn coll all sctn with purp of zone eq 'SUPP' and dbwrite eq TRUE

    do !b values !sctn
      !!ce = !b.dbref()
      !connections = !!ce.:mdspconn
      do !plate values !connections
        !test = !plate.string().dbref()
        handle any
          skip
        endhandle
        !temp = object MDSBPLATECONN(!!ce,!plate)
      enddo
    enddo

  endmethod
  --------------------------------------------------------------------------------



  --------------------------------------------------------------------------------
  define method .resetfittings()

    var !fitt coll all fitt with match(name of spref,'GUSSET') gt 0
    do !a values !fitt
      if !a.dbref().dbwrite then
        !a.dbref().purp = 'CONN'
        if !a.dbref().cref.set() then
          -- connect the fitting using the :mdsancref attribute
          !temp = object MDSBPLATECONN(!a.dbref(),!a.dbref().cref)
        endif
      endif
    enddo

  endmethod
  --------------------------------------------------------------------------------


  --------------------------------------------------------------------------------
  define method .unsetbprefs(!current is DBREF,!refitem is DBREF,!which is REAL)

    !!ce = !current
    -- check to see if its a valid return reference
    if !current.:mdsbpref$!<which>.:mdsbpref$!<which>.eq(!current).not() then
      -- its not a valid return reference so just unset the :mdsbpref
    else
      -- get the current elements mds ancref array
      !mdsancref = :mdsAncRef
      -- check to see if the reference has been set already
      !test = !mdsancref.findfirst(!refitem)
      if !test.unset() then
        -- if the reference is not already in the ARRAY then add it to the end
        !mdsancref.append(!refitem)
        -- delete the existing :mdsancref as its the only way to replace it properly
        :mdsancref defa
        -- replace the array with its new values
        !!ce.:mdsancref = !mdsancref
      endif
      -- now do the same with the reference item
      !!ce = !refitem
      !mdsancref = :mdsAncRef
      !test = !mdsancref.findfirst(!current)
      if !test.unset() then
        !mdsancref.append(!current)
        :mdsancref defa
        !!ce.:mdsancref = !mdsancref
      endif
    endif

    -- now go to the current list item and remove its :mdsbpref value
    !!ce = !current
    :mdsbpref$!<which> defa

  endmethod
  --------------------------------------------------------------------------------

  --------------------------------------------------------------------------------
  define method .canHave2Refs() is BOOLEAN
    !return = FALSE

    /FRA/TEMPLATES
    handle ANY
    elsehandle NONE
      !func = !this.sctn.function.split('-')
      handle ANY
      elsehandle NONE
        if !func.size().gt(0) then
          if !func[1].matchwild('Q?') then
            !return = TRUE
          endif
        endif
      endhandle
    endhandle

    return !return

  endmethod
  --------------------------------------------------------------------------------


  --------------------------------------------------------------------------------
  define method .repositiontail(!hang is DBREF,!anchor is DBREF)

    !tpos = !hang.tposition
    !tdir = !hang.tdir
    pin 1 at $!tpos
    pin 1 dir $!tdir
    pin 1 plane pin 1 clear 0 behind  $!anchor
    var !pin1pos pos pin 1 wrt world

    !hang.tposition = $!pin1pos


  endmethod
