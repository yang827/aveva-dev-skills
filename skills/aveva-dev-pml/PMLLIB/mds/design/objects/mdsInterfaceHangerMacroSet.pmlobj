--
-- File:    mdsInterfaceHangerMacroSet.pmlobj
--   Type:    Object Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    R.Martin
-- Created:
--
--
-- Description:
-- object to store information about sets of hanger connection macros that can be run in without fear of affecting other hangers
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  append(FILE)                     -
--  getName(FILE)                    ARRAY
--  mdsInterfaceHangerMacroSet(FILE) -
--  updateNameList()                 -
--

-- Define Object

define object MDSINTERFACEHANGERMACROSET

  -- nameList (list of names that the hanger is known by. this will be multiple if the hanger has been renamed
  --we will use this to check if items in the macros filelist are part of an existing macro set or a new one
  member .nameList is ARRAY

  --list of files in datetime order that make up the macro set
  member .fileList is ARRAY

  member .access is BOOLEAN

endobject

define method .mdsInterfaceHangerMacroSet(!file is FILE)

  --add the file to the fileList member
  !this.fileList.append(!file)

  --update the list of names based upon the current hanger name
  !this.updateNameList()

  --set the initial access value
  !this.access = FALSE

endmethod

--this method updates the namelist if any rename macros have changed the name of the hanger
define method .updateNameList()

  !list = object ARRAY()

  do !i from 1 to !this.fileList.size()
    !nameList = !this.getName(!this.fileList[!i])
    do !j from 1 to !nameList.size()
      !list.append(!nameList[!j])
    enddo
  enddo

  !list = !list.unique()
  !this.nameList = !list

endmethod

--this method updates the namelist if any rename macros have changed the name of the hanger
define method .append(!file is FILE)

  !fileList = !this.fileList
  !fileList.append(!file)
  !this.fileList = !fileList.unique()

endmethod

define method .getName(!file is FILE) is ARRAY

  !nameList = object ARRAY()

  !attaname = object STRING()
  !newname = object STRING()

  !fileLines = !file.readfile()
  do !i from 1 to !fileLines.size()
    if !fileLines[!i].trim().match('!macrotype = ').gt(0) then
      !macrotype = !fileLines[!i].after('!macrotype = ').trim()
      --remove the string marks from the line
      !macrotype = $!macrotype
      handle ANY
        !macrotype = ''
      endhandle
    elseif !fileLines[!i].trim().match('!attaname = ').gt(0) then
      !attaname = !fileLines[!i].after('!attaname = ').trim()
      --remove the string marks from the line
      !attaname = !attaname
    elseif !fileLines[!i].trim().match('!newname = ').gt(0) then
      !newname = !fileLines[!i].after('!newname = ').trim()
      --remove the string marks from the line
      !newname = !newname
    endif
  enddo

  if !attaname.unset() then
    --this needs to be set so this could be an old style macro that does not have the !attaname line in the macros
    --if this is not set then try and re-scan the file to figure out what the attaname is
    do !i from 1 to !fileLines.size()
      if (!fileLines[!i].trim().match('/SBFI/H1').gt(0) or !fileLines[!i].trim().match('/FITT/H1').gt(0) or !fileLines[!i].trim().match('/CMPF').gt(0)) and !fileLines[!i].match('!!ce = ').gt(0) then
        !attaname = !fileLines[!i].before('/SBFI/H1').before('/FITT/H1').before('/CMPF').after('!!ce = ').trim()
        break
      endif
    enddo
    !nameList.append(!attaname)
  else
    !nameList.append(!attaname)
  endif

  if !macrotype.eq('RENAME') then
    if !newname.unset() then
      --this needs to be set so this could be an old style macro that does not have the !attaname line in the macros
      --if this is not set then try and re-scan the file to figure out what the attaname is
      do !i from 1 to !fileLines.size()
        if (!fileLines[!i].trim().match('/SBFI/H1').gt(0) or !fileLines[!i].trim().match('/FITT/H1').gt(0) or !fileLines[!i].trim().match('/CMPF').gt(0)) and !fileLines[!i].match('name ').gt(0) then
          !newname = !fileLines[!i].before('/SBFI/H1').before('/FITT/H1').before('/CMPF').after('name ').trim()
          break
        endif
      enddo
      !nameList.append(!newname)
    else
      !nameList.append(!newname)
    endif
  endif

  return !nameList

endmethod
