-- Define Object
define object MDSINTERFACEVIRTUALFITTING

  --mimic the members of a steelwork fitting object
  --standard members
  member .name is STRING
  member .type is STRING
  member .lock is BOOLEAN
  member .owner is DBREF
  member .description is STRING
  member .function is STRING
  member .purpose is STRING
  member .gtype is STRING
  member .number is REAL
  member .zdistance is REAL
  member .desparam is ARRAY
  member .built is BOOLEAN
  member .shop is BOOLEAN
  member .posline is STRING
  member .delPosition is POSITION
  member .bangle is REAL
  member .cref is DBREF
  member .grade is REAL
  member .ispec is DBREF
  member .firesistance is REAL
  member .inref is DBREF
  member .spref is DBREF
  member .matref is DBREF

  --mds required UDA's
  member .config is DBREF
  member .size is ARRAY
  member .object is STRING
  member .flowdir is STRING
  member .profile is STRING
  member .mdsancref is ARRAY
  member .mdsconnect is ARRAY
  member .mdsconnectN is STRING
  member .mdsposnum is ARRAY
  member .mdswelddata is ARRAY

  --world data
  member .position is POSITION
  member .owningStru is DBREF

endobject

define method .mdsInterfaceVirtualFitting(!steel is DBREF)

  --populate the object using the current steelwork member to get initial position etc
  !this.position = !steel.posstart.wrt( /* )
  !this.owner = !steel

  --get the owning stru
  !owner = !steel
  do
    !owner = !owner.owner
    handle ANY
      break
    endhandle

    if !owner.type.eq('STRU') then
      !this.owningStru = !owner
      break
    endif
  enddo

endmethod

--this constructor deals with the UDA hanger connection condition in which all of our
--fitting data is derived from the UDA's held on the hangers
define method .mdsInterfaceVirtualFitting(!hang is DBREF, !dummyString is STRING)

  !hangerTailPos = !hang.tpos.wrt( /* )
  !steel = !hang.:MDSCIVREF[1]
  !this.name = !hang.:MDSTREF
  !this.posline = !hang.:MDSCIVPOSL

  --get the position of the fitting by using the hanger tail as a reference
  var !poslstart ppli $!this.posline start of $!steel wrt /*
  var !poslend ppli $!this.posline end of $!steel wrt /*
  !steelPos = !poslstart.position()
  !steelDir = !steelPos.direction(!poslend.position())
  !steelPV = object POINTVECTOR(!steelPos, !steelDir)
  !steelPos2 = !steelPV.through(!hangerTailPos)
  !zdist = !steelPos.distance(!steelPos2.position)

  --set the zdistance
  !this.setZdist(!zdist)

  --populate the object using the current steelwork member to get initial position etc
  !this.owner = !steel

  --get the owning stru
  !owner = !steel
  do
    !owner = !owner.owner
    handle ANY
      break
    endhandle

    if !owner.type.eq('STRU') then
      !this.owningStru = !owner
      break
    endif
  enddo

  !this.setDelpos(!hangerTailPos)

endmethod

define method .getPosition() is POSITION

  --we need to return the position that has been altered by delpos and zdist
  --get the owning steelworks z direction and posstart
  !pos1 = !this.owner.posstart.wrt( /* )
  !pos2 = !this.owner.posend.wrt( /* )
  !zdir = !pos1.direction(!pos2)

  var !startPosition ppli $!this.posline start of $!this.owner wrt /*

  !pv1 = object POINTVECTOR(!startPosition.position().wrt( /* ), !zdir)

  --offset the position as altered by zdist
  !pv1 = !pv1.offset(!this.getZdist())

  --get the position as altered by delpos to do this we need to know the posline orientation
  var !poslineOri plori $!this.posline of $!this.owner wrt /*
  !oriXdir = !poslineOri.orientation().xdir().wrt( /* )
  !oriYdir = !poslineOri.orientation().ydir().wrt( /* )
  !oriZdir = !poslineOri.orientation().zdir().wrt( /* )

  --get the offset values from delpos
  !delpX = !this.delPosition.east
  !delpY = !this.delPosition.north
  !delpZ = !this.delPosition.up

  --offset the initial position through xyz to get the delpos altered position
  !pv1.direction = !oriXdir
  !pv1 = !pv1.offset(!delpX)
  !pv1.direction = !oriYdir
  !pv1 = !pv1.offset(!delpY)
  !pv1.direction = !oriZdir
  !pv1 = !pv1.offset(!delpZ)
  !position = !pv1.position.wrt( /* )
  return !position

endmethod

define method .getPositionNoDelp() is POSITION

  --we need to return the position that has been altered by delpos and zdist
  --get the owning steelworks z direction and posstart
  !pos1 = !this.owner.posstart.wrt( /* )
  !pos2 = !this.owner.posend.wrt( /* )
  !zdir = !pos1.direction(!pos2)

  var !startPosition ppli $!this.posline start of $!this.owner wrt /*
!!sp = !startPosition
  !pv1 = object POINTVECTOR(!startPosition.position().wrt( /* ), !zdir)

  --offset the position as altered by zdist
  !pv1 = !pv1.offset(!this.getZdist())
  !position = !pv1.position.wrt( /* )
  return !position

endmethod

define method .getZdist() is REAL

  return !this.zdistance

endmethod

define method .setZdist(!zdist is REAL)

  !this.zdistance = !zdist

endmethod

define method .zDistThrough(!position is POSITION)

  --set up a pointvector from posstart to posend of the supporting steel
  !pos1 = !this.owner.posstart.wrt( /* )
  !pos2 = !this.owner.posend.wrt( /* )
  !dir1 = !pos1.direction(!pos2)
  !pv1 = object POINTVECTOR(!pos1, !dir1)

  --offset the pointvector through the new position
  !pv2 = !pv1.through(!position)

  --work out the zdist
  !zdist = !pv1.position.distance(!pv2.position)
  if !zdist.neq(0) then
    !dir2 = !pv1.position.direction(!pv2.position)
    if !dir1.neq(!dir2) then
      !zdist = !zdist * -1
    endif
  endif
  !this.setZdist(!zdist)

endmethod

--returns the x direction of the current posline
define method .getposLineXdir() is DIRECTION

  !owner = !this.owner
  !posl = !this.posline
  !xdir = !owner.plori.$!posl .xdir().wrt( /* )
  return !xdir

endmethod

--returns the z direction of the current posline
define method .getposLineYdir() is DIRECTION

  !owner = !this.owner
  !posl = !this.posline
  !ydir = !owner.plori.$!posl .ydir().wrt( /* )
  return !ydir

endmethod

--returns the z direction of the current posline
define method .getposLineZdir() is DIRECTION

  !owner = !this.owner
  !posl = !this.posline
  !zdir = !owner.plori.$!posl .zdir().wrt( /* )
  return !zdir

endmethod

define method .getDelpos() is POSITION

  return !this.delPosition

endmethod

define method .setDelpos(!positionInSpace is POSITION)

  --get the current position of the fitting
  !fittPosition = !this.getPositionNoDelp()

  --get the posline x,y and z directions
  !plXdir = !this.getposLineXdir()
  !plYdir = !this.getposLineYdir()
  !plZdir = !this.getposLineZdir()

  --create a pointvector in the direction of the pline x,y and z directions
  !pvX = object POINTVECTOR(!fittPosition, !plXdir)
  !pvY = object POINTVECTOR(!fittPosition, !plYdir)
  !pvZ = object POINTVECTOR(!fittPosition, !plZdir)

  --get the through point of the position in space
  !pvX1 = !pvX.through(!positionInSpace)
  !pvY1 = !pvY.through(!positionInSpace)
  !pvZ1 = !pvZ.through(!positionInSpace)

  --get the distance between the fitting and the through point for each of the pline directions
  !xdist = !pvX.position.distance(!pvX1.position)
  !ydist = !pvY.position.distance(!pvY1.position)
  !zdist = !pvZ.position.distance(!pvZ1.position)

  --get the direction of between the fitting and the through point so we can compare it with the pline direction
  if !xdist.gt(0) then
    !xdir = !pvX.position.direction(!pvX1.position)
  else
    !xdir = !plXdir
  endif

  if !ydist.gt(0) then
    !ydir = !pvY.position.direction(!pvY1.position)
  else
    !ydir = !plYdir
  endif

  if !zdist.gt(0) then
    !zdir = !pvZ.position.direction(!pvZ1.position)
  else
    !zdir = !plZdir
  endif

  --ensure that the delp offsets are in the correct direction
  if !xdir.neq(!plXdir) then
    !xdist = -1 * !xdist
  endif

  if !ydir.neq(!plYdir) then
    !ydist = -1 * !ydist
  endif

  if !zdir.neq(!plZdir) then
    !zdist = -1 * !zdist
  endif

$(
  --!owningStru = !this.owningStru
  !up = !delPos.up
  handle ANY
    !up = !this.delPosition.up
    if !up.unset() then
      !up = 0
    endif
  endhandle

  !east = !delPos.east
  handle ANY
    !east = !this.delPosition.east
    if !east.unset() then
      !east = 0
    endif
  endhandle

  !north = !delPos.north
  handle ANY
    !north = !this.delPosition.north
    if !north.unset() then
      !north = 0
    endif
  endhandle

  !posstring = 'E' + !east.string() + 'N' + !north.string() + 'U' + !up.string()
  !position = object POSITION(!posstring)
  !position.origin = !this.owningStru
  !this.delPosition = !position
$)

  !posstring = 'E' + !xdist.string() + ' N' + !ydist.string() + ' U' + !zdist.string()
  !position = object POSITION(!posstring)
  !position.origin = !this.owningStru
  !this.delPosition = !position

endmethod

--dun1218 added this method to write out a connection macro which will add a fitting to a previously read only
--piece of steelwork
define method .connectionMacroOneFitting(!virtualFitting is MDSINTERFACEVIRTUALFITTING) is BOOLEAN

  !attaName = !virtualFitting.name.before('/FITT')
  if !attaName.substring(1,1).eq('/').not() then
    !attaName = '/' + !attaName
  endif

  !fittingName = !virtualFitting.name
  !fittingName.dbref()
  handle ANY
    -- fitting does not exist so create a new one
    !newFitting = TRUE
  elsehandle NONE
    --the fitting already exists so don't create a new one
    !newFitting = FALSE
  endhandle

  --build up an array of strings for the macro
  !lines = object ARRAY()

  --add a line that will act as a flag to enable us to tell whether or not a file needs to be run in
  !lines.append('!macrostatus = |PENDING|')

  --add a type line so that we can tell what the macro is supposed to be doing
  !lines.append('!macrotype = |CONNECTION UPDATE|')

  --add an atta line so that we can tell which atta is being updated
  !lines.append('!attaName = |$!attaName|')
  !lines.append('handle any')
  !lines.append('endhandle')

  --add a date time line that can be read into a date time object in the macro management form
  !dateTime = object DATETIME()
  !year = !dateTime.year().string()
  !month = !dateTime.month().string()
  !date = !dateTime.date().string()
  !hour = !dateTime.hour().string()
  !minute = !dateTime.minute().string()
  !second = !dateTime.second().string()
  !dateTimeString = !year + ',' + !month + ',' + !date + ',' + !hour + ',' + !minute + ',' + !second
  !lines.append('!dateTime = ' + '|$!dateTimeString|')

  --navigate to the existing fitting so that we can update its attributes
  !lines.append('!!ce = ' + !virtualFitting.name)

  --we need to add a handle block here for when the fitting doesn't already exist.
  !lines.append('handle any')
  !lines.append('--owning steelwork')
  !lines.append('!!ce = ' + !virtualFitting.owner.fullname)
  !lines.append('new fitt ' + !virtualFitting.name)
  !lines.append('endhandle')

  --capture all of the virtual fitting data and process it so that it can be run into the new fitting
  if !virtualFitting.description.set() then
    if !virtualFitting.description.trim().neq('') then
      !lines.append('description ' + |'$!virtualFitting.description'|)
    endif
  endif

  if !virtualFitting.function.set() then
    if !virtualFitting.function.trim().neq('') then
      !lines.append('function ' + |'$!virtualFitting.function'|)
    endif
  endif

  if !virtualFitting.purpose.set() then
    if !virtualFitting.purpose.trim().neq('') then
      !lines.append('purpose ' + '$!virtualFitting.purpose')
    endif
  endif

  if !virtualFitting.gtype.set() then
    if !virtualFitting.gtype.trim().neq('') then
      !lines.append('gtype ' + '$!virtualFitting.gtype')
    endif
  endif

  if !virtualFitting.number.set() then
    !lines.append('number ' + '$!virtualFitting.number')
  endif

  if !virtualFitting.zdistance.set() then
    !lines.append('zdistance ' + '$!virtualFitting.zdistance')
  endif

  if !virtualFitting.built.set() then
    !lines.append('built ' + '$!virtualFitting.built')
  endif

  if !virtualFitting.shop.set() then
    !lines.append('shop ' + '$!virtualFitting.shop')
  endif

  if !virtualFitting.posline.set() then
    if !virtualFitting.posline.trim().neq('') then
      !lines.append('posline ' + '$!virtualFitting.posline')
    endif
  endif

  if !virtualFitting.delPosition.set() then
    !delPos = !virtualFitting.delPosition.string().upcase().before('WRT')
    !lines.append('delPosition ' + '$!delPos')
  endif

  if !virtualFitting.bangle.set() then
    !lines.append('bangle ' + '$!virtualFitting.bangle')
  endif

  if !virtualFitting.cref.set() then
    --use the 'tail' keyword to force the cref to connect to the tail reference of the hanger
    !lines.append('cref ' + '$!virtualFitting.cref' + ' tail')
    !lines.append('handle any')
    !lines.append('endhandle')
  else
    --build the cref
    !hangerName = !virtualFitting.name.before('/FITT') + '/H1'

    --use the 'tail' keyword to force the cref to connect to the tail reference of the hanger
    !lines.append('cref ' + '$!hangerName' + ' tail')
    !lines.append('handle any')
    !lines.append('endhandle')
  endif

  if !virtualFitting.grade.set() then
    !lines.append('grade ' + '$!virtualFitting.grade')
  endif

  if !virtualFitting.ispec.set() then
    !lines.append('ispec ' + '$!virtualFitting.ispec')
  endif

  if !virtualFitting.firesistance.set() then
    !lines.append('firesistance ' + '$!virtualFitting.firesistance')
  endif

  if !virtualFitting.inref.set() then
    !lines.append('inref ' + '$!virtualFitting.inref')
  endif

  if !virtualFitting.spref.set() then
    !lines.append('spref ' + '$!virtualFitting.spref.fullname')
  endif

  if !virtualFitting.matref.set() then
    !lines.append('matref ' + '$!virtualFitting.matref')
  endif

  -- now the UDA's
  if !virtualFitting.config.set() then
    !lines.append(':config ' + '$!virtualFitting.config')
  endif

  if !virtualFitting.size.set() then
    !lines.append(':size ' + '$!virtualFitting.size')
  endif

  if !virtualFitting.object.set() then
    if !virtualFitting.object.trim().neq('') then
      !lines.append(':object ' + |'$!virtualFitting.object'|)
    endif
  endif

  if !virtualFitting.flowdir.set() then
    if !virtualFitting.flowdir.trim().neq('') then
      !lines.append(':flowdir ' + |'$!virtualFitting.flowdir'|)
    endif
  endif

  if !virtualFitting.profile.set() then
    if !virtualFitting.profile.trim().neq('') then
      !lines.append(':profile ' + '$!virtualFitting.profile')
    endif
  endif

  if !virtualFitting.mdsconnectN.set() then
    if !virtualFitting.mdsconnectN.trim().neq('') then
      !lines.append(':mdsconnectN ' + |'$!virtualFitting.mdsconnectN'|)
    endif
  endif

  --now do the arrays
  !desparam       = !virtualFitting.desparam
  if !desparam.size().gt(0) then
    !lines.append('!despar = object ARRAY()')
    do !i from 1 to !desparam.size()
      !lines.append('!despar.append($!desparam[$!i])')
    enddo
    !lines.append('desparam = $$!despar')
  endif

  !size           = !virtualFitting.size
  if !size.size().gt(0) then
    !lines.append('!fsize = object ARRAY()')
    do !i from 1 to !size.size()
      !lines.append('!fsize.append($!size[$!i])')
    enddo
    !lines.append(':size = $$!fsize')
  endif

  !mdsancref      = !virtualFitting.mdsancref
  if !mdsancref.size().gt(0) then
    !lines.append('!ancref = object ARRAY()')
    do !i from 1 to !mdsancref.size()
      !lines.append('!ancref.append($!mdsancref[$!i])')
    enddo
    !lines.append(':mdsancref = $$!ancref')
  endif

  !mdsconnect = !virtualFitting.mdsconnect
  if !mdsconnect.size().gt(0) then
    !lines.append('!connect = object ARRAY()')
    do !i from 1 to !mdsconnect.size()
      !lines.append('!connect.append($!mdsconnect[$!i])')
    enddo
    !lines.append('!!ce.:mdsconnect = !connect')
  endif

  !mdsposnum      = !virtualFitting.mdsposnum
  if !mdsposnum.size().gt(0) then
    !lines.append('!posnum = object ARRAY()')
    do !i from 1 to !mdsposnum.size()
      !lines.append('!posnum.append($!mdsposnum[$!i])')
    enddo
    !lines.append(':mdsposnum = $$!posnum')
  endif

  !welddata       = !virtualFitting.mdswelddata
  if !welddata.size().gt(0) then
    !lines.append('!fWelddata = object ARRAY()')
    do !i from 1 to !welddata.size()
      !lines.append('!fWelddata.append($!welddata[$!i])')
    enddo
    !lines.append(':mdswelddata = $$!fWelddata')
  endif

  --now write out the connection macro to the project MAC directory
  var !projCode proj code
  !evar = !projCode + 'MAC'

  var !macPath evar $!evar

  --make sure that the MAC directory exists
  !macFile = object FILE(!macPath)
  if !macFile.exists().not() then
    !!alert.error('the current project does not have a $!evar directory which is required to store inter db macros. Hanger creation has not completed correctly')
    return FALSE
  endif

  --now look for the hanger macro directory within the mac directory
  var !hangMacDir evar mdsHangerMacros

  --make sure that the hanger macro directory exists
  !hangMacFile = object FILE(!hangMacDir)
  if !hangMacFile.exists().not() then
    !!alert.error('the current project does not have a $!hangMacDir directory which is required to store hanger macros. Hanger creation has not completed correctly')
    return FALSE
  endif

  !fileName = !hangMacDir + |\| + !virtualFitting.name.after('/').before('/') + '-connection.mac'
  !file = object FILE(!fileName)

  --if the filename already exists then we have to create a new name, doesn't matter what the increment is on the file name
  --because the macro management tool will only order the files in date time order as it is stored in the file
  if !file.exists() then
    do !i
      !fileName = !hangMacDir + |\| + !virtualFitting.name.after('/').before('/') + '-$!i' + '-connection.mac'
      !file = object FILE(!fileName)
      if !file.exists() then
        skip
      else
        break
      endif
    enddo
  endif

  !file.writefile('OVERWRITE', !lines)

  return TRUE

endmethod

--dun1218 added this method to write out a connection macro which will add a fitting to a previously read only
--piece of steelwork
define method .connectionMacroTwoFittings(!virtualFittings is ARRAY) is BOOLEAN

  !attaName = !virtualFittings[1].name.before('/FITT')
  if !attaName.substring(1,1).eq('/').not() then
    !attaName = '/' + !attaName
  endif

  --build up an array of strings for the macro
  !lines = object ARRAY()

  --add a line that will act as a flag to enable us to tell whether or not a file needs to be run in
  !lines.append('!macrostatus = |PENDING|')

  --add a type line so that we can tell what the macro is supposed to be doing
  !lines.append('!macrotype = |CONNECTION UPDATE|')

  --add an atta line so that we can tell which atta is being updated
  !lines.append('!attaName = |$!attaName|')
  !lines.append('handle any')
  !lines.append('endhandle')

  --add a date time line that can be read into a date time object in the macro management form
  !dateTime = object DATETIME()
  !year = !dateTime.year().string()
  !month = !dateTime.month().string()
  !date = !dateTime.date().string()
  !hour = !dateTime.hour().string()
  !minute = !dateTime.minute().string()
  !second = !dateTime.second().string()
  !dateTimeString = !year + ',' + !month + ',' + !date + ',' + !hour + ',' + !minute + ',' + !second
  !lines.append('!dateTime = ' + '|$!dateTimeString|')

  do !i from 1 to 2

    !virtualFitting = !virtualFittings[!i]

    !fittingName = !virtualFitting.name
    !fittingName.dbref()
    handle ANY
      -- fitting does not exist so create a new one
      !newFitting = TRUE
    elsehandle NONE
      --the fitting already exists so don't create a new one
      !newFitting = FALSE
    endhandle

    --navigate to the existing fitting so that we can update its attributes
    !lines.append('!!ce = ' + !virtualFitting.name)

    --we need to add a handle block here because the fitting may not exist in the model yet.
    !lines.append('handle any')
    !lines.append('--owning steelwork ' + !i.string())
    !lines.append('!!ce = ' + !virtualFitting.owner.fullname)
    !lines.append('new fitt ' + !virtualFitting.name)
    !lines.append('endhandle')

    --capture all of the virtual fitting data and process it so that it can be run into the new fitting
    if !virtualFitting.description.set() then
      if !virtualFitting.description.trim().neq('') then
        !lines.append('description ' + |'$!virtualFitting.description'|)
      endif
    endif

    if !virtualFitting.function.set() then
      if !virtualFitting.function.trim().neq('') then
        !lines.append('function ' + |'$!virtualFitting.function'|)
      endif
    endif

    if !virtualFitting.purpose.set() then
      if !virtualFitting.purpose.trim().neq('') then
        !lines.append('purpose ' + '$!virtualFitting.purpose')
      endif
    endif

    if !virtualFitting.gtype.set() then
      if !virtualFitting.gtype.trim().neq('') then
        !lines.append('gtype ' + '$!virtualFitting.gtype')
      endif
    endif

    if !virtualFitting.number.set() then
      !lines.append('number ' + '$!virtualFitting.number')
    endif

    if !virtualFitting.zdistance.set() then
      !lines.append('zdistance ' + '$!virtualFitting.zdistance')
    endif

    if !virtualFitting.built.set() then
      !lines.append('built ' + '$!virtualFitting.built')
    endif

    if !virtualFitting.shop.set() then
      !lines.append('shop ' + '$!virtualFitting.shop')
    endif

    if !virtualFitting.posline.set() then
      if !virtualFitting.posline.trim().neq('') then
        !lines.append('posline ' + '$!virtualFitting.posline')
      endif
    endif

    if !virtualFitting.delPosition.set() then
      --workaround the delpos position wrt problem for the time being by trimming any wrt text
      !delPos = !virtualFitting.delPosition.string().upcase().before('WRT')
      !lines.append('delPosition ' + '$!delPos')
    endif

    if !virtualFitting.bangle.set() then
      !lines.append('bangle ' + '$!virtualFitting.bangle')
    endif

    if !virtualFitting.cref.set() then
      --use the 'tail' keyword to force the cref to connect to the tail reference of the hanger
      !lines.append('cref ' + '$!virtualFitting.cref' + ' tail')
      !lines.append('handle any')
      !lines.append('endhandle')
    else
      --build the cref
      !hangerName = !virtualFitting.name.before('/FITT') + '/H' + !i.string()

      --use the 'tail' keyword to force the cref to connect to the tail reference of the hanger
      !lines.append('cref ' + '$!hangerName' + ' tail')
      !lines.append('handle any')
      !lines.append('endhandle')
    endif

    if !virtualFitting.grade.set() then
      !lines.append('grade ' + '$!virtualFitting.grade')
    endif

    if !virtualFitting.ispec.set() then
      !lines.append('ispec ' + '$!virtualFitting.ispec')
    endif

    if !virtualFitting.firesistance.set() then
      !lines.append('firesistance ' + '$!virtualFitting.firesistance')
    endif

    if !virtualFitting.inref.set() then
      !lines.append('inref ' + '$!virtualFitting.inref')
    endif

    if !virtualFitting.spref.set() then
      !lines.append('spref ' + '$!virtualFitting.spref.fullname')
    endif

    if !virtualFitting.matref.set() then
      !lines.append('matref ' + '$!virtualFitting.matref')
    endif

    -- now the UDA's
    if !virtualFitting.config.set() then
      !lines.append(':config ' + '$!virtualFitting.config')
    endif

    if !virtualFitting.size.set() then
      !lines.append(':size ' + '$!virtualFitting.size')
    endif

    if !virtualFitting.object.set() then
      if !virtualFitting.object.trim().neq('') then
        !lines.append(':object ' + |'$!virtualFitting.object'|)
      endif
    endif

    if !virtualFitting.flowdir.set() then
      if !virtualFitting.flowdir.trim().neq('') then
        !lines.append(':flowdir ' + |'$!virtualFitting.flowdir'|)
      endif
    endif

    if !virtualFitting.profile.set() then
      if !virtualFitting.profile.trim().neq('') then
        !lines.append(':profile ' + '$!virtualFitting.profile')
      endif
    endif

    if !virtualFitting.mdsconnectN.set() then
      if !virtualFitting.mdsconnectN.trim().neq('') then
        !lines.append(':mdsconnectN ' + |'$!virtualFitting.mdsconnectN'|)
      endif
    endif

    --now do the arrays
    !desparam       = !virtualFitting.desparam
    if !desparam.size().gt(0) then
      !lines.append('!despar = object ARRAY()')
      do !j from 1 to !desparam.size()
        !lines.append('!despar.append($!desparam[$!j])')
      enddo
      !lines.append('desparam = $$!despar')
    endif

    !size           = !virtualFitting.size
    if !size.size().gt(0) then
      !lines.append('!fsize = object ARRAY()')
      do !j from 1 to !size.size()
        !lines.append('!fsize.append($!size[$!j])')
      enddo
      !lines.append(':size = $$!fsize')
    endif

    !mdsancref      = !virtualFitting.mdsancref
    if !mdsancref.size().gt(0) then
      !lines.append('!ancref = object ARRAY()')
      do !j from 1 to !mdsancref.size()
        !lines.append('!ancref.append($!mdsancref[$!j])')
      enddo
      !lines.append(':mdsancref = $$!ancref')
    endif

    !mdsconnect     = !virtualFitting.mdsconnect
    if !mdsconnect.size().gt(0) then
      !lines.append('!connect = object ARRAY()')
      do !j from 1 to !mdsconnect.size()
        !lines.append('!connect.append($!mdsconnect[$!j])')
      enddo
      !lines.append('!!ce.:mdsconnect = !connect')
    endif

    !mdsposnum      = !virtualFitting.mdsposnum
    if !mdsposnum.size().gt(0) then
      !lines.append('!posnum = object ARRAY()')
      do !j from 1 to !mdsposnum.size()
        !lines.append('!posnum.append($!mdsposnum[$!j])')
      enddo
      !lines.append(':mdsposnum = $$!posnum')
    endif

    !welddata       = !virtualFitting.mdswelddata
    if !welddata.size().gt(0) then
      !lines.append('!fWelddata = object ARRAY()')
      do !j from 1 to !welddata.size()
        !lines.append('!fWelddata.append($!welddata[$!j])')
      enddo
      !lines.append(':mdswelddata = $$!fWelddata')
    endif
  enddo

  --now write out the connection macro to the project MAC directory
  var !projCode proj code
  !evar = !projCode + 'MAC'

  var !macPath evar $!evar

  --make sure that the MAC directory exists
  !macFile = object FILE(!macPath)
  if !macFile.exists().not() then
    !!alert.error('the current project does not have a $!evar directory which is required to store inter db macros. Hanger creation has not completed correctly')
    return FALSE
  endif

  --now look for the hanger macro directory within the mac directory
  var !hangMacDir evar mdsHangerMacros

  --make sure that the hanger macro directory exists
  !hangMacFile = object FILE(!hangMacDir)
  if !hangMacFile.exists().not() then
    !!alert.error('the current project does not have a $!hangMacDir directory which is required to store hanger macros. Hanger creation has not completed correctly')
    return FALSE
  endif

  !fileName = !hangMacDir + |\| + !virtualFitting.name.after('/').before('/') + '-connection.mac'
  !file = object FILE(!fileName)

  --if the filename already exists then we have to create a new name, doesn't matter what the increment is on the file name
  --because the macro management tool will only order the files in date time order as it is stored in the file
  if !file.exists() then
    do !i
      !fileName = !hangMacDir + |\| + !virtualFitting.name.after('/').before('/') + '-$!i' + '-connection.mac'
      !file = object FILE(!fileName)
      if !file.exists() then
        skip
      else
        break
      endif
    enddo
  endif

  !file.writefile('OVERWRITE', !lines)

  return TRUE

endmethod

--copy the current virtual fitting object and return a new virtual fitting object that is owned the !steel
define method .copyFitting(!steel is DBREF, !newName is STRING) is MDSINTERFACEVIRTUALFITTING

  !newFitting = object MDSINTERFACEVIRTUALFITTING(!steel)
  !newFitting = !this
  !newFitting.owner = !steel

  --get the owning stru
  !owner = !steel
  do
    !owner = !owner.owner
    handle ANY
      break
    endhandle

    if !owner.type.eq('STRU') then
      !newFitting.owningStru = !owner
      break
    endif
  enddo

  !newFitting.name = !newName
  !newFitting.zDistThrough(!this.getPosition())
  return !newFitting

endmethod

define method .deleteMacro(!attaName is STRING) is BOOLEAN

  if !attaName.substring(1,1).neq('/') then
    !atta = '/' + !attaName
  else
    !atta = !attaName
  endif

  --construct the fitting names
  !fitt1Name = !atta + '/FITT/H1'
  !fitt2Name = !atta + '/FITT/H2'

  --get the owning steel reference
  !hang1 = !atta + '/H1'
  !hang2 = !atta + '/H2'
  !hang1.dbref()
  handle ANY
    !owningSteel1 = 'owner of ' + !fitt1Name
  elsehandle NONE
    !owningSteel1 = !hang1.dbref().:mdscivref[1].fullname
    handle ANY
    endhandle

    --ensure that !owningSteel is written in one form or another
    if !owningSteel1.eq('') then
      !owningSteel1 = 'owner of ' + !fitt1Name
    endif
  endhandle

  !writeHanger2 = TRUE
  !hang2.dbref()
  handle ANY
    !owningSteel2 = 'owner of ' + !fitt2Name
  elsehandle NONE
    --certain types such as a type licad hanger with a load of 10 or above create a hanger with 2 hanger members
    --in this case civref does not exist for this type and nor will a fitting. we do not need to write out the hanger2 deletemacro
    --lines in this case
    !owningSteel2 = !hang2.dbref().:mdscivref[1].fullname
    handle (2,759)
      !writeHanger2 = FALSE
    elsehandle NONE
      --ensure that !owningSteel is written in one form or another
      if !owningSteel2.eq('') then
        !owningSteel2 = 'owner of ' + !fitt2Name
      endif
    endhandle
  endhandle

  --create an array of macro lines for the delete operation
  !lines = object ARRAY()

  --add a line that will act as a flag to enable us to tell whether or not a file needs to be run in
  !lines.append('!macrostatus = |PENDING|')

  --add a type line so that we can tell what the macro is supposed to be doing
  !lines.append('!macrotype = |DELETE|')

  --add an atta line so that we can tell which atta is being updated
  !lines.append('!attaName = |$!atta|')
  !lines.append('handle any')
  !lines.append('endhandle')

  --add a date time line that can be read into a date time object in the macro management form
  !dateTime = object DATETIME()
  !year = !dateTime.year().string()
  !month = !dateTime.month().string()
  !date = !dateTime.date().string()
  !hour = !dateTime.hour().string()
  !minute = !dateTime.minute().string()
  !second = !dateTime.second().string()
  !dateTimeString = !year + ',' + !month + ',' + !date + ',' + !hour + ',' + !minute + ',' + !second
  !lines.append('!dateTime = ' + '|$!dateTimeString|')

  --navigate to the support steelwork and add its reference into the macro
  --note that we will check for whether or not this reference exists in the macromanagement app
  !lines.append('--owning steelwork 1')
  !lines.append(!owningSteel1)
  --now add lines to navigate to and delete fitting 1 if it exists
  !lines.append('--navigate to fitting and delete')
  !lines.append('!!ce = $!fitt1Name')
  !lines.append('handle (2,109)')
  !lines.append('elsehandle NONE')
  !lines.append('delete fitt')
  !lines.append('endhandle')

  if !writeHanger2 then
    --navigate to the support steelwork and add its reference into the macro
    --note that we will check for whether or not this reference exists in the macromanagement app
    !lines.append('--owning steelwork 2')
    !lines.append(!owningSteel2)
    !lines.append('handle (2,109)')
    !lines.append('endhandle')

    --now add lines to navigate to and delete fitting 1 if it exists
    !lines.append('--navigate to fitting and delete')
    !lines.append('!!ce = $!fitt2Name')
    !lines.append('handle (2,109)')
    !lines.append('elsehandle NONE')
    !lines.append('delete fitt')
    !lines.append('endhandle')
  endif

  --now look for the hanger macro directory within the mac directory
  var !hangMacDir evar mdsHangerMacros

  --make sure that the hanger macro directory exists
  !hangMacFile = object FILE(!hangMacDir)
  if !hangMacFile.exists().not() then
    !!alert.error('the current project does not have a $!hangMacDir directory which is required to store hanger macros. Hanger creation has not completed correctly')
    return FALSE
  endif

  !fileName = !hangMacDir + |\| + !attaName + '-delete.mac'
  !file = object FILE(!fileName)

  --if the filename already exists then we have to create a new name, doesn't matter what the increment is on the file name
  --because the macro management tool will only order the files in date time order as it is stored in the file
  if !file.exists() then
    do !i
      !fileName = !hangMacDir + |\| + !virtualFitting.name.after('/').before('/') + '-$!i' + '-connection.mac'
      !file = object FILE(!fileName)
      if !file.exists() then
        skip
      else
        break
      endif
    enddo
  endif

  !file.writefile('OVERWRITE', !lines)

  return TRUE

endmethod

define method .renameMacro(!attaName is STRING, !newName is STRING) is BOOLEAN

  if !attaName.substring(1,1).neq('/') then
    !atta = '/' + !attaName
  else
    !atta = !attaName
  endif

  if !newName.substring(1,1).neq('/') then
    !new = '/' + !newName
  else
    !new = !newName
  endif

  --construct the fitting names
  !fitt1Name = !atta + '/FITT/H1'
  !fitt2Name = !atta + '/FITT/H2'

  --construct the new fitting names
  !newFittName1 = !new + '/FITT/H1'
  !newFittName2 = !new + '/FITT/H2'


  --get the owning steel reference (by now the software has modified the old attaname to the new one
  --so we need the !new name in building up the reference otherwise we get an unset reference
  !hang1 = !new + '/H1'
  !hang2 = !new + '/H2'

  !hang1.dbref()
  handle ANY
    !owningSteel1 = 'owner of ' + !fitt1Name
  elsehandle NONE
    !owningSteel1 = !hang1.dbref().:mdscivref[1].fullname
    handle ANY
    endhandle

    --ensure that !owningSteel is written in one form or another
    if !owningSteel1.eq('') then
      !owningSteel1 = 'owner of ' + !fitt1Name
    endif

    --need to update the mdsTREF UDA with the new fitting name
    !hang1.dbref().:MDSTREF = !newFittName1

  endhandle

  !writeHanger2 = TRUE
  !hang2.dbref()
  handle ANY
    !owningSteel2 = 'owner of ' + !fitt2Name
  elsehandle NONE
    --certain types such as a type licad hanger with a load of 10 or above create a hanger with 2 hanger members
    --in this case civref does not exist for this type and nor will a fitting. we do not need to write out the hanger2 deletemacro
    --lines in this case
    !owningSteel2 = !hang2.dbref().:mdscivref[1].fullname
    handle (2,759)
      !writeHanger2 = FALSE
    elsehandle NONE
      --ensure that !owningSteel is written in one form or another
      if !owningSteel2.eq('') then
        !owningSteel2 = 'owner of ' + !fitt2Name
      endif
    endhandle

    --need to update the mdsTREF UDA with the new fitting name
    !hang2.dbref().:MDSTREF = !newFittName2

  endhandle

  --create an array of macro lines for the delete operation
  !lines = object ARRAY()

  --add a line that will act as a flag to enable us to tell whether or not a file needs to be run in
  !lines.append('!macrostatus = |PENDING|')

  --add a type line so that we can tell what the macro is supposed to be doing
  !lines.append('!macrotype = |RENAME|')

  --add an atta line so that we can tell which atta is being updated
  !lines.append('!attaName = |$!atta|')
  !lines.append('handle any')
  !lines.append('endhandle')

  --add an atta line so that we can tell which atta is being updated
  !lines.append('!newAttaName = |$!new|')
  !lines.append('handle any')
  !lines.append('endhandle')

  --add a date time line that can be read into a date time object in the macro management form
  !dateTime = object DATETIME()
  !year = !dateTime.year().string()
  !month = !dateTime.month().string()
  !date = !dateTime.date().string()
  !hour = !dateTime.hour().string()
  !minute = !dateTime.minute().string()
  !second = !dateTime.second().string()
  !dateTimeString = !year + ',' + !month + ',' + !date + ',' + !hour + ',' + !minute + ',' + !second
  !lines.append('!dateTime = ' + '|$!dateTimeString|')

  --navigate to the support steelwork and add its reference into the macro
  --note that we will check for whether or not this reference exists in the macromanagement app
  !lines.append('--owning steelwork 1')
  !lines.append(!owningSteel1)
  --now add lines to navigate to and rename fitting 1 if it exists
  !lines.append('!!ce = $!fitt1Name')
  !lines.append('handle (2,109)')
  !lines.append('elsehandle NONE')
  !lines.append('name $!newFittName1')
  --now set the cref
  !cref = 'cref ' + !new + '/H1' + ' tail'
  !lines.append(!cref)
  !lines.append('handle any')
  !lines.append('endhandle')
  !lines.append('endhandle')

  if !writeHanger2 then
    --navigate to the support steelwork and add its reference into the macro
    --note that we will check for whether or not this reference exists in the macromanagement app
    !lines.append('--owning steelwork 2')
    !lines.append(!owningSteel2)
    !lines.append('handle (2,109)')
    !lines.append('endhandle')
    --now add lines to navigate to and rename fitting 2 if it exists
    !lines.append('!!ce = $!fitt2Name')
    !lines.append('handle (2,109)')
    !lines.append('elsehandle NONE')
    !lines.append('name $!newFittName2')
    --now set the cref
    !cref = 'cref ' + !new + '/H2' + ' tail'
    !lines.append(!cref)
    !lines.append('handle any')
    !lines.append('endhandle')
    !lines.append('endhandle')
  endif

  --now look for the hanger macro directory within the mac directory
  var !hangMacDir evar mdsHangerMacros

  --make sure that the hanger macro directory exists
  !hangMacFile = object FILE(!hangMacDir)
  if !hangMacFile.exists().not() then
    !!alert.error('the current project does not have a $!hangMacDir directory which is required to store hanger macros. Hanger creation has not completed correctly')
    return FALSE
  endif

  !fileName = !hangMacDir + |\| + !attaName + '-rename-to-' + !newName + '.mac'
  !file = object FILE(!fileName)

  --if the filename already exists then we have to create a new name, doesn't matter what the increment is on the file name
  --because the macro management tool will only order the files in date time order as it is stored in the file
  if !file.exists() then
    do !i
      !fileName = !hangMacDir + |\| + !virtualFitting.name.after('/').before('/') + '-$!i' + '-connection.mac'
      !file = object FILE(!fileName)
      if !file.exists() then
        skip
      else
        break
      endif
    enddo
  endif

  !file.writefile('OVERWRITE', !lines)

  return TRUE

endmethod
