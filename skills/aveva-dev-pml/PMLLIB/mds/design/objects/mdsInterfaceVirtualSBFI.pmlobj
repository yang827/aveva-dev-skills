-- Define Object
define object MDSINTERFACEVIRTUALSBFI

  --mimic the members of a steelwork fitting object
  --standard members
  member .name is STRING
  member .type is STRING
  member .lock is BOOLEAN

  --need to make this a string of the format '!!pS0001CMPF', tried having this as an mdsInterfaceVirtualCMPF object
  --but it is too difficult to maintain an instance of this object here, the string is therefore a link to
  --the global object
  member .owner is MDSINTERFACEVIRTUALCMPF

  member .description is STRING
  member .function is STRING
  member .purpose is STRING
  member .gtype is STRING
  member .number is REAL
  member .desparam is ARRAY
  member .built is BOOLEAN
  member .shop is BOOLEAN
  member .arrive is REAL
  member .delPosition is POSITION
  member .zDirection is DIRECTION
  member .bangle is REAL
  member .cref is DBREF
  member .grade is REAL
  member .ispec is DBREF
  member .firesistance is REAL
  member .inref is DBREF
  member .spref is DBREF
  member .matref is DBREF

  --mds required UDA's
  member .mdsAncRef is ARRAY
  member .mdsPConn is ARRAY

  --world data
  member .position is POSITION

  --store a list of virtual SBFI objects
  member .sbfi is ARRAY

endobject

define method .mdsInterfaceVirtualSBFI(!cmpf is MDSINTERFACEVIRTUALCMPF, !name is STRING)

  --populate the object using the current steelwork member to get initial position etc
  !this.position = !cmpf.getPosition()
  !this.owner = !cmpf
  !this.name = !name
  !delp = object POSITION('E0 N0 U0')
  !zDir = !cmpf.owner.orientation.zDir().string().before('WRT')
  !zDirString = !zDir + ' WRT ' + !cmpf.owner.string()
  !this.zDirection = object DIRECTION(!zDirString)
  !this.setDelpos(!delp)

endmethod

define method .mdsInterfaceVirtualSBFI(!cmpf is DBREF, !sbfi is DBREF)

  --populate the object using an existing subfitting (for example in modify mode)
  !listOfAttributes = !sbfi.attributes()

  do !i from 1 to !listOfAttributes.size()
    if !listOfAttributes[$!i].trim().upcase().eq('OWNER') then
      skip
    endif

    if !listOfAttributes[$!i].substring(1,1).eq(':') then
      --we have a uda so we need to strip the : from it
      !udaName = !listOfAttributes[$!i].substring(2)
      !this.$!udaName = !sbfi.$!listOfAttributes[$!i]
      handle ANY
      endhandle
    else
      !this.$!listOfAttributes[$!i] = !sbfi.$!listOfAttributes[$!i]
      handle ANY
      endhandle
    endif
  enddo


endmethod

--we need dummystring here because  both versions of the constructor use dbrefs
define method .mdsInterfaceVirtualSBFI(!fitting is DBREF, !dummyString is STRING)

  --populate the object using an existing fitting (for example in modify mode)
  !listOfAttributes = !fitting.attributes()

  do !i from 1 to !listOfAttributes.size()
    if !listOfAttributes[$!i].substring(1,1).eq(':') then
      --we have a uda so we need to strip the : from it
      !udaName = !listOfAttributes[$!i].substring(2)
      !this.$!udaName = !fitting.$!listOfAttributes[$!i]
      handle ANY
      endhandle
    else
      !this.$!listOfAttributes[$!i] = !fitting.$!listOfAttributes[$!i]
      handle ANY
      endhandle
    endif
  enddo

endmethod

define method .getPosition() is POSITION

  --we need to return the position that has been altered by delpos and zdist
  --get the owning steelworks z direction and posstart
  !pos1 = !this.position
  !zDir = object DIRECTION('N wrt /*')

  !pv1 = object POINTVECTOR(!pos1, !zDir)

  --get the orientation of the owning panel so that we can apply delpos to it
  !oriXdir = !this.owner.owner.orientation.wrt( /* ).xDir()
  !oriYdir = !this.owner.owner.orientation.wrt( /* ).yDir()
  !oriZdir = !this.owner.owner.orientation.wrt( /* ).zDir()

  --get the offset values from delpos
  !delpX = !this.delPosition.east
  !delpY = !this.delPosition.north
  !delpZ = !this.delPosition.up

  --offset the initial position through xyz to get the delpos altered position
  !pv1.direction = !oriXdir
  !pv1 = !pv1.offset(!delpX)
  !pv1.direction = !oriYdir
  !pv1 = !pv1.offset(!delpY)
  !pv1.direction = !oriZdir
  !pv1 = !pv1.offset(!delpZ)

  !position = !pv1.position.wrt( /* )

  return !position

endmethod

define method .getDelpos() is POSITION

  return !this.delPosition

endmethod

define method .setDelpos(!delpos is POSITION)

  --!owningStru = !this.owningStru
  !up = !delpos.up
  handle ANY
    !up = !this.delPosition.up
    if !up.unset() then
      !up = 0
    endif
  endhandle

  !east = !delpos.east
  handle ANY
    !east = !this.delPosition.east
    if !east.unset() then
      !east = 0
    endif
  endhandle

  !north = !delpos.north
  handle ANY
    !north = !this.delPosition.north
    if !north.unset() then
      !north = 0
    endif
  endhandle

  !posstring = 'E' + !east.string() + ' N' + !north.string() + ' U' + !up.string()
  !position = object POSITION(!posstring)
  	
  !this.delPosition = !position

endmethod
