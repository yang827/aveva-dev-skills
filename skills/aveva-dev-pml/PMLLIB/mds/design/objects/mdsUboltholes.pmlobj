------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  adddim(DBREF)                    -
--  addlabel()                       -
--  addpoint()                       -
--  clearaids()                      -
--  drawaids()                       -
--  getdir()                         DIRECTION
--  getholedata(REAL)                STRING
--  getuniquename(STRING)            STRING
--  getuniquenumber(REAL)            STRING
--  mdsUBoltHoles(DBREF,COMUNITS)    -
--  reorder()                        -
--  setunittext(REAL)                STRING
--  splitdata(STRING)                -
--

-- Define Object
define object MDSUBOLTHOLES

  member .ubolt is DBREF
  member .supportnumber is STRING
  member .supportname is STRING
  member .holes is ARRAY
  member .position is POSITION
  member .direction is DIRECTION
  member .diameter is REAL
  member .ppoint is REAL
  member .aidnumber is STRING
  member .ldim is DBREF
  member .glab is DBREF
  member .layer is DBREF
  member .units is COMUNITS


endobject

-- Constructor method for getting data on a single ubolt
--------------------------------------------------------------------------------
-- get the data for bolt holes by looping through the ppoints and finding any
-- with a purpose set to 'HOLE'
-- adds each hole data as a string in the holes array
-- if in Design, it draws a cross at the ppoint location
define method .mdsUBoltHoles(!ubolt is DBREF,!units is COMUNITS)

  !this.units = !units
  !save = !!ce

  !this.ubolt = !ubolt
  !this.supportname = !this.ubolt.namn
  do !a values !this.ubolt.ppls
    if !this.ubolt.ppur[!a].eq('HOLE') then
      !this.holes.append(!this.getholedata(!a) & ',' & !this.getuniquenumber(!this.holes.size()))
    endif
  enddo

  !banner = banner
  --<wd>may2007<mds12>
  --  if !banner.name.upcase().match('DESIGN').gt(0 ) or !banner.name.upcase().match('OUTFITTING').gt(0 ) then
  if !banner.name.upcase().match('DESIGN').gt(0 ) or !banner.short.upcase().match('OUTFITTING MK').gt(0 ) then
    --<wd>may2007<mds12>
    !this.clearaids()
    !this.drawaids()
  endif

  !!ce = !save

endmethod
--------------------------------------------------------------------------------



--------------------------------------------------------------------------------
-- method to gather the data for a particular hole and return it in a string
define method .getholedata(!ppoint is REAL)is STRING

  !this.direction = !this.ubolt.pdir[!ppoint].wrt(/* )
  !this.position  = !this.ubolt.ppos[!ppoint].wrt(/* )
  !this.diameter  = !this.ubolt.prop.bdia.real()
  handle any
    !this.diameter = !this.ubolt.prop.dia.real()
    handle any
      !!alert.error('unable to get bolt diameter property for $!this.supportname' )
      !this.diameter = 0
    endhandle
  endhandle

  return !this.position & ',' & !this.diameter & ',' & !this.direction & ',' & !ppoint


endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to draw hole centres in Design
define method .drawaids()


  do !a values !this.holes

    !this.splitdata(!a)

    !pv = object POINTVECTOR()
    !pv.position = !this.position
    !pv.direction = !this.direction
    !plane = !pv.plane()
    !x = !plane.orientation.xdir()
    !y = !plane.orientation.ydir()
    aid Cyli number $!this.aidnumber diam 2 height $!this.diameter at $!pv.position ori z is $!x filled on
    aid Cyli number $!this.aidnumber diam 2 height $!this.diameter at $!pv.position ori z is $!y filled on

  enddo

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
-- method to clear the graphical aids drawn in Design
define method .clearaids()

  do !a values !this.holes
    !this.splitdata(!a)
    aid  clear cyli $!this.aidnumber
    handle any
    endhandle
  enddo

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .splitdata(!hole is STRING)

  !this.position  = !hole.split(',')[1].position()
  !this.diameter  = !hole.split(',')[2].real()
  !this.direction = !hole.split(',')[3].direction()
  !this.ppoint    = !hole.split(',')[4].real()
  !this.aidnumber = !hole.split(',')[5]

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .getuniquenumber(!add is REAL)is STRING

  !real   = (!this.ubolt.refno.string().replace('/','').replace('=','').real() + (!add * 9000)) / 9000
  !string = !real.string('d0')
  return !string

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
-- method to add a dimension to a ubolt atta
-- assumes that the direction of view etc has been sorted out
define method .adddim(!layer is DBREF)

  !this.layer = !layer
  !save = !!ce

  if !this.holes.size().eq(0) then
    return
  endif


  new ldim after last mem
  handle(2,113)
    new ldim
  endhandle
  !this.ldim = !!ce
  !!ce.name = !this.getuniquename('UBOLT_DIM')
  !dir = !this.getdir().string().before('WRT')
  dir $!dir
  handle (64,332)
    delete ldim
    !!ce = !save
    return
  endhandle
  do !a values !this.holes
    !this.splitdata(!a)
    !this.addpoint()
  enddo

  ldim
  !this.reorder()
  handle ANY
    -- temporary fix to get round adding a new method
  endhandle


  -- add the label
  !this.addlabel()

  !!ce = !save

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .getuniquename(!text is STRING)is STRING

  !save = !!ce
  !name = !this.layer.name
  if !name.match('/').neq(1) then
    !name = '/' & !this.layer.refno
  endif
  do !a
    !name = !this.layer.name & !text & !a
    !!ce = !name.dbref()
    handle NONE
    elsehandle(2,109)
      break
    endhandle
  enddo

  !!ce = !save
  return !name

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .getdir()is DIRECTION

  if !this.holes.size().lt(2) then
    --!!alert.error('Insufficient ppoints to calculate direction')
    return n
  else
    !pos1 = !this.holes[1].split(',')[1].position()
    !pos2 = !this.holes[2].split(',')[1].position()
    return !pos1.direction(!pos2)
  endif

endmethod
--------------------------------------------------------------------------------



--------------------------------------------------------------------------------
-- method to add a dimension point to a an atta ppoint
-- assumes that the direction of view etc has been sorted out
define method .addpoint()

  new dppt ddnm $!this.ubolt
  nppt $!this.ppoint

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .addlabel()

  new glab after last mem
  handle(2,113)
    new glab
  endhandle
  on $!this.ubolt
  !!ce.name = !this.getuniquename('UBOLT_LAB')
  !this.glab = !!ce
  nppt $!this.ppoint
  !holediameter = nint(!this.diameter + 2)
  !newdia = !this.setunittext(!holediameter)
  btext |$!<newdia> HOLE#/TYP|
  xypos -25 25
  lock

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .setunittext(!value is REAL)is STRING

  !return = !value.string()
  if (!this.units.isImperialSavedDist()) then
    onerror golabel /units
    -- Temporarily Set Distance Units Back to the Required Output units
    !distIndex = !this.units.getDimensionIndex('DIST')

    !dist = !this.units.savedUnits[!distIndex]
    $!dist distance
    !mmval = $!value
    -- $P new value  is $!mmval
    !return  = !mmval.distance(true,false,true,32,true).replace(' ','')
    -- Set Distance Units Back to Metric
    label /units
    onerror return
    UNITS MM Distance
  endif

  return !return

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .reorder()

  !save = !!ce

  -- we want the dimension to be down or left
  -- if the dimension direction is the same as the direction of the right hand side then
  -- it needs to be reversed The same logic can be applied if its from -90 to +90


  -- get the ldim dir
  !dir = !!ce.dir
  -- get the direction of the right hand side of the view
  var !viewdir viewdir r
  !newdir = !viewdir.direction()
  -- find the angle compared to the direction of the right hand side
  !angle = !newdir.angle(!dir)
  -- if the direction is anywhere in the right hand hemisphere then reverse it
  if !angle.leq(-90).or(!angle.geq(90)) then
    -- its ok
  else
    !dir = !dir.opposite()
  endif
  -- reset the direction
  !dimdir = !dir.string().before('WRT')
  dir $!dimdir

  !!ce = !save


endmethod
