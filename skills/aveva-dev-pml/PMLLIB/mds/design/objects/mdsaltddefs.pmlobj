--------------------------------------------------------------------------------
--   Type:  Object Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  DESIGN
--
--------------------------------------------------------------------------------
-- Description:
--
-- PML Object to determine the MDS Design Data etc... for the MDS ZONE IDENTITIES etc..
-- from the MDS12 DEFAULTS PARAGON CATALOGUE Database CONVERTED from the latest MDS11.6*
-- version of the MDS DEFAULTS FILE "%MDSDFLTS%/DES-SUPP-ID" from the MASTER PDMS
-- Project "MDS"
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsaltddefs()                    -
--
define object MDSALTDDEFS

  -- Overall MDS DESCRIPTION Check for the MDS DESIGN Application
  member .altdcheck is BOOLEAN

  -- Error text for missing MDS Standard DESCRIPTIONS CATALOGUES
  member .altderrortext is STRING

  -- Continuation Error type found if ANY
  -- <1>--ALLOK   -- <ALLOW Entry to MDS DESIGN Apps>
  -- <2>--WARNING -- <ADVISE USER of WARNING and ALLOW Entry to MDS DESIGN Apps>
  -- <3>--ERROR   -- <ADVISE USER of ERROR and ABORT Entry to MDS DESIGN Apps>
  member .altderrortype is STRING

  -- Stores the MDS FRAMEWORK ALTERNATIVE CODE names in an ARRAY member
  member .altdarray is ARRAY

  -- Stores the MDS FRAMEWORK FIXED (FCOD) and ALTERNATIVE (ACOD) CODE values in an ARRAY member
  member .altdvalues is ARRAY
  -- End object
endobject
--
--------------------------------------------------------------------------------
-- Constructor Method .mdsaltddefs()
-- Arguments:
--
-- Return:
--
--------------------------------------------------------------------------------
-- Constructor Method
--
define method .mdsaltddefs()

  -- FROM the /MDS/STRUCTURE/DEFAULTS PARAGON CATALOGUE for the PDMS Project
  -- MDS DESIGN APPLICATION DEFAULTS. Determine ALL of the "MDSACTIVE" PARAGON CATALOGUE
  -- DATA elements representing the MDS FRAMEWORK STANDARDS "ALTERNATIVE DESCRIPTION CODES"
  -- e.g. .../ALTD -- <MDS Framework ALTERNATIVE CODE>
  -- LOAD the Global Variables "!!mdsaltd<MDS Framework Fixed Code>" accordingly
  -- for ALL MDS FRAMEWORK STANDARD types <CT*, DT*, FT*, GT09 and GT10> ONLY
  --
  -- NOTE:
  -- The MDS FRAMEWORK STANDARD types ***NOT INCLUDED*** in the ALTD CODES are
  -- GT05, SPECIAL and VT*
  --

  -- Initialise Variable Array for the 5 PARAGON CATALOGUES
  !mdscatas = ARRAY()
  !mdscatas.append(/MDS/STRUCTURE/DEFAULTS )
  !errorstr = ||
  !validstr = ||
  !mdstest  = TRUE
  !mdsarray = ARRAY()
  --$P *******************************************************************************
  --clock
  --clock init

  -- CHECK the /MDS/STRUCTURE/DEFAULTS PARAGON CATALOGUE exist
  do !indx indices !mdscatas
    !mdsindx = 0
    !mdscata = !mdscatas[!indx]
    handle NONE
      !mdsindx = !mdsindx + 1
      !mdsarray.append(!mdscata )
      !validstr   = !validstr & | | & !mdscata.name

    elsehandle ANY
      !errorstr   = !errorstr & | | & !mdscata.name
      !mdstest = FALSE

    endhandle
  enddo

  -- SET the object members .altdcheck and .errortext
  if (!mdstest.not()) then
    !this.altdcheck = FALSE
    !this.altderrortext    = |WARNING: The following MDS DEFAULTS Catalogue(s) | & !errorstr.trim() & | do NOT exist|
    !this.altderrortype    = |WARNING|

  else
    !this.altdcheck = TRUE
    !this.altderrortext    = !validstr.trim()
    !this.altderrortype    = |ALLOK|

  endif

  -- Return if !mdsarray() is EMPTY and UNSET
  if (!mdsarray.empty()) or (!mdsarray.unset()) then
    !this.altdcheck = FALSE
    !this.altderrortext    = |ERROR: The MDS DEFAULTS PARAGON Catalogues | & !errorstr.trim() & | do NOT exist|
    !this.altderrortype    = |ERROR|
    return

  endif

  ----------------------------------------------------------------------
  --
  -- ONLY PROCESS each of the VALID PARAGON CATALOGUES found to DETERMINE
  -- the MDS FRAMEWORK STANDARD Alternative Description Codes<ALTD>
  -- i.e. The CATA elements in the !mdsarray variable
  --
  ----------------------------------------------------------------------

  -- Initialise the Collection Object data for the "ACTIVE" PARAGON CATALOGUE
  -- SECTION elements in the current PDMS Project
  !type  = |SECTION|
  !filt  = object EXPRESSION(':mdsactive eq TRUE')
  !scope = ARRAY()
  !scope.appendarray(!mdsarray)

  -- Collect ALL of the DESPARS DATA Elements
  !sect  = object COLLECTION()
  !sect.filter(!filt)
  !sect.scope(!scope)
  !sect.type(!type)

  -- SECTION Collection Results Array
  !results = !sect.results()
  if (!results.size().gt(0)) then
    -- Process the MDS FRAMEWORK Standard ALTERNATIVE DESCRIPTION CODE DATA elements in the !results Array
    -- SET ALL the Global Variables fo each of the MDS Standard CLIENT DESCRIPTIONS and CODES

    -- Process the ALTERNATIVE DESCRIPTION CODES<ALTD> DTSE elements
    -- Initialise the Collection Object data
    !type = |DATA|
    !filt = object EXPRESSION('DKEY eq |FCOD|or DKEY eq |ACOD|')
    !altd = ARRAY()
    !altd.appendarray(!results)

    -- Collect ALL of the ALTERNATIVE DESCRIPTION CODES<ALTD>
    !data  = object COLLECTION()
    !data.filter(!filt)
    !data.scope(!altd)
    !data.type(!type)

    -- DATA Collection Results Array
    !altdresults = !data.results()
    !altdarrsize = !altdresults.size()

    -- GET the DATA Values, CREATE and SET the MDS ALTD GLOBAL Variables
    do !indz by 2 from 1 to !altdarrsize
      -- The index !indz     = the FCOD data dbref -- ( MDS FIXED CODE, e.g CT01-1-1 )
      -- The index !indz + 1 = the ACOD data dbref -- ( MDS ALTD CODE, e.g. CT01-1CrossBar-MatSize1 etc... )

      -- GET the MDS Standard MDS ALTD Global Variable NAME
      !altdvname   = $!altdresults[$!indz].pprop
      !altdvarname = !altdvname.replace(|-|,||).trim()
      !altdvarname = |!!mdsaltd| & |$!<altdvarname>|

      -- GET the MDS Standard MDS ALTD Global Variable VALUE
      !nextindex = !indz + 1
      !altdvalue = $!altdresults[$!nextindex].pprop

      -- SET the Individual MDS FRAMEWORK STANDARD "ALTD" Global Variable
      $!altdvarname = |$!<altdvalue>|
      --$P *** $!altdvarname = |$!<altdvalue>| ***

      -- Append the MDS FRAMEWORK FIXED (FCOD) and ALTERNATIVE (ACOD) CODE values in the ARRAY member .altdvalues e.g FCOD\ACOD
      !altdvaluestr = |$!<altdvname>| & |\| & |$!<altdvalue>|
      !this.altdvalues.append(|$!<altdvaluestr>|)

      -- Append each Individual MDS FRAMEWORK STANDARD "ALTD" Global Variable into the FORM member .altdarray
      !this.altdarray.append(|$!altdvarname|)

    enddo

  else
    -- SET the ERROR if NO "MDSACTIVE"/VALID SECTION elements found
    -- in ANY of the VALID MDS DEFAULTS PARAGON CATALOGUES found
    !this.altdcheck = FALSE
    !this.altderrortext    = |ERROR: The MDS DEFAULTS Catalogue(s) | & !validstr.trim() & | do NOT contain ANY VALID or ACTIVE MDS Standards |
    !this.altderrortype    = |ERROR|

  endif

  --clock read elapsed
  --$P *** FINISHED LOADING MDS STANDARD *** MDS FRAMEWORK ALTERNATIVE DESCRIPTION CODES ***
  --$P *************************************************************************************

  --clock

endmethod
--
--------------------------------------------------------------------------------
--
--define method

--endmethod
--
--------------------------------------------------------------------------------
--
