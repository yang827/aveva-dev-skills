--
--------------------------------------------------------------------------------
-- Description:
--
-- PML Object to read and store geometry defaults from datasets in CATALOGUE for the MDS Ancillary Standards
-- CATA /MDS/ATTA/DEFAULTS
-- Project "MDS"
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  MdsAncGeomdflts(DBREF)           -
--  String()                         STRING
--
define object mdsancgeomdflts

    -- atta db reference
    member .Ref is DBREF

    -- ancillary MDS code
    member .Code is STRING

    -- Open end clearance from RPROP OEND of /MDS/ATTA/../../../FRMW
    member .Oend is REAL

    -- Closed end clearance from RPROP CEND of /MDS/ATTA/../../../FRMW
    member .Cend is REAL

    -- framework clearance option from PROP CLGE ( GEOM or CLIN)
    member .Clge is STRING

    -- dataset ref
    member .Dtre is DBREF

-- end of object definition
endobject


-- load data for passed ancillary
define method .MdsAncGeomdflts(!Anc is DBREF)

      -- set format object to make sure the bore is always in mm
      !fmt = object FORMAT()
      !fmt.units = 'MM'
      !fmt.DP = 0
      !fmt.dimension = 'L'

      -- compose dataset name
      !RootName = '/MDS/ATTA/DEFAULTS'
      !code = !anc.prop.desc.replace(' ','-')
        handle ANY
               !Code = STRING()
        endhandle
      !Bore = !Anc.Lbor.String(!Fmt)
        handle ANY
               !Bore = STRING()
        endhandle
      !Dtse = $!rootName/$!Code/$!Bore/FRMW
        handle ANY
        endhandle

      -- get data
      !Clearance = !!MdsOptions.Clear.Val
         handle ANY
             !Clearance = 100mm
         endhandle

      !Oend = !Dtse.rpro.OEND
         handle ANY
               !Oend = !Clearance
         endhandle
      !Cend = !Dtse.Rpro.CEND
         handle ANY
               !Cend = !Clearance
         endhandle
      !Clge = !Dtse.prop.CLGE
         handle ANY
               !Clge = 'GEOM'
         endhandle


      -- set object data
      !this.ref = !anc
      !this.code = !Code
      !this.Oend = !Oend
      !this.Cend = !Cend
      !this.Clge = !Clge
      !this.Dtre = !Dtse
         handle ANY
         endhandle

endmethod



-- string method for this object
define method .String() is STRING


    return !this.ref.name


endmethod
