-- Created:   13/04/2005 13:22
--
--
-- Description:
-- Multi Discipline support object for orientating and cutting sctns back to plate surfaces
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  Mdsangsctn(DBREF,DBREF,REAL)     -
--  findends()                       -
--  getdirections()                  -
--  pointvector(REAL,DBREF)          pointvector
--  rotate()                         -
--  setcutbacks()                    -
--

-- Define Object
define object Mdsangsctn

    -- angle to swing the section through
    member .angle is REAL

    -- SCTNs to be trimmed
    member .horizontal is DBREF
    member .vertical is DBREF

    -- ends of SCTN to be trimmed
    member .verticalend is REAL
    member .horizontalend is REAL

    member .horizontaldir is direction
    member .verticaldir   is direction

-- End object
endobject

-- constructor method

---------------------------------------------------------------------------------------------------
-- main constructor method with thre passed parameters
-- !hori is the dbref of the BAR
-- !vert is the dbref of one of the verticals V1 or V2
-- !angle is the angle of rotation. at 90 the legs are vertical above 90 the legs are angled out
-- should not accept angles less than 90 although the routine should work correctly
define method .Mdsangsctn(!hori is DBREF, !vert is DBREF, !angle is REAL )

  !save = !!ce

  !this.horizontal = !hori
  !this.vertical   = !vert
  !this.angle      = !angle
  -- find out which ends are connected
  !this.findends()
  -- get the directions away from the joint
  !this.getdirections()
  -- now go and rotate the member
  !this.rotate()
  -- go and work out the joint angles
  !this.setcutbacks()

  !!ce = !save

endmethod
---------------------------------------------------------------------------------------------------


---------------------------------------------------------------------------------------------------
-- method checks the positions of all four ends to find the ends closest to form a joint
-- sets this. horizontal end and this.verticalend to 0 or 1 (start or end)
define method .findends()

   -- get the poss and pose of the horizontal member
   !poss = !this.horizontal.poss.wrt(/* )
   !pose = !this.horizontal.pose.wrt(/* )
   -- get the poss and pose of the vertical member
   !possv = !this.vertical.poss.wrt(/* )
   !posev = !this.vertical.pose.wrt(/* )
   !distances = ARRAY()
   !ends      = ARRAY()

   -- this lot gets the distances of all four ends relative to each other
   -- its a bit complicated and there is probably an easier way
   -- (I just cant think of it at the time of writing)
   !end = '!poss'
   do !a from 1 to 2
      if !a eq 2 then
        !end = '!pose'
      endif
      !testend = '!possv'
      do !b from 1 to 2
         if !b eq 2 then
           !testend = '!posev'
         endif
         !distances.append($!<end>.distance($!<testend>))
         !ends.append('$!end $!testend')
      enddo
   enddo
   !index = !distances.sortedindices()
   !distances.reindex(!index)
   !ends.reindex(!index)

   !endtext = !ends[1].replace('v','').replace('!poss','0').replace('!pose','1').split()
   !this.horizontalend = !endtext[1].real()
   !this.verticalend   = !endtext[2].real()

endmethod
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
-- get the directions away from the point of rotation
-- Horizontal direction id from the section joint end towards the datum atta
-- Vertical direction is down the vertical section towards the deck
define method .getdirections()

   !pv1 = !this.pointvector(!this.horizontalend,!this.horizontal)
   !pv2 = !this.pointvector(!this.verticalend,!this.vertical)
   !this.horizontaldir = !this.pointvector(!this.horizontalend,!this.horizontal).direction
   !this.verticaldir   = !this.pointvector(!this.verticalend,!this.vertical).direction
   --!this.currentangle = !this.horizontaldir.angle(!this.verticaldir)

endmethod
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
-- this method actually rotates the section
-- surprisingly it seems to work in all cases without the need to apply a sense to the rotation
define method .rotate()

-- find the difference between the current angle and the desired angle
-- work out the new angle
   !ang = !this.horizontaldir.angle(!this.verticaldir)
   !difference = !this.angle - !ang
   !cross = !this.horizontaldir.cross(!this.verticaldir)
   !!ce = !this.vertical
   if !this.verticalend eq 0 then
       rotate thro poss about $!cross by $!difference
   else
       rotate thro pose about $!cross by $!difference
   endif
  !this.getdirections()



endmethod
--------------------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------------------
-- this method sets the drns or drne of the end being rotated
-- the actual direction is the plane formed by the angle bisecting the section directions
define method .setcutbacks()


  !cross = !this.horizontaldir.cross(!this.verticaldir)
  -- construct the angle between the two directions
  !mid = !this.horizontaldir.bisect(!this.verticaldir)
  !planedir = !mid.cross(!cross)
  -- q var !planedir

  !!ce = !this.horizontal
  if !this.horizontalend eq 0 then
        drns $!planedir
  else
       drne $!planedir
  endif

  !!ce = !this.vertical
  if !this.verticalend eq 0 then
      drns $!planedir
  else
      drne $!planedir
  endif


endmethod
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
-- method to return a pointvector from poss to pose or from pose to poss of a sctn
define method .pointvector(!end is REAL, !sctn is DBREF)is pointvector

   !return   = object pointvector()
   !poss     = !sctn.poss.wrt(/* )
   !pose     = !sctn.pose.wrt(/* )
   !startdir = !poss.direction(!pose)
   !enddir   = !pose.direction(!poss)
   if !end.eq(0) then
     !return.position  = !poss
     !return.direction = !startdir
   else
     !return.position  = !pose
     !return.direction = !enddir
   endif

   return !return

endmethod
--------------------------------------------------------------------------------------------------
