-- Define Object
define object mdsassoc
--
-- Object Members

-------------------------------------------------------------------------------
-- Creation MODE for the Current MDS Support
  member .mode is STRING


-- Current MDS Associations Object for the Current MDS Support
--  member .mdsassowl is mdsassowl

-------------------------------------------------------------------------------
-- For use ONLY by the MDS Support Creation mode CURSOR
-- Main Support element !pick1 for the Current MDS Support
  member .pick1 is DBREF

-- Main Support element Inersection !pick1inter for the Current MDS Support
  member .pick1inter is position

-- Main Support element !pick2 for the Current MDS Support
  member .pick2 is DBREF

-- Main Support element Inersection !pick2inter for the Current MDS Support
  member .pick2inter is position

-------------------------------------------------------------------------------
-- For use ONLY by the MDS Support Creation mode CLEARANCE
-- Main Support element !pick3 for the Current
  member .pick3 is DBREF

-------------------------------------------------------------------------------
-- Array of Current MDS Support Members to be Associated with the Main Support elements
  member .mdsmember is ARRAY

-- End object
endobject

---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
-- Constructor Method
define method .mdsassoc()

endmethod
