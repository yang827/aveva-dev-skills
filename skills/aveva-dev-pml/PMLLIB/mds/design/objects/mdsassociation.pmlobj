--
-- Description:
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addAssociation(DBREF)            -
--  assocName()                      STRING
--  associate()                      -
--  associate(ARRAY)                 -
--  associate(DBREF)                 -
--  associate(DBREF,DBREF)           -
--  associated()                     STRING
--  assogp()                         DBREF
--  assogpName()                     STRING
--  assowl()                         DBREF
--  clashSettings()                  ANYDATASET
--  clashSettings(ANYDATASET)        -
--  exists(REAL)                     BOOLEAN
--  interference(REAL)               BOOLEAN
--  item()                           DBREF
--  mdsAssociation()                 -
--  mdsAssociation(DBREF)            -
--  mdsAssociation(DBREF,BOOLEAN)    -
--  mdsAssociation(STRING)           -
--  mdssite()                        DBREF
--  remAssociation(DBREF)            -
--  remAssociations()                -                   Remove all associations from element and update db associations
--  remEmptyGroup()                  -                   Remove association group if created and has no members
--  resolveInterference()            -
--  rest()                           DBREF
--  set()                            BOOLEAN
--  setAssociated(DBREF)             -
--  setAssociated(DBREF,DBREF)       -
--  string()                         STRING
--  stru()                           DBREF
--  suffix(STRING)                   STRING
--  supportName()                    STRING
--  valid(REAL)                      BOOLEAN
--
define object MDSASSOCIATION

  member .itemName is STRING
  member .associated is ARRAY

  member .assoc is ARRAY
  member .checkInterference is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Default constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsAssociation()

  !this.checkInterference = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#]       [R/RW] [Data Type]      [Description]
--    !item     R      DBREF            HANG element or element below STRU hierarchy (usually SCTN)
-- Return:
--   [Data Type]       [Description]
--
------------------------------------------------------------------------

define method .mdsAssociation(!item is DBREF)

  !this.mdsAssociation()

  if (!item.badref()) then
    return
  endif

  !this.itemName = !item.name
  !this.associated = !item.dassci
  !dassos = !item.dassos
  do !restri values !dassos
    !this.assoc.append(!restri.owner)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:  Default constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#]      [R/RW] [Data Type]       [Description]
--   !item     R      DBREF            HANG element or element below STRU hierarchy (usually SCTN)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsAssociation(!item is DBREF, !checkInterference is BOOLEAN)

  !this.mdsAssociation(!item)
  !this.checkInterference = !checkInterference

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#]      [R/RW] [Data Type]        [Description]
--   !item     R      STRING            Name of HANG element or element below STRU hierarchy (usually SCTN)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsAssociation(!itemName is STRING)

  !this.mdsAssociation()
  !this.itemName = !itemName

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .suffix(!type is STRING) is STRING

  return !!mdsAssociationSuffix(!type)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .item() is DBREF

  !item = !this.itemName.dbref()
  handle ANY
    !item = nulref
  endhandle

  return !item

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stru() is DBREF

  !stru = object DBREF('STRU of ' & !this.item())
  handle ANY
    !stru = nulref
  endhandle

  return !stru
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rest() is DBREF

  !rest = object DBREF('REST of ' & !this.item())
  handle ANY
    !rest = nulref
  endhandle

  return !rest
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      .supportName
--
-- Description: Return MDS support name for future association use
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .supportName() is STRING

  -- Return stru name for framework supports (item is SCTN two levels below STRU)
  !stru = !this.stru()
  if (!stru neq nulref) then
    return !stru.name
  endif

  -- Return restrain name if item is a hanger
  !rest = !this.rest()
  if (!rest eq nulref) then
    return ''
  endif

  !restPostfix = '/REST'
  !name = !rest.name.substring(1,!rest.name.length() - !restPostfix.length())
  handle ANY
    return ''
  endhandle

  return !name

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdssite() is DBREF

  !stru = !this.stru()
  if (!stru neq nulref) then
    return !stru.owne.owne
  endif

  !rest = !this.rest()
  if (!rest neq nulref) then
    return object DBREF('SITE of ' & !rest)
  endif

  return nulref

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .assowl() is DBREF


  !assowl = !this.item().dassos.first().owner.owner
  handle ANY
    !site = !this.mdssite()
    !name = !site.name & !this.suffix('ASSOWL')
    !assowl = !name.dbref()
    handle ANY
      !!ce = !site
      new ASSOWL
      !!ce.name = !name
      purp MDS
      !assowl = !!ce
    endhandle
  endhandle

  return !assowl

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .assogp() is DBREF

  !assogp = !this.item().dassos.first().owner.owner
  handle ANY
    !name = !this.assogpName()
    !assogp = !name.dbref()
    handle ANY
      !!ce = !this.assowl()
      new ASSOGP
      !!ce.name = !name
      purp MDS
      !assogp = !!ce
    endhandle
  endhandle

  return !assogp

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Populate object with array of associated elements and create/update db associations.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .associate(!associated is ARRAY)

  !this.associated = !associated
  !this.associate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:  Create/update db association with elements held in object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .associate()

  !same = !!ce

  do !c indices !this.assoc
    !assoc = !this.assoc[!c]
    --get the purpose of the association world. if it's not MDS then return
    var !purp purp of assowl of $!assoc
    if (!purp.neq('MDS')) then
      skip
    endif

    !!ce = !this.assoc[!c]
    handle NONE
      delete ASSOC
    elsehandle ANY
    endhandle
    !this.assoc[!c].delete()
  enddo

  !item = !this.item()
  do !c indices !this.associated
    skip if (!this.interference(!c).not())
    !linked = !this.associated[!c]
    !name = !this.assocName()
    !assogp = !this.assogp()
    !av = object AVEVAASSOCIATION()
    -- to use AVEVAASSOCIATION without error messages, MDB must contain MASTER/ASSOCDEFN database
    if (!av.exists2(!assogp, !item, !linked ).not()) then
      return error 1 '$!av.error[1]'
    endif
    !assoc = !assogp.memb.first()
    !assoc.name = !name
    !this.assoc[!c] = !assoc
  enddo

  !this.remEmptyGroup()

  !!ce = !same
  handle ANY
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Populate object with one associated element and create/update db association.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .associate(!associated is DBREF)

  !this.setAssociated(!associated)
  !this.associate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Populate object with two associated elements and create/update db associations.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .associate(!associated1 is DBREF, !associated2 is DBREF)

  !this.setAssociated(!associated1,!associated2)
  !this.associate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Populate object with two associated elements. Db Association itself is not created/updated.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAssociated(!associated1 is DBREF, !associated2 is DBREF)

  !associations[1] = !associated1
  !associations[2] = !associated2
  if (!associated1.badref().or(!associated2.badref())) then
    !associations.clear()
  endif
  !this.associated = !associations

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Populate object with single associated element. Db Association itself is not created/updated.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAssociated(!associated is DBREF)

  !associations[1] = !associated
  if (!associated.unset()) then
    !associations.clear()
  endif
  !this.associated = !associations

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .assogpName() is STRING

  return !this.supportName() & !this.suffix('ASSOGP')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .assocName() is STRING

  !root = !this.supportName() & !this.suffix('ASSOC')
  do !c from 1
    !name = !root & !c
    !name.dbref()
    handle ANY
      return !name
    endhandle
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .set() is BOOLEAN

  return !this.item().set()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .valid(!index is REAL) is BOOLEAN

  !item = !this.item()
  if (!item.unset()) then
    return false
  endif

  if (!index.unset().or(!index.eq(0))) then
    return false
  endif

  return defined(!this.associated[!index])

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .exists(!index is REAL) is BOOLEAN

  !item = !this.item()
  if (!item.unset()) then
    return false
  endif

  if (!index.unset().or(!index.eq(0))) then
    return false
  endif

  !dassci = !item.dassci

  return defined(!dassci[!index])

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     TRUE if there is physical interference otherwise FALSE
--
------------------------------------------------------------------------

define method .interference(!index is REAL) is BOOLEAN

  if (!this.checkInterference.not()) then
    return true
  endif

  !status = false
  if (!this.valid(!index).not()) then
    return !status
  endif

  !obstr = !this.associated[!index]
  -- do not perform clashcheck on HANGER and return true
  if (!obstr.type.eq('HANG')) then
    return true
  endif
  !item = !this.item()

  !session = current session
  !alpfile = object FILE('%PDMSUSER%\' & 'tmpclashalpfile' & !session.uniqueid)

  -- run clasher
  alpha file /$!alpfile overwrite
  handle ANY
    alpha file end
    alpha file /$!alpfile overwrite
  endhandle

  --store clash settings
  !settings = !this.clashSettings()
  desclash
    override on
    remove obstruction all
    remove exclusion all
    obstruction $!obstr
    limits NONE
    report header off
    report main off
    report summary off
    report graphics off
    report position off
    report HH touch
    include connections
    include touches
    clearance 0mm
    touch overlap 10mm
    touch gap 25mm
    check $!item
    handle ANY
    elsehandle NONE
    endhandle
    var !clash clash count touches
  exit

  alpha file end
  !alpfile.deletefile()

  -- restore clash settings
  !this.clashSettings(!settings)

  !status = !clash.real().boolean()

  return !status

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .resolveInterference()

  if (!this.item().badref()) then
    return
  endif

  do !c indices !this.associated
    if (!this.interference(!c).not()) then
      !this.associated[!c].delete()
    endif
  enddo

  !this.associated.compress()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .associated() is STRING

  !name = ARRAY()
  do !c indices !this.associated
    skip if (!this.exists(!c).not())
    !name.append(!this.associated[!c].namtyp)
  enddo

  !desc = !name.join(' and ')

  return !desc

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .string() is STRING

  !item = !this.objecttype()
  if (!this.item().set()) then
    !item = !this.item().namtyp
    do !c indices !this.associated
      skip if (!this.exists(!c).not())
      !associated[!c] = !this.associated[!c].namtyp
    enddo
    if (defined(!associated)) then
      !item = !item & ' with ' & !associated.join(' and ')
    else
      !item = !item & ' is not associated'
    endif
  endif

  return !item

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:  Append associated element and create/update db associations.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addAssociation(!associated is DBREF)

  !this.associated.append(!associated)
  !this.associate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Remove associated element and update db associations
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remAssociation(!associated is DBREF)

  !index = !this.associated.findfirst(!associated)
  if (!index.unset()) then
    return
  endif

  !this.associated.remove(!index)
  !this.associate()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      remAssociations
--
-- Description: Remove all associations from element and update db associations
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remAssociations()

  !this.associated = object ARRAY()
  !this.associate()

endmethod


------------------------------------------------------------------------
--
-- Method:      remEmptyGroup
--
-- Description: Remove association group if created and has no members
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .remEmptyGroup()

  !name = !this.assogpName()
  !assogp = !name.dbref()
  handle any
    return
  endhandle
  if (!assogp.members.empty()) then
    !same = !!ce
    !!ce = !assogp
    DELETE ASSOGP
    handle any
      -- error on delete group
    endhandle
    !!ce = !same
    handle any
    endhandle
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clashSettings() is ANYDATASET

  -- collect settings
  var !obstruction split clash obstruction
  if (!obstruction[1].eq('None')) then
    !obstruction.clear()
  endif
  var !exclusion split clash exclusion
  if (!exclusion[1].eq('None')) then
    !exclusion.clear()
  endif
  var !header clash report header
  var !main clash report main
  var !summary clash report summary
  var !graphics clash report graphics
  var !position clash report position
  var !report clash report level
  var !limits clash limits
  var !clearance clash clearance
  var !overlap clash touch overlap
  var !gap clash touch gap

  -- store settings
  !settings = object ANYDATASET()
  !settings.setAttribute('obstruction',!obstruction)
  !settings.setAttribute('exclusion',!exclusion)
  !settings.setAttribute('header',!header)
  !settings.setAttribute('main',!main)
  !settings.setAttribute('summary',!summary)
  !settings.setAttribute('graphics',!graphics)
  !settings.setAttribute('position',!position)
  !settings.setAttribute('report',!report)
  !settings.setAttribute('limits',!limits)
  !settings.setAttribute('clearance',!clearance)
  !settings.setAttribute('overlap',!overlap)
  !settings.setAttribute('gap',!gap)

  return !settings

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clashSettings(!settings is ANYDATASET)

  -- restore settings
  !obstruction = !settings.getAttribute('obstruction')
  !exclusion = !settings.getAttribute('exclusion')
  !header = !settings.getAttribute('header')
  !main = !settings.getAttribute('main')
  !summary = !settings.getAttribute('summary')
  !graphics = !settings.getAttribute('graphics')
  !position = !settings.getAttribute('position')
  !report = !settings.getAttribute('report')
  !limits = !settings.getAttribute('limits')
  !clearance = !settings.getAttribute('clearance')
  !overlap = !settings.getAttribute('overlap')
  !gap = !settings.getAttribute('gap')

  desclash
    remove obstruction all
    remove exclusion all
    do !obst values !obstruction
      obstruction $!obst
    enddo
    do !excl values !exclusion
      exclude $!excl
    enddo
    report header $!header
    report main $!main
    report summary $!summary
    report graphics $!graphics
    report position $!position
    report $!report
    limits $!limits
    clearance $!clearance
    touch overlap $!overlap
    touch gap $!gap
  exit

endmethod
-- End of method
