---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------

-- Define Object
define object MDSASSOWL

  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  -- Object Members
  --
  -- Selected MDS Site DBREF used for STORING the Current MDS Support
  member .mdssitedbref is DBREF

  -- Selected MDS Site NAME used for STORING the Current MDS Support
  member .mdssitename is STRING

  -- Current MDS Support NAME
  member .mdssuppname is STRING

  -- MDS Association World (ASSOWL) DBREF for the MDS Site
  member .mdsassowldbref is DBREF

  -- MDS Association World (ASSOWL)NAME for the MDS Site
  member .mdsassowlname is STRING

  -- MDS Association Group (ASSOGP) DBREF for the MDS Support
  member .mdsassogpdbref is DBREF

  -- MDS Association Group (ASSOGP) NAME for the MDS Support
  member .mdsassogpname is STRING

  -- MDS Association (ASSOC) Prefix for the MDS Support Cross Reference between TWO elements
  -- i.e. a MDS Structural SUPPORT SCTN member and its MAIN Structural Supporting element
  member .mdsassocxrefprefix is STRING

  -- MDS Cross Reference Associations (ASSOCs)created
  member .mdsassociations is ARRAY

  -- Current MDS Framework Form
  member .mdsform is FORM

  -- MDS Support Association Creation Data Object
  member .mdsassoc is MDSASSOC

  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------

  -- End object
endobject

---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
-- FIRST Constructor Method called from a MDS FRAMEWORK/STRUCTURE for, e.g. !!mdsft09
define method .mdsassowl(!form is FORM)

  --<wd>31jan2008 -- DUN808 -- P-4995
  -- ERROR(2,111) raised when !!mdsoptions.site.val is 'Not Set' or UNSET etc...
  -- Check if the value set in !!mdsoptions.site.val is a VALID ZONE element
  -- When it is NOT - Get the ZONE name from the OWNER of the current MDS Framework Support from the passed !form
  !unusedZonedbref = !!mdsoptions.site.val.dbref()
  handle ANY
    -- Get the ZONE name to set in the !!mdsoptions.site.val and set it here!
    !supportzonename = !form.support.stru.owner.name
    !!mdsoptions.site.val = !supportzonename
  endhandle
  --<wd>31jan2008

  -- Get the selected MDS SITE DBREF used for STORING the Current MDS Support
  !this.mdssite()

  -- Check if the ASSOWL element for the MDS Support Database EXISTS and CREATE it if necessary
  !this.mdsassowl()

  --  Check if the ASSOGP element for the current MDS Support EXISTS and CREATE it if necessary
  !this.mdsassogp(!form)

  -- Set the ASSOC prefix for the MDS Support Cross References
  !this.mdsassocxrefprefix = !this.mdssuppname & |-MDS-ASSOC-CROSS-REF-|

endmethod
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
-- SECOND Constructor Method called when Creating an independent Association (ASSOC) between TWO
-- graphically identified/selected elements, i.e. <1> a MDS Structure Support SCTN member and <2> a MAIN Structure element
define method .mdsassowl(!mdssupport is DBREF)

  -- Get the selected MDS SITE DBREF used for STORING the Current MDS Support
  !this.mdssite()

  -- Check if the ASSOWL element for the MDS Support Database EXISTS and CREATE it if necessary
  !this.mdsassowl()

  --  Check if the ASSOGP element for the current MDS Support EXISTS and CREATE it if necessary
  !this.mdsassogp(!mdssupport)

  -- Set the ASSOC prefix for the MDS Support Cross References
  !this.mdsassocxrefprefix = !this.mdssuppname & |-MDS-ASSOC-CROSS-REF-|

endmethod

---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
-- SITE Method
define method .mdssite()


  -- Get the selected MDS SITE DBREF used for STORING the Current MDS Support
  !zonename = !!mdsoptions.site.val
  !sitedbref = !zonename.dbref().owner

  -- Set Object Members
  !this.mdssitedbref = !sitedbref
  !this.mdssitename  = !sitedbref.name

endmethod
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
-- ASSOWL Method
define method .mdsassowl()

  -- Get the selected MDS SITE NAME used for STORING the Current MDS Support
  !sitename = !this.mdssitename

  --q var !sitename

  -- Check if the ASSOWL element for the MDS Support Database EXISTS and CREATE it if necessary
  !assowlname  = !sitename & |-MDS-ASSOWL|
  !assowldbref = !assowlname.dbref()
  handle (2,109)
    -- Undefined Name
    -- Navigate to the MDS SITE and Create the ASSOWL in the same DATABASE
    !!ce = !this.mdssitedbref
    new ASSOWL $!assowlname
    purp MDS
    !assowldbref = !!ce
  elsehandle NONE
    !!ce = !assowldbref
  endhandle

  -- Set Object Members
  !this.mdsassowlname  = !assowlname
  !this.mdsassowldbref = !assowldbref

endmethod
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
-- ASSOGP Method -- !form may be a REAL MDS form, e.g !!mdsft09 or a DBREF set to MDS Support STRUCTURE element
define method .mdsassogp(!form is ANY)

  -- Get the selected MDS Support NAME for the Current MDS Support
  !objecttype = !form.objecttype()
  if (!objecttype.eq('FORM')) then
    !support = !form.support.stru
  elseif (!objecttype.eq('DBREF')) then
    !support = !form
  endif
  !this.mdssuppname = !support.name

  -- Check if the ASSOWL element for the MDS Support Database EXISTS and CREATE it if necessary
  !assogpname  = !support.name & |-MDS-ASSOGP|
  !assogpdbref = !assogpname.dbref()
  handle (2,109)
    -- Undefined Name
    -- Navigate to the MDS ASSOWL and Create the ASSOGP for the current MDS Support
    !!ce = !this.mdsassowldbref
    new ASSOGP $!assogpname
    purp MDS
    !assogpdbref = !!ce
  elsehandle NONE
    !!ce = !assogpdbref
    -- ONLY Delete the current ASSOGP members if the !objecttype is set to 'FORM'
    if (!objecttype.eq('FORM')) then
      delete assogp mem
      handle ANY
        -- ASSOGP may NOT have any MEMBERS
      endhandle
    endif
  endhandle

  -- Set Object Members
  !this.mdsassogpname  = !assogpname
  !this.mdsassogpdbref = !assogpdbref
  if (!objecttype.eq('FORM')) then
    !this.mdsform = !form
  endif

endmethod
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
-- ASSOC Creation Method
-- This method is ONLY called when there are MDS SCTN members of a MDS FRAMEWORK Support which need to be
-- ASSOCIATED with "ONE" (in CLEARANCE mode) or "TWO" (in CURSOR mode) MAIN Supporting Structure elements

define method .mdsassoc(!mdsassoc is MDSASSOC)

  -- Determine the MDS Support CREATION mode -- DIMENSION mode is NOT considered for Associations
  if (!mdsassoc.mode.neq('DIMENSION')) then

    -- Initialise the AVEVA Association Object
    !mdsassocobject = object AVEVAASSOCIATION()

    ---------------------------------------------------------------------------------------------------
    -- Determine which MAIN Structure supporting element is associated with the MDS SUPPORT members e.g. $!name-V1 and $!name-V2
    -- MDS Support SCTNS for CURSOR and CLEARANCE modes
    !mdssctns = ARRAY()
    !mdssctns[1] = !mdsassoc.mdsmember[1]
    -- This MDS Support member will ONLY exist where TWO Support members require an Association (ASSOC)
    if (defined(!mdsassoc.mdsmember[2])) then
      !mdssctns[2] = !mdsassoc.mdsmember[2]
      !mdssctnstwo = TRUE
    else
      -- MDS Support will ONLY require ONE Association (ASSOC)
      !mdssctnstwo = FALSE
    endif

    -- Determine if the MDS Support requires ONE or TWO Associations (ASSOCs)
    if (!mdssctnstwo) then

      if (!mdsassoc.mode.eq('CURSOR')) then
        -- Determine MAIN Structure elements for CURSOR mode ONLY
        !nearestposn = FALSE
        !maininter = ARRAY()
        !maininter[1] = !mdsassoc.pick1inter
        !maininter[2] = !mdsassoc.pick2inter

        -- Determine the Association (ASSOC) for the MDS SCTNS
        -- Loop through the MAIN !pick element intersections
        do !pickindx indices !maininter
          if (!nearestposn) then
            break
          endif
          !pickstring = '!mdsassoc.pick' & !pickindx
          !pickitem   = $!pickstring

          --Loop though the MDS SCTNS
          do !sctnindx indices !mdssctns
            if (!nearestposn) then
              break
            endif
            !sctnposn = ARRAY()
            !sctnposn[1] = !mdssctns[!sctnindx].poss.wrt(/* )
            !sctnposn[2] = !mdssctns[!sctnindx].pose.wrt(/* )

            -- Set Equal Position Object definition to do the Nearest Position test
            do !posnindx indices !sctnposn
              !closestpos = object MDSEQUALPOS()
              !closestpos.positiona = !maininter[!pickindx]
              !closestpos.positionb = !sctnposn[!posnindx]
              !closestpos.tolerance = 200

              -- Break the !sctnposn loop when TRUE is found
              if (!!mdsposequalpos(!closestpos)) then
                !nearestposn = TRUE
                !xmdssctn = !mdssctns[!sctnindx]
                !xmainmem = !pickitem
                -- $P===============================================
                -- $P *** 1st ASSOC amemrfs ***
                -- q var !xmdssctn.name
                -- q var !xmainmem.name
                -- $P-----------------------------
                -- Now Determine the other Associated MAIN Supporting element 'pick' item
                if (!pickindx.eq(1)) then
                  !zmainindx = 2
                elseif (!pickindx.eq(2)) then
                  !zmainindx = 1
                endif
                !zmainitem = '!mdsassoc.pick' & !zmainindx
                !zmainmem  = $!zmainitem

                -- Now Determine the other MDS SCTN
                if (!sctnindx.eq(1)) then
                  !zmdsindx = 2
                elseif (!sctnindx.eq(2)) then
                  !zmdsindx = 1
                endif
                !zmdsitem = '!mdsassoc.mdsmember[' & !zmdsindx & ']'
                !zmdssctn = $!zmdsitem
                -- $P *** 2nd ASSOC amemrfs ***
                -- q var !zmdssctn.name
                -- q var !zmainmem.name
                -- $P===============================================
                break

              endif
            enddo
          enddo
        enddo

        if (undefined(!xmdssctn)) then
          !xmdssctn = !mdssctns[1]
          !xmainmem = !mdsassoc.pick1
        endif

        if (undefined(!zmdssctn)) then
          !zmdssctn = !mdssctns[2]
          !zmainmem = !mdsassoc.pick2
        endif

      elseif (!mdsassoc.mode.eq('CLEARANCE')) then

        -- Generally the MDS FRAMEWORK standards have a maximum of TWO SCTN members
        -- EXCEPT FT43 and FT44 MDS Frameworks

        if (!mdsassoc.mdsmember.size().leq(2)) then
          -- In the 'CLEARANCE' Creation mode BOTH of the MDS SCTNS (e.g. !name-V1 and !name-V2)
          --  will reference the same MAIN Supporting element, i.e. !pick3
          !xmdssctn = !mdsassoc.mdsmember[1]
          !xmainmem = !mdsassoc.pick3
          !zmdssctn = !mdsassoc.mdsmember[2]
          !zmainmem = !mdsassoc.pick3

        else
          -- Create the Associations for the MDS Framework EXCEPTIONS FT43 and FT44
          -- Loop through the !mdsassoc.mdsmember array of "!name-V*" MDS Support SCTN elements
          !mdssctnarray = ARRAY()
          do !indx indices !mdsassoc.mdsmember
            if (!indx.eq(1)) then
              -- MDS SCTN !name-V1
              !xmdssctn = !mdsassoc.mdsmember[1]
              !xmainmem = !mdsassoc.pick3
            elseif (!indx.eq(2) ) then
              -- MDS SCTN !name-V2
              !zmdssctn = !mdsassoc.mdsmember[2]
              !zmainmem = !mdsassoc.pick3
            else
              -- Additional MDS SCTNS !name-V* etc...
              !amdssctn$!<indx>  = !mdsassoc.mdsmember[!indx]
              !amainmem$!<indx>  = !mdsassoc.pick3
              !mdssctnarray[!indx] = !amdssctn$!<indx>
            endif
          enddo
        endif

      endif

    else
      -- MDS Support will ONLY require ONE Association (ASSOC) irrespective of Creation mode !mdsassoc.mode
      !xmdssctn = !mdssctns[1]
      !xmainmem = !mdsassoc.pick1
    endif

    ---------------------------------------------------------------------------------------------------
    ---------------------------------------------------------------------------------------------------

    -- Always Create the FIRST Cross Reference ASSOCIATION between SUPPORT elements !xmdssctn and !xmainmem
    !assocxref1 = !mdsassocobject.exists2(!this.mdsassogpdbref , !xmdssctn , !xmainmem )
    if (!assocxref1) then
      -- Name the Association using the Cross Reference Prefix from the object !mdsassowl
      if (!mdssctnstwo) then
        !associndx = '2'
      else
        !associndx = '1'
      endif
      !!ce = !this.mdsassogpdbref
      ASSOC 1
      !assocname = !this.mdsassocxrefprefix & !associndx
      !!ce.name  = !assocname
      -- Add the ASSOC to the Object member
      !this.mdsassociations[2] = !!ce
    else
      -- ERROR has occurred and Association has NOT been built
      write '** ERROR ASSOC*1 ** An ERROR has occurred and Association 1 has NOT been built **'
    endif

    -- ONLY Create the SECOND Cross Reference ASSOCIATION if required between SUPPORT elements !zmdssctn and !zmainmem
    if (!mdssctnstwo) then
      !assocxref2 = !mdsassocobject.exists2(!this.mdsassogpdbref , !zmdssctn , !zmainmem )
      if (!assocxref2) then
        -- Name the Association using the Cross Reference Prefix from the object !mdsassowl
        !!ce = !this.mdsassogpdbref
        ASSOC 1
        !assocname = !this.mdsassocxrefprefix & '1'
        !!ce.name  = !assocname
        -- Add the ASSOC to the Object member
        !this.mdsassociations[1] = !!ce
      else
        -- ERROR has occurred and Association has NOT been built
        write '** ERROR ASSOC*2 ** ERROR has occurred and Association 2 has NOT been built **'
      endif
    endif
  endif


  ---------------------------------------------------------------------------------------------------
  -- Currently Create Any Additional Cross Reference ASSOCIATIONS if required for MDS FRAMEWORK Standards FT43 and F44 ONLY
  -- ONLY do this when there are MORE than TWO MDS Support SCTN ASSOCIATIONS with the graphically Selected/Picked MAIN Structure element, i.e. !mdsassoc.pick3
  if (!mdsassoc.mdsmember.size().gt(2)) then
    do !xndx indices !mdssctnarray

      !assocxref$!<xndx> = !mdsassocobject.exists2(!this.mdsassogpdbref , !amdssctn$!<xndx> , !amainmem$!<xndx> )
      if (!assocxref$!<xndx>) then
        -- Name the Association using the Cross Reference Prefix from the object !mdsassowl
        !associndx = '$!xndx'
        !!ce = !this.mdsassogpdbref
        ASSOC 1
        !assocname = !this.mdsassocxrefprefix & !associndx
        !!ce.name  = !assocname
        -- Add the ASSOC to the Object member
        !this.mdsassociations[!xndx] = !!ce
      else
        -- ERROR has occurred and Association has NOT been built
        write '** ERROR ASSOC*1 ** An ERROR has occurred and Association 1 has NOT been built **'
      endif

    enddo
  endif
  ---------------------------------------------------------------------------------------------------

  -- $P>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  -- q var !mdsassoc
  -- $P=====================
  -- q var !this
  -- $P<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

endmethod
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
-- ASSOC Creation Method --
-- This method is ONLY called when there are MDS SCTN member of a MDS FRAMEWORK Support which need to be
-- ASSOCIATED with "ONE" (in CLEARANCE mode) MAIN Supporting Structure elements

define method .mdsassoc(!mdsassoc is MDSASSOC, !nextxref is REAL)

  -- Determine the MDS Support CREATION mode -- DIMENSION mode is NOT considered for Associations
  if (!mdsassoc.mode.eq('CLEARANCE')) then

    -- Initialise the AVEVA Association Object
    !mdsassocobject = object AVEVAASSOCIATION()

    -- ONLY ONE ADDITIONAL Association (ASSOC) will be created for the Selected MDS Structure Support
    !xmdssctn = !mdsassoc.mdsmember[!nextxref]
    !xmainmem = !mdsassoc.pick3

    -- Always Create the ADDITIONAL Cross Reference ASSOCIATION between selected MDS SUPPORT SCTN !xmdssctn and the MAIN Structure element!xmainmem
    !assocxref1 = !mdsassocobject.exists2(!this.mdsassogpdbref , !xmdssctn , !xmainmem )
    if (!assocxref1) then
      -- Name the Association (ASSOC) using the Cross Reference Prefix from the object !mdsassowl
      !!ce = !this.mdsassogpdbref
      ASSOC 1
      !assocname = !this.mdsassocxrefprefix & !nextxref.string()
      !!ce.name  = !assocname
      handle ANY
        -- Attempt to RENAME the ASSOCIATION
        !xnumber = !nextxref
        do !count from 1 to 20
          !xnumber = !xnumber + !count
          !assocname = !this.mdsassocxrefprefix & !xnumber.string()
          !!ce.name  = !assocname
          handle ANY
            if (!count.eq(20)) then
              !!alert.error('The Association (ASSOC) has NOT been named correctly. Please name the ASSOC manually in the correct format')
            else
              -- Try again to RENAME the ASSOC as it is still unnamed
              skip
            endif
          elsehandle NONE
            -- ASSOC has been successfully RENAMED
            break
          endhandle
        enddo
      endhandle

      -- Add the ASSOC to the Object member
      !this.mdsassociations[!nextxref] = !!ce

    else
      -- ERROR has occurred and Association has NOT been built
      write '** ERROR ASSOC*1 ** An ERROR has occurred and Association 1 has NOT been cfrerated **'
    endif

  endif

  -- $P>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  -- q var !mdsassoc
  -- $P=====================
  -- q var !this
  -- $P<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

endmethod
