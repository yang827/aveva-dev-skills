--
-- File:  mdscheckframe.pmlobj
-- Type:  Object Definition
-- Group:  Multi Discipline Supports Application
-- Keyword:  MDS
-- Module:  design
-- Replaces:
--
-- Author:  Michael Board
-- Created:  Friday - May 5th 2006
--
-- Description:
-- Renamed version of mdscheckstd() containing only .bores method
-- This version created for MDS12 because mdscheckstd() changed to be passed an argument at MDS12 (i.e.
-- mdscheckstd(!mdsattaobj)) where !mdsattaobj is MDSREADPARSDATA object), but there are instances where
-- we just want to use the .bores method without having to create an mdsreadparsdata object
-- e.g. in mdssetdatft09
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  bores(STRING)                    BOOLEAN
--  criteria()                       STRING              Checks current element on passing user defined criteria
--

--  bores()       BOOLEAN   Checks if the selected pipe is with the bore range

--
-----------------------------------------------------------------------------------------------------------
--
-- Define Object
define object MDSCHECKFRAME

  member .description is STRING

endobject


-----------------------------------------------------------------------------------------------------------
--
-- Method            bores
--
-- Description:      Method to check the bore of the selected pipe
--
-- Arguments:
--    [#]   [R/RW]    [Data Type]   [Description]
--     1     R        STRING       The MDS template name
--
-- Return:
--    [Data Type]    [Description]
--     BOOLEAN       Returns 'True'  if bore is OK
--              or   Returns 'False' if bore is out of range
--
--
-----------------------------------------------------------------------------------------------------------
define method .bores(!template is STRING) is BOOLEAN

  -- !this.description = 'MDS Object Method (Mdscheckstd.bore()) for Checking bores'
  forwards

  !return  = true

  -- Initialise variables
  -- Get current bore
  var !bore lbore
  handle any
    var !bore hbore
  endhandle

  -- get template maximum bore
  !maxBore = :MDSMaxBore of $!template
  !minBore = :MDSMinBore of $!template

  if !bore.real().gt(!maxBore) then
    !return = false
  endif

  if !bore.real().lt(!minBore) then
    !return = false
  endif

  return $!return

endmethod
-- End of method .bore(!template is STRING) is BOOLEAN
--
-----------------------------------------------------------------------------------------------------------


------------------------------------------------------------------------
--
-- Method:      criteria
--
-- Description: Checks current element on passing user defined criteria
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    STRING      Empty on pass, else contains number of failing criteria
------------------------------------------------------------------------

define method .criteria() is STRING

  -- Do not pass current element directly because method changes !!ce while working
  !testRef = !!ce
  !result = !!mdsSelectionCriteria.passed(!testRef, !testRef.owner)
  return !result

endmethod
