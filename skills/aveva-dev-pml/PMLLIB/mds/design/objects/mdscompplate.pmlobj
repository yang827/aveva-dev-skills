------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  align()                          -
--  build()                          -
--  create(STRING)                   -
--  frmw()                           DBREF
--  gap()                            REAL
--  gtyp()                           STRING
--  matref()                         DBREF
--  matref(DBREF)                    -
--  mdsCompplate()                   -                   Default constructor
--  mdsCompplate(DBREF)              -
--  mdsCompplate(DBREF,DBREF)        -
--  modified(STRING)                 BOOLEAN
--  name()                           STRING
--  panelTemplate()                  DBREF
--  pline()                          STRING
--  profileTemplate()                DBREF
--  rootname()                       STRING
--  sctn()                           DBREF
--  size()                           ARRAY
--  size(ARRAY)                      -
--  spref(REAL,DBREF)                ARRAY
--  stru()                           DBREF
--  width()                          REAL
--
define object MDSCOMPPLATE

  -- store atta and crossbar
  member .atta is DBREF
  member .sctn is STRING

  -- store compensation hierarchy
  member .fitt is DBREF
  member .tmpl is DBREF
  member .pane is ARRAY

  -- store other properties and building info
  member .oldStyp is STRING
  member .oldWidth is REAL
  member .size is ARRAY
  member .matref is DBREF

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      mdsCompplate
--
-- Description: Default constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsCompplate()

  !error = !!mdsCompplateDflts.loadError
  if !error.set() then
    return error 1 '$!error'
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]      [Description]
--
-- Return:
--   [Data Type]       [Description]
--
------------------------------------------------------------------------

define method .mdsCompplate(!comp is DBREF)

  !this.mdsCompplate()
  if !comp.type.eq('FIXING') then
    !fitt = !comp
    --$p ___!fitt = $!fitt
    if !fitt.gtyp.neq(!this.gtyp()) then
      return error 1 'Not a compensation.'
    endif
    !atta = !fitt.cref
    if !fitt.badref() then
      return error 1 'Compensation is not associated with atta.'
    endif
    if !atta.type.neq ('ATTA') then
      return error 1 'Not a compensation.'
    endif
  elseif !comp.type.eq('ATTA') then
    !atta = !comp
    if !atta.spown.namn.neq('MDS') then
      return error 1 'ATTA must be MDS ancillary.'
    endif
    if !atta.styp.eq('MH01') then
      return error 1 'This is a HANGER.'
    endif
    !fitt = !atta.cref
    if !fitt.badref() then
      return error 1 'Compensation of support $!atta.name does not exist.'
    endif
    if !fitt.type.neq('FIXING').or(!fitt.gtyp.neq(!this.gtyp())) then
      return error 1 'Compensation of support $!atta.name does not exist.'
    endif
  endif
  !sctn = !fitt.:mdsancref[1]
  handle ANY
    !sctn = nulref
  endhandle
  if !sctn.badref() then
    return error 1 'Compensation is not associated with crossbar.'
  endif
  if !sctn.type.neq('SCTN') then
    return error 1 'Compensation is not associated with crossbar.'
  endif

  !tmpl = object DBREF('TMPL 1 of ' & !fitt)
  handle ANY
    return error 1 'Fitting is empty.'
  endhandle

  !pane = ARRAY()
  do !memb values !tmpl.memb
    skip if !memb.type.neq('PANE')
    !pane.append(!memb)
  enddo


  !this.pane = !pane
  !this.tmpl = !tmpl
  !this.fitt = !fitt
  !this.atta = !atta
  !this.sctn = !sctn.name

  !this.size = !fitt.desp
  !buildInfo = !tmpl.func.split()
  if defined(!buildInfo[1]) then
    !this.oldStyp = !buildInfo[1]
  endif
  if defined(!buildInfo[2]) then
    !this.oldWidth = !buildInfo[2].real()
    handle ANY
    endhandle
  endif
  !this.matref = !this.pane.first().matr
  handle ANY
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]      [Description]
--
-- Return:
--   [Data Type]       [Description]
--
------------------------------------------------------------------------

define method .mdsCompplate(!atta is DBREF, !sctn is DBREF)

  !this.mdsCompplate()

  !this.atta = !atta
  !this.sctn = !sctn.name

  !frmw = !this.frmw()
  do !memb values !frmw.memb
    skip if !memb.type.neq('FIXING')
    skip if !memb.gtyp.neq(!this.gtyp())
    !sctnref = !memb.:mdsancref[1]
    handle ANY
      skip
    endhandle
    skip if !sctnref.badref()
    skip if !sctnref.neq(!sctn)
    !cref = !memb.cref
    skip if !cref.badref()
    if !cref.eq(!atta) then
      !fitt = !memb
      break
    endif
  enddo

  if defined(!fitt) then
    !this.mdsCompplate(!fitt)
  else
    -- check gap
    !!mdsCompplateDflts.checkGap(!this.gap())
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sctn() is DBREF

  !sctn = !this.sctn.dbref()
  handle ANY
    !sctn = nulref
  endhandle

  return !sctn

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .stru() is DBREF

  !stru = nulref
  !sctn = !this.sctn()
  if !sctn.set() then
    !stru = object DBREF('STRU of ' & !sctn)
  endif

  return !stru

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .frmw() is DBREF

  !frmw = nulref
  !sctn = !this.sctn()
  if !sctn.set() then
    !frmw = object DBREF('FRMW of ' & !sctn)
  endif

  return !frmw

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rootname() is STRING

  return !this.stru().name & !!mdsCompplateDflts.nameSuffix

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .name() is STRING

  !root = !this.rootname()
  do !c from 1
    !name = !root & !c
    !name.dbref()
    handle ANY
      return !name
    endhandle
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .build()

  -- check gap first
  !gap = !this.gap()
  !!mdsCompplateDflts.checkGap(!gap)
  handle 1
    -- gap is less than minimum
    !creationError = true
  elsehandle ANY
    -- gap is greater than maximum
    !creationError = false
  endhandle

  if defined(!creationError) then
    -- first delete compensation if exists
    if !this.fitt.badref().not() then
      !!ce = !this.fitt
      delete $!!ce.type
    endif
    if !creationError then
      return error 1 'Cannot re-create compensating plate - Steelwork has been re-created'
    else
      return error
    endif
  endif
  !mingap = !!mdsCompplateDflts.mingap
  !maxgap = !!mdsCompplateDflts.maxgap
  !maxgapPrfl = !!mdsCompplateDflts.maxgapPrfl
  !matref = !this.matref()
  !size = !this.size()
  !width = !this.width()

  -- build FIXING hierarchy
  !!ce = !this.frmw()
  !this.create('FIXING')
  !this.align()
  !this.fitt.gtyp = !this.gtyp()
  !this.create('TMPL')
  delete TMPL memb
  if !this.fitt.isnamed.not() then
    !name = !this.name()
    !this.fitt.name = !name
    !this.tmpl.name = !name & '/TMPL'
  endif


  -- calculate X-size/length
  if !this.modified('ATTA') then
    !size[1] = !!mdsCompplateDflts.size('x',!this.atta,!this.sctn())
  endif

  -- <sk> !gap.between(!mingap,!maxgap) returns wrong results in some cases
  if ((!gap geq !mingap) and (!gap leq !maxgap)) then
    -- create plates
    if !this.modified('SCTN').or(!this.modified('ATTA')) then
      !size[2] = !!mdsCompplateDflts.size('y',!this.atta,!this.sctn())
    endif
    !this.fitt.desp = !size
    !source = !this.panelTemplate()
    !spref = !this.spref(!gap,!matref)

    handle ANY
      !error = !!error.text
      !spref = ARRAY()
    endhandle
    do !c indices !spref
      if defined(!this.pane[!c]) then
        !ref = 'ref ' & !this.pane[!c]
      else
        !ref = ''
      endif
      new PANE $!ref copy $!source
      !this.pane[!c] = !!ce
      !!ce.pos = e0 n0 u0 wrt owner
      !!ce.ori = Y is E wrt owner and Z is U wrt owner
      !!ce.spref = !spref[!c]
      !!ce.matref = !!mdsCompplateDflts.matref()
      if !c.eq(!spref.size()).and(!!mdsCompplateDflts.accommodateThkn) then
        if !!ce.rpro.thkn.neq(!gap) then
          !desp = !size
          !desp.append(!!ce.rpro.thkn + !gap)
          !!ce.desp = !desp
        endif
      endif
      rule rexe
      handle ANY
      endhandle
      if !c.gt(1) then
        !prev = !this.pane[!c - 1]
        move U wrt ce clear behind $!prev
      endif
    enddo
  -- <sk> !gap.between(!maxgap,!maxgapPrfl) returns wrong results in some cases
  elseif ((!gap geq !maxgap) and (!gap leq !maxgapPrfl)) then

    -- copy profile template
    !source = !this.profileTemplate()
    if !source.ldpr.widt.gt(!width) then
      !error = 'Size of compensation profile (' & !source.ldpr.widt.string() & ') of support ' & !this.atta.name & ' is bigger than size of crossbar (' & !width.string() & '). Cannot create compensation'
    else
      !size[2] = !gap
      !this.fitt.desp = !size
      copy rexe $!source rename $!source.name $!this.fitt.name
    endif
    -- set width to unset value as it is meaningless for profile
    !width = REAL()
  endif

  -- update and store build information
  !this.size = !size
  !this.oldStyp = !this.atta.styp
  !this.oldWidth = !width
  !this.tmpl.func = !this.oldStyp & ' ' & !this.oldWidth

  -- jump to FITT
  !!ce = !this.fitt
  -- delete compensation if empty
  if !this.tmpl.memb.unset() then
    delete FIXING
  endif

  if defined(!error) then
    return error 1 '$!error'
  endif


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .align()

  if !this.fitt.jlin.empty() then
    !this.fitt.jlin = !this.pline()
  endif

  !sctn = !this.sctn()
  !plin = !sctn.plst.attribute(!this.fitt.jlin).line(!sctn.plen.attribute(!this.fitt.jlin))
  !pos = !plin.near(!this.atta.ppos[9])
  !this.fitt.pos = !pos
  !this.fitt.ori = !sctn.plori.attribute(!this.fitt.jlin)
  !this.fitt.cref = !this.atta
  !this.fitt.:mdsancref[1] = !sctn

  if !sctn.plnam.find('CGEO').set() then
    !pos = !!ce.pos
    !pos.north = !sctn.plst.cgeo.wrt(!this.stru()).north
    !!ce.pos = !pos
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .create(!itemtype is STRING)

  !type = !itemtype
  if !itemtype.eq('FIXING') then
    !type = 'FITT'
  endif
  !refno = !this.attribute(!type)
  if !refno.badref() then
    if !refno.set() then
      new $!itemtype ref $!refno
    else
      new $!itemtype
      !this.attribute(!type) = !!ce
    endif
  else
    !!ce = !refno
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .size(!size is ARRAY)

  !oldce = !!ce
  !!ce = !this.fitt
  !!ce.desp = !size
  rule rexe
  handle ANY
  endhandle
  !!ce = !oldce

  !this.size = !size

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .size() is ARRAY

  !size = !this.size
  if undefined(!size[1]) then
    !size[1] = !this.fitt.desp[1]
    handle ANY
      !size[1] = !!mdsCompplateDflts.xsize.default
    endhandle
  endif
  if undefined(!size[2]) then
    !size[2] = !this.fitt.desp[2]
    handle ANY
      !size[2] = !!mdsCompplateDflts.ysize.default
    endhandle
  endif

  return !size

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .spref(!gap is REAL,!matref is DBREF) is ARRAY

  return !!mdsCompplateDflts.spref(!gap,!matref)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pline() is STRING

  !angle = !!mdsoptions.slope.val.replace(' ','').real().atan()

  !posl = !!mdsBestPline(!this.sctn(),!this.atta.pdir[9],!this.atta.pos,!angle)

  return !posl

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gap() is REAL

  !pline = !this.fitt.jlin
  handle ANY
    !pline = ''
  endhandle
  if !pline.empty() then
    !pline = !this.pline()
  endif

  !sctn = !this.sctn()
  !dir = !sctn.plori.attribute(!pline).zdir()
  !pos = !sctn.plst.attribute(!pline)

  !pin = object MDSPIN(1,!pos,!dir)
  !atta = !this.atta
  pin 1 thro p9 of $!atta
  !newpos = !pin.position()
  !!mdsResetPins(1,1)

  if !newpos.wrt( /* ).up LT !pos.wrt( /* ).up then
    -- If the ancillary is going through the steelwork then possibly a U-bolt type ancillary is being used
    -- If the ancillary is lower than the steel, set the gap to 0mm
    !gap = 0mm
  else
    !gap = !pos.distance(!newpos)
  endif

  return !gap

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
