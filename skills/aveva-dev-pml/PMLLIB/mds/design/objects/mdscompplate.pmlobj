--
------------------------------------------------------------------------

define method .panelTemplate() is DBREF

  return !!mdsCompplateDflts.panel

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .profileTemplate() is DBREF

  return !!mdsCompplateDflts.prflTmpl

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gtyp() is STRING

  return !!mdsCompplateDflts.gtyp

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .width() is REAL

  return !!mdsCompplateDflts.width(!this.sctn(),!this.atta)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .matref() is DBREF

  !matref = nulref
  !matref = !this.pane.first().matr
  handle ANY
    !matref = !this.matref
    if !matref.badref() then
      !matref = !!mdsCompplateDflts.matref()
    endif
  endhandle

  return !matref

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .matref(!matref is DBREF)

  !this.matref = !matref

  do !pane values !this.pane
    skip if !pane.badref()
    !pane.matref = !matref
    handle ANY
      skip
    endhandle
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modified(!what is STRING) is BOOLEAN

  if !what.eq('ATTA') then
    !result = !this.atta.styp.neq(!this.oldStyp)
  elseif !what.eq('SCTN') then
    !result = !this.width().neq(!this.oldWidth)
  endif

  return !result

endmethod
-- End of method
