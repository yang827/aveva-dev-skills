--
------------------------------------------------------------------------

define method .roundingMethodDesc(!key is STRING) is STRING

  !index = !this.methodKey().findfirst(!key.upcase())

  return !this.roundingMethodDesc()[!index]

endmethod
-- End of method

------------------------------------------------------------------------
