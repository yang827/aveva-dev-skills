------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .compensatingPlates(!plates is ARRAY)

  do !plate values !plates
    !plate.build()
    handle ANY
      !!alert.error(!!error.text)
    endhandle
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createCompplate(!form is FORM)

  if !this.loadError.set() then
    !!alert.error('Cannot create compensation! ' & !this.loadError)
    return
  endif

  !atta = !!mdsSinglePick('ATTA','')
  if !atta.unset() then
    return
  endif

  if !form.support.atta.find(!atta).unset() then
    !!alert.error(!atta.namtyp & ' does not belong to support ' & !form.support.stru.namn )
    return
  endif

  if !atta.eq(!form.support.sref()) then
    !atta = !form.support.datum
  endif

  !this.createCompplate(!form, !atta)
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  !modform = !!fmsys.loadform('mdsmodifycompplate')
  !modform.init(!form)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyCompplates(!form is FORM)

  if !this.loadError.set() then
    !!alert.error('No compensation can be modified! ' & !this.loadError)
    return
  endif

  !modform = !!fmsys.loadform('mdsmodifycompplate')
  !modform.init(!form)
  handle ANY
    !!alert.error(!!error.text)
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createCompplate(!form is FORM, !atta is DBREF)

  !bar = object DBREF()
  !frmw = !form.support.frmw()
  if !frmw.set() then
    !members = !frmw.memb
  else
    !error = 'Compensation cannot be created, the framework does not exist'
    return error 1 '$!error'
  endif

  -- handle frames that have TMPL
  !tmpl = object DBREF(!form.support.stru.name & '/TMPL')
  handle NONE
    !members.appendarray(!tmpl.memb)
  elsehandle ANY
  endhandle
  do !sctn values !members
    skip if !sctn.type.neq('SCTN')
    if !sctn.:mdsattaref.find(!atta).set() then
      !bar = !sctn
      break
    endif
  enddo

  if (!bar.unset()) then
    !bar = !!mdsSinglePick('SCTN','')
    if !bar.unset() then
      !error = 'Bar is unset'
      return error 1 '$!error'
    endif

    if !form.support.frmw().memb.find(!bar).unset() then
       !error = !bar.namtyp & ' does not belong to support ' & !form.support.stru.namn
      return error 1 '$!error'
    endif
  endif

  !plate = object MDSCOMPPLATE(!atta,!bar)
  handle ANY
    !error = 'Cannot create compensation! ' & !!error.text
    return error 1 '$!error'
  endhandle

  if !plate.fitt.set() then
    !error = 'Compensation of ' & !atta.namtyp & ' already exists.'
    return error 1 '$!error'
  endif

  !plate.build()
  !!ce = !plate.fitt

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteCompplate(!form is FORM)

  if !this.loadError.set() then
    !!alert.error('No compensation can be deleted! ' & !this.loadError)
    return
  endif

  do
    !fitt = !!mdsSinglePick('ATTA FIXING','Pick compensation plate/profile or compensated ancillary.')
    if !fitt.unset() then
      return
    endif

    if !fitt.type.eq('ATTA') then
      if !form.support.atta.find(!fitt).unset() then
        !!alert.error('The item picked does not belong to support ' & !form.support.stru.namn )
        skip
      endif
      !comp = object MDSCOMPPLATE(!fitt)
      handle ANY
        !!alert.error(!!error.text)
        skip
      endhandle
    else
      if !fitt.ownls.find(!form.support.stru).unset() then
        !!alert.error('The item picked does not belong to frame ' & !form.support.stru.name)
        skip
      endif
      !comp = object MDSCOMPPLATE(!fitt)
      handle ANY
      endhandle
    endif
    break
  enddo

  if !!alert.confirm('O.K. to delete compensation of support ' & !comp.atta.name & ' ?').boolean().not() then
    return
  endif

  !washere = !!ce
  !!ce = !comp.fitt
  delete $!!ce.type
  !!ce = !washere
  handle ANY
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Routine to delete compensation (FIXING) associated with ATTA. No error is returned if no such exists.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteCompplate(!atta is DBREF)

  !washere = !!ce
  !compensation = object MDSCOMPPLATE(!atta)
  handle ANY
    -- no compensation so exit silently
    return
  endhandle

  !!ce = !compensation.fitt
  delete $!!ce.type

  !!ce = !washere
  handle ANY
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rebuildCompplate(!atta is DBREF)

  !washere = !!ce
  !compensation = object MDSCOMPPLATE(!atta)
  handle ANY
    -- no compensation so exit silently
    return
  endhandle

  !compensation.build()

  !!ce = !washere
  handle ANY
  endhandle


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkGap(!gap is REAL)

  !gapstr = !gap.string(!!distanceFmt).replace('''','''''')
  if !gap.lt(!this.mingap) then
    !mingap = !this.mingap.string(!!distanceFmt).replace('''','''''')
    return error 1 'Gap ($!gapstr) is less than minimum specified ($!mingap).'
  elseif !gap.gt(!this.maxgapPrfl) then
    !maxgap = !this.maxgapPrfl.string(!!distanceFmt).replace('''','''''')
    return error 2 'Gap ($!gapstr) is greater than maximum specified ($!maxgap).'
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .width(!sctn is DBREF,!atta is DBREF) is REAL

  !zdir = !sctn.plori.na.zdir()
  !angle = !zdir.angle(!atta.ldir)
  if !angle.gt(45).and(!angle.lt(135)) then
    !width = !sctn.para[2]
  else
    !width = !sctn.para[1]
  endif
  !width = distconvert(!width)

  return !width

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:  Default material
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .matref() is DBREF

  !matref = !this.matref[!this.dfltMatrefIndex]
  handle ANY
    !matref = !this.matref.first()
  endhandle

  return !matref

endmethod
-- End of method

------------------------------------------------------------------------
