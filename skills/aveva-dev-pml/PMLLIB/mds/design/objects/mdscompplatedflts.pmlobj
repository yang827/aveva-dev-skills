--
------------------------------------------------------------------------

define method .compensatingPlates(!support is MDSFTSEVENTYONE) is ARRAY

  !plates = !this.compensatingPlates(!support.stru)

  return !plates

  !plates = ARRAY()
  if !this.loadError.set() then
    return !plates
  endif

  !allfitt = !!mdsCollectAll('FIXING','gtyp eq ''$!this.gtyp''',!support.stru)
  do !fitt values !allfitt
    !plates.append(object MDSCOMPPLATE(!fitt))
    handle ANY
    endhandle
  enddo

  return !plates

endmethod
-- End of method

