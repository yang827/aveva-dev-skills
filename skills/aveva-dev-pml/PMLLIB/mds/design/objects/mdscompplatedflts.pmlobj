-- End of method

------------------------------------------------------------------------
--
-- Method: mdsCompplateMaterials
--
-- Description: Return a list of available materials for each compensating plate size
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R       STRING    Section name where material list is stored
-- Return:
--   [Data Type] [Description]
--    2D ARRAY
------------------------------------------------------------------------

define method .mdsCompplateMaterials(!table is STRING) is ARRAY

  !tableref = !table.dbref()
  handle ANY
    !error = !table & ' does not exists. Contact MDS administrator.'
    return error 1 '$!error'
  endhandle

  !dfltdata = object DBREF(!tableref.name & '/DFLT')
  !this.default = !dfltdata.prde.expr.real()
  !this.defexpr = object EXPRESSION(!dfltdata.prop.expr)

  !i = 0
  do !cate values !tableref.memb
    skip if !cate.type.neq('CATE')
    !j = 0
    do !dtse values !cate.memb
      skip if !dtse.type.neq('DTSE')

      !code = !dtse.prop.matr
      handle ANY
        skip
      endhandle
      !expr = object EXPRESSION(!dtse.prop.expr)
      handle ANY
        skip
      endhandle
      !this.code.append(!code)
      !this.expr.append(!expr)
      !j = !j + 1
    enddo
    !i = !i + 1
  enddo

endmethod
