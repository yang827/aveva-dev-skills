------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  codes()                          ARRAY
--  dbWrite(DBREF)                   -                   Write values into CATA db - intended to be run in Paragon only
--  expression(STRING)               EXPRESSION
--  expressions()                    ARRAY
--  matching(STRING,ARRAY)           BOOLEAN
--  mdsCompplateSize(DBREF)          -
--  mdsCompplateSize(STRING)         -
--  reinputable(ANY)                 STRING
--  removeEntry(REAL)                -
--  rows()                           ARRAY
--  setCode(REAL,STRING)             -
--  setExpression(REAL,STRING)       -
--  size(DBREF,REAL)                 REAL
--
define object MDSCOMPPLATESIZE

  member .default is REAL
  member .defexpr is EXPRESSION
  -- lookup table
  member .code is ARRAY
  member .expr is ARRAY



endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsCompplateSize(!table is STRING)

  !tableref = !table.dbref()
  handle ANY
    !error = !table & ' does not exists. Contact MDS administrator.'
    return error 1 '$!error'
  endhandle

  !this.mdsCompplateSize(!tableref)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]      [Description]
--
-- Return:
--   [Data Type]       [Description]
--
------------------------------------------------------------------------

define method .mdsCompplateSize(!table is DBREF)

  !dfltdata = object DBREF(!table.name & '/DFLT')
  !this.default = !dfltdata.prde.expr.real()
  !this.defexpr = object EXPRESSION(!dfltdata.prop.expr)

  do !dtse values !table.memb
    skip if !dtse.type.neq('DTSE')
    !code = !dtse.prop.code.split()
    handle ANY
      skip
    endhandle
    !expr = object EXPRESSION(!dtse.prop.expr)
    handle ANY
      skip
    endhandle
    !this.code.append(!code)
    !this.expr.append(!expr)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .size(!atta is DBREF, !sctnwidth is REAL) is REAL

  !size = REAL()
  !width = !sctnwidth.string()
  !size = !this.defexpr.evaluate(!atta)
  handle ANY
  endhandle
  if !size.unset() then
    !size = !this.default
  endif
  !styp = !atta.styp

  do !c indices !this.code
    if !this.matching(!styp,!this.code[!c]) then
      !specsize = REAL()
      !specsize = !this.expr[!c].evaluate(!atta)
      handle ANY
      endhandle
      if !specsize.set() then
        !size = !specsize
      endif
      break
    endif
  enddo
  !width.delete()

  return !size

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .matching(!styp is STRING,!codes is ARRAY) is BOOLEAN

  do !code values !codes
    if !styp.matchwild(!code) then
      return true
    endif
  enddo

  return false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setExpression(!index is REAL, !expr is STRING)

  if !index.eq(0) then
    -- default expression
    !this.defexpr = !this.expression(!expr)
  else
    -- support specific expression
    !this.expr[!index] = !this.expression(!expr)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setCode(!index is REAL,!code is STRING)

  !splitcode = !code.split()
  if !splitcode.empty() then
    return error 1 'No support code given'
  endif

  !code = !splitcode.join(' ')

  !this.code[!index] = !splitcode

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .expression(!expr is STRING) is EXPRESSION

  !wkexpr = !expr.trim()
  if !wkexpr.match('(').neq(1) then
    !wkexpr = '(' & !wkexpr
  endif
  if !wkexpr.substring(-1,1).neq(')') then
    !wkexpr = !wkexpr & ')'
  endif
  !wkexpr = !wkexpr.replace('(',' ( ').replace(')',' ) ').trim()
   do
    !wkexpr = !wkexpr.replace('  ',' ')
    break if !wkexpr.match('  ').eq(0)
  enddo

  !test = REAL()
  !expression = object EXPRESSION(!wkexpr)
  handle ANY
    return error 1 'Expression is invalid.'
  endhandle
  !test = !expression.evaluate(world)
  handle ANY
    return error 1 'Expression must return a REAL value!'
  endhandle

  !expr = !wkexpr
  handle ANY
  endhandle

  return !expression

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dbWrite
--
-- Description: Write values into CATA db - intended to be run in Paragon only
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .dbWrite(!table is DBREF)

  !name = !table.name
  !dflt = !name & '/DFLT'
  !dfltdata = object DBREF('DATA 1 of ' & !dflt)
  !dfltdata.dpro = !this.reinputable(!this.default)
  !dfltdata.ppro = !this.reinputable(!this.defexpr)

  !alldtse = !!mdsCollectAll('DTSE','name neq ''$!dflt''',!table)
  !nof = !alldtse.size()
  if !nof.lt(!this.code.size()) then
    !nof = !this.code.size()
  endif

  do !c from 1 to !nof
    if undefined(!alldtse[!c]) then
      !!ce = !table.memb.last()
      new DTSE purp MDS
      !!ce.name = !name & '/' & !c
      new DATA dkey CODE
      !cdata = !!ce
      new DATA dkey EXPR
      !edata = !!ce
    else
      !dtse = !alldtse[!c]
      if undefined(!this.code[!c]) then
        !!ce = !dtse
        delete DTSE
        skip
      else
        !cdata = !!mdsCollectAll('DATA','dkey eq ''CODE''',!dtse).first()
        !edata = !!mdsCollectAll('DATA','dkey eq ''EXPR''',!dtse).first()
      endif
    endif
    !cdata.ppro = !this.reinputable(!this.code[!c].join(' '))
    !edata.ppro = !this.reinputable(!this.expr[!c])
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .codes() is ARRAY

  !codes = ARRAY ()
  do !code values !this.code
    !codes.append(!code.join(' '))
  enddo

  return !codes

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .expressions() is ARRAY

  !expressions = ARRAY()
  do !expr values !this.expr
    !expressions.append(!expr.string())
  enddo

  return !expressions

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .rows() is ARRAY

  !rows = ARRAY()
  !codes = !this.codes()
  !expressions = !this.expressions()
  do !c indices !codes
    !rows[!c] = ARRAY()
    !rows[!c][1] = !codes[!c]
    !rows[!c][2] = !expressions[!c]
  enddo

  return !rows

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeEntry(!index is REAL)

  !this.code.remove(!index)
  !this.expr.remove(!index)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reinputable(!val is ANY) is STRING

  !reinput = '''' & !val & ''''

  return !reinput

endmethod
-- End of method
