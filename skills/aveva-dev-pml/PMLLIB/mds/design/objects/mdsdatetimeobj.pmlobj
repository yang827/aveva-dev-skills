------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsdatetimeobj()                 -
--
-------------------------------------------------------------------------------
define object mdsdatetimeobj

-- Day String
  member .daystring is STRING

-- Month String - Full Name
  member .monthstring is STRING

-- Month String - First 3 Characters
  member .monthstrabb is STRING

-- Year Real
  member .year is REAL

-- Hours String
  member .hourstring is STRING

-- Minutes String
  member .minutestring is STRING

-- Seconds String
  member .secondstring is STRING

-- DATE String, i.e. '$!<daystring>$!<monthstrabb>$!<year>'
  member .datestring is STRING

-- TIME String, i.e. '$!<hourstring>$!<minutestring>$!<secondstring>'
  member .timestring is STRING

-- DATE TIME String, i.e. '$!<daystring>$!<monthstrabb>$!<year>-$!<hourstring>$!<minutestring>$!<secondstring>'
  member .datetimestr is STRING

-- DATE TIME Object
  member .datetimeobj is DATETIME

endobject

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Constructor Method for the object
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R
-- Return:
--    [Data Type]   [Description]
--
-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
define method .mdsdatetimeobj()

-- Determine "START" Date Time Object variables
  !datetime    = object datetime()
  !datetimeobj = !datetime
  !day         = !datetime.date()

  if (!day.lt(10)) then
    !this.daystring = '0' & !day
  else
    !this.daystring = !day.string()
  endif
  !month            = !datetime.month()
  !this.monthstring = !datetime.monthstring()
  !this.monthstrabb = !this.monthstring.substring(1,3)
  !this.year        = !datetime.year()
  !hour             = !datetime.hour()
  if (!hour.lt(10)) then
    !this.hourstring = '0' & !hour
  else
    !this.hourstring = !hour.string()
  endif
  !minute   = !datetime.minute()
  if (!minute.lt(10)) then
    !this.minutestring = '0' & !minute
  else
    !this.minutestring = !minute.string()
  endif
  !second   = !datetime.second()
  if (!second.lt(10)) then
    !this.secondstring = '0' & !second
  else
    !this.secondstring = !second.string()
  endif

-- Concatenate the Date Time Strings
  !this.datetimestr = '$!<this.daystring>$!<this.monthstrabb>$!<this.year>-$!<this.hourstring>$!<this.minutestring>$!<this.secondstring>'
  !this.datestring  = '$!<this.daystring>$!<this.monthstrabb>$!<this.year>'
  !this.timestring  = '$!<this.hourstring>$!<this.minutestring>$!<this.secondstring>'

endmethod

