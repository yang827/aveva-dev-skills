--------------------------------------------------------------------------------
--   Type:  Object Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  DESIGN
--
--------------------------------------------------------------------------------
-- Description:
--
-- PML Object to determine the MDS Design Data etc... for the MDS ZONE IDENTITIES etc..
-- from the MDS12 DEFAULTS PARAGON CATALOGUE Database CONVERTED from the latest MDS11.6*
-- version of the MDS DEFAULTS FILE "%MDSDFLTS%/DES-SUPP-ID" from the MASTER PDMS
-- Project "MDS"
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsdescriptions()                -
--
define object MDSDESCRIPTIONS

  -- Overall MDS DESCRIPTION Check for the MDS DESIGN Application
  member .descriptioncheck is BOOLEAN

  -- Error text for missing MDS Standard DESCRIPTIONS CATALOGUES
  member .descerrortext is STRING

  -- Continuation Error type found if ANY
  -- <1>--ALLOK   -- <ALLOW Entry to MDS DESIGN Apps>
  -- <2>--WARNING -- <ADVISE USER of WARNING and ALLOW Entry to MDS DESIGN Apps>
  -- <3>--ERROR   -- <ADVISE USER of ERROR and ABORT Entry to MDS DESIGN Apps>
  member .descerrortype is STRING

  -- ARRAY members to store the Global Variable <DESC> !!dESCAT01 and <CCOD>!!cODEAT01 etc...
  member .descgvararr is ARRAY
  member .ccodgvararr is ARRAY

  -- End object
endobject
--
--------------------------------------------------------------------------------
-- Constructor Method .mdsdescriptions()
-- Arguments:
--
-- Return:
--
--------------------------------------------------------------------------------
-- Constructor Method
--
define method .mdsdescriptions()

  -- FROM the 5<five> PARAGON CATALOGUES for the PDMS Project MDS DESIGN APPLICATION DEFAULTS
  -- LOAD ALL of the "MDSACTIVE" PARAGON CATALOGUE DATA elements representing the MDS STANDARDS "GENERAL" defaults
  -- e.g. .../DESC <MDS Client Description> and .../CCOD <MDS Client Code>
  -- and LOAD the Global Variables "!!dESC<mdsstd>" and "!!cODE<mdsstd>"
  -- accordingly for each MDS STANDARD type <AT*, FT*, GT*, TT*, FH* etc...>

  -- Initialise Variable Array for the 5 PARAGON CATALOGUES
  !mdscatas = ARRAY()
  !mdscatas.append(/MDS/STRUCTURE/DEFAULTS )
  !mdscatas.append(/MDS/ATTA/DEFAULTS )
  !mdscatas.append(/MDS/TRUNNION/DEFAULTS )
  !mdscatas.append(/MDS/PRELIMINARY/DEFAULTS )
  !mdscatas.append(/MDS/HANGER/DEFAULTS )
  !errorstr = ||
  !validstr = ||
  !mdstest  = TRUE
  !mdsarray = ARRAY()
  $P *******************************************************************************
  --clock
  --clock init

  -- CHECK ALL of the 5 PARAGON CATALOGUES exist
  do !indx indices !mdscatas
    !mdsindx = 0
    !mdscata = !mdscatas[!indx]
    handle NONE
      !mdsindx = !mdsindx + 1
      !mdsarray.append(!mdscata )
      !validstr   = !validstr & | | & !mdscata.name

    elsehandle ANY
      !errorstr   = !errorstr & | | & !mdscata.name
      !mdstest = FALSE

    endhandle
  enddo

  -- SET the object members .descriptioncheck and .errortext
  if (!mdstest.not()) then
    !this.descriptioncheck = FALSE
    !this.descerrortext    = |WARNING: The following MDS DEFAULTS Catalogue(s) | & !errorstr.trim() & | do NOT exist, and therefore will NOT be processed.|
    !this.descerrortype    = |WARNING|

  else
    !this.descriptioncheck = TRUE
    !this.descerrortext    = !validstr.trim()
    !this.descerrortype    = |ALLOK|

  endif

  -- Return if !mdsarray() is EMPTY and UNSET
  if (!mdsarray.empty()) or (!mdsarray.unset()) then
    !this.descriptioncheck = FALSE
    !this.descerrortext    = |ERROR: The MDS DEFAULTS PARAGON Catalogues do NOT exist|
    !this.descerrortype    = |ERROR|
    return

  endif

  ----------------------------------------------------------------------
  --
  -- ONLY PROCESS each of the VALID PARAGON CATALOGUES found to DETERMINE
  -- the MDS STANDARD Client Descriptions<DESC> and the Client Codes<CCOD>
  -- i.e. The CATA elements in the !mdsarray variable
  --
  ----------------------------------------------------------------------


  ----------------------------------------------------------------------
  -- Check if the MDS Ancillary Type EXISTS in the PARAGON MDS DEFAULTS
  -- CATALOGUE DATABASE and is it ACTIVE for the current PDMS Project
  --
  -- *** NOT REQUIRED HERE ***
  --  !mdsobject = object MDSSTANDARD(!mdsstd, !bore, |GENERAL|)
  ----------------------------------------------------------------------


  -- Initialise the Collection Object data for the "ACTIVE" PARAGON CATALOGUE
  -- SECTION elements in the current PDMS Project
  !type  = |SECTION|
  !filt  = object EXPRESSION(':mdsactive eq TRUE')
  !scope = ARRAY()
  !scope.appendarray(!mdsarray)

  -- Collect ALL of the DESPARS DATA Elements
  !sect  = object COLLECTION()
  !sect.filter(!filt)
  !sect.scope(!scope)
  !sect.type(!type)

  -- Collection Results Array
  !results = !sect.results()

  --<wd>23oct2006-temporary code ONLY!!!
  !xxsiz   = !results.size()
  $P
  $P ** VALID MDS DEFAULTS CATA SECTION elements with :MDSACTIVE = TRUE is ** !results.size() = $!xxsiz **
  $P


  if (!results.size().gt(0)) then
    -- Process the MDS Standard CLIENT DESCRIPTION and CLIENT CODE DATA elements in the !results Array
    -- SET ALL the Global Variables fo each of the MDS Standard CLIENT DESCRIPTIONS and CODES

    -- Process the Client DESCRIPTIONS<DESC> DATA elements
    -- Initialise the Collection Object data
    !type = |DATA|
    !filt = object EXPRESSION('DKEY eq |DESC|')
    !ccod = ARRAY()
    !ccod.append(!results)

    -- Collect ALL of the Client DESCRIPTION DATA Elements
    !data  = object COLLECTION()
    !data.filter(!filt)
    --!data.scope(!scope)
    !data.scope(!results)
    !data.type(!type)

    -- Collection Results Array
    !descresults = !data.results()
    -- GET the DATA Values, CREATE and SET the CLIENT DESCRIPTION GLOBAL Variables
    do !indy indices !descresults
      -- GET the MDS Standard CLIENT DESCRIPTION Global Variable Name
      !mdsstd = !descresults[!indy].owner.description.upcase().trim()
      -- SKIP if the SECTION belongs to the MDS CATALOGUE /MDS/HANGER/DEFAULTS and the
      if (!descresults[!indy].owner.owner.owner.owner.name.eq(|/MDS/HANGER/DEFAULTS|)) then
        if ( (!mdsstd.matchwild(|FH*|).not()) and (!mdsstd.matchwild(|VH*|).not()) ) then
          skip
        endif
      endif

      -- SET the "PIPE RESTS" Client DESCRIPTION<DESC> Global Variables
      if (!mdsstd.trim().match(|PIPE-REST-INLINE|).eq(1)) then
        !descpiperestinline  = $!descresults[$!indy].pprop
        !!descpiperestinline = !descpiperestinline.after(|-|).trim()
        -- Append the <DESCRIPTION> Global Variable NAME to the Object member .descgvararr
        -- e.g.!this.descgvararr[1] will typically be a string '!!descft09' etc...
        !this.descgvararr.append('!!descpiperestinline')

      elseif (!mdsstd.trim().match(|PIPE-REST|).eq(1)) then
        !descpiperest  = $!descresults[$!indy].pprop
        !!descpiperest = !descpiperest.after(|-|).trim()
        -- Append the <DESCRIPTION> Global Variable NAME to the Object member .descgvararr
        -- e.g.!this.descgvararr[1] will typically be a string '!!descft09' etc...
        !this.descgvararr.append('!!descpiperest')

      elseif (!mdsstd.trim().match(|RACK-REST|).eq(1)) then
        !descrackrest  = $!descresults[$!indy].pprop
        !!descrackrest = !descrackrest.after(|-|).trim()
        -- Append the <DESCRIPTION> Global Variable NAME to the Object member .descgvararr
        -- e.g.!this.descgvararr[1] will typically be a string '!!descft09' etc...
        !this.descgvararr.append('!!descrackrest')

      elseif (!mdsstd.trim().match(|HVAC-REST|).eq(1)) then
        !deschvacrest  = $!descresults[$!indy].pprop
        !!deschvacrest = !deschvacrest.after(|-|).trim()
        -- Append the <DESCRIPTION> Global Variable NAME to the Object member .descgvararr
        -- e.g.!this.descgvararr[1] will typically be a string '!!descft09' etc...
        !this.descgvararr.append('!!deschvacrest')

      else
        -- SET the remaining Client DESCRIPTION<DESC> Global Variables
        --skip if (!mdsstd.trim().match(|RACK-REST|).eq(1))
        --skip if (!mdsstd.trim().match(|HVAC-REST|).eq(1))
        skip if (!mdsstd.trim().match(|SPECIAL|).eq(1))
        !gvarname  = |!!desc| & !mdsstd
        !descvalu  = $!descresults[$!indy].pprop
        !descvalu  = !descvalu.trim()
        if (!descvalu.match(|-|).eq(1)) then
          !descvalu  = !descvalu.after(|-|).trim()
        endif
        $!gvarname = |$!<descvalu>|
        --$P **** $!gvarname = $!<descvalu> ****
        --
        -- Append the <DESCRIPTION> Global Variable NAME to the Object member .descgvararr
        -- e.g.!this.descgvararr[1] will typically be a string '!!descft09' etc...
        !this.descgvararr.append(!gvarname)

      endif
    enddo

    --clock read elapsed

    $P *** FINISHED LOADING MDS STANDARD *** Client DESCRIPTIONS ***
    $P *******************************************************************************

    --clock
    --clock init

    -- Process theClient CODE<CCOD> DATA elements
    -- Initialise the Collection Object data
    !type = |DATA|
    !filt = object EXPRESSION('DKEY eq |CCOD|')
    !ccod = ARRAY()
    !ccod.append(!results)

    -- Collect ALL of the Client CODE DATA Elements
    !data  = object COLLECTION()
    !data.filter(!filt)
    --!data.scope(!scope)
    !data.scope(!results)
    !data.type(!type)

    -- Collection Results Array
    !ccodresults = !data.results()
    -- GET the DATA Values, CREATE and SET the CLIENT CODE GLOBAL Variables
    do !indz indices !ccodresults
      -- GET the MDS Standard CLIENT CODE Global Variable Name
      !mdsstd = !ccodresults[!indz].owner.description.upcase().trim()
      -- SKIP if the SECTION belongs to the MDS CATALOGUE /MDS/HANGER/DEFAULTS and the
      if (!ccodresults[!indz].owner.owner.owner.owner.name.eq(|/MDS/HANGER/DEFAULTS|)) then
        if ( (!mdsstd.matchwild(|FH*|).not()) and (!mdsstd.matchwild(|VH*|).not()) ) then
          skip
        endif
      endif

      -- SET the PIPE REST Client Codes<CCOD>
      if (!mdsstd.trim().match(|PIPE-REST-INLINE|).eq(1)) then
        !!codepiperestinline = $!ccodresults[$!indz].pprop
        -- Append the <CLIENT CODE> Global Variable to the Object member .ccodgvararr
        -- e.g.!this.ccodgvararr[1] will typically be a string '!!codeft09' etc...
        !this.ccodgvararr.append('!!codepiperestinline')

      elseif (!mdsstd.trim().match(|PIPE-REST|).eq(1)) then
        !!codepiperest = $!ccodresults[$!indz].pprop
        -- Append the <CLIENT CODE> Global Variable to the Object member .ccodgvararr
        -- e.g.!this.ccodgvararr[1] will typically be a string '!!codeft09' etc...
        !this.ccodgvararr.append('!!codepiperest')

      elseif (!mdsstd.trim().match(|RACK-REST|).eq(1)) then
        !!coderackrest = $!ccodresults[$!indz].pprop
        -- Append the <CLIENT CODE> Global Variable to the Object member .ccodgvararr
        -- e.g.!this.ccodgvararr[1] will typically be a string '!!codeft09' etc...
        !this.ccodgvararr.append('!!coderackrest')

      elseif (!mdsstd.trim().match(|HVAC-REST|).eq(1)) then
        !!codehvacrest = $!ccodresults[$!indz].pprop
        -- Append the <CLIENT CODE> Global Variable to the Object member .ccodgvararr
        -- e.g.!this.ccodgvararr[1] will typically be a string '!!codeft09' etc...
        !this.ccodgvararr.append('!!codehvacrest')

      else
        -- SET the remaining Clinet Codes<CCOD>
        --skip if (!mdsstd.trim().match(|RACK-REST|).eq(1))
        --skip if (!mdsstd.trim().match(|HVAC-REST|).eq(1))
        skip if (!mdsstd.trim().match(|SPECIAL|).eq(1))
        !gvarname  = |!!code| & !mdsstd
        !ccodvalu  = $!ccodresults[$!indz].pprop
        $!gvarname = |$!<ccodvalu>|
        --$P **** $!gvarname = $!<ccodvalu> ****
        --
        -- Append the <CLIENT CODE> Global Variable to the Object member .ccodgvararr
        -- e.g.!this.ccodgvararr[1] will typically be a string '!!codeft09' etc...
        !this.ccodgvararr.append(!gvarname)

      endif
    enddo

  else
    -- SET the ERROR if NO "MDSACTIVE"/VALID SECTION elements found
    -- in ANY of the VALID MDS DEFAULTS PARAGON CATALOGUES found
    !this.descriptioncheck = FALSE
    !this.descerrortext    = |ERROR: The MDS DEFAULTS Catalogue(s) | & !validstr.trim() & | do NOT contain ANY VALID or ACTIVE MDS Standards |
    !this.descerrortype    = |ERROR|
  endif

  --clock read elapsed
  --clock
  $P *** FINISHED LOADING MDS STANDARD *** Client CODES ***
  $P *******************************************************************************

endmethod
--
--------------------------------------------------------------------------------
--
--define method

--endmethod
--
--------------------------------------------------------------------------------
--
