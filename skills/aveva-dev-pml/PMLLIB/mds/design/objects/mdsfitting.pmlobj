---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------

-- Define Object
define object mdsfitting
--
-- Object Members
--
-- MDS FITTING DBREF
  member .fitting is DBREF

-- MDS FITTING NAME
  member .fittingname is STRING

-- MDS FITTING FUNCTION
  member .function is STRING

-- MDS FITTING PURPOSE
  member .purpose is STRING

-- MDS FITTING ZDIST
  member .zdist is REAL

-- MDS FITTING DESPARS
  member .despars is ARRAY

-- MDS FITTING POSLINE
  member .posline is STRING

-- MDS FITTING SPREF
  member .spref is DBREF

-- MDS FITTING RULES
  member .rules is STRING

endobject
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
-- Constructor Method
define method .mdsfitting(!snipe is DBREF)

-- Initialise Variables
  !xce = !!ce
  !!ce = !snipe

-- Populate the DATA for each MDS SNIPE(FITTING) in a MDSFITTING object
  !this.fitting     = !snipe
  !this.fittingname = !snipe.name
  !this.function    = !snipe.function
  !this.purpose     = !snipe.purpose
  !this.zdist       = !snipe.zdis
  !this.despars     = !snipe.despar
  !this.posline     = !snipe.posline
  !this.spref       = !snipe.spref
  var !rules rules
  !this.rules       = !rules

-- Return to Original Element
  !!ce = !xce

endmethod
