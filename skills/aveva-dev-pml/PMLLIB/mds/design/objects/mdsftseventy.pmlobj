------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  associations()                   -
--  associations(ARRAY)              -
--  atta()                           ARRAY
--  buildStru(DBREF,ARRAY)           -
--  createDatum()                    -
--  createStru(STRING)               -
--  deleteSupp()                     -
--  direction(DIRECTION)             -
--  frmw()                           DBREF
--  getelemforuda()                  DBREF
--  markAtta()                       -
--  mdsFtSeventy()                   -
--  mdsFtSeventy(DBREF)              -
--  restoreMatref(ARRAY)             -
--  sref()                           DBREF               returns SREF atta
--  storeMatref()                    ARRAY
--  tmplArea()                       DBREF
--
define object MDSFTSEVENTY

-- Support Standard Type
  member .type       is STRING

-- Support Replacement Type
  member .replace    is STRING

  member .alias is STRING

-- reference to support
  member .stru is DBREF

-- DATUM atta reference
  member .datum is DBREF

  member .modify is BOOLEAN

  member .connections is ARRAY

-- ATTA reference array
  member .atta is ARRAY

-- Cross-Bars on support (Reference atta held)
  member .bars       is ARRAY

-- Length of cross bars
  member .barLen     is ARRAY

  member .joints is ARRAY
  member .position is BOOLEAN

  member .idcomp is DBREF
  member .idbran is DBREF

  member .aidNumber is REAL

  -- New Object Member ARRAY for Storing the MDS Support Associations OBJECTS (ASSOCs etc...)
  member .associations is ARRAY

  -- Form Storage for preliminary restoration
  member .preliminaryStore       is ARRAY

  member .attaRefPrelimStore       is ARRAY

  -- Array to store compensation information
  member .compensation is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:
--
-- Description: default onstructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]      [Description]
--
-- Return:
--   [Data Type]       [Description]
--
------------------------------------------------------------------------

define method .mdsFtSeventy()

  !this.type = 'FT70'
  !this.alias = 'FT70'
  !this.replace = !!mdsgetalias(!this.alias)

  !this.modify = false
  !this.position = false
  !this.aidNumber = 210

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsFtSeventy(!stru is DBREF)

  !this.mdsFtSeventy()
  !this.stru = !stru

  !this.datum = object DBREF(!stru.name & '/DATUM')
  if !this.datum.badref() then
    return error 1 'DATUM atta does not exist for support $!stru.name'
  endif
  !frmw = !this.frmw()
  handle ANY
    return error 1 'FRMW does not exist for support $!stru.name'
  endhandle
  !sref = !this.sref()
  handle ANY
    return error 1 'SREF atta does not exist for support $!stru.name'
  endhandle

  !this.modify = true
  !this.position = true
  !this.atta.clear()
  !this.atta.append(!this.datum)
  !this.atta.append(!sref)

  !crossbar = object DBREF(!this.stru.name & '-BAR-1')
  !this.bars[1] = !crossbar.:mdsattaref
  !this.barLen[1] = !crossbar.cutl

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .frmw() is DBREF

  !frmw = object DBREF(!this.stru.name & '/MAIN')
  handle ANY
    !frmw = nulref
  endhandle

  return !frmw

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      sref
--
-- Description: returns SREF atta
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sref() is DBREF

  !sref = object DBREF(!this.stru.name & '/SREF')
  handle ANY
    !sref = nulref
  endhandle

  return !sref

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .atta() is ARRAY

  !atta = ARRAY()
  do !item values !this.atta
    skip if !item.spre.badref()
    skip if !item.spown.name.eq('/MDF')
    !atta.append(!item)
  enddo

  return !atta

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createStru(!name is STRING)

  new STRU
  !!ce.name = !name
  !!ce.:mdsSuppType = !this.alias
  !this.stru = !!ce

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createDatum()

  !this.atta.clear()
  !isDatum = !this.datum.badref()
  if !this.preliminaryStore.set().and(!isDatum) then
    --do nothing
  else
    fconn
  endif
  !!ce.name = !this.stru.name & '/DATUM'
  !this.datum = !!ce
  !this.atta.append(!!ce)

  -- Create sref atta
  new ATTA sel spref with styp 'FT70-1' spec /MDF
  !!ce.name = !this.stru.name & '/SREF'
  fconnect
  !this.atta.append(!!ce)

  !!ce.spkbrk = true

  !this.markAtta()

  !!mdsSetIspe()
  !!mdsSelLstu(!!ce)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .markAtta()

  aid clear all $!this.aidNumber

  !!drawAidText('Datum',!this.datum.pos,!this.aidNumber)
  !attas = !this.atta()
  do !atta values !attas
    skip if !atta.name.match('/DATUM').gt(0)
    !tag = !atta.name.after(!this.stru.name & '.')
    !!drawAidText(!tag,!atta.pos,!this.aidNumber)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tmplArea() is DBREF

  !tmplArea = object DBREF('/MDS/FRAMES/' & !this.alias )
  handle ANY
    return error 1 'Cannot find templates for this configuration. Please contact your PDMS administrator'
  endhandle

  return !tmplArea

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .getelemforuda() is DBREF

  return !this.stru

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteSupp()

  !!ce = !this.stru
  handle NONE
    delete STRU
  elsehandle ANY
  endhandle

  do !atta values !this.atta
    skip if !atta.badref()
    !!ce = !atta
    delete ATTA
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .buildStru(!tmpl is DBREF,!dim is ARRAY)

  !hplane = object PLANE(!this.datum.ppos[9],Y is N wrt world and Z is U wrt world)
  !ydir = !this.datum.pdir[9].projected(!hplane)
  !hplane.orientation = object ORIENTATION('Y is ' & !ydir & ' and Z is U wrt world')
  --!leng = !dim[1]

  -- store material references
  !storeMatref = !this.storeMatref()

  !name = !this.stru.name
  !tmplfrmw = object DBREF(!tmpl.name & '-FRMW1')
  !!ce = !this.stru
  delete STRU memb
  !!ce.pos = !hplane.position
  !!ce.ori = !hplane.orientation
  !!ce.:mdscheck = !tmpl.:mdscheck
  !!ce.:mdsframirror = !tmpl.:mdsframirror
  !!ce.desc = !tmpl.desc

  new FRMW
  !!ce.name = !name & '/MAIN'
  copy attrib of $!tmplfrmw
  copy mem of $!tmplfrmw rename $!tmpl.name $!name

  !crossbar = object DBREF(!name & '-BAR-1')
  !!ce = !crossbar
  !!ce.:mdsattaref[1] = !this.datum
  if(!this.connections.unset()) then
    :MDSConn default
  else
    if !this.connections[1].badref().not() then
      !!ce.:mdsconn = !this.connections[1]
      handle ANY
      endhandle
    endif
  endif
  !plate = object DBREF(!name & '-PLT1')
  !up = !dim[1] - !dim[2]
  !down = !dim[2] - !plate.lohe
  extend start through U $!up
  extend end through D $!down
  !this.barLen[1] = !!ce.cutl

  -- restore material references
  !this.restoreMatref(!storeMatref)

  -- re-select SREF atta
  !!ce = !this.sref()
  !styp = 'FT70-' & !tmpl.sequ
  SEL SPREF WITH STYP '$!styp' SPEC /MDF
  !!ce.desp = !dim

  !!ce = !this.stru

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .direction(!ydir is DIRECTION)

  if !this.datum.badref() then
    return
  endif

  !!ce = !this.datum
  rotate about PL through PL and P9 is $!ydir
  !this.markAtta()

  if !this.frmw().badref() then
    return
  endif

  !this.stru.pos = !this.datum.ppos[9]
  !this.stru.ori = object ORIENTATION('Y is ' & !ydir)


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .storeMatref() is ARRAY

  !storeMatref = ARRAY()
  !members = !!collectAllFor('SCTN PANE','',!this.stru)
  do !memb values !members
    skip if !memb.isNamed.not()
    !data = object ANYDATASET(!memb.name)
    !data.setAttribute('matr',!memb.matr)
    !storeMatref.append(!data)
  enddo

  return !storeMatref

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .restoreMatref(!storeMatref is ARRAY)

  do !data values !storeMatref
    !!ce = !data.string().block().evaluate()
    handle ANY
      skip
    endhandle
    matref nulref
    !data.copyAttributesTo(!!ce)
  enddo

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .associations()
  !this.associations(object ARRAY())
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:
--
-- Description: Pair frame sections and picked items together and associate them
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .associations(!pick is ARRAY)
  !association = !this.associations
  --this method only works in conjunction with the mdsassociation object, mdsassowl objects
  --are not compatible
  if !association.size().gt(0) then
    if !association[1].objecttype().eq('MDSASSOWL') then
      return
    endif
  endif
  !paired = ARRAY()
  if !pick.size().eq(1) then
  	-- one pick means CLEARANCE
  	!paired[1] = !pick[1]
  	!paired[2] = !pick[1]
  elseif !pick.size().eq(2) then
  	-- CURSOR method so re-shuffle sequence of picks
  	do !c indices !association
  		!sctn = !association[!c].item()
  		!sctnline = !sctn.poss.line(!sctn.pose)
  		do !cc indices !pick
  			!dist[!cc] = !sctnline.distance(!pick[!cc][2])
  		enddo
  	  !index = !dist.sortedindices().first()
  	  !paired[!c] = !pick[!index][1]
  	enddo
  endif
  do !c indices !association
  	if defined(!paired[!c]) then
  		!association[!c].setAssociated(!paired[!c])
  	endif
  	!association[!c].associate()
  	handle ANY
  		!!alert.error(!!error.text)
  	endhandle
  enddo
  !this.associations = !association
endmethod
-- End of method
