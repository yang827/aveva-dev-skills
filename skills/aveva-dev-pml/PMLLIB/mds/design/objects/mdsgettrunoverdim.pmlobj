--
-- File:		Mdsgettrunoverdim.pmlfnc
-- Type:		Function Definition
-- Group:		Multi Discipline Supports Application
-- Keyword:	MDS
-- Module:	Design
-- Replaces:
--
-- Author:		Gordon Evans
-- Created:		19/09/2005
--
--
-- Description: Object to work out the overall trunnion dimension
--              and direction for Vertical Pipes
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsgettrunoverdim(DBREF,DBREF)   -
--  panehardtype(DBREF,DBREF)        -
--  sctnhardtype(DBREF,DBREF)        -
--
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        dbref        tee
--     2     R        dbref        section name
--
-- keys are
--
-- Return:
--    [Data Type]   [Description]
--    real          Returns the trunnion overall dimension
--    direction     Returns the direction of the trunnion
----------------------------------------------------------------------

-- Define Object

define object mdsgettrunoverdim

    member .verttrundim is REAL
    member .verttrundir is DIRECTION

-- End object
endobject


define method .mdsgettrunoverdim(!tee is DBREF, !str is DBREF)

  if (!str.hardtype eq 'SCTN') then
    !this.sctnhardtype(!tee,!str)
  endif

  if (!str.hardtype eq 'PANE') then
    !this.panehardtype(!tee,!str)
  endif

endmethod

define method .sctnhardtype(!tee is DBREF, !str is DBREF)

   !teepl = !tee.ldir.wrt(worl)
   !strline = !str.zdir.wrt(worl)
   !test = !teepl.isparallel(!strline)

  if (!test EQ FALSE) then
    !cross = !teepl.cross(!strline)
    !pv = object pointvector()
    !pv.position = !tee.ppos[3].wrt(/* )
   -- the dimension is in the direction of p3
    !pv.direction = !cross
    pin 1 at $!pv.position
    pin 1 direction $!pv.direction

    pin 2 copy pin 1
    pin 2 clear inf $!str

    pin 3 copy pin 1
    pin 3 clear beh $!str

    var !a const dist pin 1 to pin 2
    var !b const dist pin 1 to pin 3

    if (!a.real() gt !b.real()) then
     !res = !b.real()
     !pvdir = !pv.direction.opposite()
    else
     !res = !a.real()
     !pvdir = !pv.direction
    endif

-- return the dimension
$(
    $p ************************************************************************
    $p Direction is = $!pvdir Dist a = $!a Dist b = $!b res = $!res
    $p ************************************************************************
$)

   !this.verttrundir = !pvdir
   !this.Verttrundim = !res

   else
   -- $p is parrallel

    !naori = !str.plor.na.wrt(worl)
    !naxdir = !naori.xdir()
    !nazdir = !naori.zdir()

    !cross = !teepl.cross(!naxdir)
    !pv = object pointvector()
    !pv.position = !tee.ppos[3].wrt(/* )
   -- the dimension is in the direction of p3
    !pv.direction = !cross
    pin 1 at $!pv.position
    pin 1 direction $!pv.direction

    pin 2 copy pin 1
    pin 2 clear inf $!str

    pin 3 copy pin 1
    pin 3 clear beh $!str

    var !a const dist pin 1 to pin 2
    var !b const dist pin 1 to pin 3

    if (!a.real() gt !b.real()) then
     !resx = !b.real()
     !pvdirx = !pv.direction.opposite()
    else
     !resx = !a.real()
     !pvdirx = !pv.direction
    endif

    !cross = !teepl.cross(!nazdir)
    !pv = object pointvector()
    !pv.position = !tee.ppos[3].wrt(/* )
   -- the dimension is in the direction of p3
    !pv.direction = !cross
    pin 1 at $!pv.position
    pin 1 direction $!pv.direction

    pin 2 copy pin 1
    pin 2 clear inf $!str

    pin 3 copy pin 1
    pin 3 clear beh $!str

    var !a const dist pin 1 to pin 2
    var !b const dist pin 1 to pin 3

    if (!a.real() gt !b.real()) then
     !resz = !b.real()
     !pvdirz = !pv.direction.opposite()
    else
     !resz = !a.real()
     !pvdirz = !pv.direction
    endif


    if (!resz.real() gt !resx.real()) then
     !res = !resz
     !pvdir = !pvdirz
    else
     !res = !resx
     !pvdir = !pvdirx
    endif


-- return the dimension
$(
    $p ************************************************************************
    $p NA ori is = $!naori
    $p Direction Z is = $!pvdirz
    $p Direction X is = $!pvdirx
    $p Direction is = $!pvdir Dist a = $!a Dist b = $!b res = $!res
    $p ************************************************************************
$)

    !this.verttrundir = !pvdir
    !this.Verttrundim = !res
   endif


 !ARRAY = !!KClosestPline(!str,!tee.ppos[3].wrt(/* ),!this.verttrundir)
 pin 4 at $!ARRAY[2]
 var !truelen const dist pin 1 to pin 4
 !this.Verttrundim = !truelen.real()

-- q var !this.verttrundim
-- q var !this.verttrundir

  -- turn pin 1 to 4 off
  !!mdsresetpins( 1,4 )


endmethod

define method .panehardtype(!tee is DBREF, !str is DBREF)

   !teepl = !tee.ldir.wrt(worl)
   !strline = !str.zdir.wrt(worl)
   !test = !teepl.isparallel(!strline)

  if (!test EQ FALSE) then
    !cross = !teepl.cross(!strline)
    !pv = object pointvector()
    !pv.position = !tee.ppos[3].wrt(/* )
   -- the dimension is in the direction of p3
    !pv.direction = !cross
    pin 1 at $!pv.position
    pin 1 direction $!pv.direction

    pin 2 copy pin 1
    pin 2 clear inf $!str

    pin 3 copy pin 1
    pin 3 clear beh $!str

    var !a const dist pin 1 to pin 2
    var !b const dist pin 1 to pin 3

    if (!a.real() gt !b.real()) then
     !res = !b.real()
     !pvdir = !pv.direction.opposite()
    else
     !res = !a.real()
     !pvdir = !pv.direction
    endif

-- return the dimension
$(
    $p ************************************************************************
    $p Direction is = $!pvdir Dist a = $!a Dist b = $!b res = $!res
    $p ************************************************************************
$)

   !this.verttrundir = !pvdir
   !this.Verttrundim = !res

   else
   -- $p is parrallel

    !naori = !str.plor.na.wrt(worl)
    !naxdir = !naori.xdir()
    !nazdir = !naori.zdir()

    !cross = !teepl.cross(!naxdir)
    !pv = object pointvector()
    !pv.position = !tee.ppos[3].wrt(/* )
   -- the dimension is in the direction of p3
    !pv.direction = !cross
    pin 1 at $!pv.position
    pin 1 direction $!pv.direction

    pin 2 copy pin 1
    pin 2 clear inf $!str

    pin 3 copy pin 1
    pin 3 clear beh $!str

    var !a const dist pin 1 to pin 2
    var !b const dist pin 1 to pin 3

    if (!a.real() gt !b.real()) then
     !resx = !b.real()
     !pvdirx = !pv.direction.opposite()
    else
     !resx = !a.real()
     !pvdirx = !pv.direction
    endif

    !cross = !teepl.cross(!nazdir)
    !pv = object pointvector()
    !pv.position = !tee.ppos[3].wrt(/* )
   -- the dimension is in the direction of p3
    !pv.direction = !cross
    pin 1 at $!pv.position
    pin 1 direction $!pv.direction

    pin 2 copy pin 1
    pin 2 clear inf $!str

    pin 3 copy pin 1
    pin 3 clear beh $!str

    var !a const dist pin 1 to pin 2
    var !b const dist pin 1 to pin 3

    if (!a.real() gt !b.real()) then
     !resz = !b.real()
     !pvdirz = !pv.direction.opposite()
    else
     !resz = !a.real()
     !pvdirz = !pv.direction
    endif


    if (!resz.real() gt !resx.real()) then
     !res = !resz
     !pvdir = !pvdirz
    else
     !res = !resx
     !pvdir = !pvdirx
    endif


-- return the dimension
$(
    $p ************************************************************************
    $p NA ori is = $!naori
    $p Direction Z is = $!pvdirz
    $p Direction X is = $!pvdirx
    $p Direction is = $!pvdir Dist a = $!a Dist b = $!b res = $!res
    $p ************************************************************************
$)

    !this.verttrundir = !pvdir
    !this.Verttrundim = !res
   endif


 !ARRAY = !!KClosestPline(!str,!tee.ppos[3].wrt(/* ),!this.verttrundir)
 pin 4 at $!ARRAY[2]
 var !truelen const dist pin 1 to pin 4
 !this.Verttrundim = !truelen.real()

-- q var !this.verttrundim
-- q var !this.verttrundir

  -- turn pin 1 to 4 off
  !!mdsresetpins( 1,4 )


endmethod

