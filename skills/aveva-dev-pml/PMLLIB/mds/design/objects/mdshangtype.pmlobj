--   Type:  Object Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  DESIGN
--
--------------------------------------------------------------------------------
-- Description:
--
-- PML Object to determine the MDS Design Data etc... for the MDS HANGER TYPES etc..
-- from the MDS12 DEFAULTS PARAGON CATALOGUE Database CONVERTED from the latest MDS11.6*
-- version of the MDS DEFAULTS FILE "%MDSDFLTS%/DES-SUPP-HANG" from the MASTER PDMS
-- Project "MDS" CATA /MDS/HANGER/DEFAULTS
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdshangtype()                    -
--
define object MDSHANGTYPE

  -- Overall MDS HANGER DEFAULTS Check for the MDS DESIGN Application
  member .hangcodecheck is BOOLEAN

  -- Error text for missing MDS Standard HANGER DEFAULT CATALOGUE
  member .hangerrortext is STRING

  -- Continuation Error type found if ANY
  -- <1>--ALLOK   -- <ALLOW Entry to MDS DESIGN Apps>
  -- <2>--WARNING -- <ADVISE USER of WARNING and ALLOW Entry to MDS DESIGN Apps>
  -- <3>--ERROR   -- <ADVISE USER of ERROR and ABORT Entry to MDS DESIGN Apps>
  member .hangerrortype is STRING

  -- ARRAY members to store the Global Variable <DESC> !!dESCAT01 and <CCOD>!!cODEAT01 etc...
  --  member .descgvararr is ARRAY
  --  member .ccodgvararr is ARRAY

  -- ARRAY member to store the DATA elements
  member .hangcodearray is ARRAY

  -- End object
endobject
--
--------------------------------------------------------------------------------
-- Constructor Method .mdshangtype()
-- Arguments:
--
-- Return:
--
--------------------------------------------------------------------------------
-- Constructor Method
--
define method .mdshangtype()

  -- FROM the PARAGON CATALOGUE for the PDMS Project MDS HANGER APPLICATION DEFAULTS
  -- LOAD ALL of the "MDSACTIVE" PARAGON CATALOGUE DATA elements representing the MDS HANGER defaults <MDS Standard Code>
  -- e.g. /MDS/HABGER/DEFAULTS/.../GEN/CODE, accordingly for each MDS HANGER STANDARD type <FH* or VH*>

  -- Initialise Variable Array for the PARAGON CATALOGUES /MDS/HANGER/DEFAULTS
  !errorstr = ||
  !validstr = ||
  !mdstest  = TRUE
  !mdsarray = ARRAY()
  --$P *******************************************************************************
  --clock
  --clock init

  -- CHECK ALL of the PARAGON CATALOGUE exists
  !mdscata = /MDS/HANGER/DEFAULTS
  handle NONE
    !mdsarray.append(!mdscata )
    !validstr   = !validstr & | | & !mdscata.name

  elsehandle ANY
    !errorstr   = !errorstr & | | & !mdscata.name
    !mdstest = FALSE

  endhandle


  -- SET the object members .descriptioncheck and .errortext
  if (!mdstest.not()) then
    !this.hangcodecheck = FALSE
    !this.hangerrortext    = |WARNING: The following MDS DEFAULTS Catalogue(s) | & !errorstr.trim() & | do not exist, and therefore will not be processed.|
    !this.hangerrortype    = |WARNING|

  else
    !this.hangcodecheck = TRUE
    !this.hangerrortext    = !validstr.trim()
    !this.hangerrortype    = |ALLOK|

  endif

  -- Return if !mdsarray() is EMPTY and UNSET
  if (!mdsarray.empty()) or (!mdsarray.unset()) then
    !this.hangcodecheck = FALSE
    !this.hangerrortext    = |ERROR: The MDS HANGER DEFAULTS PARAGON Catalogue does not exist|
    !this.hangerrortype    = |ERROR|
    return

  endif

  ----------------------------------------------------------------------
  --
  -- ONLY PROCESS the VALID PARAGON CATALOGUE /MDS/HANGER/DEFAULTS
  -- found to DETERMINE the MDS STANDARD HANGER CODES
  -- i.e. The CATA element in the !mdsarray variable
  --
  ----------------------------------------------------------------------

  -- Initialise the Collection Object data for the "ACTIVE" PARAGON CATALOGUE
  -- SECTION elements in the current PDMS Project
  !type  = |DATA|
  !filt  = object EXPRESSION('DKEY eq |CODE| and :mdsactive of SECT eq TRUE and :mdsactive of CATE eq TRUE')
  !scope = ARRAY()
  !scope.appendarray(!mdsarray)

  -- Collect ALL of the MDS HANGER Standard types DATA Elements where !filt is TRUE
  !code  = object COLLECTION()
  !code.filter(!filt)
  !code.scope(!scope)
  !code.type(!type)

  -- Collection Results Array
  --!!results = !code.results()
  !results = !code.results()

  -- Process the MDS Standard CODE DATA elements in the !results Array
  if (!results.size().gt(0)) then

  else
    -- SET the ERROR if NO "MDSACTIVE"/VALID SECTION elements found
    -- in the VALID MDS HANGER DEFAULTS PARAGON CATALOGUE
    !this.hangcodecheck = FALSE
    !this.hangerrortext    = |ERROR: The MDS DEFAULTS Catalogue(s) | & !validstr.trim() & | do not contain ANY VALID or ACTIVE MDS Standards |
    !this.hangerrortype    = |ERROR|
  endif

  !this.hangcodearray = !results

endmethod
--
--------------------------------------------------------------------------------
