define object MDSHEALTHCHKDATA

  --object members

  member .outputmessage is ARRAY

  member .loadmessage is ARRAY

  member .totalsupporterrors is REAL
  member .numsupportschecked is REAL
  member .supporterrorflag is BOOLEAN
  member .supporterrors is REAL
  member .totalerrors is REAL
  member .ancilerrors is REAL

  member .totalsupportwarnings is REAL
  member .supportwarningflag is BOOLEAN
  member .supportwarnings is REAL
  member .totalwarnings is REAL

  member .supports is ARRAY
  member .asupports is ARRAY
  member .tsupports is ARRAY
  member .fsupports is ARRAY
  member .hSupports is ARRAY

  member .groupsupports is ARRAY

  member .support is MDSSUPPORT

  member .currentsupportname is STRING

  member .singlesupporttype is STRING

  member .integrityerrorarray is ARRAY
  member .integrityerrors is REAL
  member .integritywarnings is REAL
  member .integritymessages is REAL

  member .dim1 is REAL
  member .dim2 is REAL
  member .dim3 is REAL
  member .dim4 is REAL
  member .dim5 is REAL
  member .dim6 is REAL
  member .dim7 is REAL
  member .dim8 is REAL

  member .supporterrorarray is ARRAY

  member .currenterrorobject is MDSHEALTHCHKERROR

  member .currentgrouperrorobject is MDSHEALTHCHKERROR

  member .loadmessageheader is ARRAY

endobject

-------------------------------------------------------------------------
define method .runcheck()

  !storedce = !!ce

  !this.totalsupporterrors = 0
  !this.numsupportschecked = 0
  !this.totalerrors = 0
  !this.totalsupportwarnings = 0
  !this.totalwarnings = 0

  !this.supporterrorarray = ARRAY()

  !this.outputmessage = ARRAY()
  !this.outputmessage.append('--------------------------------------------------------------------------------')
  !this.outputmessage.append('********************************************************************************')
  !this.outputmessage.append('--------------------------------------------------------------------------------')
  !this.outputmessage.append('Start of MDS Health Check report')
  !this.outputmessage.append('--------------------------------------------------------------------------------')
  !this.outputmessage.append('********************************************************************************')
  !this.outputmessage.append('--------------------------------------------------------------------------------')
----------------------------------------------------------------------------
--**ALL SUPPORTS

  do !supportnoslash values !this.supports

    !this.numsupportschecked = !this.numsupportschecked + 1
    !this.supporterrorflag = FALSE
    !this.supportwarningflag = FALSE
    !this.supporterrors = 0
    !this.supportwarnings = 0

    --initialise mdshealthchkerror object to store errors for each support

    !this.currenterrorobject = object MDSHEALTHCHKERROR()
    !this.currenterrorobject.numerrors = 0
    !this.currenterrorobject.numwarnings = 0

    !support = '/' & !supportnoslash

    !this.currentsupportname = !support

    --!support = '/' & !support

    --if support name matches support in group array then

    !groupsupport = FALSE

    !this.groupsupports = !this.groupsupports.sortunique()

    --q var !this.groupsupports
    --$p groups
    do !i values !this.groupsupports
    --q var !i
    --q var !support
      if (!i.match(!support).gt(0)) then
        --$P match
        !this.currentgrouperrorobject = object MDSHEALTHCHKERROR()
        !this.currentgrouperrorobject.numerrors = 0
        !this.currentgrouperrorobject.numwarnings = 0

        !sizeoferrorarray = !this.supporterrorarray.size()
        !insertgrouperrorobj = !sizeoferrorarray + 1

        !this.currentgrouperrorobject.type = 'GROUP'

        !this.outputmessage.append('Checking group support $!support')
        !this.outputmessage.append('--------------------------------------------------------------------------------')

        !this.currentgrouperrorobject.name = !support

        !this.checkgroup(!support)

        --!this.supporterrorarray.append(!this.currenterrorobject)

        !this.supporterrorarray.insert(!insertgrouperrorobj,!this.currentgrouperrorobject)

        !this.outputmessage.append('********************************************************************************')
        !this.outputmessage.append('--------------------------------------------------------------------------------')

        !groupsupport = TRUE
      endif

    enddo

    if (!groupsupport.eq(FALSE)) then

      !unusedcheckmainsupportnameexists = !support.dbref()
      handle ANY
        if (!this.singlesupporttype.eq('HANGER')) then

          !this.currenterrorobject.type = 'HANGER'

          !this.outputmessage.append('Checking hanger support $!support')
          !this.outputmessage.append('--------------------------------------------------------------------------------')

          !this.currenterrorobject.name = !support

          !this.checkhanger(!support)

          !this.supporterrorarray.append(!this.currenterrorobject)

          !this.outputmessage.append('********************************************************************************')
          !this.outputmessage.append('--------------------------------------------------------------------------------')

          if (!this.supporterrorflag.eq(TRUE)) then
            !this.totalsupporterrors = !this.totalsupporterrors + 1
            !this.totalerrors = !this.totalerrors + !this.supporterrors
          endif
        elseif (!this.singlesupporttype.eq('TRUNNION')) then

          !this.currenterrorobject.type = 'TRUNNION'

          !this.outputmessage.append('Checking trunnion support $!support')
          !this.outputmessage.append('--------------------------------------------------------------------------------')

          !this.currenterrorobject.name = !support

          !this.checktrunnion(!support)

          !this.supporterrorarray.append(!this.currenterrorobject)

          !this.outputmessage.append('********************************************************************************')
          !this.outputmessage.append('--------------------------------------------------------------------------------')

          if (!this.supporterrorflag.eq(TRUE)) then
            !this.totalsupporterrors = !this.totalsupporterrors + 1
            !this.totalerrors = !this.totalerrors + !this.supporterrors
          endif

        endif
      elsehandle NONE
        !typeofsupport = !!mdsabatype(!support.dbref())

        if (!typeofsupport.eq('ANCILL')) then

          !this.currenterrorobject.type = 'ANCILLARY'

          !this.outputmessage.append('Checking ancillary support $!support')
          !this.outputmessage.append('--------------------------------------------------------------------------------')

          !this.currenterrorobject.name = !support

          !this.checkancillary(!support)

          !this.supporterrorarray.append(!this.currenterrorobject)

          !this.outputmessage.append('********************************************************************************')
          !this.outputmessage.append('--------------------------------------------------------------------------------')
          if (!this.supporterrorflag.eq(TRUE)) then
            !this.totalsupporterrors = !this.totalsupporterrors + 1
            !this.totalerrors = !this.totalerrors + !this.supporterrors
          endif

        elseif (!typeofsupport.eq('FRAME')) then

          !this.currenterrorobject.type = 'FRAME'

          !this.outputmessage.append('Checking framework support $!support')
          !this.outputmessage.append('--------------------------------------------------------------------------------')

          !this.currenterrorobject.name = !support

          !this.checkframe(!support)

          !this.supporterrorarray.append(!this.currenterrorobject)

          !this.outputmessage.append('********************************************************************************')
          !this.outputmessage.append('--------------------------------------------------------------------------------')

          if (!this.supporterrorflag.eq(TRUE)) then
            !this.totalsupporterrors = !this.totalsupporterrors + 1
            !this.totalerrors = !this.totalerrors + !this.supporterrors
          endif

          if (!this.supportwarningflag.eq(TRUE)) then
            !this.totalsupportwarnings = !this.totalsupportwarnings + 1
            !this.totalwarnings = !this.totalwarnings + !this.supportwarnings
          endif

        elseif (!typeofsupport.eq('HANGER')) then

          !this.currenterrorobject.type = 'HANGER'

          !this.outputmessage.append('Checking hanger support $!support')
          !this.outputmessage.append('--------------------------------------------------------------------------------')

          !this.currenterrorobject.name = !support

          !this.checkhanger(!support)

          !this.supporterrorarray.append(!this.currenterrorobject)

          !this.outputmessage.append('********************************************************************************')
          !this.outputmessage.append('--------------------------------------------------------------------------------')

          if (!this.supporterrorflag.eq(TRUE)) then
           !this.totalsupporterrors = !this.totalsupporterrors + 1
            !this.totalerrors = !this.totalerrors + !this.supporterrors
          endif

        elseif (!typeofsupport.eq('TRUNNION')) then

          !this.currenterrorobject.type = 'TRUNNION'

          !this.outputmessage.append('Checking trunnion support $!support')
          !this.outputmessage.append('--------------------------------------------------------------------------------')

          !this.currenterrorobject.name = !support

          !this.checktrunnion(!support)

          !this.supporterrorarray.append(!this.currenterrorobject)

          !this.outputmessage.append('********************************************************************************')
          !this.outputmessage.append('--------------------------------------------------------------------------------')

        endif
      endhandle
    endif
  enddo

--*** ANCILLARIES
 -- do !support values !this.asupports
    --!this.numsupportschecked = !this.numsupportschecked + 1
    --!this.supporterrorflag = FALSE
    --!this.supportwarningflag = FALSE
    --!this.supporterrors = 0
    --!this.supportwarnings = 0

    --!this.currentsupportname = !support

    --!support = '/' & !support
    --!this.outputmessage.append('--------------------------------------------------------------------------------')
    --!this.outputmessage.append('Checking ancillary $!support')
    --!this.outputmessage.append('--------------------------------------------------------------------------------')

    --!this.checkancillary(!support)

    --if !this.supporterrorflag.eq(TRUE) then
      --!this.totalsupporterrors = !this.totalsupporterrors + 1
      --!this.totalerrors = !this.totalerrors + !this.supporterrors
      --!this.outputmessage.append('Ancillary support $!support has $!this.supporterrors errors')
    --else
      --!this.outputmessage.append('No errors with ancillary support $!support')
    --endif

    --!this.outputmessage.append('')

  --enddo
--*** END ANCILLARIES SECTION
----------------------------------------------------------------------------
----------------------------------------------------------------------------
--*** FRAMEWORKS

  --do !support values !this.supports
    --!this.numsupportschecked = !this.numsupportschecked + 1
    --!this.supporterrorflag = FALSE
    --!this.supporterrors = 0
    --!this.supportwarningflag = FALSE
    --!this.supportwarnings = 0

    --!this.currentsupportname = !support

    --!support = '/' & !support
    --!this.outputmessage.append('Checking framework support $!support')
    --!this.outputmessage.append('--------------------------------------------------------------------------------')

    --!this.checkframe(!support)

  --enddo

--*** END FRAMEWORKS SECTION
----------------------------------------------------------------------------

  !this.outputmessage.append('Summary;')
  !this.outputmessage.append('')
  !this.outputmessage.append('Number of supports checked $!this.numsupportschecked')
  !this.outputmessage.append('')
  !this.outputmessage.append('Total number of supports with errors $!this.totalsupporterrors')
  !this.outputmessage.append('Total number of errors $!this.totalerrors')
  !this.outputmessage.append('')
  !this.outputmessage.append('Total number of supports with warnings $!this.totalsupportwarnings')
  !this.outputmessage.append('Total number of warnings $!this.totalwarnings')
  !this.outputmessage.append('--------------------------------------------------------------------------------')

  !this.outputmessage.append('End of MDS Health Check report')
  !this.outputmessage.append('--------------------------------------------------------------------------------')
  !this.outputmessage.append('********************************************************************************')
  !this.outputmessage.append('--------------------------------------------------------------------------------')

  !!ce = !storedce

endmethod
-------------------------------------------------------------------------
-------------------------------------------------------------------------
define method .loadsupports(!mode is STRING)

--loadmessage array to record errors found when loading, i.e. any supports or parts of supports not loaded into list
  !this.loadmessage = ARRAY()
  !this.loadmessageheader = ARRAY()

  !this.supports = ARRAY()
  !this.groupsupports = ARRAY()
  !this.singlesupporttype = 'UNSET'

  !dateandtimeobj = object MDSDATETIMEOBJ()

  !datemessage = 'Date Loaded: ' & !dateandtimeobj.daystring & '-' & !dateandtimeobj.monthstrabb & '-' & !dateandtimeobj.year
  !timemessage = 'Time Loaded: ' & !dateandtimeobj.hourstring & ':' & !dateandtimeobj.minutestring & ':' & !dateandtimeobj.secondstring
  !sess = current session
  !projobj = current project

  !currentprojmessage = 'Project: ' & !projobj.code()

  !usermessage = 'User: ' & !sess.user().name

  !processidmessage = 'Process ID: ' & !sess.uniqueid

  !usernamemessage = 'User Name: ' & !sess.name

  !userloginmessage = 'User Login: ' & !sess.login

  !hostmessage =  'Host: ' & !sess.host

  --Date
  !this.loadmessageheader.append(!datemessage)
  --Time
  !this.loadmessageheader.append(!timemessage)
  --User
  !this.loadmessageheader.append(!usermessage)
  --Project
  !this.loadmessageheader.append(!currentprojmessage)
  --User name
  !this.loadmessageheader.append(!usernamemessage)
  --User login
  !this.loadmessageheader.append(!userloginmessage)
  --Host
  !this.loadmessageheader.append(!hostmessage)
  --Process ID
  !this.loadmessageheader.append(!processidmessage)

      --!this.loadmessage.append('--------------------------------------------------------------------------------')
      --!this.loadmessage.append('********************************************************************************')
      --!this.loadmessage.append('--------------------------------------------------------------------------------')
      --!this.loadmessage.append('Start of MDS Health Check support loading report')
      --!this.loadmessage.append('--------------------------------------------------------------------------------')

  --BELOW SECTION OF CODE FROM MDSABASELSUPP.pMLFRM

  -- Collect all support frameworks from the design databases

  --var !support eval (NAME) for all STRU with (PURP OF ZONE eq 'SUPP')
  -- The attribute settings may be a range separated by a comma i.e. ','

  !support = ARRAY()
  !sval = !!mdsidsval.split(',')

  if (!mode.neq('CE')) then

    do !addsupports values !sval
      --PURP of ZONE eq SUPP
      var !support append eval (name) for all stru with ($!!mdsidsatt of zone eq '$!addsupports')
    enddo



-- Collect all support attachments from design database
    var !support append eval (NAME) for all ATTA $
    wi ((match(PURP OF SPEC OF SPREF,'MDS') neq 0))
    --$
    --and (match(NAME,'/DATUM') eq 0) $
    --and (match(NAME,'/SREF') eq 0))

    var !rests append eval (NAME) for all REST wi (PURP eq 'MDS') AND ((match(NAME,'/MDS/') eq 0))

    if (!rests.size().gt(0)) then

    !restindex = 1

    do !currentrest values !rests

      --remove '/REST' from name

      !splitrestarray = !currentrest.split('/')
      --q var !splitrestarray
      !currentrestsuppname = !splitrestarray[2]
      --$p currentrestsuppname
      --q var !currentrestsuppname
      !rests[!restindex] = !currentrestsuppname

      if (!currentrestsuppname.match('[').gt(0)) then
        --rest is part of a group
        --$p GROUP
        !splitarray = !currentrestsuppname.split('[')
        --q var !splitarray[1]
        !restgroupname = !splitarray[1]
        --append to groupsupports, append to this.supports at end of main section
        !restgroupnamewithslash = '/' & !restgroupname
        !this.groupsupports.append(!restgroupnamewithslash)
        --$p groupsupports is
        --q var !this.groupsupports
        !rests[!restindex] = !restgroupname
      else
        --rest not part of a group
        --append rests to this.supports at end of main loadsupports section
      endif

      !restindex = !restindex + 1

    enddo

    endif

  else
-- !mode = 'CE'
    do !addsupports values !sval
      var !support append eval (name) for all stru with ($!!mdsidsatt of zone eq '$!addsupports') for CE
    enddo


-- Collect all support attachments from design database
    var !support append eval (NAME) for all ATTA $
    wi ((match(PURP OF SPEC OF SPREF,'MDS') neq 0)) for CE
    --and (match(NAME,'/SREF') eq 0)) for CE
  --and (match(NAME,'/DATUM') eq 0) $
  --mjb--want to collect the DATUM attas so can collect structural supports from pipes/branches

    --collect all REST with purp MDS and do mdsgetsuppname, if not abort then load name in
    --load into temporary array, append at end of section, before sortunique

    var !rests append eval (NAME) for all REST wi (PURP eq 'MDS') for CE
    --$p collection of rests
    --q var !rests
    --if rests gt 0
    --do through rests, remove '/REST'
    --do group code

    if (!rests.size().gt(0)) then

    !restindex = 1

    do !currentrest values !rests

      --remove '/REST' from name

      !splitrestarray = !currentrest.split('/')
      --q var !splitrestarray
      !currentrestsuppname = !splitrestarray[2]
      --$p currentrestsuppname
      --q var !currentrestsuppname
      !rests[!restindex] = !currentrestsuppname

      if (!currentrestsuppname.match('[').gt(0)) then
        --rest is part of a group
        --$p GROUP
        !splitarray = !currentrestsuppname.split('[')
        --q var !splitarray[1]
        !restgroupname = !splitarray[1]
        --append to groupsupports, append to this.supports at end of main section
        !restgroupnamewithslash = '/' & !restgroupname
        !this.groupsupports.append(!restgroupnamewithslash)
        --$p groupsupports is
        --q var !this.groupsupports
        !rests[!restindex] = !restgroupname
      else
        --rest not part of a group
        --append rests to this.supports at end of main loadsupports section
      endif

      !restindex = !restindex + 1

    enddo

    endif

    if (!support.size().eq(0) AND !rests.size().eq(0)) then

      --set mdssilent to true to stop alert error
      !!mdssilent = TRUE
      if (!!mdsgetsuppname(!!ce).neq('ABORT')) then

        !test = !!mdsgetsuppname(!!ce)
        !unusedtestdbref = !test.dbref()
        handle ANY
          !testforhanger = !test & '/REST'
          !unusedtestforhangerfbref = !testforhanger.dbref()
          handle ANY
            --$p not a hanger
            --check sref atta exists,
          elsehandle NONE
            --$p hanger, but no atta - put in list

            !this.singlesupporttype = 'HANGER'
            --!this.supports.append(subs(!name,2))
            --!this.supports.append(subs(!test,2))
            --q var !this.supports

            --do group code here too
            if (!test.match('[').gt(0)) then

              !splitarray = !test.split('[')
              !groupname = !splitarray[1]
             !this.groupsupports.append(!groupname)
              !this.supports.append(subs(!groupname,2))
            else
             !this.supports.append(subs(!test,2))


            endif
            --singlesupporttype = unset, default
            --put name in list, only name in list, when check !this.singlesupporttype = hanger
            --for trunnion, set !this.singlesupporttype = trunnion
            --when can't get dbref of support name, check singlesupporttype
            --if hanger, then run checkhanger, check atta exists (check dbref)
            --still need to run group code!
            --if trunnion, run checktrunnion
          endhandle

          !mdsTrunofowner = !!ce.owner.:MDSTrun
          handle ANY
            !mdsTrunofowner = FALSE
          endhandle

          --test for trunnion - test name of branch (owner) and :mdstrun true
          if (!!ce.owner.name.match(!test).gt(0) and !mdsTrunofowner) then
          --!testforhanger = !test & '/REST'
          --!testforhangerfbref = !testforhanger.dbref()
            --$p TRUNNION SINGLE
            !this.supports.append(subs(!test,2))
            !this.singlesupporttype = 'TRUNNION'

          endif
        elsehandle NONE
          !support.append(!!mdsgetsuppname(!!ce))
        endhandle

        --!support.append(!!mdsgetsuppname(!!ce))

--<wd>apr2007 -- Added "elseif" statement for "ABORT" to add the ERROR to the LOADREPORT Only
      elseif (!!mdsgetsuppname(!!ce).eq('ABORT') ) then
        !this.loadmessage.append('Invalid/incomplete support element $!!ce.name not loaded into list. Check for SPREF unset?')
--<wd>apr2007

      endif
      -- Invalid MDS Supports are returned as 'ABORT'
      !!mdssilent.delete()
    endif

  endif

  --q var !support

  --remove any supports which return 'ABORT' from !!mdsgetsuppname()
  --note these supports in the loading report (they are too incomplete to be loaded into the form
  --and be checked)

  if (!this.singlesupporttype.eq('UNSET')) then

    !suppindex = 1

    do !thissupport value !support
      --q var !thissupport
      !!mdssilent = TRUE

      if (!!mdsgetsuppname(!thissupport.dbref()).eq('ABORT')) then
        --$p abort element $!thissupport

        !this.loadmessage.append('Invalid/incomplete support element $!thissupport not loaded into list. Check for SPREF unset?')
        !support.deletefrom(!suppindex,1)
      elseif (!thissupport.match('.').gt(0)) then
        --$P extra crossbar support
        --q var !!mdsgetsuppname(!thissupport.dbref())
        !support[!suppindex] = !!mdsgetsuppname(!thissupport.dbref())
      elseif (!thissupport.match('/MAKEUP').gt(0) OR !thissupport.match('/NOTE1').gt(0) OR !thissupport.match('/NOTE2').gt(0) OR !thissupport.match('/NOTE3').gt(0) OR !thissupport.match('/NOTE4').gt(0)) then

        --q var !!mdsgetsuppname(!thissupport.dbref())
        !support[!suppindex] = !!mdsgetsuppname(!thissupport.dbref())

      endif

      !suppindex = !suppindex + 1
    enddo
    !support.compress()
    --q var !support

    --!suppindex = 1
    --q var !order
    --do !currentsupport values !support
    --  if !currentsupport.match('/SREF').gt(0) then
    --   $p test
    --   if !!mdsabatype(!currentsupport.dbref()).neq('TRUNNION') then
    --      --delete
    --      $p 11
    --      !support.removefrom(!suppindex,1)
    --    else
    --      $p 22
    --      --remove '/SREF' from support name (leave in list)
    --      q var !support[!suppindex]
    --      !dave = !support[!suppindex].replace('/SREF','')
    --      --q var !dave
    --      !support[!suppindex] = !dave
    --      --!support[!suppindex] = !support[!suppindex].replace('/SREF','')
    --    endif
    --  endif
    --  !suppindex = !suppindex + 1
    --enddo

    --q var !support

    -- Sort collected supports
    var !order sort unique !support

    --do through list of supports
    --if name matches '/SREF' then
    --if mdsabatype.eq('TRUNNION'), keep, but remove the '/SREF'
    --else delete from list

    --!this.supports = ARRAY()
    --!this.groupsupports = ARRAY()
    --!fsupports = ARRAY()
    --!hSupports = ARRAY()
----<wd>feb2005
    --!asupports = ARRAY()
----<wd>feb2005
        -- !tsupports = ARRAY()

----The filter is unset so set it to *
       -- if !this.filter.val.eq('') then
       --   !this.filter.val = '*'
       -- endif

    do !i index !order
      !index = !order[!i]
----mjb
      if (!support[$!index].dbref().name.match('=')eq(1)) then
        !this.loadmessage.append('Unnamed support found $!support[$!index] not loaded into list')
      endif
----mjb end

---- Remove supports/attas with a suffix of '.1 to .99' or '/MAKEUP' or '/NOTE1 , /NOTE2 , /NOTE3, /NOTE4' in there name
      ---- skip unnamed elements
      skip if (!support[$!index].dbref().name.match('=')eq(1))
      !name = !support[$!index].dbref().flnm
      skip if (!name.match('.').gt(0))
      skip if (!name.match('/MAKEUP').gt(0))
      skip if (!name.match('/NOTE1').gt(0))
      skip if (!name.match('/NOTE2').gt(0))
      skip if (!name.match('/NOTE3').gt(0))
      skip if (!name.match('/NOTE4').gt(0))
-------------------
---->>wd<29jul2002>
---- Check for Support Type etc... before 'skipping...'
          --skip if (!name.dbref().mcount().eq(0))
      if (!name.dbref().type.eq('ATTA')) then
        if (!name.match('/DATUM').gt(0)) then
          !name = !name.replace('/DATUM','')
        endif
        --if name matches 'DATUM' then remove '/DATUM' from name.

        --***sortunique list once done to remove instances where both /DATUM and STRU of same support found.***

---------------------------------------------------
----<wd>feb2005 --
---- "Stand-Alone" MDS Ancillaries <ATTAS> may now be DRAWN via the MDS-ABA Drawing Utility
---- Therefore the PML CODE below has been "COMMENTED-OUT" so as NOT to EXCLUDE "Stand-Alone" MDS Ancillaries <ATTAS>
---- The PML function "!!mdsabatype(!name.dbref())" used below CHECKS the VALIDITY of the ATTA with regard to MDS.
---- SEE the --****** IMPORTANT NOTE ******-- and PML CODE below at APPROX. line 320

$(
----<wd>july2003
            skip if (!name.dbref().cref.badref())
----<wd>july2003
            skip if (!name.dbref().cref.unset()
            if (!name.dbref().cref.type.eq('HANG')) then
              skip if ((!name.dbref().cref.mcount().eq(0)) and (!name.dbref().cref.own.mcount().eq(1)))
            else
---- "Stand-Alone" MDS Ancillary <ATTA>
              skip if (!name.dbref().mcount().eq(0))
            endif
$)
----<wd>feb2005 --
---------------------------------------------------

      elseif (!name.dbref().type.eq('STRU')) then
      --  !sdatum = !name & '/DATUM'
      --  !!ce    = !sdatum.dbref()
      --  handle(2,109)
---- Undefined Name, e.g. DATUM Atta for STRU does NOT EXIST
      --    skip
      --  endhandle

        --skip if (!name.dbref().mcount().eq(0))
      endif

----<<wd<29jul2002>

      !groupsupportflag = FALSE

      if (!name.match('[').gt(0)) then
        --$P MATCH [
        !groupsupportflag = TRUE

        !splitarray = !name.split('[')
        !groupname = !splitarray[1]

        --!groupname = !name.replace('[','')
        --!groupname = !groupname.replace(']','')
        --length = !groupname.length()

        !this.groupsupports.append(!groupname)

        --q var !this.groupsupports
      endif

      --q var !name
-------------------
      skip if (!name.dbref().:mdssupptype.eq('unset'))
      --skip if (!name.dbref().:mdssupptype.eq(''))
      --!match = '*$!this.filter.val*'
      --if (!name.matchwild(!match).not()) then
      --  skip
      --endif
---- Setup sorted array

      !typeofsupport = !!mdsabatype(!name.dbref())

      if (!typeofsupport.neq('ERROR') AND !groupsupportflag.eq(FALSE)) then
        --$p name is $!name
        --!this.supports.append(!name)
        !this.supports.append(subs(!name,2))
        --q var !this.supports
      elseif (!groupsupportflag.eq(TRUE)) then
        !this.supports.append(subs(!groupname,2))
        --!this.supports.append(subs('$!support[$!index]',2))
      endif
---------------------------------------------------
----<wd>feb2005 --****** IMPORTANT NOTE ******--
---- The PML function "!!mdsabatype(!name.dbref())" used below contains code to CHECK if the ATTA, STRU or HANGER
---- is a VALID MDS SUPPORT type. The function returns the text "ERROR" if it is NOTHING to do with MDS and so the ATTA
---- DOES NOT get appended to any of the MDS SUPPORT arrays shown below.
----<wd>feb2005
---------------------------------------------------
---- Find out the type of support passed
      --!typeofsupport = !!mdsabatype(!name.dbref())
      --if !typeofsupport.eq('FRAME') then
      --  !this.fsupports.append(subs('$!support[$!index]',2))

      --elseif !typeofsupport.eq('HANGER') then
---- If a hanger is part of a group then do not put it in the list -- NOT DONE HERE but see line 306 approx. below
      --!this.hSupports.append(subs('$!support[$!index]',2))

----<wd>feb2005
      --elseif !typeofsupport.eq('ANCILL') then
      -- !spref = !support[$!index].dbref().spref.name
      -- if !spref.match('/MDP/').neq(1) then
      --   !this.asupports.append(subs('$!support[$!index]',2))
       -- endif
----<wd>feb2005

$(
          elseif !typeofsupport.eq('TRUNNION') then
             !tsupports.append(subs('$!support[$!index]',2))
$)

      --endif
    enddo

    --mjb sort supports to remove duplicates - if in All Below CE mode, and a DATUM atta and a STRU of the same support
    --mjb are below the CE in the hierarchy, duplicate names will be in the support list

    !suppindex = 1

    do !currentsupport values !this.supports
    --  q var !currentsupport
      !currentsupportwithslash = '/' & !currentsupport
      if (!currentsupportwithslash.match('/SREF').gt(0)) then
        if (!!mdsabatype(!currentsupportwithslash.dbref()).neq('TRUNNION') and !!mdsabatype(!currentsupportwithslash.dbref()).neq('FRAME')) then
          --delete
          !this.supports.removefrom(!suppindex,1)
        else
          --remove '/SREF' from support name (leave in list)
          --q var !this.supports[!suppindex]
          !nosref = !this.supports[!suppindex].replace('/SREF','')
          !nosrefnoslash = !nosref.replace('/','')
          --q var !dave
          !this.supports[!suppindex] = !nosrefnoslash
          --!support[!suppindex] = !support[!suppindex].replace('/SREF','')
        endif
      endif
      !suppindex = !suppindex + 1
    enddo

  endif

  --$P SUPP
  --q var !this.supports

  --insert any rests collected (main support name only), then sort unique to remove all duplicates
  --q var !rests
  !this.supports.appendarray(!rests)
  handle ANY
  endhandle
  --$p group supports at end
  --q var !this.groupsupports
  !this.supports.compress()
  !this.supports = !this.supports.sortunique()

  --!numsuppsloaded = !this.supports.size()
  --$p test at end
  --q var !this.supports
  --!this.loadmessage.append('Number of supports loaded for checking = $!numsuppsloaded')
  --!this.loadmessage.append('--------------------------------------------------------------------------------')
  --!this.loadmessage.append('End of MDS Health Check support loading report')
  --!this.loadmessage.append('--------------------------------------------------------------------------------')
  --!this.loadmessage.append('********************************************************************************')
  --!this.loadmessage.append('--------------------------------------------------------------------------------')
  --q var !this.supports
--****IF ANCIL/FRAM/HANG/TRUN HERE***

  --do !removeHangers from 1 to !this.hSupports.size()
  --  if !this.hSupports[$!removeHangers].match('[').gt(0) and !this.hSupports[$!removeHangers].match(']').gt(0) then
  --    !this.hSupports[$!removeHangers].delete()
  --  endif
  --enddo
  --!this.hSupports.compress()

endmethod
-------------------------------------------------------------------------
define method .checkgroup(!support is STRING)
  --checking group

  --message checking group support PS04565

  --collect all the group members (loop through [1], [2] etc with dbref(), if no error add to array

  --check stru PS04565[1] (call checkframe)

  --check it is a STRU first, if not error

  !arrayofgroupmembers = ARRAY()

  do !i from 1 to 20 by 1

    !groupmember = !this.currentsupportname & '[' & !i.string() & ']'
    --q var !groupmember
    !check = !groupmember.dbref()
    handle ANY
      --$P 1
      !testforahanger = !groupmember & '/REST'
      !test = !testforahanger.dbref()
      handle ANY
        --do not add to group - no hanger exists
      elsehandle NONE
        --groupmember hanger atta does not exist, but REST does so still want to check it
        !arrayofgroupmembers.append(!groupmember)
      endhandle
    elsehandle NONE
      --$p 2
      !arrayofgroupmembers.append(!groupmember)
    endhandle
    --DBREF CHECK HERE
  enddo

  --q var !arrayofgroupmembers

  --check [1] is stru, checkframe it

  if (!arrayofgroupmembers[1].neq(!this.currentsupportname & '[1]')) then
    -- [1] must exist in group error
    !this.currentgrouperrorobject.errorarray.append('**   Error  ** - Group member [1] does not exist, or is not a valid support')
    !this.currentgrouperrorobject.errorarray.append('Support Group Name             = $!this.currentsupportname')
    !this.currentgrouperrorobject.errorarray.append('--------------------------------------------------------------------------------')

    !this.supporterrors = !this.supporterrors + 1
    !this.supporterrorflag = TRUE
  elseif (!arrayofgroupmembers[1].dbref().type.neq('STRU')) then
    --[1] not-stru error
    !this.currentgrouperrorobject.errorarray.append('**   Error  ** - Group member [1] must be a structural support (STRU)')
    !this.currentgrouperrorobject.errorarray.append('Support Group Member Name             = $!arrayofgroupmembers[1]')
    !this.currentgrouperrorobject.errorarray.append('--------------------------------------------------------------------------------')

    !this.supporterrors = !this.supporterrors + 1
    !this.supporterrorflag = TRUE
  else
    --[1] exists and is stru, so check it, then check each remaining member is a hanger, then check them

    !this.currenterrorobject = object MDSHEALTHCHKERROR()
    !this.currenterrorobject.numerrors = 0
    !this.currenterrorobject.numwarnings = 0
    !this.currenterrorobject.name = !arrayofgroupmembers[1]
    !this.currenterrorobject.type = 'FRAME'

    !this.checkframe(!arrayofgroupmembers[1])

    !this.supporterrorarray.append(!this.currenterrorobject)

    do !j from 2 to !arrayofgroupmembers.size() by 1
      --q var !j

      !this.currenterrorobject = object MDSHEALTHCHKERROR()
      !this.currenterrorobject.numerrors = 0
      !this.currenterrorobject.numwarnings = 0
      !this.currenterrorobject.name = !arrayofgroupmembers[!j]
      !this.currenterrorobject.type = 'HANGER'

      if (!arrayofgroupmembers[!j].neq(!this.currentsupportname & '[' & !j.string() & ']')) then
        --order error (e.g. 2nd support found, and put in arrayofgroupmembers is not numbered [2])
        !this.currentgrouperrorobject.errorarray.append('**   Error  ** - Group members not ordered in sequence ([1],[2],[3]')
        !this.currentgrouperrorobject.errorarray.append('Support Group Name             = $!this.currentsupportname')
        !this.currentgrouperrorobject.errorarray.append('--------------------------------------------------------------------------------')

        !this.supporterrors = !this.supporterrors + 1
        !this.supporterrorflag = TRUE
      endif

      --!this.supporterrorarray.append(!this.currenterrorobject)

      !unusedtesthangeratta = !arrayofgroupmembers[!j].dbref()
      handle ANY
        !secondtestforahanger = !arrayofgroupmembers[!j] & '/REST'
        !unusedanothertest = !secondtestforahanger.dbref()
        handle ANY
          --atta and hanger (REST) do not exist, so do not add as group member
        elsehandle NONE
          --REST exists (atta doesn't), still run checkhanger
          --create new error object
          !this.checkhanger(!arrayofgroupmembers[!j])
          --append to supporterrorarray
          !this.supporterrorarray.append(!this.currenterrorobject)
        endhandle
      elsehandle NONE

        if (!!mdsabatype(!arrayofgroupmembers[!j].dbref()).eq('HANGER')) then
          --hanger found, check hanger
          !this.checkhanger(!arrayofgroupmembers[!j])

          !this.supporterrorarray.append(!this.currenterrorobject)
        else
          --error, group member not hanger
          !this.currentgrouperrorobject.errorarray.append('**   Error  ** - All group members other than [1] must be hangers')
          !this.currentgrouperrorobject.errorarray.append('Support Group Member Name             = $!arrayofgroupmembers[!j]')
          !this.currentgrouperrorobject.errorarray.append('--------------------------------------------------------------------------------')

          !this.supporterrors = !this.supporterrors + 1
          !this.supporterrorflag = TRUE
          --***IF NOT HANGER, CHECK ANYWAY?***
        endif
      endhandle
    enddo
  endif

  --check all other ,[2] to end of array, are hangers

  --hanger check each one

  --check hangers PS04565[1], [2], ... (call checkhanger)

  --check number order is ok

  !this.currenterrorobject.numerrors = !this.supporterrors

  !this.currenterrorobject.numwarnings = !this.supportwarnings

  if (!this.supporterrorflag.eq(TRUE)) then
    !this.totalsupporterrors = !this.totalsupporterrors + 1
    !this.totalerrors = !this.totalerrors + !this.supporterrors

    !this.outputmessage.append('Group support $!support has $!this.supporterrors errors')
  else
    !this.outputmessage.append('No errors with group support $!support')
  endif

  if (!this.supportwarningflag.eq(TRUE)) then
    !this.totalsupportwarnings = !this.totalsupportwarnings + 1
    !this.totalwarnings = !this.totalwarnings + !this.supportwarnings

    !this.outputmessage.append('Group support $!support has $!this.supportwarnings warnings')
  else
    !this.outputmessage.append('No warnings with group support $!support')
  endif

  !this.outputmessage.append('--------------------------------------------------------------------------------')

endmethod
-------------------------------------------------------------------------
define method .checkhanger(!support is STRING)
  --$p checking hanger

  !unusedtestforatta = !support.dbref()
  handle ANY
    !this.currenterrorobject.errorarray.append('**   Error  ** - Hanger ATTA does not exist')
    !this.currenterrorobject.errorarray.append('Hanger Support Name             = $!support')
    !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
    !this.supporterrors = !this.supporterrors + 1
    !this.supporterrorflag = TRUE
  elsehandle NONE

    --check !!mdsHangIF

    --record

    --if !!mdsHangIF is 'MDS' check spref of atta is /MDS/stype...
    --if !!mdsHangIF is not 'MDS' e.g. LISEGA, then check spref of atta is /MDS/MH01...

    !mdsHangIF = !!mdsrecognizehangerif(!support.dbref()) $* !mdsHangIF
    if (!mdsHangIF.eq('')) then
    !mdsHangIF = !!mdsHangIF
    endif

    !suppstype = !support.dbref().stype
    !sprefname = !support.dbref().spref.name

    if (!mdsHangIF.eq('MDS')) then
      --hangers should have MDS spref

      if (!sprefname.match('/MDS/$!suppstype').eq(0)) then
        --hanger spref does not match e.g.e /MDS/FH01
        if (!sprefname.match('/MDS/MH01').eq(0)) then
          --hanger spref matches /MDS/MH01, so interface hanger found
          !this.currenterrorobject.errorarray.append('**   Error  ** - Hanger SPREF set to /MDS/MH01 (interface hangers), !!mdsHangIF set to MDS')
          !this.currenterrorobject.errorarray.append('Hanger Support Name             = $!support')
          !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
          --mdshangif set to MDS, hanger spref is for interface hanger (mixture)
        else
          !this.currenterrorobject.errorarray.append('**   Error  ** - Invalid SPREF')
          !this.currenterrorobject.errorarray.append('SPREF expected to match /MDS/$!suppstype')
          !this.currenterrorobject.errorarray.append('SPREF                      = $!sprefname')
          !this.currenterrorobject.errorarray.append('Hanger Support Name             = $!support')
          !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

        endif
        !this.supporterrors = !this.supporterrors + 1
        !this.supporterrorflag = TRUE
      endif

    else

      if (!sprefname.match('/MDS/MH01').eq(0)) then
        --error, mdshangif not set to MDS, but hanger spref is for interface hanger
        !this.currenterrorobject.errorarray.append('**   Error  ** - Hanger SPREF not set to /MDS/MH01 (interface hangers), !!mdsHangIF not set to MDS')
        !this.currenterrorobject.errorarray.append('Hanger Support Name             = $!support')
        !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

        !this.supporterrors = !this.supporterrors + 1
        !this.supporterrorflag = TRUE
      endif

    endif

    !cref = !support.dbref().cref
    !restraint = !cref.owner.name

    --check name consistent across all components of hanger e.g. /PS05727 , /PS05727/REST , /PS05727/HANG

    --collect all hangs of rest, check rest and all hangs match support name

    --if restname doesn't match supportname, error

    if (!restraint.match(!support).eq(0)) then
      !this.currenterrorobject.errorarray.append('**   Error  ** - Hanger REST name does not match support name')
      !this.currenterrorobject.errorarray.append('Hanger Support Name             = $!support')
      !this.currenterrorobject.errorarray.append('Hanger REST Name             = $!restraint')
      !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

      !this.supporterrors = !this.supporterrors + 1
      !this.supporterrorflag = TRUE

    endif

    --do through array of hangs, if hangername doesnt match supportname, error

    var !hangcoll coll all hang for $!restraint

    do !hangdbref values !hangcoll

      !hangname = !hangdbref.dbref().name

      if (!hangname.match(!support).eq(0)) then
        !this.currenterrorobject.errorarray.append('**   Error  ** - HANG name does not match support name')
        !this.currenterrorobject.errorarray.append('Hanger Support Name             = $!support')
        !this.currenterrorobject.errorarray.append('Hanger HANG Name             = $!hangname')
        !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

        !this.supporterrors = !this.supporterrors + 1
        !this.supporterrorflag = TRUE
      endif

    enddo

    !prehangcheckce = !!ce

    !!ce = !restraint.dbref()

    --check restraint e.g. RESTRAINT /PS05820/REST with data consistency checker
    --output to temporary file, then into output array in similar format to other errors
    --delete temporary file

    ALPHA FILE /%pdmswk%/hangercheck.txt  OVER
    check ce
    ALPHA FILE END

    !hangercheck = object FILE('%pdmswk%/hangercheck.txt')

    !hangercheck.open('READ')
    !hangercheckarray = !hangercheck.readfile()
    !hangercheck.close()
    !hangercheck.deletefile()

    --q var !hangercheckarray

    if (!hangercheckarray[4].match('NO DATA INCONSISTENCIES').eq(0)) then
    --there are errors, manipulate array !hangercheckarray into error message format as used for other supports (e.g. ancillaries)

      !hNutArray = ARRAY()
    !indexofHNUTarray = ARRAY()
    !index = 1

      do !hangerchecklines values !hangercheckarray
        --q var !hangerchecklines
        if (!hangerchecklines.match('=').gt(0)) then
          --q var !hangerchecklines
          !hNutArray.append(!hangerchecklines.trim())
          !indexofHNUTarray.append(!index)
        endif

        !index = !index + 1
      enddo
      --q var !hNutArray
      --q var !indexofHNUTarray
      !t = !indexofHNUTarray[1] + 1
      --q var !t
      --q var !hangercheckarray[4]

      !errorarray = ARRAY()
      !elementarray = ARRAY()
      !additionalinfoarray = ARRAY()
      !dIndice = 0

      --do loop for each line of HNUTarray e.g. array of each element with errors
      do !i from 1 to !hNutArray.size()
        !from = !indexofHNUTarray[!i] + 1

        if (!i.neq(!hNutArray.size())) then
          !to = !indexofHNUTarray[(!i + 1)] - 1
        else
          !to = !hangercheckarray.size() - 1
        endif

        !hangcheckfrom = !hangercheckarray[!from]
        !hangcheckto = !hangercheckarray[!to]
        --do loop for each line between each component, e.g. HNUT, lines may be e.g 'D620 Bad arrive' or 'Tolerance angle 55.5'
        do !j from $!from to $!to

          !line = !hangercheckarray[!j].trim()
          if (!line.substring(1,1).eq('D')) then
            --e.g. D420 error message, add 1 to DIndice and store error message and element name and dbref in arrays
            !dIndice = !dIndice + 1
            !errorarray[!dIndice] = !line
            !elementarray[!dIndice] = !hNutArray[!i]
            !additionalinfoarray[!dIndice] = ''
          else
            --no 'D' at start of line so store line in additionalinfo array, indices by DIndice
            !additionalinfoarray[!dIndice] = !line
          endif

        enddo

      enddo

      !errorarrayindice = 1

      do !k values !errorarray

        !this.currenterrorobject.errorarray.append('**   Error  ** - ' & !k)
        --!this.currenterrorobject.errorarray.append(!k)
        !this.currenterrorobject.errorarray.append('Element name and dbref          ' & !elementarray[!errorarrayindice])
        if (!additionalinfoarray[!errorarrayindice].neq('')) then
          !this.currenterrorobject.errorarray.append(!additionalinfoarray[!errorarrayindice])
        endif
        !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
        !this.supporterrors = !this.supporterrors + 1
        !this.supporterrorflag = TRUE

        !errorarrayindice = !errorarrayindice + 1
      enddo
    else
      --no dataconn errors with hanger (RESTraint)

    endif

    !!ce = !prehangcheckce

  endhandle

  !this.currenterrorobject.numerrors = !this.supporterrors

  !this.currenterrorobject.numwarnings = !this.supportwarnings

  if (!this.supporterrorflag.eq(TRUE)) then
    --!this.totalsupporterrors = !this.totalsupporterrors + 1
    --!this.totalerrors = !this.totalerrors + !this.supporterrors

    !this.outputmessage.append('Hanger support $!support has $!this.supporterrors errors')
  else
    !this.outputmessage.append('No errors with hanger support $!support')
  endif

  if (!this.supportwarningflag.eq(TRUE)) then
    --!this.totalsupportwarnings = !this.totalsupportwarnings + 1
    --!this.totalwarnings = !this.totalwarnings + !this.supportwarnings

    !this.outputmessage.append('Hanger support $!support has $!this.supportwarnings warnings')
  else
    !this.outputmessage.append('No warnings with hanger support $!support')
  endif

  !this.outputmessage.append('--------------------------------------------------------------------------------')

endmethod
-------------------------------------------------------------------------
-------------------------------------------------------------------------
define method .checktrunnion(!support is STRING)
  --$p checking trunnion $!support

  !pretrunnioncheckce = !!ce

  !trunnionsref = !support & '/SREF'

  --check SREF atta exists, if it doesn't stop check

  !srefdbref = !trunnionsref.dbref()
  handle ANY
    !this.currenterrorobject.errorarray.append('**   Error  ** - Incomplete support; no SREF atta')
    !this.currenterrorobject.errorarray.append('Trunnion Support Name             = $!support')
    !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
    !this.supporterrors = !this.supporterrors + 1
    !this.supporterrorflag = TRUE
  elsehandle NONE

    --check name is pipe and trunn name

    !trunbranname = !trunnionsref.dbref().owner.name

    !pipename = !trunnionsref.dbref().owner.href.owner.owner.name
      handle ANY
        !pipename = !trunnionsref.dbref().owner.owner.name
      endhandle

    !nameshouldbe = !pipename & !support

    !trunnionbranchname = !trunnionsref.dbref().owner.name

    if (!nameshouldbe.neq(!trunbranname)) then
      !this.currenterrorobject.errorarray.append('**   Error  ** - Name of trunnion branch should be name of pipe concatenated with name of support')
      !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
      !this.currenterrorobject.errorarray.append('Trunnion Branch Name      = $!trunnionbranchname')
      !this.currenterrorobject.errorarray.append('Pipe Name                 = $!pipename')
      !this.currenterrorobject.errorarray.append('Expected Trunnion Branch Name      = $!nameshouldbe')
      !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
      !this.supporterrors = !this.supporterrors + 1
      !this.supporterrorflag = TRUE
    endif

    --:MDSTRUN check, NB THIS CHECK ALWAYS FINDS MDSTRUN TO BE TRUE, AS THE TRUNNION IS NOT
    --LOADED INTO THE LIST IF IT IS FALSE AS MDSABATYPE RETURNS ERROR

    !mdsTrun =!trunnionsref.dbref().owner.:MDSTrun
    !trunbran = !trunnionsref.dbref().owner

    if (!mdsTrun.eq(FALSE)) then
      !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSTrun set to FALSE at trunnion BRAN')
      !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
      !this.currenterrorobject.errorarray.append('Trunnion Branch Name      = $!trunnionbranchname')
      !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
      !this.supporterrors = !this.supporterrors + 1
      !this.supporterrorflag = TRUE
    else

    --check trunnion is configured correctly as an MDS trunnion
    --for a trunnion on a straight pipe (on a tee)
    --see mdsselectcomp.pmlfnc for checks
    --name of element trunnion attached to
    !elementname = !trunbran.href.name
      handle NONE

--<wd>apr2007 -- "if/else/endif" STATEMENT added to CHECK for a VALID SPREF, "UNSET or BADREF", at the TRUNNION Branch HREF
       if (!trunbran.href.spref.badref()) then
         !this.currenterrorobject.errorarray.append('**   Error  ** - The SPREF of the Trunnion Branch HREF element is "UNSET or has an ILLEGAL REFERENCE"')
         !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
         !this.supporterrors = !this.supporterrors + 1
         !this.supporterrorflag = TRUE

       else
--<wd>apr2007

          if (!trunbran.href.type.eq('TEE')) then
          --q var !trunbran.href.skey
            if (!trunbran.href.skey.neq('TESO')) then
            !this.currenterrorobject.errorarray.append('**   Error  ** - SKEY of TEE not set to TESO')
            !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
            !this.currenterrorobject.errorarray.append('Tee Name       $!elementname')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          endif

          !temp = ARRAY()
          !temp[1] = !trunbran.href.ppbor[1]
          !temp[2] = !trunbran.href.ppbor[2]
          !temp[3] = !trunbran.href.ppbor[3]
          !temp[4] = !trunbran.hbo

          !temp.sortunique()
          --q var !temp.size()
            if (!temp.size().neq(1)) then
            --error all bores must be equal
            !this.currenterrorobject.errorarray.append('**   Error  ** - Bore of PPoints P1, P2, P3 of tee and HBORE of trunnion branch must be the same')
            !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
            !this.currenterrorobject.errorarray.append('Tee Name       $!elementname')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          endif

            if (!trunbran.href.ppos[1].wrt( /* ).neq(!trunbran.href.ppos[3].wrt( /* ))) then
            --P1 and P3 not in same position
            !this.currenterrorobject.errorarray.append('**   Error  ** - PPoints P1 and P3 of tee not in same position')
            !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
            !this.currenterrorobject.errorarray.append('Tee Name      $!elementname')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          endif

            if (!trunbran.href.owner.pspe.name.split('/')[2].neq(!trunbran.href.spref.name.split('/')[2])) then
            --Tee with trunnion attached does not match pipe spec of main pipe branch
            !this.currenterrorobject.errorarray.append('**   Error  ** - SPREF of tee does not match PSPE of main pipe branch')
            !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
            !this.currenterrorobject.errorarray.append('Tee Name      $!elementname')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          endif

          elseif (!trunbran.href.type.eq('ELBO') OR !trunbran.href.type.eq('BEND')) then

            if (!trunbran.href.ppls.find(3).size().neq(1)) then
            !this.currenterrorobject.errorarray.append('**   Error  ** - PPoint P3 does not exist on elbow')
            !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
            !this.currenterrorobject.errorarray.append('Elbow Name      $!elementname')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          else

              if (!trunbran.href.ppos[1].wrt( /* ).neq(!trunbran.href.ppos[3].wrt( /* ))) then
              --P1 and P3 not in same position
              !this.currenterrorobject.errorarray.append('**   Error  ** - PPoints P1 and P3 of elbow not in same position')
              !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
              !this.currenterrorobject.errorarray.append('Elbow Name      $!elementname')
              !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
              !this.supporterrors = !this.supporterrors + 1
              !this.supporterrorflag = TRUE
            endif

              if (!trunbran.href.pdir[1].wrt( /* ).neq(!trunbran.href.pdir[3].wrt( /* ).opposite())) then
              --$p not same
              !this.currenterrorobject.errorarray.append('**   Error  ** - PPoints P1 and P3 of elbow not in opposite direction')
              !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
              !this.currenterrorobject.errorarray.append('Elbow Name      $!elementname')
              !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
              !this.supporterrors = !this.supporterrors + 1
              !this.supporterrorflag = TRUE
            endif

              if (!trunbran.href.ppbor[1].neq(!trunbran.href.ppbor[3])) then
              --P1 and P3 of elbow must have the same bore
              !this.currenterrorobject.errorarray.append('**   Error  ** - PPoints P1 and P3 of elbow must have the same bore')
              !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
              !this.currenterrorobject.errorarray.append('Reducer Name      $!elementname')
              !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
              !this.supporterrors = !this.supporterrors + 1
              !this.supporterrorflag = TRUE
            endif

          endif
          --q var !trunbran.href.owner.pspe
          --q var !trunbran.href.spref

            if (!trunbran.href.owner.pspe.name.split('/')[2].neq(!trunbran.href.spref.name.split('/')[2])) then
            --Elbow with trunnion attached does not match pipe spec of main pipe branch
            !this.currenterrorobject.errorarray.append('**   Error  ** - SPREF of elbow does not match PSPE of main pipe branch')
            !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
            !this.currenterrorobject.errorarray.append('Elbow Name      $!elementname')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          endif

          elseif (!trunbran.href.type.eq('REDU')) then

            if (!trunbran.href.ppbor[2].neq(!trunbran.href.ppbor[3])) then
            --P3 and P2 of reducer must have the same bore
            !this.currenterrorobject.errorarray.append('**   Error  ** - PPoints P3 and P2 of reducer must have the same bore')
            !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
            !this.currenterrorobject.errorarray.append('Reducer Name      $!elementname')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          endif

          --check if P3 and P2 are on the same level (from mdsselectcomp.pmlfnc)

          !ce = !!ce
          !!ce = !trunbran.href
          pin 9 copy p3
            if (!!ce.arr.eq(1)) then
            pin 8 copy pl
          else
            pin 8 copy pa
          endif
          pin 8 dir from pin 9 to pin 8
          var !pin9dir const dir pin 9 to pin 8

            if (!!ce.arr.eq(1)) then
              var !plDir pl dir
          else
              var !plDir pa dir
          endif
            if (!pin9dir.neq(!plDir)) then
            --error P3 and P2 not on same level
            !this.currenterrorobject.errorarray.append('**   Error  ** - PPoints P3 and P2 of reducer must be on same level')
            !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
            !this.currenterrorobject.errorarray.append('Reducer Name      $!elementname')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE

          endif
          pin 8 off
          pin 9 off
          !!ce = !ce

            if (!trunbran.href.detref.skey.match('OT').lt(1)) then
            !this.currenterrorobject.errorarray.append('**   Error  ** - SKEY of reducer must contain OT (e.g. OTBW, OTSW)')
            !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
            !this.currenterrorobject.errorarray.append('Reducer Name      $!elementname')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          endif

            if (!trunbran.href.owner.pspe.name.split('/')[2].neq(!trunbran.href.spref.name.split('/')[2])) then
            --Reducer with trunnion attached does not match pipe spec of main pipe branch
            !this.currenterrorobject.errorarray.append('**   Error  ** - SPREF of Reducer does not match PSPE of main pipe branch')
            !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
            !this.currenterrorobject.errorarray.append('Reducer Name      $!elementname')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          endif

          elseif (!trunbran.href.type.eq('CROS')) then

          --check P4 exists
            if (!trunbran.href.ppls.find(4).size().neq(1)) then
            !this.currenterrorobject.errorarray.append('**   Error  ** - PPoint P4 does not exist on CROS')
            !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
            !this.currenterrorobject.errorarray.append('CROS Name      $!elementname')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          else

            --P1, P2, P4 of tee, and hbore of trunnion branch must have equal bores
            !temp = ARRAY()
            !temp[1] = !trunbran.href.ppbor[1]
            !temp[2] = !trunbran.href.ppbor[2]
            !temp[3] = !trunbran.href.ppbor[4]
            !temp[4] = !trunbran.hbo

            !temp.sortunique()
            --q var !temp.size()
              if (!temp.size().neq(1)) then
              --error all bores must be equal
              !this.currenterrorobject.errorarray.append('**   Error  ** - Bore of PPoints P1, P2, P4 of CROS and HBORE of trunnion branch must be the same')
              !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
              !this.currenterrorobject.errorarray.append('CROS Name      $!elementname')
              !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
              !this.supporterrors = !this.supporterrors + 1
              !this.supporterrorflag = TRUE
            endif

              if (!trunbran.href.ppos[4].wrt( /* ).neq(!trunbran.href.ppos[0].wrt( /* ))) then
            --P4 must be at same pos as P0
              !this.currenterrorobject.errorarray.append('**   Error  ** - PPoints P4 and P0 of CROS not in same position')
              !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
              !this.currenterrorobject.errorarray.append('CROS Name      $!elementname')
              !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
              !this.supporterrors = !this.supporterrors + 1
              !this.supporterrorflag = TRUE
            endif

          endif

            if (!trunbran.href.owner.pspe.name.split('/')[2].neq(!trunbran.href.spref.name.split('/')[2])) then
            --CROS with trunnion attached does not match pipe spec of main pipe branch
            !this.currenterrorobject.errorarray.append('**   Error  ** - SPREF of CROS does not match PSPE of main pipe branch')
            !this.currenterrorobject.errorarray.append('Trunnion Name             = $!support')
            !this.currenterrorobject.errorarray.append('CROS Name      $!elementname')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          endif

        endif

--<wd>apr2007 -- "if/else/endif" STATEMENT added to CHECK for a VALID SPREF, "UNSET or BADREF", at the TRUNNION Branch HREF
       endif
--<wd>apr2007

      elsehandle ANY
        !this.currenterrorobject.errorarray.append('**   Error  ** - HREF of trunnion unset')
        !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
        !this.supporterrors = !this.supporterrors + 1
        !this.supporterrorflag = TRUE
      endhandle

    endif

-------------------------------------------------------------
--------------------------------------------------------------
--DATACON checker on BRAN of trunnion
    !!ce = !trunnionsref.dbref()

    bran

    ALPHA FILE /%pdmswk%/trunnioncheck.txt  OVER
    check ce
    ALPHA FILE END

    !trunnioncheck = object FILE('%pdmswk%/trunnioncheck.txt')

    !trunnioncheck.open('READ')
    !trunnioncheckarray = !trunnioncheck.readfile()
    !trunnioncheck.close()
    !trunnioncheck.deletefile()

    if (!trunnioncheckarray[4].match('NO DATA INCONSISTENCIES').eq(0)) then
    --there are errors, manipulate array !trunnioncheckarray into error message format as used for other supports (e.g. ancillaries)

      !hNutArray = ARRAY()
    !indexofHNUTarray = ARRAY()
    !index = 1

      do !trunnionchecklines values !trunnioncheckarray
        --q var !trunnionchecklines
        --if there is a '/' on the line, then it is the element name line
        if (!trunnionchecklines.match('/').gt(0)) then
          --q var !trunnionchecklines
          !hNutArray.append(!trunnionchecklines.trim())
          !indexofHNUTarray.append(!index)
        endif

        !index = !index + 1
      enddo
      --q var !hNutArray
      --q var !indexofHNUTarray
      !t = !indexofHNUTarray[1] + 1
      --q var !t
      --q var !trunnioncheckarray[4]

      !errorarray = ARRAY()
      !elementarray = ARRAY()
      !additionalinfoarray = ARRAY()
      !dIndice = 0

      --do loop for each line of HNUTarray e.g. array of each element with errors
      do !i from 1 to !hNutArray.size()
        !from = !indexofHNUTarray[!i] + 1

        if (!i.neq(!hNutArray.size())) then
          !to = !indexofHNUTarray[(!i + 1)] - 1
        else
          !to = !trunnioncheckarray.size() - 1
        endif

        !hangcheckfrom = !trunnioncheckarray[!from]
        !hangcheckto = !trunnioncheckarray[!to]
        --do loop for each line between each component, e.g. HNUT, lines may be e.g 'D620 Bad arrive' or 'Tolerance angle 55.5'
        do !j from $!from to $!to

          !line = !trunnioncheckarray[!j].trim()

---------------------------------------------------------------------------------------------------
--<wd>apr2007 -- MDS Trunnion Branch Element DATACON ERRORS were missing from the MDS Health Check Report. Lines below commented out with --<wd>apr2007
--<wd>apr2007 -- ensure the DATACON ERRORS for the MDS Trunnion BRANCH element are output into the MDS Health Check Report.
--
--<wd>apr2007          if !line.substring(1,1).eq('D') then
            --e.g. D420 error message, add 1 to DIndice and store error message and element name and dbref in arrays
          !dIndice = !dIndice + 1
          !errorarray[!dIndice] = !line
          !elementarray[!dIndice] = !hNutArray[!i]
          !additionalinfoarray[!dIndice] = ''
--<wd>apr2007          else
--<wd>apr2007            --no 'D' at start of line so store line in additionalinfo array, indiced by DIndice
          --<wd>apr2007            !additionalinfoarray[!dIndice] = !line
--<wd>apr2007          endif
---------------------------------------------------------------------------------------------------

        enddo

      enddo

      !errorarrayindice = 1

      do !k values !errorarray

        !this.currenterrorobject.errorarray.append('**   Error  ** - ' & !k)
        --!this.currenterrorobject.errorarray.append(!k)
        !this.currenterrorobject.errorarray.append('Element name          ' & !elementarray[!errorarrayindice])
        if (!additionalinfoarray[!errorarrayindice].neq('')) then
          !this.currenterrorobject.errorarray.append(!additionalinfoarray[!errorarrayindice])
        endif
        !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
        !this.supporterrors = !this.supporterrors + 1
        !this.supporterrorflag = TRUE

        !errorarrayindice = !errorarrayindice + 1
      enddo
    else
      --no dataconn errors with hanger (RESTraint)

    endif

--end of DATACON checker section
--------------------------------------------------------------

  endhandle

  !!ce = !pretrunnioncheckce

  !this.currenterrorobject.numerrors = !this.supporterrors

  !this.currenterrorobject.numwarnings = !this.supportwarnings

  if (!this.supporterrorflag.eq(TRUE)) then
    !this.totalsupporterrors = !this.totalsupporterrors + 1
    !this.totalerrors = !this.totalerrors + !this.supporterrors

    !this.outputmessage.append('Trunnion support $!support has $!this.supporterrors errors')
  else
    !this.outputmessage.append('No errors with trunnion support $!support')
  endif

  if (!this.supportwarningflag.eq(TRUE)) then
    !this.totalsupportwarnings = !this.totalsupportwarnings + 1
    !this.totalwarnings = !this.totalwarnings + !this.supportwarnings

    !this.outputmessage.append('Trunnion support $!support has $!this.supportwarnings warnings')
  else
    !this.outputmessage.append('No warnings with trunnion support $!support')
  endif

  !this.outputmessage.append('--------------------------------------------------------------------------------')

endmethod
-------------------------------------------------------------------------
define method .checkancillary(!support is STRING)
--method to check ancillary for temp, insulation...
--see mdscheckstd.pmlobj
  --!this.supporterrorflag = FALSE
  --!this.supporterrors = 0
  !this.ancilerrors = 0
  !suppdbref = !support.dbref()
  !!ce = !suppdbref
  !suppstype = !suppdbref.stype

  --CHECK ACTIVE AND EXISTS IN AVAILABLE TYPES

  !currentUnits = !!kGetSetUnits()
  if (!suppstype.matchwild(|*-REST*|).not()) then
    !mdsattaobj = object MDSREADPARSDATA()
    !mdsattadefs = !mdsattaobj.mdsdefsdata(!suppstype,!suppdbref.lbor.real())
    --!mdsattadefs = !mdsattaobj.mdsdefsdata('FT09',150)
    --if not active - display error message
    --if cate doesnt exist - error message
    --if section doesnt exist - error message

    --supportexists flag if support exists, but may be inactive
    !supportexists = TRUE

    if (!mdsattadefs.not()) then
    --.not() then
      if (!mdsattaobj.mdsstd.smess.neq('')) then
        --there is a sect error message
        if (!mdsattaobj.mdsstd.sexists.eq(FALSE)) then
          --the sect does not exist, do not continue checks (cate can't exist)
          --AND !mdsattaobj.mdsstd.cactive.not() then
          !this.currenterrorobject.errorarray.append('**   Error  ** - $!mdsattaobj.mdsstd.smess')
          !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
          !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
          !this.ancilerrors = !this.ancilerrors + 1
          !this.supporterrorflag = TRUE
          !supportexists = FALSE

        else
          --there is an error message, but the sect does exist
          !this.currenterrorobject.errorarray.append('**   Error  ** - $!mdsattaobj.mdsstd.smess')
          !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
          !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
          !this.ancilerrors = !this.ancilerrors + 1
          !this.supporterrorflag = TRUE
          --if sect is inactive, stop, do not check cate
          if (!mdsattaobj.mdsstd.sactive.eq(FALSE)) then

            !supportexists = FALSE
          else

          --else continue, check cate
          --no sect error message so just check cate
            if (!mdsattaobj.mdsstd.cmess.neq('')) then
              !this.currenterrorobject.errorarray.append('**   Error  ** - $!mdsattaobj.mdsstd.cmess')
              !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
              !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
              !this.ancilerrors = !this.ancilerrors + 1
              !this.supporterrorflag = TRUE
              if (!mdsattaobj.mdsstd.cexists.eq(TRUE) AND !mdsattaobj.mdsstd.cactive.eq(FALSE)) then
                --inactive, but support exists, above error message will cover this, do not set
                --!supportexists to FALSE - still can check using mdscheckstd

              elseif (!mdsattaobj.mdsstd.cexists.eq(FALSE)) then
                --cate does not exist
                !supportexists = FALSE
              endif
            endif
          endif
        endif
      else
        --check cate
        if (!mdsattaobj.mdsstd.cmess.neq('')) then
          !this.currenterrorobject.errorarray.append('**   Error  ** - $!mdsattaobj.mdsstd.cmess')
          !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
          !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
          !this.ancilerrors = !this.ancilerrors + 1
          !this.supporterrorflag = TRUE
          if (!mdsattaobj.mdsstd.cexists.eq(TRUE) AND !mdsattaobj.mdsstd.cactive.eq(FALSE)) then
            --inactive, but support exists, above error message will cover this, do not set
            --!supportexists to FALSE - still can check using mdscheckstd

          elseif (!mdsattaobj.mdsstd.cexists.eq(FALSE)) then
            --cate does not exist
            !supportexists = FALSE
          endif
        endif
      endif

    endif

--<wd>apr2007 -- Also Need to check !mdsattaobj.mdsstd.continue is TRUE as well as !supportexists to enter this "if" statement
    --if !supportexists then
    if ((!supportexists) and (!mdsattaobj.mdsstd.continue)) then
--<wd>apr2007

      --MDSCHECKSTD CHECKS - BORE, MATERIAL, INSU, TEMP, ELEV

      !check = object MDSCHECKSTD(!mdsattaobj)

      --BORE SECTION

      !attabore = abor
      !prebore = lbor of prev
      handle ANY
        !prebore = hbor of owner
      endhandle

      if (!attabore.neq(!prebore)) then
        !this.currenterrorobject.errorarray.append('**   Error  ** - Bore of ancillary does not match bore of branch')
        !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
        !this.currenterrorobject.errorarray.append('Ancillary Bore             = $!attabore')
        !this.currenterrorobject.errorarray.append('Branch Bore                = $!prebore')
        !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

        !this.ancilerrors = !this.ancilerrors + 1
        !this.supporterrorflag = TRUE
      endif

      --INSU SECTION
      --ERROR MESSAGES FOR MDSCHECKSTD ERRORS SIMILAR TO THOSE IN mdssetdatat01.pmlfnc

      !min = STRING()
      !max = STRING()

      if (!check.insu(!suppstype,!min,!max).not()) then

        --insulation error
        !insu = !suppdbref.inth

        !split = !currentUnits.split()
        if (!split[3].eq('MM')) then
          !units = 'mm'
        else
          !units = 'in'
        endif
        !!kFormatText.text.val  = $!max
        !maxval = !!kFormatText.text.val.string(!!distancefmt)
        !!kFormatText.text.val = $!min
        !minval = !!kFormatText.text.val.string(!!distancefmt)
        !!kFormatText.text.val = $!insu
        !insval = !!kFormatText.text.val.string(!!distancefmt)
        --!this.currenterrorobject.errorarray.append('**   Error  ** - The INSULATION on the identified pipe ($!<insval>$!<units>) is not within the MIN ($!<minval>$!<units>) and MAX ($!<maxval>$!<units>) limits of the Insulation Thickness Values for the selected ancillary support type')
        !this.currenterrorobject.errorarray.append('**   Error  ** - The INSULATION on the identified pipe is not within the MIN and MAX limits of the Insulation Thickness Values for the selected ancillary support type')
        !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
        !this.currenterrorobject.errorarray.append('Insulation             = $!<insval>$!<units>')
        !this.currenterrorobject.errorarray.append('Min Thickness             = $!<minval>$!<units>')
        !this.currenterrorobject.errorarray.append('Max Thickness             = $!<maxval>$!<units>')
        !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

        !this.ancilerrors = !this.ancilerrors + 1
        !this.supporterrorflag = TRUE
      endif

      --TEMP SECTION

      !tMin = STRING()
      !tMax = STRING()

      if (!check.temp(!suppstype,!tMin,!tMax).not()) then
        --temp error
        !temp = !suppdbref.owner.temp
        --var !temp temp of branch
        --!this.outputmessage = ARRAY()
        --!this.currenterrorobject.errorarray.append('The temperature of the identified pipe ($!temp) is not within the minimum/maximum temperatures ($!tMin / $!tMax)')

        !this.currenterrorobject.errorarray.append('**   Error  ** - The temperature of the identified pipe is not within the minimum/maximum temperatures')
        !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
        !this.currenterrorobject.errorarray.append('Temperature             = $!temp')
        !this.currenterrorobject.errorarray.append('Min Temperature             = $!tMin')
        !this.currenterrorobject.errorarray.append('Max Temperature           = $!tMax')
        !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

        !this.ancilerrors = !this.ancilerrors + 1
        !this.supporterrorflag = TRUE
      endif

      --ELEVATION SECTION

      -- Test if the ancillary is available at this elevation

      if (!check.elevation(!suppstype).not()) then
        !position = !!ce.position.wrt(/* )
        !selectedElevation = !position.up

        !minimumElevation = !mdsattaobj.elevation

        --!this.currenterrorobject.errorarray.append('The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedElevation Minimum elevation $!minimumElevation')
        !this.currenterrorobject.errorarray.append('**   Error  ** - The elevation selected is unsuitable for this ancillary. Selected elevation $!selectedElevation Minimum elevation $!minimumElevation')
        !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
        !this.currenterrorobject.errorarray.append('Temperature             = $!temp')
        !this.currenterrorobject.errorarray.append('Min Elevation             = $!tMin')
        !this.currenterrorobject.errorarray.append('Max Elevation           = $!tMax')
        !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

        !this.ancilerrors = !this.ancilerrors + 1
        !this.supporterrorflag = TRUE
      endif

      --MATERIAL SECTION

      !min = STRING()
      !max = STRING()
      !matError = STRING()

      if (!check.material(!matError).not()) then
        --q var !mdsattaobj !matError
        !fullmaterror = '**   Error  ** - ' & !matError
        !this.currenterrorobject.errorarray.append(!fullmaterror)
        !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
        !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

        !this.ancilerrors = !this.ancilerrors + 1
        !this.supporterrorflag = TRUE
      endif

      !criteria = !check.criteria()
      if (!criteria.empty().not()) then
        !fullcriterror = '**   Error  ** - $!criteria'
        !this.currenterrorobject.errorarray.append(!fullcriterror)
        !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
        !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

        !this.ancilerrors = !this.ancilerrors + 1
        !this.supporterrorflag = TRUE
      endif

    endif
  endif

  --SPEC REF SECTION
  --SPEC SHOULD BE IN /MDS/ATxx...

  --check if unknown ref (badref) using method !this.checkbadref
  !badrefdbref = DBREF
  if (!this.checkbadref('spref',!badrefdbref)) then
    --badref error

    !badrefdbrefstring = !badrefdbref.string()
    !this.currenterrorobject.errorarray.append('**   Error  ** - SPREF is Unknown Reference')
    !this.currenterrorobject.errorarray.append('Unknown reference          $!badrefdbrefstring')
    !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
    !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

    !this.ancilerrors = !this.ancilerrors + 1
    !this.supporterrorflag = TRUE

  else

    !spref = spref

    !sprefnameorig = !spref.name

    --remove hyphens from name so e.g. SU02C4, where stype is SU02C4, but SPREF is /SU02-C-4.150

    !sprefname = !sprefnameorig.replace('-','')
    !suppstype = !suppstype.replace('-','')

    --<RM> 23/10/09 -- remove dots from the name because rack rests and hvac rests have a . in the middle of the name that was not
    --being picked up i.e. /MDS/.hVACREST.800 which doesn't match /MDS/HVACREST
    !sprefname = !sprefname.replace('.','')
    !suppstype = !suppstype.replace('.','')
    --<RM> 23/10/09 -- end

    if (!sprefname.match('/MDS/$!suppstype').eq(0)) then
      !this.currenterrorobject.errorarray.append('**   Error  ** - Invalid SPREF')
      !this.currenterrorobject.errorarray.append('SPREF expected to match /MDS/$!suppstype')
      !this.currenterrorobject.errorarray.append('SPREF                      = $!sprefnameorig')
      !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
      !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

      !this.ancilerrors = !this.ancilerrors + 1
      !this.supporterrorflag = TRUE
    endif

  endif
----------------------------------------------------------------------------
    --GUIDE REF SECTION
    !preguidece = !!ce

    --check if unknown ref (badref) using method !this.checkbadref
  !badrefdbref = DBREF
  if (!this.checkbadref(':MDSGuideRef',!badrefdbref)) then
      --badref error

      !badrefdbrefstring = !badrefdbref.string()
      !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSGuideRef is Unknown Reference')
      !this.currenterrorobject.errorarray.append('Unknown reference          $!badrefdbrefstring')
      !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
      !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

      !this.ancilerrors = !this.ancilerrors + 1
      !this.supporterrorflag = TRUE

    else

      !guideref = :MDSGuideRef

    !unusedguiderefname = !guideref.name
      handle ANY
        --guideref not set (can only check if correct if there is a guideref)
      elsehandle NONE
        --navigate to guideref, and check that guideref refs back to 'this' support

        $!guideref.name

        --second badref check

      if (!this.checkbadref(':MDSGuideRef',!badrefdbref)) then
          --badref error

          !badrefdbrefstring = !badrefdbref.string()
          !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSGuideRef on referenced atta is Unknown Reference')
          !this.currenterrorobject.errorarray.append('Unknown reference          $!badrefdbrefstring')
          !this.currenterrorobject.errorarray.append('Referenced atta name       = $!guideref.name')
          !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
          !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

          !this.ancilerrors = !this.ancilerrors + 1
          !this.supporterrorflag = TRUE

        else

          !secondguideref = :MDSGuideRef
          !secondguiderefname = !secondguideref.name
          handle ANY
            --guideref not set
            !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSGuideRef not set on referenced atta')
            !this.currenterrorobject.errorarray.append('Atta referenced with :MDSGuideRef does not have :MDSGuideRef set to reference back')
            !this.currenterrorobject.errorarray.append('Referenced atta name       = $!guideref.name')
            !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

            !this.ancilerrors = !this.ancilerrors + 1
            !this.supporterrorflag = TRUE
          elsehandle NONE
          if (!secondguiderefname.neq(!support)) then
              !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSGuideRef incorrect on referenced atta')
              !this.currenterrorobject.errorarray.append('Atta referenced with :MDSGuideRef does not have reference back to original atta')
              !this.currenterrorobject.errorarray.append('Referenced atta name       = $!guideref.name')
              !this.currenterrorobject.errorarray.append(':MDSGuideRef at referenced atta       = $!secondguideref.name')
              !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
              !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

              !this.ancilerrors = !this.ancilerrors + 1
              !this.supporterrorflag = TRUE
            endif
          endhandle
        endif
      endhandle
    endif

    !!ce = !preguidece

----------------------------------------------------------------------------

  --RPAD :MDSSREF CHECK

  --IF MDSSREF SET, CHECK REFERENCED ATTA EXISTS, AND IT'S SREF REFERS BACK

    !premdssrefce = !!ce

    --check if unknown ref (badref) using method !this.checkbadref
  !badrefdbref = DBREF
  if (!this.checkbadref(':MDSSRef',!badrefdbref)) then
      --badref error

      !badrefdbrefstring = !badrefdbref.string()
      !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSSRef is Unknown Reference')
      !this.currenterrorobject.errorarray.append('Unknown reference          $!badrefdbrefstring')
      !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
      !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

      !this.ancilerrors = !this.ancilerrors + 1
      !this.supporterrorflag = TRUE

    else

      !mdssref = :MDSSRef

    !unusedmdssrefname = !mdssref.name
      handle ANY
        --:mdssref not set (can only check if correct if there is a mdssref)
      elsehandle NONE
        --navigate to mdssref, and check that sref refs back to 'this' support

        $!mdssref.name

         --check if unknown ref (badref) using method !this.checkbadref
      !badrefdbref = DBREF
      if (!this.checkbadref(':MDSSRef',!badrefdbref)) then
          --badref error
          !badrefdbrefstring = !badrefdbref.string()
          !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSSRef on referenced atta is Unknown Reference')
          !this.currenterrorobject.errorarray.append('Unknown reference          $!badrefdbrefstring')
          !this.currenterrorobject.errorarray.append('Referenced atta name       = $!mdssref.name')
          !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
          !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

          !this.ancilerrors = !this.ancilerrors + 1
          !this.supporterrorflag = TRUE

        else

          !secondmdssref = :MDSSRef
          !secondmdssrefname = !secondmdssref.name
          handle ANY
            --mdssref not set
            !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSSRef not set on referenced atta')
            !this.currenterrorobject.errorarray.append('Atta referenced with :MDSSRef does not have :MDSSRef set to reference back')
            !this.currenterrorobject.errorarray.append('Referenced atta name       = $!mdssref.name')
            !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

            !this.ancilerrors = !this.ancilerrors + 1
            !this.supporterrorflag = TRUE
          elsehandle NONE
          if (!secondmdssrefname.neq(!support)) then
              !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSSRef incorrect')
              !this.currenterrorobject.errorarray.append('Atta referenced with :MDSSRef does not have reference back to original atta')
              !this.currenterrorobject.errorarray.append('Referenced atta name       = $!mdssref.name')
              !this.currenterrorobject.errorarray.append(':MDSSRef at referenced atta       = $!secondmdssref.name')
              !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
              !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

              !this.ancilerrors = !this.ancilerrors + 1
              !this.supporterrorflag = TRUE
            endif
          endhandle
        endif
      endhandle

    endif

    !!ce = !premdssrefce

  --CHECK VALID DESCRIPTION VALUES FOR STANDARD SUPPORTS

  --Check DTXR, if not set or blank, error message and also check DTXS and DTXT

  !dtxrSet = TRUE

  !detrtext = !suppdbref.dtxr
  handle ANY
    --error, output error message, check detstext and detttext too
    !this.currenterrorobject.errorarray.append('**   Error  ** - Invalid DTXR')
    !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
    !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

    !this.ancilerrors = !this.ancilerrors + 1
    !this.supporterrorflag = TRUE
    --set flag to indicate dtxr not set, so check dtxs and dtxt

    !dtxrSet = FALSE

  elsehandle NONE
    --check not blank string '', if not, do nothing, if blank report error
    if (!detrtext.eq('')) then
      !dtxrSet = FALSE
      !this.currenterrorobject.errorarray.append('**   Error  ** - DTXR is blank')
      !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
      !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

      !this.ancilerrors = !this.ancilerrors + 1
      !this.supporterrorflag = TRUE
    endif
  endhandle

  if (!dtxrSet.eq(FALSE)) then

    --check DTXS and DTXT

    --check DTXS
    !detstext = !suppdbref.dtxs
    handle ANY
      --error, output error message, check detstext and dettext too
      !this.currenterrorobject.errorarray.append('**   Error  ** - Invalid DTXS')
      !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
      !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

      !this.ancilerrors = !this.ancilerrors + 1
      !this.supporterrorflag = TRUE
    elsehandle NONE
      if (!detstext.eq('')) then
        !this.currenterrorobject.errorarray.append('**   Error  ** - DTXS is blank')
        !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
        !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

        !this.ancilerrors = !this.ancilerrors + 1
        !this.supporterrorflag = TRUE
      endif
    endhandle

    --check DTXT

    !detttext = !suppdbref.dtxt
    handle ANY
      --error, output error message, check detstext and dettext too
      !this.currenterrorobject.errorarray.append('**   Error  ** - Invalid DTXT')
      !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
      !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

      !this.ancilerrors = !this.ancilerrors + 1
      !this.supporterrorflag = TRUE
    elsehandle NONE
      if (!detttext.eq('')) then
        !this.currenterrorobject.errorarray.append('**   Error  ** - DTXT is blank')
        !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
        !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

        !this.ancilerrors = !this.ancilerrors + 1
        !this.supporterrorflag = TRUE
      endif
    endhandle

  endif
---------------------------------------------------------------------------------
--:MDSWelddata check section

  !prewelddatacheckce = !!ce
  !!ce = !suppdbref

  --check :MDSWelddata is not unknown ref
  --if set, check reference to DDSE

  --!weldref = :MDSWelddata

  !counter = 1

  do !p values !welddata

    --check if unknown ref (badref) using method !this.checkbadref
    !badrefdbref = DBREF
    if (!this.checkbadref(':mdswelddata[$!counter]',!badrefdbref)) then
      --badref error

      !badrefdbrefstring = !badrefdbref.string()
      !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSWelddata is Unknown Reference')
      !this.currenterrorobject.errorarray.append('Unknown reference          $!badrefdbrefstring')
      !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
      !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

      !this.ancilerrors = !this.ancilerrors + 1
      !this.supporterrorflag = TRUE
    else

      if (!!ce.:mdswelddata.unset().not()) then
      --if :mdswelddata not unset, then check refers to DDSE type
        do !mdswelddata values !!ce.:mdswelddata
          if (!mdswelddata.type.neq('DDSE')) then
            !mdswelddataname = !mdswelddata.name
            !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSWelddata not set to DDSE element type')
            !this.currenterrorobject.errorarray.append(':MDSWelddata set to          $!mdswelddataname')
            !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
          endif
        enddo
      endif
    endif
    !counter = !counter + 1
  enddo

  --!badrefdbref = DBREF
  --if !this.checkbadref(':MDSWelddata',!badrefdbref) then
    --badref error

    --!badrefdbrefstring = !badrefdbref.string()
    --!this.currenterrorobject.errorarray.append('**   Error  ** - :MDSWelddata is Unknown Reference')
    --!this.currenterrorobject.errorarray.append('Unknown reference          $!badrefdbrefstring')
    --!this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
    --!this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

    --!this.ancilerrors = !this.ancilerrors + 1
    --!this.supporterrorflag = TRUE
  --else

    --if !!ce.:mdswelddata.unset().not() then
    --if :mdswelddata not unset, then check refers to DDSE type
     -- do !mdswelddata values !!ce.:mdswelddata
       -- if !mdswelddata.type.neq('DDSE') then
       --   !mdswelddataname = !mdswelddata.name
       --   !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSWelddata not set to DDSE element type')
       --   !this.currenterrorobject.errorarray.append(':MDSWelddata set to          $!mdswelddataname')
       --   !this.currenterrorobject.errorarray.append('Ancillary Name             = $!support')
       --   !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
       -- endif
      --enddo
    --endif

  --endif

  !!ce = !prewelddatacheckce
---------------------------------------------------------------------------------
  --FINAL SECTION - COUNTING AND REPORTING ERRORS

  !this.currenterrorobject.numerrors = !this.ancilerrors

  !this.currenterrorobject.numwarnings = !this.supportwarnings

  if (!this.supporterrorflag.eq(TRUE)) then
  --   !this.totalsupporterrors = !this.totalsupporterrors + 1

    !this.supporterrors = !this.supporterrors + !this.ancilerrors

    !this.outputmessage.append('Ancillary $!support has $!this.ancilerrors errors')
  else
    !this.outputmessage.append('No errors with ancillary $!support')
  endif
  !this.outputmessage.append('--------------------------------------------------------------------------------')
  --!this.outputmessage.append('')

endmethod
-------------------------------------------------------------------------
-------------------------------------------------------------------------
define method .checkframe(!support is STRING)

  !preframcheckce = !!ce

  !name = !support

  !suppdbref = !support.dbref()

  !!ce = !suppdbref
  !suppstype = !!ce.:MDSSuppType
  if (!suppstype.match('FT34').gt(0)) then
    !suppStypeForSprefCheck = !suppstype.replace('FT34','FT34-')
  else
    !suppStypeForSprefCheck = !suppstype
  endif

  if (!suppstype.eq('SPECIAL')) then

    --error message - Health check does not check Specials (WARNING ONLY)
    !this.currenterrorobject.errorarray.append('**   Warning  ** - Framework Support is a Special and so not checked')
    !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
    !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
    !this.supportwarnings = !this.supportwarnings + 1
    !this.supportwarningflag = TRUE

  elseif (!suppstype.eq('FT22')) then
    --ancref check only for FT22 (no other checks)
    --!sctnName = !n.dbref().name
    !ce = !!ce
    $!suppdbref
    !ancref = :MDSAncRef

    !counter = 1

    do !p values !ancref

        --check if unknown ref (badref) using method !this.checkbadref
      !badrefdbref = DBREF
      if (!this.checkbadref(':mdsancref[$!counter]',!badrefdbref)) then
        --badref error

        !badrefdbrefstring = !badrefdbref.string()
        !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSAncref[$!counter] is Unknown Reference')
        !this.currenterrorobject.errorarray.append('Unknown reference          $!badrefdbrefstring')
        !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
        !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

        !this.ancilerrors = !this.ancilerrors + 1
        !this.supporterrorflag = TRUE
      else

        $!p.name

        !secondancref = :MDSAncRef

        !ancrefmatchflag = FALSE

        if (!secondancref.unset().not()) then

          do !r values !secondancref

            !secondancrefname = !r.name

            if (!secondancrefname.eq(!suppdbref.name)) then
                !ancrefmatchflag = TRUE

              endif

          enddo
          if (!ancrefmatchflag.eq(FALSE)) then
            !badreffound = FALSE
            --if can't find matching :MDSAncref, check for unknown refs
            do !x from 1 to !secondancref.size()
              !badrefdbref = DBREF
              if (!this.checkbadref(':mdsancref[$!x]',!badrefdbref)) then
                !nameofrefelement = !p.name
                !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSAncref[$!x] on referenced element is Unknown Reference')
                !this.currenterrorobject.errorarray.append('Unknown reference          $!badrefdbrefstring')
                !this.currenterrorobject.errorarray.append('Referenced element name    = $!nameofrefelement')
                !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
                !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
                !badreffound = TRUE
              endif
            enddo

            if (!badreffound.eq(FALSE)) then

            !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSAncRef incorrect on referenced atta')
            !this.currenterrorobject.errorarray.append('Element referenced with :MDSAncRef does not have reference back to original atta')
            !this.currenterrorobject.errorarray.append('Referenced Element Name               = $!p.name')
            !this.currenterrorobject.errorarray.append(':MDSAncRef at referenced atta    = $!secondancrefname')
              --!this.currenterrorobject.errorarray.append('Section (SCTN) Name              = $!sctnName')
            !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE

            endif
          endif
        else
          !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSAncRef not set on referenced atta')
          !this.currenterrorobject.errorarray.append('Atta referenced with :MDSAncRef does not have :MDSAncRef set to reference back')
          !this.currenterrorobject.errorarray.append('Referenced Element Name               = $!p.name')
          --!this.currenterrorobject.errorarray.append('Section (SCTN) Name              = $!sctnName')
          !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
          !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

          !this.supporterrors = !this.supporterrors + 1
          !this.supporterrorflag = TRUE

        endif
      endif
      !counter = !counter + 1
    enddo
    !!ce = !ce
  else

    -------------------------------------------------------------------------------
    --check SREF and DATUM exist

    !sref = !support & '/SREF'
    !datum = !support & '/DATUM'

    !datumorsref = TRUE

    !datumdbref = !datum.dbref()
    handle ANY
      !this.currenterrorobject.errorarray.append('**   Error  ** - Incomplete support; no DATUM atta')
      !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
      !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
      !this.supporterrors = !this.supporterrors + 1
      !this.supporterrorflag = TRUE
      !datumorsref = FALSE
    endhandle

    !srefdbref = !sref.dbref()
    handle ANY
      !this.currenterrorobject.errorarray.append('**   Error  ** - Incomplete support; no SREF atta')
      !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
      !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
      !this.supporterrors = !this.supporterrors + 1
      !this.supporterrorflag = TRUE
      !datumorsref = FALSE
    elsehandle NONE
      --check SREF is ok
      --check SPREF only for SREF for now
      !ce = !!ce
      !!ce = !srefdbref
      !spref = spref
      !!ce = !ce

        !sprefname = !spref.name
        handle ANY
          --ERROR WITH NAME HERE
          !this.currenterrorobject.errorarray.append('**   Error  ** - SPREF unset')
          !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
          !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

          !this.supporterrors = !this.supporterrors + 1
          !this.supporterrorflag = TRUE
        elsehandle NONE
        if (!sprefname.match('/MDF/$!suppStypeForSprefCheck').eq(0)) then
            !this.currenterrorobject.errorarray.append('**   Error  ** - SREF atta has invalid SPREF')
            !this.currenterrorobject.errorarray.append('SPREF expected to match /MDF/$!suppstype')
            !this.currenterrorobject.errorarray.append('SPREF                      = $!sprefname')
            !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          endif
        endhandle
      --endhandle
    endhandle

    if (!datumorsref) then

---------------------------------------------------------------------------------
----section to check active and bore of framework support
    --for frame check section, check bore using mdscheckbores

      !mdsattaobj = object MDSREADPARSDATA()

      !mdsattadefs = !mdsattaobj.mdsdefsdata(!suppstype,!datumdbref.lbor.real())

      if (!mdsattadefs.not()) then
        if (!mdsattaobj.mdsstd.smess.unset().not()) then
          !this.currenterrorobject.errorarray.append('**   Error  ** - $!mdsattaobj.mdsstd.smess')
          !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
          !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
          --!this.ancilerrors = !this.ancilerrors + 1
          !this.supporterrors = !this.supporterrors + 1
          !this.supporterrorflag = TRUE
        endif
      endif
------------------------------------------
      --check template exists

      !templateexists = TRUE

--------------------------------------------------------------------------------
      --section to get template selection from code e.g. GT10-C-2 is MDS/GT10/2

      !srefstype = !sref.dbref().styp

      --array of support type where there is no link to template from stype of sref atta, so template checks cannot be performed

      !arrayofnolinktemplates = ARRAY()
      !arrayofnolinktemplates.append('FT31')
      !arrayofnolinktemplates.append('FT32')
      !arrayofnolinktemplates.append('FT44')
      !arrayofnolinktemplates.append('FT45')
      !arrayofnolinktemplates.append('FT46')
      !arrayofnolinktemplates.append('FT49')
      !arrayofnolinktemplates.append('FT54')
      !arrayofnolinktemplates.append('FT55')
      !arrayofnolinktemplates.append('VT01')
      !arrayofnolinktemplates.append('VT02')
      !arrayofnolinktemplates.append('VT03')
      !arrayofnolinktemplates.append('VT04')

      !templatechecksoff = FALSE

      do !temp values !arrayofnolinktemplates
        if (!srefstype.match(!temp).gt(0)) then
          !templatechecksoff = TRUE
        endif

      enddo

      -- FIRST SECTION Cases where selection number is not last hyphen-separated number of SREF STYPE
      -- get selection on case by case basis (e.g. if FT22)

      --cf mdscheckbores
      --if not there - check whether horizontal or vertical from config
      --UDA is :MDSCp1 of DATUM atta
      --e.g. :MDSCp1 1;F;F;0;F  this FT04 support is in config 1
      --split on ; choose a H or a V depending on config number for each horiz/vert support type
      --get config number from e.g. mdscreateft04, search for mds/ft04v

      --if VT01,02,03,04, set template to /MDS/VT01/1 (selection to 1) TEMPORARY THOUGH, SHOULD BE ABLE TO TELL
      --WHICH TEMPLATE WAS USED FROM STYPE OR SPREF OF SREF ATTA
      if (!suppstype.eq('VT01') or !suppstype.eq('VT02') or !suppstype.eq('VT03') or !suppstype.eq('VT04')) then
        !mdstemplate = '/MDS/$!suppstype/1'
        !selection = '1'
      elseif (!suppstype.eq('FT22')) then
        !y = !srefstype.split('-')
        !selection = !y[!y.size()]
        !letter = !y[2]
        !mdstemplate = '/MDS/$!suppstype/$!selection$!letter'
      elseif (!suppstype.eq('FT23') or !suppstype.eq('FT41')) then
        !y = !srefstype.split('-')
        !selection = !y[2]
        !mdstemplate = '/MDS/$!suppstype/$!selection'
      elseif (!suppstype.eq('FT25')) then
        !y = !srefstype.split('-')
        !selection = !y[!y.size()]
        !letter = !y[2]
        !mdstemplate = '/MDS/$!suppstype$!letter/$!selection'
      elseif (!suppstype.eq('FT24')) then
        !y = !srefstype.split('-')
        !selection = !y[!y.size()]
        !letter = !y[2]
        !mdstemplate = '/MDS/$!suppstype/$!letter$!selection'
        !selection = '$!letter$!selection'
      elseif (!suppstype.match('FT34').gt(0)) then
        !y = !srefstype.split('-')
        !selection = !y[!y.size()]
        !letter = !y[2]
        !mdstemplate = '/MDS/$!suppstype/$!selection'
      --elseif !suppstype.eq('FT31') or !suppstype.eq('FT32') then
      --  !mdstemplate = '/MDS/$!suppstype/1'
      --  !selection = '1'
      elseif (!templatechecksoff.neq(TRUE)) then
        --all other cases
        !y = !srefstype.split('-')
        !selection = !y[!y.size()]
        !mdstemplate = '/MDS/$!suppstype/$!selection'
      endif
      --clear support object

      !this.support = object MDSSUPPORT()

      --if !templatechecksoff.neq(TRUE) then

        --SECOND SECTION - HORIZONTAL OR VERTICAL TEMPLATES

        --if the above doesn't work - add V or H depending on config

        --see e.g. mdscreateft04 for similar code (choice of V or H)

      if (!templatechecksoff.neq(TRUE)) then
          -- Navigate to the MDS Template Structure
          !test = !mdstemplate.dbref()
          handle ANY

          if (!suppstype.eq('FT03') OR !suppstype.eq('FT04') OR !suppstype.eq('FT18') OR !suppstype.eq('FT19')) then

              !configpresplit = !datumdbref.:mdscp1
              --q var !configpresplit
              !config = !configpresplit.split(';')[1]

              --!datum = !support & '/DATUM'
              --!datumdbref = !datum.dbref()

              !oldce = !!ce
            !!ce = !datumdbref
            !this.support.paDir  = Pa Dir wrt world
            !this.support.plDir  = Pl Dir wrt world
              !!ce = !oldce

            if (!this.support.paDir eq U or !this.support.plDir eq U)then
              if (!config.eq('2'))then
                !mdstemp = '/MDS/$!suppstype$nV/$!selection'
                else
                !mdstemp = '/MDS/$!suppstype$nH/$!selection'
              endif
            else
              !mdstemp = '/MDS/$!suppstype$nH/$!selection'
              endif

          elseif (!suppstype.eq('FT14') OR !suppstype.eq('FT15') OR !suppstype.eq('VT20') OR !suppstype.eq('VT21')) then
            if (!suppstype.eq('FT14') OR !suppstype.eq('FT15')) then

                !oldce = !!ce
              !!ce = !datumdbref
              !this.support.paDir  = Pa Dir wrt world
              !this.support.plDir  = Pl Dir wrt world
              !uDir = U wrt world
                !!ce = !oldce

              if (!this.support.paDir eq !uDir or !this.support.plDir eq !uDir) then
                !mdstemp = '/MDS/$!suppstype$nV/$!selection'
                else
                !mdstemp = '/MDS/$!suppstype$nH/$!selection'
                endif
            elseif (!suppstype.eq('VT20') OR !suppstype.eq('VT21')) then

                !oldce = !!ce
              !!ce = !datumdbref
                if (!!ce.type eq 'BRAN') then
                  !hdir = hdir wrt /*
                else
                  !hdir = pl dir wrt /*
                endif
                !!ce = !oldce

                if (!hdir neq U and !hdir neq D ) then
                !mdstemp = '/MDS/$!suppstype$nH/$!selection'
                else
                !mdstemp = '/MDS/$!suppstype$nV/$!selection'
                endif

              endif
            endif

            !mdstemplate = !mdstemp
            !test = !mdstemplate.dbref()
            handle ANY
              !templateexists = FALSE
              -- template doesnt exist - error message and do not run mdscheckbores (set templateexists flag to FALSE)
              !this.currenterrorobject.errorarray.append('**   Error  ** - Template does not exist')
              !this.currenterrorobject.errorarray.append('Template name                       = $!mdstemplate')
              !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
              !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
              !this.supporterrors = !this.supporterrors + 1
              !this.supporterrorflag = TRUE
            endhandle

          endhandle

        endif
---------------------------------------------------------------------------------
        --now check bore against template (see mdscheckbores)

----------------------------------------------------------------------------------
        --set necessary form members (e.g. .support support object)
        --setup !this.support() (see e.g. mdsift09) for passing to integrity checker AND mdscheckbores
        --NB DUPLICATED BELOW
        !this.support.stru = !suppdbref

        !this.support.type = !suppstype
      --!this.support.alias = !suppstype

        --!support.modify? - leave, only used in integrity checker when creating special with no steelwork (steelwork now checked separately)

        -- Store Atta reference's in object
        !this.support.atta.append(!datumdbref)
        !this.support.atta.append(!srefdbref)

        --numbered attas (e.g. .1)

        do !num from 1 to 100
        --!count FROM 211 TO 259
        --VAR !num ($!count - 210)
        !attaname = !support & '.' & !num
        !!ce = !attaname.dbref()
            handle ANY
          skip
        endhandle
        !this.support.atta.append(!!ce)
        enddo

        !this.support.alias = !suppstype

---------------------------------------------------------------------------------
        --get dimensions from sref atta despars

        !dim = !sref.dbref().desp

        --set this.dim1 .dim2 etc. and pass to mdscheckbores

        do !count index !dim
          !this.dim$!count = !dim[!count]
        enddo

      if (!templateexists AND !templatechecksoff.neq(TRUE)) then

          !error = STRING()
        !currentUnits = !!kGetSetUnits()

          --run mdscheckbores

        if (!!mdscheckbores(!this,!selection,!error,!currentUnits)) then

          --append error message
          --edit error messages returned to remove 'STRU deleted' statements
            !errorshortened = !error.before('All')
            !this.currenterrorobject.errorarray.append('**   Error  ** - Support not valid')
            !this.currenterrorobject.errorarray.append(!errorshortened)
            !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          endif

        endif
---------------------------------------------------------------------------------
----check :mdsbars against template - should match

      if (!templateexists AND !templatechecksoff.neq(TRUE)) then

        if (!suppdbref.:mdsbars.neq(!mdstemplate.dbref().:mdsbars)) then

            !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSBars on support does not match :MDSBars of template')
            !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          endif

        endif
      --endif
-----------------------------------------------------------------------------------------------------------------------------
      --CHECK VALID DESCRIPTION VALUES FOR STANDARD SUPPORTS
      --Check SREF atta

      --Check DTXR, if not set or blank, error message and also check DTXS and DTXT

      !dtxrSet = TRUE

      !detrtext = !srefdbref.dtxr
      handle ANY
        --error, output error message, check detstext and detttext too
        !this.currenterrorobject.errorarray.append('**   Error  ** - Invalid DTXR')
        !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
        !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

        !this.supporterrors = !this.supporterrors + 1
        !this.supporterrorflag = TRUE
        --set flag to indicate dtxr not set, so check dtxs and dtxt

        !dtxrSet = FALSE

      elsehandle NONE
        --check not blank string '', if not, do nothing, if blank report error
        if (!detrtext.eq('')) then
          !dtxrSet = FALSE
          !this.currenterrorobject.errorarray.append('**   Error  ** - DTXR is blank')
          !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
          !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

          !this.supporterrors = !this.supporterrors + 1
          !this.supporterrorflag = TRUE
        endif
      endhandle

      if (!dtxrSet.eq(FALSE)) then

        --check DTXS and DTXT

        --check DTXS
        !detstext = !srefdbref.dtxs
        handle ANY
          --error, output error message, check detstext and dettext too
          !this.currenterrorobject.errorarray.append('**   Error  ** - Invalid DTXS')
          !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
          !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

          !this.supporterrors = !this.supporterrors + 1
          !this.supporterrorflag = TRUE
        elsehandle NONE
          if (!detstext.eq('')) then
            !this.currenterrorobject.errorarray.append('**   Error  ** - DTXS is blank')
            !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          endif
        endhandle

        --check DTXT

        !detttext = !srefdbref.dtxt
        handle ANY
          --error, output error message, check detstext and dettext too
          !this.currenterrorobject.errorarray.append('**   Error  ** - Invalid DTXT')
          !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
          !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

          !this.supporterrors = !this.supporterrors + 1
          !this.supporterrorflag = TRUE
        elsehandle NONE
          if (!detttext.eq('')) then
            !this.currenterrorobject.errorarray.append('**   Error  ** - DTXT is blank')
            !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          endif
        endhandle

      endif
--------------------------------------------------------------------------------
      --Check JOINTS and :MDSCONN

      --collect all sctns

      var !sctncoll coll all sctn for ce

      --if !suppstype.match('FT54').gt(0) OR !suppstype.match('FT55').gt(0) then


      !premdsconncheckce = !!ce
      !!ce = !suppdbref

      --loop through, check for joie or jois

      do !sctns values !sctncoll

        !joie = !sctns.dbref().joie.name
        handle ANY
        elsehandle NONE
          --there is a joint (joie)

          --check type of joint

          !jointtype = !joie.dbref().type

          --get cref of joie
          !cref = !joie.dbref().cref.name
          !crefsplit = !cref.split('/')
          !crefsctn = !crefsplit[2]
          !sctnofsupport = !sctns.dbref().name

          --check that cref of sjoi refers back to sctn of support
          if (!crefsctn.neq(!sctns.dbref().namn)) then
            !this.currenterrorobject.errorarray.append('**   Error  ** - CREF of $!jointtype does not refer back to SCTN')
            !this.currenterrorobject.errorarray.append('CRef                               = $!cref')
            !this.currenterrorobject.errorarray.append('$!jointtype name                          = $!joie')
            !this.currenterrorobject.errorarray.append('SCTN of support (expected setting of Cref) = $!sctnofsupport')
            !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          endif

          --for SJOI (not PJOI) check :MDSCONN for external joints

          --if owner of sctn owning owner of joint not support (STRUs) then external to support so check :MDSConn

          if (!joie.dbref().owner.owner.owner.owner.name.neq(!suppdbref.name) AND !jointtype.eq('SJOI')) then
            --joint is external to support, check :mdsconn of support sctn refers to owner of owner of SJOI

            --if SCTN connected to not part of support, check :MDSCONN matches owner of owner of owner of SJOI

            !sctnmdsconn = !sctns.dbref().:mdsconn.name
            handle ANY
            --$P mdsconn error
            elsehandle none
              !sctnowningjoint = !joie.dbref().owner.owner.name
              !sctncheckedformdsconn = !sctns.dbref().name

              if (!sctnmdsconn.neq(!sctnowningjoint)) then
                !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSConn incorrect')
                !this.currenterrorobject.errorarray.append(':MDSConn setting                     = $!sctnmdsconn')
                !this.currenterrorobject.errorarray.append('SCTN owning owner of SJOI (expected :MDSConn setting) = $!sctnowningjoint')
                !this.currenterrorobject.errorarray.append('SCTN of support checked for :MDSConn = $!sctncheckedformdsconn')
                !this.currenterrorobject.errorarray.append('Framework Support Name               = $!support')
                !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

                !this.supporterrors = !this.supporterrors + 1
                !this.supporterrorflag = TRUE
              endif
            endhandle
          endif

        endhandle

        --Same section of code as above, but for jois not joie

        !jois = !sctns.dbref().jois.name
        handle ANY
        elsehandle NONE
          --there is a joint (jois)

          --check type of joint

          !jointtype = !jois.dbref().type

          !cref = !jois.dbref().cref.name
          !crefsplit = !cref.split('/')
          !crefsctn = !crefsplit[2]
          !sctnofsupport = !sctns.dbref().name

          if (!crefsctn.neq(!sctns.dbref().namn)) then
            !this.currenterrorobject.errorarray.append('**   Error  ** - CREF of $!jointtype does not refer back to SCTN')
            !this.currenterrorobject.errorarray.append('CRef                               = $!cref')
            !this.currenterrorobject.errorarray.append('$!jointtype name                          = $!jois')
            !this.currenterrorobject.errorarray.append('SCTN of support (expected setting of Cref) = $!sctnofsupport')
            !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          endif

          --if owner of sctn owning owner of joint not support then (STRUs)

          if (!jois.dbref().owner.owner.owner.owner.name.neq(!suppdbref.name) AND !jointtype.eq('SJOI')) then
            --joint is external to support, check :mdsconn of support sctn refers to owner of owner of SJOI

           --if SCTN connected to not part of support, check :MDSCONN matches owner of owner of owner of SJOI

            !sctnmdsconn = !sctns.dbref().:mdsconn.name
            !sctnowningjoint = !jois.dbref().owner.owner.name
            !sctncheckedformdsconn = !sctns.dbref().name

            if (!sctnmdsconn.neq(!sctnowningjoint)) then
              !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSConn incorrect')
              !this.currenterrorobject.errorarray.append(':MDSConn setting                     = $!sctnmdsconn')
              !this.currenterrorobject.errorarray.append('SCTN owning owner of SJOI (expected :MDSConn setting) = $!sctnowningjoint')
              !this.currenterrorobject.errorarray.append('SCTN of support checked for :MDSConn = $!sctncheckedformdsconn')
              !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
              !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

              !this.supporterrors = !this.supporterrors + 1
              !this.supporterrorflag = TRUE
            endif

          endif
        endhandle

      enddo

      !!ce = !premdsconncheckce

      --if joie or jois set, check what reference is - if part of support, check ref back
      --if not part of support then should ref back with cref, AND sjoi should be owned by snod owned by
      --SCTN which is ref'd by :MDSCONN from SCTN of support

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
      --CHECK :MDSATTAREF

      --collect all sctns which are cross bars

      --if only 1 SCTN - just check MDSAttaref for DATUM atta
      --if more than 1 SCTN - check if special case e.g. just two Vs V1, V2
      --if not collect all BARS (with BAR in name), check DATUM atta on BAR 1
      --check same atta not referred to on more than one bar
      --check attas referred to exist? (.dbref())

      --set flag to indicate whether there is more than one BAR on support
      !morethanonebar = FALSE

      --array of supports where V1 holds :mdsattaref
      !arrayofv1attarefsupps = ARRAY()
      !arrayofv1attarefsupps.append('FT23')
      !arrayofv1attarefsupps.append('FT41')
      !arrayofv1attarefsupps.append('FT44')
      !arrayofv1attarefsupps.append('FT45')
      !arrayofv1attarefsupps.append('FT46')
      !arrayofv1attarefsupps.append('FT47')
      !arrayofv1attarefsupps.append('FT48A')
      !arrayofv1attarefsupps.append('FT48B')
      !arrayofv1attarefsupps.append('FT48C')
      !arrayofv1attarefsupps.append('FT48D')
      !arrayofv1attarefsupps.append('FT49')
      !arrayofv1attarefsupps.append('FT57')

      if (!sctncoll.size().eq(1)) then

        --single SCTN - check for DATUM mdsattaref on the single SCTN (BAR-1 or V-1)

        !arrayofmdsattarefs = !sctncoll[1].dbref().:mdsattaref

        !mdsattarefdatum = !suppdbref.name & '/DATUM'

        !mdsattarefdatumfound = FALSE

        do !z from 1 to !arrayofmdsattarefs.size()
          if (!arrayofmdsattarefs.find(!mdsattarefdatum.dbref()).size().gt(0)) then
            --found datum, so no error
            --set flag to true
            !mdsattarefdatumfound = TRUE
          endif
        enddo

        !singlesctn = !sctncoll[1].dbref().name

        if (!mdsattarefdatumfound.eq(FALSE)) then
          --NO MDSATTAREFDATUM on only SCTN of support
          !this.currenterrorobject.errorarray.append('**   Error  ** - No :MDSAttaref to DATUM atta on only SCTN of support')
          !this.currenterrorobject.errorarray.append('SCTN Name                          = $!singlesctn')
          !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
          !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

          !this.supporterrors = !this.supporterrors + 1
          !this.supporterrorflag = TRUE
        endif

      --elseif mdssupptype eq ones with 2 Vs only (no bars)
      elseif (!arrayofv1attarefsupps.find(!this.support.type).size().gt(0)) then

        !crossbar = !suppdbref.name & '-V1'

        !arrayofmdsattarefscrossbarone = !crossbar.dbref().:mdsattaref

        if (!arrayofmdsattarefscrossbarone.findfirst(!datumdbref).unset()) then
          --datum atta mdsattaref not found on vert bar 1
          !this.currenterrorobject.errorarray.append('**   Error  ** - No :MDSAttaref to DATUM atta')
          !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
          !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

          !this.supporterrors = !this.supporterrors + 1
          !this.supporterrorflag = TRUE
        endif

      elseif (!suppstype.match('GT09').gt(0) OR !suppstype.match('GT10').gt(0)) then

        --DO NOT CHECK :MDSATTAREF FOR GT09 OR GT10 - :MDSATTAREF NOT SET TO DATUM ATTA (PIPE-REST)

      else

        var !barsctncoll coll all sctn with (match(NAME,'BAR-') neq 0) for ce
        --multiple sctns

        if (!barsctncoll.size().gt(1)) then
          !morethanonebar = TRUE
        endif

        --array of all mdsattarefs in single array
        !arrayofmdsattarefs = ARRAY()

        --if mdsattaref on BAR-1 is not /DATUM then error

        do !z from 1 to !barsctncoll.size()

          !crossbar = !suppdbref.name & '-BAR-' & !z.string()

          !arrayofmdsattarefs.appendarray(!crossbar.dbref().:mdsattaref)
          handle any
            -- Record error message?
            skip
          endhandle

          if (!z.eq(1)) then
            --find datum atta ref on BAR-1 (if not there, error)
            --array of attarefs on crossbar one
            !arrayofmdsattarefscrossbarone = !crossbar.dbref().:mdsattaref

            if (!arrayofmdsattarefscrossbarone.findfirst(!datumdbref).unset()) then
              --datum atta mdsattaref not found on cross bar 1
              !this.currenterrorobject.errorarray.append('**   Error  ** - No :MDSAttaref to DATUM atta')
              !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
              !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

              !this.supporterrors = !this.supporterrors + 1
              !this.supporterrorflag = TRUE
            endif

          endif
        enddo

        --check if each attaref exists more than once in array of all attarefs (all cross bars)
        --if it does exist more than once - error

        do !q from 1 to !arrayofmdsattarefs.size()

          if (!arrayofmdsattarefs.find(!arrayofmdsattarefs[!q]).size().gt(1)) then
            --$p same mdsattaref found (non-unique mdsattaref found)
            !this.currenterrorobject.errorarray.append('**   Error  ** - Same :MDSAttaref found more than once on support')
            !this.currenterrorobject.errorarray.append(':MDSAttaref found multiple times   = $!arrayofmdsattarefs[!q]')
            !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          endif

        enddo

      endif

      --if :mdsattaref not set - error (separate error?)

      --if same :mdsattaref found on different crossbar, error
      --(check that referenced atta exists? no WD)

      --if multiple crossbars - check MDSBars is true

      if (!morethanonebar.eq(TRUE) and !suppdbref.:mdsbars.neq(TRUE)) then

        !this.currenterrorobject.errorarray.append('**   Error  ** - Multiple crossbars found but :MDSBars set to FALSE (at STRU)')
        !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
        !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

        !this.supporterrors = !this.supporterrors + 1
        !this.supporterrorflag = TRUE
      endif

--------------------------------------------------------------------------------

      --ancillary-check datum

      !this.checkancillary(!datum)

      --check if .1 .2 exist and ancillary check them if they do (including order)
      !arrayofnumbers = ARRAY()
      !arrayofnumberedsupports = ARRAY()

      do !i from 1 to 100

        !numberedsupport = !support & '.' & !i.string()
        !test = !numberedsupport.dbref()
        handle ANY
          --Numbered support $!numberedsupport not found
        elsehandle NONE
          !arrayofnumberedsupports.append(!numberedsupport)
          !arrayofnumbers.append(!i)
        endhandle
      enddo

      !number = 1

      do !j values !arrayofnumbers
        if (!j.neq(!number)) then
          --error with order of .1 .2 .3
          !this.currenterrorobject.errorarray.append('**   Error  ** - Supports 0.1 0.2 0.3 etc. not in sequence')
          !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
          !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
          --!this.currenterrorobject.errorarray.append('Supports .1 .2 .3 etc. not in sequence')
          --!this.currenterrorobject.errorarray.append('')
          !this.supporterrors = !this.supporterrors + 1
          !this.supporterrorflag = TRUE
          break
        endif
        !number = !number + 1
      enddo

      --loop over numbered supports, running an ancillary check on each

      do !k values !arrayofnumberedsupports
        !this.checkancillary(!k)
      enddo

      --section to check - support structure existence, structures have members, frameworks have members (warning only)

      --support structure existence to be checked when datum found only when loading supports

      --for structure members - check mdsbars against templates? (WD)

      !prestruccheckce = !!ce

      !!ce = !suppdbref

      var !strucmembers coll all frmw for ce
      var !strucmembersnames eval name for all from !strucmembers

      if (!strucmembersnames.unset().not()) then
        --then if there are members check mem of members (from array of dbrefs of x)
        do !m values !strucmembersnames
          $!m
          !frmwmembers = mem

          if (!frmwmembers.unset()) then
            --error message - FRMW has no members (WARNING ONLY)
            !this.currenterrorobject.errorarray.append('**   Warning  ** - Framework (FRMW) has no members')
            !this.currenterrorobject.errorarray.append('Framework (FRMW) name              = $!m')
            !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
            !this.supportwarnings = !this.supportwarnings + 1
            !this.supportwarningflag = TRUE
          endif
        enddo

        --<wd>apr2007 -- "elseif ^:mdssupptype.neq('SPECIAL') then" -- raises ERROR:(99,532) Undefined UDA or undefined UDET.
      --elseif :mdssupptype.neq('SPECIAL') then
      elseif (!!ce.:mdssupptype.neq('SPECIAL')) then
--<wd>apr2007

        --error message - structure has no members
        !this.currenterrorobject.errorarray.append('**   Error  ** - Structure (STRU) has no members')
        !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
        !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
        !this.supporterrors = !this.supporterrors + 1
        !this.supporterrorflag = TRUE
      endif
      --NAVIGATE BACK TO WHERE WE WERE BEFORE
      !!ce = !prestruccheckce

      --SECTION TO CHECK MDSWELDDATA

      !premdsweldcheckce = !!ce

      !!ce = !suppdbref

      var !sctncoll coll all sctn for ce
      var !pjoicoll coll all pjoi for ce
      var !sjoicoll coll all sjoi for ce
      var !fittcoll coll all fitt for ce
      var !platcoll coll all plat for ce

      !arrayofcolls = ARRAY()
      !arrayofcolls.append('!sctncoll')
      !arrayofcolls.append('!pjoicoll')
      !arrayofcolls.append('!sjoicoll')
      !arrayofcolls.append('!fittcoll')
      !arrayofcolls.append('!platcoll')

      --!newtest = '!sctncoll'

      do !coll values !arrayofcolls

        do !sctndbref values $!coll
          !!ce = !sctndbref.dbref()

          !welddata = :MDSWelddata
          --q var !welddata
          !counter = 1

          do !p values !welddata
            --check if unknown ref (badref) using method !this.checkbadref
            !badrefdbref = DBREF
            if (!this.checkbadref(':mdswelddata[$!counter]',!badrefdbref)) then
              --badref error

              !badrefdbrefstring = !badrefdbref.string()
              !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSWelddata is Unknown Reference')
              !this.currenterrorobject.errorarray.append('Unknown reference          $!badrefdbrefstring')
              !this.currenterrorobject.errorarray.append('Support Name             = $!support')
              !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

              !this.ancilerrors = !this.ancilerrors + 1
              !this.supporterrorflag = TRUE
            else

              if (!!ce.:mdswelddata.unset().not()) then
              --if :mdswelddata not unset, then check refers to DDSE type
                do !mdswelddata values !!ce.:mdswelddata
                  if (!mdswelddata.type.neq('DDSE')) then
                    !mdswelddataname = !mdswelddata.name
                    !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSWelddata not set to DDSE element type')
                    !this.currenterrorobject.errorarray.append(':MDSWelddata set to          $!mdswelddataname')
                    !this.currenterrorobject.errorarray.append('Support Name             = $!support')
                    !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
                  endif
                enddo
              endif
            endif
            !counter = !counter + 1
          enddo
        enddo

      enddo
          --  if !this.checkbadref(':MDSWelddata',!badrefdbref) then
          --badref error

      --    !badrefdbrefstring = !badrefdbref.string()
      --    !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSWelddata is Unknown Reference')
      --    !this.currenterrorobject.errorarray.append('Unknown reference          $!badrefdbrefstring')
      --    !this.currenterrorobject.errorarray.append('Support Name             = $!support')
      --    !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

      --    !this.supporterrors = !this.supporterrors + 1
      --    !this.supporterrorflag = TRUE
      --  else

      --    if !!ce.:mdswelddata.unset().not() then
          --if :mdswelddata not unset, then check refers to DDSE type
      --      do !mdswelddata values !!ce.:mdswelddata
      --        if !mdswelddata.type.neq('DDSk') then
      --          !mdswelddataname = !mdswelddata.name
      --          !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSWelddata not set to DDSE element type')
      --          !this.currenterrorobject.errorarray.append(':MDSWelddata set to          $!mdswelddataname')
      --         !this.currenterrorobject.errorarray.append('Support Name             = $!support')
      --          !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

      --          !this.supporterrors = !this.supporterrors + 1
      --          !this.supporterrorflag = TRUE
      --        endif
      --      enddo
      --    endif

      --  endif
      --enddo
      --do !pjoidbref values !pjoicoll
      --enddo
      --do !sjoidbref values !sjoicoll
      --enddo
      --do !fittdbref values !fittcoll
      --enddo
      --do !platdbref values !platcoll
      --enddo


      !!ce = !premdsweldcheckce
      --SECTION TO CHECK MDSANCREF

      !preancrefce = !!ce
      !!ce = !suppdbref
      --collect all sctn with mdsancref not unset
      --loop through sctns, check in similar fashion to mdsguideref and mdsancref

      var !sctncoll coll all sctn wi not(unset (:mdsancref)) for ce

      do !n values !sctncoll

        !sctnName = !n.dbref().name

        $!n
        !ancref = :MDSAncRef

        !counter = 1

        do !p values !ancref

            --check if unknown ref (badref) using method !this.checkbadref
          !badrefdbref = DBREF
          if (!this.checkbadref(':mdsancref[$!counter]',!badrefdbref)) then
            --badref error

            !badrefdbrefstring = !badrefdbref.string()
            !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSAncref[$!counter] is Unknown Reference')
            !this.currenterrorobject.errorarray.append('Unknown reference          $!badrefdbrefstring')
            !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

            !this.ancilerrors = !this.ancilerrors + 1
            !this.supporterrorflag = TRUE
          else

            $!p.name

            !secondancref = :MDSAncRef

            !ancrefmatchflag = FALSE

            if (!secondancref.unset().not()) then

              do !r values !secondancref

                !secondancrefname = !r.name

                if (!secondancrefname.eq(!n.dbref().name)) then
                    !ancrefmatchflag = TRUE

                  endif

              enddo
              if (!ancrefmatchflag.eq(FALSE)) then
                !badreffound = FALSE
                --if can't find matching :MDSAncref, check for unknown refs
                do !x from 1 to !secondancref.size()
                  !badrefdbref = DBREF
                  if (!this.checkbadref(':mdsancref[$!x]',!badrefdbref)) then
                    !nameofrefelement = !p.name
                    !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSAncref[$!x] on referenced element is Unknown Reference')
                    !this.currenterrorobject.errorarray.append('Unknown reference          $!badrefdbrefstring')
                    !this.currenterrorobject.errorarray.append('Referenced element name    = $!nameofrefelement')
                    !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
                    !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
                    !badreffound = TRUE
                  endif
                enddo

                if (!badreffound.eq(FALSE)) then

                !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSAncRef incorrect on referenced atta')
                !this.currenterrorobject.errorarray.append('Element referenced with :MDSAncRef does not have reference back to original atta')
                !this.currenterrorobject.errorarray.append('Referenced Element Name               = $!p.name')
                !this.currenterrorobject.errorarray.append(':MDSAncRef at referenced atta    = $!secondancrefname')
                  !this.currenterrorobject.errorarray.append('Section (SCTN) Name              = $!sctnName')
                !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
                !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

                !this.supporterrors = !this.supporterrors + 1
                !this.supporterrorflag = TRUE

                endif
              endif
            else
              !this.currenterrorobject.errorarray.append('**   Error  ** - :MDSAncRef not set on referenced atta')
              !this.currenterrorobject.errorarray.append('Atta referenced with :MDSAncRef does not have :MDSAncRef set to reference back')
              !this.currenterrorobject.errorarray.append('Referenced Element Name               = $!p.name')
              !this.currenterrorobject.errorarray.append('Section (SCTN) Name              = $!sctnName')
              !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
              !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

              !this.supporterrors = !this.supporterrors + 1
              !this.supporterrorflag = TRUE

            endif
          endif
          !counter = !counter + 1
        enddo

      enddo

      !!ce = !preancrefce

---------------------------------------------------------------------------
      --section to check all elements of framework support are named

      --Collect all FRMW, check named
      !!ce = !suppdbref

      var !frmwcollnamechk coll all frmw for ce

      do !s values !frmwcollnamechk

        if (!s.dbref().name.match('=')eq(1)) then
          --FRMW unnamed error message
          !this.currenterrorobject.errorarray.append('**   Error  ** - Unnamed Framework (FRMW) found')
          !this.currenterrorobject.errorarray.append('Dbref of Unnamed FRMW              $!s')
          !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
          !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

          !this.supporterrors = !this.supporterrors + 1
          !this.supporterrorflag = TRUE
        endif

        --Collect all SCTN, check named

        var !sctncollnamechk coll all sctn for $!s

        do !t values !sctncollnamechk

          if (!t.dbref().name.match('=')eq(1)) then
            --SCTN unnamed error message
            !this.currenterrorobject.errorarray.append('**   Error  ** - Unnamed Section (SCTN) found')
            !this.currenterrorobject.errorarray.append('Dbref of Unnamed SCTN              $!t')
            !this.currenterrorobject.errorarray.append('Framework Support Name             = $!support')
            !this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

            !this.supporterrors = !this.supporterrors + 1
            !this.supporterrorflag = TRUE
          endif

        enddo

      enddo

---------------------------------------------------------------------------

      --setup !this.support() (see e.g. mdsift09) for passing to integrity checker
      --THIS SECTION DUPLICATED ABOVE - SO COMMENTED OUT BELOW
      --!this.support.stru = !suppdbref
      --!this.support.type = !suppstype
      --!support.modify? - leave, only used in integrity checker when creating special with no steelwork (steelwork now checked separately)

      --Store Atta reference's in object
      --!this.support.atta.append(!datumdbref)
      --!this.support.atta.append(!srefdbref)

      --numbered attas (e.g. .1)

      --do !num from 1 to 100
      --!count FROM 211 TO 259
      --VAR !num ($!count - 210)
      --  !attaname = !support & '.' & !num
      --  !!ce = !attaname.dbref()
      --    handle ANY
      --      skip
      --    endhandle
      --  !this.support.atta.append(!!ce)
      --enddo

      !v1onlysupports = ARRAY()
      !bar1onlysupports = ARRAY()
      !v1andv2supports = ARRAY()
      !v1andbar1supports = ARRAY()
      !bar1andbar1supports = ARRAY()

      !v1onlysupports.append('FT03')
      !v1onlysupports.append('FT04')
      !v1onlysupports.append('FT05')
      !v1onlysupports.append('FT06')
      !v1onlysupports.append('FT17')
      !v1onlysupports.append('FT18')
      !v1onlysupports.append('FT19')
      !v1onlysupports.append('FT23')
      !v1onlysupports.append('FT31')
      !v1onlysupports.append('FT32')
      !v1onlysupports.append('FT40')
      !v1onlysupports.append('FT41')
      !v1onlysupports.append('FT42')
      !v1onlysupports.append('FT43')
      !v1onlysupports.append('FT44')
      !v1onlysupports.append('FT45')
      !v1onlysupports.append('FT46')
      !v1onlysupports.append('FT47')
      !v1onlysupports.append('FT48')
      !v1onlysupports.append('FT57')

      !bar1onlysupports.append('FT07')
      !bar1onlysupports.append('FT14')
      !bar1onlysupports.append('FT16')
      !bar1onlysupports.append('FT33')
      !bar1onlysupports.append('FT50')

      !v1andv2supports.append('FT08')
      !v1andv2supports.append('FT09')
      !v1andv2supports.append('FT12')
      !v1andv2supports.append('FT35')
      !v1andv2supports.append('FT49')
      !v1andv2supports.append('FT51')
      !v1andv2supports.append('FT52')

      !v1andbar1supports.append('FT10')
      !v1andbar1supports.append('FT11')
      !v1andbar1supports.append('FT13')

      !bar1andbar1supports.append('FT30')
      !bar1andbar1supports.append('FT54A')
      !bar1andbar1supports.append('FT54B')
      !bar1andbar1supports.append('FT54C')
      !bar1andbar1supports.append('FT54D')
      !bar1andbar1supports.append('FT55A')
      !bar1andbar1supports.append('FT55B')
      !bar1andbar1supports.append('FT55C')
      !bar1andbar1supports.append('FT55D')

      --*** INSERT SECTION FOR FT15 and FT28 HERE 26/5/06
      --*** ALSO GT, FR, VTs

      if (!v1onlysupports.findfirst(!this.support.type).unset().not()) then

        -- set support object connections
        !vertDbref = ARRAY()
        !vert1 = !name & '-V1'
        !vertDbref[1] = !vert1.dbref()
        handle ANY
        elsehandle NONE

          !conn1 = !vertDbref[1].:MDSConn
          !this.support.connections[1] = !conn1

          -- set support object for joints
          !this.support.joints = !!mdsGetJoints(!vertDbref)
        endhandle
      elseif (  !bar1onlysupports.findfirst(!this.support.type).unset().not()) then

        -- set support object connections
        !vertDbref = ARRAY()
        !vert1 = !name & '-BAR-1'
        !vertDbref[1] = !vert1.dbref()
        handle ANY
        elsehandle NONE

          !conn1 = !vertDbref[1].:MDSConn
          !this.support.connections[1] = !conn1

          -- set support object for joints

          !this.support.joints = !!mdsGetJoints(!vertDbref)
        endhandle
      elseif (  !v1andv2supports.findfirst(!this.support.type).unset().not()) then

        -- set support object connections
        !vertDbref = ARRAY()
        !vert1 = !support & '-V1'
        !vertDbref[1] = !vert1.dbref()
        handle ANY
        elsehandle NONE
          !conn1 = !vertDbref[1].:MDSConn
          !vert2 = !support & '-V2'
          !vertDbref[2] = !vert2.dbref()
          !conn2 = !vertDbref[2].:MDSConn
          !this.support.connections[1] = !conn1
          !this.support.connections[2] = !conn2

          -- set support object for joints
          !this.support.joints = !!mdsGetJoints(!vertDbref)
        endhandle
      elseif (!v1andbar1supports.findfirst(!this.support.type).unset().not()) then

        -- set support object connections
        !connectedSctns = ARRAY()
        !vert1 = !name & '-V1'
        !connectedSctns[1] = !vert1.dbref()
        handle ANY
        elsehandle NONE

          !conn1 = !connectedSctns[1].:MDSConn
          !hori = !name & '-BAR-1'
          !connectedSctns[2] = !hori.dbref()
          !conn2 = !connectedSctns[2].:MDSConn
          !this.support.connections[1] = !conn1
          !this.support.connections[2] = !conn2

          -- set support object for joints

          !this.support.joints = !!mdsGetJoints(!connectedSctns)
        endhandle
      elseif (!bar1andbar1supports.findfirst(!this.support.type).unset().not()) then

        -- set support object connections
        !connectedSctns = ARRAY()
        !vert1 = !name & '-BAR-1'
        !connectedSctns[1] = !vert1.dbref()
        handle ANY
        elsehandle NONE

          !conn1 = !connectedSctns[1].:MDSConn
          !hori = !name & '-BAR-1'
          !connectedSctns[2] = !hori.dbref()
          !conn2 = !connectedSctns[2].:MDSConn
          !this.support.connections[1] = !conn1
          !this.support.connections[2] = !conn2

          -- set support object for joints
          !this.support.joints = !!mdsGetJoints(!connectedSctns)
        endhandle
      endif

---------------------------------------------------------------------------
      --run mdschecklen integrity checker here as a method of this object

      !this.mdsintegrity(!this)
      --!this.supportobj = object MDSSUPPORT()

      --integrity checker errors

      if (!this.integrityerrors.gt(0)) then
        !this.supporterrorflag = TRUE
        !this.supporterrors = !this.supporterrors + !this.integrityerrors
      endif

      --integrity checker warnings
      if (!this.integritywarnings.gt(0)) then
        !this.supportwarningflag = TRUE
        !this.supportwarnings = !this.supportwarnings + !this.integritywarnings
      endif

      --$p integrity checker information;
      --q var !this.integrityerrorarray
      --q var !this.integrityerrors
      --q var !this.integritywarnings
      --q var !this.integritymessages

      --!this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
      --!this.currenterrorobject.errorarray.append('MDS Integrity Checker Output:')
      --!this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')
      !this.currenterrorobject.errorarray.appendarray(!this.integrityerrorarray)
      --!this.currenterrorobject.errorarray.append('--------------------------------------------------------------------------------')

----end integrity checker section
-------------------------------------------------------------------------

    endif

  endif

  !!ce = !preframcheckce

  !this.currenterrorobject.numerrors = !this.supporterrors

  !this.currenterrorobject.numwarnings = !this.supportwarnings

  if (!this.supporterrorflag.eq(TRUE)) then
    --!this.totalsupporterrors = !this.totalsupporterrors + 1
    --!this.totalerrors = !this.totalerrors + !this.supporterrors

    !this.outputmessage.append('Framework support $!support has $!this.supporterrors errors')
  else
    !this.outputmessage.append('No errors with framework support $!support')
  endif

  if (!this.supportwarningflag.eq(TRUE)) then
    --!this.totalsupportwarnings = !this.totalsupportwarnings + 1
    --!this.totalwarnings = !this.totalwarnings + !this.supportwarnings

    !this.outputmessage.append('Framework support $!support has $!this.supportwarnings warnings')
  else
    !this.outputmessage.append('No warnings with framework support $!support')
  endif

  !this.outputmessage.append('--------------------------------------------------------------------------------')

  --!this.outputmessage.append('')

endmethod
-------------------------------------------------------------------------
-------------------------------------------------------------------------
define method .mdsintegrity(!form is ANY)

  if (!form.objecttype().eq('FORM')) then
    !mode = 'FORM'
  elseif (!form.objecttype().eq('MDSHEALTHCHKDATA')) then
    !mode = 'HEALTH'
  endif

 -- Find current units and set the distance unit to metric
  !currentUnits = !!kGetSetUnits()
    mm dist mm bore

  --!origin    = !!ce
  if (!mode.eq('FORM')) then
    !!mdsCheckLen.ok.active = TRUE
    endif
  !errors      = 0
  !warnings    = 0
  !messages    = 0

  !form.support.compensation = !!mdsCompplateDflts.compensatingPlates(!form.support)

  -- Move to structure

  !!ce = !form.support.stru
  --!type = !!ce.:MDSSuppType

-------------------------------
--> Modified - <wd> - 11sep1998
    if (!!ce.type.eq('STRU')) then
      !mdschk = !!ce.:mdscheck
      if (!mdschk) then
        !errorflag = 'Error'
      else
        !errorflag = 'Warning'
      endif
    endif
--< Modified - <wd> - 11sep1998
-------------------------------

  -- Collect sctns for overlength sizes check

  !verticals = !!kCollectAllFor(|SCTN|, '(MATCHWILD(NAME,|*-V*|))', CE)
  !crossBars = !!kCollectAllFor(|SCTN|, '(MATCHWILD(NAME,|*-BAR-*|))', CE)

  !bars = ARRAY()
  !bars.appendarray(!verticals)
  !bars.appendarray(!crossBars)
  !error = ARRAY()

  -- If the type of support is a special issue a note at the top of the form

--<mjb> Support steelwork members are checked in mdshealthchk utility so below section not needed
  if (!mode.neq('HEALTH')) then

    if (!form.support.type eq 'SPECIAL' and !form.support.modify eq FALSE) then
      !error.append(|**   Message  ** - Please now create the support steelwork using the structural|)
      !error.append(|                 - steel application. A framework has been provided under the|)
      !error.append(|                 - support stru element for this purpose.|)
      !error.append(| |)
      !messages = !messages + 1
    endif

    --!!mdsCheckLen.errorList.clear()

  endif
  --<mjb> mod ends

  -- Check to see if any of the cross bars exceed the maximum length
  -- as defined by the template design parameters which are stored in mm
  -- but want displaying in the project units

  -- Also if the design parameter 2 exists this is the minimum length if so check it

-->>>-<wd>nov2002
  --if (!form.support.type neq 'SPECIAL') then
  if ((!form.support.type neq 'SPECIAL') and (!form.support.type neq 'FT25')) then
--<<<-<wd>nov2002

    do !check1 index !bars
      !!ce = !bars[$!check1]

-- Check for maximum length if set in members design parameter 1
      !maxLen = despar
      !length = deri length
      !memname = !!ce.name

      if (defined(!maxLen[1])) then
        if (!length.nint() gt !maxLen[1]) then
          !error.append(|**   $!errorflag   ** - Section longer than template default|)
          !error.append(|Section Name               = $!memname|)
          !!kFormatText.text.val = !length
          !actuallen = !length.string(!!distancefmt)
          !error.append(|Actual Length              = $!actuallen|)
          !!kFormatText.text.val = !maxLen[1]
          !maxtmplen = !!kFormatText.text.val.string(!!distancefmt)
          !error.append(|Maximum Template Length    = $!maxtmplen|)
          !error.append(|--------------------------------------------------------------------------------|)
          if (!mdschk) then
            !errors   = !errors + 1
            if (!mode.eq('FORM')) then
              !!mdsCheckLen.ok.active = FALSE
            endif
          else
            !warnings = !warnings + 1
          endif
        endif
      else
        !error.append(|**   Warning   ** - Section does not have a maximum length|)
        !error.append(|                  - set in the MDS template|)
        !error.append(|Section Name               = $!memname|)
        !error.append(|--------------------------------------------------------------------------------|)
        !warnings = !warnings + 1
      endif

      -- Check for minimum length
      if (defined(!maxLen[2])) then
        if (!length.nint() lt !maxLen[2]) then
          !error.append(|**   $!errorflag   ** - Section shorter than template default|)
          !error.append(|Section Name               = $!memname|)
          !!kFormatText.text.val = !length
          !actuallen = !length.string(!!distancefmt)
          !error.append(|Actual Length              = $!actuallen|)
          !!kFormatText.text.val = !maxLen[2]
          !maxtmplen = !!kFormatText.text.val.string(!!distancefmt)
          !error.append(|Minimum Template Length    = $!maxtmplen|)
          !error.append(|--------------------------------------------------------------------------------|)
          if (!mdschk) then
            !errors   = !errors + 1
            if (!mode.eq('FORM')) then
              !!mdsCheckLen.ok.active = FALSE
            endif
          else
            !warnings = !warnings + 1
          endif
        endif
      endif

    enddo
  endif

  -- Is the atta sitting on it's associated cross bar
  -- If it is not block the ok gadget out so that the user
  -- cannot finish the support

  if (!form.support.type.eq('FT16') OR !form.support.type.eq('FT50')) then
     golabel /skippack
  endif

  do !check2 index !crossBars

    !!ce = !crossBars[$!check2]
-- MJB 31/05/06

    --skip if (!form.string() inset('MDSVT01','MDSVT02','MDSVT03','MDSVT04','MDSTT01','MDSTT02','MDSTT03'))

    skip if (!form.support.type inset('VT01','VT02','VT03','VT04','TT01','TT02','TT03'))

-- MJB END 31/05/06
    !memname = !!ce.name
    !start = poss wrt world
    !end   = pose wrt world
    pin 9 at $!start
    pin 8 at $!end
    !associated = !!ce.:MDSAttaRef

    do !asso values !associated
      !packermess = FALSE
      !guidemess  = FALSE
      !!ce = !asso
      handle ANY
        skip
      endhandle

      !attaname = !!ce.name

----------------------------------------------------------------
--<wd>mar2006<mds12>
-- ONLY Determine the mdsreadparsdata OBJECT when the ATTA is NOT a "REST" type ATTA
      if (!!ce.stype.matchwild(|*-REST*|).not()) then
-- ONLY DETERMINE ONCE the MDS ANCILLARY ATTA DEFAULTS DATA OBJECT for the BORE SIZE
        !lbor = !!ce.lbor.real()
        !mdsattaobj  = object MDSREADPARSDATA()
        !mdsattadefs = !mdsattaobj.mdsdefsdata(!!ce.stype,!lbor)

        -- skip when the MDS ANCILLARY is NOT ACTIVE for MDS DEFAULTS CATALOGUE in
-- the CURRENT PROJECT or it does NOT exist in the MDS DEFAULTS CATALOGUE
        if (!mdsattadefs.not()) then
          !error.append(|**   Warning   ** - NO CHECK has been PERFORMED for this ATTA. The MDS STANDARD is not ACTIVE in the MDS  |)
          !error.append(|                          - DEFAULTS CATALOGUE or it DOES not EXIST in the MDS DEFAULTS CATALOGUE.|)
          !error.append(|Atta    Name                  = $!attaname|)
          !error.append(|Section Name               = $!memname|)
          !error.append(|--------------------------------------------------------------------------------|)
          !warnings = !warnings + 1
          skip
        endif
      endif
--<wd>mar2006<mds12>
----------------------------------------------------------------

---------------------------------------------------------------------------------------------------------
-->>>-<wd>dec2002
--<wd>16jun2004 --'AT65' and 'AT96' added to Comments
-- Check if Atta is a valid Cradle/Reinforcing Pad ('AT05', 'AT09', 'AT23', 'AT65'))
-- or a valid Shoe, Welded to the Pipe ('AT01', 'AT02', 'AT12', 'AT13','AT14', 'AT15', 'AT18', 'AT19', 'AT96')
-- Clamp-On Shoes are NOT suitable for Cradle/Reinforcing Pads

--<wd>16jun2004
      --if ((!asso.stype inset('AT05', 'AT09', 'AT23','AT01', 'AT02', 'AT12', 'AT13','AT14', 'AT15', 'AT18', 'AT19', 'AT65' ) ) and (!asso.:mdssref.badref().not()) ) then
      if ((!asso.stype inset('AT05', 'AT09', 'AT23', 'AT01', 'AT02', 'AT12', 'AT13','AT14', 'AT15', 'AT18', 'AT19', 'AT65', 'AT96' ) ) and (!asso.:mdssref.badref().not()) ) then
--<wd>16jun2004
        if (!asso.stype inset('AT05', 'AT09', 'AT23' , 'AT65')) then
          !atype = 'PAD '
          !btype = 'SHOE'
        else
          !atype = 'SHOE'
          !btype = 'PAD '
        endif
        !sref = !asso.:mdssref
        !snam = !sref.name

-- Check if the Shoe and Pad Attas are on this MDS Framework
        !findsref = !form.support.atta.find(!sref)

--MJB 31/05/06
        if (!mode.eq('FORM')) then
          !struname = !form.name.val
        else
          !struname = !this.currentsupportname
        endif
--MJB END

        if (!findsref.empty()) then
          !error.append(|**    Error    ** - The Associated SHOE/PAD Atta is not a member of this MDS Support|)
          !error.append(|MDS   Support Name        = $!struname|)
          !error.append(|$!atype  Atta    Name        = $!attaname|)
          !error.append(|$!btype  Atta    Name        = $!snam|)
          !error.append(|--------------------------------------------------------------------------------|)
          if (!mode.eq('FORM')) then
            !!mdsCheckLen.ok.active = FALSE
          endif
          !errors = !errors + 1
          skip
        endif

-- Check if the Shoe and Pad Attas are on the Same Cross Bar
        !findsref = !associated.find(!sref)
        if (!findsref.empty()) then
          !error.append(|**    Error    ** - The Associated Atta does not belong to the same Framework Cross Bar Section as the SHOE/PAD Atta|)
          !error.sppend(|Section Cross Bar Name        = $!memname|)
          !error.append(|$!atype  Atta    Name        = $!attaname|)
          !error.append(|$!btype  Atta    Name        = $!snam|)
          !error.append(|--------------------------------------------------------------------------------|)
          !!mdsCheckLen.ok.active = FALSE
          !errors = !errors + 1
          skip
        endif

-- Check if the Shoe Atta is on the Same Pipe Branch as the Pad Atta
        if (!sref.owner.neq(!asso.owner)) then
          !error.append(|**    Error    ** - The Associated Atta is not a member of the same Pipe Branch as the Associated SHOE/PAD Atta|)
          !error.append(|$!atype  Atta    Name        = $!attaname|)
          !error.append(|$!btype  Atta    Name        = $!snam|)
          !error.append(|--------------------------------------------------------------------------------|)
          if (!mode.eq('FORM')) then
            !!mdsCheckLen.ok.active = FALSE
          endif
          !errors = !errors + 1
          skip
        endif

--<wd>28jun2004
-- For the AT65 - a FULL ENCIRCLEMENT WRAPPER PLATE - The ORIENTATION CHECK is NOT REQUIRED when
-- EITHER the Current ATTA is an AT65
-- OR the :MDSSREF attribute of a Pipe Shoe(Current ATTA) is set to an AT65 ATTA
        if (not !asso.stype inset('AT65')) then
          if (not !sref.styp inset ('AT65')) then
--<wd>28jun2004

-- Check if Shoe Atta is in the Same Orientation as the Pad Atta
            !srefp9dir = !sref.pdir[9].wrt(/* )
            !assop9dir = !asso.pdir[9].wrt(/* )
-- Set object definition
            !direction = object KEQUALDIR()
            !direction.directionA = !srefp9dir
            !direction.directionB = !assop9dir
            !direction.tolerance  = 0.05
            if (!!kDirEqualDir(!direction).not()) then
              !error.append(|**    Error    ** - The Associated Atta is not in the same Orientation as the Associated SHOE/PAD Atta|)
              !error.append(|$!atype  Atta    Name        = $!attaname|)
              !error.append(|$!btype  Atta    Name        = $!snam|)
              !error.append(|--------------------------------------------------------------------------------|)
              if (!mode.eq('FORM')) then
                !!mdsCheckLen.ok.active = FALSE
              endif
               !errors = !errors + 1
              skip
            endif

--<wd>28jun2004
          endif
        endif
--<wd>28jun2004


-- Check if Shoe Atta is in the Same Position as the Pad Atta
        pin 1 at $!sref
        pin 2 at $!asso
        !dist = !!kStrReal ('cons dist pin 1 to pin 2')
        if (!dist.gt(1)) then
          !error.append(|**    Error    ** - The Associated Atta is not in the same Position as the Associated SHOE/PAD Atta|)
          !error.append(|$!atype  Atta    Name          = $!attaname|)
          !error.append(|$!btype  Atta    Name          = $!snam|)
          !error.append(|--------------------------------------------------------------------------------|)
          if (!mode.eq('FORM')) then
            !!mdsCheckLen.ok.active = FALSE
          endif
          !errors = !errors + 1
          skip
        endif

        -- All the Above Conditions have been successfully passed so skip if the current Atta is the PAD Atta referencing the SHOE Atta
        -- skip if ATTA is a Valid CRADLE/REINFORCING PAD and it is ASSOCIATED with a Valid SHOE ATTA
        skip if (!asso.:mdscp3.eq('SHOE'))

      endif
--<<<-<wd>dec2002
---------------------------------------------------------------------------------------------------------


--<tm> removed after rotation mods
$(
-- skip if atta has been rotated
if !!ce.:MDSRotated then
!error.append(|**   Warning   ** - The atta is not normal to the cross bar and no packing|)
!error.append(|                  - distance check has been performed.|)
        !error.append(|Atta    Name               = $!attaname|)
!error.append(|Section Name               = $!memname|)
!error.append(|--------------------------------------------------------------------------------|)
!warnings = !warnings + 1
        skip
      endif
$)
--<tm> 19/04/2005 08:33

--<wd>feb2004
      skip if (!asso.stype inset ('AT62','AT69','AT70','AT71'))
--<wd>feb2004

-- Check associated atta for valid guide reference and add to output
      if (!asso.:MDSGuideRef.badref().not()) then
        !guideref  = !asso.:MDSGuideRef.name
        !errmessg  = |!error.append('Atta Guide Name            = $!guideref')|
      else
        if (!asso.:MDSGuideRef.unset()) then
          !guideref = 'Unset'
          !errmessg = |!error.append('')|
        elseif (!asso.:MDSGuideRef.badref()) then
          !guide     = !asso.:MDSGuideRef
          !errmessg  = |!error.append('Unknown Atta Guide DB Ref  = $!guide')|
        endif
      endif
--
-- Check associated atta for valid pack reference and add to output
      if (!asso.:MDSPackRef.badref().not()) then
        !packref  = !asso.:MDSPackRef.name
        !errmess  = |!error.append('Atta Packing Piece Name    = $!packref')|
      else
        if (!asso.:MDSPackRef.unset()) then
          -- !packref = 'Unset - Packing Piece Required?'
          !packref = 'Unset'
          !errmess = |!error.append('Atta Packing Piece Name    = $!packref')|
        elseif (!asso.:MDSPackRef.badref()) then
          !pack    = !asso.:MDSPackRef
          !errmess = |!error.append('Unknown Atta Packer DB Ref = $!pack')|
        endif
      endif
--
--
      pin 7 copy p9
      pin 7 plane pin 7 thro $!start
      !checkdist = !!kStrReal('CONST DIST PIN 9 TO PIN 8')
      !dist1 = !!kStrReal('CONST DIST PIN 9 TO PIN 7')
      !dist2 = !!kStrReal('CONST DIST PIN 8 TO PIN 7')

      -- Do not check on type VT07,VT08.vT09

      !stdType = !form.support.type
      if (not !stdType inset ('VT07','VT08','VT09')) then

        --<wd>10aug2004 - skip if Ancillary has been Nudged away from the STRU position
        skip if (!asso.:mdsnudgedist.neq(0))
--<wd>10aug2004

        if (!dist1 gt !checkdist or !dist2 gt !checkdist) then
          !error.append(|**    Error    ** - Atta is not on the associated cross bar|)
          !error.append(|Atta    Name              = $!attaname|)
          !error.append(|Section Name              = $!memname|)
          $!errmess
          $!errmessg
          !error.append(|--------------------------------------------------------------------------------|)
          if (!mode.eq('FORM')) then
            !!mdsCheckLen.ok.active = FALSE
          endif
          !errors = !errors + 1
          !packermess = TRUE
          !guidemess  = TRUE
        endif
      endif
      pin 7 copy p9

--------------
      -- Need to copy sctn and delete members as these could be joints and the spacing will
      -- be incorrect if there is joints.

      !here = !!ce
      !!ce = $!crossBars[$!check2]
      new sctn copy attrib of prev
      delete sctn mem
      handle ANY
        endhandle
      -- pin 7 plane pin 7 clear 0 inf $!crossBars[$!check2]

      stru
      var !zdir dir z
      !newzdir = !zdir.direction().opposite()
      --pin 7 dir $!newzdir
      same
      --pin 7 plane pin 7 clear 0 inf cev
      pin 7 plane $!newzdir clear 0 inf ce
      delete sctn
      !!ce = !here
--------------
--> Modified -<wd>- 4nov1998
-- For the 'NEW' HVAC Designer Only
-- 18/8/2000      if (!form.support.alias inset ('DT01','DT02','DT03','DT04')) then
      if ((!form.support.alias inset ('DT01','DT02','DT03','DT04')) or !asso.owner.owner.type.eq('HVAC')) then
        !pplist   = pplst of prev of $!asso
        !cadchvac = FALSE
        do !ppval values !pplist
          if (!ppval.eq(61)) then
            !cadchvac = TRUE
            break
          else
            skip
          endif
        enddo
        if (!cadchvac) then
          pin 9 copy p9
          -- pin 9 dist ($!asso.despar[2] / 2 )
          !dist = !!kStrReal('const dist pin 9 to pin 7')
          pin 7 dir from pin 9 to pin 7
            handle (2,357)
            endhandle
        else
          !dist = !!kStrReal('const dist p9 to pin 7')
          pin 7 dir from p9 to pin 7
            handle (2,357)
            endhandle
        endif

      else
-- Original Code for ALL OTHER Supported PIPES/HVAC/CABLETRAYS
        !dist = !!kStrReal('CONST DIST P9 TO PIN 7')
        pin 7 dir from p9 to pin 7
            handle (2,357)
            endhandle
      endif
--< Modified -<wd>- 4nov1998

      var !pin7Dir pin 7 dir wrt world
      var !p9Dir p9 dir wrt world

      -- Set object definition
      !direction = object KEQUALDIR()
      !direction.directionA = !pin7Dir.direction()
      !direction.directionB = !p9Dir.direction()
      !direction.tolerance  = 0.05

      --if (!!kDirEqualDir(!direction).not()) then
      --!direction = object KEQUALDIR()
      --!direction.directionA = !pin7Dir.direction()
      --!direction.directionB = !p9Dir.direction().opposite()
      --!direction.tolerance  = 0.05
      --endif

      if (!!kDirEqualDir(!direction).not()) then
        !distReal = !dist - !dist - !dist
--> Modified -<wd>- 16sep1998
--> Anything UNDER -2mm is NOW IGNORED (Default Clearance for CLASHER)
--$P---------------------------------------------
        --$P ATTA NAME is --$!<attaname>--
        --$P ** line 201 ** !distReal is &&$!<distReal>&&
        --        if (!distReal neq 0) then
        if (!distReal.lt(-2)) then
--> Modified -<wd>- 16sep1998
          !stdType = !form.support.type
--<wd>dec2003
--<wd>dec2003 -- If the Owning TYPE is an HVAC<Pipe> ignore the Packing Piece Check
          --if (not !stdType inset ('GT05','GT09','VT07','VT08','VT09')) then
          if ((not !stdType inset ('GT05','GT09','VT07','VT08','VT09')) and (not !asso.owner.owner.type inset ('HVAC'))) then
--<wd>dec2003
            if (!distReal.abs() gt !!mdsOptions.maxPack.val) then
              !error.append(|**    Error    ** - Packing distance between pipe and steelwork is a negative|)
              !error.append(|                  - value, therefore the pipe is not supported correctly or the|)
              !error.append(|                  - atta is not associated with the correct cross-bar|)
              !error.append(|Atta    Name               = $!attaname|)
              !error.append(|Section Name               = $!memname|)
              ----------------------------------------------------------------
              --> Modified - <wd> - may2000
              ----------------------------------------------------------------
              !!kFormatText.text.val = !distReal
              --              !error.append(|Actual  Distance           = $!!kFormatText.text.val|)
              !packdist = !distReal.string(!!distancefmt)
              !error.append(|Actual  Distance           = $!packdist|)
              $!errmess
              $!errmessg
              !error.append(|--------------------------------------------------------------------------------|)
              if (!mode.eq('FORM')) then
                !!mdsCheckLen.ok.active = FALSE
              endif
              !errors = !errors + 1
              !packermess = TRUE
              !guidemess  = TRUE
            else
              !error.append(|**   Warning   ** - Packing distance between pipe and steelwork is a negative|)
              !error.append(|                  - value, therefore the pipe is not supported correctly or the|)
              !error.append(|                  - atta is not associated with the correct cross-bar|)
              !error.append(|                  - This is within the allowable value in the defaults|)
              !error.append(|Atta    Name               = $!attaname|)
              !error.append(|Section Name               = $!memname|)
              !!kFormatText.text.val = !distReal
              --              !error.append(|Actual  Distance           = $!!kFormatText.text.val|)
              !packdist = !distReal.string(!!distancefmt)
              !error.append(|Actual  Distance           = $!packdist|)
              $!errmess
              $!errmessg
              !error.append(|--------------------------------------------------------------------------------|)
              !warnings = !warnings + 1
              !packermess = TRUE
              !guidemess  = TRUE
            endif
          endif
        endif
      else
        !distReal = !dist
        if (!distReal gt !!mdsOptions.packing.val) then
--<wd>18aug2004
-- This Message has been Changed from a Warning to and Error
-- If a Flying SHOE is required then the DEFAULT MAXIMUM PACKING DISTANCE should CATER for the DISTANCE REQUIRED
-- between the UnderSide of the SHOE & the TOP FACE of the Associated Cross Bar on the MDS Support
          --!error.append(|**   Warning   ** - Packing distance between pipe and steelwork exceeds the|)
          !error.append(|**   Error   ** - Packing distance between pipe and steelwork exceeds the|)
--<wd>18aug2004
          !error.append(|                  - allowable maximum distance or the atta is not associated|)
          !error.append(|                  - with the correct cross-bar|)
          !error.append(|Atta    Name               = $!attaname|)
          !error.append(|Section Name               = $!memname|)
          !!kFormatText.text.val = !distReal
          --          !error.append(|Actual  Distance           = $!!kFormatText.text.val|)
          !packdist = !distReal.string(!!distancefmt)
          !error.append(|Actual  Distance           = $!packdist|)
          !!kFormatText.text.val = !!mdsOptions.packing.val
          --          !error.append(|Maximum Distance           = $!!kFormatText.text.val|)
          !maxpackdist = !!mdsOptions.packing.val.string(!!distancefmt)
          !error.append(|Maximum Distance           = $!maxpackdist|)
          ----------------------------------------------------------------
          --< Modified - <wd> - may2000
          ----------------------------------------------------------------
          $!errmess
          $!errmessg
          !error.append(|--------------------------------------------------------------------------------|)

--<wd>18aug2004
-- This Message has been Changed from a "Warning" to an "Error" - So Deactivate the "OK" button
          if (!mode.eq('FORM')) then
            !!mdsCheckLen.ok.active = FALSE
          endif
          !errors = !errors + 1
          --!warnings = !warnings + 1
--<wd>18aug2004

          !packermess = TRUE
          !guidemess  = TRUE
        else
--> Modified -<wd>- 16sep1998
-- Only issue a message if Packing distance is greater than 0(zero)
--> Anything UNDER 2mm is NOW IGNORED
-- Only issue a message if Packing distance is greater than 2mm (Default Clearance for CLASHER)
--$P---------------------------------------------
          --$P ATTA NAME is --$!<attaname>--
          --$P ** line 256 ** !distReal is &&$!<distReal>&&
          --          if (!distReal gt 0) then

          if (!form.support.compensation.set() and !form.support.compensation.empty().not()) then
            do !comp values !form.support.compensation
              if (!comp.atta.name eq !attaname and !comp.sctn eq !memname) then
                !distReal = !distReal - !comp.gap()
                break
              endif
            enddo
          endif

          if (!distReal.gt(2)) then
--< Modified -<wd>- 16sep1998
--<mjb> 24.05.06 changed from message to warning when writing mdshealthchk for <mds12>
            !error.append(|**   Warning   ** - Packing distance between pipe and section|)
            !error.append(|Atta    Name               = $!attaname|)
            !error.append(|Section Name               = $!memname|)
----------------------------------------------------------------
--> Modified - <wd> - may2000
----------------------------------------------------------------
            !!kFormatText.text.val = !distReal
            --            !error.append(|Distance                   = $!!kFormatText.text.val|)
            !packdist = !distReal.string(!!distancefmt)
            !error.append(|Distance                   = $!packdist|)
----------------------------------------------------------------
--< Modified - <wd> - may2000
----------------------------------------------------------------
            $!errmess
            $!errmessg
            !error.append(|--------------------------------------------------------------------------------|)
            --!messages = !messages + 1
            !warnings = !warnings + 1
--<mjb> mod ends
            !packermess = TRUE
            !guidemess  = TRUE
          endif
        endif
      endif
--
-- Check if the Guide reference error has been output
      if (!guidemess.not()) then
        if (!asso.:MDSGuideRef.badref() and !asso.:MDSGuideRef.unset().not()) then
          !error.append(|**   Warning   ** - Guide Atta Reference Problem|)
          !error.append(|Atta    Name               = $!attaname|)
          !error.append(|Section Name               = $!memname|)
          $!errmessg
          !error.append(|--------------------------------------------------------------------------------|)
          !warnings  = !warnings + 1
          !guidemess = TRUE
        endif
      endif
--
-- Check if the Packing reference error has been output
      if (!packermess.not()) then
        if (!asso.:MDSPackRef.badref() and !asso.:MDSPackRef.unset().not()) then
          !error.append(|**   Warning   ** - Packing Piece Atta Reference Problem|)
          !error.append(|Atta    Name               = $!attaname|)
          !error.append(|Section Name               = $!memname|)
          $!errmess
          !error.append(|--------------------------------------------------------------------------------|)
          !warnings   = !warnings + 1
          !packermess = TRUE
        endif
      endif
--
--
-- Check to see if an atta is bigger than the defaults allow
-- Check height stored in dataset with a dkey of HEI

--<wd>jan2004
      skip if (!!ce.styp inset ('ST09A','ST09B','ST10A','ST10B','ST11A','ST11B','ST12','ST13A','ST13B','ST14'))
--<wd>jan2004

      var !check (prop HEI of ce )
      handle NONE
----------------------------------------------------------------
--<wd>mar2006<mds12>
        --!parVar = '!!mdsPar' & !!ce.styp
        !!kRestoreUnits(!currentUnits)
        mm bore
        --!bore = pa bore
--<wd>mar2006<mds12>
----------------------------------------------------------------

        !!kRestoreUnits(!currentUnits)
        !currentUnits = !!kGetSetUnits()
        !dpNum = !!mdsGetDesp('HEI')

----------------------------------------------------------------
--> Modified - <wd> - may2000
----------------------------------------------------------------
        --var !currVal despar $!dpNum
        !currVal = !!ce.despar[$!dpNum]

--<wd>oct2004
-- Some Ancillaries are NOT consistent, e.g. GT21 has a PROPERTY of 'HEI' at DESPAR[1.
-- This is actually the SHOE HEIGHT to which the GT21 Guide is attached. (Should really be 'SHEI')
        -- The CODE below has been modified so that it will now skip the ATTA if the
        -- USERDPS[DESPAR NUMBER] doesn't exist in the OBJECT i.e. $!parVar[$!bore].userdps[$!dpNum] is undefined
--
----------------------------------------------------------------
--<wd>mar2006<mds12>
        --skip if (undefined($!parVar[$!bore].userdps[$!dpNum]))
        skip if (undefined(!mdsattaobj.userdps[$!dpNum]))
--<wd>oct2004

-- Determine the MDS ANCILLARY OBJECT USER DESPARS DATA for the BORE SIZE
        --!min = $!parVar[$!bore].userdps[$!dpNum].min
        !min = !mdsattaobj.userdps[$!dpNum].min
        handle NONE
          --!max = $!parVar[$!bore].userdps[$!dpNum].max
          !max = !mdsattaobj.userdps[$!dpNum].max
          --<wd>mar2006<mds12>
          ----------------------------------------------------------------

          if (!currVal.real() lt !min) then
            !error.append(|**    Error    ** - Atta exceeds the minimum height allowed in the default file|)
            !error.append(|Atta    Name              = $!attaname|)
            !!kFormatText.text.val = !currVal.real()
            --          !error.append(|Actual  Value             = $!!kFormatText.text.val|)
            !currValdist = !currVal.string(!!distancefmt)
            !error.append(|Actual  Value             = $!currValdist|)
            !!kFormatText.text.val = !min
            --          !error.append(|Minimum Allowed           = $!!kFormatText.text.val|)
            !minvaldist = !min.string(!!distancefmt)
            !error.append(|Minimum Allowed           = $!minvaldist|)
            !error.append(|--------------------------------------------------------------------------------|)
            if (!mode.eq('FORM')) then
              !!mdsCheckLen.ok.active = FALSE
            endif
            !errors = !errors + 1
          elseif (!currVal.real() gt !max) then
            !error.append(|**    Error    ** - Atta exceeds the maximum height allowed in the default file|)
            !error.append(|Atta    Name              = $!attaname|)
            !!kFormatText.text.val = !currVal.real()
            --          !error.append(|Actual  Value             = $!!kFormatText.text.val|)
            !currValdist = !currVal.string(!!distancefmt)
            !error.append(|Actual  Value             = $!currValdist|)
            !!kFormatText.text.val = !max
            --          !error.append(|Maximum Allowed           = $!!kFormatText.text.val|)
            !maxvaldist = !max.string(!!distancefmt)
            !error.append(|Maximum Allowed           = $!maxvaldist|)
            ----------------------------------------------------------------
            --< Modified - <wd> - may2000
            ----------------------------------------------------------------
            !error.append(|--------------------------------------------------------------------------------|)
            if (!mode.eq('FORM')) then
              !!mdsCheckLen.ok.active = FALSE
            endif
            !errors = !errors + 1
          endif
        elsehandle ANY
        endhandle
      elsehandle ANY
      endhandle

      -- Check length stored in dataset with a dkey of LEN

      var !check (prop LEN of ce )
      handle NONE
----------------------------------------------------------------
--<wd>mar2006<mds12>
        --!parVar = '!!mdsPar' & !!ce.styp
        !!kRestoreUnits(!currentUnits)
        mm bore
        --!bore = pa bore
--<wd>mar2006<mds12>
----------------------------------------------------------------

        !!kRestoreUnits(!currentUnits)
        !currentUnits = !!kGetSetUnits()
        !dpNum = !!mdsGetDesp('LEN')
----------------------------------------------------------------
--> Modified - <wd> - may2000
----------------------------------------------------------------
        --var !currVal despar $!dpNum
        !currVal = !!ce.despar[$!dpNum]

----------------------------------------------------------------
--<wd>mar2006<mds12>
-- Determine the MDS ANCILLARY OBJECT USER DESPARS DATA for the BORE SIZE
        --!min = $!parVar[$!bore].userdps[$!dpNum].min
        !min = !mdsattaobj.userdps[$!dpNum].min
        handle NONE
          --!max = $!parVar[$!bore].userdps[$!dpNum].max
          !max = !mdsattaobj.userdps[$!dpNum].max
          --<wd>mar2006<mds12>
          ----------------------------------------------------------------

          if (!currVal.real() lt !min) then
            !error.append(|**    Error    ** - Atta exceeds the minimum length allowed in the default file|)
            !error.append(|Atta    Name              = $!attaname|)
            !!kFormatText.text.val = !currVal.real()
            --          !error.append(|Actual  Value             = $!!kFormatText.text.val|)
            !currValdist = !currVal.string(!!distancefmt)
            !error.append(|Actual  Value             = $!currValdist|)
            !!kFormatText.text.val = !min
            --          !error.append(|Minimum Allowed           = $!!kFormatText.text.val|)
            !minvaldist = !min.string(!!distancefmt)
            !error.append(|Minimum Allowed           = $!minvaldist|)
            !error.append(|--------------------------------------------------------------------------------|)
            if (!mode.eq('FORM')) then
              !!mdsCheckLen.ok.active = FALSE
            endif
            !errors = !errors + 1
          elseif (!currVal.real() gt !max) then
            !error.append(|**    Error    ** - Atta exceeds the maximum length allowed in the default file|)
            !error.append(|Atta    Name              = $!attaname|)
            !!kFormatText.text.val = !currVal.real()
            --          !error.append(|Actual  Value             = $!!kFormatText.text.val|)
            !currValdist = !currVal.string(!!distancefmt)
            !error.append(|Actual  Value             = $!currValdist|)
            !!kFormatText.text.val = !max
            --          !error.append(|Maximum Allowed           = $!!kFormatText.text.val|)
            !maxvaldist = !max.string(!!distancefmt)
            !error.append(|Maximum Allowed           = $!maxvaldist|)
            ----------------------------------------------------------------
            --< Modified - <wd> - may2000
            ----------------------------------------------------------------
            !error.append(|--------------------------------------------------------------------------------|)
            if (!mode.eq('FORM')) then
              !!mdsCheckLen.ok.active = FALSE
            endif
            !errors = !errors + 1
          endif
        elsehandle ANY
        endhandle
      elsehandle ANY
      endhandle

      -- Check thickness stored in dataset with a dkey of THK

      var !check (prop THK of ce )
      handle NONE
----------------------------------------------------------------
--<wd>mar2006<mds12>
        --!parVar = '!!mdsPar' & !!ce.styp
        !!kRestoreUnits(!currentUnits)
        mm bore
        --!bore = pa bore
--<wd>mar2006<mds12>
----------------------------------------------------------------

        !!kRestoreUnits(!currentUnits)
        !currentUnits = !!kGetSetUnits()
        !dpNum = !!mdsGetDesp('THK')
----------------------------------------------------------------
--> Modified - <wd> - may2000
----------------------------------------------------------------
        --var !currVal despar $!dpNum
        !currVal = !!ce.despar[$!dpNum]

----------------------------------------------------------------
--<wd>mar2006<mds12>
-- Determine the MDS ANCILLARY OBJECT USER DESPARS DATA for the BORE SIZE
        --!min = $!parVar[$!bore].userdps[$!dpNum].min
        !min = !mdsattaobj.userdps[$!dpNum].min
        handle NONE
          --!max = $!parVar[$!bore].userdps[$!dpNum].max
          !max = !mdsattaobj.userdps[$!dpNum].max
          --<wd>mar2006<mds12>
          ----------------------------------------------------------------

          if (!currVal.real() lt !min) then
            !error.append(|**    Error    ** - Atta exceeds the thickness length allowed in the default file|)
            !error.append(|Atta    Name              = $!attaname|)
            !!kFormatText.text.val = !currVal.real()
            --          !error.append(|Actual  Value             = $!!kFormatText.text.val|)
            !currValdist = !currVal.string(!!distancefmt)
            !error.append(|Actual  Value             = $!currValdist|)
            !!kFormatText.text.val = !min
            --          !error.append(|Minimum Allowed           = $!!kFormatText.text.val|)
            !minvaldist = !min.string(!!distancefmt)
            !error.append(|Minimum Allowed           = $!minvaldist|)
            !error.append(|--------------------------------------------------------------------------------|)
            if (!mode.eq('FORM')) then
              !!mdsCheckLen.ok.active = FALSE
            endif
            !errors = !errors + 1
          elseif (!currVal.real() gt !max) then
            !error.append(|**    Error    ** - Atta exceeds the thickness length allowed in the default file|)
            !error.append(|Atta    Name              = $!attaname|)
            !!kFormatText.text.val = !currVal.real()
            --          !error.append(|Actual  Value             = $!!kFormatText.text.val|)
            !currValdist = !currVal.string(!!distancefmt)
            !error.append(|Actual  Value             = $!currValdist|)
            !!kFormatText.text.val = !max
            --          !error.append(|Maximum Allowed           = $!!kFormatText.text.val|)
            !maxvaldist = !max.string(!!distancefmt)
            !error.append(|Maximum Allowed           = $!maxvaldist|)
            ----------------------------------------------------------------
            --< Modified - <wd> - may2000
            ----------------------------------------------------------------
            !error.append(|--------------------------------------------------------------------------------|)
            if (!mode.eq('FORM')) then
              !!mdsCheckLen.ok.active = FALSE
            endif
            !errors = !errors + 1
          endif
        elsehandle ANY
        endhandle
      elsehandle ANY
      endhandle

      -- Check support centres stored in dataset with a dkey of SCEN

      var !check (prop SCEN of ce )
      handle NONE
----------------------------------------------------------------
--<wd>mar2006<mds12>
        --!parVar = '!!mdsPar' & !!ce.styp
        !!kRestoreUnits(!currentUnits)
        mm bore
        --!bore = pa bore
--<wd>mar2006<mds12>
----------------------------------------------------------------

        !!kRestoreUnits(!currentUnits)
        !currentUnits = !!kGetSetUnits()
        !dpNum = !!mdsGetDesp('SCEN')
----------------------------------------------------------------
--> Modified - <wd> - may2000
----------------------------------------------------------------
        --var !currVal despar $!dpNum
        !currVal = !!ce.despar[$!dpNum]

----------------------------------------------------------------
--<wd>mar2006<mds12>
-- Determine the MDS ANCILLARY OBJECT USER DESPARS DATA for the BORE SIZE
        --!min = $!parVar[$!bore].userdps[$!dpNum].min
        !min = !mdsattaobj.userdps[$!dpNum].min
        handle NONE
          --!max = $!parVar[$!bore].userdps[$!dpNum].max
          max = !mdsattaobj.userdps[$!dpNum].max
          --<wd>mar2006<mds12>
          ----------------------------------------------------------------

          if (!currVal.real() lt !min) then
            !error.append(|**    Error    ** - Atta exceeds the minimum support centres allowed in the default file|)
            !error.append(|Atta    Name              = $!attaname|)
            !!kFormatText.text.val = !currVal.real()
            --          !error.append(|Actual  Value             = $!!kFormatText.text.val|)
            !currValdist = !currVal.string(!!distancefmt)
            !error.append(|Actual  Value             = $!currValdist|)
            !!kFormatText.text.val = !min
            --          !error.append(|Minimum Allowed           = $!!kFormatText.text.val|)
            !minvaldist = !min.string(!!distancefmt)
            !error.append(|Minimum Allowed           = $!minvaldist|)
            !error.append(|--------------------------------------------------------------------------------|)
            if (!mode.eq('FORM')) then
              !!mdsCheckLen.ok.active = FALSE
            endif
            !errors = !errors + 1
          elseif (!currVal.real() gt !max) then
            !error.append(|**    Error    ** - Atta exceeds the maximum support centres allowed in the default file|)
            !error.append(|Atta    Name              = $!attaname|)
            !!kFormatText.text.val = !currVal.real()
            --          !error.append(|Actual  Value             = $!!kFormatText.text.val|)
            !currValdist = !currVal.string(!!distancefmt)
            !error.append(|Actual  Value             = $!currValdist|)
            !!kFormatText.text.val = !max
            --          !error.append(|Maximum Allowed           = $!!kFormatText.text.val|)
            !maxvaldist = !max.string(!!distancefmt)
            !error.append(|Maximum Allowed           = $!maxvaldist|)
            ----------------------------------------------------------------
            --< Modified - <wd> - may2000
            ----------------------------------------------------------------
            !error.append(|--------------------------------------------------------------------------------|)
            if (!mode.eq('FORM')) then
              !!mdsCheckLen.ok.active = FALSE
            endif
            !errors = !errors + 1
          endif
        elsehandle ANY
        endhandle
      elsehandle ANY
      endhandle
    enddo

    -- Clean any bad reference from the attaref attribute
    !cleanedList = ARRAY()
    do !clean values !associated
      !!ce = !clean
      handle NONE
        !cleanedList.append(!clean)
      elsehandle ANY
        skip
      endhandle
    enddo

    !!ce = !crossBars[$!check2]
    by n 0
    :MDSAttaRef def
      handle (41,232)
        skip
      endhandle
    !num = (0)

    do !set values !cleanedList
      !num = !num + 1
      !existingAttaRefs = :MDSAttaRef
      !attaString = ''
      do !string values !existingAttaRefs
        !attaString = !attaString +  ' ' + !string.string()
      enddo
      !attaString = !attaString + ' ' + !set.string()
      :MDSAttaRef $!attaString
    enddo

  enddo

label /skippack


-- Check Length of Trunnion against the Project Default Maximum Allowable Length

  !maxtrunnlen  = !!mdsOptions.trunnlen.val
--mjb 31/5/06
    --if (!form.string() inset('MDSVT01','MDSVT02')) then
    if (!form.support.type inset('VT01','VT02')) then
--mjb 31/5/06 end of mod
      do !index indices !form.support.atta

        !!ce       = !form.support.atta[!index]
        !trunnatta = !!ce.name
        if (!form.support.atta[!index].stype.matchwild('TT0*')) then
          !halfpipe = pl od / 2
          !despar1  = despar number 1
          !calclen  = !despar1[1] - !halfpipe
          if (!calclen.int() gt !maxtrunnlen.int()) then
            !error.append(|**    Error    ** - Trunnion exceeds the DEFAULT maximum allowable length|)
            !error.append(|Trunnion Name              = $!trunnatta|)
----------------------------------------------------------------
--> Modified - <wd> - may2000
----------------------------------------------------------------
          !!kFormatText.text.val = !calclen
          --            !error.append(|Actual  Value              = $!!kFormatText.text.val|)
          !calclendist = !calclen.string(!!distancefmt)
          !error.append(|Actual  Value             = $!calclendist|)
          !!kFormatText.text.val = !maxtrunnlen
          --            !error.append(|Maximum Allowed            = $!!kFormatText.text.val|)
          !maxtrunndist = !maxtrunnlen.string(!!distancefmt)
          !error.append(|Maximum Allowed           = $!maxtrunndist|)
          !error.append(|--------------------------------------------------------------------------------|)
          if (!mode.eq('FORM')) then
            !!mdsCheckLen.ok.active = FALSE
            endif
            !errors = !errors + 1
          endif
        endif
      enddo
--mjb 31/5/06
    --elseif (!form.string() inset('MDSTT01','MDSTT02','MDSTT03')) then
    elseif (!form.support.type inset('TT01','TT02','TT03')) then
--mjb 31/5/06 end
      do !index indices !form.support.atta
        !!ce       = !form.support.atta[!index]
        !trunnatta = !!ce.name
        if (!form.support.atta[!index].stype.matchwild('TT0*')) then
          !despar  = despar
          !despar4 = !despar[4]
          if (!despar4.int() gt !maxtrunnlen.int()) then
            !error.append(|**    Error    ** - Trunnion exceeds the DEFAULT maximum allowable length|)
            !error.append(|Trunnion Name              = $!trunnatta|)
          !!kFormatText.text.val = !despar4
          --            !error.append(|Actual  Value              = $!!kFormatText.text.val|)
          !desp4dist = !despar4.string(!!distancefmt)
          !error.append(|Actual  Value             = $!desp4dist|)
          !!kFormatText.text.val = !maxtrunnlen
          --            !error.append(|Maximum Allowed            = $!!kFormatText.text.val|)
          !maxtrunndist = !maxtrunnlen.string(!!distancefmt)
          !error.append(|Maximum Allowed           = $!maxtrunndist|)
          ----------------------------------------------------------------
          --< Modified - <wd> - may2000
          ----------------------------------------------------------------
          !error.append(|--------------------------------------------------------------------------------|)
          if (!mode.eq('FORM')) then
            !!mdsCheckLen.ok.active = FALSE
            endif
            !errors = !errors + 1
          endif
        endif
      enddo

    endif

--------------------------------------------***** connexions *****------------------------------

-- initialise variables

  !oDesc = ARRAY()
  !aDesc = ARRAY()

-- run function to check joints are valid against the spec.

  !jointTest = !!mdsJointInvalid(!form.support.joints,!oDesc,!aDesc)

  !aDesc.compress()
  !oDesc.compress()

  if(!jointTest.unset().not()) then
    !errors = !errors +  !oDesc.size() + !aDesc.size()
    !error.append(|**    Connections Error    ** |)
    !error.appendarray(!oDesc)
    !error.appendarray(!aDesc)
    !error.append(|--------------------------------------------------------------------------------|)
    if (!mode.eq('FORM')) then
      !!mdsCheckLen.ok.active = FALSE
       endif
    endif

--------------------------------------------------------------------------------------------------------------
-- run function to check whether joint is over (or under) connecting sctn..
-- initialise variables
  !jdesc = ARRAY()
  !jointPos = !!mdsCheckJntPos(!form.support.joints, !jdesc)

-- Check if the Connected EXTERNAL joints offset does not EXCEED the Default value of the
  -- ALLOWABLE Joint Offset set in the !!mdsOptions.oFFSET gadget on the MDS default settings form.

    !joints = !jdesc.size()
  !jerror = FALSE
    !indx   = 1

    do !jnum from 1 to !joints
      if (!jnum.eq(1)) then
        !indx = 1
      else
        !indx = !indx + 3
      endif
    if(!jointPos[!indx].not()) then
      !errors = !errors + 1
        if (!jerror.not()) then
        !error.append(|**    Connections Error    ** |)
        !error.append(|Joint(s) not within the allowable offset|)
        !error.append(|with the attached support steel section.|)
        !jerror = TRUE
        endif

        if (!jerror) then
          !cnt2 = !indx + 1
          !cnt3 = !indx + 2

        !error.append(|-- Error --|)
          !jtext = !jdesc[!jnum].after('"').before('"')
        !error.append(|Joint Name                 = $!jtext|)
        !!kFormatText.text.val = !jointPos[!cnt2]
        !actualoffset = !jointPos[!cnt2].string(!!distancefmt)
        !error.append(|Actual Offset              = $!actualoffset|)
        !!kFormatText.text.val = !jointPos[!cnt3]
        !allowoffset = !jointPos[!cnt3].string(!!distancefmt)
        !error.append(|Maximum Allowable Offset   = $!allowoffset|)
      endif
    endif
  enddo

  if (!jerror) then
    !error.append(|--------------------------------------------------------------------------------|)
    if (!mode.eq('FORM')) then
      !!mdsCheckLen.ok.active = FALSE
      endif
    endif

----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

  --xxx  !!mdsCheckLen.summary.val = 'Errors = $!errors,   Warnings = $!warnings,   Messages = $!messages'
--xxx
  --xxx  !error.append('Summary')
  --xxx  !error.append('-------')

  if (!errors + !warnings + !messages eq 0) then
    --!error.append(' ')
    --!error.append('No problems found with this support')
    --!error.append(' ')
  else
-- Output Data for Support Sections with NO Problems, BUT Only if NO Other Errors/Warnings/Messages exist
--<mjb>
    if (!mode.neq('HEALTH')) then
      do !cbar values !bars
        !sctnmess = FALSE
        !!ce = !cbar
--mjb 31/05/06
        --skip if (!form.string() inset('MDSVT01','MDSVT02','MDSVT03','MDSVT04','MDSTT01','MDSTT02','MDSTT03'))
        skip if (!form.support.type inset('VT01','VT02','VT03','VT04','TT01','TT02','TT03'))
--mjb 31/05/06 end
        !memname = !!ce.name

        do !xerr values !error
          if (!xerr.match('Section Name').gt(0) and !xerr.string().match(!memname).gt(0)) then
-- Error for Support Section already exists
            !sctnmess = FALSE
            break
          elseif (!xerr.match('Section Name').gt(0)) then
-- Check if the text 'Section Name' exists in the Error message
            if (!xerr.string().match(!memname).gt(0)) then
-- Check if the name of the Support Section '!memname' exists in the Error message
              skip
            else
-- Set to 'true' to Output Error for the Current Support Section as NO other Error message exists
              !sctnmess = TRUE
            endif
          else
-- Ignore Any Other Error message
            skip
          endif
        enddo

        if (!sctnmess) then
          !error.append(|**   Message   ** - No problems with this Support Section|)
          !error.append(|Section Name               = $!memname|)
          !error.append(||)
          !error.append(|--------------------------------------------------------------------------------|)
          !messages = !messages + 1
        endif

      enddo
    endif
--<mjb> end of mod
  endif

  --<mjb>
  if (!mode.neq('HEALTH')) then

    !!mdsCheckLen.summary.val = 'Errors = $!errors,   Warnings = $!warnings,   Messages = $!messages'

  --endif

    !error.append('Summary')
    !error.append('-------')

    !error.append('Errors      = $!errors')
    !error.append('Warnings    = $!warnings')
    !error.append('Messages    = $!messages')
    !error.append(' ')
    !error.append('End of Report')
    !error.append('-------------')

  endif
  --<mjb> end

  !!mdsResetPins(7,9)

  !!kRestoreUnits(!currentUnits)

  if (!mode.neq('HEALTH')) then

    !!mdsCheckLen.errorList.dtext = !error

-- Set paragraph gadget

    !!mdsCheckLen.name.val = !form.support.stru.namn

-- Only show form if there is anything to show
  else

    !this.integrityerrorarray = !error
    !this.integrityerrors = !errors
    !this.integritywarnings = !warnings
    !this.integritymessages = !messages

  endif

  !totals = !errors + !warnings + !messages

  if (!mode.neq('HEALTH')) then

    if (!totals.gt(0)) then
      waiton !!mdsCheckLen
    else
      !!mdsCheckLen.ok.active = TRUE
      !!mdsCheckLen.accept = TRUE
    endif

  endif

  !!mdsDacControl(FALSE)

endmethod

------------------------------------------------------------------------------------------
-------------------------------------------------------------------------
define method .checkbadref(!reftocheck is STRING, !badrefdbref is DBREF) is BOOLEAN
  !stringforunsetcheck = '!!ce.' & !reftocheck & '.unset().not()'

  if ($!stringforunsetcheck) then
    --not unset, so check for badref/unknown ref

    !stringforbadrefcheck = '!!ce.' & !reftocheck & '.badref()'

    if ($!stringforbadrefcheck) then
      --unknown ref (badref) found so return TRUE
      --return dbref of badref by association
      !stringforbadref = '!!ce.' & !reftocheck
      !badrefdbref = $!stringforbadref
      return TRUE
    else
      return FALSE
    endif
  else
  return FALSE
  endif
endmethod
