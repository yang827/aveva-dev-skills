--
-- Object to store error and warning messages for a single support
-- for the MDS Health Check Utility
--
-----------------------------------------------------------------------------------------------------------------------------------------------------
-- MDS Health Check Utility Error Object
----------------------------------------------------------------------

define object mdshealthchkerror

  member .name is STRING
  member .type is STRING
  member .errorarray is ARRAY
  member .numerrors is REAL
  member .numwarnings is REAL

endobject
