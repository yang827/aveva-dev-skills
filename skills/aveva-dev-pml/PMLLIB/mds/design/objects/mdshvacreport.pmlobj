define method .updaterecord(!table is STRING,!support is STRING,!column is STRING,!value is STRING)

--table is supports
--key is support number
--field is section

    external send $!!CRPIMS start
      |insert into $!table ("support number")|
      |values ('$!support')|
    end


endmethod
