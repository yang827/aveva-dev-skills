define method .gettype() is BOOLEAN

   --!type =!this.support.:MDSProjSpec.description.split(' ')[1]
   !type =!this.support.:MDSProjSpec.description
   handle ANY
    !type =!this.support.:MDSsupptype
   endhandle
   !this.type = !type
   --!this.type = !this.support.:mdssupptype
   return TRUE
endmethod
