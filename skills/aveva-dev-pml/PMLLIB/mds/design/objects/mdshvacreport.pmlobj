-- Define Object
define object mdshvacreport

member .support is dbref
member .datum is dbref
member .supportnumber is STRING
member .type is STRING
member .DuctName is ARRAY
member .roomnumber is STRING
-- here
member .mtoarea is STRING
member .width is STRING
member .height is STRING
member .W1 is STRING
member .W2 is STRING
member .W3 is STRING
member .W4 is STRING
member .W5 is STRING
member .H1 is STRING
member .H2 is STRING
member .H3 is STRING
member .H4 is STRING
member .H5 is STRING
member .h  is STRING
member .subreps is ARRAY
member .outputline is STRING
member .outputdata is ARRAY
member .headingline is STRING
member .headingdata is ARRAY
member .AdjoiningSupps is ARRAY
member .NextSupport is dbref
member .kks is ARRAY
member .insualtionthk is ARRAY
member .AnchorageName is ARRAY
member .AnchorageType is ARRAY
member .C1 is STRING
member .C2 is STRING
member .S1 is STRING
member .S2 is STRING
member .S3 is STRING
member .S4 is STRING
member .sectionsize is STRING
member .dampers is ARRAY
endobject

-- main constructor method for reporting on a tray structure
--------------------------------------------------------------------------------
define method .mdshvacreport(!support is dbref)


  if !support.type.neq('STRU') then
   !!alert.error('Cannot get to a support from this level')
   return
  else
    !this.support = !support
    !datum = !support.name & '/DATUM'
    !this.datum = !datum.dbref()
  endif

  -- set the support name
  !this.getname()

  -- set the type of support
  if !this.gettype().not() then
    !this.outputline = !this.supportnumber & ' is incorrectly defined'
    return
  endif

  -- get the room number
  !this.getroomnumber()

  -- Get SCTN data
  !this.getsctndata()

  -- Get connection data
  !this.getanchordata()

  -- Get data specific to duct
  !this.getHVACData()



    -- Checks its a multiple support and needs to be split
    -- collect all of the ATTAs of the name supportnumber.1 etc

  do !a from 1
    !nextname = '/' & !this.supportnumber & !a.string()
    !test = !nextname.dbref()
    handle ANY
      break
    elsehandle NONE
       !this.subreps.append( object mdshvacreport(!test,!this.type))
    endhandle
  enddo

  !!ce= !this.datum
  -- get prev main bran support
  !this.GetadjoiningSupps('PREV' , FALSE)
  --$p PREV MAIN DONE

  !!ce = !this.datum
  -- get pnext main bran support
  !this.GetAdjoiningSupps('NEX' , FALSE)
  --$p NEXT MAIN DONE

  !!ce= !this.datum
  PREV
  handle ANY
  endhandle
  -- get prev offline bran support
  !this.GetadjoiningSupps('PREV' , TRUE)
  --$p PREV OFFLINE DONE


  !!ce= !this.datum
  NEX
  handle ANY
  endhandle
  -- get nex  offline bran support
  !this.GetadjoiningSupps('NEX' , TRUE)
  --$p NEXT OFFLINE DONE

  !this.W1 = !this.width
  !this.H1 = !this.Height
  if !this.AdjoiningSupps.size().gt(0) then
    -- we need to calculate W2 3 4 5 H2 3 4 5 from the sizes of duct gathered
    !this.sortdata()
  else
    !this.W2 = |-|
    !this.H2 = |-|
    !this.W3 = |-|
    !this.H3 = |-|
    !this.W4 = |-|
    !this.H4 = |-|
    !this.W5 = |-|
    !this.H5 = |-|

  endif


  !this.getkksnumber()

  -- compile and output the report
  !this.outputdata()
  !this.outputheader()

endmethod
--------------------------------------------------------------------------------

-- constructor method for building individual objects
--------------------------------------------------------------------------------
define method .mdshvacreport(!support is dbref,!type is STRING )

  if !type.eq('ATTA') then
    !this.datum = !support

  else
    !this.support = !support
    !datum = !support.name & '/DATUM'
    !this.datum = !datum.dbref()
  endif


  -- Get data specific to duct
  !this.getHVACData()


  !this.W1 = !this.width
  !this.H1 = !this.Height
  !this.W2 = |-|
  !this.H2 = |-|
  !this.W3 = |-|
  !this.H3 = |-|
  !this.W4 = |-|
  !this.H4 = |-|
  !this.W5 = |-|
  !this.H5 = |-|


endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to output the line data
define method .outputdata()

   -- <RM> 11 Dec 06 -- we need to separate out types for the type 12 case that is handled differently
   !type = !this.Type.substring(4,2)
   handle ANY
     !type12 = FALSE
   elsehandle NONE
     if !type.eq('12') then
       if !this.Type.substring(1,1).upcase().eq('A') then
         !type12 = TRUE
       else
         !type12 = FALSE
       endif
     else
       !type12 = FALSE
     endif
   endhandle

   !outputline = !this.supportnumber
   !outputline =  !outputline & ';' & !this.roomnumber
   !outputline =  !outputline & ';' & !this.mtoarea
   !outputline =  !outputline & ';' & !this.Type

   -- added the following to output specific data for Specials
   if !this.type.upcase().eq('SPECIAL') then
     !outputline =  !outputline & ';' & '-'
     !outputline =  !outputline & ';' & '-'
     !outputline =  !outputline & ';' & '-'
     !outputline =  !outputline & ';' & '-'
     !outputline =  !outputline & ';' & '-'
     !outputline =  !outputline & ';' & '-'
   else
     !outputline =  !outputline & ';' & !this.DuctName[1]
     !outputline =  !outputline & ';' & !this.w1
     !outputline =  !outputline & ';' & !this.h1
     !outputline =  !outputline & ';' & !this.h
     !outputline =  !outputline & ';' & !this.insualtionthk[1]
     !outputline =  !outputline & ';' & !this.kks[1]
   endif
   --!outputline =  !outputline & ';' & !this.w2
   --!outputline =  !outputline & ';' & !this.h2
   --!outputline =  !outputline & ';' & !this.w3
   --!outputline =  !outputline & ';' & !this.h3
   --!outputline =  !outputline & ';' & !this.w5
   --!outputline =  !outputline & ';' & !this.h5
   if !this.AnchorageType.size().gt(0) then
     !outputline =  !outputline & ';' & !this.AnchorageName[1]
     !outputline =  !outputline & ';' & !this.AnchorageType[1]
   else
     !outputline =  !outputline & ';' & '-'
     !outputline =  !outputline & ';' & '-'
   endif
   --this is the last line any more data needs to go before the next statement
   !outputline = !outputline & ';'

   --!outputline =  !outputline & ';' & !this.c1
   --!outputline =  !outputline & ';' & !this.c2
   --!outputline =  !outputline & ';' & !this.s1
   --!outputline =  !outputline & ';' & !this.s2
   --!outputline =  !outputline & ';' & !this.s3
   --!outputline =  !outputline & ';' & !this.s4

   !this.outputline = !outputline
   !this.outputdata.append(!outputline)

   -- WRITE OUT THE LINE 2 DATA, this is required for when we have two ducts on a single support
   -- where there is one duct then we copy most data from the first line

   !outputline2 = !this.supportnumber
   !outputline2 =  !outputline2 & ';' & !this.roomnumber
   !outputline2 =  !outputline2 & ';' & !this.mtoarea
   !outputline2 =  !outputline2 & ';' & !this.Type
   if !this.type.upcase().neq('SPECIAL') and !type12.eq(FALSE) then
     if !this.DuctName[2].eq('9999') then
       !outputline2 =  !outputline2 & ';' & !this.DuctName[1]
     else
       !outputline2 =  !outputline2 & ';' & !this.DuctName[2]
     endif
     !outputline2 =  !outputline2 & ';' & !this.w1
     !outputline2 =  !outputline2 & ';' & !this.h1
     !outputline2 =  !outputline2 & ';' & !this.h
     --!outputline2 =  !outputline2 & ';' & !this.w4
     --!outputline2 =  !outputline2 & ';' & !this.h4
     --!outputline2 =  !outputline2 & ';' & !this.w5
     --!outputline2 =  !outputline2 & ';' & !this.h5
     !outputline2 =  !outputline2 & ';' & !this.insualtionthk[2]
     !outputline2 =  !outputline2 & ';' & !this.kks[2]
     if !this.AnchorageType.size().gt(1) then
       !outputline2 =  !outputline2 & ';' & !this.AnchorageName[2]
       !outputline2 =  !outputline2 & ';' & !this.AnchorageType[2]
     else
       !outputline2 =  !outputline2 & ';' & '-'
       !outputline2 =  !outputline2 & ';' & '-'
     endif
   elseif !this.type.upcase().eq('SPECIAL') THEN
     !outputline2 =  !outputline2 & ';' & '-'
     !outputline2 =  !outputline2 & ';' & '-'
     !outputline2 =  !outputline2 & ';' & '-'
     !outputline2 =  !outputline2 & ';' & '-'
     !outputline2 =  !outputline2 & ';' & '-'
     !outputline2 =  !outputline2 & ';' & '-'
     if !this.AnchorageType.size().gt(1) then
       !outputline2 =  !outputline2 & ';' & !this.AnchorageName[2]
       !outputline2 =  !outputline2 & ';' & !this.AnchorageType[2]
     else
       !outputline2 =  !outputline2 & ';' & '-'
       !outputline2 =  !outputline2 & ';' & '-'
     endif
   else
     -- TYPE <Ayz12>
     if !this.DuctName[2].eq('9999') then
       !outputline2 =  !outputline2 & ';' & !this.DuctName[1]
     else
       !outputline2 =  !outputline2 & ';' & !this.DuctName[2]
     endif
     !outputline2 =  !outputline2 & ';' & !this.w1
     !outputline2 =  !outputline2 & ';' & !this.h1
     !outputline2 =  !outputline2 & ';' & !this.h
     !outputline2 =  !outputline2 & ';' & '-'
     !outputline =  !outputline & ';' & !this.kks[2]
     if !this.AnchorageType.size().gt(1) then
       !outputline2 =  !outputline2 & ';' & !this.AnchorageName[2]
       !outputline2 =  !outputline2 & ';' & !this.AnchorageType[2]
     else
       !outputline2 =  !outputline2 & ';' & '-'
       !outputline2 =  !outputline2 & ';' & '-'
     endif
   endif
   --!outputline2 =  !outputline2 & ';' & !this.c1
   --!outputline2 =  !outputline2 & ';' & !this.c2
   --!outputline2 =  !outputline2 & ';' & !this.s1
   --!outputline2 =  !outputline2 & ';' & !this.s2
   --!outputline2 =  !outputline2 & ';' & !this.s3
   --!outputline2 =  !outputline2 & ';' & !this.s4
   --!outputline2 =  !outputline2 & ';'
   --this is the last line any more data needs to go before the next statement
   !outputline = !outputline & ';'
   -- <RM> 11 December 06 -- end of fix
   !this.outputdata.append(!outputline2)


   label /print
   !!ce = !this.support


endmethod
