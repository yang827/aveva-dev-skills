--------------------------------------------------------------------------------
define method .sortdata()
  -- get the widths & heights of the associated ducts and set W1 to W5 & H1 th H5 if applicable
  !Largestsize = 0
  !Smallestsize = 999999
  !this.W2 = |-|
  !this.H2 = |-|
  !this.W3 = |-|
  !this.H3 = |-|
  !this.W4 = |-|
  !this.H4 = |-|
  !this.W5 = |-|
  !this.H5 = |-|

  !count = (0)
  !OriginalSize = !this.width.real() * !this.height.real()
  handle ANY
    $P 'Error with support $!this.supportnumber'
  endhandle
  do !I values !this.AdjoiningSupps
    !count = !count + 1
    !size = !I.width.real() * !I.height.real()

--    q var !size
    if !size.gt(!OriginalSize) and !size.gt(!LargestSize) then
      !LargestSize = !size
      !this.w2 = !I.width
      !this.H2 = !I.height

    elseif !size.lt(!OriginalSize) then
      if  !size.lt(!Smallestsize) then
        if !count.eq(4) then
          -- set W5 & H5
          !this.W5 = !I.width
          !this.H5 = !I.height
        else
          !Smallestsize = !size
          if !this.w3.neq(|-|) then
            !this.w4 = !I.width
            !this.H4 = !I.height
          else
            !this.w3 = !I.width
            !this.H3 = !I.height
          endif
        endif
      else
        !this.w4 = !this.w3
        !this.H4 = !this.H3
        !this.w3 = !I.width
        !this.H3 = !I.height
      endif

    endif
  enddo

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .GetAdjoiningSupps(!Passedmode is STRING, !offline is BOOLEAN )
  -- get the nex and prev supports
  -- remember the nex may be along a tee on a different branch
  !ceori = !!ce

  if !!ce.type.neq('NOZZ') then


    -- get prev or nex
    do !i to 10
      if !!ce.type.eq('NOZZ') then
        break
      endif
      if !offline and !i.eq(1) then
        !mode = | |
      else
        !mode = !PassedMode
      endif


      $!mode
      handle (2,113)
        -- end of bran
        bran
        if !mode.eq('PREV') then
          goto href
          handle ANY
             break
          elsehandle NONE
            if !!ce.type.eq('BRAN') then
              last mem
            endif
          endhandle
        else
          goto tref
          handle ANY
             break
          elsehandle NONE
            if !!ce.type.eq('BRAN') then
              1
            endif
          endhandle
        endif
      endhandle
   --   $R54
--      q var !!ce.name
      if !!ce.type.eq('DAMP') or !!ce.type.eq('IDAM') then
        if !this.dampers.findfirst(!!ce).unset() then
          !this.dampers.append(!!ce)
        endif
      endif

      if  !!ce.type.eq('ATTA') and !!ce.stype.eq('HVAC-REST') then
      -- found next support
        !found = FALSE
        !prevsupport = object mdshvacreport(!!ce,'ATTA')
        if !offline then
          -- test to see if we have already found the support
          do !II values !this.AdjoiningSupps
            if !II.datum.eq(!!ce) then
               !found = TRUE
          if !mode.eq('NEX') then
            !this.NextSupport = !prevsupport.datum
          endif
               break
            endif
          enddo
        endif

        if !found.not() then
         -- if !mode.eq('NEX') then
          --  !this.NextSupport = !prevsupport
          --endif
          !this.AdjoiningSupps.append(!prevsupport)
        endif
        !!ce = !ceori
        break
      elseif ((!!ce.type.eq('THRE') or !!ce.type.eq('BRCO'))  and !offline ) then
        !ThreRef = !!ce
        !type = !!ce.type
        --q var !type
        goto cref
        handle ANY
        elsehandle NONE
          if !!ce.href.eq(!threRef) then
            1
            !Newmode = |NEX|
          else
            last mem
            !Newmode = |PREV|
          endif
          !this.GetAdjoiningSupps(!NewMode, TRUE )
          !!ce = !ThreRef
        endhandle
      endif

    enddo


    if !offline then
      !!ce = !ceori
    endif
  endif
 -- $R
endmethod





define method .getkksnumber()

  -- defaut values of kks ( name of any dampers )
  !kks = ARRAY()
  !kks[1] = '-'
  !kks[2] = '-'

  pin 1 at $!this.datum
  !nextsupport = !this.nextsupport
  pin 2 at $!nextsupport
  handle ANY
    -- No next support handle for one support only
    -- <RM> 11 Dec 06 -- added the following to correctly get the kks numbers at each support
    !count = 1
    do !I values !this.dampers
      pin 9 at $!I
      var !distdamp const dist pin 1 to pin 9
      if !count.eq(1) then
        !mindist = !distdamp
        if !I.name.substring(1,1).eq('/') then
          !kks[!count] = !i.namn
        endif
      elseif !distdamp.lt(!mindist) then
        !mindist = !distdamp
        if !I.name.substring(1,1).eq('/') then
          !kks[!count] = !i.namn
        endif
      endif
      !count = !count + 1
    enddo
    -- <RM> 11 Dec 06 -- end of fix
  elsehandle NONE
    var !dist const dist pin 1 to pin 2
    !count = 1
    do !I values !this.dampers
      pin 9 at $!I
      var !distdamp const dist pin 1 to pin 9
      if !distdamp.lt(!dist) then
        if !I.name.substring(1,1).eq('/') then
          !kks[!count] = !i.namn
        endif
      endif
      !count = !count + 1
    enddo
  endhandle

  do !I values !kks
    !this.kks.append(!i)
  enddo


  !!mdsresetpins(1,7)
endmethod
