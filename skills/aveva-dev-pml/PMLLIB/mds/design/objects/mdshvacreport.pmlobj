--------------------------------------------------------------------------------
define method .getroomnumber()

  --if !this.support.type.neq('SCTN') then
    !!ce = !this.support
    !Suppname = !this.support.name

   !Roomnumber = :FRA.ROOM_KKS of $!SuppName
      handle ANY
        !Roomnumber = :MDSSuppFunc of $!SuppName
        handle ANY
            !Roomnumber = :FRA.ROOM_KKS of $!SuppName/DATUM
              handle ANY
                !Roomnumber = :MDSSuppFunc of $!SuppName/DATUM
              elsehandle NONE
            endhandle
        endhandle
      endhandle

   -- set the mtoarea
   !mtoarea = :MtoArea of $!SuppName
      handle ANY
        !mtoarea = :MtoArea of $!SuppName/DATUM
        handle ANY
          !mtoarea = 'unset'
        endhandle
      endhandle

    --frmw 1
   --- var !roomnumber :FRA.ROOM_KKS
    --  handle ANY
    --    !roomnumber = '0000'
    --  endhandle
    !this.roomnumber = !roomnumber
    !this.mtoarea = !mtoarea
  --else
  --  !!ce = !this.support
  --  frmw
  --  var !roomnumber :FRA.ROOM_KKS
  --  !this.roomnumber = !roomnumber
  --endif

  if !this.roomnumber.match('/').eq(1) then
    !this.roomnumber = !this.roomnumber.after('/')
  else
    !this.roomnumber = 'unset'
  endif
  if !this.roomnumber eq |unset| then
    !this.roomnumber = ||
  endif

  -- <RM> 11 Dec 06 -- add the mtodata
  if !this.mtoarea.match('/').eq(1) then
    !this.mtoarea = !this.roomnumber.after('/')
  endif
  if !this.mtoarea eq |unset| then
    !this.mtoarea = ||
  endif
  -- <RM> 11 Dec 06 -- end of fix
endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .gethvacdata()

  -- Set name of duct
  !this.DuctName[1] = !this.datum.owner.owner.namn

  -- <RM> 11 Dec 06 -- account for hangers supporting two ducts

  !TEMPDATUM = !this.datum.name.before('/DATUM') + '.1'

  !this.DuctName[2] = !TEMPDATUM.dbref().owner.owner.namn
  handle ANY
    !this.DuctName[2] = '9999'
  endhandle

  -- <RM> 11 Dec 06 -- end of fix

  !storece = !!ce
  !!ce = !this.datum

  !support = !this.support
  if !support.unset() then
    !support = !this.datum.name.before('/DATUM').dbref()
    handle ANY
      !ssname = !this.datum.name
      $P Error wit= '7777'
      !this.heigh STRU of support $!ssname
      !this.width ht = '8888'
    endhandle
  endif
  if !support.unset().not() then
    !x = !support.:MDSSPLROT
    handle any
      !test = !support.name
      $P ERROR with Support name $!test
      !this.width = '5555'
      !this.height = '6666'
    elsehandle none
    if !support.:MDSSPLROT.eq(90) or !support.:MDSSPLROT.eq(-90) or !support.:MDSSPLROT.eq(270) then
      !this.width  = !!ce.desp[2].string()
      !this.height = !!ce.desp[1].string()
    else
      !this.width  = !!ce.desp[1].string()
      !this.height = !!ce.desp[2].string()
    endif
  endhandle
    if !!ce.owner.temperature.eq(-100000) or !!ce.owner.temperature.eq(0) then
      !this.insualtionthk[1] = |-|
    else
      !this.insualtionthk[1] = !!ce.owner.temperature.string()
    endif

    -- <RM> 11 Dec 06 -- write out the insulation data for the second line of the report
    $!TEMPDATUM
    handle ANY
      !this.insualtionthk[2] = !this.insualtionthk[1]
    elsehandle NONE
      if !!ce.owner.temperature.eq(-100000) or !!ce.owner.temperature.eq(0) then
        !this.insualtionthk[2] = |-|
      else
        !this.insualtionthk[2] = !!ce.owner.temperature.string()
      endif
    endhandle
    -- <RM> 11 Dec 06 -- end of fix
  endif


  !!ce = !storece
endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .getsctndata()

  !datumstring = !this.support.name & '/DATUM'
  !datum = !datumstring.dbref()

  -- find sctns with :mdsancref set
  var !sctn coll all sctn with not unset( :mdsancref) for $!this.support
  do !I values !sctn
    !this.AnchorageName.append(!I.dbref().:mdsancref[1].namn)
    handle ANY
      !this.AnchorageName.append('BadRef')
    endhandle
    !this.AnchorageType.append(!I.dbref().:mdsancref[1].spref.catref.desc.trim())
    handle ANY
      !this.AnchorageName.append('BadRef')
    endhandle
  enddo
  !ConnType = !this.type.substring(1,2)
  var !type :MDSDType of own of $!datum
  if !ConnType.eq('AC') or !ConnType.eq('BC') or !ConnType.eq('AF') or !ConnType.eq('BF') then
    var !v1 coll all sctn with (match(name,'-V') gt 0)  for $!this.support
    if !type.eq('CIRC') then
      var !v1 append coll all sctn with (match(name,'BAR') gt 0)  for $!this.support
    endif
  elseif !ConnType.eq('AW') or !ConnType.eq('BW') then
    var !v1 coll all sctn with (match(name,'BAR') gt 0)  for $!this.support
    if !type.eq('CIRC') then
      var !v1 append coll all sctn with (match(name,'BAR') gt 0)  for $!this.support
    endif
  elseif !ConnType.match('CW').gt(0) then
    var !v1 coll all sctn with (match(name,'BAR') gt 0)  for $!this.support
    var !v1 append coll all sctn with (match(name,'-V') gt 0)  for $!this.support
  elseif !this.type.match('SPECIAL').gt(0) then
    !v1 = ARRAY()
    var !v1 coll all sctn for $!this.support
  else
    !v1 = ARRAY()
    $P type not matched
    q var !this.type
  endif

  -- <RM> 14 November 06 -- re-wrote this section of code to better account for all cases
  if !v1.size().neq(0) then
    !maxdist = 0
    -- loop through the supporting members to get the maxdist to the support surface
    do !i indices !v1
      if !ConnType.eq('AC') or !ConnType.eq('BC') then
        var !type :MDSDType of own of $!datum
        if !type.neq('CIRC') then
          -- if we have a ceiling connection we may have welded roof cleats that attach to the hanger rod
          -- if this is the case we work out the extra distance to add to the rod to make up the difference
          !extradist = |0|
          var !v2 coll all sctn with (match(name,'BAR') gt 0)  for $!this.support
          if !v2.size().gt(0) then
            do !K indices !v2
              var !mem coll all snod for $!v2[$!k]
              if !mem.size().eq(1) then
                -- we force a pin through the ltoc of each upright and then take the greater value for extradist
                pin 9 at pose of $!v1[$!i]
                pin 9 dir to poss of $!v1[$!i]
                pin 9 through ppli ltoc of $!v2[$!k]
                pin 1 at pose of $!v1[$!i]
                var !edist cons dist pin 1 to pin 9
                if !edist.real().gt(!extradist.real()) then
                  !extradist = !edist
                endif
              endif
            enddo
          endif


          -- take the distance from possend to each ppoint on the atta
          pin 1 at pose of $!v1[$!i]
          pin 2 at poss of $!v1[$!i]
          pin 3 copy p61 of $!datum
          pin 4 copy p62 of $!datum

          pin 1 dir to pin 2

          -- create point vectors for the planes so we can plane intersects with pin 1 vector direction
          var !dirpv1 dir pin 1 wrt /*
          var !pospv1 pos pin 1 wrt /*
          var !dirpv61 dir pin 3 wrt /*
          var !pospv61 pos pin 3 wrt /*
          var !dirpv62 dir pin 4 wrt /*
          var !pospv62 pos pin 4 wrt /*

          !pv1 = object pointvector(!pospv1.position(),!dirpv1.direction())
          !pv61 = object pointvector(!pospv61.position(), !dirpv61.direction())
          !pv62 = object pointvector(!pospv62.position(), !dirpv62.direction())

          --intersect at the point between the pv61 and pv62 planes
          !intersectionplane61 = !pv61.plane().intersection(!pv1)
          !intersectionplane62 = !pv62.plane().intersection(!pv1)

          -- get the distance between pin 1 and each intersection then choose the greater
          var !distpv1tointerp61 cons dist $!pospv1 to $!intersectionplane61
          var !distpv1tointerp62 cons dist $!pospv1 to $!intersectionplane62

          if !distpv1tointerp61.real().gt(!distpv1tointerp62.real()) then
            if !distpv1tointerp61.real().gt(!maxdist) then
              !maxdist = !distpv1tointerp61.real() + !extradist.real()
            endif
          else
            if !distpv1tointerp62.real().gt(!maxdist) then
              !maxdist = !distpv1tointerp62.real() + !extradist.real()
            endif
          endif
        else
          -- we have circular ducting which is a different hanger construction to the rectangular ducting
          -- the distance if from the posend of the section to the ppoint on the atta which is opposite in direction
          -- to the direction possend to posstart
          if !v1[$!i].dbref().name.match('BAR').gt(0) then
            pin 1 at poss of $!v1[$!i]
            pin 2 at pose of $!v1[$!i]
            var !pin2dir construct direction pin 1 to pin 2
            var !pospin2 pos pin 1 wrt /*
            do !j from 1 to 4 by 1
              var !dir dir p6$!j of $!datum
              if !dir.direction().dot(!pin2dir.direction()).gt(0.99) then
                var !dist const dist pin 2 to p6$!j of $!datum
                break
              else
                !dist = '0'
              endif
            enddo
            if !dist.real().gt(!maxdist) then
              !maxdist = !dist.real()
            endif
          endif
        endif

      elseif !ConnType.eq('AF') or !ConnType.eq('BF') then
        if !type.neq('CIRC') then
          -- take the distance from possend to each ppoint on the atta
          pin 1 at poss of $!v1[$!i]
          pin 2 at pose of $!v1[$!i]
          pin 3 copy p61 of $!datum
          pin 4 copy p62 of $!datum

          pin 1 dir to pin 2

          -- create point vectors for the planes so we can plane intersects with pin 1 vector direction
          var !dirpv1 dir pin 1 wrt /*
          var !pospv1 pos pin 1 wrt /*
          var !dirpv61 dir pin 3 wrt /*
          var !pospv61 pos pin 3 wrt /*
          var !dirpv62 dir pin 4 wrt /*
          var !pospv62 pos pin 4 wrt /*

          !pv1 =  object pointvector(!pospv1.position(), !dirpv1.direction())
          !pv61 = object pointvector(!pospv61.position(), !dirpv61.direction())
          !pv62 = object pointvector(!pospv62.position(), !dirpv62.direction())

          --intersect at the point between the pv61 and pv62 planes
          !intersectionplane61 = !pv61.plane().intersection(!pv1)
          !intersectionplane62 = !pv62.plane().intersection(!pv1)

          var !distpv1tointerp61 cons dist $!pospv1 to $!intersectionplane61
          var !distpv1tointerp62 cons dist $!pospv1 to $!intersectionplane62

          -- get the distance between pin 1 and each intersection then choose the greater
          if !distpv1tointerp61.real().gt(!distpv1tointerp62.real()) then
            if !distpv1tointerp61.real().gt(!maxdist) then
              !maxdist = !distpv1tointerp61.real()
            endif
          else
            if !distpv1tointerp62.real().gt(!maxdist) then
              !maxdist = !distpv1tointerp62.real()
            endif
          endif
        else
          -- we have circular ducting which is a different hanger construction to the rectangular ducting
          -- the distance if from the posend of the section to the ppoint on the atta which is opposite in direction
          -- to the direction possend to posstart
          if !v1[$!i].dbref().name.match('BAR').gt(0) then
            pin 1 at poss of $!v1[$!i]
            pin 2 at pose of $!v1[$!i]
            var !pin2dir construct direction pin 1 to pin 2
            var !pospin2 pos pin 1 wrt /*
            do !j from 1 to 4 by 1
              var !dir dir p6$!j of $!datum
              if !dir.direction().dot(!pin2dir.direction()).gt(0.99) then
                var !dist const dist pin 2 to p6$!j of $!datum
                break
              else
                !dist = '0'
              endif
            enddo
            if !dist.real().gt(!maxdist) then
              !maxdist = !dist.real()
            endif
          endif
        endif
      elseif !ConnType.eq('AW') or !ConnType.eq('BW') then
        if !type.neq('CIRC') then
          -- take the distance from possend to each ppoint on the atta
          pin 1 at pose of $!v1[$!i]
          pin 2 at poss of $!v1[$!i]
          pin 3 copy p63 of $!datum
          pin 4 copy p64 of $!datum

          pin 1 dir to pin 2

          -- create point vectors for the planes so we can plane intersects with pin 1 vector direction
          var !dirpv1 dir pin 1 wrt /*
          var !pospv1 pos pin 1 wrt /*
          var !dirpv63 dir pin 3 wrt /*
          var !pospv63 pos pin 3 wrt /*
          var !dirpv64 dir pin 4 wrt /*
          var !pospv64 pos pin 4 wrt /*

          !pv1 = object pointvector(!pospv1.position(), !dirpv1.direction())
          !pv63 = object pointvector(!pospv63.position(), !dirpv63.direction())
          !pv64 = object pointvector(!pospv64.position(), !dirpv64.direction())

          --intersect at the point between the pv63 and pv64 planes
          !intersectionplane63 = !pv63.plane().intersection(!pv1)
          !intersectionplane64 = !pv64.plane().intersection(!pv1)

          var !distpv1tointerp63 cons dist $!pospv1 to $!intersectionplane63
          var !distpv1tointerp64 cons dist $!pospv1 to $!intersectionplane64

           -- get the distance between pin 1 and each intersection then choose the greater
          if !distpv1tointerp63.real().gt(!distpv1tointerp64.real()) then
            if !distpv1tointerp63.real().gt(!maxdist) then
              !maxdist = !distpv1tointerp63.real()
            endif
          else
            if !distpv1tointerp64.real().gt(!maxdist) then
              !maxdist = !distpv1tointerp64.real()
            endif
          endif
        else
          -- we have circular ducting which is a different hanger construction to the rectangular ducting
          -- the distance if from the posend of the section to the ppoint on the atta which is opposite in direction
          -- to the direction possend to posstart
          if !v1[$!i].dbref().name.match('BAR').gt(0) then
            pin 1 at poss of $!v1[$!i]
            pin 2 at pose of $!v1[$!i]
            var !pin2dir construct direction pin 1 to pin 2
            var !pospin2 pos pin 1 wrt /*
            do !j from 1 to 4 by 1
              var !dir dir p6$!j of $!datum
              if !dir.direction().dot(!pin2dir.direction()).gt(0.99) then
                var !dist const dist pin 2 to p6$!j of $!datum
                break
              else
                !dist = '0'
              endif
            enddo
            if !dist.real().gt(!maxdist) then
              !maxdist = !dist.real()
            endif
          endif
        endif
      elseif !ConnType.match('CW').gt(0) then
        var !type :MDSDType of own of $!datum
        if !type.neq('CIRC') then
          -- we have rectangular ducting, the distance if from the posend of the section to the ppoint
          -- on the atta which is in the same direction to the direction possend to posstart
          if !v1[$!i].dbref().name.match('BAR-1').gt(0) or !v1[$!i].dbref().name.match('BAR-2').gt(0) then
            -- do nothing
          else
            -- the distance if from the posend to the
            pin 1 at poss of $!v1[$!i]
            pin 2 at pose of $!v1[$!i]
            var !pin2dir construct direction pin 2 to pin 1
            var !pospin2 pos pin 2 wrt /*
            --!pv1 = object pointvector(!pospin2.position(), !pin1dir.direction())
            do !j from 1 to 4 by 1
              var !dir dir p6$!j of $!datum

              if !dir.direction().dot(!pin2dir.direction()).gt(0.99) then
                var !pos pos p6$!j of $!datum wrt /*
                !pv = object pointvector(!pos.position(), !dir.direction())
                !pv1 = object pointvector(!pospin2.position(), !dir.direction())
                !intersectionplane = !pv.plane().intersection(!pv1)
                var !dist const dist pin 2 to $!intersectionplane
                break
              else
                !dist = '0'
              endif
            enddo
            if !dist.real().gt(!maxdist) then
              !maxdist = !dist.real()
            endif
          endif
        else
          -- we have circular ducting which is a different hanger construction to the rectangular ducting
          -- the distance if from the posend of the section to the ppoint on the atta which is opposite in direction
          -- to the direction possend to posstart
          if !v1[$!i].dbref().name.match('BAR').gt(0) then
            pin 1 at poss of $!v1[$!i]
            pin 2 at pose of $!v1[$!i]
            var !pin2dir construct direction pin 2 to pin 1
            var !pospin2 pos pin 2 wrt /*
            do !j from 1 to 4 by 1
              var !dir dir p6$!j of $!datum
              if !dir.direction().dot(!pin2dir.direction()).gt(0.99) then
                var !dist const dist pin 1 to p6$!j of $!datum
                break
              else
                !dist = '0'
              endif
            enddo
            if !dist.real().gt(!maxdist) then
              !maxdist = !dist.real()
            endif
          endif
        endif

      elseif !this.type.match('SPECIAL').gt(0) then
        -- insert code
      else

      endif

    enddo

    !this.h = !maxdist.nint().string()

  else

    !this.h = |0|

  endif
-- re-wrote the calc code above in lieu of some errors in the report
$(
  -- dist from below duct to supported element ie under steel or civils
  -- or from wall
  if !v1.size().neq(0) then
    !tempdir = !v1[1].dbref().zdir.wrt( /* )

    !maxdist = (0)
    do !i indices !v1
      -- get the description of the stru, if it equals BFF then we need to flip POSS and POSE because
      -- this is a floor mounted support and the template steel orientation works for a roof mount.
      var !desc description of /$!this.supportnumber
      !BFFTRUE = !desc.match('BFF').gt(0)

      --if !bfftrue then
      --  !tempdir = !v1[!I].dbref().zdir.opposite().wrt( /* )
      --else
        !tempdir = !v1[!I].dbref().zdir.wrt( /* )
      --endif
      --if !BFFTRUE then
      --  !poss = !v1[!I].dbref().pose.wrt( /* )
      --  !pose = !v1[!I].dbref().poss.wrt( /* )
      --else
        !poss = !v1[!I].dbref().poss.wrt( /* )
        !pose = !v1[!I].dbref().pose.wrt( /* )
      --endif

      !loopdir = !tempdir.string().before(' WRT')
      --pin 1 at $!this.support
      --pin 1 dir $!dir
      -- pin 2 copy pin 1
      -- pin 2 plane pin 2 behind $!This.Support
      pin 4 at $!poss
      pin 5 at $!pose

      pin 3 copy pin 4
      pin 3 dir $!loopdir

      if !BFFTRUE then
        pin 3 plane pin 3 thr p62 of $!datum
      else
        pin 3 plane pin 3 thr $!this.support
      endif

      var !dists construct dist pin 3 to pin 4
      var !diste construct dist pin 3 to pin 5
      --q var !maxdist
      --q var !v1[!i].dbref().name

      if !diste.real().gt(!dists.real()) then
        if !diste.real().gt(!maxdist) then
          pin 7 at pin 5
          pin 6 copy pin 3
          !endpos = !pose
          !maxdist = !diste.real()
          !dir = !loopdir
          pin 7 dir $!dir
        endif
      else
        if !dists.real().gt(!maxdist) then
          pin 7 at pin 4
          pin 6 copy pin 3
          !endpos = !poss
          !maxdist = !dists.real()
          !dir = !loopdir
          pin 7 dir $!dir
        endif
      endif
    enddo
    if !datum.pdir[61].wrt( /* ).angle(!dir.direction()).gt(-.5) and !datum.pdir[61].wrt( /* ).angle(!dir.direction()).lt(.5) or $
     !datum.pdir[62].wrt( /* ).angle(!dir.direction()).gt(-.5) and !datum.pdir[62].wrt( /* ).angle(!dir.direction()).lt(.5) then
    --if !datum.pdir[61].wrt( /* ).eq(!dir.direction()) or !datum.pdir[62].wrt( /* ).eq(!dir.direction()) then

      if !BFFTRUE then
        !p61pos = !datum.ppos[62].wrt( /* ).string()
        !p62pos = !datum.ppos[61].wrt( /* ).string()
      else
        !p61pos = !datum.ppos[61].wrt( /* ).string()
        !p62pos = !datum.ppos[62].wrt( /* ).string()
      endif
      var !dist61 constr dist $!endpos to $!p61pos
      var !dist62 constr dist $!endpos to $!p62pos
      if !dist61.real().gt(!dist62.real()) then
        pin 6 plane pin 6 thro $!p61pos
      else
        pin 6 plane pin 6 thro $!p62pos
      endif
    elseif !datum.pdir[63].wrt( /* ).angle(!dir.direction()).gt(-.5) and !datum.pdir[63].wrt( /* ).angle(!dir.direction()).lt(.5) or $
     !datum.pdir[64].wrt( /* ).angle(!dir.direction()).gt(-.5) and !datum.pdir[64].wrt( /* ).angle(!dir.direction()).lt(.5) then
    --elseif !datum.pdir[63].wrt( /* ).eq(!dir.direction()) or !datum.pdir[64].wrt( /* ).eq(!dir.direction()) then
      if !BFFTRUE then
        !p63pos = !datum.ppos[64].wrt( /* ).string()
        !p64pos = !datum.ppos[63].wrt( /* ).string()
      else
        !p63pos = !datum.ppos[63].wrt( /* ).string()
        !p64pos = !datum.ppos[64].wrt( /* ).string()
      endif
      var !dist63 constr dist $!endpos to $!p63pos
      var !dist64 constr dist $!endpos to $!p64pos
      if !dist63.real().gt(!dist64.real()) then
        pin 6 plane pin 6 thro $!p63pos
      else
        pin 6 plane pin 6 thro $!p64pos
      endif
    else
      $p Datum direction
      q var !datum.pdir[61].wrt( /* )
      $p sctn direction
      q var !dir.direction().wrt( /* )
      !ssname = !datum.name
      $P Error with Support $!ssname
      $P direction unknown
    endif
    var !dist const dist pin 7 to pin 6
    !this.h = !dist.real().nint().string()
  else
    !this.h = |0|
  endif
$)
-- <RM> 14 November 06 -- end of fix
endmethod
