--   Type:  Object Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  DESIGN
--
--------------------------------------------------------------------------------
-- Description:
--
-- PML Object to determine the MDS Design Data etc... for the MDS DESIGN APPLICATION "ICONS" etc..
-- from the MDS12 DEFAULTS PARAGON CATALOGUE Database CONVERTED from the latest MDS11.6*
-- version of the MDS DEFAULTS FILE "%MDSDFLTS%/DES-SUPP-ICONS" from the MASTER PDMS
-- Project "MDS"
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsicondefs()                    -
--
define object MDSICONDEFS

  -- Overall ICONS CATALOGUE Check for ALL MDS DESIGN APPLICATION ICONS
  member .iconscheck is BOOLEAN

  -- MDS DESIGN APPLICATION ARRAY of ICON Objects
  member .iconsarray is ARRAY

  -- End object
endobject
--
--------------------------------------------------------------------------------
-- Constructor Method .mdsicondefs()
-- Arguments:
--
-- Return:
--
--------------------------------------------------------------------------------
-- Constructor Method
--
define method .mdsicondefs()

  -- Determine the PDMS Project MDS DESIGN APPLICATION ICON NAMES and VALUES
  !iconcata = /MDS/ICON/DEFAULTS
  handle NONE
    -- Initialise Variables
    !iconcheck  = FALSE

    -- Initialise the Collection Object data
    !type  = |DTSE|
    !filt  = object EXPRESSION('FUNC eq |ICON| and GTYP eq |ICON|')
    !scope = ARRAY()
    !scope.append(!iconcata)

    -- Collect ALL of the ICON DTSE Elements
    !data  = object COLLECTION()
    !data.filter(!filt)
    !data.scope(!scope)
    !data.type(!type)

    -- Collection Results Array
    !results = !data.results()

    if (!results.size().gt(0)) then
      -- Process the MDS ICON DTSE elements in the !results ARRAY
      -- SET ALL of the MDS Application ICON NAMES and VALUES into "MDSICONOBJ" Objects .
      -- Loop through DTSE Collection Results
      --$R 110
      do !indx indices !results
        !icontest   = BOOLEAN()
        !mdsiconobj = object MDSICONOBJ(!results[!indx], !icontest)
        if (!icontest) then
          -- DATA Elements for the MDS ICON DEFAULTS exist in the DTSE !results[!indx]
          !this.iconsarray.append(!mdsiconobj)
          !iconcheck = TRUE

        else
          -- DATA Elements for the MDS ICON DEFAULTS DO NOT exist in the DTSE !results[!indx]
          skip

        endif

      enddo
      --$R
    else
      -- The MDS DESIGN APPLICATION ICON DEFAULTS CATALOGUE element NOT found
      !iconcheck = FALSE

    endif

  elsehandle ANY
    -- The MDS DESIGN APPLICATION ICON DEFAULTS CATALOGUE element NOT found
    !iconcheck = FALSE

  endhandle

  -- SET the Object Member .iconscheck
  !this.iconscheck = !iconcheck

endmethod
--
--------------------------------------------------------------------------------
--
--define method

--endmethod
--
--------------------------------------------------------------------------------
--
--define method

--endmethod
