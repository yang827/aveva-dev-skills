--   Type:  Object Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  DESIGN
--
--------------------------------------------------------------------------------
-- Description:
--
-- PML Object to determine the MDS Design Data etc... for the MDS DESIGN APPLICATION "ICONS" etc..
-- from the MDS12 DEFAULTS PARAGON CATALOGUE Database CONVERTED from the latest MDS11.6*
-- version of the MDS DEFAULTS FILE "%MDSDFLTS%/DES-SUPP-ICONS" from the MASTER PDMS
-- Project "MDS"
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsiconobj(DBREF,BOOLEAN)        -
--
define object MDSICONOBJ

  -- MDS DESIGN APPLICATION ICON NAME Object Member
  member .iconname is STRING

  -- MDS DESIGN APPLICATION ICON VALUE Object Member
  member .iconvalu is STRING

  -- End object
endobject
--
--------------------------------------------------------------------------------
-- Constructor Method .mdsiconobj()
-- Arguments:
--
-- Return:
--
--------------------------------------------------------------------------------
-- Constructor Method
--
define method .mdsiconobj(!dataset is DBREF, !icontest is BOOLEAN )

  -- Determine the PDMS Project MDS DESIGN APPLICATION ICON NAMES and VALUES from the passed
  -- DTSE element in the variable !dataset from the MDS ICON DEFAULT CATALOGUE = /MDS/ICON/DEFAULTS
  !icondtse = !dataset
  handle NONE
    -- Initialise the Collection Object data
    !type  = |DATA|
    !filt  = object EXPRESSION('DKEY eq |INAM| or DKEY eq |IVAL|')
    !scope = ARRAY()
    !scope.append(!icondtse)

    -- Collect ALL of the DESPARS DATA Elements
    !data  = object COLLECTION()
    !data.filter(!filt)
    !data.scope(!scope)
    !data.type(!type)

    -- Collection Results Array
    !results = !data.results()
    if (!results.size().gt(0)) then
      -- Process the MDS ICON DATA elements in the !results ARRAY
      -- SET the OBJECT MEMBERS .iconname anme iconvalue
      -- Loop through DTSE Collection Results
      do !indx indices !results
        if (!results[!indx].dkey.eq('INAM')) then
          if (!results[!indx].pprop.set()) then
            !this.iconname = $!results[$!indx].pprop

          else
            -- SKIP if the ICON NAME is UNSET, as there NOTHING we can do!
            skip

          endif

        elseif (!results[!indx].dkey.eq('IVAL')) then
          if (!results[!indx].pprop.set()) then
            !this.iconvalu = $!results[$!indx].pprop

          else
            -- Set to the DEFAULT Setting of "TRUE", i.e. ICON etc...
            -- will be "ACTIVE" in the MDS DESIGN APPLICATION
            !this.iconvalu = 'true'

          endif
        endif

      enddo

      !icontest = TRUE

    else
      -- The MDS DESIGN APPLICATION ICON DEFAULTS CATALOGUE element NOT found
      !icontest = FALSE

    endif

  elsehandle ANY
    -- The MDS DESIGN APPLICATION ICON DEFAULTS CATALOGUE element NOT found
    !icontest = FALSE

  endhandle

endmethod
--
--------------------------------------------------------------------------------
--
--define method

--endmethod
--
--------------------------------------------------------------------------------
--
--define method

--endmethod
