--   Module:  DESIGN
--
--------------------------------------------------------------------------------
-- Description:
--
-- PML Object to determine the MDS Design Data etc... for the available MDS STANDARDS in the
-- current PDMS Project. Derived from the MDS12 DEFAULTS PARAGON CATALOGUE Database
-- CONVERTED from the latest MDS11.6* version of the MDS DEFAULTS FILE "%MDSDFLTS%/DES-SUPP-DEFS"
-- from the MASTER PDMS Project "MDS"
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsloadstddefs(FORM,ARRAY)       -
--
define object MDSLOADSTDDEFS

  ---> <wd>jun2006<mds12>
  ---> All the MDS STANDARD Checks are done in the PML Objects "mdsreadparsdata.pmlobj", "mdsreadtrudata.pmlobj" etc...
  ---> Therefore the OBJECT MEBERS shown below are REDUNDANT and NOT REQUIRED
  --->
  ---> <wd>jun2006<mds12> -- MEMBER Data *** NOT REQUIRED ***
  ---> <wd>jun2006<mds12> -- MEMBER Data *** NOT REQUIRED *** -- Overall MDS Standard Check for the MDS DESIGN Application
  ---> <wd>jun2006<mds12> -- MEMBER Data *** NOT REQUIRED ***   member .loadstdcheck is BOOLEAN
  ---> <wd>jun2006<mds12> -- MEMBER Data *** NOT REQUIRED ***
  ---> <wd>jun2006<mds12> -- MEMBER Data *** NOT REQUIRED *** -- Error text for missing MDS Standard CATALOGUES
  ---> <wd>jun2006<mds12> -- MEMBER Data *** NOT REQUIRED ***   member .loadstderrortext is STRING
  ---> <wd>jun2006<mds12> -- MEMBER Data *** NOT REQUIRED ***
  ---> <wd>jun2006<mds12> -- MEMBER Data *** NOT REQUIRED *** -- Continuation Error type found if ANY
  ---> <wd>jun2006<mds12> -- MEMBER Data *** NOT REQUIRED *** -- <1>--ALLOK   -- <ALLOW Entry to MDS DESIGN Apps>
  ---> <wd>jun2006<mds12> -- MEMBER Data *** NOT REQUIRED *** -- <2>--WARNING -- <ADVISE USER of WARNING and ALLOW Entry to MDS DESIGN Apps>
  ---> <wd>jun2006<mds12> -- MEMBER Data *** NOT REQUIRED *** -- <3>--ERROR   -- <ADVISE USER of ERROR and ABORT Entry to MDS DESIGN Apps>
  ---> <wd>jun2006<mds12> -- MEMBER Data *** NOT REQUIRED ***   member .loadstderrortype is STRING
  ---> <wd>jun2006<mds12> -- MEMBER Data *** NOT REQUIRED ***
  -- End object
endobject
--
-------------------------------------------------------------------------------
-- Constructor Method .mdsloadstddefs(!form is FORM, !mdstypes is ARRAY)
-- Arguments:
--
-- Return:
--
-------------------------------------------------------------------------------
-- Constructor Method
--
define method .mdsloadstddefs(!form is FORM, !mdstypes is ARRAY)

  --<RM 27/07/09> added this test because the code was failing due to !!mdsaddbracing not being defined during the load
  !bracingForm = FALSE
  if (defined(!!mdsaddbracing)) then
    if (!form.eq(!!mdsaddbracing)) then
      !bracingForm = TRUE
    endif
  endif
  --<RM 27/07/09> added this test because the code was failing due to !!mdsaddbracing not being defined during the load - end

  -- ABORT MDS Application and FORM list gadget LOADING if the ARRAY !mdstypes is EMPTY
  if (!mdstypes.empty()) then

    -- ???ABORT MDS Loading??? Need to CHECK this????????? <wd> 04jan2007
    -- ******************************************************************

    return
  endif

  -- Initialise variables
  !dtxt = ARRAY()
  !rtxt = ARRAY()

  -- Loop through the ACTIVE MDS STANDARDS found in the PARAGON MDS DEFAULTS Catalogue passed
  -- in the ARRAY of DBREFS !mdstypes and Populate the !dtxt and !rtxt arrays accordingly
  do !std values !mdstypes
    -- Typical MDS STD SECTION element Names -- /MDS/ATTA/DEFAULTS/AT01, /MDS/STRUCTURE/DEFAULTS/FT09 etc...
    !snam = !std.flnm
    !code = !std.description
    -- Typical "CCOD" DATA element Names -- /MDS/ATTA/DEFAULTS/AT01/GEN/CCOD, /MDS/STRUCTURE/DEFAULTS/FT09/GEN/CCOD etc...
    !cnam = !snam & '/GEN/CCOD'
    !cdat = !cnam.dbref()
    handle ANY
      skip
    elsehandle NONE
      !cstr = attrib pprop of $!<cdat>
      !ccod = $!<cstr>
      -- Typical "DESC" DATA element Name -- /MDS/ATTA/DEFAULTS/AT01/GEN/DESC, /MDS/STRUCTURE/DEFAULTS/FT09/GEN/DESC etc...
      !dnam = !snam & '/GEN/DESC'
      !ddat = !dnam.dbref()
      handle ANY
        skip
      elsehandle NONE
        !dstr = attrib pprop of $!<ddat>
        !desc = $!<dstr>
        -- Populate the !dtxt and !rtxt ARRAYS
        -- Add the text ' - ' in between the !code and the !desc variables for the MAIN FORMS
        --<dw>28feb2008dun858 - ccod pprop display only for type on bracing form>
        if (!bracingForm) then
          !dtxt.append(!ccod)
        else
          --<RM 23/07/09> dun1119 added additional code to handle AC types with A and B suffix
          if (!code inset('AC18A','AC19A')) then
            !code = !code.substring(1, 4)
            if (!ccod inset('XAC18A','XAC19A')) then
              !ccod = !ccod.substring(1, 5)
            endif
          elseif (!code inset('AC18B','AC19B')) then
            skip
          endif
          --<RM 23/07/09> dun1119 added additional code to handle AC types with A and B suffix - end

          !dtxt.append(!ccod & ' - ' & !desc)
        endif
        --<dw>28feb2008dun858 - end ccod pprop display only for type on bracing form>
        !rtxt.append(!code)
      endhandle
    endhandle

  enddo

  -- Test that !dtxt and !rtxt are NOT empty and that they are the SAME SIZE ARRAY
  if (!dtxt.empty()) then
    -- ABORT MDS Loading as NO Ancillaries available- Default ERROR and Message set in loading of the FORM !!mdsALLANCILL
    return
  else
    if (!dtxt.size().neq(!rtxt.size()))then
      -- ABORT MDS Loading as NO Ancillaries available- Set ERROR and Message for the FORM !!mdsALLANCILL
      !form.error = TRUE
      !form.emess = 'Some of the PARAGON DEFAULT ANCILLARY DATA elements e.g. /MDS/ATTA/DEFAULTS/AT01/GEN/CODE, .../CCOD and .../DESC etc..  are INCOMPLETE.'
      return
    else
      -- MDS ANCILLARIES have loaded OK
      !form.error = FALSE
      !form.emess = ''
    endif
  endif

  -- SORT both ARRAYS into ALPHABETICAL and NUMBER order
  !sind = !dtxt.sortedindices()
  !dtxt.reindex(!sind)
  !rtxt.reindex(!sind)

  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------

  --**********************************************************************************************************
  --**********************************************************************************************************
  --**********************************************************************************************************
  ------------------------------------------------------------------------------------------------------------
  --<wd>31oct2006 - The REDUNDANT CODE BELOW has been REPLACED by the NEW CODE shown at the TOP of this METHOD
  ------------------------------------------------------------------------------------------------------------

  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- ABORT MDS Application and FORM list gadget LOADING if the Client Code<CCOD> ARRAY is UNDEFINED or EMPTY etc...
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>  if (undefined(!!mdsdescdefs)) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- ???ABORT MDS Loading??? return added <wd>02aug2006
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>    return
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>  else
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>    if (!!mdsdescdefs.ccodgvararr.empty() or !!mdsdescdefs.ccodgvararr.unset()) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- ???ABORT MDS Loading??? return added <wd>02aug2006
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>      return
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>    endif
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>  endif
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- **********************
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- *** IMPORTANT NOTE ***
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- **********************
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- The Global Variable NAMES<*** NOT the VALUES *** e.g.. the STRINGS '!!codeFT09' and '!!descFT09' etc...>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- EXIST for the MDS Standards ACTIVE in the current PDMS Project. The Global variables for the
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- CLIENT DESCRIPTIONS and CLIENT CODES have ALREADY been DETERMINED, CREATED and  STORED in the Global Variable
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- instance "!!mdsdescdefs" of the PML OBJECT "MDSDESCRIPTIONS" in the OBJECT array members
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- ".descgvararr" and ".ccodgvararr"
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- e.g.
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- <:MDSACTIVE = TRUE for the CATALOGUE SECTION ELEMENTS for the MDS Standards STORED in these ARRAYS>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- i.e. when !!mdsdescdefs.ccodgvararr[index] = "!!codeFT09" and !!mdsdescdefs.descgvararr[index] = "!!descFT09"
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- it means that the MDS STANDARD "FT09" is ACTIVE in the PROJECT and can be loaded into its MAIN TYPE creation
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- form !!mdsFRAME via the command "!!mdsPOPULATE(!!mdsFRAME, 'FRAME') in the init function !!mdsIFRAME().
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>--
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- This method ".mdsloadstddefs(!form is FORM, !prefix is ARRAY)" is used to LOAD ALL of the AVAILABLE MDS
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- STANDARD type MAIN FORMS list gadgets, e.g. !!mdsFRAME.standard, !!mdsTRUNN.standard etc... for the
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- MDS DESIGN Application at MDS12
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>  !ccodarray = !!mdsdescdefs.ccodgvararr
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>  !descarray = !!mdsdescdefs.descgvararr
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>  !dtext     = ARRAY()
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>  !rtext     = ARRAY()
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>  !dtext1    = ARRAY()
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>  !rtext1    = ARRAY()
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>  !dtext2    = ARRAY()
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>  !rtext2    = ARRAY()
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- Loop through MDS Standard PREFIXES in the passed array !prefix
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>  do !pref values !prefix
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- Loop through the Client CODE GLOBAL VARIABLE NAMES which are "ACTIVE" for the current PDMS Project
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>    do !indx indices !ccodarray
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- Initialise the ARRAYS
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>      !cmdsstd = !ccodarray[!indx].upcase().after(|!!cODE|).trim()
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>      !dmdsstd = !descarray[!indx].upcase().after(|!!dESC|).trim()
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- SKIP if the SAME !indx number does NOT represent the SAME MDS Standard
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>      skip if (!cmdsstd.neq(!dmdsstd))
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- Need to ADD the MDS REST stypes i.e. "PIPE-REST", "PIPE-INLINE-REST" or "RACK-REST"
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- where they are required in the FORM. e.g <MDSALLANCILL>, <MDSANCILL> etc...
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- Change the VALUE of !cmdsstd to represent the CORRECT STYPE for the MDS REST ATTAS
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>      if (!cmdsstd.matchwild('*PIPEREST')) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        !cmdsstd = 'PIPE-REST'
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>      elseif (!cmdsstd.matchwild('*PIPERESTINLINE')) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        !cmdsstd = 'PIPE-REST-INLINE'
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>      elseif (!cmdsstd.matchwild('*RACKREST')) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        !cmdsstd = 'RACK-REST'
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>      elseif (!cmdsstd.matchwild('*HVACREST')) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        !cmdsstd = 'HVAC-REST'
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>      endif
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- Load the !pref types in the "!form.standard" list gadget for the passed FORM !form
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>      if (!cmdsstd.match(!pref.upcase().trim()).eq(1)) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- For the "SP03A" to "SP03G" MDS CONSTANT SPRING HANGERS - ONLY LOAD the FORM with the
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- "SP03" DATA and SKIP the REST with suffixes, i.e. "SP03A" to "SP03G"
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        if (!pref.eq('SP') and (!form.eq(!!mdsspring))) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>          if (!cmdsstd.neq('SP03')) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>            skip
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>          endif
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        endif
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>$(
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- Certain guide are actually framework and not ancillaries so remove them from
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- the list
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        if (!pref.eq('GT') then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>         if (!form.eq(!!mdsallancill)) or !form.eq(!!mdsancill))) or !form.eq(!!mdsguide))then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>          if (!cmdsstd.eq('GT04')) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>            skip
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>          elseif (!cmdsstd.eq('GT05')) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>            skip
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>          elseif (!cmdsstd.eq('GT09')) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>            skip
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>          elseif (!cmdsstd.eq('GT10')) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>            skip
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>          elseif (!cmdsstd.eq('GT20')) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>            skip
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>          elseif (!cmdsstd.eq('GT29')) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>            skip
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>          elseif (!cmdsstd.eq('GT38')) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>            skip
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>          endif
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        endif
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>$)
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- NOW Get the VALUES stored in the "MATCHING MDS Standard" Global Variables !indx,
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- i.e. !ccodarray[!indx]<CCOD> and !descarray[!indx]<DESC> MUST represent the SAME MDS Standard
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        !ccodvalu = $!ccodarray[$!indx]
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        !ccodvalu = !ccodvalu.trim()
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        !descvalu = $!descarray[$!indx]
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        !descvalu = !descvalu.trim()
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- Standardise the LENGTH of the !ccodvalu to 8 characters
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        if (!ccodvalu.length().leq(8)) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>          do !add from !ccodvalu.length() to 8
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>            !ccodvalu = !ccodvalu & | |
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>          enddo
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        endif
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- Determine the DTEXT and RTEXT for the passed !form.standard list gadget
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- The variable !!mdsDebug is ONLY used by the MDS HANGER <?TEMPLATES?> PML CODE ?? but DOES it WORK ??
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- ????? NOTE *** !!mdsDebug ia a PML OBJECT so CHECK out the SYNTAX where it is USED below ?????
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        if (defined(!!mdsDebug)) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>          if (!!mdsDebug) then
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>            !dtext.append(!cmdsstd & | - | & !ccodvalu & !descvalu
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>          else
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- Normal USER MDS Loading
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>            !dtext.append(!ccodvalu & |- | & !descvalu )
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>          endif
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        else
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>-- Normal USER MDS Loading
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>          !dtext.append(!ccodvalu & |- | & !descvalu )
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>          --!dtext1.append(!ccodvalu)
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>          --!dtext2.append(|- | & !descvalu)
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        endif
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        !rtext.append(!cmdsstd)
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        --!rtext1.append(!cmdsstd)
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>        --!rtext2.append(!cmdsstd)
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>      endif
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>    enddo
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>
  --<wd>31oct2006 - REDUNDANT PML CODE for MDS12 >>  enddo

  ------------------------------------------------------------------------------------------------------------
  --<wd>31oct2006 - The REDUNDANT CODE ABOVE has been REPLACED by the NEW CODE shown at the TOP of this METHOD
  ------------------------------------------------------------------------------------------------------------
  --**********************************************************************************************************
  --**********************************************************************************************************
  --**********************************************************************************************************

  -- Set the FORM Headings and Rows
  --  !dtext.append(!dtext1)
  --  !dtext.append(!dtext2)
  --  !rtext.append(!rtext1)
  --  !rtext.append(!rtext2)
  --  !headings = ARRAY()
  --  !headings.append(|Support Type & Description|)
  --  !headings.append(|Description|)
  --  !form.standard.setheadings(!headings)
  --  !form.standard.setcolumns(!dtext)

  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  -- LOAD the DTEXT and RTEXT for the passed !form.standard list gadget
  --<dw>28feb2008dun858 - option gadget referred to as selecta for bracing form
  if (!bracingForm) then
    !form.selecta.dtext = !dtxt
    handle ANY
      --      The FORM !form and/or the !form.standard list gadget does NOT exist
    elsehandle NONE
      !form.selecta.rtext = !rtxt
    endhandle
  else
    !form.standard.dtext = !dtxt
    handle ANY
      --     The FORM !form and/or the !form.standard list gadget does NOT exist
    elsehandle NONE
      !form.standard.rtext = !rtxt
    endhandle
  endif
  --<dw>28feb2008dun858 - end option gadget referred to as selecta for bracing form

endmethod
