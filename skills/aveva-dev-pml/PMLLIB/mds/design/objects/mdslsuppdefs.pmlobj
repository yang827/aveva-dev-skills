--
-- Description:
-- Lighting support defaults
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  Getdbref(STRING)                 DBREF
--  Getdbref(STRING,STRING)          DBREF
--  IdFilter(ANY)                    -
--  IdLighting()                     DBREF
--  Mdslsuppdefs()                   -
--  SuppCode(ANY)                    -
--  UpdateDb()                       -
--  VerifyLight(DBREF)               BOOLEAN
--  VerifySupp(DBREF)                BOOLEAN
--

define object MDSLSUPPDEFS

    member .Idtype is STRING         $* Lighting element type
    member .Idfilter is EXPRESSION   $* Lighting selection filter
    member .Lightorig is STRING      $* Lighting origin definition
    member .LightYdir is STRING      $* Lighting Y axis definition
    member .SuppOrig is STRING       $* Support origin definition
    member .Type is STRING           $* Support type (:Mdssupptype)
    member .SuppCode is EXPRESSION   $* Support code definition
    member .ReplaceType is STRING    $* Support replacement type
    member .Error is STRING          $* Loading error
    member .MaxHeig is REAL          $* Maximum support height/length
    member .MinHeig is REAL          $* Maximum support height/length
    member .StayLimHeig is REAL      $* Stay limit height
    member .TmplZone is DBREF        $* Zone holding support templates

endobject
-- end of object definition


-- method to get dbref of catalogue DTSE item holding the defaults
----------------------------------------------------------------------------------------------
define method .Getdbref(!Key is STRING) is DBREF

   !Dtse = ARRAY()

-- this is the main declaration of lighting defaults in catalogue
-- all calls should go through this method
   !Dtse.append(/MDS/LIGHTING/DEFAULTS/ID/DTSE )
   !Dtse.append(/MDS/LIGHTING/DEFAULTS/LIGHTYDIR/DTSE )
   !Dtse.append(/MDS/LIGHTING/DEFAULTS/LIGHTORIG/DTSE )
   !Dtse.append(/MDS/LIGHTING/DEFAULTS/SUPPORIG/DTSE )
   !Dtse.append(/MDS/LIGHTING/DEFAULTS/HEIGHT/DTSE )

   !UpKey = !Key.upcase()
   if !upkey.eq('ID') then
      !Indx = 1
   elseif !upkey.eq('LIGHTYDIR') then
      !Indx = 2
   elseif !upkey.eq('LIGHTORIG') then
      !Indx = 3
   elseif !upkey.eq('SUPPORIG') then
      !Indx = 4
   elseif !upkey.eq('HEIGHT') then
      !Indx = 5
   endif

   return !Dtse[!indx]

endmethod



-- default constructor
--------------------------------------------------------------------------------
define method .Mdslsuppdefs()

    -- lighting support type 'LS' and lighting id filter (TRUE) must be always declared as it is called
    -- from some MDS files even if lighting support defaults are not loaded
    !this.type = 'LS'
    !this.idfilter.expression('( TRUE )')


    !this.error = STRING()
    !Error = 'Default data for lighting supports are not available or incomplete in catalogue DB'

    !iddtse = !this.Getdbref('ID')
        handle ANY
          !this.error =  '$!error'
          return
        endhandle

    !filterEntry = !this.Getdbref('ID','FILT')
        handle ANY
          !this.error =  '$!error'
          return
        endhandle

    !codeEntry = !this.Getdbref('ID','CODE')
        handle ANY
          !this.error =  '$!error'
          return
        endhandle

    !ydirdtse = !this.Getdbref('LIGHTYDIR')
        handle ANY
          !this.error =  '$!error'
          return
        endhandle

    !lorigdtse = !this.Getdbref('LIGHTORIG')
        handle ANY
          !this.error =  '$!error'
          return
        endhandle

    !sorigdtse = !this.Getdbref('SUPPORIG')
        handle ANY
          !this.error =  '$!error'
          return
        endhandle

    !heig = !this.Getdbref('HEIGHT')
        handle ANY
          !this.error =  '$!error'
          return
        endhandle


    !tmplZone = /MDS/SPECIALS/LIGHTING
        handle ANY
          !this.error =  'Lighting Support Templates Area does not exist!'
          return
        endhandle


    !this.TmplZone = !tmplZone
    !this.idtype = !iddtse.prop.TYPE
    !this.type = !iddtse.prop.SPTY
    !this.replacetype = !iddtse.prop.SPRT
    !this.suppcode(!codeEntry.ppro)
    !this.idfilter(!filterEntry.ppro)
    !this.lightorig = !lorigdtse.prop.OPTN
    !this.lightYdir = !ydirdtse.prop.OPTN
    !this.supporig = !sorigdtse.prop.OPTN
    !this.maxheig = !heig.rpro.MAXH
    !this.minheig = !heig.rpro.MINH
    !this.staylimheig = !heig.rpro.LIMH

endmethod


-- method to set value of member Idfilter - argument can be both STRING or EXPRESSION
-- Always use this method to set IdFilter !!
---------------------------------------------------------------------------------------------
define method .IdFilter(!LogExp is ANY)

    -- check for argument data type
    if !logexp.objecttype().eq('STRING') then
       !exp = object EXPRESSION(!logexp)
    elseif !logexp.objecttype.eq('EXPRESSION') then
       !exp = !logexp
    else
       !exp = object EXPRESSION()
    endif

    -- check if expression is set
    if !exp.valid().not() then
       !exp.expression('( TRUE )')
    endif

    -- check expression type
    var !exptyp exptyp $!Exp
    if !exptyp[1].trim().neq('LOGICAL') then
       !exp.expression('( TRUE )')
    endif

    !this.Idfilter = !exp

endmethod

-- method to set value of member SuppCode - argument can be both STRING or EXPRESSION
-- Always use this method to set SuppCode !!
----------------------------------------------------------------------------------------------
define method .SuppCode(!StrExp is ANY)

    -- check for argument data type
    if !strexp.objecttype().eq('STRING') then
       !exp = object EXPRESSION(!strexp)
    elseif !strexp.objecttype.eq('EXPRESSION') then
       !exp = !strexp
    else
       !exp = object EXPRESSION('0')
    endif

    -- check if expression is set
    if !exp.valid().not() then
       !exp.expression('0')
    endif

    -- check expression type
    var !exptyp exptyp $!Exp
    if !exptyp[1].trim().neq('TEXT') then
       !exp.expression()
    endif

    !this.SuppCode = !exp

endmethod

----------------------------------------------------------------------------------------------------
-- identify the lighting
----------------------------------------------------------------------------------------------------
define method .IdLighting() is DBREF

   prompt off

   do
       prompt load escape 'Identify Lighting ($!this.idtype) to support'
       !Light = nulref
       !Light = ref of id $!this.Idtype@
          handle ANY
            break
          endhandle

       if !!mdslsuppdefs.verifylight(!Light) then
          if !Light.:mdssref.badref() then
              break
          else
              add :mdssref of $!light
                 handle ANY
                 endhandle
              !!alert.error('The Lighting picked is alredy supported!')
              skip
          endif
       else
          skip
       endif
   enddo

   prompt off

   return !light


endmethod


-- method to verify if items is lighting support
---------------------------------------------------------------------------------------------
define method .VerifySupp(!Supp is DBREF) is BOOLEAN


    if !this.error.set() then
       return FALSE
    endif

    !result = FALSE
    !SuppType = !this.type

    !test = STRU of $!supp
       handle ANY
         return !result
       endhandle

    return !test.:mdssupptype.eq(!supptype)

endmethod



-- method to verify if item is lighting
---------------------------------------------------------------------------------------------
define method .VerifyLight(!Light is DBREF) is BOOLEAN

    if !this.error.set() then
       return FALSE
    endif

   !Result = FALSE
   !Ltyp = !this.idtype
   !Exp = !this.idfilter

   !test = $!ltyp of $!Light
     handle ANY
        return !result
     endhandle

     !Result = !exp.evaluate(!test)
       handle ANY
         return !result
       endhandle

     return !result

endmethod



--method to get DBREF of catalogue DATA item holding the default
----------------------------------------------------------------------------------------------
define method .Getdbref(!DtseKey is STRING, !Key is STRING) is DBREF

   !Dtse = !this.getdbref(!DtseKey)

   var !All collect all DATA with dkey eq upcase('$!Key') for $!Dtse

   return !All[1].dbref()


endmethod


-- update db with object data
----------------------------------------------------------------------------------------------
define method .UpdateDb()

  !OldCE = !!ce

   -- write ID section
   -- type of lighting
   !!ce = !this.getdbref('ID','TYPE')
   ppro '$!this.idtype'

   -- filter
   !!ce = !this.getdbref('ID','FILT')
   !!ce.ppro = !this.idfilter.string()

   -- support type
   !!ce = !this.getdbref('ID','SPTY')
   ppro '$!this.type'

   -- support replacement type
   !!ce = !this.getdbref('ID','SPRT')
   ppro '$!this.replacetype'

   -- expression generating support code
   !!ce = !this.getdbref('ID','CODE')
   !!ce.ppro = !this.suppcode.string()


   -- write lighting Ydir definition
   !!ce = !this.getdbref('LIGHTYDIR','OPTN')
   ppro '$!this.lightydir'


   -- write lighting origin definition
   !!ce = !this.getdbref('LIGHTORIG','OPTN')
   ppro '$!this.lightorig'


   -- write support origin definition
   !!ce = !this.getdbref('SUPPORIG','OPTN')
   ppro '$!this.supporig'


   -- write HEIGHT section
   -- Max. height
   !!ce = !this.getdbref('HEIGHT','MAXH')
   ppro $!this.maxheig

   -- Min. height
   !!ce = !this.getdbref('HEIGHT','MINH')
   ppro $!this.minheig

   -- stay limit
   !!ce = !this.getdbref('HEIGHT','LIMH')
   ppro $!this.staylimheig

   !!ce = !Oldce

endmethod
