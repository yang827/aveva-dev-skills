--
--
-- Description:
-- Lighting support object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  bestPlaneFrom(DBREF,DIRECTION)   PLANE
--  checkHeig(REAL)                  -
--  checkLight(DBREF,DBREF)          BOOLEAN
--  copyFrom(DBREF)                  -
--  create(STRING)                   -
--  deleteSupp()                     -
--  editRules(DBREF,STRING,STRING)   -
--  eq(MDSLSUPPORT)                  BOOLEAN
--  gadgetHeig()                     -
--  getDataFrom(DBREF)               -
--  getElemForUDA()                  DBREF
--  getProperty(STRING)              ANY
--  getYdirFrom(DBREF)               DIRECTION
--  getsupports()                    ARRAY
--  graphicalDim(BOOLEAN,REAL)       -
--  heig(EDGPICKDATA)                -
--  heig(PLANE,BOOLEAN)              -
--  heig(REAL)                       -
--  maxMinHeig(DBREF)                ARRAY
--  mdslsupport()                    -
--  mdslsupport(DBREF)               -
--  mirror()                         -
--  origin()                         -
--  possupp()                        -
--  postRename(STRING)               -
--  restore()                        -
--  rotate(REAL)                     -
--  setAtt()                         -
--  update(DBREF)                    -
--

-- Define Object
define object MDSLSUPPORT

  -- Support Standard Type
  member .type       is STRING

  -- Support Replacement Type
  member .replace    is STRING

  -- reference to support
  member .stru is DBREF

  -- dummy "DATUM" reference - some of MDS functions require that
  member .datum is DBREF

  -- Has Datum Been Position
  member .position   is BOOLEAN

  -- Support Y direction
  member .yDir      is DIRECTION

  -- Support origin
  member .origin is POSITION

  -- Endplane - surface of a wall or ceiling
  member .endPlane   is PLANE

  -- Reference to supported lighting element
  member .light is DBREF

  -- reference to ceiling/wall/steel
  member .ancref is DBREF

  -- reference to template
  member .tmpl is DBREF

  -- dummy "ATTA" reference array - some of MDS functions require that
  member .atta is ARRAY

  -- height
  member .heig is REAL

  -- pointers to main rod(s)
  member .rod is ARRAY

  -- pointers to stay(s)
  member .stay is ARRAY

  -- pointer to stay(s) in template
  member .stayTmpl is ARRAY

  -- mirror flag
  member .mirror is BOOLEAN

  -- rotation angle
  member .rotate is REAL

  -- reference to text gadget (must be real)
  member .gadgetHeig is GADGET

  -- End object
endobject

-- default settings
----------------------------------------------------------------------------------------------------
define method .mdslsupport()

  !this.stru = nulref
  !this.datum = nulref
  !this.position = FALSE
  !this.yDir = object DIRECTION()
  !this.endPlane = object PLANE()
  !this.light = nulref
  !this.tmpl = nulref
  !this.ancref = nulref
  !this.atta.clear()
  !this.heig = REAL()
  !this.rod.clear()
  !this.stay.clear()
  !this.stayTmpl.clear()
  !this.mirror = BOOLEAN()
  !this.rotate = REAL()
  !this.ancref = nulref

  !this.gadgetHeig()

endmethod

-- load existing support into object
----------------------------------------------------------------------------------------------------
define method .mdslsupport(!stru is DBREF)

  !this.stru = !stru
  !this.datum = !stru
  !this.type = !stru.:mdssupptype
  !this.position = !stru.position.wrt(worl).neq(e0 n0 u0 wrt world)
  !this.yDir = !stru.ori.yDir().wrt(worl)
  !this.origin()
  !this.tmpl = !stru.:mdsprojspec
  !this.light = !stru.:mdssref
  !this.ancref = !stru.:mdsancref[1]
  handle ANY
    !this.ancref = nulref
  endhandle
  !this.atta[1] = !stru
  !this.rotate = !stru.:mdssplrot
  if !this.light.badref() then
    !this.mirror = false
  else
    !this.mirror = !this.yDir.neq(!this.getYdirFrom(!this.light))
  endif
  !this.update(!stru)

  !this.heig = !this.getProperty('heig')
  handle ANY
    if defined(!this.rod[1]) then
      !this.heig = ( cutl of $!this.rod[1] )
    else
      !this.heig = REAL()
    endif
  endhandle

  !this.gadgetHeig()

endmethod

-- set height gadget
----------------------------------------------------------------------------------------------------
define method .gadgetHeig()

  !this.gadgetHeig.val = !this.heig
  handle NONE
    !this.gadgetHeig.active = !this.heig.set()
    if !this.gadgetHeig.active then
      if !this.rod[1].zdir.up.eq(1) then
        !this.gadgetHeig.tag = 'Height'
      else
        !this.gadgetHeig.tag = 'Length'
      endif
    endif
  elsehandle ANY
  endhandle

endmethod


-- check if this object is equal to another MDSLSUPPORT object
----------------------------------------------------------------------------------------------------
define method .eq(!that is MDSLSUPPORT) is BOOLEAN

  if !this.position.neq(!that.position) then
    return FALSE
  endif

  if !this.yDir.neq(!that.yDir) then
    return FALSE
  endif

  if !this.endPlane.neq(!that.endPlane) then
    return FALSE
  endif

  if !this.origin.neq(!that.origin) then
    return FALSE
  endif

  if !this.ancref.neq(!that.ancref) then
    return FALSE
  endif

  if !this.tmpl.neq(!that.tmpl) then
    return FALSE
  endif

  if !this.heig.neq(!that.heig) then
    return FALSE
  endif

  if !this.mirror.neq(!that.mirror) then
    return FALSE
  endif

  if !this.rotate.neq(!that.rotate) then
    return FALSE
  endif

  if !this.rod.size().neq(!that.rod.size()) then
    return FALSE
  endif

  if !this.stay.size().neq(!that.stay.size()) then
    return FALSE
  endif

  return TRUE

endmethod


-- update object
----------------------------------------------------------------------------------------------------
define method .update(!stru is DBREF)

  var !rod collect all SCTN with purp eq 'LEG' for $!stru
  var !stay collect all SCTN with purp eq 'STAY' for $!stru
  !this.rod = !rod.evaluate(object BLOCK('!rod[!evalindex].dbref()'))
  !this.stay = !stay.evaluate(object BLOCK('!stay[!evalindex].dbref()'))
  if !this.tmpl.badref().not() then
    var !stayTmpl collect all SCTN with purp eq 'STAY' for $!this.tmpl
    !this.stayTmpl = !stayTmpl.evaluate(object BLOCK('!stayTmpl[!evalindex].dbref()'))
  else
    !this.stayTmpl.clear()
  endif

  if defined(!this.rod[1]) then
    !this.endPlane = object PLANE(!this.rod[1].pose.wrt(world),!this.rod[1].orientation.wrt(world))
  else
    !this.endPlane = object PLANE()
  endif


endmethod

-- get support property
----------------------------------------------------------------------------------------------------
define method .getProperty(!propName is STRING) is ANY


  return !!mdsLsupprop(!this.stru,!propName)

endmethod


-- check if support is applicable to given lighting
----------------------------------------------------------------------------------------------------
define method .checkLight(!tmplStru is DBREF,!light is DBREF) is BOOLEAN


  !composeExp = STRING()

  var !allData collect all DDAT with dkey eq 'APPL' for $!tmplStru

  !c = 0
  do !val values !allData
    !data = !val.dbref()
    var !checkExpr exptyp $!data.ddpr
    skip if !checkExpr[1].trim().neq('LOGICAL')
    !c = !c + 1
    !exp = object EXPRESSION(!data.ddpr)
    !thisExp = !exp.evaluate(!light).string()
    !operator = !data.ptyp
    if !operator.eq('OR').or(!operator.eq('AND')).not() then
      !operator = 'AND'
    endif
    if !c.eq(1) then
      !composeExp = !thisExp
    else
      !composeExp = !composeExp + ' ' + !operator + ' ' + !thisExp
    endif
  enddo

  if !composeExp.unset() then
    !composeExp = 'TRUE'
  endif

  !match = object EXPRESSION(!composeExp)

  return !match.evaluate(ce)

endmethod

-- copy support from template
----------------------------------------------------------------------------------------------------
define method .copyFrom(!tmpl is DBREF)

  !newName = !this.stru.name
  !oldName = !tmpl.name
  !oldPlane = !this.endPlane

  !!ce = !this.stru
  :MdsProjSPec $!tmpl

  delete stru memb
  handle ANY
  endhandle
  -- copy all members except DDSE
  do !c indices !tmpl.memb
    skip if !tmpl.memb[!c].type.eq('DDSE')
    copy memb $!c of $!tmpl rename  $!oldName $!newName
  enddo

$(
  -- rename pointers used within functions of steel
  var !allsctn collect all SCTN for $!this.stru
  do !val values !allsctn
    !sctn = !val.dbref()
    !sctn.func = !sctn.func.replace(!oldName,!newName)
    handle ANY
    endhandle
  enddo

  -- rename all names used within design rules
  var !allmem collect all for $!this.stru
  do !val values !allmem
    !this.editRules(!val.dbref(),!oldName,!newName)
  enddo
$)

  -- reflect new name within all design rules and non-reference attributes
  !this.postRename(!oldName)

  -- store template that has been copied from
  !this.tmpl = !tmpl

  -- update object
  !this.update(!this.stru)

  -- position support
  !this.possupp()


  -- handle height
  !this.heig = !this.getProperty('HEIG')
  handle ANY
    if defined(!this.rod[1]) then
      !this.heig = ( cutl of $!this.rod[1] )
    else
      !this.heig = REAL()
    endif
  endhandle


  !heigByDist = false
  !heigByPlane = false
  !keepRotation = true
  if !oldPlane.position.set().and(!oldPlane.orientation.set()) then
    if !this.heig.set() then
      if !this.endPlane.position.set().and(!this.endPlane.orientation.set()) then
        if !this.endPlane.direction().isparallel(!oldPlane.direction()) then
          !heigByPlane = true
        else
          !heigByDist = true
          !keepRotation = false
        endif
      else
        !heigByDist = true
      endif
    endif
  else
    !heigByDist = !this.heig.set()
  endif


  -- re-use rotatation angle
  !rotate = !this.rotate
  !this.rotate = 0
  if !keepRotation then
    !this.rotate(!rotate)
  endif

  if !heigByPlane then
    --keep endplane
    !this.heig(!oldPlane,true)
  elseif !heigByDist then
    --leave height as defined in template
    !heig = !this.heig
    !this.checkHeig(!heig)
    handle 1
      !heig = !this.maxMinHeig(!this.stru)[2]
    elsehandle 2
      !heig = !this.maxMinHeig(!this.stru)[1]
    endhandle
    !this.heig(!heig)
  else
    !this.gadgetHeig()
  endif


endmethod


-- replace text within design rules of db item
----------------------------------------------------------------------------------------------------
define method .editRules(!item is DBREF,!oldtxt is STRING, !newtxt is STRING)

  !same = ce
  !!ce = !item

  do !attr values !!ce.rlis
    var !rule rule of $!attr
    !rule = !rule.after(!rule.before('(')).replace(!oldtxt,!newtxt)
    rule set $!attr $!rule
    handle ANY
    endhandle
  enddo

  !!ce = !same

endmethod


-- edit all rules and other non-reference attributes to reflect new name after renaming
----------------------------------------------------------------------------------------------------
define method .postRename(!oldName is STRING)

  !newName = !this.stru.name

  -- rename pointers used within functions of steel
  var !allsctn collect all SCTN for $!this.stru
  do !val values !allsctn
    !sctn = !val.dbref()
    !sctn.func = !sctn.func.replace(!oldName,!newName)
    handle ANY
    endhandle
  enddo

  -- rename all names used within design rules
  var !allmem collect all for $!this.stru
  do !val values !allmem
    !this.editRules(!val.dbref(),!oldName,!newName)
  enddo

endmethod


-- get Ydirection form lighting
----------------------------------------------------------------------------------------------------
define method .getYdirFrom(!light is DBREF) is DIRECTION

  !this.light = !light
  !yDir = Y wrt $!light
  !direxp = !!mdsLsuppDefs.lightYdir

  !yDir = $!<direxp> DIR of $!light
  handle ANY
    !yDir = $!<direxp> wrt $!light
    handle ANY
    endhandle
  endhandle

  return !yDir

endmethod

-- populate object with data obtained from lighting
----------------------------------------------------------------------------------------------------
define method .getDataFrom(!light is DBREF)


  !this.yDir = !this.getYdirFrom(!light)

  !!ce = !this.stru
  rotate and Y is $!this.yDir
  -- set cross references
  !!ce.:MdsSref = !light
  !!ce.:MdsSref.:MdsSref = !this.stru

  !this.possupp()

endmethod

-- method to create new support
----------------------------------------------------------------------------------------------------
define method .create(!name is STRING)

  if !!mdsmovetosite('').not() then
    return error 1 'Cannot navigate to Default Creation Zone!'
  endif

  new STRU $!name
  !!ce.:MdsSuppType = !!mdsLsuppDefs.type

  !this.mdslsupport(ce)

endmethod



-- position support
----------------------------------------------------------------------------------------------------
define method .possupp()

  !posexp = !!mdsLsuppDefs.lightOrig
  !light = !this.light

  !pos = $!<posexp> pos of $!light
  handle ANY
    !pos = $!<posexp> of $!light
    handle ANY
      !pos = pos of $!light
    endhandle
  endhandle

  !this.stru.pos = !pos


  -- support origin may has changed
  !this.origin()
  !suppOrig = !this.origin

  -- correct position
  if !this.origin.neq(!pos) then
    !suppOrig.east = !suppOrig.east * -1
    !suppOrig.north = !suppOrig.north * -1
    !suppOrig.up = !suppOrig.up * -1
    !this.stru.pos = !suppOrig
  endif

  -- reset endplane
  if defined(!this.rod[1]) then
    !this.endPlane.position = !this.rod[1].pose.wrt(worl)
  endif

  !this.position = TRUE

endmethod

-- set height by value
---------------------------------------------------------------------------------------------------
define method .heig(!heig is REAL)


  !stayLimit = !!mdsLsuppDefs.staylimheig
  !stayLimit = !this.getProperty('LIMH')
  handle ANY
  endhandle

  !diff = !heig - !this.heig
  !dir = !this.endPlane.direction()
  !endpos = !this.endPlane.position
  !newpos = !this.endPlane.pointvector().offset(!diff).position

  if !heig.geq(!stayLimit) then
    if !this.stay.unset().and(!this.stayTmpl.set()) then
      !new = !this.stru.name
      !old = !this.tmpl.name
      !!ce = frmw1 of $!this.stru
      !!ce = !!ce.memb.last()
      do !stayTmpl values !this.stayTmpl
        !oldName = name of $!stayTmpl
        !newName = !oldName.replace(!old,!new)
        new SCTN $!newName copy $!stayTmpl rename $!oldName $!newName
        -- replace names within function and rules
        !!ce.func = !!ce.func.replace(!old,!new)
        !this.editRules(ce,!old,!new)
        if !!ce.func.trim().empty().not() then
          rotate thro $!!ce.func about zdir of $!!ce.func by $!this.rotate
        endif
        move $!dir clear infront $!endpos
        !this.stay.append(ce)
      enddo
    endif
  else
    if !this.stay.set() then
      do !c indices !this.stay
        !!ce = !this.stay[!c]
        delete $!!ce.type
      enddo
      !this.stay.clear()
    endif
  endif


  do !rod values !this.rod
    !!ce = !rod
    extend thro $!newpos
  enddo

  do !stay values !this.stay
    !!ce = !stay
    move $!dir clear infront $!newpos
  enddo

  !this.endPlane.position = !newpos.wrt(worl)


  if !this.heig.neq(!heig) then
    -- clear ancref
    !this.ancref = nulref
  endif

  -- store new value of height
  !this.heig = !heig
  !this.gadgetHeig()

  -- re-execute rules
  !!ce = stru
  rule rexecute

endmethod


-- method to restore support from current object settings
----------------------------------------------------------------------------------------------------
define method .restore()

  !!ce = !this.stru

  !yDir = !this.yDir

  !heig = !this.heig
  !rotate = !this.rotate
  rotate and Y is $!this.yDir

  !this.copyFrom(!this.tmpl)

  if !this.rotate.neq(!rotate) then
    !this.rotate(!rotate)
  endif

  if !this.stru.ori.yDir().wrt(worl).neq(!this.yDir) then
    !this.mirror()
  endif

  if !this.heig.neq(!heig) then
    !this.heig(!heig)
  endif

  !this.setAtt()

endmethod

-- set support attributes
----------------------------------------------------------------------------------------------------
define method .setAtt()

  !!ce = !this.stru
  :mdssplrot $!this.rotate
  :mdsancref $!this.ancref
  handle ANY
    !ownls = !this.ancref.ownls.invert()
    :mdsancref unset
    do !ancref values !ownls
      :mdsancref $!ancref
      handle NONE
        break
      elsehandle ANY
        skip
      endhandle
    enddo
  endhandle

endmethod

-- set height to plane
----------------------------------------------------------------------------------------------------
define method .heig(!plane is PLANE,!forced is BOOLEAN)

  !pos = !plane.position

  !start = !this.endPlane.pointvector().offset(!this.heig * -1).position

  !heig = !start.distance(!plane)

  !ancref = !this.ancref

  !this.checkHeig(!heig)
  handle 1
    !ancref = nulref
    if !forced then
      !heig = !this.maxMinHeig(!this.stru)[2]
      !message = !!error.text + '.
      Setting HEIGHT to minimum!'
    else
      return error 1 '$!!error.text'
    endif
  elsehandle 2
    !ancref = nulref
    if !forced then
      !heig = !this.maxMinHeig(!this.stru)[1]
      !message = !!error.text + '.
      Setting HEIGHT to maximum!'
    else
      return error 2 '$!!error.text'
    endif
  endhandle


  !this.heig(!heig)

  refresh

  if defined(!message) then
    !!alert.message(!message)
  endif

  !this.ancref = !ancref

endmethod


-- set height and ancref by EDG pick
----------------------------------------------------------------------------------------------------
define method .heig(!edgPick is EDGPICKDATA)

  if undefined(!this.rod[1]) then
    return error 1 'Height cannot be set for support $!this.stru.namn!'
  endif

  if !edgPick.item.badref() then
    return error 1 'DB element must be picked!'
  endif

  !item = !edgPick.item
  !ownerType = !item.ownls[3].type
  handle ANY
    !ownerType = ''
  endhandle
  if !ownerType.neq('STRU') then
    return error 1 'Lighting support can only be connected to items below STRU.'
  elseif !item.ownls[3].eq(!this.stru) then
    return error 1 'Are you serious? You are about to connect support to itself!'
  endif

  !gendir = !this.endPlane.direction()
  !ptve = object POINTVECTOR(!this.rod[1].poss,!gendir)
  !thrpos = !ptve.through(!item.pos).position
  !mirror = false
  if !this.rod[1].poss.direction(!thrpos).neq(!gendir) then
    !gendir = !gendir.opposite()
    !mirror = true
  endif


  if !edgPick.primaryObject.neq('FACET') then
    return error 1 'Surface must be picked'
  else
    !facet = !edgPick.facets.unique()
    !plane = !edgPick.positionData().plane
  endif

  !direction = !plane.direction().opposite()

  if !direction.up.eq(0).or(!direction.up.eq(1)).not() then
    return error 1 'Normal to picked surface must be either horizontal or vertical down'
  endif

  if !direction.neq(!gendir) then
    return error 1 'Normal to surface picked is not suitable to support $!this.stru.namn'
  endif


  if !mirror then
    !this.mirror()
  endif

  !orientation = Z is $!direction
  !plane.position = !plane.near(!this.rod[1].pose)

  !profile = object PROFILE(!plane.position,!orientation,!facet)
  !profile.close()

  -- resolve front/back face of panel/extru (only three vertices are actually returned from edg pick)
  if !item.hardtype.eq('PANE') then
    !loop = ploop 1 of $!item
  elseif !item.hardtype.eq('EXTR') then
    !loop = loop 1 of $!item
  else
    !loop = nulref
  endif
  if !loop.badref().not() then
    !tmpProfile = object PROFILE(!loop)
    if !tmpProfile.plane().direction().isparallel(!direction) then
      !tmpProfile.position = !plane.near(!tmpProfile.position)
      !profile = !tmpProfile
    endif
  endif


  -- check if main leg intersects with picked surface
  if !profile.isWithout(!plane.position) then
    !!alert.warning('WARNING: Support $!this.stru.namn is outside of picked surface!')
    !item = nulref
    -- for debugging purposes only
    if defined(!!kPDebugGphFeedback) then
      !!facet = !facet
      !profile.draw(1,1,1)
    endif
  endif
  !this.heig(!plane,false)
  handle ANY
    if !mirror then
      !this.mirror()
    endif
    return error 1 '$!!error.text'
  endhandle

  !ancref = !item
  !this.ancref = !ancref


endmethod

-- get max/min support height
----------------------------------------------------------------------------------------------------
define method .maxMinHeig(!stru is DBREF) is ARRAY


  !source = !this.stru.:MdsProjSpec

  -- set default values
  !max = !!mdsLsuppDefs.maxheig
  !min = !!mdsLsuppDefs.minheig

  var !allData collect all DDAT with dkey eq 'HDEF' for $!source
  !expresult = BOOLEAN()
  do !val values !allData
    !data = !val.dbref()
    skip if !data.maxmin.unset()
    !exp = object EXPRESSION(!data.ddpr)
    handle ANY
      !exp = object EXPRESSION('true')
    endhandle
    !expresult = !exp.evaluate(!this.stru)
    handle ANY
      skip
    endhandle
    skip if !expresult.unset()
    if !expresult then
      !max = !data.maxmin[1]
      !min = !data.maxmin[2]
      handle ANY
      endhandle
      break
    endif
  enddo


  if (!!isImperialLength('DIST').not()) then
    !min = $!min
    !max = $!max
  endif

  !maxmin[1] = !max
  !maxmin[2] = !min

  return !maxmin

endmethod


-- check height
----------------------------------------------------------------------------------------------------
define method .checkHeig(!heig is REAL)

  !maxmin = !this.maxMinHeig(!this.stru)
  !max = !maxmin[1]
  !min = !maxmin[2]


  !fHeig = !heig.string(!!distanceFMT)
  !fmax = !max.string(!!distanceFMT)
  !fMin = !min.string(!!distanceFMT)

  if !heig.lt(!min) then
    return error 1 |Given HEIGHT ($!fHeig) is less then minimum specified ($!fMin) for support $!this.stru.namn|
  endif

  if !max.gt(!min) then
    if !heig.gt(!max) then
      return error 2 |Given HEIGHT ($!fHeig) is greater then maximum specified ($!fmax) for support $!this.stru.namn|
    endif
  endif


endmethod



-- get list of available support
----------------------------------------------------------------------------------------------------
define method .getsupports() is ARRAY

  !result = ARRAY()
  !zone = !!mdsLsuppDefs.tmplZone
  handle ANY
    return !result
  endhandle

  !memb = !zone.memb
  !light = !this.light
  do !tmpl values !memb
    !expresult = BOOLEAN()
    skip if !tmpl.type.neq('STRU')
    -- check if applicable for given lighting
    !expresult = !this.checkLight(!tmpl,!light)
    handle ANY
      !expresult = TRUE
    endhandle
    if !expresult.unset() then
      !expresult = TRUE
    endif
    skip if !expresult.not()
    !result.append(!tmpl)
  enddo

  return !result

endmethod


-- set support origin
----------------------------------------------------------------------------------------------------
define method .origin()

  !suppOrigCode = !!mdsLsuppDefs.suppOrig

  !suppOrig = $!suppOrigCode pos of $!this.stru
  handle ANY
    !suppOrig = $!suppOrigCode of $!this.stru
    handle ANY
      !suppOrig = pos of $!this.stru
    endhandle
  endhandle

  -- store support origin
  !this.origin = !suppOrig.wrt(!this.stru)

endmethod

-- mirror support
----------------------------------------------------------------------------------------------------
define method .mirror()

  !!ce = !this.stru

  rotate thro $!this.origin about Z wrt ce by 180

  !this.yDir = !this.stru.ori.yDir().wrt(worl)

  !this.mirror = !this.yDir.neq(!this.getYdirFrom(!this.light))

  if defined(!this.rod[1]) then
    if !this.rod[1].zdir.wrt(world).up.neq(1) then
      !this.endPlane.plane(!this.rod[1].pose.wrt(worl),!this.rod[1].orientation.wrt(worl))
      !this.ancref = nulref
    endif
  endif


endmethod

-- get plane from best p-line
----------------------------------------------------------------------------------------------------
define method .bestPlaneFrom(!sctn is DBREF,!oppDir is DIRECTION) is PLANE


  !plane = object PLANE()
  !dir = !oppDir.opposite()

  !plines = ARRAY()
  !distances = ARRAY()
  var !allplin collect all PLIN with ccon eq 'ANY' for pstre of $!sctn
  if !allplin.unset() then
    var !allplin collect all PLIN for pstre of $!sctn
  endif

  do !plinref values !allplin
    !plin = !plinref.dbref().pkey
    skip if !plin.empty()
    if !sctn.plor.$!<plin>.zdir().eq(!dir) then
      !line = object LINE(!sctn.plst.$!<plin> , !sctn.plen.$!<plin> )
      !plines.append(!plin)
      !distances.append(!this.origin.distance(!line.near(!this.origin)))
    endif
  enddo

  if !plines.unset() then
    return !plane
  endif

  !plines.reindex(!distances.sortedindices())
  !plin = !plines[1]
  !plane = !this.endPlane
  !plane.position = !this.endPlane.pointvector().through(!sctn.plst.$!<plin>).position

  return !plane

endmethod


-- rotate some part of support
----------------------------------------------------------------------------------------------------
define method .rotate(!angle is REAL)


  do !rod values !this.rod
    skip if !rod.func.trim().empty()
    !!ce = !rod
    !id = func
    rotate thr $!id about zdir of $!id by $!angle
  enddo

  do !stay values !this.stay
    skip if !stay.func.trim().empty()
    !!ce = !stay
    !id = func
    rotate thr $!id about zdir of $!id by $!angle
  enddo

  !rotate = !this.rotate + !angle
  if !rotate.geq(360) then
    !rotate = !rotate - 360
  elseif !rotate.leq(-360) then
    !rotate = !rotate + 360
  endif
  if !rotate.lt(0) then
    !rotate = !rotate + 360
  endif

  !this.rotate = !rotate

endmethod


-- graphical dimension on/off
---------------------------------------------------------------------------------------------
define method .graphicalDim(!onOff is BOOLEAN,!aidNumber is REAL)

  -- clear existing dimension
  !!aidNumbers.hide(!aidNumber)


  if undefined(!this.rod[1]) then
    return error 1 'Unable to display dimension - template of this support is not properly defined!'
  endif

  if !this.heig.unset() then
    return error 1 'Unable to display dimension - template of this support is not properly defined!'
  endif

  -- hardcoded dimension parameters
  !spacing = 300mm
  !overShoot = 25mm


  if !onOff.not() then
    return
  endif

  !dimtxt = !this.gadgetHeig.tag
  handle ANY
    !dimtxt = 'Height'
  endhandle
  !rod = !this.rod[1]
  !numb = !aidNumber
  !dim = !this.heig
  !dimtxt = !dimtxt + ' (' + !this.heig.string(!!distanceFMT) + ')'
  !dimDir = !rod.zdir.opposite()
  if !dimDir.up.eq(-1) then
    !projDir = !this.yDir
    if !this.mirror then
      !projDir = !projDir.opposite()
    endif
  else
    !projDir = U
  endif

  -- compute dimensions
  !start = !rod.pose
  !end = !start.offset(!dimDir,!dim)
  !dimLine = object LINE(!start,!end)
  !dimLine = !dimLine.offset(!projDir,!spacing)
  !projLine[1] = object LINE(!start,!start.offset(!projDir,!spacing + !overShoot))
  !projLine[2] = object LINE(!end,!end.offset(!projDir,!spacing + !overShoot))
  -- compute end arrows
  !startArrowDir = !dimDir.opposite()
  !startArrow = !dimLine.startposition.offset(!dimDir,25mm)
  !endArrow = !dimLine.endposition.offset(!startArrowDir,25mm)

  -- compose dimension position
  !dimPos = !dimLine.proportion(0.5)

  -- get aid graphic colour
  !col = !!gphColOpt.aids.code
  -- draw proj. lines
  !projLine[1].draw(!numb,1,!col)
  !projLine[2].draw(!numb,1,!col)
  -- draw dimension line
  !dimLine.draw(!numb,1,!col)
  aid arrow number $!numb at $!startArrow direction $!startArrowDir height 25mm proportion 1
  aid arrow number $!numb at $!endArrow direction $!dimDir height 25mm proportion 1
  -- draw dimension
  aid text number $!numb |$!dimtxt| at $!dimPos

endmethod


-- method to delete support
----------------------------------------------------------------------------------------------------
define method .deleteSupp()

  !!ce = !this.light
  handle NONE
    :mdssref default
  elsehandle ANY
  endhandle

  !!ce = !this.stru
  delete STRU

  -- clear object
  !this.mdslsupport()

endmethod


-- return stru db reference
----------------------------------------------------------------------------------------------------
define method .getElemForUDA() is DBREF

  return !this.stru

endmethod
