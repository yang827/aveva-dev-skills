--
-- File:      mdsoptiondefs.pmlobj
--
-- Author:    Wayne Dodwell
-- Created:   Friday 22nd February 2006
--
--
--------------------------------------------------------------------------------
-- Type:      Object Definition
-- Group:     Multi Discipline Supports Application
-- Keyword:   MDS
-- Module:    DESIGN
--
--------------------------------------------------------------------------------
-- Description:
--
-- PML Object to determine the MDS Design Data etc... for the MDS DESIGN APPLICATION OPTIONS etc..
-- from the MDS12 DEFAULTS PARAGON CATALOGUE Database CONVERTED from the latest MDS11.6*
-- version of the MDS DEFAULTS FILE "%MDSDFLTS%/DES-SUPP-DEFS" from the MASTER PDMS
-- Project "MDS"
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  isHangerIfaceEnable(STRING)      BOOLEAN             Check hanger interface is enabled in Paragon by administrator
--  mdsoptiondefs()                  -
--  mdsoptionform()                  -
--  populateHangerIfaceOption()      -                   Fills option gadget on !!mdsOptions form with active and fully operational hanger interfaces
--
define object MDSOPTIONDEFS

  -- Overall MDS OPTION Check for the MDS DESIGN Application
  member .optioncheck is BOOLEAN

  -- MDSCONNMODS -- WARNING/ERROR/CONTINUE. This OPTION controls the
  -- ERROR Messages when MODIFYING a FRAMEWORK connected to PDMS SCTN(s)
  member .mdsconnmods  is STRING     $* -- ( ' WARNING' )

  -- MDSCONNS -- <1=NO Connections>, <2=Without GEOMETRY>, <3=With GEOMETRY> >
  member .mdsconns     is STRING     $* -- ( ' 3' )

  -- MDSFLAGAP -- Off/Inside/Outside -- ID1 and/or ID2
  -- The OFFSET is the VALUE represented in this OPTION
  -- Works ONLY in CURSOR MODE of MDS FRAMEWORK Creation etc...
  member .mdsflagap    is STRING     $* -- ( '0' )

  -- MDSFORMANC form LIST size control for !!mdsAnchor (Anchors)
  member .mdsformanc   is STRING     $* -- ( '10' )

  -- MDSFORMBRA form LIST size control for !!mdsBranRein (Branch Reinforcements)
  member .mdsformbra   is STRING     $* -- ( '6' )

  -- MDSFORMCAB form LIST size control for !!mdsCable (Cable Tray)
  member .mdsformcab   is STRING     $* -- ( '8' )

  -- MDSFORMFIX form LIST size control for !!mdsFhanger (Fixed and Variable Hangers)
  member .mdsformfix   is STRING     $* -- ( '10' )

  -- MDSFORMFRA form LIST size control for !!mdsFrame (Frameworks)
  member .mdsformfra   is STRING     $* -- ( '10' )

  -- MDSFORMGEN form LIST size control for !!mdsGeneral (Ancillaries)
  member .mdsformgen   is STRING     $* -- ( '10' )

  -- MDSFORMGUI form LIST size control for !!mdsGuide (Guides)
  member .mdsformgui   is STRING     $* -- ( '10' )

  -- MDSFORMHVA form LIST size control for !!mdsHvac (HVAC)
  member .mdsformhva   is STRING     $* -- ( '4' )

  -- MDSFORMSLI form LIST size control for !!mdsSlip (Slip Units)
  member .mdsformsli   is STRING     $* -- ( '10' )

  -- MDSFORMSPR form LIST size control for !!mdsSpring (Springs)
  member .mdsformspr   is STRING     $* -- ( '3' )

  -- MDSFORMTRU form LIST size control for !!mdsTrunn (Trunnions)
  member .mdsformtru   is STRING     $* -- ( '10' )

  -- MDSFORMVES form LIST size control for !!mdsVessel (Vessel)
  member .mdsformves   is STRING     $* -- ( '6' )

  -- MDSHANGIF Hanger Interface - <'MDS'=MDS STANDARD HANGHER TEMPLATES>
  -- Other OPTIONS for MANUFACTURERS HANGER INTERFACES are -- LISEGA, PSL or CPL
  member .mdsHangIfLisega is STRING
  member .mdsHangIfMDS is STRING
  member .mdsHangIfPSL is STRING
  member .mdsHangIfCPL is STRING
  member .mdsHangIf is STRING

  -- mdshangvfitt when using a hanger interface it is possible to create hangers on steel work that is write protected
  -- if this member is set enabled then this process can be used
  member .mdshangvfitt is STRING     $* -- ( 'ENABLED', 'DISABLED' )

  -- MDSLEVCHANGE LEVEL set to ALLOW Graphical Additions of
  -- DESIGN elements by their Drawing LEVEL Attribute
  member .mdslevchange is STRING     $* -- ( ' 7' )

  -- MDSMAXHANG Maximum HORIZONTAL angle up to the MDS application max of 45 degrees
  -- ***CHECK if STILL USED ***???????????????????????????????????????????????????????
  member .mdsmaxhang   is STRING     $* -- ( ' 30' )

  -- MDSMAXPIVA Maximum pivot angle for MDS HANGERS
  -- ***CHECK if STILL USED ***???????????????????????????????????????????????????????
  member .mdsmaxpiva   is STRING     $* -- ( ' 30' )

  -- MDSMINHANG Minimum distance from pivot to under side of the supporting steelwork
  -- MINIMUM ROD LENGTH for MDS INFO ONLY --
  -- ***CHECK if STILL USED ***???????????????????????????????????????????????????????
  member .mdsminhang   is STRING     $* -- ( ' 150' )

  -- MDSOFFSET The VALUE used by the MDS INTEGRITY Checker for CHECKING "JOINT ECCENTRICITY"
  -- This value should be increased when the MAIN STEELWORK SCTN SIZES are over 300 Deep
  member .mdsoffset    is STRING     $* -- ( ' 150' )

  -- MDSORINOT ISOMETRIC Orientation NOTE
  -- <TRUE = Show the SUPPORT TAG plus the Orientation> and <FALSE = Show ONLY the Support TAG>
  member .mdsorinot    is STRING     $* -- ( 'true' )

  -- MDSORIWRT ISOMETRIC Orientation WRT WORLD, SITE, ZONE etc... for Pipe Shoe ATTAS etc...
  -- Sets the ATTA STEX WRT WORLD, SITE, ZONE etc... for output in the ISODRAFT Piping ISOMETRIC
  member .mdsoriwrt    is STRING     $* -- ( 'WORLD' )

  -- MDSPACKDI Maximum allowable POSITIVE packing distance
  -- CLEARANCE between MDS SUPPORT and Supporting Steelwork
  member .mdspackdi    is STRING     $* -- ( ' 50' )'

  -- MDSPACKMO Maximum allowable NEGATIVE packing distance
  -- OVERLAP between MDS SUPPORT and Supporting Steelwork
  member .mdspackmo    is STRING     $* -- ( ' 5' )'

  -- MDSPIVWARN Angle to warn user of pivot angle for MDS HANGERS
  -- ***CHECK if STILL USED ***???????????????????????????????????????????????????????
  member .mdspivwarn   is STRING     $* -- ( ' 5' )'

  -- MDSSPECFLA MDS SPECIAL Support Number <TRUE=UNIQUE for EACH SPECIAL SUPPORT>
  -- <FALSE=NON UNIQUE for MDS SPECIAL Supports> -- FALSE is RECOMMENDED and the DEFAULT
  member .mdsspecfla   is STRING     $* -- ( ' false' )

  -- MDSSPECON <TRUE=STOPS user proceeding UNTIL a MDS SPECIAL NUMBER is ENTERED>
  -- <FALSE is the RECOMMENDED DEFAULT>
  member .mdsspecon    is STRING     $* -- ( ' false' )

  -- MDSSPECPRE MDS SPECIAL Support Number Prefix
  member .mdsspecpre   is STRING     $* -- ( ' SPS' )

  -- MDSSUPPCL Clearance between the MDS ANCILLARY GEOMETRY and ANY MDS FRAMEWORK SCTN
  -- or the POSSTART/POSEND of a SCTN, but ALL MDS Support elements MUST be on the "SAME" MDS SUPPORT
  member .mdssuppcl    is STRING     $* -- ( ' 100' )

  -- MDSSUPPMS Maximum allowable PIPING SLOPE from the horizontal for horizontal MDS supports
  member .mdssuppms    is STRING     $* -- ( ' 1/10' )

  -- MDSSUPPOV FRAMEWORK SCTN element OVERLAP
  member .mdssuppov    is STRING     $* -- ( ' 10' )

  -- MDSTRANISO TRANSPORTATION MDS SUPPORT PIPING ISOMETRIC STEXT appended
  -- to the MDS SUPPORT TAG also contained in the STEXT
  -- ('#/' = new line in text string)
  member .mdstraniso   is STRING     $* -- ( ' TRANSPORTATION#/SUPPORT' )

  -- MDSTRANPREF Transportation prefix to IDENTIFY a TRANSPORTATION MDS SUPPORT
  member .mdstranpref  is STRING     $* -- ( ' T' )

  -- MDSTRUNCODE Number of Characters to be Displayed on MDS TRUNNION Support CODES
  member .mdstruncode  is STRING     $* -- ( '5' )

  -- MDSTRUNNLEN Maximum Trunnion Length used ONLY by the DEPRECATED MDS TRUNNION types
  -- TT01, TT02 and TT03 -- NOT USED and therefore OBSOLETE at MDS12
  member .mdstrunnlen  is STRING     $* -- ( ' 600' )

  -- MDSTRUNNOTES SHOW<TRUE> or HIDE<FALSE> the STANDARD TRUNNION NOTE on the PIPING ISOMETRIC.
  -- i.e. "DO NOT CUT HOLE in PIPE, 6mm WEEP HOLE, FREE TO SLIDE"
  member .mdstrunnotes is STRING     $* -- ( ' true' )

  -- MDSWEITAG KEYWORD for WEIGHT Calculations -- "kgs" or "lbs"
  -- Defines the UNIT of WEIGHT displayed on the MDS ABA Drawings
  member .mdsweitag    is STRING     $* -- ( ' kgs' )

  -- MDSWEIUNIT Weight conversion factor KEYWORD for WEIGHT Calculations "kgs" or "lbs".
  -- ALL weights are stored in METRIC "kgs" -- Therefore set to 2.2046 for IMPERAIL "lbs"
  member .mdsweiunit   is STRING     $* -- ( ' 1' )

  -- MDS DATASET PDMS DISTANCE Conversion FACTOR (1 for METRIC or 25.4 for IMPERIAL UNITS)
  member .mpu          is STRING     $* -- ( ' 1' )


  --<wd>feb2006
  -- ADD the "ONLY" MDS12 ABA DRAFT Option from the DRA-SUPP-DEFS default file
  -- MDS ABA VIEW OVERLAP VALUE in Millimetres (mm)
  member .mdsviewolap  is STRING  $* -- ( ' 300' )
  --<wd>feb2006


  --<wd>21feb2006 - DUN858
  -- MDS FRAME BRACING Keyword -- Set to true if Bracing ATTAS are to be generated or false if no Bracing ATTAS required
  member .mdsframebracing  is STRING  $* -- ( 'true' )
  --<wd>21feb2006 - DUN858

  member .mdsautopads is STRING

  --<kp>apr2012 Unique naming (e.g. KKS) on/off MDSSIE04
  member .mdsuniquenames is STRING

  -- End object
endobject
--
--------------------------------------------------------------------------------
-- Constructor Method .mdsoptiondefs()
-- Arguments:
--
-- Return:
--
--------------------------------------------------------------------------------
-- Constructor Method
--
define method .mdsoptiondefs()

  --<kp>apr2012 MDSSIE04
  !this.mdsuniquenames = 'FALSE'
  -- Determine the PDMS Project MDS DESIGN APPLICATION OPTIONS
  !optioncata = /MDS/OPTION/DEFAULTS
  handle NONE
    -- Initialise the Collection Object data
    !type  = |DATA|
    !filt  = object EXPRESSION('DKEY eq |OPTN|')
    !scope = ARRAY()
    !scope.append(!optioncata)

    -- Collect ALL of the DESPARS DATA Elements
    !data  = object COLLECTION()
    !data.filter(!filt)
    !data.scope(!scope)
    !data.type(!type)

    -- Collection Results Array
    !results = !data.results()
    if (!results.size().gt(0)) then
      -- Process the MDS OPTION DATA elements !results Array
      -- SET ALL the Global Variables foe each of the MDS OPTION DESIGN Application "KEYWORDS"
      do !indx indices !results
        -- GET the MDS OPTION Global Variable Name
        !zxstr  = |!!| & !results[!indx].dtitl
        -- GET the MDS OPTION Global Variable Property Value
        !zzstr  = $!results[$!indx].pprop
        -- SET EACH of the MDS Application OPTION Global Variables
        $!zxstr = !zzstr.trim()
        -- SET EACH of the OBJECT Members with the SAME Property Value
        !obstr  = |$!results[$!indx].dtitl|
        !this.$!<obstr> = !zzstr.trim()
        handle (2,759)
          --handle an instance where the data item exists in MDS/APPDEFAULTS but not in the appware
          --this may happen when we are getting data into a service pack but will deliver the appware in a hotfix
        endhandle

        --q var !obstr
        --q var !this.$!<obstr>

      enddo

      -- SET the OBJECT Check Variable
      !optioncheck = TRUE

    else
      -- The MDS OPTION DESIGN Application DATA elements NOT found
      !optioncheck = FALSE

    endif

  elsehandle ANY
    -- The MDS OPTION CATA element NOT found
    !optioncheck = FALSE

  endhandle

  -- <jw> mar09 <P-17552> Extra check (!!mdsDesIsoFlag) that call has not come from !!isdRunIso - for displaying ISO drawings in Design module
  if defined(!!mdsDesIsoFlag) then
    !optioncheck = FALSE
    !!mdsDesIsoFlag.delete()
  endif
  -- <jw> mar09 <P-17552> END

  -- SET the Object Member .optioncheck
  !this.optioncheck = !optioncheck

  -- When in the PDMS DESIGN modul -- Load the MDS DESIGN Application Defaults FORM Gadgets on the FORM !!mdsOptions
  !sess = current session
  if (!sess.module().upcase().eq('DESIGN'))or (!sess.module().upcase().eq('OUTFITTING'))then
    if (!this.optioncheck) then
      !this.mdsoptionform()
    endif
  endif

endmethod
--
--------------------------------------------------------------------------------
--
-- LOAD the MDS DESIGN Application Defaults FORM Gadgets on the FORM !!mdsOptions
-- and the Child FORM !!mdsflangegaps initialised from the FORM !!mdsOptions
--
define method .mdsoptionform()

  -- SET an ARRAY of the Current OBJECT Members/OPTIONS
  !mdsOptions = !this.attributes()

  -- ONLY LOAD the FORM Gadgets on the FORM !!mdsOptions
  do !indx indices !mdsOptions
    if (!mdsOptions[!indx] eq |MDSSUPPCL|) then
      !stringval = !this.$!mdsOptions[$!indx]
      !!mdsOptions.clear.val = !stringval.real()
      skip

    elseif (!mdsOptions[!indx] eq |MDSSUPPOV|) then
      !stringval = !this.$!mdsOptions[$!indx]
      !!mdsOptions.overlap.val = !stringval.real()
      skip

    elseif (!mdsOptions[!indx] eq |MDSSUPPMS|) then
      !!mdsOptions.slope.val = !this.$!mdsOptions[$!indx]
      skip

    elseif (!mdsOptions[!indx] eq |MDSPACKDI|) then
      !stringval = !this.$!mdsOptions[$!indx]
      !!mdsOptions.packing.val = !stringval.real()
      skip

    elseif (!mdsOptions[!indx] eq |MDSPACKMO|) then
      !stringval = !this.$!mdsOptions[$!indx]
      !!mdsOptions.maxpack.val = !stringval.real()
      skip

    elseif (!mdsOptions[!indx] eq |MDSTRUNNLEN|) then
      !stringval = !this.$!mdsOptions[$!indx]
      !!mdsOptions.trunnlen.val = !stringval.real()
      !!mdsOptions.trunnlen.active = FALSE
      skip

    elseif (!mdsOptions[!indx] eq |MDSMAXHANG|) then
      !stringval = !this.$!mdsOptions[$!indx]
      !!mdsOptions.maxAng = !stringval.real()
      !!mdsOptions.pmaxang.val = 'Max. Pipe Angle      = $!!mdsOptions.maxAng'
      skip

    elseif (!mdsOptions[!indx] eq |MDSMAXPIVA|) then
      !stringval = !this.$!mdsOptions[$!indx]
      !!mdsOptions.maxPiva = !stringval.real()
      !!mdsOptions.pmaxpiva.val ='Max. Pivot Angle     = $!!mdsOptions.maxPiva'
      skip

    elseif (!mdsOptions[!indx] eq |MDSPIVWARN|) then
      !stringval = !this.$!mdsOptions[$!indx]
      !!mdsOptions.maxPwar = !stringval.real()
      !!mdsOptions.pmaxpwar.val = 'User Warning Angle   = $!!mdsOptions.maxPwar'
      skip

    elseif (!mdsOptions[!indx] eq |MDSMINHANG|) then
      !stringval = !this.$!mdsOptions[$!indx]
      !!mdsOptions.minhangrod = !stringval.real()
      !!mdsOptions.pminhangrod.val = !stringval.real()
      skip

    elseif (!mdsOptions[!indx] eq |MDSSPECPRE|) then
      !specPre = !this.$!mdsOptions[$!indx]
      !!mdsOptions.specPre = !specPre.string()
      !!mdsOptions.pspecpre.val = 'Special Num. Prefix  = $!!mdsOptions.specPre'
      skip

    elseif (!mdsOptions[!indx] eq |MDSTRANPREF|) then
      !tranPref = !this.$!mdsOptions[$!indx]
      !!mdsOptions.tranPref = !tranPref.string()
      !!mdsOptions.ptranpref.val = 'Transport Prefix     = $!!mdsOptions.tranPref'
      skip

    elseif (!mdsOptions[!indx] eq |MDSTRANISO|) then
      !trantext = !this.$!mdsOptions[$!indx]
      !trantext = !trantext.replace('#/','')
      !!mdsOptions.pptrantext.val = 'Transport Text       = '
      !!mdsOptions.ptrantext.val  = !trantext
      skip

    elseif (!mdsOptions[!indx] eq |MDSSPECFLA|) then
      !specopt = !this.$!mdsOptions[$!indx]
      !specfla = !specopt.boolean()
      !!mdsOptions.specfla = !specfla
      if (!!mdsOptions.specfla) then
        !!mdsOptions.pspecfla.val = 'Special Num. Unique  = Yes'
      else
        !!mdsOptions.pspecfla.val = 'Special Num. Unique  = No'
      endif
      skip

    elseif (!mdsOptions[!indx] eq |MDSCONNS|) then
      !conntype = !this.$!mdsOptions[$!indx]
      !!mdsOptions.createcons.select('RTEXT',!conntype)

    elseif (!mdsOptions[!indx] eq |MDSCONNMODS|) then
      !connmod = !this.$!mdsOptions[$!indx]
      !!mdsOptions.connmods.select('RTEXT',!connmod)
      skip

    elseif (!mdsOptions[!indx] eq |MDSAUTOPADS|) then
      !autopads = !this.$!mdsOptions[$!indx]
      !!mdsOptions.autopads.select('RTEXT',!autopads)
      skip

    elseif (!mdsOptions[!indx] eq |MDSLEVCHANGE|) then
      !stringval = !this.$!mdsOptions[$!indx]
      if (!stringval.eq('')) then
        !levChange = 7
      else
        !levChange = !this.$!mdsOptions[$!indx].real()
        handle any
          !levChange = 7
        endhandle
      endif
      !!mdsOptions.levChange      = !levChange
      !!mdsOptions.plevchange.val = 'Alternate Repr Level = ' + !levChange.string()
      skip

    elseif (!mdsOptions[!indx] eq |MDSOFFSET|) then
      !stringval = !this.$!mdsOptions[$!indx]
      !!mdsOptions.offset.val = !stringval.real()
      skip

    elseif (!mdsOptions[!indx] eq |MDSFLAGAP|) then
      -- LOAD the FORM Gadgets on the CHILD FORM !!mdsflangegaps
      !stringval = !this.$!mdsOptions[$!indx]
      !!mdsflangegaps.gap1.val = !stringval.real()
      !!mdsflangegaps.gap2.val = !stringval.real()
      skip

      --<kp>apr2012 MDSSIE04
    elseif !mdsOptions[!indx].eq('MDSUNIQUENAMES') then
      !!mdsOptions.mdsuniquenames = !this.attribute(!mdsOptions[!indx]).boolean()
    endif

  enddo


  -- Populate Hanger Interfaces option gadget
  !this.populateHangerIfaceOption()

  if !!mdsOptions.oHangerIface.rtext.find(!this.mdsHangIf).set() then
    !!mdsHangIf = !this.mdsHangIf
  else
    !!mdsHangIf = !!mdsOptions.oHangerIface.rtext.first()
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      isHangerIfaceEnable()
--
-- Description: Check hanger interface is enabled in Paragon by administrator
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#]   [R/RW] [Data Type] [Description]
--   !name  R      STRING      short name of interface
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     if enable return true
--
------------------------------------------------------------------------
define method .isHangerIfaceEnable(!name is STRING) is BOOLEAN

  return !this.mdsHangIf$!<name>.boolean()
  handle ANY
    return FALSE
  endhandle

endmethod

------------------------------------------------------------------------
--
-- Method:      populateHangerIfaceOption()
--
-- Description: Fills option gadget on !!mdsOptions form with active and fully operational hanger interfaces
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .populateHangerIfaceOption()

  !!mdsOptions.oHangerIface.clear()

  !dString = 'Licad\PSDesigner\Witchhanger\Standard MDS'
  !rString = 'LISEGA\PSL\CPL\MDS'

  !dText = !dString.split(|\|)
  !rtext = !rString.split(|\|)

  do !idx indexes !rtext
    skip if (!this.isHangerIfaceEnable(!rtext[!idx]))
    !rtext[!idx].delete()
    !dText[!idx].delete()
  enddo

  !!mdsOptions.oHangerIface.dText = !dText
  !!mdsOptions.oHangerIface.rtext = !rtext

  !!mdsOptions.oHangerIface.active = !rtext.size() ge 1

endmethod
