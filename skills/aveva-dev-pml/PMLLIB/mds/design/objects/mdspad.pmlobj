--
-- Description:
--    MDS pad object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdspad()                         -                   Constructor
--  mdspad(DBREF)                    -                   Constructor
--  modify()                         -                   Modify the current dbelement
--

------------------------------------------------------------------------

define object MDSPAD

  ---------- Element Attributes
  -- DB Element referenced
  member .dbElement       is DBREF

  -- number of despars
  member .numDespars is REAL
  -- Despar values
  member .despVal is ARRAY
  -- Despar descriptions
  member .despDesc is ARRAY
endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      mdspad
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdspad()

  -- Initialise Variables
  !this.dbElement         = object DBREF()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      mdspad
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .mdspad(!dbElement is DBREF)

  -- Load defaults
  !this.mdspad()

  -- Set db element
  !this.dbElement         = !dbElement

  !this.numDespars = !dbElement.desp.size()

  !collection       = object COLLECTION()
  !collection.scope(!dbElement.dtref)
  !collection.type('DATA')

  -- Get attributes of the element

  do !num from 1 to !this.numDespars

    !expression   = object EXPRESSION('number eq ' & !num )
    !collection.filter(!expression)

    !dataArray     = !collection.results()
    !data = !dataArray[1]
    --collect DATA for despar with number !num

    !this.despVal[!num] = !dbElement.desp[!num]

    !this.despDesc[!num] = !data.dtitle

  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: Modify the current dbelement
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modify()

  -- Set despars

  do !num from 1 to !this.numDespars
    if(!this.despVal[!num].set()) then
      !this.dbElement.desp[!num] = !this.despVal[!num]
    endif
  enddo

  --delete old pad and regenerate

  !join = !this.dbElement
  !spref = !this.dbElement.spref


  -- see which distance is greater, npos to sctn.endPos or sctn.startPos

  if !join.cend.eq('END') then
    !endPos = 'POSE'
    !endDir = 'DRNE'
    !sign = '+'
  else
    !endPos = 'POSS'
    !endDir = 'DRNS'
    !sign  = '-'
  endif

  -- Trim steel (if necessary)

  !sctn = !join.cref
  !end = !join.cend
  !!ce = !join.owner
  !npos = !!ce.npos
  rule delete all on all for ce
  delete $!!ce.type
  !!ce = !sctn
  extend $!end through $!npos recalculate

  !sctnName = !!ce.name

  new PNOD
  handle ANY
  elsehandle NONE
    do !i to 20
      name $!sctnName/pnod$!i
      handle ANY
        skip
      elsehandle NONE
        at $!endPos of prev sctn
        SET
        new pjoi
        Name */pjoi1
        !this.dbElement = !!ce
        break
      endhandle
    enddo
    --spref /End_Pad_for_Angle_Fitt
    spref $!spref
    gtype APAD
    jlin na
    cref  $!sctnName $!end

    !ref = !!ce
    !!ce = !this.dbElement

    !!ce.cutb = !this.despVal[2]

    rule set  cutplane dynamic $!endDir of cref
    rule set  opdir dynamic $!endDir of cref
    rule set  delp dynamic (e 0 n 0 u 0 )
    reconn
    -- set bang of join
    !!mdssetjoinbang(ce)

    -- set despars
    do !num from 1 to !this.numDespars
      if(!this.despVal[!num].set()) then
        !this.dbElement.desp[!num] = !this.despVal[!num]
      endif
    enddo

    pnod
    --rule set npos dynamic $!endPos of cref of 1
    rule set npos (e(comp e of $!endPos of cref of 1 wrt cref of 1) n(comp n of $!endPos of cref of 1 wrt cref of 1) u(comp u of $!endPos of cref of 1 wrt cref of 1 $!sign cutb of 1) wrt cref of 1)
    rule set npos dynamic

    !!ce = !ref

  endhandle

endmethod
-- End of method
