--
--
-- Description: PML2 Interface to pins
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clearBehind(DBREF,REAL)          POSITION
--  clearBehind(POSITION,REAL)       POSITION
--  clearInfront(DBREF,REAL)         POSITION
--  clearInfront(POSITION,REAL)      POSITION
--  connect(REAL)                    -
--  connect(REAL,DBREF)              -
--  copy(REAL)                       POINTVECTOR
--  copy(REAL,DBREF)                 -
--  direction()                      DIRECTION
--  direction(DIRECTION)             -
--  directionTo(LINE)                DIRECTION
--  directionTo(MDSPIN)              DIRECTION
--  directionTo(PLANE)               DIRECTION
--  directionTo(POSITION)            DIRECTION
--  directionTo(REAL)                DIRECTION
--  distance(REAL)                   POSITION
--  distanceTo(LINE)                 REAL
--  distanceTo(MDSPIN)               REAL
--  distanceTo(PLANE)                REAL
--  distanceTo(POSITION)             REAL
--  distanceTo(REAL)                 REAL
--  line(REAL)                       LINE
--  mdspin(REAL)                     -
--  mdspin(REAL,POSITION,DIRECTION)  -
--  off()                            -
--  on()                             -
--  plane()                          PLANE
--  pointvector()                    POINTVECTOR
--  position()                       POSITION
--  position(POSITION)               -
--  restore()                        -                   Restore pin state from member variables
--  save()                           -                   Save pin state in member variables
--  status()                         STRING
--  status(BOOLEAN)                  -
--  string()                         STRING
--  thru(LINE)                       POSITION
--  thru(MDSPIN)                     POSITION
--  thru(PLANE)                      POSITION
--  thru(POSITION)                   POSITION
--  thru(REAL)                       POSITION
--
define object MDSPIN

  member .number is REAL

  -- to save and restore pin status
  member .savedPos is POSITION

  member .savedDir is DIRECTION

  member .savedStatus is STRING

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]      [Description]
--
-- Return:
--   [Data Type]       [Description]
--
------------------------------------------------------------------------

define method .mdspin(!number is REAL)

  if !number.between(1,10).not() then
    return error 1 'Pin numbers must be in the range 1 to 10'
  endif

  !this.number = !number

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdspin(!number is REAL, !pos is POSITION, !dir is DIRECTION)

  !this.mdspin(!number)
  pin $!number dir $!dir
  pin $!number at $!pos
  !this.off()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position(!pos is POSITION)

  pin $!this.number at $!pos
  !this.off()

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .direction(!dir is DIRECTION)

  pin $!this.number dir $!dir
  !this.off()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .distance(!distance is REAL) is POSITION

  !pos = !this.position().offset(!this.direction(),!distance)
  !this.position(!pos)

  return !pos

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .thru(!pos is POSITION) is POSITION

  !unusedNewpos = !this.pointvector().through(!pos).position
  !this.position(!pos)

  return !pos

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .thru(!pin is REAL) is POSITION

  return !this.thru(object MDSPIN(!pin))

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .thru(!pin is MDSPIN) is POSITION

  return !this.thru(!pin.position())

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .thru(!plane is PLANE) is POSITION

  !pos = !this.pointvector().intersection(!plane)

  return !this.position(!pos)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .thru(!line is LINE) is POSITION

  !intersection = !this.pointvector().intersection(!line)

  return !this.thru(!intersection)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearBehind(!pos is POSITION, !clearance is REAL) is POSITION

  !pos = !this.thru(!pos)
  !this.distance(!clearance)

  return !this.position()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearInfront(!pos is POSITION, !clearance is REAL) is POSITION

  !pos = !this.thru(!pos)
  !this.distance(-!clearance)

  return !this.position()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearBehind(!item is DBREF, !clearance is REAL) is POSITION

  pin $!this.number clear $!clearance behind $!item
  !this.off()

  return !this.position()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearInfront(!item is DBREF, !clearance is REAL) is POSITION

  pin $!this.number clear $!clearance infront $!item
  !this.off()

  return !this.position()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copy(!pin is REAL) is POINTVECTOR

  pin $!this.number copy pin $!pin
  !this.off()

  return !this.pointvector()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copy(!ppoint is REAL, !item is DBREF)

  pin $!this.number copy p $!ppoint of $!item
  !this.off()

  return !this.pointvector()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .connect(!pin is REAL)

  pin $!this.number connect to pin $!pin
  !this.off()

  return !this.pointvector()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .connect(!ppoint is REAL, !item is DBREF)

  pin $!this.number connect to p $!ppoint of $!item
  !this.off()

  return !this.pointvector()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .status(!status is BOOLEAN)

  if !status then
    pin $!this.number
  else
    pin $!this.number off
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .on()

  !this.status(on)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .off()

  !status = off
  !status = defined(!!mdspinsalwayson)

  !this.status(!status)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .position() is POSITION

  var !pinpos pin $!this.number pos wrt world
  !pos = !pinpos.position()
  !pos.origin = world

  return !pos

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .direction() is DIRECTION

  var !pindir pin $!this.number dir wrt world
  !dir = !pindir.direction()
  !dir.origin = world

  return !dir

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .status() is STRING

  var!pin pin $!this.number

  return !pin.split().last()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .pointvector() is POINTVECTOR

  return object POINTVECTOR(!this.position(),!this.direction())

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .distanceTo(!pos is POSITION) is REAL

  return !this.position().distance(!pos)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .distanceTo(!pin is REAL) is REAL

  return !this.distanceTo(object MDSPIN(!pin))

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .distanceTo(!pin is MDSPIN) is REAL

  return !this.distanceTo(!pin.position())

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .distanceTo(!plane is PLANE) is REAL

  return !this.position().distance(!plane)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .distanceTo(!line is LINE) is REAL

  return !this.position().distance(!line)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .directionTo(!pos is POSITION) is DIRECTION

  return !this.position().direction(!pos)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .directionTo(!line is LINE) is DIRECTION

  !near = !line.near(!this.position())

  return !this.directionTo(!near)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .directionTo(!plane is PLANE) is DIRECTION

  !near = !plane.near(!this.position())

  return !this.directionTo(!near)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .directionTo(!pin is REAL) is DIRECTION

  return !this.directionTo(object MDSPIN(!pin))

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .directionTo(!pin is MDSPIN) is DIRECTION

  return !this.directionTo(!pin.position())

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .plane() is PLANE

  return !this.pointvector().plane()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .line(!dist is REAL) is LINE

  return !this.pointvector().line(!dist)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .string() is STRING

  if !this.number.unset() then
    return !this.objecttype()
  endif

  return 'PIN ' & !this.number & '  Direction ' & !this.direction() & '  Position ' & !this.position() & ' Pin ' & !this.status()

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      save
--
-- Description: Save pin state in member variables
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .save()

  !this.savedPos = !this.position()
  !this.savedDir = !this.direction()
  !this.savedStatus = !this.status()

endmethod


------------------------------------------------------------------------
--
-- Method:      restore
--
-- Description: Restore pin state from member variables
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .restore()

  if (unset(!this.savedPos) or unset(!this.savedDir) or unset(!this.savedStatus)) then
    return
  endif
  pin $!this.number at $!this.savedPos
  pin $!this.number dir $!this.savedDir
  if (!this.savedStatus.upcase() eq 'OFF') then
    !this.off()
  endif
endmethod
