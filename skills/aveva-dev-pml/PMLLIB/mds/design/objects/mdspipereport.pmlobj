-- Define Object
define object mdspipereport
-- Support Members

member .support is dbref
member .datum is dbref
member .supportnumber is STRING
member .type is STRING
member .docnumber is STRING
member .MOMstatus is STRING
member .PosNumFix is BOOLEAN
member .Page is STRING
member .ConstructionType is STRING
member .Spec is STRING
member .SCSUpport is STRING
member .SCRCCMCode is STRING
member .roomnumber is STRING
member .mtoarea is STRING

-- Pipe members
member .Pipe is dbref
member .PipePosNum is STRING
member .KKS is STRING
member .Suppfunction is STRING
member .QC is STRING
member .SC is STRING
member .NominalBore is STRING
member .Nodenum is STRING
member .StressCalcNum is STRING
-- Item members
member .ItemList is ARRAY
member .Rest is dbref
member .Hanger is dbref
member .PositionNum is STRING
member .Quantity is STRING
member .Length is STRING
member .Width is STRING
member .TypeNum is STRING
member .Description is STRING
member .HangerConfig is STRING
member .Material is STRING
member .MaterailTestSheet is STRING
member .Weight is STRING
member .PipeRef is STRING
member .Forces is STRING
member .PipeClampLoads is STRING
member .PipeConfigLoads is STRING
member .SpringRate is STRING
member .PresetLoad is STRING
member .SclampOri is STRING

member .pipelist is ARRAY
member .outputline is STRING
member .outputdata is ARRAY
member .headingline is STRING
member .headingdata is ARRAY
member .subreps is ARRAY
member .mdsvprmmtoobj is mdsvprmmto
endobject

-- main constructor method for reporting on pipe support
--------------------------------------------------------------------------------
define method .mdspipereport(!support is dbref)

  if !Support.name.matchwild('*[*]') then
    if !Support.name.match('[1]').gt(1) then
    else
      !mastername = !Support.Name.before('[') & '[1]'
      return error 1 |$!Support.name Ignored. Master support group $!mastername to be run|
    endif
  endif

  !type = !support.type
  if (!support.type.eq('STRU')  ) then
    !this.support = !support
    !datum = !support.name & '/DATUM'
    !this.datum = !datum.dbref()
    !this.pipe = !this.datum.owner.owner
    !this.mtoarea = !this.datum.:MTOAREA
  elseif (!support.type.eq('ATTA') and !support.stype.eq('MH01')) then
    -- hanger
    !this.support = !support
    !this.datum = !support
    !this.rest = !support.cref.owner
    !this.hanger = !support.cref
    !this.pipe = !support.owner.owner
    !this.mtoarea = !support.:MTOAREA
  elseif (!support.type.eq('ATTA')) then
    !this.support = !support
    !this.pipe = !support.owner.owner
    !this.datum = !support
    !this.mtoarea = !support.:MTOAREA

  else
    !!alert.error('Cannot get to a support from this level')
    return
  endif

  -- Get support data from mdsvprmmto object
  !this.mdsvprmmtoobj = object mdsvprmmto(!this.support)

  -- set the support name
  !this.getname()
--!!dtf = !this.mdsvprmmtoobj
  -- Get support data
-- mjb >>> 07.03.06 !this.getsupportdata() moved to after when !this.pipelist defined
  --!this.getsupportdata()
-- mjb <<< end of mod

  -- get the room number
  !this.getroomnumber()

  -- set the type of support
  if !this.gettype().not() then
    !this.outputline = !this.supportnumber & ' is incorrectly defined'
    return
  endif

  -- Checks its a multiple support get attas
  do !atta values !this.mdsvprmmtoobj.attadbrf
    if !atta.dbref().stype.eq('PIPE-REST') then
       skip
    else
      !this.pipelist.append(!atta.dbref())
    endif
  enddo
  -- Check if group support and has hangers if so add atta to pipelist
  do !hangerelem values !this.mdsvprmmtoobj.hangmemb[2]
    if !hangerelem.dbref().owner.type.eq('HANG') and !hangerelem.dbref().owner.href.type.eq('ATTA')then
     if !this.pipelist.findfirst(!hangerelem.dbref().owner.href).unset() then
        !this.pipelist.append(!hangerelem.dbref().owner.href)
      endif
    endif
  enddo
-- mjb >>> 07.03.06 !this.getsupportdata() moved to after when !this.pipelist defined
  !this.getsupportdata()
-- mjb <<< end of mod

  --  Get pipe data from drawing pipelist
  --if !this.mdsvprmmtoobj.mdsgroup then
    !pipedata = !!mdsgetpipelistdata(!this.mdsvprmmtoobj.allmem)
  --else

  --endif
  !PipeseqAr = !pipedata[1]
  !PipeAtexAr = !pipedata[2]
  !PipeddnaAr = !pipedata[3]
  -- Build object list for attached pipes
  do !II values !this.pipelist
    !posnum  = !PipeddnaAr.find(!II.string())
    if  !posnum.unset() then
      skip
    endif
    --!this.subreps.append( object mdspipereport(!II, !II.type, !posnum[1]))
    --!tempobj = object mdspipereport(!II, !II.type, !posnum[1])
    !this.subreps[!posnum[1]] = object mdspipereport(!II, !II.type, !posnum[1])
  enddo

   !classarray  = !!mdsfragettext(!this.mdsvprmmtoobj,'SC')

   !this.mdsvprmmtoobj.qualityclass = !classarray[1]
   !this.mdsvprmmtoobj.safetyclass  = !classarray[2]

  -- get mdspartlistdata

   !returnarray = !!mdsgetpartlistdata(!this.mdsvprmmtoobj.allmem, !this.mdsvprmmtoobj.safetyclass, !this.mdsvprmmtoobj.support.name)
   !DdnmAr = !returnarray[1]
   !AtexAr = !returnarray[2]
   !posnumAr = !returnarray[3]
--   q var !ddnmar
--   q var !atexar

  -- Build object list for support members
  --!postionnumber = 1

  do !I indices !ddnmar
    --if !ddnmAr[!i].dbref().type.neq('HANG') then
      !postionnumber = !posnumAr[!i]
      !this.itemlist.append( object mdspipereport(!Support ,!AtexAr[!i] ,!ddnmAr[!i].dbref() , !postionnumber ) )
    --endif
    --!postionnumber =  !postionnumber + 1
  enddo

  -- compile and output the report
  !this.outputdata('SUPPORT')
  !this.outputheader('SUPPORT')

endmethod
--------------------------------------------------------------------------------
-- secondary constructor method for reporting on pipe support not datum
--------------------------------------------------------------------------------
define method .mdspipereport(!support is dbref, !type is STRING , !posnum is real )
  !this.support = !support
  !this.PipePosNum = !posnum.string()
  if (!support.type.eq('STRU')  ) then
    !this.support = !support
    !datum = !support.name & '/DATUM'
    !this.datum = !datum.dbref()
    !this.pipe = !this.datum.owner.owner
    var !coll coll all sctn for $!this.support
  elseif (!support.type.eq('ATTA') and !support.stype.eq('MH01')) then
    -- hanger
    !this.datum = !support
    !this.rest = !support.cref.owner
    !this.pipe = !this.datum.owner.owner
  elseif (!support.type.eq('ATTA') ) then
    !this.datum = !support
    !this.pipe = !this.datum.owner.owner

  endif

  -- set the support name
  !this.getname()

  -- Get pipe data
  !this.getpipedata()



endmethod
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Third constructor method for reporting on support members
--------------------------------------------------------------------------------
define method .mdspipereport(!support is dbref, !Values is STRING , !Element is dbref , !PositionNumber is real)

  !this.support = !support
  !this.PositionNum = !PositionNumber.string()
  --!element.type
  if !element.owner.owner.type.eq('REST')  then
    -- hanger
    !this.rest = !element.owner.owner
    !this.datum = !element.owner.href
    -- dtf long winded but it gets hanger 2 & hanger 1
    !this.pipe = !element.owner.owner.member[1].href.owner.owner
    --!this.pipe = !element.owner.href.owner.owner
  elseif !element.type.eq('HANG') then
    -- hanger
    !this.rest = !element.owner
    !this.datum = !element.href
    -- dtf long winded but it gets hanger 2 & hanger 1
    !this.pipe = !element.owner.member[1].href.owner.owner
  elseif !element.eq(!this.support) then
    !this.datum = !this.support
    !this.pipe = !this.datum.owner.owner
  else
   !datum = !support.name & '/DATUM'
    !this.datum = !datum.dbref()
    !this.pipe = !this.datum.owner.owner
  endif



  -- set the support name
  !this.getname()

  -- Get Miscellaneous data
  !this.getmiscdata(!Element, !values )


endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to output the line data
define method .outputdata(!type is STRING)


  !Suppoutputline = !this.supportnumber
  !Suppoutputline =  !Suppoutputline & ';' & !this.docnumber
  !Suppoutputline =  !Suppoutputline & ';' & !this.MOMstatus
  !Suppoutputline =  !Suppoutputline & ';' & !this.PosNumFix
  !Suppoutputline =  !Suppoutputline & ';' & !this.Page
  !Suppoutputline =  !Suppoutputline & ';' & !this.ConstructionType
  !Suppoutputline =  !Suppoutputline & ';' & !this.Spec

-- mjb >>> 23.02.06 safety class corrected
  --!Suppoutputline =  !Suppoutputline & ';' & !this.SCSUpport
  !Suppoutputline =  !Suppoutputline & ';' & !this.mdsvprmmtoobj.safetyclass
-- mjb <<< end of mod

  !Suppoutputline =  !Suppoutputline & ';' & !this.SCRCCMCode
  !Suppoutputline =  !Suppoutputline & ';' & !this.roomnumber
  !Suppoutputline =  !Suppoutputline & ';' & !this.mtoarea

  !this.outputline = !Suppoutputline
  !this.outputdata.append('Support Header Infomation')
  !this.outputdata.append(!Suppoutputline)



  do !I from 1 to !this.pipelist.size()
    if !i.eq(1) then
      !this.outputdata.append('Pipe Header Infomation')
    endif

    !Pipeoutputline =  !this.subreps[!i].PipePosNum
    !Pipeoutputline =  !Pipeoutputline & ';' & !this.subreps[!i].KKS
    !Pipeoutputline =  !Pipeoutputline & ';' & !this.subreps[!i].Suppfunction
    !Pipeoutputline =  !Pipeoutputline & ';' & !this.subreps[!i].QC
    !Pipeoutputline =  !Pipeoutputline & ';' & !this.subreps[!i].SC
    !Pipeoutputline =  !Pipeoutputline & ';' & !this.subreps[!i].NominalBore
    --!Pipeoutputline =  !Pipeoutputline & ';' & !this.subreps[!i].Nodenum
    --!Pipeoutputline =  !Pipeoutputline & ';' & !this.subreps[!i].StressCalcNum
    !this.outputline = !Pipeoutputline
    !this.outputdata.append(!Pipeoutputline)
  enddo



  do !i from  1 to !this.itemlist.size()
    if !i.eq(1) then
      !this.outputdata.append('Item Infomation')
    endif
    !Itemoutputline =  !this.itemlist[!i].PositionNum
    !Itemoutputline =  !Itemoutputline & ';' & !this.itemlist[!i].Quantity
    !Itemoutputline =  !Itemoutputline & ';' & !this.itemlist[!i].Length
    !Itemoutputline =  !Itemoutputline & ';' & !this.itemlist[!i].Width
    !Itemoutputline =  !Itemoutputline & ';' & !this.itemlist[!i].TypeNum
    !Itemoutputline =  !Itemoutputline & ';' & !this.itemlist[!i].Description
    !Itemoutputline =  !Itemoutputline & ';' & !this.itemlist[!i].HangerConfig
    !Itemoutputline =  !Itemoutputline & ';' & !this.itemlist[!i].Material
    !Itemoutputline =  !Itemoutputline & ';' & !this.itemlist[!i].MaterailTestSheet
    !Itemoutputline =  !Itemoutputline & ';' & !this.itemlist[!i].Weight
    !Itemoutputline =  !Itemoutputline & ';' & !this.itemlist[!i].PipeRef
    !Itemoutputline =  !Itemoutputline & ';' & !this.itemlist[!i].Forces
    !Itemoutputline =  !Itemoutputline & ';' & !this.itemlist[!i].PipeClampLoads
    !Itemoutputline =  !Itemoutputline & ';' & !this.itemlist[!i].PipeConfigLoads
    !Itemoutputline =  !Itemoutputline & ';' & !this.itemlist[!i].SpringRate
    !Itemoutputline =  !Itemoutputline & ';' & !this.itemlist[!i].PresetLoad
    !Itemoutputline =  !Itemoutputline & ';' & !this.itemlist[!i].SclampOri
    !this.outputline = !Itemoutputline
    !this.outputdata.append(!Itemoutputline)
  enddo

    --endif
  label /print
  !!ce = !this.support

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to output the line data for the whole tray
-- input parameter is either 'PRINT' to print it to the command line
-- or a filename
define method .outputheader(!type is STRING )


    !Suppoutputline = 'Name'
    !Suppoutputline = !Suppoutputline & ';' & 'Document No'
    !Suppoutputline = !Suppoutputline & ';' & 'MOM Status'
    !Suppoutputline = !Suppoutputline & ';' & 'Position Number Fixing'
    !Suppoutputline = !Suppoutputline & ';' & 'Page'
    !Suppoutputline = !Suppoutputline & ';' & 'Construction Type'
    !Suppoutputline = !Suppoutputline & ';' & 'Specification'
    !Suppoutputline = !Suppoutputline & ';' & 'SC-Support'
    !Suppoutputline = !Suppoutputline & ';' & 'SC-RCCM Code'
    !Suppoutputline = !Suppoutputline & ';' & 'Room No.'
    !Suppoutputline = !Suppoutputline & ';' & 'Erection Area'
    !this.headingline = !Suppoutputline
    !this.headingdata.append(!Suppoutputline)


  do !I from 1 to !this.pipelist.size()
    !Pipeoutputline = 'Pipe Position Number'
    !Pipeoutputline = !Pipeoutputline & ';' & 'KKS of Pipe'
    !Pipeoutputline = !Pipeoutputline & ';' & 'Support Function'
    !Pipeoutputline = !Pipeoutputline & ';' & 'QC of Pipe'
    !Pipeoutputline = !Pipeoutputline & ';' & 'SC of Pipe'
    !Pipeoutputline = !Pipeoutputline & ';' & 'DN'
    --!Pipeoutputline = !Pipeoutputline & ';' & 'Node-No.'
    --!Pipeoutputline = !Pipeoutputline & ';' & 'Stress Calc. No.'
    !this.headingline = !Pipeoutputline
    !this.headingdata.append(!Pipeoutputline)
  enddo

  do !i from  1 to !this.itemlist.size()
    !Itemoutputline = 'Position Number'
    !Itemoutputline = !Itemoutputline & ';' & 'Quantity'
    !Itemoutputline = !Itemoutputline & ';' & 'Length'
    !Itemoutputline = !Itemoutputline & ';' & 'Width'
    !Itemoutputline = !Itemoutputline & ';' & 'Type-No'
    !Itemoutputline = !Itemoutputline & ';' & 'Description'
    !Itemoutputline = !Itemoutputline & ';' & 'Config Type'
    !Itemoutputline = !Itemoutputline & ';' & 'Material'
    !Itemoutputline = !Itemoutputline & ';' & 'Material Test Sheet'
    !Itemoutputline = !Itemoutputline & ';' & 'Weight'
    !Itemoutputline = !Itemoutputline & ';' & 'Reference'
    !Itemoutputline = !Itemoutputline & ';' & 'Forces'
    !Itemoutputline = !Itemoutputline & ';' & 'Pipe Clamp Load'
    !Itemoutputline = !Itemoutputline & ';' & 'Hanger Load'
    !Itemoutputline = !Itemoutputline & ';' & 'Spring Rate'
    !Itemoutputline = !Itemoutputline & ';' & 'Preset Load'
    !Itemoutputline = !Itemoutputline & ';' & 'Orientation'

    !this.headingline = !Itemoutputline
    !this.headingdata.append(!Itemoutputline)
  enddo

  label /print
  --
  !!ce = !this.support

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .getoutput(!heading is BOOLEAN)is ARRAY
 !return = ARRAY()
 if !this.subreps.size().gt(99999999999) then
    do !a values !this.subreps
      !return.appendarray(!a.getoutput(!heading))
    enddo
 else
   if !heading then
    return error 1 |Cannot add header to Pipe Report|
     do !a index !this.outputdata
       !templines[1] = !this.headingdata[!a]
       !templines[2] = !this.outputdata[!a]
       !return.appendarray(!this.formatheadings(!templines,'L'))
     enddo
   else
     !return = !this.outputdata
   endif
 endif
 return !return

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to take 2 lines separated by '|' and line the data up
-- justification not yet implemented
define method .formatheadings(!lines is ARRAY,!just is STRING)is ARRAY

  if !lines[1].split(';').size().neq(!lines[2].split(';').size()) then
    !size1 = !lines[1].split(';').size()
    !size2 = !lines[2].split(';').size()
    !!alert.error('Error in Format line')
    return !lines
  else
    !topline = !lines[1].split(';')
    !bottomline = !lines[2].split(';')
    do !a index !topline
      if !topline[!a].length().gt(!bottomline[!a].length()) then
        do !b from !bottomline[!a].length() to !topline[!a].length() - 1
           !bottomline[!a] = !bottomline[!a] & ' '
        enddo
      elseif !bottomline[!a].length().gt(!topline[!a].length()) then
        do !b from !topline[!a].length() to !bottomline[!a].length() - 1
           !topline[!a] = !topline[!a] & ' '
        enddo
      endif
    enddo

    !return[1] = ''
    !return[2] = ''

    -- now rebuild the line into its original format
    do !a index !topline
      !return[1] =  !return[1] & !topline[!a] & ';'
      !return[2] =  !return[2] & !bottomline[!a] & ';'
    enddo
  endif

return !return

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .getsupportdata()
  !this.docnumber = 'FIN005-D-' & !this.supportnumber
  !this.MOMstatus = !this.support.:MMSSTATUS
  handle ANY
    !this.MOMstatus = |MOMStatus|
  endhandle
  !this.PosNumFix = FALSE

  !this.Page      = |1|
  if !this.datum.:MDSconfig.upcase().eq('UNSET') then
    !this.ConstructionType = 'FIN005-C-' & !this.supportnumber
  else
    !this.ConstructionType = !this.datum.:MDSconfig
  endif

  !this.Spec =  !!MdsFraGetText(!this,'SPEC')
  !this.SCSupport  = !!MdsFraGetText(!this,'SC')
  !this.SCRCCMCode = !!MdsFraGetText(!this,'RCCM')

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .getpipedata()

--  !this.PipePosNum = |xxx|
  !this.KKS = !this.pipe.namn
  !this.Suppfunction = !this.datum.:MDSSuppFunc

  --!this.Qc = !this.pipe.:FRA.QCL
  !piperef = !this.pipe
  !this.QC = :FRA.QCL of $!Piperef
  handle ANY
    !this.QC = !this.Pipe.duty
  endhandle
  --!this.SC = !this.pipe.:FRA.SCL
  !this.SC = :FRA.SCL of $!Piperef
  handle ANY
    !this.SC = !this.Pipe.function
  endhandle
  !this.NominalBore = !this.datum.prop.NB
  !this.Nodenum = !this.datum.:MDSNodeNO
  !this.StressCalcNum = !this.datum.:MDSCalcNo


endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .getmiscdata(!Element is dbref, !Values is STRING )

  !split = !values.split('\')

  !this.Quantity = !split[1]
  !this.Description = !split[2]
  !this.TypeNum = !split[4]
  !this.Length = !split[5]
  !this.Width = !split[6]
  !this.Material = !split[7]
  !this.MaterailTestSheet = !split[8]
  !this.Weight = !split[9]

  --!this.PositionNum = |xxx|
  !this.PipeRef = |xxx|
  !this.HangerConfig= ||
  !this.Forces = |xxx|
  !this.PipeClampLoads = |xxx|
  !this.PipeConfigLoads = |xxx|
  !this.SpringRate = |xxx|
  !this.PresetLoad = |xxx|
  !this.SclampOri = ||

  if !this.Rest.set() then
  --if !element.owner.owner.type.eq('REST') then

    !this.HangerConfig = !this.Rest.:USTHCFGKEY.replace('.','')
    !this.Forces = !this.Rest.:USTFORCES[1] & | | & !this.Rest.:USTFORCES[2] & | | & !this.Rest.:USTFORCES[3] & | | & !this.Rest.:USTFORCES[4]
    !this.PipeClampLoads = !this.Rest.:USTLISCATCLV[1] & | | & !this.Rest.:USTLISCATCLV[2] & | | & !this.Rest.:USTLISCATCLV[3] & | | & !this.Rest.:USTLISCATCLV[4]
    !this.PipeConfigLoads = !this.Rest.:USTLISCATLGV[1] & | | & !this.Rest.:USTLISCATLGV[2] & | | & !this.Rest.:USTLISCATLGV[3] & | | & !this.Rest.:USTLISCATLGV[4]
    !tension = !element.prop.tens
    handle ANY
      !spref = !element.spref
      handle ANY
        !this.SpringRate = ||
        !this.PresetLoad = ||

      elsehandle NONE
        if !element.spref.name.matchwild('*/20????') or !element.spref.name.matchwild('*/21????') or !element.spref.name.matchwild('*/79??5?-*') then
          !this.SpringRate = !this.Rest.:USTSPRRATE.string()
          !this.PresetLoad = !this.Rest.:USTSTATLOAD.string()
        else
          !this.SpringRate = ||
          !this.PresetLoad = ||
        endif
      endhandle
    elsehandle NONE
      !this.SpringRate = !this.Rest.:USTSPRRATE.string()
      !this.PresetLoad = !this.Rest.:USTSTATLOAD.string()
    endhandle
    if !element.type.eq('SCLA') then
      !pipeori = !!mdsremovegrad(!this.datum)[1]
      handle ANY
        !datumldir = !this.datum.ldir.wrt( /* ).string().before(' WRT')
        !split = !datumldir.split(' ')
        if !split.size().eq(5) then
          !pipeoristr = !split[1] &  ' ' & split[2] & ' ' !split[3]
        elseif !split.size().eq(3) then
          !pipeoristr =  !split[1]
        else
          !pipeoristr = !split[1]
        endif
        !pipeori = !pipeoristr.direction()
      endhandle
--      q var !pipeori
      !sclaori = !element.pdir[1]
      if !pipeori.eq(!sclaori) or !pipeori.eq(!sclaori.opposite()) then
        !this.SclampOri = |0|
      else
       !this.SclampOri = |90|
      endif
    elseif !element.type.eq('WPAD') then
      -- WPAD
      !this.HangerConfig= ||
      !this.Forces = ||
      !this.PipeClampLoads = ||
      !this.PipeConfigLoads = ||
      !this.SpringRate = ||
      !this.PresetLoad = ||
    endif
    !this.PipeRef = !this.pipe.namn

  elseif !Element.type.eq('SCTN') then
    !this.HangerConfig= ||
    !this.Forces = ||
    !this.PipeClampLoads = ||
    !this.PipeConfigLoads = ||
    !this.SpringRate = ||
    !this.PresetLoad = ||
    !this.SclampOri = ||
    !this.PipeRef = ||

  elseif !Element.type.eq('ATTA') then
    -- Ancillary
    !this.HangerConfig= ||
    --!this.typenum = !element.prop.code
    !this.Forces = ||
    !this.PipeClampLoads = ||
    !this.PipeConfigLoads = ||
    !this.SpringRate = ||
    !this.PresetLoad = ||
    !this.SclampOri = ||

    !this.PipeRef = !element.owner.owner.namn

  elseif !element.type.eq('HANG') then
    -- Nuts
    !this.PipeRef = !this.pipe.namn
    !this.HangerConfig= ||
    !this.Forces = ||
    !this.PipeClampLoads = ||
    !this.PipeConfigLoads = ||
    !this.SpringRate = ||
    !this.PresetLoad = ||
    !this.SclampOri = ||

   elseif !Element.type.eq('PJOI') or !Element.type.eq('SJOI') then
     if !Element.gtype.eq('COMB') or !Element.gtype.eq('BEAR') then
        --loop through ancillary to see which one referencing it
        !this.piperef = ||
        do !I values !mdsvprmmtoobj.attamemb[2]
          if !I.dbref().:MDSplate.eq(!element) then
            !this.PipeRef = !I.dbref().owner.owner.Namn
            break
          else
            !this.PipeRef = ||
          endif
        enddo
     else
       !this.PipeRef = ||
     endif

    !this.Forces = ||
    !this.PipeClampLoads = ||
    !this.PipeConfigLoads = ||
    !this.SpringRate = ||
    !this.PresetLoad = ||

   else
   $P Type not recognised to be coded
  endif

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .getname()

   if !this.support.namn.matchwild('*[*]') then
     !this.supportnumber = !this.support.namn.before('[')
   else
     !this.supportnumber = !this.support.namn
   endif
   !this.outputline = !this.supportnumber

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .gettype() is BOOLEAN

   !type =!this.support.:MDSProjSpec.description.split(' ')[1]
   handle ANY
    !type =!this.support.:MDSsupptype
   endhandle
   !this.type = !type
   return TRUE
endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .getroomnumber()

  --if !this.support.type.neq('SCTN') then
    !!ce = !this.support
    !Suppname = !this.support.name

   !Roomnumber = :FRA.ROOM_KKS of $!SuppName
      handle ANY
        !Roomnumber = :MDSSuppFunc of $!SuppName
        handle ANY
            !Roomnumber = :FRA.ROOM_KKS of $!SuppName/DATUM
              handle ANY
                !Roomnumber = :MDSSuppFunc of $!SuppName/DATUM
              elsehandle NONE
            endhandle
        endhandle
      endhandle

    --frmw 1
   --- var !roomnumber :FRA.ROOM_KKS
    --  handle ANY
    --    !roomnumber = '0000'
    --  endhandle
    !this.roomnumber = !roomnumber
  --else
  --  !!ce = !this.support
  --  frmw
  --  var !roomnumber :FRA.ROOM_KKS
  --  !this.roomnumber = !roomnumber
  --endif

  if !this.roomnumber.match('/').eq(1) then
    !this.roomnumber = !this.roomnumber.after('/')
  else
    !this.roomnumber = 'unset'
  endif
  --if !this.roomnumber eq |unset| then
    --!this.roomnumber = ||
  --endif

endmethod
