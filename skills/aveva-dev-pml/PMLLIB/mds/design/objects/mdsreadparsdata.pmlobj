--------------------------------------------------------------------------------
--
--   Replaces:          MDS11.6 version of the MDS Ancillary Data GLOBAL ARRAY VARIABLES,
--                      and the Structure Data GLOBAL ARRAY VARIABLES for "a few" MDS STRUCTURE
--                      FRAMEWORK STANDARDS ONLY, e.g. "GT09, GT10, VT07, VT21" etc..., with entries in the
--                      original MDS11.6 "DES-SUPP-PARS" Defaults file.
$* ***********************************************************************
$* ***********************************************************************
-- **********************
-- *** IMPORTANT NOTE *** "VT07 to VT19" are Client Specific and ONLY exist in the Client "DES-SUPP-PARS"
--                        defaults file and they MAY/MAY NOT need to be UPGRADED.
-- *** What about their MDS APPWARE files??? ***
-- *** Neale is CHECKING and will let me know!! *** <wd>02may2006 ***
$* ***********************************************************************
$* ***********************************************************************
-- **********************
--                      e.g.
--                      !!mdsparat01, !!mdsparat12, !!mdspargt09, !mdsparvt21 etc...,
--                      which represent the MDS ANCILLARY/STRUCTURE BORE SIZE OBJECTS
--                      with the existing PML OBJECT "mdsshoe.pmlobj".
--
--------------------------------------------------------------------------------
--                      Typical Data for the MDS ANCILLARY !!mdsparat01 is shown below:
--                      e.g. -- q var !!mdsparat01
--                      <ARRAY>
--                      [0]  <MDSSHOE> MDSSHOE
--                      ...
--                      ... <---{Plus ALL of the Intermediate Bore Sizes}
--                      ...
--                      [500] <MDSSHOE> MDSSHOE
--
------------------------
--                      Typical Data for !!mdsparat01[100] is shown below:
--                      e.g. -- q var !!mdsparat01[100]
--                      <MDSSHOE> MDSSHOE
--                         SHOP <BOOLEAN> TRUE
--                         ALTDESPARS <ARRAY> 2 Elements
--                         ALTEXPR <STRING> '(DESP[5] gt 100)'
--                         USERDPS <ARRAY> 2 Elements
--                         VENDOR <STRING> 'C&P Fig.381'
--                         MATERIAL <STRING> '2,5'
--                         DESPARS <ARRAY> 15 Elements
--                         WEIGHT <REAL> Unset
--                         WELDSIZE <STRING> ''
--                         PIPEMATERIAL <STRING> ''
--                         VPRM <STRING> '2,5'
--                         RODS <ARRAY> 0 Elements
--                         MATREF <STRING> ''
--
--------------------------------------------------------------------------------
-- Description:
--
-- PML Object to determine the MDS Design Data etc... for the MDS Ancillary Standards,
-- and in a few cases for the MDS Structure Standards, <GT09, GT10, VT20, VT21 etc...>
-- from the MDS12 DEFAULTS PARAGON CATALOGUE Database CONVERTED from the latest MDS11.6*
-- version of the MDS DEFAULTS FILE "%MDSDFLTS%/DES-SUPP-PARS" from the MASTER PDMS
-- Project "MDS"
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  altdespars(DBREF,ARRAY)          BOOLEAN
--  altexpression(MDSSTANDARD)       BOOLEAN
--  attamaterial(MDSSTANDARD)        -
--  checkexpression(STRING,ARRAY,STRING) BOOLEAN
--  general(DBREF)                   -
--  mdscatacheck(STRING,REAL,STRING) MDSSTANDARD
--  mdsdefsdata(STRING,REAL)         BOOLEAN
--  mdsparsdata(MDSSTANDARD)         BOOLEAN
--  mdsstddefaults(MDSSTANDARD)      BOOLEAN
--  pipematerial(MDSSTANDARD)        -
--  shop(MDSSTANDARD)                -
--  userdps(MDSSTANDARD)             -
--  vendor(DBREF)                    -
--  weldsize(MDSSTANDARD)            -
--  zerobore(DBREF)                  -
--
define object MDSREADPARSDATA

-- VENDOR info
  member .vendor is STRING

-- MDS Standard Code
  member .code is STRING

-- MDS Standard Configurable Client Code
  member .ccode is STRING

-- MDS Standard Configurable Client Description
  member .desc is STRING

-- MDS Standard Bore
  member .bore is REAL

-- ZERO Bore Data [0] - Elevation Restriction
  member .elevation is STRING

-- ZERO Bore Data [0] - Standard Material Code set at the Relevant PDMS Piping Spec. UDA :mdspipemat
  member .pipematerial is STRING

-- ZERO Bore Data [0] - PDMS Propcon Material Reference Name, e.g. /CARBON/STEEL
  member .matref is STRING

-- ZERO Bore Data [0] - Isometric MTOC Flag
  member .mtoc is STRING

-----------------------------------------------------------
-- ACTUAL Bore Data, e.g. for [50], [100] Bore Sizes etc...
-----------------------------------------------------------
-- Design Parameter values for associated pipe NB
  member .despars is ARRAY

-- DESIGN PARAMETER numbers USER can modify (number,min,max)
  member .userdps is ARRAY

-- ALTERNATIVE EXPRESSIONS used to trigger ALTERNATIVE DESIGN PARAMETER values
  member .altexpr is ARRAY

-- Array of ALTERNATIVE DESIGN PARAMETERS to be used if .altxxpr evaluates to TRUE
  member .altdespars is ARRAY

-- Default Weld Sizes ONLY for a MDS Ancillary
  member .weldsize is STRING

-- Default SHOP Flag for the ATTA
  member .shop is BOOLEAN

-- MDS Object for MDS Standard Availability on the current PDMS Project
  member .mdsstd is MDSSTANDARD

-- End object
endobject
--
--------------------------------------------------------------------------------
-- Main Method .mdsdefsdata(!mdsatta is DBREF, !bore is REAL) is BOOLEAN
-- Arguments:
--           <1> = <!mdsatta> -- STRING  -- MDS ATTA ANCILLARY, or in a few cases the STRUCTURE <GT09, GT10 etc...>, SUPPORT "STYPE"
--           <2> = <!bore>    -- REAL    -- MDS ATTA ANCILLARY, or in a few cases the STRUCTURE <GT09, GT10 etc...>, SUPPORT "Bore Size"
--
-- Return:
--           <1> = BOOLEAN
--
--------------------------------------------------------------------------------
-- Main Method
--
define method .mdsdefsdata(!mdstype is STRING, !bore is REAL) is BOOLEAN

-------------------------------------------------
--$P *** CLOCK INITIALISED ***
--clock init
--q var !mdsatta.fullname
--q var !mdsatta.stype
-------------------------------------------------

-- Store Original PDMS Element
  !xce = !!ce

-- Set Object Bore Member
  !this.bore = !bore

-- Determine the TYPE of MDS Standard
--  !mdsstd    = !mdsatta.stype
  !mdsstd    = !mdstype.upcase()
  !this.code = !mdsstd

-- Check if the MDS ANCILLARY/STRUCTURE Type EXISTS in the PARAGON MDS DEFAULTS
-- CATALOGUE DATABASE and it is ACTIVE for the current PDMS Project
--  !mdsobject   = !this.mdscatacheck(!mdsstd, !bore)
  !mdsobject   = !this.mdscatacheck(!mdsstd, !bore, ||)
  !this.mdsstd = !mdsobject

-- Determine the MDS ATTA ANCILLARY/STRUCTURE DATA Required
  !mdsstddefs = FALSE
  if (!mdsobject.continue) then
-- Load ALL of the MDS Standard Data for the Bore Size Requested
    !mdsdefsok = !this.mdsstddefaults(!mdsobject)

-- Set the Return variable to TRUE
-- CHECK ALL EXPRESSIONS etc... are VALID and RETURN the TRUE or FALSE
    !mdsstddefs = !mdsdefsok

  endif

-- Navigate back to the Original PDMS Element
  !!ce = !xce

-------------------------------------------------
--clock read elapsed
--$P *** CLOCK FINISHED ***
--$P=======================
-------------------------------------------------

-- Return TRUE or FALSE
  return $!mdsstddefs

endmethod
--
--------------------------------------------------------------------------------
--
-- MDS Defaults CATALOGUE Check for a MDS Standard
-- define method .mdscatacheck(!mdsstd is STRING, !bore is REAL ) is MDSSTANDARD
define method .mdscatacheck(!mdsstd is STRING, !bore is REAL, !dummystringval is STRING) is MDSSTANDARD

  --  !mdsstdobject = object MDSSTANDARD(!mdsstd, !bore)
  !mdsstdobject = object MDSSTANDARD(!mdsstd, !bore, ||)
  return !mdsstdobject

endmethod
--
--------------------------------------------------------------------------------
--
-- Get ALL of the MDS Standard "ATTA", and in a few cases the MDS Standard "STRUCTURE",
-- MDS DEFAULTS DATA values etc... for the associated PIPE at a SINGLE Nominal Bore Size
--
define method .mdsstddefaults(!mdsstdobject is MDSSTANDARD) is BOOLEAN
-------------------------------------------------

-- Determine the MDS Standard VENDOR DATA
  !section = !mdsstdobject.section
  !this.vendor(!section)

-------------------------------------------------

-- Determine the MDS Standard GENERAL DATA
  !this.general(!section)

-------------------------------------------------

-- Determine the MDS Standard DATA Values for the ZERO[0] Bore Size
  !this.zerobore(!section)


-------------------------------------------------
--<wd>apr2007
-- For a SINGLE Nominal Bore Size of a PIPE -- Check the Single BORE Size PIPE MATERIAL and MATREF DATA values
-- "OVER-RIDE" the ZERO[0] Bore Size DEFAULT DATA values with the SINGLE Bore Size DEFAULT DATA values

-- Determine the MDS Standard CATEGORY SINGLE BORE Size DATA Values
    !category = !mdsstdobject.category

-- Check if the MDS Standard Single BORE Size Defaults PIPE SPEC. - PIPE MATERIAL DATA Element Exists etc...
    !snborpmat = !category.name & |/PIPEMATERIAL|
    !snpmatdbf = !snborpmat.dbref()
    handle NONE
      !testpipematr = $!snpmatdbf.pprop
      if ( (!testpipematr.trim().neq('')) or (!testpipematr.unset()) ) then
-- DATA property value is a NOT EMPTY TEXT or UNSET
-- Therefore USE the BORE size DATA Property value to CHECK against the UDA :MDSPIPEMAT of the BRANCH PSPE
        !this.pipematerial = $!snpmatdbf.pprop
      endif
--q var!this.pipematerial

    elsehandle ANY
-- Keep the ZERO[0] Bore Size DEFAULT DATA property value
    endhandle

-- Check if the MDS Standard Single BORE Size Defaults PROPCON MATREF DATA Element Exists etc...
    !snbormatr = !category.name & |/MATREF|
    !snmatrdbf = !snbormatr.dbref()
    handle NONE
-- Only "OVER-RIDE" the ZERO[0] Bore Size DEFAULT DATA Property value if it is a VALID PROPCON DB MATERIAL element NAME, e.g. /CARBON/STEEL
      !prnmatrstr = $!snmatrdbf.pprop
    !unusedprnmatrdbf = $!prnmatrstr
      handle NONE
-- DATA property value is a VALID PROPCON DB MATERIAL element NAME
-- Therefore "OVER-RIDE" the ZERO[0] Bore Size MATERIAL with the BORE Size MATERIAL
        !this.matref = $!snmatrdbf.pprop

      elsehandle ANY
-- DATA property value is NOT a VALID PROPCON DB MATERIAL element NAME
-- Therefore keep the ZERO[0] Bore Size DEFAULT DATA property MATERIAL value
      endhandle
--q var !this.matref

    elsehandle ANY
-- Keep the ZERO[0] Bore Size DEFAULT DATA value
    endhandle
--<wd>apr2007
-------------------------------------------------


-------------------------------------------
-- For a SINGLE Nominal Bore Size of a PIPE
-------------------------------------------
-- Determine the MDS ANCILLARY/STRUCTURE Standard DESPARS DATA Values
--  if (!mdsstdobject.type.eq(|ATTA|)) then
  if (!mdsstdobject.type.eq(|ATTA|)) or  (!mdsstdobject.type.eq(|STRU|)) then

-- Determine the MDS ANCILLARY/STRUCTURE Standard DESPARS DATA Values
    !desparsok = !this.mdsparsdata(!mdsstdobject)
--    return !status

-- ONLY RETURN here when and ERROR has been found and the USER has been "ALERTED" in the DESPARS DATA Values etc...
    if (!desparsok.not()) then
      return FALSE
    endif

  endif

-------------------------------------------------

-- Determine the MDS ANCILLARY/STRUCTURE Standard USER EDITABLE DESPARS DATA Values
--  if (!mdsstdobject.type.eq(|ATTA|)) then
  if (!mdsstdobject.type.eq(|ATTA|)) or  (!mdsstdobject.type.eq(|STRU|)) then
    !this.userdps(!mdsstdobject)

  endif

-------------------------------------------------

-- Determine the MDS ANCILLARY/STRUCTURE Standard ALTERNATIVE EXPRESSION and ALTERNATIVE DESPARS DATA Values
--  if (!mdsstdobject.type.eq(|ATTA|)) then
  if (!mdsstdobject.type.eq(|ATTA|)) or  (!mdsstdobject.type.eq(|STRU|)) then
    !altxprdespok = !this.altexpression(!mdsstdobject)

-- ONLY RETURN here when and ERROR has been found, and the USER has been "ALERTED",
-- in the ALTERNATIVE EXPRESSION or the ALTERNATIVE DESPARS DATA Values etc...
    if (!altxprdespok.not()) then
      return FALSE
    endif

  endif

-- Determine the MDS ANCILLARY/STRUCTURE Standard WELDSIZE DATA Values
--  if (!mdsstdobject.type.eq(|ATTA|)) then
  if (!mdsstdobject.type.eq(|ATTA|)) or  (!mdsstdobject.type.eq(|STRU|)) then
    !this.weldsize(!mdsstdobject)

  endif

-------------------------------------------------

-- Determine the MDS ANCILLARY/STRUCTURE Standard BORE SIZE SHOP Flag DATA Values
--  if (!mdsstdobject.type.eq(|ATTA|)) then
  if (!mdsstdobject.type.eq(|ATTA|)) or  (!mdsstdobject.type.eq(|STRU|)) then
    !this.shop(!mdsstdobject)

  endif

-------------------------------------------------
-- **********************************************
-- ONLY CHECK DATA where PDMS EXPRESSIONS occur
-- **********************************************
-------------------------------------------------
-- RETURN the "STATUS" of the DESPARS, ALTEXPR and ALTDESPARS DATA elements
--  if (!mdsstdobject.type.eq(|ATTA|)) then
  if (!mdsstdobject.type.eq(|ATTA|)) or  (!mdsstdobject.type.eq(|STRU|)) then
    if ((!desparsok) and (!altxprdespok)) then
-- ALL MDS Standard DEFAULT DATA Elements and Values are OK
      return TRUE
    endif

  endif
-------------------------------------------------
-- **********************************************
-------------------------------------------------

endmethod
--
--------------------------------------------------------------------------------
--
--------------------------------------------------------------------------------
--
-- MDS Standard VENDOR information
--
define method .vendor(!section is DBREF)

-- Determine and Navigate to the MDS Standard VENDOR data
  !vendordata = !section.name & |/VENDOR/DATA|
  !vendordbrf = !vendordata.dbref()
  handle NONE
    !vendorprop = $!vendordbrf.pprop

-- Set the VENDOR member in this PML Object
    if (!vendorprop.trim().neq(||)) then
      !this.vendor = !vendorprop

    else
-- Empty String
    !this.vendor = ||

    endif

  elsehandle ANY
-- The MDS Standard VENDOR DATA element does NOT exist
    !this.vendor = ||

  endhandle

endmethod
--
--------------------------------------------------------------------------------
--
-- MDS Standard GENERAL information
--
define method .general(!section is DBREF)

-- Determine and Navigate to the MDS Standard GENERAL DTSE
  !generaldtse = !section.name & |/GEN/DTSE|
  !code = !this.code
  !unusedgeneraldbrf = !generaldtse.dbref()
  handle NONE
-- Check if the MDS Standard Defaults CCODE DATA Element Exists etc...
    !generalccod = !section.name & |/GEN/CCOD|
    !genccoddbrf = !generalccod.dbref()
    handle NONE
      !this.ccode = $!genccoddbrf.pprop

    elsehandle ANY
      !this.ccode = |X| & !code

    endhandle

-- Check if the MDS Standard Defaults DESC DATA Element Exists etc...
    !generaldesc = !section.name & |/GEN/DESC|
    !gendescdbrf = !generaldesc.dbref()
    handle NONE
      !this.desc = $!gendescdbrf.pprop

    elsehandle ANY
      !this.desc = ||

    endhandle

  elsehandle ANY
-- The MDS Standard GENERAL DTSE element does NOT exist
--
-- The Configurable Client Code assumed to be the DEFAULT Settings
    !this.ccode = |X| & !code
    !this.desc  = ||

  endhandle

endmethod
--
--------------------------------------------------------------------------------
--
-- MDS Standard ZERO[0] BORE information
--
define method .zerobore(!section is DBREF)

-- Determine and Navigate to the MDS Standard ZERO BORE DTSE
  !zbordtse = !section.name & |/0/DTSE|
  !unusedzbordbrf = !zbordtse.dbref()
  handle NONE
-- Check if the MDS Standard ZERO BORE Defaults ELEVATION DATA Element Exists etc...
    !zborelev = !section.name & |/0/ELEVATION|
    !zeledbrf = !zborelev.dbref()
    handle NONE
      !this.elevation = $!zeledbrf.pprop

    elsehandle ANY
-- The DEFAULT ELEVATION Setting is used when ANY ERROR occurs
      !this.elevation = |*|

    endhandle

-- Check if the MDS Standard ZERO BORE Defaults PIPE MATERIAL DATA Element Exists etc...
    !zborpmat = !section.name & |/0/PIPEMATERIAL|
    !zpmatdbf = !zborpmat.dbref()
    handle NONE
      !this.pipematerial = $!zpmatdbf.pprop

    elsehandle ANY
-- The DEFAULT PIPE MATERIAL Setting is used when ANY ERROR occurs
      !zpmatdef = object DBREF()
      !zpmatdef = /CARBON/STEEL
      handle NONE
-- The PROPCON SOLID element /CARBON/STEEL exists
--        !this.pipematerial = |/CARBON/STEEL|
        !this.pipematerial = ||

      elsehandle ANY
        !this.pipematerial = ||

      endhandle

    endhandle

-- Check if the MDS Standard ZERO BORE Defaults MATREF DATA Element Exists etc...
    !zbormatr = !section.name & |/0/MATREF|
    !zmatrdbf = !zbormatr.dbref()
    handle NONE
      !this.matref = $!zmatrdbf.pprop

    elsehandle ANY
-- The DEFAULT MATREF Setting is used when ANY ERROR occurs
--      !this.matref = |CS|
      !this.matref = ||

    endhandle

-- Check if the MDS Standard ZERO BORE Defaults MTOC DATA Element Exists etc...
    !zbormtoc = !section.name & |/0/MTOC|
    !zmtocdbf = !zbormtoc.dbref()
    handle NONE
      !this.mtoc = $!zmtocdbf.pprop

    elsehandle ANY
-- The DEFAULT MATREF Setting is used when ANY ERROR occurs
      !this.mtoc = |TRUE|

    endhandle

  elsehandle ANY
-- The MDS Standard ZERO BORE DTSE element does NOT exist, assume the DEFAULT settings
--
-- The DEFAULT ELEVATION Setting is:
      !this.elevation = |*|

-- The DEFAULT PROPCON PIPE MATERIAL Setting is:
    !zdefpmat = object DBREF()
    !zdefpmat = /CARBON/STEEL
    handle NONE
--      !this.pipematerial = |/CARBON/STEEL|
      !this.pipematerial = ||

    elsehandle ANY
      !this.pipematerial = ||

    endhandle

-- The DEFAULT MATREF Setting is:
--      !this.matref = |CS|
      !this.matref = ||

-- The DEFAULT MTOC Setting is:
      !this.mtoc = |TRUE|

  endhandle

endmethod
--
--------------------------------------------------------------------------------
--
-- MDS Standard BORE Size DATA, i.e. DESPARS, USERDPS, ALTEXPR etc... information
--
define method .mdsparsdata(!mdsstdobject is MDSSTANDARD) is BOOLEAN

-- Initialise Variables
  !bore     = !mdsstdobject.bore
  !category = !mdsstdobject.category
  !despars  = ARRAY()

-- Determine and Navigate to the MDS Standard BORE Size DESPAR DTSE
  --<RM> 20/10/09 -- added this check because delete support was erroring when we were deleting frameworks with pipe-rest attas
  --this was because the check below looks for despars which pipe-rests don't have, just look for the code and return false (with no message) if we find it
  if !mdsstdobject.code.eq('PIPE-REST') or !mdsstdobject.code.eq('PIPE-REST-INLINE') or !mdsstdobject.code.eq('RACK-REST') then
    return FALSE
  else
  !abordtse = !category.name & |/DESPAR|
  endif
  --<RM> 20/10/09 --end of fix
  !abordbrf = !abordtse.dbref()
  handle NONE
-- Initialise the Collection Object data
    !type  = |DATA|
    !filt  = object EXPRESSION('PURP eq |DESP|')
    !scope = ARRAY()
    !scope.append(!abordbrf)

-- Collect ALL of the DESPARS DATA Elements
    !data  = object COLLECTION()
    !data.filter(!filt)
    !data.scope(!scope)
    !data.type(!type)

-- Collection Results Array
    !results = !data.results()
    if (!results.size().gt(0)) then
-- Process the MDS Standard DATA elements !results Array
      do !indx indices !results
        !despnum = !results[!indx].number
        !despval = !results[!indx].pprop
-- Check if the DESPAR EXPRESSION is VALID, if NOT return an ERROR to the USER
        !errstring  = STRING()
        !desparray  = ARRAY()
        !expression = !this.checkexpression($!<despval>, !desparray, !errstring)
        if (!expression) then
-- The current DESPAR EXPRESSION is "VALID", so append it to the !despars ARRAY
          !despars[!despnum] = $!despval

        else
-- The current DESPAR EXPRESSION is "INVALID", so return an ERROR
          !dataelem = !results[!indx].fullname
          !!alert.error(|$!<errstring>, in the DATA element -
          $!<dataelem>.
          Please contact your MDS administrator.|)
          break

        endif
      enddo

-- Append DESPARS to the .despars Object member
      if (!expression) then
        !this.despars = !despars
        return TRUE

      else
-- Clear the .despars Object member etc...
        !despars.clear()
        !this.despars.clear()
        return FALSE

      endif

    else
-- NO DESPAR DATA Elements Found
      !!alert.error('ERROR: The DTSE element -
      $!<abordtse> - does NOT contain ANY DATA elements for the DESPARS.
      Please contact your MDS administrator.')
      return FALSE

    endif

  elsehandle ANY
-- ERROR Navigating to the MDS Standard BORE Size DESPAR DTSE
-- The DESPARS DTSE probably does NOT Exist
    !!alert.error(|ERROR: The DTSE element
    $!<abordtse> - does not exist.
    Please contact your MDS administrator.|)
    return FALSE

  endhandle

endmethod
--
--------------------------------------------------------------------------------
--
-- Check the PDMS "EXPRESSION" for the MDS Standard DESPAR, USERDP , ALTEXPR etc...
define method .checkexpression(!despstr is STRING, !desparray is ARRAY, !errstring is STRING) is BOOLEAN

--------------------------------------------------------------------------------
-- ************
-- *** NOTE ***
-- ************
-- EXPRESSIONS are enclosed in parenthesis, these need to be concatenated into a single
-- EXPRESSION entry in the DESIGN PARAMETER string by matching all pairs of parenthesis.
-- e.g.
-- A typical DESPAR, USERDP or ALTEXPR "EXPRESSION" could be: (DESP[2] - 2 * DESP[9])
--------------------------------------------------------------------------------

  -- Always RESET the PASSED variables
  !desparray = ARRAY()
  !errstring = ||

-- Initialise Variables
  !expression      = ||
  !expressionlevel = 0
  !indxnexpression = FALSE
  !tempdpsarray    = ARRAY()

-- Check for an EXPRESSION in the passed DESIGN PARAMETER
  if (!despstr.match(|(|) neq 0) then
    !dps = !despstr.split()

    do !indx index !dps
      if (!indxnexpression) then
-- Check for EXPRESSION level 0...,
-- i.e. ALL pairs of parenthesis are matched, e.g. (...), and
        -- a complete EXPRESSION is available to set to the output string
        if (!expressionlevel eq 0) then
-- Append to the TEMPORARY DESPAR array
          !tempdpsarray.append(!expression)

-- Clear out the expression string
          !expression = ||
-- Reset the INEXPRESSION logical
          !indxnexpression = FALSE

        else
-- Check for further expression levels |(|
          if (!dps[!indx].match(|(|) neq 0) then
-- Count number of |(| and increment counter accordingly
            !expressionlevel = !expressionlevel + !dps[!indx].occurs(|(|)
-- Count number of |)| and decrement counter accordingly
            !expressionlevel = !expressionlevel - !dps[!indx].occurs(|)|)
-- Update the expression string
            !expression = !expression + | | + !dps[!indx]

            if (!expressionlevel eq 0) then
-- Append to despar array
              !tempdpsarray.append(!expression)

-- Clear out the expression string
              !expression = ||
-- Reset the inexpression logical
              !indxnexpression = FALSE

            elseif (!expressionlevel lt 0) then
              !errstring = |ERROR: Too many closing brackets in expression for design parameter|
              return FALSE

            endif

          elseif (!dps[!indx].match(|)|) neq 0) then
-- Closing expression |)| found
-- Count number of |(| and increment counter accordingly
            !expressionlevel = !expressionlevel + !dps[!indx].occurs(|(|)
-- Count number of |)| and decrement counter accordingly
            !expressionlevel = !expressionlevel - !dps[!indx].occurs(|)|)
            !expression = !expression + | | + !dps[!indx]

            if (!expressionlevel eq 0) then
-- Append to the TEMPORARY DESPAR array
              !tempdpsarray.append(!expression)
-- Clear out the expression string
              !expression = ||
-- Reset the inexpression logical
              !indxnexpression = FALSE

            elseif (!expressionlevel lt 0) then
              !errstring = |ERROR: Too many closing brackets in expression for design parameter|
              return FALSE

            endif

          elseif (!expressionlevel lt 0) then
            !errstring = |ERROR: Too many closing brackets in expression for design parameter|
            return FALSE

          else
-- Just add this part of the expression to the last
            !expression = !expression + | | + !dps[!indx]

          endif
        endif

      else
-- Check for start of new expression
        if (!dps[!indx].match(|(|) neq 0) then
          !indxnexpression = TRUE
-- Count number of |(| and increment counter accordingly
          !expressionlevel = !expressionlevel + !dps[!indx].occurs(|(|)
-- Count number of |)| and decrement counter accordingly
          !expressionlevel = !expressionlevel - !dps[!indx].occurs(|)|)
          !expression = !dps[!indx]

          if (!expressionlevel eq 0) then
-- Append to the TEMPORARY DESPAR array
            !tempdpsarray.append(!expression)
-- Clear out the expression string
            !expression = ||
-- Reset the inexpression logical
            !indxnexpression = FALSE

          elseif (!expressionlevel lt 0) then
            !errstring = |ERROR: Too many closing brackets in expression for design parameter|
            return FALSE

          endif

-- Check for invalid close of expression
        elseif (!dps[!indx].match(|)|) neq 0) then
          !errstring = |ERROR: Expression contains unnecessary closing bracket ')' in design parameter definition|
          return FALSE

        else
-- Append to the TEMPORARY DESPAR array
          !tempdpsarray.append(!dps[!indx])

        endif
      endif
    enddo

-- Check that we have left despar loop with all expressions closed
    if (!indxnexpression) then
      !errstring = |ERROR: Incomplete EXPRESSION in DESIGN PARAMETER definition|
      return FALSE

    elseif (!expressionlevel gt 0) then
      !errstring =|ERROR: Incomplete EXPRESSION in DESIGN PARAMETER definition|
      return FALSE

    elseif (!expressionlevel lt 0) then
      !errstring = |ERROR: Too many closing brackets in EXPRESSION for DESIGN PARAMETER definition|
     return FALSE

    endif

  else
-- When NO EXPRESSIONS exist in the DESIGN PARAMETERS,
-- i.e. NO parenthesis characters exist '(' or ')', RETURN the DESPAR STRING !despstr as an ARRAY
    !tempdpsarray = !despstr.split()

  endif

-- Return the MDS ANCILLARY/STRUCTURE DESPAR in an ARRAY,
  !desparray = !tempdpsarray

-- Return TRUE if NO ERRORS found setting the Design Parameters ARRAY
  return TRUE

endmethod

--------------------------------------------------------------------------------
--
-- Design Parameter Numbers USER can modify in MDS Design Application (DPnumber,Minvalue,Maxvalue)
--
define method .userdps(!mdsstdobject is MDSSTANDARD)

-- Initialise Variables
  !bore     = !mdsstdobject.bore
  !category = !mdsstdobject.category

-- Determine and Navigate to the MDS Standard BORE Size UDESPAR DTSE
  !abordtse = !category.name & |/UDESPAR|
  !abordbrf = !abordtse.dbref()
  handle NONE
-- Initialise the Collection Object data
    !type  = |DATA|
    !filt  = object EXPRESSION('PURP eq |USER|')
    !scope = ARRAY()
    !scope.append(!abordbrf)

-- Collect ALL of the UDESPAR DATA Elements
    !data  = object COLLECTION()
    !data.filter(!filt)
    !data.scope(!scope)
    !data.type(!type)

-- Collection Results Array
    !results = !data.results()
    if (!results.size().gt(0)) then
-- Process the MDS Standard UDESPAR DATA elements !results Array
      !udpstore = ARRAY()
      do !indx indices !results
-- Determine the USER DESPAR Dkey, Number and Value to be Stored
        !udpdkey = !results[!indx].dkey
        !udpnumb = !results[!indx].number
        !udpvstr = $!results[$!indx].pprop
        !udpvalu = !udpvstr.real()
        if (undefined(!udpstore[!udpnumb])) then
          !udpstore[!udpnumb] = object MDSDPMINMAX()
          !udpstore[!udpnumb].dpnum = !udpnumb

        endif

-- Set the "mdsdpminmax" - MINIMUM & MAXIMUM Object Member values
        if (!udpdkey.eq('UMIN')) then
          !udpstore[!udpnumb].min = !udpvalu

        elseif (!udpdkey.eq('UMAX')) then
          !udpstore[!udpnumb].max = !udpvalu

        else

        endif

      enddo

-- Load the USDESPAR .userdps Object member with the array !udpstore
      !this.userdps = !udpstore

    else
-- ERROR Navigating to the MDS Standard BORE Size UDESPAR DTSE
-- The UDESPAR DTSE probably does NOT Exist
--
-- Clear the UDESPAR .userdps Object member etc...
    !this.userdps.clear()

    endif

  elsehandle ANY
-- ERROR Navigating to the MDS Standard BORE Size UDESPAR DTSE
-- The UDESPAR DTSE probably does NOT Exist
--
-- Clear the UDESPAR .userdps Object member etc...
    !this.userdps.clear()

  endhandle

endmethod
--
--------------------------------------------------------------------------------
--
-- ALTERNATIVE EXPRESSION used to trigger the ALTERNATIVE DESIGN PARAMETER values
--
define method .altexpression(!mdsstdobject is MDSSTANDARD) is BOOLEAN

-- Initialise Variables
  !bore     = !mdsstdobject.bore
  !category = !mdsstdobject.category
  !altxpr   = ARRAY()

-- Determine and Navigate to the MDS Standard BORE Size ALTEXPR DTSE
  !abordtse = !category.name & |/ALTEXPR|
  !abordbrf  = !abordtse.dbref()
  handle NONE
-- Initialise the Collection Object data
    !type  = |DATA|
    !filt  = object EXPRESSION('PURP eq |ALTE|')
    !scope = ARRAY()
    !scope.append(!abordbrf)

-- Collect ALL of the ALTEXPR DATA Elements
    !data  = object COLLECTION()
    !data.filter(!filt)
    !data.scope(!scope)
    !data.type(!type)

-- Collection Results Array
    !results = !data.results()
    if (!results.size().gt(0)) then
-- Process the MDS Standard DATA elements !results Array
      do !indx indices !results
        !altxnum = !results[!indx].number
        !altxval = !results[!indx].pprop

-- Check if the ALTERNATIVE EXPRESSION is VALID, if NOT return an ERROR to the USER
        !errstring  = STRING()
        !altxarray  = ARRAY()
        !expression = !this.checkexpression($!<altxval>, !altxarray, !errstring)
        if (!expression) then
-- The current ALTERNATIVE EXPRESSION is "VALID", so append it to the !altxpr ARRAY
          !altxpr[!altxnum] = $!altxval

        else
-- The current ALTERNATIVE EXPRESSION is "INVALID", so return an ERROR
          !dataelem = !results[!indx].fullname
          !!alert.error(|$!<errstring>, in the DATA element -
          $!<dataelem>.
          Please contact your MDS administrator.|)
          break

        endif
      enddo

-- Append ALTERNATIVE EXPRESSIONS to the .altexpr Object member
      if (!expression) then
        !this.altexpr = !altxpr
-- Continue and CHECK the ALTERNATIVE DESPARS and append them to the .altdespars Object
-- member, but ONLY when the ALTERNATIVE EXPRESSIONS are OK, i.e. !expression is TRUE
        !altdespok = !this.altdespars(!category, !altxpr)
        if (!altdespok) then
          return TRUE

        else
          return FALSE

        endif

      else
-- ERROR found and issued to USER in the ALTERNATIVE EXPRESSIONS, so EMPTY/CLEAR the .altexpr Object member etc...
        !altxpr.clear()
        !this.altexpr.clear()
        return FALSE

      endif

    else
-- NO ALTERNATIVE EXPRESSION DATA Elements Found
-- Clear the ALTERNATIVE EXPRESSIONS .altexpr Object member etc...
        !altxpr.clear()
        !this.altexpr.clear()
        return TRUE

    endif

  elsehandle ANY
-- ERROR Navigating to the MDS Standard BORE Size ALTERNATIVE EXPRESSION DTSE
-- The ALTERNATIVE EXPRESSION DTSE probably does NOT Exist
--
-- Clear the ALTERNATIVE EXPRESSIONS .altexpr Object member etc...
    !altxpr.clear()
    !this.altexpr.clear()
    return TRUE

  endhandle

endmethod
--
--------------------------------------------------------------------------------
--
-- Array of ALTERNATIVE DESIGN PARAMETERS to be used if .altexpr evaluates to TRUE
--
define method .altdespars(!category is DBREF, !altxpr is ARRAY) is BOOLEAN

-- Determine and Navigate to the MDS Standard BORE Size ALTDESPAR DTSE
  !abordtse = !category.name & |/ALTDESP|
  !abordbrf  = !abordtse.dbref()
  handle NONE
-- Initialise the Collection Object data
    !type  = |DATA|
    !filt  = object EXPRESSION('PURP eq |ALTD|')
    !scope = ARRAY()
    !scope.append(!abordbrf)

-- Collect ALL of the ALTDESPAR DATA Elements
    !data  = object COLLECTION()
    !data.filter(!filt)
    !data.scope(!scope)
    !data.type(!type)

-- Collection Results Array
    !results = !data.results()
    if (!results.size().gt(0)) then

-- Initialise the ALTDESPARS Storage Array
      !altdstore = ARRAY()

-- Loop through the passed VALID ALTERNATIVE EXPRESSIONS Numbers
      do !xnum indices !altxpr

-- Process the MDS Standard DATA elements !results Array
        do !indx indices !results

-- Determine to which ALTERNATIVE EXPRESSION the current ALTERNATIVE DESPAR DATA element belongs
          !altxnum = !results[!indx].punit.after(|ALTEXPR/|)

-- Skip when the DATA Element does NOT belong to the current ALTERNATIVE EXPRESSION Number
          if (!xnum.neq(!altxnum.real())) then
            skip
          endif

-- Initialise ALTERNATIVE DESPPAR Variables
          !altdnum = !results[!indx].number
          !altdval = !results[!indx].pprop

-- Check if the ALTERNATIVE DESPARS is VALID, i.e. a VALID value, if NOT return an ERROR to the USER
-- *** NOTE ***
-- Currently "NO MDS Standard" uses an EXPRESSION to store the ALTERNATIVE DESPAR values
          !errstring  = STRING()
          !altdarray  = ARRAY()
          !expression = !this.checkexpression(!altdval.string(), !altdarray, !errstring)
          if (!expression) then
-- The current ALTERNATIVE DESPARS expression is "VALID", so append it to the CORRECT iteration
-- of the !altdarray ARRAY that represents the the CORRECT iteration of ALTERNATIVE EXPRESSION
            !mdsdpval = object MDSDPVAL()
            handle ANY
              !mdsdpval.delete()
              !mdsdpval = object MDSDPVAL()
            endhandle
            !mdsdpval.altval = $!altdval
            !mdsdpval.dpnum  = !altdnum
-- Append each MDSDPVAL Object to the ALTERNATIVE DESPARS storage array
            if (defined(!altdstore[!xnum])) then
              !altdstore[!xnum].append(!mdsdpval)

            else
-- The Array iteration does NOT exist
              !altdstore[!xnum] = ARRAY()
              !altdstore[!xnum].append(!mdsdpval)
            endif

          else
-- The current ALTERNATIVE DESPARS expression is "INVALID", so return an ERROR
            !dataelem = !results[!indx].fullname
            !!alert.error(|$!<errstring>, in the DATA element -
            $!<dataelem>.
            Please contact your MDS administrator.|)
            break

          endif
        enddo
      enddo

      -- Append ALTERNATIVE EXPRESSIONS to the .aLTDESPAR Object member
      if (!expression) then
        !this.altdespars = !altdstore
        return TRUE

      else
-- ERROR found and issued to USER in the ALTERNATIVE EXPRESSIONS, so EMPTY/CLEAR the .altexpr Object member etc...
        !altxpr.clear()
        !this.altexpr.clear()
        return FALSE

      endif

    else

-- NO ALTERNATIVE EXPRESSION DATA Elements Found
-- Clear the ALTERNATIVE EXPRESSIONS .altexpr Object member etc...
      !altxpr.clear()
      !this.altexpr.clear()
      return TRUE

    endif

  elsehandle ANY
-- ERROR Navigating to the MDS Standard BORE Size ALTERNATIVE DESPARS DTSE
-- The ALTERNATIVE DESPARS DTSE probably does NOT Exist
--
-- Clear BOTH the ALTERNATIVE DESPARS the .altdespars and the
-- ALTERNATIVE EXPRESSIONS .altexpr Object members etc...
    !this.altdespars.clear()
    !this.altexpr.clear()
    return FALSE

  endhandle


endmethod
--
--------------------------------------------------------------------------------
--
-- Default WELD SIZE for MDS ANCILLARY/STRUCTURE ATTAS ONLY
--
define method .weldsize(!mdsstdobject is MDSSTANDARD)

-- Initialise Variables
  !bore     = !mdsstdobject.bore
  !category = !mdsstdobject.category
  !despars  = ARRAY()

-- Determine and Navigate to a MDS ATTA BORE Size WELD DTSE
  !abordtse = !category.name & |/WELD|
  !abordbrf  = !abordtse.dbref()
  handle NONE
-- Initialise the Collection Object data
    !type  = |DATA|
    !filt  = object EXPRESSION('PURP eq |WELD|')
    !scope = ARRAY()
    !scope.append(!abordbrf)

-- Collect ALL of the DESPARS DATA Elements
    !data  = object COLLECTION()
    !data.filter(!filt)
    !data.scope(!scope)
    !data.type(!type)

-- Collection Results Array
    !results = !data.results()
    if (!results.size().gt(0)) then
-- Process the MDS Standard DATA elements !results Array
      !weldstring = ||
      do !indx indices !results
        !unusedweldnum = !results[!indx].number
        !weldval = !results[!indx].pprop.string().after(|(|).before(|)|)
        -- Concatenate WELD Values into a STRING separated by commas.
-- The MDS UDA :mdsweldsize <ATTA, PJOI and SJOI> MUST be a STRING value
        if (!indx.eq(1)) then
          !weldstring = !weldstring & !weldval
        else
          !weldstring = !weldstring & |,| & !weldval
        endif

      enddo
-- WELD SIZE DATA Elements Found
-- SET the WELD SIZE .weldsize Object member etc...
    !this.weldsize = !weldstring

    else
-- NO WELD SIZE DATA Elements Found
-- Unset the WELD SIZE .weldsize Object member etc...
    !this.weldsize = ||

    endif

  elsehandle ANY
-- NO WELD SIZE DATA Elements Found
-- Unset the WELD SIZE .weldsize Object member etc...
    !this.weldsize = ||

  endhandle

endmethod
--
--------------------------------------------------------------------------------
--
-- Default MDS ANCILLARY/STRUCTURE MATERIAL/S for a MDS ATTA
-- MDS ANCILLARY/STRUCTURE BORE SIZE DATA -- Over rides the CATEGORY 0<ZERO> BORE Setting
--
define method .attamaterial(!mdsstdobject is MDSSTANDARD)

-- Initialise Variables
  !category = !mdsstdobject.category

-- Check if the MDS Standard BORE Size Defaults MATREF DATA Element Exists etc...
  !abordata = !category.name & |/MATREF|
  !abordbrf = !abordata.dbref()
  handle NONE
    !this.matref = $!abordbrf.pprop

  elsehandle ANY
-- The ZERO<0> Bore DEFAULT MATREF Setting is used, unless it is not set, when ANY ERROR occurs
    if (!this.matref.unset())then
--      !this.matref = |CS|
      !this.matref = ||
    endif

  endhandle

endmethod
--
--------------------------------------------------------------------------------
--
-- Default PIPE SPECIFICATION MATERIAL/S for a MDS ATTA
-- MDS ANCILLARY/STRUCTURE BORE SIZE DATA -- Over rides the CATEGORY 0<ZERO> BORE Settings
--
define method .pipematerial(!mdsstdobject is MDSSTANDARD)

-- Initialise Variables
  !category = !mdsstdobject.category

-- Check if the MDS Standard BORE Size Defaults PIPE MATERIAL DATA Element Exists etc...
  !abordata = !category.name & |/PIPEMATERIAL|
  !abordbrf = !abordata.dbref()
  handle NONE
    !this.pipematerial = $!abordbrf.pprop

  elsehandle ANY
-- The ZERO<0> Bore DEFAULT PIPE MATERIAL Setting is used, unless it is not set, when ANY ERROR occurs
    if (!this.pipematerial.unset()) then
      !apmatdef = object DBREF()
      !apmatdef = /CARBON/STEEL
      handle NONE
-- The PROPCON SOLID element /CARBON/STEEL exists
--        !this.pipematerial = |/CARBON/STEEL|
        !this.pipematerial = ||

      elsehandle ANY
        !this.pipematerial = ||

      endhandle

    endif

  endhandle

endmethod
--
--------------------------------------------------------------------------------
--
-- Default SHOP Flag for a MDS ATTA or STRUCTURE Bore Size
--
define method .shop(!mdsstdobject is MDSSTANDARD)

-- Initialise Variables
  !category = !mdsstdobject.category

-- Check if the MDS Standard BORE Size Default SHOP Flag DATA Element Exists etc...
  !abordata = !category.name & |/SHOP|
  !abordbrf = !abordata.dbref()
  handle NONE
-- Convert a STRING into a BOOLEAN
--  ***NOTE *** !shopvalue  = !shopstring.boolean() DOES NOT WORK ?????????????
    !shopstring = $!abordbrf.pprop
    !shopvalue  = $!shopstring
    !this.shop  = !shopvalue

  elsehandle ANY
-- The DEFAULT "TRUE" MDS ATTA BORE Size SHOP Flag Setting is used when ANY ERROR occurs
    !this.shop = TRUE

  endhandle

endmethod
