--------------------------------------------------------------------------------
--
-- Default MDS TRUNNION MATERIAL/S for a MDS ATTA
-- MDS TRUNNION BORE SIZE DATA -- Over rides the CATEGORY 0<ZERO> BORE Setting
--
define method .attamaterial(!mdsstdobject is MDSSTANDARD)

  -- Initialise Variables
  !category = !mdsstdobject.category

  -- Check if the MDS Standard BORE Size Defaults MATREF DATA Element Exists etc...
  !abordata = !category.name & |/MATREF|
  !abordbrf = !abordata.dbref()
  handle NONE
    !this.matref = $!abordbrf.pprop

  elsehandle ANY
    -- The ZERO<0> Bore DEFAULT MATREF Setting is used, unless it is not set, when ANY ERROR occurs
    if (!this.matref.unset())then
      !this.matref = ||
    endif

  endhandle

endmethod
--
--------------------------------------------------------------------------------
--
-- Default PIPE SPECIFICATION MATERIAL/S for a MDS ATTA
-- MDS TRUNNION BORE SIZE DATA -- Over rides the CATEGORY 0<ZERO> BORE Settings
--
define method .pipematerial(!mdsstdobject is MDSSTANDARD)

  -- Initialise Variables
  !category = !mdsstdobject.category

  -- Check if the MDS Standard BORE Size Defaults PIPE MATERIAL DATA Element Exists etc...
  !abordata = !category.name & |/PIPEMATERIAL|
  !abordbrf = !abordata.dbref()
  handle NONE
    !this.pipematerial = $!abordbrf.pprop

  elsehandle ANY
    -- The ZERO<0> Bore DEFAULT PIPE MATERIAL Setting is used, unless it is not set, when ANY ERROR occurs
    if (!this.pipematerial.unset()) then
      !apmatdef = object DBREF()
      !apmatdef = /CARBON/STEEL
      handle NONE
        -- The PROPCON SOLID element /CARBON/STEEL exists
        --        !this.pipematerial = |/CARBON/STEEL|
        !this.pipematerial = ||

      elsehandle ANY
        !this.pipematerial = ||

      endhandle

    endif

  endhandle

endmethod
--
--------------------------------------------------------------------------------
--
-- Default SHOP Flag for a MDS ATTA or TRUNNION Bore Size
--
define method .shop(!mdsstdobject is MDSSTANDARD)

  if !mdsstdobject.type.eq(|TRUN|) then

    -- Initialise Variables
    !category = !mdsstdobject.category

    -- Check if the MDS Standard BORE Size Default SHOP Flag DATA Element Exists etc...
    !abordata = !category.name & |/SHOP|
    !abordbrf = !abordata.dbref()
    handle NONE
      -- Convert a STRING into a BOOLEAN
      --  ***NOTE *** !shopvalue  = !shopstring.boolean() DOES NOT WORK ?????????????
      !shopstring = $!abordbrf.pprop
      !shopvalue  = $!shopstring
      !this.shop  = !shopvalue

    elsehandle ANY
      -- The DEFAULT "TRUE" MDS ATTA BORE Size SHOP Flag Setting is used when ANY ERROR occurs
      !this.shop = TRUE

    endhandle

  --VT16 needs special treatment to read the shop flag
  elseif !mdsstdobject.code.eq('VT16') then
    !bore     = !mdsstdobject.bore.value()
    !shopTemp = '/MDS/STRUCTURE/DEFAULTS/VT16/$!bore/SHOP'
    !shopData = !shopTemp.dbref()
    !shopstring = $!shopData.ppro
    !shopvalue = $!shopstring
    !this.shop  = !shopvalue
  endif

endmethod

--------------------------------------------------------------------------------
--
-- specific method to determine VT16 despars,
-- i.e. DEFLENGTH, MINLENGTH, MAXLENGTH etc... information
--
define method .mdsparsdataVT16(!mdsstdobject is MDSSTANDARD) is BOOLEAN

  -- Initialise Variables
  !bore     = !mdsstdobject.bore.value()

  --all of the VT16 trunnion type properties are held in structure defaults in despar 1-4
  !dtsestring = '/MDS/STRUCTURE/DEFAULTS/VT16/$!bore/DESPAR'
  !dtse = !dtsestring.dbref()
  !deflengthTemp  = !dtse.members[1].pprop
  !deflength = $!deflengthTemp
  !this.deflength = !deflength.real()
  !minlengthTemp  = !dtse.members[2].pprop
  !minlength = $!minlengthTemp
  !this.minlength = !minlength.real()
  !maxlengthTemp  = !dtse.members[3].pprop
  !maxlength = $!maxlengthTemp
  !this.maxlength = !maxlength.real()

  !propTemp = !dtse.members[4].pprop
  !prop = $!propTemp

  -- AVAILABLE Trunnion Bore Sizes
  !tbor = !prop.before(|,|)
  !this.bores.append(!tbor)

  -- Associated Fixed Items <if ANY?>
  !styp = !prop.after(|,|)
  !this.stypes.append(!styp)

  return TRUE

endmethod
