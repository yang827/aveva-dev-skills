-- Description:
--
-- PML Object to store various data related to MDS Frames
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  CorrectPosition(DBREF,DBREF)     -
--  Mdsrepeatframe()                 -
--  SetSprefOfSref(STRING,STRING,STRING) -
--  Unsupported(STRING)              BOOLEAN
--
define object mdsrepeatframe

   -- list frame types
   member .FrameCode is ARRAY

   -- list of related stype templates
   member .StypeTempl is ARRAY

   -- list of unsupported frames (that cannot be copied)
   member .Unsupported is ARRAY

-- end of object definition
endobject



