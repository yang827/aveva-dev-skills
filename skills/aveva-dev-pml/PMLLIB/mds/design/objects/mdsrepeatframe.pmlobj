-- get spref of SREF atta
-----------------------------------------------------------------------------
define method .SetSprefOfSref(!SuppName is STRING,!NofBars is STRING,!Tmplnum is STRING)

    !Datum = $!SuppName/DATUM
    !Sref = $!SuppName/SREF
    !Stru = $!SuppName
    !SuppType = !Stru.:MdsSuppType

       !StypTemp = !this.StypeTempl[!this.Framecode.findfirst(!SuppType)]
          handle ANY
          endhandle

    !!ce = !sref
    -- first handle exceptions
    if !SuppType.eq('FT23') then
       !spref = select spec /MDF with styp '$!Sref.styp'
    elseif !SuppType.eq('FT24') then
       !spref = select spec /MDF with styp '$!Sref.styp'
    elseif !SuppType.eq('FT25') then
       !Spref = select spec /MDF with styp '$!Sref.styp'
    elseif !SuppType.eq('FT41') then
       !Spref = select spec /MDF with styp '$!Sref.styp'
    elseif !SuppType.eq('SPECIAL') then
       !spref = select spec /MDS with styp 'SPECIAL'
    elseif !SuppType.eq('VT05').or(!SuppType.eq('VT06')) then
       !fmt = object FORMAT()
       !fmt.units = 'INCH'
       !fmt.fraction = TRUE
       !fmt.zeros = FALSE
       !fmt.denominator = 32
       !bore = !Datum.lbor.string(!fmt).trim()
       !Styp = !StypTemp.Replace('<bore>',!bore).Replace('<tmplnum>',!tmplnum)
       !Spref = select spec /MDF with styp '$!Styp'
    elseif !SuppType.eq('GT05') then
       if !Datum.inth.Boolean() then
          !insul = 'A'
       else
          !insul = 'B'
       endif
       !Styp = !StypTemp.Replace('<insul>',!insul).Replace('<tmplnum>',!tmplnum)
       !Spref = select spec /MDF with styp '$!Styp'
    else
       !Styp = !StypTemp.Replace('<bars>',!NofBars).Replace('<tmplnum>',!tmplnum)
       !Spref = select spec /MDF with styp '$!Styp'
    endif

    !!ce.spre = !Spref[1]

endmethod



-- correct frame position - slide to pipe/ancillary
-------------------------------------------------------------------------------------
define method .CorrectPosition(!Bar is DBREF,!Datum is DBREF)

       !Stru = stru of $!Bar
       !SuppType = !Stru.:MdsSuppType

       !SkippedFrames = 'FT28 FT49 FT50 FT52 FT53 FT57 GT05 GT09 GT10 VT01 VT02 VT03 VT04 VT05 VT07 VT08 VT09 VT10 VT11 VT12 VT13 VT14 VT15 VT16 VT17 VT18 VT19 VT22 VT23 VT24 SPECIAL'
       if !SkippedFrames.Match(!SuppType).Boolean() then
          return
       endif

       !Zdir = U wrt $!Stru
       !ItemToConn = !Bar
       !FramesWithVerticalBar = 'FT05 FT06 FT07 VT06 FT56 VT06'
       !Pedestals = 'FT23 FT41 FT48A FT48B FT48C FT48D'
       if !FramesWithVerticalBar.Match(!SuppType).Boolean() then
          if !SuppType.eq('FT56').or(!SuppType.eq('VT06')) then
             !Zdir = N wrt $!Stru
          else
             !Zdir = E wrt $!Stru
          endif
       elseif !Pedestals.Match(!SuppType).Boolean() then
           !ItemToConn = box1 of subs1 of $!Stru
          if !SuppType.eq('FT41') then
             !Zdir = pdir6 of $!ItemToConn wrt world
          else
             !Zdir = pdir3 of $!ItemToConn wrt world
          endif
       endif


       !!ce = !ItemToConn
       -- create temporary copy
       new $!!CE.type copy prev
       delete $!!CE.type members

       -- set pins up
       pin1 at p9 of $!Datum
       pin1 dir $!Zdir
       pin1 behind ce
       pin2 copy pin1
       pin2 infront ce

       --delete temporary copy
       delete $!!ce.type

       -- store pin positions
       var!spos pin1 pos wrt world
       !Pin[1] = $!Spos wrt world
       var!spos pin2 pos wrt world
       !Pin[2] = $!Spos wrt world

       -- pins off
       pin1 off
       pin2 off

       -- calculate closest pin to DATUM atta
       !Dist1 = !Pin[1].distance(!Datum.pos)
       !Dist2 = !Pin[2].distance(!Datum.pos)
       if !Dist1.lt(!Dist2) then
          !Pnum = 1
       else
          !Pnum = 2
       endif

       -- get direction and distance to move frame
       !Dir = !pin[!pnum].direction(!Datum.ppos[9])
       !Dist = !Pin[!pnum].distance(!Datum.ppos[9])
       !angle = !Zdir.angle(!Dir)
       if !Angle.lt(90) then
          !Dir = !Zdir
       else
          !Dir = !Zdir.Opposite()
       endif

       !!ce = !stru
       move $!Dir distance $!dist

endmethod


-- check frame type against list of unsupported frames (TRUE = unsupported)
--------------------------------------------------------------------------
define method .Unsupported(!SuppType is STRING) is BOOLEAN

      return !this.Unsupported.Find(!SuppType).Set()

endmethod
