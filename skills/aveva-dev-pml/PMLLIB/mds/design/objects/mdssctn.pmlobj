--  mdssctn(DBREF)                   -
--
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------

-- Define Object
define object mdssctn
--
-- Object Members
--
-- MDS Framework Support SCTN -- DBREF
  member .sctn is DBREF

-- MDS Framework Support SCTN -- NAME
  member .name is STRING

-- MDS Framework Support SCTN -- GTYP of CATREF
  member .gtyp is STRING

-- MDS Framework Support SCTN -- ARRAY of MDS SNIPE FITTING element OBJECTS -- MDSFITTING
  member .snipes is ARRAY

endobject
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
-- Constructor Method
define method .mdssctn(!sctn is DBREF)

-- Initialise Variables
  !xce = !!ce
  !!ce = !sctn

-- Populate the MDSSCTN object
  !this.sctn = !sctn
  !this.name = !sctn.name
  !this.gtyp = !sctn.catref.gtyp

-- ONLY Collect all the MDS SNIPE FITTING elements for the passed !sctn
  !fittings = !!kcollectallfor('FITT', '(name of spref eq |/MDS/SNIPES|)', !sctn)

-- Process and Store each SCTN in a MDSCTN object in the MAIN SUPPORT object ARRAY member !support.mdssctn
  !snipearray = ARRAY()
  do !snipe values !fittings
    !mdsfitting = object MDSFITTING(!snipe)
    !snipearray.append(!mdsfitting)
  enddo

-- Set the member .snipes ARRAY
  !this.snipes = !snipearray

-- Return to Original Element
  !!ce = !xce

endmethod
