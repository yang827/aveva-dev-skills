--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  autoname()                       -
--  calculate()                      -
--  checksize(REAL,STRING)           REAL
--  closerend(DBREF,DBREF)           STRING
--  create()                         -
--  deletesnipe()                    -
--  getedges()                       ARRAY
--  loadsctn(DBREF,DBREF)            -
--  loadsnipe(DBREF,DBREF)           -
--  mdssnipe()                       -
--  mdssnipe(DBREF)                  -
--  mdssnipe(DBREF,DBREF)            -
--  mdssnipe(DBREF,STRING,STRING)    -
