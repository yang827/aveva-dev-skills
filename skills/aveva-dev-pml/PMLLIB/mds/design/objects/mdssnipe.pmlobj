--  resolve()                        -
--  setsize(REAL,REAL)               -
--

define object MDSSNIPE

    member .stiff  is DBREF
    member .sctn is DBREF
    member .snipe is DBREF
    member .end is STRING
    member .pline is STRING
    member .leng is REAL
    member .widt is REAL
    member .spref is DBREF
    member .minsize is REAL

endobject
-- end of object definition



-- default constructor
--------------------------------------------------------------------------------------------------------------
define method .mdssnipe()

  !this.spref = /MDS/SNIPES
  !this.minsize = 10mm
  !this.setsize(0,0)

endmethod


-- load existing snipe (no stiffener)
-------------------------------------------------------------------------------------------------------------
define method .mdssnipe(!snipe is DBREF)

    !this.mdssnipe()
    !this.loadsnipe(!snipe, nulref)

endmethod


-- method to load either existing snipe or section without snipe. Second argument is stiffener (can be nulref)
--------------------------------------------------------------------------------------------------------------
define method .mdssnipe(!snipeorsctn is DBREF,!stiff is DBREF)
--$P============line 64==================================method .mdssnipe(!snipeorsctn is DBREF,!stiff is DBREF)
--$P ********* q var !stiff.fullname !snipeorsctn.fullname
--q var !stiff.fullname !snipeorsctn.fullname
--$P
--$P
    !this.mdssnipe()

    if !stiff.badref() then
         return error 1 'Stiffener is unset'
    endif

--<wd>jul2007<mds12> -- MARINE element is HSTIFF and not HSTI
--    if !stiff.type.eq('SCTN').or(!stiff.type.eq('HSTI')).not() then
    if !stiff.type.eq('SCTN').or(!stiff.type.eq('HSTIFF')).not() then
        return error 1 'Stiffener must be a linear section'
    endif
--<wd>jul2007<mds12>

--<wd>jul2007<mds12> -- MARINE element HSTIFF element GTYPs added etc..
--    if !stiff.catr.gtyp.neq('ANG') then
    if (!stiff.catr.gtyp.neq('ANG')) and (!stiff.catr.gtyp.neq('EANG')) and (!stiff.catr.gtyp.neq('UEAN'))then
--         return error 1 'Stiffener must be of gtyp ANG'
         return error 1 'Stiffener must be of gtyp ANG, EANG or UEAN'
    endif
--<wd>jul2007<mds12>

    if !snipeorsctn.type.eq('SCTN') then
       !this.loadsctn(!snipeorsctn,!stiff)
    elseif !snipeorsctn.type.eq('FITT') then
       !this.loadsnipe(!snipeorsctn,!stiff)
    else
       return error 1 'Invalid argument 1 - must be either SCTN or FITT'
    endif

endmethod


-- load section then try to find out the matching snipe and stiffener
----------------------------------------------------------------------------------------------
define method .mdssnipe(!sctn is DBREF, !end is STRING, !pline is STRING)

    !this.mdssnipe()

    !this.sctn = !sctn
    !this.stiff = nulref
    !this.end = !end.trim().upcase()
    !this.pline = !pline.trim().upcase()

    if !this.end.eq('END') then
       !zdisexp = '( zdis neq 0 )'
    else
       !zdisexp = '( zdis eq 0 )'
    endif

    var !snipe collect all FITT with posli eq '$!this.pline' and $!zdisexp for $!sctn
    if !snipe.set() then
       !this.snipe = !snipe[1].dbref()
       !this.setsize(!this.snipe.rpro.sl,!this.snipe.rpro.snwd)
    endif

    if !sctn.:mdsconn.badref().not() then
       !stiff = !sctn.:mdsconn
       if !this.end.eq(!this.closerend(!sctn,!stiff)) then
          !this.stiff = !stiff
       endif
    endif


endmethod



-- load existing snipe
-----------------------------------------------------------------------------------------------
define method .loadsnipe(!snipe is DBREF,!stiff is DBREF)

    if !snipe.spre.neq(!this.spref) then
       return error 1 'It is not snipe!'
    endif

    if !snipe.posli.eq('LBOA').or(!snipe.posli.eq('RTTA')).not() then
       return error 1 'Snipe is not correctly defined'
    endif

    if !snipe.zdis.eq(0) then
      !this.end = 'START'
    else then
      !this.end = 'END'
    endif

    !this.pline = !snipe.posl
    !this.stiff = !stiff
    !this.snipe = !snipe
    !this.sctn  = !snipe.owner
    !this.setsize(!snipe.rpro.sl,!snipe.rpro.snwd)

    if !this.stiff.badref().and(!this.sctn.:mdsconn.badref().not()) then
       if !this.end.eq(!this.closerend(!this.sctn,!this.sctn.:mdsconn)) then
          !this.stiff = !this.sctn.:mdsconn
       endif
    endif


endmethod


-- load section without snipe
----------------------------------------------------------------------------------------------
define method .loadsctn(!sctn is DBREF, !stiff is DBREF)

    if !sctn.catr.gtyp.neq('ANG') then
       return error 1 'SCTN must be of type ANG'
    endif

--<wd>jul2007<mds12> -- Determine the ANGLE when a MARINE HULL HSTIFF element is involved
--    !checkangl = !stiff.zdir.angle(!sctn.zdir)
    if (!stiff.type.eq('SCTN')) or (!stiff.type.eq('GENSEC')) then
      !checkangl = !stiff.zdir.angle(!sctn.zdir)
    elseif (!stiff.type.eq('HSTIFF')) then
      !checkangl = !stiff.ori.zdir().angle(!sctn.zdir)
    endif
--<wd>jul2007<mds12>

    if !checkangl.between(89,91).not() then
       return error 1 'Section and stiffener are not perpendicular'
    endif

    !this.sctn = !sctn
    !this.stiff = !stiff
    !this.snipe = nulref
    !this.setsize( object REAL(), object REAL())

    !edge = !this.getedges()[1]

    if !edge.eq('RTTA').or(!edge.eq('LBOA')) then
       !pline = !edge
    endif

    !end = !this.closerend(!sctn,!stiff)

    if !end.eq('START') then
       !zdisexp = '(Zdis eq 0 )'
    else
       !zdisexp = '(Zdis neq 0 )'
    endif

    !this.pline = !pline
    !this.end = !end

    var !allsnipe collect all FITT with spref eq $!this.spref and $!zdisexp and posli eq '$!pline' for $!this.sctn
    if !allsnipe.size().gt(0) then
       !this.snipe = !allsnipe[1].dbref()
       !this.setsize(!this.snipe.rpro.sl,!this.snipe.rpro.snwd)
    endif

endmethod


-- return sctn and stiffener edges
----------------------------------------------------------------------------------------------
define method .getedges() is ARRAY

--<wd>aug2007--Original KP-PML-code -- [1] <STRING> pline on angle edge
--<wd>aug2007--Original KP-PML-code -- [2] <STRING> pline on stiffener edge
--<wd>aug2007--Original KP-PML-code
--<wd>aug2007--Original KP-PML-code     !natangl = !this.stiff.plori.nat.zdir().angle(!this.sctn.zdir)
--<wd>aug2007--Original KP-PML-code     !nalangl = !this.stiff.plori.nal.zdir().angle(!this.sctn.zdir)
--<wd>aug2007--Original KP-PML-code
--<wd>aug2007--Original KP-PML-code     if !natangl.between(0,1).or(!natangl.between(179,180)) then
--<wd>aug2007--Original KP-PML-code        !stedge = 'RTTA'
--<wd>aug2007--Original KP-PML-code     elseif !nalangl.between(0,1).or(!nalangl.between(179,180)) then
--<wd>aug2007--Original KP-PML-code        !stedge = 'LBOA'
--<wd>aug2007--Original KP-PML-code     endif
--<wd>aug2007--Original KP-PML-code
--<wd>aug2007--Original KP-PML-code -----------------------------------------------------------------------------------------------------------------
--<wd>aug2007--Original KP-PML-code --<wd>aug2007
--<wd>aug2007--Original KP-PML-code -- The variable "!sctedge" DOES NOT EXIST any where in this METHOD or this OBJECT -- BUT SHOULD IT????-- CHECK --
--<wd>aug2007--Original KP-PML-code --   !result[1] = !sctedge
--<wd>aug2007--Original KP-PML-code    !result[1] = !stedge
--<wd>aug2007--Original KP-PML-code --<wd>aug2007
--<wd>aug2007--Original KP-PML-code -----------------------------------------------------------------------------------------------------------------
--<wd>aug2007--Original KP-PML-code
--<wd>aug2007--Original KP-PML-code    !result[2] = !stedge
--<wd>aug2007--Original KP-PML-code
--<wd>aug2007--Original KP-PML-code    return !result
--<wd>aug2007--Original KP-PML-code

--*************************************************************************************************
--<wd>aug2007 -- Modified the PML Code
-- to determine the MDS 'ANGLE' SCTN PLINE PKEY and the MAIN STRUCTURE 'ANGLE' STIFFENER
-- PLINE PKEY, referenced by the MDS SCTN :MDSCONN atttribute, to be used when considering the size of an AUTOMATICALLY
-- GENERATED MDS SNIPE (FITTING) on a MDS SUPPORT 'ANGLE' SCTN supported/connected from a MAIN STRUCTURE 'ANGLE' STIFFENER.
--
-- [1] <STRING> pline on angle edge
-- [2] <STRING> pline on angle stiffener edge

-- Determine the Pline PKEY on the MDS Support 'ANGLE' SCTN edge
    !sctnnatangl = !this.sctn.plori.nat.zdir().angle(!this.stiff.ori.zdir())
    if (!sctnnatangl.between(0,1).or(!sctnnatangl.between(179,180))) then
       !sctnpkey = 'RTTA'
    elseif (!sctnnatangl.between(89,91) ) then
       !sctnpkey = 'LBOA'
    endif

-- Determine the Pline PKEY on the 'ANGLE' STIFFENER edge
    !stiffnatangl = !this.stiff.plori.nat.zdir().angle(!this.sctn.zdir)
    if (!stiffnatangl.between(0,1).or(!stiffnatangl.between(179,180))) then
       !stiffpkey = 'RTTA'
    elseif (!stiffnatangl.between(89,91) ) then
       !stiffpkey = 'LBOA'
    endif

   !result[1] = !sctnpkey
   !result[2] = !stiffpkey

--$P****************
--q var !result

   return !result
--<wd>aug2007 -- Modified PML Code
--*************************************************************************************************

endmethod


-- get section end closer to another section
----------------------------------------------------------------------------------------------
define method .closerend(!sctn is DBREF,!stiff is DBREF) is STRING

    !sctnline = object LINE(!sctn.poss,!sctn.pose)
    !stifline = object LINE(!stiff.poss,!stiff.pose)

    !xsec = !sctnline.intersection(!stifline)

    if !xsec.distance(!sctn.poss).lt(!xsec.distance(!sctn.pose)) then
       !end = 'START'
    else
       !end = 'END'
    endif

    return !end

endmethod


-- create snipe
----------------------------------------------------------------------------------------------
define method .create()

   !!ce = !this.sctn

   new fitt
--<wd>may2007
-- Set the FUNCTION attribute to 'DUMMY' as the FITTING SPREF/CATREF reference is "unset"
-- The MDS ABA process does NOT TAG 'DUMMY' FITTINGS on the DRAWING or include them in the MATERIAL LIST
   function 'DUMMY'
--<wd>may2007

   !this.snipe = !!ce
   !!ce.spre = !this.spref

   if !this.end.eq('END') then
      rule set ZDIS dynamic (cutl of owner)
   else
      rule set ZDIS dynamic ( 0 )
   endif

   !!ce.posli =  !this.pline

   -- give the name to the snipe fitting
   !this.autoname()

   !this.modify()

endmethod


-- modify snipe
----------------------------------------------------------------------------------------------
define method .modify()

   !!ce = !this.snipe

   ddesp $!this.leng $!this.widt

endmethod


-- assign automatic name to the snipe FITT
----------------------------------------------------------------------------------------------
define method .autoname()

   if !this.snipe.isnamed.or(!this.snipe.owner.isnamed.not()) then
        return
   endif

   !name = !this.snipe.owner.name + '/Snipe-' + !this.end.substring(1,1) + !this.end.substring(2).lowcase()
   !this.snipe.name = !name
      handle ANY

--<wd>aug2007<mds12>
-- Regenerating SNIPES with the PURPOSE set to 'XGUI' may use a SNIPE "Name Already Used"
-- by an AUTOMATICALLY or a MDS FRMW TEMPLATE generated SNIPE on a MDS FRAMEWORK SUPPORT
-- So there may be a MAXIMUM of 4(FOUR) SNIPES at the START or the END of an ANGLE SCTN
-- when physically there can ONLY be 2(TWO). In this case the 2(TWO) SNIPES with
-- PURPOSE = 'XGUI' need to be DELETED
--<wd>aug2007<mds12>

        !this.snipe.name = !name + '1'

--<wd>aug2007<mds12>
        handle ANY
-- The current MDS SNIPE is UNNAMED, as the NAME already EXISTS, i.e. it is a "DUPLICATED" SNIPE NAME.
-- ALL MDS SNIPES are AUTOMATICALLY regenerated via the PML function "mdsrestoresnipe.pmlfnc", when
-- a MDS FRMW STD SUPPORT is RESIZED by selecting another MDS TEMPLATE or CREATING by CURSOR/DIMEMNSION/CLEARANCE
        endhandle
--<wd>aug2007<mds12>

      endhandle

endmethod


-- calculate snipe
----------------------------------------------------------------------------------------------
define method .calculate()

   if !this.stiff.badref() then
      if !this.pline.eq('RTTA') then
         !snipsize = !this.sctn.para[2] - 25
      elseif !this.pline.eq('LBOA') then
         !snipsize = !this.sctn.para[1] - 25
      endif
      -- make sure that !snipsize is in current units - params are always in MM!!
      !snipsize = $!snipsize
      !this.setsize(!snipsize,!snipsize)
      return
   endif

   !edges = !this.getedges()
   !angedg = !edges[1]
   !stiffedg = !edges[2]

   !snipsize = 0
   -- TOAX line of stiffener
   !mline = object LINE(!this.stiff.plst.toax, !this.stiff.plen.toax)

   -- edge pline of angle section
   !angline = object LINE(!this.sctn.plst.$!angedg, !this.sctn.plen.$!angedg)

   -- edge pline of stiffener
   !stline = object LINE(!this.stiff.plst.$!stiffedg, !this.stiff.plen.$!stiffedg)

   -- size of stiffener
   !stiffsize = !mline.distance(!stline)

   --distance from edge of stiff to edge of angle
   !m2 = !angline.distance(!stline)

   -- distance from from stiff. TOAX to to edge of angle
   !m3 = !mline.distance(!angline)

   if (!m2 + !m3) gt !stiffsize then
   -- edge of angle profile is "outside" of stiffener
      !snipsize = 25mm + !m2
   else
   -- edge of angle profile is "within" stiffener
      if !m2.lt(25mm) then
         !snipsize = 25mm - !m2
      endif
   endif

--$P
--$P-----------------------------------------------------------------------------
--$P ** q var !mline !angline !stline !stiffsize
--q var !mline !angline !stline !stiffsize
--$P
--$P ** !this.checksize(!snipsize,!angedg) ** line 426 object method is !!mdssnipe.calculate()
--$P q var !stiff.fullname !this.sctn.fullname
--q var !this.stiff.fullname !this.sctn.fullname
--$P
--$P ** q var !m2 !m3 !snipsize !angedg !stiffedg **
--q var !m2 !m3 !snipsize !angedg !stiffedg
--$P<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<***********************************


   !error = !this.checksize(!snipsize,!angedg)
   if !error.eq(1) then
      !snipsize = 0
   elseif !error.eq(2) then
      return error 1 'Snipe size is too big'
   endif

   !this.setsize(!snipsize,!snipsize)

endmethod


-- resolve snipe completely
----------------------------------------------------------------------------------------------
define method .resolve()

   if !this.sctn.badref().not().and(!this.stiff.badref().not()).not() then
      return error 1 'Snipe cannot be calculated'
   endif

   !joiref = !this.sctn.joi$!<this.end>
   if !joiref.badref().not() then
      return error 2 'Snipe cannot be created at the end where section is connected'
   endif

   !this.calculate()
      handle 1
        if !this.snipe.badref().not() then
           !this.deletesnipe()
        endif
        return error 3 'Snipe could not be calculated - $!!error.text'
      elsehandle ANY
        return error 4 'Snipe could not be calculated - $!!error.text'
      endhandle

   !zerosize = !this.leng.eq(0).or(!this.widt.eq(0))
   !snipeexist = !this.snipe.badref().not()
   if  !zerosize then
     if !snipeexist then
           !this.deletesnipe()
        return
     endif
   else
      if !snipeexist then
         !this.modify()
      else
         !this.create()
      endif
   endif

endmethod


-- set snipe size
----------------------------------------------------------------------------------------------
define method .setsize(!leng is REAL, !widt is REAL)

    !rleng = !leng
    if !leng.unset() then
       !rleng = 0
    endif
    !rwidt = !widt
    if !widt.unset() then
       !rwidt = 0
    endif

    -- round off value

    if (!!isImperialLength('DIST').not()) then
       !rleng = !rleng.nint()
       !rwidt = !rwidt.nint()
    else
       !fmt = !!distancefmt
       !fmt.denominator = 24
       !sleng = !rleng.string(!fmt)
       !swidt = !rwidt.string(!fmt)
       !rleng = $!sleng
       !rwidt = $!swidt
    endif

    !this.leng = !rleng
    !this.widt = !rwidt

endmethod


-- check snipe size
----------------------------------------------------------------------------------------------
define method .checksize(!size is REAL,!pline is STRING) is REAL
-- return 1 if less than minimum
-- return 2 if greater than maximum
-- return 0 if size is OK
--$P****************line 520*************************************************************************
--$P ** check passed size against minimal size **
--q var !size !this.minsize

   -- check passed size against minimal size
   if !size.lt(!this.minsize) then
        return 1
   endif

   -- compose maximum size of snipe - should not be greater than leg length minus angle thickness
   if !pline.eq('RTTA') then
      !maxsize = !this.sctn.para[2] - !this.sctn.para[3]
   else
      !maxsize = !this.sctn.para[1] - !this.sctn.para[3]
   endif
   -- make sure that MaxSize is in current units - params are always in MM!!
   !maxsize = $!maxsize

--$P***************line 560**************************************************************************
--$P *** method.checksize(!size is REAL,!pline is STRING) is REAL..........................
--q var !size !maxsize
--$P=====================

   if !size.gt(!maxsize) then
      return 2
  endif

   return 0

endmethod

-- delete dnipe
----------------------------------------------------------------------------------------------
define method .deletesnipe()

   !!ce = !this.snipe
   !this.snipe = nulref
   delete $!!ce.type

endmethod
