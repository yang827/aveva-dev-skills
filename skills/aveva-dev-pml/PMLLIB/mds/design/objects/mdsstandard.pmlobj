---
--------------------------------------------------------------------------------
-- Description:
--
-- PML Object to determine if the MDS DEFAULTS exist for the MDS Standard
-- and if it is ACTIVE for the current PDMS Project
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsstandard(STRING,REAL,STRING)  MDSSTANDARD
--
define object MDSSTANDARD

  -- MDS Standard TYpe
  member .type is STRING

  -- MDS Standard Code
  member .code is STRING

  -- MDS Standard Bore
  member .bore is REAL

  -- Continue if MDS Standard SECTION and Bore Size CATEGORY
  -- exists and it is ACTIVE for the current PDMS Project
  member .continue is BOOLEAN

  -- MDS Standard CATALOGUE "SECTION" -- ALL BORE SIZES
  member .section is DBREF

  -- MDS Standard "SECTION" Active -- ALL BORE SIZES
  member .sactive is BOOLEAN

  -- MDS Standard CATALOGUE "SECTION" -- ALL BORE SIZES -- Does it EXIST
  member .sexists is BOOLEAN

  -- MDS Standard CATALOGUE "SECTION" -- ALL BORE SIZES -- Message
  member .smess is STRING

  -- MDS Standard CATALOGUE "CATEGORY" -- A SINGLE BORE SIZE
  member .category is DBREF

  -- MDS Standard "CATEGORY" Active -- A SINGLE BORE SIZE
  member .cactive is BOOLEAN

  -- MDS Standard CATALOGUE "CATEGORY" -- A SINGLE BORE SIZE -- Does it EXIST
  member .cexists is BOOLEAN

  -- MDS Standard CATALOGUE "CATEGORY" -- A SINGLE BORE SIZE -- Message
  member .cmess is STRING

endobject
-- End of Object Definition
--
--------------------------------------------------------------------------------
--Construction Method
--
-- MDS Defaults CATALOGUE Check that a MDS Standard exists and
-- is it ACTIVATED for use with the current PDMS Project.
--
-- <1> - CHECKS the BORE SIZE SECTION and CATEGORY elements of
-- MDS Standard types ANCILLARY, TRUNNION and PRELIMINARY
--    or
-- <2> - CHECKS the "GENERAL" SECTION and CATEGORY elements of
-- MDS Standard types STRU and HANG
--
--------------------------------------------------------------------------------
--
--define method .mdsstandard(!mdsstd is STRING, !bore is REAL) is MDSSTANDARD
define method .mdsstandard(!mdsstd is STRING, !bore is REAL, !stringval is STRING) is MDSSTANDARD
  --
  -- **********************************************
  -- ***************
  -- IMPORTANT NOTES
  -- ***************
  -- <a> - When the variable !stringval = |GENERAL|, the !bore value<any size> is ***IGNORED*** and the .bore
  -- object member is SET to "Unset" in the returned PML OBJECT and the existence of the MDS Standard CATEGORY
  -- ".../GEN" is CHECKED, but the value of the :mdsactive value at this "GENERAL" CATEGORY is ***IGNORED***
  --
  -- <b> - When the variable !stringval = ||, or anything other than |GENERAL|, !stringval is ***IGNORED** and
  -- the !bore value<any size>, is set in the .bore object member, and the BORE SIZE MDS Standard CATEGORY
  -- is CHECKED for existence and the :mdsactive value is CHECKED
  --
  -- **********************************************
  --
  -- List of the VALID names of the MDS DEFAULTS PARAGON CATALOGUE Elements that
  -- MUST exist in the MDS DEFAULTS CATALOGUE DB for the current PDMS Project
  --
  -- <1> - /MDS/ATTA/DEFAULTS
  -- <2> - /MDS/HANGER/DEFAULTS
  -- <3> - /MDS/STRUCTURE/DEFAULTS
  -- <4> - /MDS/TRUNNION/DEFAULTS
  -- <5> - /MDS/PRELIMINARY/DEFAULTS
  --
  --------------------------------------------------------------------------------
  --
  -- Initialise Variables
  !generaldata = FALSE
  !this.code = !mdsstd.upcase()
  !this.bore = !bore
  !this.continue = FALSE
  !cbore = !bore.real().value().string()
  !sxsts = FALSE
  !cxsts = FALSE
  !catas = ARRAY()
  !catas.append(|/MDS/ATTA/DEFAULTS|)
  !catas.append(|/MDS/HANGER/DEFAULTS|)
  !catas.append(|/MDS/STRUCTURE/DEFAULTS|)
  !catas.append(|/MDS/TRUNNION/DEFAULTS|)
  !catas.append(|/MDS/PRELIMINARY/DEFAULTS|)

  -- ************************************************************************************************
  -- Determine if the CATALOGUE SECTION Exists for the MDS Standard
  do !indx indices !catas
    -- Try and Navigate to the CATALOGUE SECTION
    !snam = !catas[!indx] & |/| & !mdsstd.upcase()
    !unusedsdbf = !snam.dbref()
    handle NONE
      -- CATALOGUE SECTION Exists
      !sxsts        = TRUE
      !this.type    = !snam.dbref().gtype
      !this.section = !snam.dbref()
      !this.sexists = !sxsts
      !this.sactive = !snam.dbref().:mdsactive

      -- CHECK if the MDS Standard "GENERAL" CATEGORY Data is being Processed
      if (!stringval.upcase().eq(|GENERAL|)) then
        -- UNSET the VALUE of the .bore member when the !stringval = GENERAL
        !this.bore = REAL()
        -- The variable !cbore is a STRING, therefore set its value to "GEN"
        -- to CHECK the ".../GEN" CATEGORY exists in the MDS Defaults PARAGON CATALOGUE
        !cbore = |GEN|
        -- ONLY SET the "GENERAL" Data BOOLEAN variable to TRUE for STRU and HANG types
        !generaldata = TRUE
      endif

      -- Break when the MDS DEFAULTS PARAGON CATALOGUE -- SECTION element Exists
      break

    elsehandle ANY
      -- Undefined CATALOGUE SECTION <DBREF> Name
      !this.sexists = !sxsts
      !this.sactive = !sxsts
      skip

    endhandle

  enddo

  -- RETURN if the CATALOGUE SECTION does NOT exist for the MDS Standard
  if (!this.sexists.not()) then
    !this.smess =|ERROR: The MDS Standard DEFAULTS CATALOGUE SECTION $!<snam> does NOT EXIST|
    return !this

  endif

  -- RETURN if the CATALOGUE SECTION is NOT ACTIVE for the MDS Standard
  if (!this.sactive.not()) then
    !this.smess = |ERROR: The MDS Standard DEFAULTS CATALOGUE SECTION $!<snam> is DEACTIVATED for the current PDMS Project|
    return !this

  endif

  -- ************************************************************************************************
  -- Determine if the CATALOGUE SECTION-CATEGORY Exists for the MDS Standard -- BORE SIZE
  -- However when !stringval = GENERAL -- CHECK the MDS Standard .../GEN CATEGORY instead
  !cnam = !snam & |/| & !cbore
  !unusedcdbf = !cnam.dbref()
  handle NONE
    -- CATALOGUE CATEGORY below the SECTION Exists
    !cxsts         = TRUE
    !this.category = !cnam.dbref()
    !this.cexists  = !cxsts
    !this.cactive  = !cnam.dbref().:mdsactive

  elsehandle ANY
    -- Undefined CATALOGUE SECTION <DBREF> Name
    !this.cexists = !cxsts
    !this.cactive = !cxsts

  endhandle

  -- SET the ERROR text to suit the MDS Standard type and ONLY
  -- CHECK the UDA :mdsactive at the CATEGORY element where a BORE SIZE
  -- is applicable, i.e. MDS Standard types ANCILLARY, TRUNNION and PRELIMINARY ONLY
  if (!generaldata) then
    -- The MDS Standard "GENERAL" CATEGORY UDA :mdsactive
    -- is controlled from its OWNING SECTION element
    -- MDS Standard types STRUCTURE and HANGER
    !boresize = |GENERAL Category|
    !this.cactive = TRUE

  else
    -- MDS Standard types ANCILLARY, TRUNNION and PRELIMINARY
    !boresize = |Bore Size $!<cbore>|

  endif

  -- RETURN if the CATALOGUE SECTION-CATEGORY does NOT exist for the MDS Standard
  !mdsstdupc = !mdsstd.upcase()
  if (!this.cexists.not()) then
    !this.cmess =|ERROR: The MDS Standard $!<mdsstdupc> $!<boresize> - DEFAULTS CATEGORY $!<cnam> does NOT EXIST|
    return !this

  endif

  -- RETURN if the CATALOGUE SECTION-CATEGORY is NOT ACTIVE for the MDS Standard
  if (!this.cactive.not()) then
    !this.cmess = |ERROR: The MDS Standard $!<mdsstdupc> $!<boresize> - DEFAULTS CATEGORY $!<cnam> is DEACTIVATED for the current PDMS Project|
    return !this

  endif

  -- RETURN the Object when Everything Exists and is ACTIVE for the current PDMS Project
  !this.continue = TRUE
  !this.smess    = ||
  !this.cmess    = ||
  return !this

endmethod
--
--------------------------------------------------------------------------------
