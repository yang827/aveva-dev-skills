--------------------------------------------------------------------------------
-- method to get the appropriate ppoints for brackets which can be rotated
-- p9 is the ppoint unrotated and p10 is the ppoint when rotated
define method .getppointpos(!fitt is dbref) is position

  -- p9 has been modified so that it works in both bangles
    return !fitt.ppos[9].wrt(/* )

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to get the distance from top and bottom trays to the vertical member
define method .getdist()

    var !traybars coll all sctn with match(name,'-BAR-') gt 0 for $!this.support
    var !elevval eval (poss wrt world) for all from !traybars
    !up = ARRAY()
    do !a values !elevval
      !pos = $!A
      !up.append(!pos.up)
    enddo
    var !lengths eval leng for all from !traybars
    var !directions eval (drns in world)  for all from !traybars
    var !trays eval :mdsattaref for all from !traybars
--    !index = !elevval.sortedindices()
    !index = !up.sortedindices()
    !traybars.reindex(!index)
    !elevval.reindex(!index)
    !lengths.reindex(!index)
    !directions.reindex(!index)
    !trays.reindex(!index)
    !this.trayrefs = !trays
    !this.traybars = !traybars
    !this.trayelevations = !elevval
    !this.traywidths = !lengths
    !this.bardirs = !directions
    !bottombar = !traybars[1].dbref()
    handle ANY
        -- handle the error if there are no trays
    elsehandle NONE
       !topbar = !traybars[!traybars.size()].dbref()
       !poss = max(!this.v1.poss.up,!this.v1.pose.up)
       !pose = min(!this.v1.poss.up,!this.v1.pose.up)
    endhandle

    if     !this.type.eq('FR01') then
        -- distu not needed
        !this.distu = 'NIL'
        -- distd is the dist from the bottom tray to the bottom of steel
        !this.distd = STRING(nint(!bottombar.poss.up - !pose))
    elseif !this.type.eq('FR02') then
        -- distd not needed
        !this.distD = 'NIL'
        -- distu is the dist from the top tray to the top of steel
        !this.distu = STRING(nint(!poss - !topbar.poss.up))
    elseif !this.type.eq('FR03') then
        -- both needed
        !this.distu = STRING(nint(!poss - !topbar.poss.up))
        !this.distd = STRING(nint(!bottombar.poss.up - !pose))
    elseif !this.type.eq('FR04') then
        -- nothing required
        !this.distd = 'NIL'
        !this.distu = 'NIL'
    elseif !this.type.eq('FR05') then
        !this.distu = 'NIL'
        -- we need the distance from the top fitting p9 to the top tray as distd
        !this.distd = STRING(nint(!this.connection1.ppos[9].wrt( /* ).up - !topbar.poss.wrt(/* ).up))
    elseif !this.type.eq('FR06') then
        -- we need the distance from the bottom fitting p9 to the top tray as distu
        --q var !this.bottombar.poss.wrt(/* ).up
        !this.distu =  STRING(nint(!bottombar.poss.wrt(/* ).up - !this.connection1.ppos[9].wrt( /* ).up ))
        !this.distd = 'NIL'
    elseif !this.type inset('FR07','FR13') then
        -- both needed
        !this.distu = STRING(nint(!poss - !topbar.poss.up))
        !this.distd = STRING(nint(!bottombar.poss.up - !pose ))
        -- need to add the length of the offset member to the appropriate direction
        -- !plines = object mdsplines(!this.v1,!this.fixedanchor.dbref())
        -- q var !plines
    elseif !this.type  inset('FR08','FR09','FR10','FR11','FR14','FR15') then
        -- nothing required
        !this.distd = 'NIL'
        !this.distu = 'NIL'
    elseif !this.type.eq('FR12') then
       -- both needed
        !this.distu = STRING(nint(!poss - !topbar.poss.up))
        !this.distd = STRING(nint(!bottombar.poss.up - !pose ))
    elseif !this.type.eq('FR13') then
        !this.distd = 'NIL'
        !this.distu = 'NIL'
    endif

endmethod
--------------------------------------------------------------------------------



--------------------------------------------------------------------------------
-- method to get the fixed and flexible bearings
define method .getbearings()

-- set a default for both anchor plates
!this.fixedanchor = 'NIL'
!this.flexiblebearing = 'NIL'
!this.fixedbang   = 0
!this.flexbang    = 0

  -- first deal with the items which only have one anchor plate
  if !this.type inset('FR01','FR02','FR03') then
     -- its fitting1 of V1
     -- set the length of the vertical member
     !this.sl = !this.v1.leng
     if !this.type inset('FR01','FR02') then
       !this.sl = !this.v1.leng + 20
     endif
     var !fitt coll all fitt for $!this.v1
     !fitting = !fitt[1].dbref()
     !this.connection1 = !fitting
     !this.fixedbang   = !fitting.bang
     !this.fixedanchor = !this.getanchor(!fitting)
     !this.flexiblebearing = 'NIL'
     -- the following have offset single anchor plates
  elseif !this.type inset('FR05','FR06','FR07') then
     !this.sl = !this.v1.leng
     if !this.type inset('FR05','FR06') then
       !this.sl = !this.v1.leng + 110
     endif
     var !sctn coll all sctn with match(name,'H1') gt 0 for $!this.support
     !sctnh1 = !sctn[1].dbref()
     var !fitt coll all fitt for $!sctnh1
     !fitting = !fitt[1].dbref()
     !this.connection1 = !fitting
     !this.fixedbang   = !fitting.bang
     !this.fixedanchor = !this.getanchor(!fitting)
     !this.flexiblebearing = 'NIL'
     -- the following have fixed and flexible anchor plates
  elseif !this.type inset('FR04','FR12') then
     -- set the length of the vertical member
     !this.sl = !this.v1.leng
     if !this.type.eq('FR04') then
        !this.sl = !this.v1.leng + 40
     endif
     var !fitt coll all fitt for $!this.v1
     !fitting = !fitt[1].dbref()
     !this.connection1 = !fitting
     !this.fixedbang   = !fitting.bang
      !this.fixedanchor = !this.getanchor(!fitting)
     !fitting  = !fitt[2].dbref()
     !this.flexbang   = !fitting.bang
     !this.connection2 = !fitting
     !this.flexiblebearing = !this.getanchor(!fitting)
  elseif !this.type.eq('FR08') then
     -- set the length of the vertical member
     !this.sl = !this.v1.leng + 40
     var !sctn coll all sctn with match(name,'-H') gt 0 for $!this.support
     !sctnh1 = !sctn[1].dbref()
     !sctnh2 = !sctn[2].dbref()
     var !fitt coll all fitt for $!sctnh1
     !fitting = !fitt[1].dbref()
     !this.connection1 = !fitting
     !this.fixedbang    = !fitting.bang
     !this.fixedanchor = !this.getanchor(!fitting)
     var !fitt coll all fitt for $!sctnh2
     !fitting   = !fitt[1].dbref()
     !this.connection2 = !fitting
     !this.flexbang   = !fitting.bang
     !this.flexiblebearing = !this.getanchor(!fitting)
  elseif !this.type.eq('FR09') then
     -- set the length of the vertical member
     !this.sl = !this.v1.leng + 40
     var !fitt coll all fitt for $!this.v1
     !fitting = !fitt[1].dbref()
     !this.connection1 = !fitting
     !this.fixedbang   = !fitting.bang
      !this.fixedanchor = !this.getanchor(!fitting)
     !fitting  = !fitt[2].dbref()
     !this.flexbang   = !fitting.bang
     !this.connection2 = !fitting
     !this.flexiblebearing = !this.getanchor(!fitting)
  elseif !this.type.eq('FR10','FR14') then
     -- fr10 may have more than two fittings but we can only deal with 2
     -- we need to collect the full list and sort out just the top and bottom
      !this.sl = !this.v1.leng
      var !fitt coll all fitt for $!this.v1
      if !fitt.size().lt(2) then
         !fitting = !fitt[1].dbref()
         handle ANY
            return
         endhandle
         !this.connection1 = !fitting
         !this.fixedbang   = 0
         !this.fixedanchor = !this.getanchor(!fitting)
         !this.flexiblebearing = 'unset'
      else
        -- get the zdist of all of the fittings
        do !a index !fitt
           !pos[!a] = !fitt[!a].dbref().position.wrt(/* ).up
        enddo
        --var !pos eval up wrt world for all from !fitt
        -- sort the zdistances so that they start from lowest to highest
        -- lowest zdistance is at the top of the bar
        !sortedpos = !pos.sortedindices()
        !fitt.reindex(!sortedpos)
        !fitt.invert()
        !fitting = !fitt[1].dbref()
        !this.connection1 = !fitting
        !this.fixedbang   = 0
        !this.fixedanchor = !this.getanchor(!fitting)
        -- now do the flexible bearing
        !fitting = !fitt[!fitt.size()].dbref()
        !this.connection2 = !fitting
        !this.flexbang   = 0
        !this.flexiblebearing = !this.getanchor(!fitting)
      endif

  elseif !this.type.eq('FR11','FR15') then
      !this.sl = !this.v1.leng
      !support = stru of $!this.v1
      var !sctns coll all sctn with (match(name,'$!this.v1.name') gt 0) and (match(name,'-H') gt 0) for $!support
      if !sctns.size().lt(2) then
         !sctn =  !sctns[1].dbref()
         handle ANY
            return
         endhandle
         var !fitt coll all fitt for $!sctn
         !fitting = !fitt[1].dbref()
         !this.connection1 = !fitting
         !this.fixedbang   = 0
         !this.fixedanchor = !this.getanchor(!fitting)
         !this.flexiblebearing = 'unset'
      else
        -- get the zdist of all of the sections
        var !pos eval up in world for all from !sctns
        -- convert the array to real
        !newpos = ARRAY()
        do !a values !pos
          !newpos.append(!a.real())
        enddo
        -- sort the zdistances so that they start from lowest to highest
        -- lowest zdistance is at the top of the bar
        !sortedpos = !newpos.sortedindices()
        !sctns.reindex(!sortedpos)
        !sctns.invert()
        !fitting = fitt 1 of $!sctns[1]
        !this.connection1 = !fitting
        !this.fixedbang   = 0
        !this.fixedanchor = !this.getanchor(!fitting)
        -- now do the flexible bearing
        !lastno = !sctns.size()
        !fitting = fitt 1 of $!sctns[$!lastno]
        !this.connection2 = !fitting
        !this.flexbang   = 0
        !this.flexiblebearing = !this.getanchor(!fitting)
      endif
  elseif !this.type.eq('FR13') then
     -- set the length of the vertical member
     !this.sl = !this.v1.leng
     var !sctn coll all sctn with match(name,'-H') gt 0 for $!this.support
     !sctnh1 = !sctn[1].dbref()
     !sctnh2 = !sctn[2].dbref()
     var !fitt coll all fitt for $!sctnh1
     !fitting = !fitt[1].dbref()
     !this.connection1 = !fitting
     !this.fixedbang    = !fitting.bang
     !this.fixedanchor = !this.getanchor(!fitting)
     var !fitt coll all fitt for $!sctnh2
     !fitting   = !fitt[1].dbref()
     !this.connection2 = !fitting
     !this.flexbang   = !fitting.bang
     !this.flexiblebearing = !this.getanchor(!fitting)
  else
     !!alert.error('Type of support is Undefined')
     return
  endif


endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to get and return the connection for a fitting if its valid
define method .getanchor(!fitt is dbref) is STRING

   !connections = !fitt.:mdsancref

   if undefined(!connections[1]) then
      return 'NIL'
   elseif  !connections[1].badref() then
      return 'NIL'
   else
      -- next check for invalid return references and delete the
     if !connections[1].:mdsancref.findfirst(!fitt).set() then
       return !connections[1].name
     else
       return 'NIL'
     endif
   endif

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .getriser()

    if !this.support.type.eq('SCTN') then
      !this.riser = 'NO'
    else
      var !x :FRA.E_TYP of $!this.support
        handle ANY
          !x = 'NO'
        endhandle
      !this.riser = !x
    endif

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .getroomnumber()

  if !this.support.type.neq('SCTN') then
    !!ce = !this.support
    frmw 1
    var !roomnumber :FRA.ROOM_KKS
      handle ANY
        !roomnumber = '0000'
      endhandle
    !this.roomnumber = !roomnumber
  else
    !!ce = !this.support
    frmw
    var !roomnumber :FRA.ROOM_KKS
    !this.roomnumber = !roomnumber
  endif

  if !this.roomnumber eq |unset| then
      !this.roomnumber = ||
  endif

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .getsctndata()

   if !this.support.type.eq('SCTN') then
      !this.v1 = !this.support
   else
      -- find V1
      var !sctn coll all sctn with match(name,'V1') gt 0 for $!this.support
      !this.v1 = !sctn[1].dbref()
      handle ANY
       !name = !this.support.namn
       !this.outputline = '$!name Support has no valid members'
       return error 661
      endhandle
      if  !this.type.eq('FR07') then
         -- find H1
         var !sctn coll all sctn with match(name,'H1') gt 0 for $!this.support
         !this.h1 = !sctn[1].dbref()
         handle ANY
          !name = !this.support.namn
          !this.outputline = '$!name Support has no Horizontal Members'
          return error 661
         endhandle
      endif

   endif
   -- get the section size
   !this.sectionsize = !this.v1.prop.desc
   -- get the material
   !this.material = !this.v1.matref.desc


endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .getname()

   !this.supportnumber = !this.support.namn
   !this.outputline = !this.supportnumber & ' Data Error'

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .gettype() is BOOLEAN

   if !this.support.:mdssupptype inset('FR01','FR02','FR03','FR04','FR05','FR06','FR07','FR08','FR09','FR10','FR11','FR12','FR13','FR14','FR15') then
      !this.type = !this.support.:mdssupptype
      return TRUE
   else
      !this.type = 'unset'
      return FALSE
   endif

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .opendb()

  external open 'ODBC'  !!xx as 'DSN=supports;UID=Admin;PWD=pdms;'
  handle (79,4)
    !!Alert.Error(!!Error.text & ' - Check drive mapping.')
    return error 1 noalert
  elsehandle any
    !!Alert.Error(!!Error.text)
    return error 1 noalert
  endhandle

endmethod
--------------------------------------------------------------------------------



--------------------------------------------------------------------------------
define method .closedb()

external close $!!xx

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .insertrecord(!table is STRING,!support is STRING)

--table is supports
--key is support number
--field is section

    external send $!!CRPIMS start
      |insert into $!table ("support number")|
      |values ('$!support')|
    end


endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .updaterecord(!table is STRING,!support is STRING,!column is STRING,!value is STRING)

--table is supports
--key is support number
--field is section

    external send $!!CRPIMS start
      |insert into $!table ("support number")|
      |values ('$!support')|
    end


endmethod
