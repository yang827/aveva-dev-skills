--------------------------------------------------------------------------------
-- method to output the line data for the whole tray
-- input parameter is either 'PRINT' to print it to the command line
-- or a filename
define method .outputdata()

   !outputline = |SUP|
   !outputline =  !outputline & '|' & !this.supportnumber
   !this.opendb()
     !this.writerecord('supports',!this.supportnumber )
   !this.closedb()
 --  if !this.type inset('FR09','FR10','FR11','FR14','FR15') then
 --    !outputline = !outputline & 'type $!this.type not yet implemented'
 --    golabel /print
 --  endif
   !outputline = !outputline & '|' & !this.type
   !outputline = !outputline & '|' & !this.sectionsize
   !outputline = !outputline & '|' & !this.material
   !outputline = !outputline & '|' & !this.roomnumber
   !outputline = !outputline & '|' & !this.riser
  -- if !this.type inset('FR11','FR15') then
  --   !this.outputline = !outputline
  --   !this.outputdata.append(!outputline)
  --   golabel /print
  -- endif
   !outputline = !outputline & '|' & !this.fixedanchor
   !outputline = !outputline & '|' & !this.fixedbang
   !outputline = !outputline & '|' & !this.flexiblebearing
   !outputline = !outputline & '|' & !this.flexbang
   !outputline = !outputline & '|' & !this.fixeddx
   !outputline = !outputline & '|' & !this.fixeddy
   !outputline = !outputline & '|' & !this.fixeddz
   !outputline = !outputline & '|' & !this.flexdx
   handle ANY
        q var !this
   endhandle
   !outputline = !outputline & '|' & !this.flexdy
   !outputline = !outputline & '|' & !this.flexdz
   !outputline = !outputline & '|' & !this.SL
   !outputline = !outputline & '|' & !this.distu
   !outputline = !outputline & '|' & !this.distd
 --  commented out because Framatome want the number of trays to appear as zero in all cases
   !outputline = !outputline & '|' & !this.traybars.size()
   --!outputline = !outputline & '|' & '0'

   !this.outputline = !outputline
   !this.outputdata.append(!outputline)

   if  !this.type inset('FR09','FR10','FR11','FR14','FR15') then
        golabel /print
   endif


   -- now loop through the individual traydata.
   do !a index !this.traybars
       !outputline = 'TRA'
       !outputline = !outputline & '|' & !this.supportnumber
       !outputline = !outputline & '|' & !this.trayelevations[!a].position().up.string()
       !outputline = !outputline & '|' & !this.trayrefs[!a].dbref().owner.namn
       handle ANY
            !outputline = !outputline & '|' & 'unset'
       endhandle
       !outputline = !outputline & '|' & !this.traywidths[!a]
       !outputline = !outputline & '|' & !this.bardirs[!a]
       !this.outputdata.append(!outputline)
   enddo

   do !blanklines from !this.traybars.size() + 1 to 20
        !this.outputdata.append('TRA|$!this.supportnumber||||')
   enddo

   label /print
  -- q var !outputline
   !!ce = !this.support


endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to output the line data for the whole tray
-- input parameter is either 'PRINT' to print it to the command line
-- or a filename
define method .outputheader()

   !outputline = 'Code'
   !outputline = !outputline & '|' & 'Name'
   !outputline = !outputline & '|' & 'Type'
   !outputline = !outputline & '|' & 'Section size'
   !outputline = !outputline & '|' & 'Material'
   !outputline = !outputline & '|' & 'Room No'
   !outputline = !outputline & '|' & 'Riser'


   !outputline = !outputline & '|' & 'Fixed Anchor'
   !outputline = !outputline & '|' & 'Fixed Bang'
   !outputline = !outputline & '|' & 'Flex Bearing'
   !outputline = !outputline & '|' & 'Flex Bang'
   !outputline = !outputline & '|' & 'Fixed DX'
   !outputline = !outputline & '|' & 'Fixed DY'
   !outputline = !outputline & '|' & 'Fixed DZ'
   !outputline = !outputline & '|' & 'Flex DX'
   !outputline = !outputline & '|' & 'Flex DY'
   !outputline = !outputline & '|' & 'Flex DZ'
   !outputline = !outputline & '|' & 'Support Rod Length'
   !outputline = !outputline & '|' & 'Dist Up'
   !outputline = !outputline & '|' & 'Dist D'
   !outputline = !outputline & '|' & 'No of trays'

   !this.headingline = !outputline
   !this.headingdata.append(!outputline)

   if !this.type inset('FR09','FR10','FR11','FR14','FR15') then
     !this.headingline = !outputline
     !this.headingdata.append(!outputline)
     golabel /print
   endif
   -- now loop through the individual traydata.
   do !a from 1 to 20

       !outputline = 'Code'
       !outputline = !outputline & '|' & 'Name'
       !outputline = !outputline & '|' & 'Tray ' & !a & ' up'
       !outputline = !outputline & '|' & 'Tray ' & !a & ' Name'
       !outputline = !outputline & '|' & 'Tray ' & !a & ' Bracket Length'
       !outputline = !outputline & '|' & 'Tray ' & !a & ' Bracket Dir'
       !this.headingdata.append(!outputline)
   enddo

   label /print
   --

   !!ce = !this.support

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .getoutput(!heading is BOOLEAN)is ARRAY

 !return = ARRAY()
 if !this.subreps.size().gt(0) then
    do !a values !this.subreps
      !return.appendarray(!a.getoutput(!heading))
    enddo
 else
   if !heading then
     do !a index !this.outputdata
       !templines[1] = !this.headingdata[!a]
       !templines[2] = !this.outputdata[!a]
       !return.appendarray(!this.formatheadings(!templines,'L'))
     enddo
   else
     !return = !this.outputdata
   endif
 endif

 return !return

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to take 2 lines separated by '|' and line the data up
-- justification not yet implemented
define method .formatheadings(!lines is ARRAY,!just is STRING)is ARRAY

if !lines[1].split('|').size().neq(!lines[2].split('|').size()) then
    !size1 = !lines[1].split('|').size()
    !size2 = !lines[2].split('|').size()
    !!alert.error('Error in Format line')
    return !lines
else
   !topline = !lines[1].split('|')
   !bottomline = !lines[2].split('|')
   do !a index !topline
     if !topline[!a].length().gt(!bottomline[!a].length()) then
        do !b from !bottomline[!a].length() to !topline[!a].length() - 1
           !bottomline[!a] = !bottomline[!a] & ' '
        enddo
     elseif !bottomline[!a].length().gt(!topline[!a].length()) then
        do !b from !topline[!a].length() to !bottomline[!a].length() - 1
           !topline[!a] = !topline[!a] & ' '
        enddo
     endif
    enddo

    !return[1] = ''
    !return[2] = ''

    -- now rebuild the line into its original format
    do !a index !topline
       !return[1] =  !return[1] & !topline[!a] & '|'
       !return[2] =  !return[2] & !bottomline[!a] & '|'
    enddo
endif

return !return

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
-- method to get the dx dy dz values for the fixed and bearing plates
define method .getoffsets()

    !this.flexdx = 'NIL'
    !this.flexdy = 'NIL'
    !this.flexdz = 'NIL'

-- get the distance of the fixed anchor from the centreline of the vertical

  !line = object line()
  !line.startposition = !this.v1.poss.wrt(/* )
  !line.endposition   = !this.v1.pose.wrt(/* )
  if !line.startposition.up.lt(!line.endposition.up) then
        -- swap the ends
        !line = !line.reversesense()
  endif

  !connectionpos = !this.connection1.ppos[9].wrt(/* )

  if !this.type.eq('FR09') then
        !this.fixeddx = '0'
        !this.fixeddy = '0'
        !this.fixeddz = '90'
        !this.flexdx  = '0'
        !this.flexdy  = '0'
        !this.flexdz  = '-90'
     return
  elseif   !this.type.eq('FR10') or !this.type.eq('FR11')  or !this.type.eq('FR14') or !this.type.eq('FR15')then
     !traypos = !line.startposition
  else

  -- p5 is the centreline of v1 through the top tray
    !tray = !this.trayelevations[!this.trayelevations.size()]
    !traypos = !tray.position()
  endif

  -- now we need to construct the dx dy dz positions
  !near = !line.near(!traypos)
  !this.fixeddx = STRING(nint(!connectionpos.east - !near.east))
  !this.fixeddy = STRING(nint(!connectionpos.north - !near.north))
  !this.fixeddz = STRING(nint(!connectionpos.up - !near.up)  )


  if !this.type.eq('FR10','FR14') then
        !near = !line.endposition
  endif

  if !this.type inset('FR04','FR08','FR10','FR12','FR13','FR14') then
  -- now we need to construct the dx dy dz positions
    !connectionpos = !this.connection2.ppos[9].wrt(/* )
    handle ANY
       -- there is no connection 2
       return
    elsehandle NONE
      !this.flexdx = STRING(nint(!connectionpos.east - !near.east))
      !this.flexdy = STRING(nint(!connectionpos.north - !near.north))
      !this.flexdz = STRING(nint(!connectionpos.up - !near.up))
    endhandle
  endif


 if !this.type inset('FR11','FR15') then
    !connectionpos = !this.connection1.ppos[9].wrt(/* )
    !near = !line.near(!connectionpos)
    !this.fixeddx = STRING(nint(!connectionpos.east - !near.east))
    !this.fixeddy = STRING(nint(!connectionpos.north - !near.north))
    !this.fixeddz = STRING(nint(!line.startposition.up - !near.up)  )
     -- now we need to construct the dx dy dz positions
    !connectionpos = !this.connection2.ppos[9].wrt(/* )
    !near = !line.near(!connectionpos)
    !this.flexdx = STRING(nint(!connectionpos.east - !near.east))
    !this.flexdy = STRING(nint(!connectionpos.north - !near.north))
    !this.flexdz = STRING(nint(!line.endposition.up - !near.up  )  )
 endif

endmethod
