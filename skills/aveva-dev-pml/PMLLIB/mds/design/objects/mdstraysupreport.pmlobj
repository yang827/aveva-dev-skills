-- Define Object
define object mdstraysupreport

member .support is dbref
member .supportnumber is STRING
member .type is STRING
member .v1 is dbref
member .h1 is dbref
member .connection1 is dbref
member .connection2 is dbref
member .sectionsize is STRING
member .newsectionsize is STRING
member .material is STRING
member .newmaterial is STRING
member .roomnumber is STRING
member .riser is STRING
member .fixedanchor is STRING
member .fixeddx is string
member .fixeddy is string
member .fixeddz is string
member .flexiblebearing is STRING
member .flexdx is STRING
member .flexdy is STRING
member .flexdz is STRING
member .sl is real
member .distu is string
member .distd is string
member .traybars is ARRAY
member .trayelevations is ARRAY
member .traywidths is ARRAY
member .bardirs is ARRAY
member .trayrefs is ARRAY
member .outputline is STRING
member .outputdata is ARRAY
member .headingline is STRING
member .headingdata is ARRAY
member .subreps is ARRAY
member .fixedbang is real
member .flexbang is REAL
member .valid is BOOLEAN
member .modified is BOOLEAN

endobject

-- main constructor method for reporting on a tray structure
--------------------------------------------------------------------------------
define method .mdstraysupreport(!support is dbref)

  if !support.type.neq('STRU') then
    stru
    handle ANY
     !!alert.error('Cannot get to a support from this level')
     return
    endhandle
    !this.support = !!ce
  else
    !this.support = !support
  endif

  -- set the support name
  !this.getname()
  -- set the type of support
  if !this.gettype().not() then
    -- !!alert.error('Support $!this.supportnumber is incorrectly defined')
    !this.outputline = !this.supportnumber & ' is incorrectly defined'
    return
  endif
  -- if the support type is one of the vertical tray supports we need to isolate
  -- the vertical members into new lines for each member.
  -- this is done by calling this object again using a different constructor method
  if !this.type inset('FR09','FR10','FR11','FT14','FR15') then
    -- its a multiple support and needs to be split
    -- collect all of the members with Vn at the end of the name

    do !a from 1
      !nextname = '/' & !this.supportnumber & '-V' & !a
      !test = !nextname.dbref()
      handle ANY
        break
      elsehandle NONE
         !this.subreps.append( object mdstraysupreport(!test,!this.type))
      endhandle
    enddo
    if !this.subreps.size().eq(0) then
        --!!alert.error('Support $!this.supportnumber is incorrectly defined')
        !this.outputline = !this.supportnumber & ' is incorrectly defined'
    endif

    -- subtyping the reports means that we dont need to do any more
    return
  endif

  -- get the support section sizes
  !this.getsctndata()
  handle 661
    return
  endhandle
  -- get the room number
  !this.getroomnumber()
  -- sort out if its an integrated riser or not
  !this.getriser()
  -- get the fixed bearing anchor plate
  !this.getbearings()
  -- go and get the distance values from top and bottom trays
  !this.getdist()
  -- get the plate dxdydz values
  !this.getoffsets()
  -- compile and output the report
  !this.outputdata()
  !this.outputheader()


endmethod
--------------------------------------------------------------------------------

-- constructor method for building individual objects for vertical tray supports
-- types fr09 fr10 fr11 fr14 fr15
--------------------------------------------------------------------------------
define method .mdstraysupreport(!support is dbref,!type is STRING)

  -- passed support is the vertical member
  !this.type = !type
  !this.support = !support

  -- set the support name
  !this.getname()

  -- get the support section sizes
  !this.getsctndata()
  handle 661
    return
  endhandle
  -- get the room number
  !this.getroomnumber()
  -- sort out if its an integrated riser or not
  !this.getriser()
  -- get the fixed bearing anchor plate

   -- commented out because we are not sure what Framatome want
   !this.getbearings()

   -- get the plate dxdydz values
   !this.getdist()
   -- commented out because we are not sure what Framatome want
   !this.getoffsets()
  -- go and get the distance values from top and bottom trays

  -- commented out because we are not sure what Framatome want


  -- get the individual tray data
  --!this.gettrays()
  -- compile and output the report
  !this.outputdata()
  !this.outputheader()

endmethod
--------------------------------------------------------------------------------

-- constructor method for building object based on stress input line
--------------------------------------------------------------------------------
define method .mdstraysupreport(!repline is STRING)

  !parts = !repline.split('|')

  !this.type = !parts[3]
  !supportname = '/' & !parts[2]
  !this.support = !supportname.dbref()
  handle ANY
     !!alert.error('Support $!supportname does not exist - input ignored
     !this.valid = FALSE
  elsehandle NONE
     !this.valid = TRUE
  endhandle

  -- set the support name
  !this.getname()

  -- get the support section sizes
  !this.getsctndata()

  !this.newsectionsize = !parts[4]
  !this.newmaterial = !parts[5]

  if !this.sectionsize.neq(!this.newsectionsize) then
      !this.modifysection()
      !this .modified = TRUE
  endif

  if !this.material.neq(!this.newmaterial) then
      !this.modifymaterial()
      !this .modified = TRUE
  endif
  q var !this
endmethod
