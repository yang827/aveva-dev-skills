--
-- File:  mdsvprmdelete.pmlobj
--   Type:  Object Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:            DESIGN, DRAFT and maybe ISODRAFT in the "near" FUTURE
--   Replaces:
--
-- Author:  Wayne Dodwell
-- Created:  Monday 10th October 2005
--
--
-- Description:
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsvprmbatch(MDSVPRMMTO,VPRMCONFIG) STRING
--  mdsvprmdelete(ARRAY,STRING,STRING,STRING) -
--  mdsvprmdelsupp(MDSVPRMMTO,VPRMCONFIG,STRING) STRING
--  vprmdbtest(ARRAY,STRING)         BOOLEAN
--  vprmfiles(STRING,MDSVPRMDELETE)  -
--
-------------------------------------------------------------------------------
define object MDSVPRMDELETE

  -- Log File Array members
  member .errstart is ARRAY
  member .errarray is ARRAY
  member .errend   is ARRAY

  -- Object for the MDS VPRM MTO LOG File Name
  member .logfile is FILE

  -- Object for the MDS VPRM MTO "Temporary" LOG File Name
  member .tlogfile is FILE

  -- Object Member for the ARRAY of "MASTER" MDS Support "DBREFS" <Normally ONLY [1] iteration>
  member .mdssupport is ARRAY

  -- Object Member for the "MASTER" MDS Support TYPE
  member .mdstype is STRING

  -- Object Member to store the ARRAYS of the MDSVPRMMTO objects <One per MDS SUpport>
  member .mdsvprmmto is ARRAY

  -- Object Member for the START DATE TIME String
  member .mdsvprmstart is STRING

  -- Object Member for the END DATE TIME String
  member .mdsvprmend is STRING

  -- Object Member for the MDS VPRM MTO File Storage Directory
  member .mtodir is FILE

  -- Object for the MDS VPRM MTO File Name
  member .mtofile is FILE

  -- Object Member for the MDS VPRM MTO "Temporary" File Storage Directory
  member .tmtodir is FILE

  -- Object for the MDS VPRM MTO "Temporary" File Name
  member .tmtofile is FILE

  -- Object Member to STORE the MDS to VPRM BATCH HEADER for DELETED or RENAMED MDS Supports
  member .vprmbatch is STRING

  -- Object Member to STORE the MDS to VPRM CONFIGURATIONS
  member .vprmconfig is VPRMCONFIG

  -- Object Member to STORE the MDS to VPRM FILE DELETE Records for each MDS Support Processed
  member .vprmdelete is ARRAY

  -- Object Member for the ERROR Array
  member .vprmerror is ARRAY

  -- Object Member to STORE the MDS to VPRM FILE "LINE" Records for each MDS Support Processed
  member .vprmline is ARRAY

  -- Object Member to STORE the OPTION
  member .vprmoption is STRING

  -- Object Member to STORE the MDS to VPRM DETAIL ("$S,$P,$T,$C,$U") Records for each MDS Support Processed
  member .vprmrecords is ARRAY

  -- Object Member to Store the OPTION
  member .vprmrename is STRING

  -- Object to RETURN for the FILE OBJECT and the ARRAY of ERROR MESSAGES
  member .vprmreturn is MDSVPRMOBJECT

  -- Object Member for VPRM DB Access Test -- ERROR Boolean
  member .vprmtest is BOOLEAN

endobject

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Constructor Method for the object
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R
-- Return:
--    [Data Type]   [Description]
--
--*****************************************************************************
-- NOTE: Before Using this OBJECT ensure that the !support being passed is
--       a VALID MDS Support "TYPE" i.e. a MDS "FRAME", "HANGER" or "ANCILL" returned from
--       the PML function !!mdsabatype.pmlfnc(!support)
-- <1> a MDS STRUCTURE for any MDS FRAMEWORK SUPPORTS or a MDS GROUP,<MDS STANDARD or SPECIAL>
-- <2> a MDS ATTA where the CREF of the ATTA references a MDS HANGER
-- <3> a MDS ATTA for a "STAND-ALONE" MDS ANCILLARY, i.e. an ATTA NOT a part of a MDS STRUCTURE support
--
-- **********************
-- *** IMPORTANT NOTE ***
-- **********************
-- <4> *** MDS TRUNNIONS -- are NOT Processed via the MDS VPRM Interface
--         MDS TRUNNION Material and PLATES etc.. are EXTRACTED via the
--         "PIPING" Discipline, ISODRAFT/VPRM MTO and DRAWING Production
--
--*****************************************************************************
-- *** ANY other MDS Support MEMBERS <ATTAS, PLATES, SCTNS, HELE etc..>
--     should not be passed to this OBJECT
--     i.e "<name>/DATUM <name>/SREF <name>.1" etc... ***
--*****************************************************************************
-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
define method .mdsvprmdelete(!supparr is ARRAY, !option is STRING, !mdstype is STRING, !newsuppname is STRING)

  -- Store the ARRAY of the MDS Support MASTER DBREFS
  !this.mdssupport = !supparr

  -- Store the MDS Support MASTER DBREF <ALWAYS "FRAME" if more than ONE MDS Support DBREF in !supparr>
  !this.mdstype = !mdstype

  -- Set the Option Member
  !this.vprmoption = !option.upcase()

  -- Set the NEW NAME for the MDS Support if RENAMING
  !this.vprmrename = !newsuppname

  -- Initialise ERROR Array etc...
  !errorarray = ARRAY()
  !this.vprmerror = !errorarray
  !this.vprmtest  = FALSE

  -- Set up the object MDSVPRMOBJECT
  !this.vprmreturn = object MDSVPRMOBJECT()

  -- Get the OPTION passed to this OBJECT
  if (!option.eq('DELETE')) then
    !optiontxt = 'DELETED'
  elseif (!option.eq('RENAME')) then
    -- The "RENAME" MDS Support Option will GENERATE a LOG file during the NEW MDS VPRM MTO file GENERATION
    !optiontxt = 'RENAMED'
  endif

  -- Construct START Date Time String
  --  !this.mdsvprmstart = !this.mdsvprmdatetime()
  !mdsvprmstart      = object MDSDATETIMEOBJ()
  !this.mdsvprmstart = !mdsvprmstart.datetimestr

  -- Project Code & Session data
  !proj    = current project
  !code    = !proj.code()
  !projlow = !code.lowcase()
  !projup  = !code
  !projdir = object FILE('%$!<projlow>iso%')

  -- <GE> 07-08-06 added check for VPRM discipline as set in the Gateway config file

  -- Read the VPRM Gateway Config File into a "vprmconfig" OBJECT
  !vprmfilegen  = FALSE
  if (defined(!!vprmexists)) then
    if !!vprmexists then
      !projcfg = object FILE('$!projdir/pdsc01.cfg')
      !vprmcfile = object VPRMCONFIG()
      !vprmcfile.read(!projcfg)
      if !this.mdstype.eq('FRAME') then
        !mdsdatumname = !this.mdssupport[1].name & '/DATUM'
        !mdsdatumdbrf = !mdsdatumname.dbref()
        if (!mdsdatumdbrf.owner.pspe.purp.upcase().eq('HVAC')) then
          if !vprmcfile.mdshvacdelrename then
            !vprmfilegen  = TRUE
            --    $P HVAC Framework
          endif
        elseif (!mdsdatumdbrf.owner.pspe.purp.upcase().eq('TRAY')) then
          if !vprmcfile.mdselecdelrename then
            --             !vprmfilegen  = TRUE
            !vprmfilegen  = FALSE
            --    $P TRAY Framework
          endif
        elseif (!mdsdatumdbrf.owner.pspe.purp.upcase().eq('PIPE')) then
          if !vprmcfile.mdspipedelrename then
            !vprmfilegen  = TRUE
            --     $P PIPE Framework
          endif
        endif
      else
        if !vprmcfile.mdspipedelrename then
          !vprmfilegen  = TRUE
          --    $P PIPE
        endif
      endif
    endif
  endif

  -- Get the PDMS USER ID
  -- Test for "Model OBJECT Manager" running
  -- i.e. the user description is set with the string "login Id:"
  !session = current session
  if (!session.user().description.match('login Id:').neq(0)) then
    !userid = !session.user().description.after('login Id:').before('(').trim()
  else
    !userid = !session.login
  endif

  -- Determine the Project INFO directory and the MDS VPRM MTO "DELETE/RENAME" FILE Storage Directory
  !infodir = object FILE('%$!<code>info%')
  if (!infodir.exists()) then
    !mtodir = object FILE('%$!<code>info%\MDS-VPRM-MTO-FILES')
    --!mtodir = object FILE('%$!<code>info%\MDS-VPRM')
    if (!mtodir.exists().not()) then
      syscom 'mkdir $!mtodir'
    endif

  else
    -- ONLY when the MDS PROJECT INFO Directory DOES NOT EXIST, i.e. !infodir
    -- Use the %PDMSUSER% Directory to create the MDS-VPRM MTO FILE Storage Directory
    !mtodir = object FILE('%pdmsuser%\MDS-VPRM-MTO-FILES')
    --!mtodir = object FILE('%pdmsuser%\MDS-VPRM')
    if (!mtodir.exists().not()) then
      syscom 'mkdir $!mtodir'
    endif
  endif

  -- Load the Object Member .mtodir
  !this.mtodir = !mtodir

  -- Set the Temporary Storage Directory to PDMSWK
  !this.tmtodir = object FILE('%pdmswk%')

  -- Set the MDS VPRM MTO File, but ONLY for the FIRST MDS SUPPORT DBREF in the ARRAY !supparr
  !supportname  = !supparr[1].namn.before('[')
  !mtofilename  = !mtodir.fullname() & '\' & 'MDS-VPRM-' & !supportname & '-' & !option & '-MTO-' & !this.mdsvprmstart & '.dat'
  !this.mtofile = object FILE(!mtofilename)

  -- Set the Temporary MTO file name
  !tmtofilename  = !this.tmtodir & '\' & 'MDS-VPRM-' & !supportname & '-' & !option & '-MTO-' & !this.mdsvprmstart & '.dat'
  !this.tmtofile = object FILE(!tmtofilename)

  -- Set the MDS VPRM LOG File
  !logfilename  = !mtodir.fullname() & '\' & 'MDS-VPRM-' & !supportname & '-' & !option & '-LOG-' & !this.mdsvprmstart & '.log'
  !this.logfile = object FILE(!logfilename)

  -- Set the Temporary LOG file name
  !tlogfilename  = !this.tmtodir & '\' & 'MDS-VPRM-' & !supportname & '-' & !option & '-LOG-' & !this.mdsvprmstart & '.log'
  !this.tlogfile = object FILE(!tlogfilename)

  ---------------------------------------------------------------------------------------------------
  -- Set up the Header Details for the LOG file Array
  !errlogstart = ARRAY()
  -- Log file START etc... is Only required when generating MDS VPRM MTO files from PDMS DRAFT
  !errlogstart.append('_________________________________________________________________________')
  !errlogstart.append('')
  !errlogstart.append('                         MDS SUPPORT VPRM "$!<option>" MTO                           ')
  !errlogstart.append('')
  !errlogstart.append('_________________________________________________________________________')
  !errlogstart.append('')
  !errlogstart.append('LOG file for the "MDS VPRM MTO" $!<option> file:')
  !errlogstart.append(' $!mtofilename')
  !errlogstart.append('_________________________________________________________________________')
  !errlogstart.append('')
  !errlogstart.append('Project    : $!projup')
  !errlogstart.append('User Name  : $!session.name')
  !errlogstart.append('User Login : $!userid')
  !errlogstart.append('Host       : $!session.host')
  !errlogstart.append('Process ID : $!session.uniqueid')
  !errlogstart.append('Date       : $!<mdsvprmstart.daystring> $!<mdsvprmstart.monthstring> $!<mdsvprmstart.year>')
  !errlogstart.append('Time       : $!<mdsvprmstart.hourstring>:$!<mdsvprmstart.minutestring>:$!<mdsvprmstart.secondstring>')
  !errlogstart.append('_________________________________________________________________________')
  --  !errlogstart.append('')
  --  !errlogstart.append('Processing Started:')
  !errlogstart.append('_________________________________________________________________________')
  !errlogstart.append('')
  ---------------------------------------------------------------------------------------------------
  -- Check the PDMS support type is TRAY

  if (defined(!mdsdatumdbrf)) then
    if (!mdsdatumdbrf.owner.pspe.purp.upcase().eq('TRAY')) then
      !errorarray.append('_________________________________________________________________________')
      !errorarray.append('')
      !errorarray.append(' WARNING -- Processing MDS Support: $!<supportname>')
      !errorarray.append(' The MDS VPRM MTO "$!<option>" Record for this MDS Support has *** NOT *** been GENERATED')
      !errorarray.append(' This is due to Areva not supplying the required MTO record fields')
      !errorarray.append('')
      !errorarray.append('_________________________________________________________________________')
      golabel /errorfile
    endif
  endif

  -- Check the PDMS <project>ISO directory exists
  if (!projdir.exists().not()) then
    !errorarray.append('_________________________________________________________________________')
    !errorarray.append('')
    !errorarray.append(' ERROR -- The PDMS directory "$!<projdir>" does not exist for the PDMS "$!projup" project.')
    !errorarray.append(' ERROR -- Aborting the creation of the "MDS VPRM MTO" $!<option> file.')
    !errorarray.append('')
    !errorarray.append('_________________________________________________________________________')
    golabel /errorfile

  else
    --Check the VPRM Gateway Config File EXISTS i.e. <!projup>ISO/pdsc01.cfg
    !projcfg = object FILE('$!projdir/pdsc01.cfg')
    if (!projcfg.exists().not()) then
      !errorarray.append('_________________________________________________________________________')
      !errorarray.append('')
      !errorarray.append(' ERROR -- The VPRM configuration file "$!<projcfg>" does not exist for the "$!projup" project.')
      !errorarray.append(' ERROR -- Aborting the creation of the "MDS VPRM MTO" $!<option> file.')
      !errorarray.append('')
      !errorarray.append('_________________________________________________________________________')
      golabel /errorfile

    else
      -- Read the VPRM Gateway Config File into a "vprmconfig" OBJECT
      !vprmcfile = object VPRMCONFIG()
      !vprmcfile.read(!projcfg)
      !this.vprmconfig = !vprmcfile

      --Temporary Variable for Information
      !!vcfg = !vprmcfile
    endif
  endif

  -- Load and Store an Object "MDSVPRMMTO" for each of the MDS Supports found in the ARRAY !supparr
  do !mdsobj indices !supparr
    !mdssupportmto = object MDSVPRMMTO(!supparr[!mdsobj])
    -- Append the Current MDS Support "MDSVPRMMTO" Object into the Array Object Member .mdsvprmmto
    !this.mdsvprmmto.append(!mdssupportmto)
  enddo

  -- Process the MDS Support Objects
  do !mdsobject indices !this.mdsvprmmto

    -- Determine the "Safety Class<SC>" and the "Quality Class<QC> for the current MDS Support Object
    -- Call the FANP Specific PML CODE used by MDS ABA DRAFT Drawing Utility e.g. !!mdsfragettext(!mdsvprmobj,'SC')
    !classarray  = !!mdsfragettext(!this.mdsvprmmto[!mdsobject],'SC')
    !this.mdsvprmmto[!mdsobject].qualityclass = !classarray[1]
    !this.mdsvprmmto[!mdsobject].safetyclass  = !classarray[2]

    -- Add a Processing the MDS Support Message to the MDS VPRM Log File
    !mdssuppname = !this.mdsvprmmto[!mdsobject].suppname
    if (!option.upcase().eq('DELETE')) then
      !errorarray.append('_________________________________________________________________________')
      !errorarray.append('Processing MDS Support: $!<mdssuppname>' )
    endif

    -- Only Generate the BATCH Header Record ONCE per MDS VPRM MTO file,i.e.
    -- <1> For MDS VPRM "DELETE" MTO Records for a "DELETED" MDS SUPPORT
    -- and
    -- <2> For MDS VPRM "DELETE" MTO Records plus MDS VPRM "RENAME" MTO Records for a "RENAMED" MDS SUPPORT
    if (!mdsobject.eq(1)) then
      -- Construct and Store the MDS VPRM DELETED/RENAMED Support "$B" Record, i.e. The VPRM BATCH HEADER
      -- *** NOTE *** -- Only ONE "$B" BATCH HEADER Record is ever required.
      !this.vprmbatch  = !this.mdsvprmbatch(!this.mdsvprmmto[!mdsobject],!vprmcfile)

      -- Add the VPRM BATCH HEADER Record to the Output ARRAY
      !this.vprmrecords.append(!this.vprmbatch)

    endif

    -- Generate the MDS VPRM MTO Objects for Each of the MDS Supports in !supparr
    -- Construct and Store the MDS VPRM DELETED/RENAMED Support "$X" Record, i.e. The VPRM DELETE RECORD
    !vprmline = STRING()
    -- !vprmline is set by ASSOCIATION in the METHOD !this.mdsvprmdelsupp(...) below
    !vprmdelete = !this.mdsvprmdelsupp(!this.mdsvprmmto[!mdsobject],!vprmcfile, !vprmline)

    if (!vprmline.eq('ERROR')) then
      -- This MDS Support has an "unset" -- VPRM Construction Area at the
      -- "DATUM ATTA" and the Owning PIPE of the "DATUM ATTA"


      -- Add the VPRM LINE Record to the .vprmline ARRAY
      !this.vprmline.append(!vprmline)
      if (!option.upcase().eq('RENAME')) then
        !errorarray.append('_________________________________________________________________________')
        !errorarray.append('Processing MDS Support: $!<mdssuppname>')
        !errorarray.append(' The MDS VPRM MTO "$!<option>" Record for this MDS Support has *** NOT *** been GENERATED')
        !errorarray.append(' ')
        -- Add the VPRM LINE Record to the LOG file ARRAY
        !errorarray.appendarray(!this.mdsvprmmto[!mdsobject].errorarray)

      elseif (!option.upcase().eq('DELETE')) then
        !errorarray.append(' The MDS VPRM MTO "$!<option>" Record for this MDS Support has *** NOT *** been GENERATED')
        !errorarray.append(' ')
        -- Add the VPRM LINE Record to the LOG file ARRAY
        !errorarray.appendarray(!this.mdsvprmmto[!mdsobject].errorarray)

      endif

      -- Clear the !this.vprmrecords ARRAY
      !this.vprmrecords.clear()
      -- Skip and DO NOT PROCESS the Current MDS SUPPORT VPRM MTO "DELETE"/"RENAME" Record
      skip

    else

      -- Add the VPRM DELETE Record to the DELETE ARRAY
      !this.vprmdelete.append(!vprmdelete)
      -- q var !this.vprmdelete

      -- Append the VPRM DELETE Record to the LOG File Array
      if (!option.upcase().eq('DELETE')) then
        --!errorarray.append('Processing MDS Support: $!<mdssuppname>')
        !errorarray.append(' The MDS VPRM MTO "$!<option>" Record for this MDS Support has been GENERATED')
        !errorarray.append(' ')
      endif

      -- Add the VPRM LINE Record to the ARRAY
      !this.vprmline.append(!vprmline)
      -- q var !this.vprmline

      -- Add the VPRM DELETE Record to the Output ARRAY
      !this.vprmrecords.append(!vprmdelete)
      -- q var !this.vprmrecords

      ---------------------------------------------------------------------------------------------------
      -- Only Continue when the !option is "RENAME" to do a
      -- FULL MDS SUPPORT VPRM MTO output for the NEW "RENAMED" MDS SUPPORT

      if (!option.upcase().eq('RENAME')) then

        -- VALID Line Header record
        -- Add the VPRM LINE Record to the Output ARRAY
        !this.vprmrecords.append(!vprmline)

        -- "$U" -- Concatenate the MDS Support Line UDA Records <3 fields>
        !vprmlineuda = !this.mdsvprmmto[!mdsobject].vprmlineuda(!this.mdsvprmmto[!mdsobject],!vprmcfile)

        -- Add the VPRM LINE UDA Records to the Output ARRAY
        !this.vprmrecords.appendarray(!vprmlineuda)

        -- Build LINE Array to Pass to the "VPRMSUBUNIT" method below
        -- VPRM requires the "$L" LINE record before every "$S" SUB-UNIT record
        !vprmlinearray    = ARRAY()
        !vprmlinearray.append(!vprmline)
        -- q var !option
        -- q var !vprmlinearray

        -- The MDS to VPRM MTO Records shown below will be GENERATED via the Object method shown below;
        -- i.e. !vprmrecords = !mdsvprmobj.vprmsubunit(!mdsvprmobj,!vprmconfig)
        --
        -- (3) -- "$S" -- Concatenate the MDS Support SECTION/SUB-UNIT Records
        -- (4) -- "$U" -- Concatenate the MDS Support Component UDA Record
        -- (5) -- "$P" -- Concatenate the MDS Support PART Number Record
        -- (6) -- "$T" -- Concatenate the MDS Support TAG Number Record
        -- (7) -- "$C" -- Concatenate the MDS Support COMPONENT Record
        -- (8) -- "$U" -- Concatenate the MDS Support COMPONENT UDA Record
        !vprmrecords = !this.mdsvprmmto[!mdsobject].vprmsubunit(!this.mdsvprmmto[!mdsobject],!vprmcfile,!vprmlinearray)

        --<wd>aug2006 -- ADD NEW CODE to CHECK the !vprmrecords ARRAY for any ERRORS & LISEGA HANGER "WPAD" Components
        -- Loop thro !vprmrecords and if ANY ERROR exists "REJECT" the Current MDS Support
        -- for MDS VPRM MTO file Generation/VPRM Transfer
        -- When ERRORS exist "REJECT" the Current MDS Support
        !break = FALSE
        do !record indices !vprmrecords
          if (!vprmrecords[!record].matchwild('ERROR')) then
            !errorarray.append('_________________________________________________________________________')
            !errorarray.append('Processing MDS Support: $!<mdssuppname>')
            !errorarray.append(' The MDS VPRM MTO "$!<option>" Record for this MDS Support has *** NOT *** been GENERATED')
            !errorarray.append(' ')
            -- Add the VPRM LINE Record to the LOG file ARRAY
            !errorarray.appendarray(!this.mdsvprmmto[!mdsobject].errorarray)
            !break = TRUE
            break
          endif
        enddo

        if (!break) then
          -- EMPTY the ARRAY !vprmrecords and SKIP this MDS Support
          !this.vprmrecords.clear()
          skip

        else

          -- Check for LISEGA MDS HANGER "WPAD" Plate records in the HANGER SUB UNIT records <$S:03>
          -- and MOVE them into the STEELWORK SUB UNIT records <$S:02> Component records
          if (!!mdshangif.eq('LISEGA')) then
            -- Initialise the MDSVPRM object -- mdsvprmobject.pmlobj
            !mdsreturnobj = object MDSVPRMOBJECT()
            !movevprmrecords = !mdsreturnobj.hangerwpads(!vprmrecords, !vprmline)
            !vprmrecords     = !movevprmrecords
          endif
          --<wd>aug2006
          -- Add the VPRM DETAIL ("$S,$P,$T,$C,$U") Records to the Output ARRAY
          !this.vprmrecords.appendarray(!vprmrecords)

          -- Append the VPRM "NEW" RENAMED Support Record to the LOG File Array
          !errorarray.append('_________________________________________________________________________')
          !errorarray.append('Processing MDS Support: $!<mdssuppname>')
          !errorarray.append(' The MDS VPRM MTO "$!<option>" Record for this MDS Support has been GENERATED')
          !errorarray.append(' ')
          --<wd>aug2006
        endif
        --<wd>aug2006

      endif
      ---------------------------------------------------------------------------------------------------
    endif

  enddo

  -- The ERROR LOG file Label
  label /errorfile

  -- Construct END Date Time String
  !mdsvprmend      = object MDSDATETIMEOBJ()
  !this.mdsvprmend = !mdsvprmend.datetimestr

  -- Set the END Process Complete Date and Time etc...
  !errlogend = ARRAY()
  !errlogend.append('________________________________________________________________________')
  !errlogend.append('Processing Complete: $!<mdsvprmend.hourstring>:$!<mdsvprmend.minutestring>:$!<mdsvprmend.secondstring>  $!<mdsvprmend.daystring> $!<mdsvprmend.monthstring> $!<mdsvprmend.year>')
  !errlogend.append('________________________________________________________________________')
  !errlogend.append('_________________________________________________________________________')

  -- Set up the END of ERROR LOG Array to append to the ERROR LOG file "!errorlog" on "return" of this function
  !errlogend.append('END of LOG file for the "MDS VPRM-MTO" $!<option> file:')
  !errlogend.append(' $!mtofilename')
  !errlogend.append('_________________________________________________________________________')
  !errlogend.append('_________________________________________________________________________')
  !errlogend.append('')
  !errlogend.append('<EOF>')

  -- Store the LOG File ERROR Arrays
  !this.errstart.appendarray(!errlogstart)
  !this.errarray.appendarray(!errorarray)
  !this.errend.appendarray(!errlogend)

  ------------------------------------------------------
  if (defined(!mdsdatumdbrf)) then
    if (!mdsdatumdbrf.owner.pspe.purp.upcase().eq('TRAY')) then
      !this.tlogfile.open('APPEND')
      !this.tlogfile.writefile('APPEND',!this.errstart)
      !this.tlogfile.writefile('APPEND',!this.errarray)
      !this.tlogfile.writefile('APPEND',!this.errend)
      !this.tlogfile.close()
      syscom 'move $!this.tlogfile $!this.mtodir'
    endif
  endif
  ------------------------------------------------------

  -- TEMPORARY FILE WRITING is DONE HERE
  -- during DEVELOPMENT CODING & TESTING ONLY
  --  !this.vprmfiles()

endmethod

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Method .mdsvprmbatch()
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R
-- Return:
--    [Data Type]   [Description]
--
-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
define method .mdsvprmbatch(!mdsvprmobj is MDSVPRMMTO , !vprmcfile is VPRMCONFIG) is STRING

  -- q var !vprmcfile.mdshvacdelrename
  -- q var !vprmcfile.mdspipedelrename
  -- q var !vprmcfile.mdselecdelrename
  -- "$B" -- Concatenate the MDS VPRM MTO BATCH Header <9 fields>
  !option    = !this.vprmoption.lowcase()
  if (!option.upcase().eq('DELETE'))then
    !option = 'Delete'
  elseif (!option.upcase().eq('RENAME'))then
    !option = 'Rename'
  endif
  !vprmbatch = !mdsvprmobj.vprmbatch(!mdsvprmobj,!vprmcfile)
  !vprmbatch = !vprmbatch.replace('::A*',':MTO $!<option>:A*')
  return !vprmbatch

endmethod

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Method .mdsvprmdelsupp()
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R
-- Return:
--    [Data Type]   [Description]
--
-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
define method .mdsvprmdelsupp(!mdsvprmobj is MDSVPRMMTO , !vprmcfile is VPRMCONFIG, !vprmline is STRING) is STRING

  -- "$X" -- Concatenate the MDS Support DELETE Record <6 fields> from the "$L" LINE record
  -- e.g. $X:<constarea>:<mds support name>:::<comment?>*
  !vprmdelete    = !mdsvprmobj.vprmline(!mdsvprmobj,!vprmcfile)

  -- Store the ORIGINAL "$L" VPRM LINE returned from the MDS VPRM MTO object
  !vprmline = !vprmdelete

  -- q var !vprmcfile.mdshvacdelrename
  -- q var !vprmcfile.mdselecdelrename
  -- q var !vprmcfile.mdspipedelrename

  -- <GE> 07-08-06 check the disciplines are set for the rename/delete option is true

  !vprmfilegen  = FALSE
  !support = !mdsvprmobj.support
  !type = !!mdsabatype($!support)
  if !type.eq('FRAME') then
    !mdsdatumname = !support.name & '/DATUM'
    !mdsdatumdbrf = !mdsdatumname.dbref()
    if (!mdsdatumdbrf.owner.pspe.purp.upcase().eq('HVAC')) then
      if !vprmcfile.mdshvacdelrename then
        !vprmfilegen  = TRUE
        --$P HVAC Framework
      endif
    elseif (!mdsdatumdbrf.owner.pspe.purp.upcase().eq('TRAY')) then
      if !vprmcfile.mdselecdelrename then
        !vprmfilegen  = TRUE
        --$P TRAY Framework
      endif
    elseif (!mdsdatumdbrf.owner.pspe.purp.upcase().eq('PIPE')) then
      if !vprmcfile.mdspipedelrename then
        !vprmfilegen  = TRUE
        --$P PIPE Framework
      endif
    endif
  else
    if !vprmcfile.mdspipedelrename then
      !vprmfilegen  = TRUE
      --$P PIPE
    endif
  endif

  -- Convert the "$L" LINE Record into a "$X" DELETE Record for VPRM
  if (!vprmdelete.neq('ERROR')) then
    -- Determine the Correct "$X" VPRM "DELETE" Record <6 fields> from !vprmdelete <a line "$L" record>
    !xrecord = !vprmdelete.split(':')
    !xr    = ARRAY()
    !xr[1] = '$$X'
    !xr[2] = !xrecord[2]
    !xr[3] = !xrecord[3]
    !xr[4] = ''
    !xr[5] = ''
    !xr[6] = 'MTO Delete*'

    -- Concatenate the Correct "$X" VPRM "DELETE" Record <6 fields>
    !vprmdelete = !xr[1] & ':' & !xr[2] & ':' & !xr[3] & ':' & !xr[4] & ':' & !xr[5] & ':' & !xr[6]

  endif

  -- Return the "$L" VPRM LINE Record now converted to a "$X" VPRM DELETE Record
  return !vprmdelete

endmethod

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Method .vprmfiles()
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R
-- Return:
--    [Data Type]   [Description]
--
-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
define method .vprmfiles(!option is STRING, !delobject is MDSVPRMDELETE)

  -- Determine if the OPTION is "DELETE" or "RENAME"
  if (!option.upcase().eq('DELETE')) then
    -------------------------------------------------
    -- For the "DELETE" Option -- Output the ORIGINAL "DELETE" PML Object DATA Records ONLY
    -- IGNORE the passed "DELETE" PML OBJECT for the VPRM "DELETE" Records

    -- Write the MDS VPRM MTO "DELETE" Output File
    --!this.mtofile.open('APPEND')
    --!this.mtofile.writefile('APPEND',!this.vprmrecords)
    --!this.mtofile.close()
    -- Write the TEMPORARY MDS VPRM MTO "DELETE" Output File
    !this.tmtofile.open('APPEND')
    !this.tmtofile.writefile('APPEND',!this.vprmrecords)
    !this.tmtofile.close()

    -- Write the MDS VPRM DELETE -- LOG file
    --!this.logfile.open('APPEND')
    --!this.logfile.writefile('APPEND',!this.errstart)
    --!this.logfile.writefile('APPEND',!this.errarray)
    --!this.logfile.writefile('APPEND',!this.errend)
    --!this.logfile.close()
    -- Write the TEMPORARY MDS VPRM DELETE -- LOG file
    !this.tlogfile.open('APPEND')
    !this.tlogfile.writefile('APPEND',!this.errstart)
    !this.tlogfile.writefile('APPEND',!this.errarray)
    !this.tlogfile.writefile('APPEND',!this.errend)
    !this.tlogfile.close()

  elseif (!option.upcase().eq('RENAME')) then
    -------------------------------------------------
    -- For the "RENAME" Option -- Determine the CORRECT DATA Records to USE from BOTH PML Objects
    -- Concatenate the "determined" DATA Records from BOTH the "RENAME" and the "DELETE" PML Objects

    -- Get the "DELETE" Records for the "" MDS SUPPORT
    !delrecords = !delobject.vprmrecords

    -- <GE> 07-08-06 store the orig name for appending too the $L record
    !oldnames = ARRAY()

    do !delline values !delrecords
      if (!delline.match('$$X').gt(0)) then
        !derecords = !delline.split(':')
        !oldnames.append(!derecords[3])
      endif
    enddo
    -- <GE> 07-08-06

    -- Get the "RENAME" Records from the "RENAMED" MDS SUPPORT
    !renrecords = !this.vprmrecords

    -- Determine the CORRECT DATA Records into a NEW Array
    !conrecords = ARRAY()
    -- Append the "DELETE" Records at the TOP of the CORRECT MDS VPRM MTO "RENAME" Array
    !conrecords.appendarray(!delrecords)
    -- Write and ARRAY of the VALID "RENAME" Records,
    -- i.e. ALL the Records INCLUDING and BELOW the FIRST "$L" Record
    !newrecords = ARRAY()

    do !oldname values !oldnames
      do !line values !renrecords
        if (!line.match('$$B').gt(0)) then
          -- Replace the "DELETE" BATCH HEADER with the "RENAME" BATCH HEADER
          !conrecords[1] = !line
          skip
        endif
        skip if !line.match('$$X').gt(0)
        -- <GE> 07-08-06 write the original name in the $L record
        if !line.match('$$L').gt(0) then
          !lline = !line.split('*')
          !lline[2] = '$!oldname'
          !lline[3] = '*'
          !newline = !lline[1] & !lline[2] & !lline[3]
          !newrecords.append(!newline)
        else
          !newrecords.append(!line)
        endif
        -- <GE> 07-07-06
      enddo
    enddo


    -- Append the VALID "RENAME" Records after the "DELETE" Records in the MDS VPRM MTO "RENAME" Array
    !conrecords.appendarray(!newrecords)
    -- Write the "Concatenated" ARRAY to the MDS VPRM MTO "RENAME" Output File
    --!this.mtofile.open('APPEND')
    --!this.mtofile.writefile('APPEND',!conrecords)
    --!this.mtofile.close()
    -- Write the "Concatenated" ARRAY to the TEMPORARY MDS VPRM MTO "RENAME" Output File
    !this.tmtofile.open('APPEND')
    !this.tmtofile.writefile('APPEND',!conrecords)
    !this.tmtofile.close()

    -- Determine the CORRECT DATA to Output to the -- MDS VPRM "RENAME" LOG File
    !conlogarray = ARRAY()
    -- Append the "DELETE" LOG Messages
    !dellogarray = !delobject.errarray
    !conlogarray.appendarray(!dellogarray)
    -- Append the "RENAME" LOG Messages
    !renlogarray = !this.errarray
    !conlogarray.appendarray(!renlogarray)

    -- Write the MDS VPRM RENAME -- LOG file
    --!this.logfile.open('APPEND')
    --!this.logfile.writefile('APPEND',!this.errstart)
    --!this.logfile.writefile('APPEND',!conlogarray)
    --!this.logfile.writefile('APPEND',!this.errend)
    --!this.logfile.close()
    -- Write the MDS VPRM RENAME -- LOG file
    !this.tlogfile.open('APPEND')
    !this.tlogfile.writefile('APPEND',!this.errstart)
    !this.tlogfile.writefile('APPEND',!conlogarray)
    !this.tlogfile.writefile('APPEND',!this.errend)
    !this.tlogfile.close()
    -------------------------------------------------
  endif

  -- Move the TEMPORARY MDS VPRM MTO File from the PDMSWK directory to the !this.mtodir directory
  --    syscom 'echo .....................................................................................................'
  --    syscom 'echo ... Moving Temporary MTO File $!this.tmtofile to the directory $!this.mtodir '
  syscom 'move $!this.tmtofile $!this.mtodir'
  --    syscom 'echo .....................................................................................................'
  --    syscom 'echo ...'

  -- Move the TEMPORARY MDS VPRM LOG File from the PDMSWK directory to the !this.mtodir directory
  --    syscom 'echo .....................................................................................................'
  --    syscom 'echo ... Moving Temporary LOG File $!this.tlogfile to the directory $!this.mtodir '
  syscom 'move $!this.tlogfile $!this.mtodir'
  --    syscom 'echo .....................................................................................................'
  --    syscom 'echo ...'

endmethod

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Method .vprmdbtest()
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R
-- Return:
--    [Data Type]   [Description]
--
-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
define method .vprmdbtest(!vprmerr is ARRAY, !dummyMdsnamn is STRING) is BOOLEAN

  -- For access directly to the database, check that the required VPRM executables exist
  -- The VPRM DB connection test programme is "dbtext.exe"
  -- The VPRM executable programme for AUTOMATIC VPRM Loading of MDS MTO files is "pdsc02.exe"

  -- Create the VPRM DB TEST file
  --<wd>nov2005
  --  !dbtestfile = object FILE(!this.mtodir & '\MDS-VPRM-' & !mdsnamn.before('[') & '-DB-TEST-' & !this.mdsvprmstart & '.dbchk')
  -- Get a unique number and use it to build a DBTEST file in PDMSUSER
  var !unique unique
  !dbtestfile = object FILE('%PDMSUSER%/db-' & !unique & '.dbtest')
  --<wd>nov2005
  -- OVER Write the VPRM DB TEST File to ensure it EXISTS, even if it is EMPTY
  !dbtestfile.open('OVER')
  !dbtestfile.close()

  -- CHECK For VPRM DB Access when NOT using the VPRM ACCESS TYPE "FILE" option
  !dbaccesstype  = !this.vprmconfig.dbaccess
  if(!dbaccesstype.neq('FILE'))then
    syscom 'echo Attempting to access the VPRM DB.........'

    -- Initialise Variables for the VPRM Executables and Config File
    !dbtestexeobj = object FILE('%pdmsexe%/dbtest.exe')
    !pdsc02exeobj = object FILE('%pdmsexe%/pdsc02.exe')
    !pdsc01cfgobj = !this.vprmconfig.file

    -- Test for VPRM dbtest.exe
    if (!dbtestexeobj.exists().not()) then
      !vprmerr.append('_________________________________________________________________________')
      !vprmerr.append('ERROR -- The VPRM system in NOT available.')
      !vprmerr.append(' View the LOG file $!this.logfile for more details')
      !vprmerr.append('ERROR -- Unable to locate the VPRM executable file' & !dbtestexeobj.name() )
      !vprmerr.append('ERROR --  The MDS VPRM MTO "$!this.vprmoption" file')
      !vprmerr.append(' "$!this.mtofile" ')
      !vprmerr.append('ERROR --  has been GENERATED, but it has *** NOT been LOADED *** into the VPRM SYSTEM')
      syscom 'echo ERROR -- The VPRM system in NOT available.'
      return FALSE
    endif

    -- Test for pdmsc02
    if (!pdsc02exeobj.exists().not()) then
      !vprmerr.append('_________________________________________________________________________')
      !vprmerr.append('ERROR -- The VPRM system in NOT available.')
      !vprmerr.append(' View the LOG file $!this.logfile for more details')
      !vprmerr.append('ERROR -- Unable to locate the VPRM executable file' & !pdsc02exeobj.name() )
      !vprmerr.append('ERROR --  The MDS VPRM MTO "$!this.vprmoption" file')
      !vprmerr.append(' "$!this.mtofile" ')
      !vprmerr.append('ERROR --  has been GENERATED, but it has *** NOT been LOADED *** into the VPRM SYSTEM')
      syscom 'echo ERROR -- The VPRM system in NOT available.'
      return FALSE
    endif

    ---------------------------------------------------------------------
    --<wd>23nov2005
    -- Build command string
    -- Arguments to dbtest are output file and pdsco1 configuration file
    --    !commandstring = !dbtestexeobj.fullname() & ' ' & !junkfile.fullname() & ' ' & !configfileobj.fullname()

    -- Store the Individual FULL path names of the THREE VPRM DB TEST files
    --!dbtestexe = !dbtestexeobj.fullname()
    --!dbtestfil = !dbtestfile.fullname()
    --!pdsc01cfg = !pdsc01cfgobj.fullname()

    -- Store the Individual File names with the UNEXPANDED EVARS in the File name of the THREE VPRM DB TEST files
    -- This METHOD enables MORE than the PDMS limit of 256 characters on ANY ONE line in PDMS, as the
    -- the "syscom" command ONLY expands the EVARS in the PDMS CONSOLE WINDOW where the limit is 1024 characters(I think????)
    -- e.g.
    --  !dbtestexe = '%pdmsexe%/dbtest.exe'
    --  !dbtestfil = '%pdmsuser%/db-' & !unique & '.dbtest'
    --  !pdsc01cfg = '%fraiso%/pdsc01.cfg' -- where "fra" = the PDMS project Code

    --<wd>nov2005
    --!dbtestexe = !dbtestexeobj.name()
    !dbtestexe = !dbtestexeobj.fullname()
    !dbtestfil = !dbtestfile.name()
    !pdsc01cfg = !pdsc01cfgobj.name()

    -- Always Copy and Overwrite the VPRM CONFIG file to the PDMSWK Area so that PDSC02.exe knows where to find it!
    !pdsc01fil = !pdsc01cfgobj.fullname()
    var !pdmswk evar PDMSWK
    --$P --> syscom 'copy $!pdsc01fil $!pdmswk\pdsc01.cfg /AYV' <--
    syscom 'copy $!pdsc01fil $!pdmswk\pdsc01.cfg /AYV'

    ---------------------------------------------------------------------------------------------------
    -- Store the Individual FULL path names of the THREE VPRM DB TEST files
    --<EVARS are automatically EXPANDED when using the FILE OBJECT ".fullname() method >
    --    !dbtestexef = !dbtestexeobj.fullname() $* 32 chars             >
    --    !dbtestfilf = !dbtestfile.fullname()   $* 42 chars           = > TOTAL STRING LENGTH = 446 characters
    --    !pdsc01cfgf = !pdsc01cfgobj.fullname() $* 62 chars * 6 = 372   >
    --
    -- TEST STRING LENGTH ONLY of 446 characters -- This is NOT a valid STRING for VPRM DB TEST executable
    --syscom '$!dbtestexe $!dbtestfil $!pdsc01cfg $!pdsc01cfg $!pdsc01cfg $!pdsc01cfg $!pdsc01cfg $!pdsc01cfg '
    --
    ---------------------------------------------------------------------------------------------------

    -- Execute command to TEST for VPRM DB
    --syscom '$!commandstring'
    syscom '$!dbtestexe $!dbtestfil $!pdsc01cfg '
    handle ANY
      !vprmerr.append(|_________________________________________________________________________|)
      !vprmerr.append(|ERROR -- Unable to TEST the availability of the VPRM system.|)
      !vprmerr.append(| View the LOG file $!this.logfile for more details|)
      !vprmerr.append(|ERROR -- $!!error.text|)
      !vprmerr.append(|ERROR -- $!!error.line|)
      !vprmerr.append(|ERROR -- VPRM DB TEST location     = $!dbtestexe|)
      !vprmerr.append(|ERROR -- VPRM MTO FILE location    = $!dbtestfil|)
      !vprmerr.append(|ERROR -- VPRM CONFIG FILE location = $!pdsc01cfg|)
      !vprmerr.append(|$!!error.command|)
      !vprmerr.append(|ERROR --  The MDS VPRM MTO "$!this.vprmoption" file|)
      !vprmerr.append(| "$!this.mtofile" |)
      !vprmerr.append(|ERROR --  has been GENERATED, but it has *** NOT been LOADED *** into the VPRM SYSTEM|)
      syscom |echo ERROR -- Unable to TEST the availability of the VPRM system.|
      return FALSE
    endhandle
    --<wd>23nov2005
    ---------------------------------------------------------------------

    -- Test if the VPRM DB TEST File is
    if (!dbtestfile.readfile().empty()) then
      !vprmerr.append('_________________________________________________________________________')
      !vprmerr.append('ERROR -- The VPRM system is NOT available.')
      !vprmerr.append('  View the LOG file "$!this.logfile" for more details')
      !vprmerr.append('ERROR -- The MDS VPRM MTO "$!this.vprmoption" file')
      !vprmerr.append(' "$!this.mtofile"')
      !vprmerr.append('ERROR -- has been GENERATED, but it has *** NOT been LOADED *** into VPRM')
      syscom 'echo ERROR -- The VPRM system in NOT available.'
      return FALSE

    else
      -- Read the RESULT from the VPRM DB TEST File
      !result = !dbtestfile.readfile()[1].real()

    endif

    -- For returned ERROR 1 = VPRM DB is NOT AVAILABLE
    if (!result.eq(1)) then
      !vprmerr.append('_________________________________________________________________________')
      --    !vprmerr.append('ERROR -- The VPRM system is NOT available. Invalid VPRM DB name in the configuration file "$!this.vprmconfig.file.fullname()"')
      -- GE 07-08-06 fixed syntax error above
      !vprmerr.append('ERROR -- The VPRM system is NOT available. Invalid VPRM DB name in the configuration file "$!this.vprmconfig.fullname()"')
      !vprmerr.append('  View the LOG file "$!this.logfile" for more details')
      !vprmerr.append('ERROR -- The MDS VPRM MTO "$!this.vprmoption" file')
      !vprmerr.append(' "$!this.mtofile"')
      !vprmerr.append('ERROR -- has been GENERATED, but it has *** NOT been LOADED *** into VPRM')

      -- ECHO ERRORS to the PDMS Command Window
      syscom 'echo ERROR -- VPRM DB not found'
      --   syscom 'echo ERROR -- Invalid VPRM DB name in the configuration file "$!this.vprmconfig.file.fullname()"'
      -- GE 07-08-06 fixed syntax error above
      syscom 'echo ERROR -- Invalid VPRM DB name in the configuration file "$!this.vprmconfig.fullname()"'
      syscom 'echo ERROR -- View the LOG file "$!this.logfile" for more details'
      return FALSE

      -- For returned ERROR 2 = VPRM DB is NOT AVAILABLE
    elseif (!result.eq(2)) then
      !vprmerr.append('_________________________________________________________________________')
      !vprmerr.append('ERROR -- The VPRM system is NOT available. Invalid VPRM DB "UserID/PassWord" in the configuration file "$!this.vprmconfig.file.fullname()"')
      !vprmerr.append('  View the LOG file "$!this.logfile" for more details')
      !vprmerr.append('ERROR -- The MDS VPRM MTO "$!this.vprmoption" file')
      !vprmerr.append(' "$!this.mtofile"')
      !vprmerr.append('ERROR -- has been GENERATED, but it has *** NOT been LOADED *** into VPRM')

      -- ECHO ERRORS to the PDMS Command Window
      syscom 'echo ERROR -- Invalid VPRM DB "UserID/PassWord" in the configuration file "$!this.vprmconfig.file.fullname()"'
      syscom 'echo ERROR -- View the LOG file "$!this.logfile" for more details'
      return FALSE

      -- For returned 0 = VPRM DB is AVAILABLE
    elseif (!result.eq(0)) then
      !vprmerr.append('_________________________________________________________________________')
      !vprmerr.append('MESSAGE -- The VPRM system is AVAILABLE.')
      !vprmerr.append('  View the LOG file "$!this.logfile" for more details')
      !vprmerr.append('MESSAGE -- The MDS VPRM MTO "$!this.vprmoption" file')
      !vprmerr.append(' "$!this.mtofile"')
      !vprmerr.append('MESSAGE -- has been GENERATED, and it has been *** AUTOMATICALLY LOADED *** into VPRM')

      syscom 'echo MESSAGE -- VPRM DB is AVAILABLE for AUTOMATIC LOADING of MDS SUPPORT MTO "$!this.option" files'
      return TRUE

    endif

  else
    -- The VPRM Access Mode is set to "FILE" in the !this.vprmconfig.dbaccess member
    !vprmerr.append('_________________________________________________________________________')
    !vprmerr.append('WARNING -- The VPRM Access Type is set to "FILE".')
    !vprmerr.append('  View the LOG file "$!this.logfile" for more details')
    !vprmerr.append('WARNING -- The MDS VPRM MTO "$!this.vprmoption" file')
    !vprmerr.append(' "$!this.mtofile"')
    !vprmerr.append('WARNING -- has been GENERATED, but it has *** NOT been LOADED *** into the VPRM SYSTEM')
    syscom 'echo WARNING -- The VPRM Access Type is set to "FILE".'
    return FALSE
  endif

endmethod

