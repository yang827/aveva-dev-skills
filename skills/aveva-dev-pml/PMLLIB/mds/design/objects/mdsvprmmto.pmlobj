-- Define Object
define object MDSVPRMMTO

  -----------------------------------------------------------------------------------------------------------------------
  --<wd>aug2006 -- NEVER USED these TWO members -- BULK and ACTUAL MTO have always USED the SAME PML CODE in this OBJECT
  --
  -- Members store objects created in the PDMS DRAFT MDS ABA utility for ACTUAL MDS Support MTO
  --<wd>aug2006    member .mtosteel is mdsabamtosteel
  --<wd>aug2006    member .mtocomp  is mdsabamtocomp
  --
  --<wd>aug2006 -- NEVER USED these TWO members -- BULK and ACTUAL MTO have always USED the SAME PML CODE in this OBJECT
  --<nb>nov2011    P-41873 (Set !!mdsHangIf from Hanger Interface record)
  -----------------------------------------------------------------------------------------------------------------------

  -- "BULK"   MTO required - <from PDMS DESIGN> or
  -- "ACTUAL" MTO required - <from PDMS DRAFT via DELIVERY MANAGER or LIVE MDS ABA>
  member .mtotype  is STRING

  -- Common MDS Support Data
  member .mdsgroup is BOOLEAN
  member .support  is DBREF
  member .suppname is STRING
  member .supptype is STRING
  member .mainmem  is ARRAY
  member .allmem   is ARRAY  $* ??? CHECK ???  NOT sure the member .allmem is required  ??? CHECK ???
  member .descattr is STRING
  member .units    is COMUNITS

  -- MDS Support is Supporting the Discipline Type = 'PIPE', 'HVAC' or 'TRAY'
  member .mdspipetype is STRING

  -- MDS Structural Support Arrays
  member .strutagf is ARRAY
  member .strutagn is ARRAY
  member .strutags is ARRAY
  member .strudbrf is ARRAY
  member .strudesc is ARRAY
  member .struquan is ARRAY
  member .strutype is ARRAY
  member .struelem is ARRAY
  member .strumemb is ARRAY

  -- MDS Hanger Support Arrays
  member .hangtags is ARRAY
  member .hangdbrf is ARRAY
  member .hangdesc is ARRAY
  member .hangquan is ARRAY
  member .hangtype is ARRAY
  member .hangelem is ARRAY
  member .hangmemb is ARRAY

  -- LISEGA Hanger "2*****" Series SPRINGS either in a MDS HANGER or a MDS GROUP Support
  member .hangspring  is ARRAY
  member .springindex is REAL

  -- MDS Ancillary Support Arrays
  member .attatags is ARRAY
  member .attadbrf is ARRAY
  member .attadesc is ARRAY
  member .attaquan is ARRAY
  member .attatype is ARRAY
  member .attaelem is ARRAY
  member .attamemb is ARRAY

  -- MTO Position Numbers for EACH type of element in the MDS Support
  -- *** NOT REQUIRED for the BULK MDS-VPRM MTO transfer ***
  -- For ACTUAL MTO these members will be prefixed by the "PREFIX" letter found in the object
  -- members .mtosteel and .mtocomp created in via MDS ABA utility
  member .sctnindx is REAL   $* ACTUAL MTO Prefix is !this.mtosteel.taskparams[8]
  member .sjoiindx is REAL   $* ACTUAL MTO Prefix is !this.mtosteel.taskparams[9]
  member .boxindx  is REAL   $* ACTUAL MTO Prefix is !this.mtosteel.taskparams[10]
  member .hangindx is REAL   $* ACTUAL MTO Prefix is !this.mtosteel.taskparams[11]
  member .attaindx is REAL   $* ACTUAL MTO Prefix is !this.mtocomp.taskparams[8]

  -- Array of ERRORS encountered to be written to the ERROR log file
  member .errorarray is ARRAY

  -- Members to Store MDS Support Data
  member .safetyclass   is STRING
  member .qualityclass  is STRING

  --<nb>jun2007  HPD0035323/OP48  (Populate the MTO Revision from the DM Revision code)
  member .rev is STRING

endobject
--
-- End of mdsvprmmto.pmlobj Definition
-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Constructor Method to populate !this object
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R       DBREF         Valid MDS Support
-- Return:
--    [Data Type]   [Description]
--
-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
define method .mdsvprmmto(!support is DBREF)

  --*****************************************************************************
  -- NOTE: Before Using this OBJECT ensure that the !support being passed is
  --       a valid MDS Support "TYPE" i.e.
  -- <1> a MDS STRUCTURE for any MDS FRAMEWORK SUPPORTS or a MDS GROUP,<MDS STANDARD or SPECIAL>
  -- <2> a MDS ATTA where the CREF of the ATTA references a MDS HANGER
  -- <3> a MDS ATTA for a "STAND-ALONE" MDS ANCILLARY, i.e. an ATTA NOT a part of a MDS STRUCTURE support
  --
  -- <4> *** MDS TRUNNIONS -- NOT yet included *** Possible FUTURE DEVELOPMENT***
  --
  -- *** ANY other MDS Support MEMBERS <ATTAS, PLATES etc..> should not be passed
  --     to this OBJECT i.e "<name>/DATUM <name>/SREF <name>.1" etc... ***
  --*****************************************************************************

  -- Determine the PDMS Module
  -- <DESIGN> for MTO per BULK Estimate for Passed Pipes/HVAC elements
  -- <DRAFT>  for MTO per MDS ABA Support DRAWING
  -- ?? <ISODRAFT> for ?? PIPE MTO for MDS Supports per PIPE -- ?? FUTURE option ?? CHECK ??
  !banner = banner
  if (!banner.name.upcase().match('DESIGN').gt(0)) then
    !module = 'DESIGN'
    !this.mtotype = 'BULK'

    --<wd>may2007<mds12>
    --   elseif (!banner.name.upcase().match('OUTFITTING').gt(0)) then
  elseif (!banner.short.upcase().match('OUTFITTING MK').gt(0)) then
    --<wd>may2007<mds12>

    !module = 'DESIGN'
    !this.mtotype = 'BULK'

    --<wd>may2007<mds12>
    --   elseif (!banner.name.upcase().match('DRAFT').gt(0)) then
  elseif ((!banner.name.upcase().match('DRAFT').gt(0)) or (!banner.name.upcase().match('OUTFITTINGDRAFT').gt(0))) then
    --<wd>may2007<mds12>

    !module = 'DRAFT'
    !this.mtotype = 'ACTUAL'
  elseif (!banner.name.upcase().match('ISODRAFT').gt(0)) then
    !module = 'ISODRAFT'
    !this.mtotype = '??? CHECK ??? if a Future Option ???'
  endif

  -- Get and store the PDMS Project DISTANCE Units

  !this.units = object COMUNITS(TRUE)

  -- Populate the Object Members
  !this.support  = !support
  !this.suppname = !this.support.namn
  !this.mdsgroup = FALSE

  -- Initialise all the Object "....indx" members
  !this.sctnindx = 0
  !this.sjoiindx = 0
  !this.boxindx  = 0
  !this.hangindx = 0
  !this.attaindx = 0

  -- NEW CODE for "ACTUAL" MDS-VPRM MTO" use the SAME CODE as for BULK MTO
  -- OLD CODE never used -- It was going to Populate this OBJECTS members from the
  -- Existing MDS Support Objects populated via the MDS ABA utility
  if (!this.mtotype.eq('ACTUAL')) then
    --!this.mdsactualmto(!support)
    !this.mdsbulkmto(!support)
    -- For "BULK" MDS-VPRM MTO -- Populate this OBJECTS members from scratch
  elseif (!this.mtotype.eq('BULK')) then
    !this.mdsbulkmto(!support)
  endif

endmethod

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Method to load the OBJECT with ALL of the required data
-- for the current MDS Support for an "ACTUAL" MDS-VPM MTO transfer
--
-- ?????????????? *********** "The UNFINISHED SYMPHONY" NEVER USED now uses SAME CODE as BULK MTO******** ??????????????
-------------------------------------------------------------------------------
--<wd>aug2006 -- NEVER USED THIS METHOD - SEE BELOW method =  .mdsbulkmto(!support is DBREf) -- --   define method .mdsactualmto(!support is DBREF)
--<wd>aug2006 -- NEVER USED THIS METHOD - SEE BELOW method =  .mdsbulkmto(!support is DBREf) --
--<wd>aug2006 -- NEVER USED THIS METHOD - SEE BELOW method =  .mdsbulkmto(!support is DBREf) -- -- Get the MDS MTO STEEL Object data Arrays from the MDS ABA DRAFT FORM member MDSABAMTOSTEEL.data
--<wd>aug2006 -- NEVER USED THIS METHOD - SEE BELOW method =  .mdsbulkmto(!support is DBREf) --     !this.mtosteel = !!mdsabamtosteel.data
--<wd>aug2006 -- NEVER USED THIS METHOD - SEE BELOW method =  .mdsbulkmto(!support is DBREf) --
--<wd>aug2006 -- NEVER USED THIS METHOD - SEE BELOW method =  .mdsbulkmto(!support is DBREf) -- -- Get the MDS MTO COMPONENT Object data Arrays from the MDS ABA DRAFT FORM FORM member MDSABAMTOCOMP.data
--<wd>aug2006 -- NEVER USED THIS METHOD - SEE BELOW method =  .mdsbulkmto(!support is DBREf) --     !this.mtocomp  = !!mdsabamtocomp.data
