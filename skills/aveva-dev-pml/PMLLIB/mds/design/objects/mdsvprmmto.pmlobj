--<wd>aug2006 -- NEVER USED THIS METHOD - SEE BELOW method =  .mdsbulkmto(!support is DBREf) --   endmethod
--<wd>aug2006 -- NEVER USED THIS METHOD - SEE BELOW method =  .mdsbulkmto(!support is DBREf) --
-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Method to load the OBJECT with ALL of the required data
-- for the current MDS Support for a "BULK" MDS-VPM MTO transfer
--
define method .mdsbulkmto(!support is DBREF)

  --q var !support.name
  --q var !support.type

  -- Determine the MDS Support Type
  !supporttype = !!mdsabatype(!support)

  -- Determine the MDS Support type and if it belongs to a MDS Group
  if (!supporttype.eq('FRAME')) then
    -- Support is a MDS STRUCTURE
    !this.supptype = 'STRU'

    if (!this.support.name.match('[1]').gt(0)) then
      -- Master MDS Structure for MDS GROUP
      !this.mdsgroup = TRUE
      -- MDS Group Prefix Name
      !this.suppname = !this.support.namn.before('[1]')
    endif

    -- Load the OBJECT Data for the MDS Type
    if (!this.mdsgroup) then
      -- Master Structure for a MDS GROUP Support
      -- Determine the "MAIN MEMBERS for a MDS GROUP Support"
      !this.mdsmainmem(!support)
      !this.mdsgroup(!support)

    else
      -- Individual MDS FRAMEWORK Structure Support
      -- Determine the "MAIN MEMBER"
      !this.mdsmainmem(!support)
      !this.mdsstructure(!support)
      !this.mdsancill(!support)
      -- Use the MDS ANCILLARY ATTA settings above to set the OBJECT members "this.attaelem and !this.attamemb"
      !this.mtototalsatta()
    endif

    --<wd>oct2005
    -- Determine the ".mdspipetype", i.e. Which Discipline is being Supported?
    -- The DATUM ATTA on a MDS FRAMEWORK Support is the Controlling ATTA
    !mdsdatumname = !support.name & '/DATUM'
    !mdsdatumdbrf = !mdsdatumname.dbref()
    if (!mdsdatumdbrf.owner.pspe.purp.upcase().eq('HVAC')) then
      !mdspipetype = 'HVAC'
    elseif (!mdsdatumdbrf.owner.pspe.purp.upcase().eq('TRAY')) then
      !mdspipetype = 'TRAY'
    else
      !mdspipetype  = 'PIPE'
    endif

    -- Set the Object  Member
    !this.mdspipetype = !mdspipetype
    --<wd>oct2005

  elseif (!supporttype.eq('HANGER')) then
    -- Individual MDS HANGER
    !this.supptype = 'HANG'
    -- Determine the "MAIN MEMBER"
    !this.mdsmainmem(!support)
    !this.mdshanger(!support)

    --<wd>oct2005
    -- Set the Object  Member
    !this.mdspipetype = 'PIPE'
    --<wd>oct2005

  elseif (!supporttype.eq('ANCILL')) then
    -- Individual MDS ANCILLARY
    !this.supptype = 'ATTA'
    -- Determine the "MAIN MEMBER"
    !this.mdsmainmem(!support)
    !this.mdsancill(!support)
    -- Use the MDS ANCILLARY ATTA settings above to set the OBJECT members "this.attaelem and !this.attamemb"
    !this.mtototalsatta()

    --<wd>oct2005
    -- Set the Object  Member
    !this.mdspipetype = 'PIPE'
    --<wd>oct2005
  endif

endmethod

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Method to load the OBJECT with ALL of the required data
-- for an INDIVIDUAL MDS STRUCTURE
--
define method .mdsstructure(!support is DBREF)

  -- Store the ORIGINAL component
  !ce = !!ce

  -- Collect ALL MDS Framework Support MEMBERS
  var !sctns coll all sctn for $!support
  var !boxes coll all box for $!support

  -- This will coll all INTERNAL joints for the MDS STRUCTURE
  var !jois eval ref of jois for all from !sctns
  var !joie eval ref of joie for all from !sctns

  !alljoints = ARRAY()
  !alljoints.appendarray(!jois)
  !alljoints.appendarray(!joie)
  do !removeunsets indices !alljoints
    if (!alljoints[$!removeunsets].eq('unset')) then
      !alljoints[$!removeunsets].delete()

      -- EXCLUDE all PJOI where the FUNCTION of the CREF(i.e. the owning SCTN) is set to "Q3*" for FANP "Q" type SCTNS
    elseif ((!alljoints[!removeunsets].dbref().function neq 'DUMMY') and (!alljoints[!removeunsets].dbref().type eq 'PJOI' and ((matchwild(!alljoints[!removeunsets].dbref().cref.function, 'Q3*'))))) then
      -- $P+++++ DELETE PJOI index from the ARRAY !alljoints +++++++
      -- q var !alljoints[!removeunsets].dbref().fullname
      -- $P--------------------
      !alljoints[!removeunsets].delete()

      --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q5" SCTN type added
      -- EXCLUDE all PJOI where the FUNCTION of the CREF(i.e. the owning SCTN) is set to "Q5*" for FANP "Q" type SCTNS
    elseif ((!alljoints[!removeunsets].dbref().function neq 'DUMMY') and (!alljoints[!removeunsets].dbref().type eq 'PJOI' and ((matchwild(!alljoints[!removeunsets].dbref().cref.function, 'Q5*'))))) then

      !alljoints[!removeunsets].delete()
      --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q5" SCTN type added

    endif
  enddo

  --Now we need to also collect all EXTERNAL joints
  !alljoints.compress()
  !joints = ARRAY()
  do !externaljoints values !alljoints
    !teststru = stru of $!externaljoints
    if ((!teststru.neq(!support)) or (!teststru.eq(!support) and !externaljoints.dbref().type.eq('PJOI') and !teststru.:mdssupptype.eq('SPECIAL'))) then
      !joints.append(!externaljoints)
    endif
  enddo

  -- Collect All Valid SJOI, PJOI and FITT members
  --var !sjois coll all sjoi with (func neq 'DUMMY') for $!support
  -- EXCLUDE all SJOI with a SPREF matchwild '*Insert*' for FANP "Q" type SCTNS
  var !sjois coll all sjoi with ((func neq 'DUMMY') and (not matchwild(name of spref of sjoi,'*Insert*'))) for $!support
  -- EXCLUDE all PJOI where the FUNCTION of the CREF(i.e. the owning SCTN) is set to "Q3*" for FANP "Q" type SCTNS
  --var !sjois append coll all pjoi with (func neq 'DUMMY') for $!support
  var !sjois append coll all pjoi with ((func neq 'DUMMY') and (type eq 'PJOI' and (not (matchwild(func of cref, 'Q3*'))))) for $!support

  --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q5" SCTN type added
  -- EXCLUDE all PJOI where the FUNCTION of the CREF(i.e. the owning SCTN) is set to "Q5*" for FANP "Q" type SCTNS
  var !sjois append coll all pjoi with ((func neq 'DUMMY') and (type eq 'PJOI' and (not (matchwild(func of cref, 'Q5*'))))) for $!support
  --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q5" SCTN type added

  var !fitts coll all fitt with (func neq 'DUMMY') and (spref neq /MDS/LUG-HANG ) for $!support

  -- dtf >>> 7.08.06 before populating the members check to see if elements have badref of catref
  !checkedSctns  = !!mdscheckbadref(!sctns)
  !checkedSjois  = !!mdscheckbadref(!sjois)
  !checkedJoints = !!mdscheckbadref(!joints)
  !checkedFitts  = !!mdscheckbadref(!fitts)

  -- Populate OBJECT member .strudbrf -- An Array of STRINGS
  --!this.strudbrf.appendarray(!sctns)
  --!this.strudbrf.appendarray(!sjois)
  --!this.strudbrf.appendarray(!joints)
  --!this.strudbrf.appendarray(!fitts)
  !this.strudbrf.appendarray(!boxes)
  !this.strudbrf.appendarray(!checkedSctns)
  !this.strudbrf.appendarray(!checkedSjois)
  !this.strudbrf.appendarray(!checkedJoints)
  !this.strudbrf.appendarray(!checkedFitts)
  -- dtf <<< 7.08.06 end of mod

  -- ONLY ever ONE MDS STRUCTURE element in a MDS Support
  -- Unique the ARRAY ".strudbrf" and Populate the Structural Descriptions OBJECT member ".strudesc"
  !this.strudbrf.unique()
  !this.mdsdescriptions(!support,'STRU')

  -- Determine the concatenated "descriptions" for each MTO element in the MDS FRAMEWORK STRUCTURE
  !strutempelem = ARRAY()
  -- $P ###########################
  -- $P >>> q var !support.name
  -- q var !support.name
  -- $P ###########################
  -- $P >>> q var !this.strutype
  -- q var !this.strutype
  -- $P ###########################
  -- $P >>> q var !this.strudbrf
  -- q var !this.strudbrf
  -- $P ###########################
  -- $P >>> q var !this.strudesc
  -- q var !this.strudesc
  -- $P ###########################
  -- $P >>>q var !this.struquan
  -- q var !this.struquan
  -- $P ###########################
  do !indx index !this.strudesc
    !mtodesc = !this.strutype[!indx] & '|' & !this.strudbrf[!indx] & '|' & !this.strudesc[!indx] & '|' & !this.struquan[!indx]
    !strutempelem.append(!mtodesc)
  enddo

  -- Now make the final elements array ready for use with the table creation
  -- Go off and create the final array with all different lists.
  -- Initialise the ARRAY Variable for a MDS Framework Structure
  !mdsgroup = !this.mdsgroup
  --   !this.taskparams      = !params
  !this.struelem[1] = ARRAY()
  !this.struelem[2] = ARRAY()
  !this.struelem[3] = ARRAY()
  !this.struelem[4] = ARRAY()

  -- Get the Initial Arrays etc... for the MDS Framework in the MDS GROUP
  !this.mdsstrutotals(!strutempelem,!strutempelem[1].split('|')[1], !mdsgroup)
  handle any
    -- No steelwork
  endhandle

  -- Get the MTO Totals etc... for the MDS Framework Structure
  -- Compress STEEL MTO for MDS FRAMEWORK STRUCTURE by TOTALLING together DUPLICATE
  -- JOINTS and/or FITTINGS ONLY belonging to the MDS FRAMEWORK.
  -- SCTN elements will still be OUTPUT in the STEEL MTO as INDIVIDUAL elements,
  -- to ensure the MDS FRAMEWORK SCTN Spool Numbers are maintained.
  !totalstruelem = !this.mtostructure(!this.struelem)

  --if !totalstruelem[1].size().eq(1) then
  --  return
  --endif

  -- Populate the Final MDS Framework STRUCTURE ARRAY for Proceeding to attain VPRM Data
  !this.strumemb = !totalstruelem

  -- Navigate back to the ORIGINAL component
  !!ce = !ce

endmethod
-- end of .mdsstructure()

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Method to load the OBJECT with ALL of the required data for a MDS Group,
-- <1> The Master MDS STRUCTURE plus
-- <2> All MDS Hangers in the MDS Group
--
define method .mdsgroup(!support is DBREF)

  -- Store the ORIGINAL component
  !ce = !!ce

  -- Collect all PDMS elements for the MAIN MDS GROUP support members in "!this.mainmem"
  !hangdbrf = ARRAY()
  !hangtype = ARRAY()
  !hangdesc = ARRAY()
  !hangquan = ARRAY()

  --$P===========
  --q var !this.mainmem
  --$P++++++++++++++++++

  do !indx indices !this.mainmem
    if (!this.mainmem[!indx].type.eq('STRU')) then
      -- MDS Structure Framework Support - Always the Master Group Element !indx = [1]
      !this.mdsstructure(!this.mainmem[!indx])

      -- Determine the MDS ANCILLARY ATTAS on the MDS STRUCTURE -- IGNORE ANY "REST" Type ATTAS
      !this.mdsancill(!this.mainmem[!indx])

    elseif (!this.mainmem[!indx].type.eq('ATTA')) then
      -- MDS Hanger Support
      !this.mdshanger(!this.mainmem[!indx])

      -- Append the Values of "!this.hangdbrf" for each MDS HANGER in the MDS GROUP
      !hangdbrf.appendarray(!this.hangdbrf)

      --Populate the Hanger Descriptions OBJECT members
      !this.mdsdescriptions(!support,'HANG')

      -- Append the Values of "!this.hangdbrf" for each MDS HANGER in the MDS GROUP
      !hangtype.appendarray(!this.hangtype)
      !hangdesc.appendarray(!this.hangdesc)
      !hangquan.appendarray(!this.hangquan)

      -- Clear the Hanger Object Members to avoid DUPLCATE entries
      !this.hangdbrf.clear()
      !this.hangtype.clear()
      !this.hangdesc.clear()
      !this.hangquan.clear()

    endif
  enddo

  --$P>>>>>>>
  --q var !hangdbrf !hangtype !hangdesc !hangquan
  --$P<<<<<<<<<<<<<<<<

  -- Reset and/or Populate the MDS Hanger Object Members for ALL MDS HANGERS in the MDS GROUP
  !this.hangdbrf = !hangdbrf
  !this.hangtype = !hangtype
  !this.hangdesc = !hangdesc
  !this.hangquan = !hangquan

  -- Use the MDS HANGER settings above to set the OBJECT members "this.hangelem and !this.hangmemb"
  if (!this.hangdbrf.empty().not()) then
    !this.mtototalshang()
  endif

  -- Use the MDS ANCILLARY ATTA settings above to set the OBJECT members "this.attaelem and !this.attamemb"
  !this.mtototalsatta()

endmethod

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Method to load the OBJECT with ALL of the required data
-- for an INDIVIDUAL MDS HANGER
--
define method .mdshanger(!support is DBREF)

  -- Store the ORIGINAL component
  !ce = !!ce

  -- Get the Hanger DBREF element connected to the MDS Hanger Atta
  !hanger = !support.cref

  -- MDS Hanger
  !owner = !hanger.owner
  var !hangs coll all hang mem for $!owner

  -- Remove "TUBI <LSROD>" elements if MDS is NOT using a MANUFACTURERS Hanger Interface
  do !remove from 1 to !hangs.size()
    if (!hangs[$!remove].dbref().type.eq('TUBI')) then
      -- When using MDS with a HANGER MANUFACTURERS DESIGN INTERFACE,IMPLIED RODS may exist so
      -- SKIP the implied'TUBI'<'ROD'> elements and DO NOT DELETE them from the !hangs ARRAY()
      skip if (!hanger.href.spref.name.match('MH').gt(0))
      !hangs[$!remove].delete()

    elseif (!hangs[$!remove].dbref().type.eq('HELE')) then

      --<wd>mar2006
      -- Delete from the MDS HANGER MEMBERS !hangs array ANY "HELE" elements with an invalid or unset SPREF name
      !helename  = !hangs[!remove].dbref().name
      !unusedTestspref = !hangs[$!remove].dbref().spref.name
      handle ANY
        !hangs[$!remove].delete()
        !this.errorarray.append(' ERROR -- HANGER element $!helename has an INVALID SPREF')
        !this.errorarray.append('  MDS Support VPRM MTO will not contain this component')
        skip
      endhandle

      -- Delete from the !hangs array ANY "HELE" elements with an invalid or unset DETREF name
      !unusedTestdetref = !hangs[$!remove].dbref().detref.name
      handle ANY
        !this.errorarray.append(' ERROR -- HANGER element $!helename has an INVALID DETREF')
        !this.errorarray.append('  MDS Support VPRM MTO will not contain this component')
        !hangs[$!remove].delete()
        skip
      endhandle
      --<wd>mar2006

      if (!hangs[$!remove].dbref().detref.name.eq('/SDTE-PIPE-BORE-ADAPTER')) then
        !hangs[$!remove].delete()
      endif

    endif
  enddo

  -- Populate the Object member .hangdbrf
  !hangs.compress()
  !this.hangdbrf.appendarray(!hangs)

  -------------------------------------------------
  -- ADD any EXTRA Components which may be required in the MDS ABA MTO for the MDS LISEGA HANGER Interface
  -- The MDS LICAD HANGER interface sets the array UDA :USTNUTREF with an array of the SPREFS of the
  -- HEXAGON NUTS required at SOME LISEGA HANGER DESIGN DATABASE components
  -- **********
  -- ** NOTE **
  -- **********
  -- MDS-LISEGA Interface ONLY.
  -- These EXTRA Components will NOT be TAGGED in the MDS ABA DRAWING VIEWS but they will APPEAR in the MTO list
  if (!!mdshangif.upcase().eq('LISEGA')) then
    !hexnuts = ARRAY()
    do !hele values !this.hangdbrf
      skip if (!hele.dbref().type.eq('TUBI'))
      if (!hele.dbref().:ustnutref.set()) then
        -- Append as STRINGS the SPREFS stored in the UDA :USTNUTREF to the the !hexnuts array
        !nutarray = !hele.dbref().:ustnutref
        handle ANY
          skip
        endhandle
        do !hnuts values !nutarray
          !xnutref = ref of $!hnuts
          !hnutref = !xnutref.string()
          !hexnuts.append(!hnutref)
        enddo
      endif
    enddo
    -- Append the !hexnuts array to the !this.hangdbrf array
    !this.hangdbrf.appendarray(!hexnuts)
  endif

  -- A MDS GROUP Support may contain MORE than ONE MDS HANGER Support
  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  -- *** ONLY *** Run the Code BELOW -- if Support is an INDIVIDUAL MDS HANGER and NOT in a MDS GROUP????
  ---------------------------------------------------------------------------------------------------
  -- MDS HANGER is NOT in a MDS GROUP
  if (!this.mdsgroup.not()) then
    !this.mdsdescriptions(!support,'HANG')
    -- Totalling MDS HANGER Components plus Index and Sort the MDS HANGER Arrays etc...
    !this.mtototalshang()
  endif

  ---------------------------------------------------------------------------------------------------
  $(
  -- Re-Index Alphabetically the Hanger Arrays ---
  -- NOT SORTING the INDICES as done below, will mean that the MDS HANGER TOTALLING
  -- done in the method ".mtototals()" will NOT produce the CORRECT amount of indices
  -- in the object array ".hangmemb[5]" indicating the CORRECT Position/Index Nos. in
  -- the "DBREF<string>" array ".hangmemb[2]"
  -- ***********
  -- **  NOTE ** in the method ".mtototals()" the variable "!findsame" looks at the NEXT line of the array
  -- *********** ".hangelem[3]]" to check and store the quantities of COMPONENTS with IDENTICAL descriptions.
  --
  !hindex = !this.hangdesc.sortedindices()
  !this.hangtype.reindex(!hindex)
  !this.hangdbrf.reindex(!hindex)
  !this.hangdesc.reindex(!hindex)
  !this.hangquan.reindex(!hindex)

  -- Determine the concatenated "descriptions" for each MTO element in the MDS HANGERS
  !hangtempelem = array()
  do !indx index !this.hangdesc
    !mtodesc = !this.hangtype[!indx] & '|' & !this.hangdbrf[!indx] & '|' & !this.hangdesc[!indx] & '|' & !this.hangquan[!indx]
    !hangtempelem.append(!mtodesc)
  enddo

  -- Now make the final elements array ready for use with the table creation
  -- Go off and create the final array with all different lists.
  -- Initialise the ARRAY Variable for a MDS Framework Structure
  !mdsgroup         = !this.mdsgroup
  !this.hangelem[1] = array()
  !this.hangelem[2] = array()
  !this.hangelem[3] = array()
  !this.hangelem[4] = array()

  -- Get the Totals etc... for the MDS Hangers in the MDS GROUP
  if (!!mdshangif.trim().upcase().neq('MDS')) then
    !this.mdshangtotals(!hangtempelem,!hangtempelem[1].split('|')[1], !mdsgroup)
  endif

  -- The MDS HANGER members of a *** MDS GROUP *** will be TOTALLED etc... here
  -- Compress the MTO for the MDS HANGERS by TOTALLING together DUPLICATE
  -- HANGER elements belonging to ALL of the MDS HANGERS in the MDS GROUP.
  --    if (!mdsgroup) then
  -- Support is in a MDS GROUP -- MDS HANGER elements are stored in the OBJECT member !this.data.hangerelements
  !totalhangelem = !this.mtohanger(!this.hangelem)

  -- Populate the Final MDS Framework STRUCTURE ARRAY for Proceeding to attain VPRM Data
  !this.hangmemb = !totalhangelem

  !!totalhangelem = !totalhangelem
  $)
  --endif
  ---------------------------------------------------------------------------------------------------
  -- *** ONLY *** Run the Code ABOVE -- if Support is an INDIVIDUAL MDS HANGER and NOT in a MDS GROUP????
  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------

  ---------------------------------------------------------------------------------------------------
  -- Navigate back to the ORIGINAL component
  !!ce = !ce

endmethod

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Method to load the OBJECT with ALL of the required data
-- for an INDIVIDUAL MDS ANCILLARY, which may be more than ONE ATTA of the SAME TYPE
-- ON the SAME PIPE/HVAC, but with different "POSITION, HEIGHT, LENGTH" attributes etc...
--
define method .mdsancill(!support is DBREF)

  -- Store the ORIGINAL component
  !ce = !!ce

  -- Initialise Variables
  !ancills = ARRAY()

  -- Get the MDS ANCILLARY ATTAS belonging to a MDS STRUCTURE
  if (!support.type.eq('STRU')) then
    -- MDS STRUCTURE DATUM Atta
    !nameofatta = !support.name & '/DATUM'
    !suppname   = !support.name
  else
    -- Independent MDS Ancillary Atta
    !nameofatta = !support.name
    !suppname   = !nameofatta
  endif

  -- Append ALL "PHYSICAL" MDS ANCILLARY ATTAS on the MDS Support
  !ancills.append('$!nameofatta' )

  do !indx from 1 to 100
    $!suppname$n.$n$!indx
    handle NONE
      !ancills.append('$!suppname$n.$n$!indx' )
    elsehandle ANY
      skip
    endhandle
  enddo
  !ancills.compress()
  !this.attadbrf.appendarray(!ancills)

  -- Unique the ARRAY ".attadbrf" and Populate the Ancillary Descriptions OBJECT member ".attadesc"
  !this.attadbrf.unique()
  !this.mdsdescriptions(!support,'ATTA')

  -- Navigate back to the ORIGINAL component
  !!ce = !ce

endmethod

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Method to load the OBJECT member .mainmem for both INDIVIDUAL MDS Supports
-- and MDS GROUP Supports
--
define method .mdsmainmem(!support is DBREF)

  -- Store the ORIGINAL component
  !ce = !!ce

  -- Get the MAIN GROUP MEMBERS of the MDS Support for a NEW MDS Group
  if (!this.mdsgroup) then
    -- Support Framework is the master MDS FRAMEWORK STRUCTURE in a MDS GROUP
    -- Collect ALL MDS Group MAIN members, i.e. Master MDS STRU plus any additional MDS RESTRAINT "ATTAS"
    !groupname  = '/' & !this.suppname
    !grouparray = ARRAY()
    !suppmem    = ARRAY()

    -- CHECK for a MAXIMUM of 30 MDS MAIN GROUP MEMBERS,i.e. Master MDS STRU plus any additional MDS RESTRAINT HANGER "ATTAS"
    do !gnum from 1 to 30
      if ((!gnum.eq(1)) and (!support.type.eq('STRU'))) then
        -- Master MDS GROUP FRAMEWORK "STRUCTURE" element
        !cename = !groupname + '[$!gnum]'
        !!ce    = !cename.dbref()
        !grouparray[!gnum] = !!ce

        -- Populate the MDSABASUPPORT object member ".members" with the MASTER MDS GROUP STRUCTURE,
        -- as if it were an "INDIVIDUAL" normal MDS FRAMEWORK STRUCTURE
        --          !desdata.members  = !!mdsabasupportmem(!support)

        --<wd>mar2006
        -- ENSURE that ONLY MDS GROUP RESTRAINT HANGER ATTAS are ADDED to the MDS GROUP MEMBERS
        -- When another MDS GROUP STRUCTURE Support exists, other than the MASTER MDS GROUP STRUCTURE,
        -- i.e.  <suppname>[1], it is IGNORED by the MDS VPRM MTO interface.
        --
        -- *** IMPORTANT NOTE ***
        -- The ERROR HANDLING and the MDS VPRM MTO LOG file CODE for this is included in the
        -- calling PML function "mdsvprm.pmlfnc" at approx. line 465
        --
        --<wd>mar2006

      else

        -- Additional MDS GROUP RESTRAINT HANGER "ATTAS"
        !cename = !groupname + '[$!gnum]'
        !!ce    = !cename.dbref()
        handle ANY
          -- MDS ATTA for the PDMS Restraint DOES NOT EXIST so SKIP
          skip
        elsehandle NONE
          -- MDS ATTA for the PDMS Restraint EXISTS so add it to the GROUP ARRAY
          --<wd>mar2006
          --!grouparray[!gnum] = !!ce
          -- SKIP and IGNORE ALL OTHER MDS STRUCTURE elements in the MDS GROUP
          if (!!ce.type.eq('STRU')) then
            skip

          else
            -- MDS ATTA for the PDMS Restraint EXISTS so add it to the GROUP ARRAY
            !grouparray[!gnum] = !!ce

          endif
          --<wd>mar2006
        endhandle
      endif
    enddo

    -- Navigate to the Master MDS GROUP Framework Structure
    --      !!ce = !grouparray[1]

    -- Append the MDS Support ATTAS for EACH of the other MAIN MDS GROUP MEMBERS<MDS HANGERS>
    do !maincomp indices !grouparray
      !groupsuppmem = !!mdsabasupportmem(!grouparray[!maincomp])
      !suppmem.appendarray(!groupsuppmem)
    enddo
    !this.mainmem = !grouparray
    !this.allmem  = !suppmem

  else
    --q var !support.name
    -- MDS Support is an "INDIVIDUAL Stand-Alone" MDS ANCILLARY, MDS HANGER or MDS FRAMEWORK STRUCTURE
    !this.mainmem.append(!support.name)
    !this.allmem  = !!mdsabasupportmem(!support)
  endif

  -- Navigate back to the ORIGINAL component
  !!ce = !ce

endmethod

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Method to load the OBJECT members ".strudesc and/or .hangdesc and/or .attadesc"
-- and ".strutype and/or .hangtype and/or .attatype"
-- for both INDIVIDUAL MDS Supports and MDS GROUP Supports
--
define method .mdsdescriptions(!support is DBREF, !supptype is STRING)

  -- Store the ORIGINAL component
  !ce = !!ce

  -- The Attribute used to Output the MDS Component Descriptions is DICTATED by the source
  -- of the MDS Hanger Interface, i.e. 'LISEGA' or 'PSL' or 'CPL' or 'MDS'<Hanger Templates in /MDS/HANGERS>
  if (!!mdshangif.trim().upcase().eq('LISEGA')) then
    !this.descattr = 'DTXR'

  elseif (!!mdshangif.trim().upcase().eq('CPL')) then
    !this.descattr = 'DTXR'

  elseif (!!mdshangif.trim().upcase().eq('PSL')) then
    !this.descattr = 'DTXS'

  elseif (!!mdshangif.trim().upcase().eq('MDS')) then
    !this.errorarray.append(' ERROR -- Unable to Process MDS-VPRM MTO transfer for MDS Support "$!support.name"')
    !this.errorarray.append('  MDS VPRM MTO will not contain this MDS Support')

    return
  endif

  -- Determine the Descriptions for ALL of the MDS Support components which are stored in
  -- the object ARRAY members ".strudbrf, .hangdbrf or .attadbrf" for all MDS Supports
  if (!supptype.eq('STRU')) then
    if (!this.strudbrf.size().neq(0)) then
      -- MDS FRAMMEWORK STRUCTURE
      !this.mdsstrudesc(!support)
    endif

  elseif (!supptype.eq('HANG')) then
    if (!this.hangdbrf.size().neq(0)) then
      -- MDS HANGER
      !this.mdshangdesc(!support)
    endif

  elseif (!supptype.eq('ATTA')) then
    if (!this.attadbrf.size().neq(0)) then
      -- MDS ANCILLARY
      !this.mdsattadesc(!support)
    endif
  endif

  -- Navigate back to the ORIGINAL component
  !!ce = !ce

endmethod

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Method to load the OBJECT members ".strudesc" and ".strutype"
-- for both INDIVIDUAL MDS Supports and MDS GROUP Supports
--
define method .mdsstrudesc(!support is DBREF)

  -- Set types for all from the !s array
  !strumem       = !this.strudbrf
  var !stype eval type for all from !strumem
  !this.strutype = !stype
  -- Get all the descriptions for the "MDS FRAMEWORK" data/components.
  do !desc index !this.strudbrf

    if (!this.strutype[!desc] eq 'SCTN') then
      -- Append the Description of the SCTN Matref
      !matl = !this.strudbrf[!desc].dbref().matref.description
      handle any
        !matl = ''
      elsehandle NONE
        if (!matl.eq('')) then
          !matl = !this.strudbrf[!desc].dbref().matref.:mdsmatdesc
          if (!matl.neq('')) then
            !matl = ' (' & !matl & ')'
          endif
        else
          !matl = ' (' & !matl & ')'
        endif
      endhandle
      -- Get description from the MDS attribute :mdssizetag from the SPRF of the CATREF of the SPREF
      !temp = :mdssizetag of catref of spref of $!this.strudbrf[$!desc] & !matl
      !this.strudesc.append(!temp)
      !cutl = tctl of  $!this.strudbrf[$!desc]
      !this.struquan.append(!cutl)


    elseif (!this.strutype[!desc] eq 'PJOI' or !this.strutype[!desc] eq 'SJOI' or !this.strutype[!desc] eq 'FITT') then
      -- Get the material description if set
      !matl = !this.strudbrf[!desc].dbref().matref.description
      handle any
        !matl = ''
      elsehandle none
        !matl = ' (' & !matl & ')'
      endhandle
      -- Get description from the MDS attribute $!this.descattr "DTXS" or "DTXR" of DBREF for PJOI, SJOI, FITT
      -- Previously this line of CODE was HARD CODED to "DTXR" --see below
      !temp = $!this.descattr of $!this.strudbrf[$!desc] & !matl
      handle ANY
        !temp = 'Invalid specification ref found'
      elsehandle NONE
        if (!temp.trim()eq('')) then
          !temp = !this.strudbrf[!desc].dbref().type & ' ' & !this.strudbrf[!desc].dbref().name & ' ** $!this.descattr attribute is NOT set.'

        elseif (!temp.upcase().trim().matchwild('PLATE T=*')) then
          -- *** IMPORTANT REQUIREMENT --
          -- *** Need to ADD PLATE X & Y SIZES in DESCRIPTIONS with 'Plate t=*' for QUANTIFYING PLATES
          !dbf = !this.strudbrf[!desc].dbref()
          !xlen = !dbf.prop.xlen
          handle ANY
            !xlen =''
          endhandle
          !ylen = !dbf.prop.ylen
          handle ANY
            !ylen =''
          endhandle

          -- Modify !temp Plate Description with the Plate "X & Y" sizes
          !temp = 'Dimension ' & !xlen & 'x' & !ylen & ' ' & !temp

        endif
      endhandle

      !this.strudesc.append(!temp)
      !this.struquan.append('1')

    elseif (!this.strutype[!desc] eq 'BOX') then

      -- Have to go to BOX to get text string
      $!this.strudbrf[$!desc]
      -- Set the Steel Length(!sctnquan) to the Correct PDMS Distance Units
      -- stored in the form member !this.units
      if (!this.units.isImperialSavedDist()) then
        -- Temporarily Set Distance Units Back to the Required Output units
        --          $!this.units distance
        units inch dist
        -- Output Plate sizes in INCHES and NOT Feet and INCHES
        !xlen = !!ce.xlen.distance(false,true,true,16,false)
        !ylen = !!ce.ylen.distance(false,true,true,16,false)
        !zlen = !!ce.zlen.distance(false,true,true,16,false)
      else
        !xlen = !!ce.xlen.string()
        !ylen = !!ce.ylen.string()
        !zlen = !!ce.zlen.string()
      endif
      -- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
      -- the matref attribute has been added to atta. Find the correct attribute to use
      -- The variable !matrefAtt will be set to either REF for matref or UDA for :MdsMatref
      !matrefAtt = !!mdsUseMatref(!!ce)
      -- If the :mdsmatref is set use the description
      if (!matrefAtt.eq('UDA')) then
        if (!!ce.:mdsmatref.set()) then
          !materialdesc = !!ce.:mdsmatref.desc
          if (!materialdesc.eq('')) then
            !materialdesc = !!ce.:mdsmatref.:mdsmatdesc
          endif
        else
          !materialdesc = ''
        endif
      else
        if (!!ce.matref.set()) then
          !materialdesc = !!ce.matref.desc
          if (!materialdesc.eq('')) then
            !materialdesc = !!ce.matref.:mdsmatdesc
          endif
        else
          !materialdesc = ''
        endif
      endif
      -- Set Distance Units Back to Metric in all cases
      units MM Distance
      !sizes = ARRAY()
      !sizes.append(!xlen)
      !sizes.append(!ylen)
      !sizes.append(!zlen)
      !sizes.sort()
      !temp = 'plate ($!sizes[3] x $!sizes[2] x $!sizes[1] thk.) ' + !materialdesc
      !this.strudesc.append(!temp)
      !this.struquan.append(1)
    endif
  enddo

  !this.units.restoreSavedUnitsByPtype('DIST')
endmethod

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Method to load the OBJECT members ".hangdesc" and ".hangtype"
-- for both INDIVIDUAL MDS Supports and MDS GROUP Supports
--
define method .mdshangdesc(!support is DBREF)

  -- Set types for all from the !hangelements array
  !hangmem       = !this.hangdbrf
  var !htype eval type for all from !hangmem
  !this.hangtype = !htype

  -- Get all the descriptions for the "MDS HANGER" data/components.
  do !hdesc indices !this.hangdbrf
    skip if (!this.hangtype[!hdesc] eq 'TEXT')
    !temp = $!this.descattr of $!this.hangdbrf[$!hdesc]
    handle (2,201) (2,114)
      !temp = 'Unable to evaluate $!this.descattr for $!this.hangdbrf[$!hdesc]'

    elsehandle NONE
      -- Check for any "IMPLIED ROD" elements used on MDS HANGERS created via a MDS to HANGER MANUFACTURER Interface
      if (!this.hangdbrf[!hdesc].dbref().type.eq('TUBI')) then
        -- Append the ITLE - "Implied Tube<ROD> Length" to the DESCRIPTION
        !rodlength = ' (' & !this.hangdbrf[!hdesc].dbref().itlength.string() & 'mm)'
        !temp      = !temp & !rodlength
      endif
    endhandle
    !temp2 = |$!temp|
    !this.hangdesc.append(!temp2)
    !this.hangquan.append(1)
  enddo

endmethod

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Method to load the OBJECT members ".attadesc" and ".attatype"
-- for both INDIVIDUAL MDS Supports and MDS GROUP Supports
--
define method .mdsattadesc(!support is DBREF)

  -- Set types for all from the !hangelements array
  !attamem = !this.attadbrf
  !atype   = ARRAY()
  do !val value !attamem
    !type = !val.dbref().type
    !atype.append(!type)
  enddo
  !this.attatype = !atype

  -- Get all the descriptions for the "MDS ANCILLARY ATTA" data/components.
  do !adesc indices !this.attadbrf
    skip if (!this.attatype[!adesc] eq 'TEXT')
    !temp = $!this.descattr of $!this.attadbrf[$!adesc]
    handle (2,201) (2,114) (2,220)
      !temp = 'Unable to evaluate $!this.descattr for $!this.attadbrf[$!adesc]'
    endhandle
    !temp2 = |$!temp|
    !this.attadesc.append(!temp2)
    !this.attaquan.append(1)
  enddo
endmethod


-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Method to load, quantify and realign the OBJECT members - .strutags and .strudesc
-- for both INDIVIDUAL MDS Supports and MDS GROUP Supports
--
define method .mdsstrutotals(!list is ARRAY, !type is STRING, !mdsgroup is BOOLEAN)

  do !entry value !list
    if (defined(!sctnquan)) then
      !sctnquan.delete()
    endif
    !sctnref  = !entry.split('|')[2]
    --
    -- Determine if "ACTUAL" or "BULK" MDS-VPRM MTO required
    $(
    if (!this.mtotype.eq('ACTUAL')) then

      -- Set the MDS MTO "PREFIX and POSITION" Numbers for the "ACTUAL" MDS-VPRM MTOtransfer file
      if (!sctnref.dbref().type.eq('SCTN')) then

        !this.sctnindx = !this.sctnindx + 1

        -- "MDS SCTN SPOOL" identifiers NOT REQUIRED in "VPRM" on "BULK" or "ACTUAL" MTO
        --      if !this.taskparams[13].boolean() then
        --         !spoolnum = !sctnref.dbref().:mdsspool
        --         !sctnid   = !this.taskparams[8] & !this.sctnindx + '($!SpoolNum)'
        --      else
        !sctnid = !this.mtosteel.taskparams[8] & !this.sctnindx
        --      endif

      elseif (!sctnref.dbref().type inset ('PJOI','SJOI','FITT')) then

        !this.sjoiindx = !this.sjoiindx + 1
        !sctnid        = !this.mtosteel.taskparams[10] & !this.sjoiindx

      elseif (!sctnref.dbref().type.eq('BOX')) then

        !this.boxindx = !this.boxindx + 1
        !sctnid       = !this.mtosteel.taskparams[9] & !this.boxindx

        --        else
        -- MDS Hangers
        --          !this.hangindx = !this.hangindx + 1
        --          !sctnid        = !this.mtosteel.taskparams[11] & !this.hangindx
      endif

      $)
      --***********************************************


      --*********************** --
      -- *** IMPORTANT NOTE *** --
      --*********************** --
      -- Use the SAME PML CODE for BULK and ACTUAL MDS VPRM MTO Transfer File Generation
      ----------------------------------------------------------------------------------
      --elseif (!this.mtotype.eq('BULK')) then

      if ( (!this.mtotype.eq('BULK')) or (!this.mtotype.eq('ACTUAL')) ) then
        -- ONLY Set "TEMPORARY" Sequential REAL numbers from 1 to '<lastnumber>' for ALL elements in the MDS Support
        -- Populate the ARRAY but DO NOT PASS the POSITION NUMBER to the BULK MDS-VPRM MTO transfer file
        -- Only use the "!this.sctnindx" member for ALL types of element in the MDS Support

        if (!sctnref.dbref().type inset ('SCTN','PJOI','SJOI','FITT','BOX')) then
          !this.sctnindx = !this.sctnindx + 1
          !sctnid        = !this.sctnindx
        endif
      endif

      !sctntext = !entry.split('|')[3]
      !sctnquan = !entry.split('|')[4].real()

      -- Set the Steel Length(!sctnquan) to the Correct PDMS Distance Units
      -- stored in the Object member !this.units
      if (!this.units.isImperialSavedDist()) then
        onerror golabel /units
        -- Temporarily Set Distance Units Back to the Required Output units
        !this.units.restoreSavedUnitsByPtype('DIST')
        if (!sctnquan.gt(1)) then
          !sctnquan = $!sctnquan
          !sctnlen  = !sctnquan.distance(true,false,true,8,true).replace(' ','')
          !sctnquan.delete()
          !sctnquan = !sctnlen
        endif
        -- Set Distance Units Back to Metric
        label /units
        onerror return
        units MM Distance
      endif

      -- Check if the MDS FRAMEWORK belongs to a MDS GROUP
      --      if (!mdsgroup) then
      -- MDS FRAMEWORK SUPPORT belongs to a MDS GROUP
      --        if (!this.struelem[2].findfirst(!sctnref).unset()) then
      !this.struelem[1].append(!sctnid)
      !this.struelem[2].append(!sctnref)
      !this.struelem[3].append(!sctntext)
      !this.struelem[4].append(!sctnquan)
      --        endif
      --      else
      -- Original Code -- Individual MDS FRAMEWORK SUPPORT
      --        if (!this.elements[2].findfirst(!sctnref).unset()) then
      --          !this.elements[1].append(!sctnid)
      --          !this.elements[2].append(!sctnref)
      --          !this.elements[3].append(!sctntext)
      --          !this.elements[4].append(!sctnquan)
      --        endif
      --      endif

    enddo

    --<wd>14may2004 - TEMPORARY
    !!felem = !this.struelem

    !this.units.restoreSavedUnitsByPtype('DIST')

  endmethod
  -- end of .mdsstrutotals()

  -------------------------------------------------------------------------------
  -------------------------------------------------------------------------------
  -- Method to load, quantify and realign the OBJECT members - .hangtags and .hangdesc
  -- for both INDIVIDUAL MDS Supports and MDS GROUP Supports
  --
  define method .mdshangtotals(!list is ARRAY, !type is STRING, !mdsgroup is BOOLEAN)

    -- MDS Hangers Only
    -- For Progressive MTO Position/Index Numbers in the ARRAY -- The ".sctnindx" value is used for MDS GROUPS Only
    if (!this.mdsgroup) then
      !this.hangindx = !this.sctnindx
    endif

    -- Loop through Hanger Components
    -- Determine MTO Position/Index Numbers, DBREFs , Descriptions and Quantities
    -- to Set the Object member ".hangelem" ARRAYS

    do !val values !list
      !hangref = !val.split('|')[2]

      -- IGNORE any HANGER Components where the UDA ":mdsvprmmto = FALSE"
      -- DBREF TYPES <TUBI> i.e. IMPLIED TUBE and <SPCO> i.e. HEXAGON NUT-- DO NOT have the UDA :mdsvprmmto
      !hangtyp = !val.split('|')[1]
      if (not !hangtyp inset ('TUBI','SPCO')) then
        skip if (!hangref.dbref().:mdsvprmmto.not())
      endif

      !this.hangindx = !this.hangindx + 1
      !hangid        = !this.hangindx
      !hangtext = !val.split('|')[3]
      !hangquan = !val.split('|')[4].real()

      -- Populate the ARRAYS for the Object member !this.hangelem
      !this.hangelem[1].append(!hangid)
      !this.hangelem[2].append(!hangref)
      !this.hangelem[3].append(!hangtext)
      !this.hangelem[4].append(!hangquan)

    enddo


    --<wd> - TEMPORARY VARIABLE for REF ONLY
    !!helem = !this.hangelem

  endmethod

  -------------------------------------------------------------------------------
  -------------------------------------------------------------------------------
  -- Method to load, quantify and realign the OBJECT members - .attatags and .attadesc
  -- for both INDIVIDUAL MDS Supports and MDS GROUP Supports
  --
  define method .mdsattatotals(!list is ARRAY, !type is STRING, !mdsgroup is BOOLEAN)

    -- MDS ANCILLARY ATTAS Only
    -- For Progesssive MTO Position/Index Numbers in the ARRAY -- The ".hangindx" value is used for MDS GROUPS Only
    if (!this.mdsgroup) then
      !this.attaindx = !this.hangindx
    endif

    -- Loop through Hanger Components
    -- Determine MTO Position/Index Numbers, DBREFs , Descriptions and Quantities
    -- to Set the object member ".hangelem" ARRAYS
    do !val values !list
      !attaref  = !val.split('|')[2]

      -- IGNORE any ATTA Components where the UDA ":mdsvprmmto = FALSE"
      skip if (!attaref.dbref().:mdsvprmmto.not())

      !this.attaindx = !this.attaindx + 1
      !attaid        = !this.attaindx
      !attatext = !val.split('|')[3]
      !attaquan = !val.split('|')[4].real()

      -- Populate the ARRAYS for the Object member !this.hangelem
      !this.attaelem[1].append(!attaid)
      !this.attaelem[2].append(!attaref)
      !this.attaelem[3].append(!attatext)
      !this.attaelem[4].append(!attaquan)

    enddo

    --<wd> - TEMPORARY VARIABLE for REF ONLY
    !!atelem = !this.attaelem

  endmethod

  -------------------------------------------------------------------------------
  -------------------------------------------------------------------------------

  -- Method:      .mtostructure
  -- Description: Total the QUANTITES of the STEEL Joints &/or Fittings ONLY on a MDS FRAMEWORK
  --              and OUTPUT in the STEEL MTO. TOTAL the quantities for each item that is identical.
  -- ********************
  -- ** IMPORTANT NOTE **: SCTN members of a MDS FRAMEWORK always belong to a MDS SPOOL No. of the MDS FRAMEWORK.
  -- ********************  Therefore the SCTN members will still be OUTPUT in STEEL MTO as INDIVIDUAL items along
  --                       with the MDS Spool Number plus the TRUE CUT LENGTH of the SCTN (TCTL) in the quantity
  --                       column of the STEEL MTO.
  -------------------------------------------------------------------------
  -------------------------------------------------------------------------
  define method .mtostructure(!struelem is ARRAY) is ARRAY

    -- Check Passed ARRAY and RETURN same ARRAY back if ARRAY size = 1
    --if (!struelem[1].size().eq(1)) then
    --  return !struelem
    --endif

    -- Split the arrays !struelem[1],[2],[3] and [4] according to the Task Prefixes found above and
    -- TOTAL the quantities for DUPLICATE JOINTS and/or STIFFENER PLATES ONLY.
    -- SCTN struelem will REMAIN as BEFORE, i.e. INDIVIDUALLY listed in the STEEL MTO.
    -- !struelem[1] contains all the STEEL MTO - TAGS          >
    -- !struelem[2] contains all the STEEL MTO - DBREFS        >        -- **** IMPORTANT NOTE **** --
    -- !struelem[3] contains all the STEEL MTO - DESCRIPTIONS  >  All of the ARRAYS contain the SAME number of indices.
    -- !struelem[4] contains all the STEEL MTO - QUANTITIES    >

    -------------------------------------------------
    -- Fix for MDS SPECIAL STRUCTURES that DO NOT contain any SCTN members in the STRUCTURE
    -- Create EMPTY ARRAYS for <!struelem & !xnewarray> [1] to [4] inclusive
    if (!struelem.empty() or !struelem.unset()) then
      do !real from 1 to 4
        !struelem[!real] = ARRAY()
        !xnewarray[5][!real] = ARRAY()
      enddo
    endif

    -------------------------------------------------

    !!xmdsabastru = ARRAY()
    -- Compress the Structure Array for SCTNS, JOINTS and STIFFENERS where DUPLICATE items occur and TOTAL them.
    !newstruelem = !this.mtototals(!struelem,'STRU')

    -- Compress the Arrays before Returning
    !newstruelem[1].compress()
    !newstruelem[2].compress()
    !newstruelem[3].compress()
    !newstruelem[4].compress()
    !newstruelem[5].compress()

    --<wd> TEMPORARY VAR *** DO NOT DELETE ***
    !!xmdsabanew.delete()
    handle ANY
    endhandle
    !!xmdsabanew = !newstruelem

    -- The NEW COMBINED ARRAY "!xnewstruelem[5"] will store ARRAYS of the INDICES of the DBREF(s) found
    -- in the ARRAY "!xnewstruelem[2]" which have the SAME description i.e. <DTXR or DTXS>.
    -- The INDIVIDUAL ARRAYS "!newsctnarray[5], !newjoinarray[5] and !newstifarray[5]"
    -- containing the SCTNS, JOINTS and STIFFENERS will be amalgamated into the NEW COMBINED ARRAY "!xnewstruelem[5]".
    !xnewstruelem = !newstruelem
    --   !xnewstruelem[2][1].delete()
    --   !xnewstruelem[2].compress()

    -- This NEW ARRAY "!xnewarray[5]" will store ARRAYS of the INDICES of the DBREF(s) found
    -- in the ARRAY "!xnewstruelem[2]" which have the SAME description i.e. <DTXR or DTXS>
    --   !xnewarray[5] = ARRAY()

    -- Initialise the SCTN, JOINT and STIFFENER array "size" variables
    !xsctnsize  = 0
    !unusedXjoinsize  = 0
    !unusedXstifsize  = 0

    -- When SCTNS exist -- <which currently they "ALWAYS" do, EXCEPT on SOME MDS SPECIALS, when JOINTS and/or STIFFENERS exist on a MDS STRUCTUE>
    -- Modify the ARRAY !xnewarray[5] for adding the VIEW TAGS for the SCTNS
    if (!newstruelem.empty().not()) then
      !xsctnsize  = !newstruelem[5].size()
      !xsctnstart = 1
      -- The FIRST "Do loop" determines the START and FINISH INDEX numbers of the SCTNS in the ARRAY "!xnewarray[5]",
      -- and uses the "!indices" counter to create a new SUB-ARRAY iteration, i.e. "!xnewarray[5][!indices]"
      !zsctn = 0
      do !indices from !xsctnstart to !xsctnsize
        !xnewarray[5][!indices] = ARRAY()
        !zsctn = !zsctn + 1
        -- The SECOND "Do loop" determines the INDEX NUMBER(s) stored in the ARRAY "!xnewstruelem[2]",
        -- and stores the same INDEX NUMBER(s) in the ARRAY "!xnewarray[5][!indices]" for use
        -- in adding the VIEW TAGS for MDS SUPPORT COMPONENTS on the MDS ABA drawing
        -- via the PML function "mdsabasteeltags.pmlfnc"
        do !nsctn indices !newstruelem[5][!zsctn]
          !nindx = !xnewstruelem[2].find(!newstruelem[2][!newstruelem[5][!zsctn][!nsctn]])
          !xnewarray[5][!indices].append(!nindx[1])
        enddo
      enddo
    endif

    -- Update the object member ".strutags"
    !this.strutagf = !newstruelem[1]
    !this.strutagn = !xnewarray[5]

    -- Return the Rearranged !struelem array
    return !newstruelem

  endmethod
  --End of Method .mtostructure()

  -------------------------------------------------------------------------
  -------------------------------------------------------------------------
  -- Method:      .mtohanger
  -- Description: TOTAL the QUANTITES of the Identical HANGER Elements and OUTPUT them in the "HANGER<steel>" MTO.
  --              <HANGERS MTO uses the same ABA TASK, PML form, function and object as for the STEEL MTO i.e. "MDSABAMTOSTEEL" >
  -------------------------------------------------------------------------
  -------------------------------------------------------------------------
  define method .mtohanger(!hangelem is ARRAY) is ARRAY

    -- Create a list of ARRAYS for TAGGED and TOTALLED components in the ARRAY !newhangelem
    !newhangelem = !this.mtototals(!hangelem,'HANG')
    --<wd> -- The ARRAY variable !newhangelem will NOW have an extra iteration, i.e. Number [5]

    --<wd>-- Temporary variable
    !!xnewhangelem  = !newhangelem

    -- Compress the Arrays before Returning
    !newhangelem[1].compress()
    !newhangelem[2].compress()
    !newhangelem[3].compress()
    !newhangelem[4].compress()
    !newhangelem[5].compress()

    -- Re-Define the !hangelem ARRAY
    return !newhangelem

  endmethod

  -------------------------------------------------------------------------
  -------------------------------------------------------------------------
  --
  -- Method:      .mtoancillary
  -- Description: TOTAL the QUANTITES of the Identical MDS ANACILLARY Elements and OUTPUT them MTO.
  --
  ---------------------------------------------------------------------------
  -------------------------------------------------------------------------
  define method .mtoancillary(!attaelem is ARRAY) is ARRAY

    -- Create a list of ARRAYS for TAGGED and TOTALLED components in the ARRAY !newhangelem
    !newattaelem = !this.mtototals(!attaelem,'ATTA')
    --<wd> -- The ARRAY variable !newattaelem will NOW have an extra iteration, i.e. Number [5]

    --<wd>-- Temporary variable
    !!xnewattaelem  = !newattaelem

    -- Compress the Arrays before Returning
    !newattaelem[1].compress()
    !newattaelem[2].compress()
    !newattaelem[3].compress()
    !newattaelem[4].compress()
    !newattaelem[5].compress()

    -- Re-Define the !hangelem ARRAY
    return !newattaelem

  endmethod

  -------------------------------------------------------------------------
  -------------------------------------------------------------------------

  -- Method:      .mtototals
  -- **************
  -- ** NOTE **  -- This method is now also called from the method ".mtohanger" above,
  -- ************** used for TOTALLING the MDS HANGER components
  --
  -- Description: Total the QUANTITES of the STEEL Joints &/or Fittings ONLY on a MDS FRAMEWORK
  --              and OUTPUT in the STEEL MTO. TOTAL the quantities for each item that is identical.
  -- ********************
  -- ** IMPORTANT NOTE **: SCTN members of a MDS FRAMEWORK always belong to a MDS SPOOL No. of the MDS FRAMEWORK.
  -- ********************  Therefore the SCTN members will still be OUTPUT in STEEL MTO as INDIVIDUAL items along
  --                       with the MDS Spool Number plus the TRUE CUT LENGTH of the SCTN (TCTL) in the quantity
  --                       column of the STEEL MTO.
  --
  -- ** NOTE **  -- This method is now  also called from the method ".mtohanger" above,
  -- *************  used for totalling the MDS HANGER components
  -------------------------------------------------------------------------
  -------------------------------------------------------------------------
  define method .mtototals(!passedarray is ARRAY, !type is STRING) is ARRAY

    -- Initialise Variable
    !oldarray = !passedarray

    -- Compress the !oldarray arrays to ReIndex the arrays from 1 to 'x' consecutively
    !oldarray[1].compress()
    !oldarray[2].compress()
    !oldarray[3].compress()
    !oldarray[4].compress()

    -------------------------------------------------------------------------
    -- Set !oldarray[4] to total of each type and zero subsequent
    -- values and substitute tags

    -- oldarray[1] stores the tags
    -- oldarray[2] stores the dbref of the elements
    -- oldarray[3] stores the description
    -- oldarray[4] stores the quantity

    -- MODIFY the array iterations for "!oldarray[3]",i.e. descriptions, for SCTN elements to INCLUDE the "TCTL" length of the SCTN
    -- and MODIFY the corresponding iteration of the array "!oldarray[1]", i.e. "TCTL" length of the SCTN, to be "1" off
    if (!type.eq('STRU')) then
      !copyold = !oldarray
      do !number indices !oldarray[3]
        skip if (!oldarray[3][!number].trim().eq(''))
        --skip if (!oldarray[2][!number].dbref().type.neq('SCTN'))
        skip if ( (!oldarray[2][!number].dbref().type.neq('SCTN')) and (!oldarray[2][!number].dbref().type.neq('PJOI')) and (!oldarray[2][!number].dbref().type.neq('SJOI')) )

        if (!oldarray[2][!number].dbref().type.eq('SCTN')) then
          !length = !oldarray[4][!number].nint()
          !copyold[3][!number] = !oldarray[3][!number].trim() & ' (' & !length & 'mm)'
          !copyold[4][!number] = 1

          --<wd>--25may05
          -- NEW CODE STARTED HERE for ADDING the TYPE and SIZE LETTER of the *U6* BUILDING ATTACHMEMNTS to the DESCRIPTION
        elseif ((!oldarray[2][!number].dbref().type inset ('PJOI','SJOI')) and (!oldarray[2][!number].dbref().catre.name.matchwild('*U6*'))) then
          !catre = !oldarray[2][!number].dbref().catref.namn
          !copyold[3][!number] = !oldarray[3][!number].trim() & ' Size ' & !catre
          !copyold[4][!number] = 1
        endif
        --<wd>--25may05


      enddo
      -- Reset !oldarray Values and Object members
      !oldarray = !copyold
      !this.strudesc = !oldarray[3]
      !this.struquan = !oldarray[4]
    endif

    -- While compressing the list make a new !newelements[1]
    -- and !newelements[2] so that we can replace the tags.
    !newelements[1] = ARRAY()
    !newelements[2] = ARRAY()
    !newelements[2] = !oldarray[2]
    !findsame       = ARRAY()

    -- Create a NEW iteration, [5], of the variable "!newelements" to store an array of the
    -- "SAME" Description element ARRAY numbers
    !newelements[5] = ARRAY()
    !testnewelem   = ARRAY()

    -- Loop thro the Descriptions ARRAY to find DUPLICATES
    do !count indices !oldarray[3]

      --$P++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++=
      --$P    *********************** !count is $!count *****************************
      --$P++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++=

      --if (!findsame.empty().not()) then
      --!testfind = !findsame.find(!count)
      if (!testnewelem.empty().not()) then
        !testfind = !testnewelem.find(!count)
        --$P ---- q var !!testnew !findsame
        -- q var !testnewelem !findsame
        --$P ---- q var !testfind
        --  q var !testfind

        --$P-------- SKIPPING ? -------------
        skip if (!testfind.empty().not())
        --$P=====-- ** NO ** NOT SKIPPING ** --=======

      endif

      --      if !oldarray[1][!count].trim().neq('') then
      if (!oldarray[1][!count].string().trim().neq('')) then
        -- NOTE:
        -- The !findsame variable will ALWAYS return an array of REALS,
        -- even if ONLY ONE item is found in the ARRAY
        !findsame = !oldarray[3].find(!oldarray[3][!count])

        --$P ==1=== q var !findsame
        --q var !findsame
        --$P ======================
        ---------------------------------------------------------------------
        -- Wrapped text does not total correctly -- check to see if text wrapped
        !tempfindsame = !findsame
        !loopcount = 1
        do !check values !findsame
          if (!count lt !oldarray[3].size() and (!oldarray[1][!count + 1].string().trim().eq(''))) then
            -- $P CHECK  |next column 1 is blank therefore text wrapped|
            !nextlinedesc = !oldarray[3][!count + 1]
            !samenextlinedesc = !oldarray[3][!findsame[!loopcount] + 1]
            if (!nextlinedesc neq !samenextlinedesc ) then
              !tempfindsame[!loopcount].delete()
            endif
          endif
          !loopcount = !loopcount + 1
        enddo
        !findsame = !tempfindsame

        --$P ==2=== q var !findsame
        --q var !findsame
        --$P ======================
        ---------------------------------------------------------------------
      endif

      !newelements[5].append(!findsame)
      !testnewelem.appendarray(!findsame)

      --$P ==$!count=== q var !newelements[5]
      --q var !newelements[5]
      --$P ======================

      -- Determine the QUANTITY of DUPLICATE items and determine the NEW TAG Prefix and Number
      !counter = 1
      do !same values !findsame
        if (!findsame.size().gt(1)) then
          if (!counter.eq(1)) then
            !unusedOrigoldarray = !same
            !oldarray[4][!same] = !findsame.size()
            !newtag = !oldarray[1][!same]
            !counter = 1 + 1
            skip
          else
            !oldarray[4][!same] = 0
            !oldarray[1][!same] = !newtag
          endif
        else
          -- Only ONE element found with the DESCRIPTION
          if (!oldarray[2][!count].dbref().type.eq('SCTN')) then
            -- Length "TCTL" of SCTN is Normally Stored in the array iteration "!oldarray[1][!count]" -- Reset it to "1"
            !newelements[1][!count] = 1
          else
            !newelements[1][!count] = !oldarray[1][!count]
          endif
        endif
      enddo

    enddo

    -- Find zero values in quantity (!oldarray[4]) and delete
    !delindex = FALSE
    !delarray = ARRAY()
    !number   = 0
    do !blank from 1 to !oldarray[4].size()
      !test.delete()
      handle any
      endhandle
      !test = !oldarray[4][!blank]
      handle any
        skip
      endhandle

      -- REBUILD the ARRAY *** !oldarray *** for the ITEM Prefixes and Numbers
      if (!oldarray[4][!blank].objecttype().eq('REAL')) then
        if (!oldarray[4][!blank].eq(0)) then
          !newelements[1][!blank] = !oldarray[1][!blank]
          !delarray[1][!blank] = !oldarray[1][!blank]
          !delarray[3][!blank] = !oldarray[3][!blank]
          !delarray[4][!blank] = !oldarray[4][!blank]
          !delindex = TRUE
          !number   = !blank
        endif
      elseif (!oldarray[4][!blank].objecttype().eq('STRING')) then
        if (!oldarray[4][!blank].trim().eq('')) then
          !nextnumber = !blank - !number
          if ( (!delindex) and (!nextnumber.eq(1)) ) then
            !delarray[1][!blank] = !oldarray[1][!blank]
            !delarray[3][!blank] = !oldarray[3][!blank]
            !delarray[4][!blank] = !oldarray[4][!blank]
            !delindex = FALSE
          endif
        endif
      else
        !newelements[1][!blank] = !oldarray[1][!blank]
      endif
    enddo

    -- Delete the Indices stored in !delarray[1], [3] and [4] from the array !oldarray[1], [3] and [4]
    do !indx indices !delarray[1]
      !oldarray[1][!indx].delete()
      !oldarray[3][!indx].delete()
      !oldarray[4][!indx].delete()
    enddo

    -- Compress sorted elements
    !oldarray[1].compress()
    !oldarray[2].compress()
    !oldarray[3].compress()
    !oldarray[4].compress()

    -- Reindex !oldarray[1] now some iterations of the array may have been deleted
    !counter = 1
    --    !prefix = !oldarray[1][1].string().before('1')
    do !resetindex indices !oldarray[1]
      skip if (!resetindex.eq(1))
      skip if (!oldarray[1][!resetindex].string().trim().eq(''))
      !test.delete()
      handle any
      endhandle
      !test = !oldarray[1][!resetindex]
      handle any
        skip
      endhandle
      -- Reindex the ITEM numbers
      !counter = !counter + 1
      --      !oldarray[1][!resetindex] = !prefix + !counter.string()
      !oldarray[1][!resetindex] = !counter
    enddo

    !newarray = !oldarray
    -- Update (1) the variable !newarray with iteration number [5] and
    !newarray[5] = !newelements[5]

    -- Update (2) the NEW ARRAY Form/Object member arrays in --> !!mdsabamtosteel.data.hangviewtags
    -- with values from the variables !newarray[1] and !newarray[5]
    --!this.data.hangviewtags[1] = !newarray[1]
    --!this.data.hangviewtags[2] = !newarray[5]

    --<wd>jan2005
    -- Temporary Variable
    !!xnewarray  = !newarray

    -- Return the NEW rearranged array
    return !newarray

  endmethod
  --End of Method .mtototals()

  -------------------------------------------------------------------------
  ------------------------------------------------------------------------

  -- Method:      .mtototalshang
  -- **************
  -- ** NOTE **  -- This method is now also called from the method ".mtohanger" above,
  -- ************** used for TOTALLING the MDS HANGER components
  --
  define method .mtototalshang()

    -- A MDS GROUP Support may contain MORE than ONE MDS HANGER Support

    -- Re-Index Alphabetically the Hanger Arrays ---
    -- NOT SORTING the INDICES as done below, will mean that the MDS HANGER TOTALLING
    -- done in the method ".mtototals()" will NOT produce the CORRECT amount of indices
    -- in the object array ".hangmemb[5]" indicating the CORRECT Position/Index Nos. in
    -- the "DBREF<string>" array ".hangmemb[2]"
    -- ***********
    -- **  NOTE ** in the method ".mtototals()" the variable "!findsame" looks at the NEXT line of the array
    -- *********** ".hangelem[3]]" to check and store the quantities of COMPONENTS with IDENTICAL descriptions.
    --
    !hindex = !this.hangdesc.sortedindices()
    !this.hangtype.reindex(!hindex)
    !this.hangdbrf.reindex(!hindex)
    !this.hangdesc.reindex(!hindex)
    !this.hangquan.reindex(!hindex)

    -- Determine the concatenated "descriptions" for each MTO element in the MDS HANGERS
    !hangtempelem = ARRAY()
    do !indx index !this.hangdesc
      !mtodesc = !this.hangtype[!indx] & '|' & !this.hangdbrf[!indx] & '|' & !this.hangdesc[!indx] & '|' & !this.hangquan[!indx]
      !hangtempelem.append(!mtodesc)
    enddo

    -- Now make the final elements array ready for use with the table creation
    -- Go off and create the final array with all different lists.
    -- Initialise the ARRAY Variable for a MDS Framework Structure
    !mdsgroup         = !this.mdsgroup
    !this.hangelem[1] = ARRAY()
    !this.hangelem[2] = ARRAY()
    !this.hangelem[3] = ARRAY()
    !this.hangelem[4] = ARRAY()

    -- Get the Totals etc... for the MDS Hangers in the MDS GROUP
    if (!!mdshangif.trim().upcase().neq('MDS')) then
      !this.mdshangtotals(!hangtempelem,!hangtempelem[1].split('|')[1], !mdsgroup)
    endif

    -- The MDS HANGER members of a *** MDS GROUP *** will be TOTALLED etc... here
    -- Compress the MTO for the MDS HANGERS by TOTALLING together DUPLICATE
    -- HANGER elements belonging to ALL of the MDS HANGERS in the MDS GROUP.
    --    if (!mdsgroup) then
    -- Support is in a MDS GROUP -- MDS HANGER elements are stored in the OBJECT member !this.data.hangerelements
    !totalhangelem = !this.mtohanger(!this.hangelem)

    -- Populate the Final MDS HANGER ARRAY for Proceeding to attain VPRM Data
    !this.hangmemb = !totalhangelem

    !!totalhangelem = !totalhangelem

  endmethod

  -------------------------------------------------------------------------------
  -------------------------------------------------------------------------------

  -- Method:      .mtototalsatta
  -- **************
  -- ** NOTE **  -- This method is now also called from the method ".mtoancillary" above,
  -- ************** used for TOTALLING the MDS ANCILLARY ATTA components
  --
  define method .mtototalsatta()

    -- A MDS GROUP Support may contain MORE than ONE MDS ANCILLARY ATTA Support

    -- Re-Index Alphabetically the ANCILLARY ATTA Arrays ---
    -- NOT SORTING the INDICES as done below, will mean that the MDS ANCILLARY ATTA TOTALLING
    -- done in the method ".mtototals()" will NOT produce the CORRECT amount of indices
    -- in the object array ".attamemb[5]" indicating the CORRECT Position/Index Nos. in
    -- the "DBREF<string>" array ".attamemb[2]"
    -- ***********
    -- **  NOTE ** in the method ".mtototals()" the variable "!findsame" looks at the NEXT line of the array
    -- *********** ".attaelem[3]" to check and store the quantities of COMPONENTS with IDENTICAL descriptions.
    --
    !aindex = !this.attadesc.sortedindices()
    !this.attatype.reindex(!aindex)
    !this.attadbrf.reindex(!aindex)
    !this.attadesc.reindex(!aindex)
    !this.attaquan.reindex(!aindex)

    -- Determine the concatenated "descriptions" for each MTO element in the MDS ANCILLARY ATTAS
    !attatempelem = ARRAY()
    do !indx index !this.attadesc
      !mtodesc = !this.attatype[!indx] & '|' & !this.attadbrf[!indx] & '|' & !this.attadesc[!indx] & '|' & !this.attaquan[!indx]
      !attatempelem.append(!mtodesc)
    enddo

    -- Now make the final elements array ready for use with the table creation
    -- Go off and create the final array with all different lists.
    -- Initialise the ARRAY Variable for a MDS Framework Structure
    !mdsgroup         = !this.mdsgroup
    !this.attaelem[1] = ARRAY()
    !this.attaelem[2] = ARRAY()
    !this.attaelem[3] = ARRAY()
    !this.attaelem[4] = ARRAY()

    -- Get the Totals etc... for the MDS ANCILLARY ATTAs in the MDS GROUP
    if (!!mdshangif.trim().upcase().neq('MDS')) then
      !this.mdsattatotals(!attatempelem,!attatempelem[1].split('|')[1], !mdsgroup)
    endif

    -- The MDS ANCILLARY ATTA members of a *** MDS GROUP *** will be TOTALLED etc... here
    -- Compress the MTO for the MDS ANCILLARY ATTAS by TOTALLING together DUPLICATE
    -- ANCILLARY ATTA elements belonging to ALL of the MDS ANCILLARY ATTAS in the MDS GROUP.
    --    if (!mdsgroup) then
    -- Support is in a MDS GROUP -- MDS ANCILLARY ATTA elements are stored in the OBJECT member !this.data.ANCILLARY ATTAelements
    !totalattaelem = !this.mtoancillary(!this.attaelem)

    -- Populate the Final MDS ANCILLARY ATTA ARRAY for Proceeding to attain VPRM Data
    !this.attamemb = !totalattaelem

    !!totalattaelem = !totalattaelem

  endmethod

  -------------------------------------------------------------------------------
  -------------------------------------------------------------------------------

  -- Method:      .vprmbatch
  --
  -- Determine the MDS to VPRM MTO File Input BATCH Record for Each MDS Support
  --
  --
  define method .vprmbatch(!mdsvprmobj is MDSVPRMMTO,!vprmconfig is VPRMCONFIG) is STRING

    -- Get Current PDMS Session details
    !session = current session

    -- Get the PDMS Project Details
    !project = current project
    !unusedProjlow = !project.code().lowcase()
    !unusedProjup  = !project.code()
    !projnum = !project.number()

    -- Determine Date Time Object variables
    !datetime = object DATETIME()
    !day      = !datetime.date()
    if (!day.lt(10)) then
      !daystring = '0' & !day
    else
      !daystring = !day.string()
    endif
    --!month       = !datetime.month()
    !monthstring = !datetime.monthstring()
    !monthstrabb = !monthstring.substring(1,3)
    !year        = !datetime.year()
    !hour        = !datetime.hour()
    if (!hour.lt(10)) then
      !hourstring = '0' & !hour
    else
      !hourstring = !hour.string()
    endif
    !minute   = !datetime.minute()
    if (!minute.lt(10)) then
      !minutestring = '0' & !minute
    else
      !minutestring = !minute.string()
    endif
    !second   = !datetime.second()
    if (!second.lt(10)) then
      !secondstring = '0' & !second
    else
      !secondstring = !second.string()
    endif

    -- Determine the PDMS Module
    -- <DESIGN> for BULK MTO per Estimate for Passed Pipes/HVAC elements
    -- <DRAFT>  for ACTUAL MTO per MDS ABA Support DRAWING
    -- <ISODRAFT> for ?? PIPE MTO for MDS Supports per PIPE -- ?? FUTURE ??
    !banner = banner
    if (!banner.name.upcase().match('DESIGN').gt(0)) then
      !module  = 'DESIGN'
      !version = !banner.short.split()[4].after('Mk').before('.SP')

      --<wd>may2007<mds12>
      --   elseif (!banner.name.upcase().match('OUTFITTING').gt(0)) then
    elseif (!banner.short.upcase().match('OUTFITTING MK').gt(0)) then
      --<wd>may2007<mds12>

      !module  = 'DESIGN'
      !version = !banner.short.split()[4].after('Mk').before('.SP')

      --<wd>may2007<mds12>
      --   elseif (!banner.name.upcase().match('DRAFT').gt(0)) then
    elseif ((!banner.name.upcase().match('DRAFT').gt(0)) or (!banner.name.upcase().match('OUTFITTINGDRAFT').gt(0))) then
      --<wd>may2007<mds12>

      !module = 'DRAFT'
      !version = !banner.short.split()[4].after('Mk').before('.SP')

      --   elseif (!banner.name.upcase().match('ISODRAFT').gt(0)) then
      --     !module = 'ISODRAFT'
      -- FUTURE ????????????????????????????????
    endif

    -- Get user id
    -- Test for Model manager running i.e. the user description is set with the string "login Id:"
    if (!session.user().description.match('login Id:').neq(0)) then
      !userid   = !session.user().description.after('login Id:').before('(').trim()
    else
      !userid   = !session.login
    endif

    -- Determine Batch Header Line
    !bf1 = '$B'
    !bf2 = '$!projnum'
    if (!module.eq('DESIGN')) then
      !bf3 = 'PD-MDS-B'
    elseif (!module.eq('DRAFT')) then
      !bf3 = 'PD-MDS-D'
    endif
    !bf4 = !version
    !bf5 = '$!<daystring>-$!<monthstrabb>-$!<year> $!<hourstring>.$!<minutestring>.$!<secondstring>'

    --  !bf6 = !vprmconfig.vprmmdsdisc
    --<GE> (20-07-06) Check MDS type for Multi-Discipline Supports from the Gateway config file
    -- and set the correct VPRM corresponding discipline code from the Gateway config file.
    if (!mdsvprmobj.mdspipetype.eq('PIPE')) then
      !bf6 = !vprmconfig.vprmmdsdisc
    elseif (!mdsvprmobj.mdspipetype.eq('TRAY')) then
      !bf6 = !vprmconfig.vprmmdselecdisc
    elseif (!mdsvprmobj.mdspipetype.eq('HVAC')) then
      !bf6 = !vprmconfig.vprmmdshvacdisc
    else
      !bf6 = !vprmconfig.vprmmdsdisc
    endif
    --<GE> (20-07-06)

    !bf7 = '$!userid'

    -------------
    --<wd>sep2005
    -- (1) -- "$B" -- Concatenate the BATCH Header <8 fields>
    --!vprmbatch = !bf1 & ':' & !bf2 & ':' & !bf3 & ':' & !bf4 & ':' & !bf5 & ':' & !bf6 & ':' & !bf7 & ':*'
    --
    -- (2) -- "$B" -- Concatenate the BATCH Header <9 fields>
    -- An ADDITIONAL FIELD has been appended, <"A"> or <"I">, to the VPRM BATCH HEADER record
    -- to allow VPRM to either do a FULL/ALL-<"A"> or a PARTIAL/INDIVIDUAL-<"I"> Update of VPRM Records
    -- to complete VPRM "SECTIONS/SUB-UNITS" ONLY and NOT individual COMPONENTS on a MDS Support.
    -- **********************
    -- *** IMPORTANT NOTE ***
    -- **********************
    -- The MDS to VPRM Interface OUTPUT files, <BATCH> or <ACTUAL>, will ALWAYS contain ALL VPRM "SECTIONS/SUB-UNITS"
    -- for a COMPLETE MDS Support in its ENTIRETY, i.e. "FULL/ALL"-<"A">.
    -- Therefore the NEW VPRM BATCH HEADER field No.<9> has been HARD CODED to "A" for every MDS VPRM output file
    -- created via this MDS VPRM interface
    !bf8 = ''
    !bf9 = 'A'
    !vprmbatch = !bf1 & ':' & !bf2 & ':' & !bf3 & ':' & !bf4 & ':' & !bf5 & ':' & !bf6 & ':' & !bf7 & ':' & !bf8 & ':' & !bf9 & '*'
    --<wd>sep2005
    -------------

    return !vprmbatch

  endmethod

  -------------------------------------------------------------------------------
  -------------------------------------------------------------------------------

  -- Method:      .vprmline
  --
  -- Determine the MDS to VPRM MTO File Input LINE Record for Each MDS Support Object
  --
  --
  define method .vprmline(!mdsvprmobj is MDSVPRMMTO,!vprmconfig is VPRMCONFIG) is STRING
    -- "$L" -- Concatenate the MDS Support LINE Header <12 fields>
    !lf1  = '$$L'

    -- Get the PDMS/MOM STATUS UDA from the VPRM config file object
    !statusuda = !vprmconfig.mtostatus

    -- PDMS UDA Name for Construction Area of MDS Support "DATUM" ATTA
    !attauda = !vprmconfig.mtocomparea

    if (!mdsvprmobj.mdsgroup) then
      -- Master MDS Support element is a STRUCTURE -- Get DATUM Atta DBREF
      !datumname = !mdsvprmobj.support.name & '/DATUM'
      !datumdbrf = !datumname.dbref()
      !constarea = !datumdbrf.$!attauda

      -- Controlled OBJECT for MOM is the STRUCTURE
      !lf12 = !mdsvprmobj.support.$!statusuda
      handle ANY
        !lf12 = ''
      endhandle

      -- Check for a Valid Construction Area
      if ((!constarea.trim().eq('')) or (!constarea.unset())) then
        -- Get The Construction Area PDMS Attribute of the owning PIPE
        !pipeuda   = !vprmconfig.mtoconsarea
        !constarea = !datumdbrf.owner.owner.$!pipeuda

        if (!constarea.trim().eq('')) then
          -- Invalid Construction Area -- Return 'ERROR' and SKIP this MDS Support
          !mdsname = !mdsvprmobj.support.name
          --!mdsvprmobj.errorarray.append('_________________________________________________________________________')
          --!mdsvprmobj.errorarray.append('')
          !mdsvprmobj.errorarray.append(' ERROR -- Invalid Construction Area at the MDS Support ATTA<attribute $!attauda> and the OWNING PIPE<attribute $!pipeuda>')
          !mdsvprmobj.errorarray.append('  MDS VPRM MTO will not contain this MDS Support')
          --!mdsvprmobj.errorarray.append('')
          --!mdsvprmobj.errorarray.append('_________________________________________________________________________')
          return 'ERROR'

        else
          -- Valid Construction Area for the OWNING PIPE
          !lf2 = !constarea
        endif

      else
        -- Valid Construction Area for the MDS GROUP Support DATUM Atta
        !lf2 = !constarea

      endif

    else
      -- Support DOES NOT belong to a MDS GROUP

      if (!mdsvprmobj.supptype.eq('STRU')) then
        -- An Independent MDS STRUCTURE Support
        -- Get the DATUM Atta DBREF
        !datumname = !mdsvprmobj.support.name & '/DATUM'
        !datumdbrf = !datumname.dbref()
        !constarea = !datumdbrf.$!attauda

        -- Controlled OBJECT for MOM is the STRUCTURE
        !lf12 = !mdsvprmobj.support.$!statusuda
        handle ANY
          !lf12 = ''
        endhandle

      elseif (!mdsvprmobj.supptype.eq('HANG')) then
        -- An Independent MDS HANGER Support
        !datumdbrf = !mdsvprmobj.support
        !constarea = !datumdbrf.$!attauda

        -- Controlled OBJECT for MOM is the RESTRAINT
        !hang = !datumdbrf.cref
        !unusedRest = !hang.owner
        !lf12 = !mdsvprmobj.support.$!statusuda
        handle ANY
          !lf12 = ''
        endhandle

      elseif (!mdsvprmobj.supptype.eq('ATTA')) then
        -- An Independent MDS ANCILLARY Support
        !datumdbrf = !mdsvprmobj.support
        !constarea = !datumdbrf.$!attauda

        -- Controlled OBJECT for MOM is the MDS ANCILLARY ATTA
        !lf12 = !mdsvprmobj.support.$!statusuda
        handle ANY
          !lf12 = ''
        endhandle
      endif

      -- Check for a Valid Construction Area
      if (!constarea.trim().eq('')) then
        -- Get The Construction Area of the owning PIPE
        !pipeuda   = !vprmconfig.mtoconsarea
        !constarea = !datumdbrf.owner.owner.$!pipeuda
        handle ANY
          !constarea = ''
        endhandle

        if (!constarea.trim().eq('')) then
          -- Invalid Construction Area -- Return 'ERROR' and SKIP this MDS Support
          !mdsname = !mdsvprmobj.support.name
          --!mdsvprmobj.errorarray.append('_________________________________________________________________________')
          --!mdsvprmobj.errorarray.append('')
          !mdsvprmobj.errorarray.append(' ERROR -- Invalid Construction Area at the MDS Support ATTA<attribute $!attauda> and the OWNING PIPE<attribute $!pipeuda>')
          !mdsvprmobj.errorarray.append('  MDS VPRM MTO will not contain this MDS Support')
          --!mdsvprmobj.errorarray.append('')
          --!mdsvprmobj.errorarray.append('_________________________________________________________________________')
          return 'ERROR'

        else
          -- Valid Construction Area for the OWNING PIPE
          !lf2 = !constarea
        endif

      else
        -- Valid Construction Area for the Independent MDS Support Atta
        !lf2 = !constarea
      endif

    endif

    ---------------------------------------------------------------------------------------------------
    --<wd>mar2006 -- dtf >>> mod shown here commented out at FANP<W.Umnig> request.
    -- Appending "[1]" to the MDS GROUP name at this stage means that ALL EXISTING MDS
    -- GROUP supports will have DOUBLE the MATERIAL in VPRM because the original support
    -- components already in VPRM will NOT be "DEACTIVATED" or "OVERWRITTEN" because of the
    -- MDS GROUP Support NAME CHANGES shown in the commented out CODE shown below.
    --
    -- dtf >>> 15.1.06 mod to send controlling object name if group
    --
    --    if !mdsvprmobj.mdsgroup then
    --      !lf3  = !mdsvprmobj.suppname & '[1]'
    --    else
    !lf3  = !mdsvprmobj.suppname
    --    endif
    --
    -- dtf <<< End of Mod
    --
    --<wd>mar2006 -- dtf <<< mod shown here commented out at FANP<W.Umnig> request
    ---------------------------------------------------------------------------------------------------

    !lf4  = ''
    !lf5  = ''
    !lf6  = 'P'
    !lf7  = 'N'
    !lf8  = 'P'
    !lf9  = ''
    !lf10 = 'P'
    !lf11 = 'P'

    --    !vprmline = !lf1 & ':' & !lf2 & ':' & !lf3 & ':' & !lf4 & ':' & !lf5 & ':' & !lf6 & ':' & !lf7  & ':' & !lf8 & ':' & !lf9 & ':' & !lf10 & ':' & !lf11  & ':' & !lf12  & '*'
    --<GE> 07-08-06 added additional field prior to the asterisk which is used for rename i.e. the old support number
    !vprmline = !lf1 & ':' & !lf2 & ':' & !lf3 & ':' & !lf4 & ':' & !lf5 & ':' & !lf6 & ':' & !lf7  & ':' & !lf8 & ':' & !lf9 & ':' & !lf10 & ':' & !lf11  & ':' & !lf12  & ':' & '*'

    return !vprmline

  endmethod

  -------------------------------------------------------------------------------
  -------------------------------------------------------------------------------

  -- Method:      .vprmsubunit
  --
  -- Determine the MDS to VPRM MTO File Input SECTION/SUB-UNIT for Each MDS Support Object
  --
  --
  define method .vprmsubunit(!mdsvprmobj is MDSVPRMMTO,!vprmconfig is VPRMCONFIG,!vprmlinearray is ARRAY) is ARRAY
    -- "$S" -- Concatenate the MDS Support SECTION/SUB-UNIT Record <8 fields>

    -- Initialise variables
    !vprmrecords = ARRAY()

    -- Additional/Optional Fields -- For BULK MTO these are ALL BLANK Fields i.e. = ''
    !sf1 = '$S'
    !sf2 = ''
    --<nb>jun2007  HPD0035323/OP48  (Populate the MTO Revision from the DM Revision code)
    !sf3 = !mdsvprmobj.support.name
    if (!mdsvprmobj.rev.unset()) then
      !sf4 = ''
    else
      !sf4 = !mdsvprmobj.rev
    endif
    !sf5 = ''
    !sf6 = ''
    !sf7 = ''
    !sf8 = ''

    ---------------------------------------------------------------------------------------------------

    if (!mdsvprmobj.mdsgroup) then
      --------------------------------------------------------------
      -- MDS Support BELONGS to a MDS GROUP Support
      --------------------------------------------------------------

      -- Initialise the ATTAS exist <BOOLEAN>
      !attasexist = FALSE

      -- A MDS GROUP Support where the MASTER Support is "ALWAYS" the "ONLY" MDS STRUCTURE Support in the GROUP
      if (!mdsvprmobj.supptype.eq('STRU')) then

        -- MDS GROUP Support
        -- Determine the MDS ANCILLARY ATTA records on the MDS STRUCTURE Support
        ------------------------------------------------------------------------
        if (!mdsvprmobj.attamemb[1].size().gt(0)) then
          -- MDS GROUP Support
          !sf2 = '01'
          -- "$S" -- Concatenate the MDS Support SECTION/SUB-UNIT Record <8 fields>
          !vprmsubunit = !sf1 & ':' & !sf2 & ':' & !sf3 & ':' & !sf4 & ':' & !sf5 & ':' & !sf6 & ':' & !sf7 & ':*'

          !count = 0
          do !indx indices !mdsvprmobj.attamemb[3]
            -- MDS ANCILLARY ATTA Components Exist -- but DO NOT PROCESS ANY "REST" type Attas
            !pipe  = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref().owner.owner
            !bran  = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref().owner
            !stype = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref().stype
            !vprm  = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref().:mdsvprmmto
            if (!stype inset ('PIPE-REST','HVAC-REST','RACK-REST')) then
              skip
            elseif (!vprm.not()) then
              skip
            else
              !count = !count + 1
            endif

            -- Add the MDS ANCILLARY SUB-UNIT Record prior to FIRST MDS ANCILLARY Atta PART NUMBER Record
            if (!count.eq(1)) then
              !vprmrecords.append(!vprmsubunit)
              -- MDS ANCILLARY ATTA records exist
              !attasexist = TRUE
            endif

            --Loop through ALL "NON REST" type MDS ATTA DESCRIPTIONS
            -------------------------------------------------
            !vprmpart = !mdsvprmobj.vprmpart('ATTA',!indx,!mdsvprmobj)
            --!vprmrecords.append(!vprmpart)
            if (!vprmpart.eq('ERROR')) then
              -- CRITICAL ERROR -- SKIP and DO NOT Process this MDS Support Component
              -- Any attribute i.e. QUALITY CLASS, MATERIAL or MATERIAL GROUP is 'unset'
              !vprmrecords.append(!vprmpart)
              skip
            endif

            !vprmtag  = !mdsvprmobj.vprmtag('ATTA',!indx,!mdsvprmobj)
            --!vprmrecords.append(!vprmtag)
            if (!vprmtag.eq('ERROR')) then
              -- CRITICAL ERROR -- SKIP and DO NOT Process this MDS Support Component
              -- Any attribute i.e. QUALITY CLASS, MATERIAL or MATERIAL GROUP is 'unset'
              !vprmrecords.append(!vprmtag)
              skip
            endif

            -- PART and TAG No. Generation OK, therefore append to the array "!vprmrecords" and
            -- Include the MDS Support Component in MDS-VPRM BULK MTO
            !vprmrecords.append(!vprmpart)
            !vprmrecords.append(!vprmtag)

            !vprmcomp = !mdsvprmobj.vprmcomp('ATTA',!indx,!mdsvprmobj,!vprmpart,!vprmtag)
            !vprmrecords.append(!vprmcomp)

            !vprmcompuda = !mdsvprmobj.vprmcompuda('ATTA',!indx,!mdsvprmobj,!vprmconfig)
            !vprmrecords.appendarray(!vprmcompuda)

            -------------------------------------------------------------------------------------------------------------
            -- ATTA Components requiring "AUSTENITIC INLAY PLATES"
            -- Determine the PART No. of the Current ATTA Component
            !vprmpartplat = !vprmpart
            !pplt = !vprmpartplat.split(':')
            if (!pplt[2].matchwild('LIS40-70TS*')) then
              !pnum = 'LIS40-70TS'
              --!pmgr = !pplt[2].after('LIS40-70TS-')
              !pmgr = !pplt[2].after('LIS40-70TS')
            else
              !pnum = !pplt[2].before('-')
              !pmgr = !pplt[2].after('-')
            endif
            -- Check if an AUSTENITIC Inlay Plate is required
            --if (!pnum inset ('V1_GH', 'V1_GN', 'V4_GA', 'V4_GB', 'V4_GC', 'V6_GA', 'V6_GB', 'V2_XRH', 'V2_XRN', 'V3_XE', 'V3_XH', 'V3_XN', 'V4_XC', 'LIS49', 'LISR49*')) then
            --if (!pnum inset ('V1_GH', 'V1_GN', 'V4_GA', 'V4_GB', 'V4_GC', 'V6_GA', 'V6_GB', 'V3_XE', 'V3_XH', 'V3_XN', 'V4_XC', 'LIS40', 'LIS49', 'LISR49*')) then
            --if (!pnum inset ('V1_GH', 'V1_GN', 'V4_GA', 'V4_GB', 'V4_GC', 'V6_GA', 'V6_GB', 'V3_XE', 'V3_XH', 'V3_XN', 'V4_XC', 'LIS40-70TS', 'LIS49', 'LISR49')) then

            --------------
            --<wd>mar2006
            -- This CHECK now INCLUDES ALL MDS ANCILLARY with the new "-S1" suffix appended for PIPES with a QUALITY CLASS of "QC1"
            --if (!pnum inset ('V1_GH', 'V1_GN', 'V4_GA', 'V4_GB', 'V4_GC', 'V6_GA', 'V6_GB', 'V3_XE', 'V3_XH', 'V3_XN', 'V4_XC', 'LIS40-70TS', 'LIS49A', 'LISR49A', 'LIS49G', 'LISR49G')) then
            if (!this.mdsaustshld(!pnum)) then
              --<wd>mar2006
              --------------

              -- SKIP if PART No. is 'LIS40' and the Property CODE is NOT "40??70-TS"
              --if (!pnum.eq('LIS40')) then
              --!code = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref().prop.code
              --if (!code.matchwild('40??70-TS').not()) then
              --skip
              --endif
              --endif

              -- Check if the Owning Pipe Specification UDA ":mdsaustshld" of the ATTA is set to " with austenitic shield"
              --if (!pipe.pspe.:mdsaustshld.trim().matchwild('*with*austen*')) then
              if (!bran.pspe.:mdsaustshld.trim().matchwild('*with*austen*')) then

                -- Check the Material Reference of the ATTA Ancillary for STAINLESS STEEL
                -- Stainless Steel Ancillaries DO NOT REQUIRE an AUSTENITIC INLAY PLATE
                !dbf = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref()
                -- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
                -- the matref attribute has been added to atta. Find the correct attribute to use
                -- The variable !matrefAtt will be set to either REF for matref or UDA for :MdsMatref
                !matrefAtt = !!mdsUseMatref(!dbf)
                if (!matrefAtt.eq('UDA')) then
                  if (!dbf.:mdsmatref.:mdsmatgroup.eq('SS')) then
                    --$P *** Skipping... *** MDS GROUP ATTA $!dbf.name *** AUSTENITIC INLAY PLATE is NOT required ***
                    skip
                  endif
                else
                  if (!dbf.matref.:mdsmatgroup.eq('SS')) then
                    --$P *** Skipping... *** MDS GROUP ATTA $!dbf.name *** AUSTENITIC INLAY PLATE is NOT required ***
                    skip
                  endif
                endif

                -- *** ADD *** an extra *** VPRM "$P" Part No. record ***
                --!vprmpartplat = !vprmpart
                --!pplt = !vprmpartplat.split(':')
                --if ((!pnum.eq('LIS49')) or (!pnum.eq('LISR49'))) then

                --if ( (!pnum.eq('LIS49A')) or (!pnum.eq('LISR49A'))or (!pnum.eq('LIS49G')) or (!pnum.eq('LISR49G')) ) then
                --!pmgr = !pplt[7]
                --!ppf2 = !pnum & '-IP'
                --else
                --!ppf2 = !pnum & '-IP' & '-' & !pmgr
                --endif

                --                if ( (!pnum.eq('LIS49A')) or (!pnum.eq('LISR49A'))or (!pnum.eq('LIS49G')) or (!pnum.eq('LISR49G')) ) then
                --                  --!pmgr = !pplt[7]
                --                  !ppf2 = !pnum & '-IP'
                -- dtf >>> 123.11.05 remove safety class from austenitic plate its not required
                --q var !pmgr
                --$p 2133
                if (!pmgr.matchwild('*-S1')) then
                  !pmgr = !pmgr.before('-S1')
                endif
                -- dtf <<< end of mod
                if (!pnum.eq('LIS40-70TS')) then
                  !ppf2 = !pnum & '-IP' & !pmgr
                else
                  !ppf2 = !pnum & '-IP' & '-' & !pmgr
                endif

                !ppf8 = 'Austenitic Inlay Plate'
                -- Concatenate the NEW "$P" record
                !vprmpartplat =  !pplt[1] & ':' & !ppf2 & ':' & !pplt[3] & ':' & !pplt[4] & ':' & !pplt[5] & ':' & !pplt[6] & ':' & !pplt[7] & ':' & !ppf8 & ':' & !pplt[9]
                !vprmrecords.append(!vprmpartplat)

                -- *** ADD *** an extra *** VPRM "$T" Tag No. record ***
                !vprmtagplat = !vprmtag
                !tplt = !vprmtagplat.split(':')

                if (!pnum.eq('LIS40-70TS')) then
                  !tnum = !tplt[2].before('-TS')
                  !tmgr = !tplt[2].after('-TS')
                else
                  !tnum = !tplt[2].before('-')
                  !tmgr = !tplt[2].after('-')
                endif

                --if ( (!pnum.eq('LIS49A')) or (!pnum.eq('LISR49A'))or (!pnum.eq('LIS49G')) or (!pnum.eq('LISR49G')) ) then
                --!tpf2 = !tnum & '-IP'
                --else
                -- dtf >>> 123.11.05 remove safety class from austenitic plate its not required
                --q var !tmgr
                --$P 2166
                if (!tmgr.matchwild('*-S1')) then
                  --<wd>10mar2010 - DUN1233 - !ptmgr does NOT exist so use !tmgr as in the other cases in this method
                  --!tmgr = !ptmgr.before('-S1')
                  !tmgr = !tmgr.before('-S1')
                endif
                -- dtf <<< end of mod
                if (!pnum.eq('LIS40-70TS')) then
                  !tpf2 = !tnum & '-TS-IP' & !tmgr
                else
                  !tpf2 = !tnum & '-IP' & '-' & !tmgr
                endif
                --endif

                !tpf4 = '*'
                -- Concatenate the NEW "$T" record
                !vprmtagplat =!tplt[1] & ':' & !tpf2 & ':' & !tpf2 & ':' & !tpf4
                !vprmrecords.append(!vprmtagplat)

                -- *** ADD *** an extra *** VPRM "$C" Component record for the Austenitic Inlay Plate ***
                !vprmcompplat = !vprmcomp
                !cplt = !vprmcompplat.split(':')
                !cpf7 = !ppf2
                !cpf8 = !tpf2
                if ((!cpf8.matchwild('49*')) or (!cpf8.matchwild('R49*'))) then
                  -- TWO Austenitic Inlay Plates required per Ancillary for types '49*' and 'R49*'
                  !xnum = !cplt[9]
                  !cpf9 = (2 * !xnum.real())
                else
                  !cpf9 = !cplt[9].real()
                endif

                -- Concatenate the NEW "$C" record
                !vprmcompplat = !cplt[1] & ':' & !cplt[2] & ':' & !cplt[3] & ':' & !cplt[4] & ':' & !cplt[5] & ':' & !cplt[6] & ':' & !cpf7 & ':' & !cpf8 & ':' & !cpf9 & ':' & !cplt[10] & ':' & !cplt[11] & ':' & !cplt[12] & ':' & !cplt[13] & ':' & !cplt[14] & ':' & !cplt[15] & ':' & !cplt[16] & ':' & !cplt[17] & ':' & !cplt[18] & ':' & !cplt[19] & ':' & !cplt[20] & ':' & !cplt[21] & ':' & !cplt[22] & ':' & !cplt[23] & ':' & !cplt[24]
                !vprmrecords.append(!vprmcompplat)
              endif
            endif
            -------------------------------------------------------------------------------------------------------------

          enddo

        endif

        -- Determine the MDS STRUCTURE records on the MDS STRUCTURE Support
        -------------------------------------------------------------------
        -- MDS GROUP Support
        if (!mdsvprmobj.strumemb[1].size().gt(0)) then
          -- MDS STRUCTURE Components Exist
          !sf2 = '02'

          -- Add the "$L" LINE record before every STRUCTURAL SUB-UNIT record,
          -- but ONLY if MDS ANCILLARY ATTA records *** DO NOT ** exist on the MDS Support
          if (!attasexist) then
            !vprmrecords.appendarray(!vprmlinearray)
          endif

          -- "$S" -- Concatenate the MDS Support SECTION/SUB-UNIT Record <8 fields>
          !vprmsubunit = !sf1 & ':' & !sf2 & ':' & !sf3 & ':' & !sf4 & ':' & !sf5 & ':' & !sf6 & ':' & !sf7 & ':*'
          !vprmrecords.append(!vprmsubunit)

          -- Loop Thro the MDS STRUCTURE DESCRIPTIONS
          do !indx indices !mdsvprmobj.strumemb[3]

            -- Loop Thro the Structural Members Individually via the Quantity Required <No. Off> value
            -- Each INDIVIDUAL SCTN element requires the LENGTH to be output for VPRM records
            !membquantity = !mdsvprmobj.strumemb[4][!indx]
            do !quan from 1 to $!membquantity

              !dbf = !mdsvprmobj.strumemb[2][!mdsvprmobj.strumemb[5][!indx][!quan]].dbref()

              --<wd>sep2005
              -- FRAMATOME MDS TEMPLATE type "FANP14"-<"FT17"> can have a SCTN with a GTYP of "PLAT",
              -- and therefore this type of "SCTN" is to be treated as a "PLATE" element,
              -- i.e. it is to have the SAME MDS-VPRM output as other MDS PLATE types <e.g. PJOI, SJOI, BOX etc...>
              !gtp = !dbf.gtype
              --<wd>mar2006
              handle ANY
                !gtp = ''
              endhandle
              --<wd>mar2006
              --<wd>sep2005

              --$P ****************
              --$P *** !quan = $!quan ***
              --q var !mdsvprmobj.strumemb[2][!mdsvprmobj.strumemb[5][!indx][!quan]].dbref().type
              --q var !mdsvprmobj.strumemb[2][!mdsvprmobj.strumemb[5][!indx][!quan]].dbref().type.neq('SCTN')
              --$P+++++++++++++++++++++++++++++++++
              -------------------------------------------------
              !vprmpart = !mdsvprmobj.vprmpart('STRU',!indx,!mdsvprmobj)
              --!vprmrecords.append(!vprmpart)
              if (!vprmpart.eq('ERROR')) then
                -- CRITICAL ERROR -- SKIP and DO NOT Process this MDS Support Component
                -- Any attribute i.e. QUALITY CLASS, MATERIAL or MATERIAL GROUP is 'unset'
                --skip
                -- Need to GOLABEL to the BREAK option and NOT SKIP as QUANTITIES are being Looped Here!
                !vprmrecords.append(!vprmpart)
                golabel /mdsgrpstru
              endif

              !vprmtag  = !mdsvprmobj.vprmtag('STRU',!indx,!mdsvprmobj)
              --!vprmrecords.append(!vprmtag)
              if (!vprmtag.eq('ERROR')) then
                -- CRITICAL ERROR -- SKIP and DO NOT Process this MDS Support Component
                -- Any attribute i.e. QUALITY CLASS, MATERIAL or MATERIAL GROUP is 'unset'
                --skip
                -- Need to GOLABEL to the BREAK option and NOT SKIP as QUANTITIES are being Looped Here!
                !vprmrecords.append(!vprmtag)
                golabel /mdsgrpstru
              endif

              -- PART and TAG No. Generation OK, therefore append to the array "!vprmrecords" and
              -- Include the MDS Support Component in MDS-VPRM BULK MTO
              !vprmrecords.append(!vprmpart)
              !vprmrecords.append(!vprmtag)

              !vprmcomp = !mdsvprmobj.vprmcomp('STRU',!indx,!mdsvprmobj,!vprmpart,!vprmtag)
              !vprmrecords.append(!vprmcomp)

              !vprmcompuda = !mdsvprmobj.vprmcompuda('STRU',!indx,!mdsvprmobj,!vprmconfig)
              !vprmrecords.appendarray(!vprmcompuda)

              -- For PLATE elements ONLY provide an ADDITIONAL record for an "AREA" Unit of Measure<SM> for a "PLATE"
              -- i.e. ONLY "$P" and "$C" records required and the WEIGHT is to be output in Kg/m2
              --<wd>sep2005
              -- FRAMATOME now have SCTN elements with a GTYP of PLAT, and VPRM records are to be output
              -- as other types of PLATES, i.e. with the ADDITIONAL "AREA" type records as well.

              --if (!dbf.type inset ('PJOI','SJOI','FITT','BOX')) then
              if ( (!dbf.type inset ('PJOI','SJOI','FITT','BOX')) or (!dbf.type.eq('SCTN')and (!gtp.eq('PLAT'))) ) then

                -- FANP Building Attachments are SJOI Assemblies and to be treated as SINGLE ITEMS and NOT as PLATE items
                -- Therefore DO NOT output AN "AREA" record for these SJOI items, so "SKIP" the additional record

                --if ((!dbf.type.eq('BOX')) or ((!dbf.type inset ('PJOI','SJOI')) and (!dbf.catre.name.matchwild('*U6*').not()))) then
                if ((!dbf.type.eq('SCTN')and (!gtp.eq('PLAT'))) or (!dbf.type.eq('BOX')) or ((!dbf.type inset ('PJOI','SJOI')) and (!dbf.catre.name.matchwild('*U6*').not()))) then
                  --<wd>sep2005

                  -- PLATE Area "$T" record NOT REQUIRED so PASS a !vprmtag as BLANK, i.e. ''
                  !!novprmtag =''

                  -- PLATE Area "$P" record
                  !vprmpart = !mdsvprmobj.vprmpart('STRU',!indx,!mdsvprmobj)
                  !vprmrecords.append(!vprmpart)

                  -- PLATE Area "$C" record
                  !vprmcomp = !mdsvprmobj.vprmcomp('STRU',!indx,!mdsvprmobj,!vprmpart,!!novprmtag)
                  !vprmrecords.append(!vprmcomp)

                  -- Delete GLOBAL Variable
                  !!novprmtag.delete()
                  handle ANY
                  endhandle
                endif

              endif

              -- Label Header
              label /mdsgrpstru

              -- Only SCTN elements need Individual VPRM Records for their LENGTH
              -- PJOIS, SJOIS etc... i.e. <PLATES>, <Building Attachments> etc.. are Quantified <No. Off> so BREAK the loop after the FIRST Plate

              -- ****************************************************************************
              --<wd>sep2005
              -- *** IMPORTANT NOTE ***
              -- MDS VPRM output records for "SCTN" type elements with a GTYP of "PLAT" on a
              -- FRAMATOME Template type "FANP14"-<"FT17"> are to be output the same as ANY OTHER
              -- type of PLATE element, e.g. <PJOI, SJOI, BOX etc...>
              --<wd>sep2005
              -- ****************************************************************************

              --break if !mdsvprmobj.strumemb[2][!mdsvprmobj.strumemb[5][!indx][!quan]].dbref().type.neq('SCTN')
              break if (!dbf.type.neq('SCTN'))

              --<wd>sep2005
              -- Treat this SCTN type as ANY OTHER type of PLATE element and BREAK out of the LOOP.
              break if (!dbf.type.eq('SCTN')) and (!gtp.eq('PLAT'))
              --<wd>sep2005

            enddo

          enddo

        endif

        -- Determine the MDS HANGER records in the MDS GROUP Support
        ------------------------------------------------------------
        -- MDS GROUP Support
        --***
        if (!mdsvprmobj.hangmemb.empty().not()) then
          --***
          if (!mdsvprmobj.hangmemb[1].size().gt(0)) then
            -- MDS HANGER Components Exist
            !sf2 = '03'

            -- Add the "$L" LINE record before every SUB-UNIT record
            !vprmrecords.appendarray(!vprmlinearray)

            -- "$S" -- Concatenate the MDS Support SECTION/SUB-UNIT Record <8 fields>
            !vprmsubunit = !sf1 & ':' & !sf2 & ':' & !sf3 & ':' & !sf4 & ':' & !sf5 & ':' & !sf6 & ':' & !sf7 & ':*'
            !vprmrecords.append(!vprmsubunit)

            --Loop through the MDS HANGER DESCRIPTIONS
            do !indx indices !mdsvprmobj.hangmemb[3]

              -- Loop Thro the Hanger Members Individually via the Quantity Required <No. Off> value
              -- Each INDIVIDUAL "Implied Hanger ROD"<TUBI> element requires the LENGTH to be output for VPRM records
              !membquantity = !mdsvprmobj.hangmemb[4][!indx]
              do !quan from 1 to $!membquantity

                --$P ****************
                --$P *** !quan = $!quan ***
                --q var !mdsvprmobj.hangmemb[2][!mdsvprmobj.hangmemb[5][!indx][!quan]].dbref().type
                --q var !mdsvprmobj.hangmemb[2][!mdsvprmobj.hangmemb[5][!indx][!quan]].dbref().type.neq('TUBI')
                --$P+++++++++++++++++++++++++++++++++

                -- LISEGA SPRINGS also need INDIVIDUAL records because they require UNIQUE TAG Nos.
                !dbf = !mdsvprmobj.hangmemb[2][!mdsvprmobj.hangmemb[5][!indx][!quan]].dbref()
                !spring = FALSE
                -- Check if it's a LISEGA SPRING on a MDS HANGER in the OBJECT "!mdsvprmoj"
                if (!mdsvprmobj.hangspring.empty().not()) then
                  !findspring = !mdsvprmobj.hangspring.find(!dbf)
                  if (!findspring.empty().not()) then
                    -- The Spring Exists on the MDS Hanger so Create individual VPRM records for "ALL" LISEGA "SPRINGS"
                    !mdsvprmobj.springindex = !findspring[1]
                    !spring = TRUE
                  endif
                endif

                -------------------------------------------------
                !vprmpart = !mdsvprmobj.vprmpart('HANG',!indx,!mdsvprmobj)
                -- Skip & Ignore an "ILLEGAL" LISEGA PART NO. for Implied ROD with the a PART No. "LISM*"
                -- e.g. for SPREF <LSROD> "/LISEGA3.0/M12" <*** NOTE *** This could be a VALID LISEGA Component *** CHECK ???>
                skip if (!vprmpart.part(2,':').matchwild('LISM*'))
                --!vprmrecords.append(!vprmpart)
                if (!vprmpart.eq('ERROR')) then
                  -- CRITICAL ERROR -- SKIP and DO NOT Process this MDS Support Component
                  -- Any attribute i.e. QUALITY CLASS, MATERIAL or MATERIAL GROUP is 'unset'
                  --skip
                  -- Need to GOLABEL to the BREAK option and NOT SKIP as QUANTITIES are being Looped Here!
                  !vprmrecords.append(!vprmpart)
                  golabel /mdsgrphang
                endif

                !vprmtag  = !mdsvprmobj.vprmtag('HANG',!indx,!mdsvprmobj)
                --!vprmrecords.append(!vprmtag)
                if (!vprmtag.eq('ERROR')) then
                  -- CRITICAL ERROR -- SKIP and DO NOT Process this MDS Support Component
                  -- Any attribute i.e. QUALITY CLASS, MATERIAL or MATERIAL GROUP is 'unset'
                  --skip
                  -- Need to GOLABEL to the BREAK option and NOT SKIP as QUANTITIES are being Looped Here!
                  !vprmrecords.append(!vprmtag)
                  golabel /mdsgrphang
                endif

                -- PART and TAG No. Generation OK, therefore append to the array "!vprmrecords" and
                -- Include MDS Support Component in MDS-VPRM BULK MTO
                !vprmrecords.append(!vprmpart)
                !vprmrecords.append(!vprmtag)
                -------------------------------------------------

                !vprmcomp = !mdsvprmobj.vprmcomp('HANG',!indx,!mdsvprmobj,!vprmpart,!vprmtag)
                !vprmrecords.append(!vprmcomp)

                !vprmcompuda = !mdsvprmobj.vprmcompuda('HANG',!indx,!mdsvprmobj,!vprmconfig)
                !vprmrecords.appendarray(!vprmcompuda)

                -------------------------------------------------
                -- For LISEGA PLATE elements ONLY provide an ADDITIONAL record for an "AREA" Unit of Measure<SM> for a "PLATE"
                -- i.e. ONLY "SP" and "SC" records required and the WEIGHT is to be output in Kg/m2

                if ((!dbf.type.eq('WPAD')) or (!dbf.spre.name.matchwild('*/PLT*'))) then
                  -- PLATE Area "ST" record NOT REQUIRED so PASS the argument !vprmtag as BLANK, i.e. !!novprmtag = ''
                  !!novprmtag =''

                  -- PLATE Area "$P" record
                  !vprmpart = !mdsvprmobj.vprmpart('HANG',!indx,!mdsvprmobj)
                  !vprmrecords.append(!vprmpart)

                  -- PLATE Area "$C" record
                  !vprmcomp = !mdsvprmobj.vprmcomp('HANG',!indx,!mdsvprmobj,!vprmpart,!!novprmtag)
                  !vprmrecords.append(!vprmcomp)

                  -- Delete GLOBAL Variable
                  !!novprmtag.delete()
                  handle ANY
                  endhandle

                endif
                -------------------------------------------------

                -- NOMINATED LISEGA CODES for "Implied Hanger ROD <TUBI>" components REQUIRE Individual VPRM Records for their LENGTH
                -- However for simplicity process and CREATE individual VPRM records for "ALL" LISEGA Implied ROD <TUBI> components.
                -- <*** There a few exceptions TBA ***> but generally the LISEGA
                --  Hanger Components are Quantified <No. Off> so BREAK the loop after the FIRST Element if NOT of type 'TUBI'
                label /mdsgrphang

                -- LISEGA SPRINGS also need INDIVIDUAL records because they require UNIQUE TAG Nos.
                --break if !mdsvprmobj.hangmemb[2][!mdsvprmobj.hangmemb[5][!indx][!quan]].dbref().type.neq('TUBI')
                -- Break if !dbf neq <TUBI> or NOT a LISEGA Spring
                if ((!dbf.type.neq('TUBI')) and (!spring.not())) then
                  break
                endif

              enddo


              -------------------------------------------------------------------------------------------------------------
              --<wd>mar2006
              -- When !vprmpart = 'ERROR' then there is NO NEED to CHECK for "AUSTENETIC INLAY PLATES"
              if (!vprmpart.eq('ERROR')) then
                -- CRITICAL ERROR -- SKIP and DO NOT Process this MDS Support Component
                -- Any attribute i.e. QUALITY CLASS, MATERIAL or MATERIAL GROUP is 'unset'
                !vprmrecords.append(!vprmpart)
                skip
              endif
              --<wd>mar2006
              -------------------------------------------------------------------------------------------------------------


              -------------------------------------------------------------------------------------------------------------
              -- Some LISEGA Components MAY require "AUSTENITIC INLAY PLATES"
              --
              -- Check if the LISEGA Component <PCLA> UDA ":mdsaustshld"; e.g.
              -- LISEGA Spref /LISEGA3.0/361762 on a "Stainless Steel" PIPE Specn.<e.g. /C150>, has the UDA setting
              -- ":MDSAustshld 1/361762-IP", where "1" before the "/" character is the VPRM QUANITY required
              -- and "361762-IP" after the "/" character is the VPRM TAG No. required to be output
              --
              -- Determine the PART No. of the Current LISEGA Hanger Component
              !vprmpartplat = !vprmpart
              !pplt = !vprmpartplat.split(':')
              --!ppf2 = !pplt[2] & '-IP'

              -- Only Certain LISEGA "PCLA" Hanger Components MAY require an "AUSTENITIC INLAY PLATE"
              if (!dbf.type.eq('PCLA')) then

                --if (!pplt[2] inset ('LIS34', 'LIS36', 'LIS37', 'LIS42', 'LIS43', 'LIS44', 'LIS45', 'LIS48')) then
                --if (!pplt[2] inset ('LIS34', 'LIS36', 'LIS37', 'LIS42', 'LIS43', 'LIS44', 'LIS45', 'LIS48', 'LIS49','LISR34', 'LISR36', 'LISR37', 'LISR42', 'LISR43', 'LISR44', 'LISR45', 'LISR48', 'LISR49')) then

                --------------
                --<wd>mar2006
                -- This CHECK now INCLUDES ALL PIPE CLAMPS with the new "-S1" suffix appended for PIPES with a QUALITY CLASS of "QC1"
                --if (!pplt[2] inset ('LIS34', 'LIS36', 'LIS37', 'LIS42', 'LIS43', 'LIS44', 'LIS45', 'LIS48', 'LIS49H', 'LIS49HG','LISR34', 'LISR36', 'LISR37', 'LISR42', 'LISR43', 'LISR44', 'LISR45', 'LISR48', 'LISR49H', 'LISR49HG')) then
                if (!this.mdsaustshld(!pplt[2])) then
                  --<wd>mar2006
                  --------------

                  -- Check if the UDA :mdsaustshld is SET and requires *** "AUSTENITIC INLAY PLATES" ***
                  if ((!dbf.:mdsaustshld.trim().eq('')) or (!dbf.:mdsaustshld.unset())) then
                    -- AUSTENITIC Shields are NOT required
                    skip
                  endif

                  -- Add an extra VPRM "$P" Part No. record if LISEGA "LICAD" has set the UDA :mdsaustshld"
                  !ppf8 = 'Austenitic Inlay Plate'
                  --------------
                  --<wd>mar2006
                  -- REMOVE the new "-S1" suffix from the PART No. for an AUSTENITIC INLAY PLATE
                  --!ppf2 = !pplt[2] & '-IP'
                  !ppf2 = !pplt[2].before('-S1') & '-IP'

                  --<wd>mar2006
                  --------------

                  -- Concatenate the NEW "$P" record
                  !vprmpartplat =  !pplt[1] & ':' & !ppf2 & ':' & !pplt[3] & ':' & !pplt[4] & ':' & !pplt[5] & ':' & !pplt[6] & ':' & !pplt[7] & ':' & !ppf8 & ':' & !pplt[9]
                  !vprmrecords.append(!vprmpartplat)

                  -- Add an extra VPRM "$T" Tag No. record -- Get the TAG No. from the UDA :mdsaustshld
                  !vprmtagplat = !vprmtag
                  !tplt = !vprmtagplat.split(':')
                  --!tpf2 = !tplt[2] & '-IP'
                  !tpf2 = !dbf.:mdsaustshld.part(2,'/')
                  !tpf4 = '*'
                  -- Concatenate the NEW "$T" record
                  !vprmtagplat =!tplt[1] & ':' & !tpf2 & ':' & !tpf2 & ':' & !tpf4
                  !vprmrecords.append(!vprmtagplat)

                  -- Add an extra VPRM "$C" Component record
                  !vprmcompplat = !vprmcomp
                  !cplt = !vprmcompplat.split(':')
                  --!cpf7 = !cplt[7] & '-IP'
                  --!cpf8 = !cplt[8] & '-IP'
                  !cpf7 = !ppf2
                  !cpf8 = !tpf2

                  --<wd>mar2006
                  --!cpf9 = !dbf.:mdsaustshld.part(1,'/')
                  !cpf9 = !dbf.:mdsaustshld.part(1,'/').real()
                  --<wd>mar2006

                  -- Concatenate the NEW "$C" record
                  !vprmcompplat = !cplt[1] & ':' & !cplt[2] & ':' & !cplt[3] & ':' & !cplt[4] & ':' & !cplt[5] & ':' & !cplt[6] & ':' & !cpf7 & ':' & !cpf8 & ':' & !cpf9 & ':' & !cplt[10] & ':' & !cplt[11] & ':' & !cplt[12] & ':' & !cplt[13] & ':' & !cplt[14] & ':' & !cplt[15] & ':' & !cplt[16] & ':' & !cplt[17] & ':' & !cplt[18] & ':' & !cplt[19] & ':' & !cplt[20] & ':' & !cplt[21] & ':' & !cplt[22] & ':' & !cplt[23] & ':' & !cplt[24]
                  !vprmrecords.append(!vprmcompplat)

                endif
              else
                -- LISEGA Component is NOT a PDMS Hanger "PCLA" element
                skip
              endif
              -------------------------------------------------------------------------------------------------------------

            enddo

          endif
          --***
        endif
        --***
      endif

      --<nb>jun2007  HPD0035322/OP47  (Generate Support component record)
      if (!!mdshangif.trim().upcase().neq('MDS')) then
        !vprmrecords.appendarray(!vprmlinearray)
        !sf2 = '04'
        !vprmsubunit = !sf1 & ':' & !sf2 & ':' & !sf3 & ':' & !sf4 & ':' & !sf5 & ':' & !sf6 & ':' & !sf7 & ':*'
        !vprmrecords.append(!vprmsubunit)
        !vprmpart = !mdsvprmobj.vprmpart('SUPP',!indx,!mdsvprmobj)
        !vprmtag  = !mdsvprmobj.vprmtag('SUPP',!indx,!mdsvprmobj)
        !vprmrecords.append(!vprmtag)
        !vprmcomp = !mdsvprmobj.vprmcomp('SUPP',!indx,!mdsvprmobj,!vprmpart,!vprmtag)
        !vprmrecords.append(!vprmcomp)
      endif
      ---------------------------------------------------------------------------------------------------
      --END of  A MDS GROUP Support where the MASTER Support is "ALWAYS" the "ONLY"
      --MDS STRUCTURE Support in the GROUP
      ---------------------------------------------------------------------------------------------------

    else
      --************************************************************
      --------------------------------------------------------------
      -- MDS Support does *** NOT *** belong to a MDS GROUP Support
      --------------------------------------------------------------
      -- Initialise the ATTAS exist <BOOLEAN>
      !attasexist = FALSE

      if (!mdsvprmobj.supptype.eq('STRU')) then
        -- An Independent MDS STRUCTURE Support

        -- Determine the MDS ANCILLARY ATTA records on the MDS STRUCTURE Support
        -------------------------------------------------------------------------------
        -- MDS Support does *** NOT *** belong to a   MDS GROUP Support
        if (!mdsvprmobj.attamemb[1].size().gt(0)) then
          !sf2 = '01'

          -- "$S" -- Concatenate the MDS Support SECTION/SUB-UNIT Record <8 fields>
          !vprmsubunit = !sf1 & ':' & !sf2 & ':' & !sf3 & ':' & !sf4 & ':' & !sf5 & ':' & !sf6 & ':' & !sf7 & ':*'

          !count = 0
          do !indx indices !mdsvprmobj.attamemb[3]
            -- MDS ANCILLARY ATTA Components Exist -- but DO NOT PROCESS ANY "REST" type Attas
            !pipe  = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref().owner.owner
            !bran  = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref().owner
            !stype = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref().stype
            !vprm  = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref().:mdsvprmmto
            if (!stype inset ('PIPE-REST','HVAC-REST','RACK-REST')) then
              skip
            elseif (!vprm.not()) then
              skip
            else
              !count = !count + 1
            endif
            -- Add the MDS ANCILLARY SUB-UNIT Record prior to FIRST MDS ANCILLARY Atta PART NUMBER Record
            if (!count.eq(1)) then
              !vprmrecords.append(!vprmsubunit)
              -- MDS ANCILLARY ATTA records exist
              !attasexist = TRUE
            endif

            --Loop through ALL "NON REST" type MDS ATTA DESCRIPTIONS
            -------------------------------------------------
            !vprmpart = !mdsvprmobj.vprmpart('ATTA',!indx,!mdsvprmobj)
            --!vprmrecords.append(!vprmpart)
            if (!vprmpart.eq('ERROR')) then
              -- CRITICAL ERROR -- SKIP and DO NOT Process this MDS Support Component
              -- Any attribute i.e. QUALITY CLASS, MATERIAL or MATERIAL GROUP is 'unset'
              !vprmrecords.append(!vprmpart)
              skip
            endif

            !vprmtag  = !mdsvprmobj.vprmtag('ATTA',!indx,!mdsvprmobj)
            --!vprmrecords.append(!vprmtag)
            if (!vprmtag.eq('ERROR')) then
              -- CRITICAL ERROR -- SKIP and DO NOT Process this MDS Support Component
              -- Any attribute i.e. QUALITY CLASS, MATERIAL or MATERIAL GROUP is 'unset'
              !vprmrecords.append(!vprmtag)
              skip
            endif

            -- PART and TAG No. Generation OK, therefore append to the array "!vprmrecords" and
            -- Include the MDS Support Component in MDS-VPRM BULK MTO
            !vprmrecords.append(!vprmpart)
            !vprmrecords.append(!vprmtag)
            -------------------------------------------------

            !vprmcomp = !mdsvprmobj.vprmcomp('ATTA',!indx,!mdsvprmobj,!vprmpart,!vprmtag)
            !vprmrecords.append(!vprmcomp)

            !vprmcompuda = !mdsvprmobj.vprmcompuda('ATTA',!indx,!mdsvprmobj,!vprmconfig)
            !vprmrecords.appendarray(!vprmcompuda)

            -------------------------------------------------------------------------------------------------------------
            -- ATTA Components requiring "AUSTENITIC INLAY PLATES"
            -- Determine the PART No. of the Current ATTA Component
            !vprmpartplat = !vprmpart
            !pplt = !vprmpartplat.split(':')
            if (!pplt[2].matchwild('LIS40-70TS*')) then
              !pnum = 'LIS40-70TS'
              --!pmgr = !pplt[2].after('LIS40-70TS-')
              !pmgr = !pplt[2].after('LIS40-70TS')
            else
              !pnum = !pplt[2].before('-')
              !pmgr = !pplt[2].after('-')
            endif
            -- Check if an AUSTENITIC Inlay Plate is required
            --if (!pnum inset ('V1_GH', 'V1_GN', 'V4_GA', 'V4_GB', 'V4_GC', 'V6_GA', 'V6_GB', 'V2_XRH', 'V2_XRN', 'V3_XE', 'V3_XH', 'V3_XN', 'V4_XC', 'LIS49', 'LISR49*')) then
            --if (!pnum inset ('V1_GH', 'V1_GN', 'V4_GA', 'V4_GB', 'V4_GC', 'V6_GA', 'V6_GB', 'V3_XE', 'V3_XH', 'V3_XN', 'V4_XC', 'LIS40', 'LIS49', 'LISR49*')) then
            --if (!pnum inset ('V1_GH', 'V1_GN', 'V4_GA', 'V4_GB', 'V4_GC', 'V6_GA', 'V6_GB', 'V3_XE', 'V3_XH', 'V3_XN', 'V4_XC', 'LIS40-70TS', 'LIS49', 'LISR49*')) then

            --------------
            --<wd>mar2006
            -- This CHECK now INCLUDES ALL MDS ANCILLARY with the new "-S1" suffix appended for PIPES with a QUALITY CLASS of "QC1"
            --if (!pnum inset ('V1_GH', 'V1_GN', 'V4_GA', 'V4_GB', 'V4_GC', 'V6_GA', 'V6_GB', 'V3_XE', 'V3_XH', 'V3_XN', 'V4_XC', 'LIS40-70TS', 'LIS49A', 'LISR49A', 'LIS49G', 'LISR49G')) then
            if (!this.mdsaustshld(!pnum)) then
              --<wd>mar2006
              --------------

              -- SKIP if PART No. is 'LIS40' and the Property CODE is NOT "40??70-TS"
              --if (!pnum.eq('LIS40')) then
              --!code = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref().prop.code
              --if (!code.matchwild('40??70-TS').not()) then
              --skip
              --endif
              --endif

              -- Check if the Owning Pipe Specification UDA ":mdsaustshld" of the ATTA is set to " with austenitic shield"
              --if (!pipe.pspe.:mdsaustshld.trim().matchwild('*with*austen*')) then
              if (!bran.pspe.:mdsaustshld.trim().matchwild('*with*austen*')) then

                -- Check the Material Reference of the ATTA Ancillary for STAINLESS STEEL
                -- STAINLESS STEEL Ancillaries DO NOT REQUIRE an AUSTENITIC INLAY PLATE
                !dbf = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref()
                -- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
                -- the matref attribute has been added to atta. Find the correct attribute to use
                -- The variable !matrefAtt will be set to either REF for matref or UDA for :MdsMatref
                !matrefAtt = !!mdsUseMatref(!dbf)
                if (!matrefAtt.eq('UDA')) then
                  if (!dbf.:mdsmatref.:mdsmatgroup.eq('SS')) then
                    --$P *** Skipping... *** MDS STRU ATTA $!dbf.name *** AUSTENITIC INLAY PLATE is NOT required ***
                    skip
                  endif
                else
                  if (!dbf.matref.:mdsmatgroup.eq('SS')) then
                    --$P *** Skipping... *** MDS STRU ATTA $!dbf.name *** AUSTENITIC INLAY PLATE is NOT required ***
                    skip
                  endif
                endif

                -- *** ADD *** an extra *** VPRM "$P" Part No. record ***
                --!vprmpartplat = !vprmpart
                --!pplt = !vprmpartplat.split(':')
                --if ((!pnum.eq('LIS49')) or (!pnum.eq('LISR49'))) then
                --if ( (!pnum.eq('LIS49A')) or (!pnum.eq('LISR49A'))or (!pnum.eq('LIS49G')) or (!pnum.eq('LISR49G')) ) then
                --pmgr = !pplt[7]
                --!ppf2 = !pnum & '-IP'
                --else
                --                if ( (!pnum.eq('LIS49A')) or (!pnum.eq('LISR49A'))or (!pnum.eq('LIS49G')) or (!pnum.eq('LISR49G')) ) then
                --                  --!pmgr = !pplt[7]
                --                  !ppf2 = !pnum & '-IP'

                -- dtf >>> 123.11.05 remove safety class from AUSTENITIC PLATE its not required
                --q var !pmgr
                --$P 2661
                if (!pmgr.matchwild('*-S1')) then
                  !pmgr = !pmgr.before('-S1')
                endif
                -- dtf <<< end of mod

                if (!pnum.eq('LIS40-70TS')) then
                  !ppf2 = !pnum & '-IP' & !pmgr
                else
                  !ppf2 = !pnum & '-IP' & '-' & !pmgr
                endif
                --endif

                !ppf8 = 'Austenitic Inlay Plate'
                -- Concatenate the NEW "$P" record
                !vprmpartplat =  !pplt[1] & ':' & !ppf2 & ':' & !pplt[3] & ':' & !pplt[4] & ':' & !pplt[5] & ':' & !pplt[6] & ':' & !pplt[7] & ':' & !ppf8  & ':' & !pplt[9]
                !vprmrecords.append(!vprmpartplat)

                -- Add an extra VPRM "$T" Tag No. record
                !vprmtagplat = !vprmtag
                !tplt = !vprmtagplat.split(':')

                if (!pnum.eq('LIS40-70TS')) then
                  !tnum = !tplt[2].before('-TS')
                  !tmgr = !tplt[2].after('-TS')
                else
                  !tnum = !tplt[2].before('-')
                  !tmgr = !tplt[2].after('-')
                endif

                --if ( (!pnum.eq('LIS49A')) or (!pnum.eq('LISR49A'))or (!pnum.eq('LIS49G')) or (!pnum.eq('LISR49G')) ) then
                --!tpf2 = !tnum & '-IP'
                --else
                -- dtf >>> 123.11.05 remove safety class from austenitic plate its not required
                --q var !tmgr
                --$P 2695
                if (!tmgr.matchwild('*-S1')) then
                  !tmgr = !tmgr.before('-S1')
                endif
                -- dtf <<< end of mod
                if (!pnum.eq('LIS40-70TS')) then
                  !tpf2 = !tnum & '-TS-IP' & !tmgr
                else
                  !tpf2 = !tnum & '-IP' & '-' & !tmgr
                endif
                --endif

                !tpf4 = '*'
                -- Concatenate the NEW "$T" record
                !vprmtagplat =!tplt[1] & ':' & !tpf2 & ':' & !tpf2 & ':' & !tpf4
                !vprmrecords.append(!vprmtagplat)

                -- Add an extra VPRM "$C" Component record
                !vprmcompplat = !vprmcomp
                !cplt = !vprmcompplat.split(':')
                !cpf7 = !ppf2
                !cpf8 = !tpf2
                if ((!cpf8.matchwild('49*')) or (!cpf8.matchwild('R49*'))) then
                  -- TWO Austenitic Inlay Plates required per Ancillary for types '49*' and 'R49*'
                  !xnum = !cplt[9]
                  !cpf9 = (2 * !xnum.real())
                else
                  !cpf9 = !cplt[9].real()
                endif
                -- Concatenate the NEW "$C" record
                !vprmcompplat = !cplt[1] & ':' & !cplt[2] & ':' & !cplt[3] & ':' & !cplt[4] & ':' & !cplt[5] & ':' & !cplt[6] & ':' & !cpf7 & ':' & !cpf8 & ':' & !cpf9 & ':' & !cplt[10] & ':' & !cplt[11] & ':' & !cplt[12] & ':' & !cplt[13] & ':' & !cplt[14] & ':' & !cplt[15] & ':' & !cplt[16] & ':' & !cplt[17] & ':' & !cplt[18] & ':' & !cplt[19] & ':' & !cplt[20] & ':' & !cplt[21] & ':' & !cplt[22] & ':' & !cplt[23] & ':' & !cplt[24]
                !vprmrecords.append(!vprmcompplat)

              endif
            endif
            -------------------------------------------------------------------------------------------------------------

          enddo

        endif

        -- Determine the MDS STRUCTURE records on the MDS STRUCTURE Support
        -------------------------------------------------------------------------------

        -- MDS Support does *** NOT *** belong to a MDS GROUP Support
        if (!mdsvprmobj.strumemb[1].size().gt(0)) then
          -- MDS STRUCTURE Components Exist
          !sf2 = '02'

          -- Add the "$L" LINE record before every STRUCTURAL SUB-UNIT record,
          -- but ONLY if MDS ANCILLARY ATTA records *** DO NOT ** exist on the MDS Support
          if (!attasexist) then
            !vprmrecords.appendarray(!vprmlinearray)
          endif

          -- "$S" -- Concatenate the MDS Support SECTION/SUB-UNIT Record <8 fields>
          !vprmsubunit = !sf1 & ':' & !sf2 & ':' & !sf3 & ':' & !sf4 & ':' & !sf5 & ':' & !sf6 & ':' & !sf7 & ':*'
          !vprmrecords.append(!vprmsubunit)

          -- Loop through the MDS STRUCTURE DESCRIPTIONS
          do !indx indices !mdsvprmobj.strumemb[3]

            -- Loop Thro the Structural Members Individually via the Quantity Required <NO.OFF> value
            -- Each INDIVIDUAL SCTN element requires the LENGTH to be output for VPRM records
            !membquantity = !mdsvprmobj.strumemb[4][!indx]
            do !quan from 1 to $!membquantity


              --     $P==========================================
              --     !!mv =  !mdsvprmobj
              --     $P !memquantity is : $!membquantity
              --     $P !indx is: $!indx
              --     $P !quan is: $!quan
              --     q var !mdsvprmobj.strumemb[2][!indx].dbref().fullname
              --     q var !mdsvprmobj.strumemb[3][!indx]
              --     $P>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
              --     q var !mdsvprmobj.strumemb[2][!mdsvprmobj.strumemb[5][!indx][!quan]]
              --     $P-------------------------------------------<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<


              !dbf = !mdsvprmobj.strumemb[2][!mdsvprmobj.strumemb[5][!indx][!quan]].dbref()

              --<wd>sep2005
              -- FRAMATOME MDS TEMPLATE type "FANP14"-<"FT17"> can have a SCTN with a GTYP of "PLAT",
              -- and therefore this type of "SCTN" is to be treated as a "PLATE" element,
              -- i.e. it is to have the SAME MDS-VPRM output as other MDS PLATE types <e.g. PJOI, SJOI, BOX etc...>
              !gtp = !dbf.gtype
              --<wd>mar2006
              handle ANY
                !gtp = ''
              endhandle
              --<wd>mar2006
              --<wd>sep2005

              --$P ****************
              --$P *** !quan = $!quan ***
              --q var !mdsvprmobj.strumemb[2][!mdsvprmobj.strumemb[5][!indx][!quan]].dbref().type
              --$P+++++++++++++++++++++++++++++++++
              --skip if !mdsvprmobj.strumemb[2][!mdsvprmobj.strumemb[5][!indx][!quan]].dbref().type.neq('SCTN')
              --skip if !mdsvprmobj.strumemb[2][!indx].dbref().type.neq('SCTN')
              -------------------------------------------------
              !vprmpart = !mdsvprmobj.vprmpart('STRU',!indx,!mdsvprmobj)
              --!vprmrecords.append(!vprmpart)
              if (!vprmpart.eq('ERROR')) then
                -- CRITICAL ERROR -- SKIP and DO NOT Process this MDS Support Component
                -- Any attribute i.e. QUALITY CLASS, MATERIAL or MATERIAL GROUP is 'unset'
                --skip
                -- Need to GOLABEL to the BREAK option and NOT SKIP as QUANTITIES are being Looped Here!
                !vprmrecords.append(!vprmpart)
                golabel /notmdsgrpstru
              endif

              !vprmtag  = !mdsvprmobj.vprmtag('STRU',!indx,!mdsvprmobj)
              --!vprmrecords.append(!vprmtag)
              if (!vprmtag.eq('ERROR')) then
                -- CRITICAL ERROR -- SKIP and DO NOT Process this MDS Support Component
                -- Any attribute i.e. QUALITY CLASS, MATERIAL or MATERIAL GROUP is 'unset'
                --skip
                -- Need to GOLABEL to the BREAK option and NOT SKIP as QUANTITIES are being Looped Here!
                !vprmrecords.append(!vprmtag)
                golabel /notmdsgrpstru
              endif

              -- PART and TAG No. Generation OK, therefore append to the array "!vprmrecords" and
              -- Include the MDS Support Component in MDS-VPRM BULK MTO
              --<GE> 07/03/07 Set up !!extramatl for Full Reinforcements Plates
              !!extramatl = false
              --<GE> 07/03/07
              !vprmrecords.append(!vprmpart)
              !vprmrecords.append(!vprmtag)

              !vprmcomp = !mdsvprmobj.vprmcomp('STRU',!indx,!mdsvprmobj,!vprmpart,!vprmtag)
              !vprmrecords.append(!vprmcomp)

              !vprmcompuda = !mdsvprmobj.vprmcompuda('STRU',!indx,!mdsvprmobj,!vprmconfig)
              !vprmrecords.appendarray(!vprmcompuda)

              -- For PLATE elements ONLY provide an ADDITIONAL record for an "AREA" Unit of Measure<SM> for a "PLATE"
              -- i.e. ONLY "SP" and "SC" records required and the WEIGHT is to be output in "kg/m2"
              --<wd>sep2005
              -- FRAMATOME now have SCTN elements with a GTYP of PLAT, and VPRM records are to be output
              -- as other types of PLATES, i.e. with the ADDITIONAL "AREA" type records as well.

              --if (!dbf.type inset ('PJOI','SJOI','FITT','BOX')) then
              if ( (!dbf.type inset ('PJOI','SJOI','FITT','BOX')) or (!dbf.type.eq('SCTN')and (!gtp.eq('PLAT'))) ) then

                -- FANP Building Attachments are SJOI Assemblies and to be treated as SINGLE ITEMS and NOT as PLATE items
                -- Therefore DO NOT output AN "AREA" record for these SJOI items, so "SKIP" the additional record

                --if ((!dbf.type.eq('BOX')) or ((!dbf.type inset ('PJOI','SJOI')) and (!dbf.catre.name.matchwild('*U6*').not()))) then
                if ((!dbf.type.eq('SCTN')and (!gtp.eq('PLAT'))) or (!dbf.type.eq('BOX')) or ((!dbf.type inset ('PJOI','SJOI')) and (!dbf.catre.name.matchwild('*U6*').not()))) then
                  --<wd>sep2005

                  -- PLATE Area "ST" record NOT REQUIRED so PASS a !vprmtag as BLANK, i.e. ''
                  !!novprmtag =''

                  -- PLATE Area "$P" record
                  !vprmpart = !mdsvprmobj.vprmpart('STRU',!indx,!mdsvprmobj)
                  !vprmrecords.append(!vprmpart)

                  -- PLATE Area "$C" record
                  !vprmcomp = !mdsvprmobj.vprmcomp('STRU',!indx,!mdsvprmobj,!vprmpart,!!novprmtag)
                  !vprmrecords.append(!vprmcomp)

                  -- Delete GLOBAL Variable
                  !!novprmtag.delete()
                  handle ANY
                  endhandle
                endif

              endif
              --<GE> 07/03/07 Check to see if the PJOI is a Full Reinforcement type and then set up !!extramatl
              -- PART and TAG No. Generation OK, therefore append to the array "!vprmrecords" and
              -- Include the MDS Support Component in MDS-VPRM BULK MTO

              !!extramatl = false

              if (!dbf.spref.set()) then
                if (!dbf.spref.name.eq('/MDS-FRA-PNODS-FRPI') or !dbf.spref.name.eq('/MDS-FRA-PNODS-FRPG')) then

                  !!extramatl = true

                  !vprmpart = !mdsvprmobj.vprmpart('STRU',!indx,!mdsvprmobj)
                  !vprmrecords.append(!vprmpart)

                  !vprmtag  = !mdsvprmobj.vprmtag('STRU',!indx,!mdsvprmobj)
                  !vprmrecords.append(!vprmtag)

                  !vprmcomp = !mdsvprmobj.vprmcomp('STRU',!indx,!mdsvprmobj,!vprmpart,!vprmtag)
                  !vprmrecords.append(!vprmcomp)

                  !vprmcompuda = !mdsvprmobj.vprmcompuda('STRU',!indx,!mdsvprmobj,!vprmconfig)
                  !vprmrecords.appendarray(!vprmcompuda)

                  -- FANP Building Attachments are SJOI Assemblies and to be treated as SINGLE ITEMS and NOT as PLATE items
                  -- Therefore DO NOT output AN "AREA" record for these SJOI items, so "SKIP" the additional record
                  -- PLATE Area "ST" record NOT REQUIRED so PASS a !vprmtag as BLANK, i.e. ''
                  !!novprmtag =''

                  -- PLATE Area "$P" record
                  !vprmpart = !mdsvprmobj.vprmpart('STRU',!indx,!mdsvprmobj)
                  !vprmrecords.append(!vprmpart)

                  -- PLATE Area "$C" record
                  !vprmcomp = !mdsvprmobj.vprmcomp('STRU',!indx,!mdsvprmobj,!vprmpart,!!novprmtag)
                  !vprmrecords.append(!vprmcomp)

                  -- Delete GLOBAL Variable
                  !!novprmtag.delete()

                endif
              endif
              --<GE> 07/03/07

              -- Label Header
              label /notmdsgrpstru

              -- Only SCTN elements need Individual VPRM Records for their LENGTH
              -- PJOIS etc...,i.e. <PLATES> are Quantified <No. Off> so BREAK the loop after the FIRST Plate

              -- ****************************************************************************
              --<wd>sep2005
              -- *** IMPORTANT NOTE ***
              -- MDS VPRM output records for "SCTN" type elements with a GTYP of "PLAT" on a
              -- FRAMATOME Template type "FANP14"-<"FT17"> are to be output the same as ANY OTHER
              -- type of PLATE element, e.g. <PJOI, SJOI, BOX etc...>
              --<wd>sep2005
              -- ****************************************************************************

              break if (!mdsvprmobj.strumemb[2][!mdsvprmobj.strumemb[5][!indx][!quan]].dbref().type.neq('SCTN'))

              --<wd>sep2005
              -- Treat this SCTN type as ANY OTHER type of PLATE element and BREAK out of the LOOP.
              break if (!dbf.type.eq('SCTN')) and (!gtp.eq('PLAT'))
              --<wd>sep2005

            enddo

          enddo

        endif

      elseif (!mdsvprmobj.supptype.eq('HANG')) then
        -------------------------------------------------------------------------------
        -- An Independent MDS HANGER Support - RESTRAINT

        -- MDS Support does *** NOT *** belong to a MDS GROUP Support
        if (!mdsvprmobj.hangmemb[1].size().gt(0)) then
          -- MDS HANGER Components Exist
          !sf2 = '03'
          -- "$S" -- Concatenate the MDS Support SECTION/SUB-UNIT Record <8 fields>
          !vprmsubunit = !sf1 & ':' & !sf2 & ':' & !sf3 & ':' & !sf4 & ':' & !sf5 & ':' & !sf6 & ':' & !sf7 & ':*'
          !vprmrecords.append(!vprmsubunit)

          --Loop through the MDS HANGER DESCRIPTIONS
          do !indx indices !mdsvprmobj.hangmemb[3]

            -- Loop Thro the Hanger Members Individually via the Quantity Required <No. Off> value
            -- Each INDIVIDUAL "Implied Hanger ROD"<TUBI> element requires the LENGTH to be output for VPRM records
            !membquantity = !mdsvprmobj.hangmemb[4][!indx]
            do !quan from 1 to $!membquantity

              --$P ****************
              --$P *** !quan = $!quan ***
              --q var !mdsvprmobj.hangmemb[2][!mdsvprmobj.hangmemb[5][!indx][!quan]].dbref().type
              --q var !mdsvprmobj.hangmemb[2][!mdsvprmobj.hangmemb[5][!indx][!quan]].dbref().type.neq('TUBI')
              --$P+++++++++++++++++++++++++++++++++

              -- LISEGA SPRINGS also need INDIVIDUAL records because they require UNIQUE TAG Nos.
              !dbf = !mdsvprmobj.hangmemb[2][!mdsvprmobj.hangmemb[5][!indx][!quan]].dbref()
              !spring = FALSE
              -- Check if it's a LISEGA SPRING on a MDS HANGER in the OBJECT "!mdsvprmoj"
              if (!mdsvprmobj.hangspring.empty().not()) then
                !findspring = !mdsvprmobj.hangspring.find(!dbf)
                if (!findspring.empty().not()) then
                  -- The Spring Exists on the MDS Hanger so Create individual VPRM records for "ALL" LISEGA "SPRINGS"
                  !mdsvprmobj.springindex = !findspring[1]
                  !spring = TRUE
                endif
              endif

              -------------------------------------------------
              !vprmpart = !mdsvprmobj.vprmpart('HANG',!indx,!mdsvprmobj)
              -- Skip & Ignore an "ILLEGAL" LISEGA PART NO. for Implied ROD with the a PART No. "LISM*"
              -- e.g. for SPREF <LSROD> "/LISEGA3.0/M12" <*** NOTE *** This could be a VALID LISEGA Component *** CHECK ???>
              skip if (!vprmpart.part(2,':').matchwild('LISM*'))
              --!vprmrecords.append(!vprmpart)
              if (!vprmpart.eq('ERROR')) then
                -- CRITICAL ERROR -- SKIP and DO NOT Process this MDS Support Component
                -- Any attribute i.e. QUALITY CLASS, MATERIAL or MATERIAL GROUP is 'unset'
                --skip
                -- Need to GOLABEL to the BREAK option and NOT SKIP as QUANTITIES are being Looped Here!
                !vprmrecords.append(!vprmpart)
                golabel /notmdsgrphang
              endif

              !vprmtag  = !mdsvprmobj.vprmtag('HANG',!indx,!mdsvprmobj)
              --!vprmrecords.append(!vprmtag)
              if (!vprmtag.eq('ERROR')) then
                -- CRITICAL ERROR -- SKIP and DO NOT Process this MDS Support Component
                -- Any attribute i.e. QUALITY CLASS, MATERIAL or MATERIAL GROUP is 'unset'
                --skip
                -- Need to GOLABEL to the BREAK option and NOT SKIP as QUANTITIES are being Looped Here!
                !vprmrecords.append(!vprmtag)
                golabel /notmdsgrphang
              endif

              -- PART and TAG No. Generation OK, therefore append to the array "!vprmrecords" and
              -- Include MDS Support Component in MDS-VPRM BULK MTO
              !vprmrecords.append(!vprmpart)
              !vprmrecords.append(!vprmtag)
              -------------------------------------------------

              !vprmcomp = !mdsvprmobj.vprmcomp('HANG',!indx,!mdsvprmobj,!vprmpart,!vprmtag)
              !vprmrecords.append(!vprmcomp)

              !vprmcompuda = !mdsvprmobj.vprmcompuda('HANG',!indx,!mdsvprmobj,!vprmconfig)
              !vprmrecords.appendarray(!vprmcompuda)

              -------------------------------------------------
              -- For LISEGA PLATE elements ONLY provide an ADDITIONAL record for an "AREA" Unit of Measure<SM> for a "PLATE"
              -- i.e. ONLY "SP" and "SC" records required and the WEIGHT is to be output in Kg/m2
              if ((!dbf.type.eq('WPAD')) or (!dbf.spre.name.matchwild('*/PLT*'))) then
                -- PLATE Area "ST" record NOT REQUIRED so PASS the argument !vprmtag as BLANK, i.e. !!novprmtag = ''
                !!novprmtag =''

                -- PLATE Area "$P" record
                !vprmpart = !mdsvprmobj.vprmpart('HANG',!indx,!mdsvprmobj)
                !vprmrecords.append(!vprmpart)

                -- PLATE Area "$C" record
                !vprmcomp = !mdsvprmobj.vprmcomp('HANG',!indx,!mdsvprmobj,!vprmpart,!!novprmtag)
                !vprmrecords.append(!vprmcomp)

                -- Delete GLOBAL Variable
                !!novprmtag.delete()
                handle ANY
                endhandle

              endif
              -------------------------------------------------

              label /notmdsgrphang
              -- LISEGA SPRINGS also need INDIVIDUAL records because they require UNIQUE TAG Nos.
              --break if !mdsvprmobj.hangmemb[2][!mdsvprmobj.hangmemb[5][!indx][!quan]].dbref().type.neq('TUBI')
              -- Break if !dbf neq <TUBI> or NOT a LISEGA Spring
              if ((!dbf.type.neq('TUBI')) and (!spring.not())) then
                break
              endif

            enddo


            -------------------------------------------------------------------------------------------------------------
            --<wd>mar2006
            -- When !vprmpart = 'ERROR' then there is NO NEED to CHECK for "AUSTENETIC INLAY PLATES"
            if (!vprmpart.eq('ERROR')) then
              -- CRITICAL ERROR -- SKIP and DO NOT Process this MDS Support Component
              -- Any attribute i.e. QUALITY CLASS, MATERIAL or MATERIAL GROUP is 'unset'
              !vprmrecords.append(!vprmpart)
              skip
            endif
            --<wd>mar2006
            -------------------------------------------------------------------------------------------------------------


            -------------------------------------------------------------------------------------------------------------
            -- Some LISEGA Components MAY require "AUSTENITIC INLAY PLATES"
            --
            -- Check if the LISEGA Component <PCLA> UDA ":mdsaustshld"; e.g.
            -- LISEGA Spref /LISEGA3.0/361762 on a "Stainless Steel" PIPE Specn.<e.g. /C150>, has the UDA setting
            -- ":MDSAustshld 1/361762-IP", where "1" before the "/" character is the VPRM QUANITY required
            -- and "361762-IP" after the "/" character is the VPRM TAG No. required to be output
            --
            -- Determine the PART No. of the Current LISEGA Hanger Component
            !vprmpartplat = !vprmpart
            !pplt = !vprmpartplat.split(':')
            --!ppf2 = !pplt[2] & '-IP'

            -- Only Certain LISEGA "PCLA" Hanger Components MAY require an "AUSTENITIC INLAY PLATE"
            if (!dbf.type.eq('PCLA')) then
              --if (!pplt[2] inset ('LIS34', 'LIS36', 'LIS37', 'LIS42', 'LIS43', 'LIS44', 'LIS45', 'LIS48')) then
              --if (!pplt[2] inset ('LIS34', 'LIS36', 'LIS37', 'LIS42', 'LIS43', 'LIS44', 'LIS45', 'LIS48', 'LIS49','LISR34', 'LISR36', 'LISR37', 'LISR42', 'LISR43', 'LISR44', 'LISR45', 'LISR48', 'LISR49')) then

              --------------
              --<wd>mar2006
              -- This CHECK now INCLUDES ALL PIPE CLAMPS with the new "-S1" suffix appended for PIPES with a QUALITY CLASS of "QC1"
              --if (!pplt[2] inset ('LIS34', 'LIS36', 'LIS37', 'LIS42', 'LIS43', 'LIS44', 'LIS45', 'LIS48', 'LIS49H', 'LIS49HG','LISR34', 'LISR36', 'LISR37', 'LISR42', 'LISR43', 'LISR44', 'LISR45', 'LISR48', 'LISR49H', 'LISR49HG')) then
              if (!this.mdsaustshld(!pplt[2])) then
                --<wd>mar2006
                --------------

                -- Check if the UDA :mdsaustshld is SET and requires *** "AUSTENITIC INLAY PLATES" ***
                if ((!dbf.:mdsaustshld.trim().eq('')) or (!dbf.:mdsaustshld.unset())) then
                  -- AUSTENITIC Shields are NOT required
                  skip
                endif

                -- Add an extra VPRM "$P" Part No. record if LISEGA "LICAD" has set the UDA :mdsaustshld"
                !ppf8 = 'Austenitic Inlay Plate'
                --------------
                --<wd>mar2006
                -- REMOVE the new "-S1" suffix from the PART No. for an AUSTENITIC INLAY PLATE
                --!ppf2 = !pplt[2] & '-IP'
                !ppf2 = !pplt[2].before('-S1') & '-IP'

                --<wd>mar2006
                --------------

                -- Concatenate the NEW "$P" record
                !vprmpartplat =  !pplt[1] & ':' & !ppf2 & ':' & !pplt[3] & ':' & !pplt[4] & ':' & !pplt[5] & ':' & !pplt[6] & ':' & !pplt[7] & ':' & !ppf8  & ':' & !pplt[9]
                !vprmrecords.append(!vprmpartplat)

                -- Add an extra VPRM "$T" Tag No. record -- Get the TAG No. from the UDA :mdsaustshld
                !vprmtagplat = !vprmtag
                !tplt = !vprmtagplat.split(':')
                --!tpf2 = !tplt[2] & '-IP'
                !tpf2 = !dbf.:mdsaustshld.part(2,'/')
                !tpf4 = '*'
                -- Concatenate the NEW "$T" record
                !vprmtagplat =!tplt[1] & ':' & !tpf2 & ':' & !tpf2 & ':' & !tpf4
                !vprmrecords.append(!vprmtagplat)

                -- Add an extra VPRM "$C" Component record
                !vprmcompplat = !vprmcomp
                !cplt = !vprmcompplat.split(':')
                !cpf7 = !ppf2
                !cpf8 = !tpf2

                --<wd>mar2006
                --!cpf9 = !dbf.:mdsaustshld.part(1,'/')
                !cpf9 = !dbf.:mdsaustshld.part(1,'/').real()
                --<wd>mar2006

                -- Concatenate the NEW "$C" record
                !vprmcompplat = !cplt[1] & ':' & !cplt[2] & ':' & !cplt[3] & ':' & !cplt[4] & ':' & !cplt[5] & ':' & !cplt[6] & ':' & !cpf7 & ':' & !cpf8 & ':' & !cpf9 & ':' & !cplt[10] & ':' & !cplt[11] & ':' & !cplt[12] & ':' & !cplt[13] & ':' & !cplt[14] & ':' & !cplt[15] & ':' & !cplt[16] & ':' & !cplt[17] & ':' & !cplt[18] & ':' & !cplt[19] & ':' & !cplt[20] & ':' & !cplt[21] & ':' & !cplt[22] & ':' & !cplt[23] & ':' & !cplt[24]
                !vprmrecords.append(!vprmcompplat)

              endif
            else
              -- LISEGA Component is NOT a PDMS Hanger "PCLA" element
              skip
            endif

            -------------------------------------------------------------------------------------------------------------
          enddo

        endif


      elseif (!mdsvprmobj.supptype.eq('ATTA')) then
        -------------------------------------------------------------------------------
        -- An Independent MDS Ancillary ATTA Support
        !sf2 = '01'

        -- MDS Support does *** NOT *** belong to a MDS GROUP Support
        -- Determine the MDS ANCILLARY ATTA records on the MDS ANCILLARY Support
        if (!mdsvprmobj.attamemb[1].size().gt(0)) then
          !sf2 = '01'
          -- "$S" -- Concatenate the MDS Support SECTION/SUB-UNIT Record <8 fields>
          !vprmsubunit = !sf1 & ':' & !sf2 & ':' & !sf3 & ':' & !sf4 & ':' & !sf5 & ':' & !sf6 & ':' & !sf7 & ':*'

          !count = 0
          do !indx indices !mdsvprmobj.attamemb[3]
            -- MDS ANCILLARY ATTA Components Exist -- but DO NOT PROCESS ANY "REST" type Attas
            !pipe  = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref().owner.owner
            !bran  = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref().owner
            !stype = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref().stype
            !vprm  = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref().:mdsvprmmto
            if (!stype inset ('PIPE-REST','HVAC-REST','RACK-REST')) then
              skip
            elseif (!vprm.not()) then
              skip
            else
              !count = !count + 1
            endif

            -- Add the MDS ANCILLARY SUB-UNIT Record prior to FIRST MDS ANCILLARY Atta PART NUMBER Record
            if (!count.eq(1)) then
              !vprmrecords.append(!vprmsubunit)
            endif

            --Loop through ALL "NON REST" type MDS ATTA DESCRIPTIONS
            -------------------------------------------------
            !vprmpart = !mdsvprmobj.vprmpart('ATTA',!indx,!mdsvprmobj)
            --!vprmrecords.append(!vprmpart)
            if (!vprmpart.eq('ERROR')) then
              -- CRITICAL ERROR -- SKIP and DO NOT Process this MDS Support Component
              -- Any attribute i.e. QUALITY CLASS, MATERIAL or MATERIAL GROUP is 'unset'
              !vprmrecords.append(!vprmpart)
              skip
            endif

            !vprmtag  = !mdsvprmobj.vprmtag('ATTA',!indx,!mdsvprmobj)
            --!vprmrecords.append(!vprmtag)
            if (!vprmtag.eq('ERROR')) then
              -- CRITICAL ERROR -- SKIP and DO NOT Process this MDS Support Component
              -- Any attribute i.e. QUALITY CLASS, MATERIAL or MATERIAL GROUP is 'unset'
              !vprmrecords.append(!vprmtag)
              skip
            endif

            -- PART and TAG No. Generation OK, therefore append to the array "!vprmrecords" and
            -- Include the MDS Support Component in MDS-VPRM BULK MTO
            !vprmrecords.append(!vprmpart)
            !vprmrecords.append(!vprmtag)
            -------------------------------------------------

            !vprmcomp = !mdsvprmobj.vprmcomp('ATTA',!indx,!mdsvprmobj,!vprmpart,!vprmtag)
            !vprmrecords.append(!vprmcomp)

            !vprmcompuda = !mdsvprmobj.vprmcompuda('ATTA',!indx,!mdsvprmobj,!vprmconfig)
            !vprmrecords.appendarray(!vprmcompuda)

            -------------------------------------------------------------------------------------------------------------
            -- ATTA Components requiring "AUSTENITIC INLAY PLATES"
            -- Determine the PART No. of the Current ATTA Component
            !vprmpartplat = !vprmpart
            !pplt = !vprmpartplat.split(':')
            if (!pplt[2].matchwild('LIS40-70TS*')) then
              !pnum = 'LIS40-70TS'
              --!pmgr = !pplt[2].after('LIS40-70TS-')
              !pmgr = !pplt[2].after('LIS40-70TS')

            else
              !pnum = !pplt[2].before('-')
              !pmgr = !pplt[2].after('-')
            endif
            -- Check if an AUSTENITIC Inlay Plate is required
            --if (!pnum inset ('V1_GH', 'V1_GN', 'V4_GA', 'V4_GB', 'V4_GC', 'V6_GA', 'V6_GB', 'V2_XRH', 'V2_XRN', 'V3_XE', 'V3_XH', 'V3_XN', 'V4_XC', 'LIS49', 'LISR49*')) then
            --if (!pnum inset ('V1_GH', 'V1_GN', 'V4_GA', 'V4_GB', 'V4_GC', 'V6_GA', 'V6_GB', 'V3_XE', 'V3_XH', 'V3_XN', 'V4_XC', 'LIS40', 'LIS49', 'LISR49*')) then
            --if (!pnum inset ('V1_GH', 'V1_GN', 'V4_GA', 'V4_GB', 'V4_GC', 'V6_GA', 'V6_GB', 'V3_XE', 'V3_XH', 'V3_XN', 'V4_XC', 'LIS40-70TS', 'LIS49', 'LISR49*')) then

            --------------
            --<wd>mar2006
            -- This CHECK now INCLUDES ALL MDS ANCILLARY with the new "-S1" suffix appended for PIPES with a QUALITY CLASS of "QC1"
            --if (!pnum inset ('V1_GH', 'V1_GN', 'V4_GA', 'V4_GB', 'V4_GC', 'V6_GA', 'V6_GB', 'V3_XE', 'V3_XH', 'V3_XN', 'V4_XC', 'LIS40-70TS', 'LIS49A', 'LISR49A', 'LIS49G', 'LISR49G')) then
            if (!this.mdsaustshld(!pnum)) then
              --<wd>mar2006
              --------------

              -- SKIP if PART No. is 'LIS40' and the Property CODE is NOT "40??70-TS"
              --if (!pnum.eq('LIS40')) then
              --!code = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref().prop.code
              --if (!code.matchwild('40??70-TS').not()) then
              --skip
              --endif
              --endif
              -- Check if the Owning Pipe Specification UDA ":mdsaustshld" of the ATTA is set to " with austenitic shield"
              --if (!pipe.pspe.:mdsaustshld.trim().matchwild('*with*austen*')) then
              if (!bran.pspe.:mdsaustshld.trim().matchwild('*with*austen*')) then

                -- Check the Material Reference of the ATTA Ancillary for STAINLESS STEEL
                -- Stainless Steel Ancillaries DO NOT REQUIRE an AUSTENITIC INLAY PLATE
                !dbf = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref()
                -- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
                -- the matref attribute has been added to atta. Find the correct attribute to use
                -- The variable !matrefAtt will be set to either REF for matref or UDA for :MdsMatref
                !matrefAtt = !!mdsUseMatref(!dbf)
                if (!matrefAtt.eq('UDA')) then
                  if (!dbf.:mdsmatref.:mdsmatgroup.eq('SS')) then
                    --$P *** Skipping... *** MDS INDEPENDANT ATTA $!dbf.name *** AUSTENITIC INLAY PLATE is NOT required ***
                    skip
                  endif
                else
                  if (!dbf.matref.:mdsmatgroup.eq('SS')) then
                    --$P *** Skipping... *** MDS INDEPENDANT ATTA $!dbf.name *** AUSTENITIC INLAY PLATE is NOT required ***
                    skip
                  endif
                endif

                -- *** ADD *** an extra *** VPRM "$P" Part No. record ***
                --!vprmpartplat = !vprmpart
                --!pplt = !vprmpartplat.split(':')
                --if ((!pnum.eq('LIS49')) or (!pnum.eq('LISR49'))) then

                --                if ( (!pnum.eq('LIS49A')) or (!pnum.eq('LISR49A'))or (!pnum.eq('LIS49G')) or (!pnum.eq('LISR49G')) ) then
                --                  --!pmgr = !pplt[7]
                --                  !ppf2 = !pnum & '-IP'
                -- dtf >>> 123.11.05 remove safety class from austenitic plate its not required
                --q var !pmgr
                --$P 3173
                if (!pmgr.matchwild('*-S1')) then
                  !pmgr = !pmgr.before('-S1')
                endif
                -- dtf <<< end of mod
                if (!pnum.eq('LIS40-70TS')) then
                  !ppf2 = !pnum & '-IP' & !pmgr
                else
                  !ppf2 = !pnum & '-IP' & '-' & !pmgr
                endif

                !ppf8 = 'Austenitic Inlay Plate'
                -- Concatenate the NEW "$P" record
                !vprmpartplat =  !pplt[1] & ':' & !ppf2 & ':' & !pplt[3] & ':' & !pplt[4] & ':' & !pplt[5] & ':' & !pplt[6] & ':' & !pplt[7] & ':' & !ppf8  & ':' & !pplt[9]
                !vprmrecords.append(!vprmpartplat)

                -- *** ADD *** an extra *** VPRM "$T" Tag No. record ***
                !vprmtagplat = !vprmtag
                !tplt = !vprmtagplat.split(':')

                if (!pnum.eq('LIS40-70TS')) then
                  !tnum = !tplt[2].before('-TS')
                  !tmgr = !tplt[2].after('-TS')
                else
                  !tnum = !tplt[2].before('-')
                  !tmgr = !tplt[2].after('-')
                endif

                --if ( (!pnum.eq('LIS49A')) or (!pnum.eq('LISR49A'))or (!pnum.eq('LIS49G')) or (!pnum.eq('LISR49G')) ) then
                --!tpf2 = !tnum & '-IP'
                --else
                -- dtf >>> 123.11.05 remove safety class from austenitic plate its not required
                --q var !tmgr
                --$P 3206
                if (!tmgr.matchwild('*-S1')) then
                  !tmgr = !tmgr.before('-S1')
                endif
                -- dtf <<< end of mod
                if (!pnum.eq('LIS40-70TS')) then
                  !tpf2 = !tnum & '-TS-IP' & !tmgr
                else
                  !tpf2 = !tnum & '-IP' & '-' & !tmgr
                endif
                --endif

                !tpf4 = '*'
                -- Concatenate the NEW "$T" record
                !vprmtagplat =!tplt[1] & ':' & !tpf2 & ':' & !tpf2 & ':' & !tpf4
                !vprmrecords.append(!vprmtagplat)

                -- *** ADD *** an extra *** VPRM "$C" Component record ***
                !vprmcompplat = !vprmcomp
                !cplt = !vprmcompplat.split(':')
                !cpf7 = !ppf2
                !cpf8 = !tpf2
                if ((!cpf8.matchwild('49*')) or (!cpf8.matchwild('R49*'))) then
                  -- TWO Austenitic Inlay Plates required per Ancillary for types '49*' and 'R49*'
                  !xnum = !cplt[9]
                  !cpf9 = (2 * !xnum.real())
                else
                  !cpf9 = !cplt[9].real()
                endif

                -- Concatenate the NEW "$C" record
                !vprmcompplat = !cplt[1] & ':' & !cplt[2] & ':' & !cplt[3] & ':' & !cplt[4] & ':' & !cplt[5] & ':' & !cplt[6] & ':' & !cpf7 & ':' & !cpf8 & ':' & !cpf9 & ':' & !cplt[10] & ':' & !cplt[11] & ':' & !cplt[12] & ':' & !cplt[13] & ':' & !cplt[14] & ':' & !cplt[15] & ':' & !cplt[16] & ':' & !cplt[17] & ':' & !cplt[18] & ':' & !cplt[19] & ':' & !cplt[20] & ':' & !cplt[21] & ':' & !cplt[22] & ':' & !cplt[23] & ':' & !cplt[24]
                !vprmrecords.append(!vprmcompplat)
              endif
            endif
            -------------------------------------------------------------------------------------------------------------

          enddo

        endif

      endif

      --<nb>jun2007  HPD0035322/OP47  (Generate Support component record)
      if (!!mdshangif.trim().upcase().neq('MDS')) then
        !vprmrecords.appendarray(!vprmlinearray)
        !sf2 = '04'
        !vprmsubunit = !sf1 & ':' & !sf2 & ':' & !sf3 & ':' & !sf4 & ':' & !sf5 & ':' & !sf6 & ':' & !sf7 & ':*'
        !vprmrecords.append(!vprmsubunit)
        !vprmpart = !mdsvprmobj.vprmpart('SUPP',!indx,!mdsvprmobj)
        !vprmtag  = !mdsvprmobj.vprmtag('SUPP',!indx,!mdsvprmobj)
        !vprmrecords.append(!vprmtag)
        !vprmcomp = !mdsvprmobj.vprmcomp('SUPP',!indx,!mdsvprmobj,!vprmpart,!vprmtag)
        !vprmrecords.append(!vprmcomp)
      endif
    endif
    ---------------------------------------------------------------------------------------------------

    -- ***************************************************************************
    -- *** CHECK HERE for BULK or ACTUAL MTO and REJECT MDS SUPPORT MTO etc... ***
    -- ***************************************************************************
    -- Return the Array
    return !vprmrecords

  endmethod

  -------------------------------------------------------------------------------
  -------------------------------------------------------------------------------

  -- Method:      .vprmpart
  --
  -- Determine the MDS to VPRM MTO File Input PART NUMBER Record for Each MDS Support Object
  --
  --
  define method .vprmpart(!type is STRING,!indx is REAL,!mdsvprmobj is MDSVPRMMTO) is STRING
    -- "$P" -- Concatenate the MDS Support PART NUMBER Record <8 fields>
    --
    -- Determine the PART NUMBER Records
    if (!type.eq('ATTA')) then
      -------------------------------------------------
      -- MDS ANCILLARY ATTA Components
      !pf1 = '$P'

      !dbf = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref()
      !stp = !dbf.stype
      !pqc = !mdsvprmobj.qualityclass.after('QC')
      if (!pqc.eq('')) then
        !pqc = 'unset'
      endif
      -- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
      -- the matref attribute has been added to atta. Find the correct attribute to use
      -- The variable !matrefAtt will be set to either REF for matref or UDA for :MdsMatref
      !matrefAtt = !!mdsUseMatref(!dbf)
      if (!matrefAtt.eq('UDA')) then
        !pmg = !dbf.:mdsmatref.:mdsmatgroup
        handle ANY
          !pmg = 'unset'
        endhandle
      else
        !pmg = !dbf.matref.:mdsmatgroup
        handle ANY
          !pmg = 'unset'
        endhandle
      endif
      if (!pmg.eq('')) then
        !pmg = 'unset'
      endif

      -- Some Ancillaries require their LISEGA PART No. -- e.g. "LIS49" instead of the CODE stored in the variable "!!code$!<stp>"
      !spn = !dbf.prop.code
      --if ((!spn.matchwild('40????FL')) or (!spn.matchwild('R40????FL'))) then
      --  !pf2 = 'LIS40FL'
      --elseif ((!spn.matchwild('40????FP')) or (!spn.matchwild('R40????FP'))) then
      --  !pf2 = 'LIS40FP'
      --elseif ((!spn.matchwild('40*')) or (!spn.matchwild('R40*'))) then
      --  !pf2 = 'LIS40'
      if ((!spn.matchwild('40??70-LG')) or (!spn.matchwild('R40??70-LG'))) then
        !pf2 = 'LIS40-70LG'

      elseif ((!spn.matchwild('40??80-LG')) or (!spn.matchwild('R40??80-LG'))) then
        !pf2 = 'LIS40-80LG'

      elseif ((!spn.matchwild('40??70-TS')) or (!spn.matchwild('R40??70-TS'))) then
        !pf2 = 'LIS40-70TS'

      elseif ((!spn.matchwild('40??80-TS')) or (!spn.matchwild('R40??80-TS'))) then
        !pf2 = 'LIS40-80TS'

      elseif ((!spn.matchwild('40??88P')) or (!spn.matchwild('R40??88P'))) then
        !pf2 = 'LIS40-88P'

      elseif ((!spn.matchwild('40??68')) or (!spn.matchwild('R40??68'))) then
        !pf2 = 'LIS40-68'

      elseif ((!spn.matchwild('49*G2P')) or (!spn.matchwild('R49*G2P'))) then
        !pf2 = 'LIS49G' & '-' & !pmg

        -------------------------------------------------
        --<wd>mar2006
        -- FRAMATOME ANP need an additional Part No. "LIS49L" for the Pipe Clamps AT114 and AT115 (Longitudinal Guide)
        -- Currently FANP have ONLY two seperate Part Nos. "LIS49A"(for pipe clamp AT108*) and "LIS49G"(for pipe clamp AT110).
        -- The Pipe Clamps AT114 and AT115 are currently INCORRECTLY set with Part No. "LIS49A".
        -- This causes mis-matches in the description of the Part No. in VPRM,
        -- because FANP are using TWO different Descriptions:
        -- <1>- "Single-sided Pipe Slide" and <2>- "Longitudinal Guide" for the same Part-No.
      elseif ((!spn.matchwild('49*63SP')) or (!spn.matchwild('R49*63SP'))) then
        !pf2 = 'LIS49L' & '-' & !pmg

      elseif ((!spn.matchwild('49*63G3')) or (!spn.matchwild('R49*63G3'))) then
        !pf2 = 'LIS49L' & '-' & !pmg
        --<wd>mar2006
        -------------------------------------------------

      elseif ((!spn.matchwild('49*')) or (!spn.matchwild('R49*'))) then
        !pf2 = 'LIS49A' & '-' & !pmg

      else
        -- ALL other Ancillary PART Nos.
        --!pf2 = !!code$!<stp> & '-' & !pqc & '-' & !pmg
        -- Quality Class removed for MDS Ancillary ATTAS ONLY, as per FANP<W.Umnig> request <19th/April/2005>

        !mdsdeftypeArr = object ARRAY()
        !mdsdeftypeArr.append('STRUCTURE')
        !mdsdeftypeArr.append('ATTA')
        !mdsdeftypeArr.append('HANGER')
        !mdsdeftypeArr.append('TRUNNION')
        !mdsdeftypeArr.append('PRELIMINARY')

        do !mdsdeftype values !mdsdeftypeArr
          !code = !!mdsgetdefprop(!mdsdeftype, !stp , 'CCOD')
          if ((!code.neq(|ERROR|))) then
            -- Use the AVEVA MDS STANDARD NAME
            break
          endif
        enddo

        if ((!code.eq(|ERROR|)) or (!code.trim().eq(||))) then
          -- Use the AVEVA MDS STANDARD NAME
          !code = !stp
        endif

        --!pf2 = !!code$!<stp> & '-' & !pmg
        !pf2 = !code & '-' & !pmg

      endif

      -- >>> dtf 17.11.05 mod to add SAFTEY CLASS if PIPE QUALITY CLASS is QC1
      !pf2 = !mdsvprmobj.setsafetyclass(!type, !dbf, !pf2, !mdsvprmobj)
      if (!pf2.eq('ERROR')) then
        return 'ERROR'
      endif
      -- <<< end of Mod

      -------------------------------------------------
      -- MDS Bulk MTO to REJECT MDS Support Component if Ancillary<ATTA> Material<:mdsmatref> and/or Material Group<:mdsmatgroup of Material> is 'unset'
      if (!pmg.lowcase().eq('unset')) then
        !errorcomp = !dbf.fullname
        -- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
        -- the matref attribute has been added to atta. Find the correct attribute to use
        -- The variable !matrefAtt will be set to either REF for matref or UDA for :MdsMatref
        !matrefAtt = !!mdsUseMatref(!dbf)
        if (!matrefAtt.eq('UDA')) then
          !dbfmatref = !dbf.:mdsmatref
          if (!dbfmatref.string().lowcase().eq('unset')) then
            !errortype = 'Material Reference<:mdsmatref> is *unset*'
          else
            !errortype = 'Material Group<:mdsmatgroup> or
            the Safety Class of MDS Support can not be determined'
          endif
        else
          !dbfmatref = !dbf.matref
          if (!dbfmatref.string().lowcase().eq('unset')) then
            !errortype = 'Material Reference<matref> is *unset*'
          else
            !errortype = 'Material Group<:mdsmatgroup> or
            the Safety Class of MDS Support can not be determined'
          endif
        endif
        !mdsvprmobj.errorarray.append(' ERROR -- MDS Support ATTA Component $!errorcomp $!errortype')
        !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')
        -- Return 'ERROR' for the MDS Component PART No.
        return 'ERROR'
      endif
      -------------------------------------------------

      --!pf3 = 'OFF'
      !pf3 = 'PCS'

      !pf4 = 'ANCILLARY'

      !shop = !dbf.shop
      if (!shop) then
        !pf5 = 1
      else
        !pf5 = 3
      endif

      !pf6 = 'N2'

      !pf7 = !pmg

      --!pf8 = !mdsvprmobj.attamemb[3][!indx].trim('M',' ').trim()

      -- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
      -- the matref attribute has been added to atta. Find the correct attribute to use
      -- The variable !matrefAtt will be set to either REF for matref or UDA for :MdsMatref
      !matrefAtt = !!mdsUseMatref(!dbf)
      if (!matrefAtt.eq('UDA')) then
        !mat = !dbf.:mdsmatref.description
      else
        !mat = !dbf.matref.description
      endif

      !mdsdeftypeArr = object ARRAY()
      !mdsdeftypeArr.append('STRUCTURE')
      !mdsdeftypeArr.append('ATTA')
      !mdsdeftypeArr.append('HANGER')
      !mdsdeftypeArr.append('TRUNNION')
      !mdsdeftypeArr.append('PRELIMINARY')

      do !mdsdeftype values !mdsdeftypeArr
        !desc = !!mdsgetdefprop(!mdsdeftype, !stp , 'DESC')
        if ((!desc.neq(|ERROR|))) then
          -- Use the AVEVA MDS STANDARD NAME
          break
        endif
      enddo

      if ((!code.eq(|ERROR|)) or (!code.trim().eq(||))) then
        -- Use the AVEVA MDS STANDARD NAME
        !desc = ''
      endif

      !pf8 = !desc.after('-').after('-').trim('M',' ').before('(').trim() & ' ' & !mat

      --!pf9 = !dbf.prop.weig
      --handle ANY
      !pf9 = ''
      --endhandle

      --!vprmpart = !pf1 & ':' & !pf2 & ':' & !pf3 & ':' & !pf4 & ':' & !pf5 & ':' & !pf6 & ':' & !pf7 & ':' & !pf8 & '*'
      !vprmpart = !pf1 & ':' & !pf2 & ':' & !pf3 & ':' & !pf4 & ':' & !pf5 & ':' & !pf6 & ':' & !pf7 & ':' & !pf8 & ':' &!pf9 &'*'
      return !vprmpart


    elseif (!type.eq('STRU')) then
      -------------------------------------------------
      -- MDS STRUCTURE Components
      !pf1 = '$P'
      !dbf = !mdsvprmobj.strumemb[2][!mdsvprmobj.strumemb[5][!indx][1]].dbref()
      !stp = !dbf.type

      if (!stp.eq('SCTN')) then

        -------------------------------------------------------------------------------
        --<wd>sep2005
        -- Get the GTYP of the SCTN element
        !gtp = !dbf.gtype
        if (!gtp.neq('PLAT')) then
          -- Proceed as BEFORE for a STRUCTURAL "SCTN" element
          --<wd>sep2005
          -------------------------------------------------------------------------------

          -------------------------------------------------
          -- Set !zlen to '0' for all SCTNS -- required as a string argument in !this object methods ".matgroup" and ".mtestsheet" below
          !zlen = '0'
          -- Check if the QUALITY CLASS(QC) for the Highest QC Pipe on the Support is SET
          !pqc = !mdsvprmobj.qualityclass.after('QC')
          if (!pqc.eq('')) then
            !pqc = 'unset'
          endif

          -------------------------------------------------
          -- Test the SCTN function attribute for "Q" Type SCTN Components
          !qtp = FALSE
          !fnc = !dbf.function
          if (!fnc.matchwild('Q*')) then

            --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q2P" SCTN type added
            --if (!fnc.matchwild('Q2-?').not()) then
            if ((!fnc.matchwild('Q2-?').not()) and  (!fnc.matchwild('Q2P-?').not())) then
              --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update

              --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update
              -- DO NOT PROCESS the 2nd SCTN for a "Q3O" or "Q5O" SCTN type as a SCTN of this Q type, i.e. TREAT as a NORMAL SCTN
              --q var !dbf.name !fnc !dbf.jois.spref
              if ((!fnc.matchwild('Q3O-?').not()) or (!fnc.matchwild('Q5O-?').not()) and !dbf.jois.spref.set()) then
                --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update

                -- MDS VPRM MTO To REJECT MDS Support Component if Pipe<s> Quality Class is 'unset'
                if (!pqc.lowcase().eq('unset')) then
                  !errorcomp = !dbf.fullname
                  !errortype = 'Quality Class of Supported Pipe<s> is *unset*'
                  !mdsvprmobj.errorarray.append(' ERROR -- MDS Support SCTN component $!errorcomp $!errortype')
                  !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')

                  -- Return 'ERROR' for the MDS Component Part No.
                  return 'ERROR'
                endif

                ---------------------------------------------------------------------------------------------------
                -- VPRM requires a Material Group for MTO input
                -- But FANP do NOT want any MATERIAL or MTS set against these SCTNS etc...
                --           !mat = !dbf.matref
                --           handle ANY
                --             !mat = ''
                --           endhandle
                --           !pmg = !this.matgroup(!mdsvprmobj,!mat,!stp,!zlen)
                --           if (!pmg.eq('')) then
                -- FANP VPRM MATERIAL GROUP required to run MDS "Q" type SCTNS successfully into VPRM
                -- When NO MATERIAL is set at the "Q" type SCTN in MDS DESIGN, VPRM could have a default setting of "QZ" for the MATERIAL GROUP set in VPRM
                -- When the MATERIAL GROUP !pmg ='', VPRM will NOT accept the "Q" type SCTN
                --             --!pmg = 'QZ'
                --             !pmg =''
                --           endif

                --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q2P" SCTN type added
                -- ALL "Q" type SCTNS except "Q2-?" and "Q2P-?" types will now have the MATERIAL GROUP HARD CODED to "QZ"
                !pmg = 'QZ'
                ---------------------------------------------------------------------------------------------------

                -- SCTN is a "Q" type SCTN
                !qtp = TRUE

                --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q3N*","Q3O*","Q3P*","Q4N","Q4P*","Q5O" SCTN types added
                -- Determine if SCTN function attribute matches "Q3-*", "Q3M-*", "Q4-*","Q4M-*","Q3N*","Q3O*","Q3P*","Q4N","Q4P*","Q5O"
                -- and set the PART No. to show ONLY the QUALITY CLASS but without the "Material and/or MTS/Material Group" Identifiers
                -- **********************
                -- *** IMPORTANT NOTE ***
                --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q2P" SCTN type added
                -- ALL "Q2-*" and "Q2P-*" type SCTNs are IGNORED as these are treated the same as ALL OTHER SCTNS for FANP
                -- **********************
                if ((!fnc.matchwild('Q3M-?')) or (!fnc.matchwild('Q4M-?'))) then
                  --!pf2 = !fnc $* ONLY TEMPORARY
                  !pfx = !fnc.before('M-')
                  !psx = '_M' & '-' & !pqc
                  !pf2 = !pfx & !psx

                elseif ((!fnc.matchwild('Q3-?')) or (!fnc.matchwild('Q4-?'))) then
                  --!pf2 = !fnc $* ONLY TEMPORARY
                  !pfx = !fnc.before('-')
                  !psx = '-' & !pqc
                  !pf2 = !pfx & '_' & !psx

                  --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q3N*","Q3O*","Q3P*","Q4N","Q4P*","Q5O" SCTN types added
                elseif ((!fnc.matchwild('Q3N-?')) or (!fnc.matchwild('Q4N-?'))) then
                  !pfx = !fnc.before('N-')
                  !psx = '_N' & '-' & !pqc
                  !pf2 = !pfx & !psx

                elseif ((!fnc.matchwild('Q3P-?')) or (!fnc.matchwild('Q4P-?'))) then
                  !pfx = !fnc.before('P-')
                  !psx = '_P' & '-' & !pqc
                  !pf2 = !pfx & !psx

                elseif ((!fnc.matchwild('Q3O-?')) or (!fnc.matchwild('Q5O-?'))) then
                  !pfx = !fnc.before('O-')
                  !psx = '_O' & '-' & !pqc
                  !pf2 = !pfx & !psx
                  --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q3N*","Q3O*","Q3P*","Q4N","Q4P*","Q5O" SCTN types added

                endif

                -- DO NOT PROCESS the 2nd SCTN for a "Q3O" or "Q5O" SCTN type as a SCTN of this Q type, i.e. TREAT as a NORMAL SCTN
                --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update
                --q var !dbf.name !fnc !dbf.jois.spref
              endif
              --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update

            endif
          endif

          -- Process All other FANP SCTN Components except "Q" types
          !szt = !dbf.catref.:mdssizetag
          -- Remove 3rd Character from !szt for the PART No. because it represents the SIZE of the SCTN
          -- This ONLY applies to MDS "PIPE" Supports, which use their own Piping Discipline "STEELWORK Catalogue"
          !xcb = !szt.substring(1,2)
          !xca = !szt.substring(4)
          !mat = !dbf.matref
          !matdesc = !mat.description
          handle ANY
            !matdesc = 'unset'
          endhandle

          -- Process All other FANP SCTN Components except "Q" types
          if (!qtp.not()) then
            --!pqc = !mdsvprmobj.qualityclass.after('QC')
            --if (!pqc.eq('')) then
            --!pqc = 'unset'
            --endif
            !pmg = !this.matgroup(!mdsvprmobj,!mat,!stp,!zlen)
            if (!pmg.eq('')) then
              !pmg = 'unset'
            endif
            -- >> dtf 20.06.06 Mod to  Set MTSgroup for stainless steel X1-SCTN
            --$P  ************* mtsgroup for vprmpart
            --            q var !pmg
            if (!matdesc.eq('1.4571') and !szt.substring(1,2).eq('X1')) then
              !pmg = !mat.:MdsMatgroup.part(7,|\|)
            endif
            --            q var !pmg
            -->>dtf end

            --!pf2 = !xcb & '_' & !xca & '-' & !mdsvprmobj.qualityclass & '-' & !matname & '-' & !mts
            --<wd>nov2005
            --!pf2 = !xcb & '_' & !xca & '-' & !pqc & '-' & !pmg
            if (!mdsvprmobj.mdspipetype.eq('PIPE')) then
              -- Remove 3rd Character from !szt for the PART No.because it represents SIZE of the SCTN
              -- Piping Discipline "STEELWORK Catalogue ONLY"
              !pf2 = !xcb & '_' & !xca & '-' & !pqc & '-' & !pmg

            elseif (!mdsvprmobj.mdspipetype.eq('HVAC')) then
              -- Output !szt in FULL for "NATIONAL STANDARD STEELWORK Catalogues", e.g. "DIN", "AISC", "BS" etc...
              !pf2 = !szt & '-' & !pqc & '-' & !pmg
            elseif (!mdsvprmobj.mdspipetype.eq('TRAY')) then
              -- Output !szt in FULL for "NATIONAL STANDARD STEELWORK Catalogues", e.g. "DIN", "AISC", "BS" etc...
              !pf2 = !szt & '-' & !pqc & '-' & !pmg
            endif
            --<wd>nov2005


            -- MDS VPRM MTO To REJECT MDS Support Component if Material<matref> or Material Group<:mdsmatgroup Of Material> or Pipe<s> Quality Class is 'unset'
            if ((!pmg.lowcase().eq('unset')) or (!pqc.lowcase().eq('unset'))) then
              !errorcomp = !dbf.fullname
              if (!pmg.lowcase().eq('unset')) then
                !dbfmatref = !dbf.matref
                if (!dbfmatref.string().lowcase().eq('unset')) then
                  !errortype = 'Material Reference<matref> is *unset*'
                else
                  !errortype = 'Material Group<:mdsmatgroup> or
                  the Safety Class of MDS Support can not be determined'
                endif
              elseif (!pqc.lowcase().eq('unset')) then
                !errortype = 'Quality Class of Supported Pipe<s> is *unset*'
              endif
              !mdsvprmobj.errorarray.append(' ERROR -- MDS Support SCTN component $!errorcomp $!errortype')
              !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')
              -- Return 'ERROR' for the MDS Component Part No.
              return 'ERROR'
            endif
          endif

          --!pf3 = 'M'
          if (!qtp) then
            !pf3 = 'PCS'
          else
            !pf3 = 'M'
          endif

          !pf4 = 'STEELWORK'
          !shop = !dbf.shop
          if (!shop) then
            !pf5 = 1
          else
            !pf5 = 3
          endif
          !pf6 = 'N1'

          --!pf7 = !dbf.matref.:mdsmatcode
          --!pf7 = !mat.namn
          --handle ANY
          --  !pf7 = 'unset'
          --endhandle
          --!pf7 = ''
          --!pf7 = !pmg
          --!mts = !this.mtestsheet(!mdsvprmobj,!mat,!stp)
          --!pf8 = !mdsvprmobj.strumemb[3][!indx].before(')').trim('M',' ').trim() & ')'
          --!pf8 = !matdesc & ' MTS' & !mts
          --!pf8 = 'Material ' & !matdesc & ' with MTS ' & !mts & ';'

          if (!qtp) then
            --!pf7 = ''
            !pf7 = !pmg
            !pf8 = ''

          else
            !pf7 = !pmg
            !mts = !this.mtestsheet(!mdsvprmobj,!mat,!stp,!zlen)

            -- >> dtf 20.06.06 Mod to  Set MTS for stainless steel X1-SCTN
            --$P ***************** mts in vprmpart
            --            q var !mts
            if (!matdesc.eq('1.4571') and !szt.substring(1,2).eq('X1')) then
              !mts = !mat.:MdsMts.part(7,|\|)
            endif
            --            q var !mts
            -->>dtf end

            !pf8 = 'Material ' & !matdesc & ' with MTS ' & !mts & ';'

          endif

          !pf9 =''
          --!pf9 = !dbf.prop.uwig

          -------------------------------------------------------------------------------
          --<wd>sep2005
        elseif (!gtp.eq('PLAT')) then
          -- Although it is a "SCTN" element, treat it as a "PLATE" element, as per the FRAMATOME request.
          -- This currently ONLY applies to the FRAMATOME MDS template "FANP14"<alias FT17>

          -- All STRUCTURAL "SCTN" PLATE type components
          !area = FALSE
          !sfx  = '-C'
          if (defined(!!novprmtag)) then
            if (!!novprmtag.trim().eq('')) then
              -- PLATE AREA "$P" Record required
              !area = TRUE
              !sfx = ''
            endif
          endif

          -- Plate Thickness etc..
          !zlen = !dbf.prop.dept
          handle ANY
            !zlen ='0'
          elsehandle NONE
            if (!zlen.real().lt(10)) then
              -- Add a Preceding '0'<zero> character on any PLATE thickness less than 10
              !zlen = '0' & !zlen
            endif
          endhandle

          !mat = !dbf.matref
          handle ANY
            !mat = 'unset'
          endhandle
          !matdesc = !mat.description
          handle ANY
            !matdesc = 'unset'
          endhandle

          !pqc = !mdsvprmobj.qualityclass.after('QC')
          if (!pqc.eq('')) then
            !pqc = 'unset'
          endif

          -- Although element type is a SCTN, VPRM will treat this element as a PLATE
          -- because this SCTN element has a the GTYP of PLAT, as per FRAMATOME request.
          -- Therefore "!stp" is replaced by "!gtp" in the method calls for "!pmg" and !mts"
          -- shown below:-
          --          !pmg = !this.matgroup(!mdsvprmobj,!mat,!stp,!zlen)
          !pmg = !this.matgroup(!mdsvprmobj,!mat,!gtp,!zlen)
          if (!pmg.eq('')) then
            !pmg = 'unset'
          endif
          --!mts = !this.mtestsheet(!mdsvprmobj,!mat,!stp,!zlen)
          !mts = !this.mtestsheet(!mdsvprmobj,!mat,!gtp,!zlen)
          !pf2 = 'PLATE' & !zlen & '-' & !pqc & '-' & !pmg & !sfx
          --$P **** !dbf.name ********
          --q var !dbf.name
          --$P+++++++++++++++++++

          -- MDS Bulk MTO To REJECT MDS Support Component if the PROPERTY DKEY "DESC" causes an error
          -- Check if the PROPERTY DKEY "DESC" is SET or if it can be EVALUATED<it may contain a Property Evaluation>
          !desc = !dbf.prop.desc
          handle ANY
            !desc = ''
            !errorcomp = !dbf.fullname
            !errortype = 'Property Dkey<DESC> cannot be evaluated or does not exist'
            !mdsvprmobj.errorarray.append(' ERROR -- MDS Support PLATE component $!errorcomp $!errortype')
            !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')
            -- Return 'ERROR' for the MDS Component Part No.
            return 'ERROR'
          endhandle

          -- MDS Bulk MTO To REJECT MDS Support Component if Material<matref> or Material Group<:mdsmatgroup Of Material> or Pipe<s> Quality Class Is 'unset'
          if ((!pmg.lowcase().eq('unset')) or (!pqc.lowcase().eq('unset'))) then
            !errorcomp = !dbf.fullname
            if (!pmg.lowcase().eq('unset')) then
              !dbfmatref = !dbf.matref
              if (!dbfmatref.string().lowcase().eq('unset')) then
                !errortype = 'Material Reference<matref> is *unset*'
              else
                !errortype = 'Material Group<:mdsmatgroup> or
                the Safety Class of MDS Support can not be determined'
              endif
            elseif (!pqc.lowcase().eq('unset')) then
              !errortype = 'Quality Class of Supported Pipe<s> is *unset*'
            endif
            !mdsvprmobj.errorarray.append(' ERROR -- MDS Support PLATE component $!errorcomp $!errortype')
            !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')
            -- Return 'ERROR' for the MDS Component Part No.
            return 'ERROR'
          endif

          if (!area) then
            !pf3 = 'SM'
          else
            !pf3 = 'PCS'
          endif

          !pf4 = 'PLATE'

          !shop = !dbf.shop
          if (!shop) then
            !pf5 = 1
          else
            !pf5 = 3
          endif

          !pf6 = 'N4'

          !pf7 = !pmg

          --!pf8 = !dbf.dtxr & 'mm; Material ' & !matdesc & ' with MTS ' & !mts
          !pf8 = !desc & 'mm; Material ' & !matdesc & ' with MTS ' & !mts

          if (!area) then
            -- For PLATE AREA type record -- Weight to be output in "kg/m2"
            -- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
            -- the matref attribute has been added to atta. Find the correct attribute to use
            -- The variable !matrefAtt will be set to either REF for matref or UDA for :MdsMatref
            !matrefAtt = !!mdsUseMatref(!dbf)
            if (!matrefAtt.eq('UDA')) then
              !matdens = density of sden 1 of tden 1 of :mdsmatref of $!dbf
              handle ANY
                !matdens = 7850 / 1000
              elsehandle NONE
                !matdens = !matdens / 1000
              endhandle
            else
              !matdens = density of sden 1 of tden 1 of matref of $!dbf
              handle ANY
                !matdens = 7850 / 1000
              elsehandle NONE
                !matdens = !matdens / 1000
              endhandle
            endif
            !rpf9 = (!matdens * !zlen.real())
            !pf9  = !rpf9.string('d2')
          else
            -- Weight NOT Required on a Normal Component "$P" PLATE record
            !pf9 = ''
          endif

        endif
        --<wd>sep2005
        -------------------------------------------------------------------------------

        --!vprmpart = !pf1 & ':' & !pf2 & ':' & !pf3 & ':' & !pf4 & ':' & !pf5 & ':' & !pf6 & ':' & !pf7 & ':' & !pf8 & '*'
        !vprmpart = !pf1 & ':' & !pf2 & ':' & !pf3 & ':' & !pf4 & ':' & !pf5 & ':' & !pf6 & ':' & !pf7 & ':' & !pf8 & ':' & !pf9 & '*'
        return !vprmpart

      elseif ((!stp.eq('PJOI')) or (!stp.eq('SJOI')) or (!stp.eq('FITT'))) then
        -------------------------------------------------------------------------------

        -- FANP Building Attachments are SJOI Assemblies and to be treated as SINGLE ITEMS and NOT as PLATE items
        -- Therefore DO NOT output AN "AREA" record for these SJOI items
        if ((!dbf.type inset ('PJOI','SJOI')) and (!dbf.catre.name.matchwild('*U6*'))) then

          -- FANP Building Attachment PART Nos. to be similar to SCTN components -- Use !zlen ='0' as for SCTNS above
          !zlen = '0'
          !szt = !dbf.catref.name
          !xca = !szt.after('FRA-')
          if (!xca.matchwild('*-END-*')) then
            --!xcb = !xca.before('-') & '-END_'
            !xcb = !xca.before('-END') & '_'

            --<wd>05mar2010 - DUN1233 - Add PART CODE for NEW "U6?_P*" (A & B)Building attachments
          elseif (!xca.matchwild('U6?_P*')) then
            !sze = !xca.after('_P-')
            !xcb = !xca.before('-')
            --<wd>05mar2010 - DUN1233 - Add PART CODE for NEW "U6?_P*" (A & B)Building attachments

          else
            !xcb = !xca.before('-') & '_'
          endif
          --          !mat = !dbf.matref
          --          !matdesc = !mat.description
          --          handle ANY
          --            !matdesc = ''
          --          endhandle

          !pqc = !mdsvprmobj.qualityclass.after('QC')
          if (!pqc.eq('')) then
            !pqc = 'unset'
          endif

          --          !pmg = !this.matgroup(!mdsvprmobj,!mat,!stp, !zlen)
          --          if (!pmg.eq('')) then
          --            !pmg = 'unset'
          --          endif
          !pmg = 'QZ'

          --          !pf2 = !xcb & '-' & !pqc & '-' & !pmg
          !pf2 = !xcb & '-' & !pqc

          -- >>> dtf 17.11.05 Mod to add safety class if Quality class eq 1 'QC1'
          !tqc = !mdsvprmobj.qualityclass.after('QC')

          if (!dbf.catre.name.matchwild('*U6B*') and !tqc.eq('1')) then
            !pf2 = !pf2 & '-S1'
          endif
          -- <<< end of mod
          -- MDS Bulk MTO To REJECT MDS Support Component if Material<matref> or Material Group<:mdsmatgroup Of Material> or Pipe<s> Quality Class Is 'unset'
          if ((!pmg.lowcase().eq('unset')) or (!pqc.lowcase().eq('unset'))) then
            !errorcomp = !dbf.fullname
            if (!pmg.lowcase().eq('unset')) then
              !dbfmatref = !dbf.matref
              if (!dbfmatref.string().lowcase().eq('unset')) then
                !errortype = 'Material Reference<matref> is *unset*'
              else
                !errortype = 'Material Group<:mdsmatgroup> or
                the Safety Class of MDS Support can not be determined'
              endif
            elseif (!pqc.lowcase().eq('unset')) then
              !errortype = 'Quality Class of Supported Pipe<s> is *unset*'
            endif
            !mdsvprmobj.errorarray.append(' ERROR -- MDS Support BUILDING ATTACHMENT component $!errorcomp $!errortype')
            !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')
            -- Return 'ERROR' for the MDS Component Part No.
            return 'ERROR'
          endif

          !pf3 = 'PCS'
          !pf4 = 'STEELWORK'
          !shop = !dbf.shop
          if (!shop) then
            !pf5 = 1
          else
            !pf5 = 3
          endif
          !pf6 = 'N1'

          !pf7 = !pmg

          --!mts = !this.mtestsheet(!mdsvprmobj,!mat,!stp)
          --!pf8 = !matdesc & ' MTS' & !mts
          --!pf8 = 'Material ' & !matdesc & ' with MTS ' & !mts & ';'
          !pf8 = ''

          !pf9 = ''

        else
          --'PJOI', 'SJOI' or 'FITT' elements that are NOT a "*U6*" Building Attachment, i.e.
          -- All STRUCTURAL PLATE type components
          !area = FALSE
          !sfx  = '-C'
          if (defined(!!novprmtag)) then
            if (!!novprmtag.trim().eq('')) then
              -- PLATE AREA "$P" Record required
              !area = TRUE
              !sfx = ''
            endif
          endif

          -- Plate Thickness etc..
          !zlen = !dbf.prop.zlen
          handle ANY
            !zlen ='0'
          elsehandle NONE
            if (!zlen.real().lt(10)) then
              -- Add a Preceding '0'<zero> character on any plate thickness less than 10
              !zlen = '0' & !zlen
            endif
          endhandle

          !mat = !dbf.matref
          handle ANY
            !mat = !dbf.cref.matref
          endhandle
          !matdesc = !mat.description
          handle ANY
            !matdesc = 'unset'
          endhandle
          !pqc = !mdsvprmobj.qualityclass.after('QC')
          if (!pqc.eq('')) then
            !pqc = 'unset'
          endif
          !pmg = !this.matgroup(!mdsvprmobj,!mat,!stp,!zlen)
          if (!pmg.eq('')) then
            !pmg = 'unset'
          endif
          !mts = !this.mtestsheet(!mdsvprmobj,!mat,!stp,!zlen)
          --!pf2  = 'PLATE' & !zlen & '-' & !mdsvprmobj.qualityclass & '-' & !mat.namn & '-' & !mts
          !pf2 = 'PLATE' & !zlen & '-' & !pqc & '-' & !pmg & !sfx
          --$P **** !dbf.name ********
          --q var !dbf.name
          --$P+++++++++++++++++++

          -- MDS Bulk MTO To REJECT MDS Support Component if DETREF or DTXR causes an error
          -- Check if the DTXR attribute is SET or if it can be EVALUATED<it may contain a Property Evaluation>
          !dtxr = !dbf.dtxr
          handle ANY
            !dtxr = ''
            !errorcomp = !dbf.fullname
            !errortype = 'Detail Reference<dtxr> cannot be evaluated or does not exist'
            !mdsvprmobj.errorarray.append(' ERROR -- MDS Support PLATE component $!errorcomp $!errortype')
            !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')
            -- Return 'ERROR' for the MDS Component Part No.
            return 'ERROR'
          endhandle

          -- MDS Bulk MTO To REJECT MDS Support Component if Material<matref> or Material Group<:mdsmatgroup Of Material> or Pipe<s> Quality Class Is 'unset'
          if ((!pmg.lowcase().eq('unset')) or (!pqc.lowcase().eq('unset'))) then
            !errorcomp = !dbf.fullname
            if (!pmg.lowcase().eq('unset')) then
              !dbfmatref = !dbf.matref
              if (!dbfmatref.string().lowcase().eq('unset')) then
                !errortype = 'Material Reference<matref> is *unset*'
              else
                !errortype = 'Material Group<:mdsmatgroup> or
                the Safety Class of MDS Support can not be determined'
              endif
            elseif (!pqc.lowcase().eq('unset')) then
              !errortype = 'Quality Class of Supported Pipe<s> is *unset*'
            endif
            !mdsvprmobj.errorarray.append(' ERROR -- MDS Support PLATE component $!errorcomp $!errortype')
            !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')
            -- Return 'ERROR' for the MDS Component Part No.
            return 'ERROR'
          endif

          if (!area) then
            !pf3 = 'SM'
          else
            --!pf3 = 'OFF'
            !pf3 = 'PCS'
          endif

          --!pf4 = 'STEELWORK'
          !pf4 = 'PLATE'

          !shop = !dbf.shop
          if (!shop) then
            !pf5 = 1
          else
            !pf5 = 3
          endif

          --!pf6 = 'N1'
          !pf6 = 'N4'

          -- --!pf7 = !dbf.matref.:mdsmatcode
          --!pf7 - !mat.namn
          --handle ANY
          --  !pf7 = ''
          --endhandle
          !pf7 = !pmg

          --!pf8 = !mdsvprmobj.strumemb[3][!indx].trim('M',' ').trim()
          --!pf8 = !dbf.dtxr
          --!pf8 = !dbf.dtxr & ' ' & !matdesc & ' MTS' & !mts
          --!pf8 = !dbf.dtxr & ' Material ' & !matdesc & ' with MTS ' & !mts & ';'
          !pf8 = !dbf.dtxr & 'mm; Material ' & !matdesc & ' with MTS ' & !mts

          if (!area) then
            -- For PLATE AREA type record -- Weight to be output in "kg/m2"
            -- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
            -- the matref attribute has been added to atta. Find the correct attribute to use
            -- The variable !matrefAtt will be set to either REF for matref or UDA for :MdsMatref
            !matrefAtt = !!mdsUseMatref(!dbf)
            if (!matrefAtt.eq('UDA')) then
              !matdens = density of sden 1 of tden 1 of :mdsmatref of $!dbf
              handle ANY
                !matdens = 7850 / 1000
              elsehandle NONE
                !matdens = !matdens / 1000
              endhandle
            else
              !matdens = density of sden 1 of tden 1 of matref of $!dbf
              handle ANY
                !matdens = 7850 / 1000
              elsehandle NONE
                !matdens = !matdens / 1000
              endhandle
            endif
            !rpf9 = (!matdens * !zlen.real())
            !pf9  = !rpf9.string('d2')
          else
            --!pf9 = !dbf.prop.weig
            !pf9 = ''
          endif

        endif

        --!vprmpart = !pf1 & ':' & !pf2 & ':' & !pf3 & ':' & !pf4 & ':' & !pf5 & ':' & !pf6 & ':' & !pf7 & ':' & !pf8 & '*'
        !vprmpart = !pf1 & ':' & !pf2 & ':' & !pf3 & ':' & !pf4 & ':' & !pf5 & ':' & !pf6 & ':' & !pf7 & ':' & !pf8 & ':' & !pf9 & '*'
        return !vprmpart

      elseif (!stp.eq('BOX')) then
        -------------------------------------------------
        !area = FALSE
        !sfx  = '-C'
        if (defined(!!novprmtag)) then
          if (!!novprmtag.trim().eq('')) then
            -- PLATE AREA "$P" Record required
            !area = TRUE
            !sfx = ''
          endif
        endif

        -- Plate Thickness etc..
        --<wd>mar2006
        --        !zlen = !dbf.zlen
        !zlenreal = !dbf.zlen
        --<wd>mar2006
        handle ANY
          !zlen ='0'
        elsehandle NONE

          --<wd>mar2006
          !zlen = !zlenreal.string()
          --<wd>mar2006
          if (!zlen.real().lt(10)) then
            -- Add a Preceding '0'<zero> character on any plate thickness less than 10
            !zlen = '0' & !zlen
          endif
        endhandle
        !matrefAtt = !!mdsUseMatref(!dbf)
        if (!matrefAtt.eq('UDA')) then
          !mat = !dbf.matref
          handle ANY
            !mat = !dbf.:mdsmatref
            handle ANY
              !mat = 'unset'
            endhandle
          endhandle
        else
          !mat = !dbf.matref
          handle ANY
            !mat = !dbf.matref
            handle ANY
              !mat = 'unset'
            endhandle
          endhandle
        endif

        !matdesc = !mat.description
        handle ANY
          !matdesc = 'unset'
        endhandle
        !pqc = !mdsvprmobj.qualityclass.after('QC')
        if (!pqc.eq('')) then
          !pqc = 'unset'
        endif
        !pmg = !this.matgroup(!mdsvprmobj,!mat,!stp,!zlen.string())
        if (!pmg.eq('')) then
          !pmg = 'unset'
        endif
        !mts  = !this.mtestsheet(!mdsvprmobj,!mat,!stp,!zlen.string())
        --!pf2  = 'PLATE' & !zlen & '-' & !mdsvprmobj.qualityclass & '-' & !mat.namn & '-' & !mts
        !pf2  = 'PLATE' & !zlen & '-' & !pqc & '-' & !pmg & !sfx

        -------------------------------------------------
        -- MDS Bulk MTO To REJECT MDS Support Component if Material<:mdsmatref> or Material Group<:mdsmatgroup Of Material> or Pipe<s> Quality Class is 'unset'
        if ((!pmg.lowcase().eq('unset')) or (!pqc.lowcase().eq('unset'))) then
          !errorcomp = !dbf.fullname
          if (!pmg.lowcase().eq('unset')) then
            -- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
            -- the matref attribute has been added to atta. Find the correct attribute to use
            -- The variable !matrefAtt will be set to either REF for matref or UDA for :MdsMatref
            !matrefAtt = !!mdsUseMatref(!dbf)
            -- If the :mdsmatref is set use the description
            if (!matrefAtt.eq('UDA')) then
              !dbfmatref = !dbf.:mdsmatref
              if (!dbfmatref.string().lowcase().eq('unset')) then
                !errortype = 'Material Reference<:mdsmatref> is *unset*'
              else
                !errortype = 'Material Group<:mdsmatgroup> or
                the Safety Class of MDS Support can not be determined'
              endif
            else
              !dbfmatref = !dbf.matref
              if (!dbfmatref.string().lowcase().eq('unset')) then
                !errortype = 'Material Reference<matref> is *unset*'
              else
                !errortype = 'Material Group<:mdsmatgroup> or
                the Safety Class of MDS Support can not be determined'
              endif
            endif
          elseif (!pqc.lowcase().eq('unset')) then
            !errortype = 'Quality Class of Supported Pipe<s> is *unset*'
          endif
          !mdsvprmobj.errorarray.append(' ERROR -- MDS Support PLATE component $!errorcomp $!errortype')
          !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')
          -- Return 'ERROR' for the MDS Component Part No.
          return 'ERROR'
        endif
        -------------------------------------------------

        if (!area) then
          !pf3 = 'SM'
        else
          --!pf3 = 'OFF'
          !pf3 = 'PCS'
        endif

        --!pf4 = 'STEELWORK'
        !pf4 = 'PLATE'

        !shop = !dbf.owner.shop
        if (!shop) then
          !pf5 = 1
        else
          !pf5 = 3
        endif

        --!pf6 = 'N1'
        !pf6 = 'N4'

        -- --!pf7 = !dbf.:mdsmatref.:mdsmatcode
        --!pf7 = !mat.namn
        --handle ANY
        --  !pf7 = ''
        --endhandle
        !pf7 = !pmg

        --!pf8 = !mdsvprmobj.strumemb[3][!indx].trim('M',' ').trim()
        --!pf8 = 'Plate t=' & !zlen & ' ' & !matdesc & ' MTS' & !mts
        --!pf8 = 'Plate t=' & !zlen & ' Material ' & !matdesc & ' with MTS ' & !mts & ';'
        --!pf8 = 'Plate t=' & ';' & !zlen & ' Material ' & !matdesc & ' with MTS ' & !mts & ';'
        !pf8 = 'Plate t=' & !zlen & 'mm;' & ' Material ' & !matdesc & ' with MTS ' & !mts

        if (!area) then
          -- For PLATE AREA type record -- Weight to be output in kg/m2

          !matrefAtt = !!mdsUseMatref(!dbf)
          if (!matrefAtt.eq('UDA')) then
            !matdens = density of sden 1 of tden 1 of :mdsmatref of $!dbf
            -- Get the "kg/m2" Weight for "1mm thick plate"
            handle ANY
              !matdens = 7850 / 1000
            elsehandle NONE
              !matdens = !matdens / 1000
            endhandle
          else
            !matdens = density of sden 1 of tden 1 of matref of $!dbf
            -- Get the "kg/m2" Weight for "1mm thick plate"
            handle ANY
              !matdens = 7850 / 1000
            elsehandle NONE
              !matdens = !matdens / 1000
            endhandle
          endif
          -- Output Weight for the Correct Plate Thickness i.e. !zlen
          !rpf9 = (!matdens * !zlen.real())
          !pf9  = !rpf9.string('d2')
        else
          --!matdens = density of sden 1 of tden 1 of :mdsmatref of $!dbf
          --handle ANY
          --  !matdens = 7850
          --endhandle
          --!nvol = nvol of $!dbf
          --!wei = (!nvol.real() * !matdens) / 1000 / 1000 / 1000
          --!wei = !wei * !!mdsweiunit.real()
          --!pf9 = !wei

          --!pf9 = !dbf.prop.weig
          !pf9 = ''
        endif

        --!vprmpart = !pf1 & ':' & !pf2 & ':' & !pf3 & ':' & !pf4 & ':' & !pf5 & ':' & !pf6 & ':' & !pf7 & ':' & !pf8 & '*'
        !vprmpart = !pf1 & ':' & !pf2 & ':' & !pf3 & ':' & !pf4 & ':' & !pf5 & ':' & !pf6 & ':' & !pf7 & ':' & !pf8 & ':' & !pf9 & '*'
        return !vprmpart

      endif

    elseif (!type.eq('HANG')) then
      -------------------------------------------------
      -- MDS HANGER Components
      !pf1 = '$P'

      !dbf = !mdsvprmobj.hangmemb[2][!mdsvprmobj.hangmemb[5][!indx][1]].dbref()
      !stp = !dbf.stype
      !typ = !dbf.type
      !spn = !dbf.spre.name
      !partpf4 = TRUE
      !partpf8 = TRUE
      !partpf9 = TRUE
      --q var !spn
      -- Determine the PART number for -- Different Types of Lisega CATALOGUE Components
      if ((!spn.part(3, '/').matchwild('T*' ))or (!spn.part(3, '/').matchwild('V*' ))) then
        -- LISEGA ANCILLARY Component
        -- Remove the PIPE SIZE character, i.e. Character number 3 and replace with an underscore '_'
        !pf2 = !spn.part(3, '/').substring(1,2) & '_' & !spn.part(3, '/').substring(4)

      elseif ((!spn.part(3, '/').matchwild('RT*')) or (!spn.part(3, '/').matchwild('RV*'))) then
        -- LISEGA ANCILLARY Component in REACTOR Building
        -- Remove the PIPE SIZE character, i.e. Character number 4 and replace with an underscore '_'
        --<wd>mar2006
        -- REMOVE the "R" character in POSITION "1", typically a SPREF = /LISEGA3.0R/RT9ELXB
        --!pf2 = !spn.part(3, '/').substring(1,3) & '_' & !spn.part(3, '/').substring(5)
        --!pf2 = !spn.part(3, '/').substring(2,3) & '_' & !spn.part(3, '/').substring(5)
        !xf2 = !spn.part(3, '/').substring(2)
        -- REPLACE the SIZE CHARACTER in the variable !xf2, i.e. No. 3 with an UNDERSCORE '_'
        -- Typically !pf2 = 'T9_LXB'
        !pf2 = !xf2.substring(1,2)& '_' & !xf2.substring(4)

        --<wd>mar2006

        --<wd>mar2006
        -- Ensure that REACTOR "WPAD" elements are NOT Processed here!!
        --      elseif (!spn.part(3, '/').matchwild('R*')) then
      elseif ((!spn.part(3, '/').matchwild('R*')) and ((!spn.part(3, '/').matchwild('RPLT*').not()) and (!spn.part(4, '/').matchwild('RPLT*').not()))) then
        --<wd>mar2006

        -- LISEGA Hanger Component in REACTOR Building
        if (!spn.part(3, '/').matchwild('R34P*')) then
          !pf2 = 'LIS' & !spn.part(3, '/').substring(1,4)
        elseif (!spn.part(3, '/').matchwild('R34*')) then
          !pf2 = 'LIS' & !spn.part(3, '/').substring(1,3)
          --!pf8 = 'Balance Beam'
          --!partpf8 = FALSE

          -------------------------------------------------
          --<wd>mar2006
          -- The Checking for REACTOR Building "49...." LISEGA Components moved here from below -- line 4390 approx.
        elseif (!spn.part(3, '/').matchwild('R49*G2P')) then
          !pf2 = 'LIS49HG'

        elseif (!spn.part(3, '/').matchwild('R49*')) then
          !pf2 = 'LIS49H'
          --<wd>mar2006
          -------------------------------------------------

        else
          !pf2 = 'LIS' & !spn.part(3, '/').substring(1,3)
        endif

        --<wd>mar2006
        --      elseif ((!spn.part(3, '/').matchwild('PLT*')) or (!spn.part(4, '/').matchwild('PLT*'))) then
      elseif ((!spn.part(3, '/').matchwild('PLT*')) or (!spn.part(4, '/').matchwild('PLT*')) or (!spn.part(3, '/').matchwild('RPLT*')) or (!spn.part(4, '/').matchwild('RPLT*'))) then
        --<wd>mar2006

        -- LISEGA "WPAD" Hanger Components e.g. /LISEGA3.0/PLT030 or /LISEGA3.0/D/PLT000 etc...
        -- i.e "Welded Plates", Records to be output to VPRM in the same format as <STRUCTURAL PLATES>
        ------------------------------------------------
        !area = FALSE
        !sfx  = '-C'
        if (defined(!!novprmtag)) then
          if (!!novprmtag.trim().eq('')) then
            -- HANGER WPAD PLATE AREA "$P" Record required
            !area = TRUE
            !sfx = ''
          endif
        endif

        -- HANGER WPAD Plate Thickness etc..
        !zlen = !dbf.prop.heig
        handle ANY
          !zlen ='0'
        elsehandle NONE
          if (!zlen.real().lt(10)) then
            -- Add a Preceding '0'<zero> character on any plate thickness less than 10
            !zlen = '0' & !zlen
          endif
        endhandle
        !matrefAtt = !!mdsUseMatref(!dbf)
        if (!matrefAtt.eq('UDA')) then
          !mat = !dbf.:mdsmatref
          handle ANY
            !mat = 'unset'
          endhandle
        else
          !mat = !dbf.matref
          handle ANY
            !mat = 'unset'
          endhandle
        endif
        !matdesc = !mat.description
        handle ANY
          !matdesc = 'unset'
        endhandle
        -- Pipe Quality Class
        !pqc = !mdsvprmobj.qualityclass.after('QC')
        if (!pqc.eq('')) then
          !pqc = 'unset'
        endif
        -- Material Group
        !pmg = !this.matgroup(!mdsvprmobj,!mat,!stp,!zlen)
        if (!pmg.eq('')) then
          !pmg = 'unset'
        endif
        !mts  = !this.mtestsheet(!mdsvprmobj,!mat,!stp,!zlen)
        !pf2  = 'PLATE' & !zlen & '-' & !pqc & '-' & !pmg & !sfx

        -------------------------------------------------
        -- MDS Bulk MTO To REJECT MDS Support Component if Material<:mdsmatref> or Material Group<:mdsmatgroup Of Material> or Pipe<s> Quality Class Is 'unset'
        if ((!pmg.lowcase().eq('unset')) or (!pqc.lowcase().eq('unset'))) then
          !errorcomp = !dbf.fullname
          if (!pmg.lowcase().eq('unset')) then
            !matrefAtt = !!mdsUseMatref(!dbf)
            if (!matrefAtt.eq('UDA')) then
              !dbfmatref = !dbf.:mdsmatref
              if (!dbfmatref.string().lowcase().eq('unset')) then
                !errortype = 'Material Reference<:mdsmatref> is *unset*'
              else
                !errortype = 'Material Group<:mdsmatgroup> or
                the Safety Class of MDS Support can not be determined'
              endif
            else
              !dbfmatref = !dbf.matref
              if (!dbfmatref.string().lowcase().eq('unset')) then
                !errortype = 'Material Reference<matref> is *unset*'
              else
                !errortype = 'Material Group<:mdsmatgroup> or
                the Safety Class of MDS Support can not be determined'
              endif
            endif
          elseif (!pqc.lowcase().eq('unset')) then
            !errortype = 'Quality Class of Supported Pipe<s> is *unset*'
          endif
          !mdsvprmobj.errorarray.append(' ERROR -- MDS Support PLATE component $!errorcomp $!errortype')
          !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')
          -- Return 'ERROR' for the MDS Component Part No.
          return 'ERROR'
        endif

        -------------------------------------------------
        if (!area) then
          !pf3 = 'SM'
        else
          !pf3 = 'PCS'
        endif

        !pf4 = 'PLATE'
        !partpf4 = FALSE

        !shop = !dbf.shop
        if (!shop) then
          !pf5 = 1
        else
          !pf5 = 3
        endif

        !pf6 = 'N4'

        !pf7 = !pmg

        --!pf8 = 'Plate t=' & !zlen & ' ' & !matdesc & ' MTS' & !mts
        --!pf8 = 'Plate t=' & !zlen & ' Material ' & !matdesc & ' with MTS ' & !mts & ';'
        !pf8 = 'Plate t=' & !zlen & 'mm;' & ' Material ' & !matdesc & ' with MTS ' & !mts
        !partpf8 = FALSE

        -- For PLATE AREA type record -- Weight to be output in kg/m2
        -------------------------------------------------------------
        if (!area) then
          !matrefAtt = !!mdsUseMatref(!dbf)
          if (!matrefAtt.eq('UDA')) then
            !matdens = density of sden 1 of tden 1 of :mdsmatref of $!dbf
            -- Get the "kg/m2" Weight for "1mm thick plate"
            handle ANY
              !matdens = 7850 / 1000
            elsehandle NONE
              !matdens = !matdens / 1000
            endhandle
          else
            !matdens = density of sden 1 of tden 1 of matref of $!dbf
            -- Get the "kg/m2" Weight for "1mm thick plate"
            handle ANY
              !matdens = 7850 / 1000
            elsehandle NONE
              !matdens = !matdens / 1000
            endhandle
          endif
          -- Output Weight for the Correct Plate Thickness i.e. !zlen
          !rpf9 = (!matdens * !zlen.real())
          !pf9  = !rpf9.string('d2')
          !partpf9 = FALSE

        else
          !pf9 = ''
        endif
        -------------------------------------------------

      else
        -- LISEGA Hanger Component in ANY other location
        if (!spn.part(3, '/').matchwild('34*')) then
          if (!spn.part(3, '/').matchwild('34P*')) then
            !pf2 = 'LIS' & !spn.part(3, '/').substring(1,3)
          else
            !pf2 = 'LIS' & !spn.part(3, '/').substring(1,2)
            --!pf8 = 'Balance Beam'
            --!partpf8 = FALSE
          endif

          -------------------------------------------------
          --<wd>mar2006
          -- The Checking for REACTOR Building "49...." LISEGA Components moved above to line 4250 approx.
          --elseif ( (!spn.part(3, '/').matchwild('49*G2P')) or (!spn.part(3, '/').matchwild('R49*G2P')) ) then
        elseif (!spn.part(3, '/').matchwild('49*G2P')) then
          !pf2 = 'LIS49HG'

          --elseif ( (!spn.part(3, '/').matchwild('49*')) or (!spn.part(3, '/').matchwild('R49*')) ) then
        elseif (!spn.part(3, '/').matchwild('49*')) then
          !pf2 = 'LIS49H'
          --<wd>mar2006
          -------------------------------------------------

        else
          !pf2 = 'LIS' & !spn.part(3, '/').substring(1,2)

        endif

      endif

      -- Check if it's an Implied Hanger ROD <TUBI>
      if (!typ.eq('TUBI')) then

        -- Some of the LISEGA Hanger ROD Codes <Tie Rods 66????, R66????, and Fully Threaded Rods 67???? and R67????>
        -- are Ordered from Standard Lengths, e.g 500mm, 1000mm long etc.
        -- and are NOW to be ORDERED by QUANTITY and NOT the "ACTUAL/DESIGN LENGTH" of the ROD required
        if ((!spn.matchwild('66?0*')) or (!spn.matchwild('R66?0*')) or (!spn.matchwild('67?0*')) or (!spn.matchwild('R67?0*')))  then
          -- The LISEGA Hanger ROD Codes <Tie Rods 66?0??, R66?0??, and Fully Threaded Rods 67?0?? and R67?0??>e
          !pf3 = 'M'
        else
          !pf3 = 'PCS'
        endif

      else
        if (defined(!area)) then
          if (!area) then
            !pf3 = 'SM'
          else
            !pf3 = 'PCS'
          endif
        else
          --!pf3 = 'OFF'
          !pf3 = 'PCS'
        endif
      endif

      -- All Hanger components require !pf4 to be 'HANGER' ** EXCEPT WPAD Hanger plates !pf4 = 'PLATE'
      if (!partpf4) then
        !pf4 = 'HANGER'
      endif

      !shop = !dbf.shop
      handle ANY
        -- MDS HANGER Components are to Default to SHOP = FALSE
        !pf5 = 3
      elsehandle NONE
        if (!shop) then
          !pf5 = 1
        else
          !pf5 = 3
        endif
      endhandle

      !pf6 = 'N3'

      --!pf7 = !dbf.:mdsmatref
      --handle ANY
      --  !pf7 = ''
      --endhandle
      -- Material group for LISEGA Hanger Components is HARD CODED to "HZ" except "WPAD" Components, treated as <STRUCTURAL PLATES>
      --<wd>mar2006
      --if ((!spn.part(3, '/').matchwild('PLT*')) or (!spn.part(4, '/').matchwild('PLT*'))) then
      if ((!spn.part(3, '/').matchwild('PLT*')) or (!spn.part(4, '/').matchwild('PLT*')) or (!spn.part(3, '/').matchwild('RPLT*')) or (!spn.part(4, '/').matchwild('RPLT*'))) then
        --<wd>mar2006

        --<wd>aug2006 -- Ensure that !pf6 for a PLATE = 'N4'
        !pf6 = 'N4'
        --<wd>aug2006
        !pf7 = !pmg
      else
        !pf7 = 'HZ'
      endif

      -- Part description is NOT Required in ALL Records
      --!pf8 = !mdsvprmobj.hangmemb[3][!indx].trim('M',' ').trim()
      if (!typ.eq('TUBI')) then
        --!pf8 = !mdsvprmobj.hangmemb[3][!indx].before('(').trim('M',' ').trim()
        !pf8 = ''
      else
        -- Set PART Description
        if (!partpf8) then
          -- Default Part No. Description is BLANK
          !pf8 = ''
        else
          !pf8 = !pf8
        endif
      endif

      -- Weight Field is generally empty for the PART No. record
      if (!partpf9) then
        !pf9 = ''
      else
        !pf9 = !pf9
      endif

      --$P==========================
      --q var !pf2 !dbf.fullname !dbf.dtxr !dbf.spref.name
      --$P==========================

      --<04jul2005>-- LISEGA PART No. Update --
      -- FRAMATOME do NOT want the "R" prefix for LISEGA HANGER Components transferred into the MDS VPRM MTO file
      if (!pf2.match('LISR').gt(0)) then
        !pf2 = !pf2.replace('LISR','LIS')
      endif


      -- >>> dtf 21.11.05 mod to add safety class if pipe quality class is QC1
      !pf2 = !mdsvprmobj.setsafetyclass(!type, !dbf, !pf2, !mdsvprmobj)
      if (!pf2.eq('ERROR')) then
        return 'ERROR'
      endif
      -- <<< end of Mod

      --q var !pf2
      --!vprmpart = !pf1 & ':' & !pf2 & ':' & !pf3 & ':' & !pf4 & ':' & !pf5 & ':' & !pf6 & ':' & !pf7 & ':' & !pf8 & '*'
      !vprmpart = !pf1 & ':' & !pf2 & ':' & !pf3 & ':' & !pf4 & ':' & !pf5 & ':' & !pf6 & ':' & !pf7 & ':' & !pf8 & ':' & !pf9 & '*'
      return !vprmpart

      --<nb>jun2007  HPD0035322/OP47  (Generate Support component record)
    elseif (!type.eq('SUPP')) then

      !pf1 = '$P'
      !pf2 = 'ZP00001'
      !pf3 = ''
      !pf4 = ''
      !pf5 = '3'
      !pf6 = ''
      !pf7 = ''
      !pf8 = ''
      !pf9 = ''

      !vprmpart = !pf1 & ':' & !pf2 & ':' & !pf3 & ':' & !pf4 & ':' & !pf5 & ':' & !pf6 & ':' & !pf7 & ':' & !pf8 & ':' & !pf9 & '*'
      return !vprmpart
    endif

  endmethod

  -------------------------------------------------------------------------------
  -------------------------------------------------------------------------------

  -- Method:      .vprmtag
  --
  -- Determine the MDS to VPRM MTO File Input TAG NUMBER Record for Each MDS Support Object
  --
  --
  define method .vprmtag(!type is STRING,!indx is REAL,!mdsvprmobj is MDSVPRMMTO) is STRING
    -- "$T" -- Concatenate the MDS Support TAG NUMBER Record <3 fields>
    !tf1 = '$T'

    -- Determine the TAG NUMBER Records
    if (!type.eq('ATTA')) then
      -------------------------------------------------
      -- MDS ANCILLARY ATTA Components
      !dbf = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref()

      !tqc = !mdsvprmobj.qualityclass.after('QC')
      !matrefAtt = !!mdsUseMatref(!dbf)
      if (!matrefAtt.eq('UDA')) then
        !tmg = !dbf.:mdsmatref.:mdsmatgroup
        handle ANY
          !tmg = 'unset'
        endhandle
      else
        !tmg = !dbf.matref.:mdsmatgroup
        handle ANY
          !tmg = 'unset'
        endhandle
      endif

      if (!tqc.eq('')) then
        !tqc = 'unset'
      endif
      if (!tmg.eq('')) then
        !tmg = 'unset'
      endif

      -------------------------------------------------
      -- MDS Bulk MTO to REJECT MDS Support Component if Ancillary<ATTA> Material<:mdsmatref> and/or Material Group<:mdsmatgroup of Material> is 'unset'
      if (!tmg.lowcase().eq('unset')) then
        !errorcomp = !dbf.fullname
        !matrefAtt = !!mdsUseMatref(!dbf)
        if (!matrefAtt.eq('UDA')) then
          !dbfmatref = !dbf.:mdsmatref
          if (!dbfmatref.string().lowcase().eq('unset')) then
            !errortype = 'Material Reference<:mdsmatref> is *unset*'
          else
            !errortype = 'Material Group<:mdsmatgroup> or
            the Safety Class of MDS Support can not be determined'
          endif
        else
          !dbfmatref = !dbf.matref
          if (!dbfmatref.string().lowcase().eq('unset')) then
            !errortype = 'Material Reference<matref> is *unset*'
          else
            !errortype = 'Material Group<:mdsmatgroup> or
            the Safety Class of MDS Support can not be determined'
          endif
        endif
        !mdsvprmobj.errorarray.append(' ERROR -- MDS Support ATTA Component $!errorcomp $!errortype')
        !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')
        -- Return 'ERROR' for the MDS Component TAG No.
        return 'ERROR'
      endif
      -------------------------------------------------

      -- Quality Class removed for MDS Ancillary ATTAS ONLY, as per FANP<W.Umnig> request <19th/April/2005>
      --!tf2 = !dbf.prop.code & '-' & !tqc & '-' & !tmg
      !tf2 = !dbf.prop.code & '-' & !tmg
      -- >>> dtf 17.11.05 mod to add saftey class if pipe quality class is QC1
      !tf2 = !mdsvprmobj.setsafetyclass(!type, !dbf, !tf2, !mdsvprmobj)
      if (!tf2.eq('ERROR')) then
        return 'ERROR'
      endif
      -- <<< end of Mod


      --!tf3 = !mdsvprmobj.attamemb[3][!indx].trim('M',' ').trim()
      --!bor = 'DN' & !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref().lbore
      --!tf3 = !bor
      --!tf3 = ''
      !tf3 = !tf2

      !tf4 = !dbf.prop.weig
      handle ANY
        !tf4 = ''
      elsehandle NONE
        !tf4 = !tf4.real().string('d2')
      endhandle

      --!vprmtag = !tf1 & ':' & !tf2 & ':' & !tf3  & '*'
      !vprmtag = !tf1 & ':' & !tf2 & ':' & !tf3  & ':' & !tf4  & '*'
      return !vprmtag


    elseif (!type.eq('STRU')) then
      -- MDS STRUCTURE Components
      !dbf = !mdsvprmobj.strumemb[2][!mdsvprmobj.strumemb[5][!indx][1]].dbref()
      !stp = !dbf.type

      if (!stp.eq('SCTN')) then

        -------------------------------------------------------------------------------
        --<wd>sep2005
        -- Get the GTYP of the SCTN element
        !gtp = !dbf.gtype
        if (!gtp.neq('PLAT')) then
          -- Proceed as BEFORE for a STRUCTURAL "SCTN" element
          --<wd>sep2005
          -------------------------------------------------------------------------------

          -- Set !zlen to '0' for all SCTNS -- required as a string argument in !this object methods ".matgroup" and ".mtestsheet" below
          !zlen = '0'
          -- Variable to Test "Q" Type SCTN Components
          !qtp = FALSE

          -- Initialise Variables
          !szt = !dbf.catref.:mdssizetag
          !mat = !dbf.matref
          !matdesc = !mat.description
          handle ANY
            !matdesc = 'unset'
          endhandle
          !tqc = !mdsvprmobj.qualityclass.after('QC')
          !tmg = !this.matgroup(!mdsvprmobj,!mat,!stp,!zlen)
          if (!tqc.eq('')) then
            !tqc = 'unset'
          endif
          if (!tmg.eq('')) then
            !tmg = 'unset'
          endif
          -- >> dtf 20.06.06 Mod to  Set MTSgroup for stainless steel X1-SCTN
          --$P  ************* mtsgroup for vprmtag
          --       q var !tmg
          if (!matdesc.eq('1.4571') and !szt.substring(1,2).eq('X1')) then
            !tmg = !mat.:MdsMatGroup.part(7,|\|)
          endif
          --       q var !tmg
          -->>dtf end

          --!tf2 = !szt & '-' & !mdsvprmobj.qualityclass & '-' & !matname & '-' & !mts
          --!tf2 = !szt & '-' & !tqc & '-' & !tmg

          -- MDS Bulk MTO To REJECT MDS Support Component if Material<matref> or Material Group<:mdsmatgroup Of Material> or Pipe<s> Quality Class Is 'unset'
          if ((!tmg.lowcase().eq('unset')) or (!tqc.lowcase().eq('unset'))) then
            !errorcomp = !dbf.fullname
            if (!tmg.lowcase().eq('unset')) then
              !dbfmatref = !dbf.matref
              if (!dbfmatref.string().lowcase().eq('unset')) then
                !errortype = 'Material Reference<matref> is *unset*'
              else
                !errortype = 'Material Group<:mdsmatgroup> or the Safety Class of MDS Support can not be determined'
              endif
            elseif (!tqc.lowcase().eq('unset')) then
              !errortype = 'Quality Class of Supported Pipe<s> is *unset*'
            endif
            !mdsvprmobj.errorarray.append(' ERROR -- MDS Support SCTN component $!errorcomp $!errortype')
            !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')
            -- Return 'ERROR' for the MDS Component Part No.
            return 'ERROR'
          endif

          --************************************************
          -------------------------------------------------
          -- Test the SCTN function attribute for "Q" Type SCTN Components
          !fnc = !dbf.function
          if (!fnc.matchwild('Q*')) then

            --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q2P" SCTN type added
            --            if (!fnc.matchwild('Q2-?').not()) then
            if ((!fnc.matchwild('Q2-?').not()) and  (!fnc.matchwild('Q2P-?').not())) then

              --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update
              -- DO NOT PROCESS the 2nd SCTN for a "Q3O" or "Q5O" SCTN type as a SCTN of this Q type, i.e. TREAT as a NORMAL SCTN
              --q var !dbf.name !fnc !dbf.jois.spref
              if ((!fnc.matchwild('Q3O-?').not()) or (!fnc.matchwild('Q5O-?').not()) and !dbf.jois.spref.set()) then
                --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update

                --q var !dbf.name
                --q var !dbf.function
                --q var !dbf.spref.name
                -- MDS VPRM MTO To REJECT MDS Support Component if Pipe<s> Quality Class is 'unset'
                if (!tqc.lowcase().eq('unset')) then
                  !errorcomp = !dbf.fullname
                  !errortype = 'Quality Class of Supported Pipe<s> is *unset*'
                  !mdsvprmobj.errorarray.append(' ERROR -- MDS Support SCTN component $!errorcomp $!errortype')
                  !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')

                  -- Return 'ERROR' for the MDS Component Part No.
                  return 'ERROR'
                endif

                -- SCTN is a "Q" type SCTN
                !qtp = TRUE

                -- Determine if SCTN function attribute matches "Q3-*", "Q3M-*", "Q4-*" or "Q4M-*",
                -- and set the TAG No. to show ONLY the SCTN "Q" SIZE + the QUALITY CLASS + the SCTN ASEMBLY "L" value
                -- **********************
                -- *** IMPORTANT NOTE ***
                --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q2P" SCTN type added
                -- ALL "Q2-*" and "Q2P-*" type SCTNs are IGNORED as these are treated the same as ALL OTHER SCTNS for FANP
                -- **********************
                --!tln = !dbf.tctl
                !tln = !this.mdsfanpcomp(!dbf, 'MDS-VPRM-MTO', 'Q-SCTN-LENGTH')
                !des = !dbf.prop.desc
                --!wex = (!dbf.prop.uwig.real() * (!tln.real() / 1000))
                --!wei = !wex.string('d1')
                !twe = !this.mdsfanpcomp(!dbf, 'MDS-VPRM-MTO', 'Q-SCTN-WEIGHT')

                if ((!fnc.matchwild('Q3M-?')) or (!fnc.matchwild('Q4M-?'))) then
                  !tpx = !fnc.before('M-')
                  !tsz = !fnc.after('M-')
                  !tsx = !tsz & 'M' & '-' & !tqc
                  --!tf2 = !tpx & !tsx & '-' * !tlen

                elseif ((!fnc.matchwild('Q3-?')) or (!fnc.matchwild('Q4-?'))) then
                  !tpx = !fnc.before('-')
                  !tsz = !fnc.after('-')
                  !tsx = !tsz & '-' & !tqc
                  --!tf2 = !tpx & !tsx & '-' * !tlen

                  --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q3N*","Q3O*","Q3P*","Q4N","Q4P*","Q5O" SCTN types added
                elseif ((!fnc.matchwild('Q3N-?')) or (!fnc.matchwild('Q4N-?'))) then
                  !tpx = !fnc.before('N-')
                  !tsz = !fnc.after('N-')
                  !tsx = !tsz & 'N' & '-' & !tqc

                elseif ((!fnc.matchwild('Q3P-?')) or (!fnc.matchwild('Q4P-?'))) then
                  !tpx = !fnc.before('P-')
                  !tsz = !fnc.after('P-')
                  !tsx = !tsz & 'P' & '-' & !tqc

                elseif ((!fnc.matchwild('Q3O-?')) or (!fnc.matchwild('Q5O-?'))) then
                  !tpx = !fnc.before('O-')
                  !tsz = !fnc.after('O-')
                  !tsx = !tsz & 'O' & '-' & !tqc
                  --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q3N*","Q3O*","Q3P*","Q4N","Q4P*","Q5O" SCTN types added

                endif

                !tf2 = !tpx & !tsx & '-' & !tln
                !tf3 = 'Special ' & !des & '; ' & 'L=' & !tln &'mm'
                --!tf4 = !wei
                !tf4 = !twe
              endif

              -- DO NOT PROCESS the 2nd SCTN for a "Q3O" or "Q5O" SCTN type as a SCTN of this Q type, i.e. TREAT as a NORMAL SCTN
              --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update

            endif
            --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update

          endif

          -------------------------------------------------
          --************************************************
          -- Process All other FANP SCTN Components except "Q" types
          if (!qtp.not()) then
            !tf2 = !szt & '-' & !tqc & '-' & !tmg
            --!tf3 = !mdsvprmobj.strumemb[3][!indx].trim('M',' ').trim()
            !des = !dbf.prop.desc
            !tf3 = !des
            !tf4 = !dbf.prop.uwig
            handle ANY
              !tf4 = ''
            elsehandle NONE
              !tf4 = !tf4.real().string('d2')
            endhandle
          endif

          -------------------------------------------------------------------------------
          --<wd>sep2005
        elseif (!gtp.eq('PLAT')) then
          -- Although this item is a "SCTN" element, treat it as a "PLATE" element, as per the FRAMATOME request.
          -- This currently ONLY applies to the FRAMATOME MDS template "FANP14"<alias FT17>

          -- STRUCTURAL "SCTN" elements with a GTYP of PLAT
          !xlen = !dbf.prop.widt
          handle ANY
            !xlen =''
          endhandle
          !ylen = !dbf.tctl
          handle ANY
            !ylen =''
          endhandle
          !zlen = !dbf.prop.dept
          handle ANY
            !zlen ='0'
          elsehandle NONE
            if (!zlen.real().lt(10)) then
              -- Add a Preceding '0'<zero> character on any plate thickness less than 10
              !zlen = '0' & !zlen
            endif
          endhandle

          !mat = !dbf.matref
          handle ANY
            !mat = 'unset'
          endhandle
          !matdesc = !mat.description
          handle ANY
            !matdesc = 'unset'
          endhandle

          !tqc = !mdsvprmobj.qualityclass.after('QC')

          --!tmg = !this.matgroup(!mdsvprmobj,!mat,!stp,!zlen)
          !tmg = !this.matgroup(!mdsvprmobj,!mat,!gtp,!zlen)

          --!mts = !this.mtestsheet(!mdsvprmobj,!mat,!stp,!zlen)
          !mts = !this.mtestsheet(!mdsvprmobj,!mat,!gtp,!zlen)

          if (!tqc.eq('')) then
            !tqc = 'unset'
          endif
          if (!tmg.eq('')) then
            !tmg = 'unset'
          endif

          !tf2 = 'PLATE' & !zlen & '-' & !tqc & '-' & !tmg & '-' & !ylen & '-' & !xlen

          -- MDS Bulk MTO To REJECT MDS Support Component if Material<matref> or Material Group<:mdsmatgroup Of Material> or Pipe<s> Quality Class Is 'unset'
          if ((!tmg.lowcase().eq('unset')) or (!tqc.lowcase().eq('unset'))) then
            !errorcomp = !dbf.fullname
            if (!tmg.lowcase().eq('unset')) then
              !dbfmatref = !dbf.matref
              if (!dbfmatref.string().lowcase().eq('unset')) then
                !errortype = 'Material Reference<matref> is *unset*'
              else
                !errortype = 'Material Group<:mdsmatgroup> or
                the Safety Class of MDS Support can not be determined'
              endif
            elseif (!tqc.lowcase().eq('unset')) then
              !errortype = 'Quality Class of Supported Pipe<s> is *unset*'
            endif
            !mdsvprmobj.errorarray.append(' ERROR -- MDS Support PLATE component $!errorcomp $!errortype')
            !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')
            -- Return 'ERROR' for the MDS Component Part No.
            return 'ERROR'
          endif

          --!tf3 = ''
          --!tf3 = !tf2
          !tf3 = '; Dimension ' & !ylen & 'x' & !xlen

          !tf4 = !dbf.prop.weig
          handle ANY
            !tf4 = ''
          elsehandle NONE
            !tf4 = !tf4.real().string('d2')
          endhandle

        endif
        --<wd>sep2005
        -------------------------------------------------------------------------------

        --!vprmtag = !tf1 & ':' & !tf2 & ':' & !tf3  & '*'
        !vprmtag = !tf1 & ':' & !tf2 & ':' & !tf3  & ':' & !tf4 & '*'
        --q var !tf1 !tf2 !tf3 !tf4
        return !vprmtag

      elseif ((!stp.eq('PJOI')) or (!stp.eq('SJOI')) or (!stp.eq('FITT'))) then
        -------------------------------------------------------------------------------

        -- FANP Building Attachments are SJOI Assemblies and to be treated as SINGLE ITEMS and NOT as PLATE items
        -- Therefore DO NOT output AN "AREA" record for these SJOI items
        if ((!dbf.type inset ('PJOI','SJOI')) and (!dbf.catre.name.matchwild('*U6*'))) then

          -- FANP Building Attachment TAG Nos.to be similar to SCTN components -- Use !zlen ='0' as for SCTNS above
          !zlen = '0'
          !szt = !dbf.catref.name
          !xca = !szt.after('FRA-')
          if (!xca.matchwild('*-END-*')) then
            !szt = !xca.after('-END-')
            --!xcb = !xca.before('-END-') & '-END' & !szt
            !xcb = !xca.before('-END-') & !szt

            --<wd>05mar2010 - DUN1233 - Add TAG CODE for NEW "U6?_P*" (A & B) Building attachment
          elseif (!xca.matchwild('U6?_P*')) then
            !sze = !xca.after('_P-')
            !xcb = !xca.before('-')
            !xcb = !xcb.replace('_',!sze)
            --<wd>05mar2010 - DUN1233 - Add TAG CODE for NEW "U6?_P*" (A & B)Building attachments

          else
            !xcb = !xca.replace('-','')
          endif
          --          !mat = !dbf.matref
          --          !matdesc = !mat.description
          --          handle ANY
          --            !matdesc = 'unset'
          --          endhandle
          !tqc = !mdsvprmobj.qualityclass.after('QC')

          --          !tmg = !this.matgroup(!mdsvprmobj,!mat,!stp,!zlen)
          --          if (!tqc.eq('')) then
          --            !tqc = 'unset'
          --          endif
          --          if (!tmg.eq('')) then
          --            !tmg = 'unset'
          --          endif
          !tmg = 'QZ'

          --          !tf2 = !xcb & '-' & !tqc & '-' & !tmg
          !tf2 = !xcb & '-' & !tqc

          -- >>> dtf 17.11.05 Mod to add safety class if Quality class eq 1 'QC1'
          --q var !tqc
          if (!dbf.catre.name.matchwild('*U6B*') and !tqc.eq('1')) then
            !tf2 = !tf2 & '-S1'
          endif
          -- <<< end of mod


          -------------------------------------------------
          -- MDS Bulk MTO To REJECT MDS Support Component if Material<matref> or Material Group<:mdsmatgroup Of Material> or Pipe<s> Quality Class Is 'unset'
          if ((!tmg.lowcase().eq('unset')) or (!tqc.lowcase().eq('unset'))) then
            !errorcomp = !dbf.fullname
            if (!tmg.lowcase().eq('unset')) then
              !dbfmatref = !dbf.matref
              if (!dbfmatref.string().lowcase().eq('unset')) then
                !errortype = 'Material Reference<matref> is *unset*'
              else
                !errortype = 'Material Group<:mdsmatgroup> or
                the Safety Class of MDS Support can not be determined'
              endif
            elseif (!tqc.lowcase().eq('unset')) then
              !errortype = 'Quality Class of Supported Pipe<s> is *unset*'
            endif
            !mdsvprmobj.errorarray.append(' ERROR -- MDS Support BUILDING ATTACHMENT component $!errorcomp $!errortype')
            !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')
            -- Return 'ERROR' for the MDS Component TAG No.
            return 'ERROR'
          endif
          -------------------------------------------------

          -------------------------------------------------
          -- MDS Bulk MTO To REJECT MDS Support Component if DETREF or DTXR causes an error
          -- Check if the DTXR attribute is SET or if it can be EVALUATED<it may contain a Property Evaluation>
          !tdtxr = !dbf.dtxr
          handle ANY
            !tdtxr = ''
            !errorcomp = !dbf.fullname
            !errortype = 'Detail Reference<dtxr> cannot be evaluated or does not exist'
            !mdsvprmobj.errorarray.append(' ERROR -- MDS Support BUILDING ATTACHMENT component $!errorcomp $!errortype')
            !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')
            -- Return 'ERROR' for the MDS Component TAG No.
            return 'ERROR'
          endhandle

          -- Building Attachment TAG Description
          !tba = !xcb & '-' & !tqc
          !tf3 = !tdtxr & ' ' & !tba

          -- >>> dtf 17.11.05 Mod to add safety class if Quality class eq 1 'QC1'
          if (!dbf.catre.name.matchwild('*U6B*') and !tqc.eq('1')) then
            !tf3 = !tf3 & '-S1'
          endif
          -- <<< end of mod


          -- Building Attachment TAG Weight
          --<wd>**30june205*** FANP want FRAMATOME STD WEIGHTS???? CHECK CALCS??????? for accuracy?????
          !tf4 = !dbf.prop.weig
          handle ANY
            !tf4 = ''
          elsehandle NONE
            !tf4 = !tf4.real().string('d2')
          endhandle


        else

          -- ALL other STRUCTURAL PLATE type components - PJOI, SJOI, FITT
          ----------------------------------------------------------------
          !xlen = !dbf.prop.xlen
          handle ANY
            !xlen =''
          endhandle
          !ylen = !dbf.prop.ylen
          handle ANY
            !ylen =''
          endhandle
          !zlen = !dbf.prop.zlen
          handle ANY
            !zlen ='0'
          elsehandle NONE
            if (!zlen.real().lt(10)) then
              -- Add a Preceding '0'<zero> character on any plate thickness less than 10
              !zlen = '0' & !zlen
            endif
          endhandle

          !mat = !dbf.matref
          handle ANY
            !mat = !dbf.cref.matref
          endhandle
          !matdesc = !mat.description
          handle ANY
            !matdesc = 'unset'
          endhandle

          !tqc = !mdsvprmobj.qualityclass.after('QC')
          !tmg = !this.matgroup(!mdsvprmobj,!mat,!stp,!zlen)
          !mts = !this.mtestsheet(!mdsvprmobj,!mat,!stp,!zlen)

          if (!tqc.eq('')) then
            !tqc = 'unset'
          endif
          if (!tmg.eq('')) then
            !tmg = 'unset'
          endif

          --!tf2  = 'PLATE' & !zlen & '-' & !mdsvprmobj.qualityclass & '-' & !mat.namn & '-' & !mts & '-' & !xlen & '-' & !ylen
          !tf2 = 'PLATE' & !zlen & '-' & !tqc & '-' & !tmg & '-' & !ylen & '-' & !xlen

          -------------------------------------------------
          -- MDS Bulk MTO To REJECT MDS Support Component if Material<matref> or Material Group<:mdsmatgroup Of Material> or Pipe<s> Quality Class Is 'unset'
          if ((!tmg.lowcase().eq('unset')) or (!tqc.lowcase().eq('unset'))) then
            !errorcomp = !dbf.fullname
            if (!tmg.lowcase().eq('unset')) then
              !dbfmatref = !dbf.matref
              if (!dbfmatref.string().lowcase().eq('unset')) then
                !errortype = 'Material Reference<matref> is *unset*'
              else
                !errortype = 'Material Group<:mdsmatgroup> or
                the Safety Class of MDS Support can not be determined'
              endif
            elseif (!tqc.lowcase().eq('unset')) then
              !errortype = 'Quality Class of Supported Pipe<s> is *unset*'
            endif
            !mdsvprmobj.errorarray.append(' ERROR -- MDS Support PLATE component $!errorcomp $!errortype')
            !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')
            -- Return 'ERROR' for the MDS Component Part No.
            return 'ERROR'
          endif
          -------------------------------------------------

          --!tf3 = ''
          --!tf3 = !tf2
          !tf3 = '; Dimension ' & !ylen & 'x' & !xlen

          !tf4 = !dbf.prop.weig
          handle ANY
            !tf4 = ''
          elsehandle NONE
            !tf4 = !tf4.real().string('d2')
          endhandle

          --<GE> 07/03/07 Check to see if the PJOI is a Full Reinforcement type and requires extra matl
          -- Set new weight and plate dimensions
          if (defined(!!extramatl)) then
            if (!!extramatl) then
              !tf4 = !dbf.prop.weib
              handle ANY
                !tf4 = ''
              elsehandle NONE
                !tf4 = !tf4.real().string('d2')
              endhandle
              !ylen = !dbf.prop.yleb
              handle ANY
                !ylen =''
              endhandle
              !tf2 = 'PLATE' & !zlen & '-' & !tqc & '-' & !tmg & '-' & !ylen & '-' & !xlen
              !tf3 = '; Dimension ' & !ylen & 'x' & !xlen
            endif
          endif
          --q var !tf2
          --q var !tf3
          --q var !tf4
          --<GE> 07/03/07

        endif

        --!vprmtag = !tf1 & ':' & !tf2 & ':' & !tf3  & '*'
        !vprmtag = !tf1 & ':' & !tf2 & ':' & !tf3  & ':' & !tf4 & '*'
        return !vprmtag

      elseif (!stp.eq('BOX')) then
        -------------------------------------------------

        !xlen = !dbf.xlen
        handle ANY
          !xlen =''
        endhandle
        !ylen = !dbf.ylen
        handle ANY
          !ylen =''
        endhandle
        --<wd>mar2006
        --!zlen = !dbf.zlen
        !zlenreal = !dbf.zlen
        --<wd>mar2006
        handle ANY
          !zlen ='0'
        elsehandle NONE

          --<wd>mar2006
          !zlen = !zlenreal.string()
          --<wd>mar2006
          if (!zlen.real().lt(10)) then
            -- Add a Preceding '0'<zero> character on any plate thickness less than 10
            !zlen = '0' & !zlen
          endif
        endhandle

        !mat = !dbf.:mdsmatref
        handle ANY
          !mat = !dbf.matref
          handle ANY
            !mat = 'unset'
          endhandle
        endhandle
        !tqc = !mdsvprmobj.qualityclass.after('QC')
        !tmg = !this.matgroup(!mdsvprmobj,!mat,!stp,!zlen.string())
        !mts  = !this.mtestsheet(!mdsvprmobj,!mat,!stp,!zlen.string())
        if (!tqc.eq('')) then
          !tqc = 'unset'
        endif
        if (!tmg.eq('')) then
          !tmg = 'unset'
        endif

        --!tf2  = 'PLATE' & !zlen & '-' & !mdsvprmobj.qualityclass & '-' & !mat.namn & '-' & !mts & '-' & !xlen & '-' & !ylen
        !tf2 = 'PLATE' & !zlen & '-' & !tqc & '-' & !tmg & '-' & !ylen & '-' & !xlen

        -------------------------------------------------
        -- MDS Bulk MTO To REJECT MDS Support Component if Material<:mdsmatref> or Material Group<:mdsmatgroup Of Material> or Pipe<s> Quality Class Is 'unset'
        if ((!tmg.lowcase().eq('unset')) or (!tqc.lowcase().eq('unset'))) then
          !errorcomp = !dbf.fullname
          if (!tmg.lowcase().eq('unset')) then
            !matrefAtt = !!mdsUseMatref(!dbf)
            if (!matrefAtt.eq('UDA')) then
              !dbfmatref = !dbf.:mdsmatref
              if (!dbfmatref.string().lowcase().eq('unset')) then
                !errortype = 'Material Reference<:mdsmatref> is *unset*'
              else
                !errortype = 'Material Group<:mdsmatgroup> or
                the Safety Class of MDS Support can not be determined'
              endif
            else
              !dbfmatref = !dbf.matref
              if (!dbfmatref.string().lowcase().eq('unset')) then
                !errortype = 'Material Reference<matref> is *unset*'
              else
                !errortype = 'Material Group<:mdsmatgroup> or
                the Safety Class of MDS Support can not be determined'
              endif
            endif
          elseif (!tqc.lowcase().eq('unset')) then
            !errortype = 'Quality Class of Supported Pipe<s> is *unset*'
          endif
          !mdsvprmobj.errorarray.append(' ERROR -- MDS Support PLATE component $!errorcomp $!errortype')
          !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')
          -- Return 'ERROR' for the MDS Component Part No.
          return 'ERROR'
        endif
        -------------------------------------------------

        --!tf3  = ''
        --!tf3 = !tf2
        !tf3 = '; Dimension ' & !ylen & 'x' & !xlen

        !matdens = density of sden 1 of tden 1 of matref of $!dbf
        handle ANY
          !matdens = density of sden 1 of tden 1 of :mdsmatref of $!dbf
          handle ANY
            !matdens = 7850
          endhandle
        endhandle

        !nvol = nvol of $!dbf
        !wei = (!nvol.real() * !matdens) / 1000 / 1000 / 1000
        !wei = !wei * !!mdsweiunit.real()
        !tf4 = !wei.string('d2')

        --!vprmtag = !tf1 & ':' & !tf2 & ':' & !tf3  & '*'
        !vprmtag = !tf1 & ':' & !tf2 & ':' & !tf3  & ':' & !tf4 & '*'
        return !vprmtag

      endif

    elseif (!type.eq('HANG')) then

      -------------------------------------------------
      -- MDS Hanger Component
      -------------------------------------------------

      -- Initialise Variables
      !dbf = !mdsvprmobj.hangmemb[2][!mdsvprmobj.hangmemb[5][!indx][1]].dbref()
      !stp = !dbf.stype
      !typ = !dbf.type
      !spn = !dbf.spre.name.part(3, '/')

      -- Set "!tagtf3" & "!tagtf4" flags to TRUE for the STANDARD/DEFAULT TAG Description and Weight
      !tagtf3 = TRUE
      !tagtf4 = TRUE
      -- Default the variable "!spring" to FALSE
      !spring = FALSE

      --q var !dbf.fullname

      -- Check for Implied ROD <TUBI> elements
      if (!typ.eq('TUBI')) then

        -- IMPLIED HANGER RODS <TUBI> Only
        !len = !dbf.itle.string('d0')
        if ((!spn.matchwild('66?0*')) or (!spn.matchwild('R66?0*')) or (!spn.matchwild('67?0*')) or (!spn.matchwild('R67?0*'))) then
          --!len = !dbf.despar[3].string()
          if (!len.real().lt(1000)) then
            !len = '0' & !len
          endif
          !tf2 = !spn & '-' & !len

          -- Weight required "kg/m" for Implied ROD when U.O.M is 'M' for Length
          !wei = !dbf.spref.:ustweight[1]
          !tf4 = !wei.string('d2')
          !tagtf4 = FALSE

        elseif ((!spn.matchwild('66*')) or (!spn.matchwild('R66*')) or (!spn.matchwild('67*')) or (!spn.matchwild('R67*'))) then
          -- Get LISEGA Code Std. Length Character for Both <66*> and <R66*> LISEGA Codes
          if (!spn.match('R').eq(1)) then
            !xch = 1
          else
            !xch = 0
          endif
          -- Get the Position of the ROD Length Character
          !sub = (4 + !xch)
          !lch = !spn.substring(!sub,1).real()
          -- Determine the Standard LISEGA ROD Length
          if (!lch.eq(2)) then
            !len = '500'
          elseif (!lch.eq(3)) then
            !len = '1000'
          elseif (!lch.eq(4)) then
            !len = '1500'
          elseif (!lch.eq(5)) then
            !len = '2000'
          elseif (!lch.eq(6)) then
            !len = '2500'
          elseif (!lch.eq(7)) then
            !len = '3000'
          endif
          -- TAG Number
          !tf2 = !spn

          -- Set Implied Rod "TOTAL" Weight per ROD, when "PCS"<No.Off> is used as the U.O.M for LISEGA Standard ROD Lengths
          !wei = ((!len.real() / 1000) * (!dbf.spref.:ustweight[1]))
          !tf4 = !wei.string('d2')
          !tagtf4 = FALSE

          --        else
          --          !len = !dbf.itle.string('d0')
          --          --if (!len.real()lt(1000)) then
          --          --  !len = '0' & !len
          --          --endif
          --          !tf2 = !spn & '-' & !len
          --
        endif

        -- Set Implied Rod TAG Description
        !dia = !dbf.lbor.string().before('mm') $* PML2 Not Used because PDMS outputs "12mm dia. rod" INCORRECTLY as "10mm dia. rod"
        var !dia lbor of $!dbf
        --!tf3 = 'M' & !dia & 'x' & !len & 'mm'
        --!tf3 = !mdsvprmobj.hangmemb[3][!indx].before('(').trim('M',' ').trim()
        !rod = ' (M' & !dia & 'x' & !len & 'mm)'
        !tf3 = !mdsvprmobj.hangmemb[3][!indx].before('(').trim('M',' ').trim() & !rod
        !tagtf3 = FALSE

      else
        -------------------------------------------------
        ---------------------------------------------------------------------------------
        -- Determine the TAG number for -- Different Types of Lisega CATALOGUE Components
        -- Excluding any IMPLIED HANGER RODS <TUBI> which is DONE in the PML Code above.
        ---------------------------------------------------------------------------------

        -- Check if it's a LISEGA SPRING on a MDS HANGER in the passed OBJECT "!mdsvprmoj"
        if (!mdsvprmobj.hangspring.empty().not()) then
          !findspring = !mdsvprmobj.hangspring.find(!dbf)
          -- Create the UNIQUE TAG Number
          if (!findspring.empty().not()) then
            -- The Spring Exists on the MDS Hanger, Create the UNIQUE TAG Number
            if ((!spn.matchwild('79??5*')) or (!spn.matchwild('R79??5*')) ) then
              -- A LISEGA TWO Variable Spring Trapeze does NOT require a Spring Index Number
              --!tf2 = !spn & '-' & !mdsvprmobj.suppname
              !spf = !spn.before('-')
              !len = !dbf.despar[3].string()
              if (!len.real().lt(1000)) then
                !len = '0' & !len
              endif
              --!tf2 = !spf & '-' & !len & '-' & !mdsvprmobj.suppname
              !tf2 = !spf & '-' & !mdsvprmobj.suppname

              -- Adjust !len for !tf3 description below
              !len = '-' & !len

              -- Get the  Weight from the SPREF uda ":ustweight" LOAD value
              --!tf4 = !dbf.spref.:ustweight[1].string('d2')
              !twei   = !!mdsabalicadwei(!dbf)
              !tf4    = !twei[1].string('d2')
              !tagtf4 = FALSE

            else
              -- Other LISEGA Springs require a Spring Index Number
              --!tf2    = !tf2 & '-' & !mdsvprmobj.suppname & '.' & !findspring[1]
              !tf2 = !spn & '-' & !mdsvprmobj.suppname & '.' & !mdsvprmobj.springindex
              !len = ''
            endif

            --$P+++++++++++++++++++++++++++
            --q var !mdsvprmobj.hangspring !mdsvprmobj.springindex
            --q var !tf2 !findspring[1] !dbf.name !dbf.spref.name !dbf.dtxr
            --$P*********************************
            !spring = TRUE

            -- Get the Spring Description and the Spring uda ":uststatload" LOAD value stored at the owning RESTRAINT
            !sld = !dbf.owner.owner.:uststatload
            --!tf3 = !mdsvprmobj.hangmemb[3][!indx].trim('M',' ').trim().before('type')
            --!tf3 = !tf3.trim() & ' Static Load ' & !sld
            !tf3 = !mdsvprmobj.hangmemb[3][!indx].trim('M',' ').trim()
            -- Variable !len added where applicable to !tf3 description
            --!tf3 = !tf3.trim() & ' Presetting Load ' & !sld & ' kN'
            !tf3 = !tf3.trim() & !len & ' Presetting Load ' & !sld & ' kN'
            !tagtf3 = FALSE

            -- Get the Spring Weight from the SPREF uda ":ustweight" LOAD value
            if (!tagtf4) then
              !tf4 = !dbf.spref.:ustweight[1].string('d2')
              !tagtf4 = FALSE
            endif

          endif
        endif

        -- Other LISEGA Hanger Components NOT Classed as "SPRINGS"
        if ((!spn.matchwild('2*')) and (!spring.not())) then
          if (!spn.matchwild('20*')) then
            -- FANP "BQ"<MDS Support Number> needs to be appended to the TAG No. for LISEGA Components SPREF = "20*"
            !tf2 = !spn & '-' & !mdsvprmobj.suppname
          else
            !tf2 = !spn
          endif
          -- TAG Weight
          --!tf4 = !dbf.spref.:ustweight[1].string('d2')
          !twei   = !!mdsabalicadwei(!dbf)
          !tf4    = !twei[1].string('d2')
          !tagtf4 = FALSE

        elseif ((!spn.matchwild('34P*')) or (!spn.matchwild('R34P*')))  then
          !len = !dbf.despar[3].string()
          if (!len.real().lt(1000)) then
            !len = '0' & !len
          endif
          !tf2 = !spn & '-' & !len

          -- Get the  Weight from the SPREF uda ":ustweight" LOAD value
          --!tf4 = !dbf.spref.:ustweight[1].string('d2')
          !twei   = !!mdsabalicadwei(!dbf)
          !tf4    = !twei[1].string('d2')
          !tagtf4 = FALSE

        elseif ((!spn.matchwild('34*')) or (!spn.matchwild('R34*'))) then
          !tf2 = !dbf.owner.owner.:ustdrwg.part(1,'-') & '-' & !mdsvprmobj.suppname

          !tf3    = 'Balance Beam ' & !dbf.owner.owner.:ustdrwg
          !tagtf3 = FALSE

          --?????????????????????????????????????????????????????????????????????????????????????????????????
          -- ??? Where is the Weight stored in PDMS?
          -- Awaiting Weight Details from FANP/Derek Flannery/Frank Sarnoch @ LISEGA ??? -- <wd>16th May 2005
          --!tf4 = !dbf.spref.:ustweight[1].string('d2')
          --handle ANY
          --!tf4 = 'unset'
          --!tf4 = ''
          --endhandle
          !twei   = !!mdsabalicadwei(!dbf)
          !tf4    = !twei[1].string('d2')
          !tagtf4 = FALSE
          --?????????????????????????????????????????????????????????????????????????????????????????????????


        elseif ((!spn.matchwild('36????P*')) or (!spn.matchwild('R36????P*'))or (!spn.matchwild('37????P*')) or (!spn.matchwild('R37????P*'))) then
          !tf2 = !spn

        elseif ((!spn.matchwild('36*')) or (!spn.matchwild('R36*')) or (!spn.matchwild('37*')) or (!spn.matchwild('R37*'))) then
          -- Determine the Load Group from the "LAST FIELD" in the LISEGA Description <per NCM Friday-8/apr/2005>
          !dsc = !mdsvprmobj.hangmemb[3][!indx]
          !spl = !dsc.trim().split()
          !siz = !spl.size()
          !ldg = !spl[!siz]
          !tf2 = !ldg
          --!ldg = 'LGxx'
          --!tf2 = !spn & '-' & !ldg

          -- Special Weight calculation for '37*' and 'R37' items
          if ((!spn.matchwild('37*')) or (!spn.matchwild('R37*'))) then
            !twei   = !!mdsabalicadwei(!dbf)
            !tf4    = !twei[1].string('d2')
            !tagtf4 = FALSE
            --$P***************
            --           q var !tf4
          endif

        elseif ((!spn.matchwild('45*')) or (!spn.matchwild('R45*')) or (!spn.matchwild('48*')) or (!spn.matchwild('R48*')))  then
          !spf = !spn.before('-')
          !len = !dbf.despar[3].string()
          if (!len.real().lt(1000)) then
            !len = '0' & !len
          endif
          !tf2 = !spf & '-' & !len

        elseif ((!spn.matchwild('65*')) or (!spn.matchwild('R65*'))) then
          !tf2 = !spn
          -- Tie Rod TAG Weight
          !tf4 = !dbf.spref.:ustweight[1].string('d2')
          !tagtf4 = FALSE

          --        elseif ((!spn.matchwild('66?0*')) or (!spn.matchwild('67?0*')) or (!spn.matchwild('R66?0*')) or (!spn.matchwild('R67?0*')))  then
          --          !len = !dbf.despar[3].string()
          --          if (!len.real().lt(1000)) then
          --            !len = '0' & !len
          --          endif
          --          !tf2 = !spn & '-' & !len

        elseif ((!spn.matchwild('67?1*')) or (!spn.matchwild('R67?1*'))) then
          --elseif ((!spn.matchwild('66?1*')) or (!spn.matchwild('R66?1*')) or (!spn.matchwild('67?1*')) or (!spn.matchwild('R67?1*'))) then

          !tf2 = !spn
          -- Set Stud Bolt Rod TAG Weight
          !tf4 = !dbf.spref.:ustweight[1].string('d2')
          !tagtf4 = FALSE

        elseif ((!spn.matchwild('772*')) or (!spn.matchwild('773*')) or (!spn.matchwild('774*')) or (!spn.matchwild('775*')) or (!spn.matchwild('776*')) or (!spn.matchwild('777*')) or (!spn.matchwild('778*')) or (!spn.matchwild('779*'))) then
          -- Determine the Load Group from the "LAST FIELD" in the LISEGA Description <per NCM Friday-8/apr/2005>
          !dsc = !mdsvprmobj.hangmemb[3][!indx]
          !spl = !dsc.trim().split()
          !siz = !spl.size()
          !ldg = !spl[!siz]
          !tf2 = !ldg

        elseif ((!spn.matchwild('R772*')) or (!spn.matchwild('R773*')) or (!spn.matchwild('R774*')) or (!spn.matchwild('R775*')) or (!spn.matchwild('R776*')) or (!spn.matchwild('R777*')) or (!spn.matchwild('R778*'))  or (!spn.matchwild('R779*'))) then
          -- Determine the Load Group from the "LAST FIELD" in the LISEGA Description <per NCM Friday-8/apr/2005>
          !dsc = !mdsvprmobj.hangmemb[3][!indx]
          !spl = !dsc.trim().split()
          !siz = !spl.size()
          !ldg = !spl[!siz]
          !tf2 = !ldg

        elseif ((!spn.matchwild('79??8*')) or (!spn.matchwild('R79??8*')) ) then
          !spf = !spn.before('-')
          !len = !dbf.despar[3].string()
          if (!len.real().lt(1000)) then
            !len = '0' & !len
          endif
          !tf2 = !spf & '-' & !len
          -- Get the  Weight from the SPREF uda ":ustweight" LOAD value
          --!tf4 = !dbf.spref.:ustweight[1].string('d2')
          !twei   = !!mdsabalicadwei(!dbf)
          !tf4    = !twei[1].string('d2')
          !tagtf4 = FALSE

        elseif ((!spn.matchwild('PLT*')) or (!spn.matchwild('RPLT*')) ) then
          -- LISEGA "WPAD" components i.e. "Welded Plates", to be output the same as <STRUCTURAL PLATES>
          !xlen = !dbf.prop.widt
          handle ANY
            !xlen =''
          endhandle
          !ylen = !dbf.prop.leng
          handle ANY
            !ylen =''
          endhandle
          !zlen = !dbf.prop.heig
          handle ANY
            !zlen ='0'
          elsehandle NONE
            if (!zlen.real().lt(10)) then
              -- Add a Preceding '0'<zero> character on any plate thickness less than 10
              !zlen = '0' & !zlen
            endif
          endhandle

          !mat = !dbf.matref
          handle ANY
            !mat = !dbf.:mdsmatref
            handle ANY
              !mat = 'unset'
            endhandle
          endhandle

          !tqc = !mdsvprmobj.qualityclass.after('QC')
          !tmg = !this.matgroup(!mdsvprmobj,!mat,!stp,!zlen)
          !mts  = !this.mtestsheet(!mdsvprmobj,!mat,!stp,!zlen)
          if (!tqc.eq('')) then
            !tqc = 'unset'
          endif
          if (!tmg.eq('')) then
            !tmg = 'unset'
          endif

          !tf2 = 'PLATE' & !zlen & '-' & !tqc & '-' & !tmg & '-' & !ylen & '-' & !xlen

          -------------------------------------------------
          -- MDS Bulk MTO To REJECT MDS Support Component if Material<:mdsmatref> or Material Group<:mdsmatgroup Of Material> or Pipe<s> Quality Class Is 'unset'
          if ((!tmg.lowcase().eq('unset')) or (!tqc.lowcase().eq('unset'))) then
            !errorcomp = !dbf.fullname
            if (!tmg.lowcase().eq('unset')) then
              -- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
              -- the matref attribute has been added to atta. Find the correct attribute to use
              -- The variable !matrefAtt will be set to either REF for matref or UDA for :MdsMatref
              !matrefAtt = !!mdsUseMatref(!dbf)
              -- If the :mdsmatref is set use the description
              if (!matrefAtt.eq('UDA')) then
                !dbfmatref = !dbf.:mdsmatref
                if (!dbfmatref.string().lowcase().eq('unset')) then
                  !errortype = 'Material Reference<:mdsmatref> is *unset*'
                else
                  !errortype = 'Material Group<:mdsmatgroup> or
                  the Safety Class of MDS Support can not be determined'
                endif
              else
                !dbfmatref = !dbf.matref
                if (!dbfmatref.string().lowcase().eq('unset')) then
                  !errortype = 'Material Reference<matref> is *unset*'
                else
                  !errortype = 'Material Group<:mdsmatgroup> or
                  the Safety Class of MDS Support can not be determined'
                endif
              endif
            elseif (!tqc.lowcase().eq('unset')) then
              !errortype = 'Quality Class of Supported Pipe<s> is *unset*'
            endif
            !mdsvprmobj.errorarray.append(' ERROR -- MDS Support PLATE component $!errorcomp $!errortype')
            !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')
            -- Return 'ERROR' for the MDS Component TAG No.
            return 'ERROR'
          endif
          -------------------------------------------------

          --!tf3  = ''
          --!tf3 = !tf2
          !tf3 = '; Dimension ' & !ylen & 'x' & !xlen
          !tagtf3 = FALSE

          !matdens = density of sden 1 of tden 1 of matref of $!dbf
          handle ANY
            !matdens = density of sden 1 of tden 1 of :mdsmatref of $!dbf
            handle ANY
              !matdens = 7850
            endhandle
          endhandle

          !nvol = nvol of $!dbf
          !wei = (!nvol.real() * !matdens) / 1000 / 1000 / 1000
          !wei = !wei * !!mdsweiunit.real()
          !tf4 = !wei.string('d2')
          !tagtf4 = FALSE

        else
          if (!spring.not()) then
            !tf2 = !spn
          endif

        endif

        -- Set TAG Description
        if (!tagtf3) then
          !tf3 = !mdsvprmobj.hangmemb[3][!indx].trim('M',' ').trim()
        else
          !tf3 = !tf3
        endif

      endif

      -- Set Weight of the Hanger Component
      if (!tagtf4) then
        !tf4 = !dbf.spref.:ustweight[1].string('d2')
        handle ANY
          !tf4 = ''
        endhandle

      else
        !tf4 = !tf4
      endif


      --<04jul2005>
      -- LISEGA TAG No. and TAG Description Update --
      -- FRAMATOME do NOT want the "R" prefix for LISEGA HANGER Components transferred into the MDS VPRM MTO file
      --
      -- LISEGA TAG Description Update
      -- Check the TAG No. and then Modify the TAG Description before the TAG No. is updated
      --$P================================================
      if (!tf2.trim().match('R').eq(1)) then
        --$P OLD TAG NO. = $!tf2
        --$P OLD TAG DES = $!tf3
        !tf3 = !tf3.replace(!tf2.before('-'),!tf2.before('-').substring(2))
        --$P NEW TAG DES = $!tf3
      endif

      -- LISEGA TAG No. Update --
      if (!tf2.trim().match('R').eq(1)) then
        !tf2 = !tf2.replace('R','')
        --$P NEW TAG NO. = $!tf2
      endif
      --$P================================================

      -- >>> dtf 17.11.05 mod to add saftey class if pipe quality class is QC1
      !tf2 = !mdsvprmobj.setsafetyclass(!type, !dbf, !tf2, !mdsvprmobj)
      if (!tf2.eq('ERROR')) then
        return 'ERROR'
      endif
      !tf3 = !mdsvprmobj.setsafetyclass(!type, !dbf, !tf3, !mdsvprmobj)
      if (!tf3.eq('ERROR')) then
        return 'ERROR'
      endif
      -- <<< end of Mod

      --!vprmtag = !tf1 & ':' & !tf2 & ':' & !tf3  & '*'
      !vprmtag = !tf1 & ':' & !tf2 & ':' & !tf3  & ':' & !tf4  & '*'
      return !vprmtag

      --<nb>jun2007  HPD0035322/OP47  (Generate Support component record)
    elseif (!type.eq('SUPP')) then

      !tf2 = !mdsvprmobj.suppname
      !tf3 = 'Prefabricated support for ' & !mdsvprmobj.suppname
      !tf4 = ''

      !vprmtag = !tf1 & ':' & !tf2 & ':' & !tf3  & ':' & !tf4  & '*'
      return !vprmtag

    endif

  endmethod

  -------------------------------------------------------------------------------
  -------------------------------------------------------------------------------

  -- Method:      .vprmcomp
  --
  -- Determine the MDS to VPRM MTO File Input COMPONENT Record for Each MDS Support Object
  --
  --
  define method .vprmcomp(!type is STRING,!indx is REAL,!mdsvprmobj is MDSVPRMMTO,!partnum is STRING,!tagnum is STRING) is STRING
    -- "$C" -- Concatenate the MDS Support COMPONENT Record <24 fields>


    -- Get Part and Tag Numbers
    !prtn = !partnum.part(2,':')
    !tagn = !tagnum.part(2,':')
    !deld = !partnum.part(5,':')

    -- Initialise the COMPONENT Records
    !cf1  = '$$C'
    !cf2  = ''
    !cf3  = ''
    !cf4  = ''
    !cf5  = ''
    !cf6  = ''

    -- Part Number
    --    !cf7  = ''
    -- Tag number
    --    !cf8  = ''
    -- Quantity
    --    !cf9  = ''
    -- Delivery Designation
    --    !cf10 = 0

    !cf11 = ''
    !cf12 = ''
    !cf13 = 'N'
    !cf14 = 'N'
    !cf15 = 'N'
    !cf16 = ''
    !cf17 = ''
    !cf18 = ''
    !cf19 = ''
    !cf20 = 'Y'
    !cf21 = 'Y'
    !cf22 = ''
    !cf23 = ''

    -- Component Construction Area
    !cf24 = ''

    -- Determine Component Records for "Type" etc...
    if (!type.eq('ATTA')) then
      ---------------------------------------------------------------------

      -- MDS ANCILLARY ATTA Components
      -- Part Number
      !cf7 = !prtn
      --      !stp = !mdsvprmobj.attamemb[2][!mdsvprmobj.attamemb[5][!indx][1]].dbref().stype
      --      !cf7 = !!code$!<stp>
      -- Tag number
      !cf8 = !tagn
      --      !cf8 = !dbf.prop.code
      -- Quantity
      !cf9 = !mdsvprmobj.attamemb[4][!indx]
      -- Delivery Designation
      !cf10 = !deld
      --      !shop = !dbf.shop
      --      if (!shop) then
      --        !cf10 = 1
      --      else
      --        !cf10 = 3
      --      endif

      !vprmcomp = !cf1 & ':' & !cf2 & ':' & !cf3 & ':' & !cf4 & ':' & !cf5 & ':' & !cf6 & ':' & !cf7 & ':' & !cf8 & ':' & !cf9 & ':' & !cf10 & ':' & !cf11 & ':' & !cf12 & ':' & !cf13 & ':' & !cf14 & ':' & !cf15 & ':' & !cf16 & ':' & !cf17 & ':' & !cf18 & ':' & !cf19 & ':' & !cf20 & ':' & !cf21 & ':' & !cf22 & ':' & !cf23 & ':' & !cf24 & '*'
      return !vprmcomp


    elseif (!type.eq('STRU')) then
      ---------------------------------------------------------------------
      -- MDS STRUCTURE Components

      !dbf = !mdsvprmobj.strumemb[2][!mdsvprmobj.strumemb[5][!indx][1]].dbref()
      !stp = !dbf.type

      if (!stp.eq('SCTN')) then

        -------------------------------------------------------------------------------
        --<wd>sep2005
        -- Get the GTYP of the SCTN element
        !gtp = !dbf.gtype
        if (!gtp.neq('PLAT')) then
          -- Proceed as BEFORE for a STRUCTURAL "SCTN" element
          --<wd>sep2005
          -------------------------------------------------------------------------------

          -- Part Number
          !cf7 = !prtn
          -- Tag number
          !cf8 = !tagn

          --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q2P" SCTN type added
          -- ALL FANP "Q" type SCTN Components (except "Q2" and "Q2P" SCTNS which are treated the SAME as OTHER FANP SCTNS)
          -- will have a QUANTITY field of 'PCS'<pieces>.
          -- ALL OTHER NORMAL FANP SCTNS will have a QUANTITY field of 'M'<metres>
          if (!cf7.matchwild('Q*')) then
            -- "Q" type FANP SCTNS
            !cf9 = 1

          else
            -- NORMAL FANP SCTNS
            -- Length
            --!cf9  = !mdsvprmobj.strumemb[4][!indx]
            !cx9 = !dbf.tctl
            -- Currently the VPRM Length Option is Hard Coded to 'M' <metre> for SCTNS
            !cx9 = !cx9.nint() / 1000
            !cf9 = !cx9.string('d3')
          endif

          -- Delivery Designation
          !cf10 = !deld

          -------------------------------------------------------------------------------
          --<wd>sep2005
        elseif (!gtp.eq('PLAT')) then
          -- Although it is a "SCTN" element, treat it as a "PLATE" element, as per the FRAMATOME request.
          -- This currently ONLY applies to the FRAMATOME MDS template "FANP14"<alias FT17>
          -- All STRUCTURAL "SCTN" PLATE type components

          !area = FALSE
          if (defined(!!novprmtag)) then
            if (!!novprmtag.trim().eq('')) then
              -- PLATE AREA "$P" Record required
              !area = TRUE
            endif
          endif

          -- Part Number
          !cf7 = !prtn
          -- Tag number
          !cf8 = !tagn

          if (!area) then
            -- Area of Plate in m2 <SM = Square Metres>
            !ylen = !dbf.tctl
            !xlen = !dbf.prop.widt
            -- Multiply the Plate Area in Square Metres by the Quantity of Plates to get the TOTAL AREA for the PLATE No. Off
            !parea = (((!ylen.real() / 1000 ) * (!xlen.real() / 1000 )) * !mdsvprmobj.strumemb[4][!indx])
            !cf9 = !parea.string('D3')
          else
            -- Quantity of Plates i.e. No. OFF
            -- Quantity *** ALWAYS = 1 *** because it is a SCTN element
            !cf9  = !mdsvprmobj.strumemb[4][!indx]
          endif
          -- Delivery Designation
          !cf10 = !deld

          -- Insulation, Tracing and Painting
          !cf13 = 'N'
          !cf14 = 'N'
          !cf15 = 'N'

          -- !cf20 = For Requisition
          -- !cf21 = For Construction
          if (!area) then
            !cf20 = 'Y'
            !cf21 = 'N'
          else
            !cf20 = 'N'
            !cf21 = 'Y'
          endif

        endif
        --<wd>sep2005
        -------------------------------------------------------------------------------

        !vprmcomp = !cf1 & ':' & !cf2 & ':' & !cf3 & ':' & !cf4 & ':' & !cf5 & ':' & !cf6 & ':' & !cf7 & ':' & !cf8 & ':' & !cf9 & ':' & !cf10 & ':' & !cf11 & ':' & !cf12 & ':' & !cf13 & ':' & !cf14 & ':' & !cf15 & ':' & !cf16 & ':' & !cf17 & ':' & !cf18 & ':' & !cf19 & ':' & !cf20 & ':' & !cf21 & ':' & !cf22 & ':' & !cf23 & ':' & !cf24 & '*'
        return !vprmcomp

      elseif (!stp inset ('PJOI','SJOI','FITT','BOX')) then
        ---------------------------------------------------------------------
        !area = FALSE
        if (defined(!!novprmtag)) then
          if (!!novprmtag.trim().eq('')) then
            -- PLATE AREA "$P" Record required
            !area = TRUE
          endif
        endif

        -- Part Number
        !cf7 = !prtn
        -- Tag number
        !cf8 = !tagn

        if (!area) then
          -- Area of Plate in m2 <SM = Square Metres>
          if (!stp.eq('BOX')) then
            !ylen = !dbf.ylen
            !xlen = !dbf.xlen
          else
            !ylen = !dbf.prop.ylen
            !xlen = !dbf.prop.xlen
          endif
          -- Multiply the Plate Area in Square Metres by the Quantity of Plates to get the TOTAL AREA for the PLATE No. Off
          !parea = (((!ylen.real() / 1000 ) * (!xlen.real() / 1000 )) * !mdsvprmobj.strumemb[4][!indx])
          !cf9 = !parea.string('D3')
          --<GE> 07/03/07 Check to see if the PJOI is a Full Reinforcement type and requires extra matl
          if (!dbf.spref.set()) then
            if (!dbf.spref.name.eq('/MDS-FRA-PNODS-FRPI') or !dbf.spref.name.eq('/MDS-FRA-PNODS-FRPG')) then
              !ylen = !dbf.prop.ylen
              !xlen = !dbf.prop.xlen
              !noff = !dbf.prop.noff
              !parea = ((((!ylen.real() / 1000 ) * (!xlen.real() / 1000 )) * !mdsvprmobj.strumemb[4][!indx]) * !noff.real() )
              !cf9 = !parea.string('D3')
              if (!!extramatl) then
                !ylen = !dbf.prop.yleb
                !xlen = !dbf.prop.xlen
                !nofa = !dbf.prop.nofa
                !parea = ((((!ylen.real() / 1000 ) * (!xlen.real() / 1000 )) * !mdsvprmobj.strumemb[4][!indx]) * !nofa.real() )
                !cf9 = !parea.string('D3')
              endif
            endif
          endif
          --<GE> 07/03/07
        else
          -- Quantity of Plates i.e. No. OFF
          !cf9  = !mdsvprmobj.strumemb[4][!indx]
        endif
        -- Delivery Designation
        !cf10 = !deld

        -- Insulation, Tracing and Painting
        !cf13 = 'N'
        !cf14 = 'N'
        !cf15 = 'N'

        -- !cf20 = For Requisition
        -- !cf21 = For Construction
        if (!area) then
          !cf20 = 'Y'
          !cf21 = 'N'
        else

          --<wd>mar2006
          -- FANP want ALL of the "U6*" Building Attachments - VPRM REQUISTION Field set to 'Y'
          --!cf20 = 'N'
          --!cf21 = 'Y'
          !spn = !dbf.spref.name
          handle NONE
            if ((!spn.matchwild('*/U6A*')) or (!spn.matchwild('*-U6B*'))) then
              -- Building Attachment -- Set VPRM REQUISTION Field <!cf20> to 'Y'
              !cf20 = 'Y'
              !cf21 = 'Y'
            else
              -- NOT a Building Attachment
              !cf20 = 'N'
              !cf21 = 'Y'
            endif

          elsehandle ANY
            -- NOT a Building Attachment

            !cf20 = 'N'
            !cf21 = 'Y'
          endhandle
          --<wd>mar2006

        endif

        !vprmcomp = !cf1 & ':' & !cf2 & ':' & !cf3 & ':' & !cf4 & ':' & !cf5 & ':' & !cf6 & ':' & !cf7 & ':' & !cf8 & ':' & !cf9 & ':' & !cf10 & ':' & !cf11 & ':' & !cf12 & ':' & !cf13 & ':' & !cf14 & ':' & !cf15 & ':' & !cf16 & ':' & !cf17 & ':' & !cf18 & ':' & !cf19 & ':' & !cf20 & ':' & !cf21 & ':' & !cf22 & ':' & !cf23 & ':' & !cf24 & '*'
        --<GE> 07/03/07 Check to see if the PJOI is a Full Reinforcement type and requires extra matl
        -- recalculate the Quantity of Plates i.e. No. OFF
        if (!dbf.spref.set()) then
          if (!dbf.spref.name.eq('/MDS-FRA-PNODS-FRPI') or !dbf.spref.name.eq('/MDS-FRA-PNODS-FRPG')) then
            !cf9a = !cf9
            !noff = !dbf.prop.noff
            handle any
              !noff = ''
            elsehandle none
              !cf9 = !cf9 * !noff.real()
              handle any
              endhandle
            endhandle

            if (!!extramatl) then
              !nofa = !dbf.prop.nofa
              handle any
                !nofa = ''
              elsehandle none
                !cf9 = !cf9a * !nofa.real()
                handle any
                endhandle
              endhandle
            endif
          endif
          --<GE> 07/03/07

          !vprmcomp = !cf1 & ':' & !cf2 & ':' & !cf3 & ':' & !cf4 & ':' & !cf5 & ':' & !cf6 & ':' & !cf7 & ':' & !cf8 & ':' & !cf9 & ':' & !cf10 & ':' & !cf11 & ':' & !cf12 & ':' & !cf13 & ':' & !cf14 & ':' & !cf15 & ':' & !cf16 & ':' & !cf17 & ':' & !cf18 & ':' & !cf19 & ':' & !cf20 & ':' & !cf21 & ':' & !cf22 & ':' & !cf23 & ':' & !cf24 & '*'
        endif
        return !vprmcomp

      endif

    elseif (!type.eq('HANG')) then

      ---------------------------------------------------------------------
      -- MDS HANGER Components
      !dbf = !mdsvprmobj.hangmemb[2][!mdsvprmobj.hangmemb[5][!indx][1]].dbref()
      !stp = !dbf.type
      !spn = !dbf.spre.name

      -- Check if it's a LISEGA SPRING
      !spring = FALSE
      if (!mdsvprmobj.hangspring.empty().not()) then
        !findspring = !mdsvprmobj.hangspring.find(!dbf)
        if (!findspring.empty().not()) then
          -- The Spring Exists on the MDS Hanger so Create individual VPRM records for "ALL" LISEGA "SPRINGS"
          !spring = TRUE
        endif
      endif

      -- Part Number
      !cf7 = !prtn
      -- Tag number
      !cf8 = !tagn

      -- Quantity or Length Required
      if (!stp.eq('TUBI')) then
        -- Currently the VPRM Length Option is Hard Coded to 'M' <metre> or 'PCS' <No. Off> for LISEGA Implied ROD<TUBI> components
        if ((!spn.matchwild('66?0*')) or (!spn.matchwild('R66?0*')) or (!spn.matchwild('67?0*')) or (!spn.matchwild('R67?0*')))  then
          -- The LISEGA Hanger ROD Codes <Tie Rods 66?0??, R66?0??, and Fully Threaded Rods 67?0?? and R67?0??>e
          !uom = 'M'
          -- Length Required
          !xlen = !dbf.itle.string('d0')
          !xlth = !xlen.length()
          !xnum = !xlen.substring(!xlth,1).real()

          -- Get Real ROD Length in MM plus round up to next 10mm + 50mm as per FANP MTO Transfer Document
          if (!xnum.eq(0)) then
            !rlen = (!xlen.real() + 10 + 50)
          else
            !rlen = !xlen.real() + (10 - !xnum) + 50
          endif
          if (!rlen.lt(1000)) then
            --!slen = '0' & !rlen.string()
          endif
          -- Set ROD Length in METRES
          !mlen = !rlen / 1000

          !cf9 = !mlen.string()

        else

          -- Quantity Required
          -- Implied RODS are processed individually therefore Quantity if "PCS" is always '1'
          -- See method .vprmsununit() for explanation  in "Loop through the MDS HANGER DESCRIPTIONS" at approx. line 2028 above
          !uom = 'PCS'
          !cf9 = '1'
        endif

      elseif (!stp.eq('WPAD')) then
        -- Lisega Hanger WPAD Plate Components

        !area = FALSE
        if (defined(!!novprmtag)) then
          if (!!novprmtag.trim().eq('')) then
            -- PLATE AREA "$P" Record required
            !area = TRUE
          endif
        endif

        -- Get PLATE Details
        -- !cf20 = For Requisition
        -- !cf21 = For Construction
        if (!area) then
          -- Area of Plate in m2 <SM = Square Metres> Required
          !ylen = !dbf.prop.leng
          !xlen = !dbf.prop.widt
          --!zlen = !dbf.prop.heig
          -- Multiply the Plate Area in Square Metres by the Quantity of Plates to get the TOTAL AREA for the PLATE No. Off
          !parea = (((!ylen.real() / 1000 ) * (!xlen.real() / 1000 )) * !mdsvprmobj.hangmemb[4][!indx])
          !cf9 = !parea.string('D3')
          !cf20 = 'Y'
          !cf21 = 'N'

        else
          -- Quantity of Plates Required i.e. No. OFF
          !cf9  = !mdsvprmobj.hangmemb[4][!indx]
          !cf20 = 'N'
          !cf21 = 'Y'

        endif

      else
        -- Check if it's a LISEGA SPRING
        if (!spring) then
          -- LISEGA Spring Quantities are ALWAYS = 1 as there TAG Nos. are UNIQUE
          !cf9 = '1'
        else
          -- Quantity for All Other LISEGA Hanger Components
          !cf9 = !mdsvprmobj.hangmemb[4][!indx]
        endif

      endif

      -- Delivery Designation
      !cf10 = !deld
      !vprmcomp = !cf1 & ':' & !cf2 & ':' & !cf3 & ':' & !cf4 & ':' & !cf5 & ':' & !cf6 & ':' & !cf7 & ':' & !cf8 & ':' & !cf9 & ':' & !cf10 & ':' & !cf11 & ':' & !cf12 & ':' & !cf13 & ':' & !cf14 & ':' & !cf15 & ':' & !cf16 & ':' & !cf17 & ':' & !cf18 & ':' & !cf19 & ':' & !cf20 & ':' & !cf21 & ':' & !cf22 & ':' & !cf23 & ':' & !cf24 & '*'
      return !vprmcomp

      --<nb>jun2007  HPD0035322/OP47  (Generate Support component record)
    elseif (!type.eq('SUPP')) then

      -- Part Number
      !cf7 = !prtn
      -- Tag number
      !cf8 = !tagn
      -- Quantity
      !cf9 = '1'
      -- Delivery Designation
      !cf10 = !deld
      -- Insulation, Tracing and Painting
      !cf13 = 'N'
      !cf14 = 'N'
      !cf15 = 'N'
      -- For Requisition and Construction
      !cf20 = 'Y'
      !cf21 = 'Y'
      -- Construction Area
      !cf24 = ''

      !vprmcomp = !cf1 & ':' & !cf2 & ':' & !cf3 & ':' & !cf4 & ':' & !cf5 & ':' & !cf6 & ':' & !cf7 & ':' & !cf8 & ':' & !cf9 & ':' & !cf10 & ':' & !cf11 & ':' & !cf12 & ':' & !cf13 & ':' & !cf14 & ':' & !cf15 & ':' & !cf16 & ':' & !cf17 & ':' & !cf18 & ':' & !cf19 & ':' & !cf20 & ':' & !cf21 & ':' & !cf22 & ':' & !cf23 & ':' & !cf24 & '*'
      return !vprmcomp

    endif

  endmethod

  -------------------------------------------------------------------------------
  -------------------------------------------------------------------------------

  -- Method:      .vprmcompuda
  --
  -- Determine the MDS to VPRM MTO File Input COMPONENT UDA Record for Each MDS Support Object
  -- There are 10<TEN> PDMS Component UDAs available in the VPRM Config File, but TWO PDMS UDAS
  -- may be concatenated to obtain the value required for the VPRM Component UDA
  --
  define method .vprmcompuda(!type is STRING,!indx is REAL,!mdsvprmobj is MDSVPRMMTO,!vprmconfig is VPRMCONFIG) is ARRAY
    -- "$U" -- Concatenate the MDS Support COMPONENT UDA Record <3 fields>

    -- Initialise Variable
    !udacomparray = ARRAY()
    !cuf1 = '$U'
    --<wd>mar2000
    !xce = !!ce



    -- Determine the DATUM Atta for the MDS Support
    if (!mdsvprmobj.supptype.eq('STRU')) then
      ---------------------------------------------------------------------
      -- Get the Name of the Master MDS Support Datum Atta
      !suppname = !mdsvprmobj.support.name
      !attaname = !suppname & '/DATUM'
      !attadbrf = !attaname.dbref()

    elseif (!mdsvprmobj.supptype.eq('HANG')) then
      ---------------------------------------------------------------------

      -- Get the DBREF of the ATTA Connecting to the MDS Hanger
      !attadbrf = !mdsvprmobj.support

    elseif (!mdsvprmobj.supptype.eq('ATTA')) then
      ---------------------------------------------------------------------

      !attadbrf = !mdsvprmobj.support

    else
      ---------------------------------------------------------------------

      --<wd>mar2006
      !!ce = !xce

      -- Return an EMPTY ARRAY
      return !udacomparray

    endif

    -- Get the Owning PIPE of the MAIN/DATUM Atta on the MDS Support
    !attapipe = !attadbrf.owner.owner

    -- Get the VPRM Uda names and the Corresponding Values of the PDMS UDAs and Build the Arrays
    !compudasvprm = ARRAY()
    !compudaspdms = ARRAY()
    do !xndx from 1 to 10
      -- Add the VPRM UDA names stored in the Object "!vprmconfig" to an ARRAY
      !compudasvprm[!xndx]  = !vprmconfig.cvprmuda$!<xndx>

      -- Add the PDMS Attribute/UDA names stored in the Object "!vprmconfig" to an ARRAY
      !compudaspdms[!xndx] = ARRAY()
      !compudaspdms[!xndx].append(!vprmconfig.compuda$!<xndx>1)
      !compudaspdms[!xndx].append(!vprmconfig.compuda$!<xndx>2)
    enddo

    -- Determine the Values for Each VPRM comp "$U" record for the MDS Support
    do !numb indices !compudasvprm
      skip if (!compudasvprm[!numb].eq(' '))
      !cuf2  = !compudasvprm[!numb]
      --$P !cuf2 is $!cuf2

      -- Determine the Concatenated Values from the PDMS attributes
      -- The VPRM UDA name is Defined in "!cuf2", i.e. it is "neq(' ')", therefore proceed
      !cuda1 = !compudaspdms[!numb][1]
      !cuda2 = !compudaspdms[!numb][2]
      --$P !cuda1 is $!cuda1
      --$P !cuda2 is $!cuda2
      -- Get the PDMS Data from the ATTA
      -- First UDA Value MUST be a STRING
      --<wd>mar2006
      --!cuda1val = !attadbrf.$!<cuda1>.string()
      !!ce = !attadbrf
      !cuda1val = $!<cuda1>
      --<wd>mar2006
      handle ANY
        !cuda1val =''
      elsehandle NONE
        !cuda1val = !cuda1val.trim()
        if (!cuda1val.eq('unset')) then
          !cuda1val =''
        endif
      endhandle

      $(
      -- But if unset then Get it from the Pipe
      if (!cuda1val.trim().eq('')) or (!cuda1val.unset()) then
        --        !cuda1val = !attapipe.$!<cuda1>.string()
        !!ce = !attapipe
        !cuda1val = $!<cuda1>
        handle ANY
          !cuda1val =''
        elsehandle NONE
          !cuda1val = !cuda1val.trim()
        endhandle
        !xce = !!ce
      endif
      $)
      --$P !cuda1val is **$!<cuda1val>**

      -- Second UDA Value MUST be a STRING
      --<wd>mar2006
      --!cuda1va2 = !attadbrf.$!<cuda2>.string()
      !!ce = !attadbrf
      !cuda2val = $!<cuda2>
      --<wd>mar2006
      handle ANY
        !cuda2val =''
      elsehandle NONE
        !cuda2val = !cuda2val.trim()
        if (!cuda2val.eq('unset')) then
          !cuda2val =''
        endif
      endhandle

      $(
      -- But if unset then Get it from the Pipe
      if (!cuda2val.trim().eq('')) or (!cuda2val.unset()) then
        --        !cuda2val = !attapipe.$!<cuda2>.string()
        !!ce = !attapipe
        !cuda2val = $!<cuda2>
        handle ANY
          !cuda2val =''
        elsehandle NONE
          !cuda2val = !cuda2val.trim()
        endhandle
        !xce = !!ce
      endif
      $)
      --$P !cuda2val is $!cuda2val

      -- Combine the PDMS Values of UDA 1 and UDA 2
      !cuf3 = !cuda1val & ' ' & !cuda2val
      if (!cuf3.eq(' ')) then
        !cuf3 = ''
      endif
      !cuf3 = !cuf3.trim().replace(' ','')

      -- Concatenate the comp "$U" record
      !vprmudacomp = !cuf1 & ':' & !cuf2 & ':' & !cuf3 & '*'

      -- Append comp "SU" records to the ARRAY
      !udacomparray.append(!vprmudacomp)
    enddo

    -- When the component is a MDS ANCILLARY Support i.e. an ATTA
    -- Add the Quality Class and the Safety Class of the MDs Support
    if (!type.eq('ATTA')) then
      -- Quality Class
      !cuf2 = 'QUALITYCLASS'
      !cuf3 = !mdsvprmobj.qualityclass
      if (!cuf3.eq('unset')) then
        !cuf3 = ''
      endif
      -- Concatenate the comp "$U" record for Quality Class
      !vprmudacomp = !cuf1 & ':' & !cuf2 & ':' & !cuf3 & '*'
      !udacomparray.append(!vprmudacomp)

      -- Safety Class
      !cuf2 = 'SAFETYCLASS'
      !cuf3 = !mdsvprmobj.safetyclass
      if (!cuf3.eq('unset')) then
        !cuf3 = ''
      endif
      -- Concatenate the comp "$U" record for Safety Class
      !vprmudacomp = !cuf1 & ':' & !cuf2 & ':' & !cuf3 & '*'
      !udacomparray.append(!vprmudacomp)
    endif
    --<wd>mar2006
    !!ce = !xce

    -- Return the ARRAY of VPRM Component "$U" records for the MDS Support Component
    return !udacomparray

  endmethod

  -------------------------------------------------------------------------------
  -------------------------------------------------------------------------------

  -- Method:      .vprmlineuda
  --
  -- Determine the MDS to VPRM MTO File Input comp UDA Record for Each MDS Support Object
  -- There are 10<TEN> VPRM Line UDAs available in the VPRM Config File, but TWO PDMS UDAS
  -- may be concatenated to obtain the value required for the VPRM Line UDA
  --
  define method .vprmlineuda(!mdsvprmobj is MDSVPRMMTO,!vprmconfig is VPRMCONFIG) is ARRAY
    -- "$U" -- Concatenate the MDS Support Line UDA Record <3 fields>

    -- Initialise Variable
    !udalinearray = ARRAY()
    !luf1 = '$U'

    -- Determine the DATUM Atta for the MDS Support
    if (!mdsvprmobj.supptype.eq('STRU')) then
      -- Get the Name of the Master MDS Support Datum Atta
      !suppname = !mdsvprmobj.support.name
      !attaname = !suppname & '/DATUM'
      !attadbrf = !attaname.dbref()

    elseif (!mdsvprmobj.supptype.eq('HANG')) then
      -- Get the DBREF of the ATTA Connecting to the MDS Hanger
      !attadbrf = !mdsvprmobj.support

    elseif (!mdsvprmobj.supptype.eq('ATTA')) then
      !attadbrf = !mdsvprmobj.support

    else
      -- Return an EMPTY ARRAY
      return !udalinearray

    endif

    -- Get the Owning PIPE of the MAIN/DATUM Atta on the MDS Support
    !attapipe = !attadbrf.owner.owner

    -- Get the VPRM Uda names and the Corresponding Values of the PDMS UDAs and Build the Arrays
    !lineudasvprm = ARRAY()
    !lineudaspdms = ARRAY()
    do !indx from 1 to 10
      -- Add the VPRM UDA names stored in the Object "!vprmconfig" to an ARRAY
      !lineudasvprm[!indx]  = !vprmconfig.pvprmuda$!indx

      -- Add the PDMS Attribute/UDA names stored in the Object "!vprmconfig" to an ARRAY
      !lineudaspdms[!indx] = ARRAY()
      !lineudaspdms[!indx].append(!vprmconfig.lineuda$!<indx>1)
      !lineudaspdms[!indx].append(!vprmconfig.lineuda$!<indx>2)
    enddo

    -- Determine the Values for Each VPRM Line "$U" record for the MDS Support
    do !numb indices !lineudasvprm
      skip if (!lineudasvprm[!numb].eq(' '))
      !luf2  = !lineudasvprm[!numb]
      --$P !luf2 is $!luf2

      -- Determine the Concatenated Values from the PDMS attributes
      -- The VPRM UDA name is Defined in "!luf2", i.e. it is "neq(' ')", therefore proceed
      !luda1 = !lineudaspdms[!numb][1]
      !luda2 = !lineudaspdms[!numb][2]
      --$P !luda1 is $!luda1
      --$P !luda2 is $!luda2
      -- Get the PDMS Data from the ATTA, but if unset then Get from the Pipe
      -- First UDA Value MUST be a STRING
      !luda1val = !attadbrf.$!<luda1>.string()
      handle ANY
        !luda1val =''
      elsehandle NONE
        !luda1val = !luda1val.trim()
        if (!luda1val.eq('unset')) then
          !luda1val =''
        endif
      endhandle
      if ((!luda1val.trim().eq('')) or (!luda1val.unset())) then
        !luda1val = !attapipe.$!<luda1>.string()
        handle ANY
          !luda1val =''
        elsehandle NONE
          !luda1val = !luda1val.trim()
          if (!luda1val.eq('unset')) then
            !luda1val =''
          endif
        endhandle
      endif
      --$P !luda1val is **$!<luda1val>**

      -- Second UDA Value MUST be a STRING
      !luda2val = !attadbrf.$!<luda2>.string()
      handle ANY
        !luda2val =''
      elsehandle NONE
        !luda2val = !luda2val.trim()
        if (!luda2val.eq('unset')) then
          !luda2val =''
        endif
      endhandle
      if ((!luda2val.trim().eq('')) or (!luda2val.unset())) then
        !luda2val = !attapipe.$!<luda2>.string()
        handle ANY
          !luda2val =''
        elsehandle NONE
          !luda2val = !luda2val.trim()
          if (!luda2val.eq('unset')) then
            !luda2val =''
          endif
        endhandle
      endif
      --$P !luda2val is $!luda2val

      -- Combine the PDMS Values of UDA 1 and UDA 2
      !luf3 = !luda1val & ' ' & !luda2val
      if (!luf3.eq(' ')) then
        !luf3 = ''
      endif
      !luf3 = !luf3.trim().replace(' ','')

      -- Concatenate the Line "$U" record
      !vprmudaline = !luf1 & ':' & !luf2 & ':' & !luf3 & '*'

      -- Append Line "SU" records to the ARRAY
      !udalinearray.append(!vprmudaline)
    enddo
    --**********************************************************************************
    --<GE> 11/10/06 Added the following for UDA's for QC/SC for VPRM MTO Unit level
    -- only when Section 01 exists in the file i.e. there is an Ancillary in the support.
    if ((!attadbrf.type.eq('ATTA')) and !attadbrf.stype.neq('PIPE-REST')) then
      if (!attadbrf.stype.neq('HVAC-REST') and !attadbrf.stype.neq('MH01')) then
        if ((matchwild (!attadbrf.spref.name,'/MDS/*')) or (matchwild (!attadbrf.spref.name,'/MDF/*'))) then
          --   Quality Class
          !luf2 = 'QUALITYCLASS'
          !luf3 = !mdsvprmobj.qualityclass
          if (!luf3.eq('unset')) then
            !luf3 = ''
          endif
          --   Concatenate the comp "$U" record for Quality Class
          !vprmudaline = !luf1 & ':' & !luf2 & ':' & !luf3 & '*'
          !udalinearray.append(!vprmudaline)

          --   Safety Class
          !luf2 = 'SAFETYCLASS'
          !luf3 = !mdsvprmobj.safetyclass
          if (!luf3.eq('unset')) then
            !luf3 = ''
          endif
          --   Concatenate the comp "$U" record for Safety Class
          !vprmudaline = !luf1 & ':' & !luf2 & ':' & !luf3 & '*'
          !udalinearray.append(!vprmudaline)
        endif
      endif
    endif
    --<GE> 29/09/09
    --**********************************************************************************

    -- Return the ARRAY of VPRM Line "$U" records for the MDS Support
    return !udalinearray

  endmethod

  -------------------------------------------------------------------------------
  -------------------------------------------------------------------------------

  -- Method:      .mtestsheet
  --
  -- Determine the FANP "Material Test Sheet <MTS>" of the MATERIAL of a MDS Support Structural Member
  --
  --
  define method .mtestsheet (!mdsvprmobj is MDSVPRMMTO,!matref is DBREF, !type is STRING, !zlen is STRING) is STRING
    --
    -- Determine the Material Test Sheet <MTS> from the passed MDS Support Structural
    -- Component "MATERIAL" and the "Safety Class<SC>" of the current MDS Support
    !sclass   = !mdsvprmobj.safetyclass

    -- Determine the <MTS> value from the MDS Support Safety Class <SC>
    if (!type.eq('SCTN')) then
      -- SCTN Element Types of a MDS Support Only
      if (!sclass.eq(|SC2|)) then
        !mts = !matref.:mdsmts.part(1,|\|)
        handle ANY
          !mts = 'unset'
        endhandle
      elseif (!sclass.eq(|SC3|)) then
        !mts = !matref.:mdsmts.part(2,|\|)
        handle ANY
          !mts = 'unset'
        endhandle
      else
        -- All Other MDS Support Safety Classes
        !mts = !matref.:mdsmts.part(3,|\|)
        handle ANY
          !mts = 'unset'
        endhandle
      endif

    else
      -- FANP MTS values for PLATE elements depends on the PLATE Thickness and Material
      !pthk = !zlen.real()
      -- Structural Element Types <PJOI>, <SJOI>, <FITT> or <BOX>
      if (!sclass.eq(|SC2|)) then
        if (!pthk.gt(20)) then
          !mts = !matref.:mdsmts.part(4,|\|)
          handle ANY
            !mts = 'unset'
          endhandle
        else
          !mts = !matref.:mdsmts.part(1,|\|)
          handle ANY
            !mts = 'unset'
          endhandle
        endif

      elseif (!sclass.eq(|SC3|)) then
        if (!pthk.gt(20)) then
          !mts = !matref.:mdsmts.part(5,|\|)
          handle ANY
            !mts = 'unset'
          endhandle
        else
          !mts = !matref.:mdsmts.part(2,|\|)
          handle ANY
            !mts = 'unset'
          endhandle
        endif

      else
        -- All Other MDS Support Safety Classes
        if (!pthk.gt(20)) then
          !mts = !matref.:mdsmts.part(6,|\|)
          handle ANY
            !mts = 'unset'
          endhandle
        else
          !mts = !matref.:mdsmts.part(3,|\|)
          handle ANY
            !mts = 'unset'
          endhandle
        endif

      endif
    endif

    -- Return the Material Test Sheet <MTS> value
    return !mts

  endmethod

  -------------------------------------------------------------------------------
  -------------------------------------------------------------------------------

  -- Method:      .matgroup
  --
  -- Determine the FANP "MATERIAL GROUP" of a MDS Support Structural Member
  --
  --
  define method .matgroup (!mdsvprmobj is MDSVPRMMTO,!matref is DBREF, !type is STRING, !zlen is STRING) is STRING
    --
    -- Determine the MTS<Material Test Sheet> "Material Group<:mdsmatgroup>" from the passed MDS Support Structural
    -- Component "MATERIAL<MATREF>" and the *** "Safety Class<SC>" of the current MDS SUPPORT ***
    !sclass   = !mdsvprmobj.safetyclass

    -- Determine the <MatGroup> value from the MDS Support Safety Class <SC>
    if (!type.eq('SCTN')) then

      -- SCTN Element Types of a MDS Support Only
      if (!sclass.eq(|SC2|)) then
        !mtg = !matref.:mdsmatgroup.part(1,|\|)
        handle ANY
          !mtg = 'unset'
        endhandle
      elseif (!sclass.eq(|SC3|)) then
        !mtg = !matref.:mdsmatgroup.part(2,|\|)
        handle ANY
          !mtg = 'unset'
        endhandle
      else
        -- All Other MDS Support Safety Classes
        !mtg = !matref.:mdsmatgroup.part(3,|\|)
        handle ANY
          !mtg = 'unset'
        endhandle
      endif

    else
      -- FANP MTS values for PLATE elements depends on the PLATE Thickness and Material
      !pthk = !zlen.real()
      -- Structural Element Types <PJOI>, <SJOI>, <FITT> or <BOX>
      if (!sclass.eq(|SC2|)) then
        if (!pthk.gt(20)) then
          !mtg = !matref.:mdsmatgroup.part(4,|\|)
          handle ANY
            !mtg = 'unset'
          endhandle
        else
          !mtg = !matref.:mdsmatgroup.part(1,|\|)
          handle ANY
            !mtg = 'unset'
          endhandle
        endif

      elseif (!sclass.eq(|SC3|)) then
        if (!pthk.gt(20)) then
          !mtg = !matref.:mdsmatgroup.part(5,|\|)
          handle ANY
            !mtg = 'unset'
          endhandle
        else
          !mtg = !matref.:mdsmatgroup.part(2,|\|)
          handle ANY
            !mtg = 'unset'
          endhandle
        endif

      else
        -- All Other MDS Support Safety Classes
        if (!pthk.gt(20)) then
          !mtg = !matref.:mdsmatgroup.part(6,|\|)
          handle ANY
            !mtg = 'unset'
          endhandle
        else
          !mtg = !matref.:mdsmatgroup.part(3,|\|)
          handle ANY
            !mtg = 'unset'
          endhandle
        endif

      endif
    endif

    -- Return the Material Group value
    return !mtg

  endmethod

  -------------------------------------------------------------------------------
  -------------------------------------------------------------------------------

  -- Method:      .mdsfanpcomp
  --
  --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q5*" SCTN type added
  -- Determine the FANP -- "L" value of a MDS Support "Q3*" or "Q4*" or "Q5*" type SCTN
  --
  --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q2P" SCTN type added
  -- *** but NOT a "Q2" or "Q2P" type SCTN ***
  --
  -- Determine the FANP -- Weight of a "Q3*" or "Q4*" or "Q5O" type SCTN, but EXCLUDE the WEIGHT of the "U6*" Building Attachments
  --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q2P" SCTN type added
  -- *** but NOT a "Q2" or "Q2P" type SCTN ***
  --
  ----------------------------------------------------------------------------------------------------
  define method .mdsfanpcomp (!fanpcomp is DBREF, !apptype is STRING, !required is STRING ) is STRING

    -- Determine what is required?
    if (!apptype.eq('MDS-VPRM-MTO')) then

      -- *********************************
      -- MDS VPRM MTO -- FANP requirements
      -- *********************************

      ----------------------------------------------------------------------------------------------------
      -- ************
      -- *** NOTE ***
      -- ************
      --
      -- PINS cannot be positioned in PDMS DRAFT so use POINTVECTOR OBJECTS
      --
      ----------------------------------------------------------------------------------------------------

      if (!required.eq('Q-SCTN-LENGTH')) then
        -- Determine the FANP -- ***"L"*** value of a MDS Support "Q3*" or "Q4*" type SCTN
        -- It is NOT the standard SCTN "TCTL" attribute
        -- See the "MARKED-UP" -- "L" -- Dimensions on the FANP Support Design Document "ZEN 000"-- Revision "A"                                                                                                                                                                                                               type SCTN
        --!!mdsresetpins(6,9)
        !fnc = !fanpcomp.function
        -- Get the SJOI representing the "INSERT" for the "Q" type SCTN
        !qin = !!kcollectallfor('SJOI','matchwild(name of spref,|/MDS-FRA-SNODS/Insert/*|)', !fanpcomp)

        --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q3N","Q3O","Q4N","Q4P","Q5O" SCTN types added
        --            if ((!fnc.matchwild('Q3M-?')) or (!fnc.matchwild('Q4M-?')) or (!fnc.matchwild('Q4-?'))) then
        if ((!fnc.matchwild('Q3M-?')) or (!fnc.matchwild('Q3N-?')) or (!fnc.matchwild('Q3O-?')) or $
        (!fnc.matchwild('Q4M-?')) or (!fnc.matchwild('Q4-?')) or (!fnc.matchwild('Q4N-?')) or $
        (!fnc.matchwild('Q4P-?')) or (!fnc.matchwild('Q5O-?'))) then
        --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q3N","Q3O","Q4N","Q4P","Q5O" SCTN types added

        -----------------------------------------------------------------
        -- ONLY ONE SJOI is used for the "INSERT" on these "Q" type SCTNS
        -----------------------------------------------------------------
        $(
        -- Initialise and Position Pins
        pin 6 at $!qin[1]
        pin 8 at poss of $!fanpcomp
        pin 9 at pose of $!fanpcomp
        pin 6 dir to pin 8
        pin 8 dir to pin 6
        pin 9 dir to pin 6

        -- Check Pin Distances and Determine the "L" value for the "Q" SCTN
        !pin6pin8dist = !!kstrreal('cons dist pin 6 to plane pin 8')
        !pin6pin9dist = !!kstrreal('cons dist pin 6 to plane pin 9')
        !greaterdist  = (max(!pin6pin8dist,!pin6pin9dist))
        !qsctnlength  = !greaterdist.string('d0')
        $)
        -- Initialise and Position POINTVECTOR objects
        !snodpv = object POINTVECTOR()
        !posspv = object POINTVECTOR()
        !posepv = object POINTVECTOR()
        !snodpv.position = !qin[1].position.wrt(/* )
        !posspv.position = !fanpcomp.poss.wrt(/* )
        !posepv.position = !fanpcomp.pose.wrt(/* )


        -- Check POINTVECTOR object POSITION Distances and Determine the "L" value for the "Q" SCTN
        !snodpossdist = !!kstrreal('cons dist $!snodpv.position to $!posspv.position  ')
        !snodposedist = !!kstrreal('cons dist $!snodpv.position to $!posepv.position  ')
        !greaterdist  = (max(!snodpossdist,!snodposedist))

        !qsctnlength  = !greaterdist.string('d0')


        --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q3P" SCTN type added
        --elseif (!fnc.matchwild('Q3-?')) then
      elseif ((!fnc.matchwild('Q3-?')) or (!fnc.matchwild('Q3P-?'))) then
        --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q3P" SCTN type added
        -----------------------------------------------------------------
        -- TWO SJOIS are used for the "INSERTS" on this "Q" type SCTN
        -----------------------------------------------------------------

        $(
        -- Initialise and Position Pins
        pin 6 at $!qin[1]
        pin 7 at $!qin[2]
        pin 6 dir to pin 7
        pin 7 dir to pin 6

        -- Check Pin Distances and Determine the "L" value for the "Q" SCTN
        !pin6pin7dist = !!kstrreal('cons dist pin 6 to plane pin 7')
        !qsctnlength  = !pin6pin7dist.string('d0')
        $)

        -- Initialise and Position POINTVECTOR objects
        !snod1pv = object POINTVECTOR()
        !snod2pv = object POINTVECTOR()

        !snod1pv.position = !qin[1].position.wrt(/* )
        !snod2pv.position = !qin[2].position.wrt(/* )

        -- Check POINTVECTOR object POSITION Distances and Determine the "L" value for the "Q" SCTN
        !snod1snod2dist = !!kstrreal('cons dist $!snod1pv.position to $!snod2pv.position')

        !qsctnlength  = !snod1snod2dist.string('d0')

      endif

      --!qsctnlength = !fanpcomp.tctl.string('d0')

      return !qsctnlength

    elseif (!required.eq('Q-SCTN-WEIGHT')) then

      --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q5*" SCTN type added
      -- Determine the FANP -- Weight of a  "Q3*" or "Q4*" or "Q5*" type SCTN
      -------------------------------------------------------------------
      -- WEIGHT of "Q3*" and "Q4*" and "Q5* type SCTNS to -- ***INCLUDE***
      -- "ALL the WELDED END PLATES" and the "TUBE/PIN INSERTS",
      -- but ***NOT*** the WEIGHT of the "U6*" type Building Attachments.
      -- Also EXCLUDED is the WEIGHT of the 2nd SCTN required for the
      -- NEW  "Q3O" and "Q5O" SCTN types
      -------------------------------------------------------------------
      --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q5*" SCTN type added

      !fnc = !fanpcomp.function
      !siz = !fnc.after('-')
      !sln = !fanpcomp.tctl
      !wex = (!fanpcomp.prop.uwig.real() * (!sln.real() / 1000))
      --!wei = !wex.string('d1')

      -- WEIGHTS extracted from FANP Support catalogue Design Document for Supported Beam Q2-Q4
      -- Section 8.2.0 Sheet 1 of KW-No. ZEN 000 Revion A
      -- FANP Weight in kgs. of the Weld-On Panel<Item 2 - END Plates> for FANP Size Codes
      ------------------------------------------------------------------------------------
      --!zpl = 0.19
      --!apl = 0.32
      --!bpl = 0.47
      --!cpl = 0.66
      --!dpl = 0.83
      --!epl = 1.07
      --!fpl = 1.34
      --!gpl = 1.65
      --!ipl = 2.36

      -- WEIGHTS extracted from FANP Support catalogue Design Document for Supported Beam Q2-Q4
      -- Section 8.2.0 Sheet 1 of KW-No. ZEN 000 Revion A
      -- FANP Weight in kgs. of the Weld-In TUBE <Item3 - TUBE Insert> for FANP Size Codes
      ------------------------------------------------------------------------------------
      --!ztu = 0.27
      --!atu = 0.28
      --!btu = 0.40
      --!ctu = 0.40
      --!dtu = 0.47
      --!etu = 0.89
      --!ftu = 0.99
      --!gtu = 1.10
      --!itu = 1.36

      !plat = '!' & !siz & 'pl'
      !tube = '!' & !siz & 'tu'

      --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q3N","Q3O","Q4N","Q4P","Q5O" SCTN types added
      --        if (!fnc.matchwild('Q3M-?')) then
      if ((!fnc.matchwild('Q3M-?')) or (!fnc.matchwild('Q3N-?'))) then
        -- <1 x SCTN + 1 x END Plate + 1 x TUBE Insert>
        !twei = !wex + $!plat + $!tube

        --        elseif (!fnc.matchwild('Q3-?')) then
      elseif ((!fnc.matchwild('Q3-?')) or (!fnc.matchwild('Q3P-?'))) then
        -- <1 x SCTN + 2 x END Plates + 2 x TUBE Inserts>
        !twei = !wex + (2 * $!plat ) + (2 * $!tube )

        --        elseif ((!fnc.matchwild('Q4M-?')) or (!fnc.matchwild('Q4-?'))) then
      elseif ((!fnc.matchwild('Q4M-?')) or (!fnc.matchwild('Q4-?')) or (!fnc.matchwild('Q4N-?')) or (!fnc.matchwild('Q4P-?'))) then
        -- <1 x SCTN + 1 x TUBE Insert>
        !twei = !wex + $!tube

      elseif ((!fnc.matchwild('Q3O-?')) or (!fnc.matchwild('Q5O-?'))) then
        -- <1 x SCTN + 2 x END Plates + 1 x TUBE Inserts>
        !twei = !wex + (2 * $!plat ) + (2 * $!tube )

        --<wd>04mar2010 - DUN1233 - CCT project DESIGN TMPL and CATA Update - "Q3N","Q3O","Q3P","Q4N","Q4P","Q5O" SCTN types added

      endif
      --$P************************************************
      --q var !wex $!plat $!tube

      !qsctnweight = !twei.string('d1')
      return !qsctnweight

      --      elseif (!required.eq('U6-WEIGHT')) then
      -- Determine the FANP -- Weight of a "U6" Building Attachment

      --        return !u6weight

    elseif (!required.eq('PLAT-WEIGHT')) then
      -- dtf
      -- get volume of plate

      !vol = nvol of $!fanpcomp
      !weig = !vol * 7850 / 1000 / 1000 / 1000
      --!twei = !weig.string()
      !twei = !weig.string('D1')

      return !twei
      --        !twei =
    endif

  elseif (!apptype.eq('MDS-ABA-DRAWING')) then

    --**************************************************************
    -- MDS ABA DRAWING -- FANP PARTS LIST requirements *** ONLY ***
    --*** NOT REQUIRED -- See the FANP MDS ABA DRAWING TASKS!!! ***
    --**************************************************************

  endif

  -- Method Test ONLY
  !name = !fanpcomp.name
  return !name


endmethod

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Method:      .setsafetyclass
--
-- if the pipe quality class is QC1 we need to add -S1 to the string passed
-- The string may be the tag number or part number
--
--
-- dtf >>> 18.11.05 extra method .setsafetyclass added
define method .setsafetyclass(!type is STRING, !dbf is DBREF, !string is STRING,!mdsvprmobj is MDSVPRMMTO ) is STRING
  -- dtf >>> 18.11.05 extra method added
  -- q var !type
  -- q var !dbf.string()
  if (!type.eq('ATTA')) then
    !currentPipe = !dbf.owner.owner
  elseif (!type.eq('HANG')) then
    if (!dbf.type.eq('SPCO') or !dbf.type.eq('TUBI')) then
      return !string
    endif
    !currentPipe = !dbf.owner.href.owner.owner
    if (!currentPipe.type.eq('REST')) then
      -- we must have been at hanger 2
      !currentPipe = !dbf.owner.href.owner.href.owner.owner
    endif
    !spn = !dbf.spre.name.part(3, '/')

  elseif (!type.eq('STRU')) then
    !tqc = !mdsvprmobj.qualityclass.after('QC')
  else

  endif

  -------------------------------------------------
  --<wd>mar2006
  --<dw>jul2008 - Additional error handle
  -- We Should be testing the QCLASS UDA set in the VPRMCONFIG file!!!!
  if (!type.eq('ATTA') or !type.eq('HANG')) then
    !qualityclas = :FRA.qcl of $!currentPipe
    handle(99,532)(2,204)
      !qualityclas = function  of $!currentPipe
    endhandle
    -- We Should be testing the QCLASS UDA set in the VPRMCONFIG file!!!!
    --<wd>mar2006
    -------------------------------------------------

  elseif (!type.eq('STRU')) then
    if (!tqc.eq(1)) then
      !qualityclas = 'QC1'
    else
      !qualityclas = ||
    endif
  endif

  if (!qualityclas.lowcase().eq('unset') or !qualityclas.lowcase().eq('') ) then
    if (!type.eq('ATTA') or !type.eq('HANG')) then
      --<wd>mar2006 -- FANP -- W.Wumnig wants the error 'Pipe Quality Class is *unset*'
      --!errortype = 'Pipe Safety Class is *unset*'
      !errortype = 'Pipe Quality Class is *unset*'
      --<wd>mar2006
    elseif (!type.eq('STRU')) then
      !errortype = 'Quality Class is *unset*'
    endif
    !errorcomp = !dbf.fullname
    !mdsvprmobj.errorarray.append(' ERROR -- MDS Support $!type Component $!errorcomp $!errortype')
    !mdsvprmobj.errorarray.append('  MDS Support VPRM MTO will not contain this component')
    -- Return 'ERROR' for the MDS Component TAG No.
    return 'ERROR'
  endif

  -- ********* Ancills *********
  if (!type.eq('ATTA')) then
    if ( !string.matchwild('V4?GA*') or !string.matchwild('V4?GB*') or !string.matchwild('V3?FC*') or !string.matchwild('V3?FD*')  $
    or !string.matchwild('V3?FE*') or !string.matchwild('V3?FN*') or !string.matchwild('V3?FH*') or !string.matchwild('V3?XE*')  $
    or !string.matchwild('V3?XN*') or !string.matchwild('V3?XH*') or !string.matchwild('V4?XC*') or !string.matchwild('V6?GA*')) then

    if (!qualityclas.eq('QC1')) then
      !string = !string & '-S1'
    endif
  endif
endif

-- ********* Hanger Elements *********
if (!type.eq('HANG')) then
  if ((!spn.matchwild('T9?LX*') or !spn.matchwild('T9?KX*') or !spn.matchwild('74*') or !spn.matchwild('75*') $
  or !spn.matchwild('36*') or !spn.matchwild('37*') or !spn.matchwild('34SG*') or !spn.matchwild('44*')) $
  and !dbf.owner.type.eq('HANG')) then
  if (!qualityclas.eq('QC1')) then
    !string = !string & '-S1'
  endif
endif
endif

-- ********* STRU Elements *********
if (!string.matchwild('*U6B*') and !tqc.eq('1')) then
  --<wd>aug2006 -- Return !string (!tf2 has never been returned) for the MDS Component PART/TAG No.
  --!tf2 = !tf2 & '-S1'
  !string = !tf2 & '-S1'
  --<wd>aug2006
endif

return !string


endmethod

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
--
-->--<wd>mar2006 -- This METHOD ADDED -->
--
-- Method:      .mdsaustshld( !partnum is STRING )is BOOLEAN
--
-- Determine if the PART No. requires an AUSTENITIC INLAY PLATE for the MDS to VPRM MTO
-- Ensure the ARRAY of PART Nos. includes those with the new "-S1" suffix <Pipe Safety Class>
-- set for ALL PART Nos. attached directly to a PIPE with a QUALITY CLASS of "QC1"
--
-- Return: TRUE = YES and FALSE = NO
--
--
define method .mdsaustshld(!partnum is STRING) is BOOLEAN

  -- Initialise Array of Valid Part Nos. requiring an AUSTENITIC INLAY PLATE for the MDS to VPRM MTO
  !partnumarr = ARRAY()

  -- Append to the ARRAY "ALL" MDS ATTA Ancillaries and MDS LISEGA Hanger PIPE CLAMPS directly
  -- attached to a PIPE that "FRAMATOME ANP" have determined require an AUSTENITIC INLAY PLATE
  --
  -- List "ALL" MDS ATTA Ancillaries requiring an AUSTENITIC INLAY PLATE
  !partnumarr.append('V1_GH')
  !partnumarr.append('V1_GN')
  !partnumarr.append('V4_GA')
  !partnumarr.append('V4_GB')
  !partnumarr.append('V4_GC')
  !partnumarr.append('V6_GA')
  !partnumarr.append('V6_GB')
  !partnumarr.append('V3_XE')
  !partnumarr.append('V3_XH')
  !partnumarr.append('V3_XN')
  !partnumarr.append('V4_XC')
  --<wd>01mar2010 - DUN1233 - Modifications to AREVA Support types for AREVA Taishan Project
  -- Types AT181(W6_CAB) and AT182(W6_CBB) now replace AT137(W6_CA) and AT138(W6_CB)
  --    !partnumarr.append('W6_CA')
  --    !partnumarr.append('W6_CB')
  !partnumarr.append('W6_CAB')
  !partnumarr.append('W6_CBB')
  --<wd>01mar2010 - DUN1233 - Modifications to AREVA Support types
  !partnumarr.append('LIS40-70TS')
  !partnumarr.append('LIS49A')
  !partnumarr.append('LISR49A')
  !partnumarr.append('LIS49G')
  !partnumarr.append('LISR49G')
  !partnumarr.append('LIS49L')
  !partnumarr.append('LISR49L')
  -- Include ALL PART Nos. with the new "-S1" suffix <Pipe Safety Class>
  -- which are attached directly to a PIPE with a QUALITY CLASS of "QC1"
  !partnumarr.append('V1_GH-S1')
  !partnumarr.append('V1_GN-S1')
  !partnumarr.append('V4_GA-S1')
  !partnumarr.append('V4_GB-S1')
  !partnumarr.append('V4_GC-S1')
  !partnumarr.append('V6_GA-S1')
  !partnumarr.append('V6_GB-S1')
  !partnumarr.append('V3_XE-S1')
  !partnumarr.append('V3_XH-S1')
  !partnumarr.append('V3_XN-S1')
  !partnumarr.append('V4_XC-S1')
  !partnumarr.append('LIS40-70TS-S1')
  !partnumarr.append('LIS49A-S1')
  !partnumarr.append('LISR49A-S1')
  !partnumarr.append('LIS49G-S1')
  !partnumarr.append('LISR49G-S1')
  !partnumarr.append('LIS49L-S1')
  !partnumarr.append('LISR49L-S1')
  --
  -- List "ALL" MDS LISEGA Hanger PIPE CLAMPS requiring an AUSTENITIC INLAY PLATE
  !partnumarr.append('LIS34')
  !partnumarr.append('LIS36')
  !partnumarr.append('LIS37')
  !partnumarr.append('LIS42')
  !partnumarr.append('LIS43')
  !partnumarr.append('LIS44')
  !partnumarr.append('LIS45')
  !partnumarr.append('LIS48')
  !partnumarr.append('LIS49H')
  !partnumarr.append('LIS49HG')
  !partnumarr.append('LISR34')
  !partnumarr.append('LISR36')
  !partnumarr.append('LISR37')
  !partnumarr.append('LISR42')
  !partnumarr.append('LISR43')
  !partnumarr.append('LISR44')
  !partnumarr.append('LISR45')
  !partnumarr.append('LISR48')
  !partnumarr.append('LISR49H')
  !partnumarr.append('LISR49HG')
  -- Include ALL PART Nos. with the new "-S1" suffix <Pipe Safety Class>
  -- which are attached directly to a PIPE with a QUALITY CLASS of "QC1"
  !partnumarr.append('LIS34-S1')
  !partnumarr.append('LIS36-S1')
  !partnumarr.append('LIS37-S1')
  !partnumarr.append('LIS42-S1')
  !partnumarr.append('LIS43-S1')
  !partnumarr.append('LIS44-S1')
  !partnumarr.append('LIS45-S1')
  !partnumarr.append('LIS48-S1')
  !partnumarr.append('LIS49H-S1')
  !partnumarr.append('LIS49HG-S1')
  !partnumarr.append('LISR34-S1')
  !partnumarr.append('LISR36-S1')
  !partnumarr.append('LISR37-S1')
  !partnumarr.append('LISR42-S1')
  !partnumarr.append('LISR43-S1')
  !partnumarr.append('LISR44-S1')
  !partnumarr.append('LISR45-S1')
  !partnumarr.append('LISR48-S1')
  !partnumarr.append('LISR49H-S1')
  !partnumarr.append('LISR49HG-S1')

  -- Find the Passed PART No. in the !partnum ARRAY and Return TRUE or FALSE
  !findpartnum = !partnumarr.find(!partnum)
  if (!findpartnum.size().gt(0)) then
    -- PART No. *** FOUND ***
    return TRUE

  else
    -- PART NO. *** NOT FOUND ***
    return FALSE

  endif

endmethod
--<wd>mar2006 <-- This METHOD ADDED by <wd>mar2006 <--

