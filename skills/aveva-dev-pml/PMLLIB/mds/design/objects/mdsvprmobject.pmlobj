--
-- Description:
---------------
--
-- Object to be RETURNED with the MDS to VPRM Support Data for any
-- TYPE of Valid MDS Support being transferred to VPRM.
--
-------------------------------------------------------------------------------
  define object mdsvprmobject

-- Object Member to RETURN the MDS to VPRM Error messages as an ARRAY
    member .errormessages is ARRAY

-- Object Member to RETURN the MDS to VPRM FILE objects for each MDS Support Processed
    member .fileobjects    is ARRAY

  endobject

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Constructor Method for the object
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R
-- Return:
--    [Data Type]   [Description]
--
-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
--  define method .mdsvprmobject()
--  endmethod

-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
-- Method .hangerwpads for the object
--
-- Method to move and convert:
-- LISEGA "MDS HANGER" <SUB UNIT "$S:03"> WPAD<Plate> VPRM records
-- into
-- "MDS STEELWORK" <SUB UNIT "$S:02"> PLATE <-C> VPRM component records
-- and PLATE <AREA> component records
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R
-- Return:
--    [Data Type]   [Description]
--
-------------------------------------------------------------------------------
-------------------------------------------------------------------------------
  define method .hangerwpads(!vprmrecords is ARRAY, !vprmline is STRING) is ARRAY

-- Initialise and Copy Passed Object and Variable
    !newvprmrecords = ARRAY()
    !oldvprmrecords  = !vprmrecords

---------------------------------------------------------------------
-- Each !mdsvprmobj Object and !vprmrecords Variable always represent
-- an Individual MDS Support or a Complete MDS Group Support.
-- Therefore the same PML Code applies to the generation of both
-- MDS VPRM BULK MTO and MDS VPRM ACTUAL MTO input files.
---------------------------------------------------------------------

-- Determine what type of records exist in the !oldvprmrecords array
    !lineheader = FALSE
    !attaunit   = FALSE
    !steelunit  = FALSE
    !hangerunit = FALSE

    do !record indices !oldvprmrecords

      if (!oldvprmrecords[!record].trim().match('$S:01').eq(1)) then
-- ANCILLARY Sub-Unit Exists for this MDS Support
        !attaunit  = TRUE
        !attarecord = !record

      elseif (!oldvprmrecords[!record].trim().match('$S:02').eq(1)) then
-- STEELWORK Sub-Unit Exists for this MDS Support
        !steelunit   = TRUE
        !steelrecord = !record

      elseif (!oldvprmrecords[!record].trim().match('$S:03').eq(1)) then
-- HANGER Sub-Unit Exists for this MDS Support
        !hangerunit    = TRUE
        !hangerrecord  = !record
        !hangersubunit = !oldvprmrecords[!record].trim()

      endif
    enddo

-- Check if any LISEGA MDS HANGER "WPAD" Plate Components exist in Sub-Unit "$S:03" of the !oldvprmrecords array
    if (!hangerunit) then
      !wpadarray = ARRAY()
      !wpadindx  = ARRAY()

      do !wpad from !hangerrecord to !oldvprmrecords.size()
        if (!oldvprmrecords[!wpad].trim().match('$P').eq(1)) then
          !partsplit = !oldvprmrecords[!wpad].trim().split(':')

-- ALL PLATE records Consist of: <1> A "COMPONENT record and <2> An "AREA" record
          if (!partsplit[3].eq('PCS')) and  (!partsplit[4].eq('PLATE')) then
-- A PLATE "COMPONENT" record, i.e. This PART No. record is the FIRST record for a PLATE Component, i.e.<Part No. suffix is "-C">
-- PART<$P> and TAG<$T> No. records + COMPONENT<$C> records will ALWAYS exist for PLATE "COMPONENT" records
-- UDA<$U> records MAY exist for PLATE "COMPONENT" records
            !wpadarray.append(!oldvprmrecords[!wpad])
            !wpadindx[!wpad] = !oldvprmrecords[!wpad]

-- Append the Associated TAG No. record
            !tagindx = (!wpad + 1)
            !wpadarray.append(!oldvprmrecords[!tagindx])
            !wpadindx[!tagindx] = !oldvprmrecords[!tagindx]
-- Append the Associated COMPONENT record
            !compindx = (!wpad + 2)
            !wpadarray.append(!oldvprmrecords[!compindx])
            !wpadindx[!compindx] = !oldvprmrecords[!compindx]

-- Append ANY PLATE UDA records, upto 10 UDAs allowed per COMPONENT in VPRM
            !udaindx = (!wpad + 3)
            do !indx from 1 to 10
              if (!indx.neq(1)) then
                !udaindx = (!udaindx + 1)
              endif

              if (!oldvprmrecords[!udaindx].trim().match('$U').eq(1)) then
                !wpadarray.append(!oldvprmrecords[!udaindx])
                !wpadindx[!udaindx] = !oldvprmrecords[!udaindx]
              else
                break
              endif
            enddo

          elseif (!partsplit[3].eq('SM')) and  (!partsplit[4].eq('PLATE')) then
-- A PLATE "AREA" record, i.e. This PART No. record is the SECOND record for a PLATE Component.
-- ONLY PART No.<$P> and TAG No.<$T> records will exist for PLATE "AREA" records
            !wpadarray.append(!oldvprmrecords[!wpad])
            !wpadindx[!wpad] = !oldvprmrecords[!wpad]

-- ONLY Append the Associated TAG No. record
            !tagindx = (!wpad + 1)
            !wpadarray.append(!oldvprmrecords[!tagindx])
            !wpadindx[!tagindx] = !oldvprmrecords[!tagindx]
          endif
        endif
      enddo

-- Check if ANY WPAD Plate records exist
      if (!wpadarray.empty()) then
-- No WPAD Components exist, so return the Original Array !vprmrecords
        !newvprmrecords = !vprmrecords
        return !newvprmrecords
      endif

    else
-- No HANGER Components to CHECK, so return the Original Array !vprmrecords
      !newvprmrecords = !vprmrecords
      return !newvprmrecords

    endif

-- Delete the WPAD Plates from the Original !oldvprmrecords array
   do !delindx indices !wpadindx
     !oldvprmrecords.deletefrom(!delindx, 1)
   enddo

-- The WPAD PLATES now need to be MOVED to a STEELWORK SUB-UNT, i.e <$S:02>
-- Determine where and what to ADD for the WPAD Plates in the array
   if (!hangerunit) then
     if (!steelunit) then
-- STEELWORK<$S:02> Sub-Unit already exists at ARRAY index "!steelrecord" of the !oldvprmrecords array
-- Insert WPAD array before the existing HANGER LINE<$L> Header record
       if (!hangerrecord.eq(1)) then
         !hanglineindx = !hangerrecord
       else
         !hanglineindx = (!hangerrecord - 1)
       endif
       !oldvprmrecords.insertarray(!hanglineindx, !wpadindx)

     else
-- STEELWORK<$S:02> Sub-Unit DOES NOT exist, so Insert a NEW <$S:02> Sub-Unit record for the WPAD Plates
-- Insert WPAD array before a NEW inserted HANGER LINE<$L> Header record
       if (!hangerrecord.eq(1)) then
         !hanglineindx = !hangerrecord
         !oldvprmrecords.insert(!hanglineindx, !vprmline)
         !oldvprmrecords.insertarray(!hanglineindx, !wpadindx)
         !steelsubunit = !hangersubunit.replace('3','2')
         !oldvprmrecords.insert(!hanglineindx, !steelsubunit)

       else
         !steelsubunit = !hangersubunit.replace('3','2')
         !hanglineindx = (!hangerrecord - 1)
         !oldvprmrecords.insert(!hanglineindx, !vprmline)
         !oldvprmrecords.insertarray((!hanglineindx - 1), !wpadindx)
         !oldvprmrecords.insert(!hanglineindx, !steelsubunit)

       endif
     endif
   endif

-- Re-Index the !oldvpremrecords array
   !oldvprmrecords.compress()
   !newvprmrecords = !oldvprmrecords

    return !newvprmrecords

  endmethod

