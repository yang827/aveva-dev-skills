--------------------------------------------------------------------------------
--   Type:  Object Definition
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  DESIGN
--
--------------------------------------------------------------------------------
-- Description:
--
-- PML Object to determine the MDS Design Data etc... for the MDS ZONE IDENTITIES etc..
-- from the MDS12 DEFAULTS PARAGON CATALOGUE Database CONVERTED from the latest MDS11.6*
-- version of the MDS DEFAULTS FILE "%MDSDFLTS%/DES-SUPP-ID" from the MASTER PDMS
-- Project "MDS"
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdszoneiddefs()                  -
--
define object MDSZONEIDDEFS

  -- Overall Discipline Check for ALL MDS ZONE ID members
  member .zoneidcheck is BOOLEAN

  -- -- HVAC Discipline DESIGN ZONE ID Attribute NAME member
  --   member .hvaczatt is STRING
  --
  -- -- HVAC Discipline DESIGN ZONE ID Attribute VALUE member
  --   member .hvaczval is STRING
  --
  -- -- PIPING Discipline DESIGN ZONE ID Attribute NAME member
  --   member .pipezatt is STRING
  --
  -- -- PIPING Discipline DESIGN ZONE ID Attribute VALUE member
  --   member .pipezval is STRING
  --
  -- -- MDS FRAMEWORK STRUCTURES Discipline DESIGN ZONE ID Attribute NAME member
  --   member .suppzatt is STRING
  --
  -- -- MDS FRAMEWORK STRUCTURES Discipline DESIGN ZONE ID Attribute VALUE member
  --   member .suppzval is STRING
  --
  -- -- ELECTRICAL & INSTRUMENT TRAY/RACK Discipline DESIGN ZONE ID Attribute NAME member
  --   member .trayzatt is STRING
  --
  -- -- ELECTRICAL & INSTRUMENT TRAY/RACK Discipline DESIGN ZONE ID Attribute VALUE member
  --   member .trayzval is STRING
  --
  -- End object
endobject
--
--------------------------------------------------------------------------------
-- Constructor Method .mdszoneiddefs()
-- Arguments:
--
-- Return:
--
--------------------------------------------------------------------------------
-- Constructor Method
--
define method .mdszoneiddefs()

  -- Determine the PDMS Project MDS ZONE IDENTITIES
  !zoneidcata = /MDS/ZONEID/DEFAULTS
  handle NONE
    -- Initialise the Collection Object data
    !type  = |DATA|
    !filt  = object EXPRESSION('DKEY eq |ZATT| or DKEY eq |ZVAL|')
    !scope = ARRAY()
    !scope.append(!zoneidcata)

    -- Collect ALL of the DESPARS DATA Elements
    !data  = object COLLECTION()
    !data.filter(!filt)
    !data.scope(!scope)
    !data.type(!type)

    -- Collection Results Array
    !results = !data.results()
    !gvarnum = 0
    !gvararr = ARRAY()
    if (!results.size().gt(0)) then
      -- Process the MDS Standard DATA elements !results Array
      -- SET ALL of the MDS Application DISCIPLINE ZONE ID pairs of Global Variables.
      -- There are currently "8" MDS ZONE ID "KEYWORDS" represented by the Global Variables
      -- i.e.
      -- !!mdsIDHATT and !!mdsIDHVAL
      -- !!mdsIDPATT and !!mdsIDPVAL
      -- !!mdsIDSATT and !!mdsIDSVAL
      -- !!mdsIDTATT and !!mdsIDTVAL
      do !indx indices !results
        --Check the DBREF is a valid ZONE ID DATA element
        if (!results[!indx].dtitl inset (|MDSIDHATT|, |MDSIDHVAL|, |MDSIDPATT|, |MDSIDPVAL|, |MDSIDSATT|, |MDSIDSVAL|, |MDSIDTATT|, |MDSIDTVAL|, |MDSIDHANGATT|, |MDSIDHANGVAL|)) then
          -- GET the MDS Global Variable Name
          !zxstr  = |!!| & !results[!indx].dtitl
          -- GET the MDS Global Variable Value
          !zzstr  = $!results[$!indx].pprop
          -- SET EACH of the MDS Application DISCIPLINE ZONE ID Global Variables
          $!zxstr = !zzstr
          -- Add to the ARRAY !gvararr and Increment the Count Variable !gvarnum
          !gvararr.append(!results[!indx].dtitl)
          !gvarnum = !gvarnum + 1

        endif

      enddo

      -- Remove Duplicates from the Array and Check that ALL "8" MDS ZONE ID "KEYWORDS" are present
      !gvararr.unique()
      if ((!gvarnum.geq(8)) and (!gvararr.size().geq(8)))then
        !zoneidcheck = TRUE

      else
        !zoneidcheck = FALSE

      endif

    else
      -- The MDS ZONE ID DATA elements NOT found
      !zoneidcheck = FALSE

    endif

  elsehandle ANY
    -- The MDS ZONE ID CATA element NOT found
    !zoneidcheck = FALSE

  endhandle

  -- SET the Object Member .zoneidcheck
  !this.zoneidcheck = !zoneidcheck

endmethod
--
--------------------------------------------------------------------------------
--
--define method

--endmethod
--
--------------------------------------------------------------------------------
--
--define method

--endmethod
