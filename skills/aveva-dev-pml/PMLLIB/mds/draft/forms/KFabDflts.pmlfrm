--
-- File:                kfabdflts.frm
--   Type:              Form Definition
--   Group:             MDS ADP/Automatic support fabrication drawings
--     Keyword:         FAB
--   Module:            Draft
--   Replaces:
--
-- Author:              S.J.Robinson
-- Created:             Mon Jan 19th 1998
--
--
-- Description:
-- Form Definition for modification of MDS ADP defaults for MDS
--
----------------------------------------------------------------------------------

-- Kill existing form definition
Kill !!KFABDflts

-- Define Form
Setup Form  !!KFABDflts

  !!KFABDflts.formtitle    = |MDS ADP Defaults|
  !!KFABDflts.icontitle    = |DFLTS|
  !!KFABDflts.callback     = ||
  !!KFABDflts.formrevision = | $Revision: 1.1.19.1 $ |

  -- Body of Form
    path down
    vdist 0.5

    option .IsoDir   'Isometric View Direction ' callback |!!SupportDef.Isometric = _IsoDir.Selection()| at x0 ymax0.5 width 3
    text   .SiteTrim 'Site Trim Allowance      ' callback '!!KFABDfltsAction(|SITETRIM|)' width 14 ISOU
    para   .PUnitsText text 'Weight Units per Metre   '
    para   .UnitsText at xmax ymin width 14 lines 1

    para   .PSwcm at x0 ymax+0.5 text     'Weight per Cubic M       '
    para   .Swcm at xmax ymin width 14 lines 1

    para   .PTranPref at x0 ymax+0.5 text 'Transportation Prefix    '
    para   .TranPref at xmax ymin width 14 lines 1

    para   .PTranText at x0 ymax+0.5 text 'Transportation Text      '
    para   .TranText at xmax ymin width 14 lines 2

    -- para   .PShoeTab at x0 ymax text 'Shoes/Guides Tabulated   '
    -- para   .ShoeTab at xmax ymin width 14 lines 2

    para   .PDrwgNo at x0 ymax text 'MDS ADP Drawing Number   '
    para   .DrwgNo at xmax ymin width 14 lines 2

    para   .PGridMatrix at x0 ymax text 'MDS ADP Grid Matrix      '
    para   .GridMatrix at xmax ymin width 14 lines 2

    para   .Pviewolap at x0 ymax text 'MDS ADP View Overlap     '
    para   .viewolap at xmax ymin width 14 lines 1

    -- bottom line
    button .Default 'Default'  at x0 ymax+0.1 callback '!!KFABDfltsAction(|Default|)'

    button .Dismiss | Dismiss | at xmax form-size ymin Ok

-- End form definition
exit

-- set the iso dir options
!Dtext = Array()
!Rtext = Array()
!Dtext = Split('1 2 3 4 OFF')
!Rtext = Split('1 2 3 4 OFF')
!!KFABDflts.Isodir.Dtext = !Dtext
!!KFABDflts.Isodir.Rtext = !Rtext

!!KFABDfltsAction(|Default|)

-- End of file kfabdflts.frm
