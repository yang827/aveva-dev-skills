--
-- File: MdsAbaDimenPens.pmlfrm
--   Type: Form Definition
--   Group: MDS ABA Automatic support fabrication drawings
--     Keyword: ABA
--   Module: Draft
--   Replaces:
--
-- Author: Wayne Dodwell
-- Created: Friday 24th May 2002
--
--
-- Description:
-- Form Definition for Selecting the MDS ABA View Task Dimension Pen Options
--
---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

-- Kill existing form definition
  kill !!mdsabadimenpens

-- Define Form
  setup form !!mdsabadimenpens blocking

    !!mdsabadimenpens.formtitle = |View Dimension Attributes|
    !!mdsabadimenpens.icontitle = |MDSABAVDims|
    !!mdsabadimenpens.callback  = |!this.init()|

--------------------------------------------
--<wd>26mar2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
-- -- Main Frame
--     frame .pens ' Dimension Pen Options '
--       path down
--
-- -- Form Gadget Definitions
--       text .plpn at x1 ymax+0.5 'Projection Line Pen ' width 11 is REAL
--       text .dlpn 'Dimension Line Pen  ' width 11 is REAL
--       text .dtpn 'Dimension Text Pen  ' width 11 is REAL
--       text .ptpn 'Projection Text Pen ' width 11 is REAL
--       text .dtfn 'Dimension text Font ' width 11 is REAL
--       text .ptfn 'Projection text Font' width 11 is REAL
--       text .dtsi 'Dimension text Size ' width 11 is REAL
--       text .ptsi 'Projection text Size' width 11 is REAL
--       text .tesi 'Terminator Size     ' width 11 is REAL
--       option .dterm at xmin ymax+0.5 'Terminators         ' width 10
--     exit

-- Main Frame
    frame .pens ' Dimension Pen Options '
      path down

-- Form Gadget Definitions
      text .plls at x1 ymax+0.5 'Projection Line Style  ' width 11 is STRING
      text .pllc                'Projection Line Colour ' width 11 is REAL
      text .ptfn                'Projection Text Font   ' width 11 is REAL
      text .ptsi                'Projection Text Size   ' width 11 is REAL format !!distancefmt
      text .ptxc                'Projection Text Colour ' width 11 is REAL
      text .dlls                'Dimension Line Style   ' width 11 is STRING
      text .dllc                'Dimension Line Colour  ' width 11 is REAL
      text .dtfn                'Dimension Text Font    ' width 11 is REAL
      text .dtsi                'Dimension Text Size    ' width 11 is REAL format !!distancefmt
      text .dtxc                'Dimension Text Colour  ' width 11 is REAL
      text .tesi                'Terminator Size        ' width 11 is REAL format !!distancefmt
      option .dterm at xmin ymax+0.5 'Terminators            ' width 10
    exit
--
--<wd>26mar2008 - DUN824 - Defect No. P-4526
--------------------------------------------

-- Bottom Line
    button .cancel | Cancel | at xmax form-size ymax+0.5 cancel
    button .ok     |   OK   | at x0 ymin call |!this.write()| ok

-- Form members
    member .settings is STRING
    member .current  is REAL
    member .toggle   is BOOLEAN

  exit

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
--
-- Form Methods Defined Below Here...
--
---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .init()
--q var !this.name()
--q var !this.settings
-- Set the .dterm option dtext
    !dtext = ARRAY()
    !dtext[1] = 'Obliques'
    !dtext[2] = 'Arrows'
    !dtext[3] = 'Dots'
    !dtext[4] = 'Off'
    !this.dterm.dtext = !dtext

-- Get the Task Parameter TPVAL Attribute Values into an array
    !values = !this.settings.split(',')

--------------------------------------------
--<wd>26mar2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
-- -- Set the Dimension Attibutes Form with the Stored Values at the View Task
--     !this.toggle   = !values[1].boolean()
--     !this.plpn.val = !values[2].real()
--     !this.dlpn.val = !values[3].real()
--     !this.dtpn.val = !values[4].real()
--     !this.ptpn.val = !values[5].real()
--     !this.dtfn.val = !values[6].real()
--     !this.ptfn.val = !values[7].real()
--     !this.dtsi.val = !values[8].real()
--     !this.ptsi.val = !values[9].real()
--     !this.tesi.val = !values[10].real()
--     !this.dterm.select('rtext',!values[11])
--     handle any
--     endhandle

-- Set the Dimension Attibutes Form with the Stored Values at the View Task
-- Steelwork Dimension Toggle
    !this.toggle   = !values[1].boolean()

-- Projection Line Attributes
    !this.plls.val = !values[2].string()
    !this.pllc.val = !values[3].real()
    !this.ptfn.val = !values[4].real()
    !this.ptsi.val = !values[5].real()
    !this.ptxc.val = !values[6].real()

-- Dimension Line Attributes
    !this.dlls.val = !values[7].string()
    !this.dllc.val = !values[8].real()
    !this.dtfn.val = !values[9].real()
    !this.dtsi.val = !values[10].real()
    !this.dtxc.val = !values[11].real()
    handle ANY
    endhandle

-- Dimension Terminator Attributes
    !this.tesi.val = !values[12].real()
    handle ANY
    endhandle
    !this.dterm.select('rtext',!values[13])
    handle any
    endhandle
--
--<wd>26mar2008 - DUN824 - Defect No. P-4526
--------------------------------------------

  endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .write()


--------------------------------------------
--<wd>26mar2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
-- -- Compose the Task TPVAL attribute values
--     !return = !this.toggle.string() & ',' & !this.plpn.val & ',' & !this.dlpn.val & ',' & !this.dtpn.val & ','  $
--     & !this.ptpn.val & ',' & !this.dtfn.val & ',' & !this.ptfn.val & ',' & $
--     !this.dtsi.val & ',' & !this.ptsi.val & ',' & !this.tesi.val & ',' & !this.dterm.selection()

-- Compose the Task TPVAL attribute values
    !return = !this.toggle.string() & ',' & !this.plls.val & ',' & !this.pllc.val & ',' & !this.ptfn.val & ','  $
    & !this.ptsi.val & ',' & !this.ptxc.val & ',' & !this.dlls.val & ',' & !this.dllc.val & ',' & !this.dtfn.val & ','  $
    & !this.dtsi.val & ',' & !this.dtxc.val & ',' & !this.tesi.val & ',' & !this.dterm.selection()
--
--<wd>26mar2008 - DUN824 - Defect No. P-4526
--------------------------------------------

-- Store the Task TPVAL values in the main task form member '.subtasks'
    !!mdsabaviewtask.subtasks[!this.current] = !return

  endmethod

