--
-- Description: Adds an axes to the isometric view
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  checkDbref(REAL,STRING)          -
--  closed()                         -
--  init()                           -
--  setce(STRING)                    -
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--<wd>20mar2008 -- DUN824
-- *********************
-- ***IMPORTANT NOTE ***
-- *********************
-- This MDS ABA file incorporates the modifications supplied by Steve Wilson on 19mar2008.
-- These changes have been necessary to enable MDS12.0.SP2 to work correctly with ABA12.0.SP2
--<wd>20mar2008 -- DUN824
------------------------------------------------------------------------

setup form !!mdsabaisoview
  title |Isometric View Axes|
  !this.callback = '!this.init()'

-- Define Members/Selection Areas
-- ------------------------------

  frame .options | Parameters | at x0
    path down
    option .param1 at x1 'View Direction                    ' width 10
    !dtext = ARRAY()
    !rtext = ARRAY()
    !dtext.append('Iso 1')
    !dtext.append('Iso 2')
    !dtext.append('Iso 3')
    !dtext.append('Iso 4')
    !rtext.append('1')
    !rtext.append('2')
    !rtext.append('3')
    !rtext.append('4')
    !this.param1.dtext = !dtext
    !this.param1.rtext = !rtext

    text .param2 'Axes Symbol    ' at x 1 call |!this.checkDbref(2,!this.param2.val)| width 27 is STRING

    button .setparam2 'CE' at xmax.param2 + .25 ymin.param2 call |!this.setce('2')|

    para .param3 at x 1 text 'North Arrow Position '
      rgroup .arrowpos frame horizontal at xmax.param3 ymax.param2
      add tag 'TL ' select 'TL'   call ||
      add tag 'TR ' select 'TR' call ||
      add tag 'BR ' select 'BR' call ||
      add tag 'BL ' select 'BL' call ||
   exit

  exit


-- Action buttons
-- --------------

  hdist 1.25
  button .ok     |  OK  | at x0     call |!this.apply()| ok
  button .cancel |Cancel| at xmax form-size ymin.ok call |!this.closed()| cancel

  -- Members
  member .taskName       is STRING
  member .taskParams     is ARRAY
  member .task           is ABATASK
  member .form           is FORM

  -- Set feedback name

-- End of form definition
exit

--------------------------------------------------------------------
define method .init()
--------------------------------------------------------------------
-- Called when form is shown

   -- Initialise variables
   !ce = !!ce

   -- Set form title
   !this.formTitle = !this.task.name
   handle any
       !this.formTitle = 'MDS ABA Iso Axes'
       handle (2,751)
          -- Probably means that the form is just being initialised.
       endhandle
   endhandle

-- Hold name of task
   !this.taskName = !!abauserview.tasklist.task.name
   handle (2,751)
     -- Stops form failing when being initialised for methods.
   endhandle

-- Load text boxes with current settings for parameter values.
-- 1

   !this.param1.val = !this.task.paramval[1].real()

-- 2

   !this.param2.val = !this.task.paramval[2]

-- 3

  if (!this.task.paramval[3] EQ 'TL') then
    !this.arrowpos.val = 1
  elseif (!this.task.paramval[3] EQ 'TR') then
    !this.arrowpos.val = 2
  elseif (!this.task.paramval[3] EQ 'BR') then
    !this.arrowpos.val = 3
  else
    !this.arrowpos.val = 4
  endif

   -- Return to hierarchy position
   !!ce = !ce
endmethod

--------------------------------------------------------------------
define method .apply()
--------------------------------------------------------------------
-- Called when apply is pressed

-- Initialise variables
   !ce = !!ce

-- Build parameters array
-- 1
  !parameters[1] = !this.param1.val
-- 2
  !parameters[2] = !this.param2.val
-- 3

  if (!this.arrowpos.val.real() EQ 1) then
    !parameters[3] = 'TL'
  elseif (!this.arrowpos.val.real() EQ 2) then
    !parameters[3] = 'TR'
  elseif (!this.arrowpos.val.real() EQ 3) then
    !parameters[3] = 'BR'
  else
    !parameters[3] = 'BL'
  endif

-- Reset the task object
  !this.task.paramval = !parameters

-- Transfer the modified task back to the calling form
  !this.form.receiveTask(!this.task)

-- Delete feeedback drawing
  !this.closed()

-- Return to hierarchy position
  !!ce = !ce
    handle (2,822)
    endhandle

-- Set calling form apply button active

  !!abauserview.apply.active = true

endmethod

--------------------------------------------------------------------
define method .closed()
--------------------------------------------------------------------
-- Called when form is closed

   -- Hide this form
   !this.hide()

endmethod

--------------------------------------------------------------------
define method .setce(!val is STRING)
--------------------------------------------------------------------
-- to Set Current Element.

   if (!!ce.type NE 'SYTM') then
     !!alert.error('$!!ce.name Is Not A Symbol')
     return
   endif

   !temp = |!this.param| & !val & |.val ='| & !!ce.name.string() & |'|
   $!temp

endmethod

--------------------------------------------------------------------
define method .checkDbref(!dummyparam is REAL, !check is STRING)
--------------------------------------------------------------------
-- Called to check if this string equates to a dbref.

   $!check
   handle any
     !!alert.error(|$!check Does Not Exist|)
   endhandle

endmethod
