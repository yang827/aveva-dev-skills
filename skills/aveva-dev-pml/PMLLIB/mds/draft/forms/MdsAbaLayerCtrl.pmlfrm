--
-- Description:
-- Form Definition for Layer visibility control
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  LayerByCursor()                  -
--  MemberByCursor()                 -
--
---------------------------------------------------------------------------------------------------------

-- Kill existing form definition
  kill !!mdsabalayerctrl

-- Define Form
  setup form  !!mdsabalayerctrl

  option .View 'View ' at x 0.5 y 0.2 callback '!This.SelView()' width 50

  toggle .OnOffView '   ' at xmax ymin callback '!This.OnOffView()'

  list  .Layer 'Layer' at xmin.View ymax.View+0.2 callback '!This.SelLayer()' height 9 width 60

  list  .LayerMemb 'Layer Members' at xmin.View ymax.Layer+0.2 callback '!This.SelLayerMemb()' height 9 width 60

  button .Dismiss 'Dismiss' at xmax form-size ymax CANCEL


-- Form members
   member .NameWidth is ARRAY

  exit

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
--
-- Form Methods Defined Below Here...
--
---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
  define method .mdsabalayerctrl()


  !this.formtitle = 'MDS Layer Control'
  !this.Initcall = '!This.Init()'
  !this.Newmenu('ShowHideAll')
  !this.ShowHideAll.Add('callback','Show All','!This.OnOffAllLayer(true)')
  !this.ShowHideAll.Add('callback','Hide All','!This.OnOffAllLayer(false)')
  !this.ShowHideAll.Add('toggle','Show/Hide on selection','')
  !this.ShowHideAll.Add('callback','Hide Layer by Cursor','!This.LayerByCursor()')
  !this.Layer.SetPopup(!This.ShowHideAll)

  !this.Newmenu('ShowHideMemb')
  !this.ShowHideMemb.Add('callback','Show All','!This.OnOffAllMemb(true)')
  !this.ShowHideMemb.Add('callback','Hide All','!This.OnOffAllMemb(false)')
  !this.ShowHideMemb.Add('callback','Hide Member by Cursor','!This.MemberByCursor()')
  !this.LayerMemb.SetPopup(!This.ShowHideMemb)

  !this.cancelcall = 'kill !!mdsabalayerctrl'


  endmethod


---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .init()


  !Sheet = SHEE
      handle ANY
        !Sheet = !!FmSys.Main().Sheet.Selection().Dbref()
           handle ANY
              return error 1 'Cannot access SHEET from this level'
           endhandle
        if !Sheet.Type.neq('SHEE') then
           return error 1 'Cannot access SHEET from this level'
        endif
      endhandle

  var !Task collect all TASK with upcase(pmlfunc) eq 'MDSABAVIEWTASK' for $!Sheet

  if !Task.Unset() then
     return error 1 'It is not MDS Drawing'
  endif

  !Views = !Task.Evaluate(object BLOCK('!task[!evalindex].dbref().ownls[5]'))

  var !UserView collect all VIEW with sppurp eq 'USER' for $!Sheet
  !Views.AppendArray(!UserView.Evaluate(object BLOCK('!UserVIew[!Evalindex].Dbref()')))

   !Dtext = ARRAY()
   !Rtext = ARRAY()
   do !View values !Views
      !Dtext.Append(!View.Name)
      !Rtext.Append(!View.String())
   enddo

   !This.View.Dtext = !Dtext
   !This.View.Rtext = !Rtext

   !This.SelView()

  endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .OnOffAllLayer(!Visible is BOOLEAN)

     !Line = !This.Layer.Val


     !Layers = !This.Layer.Rtext
     do !Layer values !Layers
        !Layer.Dbref().Lvis = !Visible
     enddo

     !This.SelView()
     !This.Layer.Val = !Line
     !this.sellayer()

     !!FmSys.Refresh()

  endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .OnOffAllMemb(!Visible is BOOLEAN)

     !Line = !This.LayerMemb.Val


     !LayerMemb = !This.LayerMemb.Rtext
     do !Memb values !LayerMemb

       if !Memb.Dbref().lock then
         !!Alert.error('The current element is locked')
         !!ce = !Memb.Dbref()
         return
       elseif !Memb.Dbref().dbwrite.not() then
         !!Alert.error('The current element is in a read only database')
         !!ce = !Memb.Dbref()
         return
       endif

        !Memb.Dbref().Lvis = !Visible
          handle ANY
            return
          endhandle

     enddo

     !This.LayerMembList()
     !This.LayerMemb.Val = !Line

     !!FmSys.Refresh()

  endmethod


---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .SelView()


    !View = !This.View.Selection()
    !ViewName = name of $!View

    !This.OnOffView.Val = !View.Dbref().Lvis
      if !This.OnOffView.Val then
         !Tag = 'On'
      else
         !Tag = 'Off'
      endif
    !This.OnOffView.Tag = !Tag

    var !AllLayer collect all LAYE for $!View

    !Dtext = ARRAY()
    !Rtext = ARRAY()
    !Name = ARRAY()
    !Layrefs = ARRAY()

    do !Laye values !AllLayer
       !Memb = ARRAY()
       !Memb.AppendArray(memb ADIM of $!Laye)
       !Memb.AppendArray(memb LDIM of $!Laye)
       !Memb.AppendArray(memb VNOT of $!Laye)
       !Memb.AppendArray(memb GLAB of $!Laye)
       !Memb.AppendArray(memb SLAB of $!Laye)
       !Memb.AppendArray(memb RDIM of $!Laye)
       !Memb.AppendArray(memb PDIM of $!Laye)
       skip if !Memb.Unset()

       !Layref = !Laye.Dbref()
       !Layrefs.Append(!Layref)
       !name.Append(!Layref.Name.After(!ViewName).Substring(2))

       !Rtext.append(!Laye)

    enddo

    !Width = !Name.Width()
    !This.NameWidth[1] = !Width

    do !C indices !Name
       if !Layrefs[!C].Lvis.Not() then
          var !Tmp compose '$!Name[$!C]' width $!width '   (Hidden)'
          !Name[!C] = !Tmp[1]
       endif

       !Dtext.Append(!Name[!C])

    enddo

    !This.Layer.Dtext = !Dtext
    !this.layer.rtext = !rtext

    !This.LayerMembList()

  endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .SelLayer()

     !Layer = !This.Layer.Selection().Dbref()
        handle ANY
          return
        endhandle


     if !This.ShowHideAll.Selected('Show/Hide on selection') then
          !Line = !This.Layer.Val
          !Dtext = !This.Layer.Dtext
          !Rtext = !This.Layer.Rtext
          !NewText = !Dtext[!Line].Split()[1]

          if !Layer.Lvis.Not() then
             !Layer.Lvis = true
          else
             !Layer.Lvis = false
             !Width = !This.NameWidth[1]
              var !Tmp compose '$!NewText' width $!Width '   (Hidden)'
             !NewText = !Tmp[1]
          endif


          !Dtext[!Line] = !NewText

          !This.Layer.Dtext = !Dtext
          !This.Layer.Rtext = !Rtext
          !This.Layer.Val = !Line
     endif

     !This.LayerMembList()

     !!FmSys.Refresh()

  endmethod



---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
  define method .LayerMembList()

     !Layer = !This.Layer.Selection().Dbref()
        handle ANY
          return
        endhandle

     !Dtext = ARRAY()
     !Rtext = ARRAY()
     !Name = ARRAY()
     !LayerMembRef = ARRAY()

     do !LayerMemb values !Layer.Memb
        !Lvis = !LayerMemb.Lvis
           handle ANY
             skip
           endhandle
        !Name.Append(!LayerMemb.Namtyp.Before(' of '))
        !Rtext.Append(!LayerMemb.String())
        !LayerMembRef.Append(!LayerMemb)
     enddo

     !Width = !Name.Width()
     !This.NameWidth[2] = !Width
     do !C indices !Name
        if !LayerMembRef[!C].Lvis.Not() then
           var !Tmp compose '$!Name[$!C]' width $!width '   (Hidden)'
           !Name[!C] = !Tmp[1]
        endif

        !Dtext[!C] = !Name[!C]
     enddo

     !This.LayerMemb.Dtext = !Dtext
     !This.LayerMemb.Rtext = !Rtext


  endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
  define method .SelLayerMemb()

     !Memb = !This.LayerMemb.Selection().Dbref()
         handle ANY
         endhandle

     !Line  = !This.LayerMemb.Val
     !Dtext = !This.LayerMemb.Dtext
     !Rtext = !This.LayerMemb.Rtext
     !NewText = !Memb.Namtyp.Before(' of ')

     if !Memb.Lvis.Not() then
        !Memb.Lvis = TRUE
          handle (2,18)
           !Memb.lock = FALSE
           !Memb.Lvis = TRUE
           !Memb.lock = TRUE
          endhandle
     else
        !Memb.Lvis = FALSE
          handle (2,18)
           !Memb.lock = FALSE
           !Memb.Lvis = FALSE
           !Memb.lock = TRUE
          endhandle
        !Width = !This.NameWidth[2]
         var !Tmp compose '$!NewText' width $!Width '   (Hidden)'
        !NewText = !Tmp[1]
     endif

     !Dtext[!Line] = !NewText
     !This.LayerMemb.Dtext = !Dtext
     !This.LayerMemb.Rtext = !Rtext
     !This.LayerMemb.Val = !Line

     !!FmSys.Refresh()

  endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .OnOffView()

      !View = !This.View.Selection().Dbref()

      !View.Lvis = !This.OnOffView.Val

      if !View.Lvis then
         !Tag = 'On'
      else
         !Tag = 'Off'
      endif

      !This.OnOffView.Tag = !Tag

       !!FmSys.Refresh()

  endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
define method .LayerByCursor()

  id laye @
    handle ANY
      return
    endhandle
  if !!ce.owner.name.neq(!this.view.dtext[!!mdsabalayerctrl.view.val]) then
    !!Alert.error('Selected layer is not owned by the currently selected view')
    return
  endif

  -- highlight ce

  if !!ce.lock then
    !!Alert.error('Selected layer is locked')
    return
  elseif !!ce.dbwrite.not() then
    !!Alert.error('Selected layer is in a read only database')
    return
  endif

  lvis FALSE
    handle ANY
      return
    endhandle

  !this.selview()

endmethod

define method .MemberByCursor()

  id GLAB SLAB @
    handle ANY
      return
    endhandle
  view
  !Viewname = name
  same
  if !Viewname.neq(!this.view.dtext[!!mdsabalayerctrl.view.val]) then
    !!Alert.error('Selected member is not owned by the currently selected view')
    return
  endif

  !mem = !!ce.name
  -- highlight ce

  if !!ce.lock then
    !!Alert.error('Selected member is locked')
    return
  elseif !!ce.dbwrite.not() then
    !!Alert.error('Selected member is in a read only database')
    return
  endif

  lvis FALSE
    handle ANY
      return
    endhandle

-- select member in lists

  laye
  !select = !this.layer.rtext.findfirst(!!ce.ref.string())
  !this.layer.val = !select.real()
  !this.sellayer()
  !this.LayerMembList()
  !select = !this.layermemb.rtext.findfirst(!mem)
  !this.layermemb.val = !select


endmethod
