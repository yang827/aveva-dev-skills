-- These changes have been necessary to enable MDS12.0.SP2 to work correctly with ABA12.0.SP2
--<wd>20mar2008 -- DUN824
------------------------------------------------------------------------

-- Removed many of the options because this is now driven from a symbol.
setup form !!mdsabalocplan

  title |Choose options|
  !this.callback = '!this.init()'

-- Define Members/Selection Areas
-- ------------------------------

  frame .options | Parameters | at x0
    path down
$(
    para .param1 at x 1 text 'North Direction '
       rgroup .northdir frame horizontal at xmax.param1 ymin.param1
      add tag 'Up'   select 'UP'   call ||
      add tag 'Down' select 'DOWN' call ||
    exit

    text .param2 'North Arrow Symbol ' at x 1 call |!this.checkDbref(2,!this.param2.val)| width 27 is STRING
    button .setparam2 'CE' at xmax.param2 + .25 ymin.param2 call |!this.setCE('2')|
--para .para3 text '  North Arrow Position '
    para .param3 at x 1 text 'North Arrow Position '
       rgroup .arrowpos frame horizontal at xmax.param3 ymax.param2
      add tag 'TL' select 'TL'   call ||
      add tag 'TR' select 'TR' call ||
      add tag 'BR' select 'BR' call ||
      add tag 'BL' select 'BL' call ||
    exit

    text .param4 'Datum Symbol ' at x 1 ymax.param3 + .25 call |!this.checkDbref(4,!this.param4.val)| width 33 is STRING
    button .setparam4 'CE' at xmax.param4 + .25 ymin.param4 call |!this.setCE('4')|
--    text .param5 '        Datum Position ' width 30 is STRING
    para .param5 at x 1 text 'Datum Position '
       rgroup .datumpos frame horizontal at xmax.param5 ymax.param4
      add tag 'Top'   select 'Top'   call ||
      add tag 'Bottom' select 'Bottom' call ||
    exit
$)
-- was param6
    text .param1 'Reference Co-Ordinates ' at x 1 y1 width 26 is STRING
$(
    text .param7 'Grid Line Symbol ' call |!this.checkDbref(7,!this.param7.val)| width 29 is STRING
    button .setparam7 'CE' at xmax.param7 + .25 ymin.param7 call |!this.setCE('7')|
$)
  exit


-- Action buttons
-- --------------

hdist 1.25
  button .ok     |  OK  | at x0     call |!this.apply()| ok
  button .cancel |Cancel| at xmax form-size ymin.ok call |!this.closed()| cancel

  -- Members
  member .taskName       is STRING
  member .taskParams     is ARRAY
  member .task           is ABATASK
  member .form           is FORM

  -- Set feedback name

-- End of form definition
exit

--------------------------------------------------------------------
define method .init()
--------------------------------------------------------------------
-- Called when form is shown

   -- Initialise variables
   !ce = !!ce

   -- Set form title
   !this.formTitle =  !this.task.name
   handle any
       !this.formTitle = 'MDS ABA Location Plan'
       handle (2,751)
          -- Probably means that the form is just being initialised.
       endhandle
   endhandle

-- Hold name of task
   !this.taskName = !this.task.name
   handle (2,751)
     -- Stops form failing when being initialised for methods.
   endhandle

-- Load text boxes with current settings for parameter values.
$(
-- 1
      if (!this.task.paramval[1] EQ 'UP') then
          !this.northdir.val = 1
      else
          !this.northdir.val = 2
      endif
-- 2
     !this.param2.val = !this.task.paramval[2]

-- 3
  if (!this.task.paramval[3] EQ 'TL') then
          !this.arrowpos.val = 1
     elseif (!this.task.paramval[3] EQ 'TR') then
          !this.arrowpos.val = 2
      elseif (!this.task.paramval[3] EQ 'BR') then
          !this.arrowpos.val = 3
      else
          !this.arrowpos.val = 4
      endif

-- 4
     !this.param4.val = !this.task.paramval[4]

-- 5
  if (!this.task.paramval[5] EQ 'TOP') then
          !this.datumpos.val = 1
      else
          !this.datumpos.val = 2
      endif
$)
-- 1 was 6
     !this.param1.val = !this.task.paramval[1]
$(

-- 7
     !this.param7.val = !this.task.paramval[7]
$)

   -- Return to hierarchy position
   !!ce = !ce
endmethod

--------------------------------------------------------------------
define method .apply()
--------------------------------------------------------------------
-- Called when apply is pressed

   -- Initialise variables
   !ce = !!ce

-- $(
--    -- Build parameters array
--    -- 1
--       if (!this.northdir.val EQ 1) then
--           !parameters[1] = 'UP'
--       else
--           !parameters[1] = 'DOWN'
--       endif
--    -- 2
--       !parameters[2] = !this.param2.val
--    -- 3
--        if (!this.arrowpos.val EQ 1) then
--           !parameters[3] = 'TL'
--       elseif (!this.arrowpos.val EQ 2) then
--           !parameters[3] = 'TR'
--       elseif (!this.arrowpos.val EQ 3) then
--           !parameters[3] = 'BR'
--       else
--           !parameters[3] = 'BL'
--       endif
--    -- 4
--       !parameters[4] = !this.param4.val
--    -- 5
--        if (!this.datumpos.val EQ 1) then
--           !parameters[5] = 'TOP'
--       else
--           !parameters[5] = 'BOTTOM'
--       endif
-- $)

-- 1 was 6
      !parameters[1] = !this.param1.val

-- $(
--    -- 7
--       !parameters[7] = !this.param7.val
-- $)

   -- Reset the task object
   !this.task.paramval = !parameters

   -- Transfer the modified task back to the calling form
   !this.form.receiveTask(!this.task)

   -- Delete feeedback drawing
   !this.closed()

   -- Return to hierarchy position
   !!ce = !ce
     handle (2,822)
     endhandle

   -- Set calling form apply button active
   !this.form.apply.active = true

endmethod

--------------------------------------------------------------------
define method .closed()
--------------------------------------------------------------------
-- Called when form is closed

   -- Hide this form
   !this.hide()

endmethod

--------------------------------------------------------------------
define method .setCe(!val is STRING)
--------------------------------------------------------------------
-- to Set Current Element.

   if (!!ce.type NE 'SYTM') then
     !!alert.error('$!!ce.name Is Not A Symbol')
     return
   endif

   !temp = |!this.param| & !val & |.val ='| & !!ce.name.string() & |'|
   $!temp

endmethod

--------------------------------------------------------------------
define method .checkDbref(!dummyparam is REAL, !check is STRING)
--------------------------------------------------------------------
-- Called to check if this string equates to a dbref.

   $!check
   handle any
     !!alert.error(|$!check Does Not Exist|)
   endhandle

endmethod

-- -----------------------------------------------------------------------
