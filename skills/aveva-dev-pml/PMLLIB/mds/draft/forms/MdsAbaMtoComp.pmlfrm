------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  checksteel(STRING,ARRAY)         STRING
--  closed()                         -
--  getscale(STRING)                 REAL
--  init()                           -
--  justify(STRING,STRING,REAL)      STRING
--  makecolumn(ARRAY,REAL,STRING)    REAL
--  maketable(ARRAY)                 -
--  underlinelength(ARRAY)           REAL
--
