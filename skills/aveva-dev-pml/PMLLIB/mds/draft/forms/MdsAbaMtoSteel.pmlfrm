-->>>-- Extra Code for MDS HANGERS Only --<wd>15may2004
------------------------------------------------------------------------------------------------

-- Method:      .mtohanger
-- Description: TOTAL the QUANTITIES of the Identical HANGER Elements and OUTPUT them in the "HANGER<steel>" MTO.
--              <HANGERS MTO uses the same ABA TASK, PML form, function and object as for the STEEL MTO i.e. "MDSABAMTOSTEEL" >
-------------------------------------------------------------------------
-------------------------------------------------------------------------
--<wd>jan2005
--  define method .mtohanger(!elements is ARRAY, !view is DBREF) is ARRAY
define method .mtohanger(!elements is ARRAY, !view is DBREF, !mdsobject is MDSABASUPPORT) is ARRAY
  --<wd>jan2005

  -- Find the HANGER<steel> MTO Task being USED by the selected MDS ABA DRAWING TEMPLATE
  !!ce     = !view
  !vtstrng = !view.name & '/Tasks'
  !vtdbref = !vtstrng.dbref()
  handle ANY
    -- Task Layer does NOT exist so return the Original Array
    return !elements
  elsehandle NONE
    !!ce    = !vtdbref
    if (!vtdbref.mcount.eq(0)) then
      -- No Task Elements Exist so return the Original Array
      return !elements
    endif
    -- Find the MDS ABA HANGER<Steel> MTO Task being Used by the VIEW
    !hangmto = FALSE
    do !task values !vtdbref.mem
      skip if (!task.type.neq('TASK'))
      if (!task.pmlfunction.upcase().eq('MDSABAMTOSTEEL')) then
        !hangmtotask = !task
        !hangmto     = TRUE
        break
      else
        skip
      endif
    enddo
    -- HANGER<Steel> MTO Task Not Found so return the Original Array
    if (!hangmto.not()) then
      return !elements
    endif
  endhandle

  -- Get the HANGER MTO Prefix from the TASK found above i.e. !steelmtotask
  !!ce = !hangmtotask
  -- HANGER Prefix from TKPARA 11 -- Global Var used in MDSABATEELTAGS.pmlfnc for View Tags
  !hangpfx  = !!ce.mem[11].tpval
  !!hangpfx = !!ce.mem[11].tpval

  --<wd>17may2004
  -- Set the Form Member for the DETAIL TEXT to be USED from TKPARA 12
  !!mdsAbaMtoSteel.detailtext = !!ce.mem[12].tpval
  --<wd>17may2004

  -- Initialise Variables
  !hangarray = ARRAY()

  -- Loop Thro !elements[1] and create new arrays for the HANGER Prefix
  do !indx indices !elements[1]
    skip if !indx.eq(1)
    -- Populate Iterations of !elements[2],[3] and [4], when [1] is blank(''), into the last array updated
    if (!elements[1][!indx].trim().eq('')) then
      $!lastarray[1][!indx] = !elements[1][!indx]
      $!lastarray[2][!indx] = !elements[2][!indx]
      $!lastarray[3][!indx] = !elements[3][!indx]
      $!lastarray[4][!indx] = !elements[4][!indx]
      skip
    endif
    -- Populate the New Array to suit the HANGER PREFIX
    if (!elements[1][!indx].match(!hangpfx).eq(1)) then
      -- HANGER Prefix
      !hangarray[1][!indx] = !elements[1][!indx]
      !hangarray[2][!indx] = !elements[2][!indx]
      !hangarray[3][!indx] = !elements[3][!indx]
      !hangarray[4][!indx] = !elements[4][!indx]
      !lastarray = '!hangarray'
    endif
  enddo
  -- Compress the !elements ARRAY where DUPLICATE item DESCRIPTIONS occur and "quantify them"
  !newhangarray = ARRAY()

  --<wd>jan2005 -- Temporary variable
  !!xhangarray  = !hangarray

  -- Create a list of ARRAYS for TAGGED and TOTALLED components in the ARRAY !newhangarray
  !newhangarray = !this.mtostrutotals(!hangarray)
  --<wd>jan2005 -- The ARRAY variable !newhangarray will NOW have an extra iteration, i.e. Number [5]

  --<wd>jan2005
  -- Update the NEW ARRAY Form/Object member arrays in the OBKECT variable
  -- !!mdsAbaMtoSteel.data.hangviewtags before inserting iteration[1], i.e. the MTO HEADINGS TEXT
  -- with values from the variables !newarray[1] and !newarray[5]
  !this.data.hangviewtags[1] = !newhangarray[1]
  !this.data.hangviewtags[2] = !newhangarray[5]
  --<wd>jan2005

  --<wd>jan2005
  -- Do NOT Insert if MDS HANGERS belong to a MDS GROUP
  if (!mdsobject.mdsdata.mdsgroup.not()) then
    -- Insert the Original "MTO Column Heading Texts" to the Recompiled Array
    !newhangarray[1].insert(1,!elements[1][1])
    !newhangarray[2].insert(1,!elements[2][1])
    !newhangarray[3].insert(1,!elements[3][1])
    !newhangarray[4].insert(1,!elements[4][1])
    -- UNUSED Heading added to the NEW ARRAY Iteration [5]
    !newhangarray[5].insert(1,'N/A')
  endif
  --<wd>jan2005

  --<wd>jan2005 -- Temporary variable
  !!xnewhangarray  = !newhangarray

  -- Compress the Arrays before Returning
  !newhangarray[1].compress()
  !newhangarray[2].compress()
  !newhangarray[3].compress()
  !newhangarray[4].compress()
  --<wd>jan2005 -- Iteration [5] added
  !newhangarray[5].compress()

  -- Re-Define the !elements ARRAY
  return !newhangarray

endmethod

