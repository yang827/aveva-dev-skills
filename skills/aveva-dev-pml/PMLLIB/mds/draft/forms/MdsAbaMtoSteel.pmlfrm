-------------------------------------------------------------------------


------------------------------------------------------------------------------------------------
-->>>-- Extra Code for MDS STRUCTURES Only --<wd>25mar2004
------------------------------------------------------------------------------------------------

-- Method:      .mtostructure
-- Description: Total the QUANTITIES of the STEEL Joints &/or Fittings ONLY on a MDS FRAMEWORK
--              and OUTPUT in the STEEL MTO. TOTAL the quantities for each item that is identical.
-- ********************
-- ** IMPORTANT NOTE **: SCTN members of a MDS FRAMEWORK always belong to a MDS SPOOL No. of the MDS FRAMEWORK.
-- ********************  Therefore the SCTN members will still be OUTPUT in STEEL MTO as INDIVIDUAL items along
--                       with the MDS Spool Number plus the TRUE CUT LENGTH of the SCTN (TCTL) in the quantity
--                       column of the STEEL MTO.
-------------------------------------------------------------------------
-------------------------------------------------------------------------
define method .mtostructure(!elements is ARRAY,!view is DBREF)is ARRAY

  if !elements[1].size().eq(1) then
    return !elements
  endif

  -- Find the STEEL MTO Task being USED by the selected MDS ABA DRAWING TEMPLATE
  !!ce    = !view
  !vtstrng = !view.name & '/Tasks'
  !vtdbref = !vtstrng.dbref()
  handle ANY
    -- Task Layer does NOT exist so return the Original Array
    return !elements
  elsehandle NONE
    !!ce    = !vtdbref
    if (!vtdbref.mcount.eq(0)) then
      -- No Task Elements Exist so return the Original Array
      return !elements
    endif
    -- Find the MDS ABA STEEL MTO Task being Used by the VIEW
    !steelmto = FALSE
    do !task values !vtdbref.mem
      skip if (!task.type.neq('TASK'))
      if (!task.pmlfunction.upcase().eq('MDSABAMTOSTEEL')) then
        !steelmtotask = !task
        !steelmto     = TRUE
        break
      else
        skip
      endif
    enddo
    -- STEEL MTO Task Not Found so return the Original Array
    if (!steelmto.not()) then
      return !elements
    endif
  endhandle

  -- Get the STEEL MTO Prefixes from the TASK found above i.e. !steelmtotask
  -- Also Set to Global Vars -- Used in the MDSABASTEELTAGS.pmlfnc for View Tags
  !!ce = !steelmtotask
  -- SCTN Prefix from TKPARA 8
  !sctnpfx  = !!ce.mem[8].tpval
  !!sctnpfx = !!ce.mem[8].tpval
  -- Stiffener Prefix from TKPARA 9
  !stifpfx  = !!ce.mem[9].tpval
  !!stifpfx = !!ce.mem[9].tpval
  -- Joint Prefix from TKPARA 10
  !joinpfx  = !!ce.mem[10].tpval
  !!joinpfx = !!ce.mem[10].tpval

  --<wd>17may2004
  -- Set the Form Member for the DETAIL TEXT to be USED
  if !!ce.mem.size().lt(12) then
    !!mdsAbaMtoSteel.detailtext = 'DTXR'
  else
    !!mdsAbaMtoSteel.detailtext = !!ce.mem[12].tpval
  endif
  --<wd>17may2004

  -- Split the arrays !elements[1],[2],[3] and [4] according to the Task Prefixes found above and
  -- TOTAL the quantities for DUPLICATE JOINTS and/or STIFFENER PLATES ONLY.
  -- SCTN elements will REMAIN as BEFORE, i.e. INDIVIDUALLY listed in the STEEL MTO.
  -- !elements[1] contains all the STEEL MTO - TAGS          >           -- **** IMPORTANT NOTE **** --
  -- !elements[2] contains all the STEEL MTO - DBREFS        > The FIRST iteration of EACH of these ARRAYS, e.g. !elements[1][1], contains
  -- !elements[3] contains all the STEEL MTO - DESCRIPTIONS  > the Column HEADING Text for the STEEL MTO and MUST be IGNORED in each case.
  -- !elements[4] contains all the STEEL MTO - QUANTITIES    > All of the ARRAYS contain the number of indices.

  -- Initialise Variables
  !sctnarray = ARRAY()
  !stifarray = ARRAY()
  !joinarray = ARRAY()

  -- Loop Thro !elements[1] and create new arrays for EACH Prefix
  do !indx indices !elements[1]
    skip if !indx.eq(1)
    -- Populate Iterations of !elements[2],[3] and [4], when [1] is blank(''), into the last array updated
    if (!elements[1][!indx].trim().eq('')) then
      $!lastarray[1][!indx] = !elements[1][!indx]
      $!lastarray[2][!indx] = !elements[2][!indx]
      $!lastarray[3][!indx] = !elements[3][!indx]
      $!lastarray[4][!indx] = !elements[4][!indx]
      skip
    endif

    -- Populate the New Arrays to suit EACH PREFIX found
    if (!elements[1][!indx].match(!sctnpfx).eq(1)) then
      -- SCTN Prefix
      !sctnarray[1][!indx] = !elements[1][!indx]
      !sctnarray[2][!indx] = !elements[2][!indx]
      !sctnarray[3][!indx] = !elements[3][!indx]
      !sctnarray[4][!indx] = !elements[4][!indx]
      !lastarray = '!sctnarray'

    elseif (!elements[1][!indx].match(!stifpfx).eq(1)) then
      -- Stiffener Prefix
      !stifarray[1][!indx] = !elements[1][!indx]
      !stifarray[2][!indx] = !elements[2][!indx]
      !stifarray[3][!indx] = !elements[3][!indx]
      !stifarray[4][!indx] = !elements[4][!indx]
      !lastarray = '!stifarray'

    elseif (!elements[1][!indx].match(!joinpfx).eq(1)) then
      -- Joint Prefix
      !joinarray[1][!indx] = !elements[1][!indx]
      !joinarray[2][!indx] = !elements[2][!indx]
      !joinarray[3][!indx] = !elements[3][!indx]
      !joinarray[4][!indx] = !elements[4][!indx]
      !lastarray = '!joinarray'
    endif
  enddo


  -------------------------------------------------
  --<wd>feb2005
  -- Fix for MDS SPECIAL STRUCTURES that DO NOT contain any SCTN members in the STRUCTURE
  -- Create EMPTY ARRAYS for !sctnarray[1] to [4] inclusive
  if (!sctnarray.empty()) then
    do !real from 1 to 4
      !sctnarray[!real] = ARRAY()
    enddo
  endif
  --<wd>feb2005
  -------------------------------------------------

  --<wd>05aug2004
  -- ****** TEMPORARY GLOBAL VARS *******
  -- ********** DO NOT DELETE ***********
  !!xmdsabasctn = !sctnarray
  !!xmdsabastif = !stifarray
  !!xmdsabajoin = !joinarray
  !!xmdsabanew  = ARRAY()
  !!xmdsabapfx  = ARRAY()
  !!xmdsabadbr  = ARRAY()
  --<wd>05aug2004

  -------------------------------------------------------------------------------------------
  -- Compress ONLY the Joint and Stiffener Arrays where DUPLICATE items occur and TOTAL them.
  -------------------------------------------------------------------------------------------
  -- Total the Joints and sort out the Joints MTO and VIEW TAGS
  !newjoinarray = ARRAY()
  if (!joinarray.empty().not()) then
    !newjoinarray = !this.mtostrutotals(!joinarray)
    --<wd>jan2005 -- The ARRAY variable !newjoinarray will NOW have an extra iteration, i.e. Number [5]
  endif

  -- Total the Stiffeners and sort out the Stiffener MTO and VIEW TAGS
  !newstifarray = ARRAY()
  if (!stifarray.empty().not()) then
    !newstifarray = !this.mtostrutotals(!stifarray)
    --<wd>jan2005 -- The ARRAY variable !newstifarray will NOW have an extra iteration, i.e. Number [5]
  endif

  -- Redefine the !elements array with the NEW arrays
  -- Start the New array with the SCTN elements as these are LEFT as they are,
  -- i.e. Independent SCTN DBREFs <See NOTE in METHOD HEADER re SPOOL NOs.>
  !newelements  = !sctnarray

  --<wd>jan2005
  -- Compress the new SCTN arrays for compatibility with the new JOINT and new STIFFENER arrays created above.
  !newsctnarray = !sctnarray
  do !numb indices !newsctnarray
    !newsctnarray[!numb].compress()
  enddo

  -- Create a NEW iteration, [5], of the variable "!newelements" to store an array of the
  -- "SAME" Description element ARRAY numbers
  !newelements[5] = ARRAY()
  --<wd>jan2005

  --<wd>jan2005
  -- The ARRAY variable !newelements will NOW have an extra iteration, i.e. Number [5]
  -- Load array iteration !newelements[5] with the indices number of each SCTN DBREF
  !xnewsctnarray = !sctnarray[2]
  !xnewsctnarray.compress()
  do !sctn indices !xnewsctnarray
    !newelements[5][!sctn][1] = !sctn
  enddo
  -- Add the !sctnarray[5] indices to the SCTNS array to be consistent with the arrays for the JOINTS and the STIFFENERS
  !sctnarray[5]    = !newelements[5]
  !newsctnarray[5] = !newelements[5]
  --<wd>jan2005

  --<wd>jan2005
  !!xsctn = !newsctnarray
  !!xjoin = !newjoinarray
  !!xstif = !newstifarray
  --<wd>jan2005

  -- Add the Joints to the New Array
  if (!newjoinarray.empty().not()) then
    !newelements[1].appendarray(!newjoinarray[1])
    !newelements[2].appendarray(!newjoinarray[2])
    !newelements[3].appendarray(!newjoinarray[3])
    !newelements[4].appendarray(!newjoinarray[4])
    --<wd>jan2005
    !newelements[5].appendarray(!newjoinarray[5])
    --<wd>jan2005
  endif

  --<wd>jan2005
  --<wd>jan2005

  --<wd>17may2004
  --elseif (!newstifarray.empty().not()) then
  -- Add the Stiffener Plates to the New Array
  if (!newstifarray.empty().not()) then
    --<wd>17may2004
    !newelements[1].appendarray(!newstifarray[1])
    !newelements[2].appendarray(!newstifarray[2])
    !newelements[3].appendarray(!newstifarray[3])
    !newelements[4].appendarray(!newstifarray[4])
    --<wd>jan2005
    !newelements[5].appendarray(!newstifarray[5])
    --<wd>jan2005
  endif

  -- Insert the Original Column Heading Texts to the Recompiled Array
  !newelements[1].insert(1,!elements[1][1])
  !newelements[2].insert(1,!elements[2][1])
  !newelements[3].insert(1,!elements[3][1])
  !newelements[4].insert(1,!elements[4][1])

  -- Compress the Arrays before Returning
  !newelements[1].compress()
  !newelements[2].compress()
  !newelements[3].compress()
  !newelements[4].compress()
  --<wd>jan2005 -- Iteration [5] added
  !newelements[5].compress()

  --<wd> TEMPORARY VAR *** DO NOT DELETE ***
  !!xmdsabanew.delete()
  handle ANY
  endhandle
  !!xmdsabanew = !newelements

  --<wd>jan2005
  -- The NEW COMBINED ARRAY "!xnewelements[5"] will store ARRAYS of the INDICES of the DBREF(s) found
  -- in the ARRAY "!xnewelements[2]" which have the SAME description i.e. <DTXR or DTXS>.
  -- The INDIVIDUAL ARRAYS "!newsctnarray[5], !newjoinarray[5] and !newstifarray[5]"
  -- containing the SCTNS, JOINTS and STIFFENERS will be amalgamated into the NEW COMBINED ARRAY "!xnewelements[5]".
  !xnewelements = !newelements
  !xnewelements[2][1].delete()
  !xnewelements[2].compress()

  -- This NEW ARRAY "!xnewarray[5]" will store ARRAYS of the INDICES of the DBREF(s) found
  -- in the ARRAY "!xnewelements[2]" which have the SAME description i.e. <DTXR or DTXS>
  !xnewarray[5] = ARRAY()

  -- Initialise the SCTN, JOINT and STIFFENER array "size" variables
  !xsctnsize  = 0
  !xjoinsize  = 0
  !xstifsize  = 0

  -- When SCTNS exist -- <which currently they ALWAYS do, when JOINTS and/or STIFFENERS exist on a MDS STRUCTUE>
  -- Modify the ARRAY !xnewarray[5] for adding the VIEW TAGS for the SCTNS
  if (!newsctnarray.empty().not()) then
    !xsctnsize  = !newsctnarray[5].size()
    !xsctnstart = 1
    -- The FIRST "Do loop" determines the START and FINISH INDEX numbers of the SCTNS in the ARRAY "!xnewarray[5]",
    -- and uses the "!indices" counter to create a new SUB-ARRAY iteration, i.e. "!xnewarray[5][!!indices]"
    !zsctn = 0
    do !indices from !xsctnstart to !xsctnsize
      !xnewarray[5][!indices] = ARRAY()
      !zsctn = !zsctn + 1
      -- The SECOND "Do loop" determines the INDEX NUMBER(s) stored in the ARRAY "!xnewelements[2]",
      -- and stores the same INDEX NUMBER(s) in the ARRAY "!xnewarray[5][!indices]" for use
      -- in adding the VIEW TAGS for MDS SUPPORT COMPONENTS on the MDS ABA drawing
      -- via the PML function "mdsabasteeltags.pmlfnc"
      do !nsctn indices !newsctnarray[5][!zsctn]
        !nindx = !xnewelements[2].find(!newsctnarray[2][!newsctnarray[5][!zsctn][!nsctn]])
        !xnewarray[5][!indices].append(!nindx[1])
      enddo
    enddo
  endif

  -- When JOINTS exist -- Modify the ARRAY !xnewarray[5] for adding the VIEW TAGS for the JOINTS
  if (!newjoinarray.empty().not()) then
    !xjoinsize  = !newjoinarray[5].size() + !xsctnsize
    !xjoinstart = !xsctnsize + 1
    -- The FIRST "Do loop" determines the START and FINISH INDEX numbers of the JOINTS in the ARRAY "!xnewarray[5]",
    -- and uses the "!indices" counter to create a new SUB-ARRAY iteration, i.e. "!xnewarray[5][!indices]"
    !zjoin = 0
    do !indices from !xjoinstart to !xjoinsize
      !xnewarray[5][!indices] = ARRAY()
      !zjoin = !zjoin + 1
      -- The SECOND "Do loop" determines the INDEX NUMBER(s) stored in the ARRAY "!xnewelements[2]",
      -- and stores the same INDEX NUMBER(s) in the ARRAY "!xnewarray[5][!!indices]" for use
      -- in adding the VIEW TAGS for MDS SUPPORT COMPONENTS on the MDS ABA drawing
      -- via the PML function "mdsabasteeltags.pmlfnc"
      do !njoin indices !newjoinarray[5][!zjoin]
        !nindx = !xnewelements[2].find(!newjoinarray[2][!newjoinarray[5][!zjoin][!njoin]])
        !xnewarray[5][!indices].append(!nindx[1])
      enddo
    enddo
  endif

  -- When STIFFENERS exist -- Modify the ARRAY !xnewarray[5]  for adding the VIEW TAGS for the STIFFENERS
  if (!newstifarray.empty().not()) then
    !xstifsize  = !newstifarray[5].size() + !xsctnsize + !xjoinsize
    !xstifstart = !xsctnsize + !xjoinsize + 1
    -- The FIRST "Do loop" determines the START and FINISH INDEX numbers of the STIFFENERS in the ARRAY "!!xnewarray[5]",
    -- and uses the "!indices" counter to create a new SUB-ARRAY iteration, i.e. "!xnewarray[5][!indices]"
    !zstif = 0
    do !indices from !xstifstart to !xstifsize
      !xnewarray[5][!indices] = ARRAY()
      !zstif = !zstif + 1
      -- The SECOND "Do loop" determines the INDEX NUMBER(s) stored in the ARRAY "!xnewelements[2]",
      -- and stores the same INDEX NUMBER(s) in the ARRAY "!xnewarray[5][!indices]" for use
      -- in adding the VIEW TAGS for MDS SUPPORT COMPONENTS on the MDS ABA drawing
      -- via the PML function "mdsabasteeltags.pmlfnc"
      do !nstif indices !newstifarray[5][!zstif]
        !nindx = !xnewelements[2].find(!newstifarray[2][!newstifarray[5][!zstif][!nstif]])
        !xnewarray[5][!indices].append(!nindx[1])
      enddo
    enddo
  endif

  -- Update (1) the NEW ARRAY Form/Object member arrays:
  -- <1> !!mdsAbaMtoSteel.data.struviewtags[1] <Removing the HEADER text from iteration[1] and
  -- <2> !!mdsAbaMtoSteel.data.struviewtags[2]
  -- with values from the variables !newelements[1] and !newelements[5]
  !this.data.struviewtags[1] = !newelements[1]
  !this.data.struviewtags[1][1].delete()
  !this.data.struviewtags.compress()
  !this.data.struviewtags[2] = !xnewarray[5]
  --<wd>jan2005


  -- Return the Rearranged !elements array
  return !newelements

endmethod
--End of Method .mtostructure(!elements is ARRAY)is ARRAY

-------------------------------------------------------------------------
-------------------------------------------------------------------------

-- Method:      .mtostrutotals
-- ****************************
-- ** NOTE ** As from 15may2004 -- This method is now also called from the method ".mtohanger" above,
-- ****************************    used for TOTALLING the MDS HANGER components on the MDS ABA drawing
--
-- Description: Total the QUANTITIES of the STEEL Joints &/or Fittings ONLY on a MDS FRAMEWORK
--              and OUTPUT in the STEEL MTO. TOTAL the quantities for each item that is identical.
-- ********************
-- ** IMPORTANT NOTE **: SCTN members of a MDS FRAMEWORK always belong to a MDS SPOOL No. of the MDS FRAMEWORK.
-- ********************  Therefore the SCTN members will still be OUTPUT in STEEL MTO as INDIVIDUAL items along
--                       with the MDS Spool Number plus the TRUE CUT LENGTH of the SCTN (TCTL) in the quantity
--                       column of the STEEL MTO.
--
-- ** NOTE ** As from 15may2004 -- This method is now  also called from the method ".mtohanger" above,
-- ****************************    used for totalling the MDS HANGER components on the MDS ABA drawing
-------------------------------------------------------------------------
-------------------------------------------------------------------------
define method .mtostrutotals(!passedarray is ARRAY)is ARRAY

  -- Initialise Variable
  !oldarray = !passedarray

  -- Compress the !oldarray arrays to ReIndex the arrays from 1 to 'x' consecutively
  !oldarray[1].compress()
  !oldarray[2].compress()
  !oldarray[3].compress()
  !oldarray[4].compress()

  -------------------------------------------------------------------------
  -- Set !oldarray[4] to total of each type and zero subsequent
  -- values and substitute tags

  -- oldarray[1] stores the tags
  -- oldarray[2] stores the dbref of the elements
  -- oldarray[3] stores the description
  -- oldarray[4] stores the quantity

  -- While compressing the list make a new !newelements[1]
  -- and !newelements[2] so that we can replace the tags.
  !newelements[1] = ARRAY()
  !newelements[2] = ARRAY()
  !newelements[2] = !oldarray[2]
  !findsame = ARRAY()

  --<wd>jan2005
  -- Create a NEW iteration, [5], of the variable "!newelements" to store an array of the
  -- "SAME" Description element ARRAY numbers
  !newelements[5] = ARRAY()

  -- Loop thro the Descriptions ARRAY to find DUPLICATES
  do !count indices !oldarray[3]

    if (!findsame.empty().not()) then
      !testfind = !findsame.find(!count)
      skip if (!testfind.empty().not())
    endif

    if !oldarray[1][!count].trim().neq('') then
      -- NOTE:
      -- The !findsame variable will ALWAYS return an array of REALS,
      -- even if ONLY ONE item is found in the ARRAY
      !findsame = !oldarray[3].find(!oldarray[3][!count])

      ---------------------------------------------------------------------
      -- dtf >>> Wrapped text does not total correctly 14sep04
      -- check to see if text wrapped
      !tempfindsame = !findsame
      !loopcount = 1
      do !check values !findsame
        if (!count lt !oldarray[3].size() and (!oldarray[1][!count + 1].trim().eq(''))) then
          --$P |next column 1 is blank therefore text wrapped|
          !nextlinedesc = !oldarray[3][!count + 1]
          !samenextlinedesc = !oldarray[3][!findsame[!loopcount] + 1]
          if (!nextlinedesc neq !samenextlinedesc ) then
            !tempfindsame[!loopcount].delete()
          endif
          -- q var !findsame
        endif
        !loopcount = !loopcount + 1
      enddo
      !findsame = !tempfindsame
      -- dtf <<<
      -- End of Mod
      ---------------------------------------------------------------------
    endif


    --<wd>jan2005
    !newelements[5].append(!findsame)
    !!anew = !newelements[5]

    -- Determine the QUANTITY of DUPLICATE items and determine the NEW TAG Prefix and Number
    !counter = 1
    do !same values !findsame
      if !findsame.size().gt(1) then
        if !counter.eq(1) then
          --            !origoldarray = !same
          !oldarray[4][!same] = !findsame.size()
          !newtag = !oldarray[1][!same]
          !counter = 1 + 1
          skip
        else
          !oldarray[4][!same] = 0
          !oldarray[1][!same] = !newtag
        endif
      else
        !newelements[1][!count] = !oldarray[1][!count]
      endif
    enddo

  enddo

  -- Find zero values in quantity (!oldarray[4]) and delete
  !delindex = FALSE
  !delarray = ARRAY()
  !number   = 0
  do !blank from 1 to !oldarray[4].size()
    !test.delete()
    handle any
    endhandle
    !test = !oldarray[4][!blank]
    handle any
      skip
    endhandle

    -- REBUILD the ARRAY *** !oldarray *** for the ITEM Prefixes and Numbers
    if !oldarray[4][!blank].objecttype().eq('REAL') then
      if !oldarray[4][!blank].eq(0) then
        !newelements[1][!blank] = !oldarray[1][!blank]
        !delarray[1][!blank] = !oldarray[1][!blank]
        !delarray[3][!blank] = !oldarray[3][!blank]
        !delarray[4][!blank] = !oldarray[4][!blank]
        !delindex = TRUE
        !number   = !blank
      endif
    elseif !oldarray[4][!blank].objecttype().eq('STRING') then
      if !oldarray[4][!blank].trim().eq('') then
        !nextnumber = !blank - !number
        if ( (!delindex) and (!nextnumber.eq(1)) ) then
          !delarray[1][!blank] = !oldarray[1][!blank]
          !delarray[3][!blank] = !oldarray[3][!blank]
          !delarray[4][!blank] = !oldarray[4][!blank]
          !delindex = FALSE
        endif
      endif
    else
      !newelements[1][!blank] = !oldarray[1][!blank]
    endif
  enddo

  -- Delete the Indices stored in !delarray[1], [3] and [4] from the array !oldarray[1], [3] and [4]
  do !indx indices !delarray[1]
    !oldarray[1][!indx].delete()
    !oldarray[3][!indx].delete()
    !oldarray[4][!indx].delete()
  enddo

  -- Compress sorted elements
  !oldarray[1].compress()
  !oldarray[2].compress()
  !oldarray[3].compress()
  !oldarray[4].compress()

  -- Reindex !oldarray[1] now some iterations of the array may have been deleted
  !counter = 1
  !prefix = !oldarray[1][1].before('1')
  do !resetindex indices !oldarray[1]
    skip if (!resetindex.eq(1))
    skip if (!oldarray[1][!resetindex].trim().eq(''))
    !test.delete()
    handle any
    endhandle
    !test = !oldarray[1][!resetindex]
    handle any
      skip
    endhandle
    -- Reindex the ITEM numbers
    !counter = !counter + 1
    !oldarray[1][!resetindex] = !prefix + !counter.string()
  enddo

  !newarray = !oldarray
  --<wd>jan2005
  -- Update (1) the variable !newarray with iteration number [5] and
  !newarray[5] = !newelements[5]

  -- Update (2) the NEW ARRAY Form/Object member arrays in --> !!mdsAbaMtoSteel.data.hangviewtags
  -- with values from the variables !newarray[1] and !newarray[5]
  --!this.data.hangviewtags[1] = !newarray[1]
  --!this.data.hangviewtags[2] = !newarray[5]

  --<wd>jan2005
  -- Temporary Variable
  !!xnewarray  = !newarray

  -- Return the NEW rearranged array
  return !newarray

endmethod
--End of Method .mtostrutotals(!passed is ARRAY)is ARRAY

-------------------------------------------------------------------------
------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
