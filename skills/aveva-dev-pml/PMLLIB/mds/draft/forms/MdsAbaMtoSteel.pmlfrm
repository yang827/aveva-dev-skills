setup form !!mdsAbaMtoSteel blocking

  title |Choose options|
  !this.callback = '!this.init()'

  -- Define Members/Selection Areas
  -- ------------------------------
  path down
  frame .options | Parameters | at x0
    text .param1  '  Require Columns '  width 20 is STRING
    text .param2  '  Column Headings '  width 20 is STRING
    text .param3  '    Column Widths '  width 20 is STRING
    text .param4  ' Column Direction '  width 20 is STRING
    text .param5  'Starting Position '  width 20 is STRING
    text .param6  '  Include in List '  width 20 is STRING
    text .param7  '        Text Size '  width 20 is STRING
    text .param8  '   Section Prefix '  width 20 is STRING
    text .param9  '  Stiffener Prefix ' width 20 is STRING
    text .param10 '     Joint Prefix '  width 20 is STRING
    text .param11 '    Hanger Prefix '  width 20 is STRING
    text .param12 '  Description Text'  width 20 is STRING
    para .spln text 'Add Spool Numbers '
    toggle .param13 at xmax ymin
  exit

  -- Action buttons
  -- --------------
  hdist 1.25
  button .ok     |  OK  | at x0                     call |!this.apply()| ok
  button .cancel |Cancel| at xmax form-size ymin.ok call |!this.closed()| cancel

  -- Members
  member .tsize          is REAL
  member .topline        is DBREF
  member .toplinelen     is REAL
  member .bottomline     is ARRAY
  member .taskName       is STRING
  member .taskparams     is ARRAY
  member .tags           is ARRAY
  member .materials      is ARRAY
  member .lenqty         is ARRAY
  member .symbolref      is STRING
  member .startpos       is ARRAY
  member .elements       is ARRAY
  member .params         is ARRAY
  member .types          is ARRAY
  member .data           is MDSABAMTOSTEEL
  member .detailtext     is STRING
  member .units          is COMUNITS
  member .task           is ABATASK
  member .form           is FORM

  !this.symbolref = '/DRA/MAS/SYMBOLS/GEN/MISC'

  ------------------------------------------------
  -- define the type of text to be output
  --<wd>17may2004
  -- The TASK PARAM 12 of the task MDSABAMTOSTEEL of VIEW<.../V3>
  -- will be SET to the DETAIL TEXT attribute to read by getting the VALUE from the TASK itself.
  -- *****************************************************************************************************************
  -- See the MDS ABA DRAWING TEMPLATE for the MTO VIEW (Normally .../V3) and get the value in the TASK setting,
  -- for the gadget ---> !!mdsAbaMtoSteel.detailtext <---
  -- i.e. From either of the FORM methods <1>!!mdsAbaMtoSteel.mtohanger or <2>!!mdsAbaMtoSteel.mtostructure
  --******************************************************************************************************************
  ------------------------------------------------
  --<wd> *** CODE BELOW is NOT USED ANY MORE ***
  --  !this.detailtext = 'DTXR'
  -- can be 'STEXT' or 'RTEXT'
  --  !this.detailtext = 'RTEXT'
  --<wd>17may2004
  --  !this.detailtext = 'STEXT'
  ------------------------------------------------


  -- Set feedback name
  -- End of form definition
exit

--------------------------------------------------------------------
define method .init()
  --------------------------------------------------------------------
  -- Called when form is shown
  -- Initialise variables
  !ce = !!ce

  -- Set form title
  !this.formTitle = !this.task.name
  handle any
    !this.formTitle = 'MDS ABA Mto Steel'
    handle (2,751)
      -- Probably means that the form is just being initialised.
    endhandle
  endhandle

  -- Hold name of task
  !this.taskName = !this.task.name
  handle (2,751)
    -- Stops form failing when being initialised for methods.
  endhandle

  -- Load text boxes with current settings for parameter values.
  do !param index !this.task.paramval
    !cmnd = '!this.param' & !param & '.val = |' & !this.task.paramval[!param] & '|'
    if !param eq 13 then
      !cmnd = '!this.param' & !param & '.val = '  & !this.task.paramval[!param]
    endif
    $!cmnd
  enddo

  -- Return to hierarchy position
  !!ce = !ce
endmethod

--------------------------------------------------------------------
define method .apply()
  --------------------------------------------------------------------
  -- Called when apply is pressed
  -- Initialise variables
  !ce = !!ce

  -- Build parameters array
  do !param
    !cmnd = |!parameters[| & !param & |] = !this.param| & !param & |.val|
    $!cmnd
    handle any
      break
    endhandle
  enddo

  -- Reset the task object
  !this.task.paramval = !parameters

  -- Transfer the modified task back to the calling form
  !this.form.receiveTask(!this.task)

  -- Delete feedback drawing
  !this.closed()

  -- Return to hierarchy position
  !!ce = !ce
  handle (2,822)
  endhandle

  -- Set calling form apply button active
  !this.form.apply.active = true

endmethod

-- -------------------------------------------------------------
define method .checkComp(!check is STRING, !tkparas is ARRAY) is STRING
  -- -------------------------------------------------------------
  !xypos = '0'

  -- Method to check to see if steelwork task has already been run.
  if (!check.substring(1,3) eq 'Old') then
    !xypos = TPVALUE of $!tkparas[2]

  else

    -- Check to see if task is the right one.
    -- First TKPARA is the offset.

    !shift = TPVALUE of $!tkparas[1]
    handle (2,752)
      !shift = '0'
    endhandle
    BY Y -$!shift
    var !xypos XYPOS

  endif

  return !xypos


endmethod

-- -------------------------------------------------------------
define method .makeStraight()
  -- -------------------------------------------------------------

  !save = !!ce
  var !btext SPLIT EXTENT BTEXT
  NEW VNOTE
  NEW STRA
  !fpt = 'X ' & $!btext[2] & ' Y ' & $!btext[4]
  !tpt = 'X ' & $!btext[6] & ' Y ' & $!btext[8]
  FPT $!fpt
  TPT $!tpt
  NEW STRA
  !fpt = 'X ' & $!btext[10] & ' Y ' & $!btext[12]
  !tpt = 'X ' & $!btext[14] & ' Y ' & $!btext[16]
  FPT $!fpt
  TPT $!tpt

  !!ce = !save

endmethod

---------------------------------------------------------------
--<wd>jan2005
--define method .maketable(!elements is ARRAY)
define method .maketable(!elements is ARRAY, !mdsobject is MDSABASUPPORT)
  ---------------------------------------------------------------

  --<wd>jan2005
  -- Initialise MDS Support variables
  !mdsgroup    = !mdsobject.mdsdata.mdsgroup
  !support     = !mdsobject.support
  --  !supportname = !support.name

  -- Initialise the MDS FRAMEWORK STRUCTURE "!elements" variable
  if ( (!mdsgroup) and (!support.type.eq('STRU')) ) then
    -- Master MDS FRAMEWORK Support of a MDS GROUP
    !struelements = !this.data.struelements
  elseif (!support.type.eq('STRU')) then
    -- Individual MDS FRAMEWORK Support
    !struelements = !elements
  endif

  -- The CODE below is NOW obsolete and has been commented out.
  --shee
  --!supportname = !!ce.darref.name.before('-AREA')
  --same
  --<wd>jan2005

  -- Compress table by finding duplicate descriptions only for hangers
  --<wd>25mar2004
  !xview = !!ce

  --*************************************************************************************************
  --<wd>jan2005
  --  if !supportname.dbref().type.eq('ATTA') then
  if (!support.type.eq('ATTA')) OR (!support.type.eq('CTSUPP')) then
    --if (!support.type.eq('ATTA')) then
    if (!mdsgroup) then
      -- Support is a INDIVIDUAL MDS HANGER Should NOT be in this CODE when support is a MDS GROUP
      -- Therefore RESET mdsgroup object member to FALSE
      !mdsobject.mdsdata.mdsgroup = FALSE
      return
    endif
    --<wd>jan2005
    ------------------------------------------------------------------------------------------------

    --<wd>24mar2004
    -- *********************************************************
    -- This CODE is used for MDS *** HANGER TEMPLATES etc... ***
    -- *********************************************************
    --
    -- Split the arrays !elements[1],[2],[3] and [4] according to the Task Prefixes found above and
    -- TOTAL the quantities for DUPLICATE Hanger Components.
    -- !elements[1] contains all the HANGER MTO - TAGS                 >           -- **** IMPORTANT NOTE **** --
    -- !elements[2] contains all the HANGER ELEMENT MTO - DBREFS       > The FIRST iteration of EACH of these ARRAYS, e.g. !elements[1][1], contains
    -- !elements[3] contains all the HANGER ELEMENT MTO - DESCRIPTIONS > the Column HEADING Text for the HANGER MTO and MUST be IGNORED in each case.
    -- !elements[4] contains all the HANGER ELEMENT MTO - QUANTITIES   > All of the ARRAYS contain the number of indices.

    --<wd>jan2005 -- The ARRAY variable !totalelements will NOW have an extra iteration, i.e. Number [5]
    !totalelements = !this.mtohanger(!elements,!xview, !mdsobject)

    -- Reset the !elements variable
    !oldelements = !elements
    !elements    = !totalelements

    -- Navigate back to the MDS ABA View containing the Steel and Component MTO
    !!ce = !xview

    -- <wd> TEMPORARY VARIABLE FOR REF ONLY
    !!wfd = !elements
    --<wd>24mar2004


    ------------------------------------------------------------------------------------------------
    --<wd>jan2005
    -- CODE below modified to WORK with MDS GROUPS or INDIVIDUAL MDS framework Supports
    -- *** NOTE *** The Master MDS Support in a MDS GROUP is always a MDS FRAMEWORK ***

    --<wd>24mar2004
    --elseif  !supportname.dbref().type.eq('STRU')then
  elseif (!support.type.eq('STRU')) then
    -- The MDS 'STRU' will either be an INDIVIDUAL MDS FRAMEWORK or the MASTER MDS FRAMEWORK in a MDS GROUP
    --<wd>jan2005

    -- If no steelwork exists do not write the table
    -- if !!elements[1].size().eq(1) then
    -- return
    -- endif

    ---------------------------------------------------------------------------------------------------
    --<wd>jan2005
    --This CODE is used for MDS FRAMEWORK TEMPLATES.
    -- Either an INDIVIDUAL MDS FRAMEWIORK or a MASTER MDS FRAMEWORK in a MDS GROUP
    --<wd>jan2005

    -- Compress STEEL MTO for MDS FRAMEWORK STRUCTURE by TOTALLING together DUPLICATE
    -- JOINTS and/or FITTINGS ONLY belonging to the MDS FRAMEWORK.
    -- SCTN elements will still be OUTPUT in the STEEL MTO as INDIVIDUAL elements,
    -- to ensure the MDS FRAMEWORK SCTN Spool Numbers are maintained.
    !totalstruelems = !this.mtostructure(!struelements,!xview)
    if !totalstruelems[1].size().eq(1) then
      return
    endif
    !oldelements = !elements
    !elements    = !totalstruelems
    --$P
    --$P+++++++++++++ TOTAL STRU ELEMENTS ++++++++++++++++
    --q var !totalstruelems
    --q var !elements
    --q var !!mdsAbaMtoSteel.data.struviewtags[1]
    --q var !!mdsAbaMtoSteel.data.struviewtags[2]
    --$P++++++++++++++++++++++++++++++++++++++++++++
    --$P
    --<wd>jan2005

    ---------------------------------------------------------------------------------------------------

    --<wd>jan2005
    -- The MDS HANGER members of a *** MDS GROUP *** will be TOTALLED etc... here
    -- Compress the MTO for the MDS HANGERS by TOTALLING together DUPLICATE
    -- HANGER elements belonging to ALL of the MDS HANGERS in the MDS GROUP.

    if (!mdsgroup) then
      -------------------------------------------------
      --<wd>jul2005
      -- Do NOT try and TOTAL the HANGER Elements if NO MDS HANGERS ELEMENTS EXIST in the MDS GROUP
      if (!this.data.hangelements[1].size().gt(1)) then

        -- Support is in a MDS GROUP -- MDS HANGER elements are stored in the OBJECT member !this.data.hangerelements
        !totalhangelems = !this.mtohanger(!this.data.hangelements,!xview, !mdsobject)
        --<wd>jan2005

        -- Append Totalled HANGER elements to the !elements[<iteration>] variables
        !elements[1].appendarray(!totalhangelems[1])
        !elements[2].appendarray(!totalhangelems[2])
        !elements[3].appendarray(!totalhangelems[3])
        !elements[4].appendarray(!totalhangelems[4])
        !elements[5].appendarray(!totalhangelems[5]) $* --<wd>feb2005 --"CHECK" PROBABLY NOT REQUIRED ANY MORE for VIEW TAGGING

      endif
      --<wd>jul2005
      -------------------------------------------------
    endif

    !!wfdelems = !elements
    --<wd>jan2005

    -- Navigate back to the MDS ABA View containing the Steel and Component MTO
    !!ce = !xview
    --<wd>24mar2004
    ------------------------------------------------------------------------------------------------
  endif
  --*************************************************************************************************


  -- The Global array variable !!elements is set here for use later by the MAIN DETAIL
  -- VIEWS Tagging function, i.e. --> !!mdsAbaSteelTags(!view is DBREF,!params is STRING)
  -- Store the TAGS in the Global variable !!elements[1]
  !!elements[1] = !elements[1] $* --<wd>jan2005 --NOT REQUIRED ANY MORE for VIEW TAGGING

  -- Store the DESCRIPTIONS in the Global variable !!elements[2]
  !!elements[2] = !elements[3] $* --<wd>jan2005 --NOT REQUIRED ANY MORE for VIEW TAGGING

  --<wd>jan2005
  -- Update the Form/Object ARRAy member .elements with ARRAY iteration number[5]
  !this.data.elements[5] = !elements[5] $* --<wd>feb2005 --"CHECK" PROBABL NOT REQUIRED ANY MORE for VIEW TAGGING

  ------------------------------------------------------------------------------------------------
  !save = !!ce

  -- Set position of the table equal to the top left hand corner
  -- of the view.
  var !view SPLIT SIZE
  var !position SPLIT XYPOS OF VIEW
  !left = !position[2].real() - !view[1].real() / 2
  !top  = !position[4].real() + !view[2].real() / 2

  -- Move to NOTES Layer.
  var !name NAME OF VIEW

  -- Collect all layers.
  var !layers COLL ALL TASK WITH (ATTRIB FUNCTION of OWNER eq 'MTO-Task') FOR CE
  !shifttable = '0'
  do !postask index !layers
    var !pmlf PMLFUNC of $!layers[$!postask]
    if (!pmlf.upcase() eq 'MDSABAMTOSTEELSHIFT' AND !postask eq 1) then
      !shifttable = '0'
    else
      var !unusedval TPVALUE of TKPARA 1 of $!layers[$!postask]
      !shifttable = TPVALUE of TKPARA 1 of $!layers[$!postask]
    endif
  enddo

  -- Collect task for the current layer.
  var !tkparas COLL ALL TKPARA WITH (ATTRIB PMLFUNC of Owner eq 'MdsAbaMtoCompShift') FOR CE

  -- Now create new layer for "steel" table.
  !notes = !name & |/STEEL_Task|
  $!notes
  handle (2,109)
    !check = 'NewTable'
    NEW LAYER
    NAME $!notes
  elsehandle none
    !check = 'OldTable'
    delete LAYER
    NEW LAYER
    NAME $!notes
  endhandle

  -- Set Function
  FUNCTION 'MTO-Task'

  -- initialise label creation and positioning.
  NEW SLAB
  CHEI $!!mdsAbaMtoSteel.data.taskparams[7]

  --------------------------------------------
  --<wd>08apr2008 - DUN824 - Defect No. P-4526
  -- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
  --   TPEN 51
  TXCOLOUR 6
  --<wd>08apr2008 - DUN824 - Defect No. P-4526
  --------------------------------------------

  !dflttmrf = !this.symbolref & '/CELL_TEXT'
  !tmrf = !this.symbolref & '/CELL_TEXT/' & !!mdsAbaMtoSteel.data.taskparams[7]
  TMRF $!tmrf
  handle ANY
    TMRF $!dflttmrf
  endhandle
  ATEXT 'Start#/line'
  LLEAD FALSE
  !ddname = !this.data.supname
  DDNAME $!ddname
  XYPOS X $!left Y $!top

  -- Check to see if Components table has been defined.
  !xypos = !this.checkComp(!check, !tkparas)
  BY Y -$!shifttable

  !firstlabel = !!ce
  var !unusedtextsize CHEIGHT
  !this.tsize = (!!mdsAbaMtoSteel.data.taskparams[7].real() + 2 )
  NEW SLAB COPY PREV
  !tmrf = !this.symbolref & '/TOPLINE_CELL'
  TMRF $!tmrf
  !this.topline = !!ce
  !this.toplinelen = 0
  NEW SLAB COPY PREV
  !tmrf = !this.symbolref & '/UNDERLINE_CELL'
  TMRF $!tmrf
  !underline = !!ce


  -- Create Table by adding columns of data together to make up block
  -- of cells, representing the data required, this can be configured
  -- by changing the order of calls to the various data arrays.

  -- --------------------------------------------------------------
  -- ---------------------- T A G S -------------------------------
  -- --------------------------------------------------------------

  $!firstlabel
  -- First Column For Table Numbers.
  !offset = !this.makecolumn(!elements[1],1,'C')

  -- --------------------------------------------------------------
  -- ------------------ D E S C R I P T I O N ---------------------
  -- --------------------------------------------------------------
  BY X $!offset
  $!firstlabel
  !offset = !this.makecolumn(!elements[3],2,'L')

  -- --------------------------------------------------------------
  -- ---------------------- Q U A N T I T Y -----------------------
  -- --------------------------------------------------------------
  BY X $!offset
  $!firstlabel
  !offset = !this.makecolumn(!elements[4],3,'C')

  --<wd>09apr2008-- Commented Out because variable !alltask does NOT exist so the DO LOOP is doing NOTHING-- Check to see if task is the right one.
  --<wd>09apr2008-- Commented Out because variable !alltask does NOT exist so the DO LOOP is doing NOTHING   do !task value !alltask
  --<wd>09apr2008-- Commented Out because variable !alltask does NOT exist so the DO LOOP is doing NOTHING      var !pmlf PMLFUNC OF $!task
  --<wd>09apr2008-- Commented Out because variable !alltask does NOT exist so the DO LOOP is doing NOTHING      if (!pmlf.upcase() eq 'MDSABAMTOSTEELSHIFT') then
  --<wd>09apr2008-- Commented Out because variable !alltask does NOT exist so the DO LOOP is doing NOTHING          $!task
  --<wd>09apr2008-- Commented Out because variable !alltask does NOT exist so the DO LOOP is doing NOTHING          delete TASK
  --<wd>09apr2008-- Commented Out because variable !alltask does NOT exist so the DO LOOP is doing NOTHING      endif
  --<wd>09apr2008-- Commented Out because variable !alltask does NOT exist so the DO LOOP is doing NOTHING   enddo

  NEW TASK
  PMLFUNC 'MdsAbaMtoSteelShift'
  NEW TKPARA
  TPVALUE '$!this.data.endoftable'
  NEW TKPARA
  TPVALUE '$!this.tsize'
  NEW TKPARA
  !size = !elements[1].size()
  TPVALUE '$!size'
  NEW TKPARA
  TPVALUE '$!xypos'

  -- Tidy up after table creation.
  $!firstlabel
  delete SLAB
  $!underline
  delete SLAB

  --   $(
  --
  ---- Move whole table by u !this.tsize
  --
  --   laye
  --
  --   var !mem coll all for ce
  --   do !moveUp values !mem
  --     !!ce = !moveUp.dbref()
  --     by y $!this.tsize
  --       handle ANY
  --       endhandle
  --   enddo
  --
  --   laye
  --
  --   $)

endmethod

--------------------------------------------------------------------
define method .closed()
  --------------------------------------------------------------------
  -- Called when form is closed

  -- Hide this FORM
  !this.hide()

endmethod

------------------------------------------------------------------------------------
define method .getscale(!parameter is STRING) is REAL
  ------------------------------------------------------------------------------------

  var !viewsize SPLIT SIZE OF VIEW
  var !unusedviewxy SPLIT XYPOS OF VIEW
  !width = 0

  do !cols value !parameter.split(',')
    if (!cols.upcase() ne 'AUTO') then
      !width = !width + !cols.real()
    endif
  enddo

  !scale = !viewsize[1].real() - !width

  return !scale
endmethod

------------------------------------------------------------------------------------
define method .justify(!justString is STRING, !just is STRING, !scale is REAL) is STRING
  ------------------------------------------------------------------------------------
  if !justString.trim().eq('') then
    return !justString
  endif

  -- Work out how long the text is related to the text field width.
  if (!just eq 'L') then
    -- Do nothing, just send it back.
    !text = !justString

    -- Deal with the Centre justified text.
  elseif (!just eq 'C') then
    -- Work out how much width a space is.
    ATEXT ' '
    var !sp SPLIT EXTENT BTEXT
    !aspace = !sp[6].real() - !sp[2].real()

    -- Now work out how many spaces are needed to put it in the middle.
    --<wd>jan2003
    -- Catering for Imperial Distance Units
    ATEXT |$!justString|
    --<wd>jan2003
    var !extent SPLIT EXTENT BTEXT
    !txtwid = !extent[6].real() - !extent[2].real()
    !unusednumchars = !txtwid / !aspace

    !differ = (!scale - !txtwid) / 2
    !numspaces = !differ / !aspace
    !space = ''

    --        do !addspace from 1 to !numspaces
    do from 1 to !numspaces
      !space = ' ' & !space
    enddo

    -- Workout difference between ends.
    !text = !space & !justString

  else
    -- Deal with the Right justified text.
    !text = !justString
  endif

  return !text
endmethod

-- ----------------------------------------------------------------------------------------------
define method .makecolumn(!columnarray is ARRAY, !column is REAL, !just is STRING) is REAL
  -- ----------------------------------------------------------------------------------------------

  !save = !!ce
  --!arraylist = ARRAY()

  -- Get length of underline char.

  -- Use calculation for tight tables, or use parameter settings
  -- for specific table.0

  if (!!mdsAbaMtoSteel.data.taskparams[3].split(',').findfirst('Auto') eq !column) then
    !scale = !this.getscale(!!mdsAbaMtoSteel.data.taskparams[3])

  else
    --!scale = !this.underlinelength(!arraylist) + 2
    !scaletemp = !!mdsAbaMtoSteel.data.taskparams[3].split(',')[!column].real()
    !scale = !scaletemp.value()

    --!scale = !tempScale.real().value().string()
  endif

  -- Make table for labels.

  do !list index !columnarray
    -- Define TEXP for all different SCTN in view.
    NEW SLAB COPY PREV
    !nextLabel = !!ce
    !label = !columnarray[!list].real().value().string()
    handle any
      !label = !columnarray[!list]

      --q var !label
      --.real().value().string()
      handle (2,761)
        !label = !columnarray[!list].string('D0')
        --q var !label
        --.real().value().string()
      endhandle
    endhandle
    if (!list eq 1) then
      !text = !this.justify(!label,'C',!scale)

    else
      !text = !this.justify(!label,!just,!scale)
    endif
    --<wd>jan2003
    -- Catering for Imperial Distance Units
    --ATEXT '$!text'
    ATEXT |$!text|
    handle (2,9)
      !text = !text.trim()
      ATEXT |$!text|
    endhandle
    --<wd>jan2003

    BY Y -$!this.tsize
    NEW SLAB COPY PREV
    !tmrf = !this.symbolref & '/UNDERLINE_CELL'
    TMRF $!tmrf

    !scale = !scale.value()
    XYSCALE $!scale 1
    var !posce SPLIT XYPOS
    $!nextLabel

  enddo

  if (!column eq 1) then
    -- Save end of table position.
    !this.data.endoftable = !this.tsize * !columnarray.size()

    -- Save position of the last line in the table.
    !supname = !!mdsAbaMtoSteel.data.supname
    if (!!mdsAbaMtoSteel.data.suptype eq 'SUPP') then
      var !posv SPLIT SHPOS OF $!supname
    else
      var !posv SPLIT SHPOS OF CREF OF $!supname
    endif
    --   var !posce SPLIT XYPOS
    !posX = !posv[2].real() + !posce[1].real()
    !posY = !posv[4].real() + !posce[2].real()
    !this.data.endpos.east = !posX
    !this.data.endpos.north = !posY
  endif

  -- Save current start position for next column.
  var !this.startpos split XYPOS

  -- Reset topline length
  -- Extend top line over by width of column just completed.
  $!this.topline
  !this.toplinelen = (!this.toplinelen + !scale)
  XYSCALE $!this.toplinelen 1

  -- Reposition to start, and refresh graphics
  !!ce = !save

  -- Return offset for next column.
  return !scale

endmethod

--  $(
--  -- ----------------------------------------------------------------------------------
--  define method .makecolumnold(!array is ARRAY,!heading is ARRAY,!column is REAL) is REAL
--  -- ----------------------------------------------------------------------------------
--
--  !save = !!ce
--  !arraylist = ARRAY()
--
--  -- Add heading to table column.
--     !arraylist[1] = !heading[!column]
--     !arraylist.appendarray(!array)
--
--  -- Get length of underline char.
--
--  -- Use calculation for tight tables, or use parameter settings
--  -- for specific table.
--  if (!this.params[3].split(',')[!column].upcase() eq 'AUTO') then
--      !scale = !this.getscale(!this.params[3])
--  else
--    --!scale = !this.underlinelength(!arraylist) + 2
--      !scale = !this.params[3].split(',')[!column].real()
--  endif
--
--  -- Make table for labels.
--
--    do !list index !arraylist
--   -- Define TEXP for all different SCTN in view.
--         NEW SLAB COPY PREV
--         !nextLabel = !!ce
--         !label = !arraylist[!list]
--       if (!heading[!column] eq 'CLOSURE') then
--         ATEXT ' '
--         !scale = 0.1
--       else
--         ATEXT '$!label'
--       endif
--         BY Y -$!this.tsize
--         NEW SLAB COPY PREV
--         !tmrf = !this.symbolref & '/UNDERLINE_CELL'
--         TMRF $!tmrf
--         XYSCALE $!scale 1
--         $!nextLabel
--
--    enddo
--
--    var !lastone SPLIT EXTENT BTEXT
--    !this.bottomline = !lastone
--
--  -- Save current start position for next column.
--     var !this.startpos split XYPOS
--
--  -- Reset topline length
--  -- Extend top line over by width of column just completed.
--     $!this.topline
--     !this.toplinelen = (!this.toplinelen + !scale)
--     XYSCALE $!this.toplinelen 1
--
--  -- Reposition to start, and refresh graphics
--     !!ce = !save
--
--  -- Return offset for next column.
--     return !scale
--
--  endmethod
--  $)
-- -----------------------------------------------------------------------
define method .underlinelength(!array is ARRAY) is REAL
  -- -----------------------------------------------------------------------
  !save = !!ce

  -- This method returns the scale factor for the underline symbol,
  -- for a given array of text strings.

  !width = 0

  NEW VNOTE /texp_width
  handle any
    -- GLAB exists, delete first
    /texp_width
    delete VNOTE
    NEW VNOTE /texp_width
  endhandle

  NEW TEXP
  BTEXT ' '
  CHEIGHT 3

  -- Cycle round array to find longest string to calculate
  -- scale of underline symbol.

  do !line values !array
    btext '$!line'
    var !len split extent btext
    !length = !len[6].real() - !len[2].real()
    if (!length gt !width) then
      !width = !length
    endif
  enddo

  /texp_width
  delete VNOTE
  !!ce = !save
  return !width

endmethod
