setup form !!mdsabarundata blocking

  title |Choose options|
  init |!this.init()|

-- Define Members/Selection Areas
-- ------------------------------

    path down
  frame .options | Parameters | at x0
    option .param1 'User Name From ' width 20
    text .param2 ' Text Height ' width 10 is STRING
    text .param3 '  X in Sheet ' width 10 is STRING
    text .param4 '  Y in Sheet ' width 10 is STRING
  exit

-- Action buttons
-- --------------

 hdist 1.25
  button .ok     |  OK  | at x0                     call |!this.apply()| ok
  button .cancel |Cancel| at xmax form-size ymin.ok call |!this.closed()| cancel

  -- Members

  member .taskName       is STRING
  member .taskParams     is ARRAY
  member .option         is ARRAY

  member .task     is ABATASK
  member .form     is FORM

  -- Settings

  !this.option[1] = 'Login Name'
  !this.option[2] = 'PDMS User Name'
  !this.param1.dtext = !this.option

  -- Set feedback name

-- End of form definition
exit

--------------------------------------------------------------------
define method .init()
--------------------------------------------------------------------
-- Called when form is shown

   -- Initialise variables
   !ce = !!ce

   -- Set form title
   !this.formTitle = !this.task.description
       handle (2,751)
          -- Probably means that the form is just being initialised.
       endhandle

-- Hold name of task
   !this.taskName =  !this.task.name
       handle (2,751)
          -- Probably means that the form is just being initialised.
       endhandle

-- Load text boxes with current settings for parameter values.
   do !param index !this.task.paramval
      !cmnd = '!this.param' & !param & '.val = |' & !this.task.paramval[!param] & '|'
      $!cmnd
        handle (61,578)
          -- if (!this.task.paramval[!param] EQ !this.option[1]) then
-- q var !this.task.paramval[!param]
          if (!this.task.paramval[!param].real() EQ 1) then
              !this.param1.val = 1
          else
              !this.param1.val = 2
          endif
        endhandle
   enddo

   -- Return to hierarchy position
   !!ce = !ce
endmethod

--------------------------------------------------------------------
define method .apply()
--------------------------------------------------------------------
-- Called when apply is pressed

   -- Initialise variables
   !ce = !!ce

   -- Build parameters array
   do !param
       !cmnd = |!parameters[| & !param & |] = !this.param| & !param & |.val|
       $!cmnd
       handle any
          break
       endhandle
   enddo

  -- Reset the task object
  !this.task.paramval = !parameters

  -- Transfer the modified task back to the calling form
  !this.form.receiveTask(!this.task)

   -- Delete feeedback drawing
   !this.closed()

   -- Return to hierarchy position
   !!ce = !ce
     handle (2,822)
     endhandle

   -- Set calling form apply button active
   !!abaTemplateSht.ok.active = true

endmethod

--------------------------------------------------------------------
define method .closed()
--------------------------------------------------------------------
-- Called when form is closed

   -- Hide this form
   !this.hide()

endmethod
-- -----------------------------------------------------------------------

--------------------------------------------------------------------
define method .getDate() is STRING
--------------------------------------------------------------------
-- Called when date is required.

-- Sort out date from system and return date in require format.
   !date = object DATETIME()
   !result = !date.date() & ' ' & !date.monthstring().substring(1,3) & ' ' & !date.year()

--<wd>04jul2006>
-- TEMPORARY DATE TIME change for MDS ABA TESTING to include HOURS:MINS:SECS
--   !result = !date
--<wd>04jul2006>

   return !result

endmethod
