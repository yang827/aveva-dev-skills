setup form !!MdsAbaScale

  title |MDS Scale Override|

  para .sheename at x1 y0.5 width 50 lines 1

  option .scale | Scale | at x11 y2 width 16

  button .ok     |   OK   | at x0 y3.5 call |!this.apply()| ok
  button .cancel | Cancel | at xmax form-size ymin.ok call || cancel

-- members

  member .shee is DBREF

-- End of form definition
exit

--------------------------------------------------------------------
define method .init()
--------------------------------------------------------------------

-- Can I find a shee

  shee
    handle ANY
      !!Alert.Error('Unable to locate sheet to modify the MDS scale')
      return
    endhandle

-- OK is it a MDS sheet

  !function = function of owner of linkref
    handle ANY
      !!Alert.Error('Selected sheet in not an MDS ABA Drawing')
      return
    endhandle

  if !function.neq('MDS') then
    !!Alert.Error('Selected sheet in not an MDS ABA Drawing')
    return
  endif

  !this.shee = !!ce
  !this.sheename.val = !this.shee.name

-- Complete the available scale in the scale gadget

  !ScDtext = array()
  !ScRtext = array()
  !ScDtext.append('MDS')
  !ScRtext.append('0')

-- Read permitted scales from  defaults file section 2

  !file = object file(!!abaDefaults.DefaultsFile.val)
  !defaultText = !file.readfile()
  !start = !defaultText.findfirst('-- Section 2') + 1
  !end   = !defaultText.findfirst('-- End Section 2')
  !range = !end - !start
  !scales = !defaultText.from(!start,!range)

-- Extract relevant bits for form gadget

  do !x values !Scales
-- All Scales need to be Checked NOT just the Metric values
    !split = !x.split('\')
    !ScDtext.append(!split[3])
    !ScRtext.append(!split[5].split(',')[1])
  enddo

-- Find nearest relevant scales

  !this.scale.dtext = !scdtext
  !this.scale.rtext = !scrtext

  !MdsScale = !!ce.:mdsscale
  if !MdsScale.real().eq(0) then
    !this.scale.val = 1
  else
    !FindScale = !this.scale.rtext.find(!MdsScale)
    !this.scale.val = $!findscale[1]
  endif

  --!FindScale = !this.rtext


  show !!MdsAbaScale

endmethod

--------------------------------------------------------------------
define method .apply()
--------------------------------------------------------------------

-- Called when apply is pressed
-- Initialise variables

  !ce = !!ce

  !!ce = !this.shee
  !SelectedScale = !this.scale.rtext[$!this.scale.val]
  :MdsScale '$!SelectedScale'

   !!ce = !ce

endmethod

--------------------------------------------------------------------
