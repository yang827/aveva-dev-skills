---------------------------------------------------------------------------------------------------------

define method .drwgList(!template is STRING, !supports is ARRAY, !hsupports is ARRAY)

  --<wd>feb2005
  -- Clear Form members
  !this.newdrwgs.clear()
  !this.olddrwgs.clear()
  --<wd<feb2005>

  -- Create the list of ABA Drawing Names (e.g. MDS ABA TEMPLATE NAME + MDS ABA AREA NAME)
  !tmpl = '/' & !template
  -- !htmpl = '/' & !htemplate
  do !val indices !hsupports
    !areaName = !hsupports[!val] & '-AREA'
    -- Get the Volume of the MDS Support
    !drwgName = !tmpl & '-' & !areaName
    !!ce = !drwgName.dbref()
    handle (2,109)
      -- Undefined Name, therefore Create a NEW Drawing Name ONLY
      !this.newdrwgs.append(!drwgName)
    elsehandle none
      -- The Drawing name already Exists
      !this.olddrwgs.append(!drwgName)
    endhandle
  enddo

  -- Get the Name of the Drawing and Check if it Already Exists
  do !val indices !supports
    !areaName = !supports[!val] & '-AREA'
    -- Get the Volume of the MDS Support
    !drwgName = !tmpl & '-' & !areaName
    !!ce = !drwgName.dbref()
    handle (2,109)
      -- Undefined Name, therefore Create a NEW Drawing Name ONLY
      !this.newdrwgs.append(!drwgName)
    elsehandle none
      -- The Drawing name already Exists
      !lock = !!ce.lock
      if !lock then
        --       $P locked drawing $!drwgName
        !!abaLogging.error('Cannot delete old drawing $!drwgName as it is locked - Drawing aborted')
      else
        !this.olddrwgs.append(!drwgName)
        -- $P ------- .drwgList in mdsabaselsupp -------------
        -- $P q var !drwgName
        -- q var !drwgName
      endif
    endhandle
  enddo

  --<wd>feb2005
  -- Unique Form member ARRAYs
  !this.newdrwgs.unique()
  !this.olddrwgs.unique()
  --<wd<feb2005>


  -- $P q var !this.olddrwgs
  -- q var !this.olddrwgs
  -- $P------------------------------------

endmethod
-- End of method definition for .drwgList(STRING, ARRAY, ARRAY)

