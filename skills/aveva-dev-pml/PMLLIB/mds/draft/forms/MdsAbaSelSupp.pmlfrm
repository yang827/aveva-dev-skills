    --      !!abaNewDrwgs.areas.clear()
    --      !!abaNewDrwgs.init()

    -- Get all templates and areas
    !!abaNewDrwgs.init()
    --<wd>19mar2008 - DUN824 -- Changes as per Steve Wilson's email (18mar2008) for using the new ABA 12.0.sP2 appware version


    -------------------------------------------------------------------------
    -- 13June2002
    -- DM NOT WORKING because using DRTMP ref as STRING and ABA is using SHTML ref as string
    -- Code Below Changed to Pick up the SHTMPL Ref No and NOT the DRTMPL Ref No --
    -- ABA has to Reference the SHTMPL because a DRTMPL may own VARIANT Sheets as well

    --      !!abaNewDrwgs.dTypes.select('rtext',!this.templates.selection())
