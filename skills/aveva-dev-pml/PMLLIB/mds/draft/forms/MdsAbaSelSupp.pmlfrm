--
-- File: MdsAbaSelSupp.pmlfrm
--   Type: Form Definition
--   Group: MDS ABA Automatic support fabrication drawings
--     Keyword: ABA
--   Module: Draft
--
-- Author: Wayne Dodwell
-- Created: Friday 10th May 2002
--
--
-- Description:
-- Form Definition for Selecting Multiple supports for Detailing via MDS ABA
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  abaProcess()                     -
--  abaregi()                        -
--  all()                            -
--  apply(REAL)                      -
--  areas(ARRAY,STRING)              ARRAY
--  check(STRING,STRING,STRING)      BOOLEAN
--  clearformem()                    -
--  createabaobj()                   BOOLEAN
--  drwgList(STRING,ARRAY,ARRAY)     -
--  editmacfile(FILE,STRING)         -
--  enuDirections(MDSABADESDATA,ARRAY) ARRAY
--  expVolume(VOLUME,REAL)           VOLUME
--  filter()                         -
--  init()                           -
--  loadregistries(BOOLEAN,STRING)   -
--  loadtemplates(BOOLEAN,STRING)    -
--  mdsababatch()                    -
--  mdsabamacro()                    -
--  mdsabaselsupp()                  -
--  mdssupport()                     ARRAY
--  processtype()                    -
--  readscales(FILE,STRING)          ARRAY               Sets this object scaleList with defaults file list
--  run()                            -
--  selectall(STRING)                -
--  setce(GADGET,STRING)             -
--  setscale(REAL,DBREF)             REAL
--  updtabaforms(REAL)               -
--
------------------------------------------------------------------------
--<wd>20mar2008 - DUN824
-- *********************
-- ***IMPORTANT NOTE ***
-- *********************
-- This MDS ABA file incorporates the modifications supplied by Steve Wilson on 19mar2008.
-- These changes have been necessary to enable MDS12.0.sP2 to work correctly with ABA12.0.sP2
--<wd>20mar2008 - DUN824
------------------------------------------------------------------------

-- Kill existing form definition
kill !!mdsabaselsupp

-- Define Form
setup form  !!mdsabaselsupp

  !!mdsabaselsupp.formtitle = |Create MDS Drawing|
  !!mdsabaselsupp.icontitle = |MDS Select|
  !!mdsabaselsupp.callback  = |!this.init()|

  -- Body of Form
  path down
  vdist 0.5

  --<GE> 08/01/06
  bar
  !this.bar.add('Load Supports','Load')

  menu .load
  !this.load.add ('CALLBACK','CE & Below','!this.all()')
  !this.load.add ('CALLBACK','All in MDB','!this.all()')
  --<GE> 08/01/06

  -- List of Available MDS ABA Registries
  list .registry | Drawing Registry | at x1 y0.5 call |!this.abaregi()| single width 20 length 10
  button .regice | CE | at xmin ymax-0.3 call |!this.setce(!this.regice,'REGI')|

  -- Support Filter Gadget
  frame .ffilter | Selection Filter | at x0 ymax+0.3
    text .filter ||at xmin+0.5 ymax call |!this.filter()| width 35 scroll 256 is STRING
    para .dummyline at xmin ymax-0.8 text ||
  exit

  -- Select All Supports


  -- List of Available MDS Supports
  list .frame     | Frameworks            | at xmax.registry+1.0 y0.5  call |!this.abaProcess()| multiple width 20 length 10
  button .regiFrame | CE | at xmin ymax-0.3 call |!this.setce(!this.regiFrame,'FRAME')|
  path right
  --<kp>jan07  toggle .allFrame |All Frames| at xmax+0.5 ymin call |!!mdsabaselectall('FRAME')|
  toggle .allFrame |All Frames| at xmax+0.5 ymin call |!this.selectall('FRAME')|

  list .hanger    | Hangers               | at xmax_frame+0.5 ymin_frame   call |!this.abaProcess()| multiple width 20 length 10
  button .regiHanger | CE | at xmin ymax-0.3 call |!this.setce(!this.regiHanger,'HANGER')|
  --<kp>jan07  toggle .allHanger |All Hangers| at xmax+0.5 ymin call |!!mdsabaselectall('HANGER')|
  toggle .allHanger |All Hangers| at xmax+0.5 ymin call |!this.selectall('HANGER')|

  --<wd>feb2005
  list .ancill    | Ancillaries           | at xmax_hanger+0.5 ymin_hanger call |!this.abaProcess()| multiple width 20 length 10
  button .regiAncill | CE | at xmin ymax-0.3 call |!this.setce(!this.regiAncill,'ANCILL')|
  path right
  --<kp>jan07  toggle .allAncill |All Ancillaries| at xmax+0.5 ymin call |!!mdsabaselectall('ANCILL')|
  toggle .allAncill |All Ancillaries| at xmax+0.5 ymin call |!this.selectall('ANCILL')|
  --<wd>feb2005

  --<kp>jan07
  list .light     ' Lighting Supports' at xmax.ancill+0.5 ymin.ancill call '!this.abaProcess()' multiple width 20 length 10
  button .regiLight ' CE ' at xmin ymax-0.3 call '!this.setce(!this.regiLight,''LIGHT'')'
  path right
  toggle .alllight 'All Light.supports' at xmax+0.5 ymin call '!this.selectall(''LIGHT'')'

  --<kp>jan07


  --list .trunnion  | Trunnions |   call |!this.abaProcess()| multiple width 20 length 10

  -- List of Available MDS ABA templates
  frame .fftemplates | Template | at xmax.ffilter+0.5 ymax+0.45
    --para .fftemplates at xmin+0.5 ymax.regiHanger+0.1 text | ABA Template|
    option .templates || at xmin+0.5 ymax width 38
  exit

  --<maw/dts>aug2008 - DUN975
  frame .update |Drawing Option| at xmax.templates+1.5 ymax-3
    --<wd>02oct2008 -- Added call backs to both gadgets
    rtoggle .updateDrwg |Update| call |!this.processtype()|
    rtoggle .regenerateDrwg |Regenerate| call |!this.processtype()|
  exit
  -- Detailing toggle
  toggle .detail at xmax-26.75 ymax.templates-0.25 |Detail Sheets|

  -- frame .fhtemplates | MDS Hanger Template | at x0 ymax+0.2
  -- para .hftemplates at xmin.hanger ymax.hanger-0.3 text 'Hanger Template'
  -- option .htemplates || at xmin.hanger ymax.hftemplates  width 25
  -- exit

  -- Detailing toggle
  --  toggle .detail at xmax+1 ymin.templates |Detail Sheets|

  -- bottom line
  button .ok     | Apply |   at x0 ymax.ffilter+0.25  call |!this.apply(1)|
  --  button .cancel | Dismiss | at xmax form-size ymin.ok cancel
  button .cancel | Dismiss | at xmax.light-11 ymin.ok cancel
  path right
  button .existingDrwgs |Existing Drawings...| at xmin.frame ymin.ok call |!tmp = ARRAY() !!abaProcess.browse(!tmp,'')|
  button .logFiles      |Stored LogFiles...|   at xmin.hanger ymin.ok call |!!abatemplate('FILES','PROCESS')|

  -------------------------------------------------

  -- Form members
  member .mdssupports is ARRAY
  member .newdrwgs is ARRAY
  member .olddrwgs is ARRAY
  member .areas    is ARRAY
  member .template is DBREF
  -- member .htemplate is DBREF
  member .logfile  is FILE
  member .macfile  is FILE
  member .batfile  is FILE
  member .allSupports is ARRAY
  -- members to store update data for labels and dimensions
  member .originalLabels     is ARRAY
  member .userLabels         is ARRAY
  member .movedLabels        is ARRAY
  member .originalDimensions is ARRAY
  member .movedDimensions    is ARRAY
  member .tagLayers          is ARRAY
  member .dimLayers          is ARRAY

  --<wd>jan2005
  -- Added OBJECT members for use with MDS "GROUPS"
  -- (1) - .mainGroupMem is for the "MAIN" Group MEMBERS i.e.
  -- STRU <i.e. [1]> and Additional RESTRAINTS <i.e. [2], [3], [4] etc...>
  --    member .mainGroupMem     is ARRAY
  -- (2) - .allGroupMem is for "ALL" of the Support Members as collected via the function "mdsabasupportmem.pmlfnc"
  -- for each "MAIN" member of the MDS GROUP found in OBJECT member .mainGroupMem
  --    member .allGroupMem      is ARRAY
  --<wd>jan2005

exit

-- End of form definition for !!mdsabaselsupp
---------------------------------------------------------------------------------------------------------

