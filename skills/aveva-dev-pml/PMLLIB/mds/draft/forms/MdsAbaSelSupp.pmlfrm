---------------------------------------------------------------------------------------------------------
--
-- ==========================
-- Methods are Defined below:
-- ==========================
--
---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
--
---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------
--
-- Method:      mdsAbaSelSupp
--
-- Description: Constructor
-- Method Type: Function/Procedure
-- Author: Martin Ward/David Sewell
-- Date Method Created: August 2008

-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsabaselsupp()

  --<wd>08oct2008 - DUN975 - Add code to Check if PDMS11.6 or PDMS11.5 software
  if (!!isPdms116()) then
    -- Current Software is PDMS11.6
    !this.regenerateDrwg.val = FALSE
    !this.updateDrwg.val = TRUE
  else
    -- Current Software is PDMS11.5
    !this.drwgOption.select('UPDATE')
  endif
  --<wd>08oct2008 - DUN975 - Add code to Check if PDMS11.6 or PDMS11.5 software

endmethod
---------------------------------------------------------------------------------------------------------
define method .all()

  --<GE> 08/01/06
  -- Check too see that you are in a Design DB
  if !this.load.pickedfield.eq('CE & Below') then
    !dbtype = DBtype
    if !dbtype.eq('PADD')then
      !!alert.message('Please switch to a Design Database to Load Supports')
    endif
  endif
  --<GE> 08/01/06

  -- Set the Current Element
  !origin = !!ce

  -- Initialise ABA form 'abaprocess' to empty the 'New' and 'Old' Drawing Gadgets
  !!abaProcess.init('NOSHOW')

  -----------------------------------------------------------------------------------------------
  --<wd>feb2007<mds12>
  -- Load the MDS DESIGN & DRAFT OPTION Values and the form
  !!mdsoptiondefs = object MDSOPTIONDEFS()
  --<wd>feb2007<mds12>
  -----------------------------------------------------------------------------------------------

  -- Setup the supports default object contents
  !!mdsabasupdefs()

  --<kp>jan07
  -- Setup lighting support default object
  !!mdslsuppdefs()


  -- Clear Support list gadget and members
  -- !this.supports.clear()
  !this.frame.clear()
  !this.hanger.clear()
  !this.clearformem()
  --<wd>feb2005
  !this.ancill.clear()
  --<wd>feb2005

  --<kp>jan07
  !this.light.clear()
  --<kp>jan07

  -- ************************************************************************************************
  --<wd>feb2007<mds12>
  -- ************************************************************************************************
  ---------------------------------------------------------------------------------------------------
  --
  -- The IDENTIFICATION of what is a "MDS SUPPORT STRUCTURE", "PIPING", "HVAC" or "TRAY" zone
  -- for MDS12 is now controlled by the settings found in the PARAGON Catalogue Database
  -- CATA element /MDS/ZONEID/DEFAULTS
  -- This CATA element stores the MDS APPLICATION ZONE ID DEFAULTS "DATASET DATA" elements
  -- These zones MUST exist within the DESIGN database to enter the MDS Application
  --
  -- Determine the MDS ZONE ID Attributes and Values from the CATA element /MDS/ZONEID/DEFAULTS
  !mdszoneids  = object MDSZONEIDDEFS()
  -- ABORT access to the MDS ABA Drawing and issue an ERROR to the USER
  -- when the returned variable !mdszoneids.zoneidcheck is FALSE
  if (!mdszoneids.zoneidcheck.not()) then
    !!alert.error(|ABORTING access to the MDS ABA Drawing Creation Form. All/Some of the MDS ZONE ID default DATA elements DO NOT exist.|)
    return
  endif

  -- ************************************************************************************************
  --<wd>feb2007<mds12>
  -- ************************************************************************************************

  -----------------------------------------------------------------------------------------------
  --<wd>nov2003
  -----------------------------------------------------------------------------------------------
  --
  --<wd>feb2007<mds12>
  -- Load the MDS12 FIXED and VARIABLE Hanger Type Configurations from the NEW PARAGON MDS DEFAULTS
  -- DATABASE, where the NEW MDS12 DEFAULTS DATASETS are defined in the CATALOGUE /MDS/HANGER/DEFAULTS
  --
  ------------------------------------------------
  -- -- Load the MDS FIXED and VARIABLE Hanger Type Configurations via the "DES-SUPP-HANG" default file
  -- -- location stored in the "!!mdsFILES.hangersconfigurations" object member
  --
  --<wd>feb2007<mds12>
  --
  if(not defined(!!mdsallhangertypes)) then
    !!mdsallhangertypes = object MDSHANGERTYPES(true)
  endif
  -----------------------------------------------------------------------------------------------
  --<wd>nov2003
  -----------------------------------------------------------------------------------------------

  -- Process the MDS ABA Drawings by the DM Process or the Interactive User Application
  -- Only Get the MDS Supports from the Database if NOT Creating MDS ABA drawings via the DM process

  if (undefined(!!mdsAbaDpcVar)) then
    -- MDS ABA Drawings are being Processed by the Interactive PDMS MDS ABA User Application

    -- Collect all support frameworks from the design databases
    -->><wd>aug2002
    --var !support eval (NAME) for all STRU with (PURP OF ZONE eq 'SUPP')
    -- The attribute settings may be a range separated by a comma i.e. ','
    !support = ARRAY()
    !sval = !!mdsidsval.split(',')
    do !addsupports values !sval
      --<GE> 08/01/06
      if !this.load.pickedfield.eq('CE & Below') then
        --<GE> 22/03/07 GE Removed restriction for collecting only the DATUM atta and added the ability for the collection
        -- to collect other atta's that may be part of the support
        -- var !supportname append eval (NAME) for all ATTA wi ((match(PURP OF SPEC OF SPREF,'MDS') eq 1)) $
        -- and (match(NAME,'/DATUM') neq 0) for ce
        Var !supportname append eval (NAME) for all ATTA wi ((match(PURP OF SPEC OF SPREF,'MDS') eq 1)) for ce
        do !split values !supportname
          !splitname = !split.split('/DATUM')
          !splitsref = !split.split('/SREF')
          !splitdot = !split.split('.')
          if (defined(!splitname[3])) and !splitname[3].match('DATUM').gt(0) then
            -- $p splitname
            !suppd = '/' & !splitname[2]
          elseif (defined(!splitdot[2])) then
            !suppd = !splitdot[1]
          elseif (defined(!splitsref[3])) and !splitsref[3].match('SREF').gt(0) then
            !suppd = '/' & !splitsref[2]
          endif
          --<GE> 22/03/07
          skip if (!suppd.dbref().type.neq('STRU'))
          handle ANY
            skip
          endhandle
          !support.append(!suppd)
        enddo
      elseif !this.load.pickedfield.eq('All in MDB') then
        var !support append eval (name) for all stru with ($!!mdsidsatt of zone eq '$!addsupports')
      endif

      if !this.load.pickedfield.eq('CE & Below') then
        var !support append eval (name) for all stru with ($!!mdsidsatt of zone eq '$!addsupports') for ce
      endif
      --<GE> 26/03/07 Added the ability to select any hanger elements and then detail the hanger
      if !this.load.pickedfield.eq('CE & Below') then
        if !!ce.owner.type.eq('HANG') and !!ce.type.neq('WORL') then
          $!!ce.owner
          !name = !!ce.name
          !splithang = !name.split('/H')
          !suppd = '/' & !splithang[2]
          !support.append(!suppd)
        elseif !!ce.type.eq('HANG') then
          !name = !!ce.name
          !splithang = !name.split('/H')
          !suppd = '/' & !splithang[2]
          !support.append(!suppd)
        elseif !!ce.type.eq('REST') then
          !name = !!ce.name
          !splithang = !name.split('/REST')
          !suppd = '/' & !splithang[2]
          !support.append(!suppd)
        endif
      endif
      --<GE> 26/03/07
    enddo
    --<<<wd>aug2002

    -- Collect all support attachments from design database
    if !this.load.pickedfield.eq('CE & Below') then
      var !support append eval (NAME) for all ATTA $
      wi ((match(PURP OF SPEC OF SPREF,'MDS') neq 0) $
      and (match(NAME,'/DATUM') eq 0) $
      and (match(NAME,'/SREF') eq 0)) for ce
    elseif !this.load.pickedfield.eq('All in MDB') then
      var !support append eval (NAME) for all ATTA $
      wi ((match(PURP OF SPEC OF SPREF,'MDS') neq 0) $
      and (match(NAME,'/DATUM') eq 0) $
      and (match(NAME,'/SREF') eq 0))
    endif
    --<GE> 08/01/06

    -- Sort collected supports
    var !order sort unique !support
    !supports  = ARRAY()
    !fsupports = ARRAY()
    !hsupports = ARRAY()
    --<wd>feb2005
    !asupports = ARRAY()
    --<wd>feb2005
    -- !tsupports = ARRAY()

    --<kp>jan07 Lighting supports added
    !lsupports = ARRAY()
    --<kp>jan07


    -- The filter is unset so set it to *
    if !this.filter.val.eq('') then
      !this.filter.val = '*'
    endif

    do !i index !order
      !index = !order[!i]
      !name = !support[$!index].dbref().flnm
      -- Remove supports/ATTAS with a suffix of '.1 to .99' or '/MAKEUP' or '/NOTE1 , /NOTE2 , /NOTE3, /NOTE4' in there name
      -- Skip unnamed elements
      skip if (!support[$!index].dbref().name.match('=')eq(1))
      --<GE> 26/03/07 Added the ability too select a dot atta and then detail the support
      -- !name = !support[$!index].dbref().flnm

      --<wd>25nov2008 - DUN979 - The skip line below has been uncommented to avoid getting the *.1, *.2 names appearing
      -- in the FORM list gadget for Framework type supports when selecting the "Load Supports>All in MDB" from the menu
      -- skip if (!name.match('.').gt(0))
      skip if (!name.match('.').gt(0))
      --<wd>25nov2008

      --<GE> 26/03/07
      skip if (!name.match('/MAKEUP').gt(0))
      skip if (!name.match('/NOTE1').gt(0))
      skip if (!name.match('/NOTE2').gt(0))
      skip if (!name.match('/NOTE3').gt(0))
      skip if (!name.match('/NOTE4').gt(0))

      -----------------
      -->>wd<29jul2002>
      -- Check for Support Type etc... before 'skipping...'
      --skip if (!name.dbref().mcount().eq(0))
      if (!name.dbref().type.eq('ATTA')) then
        -------------------------------------------------
        --<wd>feb2005 --
        -- "Stand-Alone" MDS Ancillaries <ATTAS> may now be DRAWN via the MDS-ABA Drawing Utility
        -- Therefore the PML CODE below has been "COMMENTED-OUT" so as NOT to EXCLUDE "Stand-Alone" MDS Ancillaries <ATTAS>
        -- The PML function "!!mdsabatype(!name.dbref())" used below CHECKS the VALIDITY of the ATTA with regard to MDS.
        -- SEE the --****** IMPORTANT NOTE ******-- and PML CODE below at APPROX. line 320


        --<wd>feb2005 --
        -------------------------------------------------

      elseif (!name.dbref().type.eq('STRU')) then
        !sdatum = !name & '/DATUM'
        !!ce    = !sdatum.dbref()
        handle(2,109)
          -- Undefined Name, e.g. DATUM Atta for STRU does NOT EXIST
          --<kp>jan07
          --It could be lighting support
          if !name.dbref().:MdsSuppType.neq(!!mdslsuppdefs.type) then
            skip
          endif
          --<kp>jan07
        endhandle

      else
        skip if (!name.dbref().mcount().eq(0))

      endif
      --<<wd<29jul2002>
      -----------------

      -- skip if (!name.dbref().:mdssupptype.eq('unset'))
      -- skip if (!name.dbref().:mdssupptype.eq(''))
      if !name.dbref().:mdssupptype.empty().or(!name.dbref().:mdssupptype.eq('unset')) then
        if !name.dbref().type.eq('ATTA') then
          skip if !name.dbref().dassci.unset()
        else
          skip
        endif
      endif

      !match = '*$!this.filter.val*'
      if (!name.matchwild(!match).not()) then
        skip
      endif

      -- Setup sorted ARRAY
      --<GE> 26/03/07 Added the ability too select a dot atta and then detail the support
      if !this.load.pickedfield.eq('CE & Below') then
        if (!support[$!index].match('.').gt(0)) then
          !splitdot = !support[$!index].split('.')
          !support[$!index] = !splitdot[1]
        endif
      endif
      --<GE> 26/03/07
      !supports.append(subs('$!support[$!index]',2))

      -------------------------------------------------
      --<wd>feb2005 --****** IMPORTANT NOTE ******--
      -- The PML function "!!mdsabatype(!name.dbref())" used below contains code to CHECK if the ATTA, STRU or HANGER
      -- is a VALID MDS SUPPORT type. The function returns the text "ERROR" if it is NOTHING to do with MDS and so the ATTA
      -- DOES NOT get appended to any of the MDS SUPPORT ARRAYs shown below.
      --<wd>feb2005
      -------------------------------------------------
      -- Find out the type of support passed
      !typeofsupport = !!mdsabatype(!name.dbref())
      if !typeofsupport.eq('FRAME') then
        !fsupports.append(subs('$!support[$!index]',2))

      elseif !typeofsupport.eq('HANGER') then
        -- If a hanger is part of a group then do not put it in the list -- NOT DONE HERE but see line 306 approx. below
        !hsupports.append(subs('$!support[$!index]',2))

        --<wd>feb2005
      elseif !typeofsupport.eq('ANCILL') then
        !spref = !support[$!index].dbref().spref.name
        if !spref.match('/MDP/').neq(1) then
          !asupports.append(subs('$!support[$!index]',2))
        endif
        --<wd>feb2005


        --<kp>jan07
        -- Lighting supports
      elseif !typeofsupport.eq('LSUPP') then
        !lsupports.append(subs('$!support[$!index]',2))
        --<kp>jan07
      endif
    enddo

    -- Load the '.supports' list gadget and the form member '.allSupports'
    -- !this.supports.dtext = !supports
    -- !this.supports.rtext = !supports
    -- !this.allSupports    = !supports

    -- Load the types of support list
    -- If a hanger is part of a group then remove it from the hanger list
    do !removehangers from 1 to !hsupports.size()
      if !hsupports[$!removehangers].match('[').gt(0) and !hsupports[$!removehangers].match(']').gt(0) then
        !hsupports[$!removehangers].delete()
      endif
    enddo
    !hsupports.compress()

    -- If a framework is part of a group then remove the [?] from the display text
    !framedisplaytext = !fsupports
    do !removebrackets from 1 to !framedisplaytext.size()
      if !framedisplaytext[$!removebrackets].match('[').gt(0) and !framedisplaytext[$!removebrackets].match(']').gt(0) then
        --!framedisplaytext[$!removebrackets] = !framedisplaytext[$!removebrackets].before('[') + ' (Group)'
        -- Remove
        !framedisplaytext[$!removebrackets] = !framedisplaytext[$!removebrackets].before('[')
      endif
    enddo

    --<GE> 27/03/07 Added the ability to select any hanger elements etc of the group and detail the group support
    if !this.load.pickedfield.eq('CE & Below') then
      do !removesupport from 1 to !supports.size()
        if !supports[$!removesupport].match('[').gt(0) and !supports[$!removesupport].match(']').gt(0) then
          !framedisplaytext[$!removesupport] = !supports[$!removesupport].before('[')
          !fsupports = !supports
        endif
      enddo
      !framedisplaytext.sortunique()
    endif
    --<GE> 27/03/07

    !this.frame.dtext  = !framedisplaytext
    !this.frame.rtext  = !fsupports
    handle any
    endhandle
    !this.hanger.dtext = !hsupports
    !this.hanger.rtext = !hsupports

    --<wd>feb2005
    !this.ancill.dtext = !asupports
    !this.ancill.rtext = !asupports
    --<wd>feb2005

    --<kp>jan07
    !this.light.dtext = !lsupports
    --<kp>jan07

    -- !this.trunnion.dtext = !tsupports
    -- !this.trunnion.rtext = !tsupports

    !this.allSupports = !fsupports
    !this.allSupports.appendarray(!hsupports)
    --<wd>feb2005
    !this.allSupports.appendarray(!asupports)
    --<wd>feb2005

    -- Set selection gadget and clear list
    --!this.selectall.val = false
    --!!mdsabaselectall('UNSELECT')

    --<wd>21feb2008 - DUN824 -- Defect No. P-4405
    -- Missing 'else', 'endif' and the explanation added here as per previous versions
    -- before mods by --<GE> 08/01/06
  else
    -- The MDS ABA DM Process Variable '!!mdsAbaDpcVar' is Defined and set to TRUE
    -- Drawings being Processed by DM ("Delivery Manager" was called "Drawing Production Control")
    -- Therefore let the PML function '!!mdsabadpcprocess.pmlfnc'
    -- load the form gadgets on this FORM.
  endif
  --<wd>21feb2008 - DUN824 -- Defect No. P-4405

  --<GE> 08/01/06
  -- Return to the Original Element
  !!ce = !origin

endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .init()

  -- The filter is unset so set it to *
  if !this.filter.val.eq('') then
    !this.filter.val = '*'
  endif

  -- Set the Current Element
  !origin = !!ce
  --<GE> 08/01/06

  -- Load MDS ABA Drawing Templates
  !xtmpl = false
  !error = ''
  !this.loadtemplates(!xtmpl,!error)
  if (!xtmpl.not()) then
    !!alert.warning('$!<error>')
  endif

  -- Load MDS ABA Drawing Registries
  !xregi = false
  !error = ''
  !this.loadregistries(!xregi,!error)
  if (!this.registry.dtext.empty() and !xregi.not()) then
    !!alert.warning('$!<error>')
  endif

  -- Deactivate the '.apply' gadget as required
  if (!xtmpl and !xregi) then
    !this.ok.active = true
  else
    !this.ok.active = false
  endif

  --<GE> 08/01/06
  --    else
  --<GE> 08/01/06
  -- The MDS ABA DM Process Variable '!!mdsAbaDpcVar' is Defined and set to TRUE
  -- Drawings being Processed by DM ("Delivery Manager" was called "Drawing Production Control")
  -- Therefore let the PML function '!!mdsabadpcprocess.pmlfnc'
  -- load the form gadgets on this FORM.
  --<GE> 08/01/06
  --    endif
  --<GE> 08/01/06

  -- Set detailing flag to off
  !this.detail.val = false

  -- Set counters
  !this.abaProcess()

  -- Return to the Original Element
  !!ce = !origin

endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .filter()

  !this.filter.val = !this.filter.val.trim()

  if !!alert.confirm('Are you sure you want to filter the available supports with ' + !this.filter.val + '?').eq('YES') then
    --<GE> 08/01/06
    -- !this.init()
    !this.all()
    --<GE> 08/01/06
  endif

  return

  -- Check the Filter Expression is valid before Proceeding
  !runtime = !this.filter.val
  if (!runtime.trim().neq(||)) then
    !this.filter.val = !this.filter.val.replace('|','''')
    !empty[1] = ' '
    !empty[1].delete()
    var !test coll all with ($!runtime) from !empty
    handle any
      !syntax = !!error.command.after('with ').before(' from').trim()
      !!alert.error(|The Filter Expression is Incorrect:
      *** $!!error.text
      $!syntax ***|)
      return
    endhandle
  endif

  -----------To Do ------------------- To Do -------------------- To Do -------------->>>>>>>>>>>>>>>>>>
  -----------To Do ------------------- To Do -------------------- To Do -------------->>>>>>>>>>>>>>>>>>
  -----------To Do ------------------- To Do -------------------- To Do -------------->>>>>>>>>>>>>>>>>>
  -----------To Do ------------------- To Do -------------------- To Do -------------->>>>>>>>>>>>>>>>>>

  -- Filter Expression is Valid, therefore Re-Populate Support list gadgets '.fsupports' and '.hsupports' accordingly
  -- ALL SUPPORTS stored under the member '.allSupports' on initialisation of this FORM

  -- Evaluate the Filter Expression against the list stored in the member '.allSupports'
  -- of the Available MDS Supports in the current MDB at initialisation of the form

  -- Then RESET the DTEXT and RTEXT of the '.fsupports'  and '.hsupports' list gadget with the list of supports found in the
  -- EVALUATION (FILTER) expression

  -----------To Do ------------------- To Do -------------------- To Do --------------<<<<<<<<<<<<<<<<<
  -----------To Do ------------------- To Do -------------------- To Do --------------<<<<<<<<<<<<<<<<<
  -----------To Do ------------------- To Do -------------------- To Do --------------<<<<<<<<<<<<<<<<<
  -----------To Do ------------------- To Do -------------------- To Do --------------<<<<<<<<<<<<<<<<<

endmethod

