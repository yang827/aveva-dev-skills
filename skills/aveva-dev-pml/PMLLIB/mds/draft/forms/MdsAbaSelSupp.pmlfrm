-------------------------------------------------------------------------------------------------------
--<nb>sep2007 HPD0036269 (Only create objects for submitted drawings)
--<nb>oct2008 HPD0036269 (Only create objects for existing drawings)
----------------------------------------------------------------------
define method .createabaobj() is BOOLEAN
  ----------------------------------------------------------------------
  do !drawing values !this.olddrwgs
    var !sheets collect all sheets for $!drawing
    do !sheet values !sheets
      !drawingObj = object ABADRAWING( !sheet.dbref() )
      !!abaOldDrwgs.drawinglist.append(!drawingObj)
    enddo
  enddo
  --
  !!abaOldDrwgs.display()
  --
endmethod
