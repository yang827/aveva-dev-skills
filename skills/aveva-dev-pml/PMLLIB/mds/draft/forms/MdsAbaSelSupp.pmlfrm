define method .expVolume(!volume is VOLUME,!dist is REAL) is VOLUME

  -- Expand the VOLUME by !dist in every Direction on the FROM and TO members on the existing VOLUME values
  -- FROM member
  if (!volume.from.north.string().match('-').eq(1)) then
    !volume.from.north = !volume.from.north - $!dist
  else
    !volume.from.north = !volume.from.north - $!dist
  endif

  if (!volume.from.east.string().match('-').eq(1)) then
    !volume.from.east = !volume.from.east - $!dist
  else
    !volume.from.east = !volume.from.east - $!dist
  endif
  if (!volume.from.up.string().match('-').eq(1)) then
    !volume.from.up = !volume.from.up - $!dist
  else
    !volume.from.up = !volume.from.up - $!dist
  endif

  -- TO member
  if (!volume.to.north.string().match('-').eq(1)) then
    !volume.to.north = !volume.to.north + $!dist
  else
    !volume.to.north = !volume.to.north + $!dist
  endif
  if (!volume.to.east.string().match('-').eq(1)) then
    !volume.to.east = !volume.to.east + $!dist
  else
    !volume.to.east = !volume.to.east + $!dist
  endif
  if (!volume.to.up.string().match('-').eq(1)) then
    !volume.to.up = !volume.to.up + $!dist
  else
    !volume.to.up = !volume.to.up + $!dist
  endif

  -- Return the Volume Object
  return !volume

endmethod

