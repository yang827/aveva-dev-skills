    -- q var !!abaNewDrwgs.allShTmpl[!!abaNewDrwgs.drTmplControl.getSelectedRowTags()[1].real()]

    -- Get all AREA DBREFS
    do !indx indices !this.areas.unique()
      --        !areasRText[!indx] = !this.areas[!indx].refe.string()
      !allAreas[!indx] = !this.areas[!indx].refe
      --<wd>19mar2008 - DUN824 -- Changes as per Steve Wilson's email (18mar2008) for using the new ABA 12.0.sP2 appware version
    enddo

    -- -- $P -- AREASTEXT --
    -- -- q var !areasRText

    -- q var !allAreas

    if (!this.newdrwgs.empty().not()) then

      --<wd>19mar2008 - DUN824 -- Changes as per Steve Wilson's email (18mar2008) for using the new ABA 12.0.sP2 appware version
      --        !!abaNewDrwgs.areas.select('rtext',!areasRText)
      --          handle (61,578)
      ----<GE> 15/12/06 Added handle
      --          endhandle
      ---- Update the Process form Gadget with New MDS ABA Drawings 'abaprocess'
      --        !!abaNewDrwgs.addSelection('APPEND')

      -- Populate the AB ADP Process form with the new drawings
      !!abaNewDrwgs.mds(!tmpseldbref, !allAreas)
      --<wd>19mar2008 - DUN824 -- Changes as per Steve Wilson's email (18mar2008) for using the new ABA 12.0.sP2 appware version

    endif
  endif

  -- Update the Existing MDS ABA Drawings form 'abaolddrg'
  if (!this.olddrwgs.empty().not()) then

    --<wd>19mar2008 - DUN824 -- Changes as per Steve Wilson's email (18mar2008) for using the new ABA 12.0.sP2 appware version
    --      !!abaOldDrwgs.drawings.clear()
    --      !!abaOldDrwgs.init()
    --      !xdrawings = ARRAY()

    -- Get all existing sheets
    if (defined(!!mdsAbaDpcVar)) then
      !this.createabaobj()
    else
      !!abaOldDrwgs.init ()
    endif
    --<wd>19mar2008 - DUN824 -- Changes as per Steve Wilson's email (18mar2008) for using the new ABA 12.0.sP2 appware version


    --<wd>19mar2008 - DUN824 -- Changes as per Steve Wilson's email (18mar2008) for using the new ABA 12.0.sP2 appware version
    --      do !indx indices !this.olddrwgs
    --        !name = !this.olddrwgs[!indx].trim()
    --
    ----<wd>04jul2006>>>
    ---- PDMS ABA 11.5<AB_ADP11.4.sP1> version is OK as is, so the change to !name below will not be DONE
    ----
    ---- At Version ABA 11.6 the PDMS name prefix slash '/' has been removed from the "DTEXT" values
    ---- stored in the ABA 11.6 FORM gadget !!abaOldDrwgs.drawings.dtext.
    ---- Therefore it has to be removed for the "do" loop test below to work correctly,
    ---- i.e. *** skip if (!xdrwg[1].trim().neq(!name)) ***
    ----
    ---- Check and Change !name for PDMS ABA 11.6 version ONLY -- REMOVE the PDMS name prefix '/' --
    --        if (!!isPdms116()) then
    --          if (!name.match(|/|).eq(1)) then
    --            !name = !name.substring(2)
    --          endif
    --        endif
    ----<wd>04jul2006<<<
    --
    --        do !val indices !!abaOldDrwgs.drawings.dtext
    --          !xdrwg = !!abaOldDrwgs.drawings.dtext[!val].split()
    ----q var !xdrwg[1].trim() !name $* These STRINGS should be identical
    --          skip if (!xdrwg[1].trim().neq(!name))
    --          if (defined(!xdrawings)) then
    --            !find = !xdrawings.find(!!abaOldDrwgs.drawings.dtext[!val])
    --            skip if !find.size().gt(0)
    --          endif
    --          --!xdrawings[!indx] = !!abaOldDrwgs.drawings.dtext[!val]
    --          !xdrawings.append(!!abaOldDrwgs.drawings.dtext[!val])
    --          break
    --        enddo
    --      enddo
    --
    --      if (!this.olddrwgs.empty().not()) then
    --        !!abaOldDrwgs.drawings.select('dtext',!xdrawings)
    ---- Update the Process form Gadget with the Existing MDS ABA Drawings 'abaprocess'
    --        !!abaOldDrwgs.processlist()
    --      endif
    --    endif
    --<wd>19mar2008 - DUN824 -- Changes as per Steve Wilson's email (18mar2008) for using the new ABA 12.0.sP2 appware version


    --<wd>19mar2008 - DUN824 -- Changes as per Steve Wilson's email (18mar2008) for using the new ABA 12.0.sP2 appware version
    -- Get all existing SHEET DBREFS
    !extractdbref    = object BLOCK('!this.olddrwgs[!evalindex].dbref()')
    !unusedallsheets = !this.olddrwgs.evaluate(!extractdbref)

    -- Populate the AB ADP Process form with the existing sheets
    if (!this.olddrwgs.empty().not()) then

      -- $P --------- .updtabaforms ----------------
      -- q var !this.olddrwgs
      -- $P ----------------------------------------

      !!abaOldDrwgs.mds(!this.olddrwgs)
    endif
  endif
  --<wd>19mar2008 - DUN824 -- Changes as per Steve Wilson's email (18mar2008) for using the new ABA 12.0.sP2 appware version

  -- Set the ABA form 'abaprocess' - Process Type Gadget .update
  !!abaProcess.update.select('rtext',!this.process.selection())
  handle any
  endhandle

endmethod

