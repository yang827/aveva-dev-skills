define method .editmacfile(!macro is FILE, !runtype is STRING)

  -- Get the MDB Name
  !sess = current session
  !mdb  = !sess.mdb().name

  -- Set an ARRAY to the Macro File contents
  !read = !macro.readfile()

  --<wd>20mar2008 -- Temporary Global Variables for TESTING only
  !!macro = !macro
  !!read  = !read
  --<wd>20mar2008

  -- Create PDMSABABATCH Log File
  !abaRunPrefix = !macro.fullname().before('.mac')
  !abaRunLognam = !abaRunPrefix & '.log'

  ------------------------------------------------------------
  -- Run MDS ABA Drawings in the Current Session - IMMEDIATELY
  ------------------------------------------------------------
  if (!runtype.eq('macro')) then
    -- Edit the Macro to DELETE a few lines and ADD the EXTRA MDS ABA Requirements MACRO/FUNCTION
    -- q var !macro

    -- Only Open an alpha log in the Macro if Drawings produced by Interactive User in the MDS ABA Application
    -- If using DM an alpha log is already running, so this alpha log syntax is not required in the MDS ABA macro
    if (undefined(!!mdsAbaDpcVar)) then
      !read.insert(1,'alpha log "$!<abaRunLognam>"')
    else
      -- Need to add it for Testing from within DRAFT - REMOVE(i.e. Comment Out the line below) if running true DM Process
      --  !read.insert(1,'alpha log /$!<abaRunLognam>')
      -- Need to add it for Testing from within DRAFT - REMOVE(i.e. Comment Out the line below) if running true DM Process
    endif

    !find = !read.find(!mdb)
    !read[!find[1]] = ''

    --      !find = !read.find('!!batchMode = TRUE')
    --      !read[!find[1]] = ''
    --      !read[!find[1] + 1] = ''
    --      !read[!find[1] + 2] = ''


    --------------------------------------------
    --<wd>03mar2008 - DUN824 - Defect No. P-4405
    -- Determine the current Module, is it 'Draft' or 'OutfittingDraft'
    --
    --      !find = !read.find('Draft')
    !bann  = banner
    !bName = !bann.name.upcase()
    --q var !bName
    --><wd>26feb2009 - DFN P-15723 (SI-7236)
    -- Cater for the NON ENGLISH versions of the AVEVA PDMS and the AVEVA MARINE 'DRAFT' modules by using the method '.matchwild'
    --      if (!bName.match('AVEVA PDMS DRAFT').gt(0)) then
    if (!bName.matchwild('AVEVA PDMS*DRAFT*')) then
      -- AVEVA PLANT is being used
      !find = !read.find('Draft')
      !read[!find[1]] = ''
      --      elseif (!bName.match('AVEVA MARINE OUTFITTINGDRAFT').gt(0)) then
    elseif (!bName.matchwild('AVEVA MARINE*OUTFITTINGDRAFT*')) then
      -- AVEVA MARINE is being used
      !find = !read.find('OutfittingDraft')
      !read[!find[1]] = ''
    endif
    --><wd>26feb2009 - DFN P-15723 (SI-7236
    --<wd>03mar2008 - DUN824 - Defect No. P-4405
    --------------------------------------------

    -- Determine the current COORD system, XYZ or ENU????      !read[!find[1]] = ''
    !find = !read.find('savework')
    !read[!find[1]] = ''
    !find = !read.find('finish')
    !read[!find[1]] = ''

    --      !read[!find[1] - 2] = 'alpha log end'
    -->><wd>aug2002
    -- Message NOT required if DM is being used, as DM send its own message
    if (undefined(!!mdsAbaDpcVar)) then
      --<wd>17mar2008 - DUN824 - Defect No. P-4405 -- net send file etc... no longer available in WINDOWS XP???
      --        !read[!find[1] - 1] = 'syscom ''net send $!!computer Your MDS ABA Drawings have finished'' '
      !read[!find[1] - 1] = 'syscom ''echo ........... Message for $!!computer ... Your MDS ABA Drawings have finished'' '
      --<wd>17mar2008 - DUN824 - Defect No. P-4405 -- net send file etc... no longer available in WINDOWS XP???

      !read.append('!saveTemp = !!tmpfile')
      !read.append('!!batchMode = false')
      !read.append(|!!tmpfile = '$!abaRunLognam'|)
      !read.append('!!abaLogging.alphaEnd()')
      !read.append('!!batchMode = true')
      !read.append('!!tmpfile = !saveTemp')
    endif
    --<<<wd>aug2002

    -- Ensure(i.e. HARD CODE) the ABA Process Type is ALWAYS set to 'FRegenerate' for ALL the MDS ABA Drawings
    -- i.e. Create New Drawing and/or Delete Existing Drawing and Create a New one
    -------------------------------------------------
    -- DTS aug2008 - DUN975
    -- Lines below in this method modified/added to allow a MDS drawing to be UPDATED or REGENERATED
    -- Start

    !index = 0
    do !val values !read
      !index = !index + 1
      --<wd>02oct2008 - DUN975 -- Ensure the test !val Text matches with the line in the ABA macro file
      --        skip if (!val.match('!newdrg = object ABADRAWING').eq(0))
      skip if (!val.lowcase().match('!newdrg = object abadrawing').eq(0))
      !valB = !val.before(',|')
      if (!this.updateDrwg.val) then
        !valA = ',|FUpdate|)'
      else
        !valA = ',|FRegenerate|)'
      endif
      !read[!index] = !valB & !valA
    enddo

    !insertBefore = ARRAY()
    !suppnames = ARRAY()
    !linenumber = 0

    do !val values !read
      !linenumber = !linenumber + 1
      --        !nextLine = !linenumber + 1

      --<wd>02oct2008 - DUN975 -- Ensure the test !val Text matches with the line in the ABA macro file
      --        if (!val.match('!newdrg = object ABADRAWING').gt(0)) then
      if (!val.lowcase().match('!newdrg = object abadrawing').gt(0)) then
        !insertBefore.append(!linenumber)
        !area = !read[$!linenumber].after(',').after(',').after(',').before(',').dbref()
        !suppname = !area.name.before('-AREA')
        !suppnames.append(!suppname)
        !drwg = !val.after(',').before(',').dbref()

        if !drwg.unset() then
          -- new drawing so check if another drawlist exist for that support
          !anotherSheet = ARRAY()
          var !anotherSheet collect all SHEET with darref eq $!area
          handle ANY
          endhandle

          if !anotherSheet.set() then
            !linkrefOfAnother = !anotherSheet[1].dbref().linkref.name
            !message = 'Drawing already exists for support $!suppname ( $!linkrefOfAnother ) - drawing generation aborted'

            --<wd>17mar2008
            -- ####################################################
            -- The APPSPAG routine raises an error with the variable !logline[1] only used once etc... so RENAME to !unusedlogline[1]
            -- ####################################################
            --
            -- *** IMPORTANT NOTE *** DO NOT rename !logline[1] *** to !unusedlogline[1] ***
            --
            -- ####################################################
            -- !logline[1] is part of a string enclosed in quotation marks and is VALID SYNTAX and *** MUST NOT be CHANGED ***,
            -- when instructed by APPSPAG, as it is required to be ADDED to the ABA BATCH FILE for processing and output in the generated ABA LOG FILE
            -- ####################################################
            !read[!linenumber] = '!logline[1] = ''' + !message + ''''
            -- ####################################################
            --<wd>17mar2008

            !read[!linenumber + 1] = ''
            !read[!linenumber + 2] = ''
            if undefined(!!mdsAbaDpcVar) then
              !!alert.error(!message)
            endif

          endif

        endif

      endif

    enddo
    !insertBefore.invert()
    !suppnames.invert()

    !numval = 1
    do !insertAt values !insertBefore
      if (defined(!!mdsAbaDpcVar)) then
        !read.insert(!insertAt,'syscom |echo (DM) Starting to detail $!suppnames[$!numval]|')
        !numval = !numval + 1
      else
        !read.insert(!insertAt,'syscom |echo (MDS ABA) Starting to detail $!suppnames[$!numval]|')
        !numval = !numval + 1
      endif
    enddo

    if (defined(!!mdsAbaDpcVar)) then
      do !val indices !read
        if (!read[$!val].match('net send').gt(0)) then
          !read[$!val].delete()
        endif
      enddo
      !read.compress()
    endif

    -- Overwrite the Macro File
    !macfile = !this.macfile
    !macfile.writefile('OVERWRITE',!read)
    !this.macfile = !macfile

    ---------------------------------------------
    -- Run MDS ABA Drawings in BATCH MODE - LATER --------->>>>>>>>>> NOT DONE YET <<<<<<<<<<<<<<
    ---------------------------------------------
  elseif (!runtype.eq('batch')) then

    -- ?????? ***LOAD MDS DEFAULTS in the MACRO file + Also ANY MDS ABA OBJECT DATA !!mdsabasupport() & from the form !!mdsabaselsupp...***??????
    -- Edit the Macro to ADD the EXTRA MDS ABA Requirements MACRO/FUNCTION
    !find = !read.find('savework')
    !read[!find[1]] = ''
    !read.insert(!find[1] + 1 ,'-- ***LOAD MDS DEFAULTS HERE %%% IF REQUIRED %%%% before PROCEEDING...***')

    -- Overwrite the Macro File
    !macfile = !this.macfile
    !macfile.writefile('OVERWRITE',!read)
    !this.macfile = !macfile

  endif

endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .run()

  -- Execute the  Modified Process macro
  !!kjbmds = TRUE
  $M/$!this.macfile
  !!kjbmds.delete()
  handle (2,751)
  endhandle

endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
-- Method to select the current element in list

define method .setce(!dummyGadget is GADGET, !type is STRING)

  if !type.eq('REGI') then
    Regi
    handle any
      !!alert.error('Unable to find a registry from the current element')
      return
    endhandle

    !!mdsabaselsupp.registry.val = !!ce.namn
    handle any
      !!alert.error('Unable to find a registry in the list')
      return
    endhandle

    !this.abaregi()

  elseif !type.eq('FRAME') then
    !suppname = !!mdsGetSuppName(!!ce)
    if !suppname.eq('ABORT') then
      return
    endif

    if !!mdsabatype(!!ce) .neq('FRAME') then
      !!alert.error('Current support type is not a framework')
      return
    endif

    !suppname = !suppname.after('/')
    !!mdsabaselsupp.frame.val = !suppname

  elseif !type.eq('HANGER') then
    !suppname = !!mdsGetSuppName(!!ce)
    if !suppname.eq('ABORT') then
      return
    endif

    if !!mdsabatype(!!ce).neq('HANGER') then
      !!alert.error('Current support type is not a hanger')
      return
    endif

    !suppname = !suppname.after('/')
    !!mdsabaselsupp.hanger.val = !suppname

  endif

endmethod
-- End of method definition for .setce(GADGET, STRING)

---------------------------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------
--
-- Method:      setscale() -- Called from the PML function "mdsabaviewtask.pmlfnc"
--
-- Description: Sets the view scale and frame size
--
------------------------------------------------------------------------
define method .setscale(!dummyorigscale is REAL, !viewrefe is DBREF) is REAL

  -- Initialise variables
  !viewrefe    = !!ce
  !scalebits   = !viewrefe.func.split()
  !scalechoice = !scalebits[1].upcase()
  handle any
    !!abaLogging.error('Unable To Set Scale - Invalid Function')
    return error 1
  endhandle
  !scaletype = !scalebits[2].upcase()

  !message = false

  -- Read relevant scales from the defaults file
  if (!!batchMode eq TRUE) then
    !file = object FILE(!!batchparam[1])
  else
    !file = object FILE(!!abaDefaults.defaultsfile.val)
  endif
  !scales = !this.readscales(!file,!scaletype)

  -- Set scale depending on scale choice set on the template
  --<wd>05oct2006 -- 'MAXIMUM' added to the "if" test
  --  if (!scalechoice.eq('NEAREST')) then
  if (!scalechoice.eq('NEAREST')) or (!scalechoice.eq('MAXIMUM'))then
    --<wd>05oct2006

    -- Set scale to nearest in scale list to the auto value
    !usescale = REAL()

    -- Cycle through scales to find one that is less than the current value
    do !index ind !scales
      break if (!index.eq(!scales.size()))
      if (!viewrefe.vsca.lt(!scales[!index].real()) and !viewrefe.vsca.gt(!scales[!index + 1].real())) then
        !usescale = !scales[!index + 1].real()
        break
      endif
    enddo

    -- Allow for gt the first and less than the last
    if (!usescale.unset()) then
      if (!viewrefe.vsca.gt(!scales[1].real())) then
        !usescale = !scales[1].real()
      endif
      if (!viewrefe.vsca.lt(!scales[!scales.size()].real())) then
        -- The view needs to be set using auto limits
        !message = true
        auto limits of idln
        !usescale = !!ce.vscale
      endif
    endif
  endif

  return $!usescale

endmethod

------------------------------------------------------------------------
--
-- Method:      readscales()
--
-- Description: Sets this object scaleList with defaults file list
--
------------------------------------------------------------------------
define method .readscales(!file is FILE, !match is STRING) is ARRAY

  -- variable file is the file to read
  -- variable match is the word to look for

  -- Initialise variables
  !scales = ARRAY()

  -- Read permitted scales from  defaults file
  !defaulttext = !file.readfile()
  !start = !defaulttext.findfirst('-- Section 2') + 1
  !end   = !defaulttext.findfirst('-- End Section 2')
  !range = !end - !start
  !lines = !defaulttext.from(!start,!range)

  -- Extract relevant bits for form gadget
  do !text val !lines
    if (!text.match(!match).neq(0)) then
      !split = !text.split('\')
      !scales.append(!split[5].split(',')[1])
    endif
  enddo

  return !scales

endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
--
-- Method:   selectall()
--
---------------------------------------------------------------------------------------------------------
define method .selectall(!listname is STRING)

  !list = !this.$!listname
  !toggle = !this.all$!listname

  if !toggle.val then
    !list.val = !list.dtext.indices()
  else
    !list.clearselection()
  endif

  !this.abaProcess()

endmethod
-- End of method definition for .selectall(STRING)
---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
--
--------------------------------------------
--<wd>18feb2008-DUN824 - Defect No. P-4405
--------------------------------------------
-- This is a NEW method for the Defect N0. P-4405
-- to cater for ENU and XYX co-ordinate systems
--------------------------------------------
--
-- Method: .enuDirections()
--
--------------------------------------------
--<wd>18dec2008 - Defect No. P-13975
-- Modified to cater for MDS supports on NON ORTHOGONAL Horizontal Pipes and
-- MDS supports on VERTICAL pipes, for flow directions DOWN(-Z) and UP(Z)
-- whether using either the ENU or the XYX co-ordinate system.
--------------------------------------------
---------------------------------------------------------------------------------------------------------
define method .enuDirections(!designdata is MDSABADESDATA, !orthdirections is ARRAY) is ARRAY

  -- Determine the Co-Ordinates System in use,
  --"ENU" (Normally used for AVEVA PLANT) or "XYZ" (Normally used for AVEVA MARINE)
  var !coord COORD

  -- Test for which Co-Ordinates System is in use, and Initialise Variables '
  if (!coord.upcase().eq('ENU')) then
    !east  = 'E'
    !west  = 'W'
    !north = 'N'
    !south = 'S'
    !up    = 'U'
    !down  = 'D'
  elseif (!coord.upcase().eq('XYZ')) then
    !east  = 'X'
    !west  = '-X'
    !north = 'Y'
    !south = '-Y'
    !up    = 'Z'
    !down  = '-Z'
  endif

  -- Initialise Variables, Passed and Default Values
  !desData     = !designdata
  !datum       = !desData.datum
  !oDirection  = !orthdirections
  !reverse     = FALSE
  !lookDownDir = object DIRECTION()
  !lookDown    = '$!down WRT /*'
  !lookDownDir = !lookDown.direction()

  -- Check if the DATUM Atta is for a HANGER and if necessary "REDEFINE" the directions
  -- stored in the !oDirection ARRAY variable to produce the MDS ABA View Directions.
  --<kp>jan07
  if !datum.type.eq('STRU') then
    --This is a MDS Lighting Support, which is the Only MDS Support type where the !datum is a STRU and NOT an ATTA )
    --so do nothing
    --<kp>jan07  if (!datum.cref.set()) then
  elseif (!datum.cref.set()) then
    -- Some MDS Lug Standards i.e. 'LT*', CONNECTS its P3 of the 'ATTA' to a MDS HANGER 'HANG' element
    -- MDS HANGER Manufacturers INTERFACE CHECK add, i.e. 'MH'
    if ((!datum.styp.match('FH').gt(0)) or (!datum.styp.match('VH').gt(0)) or (!datum.styp.match('MH').gt(0)) and (!datum.cref.type.eq('HANG'))) then
      !datumP3Dir = !datum.pdir[3].wrt(/* )
      !datumLDir  = !datum.ldir.wrt(/* )
      if (!datumP3Dir.eq(!oDirection[1])) then

        --------------------------------------------
        --<wd>03mar2008 - DUN824 - Defect No. P-4405
        -- Determine the current COORD system, XYZ or ENU????
        !downDirection = !down.direction().wrt(/* )
        !updirection   = !up.direction().wrt(/* )
        --        if ((!datumLDir.eq($!down WRT /* )) or (!datumLDir.eq($!up WRT /* ))) then
        if ((!datumLDir.eq(!downDirection)) or (!datumLDir.eq(!updirection))) then
          --<wd>03mar2008 - DUN824 - Defect No. P-4405
          --------------------------------------------

          -- The Hanger Atta is connected to a VERTICAL PIPE with a "TWIN" Hanger type or a Similar arrangement etc...
          -- Therefore "REDEFINE" the directions stored in the ARRAY variable ** !oDirection **
          !oDirection[1] = !datum.pdir[9].wrt(/* )
          !oDirection[2] = !oDirection[1].opposite()
          -- Reset !desData values to the new !oDirection values
          !desData.datumOrthDir = !oDirection[1]
          !desData.datumOppDir  = !oDirection[2]
        endif
      endif
    endif
  endif

  -- Determine the Side View Direction - Depending on the Selected Drawing Projection
  !ddire     = !oDirection[1].string()
  !ds        = !ddire.split()
  !mainADeg  = 0
  !planADeg  = 0

  --<wd>18dec2008 - Defect No. P-13975 -- NEW ADEG Value for the SIDE VIEW (DRTMPL default VIEW Direction is E or X wrt /*
  !sideadeg  = 0

  -- Always Set Main View Direction to 'North' if !desData.datumOrthDir is 'South',
  -- or to 'East' if !desData.datumOrthDir is 'West'
  -- and to 'Down' if !desData.datumOrthDir is 'Up',
  -- i.e. The Opposite Direction
  ---------------------------------------------
  if (!ds.size().eq(3)) then
    -- A True Orthogonal Direction i.e. E, N, W or S WRT /* or X, Y, -X or -Y WRT /*
    if (!ds[1].eq('$!east')) then
      -- Looking 'North' Direction
      !lookWestStr = '$!east (90) $!north WRT /*'
      !lookWestDir = $!lookWestStr
      handle (2,779)
        !lookWestDir = axis $!lookWestStr
      endhandle
      -- Looking 'South' Direction
      !lookEastStr = '$!east (-90) $!north WRT /*'
      !lookEastDir = $!lookEastStr
      handle (2,779)
        !lookEastDir = axis $!lookEastStr
      endhandle
      -- Set the Plan view Adeg Attribute
      !planADeg =  90

      ---------------------------------------------
    elseif (!ds[1].eq('$!north')) then
      -- Looking 'West' Direction
      !lookWestStr = '$!north (90) $!west WRT /*'
      !lookWestDir = $!lookWestStr
      handle (2,779)
        !lookWestDir = axis $!lookWestStr
      endhandle
      -- Looking 'East' Direction
      !lookEastStr = '$!north (-90)$!west WRT /*'
      !lookEastDir = $!lookEastStr
      handle (2,779)
        !lookEastDir = axis $!lookEastStr
      endhandle
      -- Set the Plan view Adeg Attribute
      !planADeg =  0

      ---------------------------------------------
      -- Main View Direction to be set to East
    elseif (!ds[1].eq('$!west')) then
      -- Reverse Directions
      !desData.datumOrthDir = !oDirection[2]
      !desData.datumOppDir  = !oDirection[1]
      !reverse  = true
      -- Looking 'North' Direction
      !lookWestStr = '$!east (90) $!north WRT /*'
      !lookWestDir = $!lookWestStr
      handle (2,779)
        !lookWestDir = axis $!lookWestStr
      endhandle
      -- Looking 'South' Direction
      !lookEastStr = '$!east (-90) $!north WRT /*'
      !lookEastDir = $!lookEastStr
      handle (2,779)
        !lookEastDir = axis $!lookEastStr
      endhandle
      -- Set the Plan view Adeg Attribute
      !planADeg =  90

      ---------------------------------------------
      -- Main View Direction to be set to North
    elseif (!ds[1].eq('$!south')) then
      -- Reverse Directions
      !desData.datumOrthDir = !oDirection[2]
      !desData.datumOppDir  = !oDirection[1]
      -- Looking 'West' Direction
      !lookWestStr = '$!north (90) $!west WRT /*'
      !lookWestDir = $!lookWestStr
      handle (2,779)
        !lookWestDir = axis $!lookWestStr
      endhandle
      -- Looking 'East' Direction
      !lookEastStr = '$!north (-90) $!west WRT /*'
      !lookEastDir = $!lookEastStr
      handle (2,779)
        !lookEastDir = axis $!lookEastStr
      endhandle
      -- Set the Plan view Adeg Attribute
      !planADeg =  0

      ---------------------------------------------
    elseif (!ds[1].eq('$!down')) then
      -- The MAIN View <VIEW No. 4> will be Labelled - 'Plan View' and 'NORTH' will always be at the TOP of the Sheet
      !p3dir = !datum.pdir[3].wrt(/* )
      --      !p3dir = !datum.pdir[9].wrt(/* )
      !p3spl = !p3dir.string().split()

      ---------------------------------------------
      if (!p3spl.size().eq(3)) then
        if (!p3spl[1].eq('$!east')) then
          !mainADeg = 0
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = !p3dir.opposite()
          !lookEastDir = !p3dir
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = !p3dir
          !lookWestDir = !p3dir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east (90) $!north WRT /*'
          !lookDownStr = '$!east (90) $!south WRT /*'
          !lookDownDir =  $!lookDownStr
          handle (2,779)
            !lookDownDir = axis $!lookDownStr
          endhandle
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg    = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!north')) then
          !mainADeg = 0
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastStr = '$!north (90) $!west WRT /*'
          !lookEastStr = '$!north (-90) $!west WRT /*'
          !lookEastDir = $!lookEastStr
          handle (2,779)
            !lookEastDir = axis $!lookEastStr
          endhandle
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestStr = '$!north (-90) $!west WRT /*'
          !lookWestStr = '$!north (90) $!west WRT /*'
          !lookWestDir = $!lookWestStr
          handle (2,779)
            !lookWestDir = axis $!lookWestStr
          endhandle
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east (90) $!north WRT /*'
          !lookDownStr = '$!east (90) $!south WRT /*'
          !lookDownDir =  $!lookDownStr
          handle (2,779)
            !lookDownDir = axis $!lookDownStr
          endhandle
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg    = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!west')) then
          !mainADeg = 0
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = !p3dir
          !lookEastDir = !p3dir.opposite()
          -- Looking 'West' Direction          !lookWestDir = !p3dir.opposite()
          !lookWestDir = !p3dir
          -- Looking 'North' Direction is Opposite to the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east (90) $!north WRT /*'
          !lookDownStr = '$!east (90) $!south WRT /*'
          !lookDownDir =  $!lookDownStr
          handle (2,779)
            !lookDownDir = axis $!lookDownStr
          endhandle
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg    = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!south')) then
          !mainADeg = 0
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastStr = '$!north (90) $!west WRT /*'
          !lookEastStr = '$!north (-90) $!west WRT /*'
          !lookEastDir = $!lookEastStr
          handle (2,779)
            !lookEastDir = axis $!lookEastStr
          endhandle
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestStr = '$!north (-90) $!west WRT /*'
          !lookWestStr = '$!north (90) $!west WRT /*'
          !lookWestDir = $!lookWestStr
          handle (2,779)
            !lookWestDir = axis $!lookWestStr
          endhandle
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east (90) $!north WRT /*'
          !lookDownStr = '$!east (90) $!south WRT /*'
          --<wd>18dec2008 - Defect No. P-13975
          !lookDownDir =  $!lookDownStr
          handle (2,779)
            !lookDownDir = axis $!lookDownStr
          endhandle
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg    = 90

          --+++++++++++++++++++++++++++++++++++++++++++
        elseif (!p3spl[1].eq('$!down')) then
          !mainADeg = 0
          -- Looking 'East' Direction
          !lookEastStr = '$!north (90) $!west WRT /*'
          !lookEastDir = $!lookEastStr
          handle (2,779)
            !lookEastDir = axis $!lookEastStr
          endhandle
          -- Looking 'West' Direction
          !lookWestStr = '$!north (-90) $!west WRT /*'
          !lookWestDir = $!lookWestStr
          handle (2,779)
            !lookWestDir = axis $!lookWestStr
          endhandle
          -- Looking 'North' Direction is Same as the P3 Direction
          !lookDownStr = '$!east (90) $!north WRT /*'
          !lookDownDir =  $!lookDownStr
          handle (2,779)
            !lookDownDir = axis $!lookDownStr
          endhandle
          !planADeg    = 0
          --++++++++++++++++++++++++++++++++++++++++++

        endif
        ---------------------------------------------
        ---------------------------------------------
      else
        -- Non Orthogonal P3 Direction of Datum Atta on a Vertical Pipe (HDIR = DOWN) - Plan View e.g. P3 Dir = E 30 N WRT /*
        -- The P3 Direction of the DATUM atta on a Vertical Pipe is to be directed to the Bottom of the Sheet
        ---------------------------------------------
        if (!p3spl[1].eq('$!east') and !p3spl[3].eq('$!north')) then
          --<wd>18dec2008 - Defect No. P-13975          !mainADeg = -90 + -$!<p3spl[2]>
          !mainADeg = 90 - $!<p3spl[2]>
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = !p3dir
          !lookEastDir = !ddire.direction().cross(!p3dir)
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = !lookWestDir.opposite()
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east ($!mainADeg + 90) $!north wrt /* '
          !lookDownStr = '$!west $!<p3spl[2]> $!south wrt /* '
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir = $!lookDownStr
          !lookDownDir = !lookDownStr.direction()
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg    = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!north') and !p3spl[3].eq('$!east')) then
          --<wd>18dec2008 - Defect No. P-13975          !mainADeg = -90 + (-90 - -$!<p3spl[2]>)
          !mainADeg = $!<p3spl[2]>
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = !p3dir
          !lookEastDir = !ddire.direction().cross(!p3dir)
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = !lookWestDir.opposite()
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east ($!mainADeg + 90) $!north wrt /* '
          !lookDownStr = '$!south $!mainADeg $!west wrt /* '
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir = $!lookDownStr
          !lookDownDir = !lookDownStr.direction()
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!east') and !p3spl[3].eq('$!south')) then
          --<wd>18dec2008 - Defect No. P-13975          !mainADeg = 90 + (-90 + -$!<p3spl[2]>)
          !mainADeg = -90 + $!<p3spl[2]>
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = !p3dir
          !lookEastDir = !ddire.direction().cross(!p3dir).opposite()
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = !lookWestDir.opposite()
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east (-$!mainADeg) $!north wrt /* '
          !lookDownStr = '$!east $!<p3spl[2]> $!south wrt /* '
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir = $!lookDownStr
          !lookDownDir = !lookDownStr.direction()
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg    = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!south') and !p3spl[3].eq('$!east')) then
          !mainADeg = -$!<p3spl[2]>
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = !p3dir.opposite()
          !lookEastDir = !ddire.direction().cross(!p3dir).opposite()
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = !lookWestDir.opposite()
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east ($!mainADeg - 90) $!north wrt /* '
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir = $!lookDownStr
          !lookDownDir = !p3dir
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!west') and !p3spl[3].eq('$!north')) then
          --<wd>18dec2008 - Defect No. P-13975          !mainADeg = 90 + $!<p3spl[2]>
          !mainADeg = -90 + $!<p3spl[2]>
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = !p3dir.opposite()
          !lookEastDir = !ddire.direction().cross(!p3dir)
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = !lookWestDir.opposite()
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east ($!mainADeg - 90) $!north wrt /* '
          !lookDownStr = '$!east $!<p3spl[2]> $!south wrt /* '
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir = $!lookDownStr
          !lookDownDir = !lookDownStr.direction()
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!north') and !p3spl[3].eq('$!west')) then
          --<wd>18dec2008 - Defect No. P-13975          !mainADeg = 90 + $!<p3spl[2]>
          !mainADeg = -$!<p3spl[2]>
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = !p3dir.opposite()
          !lookEastDir = !ddire.direction().cross(!p3dir)
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = !lookWestDir.opposite()
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east ($!mainADeg - 90) $!north wrt /* '
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir = $!lookDownStr
          !lookDownDir = !p3dir.opposite()
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!west') and !p3spl[3].eq('$!south')) then
          --<wd>18dec2008 - Defect No. P-13975          !mainADeg = (90 - $!<p3spl[2]>)
          !mainADeg = 90 - $!<p3spl[2]>
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = !p3dir.opposite()
          !lookEastDir = !ddire.direction().cross(!p3dir).opposite()
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = !lookWestDir.opposite()
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east ($!mainADeg - 90) $!north wrt /* '
          !lookDownStr = '$!west $!<p3spl[2]> $!south wrt /* '
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir = $!lookDownStr
          !lookDownDir = !lookDownStr.direction()
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!south') and !p3spl[3].eq('$!west')) then
          !mainADeg = $!<p3spl[2]>
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = !p3dir.opposite()
          !lookWestDir = !ddire.direction().cross(!p3dir)
          -- Looking 'West' Direction
          !lookEastDir = !lookWestDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east ($!mainADeg - 90) $!north wrt /* '
          !lookDownStr = '$!south $!mainADeg $!west wrt /* '
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir = $!lookDownStr
          !lookDownDir = !lookDownStr.direction()
          --<wd>18dec2008 - Defect No. P-13975       !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg = 90

          ---------------------------------------------
        endif
      endif

    elseif (!ds[1].eq('$!up')) then
      -- Reverse Directions
      !desData.datumOrthDir = !oDirection[2]
      !desData.datumOppDir  = !oDirection[1]
      !reverse = true

      -- The MAIN View <VIEW No. 4> will be Labelled - 'Plan View' and 'NORTH' will always be at the TOP of the Sheet
      !p3dir = !datum.pdir[3].wrt(/* )
      !p3spl = !p3dir.string().split()
      if (!p3spl.size().eq(3)) then
        ---------------------------------------------
        if (!p3spl[1].eq('$!east')) then
          !mainADeg = 0
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975
          !lookEastDir = !p3dir
          --!lookEastDir = !ddire.direction().cross(!p3dir)
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = !p3dir
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east (90) $!north WRT /*'
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir =  $!lookDownStr
          !lookDownDir = !ddire.direction().cross(!p3dir).opposite()
          --          !lookDownDir = !p3dir.opposite()
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg    = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!north')) then
          --<wd>18dec2008 - Defect No. P-13975
          !mainADeg = 0
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastStr = '$!north (90) $!west WRT /*'
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = $!lookEastStr
          !lookEastDir = !ddire.direction().cross(!p3dir).opposite()
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975         !lookWestStr = '$!north (-90) $!west WRT /*'
          --<wd>18dec2008 - Defect No. P-13975         !lookWestDir = $!lookWestStr
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east (90) $!north WRT /*'
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir =  $!lookDownStr
          !lookDownDir = !p3dir.opposite()
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg    = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!west')) then
          !mainADeg = 0
          -- Looking 'East' Direction
          !lookEastDir = !p3dir.opposite()
          -- Looking 'West' Direction
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Opposite to the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east (90) $!north WRT /*'
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir =  $!lookDownStr
          !lookDownDir = !ddire.direction().cross(!p3dir)
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg    = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!south')) then
          !mainADeg = 0
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastStr = '$!north (90) $!west WRT /*'
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = $!lookEastStr
          !lookEastDir = !ddire.direction().cross(!p3dir)
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = $!lookWestStr
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east (90) $!north WRT /*'
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir =  $!lookDownStr
          !lookDownDir = !p3dir
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg    = 90

          ---------------------------------------------
        endif
      else
        -- Non Orthogonal P3 Direction of a Datum Atta of a Vertical Pipe (HDIR = UP ) - Plan View e.g. P3 Dir = E 30 N WRT /*
        -- The P3 Direction of the DATUM atta on a Vertical Pipe is to be directed to the Bottom of the Sheet
        ---------------------------------------------
        if (!p3spl[1].eq('$!east') and !p3spl[3].eq('$!north')) then
          --<wd>18dec2008 - Defect No. P-13975          !mainADeg = -90 + -$!<p3spl[2]>
          !mainADeg    = 90 - $!<p3spl[2]>
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = !p3dir
          !lookEastDir = !ddire.direction().cross(!p3dir).opposite()
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = !lookWestDir.opposite()
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east ($!mainADeg + 90) $!north wrt /* '
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir = $!lookDownStr
          !lookDownDir =!p3dir.opposite()
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg    = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!north') and !p3spl[3].eq('$!east')) then
          --<wd>18dec2008 - Defect No. P-13975          !mainADeg = -90 + (-90 - -$!<p3spl[2]>)
          !mainADeg    = $!<p3spl[2]>
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = !p3dir
          !lookEastDir = !ddire.direction().cross(!p3dir).opposite()
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = !lookWestDir.opposite()
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east ($!mainADeg + 90) $!north wrt /* '
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir = $!lookDownStr
          !lookDownDir = !p3dir.opposite()
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg    = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!east') and !p3spl[3].eq('$!south')) then
          --<wd>18dec2008 - Defect No. P-13975          !mainADeg = 90 + (-90 + -$!<p3spl[2]>)
          !mainADeg = -90 + $!<p3spl[2]>
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = !p3dir
          !lookEastDir = !ddire.direction().cross(!p3dir)
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = !lookWestDir.opposite()
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east (-$!mainADeg) $!north wrt /* '
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir = $!lookDownStr
          !lookDownDir = !p3dir
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg    = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!south') and !p3spl[3].eq('$!east')) then
          !mainADeg = -$!<p3spl[2]>
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = !p3dir.opposite()
          !lookEastDir = !ddire.direction().cross(!p3dir)
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = !lookWestDir.opposite()
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east (180 + 90 - $!mainADeg + 90) $!north wrt /* '
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir = $!lookDownStr
          !lookDownDir = !p3dir
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg    = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!west') and !p3spl[3].eq('$!north')) then
          --<wd>18dec2008 - Defect No. P-13975          !mainADeg = 90 + $!<p3spl[2]>
          !mainADeg = -90 - -$!<p3spl[2]>
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = !p3dir.opposite()
          !lookEastDir = !ddire.direction().cross(!p3dir).opposite()
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = !lookWestDir.opposite()
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!north ( $!mainADeg - 90 ) $!east wrt /* '
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir = $!lookDownStr
          !lookDownDir = !p3dir.opposite()
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg    = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!north') and !p3spl[3].eq('$!west')) then
          --<wd>18dec2008 - Defect No. P-13975          !mainADeg = (90 + 90 - $!<p3spl[2]>)
          !mainADeg = -$!<p3spl[2]>
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = !p3dir
          !lookEastDir = !ddire.direction().cross(!p3dir).opposite()
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = !lookWestDir.opposite()
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east (90 - ($!mainADeg - 90)) $!north wrt /* '
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir = $!lookDownStr
          !lookDownDir = !p3dir.opposite()
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg    = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!west') and !p3spl[3].eq('$!south')) then
          !mainADeg = (90 - $!<p3spl[2]>)
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = !p3dir.opposite()
          !lookEastDir = !ddire.direction().cross(!p3dir)
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = !lookWestDir.opposite()
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east (90 + 90 - $!mainADeg) $!north wrt /* '
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir = $!lookDownStr
          !lookDownDir = !p3dir
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg    = 90

          ---------------------------------------------
        elseif (!p3spl[1].eq('$!south') and !p3spl[3].eq('$!west')) then
          !mainADeg = $!<p3spl[2]>
          -- Looking 'East' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookWestDir = !p3dir.opposite()
          !lookEastDir = !ddire.direction().cross(!p3dir)
          -- Looking 'West' Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookEastDir = !lookWestDir.opposite()
          !lookWestDir = !lookEastDir.opposite()
          -- Looking 'North' Direction is Same as the P3 Direction
          --<wd>18dec2008 - Defect No. P-13975          !lookDownStr = '$!east ($!mainADeg - 90) $!north wrt /* '
          --<wd>18dec2008 - Defect No. P-13975          !lookDownDir = $!lookDownStr
          !lookDownDir = !p3dir
          --<wd>18dec2008 - Defect No. P-13975          !planADeg    = 0
          !planADeg    = 180
          --<wd>18dec2008 - Defect No. P-13975
          !sideadeg = 90

        endif
      endif
      ---------------------------------------------
    endif
    ---------------------------------------------
    --
  else
    -----------------------------------------------------------------------------
    -----------------------------------------------------------------------------
    -- Calculate Plan View ADEG Required for NON-Orthogonal Horizontal Datum Atta
    -----------------------------------------------------------------------------
    -----------------------------------------------------------------------------
    if (!ds[1].eq('$!east') and !ds[3].eq('$!north')) then
      !planADeg = (90 - $!<ds[2]>)
    elseif (!ds[1].eq('$!north') and !ds[3].eq('$!east')) then
      !planADeg = ($!<ds[2]>)
    elseif (!ds[1].eq('$!east') and !ds[3].eq('$!south')) then
      -- Mod Not Reverse Directions
      --!desData.datumOrthDir = !oDirection[2]
      --!desData.datumOppDir  = !oDirection[1]
      --!planADeg = (-90 + $!<ds[2]>)
      !planADeg = (90 + $!<ds[2]>)
      --!reverse  = true
    elseif (!ds[1].eq('$!south') and !ds[3].eq('$!east')) then
      -- Reverse Directions
      !desData.datumOrthDir = !oDirection[2]
      !desData.datumOppDir  = !oDirection[1]
      !planADeg = (-$!<ds[2]>)
      !reverse  = true
    elseif (!ds[1].eq('$!west') and !ds[3].eq('$!north')) then
      -- Mod dtf 18.07.05 Reverse Directions
      !desData.datumOrthDir = !oDirection[2]
      !desData.datumOppDir  = !oDirection[1]
      --!planADeg = (-90 + $!<ds[2]>)
      !planADeg = (90 + $!<ds[2]>)
      !reverse  = true
    elseif (!ds[1].eq('$!north') and !ds[3].eq('$!west')) then
      !planADeg = (-$!<ds[2]>)
    elseif (!ds[1].eq('$!west') and !ds[3].eq('$!south')) then
      -- Reverse Directions
      !desData.datumOrthDir = !oDirection[2]
      !desData.datumOppDir  = !oDirection[1]
      !planADeg = (90 - $!<ds[2]>)
      !reverse  = true
    elseif (!ds[1].eq('$!south') and !ds[3].eq('$!west')) then
      -- Reverse Directions
      !desData.datumOrthDir = !oDirection[2]
      !desData.datumOppDir  = !oDirection[1]
      !planADeg = ($!<ds[2]>)
      !reverse  = true
    endif

    if (!reverse) then
      if (!ds[1].eq('$!south') and !ds[3].eq('$!west')) or  (!ds[1].eq('$!west') and !ds[3].eq('$!north')) then
        !westPlusOrMinus = '+'
        !eastPlusOrMinus =  '-'
      elseif (!ds[1].eq('$!west') and !ds[3].eq('$!south')) or (!ds[1].eq('$!south') and !ds[3].eq('$!east'))  then
        !westPlusOrMinus = '-'
        !eastPlusOrMinus =  '+'
      endif

    else
      if (!ds[1].eq('$!north') and !ds[3].eq('$!east')) or (!ds[1].eq('$!east') and !ds[3].eq('$!south')) then
        !westPlusOrMinus = '-'
        !eastPlusOrMinus =  '+'
      elseif (!ds[1].eq('$!east') and !ds[3].eq('$!north')) or (!ds[1].eq('$!north') and !ds[3].eq('$!west')) then
        !westPlusOrMinus = '+'
        !eastPlusOrMinus =  '-'
      endif
    endif
    -- Looking 'West' Direction
    !lookWestStr = !ds[1] & ' ( ' & !ds[2] & !westPlusOrMinus & ' 90 )' & ' ' & !ds[3] & ' ' & !ds[4] & ' ' & !ds[5]
    --<wd>18dec2008 - Defect No. P-13975    !lookWestDir = $!lookWestStr
    !lookWestDir = !lookWestStr.direction()
    -- Looking 'East' Direction
    !lookEastStr = !ds[1] & ' ( ' & !ds[2] & !eastPlusOrMinus & ' 90 )' & ' ' & !ds[3] & ' ' & !ds[4] & ' ' & !ds[5]
    --<wd>18dec2008 - Defect No. P-13975    !lookEastDir = $!lookEastStr
    !lookEastDir = !lookEastStr.direction()

  endif

  -- Set the Object Direction values
  !desData.lookWestDir = !lookWestDir
  !desData.lookEastDir = !lookEastDir
  !desData.lookDownDir = !lookDownDir

  -- Populate the ABA ADEG ARRAY !abaDegData
  !abaDegData    = ARRAY()
  !abaDegData[1] = !mainADeg
  !abaDegData[2] = !planADeg

  --<wd>18dec2008 - Defect No. P-13975 -- NEW ADEG Value for the SIDE VIEW (DRTMPL default VIEW Direction is E or X wrt /*
  !abaDegData[3] = !sideadeg


  -- Populate the DESIGN DATA ARRAY !designArray
  !designArray = ARRAY()
  !designArray[1] = !desData
  !designArray[2] = !oDirection
  !designArray[3] = !abaDegData

  -- Return the DESIGN DATA ARRAY !designArray
  return !designArray

endmethod
-- End of method definition for .enuDirections(MDSABADESDATA, ARRAY) ARRAY
--------------------------------------------
--<wd>18feb2008-DUN824 - Defect No. P-4405
--------------------------------------------END
