    !tmpseldbref  = !tmpselstring.dbref()
    --      !tmpreference = !tmpseldbref.string()
    --      !!abaNewDrwgs.dTypes.select('rtext',!tmpreference)
    --<wd>19mar2008 - DUN824 -- Changes as per Steve Wilson's email (18mar2008) for using the new ABA 12.0.sP2 appware version


    ---------------------------------------------------------------------------13June2002
    -- q var !!abaNewDrwgs.areas.rtext

