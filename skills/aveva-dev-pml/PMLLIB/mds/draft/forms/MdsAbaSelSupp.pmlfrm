------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .clearformem()

  -- Clear Form ARRAY and File members
  !this.olddrwgs.clear()
  !this.newdrwgs.clear()
  !this.areas.clear()
  !this.template = object DBREF()
  !this.macfile  = object FILE()
  !this.batfile  = object FILE()
  !this.logfile  = object FILE()
  !this.mdssupports.clear()
  !!mdsarray = ARRAY()

endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .loadtemplates(!xtmpl is BOOLEAN, !error is STRING)

  -- Clear the current Template list and Initialise Variables
  !this.templates.clear()
  !dtext = ARRAY()
  !error = STRING()
  !xtmpl = false

  -- Collect the List of Valid MDS ABA Drawing Templates
  !templateliby = !!abaDefaults.dlib.val
  !test = !templateliby.dbref()
  handle NONE
    !tmpl = !!kcollectallfor('DRTMPL', '(function eq |MDS|)', !test)
    -- !tmpl = !!kcollectallfor('DRTMPL', '(function eq |MDS|)', =0/0)
  elsehandle ANY
    !error = 'WARNING - The MDS ABA Template Liby does not exist
    ($!!abaDefaults.dlib.val)'
    !xtmpl = false
    return
  endhandle

  -- ABORT Entry if NO 'MDS ABA Templates' are found
  if (!tmpl.unset() or !tmpl.empty()) then
    !error = 'WARNING - No MDS ABA Templates exist.
    You will NOT be able to Create or Modify any MDS ABA Drawings.'
    !xtmpl = false
    return
  else
    !xtmpl = true
  endif

  -- Load the templates into the form gadget .templates
  do !indx indices !tmpl
    !dtext[!indx] = !tmpl[!indx].flnn
    !!ce          = shtmpl1 of $!tmpl[$!indx]
    !rtext[!indx] = !!ce.refe.string()
  enddo
  !this.templates.dtext = !dtext
  !this.templates.rtext = !rtext
  -- !this.htemplates.dtext = !dtext
  -- !this.htemplates.rtext = !rtext

endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .loadregistries(!xregi is BOOLEAN, !error is STRING)

  -- Clear the current Registry list and Initialise Variables
  !this.registry.clear()
  !dtext = ARRAY()
  !error = STRING()
  !xregi = false

  -- Collect the List of Valid MDS ABA Drawing Registry Elements
  --!regi = !!kcollectallfor('REGI', '(function eq |MDS|)', =0/0)
  !regi = !!kcollectallfor('REGI', '', =0/0)

  -- Warn Users on Entry if NO 'Drawing Registries' are found
  if (!regi.unset() or !regi.empty()) then
    !error = 'ERROR - No Drawing Registries exist.
    You will NOT be able to Create or Modify any MDS ABA Drawings.'
    !xregi = false
    return
  else
    -- Only Load if the User has the Correct Access to the Registry
    !error = STRING()
    do !indx indices !regi
      !element = !regi[!indx].name
      !type    = 'REGISTRY'
      !regixst = !this.check(!element,!type,!error)
      if (!regixst.not()) then
        skip
      else
        !dtext.append(!regi[!indx].flnn)
      endif
    enddo

    -- Only Load the available Registries into the form gadget .registry
    if (!dtext.empty().not()) then
      !this.registry.dtext = !dtext
      !xregi = true
    else
      !error = 'WARNING - No Drawing Registries are available for your use.
      You will NOT be able to Create or Modify any MDS ABA Drawings.'
      !xregi = false
    endif
  endif

  -- Set ABA Registry on ABA form 'abaprocess'
  if (!xregi) then
    !this.abaregi()
  endif

endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .abaregi()

  -- Get the Selected MDS ABA Registry
  !element = '/' & !this.registry.selection()

  -- Load the Gadgets on the ABA form 'abaprocess' with the Registry
  !!abaProcess.creregname.val = !element
  !!abaProcess.reginame       = !element.dbref()
  !!abaProcess.useregname.val = !element
  !!abaProcess.action1.val    = 2

endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .processtype()

  -- Clear Form Members
  !this.clearformem()

  ------------------------------------------------------
  --<wd>02oct2008 - DUN975 - Modified the !process variable to reflect the ABA process type selected
  -- Process Type is Now HARD CODED to 'Regenerate' i.e. Delete  an Existing Drawing and Regenerate and/or Create a NEW drawing
  !process = 'Regenerate'

  if (!this.updateDrwg.val) then
    !process = 'Update'
  elseif (!this.regenerateDrwg.val) then
    !process = 'Regenerate'
  else
    -- Set to the new <DM> MDS ABA default setting of 'Update'
    !process = 'Update'
  endif
  -- Set the ABA form 'abaprocess' - Process Type Gadget
  !!abaProcess.update.select('rtext',!process)
  handle any
    -- Handle any error if the Dtext & Rtext haven't been loaded into the '!!abaProcess.update' option gadget
  endhandle

  ------------------------------------------------------
  -- Code Shown Below for Option Gadget for process type which used to be on this FORM


endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .abaProcess()

  -- Initialise the ABA form 'abaprocess' to clear the Drawing Gadgets
  !!abaProcess.init('NOSHOW')
  hide !!abaProcess

  --<wd>19mar2008 - DUN824 -- Changes as per Steve Wilson's email (18mar2008) for using the new ABA 12.0.sP2 appware version
  -- Empty the List gadgets on ABA forms 'abanewdrwgs' and 'abaolddrwgs'
  --    !!abaNewDrwgs.dTypes.clear()
  --    !!abaNewDrwgs.areas.clear()
  --    !!abaOldDrwgs.drawings.clear()
  !!abaNewDrwgs.clear()
  !!abaOldDrwgs.clear()
  --<wd>19mar2008 - DUN824 -- Changes as per Steve Wilson's email (18mar2008) for using the new ABA 12.0.sP2 appware version

  -- Determine the ABA Process Type plus the NEW and OLD Drawing List
  !this.processtype()

  -- Set counters
  !frameworks                = !!mdsabaselsupp.frame.dtext.size()
  !frameworksselected        = !!mdsabaselsupp.frame.val.size()
  !!mdsabaselsupp.frame.tag  = ' Frameworks ($!frameworksselected of $!frameworks)'
  !hangers                   = !!mdsabaselsupp.hanger.dtext.size()
  !hangersselected           = !!mdsabaselsupp.hanger.val.size()
  !!mdsabaselsupp.hanger.tag = ' Hangers ($!hangersselected of $!hangers)'
  --<wd>feb2005
  !ancills                   = !!mdsabaselsupp.ancill.dtext.size()
  !ancillsselected           = !!mdsabaselsupp.ancill.val.size()
  !!mdsabaselsupp.ancill.tag = ' Ancillaries ($!ancillsselected of $!ancills)'
  --<wd>feb2005

  --<kp>jan07
  !lights                    = !this.light.dtext.size()
  !lightsselected            = !this.light.val.size()
  !this.light.tag            = 'Lighting Supports ($!lightsselected of $!lights)'
  --<kp>jan07

endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .apply(!mode is REAL)

  -- Turn off warnings
  warnings off

  -- Add variable to tell Draft that mds aba is running
  !!mdsisrunning = TRUE

  -- Get the Project Code and MDS ABA Defaults
  !project = current project
  !prjcode = !project.code()
  !unusedprjdflt = '%' & !prjcode & 'DFLTS%'
  !prjdefs = !!abaDefaults.defaultsfile.val

  -- Check if MDS ABA Default File Exists and Load if TRUE
  !mdsdefs = object FILE(!prjdefs)
  if (!mdsdefs.exists()) then
    -- Load the MDS ABA Defaults file into the ABA Defaults form
    !!abaDefaults.defaultsfile.val = !prjdefs
    --<tm>21/07/2005 12:41
    -- if the defaults have been loaded before, don't load them again
    !test = !!abaDefaults.alib.val.dbref()
    handle ANY
      !!abaDefaults.readdefaults()
    endhandle
  else
    !!alert.error('The MDS ABA Defaults file ''$!prjdefs'' does NOT exist. Aborting Generation of the MDS ABA Drawings')
    !!mdsisrunning.delete()
    warnings on
    return
  endif

  -- Clear form ARRAY & file members
  !this.clearformem()

  -- Get the Selected ABA Template & Supports
  !template = !this.templates.selection('dtext')
  if (!template.eq('') or !this.templates.dtext.empty()) then
    !!alert.error('No MDS ABA Drawing Templates exist. Aborting Generation of the MDS ABA Drawings')
    !!mdsisrunning.delete()
    warnings on
    return
  endif

  -- Check if ABA Template Exists in the Nominated MDS ABA Default Library<LIBY>/Drawing template Library<DRTMLB>
  !mdstempstrg = '/' & !template
  !mdstempdbrf = !mdstempstrg.dbref()
  handle any
    !!alert.error('The MDS ABA Hanger Drawing Template ''$!mdstempstrg'' does NOT exist. Aborting Generation of the MDS ABA Drawings')
    !!mdsisrunning.delete()
    warnings on
    return
  elsehandle none
    -- Get the ABA Default Template Hierarchy
    !abadeftemp = !!abaDefaults.dlib.val
    !abadeftype = !abadeftemp.dbref().type
    if (!abadeftype.eq('DRTMLB')) then
      -- MDS ABA Template Hierarchy
      !mdstempowne = !mdstempdbrf.owner
    elseif (!abadeftype.eq('LIBY')) then
      -- MDS ABA Template Hierarchy
      !mdstempowne = !mdstempdbrf.owner.owner
    endif
    -- ABORT Drawing generation if the ABA Default Template Value is NOT the same as the LIBY or DRTMLB
    if (!mdstempowne.name.neq(!abadeftemp)) then
      !!alert.error('The selected MDS ABA template ''$!mdstempstrg'' does NOT exist in the ABA Template Default LIBY/DRTMLB. Aborting Generation of the MDS ABA Drawings')
      !!mdsisrunning.delete()
      warnings on
      return
    endif
  endhandle

  --<wd>jan2005
  -- With the introduction of MDS GROUPS - For the gadget "!this.frame" ONLY, get the "RTEXT" and NOT the "DTEXT"
  -- to obtain the database NAME for the name of the "MASTER GROUP MDS FRAMEWORK STRUCTURE", e.g. "PS1234[1]"
  --!supports = !this.frame.selection('dtext')

  --<k.pleschner> June2005 Added sorting to make the order of supports the same as displayed
  !supports = !this.frame.selection('rtext').sort()
  --<wd>22feb05  !supports.appendarray(!this.hanger.selection('dtext'))
  --<wd>jan2005
  !hsupports = !this.hanger.selection('dtext').sort()
  --<wd>feb2005
  !asupports = !this.ancill.selection('dtext').sort()
  --<wd>feb2005

  --<kp>jan07
  !lsupports = !this.light.selection('dtext').sort()
  --<kp>jan07

  !tsupports = !this.frame.selection('dtext').sort()
  !tsupports.appendarray(!this.hanger.selection('dtext').sort())
  --<wd>feb2005
  !tsupports.appendarray(!this.ancill.selection('dtext').sort())
  --<wd>feb2005
  --<kp>jan07
  !tsupports.appendarray(!lsupports)


  if (!tsupports.empty()) then
    !!alert.error('No Supports have been selected. Aborting Generation of the MDS ABA Drawings')
    !!mdsisrunning.delete()
    warnings on
    return
  endif

  !tmpl = '/' & !template
  !this.template = !tmpl.dbref()

  -- Set the Current Element - (Note: For ABA ReGenerate the !origin variable will NOT exist)
  !origin = !!ce

  -- Initialise ABA form 'abaprocess' to clear all the Gadgets
  !!abaProcess.init('NOSHOW')

  -- For the selected drawings see if a REVI element exists so we can reinstate it at the end
  !wasHere = !!ce
  !counter = 0
  !!putbackrevis = ARRAY()
  !!putbackscale = ARRAY()

  !!ts = !tsupports
  do !datalRevis values !tsupports
    !counter = !counter + 1
    !drwgName = !this.template.name + '-' + !datalRevis + '-AREA'
    !revnote = !drwgName + '/S1/Revisions'
    !!ce = !drwgName.dbref()
    handle NONE
      !!putbackrevis.append(!!ce.name)
      !members = !!ce.members
      do !datal value !members
        !!ce = !datal
        if !!ce.type.eq('REVI') then
          !!putbackrevis.append(!drwgName)
          !!putbackrevis.append('LAST MEM')
          !!putbackrevis.append(|NEW REVI | + !!ce.name)
          !!putbackrevis.append(|REVDATE  | + '|' + !!ce.revdate + '|' )
          !!putbackrevis.append(|APPDATE  | + '|' + !!ce.appdate + '|' )
          if !!ce.clrf.badref().not() then
            !!putbackrevis.append(|CLRF     | + '|' + !!ce.clrf.name + '|' )
          endif
          !!putbackrevis.append(|REVTIME  | + '|' + !!ce.revtime + '|' )
          !!putbackrevis.append(|RVSN     | + '|' + !!ce.rvsnumber + '|' )
          !!putbackrevis.append(|RVAU     | + '|' + !!ce.rvauthor + '|' )
          !!putbackrevis.append(|APPROVER | + '|' + !!ce.approver + '|' )
          !!putbackrevis.append(|STEX     | + '|' + !!ce.stex + '|' )
          !!putbackrevis.append(|STEX     | + '|' + !!ce.stex + '|' )
          !!putbackrevis.append(!revnote)
          -- Add code to regenerate the texp elements here
          !!ce = !revnote.dbref()
          !!putbackrevis.append('delete note mem')
          !texpMem = members
          do !resetmembers values !texpMem
            !!ce = !resetmembers
            if !!ce.type.eq('TEXP') then
              !pos = xypo of ptrf in sheet
              !xpos = !pos.east
              !ypos = !pos.north
              !text = btex
              !align = alignment
              !just = justification
              !chei = chei
              --------------------------------------------
              --<wd>11apr2008 - DUN824 - Defect No. P-4526
              -- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
              --!tpen = tpen
              !tpen = txcolour
              handle ANY
                !tpen = 6
              endhandle
              --<wd>11apr2008 - DUN824 - Defect No. P-4526
              --------------------------------------------
              !font = font
              !!putbackrevis.append('new texp')
              !!putbackrevis.append('AT X$!xpos Y$!ypos')
              !!putbackrevis.append('BTEX |$!text|')
              !!putbackrevis.append('ALIGN $!align')
              !!putbackrevis.append('JUST $!just')
              !!putbackrevis.append('CHEI $!chei')
              !!putbackrevis.append('TPEN $!tpen')
              !!putbackrevis.append('FONT $!font')
            endif
          enddo
          !!putbackrevis.append('UPDATE ANNO')
        endif
      enddo
      -- Store scale override values
      -- $P .......... do loop .......... for !!ts ARRAY of MDS supports ..........
      -- q var !counter
      !!putbackscale[$!counter][1] = name of shee 1 of $!drwgName
      !!putbackscale[$!counter][2] = :MdsScale of sheet 1 of $!drwgName
      handle ANY
        !!putbackscale[$!counter][2] = |0|
      endhandle

    elsehandle ANY
      --<wd>25mar2008 - DUN824 -- CODE modified to stop ERROR ... ARRAY element... does NOT exist
      -- MDS ABA DRWG name does NOT exist
      --
      --<wd>feb2005
      -- Added this CODE as an ERROR is sometimes raised in !!mdsabasheettask.pmlfnc that ARRAY element [2] does NOT exist
      !!putbackscale[$!counter][1] = name of shee 1 of $!drwgName
      handle ANY
        -- For a NEW MDS ABA DRWG the SHHET will NOT exist yet, so concatenate and set the SHEET name in the !!putbackscale variable
        !!putbackscale[$!counter][1] = !drwgName & '/S1'
        !!putbackscale[$!counter][2] = :MdsScale of sheet 1 of $!drwgName
        handle ANY
          !!putbackscale[$!counter][2] = |0|
        endhandle

      elsehandle NONE
        !!putbackscale[$!counter][2] = :MdsScale of sheet 1 of $!drwgName
        handle ANY
          !!putbackscale[$!counter][2] = |0|
        endhandle
      endhandle
      --      handle ANY
      --        !!putbackscale[$!counter][2] = |0|
      --      endhandle
      --<wd>25mar2008 - DUN824 -- CODE modified to stop ERROR ... ARRAY element... does NOT exist
      --
      --<wd>feb2005

    endhandle
  enddo

  -- q var !!putbackscale

  !!ce = !wasHere

  -- Check if the MDS ABA Registry Exists & the USER can write to it
  !error   = STRING()
  !element = '/' & !this.registry.selection()
  !type    = 'REGISTRY'
  !regixst = !this.check(!element,!type,!error)
  if (!regixst.not()) then
    !!alert.error(|ERROR - $!<error>|)
    !!ce = !origin
    !!mdsisrunning.delete()
    warnings on
    return
  endif

  -- Set the ABA DEFAULT Registry to an Existing User Registry for MDS in the ABA form 'abaprocess'
  !!abaProcess.creregname.val = !element
  !!abaProcess.reginame       = !element.dbref()
  !!abaProcess.useregname.val = !element
  !!abaProcess.action1.val    = 2

  -- ABA AREA library MUST now be a LIBY and not a DLLB -- however an IDLI<AREA element> can only exist below a DLLB
  -- Check if the MDS ABA Area Exists & the USER can write to it
  !error   = STRING()
  !element = !!abaDefaults.alib.val
  !type    = 'AREA Library'
  !areaxst = !this.check(!element,!type,!error)
  if (!areaxst.not()) then
    !!alert.error(|ERROR - $!<error>|)
    !!ce = !origin
    !!mdsisrunning.delete()
    warnings on
    return
  endif

  -- Set The ABA DEFAULT AREA Library for MDS in the ABA form 'abadefaults'
  !!abaDefaults.alib.val = !element

  -- Create and/or Modify the MDS ABA AREAS for the Selected MDS Supports
  !error = STRING()
  --$P------->>>>>>>>>>>>>>>>>>>>>>>>>>>>>
  --q var !supports !hsupports !asupports
  --$P------->>>>>>>>>>>>>>>>>>>>>>>>>>>>>

  -- Create areas for frameworks
  --<wd>jan2005 -- !this.areas(!supports,!error) will NOW collect ALL MDS GROUP MEMBERS with the MASTER GROUP STRUCTURE [1]
  !areas = !this.areas(!supports,!error)
  if (!error.set()) then
    !!alert.error(|ERROR - $!error Aborting Generation of the MDS ABA Drawings|)
    !!ce = !origin
    !!mdsisrunning.delete()
    warnings on
    return
  endif

  -- Create areas for hangers
  !areas.appendarray(!this.areas(!hsupports,!error))
  if (!error.set()) then
    !!alert.error(|ERROR -  $!error Aborting Generation of the MDS ABA Drawings|)
    !!ce = !origin
    !!mdsisrunning.delete()
    warnings on
    return
  endif

  --<wd>feb2005
  -- Create areas for ancillaries
  !areas.appendarray(!this.areas(!asupports,!error))
  if (!error.set()) then
    !!alert.error(|ERROR -  $!error Aborting Generation of the MDS ABA Drawings|)
    !!ce = !origin
    !!mdsisrunning.delete()
    warnings on
    return
  endif
  --<wd>feb2005

  --<kp>jan07
  -- Create areas for lighting supports
  !areas.appendarray(!this.areas(!lsupports,!error))
  if (!error.set()) then
    !!alert.error(|ERROR -  $!error Aborting Generation of the MDS ABA Drawings|)
    !!ce = !origin
    !!mdsisrunning.delete()
    warnings on
    return
  endif
  --<kp>jan07

  -- Set form member with the Required MDS ABA Areas
  !this.areas = !areas
  !!ce = !origin

  -- Generate a list of ABA Drawing Names ONLY from the Selections
  -------------------------------------------------
  --<wd>feb2005
  -- For MDS GROUPS and MDS FRAMEWORK STRUCTURES -- Use the DTEXT values of list gadget "this.frame"
  -- for "setting and/or getting "the "MDS ABA DRAWING NAMES"
  -- Therefore use the variable "!tsupports" instead of the !supports variable
  --!this.drwgList(!template,!supports,!hsupports)
  !this.drwgList(!template,!tsupports,!hsupports)
  --<wd>feb2005
  -------------------------------------------------

  if (!this.newdrwgs.empty() and !this.olddrwgs.empty()) then
    !!alert.error('ERROR - No Drawing Names have been generated. Aborting Generation of the MDS ABA Drawings')
    !!ce = !origin
    !!mdsisrunning.delete()
    warnings on
    return
  endif
  !!ce = !origin
  --  var !login login


  -- Check existing drawing if it exists for any user views
  -- Create temporary drwg(s) containing sheet and liby
  -- Include user view(s) and all external reference

  !origDrwg      = ARRAY()  $* ARRAY of drwg names originally holding user views and libraries
  !movedUserView = ARRAY()  $* ARRAY of ARRAYs of temporarily moved user views
  !movedLib      = ARRAY()  $* ARRAY of ARRAYs of temporarily moved libraries
  !tmpDrwg       = ARRAY()  $* reference ARRAY of temporary drwgs

  -- do loop for forming pdms names
  do !suppname values !tsupports
    !drwgName =  !this.template.name + '-' + !suppname + '-AREA'
    !sheetName = !drwgName + '/S1'
    --      !libyName =  !drwgName + '/LIBY'

    !!ce = !sheetName.dbref()
    handle ANY
      !!abaLogging.error(!!error.text + ' ' + !sheetName)
      skip
      -- this skip abandons the loop for this item
    endhandle

    var !allUserView collect all VIEW with sppurp eq 'USER' for $!sheetName
    skip if !allUserView.empty()

    !origDrwg.append(!!ce.owne.name)

    new DRWG
    !tmpDrwg.append(!!ce)

    new SHEE
    !tmpSheet = !!ce

    new LIBY
    !tmpLiby = !!ce

    !userviewrefArr = ARRAY()
    !librefarr = ARRAY()


    do !userView values !allUserView
      !!ce = !tmpSheet
      !userviewref = !userView.dbref()
      include $!userviewref
      !userviewrefArr.append(!userviewref)

      !!ce = !tmpLiby
      !dllb = !userviewref.name + '/IDLIST'
      !librefarr.append(!dllb.dbref())
      handle NONE
        include $!dllb
      elsehandle ANY
      endhandle
      !pllb = !userviewref.name + '/PLANES'
      !librefarr.append(!pllb.dbref())
      handle NONE
        include $!pllb
      elsehandle ANY
      endhandle
      !trlb = !userviewref.name + '/TAGLIB'
      !librefarr.append(!trlb.dbref())
      handle NONE
        include $!trlb
      elsehandle ANY
      endhandle
    enddo

    !movedUserView.append(!userviewrefArr)
    !movedLib.append(!librefarr)

  enddo
  -- end of loop for userviews

  -- <K.pleschner> April 2005
  -- store logical visibility of all views and layers before regenerations

  !allTask = ARRAY()    $* empty ARRAY for views with MDSABAVIEWTASK
  !viewsAndLayers = ARRAY() $* Store names of views and layers
  !visible = ARRAY()       $* Store their visibility
  !layerMembers = ARRAY() $* store layer members and their visibility

  do !suppname values !tsupports
    !drwgName =  !this.template.name + '-' + !suppname + '-AREA'
    !sheetName = !drwgName + '/S1'
    !sheetName.dbref()
    handle ANY
      skip
    endhandle

    var !allTask append collect all TASK with upcase(pmlfunc) eq 'MDSABAVIEWTASK' for $!sheetName

  enddo

  do !task values !allTask
    !storeview = !task.dbref().ownls[5]
    !viewsAndLayers.append(!storeview.name)
    !visible.append(!storeview.lvis)

    do !storelayer values !storeview.memb
      skip if !storelayer.type.neq('LAYE')
      !viewsAndLayers.append(!storelayer.name)
      !visible.append(!storelayer.lvis)
      do !storelayerMemb values !storelayer.memb
        !lvis = !storelayerMemb.lvis
        handle ANY
          skip
        endhandle
        skip if !storelayerMemb.ddnm.badref()
        !id = !storelayerMemb.namTyp
        !ddnm = !storelayerMemb.ddnm
        !layerMembers.append(!id & '  ' & !lvis & ' ' & !ddnm)
      enddo

    enddo
  enddo

  -- <K.pleschner> April 2005


  -- Generate the MDSSUPPORT Objects for each Support in the List
  !!mdsarray = !this.mdssupport()

  -- Update the Standard ABA forms as required

  -- update the forms
  !this.updtabaforms(!mode)

  -- Create the MDS ABA Process macro (an ABA BATCH macro to be run immediately in the current session)
  !this.mdsabamacro()

  -- Edit the Macro File
  --  !xmac = !this.macfile
  !this.editmacfile(!this.macfile,'macro')

  -- Run the Process macro now to Create and/or Update the Selected MDS ABA Drawings
  !this.run()

  --!!abaLogging.error('***********This is a TEST1')
  -- Put back an existing revision if they existed
  if !!putbackrevis.size().gt(0) then
    do !runrevis values !!putbackrevis
      $!runrevis
      handle ANY
      endhandle
    enddo
    !!putbackrevis.delete()
  endif

  -- Put back any user views that were saved before rerunning drawing
  do !c indices !origDrwg
    !oldDrwg = !origDrwg[!c]
    !!ce = SHEET 1 of $!oldDrwg
    do !movedView values !movedUserView[!c]
      include $!movedView after last view
      handle ANY
        include $!movedView
      endhandle


      -- update drawlist
      !!ce = !movedView.idln
      handle NONE
        update refs
        handle ANY
        endhandle
        delete null idli
        handle ANY
          !!abaLogging.error(!!error.text + ' ' + !!ce.namety)
        endhandle
      elsehandle ANY
      endhandle

      -- update user view
      !!ce = !movedView
      update refs
      handle ANY
      endhandle
      delete null anno
      handle ANY
        !!abaLogging.error(!!error.text + ' ' + !!ce.namety)
      endhandle
      delete null idli
      handle ANY
        !!abaLogging.error(!!error.text + ' ' + !!ce.namety)
      endhandle
      update design
      handle ANY
        !!abaLogging.error(!!error.text + ' ' + !!ce.namety)
      endhandle
      update anno
      handle ANY
        !!abaLogging.error(!!error.text + ' ' + !!ce.namety)
      endhandle
      update tagging
      handle ANY
        !!abaLogging.error(!!error.text + ' ' + !!ce.namety)
      endhandle

    enddo


    !!ce = LIBY 1 of $!oldDrwg
    do !lib values !movedLib[!c]
      include $!lib
    enddo
    !!ce = !tmpDrwg[!c]
    delete DRWG

  enddo


  -----------------------------------------------------
  -- <K.pleschner> April 2005
  -- restore logical visibility of all views and layers and their members

  do !c indices !viewsAndLayers

    !viewsAndLayers[!c].dbref().lvis = !visible[!c]
    handle ANY
    endhandle
  enddo

  do !layerInfo values !layerMembers
    !layerAtt = !layerInfo.split('  ')
    !layerAtt[1].dbref().lvis = !layerAtt[2].boolean()
    handle ANY
    endhandle
  enddo
  -- <K.pleschner> April 2005


  -- dtf >> Labels which are locked cause Draft to crash using 'modify mode'
  var !slabcoll coll all slab with lock eq TRUE for $!sheetName
  handle (2,109)
    --<GE> 18/12/06 Add temp handle
  endhandle
  do !iI values !slabcoll
    !iI.dbref().lock = FALSE
  enddo

  -- Return to the Original Element
  !!ce = !origin
  handle any
    -- Note: For ABA ReGenerate the !origin variable will NOT exist - so handle the error
  endhandle

  !!mdsisrunning.delete()
  warnings on

endmethod
-- End of method definition for .apply(REAL)

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .check(!element is STRING,!type is STRING,!error is STRING) is BOOLEAN

  !!ce = !element.dbref()
  handle any
    !error = 'The MDS ABA Drawing $!<type> ''$!<element>'' does NOT exist. Aborting Generation of the MDS ABA Drawings'
    return false
  elsehandle none
    -- Current DB name
    !dbname = DBname
    -- Current Session Data
    !session = current session
    !currdbs = !session.current()
    !dstatus = !session.status()
    -- Get the Name strings for every DB in the current MDB
    !block   = object BLOCK('!currdbs[!evalindex].name')
    !cdbnams = !currdbs.evaluate(!block)
    -- Find the Current DB and its Current Access Mode
    !dbfind  = !cdbnams.find(!dbname)
    if (!dstatus[!dbfind[1]].eq('RW')) then
      !mdsabareg = !element.dbref()
    else
      !error = 'You do NOT have WRITE access to the MDS ABA Drawing $!<type> ''$!<element>''. Aborting Generation of the MDS ABA Drawings'
      return false
    endif
  endhandle
  -- Check the Access of the Current DB and if the USER can CLAIM the MDS ABA $!type Hierarchy
  if (!currdbs[!dbfind[1]].access.eq('MULTIWRITE')) then
    if (!!mdsComClaimDac(!mdsabareg,'DACCRE','DRWG').not()) then
      !error = 'Unable to CLAIM the MDS ABA Drawing $!<type> ''$!<element>''. Aborting Generation of the MDS ABA Drawings'
      return false
    endif
  endif

  -- Return TRUE if everything OK
  return true

endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .mdssupport() is ARRAY

  -- Get the List of MDS supports and ABA Data
  --<wd>jan2005
  -- With the introduction of GROUPS - For the gadget "!this.frame" ONLY, get the "RTEXT" and NOT the "DTEXT"
  -- to obtain the database NAME for the "MASTER GROUP FRAMEWORK NAME", e.g. "PS1234[1]"
  --!supports = !this.frame.selection('dtext')
  !supports = !this.frame.selection('rtext')
  --<wd>jan2005
  !supports.appendarray(!this.hanger.selection('dtext'))
  -- !hsupports = !this.hanger.selection('dtext')
  --<wd>feb2005
  !supports.appendarray(!this.ancill.selection('dtext'))

  --<kp>jan07
  !supports.appendarray(!this.light.selection('dtext'))

  --$P+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
  --q var !supports

  !template = !this.templates.selection('dtext')
  -- !htemplate = !this.htemplates.selection('dtext')
  !tmpl     = '/' & !template
  -- !htmpl     = '/' & !htemplate

  --  Set Variables
  !origin   = !!ce
  !mdsarray = ARRAY()

  -- Build the Objects for Each MDS Support
  do !indx indices !supports
    !object         = object MDSABASUPPORT()
    !suppname       = '/' & !supports[!indx]
    !object.support = !suppname.dbref()

    -- Set the MDS Design Data for the Support
    !desData          = !object.mdsdata
    !desData.suppname = !suppname
    !!ce              = !suppname.dbref()
    --!desData.members  = !!mdsabasupportmem(!suppname.dbref())
    --<wd>feb2005 -- Set ".mdsgroup" to the Default Setting, i.e. an "INDIVIDUAL" MDS SUPPORT TYPE
    !desData.mdsgroup = FALSE


    ---------------------------------------------------------------------------------------------------
    --<wd>jan2005
    --************--
    --*** NOTE ***-- The EXISTING PML CODE for creating the MTO<"STEEL/HANGER components list"> for "INDIVIDUAL" MDS SUPPORTS
    --************-- uses either the "STRU" element for MDS FRAMEWORK STRUCTURE supports, OR the "CONNECTING MDS ATTA"
    --************-- for MDS HANGER supports.
    --************-- Therefore the SAME elements will be used for the creating of the MTO <"STEEL/HANGER components list"> etc...
    --************-- for "MDS GROUPS", i.e. ".mainGroupMem[1]" will always be the MASTER MDS STRU support and the other member, i.e.
    --************-- ".mainGroupMem[index]", will ALWAYS be the "CONNECTING MDS ATTA" for the other MDS GROUP -- MDS HANGER supports
    --************--

    -- Get the MAIN GROUP MEMBERS of the MDS Support for a NEW MDS Group
    if (!supports[!indx].match('[1]').gt(1) ) then
      -- Support Framework is the master FRAMEWORK STRUCTURE in a MDS GROUP
      -- Collect ALL MDS Group MAIN members, i.e. Master MDS STRU plus any additional MDS RESTRAINT "ATTAS"
      !groupname  = !suppname.before('[')
      !grouparray = ARRAY()
      !suppmem    = ARRAY()

      -- CHECK for a MAXIMUM of 30 MDS MAIN GROUP MEMBERS,i.e. Master MDS STRU plus any additional MDS RESTRAINT HANGER "ATTAS"
      do !gnum from 1 to 30
        if ((!gnum.eq(1)) and (!suppname.dbref().type.eq('STRU'))) then
          -- Master MDS GROUP FRAMEWORK "STRUCTURE" element
          !cename = !groupname + '[$!gnum]'
          !!ce    = !cename.dbref()
          --!grouparray[!indx] = !!ce
          !grouparray[!gnum] = !!ce

          -- Populate the MDSABASUPPORT object member ".members" with the MASTER MDS GROUP STRUCTURE,
          -- as if it were an "INDIVIDUAL" normal MDS FRAMEWORK STRUCTURE
          !desData.members  = !!mdsabasupportmem(!suppname.dbref())
        else
          -- Additional MDS GROUP RESTRAINT HANGER "ATTAS"
          !cename = !groupname + '[$!gnum]'
          !!ce    = !cename.dbref()
          handle ANY
            -- PDMS Restraint DOES NOT EXIST so SKIP
            skip
          elsehandle NONE
            -- PDMS Restraint EXISTS so add it to the GROUP ARRAY
            !grouparray[!gnum] = !!ce
          endhandle
        endif
      enddo

      -- Navigate to the Master MDS GROUP Framework Structure
      !!ce = !grouparray[1]

      -- Append the MDS Support ATTAS for EACH of the other MAIN MDS GROUP MEMBERS<MDS HANGERS>
      do !maincomp indices !grouparray
        !groupsuppmem = !!mdsabasupportmem(!grouparray[!maincomp])
        !suppmem.appendarray(!groupsuppmem)
      enddo
      !desData.mainGroupMem = !grouparray
      !desData.allGroupMem  = !suppmem
      !desData.mdsgroup     = TRUE
    else
      --<wd>jan2005
      -- ORIGINAL CODE -- Support is either an "INDIVIDUAL Stand-Alone" MDS HANGER or MDS FRAMEWORK STRUCTURE
      !!ce = !suppname.dbref()
      !desData.members  = !!mdsabasupportmem(!suppname.dbref())
      !desData.mdsgroup = FALSE
      --<wd>jan2005
    endif
    --<wd>jan2005


    -- If the support has a ancillary on a trunnion then find the height of the trunnion
    -- If it is more than 500mm use this to increase the volume instead.
    --!expandViewBy = 500
    !expandViewBy = !!supportDef.viewolap.real()
    handle ANY
      !expandViewBy = 500
    endhandle
    --<ge>Apr2005
    if !!supportDef.viewolap.real().unset() then
      !expandViewBy = 500
    endif
    --<ge>Apr2005
    do !loopThroughMembers values !desData.members
      if !loopThroughMembers.type.eq('ATTA') then
        if !loopThroughMembers.owner.:MdsTrun then
          !!ce = !loopThroughMembers.owner
          !trunLength = !!kStrReal('const dist ph to plane pt')
          if !trunLength.gt(!expandViewBy) then
            !expandViewBy = !trunLength
          endif
          same
        endif
      endif
    enddo

    --$P $!expandViewBy

    -- Enlarge MDS Support VOLUME by 500mm in every Direction e.g. 1000mm on existing VOLUME values
    --<wd>jan2005 -- get Volume for ALL Supports if it is a MDS GROUP
    --!desData.volume = object VOLUME(!desData.members)
    if (!desData.mdsgroup) then
      !desData.volume = object VOLUME(!desData.allGroupMem)
    else
      !desData.volume = object VOLUME(!desData.members)
    endif
    --<wd>jan2005
    !dist           = !expandViewBy
    !expVol         = !this.expVolume(!desData.volume,!dist)
    !desData.volume = !expVol

    -- Get the MDS Support DATUM Atta
    !datumname = !suppname & '/DATUM'
    !datum     = !datumname.dbref()
    handle (2,109)
      -- Undefined Name
      !!ce = !suppname.dbref()
      --<wd>feb2005 -- Additional Check to see if the ATTA CREF attribute is set
      --<kp>jan07
      if !!ce.type.eq('STRU') then
        -- Additional check if it is a MDS LIGHTING support
        if !!ce.:mdssupptype.eq(!!mdslsuppdefs.type) then
          !datum = !!ce
          !desData.supptype = 'STRU'
        endif
        --<kp>jan07        if (!!ce.cref.set()) then
      elseif (!!ce.cref.set()) then
        --<wd>feb2005
        if (!!ce.cref.type.eq('HANG')) then
          -- MDS HANGER Support type
          !desData.supptype = 'HANG'
          !datum = !suppname.dbref()
        endif
      elseif (!!ce.owner.:mdstrun) then
        -- MDS TRUNNION Branch Support -
        -- IMPORTANT NOTE:-
        --<The 'TRUN' check MUST Be AFTER the 'HANG' check above, as an HANGER may be attached to a TRUNNION>
        !desData.supptype = 'TRUN'
        !datum = !!ce.owner.href
      else
        -- MDS ATTA Only Support
        !desData.supptype = 'ATTA'
        !datum = !suppname.dbref()
      endif
    elsehandle none
      -- MDS Framework Support
      !desData.supptype = 'STRU'
    endhandle

    -- MDS Object Datum data
    !desData.datum = !datum
    !oDirection    = !!mdsabaorthdir(!datum)

    --################################################
    --################################################
    --################################################
    --------------------------------------------START
    --<wd>18feb2008-DUN824 - Defect No. P-4405
    --------------------------------------------

    --*********************************************************************************************
    -- HPD0033070 <GE> 25/09/06
    -- This tests for a vertical pipe angle of 89.9 via it's cosine
    -- angle of the Northing and Easting and assumes that it is
    -- vertical and resets the Easting and Northing correctly back
    -- too 0 as they have become a small exponential number
    -- i.e. EAST <REAL> 0.174000EX-01
    -- This then prevents it from passing any of the look tests
    if !oDirection[1].up.eq(1) or !oDirection[1].up.eq(-1) then
      if !oDirection[1].east.leq(0.001745) and !oDirection[1].east.geq(-0.001745)  then
        !oDirection[1].east = 0
      elseif !oDirection[1].north.leq(0.001745) and !oDirection[1].north.geq(-0.001745) then
        !oDirection[1].north = 0
      endif
    endif
    --*********************************************************************************************

    -- Returns something like - [1] N WRT /* and [2] S WRT /*
    !desData.datumOrthDir = !oDirection[1]
    !desData.datumOppDir  = !oDirection[2]
    !lookDownDir          = D WRT /*

    -- Initialise Variable for Reversed Main View Direction
    !reverse = FALSE

    --------------------------------------------
    --<wd>18feb2008-DUN824 - Defect No. P-4405
    --------------------------------------------
    -- Populate the !desData OBJECT, the !oDirection ARRAY and set the ABA VIEW variables !mainADeg and !planADeg
    !arrayData = !this.enuDirections(!desData, !oDirection)

    -- Loop Through the returned ARRAY !arrayData and set the Appropriate Variables
    do !rindx indices !arrayData
      -- The FIRST indices in the ARRAY always contains the !desData MDSDATA OBJECT
      if(!rindx.eq(1)) then
        !desData = !arrayData[1]
      elseif(!rindx.eq(2)) then
        -- The SECOND indices in the ARRAY always contains the !oDirection ARRAY
        !oDirection = !arrayData[2]
      elseif(!rindx.eq(3)) then
        -- The THIRD indices in the ARRAY always contains the ABA ADEG ARRAY
        do !aindx indices !arrayData[3]
          if (!aindx.eq(1)) then
            !mainADeg = !arrayData[3][1]
          elseif (!aindx.eq(2)) then
            !planADeg = !arrayData[3][2]

            --<wd>18dec2008 - Defect No. P-13975 -- NEW ADEG Value for the SIDE VIEW (DRTMPL default VIEW Direction is E or X wrt /*
            !sideadeg = !arrayData[3][3]

          endif
        enddo
      endif

    enddo
    -- Set the MDS Draft ABA Data for the Support
    !draData          = !object.abadata
    -- if !desData.supptype.eq('HANG') then
    -- !draData.template = !htmpl.dbref()
    -- else
    !draData.template   = !tmpl.dbref()
    -- endif
    -- !draData.htemplate = !htmpl.dbref()
    !draData.area         = !this.areas[!indx]
    !draData.mainviewadeg = !mainADeg
    !draData.planviewadeg = !planADeg

    --<wd>18dec2008 - Defect No. P-13975 -- NEW ADEG Value for the SIDE VIEW (DRTMPL default VIEW Direction is E or X wrt /*
    !draData.sideviewadeg = !sideadeg

    -- Build up the MDS ABA Drawing Name
    -- if !desData.supptype.eq('HANG') then
    -- !draData.drawing  = !htmpl & '-' & !this.areas[!indx].flnn
    -- else
    !draData.drawing  = !tmpl & '-' & !this.areas[!indx].flnn
    -- endif
    !draData.sheet    = !draData.drawing & '/S1'

    -- ONLY Get the MAIN MDS ABA 'DETAIL' Template Views, i.e. where the view task is set to "mdsabaviewtask"
    !taskname = 'mdsabaviewtask'
    var !coll collect all task where (pmlfunction eq |$!taskname|) for $!draData.template
    var !eval eval name of views for all from !coll
    !tviews = ARRAY()
    -- Build up the MDS ABA View Name strings from the Template Views found above
    !views = ARRAY()
    do !numb indices !eval
      !tviews.append(!eval[!numb].dbref())
      -- Get the View Suffix e.g. 'V4'
      !vnum  = !eval[!numb].after('/S1/')
      !vnam  = !draData.sheet & '/' & !vnum
      !views.append(!vnam)
    enddo
    !draData.tviews = !tviews
    !draData.views  = !views
    -- q var !tviews
    -- q var !views

    -- Get the Drawing Projection Required from the Selected ABA SHTMPL
    -- if !desData.supptype.eq('HANG') then
    -- !shtmplname = !htmpl & '/S1'
    -- else
    !shtmplname = !tmpl & '/S1'
    -- endif
    !projection = !shtmplname.dbref().:mdsabaoption.trim().split(',')
    ----------------------------------------------------------------------------------------------------
    --<wd>feb2007<mds12> -- TEMPORARY WORK AROUND for MDS12 ONLY *** ERROR *** Undefined UDA or undefined UDET at PDMS12 TEST14
    handle (99,532)  $* Undefined UDA or undefined UDET at PDMS12 TEST14
      --$P ***<wd>feb2007<mds12> *** TEMPORARY WORK AROUND for MDS12 ONLY ***
      --$P *** Line Number = 2283 in File Name  *** "C:\temp\Apps\pmllib12_0\design\objects\mdsabaselsupp.pmlfrm" **
      !xxce       = !!ce
      !xshtdbrf   = !shtmplname.dbref()
      !!ce        = !xshtdbrf
      --        q :mdsabaoption

      !projection = :mdsabaoption
      !projection = !projection.trim()
      !!ce        = !xxce
    endhandle
    --<wd>feb2007<mds12>
    ----------------------------------------------------------------------------------------------------

    if (!projection.objecttype().eq('STRING')) then
      if (!projection.trim().eq('')) then
        -- Default Projection
        !draData.projection = 'THIRD'
      else
        if (!projection.eq('1')) then
          !draData.projection = 'FIRST'
        elseif (!projection.eq('3')) then
          !draData.projection = 'THIRD'
        else
          -- Default Projection
          !draData.projection = 'THIRD'
        endif
      endif
    elseif (!projection.objecttype().eq('ARRAY')) then
      if (!projection.empty()) then
        -- Default Projection
        !draData.projection = 'THIRD'
      else
        if (!projection[1].eq('1')) then
          !draData.projection = 'FIRST'
        elseif (!projection[1].eq('3')) then
          !draData.projection = 'THIRD'
        else
          -- Default Projection
          !draData.projection = 'THIRD'
        endif
      endif
    endif



    -- Append Each MDS Support Object to the ARRAY
    !object.mdsdata = !desData
    !object.abadata = !draData
    !mdsarray.append(!object)
  enddo

  -- Set the Form Member ARRAY of MDS Support Objects
  !!ce = !origin
  !this.mdssupports = !mdsarray
  return !mdsarray

endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .areas(!supports is ARRAY, !error is STRING) is ARRAY

  -- Create and/or Modify the MDS ABA AREAS for the Selected MDS Supports
  !areas = ARRAY()
  do !indx indices !supports
    !suppname = '/' & !supports[!indx]
    --<wd>jan2005 -- In case !support[!indx] is a "master" GROUP MDS framework, i.e <iteration[1]> in the group, e.g. !pS1234[1]
    --!areaName = !suppname & '-AREA'
    !areaName = !suppname.before('[') & '-AREA'

    -- Get the Volume of the MDS Support
    --<wd>jan2005 -- or a NEW MDS Group
    if (!supports[!indx].match('[1]').gt(1) ) then
      -- Support Framework is the master FRAMEWORK STRUCTURE in a MDS GROUP
      -- Collect ALL MDS Group MAIN members, i.e. Master MDS STRU plus any additional MDS RESTRAINT "ATTAS"
      !groupname  = !suppname.before('[')
      !grouparray = ARRAY()
      !suppmem    = ARRAY()
      -- CHECK for a MAXIMUM of 30 MDS MAIN GROUP MEMBERS
      do !gnum from 1 to 30
        if ((!gnum.eq(1)) and (!suppname.dbref().type.eq('STRU'))) then
          -- Master MDS GROUP STRUCTURE
          !cename = !groupname + '[$!gnum]'
          !!ce    = !cename.dbref()
          --<wd>14oct2008 - DUN975 -- INCORRECT usage here of the indices [!indx] causing the MDS ABA DRWG View Scales to be sometimes incorrectly calculated.
          -- The problem ONLY occurred when more than ONE MDS GROUP support existed in the !supports array being processed here.
          -- Using the correct indices [!gnum], FIXES the problem
          --            !grouparray[!indx] = !!ce
          !grouparray[!gnum] = !!ce
          --<wd>14oct2008 - DUN975
        else
          -- Additional MDS GROUP RESTRAINTS "ATTAS"
          !cename = !groupname + '[$!gnum]'
          !!ce    = !cename.dbref()
          handle ANY
            -- PDMS Restraint DOES NOT EXIST
            skip
          elsehandle NONE
            -- PDMS Restraint EXISTS so add it to the GROUP ARRAY
            !grouparray[!gnum] = !!ce
          endhandle
        endif
      enddo
      -- Append the Support Members for EACH of the MAIN MDS GROUP MEMBERS
      do !maincomp indices !grouparray
        !groupsuppmem = !!mdsabasupportmem(!grouparray[!maincomp])
        !suppmem.appendarray(!groupsuppmem)
      enddo
      -- Form Members NOT now required <wd>feb2005
      -- NOW uses the "OBJECT MDSABASUPPORT .mainGroupMem and .allGroupMem" members
      --!this.mainGroupMem = !grouparray
      --!this.allGroupMem  = !suppmem
    else
      --<wd>jan2005
      -- ORIGINAL CODE -- Support is either an INDIVIDUAL MDS HANGER or MDS FRAMEWORK STRUCTURE
      !!ce = !suppname.dbref()
      !suppmem = !!mdsabasupportmem(!!ce)
      --<wd>jan2005
    endif
    --<wd>jan2005

    -- Get the Volume of the MDS Support/Group Members
    !volume   = object VOLUME(!suppmem)

    -- If the support has a ancillary on a trunnion then find the height of the trunnion
    -- If it is more than 500mm use this to increase the volume instead.
    --!expandViewBy = 500
    !expandViewBy = !!supportDef.viewolap.real()
    handle ANY
      !expandViewBy = 500
    endhandle
    --<ge>Apr2005
    if !!supportDef.viewolap.real().unset() then
      !expandViewBy = 500
    endif
    --<ge>Apr2005
    do !loopThroughMembers values !suppmem
      if !loopThroughMembers.type.eq('ATTA') then
        if !loopThroughMembers.owner.:MdsTrun then
          !!ce = !loopThroughMembers.owner
          !trunLength = !!kStrReal('const dist ph to plane pt')
          if !trunLength.gt(!expandViewBy) then
            !expandViewBy = !trunLength
          endif
          same
        endif
      endif
    enddo

    --      $P $!expandViewBy

    -- Enlarge VOLUME by 500mm in every Direction e.g. 1000mm on existing VOLUME values
    !dist   = !expandViewBy
    !expVol = !this.expVolume(!volume,!dist)
    -- Reset the VOLUME Object to the Expanded Volume
    !volume = !expVol
    !from   = !volume.from.string().before(' WRT')
    !to     = !volume.to.string().before(' WRT')
    -- Check if MDS ABA AREA exists, if it exists Modify the Limits, else Create a new IDLI
    !!ce = !areaName.dbref()
    handle (2,109)
      -- Undefined Name, therefore Create a NEW AREA - Navigate to the ABA AREA Default Library
      !!ce = !!abaDefaults.alib.val.dbref()

      -->>-<wd>aug2002
      -- Need to Access a MDS DLLB below this ABA Default AREA Library or Create a DLLB if one doesn't exist
      !libmem  = !!ce.mem
      !dllbmem = ARRAY()

      do !ndx indices !libmem
        skip if !libmem[!ndx].type.neq('DLLB')
        skip if !libmem[!ndx].function.upcase().trim().neq('MDS')
        !dllbmem.append(!libmem[!ndx])
      enddo

      -- Create a MDS AREA DLLB if required or Navigate to the first valid DLLB
      if (!dllbmem.empty()) then
        !sess  = current session
        --          !unqid = !sess.uniqueid
        --          !xce = !!ce
        !!ce = !!abaDefaults.alib.val.dbref()
        new dllb
        function 'MDS'
        sppurpose ABAR

        -- Name the new MDS ABA DLLB
        !count = 0
        --          do !num
        do
          if (!count.eq(0)) then
            !name = !!ce.owner.name & '-AREAS'
          else
            !name  = !!ce.owner.name & '-AREAS-' & !count
          endif
          !!ce.name = !name
          handle (41,12)
            -- Name already used
            !count = !count + 1
            skip
          elsehandle none
            break
          endhandle
        enddo
      else
        --  MDS ABA DLLB's exist - Select the First One in the List
        !!ce = !dllbmem[1]
      endif
      -- MDS ABA Support Areas (i.e. IDLI element) can Only be created below a DLLB element
      -- The ABA default AREA must now be a 'LIBY' element and NOT a 'LIBY or a DLLB' element
      -- MDS was using a DLLB during development!
      --<<-<wd>aug2002

      new idli $!areaName
      handle any
        !error = !!error.text
        return !areas
        break
      endhandle
      sppurp ABAR
      function 'MDS'

      -- **********************>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
      -- *** IMPORTANT NOTE ***
      -- **********************
      --<ak>-discussed-with-<wd>--28july2005--
      ------------------------------------------
      -- KBR problem using DM --
      -- AndyK has identified that setting the OWNER attributes here causes a problem in DM
      -- when KBR are kicking OFF TWO DM processes in close proximity time wise .
      -- ONLY ONE process can CLAIM the OWNER so it causes PDMS to error.
      -- The SAME error is also possible if a DM session has crashed out of PDMS and
      -- the DEAD USER still has the OWNER claimed.
      -- Andy is submitting a REMEDY call to Neale Morris to CHECK this out!!
      -- MOVE the settings ABOVE and OUT of the DO LOOP
      ---------------------------------------------------
      -- Discuss with ANDY KIRKLAND for more information
      ---------------------------------------------------
      -- <wd>-- 28 July 2005

      --<ak>-discussed-with-<wd>--28july2005--
      -- **********************<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<

    endhandle

    -- Set the AREA LIMITS to that of the Selected MDS Support Data
    limits $!from to $!to
    handle any
      --!error = !!error.text
      --<wd>aug2002
      -- Existing MDS ABA Area <IDLI> is NOT accessible?
      !owner = !!ce.owner.name
      !otype = !!ce.owner.type
      !error =  !!error.text & ' - Existing Area <IDLI element> $!!ce.name in $!otype $!owner -'
      --<wd>aug2002
      return !areas
      break
    endhandle
    -- Append Valid Areas to the ARRAY
    !areas.append(!areaName.dbref())
  enddo

  --Return an ARRAY of the MDS ABA Area Names
  return !areas

endmethod

