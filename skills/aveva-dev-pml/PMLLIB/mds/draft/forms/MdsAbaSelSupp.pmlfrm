define method .mdsabamacro()

  -- Set current MDB variable
  !sess = current session
  !mdb  = !sess.mdb().name

  -- Set the Global variable '!!computer'
  !!computer = !sess.host

  -- Initialise the ABA BATCH MODE form, but DO NOT SHOW it to the USER
  pml reload form !!abaBatchMode
  !!abaBatchMode.init()

  -- Set the ABA registry to use
  !!abaBatchMode.regi = !!abaProcess.reginame
  !!abaBatchMode.regi = !!abaProcess.reginame

  -- Create the MDS ABA Macro to Process the Selected ABA drawings IMMEDIATELY
  !!abaBatchMode.writebatmacro(!mdb)

  -- Store the  Log file and Macro File Names in the form members
  !this.logfile = !!abaBatchMode.log
  !this.macfile = !!abaBatchMode.mac

endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .mdsababatch()

  -- Switch ON the BATCH toggle on the 'abaprocess' form
  !!abaProcess.batch.val = true

  -- Set the ABA registry to use
  !!abaBatchMode.regi = !!abaProcess.reginame

  -- Initialise the ABA BATCH MODE form, but DO NOT SHOW it to the USER
  !!abaBatchMode.init()

  -- Create the MDS ABA Batch Files to Process the Selected ABA drawings LATER in a SEPARATE BATCH run
  !!abaBatchMode.writebatfile()

  -- Store the Log file and Macro File Names in the form members
  !this.logfile = !!abaBatchMode.log
  !this.batfile = !!abaBatchMode.bat
  !this.macfile = !!abaBatchMode.mac

endmethod

