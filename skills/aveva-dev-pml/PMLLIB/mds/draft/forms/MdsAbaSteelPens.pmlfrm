--
--
-- Description:
-- Form Definition for Selecting the MDS ABA View Task Label Pen Options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  framedata()                      -
--  gettmrf(STRING)                  DBREF
--  write()                          -
--
---------------------------------------------------------------------------------------------------------

-- Kill existing form definition
  kill !!mdsabasteelpens

-- Define Form
  setup form  !!mdsabasteelpens blocking

    !this.formtitle = |View Label Attributes|
    !this.icontitle = |MDSABAVSTLabs|
    !this.callback  = |!this.init()|

-- Main Frame
    frame .frame ' Label Pen Options ' width 20
      path down

-- Form Gadget Definitions
      frame .frame2 ' Label Frame & Line Options '
        option .shape 'Label Shape        ' at x1 ymax +0.3 callback '!this.framedata()' width 10
        toggle .llea 'Leader Line '
      exit

---------------------------------------------
--<wd>26mar2008 -- DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
--      text   .tpen at x1 ymax+0.5 'Text Pen            '  width 11 is REAL
--      text   .dtfn 'Text Font           ' width 11 is REAL
--      text   .llpn 'Leader Line Pen     ' width 11 is REAL
--      text   .frpn 'Text Box Pen        ' width 11 is REAL
--
--Set the Label Pen Attributes
      text   .lafo at x1 ymax+0.5 'Label Font         ' width 11 is REAL
      text   .laco                'Label Font Colour  ' width 11 is REAL
      text   .llst                'Leader Line Style  ' width 11 is STRING
      text   .llco                'Leader Line Colour ' width 11 is REAL
      text   .lfst                'Label Frame Style  ' width 11 is STRING
      text   .lfco                'Label Frame Colour ' width 11 is REAL
--      text   .tesi 'Terminator Size    ' callback '!this.framedata()' width 11 is REAL
      text   .tesi 'Terminator Size    ' callback '!this.framedata()' width 11 is REAL format !!distancefmt
--
--<wd>26mar2008 -- DUN824 - Defect No. P-4526
---------------------------------------------

      option .dterm at xmin ymax+0.5 'Terminators        ' width 10
    exit

-- Bottom Line
    button .cancel | Cancel | at xmax form-size ymax+0.5 cancel
    button .ok     |   OK   | at x0 ymin call |!this.write()| ok

-- Form members
    member .settings is STRING
    member .current  is REAL
    member .toggle   is BOOLEAN
    member .fram     is BOOLEAN
    member .tmrfname is STRING

  exit

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
--
-- Form Methods Defined Below Here...
--
---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .init()

-- Set the .dterm option dtext
    !dtext = ARRAY()
    !dtext[1] = 'Obliques'
    !dtext[2] = 'Arrows'
    !dtext[3] = 'Dots'
    !dtext[4] = 'Off'
    !this.dterm.dtext = !dtext

-- Set the .shape option dtext & rtext
   !dtext = ARRAY()
   !rtext = ARRAY()
   !dtext[1] = 'Box'
   !dtext[2] = 'Balloon'
   !dtext[3] = 'No Frame'
   !rtext[1] = '/MDS/ABA/TAGS/BOX'
   !rtext[2] = '/MDS/ABA/TAGS/CIRCLE'
   !rtext[3] = '/MDS/ABA/TAGS/NOBOX'
   !this.shape.dtext = !dtext
   !this.shape.rtext = !rtext

-- Get the Task Parameter Values into an array
    !values = !this.settings.split(',')

--------------------------------------------
--<wd>26mar2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
-- Set this Label Attibutes Form with the Stored Values at the View Task
--    !this.toggle     = !values[1].boolean()
--    !this.llea.val   = !values[2].boolean()
--    --!this.fram.val   = !values[3].boolean()
--    !this.tpen.val   = !values[4].real()
--    !this.dtfn.val   = !values[5].real()
--    !this.llpn.val   = !values[6].real()
--    !this.frpn.val   = !values[7].real()
--    !this.tesi.val   = !values[8].real()
--    !this.dterm.select('rtext',!values[9])
--    handle any
--    endhandle
--
-- Set this Label Attibutes Form with the Stored Values at the View Task
-- Steelwork Labels Toggle
    !this.toggle     = !values[1].boolean()

-- Steelwork Label Attributes
-- Label Leader Line Toggle
    !this.llea.val   = !values[2].boolean()

-- Original Code copied from above so --> !this.fram = !values[3] <-- is NOT FORGOTTEN about, and it is set below if required.
-- Label Shape was originally ONLY using the LFRAME attribute,
-- but Karel Pleschner introduced SYTM or TXTM for "Balloon" or "Box" Label Shapes(See Code Below)
    --!this.fram.val   = !values[3].boolean()

-- Label Font and Colour
    !this.lafo.val   = !values[4].real()
    !this.laco.val   = !values[5].real()

-- Label Leader Line Style and Colour
    !this.llst.val   = !values[6].string()
    !this.llco.val   = !values[7].real()

-- Labe Frame Line Style and Colour
    !this.lfst.val   = !values[8].string()
    !this.lfco.val   = !values[9].real()
    handle ANY
    endhandle

-- Label Leader Line Terminator Size and Type
    !this.tesi.val   = !values[10].real()
    handle ANY
    endhandle
    !this.dterm.select('rtext',!values[11])
    handle any
    endhandle
--
--<wd>26mar2008 - DUN824 - Defect No. P-4526
--------------------------------------------



-- Get the Symbol Template Reference Name
--------------------------------------------
--<wd>26mar2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
-- -- set param10 if undefined
--     if undefined(!values[10]) then
--        !values[10] = ''
--     endif
--     !tmrfname = !values[10]

-- Set Parameter No. 12 if undefined
    if undefined(!values[12]) then
      !values[12] = ''
    endif
    !tmrfname = !values[12]

-- Check if library symbol exists
    !tmrf = !this.gettmrf(!tmrfname)

    if !tmrf.badref() then
-- --unknown symbol name in "parameter 10"
-- Unknown symbol name now in "Parameter 12"
-- use parameter3 to set Shape gadget
      if !values[3].boolean() then
--
--<wd>26mar2008 - DUN824 - Defect No. P-4526
--------------------------------------------

        !this.shape.val = 1
        !this.fram = true
      else
        !this.shape.val = 3
        !this.fram = false
      endif
      !tmrfname = !this.shape.selection()
      !tmrf     = !this.gettmrf(!tmrfname)
    endif

-- now check if !tmrf is still badref
    if !tmrf.badref() then
      !tmrfname = ''
    else
      if !tmrf.type.eq('TXTM') then
        if !tmrf.lframe then
          !this.shape.val = 1
        else
           !this.shape.val = 3
        endif
        !this.fram = !tmrf.lframe

      else
        !this.shape.val = 2
        !this.fram = TRUE
      endif
      !tmrfname = !tmrf.name
    endif

    !this.tmrfname = !tmrfname

  endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .framedata()

  !tmrfname = !this.shape.selection()

  !tmrf = nulref
  !tmrf = !this.gettmrf(!tmrfname)
  if !tmrf.badref() then
    if !this.shape.val.eq(1) then
      !this.fram = TRUE
    elseif !this.shape.val.eq(3) then
      !this.fram = FALSE
    else
      !!alert.error('The "Balloon" option is not available - setting to "Box"')
      !this.fram = TRUE
      !this.shape.val = 1
      !tmrfname = !this.shape.selection()
      !tmrf = !this.gettmrf(!tmrfname)
    endif
  endif

  if !tmrf.badref() then
    !tmrfname = ''
  else
    if !tmrf.type.eq('TXTM') then
       !this.fram = !tmrf.lframe
    else
       !this.fram = TRUE
    endif
    !tmrfname = !tmrf.name
  endif

  !this.tmrfname = !tmrfname

endmethod


---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .gettmrf(!name is STRING) is DBREF

  !tmrf = nulref

  if !name.unset() then
     return !tmrf
  endif

  if !name.empty() then
     return !tmrf
  endif

  -- cut the character height suffix (if any) from name
  !heigsuff = !name.split('/').last()
  !unusedtest = !heigsuff.real()
  handle NONE
     !leng = (!heigsuff.length() + 2 ) * -1
     !name = !name.substring(!leng)
  elsehandle ANY
  endhandle

  -- check if symbol exists
  !tmrf = !name.dbref()
  handle ANY
    -- append rounded character height to name and try it again
    !chei = !this.tesi.val
    if !chei.lt(1) then
    -- assumed to be in imperial units

      if (!!isImperialLength('DIST')) then
        !chei = $!chei inch
      else
        !fmt = object FORMAT()
        !fmt.units = 'MM'
        !fmt.dimension = 'L'
        !chei = !chei.string(!fmt).real()
      endif
    endif

    -- round off value
    !cheiint = !chei.int()
    !rest = !chei - !cheiint
    if !rest.lt(0.25) then
      !chei = !cheiint
    elseif !rest.geq(0.25).and(!rest.lt(0.75)) then
      !chei = !cheiint + 0.5
    else
      !chei = !cheiint + 1
    endif

    !name = !name + '/' & !chei.value()
    -- check symbol existence again
    !tmrf = !name.dbref()
    handle ANY
    endhandle
  endhandle

  if !tmrf.badref().not() then
   if !tmrf.type.eq('SYTM').or(!tmrf.type.eq('TXTM')).not() then
      !tmrf = nulref
    endif
  endif

  return !tmrf

endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

define method .write()

--------------------------------------------
--<wd>26mar2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
-- -- Compose the Task TPVAL attribute values
--  !return = !this.toggle.string() & ',' & !this.llea.val & ',' & !this.fram & ',' & !this.tpen.val & ','  $
--  & !this.dtfn.val & ',' & !this.llpn.val & ',' & !this.frpn.val & ',' & $
--  !this.tesi.val & ',' & !this.dterm.selection() & ',' & !this.tmrfname

-- Compose the Task TPVAL attribute values
  !return = !this.toggle.string() & ',' & !this.llea.val & ',' & !this.fram & ',' & !this.lafo.val & ','  $
  & !this.laco.val & ',' & !this.llst.val & ',' & !this.llco.val & ',' & !this.lfst.val  & ',' & $
  !this.lfco.val & ',' & !this.tesi.val & ',' & !this.dterm.selection() & ',' & !this.tmrfname
--
--<wd>26mar2008 - DUN824 - Defect No. P-4526
--------------------------------------------

-- Store the Task TPVAL values in the main task form member '.subtasks'
  !!mdsabaviewtask.subtasks[!this.current] = !return

endmethod

