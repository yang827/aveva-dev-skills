-- Kill existing form definition
Kill !!mdsabasupdefs

-- Define Form
Setup Form  !!mdsabasupdefs

  !!mdsabasupdefs.formtitle    = |MDS AB ADP Defaults|
  !!mdsabasupdefs.icontitle    = |DFLTS|
  !!mdsabasupdefs.callback     = ||
  !!mdsabasupdefs.formrevision = | $Revision:$ |

-- Body of Form
    path down
    vdist 0.5

--<wd>mar2007<mds12>
-- Several FORM Gadgets NOT REQUIRED for MDS12 ABA DRAFT Application Options
-- Some FORM Gadgets are REDUNDANT when using MDS ABA DRAFT and Some FORM
-- Gadgets have been REPLACED by the EXISTING MDS DESIGN Application Options
--
--<wd>mar2007<mds12>-->--REDUNDANT--    option .isodir   'Isometric View Direction ' callback |!!supportdef.isometric = _isodir.selection()| at x0 ymax0.5 width 3
--<wd>mar2007<mds12>-->--REDUNDANT--    text   .sitetrim 'Site Trim Allowance      ' callback '!!mdsabadfltaction(|SITETRIM|)' width 14 ISOU
--<wd>mar2007<mds12>-->--Use MDS DESIGN Option--    para   .punitstext text 'Weight Units per Metre   '
--<wd>mar2007<mds12>-->--Use MDS DESIGN Option--    para   .unitstext at xmax ymin width 14 lines 1

--<wd>mar2007<mds12>-->--REDUNDANT--    para   .pswcm at x0 ymax+0.5 text     'Weight per Cubic M       '
--<wd>mar2007<mds12>-->--REDUNDANT--    para   .swcm at xmax ymin width 14 lines 1

--<wd>mar2007<mds12>-->--Use MDS DESIGN Option--    para   .ptranpref at x0 ymax+0.5 text 'Transportation Prefix    '
--<wd>mar2007<mds12>-->--Use MDS DESIGN Option--    para   .tranpref at xmax ymin width 14 lines 1

--<wd>mar2007<mds12>-->--Use MDS DESIGN Option--    para   .ptrantext at x0 ymax+0.5 text 'Transportation Text      '
--<wd>mar2007<mds12>-->--Use MDS DESIGN Option--    para   .trantext at xmax ymin width 14 lines 2
--<wd>mar2007<mds12>-->
--<wd>mar2007<mds12>-->    -- para   .PShoeTab at x0 ymax text 'Shoes/Guides Tabulated   '
--<wd>mar2007<mds12>-->    -- para   .ShoeTab at xmax ymin width 14 lines 2
--<wd>mar2007<mds12>-->
--<wd>mar2007<mds12>-->--REDUNDANT--    para   .pdrwgno at x0 ymax text 'MDS ADP Drawing Number   '
--<wd>mar2007<mds12>-->--REDUNDANT--    para   .drwgno at xmax ymin width 14 lines 2

--<wd>mar2007<mds12>-->--REDUNDANT--    para   .pgridmatrix at x0 ymax text 'MDS ADP Grid Matrix      '
--<wd>mar2007<mds12>-->--REDUNDANT--    para   .gridmatrix at xmax ymin width 14 lines 2

    para   .pviewolap at x0 ymax0.5 text 'MDS AB ADP View Overlap = '
    para   .viewolap at xmax ymin width 14 lines 1

--<wd>mar2007<mds12>-->    -- bottom line
--<wd>mar2007<mds12>-->    button .default 'Default'  at x0 ymax+0.1 callback '!!mdsabadfltaction(|Default|)'

    button .dismiss | Dismiss | at xmax form-size ymax+0.1 Ok

-- End form definition
exit

--<wd>mar2007<mds12>-->--REDUNDANT---- set the iso dir options
--<wd>mar2007<mds12>-->--REDUNDANT--!dtext = ARRAY()
--<wd>mar2007<mds12>-->--REDUNDANT--!rtext = ARRAY()
--<wd>mar2007<mds12>-->--REDUNDANT--!dtext = split('1 2 3 4 OFF')
--<wd>mar2007<mds12>-->--REDUNDANT--!rtext = split('1 2 3 4 OFF')
--<wd>mar2007<mds12>-->--REDUNDANT--!!mdsabasupdefs.isodir.dtext = !dtext
--<wd>mar2007<mds12>-->--REDUNDANT--!!mdsabasupdefs.isodir.rtext = !rtext
--<wd>mar2007<mds12>-->--REDUNDANT--!!mdsabadfltaction(|Default|)

-- End of file mdsabasupdefs.pmlfrm
