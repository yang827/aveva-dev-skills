-- Created:             04/04/2005 11:43
--
--
-- Description:
-- Form Definition for Selecting the MDS Symbols
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  MdsAbaSymbols()                  -
--
---------------------------------------------------------------------------------------------------------

-- Kill existing form definition
kill !!mdsabasymbols

-- Define Form
setup form  !!mdsabasymbols

  option .SymbType at x 0.5 y 0.2 callback '!This.SymbType()' width 23

  view .View at xmin ymax+0.2 AREA
    heigh 10 width 62
  exit

  paragraph .Prompt at xmin ymax+0.3 width 64

  text .Scale  'Scale  ' at xmin ymax width 5 is REAL
  text .Rotate 'Rotate ' at xmin ymax width 5 is REAL
  button .Place 'Place' at xmax+1 ymin callback '!This.Place()' APPLY
  button .CloudRev pixmap width 32 height 32 at xmax+2 ymax-size callback '!This.CloudRev()'
  button .TriangleRev pixmap width 32 height 32 at xmax ymin callback '!This.TriangleRev()'
  text .RevText 'Rev' at xmax+0.5 ymin width 2 is STRING

  button .Dismiss 'Dismiss' at xmax form-size ymin.Place OK

-- Form members

  exit

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
--
-- Form Methods Defined Below Here...
--
---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
define method .MdsAbaSymbols()


  !Dtext[1] = 'Coordinate Symbols (1)'
  !Dtext[2] = 'Coordinate Symbols (2)'
  !Dtext[3] = 'Coordinate Symbols (3)'
  !Dtext[4] = 'Anchorage Symbols (1)'
  !Dtext[5] = 'Anchorage Symbols (2)'
  !Dtext[6] = 'Anchorage Symbols (3)'
  !This.SymbType.Dtext = !Dtext

  !this.formtitle = 'MDS Symbols'
  !this.Initcall = '!This.Init()'
  !this.view.borders = false

  !this.scale.val = 1.4
  !this.Rotate.val = 0

  !Cloud = !!Pml.GetPathName('revcloud32.png')
  !Triangle = !!Pml.GetPathName('revtriangle32.png')
  !this.CloudRev.AddPixmap(!Cloud)
  !this.TriangleRev.AddPixmap(!Triangle)
  !this.revtext.val = 'A'


  endmethod


---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .init()


   !This.View.Active = false

    edit view !!mdsabasymbols.view AREA put /FANP-Symbols-Applic
      handle ANY
        return error 1 'Required symbols do not exist in library - contact your system administrator!'
      endhandle

   !This.SymbType()
   !this.Prompt.Val = ''

  endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .SymbType()

    !Selection = !this.SymbType.Val
    if !Selection.leq(3) then
       !Rect = rect 1 of /FANP-Symbols-Applic/Coord-Frame-$!Selection
    else
       !Selection = !Selection - 3
       !Rect = rect 1 of /FANP-Symbols-Applic/Anch-Frame-$!Selection
    endif

    !Limit[1] = !Rect.Ptrf.Xypo.East
    !Limit[2] = !Rect.Ptrf.Xypo.North
    !Limit[3] = !Rect.Xlen + !Rect.Ptrf.Xypo.East
    !Limit[4] = !Rect.Ylen + !Rect.Ptrf.Xypo.North

    !This.View.Limits = !Limit


  endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .Place()


  !OldCE = !!CE

  !Scale = !This.Scale.Val
    if !Scale.Unset() then
       !This.Scale.Val = 1
       !Scale = 1
    endif

  !Adeg = !This.Rotate.Val
    if !Adeg.Unset() then
       !This.Rotate.Val = 0
       !Adeg = 0
    endif

  view
    handle ANY
      !!Alert.Error('Cannot locate view to add symbols to')
      return
    endhandle

  drwg
  if !!ce.function.neq('MDS') then
    !!Alert.Error('Selected drawing is not an MDS drawings')
    return
  endif

  same

--  var !View collect all VIEW with sppurp eq 'USER' for $!Sheet
  --   handle ANY
    --   return error 1 '$!!Error.Text'
    -- endhandle

  --if !View.Unset() then
    -- !!Alert.Error('Sheet $!Sheet does not contain MDS User View')
    -- !!Fmsys.Refresh()
    -- return
  --endif

  !ViewRef = !!ce
  !Layer = object DBREF(!ViewRef.Name + '/USER_Labs')

  if !this.symbType.Val.leq(3) then
     !ActionType = 'COORD'
     !Prompt = 'Identify Ancillary or Hanger'
     !Type = 'ATTA HANG'
  else
     !ActionType = 'ANCHOR'
     !Prompt = 'Identify Anchorage Plate or Section/Hanger connected to Anchorage Plate'
     --!type = 'SBFI HANG SCTN'
     !type = 'FIXING SBFI HANG SCTN'
  endif

  !this.Prompt('Identify library symbol required')
  !this.view.active = true
  !Tmrf = ref of ID SYTM@
     handle ANY
       !This.View.Active = FALSE
       !this.Prompt('')
       return
     endhandle

  !This.view.Active = false
  !this.Prompt('')

  -- loop
  !!CE = !Layer
  do
  !this.prompt(!Prompt)
  !Ddnm = ref of ID $!Type@
     handle ANY
       !this.Prompt('')
       break
     endhandle
     !this.Prompt('')

     if !ActionType.eq('COORD') then
        if !Ddnm.Type.eq('HANG') then
           !Ddnm = object DBREF('/' + !Ddnm.Name.Part(2,'/'))
        endif
     else
        if !Ddnm.Type.neq('SBFI') and !Ddnm.Type.neq('FIXING') then
           skip if undefined(!Ddnm.:MDSAncRef[1])
           skip if !Ddnm.:MDSAncRef[1].Badref()
           --skip if !Ddnm.:MDSAncRef[1].Type.neq('SBFI')
           skip if !Ddnm.:MDSAncRef[1].Type.neq('SBFI') and !Ddnm.:MDSAncRef[1].Type.neq('FIXING')
           !Ddnm = !Ddnm.:MDSAncRef[1]
        endif
     endif



  prompt load escape 'Position the Symbol with the cursor'
  var !Xypo shpos@
     handle ANY
       skip
     endhandle

     new SLAB
     xyscale $!Scale $!Scale
     adeg $!Adeg
     llead false
     !!CE.Ddnm = !Ddnm
     !!CE.tmrf = !Tmrf
     xypo $!Xypo

  enddo

  !!CE = !OldCE

  endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .CloudRev()

-- get view reference
      !View = !this.GetView('Pick VIEW where you want to place cloud')
         if !View.Unset() then
            return
         endif

-- jump to user layer
      !!CE = object DBREF(!View.Name + '/USER_Notes')
          handle ANY
            return error 1 'This VIEW does not contain the layer for user notes'
          endhandle

-- creaet VNOTe and OUTLine
       new VNOT
       -- added this line so that the revision cloud does not obscure any model detail
       -- RM 07/09/06
       blnk FALSE
       !Vnot = !!CE
       new OUTL
       !Outl = !!CE
-- create vertices
       do
         new VRTX bulge 0.85
         def@
         handle ANY
           delete VRTX
           break
         endhandle
       enddo

-- delete vnote if there is less then 2 vertices
       if !Outl.Memb.Size().lt(2) then
          !!CE = !Vnot
          delete VNOT
          return
       endif

-- close outline if opened

       if !Outl.Memb.Last().Ptrf.neq(!Outl.Memb[1].Ptrf) then
          new VRTX bulge 0.85
          at ptrf of VRTX 1
       endif

       !!CE = !Vnot

  endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .TriangleRev()

     !Layer = LAYER
        handle ANY
           !this.Prompt('Pick VIEW or LAYER where you want to place symbol')
           !Layer = ref of id LAYE VIEW@
              handle ANY
                !this.Prompt('')
                return
              endhandle
              !this.Prompt('')
        endhandle

     if !Layer.Type.eq('LAYE') then
        if !Layer.Name.Split('/').Last().neq('USER_Notes') then
           !!Alert.Error('Layer is not suitable for user notes')
           return
        endif
     else
        !Layer = object DBREF(!Layer.Name + '/USER_Notes')
           handle ANY
              !!Alert.Error('This VIEW does not contain the layer for user notes')
              return
           endhandle
     endif

     !!CE = !Layer
     !Tmrf = /MDS/ABA/TAGS/REVTRIANGLE
     !Support = object DBREF(!Layer.Owne.Owne.Darref.Name.Before('-AREA'))

     prompt off
     prompt load escape 'Input position of the symbol'
     var !Xypo shpos@
         handle ANY
            return
         endhandle

     new SLAB
     !!ce.ATEX = !this.RevText.val
     !!CE.llead = FALSE
     !!CE.Ddnm = !Support
     !!CE.tmrf = !tmrf
     blnk FALSE
     end
     blnk FALSE
     same
     at $!xypo

  endmethod


---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .GetView(!Prompt is STRING) is DBREF

       !View = view
          handle ANY
            !this.Prompt(!Prompt)
            !View = ref of id VIEW@
               handle ANY
                  !View = nulref
               endhandle
            !this.Prompt('')
          endhandle

       return !View

  endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------


  define method .Prompt(!Prompt is STRING)

     if !Prompt.Empty() then
        !this.Prompt.Val = ''
        !this.prompt.background = !this.background
        return
     endif

     prompt off
     prompt load escape '$!Prompt'
     !this.prompt.background = 'white'
     !this.Prompt.Val = !Prompt

  endmethod
