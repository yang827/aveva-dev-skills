--
-- File: MdsAbaTitleBlock.pmlfrm
--   Type: Form Definition
--   Group:
--     Keyword:
--   Module:
--   Replaces:
--
-- Author: Martin Wright
-- Created: 11 June 2002
--
--
-- Description: Modify arrange function parameters
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  calcWeight(STRING)               STRING
--  closed()                         -
--  init()                           -
--  setXYpos(STRING,STRING)          -
--
------------------------------------------------------------------------

setup form !!mdsAbaTitleBlock
  title |Choose options|
  init |!this.init()|

  -- Define Members/Selection Areas

  path down
  hdist 1.25
  frame .options | Weight Data | at x0
    path right
    button .xypos1 at y 1 'Position' pixmap height 16 width 30 call |!this.setXYpos('param1','param2')|
    text .param1 'X '           width 6 is STRING
    text .param2 'Y '           width 6 is STRING
    text .param3 'Text Size '   width 3 is STRING
    text .param4 'Line Style '   width 3 is STRING
  exit
  path down

  frame .options2 | View Scale | at x0
    button .xypos2 at y 1 'Position' pixmap height 16 width 30 call |!this.setXYpos('param5','param6')|
    path right
    text .param5 'X '          width 6 is STRING
    text .param6 'Y '          width 6 is STRING
    text .param7 'Text Size '  width 3 is STRING
    text .param8 'Line Style ' width 3 is STRING
  exit

  path down
  frame .options3 | Drawing Name | at x0
    button .xypos3 at y 1 'Position' pixmap height 16 width 30 call |!this.setXYpos('param10','param11')|
    path right
    text .param9 'Rule ' width 10 is STRING
    text .param10 'X '          width 6 is STRING
    text .param11 'Y '          width 6 is STRING
    text .param12 'Size '  width 3 is STRING
    text .param13 'Style ' width 3 is STRING
  exit

  path down
  frame .options4 | Title Data | at x0
    path right
    button .xypos4 at y 1 'Position' pixmap height 16 width 30 call |!this.setXYpos('param15','param16')|
    text .param14 'Rule ' width 10 is STRING
    text .param15 'X '          width 6 is STRING
    text .param16 'Y '          width 6 is STRING
    text .param17 'Size '  width 3 is STRING
    text .param18 'Style ' width 3 is STRING
  exit
  path down

  -- Action buttons

  hdist 1.25
  button .ok     |  OK  | at x0                     call |!this.apply()| ok
  button .cancel |Cancel| at xmax form-size ymin.ok call |!this.closed()| cancel

  -- Pixmaps

  !this.xypos1.addPixmap(  !!pml.getPathName('xyz16.png'),  !!pml.getPathName('xyz16.png'),'')
  !this.xypos2.addPixmap(  !!pml.getPathName('xyz16.png'),  !!pml.getPathName('xyz16.png'),'')
  !this.xypos3.addPixmap(  !!pml.getPathName('xyz16.png'),  !!pml.getPathName('xyz16.png'),'')
  !this.xypos4.addPixmap(  !!pml.getPathName('xyz16.png'),  !!pml.getPathName('xyz16.png'),'')

  -- Members

  member .taskName       is STRING
  member .taskParams     is ARRAY

  member .task     is ABATASK
  member .form     is FORM

exit

----------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Called when form is shown
--
----------------------------------------------------------------------
define method .init()

  -- Initialise variables
  !ce = !!ce

  -- Make sure we are at the SHTMPL ready to go, just in case user has moved in the
  -- hierarchy.
  !!ce = !!abatemplatesht.shtmpl
  handle (2,751)
    -- Probably means that the form is just being initialised.
  endhandle

  -- Set form title
  !this.formTitle = !this.task.description
  handle (2,751)
    -- Probably means that the form is just being initialised.
  endhandle

  -- Hold name of task
  !this.taskName =  !this.task.name
  handle (2,751)
    -- Probably means that the form is just being initialised.
  endhandle

  !parNum = 0
  -- Load text boxes with current settings for parameter values.
  do !param index !this.task.paramval
    !args = !this.task.paramval[!param].split(',')
    do !arg value !args
      !parNum = !parNum + 1
      !command = |!this.param| & !parNum & '.val = |' & !arg & '|'
      $!command
    enddo
  enddo

  -- Return to hierarchy position
  !!ce = !ce
endmethod

----------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Called when apply is pressed
--
----------------------------------------------------------------------
define method .apply()

  -- Initialise variables
  !ce = !!ce

  -- Build parameters array
  !parameters[1] = !this.param1.val  & ',' & !this.param2.val  & ',' & !this.param3.val  & ',' & !this.param4.val
  !parameters[2] = !this.param5.val  & ',' & !this.param6.val  & ',' & !this.param7.val  & ',' & !this.param8.val
  !parameters[3] = !this.param9.val  & ',' & !this.param10.val & ',' & !this.param11.val & ',' & !this.param12.val & ',' & !this.param13.val
  !parameters[4] = !this.param14.val & ',' & !this.param15.val & ',' & !this.param16.val & ',' & !this.param17.val & ',' & !this.param18.val

  -- Reset the task object
  !this.task.paramval = !parameters

  -- Transfer the modified task back to the calling form
  !this.form.receiveTask(!this.task)

  -- Delete feed back drawing
  !this.closed()

  -- Return to hierarchy position
  !!ce = !ce
  handle (2,822)
  endhandle

  -- Set calling form apply button active
  !!abatemplatesht.ok.active = true

endmethod

----------------------------------------------------------------------
--
-- Method:      setXYpos
--
-- Description: Set xy position
--
----------------------------------------------------------------------
define method .setXYpos(!xValue is STRING, !yValue is STRING)

  !save = !!ce
  prec 1 dp
  -- Description:
  SHTMPL
  NEW NOTE
  NEW TEXP
  XYPOS @
  handle (61,528)
  endhandle
  var !xy split ORIGIN

  !command = |!this.| & !xValue & '.val = |' & !xy[2] & '|'
  $!command
  !command = |!this.| & !yValue & '.val = |' & !xy[4] & '|'
  $!command

  NOTE
  DELETE NOTE

  !!ce = !save
  prec var def
endmethod

----------------------------------------------------------------------
--
-- Method:      closed
--
-- Description: Called when form is closed
--
----------------------------------------------------------------------
define method .closed()

  -- Hide this form
  !this.hide()

endmethod

----------------------------------------------------------------------
--
-- Method:      calcWeight
--
-- Description: Called to Calculate the weight of the support steelwork or hanger contents
--
----------------------------------------------------------------------
define method .calcWeight(!supName is STRING) is STRING

  -- MDS Weight unit not loaded, load it from the !!mdsFiles.description file pointer
  if (undefined(!!mdsWeiUnit)) then
    !descLines = !!readPdmsFile('/' + !!mdsFiles.description.string())
    do !find values !descLines
      if (!find.upcase().match('MDSWEIUNIT').eq(1)) then
        !splitLine = !find.split('\')
        !!mdsWeiUnit = !splitLine[2].trim()
        break
      endif
    enddo
    do !find values !descLines
      if (!find.upcase().match('MDSWEITAG').eq(1)) then
        !splitLine = !find.split('\')
        !!mdsweitag = !splitLine[2].trim()
        break
      endif
    enddo
  endif

  -- Determine the <MDSABASUPPORT> OBJECT for the current MDS GROUP, FRAMEWORK or HANGER
  !mdsObject = !!mdsAbasuppobj(!supName.dbref())

  if (!supName.dbref().type.eq('STRU')) then
    -- MDS Framework Structure Support
    !nWei = 0
    var !list COLL ALL FOR $!supName

    do !elem value !list

      --------------------------------------------
      -- Current element does NOT have the NWEI attribute or the pseudo attribute cannot be evaluated,
      -- e.g.. a SCTN matref attribute is unset
      -- ********************
      -- ** IMPORTANT NOTE **
      -- ********************
      -- At PDMS11.6 NWEI use to be output as 0 for these type of elements
      -- e.g. STRU, FRMW, SUBS. BOX, CYLI etc... so they were simple to process, i.e. add the 0 value,
      -- but at PDMS12 NWEI is output differently.
      -- Therefore EMULATE PDMS11.6 here in the 12 versions of AVEVA MARIME and PLANT
      -- by setting the variable !WEI = 0
      -- ONLY process the "real" elements that have there own VOLUMETRIC GEOMETRY,
      -- e,g. SCTN, PJOI, FITT, CYLI, BOX etc... and NOT the STRU, FRMW, PNOD etc...
      -- ### NOTE ###
      -- The SJOI and FITT elements always belong to a SCTN so they are NOT processed individually,
      -- as they would be processed twice, first as a member of the SCTN and second as a SJOI/FITT on its own
      --
      -- The Weight of a PNOD needs to be skipped
      -- to avoid adding the weight of the PJOI twice
      -- However the PJOI itself does NOT need to be skipped.
      if (!elem.dbref().type inset ('STRU', 'FRMW', 'SUBS', 'SNOD', 'SJOI', 'FITT', 'PNOD', 'SBFR' )) then

        skip
      endif

      !wei = NWEI of $!elem
      handle (2,222)
        -- Weight for implied tube error.
        skip

      elsehandle (2,201)
        -- This ERROR is probably raised because the matref is unset or it doesn't exist at $!elem
        -- Set the variable !wei to ZERO, so it will processed below using the NVOL calculation etc...
        !wei = 0

        -- Error (2,827) - Object PJOINT <name> owns component PJOINT <name> which has geometric volume, but no weight can be determined
      elsehandle (2,827)
        -- This ERROR is probably raised because the matref is unset or it doesn't exist at $!elem
        -- Set the variable !wei to ZERO, so it will processed below using the NVOL calculation etc...
        !wei = 0
      endhandle

      !matRef = density of sden 1 of tden 1 of matref of $!elem
      handle ANY
        !matRef = density of sden 1 of tden 1 of :mdsMatref of $!elem
        handle ANY
          !matRef = 7850kg/m3
        endhandle
      endhandle

      if (!wei.eq(0)) then

        !nvol = NVOL OF $!elem
        !wei = (!nvol.real() * !matRef)

      endif

      !nWei = !nWei + !wei

    enddo

    if (!mdsObject.mdsData.mdsGroup) then
      -- MDS Hanger Supports in a MDS GROUP
      !hWei = 0
      do !attaName values !mdsObject.mdsData.mainGroupMem
        skip if (!attaName.type.eq('STRU'))
        if ((!attaName.type.eq('ATTA')) and (!attaName.cref.badref().not())) then
          if (!attaName.cref.type.eq('HANG')) then
            if (!!mdsHangIf.upcase().eq('MDS')) then
              !tWei = !!mdsAbaHangWeight(!attaName)
              !hWei = !hWei + !tWei[!tWei.size()]

            elseif (!!mdsHangIf.upcase().eq('LISEGA')) then
              !tWei = !!mdsAbaLicadWei(!attaName)
              !hWei = !hWei + !tWei[!tWei.size()]

            elseif (!!mdsHangIf.upcase().eq('PSL')) then
              !tWei = !!mdsAbapslwei(!attaName)
              !hWei = !hWei + !tWei[!tWei.size()]

            elseif (!!mdsHangIf.upcase().eq('CPL')) then
              !tWei = !!mdsAbacplwei(!attaName)
              !hWei = !hWei + !tWei[!tWei.size()]
            endif
          endif
        endif
      enddo
      -- Total Weight of the MDS Group Master MDS Structure and MDS Hanger Supports
      !nWei = !nWei + !hWei

    endif

  else

    -- MDS Ancillary Support - Get Weight for upto 100 ATTAS
    if (!mdsObject.mdsData.supptype.eq('ATTA')) then
      !ancillaryWei = !mdsObject.support.prop.weig.real()
      do !indx from 1 to 100
        !nameOfAtta = !supName & '.' & !indx
        !attaDbref  = !nameOfAtta.dbref()
        handle (2,109)
          -- Undefined Name Error, i.e. Atta <!attaDbref> does NOT exist
          skip
        elsehandle NONE
          !ancillaryWei = !ancillaryWei + !attaDbref.prop.weig.real()
        endhandle
      enddo
      !nWei = !ancillaryWei
    else
      -- MDS Hanger Support

      if (!supName.dbref().type.eq('ATTA') and !supName.dbref().cref.badref().not()) then
        if (!supName.dbref().cref.type.eq('HANG')) then

          --  Calls to Additional MDS Hanger Interface Weight Calculation Routines

          if (!!mdsHangIf.upcase().eq('MDS')) then
            !tWei = !!mdsAbaHangWeight(!supName.dbref())
            !nWei = !tWei[!tWei.size()]

          elseif (!!mdsHangIf.upcase().eq('LISEGA')) then
            !tWei = !!mdsAbaLicadWei(!supName.dbref())
            !nWei = !tWei[!tWei.size()]

          elseif (!!mdsHangIf.upcase().eq('PSL')) then
            !tWei = !!mdsAbapslwei(!supName.dbref())
            !nWei = !tWei[!tWei.size()]

          elseif (!!mdsHangIf.upcase().eq('CPL')) then
            !tWei = !!mdsAbacplwei(!supName.dbref())
            !nWei = !tWei[!tWei.size()]
          endif
        endif
      endif
    endif
  endif
  !!cplWei = !nWei

  return !nWei.string('D2')
endmethod
