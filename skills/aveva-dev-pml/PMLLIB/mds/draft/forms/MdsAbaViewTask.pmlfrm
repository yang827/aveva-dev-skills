--
--  File: MdsAbaViewTask.pmlfrm
--   Type: Form Definition
--   Group: MDS ABA Automatic support fabrication drawings
--     Keyword: ABA
--   Module: Draft
--   Replaces:
--
-- Author: Wayne Dodwell
-- Created: Friday 24th May 2002
--
--
-- Description:
-- Form Definition for Selecting the MDS ABA View Task Optionsa and their Associated Pen Options etc...
--
---------------------------------------------------------------------------------------------------------
--
------------------------------------------------------------------------
--<wd>20mar2008 -- DUN824
-- *********************
-- ***IMPORTANT NOTE ***
-- *********************
-- This MDS ABA file incorporates the modifications supplied by Steve Wilson on 19mar2008.
-- These changes have been necessary to enable MDS12.0.SP2 to work correctly with ABA12.0.SP2
--<wd>20mar2008 -- DUN824
------------------------------------------------------------------------

-- Kill existing form definition
  kill !!mdsabaviewtask

-- Define Form
  setup form  !!mdsabaviewtask

    !!mdsabaviewtask.formtitle = |MDS ABA View Tasks|
    !!mdsabaviewtask.icontitle = |MDSABAVTasks|
    !!mdsabaviewtask.callback  = |!this.init()|

-- Main Frame
    frame .frame ' Select View Options ' width 30

-- Body of Frame Elements
      path down
      vdist 0.5

-- MDS Framework Dimensions
      button .framedimsb at x1 ymax tooltip 'Dimension Pen Settings' pixmap width 16 height 16 $
        call |!!mdsabadimenpens.settings = !this.subtasks[1] !!mdsabadimenpens.current = 1 show !!mdsabadimenpens !!mdsabadimenpens.toggle = !!mdsabaviewtask.framedims.val|
      toggle .framedims at xmax+0.5 ymin 'Steelwork Dimensions' call |!this.frmdims()|
      !this.framedimsb.addpixmap(!!pml.getpathname('dimdef16.png'))

-- MDS Framework Tags
      button .frametagsb at x1 ymax+0.5 tooltip 'Label Pen Settings' pixmap width 16 height 16 $
        call |!!mdsabasteelpens.settings = !this.subtasks[2] !!mdsabasteelpens.current = 2 show !!mdsabasteelpens !!mdsabasteelpens.toggle = !!mdsabaviewtask.frametags.val|
      toggle .frametags at xmax+0.5 ymin 'Steelwork Tags' call |!this.frmtags()|
      !this.frametagsb.addpixmap(!!pml.getpathname('labdef16.png'))

-------------------------------------------
--<wd>27mar2008 - DUN824 - REDUNDANT FORM GADGETS and TASKS -- RE-INDEX Passed Parameters
--
-- -- MDS External Joint Dimensions
--       button .xjointdimsb at x1 ymax+0.5 tooltip 'Dimension Pen Settings' pixmap width 16 height 16 $
--         call |!!mdsabadimenpens.settings = !this.subtasks[3] !!mdsabadimenpens.current = 3 show !!mdsabadimenpens !!mdsabadimenpens.toggle = !!mdsabaviewtask.xjointdims.val|
--       toggle .xjointdims at xmax+0.5 ymin 'External Joint Dimensions' call |!this.xjdims()|
--       !this.xjointdimsb.addpixmap(!!pml.getpathname('dimdef16.png'))
--
-- -- MDS External and Internal Joint Tags
--       button .alljointtagsb at x1 ymax+0.5 tooltip 'Label Pen Settings' pixmap width 16 height 16 $
--         call |!!mdsabalabelpens.settings = !this.subtasks[4] !!mdsabalabelpens.current = 4 show !!mdsabalabelpens !!mdsabalabelpens.toggle = !!mdsabaviewtask.alljointtags.val|
--       toggle .alljointtags at xmax+0.5 ymin 'All Joint Tags' call |!this.alljtags()|
--       !this.alljointtagsb.addpixmap(!!pml.getpathname('labdef16.png'))
--

-- MDS Ancillary Dimensions
      button .ancilldimsb at x1 ymax+0.5 tooltip 'Dimension Pen Settings' pixmap width 16 height 16 $
        call |!!mdsabadimenpens.settings = !this.subtasks[3] !!mdsabadimenpens.current = 3 show !!mdsabadimenpens !!mdsabadimenpens.toggle = !!mdsabaviewtask.ancilldims.val|
--        call |!!mdsabadimenpens.settings = !this.subtasks[5] !!mdsabadimenpens.current = 5 show !!mdsabadimenpens !!mdsabadimenpens.toggle = !!mdsabaviewtask.ancilldims.val|
      toggle .ancilldims at xmax+0.5 ymin 'Ancillary Dimensions' call |!this.ancdims()|
      !this.ancilldimsb.addpixmap(!!pml.getpathname('dimdef16.png'))

-- MDS Ancillary Northings/Co-Ordinates etc...
      button .ancnorthingb at x1 ymax+0.5 tooltip 'Dimension Pen Settings' pixmap width 16 height 16 $
        call |!!mdsabadimenpens.settings = !this.subtasks[4] !!mdsabadimenpens.current = 4 show !!mdsabadimenpens !!mdsabadimenpens.toggle = !!mdsabaviewtask.ancnorthing.val|
--        call |!!mdsabadimenpens.settings = !this.subtasks[6] !!mdsabadimenpens.current = 6 show !!mdsabadimenpens !!mdsabadimenpens.toggle = !!mdsabaviewtask.ancnorthing.val|
      toggle .ancnorthing at xmax+0.5 ymin 'Ancillary Co-Ordinates' call |!this.ancnrthgs()|
      !this.ancnorthingb.addpixmap(!!pml.getpathname('dimdef16.png'))

-- MDS Ancillary Tags
      button .ancilltagsb at x1 ymax+0.5 tooltip 'Label Pen Settings' pixmap width 16 height 16 $
        call |!!mdsabasteelpens.settings = !this.subtasks[5] !!mdsabasteelpens.current = 5 show !!mdsabasteelpens !!mdsabasteelpens.toggle = !!mdsabaviewtask.ancilltags.val|
--        call |!!mdsabasteelpens.settings = !this.subtasks[7] !!mdsabasteelpens.current = 7 show !!mdsabasteelpens !!mdsabasteelpens.toggle = !!mdsabaviewtask.ancilltags.val|
      toggle .ancilltags at xmax+0.5 ymin 'Ancillary Tags' call |!this.anctags()|
      !this.ancilltagsb.addpixmap(!!pml.getpathname('labdef16.png'))

-- MDS Weld Tags
      button .weldtagsb at x1 ymax+0.5 tooltip 'Weld Pen Settings' pixmap width 16 height 16 $
        call |!!mdsabaweldpens.settings = !this.subtasks[7] !!mdsabaweldpens.current = 7 show !!mdsabaweldpens !!mdsabaweldpens.toggle = !!mdsabaviewtask.weldtags.val|
--        call |!!mdsabaweldpens.settings = !this.subtasks[9] !!mdsabaweldpens.current = 9 show !!mdsabaweldpens !!mdsabaweldpens.toggle = !!mdsabaviewtask.weldtags.val|
      toggle .weldtags at xmax+0.5 ymin 'Weld Tags' call |!this.weldtags()|
      !this.weldtagsb.addpixmap(!!pml.getpathname('labdef16.png'))
--
--<wd>27mar2008 - DUN824 - REDUNDANT FORM GADGETS and TASKS -- RE-INDEX Passed Parameters
-------------------------------------------
--
-- Add all DESIGN DATA within the MDS ABA Support Drawing AREA Volume
      toggle .allvol 'Add all Within Area Volume' at x1 ymax+0.5

    exit

-- Bottom Line
    button .cancel | Cancel | at xmax form-size ymax+0.5 cancel
    button .ok     |   OK   | at x0 ymin call |!this.apply()| ok

-- Form Members
    member .task     is ABATASK
    member .subtasks is ARRAY
    member .form     is FORM

  exit

-- End of form definition
---------------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
--
-- ==========================
-- Methods are Defined below:
-- ==========================
--
---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method .apply()

--  Get the View Tasks to Executed on the View
    !parameters[1] = !this.framedims.val.string()
    !parameters[2] = !this.frametags.val.string()
-------------------------------------------
--<wd>27mar2008 - DUN824 - REDUNDANT FORM GADGETS and TASKS -- RE-INDEX Passed Parameters
--
--    !parameters[3] = !this.xjointdims.val.string()
--    !parameters[4] = !this.alljointtags.val.string()
--    !parameters[5] = !this.ancilldims.val.string()
--    !parameters[6] = !this.ancnorthing.val.string()
--    !parameters[7] = !this.ancilltags.val.string()
--    !parameters[8] = !this.allvol.val.string()
--    !parameters[9] = !this.weldtags.val.string()
--
-- RE-INDEX the !parameter indices because of REDUNDANT FORM GADGETS and TASKS
    !parameters[3] = !this.ancilldims.val.string()
    !parameters[4] = !this.ancnorthing.val.string()
    !parameters[5] = !this.ancilltags.val.string()
    !parameters[6] = !this.allvol.val.string()
    !parameters[7] = !this.weldtags.val.string()
--
--<wd>27mar2008 - DUN824 - REDUNDANT FORM GADGETS and TASKS
-------------------------------------------

-- Build the Array containing EACH Tasks' TPVAL attribute values
    do !a index !this.subtasks
      !after = !this.subtasks[!a].after(',')
      !tkpv  = !parameters[!a] & ',' & !after
      !parameters[!a] = !tkpv
-- q var !tkpv !parameters[!a]
    enddo

-- Reset the task object
   !this.task.paramval = !parameters

-- Transfer the modified task back to the calling form
   !this.form.receivetask(!this.task)

-- Activate the Apply Button on the Main View Form
   !this.form.apply.active = true

  endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------

  define method  .init()

-- Set the View Task Form 'Toggles' to the On/Off Flag as stored in the View Task Parameters(1 to 7)
    !framedimssplit     = !this.task.paramval[1].split(',')
    !this.framedims.val = !framedimssplit[1].boolean()

    !frametagssplit     = !this.task.paramval[2].split(',')
    !this.frametags.val = !frametagssplit[1].boolean()

-------------------------------------------
--<wd>27mar2008 - DUN824 - REDUNDANT FORM GADGETS and TASKS -- RE-INDEX Passed Parameters
--
--    !xjointdimssplit     = !this.task.paramval[3].split(',')
--    !this.xjointdims.val = !xjointdimssplit[1].boolean()
--
--    !alljointtags          = !this.task.paramval[4].split(',')
--    !this.alljointtags.val = !alljointtags[1].boolean()
--
--<wd>27mar2008 - DUN824 - REDUNDANT FORM GADGETS and TASKS -- RE-INDEX Passed Parameters
-------------------------------------------

-------------------------------------------
--<wd>27mar2008 - DUN824 - REDUNDANT FORM GADGETS and TASKS -- RE-INDEX Passed Parameters
--
--    !ancilldims          = !this.task.paramval[5].split(',')
    !ancilldims          = !this.task.paramval[3].split(',')
    !this.ancilldims.val = !ancilldims[1].boolean()

--    !ancnorthing          = !this.task.paramval[6].split(',')
    !ancnorthing          = !this.task.paramval[4].split(',')
    !this.ancnorthing.val = !ancnorthing[1].boolean()

--    !ancilltags          = !this.task.paramval[7].split(',')
    !ancilltags          = !this.task.paramval[5].split(',')
    !this.ancilltags.val = !ancilltags[1].boolean()

--    !allvol              = !this.task.paramval[8]
    !allvol              = !this.task.paramval[6]
    !this.allvol.val     = !allvol.boolean()

--    !weldtags          = !this.task.paramval[9].split(',')
    !weldtags          = !this.task.paramval[7].split(',')
    !this.weldtags.val = !weldtags[1].boolean()


-- Store the TPVAL attribute values for EACH "MAIN" MDS ABA View Task, i.e. 'Dimensions' or 'Labels'
--    do !subs from 1 to 9
--      skip if !subs eq 8
    do !subs from 1 to 7
      skip if !subs eq 6
      !this.subtasks[!subs] = !this.task.paramval[!subs]
    enddo
--
--<wd>27mar2008 - DUN824 - REDUNDANT FORM GADGETS and TASKS -- RE-INDEX Passed Parameters
-------------------------------------------

-- Load Label and/or Dimension Forms if Undefined
    if (undefined(!!mdsabalabelpens)) then
      pml load form !!mdsabalabelpens
    endif
    if (undefined(!!mdsabasteelpens)) then
      pml load form !!mdsabasteelpens
    endif
    if (undefined(!!mdsabadimenpens)) then
      pml load form !!mdsabadimenpens
    endif
--<wd>feb2005 -- Load Form if it is UNDEFINED
    if (undefined(!!mdsabaweldpens)) then
      pml load form !!mdsabaweldpens
    endif
--<wd>feb2005
  endmethod

