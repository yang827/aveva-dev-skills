--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  deletece()                       -
--  deleteid()                       -
--  delmarked()                      -
--  flip()                           -
--  mark()                           -
--  nlpn(real)                       -
-- form to help tidy up MDS standard drawings in draft

setup form !!Mdsdraftutil

  !this.formtitle    = |Draft Utils|
  !this.icontitle    = ||
  !this.callback     = ||
  !this.formrevision = ||

  path down
  vdist 0

  button .stra   'New Line          ' call 'NEW STRA DEF $@'
  button .tex1   'New Text          ' call 'NEW TEXP CHEI 3MM AT $@'
  button .tex2   'New Text Copy Prev' call 'NEW TEXP COPY PREV AT $@'
  button .bolt   'New Bolt SYMB     ' call 'NEW SYMB TMRF /MDS-Standards-Sylb/BOLT-HEAD at $@'
  button .bolt2  'New FieldWeld SYMB' call 'NEW SYMB TMRF /MDS-Standards-Sylb/FIELD-WELD at $@'
  button .flip   'Flip Line         ' call '!this.flip()'
  button .arro   'Arrow Line        ' call 'NLPN 203'
  button .blob   'Blob Line         ' call 'NLPN 206'
  button .dim    'Dim Line          ' call 'NLPN 204'
  button .sk1    'Sketch FPT        ' call 'sketch fpt'
  button .sk2    'Sketch TPT        ' call 'sketch tpt'
  button .FP1    'FPT $@             ' call 'fpt $@'
  button .TP2    'TPT $@             ' call 'tpt $@'
  button .ad1    'Q Adeg            ' call 'q adeg'
  button .ad0    'ADEG   0          ' call 'Adeg 0'
  button .ad90   'ADEG  90          ' call 'Adeg 90'
  button .ad90n  'ADEG -90          ' call 'Adeg -90'
  button .def    'Def $@             ' call 'DEF $@'
  button .by     'By $@              ' call 'BY $@'
  button .xx     'Nlpn 6            ' call '!this.nlpn(6)'
  button .xx2    'Nlpn 4            ' call '!this.nlpn(4)'
  button .xx1    'Nlpn 1            ' call '!this.nlpn(1)'
  button .yy     '                  ' call ''
  button .del    'Delete CE         ' call '!this.deletece()'
  button .delid  'Delete ID         ' call '!this.deleteid()'
  button .mark   'Mark for deletion ' call '!this.mark()'
  button .delmark'Delete Marked     ' call '!this.delmarked()'

  exit

define method .flip()
  tcode mid
  var !adeg (adeg + 180)
  if ($!adeg gt 360) then
    var !adeg ($!adeg - 360)
  else
    adeg $!adeg
  endif
  adeg $!adeg
  tcode end
endmethod

define method .deletece()
  var !type type
  delete $!type
endmethod

define method .nlpn(!num is real)

do from 1
  id @
    handle any
      break
    endhandle
  nlpn $!num
enddo

endmethod

define method .deleteid()

do from 1
  id @
    handle any
      break
    endhandle
  var !type type
  delete $!type
enddo


endmethod

define method .mark()

  do
  id @
    handle any
      break
    endhandle
  if !!ce.nlpn.eq(200) then
    !!ce.nlpn = 1
  else
    nlpn 200
  endif
enddo
endmethod

define method .delmarked()
shee
var !marked coll all stra with nlpn eq 200 for ce
do !a values !marked
  !!ce = !a.dbref()
  delete stra
enddo

endmethod
