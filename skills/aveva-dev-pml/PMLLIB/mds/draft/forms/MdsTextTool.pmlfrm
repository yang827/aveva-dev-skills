setup form !!MDSTEXTTOOL


  !this.formtitle    = |Set Btext|
  !this.icontitle    = ||
  !this.callback     = ||
  !this.formrevision = ||

  path down
  vdist 0


  text .text 'Text' call '!this.addtext(1)' width 32 is string
  option .oldtexts '    ' call '!this.addtext(2)' width 30

 exit

 define method .addtext(!type is real)

 if !type eq 1 then
   !!ce.btext = !this.text.val
   handle any
   elsehandle none
   !this.addoption()
   endhandle
 else
   !!ce.btext = !this.oldtexts.selection()
   !this.text.val = !this.oldtexts.selection()
   handle any
   endhandle
 endif

 endmethod

 define method .addoption()

  !a = !this.oldtexts.Dtext
  !a.append(!this.text.val)
  !a.sort()
  !A.unique()

 !this.oldtexts.Dtext = !a

 endmethod

 define method .mdstexttool()

 shee
 handle any
 elsehandle none
  var !texts coll all texp for ce
  var !btex eval btext for all from !texts
  !btex.sort()
  !this.oldtexts.Dtext = !btex
 endhandle

 endmethod
