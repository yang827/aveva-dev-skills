--
-- Description: Utility for running individual tasks at sheet level
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  BuildFormOk(array,array)         -
--
setup form !!task
   init '!this.init()'
   Title 'Update Tasks'
   button .ce ' CE ' call '!this.init()'
   path right
   text .shname  width 30 is string
   !this.shname.setEditable(false)
   path down
   list   .shtask 'Select Tasks' at xmin .ce MULTI width 32 hei 6
   button .apply   ' Apply ' at xmin .ce call '!this.apply()' TOOLTIP 'Update Selected Tasks'
   path right
   button .modify 'Modify Task...' call |!this.modifyTask(!this.shtask.selection('RTEXT')[1])| TOOLTIP 'Modify Task Parameters'
   button .cancel  'Dismiss' at xmax form - size cancel
   menu .pop1
         !this.pop1.add ('CALLBACK','Select All',|!this.select('ALL')|)
         !this.pop1.add ('CALLBACK','Clear Selection',|!this.select('NONE')|)
         !this.shtask.setpopup(!this.pop1)
   member .TaskList is ABATASKLIST
exit
-------------------------------------------------------------
define method .init()
-------------------------------------------------------------
   Shee
   handle (2,111)
    return error 1 'Navigate to Shee'
   endhandle
   !this.shname.val = !!ce.name.string()
   var !task coll all task for ce
   var !evalfunc eval pmlfunction for all from !task
   --var !evalfunc eval function for all from !task
   !this.shtask.dtext = !evalfunc
   !this.shtask.rtext = !task
endmethod
----------------------------------------------------------------------
define method .select(!What is string)
----------------------------------------------------------------------
   if !what eq |ALL| then
     do !g index !this.shtask.dtext
         !this.shtask.val = $!g
     enddo
     else
        !this.shtask.clearselection()
     endif
   endmethod
----------------------------------------------------------------------
define method .apply()
--------------------------------------------------------------
do !i values !this.shtask.selection()
   !!abalogging = object abaLogging()
   !!abalogfile = object file('%PDMSABALOG%\Aba_14-January-2002_11-21.log')
   var !tkpara coll all tkpara for $!i
   var !p eval tpvalue for all from !tkpara
   !pmlfunc = '!!' & !i.dbref().pmlfunc & '(!p)'
   if !i.dbref().sppurp eq 'ABAS' then
     !curr = !i.dbref().owne
   elseif !i.dbref().sppurp eq 'ABAV' then
     !curr = !i.dbref().owne.owne
   endif
   !!ce = !curr
   $!pmlfunc
   --HANDLE(46,28)
   -- !!alert.message('You must load ABA application before using this utility')
   --ENDHANDLE
   !!ce = !curr
enddo

endmethod
--------------------------------------------------------------
-----------------------------------------------------------------------------
define method .modifyTask(!RTEXT is string)
-----------------------------------------------------------------------------
-- Get task form name
!taskForm = !this.shtask.selection()[1].dbref().pmlfunction
-- Show task form
 kill !!$!taskForm
 show !!$!taskForm centre xr 0.5 yr 0.5
 handle (61,123)
    -- F&M: Form xxxxxxx not found
    var !params coll all tkpara for $!rtext
    var !paramDesc eval function for all from !params
    var !paramVal eval TPVAL for all from !params
    !this.BuildForm(!taskform,!paramdesc,!paramval,!params)
 endhandle
endmethod
-----------------------------------------------------------------------------------------------------
define method .BuildForm(!taskform is string,!paramdesc is array,!paramval is array,!params is array)
-----------------------------------------------------------------------------------------------------

  -- Initialise variables
  !size = !paramDesc.width()
  !size1 = !paramVal.width() + 2

  kill !!editUserTask

  -- Build form
  setup form !!editUserTask

  path down
  title '$!taskform'

  frame .frame ''

    if (!paramDesc.size().eq(0)) then

      !!alert.warning('No Parameters To Modify')
   exit
   exit
      return

    else

      do !index index !paramDesc

        -- Form gadget name
        !gadgetName = '.a' & !index
        -- Compose the gadget description
        var !a compose '$!paramDesc[$!index]' width $!size right space 1

        -- Text gadget

          -- Create & set gadget
          text $!gadgetName |$!a[1]| at x 1 width $!size1 is STRING
          !gadgetValue = !gadgetName & '.val'
          !this$!gadgetValue = !paramVal[!index]


      enddo

    endif

  exit

  button .ok     '  OK  ' at x 1 Call |!!task.buildformok(!!editusertask.paramdesc,!!editusertask.params)|OK
  path right
  button .Cancel 'Cancel' at xmax form-size CANCEL
  member .paramdesc is array
  !!editusertask.paramdesc = !paramdesc
  member .params is array
  !!editusertask.params = !params
exit
  show !!editusertask centred XR .5 YR .5
--q var !paramdesc
endmethod
-----------------------------------------------------------------------------------------
define method .BuildFormOk(!paramdesc is array,!params is array)
-----------------------------------------------------------------------------------------
--Get values from gadgets and set them back to TPVAL of TKPARA
do !i index !paramdesc
  !gadget = !!editusertask.A$!i
  !tpval = !gadget.val
   !params[!i].dbref().tpval = !tpval
enddo
endmethod
----------------------------------------------------------------------------------------
