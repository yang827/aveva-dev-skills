------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cleargroup()                     -
--  deleteline()                     -
--  group()                          -
--  movegroup()                      -
--  output()                         -
--  resize()                         -
--  setpen(real)                     -
--  testdrawlist()                   -
--  unmark()                         -
setup form !!testdrawlist

selector .drawlist width 12 hei 6
button .remove 'ADD/Remove Lines' call '!This.unmark()'
path down
-- button .refresh 'Refresh' call '!this.drawlist()'
button .group  'Create Group       ' call '!this.group()'
button .clear  'Clear Group        ' call '!this.cleargroup() '
button .NPEN6  'Nlpn 6             ' call '!this.setpen(6)'
button .npen1  'Nlpn 1             ' call '!this.setpen(1)'
button .npena  'Set Nlpn...        ' call '!this.setpen(0)'
button .move   'Move Group         ' call '!this.movegroup()'
button .output 'Output to file     ' call '!this.output()'
button .resize 'Resize group       ' call '!this.resize()'

button .delete 'delete Marked Lines' at xmin ymax + 1 call '!this.deleteline()'
member .flag is boolean
exit

define method .testdrawlist()
if unset(!this.flag) then
  !this.flag = false
endif
var selector !!testdrawlist.drawlist clear
exit
var selector !!testdrawlist.drawlist enhance list
exit

endmethod

define method .cleargroup()
 unenhance all
 !this.testdrawlist()
 !this.flag = false

endmethod


define method .unmark()
  do
  id @
    handle any
      break
    endhandle
    !s = !this.drawlist.dtext.findfirst(!!ce.string())
   if unset(!s)then
     enhance ce
   else
     unenhance ce
   endif
   !this.testdrawlist()
enddo
endmethod

define method .deleteline()

 if !this.flag then
   if !!alert.confirm('Group was last used for highlight - Do you want to delete?') ne 'YES' then
     return
   endif
 endif
 !a = !this.drawlist.dtext
 do !b values !a
   !!ce = !b.dbref()
   handle ANY
     SKIP
   endhandle
   !TYPE = !!CE.TYPE
   delete $!TYPE

 enddo
 !this.testdrawlist()
 !this.flag = false

endmethod

define method .group()
note
handle any
 sytm
 handle any
 return
 endhandle
elsehandle none
 Blnk false
endhandle
new rect def @
!re = !!ce
!xypos1 = !!ce.ptrf.xypos
!xypos2 = !!ce.ptrf.xypos

!xypos1.east = !xypos1.east - !!ce.xlen / 2
!xypos1.north = !xypos1.north - !!ce.ylen / 2


!xypos2.east = !xypos2.east + !!ce.xlen / 2
!xypos2.north = !xypos2.north + !!ce.ylen / 2
shee
handle ANY
  NOTE
  handle ANY
  END
  endhandle
endhandle

var !lines coll all stra for ce
!list = array()
do !a values !lines
  if !a.dbref().ptfa[1].unset() or !a.dbref().ptfa[2].unset() then $* its a line with only one end
   !list.append(!a)
   skip
  endif
  if !a.dbref().ptfa[1].xypos.east gt !xypos1.east and !a.dbref().ptfa[1].xypos.east lt !xypos2.east then
    if !a.dbref().ptfa[1].xypos.north gt !xypos1.north and !a.dbref().ptfa[1].xypos.north lt !xypos2.north then
      if !a.dbref().ptfa[2].xypos.east gt !xypos1.east and !a.dbref().ptfa[2].xypos.east lt !xypos2.east then
      handle ANY
      endhandle
          if !a.dbref().ptfa[2].xypos.north gt !xypos1.north and !a.dbref().ptfa[2].xypos.north lt !xypos2.north then
          handle ANY
          endhandle
          !list.append(!a)
        endif
      endif
    endif
  endif
enddo
enhance all from !list
!!ce = !re
delete rect
!this.testdrawlist()



endmethod

define method .setpen(!no is real)
 if !no eq 0 then
   !penno = !!alert.input('Enter Pen No','1')
   !pen = !penno.real()
 else
   !pen = !no
 endif
 !a = !this.drawlist.dtext
 do !b values !a
   !!ce = !b.dbref()
   nlpn $!pen
 enddo
 !this.flag = true

endmethod

define method .movegroup()
  !movecommand = !!alert.input('Enter a move dir/amount','Y -1')

  !a = !this.drawlist.dtext
  do !b values !a
    !!ce = !b.dbref()
    handle ANY
    SKIP
    endhandle
    by  $!movecommand
  enddo
  !this.flag = true

endmethod

define method .output()

 !filename = !!alert.input('Enter a filename','C:\temp\grouplist')
 alpha file /$!filename over
  !a = !this.drawlist.dtext
  do !b values !a
    !!ce = !b.dbref()
    handle ANY
    SKIP
    endhandle
    output ce
  enddo
  alpha file end

endmethod


define method .resize()

  !scale = !!alert.input('Enter a Scale','0.5')
  !a = !this.drawlist.dtext
  do !b values !a
    !!ce = !b.dbref()
    handle ANY
    SKIP
    endhandle
    !fptx = !!ce.ptfa[1].xypos.east * !scale.real()
    !fpty = !!ce.ptfa[1].xypos.north * !scale.real()
    !tptx = !!ce.ptfa[2].xypos.east * !scale.real()
    !tpty = !!ce.ptfa[2].xypos.north * !scale.real()
    fpt x $!fptx y $!fpty
    tpt x $!tptx y $!tpty
  enddo

endmethod
