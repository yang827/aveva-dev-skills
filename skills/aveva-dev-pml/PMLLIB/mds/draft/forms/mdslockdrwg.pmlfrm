--   Module:        draft
--   Replaces:
--
-- Author:          R Martin
-- Created:         09/05/06
--
-- Description:
-- Form to lock and unlock drawings within draft
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getce()                          -
--  init()                           -
--  setlock()                        -
--

-- Define form
setup form !!mdslockdrwg dialog resi size 55 6

  !!mdslockdrwg.formTitle     = 'Modify Drawing Lock'
  !!mdslockdrwg.iconTitle     = 'Lock'
  !!mdslockdrwg.callback      = ''
  !!mdslockdrwg.formRevision  = ''
  !!mdslockdrwg.initcall      = '!!mdslockdrwg.init()'

  -- Body of form definition
  button _ce |CE| call |!this.getce()| at x1 y1
  option _lock at xmax+1 ymin width 15

  !a[1] = 'Lock Drawing'
  !a[2] = 'Unlock Drawing'
  !this.lock.dtext = !a

  para _drwgnametext at xmin.ce ymax+0.6 text |Drwg:|
  para _drwgname at xmax+1 text || width 50
  para _lockstatustext at xmin.ce ymax+0.2 text |Status:|
  para _lockstatus at xmax+1 text || width 20

  button _apply | Apply | call |!this.setlock()| at x0 ymax form-1
  button _dismiss | Dismiss | call || at xmax form-size ymax form-1 cancel

  -- members

  member .drwg     is dbref
  member .nullref  is dbref

exit
-- End of form definition

-- Methods

define method .init()

  -- Access selected drawing
  !current = !!CE

  --check that we have a drwg element if so then update the form member
  if !!CE.type eq 'DRWG' then

    -- set form drwg member
    !this.drwg = !current

    -- display the current drawing name on the form
    !this.drwgname.val = !!ce.name

    -- display the lock status of the drwg (locked or unlocked)
    if !!ce.lock eq TRUE then
      !this.lockstatus.val = 'Locked'
    else
      !this.lockstatus.val = 'Unlocked'
    endif

  else

    -- set form drwg member
    !this.drwg = !this.nullref

    -- display null text fields
    !this.drwgname.val = ''

    !this.lockstatus.val = ''

  endif

endmethod

define method .setlock()

  -- Access selected drawing
  !!CE = !this.drwg
  handle ANY
    !!alert.error('Current element must be a DRWG')
    return
  elsehandle NONE
    var !lockstatus lock
    if !this.lock.val eq 1 then
      if !lockstatus eq 'true' then
        --the current drawing is already locked
        !!alert.error('The current DRWG is already locked')
      else
        lock
        !this.lockstatus.val = 'locked'
      endif
    else
      if !lockstatus eq 'false' then
        --the current drawing is already unlocked
        !!alert.error('The current DRWG is already unlocked')
      else
        unlock
        !this.lockstatus.val = 'Unlocked'
      endif
    endif
  endhandle
endmethod

-- sets the current element to the ce in the members list and displays relevant info
define method .getce()

  -- Access selected drawing
  !current = !!CE

  --check that we have a drwg element
  if !!CE.type neq 'DRWG' then
    !!alert.error('Current element must be a DRWG')
    return
  else
    !this.drwg = !current
    !this.drwgname.val = !!ce.name

    if !!ce.lock eq TRUE then
      !this.lockstatus.val = 'Locked'
    else
      !this.lockstatus.val = 'Unlocked'
    endif
  endif
endmethod
--end of form .mdslockdrwg
