--
-- File:                kfabdfltsaction.pml
--   Type:              Function Definition
--   Group:             MDS ADP support fabrication drawings
--     Keyword:         FAB
--   Module:            draft
--   Replaces:
--
-- Author:              S.J.Robinson
-- Created:             26th January 1998
--
--
-- Description:
-- Function to control actions from the MDS-ADP defaults form kfabdflts
--
----------------------------------------------------------------------
--
-- Arguments:
--
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING       Action
--
-- Return:
--    [Data Type]   [Description]
--
----------------------------------------------------------------------

-- Define Function
define function !!KFABDfltsAction(!Action IS STRING)

  -- check the passed action
  if (!Action.Upcase().Eq('DEFAULT')) then

    Call !!KFABSupDefs()

  elseif (!Action.Upcase().Eq('SITETRIM')) then

    !!SupportDef.SiteTrim  = !!KFABDflts.SiteTrim.Val.Real()
    handle any
      !!Alert.Warning('Site trim allowance invalid, 75mm default used')
      !!KFABDflts.SiteTrim.Val = '75mm'
    endhandle

  endif

-- End function
endfunction

-- End of file kfabdfltsaction.pml
