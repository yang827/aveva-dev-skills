--
-- File:		kfabsupdefs.pml
--   Type:		Function Definition
--   Group:		MDS ADP support fabrication drawings
--     Keyword:		FAB
--   Module:		Draft
--   Replaces:
--
-- Author:		M.J.Hockey
-- Created:		Fri Aug 08 1997
--
--
-- Description:
-- Reads the DESIGN and DRAFT Defaults files to populate object !!FABSupportDef
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!KFABSupDefs()

-- Initialise Variables
  !!SupportDef = OBJECT KSUPDEFS()

-- Open Design Deafults File and read replacement names & descriptions into arrays
  OPENFILE /$!!MDSFILES.DESCRIPTION READ !Read
  handle any
    !!Alert.error('File $!!MDSFILES.DESCRIPTION could not be found in the project defaults directory')
    return
  endhandle

  do !LineNumber

    READFILE $!Read !Record
      handle (41,325)
        CLOSEFILE $!Read
        break
      endhandle

    skip if !Record.Match(|#|).eq(1)
    skip if !Record.Trim().eq(||)

    !Records = !Record.Split('\')
    -- $p $!Record
    if (!Records[1].upcase().Match('MDSTRANPREF').gt(0)) then
      !!KFABDflts.TranPref.Val = !Records[2].trim()
      !!SupportDef.TranPref = !Records[2].Trim()
    elseif (!Records[1].upcase().Match('MDS').gt(0) ) then
      skip
    else
      if (!Records.Size().Lt(3)) then
        skip
      else
        -- read standard type
        !!SupportDef.Rtext.append(!Records[1].Trim())
        -- read replacement name and description
        !!SupportDef.Dtext.append(!Records[2] & !Records[3])
      endif
    endif
  enddo

  -- Open Draft Deafults File and read defaults
  OPENFILE /$!!MDSFILES.DRAFT READ !Read
  handle any
    !!Alert.error('File $!!MDSFILES.DRAFT could not be found in the project defaults directory')
    return
  endhandle

  do !LineNumber

    READFILE $!Read !Record
      handle (41,325)
        CLOSEFILE $!Read
        break
      endhandle

    skip if !Record.Match(|#|).eq(1)
    skip if !Record.Trim().eq(||)

    -- MDSSUPPST = default site trim
    -- MDSSUPPIS = default isometric view direction
    -- MDSUNITS  = Units text for MDS-ADP drawings
    -- MDSSWCM   = Units text for steel weight per cubic meters
    -- MDSTRANTEXT = Transportation support text
    -- SHOETAB = Detail shoe in a tabulated format or individually (removed
    -- now all tabulated
    -- MDSDRWGNO = MDS ADP Drawing Number
    -- MDSGRID   = MDS ADP Grid matrix selection

    !Records = !Record.Split('\')
    -- $p $!Record
    if !Records[1].upcase().Match('MDSSUPPST').gt(0) then
      !!SupportDef.SiteTrim = !Records[2].Trim().Real()
      !!KFABDflts.SiteTrim.Val = !Records[2].Trim()
      handle any
        !!Alert.Warning('Site trim allowance in $!!MDSFILES.DRAFT is invalid, 75mm default used')
        !!KFABDflts.SiteTrim.Val = '75'
        !!SupportDef.SiteTrim = 75
      endhandle
    elseif !Records[1].upcase().Match('MDSSUPPIS').gt(0) then
      !!SupportDef.Isometric = !Records[2].Trim()
      !!KFABDflts.IsoDir.Select('DTEXT',!Records[2].Trim())
      handle any
        !!Alert.Warning('Isometric view direction in $!!MDSFILES.DRAFT is invalid, ISO 3 default used')
        !!KFABDflts.IsoDir.Select('DTEXT','3')
      endhandle
    elseif !Records[1].upcase().Match('MDSUNITS').gt(0) then
      !UnitText = !Records[2].trim()
      !!KFABDflts.UnitsText.val = !UnitText
      handle any
        !!Alert.Warning('Units text in $!!MDSFILES.DRAFT is invalid, Kgs default used')
        !!KFABDflts.UnitsText.val = |Kgs|
      endhandle
    elseif !Records[1].upcase().Match('MDSTRANTEXT').gt(0) then
      !!SupportDef.TranText = !Records[2].Trim()
      !!KFABDflts.TranText.Val = !Records[2].trim()
    elseif !Records[1].upcase().Match('MDSSWCM').gt(0) then
      !UnitText = !Records[2].trim()
      !!KFABDflts.Swcm.val = !UnitText
      handle any
        !!Alert.Warning('Cubic weight per metre text in $!!MDSFILES.DRAFT is invalid, 7750 default used')
        !!KFABDflts.Swcm.val = |7750|
      endhandle
    -- elseif !Records[1].upcase().Match('SHOETAB').gt(0) then
      -- !Shoetab = !Records[2].trim()
      -- if (!Shoetab.boolean()) then
        -- !!KFABDflts.Shoetab.val = 'Yes'
      -- else
        -- !!KFABDflts.Shoetab.val = 'No'
      -- endif
    elseif !Records[1].upcase().Match('MDSDRWGNO').gt(0) then
      !!SupportDef.DrwgNo = !Records[2].Trim()
      !!KFABDflts.DrwgNo.Val = !Records[2].trim()
    elseif !Records[1].upcase().Match('MDSGRID').gt(0) then
      !!SupportDef.GridMatrix = !Records[2].Trim()
      !!KFABDflts.GridMatrix.Val = !Records[2].trim()
    elseif !Records[1].upcase().Match('MDSVIEWOLAP').gt(0) then
      !!SupportDef.viewolap = !Records[2].Trim()
      !!KFABDflts.viewolap.Val = !Records[2].trim()
    elseif !Records[1].upcase().Match('FT').eq(1) then
      !Var = '!!KFabWeld' + !Records[1]
      $!VAR = object KWELDDEFS()
      $!<VAR>.shop = !Records[2].real()
      $!<VAR>.site = !Records[3].real()
    elseif !Records[1].upcase().Match('AT').eq(1) then
      !Var = '!!KFabWeld' + !Records[1]
      $!VAR = object KWELDDEFS()
      $!<VAR>.shop = !Records[2].real()
      $!<VAR>.site = !Records[3].real()
    elseif !Records[1].upcase().Match('GT').eq(1) then
      !Var = '!!KFabWeld' + !Records[1]
      $!VAR = object KWELDDEFS()
      $!<VAR>.shop = !Records[2].real()
      $!<VAR>.site = !Records[3].real()
    elseif !Records[1].upcase().Match('VT').eq(1) then
      !Var = '!!KFabWeld' + !Records[1]
      $!VAR = object KWELDDEFS()
      $!<VAR>.shop = !Records[2].real()
      $!<VAR>.site = !Records[3].real()
    endif

  enddo

  -- Gtype equivalent table
  -- Section Type = Catalogue Gtypes
  !!SupportDef.Channel   = 'ANGL = ANGL ANG'
  !!SupportDef.Angle     = 'CHAN = CHAN BSC BEAM'

-- End function
endfunction

-- End of file kfabsupdefs.pml
