define function !!MdsAbaSplitLine(!OriginalString is STRING,!MaxWidth is REAL) is ARRAY

-- To make sure the text does not cross the end of the line take the character width off the maxwidth

  !ce = !!ce
  !MaxWidth = !!MdsAbaMtoSteel.getscale(!!mdsabamtosteel.data.taskparams[3])
  !!ce = !ce

  var !chei chei
  !MaxWidth = !MaxWidth - (!Chei.real() * 1.5)

-- Remove all occurrence of double spaces in original string

  !OriginalString = !OriginalString.replace('  ',' ')

-- Split original string into an array

  !SplitString = ARRAY()
  do !SplitS from 1 to !OriginalString.length()
    !SplitString.Append(!OriginalString.substring($!SplitS,1))
  enddo

  !Lines = ARRAY()
  !STRING = ''

-- Test if the full string is less than the maxwidth

  btex '$!OriginalString'
    handle ANY
    elsehandle NONE
      var !Extent extent btex
      !SplitExtent = !Extent.split(' ')
      !TestWidth = !SplitExtent[6].real() - !SplitExtent[2].real()
      if !TestWidth.lt(!MaxWidth) then
        !Lines.append(!OriginalString)
        return !Lines
      endif
    endhandle

-- Reset the btex to blank for the length testing after checking that the full string is less than the maxwidth

  btex ''

  !Counter = 0
  !SpaceCounter = 0

  -- do !Count from 1 to !SplitString.size()
  do !Count from 1

    !Counter = !Counter + 1
    !SpaceCounter = !SpaceCounter + 1

    !Btex = btex
    !NewBtex = !Btex & !SplitString[$!Counter]

    if !SplitString[$!Counter].eq(' ') then
      !LastSpace = !SpaceCounter
    endif

    btex |$!newbtex|
    var !Extent extent btex
    !SplitExtent = !Extent.split(' ')
    !TestWidth = !SplitExtent[6].real() - !SplitExtent[2].real()
      handle ANY
        skip
      endhandle

    if !TestWidth.gt(!Maxwidth) then
-- Width of string is more than the max allowed
      !Btex = btex
-- Test to see if the last character is a character, if so rewind the string back to the last space
      !LastCharacter = !btex.substring(!btex.length(),!btex.length())
      if !LastCharacter.eq(' ') then
        !Lines.append(!Btex.trim())
        btex ''
      else
-- Rewind btex to a space
        !startofbtex = !btex.substring(1,!LastSpace)
        !restofbtex = !btex.substring((!LastSpace + 1),!btex.length())
        -- $P $!startofbtex
        -- $P $!restofbtex
        !Size = !restofbtex.length()
        !Counter = !Counter - !Size
        !Lines.append(!Startofbtex.trim())
        -- btex '$!Restofbtex'
        btex ''
      endif
      !SpaceCounter = 0
    elseif !TestWidth.lt(!MaxWidth) and !Counter.eq(!SplitString.size()) then
      !Btex = btex
      !Lines.append(!btex)
      break
    else
      skip
    endif

    if !Counter.eq(!SplitString.size()) then
      break
    endif

  enddo

  return !Lines

endfunction

