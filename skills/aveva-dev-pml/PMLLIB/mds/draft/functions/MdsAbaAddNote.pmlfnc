--------------------------------------------------------------------------------
--
-- File: MdsAbaAddNote.pmlfnc
--   Type: Object Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: Draft MDS using ABA for Drawing production
--   Replaces:
--
-- Author: Steve Robinson
-- Created: 1st July 2002
--
--
-- Description:
-- ------------
-- This function generates notes on MDS support sctns and attas.
--
--
-- Using this function:
-- --------------------
-- For each view to be annotated call this function with the stru DBREF
-- and the view DBREF.
-- The function creates a GLAB for each sctn/atta in the support that
-- has the UDA :MDSNote set to some text string.
--
-- The GLAB is created under a layer named MDS_Notes.
--
-- Before calling the .dimension() method make sure the MDS_Notes layer
-- exists and had the relevant UCODE, PCODE and other text defaults set. This
-- allows you to control the appearance of the annotation before is it generated.
-- Note: If the layer does not exist then the method will create it and
-- and atts cascaded from view level will take effect.

-- IMPERIAL UNITS:
-- ---------------
-- The code should work in both metric and imperial units...
--
--
--
--
--------------------------------------------------------------------------------
-- Define Function

  ----------------------------------------------------------
  -- Arguments:
  -- stru = DBREF of support to be labelled
  -- view = DBREF of view where hanger will be dimensioned
  ----------------------------------------------------------
  define function !!mdsabaaddnote(!stru is DBREF, !view is DBREF,!params is STRING)

--------------------------------------------
--<wd>27mar2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
-- Obsolete Parameter Nos and Some Pen Attributes    -- Params passed as string
-- Obsolete Parameter Nos and Some Pen Attributes    -- 1  Leader Line         LLEAD
-- Obsolete Parameter Nos and Some Pen Attributes    -- 2  Text Frame          LFRAME
-- Obsolete Parameter Nos and Some Pen Attributes    -- 3  Text Pen            TPEN
-- Obsolete Parameter Nos and Some Pen Attributes    -- 4  Text Font           FONT
-- Obsolete Parameter Nos and Some Pen Attributes    -- 5  Leader Line Pen     LLPN
-- Obsolete Parameter Nos and Some Pen Attributes    -- 6  Text Box Pen        LFPN
-- Obsolete Parameter Nos and Some Pen Attributes    -- 7  Terminator Size     TSIZE
-- Obsolete Parameter Nos and Some Pen Attributes    -- 8  Terminator          LTERM
-- Obsolete Parameter Nos and Some Pen Attributes    -- 9  Label shape         Not Used

-- NEW 12.0 version Parameters (Pen Attributes etc...) passed as a STRING
-- *** IMPORTANT NOTE ***
-- ONLY 11 parameters are passed here as the ORIGINAL 1st parameter value (TRUE or FALSE ) in the STRING of 12 Parameters
-- has been REMOVED in the MDS ABA MAIN VIEW calling ABA TASK FUNCTION "mdsabaviewtask.pmlfnc"
-- LABEL Attributes (GLAB or SLAB)
    -- 1  Label Leader Line                 = LLEADER
    -- 2  Label Frame                       = LFRAME
    -- 3  Label Font                        = FONT
    -- 4  Label font Colour                 = TXCOLOUR
    -- 5  Label Leader Line Style           = LLSTYLE
    -- 6  Label Leader Line Colour          = LLCOLOUR
    -- 7  Label Frame Line Style            = LFSTYLE
    -- 8  Label Frame Line Colour           = LFCOLOUR
    -- 9  Label Leader Line Terminator Size = TSIZE
    -- 10 Label Leader Line Terminator Type = LTERMINATOR
    -- 11 Label Shape                       = Not Used for this TASK -- TMRF for SYTM/TXTM name reference or an EMPTY string, i.e. '', if the "NO FRAME" option has been selected
--
--<wd>27mar2008 - DUN824 - Defect No. P-4526
--------------------------------------------

  !passedParams = !params.split(',')

    !saveRef = !!ce

    -- note layer suffix
    !noteLayer = 'MDS_Notes'

    -- navigate to view
    $!view
    view

    -- check label layer exists
    set
    */$!noteLayer
    handle any
      new layer */$!noteLayer
    endhandle
    !layer = !!ce

-------------------------------------------
--<wd>27mar2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
---- Set passed parameters
    --   LLEAD  $!passedParams[1]
    --   LFRAME $!passedParams[2]
    --   TPEN   $!passedParams[3]
    --   FONT   $!passedParams[4]
    --   LLPN   $!passedParams[5]
    --   LFPN   $!passedParams[6]
    --   TSIZE  $!passedParams[7]
    --   CHEI   $!passedParams[7]
    --   LTERM  $!passedParams[8]
--
-- All of the 'handle any' lines etc.. have been added to ensure that the MDS ABA default value is USED if an ERROR occurs
--
-- Set the LAYER Attributes with the Passed Parameters
    LLEADER     $!passedParams[1]
    handle ANY
      LLEADER TRUE
    endhandle
    LFRAME      $!passedParams[2]
    handle ANY
      LFRAME FALSE
    endhandle
    FONT        $!passedParams[3]
    handle ANY
      FONT 31
    endhandle
    TXCOLOUR    $!passedParams[4]
    handle ANY
      TXCOLOUR 3
    endhandle
    LLSTYLE     $!passedParams[5]
    handle ANY
      LLSTYLE Solid
    endhandle
    LLCOLOUR    $!passedParams[6]
    handle ANY
      LLCOLOUR 5
    endhandle
    LFSTYLE     $!passedParams[7]
    handle ANY
      LFSTYLE Solid
    endhandle
    LFCOLOUR    $!passedParams[8]
    handle ANY
      LFCOLOUR 6
    endhandle
    TSIZE       $!passedParams[9]
    handle ANY
      TSIZE 3
    endhandle
    LTERMINATOR $!passedParams[10]
    handle ANY
      LTERMINATOR Arrows
    endhandle
--
--<wd>27mar2008 - DUN824 - Defect No. P-4526
--------------------------------------------

    -- clear any existing dimensions
    DELETE LAYER MEMBERS
    handle any
    endhandle

    -- get all sctns and attas to be processed
    var !sctns coll all sctn for $!stru
    !items = ARRAY()
    do !sctn values !sctns
      $!sctn
      !items.append(!!ce)
      !items.appendarray(!!ce.:mdsattaref)
        handle any
        endhandle
    enddo

    -- If its a special then the :mdsAttaref is not set therefore add them by name
    !struName = !stru.name
    !items.append($!struName/DATUM )
      handle any
      endhandle

    do !count from 1 to 100

-- <wd>30mar2004
      $!struName$n.$!count
        handle NONE
-- SKIP if element is NOT an ATTA and NOT a 'MDS' ATTA
          --skip if (!!ce.type.neq('ATTA'))
          skip if ((!!ce.type.neq('ATTA')) AND (!!ce.type.neq('CTSUPP')))
          skip if (!!ce.spref.name.match('/MDS').neq(1))
        elsehandle ANY
        endhandle
--<wd>30mar2004
      !items.append($!struName$n.$!count )
        handle any
        endhandle
    enddo

    -- If the support is a hanger add that
    if !struName.dbref().type.eq('ATTA') then
      if !struName.dbref().cref.badref().not() then
        if !struName.dbref().cref.type.eq('HANG') then
          !items.append(!struName)
        endif
      else
        -- item may be a standalone ancillary so include if this is the case
        !items.append(!struName)
      endif
    endif

    -- tm mod to ensure that duplicate notes are avoided
    !items.unique()

    -- generate all note labels
    do !item values !items
      $!item
      -- <RM> 09/10/07, insert any defined torque values (This has been done for AT137 and AT138 and references ATxxx-DATA-TQSHLD and ATxxx-DATA-TQNOSHLD)
      -- these data elements are linked to parameters on the SCOM which hold the required torque values)
      -- these can be dependant on whether or not we have an austenitic shield so first determine if the pipe type is austenitic
      var !aust :MDSAustshld of pspe of own
      handle ANY
        -- aust does not exist so skip this part
      elsehandle NONE
        !string = 'WITH AUSTENETIC SHIELD'
        !string2 = 'WITH AUSTENITIC SHIELD'
        if !aust.upcase().trim().eq(!string) or !aust.upcase().trim().eq(!string2)  then
          -- get the austenetic torque value
          var !tq collect all data with dkey eq 'TQSH' for dtre
          if !tq.unset().not() then
            var !para eval ppro for all from !tq
            var !torqueval $!para[1]
            !note = 'Required Torque: Ma = ' + !torqueval + ' Nm'
          endif
        else
          -- get the non-austenetic torque value
          var !tq collect all data with dkey eq 'TQNS' for dtre
          if !tq.unset().not() then
            var !para eval ppro for all from !tq
            var !torqueval $!para[1]
            !note = 'Required Torque: Ma = ' + !torqueval + ' Nm'
          endif
        endif
      endhandle
      if undefined(!note) then
      skip if (!!ce.:MDSNote.trim().upcase().eq('UNSET'))
      !note = :MDSNote
      endif
      !pos  = :MDSNotePos wrt /*
         handle any
           !pos = object POSITION()
         endhandle
      !dpos = pos wrt /*
      $!layer
      -- create the label and position with offset 0 0
      NEW GLAB ON $!item
      pkdis 0
      XYPO 0 0
      OSET FALSE
      -- save the sheet position of the label origin
--      !onPos = !!ce.xypo
      !note = !note.replace(';','#/')
      btex |$!note|
      if (!pos.up.unset()) then
        BY X25mm Y 25mm
        OSET FALSE
      else
        !dposS = !dpos.string().before(' WRT')
        var !itempos shpos of $!dposS
        !poss = !pos.string().before(' WRT')
        var !notepos shpos of $!poss

        if !itempos.after('X').before('Y').real().gt(!notepos.after('X').before('Y').real()) then
          !sxoff = !notepos.after('X').before('Y').real() - !itempos.after('X').before('Y').real()
        else
          !sxoff = !itempos.after('X').before('Y').real() - !notepos.after('X').before('Y').real()
        endif
        if !itempos.after('Y').real().gt(!notepos.after('Y').real()) then
          !syoff = !itempos.after('Y').real() - !notepos.after('Y').real()
        else
          !syoff = !notepos.after('Y').real() - !itempos.after('Y').real()
        endif

        -- !poss = !pos.string().before(' WRT')
        !poss = !pos.string().before(' WRT')
        -- var !notepos shpos of $!poss wrt $!stru
        -- position the label at the note position
        AT $!notepos
        OSET FALSE
        -- save the new label position
--        !shpos = !!ce.xypo
        -- offset the label by 25mm X and Y
        BY X25mm Y25mm
        -- calculate the attach position from the
        -- saved label positions
        -- !xoff = !shpos.east - !notepos.after('X').before('Y').real()
        -- !yoff = !shpos.north - !notepos.after('Y').real()
        OSET FALSE
        -- set the attach position offset
        APOF $!sxoff $!syoff
        APOFFSET DEF
        POSITION $!poss
      endif
      --<dw>Nov2008 Dun1052 To re-set variable 'note' for each support member
      !note.delete()
    enddo

    $!saveRef
    handle any
    endhandle

  endfunction
