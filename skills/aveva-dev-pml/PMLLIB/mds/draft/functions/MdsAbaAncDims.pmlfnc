--
-- File: MdsAbaAncDims.pmlfnc
--   Type: Form
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: Draft MDS using ABA
--   Replaces:
--
-- Author: Steve Robinson
-- Created: Wednesday 5th June 2002
--
--
-- Description:
-- Function to Add MDS Framework Ancillary Dimensions to ABA Drawing
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         DBREF of the Current View
--     2     R        STRING        STRING of Pen Options
--     3     R        DBREF         DBREF of MDS Support(Framework or Hanger)
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Define Function

--<wd>feb2005
  --define function !!mdsabaancdims(!view is DBREF,!params is STRING,!support is DBREF)
-- Now passed the COMPLETE !mdsobject instead of just the !mdsobject.support
 define function !!mdsabaancdims(!view is DBREF,!params is STRING,!mdsobject is MDSABASUPPORT)

   !support = !mdsobject.support
--<wd>feb2005

--<kp>jan07
-- exit if lighting support
   if !support.type.eq('STRU') then
      if !support.:mdssupptype.eq(!!mdslsuppdefs.type) then
         return
      endif
   endif

-- Setup dimensioning object and dimension view
   !ce = !!ce
   !!ce = !support
--<wd>feb2005
-- !members = !!mdsabasupportmem(!!ce)
-- !!ce = !ce
--<wd>feb2005
   !type = 'DIMENSIONS'

-- dtf 22.07.05 return if the plan view
  !dirofview = !view.dir
  if !dirofview.eq(!mdsobject.mdsdata.lookdowndir) then
    return
  endif

--$P **************************************************
--q var !view.name

  /FRA/TEMPLATES
  handle ANY
--------------------------------------------
--<wd>09apr2008-DUN824 and Defect No. P-4405
-- I don't understand why this variable is set???? IT READS AS if the object MDSABADIMATTA is for projects that ONLY USE "FRA/TEMPLATES"
-- When this variable is set to FALSE the object MDSABADIMATTA for ???dimensioning ATTAS heights??? does NOT run at approx. line 182 below
--<wd>09apr2008-DUN824 and Defect No. P-4405
--------------------------------------------
    !struancdimsflag = FALSE
  elsehandle NONE
    !struancdimsflag = TRUE
  endhandle

---------------------------------------------------------------------------------------------------
--<wd>feb2005
-- Check if MDS Support is a MDS GROUP
   if (!mdsobject.mdsdata.mdsgroup) then
-- MDS "GROUP" Support comprises of a MASTER MDS FRAMEWORK STRUCTURE Support plus ONE or MORE MDS HANGER Supports
-- The MDS GROUP MAIN members are held in the OBJECT member ".maingroupmem"

     !maingroupmem = !mdsobject.mdsdata.maingroupmem
     do !mainmem values !maingroupmem
-- Setup dimensioning objects and ADD DIMENSIONS to the View for EACH member of the MDS GROUP
       !!ce = !mainmem
       !members = !!mdsabasupportmem(!!ce)
       !!ce = !ce
       !pipedimensionobject = object MDSABADIMPIPE(!members,!view)
       !pipedimensionobject.dimension(!params,!type,!mdsobject)

       if (!mainmem.type.neq('STRU')) then
         if (!mainmem.cref.type.eq('HANG')) then
           !hang = !mainmem.cref
           !hangdimensionobject = object MDSABADIMHANG(!hang,!view)
           --!hangdimensionobject.dimension(!params)
           !hangdimensionobject.dimension(!params,!mdsobject)
         endif
       elseif (!support.type.eq('STRU') and !struancdimsflag ) then
         !!ce = !support
         !members = !!mdsabasupportmem(!!ce)
         !!ce = !ce
         !attadimensionobject = object MDSABADIMATTA(!members,!view)
         !attadimensionobject.dimension(!params,!mdsobject)
       endif
     enddo

---------------------------------------------------------------------------------------------------
   else
-- "INDIVIDUAL" MDS FRAMEWORK STRUCTURE or MDS HANGER Support elements are stored in !members
-- Setup dimensioning object and ADD COORDINATES to the View
     !!ce = !support
     !members = !!mdsabasupportmem(!!ce)
     !!ce = !ce


--   q var !support.type
--   q var !mdsobject.mdsdata.supptype
--   q var !struancdimsflag
--   $P #######################################
--   $P
--
--   if (!view.name.matchwild('*/V4*')) then
--     $R109 /C:/mdsabaancdims-trace.pmllog
--   else
--     $R
--   endif

--------------------------------------------
--<wd>11mar2008-DUN824 and Defect No. P-4405
-- The CODE below using the variable "!pipedimensionobject" is causing DUPLICATE Overall DIMENSIONS
-- and Duplicate CO-ORDINATES on MDS HANGER support MDS ABA Drawing Views.
-- Therefore the "if" statement has been added to EXCLUDE this CODE when the support is a MDS HANGER
--
--<wd>28apr2008 -- This "if" statement is NOT DIMENSIONING the PIPE POSITIONS or CENTRELINE HEIGHTS etc...
--     if (!support.type.eq('STRU')) and (!mdsobject.mdsdata.supptype.eq('ATTA')) then
     if (!support.type.eq('STRU')) then
--<wd>28apr2008
--<wd>11mar2008-DUN824 and Defect No. P-4405
--------------------------------------------

       !pipedimensionobject = object MDSABADIMPIPE(!members,!view)
       --!pipedimensionobject.dimension(!params,!type)
       !pipedimensionobject.dimension(!params,!type,!mdsobject)

--------------------------------------------
--<wd>11mar2008-DUN824 and Defect No. P-4405
     endif
--<wd>11mar2008-DUN824 and Defect No. P-4405
--------------------------------------------

     if (!support.type.neq('STRU')) then
--<wd>feb2005
       if (!mdsobject.mdsdata.supptype.eq('ATTA')) then
         !!ce = !support
         !members = !!mdsabasupportmem(!!ce)
         !!ce = !ce
         !attadimensionobject = object MDSABADIMATTA(!members,!view)
         !attadimensionobject.dimension(!params,!mdsobject)

       elseif (!mdsobject.mdsdata.supptype.eq('HANG')) then
--<wd>feb2005

         if (!support.cref.type.eq('HANG')) then
           !hang = !support.cref
           !hangdimensionobject = object MDSABADIMHANG(!hang,!view)
           --!hangdimensionobject.dimension(!params)
           !hangdimensionobject.dimension(!params,!mdsobject)
         endif
--<wd>feb2005
       endif
--<wd>feb2005
     elseif (!support.type.eq('STRU') and !struancdimsflag ) then
       !!ce = !support
       !members = !!mdsabasupportmem(!!ce)
       !!ce = !ce
       !attadimensionobject = object MDSABADIMATTA(!members,!view)
       !attadimensionobject.dimension(!params,!mdsobject)
     endif

   endif
--<wd>feb2005
---------------------------------------------------------------------------------------------------

--<wd>feb2005
-- *** ORIGINAL CODE shown below for INDIVIDUAL MDS FRAMEWORK STRUCTURES or MDS HANGERS included in the NEW CODE shown above *** --
$(
  !pipedimensionobject = object MDSABADIMPIPE(!members,!view)

  !pipedimensionobject.dimension(!params,!type)

  if !support.type.neq('STRU') then
    if !support.cref.type.eq('HANG') then
      !hang = !support.cref
      !hangdimensionobject = object MDSABADIMHANG(!hang,!view)
      !hangdimensionobject.dimension(!params)
    endif
  endif
$)
--<wd>feb2005
-------------------------------------------------------------------------------------
--------------------------------------------------------------------------------
 endfunction
-- End of Function - !!mdsabaancdims.pmlfnc
