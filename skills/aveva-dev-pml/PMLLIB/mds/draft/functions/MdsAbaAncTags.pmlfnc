--
-- File: MdsAbaAncTags.pmlfnc
--   Type: Function
--
-- Author: Martin Wright
-- Created: 20 June 2002
--
--
-- Description:
-- Function to Add MDS Framework Ancillary Labels to ABA Drawing
------------------------------------------------------------------------
-- Revision 0 20-06-2002 Development Session
------------------------------------------------------------------------

--<wd>feb2005
--define function !!mdsabaanctags(!view is dbref,!params is string)
define function !!mdsabaanctags(!view is DBREF,!params is STRING, !mdsobject is MDSABASUPPORT)
--<wd>feb2005

--------------------------------------------
--<wd>02apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
-- Obsolete Parameter Nos and Some Pen Attributes    -- Params passed as string
-- Obsolete Parameter Nos and Some Pen Attributes    -- 1  Leader Line         LLEAD
-- Obsolete Parameter Nos and Some Pen Attributes    -- 2  Text Frame          LFRAME
-- Obsolete Parameter Nos and Some Pen Attributes    -- 3  Text Pen            TPEN
-- Obsolete Parameter Nos and Some Pen Attributes    -- 4  Text Font           FONT
-- Obsolete Parameter Nos and Some Pen Attributes    -- 5  Leader Line Pen     LLPN
-- Obsolete Parameter Nos and Some Pen Attributes    -- 6  Text Box Pen        LFPN
-- Obsolete Parameter Nos and Some Pen Attributes    -- 7  Terminator Size     TSIZE
-- Obsolete Parameter Nos and Some Pen Attributes    -- 8  Terminator          LTERM
-- Obsolete Parameter Nos and Some Pen Attributes    -- 9  Label shape         SYTM/TXTM name or empty string if not set

-- NEW 12.0 version Parameters (Pen Attributes etc...) passed as a STRING
-- *** IMPORTANT NOTE ***
-- ONLY 11 parameters are passed here as the ORIGINAL 1st parameter value (TRUE or FALSE ) in the STRING of 12 Parameters
-- has been REMOVED in the MDS ABA MAIN VIEW calling ABA TASK FUNCTION "mdsabaviewtask.pmlfnc"
-- LABEL Attributes (GLAB or SLAB)
    -- 1  Label Leader Line                 = LLEADER
    -- 2  Label Frame                       = LFRAME
    -- 3  Label Font                        = FONT
    -- 4  Label font Colour                 = TXCOLOUR
    -- 5  Label Leader Line Style           = LLSTYLE
    -- 6  Label Leader Line Colour          = LLCOLOUR
    -- 7  Label Frame Line Style            = LFSTYLE
    -- 8  Label Frame Line Colour           = LFCOLOUR
    -- 9  Label Leader Line Terminator Size = TSIZE
    -- 10 Label Leader Line Terminator Type = LTERMINATOR
    -- 11 Label Shape                       = TMRF for SYTM/TXTM name reference or an EMPTY string, i.e. '', if the "NO FRAME" option has been selected
--
--<wd>02apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

  !passedparams = !params.split(',')
  context draw
  !view = !!ce
  prec 2 dp
  !units = object COMUNITS(TRUE)
  !distIndex = !units.getDimensionIndex('DIST')

-- Set UNITS to metric for making task work when in imperial.
--   UNITS MM Bore
--   UNITS MM Distance

-- Load task parameter form ready for use.
--   LOADFORM !!mdsabaanctags

--------------------------------------------
--<wd>08apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
-- check !passedparams[9] for validity and set up the label creation command and label text attribute name
--   if undefined(!passedparams[9]) then
--      !passedparams[9] = ''
--
-- check !passedparams[11] for validity and set up the label creation command and label text attribute name
   if undefined(!passedparams[11]) then
      !passedparams[11] = ''
   endif

--   !tmrfname = !passedparams[9].trim()
   !tmrfname = !passedparams[11].trim()
--
--<wd>08apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

   -- check if string holds PDMS name
   if !tmrfname.match('/').neq(1) then
      !tmrfname = ''
   endif

   if !tmrfname.empty() then
      !createlabel = 'new GLAB'
      !setuplabel = ''
      !labeltext = 'btext'
   else
      !createlabel = 'new SLAB'
      !setuplabel = 'tmrf $!tmrfname'
      !labeltext = 'atext'
   endif

--<wd>feb2005
-- The MDS Support Name is now taken from the passed OBJECT !mdsobject
-- Navigate to SHEE
   --SHEE
   --GOTO DARREF
   --var !supname NAME
   --!supname = !supname.substring(1,!supname.match(|-AREA|) - 1)
   !supname = !mdsobject.support.name
--<wd>feb2005

-- Return to VIEW
   !!ce = !view

-- Goto layers of view and create new one for steel labels.
-- Now create new layer for "comp" table.
   !name = NAME OF VIEW
   !notes = !name & |/AncilTags_Task|
   $!notes
   handle (2,109)
     NEW LAYER
     NAME $!notes
   elsehandle none
     delete LAYER
     NEW LAYER
     NAME $!notes
   endhandle

-------------------------------------------
--<wd>02apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
-- Set passed parameters
--   LLEAD  $!passedparams[1]
--   LFRAME $!passedparams[2]
--   TPEN   $!passedparams[3]
--   FONT   $!passedparams[4]
--   LLPN   $!passedparams[5]
--   LFPN   $!passedparams[6]
--   TSIZE  $!passedparams[7]
--   CHEI   $!passedparams[7]
--   LTERM  $!passedparams[8]
--
-- Set the Dimension Attibutes Form with the Stored Values at the View Task
-- All of the 'handle any' lines etc.. have been added to ensure that the MDS ABA default value is USED if an ERROR occurs
-- At LAYER level
--
-- Set the LABEL Attributes with the Passed Parameters
   LLEADER     $!passedparams[1]
   handle ANY
     LLEADER TRUE
   endhandle
   LFRAME      $!passedparams[2]
   handle ANY
     LFRAME FALSE
   endhandle
   FONT        $!passedparams[3]
   handle ANY
     FONT 31
   endhandle
   TXCOLOUR    $!passedparams[4]
   handle ANY
     TXCOLOUR 3
   endhandle
   LLSTYLE     $!passedparams[5]
   handle ANY
     LLSTYLE Solid
   endhandle
   LLCOLOUR    $!passedparams[6]
   handle ANY
     LLCOLOUR 5
   endhandle
   LFSTYLE     $!passedparams[7]
   handle ANY
     LFSTYLE Solid
   endhandle
   LFCOLOUR    $!passedparams[8]
   handle ANY
     LFCOLOUR 6
   endhandle
   TSIZE       $!passedparams[9]
   handle ANY
     TSIZE 3
   endhandle
   LTERMINATOR $!passedparams[10]
   handle ANY
     LTERMINATOR Arrows
   endhandle
--
--<wd>02apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

   !!mdsabamtocomp.data.attas.unique()
   !counter = 2

   do !tag index !!mdsabamtocomp.data.elements[2]
     skip if (!tag eq 1)
     if !!mdsabamtocomp.data.elements[1][$!tag].eq(' ') then
       skip
     endif
      $!createlabel
     !ddname = !!mdsabamtocomp.data.attas[!counter].dbref()
       handle ANY
         skip
       endhandle
     !counter = !counter + 1
--<wd>feb2005
     if (!supname.dbref().type.eq('STRU')) then
-- MDS Framework Structure Support or MDS Group Support
       ddname $!ddname
     else
       if (!mdsobject.mdsdata.supptype.eq('ATTA')) then
-- MDS Ancillary Support
         ddname $!ddname
--<wd>feb2005
       elseif !supname.dbref().type.eq('ATTA') and !supname.dbref().cref.type.eq('HANG') then
-- MDS Hanger Support
          DDNAME $!supname
        endif
     endif
--<wd>feb2005
     $!labeltext |$!!mdsabamtocomp.data.elements[1][$!tag]|
     $!setuplabel
   enddo

-- If the user has added a support as a ref item then tag it as ref
   !unuseddatum = !supname + '/DATUM'

--<kp>july06
   --!refitems = !unuseddatum.dbref().:MDSAdp
   !refitems = !mdsobject.getelemforuda().:MDSAdp
     handle ANY
     elsehandle NONE
       !foundstru = ARRAY()
       !bars = ARRAY()
       !counter = 1
       do !findstru values !refitems
         !foundstru.append(stru of $!findstru)
           handle ANY
             skip
           endhandle
         !bars.append(!refitems[$!counter])
         !counter = !counter + 1
       enddo
       --!foundstru.unique()
       !tagged = ARRAY()
       !counter = 1
       do !addref values !foundstru
-- Only add if a MDS support
         if !addref.:MDSSuppType.neq('') then
         -- if !addref.:MDSSuppType.set() then
           !struname = !addref.namn
           handle ANY
             skip
           endhandle
           if !tagged.findfirst(!struname).unset() then
             $!createlabel ddnm $!refitems[$!counter]
--             NEW GLAB ddnm $!addref
             $!labeltext |$!struname#/(REF.)|
             $!setuplabel
             !tagged.append('$!struname')
           endif
         endif
         !counter = !counter + 1
       enddo
       do !findhang values !refitems
         !unusedtestexists = !findhang.name
           handle NONE
             if !findhang.type.eq('HANG') then
               !nameofhang = !findhang.owner.namn.before('/REST')
               $!createlabel ddnm $!findhang
               $!labeltext |$!nameofhang#/(REF.)|
               $!setuplabel
             endif
           elsehandle ANY
           endhandle
       enddo
     endhandle

-- If the support belongs to a trunnion but is not part of this support add a ref to the trunnion
   !guidelist = ARRAY()
   do !addref values !!mdsabamtocomp.data.attas
     !unusedtest = !addref.dbref()
       handle ANY
         skip
       endhandle
     !isitatrunnion = !addref.dbref().owner.:MdsTrun
       handle ANY
         skip
       endhandle
     !amhere = !!ce
     if !isitatrunnion then
       !!mdssilent = TRUE
       !!ce = !addref.dbref()
       !detailingsupport = !!mdsgetsuppname(!!ce)
       !!ce = !addref.dbref().owner
       !trunnionname = !!mdsgetsuppname(!!ce)
       !!mdssilent.delete()
       !!ce = !amhere
       if !detailingsupport.neq(!trunnionname) then
         $!createlabel ddnm $!addref
         !trunnionname = !trunnionname.after('/')
         $!labeltext |$!trunnionname#/(REF.)|
         $!setuplabel
       endif
     else $* its not a trunnion
       !dist = !units.savedUnits[!distIndex]
       !unusedisitatta = !addref.dbref().type
       handle ANY
         skip
       endhandle
       !unusedtestcle = !addref.dbref().prop.clr
       handle (2,207)
-- error property does not exist
       elsehandle NONE  $* its got a clr property
-- now we have found a clearance we need to exclude some which are not required
         !desc = !addref.dbref().prop.desc

--<wd>may2007<mds12>
--          if (not !desc inset ('AN05','AN17','AT22','BT04A','BT04B','BT04C','BT06','BT07','GT13','GT14')) then
          if (not !desc inset ('AN05','AN17','AT22','BT04A','BT04B','BT04C','BT06','BT07','GT13','GT14','BT10','BT11')) then
--<wd>may2007<mds12>

             -- find out if a clearance note is required
             !clr = !!mdsgetguidegap(!addref.dbref())
             if !clr.neq(0) then
               if !dist.neq('mm') then
                 $!dist distance
                 !clr = $!clr
                 -- Output gap sizes in INCHES a NOT Feet and INCHES
                 !gaptext = !clr.distance(false,true,true,16,false)
               else
                 !gaptext = !clr & 'mm'
               endif
               $!createlabel
           ---- ge 3/4/5 Fix for HPD0028007 Gap Text to point at the guide GT26 gap ----
               if (!desc inset ('GT26')) then
                 !!ce.ddnm = !addref.dbref()
                 nppt 12
                 handle ANY
                 endhandle
               else
                  !!ce.ddnm = !addref.dbref().:MDSGuideRef
                  nppt 9
                  handle ANY
                  endhandle
               endif
          ---- ge 3/4/5 Fix This was the original code ----
          --  nppt 9
          --  handle ANY
          --  endhandle
          --  !!ce.ddnm = !addref.dbref().:MDSGuideRef
-- TRIM POSSIBLE DOUBLE SPACES
               !gaptext = !gaptext.trim()
               !gaptext = !gaptext.trim('m',' ')
               !!ce.$!<labeltext> = |$!gaptext GAP|
               $!setuplabel
             endif
          endif
       endhandle

--<wd>02apr2008 - DUN824 - Defect No. P-4526
-- This LABEL is NOT used anywhere in this file. so it's been commented out!!!
--        label /flyingshoe

--- go and do the bit for flying shoes
        if !addref.dbref().:MDSGuideRef.unset() or !addref.dbref().:MDSGuideRef.badref() then
          skip
        else

-- HPD0027729 This is a fix that looks through the atta's on a special support and finds
-- if there is a slip unit that might not be set as the :MdsGuideRef of the DATUM
-- HPD0028011 Also a fix has been added for when an AT65 added to a support that has a
-- shoe e.g. AT96 as it modifies the HEI property and causes gap text
           !skip = FALSE
           do !loopthroughattas values !!mdsabamtocomp.data.attas
               if !loopthroughattas.dbref().badref().not() then
                 if !loopthroughattas.dbref().catref.owner.:MdsType.eq('SLIP') or !loopthroughattas.dbref().styp inset ('AT65') then
                   !skip = TRUE
                 endif
               endif
            enddo

-- There are certain standards that are referenced through the :MdsGuideRef but do not require the
-- flying shoe note. i.e slip units
           if !addref.dbref().styp inset ('AT30','AT33A','AT33B','AT33C','AT33D','AT33E','AT33F') then
             skip
           elseif !addref.dbref().styp inset ('AT34A','AT34B','AT34C','AT34D','AT34E','AT34F') then
             skip
           elseif !addref.dbref().styp inset ('AT35','AT40A','AT40B','AT40C','AT40D','AT40E','AT40F') then
             skip
           elseif !addref.dbref().styp inset ('AT41A','AT41B','AT41C','AT41D','AT41E','AT41F') then
             skip
           elseif !addref.dbref().styp inset ('AT59','AT68','AT100A','AT100B','AT101A','AT101B') then
             skip
           elseif !addref.dbref().:MdsGuideRef.catref.owner.:MdsType.eq('SLIP') then
             skip
-- Fix for HPD0026926 ge-29/11/04
            elseif !addref.dbref().:MDSGuideRef.styp.matchwild('*ST*') then
              skip
            elseif !addref.dbref().styp.matchwild('*ST*') then
              skip
           elseif !skip then
             skip
-- Fix end
           else
             !h1 = !addref.dbref().prop.hei.real()
               handle ANY
               elsehandle NONE
                 !h2 = !addref.dbref().:MDSGuideRef.prop.hei.real()
                   handle ANY
                   elsehandle NONE
-- properties always come out in mm so the
                     !gap = abs(!h2 - !h1)
                     if !gap gt 2 and !addref.dbref().:MDSGuideRef.badref().not() and !guidelist.findfirst(!addref).unset() then
-- Temporarily Set Distance Units Back to the Required Output units
                       if !dist.neq('MM') then
                         $!dist distance
                         !gap = $!gap
-- Output gap sizes in INCHES a NOT Feet and INCHES
                         !gaptext = !gap.distance(false,true,true,16,false)
                       else
                         !gaptext = !gap & 'mm'
                       endif
-- Set Distance Units Back to Metric in all cases
                       $!createlabel ddnm $!addref
--$p $!!ce.type created
                       nppt 9
                       handle ANY
                       endhandle
                       !!ce.$!<labeltext>= |$!gaptext GAP TO#/BE MAINTAINED#/BENEATH SHOE|
                       !guidelist.append(!addref.dbref().:MDSGuideRef.string())
                       $!setuplabel
                     endif
                   endhandle
                endhandle

            endif
         endif
      endif
   enddo


-- Add size tags for Connected steelwork
-- This works but the leader line point to the middle of the sctn
-- this sometimes moves out of the view, removed code until we can
-- revisit

-- $(
--
--     var !sctns coll all sctn for $!supname
--     do !JointsForSctns values !sctns
--       !Jois = jois of $!JointsForSctns
--       !Joie = joie of $!JointsForSctns
--       if !jois.unset().not() then
--         !JointStru = stru of $!Jois
--         if !supname.matchwild(!JointStru.name).not() then
--           NEW GLAB ddnm sctn of $!jois
--           Btext '#:mdssizetag<from catr>'
--         endif
--       endif
--       if !joie.unset().not() then
--         !JointStru = stru of $!Joie
--         if !supname.matchwild(!JointStru.name).not() then
--           NEW GLAB ddnm sctn of $!joie
--           Btext '#:mdssizetag<from catr>'
--         endif
--       endif
--     enddo
--
-- $)

  !!ce = !view
   !units.restoreSavedBoreDist()
  prec var def

endfunction
-------------- End Of Code --------------
