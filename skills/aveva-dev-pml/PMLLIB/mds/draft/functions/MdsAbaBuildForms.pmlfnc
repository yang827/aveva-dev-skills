--
-- File:                MdsAbaBuildForms.pmlfnc
--   Type:              Function Definition
--   Group:             MDS ADP support fabrication drawings
--     Keyword:         FAB
--   Module:            Draft
--   Replaces:
--
-- Author:              Neale Morris
-- Created:             Tue Aug 19 1997
--
--
-- Description:
-- Function load all the forms for the MDS App
--
----------------------------------------------------------------------
--
-- Arguments:
--
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
----------------------------------------------------------------------
--
-- Define function
define function !!mdsababuildforms()

  -- Build Forms in this order
  pml load form !!mdsabaselsupp

  --<wd>feb2007<mds12>
  -- FORM !!mdsabasupdefs NOT USED at MDS12
  --  pml load form !!mdsabasupdefs
  --<wd>feb2007<mds12>

  -- Load dummy format gadget form
  pml load form !!kformattext

  -----------------------------------------------------------------------------------------
  --<wd>feb2007<mds12>
  --
  -- On initial entry to the MDS12 ABA DRAFT Application LOAD the MDS FRAMEWORK ALTERNATIVE
  -- CODE Descriptions for the individual MDS FRAMEWORK SUPPORT CODES "Type and Size"
  --clock init
  if (undefined(!!mdsaltdft0911)) then
    --$P ** INITIAL Loading ** object MDSALTDDEFS() ** in MDSDFLTS form **
    !!mdsaltddefs = object MDSALTDDEFS()
    --clock read elapsed
    --$P
    !errortype = !!mdsaltddefs.altderrortype
    !errormess = !!mdsaltddefs.altderrortext

    if (!!mdsaltddefs.altdcheck.not()) then
      -- MDS ABA DRAFT Application ALTERNATIVE CODE Descriptions NOT successfully loaded
      !!appxload('DRA','GEN', FALSE)
      return error 1 |$!<errormess>. ABORTING entry to the MDS ABA Drawing Application.|

    elseif(!errortype.trim().eq(|WARNING|)) then
      -- Advise USER of a "MISSING" MDS DEFAULTS "STRUCTURAL CATALOGUES,
      -- However ALLOW ENTRY to the MDS DESIGN Application.
      -- The CLIENT DESCRIPTIONS and CODES have been PARTIALLY loaded
      !!alert.warning(|$!<errormess>|)

    endif
  endif
  --
  --<wd>feb2007<mds12>
  -----------------------------------------------------------------------------------------
endfunction
