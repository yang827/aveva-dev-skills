-- Created:		Tuesday 26th April 2005
--
--
-- Description:
-- Function to clean a shee of
-- Ldim with no members
-- Empty Layers (not with USER in name)
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
-- Define Function

define function !!MdsAbaCleanShee(!Shee is dbref)

-- Goto to sheet level and collect elements to delete

  !!ce = !Shee
  !SheeName = !!ce.name

  var !EmptyLdims coll all ldim with mcount eq 0 for ce

  do !Ldims values !EmptyLdims
    !!ce = !Ldims.dbref()
    delete ldim
      handle ANY
      endhandle
  enddo

  !!ce = !Shee

  var !EmptyLayers coll all laye with mcount eq 0 and not matchwild(name,'*USER*') for ce

  do !Layers values !EmptyLayers
    !!ce = !Layers.dbref()
    delete laye
      handle ANY
      endhandle
  enddo

-- Go back to original shee

  !!ce = !shee

endfunction

-- End of Function - MdsAbaCleanShee.pmlfnc
