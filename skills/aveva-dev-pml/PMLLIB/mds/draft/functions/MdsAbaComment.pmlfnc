--
-- File:            MdsAbaComment.pmlfnc
--   Type:          Function
--
-- Author:          Martin Wright
-- Created:         2 July 2002
--
--
-- Description:
-- Basic task function called for showing support/hanger stru text on sheet.
------------------------------------------------------------------------
-- Revision 0 11-06-2002 Development Session
------------------------------------------------------------------------
define function !!MdsAbaComment(!params is ARRAY)

-- Navigate to SHEE
  SHEE
  !sheet = !!ce
  GOTO DARREF
  var !supname NAME
  !supname = !supname.substring(1,!supname.match(|-AREA|) - 1)

--<wd>feb2005
-- Determine if the support is a MDS GROUP
  $!supname
  handle (2,109)
-- Check if MDS Support is the MASTER STRUCTURE, number [1], of a MDS GROUP, if UNDEFINED NAME error(2,109) occurs
    !supname= !supname + '[1]'
    !!ce = !supname.dbref()
  endhandle
--<wd>feb2005

  Prec 2 dp
  !units = object COMUNITS(TRUE)

-- Set UNITS to metric for making task work when in imperial.
  UNITS MM Bore
  UNITS MM Distance

-- Check to see if :MDSCOMMENT attribute is set.
  if (!!mdsabamtosteel.data.suptype.eq('HANG')) then
    --!text = :MDSComment of CREF OF $!supname
    !text = :MDSComment of $!supname
  else
    !text = :MDSComment OF $!supname/DATUM
    handle ANY
      !text = :MDSComment OF $!supname
    endhandle
  endif


  handle (2,751)
-- Message to logfile
    !!abalogging.error('    **** Cannot Locate MTO Table in any View - Aborting Comment Task ****')
    !!ce = !sheet
    return
  endhandle

-->>>-<wd>sep2002
--   if (!text.unset()) then
   if ( (!text.unset()) or (!text.lowcase().trim().eq('unset')) or (!text.lowcase().trim().eq('')) ) then
-- NO ACTION REQUIRED because the variable
-- !text is set to unset or is an invalid text
     return
   elseif (!text.unset().not()) then
--<<<-<wd>sep2002

-- Goto layers of view and create new one for comment.
     !!ce = !sheet
     !name = NAME OF SHEET
     !notes = !name & |/Comment_Task|
     $!notes
     handle (2,109)
       NEW NOTE
       NAME $!notes
     elsehandle none
       DELETE NOTE
       NEW NOTE
       NAME $!notes
     endhandle

     NEW TEXP
     BTEXT |$!text|

-- Go off and find position of the bottom of the MTO table
-- and use that as placement of the text string.
     var !task COLL ALL LAYER WITH (ATTRIB FUNCTION EQ 'MTO-Task') FOR SHEET
       do !tsk value !task
         !last = REF OF $!tsk
         var !name NAME OF $!last
         !lastelem = !last.mem[!last.mem.size()]
         var !scale SPLIT XYSCALE OF $!lastelem
         !tablewidth = !scale[1].real() - 2

         if (!name.match('STEEL_Task') gt 0) then
           --$P End of Steel MTO
           !SteelPos = !!mdsabamtosteel.data.endpos.north
         endif
         if (!name.match('COMP_Task') gt 0) then
           !CompPos = !!mdsabamtocomp.data.endpos.north
         endif
       enddo

       if !SteelPos.lt(!CompPos) then
         !Pos = 'X ' & !!mdsabamtosteel.data.endpos.east &  ' Y ' & !!mdsabamtosteel.data.endpos.north
       else
         !Pos = 'X ' & !!mdsabamtocomp.data.endpos.east &  ' Y ' & !!mdsabamtocomp.data.endpos.north
       endif

       chei 3
       align tbody

       XYPOS $!pos

       -- Now tweek the position of the text to be below the table defined.
       BY Y -6
       BY X 2

       -- Workout whether the text string needs to be split into more than one line of text.
       var !extent SPLIT EXTENT BTEXT
       !btext = BTEXT
       !width = !extent[6].real() - !extent[2].real()
       if (!width GT !tablewidth) then
           !first = !btext.split(' ')
           !test = !first[1]
           !space = ' '
           -- Text is longer than the space available, split into two.
           do !char from 2 to 30
              !previous = !test
              !test = !test & !space & !first[!char]
              BTEXT '$!test'
              var !extent2 SPLIT EXTENT BTEXT
              !twidth = !extent2[6].real() - !extent2[2].real()
                if (!twidth GT !scale[1].real() OR !twidth EQ !scale[1].real()) then
                    -- Text is right width.
                        !second = !first[!char]
                     do !rest from !char + 1 to !first.size()
                        !second = !second & !space & !first[!rest]
                     enddo
                         BTEXT '$!previous#/$!second'
                         BY Y -6
                         break
                endif
           enddo
       endif
       REFRESH
   endif

-- If params are passed X Y then put the text there

   if (defined(!Params[1])) and (defined(!Params[2])) then
     xypos $!Params[1] $!Params[2]
   endif

-- Return to where we came in.
  !!ce = !sheet

  !units.restoreSavedBoreDist()
  Prec var def

endfunction

-------------- End Of Code --------------
