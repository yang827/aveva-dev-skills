--
-- File:            MdsAbaCplWei.pmlfnc
--   Type:          Function
--
-- Author:          Wayne Dodwell
-- Created:         Thursday 18th December 2009
--
-- Description:
-- New Function to obtain the total weight of all MDS WitchHanger (CPL) hangers
-- in a RESTRAINT or a MDS GROUP type SUPPORT - DFN P-23513 (SI-4931)
------------------------------------------------------------------------
------------------------------------------------------------------------
-- Define Function
define function !!mdsAbaCplWei(!hanger is DBREF) is ARRAY

  -- Initialise variables
  !ce = !!ce
  !weightsArray = ARRAY()
  !totalWeight = 0

  -- Access Hanger and Restraint from the ATTA on the Pipe branch
  !!ce = !hanger
  if !!ce.type.eq('ATTA') then
    -- Navigate to the Owning Hanger and RESTRAINT
    goto cref
    rest
    handle ANY
      -- Abort this PML function
      !!abalogging.error('    Unable to access element type REST from this level')
      !!ce = !ce
      return !weightsArray
    endhandle

    -- Determine the <MDSABASUPPORT> OBJECT for the current MDS GROUP, FRAMEWORK or HANGER
    if (!hanger.name.matchwild('*[*')) then
      !restraint  = !!ce
      !mdsGroupBF = !hanger.name.before('[')
      !mdsGroupNM = !mdsGroupBF & '[1]'
      !mdsGroupDB = !mdsGroupNM.dbref()
      !mdsObject  = !!mdsAbaSuppObj(!mdsGroupDB)
      if (!mdsObject.mdsData.mdsGroup) then
        -- MDS HANGER belonging to a MDS GROUP
        var !restMem collect all hanger mem for $!restraint
        !hangMem = ARRAY()
        do !indx indices !restMem
          skip if !restMem[!indx].dbref().type.eq('REST')
          skip if !restMem[!indx].dbref().type.eq('HANG')
          skip if !restMem[!indx].dbref().type.eq('TEXT')
          !hangMem.append(!restMem[!indx])
        enddo
      endif

    else
      -- Individual MDS HANGER, i.e. NOT in a MDS GROUP SUPPORT
      !hangMem = !!mdsAbaMtoSteel.data.dbrefs
    endif
  else
    -- Individual weight
    !hangMem = ARRAY()
    !hangMem.append(!!ce.string())
  endif

  --Calculate the Total Weight of all the MDS WitchHanger (CPL) HANGERS in a RESTRAINT or in a MDS GROUP SUPPORT
  do !getWeight values !hangMem
    !!ce = !getWeight.dbref()
    if (!!ce.type.neq('REST') and !!ce.type.neq('HANG') and !!ce.type.neq('TEXT')) then
      -- All MDS CPL HANGER Component Weights are in "kgs"
      !componentWeight = !!ce.:MDSCPLWEIGHT
      !weightsArray.append(!!ce.:MDSCPLWEIGHT)
      !totalWeight = !totalWeight + !componentWeight
    endif
  enddo

  !weightsArray.append(!totalWeight)
  !!ce = !ce

  return !weightsArray

endfunction
