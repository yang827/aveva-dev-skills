-- File:                MdsAbaDelDrwg.pmlfnc
--   Type:              Function
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            Draft MDS using ABA
--   Replaces:
--
-- Author:              Karel Pleschner
-- Created:             12 April 2005
--
--
-- Description:
-- Delete MDS Drawing including external refs. if they are exclusive to drwg
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--    Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
-- Define Function
define function !!MdsAbaDelDrwg()

    !Drwg = drwg
     handle ANY
       !!alert.error('Cannot access DRWG from this level')
       return
     endhandle

     if !Drwg.Func.neq('MDS') then
        !!Alert.Error('Not and MDS Drawing')
        return
     endif

     if !Drwg.Lock then
        !!Alert.Error(!Drwg.Namety + ' is locked')
        return
     endif

     !Area = nulref
     !Area = darref of shee 1 of $!Drwg
        handle NONE
           -- check if there is more sheets using this area
           var !AnotherSheet collect all SHEE with darref eq $!Area
        elsehandle ANY
           !AnotherSheet = ARRAY()
        endhandle


     if !!Alert.Confirm('O.K. to delete ' + !Drwg.Namety + ' ?').Boolean().Not() then
        return
     endif

     !!CE = !drwg
     !Regi = !!CE.Owne
      delete DRWG
        handle (2,18)
          unlock all
          delete drwg
            handle ANY
              !!Alert.Error(!!Error.Text)
              return
            endhandle
        elsehandle ANY
          !!Alert.Error(!!Error.Text)
          return
        endhandle

      if !Area.Badref().Not().and(!AnotherSheet.Size().eq(1)) then
         !!CE = !Area
         delete $!!CE.Type
           handle ANY
              !!Alert.Error(!!Error.Text)
              return
           endhandle
         !!CE = !Regi
      endif

endfunction
-- End of Function - MdsAbaDelDrwg
