-- File:                MdsAbaDimplt.pmlfnc
--   Type:              Function
--   Group:             Multi Discipline Supports Application
--     Keyword:         MDS
--   Module:            Draft MDS using ABA
--   Replaces:
--
-- Author:              Karel Pleschner
-- Created:             31 March 2005
--
--
-- Description:
-- Cerate dimension compensation plate of ancillary (PJOI of gtyp COMB/BEAR/PART)
--
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]       [Description]
--     1     RW       MDSABASUPPORT     Clearance from dimension line
--     2     R        DBREF             DB position (e.g. VIEW)
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
-- Define Function
define function !!MdsAbaDimplt(!Mdsobject is MDSABASUPPORT,!Viewref is DBREF)

   !!mdsobject = !mdsobject

   if !Mdsobject.abadata.views.find(!Viewref.name).Unset() then
      return
   endif

   !Support = !mdsobject.support
   if !Support.Type.neq('STRU') then
      return
   endif

   if !Support.:MDSSuppType.neq('SPECIAL') then
      return
   endif


   var !allplate collect all PJOI with gtyp eq 'COMB' for $!Support
   var !allplate append collect all PJOI with gtyp eq 'BEAR' for $!Support
   var !allplate append collect all PJOI with gtyp eq 'PART' for $!Support

   if !allplate.Unset() then
      return
   endif

--   $p $!viewref.name
   !Layer = object DBREF(!ViewRef.Name + '/STEEL_Dims')
   !!CE = !Layer
   !ViewDir = !Viewref.dir.wrt(worl)
   var !strup viewdir Up
   var !strleft viewdir left
   !Up = !strup.Direction().wrt(worl)
   !Left = !strleft.Direction().wrt(worl)

   do !Plate values !Allplate
      !PlateRef = !Plate.Dbref()
      skip if !PlateRef.Rpro.Xlen.eq(!PlateRef.Rpro.Ylen)
      !Zdir = !Plateref.ori.Zdir().wrt(worl)
      !Xdir = !Plateref.Ori.Xdir().wrt(worl)
      !Ydir = !Plateref.Ori.Ydir().wrt(worl)

      if !Xdir.eq(!Left).or(!Xdir.Opposite().eq(!Left)) then
         new LDIM
         dir $!strLeft
         new dpba on $!Plateref bain before
         new dpba on $!Plateref bain after
      elseif !Xdir.eq(!Up).or(!Xdir.Opposite().eq(!Up)) then
         new LDIM
         dir $!strUp
         new dpba on $!Plateref bain before
         new dpba on $!Plateref bain after
      endif

      if !Ydir.eq(!Left).or(!Ydir.Opposite().eq(!Left)) then
         new LDIM
         dir $!strLeft
         new dpba on $!Plateref bain before
         new dpba on $!Plateref bain after
      elseif !Ydir.eq(!Up).or(!Ydir.Opposite().eq(!Up)) then
         new LDIM
         dir $!strUp
         new dpba on $!Plateref bain before
         new dpba on $!Plateref bain after
      endif

   enddo

endfunction
-- End of Function - MdsAbaDimplt.pmlfnc
