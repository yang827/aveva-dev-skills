--
-- File:            MdsAbaDtlShts.pmlfnc
--   Type:          Function
--
-- Author:          Martin Wright
-- Created:         20 June 2002
--
--
-- Description:
-- Function to Add MDS Steel Framework SCTN INTERNAL and EXTERNAL JOINT Labels to ABA Drawing
------------------------------------------------------------------------
------------------------------------------------------------------------
define function !!MdsAbaDtlShts(!shee is DBREF)

-- Save current position

  !ce = !!ce

-- Access sheet

  shee

  !DarRef = DarRef

  !SuppName = !DarRef.name.string().before('-AREA')

  if !SuppName.dbref().type.eq('STRU') then

    !!CE = /MDS-Steelwork-Detailing
      handle any
-- Message to logfile
        !!abalogging.error('Unable to locate the master MDS Steelwork Detailing Options /MDS-Steelwork-Detailing element')
        return
      endhandle

-- reload the adpsteel form because this resets any lists etc that
-- has already been used.

      pml load form !!adpsteel
      !!adpsteel.init()
      handle (2,107) $* undefined reference
        -- one or more of the existing steel members has been deleted
        -- To get round this problem delete the existing detail sheets and
        -- create them from scratch
        $!Suppname$n-Details
        handle any
        elsehandle none
          DELETE DRWG
          if (!!ce.mcount.eq(0)) then
            DEPT
            DELETE DEPT
          endif
        endhandle
        -- recall the init routine
        !!adpsteel.init()
        handle any
-- Message to logfile
          !!abalogging.error('Problems running the steelwork detailing option')
          return
        endhandle
      endhandle

-- Select the correct SDAOPT

      !!AdpSteel.adpLbname.select('DTEXT','/MDS-Steelwork-Detailing')

-- Setup the steelwork detailing form

      !!AdpSteel.SelList.clear()

-- Add current design element to sheet if its a stru
-- Set the selection expression only to pick up the required stru

      !!CE = !SuppName.dbref()
      !!AdpSteel.SelTxt.val = |STRU WITH NAME EQ '$!SUPPNAME'|

-- Execute the add button to automatically add to the list

      !!CE = !Suppname.dbref()
      !!AdpSteel.AddCommand()
      same

-- Execute detailing program
      !!AdpSteel.exec()

-- Name drwg, regi and dept

  -----------------------------------------------------------
  -- Modified By S.Robinson 16th September 2002
  -- modified code section below to ensure that
  -- unnamed DEPT/REGI are handled and DRWGs are correctly
  -- owned by DEPT/REGI names /MDS-Details-Dept & /MDS-Details-Regi
  -----------------------------------------------------------

      drwg

      handle any
      elsehandle none

        !SDDrawing = !!CE
        name $!SuppName-Details
          handle any
          endhandle

        regi
        !SDRegi = !!CE
        if (!SDRegi.name.neq('/MDS-Details-Regi')) then
          name /MDS-Details-Regi
          handle (41,12) $* name already used
            -- move the new DRWG to the correct REGI
            /MDS-Details-Regi
            LAST MEMBER
            handle any
            elsehandle none
              END
            endhandle
            INCL $!SDDrawing
          endhandle
        endif

        $!SDRegi
        dept
        if (!!ce.name.neq('/MDS-Details-Dept')) then
          name /MDS-Details-Dept
          handle (41,12) $* name already used
            -- delete the DEPT if there are no REGI members
            if (!SDRegi.members.size().eq(0)) then
              DELETE DEPT
            endif
          endhandle
        endif

      endhandle


    endif

  !!ce = !ce

endfunction

-------------- End Of Code --------------
