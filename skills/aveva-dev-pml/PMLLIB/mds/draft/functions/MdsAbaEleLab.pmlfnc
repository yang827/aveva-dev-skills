--
-- File: MdsAbaEleLab.pmlfnc
--   Type: Function
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: Draft MDS using ABA
--   Replaces:
--
-- Author: Karel Pleschner
-- Created: 18 March 2005
--
--
-- Description:
-- Insert elevation labels instead of pltexts displaying elevation from given db position
--
--
-- Prerequisite:
-- LDIM - direction is U or D, pldir is 90 or -90, pjus is Away, ptang is STAND or HORI
-- VIEW must be of elevation type
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     RW       REAL          Clearance from dimension line
--     2     R        ANY           DB position (any kind of element ID)
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
-- Define Function
define function !!mdsAbaEleLab(!clear is REAL,!scan is ANY)

   !elevationArray = ARRAY()

   var !allDims collect all with (match(pltx,'EL.') gt 0 and match(pltx,'POS') gt 0 ) for $!scan

   do !dimPoint values !allDims
      !!ce = !dimPoint.dbref()

      !atex = !!ce.expltx
        handle ANY
          skip
        endhandle
      !!ce.pltx = ''

      -- convert millimetres to metres
      !elev = ''
      !composingNumb = FALSE
      do !c from 1 to !atex.length()
         !char = !atex.substring(!c,1)
         if !composingNumb then
              !checkNumb = !char.real()
                 handle NONE
                       break if !checkNumb.unset()
                       !elev = !elev + !char
                 elsehandle ANY
                    break
                 endhandle
         else
              !checkNumb = !char.real()
                 handle NONE
                    skip if !checkNumb.unset()
                    !elev = !char
                    !composingNumb = TRUE
                 elsehandle ANY
                 endhandle
         endif
      enddo

      !elevationArray.append(!elev)
      if !elevationArray.find(!elev).size().gt(1) then
        skip
      endif

      if !elev.empty().not() then
         !elevReal = !elev.real() * 0.001
         !elevinM = !elevReal.string('d3') + 'm'
         !atex = !atex.replace(!elev,!elevinM)
      endif

      !xoff = 0

--------------------------------------------
--<wd>08apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
-- The pen attribute PTPEN no longer has any effect at version 12
-- At SLAB level
--      !tpen = !!ce.ptpen
--         if !tpen.eq(0) then
--            !tpen = !!ce.owne.ptpen
--         endif
--<wd>08apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

      !ddnmx = !!ce.ddnmx
      !ddnm = !!ce.ddnm
      !pkdi = !!ce.pkdi
      !pkey = !!ce.pkey
      !dpos = !!ce.dpos
        handle ANY
          !dpos = !!ce.owne.dpos
        endhandle
      !nppt = !!ce.nppt
        handle ANY
        endhandle

      if !dpos.east.unset() then
         !dpos = !!ce.owne.dpos
      endif

      if !dpos.east.unset() then
         -- if !dpos is stil unset then calculate xpos but from first dim. point!!!!
         -- get general gradient in x direction
          if !!ce.owne.dir.wrt(worl).eq(U).and(!!ce.owne.pldir[1].eq(90)).and(!!ce.owne.doff.gt(0)) then
             !gradient = -1
          elseif !!ce.owne.dir.wrt(worl).eq(U).and(!!ce.owne.pldir[1].eq(-90)).and(!!ce.owne.doff.lt(0)) then
             !gradient = -1
          elseif !!ce.owne.dir.wrt(worl).eq(D).and(!!ce.owne.pldir[1].eq(-90)).and(!!ce.owne.doff.gt(0)) then
             !gradient = -1
          elseif !!ce.owne.dir.wrt(worl).eq(D).and(!!ce.owne.pldir[1].eq(90)).and(!!ce.owne.doff.lt(0)) then
             !gradient = -1
          else
             !gradient = 1
          endif

         !first = !!ce.owne.memb[1]
         !doff = !!ce.owne.doff
         !xpos = !first.ddnmx + (!doff * !gradient )
         handle ANY
           !pos = !first.pos.string().before('WRT')
           var !shpos shpos of $!pos
           !xpos = !shpos.split()[2].real() + !doff.abs() * !gradient
         endhandle
      else
         !xpos = !dpos.east
         if !xpos.lt(!ddnmx) then
            !gradient = -1
         else
            !gradient = 1
         endif
      endif

      !xoff = !xpos - !ddnmx - !clear * !gradient


      !xscale = !gradient * -1
      new slab
--------------------------------------------
--<wd>08apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
-- The pen attribute LFPEN no longer has any effect at version 12
-- At SLAB level
--      !!ce.lfpn = !!ce.owne.plpn
--      !!ce.tpen = !tpen
      !!ce.ddnm = !ddnm
      !!ce.pkey = !pkey
      !!ce.pkdi = !pkdi
      !!ce.nppt = !nppt
      !!ce.atex = !atex
      !!ce.tmrf = /MDS/ABA/TAGS/ELEV-BLIND
      !!ce.oset = TRUE
      !!ce.llea = FALSE
      xypo $!xoff 0
      xysc $!xscale 1

-- Use the SYTM default template values for 12.0
      lfstyle template
      txcolour template
--<wd>08apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

   enddo

endfunction
