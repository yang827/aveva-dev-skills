--------------------------------------------------------------------------------
--
-- File:		mdsabafratag
--   Type:		function defenition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Draft MDS using ABA for Drawing production
--   Replaces:
--
-- Author:		Anand Kalathil
-- Created:		10th March 2005
--
--
-- Description:
-- ------------
-- This function generates anchorage symbols on anchor plates
--
--

--
-- The SLAB is created under a layer named MDS_FraTags
--
--
--
--
--------------------------------------------------------------------------------
-- Define Function

----------------------------------------------------------
-- Arguments:
-- desItem = DBREF of support/hanger to be processed
-- view    = DBREF of view where hanger will be dimensioned
----------------------------------------------------------

define function !!mdsabafratags(!mdsobject is mdsabasupport, !view is dbref)
  !desitem  = !mdsobject.support
  !mdsgroup = !mdsobject.mdsdata.mdsgroup

  !saveRef = !!CE

-- note layer suffix
  !noteLayer = 'MDS_FraTags'

-- navigate to view

  !!ce = !View
  view
  !curview = !!ce

if !!ce.name.match('V3').gt(0) then
  $R109 /c:/temp/dtflog
endif
-- check label layer exists
  set
  */$!noteLayer
    handle any
      new layer */$!noteLayer
    endhandle
  !layer = !!ce

-- clear any existing SLABS
  delete LAYER MEMBERS
    handle any
    endhandle

  var !col collect all sctn for $!desitem
-- Add hanger element for labels as well
  if !col.size().eq(0) then
    -- check for single ancillaries
    var !col append collect all ATTA for $!desitem
  endif
  if !desitem.type.eq('ATTA') and !desitem.spref.name.matchwild('*MH01*') then
    !nameofdesitem = !desitem.name
    var !col append collect all hang for $!nameofdesitem/REST
  endif

  do !sect values !col

    $!sect

    if !!ce.:MdsAncref.unset().not() then

      do !I indices !!ce.:MdsAncref
        $!sect
        !ancref = !!ce.:MdsAncref[!I].name
        !noff = !ancref.dbref().:MdsAncref.findfirst(!!ce).string()
        --!noff = !!ce.:MdsAncref.findfirst(!ancref.dbref()).string()
        !noff = 'R' & '$!noff'
--        q var !noff
        $!ancref
        !up = p1 up wrt /*
        !ancpos = p1 pos wrt /*
        !ancdir = p1 dir wrt /*

        !line = '\' & !ancref.substring(2,7)
        !line = '$!line' & '\' & !ancref.substring(9,50).trim()
        !line = '$!line' & '\' & !ancref.dbref().spref.catref.desc.trim()

 --Find the position attribute of weld SLAB so that it can be used to find out if there are any offsets

-- dtf find out the nearest weld to !ancpos
-- to get weld at correct end before testing for offsets


        if !sect.dbref().type.eq('SCTN') or !sect.dbref().type.eq('ATTA') then
          if !sect.dbref().type.eq('SCTN')  then
--SCTN
            !Pos = ''
            !curviewdir = !curview.direction
            !sectdir = !sect.dbref().ori.zdir().wrt( /* )

            !Odist = !sect.dbref().length
            !halfOdist = ( !odist / 2 )
            var !weldtag collect all slab with matchwild(name of own,'*WeldTags*') for $!curview
            do !weld values !weldtag
              if !weld.dbref().ddnm.name.eq(!sect.dbref().name) then
                --!pos = !weld.dbref().position.string().before('WRT')
                !xpos = !weld.dbref().position.string().before('WRT')
                !xancpos = !ancpos.string().before('WRT')
                var !dist construct dist $!xpos to $!xancpos
                if !dist.real().leq(!HalfOdist) then
                  !Odist = !dist.real()
                  -- dtf >>> ignore this pos because it may not be the correct place for thr r1 label
                  --!pos = !weld.dbref().position.string().before('WRT')
                else
                endif
              endif
            enddo

            if (!pos.eq('') and !sect.dbref().type.eq('SCTN'))  or (!sect.dbref().type.eq('SCTN') and !sect.dbref().gtype.eq('PLAT')) then
              if !sect.dbref().gtype.eq('PLAT') then
                !closestpline = !!kclosestpline(!sect.dbref(), !ancpos, !ancdir)
                do !GetPlineNumber from 1 to !ClosestPline.size() by 2
                  if !ClosestPline[$!GetPlineNumber].pkey inset ('TOS','BOS') then
                    !PlineNumber = !GetPlineNumber
                    break
                  endif
                enddo
                !PlineName = pkey of $!ClosestPline[$!PLineNumber]
                var !plinedir ppline $!PlineName y dir wrt /*
                !pos = !sect.dbref().poss.wrt( /* ).string().before('WRT')
                !datumpos = !mdsobject.mdsdata.datum.position.wrt( /* )

                !pvectorpl           = object pointvector()
                !stpos = !sect.dbref().plst.$!plinename
                !endpos = !sect.dbref().plen.$!plinename
                !midpos = !stpos.midpoint(!endpos)
                !pvectorpl.position = !stpos.wrt( /* )
                !pvectorpl.direction = !plinedir.direction()

                !pvectorp9           = object pointvector()
                --!pvectorp9.position = !datumpos
                !pvectorp9.position = !midpos
                !pvectorp9.direction = !mdsobject.mdsdata.datum.pdirection[9].wrt( /* )


                !pos = !pvectorp9.intersection(!pvectorpl).string().before('WRT')
              else
                -- element must not be welded to plate so find nearest end of sctn
                !sctnpose = !sect.dbref().pose.wrt( /* ).string().before('WRT')
                !sctnposs = !sect.dbref().poss.wrt( /* ).string().before('WRT')
                !xancpos = !ancpos.string().before('WRT')
                var !edist construct dist $!sctnpose to $!xancpos
                var !sdist construct dist $!sctnposs to $!xancpos
                if !edist.real().lt(!sdist.real()) then
                  if !sect.dbref().joie.unset().not() then
                    !joie = !sect.dbref().joie.gtype
                    if !joie.eq('PART') then
                      !pos = !sect.dbref().joie.position.wrt( /* ).string().before('WRT')
                    else
                      !!ce = !sect.dbref()
                      var !plinezdir   ppline NA z dir wrt /*
                      var !plineydir   ppline NA y dir wrt /*
                      !pvectorpl           = object pointvector()
                      !endpos = !sect.dbref().plen.NA
                      !pvectorpl.position = !endpos.wrt( /* )
                      !pvectorpl.direction = !plineydir.direction()
                      !pvectoranc           = object pointvector()
                      !pvectoranc.position = !ancpos
                      !pvectoranc.direction = !plinezdir.direction()
                      !pos = !pvectorpl.intersection(!pvectoranc).string().before('WRT')
                    endif
                  endif
                else
                  if !sect.dbref().jois.unset().not() then
                    !jois = !sect.dbref().jois.gtype
                    if !jois.eq('PART') then
                      !pos = !sect.dbref().jois.position.wrt( /* ).string().before('WRT')
                    else
                      !!ce = !sect.dbref()
                      var !plinezdir   ppline NA z dir wrt /*
                      var !plineydir   ppline NA y dir wrt /*
                      !pvectorpl           = object pointvector()
                      !stpos = !sect.dbref().plst.NA
                      !pvectorpl.position = !stpos.wrt( /* )
                      !pvectorpl.direction = !plineydir.direction()
                      !pvectoranc           = object pointvector()
                      !pvectoranc.position = !ancpos
                      !pvectoranc.direction = !plinezdir.direction()
                      !pos = !pvectorpl.intersection(!pvectoranc).string().before('WRT')

                     endif
                  endif
                endif
              endif
            endif

            !sctnpose = !sect.dbref().pose.wrt( /* ).string().before('WRT')
            !sctnposs = !sect.dbref().poss.wrt( /* ).string().before('WRT')
            !xancpos = !ancpos.string().before('WRT')
            var !edist construct dist $!sctnpose to $!xancpos
            var !sdist construct dist $!sctnposs to $!xancpos


          else
--ATTA
            !pos = !ancpos.string().before('WRT')
          endif


          if !edist.real().lt(!sdist.real()) then
            if !sect.dbref().joie.unset().not() then
              !joie = !sect.dbref().joie.gtype
              if !joie.eq('PART') then
                !pos = !sect.dbref().joie.position.wrt( /* ).string().before('WRT')
              elseif !pos.eq('') then
                !pos = !sctnpose
              endif
            elseif !pos.eq('') then
              !pos = !sctnpose
            endif
          else
            if !sect.dbref().jois.unset().not() then
              !jois = !sect.dbref().jois.gtype
              if !jois.eq('PART') then
                !pos = !sect.dbref().jois.position.wrt( /* ).string().before('WRT')
              elseif !pos.eq('') then
                !pos = !sctnposs
              endif
            elseif !pos.eq('') then
              !pos = !sctnposs
            endif
          endif

--q var !ancpos.string().before('WRT')
--q var !pos

          var !dist constr dist $!ancpos to $!pos
--q var !dist
          if !dist.real().gt(15) then
          --if !ancpos.string().before('WRT').neq('$!pos') then
            !tmrf1 = '/MDS/ABA/FANP/LIBY/NAME_LABEL_ANCHORAGE1'
            !tmrf2 = '/MDS/ABA/FANP/LIBY/NAME_LABEL_ANCHORAGE2'
            --!posaspos = !pos.position()
            !posaspos = !ancpos
            !upnew = !posaspos.up.nint()
            !line = '$!line' & '\'  & 'Z=' & '$!upnew' & '\' & '$!noff'

            $!layer
            NEW SLAB on $!ancref
            atex '$!line'
            tmrf $!tmrf1
            NPPT 1

            NEW SLAB on $!ancref
            atex '$!line'
            tmrf $!tmrf2
            position $!pos
            handle ANY
              delete slab
            endhandle

          else
            !tmrf = '/MDS/ABA/FANP/LIBY/CONN_POINT_ANCHORAGE'
            !line = '$!line' & '\'  & 'Z=' & !up.string() & '\' & '$!noff'
            $!layer
            NEW SLAB on $!ancref
            atex '$!line'
            tmrf $!tmrf
            NPPT 1

            -- delete dimesions created if dist less tahn 10mm
            var !dim coll all ldim with (matchwild(name , '*/CONNECTIONS/*') ) for VIEW
            !here = !!ce
            do !iii values !dim
              !!ce = !iii.dbref()
              delete ldim
            enddo
            !!ce = !here

          endif


        else
--Hanger
          !Pos = ''
          !pos = !sect.dbref().tpos.wrt(/* ).string().before('WRT')
          if !ancpos.string().before('WRT').neq('$!pos') then
            !tmrf1 = '/MDS/ABA/FANP/LIBY/NAME_LABEL_ANCHORAGE1'
            !tmrf2 = '/MDS/ABA/FANP/LIBY/NAME_LABEL_ANCHORAGE2'
            !posaspos = !pos.position()
            !upnew = !posaspos.up.nint()
            !line = '$!line' & '\'  & 'Z=' & '$!upnew' & '\' & '$!noff'

            $!layer
            NEW SLAB on $!ancref
            atex '$!line'
            tmrf $!tmrf1
            NPPT 1

            NEW SLAB on $!ancref
            atex '$!line'
            tmrf $!tmrf2
            !temp = !ancpos.string().before('WRT')
            position $!TEMP
              handle ANY
                delete slab
              endhandle
          else
            !tmrf = '/MDS/ABA/FANP/LIBY/CONN_POINT_ANCHORAGE'
            !line = '$!line' & '\'  & 'Z=' & !up.string() & '\' & '$!noff'
            $!layer
            NEW SLAB on $!ancref
            atex '$!line'
            tmrf $!tmrf
            NPPT 1
          endif
        endif
      enddo
    endif
  enddo

  !!ce = $!saveref
$R
endfunction
-- End of Object - mdsabafratags
