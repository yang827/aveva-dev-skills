--
-- File:            MdsAbaHangWeight.pmlfnc
--   Type:          Function
--
-- Author:          Neale Morris
-- Created:         27 June 2002
--
--
-- Description:
-- Function to obtain a hangers total and individual weights
------------------------------------------------------------------------
------------------------------------------------------------------------

define function !!mdsAbaHangWeight(!hanger is DBREF) is ARRAY

  !ce = !!ce
  !weight[1] = 0

  -- Find out if we are running from design or draft
  !banner = banner
  if !banner.name.upcase().match('DESIGN').gt(0) then
    !module = 'DESIGN'

    --<wd>may2007<mds12>
    --  elseif !banner.name.upcase().match('OUTFITTING').gt(0) then
  elseif !banner.short.upcase().match('OUTFITTING MK').gt(0) then
    --<wd>may2007<mds12>

    !module = 'DESIGN'
  else
    !module = 'DRAFT'
  endif

  -- Access Hanger and Restraint
  !!ce = !hanger
  goto cref

  rest
  handle any
    if !module.eq('DESIGN') then
      !!alert.error('Unable to access element type REST from this level')
      !!ce = !ce
      return !weight
    else
      !!abalogging.error('    Unable to access element type REST from this level')
      !!ce = !ce
      return !weight
    endif
  endhandle

  var !hangmem coll all for ce
  !totalWeight = 0
  !weights = ARRAY()

  do !getweight values !hangmem
    !!ce = !getweight.dbref()
    if !!ce.type.eq('VSPR') then
      !weig = :MDSSprWei of catref
      !weig = !weig * !!mdsWEIUNIT.real()
      !weights.append(!weig.real())
      handle (2,441)
        !weights.append(0)
        !name = !!ce.name
        !owner = !!ce.owner.name
        if !module.eq('DRAFT') then
          !!abalogging.error('    Unable to calculate the weight of $!name')
        endif
        skip
      endhandle
      !totalWeight = !totalWeight + !weig.real()
    elseif !!ce.type.neq('REST') and !!ce.type.neq('HANG') and !!ce.type.neq('TUBI') and !!ce.type.neq('TEXT') then
      -- Pre PDMS12.0, the matref is stored in the uda :MdsMatref, at PDMS12.0
      -- the matref attribute has been added to atta. Find the correct attribute to use
      -- The variable !matrefAtt will be set to either REF for matref or UDA for :MdsMatref
      !matrefAtt = !!mdsUseMatref(!!ce)
      if !matrefAtt.eq('UDA') then
        !compWeight = (dens of 1 of 1 of :MDSMAtref * NVOL )
        handle any
          !weights.append(0)
          !name = !!ce.name
          !owner = !!ce.owner.name
          if !module.eq('DRAFT') then
            !!abalogging.error('    Unable to calculate the weight of $!name')
          endif
          skip
        endhandle
        !weights.append(!compWeight)
        !totalWeight = !totalWeight + (dens of 1 of 1 of :MDSMAtref * NVOL )
      else
        !compWeight = (dens of 1 of 1 of MAtref * NVOL )
        handle any
          !weights.append(0)
          !name = !!ce.name
          !owner = !!ce.owner.name
          if !module.eq('DRAFT') then
            !!abalogging.error('    Unable to calculate the weight of $!name')
          endif
          skip
        endhandle
        !weights.append(!compWeight)
        !totalWeight = !totalWeight + (dens of 1 of 1 of MAtref * NVOL )
      endif
    endif
  enddo

  !weights.append(!totalWeight)
  !!ce = !ce

  return !weights

endfunction
