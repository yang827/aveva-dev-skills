--
-- Author:          Neale Morris
-- Created:         17 April 2005 (SUNDAY)
--
--
-- Description:
-- Task to create an axes on a isometric view
------------------------------------------------------------------------
------------------------------------------------------------------------

define function !!MdsAbaIsoAxes(!params is array)

  !View = !!ce
  !Vsize = size
  !tmrf = |$!Params[2]|

-- Place the North Gridline

  var !name NAME OF VIEW
  !notes = !name & |/USER_Notes|
  $!notes
  NEW VNOTE
  NEW SYMB
  TMRF $!tmrf

  if (!params[3] EQ |TR|) then
    BY X ($!vsize[1] / 2)
    BY Y ($!vsize[2] / 2)
    BY X -7
    BY Y -7
  elseif (!params[3] EQ |TL|) then
    BY X (-$!vsize[1] / 2)
    BY Y  ($!vsize[2] / 2)
    BY X  7
    BY Y -7
  elseif (!params[3] EQ |BL|) then
    BY X (-$!vsize[1] / 2)
    BY Y (-$!vsize[2] / 2)
    BY X -7
    BY Y  7
  elseif (!params[3] EQ |BR|) then
    BY X  ($!vsize[1] / 2)
    BY Y (-$!vsize[2] / 2)
    BY X -7
    BY Y  7
  else
    DELETE SYMB
  endif

-- Need to make the support fit into the view at the maximum scale

  SHEE
  GOTO DARREF
  var !supname NAME
  !supname = !supname.substring(1,!supname.match(|-AREA|) - 1)
  !!ce = !View
-- Back to view
  VIEW
-- If its a hanger the we need to auto the rest element
  !Cref = cref of $!SupName
    handle ANY
      !Cref = cref of $!SupName[1]
        handle ANY
          !Cref = object dbref()
        endhandle
    endhandle
  if !Cref.badref().not() then
    if !Cref.type.eq('HANG') then
      -- need to include the atta in the idli, RM 14/09/06
      --auto rest of cref of $!SupName
        !SaveView = !!ce
        !SaveIdln = idln
        goto idln
        new idli
        !TempIdln = !!ce
        add $!SupName
        ADD rest of cref of $!SupName
        !!ce = !Saveview
        idln $!TempIdln
        auto
        idln $!SaveIdln
        !!ce = !TempIdln
        delete idli
        !!ce = !SaveView
    endif
  else
    auto $!SupName
      handle ANY
        !SaveView = !!ce
        !SaveIdln = idln
        goto idln
        new idli
        !TempIdln = !!ce
        add $!SupName/DATUM
         handle ANY
         endhandle
        do !Loop from 1 to 30
          !test = $!SupName[$!Loop]
            handle NONE
              add $!SupName[$!Loop]
            elsehandle ANY
            endhandle
        enddo
        !!ce = !Saveview
        idln $!TempIdln
        auto
        idln $!SaveIdln
        !!ce = !TempIdln
        delete idli
        !!ce = !SaveView
      elsehandle NONE
-- In case it a double ancillary then auto all of them
        !SaveView = !!ce
        !SaveIdln = idln
        goto idln
        new idli
        !TempIdln = !!ce
        add $!SupName
        add $!SupName/DATUM
        do !Loop from 1 to 30
          !test = $!SupName$n.$!Loop
            handle NONE
              add $!SupName$n.$!Loop
            elsehandle ANY
            endhandle
        enddo
        !!ce = !Saveview
        idln $!TempIdln
        auto
        idln $!SaveIdln
        !!ce = !TempIdln
        delete idli
        !!ce = !SaveView
      endhandle
  endif

  update design
    handle ANY
    endhandle

endfunction

