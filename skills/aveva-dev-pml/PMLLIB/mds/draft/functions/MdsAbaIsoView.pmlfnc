--
-- File:            MdsAba-ISOVIEW.pmlfnc
--   Type:          Function
--
-- Author:          Martin Wright
-- Created:         14 May 2002
--
--
-- Description:
-- Basic task function called by abatasks for showing iso view of support.
------------------------------------------------------------------------
-- Revision 0 14-05-2002 Development Session
------------------------------------------------------------------------
define function !!MdsAbaIsoView(!params is array)

!save = !!ce
--q var !params
units = object COMUNITS(TRUE)

UNITS MM Bore
UNITS MM Distance

-- Now go get the support detail position.
       !save = !!ce

-- Navigate to SHEE
   SHEE
   GOTO DARREF
   var !supname NAME
   !supname = !supname.substring(1,!supname.match(|-AREA|) - 1)
   !!ce = !save

-- Now create IDLI based on support name as described.
   GOTO IDLN

-- Delete LIMITS from View.
   LIMITS unset

-- Now add stuff to draw.
   1
   CRITERIA $!supname

-- Delete VSECS from View.
   !!ce = !save
   var !vsec COLL ALL VSEC FOR CE
   do !delvsec value !vsec
      $!delvsec
      DELETE VSEC
   enddo

-- Return to View
   !!ce = !save
      if (!params[1] EQ |Iso1|) then
          DIRECTION W 45 S 35.26 D
          !tmrf = |$!Params[2]|

      elseif (!params[1] EQ |Iso2|) then
          DIRECTION W 45 N 35.26 D
          !tmrf = |$!Params[2]|

      elseif (!params[1] EQ |Iso3|) then
          DIRECTION E 45 N 35.26 D
          !tmrf = |$!Params[2]|

      else
          DIRECTION S 45 E 35.26 D
          !tmrf = |$!Params[2]|

      endif

      AUTO
      UPDATE DESIGN
      !vsc = VSCALE
      !vsc = !vsc * .8
      VSCALE $!vsc
      var !vsize SPLIT SIZE

      !offsetx = 7
      !offsety = 7

-- Place the North Gridline
      var !name NAME OF VIEW
      !notes = !name & |/USER_Notes|
      $!notes
      NEW VNOTE
      NEW SYMB
      TMRF $!tmrf

      if (!params[3] EQ |TR|) then
          BY X ($!vsize[1] / 2)
          BY Y ($!vsize[2] / 2)
          BY X -7
          BY Y -7
      elseif (!params[3] EQ |TL|) then
          BY X (-$!vsize[1] / 2)
          BY Y  ($!vsize[2] / 2)
          BY X  7
          BY Y -7
      elseif (!params[3] EQ |BL|) then
          BY X (-$!vsize[1] / 2)
          BY Y (-$!vsize[2] / 2)
          BY X -7
          BY Y  7
      elseif (!params[3] EQ |BR|) then
          BY X  ($!vsize[1] / 2)
          BY Y (-$!vsize[2] / 2)
          BY X -7
          BY Y  7
      else
          DELETE SYMB
      endif

-- Back to view and reset Function avoiding scale use.
   VIEW
   FUNCTION 'NotUsed'

 !units.restoreSavedBoreDist()

endfunction

-------------- End Of Code --------------
