--
-- File:            MdsAbaIxJntTags.pmlfnc
--   Type:          Function
--
-- Author:          Martin Wright
-- Created:         20 June 2002
--
--
-- Description:
-- Function to Add MDS Steel Framework SCTN INTERNAL and EXTERNAL JOINT Labels to ABA Drawing
------------------------------------------------------------------------
-- Revision 0 20-06-2002 Development Session
------------------------------------------------------------------------
define function !!MdsAbaIxJntTags(!view is DBREF,!params is STRING)

!view = !!ce

--q var !params

prec 2 dp
!units = object COMUNITS(TRUE)

-- Set UNITS to metric for making task work when in imperial.
--   UNITS MM Bore
--   UNITS MM Distance

-- Load task parameter form ready for use.
--   LOADFORM !!MdsAbaIxJntTags

-- Navigate to SHEE
   SHEE
   GOTO DARREF
   var !supname NAME
   !supname = !supname.substring(1,!supname.match(|-AREA|) - 1)

-- Return to VIEW
   !!ce = !view

-- Goto layers of view and create new one for steel labels.
-- Now create new layer for "comp" table.
   !name = NAME OF VIEW
   !notes = !name & |/JointTags_Task|
   $!notes
   handle (2,109)
       NEW LAYER
       NAME $!notes
   elsehandle none
       DELETE LAYER
       NEW LAYER
       NAME $!notes
   endhandle

     do !ele index !!MdsAbaMtoSteel.data.dbrefs
        !type = TYPE OF $!!MdsAbaMtoSteel.data.dbrefs[$!ele]
        if (!type EQ 'SJOI') then
            NEW GLAB
            DDNAME $!!MdsAbaMtoSteel.data.dbrefs[$!ele]

            -- Find label used for this element.
            !where = !!MdsAbaMtoSteel.data.elements[3].findfirst(!!MdsAbaMtoSteel.data.descriptions[!ele])
            !label = !!MdsAbaMtoSteel.data.elements[1][!where]
            BTEXT |$!label|
        endif
     enddo

!!ce = !view
!units.restoreSavedBoreDist()
prec var def

endfunction

