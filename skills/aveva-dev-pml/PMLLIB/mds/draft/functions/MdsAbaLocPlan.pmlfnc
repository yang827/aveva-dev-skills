--
-- File: MdsAbaLocPlan.pmlfnc
--   Type: Function
--
-- Author: Neale Morris
-- Created: 4 July 2003
--
--
-- Description:
-- Basic task function called by abatasks for showing support location in project.
--
------------------------------------------------------------------------

define function !!mdsabalocplan(!params is ARRAY)

	-- parameters
	!origin = !params[1]
  handle NONE
	  if !origin.match('/').eq(1) then
			!origin.dbref()
		  handle ANY
				!origin.delete()
		  endhandle
	  else
			!origin = !origin.upcase().substring(1,4)
		  if (not(!origin inset('ZONE','SITE','WORL','GRID'))) then
				!origin.delete()
		  endif
	  endif
  elsehandle ANY
  endhandle

	!lfcolo = !params[2]
  handle ANY
		!lfcolo = 'template'
  endhandle
	!txcolo = !params[3]
  handle ANY
		!txcolo = 'template'
  endhandle

	-- initialize global object if does not exist
  if undefined(!!mdsLocationPlan) then
		!!mdsLocationPlan = object MDSABALOCATIONPLAN()
	  handle ANY
			!!abalogging.error('    Aborting location plan. ' & !!error.text)
			return
	  endhandle
  endif

  !view = view
  !!ce = !view
  !name = name
  !!ce.func = 'NotUsed'

-- Turn Frame off
  lframe false

	-- extract support name
  !supname = !view.owne.darref.name.before('-AREA')
  !support = !supname.dbref()
  handle ANY
  	-- support group
  	!supname = !supname & '[1]'
    !support = !supname.dbref()
    if !support.type.eq('STRU') then
    	!support2 = !supname.replace('[1]','[2]').dbref()
      handle NONE
    	 if !support2.cref.badref().not() then
    			!datum = object DBREF(!supname & '/DATUM')
    		  if !support2.cref.type.eq('HANG').and(!datum.styp.eq('PIPE-REST')) then
    				!support = !support2
    		  endif
    	  endif
      elsehandle ANY
      endhandle
    endif
  endhandle

	-- get reference to support datum
  if !support.type.eq('STRU') then
    if !support.:mdssupptype.eq(!!mdslsuppdefs.type).or(!support.:mdsadploc.east.set()) then
  		-- lighting support or MDS frame with explicitly set ADP location
  		!datum = !support
    else
  		-- MDS frame
			!datum = object DBREF(!support.name & '/DATUM')
	  endif
  else
    !datum = !support
  endif

  -- get datum position
  if !datum.type.eq('STRU') then
  	-- lighting support or frame with explicit ADP location
    if !datum.:mdssupptype.eq(!!mdslsuppdefs.type) then
	  	!light = object MDSLSUPPORT(!datum)
  		!datumpos = !light.origin
    else
  		!datumpos = !datum.:mdsadploc
  		-- reset !datum back to DATUM atta
	  	!datum = object DBREF(!datum.name & '/DATUM')
    endif
  else
  	-- ATTA
  	!creftype = !datum.cref.type
    handle ANY
  		!creftype = ''
    endhandle
    if !creftype.eq('HANG') then
  		-- it is a hanger
  		!datumpos = !datum.pos
    else
  		-- ancillary
  		!datumpos = !datum.ppos[9]
  	  handle ANY
  			!datumpos = !datum.pos
  	  endhandle
    endif
  endif

	-- get matching or closest grid system
	!grid = !!mdsLocationPlan.gridsystem(!datumpos)
  handle ANY
		!!abalogging.error('    Aborting location plan. ' & !!error.text)
		return
  endhandle

	-- get location data
	!posdata = !grid.poswithin(!datumpos)
	!locationplan = !!mdsLocationPlan
  if defined(!origin) then
		!locationplan.origin = !origin
  endif
	!xyz = !locationplan.coordinates(!datumpos,!datum)
	-- format coordinates
	var !coordtype coordinates
	!ckey = !coordtype.replace('E','E ').replace('N','N ').replace('U','U ').replace('X','X ').replace('Y','Y ').replace('Z','Z ').split()
	do !c from 1 to 3
		!coord[!c] = !ckey[!c] & ' ' & !xyz[!c].value().nint().string(!!distancefmt)
  enddo

	-- get grid references and dimensions in X
	!tag = !posdata.getAttribute('xtag')
	!dim = !posdata.getAttribute('xdim')
	!xdim = 0
  if !dim[1].eq(0) then
		!xtag = !tag[1]
		!lr = '='
  elseif !dim[2].eq(0) then
		!xtag = !tag[2]
		!lr = '='
  elseif !dim[1].unset() then
		!xtag = !tag[2]
		!xdim = !dim[2]
		!lr = 'R'
  elseif !dim[2].unset() then
		!xtag = !tag[1]
		!xdim = !dim[1]
		!lr = 'L'
  elseif !dim[1].leq(!dim[2]) then
		!xtag = !tag[1]
		!xdim = !dim[1]
		!lr = 'L'
  else
		!xtag = !tag[2]
		!xdim = !dim[2]
		!lr = 'R'
  endif
	-- get grid references and dimension in Y
	!tag = !posdata.getAttribute('ytag')
	!dim = !posdata.getAttribute('ydim')
	!ydim = 0
  if !dim[1].eq(0) then
		!ytag = !tag[1]
		!tb = '='
  elseif !dim[2].eq(0) then
		!ytag = !tag[2]
		!tb = '='
  elseif !dim[1].unset() then
		!ytag = !tag[2]
		!ydim = !dim[2]
		!tb = 'T'
  elseif !dim[2].unset() then
		!ytag = !tag[1]
		!ydim = !dim[1]
		!tb = 'B'
  elseif !dim[1].leq(!dim[2]) then
		!ytag = !tag[1]
		!ydim = !dim[1]
		!tb = 'B'
  else
		!ytag = !tag[2]
		!ydim = !dim[2]
		!tb = 'T'
  endif

	-- data are passed to the ATEX attribute of symbol are axpected in the order as follows:
	-- X coordinate,Y coordinate,Z coordinate,closest axis in Ydir,closest axis in Xdir,distance in Ydir,distance in Xdir,north arrow dir
	!atext = !coord.join(',') & ',' & !ytag & ',' & !xtag & ',' & !ydim.value().nint().string(!!distancefmt) & ',' & !xdim.value().nint().string(!!distancefmt) & ',' & !ckey[2]

  -- Create layer to add symbol
  !layername = !name & '/Location_Plan'
  !!ce = !layername.dbref()
  handle ANY
    new LAYE
    !!ce.name = !layername
  elsehandle NONE
    delete LAYE memb
  endhandle
	-- set layer properties
	!!ce.llea = false
	lfstyle template
	lfcolour $!lfcolo
	txcolour $!txcolo

	new SLAB
	!!ce.atex = !atext
	!!ce.ddnm = !datum
	llead false
	oset false
	!!ce.tmrf = object DBREF('/MDS-Location-Plan-' & !tb & !lr)
	!xypo = !view.xypo.east & ' ' & !view.xypo.north
	xypo $!xypo

	!!ce = !view

endfunction
-------------- End Of Code --------------
