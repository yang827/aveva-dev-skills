--
-- File: MdsAbaLookDir.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: Draft MDS using ABA for Drawing production
--   Replaces:
--
-- Author: Steve Robinson
-- Created: 2nd July 2002
--
--
-- Description:
-- ------------
-- This function generates a view look direction title at the bottom
-- centre of each view frame
--
--
-- Using this function:
-- --------------------
-- For each view to be annotated call this function with the view DBREF.
-- The function creates a TEXP to indicate the view direction positioned
-- at the bottom centre of the view frame
--
-- The TEXP is created under a layer named MDS_Title
--
-- Before calling the function make sure the MDS_Title layer
-- exists and had the relevant UCODE, PCODE and other text defaults set. This
-- allows you to control the appearance of the annotation before is it generated.
-- Note: If the layer does not exist then the method will create it and
-- and atts cascaded from view level will take effect.

-- IMPERIAL UNITS:
-- ---------------
-- The code should work in both metric and imperial units...
--
--
--------------------------------------------
--<wd>28feb2008 - DUN824 - Defect No. P-4405
--
-- COORD XYZ is now catered for, but this setting does NOT affect or override the POSFORMAT setting described below.
--
-- At the 12 versions of AVEVA MARINE and AVEVA PDMS the new attribute POSFORMAT has been introduced at several DRAFT element types,
-- e.g. DRTMLB, DRTMPL, SHTMPL, SHLB, DRWG, SHEET, VIEW, LAYER, LIBY, REGI, DEPT, OVERLAY etc..., to use the COORD settings XYZ or ENU.
-- The POSFORMAT attribute CONTROLS how certain DATA is output on the DRAWING VIEW,
-- e.g. A Dimension DPPT element attribute PLTXT (Projection Line Text)can have an INTELLIGENT TEXT setting of '~C #POSE'
--
-- When the LAYER attribute POSFORMAT is set to ENU the PLTXT output on the VIEW will be for example 'CL E 18300'
-- BUT --
-- When the LAYER attribute POSFORMAT is set to XYZ the PLTXT output on the VIEW will be for example 'CL X=18300'
--
-- The COORD setting of XYZ or ENU is over ruled by the POSFORMAT attribute setting when outputting attributes on the VIEW such as PLTXT etc...
--
--<wd>28feb2008 - DUN824 - Defect No. P-4405
--------------------------------------------
--
--------------------------------------------------------------------------------
-- Define Function

  ----------------------------------------------------------
  -- Arguments:
  -- view = DBREF of view
  ----------------------------------------------------------
  define function !!mdsabalookdir(!view is DBREF)

--------------------------------------------
--<wd>28feb2008 - DUN824 - Defect No. P-4405
-- Determine if COORD XYZ or COORD ENU is being used
    var !coord coord
--<wd>28feb2008 - DUN824 - Defect No. P-4405
--------------------------------------------

    !saveRef = !!ce

    -- note layer suffix
    !noteLayer = 'MDS_Title'

    -- navigate to view
    $!view
    view

    -- get view direction
    !dir = !!ce.dir
    var !sdir dir

    -- get view region for title textp positioning
    !vreg = !!ce.vreg

    -- check label layer exists
    set
    */$!noteLayer
    handle any
      new layer */$!noteLayer
    endhandle
--    !layer = !!ce

    -- clear any existing dimensions
    DELETE LAYER MEMBERS
    handle any
    endhandle

--------------------------------------------
--<wd>28feb2008 - DUN824 - Defect No. P-4405
  if (!coord.upcase().trim().eq('ENU')) then

    if (!dir.eq(D)) then
      !btext = 'Plan View'
    elseif (!dir.eq(N)) then
      !btext = 'View Looking North'
    elseif (!dir.eq(S)) then
      !btext = 'View Looking South'
    elseif (!dir.eq(E)) then
      !btext = 'View Looking East'
    elseif (!dir.eq(W)) then
      !btext = 'View Looking West'
    elseif (!dir.eq(U)) then
      !btext = 'View Looking Up'
    else
      !btext = 'View Looking $!sdir'
    endif

  elseif (!coord.upcase().trim().eq('XYZ')) then

--    if (!dir.eq(-Z)) then
--      !btext = 'View Looking -Z'
    if (!dir.eq(Y)) then
      !btext = 'View Looking Y'
--    elseif (!dir.eq(-Y)) then
--      !btext = 'View Looking -Y'
    elseif (!dir.eq(X)) then
      !btext = 'View Looking X'
--    elseif (!dir.eq(-X)) then
--      !btext = 'View Looking -X'
    elseif (!dir.eq(Z)) then
      !btext = 'View Looking Z'
    else
      !btext = 'View Looking $!sdir'
    endif

  endif
--<wd>28feb2008 - DUN824 - Defect No. P-4405
--------------------------------------------

    NEW VNOT
    NEW TEXP BTEXT '$!btext' ALIGN TB JUST CENTRE CHEI 5
    !x = !vreg[1] + ((!vreg[3] - !vreg[1]) / 2)
    -- tm mod to move text further away from dimension text 1 changed to 1.5
    -- tm further mod 1.5 changed to 2

    !y = !vreg[2] - (2 * chei)
    AT X $!x Y $!y

-- If the name of the support begins with the transportation prefix add a note
-- to view title

    shee
    !tran = !!ce.darref.name.before('-AREA').substring(2,1)
    same
    if !tran.eq(!!mdstranpref) then
      !btex = BTEX
      BTEX '$!btex
($!!mdstraniso)'
      ALIGN TBODY
    endif

    $!saveRef
    handle any
    endhandle

  endfunction

-- End of Object - mdsabalookdir
