--
-- File:            MdsAbaMtoComp.pmlfnc
--   Type:          Function
--
-- Author:          Martin Wright
-- Created:         14 May 2002
--
--
-- Description:
-- Basic task function called by abatasks for showing support location in project.
------------------------------------------------------------------------
-- Revision 0 14-05-2002 Development Session
------------------------------------------------------------------------
    define function !!MdsAbaMtoComp(!params is array)
      !view = !!ce
--alpha req clear
      Pml reload form !!mdsabamtocomp
      !units = object COMUNITS(TRUE)

-- Turn Frame off
      LFRAME FALSE
      UNITS MM Bore
      UNITS MM Distance
      LOADFORM !!MDSABAMTOCOMP

-- S etup Data object ready for use.
      loadform !!mdsabamtocomp

-- Get Sequence Number of view in list.
      var !views COLL ALL VIEW FOR OWNER
      var !viewn EVAL NAME FOR ALL FROM !views
      !vorder = !viewn.findfirst(!!ce.name)

-- Navigate back to Drawing Template
      DRWG
      goto linkref

-- Now move to VIEW in Template and get original size and position.
      var !tmpvie COLL ALL VIEW FOR CE
      $!tmpvie[$!vorder]

-- Capture View Size from the Template.
      var !vsize SIZE
      var !vpos XYPOSITION

-- Go back to view and apply original view size and position.
      !!ce = !view
      SIZE $!vsize
      XYPOS $!vpos

-- Now go get the support detail position.

-- Navigate to SHEE
      SHEE
      GOTO DARREF
      var !supname NAME

-------------------------------------------------
--<wd>feb2005 -- Determine if the support is a MDS GROUP
      --!!mdsabamtocomp.data.supname = !supname.substring(1,!supname.match(|-AREA|) - 1)
      !supportname = !supname.substring(1,!supname.match(|-AREA|) - 1)
      $!supportname
      handle (2,109)
-- Check if MDS Support is the MASTER STRUCTURE, number [1], of a MDS GROUP, if UNDEFINED NAME error(2,109) occurs
        !supportname= !supportname + '[1]'
        !!ce = !supportname.dbref()
      endhandle

--<kp>jan07
-- exit if it is lighting support
      if !!ce.:mdssupptype.eq(!!Mdslsuppdefs.type) then
         return
      endif

-- Determine the <MDSABASUPPORT> OBJECT for the current MDS GROUP, FRAMEWORK or HANGER
      !mdsobject = !!mdsabasuppobj(!supportname.dbref())

-- Set the OBJECT member .supname
      !!mdsabamtocomp.data.supname = !supportname

-- Load up data object with all bits needed to carry on.
      --!!mdsabamtocomp.data.loaddata(!params)
      !!mdsabamtocomp.data.loaddata(!params, !mdsobject)
--<wd>feb2005
-------------------------------------------------

-- Run the Table
      !!ce = !view
      !MaxWidth = !!MdsAbaMtoComp.getscale(!!mdsabamtoComp.data.taskparams[3])

-- Set a counter
      !Counter = 1
-- Create temp laye to use for width of text
      new laye
      new vnot
      new texp
      chei $!params[7]

      !NewLines = ARRAY()
      !NewOne = ARRAY()
      !NewThree = ARRAY()
      !NewAtta = ARRAY()

      !Counter = 2
      do !Count from 1 to !!mdsabamtoComp.data.elements[2].size()
        !PrevLines = !NewLines.size()
        !Lines = !!MdsAbaSplitLine(!!mdsabamtocomp.data.elements[2][$!Count],!MaxWidth)
        !NewLines.appendarray(!Lines)
        !LinesNow = !NewLines.size()
        if !Linesnow.eq(!PrevLines + 1) then
-- Only one line added
          !NewOne.append(!!mdsabamtocomp.data.elements[1][$!Count])
          !NewThree.append(!!mdsabamtocomp.data.elements[3][$!Count])
          !NewAtta.append(!!mdsabamtocomp.data.attas[$!Count])
        else
-- Multiple lines added, need to add spaces in others after adding original
          !Add = !LinesNow - !PrevLines - 1
          !NewOne.append(!!mdsabamtocomp.data.elements[1][$!Count])
          do !AddSpace from 1 to !Add
            !NewOne.append(' ')
          enddo
          !NewThree.append(!!mdsabamtocomp.data.elements[3][$!Count])
          do !AddSpace from 1 to !Add
            !NewThree.append(' ')
          enddo
          !NewAtta.append(!!mdsabamtocomp.data.attas[$!Count])
          do !AddSpace from 1 to !Add
            !NewAtta.append(' ')
          enddo
        endif
      enddo

      !!mdsabamtoComp.data.elements[2] = !newlines
      !!mdsabamtoComp.data.elements[1] = !newone
      !!mdsabamtoComp.data.elements[3] = !newthree
      !!mdsabamtoComp.data.attas = !newatta

      laye
      delete laye

      !!mdsabamtocomp.maketable(!!mdsabamtocomp.data.elements )
      !!ce = !view

-- Back to view and reset Function avoiding scale use.
      FUNCTION |NotUsed|

--IDLN NULREF
      !units.restoreSavedBoreDist()
      Prec var def

    endfunction
-------------- End Of Code --------------
