------------------------------------------------------------------------
--
-- File:            MdsAbaMtoSteel.pmlfnc
--   Type:          Function
--
-- Author:          Martin Wright
-- Created:         14 May 2002
--
--
-- Description:
-- Basic task function called by abatasks for showing support location in project.
------------------------------------------------------------------------
-- Revision 0 14-05-2002 Development Session
------------------------------------------------------------------------
define function !!MdsAbaMtoSteel(!params is ARRAY)

  !view = !!ce

  Prec 2 dp
  !units = object COMUNITS(TRUE)

-- Turn Frame off
  LFRAME FALSE
  UNITS MM Bore
  UNITS MM Distance
  LOADFORM !!mdsabamtoSteel

  !!mdsabamtosteel.units = !units

-- <wd>jan2005
-- Current element is the DRAFT VIEW where the MTO is to be built
-- e.g. where -->  !!ce = /MDS-ABA-2-VIEWS(METRIC)-PS7278-FANP09-AREA/S1/V3
-- Setup Data object ready for use by passing the VIEW <DBREF>.
-- <wd>jan2005
  !!mdsabamtoSteel.data = object MdsAbaMtoSteel(!view)

-- Get Sequence Number of view in list.
  var !views COLL ALL VIEW FOR OWNER
  var !viewn EVAL NAME FOR ALL FROM !views
  !vorder = !viewn.findfirst(!!ce.name)

-- Navigate back to Drawing Template
  DRWG
  goto linkref

-- Now move to VIEW in Template and get original size and position.
  var !tmpvie COLL ALL VIEW FOR CE
  $!tmpvie[$!vorder]

-- Capture View Size from the Template.
  var !vsize SIZE
  var !vpos XYPOSITION

-- Go back to view and apply original view size and position.
  !!ce = !view
  SIZE $!vsize
  XYPOS $!vpos

-- Now go get the support detail position.

-- Navigate to SHEE
  SHEE
  GOTO DARREF
  var !supname NAME

--<wd>jan2005 -- Determine if the support is a MDS GROUP
--  !!mdsabamtoSteel.data.supname = !supname.substring(1,!supname.match(|-AREA|) - 1)
  !supportname = !supname.substring(1,!supname.match(|-AREA|) - 1)
  $!supportname
  handle (2,109)
-- Check if MDS Support is the MASTER STRUCTURE, number [1], of a MDS GROUP, if UNDEFINED NAME error(2,109) occurs
    !supportname= !supportname + '[1]'
    !!ce = !supportname.dbref()
  endhandle

-- Set the OBJECT member .supname
  !!mdsabamtosteel.data.supname = !supportname
--<wd>jan2005


---------------------------------------------------------------------------------------------------
--<wd>jan2005
---------------------------------------------------------------------------------------------------
-- Load up data object with all bits needed to carry on.
  --!!mdsabamtoSteel.data.loaddata(!params)

-- Determine the <MDSABASUPPORT> OBJECT for the current MDS GROUP, FRAMEWORK or HANGER
  !mdsobject = !!mdsabasuppobj(!supportname.dbref())

-- Check if MDS Support is a MDS GROUP
  if (!mdsobject.mdsdata.mdsgroup) then
-- Load all required data in the MDS GROUP, i.e. --> MDS STRUCTURES and/or MDS HANGERS held with in the MDS GROUP
    !!mdsabamtoSteel.data.loadgroupdata(!params, !mdsobject)

  else
-- Load all required data for the MDS FRAMEWORK <STRU> or the MDS HANGER <ATTA> or MDS ANCILLARY
    !!mdsabamtoSteel.data.loaddata(!params)

---------------------------------------------------------------------------------------------------
  endif
-- All Elements etc... are stored here in the FORM member "!!mdsabamtoSteel.data" which is a <MDSABAMTOSTEEL> OBJECT

-- Check if MDS Support is a "Stand-Alone" MDS Ancillary
  if (!mdsobject.mdsdata.supptype.eq('ATTA')) then
-- MDS Support is a "Stand-Alone" MDS Ancillary, therefore NOTHING MORE TO DO here!
    return
  endif
---------------------------------------------------------------------------------------------------
--<wd>jan2005
---------------------------------------------------------------------------------------------------

-- Run the Table
  !!ce = !view
  !MaxWidth = !!MdsAbaMtoSteel.getscale(!!mdsabamtosteel.data.taskparams[3])

-- Set a counter
  !Counter = 1
-- Create temp laye to use for width of text
  new laye
  new vnot
  new texp
  chei $!params[7]


---------------------------------------------------------------------------------------------------
--<wd>feb2005
---------------------------------------------------------------------------------------------------
-- Initialise the NEW ARRAYS
--  !NewLines = ARRAY()
--  !NewOne   = ARRAY()
--  !NewTwo   = ARRAY()
--  !NewFour  = ARRAY()

-- Determine if the MDS STRUCTURE/HANGER element DESCRIPTIONS stored in:-
-- **********
-- (A) "!!mdsabamtosteel.data.elements[3]" -- for "INDIVIDUAL" MDS STRUCTURES and/or MDS HANGERS
-- *** OR ***
-- (B) "!!mdsabamtosteel.data.struelements[3]" and/or "!!mdsabamtosteel.data.hangelements[3]"
-- for ALL "MDS GROUP MEMBERS", i.e. --> MDS STRUCTURES and/or MDS HANGERS held with in the MDS GROUP
-- **********
-- are LONGER than the PERMITTED length stored in "!maxwidth", and ADJUST the NUMBER of LINES required in the
-- MDS ABA DRAWING "MTO" --> "MDSABAMTOSTEEL" table created by this PML function.

  if ((!mdsobject.mdsdata.mdsgroup)) then
-- NEW CODE used by ALL "MDS GROUP MEMBERS", i.e. --> MDS STRUCTURES and/or MDS HANGERS held with in the MDS GROUP
-- MDS "GROUP" Support comprises of a MASTER MDS FRAMEWORK STRUCTURE Support plus ONE or MORE MDS HANGER Supports

-- MDS FRAMEWORK STRUCTURE Support
-- For MDS GROUPS the MDS FRAMEWORK STRUCTURE elements are stored in "!!mdsabamtosteel.data.struelements"
     !mdselemarray[1] = ARRAY()
     !mdselemarray[1][1] = !!mdsabamtosteel.data.struelements[1]
     !mdselemarray[1][2] = !!mdsabamtosteel.data.struelements[2]
     !mdselemarray[1][3] = !!mdsabamtosteel.data.struelements[3]
     !mdselemarray[1][4] = !!mdsabamtosteel.data.struelements[4]
     !mdselemarray[1][5] = '!!mdsabamtosteel.data.struelements'

-- MDS HANGER Supports
-- For MDS GROUPS the MDS HANGER elements are stored in "!!mdsabamtosteel.data.hangelements"
     !mdselemarray[2] = ARRAY()
     !mdselemarray[2][1] = !!mdsabamtosteel.data.hangelements[1]
     !mdselemarray[2][2] = !!mdsabamtosteel.data.hangelements[2]
     !mdselemarray[2][3] = !!mdsabamtosteel.data.hangelements[3]
     !mdselemarray[2][4] = !!mdsabamtosteel.data.hangelements[4]
     !mdselemarray[2][5] = '!!mdsabamtosteel.data.hangelements'

  else
-- For "INDIVIDUAL" MDS FRAMEWORK STRUCTURE or MDS HANGER Supports
-- The MDS SUPPORT elements are stored in "!!mdsabamtosteel.data.elements"
     !mdselemarray[1] = ARRAY()
     !mdselemarray[1][1] = !!mdsabamtosteel.data.elements[1]
     !mdselemarray[1][2] = !!mdsabamtosteel.data.elements[2]
     !mdselemarray[1][3] = !!mdsabamtosteel.data.elements[3]
     !mdselemarray[1][4] = !!mdsabamtosteel.data.elements[4]
     !mdselemarray[1][5] = '!!mdsabamtosteel.data.elements'

   endif

-- The ARRAY !mdselemarray will now ALWAYS exist for BOTH types of SUPPORT: i.e.
-- <a> "MDS GROUPS", i.e. Variable !numb = [1] will ALWAYS exist for the MASTER MDS FRAMEWORK STRUCTURE,
-- and variable !numb = [2] will ONLY exist if ONE or MORE MDS HANGERS are contained within the "MDS GROUP"
-- *** OR ***
-- <b> "INDIVIDUAL MDS FRAMEWORK STRUCTURES or MDS HANGERS", i.e. ONLY variable !numb = [1] will exist here.
   do !numb indices !mdselemarray

-- Re-Initialise the NEW ARRAYS for MDS GROUPS
     !newone   = ARRAY()
     !newtwo   = ARRAY()
     !newlines = ARRAY()
     !newfour  = ARRAY()

-- Determine the LENGTH of the MDS SUPPORT element "DESCRIPTIONS and ADJUST ALL the relavent element ARRAYS
-- to OUTPUT the CORRECT FORMAT of the "MDSABAMTOSTEEL" MTO <used for MDS STRUCTURES and MDS HANGERS>
     do !index from 1 to !mdselemarray[!numb][3].size()
       !prevlines = !newlines.size()
       !lines     = !!mdsabasplitline(!mdselemarray[!numb][3][!index],!maxwidth)
       !newlines.appendarray(!lines)
       !linesnow  = !newlines.size()

       if (!linesnow.eq(!prevlines + 1)) then
-- Only one line added
         !newone.append(!mdselemarray[!numb][1][!index])
         !newtwo.append(!mdselemarray[!numb][2][!index])
         !newfour.append(!mdselemarray[!numb][4][!index])

       else
-- Multiple lines added, need to add spaces in others after adding original
         !add = !linesnow - !prevlines - 1
         !newone.append(!mdselemarray[!numb][1][!index])
         do !addspace from 1 to !add
           !newone.append(' ')
         enddo

         !newtwo.append(!mdselemarray[!numb][2][!index])
         do !addspace from 1 to !add
           !newtwo.append(' ')
         enddo

         !newfour.append(!mdselemarray[!numb][4][!index])
         do !addspace from 1 to !add
           !newfour.append(' ')
        enddo

       endif

     enddo

-- Reset the temporary "!mdselemarray[!numb]" ARRAYS for the MDS STRUCTURE and/or the MDS HANGER Supports
     !mdselemarray[!numb][1] = !newone
     !mdselemarray[!numb][2] = !newtwo
     !mdselemarray[!numb][3] = !newlines
     !mdselemarray[!numb][4] = !newfour

-- Reset the "" OBJECT ARRAYS for "!!mdsabamtosteel.data.struelements" and "!!mdsabamtosteel.data.hangelements" for "MDS GROUPS"
-- *** OR ***
-- Reset the "MTO" OBJECT ARRAYS for !!mdsabamtosteel.data.elements for "INDIVIDUAL" -- MDS FRAMEWORK STRUCTURES or MDS HANGERS
     $!mdselemarray[$!numb][5][1] = !mdselemarray[!numb][1]
     $!mdselemarray[$!numb][5][2] = !mdselemarray[!numb][2]
     $!mdselemarray[$!numb][5][3] = !mdselemarray[!numb][3]
     $!mdselemarray[$!numb][5][4] = !mdselemarray[!numb][4]

   enddo
---------------------------------------------------------------------------------------------------
--<wd>feb2005
---------------------------------------------------------------------------------------------------


---------------------------------------------------------------------------------------------------
$(
--<wd>feb2005
---------------------------------------------------------------------------------------------------
-- The CODE shown commented out below has been replaced by the "do !numb indices !mdselemarray" code shown above etc...
---------------------------------------------------------------------------------------------------
-- ORIGINAL/EXISTING CODE used by "INDIVIDUAL" MDS STRUCTURES and/or MDS HANGERS
    !Counter = 2
    do !Count from 1 to !!mdsabamtosteel.data.elements[3].size()
      !PrevLines = !NewLines.size()
      !Lines     = !!MdsAbaSplitLine(!!mdsabamtosteel.data.elements[3][$!Count],!MaxWidth)
      !NewLines.appendarray(!Lines)
      !LinesNow  = !NewLines.size()
      if !Linesnow.eq(!PrevLines + 1) then
-- Only one line added
        !NewOne.append(!!mdsabamtosteel.data.elements[1][$!Count])
        !NewTwo.append(!!mdsabamtosteel.data.elements[2][$!Count])
        !NewFour.append(!!mdsabamtosteel.data.elements[4][$!Count])
      else
-- Multiple lines added, need to add spaces in others after adding original
        !Add = !LinesNow - !PrevLines - 1
       !NewOne.append(!!mdsabamtosteel.data.elements[1][$!Count])
        do !AddSpace from 1 to !Add
          !NewOne.append(' ')
        enddo
        !NewTwo.append(!!mdsabamtosteel.data.elements[2][$!Count])
        do !AddSpace from 1 to !Add
          !NewTwo.append(' ')
        enddo
        !NewFour.append(!!mdsabamtosteel.data.elements[4][$!Count])
        do !AddSpace from 1 to !Add
          !NewFour.append(' ')
        enddo
      endif
    enddo

    !!mdsabamtosteel.data.elements[1] = !newone
    !!mdsabamtosteel.data.elements[2] = !newtwo
    !!mdsabamtosteel.data.elements[3] = !newlines
    !!mdsabamtosteel.data.elements[4] = !newfour
---------------------------------------------------------------------------------------------------
--<wd>feb2005
$)
---------------------------------------------------------------------------------------------------

  laye
  delete laye

--<wd>jan2005
-- Build the MDS STRUCTURE / HANGER MTO table and pass the !mdsobject
--  !!mdsabamtosteel.maketable(!!mdsabamtoSteel.data.elements)
  !!mdsabamtosteel.maketable(!!mdsabamtoSteel.data.elements, !mdsobject)
---------------------------------------------------------------------------------------------------
--********************** The ARRAY "!!mdsabamtoSteel.data.elements" is ALWAYS passed as shown above,
--*** IMPORTANT NOTE *** but the method !!mdsabamtosteel.maketable(!!mdsabamtoSteel.data.elements,!mdsobject)
--********************** DETERMINES which ARRAYS to use for "MDS GROUPS", i.e. "!!mdsabamtoSteel.data.struelements" etc...
---------------------------------------------------------------------------------------------------
--<wd>jan2005

  !!ce = !view

-- Back to view and reset Function avoiding scale use.
  function 'NotUsed'

  !units.restoreSavedBoreDist()
  Prec var def

endfunction
-------------- End Of Code --------------
