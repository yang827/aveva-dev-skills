--
-- File:            MdsAbaOnTop.pmlfnc
--   Type:          Function
--
-- Author:          Neale Morris
-- Created:         17 November 2004
--
--
-- Description:
-- Function to check if a piece of text is ontop of another view on the same sheet

define function !!MdsAbaOnTop(!TextToCheck is DBREF) is BOOLEAN

  Prec 2 dp
  !units = object COMUNITS(TRUE)

--<GE> 08/12/06  Set UNITS to metric for making function work when in imperial.
  UNITS MM Bore
  UNITS MM Distance

-- Get current db position

  !ce = !!ce

-- Get extents of text
  !!ce = !TextToCheck

  var !extent extent btex
  !Extents = !extent.split()

  !TminX = !Extents[2]
  !TmaxX = !Extents[6]
  !TminY = !Extents[12]
  !TmaxY = !Extents[4]

  view
  !ViewOfText = !!ce

-- Climb to sheet and get views

  shee
  var !Sheets coll all view for ce

  !return = FALSE

  do !Check values !Sheets
    !!ce = !Check.dbref()
-- Skip owning view of text
    if !!ce.eq(!ViewOfText) then
      skip
    endif
-- Skip weld symbol view
    if !!ce.name.matchwild('*WELDV1*') then
      skip
    endif
    !Size = size
    !Xypo = xypo
    !VMinX = !xypo.east - (!Size[1] / 2)
    !VMaxX = !xypo.east + (!Size[1] / 2)
    !VMinY = !Xypo.north - (!Size[2] / 2)
    !VMaxY = !Xypo.north + (!Size[2] / 2)
    !ViewName = name
    --$P - View $!ViewName
    --$P - Min x = $!VMinX
    --$P - Max x = $!VMaxX
    --$P - Min y = $!VMinY
    --$P - Max y = $!VMaxY
-- Check if text is on top of view
    if     !Tminx.real().gt(!VMinx) and !Tminx.real().lt(!VMaxx) and !TminY.real().gt(!VminY) and !TminY.real().lt(!VmaxY) then
      !return = TRUE
    elseif !Tmaxx.real().gt(!VMinx) and !Tmaxx.real().lt(!VMaxx) and !TmaxY.real().gt(!VminY) and !TmaxY.real().lt(!VmaxY) then
      !return = TRUE
    elseif !Tminy.real().gt(!VMiny) and !Tminy.real().lt(!VMaxy) and !TminX.real().gt(!VminX) and !TminX.real().lt(!VmaxX) then
      !return = TRUE
    elseif !Tmaxy.real().gt(!VMinY) and !Tmaxy.real().lt(!VMaxy) and !TmaxX.real().gt(!VminX) and !TmaxX.real().lt(!VmaxX) then
      !return = TRUE
    endif
  enddo

  !!ce = !ce

--<GE> 08/12/06 Reset units to original state
  !units.restoreSavedBoreDist()
  Prec var def

 return !return

endfunction

