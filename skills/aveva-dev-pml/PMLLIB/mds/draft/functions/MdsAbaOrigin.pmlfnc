--
-- File: MdsAbaOrigin.pmlfnc
--   Type: Form
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: Draft MDS using ABA
--   Replaces:
--
-- Author: Wayne Dodwell
-- Created: Monday 11th June 2002
--
--
-- Description:
-- Function to Add MDS Structure ORIGIN SYMBOL to the ABA Drawing MAIN Views
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         DBREF of the Current MDS ABA View
--     2     R        DBREF         DBREF of the Current MDS ABA Support
--     3     R        DBREF         DBREF of the Current MDS ABA Datum Atta
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Define Function

define function !!mdsabaorigin(!view is DBREF , !support is DBREF , !datum is DBREF )

  !supportname = !support.name

-- If the :mdsorisymb uda is set to false do not put a symbol on the drawing
  if !view.:MDSOriSymb.not() then
    return
  endif

-- Get the Origin Location/Position of the MDS Structure

  !locn = !support.:mdsadploc
    handle any
      !locn = p9 pos of $!supportname/DATUM
      handle ANY
        -- hanger does not have /DATUM as origin
        !locn = p0 pos of $!supportname
      endhandle
    elsehandle none
    endhandle

-- If circ duct default to p0 of datum atta
---------------------------------------------
--<wd>03mar2008 -- DUN824 - Defect No. P-4405
--<wd>  Put back the 'handle any' code here which was removed by <kp>jan07 for MDS Lighting Supports at <mds12>,
--<wd>  because MDS ABA HANGER drawings weren't being considered here!!!
  !conntype = p1 conn of $!supportname/DATUM
  handle any
  elsehandle NONE
    if !conntype.eq('HVAS') then
      !locn = p0 pos of $!supportname/DATUM
    endif
  endhandle
--<wd>03mar2008 -- DUN824 - Defect No. P-4405
---------------------------------------------

  if (!locn.string().lowcase().eq('unset')) then
-- Use the Origin of the MDS Structure
      !origin = p9 pos of $!supportname/DATUM
        handle ANY
--<kp>jan07
-- can be lighting support
          if !support.:mdssupptype.eq(!!mdslsuppdefs.type) then
             !lsupp = object MDSLSUPPORT(!support)
             !origin = !lsupp.origin
          else
--<wd>03mar2008 Added this comment only --> The support type is a MDS HANGER
             !origin = !support.position
          endif
        endhandle
    else
-- Use the ADP Location position from the Datum Atta UDA :mdsadploc
      !origin = !locn
    endif
    !vlocn = !origin.string()

-- Navigate to the Current View
    !!ce  = !view
    !vnam = !view.name

-- Navigate to the Correct Layer
    !lnam = !vnam & '/USER_Labs'
    !!ce  =  !lnam.dbref()

-- Create the Origin Symbol and Place it at the MDS Support Origin Location/Position in the Current View
    new slab $!<lnam>/STRU_ORIGIN
      handle (41,12)
        $!<lnam>/STRU_ORIGIN
      elsehandle NONE
      endhandle
    !!ce.tmrf  = /MDS-Datum
--    xysc .5 .5
    xysc .33 .33
    !!ce.ddnam = !support
    llead off
-- Locate the Symbol at the Sheet Position of the 3D Position<!vlocn> to be used
    var !shpos shposition of $!vlocn
    at $!shpos
-- if group hanger and STYP of datum is REST and owner of dataum atta same as hanger atta
-- reposition the origin label at the hanger datum atta
   if !support.name.matchwild('*[1]') and !datum.stype.eq('PIPE-REST') then
     !ownerdatum1 = !datum.owner
     !datum2 = !datum.name.replace('[1]', '[2]').replace('/DATUM', '').dbref()
       handle ANY
       elsehandle NONE
         !ownerdatum2 = !datum2.owner
         if !ownerdatum1.eq(!ownerdatum1) then
           var !shpos shposition of $!datum2
           at $!shpos
         endif
       endhandle
   endif

-- Navigate to the Current View
    !!ce = !view
--------------------------------------------------------------------------------
  endfunction
-- End of Function - !!mdsabaorigin.pmlfnc
