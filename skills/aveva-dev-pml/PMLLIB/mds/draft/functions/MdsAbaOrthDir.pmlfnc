--
-- File:		MdsAbaOrthDir.pmlfnc
--   Type:		Form
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Draft MDS using ABA
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Thursday 23rd May 2002
--
--
-- Description:
-- Function to Get the ORTHOGONAL Direction of a Piping Component
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         DBREF of the Piping Component
--
-- Return:
--    [Data Type]   [Description]
--     ARRAY         [1] ORTHOGONAL Pleave Direction Object of the Piping Component
--                   [2] ORTHOGONAL Oppposite Direction Object to [1] of the Piping Component
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Define Function
define function !!mdsabaorthdir(!element is DBREF) is ARRAY

-- Initialise Variables
    !origin    = !!ce
  !direction = object DIRECTION()

--<kp>jan07
-- first check if it is lighting supports
    if !element.type.eq('STRU') then
    if !element.:mdssupptype.eq(!!mdslsuppdefs.type) then
          !suppobj = object MDSLSUPPORT(!element)
      !result[1] = !suppobj.ydir
      !result[2] = !result[1].opposite()
          return !result
       endif
    endif
--<kp>jan07

-- Check that Element is a Piping Component
  if (!element.owner.type.neq('BRAN') AND !element.owner.type.neq('CTRAY')) then
      !!alert.error('The passed element must be a PDMS Piping Component')
      return !direction
    endif

-- Generate the Orthogonal Direction of the Piping Component
  !pvector          = object POINTVECTOR()
    !pvector.position = !element.pos.wrt(world)

---------------------------------------------------------------------
--<wd>nov2003
---------------------------------------------------------------------
-- Determine the Correct Viewing Direction to Utilise on the
-- MDS ABA Drawing being created for the passed '!element'
    --!pvector.direction = !element.ldir.wrt(world)

-- Check if '!element' is on a MDS HANGER Support
    if (!element.cref.badref().not()) then
-- Datum Atta element on a MDS Fixed or Variable Hanger
      if (!element.cref.type.eq('HANG')) then
-- Check if '!element' STYP inset !!mdsallhangertypes.weldedelbowtrunion on a MDS HANGER Support
        if ( !!ce.styp inset $!!mdsallhangertypes.weldedelbowtrunion ) then
        --if (!element.styp inset ('FH23')) then
          !pvector.direction = !element.pdir[9].wrt(world)
        else
          !pvector.direction = !element.ldir.wrt(world)
        endif
      else
        !pvector.direction = !element.ldir.wrt(world)
      endif

    else
--<wd>feb2005
--  Check the Support Type of the passed "!element"
      !typeofsupport = !!mdsabatype(!element)
      if (!typeofsupport.eq('ANCILL')) then
        !pvector.direction = !element.ldir.wrt(world)

      elseif (!typeofsupport.eq('FRAME')) then
--<wd>feb2005
-- Datum Atta element on a MDS Framework
        !!ce = !element
      if !!mdsCheckTrun(!!mdsAbaSelSupp,'DATUMONLY').not() then
          !pvector.direction = !element.ldir.wrt(world)
        handle any
          !pvector.direction = !element.owner.pdir[2].wrt(world)
        endhandle
      else
        !stru = !!mdsGetSuppName(!element)
        !pvector.direction = !stru.dbref().:MdsFrameDir.wrt(world)
            handle ANY
              !pvector.direction = !element.ldir.wrt(world)
            endhandle
        endif
--<wd>feb2005
      endif
--<wd>feb2005
    endif

--<ge 08/03/05> HPD0027945 Fix for For Inline REST ATTAS Only that are not the DATUM Atta
  if !element.type.eq('ATTA') then
    if (!element.owner.:MDSTrun) then
      var !atta coll all atta for $!element.owner
      do !stypes values !atta
        if !stypes.dbref().spref.name.match('PIPE-REST-INLINE').gt(0)then
          !ori = ori wrt world
          !diry = !ori.string().after('Y is ').before('and')
          !pvector.direction = !diry.direction()
          break
        endif
        if !stypes.dbref().name.match('DATUM').gt(0)then
--<ge 14/04/05> Fix for double supported trunnions for KBR for some reason ???
-- it was navigating to the stru on certain specials and needed to be the DATUM atta
          $!stypes
--<ge 14/04/05>
          !ori = ori wrt world
          !diry = !ori.string().after('Y is ').before('and')
          !pvector.direction = !diry.direction()
          break
        endif
      enddo
    endif
  endif
$(-- For Inline REST ATTAS Only
    if !element.spref.name.match('PIPE-REST-INLINE').gt(0) then
      !ori = ori wrt world
      !diry = !ori.string().after('Y is ').before('and')
      !pvector.direction = !diry.direction()
    endif
$)

--<ge 08/03/05>

---------------------------------------------------------------------
--<wd>nov2003
---------------------------------------------------------------------

-- Create a LINE Object
    !line = !pvector.line(100)

-- Create a PLANE Object
  !plane          = object PLANE()
    !plane.position = !element.pos.wrt(world)

-- Determine if Pipe is either predominantly VERTICAL or HORIZONTAL
    --!elementdir = !element.ldir.wrt(world)
    !elementdir = !pvector.direction

    if (!elementdir.up.abs().eq(1)) then
-- Vertical Pipe
      !plane.orientation = Y is U wrt /* and Z is N wrt /*
    else
      !plane.orientation = Y is N wrt /* and Z is U wrt /*
    endif

-- Create a NEW LINE Object Projected onto the PLANE Object
    !projline  = !line.projected(!plane)
    !direction = !projline.direction()
    !opposite  = !direction.opposite()

-- Return the ORTHOGONAL Pleave Direction Object and the Opposite Direction of the Piping Component
  !dirarray = ARRAY()
    !dirarray.append(!direction)
    !dirarray.append(!opposite)
    return !dirarray

-------------------------------------------------------------------------------------
--------------------------------------------------------------------------------
  endfunction
