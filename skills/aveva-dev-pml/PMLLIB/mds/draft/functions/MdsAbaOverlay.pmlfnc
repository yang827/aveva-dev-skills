--
-- File:            MdsAbaOverlay.pmlfnc
--   Type:          Function
--
-- Author:          Tony Martin
-- Created:         10 April 2003
--
--
-- Description:
-- Basic task function called by abatasks for adding weld data overlays on a sheet
------------------------------------------------------------------------
-- Revision 0
------------------------------------------------------------------------
define function !!mdsabaoverlay(!params is array)

  !sheet = !!ce
  !units = object COMUNITS(TRUE)

  UNITS MM Bore
  UNITS MM Distance
  LOADFORM !!mdsabaSuppType

-- Read alternative support descriptions if not already loaded
--------------------
--<wd>feb2007<mds12>
  --if (undefined(!!Kmdsaltdft0911)) then
  if (undefined(!!mdsaltdft0911)) then
    --!!MdsReadAltd()
-- LOAD the MDS FRAMEWORK ALTERNATIVE CODE Descriptions for the
-- individual MDS FRAMEWORK SUPPORT CODES "Type and Size"
    !!mdsaltddefs = object mdsaltddefs()
--<wd>feb2007<mds12>
--------------------
  endif

-- Get support name
  !Name = !!ce.darref.name.before('-AREA')

--<wd>feb2005
-- Determine if the support is a MDS GROUP
  !!ce = !name.dbref()
  handle (2,109)
-- Check if MDS Support is the MASTER STRUCTURE, number [1], of a MDS GROUP, if UNDEFINED NAME error(2,109) occurs
    !name= !name + '[1]'
    !!ce = !name.dbref()
  endhandle
  !!ce = !sheet
--<wd>feb2005

  if !Name.dbref().type.eq('STRU') then
-- Frameworks
    !SrefAtta = !Name + '/SREF'
    !SuppType = !SrefAtta.dbref().styp.before('-')
--<kp>jan07
      handle ANY
      -- can be lighting support
         if !Name.dbref().:mdssupptype.eq(!!Mdslsuppdefs.type) then
            !Supptype = !!Mdslsuppdefs.type
         endif
      endhandle
  else
-- Hangers
    !SuppType = ''
  endif

--<kp>jan07
--  if !supptype inset('SPECIAL','FT21','FT22','FT30') then
  if !supptype inset('SPECIAL','$!!Mdslsuppdefs.type','FT21','FT22','FT30') then
    golabel /complete
  elseif !supptype inset('FT07','FT13') then
    !supptype = !supptype & '-' & !name.dbref().:MDSOrigin
  elseif !supptype inset('FT14','FT15','FT16','CT06','DT03') then
    !suffix = !SrefAtta.dbref().styp.after('-').before('-')
    !supptype = !supptype & '-' & !suffix
  endif


  -- Check for overlay existance
  !symref = !params[3] & !Supptype & '/DETAIL'
  !symbol = !symref.dbref()
  handle any
    !!abalogging.error('Symbol $!symref not found -aborting task')
    return
  endhandle

  !viewname = !!ce.name & '/WELDV1'
  shee
  new view $!viewname after last mem
  handle (41,12)
   $!viewname
   delete view
   new view $!viewname after last mem
  endhandle
  new layer $!viewname/L1
  new vnote $!viewname/L1/N1
  ddna $!name
  handle any
    !!abalogging.error('Unable to set Symbol ref to appropriate structure - Weld sizes may be missing')
  endhandle
  new symb at $!params[1]
  xyscale $!params[2] $!params[2]
  tmrf $!symbol

label /complete
-- Create
!message[1] = 'Completed MDS overlay'
!!abalogging.addtolog(!message)

endfunction
