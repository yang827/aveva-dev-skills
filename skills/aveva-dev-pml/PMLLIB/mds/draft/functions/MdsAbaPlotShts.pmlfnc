--
-- File:		mdsabaplotshts.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Draft MDS3.1.1 using ABA11.4
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Monday 6th January 2003
--
--
-- Description:
-- Main MDS ABA Plot Sheets in the Registry
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--
-- Define Function
  define function !!mdsabaplotshts()

-- Units
   !units = object COMUNITS(TRUE)
    units FINCH DISTANCE
-- Get the Default MDS ABA Registry
    !regix = '/' & !!mdsabaselsupp.registry.selection()
    handle any
      !!alert.error('MDS ABA Drawing Creation needs to be initialised before plotting of Drawings is allowed.')
      !units.restoreSavedUnitsByPtype('DIST')
      return
    endhandle

-- Go to the Selected Registry
    !regis = !regix.dbref()
    !!ce   = !regis

-- Get an Array of Sheets to Plot
    var !sheets coll all sheets for ce
    var !snames eval name for all from !sheets
    !size = !snames.size()

-- Plot the Sheets to the C:/Temp directory
-- e.g. PLOT /MDS-ABA-3-VIEWS(IMPERIAL)-ft09-v-aba-1-AREA/S1 /c:/temp/MDS-ABA-3-VIEWS(IMPERIAL)-ft09-v-aba-1-AREA.S1.plt 16.53 11.69 CUTM OFF

    if (!!alert.confirm('There are ** $!size ** MDS ABA Drawing Sheets about to be plotted to the ** C:/TEMP ** directory. Continue?').eq('YES')) then
      do !indx indices !snames
        !plotname = !snames[!indx].replace('/S1','.S1')
        plot $!snames[$!indx] /c:/temp$!plotname$n.plt 16.53 11.69 CUTM OFF OVERWRITE
        handle none
          $P ** Generating Plotfile ** /c:/temp$!plotname$n.plt
        elsehandle any
          $P $!!ERROR.TEXT ** Aborting Plotfile ** /c:/temp$!plotname$n.plt
        endhandle
      enddo
    endif

-- Reset Units
    !units.restoreSavedUnitsByPtype('DIST')

--------------------------------------------------------------------------------
  endfunction
-- End of Function - mdsabaplotshts.pmlfnc
