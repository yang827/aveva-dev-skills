--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         DBREF of the Selected MDS Support
--     2     R        STRING        STRING - 'CREATE' or 'DELETE'
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Define Function
--------------------------------------------------------------------------------
  define function !!MdsAbaregis(!dept is dbref, !string is STRING)

    if (!dept.type.neq('DEPT')) and (!dept.type.neq('REGI')) then
      !!alert.error(|1st. ARGUMENT - Only PDMS Draft DBREFs DEPT or REGI elements may be passed to this function|)
      return
    endif

    if (!string.upcase().neq('CREATE')) and (!string.upcase().neq('DELETE')) then
      !!alert.error(|2nd. ARGUMENT - Only the strings CREATE or DELETE may be passed to this function|)
      return
    endif

    if (!string.upcase().eq('CREATE')) then
      !!ce = !dept
      do !indx from 1 to 100
        new regi /MDS-TEST-WD-REGI-$!indx
      enddo
    elseif (!string.upcase().eq('DELETE')) then
      !!ce = !dept
      do !indx from 1 to 100
        !!ce = /MDS-TEST-WD-REGI-$!indx
        handle any
          if (!indx.gt(100)) then
            return
          else
            skip
          endif
        elsehandle none
          delete regi
        endhandle
      enddo
    endif

  endfunction
--------------------------------------------------------------------------------
-- End of Function - !!MdsAbaregis.pmlfnc
