--
-- File:            MdsAbaRunData.pmlfnc
--   Type:          Function
--
-- Author:          Martin Wright
-- Created:         10 June 2002
--
--
-- Description:
-- Basic task function called by abatasks for showing run data from project.
------------------------------------------------------------------------
-- Revision 0 10-06-2002 Development Session
------------------------------------------------------------------------
define function !!MdsAbaRunData(!params is array)

  !sheet = !!ce
  !units = object COMUNITS(TRUE)

  UNITS MM Bore
  UNITS MM Distance
  LOADFORM !!mdsabarunData

-- Set up string to place in corner of view.
  !session = CURRENT SESSION

  if (!params[1] EQ 'NT Login Name') then
    !user = !session.login
  else
    !user = !session.name
  endif

-- Find support name

  !Name = !!ce.darref.name.before('-AREA')

-- Do not put rub by text on framatome drawing with a :MMSStatus or :status of geq 70

  if (desc of /MDS/TEMPLATES eq 'Framatome Templates') then
    !Status = :MMSSTATUS of $!Name
       handle ANY
         !Status = :MMSSTATUS of $!Name$n[1]
           handle ANY
             !Status = :STATUS of $!Name
               handle ANY
                 !Status = :STATUS of $!Name$n[1]
               endhandle
           endhandle
       endhandle
    !StatusReal = !Status.before('#').real()
      handle ANY
        !StatusReal = 0
      endhandle
    if !StatusReal.unset() then
      !StatusReal = 0
    endif
    if !StatusReal.geq(70) then
      !!ce = !sheet
      !units.restoreSavedBoreDist()
      return
    endif
  endif

   --!ReportStage = !Name.dbref().:MMSRepStg
   !ReportStageval = !Name.dbref().:MMSRepStg
     handle any
        !ReportStage = ''
     elsehandle none
       --!ReportStage = 'Report Stage: $!ReportStage'
       !reportval   = !reportstageval.string()
       !ReportStage = 'Report Stage: $!Reportval'
     endhandle

   !date = !!MdsAbaRunData.getDate()
   --!pdmsuda = 'REPSTAGE'
   --var !uda :$!pdmsuda

--   !string = 'RUN BY: ' & !user & '  DATE: ' & !date & '  ' & !pdmsuda & ':' & !uda
   !string = 'RUN BY: ' & !user & '  DATE: ' & !date & ' ' & !ReportStage

-- Put the note at the bottom left hand corner of the sheet.
-- Tidy up existing notes.

   var !oldnote COLL ALL NOTE WITH (ATTRIB FUNCTION EQ 'MdsAbaRunData') FOR CE

-- Delete old notes.
   do !oldnot value !oldnote
      $!oldnot
      DELETE NOTE
   enddo

-- Position at the SHEET, find out how many members there are.
   var !mems SPLIT MEMBERS

-- Position at the end so that new NOTE gets put on end of list.
   !order = !mems.size()
   $!order

   NEW NOTE
   !name = NAME OF OWNER
   NAME $!name/TaskNOTE1
   Function 'MdsAbaRunData'
   NEW TEXP
   BTEXT |$!string|
   CHEIGHT $!params[2]
   !origin = 'X ' & !params[3] & ' Y ' & !params[4]
   ORIGIN $!origin

   !!ce = !sheet
   !units.restoreSavedBoreDist()

endfunction

-------------- End Of Code --------------
