-- Created:
--
--
-- Description:
-- Function to select all support for detailing
--
----------------------------------------------------------------------
--
-- Arguments:
--
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
----------------------------------------------------------------------

-- Define Function
define function !!MdsAbaSelectAll(!What is STRING)

  if !What.eq('FRAME') then
    if !!MdsAbaSelSupp.allframe.val then
       !!mdsabaselsupp.Frame.val = !!mdsabaselsupp.Frame.Rtext.indices()
    else
       !!mdsabaselsupp.Frame.ClearSelection()
    endif
  elseif !What.eq('HANGER') then
    if !!MdsAbaSelSupp.allhanger.val then
       !!mdsabaselsupp.Hanger.val = !!mdsabaselsupp.Hanger.Rtext.indices()
     else
      !!mdsabaselsupp.hanger.clearselection()
    endif

--<wd>feb2005
-- Stand Alone Ancillaries
  elseif (!what.eq('ANCILL')) then
    if (!!mdsabaselsupp.allancill.val) then
       !!mdsabaselsupp.Ancill.val = !!mdsabaselsupp.Ancill.Rtext.indices()
    else
       !!mdsabaselsupp.ancill.clearselection()
    endif
--<wd>feb2005

  endif

  !!mdsabaselsupp.abaprocess()

-- End function
endfunction

-- End of file MdsAbaSelectAll.pml
