----------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:      MdsAbaSetIdln.pmlfnc
-- Type:      Object Definition
-- Group:     Multi Discipline Supports Application
-- Keyword:   MDS
-- Module:    Draft MDS using ABA for Drawing production
-- Replaces:
--
-- Author:    Steve Robinson
-- Created:   1st July 2002
--
--
-- Description:
-- ------------
-- This function creates the idlist for a given view and stru/hang
--
--
-- Using this function:
-- --------------------
-- For each view call this function with the stru or HANG DBREF
-- and the view DBREF.
--
-- The function populates the idlist for the view by adding the structure and
-- ANY associated support attas or an individual hanger
--
--------------------------------------------------------------------------------
-- Define Function
----------------------------------------------------------
-- Arguments:
--  removed.
--
----------------------------------------------------------
--<wd>jan2005
--define function !!mdsabasetidln(!item is DBREF, !view is DBREF, !type is STRING, !vol is BOOLEAN)
define function !!mdsabasetidln(!mdsobject is MDSABASUPPORT, !view is DBREF, !dummytype is STRING, !vol is BOOLEAN)

--<kp>july06
-- store extra drawlist from :MdsAdp and :MdsAdpRem
  !mdsAdp = !mdsobject.getElemForUDA().:MDSAdp
  !mdsAdpRem = !mdsobject.getElemForUDA().:MDSAdpRem
--<wd>jan2005
-- Set the variable !item to the MDS Support DBREF held in the OBJECT
  !item     = !mdsobject.support
  !suppName = !item.name
--<wd>jan2005

  !saveRef = !!ce
  !shortname = !suppName.before('[')

-- navigate to view
  $!view
  var !limits limits of darref of owner
  !viewName = !!ce.name

-- check idli exists - if not then create it
  set
  $!viewName/IDLIST
  handle ANY
    DRWG
    !drwgname = !!ce.name
    $!drwgname/LIBY1
    handle ANY
      NEW LIBY $!drwgname/LIBY1
    endhandle
    new DLLB $!viewName/IDLIST
  endhandle

  $!viewName/IDLIST/IDLI
  handle ANY
    NEW IDLI $!viewName/IDLIST/IDLI
  endhandle
  !idli = !!ce
  limits $!limits

-- clear out ANY existing idlist members
  DELETE IDLI MEMBERS
  handle ANY
  endhandle

--  if (!item.type.neq('ATTA')) then
--<kp>jan07
  if !item.type.eq('STRU') then
    if !item.:mdssupptype.eq(!!mdslsuppdefs.type) then
     -- Lighting support
        !atta = !item
     else
     -- MDS STRUCTURE
       !att = !item.name & '/DATUM'
       !atta = !att.dbref()
     endif
--<kp>jan07
  else
-- MDS HANGER or a "Stand-Alone" MDS ANCILLARY Support
    !atta = !item
  endif

---------------------------------------------------------------------------------------------------
  -- VIEW TASK parameter (!vol) is Set to "TRUE" so ADD ALL elements contained within the LIMITS of the VIEW
-- Drawlist driven by contents of volume
  if (!vol) then
    !lim = !limits.after('From ')
    add all within $!lim
-- now remove the items from the remove list
--<kp>july06
    --!remItems = !atta.:MDSAdpREM
    !remItems = !mdsAdpRem
    do !rruls values !remItems
      if !rruls.badref().not() then
        $!viewName/IDLIST/IDLI
        rem $!rruls
      endif
    enddo
-- Save the list for later addition to local rules
    var !addlist coll all adde for ce
    var !addListRefs eval idna for all from !addlist
  endif
---------------------------------------------------------------------------------------------------

-- Get ALL SCTNS, ATTAS and RESTRAINTS to be processed
--<wd>feb2005
  if (!mdsobject.mdsdata.supptype.eq('ATTA')) then
-- "Stand-Alone" MDS Ancillary Support(s) are always on the same Pipe Branch
    !items = ARRAY()
-- Append the MAIN ATTA to the !items ARRAY
    !items.append(!item)
    $!idli
    add $!item
    add owner of $!item
    !nameOfAtta = !item.name
-- Append ANY other ATTAS to the !items ARRAY
    do !index from 1 to 100
      $!nameOfAtta$n.$n$!index
      handle NONE
        !items.append($!nameOfAtta$n.$n$!index )
        $!idli
        add $!nameOfAtta$n.$n$!index
      elsehandle ANY
        skip
      endhandle
      $!idli
      add owner of $!nameOfAtta
    enddo

    --if (!item.type.eq('ATTA') and !item.cref.type.eq('HANG')) then
  elseif (!item.type.eq('ATTA') and !item.cref.type.eq('HANG')) then

-- MDS HANGER Support
--<wd>feb2005
    ADD owner of cref of $!item
    !nameOfAtta = !item.name
    ADD owner of $!nameOfAtta

-- Because we remove the :mdsattaref pointer for a special we need to add all the pipes
  elseif !item.type.eq('STRU') and !item.:MDSSuppType.eq('SPECIAL') then
    !nameOfAtta = !item.name
    ADD owner of $!nameOfAtta/DATUM
    do !count from 1 to 100
      $!nameOfAtta$n.$n$!count
      handle NONE
        same
        add owner of same
      elsehandle ANY
        skip
      endhandle
    enddo
    var !sctns coll all sctn for $!item
    var !sctns append coll all subs for $!item
    !items = ARRAY()
    do !sctn values !sctns
      $!sctn
      !items.append(!!ce)
      !items.appendarray(!!ce.:mdsattaref)
      handle ANY
      endhandle
    enddo

    -- get reference atta assiciated with STRU
    do !refAtta values !item.dassci
       $!idli
       skip if !refAtta.badref()
       add owner of $!refAtta
       $!saveRef
       handle ANY
       endhandle
       last mem
       handle ANY
       endhandle
       new rrul
       use /MDS-Extra-Drawlist-Style for owner of $!refAtta

       if (!refAtta.cref.set() and !refAtta.cref.badref().not()) then
         $!idli
         add $!refAtta.cref
         $!saveRef
         handle ANY
         endhandle
         last mem
         handle ANY
         endhandle
         new rrul
         use /MDS-Extra-Drawlist-Style for $!refAtta.cref
       endif
    enddo
    -- add all hangers
    do !sctn values !sctns
      do !member values !sctn.dbref().members
        if (!member.type eq 'FITT' and !member.cref.set() and !member.badref().not()) then
          if(!member.cref.type eq 'HANG') then
            $!idli
            add $!member.cref
            $!saveRef
            handle ANY
            endhandle
            last mem
            handle ANY
            endhandle
            new rrul
            use /MDS-Extra-Drawlist-Style for $!member.cref
          endif
        endif
      enddo

      do !refSupport values !sctn.dbref().dassci
        skip if !refSupport.badref()
        skip if !refSupport.namtyp.match(!shortname).gt(0)
        $!idli
        add $!refSupport
        $!saveRef
        handle ANY
        endhandle
        last mem
        handle ANY
        endhandle
        new rrul
        use /MDS-Extra-Drawlist-Style for $!refSupport
      enddo
    enddo
--<wd>>june2003
-- Added the STRU <MDS SUPPORT SPECIAL STRUCTURE> element to ensure ALL elements in the STRU are now DRAWN
-- e.g. PANEL elements will be DRAWN but NOT ITEMISED in the MTO or TAGGED on the DRAWING
--      That is a FUTURE ENHANCEMENT for MDS SPECIALS -
-- *** CURRENTLY MDS only puts the TAGS on the DRAWING and accounts for SCTNS and BOXES<PLATES> in the MTO ***
    !items.append(!item)
--<<wd>june2003

-------------------------------------------------
--<wd>jan2005
-- Append ALL MDS GROUP MAIN MEMBERS to the IDLI except the Master MDS FRAMEWORK STRUCTURE in the MDS GROUP<added above>
    if (!mdsobject.mdsdata.mdsgroup) then
-- MDS GROUP Support
      do !indx values !mdsobject.mdsdata.maingroupmem
        skip if !indx.type.eq('STRU')
        !items.append(!indx)
      enddo
    endif
--<wd>jan2005
-------------------------------------------------
-- Generate ALL DRAWLIST members
    $!idli
    do !ditem values !items
      --if !ditem.type.eq('ATTA') and !type.eq('BRAN') then
      if !ditem.type.eq('ATTA') then
--<wd>feb2005
        --add owner of $!ditem
-- Check if the ATTA CREF is SET and if so it references a MDS HANGER
        if (!ditem.cref.set()) then
          if (!ditem.cref.type.eq('HANG')) then
            add owner of cref of $!ditem
            !nameOfAtta = !ditem.name
            add owner of $!nameOfAtta
          else
            add owner of $!ditem
          endif

        else
          --add $!ditem
          add owner of $!ditem
        endif
--<wd>feb2005
      else
        add $!ditem
      endif
    enddo

---------------------------------------------------------------------------------------------------
--<kp>jan07
  elseif !item.type.eq('STRU') and !item.:MDSSuppType.eq(!!mdslsuppdefs.type) then
-- lighting support
    var !sctns coll all sctn for $!item
    var !sctns append coll all subs for $!item
    var !sctns append coll all pjoi for $!item
    !items = ARRAY()
-- add support to drawlist
    add $!item
  else
-- MDS FRAMEWORK Structure
    var !sctns coll all sctn for $!item
    var !sctns append coll all subs for $!item
    var !sctns append coll all pjoi for $!item
    --<kp>may2011
    -- PANEls added
    var !sctns append collect all PANE for $!item
    !items = ARRAY()

    !nameOfAtta = !item.name
    ADD owner of $!nameOfAtta/DATUM
    do !count from 1 to 100
      $!nameOfAtta$n.$n$!count
      handle NONE
        same
        add owner of same
      elsehandle ANY
        skip
      endhandle
    enddo

    $!idli
    -- get reference atta assiciated with STRU
    do !refAtta values !item.dassci
       $!idli
       skip if !refAtta.badref()
       add owner of $!refAtta
       $!saveRef
       handle ANY
       endhandle
       last mem
       handle ANY
       endhandle
       new rrul
       use /MDS-Extra-Drawlist-Style for owner of $!refAtta

       if (!refAtta.cref.set() and !refAtta.cref.badref().not()) then
         $!idli
         add $!refAtta.cref
         $!saveRef
         handle ANY
         endhandle
         last mem
         handle ANY
         endhandle
         new rrul
         use /MDS-Extra-Drawlist-Style for $!refAtta.cref
       endif
    enddo
    do !sctn values !sctns
      do !member values !sctn.dbref().members
        if (!member.type eq 'FITT' and !member.cref.set() and !member.badref().not()) then
          if(!member.cref.type eq 'HANG') then
            $!idli
            add $!member.cref
            $!saveRef
            handle ANY
            endhandle
            last mem
            handle ANY
            endhandle
            new rrul
            use /MDS-Extra-Drawlist-Style for $!member.cref
          endif
        endif
      enddo

      -- add Hangers connected to SCTN
      do !refSupport values !sctn.dbref().dassci
        skip if !refSupport.badref()
        $!idli
        add $!refSupport
        $!saveRef
        handle ANY
        endhandle
        last mem
        handle ANY
        endhandle
        new rrul
        use /MDS-Extra-Drawlist-Style for $!refSupport
      enddo
    enddo

    do !sctn values !sctns
      $!sctn
      !items.append(!!ce)
      --!items.appendarray(!!ce.:mdsattaref)
      --handle ANY
      --endhandle
    enddo

-------------------------------------------------
--<wd>jan2005
-- Append ALL MDS GROUP MAIN MEMBERS to the IDLI except the Master MDS FRAMEWORK STRUCTURE in the MDS GROUP<added above>
    if (!mdsobject.mdsdata.mdsgroup) then
-- MDS GROUP Support
      do !indx values !mdsobject.mdsdata.maingroupmem
        skip if !indx.type.eq('STRU')
        !items.append(!indx)
      enddo
    endif
--<wd>jan2005
-------------------------------------------------

-- Generate all drawlist members

    $!idli

    do !ditem values !items
      --if !ditem.type.eq('ATTA') and !type.eq('BRAN') then
      if !ditem.type.eq('ATTA') then

--<wd>jan2005
        --add owner of $!ditem
-- Check if the ATTA CREF is SET and if so it references a MDS HANGER
        if (!ditem.cref.set()) then
          if (!ditem.cref.type.eq('HANG')) then
            add owner of cref of $!ditem
            !nameOfAtta = !ditem.name
            add owner of $!nameOfAtta
          else
            add owner of $!ditem
          endif

        else
          --add $!ditem
            add owner of $!ditem
--             $P adding $!ditem
        endif
--<wd>jan2005

      else
        add $!ditem
      endif
    enddo

  endif
---------------------------------------------------------------------------------------------------

-- Add extra drawlist list items to a local rule and all joints that do not belong to the support and connected steelwork
  !!viewName = !!ce

--<wd>feb2005
  if (!mdsobject.mdsdata.supptype.eq('ATTA')) then
-- "Stand-Alone" MDS Ancillary Support(s) are always on the same Pipe Branch
-- Extra drawlist items only
--<kp>july06
    --!extraItems = !item.:mdsadp
    !extraItems = !mdsAdp
    do !rruls values !extraItems
      if !rruls.badref().not() then
        $!viewName/IDLIST/IDLI
        add $!rruls
        $!saveRef
          handle ANY
          endhandle
        last mem
          handle ANY
          endhandle
        new rrul
        use /MDS-Extra-Drawlist-Style for $!rruls
      endif
    enddo
    !plateRef = !item.:MdsAncRef
    if !plateRef.size().gt(0) then
      if !plateRef[1].badref().not() then
        $!viewName/IDLIST/IDLI
        add $!plateRef[1]
        $!saveRef
          handle ANY
          endhandle
        last mem
          handle ANY
          endhandle
        new rrul
        use /MDS-Extra-Drawlist-Style for owner of owner of owner of $!plateRef[1]
      endif
    endif

    -- add steel associated with atta
    if (!item.dassci.set() and !item.dassci.empty().not()) then
      do !associatedElement values !item.dassci
          var !possibleSctns coll all sctn for $!associatedElement
          do !section values !possibleSctns
            -- add all sections from frame for SPECIAL
            if (!associatedElement.:MDSSuppType eq  'SPECIAL') then
              $!section
              fixing
              handle any
                $!viewName/IDLIST/IDLI
                add $!section
                $!saveRef
                handle ANY
                endhandle
                last mem
                handle ANY
                endhandle
                new rrul
                use /MDS-Extra-Drawlist-Style for $!section
              endhandle
            else
              -- add only section that is associated with atta
              if (!section.dbref().:MDSAttaRef.findfirst(!item).set()) then
                $!viewName/IDLIST/IDLI
                add $!section
                $!saveRef
                handle ANY
                endhandle
                last mem
                handle ANY
                endhandle
                new rrul
                use /MDS-Extra-Drawlist-Style for $!section
              endif
            endif
          enddo
      enddo
    endif

    --if (!item.type.eq('ATTA') and !item.cref.type.eq('HANG')) then
  elseif (!item.type.eq('ATTA') and !item.cref.type.eq('HANG')) then
-- MDS HANGER Support
--<wd>feb2005

-- Extra drawlist items only
--<kp>july06
    --!extraItems = !item.:MDSAdp
    !extraItems = !mdsAdp
    do !rruls values !extraItems
      if !rruls.badref().not() then
        $!viewName/IDLIST/IDLI
        add $!rruls
        $!saveRef
          handle ANY
          endhandle
        last mem
          handle ANY
          endhandle
        new rrul
        use /MDS-Extra-Drawlist-Style for $!rruls
      endif
    enddo
    -- Always add steelwork or civils
    $!viewName/IDLIST/IDLI

    --get the reference of hanger1
    !attaName = !item.name
    do !i from 1 to 2
      !hangerName = !attaName + '/H$!i'
      !hanger = !hangerName.dbref()
      handle (2,109)
        --the hanger does not exist do not process it (should only ever be hanger 2)
        skip
      endhandle
      if !hanger.tref.unset() then
      	--this must be a virtual fitting situation
      	do !j from 1 to !hanger.:mdscivref.size()
      	  !ref = !hanger.:mdscivref[!j]
      	  add $!ref
        enddo
      else
        --this is the normal hanger case with a hanger with fitting on steel or panel
        !tref = !hanger.tref
        if !tref.unset() then
      	  --try to update idlist with the hanger mdscivref attribute
      	  do !j from 1 to !hanger.:mdscivref.size()
      	    !ref = !hanger.:mdscivref[!j]
      	    add $!ref
          enddo        	
        else
      	  --try to update idlist with the fitting :MDSConnect attribute
      	  !owner = !tref.owner
      	  add $!owner
      	  if !tref.type.eq('SBFI') then
      	  	skip
      	  endif
      	  do !j from 1 to !tref.:MDSConnect.size()
      	    !ref = !tref.:MDSConnect[!j]
      	    add $!ref
          enddo
        endif
      endif
    enddo
    $!saveRef
      handle ANY
      endhandle
    last mem
      handle ANY
      endhandle
    new rrul
    if !item.cref.set() then
      if !item.cref.tref.set() then
        if !item.cref.tref.type.eq('FITT') then
          use /MDS-Extra-Drawlist-Style for owner of tref of cref of $!item
        else
          use /MDS-Extra-Drawlist-Style for owner of owner of owner of tref of cref of $!item
        endif
      elseif !item.cref.:MDSCIVREF.set() then
        --dun1218 if the tref is not set then try and locate the connecting steelwork or civils using the :MDSCIVREF UDA - start
        do !k from 1 to !item.cref.:MDSCIVREF.size()
          !civRefItem = !item.cref.:MDSCIVREF[!k]
          use /MDS-Extra-Drawlist-Style for $!civRefItem
        enddo
        --dun1218 if the tref is not set then try and locate the connecting steelwork or civils using the :MDSCIVREF UDA - end
      else
        delete rrul
      endif

      if (!item.cref.dassci.set()) then
        do !steel values !item.cref.dassci
          $!viewName/IDLIST/IDLI
          add $!steel
          $!saveRef
          handle ANY
          endhandle
          last mem
          handle ANY
          endhandle
          new rrul
          use /MDS-Extra-Drawlist-Style for $!steel
        enddo
      endif
    endif
  else
-- Extra drawlist items
    !stru = stru of $!sctns[1]
      handle ANY
      !stru = !item
      endhandle
--<kp>jan07
    --!datum = !stru.name + '/DATUM'
--<kp>july06
    --!extraItems = !datum.dbref().:MDSAdp
    !extraItems = !mdsAdp
    do !rruls values !extraItems
      if !rruls.badref().not() then
        $!viewName/IDLIST/IDLI
        add $!rruls
          $!saveRef
          handle ANY
          endhandle
          last mem
          handle ANY
          endhandle
          new rrul
        use /MDS-Extra-Drawlist-Style for $!rruls
        endif
      enddo
-- Joints that do not belong to support
--
--<wd>may2007<mds12>
-- This CODE is also run when SJOI doe belong to !stru, so ONL collect the SJOI elements with a VALID SPREF/CATREF reference
    --      var !joints coll all sjoi for $!stru
    var !joints coll all sjoi with (func neq 'DUMMY') for $!stru
--<wd>may2007<mds12>
    do !rruls values !joints
      !jointName = !rruls.dbref().name
      !jointType = !rruls.dbref().catref.name

      --<wd>03march2010 - DUN 1233 - NEW SCTN Types "Q3O" and "Q5O" have SJOIS with an unset SPREF but is Connected to the 2nd SCTN
      handle ANY
        -- ERROR (2,754)Argument 1 to ATTRIBUTE is unset = SPREF/CATREF is UNSET
        skip
      elsehandle NONE
        --<wd>03march2010 - DUN 1233 - NEW SCTN Types "Q3O" and "Q5O" have SJOIS with an unset SPREF

        if !jointName.match(!stru.name).eq(0) and !jointType.match('U6').gt(0).not() then
          $!viewName/IDLIST/IDLI
          add $!rruls
          $!saveRef
          handle ANY
          endhandle
          last mem
          handle ANY
          endhandle
          new rrul
          use /MDS-Extra-Drawlist-Style for $!rruls
        endif

    --<wd>03march2010 - DUN 1233 - NEW SCTN Types "Q3O" and "Q5O" have SJOIS with an unset SPREF
  endhandle
  --<wd>03march2010 - DUN 1233 - NEW SCTN Types "Q3O" and "Q5O" have SJOIS with an unset SPREF
      enddo
    endif

--<kp>jan07
  -- add lighting and attached structure of lighting support
--<wd>feb2007<mds12>
    if (defined(!stru)) then
--<wd>feb2007<mds12>
    if !stru.:mdssupptype.eq(!!mdslsuppdefs.type) then
          if !stru.:mdssref.badref().not() then
        $!viewName/IDLIST/IDLI
             add $!stru.:mdssref
             last memb of $!view
                 handle ANY
                   $!view
                 endhandle
             new rrul use /MDS-Extra-Drawlist-Style for $!stru.:mdssref
          endif
          if defined(!stru.:mdsancref[1]) then
             if !stru.:mdsancref[1].badref().not() then
          $!viewName/IDLIST/IDLI
                add $!stru.:mdsancref[1]
                last memb of $!view
                    handle ANY
                      $!view
                    endhandle
                new rrul use /MDS-Extra-Drawlist-Style for $!stru.:mdsancref[1]
             endif
          endif
      endif
--<wd>feb2007<mds12>
    endif
--<wd>feb2007<mds12>
-- Connected steelwork
  !connectingSctns = ARRAY()
  do !jointsForSctns values !sctns
    if !jointsForSctns.dbref().type.eq('SCTN') then
      !jois = jois of $!jointsForSctns
      !joie = joie of $!jointsForSctns
        if !jois.unset().not() then
        !jointStru = stru of $!jois
        if !stru.name.matchwild(!jointStru.name).not() then
          $!viewName/IDLIST/IDLI
          add sctn of $!jois
              $!saveRef
                handle ANY
                endhandle
              last mem
                handle ANY
                endhandle
              new rrul
          use /MDS-Detail-Style(No-Insu) for $!jois
          !connectingSctns.append(sctn of $!jois)
          endif
        endif

        if !joie.unset().not() then
        !jointStru = stru of $!joie
        if !stru.name.matchwild(!jointStru.name).not() then
          $!viewName/IDLIST/IDLI
          add sctn of $!joie
              $!saveRef
                handle ANY
                endhandle
              last mem
                handle ANY
                endhandle
              new rrul
          use /MDS-Detail-Style(No-Insu) for $!joie
          !connectingSctns.append(sctn of $!joie)

--<wd>sep2003
        elseif (!stru.name.matchwild(!jointStru.name) and !joie.type.eq('PJOI') and !stru.:mdssupptype.eq('SPECIAL')) then
          $!viewName/IDLIST/IDLI
            add $!joie
            $!saveRef
              handle ANY
              endhandle
            last mem
              handle ANY
              endhandle
            new rrul
          use /MDS-Detail-Style(No-Insu) for $!joie
--<wd>sep2003
          endif
        endif
      endif
    enddo

  ---------------------------------------------------------------------------------------------------------------------------
  --new association code feature 2158, shows supporting members that are stored in an association rather than a joint - start
  ---------------------------------------------------------------------------------------------------------------------------
  if defined(!stru) then
    !assocName = !stru.name + '-MDS-ASSOGP'
    var !assMbrs collect all assmbr for $!assocName
    handle ANY
      --do nothing
    elsehandle NONE
      !amemrfs = object ARRAY()
      do !i from 1 to !assMbrs.size()
        !amemrf = !assMbrs[!i].dbref().amemrf
        handle ANY
          skip
        endhandle
        if !amemrf.set() and !amemrf.badref().not() then
          !amemrfs.append(!amemrf)
        endif
      enddo
      !amemrfs.unique()
      do !amemrf values !amemrfs
        $!viewName/IDLIST/IDLI
        add $!amemrf
        $!saveRef
        handle ANY
        endhandle
        last mem
        handle ANY
        endhandle
        new rrul
        use /MDS-Detail-Style(No-Insu) for $!amemrf
        !connectingSctns.append(!amemrf)
      enddo
      !connectingSctns.unique()
    endhandle
  endif
  -------------------------------------------------------------------------------------------------------------------------
  --new association code feature 2158, shows supporting members that are stored in an association rather than a joint - end
  -------------------------------------------------------------------------------------------------------------------------

-- now clean up the drawlist
     !!ce = !idli
     !currentaddlist = ARRAY()
     do !a values !!ce.members
       if !a.type.eq('ADDE') then
         -- if the current idname is already in !currentaddlist then it must be a duplicate
         if !currentaddlist.findfirst(!a.idname).unset() then
-- add the item to !currentaddlist because it is not a duplicate
           !currentaddlist.append(!a.idname)
         else
-- its in the currentaddlist, therefore a duplicate so delete it
           !!ce = !a
           delete adde
         endif
       endif
     enddo

  do !addConnecting values !connectingSctns
      $!saveRef
        handle ANY
        endhandle
      last mem
        handle ANY
        endhandle
      new rrul
    use /MDS-Extra-Drawlist-Style for $!addConnecting
    enddo

-- Loop through sections to find connecting plates and add then as a extra drawlist element
-- and add then to the drawlist

  do !addPlates values !sctns
    !plateRef = !addPlates.dbref().:MdsAncRef
      handle(2,204)
         -- attribute not valid on pjoi
         skip
      endhandle
    do !addPlatesA from 1 to !plateRef.size()
      if !plateRef[$!addPlatesA].badref().not() then
        $!viewName/IDLIST/IDLI
        add $!plateRef[$!addPlatesA]
          $!saveRef
            handle ANY
            endhandle
          last mem
            handle ANY
            endhandle
          new rrul
        --<GE>06/12/06 Fix for HPD0033896 representation incorrect when bedplates (FT22) referenced to support
        if !plateRef[$!addPlatesA].:MDSSUPPTYPE.eq('FT22') and !plateRef[$!addPlatesA].type.eq('STRU') then
          use /MDS-Extra-Drawlist-Style for $!plateRef[$!addPlatesA]
          --<GE>06/12/06
        else
          use /MDS-Extra-Drawlist-Style for owner of owner of owner of $!plateRef[$!addPlatesA]
        endif
        -- use /MDS-Extra-Drawlist-Style for owner of owner of $!plateRef[$!addPlatesA]
        endif
      enddo
    enddo

-- Add elements type of drawlist
-- Loop through saved elements if they do not belong to the support, add them to a local drawlist

  if (!vol) then
    !addLocalRule = ARRAY()
    !!mdsSilent = TRUE
    do !addAll values !addListRefs
      !!ce = !addAll.dbref()
      !getSuppName = !!mdsGetSuppName(!!ce)
      $!saveRef
      handle ANY
        skip
      endhandle
      shee

--<wd>feb2005
      --!suppName = '/' + !!ce.name.after(!!ce.linkref.name.before('/S1')).after('-').before('-AREA')
      !suppName = !item.name
--<wd>feb2005

      !owningBranch = bran of $!addAll
      handle ANY
        !owningBranch = object DBREF()
      endhandle

      same
      if !getSuppName.eq('ABORT') then
        !addLocalRule.append(!addAll)
      elseif !suppName.neq(!getSuppName) then
        !owningBranchName = !owningBranch.name
        handle NONE
          if !owningBranchName.eq(!suppName.dbref().owner.name).not() then
            !addLocalRule.append(!addAll)
          endif
        elsehandle ANY
          !addLocalRule.append(!addAll)
        endhandle
      endif
    enddo

    do !addToRrul values !addLocalRule
      $!saveRef
      handle ANY
        skip
      endhandle
      last mem
      handle ANY
      endhandle
      new rrul
      use /MDS-Extra-Drawlist-Style for $!addToRrul
    enddo
    !!mdsSilent.delete()

-- Now add members of real rule as local before in list order
    view
    handle (2,111) $*  Cannot access element type VIEW from the level of BRANCH etc...
      switch
      view
    endhandle

    shee
    same
    rrul 1
    handle ANY
    endhandle
    prev
    handle ANY
    endhandle

        var !supportList coll mem of idln of view
        var !supportMem eval idna for all from !supportList
        !!mdsSilent = TRUE
    !ce = !!ce

        do !loop values !supportMem
          !!ce = !loop.dbref()
      if !!ce.type.eq('BRAN') then
        !!ce = !ce
        skip
      endif
          !testForRrul = !!mdsGetSuppName(!!ce)
      !!ce = !ce
          if !testForRrul.eq(!suppName) then
        new rrul
            use /MDS-Detail-Style for $!loop

-------------------------------------------------
--<wd>feb2005
-- When the MDS Support is in a MDS GROUP, Create NEW RRULS for the MDS HANGER MEMBERS
        if (!mdsobject.mdsdata.mdsgroup) then
-- ADD NEW RRUL for each RESTRAINT if ATTA references a MDS HANGER
          do !maingroupmem values !mdsobject.mdsdata.maingroupmem
            if ( (!maingroupmem.type.eq('ATTA')) and (!maingroupmem.cref.set()) ) then
              if (!maingroupmem.cref.type.eq('HANG')) then
                !restraint = !maingroupmem.cref.owner
                new rrul
                use /MDS-Detail-Style for $!restraint
              endif
            endif
          enddo
        endif
--<wd>feb2005
-------------------------------------------------

      endif
    enddo

    new rrul
        use /MDS-Detail-Style for $!suppName/DATUM
    handle ANY
      delete rrul
    endhandle

        do !count from 1 to 50
          new rrul use /MDS-Detail-Style for all atta with name eq '$!suppName$n.$n$!count'
       handle ANY
         delete rrul
       endhandle
    enddo

        !!mdsSilent.delete()
  endif
-------------------------------------------------
-- Name local rules
      $!saveRef
    view
        !viewName = name
    var !localRules coll all rrul for ce
        !counter = 1
        do !nameRules values !localRules
      !!ce = !nameRules.dbref()
          name $!viewName/LocalRule$!counter
      handle ANY
      endhandle
          !counter = !counter + 1
    enddo
    $!saveRef
    handle ANY
    endhandle

  endfunction
