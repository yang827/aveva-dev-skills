--------------------------------------------------------------------------------
--
-- File: MdsAbaSheetTask.pmlfnc
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: Draft MDS3.1.1 using ABA11.3
--   Replaces:
--
-- Author:  Wayne Dodwell
-- Created: Monday 13th May 2002
--
--
-- Description:
-- Main MDS ABA Sheet Task to Process the Selected MDS ABA Sheet Tasks
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        ARRAY        MDS Support ARRAY of ABA View Tasks
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--
-- Define Function
  define function !!mdsabasheettask(!unusedparams is ARRAY)

-- Find the MDS Support associated with this ABA Drawing Sheet
    sheet
    !sheet   = !!ce
    !abaname = !sheet.darref.name.before('-AREA')

--<wd>feb2005
    --!abasupp = !abaname.dbref()
    !ceorigin = !!ce
    !!ce = !abaname.dbref()
    handle (2,109)
-- Check if MDS Support is the MASTER STRUCTURE, number [1], of a MDS GROUP, if UNDEFINED NAME error(2,109) occurs
      !abaname = !abaname + '[1]'
      !abasupp = !abaname.dbref()
    elsehandle NONE
      !abasupp = !abaname.dbref()
    endhandle
    !!ce = !ceorigin
--<wd>feb2005

-- Find the Index of the MDSSUPPORT Object Data Array(!!mdsarray) for the current MDS Support
    !objsupp   = false
    !objindex  = 0
    !mdsobject = object MDSABASUPPORT()
    do !indx indices !!mdsarray
      if (!!mdsarray[!indx].support.eq(!abasupp)) then
        !objindex  = !indx
        !mdsobject = !!mdsarray[!indx]
        !objsupp   = true
        break
      else
        skip
      endif
    enddo

-- End this Task if a MATCH for the MDS Support is NOT Found in the MDSABASUPPORT Objects
    if (!objsupp.not()) then
      return
    endif
--$P ********************START*****************************
-- Loop Through the Main MDS Detail Views Only
    !viewarr = ARRAY()
    !viewsca = ARRAY()
    !planview = false
    do !vindx indices !mdsobject.abadata.tviews
      if (!mdsobject.abadata.tviews[!vindx].direction.north.eq(1)) then
-- Main View
        !planview = false
      elseif (!mdsobject.abadata.tviews[!vindx].direction.east.eq(1)) then
-- Side View
        !planview = false
      elseif (!mdsobject.abadata.tviews[!vindx].direction.up.eq(-1)) then
-- Plan View
-- <wd>
-- Because the Plan View is of a smaller size it is NOT added to the
-- !viewarr array - It will use the smallest VSCA of the other main views
-- <wd>
        !planview = true
      else
        skip
      endif

-- We also need to ignore any isometric views
      if (!mdsobject.abadata.tviews[!vindx].title.upcase().match('ISO').gt(0))  then
        !isoview = TRUE
      else
        !isoview = FALSE
      endif

-- Navigate to the Current View and Add it to the Main Views Array
      !!ce = !mdsobject.abadata.views[!vindx].dbref()

--$P **ALL**
--q var !!ce.name !!ce.vsca

      !viewarr.append(!!ce)
-- Load all of the View Scales into a STRING
-- Reset ALL VIEW Scales to be the same
      if (!planview.not()) then
        if !isoview.not() then
          if (!mdsobject.abadata.mainscale.unset()) then
            !mdsobject.abadata.mainscale = vsca
            !viewsca.append(!!ce.vsca)
--$P **1**
--q var !!ce.name !!ce.vsca
          else
            !cevsca = !mdsobject.abadata.views[!vindx].dbref().vsca
            !vsca   = (min(!mdsobject.abadata.mainscale, !cevsca))
            !!ce.vsca = !vsca
            !mdsobject.abadata.mainscale = !vsca
            !viewsca.append(!!ce.vsca)
--$P **2**
--q var !!ce.name !!ce.vsca
          endif
        endif
$( Do Not Set the Planview VSCA attrib here - See Below
      else
        if (!mdsobject.a badata.mainscale.set()) then
          !!ce.vsca = !mdsobject.abadata.mainscale
        endif
$)
      endif
-- Turn off frames on all detail views
      frame off
    enddo
--$P=================================END=====================================================
---------------------------------------------------------------------------------------
-- Ensure that all of the Main View Scales are the same
-- Assume the View Scale to be Full Size  i.e. vsca = 1
    !sep      = ','
    !minscale = 1

--!test ='==========================================='
--q var !test
--q name of view
--q var !viewsca
--q var !test

    do !scale indices !viewsca
      !minscale = (min(!minscale $!sep !viewsca[!scale]))
    enddo

    !mdsobject.abadata.mainscale = !minscale
    do !vnum values !viewarr
      !!ce = !vnum
      !!ce.vsca = !minscale
-- Check to see if the drawing has a scale override and if so set this
      !unusedtestforputbackscale = !!putBackScale
      handle NONE
        do !findSheet from 1 to !!putBackScale.size()

          --<wd>02mar2010 - DUN1233 - ERRORS are occurring if either of the !!putBackScale ARRAY indices are UNDEFINED
          -- SKIP if any of the array members are UNDEFINED
          skip if (undefined(!!putBackScale[$!findSheet][1]))
          skip if (undefined(!!putBackScale[$!findSheet][2]))
          --<wd>02mar2010 - DUN1233

          if !!putBackScale[$!findSheet][1].eq(!!ce.owner.name) then
            if !!putBackScale[$!findSheet][2].neq('0') then
              !!ce.vsca = !!putBackScale[$!findSheet][2].real()
              shee
              :mdsscale '$!!putBackScale[$!findSheet][2]'
              same
              !viewname = !!ce.name
              !!abalogging.error('Message - Using MDS Scale OverRide for view $!viewname')
            else
              view
              !viewname = !!ce.name
              same
              !!abalogging.error('Message - Using MDS Calculated Scale for view $!viewname')
            endif
          endif
        enddo
      elsehandle ANY
      endhandle
--<wd>june2003
--  Modify Pipe End Symbols to suit the Current View Scale
--<wd>feb2005 -- Pass the MDS ABA SUPPORT OBJECT with the INTRODUCTION of MDS GROUPS
      --!!mdsabapipeSymb(!mdsobject.support,!vnum)

      !!mdsabapipeSymb(!mdsobject,!vnum)

--<wd>june2003
    enddo

---------------------------------------------------------------------------------------

-- Set the '.mainscale' member in the current !!mdsarray[!indx] OBJECT
    !!mdsarray[!indx].abadata.mainscale = !mdsobject.abadata.mainscale

-- Get the Name of the Current MDS Support
    !support = !mdsobject.support
    !datum   = !mdsobject.mdsdata.datum

-- Update Each MAIN Detail View to Show the Changes
    do !vindx indices !mdsobject.abadata.views
      !!ce = !mdsobject.abadata.views[!vindx].dbref()
      !view = !!ce
-- Add the MDS Structure Location Origin Symbol if the Global Variable !!mdsadploc
-- is Defined and set to an Existing Sytm DBREF
-- As the task in now symbol based, run the origin function automatically
      !!mdsabaorigin(!!ce,!support,!datum)
      !!ce = !view

      -- taken out because i have converted !!mdsabaattadot to a sheet task, RM 13/09/06
      --if !isoview then
      --  !!mdsabaattadot(!mdsobject,!view,FALSE)
      --endif
      vtype universal
      update all
        handle(64,153)
          !!abalogging.error('  No Items found For Drawlist - please check the MDS ABA area')
        endhandle
-- taken out because i have converted !!mdsabaattadot to a sheet task, RM 13/09/06
-- dtf >>> 17.08.06 Mod to add adjacent supports in dotted
      --if (!isoview.not()) then
      --  !!mdsabaattadot(!mdsobject,!view,TRUE)
      --endif
-- dtf <<< End of mod 17.08.06

-- Goto each view, find the MDS_Notes layer check if the note is ontop of another view if not reverse the justification
      view
      !viewname = !!ce.name
      var !mdsnotes coll all laye with matchwild(name,'*MDS_Notes') for ce
      do !loopnotes values !mdsnotes
        !!ce = !loopnotes.dbref()
        do !loopglab from 1 to !!ce.mcount()
          glab $!loopglab
          !ontop = !!mdsabaontop(!!ce)
          if !ontop then
            just right
          endif
        enddo
      enddo
      cont draw
      view
      !viewname = !!ce.name
      var !mdsnotes coll all laye with matchwild(name,'*SteelTags_Task') for ce
      var !mdsnotes append coll all laye with matchwild(name,'*AncilTags_Task') for ce
      do !loopnotes values !mdsnotes
        !!ce = !loopnotes.dbref()
        !labels = !!ce.memb
        do !lab values !labels
          !!ce = !lab

                --<wd>02mar2010 - DUN1233 - ERRORS are occurring when a LABEL is "LOCKED"???
                !ceLock = FALSE
                if (!!ce.lock) then
                  !ceLock = TRUE
                  unlock ce
                endif
                --<wd>02mar2010 - DUN1233

          !ontop = !!mdsabaontop(!!ce)
          if !ontop then
            oset TRUE
            xypo 25 25
          endif

                --<wd>02mar2010 - DUN1233 - ERRORS are occurring when a LABEL is "LOCKED"???
                if (!ceLock) then
                  lock ce
                endif
                --<wd>02mar2010 - DUN1233

              enddo
            enddo

            -- <K.pleschner> March 2005
      -- pipe end symbols to tubes that crosses view margin
      !!mdsabaaddpend(!view)
    enddo

-- Clean sheet of empty ldims/layers

   shee
   !sheename = !!ce
   !!mdsabacleanshee(!sheename)

          -- Delete the Global variable !!mdsadploc
    if (defined(!!mdsadploc)) then
      !!mdsadploc.delete()
    endif

-- Run detailing sheets if selected
    if !!mdsabaselsupp.detail.val then
      !!mdsabadtlshts(!sheet)
    endif

-- Clear prompt area of Graphics Display
    !!abaPrompt('',2)

--------------------------------------------------------------------------------
  endfunction
-- End of Function - mdsabasheettask.pmlfnc
