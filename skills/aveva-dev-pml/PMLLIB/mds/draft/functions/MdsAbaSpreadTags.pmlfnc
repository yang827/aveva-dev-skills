-- File:            MdsAbaSpreadTags.pmlfnc
--   Type:          Function
--
-- Author:          Neale Morris
-- Created:         28th May 2004
--
--
-- Description:
-- Function to change the aspect ratio of a view and spread the tags
------------------------------------------------------------------------

define function !!MdsAbaSpreadTags()

  view
  frame on
  !OrigSize = size

  if !OrigSize[1].gt(!OrigSize[2]) then
    size $!OrigSize[2] $!OrigSize[2]
  else
    size $!OrigSize[1] $!OrigSize[1]
  endif

  !NewSize = size

  -- check if hanger is vertical and single

  !VerticalHang = false
  !Hang = !!CE.Owner.Darref.Name.Before('-AREA').Dbref().Cref
     handle NONE
        if !Hang.Badref().Not() then
           if !Hang.Type.eq('HANG').and(!Hang.Owner.Memb.Size().eq(1)) then
              !Angle = !Hang.Hpos.Angle(!Hang.Hpos.Offset(U,1000),!Hang.Tpos)
              if !Angle.leq(10) then
                    !VerticalHang = true
              endif
           endif
        endif
     elsehandle ANY
     endhandle


  if !VerticalHang then
    spread remote norot omit left bottom top margin 10mm
  else
    spread remote norot omit left bottom margin 10mm
  endif

-- Find max Y and max X of view of view at aspect ratio of 1

  view
  !Xypo = xypo
  !MaxX = !xypo.east + (!NewSize[1] / 2)
  !MaxY = !xypo.north + (!NewSize[2] / 2)

-- While the view is still at an aspect ration of 1, determine which side
-- of the view the labels are

  !Top = ARRAY()
  !Right = ARRAY()

  var !labels coll all glab for ce
  var !labels append coll all slab for ce

  do !FindWhichSide values !labels
    !!ce = !FindWhichSide.dbref()
    if !!ce.owner.name.upcase().matchwild('*STEELTAGS*').not() and !!ce.owner.name.upcase().matchwild('*ANCILTAGS*').not() and !!ce.owner.name.upcase().matchwild('*PIPETAGS*').not()then
      skip
    endif
    --if !!ce.atex.upcase().match('REF.').gt(0) then
      --just c
      --skip
    --endif
    abs
      handle ANY
        skip
      endhandle
    !LabelXypo = xypo
    if !LabelXypo.east.lt(!MaxX) then
      !Top.Append(!!CE)
    elseif !LabelXypo.north.lt(!MaxY) then
      !Right.Append(!!CE)
    else
      !Top.Append(!!CE)
    endif
  enddo

-- Return view to original size

  view
  size $!OrigSize[1] $!OrigSize[2]

-- Reset maxx and maxy now it has be put back to the original size
--<wd>oct2004 -- Changed "- 5" to "- 5mm"
  !MaxX = !xypo.east + (!OrigSize[1] / 2) - 5mm
  !MaxY = !xypo.north + (!OrigSize[2] / 2) - 5mm

-- Those labels that should be at the top are in variable !Top
  do !SetPos values !Top
    !!ce = !SetPos
    !Pos = xypo
    xypo $!Pos.east $!MaxY
    next
    handle ANY
    elsehandle NONE
      !MaxYNew = !MaxY
      do !I  to 10
        if  !!ce.ddnm.eq( ddnm of prev) and ( !!ce.lock ) then
          !MaxYNew = !MaxYNew + 12
          unlock ce
          xypo $!Pos.east $!MaxYNew
          lock ce
          next
          handle ANY
            break
          endhandle
        endif
      enddo
    endhandle
  enddo

  do !SetPos values !Right
    !!ce = !SetPos
    !Pos = xypo
    xypo $!MaxX $!Pos.north
    next
    handle ANY
    elsehandle NONE
      !MaxXNew = !MaxX
      do !I  to 10
        if  !!ce.ddnm.eq( ddnm of prev) and ( !!ce.lock ) then
          !MaxXNew = !MaxXNew + 12
          unlock ce
          xypo $!MaxXNew $!Pos.north
          lock ce
          next
          handle ANY
            break
          endhandle
        endif
      enddo
    endhandle
  enddo

  view
  frame off

endfunction

