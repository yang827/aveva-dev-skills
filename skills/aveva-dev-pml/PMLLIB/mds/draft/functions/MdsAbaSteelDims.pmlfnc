--   Replaces:
--
-- Author: Steve Robinson
-- Created: Wednesday 5th June 2002
--
--
-- Description:
-- Function to Add MDS Steel Framework SCTN Dimensions to ABA Drawing
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         DBREF of the Current View
--     2     R        STRING        STRING of Pen Options
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
-- Define Function
--<wd>feb2005
--define function !!mdsabasteeldims(!view is DBREF,!params is STRING,!support is DBREF)

-- Now passed the COMPLETE !mdsobject instead of just the !mdsobject.support
define function !!mdsabasteeldims(!view is DBREF,!params is STRING,!mdsobject is MDSABASUPPORT)

  !support = !mdsobject.support
--<wd>feb2005

-- Setup dimensioning object and dimension view
  !dimensionobject = object MDSABADIMSTL(!support,!view)
  !dimensionobject.dimension(!params)

--------------------------------------------------------------------------------
endfunction
-- End of Function - !!mdsabasteeldims.pmlfnc
