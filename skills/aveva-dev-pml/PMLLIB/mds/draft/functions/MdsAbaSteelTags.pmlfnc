------------------------------------------------------------------------
--
-- File: MdsAbaSteelTags.pmlfnc
--   Type: Function
--
-- Author: Martin Wright
-- Created: 11 June 2002
--
--
-- Description:
-- Function for TAGGING MDS FRAMEWORK STRUCTURE and/or MDS HANGER components in the MAIN VIEWS
-- to CORRESPOND with the "MTO" ITEM NO. TAGS on MDS ABA DRAWING
--
------------------------------------------------------------------------
------------------------------------------------------------------------
--<wd>jan2005
--define function !!mdsabasteeltags(!view is dbref,!params is string)
define function !!mdsabasteeltags(!view is DBREF ,!params is STRING, !mdsobject is MDSABASUPPORT )

--------------------------------------------
--<wd>27mar2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
-- Obsolete Parameter Nos and Some Pen Attributes    -- Params passed as string
-- Obsolete Parameter Nos and Some Pen Attributes    -- 1  Leader Line         LLEAD
-- Obsolete Parameter Nos and Some Pen Attributes    -- 2  Text Frame          LFRAME
-- Obsolete Parameter Nos and Some Pen Attributes    -- 3  Text Pen            TPEN
-- Obsolete Parameter Nos and Some Pen Attributes    -- 4  Text Font           FONT
-- Obsolete Parameter Nos and Some Pen Attributes    -- 5  Leader Line Pen     LLPN
-- Obsolete Parameter Nos and Some Pen Attributes    -- 6  Text Box Pen        LFPN
-- Obsolete Parameter Nos and Some Pen Attributes    -- 7  Terminator Size     TSIZE
-- Obsolete Parameter Nos and Some Pen Attributes    -- 8  Terminator          LTERM
-- Obsolete Parameter Nos and Some Pen Attributes    -- 9  Label shape         SYTM/TXTM name or empty string if not set

-- NEW 12.0 version Parameters (Pen Attributes etc...) passed as a STRING
-- *** IMPORTANT NOTE ***
-- ONLY 11 parameters are passed here as the ORIGINAL 1st parameter value (TRUE or FALSE ) in the STRING of 12 Parameters
-- has been REMOVED in the MDS ABA MAIN VIEW calling ABA TASK FUNCTION "mdsabaviewtask.pmlfnc"
-- LABEL Attributes (GLAB or SLAB)
    -- 1  Label Leader Line                 = LLEADER
    -- 2  Label Frame                       = LFRAME
    -- 3  Label Font                        = FONT
    -- 4  Label font Colour                 = TXCOLOUR
    -- 5  Label Leader Line Style           = LLSTYLE
    -- 6  Label Leader Line Colour          = LLCOLOUR
    -- 7  Label Frame Line Style            = LFSTYLE
    -- 8  Label Frame Line Colour           = LFCOLOUR
    -- 9  Label Leader Line Terminator Size = TSIZE
    -- 10 Label Leader Line Terminator Type = LTERMINATOR
    -- 11 Label Shape                       = TMRF for SYTM/TXTM name reference or an EMPTY string, i.e. '', if the "NO FRAME" option has been selected
--
--<wd>27mar2008 - DUN824 - Defect No. P-4526
--------------------------------------------

   !passedparams = !params.split(',')
   context draw
   !view = !!ce
   prec 2 dp
   !units = object COMUNITS(TRUE)

--------------------------------------------
--<wd>27mar2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
--   -- check Passedparams[9] for validity and set up the label creation command and label text attribute name
--   if undefined(!passedparams[9]) then
--      !passedparams[9] = ''
--   endif
--
--   !tmrfname = !passedparams[9].trim()

-- Check variable !passedparams[11] for validity and set up the label creation command and label text attribute name
   if undefined(!passedparams[11]) then
      !passedparams[11] = ''
   endif
   !tmrfname = !passedparams[11].trim()
--
--<wd>27mar2008 - DUN824 - Defect No. P-4526
--------------------------------------------

   -- check if string holds PDMS name
   if !tmrfname.match('/').neq(1) then
      !tmrfname = ''
   endif

   if !tmrfname.empty() then
      !createlabel = 'new GLAB'
      !setuplabel = ''
      !labeltext = 'btext'
   else
      !createlabel = 'new SLAB'
      !setuplabel = 'tmrf $!tmrfname'
      !labeltext = 'atext'
   endif
-- Navigate to SHEE
   SHEE
   GOTO DARREF
   var !supname NAME
   !supname = !supname.substring(1,!supname.match(|-AREA|) - 1)

-- Return to VIEW
   !!ce = !view

-- Goto layers of view and create new one for steel labels.
-- Now create new layer for "comp" table.
   !name = NAME OF VIEW
   !notes = !name & |/SteelTags_Task|
   $!notes
   handle (2,109)
     NEW LAYER
     NAME $!notes
   elsehandle none
     delete LAYER
--<wd>16oct2008 - DUN975 -- UNLOCK ALL if ANY element is LOCKED
     handle (2,18)
       unlock all
       delete LAYER
     endhandle
--<wd>16oct2008 - DUN975 -- UNLOCK ALL if ANY element is LOCKED
     NEW LAYER
     NAME $!notes
   endhandle

--------------------------------------------
--<wd>27mar2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
---- Set passed parameters
--   LLEAD  $!passedparams[1]
--   LFRAME $!passedparams[2]
--   TPEN   $!passedparams[3]
--   FONT   $!passedparams[4]
--   LLPN   $!passedparams[5]
--   LFPN   $!passedparams[6]
--   TSIZE  $!passedparams[7]
--   CHEI   $!passedparams[7]
--   LTERM  $!passedparams[8]
--
-- All of the 'handle any' lines etc.. have been added to ensure that the MDS ABA default value is USED if an ERROR occurs
--
-- Set the LAYER Attributes with the Passed Parameters
   LLEADER     $!passedparams[1]
   handle ANY
     LLEADER TRUE
   endhandle
   LFRAME      $!passedparams[2]
   handle ANY
     LFRAME FALSE
   endhandle
   FONT        $!passedparams[3]
   handle ANY
     FONT 31
   endhandle
   TXCOLOUR    $!passedparams[4]
   handle ANY
     TXCOLOUR 3
   endhandle
   LLSTYLE     $!passedparams[5]
   handle ANY
     LLSTYLE Solid
   endhandle
   LLCOLOUR    $!passedparams[6]
   handle ANY
     LLCOLOUR 5
   endhandle
   LFSTYLE     $!passedparams[7]
   handle ANY
     LFSTYLE Solid
   endhandle
   LFCOLOUR    $!passedparams[8]
   handle ANY
     LFCOLOUR 6
   endhandle
   TSIZE       $!passedparams[9]
   handle ANY
     TSIZE 3
   endhandle
   LTERMINATOR $!passedparams[10]
   handle ANY
     LTERMINATOR Arrows
   endhandle
--
--<wd>27mar2008 - DUN824 - Defect No. P-4526
--------------------------------------------


--===============================================
--<wd>jan2005
--
-- NEW CODE for ASSIGNING the VIEW TAG to the MDS Support <DBREF> item
--
--*****************************************************************************
-- *** (A) ***
-- ***********
-- Support is a MDS HANGER created either via:-
-- <1> The Standard MDS HANGER TEMPLATES in the MDS DESIGN application  or
-- <2> a MDS HANGER MANUFACTURERS DESIGN INTERFACE in the MDS DESIGN application
-- or
-- ***********
-- *** (B) ***
-- ***********
-- Support is a MDS STRUCTURE created via the MDS DESIGN application
-- or
-- ***********
-- *** (C) ***
-- ***********
-- Support is a MDS GROUP.
-- The MASTER Support is ALWAYS a MDS STRUCTURE, i.e. "<supportname>[1]" in the MDS GROUP,
-- created via the MDS DESIGN application.
-- ADDITIONAL MDS GROUP MEMBERS are MDS HANGERS created either via:-
-- <1> The Standard MDS HANGER TEMPLATES in the MDS DESIGN application  or
-- <2> a MDS HANGER MANUFACTURERS DESIGN INTERFACE in the MDS DESIGN application
-- MDS HANGERS are ALWAYS named SEQUENTIALLY as additional MDS GROUP members, i.e."<supportname>[2]", "<supportname>[3]" etc...
--*****************************************************************************
--
-- This NEW PML Code uses the TAGS derived when compiling the MTO list "MDSABAMTOSTEEL",
-- currently used for BOTH "INDIVIDUAL" MDS FRAMEWORKS and MDS HANGERS
-- or "MDS GROUPS" material list creation.
--
-- ****************************************************************************

-- Initialise MDS Support View Tags array
   !mdstagsarray = ARRAY()

-- Check if MDS Support is a MDS GROUP
   if (!mdsobject.mdsdata.mdsgroup) then

-- MDS "GROUP" Support comprises of a MASTER MDS FRAMEWORK STRUCTURE Support plus ONE or MORE MDS HANGER Supports

-- MDS FRAMEWORK STRUCTURE Support
-- For MDS GROUPS the MDS FRAMEWORK STRUCTURE elements are stored in !!mdsabamtosteel.data.struelements[2]
     !mdstagsarray[1] = ARRAY()
     !mdstagsarray[1][1] = '!!mdsabamtosteel.data.struviewtags[1]'
     !mdstagsarray[1][2] = '!!mdsabamtosteel.data.struviewtags[2]'
     !mdstagsarray[1][3] = '!!mdsabamtosteel.data.struelements[2]'

--<wd>jul2005
-- MDS HANGER Supports in the MDS GROUP
--Check if the Drawing VIEW has ANY MDS HANGER <DBREF> elements to TAG in the VIEW
-- NOTE:- If NOT, NO HANGER ELEMENTS will appear in the MTO either.

     if (defined(!!mdsabamtosteel.data.hangviewtags[1])) then
--<wd>jul2005


-- For MDS GROUPS the MDS HANGER elements are stored in !!mdsabamtosteel.data.hangelements[2]
       !mdstagsarray[2] = ARRAY()
       !mdstagsarray[2][1] = '!!mdsabamtosteel.data.hangviewtags[1]'
       !mdstagsarray[2][2] = '!!mdsabamtosteel.data.hangviewtags[2]'
       !mdstagsarray[2][3] = '!!mdsabamtosteel.data.hangelements[2]'

--<wd>jul2005
     endif
--<wd>jul2005

   else
-- "INDIVIDUAL" MDS FRAMEWORK STRUCTURE or MDS HANGER Support elements are stored in !!mdsabamtosteel.data.elements[2]
     !mdstagsarray[1] = ARRAY()

     if (!mdsobject.support.type.eq('STRU')) then
-- MDS FRAMEWORK STRUCTURE Support
       if (undefined(!!mdsabamtosteel.data.struviewtags[1])) then
-- Drawing VIEW has NO MDS FRAMEWORK <DBREF> elements to TAG in the VIEW
-- NOTE:- This means that NOTHING will appear in the MTO for these elements either.
         return
       endif
       !mdstagsarray[1][1] = '!!mdsabamtosteel.data.struviewtags[1]'
       !mdstagsarray[1][2] = '!!mdsabamtosteel.data.struviewtags[2]'
       !mdstagsarray[1][3] = '!!mdsabamtosteel.data.elements[2]'

     elseif (!mdsobject.support.type.eq('ATTA')) then
-- MDS HANGER Support
       if (undefined(!!mdsabamtosteel.data.hangviewtags[1])) then
-- Drawing VIEW has NO MDS HANGER <DBREF> elements to TAG in the VIEW
-- NOTE:- This means that NOTHING will appear in the MTO for these elements either.
         return
       endif
       !mdstagsarray[1][1] = '!!mdsabamtosteel.data.hangviewtags[1]'
       !mdstagsarray[1][2] = '!!mdsabamtosteel.data.hangviewtags[2]'
       !mdstagsarray[1][3] = '!!mdsabamtosteel.data.elements[2]'
     endif
   endif

-- The ARRAY !mdstagsarray will now ALWAYS exist for BOTH:-
-- <a> "MDS GROUPS", i.e. Variable !indx = [1] will ALWAYS exist for the MASTER MDS FRAMEWORK STRUCTURE,
-- and variable !indx = [2] will ONLY exist if ONE or MORE MDS HANGERS are contained within the "MDS GROUP"
-- or
-- <b> "INDIVIDUAL MDS FRAMEWORK STRUCTURES or MDS HANGERS", i.e. ONLY variable  !indx = [1] will exist here.

   do !indx indices !mdstagsarray
-- Initialise DO Loop variables to use, i.e. !vmtotags, !vmtoreal and !vmtodbfs
     !vmtotags = $!mdstagsarray[$!indx][1]
     !vmtoreal = $!mdstagsarray[$!indx][2]
     !vmtodbfs = $!mdstagsarray[$!indx][3]

-- Compress Variables
     !vmtotags.compress()
     !vmtoreal.compress()

-- Delete the "TEXT HEADING" stored in iteration [1]
     !vmtodbfs[1].delete()
     !vmtodbfs.compress()

-- TEMPORARY GLOBAL Variables ONLY
--!!vmtotags =  !vmtotags
--!!vmtoreal =  !vmtoreal
--!!vmtodbfs =  !vmtodbfs

-- Loop through the TAG array, Create the Associated GLAB elements for each of the DBREFS in the Current View
     do !vtags indices !vmtotags
-- SKIP if TAG is set to a space, i.e. ' ' -- as used for 'multi line description text' for a single DB element
       skip if !vmtotags[!vtags].trim().eq('')
       do !vreal values !vmtoreal[!vtags]
         !vdbfs = !vmtodbfs[!vreal]
-- SKIP if DBREF is a SPCO, e.g. a HEXAGON NUT stored in the array UDA :USTNUTREF for LISEGA HANGER
-- DESIGN DB elements. A GLAB is NOT REQUIRED in the VIEWS for these items, as per a LICAD drawing
-- Also skip if the :MdsVprmMto is false
--$P ----****----> !vdbfs = $!vdbfs
         skip if !vdbfs.trim().eq('')
         skip if !vdbfs.dbref().type.eq('SPCO')
         skip if !vdbfs.dbref().:mdsvprmmto.not()
         handle ANY
         endhandle

         $!createlabel
         $!labeltext |$!vmtotags[$!vtags]|
         ddname $!vdbfs
         if !!ce.ddname.type.eq('WPAD') then
           nppt 2
         endif
         $!setuplabel
         if (!vdbfs.dbref().type.eq('TUBI')) then
-- ************************************
-- *** IMPORTANT NOTE for PDMS DRAFT***
-- The DDNM attribute of a GLAB "may NOT" be set a "ILEAVE TUBE ELEMENT".
-- It will ALWAYS SET the DDNM reference to the OWNER of the "LSTUBE or HSTUBE"
-- ************************************
-- Position the GLAB attachment point at the ITPOS of the ILEAVE ROD
           !vtagpos = !vdbfs.dbref().itpos
           position $!vtagpos
         endif
       enddo
     enddo
   enddo

-- Navigate to the VIEW and RESET the UNITS
   !!ce = !view
   !units.restoreSavedBoreDist()
   prec var def

endfunction
--<wd>jan2005
-------------- End Of NEW Code --------------
--===============================================

endfunction
-------------- End Of Code --------------
