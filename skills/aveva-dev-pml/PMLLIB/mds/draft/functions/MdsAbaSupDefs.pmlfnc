-- Define Function
define function !!mdsabasupdefs()

-- Initialise Variables
  !!supportdef = object mdsabasupdefs()

--------------------------------------------------------------------------------
--<wd>feb2007<mds12>
-- Load the FORM !!mdsabasupdefs when it's UNDEFINED
   if (undefined(!!mdsabasupdefs)) then
     pml reload form !!mdsabasupdefs
   endif

-- Does the MDS ABA Option "MDSVIEWOLAP" Paragon Default Data Exist
   !mdsvolap = /MDS/OPTION/DEFAULTS/MDSVIEWOLAP/DATA
   handle ANY
-- Data element "/MDS/OPTION/DEFAULTS/MDSVIEWOLAP/DATA" does NOT exists
-- Assume a Default Setting for the "MDSVIEWOLAP" keyword of 300mm
     !!supportdef.viewolap        = '300'
     !!mdsabasupdefs.viewolap.val = '300'

   elsehandle NONE
-- Data element "/MDS/OPTION/DEFAULTS/MDSVIEWOLAP/DATA" exists
     !!supportdef.viewolap        = $!mdsvolap.pprop
     !!mdsabasupdefs.viewolap.val = $!mdsvolap.pprop

   endhandle
--
--<wd>feb2007<mds12>
