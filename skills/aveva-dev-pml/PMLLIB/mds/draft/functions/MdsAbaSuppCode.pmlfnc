--
-- File:            MdsAbaSuppCode.pmlfnc
--   Type:          Function
--
-- Author:          Martin Wright
-- Created:         10 June 2002
--
--
-- Description:
-- Basic task function called by abatasks for showing run data from project.
------------------------------------------------------------------------
-- Revision 0 10-06-2002 Development Session
------------------------------------------------------------------------
define function !!mdsabasuppcode(!params is ARRAY)

  !sheet = !!ce
  !units = object COMUNITS(TRUE)

  UNITS MM Bore
  UNITS MM Distance
  LOADFORM !!mdsabasuppcode

-- Get support name
  !name = !!ce.darref.name.before('-AREA')
  !struname = !name

--<wd>feb2005
-- Determine if the support is a MDS GROUP
  $!name
  handle (2,109)
-- Check if MDS Support is the MASTER STRUCTURE, number [1], of a MDS GROUP, if UNDEFINED NAME error(2,109) occurs
    !name = !name + '[1]'
  endhandle
  !!ce = !sheet
--<wd>feb2005

  if !name.dbref().type.eq('STRU') then
--<kp>jan07
     if !name.dbref().:mdssupptype.eq(!!mdslsuppdefs.type) then
-- Lighting support
        if !!mdslsuppdefs.suppcode.set() then
           !stringval = !!mdslsuppdefs.suppcode.evaluate(!name.dbref())
        else
           !stringval = 'N/A'
        endif
     else
-- Frameworks
       !srefatta = !name + '/SREF'
       !stringval = !srefatta.dbref().styp
       !stringval = (prop code of $!srefatta )
         handle any
           !stringval  = 'N/A'
         endhandle
     endif
  else
-- Hangers
    !datumAtta = !name
    !stringval = !datumAtta.dbref().styp
    !stringval = (prop code of $!datumAtta )
    handle any
      !stringval = 'N/A'
    endhandle
  endif

-- Tidy up existing notes.
   var !oldnote COLL ALL NOTE WITH (ATTRIB FUNCTION EQ 'MdsAbaSuppCode') FOR CE

-- Delete old notes.
   do !oldnot value !oldnote
     $!oldnot
     DELETE NOTE
   enddo

   shee
   last mem

   NEW NOTE
   !name = NAME OF OWNER
   NAME $!name/TaskNOTE3
   Function 'MdsAbaSuppCode'
   NEW TEXP
-- If the stru contains a value in the uda :mdsprojspec then use the desc from the project special template

---------------------------------------------
--<wd>03mar2008 -- DUN824 - Defect No. P-4405
--<wd>  Put back the 'handle any' code here which was removed by <kp>jan07 for MDS Lighting Supports at <mds12>,
--<wd>  because MDS ABA HANGER drawings weren't being considered here!!!
   !mdsprojspec = :MdsProjSpec of $!struname
   handle ANY
--<wd>03mar2008 -- The support type is a MDS HANGER
   elsehandle NONE
     if !mdsprojspec.badref().not() then
       !stringval = desc of :Mdsprojspec of $!struname
     endif
   endhandle
--<wd>03mar2008 -- DUN824 - Defect No. P-4405
---------------------------------------------

   BTEXT |$!stringval|
   CHEIGHT $!params[1]mm
   !origin = 'X ' & !params[2] + 'mm' & ' Y ' & !params[3] + 'mm'
   ORIGIN $!origin

   !!ce = !sheet
   !units.restoreSavedBoreDist()

endfunction
-------------- End Of Code --------------
