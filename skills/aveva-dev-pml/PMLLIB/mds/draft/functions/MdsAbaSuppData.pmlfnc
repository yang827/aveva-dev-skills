--
-- Description:
-- Task function to create a table of support data
------------------------------------------------------------------------

define function !!mdsabasuppdata(!params is ARRAY)


--------------------------------------------
--<wd>14apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
-- Parameters will be
-- 1 = Position Top Left X
-- 2 = Position Top Left Y
-- 3 = Text Frame

-- 4 = Text Pen -- Obsolete Pen Attribute TPEN replaced at 12 version
-- 4 = Text Colour = TXCOLOUR

-- 5 = Text Font

-- 6 = Text Box Pen -- Obsolete Pen Attribute LFPEN replaced at 12 version
-- 6 = Label Frame Style  = LFSTYLE
-- 7 = Label Frame Colour = LFCOLUR -- New Parameter introduced at 12 version using the old number 7

-- 7 = Character Height -- Obsolete Parameter Number replaced at 12 version with 8
-- 8 = Character Height

-- 8 = Header template reference -- Obsolete Parameter Number replaced at 12 version with 9
-- 9 = Header template reference

-- 9 = Entry template reference -- Obsolete Parameter Number replaced at 12 version with 10
-- 10 = Entry template reference
--
--<wd>14apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

-- Store view
  !unusedview = !!ce

-- Get tags

  !attatags = ARRAY()
  do !tags from 2 to !!mdsabamtocomp.data.elements[1].size()
    if !!mdsabamtocomp.data.elements[1][$!tags].neq(' ') then
      !attatags.append(!!mdsabamtocomp.data.elements[1][$!tags])
    endif
  enddo

  View
  !viewName = name
  last mem
  new laye $!viewName/Data
    handle (41,12)
      $!viewName/Data
      delete laye mem
    endhandle

  !attList = attlist
  do !set values !attList
    $!set TEMPLATE
      handle ANY
      endhandle
  enddo

  new slab
  ddnm $!!mdsabamtocomp.data.attas[2]
  tmrf $!params[9]
  abs
  xypo x$!params[1] Y$!params[2]
  llead FALSE
  !slab = !!ce
  goto tmrf
  stra 1
  !headerlength = !!ce.length
  !!ce = !slab

  !atexcounter = 1
  do !newcount from 2 to !!mdsabamtocomp.data.attas.size()
    if !!mdsabamtocomp.data.attas[$!newcount].eq(' ') then
       skip
    endif
    new slab
    ddnm $!!mdsabamtocomp.data.attas[$!newcount]
    tmrf $!params[10]
    abs
    xypo x$!params[1] Y$!params[2]
    llead FALSE
    atex '$!attatags[$!atexcounter]'
    !atexcounter = !atexcounter + 1
    if !newcount.eq(2) then
      !slab = !!ce
      goto tmrf
      stra 1
      !length = !!ce.length
      !length = !length + !headerlength
      !!ce = !slab
      by y -$!headerlength
      !byY = !headerlength
    else
      !slab = !!ce
      goto tmrf
      stra 1
      !length = !!ce.length + !byY
      !!ce = !slab
      by y -$!length
      !byY = !length
    endif
  enddo

return

endfunction
-- End of function definition for !!mdsabasuppdata
