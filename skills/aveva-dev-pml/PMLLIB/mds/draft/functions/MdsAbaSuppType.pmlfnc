--
-- File:            MdsAbaSuppType.pmlfnc
--   Type:          Function
--
-- Author:          Martin Wright
-- Created:         10 June 2002
--
--
-- Description:
-- Basic task function called by abatasks for showing run data from project.
------------------------------------------------------------------------
-- Revision 0 10-06-2002 Development Session
------------------------------------------------------------------------
define function !!MdsAbaSuppType(!params is array)

  !sheet = !!ce
  !units = object COMUNITS(TRUE)

  UNITS MM Bore
  UNITS MM Distance
  LOADFORM !!mdsabaSuppType

-- Read alternative support descriptions in not already loaded
--------------------
--<wd>feb2007<mds12>
  if (undefined(!!mdsaltdft0911)) then
    --!!MdsReadAltd()
-- LOAD the MDS FRAMEWORK ALTERNATIVE CODE Descriptions for the
-- individual MDS FRAMEWORK SUPPORT CODES "Type and Size"
    !!mdsaltddefs = object mdsaltddefs()
--<wd>feb2007<mds12>
--------------------
  endif

-- Get support name
  !Name = !!ce.darref.name.before('-AREA')

--<wd>feb2005
-- Determine if the support is a MDS GROUP
  !!ce = !name.dbref()
  handle (2,109)
-- Check if MDS Support is the MASTER STRUCTURE, number [1], of a MDS GROUP, if UNDEFINED NAME error(2,109) occurs
    !name= !name + '[1]'
    !!ce = !name.dbref()
  endhandle
  !!ce = !sheet
--<wd>feb2005

  if !Name.dbref().type.eq('STRU') then
-- Frameworks
    !SrefAtta = !Name + '/SREF'
    !SuppType = !SrefAtta.dbref().styp
--<kp>jan07
       handle ANY
       -- can be lighting support
       !SuppType = ''
       endhandle
--<kp>jan07
  else
-- Hangers
    !SuppType = ''
  endif

  -- If the alternitive description is different to the stardard
  -- then replace and return

  !Stripped = '!!MDSALTD' + !Supptype.replace('-','')

  -- get the alias for this as defined by the user in the DES-SUPP-DEFS file

  !Type = !Supptype.Before('-')
  !UserType = !!MdsGetAlias(!Type)
  if defined($!Stripped) then

-- If variable is equal to a * use the default value
-- but replace the type with the replacement

-- replace all occurrences of the UserType in the passed SuppType

    if $!Stripped eq '*' then

      !String = !SuppType.Replace(!Type,!UserType)

-- Only modify if the text if different from the standard

      !test = $!Stripped
      if !Supptype neq |$!Stripped| then
        !String = $!Stripped
      endif

-- if last character of user type is a letter (typically A or B) then discard it unless the type is special

      if !UserType.neq('SPECIAL') then
        if (Match('ABCDEFGHIJKLMNOPQRSTUVWXYZ',!UserType.Substring(-1,1).Upcase()) neq 0) then
          !UserType = !UserType.Substring(1,(!UserType.Length() - 1))
        endif
      endif

-- replace all occurrences of the UserType in the passed SuppType
-- if the altd desc has not been used

      !String = !SuppType.Replace(!Type,!UserType)
    else
      !String = $!Stripped
    endif
--<wd>-may2003
  else
    !string = !supptype
--<wd>-may2003
  endif

  if !Name.dbref().type.neq('STRU') then
-- Hangers
    !String = 'N/A'
--<kp>jan07
  elseif !Name.dbref().type.eq('STRU') then
    if !Name.Dbref().:Mdssupptype.eq(!!Mdslsuppdefs.type) then
       !String = !!Mdslsuppdefs.replacetype
    endif
--<kp>jan07
  endif


-- Tidy up existing notes.

   var !oldnote COLL ALL NOTE WITH (ATTRIB FUNCTION EQ 'MdsAbaSuppType') FOR CE

-- Delete old notes.
   do !oldnot value !oldnote
     $!oldnot
     DELETE NOTE
   enddo

   shee
   last mem

   NEW NOTE
   !name = NAME OF OWNER
   NAME $!name/TaskNOTE2
   Function 'MdsAbaSuppType'
   NEW TEXP
   BTEXT |$!string|
   CHEIGHT $!params[1]mm
   !origin = 'X ' & !params[2] + 'mm' & ' Y ' & !params[3] + 'mm'
   ORIGIN $!origin

   !!ce = !sheet
   !units.restoreSavedBoreDist()

endfunction

-------------- End Of Code --------------
