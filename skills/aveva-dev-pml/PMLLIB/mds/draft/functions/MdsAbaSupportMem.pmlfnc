--
-- File:		MdsAbaSupportMem.pmlfnc
--   Type:		Form
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Draft MDS using ABA
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		Tuesday 30th April 2002
--
--
-- Description:
-- Function to Get All Members of the Selected Support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         DBREF of the Selected MDS Support
--
-- Return:
--    [Data Type]   [Description]
--      ARRAY        Array of DBREFs that make up the Selected MDS Support
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Define Function
define function !!mdsAbaSupportMem(!support is DBREF) is ARRAY

-- Initialise Variables
  !data = ARRAY()

-- Get the Name of the MDS Support
    !origin = !!ce
--<wd>jan2005
-- Navigate to the Current "!support element", otherwise this function doesn't appear to work correctly!!!
    !!ce  = !support
--<wd>jan2005
  !name = !!mdsgetsuppname(!support)

    if (!name.upcase().eq('ABORT')) then
      !!ce = !origin
      return !data
    endif
    !!ce = !name.dbref()

-- Set Supptype
    !supptype = !!ce.:mdssupptype

-- Check if Selected MDS Support is a STRUCTURE
    if (!support.type.eq('STRU')) then
      !data.append(!support)

    --elseif (!support.type.eq('ATTA')) then
    elseif (!support.type.eq('ATTA') or !support.type.eq('PLAT')) then
      !data.append($!<name> )
      handle none
        !!ce = $!name
        if (!!ce.owner.:mdstrun) then
          !data.append(!!ce.owner)
          !data.append(!!ce.owner.href)
        endif
      elsehandle any
      endhandle
    else
      !!alert.message('Selected component does not belong to a MDS support')
      return
    endif

-- Get all components associated with this support
-- The COLLECTION 'method' of collecting the attas by scanning the database has proved to take too long
-- Using a DO Loop and the MDS Support Name is significantly quicker.

   $!<name>/DATUM
   handle none
     !data.append(!!ce)
     same
   elsehandle any
   endhandle

   $!<name>/SREF
   handle none
     !data.append(!!ce)
     same
   elsehandle any
   endhandle

   $!<name>/MAKEUP
   handle none
     !data.append(!!ce)
     same
   elsehandle any
   endhandle

   $!<name>/NOTE1
   handle none
     !data.append(!!ce)
     same
   elsehandle any
   endhandle

   $!<name>/NOTE2
   handle none
     !data.append(!!ce)
     same
   elsehandle any
   endhandle

   $!<name>/NOTE3
   handle none
     !data.append(!!ce)
     same
   elsehandle any
   endhandle

   do !count from 1 to 150
     $!<name>.$!count
     handle none
      --if (!!ce.type.eq('ATTA')) then
      if ((!!ce.type.eq('ATTA')) OR (!!ce.type.eq('CTSUPP'))) then
         !data.append(!!ce)
       endif
       same
     elsehandle any
       skip
     endhandle
   enddo

   if !data.empty() then
     $!<name>
     handle none
      if ((!!ce.type.eq('ATTA')) OR (!!ce.type.eq('CTSUPP'))) then
        --if (!!ce.type.eq('ATTA')) then
         !data.append(!!ce)
       endif
       same
    elsehandle any
     endhandle
   endif

--Determine the Connected Joints for the selected MDS support
  !vertDbref    = ARRAY()
    !vert1        = !name & '-V1'
  !vertDbref[1] = !vert1.dbref()
    handle any
-- incase no Verts (bed plate) (may be (-BAR-1 as for 'FT07', 'FT15'))
      !vert1        = !name & '-BAR-1'
    !vertDbref[1] = !vert1.dbref()
     handle any
      endhandle
    elsehandle none
      !vert2        = !name & '-V2'
    !vertDbref[2] = !vert2.dbref()
      handle any
-- Supports where ONE Cross Bar may also be connected (FT10,FT11,FT13,FT15,DT02)
        !vert2        = !name & '-BAR-1'
      !vertDbref[2] = !vert2.dbref()
        handle any
-- incase only one SCTN exists
        endhandle
      endhandle
    endhandle

-- Append ANY Joints to the !data array
  !data.appendarray(!!mdsgetnodes(!vertDbref))

-- MDS Catalogue Based Hangers
  !hang = ARRAY()
    if(!supptype.upcase().match('FH') gt 0 OR !supptype.upcase().match('VH') gt 0 OR !supptype.upcase().match('MH') gt 0) then
    !hang = !!mdsgethanglist(!!ce)
    endif
    !data.appendarray(!hang)

-- Return the ARRAY of DBREFs that make up the Selected MDS Support
   return !data

-------------------------------------------------------------------------------------
--------------------------------------------------------------------------------
  endfunction
