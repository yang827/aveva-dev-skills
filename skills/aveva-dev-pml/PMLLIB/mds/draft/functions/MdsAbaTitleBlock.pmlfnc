--
-- File: MdsAbaTitleBlock.pmlfnc
--   Type: Function
--
-- Author: Martin Wright
-- Created: 11 June 2002
--
--
-- Description:
-- Basic task function called by abatasks for showing support location in project.
------------------------------------------------------------------------
-- Revision 0 11-06-2002 Development Session
------------------------------------------------------------------------
define function !!mdsabatitleblock(!params is ARRAY)

--!!pars = !params
  !sheet = !!ce
  Prec 2 dp
  !units = object COMUNITS(TRUE)

-- Set UNITS to metric for making task work when in imperial.
  UNITS MM Bore
  UNITS MM Distance

-- Load task parameter form ready for use.
  LOADFORM !!mdsabatitleblock

-- Navigate to SHEE
  SHEE
  GOTO DARREF
  var !supname NAME
  !supname = !supname.substring(1,!supname.match(|-AREA|) - 1)

--<wd>feb2005
  !ceorigin = !!ce
  !!ce = !supname.dbref()
  handle (2,109)
-- Check if MDS Support is the MASTER STRUCTURE, number [1], of a MDS GROUP, if UNDEFINED NAME error(2,109) occurs
    !supname = !supname + '[1]'
    !support = !supname.dbref()
  elsehandle NONE
    !support = !supname.dbref()
  endhandle
  !!ce = !ceorigin
--<wd>feb2005

-- Return to SHEET
  !!ce = !sheet

-- Calculate weight of support and place texp on sheet.
  !weight = !!mdsabatitleblock.calcweight(!supname)
  !wnote = !params[1].split(',')

--<wd>oct2007<mds12>
-- DUN767 for Defect No.P-2763 -- Fix the ERROR -- (41,8) Cannot create a NOTE, TEXP elements etc... at this level
-- Navigate to the Current SHEET
  !!ce = !sheet
--<wd>oct2007<mds12>

  NEW NOTE
  !name = NAME OF OWNER
  NAME $!name/TitleNOTE
  handle (41,12)
    DELETE NOTE
    $!name/TitleNOTE
    DELETE NOTE
    NEW NOTE
    NAME $!name/TitleNOTE
  endhandle

  NEW TEXP
  CHEIGHT $!wnote[3]
  AT X $!wnote[1] Y $!wnote[2]
  --BTEXT '$!weight $!!mdsweitag'
  BTEXT '$!weight'
-- Drawing Scale
  !wnote = !params[2].split(',')
  NEW TEXP COPY PREV
  AT X $!wnote[1] Y $!wnote[2]

---------------------------------------------------------------------------------------------------
--<wd>feb2005
-- Get the VSCA of the LAST DETAIL VIEW on the DRAWING SHEET from the !mdsobject
-------------------------------------------------
-- *** The ORIGINAL CODE shown below CAN get the "INCORRECT" VSCA of the WELD SYMBOL VIEW
-- when the MDS STD FRAMEWORK WELD DETAILS are SHOWN in a VIEW,
-- e.g. View Name /WFD-MDS-ABA-PS7278-FANP09-AREA/S1/WELDV1 ***
-------------------------------------------------

-- Collect scale of last view on sheet.
--  var !views COLL ALL VIEW FOR SHEET
-- Grab the last view scale.
--  !lastview = !views[!views.size()]
--  var !scale VSCALE OF $!lastview
-------------------------------------------------
-- Determine the <MDSABASUPPORT> OBJECT for the current MDS GROUP, FRAMEWORK or HANGER
  !mdsobject = !!mdsabasuppobj(!support)
  !viewscale = !mdsobject.abadata.views.last().dbref().vsca
  !scale     = !viewscale.distance()
--<wd>feb2005
---------------------------------------------------------------------------------------------------

  if (defined(!!abauserview) EQ FALSE) then
-- Initialise variables
    !scdtext = ARRAY()
    !scrtext = ARRAY()
-- Read permitted scales from  defaults file section 2
    !file = object FILE(!!abadefaults.defaultsfile.val)
    !defaulttext = !file.readfile()
    !start = !defaulttext.findfirst('-- Section 2') + 1
    !end   = !defaulttext.findfirst('-- End Section 2')
    !range = !end - !start
    !scales = !defaulttext.from(!start,!range)

-- Extract relevant bits for form gadget
    do !x values !scales
-- All Scales need to be Checked NOT just the Metric values
      !split = !x.split('\')
      !scdtext.append(!split[3])
      !scrtext.append(!split[5].split(',')[1])
    enddo

-- Find nearest relevant scales
    !scadtext = !scdtext
    !scartext = !scrtext
  else
    !scadtext = !!abauserview.scalevalue.dtext
    !scartext = !!abauserview.scalevalue.rtext
  endif

-- Search for all scales that match those available from the view form.
  !scalestring = !scadtext[!scartext.findfirst(!scale)]
    handle (2,756)
      !scalestring = !scale
    endhandle
  !scalestring = !scalestring.trim()
  !scalestring = !scalestring.trim('M',' ')
  !scalestring = !scalestring.replace(' ','')
  BTEXT |$!scalestring|
  CHEIGHT $!wnote[3]
  FONT $!wnote[4]


-- Drawing Name
  !wnote = !params[3].split(',')
  NEW TEXP COPY PREV
  var !name $!wnote[1]
  AT X $!wnote[2] Y $!wnote[3]
  BTEXT '$!name'
  CHEIGHT $!wnote[4]
  FONT $!wnote[5]

-- Drawing Title
  !wnote = !params[4].split(',')
  NEW TEXP COPY PREV
  var !name $!wnote[1]
  AT X $!wnote[2] Y $!wnote[3]
  BTEXT '$!name'
  CHEIGHT $!wnote[4]
  FONT $!wnote[5]
  !!ce = !sheet
  !units.restoreSavedBoreDist()
  Prec var def

endfunction
-------------- End Of Code --------------
