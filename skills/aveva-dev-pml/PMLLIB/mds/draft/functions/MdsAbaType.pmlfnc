--
-- File:		MdsAbaType.pmlfnc
--   Type:		Form
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Draft MDS using ABA
--   Replaces:
--
-- Author:		Neale Morris
-- Created:		Tuesday 25th June 2002
--
--
-- Description:
-- Function to find out what sort of support the member is
-- Hanger                 = HANGER
-- Frame                  = FRAME
-- Ancillary              = ANCILL
-- Trunnion               = TRUNNION
-- Preliminary            = PRELIM
-- Nothing to do with MDS = ERROR
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         DBREF of the Selected MDS Support
--
-- Return:
--    [Data Type]   [Description]
--      STRING      Support Type
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Define Function

define function !!mdsAbaType(!support is DBREF) is STRING

-- Make sure the passed support name of the main member

  !!mdsSilent = TRUE
  !mainSupportName = !!mdsGetSuppName(!support)
  if !mainSupportName.neq('ABORT') then
    !mainSupport = !mainSupportName.dbref()
  else
    return 'ERROR'
  endif
  !!mdsSilent = FALSE

  if !mainSupport.type.eq('STRU') then
--<kp>jan07
    if !mainSupport.:MdssuppType.eq(!!mdslsuppdefs.type) then
-- It is lighting support
       return 'LSUPP'
    else
-- Then it a framework
       return 'FRAME'
    endif
--<kp>jan07

  elseif !mainSupport.type.eq('ATTA') then

-- If its not got a spref pointing to /MDS then it not a support
    if !mainSupport.spref.badref() then
      return 'ERROR'

    elseif (purp of spec of spref of $!mainSupport neq ('MDS')) then
      return 'ERROR'

-- If the atta has a cref to a hang then its a hanger
    elseif !mainSupport.cref.badref().not() then
      !spref = !mainSupport.spref.name
      if !mainSupport.spref.name.matchwild('/MDS/FH*') then
        return 'HANGER'

      elseif !mainSupport.spref.name.matchwild('/MDS/VH*') then
        return 'HANGER'

      elseif !mainSupport.spref.name.matchwild('/MDS/LI*') then
--<wd>dec2004 -- Using MDS with a HANGER MANUFACTURERS DESIGN INTERFACE.
        return 'HANGER'

      elseif !mainSupport.spref.name.matchwild('/MDS/MH*') then
--<wd>dec2004 -- Using MDS with a HANGER MANUFACTURERS DESIGN INTERFACE.
        return 'HANGER'

      --<wd>oct2005
      elseif !mainSupport.owner.name.match(!mainSupport.name).gt(0) and !mainSupport.owner.:MDSTrun then
-- Its a trunnion
        return 'TRUNNION'
--<wd>oct2005

      else

        return 'ANCILL'

      endif

      $(
      if !mainSupport.cref.type.eq('HANG') then
        if (!mainSupport.stype inset ('AT05','AT09','AT23','AT52A','AT52B','AT52C','AT52D','AT52E','AT52F')) then
             return 'ANCILL'
           else
             return 'HANGER'
           endif
        endif
        $)
      --endif

      --<wd>oct2005 -- The ORIGINAL CODE in the "elseif" statement below could never have worked!!!
      --elseif !mainSupport.name.match(!mainSupport.owner.name).gt(0) and !mainSupport.owner.:MDSTrun then
    elseif ((!mainSupport.owner.name.match(!mainSupport.name).gt(0)) and (!mainSupport.owner.:MDSTrun)) then
-- Its a trunnion
      return 'TRUNNION'
--<wd>oct2005

    elseif !mainSupport.spref.name.matchwild('/MDP/*') then
--<wd>dec2004 -- Preliminary support
        return 'PRELIM'

    elseif (purp of spec of spref of $!mainSupport eq ('MDS')) then
-- It must be a ancillary
      return 'ANCILL'

    else
-- Its nothing to do with MDS
      return 'ERROR'
    endif

--<wd>oct2005 -- Added because the Trunnion Support Name may NOT belong to an ATTA,
--<wd>oct2005 -- e.g. Type TT36 trunnion "MDS SUPPORT NAME" is stored at a "PLAT" element
  elseif ((!mainSupport.owner.name.match(!mainSupport.name).gt(0)) and (!mainSupport.owner.:MDSTrun)) then
-- Its a trunnion
      return 'TRUNNION'
--<wd>oct2005

  else
-- Its nothing to do with MDS
    return 'ERROR'

  endif

  endfunction
-- End of Function - !!mdsAbaType.pmlfnc
