--------------------------------------------------------------------------------
--
-- File:    MdsAbaViewTask.pmlfnc
--   Type:  Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module:    Draft MDS3.1.2 using ABA version AB_ADP11.3.1.3
--   Replaces:
--
-- Author:   Wayne Dodwell
-- Created:  Monday 28th May 2002
--
--
-- Description:
-- Main MDS ABA View Task to Process the Selected MDS ABA View Task
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        ARRAY        MDS Support ARRAY of ABA View Tasks and TKPARAs
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Define Function

 define function !!mdsabaviewtask(!params is ARRAY)

-- Set the DBREF of the Current View being Processed
   !view = !!ce
   frame off

-- Find the MDS Support associated with this ABA Drawing
-- abaname is the support name if its NOT a MDS GROUP
   !abaname = !view.owner.darref.name.before('-AREA')

--<wd>jan2005
-- !abasupp is the support dbref
--   !abasupp = !abaname.dbref()
   !ceorigin = !!ce
   !!ce = !abaname.dbref()
   handle (2,109)
-- Check if MDS Support is the MASTER STRUCTURE, number [1], of a MDS GROUP, if UNDEFINED NAME error(2,109) occurs
     !abaname = !abaname + '[1]'
     !abasupp = !abaname.dbref()
   elsehandle NONE
     !abasupp = !abaname.dbref()
   endhandle
   !!ce = !ceorigin
--<wd>jan2005

-- Find the Index of the MDSSUPPORT Object Data Array(!!mdsarray) for the current MDS Support
   !objsupp   = false
   !objindex  = 0
   !mdsobject = object MDSABASUPPORT()
   do !indx indices !!mdsarray
     if (!!mdsarray[!indx].support.eq(!abasupp)) then
       !objindex  = !indx
       !mdsobject = !!mdsarray[!indx]
       !objsupp   = true
       break
     else
       skip
     endif
   enddo

-------------------------------------------------
--<wd>jan2005 -- !!currentsupport NOT USED ANY MORE, --<see line 260 approx. below>
-- !!mdsweldtags function now passes the !mdsobject as an argument
--
-- tm addition to remember the support
--   !!currentsupport = !mdsobject
--
--<wd>jan2005
-------------------------------------------------

-- End this Task if a MATCH for the MDS Support is NOT Found in the MDSABASUPPORT Objects
   if (!objsupp.not()) then
     return
   endif

-----------------------------------------------------------------
-- Adjust the Current MDS ABA Drawing View Attributes as required
-----------------------------------------------------------------
   !views = !mdsobject.abadata.views
   !!ce   = !view
   !vname = !!ce.name

-- Reset the drawlist to a "BOG" standard drawlist not a criteria drawlist for speed
   !amnow = !!ce
  -- do !SetIdli values !views
   !viewdir = dir
   !viewdirs = !viewdir.string().split()
   if undefined(!params[8]) then
      !vol = false
   else
      !vol = !params[8].boolean()
   endif

--q var !mdsobject

   if !viewdirs.size().gt(3) then
--!!wdatt = 'ATTA'
--<wd>jan2005>
-- Modified to now pass ALL of the OBJECT !mdsobject
     --!!mdsabasetidln(!mdsobject.support,!view,'ATTA',!vol)
     !!mdsabasetidln(!mdsobject,!view,'ATTA',!vol)
--<wd>jan2005>

   else
--!!wdatt = 'BRAN'
--<wd>jan2005>
-- Modified to now pass ALL of the OBJECT !mdsobject
     --!!mdsabasetidln(!mdsobject.support,!view,'BRAN',!vol)
     !!mdsabasetidln(!mdsobject,!view,'BRAN',!vol)
--<wd>jan2005>--<wd>jan2005>
   endif
   -- enddo

   !!ce = !amnow
-- Find the Current ABA View from the Index in the Array '!views'
   !vnum  = !vname.after('-AREA/S1/')
   do !vindx indices !views
     if (!views[!vindx].after('-AREA/S1/').eq(!vnum )) then
       !viewindx = !vindx
       break
     else
       skip
     endif
   enddo

---------------------------------------------
-- Check Which View ABA is Currently Updating
---------------------------------------------
--
--------------------------------------------
--<wd>10apr2008 - DUN824 - Defect No. P-4405
-- ***INFORMATION ONLY *** NO CHANGES MADE HERE as the SYNTAX already Caters for the current COORD system, XYZ or ENU????
   if (!mdsobject.abadata.tviews[!viewindx].direction.north.eq(1)) then
--<wd>10apr2008 - DUN824 - Defect No. P-4405
--------------------------------------------
-- Main View - i.e.The ABA Template View Direction = N (1)
     !vdir = !mdsobject.mdsdata.datumorthdir.string().before(' WRT')
     dire $!vdir
-- Main View may require Turning if Datum Pipe is Vertical and P3 is not 'South'
     adeg $!mdsobject.abadata.mainviewadeg
-- Reset the View Size to that defined in the ABA Template
     !vsize = !mdsobject.abadata.tviews[!viewindx].size
     !!ce.size = !vsize

---------------------------------------------------------------------------------
--<wd>kbr
-- When ONLY a SINGLE MAIN DRAWING VIEW is BEING USED- The TEMPLATE view direction MUST always be NORTH
-- e.g. On a MDS Special Support on a RACK type Support with NO SCTN/SUBS members etc.. in the MDS STRU
-- REDEFINE the View Scale to SUIT the ACTUAL VIEW DIRECTION set above,
-- but ONLY if it differs from the ORIGINAL View direction.
--
--------------------------------------------
--<wd>10apr2008 - DUN824 - Defect No. P-4405
-- Caters for the current COORD system, XYZ or ENU????
-- Original view direction is NORTH
--     if (!vdir.eq('N').not()) then
--
-- Original view direction is now NORTH or Y
     if (!vdir.eq('N').not()) and (!vdir.eq('Y').not())then
--<wd>10apr2008 - DUN824 - Defect No. P-4405
--------------------------------------------
--
-- Redefine the View Scale using the ABA Set Scale Routines
       auto limits of idln
       !autoscale = !!ce.vsca
       !newscale = !!mdsabaselsupp.setscale(!autoscale,!view)
       !!ce = !view
       !!ce.vsca = !newscale
     endif
--<wd>kbr
---------------------------------------------------------------------------------
   elseif (!mdsobject.abadata.tviews[!viewindx].direction.east.eq(1)) then
-- Side View - i.e.The ABA Template View Direction = E (1) -
-- View Direction depends on the The Drawing Projection
     if (!mdsobject.abadata.projection.eq('THIRD')) then
       !vdir = !mdsobject.mdsdata.lookwestdir.string().before(' WRT')
--     $P THIRD
--     $P $!vdir
     else
       !vdir = !mdsobject.mdsdata.lookeastdir.string().before(' WRT')
--     $P FIRST
--     $P $!vdir
     endif
     dir $!vdir
-- Reset the View Size to that defined in the ABA Template
     !vsize = !mdsobject.abadata.tviews[!viewindx].size
     !!ce.size = !vsize

--<wd>18dec2008 - Defect No. P-13975 -- NEW ADEG Value for the SIDE VIEW (DRTMPL default VIEW Direction is E or X wrt /*
-- Side View may require Turning if DATUM ATTA is ON a Vertical PIPE
     adeg $!mdsobject.abadata.sideviewadeg
--<wd>18dec2008 - Defect No. P-13975

   elseif (!mdsobject.abadata.tviews[!viewindx].direction.up.eq(-1)) then
-- Plan View - Need to Orientate it Correctly with the Main View and The ABA Template View Direction = D (1)
     !vdir = !mdsobject.mdsdata.lookdowndir.string().before(' WRT')
     dir $!vdir
-- Plan View may require Turning if Datum Atta is Horizontal but the Leave Direction is NOT
-- a True Orthogonal Direction - e.g. 'E 30 N wrt /*'
     adeg $!mdsobject.abadata.planviewadeg
-- Reset the View Size to that defined in the ABA Template
     !vsize = !mdsobject.abadata.tviews[!viewindx].size
     !!ce.size = !vsize

   else
-- MDS ABA Template View is Incorrectly Defined
-- $P ** MDS ABA Template View is Incorrectly Defined
     return

   endif

--<kp>july06
   !doifliptheview = !mdsobject.getelemforuda().:MdsViewFlip

$(  commented out - viewflip is now stored at STRU or ATTA or REST - depending on a type of support
-- The viewflip attribute is stored at the datum atta
   !suppname = !mdsobject.support.name
   !datumname = !suppname + '/DATUM'
   !doifliptheview = :mdsviewflip of $!datumname
   handle any
     !doifliptheview = :mdsviewflip of $!suppname
   endhandle
$)
   if !doifliptheview then
     !newvdir = !vdir.direction().opposite().string().before(' WRT')
     if !newvdir.eq('U') or !newvdir.eq('Z') then
       --!newvdir = 'D'
       -- it was always set to D down
       -- Fix for HPD0030744 GE 03/04/06
       !newvdir = 'U'
      -- adeg 180
       adeg 0
     endif
     dir $!newvdir
     !vdir = !newvdir
   endif

-- Run the Dimensioning and/or Labelling Tasks Selected in the associated ABA View template
-- The '!params' array contains an On/Off flag(i.e. !field[1] of !params[!indx]) + the Dimension/Label Pen Options etc... to be used
-- [1] -- Steelwork Dimensions
-- [2] -- Steelwork Tags
--<wd>18dec2008 -- REDUNDANT TASK - ??? Since January 2005 ??? - [3] -- External Joint Dimensions
--<wd>18dec2008 -- REDUNDANT TASK - ??? Since January 2005 ??? - [4] -- All Joint Tags
--<wd>18dec2008 -- now [3] was [5] -- Ancillary Dimensions
--<wd>18dec2008 -- now [4] was [6] -- Ancillary Co-Ordinates
--<wd>18dec2008 -- now [5] was [7] -- Ancillary Tags
--<wd>18dec2008 -- now [6] was [8] -- Flag to add within the volume
--<wd>18dec2008 -- now [7] was [9] -- Weld Task parameters

--<wd>feb2005
-- The OBJECT member "!mdsobject.abadata.ldimdposx" is used ONLY with MDS GROUPS
-- Reset the value of the object member "!mdsobject.abadata.ldimdposx" to ZERO <0>
-- for the MDS SUPPORT being processed on the CURRENT VIEW of the MDS ABA DRAWING
   !mdsobject.abadata.ldimdposx = 0
--<wd>feb2005

-- Only Process the '!params' array iteration where 'field[1]' is set to TRUE
-- PML TRACE ON
   do !indx indices !params
     !field = !params[!indx].split(',')
     !stringparams = !params[$!indx].after(',')

     if (!field[1].boolean()) then
       if (!indx.eq(1)) then
-- [1] -- Steelwork Dimensions
--<wd>feb2005
         --!!mdsabasteeldims(!view,!stringparams,!mdsobject.support)
         !!mdsabasteeldims(!view,!stringparams,!mdsobject)
       elseif (!indx.eq(2)) then
-- [2] -- Steelwork Tags
--<wd>jan2005
         --!!mdsabasteeltags(!view,!stringparams)
         !!mdsabasteeltags(!view,!stringparams,!mdsobject)
--<wd>jan2005
         !savedparams = !stringparams

-------------------------------------------
--<wd>27mar2008 - DUN824 - REDUNDANT TASKS - ??? Since January 2005 ???
--
--        elseif (!indx.eq(3)) then
-- -- [3] -- External Joint Dimensions
--         -- !!mdsabaxjntdims(!view,!stringparams)
--        elseif (!indx.eq(4)) then
-- -- [4] -- All Joint Tags
--          -- !!mdsabaixjnttags(!view,!stringparams
--
--<wd>27mar2008 - DUN824 - REDUNDANT TASKS - ??? Since January 2005 ???
-------------------------------------------

-------------------------------------------
--<wd>27mar2008 - DUN824 - RE-INDEX TASKS
-- From this Point onwards -- Re-Index the indices !indx because of the REDUNDANT TASKS
--
--       elseif (!indx.eq(5)) then
       elseif (!indx.eq(3)) then
-- [5] -- Ancillary Dimensions
--q var !view.name !stringparams
--<wd>mar03
--<wd>feb2005
         --!!mdsabaancdims(!view,!stringparams,)
         --!!mdsabaancdims(!view,!stringparams,!mdsobject.support )
         !!mdsabaancdims(!view,!stringparams,!mdsobject)
--<wd>feb2005
--<wd>mar03
--       elseif (!indx.eq(6)) then
       elseif (!indx.eq(4)) then
-- [6] -- Ancillary Co-Ordinates
--<wd>feb2005
         --!!mdsabaanccoords(!view,!stringparams,!mdsobject.support)
         !!mdsabaanccoords(!view,!stringparams,!mdsobject)
--       elseif (!indx.eq(7)) then
       elseif (!indx.eq(5)) then
-- [7] -- Ancillary Tags
--<wd>feb2005
         --!!mdsabaanctags(!view,!stringparams)
         !!mdsabaanctags(!view,!stringparams,!mdsobject)
--       elseif (!indx.eq(9)) then
       elseif (!indx.eq(7)) then
-- [8] -- Weld Tags
--<wd>jan2005
         --!!mdsabaweldtags(!view,!stringparams,!!currentsupport)
         !!mdsabaweldtags(!view,!stringparams,!mdsobject)
       endif
--
--<wd>27mar2008 - DUN824 - RE-INDEX TASKS
-------------------------------------------

     else
--<wd>18mar2004
-- When the variable - !field[1].boolean() - is FALSE for the View Task Option
-- The variable - !savedparams - MUST be defined to avoid ERRORS in the Command Line Output form
       if (!indx.eq(2)) then
         !savedparams = !stringparams
       endif
--<wd>18mar2004
       skip
     endif
   enddo
-- PML TRACE OFF


-- Now Run the MDS specific view tasks not controlled by the user
-- User Notes
   cont draw
   view
   !!mdsabaaddnote(!mdsobject.support,!view,!savedparams)

-- View Direction Label
   cont draw
   view
   !!mdsabalookdir(!view)

-- Pipe end symbols
   cont draw
   view
--<wd>feb2005 -- Pass the MDS ABA SUPPORT OBJECT with the INTRODUCTION of MDS GROUPS
   --!!mdsabapipesymb(!mdsobject.support,!view)
   !!mdsabapipesymb(!mdsobject,!view)


$(
-- Extra Drawlist?
  !!mdsabaxdrawlist()
$)
-- Add labels
  !desc = desc of /MDS/TEMPLATES
  if !desc.upcase().eq('FRAMATOME TEMPLATES') then
    cont draw
    view
    if !!ce.title.upcase().match('ISO').eq(0) then
      !!mdsabafratags(!mdsobject,!view)
        handle ANY
        endhandle
    endif
  endif

-- add "dummy" elev. labels to dimensions that have PLTX displaying elevation
  if !desc.upcase().eq('FRAMATOME TEMPLATES') then
    cont draw
    view
    if !!ce.title.upcase().match('ISO').eq(0) then
      !!mdsabaelelab(4,view)
        handle ANY
        endhandle
    endif
  endif

  if !desc.upcase().eq('FRAMATOME TEMPLATES') then
    cont draw
    view
    if !!ce.title.upcase().match('ISO').eq(0) then
      !!mdsabadimplt(!mdsobject,view)
        handle ANY
        endhandle
    endif
  endif

-- Spread label of view after all tasks have been run
   cont draw
   view
   !!mdsabaspreadtags()
     handle ANY
     endhandle

-- Unlock any locked element because of the spreading of slabs
   view
   unlock all
     handle ANY
     endhandle

-- Access the pipe dims layer and set the user dims to the same attributes
-- so that they appear the same colour etc

   !viewName = !!ce.name
   !pipedimsname = !viewName + '/PIPE_Dims'
   !userdimsname = !viewName + '/USER_Dims'
   !steeldimsname = !viewName + '/STEEL_Dims'
   !!ce = $!userdimsname
     handle none
       copy att of $!pipedimsname
         handle ANY
           copy att of $!steeldimsname
             handle ANY
             elsehandle NONE
               PURP DIMA
             endhandle
         elsehandle NONE
           PURP DIMA
         endhandle
     elsehandle ANY

     endhandle

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- ###############
-- IMPORTANT NOTE:
-- ###############
------------------
-- Although the MAJORITY of the MAIN Detail VIEWS Attributes are MODIFIED in this function(task)
-- The View Scales and the UPDATE of EACH Detail View is carried out in the SHEET function(task)
-- i.e. !!mdsabasheettask.pmlfnc
-- This is done to avoid UPDATING these Views more than necessary.
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
--
 endfunction
-- End of Function - mdsabaviewtask.pmlfnc
