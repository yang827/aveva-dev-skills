--
-- File: MdsAbaWeldTags.pmlfnc
--   Type: Function
--
-- Author: Tony Martin
-- Created: 27/05/2004 07:38
--
--
-- Description:
-- Basic task function called by abatasks for showing support location in project.

define function !!mdsabaweldtags(!view is DBREF,!params is STRING, !mdsobject is MDSABASUPPORT)

  var !!testpars !params

  -- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
  --
  -- Obsolete Parameter Nos and Some Pen Attributes      --   Params passed as string
  -- Obsolete Parameter Nos and Some Pen Attributes      --   1  Leader Line         LLEAD
  -- Obsolete Parameter Nos and Some Pen Attributes      --   2  Text Frame          LFRAME
  -- Obsolete Parameter Nos and Some Pen Attributes      --   3  Text Pen            TPEN
  -- Obsolete Parameter Nos and Some Pen Attributes      --   4  Text Font           FONT
  -- Obsolete Parameter Nos and Some Pen Attributes      --   5  Leader Line Pen     LLPN
  -- Obsolete Parameter Nos and Some Pen Attributes      --   6  Text Box Pen        LFPN
  -- Obsolete Parameter Nos and Some Pen Attributes      --   7  Terminator Size     TSIZE
  -- Obsolete Parameter Nos and Some Pen Attributes      --   8  Character Height    CHEI
  -- Obsolete Parameter Nos and Some Pen Attributes      --   9  Symbol Scale        XYSCA
  -- Obsolete Parameter Nos and Some Pen Attributes      --  10  Symbol X Offset     X Offset in XYPOS
  -- Obsolete Parameter Nos and Some Pen Attributes      --  11  Symbol Y Offset     Y Offset in XYPOS
  -- Obsolete Parameter Nos and Some Pen Attributes      --  12  Terminator          LTERM
  --
  -- NEW 12.0 version Parameters (Pen Attributes etc...) passed as a STRING
  -- *** IMPORTANT NOTE ***
  -- ONLY 14 parameters are passed here as the ORIGINAL 1st parameter value (TRUE or FALSE ) in the STRING of 15 Parameters
  -- has been REMOVED in the MDS ABA MAIN VIEW calling ABA TASK FUNCTION "mdsabaviewtask.pmlfnc"
  -- LABEL Attributes (GLAB or SLAB)
  -- 1  Leader Line                       = LLEADER
  -- 2  Label Frame                       = LFRAME
  -- 3  Label Font                        = FONT
  -- 4  Label Font Colour                 = TXCOLOUR
  -- 5  Label Font Size                   = CHEIGHT
  -- 6  Label Leader Line Style           = LLSTYLE
  -- 7  Label Leader Line Colour          = LLCOLOUR
  -- 8  Label Frame Line Style            = LFSTYLE
  -- 9  Label Frame Line Colour           = LFCOLOUR
  -- 10 Symbol Scale                      = XYSCALE
  -- 11 Symbol X Offset                   = X Offset in XYPOS
  -- 12 Symbol Y Offset                   = Y Offset in XYPOS
  -- 13 Terminator Size                   = TSIZE
  -- 14 Terminator Type                   = LTERMINATOR

  -- Set a default value for the xypo offset
  !offsetvalue = 50
  !passedparams = !params.split(',')

  context draw
  view

  prec 2 dp
  !units = object COMUNITS(TRUE)

  -- save the view direction for deciding which welds to use
  !viewdir = dir
  !name = !!ce.name

  -- Add pjoi sjoi and fitt members to !attalist
  var !suppmem coll all (atta sctn pjoi sjoi fitt) for $!mdsobject.support
  do !loop values !mdsobject.mdsdata.members
    if (!loop.type.neq('STRU')) then
      !suppmem.append(!loop.string())
    endif
  enddo
  !suppmem.unique()
  if (!suppmem.size().eq(0)) then
    -- $p no welds found in $!name
  endif

  !validweldlists = ARRAY()
  do !a index !suppmem
    --only check for welds if you have a valid catref
    if (!suppmem[$!a].dbref().catref.unset().not()) then
      !attl = object MDSWELDLIST($!suppmem[$!a])
      -- if there are any mdswelds found, the weldlist returns valid
      if (!attl.valid) then
        !validweldlists.append(!attl)
      endif
    endif
  enddo

  --Get view direction
  !viewdir = dir of view wrt world

  -- we now have a list of welds which need to be applied to the drawing
  -- Goto layers of view and create new one for Weld labels.
  -- Now create new layer for "comp" table.
  !name = NAME OF VIEW
  !notes = !name & |/WeldTags_Task|
  $!notes
  handle (2,109)
    NEW LAYER
    NAME $!notes
  elsehandle NONE
    unlock all
    delete LAYER
    NEW LAYER
    NAME $!notes
  endhandle

  !passedparams = !params.split(',')

  -- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
  --
  -- Set passed parameters
  --  LLEAD    $!passedparams[1]
  --  LFRAME   $!passedparams[2]
  --  TPEN     $!passedparams[3]
  --  FONT     $!passedparams[4]
  --  LLPN     $!passedparams[5]
  --  LFPN     $!passedparams[6]
  --  TSIZE    $!passedparams[7]
  --  CHEI     $!passedparams[8]
  --  xyScale  $!passedparams[9] $!passedparams[9]
  --  xypos    $!passedparams[10] $!passedparams[11]
  --  LTERM    $!passedparams[12]

  -- Set the Dimension Attributes Form with the Stored Values at the View Task
  -- All of the 'handle any' lines etc.. have been added to ensure that the MDS ABA default value is USED if an ERROR occurs
  -- At LAYER level
  --
  -- Set the LABEL Attributes with the Passed Parameters
  LLEADER     $!passedparams[1]
  handle ANY
    LLEADER TRUE
  endhandle
  LFRAME      $!passedparams[2]
  handle ANY
    LFRAME FALSE
  endhandle
  FONT        $!passedparams[3]
  handle ANY
    FONT 31
  endhandle
  TXCOLOUR    $!passedparams[4]
  handle ANY
    TXCOLOUR 3
  endhandle
  CHEIGHT     $!passedparams[5]
  handle ANY
    CHEIGHT 3
  endhandle
  LLSTYLE     $!passedparams[6]
  handle ANY
    LLSTYLE Solid
  endhandle
  LLCOLOUR    $!passedparams[7]
  handle ANY
    LLCOLOUR 5
  endhandle
  LFSTYLE     $!passedparams[8]
  handle ANY
    LFSTYLE Solid
  endhandle
  LFCOLOUR    $!passedparams[9]
  handle ANY
    LFCOLOUR 6
  endhandle
  XYSCALE  $!passedparams[10] $!passedparams[10]
  handle ANY
    XYSCALE 1 1
  endhandle
  XYPOS    $!passedparams[11] $!passedparams[12]
  handle ANY
    XYPOS -20mm 14mm
  endhandle
  TSIZE       $!passedparams[13]
  handle ANY
    TSIZE 3
  endhandle
  LTERMINATOR $!passedparams[14]
  handle ANY
    LTERMINATOR Arrows
  endhandle

  -- find the welds which might be useful
  do !weldlist values !validweldlists
    do !weld index !weldlist.welds
      if (!weldlist.welds[!weld].wpurp.eq('ANCI')) then
        -- getsuitablewelds now returns an index list of possible ppoints
        !viewwelds = !weldlist.getsuitablewelds(!viewdir,!weld)
        -- !viewwelds is an index of suitable welds
        if (!viewwelds.size().gt(0)) then
          if (!viewwelds.size().gt(1)) then $* work out the left fit
            !xpos = ARRAY()
            do !a values !viewwelds
              !pos = !weldlist.welds[!weld].positions[!a].string().before('WRT')
              var !shpos shpos of $!pos
              !xpos.append(!shpos.split()[2].real())
            enddo
            -- get the ppoints according to the returned values
            !finalwelds = ARRAY()
            do !a values !viewwelds
              !finalwelds.append(!weldlist.welds[!weld].ppoints[!a])
            enddo
            !index = !xpos.sortedindices()
            !ppoints = !finalwelds
            !ppoints.reindex(!index)
          endif
          !cdetail = !weldlist.welds[$!weld].designitem.catref.owner.cdetail
          if (!cdetail.badref().not()) then
            skip
          endif
          new slab on $!weldlist.welds[$!weld].designitem
          !positioningPoint = $!ppoints[1] + 100
          nppt $!positioningPoint
          handle ANY
            nppt $!ppoints[1]
          endhandle
          tmrf $!weldlist.welds[$!weld].symbol

          --Derive the ancillary weld size ATEXT from the MDS DEFAULTS DATA element
          if (!weldlist.welds[$!weld].designitem.type.eq('ATTA')) then

            -- THE WELD SIZE DATA for MDS12, if it EXISTS, will be derived from the MDS DEFAULTS PARAGON
            -- DATABASE DATA element stored below the DTSE element for each MDS Standard ANCILLARY BORE SIZE.
            -- e.g.  DTSE  /MDS/ATTA/DEFAULTS/ST17/200/WELD
            --       DATA  /MDS/ATTA/DEFAULTS/ST17/200/WELD/SIZE
            --       DKEY  WSIZ
            --       PPROP '7,3'
            --=================================================================================================

            --if weldsize unset then read the default appdefaults
            !weldsize = !weldlist.welds[$!weld].designitem.:MDSWeldSize
            if (!weldsize.unset()) then
              --derive the ancillary WELD Size from the MDS DEFAULTS DATA element
              !desc = !weldlist.welds[$!weld].designitem.styp
              !size = !weldlist.welds[$!weld].designitem.lbor.string().before('mm')

              -- Derive the Ancillary WELD Size from the MDS DEFAULTS DATA element,
              -- e.g. /MDS/ATTA/DEFAULTS/ST17/200/WELD/SIZE
              -- Navigate to the WELD SIZE DATA element to see if it EXISTS
              !xce = !!ce
              /MDS/ATTA/DEFAULTS/$!<desc>/$!<size>/WELD/SIZE
              handle (2,109)
                -- Undefined name /MDS/ATTA/DEFAULTS/$!<desc>/$!<size>/WELD/SIZE
              elsehandle NONE
                -- Set the !weldsize variable from the PROPERTY DKEY WSIZ value for the current ATTA in the DO LOOP
                !!ce = !xce
                !propweldsize = !weldlist.welds[$!weld].designitem.prop.wsiz
                handle ANY
                elsehandle NONE
                  if ((!propweldsize.trim().neq('')) or (!propweldsize.trim().neq('0'))) then
                    !weldsize = !propweldsize
                  endif
                endhandle
              endhandle
            endif

            if (!weldsize.split(',').size().gt(1)) then
              !split = !weldsize.split(',')
              !weldsize = !split[$!weld]
            endif
            atext '$!weldsize'

          elseif (!weldlist.welds[$!weld].designitem.type.eq('PJOI')) then
            -- The weld size if set to * is found at the design element
            !tagsize = '$!weldlist.welds[$!weld].tagtext'
            if (!tagsize.eq('*')) then
              !weldsize = !weldlist.welds[$!weld].designitem.:MdsWeldSize
              !split = !weldsize.split(',')
              !weldsize = !split[$!weld]
            endif
            atext '$!weldlist.welds[$!weld].tagtext'
            if (defined(!weldsize)) then
              atext '$!weldsize'
            endif
          else
            -- Atext is found from the DDAR element
            atext '$!weldlist.welds[$!weld].tagtext'
          endif
        endif
        -- Determine in which portion does the tag point to, and set an appropriate offset
        if (!!ce.ddnm.type.eq('PJOI') or !!ce.ddnm.type.eq('SJOI')) then
          if (!!ce.atext.eq('0') and !!ce.ddnm.gtype inset('PART','COMP','BEAR','COMB')) then
            delete slab
            handle ANY
            endhandle
            skip
          endif

          --set the attach point for plate components to be the base
          if (!!ce.ddnm.gtype inset('COMP','BEAR','COMB')) then
            nppt 3
          endif

          !nppt = nppt
          var !whereisit vside of p$!nppt of ddnm
          handle ANY
            skip
          endhandle
        else
          !pkdis = pkdis
          var !whereisit vside of ppline $!ppline of ddnm prop $!pkdis
          handle ANY
            skip
          endhandle
        endif

        if (!whereisit.upcase().match('UP').gt(0)) then
          !y = $!offsetvalue
        else
          !y = -$!offsetvalue
        endif
        if (!whereisit.upcase().match('LEFT').gt(0)) then
          !x = -$!offsetvalue
          !mirror = FALSE
        else
          !x = $!offsetvalue
          !mirror = TRUE
        endif
        xypo $!x $!y
        if (!mirror) then
          !tmrf = tmrf
          !newtmrf = !tmrf.name + '/MIRROR'
          tmrf $!newtmrf
          handle(2,109)
            -- e.g. Undefined name /MDS/SYMBOLS/GEN/WELD/WELD14-L/MIRROR try /MDS/SYMBOLS/GEN/WELD/WELD14-R
            !rtmrf   = !tmrf.name.replace( '-L','-R')
            !newtmrf = !rtmrf
            tmrf $!newtmrf
            handle (2,109)
              !!abaLogging.error('  ERROR - Weld Symbol $!newtmrf does not exist')
            endhandle
          endhandle
        endif
        lock

      else
        -- Its a SECTION weld
        -- Do not add a symbol if it is controlled by a detail
        !cdetail = !weldlist.welds[$!weld].designitem.catref.owner.cdetail
        if (!cdetail.badref().not()) then
          skip
        endif

        !start = !weldlist.welds[!weld].start
        !end = !weldlist.welds[!weld].end
        if (!start.split(',').size().eq(2)) then

          --The NEW  Q3O_ and Q5O_ SCTN types requires 3 x types of WELDS, i.e.
          --2 x types of WELDS at the POSS(START) plus 1 x type of WELD at the POSE(END)on the 2nd SCTN ONLY -
          !pline = !start.split(',')[1]
          !end = !start.split(',')[2]
          new slab on ppline $!pline of $!weldlist.welds[$!weld].designitem $!end
          tmrf $!weldlist.welds[$!weld].symbol
          atext '$!weldlist.welds[$!weld].tagtext'
          !ppline = pkey
          pkey unset
          !!ce.position = !weldlist.welds[!weld].threedposition
          handle ANY
            !!ce.position = !weldlist.welds[!weld].getWeldPosition()
          endhandle
          var !position position

          --The NEW  Q3O_ and Q5O_ SCTN types require WELDS on the 2nd SCTN ONLY -
        elseif (!end.split(',').size().eq(2)) then
          !pline = !end.split(',')[1]
          !end = !end.split(',')[2]
          new slab on ppline $!pline of $!weldlist.welds[$!weld].designitem $!end
          tmrf $!weldlist.welds[$!weld].symbol
          atext '$!weldlist.welds[$!weld].tagtext'
          !ppline = pkey
          pkey unset
          !!ce.position = !weldlist.welds[!weld].threedposition
          handle ANY
            !!ce.position = !weldlist.welds[!weld].getWeldPosition()
          endhandle
          var !position position
          --The NEW  Q3O_ and Q5O_ SCTN types require WELDS on the 2nd SCTN ONLY -

        else
          --get the threedposition of the weld
          !position = !weldlist.welds[!weld].threedposition
          handle any
            !position = !weldlist.welds[!weld].getWeldPosition()
            handle any
              --if all else fails revert to a default position
              !position = !weldlist.welds[!weld].drawsendweld('Start').string().before('WRT')
            endhandle
          endhandle
          new slab on $!weldlist.welds[$!weld].designitem
          tmrf $!weldlist.welds[$!weld].symbol
          position $!position
          !!ce.position = !weldlist.welds[!weld].threedposition
          atext '$!weldlist.welds[$!weld].tagtext'
        endif

        -- check if sctn dir is the same or opposite to view direction
        -- then check if attached to centre and pline TOS exists
        -- if so then attach label to projected 3D position of TOS
        !sctndir = !weldlist.welds[!weld].designitem.zdir.wrt(worl)
        !sameasview = !sctndir.eq(!viewdir).or(!sctndir.eq(!viewdir.opposite()))
        if (!sameasview and !position.eq('Unset').not()) then
          !tosisthere = !weldlist.welds[!weld].designitem.plnam.find('TOS').set()
          var !shposofattpoint shpos of $!position
          var !shposofddnm shpos of ppline NA of ddnm
          !attachedtocentre = !shposofattpoint.eq(!shposofddnm)
          if (!tosisthere.and(!attachedtocentre)) then
            if (!end.eq('END')) then
              !position = !!ce.ddnm.plend.tos.wrt(worl).string().before('WRT')
            else
              !position = !!ce.ddnm.plstart.tos.wrt(worl).string().before('WRT')
            endif
            position $!position
          endif
        endif

        -- Determine in which portion does the tag point to, and set an appropriate offset
        if (!!ce.ddnm.type.eq('PJOI') or !!ce.ddnm.type.eq('SJOI')) then
          !nppt = nppt
          var !whereisit vside of p$!nppt of ddnm
          handle ANY
            skip
          endhandle
        else
          !pkdis = pkdis
          var !whereisit vside of ppline $!ppline of ddnm prop $!pkdis
          handle ANY
            skip
          endhandle
        endif

        if (!whereisit.upcase().match('UP').gt(0)) then
          !y = $!offsetvalue
        else
          !y = -$!offsetvalue
        endif
        if (!whereisit.upcase().match('LEFT').gt(0)) then
          !x = -$!offsetvalue
          !mirror = FALSE
        else
          !x = $!offsetvalue
          !mirror = TRUE
        endif
        xypo $!x $!y
        if (!mirror) then
          !tmrf = tmrf
          !newtmrf = !tmrf.name + '/MIRROR'
          tmrf $!newtmrf
          handle(2,109)
            -- e.g. Undefined name /MDS/SYMBOLS/GEN/WELD/WELD14-L/MIRROR try /MDS/SYMBOLS/GEN/WELD/WELD14-R
            !rtmrf   = !tmrf.name.replace( '-L','-R')
            !newtmrf = !rtmrf
            tmrf $!newtmrf
            handle (2,109)
              !!abaLogging.error('  ERROR - Weld Symbol $!newtmrf does not exist')
            endhandle
          endhandle

        endif
        lock
      endif
      -- If the atext is set to 0 then delete the slab
      if (!!ce.atext.eq('0')) then
        unlock
        delete slab
      endif
    enddo
  enddo

  laye
  !!ce = !view
  !units.restoreSavedBoreDist()
  Prec var def

endfunction
