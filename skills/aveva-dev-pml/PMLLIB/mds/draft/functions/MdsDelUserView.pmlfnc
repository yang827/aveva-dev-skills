-- Created:             01 March 2005
--
--
-- Description:
-- Function to delete user view within a sheet created from template
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Define Function

define function !!MdsDelUserView()

   -- try to go to view
   !View = view
     handle ANY
       !!Alert.Error('Not MDS User VIEW !')
       return
     endhandle

   -- check if user view
   !IsMdsView = !View.Owne.LinkRef.Owne.Func.eq('MDS')
         handle ANY
           !IsMdsView = FALSE
         endhandle

   if !IsMdsView then
       !IsMdsView = !View.SpPurp.eq('USER')
   endif

   if !IsMdsView.Not() then
      !!Alert.Error('Not MDS User VIEW !')
      return
   endif

   -- check if RW database
   if !View.Dbwrite.Not() then
      !!Alert.Error('Cannot delete VIEW - read-only database!')
      return
   endif

   -- check if locked
   if !View.Lock then
      !!Alert.Error('Cannot delete VIEW - ' + !View.Owne.Namety + ' is locked!')
      return
   endif


   -- compose library names and check if they are locked
   !DrawLib = !View.Name + '/IDLIST'
   !PlaneLib = !View.Name + '/PLANES'
   !Taglib = !View.Name + '/TAGLIB'
   !LibIsLock = FALSE
   !DrawLibRef = !DrawLib.Dbref()
      handle NONE
         if !DrawLibRef.Lock then
            !LibIsLock = TRUE
         endif
      elsehandle ANY
         !DrawLibRef = nulref
      endhandle

   !PlaneLibRef = !PlaneLib.Dbref()
      handle NONE
         if !PlaneLibRef.Lock then
            !LibIsLock = TRUE
         endif
      elsehandle ANY
         !PlaneLibRef = nulref
      endhandle

   !TagLibRef = !TagLib.Dbref()
      handle NONE
         if !TagLibRef.Lock then
            !LibIsLock = TRUE
         endif
      elsehandle ANY
        !TagLibRef = nulref
      endhandle


   if !LibIsLock then
      !!Alert.Error('Cannot delete VIEW - associated library is locked!')
      return
   endif

   -- ask user to confirm deletion
   if !!Alert.Confirm('O.K. to delete '+ !View.Namety + ' ?').Boolean().Not() then
      return
   endif

   -- delete libraries
   -- tagrule library
   if !TagLibRef.Badref().Not() then
          !!CE = !TagLibRef
          delete TRLB
   endif

   -- plane library
   if !PlaneLibRef.Badref().Not() then
          !!CE = !PlaneLibRef
          delete PLLB
   endif

   -- drawlist library
   if !DrawLibRef.Badref().Not() then
          !!CE = !DrawLibRef
          delete DLLB
   endif


   -- delete view
   !!ce = !View
   delete view
   !!FmSys.Refresh()

  endfunction
-- End of Function - !!MdsCreUserView.pmlfnc
