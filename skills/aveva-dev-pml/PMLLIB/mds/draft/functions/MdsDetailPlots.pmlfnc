--      Keyword:     Undefined
--    Module:        Undefined
------------------------------------------------------------------------
--
-- File: MdsDetailPlots.pmlfnc
--   Type: Function
--
-- Author: Anil Kumar
-- Created: 21 February 2005
--
-- Description:
-- Basic Task to create Detail View for the PJOI & SJOI
-- View is created using SLAB which will be stored below the
-- new view created
------------------------------------------------------------------------
define function !!mdsdetailplots(!params is ARRAY)

-- Save created details for tagging of views
  !viewTagsDdnm = ARRAY()
  !viewtagstext = ARRAY()
  !ce = !!ce
  shee
  !sheet = !!ce.name
  !units = object COMUNITS(TRUE)

-- Find support name
  !suppname = !!ce.darref.name.before('-AREA')

-- If the support does not exist it may be a group
  $!suppname
    handle NONE
      !group = FALSE
    elsehandle ANY
      !suppname = '$!suppname[1]'
      !group = TRUE
    endhandle

-- Return to SHEET
  $!sheet
  last mem
    handle ANY
    endhandle

  new view $!sheet/DetailPlots
    handle (41,12)
      delete view
      $!sheet/DetailPlots
      delete view mem
        handle ANY
        endhandle
    endhandle

-- View attributes
  size 50 50 lfra fals Title |MDS ABA 3 Views - Detail Plots|
  !xpos = !params[1]
  !ypos = !params[2]
  vreg tl x $!xpos y $!ypos

-- Create Layer
  new laye $!sheet/DetailPlots/Plots
  !detLayer = !!ce

-- Stack Parameters
  !stackdir = !params[3]
  !stacklen = !params[4]
  if !stackdir.length().eq(2) then
    !sign = !stackdir.substring(1,1)
    !stackdir = !stackdir.substring(2,1)
    !reverseSign = |+|
  else
    !sign = |+|
    !reverseSign = |-|
  endif

  if !stackdir.upcase().occurs(|X|).eq(1) then
    !stackPerDir = |Y|
    !stackPerSign = |-|
  elseif !stackdir.upcase().occurs(|Y|).eq(1) then
    !stackPerDir = |X|
    !stackPerSign = |+|
  endif

-------------------------------------------------
  -- Detail the Building Attachment End Connection
-------------------------------------------------
-- Collect all the PJOI & SJOI for Support Structure
  var !joints coll all (PJOI SJOI) with unset(cdetail of stca of catref) neq TRUE for $!suppname
  -- remove any joints connected to Q type sections
    do !i from 1 to !joints.size()
      !unusedcreffunc = !joints[!i].dbref().cref.func
      handle ANY
      elsehandle NONE
        if !joints[!i].dbref().cref.func.match('Q2').gt(0) then
          skip
        elseif !joints[!i].dbref().cref.func.match('Q').gt(0) then
         !joints[!i].delete()
        endif
      endhandle
    enddo
    !joints.compress()

-- Collect all atta details as well
  if !group.not() then
    var !joints append coll all (ATTA) with unset(cdetail of owner of catref) neq TRUE for $!suppname/DATUM
      handle ANY
        var !joints append coll all (ATTA) with unset(cdetail of owner of catref) neq TRUE for $!suppname
      endhandle
    do !count from 1 to 100
      var !joints append coll all (ATTA) with unset(cdetail of owner of catref) neq TRUE for $!suppname$n.$!count
        handle NONE
          skip
        elsehandle ANY
          break
        endhandle
    enddo
  else
    !suppnameWithOutArray = !suppname.before('[')
    do !grouptag from 1 to 30
      var !joints append coll all (ATTA) with unset(cdetail of owner of catref) neq TRUE for $!suppnameWithOutArray[$!grouptag]/DATUM
        handle ANY
          var !joints append coll all (ATTA) with unset(cdetail of owner of catref) neq TRUE for $!suppnameWithOutArray[$!grouptag]
            handle ANY
            endhandle
        endhandle
      do !count from 1 to 100
        var !joints append coll all (ATTA) with unset(cdetail of owner of catref) neq TRUE for $!suppnameWithOutArray[$!grouptag].$!count
          handle NONE
            skip
          elsehandle ANY
            break
          endhandle
      enddo
    enddo
  endif

-- Reorder joints to put the typical details to the bottom
  !appendjoint = ARRAY()
  do !reorder from 1 to !joints.size()
    !typeOfDetail = !joints[$!reorder].dbref().catref.owner.cdetail.func
    if !typeOfDetail.eq('TYPICAL') then
      !appendjoint.append(!joints[$!reorder])
      !joints[$!reorder].delete()
    endif
  enddo
  if !appendjoint.size().gt(0) then
    !joints.appendarray(!appendjoint)
    !joints.compress()
  endif

--var !joints eval(ddna) for all slab with matchw(name of layer,|*WeldTags_Task|) eq TRUE for shee
--!joints.sortunique()
  var !jointsSpref eval(spref) for all from !joints
  !jointsSprefSort = !jointsSpref
--!jointsSprefSort.sortunique()

-- Create SLAB
  do !loopthrough indices !jointsSprefSort
-- Following Line would be used if One Detail Weld needs to be shown
-- otherwise all the welds will have a detail view
--      !found = !jointsSpref.findfirst(|$!jointsSprefSort[$!loopthrough]|)
     !found = !loopthrough
     new slab ddna $!joints[$!found]

--------------------------------------------
--<wd>11apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--     oset fals llead fals lfpen template
     oset fals
     llead fals
     lfstyle template
     lfcolour template
--<wd>11apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

-- To find Weld Size, which is stored in DDPROP of DTSE of Weld
    -- or if modified will be stored in UDA :MdsWeldSize of SJOI
      if !joints[$!found].dbref().type.eq('ATTA') then
        !catrefname = styp of $!joints[$!found]
      else
        !catrefname = Namn of Catref of $!joints[$!found]
      endif

      !dDARName = '/DDAR-' + !catrefname
      var !noOfWelds coll all ddat with matchw(name,'*TAGTEXT') eq TRUE for $!dDARName
       handle(2,109)
         !noOfWelds = ARRAY()
       endhandle

-- Compare Weld sizes as defined in DTSE against UDA and define ATEXT Value
       !mdsWeldSize = :MDsWeldSize of $!joints[$!found]
       if !mdsWeldSize.neq(|0|) then
          !mdsWeldSplit = !mdsWeldSize.split(|,|)
      else
          !mdsWeldSplit = ARRAY()
       endif

       !atext = ||
       if !noOfWelds.size().neq(0) then
         do !loop indices !noOfWelds
           !weldSize = DDProp of $!noOfWelds[$!loop]
           !weldSize = !weldSize.after(|'|).before(|'|)
           if (!mdsWeldSplit[$!loop].neq(|$!weldSize|) and !mdsWeldSplit.size().neq(0))then
             !weldSize = !mdsWeldSplit[$!loop]
           endif
        !atext = !atext + |\| + !weldSize
         enddo
       else
         !atext = |\*\*\*\*\*\*|
       endif
       atex '$!atext'

-- Find out TMRF from Cdetail of STCA of Catref of SJOI or PJOI
      !tmrf = Cdetail of owner of CATREF of $!joints[$!found]
      if !tmrf.unset() then
        !tmrf = /MDS/ABA/FANP/LIBY/DETAILP/NODET
      endif
      Tmrf $!tmrf
      xypos $!xpos $!ypos

-- Add to tagging details
    !viewTagsDdnm.append(|$!joints[$!found]|)
      !viewtagstext.append(|$!loopthrough|)
   enddo

-- ----------------------------------------------
-- Detail the HANGer's connection to structure
-------------------------------------------------
  -- <K.pleschner> May 2005

-- Navigate back to Sheet
  $!sheet

-- Use MDSOBJECT
  !mdsObject = !!mdsAbaSuppObj(!suppname.dbref())

-- Find whether Support is MDS Group or not
  if !mdsObject.mdsdata.mdsgroup then
    !suppmembers = !mdsObject.mdsdata.allgroupmem
  else
    !suppmembers = !mdsObject.mdsdata.members
  endif

-- find out all hangers with connection SCLA/WPAD or SCLA and store type of last element in parallel array
  !hanger = ARRAY()
  !connection = ARRAY()
  do !memb values !suppmembers
     skip if !memb.type.neq('REST')
     do !hang values !memb.memb
        skip if !hang.memb.unset()
        --if !hang.memb.last().type.eq('SCLA').or(!hang.memb.last().type.eq('WPAD').and(!hang.memb[!hang.memb.size() - 1].type.eq('SCLA'))) then
        -- dtf modified because hanger may have only one element in it
        if !hang.memb.last().type.eq('SCLA') then
          !hanger.append(!hang)
          !connection.append(!hang.memb.last().type)
        elseif !hang.memb.last().type.eq('WPAD').and(!hang.memb[!hang.memb.size() - 1].type.eq('SCLA')) then
          !hanger.append(!hang)
          !connection.append(!hang.memb.last().type)
        endif
        -- get weld info from REST and check for 4th Value
        !ustweldval = !hang.owner.:UstWeldValue
          handle ANY
          elsehandle NONE
            if !ustweldval[4].neq(0) and !hang.memb.first().type.eq('PCLA') then
             !hanger.append(!hang.memb.first())
             !connection.append(!hang.memb.first().type)
            endif
          endhandle
     enddo
  enddo

-- extract position number of last non-typical detail
  !!ce = !detLayer
  !lastdetailno = 0
  do !c indices !detLayer.memb
     !lastdetailno = !c
     !tmrfFunc = !detLayer.memb[!c].tmrf.func
        handle ANY
          !tmrfFunc = ''
        endhandle
     if !tmrfFunc.eq('TYPICAL') then
        if !c.gt(1) then
           !!ce = !detLayer.memb[!c - 1]
        endif
        break
     endif
  enddo

  if !lastdetailno.eq(0) then
     !lastdetailno = 1
  endif


  if !connection.find('SCLA').set() then
     !plotSymbol[1] = object DBREF('/MDS/ABA/FANP/LIBY/DETAILP/SCLA')
  endif
  if !connection.find('WPAD').set() then
     !plotSymbol[2] = object DBREF('/MDS/ABA/FANP/LIBY/DETAILP/WPAD')
  endif
  if !connection.find('PCLA').set() then
     !plotSymbol[3] = object DBREF('/MDS/ABA/FANP/LIBY/DETAILP/PCLA')
  endif

  !wPADCount = 1
-- create detail plot symbol (SLAB) for each hanger
  !jointsddnm = !viewTagsDdnm
   !jointstext =!viewtagstext
  !viewTagsDdnm.clear()
   !viewtagstext.clear()
   do !c indices !hanger
-- get weld info from REST
     !ustweldval = !hanger[!c].owne.:UstWeldValue
        handle ANY
        endhandle
-- set proper symbol
      if !connection[!c].eq('SCLA') then
         !sytmRef = !plotSymbol[1]
      !atext =  |\| & !ustweldval[1] & |\| & !ustweldval[2]
            handle ANY
              !atext =  '\*\*'
            endhandle
         !xdetailno = !lastdetailno

      elseif !connection[!c].eq('WPAD') then
-- if 2 Wpads and they are different weld sizes then increment !lastdetailno
-- but if same use the saved value
         if !wPADCount.neq(1) then
           !weldvalue = 3
           if !ustweldval[2].eq(!ustweldval[3]) then
             !xdetailno = !wPADDetailNo
           else
             !lastdetailno = !lastdetailno + 1
             !xdetailno = !lastdetailno
           endif
         else
           !weldvalue = 2
           !wPADCount = !wPADCount + 1
           !wPADDetailNo = !lastdetailno
           !xdetailno = !lastdetailno
         endif
         !sytmRef = !plotSymbol[2]
      !atext =   |\| & !ustweldval[1] & |\| & !ustweldval[!weldvalue]
            handle ANY
              !atext =  '\*\*'
            endhandle
      elseif !connection[!c].eq('PCLA') then
         !ustweldval = !hanger[!c].owne.owne.:UstWeldValue
         handle ANY
         endhandle
         !lastdetailno = !lastdetailno + 1
         !xdetailno = !lastdetailno
         !sytmRef = !plotSymbol[3]
      !atext =    |\| & !ustweldval[4]
            handle ANY
              !atext =  '\*\*'
            endhandle
      else
        skip
      endif

-- create SLAB
     new slab
     !!ce.ddnm = !hanger[!c]
     !!ce.atext = !atext
     !!ce.tmrf = !sytmRef
     !!ce.llead = FALSE
     !!ce.oset = FALSE

--------------------------------------------
--<wd>11apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
     --lfpen template
     lfstyle template
     lfcolour template
--<wd>11apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

      xypos $!xpos $!ypos
-- store tagging details
    --!viewTagsDdnm.insert(!lastdetailno,!hanger[!c].string())
    --!viewTagsDdnm.insert(!xdetailno,!hanger[!c].string())
    !viewTagsDdnm.append(!hanger[!c].string())
       !viewtagstext.append('')
   enddo

   do !i indices !jointsddnm
    !viewTagsDdnm.append(!jointsddnm[!i])
      !viewtagstext.append(!jointstext[!i])
   enddo


-- renumber !viewtagstext and add sequ number to slabs
   do !c indices !viewtagstext
      !viewtagstext[!c] = !c.string()
      !!ce = SLAB $!c
      !!ce.atext = !c & !!ce.atext
   enddo
  --<K.pleschner> May 2005
------------------------------------------------------------------------------------

-- Stack the Detail Plots, Navigate to Layer and collect the SLABS Created
-- Make an array of Line Number and Sequence
   !lineNo = 0
   !lineNoArray = ARRAY()
   !seqArray = ARRAY()
   $!sheet/DetailPlots/Plots
   do !loop1 from 1 to !!ce.members.size() by $!stacklen
      do !loop2 indices !!ce.members
         if !!ce.members[$!loop2].sequence.eq(!loop1) then
          !lineNo = !lineNo + 1
          !seq = !!ce.members[$!loop2].sequence
          !lineNoArray.append(|$!lineNo|)
          !seqArray.append(|$!seq|)
         endif
      enddo
   enddo

-- Collect all SLAB and position them based on Stack Direction & Stack Length
   var !slab coll all slab for ce
   do !loop1 indices !slab
     $!slab[$!loop1]
     !seq = !slab[$!loop1].dbref().sequence
      do !loop2 indices !seqArray
         if !slab[$!loop1].dbref().sequence.eq(!seqArray[$!loop2].real()) then
            !line = !lineNoArray[$!loop2]
         endif
      enddo

      if !seq.real().leq(!stacklen.real()) then
        by $!stackdir ($!sign(($!loop1 - 1) * 50 + ($!loop1 - 1) * 10))
      else
        !prev = ($!seq - $!stacklen)
        var !xypos xypos of SLAB $!prev
        !stackdir = !stackdir.upcase()
        !stackdirPos = !xypos.after(|$!stackdir|).before(|$!stackPerDir|)
         if !stackdir.upcase().eq(|X|) then
            xypos x $!stackdirPos y $!ypos
         elseif !stackdir.upcase().eq(|Y|) then
            xypos x $!xpos y $!stackdirPos
         endif
      endif
      by $!stackPerDir ($!stackPerSign(($!line - 1) * 50 + ($!line - 1) * 10))
   enddo

-------------------------------------------------
-- Detail the LUGS ------------------------------
-------------------------------------------------
-- Navigate back to Sheet
  $!sheet

-- Use MDSOBJECT
  !mdsObject = !!mdsAbaSuppObj(!suppname.dbref())

-- Find whether Support is MDS Group or not
  if !mdsObject.mdsdata.mdsgroup then
    !suppmembers = !mdsObject.mdsdata.allgroupmem
  else
    !suppmembers = !mdsObject.mdsdata.members
  endif

-- Build Ancillary Array excluding SREF Atta
--  !suppmembersMod = ARRAY()
  !ancilAr = ARRAY()
  do !loop1 indices !suppmembers
    --if (!suppmembers[$!loop1].type.eq(|ATTA|) and !suppmembers[$!loop1].name.occurs(|SREF|).leq(0) and !suppmembers[$!loop1].cref.unset()) then
    if (!suppmembers[$!loop1].type.eq(|ATTA|) and !suppmembers[$!loop1].name.occurs(|SREF|).leq(0) ) then
      !ancilAr.append(|$!suppmembers[$!loop1]|)
    endif
  enddo

-- Evaluate SPRE of all Ancillary
   var !ancilsprear eval(spre) for all from !ancilAr

-- Find the Number of Lugs for each Ancillary
  do !loop2 indices !ancilAr
    !ancilname = !ancilAr[$!loop2].dbref().name
    !ancilPipe = !ancilAr[$!loop2].dbref().own.own.name
    var !lugs coll all OLET with matchw(name,'$!ancilname*') eq TRUE for $!ancilPipe

-- Delete the Ancil Entry from AncilAr if there are no Lugs
     if !lugs.size().eq(0) then
        !ancilAr.deletefrom(!loop2,1)
        !ancilsprear.deletefrom(!loop2,1)
     else
        do !loop2a indices !lugs
          !lugsAr[!loop2][$!loop2a] = !lugs[$!loop2a]
        enddo
     endif
  enddo

-- If an Ancillary is repeated, the Lug Detail should show only one Ancillary
   !ancilspreunq = !ancilsprear
   !ancilspreunq.sortunique()

-- Get the Position for the View
   var !viewPos xypos of last mem of $!sheet/DetailPlots/Plots
   handle(2,113)
      var !viewPos |x $!xpos y $!ypos|
      !line = |2|
    endhandle

-- Assumed that View2 will have Elevation
--  !mainViewName = |$!sheet/V2|
  !dllbName = |$!sheet/V2/IDLIST|
--  !pllbName = |$!sheet/V2/PLANES|
  !detailNo = 1

  do !loop3 indices !ancilspreunq

    --set a default !detailNum of 1 if !viewTagsDdnm.size() equals 0 otherwise use !viewTagsDdnm.size()
    if !viewTagsDdnm.size().eq(0) then
      !detailNo = 1
    else
      !detailNo = 0
    endif

   !ancilddnm = !ancilAr[!ancilsprear.findfirst(|$!ancilspreunq[$!loop3]|)]
   !viewDir = !ancilddnm.dbref().ldirection.string().before(|WRT|).trim()

-- Navigate to Last Member of LIBY & Create new DLLB
    $!dllbName last
    new DLLB $!sheet/Lugs$!loop3/IDLIST
     handle(41,12)
        delete dllb
        $!sheet/Lugs$!loop3/IDLIST
        delete dllb mem
        handle ANY
        endhandle
     endhandle

-- Create new ILDI & ADDE
    new IDLI $!sheet/Lugs$!loop3/IDLIST/IDLI
    !idliRef = !!ce
    new adde idna $!ancilddnm
    !arindx = !ancilsprear.findfirst(|$!ancilspreunq[$!loop3]|)
       do !loop4 indices !lugsAr[!arindx]
         new adde idna $!lugsAr[$!arindx][$!loop4]
       enddo
    $!sheet
    last mem
    New view $!sheet/Lugs$!loop3
     handle(41,12)
        delete view
        $!sheet/Lugs$!loop3
        delete view mem
        handle ANY
       endhandle
     endhandle

-- View Attributes
    !!ce.idln = !idliRef
    Size 50 50   Title |MDS ABA 3 Views - Lug Detail $!loop3|
    vtyp univ arctol 1 Rrsf /MDS-Detail-Ruleset(No-Insu) lfra TRUE
    dir $!viewDir
    vreg tl $!viewPos
    if !!ce.vreg[4].gt(!ypos.real() - (!stacklen.real() * 60)) then
       by $!stackdir ($!sign(($!loop3 - $!line + 1) * 50 + ($!loop3 - $!line + 1) * 10))
    else
       by $!stackPerDir ($!stackPerSign(($!loop3 - $!line) * 50 + ($!loop3 - $!line) * 10))
    endif
    auto
    update design

-- Create Layer & Angular Dimension
   new layer $!sheet/Lugs$!loop3/LugsDim

--------------------------------------------
--<wd>11apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--   nlpn 1 font 1 tpen 1 plpen 31 dlpen 41 llpen 1 dterm arrows tsize 3 chei 2
   nlstyle Solid
   nlcolour 1
   font 1
   txcolour 1
   plstyle Solid
   plcolour 4
   dlstyle Solid
   dlcolour 5
   llstyle Solid
   llcolour 1
   dterm arrows
   tsize 3
   chei 2
--<wd>11apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

   new adim ddnm $!ancilddnm nppt 1 sense anticlock
   !adim = !!ce
   new dppt ddnm $!lugsAr[$!arindx][1] nppt 3
   new dppt ddnm $!ancilddnm nppt 9
--   $P $!ancilddnm
   new dppt ddnm $!lugsAr[$!arindx][2] nppt 3
     handle ANY
      -- This means we have found a single lug for a hanger
       adim
       --delete adim
       !iamHere = layer
       view
       !thisView = !!ce
       goto idln
       add hang 1 of cref of $!ancilddnm
       !!ce = !thisView
--       !lug = $!lugsAr[$!arindx][1]
       !pcla = pcla 1 of hang 1 of cref of $!ancilddnm

       !allSheetMembers = !!ce.owne.memb
       do !sheetmember values !allSheetMembers
          skip if !sheetmember.type.neq('VIEW')
          skip if !sheetmember.spPurp.eq('USER')
          skip if !sheetmember.title.upcase().match('PLAN').gt(0).or(!sheetmember.title.upcase().match('MAIN').gt(0)).not()
          skip if !sheetmember.eq(!!ce)
          !angle = !!ce.dir.angle(!sheetmember.dir)
          if !angle.leq(5) then
             !!ce.adeg = !sheetmember.adeg
             break
          elseif !angle.geq(175) then
             !!ce.adeg = !sheetmember.adeg
             !viewDir = !!ce.dir.opposite().string().before('WRT')
             Dir  $!viewDir
             break
          endif
       enddo

       auto $!pcla
       thpos p0 of $!pcla
      -- We cannot auto the clamp because not all the clamp has a obst value, this is because the
-- clamp will clash with the pipe if it has. We need to calculate a scale using the p0 to p2
-- dist and increase it by 2 + 10%
       var !p0p2 pa od of $!pcla
       var !dist (($!p0p2 * 2) / 100 * 120)
       !size = size
       !scale = $!size[1] / $!dist
       vscale $!scale
       !p0pos = object LINE()
       !p0pos.startposition = p0 pos of $!pcla
       !p0pos.endposition = p2 pos of $!pcla
       !lengthOfLine = !p0pos.length()
       !proportion = !p0p2.real() / 2 / !lengthOfLine
       !midpoint = !p0pos.proportion($!proportion).string().before('WRT')
       thpos $!midpoint
       update design
       !!ce = !iamHere
     endhandle

   if (defined(!!hangAdim)) then
     !!ce = !adim
     delete adim mem
     copy $!!hangAdim
     view
     !scale = vsca
     same
     var !p0p2 pa od of $!pcla

     !!hangAdim.delete()
     laye
   endif

   !!ce = !adim
   adir 2
     handle ANY
       dppt 2
     endhandle
   var !dmtx expand dmtx
   if !dmtx.eq('180~0') then
     adim
     delete adim
   endif
   laye

    --<K.pleschner> June2005
   -- pipe symbol added
   !tdiam = lodiam of $!ancilddnm
   var !unit split unit
   if !unit[3].neq('MM') then
      !fmt = object FORMAT()
      !fmt.dp = 0
      !fmt.units = 'MM'
      !fmt.dimension = 'L'
      !tdiam = !tdiam.string(!fmt).real()
   endif
   new slab on $!ancilddnm

--------------------------------------------
--<wd>11apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--     lfpen template
     lfstyle template
     lfcolour template
--<wd>11apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

   oset true
   XYPO 0 0
   llead false
   tmrf /DRA/MAS/SYMBOLS/GEN/BREAKS/BB-1
   !scale = (!tdiam - 3) / 25.4 * vsca of view
   xysc $!scale $!scale

   new vnot
    !detailNo = !detailNo + !viewTagsDdnm.size()
   new texp |DETAIL $!detailNo| just cent align hbody chei 3 by y -30
    !viewTagsDdnm.append(|$!ancilddnm|)
   !viewtagstext.append(|$!detailNo|)
   if !loop3.eq(!ancilspreunq.size()) then
     new texp |Lugs - arrange according to FANP support catalogue| just cent align hbody chei 3 by y -5
     new texp |Lugs are part of the Isometric part list| just cent align hbody chei 3 by y -5
   endif
  enddo

-- Check to see of we have any repeated slabs
  $!sheet/DetailPlots/Plots
    handle ANY
    elsehandle NONE
      !plotlist = ARRAY()
      !slabname = ARRAY()
      !taglist = ARRAY()
      do !slabs from 1 to !!ce.mcount()
        slab $!slabs
          handle ANY
          elsehandle NONE
            !tmrfOfSlab = tmrf
            !atext = Atext
        !stripDetail = !atext.after(|\|)
        !taglist.append(!atext.before(|\|))
            !plotlist.append('$!tmrfOfSlab $!stripDetail')
            !slabname.append(!!ce)
          endhandle
      enddo
      !uniquePlotList = !plotlist
      !uniquePlotList.unique()
      !toDelete = ARRAY()
      !detailtag = '1'
      do !findhowmany values !uniquePlotList
        !find = !plotlist.find(!findhowmany)
        --!string = !plotlist[$!find[1]].split(' ')
        --!detailtag = !taglist[$!find[1]]
        if !find.size().gt(1) then
          do !add from 2 to !find.size()
            !toDelete.append(!find[$!add])
            !viewtagstext[!find[$!add]] = !detailtag
          enddo
        endif
        !refList = ARRAY()
        do !refs values !toDelete
          !refList.append(!slabname[$!refs])
        enddo
        !realTag = !detailtag.real() + 1
        !detailtag = !realTag.string()
      enddo
      do !delete values !refList
        !!ce = !delete
        delete slab
      enddo
      laye
      !from = ARRAY()
      !after = ARRAY()
      do !resettag from 1 to !!ce.mcount()
        slab $!resettag
      !from.append(!!ce.atext.before(|\|))
      !!ce.atext = !!ce.sequ.string() + |\| + !!ce.atext.after(|\|)
        !after.append(!!ce.sequ.string())
      enddo
      if defined(!refList) then
        if !refList.size().gt(0) then
          laye
          do !restack from 1 to !!ce.mcount()
            Slab $!restack
            at x $!params[1] y $!params[2]
--            do !move from 2 to $!restack
            do from 2 to $!restack
              if !params[3].eq('-Y') then
               by y -50
              by y -$!params[4]
            elseif !params[3].eq('-X') then
              by x -50
              by x -$!params[4]
            else
              by $!params[3] 50
              by $!params[3] $!params[4]
            endif
          enddo
        enddo
      endif
      endif
    endhandle

-- ***********************************************************
-- Need to finish this code to stop the details being repeated
-- ***********************************************************

-------------------------------------------------
-- Add detail text to each view and respread
-------------------------------------------------
  $!sheet
  var !mainViewList eval(name of View) for all task with (type of own eq 'LAYE') and pmlfunction eq 'mdsabaviewtask' for $!sheet

-- Collect Weld Tags Layer and turn visibility off for spreading
  var !weldTagsSlab coll all slab with matchw(name of layer,'*WeldTags_Task') eq TRUE for $!sheet
  do !loop indices !weldTagsSlab
    $!weldTagsSlab[$!loop]
    lvisi fals
  enddo

  do !loop1 indices !mainViewList
    $!mainViewList[$!loop1]/AncilTags_Task
      handle NONE
-- Delete any existing detail text
        !slabsToDelete = ARRAY()
        var !glabs coll all glab with matchw(btex,'SEE#/DETAIL*') eq true for ce
        do !loop3 indices !glabs
          $!glabs[$!loop3]
          delete glab
        enddo
        last mem
          handle ANY
          endhandle
      do !loop2 indices !viewTagsDdnm

--------------------------------------------
--<wd>11apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
          --new glab tpen 31 llpen 31 lterm arrows tsize 3 lfra fals
          new glab
          txcolour 4
          llpen 31
          llstyle Solid
          llcolour 4
          lterm arrows
          tsize 3
          lfra FALSE
--<wd>11apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

          btex |SEE#/DETAIL $!viewtagstext[$!loop2]|
          do !resettag from 1 to !from.size()
            if !viewtagstext[$!loop2].eq(!from[$!resettag]) then
              btex |SEE#/DETAIL $!after[$!resettag]|
            endif
          enddo
        ddnm $!viewTagsDdnm[$!loop2]
          if !!ce.ddnm.type.eq('HANG') then
             !!ce.nppt = 2
          elseif !!ce.ddnm.type.eq('PCLA') then
            -- put the label on p9
            !test = !!ce.ddnm.ppls
            !findtest = !test.findfirst(9)
            if !findtest.unset() then
              !!ce.nppt = 59
            else
              !!ce.nppt = 9
            endif
          endif

          !afterDetail = !!ce.btext.after('DETAIL ')
          var !coll coll all slab for $!sheet/DetailPlots/Plots
          do !loopthroughSlabs values !coll
          if !loopthroughSlabs.dbref().atext.before(|\|).eq(!afterDetail) then
              if !loopthroughSlabs.dbref().tmrf.func.eq('TYPICAL') then
                !slabsToDelete.append(!!ce)
              endif
            endif
          enddo
        enddo
        !slabsToDelete.unique()
        do !deleteSlabs values !slabsToDelete
          !!ce = !deleteSlabs
          delete glab
        enddo
        cont draw
        view
        !!mdsabaspreadtags()
          handle ANY
          endhandle
      elsehandle ANY
      endhandle
  enddo

-- Turn on visibility for Weld Tags Layer
  do !loop indices !weldTagsSlab
    $!weldTagsSlab[$!loop]
    lvisi TRUE
  enddo

-- Delete detail plots view if empty
  !!ce = $!sheet$n/DetailPlots/Plots
    handle NONE
      if !!ce.mcount.eq(0) then
        view
        delete view
          handle ANY
          endhandle
      endif
    elsehandle ANY
    endhandle

  !!ce = !ce

endfunction
