--
--
-- Description:
-- Function to update DPC plotfile
------------------------------------------------------------------------
------------------------------------------------------------------------

define function !!MdsDpcUpdate()

-- Check to see if dpcexe environment variable is set

-- <ab>>-24 feb 2006-savework required.
!answer = !!alert.confirm('This operation requires a Savework! OK to Savework?')
if (!answer.boolean()) then
  SAVEWORK
else
  !!alert.warning('DPC Plot file will not be updated. Aborting!')
  return
endif

  var !dpcexe evar dpcexe
  if !dpcexe.trim().length().eq(0) then
    !!alert.error('Unable to update DPC plot file as the dpcexe environment variable is unset')
    return
  endif

-- Check to see if the DPC update program dpcupdateplt exists in dpcexe area

  !file = object FILE('%dpcexe%/dpcupdateplt.exe')
  if !file.exists().not() then
    !!alert.error('Unable to update DPC plot file as the dpcupdateplt.exe program does not exist')
    return
  endif

-- Access sheet and check if its a mds sheet

  !ce = !!ce

  shee
    handle ANY
      !!alert.error('Unable to access sheet')
      return
    elsehandle NONE
      drwg
      if !!ce.func.neq('MDS') then
        !!alert.error('Selected sheet is not an MDS drawing. Aborting!')
        !!ce = !ce
        return
      else
        same
      endif
    endhandle

-- Save sheet

  !shee = !!ce

-- Get support name and type of support

  !linkref = !!ce.linkref.name.before('/S1')
  !supportName = '/' + !!ce.name.after('$!linkref-').before('-AREA')

  !!ce = !supportName.dbref()
    handle ANY
      !groupSupportName = !supportName + '[1]'
      !!ce = !groupSupportName.dbref()
        handle ANY
          !!alert.error('Unable to find support of MDS drawing. It may not exist. Aborting!')
          !!ce = !ce
          return
        endhandle
--<ab>>-23 Feb 2006 - following 2 statements added
    elsehandle none
      !groupSupportName = !supportName
    endhandle
  !supportType = !!ce.type

  !!ce = !shee
  warning off
  plot ce /%pdmsuser%/$!supportName$n.plt over
    handle ANY
      !!alert.error('Problem plotting sheet. Aborting!')
      !!ce = !ce
      warnings on
      return
    endhandle
  plot ce dxf /%pdmsuser%/$!supportName$n.dxf over
    handle ANY
      !!alert.error('Problem plotting dxf sheet. Aborting!')
      !!ce = !ce
      warnings on
      return
    endhandle

  warnings on

-- OK we have the sheet plotted send it to dpc

  var !projCode proj code
  var !mdb mdb
--
-- <ab>>-23 Feb 2006 - account for possibility of group support
  syscom '%dpcexe%/dpcupdateplt.exe -g $!projCode $!groupSupportName $!supportType /%pdmsuser%$!supportName$n.plt $!mdb'

-- return to element

  !!ce = !ce

endfunction
-------------- End Of Code --------------
