--<wd>mar2007<mds12>      if (!!SupportDef.Rtext[$!Index].Match(!Type).Neq(0)) then
--<wd>mar2007<mds12>        -- get the replacement/alias type
--<wd>mar2007<mds12>        !RType = !!SupportDef.Dtext[$!Index].Part(1)
--<wd>mar2007<mds12>        break
--<wd>mar2007<mds12>      endif
--<wd>mar2007<mds12>    enddo
--<wd>mar2007<mds12>
--<wd>mar2007<mds12>    -- see if we have found a matching type
--<wd>mar2007<mds12>    if (!RType.Neq('')) then
--<wd>mar2007<mds12>      Return !RType
