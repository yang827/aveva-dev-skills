--
-- File:		MdsGetAlias.pml
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		draft
--   Replaces:
--
-- Author:		S.Robinson
-- Created:		Friday 12th Dec
--
--
-- Description:
-- function to return alias name for passed support type
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R         STRING      Support/ancillary type e.g. AC01
-- Return:
--    [Data Type]   [Description]
--     STRING       Alias name as defined in DES-SUPP-DEFS file for passed support type
-----------------------------------------------------------------------------------------------

-- Define Function
define function !!mdsgetalias(!type is STRING) is STRING

-- When called with null string, then return null string
  if (!type.trim().eq('')) then
    return ''
  endif

---------------------------------------------------------------------------------------------------
--<wd>mar2007<mds12>
-- PML Code rewritten to extract DATA from the NEW PARAGON MDS DEFAULTS CATALOGUES
--
-- Determine what type of MDS Support has been passed, i.e.
-- ATTA      = AT01, AN01, BT01, GT01, ST01 etc...
-- HANGER    = FH01, VH01 etc...
-- STRUCTURE = FT09, CT01, DT01, GT05, VT01, SPECIAL etc...
-- TRUNNION  = TT04, TT36, TT37 etc...
--
  !catas = ARRAY()
  !catas.append(/MDS/ATTA/DEFAULTS )
  handle ANY
  endhandle
  !catas.append(/MDS/HANGER/DEFAULTS )
  handle ANY
  endhandle
--!catas.append(/MDS/LIGHTING/DEFAULTS )
--  handle ANY
--  endhandle
  !catas.append(/MDS/STRUCTURE/DEFAULTS )
  handle ANY
  endhandle
  !catas.append(/MDS/TRUNNION/DEFAULTS )
  handle ANY
  endhandle

-- Loop through the VALID PARAGON MDS DEFAULTS CATALOGUES
  do !indx indices !catas
-- Check if a DTSE exists for the passed MDS Support Type
    !mdstype = !type.upcase()
    !xstname = !catas[!indx].name & '/' & !mdstype
    !xstdtse = !xstname.dbref()
    handle NONE
-- Found an existing PARAGON MDS DEFAULT DTSE for the MDS Support Type
      !codestrg = !xstdtse.name & '/GEN/CODE'
--      $P **$!<codestrg>**
      !codedbrf = !codestrg.dbref()
      handle ANY
        skip
      elsehandle NONE
        !ccodstrg = !xstdtse.name & '/GEN/CCOD'
        !ccoddbrf = !ccodstrg.dbref()
        handle ANY
         skip
        elsehandle NONE
-- All the relevant PARAGON MDS DEFAULT DATA elements existso get the ALIAS for the passed MDS Support
          !ccod = $!ccoddbrf.pprop
-- When !ccod is BLANK then set !ccod to the passed string !type
          if (!ccod.trim().eq('')) then
          	!ccod = !type
          endif
-- Found the correct MDS Support Alias in the OPARAGON MDS DEAFULTS so BREAK the loop
          break
        endhandle
      endhandle
    elsehandle ANY
      skip
    endhandle
  enddo

-- When !ccod is UNDEFINED set !ccod to the passed string !type
  if (undefined(!ccod)) then
  	!ccod = !type
  endif

-- Return the !ccod value
  return !ccod
endfunction
--
--<wd>mar2007<mds12>
---------------------------------------------------------------------------------------------------
--
