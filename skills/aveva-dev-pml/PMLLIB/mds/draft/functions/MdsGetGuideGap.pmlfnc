--
-- Description:
-- Function find clearance for guides
--
----------------------------------------------------------------------
--
-- Arguments:
--
--    [#]   [R/RW]   [Data Type]   [Description]
--     1             dbref()       item to test clearance
-- Return:
--    [Data Type]   [Description]
--
----------------------------------------------------------------------


-- Define function
define function !!mdsgetguidegap(!item is dbref)is real

  !units = object COMUNITS(TRUE)
  units mm bore
  !size = !item.lbor.string().before('mm')
  !desc = !item.prop.desc
  !origdesc = !desc
  !clr = !item.prop.clr.real()

--=================================================================================================
--<wd>24may2007<mds12> -- START of Changes for a Ancillary Property "CLR" originally DERIVED from DES-SUPP-PARS at MDS11.6/11.5
-- The CODE below has been modified for the <MDS12> Development as the DES-SUPP-PARS file does NOT
-- exist at the MDS12 version.
-- At MDS12 Derive the Ancillary Property "CLR" from the new MDS DEFAULTS DATA element
--=================================================================================================

-- -- load des sup pars file and look for the item
-- -- Project Code & Session data
-- -- <GE> Oct 2006 Added extra code too use the project dflts not the mdsdflts
-- -- as this might not be set and it falls over in MDS ABA
--   !proj    = current project
--   !code    = !proj.code()
--   !projlow = !code.lowcase()
--   !file = object file('%$!<projlow>dflts%/des-supp-pars')
--   --!file = object file('%mdsdflts%/des-supp-pars')
--   !pars = !file.readfile(100000)

--   label /lookagain
--   -- loop through all
--   do !b values !pars
--     !csize = !b.split()[3]
--     handle any
--      skip
--     endhandle
--     if !b.UPCASE().match(!desc.UPCASE()).gt(0) and !csize.eq(!size) then
--       !line = !b
--       break
--     endif
--   enddo

--   if undefined(!line) then
--     if !desc.length().gt(4) then
--        -- remove the last character and try again
--        !desc = !desc.substring(1,!desc.length() - 1)
--        golabel /lookagain
--     endif
--     !!abaLogging.error('  ERROR - Problem with Checking Guide Clearance Item $!origdesc not found in DES-SUPP-PARS')
--     return 0
--   endif

-- Derive the Ancillary PROPERTY "CLR" from the MDS DEFAULTS DATA element for the Correct DESIGN PARAMETER
-- e.g. /MDS/ATTA/DEFAULTS/<mdsstandard>/<boresize>/DESPAR/<desparnumber>
--
-- Determine the DESPAR NUMBER which stores the PROPERTY value for the DKEY "CLR"
   !dpnum = !!mdsgetdesp('CLR')
   if (!dpnum.eq(0)) then
     !!abaLogging.error('  ERROR - The DATA property DKEY "CLR" for MDS Standard $!origdesc does NOT exist')
     return 0
   endif

-- Navigate to the DATA DESPAR element to see if it EXISTS
   !xce = !!ce
   /MDS/ATTA/DEFAULTS/$!<desc>/$!<size>/DESPAR/$!<dpnum>
   handle (2,109)
-- Undefined name /MDS/ATTA/DEFAULTS/$!<desc>/$!<size>/DESPAR/$!<dpnum>
     !!abaLogging.error('  ERROR - /MDS/ATTA/DEFAULTS/$!<desc>/$!<size>/DESPAR/$!<dpnum> for MDS Standard $!origdesc does NOT exist')
     return 0
   elsehandle NONE
-- Get the PROPERTY DKEY CLR value for the current ATTA
     !data   = /MDS/ATTA/DEFAULTS/$!<desc>/$!<size>/DESPAR/$!<dpnum>
     !!ce    = !xce
     !defclr = !data.pprop
     handle ANY
     elsehandle NONE
       if (!defclr.trim.eq('0')) then
         return 0
       endif
     endhandle
   endhandle
--=================================================================================================
--<wd>24may2007<mds12> -- END of Changes for an Ancillary Property "CLR" DERIVED from the new DEFAULTS DATA element
--=================================================================================================

   -- we have found the item in the file
   -- now check to see if the parameters are the same
   !current = !!ce
   !!ce = !item
     !despar = 3 + !!MdsGetDesp('CLR')
   !!ce = !current
   if !despar.eq(3) then
     return 0
   else

--<wd>24may2007<mds12>
--     !val = !line.split()[!despar].real()
     !val = !defclr
--<wd>24may2007<mds12>

     handle ANY
         return 0
     elsehandle NONE
       !difftest = abs(!clr - !val)
       if !difftest.neq(0) then
        return !clr
       else
        return 0
       endif
     endhandle
   endif

endfunction
