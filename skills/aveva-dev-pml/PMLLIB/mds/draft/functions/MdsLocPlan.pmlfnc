------------------------------------------------------------------------
--
-- File:            MdsLocPlan.pmlfnc
--   Type:          Function
--
-- Author:          Neale Morris
-- Created:         3 April 2005
--
-- Description:
-- Task to create a location plan
-- new view created
--

--------------------------------------------
--<wd>08apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--<wd>08apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

define function !!mdsLocPlan(!params is ARRAY)

-- Four parameters will be passed
-- Param 1 = top left x val
-- Param 2 = top left y val
-- Param 4 = X length
-- Param 4 = Y length

  !ce = !!ce

  shee
  !sheet = !!ce.name
--  var !units UNITS

-- Find support name
  !suppname = !!ce.darref.name.before('-AREA')

-- If the support does not exist it may be a group
  $!suppname
    handle NONE
    elsehandle ANY
      !suppname = '$!suppname[1]'
    endhandle

-- Return to SHEET
  $!sheet

  last mem
    handle ANY
    endhandle

  new view $!sheet/LocationPlan
    handle (41,12)
      delete view
      $!sheet/LocationPlan
      delete view mem
        handle ANY
        endhandle
    endhandle

-- View attributes
   size $!params[3] $!params[4] lfra fals Title |Location Plan|
   !xpos = !params[1]
   !ypos = !params[2]
   vreg tl x $!xpos y $!ypos
   dir d

-- Set local rule

   new rrul
   use /DRA/PRJ/STYL/CIVIL/NORMAL for ALL

   --<K.Pleschner> apr2005
   new hrul
   use /DRA/PRJ/HSTYL/Green30-4 for ALL FRMW
   view

-- get room from :FRA.ROOM_KKS of datum atta

   !roomref = :FRA.ROOM_KKS of $!suppname/DATUM
     handle any
       !roomref = :FRA.ROOM_KKS of $!suppname
         handle ANY
           view
           --delete view
          --return
        endhandle
     endhandle

   if defined(!roomref) then

     !roomref = !roomref.trim()
     if !roomref.match('/').neq(1) then
        !roomref = '/' + !roomref
     endif

-- Stefan Ellinger -- read proj dflts file for faster calc of keyplan Start
     !roomflag = FALSE
     var !proj proj code
     --<wd>23mar2010 - DFN P-29357 - At version 12 an EVAR may use a semi-colon instead of a space in an EVAR SEARCH PATH
     --!dir  = !proj + 'dflts'
     --var !evar evar $!dir
     !evarName = '$!<proj>DFLTS'
     !evarArray = !!evarSplit(!evarName)
     --!file = !evar.split()[2] + '\DRA-SUPP-ROOM'
     !file = !evarArray[2] + '\DRA-SUPP-ROOM'
     --<wd>23mar2010 - DFN P-29357 - At version 12 an EVAR may use a semi-colon instead of a space in an EVAR SEARCH PATH

     !roomfile = object FILE('$!file')
     !rooms = !roomfile.readfile()
     handle(160,9)
     elsehandle none
        do !room values !rooms
           if !room eq !roomref then
              !roomflag = true
           endif
        enddo
     endhandle
-- Stefan Ellinger -- read proj dflts file for faster calc of keyplan End


     !roomstruref = object DBREF(!roomref)
       handle ANY
             view
             delete view
             return
       endhandle

      !roomstru = !roomstruref.name

-- The room structure will be the first eight character of the !roomstru value
-- plus the ---B text

     !drawCivils = !roomstru.substring(1,8) + '---B'

-- Try to access room, if not then use the civil in !drawCivils value

     auto $!roomstru
      handle ANY
         auto $!drawCivils
           handle ANY
           endhandle
      endhandle

-- Need to decrease the scale by 20%

     !vscale = vscale
     !vscale = !vscale / 100 * 80
     vscale $!vscale

-- Stefan Ellinger -- if room is available in the roomdflts file, just show the room on the locplan Start
     if !roomflag then
        idln $!roomref
          handle ANY
          endhandle
     else
        idln $!drawCivils
          handle ANY
          endhandle
     endif
-- Stefan Ellinger -- if room is available in the roomdflts file, just show the room on the locplan End
   else
     auto $!suppname
       handle ANY
         vscale 0.05
       endhandle
     idln $!suppname
   endif
   new laye
   new vnot
   !vnot = !!ce

-- Create centreline of support and cross for position

   new stra

--------------------------------------------
--<wd>08apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--   nlpn 24
   nlstyle chain
   nlcolour 3
--<wd>08apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

-- if group hanger and STYP of datum is REST and owner of dataum atta same as hanger atta
-- use the hanger datum atta
-- dtf sep05
   !datum = !suppname & '/DATUM'
   !datum1 = !datum.dbref()
     handle ANY
     elsehandle NONE
       if !suppname.matchwild('*[1]') and !datum1.stype.eq('PIPE-REST') then
         !ownerdatum1 = !datum1.owner
         !datum2 = !datum1.name.replace('[1]', '[2]').replace('/DATUM', '').dbref()
           handle ANY
           elsehandle NONE
             !ownerdatum2 = !datum2.owner
             if !ownerdatum1.eq(!ownerdatum1) then
                -- set !datum to be datum2
                !datum = !datum2.name.string()
             endif
           endhandle
       endif
     endhandle

   !point = object POINTVECTOR()
   !point.position = pos of $!datum wrt /*
     handle ANY
       !point.position = pos of $!suppname wrt /*
     endhandle
   !point.direction = pl dir of $!datum wrt /*
     handle ANY
       !point.direction = pl dir of $!suppname wrt /*
     endhandle

   !startPoint = !point.offset(500mm)
   !endPoint = !point.offset(-500mm)

   fpt $!startPoint.position
   tpt $!endPoint.position

-- Need to draw an arrow showing the main view direction
-- This will be the direction of view 2

   !ce = !!ce
   shee
   view 2
    handle NONE
      !viewDir = dir
      !viewname = name
      !mainviewdir = !viewDir.string().before('WRT').trim()
      !!ce = !ce
      new slab llead FALSE ddnm $!suppname
      tmrf /MDS-Loc-Plan-Arrow
--          handle ANY
--          endhandle
      oset TRUE
      xyscale .5 1
      xypo 0 0
      !position = (pos of $!suppname )
      pos $!position
      !defDir = N
      !viewDir = !mainviewdir.direction()
      !sign = ''
      if !viewDir.string().before('WRT').match('E').gt(0) or !viewDir.string().before('WRT').match('X').gt(0) then
        !sign = '-'
      endif
      !angle = !defDir.angle(!mainviewdir.direction())
      adeg $!sign$!angle
      --new stra copy prev
      by $!mainviewdir -200mm
      --nlpn 201
      $!viewname/MDS_Title
      texp 1 of vnot 1
      !btex = btex
      !!ce = !ce
      --nex
      new texp btex '$!btex'
      chei 2
      by $!mainviewdir -300mm
      just c
    elsehandle ANY
    endhandle

   new stra

--------------------------------------------
--<wd>08apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--    nlpn 21
   nlstyle solid
   nlcolour 3
--<wd>08apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

   tcod mid
   at $!datum
     handle ANY
       at $!suppname
     endhandle
   length 4
   adeg 45

   new stra copy prev
   adeg -45

-- Create room text

   new texp
   chei 3
   !btex = 'Room No. ' + !roomstru.after('/')
     handle ANY
       !btex = 'Room No. unset'
     endhandle
   btex '$!btex'
   at x $!params[1] y $!params[2]
   BY y -$!params[4]
   by y -5

-- Create floor elevation text
   new texp
   copy prev
   !volSubs = !roomstru.string() + '/X/SOL'
     handle NONE
       !pos = pos of cyli 1 of $!volSubs wrt /*
         handle NONE
           -- <K.Pleschner>april 2005
           -- elevation needs to be rounded so that value is snaped to nearest "0" or "5"
           !up = !pos.up.nint()
              if !up.lt(0) then
                 !plusMinus = -1
              else
                 !plusMinus = 1
              endif
           !up = !up * !plusMinus
           !lastDigit = !up.string('d0').substring(-1,1).real()
              if !lastDigit.between(0,2) then
                 !up = !up - !lastDigit
              elseif !lastDigit.between(3,7) then
                  !up = !up - !lastDigit + 5
              else
                  !up = !up - !lastDigit + 10
              endif
           !up = !up * !plusMinus
           !floorLevel = !up.string()

         elsehandle ANY
           !floorLevel = 'Unset'
         endhandle
     elsehandle ANY
       !floorLevel = 'unset'
     endhandle

   btex 'Floor Elevation = $!floorLevel'
   by x 60

-- Create section plane 2000m above floor elevation

   view
   !view = !!ce

   drwg
   !drwg = name
   liby 1
   last mem
     handle ANY
     endhandle

   new pllb $!drwg/LocPlan/PLANES
     handle NONE
     elsehandle ANY
       $!drwg/LocPlan/PLANES
     endhandle

   new fpla $!drwg/LocPlan/spla1
     handle NONE
     elsehandle ANY
       $!drwg/LocPlan/spla1
     endhandle

   !!ce.pos = !pos
     handle ANY
       pllb
       delete pllb
     elsehandle NONE
       by u 2000mm
       normal d
       !plane = !!ce
       !!ce = !view
       new vsec
       plrf $!plane
--       <K.Pleschner> apr2005
--       pmode rev
       pmode standard
     endhandle

    !!ce = !view
    vtype univ
    update design
      handle any
      endhandle
-- Add a north arrow

    !!ce = !vnot
    new slab
    tmrf /Aba/north_arrow
    ddnm $!suppname
    xypo 0 0
    llead FALSE
   -- Param 1 = top left x val
-- Param 2 = top left y val
-- Param 4 = X length
-- Param 4 = Y length
    oset FALSE
    xypo $!params[1] $!params[2]

-- Add location dimensions

  $!datum
    handle ANY
      $!suppname
    endhandle
  !dimtobenches = !!ce.:MdsBenches
  cont draw

  !dIMBench1 = FALSE
  !dIMBench2 = FALSE
  !dIMGrid = FALSE

  if !dimtobenches.size().neq(0) then
  -- see if local benchmark FM or BM
    do !i values !dimtobenches
      if !i.name.match('FM').gt(0) then
       !dIMGrid = TRUE
       !dIMBench1 = TRUE
      elseif !i.name.match('BM').gt(0) then
       !dIMGrid = FALSE
       !dIMBench1 = TRUE
      endif
    enddo

  else
    !dIMGrid = TRUE

  endif

  --if !dimtobenches.size().eq(0) then
  if !dIMGrid then
-- Collect all X/Y grids
    var !xgrids coll all sctn with gtyp eq 'XGRD' and purp of stru eq 'GRID'
    var !ygrids coll all sctn with gtyp eq 'YGRD' and purp of stru eq 'GRID'
    if !xgrids.size().neq(0) then
-- Find nearest x grid line
      !xVector = object POINTVECTOR()
      !xVector.position = pos of $!datum wrt /*
        handle ANY
          !xVector.position = pos of $!suppname wrt /*
        endhandle
      !xVector.direction = e wrt /*
      !testline = object LINE()
      !line = object LINE()
      !line.startPosition = !xVector.position.wrt(/* )
      !xvaltonearest = 100000
      !xdbref = object DBREF()
      do !loopThroX values !xgrids
        !testline.startPosition = !loopThroX.dbref().poss.wrt(/* )
        !testline.endPosition   = !loopThroX.dbref().pose.wrt(/* )
        !line.endPosition = !xVector.intersection(!testline)
        !line.startPosition.up = !line.endPosition.up
        !distanceToLine = !line.length()
        if !distanceToLine.lt(!xvaltonearest) then
          !xvaltonearest = !distanceToLine
          !xdbref = !loopThroX.dbref()
        endif
      enddo

-- Find nearest y grid line
      !yVector = object POINTVECTOR()
      !yVector.position = pos of $!datum wrt /*
        handle ANY
          !yVector.position = pos of $!suppname wrt /*
        endhandle
      !yVector.direction = n wrt /*
      !testline = object LINE()
      !line = object LINE()
      !line.startPosition = !yVector.position.wrt(/* )
      !yvaltonearest = 100000
      !ydbref = object DBREF()
      do !loopThroY values !ygrids
        !testline.startPosition = !loopThroY.dbref().poss.wrt(/* )
        !testline.endPosition   = !loopThroY.dbref().pose.wrt(/* )
        !line.endPosition = !yVector.intersection(!testline)
        !line.startPosition.up = !line.endPosition.up
        !distanceToLine = !line.length()
        if !distanceToLine.lt(!yvaltonearest) then
          !yvaltonearest = !distanceToLine
          !ydbref = !loopThroY.dbref()
        endif
      enddo

-- Add X dimension

--------------------------------------------
--<wd>08apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--      new ldim dir e plpn 4 dtch 3
      new ldim
      dir e
      plstyle chain
      plcolour 1
      dtch 3
--<wd>08apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

      from $!datum to $!xdbref
        handle ANY
          from $!suppname to $!xdbref
            handle ANY
              delete ldim
            endhandle
        endhandle
      if !!ce.type.eq('DPPT') then
        ldim
        doff 20 dtch 3
        dppt 1
        var !ddnm1y ddnm y
        dppt 2
        var !ddnm2y ddnm y
        var !plcl (abs($!ddnm2y - $!ddnm1y - 20))
        plcl $!plcl osht 0
      endif

-- Add Y dimension

--------------------------------------------
--<wd>08apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--      new ldim dir e plpn 4 dtch 3
      new ldim
      dir e
      plstyle chain
      plcolour 1
      dtch 3
--<wd>08apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

      from $!datum to $!ydbref
        handle ANY
          from $!suppname to $!ydbref
            handle ANY
              delete ldim
            endhandle
        endhandle
      if !!ce.type.eq('DPPT') then
        ldim
        doff 20 dtch 3
        dppt 1
        var !ddnm1x ddnm x
        dppt 2
        var !ddnm2x ddnm x
        var !plcl (abs($!ddnm1x - $!ddnm2x - 20))
        plcl $!plcl osht 0
      endif

-- X balloon
      new slab ddnm $!xdbref
      atex (desc of $!xdbref )
      tmrf /MDS/ABA/TAGS/CIRCLE/2
      xypo 0 0
      spread remote omit left right bottom norot margin 5
      llead FALSE
      oset FALSE
      !xypo = xypo
      lock
      !xslab = !!ce
      new vnot

--------------------------------------------
--<wd>08apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--      new stra nlpn 4
      new stra
      nlstyle chain
      nlcolour 1
--<wd>08apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

      fpt x $!xypo.east y $!xypo.north
      view
      !viewXypo = xypo
      !viewSize = size
      same
      !tpty = !xypo.north - !viewSize[2]
      tpt x $!xypo.east y $!tpty

-- Y balloon
      !!ce = !xslab
      new slab ddnm $!ydbref
      !yslab = !!ce
      tmrf /MDS/ABA/TAGS/CIRCLE/2
      atex (desc of $!ydbref )
      xypo 0 0
      spread remote omit right bottom top norot margin 5
      llead FALSE
      oset FALSE
      !xypo = xypo
      prev
      unlock
      next
      new vnot
      new stra nlpn 4
      fpt x $!xypo.east y $!xypo.north
      view
      !viewXypo = xypo
      !viewSize = size
      same
      !tptx = !xypo.east + !viewSize[1]
      tpt x $!tptx y $!xypo.north
      !!ce = !xslab
      by y 5
      !!ce = !yslab
      oset TRUE
      by x-5
    endif
  endif
  if !dimtobenches.size().eq(1) then
-- Dimension to benchmark using [1] as east and north
    new ldim dir e
    from $!datum to $!dimtobenches[1]
      handle ANY
        from $!suppname to $!dimtobenches[1]
      endhandle
    doff 14 dtch 3
    new ldim dir n
    doff 14 dtch 3
    from $!datum to $!dimtobenches[1]
      handle ANY
        from $!suppname to $!dimtobenches[1]
      endhandle
    -- dtf >>> mod to remove label on some types
    if !dimtobenches[1].name.match('FM').gt(0) then
      -- no label required
    else
      new glab ddnm $!dimtobenches[1] btex '#NAMN' chei 3
      just right
      Xyposition -25mm 25mm
      !!ce = !vnot
      new symb
      tmrf /mds_aba_support_location_bm
      at $!dimtobenches[1]
    endif



  elseif !dimtobenches.size().eq(2) then
-- Dimension to benchmark using [1] as east and [2] as north
    new ldim dir e
    from $!datum to $!dimtobenches[1]
      handle ANY
        from $!suppname to $!dimtobenches[1]
      endhandle
    doff 14 dtch 3
    new ldim dir n
    from $!datum to $!dimtobenches[2]
      handle ANY
        from $!suppname to $!dimtobenches[2]
      endhandle
    doff 14 dtch 3
    -- dtf >>> mod to remove label on some types
    if !dimtobenches[1].name.match('FM').gt(0) then
      -- no label required
    else
      if ('$!dimtobenches[1]' eq '$!dimtobenches[2]') then
        new glab ddnm $!dimtobenches[1] btex '#NAMN' chei 3
      else
        new glab ddnm $!dimtobenches[1] btex '#NAMN' chei 3
        new glab ddnm $!dimtobenches[2] btex '#NAMN' chei 3
      endif
      !!ce = !vnot
      new symb
      tmrf /mds_aba_support_location_bm
      at $!dimtobenches[1]
      new symb
      tmrf /mds_aba_support_location_bm
      at $!dimtobenches[2]
    endif

  endif

endfunction
