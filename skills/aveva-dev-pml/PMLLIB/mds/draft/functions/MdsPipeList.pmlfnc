------------------------------------------------------------------------
--
-- File:            MdsPipeList.pmlfnc
--   Type:          Function
--
-- Author:          Anil Kumar
-- Created:         16 February 2005
--
-- Description:
-- Basic Task to create Pipe List table
-- Table is created using SLAB which will be stored below the
-- new view created
------------------------------------------------------------------------
define function !!MdsPipeList(!params is array)

  !ce = !!ce

  shee
  !sheet = !!ce.name
  !units = object COMUNITS(TRUE)

-- Find support name
  !SuppName = !!ce.darref.name.before('-AREA')

-- If the support does not exist it may be a group
  $!SuppName
    handle NONE
    elsehandle ANY
      !SuppName = '$!SuppName[1]'
    endhandle

-- Return to SHEET
  $!sheet

  last mem
    handle ANY
    endhandle

  new view $!Sheet/PipeList
    handle (41,12)
      delete view
      $!Sheet/PipeList
      delete view mem
        handle ANY
        endhandle
    endhandle

-- View attributes
  size 130 130 lfra fals Title |MDS ABA 3 Views - Pipe List|
  !xpos = !params[1]
  !ypos = !params[2]
  vreg tl x $!xpos y $!ypos

  new laye $!Sheet/PipeList/Header
  !EleType = Type of $!SuppName/DATUM
    handle(2,109)
      !EleType = Type of $!SuppName
    endhandle

  if (!EleType.eq(|ATTA|)) then
    !HeaderDdna = Name of $!SuppName/DATUM
      handle(2,109)
        !HeaderDdna = Name of $!SuppName
      endhandle
  else
    !HeaderDdna = Name of $!SuppName
  endif

-- Create Header
  new slab ddna $!HeaderDdna Tmrf $!params[3]
  oset FALSE llead fals lfpen template
  xypos $!params[1] $!params[2]
  var 1 name

-- Create Layer for Entries
  new laye $!Sheet/PipeList/Entry

-- Use MDSOBJECT
  !MdsObject = !!MdsAbaSuppObj(!SuppName.dbref())

-- Find whether Support is MDS Group or not
  if !MdsObject.Mdsdata.Mdsgroup then
    !NoOfPipes = !MdsObject.Mdsdata.Allgroupmem
  else
    !NoOfPipes = !MdsObject.Mdsdata.Members
  endif


$(
!SeqAr is ARRAY
!AtexAr is ARRAY
!DDnaAr is ARRAY
!count = 1

-- Create Table Entries
  do !LoopThrough indices !NoOfPipes
    if(!NoOfPipes[$!LoopThrough].Type.eq(|STRU|) or !NoOfPipes[$!LoopThrough].Type.eq(|FITT|) or !NoOfPipes[$!LoopThrough].Type.eq(|REST|))then
      skip
    elseif(!NoOfPipes[$!LoopThrough].Type.eq(|ATTA|) and !NoOfPipes[$!LoopThrough].name.occurs(|SREF|).gt(0)) then
      skip
    elseif(!NoOfPipes[$!LoopThrough].Type.eq(|ATTA|) and !NoOfPipes[$!LoopThrough].styp.eq('PIPE-REST')) then
      skip
    elseif(!NoOfPipes[$!LoopThrough].Type.eq(|SBFI|)) then
      skip
    else
      new slab copy $v1
      !seq = sequence
      by y (-10 * $!seq)

-- For Safety & Quality Class of PIPE Duty & Function attributes
-- are used.  Replace with UDA when available
      !Field2 = namn of owner of owner of $!NoOfPipes[$!LoopThrough]
      !Field3 = :FRA.QCL of owner of owner of $!NoOfPipes[$!LoopThrough]
        handle(99,532)
          !Field3 = Func of owner of owner of $!NoOfPipes[$!LoopThrough]
          if !Field3.empty() then
            !Field3 = | |
          endif
        endhandle
      !Field4 = :FRA.SCL of owner of owner of $!NoOfPipes[$!LoopThrough]
        handle(99,532)
          !Field4 = Duty of owner of owner of $!NoOfPipes[$!LoopThrough]
          if !Field4.empty() then
            !Field4 = | |
          endif
        endhandle
      !Bore = Bore of owner of owner of $!NoOfPipes[$!LoopThrough]
      !Field5 = !Bore.string().before(|mm|).before(|in|)
      !Field6 = :MDSSuppFunc of $!NoOfPipes[$!LoopThrough]
      if !Field6.empty() then
        !Field6 = | |
      endif
      !field7 = :MdsNodeNo of $!NoOfPipes[$!LoopThrough]
      if !Field7.eq('unset') then
        !Field7 = | |
      endif
      -- !field8 = :MDSCalcNo of $!NoOfPipes[$!LoopThrough]
      !field8 = :FRA.SSNO of owner of owner of $!NoOfPipes[$!LoopThrough]
        handle ANY
          !Field8 = 'unset'
        endhandle
      if !Field8.eq('unset') then
        !Field8 = | |
      endif
      !SlNo  = !!ce.sequence
      atex '$!SlNo\$!Field2\$!Field3\$!Field4\$!Field5\$!Field6\$!Field7\$!Field8'
      !atex = '$!count\$!Field2\$!Field3\$!Field4\$!Field5\$!Field6\$!Field7\$!Field8'
      Tmrf $!params[4]
      ddna $!NoOfPipes[$!LoopThrough]

    endif

    !SeqAr.append(!count)
    !AtexAr.append(!atex)
    !DDnaAr.append('$!NoOfPipes[$!LoopThrough]')
    !count = !count + 1
  enddo
$)


-- dtf 28.10.05 mod to get function to obtain design data so it can also be called from design

  !return = !!mdsgetpipelistdata(!NoOfPipes)

  !seqAr = !return[1]
  !AtexAr = !return[2]
  !ddnaAr = !return[3]
  !atex = ||

  do !I values !seqAr
      new slab copy $v1
      !seq = !I
      by y (-10 * $!seq)
      atex |$!AtexAr[$!I]|
      Tmrf $!params[4]
      ddna $!ddnaAr[$!I]
  enddo

-- dtf end of mod

  !paramstopass = !params[5]
  !sheetref = !sheet.dbref()
  !!MdsAbaPipetags(!sheetref,!paramstopass )

-- Add check text if status is lt 70% for Framatome

  --<K.Pleschner> May 2005
  -- instant value of status if UDA is not present
  !Status = '100'

  !Status = :MMSStatus of $!SuppName
    handle ANY
      !Status = :Status of $!SuppName
         handle ANY
         endhandle
    endhandle
  if !status.eq('') or !Status.eq('unset') then
    !Status = '0'
  endif
  !Status = !Status.before('#')
  if !Status.real().lt(70) then
    !!ce = !sheetref
    !NameOfSheet = !!ce.name
    $!NameOfSheet/PipeList/Entry
    last mem
      handle ANY
      endhandle
--    new glab 'DRAFT' chei 30mm ddnm $!SuppName lframe FALSE llead FALSE cspac .2
      new glab 'DRAFT' chei 27mm ddnm $!SuppName lframe FALSE llead FALSE cspac .075
    oset FALSE
    var !xypo (xypo of prev)
    handle ANY
      var !xypo (xypo of slab 1 of $!NameOfSheet/PipeList/Header )
    endhandle
    xypo $!xypo
    by y -60 x 4.5
  endif
--q var !noofpipes
  !glab = !!ce
  !CollHele =  ARRAY()
  do !I values !NoOfPipes
    if !i.type.eq('REST') then
      var !CollHele append coll all hele for $!I
    endif
  enddo
  --  var !CollHele append coll all hele for $!SuppName/REST
    --handle NONE
      do !CheckHele from 1 to !CollHele.size()
        if !CollHele[$!CheckHele].dbref().dtxr.upcase().match('RIGID STRUT').gt(0) then
          !Despars = !CollHele[$!CheckHele].dbref().despar
          !DesPars.invert()
          if !DesPars[1].real().gt(2) or !DesPars[1].real().lt(-2) then
            !!ce = !glab
            new glab copy prev by x 4mm y -10mm btex 'CHECK RIGID STRUT!' chei 8mm
            handle ANY
              !!ce = !sheetref
              !NameOfSheet = !!ce.name
              $!NameOfSheet/PipeList/Entry
              last mem
              handle ANY
              endhandle

              new glab 'CHECK RIGID STRUT!' chei 8mm ddnm $!SuppName lframe FALSE llead FALSE cspac .075
              oset FALSE
              var !xypo (xypo of prev)
              handle ANY
                var !xypo (xypo of slab 1 of $!NameOfSheet/PipeList/Header )
              endhandle
              xypo $!xypo
              by y -30 x 4.5
            endhandle
            break
          endif
        endif
      enddo
    --elsehandle ANY
    --endhandle

  !!ce = !ce

endfunction

-------------- End Of Code --------------
