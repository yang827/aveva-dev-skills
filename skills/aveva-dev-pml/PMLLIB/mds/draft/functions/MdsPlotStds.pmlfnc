  !SheetName = Array()
  !PlotFileName = Array()

  do !Count from 1 to  !Sheets.size()

    if !Names[$!Count].eq('') then
      !SheetName.append('/MDS-Standards-$!Sheets[$!Count]-1')
      !PlotFileName.append('/MDS-Standards-$!Sheets[$!Count]-1.plt')
    else
      !Split = !Names[$!Count].split(',')
      do !Prefix values !Split
        !SheetName.append('/MDS-Standards-$!Sheets[$!Count]-1')
        !PlotFileName.append('/MDS-Standards-$!Sheets[$!Count]$!Prefix-1.plt')
      enddo
    endif

  enddo

  do !plot from 1 to !SheetName.size()

    !!ce = !Sheetname[$!plot].dbref()
      handle any
        $P Cannot find $!SheetName[$!plot]
        skip
      endhandle
      plot ce /%PDMSUI%/DES/MDS/PLOT/$!PlotFilename[$!Plot] over
  enddo


