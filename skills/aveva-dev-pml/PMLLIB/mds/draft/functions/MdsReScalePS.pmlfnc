--
--
-- Description:
-- Function to rescale the pipe symbols after a change in view scale
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Define Function

define function !!MDSRescalePS()

-- Save current DB position

  !ce = !!ce

-- Find view user wants to rescale

  !View = object dbref()

  view
    handle NONE
      !View = ref
    elsehandle ANY
      prompt off
      prompt load escape 'Identify view to rescale pipe symbols'
      !View = ref of id VIEW @
        handle ANY
          !View = nulref
        endhandle
     endhandle

   if !View.badref() then
     return
   endif

   var !slabs coll all slab with tmrf eq /DRA/MAS/SYMBOLS/GEN/BREAKS/BB-1 for ce
--<wd>jun2007<mds12>
   var !slabs append coll all slab with tmrf eq  /MDS/ABA/TAGS/BREAK/PIPE for ce
   handle ANY
   endhandle
--<wd>jun2007<mds12>
   do !Rescale values !slabs
     !!ce = !Rescale.dbref()
     !bore = PL OD of ddnm
     !vsca = vsca of view
     var !scale (($!bore - 3) / 25.4 * $!vsca)
     xyscale $!scale $!scale
   enddo

   !!ce = !ce

endfunction
-- End of Function - !!MDSRescalePS.pmlfnc
