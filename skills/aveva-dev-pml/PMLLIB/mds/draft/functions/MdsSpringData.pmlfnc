--
-- File:            MdsSpringData.pmlfnc
--   Type:          Function
--
-- Author:          Neale Morris
-- Created:         3 April 2005
--
-- Description:
-- Task to create a spring data label on a MDS ABA drawing
-- that contains hanger springs
------------------------------------------------------------------------

define function !!MdsSpringData(!params is array)

-- Param 1 - Top Left X
-- Param 2 - Top Left Y
-- Param 3 - Symbol Name

  !ce = !!ce

  shee
  !sheet = !!ce.name

-- Find support name
  !SuppName = !!ce.darref.name.before('-AREA')

-- If the support does not exist it may be a group
  $!SuppName
    handle NONE
      !Group = FALSE
    elsehandle ANY
      !SuppName = '$!SuppName[1]'
      !Group = TRUE
    endhandle

-- Return to SHEET
  $!sheet

  last mem
    handle ANY
    endhandle

  new view $!Sheet/SpringData
    handle (41,12)
      delete view
      $!Sheet/SpringData
      delete view mem
        handle ANY
        endhandle
    endhandle

  !View = !!ce
  !Viewname = name

-- View attributes
  size 100 100 lfra fals Title |MDS Spring Data|
  !xpos = !params[1]
  !ypos = !params[2]
  vreg br x $!xpos y $!ypos

  new laye $!Sheet/SpringData/Layer
  !laye = !!ce

-- Find out if support contains any hangers

  !HangMem = ARRAY()

  if !Group.not() then
    !!ce = !SuppName.dbref()
    !Test = !!ce.cref
      handle NONE
        if !!ce.cref.badref().not() then
          if !!ce.cref.type.eq('HANG') then
            goto cref
            rest
            var !HangMem append coll all hang mem for ce
          endif
        endif
      elsehandle ANY
      endhandle
  else
    !StripArrayFromName = !SuppName.before('[')
    do !LoopThroughGroup from 2 to 20
      $!StripArrayFromName[$!LoopThroughGroup]
        handle ANY
        elsehandle NONE
          if !!ce.cref.badref().not() then
            if !!ce.cref.type.eq('HANG') then
              goto cref
              rest
              var !HangMem append coll all hang mem for ce
            endif
          endif
        endhandle
    enddo
  endif


  !springs = !!mdslisegaspring(!hangmem)

-- If we have found any springs then the !Springs variable will be gt 0
-- If 0 delete view and return
  --if !Springs.size().eq(0) then
    --!!ce = !View
    --delete view
    --return
  --else
    do !Loops values !Springs
      !Rate = :Ustsprrate of rest of $!Loops
      !Load = :Uststatload of rest of $!Loops
      !RestName = name of rest of $!Loops
      var !PosNumSlab coll all slab with ref of ddnm eq $!Loops for $!sheet/PartsList/Entry
      !PosNum = !PosNumSlab[1].dbref().atext.before('\')
        handle ANY
          skip
        endhandle
      !!ce = !Laye
      last mem
        handle ANY
        endhandle
      new slab $!ViewName$!RestName
        handle NONE
          tmrf $!Params[3] ddnm $!Loops atext '$!PosNum\$!Rate N/mm\$!Load kN'
          llea FALSE
          at x $!params[1] y $!params[2]
          !Seq = seq
          if !Seq.neq(1) then
            do !Move from 1 to (!Seq - 1)
              by $!Params[4] $!Params[5]
            enddo
          endif
        elsehandle ANY
          delete slab
          $!ViewName$!RestName
          !Atext = atext
          !AtextSplit = !Atext.split('\')
          atext '$!AtextSplit[1],$!PosNum\$!AtextSplit[2]\$!AtextSplit[3]'
        endhandle
    enddo
  --endif

  !!ce = !laye
  var !slabs coll all slab for ce
  if !Slabs.size().gt(0) then
    do !LoopForOffsets values !slabs
      !!ce = !LoopForOffsets.dbref()
      !Restname = name of rest of ddnm
      !Offsets = :Usthngoffset of rest of ddnm
      if !Offsets[1].eq(0) and !Offsets[2].eq(0) then
        skip
      else
        oset FALSE
        !Xypo = xypo
        new slab $!ViewName$!RestName/OFFSETS
        tmrf $!Params[3]/OFFSETS ddnm ddnm of prev atext '$!Offsets[1]mm\$!Offsets[2]mm'
        llea FALSE
        at x $!Xypo.east y $!xypo.north
      endif
    enddo
  else
    var !rests eval rest for all from !Hangmem
    !rests.unique()
    do !LoopForOffsets values !rests
      !!ce = !LoopForOffsets.dbref()
      !Restname = !!ce.name
      !Offsets = :Usthngoffset
      if !Offsets[1].eq(0) and !Offsets[2].eq(0) then
        skip
      else
        !!ce = !Laye
        last mem
          handle ANY
          endhandle
        new slab $!ViewName$!RestName/OFFSETS
        tmrf $!Params[3]/OFFSETS ddnm $!RestName atext '$!Offsets[1]mm\$!Offsets[2]mm'
        llea FALSE
        llea FALSE
        at x $!params[1] y $!params[2]
        !Seq = seq
        if !Seq.neq(1) then
          do !Move from 1 to (!Seq - 1)
            by $!Params[4] $!Params[5]
          enddo
        endif
      endif
    enddo
  endif

-- Delete view if not needed

  !!ce = $!Sheet$n/SpringData/Layer
    handle NONE
      if !!ce.mcount.eq(0) then
        view
        delete view
          handle ANY
          endhandle
      endif
    elsehandle ANY
    endhandle

  !!ce = !ce

endfunction

-------------- End Of Code --------------
