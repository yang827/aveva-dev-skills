------------------------------------------------------------------------
--
-- File:            MdsTitleBlock.pmlfnc
--   Type:          Function
--
-- Author:          Anil Kumar
-- Created:         14 Feb 2005
--
-- Description:
-- Basic task to create title block information
-- This relies on texp elements being created in the template
-- These will be stored a note element called (template name)/TITLEBLOCK
------------------------------------------------------------------------
-- Keywords may be used in the texp btex attribute, these may be
-- !suppName
-- !scale
-- i.e btex '!scale' will be replaced with 1/10
-- A function may also be called to generate the text value.
-- i.e !!mdsFraGetText(!suppName,'keyword')

define function !!mdsTitleBlock(!params is ARRAY)

  !sheet = !!ce
  Prec 2 dp
  !units = object COMUNITS(TRUE)

  -- Set UNITS to metric for making task work when in imperial.

  UNITS MM Bore
  UNITS MM Distance

  -- Navigate to SHEE

  SHEE
  GOTO DARREF
  var !suppName NAME
  !suppName = !suppName.substring(1,!suppName.match(|-AREA|) - 1)

  -- If the support does not exist it may be a group
  $!suppName
  handle NONE
  elsehandle ANY
    !suppName = '$!suppName[1]'
  endhandle

  -- Return to SHEET
  $!sheet
  !!ce = !sheet

  -- Create the note to hold the title block info

  NEW NOTE
  !name = NAME OF OWNER
  NAME $!name/TitleBlock
  handle (41,12)
    DELETE NOTE
    $!name/TitleBlock
    DELETE NOTE
    NEW NOTE
    NAME $!name/TitleBlock
  endhandle

  -- Access texp note in template

  !linkRefName = name of linkref of shee

  !nameOfNote = !linkRefName + '/TITLEPOS'

  !noOfTexp = mcount of $!nameOfNote
  handle ANY
    !!abalogging.error('    **** Cannot locate texp $!linkRefName/TITLEPOS element for title block - Aborting Title Block Task (MdsTitleBlock) ****')
    !!ce = !sheet
    return
  elsehandle NONE
  endhandle

  do !loopThroughTexp from 1 to !noOfTexp
    -- Get text num
    !texpName = name of $!loopThroughTexp of $!nameOfNote
    !texpNum = !texpName.after(|$!nameOfNote|).after(|/|)
    new texp copy $!nameOfNote/$!texpNum
    !btex = btex
    !ref = ref of $!suppName
    if (!btex.occurs(|!!|)gt 0) then
      !btex = !btex.replace(|!suppName|,|$!ref|)
      call $!btex

      -- Get the View Scale as Ratio from !!abauserview

    elseif(!btex.eq(|!scale|))then


      -- <K.pleschner> April 2005
      -- check if there is overridden scale and use if so
      !scale = STRING()
      if defined (!!putBackScale) then
        do !c indices !!putBackScale
          if !!putBackScale[!c][1].eq(!sheet.name) then
            if !!putBackScale[!c][2].real().neq(0) then
              !scale = !!putBackScale[!c][2]
              break
            endif
          endif
        enddo
      endif

      if !scale.unset() then
        -- Collect scale of last view on sheet.
        -- var !views COLL ALL VIEW with not(matchw(title,'*Pipe List')) FOR SHEET
        var !views COLL ALL VIEW with sppurp eq 'ABAT' FOR SHEET
        -- Grab the last view scale, but not if its a isometric view

        if !views[!views.size()].dbref().title.upcase().match('ISO').gt(0) then
          !scaleFromView = !views.size() - 1
        else
          !scaleFromView = !views.size()
        endif
        !lastview = !views[!scaleFromView]
        var !scale VSCALE OF $!lastview
      endif
      -- <K.pleschner> April 2005
      ---------------------------

      if undefined(!!abauserview) then
        -- Initialise variables
        !scDtext = ARRAY()
        !scRtext = ARRAY()

        -- Read permitted scales from  defaults file section 2
        !file = object FILE(!!abaDefaults.defaultsFile.val)
        !defaultText = !file.readfile()
        !start = !defaultText.findfirst('-- Section 2') + 1
        !end   = !defaultText.findfirst('-- End Section 2')
        !range = !end - !start
        !scales = !defaultText.from(!start,!range)

        -- Extract relevant bits for form gadget
        do !x values !scales
          -- All Scales need to be Checked NOT just the Metric values
          !split = !x.split('\')
          !scDtext.append(!split[3])
          !scRtext.append(!split[5].split(',')[1])
        enddo

        -- Find nearest relevant scales
        !scadtext = !scDtext
        !scartext = !scRtext

      else
        !scadtext = !!abauserview.scaleValue.dtext
        !scartext = !!abauserview.scaleValue.rtext
      endif

      -- Search for all scales that match those available from the view form.
      !scalestring = !scadtext[!scartext.findfirst(!scale)]
      handle (2,756)
        !scalestring = !scale
      endhandle
      !scalestring = !scalestring.trim()
      !scalestring = !scalestring.trim('M',' ')
      !scalestring = !scalestring.replace(' ','')

      --Replace / with :
      !scalestring = !scalestring.replace('/',':')
      BTEXT |$!scalestring|
    else

      !suppNameNoPrefix = !suppName.after(|/|).before(|[|)
      !btex = !btex.replace(|!suppName|,|$!suppNameNoPrefix|)
      btex |$!btex|

    endif
  enddo

  !!ce = !sheet
  !units.restoreSavedBoreDist()
  Prec var def

endfunction
