--
-- File:  mdsabaattadot.pmlfnc
--   Type:  Function
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  Draft MDS using ABA for Drawing production
--   Replaces:
--
-- Author:  Derek Flannery
-- Created:  17 August 2006
--
--
-- Description:
-- ------------
-- This function creates local rules to add support atta not part of support in dotted
--
--
-- Using this function:
-- --------------------
-- For each view call this function
-- with the view DBREF.
--
--
--------------------------------------------------------------------------------
-- Define Function
----------------------------------------------------------
-- Arguments:
--<1> -- !view = <DBREF> of view for idlist creation
--
----------------------------------------------------------

define function !!mdsabaattadot(!mdsobject is MDSABASUPPORT,!view is DBREF, !updateReqd is BOOLEAN)

  -- Set the variable !item to the MDS Support DBREF held in the OBJECT
  !item     = !mdsobject.support
  !suppname = !item.name

  !frameSupport = !item.type.eq('STRU')
  !refSupport = object ARRAY()
  if (!frameSupport) then
    do !refAtta values !item.dassci
      !refSupport.append(!refAtta.name)
    enddo
  endif

  !ruleCreated = FALSE
  -- dtf >>> 17.08.06 Get all attas in the view, if nor same as support name
  -- add them in dotted
  $!view

  var !viewattas vscan for all atta
  do !i values !viewattas
    if !i.dbref().name.before('.').match(!suppname.before('[')).eq(0) then
      new rrul
      styf /MDS-Extra-Drawlist-Style
      criteria $!i
      !ruleCreated = TRUE
    elseif (!refSupport.findfirst(!i.dbref().name).set()) then
      new rrul
      styf /MDS-Extra-Drawlist-Style
      criteria $!i
      !ruleCreated = TRUE
    endif
  enddo
  -- dtf <<< 17.08.06 End of Mod


  -- Name local rules
  $!view
  !viewName = name
  var !localRules coll all rrul for ce
  !counter = 1
  do !nameRules values !localRules
    !!ce = !nameRules.dbref()
    name $!viewName/LocalRule$!counter
    handle ANY
    endhandle
    !counter = !counter + 1
  enddo

  -- update view if local rules created
  if !ruleCreated and !updateReqd then
    UPDATE DESIGN
  endif


endfunction
