--
-- File:  mdsabaattadotsheettask.pmlfnc
--   Type:  Function
--   Group:  Multi Discipline Supports Application
--     Keyword:  MDS
--   Module:  Draft MDS using ABA for Drawing production
--   Replaces:
--
-- Author:  Derek Flannery
-- Created:  17 August 2006
--
--
-- Description:
-- ------------
-- This task creates local rules to add support atta, attas which are not part of support are dotted
--
--
-- Using this function:
-- --------------------
-- apply task to sheet template
--
--
--------------------------------------------------------------------------------
-- Define Function
----------------------------------------------------------
-- Arguments:
--
--
----------------------------------------------------------

define function !!mdsabaattadotsheettask(!dummyParams is ARRAY)

  sheet
  !sheet = !!ce

  !abaname = '/' + !sheet.name.after('VIEW-').before('-AREA')
  !!ce = !abaname.dbref()
  handle (2,109)
    -- Check if MDS Support is the MASTER STRUCTURE, number [1], of a MDS GROUP, if UNDEFINED NAME error(2,109) occurs
    !abaname = !abaname + '[1]'
    !abasupp = !abaname.dbref()
  elsehandle NONE
    !abasupp = !abaname.dbref()
  endhandle

  !objsupp   = false
  !objindex  = 0
  !mdsobject = object MDSABASUPPORT()
  do !indx indices !!mdsarray
    if (!!mdsarray[!indx].support.eq(!abasupp)) then
      !objindex  = !indx
      !mdsobject = !!mdsarray[!indx]
      !objsupp   = true
      break
    else
      skip
    endif
  enddo

  -- End this Task if a MATCH for the MDS Support is NOT Found in the MDSABASUPPORT Objects
  if (!objsupp.not()) then
    return
  endif

  do !vindx indices !mdsobject.abadata.views
    !!ce = !mdsobject.abadata.views[!vindx].dbref()
    !view = !!ce

    -- Set the variable !item to the MDS Support DBREF held in the OBJECT
    !item     = !mdsobject.support
    !suppname = !item.name

    !frameSupport = !item.type.eq('STRU')
    !refSupport = object ARRAY()
    if (!frameSupport) then
      do !refAtta values !item.dassci
        !refSupport.append(!refAtta.name)
      enddo
    endif

    !ruleCreated = FALSE
    -- dtf >>> 17.08.06 Get all attas in the view, if nor same as support name
    -- add them in dotted
    $!view

    var !viewattas vscan for all atta
    do !i values !viewattas
      if !i.dbref().name.before('.').match(!suppname.before('[')).eq(0) then
        new rrul
        styf /MDS-Extra-Drawlist-Style
        criteria $!i
        !ruleCreated = TRUE
      elseif (!refSupport.findfirst(!i.dbref().name).set()) then
        new rrul
        styf /MDS-Extra-Drawlist-Style
        criteria $!i
        !ruleCreated = TRUE
      endif
    enddo
    -- dtf <<< 17.08.06 End of Mod


    -- Name local rules
    $!view
    !viewName = name
    var !localRules coll all rrul for ce
    !counter = 1
    do !nameRules values !localRules
      !!ce = !nameRules.dbref()
      name $!viewName/LocalRule$!counter
      handle ANY
      endhandle
      !counter = !counter + 1
    enddo

    if !ruleCreated then
      UPDATE DESIGN
    endif

  enddo
endfunction
-- End of Object - mdsabasetidln
