--
-- File:            mdsabacheckdimsmodified.pmlfnc
--   Type:          Function Definition
--   Group:
--     Keyword:
--   Module:        draft
--   Replaces:
--
-- Author:          Martin Ward
-- Modified         Dave Sewell "for modified dimensions"
-- Created:         August 2008
--
-- Description: Find any dimensions that have been moved after the task was run
------------------------------------------------------------------------

define function !!mdsAbaCheckDimsModified() is ARRAY

  !movedDimensions = ARRAY()
  -- Collect all the labels from the layer
  !find = object COLLECTION()
  !find.type('ldim')
  !find.addType('adim')
  !find.scope(!!ce)
  !dimensions = !find.results()

  do !dim values !dimensions
    -- Find out if the XYPOS attribute has been modified after the DDNM attribute
    -- If so then it has been modified by the user
    !lastModifiedDir  = !dim.lastmod.dir
    !lastModifiedDpos = !dim.lastmod.dpos
    !modifiedDirDate  = object DATETIME(!lastModifiedDir)
    !modifiedPosDate  = object DATETIME(!lastModifiedDpos)
    if (!modifiedPosDate gt !modifiedDirDate) then
      !movedDimensions.append(!dim)
    endif
  enddo
  -- add any dimensions with *modified* in the name
  !find.filter(object EXPRESSION('matchwild(NAME,|*moved*|)'))
  !movedDims = !find.results()
  !movedDimensions.appendArray(!movedDims)
  !movedDimensions.unique()

  return !movedDimensions

endfunction
