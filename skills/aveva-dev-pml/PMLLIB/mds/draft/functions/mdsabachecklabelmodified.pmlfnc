--
-- File:            mdsabachecklabelmodified.pmlfnc
--   Type:          Function Definition
--   Group:
--     Keyword:
--   Module:        draft
--   Replaces:
--
-- Author:          Martin Ward
-- Created:         August 2008
--
-- Description: Find any labels that have been moved after the task was run
------------------------------------------------------------------------
define function !!mdsAbaCheckLabelModified() is ARRAY

  !movedLabels = ARRAY()
  -- Collect all the labels from the layer
  !find = object COLLECTION()
  !find.type('SLAB')
  !find.addType('GLAB')
  !find.scope(!!ce)
  !labels = !find.results()

  do !label values !labels
    -- Find out if the XYPOS attribute has been modified after the DDNM attribute
    -- If so then it has been modified by the user
    !lastModifiedName = !label.lastmod.ddnm
    !lastModifiedPos  = !label.lastmod.xypos
    !lastModifiedVis  = !label.lastmod.lvis
    !modifiedNameDate = object DATETIME(!lastModifiedName)
    !modifiedPosDate  = object DATETIME(!lastModifiedPos)
    !modifiedVisDate  = object DATETIME(!lastModifiedVis)
    if (!modifiedPosDate gt !modifiedNameDate or !modifiedVisDate gt !modifiedNameDate) then
      !movedLabels.append(!label)
    endif
  enddo

  -- add any labels with *modified* in the name
  !find.filter(object EXPRESSION('matchwild(NAME,|*moved*|)'))
  !labels = !find.results()
  !movedLabels.appendArray(!labels)
  !movedLabels.unique()

  return !movedLabels

endfunction
