define function !!mdsabaConfigFile(!key is STRING) is STRING

	!proj = current project
	!filename = '%' & !proj.code() & 'DFLTS%\MDS-ABA-' & !key.trim().upcase() & '-CONFIG.xls'

  return !filename

endfunction
