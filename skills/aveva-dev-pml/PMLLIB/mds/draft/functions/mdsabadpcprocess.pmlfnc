--------------------------------------------------------------------------------
--
-- File:    mdsabadpcprocess.pmlfnc
--   Type:    Function Definition
--   Group:   Multi Discipline Supports Application
--     Keyword:   MDS
--   Module:    Draft MDS3.1.1 using ABA11.3
--   Replaces:
--
-- Author:    Wayne Dodwell
-- Created:   Wednesday 12th June 2002
--
-- Description:
-- Main MDS ABA Process Function
--
--------------------------------------------------------------------------------
--
--------------------------------------------------------------------------------
--  Modification History
--
-- Ver    Date       DA ref.    Author  Reason
-- -----  ---------  ---------  ------  -----------------------
-- V1.01  17-JAN-03                     Initial Version
-- V1.02  12-MAY-04  HPD0021598 NB      DXF File production
-- v1.03  19-Apr-05             WD/NB   MDS VPRM MTO File Generation etc...
-- v1.04  07-Jul-06             WD/NB   Errors are now prefixed by (DM-MDS) so that DM can recognise them.
--                                      BUG FIX to recognise if the current version of VPD being run is PDMS11.6
-- v1.05  27-JUN-07  HPD0035323 NB      Populate the MTO Revision from the DM Revision code (OP48)
-- v1.06  09-AUG-07             NM/NB   Include $T50+ command in DM macro file to prevent loading of Symbol Libraries
-- v1.07  13-FEB-08  HPD0037280 NB      Enable production of Hanger Drawings
-- v1.08  27-FEB-08  DFN8368    NB      Remove (2,751) error when MDS DXF paths not set
-- v1.09  10-MAR-09  SI-5780 & DFN P-14754    NB      Load MDS Symbol Libraries in order
-- v1.10  02-DEC-09  P-27364    NB      MDS MTO errors are not shown in the DM Production Monitor form and do not fail the drawing
-- v1.11  10-NOV-11  P-41873    NB      Set !!mdsHangIf from Hanger Interface record
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R       STRING      Process File Name with Full Pathname Supplied from DM
--     2      R       STRING      Plot File Storage Directory Name Supplied from DM for MDS ABA Generated Plotfiles
--     3      R       STRING      DXF Storage Directory Name Supplied from DM for MDS ABA Generated Plotfiles
--     4      R       STRING      Process Error File Name with Full Pathname Supplied from DM
--     5      R       STRING      MDS VPRM MTO Search path for VPRM Gateway executables
--     6      R       STRING      MDS VPRM MTO File Storage Directory Supplied from DM for MDS ABA Generated MTO Files
--     7      R       STRING      MDS VPRM MTO Transfer Code: <Any 1 of 3 Permissible Arguments Supplied from DM
--                                <a> 'N' = MDS VPRM MTO File is NOT to be Generated, i.e. 'Do Not Generate'
--                                <b> 'I' = MDS VPRM MTO File is to be Generated but "NOT" Automatically LOADED into VPRM, i.e. 'Only Generate MDS MTO on Issue'
--                                <c> 'P' = MDS VPRM MTO File is to be Generated and Automatically LOADED into VPRM, i.e. 'Generate and Transfer MDS MTO to VPRM on Production'
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
--
-- Define Function

define function !!mdsabadpcprocess(!file is STRING, !plotDir is STRING, !dxfDir is STRING, !errorFile is STRING, !mtoExe is STRING, !mtoDir is STRING, !mtoTransfer is STRING)

--  Set Global variables
   !!ANPUDACONFIGVPE  =':FRA-VPE_CONFIG'
   !!ANPUDATRANSFER   =':FRAECSINFO'
   !!ANPUDAARTNO      =':FRA_ART.NO'
   !!ANPUDAROOM       =':FRA.ROOM_KKS'
   !!ANPUDACONFIG3D   =':FRA.CONFIG'
   !!ANPUDACLASESPN   =':EDF-CLASESPN'
   !!ANPUDACLASMECA   =':EDF-CLASMECA'
   !!ANPUDAKKS        =':EDF-KKS'
   !!ANPUDAAWEIGHT    =':FRA_AWEIGHT'
   !!ANPUDAEWEIGHT    =':FRA_EWEIGHT'
   !!ANPUDADRAWING    =':FRA_DRAWING'
   !!ANPUDADRWGITEM   =':FRA_DRWGITEM'
   !!ANPUDAENDMAT     =':FRA_ENDMAT'
   !!ANPUDAENDTHK     =':FRA_ENDTHK'
   !!ANPUDASUPPLIER   =':FRA_SUPPLIER'
   !!ANPUDATRANSNO    =':FRA_TRANSNO'
   !!ANPUDAVACT       =':FRA_VACT'
   !!ANPUDAVBODY      =':FRA_VBODY'
   !!ANPUDAVWBS       =':FRA_VWBS'
   !!ANPUDABLDCODE    =':FRA.BLDCODE'
   !!ANPUDACLEAN      =':FRA.CLEAN'
   !!ANPUDACLLENGTH   =':FRA.CLLENGTH'
   !!ANPUDADEFINED    =':FRA.DEFINED'
   !!ANPUDADESAREA    =':FRA.DESAREA'
   !!ANPUDADRWG1      =':FRA.DRWG1'
   !!ANPUDADRWG2      =':FRA.DRWG2'
   !!ANPUDADRWG3      =':FRA.DRWG3'
   !!ANPUDAETYP       =':FRA.E_TYP'
   !!ANPUDAEXTDIA     =':FRA.EXTDIA'
   !!ANPUDAGIRTYPE    =':FRA.GIRTYPE'
   !!ANPUDAHANDIS     =':FRA.HANDIS'
   !!ANPUDAHANLEN     =':FRA.HANLEN'
   !!ANPUDAHEADROOM   =':FRA.HEADROOM'
   !!ANPUDAHOITYPE    =':FRA.HOITYPE'
   !!ANPUDAHVACPS     =':FRA.HVAC_PS'
   !!ANPUDAININSP     =':FRA.IN_INSP'
   !!ANPUDAINSUL      =':FRA.INSUL'
   !!ANPUDALEVLEN     =':FRA.LEVLEN'
   !!ANPUDALSIZE      =':FRA.LSIZE'
   !!ANPUDAMAINDES    =':FRA.MAIN_DES'
   !!ANPUDAMATL       =':FRA.MATL'
   !!ANPUDAMAXAMOVE   =':FRA.MAXAMOVE'
   !!ANPUDAMAXRMOVE   =':FRA.MAXRMOVE'
   !!ANPUDAMONTYPE    =':FRA.MONTYPE'
   !!ANPUDAPIDNUM     =':FRA.PIDNUM'
   !!ANPUDAPMCEN      =':FRA.PMC_EN'
   !!ANPUDAPRESS      =':FRA.PRESS'
   !!ANPUDAPROTTYPE   =':FRA.PROTTYPE'
   !!ANPUDAQCL        =':FRA.QCL'
   !!ANPUDARIN        =':FRA.RIN'
   !!ANPUDAROOMAFR    =':FRA.ROOMAFR'
   !!ANPUDAROOMHMA    =':FRA.ROOMHMA'
   !!ANPUDAROOMHMI    =':FRA.ROOMHMI'
   !!ANPUDAROOMHUM    =':FRA.ROOMHUM'
   !!ANPUDAROOMHUMA   =':FRA.ROOMHUMA'
   !!ANPUDAROOMTMAX   =':FRA.ROOMTMAX'
   !!ANPUDAROOMTMIN   =':FRA.ROOMTMIN'
   !!ANPUDASCL        =':FRA.SCL'
   !!ANPUDASCOPE      =':FRA.SCOPE'
   !!ANPUDASEIS       =':FRA.SEIS'
   !!ANPUDASSNO       =':FRA.SSNO'
   !!ANPUDASTATE      =':FRA.STATE'
   !!ANPUDATEMP       =':FRA.TEMP'
   !!ANPUDATPRESS     =':FRA.TPRESS'
   !!ANPUDATRACING    =':FRA.TRACING'
   !!ANPUDAWALLTHK    =':FRA.WALLTHK'
   !!ANPUDABATCHID    =':FRA-BATCH-ID'
   !!ANPUDAESPNGRP    =':FRA-ESPN_GRP'
   !!ANPUDAPAINT      =':FRA-PAINT'
   !!ANPUDASITE       =':FRA.SITE'

  -- Get Hanger Interface
  /MDS/OPTION/DEFAULTS/MDSHANGIF/DATA
  var !pprop pprop
  !!mdsHangIf = $!pprop

  --<nb>aug2007  (Include $T50+ command in DM macro file to prevent loading of Symbol Libraries)
  -- If the trace flag of $T50+ is used this will not load any sylb members.
  -- This is so that large databases with lots of drawings 1000+ are not scanned for MDS.
  -- There is no SYLB elements produced at each MDS drawing.

  var !coll coll all sylb with ddepth lt 4
  do !load values !coll
    !!ce = !load.dbref()
    load ce
    --> SI-5780 & DFN P-14754  <NB>  Load MDS Symbol Libraries in order
    handle (64,503)
      -- Picture needs to be loaded
      !sylb = !!error.text.replace('(64,503)  SYLB ','').replace(': Picture needs to be loaded.','')
      load $!sylb
      unload ce
      load ce
    elsehandle (64,416)
      -- Picture is already Loaded
    endhandle
    --< SI-5780 & DFN P-14754  <NB>  Load MDS Symbol Libraries in order
  enddo

  -- Define log file for insertion into DM logfile
  var !unique unique
  alpha log /%pdmsuser%\dpc-alpha-log-$!unique over

  -- Initialise Variables
  !errors  = ARRAY()
  !currCe  = !!ce
  !!cdAuto = TRUE

  -- Declare the DM Process Global Variable '!!mdsAbaDpcVar'
  if (defined(!!mdsAbaDpcVar)) then
    !!mdsAbaDpcVar.delete()
  endif
  !!mdsAbaDpcVar = TRUE

  ----------------------------------------------------------------------------------------
  -- Error Check the File and Directory Arguments Passed from the DM process
  ----------------------------------------------------------------------------------------
  -- Check if the Error File Directory Location Exists
  !errorObject = object FILE(!errorFile)
  !errorDir    = !errorObject.pathname()
  !errorName   = !errorFile.before(!errorDir)
  !errorDirObj = object FILE(!errorDir)
  if (!errorDirObj.exists().not()) then
    !errorLog  = object FILE('%PDMSUSER%/$!errorName')
    !errorNew  = !errorLog.fullname()
    !errors.append('(DM-MDS-ERROR)  The directory ''$!errorDir'' for the DM - MDS ABA error file ''$!errorName'' does NOT exist. Aborting this DM process')
    !alert = 'The directory ''$!errorDir'' for the DM - MDS ABA error file ''$!errorName'' does NOT exist.
    The error log file is ''$!errorNew''. Aborting this DM process'
    golabel /finish
  endif

  -- Check if the Process File Exists
  !fileObject = object FILE(!file)
  if (!fileObject.exists().not()) then
    !errors.append('(DM-MDS-ERROR)  The process file name ''$!file'' supplied from DM does NOT exist. Aborting this DM process')
    !alert = 'The process file name ''$!file'' supplied from DM does NOT exist. Aborting this DM process'
    golabel /finish
  else
    if (!fileObject.type().neq('FILE')) then
      !errors.append('(DM-MDS-ERROR)  The process file name ''$!file'' supplied from DM is NOT a file. Aborting this DM process')
      !alert = 'The process file name ''$!file'' supplied from DM is NOT a file. Aborting this DM process'
      golabel /finish
    endif
  endif

  -- Check if the Plot File Directory Exists
  !plotDirObj = object FILE(!plotDir)
  if (!plotDirObj.exists().not()) then
    !errors.append('(DM-MDS-ERROR)  The plot file directory name ''$!plotDir'' supplied from DM does NOT exist. Aborting this DM process')
    !alert = 'The plot file directory name ''$!plotDir'' supplied from DM does NOT exist. Aborting this DM process'
    golabel /finish
  else
    if (!plotDirObj.type().neq('DIRECTORY')) then
      !errors.append('(DM-MDS-ERROR)  The plot file directory name ''$!plotDir'' supplied from DM is NOT a directory. Aborting this DM process')
      !alert = 'The plot file directory name ''$!plotDir'' supplied from DM is NOT a directory. Aborting this DM process'
      golabel /finish
    endif
  endif

  -- Check if the DXF Directory Exists
  if(!dxfDir ne '') then
    !dxfDirObj = object FILE(!dxfDir)
    if (!dxfDirObj.exists().not()) then
      !errors.append('(DM-MDS-ERROR)  The DXF directory name ''$!dxfDir'' supplied from DM does NOT exist. Aborting this DM process')
      !alert = 'The DXF directory name ''$!dxfDir'' supplied from DM does NOT exist. Aborting this DM process'
      golabel /finish
    else
      if (!dxfDirObj.type().neq('DIRECTORY')) then
        !errors.append('(DM-MDS-ERROR)  The DXF directory name ''$!dxfDir'' supplied from DM is NOT a directory. Aborting this DM process')
        !alert = 'The DXF directory name ''$!dxfDir'' supplied from DM is NOT a directory. Aborting this DM process'
        golabel /finish
      endif
    endif
  endif

  -------------------------------------------------
  --<wd>apr05
  -- Additional Checks Required for MDS VPRM Interface
  -- Check if the MDS VPRM MTO Directory Exists
  if(!mtoDir ne '') then
    !mtoDirObj = object FILE(!mtoDir)
    if (!mtoDirObj.exists().not()) then
      !errors.append('(DM-MDS-ERROR)  The MTO directory name ''$!mtoDir'' supplied from DM does NOT exist. Aborting this DM process')
      !alert = 'The MTO directory name ''$!mtoDir'' supplied from DM does NOT exist. Aborting this DM process'
      golabel /finish
    else
      if (!mtoDirObj.type().neq('DIRECTORY')) then
        !errors.append('(DM-MDS-ERROR)  The MTO directory name ''$!mtoDir'' supplied from DM is NOT a directory. Aborting this DM process')
        !alert = 'The MTO directory name ''$!mtoDir'' supplied from DM is NOT a directory. Aborting this DM process'
        golabel /finish
      endif
    endif
  endif

  -- When "!mtoTransfer.eq('P')" -- Check if the PDMS-VPRM Gateway Executable File Exists
  -- Delivery Manager may pass the DIRECTORY or the Executable FILE name
  if (!mtoTransfer.eq('P')) then
    if (defined(!!vprmExists)) then
      if (!!vprmExists) then
        !autoExeFileName = !mtoExe.lowcase().replace('\pdsc02.exe','')
        !autoExeFile     = object FILE(!autoExeFileName & '\pdsc02.exe')
        !autoExeFileName = !autoExeFile.fullname()
        if(!autoExeFileName.neq('')) then
          !mtoExeObj = object FILE(!autoExeFileName)
          if (!mtoExeObj.exists().not()) then
            !errors.append('(DM-MDS-ERROR)  The GATEWAY file name ''$!autoExeFileName'' supplied from DM does NOT exist. Aborting this DM process')
            !alert = 'The GATEWAY file name ''$!autoExeFileName'' supplied from DM does NOT exist. Aborting this DM process'
            golabel /finish
          else
            if (!mtoExeObj.type().neq('FILE')) then
              !errors.append('(DM-MDS-ERROR)  The GATEWAY file name ''$!autoExeFileName'' supplied from DM is NOT a file. Aborting this DM process')
              !alert = 'The GATEWAY file name ''$!autoExeFileName'' supplied from DM is NOT a directory. Aborting this DM process'
              golabel /finish
            endif
          endif
        endif
      endif
    endif
  endif
  --<wd>apr05
  -------------------------------------------------

  -- Check we are in PDMS Draft Module
  !session = current session
  !module  = !session.module()

  --<wd>may2007<mds12>
  --  if (!module.upcase().eq('DRAFT').not()) then
  --    !errors.append('(DM-MDS-ERROR)  MDS ABA Drawings can only be produced in the The PDMS Draft Module. Aborting this DM process')
  --    !alert = 'MDS ABA Drawings can only be produced in the The PDMS Draft Module. Aborting this DM process'

  --<wd>08dec2009 - DFN P-27479 - Unable to create an MDS ABA drawing from DM
  --  if (!module.upcase().eq('DRAFT').not()) or (!module.upcase().eq('OUTFITTINGDRAFT').not())then
  if (!module.upcase().eq('DRAFT').not()) and (!module.upcase().eq('OUTFITTINGDRAFT').not())then
    --<wd>08dec2009 - DFN P-27479
    !errors.append('(DM-MDS-ERROR)  MDS ABA Drawings can only be produced in the Draft Module. Aborting this DM process')
    !alert = 'MDS ABA Drawings can only be produced in the Draft Module. Aborting this DM process'
    -- <wd>may2007<mds12>
    golabel /finish
  endif

  ----------------------------------------------------------------------------------------
  -- Load the ABA then the MDS Applications and Defaults and Check DBREFs for validity
  ----------------------------------------------------------------------------------------
  --<wd>mar2007<mds12> -- This is a MDS12 Version ONLY
  -- -- In PDMS Draft therefore:
  -- -- First - Load ABA only if not pdms11.6
  --   if !!isPDMS116().not() then
  --     $M/%PDMSUI%/DRA/CLIB/XAPPLIC _CDRADPAPP
  --   endif
  --<wd>mar2007<mds12> -- This is a MDS12 Version ONLY

  -- Hide the Select Working Sheet Form
  !!cdrdrwgsel.hide()

  -- Second - Load MDS
  -- Initialisation of the MDS ABA Create Drawing Form is done here
  !!mdsdflts.init('SELECTION')
  handle ANY
    pml load FORM !!mdsdflts
    !!mdsdflts.init('SELECTION')
  endhandle

  --<wd>08dec2009 - DFN P-27479 - Unable to create an MDS ABA drawing from DM
  !!mdsAbaSelSupp.all()
  --<wd>08dec2009

  -- Process the MDS ABA Support Drawings requested via DM (Delivery Manager)
  !readArray  = !fileObject.readFile()
  !lines      = ARRAY()

  --Append All Valid File Lines to the Array '!lines'
  do !indx indices !readArray
    skip if !readArray[!indx].trim().eq('')
    if (!readArray[!indx].trim().match('/').eq(1)) then
      !line = !readArray[!indx].trim()
      !lines.append(!line)
    else
      skip
    endif
  enddo

  -- Check there are some Valid Lines to Process
  if (!lines.size().eq(0)) then
    !errors.append('(DM-MDS-ERROR)  There are NO valid MDS Supports in the passed file. Aborting this DM process')
    !alert = 'There are NO valid MDS Supports in the passed file. Aborting this DM process'
    golabel /finish
  endif
  -- Check if the Passed ABA Template Exists in the Current MDB and it is a Valid MDS ABA Template
  -- The Template is the same on Every Line so Always test the first iteration of the array
  !lineSplit = !lines[1].split()
  !stringTmp = '/' & !lineSplit[2] .trim()
  !template  = !stringTmp.dbref()
  handle NONE
    -- PDMS Element Exists, is it a DRTMPL with a the Correct Purpose Attribute
    if (!template.function.neq('MDS')) then
      !errors.append('(DM-MDS-ERROR)  The passed ABA Drawing Template ''$!stringTmp'' is NOT a valid MDS ABA template. Aborting this DM process')
      !alert = 'The passed ABA Drawing Template ''$!stringTmp'' is NOT a valid MDS ABA template. Aborting this DM process'
      golabel /finish
    endif
    !tmpArr[1] = !stringTmp.after('/')
  elsehandle ANY
    !errors.append('(DM-MDS-ERROR)  The passed MDS ABA Drawing Template ''$!stringTmp'' does NOT exist. Aborting this DM process')
    !alert = 'The passed MDS ABA Drawing Template ''$!stringTmp'' does NOT exist. Aborting this DM process'
    golabel /finish
  endhandle
  !!ce = !currCe

  -- Check if the Passed ABA Registry Exists in the Current MDB
  -- The Registry is the same on Every Line so Always test the first iteration of the array
  !lineSplit = !lines[1].split()
  !stringReg = '/' & !lineSplit[3].trim()
  !registry  = !stringReg.dbref()
  handle NONE
    -- PDMS Element Exists is it Registry?
    if (!registry.fulltype.neq('REGISTRY')) then
      !type = !registry.fulltype
      !errors.append('(DM-MDS-ERROR)  The passed element ''$!stringReg'' is  ''$!type'' NOT a REGISTRY. Aborting this DM process')
      !alert = 'The passed element ''$!stringReg'' is  ''$!type'' NOT a REGISTRY. Aborting this DM process'
      golabel /finish
    endif
    !regArr[1] = !stringReg.after('/')
  elsehandle ANY
    !errors.append('(DM-MDS-ERROR)  The passed MDS ABA Drawing Registry ''$!stringReg'' does NOT exist. Aborting this DM process')
    !alert = 'The passed MDS ABA Drawing Registry ''$!stringReg'' does NOT exist. Aborting this DM process'
    golabel /finish
  endhandle
  !!ce = !currCe

  -- Check if Each MDS Support Exists in the Current MDB and that it is an MDS Support
  -------------------------------------------------
  --<wd>apr2005
  -- "DTEXT" values for the form !!mdsAbaSelSupp.
  !supArr = ARRAY()
  -- "RTEXT" values for the form !!mdsAbaSelSupp.frame WILL DIFFER from "DTEXT" for MDS GROUP FRAMEWORK STRUCTURES
  !rTexArr = ARRAY()
  --<wd>apr2005

  --<nb>jun2007  HPD0035323/OP48  (Populate the MTO Revision from the DM Revision code)
  !revArray  = ARRAY()

  do !indx indices !lines
    !lineSplit = !lines[!indx].split()
    !stringSup = !lineSplit[1].trim()
    --<nb>jun2007  HPD0035323/OP48  (Populate the MTO Revision from the DM Revision code)
    !rev       = !lineSplit[4].trim()
    !revArray.append(!stringSup & ' ' & !rev)
    !support   = !stringSup.dbref()
    handle NONE
      -- Check if MDS Support is in a MDS GROUP Support
      -- ALWAYS PROCESS the MASTER MDS STRUCTURE in the MDS GROUP Support even
      -- when its' NOT in the supplied PIPE LIST but ANOTHER MDS HANGER ATTA is!
      if (!stringSup.matchwild('*[*]')) then
        !ceOrig = !!ce
        -- Set the name of the Master MDS Structure for the MDS GROUP
        !testName  = !stringSup
        !stringSup = !stringSup.before('[') & '[1]'
        -- SKIP and Write to the ERROR file if the Master MDS Structure for the MDS GROUP does NOT exist
        !!ce = !stringSup.dbref()
        handle ANY
          --<wd>jul2006 -- (DM) FAILED... error message added and all other existing messages prefixed with (DM-MDS-ERROR)
          !errors.append('(DM) FAILED to detail $!testName')
          !errors.append('(DM-MDS-ERROR)   ERROR -- The MDS Support name "$!testName" is NOT a valid MDS Support name')
          !errors.append('(DM-MDS-ERROR)   ERROR -- Illegal "[" characters exist in the MDS Support name')
          !errors.append('(DM-MDS-ERROR)    Skipping... element named $!testName')
          skip
        endhandle
      endif

      -- Check if DBREF element is a valid MDS Support or a valid MDS GROUP Support
      -- Try and get the MDS Support DATUM Atta(MDS Structure Support). Otherwise Test and Get the MDS Support Type

      !datumName = !stringSup & '/DATUM'
      handle ANY
        --<wd>jul2006 -- (DM) FAILED... error message added and all other existing messages prefixed with (DM-MDS-ERROR)
        !errors.append('(DM) FAILED to detail $!stringSup')
        !errors.append('(DM-MDS-ERROR)  $!stringSup exists as a support structure but the datum atta does not exist, therefore $!stringSup has been IGNORED in this DM process.')
        skip
      endhandle

      !datum = !datumName.dbref()
      handle (2,109)
        -- Undefined Name (2,109) -- A DATUM ATTA does NOT EXIST
        !!ce = !support

        --<wd>jul2006
        -- DATUM ATTA does NOT EXIST, so TEST if PDMS type is STRU. When it is a STRU it MUST have a DATUM ATTA
        if (!!ce.type.eq('STRU')) then
          --<wd>mar2007<mds12>
          --
          -- --<wd>jul2006 -- (DM) FAILED... error message added and all other existing messages prefixed with (DM-MDS-ERROR)
          --           !errors.append('(DM) FAILED to detail $!stringSup')
          --           !errors.append('(DM-MDS-ERROR)  $!stringSup exists as a support structure but the DATUM atta does not exist, therefore $!stringSup has been IGNORED in this DM process.')
          --           skip
          --         endif
          -- --<wd>jul2006
          -- Additional check for a MDS LIGHTING support
          if !!ce.:MDSSUPPTYPE.eq(!!mdslsuppdefs.type) then
            !datum    = !!ce
            !suppType = 'STRU'
          else
            -- (DM) FAILED... error message added and all other existing messages prefixed with (DM-MDS-ERROR)
            !errors.append('(DM) FAILED to detail $!stringSup')
            !errors.append('(DM-MDS-ERROR)  $!stringSup exists as a support structure but the DATUM atta does not exist, therefore $!stringSup has been IGNORED in this DM process.')
            skip
          endif
          --<wd>mar2007<mds12>
          --
          --<wd>apr2005 -- Error raised if CREF of ATTA is 'unset', which is valid for ATTA only Supports
          --if (!!ce.cref.type.eq('HANG')) then
          --
          --<wd>mar2007<mds12>
          --if (!!ce.cref.set()) then
        elseif (!!ce.cref.set()) then
          --<wd>mar2007<mds12>
          --
          if (!!ce.cref.type.eq('HANG')) then
            -- MDS HANGER Support type
            !suppType = 'HANG'
          endif
          --<wd>apr2005

        elseif (!!ce.owner.:MDSTrun) then
          -- MDS TRUNNION Branch Support
          !suppType = 'TRUN'
        elseif (!!ce.type.eq('ATTA')) then
          -- MDS ATTA Only Support
          if (purp of spec of spref eq 'MDS') then
            !suppType = 'ATTA'
          endif
        else
          !suppType = !!ce.type
        endif

      elsehandle NONE
        -- MDS Framework Support
        !suppType = 'STRU'
      endhandle

      --<tm>21/07/2005 16:16
      -- check if the support exists at a different drawing size
      !area = !stringSup & '-AREA'
      !testArea = !area.dbref()
      handle NONE
        var !anotherSheet collect all SHEET with darref eq $!area
        handle ANY
        endhandle
        if !anotherSheet.set() then
          !linkrefOfAnother = !anotherSheet[1].dbref().linkref.owner
          if !linkrefOfAnother.neq(!template) then
            !aName = !linkrefOfAnother.name
            --<wd>jul2006 -- (DM) FAILED... error message added and all other existing messages prefixed with (DM-MDS-ERROR)
            !errors.append('(DM) FAILED to detail $!stringSup')
            !errors.append('(DM-MDS-ERROR)  Drawing already exists for support $!stringSup with template( $!aName ) - drawing generation aborted')
            skip
          endif
        endif
      elsehandle ANY
      endhandle


      -------------------------------------------------
      --<wd>apr05
      -- MDS Ancillary ATTA Supports added to MDS ABA process
      -- Currently Only process MDS Structures and Hangers
      --if (!suppType inset ('STRU','HANG')) then
      if (!suppType inset ('STRU','HANG','ATTA')) then
        !supArr.append(!stringSup.after('/').before('['))
        !rTexArr.append(!stringSup.after('/'))
        --elseif (!suppType inset ('ATTA','TRUN')) then
      elseif (!suppType inset ('TRUN')) then
        --if (!suppType.eq('ATTA')) then
        --  !fulltype = 'Pipe Attachment'
        --elseif (!suppType.eq('TRUN')) then
        !fulltype = 'MDS Pipe Trunnion'
        --endif
        --<wd>jul2006 -- (DM) FAILED... error message added and all other existing messages prefixed with (DM-MDS-ERROR)
        !errors.append('(DM) FAILED to detail $!stringSup')
        !errors.append('(DM-MDS-ERROR)  $!stringSup exists, but is a MDS ''$!fulltype'' Support and therefore has been IGNORED in this DM process.')
        --<wd>apr05
        -------------------------------------------------

      else
        --<wd>jul2006 -- (DM) FAILED... error message added and all other existing messages prefixed with (DM-MDS-ERROR)
        !errors.append('(DM) FAILED to detail $!stringSup')
        !errors.append('(DM-MDS-ERROR)  $!stringSup exists, and is a PDMS element type ''$!suppType''. It is NOT a MDS Support and therefore has been IGNORED in this DM process.')
      endif

      -------------------------------------------------
    elsehandle ANY
      -------------------------------------------------
      --<wd>apr05
      -- Check if "!stringSup" a MDS GROUP Support -- The MASTER MDS GROUP STRUCTURE is always "<mdsSupportName>[1]"
      !grpStringSup = !stringSup & '[1]'
      !grpSupport   = !grpStringSup.dbref()
      handle NONE
        -- Check if DBREF element is a valid MDS Support
        -- Try and get the MDS Support DATUM Atta(MDS Structure Support). Otherwise Test and Get the MDS Support Type

        --<wd>jul2006 -- THIS CODE DOESN'T CHECK if a DBREF EXISTS -- But it has been left alone, JUST in CASE
        !datumName = !grpStringSup & '/DATUM'
        handle ANY
          --<wd>jul2006 -- (DM) FAILED... error message added and all other existing messages prefixed with (DM-MDS-ERROR)
          !errors.append('(DM) FAILED to detail $!grpStringSup')
          !errors.append('(DM-MDS-ERROR)  $!grpStringSup exists as a support structure but the datum atta does not exist, therefore $!grpStringSup has been IGNORED in this DM process.')
          skip
        endhandle
        --<wd>jul2006

        -- Try and Navigate to the MDS GROUP STRU DATUM ATTA
        !datum     = !datumName.dbref()
        handle (2,109)
          -- Undefined Name (2,109) -- A DATUM ATTA does NOT EXIST
          -- It is NOT the MASTER STRU of a MDS GROUP Support as the DATUM ATTA DOES NOT Exist
          -- Navigate and determine what is the "!suppType" of "!grpSupport"
          !!ce = !grpSupport

          --<wd>jul2006
          -- DATUM ATTA does NOT EXIST, so TEST if PDMS type is STRU. When it is a STRU it MUST have a DATUM ATTA
          if (!!ce.type.eq('STRU')) then
            --<wd>jul2006 -- (DM) FAILED... error message added and all other existing messages prefixed with (DM-MDS-ERROR)
            --             !errors.append('(DM) FAILED to detail $!grpStringSup')
            --             !errors.append('(DM-MDS-ERROR)  $!grpStringSup exists as a support structure but the DATUM atta does not exist, therefore $!grpStringSup has been IGNORED in this DM process.')
            --             skip
            --           endif
            -- --<wd>jul2006


            -- Additional check for a MDS LIGHTING support
            if !!ce.:MDSSUPPTYPE.eq(!!mdslsuppdefs.type) then
              !datum    = !!ce
              !suppType = 'STRU'
            else
              -- (DM) FAILED... error message added and all other existing messages prefixed with (DM-MDS-ERROR)
              !errors.append('(DM) FAILED to detail $!grpStringSup')
              !errors.append('(DM-MDS-ERROR)  $!grpStringSup exists as a support structure but the DATUM atta does not exist, therefore $!grpStringSup has been IGNORED in this DM process.')
              skip
            endif
            --<wd>mar2007<mds12>


            --
            --<wd>mar2007<mds12> -- EXTRA "elseif" statement added as above at approx. line 356
            --if (!!ce.cref.type.eq('HANG')) then
          elseif (!!ce.cref.set()) then
            if (!!ce.cref.type.eq('HANG')) then
              --<wd>mar2007<mds12>
              --
              -- MDS HANGER Support type
              !suppType = 'HANG'
              !fulltype = 'MDS Hanger'
              --<wd>mar2007<mds12>
            endif
            --<wd>mar2007<mds12>

          elseif (!!ce.owner.:MDSTrun) then
            -- MDS TRUNNION Branch Support
            !suppType = 'TRUN'
            !fulltype = 'MDS Pipe Trunnion'
          elseif (!!ce.type.eq('ATTA')) then
            -- MDS ATTA Only Support
            if (purp of spec of spref eq 'MDS') then
              !suppType = 'ATTA'
              !fulltype = 'MDS Pipe Atta'
            endif
          else
            !suppType = !!ce.type
          endif

        elsehandle NONE
          -- MDS GROUP Framework Support
          !suppType = 'STRU'
        endhandle

        -- The MASTER support of a MDS GROUP Support MUST be a STRU element
        if (!suppType inset ('STRU')) then
          !supArr.append(!stringSup.after('/'))
          !rTexArr.append(!grpStringSup.after('/'))
        else
          --<wd>jul2006 -- (DM) FAILED... error message added and all other existing messages prefixed with (DM-MDS-ERROR)
          !errors.append('(DM) FAILED to detail $!grpStringSup')
          !errors.append('(DM-MDS-ERROR)  $!grpStringSup exists, but is a MDS ''$!fulltype'' Support and, and NOT a MASTER MDS GROUP STRUCTURE, therefore it has been IGNORED in this DM process.')
        endif

      elsehandle ANY
        -- Passed Element is NOT a MDS Support of ANY type!
        --<wd>jul2006 -- (DM) FAILED... error message added and all other existing messages prefixed with (DM-MDS-ERROR)
        !errors.append('(DM) FAILED to detail $!grpStringSup')
        !errors.append('(DM-MDS-ERROR)  $!grpStringSup')
      endhandle

    endhandle

    --<wd>apr05
    -------------------------------------------------
  enddo
  !!ce = !currCe

  -- Exit DM Process if No Valid MDS Supports found
  if (!supArr.size().eq(0)) then
    !errors.append('(DM-MDS-ERROR)  There are NO valid MDS Supports in the passed file ''$!file''. Aborting the Delivery Manager process')
    !alert = 'There are NO valid MDS Supports in the passed file ''$!file''. Aborting the Delivery Manager process'
    golabel /finish
  endif

  ----------------------------------------------------------------------------------------
  -- Process the MDS ABA Drawings and Create the Necessary Plot Files for this DM Process
  ----------------------------------------------------------------------------------------
  -- Load the Appropriate MDS ABA Form Gadgets in order to Process the Passed MDS Supports
  !!mdsAbaSelSupp.templates.dText = !tmpArr
  !!mdsAbaSelSupp.templates.rText = !tmpArr
  !!mdsAbaSelSupp.registry.dText  = !regArr
  !!mdsAbaSelSupp.registry.rText  = !regArr

  -------------------------------------------------
  --<wd>apr05 -- From the PML CODE immediately below, Processing by DM for ALL TYPES of MDS Supports,
  --i.e. STRUCTURES, HANGERS and ATTAS, is done by LOADING ALL MDS SUPPORTS into the ".frame" list gadget
  !!mdsAbaSelSupp.frame.dText   = !supArr

  -- The RTEX for MASTER MDS GROUP STRUCTURES is required to point to a DBREF of the STRU
  -- e.g. For a MDS GROUP FRAMEWORK STRUCTURE;
  -- the Display Text <DTEX> passed from DM would be the string "PS7278-FANP09" but
  -- the Replacement Text <RTEX> in the ".frame" list gadget needs to point to the DBREF
  -- of the MASTER MDS GROUP STRU i.e. "PS7278-FANP09[1]"
  --!!mdsAbaSelSupp.frame.rText = !supArr
  !!mdsAbaSelSupp.frame.rText   = !rTexArr

  -------------------------------------------------
  --<wd>09oct2008 - DUN975
  -- After reviewing with <maw>, <maw> had after consulting various clients
  -- using DM that DM drawings would be hard coded for ABA DRWG 'Update' for all DRWGS
  ------------
  --<maw>aug08
  -- Set the update button
  !!mdsAbaSelSupp.regenerateDrwg.val = FALSE
  !!mdsAbaSelSupp.updateDrwg.val = TRUE
  --<maw>aug08
  ------------
  --<wd>09oct2008 - DUN975
  -------------------------------------------------
  --
  -------------------------------------------------
  --<wd>09oct2008 - DUN975 - This CODE and other MDS defaults files are already called from the form method!!mdsAbaSelSupp.init()
  -- and therefore, as some of the CODE is duplicated here, the CODE shown here has been commented out.

  --  -- read the project DES-SUPP-ID
  --  var !project proj code
  --  !suppIdFile = '%' & !project & 'DFLTS%\DES-SUPP-ID'
  --  !idFile = object FILE(!suppIdFile)
  --  if (!idFile.exists().not()) then
  --    alpha log end
  --    return error 1 'The project DES-SUPP-ID file could not be located. Please contact your systems administrator'
  --  endif
  --  !lines = !idFile.readFile()
  --  do !setId values !lines
  --    !setIds = !setId.split('\')
  --    if (match(!setIds[1].trim(),'MDSIDPIPE') gt 0) then
  --      !!mdsIdPAtt = !setIds[2]
  --      !!mdsIdPVal = !setIds[3]
  --    elseif (match(!setIds[1].trim(),'MDSIDTRAY') gt 0) then
  --      !!mdsIdTAtt = !setIds[2]
  --      !!mdsIdTVal = !setIds[3]
  --    elseif (match(!setIds[1].trim(),'MDSIDHVAC') gt 0) then
  --      !!mdsIdHAtt = !setIds[2]
  --      !!mdsIdHVal = !setIds[3]
  --    elseif (match(!setIds[1].trim(),'MDSIDSUPP') gt 0) then
  --      !!mdsIdSAtt = !setIds[2]
  --      !!mdsIdSVal = !setIds[3]
  --    endif
  --  enddo
  --<maw>aug08
  ------------
  --<wd>09oct2008 - DUN975 - This CODE and other MDS defaults files are already called from the form method!!mdsAbaSelSupp.init()
  -- and therefore, as some of the CODE is duplicated here, the CODE shown here has been commented out.
  -------------------------------------------------

  --<wd>apr05
  -------------------------------------------------
  -- Select ALL the List of Supports
  !!mdsAbaSelSupp.allframe.val  = TRUE
  !!mdsAbaSelSupp.allhanger.val = TRUE
  !!mdsallhangertypes = object MDSHANGERTYPES(TRUE)
  call !!mdsAbaSelectAll('FRAME')
  call !!mdsAbaSelectAll('HANGER')

  -----------------------------------------------
  --<wd>apr05
  alpha log end
  --<wd>apr05

  -- Create the MDS ABA Drawings i.e.
  -- Process the Valid Lines in the Supplied File
  !!mdsAbaSelSupp.apply(0)

  --<wd>apr05
  alpha log /%pdmsuser%\dpc-alpha-log-$!unique append
  --<wd>apr05

  -----------------------------------------------
  -- Compile a list of MDS ABA Drawings processed during this DM Process
  !drawings = ARRAY()
  !drawings.appendarray(!!mdsAbaSelSupp.newdrwgs)
  !drawings.appendarray(!!mdsAbaSelSupp.olddrwgs)

  -- Create Plot Files for the Successful MDS ABA Drawings - <MDS Support Name & 001>
  -- Typical Plot syntax: PLOT /MDS-ABA-3-VIEWS-PS-95-5000-AREA/S1 /%PDMSUSER%/MDS-ABA-3-VIEWS-PS-95-5000-AREA.s1.plt 420 297 CUTM OFF
  do !indx indices !drawings
    !sheeName   = !drawings[!indx] & '/S1'
    !suppName   = !sheeName.dbref().darref.name.after('/').before('-AREA')
    handle ANY
      skip
    endhandle
    !plotDirNam = !plotDirObj.fullname()
    !plotName   = !suppName & '001'
    if(!dxfDir ne '') then
      !dxfDirNam  = !dxfDirObj.fullname()
      !dxfName    = !suppName & '001.dxf'
    endif

    -- Plot Support/Sheet
    -------------
    --<wd>sep2005
    -- Original Code CREATES an ARRAY which causes ALL the
    -- PLOT commands below to FAIL with a SYNTAX ERROR i.e. ^ARRAY

    --!sizeOfSheet = size of $!<sheeName>
    -- Modified CODE to GENERATE a STRING type variable
    var !sizeOfSheet size of $!<sheeName>
    --<wd>sep2005
    -------------

    plot $!<sheeName> /$!<plotDirNam>/$!<plotName> $!sizeOfSheet
    handle (44,15)
      -- File already exists
      plot $!<sheeName> /$!<plotDirNam>/$!<plotName> $!sizeOfSheet OVERWRITE
    elsehandle ANY
      !errors.append('(DM-MDS-ERROR)  Unable to plot File - /$!<plotDirNam>/$!<plotName> - Plotting Error.')
    endhandle

    if(!dxfDir ne '') then
      plot $!<sheeName> DXF /$!<dxfDirNam>/$!<dxfName> $!sizeOfSheet
      handle (44,15)
        -- File already exists
        --<wd>jul2006 -- The PDMS PLOT file was being incorrectly OVER WRITTEN in DXF format
        --          plot $!<sheeName> DXF /$!<dxfDirNam>/$!<plotName> $!sizeOfSheet OVERWRITE
        plot $!<sheeName> DXF /$!<dxfDirNam>/$!<dxfName> $!sizeOfSheet OVERWRITE
        --<wd>jul2006
        if(!dxfDir ne '') then
          plot $!<sheeName> DXF /$!<dxfDirNam>/$!<dxfName> $!sizeOfSheet OVERWRITE
        endif
      elsehandle ANY
        !errors.append('(DM-MDS-ERROR)  Unable output DXF File - /$!<dxfDirNam>/$!<dxfName> - Plotting Error.')
      endhandle
    endif
    -- Append to the Error/Message File the MDS ABA Drawings and Plot Files Produced
    !errors.append('(DM-MDS)  The PDMS Draft Drawing - $!drawings[$!indx] - has been generated.')
    --<nb>aug2007  (message not appearing)
    !errors.append('(DM-MDS)  The Plotfile $!<plotDirNam>/$!<plotName> for the MDS ABA Drawing - $!drawings[$!indx] - has been generated.')
  enddo



  -------------------------------------------------
  --<wd>apr05
  ----------------------------------------------------------------------------------------
  -- Generate MDS VPRM MTO files for each MDS ABA Support Drawing in the "!drawings" array
  ----------------------------------------------------------------------------------------
  if (!mtoTransfer inset ('I', 'P')) then
    -- Create MTO Files for the Successful MDS ABA Drawings if Required
    -- Typical MTO File Name = <!mtoDir>/<MDS Support Name & 001.mto>

    --------------------------------------------------------------------------------------
    --<wd> Check and/or Test Variables - "!supArr" or "!rTexArr" for VALID MDS Supports?*******************
    --------------------------------------------------------------------------------------

    --Global variables for INFO ONLY
    !!drgs = !drawings
    !!rTex = !rTexArr
    !!dTex = !supArr
    !!wdObj.delete()
    handle ANY
    endhandle
    !!wdObj = ARRAY()

    do !mtoNum indices !drawings
      !mdsAbaDrg = !drawings[!mtoNum] & '/S1'
      !mdsName   = !mdsAbaDrg.dbref().darref.name.after('/').before('-AREA')

      -- Get the  MDS Support "DTEXT" Name from the DTEXT array "!supArr"
      !findDText = !supArr.find(!mdsName)
      if (!findDText.empty().not()) then
        -- Get the RTEXT value for MDS Support DTEXT Name, Normally the SAME as the DTEXT but NOT for MDS GROUP Supports
        -- The RTEXT represents the Valid MASTER MDS GROUP Support Structure PDMS DESIGN Database Name
        !mdsSuppName = !rTexArr[!findDText[1]]

      else
        !errors.append('(DM-MDS-ERROR)  The MDS Support "$!mdsName" could NOT be found in the Processed Supports list')
        !errors.append('(DM-MDS-ERROR)  Therefore a MDS VPRM MTO file has NOT been generated for the MDS Support "$!mdsName" ')
      endif

      -- Generate File Objects etc...
      !mtoFilename = !mtoDir & '\' & !mdsName & '001.mto'
      !mtoFile     = object FILE(!mtoFilename)
      -- Delete File if it already exists
      --!mtoFile.deletefile()

      -- Generate the MDS VPRM MTO "FILE OBJECT" and "ERROR Array" for the MDS Support
      !mdsArray = ARRAY()
      !mdsArray[1] = !mdsSuppName
      --<nb>jun2007  HPD0035323/OP48  (Populate the MTO Revision from the DM Revision code)
      !mdsVprmObj  = !!mdsVprm(!mdsArray, !revArray, !mtoFile)
      !errors.appendarray(!mdsVprmObj.errormessages)

      -- Global variable for INFO ONLY
      !!wdObj[!mtoNum] = !mdsVprmObj


      -- Automatically Load the MDS MTO file into AVEVA VPRM
      -- when <"!!vprmExists = TRUE"> and <!mtoTransfer = 'P'>
      !readFile = !mdsVprmObj.fileobjects[1].readFile()
      if (!readFile.size().neq(0)) then
        -- Only Process/Load MDS VPRM MTO files containing MDS VPRM records
        if (!mtoTransfer.eq('P')) then
          if (defined(!!vprmExists)) then
            if (!!vprmExists) then
              !autoExeFileName = !mtoExe.lowcase().replace('\pdsc02.exe','')
              !autoExeFile     = object FILE(!autoExeFileName & '\pdsc02.exe')
              !autoExeFileName = !autoExeFile.fullname()
              -- Load the MDS MTO file into VPRM
              syscom '$!autoExeFileName $!mtoFilename'

            else
              -- VPRM System is NOT available
              !errors.append('(DM-MDS-ERROR)  The AVEVA VPRM system is NOT available')
              !errors.append('(DM-MDS-ERROR)  The MDS VPRM MTO FILE - $!mtoFilename has been generated but NOT loaded into AVEVA VPRM')
            endif

          else
            -- VPRM System is NOT available
            !errors.append('(DM-MDS-ERROR)  The AVEVA VPRM system is NOT available')
            !errors.append('(DM-MDS-ERROR)  The MDS VPRM MTO FILE - $!mtoFilename has been generated but NOT loaded into AVEVA VPRM')
          endif
        endif
      endif

    enddo

  endif
  ----------------------------------------------------------------------------------------
  ----------------------------------------------------------------------------------------
  --<wd>apr05
  -------------------------------------------------


  ----------------------------------------------------------------------------------------
  -- Write the Error/Message File and Tidy Up the MDS ABA - DM Process
  ----------------------------------------------------------------------------------------
  -- Label
  label /finish

  -- Delete the DM Global Variable at the end of the DM Process
  !!mdsAbaDpcVar.delete()

  -- Write the DM - MDS ABA - Error/Message File
  if (!errors.size().eq(0)) then
    !errors[1] = 'NO Errors Found for the DM Process FILE $!file'
    --<nb>aug2007  (remove '<< was unexpected at this time.' message)
    --  !errors[2] = '<<EOF>>'
    !errorObject.writefile('WRITE',!errors)
    handle ANY
      !errorObject.writefile('OVERWRITE',!errors)
    endhandle
  else

    --<wd>jul2006
    -- CODE below commented out, it should ONLY be activated for BUG fixing etc...
    -- This PML function, i.e. MdsAbaDpcProcess.pmlfnc, is ONLY called by DM
    -- Therefore this ERROR ALERT in PDMS is NOT required to be shown whilst DM is running
    --if (defined(!alert)) then
    --  !!alert.error(!alert)
    --endif
    --<wd>jul2006

    --<nb>aug2007  (remove '<< was unexpected at this time.' message)
    --  !errors.append('<<EOF>>')
    !errorObject.writefile('WRITE',!errors)
    handle any
      !errorObject.writefile('OVERWRITE',!errors)
    endhandle
  endif


  --<wd>jul2006
  -- Echo to the VPD DRAFT Console Window the Values in the array !errors
  -- so that they are recorded in the "DM" initiated log file produced for "DM"
  do !output values !errors
--<nb>dec2009 (P-27364 : remove troublesome characters and flag error to DM
    !output = !output.replace('''','').replace('<','(').replace('>',')').replace('"','')
    !output = !output.replace('CRITICAL ERROR --','CRITICAL ERROR--')
    !output = !output.replace('ERROR --','(DM-MDS-ERROR)')
    !output = !output.replace('CRITICAL ERROR--','CRITICAL ERROR --')
    !output = !output.replace('Processing MDS Support: ','(DM) Starting to detail /')
    syscom 'echo $!output'
    handle ANY
      skip
    endhandle
  enddo
  --<wd>jul2006

  alpha log end

  !linesOfLogFile = !!readPdmsFile('/%pdmsuser%\dpc-alpha-log-$!unique')
  !remaining = ARRAY()
  !remaining.append(' Draft run-time warnings:')

  do !text values !linesOfLogFile
    skip if (!text.eq(''))
    skip if (!text.match('update drawing if necessary').neq(0))
    skip if (!text.match('Updating Design graphics').neq(0))
    skip if (!text.match('the specified point lies outside the VIEW').neq(0))
    skip if (!text.match('Catalogue error').neq(0))
    skip if (!text.match('Owning catalog').neq(0))
    skip if (!text.match('Data not accessible for codeword').neq(0))
    skip if (!text.match('Null text STRING for this codeword').neq(0))
    !remaining.append(!text.replace('WARNING:',''))
  enddo


  --q var !remaining

  if !remaining.size().eq(1) then
    syscom 'echo No Draft run-time WARNING found'
  else
    do !print values !remaining
      !print = !print.replace('$$',|(DOLLAR)|)
      syscom |echo $!print|
    enddo
  endif

  syscom 'del %pdmsuser%\dpc-alpha-log-$!unique'


endfunction
--------------------------------------------------------------------------------
-- End of Function
