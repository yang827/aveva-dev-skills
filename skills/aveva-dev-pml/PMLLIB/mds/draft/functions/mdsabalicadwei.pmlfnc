-- File:            mdsabalicadwei.pmlfnc
--   Type:          Function
--
-- Author:          Wayne Dodwell
-- Created:         Tuesday 12th January 2005
--
--
-- Description:
-- Function to obtain a MDS LICAD hangers total and individual weights
------------------------------------------------------------------------
------------------------------------------------------------------------
-- Define Function
  define function !!mdsabalicadwei(!hanger is dbref) is ARRAY

-- Initialise variables
    !ce = !!ce
    !weight[1] = 0

-- Find out if we are running from design or draft
    !banner = banner
    if !banner.name.upcase().match('DESIGN').gt(0) then
      !module = 'DESIGN'

--<wd>may2007<mds12>
--    elseif !Banner.name.upcase().match('OUTFITTING').gt(0) then
    elseif !banner.short.upcase().match('OUTFITTING MK').gt(0) then
--<wd>may2007<mds12>

      !module = 'DESIGN'
    else
      !module = 'DRAFT'
    endif

-- Access Hanger and Restraint from the ATTA on the Pipe branch
    !!ce = !hanger
    if !!ce.type.eq('ATTA') then
      goto cref
      rest
      handle any
        if !module.eq('DESIGN') then
          !!alert.error('Unable to access element type REST from this level')
          !!ce = !ce
          return !weight
        else
          !!abalogging.error('    Unable to access element type REST from this level')
          !!ce = !ce
          return !weight
        endif
      endhandle

--<wd>feb2005
    --!hangmem = !!mdsabamtosteel.data.dbrefs
-- Determine the <MDSABASUPPORT> OBJECT for the current MDS GROUP, FRAMEWORK or HANGER
      if (!hanger.name.matchwild('*[*')) then
        !restraint  = !!ce
        !mdsgroupbf = !hanger.name.before('[')
        !mdsgroupnm = !mdsgroupbf & '[1]'
        !mdsgroupdb = !mdsgroupnm.dbref()
        !mdsobject  = !!mdsabasuppobj(!mdsgroupdb)
        if (!mdsobject.mdsdata.mdsgroup) then
-- MDS HANGER belonging to a MDS GROUP
          var !restmem collect all hanger mem for $!restraint
          !hangmem = ARRAY()
          do !indx indices !restmem
            skip if !restmem[!indx].dbref().type.eq('REST')
            skip if !restmem[!indx].dbref().type.eq('HANG')
            !hangmem.append(!restmem[!indx])
          enddo
        endif

      else
-- Individual MDS HANGER NOT in a MDS GROUP
        !hangmem = !!mdsabamtosteel.data.dbrefs
      endif
--<wd>feb2005
    else
      -- Individual weight
      !hangmem = ARRAY()
      !hangmem.append(!!ce.string())
    endif
    !totalweight = 0
    !weights = ARRAY()

    do !getweight values !hangmem
      !!ce = !getweight.dbref()
      if (!!ce.type.neq('REST') and !!ce.type.neq('HANG') and !!ce.type.neq('TEXT')) then
        !weig = :ustweight of spref
        if !!ce.type.eq('TUBI') then
-- Lisega Threaded "Implied ROD" Weights are in "kg/m" units
          !itle = itle / 1000
        elseif !!ce.type.eq('WPAD') then
          !itle = 1
          --!Weig[1] = 0
          !Vol = nvol of $!!ce
          !Weig[1] = !Vol * 7850 / 1000 / 1000 / 1000
        elseif !Weig.size().gt(1) and ( !!ce.spref.name.after('/').after('/').matchwild('20?9*') or !!ce.spref.name.after('/').after('/').matchwild('R20?9*') )then
          !itle = 1
          !MinLength = !!ce.cpara[4]
          !ExtraLength = !!ce.prop.span.real()
          --!TempWeig = ( !weig[1] ) + ( !ExtraLength * !weig[2] / 1000 )
          !TempWeig = ( !weig[1] ) + ( (!ExtraLength - !minlength) * !weig[2] / 1000 )
          !weig[1] = !TempWeig
        elseif !Weig.size().gt(1) and ( !!ce.spref.name.after('/').after('/').matchwild('79??8*') or !!ce.spref.name.after('/').after('/').matchwild('R79??8*'))  then
          !itle = 1
          !Span = !!ce.prop.SPAN.real()
          !TempWeig =  ( !weig[1] ) + (( !Span   / 1000 ) * !weig[2] )
          !Weig[1] = !TempWeig
        elseif !Weig.size().gt(1) and ( !!ce.spref.name.after('/').after('/').matchwild('79??5*') or !!ce.spref.name.after('/').after('/').matchwild('R79??5*'))  then
          !itle = 1
          !Span = !!ce.prop.SPAN.real()
          !TempWeig =  ( !weig[1] ) + (( !Span   / 1000 ) * !weig[2] )
          !Weig[1] = !TempWeig
        elseif !Weig.size().gt(1) and ( !!ce.spref.name.after('/').after('/').matchwild('34P???') or !!ce.spref.name.after('/').after('/').matchwild('R34P???'))  then
          !itle = 1
          !Span = !!ce.prop.SPAN.real()
          !TempWeig =  (( !weig[1] ) + ( !Span  / 1000 ) * !weig[2] )
          !WeightofClevis = :ustweight of spref of nex
          !Weig[1] = ( !TempWeig + ( 2 * !WeightofClevis[1] ) )
        elseif !Weig.size().gt(1) then
          !itle = 1
          !Span = !!ce.prop.SPAN.real()
          !TempWeig =  ( !weig[1] ) + ((( !Span - 1000 ) / 100 ) * !weig[2] )
          !Weig[1] = !TempWeig
        elseif  !Weig.size().eq(0) then
          -- type 34SG
          -- We need to get weight from lisega Somehow
          !Weig[1] = !!ce.despara[13]
          handle ANY
            !Weig[1] = 0
          endhandle
          !itle = 1
        elseif  ( !!ce.spref.name.after('/').after('/').matchwild('37????') or !!ce.spref.name.after('/').after('/').matchwild('R37????') )  then
          !itle = 1
          !WeightofClevis = :ustweight of spref of nex
          !Weig[1] = !Weig[1] +  !WeightofClevis[1]
        else
-- Other Lisega "Hanger Elements" Weights are in "kg" units
          !itle = 1
        endif
        !weig[1] = !weig[1] * !itle
        !weights.append(!weig[1].real())
        handle (2,441)
          !weights.append(0)
          !name = !!ce.name
          !owner = !!ce.owner.name
          if !module.eq('DRAFT') then
            !!abalogging.error('    Unable to calculate the weight of $!Name')
          endif
          skip
        endhandle
        !totalweight = !totalweight + !weig[1].real()
      endif
    enddo

    !weights.append(!totalweight)
    !!ce = !ce

    return !weights

  endfunction
-------------- End Of mdsabalicadwei.pmlfnc Code --------------
