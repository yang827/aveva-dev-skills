--
-- File:            mdsabareplacemoveddims.pmlfnc
--   Type:          Function Definition
--   Group:
--     Keyword:
--   Module:        draft
--   Replaces:
--
-- Author:          Martin Ward
-- Created:         August 2008
--
-- Description: Move back any user modified Dimensions back to their original position
------------------------------------------------------------------------

define function !!mdsAbaReplaceMovedDims(!dummyParams is ARRAY)

  -- Check if regenerate mode if so don't do anything
  if (!!isPdms116()) then
    -- Current Software is PDMS11.6
    if (!!mdsAbaSelSupp.regenerateDrwg.val) then
      return
    endif
  else
    -- Current Software is PDMS11.5
    if (!!mdsAbaSelSupp.drwgOption.selection().eq('REGENERATE')) then
      return
    endif
  endif

  !shee = !!ce
  !find = object COLLECTION()
  !find.type('LAYE')
  !find.scope(!shee)
  !find.filter(object EXPRESSION('matchwild(NAME,|*Dims*|)'))
  !dimensionsLayers = !find.results()

  do !layer values !dimensionsLayers
    !!mdsAbaStoreDims(!layer.name)
  enddo

  if (!!mdsAbaSelSupp.movedDimensions.size() gt 0) then
    do !info values !!mdsAbaSelSupp.movedDimensions
      !!ce = !info[1].dbref()
      DPOS $!info[2]

   enddo
 endif

  -- Reset the LVIS of the layers
  do !info values !!mdsAbaSelSupp.dimLayers
    !!ce = !info[1].dbref()
    handle (2,109)
      -- Ignore just in case the layer has not been rebuilt
    elsehandle NONE
      LVIS $!info[2]
    endhandle
  enddo

endfunction
