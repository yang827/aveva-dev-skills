--
--
-- File:            mdsabareplacemovedtags.pmlfnc
--   Type:          Function Definition
--   Group:
--     Keyword:
--   Module:        draft
--   Replaces:
--
-- Author:          Martin Ward
-- Created:         August 2008
--
-- Description: Move back any user modified labels back to their original position
------------------------------------------------------------------------

define function !!mdsAbaReplaceMovedTags(!dummyParams is ARRAY)

  -- Check if regenerate mode if so don't do anything
  if (!!isPdms116()) then
    -- Current Software is PDMS11.6
    if (!!mdsAbaSelSupp.regenerateDrwg.val) then
      return
    endif
  else
    -- Current Software is PDMS11.5
    if (!!mdsAbaSelSupp.drwgOption.selection().eq('REGENERATE')) then
      return
    endif
  endif

  !shee = !!ce
  !find = object COLLECTION()
  !find.type('LAYE')
  !find.scope(!shee)
  !find.filter(object EXPRESSION('matchwild(NAME,|*Tags_Task|) or matchwild(NAME,|*_Dims|) or matchwild(NAME,|*MDS_FraTags|)'))
  !tagLayers = !find.results()

  do !layer values !tagLayers
    !!mdsAbaStoreTags(!layer.name)
  enddo

  do !info values !!mdsAbaSelSupp.movedLabels
    !!ce = !info[1].dbref()
    XYPOS $!info[2]
    ADEG  $!info[3]
    CPOFF $!info[4]
    BPOFF $!info[5]
    LVIS  $!info[6]
  enddo
  do !info values !!mdsAbaSelSupp.userLabels
    !!ce = !info[1].dbref()
    XYPOS $!info[2]
    ADEG  $!info[3]
    CPOFF $!info[4]
    BPOFF $!info[5]
  enddo

  -- Reset the LVIS of the layers
  do !info values !!mdsAbaSelSupp.tagLayers
    !!ce = !info[1].dbref()
    handle (2,109)
      -- Ignore just in case the layer has not been rebuilt
    elsehandle NONE
      LVIS $!info[2]
    endhandle
  enddo

endfunction
