--
-- Description: save any user modified dimensions
------------------------------------------------------------------------

define function !!mdsAbaSaveDims(!dummyParams is ARRAY)

  -- Check if regenerate mode if so don't do anything
  if (!!isPdms116()) then
    -- Current Software is PDMS11.6
    if (!!mdsAbaSelSupp.regenerateDrwg.val) then
      return
    endif
  else
    -- Current Software is PDMS11.5
    if (!!mdsAbaSelSupp.drwgOption.selection().eq('REGENERATE')) then
      return
    endif
  endif

  !!mdsAbaSelSupp.originalDimensions = ARRAY()
  !!mdsAbaSelSupp.movedDimensions    = ARRAY()
  !!mdsAbaSelSupp.dimLayers          = ARRAY()

-- Find all the tag tasks layers in the current view

  !view = !!ce
  !find = object COLLECTION()
  !find.type('LAYE')
  !find.scope(!view.owner)
  !find.filter(object EXPRESSION('matchwild(NAME,|*Dims*|)'))
  !dimensionsLayers = !find.results()

  -- Go to each layer and find out if there have been any labels repositioned by the user

  do !layer values !dimensionsLayers
    !!ce = !layer
    !temp = ARRAY()
    var !layerName name
    !temp.append(!layerName)
    var !layerVis lvis
    !temp.append(!layerVis)
    !!mdsAbaSelSupp.dimLayers.append(!temp)
    !movedDimensions = !!mdsAbaCheckDimsModified()

    if (!movedDimensions.empty().not()) then
      do !dimensions values !movedDimensions
        !temp = ARRAY()
        !!ce = !dimensions
        var !owner owner
        !temp.append(!owner)
        var !name name
        !temp.append(!name)
        var !dpos dpos
        !temp.append(!dpos)
--        var !getMovedDppt coll all dppt for ce
--        !number = !getMovedDppt.size()
--        !temp.append(!number)
--        do !dppt values !getMovedDppt
--          !!ce = !dppt.dbref()
--          !ddnm = !!ce.ddnm
--          !temp.append(!ddnm)
--        enddo
        !!mdsAbaSelSupp.originalDimensions.append(!temp)
      enddo
    endif
  enddo

  !!ce = !view

endfunction
