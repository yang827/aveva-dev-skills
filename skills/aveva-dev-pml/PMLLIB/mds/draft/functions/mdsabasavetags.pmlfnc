-- Created:         August 2008
--
-- Description: save any user modified tags
------------------------------------------------------------------------

define function !!mdsAbaSaveTags(!dummyParams is ARRAY)

  -- Check if regenerate mode if so don't do anything
  if (!!isPdms116()) then
    -- Current Software is PDMS11.6
    if (!!mdsAbaSelSupp.regenerateDrwg.val) then
      return
    endif
  else
    -- Current Software is PDMS11.5
    if (!!mdsAbaSelSupp.drwgOption.selection().eq('REGENERATE')) then
      return
    endif
  endif

  !!mdsAbaSelSupp.originalLabels = ARRAY()
  !!mdsAbaSelSupp.userLabels     = ARRAY()
  !!mdsAbaSelSupp.movedLabels    = ARRAY()
  !!mdsAbaSelSupp.tagLayers      = ARRAY()

-- Find all the tag tasks layers in the current view

  !view = !!ce
  !find = object COLLECTION()
  !find.type('LAYE')
  !find.scope(!view.owner)
  !find.filter(object EXPRESSION('matchwild(NAME,|*Tags_Task|) or matchwild(NAME,|*_Dims|) or matchwild(NAME,|*MDS_FraTags|)'))
  !tagLayers = !find.results()

  -- Go to each layer and find out if there have been any labels repositioned by the user

  do !layer values !tagLayers
    !!ce = !layer
    !temp = ARRAY()
    var !layerName name
    !temp.append(!layerName)
    var !layerVis lvis
    !temp.append(!layerVis)
    !!mdsAbaSelSupp.tagLayers.append(!temp)

    !movedLabels = !!mdsAbaCheckLabelModified()
    if (!movedLabels.empty().not()) then
      do !label values !movedLabels
        !temp = ARRAY()
        !!ce = !label
        var !owner owner
        !temp.append(!owner)
        var !name name
        !temp.append(!name)
        var !ddnm ddnm
        !temp.append(!ddnm)
        var !xypo xypos
        !temp.append(!xypo)
        var !adeg adeg
        !temp.append(!adeg)
        var !cpoff cpoff
        !temp.append(!cpoff)
        var !bpoff bpoff
        !temp.append(!bpoff)
        !sequence = !!ce.sequ
        !temp.append(!sequence)
        var !lvis lvis
        !temp.append(!lvis)
        !!mdsAbaSelSupp.originalLabels.append(!temp)
      enddo
    endif
  enddo

  -- add all tags in user tag layers
  !find = object COLLECTION()
  !find.type('GLAB')
  !find.addType('SLAB')
  !find.scope(!view.owner)
  !find.filter(object EXPRESSION('matchwild(NAME of OWNER,|*USER_Tags|) or matchwild(NAME of OWNER,|*USER_Labs|)'))
  !userLabels = !find.results()

  do !label values !userLabels
    !temp = ARRAY()
    !!ce = !label
    var !name name
    !temp.append(!name)
    var !xypo xypos
    !temp.append(!xypo)
    var !adeg adeg
    !temp.append(!adeg)
    var !cpoff cpoff
    !temp.append(!cpoff)
    var !bpoff bpoff
    !temp.append(!bpoff)
    !!mdsAbaSelSupp.userLabels.append(!temp)
  enddo

  !!ce = !view

endfunction
