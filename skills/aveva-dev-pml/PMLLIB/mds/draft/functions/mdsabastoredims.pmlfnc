-- Description: store any user modified Dimensions
------------------------------------------------------------------------

define function !!mdsAbaStoreDims(!layer is STRING)

  if (!!mdsAbaSelSupp.originalDimensions.empty().not()) then
    -- find out if any Dims in this layer have been moved and if so add them to the global variable

    do !info values !!mdsAbaSelSupp.originalDimensions
      if (!info[1] eq !layer) then
        -- Store the name of the new dimension that has been created along with its previously defined user position data
        !!ce = !layer.dbref()

        var !dimensions coll all (ldim adim) for ce
        do !dimension values !dimensions
          !!ce = !dimension.dbref()
          !dimensionName = !!ce.name
          !movedDimensionName = !!ce.name & '/moved'
          if (!dimensionName eq !info[2] or !movedDimensionName eq !info[2]) then
--            var !dppt coll all dppt for ce
--            if (!dppt.size() eq !info[5]) then
--              !count = 6
--              !same = TRUE
--              do !dimePoint values !dppt
--                !ddnm = !dimePoint.dbref().ddnm
--                if (!ddnm neq !info[!count]) then
--                  !same = FALSE
--                  break
--                else
--                  !count = !count + 1
--                endif
--              enddo
            !lock = lock
            if (!lock) then
              unlock
            endif
            !name = name
            if (matchwild(!name,'*moved')) then
            else
              !name = !!ce.name & '/moved'
              name $!name
            endif
            !temp = ARRAY()
            !temp.append(!name)
            !temp.append(!info[3])
            !!mdsAbaSelSupp.movedDimensions.append(!temp)
          endif
        enddo
      endif
    enddo
  endif
endfunction
