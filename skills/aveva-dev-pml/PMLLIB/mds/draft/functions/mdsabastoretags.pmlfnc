-- Created:         August 2008
--
-- Description: store any user modified tags
------------------------------------------------------------------------

define function !!mdsAbaStoreTags(!layer is STRING)

  if (!!mdsAbaSelSupp.originalLabels.empty().not()) then
    -- find out if any tags in this layer have been moved and if so add them to the global variable
    do !info values !!mdsAbaSelSupp.originalLabels
      if (!info[1] eq !layer) then
        -- Store the name of the new label that has been created along with its previously defined user position data

        !movedLabel = object DBREF()
        !ddnm     = !info[3]
        !sequence = !info[8]
        !find = object COLLECTION()
        !find.type('SLAB')
        !find.addType('GLAB')
        !find.scope(!layer.dbref())
        !find.filter(object EXPRESSION('name of ddnm eq !ddnm'))
        !labels = !find.results()
        if (!labels.empty()) then
          return
        elseif (!labels.size() eq 1 ) then
          !movedLabel = !labels[1]
        else
          do !label values !labels
            if( !label.sequ eq !sequence) then
              !movedLabel = !label
              break
            endif
          enddo
        endif
        if (!movedLabel.set()) then
          !!ce = !movedLabel
          --Now that we have the label it needs to be named because it has been created again
          --and will now no longer have a lastmod date in front of the layer created date
          -- only rename it if it does not have moved in the name
          !name = name
          if (matchwild(!name,'*moved')) then
          else
            if (!name.substring(1,1) eq '/') then
              !name = !!ce.name & '/moved'
            else
              !name = '/' & !!ce.name & '/moved'
            endif
            name $!name
          endif
          !temp = ARRAY()
          !temp.append(!name)
          !temp.append(!info[4])
          !temp.append(!info[5])
          !temp.append(!info[6])
          !temp.append(!info[7])
          !temp.append(!info[9])
          !!mdsAbaSelSupp.movedLabels.append(!temp)
        endif
      endif
    enddo
  endif
endfunction
