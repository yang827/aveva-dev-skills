--
-- File:		mdsabasuppobj.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		PDMS Draft using ABA
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 26th January 2005
--
--
-- Description:
-- Function to determine which object <MDSABASUPPORT> ascertains to the MDS Support
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R        DBREF        MDS Support <MDS FRAMEWORK or ATTA for HANGER>
--
-- Return:
--    [Data Type]   [Description]
--     1      R     <MDSABASUPPORT> object for the passed MDS Support DBREF
--
--------------------------------------------------------------------------------
-- Define Function

 define function !!mdsabasuppobj(!support is dbref) is MDSABASUPPORT

-- Find the MDS Support OBJECT associated with this ABA Drawing
   !mdsabasupp = !support

-- Find the Index of the MDSSUPPORT Object Data Array for the current MDS Support
-- MDSSUPPORT Object Data Array = !!mdsabaselsupp.mdssupports
   !objsupp   = false
   !objindex  = 0
   !mdsobject = object mdsabasupport()
   do !indx indices !!mdsabaselsupp.mdssupports
     if (!!mdsabaselsupp.mdssupports[!indx].support.eq(!mdsabasupp)) then
       !objindex  = !indx
       !mdsobject = !!mdsabaselsupp.mdssupports[!indx]
       !objsupp   = true
       break
     else
       skip
     endif
   enddo

-- Return the MDSSUPPORT Object for the passed MDS Support
   return !mdsobject

 endfunction
-- End of Function - mdsabasuppobj.pmlfnc
--------------------------------------------------------------------------------
