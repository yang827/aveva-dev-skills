--
-- File: mdsabaxyzdrtmpl.pmlfnc
--   Type   : Function Definition
--   Group  : MDS ABA Automatic MDS support ABA Drawing Templates
--   Keyword: ABA
--   Module : Draft
--   Replaces:
--
-- Author: Wayne Dodwell
-- Created: Friday 14th March 2008
--
--
-- Description:
-- Function Definition for Copying the EXISTING standard
--  PDMS COORD "ENU" MDS ABA DRTMPLS to NEW COORD "XYZ" MDS ABA DRTMPLS
--
---------------------------------------------------------------------------------------------------------
define function !!mdsabaxyzdrtmpl(!mdsabadrtmpl is DBREF)

-- Check if the ABA DRTMPL EXISTS and is OPEN in WRITE MODE
  !xce = !!ce
  !!ce = !mdsabadrtmpl
  handle ANY
    !!alert.error('The passed MDS ABA Drawing Template Library does NOT exist. ABORTING the creation of the XYZ copies of the MDS ABA XYZ DRTMPLS')
    return
  elsehandle NONE
-- DRTMPL exists, but is the DB open for WRTITE access
    if (!mdsabadrtmpl.dbwrite.not()) then
      !mdsabaname = !mdsabadrtmpl.namn
      !!alert.error('The MDS ABA Drawing Template Library $!mdsabaname exists, but the DB is READ ONLY. ABORTING the creation of the XYZ copies of the MDS ABA XYZ DRTMPLS')
      return
    endif
  endhandle

-- Collect all the EXISTING copies of MDS ABA Drawing Templates in the passed Library
  var !mdsabacoll coll all DRTMPL for $!mdsabadrtmpl
  var !mdsabaeval eval name for all from !mdsabacoll

-- Process the Array of Existing MDS ABA Drawing Templates
  !xyzmdsaba = ARRAY()
  do !name values !mdsabaeval
    !!ce = !mdsabadrtmpl
    last mem
--!test = (matchwild(!name,'*XYZ*'))
--q var !test
-- Create the NEW XYZ MDS ABA DRTMPLS -- SKIP existing XYZ DRTMPLS
    if (matchwild(!name,'*XYZ*')) then
-- Append to the array any existing "XYZ" named MDS ABA DRTMPLS
      !xyzmdsaba.append(!name.dbref())
      skip
    else
--  Determine the EXISTING name prefix, unots and suffix of the MDS ABA Drawing Template
      !prefixname = !name.before('(')
      !suffixname = !name.after(')')
      !unitsused  = !name.before(')').after('(')
-- Determine the new XYZ DRTMPL name
      !xyzname = !prefixname & '(XYZ-' & !unitsused & ')' & !suffixname
-- Test and SKIP if the !xyzname DRTMPL already exists
      !!ce = !xyzname.dbref()
      handle NONE
-- DRTMPL already exists -- Append to the array any existing "XYZ" named MDS ABA DRTMPLS and SKIP
        !xyzmdsaba.append(!name.dbref())
        skip
      elsehandle (2,107) (2,109)
-- Undefined DBREF or NAME
-- Copy and Rename the EXISTING copies of the MDS ABA Drawing Templates to NEW XYZ DRTMPLS
        new drtmpl $!xyzname copy $!name rename $!name $!xyzname
        !xyzmdsaba.append(!!ce)
      endhandle
    endif
  enddo

-- Set the POSFORMAT attribute of all required elements in the NEW XYZ DRTMPLS to XYZ
  !xyzmdsaba.unique()
  do !xyzdbref values !xyzmdsaba
    var !allmembers coll all for $!xyzdbref
-- Loop through every member and set POSFORMAT XYZ where allowed
    do !member values !allmembers
      !!ce = !member.dbref()
--$P -- q fullname --
--q fullname
--$P====================
      skip if !member.matchwild('*(METRIC)*')
      posformat XYZ
      handle ANY
        skip
      endhandle
    enddo
  enddo

-- Navigate back the Original Element
  !!ce = !xce
endfunction
