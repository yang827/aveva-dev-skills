------------------------------------------------------------------------
--
-- File:            mdsfragettext.pmlfnc
--   Type:          Function
--
-- Author:          Anil Kumar
-- Created:         15 Feb 2005
--
-- Description:
-- Basic task to create title block information
-- This relies on texp elements being created in the template
-- These will be stored a note element called (template name)/TITLEBLOCK
------------------------------------------------------------------------
-- Argument will be used to evaluate the btex value for the Title Block Info
--
-- ARGUMENTS:
-- <1> = SuppName = DBREF of the Support (if called during MDS ABA DRAWING Generation of a MDS Support)
--    or
-- <1> = Suppname = Object MDSVPRMMTO - MDS-VPRM Support Object (if called from DESIGN MDS-VPRM MTO Generation)
--
-- <2> = Keyword  = Information required from the MDS Support
--
------------------------------------------------------------------------

define function !!mdsfragettext(!suppRef is ANY,!keyword is STRING) is ANY

  !ce = !!ce
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
--<wd>30mar2005
-- Modified Code to work in PDMS DESIGN as well as PDMS DRAFT
--
--  !suppName    = !suppRef.name
--  !suppEleType = !suppRef.type

---------------------------------------------------------------------------------------------------
-- Determine the PDMS Module
-- <DESIGN> for BULK MTO per Estimate for Passed Pipes/HVAC elements
-- <DRAFT>  for ACTUAL MTO per MDS ABA Support DRAWING
-- <ISODRAFT> for ?? PIPE MTO for MDS Supports per PIPE -- ?? FUTURE ??
   !banner = banner
   if (!banner.name.upcase().match('DESIGN').gt(0)) then
     !module  = 'DESIGN'
     --!version = !banner.short.split()[4].after('Mk').before('.SP')
--<wd>may2007<mds12>
--    elseif (!banner.name.upcase().match('OUTFITTING').gt(0)) then
    elseif !banner.short.upcase().match('OUTFITTING MK').gt(0) then
--<wd>may2007<mds12>

     !module  = 'DESIGN'

--<wd>may2007<mds12>
--   elseif (!banner.name.upcase().match('DRAFT').gt(0)) then
   elseif (!banner.name.upcase().match('DRAFT').gt(0)) or (!banner.name.upcase().match('OUTFITTINGDRAFT').gt(0)) then
--<wd>may2007<mds12>
     !module = 'DRAFT'
     --!version = !banner.short.split()[4].after('Mk').before('.SP')

-- FUTURE --??maybe??   --elseif (!banner.name.upcase().match('ISODRAFT').gt(0)) then
     --!module = 'ISODRAFT'
   endif

   if (!module.eq('DESIGN')) then
     if (!suppRef.objecttype().eq('MDSPIPEREPORT')) then
       !noOfPipes = ARRAY()
       !suppName    = !suppRef.supportNumber
       !suppEleType = !suppRef.support.type
-- mjb >>> 07.03.06 !noOfPipes set to !suppRef.pipelist (list of supported pipes) instead of
      -- mjb >>> !supref.datum (datum atta pipe) for calculation of support spec, RCC-M code and safety class
       --!noOfPipes.append(!suppRef.datum)
       !noOfPipes = !suppRef.pipelist
-- mjb <<< end of mod
     else
-- EXTRA PML CODE for DESIGN -- BULK MDS-VPRM MTO file Generation
       !mdsObject = !suppRef
-- Determine if MDS  Support belongs to a MDS Group Support
--     if (!mdsObject.mdsgroup) then
         !noOfPipes = !mdsObject.allmem
--       !noOfPipes = !mdsObject.mainmem
         !!pp = !noOfPipes
--     endif
       !suppName    = !mdsObject.support.name
       !suppEleType = !mdsObject.supptype
     endif

   elseif (!suppRef.objecttype().eq('MDSPIPEREPORT')) then
       !noOfPipes = ARRAY()
       !suppName    = !suppRef.supportNumber
       !suppEleType = !suppRef.support.type
-- mjb >>> 07.03.06 !noOfPipes set to !suppRef.pipelist (list of supported pipes) instead of
    -- mjb >>> !supref.datum (datum atta pipe) for calculation of support spec, RCC-M code and safety class
       --!noOfPipes.append(!suppRef.datum)
       !noOfPipes = !suppRef.pipelist
-- mjb <<< end of mod
   elseif (!module.eq('DRAFT')) then

     if (!suppRef.objecttype().eq('DBREF')) then

-- ORIGINAL PML CODE for DRAFT uses a <DBREF>
-- MDS ABA DRAWING Generation
       !suppName    = !suppRef.name
       !suppEleType = !suppRef.type

-- Use MDSOBJECT
       !mdsObject = !!mdsAbaSuppObj(!suppName.dbref())

   --  !noOfPipes = !mdsObject.mdsdata.members
-- Find whether Support is MDS Group or not
       if !mdsObject.mdsdata.mdsgroup then
         !noOfPipes = !mdsObject.mdsdata.allgroupmem
       else

         !noOfPipes = !mdsObject.mdsdata.members

       endif

     elseif (!suppRef.objecttype().eq('MDSVPRMMTO')) then
-- EXTRA PML CODE for DRAFT -- ACTUAL MDS-VPRM MTO file Generation
       !mdsObject = !suppRef

-- Determine if MDS  Support belongs to a MDS Group Support
--     if (!mdsObject.mdsgroup) then
       !noOfPipes = !mdsObject.allmem
       !!pp = !noOfPipes
       !suppName    = !mdsObject.support.name
       !suppEleType = !mdsObject.supptype
     endif
   endif
---------------
--<wd>30mar2005


-- This is common routine which will evaluate the required
-- attribute for the PIPE (REPLACE THE TEMPORARY ATTRIBUTES USED WITH UDA WHEN AVAILABLE)
-- Function attribute is used for Support Specification
-- Duty attribute is used for Safety Class of Supports

    !suppSpec = ARRAY()
    !sftyClass = ARRAY()
    do !loopThrough indices !noOfPipes
       if (!noOfPipes[$!loopThrough].type.eq(|ATTA|) and !noOfPipes[$!loopThrough].name.occurs(|SREF|).eq(0))then
      --          !sSpec = !noOfPipes[$!loopThrough].own.own.$!!aNPUDAQCL
      !sSpec = $!!aNPUDAQCL of pipe of $!noOfPipes[$!loopThrough]
      handle(99,532)(2,204)
                !sSpec = !noOfPipes[$!loopThrough].own.own.func
      endhandle
      --          !sClas = !noOfPipes[$!loopThrough].own.own.$!!aNPUDASCL
      !sClas = $!!aNPUDASCL of pipe of $!noOfPipes[$!loopThrough]
      handle(99,532)
               !sClas = !noOfPipes[$!loopThrough].own.own.duty
             endhandle
          !suppSpec.append(|$!sSpec|)
          !sftyClass.append(|$!sClas|)
       endif
    enddo

  -- find the Main ATTA: SuppName/DATUM for Standard, [2] for complex ([1]/DATUM if not PIPE-REST) or SuppName for hanger
  -- Master is used for keywords ROOM, EAREA
  !datum = '$!suppName/DATUM'
  !masterStype = !datum.dbref().stype
  handle ANY
    !master = !suppName
  elsehandle NONE
    if !masterStype.eq('PIPE-REST') then
      !master = !suppName.replace('[1]','[2]')
    else
      !master = !datum
    endif
  endhandle

  -- ROOM is used for ROOM, LEVEL, BUILD
  !room = $!!aNPUDAROOM of $!master
  !room = trim (!room)
  if !room.match('/').eq(1) then
    !room = !room.after('/')
  else
    !room = ''
  endif

  if !keyword.eq('CONS') then
-- To find out value of Construction Type [2]
    if ('$!!currentproject' eq 'OLC') then
    !mdsConfig = :MdsConfig of $!suppName/DATUM
      handle ANY
        !mdsConfig = :MdsConfig of $!suppName
      elsehandle NONE
      endhandle

    if !mdsConfig.eq('unset') then
      !string = 'FIN005-C-' + !suppName.after(|/|)
    else
      !string = !mdsConfig
    endif
    elseif ('$!!currentproject' eq 'TSN') then
      !unit = !suppName.substring(2,1)
      if !unit eq '1' then
        !unit = 'X'
      endif
      !string = 'TS-$!unit-NIEP-NPTJP-' + !suppName.after(|/|)
    endif

  elseif !keyword.eq('DEPT') then
-- To find out value of Department of Examiner [8]
-- :MDSComment UDA is used temporarily, replace this with the
-- actual UDA when available
-- Capture the attribute value
    if ('$!!currentproject' eq 'OLC') then
      if !suppEleType.eq(|ATTA|) then
        !dEPT = $!!aNPUDASCOPE of pipe of $!suppRef
        handle(99,532)
          !dEPT = !suppRef.own.own.:MDSComment
        endhandle
      elseif !suppEleType.eq(|STRU|) then
        !dEPT = $!!aNPUDASCOPE of $!suppRef
        handle(99,532)
          !dEPT = !suppRef.:MDSComment
        endhandle
      endif
      --Check the attribute value & replace with relevant value
      if !dEPT.eq(|GMBHERL|) then
        !string = |NESP-G|
      elseif !dEPT.eq(|GMBHOFF|) then
        !string = |NESP-G|
      elseif !dEPT.eq(|SAS|) then
        !string = |NESPFE|
      elseif !dEPT.eq(|SFLY|) then
        !string = |NESP-G|
      elseif !dEPT.eq(|SFLZ|) then
        !string = |NESP-G|
     else
        !string = |unset|
      endif
    elseif ('$!!currentproject' eq 'TSN') then
      !string = |NPTJP|
     endif

  elseif !keyword.eq('SPEC') then
-- To find out value of Support Specification [22]
    !suppSpec.sort()
    !suppSpec.invert()

    if (!suppSpec[!suppSpec.size()].eq(|Q1|) or !suppSpec[!suppSpec.size()].eq(|Q2|) ) then
          !string = |PS4576.1|
    elseif ( !suppSpec[!suppSpec.size()].eq(|Q3|)) then
          !string = |PS4576.2|
       else
          !string = |unset|
       endif

  elseif !keyword.eq('SC') then

-- To find out value of Safety Class of Support [23]
    !suppSpecSort = !suppSpec

-- mjb >>> 23.02.06 Problem with support safety class with QC3 pipes corrected
    !sortedindices = !suppSpecSort.sortedindices()
    !findSCIndx = !sortedindices[1]

    --!suppSpecSort.sort()
    --!suppSpecSort.invert()
    --!maxSpec = !suppSpec.size()
    --!findSCIndx = !suppSpec.findfirst(|$!suppSpecSort[$!maxSpec]|)

    if !suppSpec[$!findSCIndx].eq(|Q1|) then
      !string = |S1|
      !qclass = |Q1|
    elseif !suppSpec[$!findSCIndx].eq(|Q2|) then
      !string = |S2|
      !qclass = |Q2|
    elseif !suppSpec[$!findSCIndx].eq(|Q3|) then
      !string = |S2|
      !qclass = |Q3|
    elseif !suppSpec[$!findSCIndx].eq(|NC|) then
      !string = |S2|
      !qclass = |NC|
-- mjb <<< end of mod
    else
       !string = |unset|
-- Quality Class is used by BOTH the MDS VPRM MTO and the MDS ABA DRAWING utilities, therefore Always Return a Quality Class.
       !qclass = !suppSpec[$!findSCIndx]
       handle ANY
         !qclass = 'unset'
       elsehandle NONE
         if (!qclass.eq('')) then
           !qclass = 'unset'
         endif
       endhandle
    endif

  elseif !keyword.eq('RCCM') then
-- To find out value of RCC-M of Support [23a]
    !suppSpecSort = !suppSpec
    !suppSpecSort.sort()
    !suppSpecSort.invert()
    !maxSpec = !suppSpec.size()
    !findSpec = !suppSpecSort [$!maxSpec]
    !findSCIndx = !suppSpec.findfirst(!findSpec)
    if ('$!!currentproject' eq 'TSN') then
      if !findSpec.eq(|Q1|) then
        !string = 'S1'
      elseif (!findSpec inset(|Q2|,|Q3|)) then
        !string = 'S2'
      elseif !findSpec.eq(|NC|) then
        !string = 'S2'
      else
        !string = 'unset'
      endif
    else
    if !suppSpec[$!findSCIndx].eq(|QC1|) then
       !string = |S1|
--    elseif !suppSpec[$!findSCIndx].eq(|QC2|) then
    elseif (!suppSpec[$!findSCIndx] inset(|QC2*|,|QC2|)) then
         !string = |S2|
--    elseif (!suppSpec[$!findSCIndx] inset(|QC2*|,|QC3|)) then
    elseif !suppSpec[$!findSCIndx].eq(|QC3|) then
         !string = |-|
    else
       !string = |unset|
    endif
    endif

  elseif !keyword.eq('EAREA') then
-- To find out Erection Area of Support [24]
    -- SuppName = #[1] if grouped
    -- find the Main ATTA: SuppName/DATUM for Standard, [2] for complex ([1]/DATUM if not PIPE-REST) or SuppName for hanger
    !eArea = :MTOAREA of $!master
    !string = |$!eArea|

  elseif !keyword.eq('ROOM') then
-- To find out Room Number of Support [25]
    !string = !room

  elseif !keyword.eq('WPACK') then
-- To find out value of Work Package Number [27]
-- :MDSComment UDA is used temporarily, replace this with the
-- actual UDA when available
-- Capture the attribute value

    if ('$!!currentproject' neq 'TSN') then

      if !suppEleType.eq(|ATTA|) then
        !wPack = $!!aNPUDASCOPE of pipe of $!suppRef
        handle(99,532)
          !wPack = !suppRef.own.own.:MDSComment
        endhandle
      elseif !suppEleType.eq(|STRU|) then
        !wPack = $!!aNPUDASCOPE of $!suppRef
        handle(99,532)
          !wPack = !suppRef.:MDSComment
          endhandle
     endif

     !suppName3to5 = !suppRef.namn.substring(3,3)

-- Check the attribute value & 3rd to 5th character of Support Name
-- and replace with relevant value
      if !wPack.eq(|SAS|) then
        !string = |NI-1-6411|
      elseif !wPack.eq(|GMBHERL|) then
        !string = |NI-1-6426|
      elseif (!wPack.eq(|SFLY|) and ((!suppName3to5.eq(|UJA|)) or !suppName3to5.eq(|UJB|) or !suppName3to5.eq(|UJP|))) then
        !string = |NI-1-6436|
      elseif (!wPack.eq(|SFLZ|) and ((!suppName3to5.eq(|UJE|)) or !suppName3to5.eq(|UJH|) or !suppName3to5.eq(|UJK|))) then
        !string = |NI-1-6446|
      elseif (!wPack.eq(|SFLY|) and (!suppName3to5.eq(|UFA|))) then
        !string = |NI-1-6456|
      elseif (!wPack.eq(|SFLZ|) and (!suppName3to5.eq(|UKA|))) then
        !string = |NI-1-6466|
      elseif (!wPack.eq(|GMBHOFF|) and (!suppName3to5.eq(|UKE|))) then
        !string = |NI-1-6516|
      elseif (!wPack.eq(|GMBHOFF|) and (!suppName3to5.eq(|UQB|))) then
        !string = |NI-1-6526|
      elseif (!wPack.eq(|GMBHOFF|) and (!suppName3to5.eq(|UKS|))) then
        !string = |NI-1-6546|
      elseif (!wPack.eq(|GMBHOFF|) and ((!suppName3to5.eq(|UMZ|)) or !suppName3to5.eq(|UQZ|))) then
        !string = |NI-1-6556|
      elseif (!wPack.eq(|SFLZ|) and !suppName3to5.eq(|UMZ|)) then
        !string = |NI-1-6556|
      elseif (!wPack.eq(|SFLY|) and !suppName3to5.eq(|UBP|)) then
        !string = |NI-1-6536|
     else
        !string = 'unset'
     endif

    else
      !dbname = !suppRef.dbname
      if matchwild(!dbname,'*/RB-N3S2*') then
        !string = |NI1-EDC|
      elseif matchwild(!dbname,'*/RB-BNI2*') then
        !string = |NI1-EDH3|
      elseif matchwild(!dbname,'*/SB*') then
        !string = |NI1-EDI3|
      elseif matchwild(!dbname,'*/FB*') then
        !string = |NI1-EDJ3|
      elseif matchwild(!dbname,'*/NB*') then
        !string = |NI1-EDK3|
      elseif matchwild(!dbname,'*/AB*') then
        !string = |NI1-EE63|
      elseif matchwild(!dbname,'*/SWP*') then
        !string = |NI1-EE73|
      elseif matchwild(!dbname,'*/DB*') then
        !string = |NI1-EE83|
      elseif matchwild(!dbname,'*/WB*') then
        !string = |NI1-EE93|
      elseif matchwild(!dbname,'*/QA*') then
        !string = |NI1-EE93|
      elseif matchwild(!dbname,'*/CHB*') then
        !string = |NI1-EEA3|
      else
        !string = |unset|
      endif
    endif

  elseif !keyword.eq('DCC') then
-- Type of Drawings is fixed [30]
    !string = 'MTB'


  elseif !keyword.eq('CCODE') then
-- Company Code is assumed to be based on the name of SHTMPL
    !linkRef = LinkRef of Shee
-- EWE
    if !linkRef.namn.occurs(|EWE|).gt(0) then
      !string = |0EEM|
-- K&V
    elseif !linkRef.namn.occurs(|K&V|).gt(0) then
      !string = |0KVI|
--Peters
    elseif !linkRef.namn.occurs(|PETERS|).gt(0) then
      !string = |0PEA|
-- Sofinel
    elseif !linkRef.namn.occurs(|SOFI|).gt(0) then
      !string = |SFL|
-- Nordon
    elseif !linkRef.namn.occurs(|NORDON|).gt(0) then
      !string = |NDN|
    else
-- This is then either FANP Erlangen or FANP Paris
      -- This can be found from the $!!aNPUDASCOPE of the stru or
      -- the FRA.sCOPE of the pipe if a stru cannot be found
      if !suppEleType.eq(|ATTA|) then
        !sCOPE = $!!aNPUDASCOPE of pipe of $!suppRef
          handle(99,532)
          !sCOPE = !suppRef.own.own.:MDSComment
        endhandle
      elseif !suppEleType.eq(|STRU|) then
        !sCOPE = $!!aNPUDASCOPE of $!suppRef
        handle(99,532)
          !sCOPE = !suppRef.:MDSComment
        endhandle
      endif
      --Check the attribute value & replace with relevant value
      if !sCOPE.eq(|SAS|) then
         !string = |FFP|
      elseif !sCOPE.eq(|GMBHOFF|) then
         !string = |FGF|
      elseif !sCOPE.eq(|SAS|) then
         !string = |FGF|
      elseif !sCOPE.eq(|SFLY|) then
        !string = |FGF|
      elseif !sCOPE.eq(|SFLZ|) then
        !string = |FGF|
      else
        !string = |unset|
      endif
    endif

  elseif !keyword.eq('STATUS') then
-- Support Status
     !status = :MMSSTATUS of $!suppRef
       handle ANY
         !status = :STATUS of $!suppRef
       endhandle
     !statusReal = !status.before('#').real()
       handle ANY
         !statusReal = 0
       endhandle
     if !statusReal.unset() then
       !statusReal = 0
     endif
     if !statusReal.lt(70) then
       !string = 'PREL'
     else
       !string = 'FIN'
     endif

  elseif !keyword.eq('BUILD') then
    !string = Substring(!room,1,4)

  elseif !keyword.eq('LEVEL') then
    !string = substring(!room,5,2)

  else
    !string = 'error'
  endif

  if !string.occurs(|[|).geq(1) then
    !string = !string.before(|[|)
  endif

  -- Variable !classarray is ONLY returned for the BULK MDS-VPRM MTO
  -- Therefore Return an ARRAY i.e. [1] = Quality Class and [2] = Safety Class
  !classarray = ARRAY()
  !classarray[1] = !qclass
  handle ANY
    !classarray[1] = ''
  endhandle
  !classarray[2] = !string

--<wd>mar2005 -- Test added for use with MDS VPRM MTO
  if  (!suppRef.objecttype().eq('MDSPIPEREPORT'))   then
    if (!keyword.eq('SC')) then
      if (defined(!!mdsfanpqclass)) then
        !!mdsfanpqclass.delete()
      endif
      !!mdsfanpqclass = !qclass
      handle ANY
        !!mdsfanpqclass = ' '
      endhandle
    endif
    return !string

  elseif ( (!module.eq('DESIGN')) or  ((!module.eq('DRAFT')) and (!suppRef.objecttype().eq('MDSVPRMMTO'))) ) then
-- "BULK"<DESIGN> and "ACTUAL"<DRAFT> MDS VPRM MTO output file generation
    if (!keyword.eq('SC')) then
      if (defined(!!mdsfanpqclass)) then
        !!mdsfanpqclass.delete()
      endif
      !!mdsfanpqclass = !qclass
      handle ANY
        !!mdsfanpqclass = ' '
      endhandle
    endif

    return !classarray

  elseif (!module.eq('DRAFT')) then
    btex |$!string|

-------------
--<wd>jun2005
-- This function is being called from the FANP PML task "!!mdstitleblock.pmlfnc", and it is SET as the "BTEX" attribute(see above).
-- Therefore to get the "Quality Class" it is necessary to store it in a Global variable "!!mdsfanpqclass" as NOTHING is RETURNED
-- from this function in this mode!
--
-- The Global variable "!!mdsfanpqclass" is used to STORE the HIGHEST Quality Class<QC> Pipe on the MDS Support
    if (!keyword.eq('SC')) then
      if (defined(!!mdsfanpqclass)) then
        !!mdsfanpqclass.delete()
      endif
      !!mdsfanpqclass = !qclass
      handle ANY
        !!mdsfanpqclass = ' '
      endhandle
    endif
--<wd>jun2005
-------------

  endif
--<wd>mar2005

  !!ce = !ce
endfunction
