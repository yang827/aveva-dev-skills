--
-- File:            mdsgetpiperep.pmlfnc
--   Type:          Function
--
-- Author:          D T Flannery
-- Created:         30 Jan 2006
--
-- Description:
-- Basic function to run pipe report object
-- and to write files to stored directory
------------------------------------------------------------------------
-- Argument
--
--
------------------------------------------------------------------------

define function !!mdsgetpiperep(!params is ARRAY)


--  Check to see if model manager running
  if defined(!!mdsabadpcvar) then
    if !!mdsabadpcvar.not() then
      --$P Model Manager not running
      return
    endif
  else
    --$P 2 Model Manager not running
    return
  endif



  !ce = !!ce

  shee
  !sheet = !!ce.name

-- Find support name
  !SuppName = !!ce.darref.name.before('-AREA')

-- If the support does not exist it may be a group
  $!SuppName
    handle NONE
      !Group = FALSE
      !SuppID = !SuppName
    elsehandle ANY
      !SuppName = '$!SuppName[1]'
      !Group = TRUE
      !SuppID = !SuppName.before('[1]')
    endhandle

-- Return to SHEET
  $!sheet

-- Project Code & Session data
  !proj    = current project
  !code    = !proj.code()
  !projlow = !code.lowcase()
  !projup  = !code
  !projdir = object file ('%$!<projlow>iso%')

-- Get the PDMS USER ID
-- Test for "Model OBJECT Manager" running
-- i.e. the user description is set with the string "login Id:"
  !session = current session
  if (!session.user().description.match('login Id:').neq(0)) then
    !userid = !session.user().description.after('login Id:').before('(').trim()
  else
    !userid = !session.login
  endif

-- Determine the Project INFO directory and the MDS Drawing Reports FILE Storage Directory
  !infodir = object file ('%$!<code>info%')
  if (!infodir.exists()) then
    !mtodir = object file ('%$!<code>info%\MDS-DRAW-REPORTS')
    if (!mtodir.exists().not()) then
      syscom 'mkdir $!mtodir'
    endif

  else
-- ONLY when the MDS PROJECT INFO Directory DOES NOT EXIST, i.e. !infodir
-- Use the %PDMSUSER% Directory to create the MDS Drawing Reports FILE Storage Directory
    !mtodir = object file ('%pdmsuser%\MDS-DRAW-REPORTS')
    if (!mtodir.exists().not()) then
      syscom 'mkdir $!mtodir'
    endif
  endif



  -- Set the MDS Pipereport File
   !PipeReportfilename  = !mtodir.fullname()  & !SuppID & '.001' & '.csv'
   !PipeReportfile = object file(!PipeReportfilename)

  -- Set the MDS Pipereport log
   !PipeReportlogname  = !mtodir.fullname()  & !SuppID & '.001' & '.log'
   !PipeReportlog = object file(!PipeReportlogname)


-- Set the Temporary Storage Directory to PDMSWK
  --!tmtodir = object file ('c:\temp')
  -- Set the temp MDS Pipereport File
  -- !tPipeReportfilename  = !tmtodir.fullname() & '\' & !SuppID & '.001' & '.csv'
  -- !tPipeReportfile = object file(!tPipeReportfilename)

  -- Set the temp MDS Pipereport log
  -- !tPipeReportlogname  = !tmtodir.fullname() & '\' & !SuppID & '.001' & '.log'
  -- !tPipeReportlog = object file(!tPipeReportlogname)

-- Construct END Date Time String
  !mdssupportmtostart     = object mdsdatetimeobj()
  !mdssupportmtostartstr = !mdssupportmtostart.datetimestr


-- Set up the Header Details for the LOG file Array
  !errlogstart = ARRAY()
-- Log file START etc... is Only required when generating MDS pipe report MTO files from PDMS DRAFT
  !errlogstart.append('_________________________________________________________________________')
  !errlogstart.append('')
  !errlogstart.append('                         MDS SUPPORT MTO "$!SuppID" REP                           ')
  !errlogstart.append('')
  !errlogstart.append('_________________________________________________________________________')
  !errlogstart.append('')
  !errlogstart.append('LOG file for the "MDS Support MTO" $!SuppID file:')
  !errlogstart.append(' $!PipeReportfile')
  !errlogstart.append('_________________________________________________________________________')
  !errlogstart.append('')
  !errlogstart.append('Project    : $!projup')
  !errlogstart.append('User Name  : $!session.name')
  !errlogstart.append('User Login : $!userid')
  !errlogstart.append('Host       : $!session.host')
  !errlogstart.append('Process ID : $!session.uniqueid')
  !errlogstart.append('Date       : $!<mdssupportmtostart.daystring> $!<mdssupportmtostart.monthstring> $!<mdssupportmtostart.year>')
  !errlogstart.append('Time       : $!<mdssupportmtostart.hourstring>:$!<mdssupportmtostart.minutestring>:$!<mdssupportmtostart.secondstring>')
  !errlogstart.append('_________________________________________________________________________')
--  !errlogstart.append('')
--  !errlogstart.append('Processing Started:')
  !errlogstart.append('_________________________________________________________________________')
  !errlogstart.append('')
---------------------------------------------------------------------------------------------------

  !errlogend = ARRAY()
-- Start Log files
  !PipeReportlog.writefile('OVERWRITE',!ErrLogStart)
  --!tPipeReportlog.writefile('OVERWRITE',!ErrLogStart)


-- Get report data
  !obj = object mdspipereport(!SuppName.dbref())
  !rep = !obj.getoutput(FALSE)

  !PipeReportfile.writefile('OVERWRITE',!rep)
  handle ANY
    !errlogend.append(!!error.text)
  endhandle
  --!TPipeReportfile.writefile('OVERWRITE',!rep)
  handle ANY
    !errlogend.append(!!error.text)
  endhandle


-- Construct END Date Time String
  !mdssupportmtoend      = object mdsdatetimeobj()
  !mdssupportmtoendstr = !mdssupportmtoend.datetimestr

-- Set the END Process Complete Date and Time etc...

  !errlogend.append('________________________________________________________________________')
  !errlogend.append('Processing Complete: $!<mdssupportmtoend.hourstring>:$!<mdssupportmtoend.minutestring>:$!<mdssupportmtoend.secondstring>  $!<mdssupportmtoend.daystring> $!<mdssupportmtoend.monthstring> $!<mdssupportmtoend.year>')
  !errlogend.append('________________________________________________________________________')
  !errlogend.append('_________________________________________________________________________')

-- Set up the END of ERROR LOG Array to append to the ERROR LOG file "!errorlog" on "return" of this function
  !errlogend.append('END of LOG file for the "MDS Support-MTO" $!SuppID file:')
  !errlogend.append(' $!PipeReportfile')
  !errlogend.append('_________________________________________________________________________')
  !errlogend.append('_________________________________________________________________________')
  !errlogend.append('')
  !errlogend.append('<EOF>')


  -- Complete error log
  !PipeReportlog.writefile('APPEND',!ErrLogEnd)
  --!tPipeReportlog.writefile('APPEND',!ErrLogEnd)


  !!ce = !ce


endfunction
