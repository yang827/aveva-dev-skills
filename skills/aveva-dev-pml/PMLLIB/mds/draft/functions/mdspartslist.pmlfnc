--    Module:        Undefined
------------------------------------------------------------------------
--
-- File:            MdsPartsList.pmlfnc
--   Type:          Function
--
-- Author:          Anil Kumar
-- Created:         21 February 2005
--
-- Description:
-- Basic Task to create Parts List table
-- Table is created using SLAB which will be stored below the
-- new view created
------------------------------------------------------------------------
define function !!MdsPartsList(!params is array)

  !ce = !!ce

  shee
  !sheet = !!ce.name
  !units = object COMUNITS(TRUE)

-- Find support name
  !SuppName = !!ce.darref.name.before('-AREA')

-- If the support does not exist it may be a group
  $!SuppName
    handle NONE
    elsehandle ANY
      !SuppName = '$!SuppName[1]'
    endhandle

-- Return to SHEET
  $!sheet

  last mem
    handle ANY
    endhandle

  new view $!Sheet/PartsList
    handle (41,12)
      delete view
      $!Sheet/PartsList
      delete view mem
        handle ANY
        endhandle
    endhandle

-- View attributes
  size 260 220 lfra fals Title |MDS ABA 3 Views - Parts List|
  !xpos = !params[1]
  !ypos = !params[2]
  vreg br x $!xpos y $!ypos

  new laye $!Sheet/PartsList/Header
  !EleType = Type of $!SuppName/DATUM
    handle(2,109)
      !EleType = Type of $!SuppName
    endhandle
  if(!EleType.eq(|ATTA|)) then
    !HeaderDdna = Name of $!SuppName/DATUM
      handle(2,109)
        !HeaderDdna = Name of $!SuppName
      endhandle
  else
    !HeaderDdna = Name of $!SuppName
  endif

-- Create Header
  new slab ddna $!HeaderDdna Tmrf $!params[3]
  oset FALSE llead fals lfpen template
  xypos $!params[1] $!params[2]
  !SlabName = !!ce

-- Create Layer for Entries
  new laye $!Sheet/PartsList/Entry

-- Use MDSOBJECT
  !MdsObject = !!MdsAbaSuppObj(!SuppName.dbref())

-- Find whether Support is MDS Group or not
  if !MdsObject.Mdsdata.Mdsgroup then
    !SuppMembers = !MdsObject.Mdsdata.Allgroupmem
  else
    !SuppMembers = !MdsObject.Mdsdata.Members
  endif

-- Safety Class of Support to evaluate MTS-PS
-- **********************
-- **********************
-- *** IMPORTANT NOTE *** ANY Modifications to how the variable !MTSPS is derived in this file
-- ********************** MUST also be DONE in the MDS object method "mdsvprmmto.mtestsheet" to ensure COMPATIBILTY
-- ********************** between MDS ABA DRAWING MTO generation in PDMS DRAFT and the
--*********************** MDS VPRM MTO data extraction of MDS Supports in PDMS DESIGN and DRAFT<DELIVERY MANAGER>
-- **********************
  --!SClass = texp8 of note $!Sheet/TitleBlock



-- dtf call mdsgetpartlistdata here
 !sclass = btex of texp8 of note $!Sheet/TitleBlock
 !returnarray = !!mdsgetpartlistdata(!SuppMembers, !sclass, !suppname)
 !DdnmAr = !returnarray[1]
 !AtexAr = !returnarray[2]
 !PosNumAr = !returnarray[3]
 !ShieldTags = !returnarray[4]
-------------------------------------------------
-- Create new SLAB for Parts Entry
-------------------------------------------------
  !TotalWeight = 0
  !AtexArSlNo = ARRAY()

  do !Loop9 indices !DdnmAr
    new slab copy $!SlabName
    !SlNo = !!ce.sequence
    !seq = !PosNumAr[!loop9]
    --!seq = sequence
    --by y (7 * $!seq)
    by y (7 * $!loop9)
    Atex |$!seq\$!AtexAr[$!Loop9]|
    !AtexArSlNo.append(|$!seq\$!AtexAr[$!Loop9]|)
    ddnm $!DdnmAr[$!Loop9]
    Tmrf $!params[4]
    if !!ce.atex.part(10,|\|).trim().empty().not() then
      !CompWei = !!ce.atex.part(10,|\|)
      !TotalWeight = !TotalWeight + !CompWei.real()
    endif
  enddo

-- Create Glab for Total Weight
  var !xypos xypos
  new glab ddnm $!SuppName
  oset fals chei 3.5 align hbody just right llead fals lfra fals
  xypos $!xypos
  by y 13
  by x -2
  !TotalWeightSTR = !TotalWeight.STRING('D1')
  btex 'Total Weight $!TotalWeightSTR'

-- Replace partlist tags on views with new id numbers
  $!sheet

  var !MainViewList eval(name of View) for all task with (type of own eq 'LAYE') and pmlfunction eq 'mdsabaviewtask' for $!sheet



  do !Loop10 indices !MainViewList
    !TestForSteel = $!MainViewList[$!Loop10]/SteelTags_Task
      handle NONE
        !LayeNames = |$!MainViewList[$!Loop10]/SteelTags_Task|
      elsehandle ANY
        !LayeNames = ''
      endhandle
    !TestForAncil = $!MainViewList[$!Loop10]/AncilTags_Task
      handle NONE
        !LayeNames = !LayeNames + | $!MainViewList[$!Loop10]/AncilTags_Task|
      elsehandle ANY
        !LayeNames = !LayeNames
      endhandle
    $!MainViewList[$!Loop10]
    var !LabelList coll all GLAB with matchw(btex,'*DETAIL*') neq TRUE for $!Layenames
      handle NONE
        var !LabelList append coll all SLAB for $!Layenames
        var !LabelListDdnm eval(ref of ddnm) for all from !LabelList
        var !LabelListSpre eval(spre of ddnm) for all from !LabelList ignore ANY
        !LabelListText = ARRAY()
        !LabelStatus = ARRAY()
        !OldTextAr = ARRAY()
        !NewTextAr = ARRAY()
-- Make an array of ATEX or BTEX
        do !Loop11 indices !LabelList
          !LabelStatus[$!Loop11] = FALSE
          if !LabelList[$!Loop11].dbref().type.eq(|GLAB|) then
            !LabelListText.append(!LabelList[$!Loop11].dbref().btext)
          else
            !LabelListText.append(!LabelList[$!Loop11].dbref().atext)
          endif
        enddo

        do !Loop12 indices !DdnmAr
          !SlabCount = !LabelListDdnm.find(!DdnmAr[$!Loop12])

-- Skip the Loop if Austenitic Shield
          if !AtexArSlNo[$!Loop12].part(3,|\|).eq(|Austenitic Shield|) then
            skip
          endif
-- Replace Tag if Quantity is 1
          if !SlabCount.size().eq(1) then
            !OldAtex = !LabelListText[$!SlabCount[1]]
            !NewAtex = !AtexArSlNo[$!Loop12].part(1,|\|)
            !OldTextAr[!SlabCount[1]] = !OldAtex
            !NewTextAr[!SlabCount[1]] = !NewAtex
            !Qty = !AtexArSlNo[$!Loop12].part(2,|\|)
-- Replace Tag if Quantity is reported as 2
            if !Qty.real().gt(1) then
              !TagRepeat1 = !LabelListSpre.find(!LabelListSpre[!SlabCount[1]])
                do !Loop13 indices !TagRepeat1
                  !OldAtex = !LabelListText[!TagRepeat1[$!Loop13]]
                  !LabelStatus[!TagRepeat1[$!Loop13]] = TRUE
                  !OldTextAr[!TagRepeat1[$!Loop13]] = !OldAtex
                  !NewTextAr[!TagRepeat1[$!Loop13]] = !NewAtex
  --                  write |Q2 $!OldAtex $!NewAtex|
                enddo
            else
              !LabelStatus[!SlabCount[1]] = TRUE
              !OldTextAr[!SlabCount[1]] = !OldAtex
              !NewTextAr[!SlabCount[1]] = !NewAtex
  --                write |One $!OldAtex $!NewAtex|
            endif
-- Replace Tag if Two label exists with same Tag
          elseif !SlabCount.size().gt(1) then
            do !Loop14 indices !SlabCount
            !TagRepeat2 = !LabelListText.find(!LabelListText[!SlabCount[$!Loop14]])
              do !Loop14a indices !TagRepeat2
               if !LabelList[!TagRepeat2[$!Loop14a]].dbref().position.east.unset() then
                  !OldAtex = !LabelListText[!TagRepeat2[$!Loop14a]]
                  !NewAtex = !AtexArSlNo[$!Loop12].part(1,|\|)
                  !LabelStatus[!TagRepeat2[$!Loop14a]] = TRUE
                  !OldTextAr[!TagRepeat2[$!Loop14a]] = !OldAtex
                  !NewTextAr[!TagRepeat2[$!Loop14a]] = !NewAtex
  --                  write |Two $!OldAtex $!NewAtex|
               endif
              enddo
            enddo
$(
            !TagRepeat2 = !LabelListText.find(!LabelListText[!SlabCount[1]])
             do !Loop14 indices !TagRepeat2
               if !LabelList[!TagRepeat2[$!Loop14]].dbref().position.east.unset() then
                  !OldAtex = !LabelListText[!TagRepeat2[$!Loop14]]
                  !NewAtex = !AtexArSlNo[$!Loop12].part(1,|\|)
                  !LabelStatus[!TagRepeat2[$!Loop14]] = TRUE
                  !OldTextAr[!TagRepeat2[$!Loop14]] = !OldAtex
                  !NewTextAr[!TagRepeat2[$!Loop14]] = !NewAtex
               write |Two $!OldAtex $!NewAtex|
               endif
             enddo
$)
-- Replace Tag if ITLE
          elseif !SlabCount.size().eq(0) then
            !IlTubDdnm = !DdnmAr[$!Loop12].after(|OF |)
            !SlabCount2 = !LabelListDdnm.find(!IlTubDdnm)
            do !Loop15 indices !SlabCount2
              if !LabelStatus[!SlabCount2[$!Loop15]].not() then
                 !OldAtex = !LabelListText[!SlabCount2[$!Loop15]]
                 !NewAtex = !AtexArSlNo[$!Loop12].part(1,|\|)
                 !OldTextAr[!SlabCount2[$!Loop15]] = !OldAtex
                 !NewTextAr[!SlabCount2[$!Loop15]] = !NewAtex
  --                 write |ITLE $!OldAtex $!NewAtex|
              endif
            enddo
          endif
     enddo

     !!WasTag = ARRAY()
     !!NowTag = ARRAY()

-- Run the Loop to assign the New Tag number
     do !Loop16 indices !NewTextAr
        $!LabelList[$!Loop16]
        if !!ce.type.eq(|GLAB|) then
            !tx = !!ce.btex
            if !tx.eq(!OldTextAr[$!Loop16]) then
                btex |$!NewTextAr[$!Loop16]|
            else
                write |Glab unchanged|
            endif
        else
            !tx = !!ce.atex
            !!WasTag.append(!!ce.atext)
            if !tx.eq(!OldTextAr[$!Loop16]) then
              atex |$!NewTextAr[$!Loop16]|
                handle ANY
                endhandle
            else
              write |Slab unchanged|
            endif
            !!NowTag.append(!!ce.atext)
        endif
     enddo

-- Delete the Tags which do not appear in PartList

     do !Loop21 indices !LabelList
        if !LabelList[$!Loop21].dbref().type.eq(|GLAB|) then
            if  !NewTextAr.find(!LabelList[$!Loop21].dbref().btex).size().eq(0) then
                $!LabelList[$!Loop21]
                DELETE GLAB
                  handle ANY
                  endhandle
            endif
        elseif !LabelList[$!Loop21].dbref().type.eq(|SLAB|) then
            if  !NewTextAr.find(!LabelList[$!Loop21].dbref().atex).size().eq(0) then
              $!LabelList[$!Loop21]
-- Before deleting the text check to see if is not the fist occurrence but another
-- Incase the tag is not to the first occurrence of the tag check the !!wastag and !!nowtag
              !Atext = !!ce.atext
              !FindWas = !!WasTag.find(!Atext)
              if (defined(!FindWas[1])) then
                !!ce.atext = !!NowTag[$!FindWas[1]]
              else
                -- Don't delete ref label to other supports
                if !!ce.atex.upcase().match('REF.').gt(0) then
                  tmrf /MDS/ABA/TAGS/BOXC
                  just c
                  --lock ce
                else
                  DELETE SLAB
                  handle ANY
                  endhandle
                endif
              endif
            else
              -- dtf 11.10.2005 request to switch off arrows
              $!LabelList[$!Loop21]
              lterm off
            endif
        endif
     enddo

-- Spread the Tags again
-- Collect Weld Tags Layer and turn visibility off for spreading
    var !WeldTagsSlab coll all slab with matchw(name of layer,'*WeldTags_Task') eq TRUE for $!sheet
    do !Loop22 indices !WeldTagsSlab
      $!WeldTagsSlab[$!Loop22]
      lvisi fals
    enddo

     cont draw
     view
     !!mdsabaspreadtags()
       handle ANY
       endhandle

-- If the variable !Shieldtags is set then we need to tag the aust shields in the view

      $!MainViewList[$!Loop10]
      if (defined(!ShieldTags)) then
        if !ShieldTags.size().gt(0) then
          view
          !NameOfThisView = !!ce.name
          !NameOfThisShee = !!ce.owner.name
          $!nameOfThisView/AncilTags_Task
            handle NONE
              var !SlabsInLaye coll all slab for ce
                do !LoopThroughSlabs values !SlabsInLaye
                  laye
                  slab $!LoopThroughSlabs
                  do !LoopThroughShields values !Shieldtags
                    if !!ce.ddnm.eq(!LoopThroughShields) then
                      if !!ce.ddnm.type.eq('ATTA') then
                        !CodeOfDdnm = !!ce.ddnm.prop.code
                      elseif !!ce.ddnm.type.eq('PCLA') then
                        !CodeOfDdnm = !!ce.ddnm.spref.namn.after('/')
                      else
                        skip
                      endif
-- Remove R from !CodeOfDDnm if set as char 1
                      if !CodeOfDdnm.match('R').eq(1) then
                        !CodeOfDDnm = !CodeOfDDnm.after('R')
                      endif
                      var !coll coll all slab with (matchwild(atext,'*$!CodeOfDDnm$n-IP*')) for $!NameOfThisShee/PartsList
                        handle NONE
                          if (defined(!Coll[1])) then
                            !TagNumber = !Coll[1].dbref().atext.before('\')
-- Determine which side of view label is top or left
                            view
                            !XypoOfView = xypo
                            !SizeofView = size
                            !Xval = 0
                            !Yval = 0
                            !Xlimit = !XypoOfView.east + (!SizeOfView[1] / 2) - 15
                            !YLimit = !XypoOfView.north + (!SizeofView[2] / 2) - 15
                            same
                            !XypoOfSlab = xypo
                            if !XypoOfSlab.east.gt(!Xlimit) then
                              !Xval = 12
                            endif
                            if !XypoOfSlab.north.gt(!Ylimit) then
                              !Yval = 12
                            endif
                            new slab copy prev
                            atext '$!TagNumber'
                            by x $!Xval Y $!Yval
                            llead FALSE
                            lock
                          endif
                        elsehandle ANY
                        endhandle
                    endif
                  enddo
                enddo
            elsehandle ANY
            endhandle
          $!nameOfThisView/SteelTags_Task
            handle NONE
              var !SlabsInLaye coll all slab for ce
                do !LoopThroughSlabs values !SlabsInLaye
                  laye
                  slab $!LoopThroughSlabs
                  do !LoopThroughShields values !Shieldtags
                    if !!ce.ddnm.eq(!LoopThroughShields) then
                      if !!ce.ddnm.type.eq('ATTA') then
                        !CodeOfDdnm = !!ce.ddnm.prop.code
                      elseif !!ce.ddnm.type.eq('PCLA') then
                        !CodeOfDdnm = !!ce.ddnm.spref.namn.after('/')
                      else
                        skip
                      endif
-- Remove R from !CodeOfDDnm if set as char 1
                      if !CodeOfDdnm.match('R').eq(1) then
                        !CodeOfDDnm = !CodeOfDDnm.after('R')
                      endif
                      var !coll coll all slab with (matchwild(atext,'*$!CodeOfDDnm$n-IP*')) for $!NameOfThisShee/PartsList
                        handle NONE
                          if (defined(!Coll[1])) then
                            !TagNumber = !Coll[1].dbref().atext.before('\')
-- Determine which side of view label is top or left
                            view
                            !XypoOfView = xypo
                            !SizeofView = size
                            !Xval = 0
                            !Yval = 0
                            !Xlimit = !XypoOfView.east + (!SizeOfView[1] / 2) - 15
                            !YLimit = !XypoOfView.north + (!SizeofView[2] / 2) - 15
                            same
                            !XypoOfSlab = xypo
                            if !XypoOfSlab.east.gt(!Xlimit) then
                              !Xval = 12
                            endif
                            if !XypoOfSlab.north.gt(!Ylimit) then
                              !Yval = 12
                            endif
                            new slab copy prev
                            atext '$!TagNumber'
                            by x $!Xval Y $!Yval
                            llead FALSE
                            lock
                          endif
                        elsehandle ANY
                        endhandle
                    endif
                  enddo
                enddo
            elsehandle ANY
            endhandle
        endif
      endif

-- Add tags for nuts

      $!MainViewList[$!Loop10]
      if (defined(!NutTags)) then
        if !NutTags.size().gt(0) then
          view
          !NameOfThisView = !!ce.name
          !NameOfThisShee = !!ce.owner.name
          $!nameOfThisView/SteelTags_Task
            handle NONE
              var !SlabsInLaye coll all slab with (unset (position )) for ce
                --  unset(position) used because thread rod attached to turnbuckle etc with position set
                do !LoopThroughSlabs values !SlabsInLaye
                  laye
                  slab $!LoopThroughSlabs
                  do !LoopThroughNuts values !NutTags
                    if !!ce.ddnm.eq(!LoopThroughNuts.dbref()) then
                      !CodeOfDDnm = !!ce.ddnm.:ustnutref[1].namn.after('/')
                      var !coll coll all slab with (matchwild(atext,'*\$!CodeOfDDnm\*')) for $!NameOfThisShee/PartsList
                        handle NONE
                          if (defined(!Coll[1])) then
                            !TagNumber = !Coll[1].dbref().atext.before('\')
-- Determine which side of view label is top or left
                            view
                            !XypoOfView = xypo
                            !SizeofView = size
                            !Xval = 0
                            !Yval = 0
                            !Xlimit = !XypoOfView.east + (!SizeOfView[1] / 2) - 15
                            !YLimit = !XypoOfView.north + (!SizeofView[2] / 2) - 15
                            same
                            !XypoOfSlab = xypo
                            if !XypoOfSlab.north.gt(!Ylimit) then
                              !Yval = 12
                            --endif
                            elseif !XypoOfSlab.east.gt(!Xlimit) then
                              !Xval = 12
                            endif
                            new slab copy prev
                            atext '$!TagNumber'
                            by x $!Xval Y $!Yval
                            llead FALSE
                            lock
                          endif
                        elsehandle ANY
                        endhandle
                    endif
                  enddo
                enddo
            elsehandle ANY
            endhandle
        endif
      endif


 -- Add tags for nuts

      $!MainViewList[$!Loop10]
      var !collallslab coll all slab for ce
      do !testforfrj values !collallslab
        !!ce = !testforfrj.dbref()
        !testweib = prop weib of ddnm
          handle ANY
              skip
          elsehandle NONE
-- Determine which side of view label is top or left
            view
            !XypoOfView = xypo
            !SizeofView = size
            !Xval = 0
            !Yval = 0
            !Xlimit = !XypoOfView.east + (!SizeOfView[1] / 2) - 15
            !YLimit = !XypoOfView.north + (!SizeofView[2] / 2) - 15
            same
            !XypoOfSlab = xypo
            if !XypoOfSlab.north.gt(!Ylimit) then
              !Yval = 12
            elseif !XypoOfSlab.east.gt(!Xlimit) then
              !Xval = 12
            endif
            !atex = atex
            !atexreal = !atex.real() - 1
            atex '$!atexreal'
            new slab copy prev
            by x $!Xval Y $!Yval
            llead FALSE
            atex '$!atex'
            lock
          endhandle
      enddo
      $!MainViewList[$!Loop10]

      $(
      if (defined(!NutTags)) then
        if !NutTags.size().gt(0) then
          view
          !NameOfThisView = !!ce.name
          !NameOfThisShee = !!ce.owner.name
          $!nameOfThisView/SteelTags_Task
            handle NONE
              var !SlabsInLaye coll all slab with (unset (position )) for ce
                --  unset(position) used because thread rod attached to turnbuckle etc with position set
                do !LoopThroughSlabs values !SlabsInLaye
                  laye
                  slab $!LoopThroughSlabs
                  do !LoopThroughNuts values !NutTags
                    if !!ce.ddnm.eq(!LoopThroughNuts.dbref()) then
                      !CodeOfDDnm = !!ce.ddnm.:ustnutref[1].namn.after('/')
                      var !coll coll all slab with (matchwild(atext,'*\$!CodeOfDDnm\*')) for $!NameOfThisShee/PartsList
                        handle NONE
                          if (defined(!Coll[1])) then
                            !TagNumber = !Coll[1].dbref().atext.before('\')
-- Determine which side of view label is top or left
                            view
                            !XypoOfView = xypo
                            !SizeofView = size
                            !Xval = 0
                            !Yval = 0
                            !Xlimit = !XypoOfView.east + (!SizeOfView[1] / 2) - 15
                            !YLimit = !XypoOfView.north + (!SizeofView[2] / 2) - 15
                            same
                            !XypoOfSlab = xypo
                            if !XypoOfSlab.north.gt(!Ylimit) then
                              !Yval = 12
                            --endif
                            elseif !XypoOfSlab.east.gt(!Xlimit) then
                              !Xval = 12
                            endif
                            new slab copy prev
                            atext '$!TagNumber'
                            by x $!Xval Y $!Yval
                            llead FALSE
                            lock
                          endif
                        elsehandle ANY
                        endhandle
                    endif
                  enddo
                enddo
            elsehandle ANY
            endhandle
        endif
      endif
$)

























-- Turn on visibility for Weld Tags Layer

      do !Loop23 indices !WeldTagsSlab
       $!WeldTagsSlab[$!Loop23]
       lvisi TRUE
      enddo
    elsehandle ANY
    endhandle
  enddo

-- Hide the MTO View
  var !HideViewList eval(name of View) for all task with (type of own eq 'LAYE') and matchw(pmlfunction,'*Mto*') eq true for $!sheet
  do !Loop24 indices !HideViewList
    $!HideViewList[$!Loop24]
    !MembersOfView = !!ce.mcount
    do !HideMembers from 1 to !MembersOfView
      view
      lvis FALSE
      $!Hidemembers
      lvisi FALSE
        handle ANY
        endhandle
    enddo
  enddo
  !!ce = !ce

-------------
--<wd>jun2005
-- Delete the Global Variable !!mdsfanpqclass used for the MDS Support "Quality Class"<QC>
  if (defined(!!mdsfanpqclass)) then
    !!mdsfanpqclass.delete()
  endif
--<wd>jun2005
-------------

endfunction

-------------- End Of Code --------------
