-- Define Object
Define object KSUPDEFS

    -- Isometric view direction
    member .Isometric IS STRING

    -- Site trim value
    member .SiteTrim IS REAL

    -- Angle gtype equivalents
    member .Angle IS STRING

    -- Channel equivelentst
    member .Channel IS STRING

    -- Support detail information
    member .Dtext IS ARRAY

    -- Support function name
    member .Rtext IS ARRAY

    -- Transportation Prefix
    member .TranPref is STRING

    -- Transportation Text
    member .TranText is STRING

    -- Drawing Number
    member .DrwgNo is STRING

    -- Grid Matrix
    member .GridMatrix is STRING

-- End Object
endobject

