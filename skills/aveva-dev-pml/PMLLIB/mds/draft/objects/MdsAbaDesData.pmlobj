--
-- File:		mdsabadesdata
--   Type:		Object Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Draft MDS using ABA for Drawing production
--   Replaces:
--
-- Author:		Wayne Dodwell
-- Created:		Wednesday 22nd May 2002
--
--
-- Description:
-- Object of MDS support DESIGN data for the Selected Support
--
--------------------------------------------------------------------------------
-- Define Object
  define object mdsabadesdata

    member .datum        is dbref
    member .datumorthdir is direction
    member .datumoppdir  is direction
    member .lookwestdir  is direction
    member .lookeastdir  is direction
    member .lookdowndir  is direction
    member .members      is array
    member .volume       is volume
    member .suppname     is string
    member .supptype     is STRING

--<wd>jan2005 -- Added OBJECT members for use with MDS "GROUPS"
-- .mdsgroup is to store if the MDS Framework Support is a GROUP
    member .mdsgroup is BOOLEAN

-- .maingroupmem is for the "MAIN" Group MEMBERS i.e.
-- STRU <i.e. [1]> and Additional RESTRAINTS <i.e. [2], [3], [4] etc...>
    member .maingroupmem     is ARRAY

-- .allgroupmem is for "ALL" of the Support Members as collected via the function "mdsabasupportmem.pmlfnc"
-- for each "MAIN" member of the MDS GROUP found inOBJECT member .maingroupmem
    member .allgroupmem      is ARRAY

--------------------------------------------------------------------------------
  endobject
-- End of Object - mdsabadesdata
