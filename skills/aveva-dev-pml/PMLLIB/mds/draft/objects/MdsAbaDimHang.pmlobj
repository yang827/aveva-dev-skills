--
-- File: MdsAbaDimHang.pmlobj
--   Type: Object Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: Draft MDS using ABA for Drawing production
--   Replaces:
--
-- Author: Steve Robinson
-- Created: 1st July 2002
--
--
--
--
-- Description:
-- ------------
-- This object generates dimensions for MDS ABA support hangers.
--
--
-- Using this object:
-- ------------------
-- For each view to be annotated make an instance of this object and pass the
-- DBREF of the hanger to be dimensioned and the DBREF of the view.
--
-- Before calling the .dimension() method make sure the HANG_Dims layer
-- exists and had the relevant UCODE, PCODE and other text defaults set. This
-- allows you to control the appearance of the annotation before is it generated.
-- Note: If the dim layer does not exist then the method will create it and
-- and atts cascaded from view level will take effect.
--
-- IMPERIAL UNITS:
-- ---------------
-- The code should work in both metric and imperial units...
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  createLayer(STRING)              -
--  createadim(STRING)               -
--  createdim(STRING)                -
--  dimension(STRING,MDSABASUPPORT)  -
--  duplicate()                      BOOLEAN
--  fixdims(DBREF,STRING)            -
--  mdsabadimhang(DBREF,DBREF)       -
--  tidydim(DBREF)                   -
--
define object MDSABADIMHANG
  member .hang      is DBREF         $* Support hanger (HANG)
  member .view      is DBREF         $* VIEW where dimensions are to be created
  member .params    is ARRAY         $* Passed parameters for pen settings
  member .mdsObject is MDSABASUPPORT $* passed support object
endobject
--------------------------------------------------------------------------------
----------------------------------------------------------
-- Constructor to get design data and populate this object
----------------------------------------------------------
-- Arguments:
-- hang = DBREF of support hanger to be dimensioned
-- view = DBREF of view where hanger will be dimensioned
----------------------------------------------------------
--------------------------------------------------------------------------------
define method .mdsabadimhang(!hang is DBREF, !view is DBREF)
  !saveRef = !!ce
  !this.hang = !hang
  !this.view = !view
  $!saveRef
endmethod
--------------------------------------------------------------------------------
------------------------------------------------------
-- Method to generate dimensions for support steelwork
------------------------------------------------------
--------------------------------------------------------------------------------
--<wd>feb2005 -- The applicable MDSABASUPPORT object is now passed to this method.
--define method .dimension(!this.params is STRING)
define method .dimension(!params is STRING,!mdsObject is MDSABASUPPORT)
  --<wd>feb2005
  !this.params = !params.split(',')
  !this.mdsObject = !mdsObject
  --------------------------------------------
  --<wd>03mar2008 - DUN824 - Defect No. P-4405
  -- Determine if COORD XYZ or COORD ENU is being used
  var !coord coord
  --<wd>03mar2008 - DUN824 - Defect No. P-4405
  --------------------------------------------
  --<wd>feb2005
  -- Initialise Variables
  if (!this.mdsObject.mdsData.mdsGroup) then
    !mainGroup = !this.mdsObject.mdsData.maingroupmem
    if (!mainGroup.size().gt(1)) then
      !hangGroup = !mainGroup
      -- Delete the MDS GROUP Master MDS STRUCTURE from index [1]
      !hangGroup.removefirst()
      -- Determine the Hanger Dimension Layer Number for the MDS HANGER from the index number found in the ARRAY !hangGroup
      !lNum = !hangGroup.findfirst(!this.hang.href)
      --q var !hangGroup !this.hang.href.name
      --$P !lNum = $!lNum
    else
      -- NO MDS Hangers in the MDS GROUP to Dimension --
      return
    endif
  endif
  --<wd>feb2005
  -- dimension layer suffix
  --<wd>feb2005
  --!dimLayer = 'HANG_Dims'
  if (!this.mdsObject.mdsData.mdsGroup) then
    !dimLayer = 'HANG_Dims_' & !lNum
  else
    !dimLayer = 'HANG_Dims'
  endif
  -- create dimension layer
  !this.createLayer(!dimLayer)
  !layerName = !!ce.name
  -- navigate to view
  $!this.view
  -- get view region for dimension positioning
  !vreg = !!ce.vreg
  -- get direction of view
  !vDir = !!ce.dir.wrt(/* )
  --------------------------------------------
  --<wd>18feb2008 - DUN824 - Defect No. P-4405
  -- Now caters for XYZ co-ordinates
  --
  -- get view direction and determine dimension direction up and to right of view
  var !rDir viewdir right
  --    !rDirection = $!rDir
  !unusedRDirection = !rDir.direction()
  var !uDir viewdir up
  --    !uDirection = $!uDir
  !uDirection = !uDir.direction()
  var !dDir viewdir d
  --    !dDirection = $!dDir
  !unusedDDirection = !dDir.direction()
  --
  --<wd>18feb2008 - DUN824 - Defect No. P-4405
  --------------------------------------------
  --<K.pleschner> May2005
  --determine if it is a double hanger
  !doubleHang = (mcount HANG of owner of $!this.hang gt 1)
  -- determine if it is a dynamic hanger
  !dynamicHang = !this.hang.owner.:USTHCFGKEY.match('LD').eq(1)
  handle ANY
    !dynamicHang = FALSE
  endhandle
  -- determine if view dir is parallel (+/-10deg) to direction of hanged pipe
  !pipeDir = !this.hang.href.ldir.wrt(worl )
  !angle = !pipeDir.angle(!vDir)
  if !angle.gt(90) then
    !angle = 180 - !angle
  endif
  !viewIsParallel = !angle.leq(10)
  -- Collect all hanger components and dimension
  var !hangMem coll all hang members for $!this.hang
  --------------------------------------------
  --<wd>18feb2008 - DUN824 - Defect No. P-4405
  -- Now caters for XYZ co-ordinates
  --
  --  if !vDir.string().before(' WRT').neq('D') then
  if !vDir.string().before(' WRT').neq('D') or !vDir.string().before(' WRT').neq('-Z')then
    --
    --<wd>18feb2008 - DUN824 - Defect No. P-4405
    --------------------------------------------
    $!layerName
    -- Create new LDIMS for MDS HANGERS
    !this.createdim( !layerName & '/UD-HANG-1' )
    -- overall dimension from hanger head to hanger tail
    DIR $!uDir
    from P1 of $!this.hang to P2 of $!this.hang
    --<wd>feb2005
    --$P *** DIM 1 "X" = $!this.mdsObject.abaData.lDimDPosX ******
    LDIM
    !x = !this.mdsObject.abaData.lDimDPosX
    if (!this.mdsObject.mdsData.mdsGroup) then
      if (!lNum.eq(1)) then
        -- MDS GROUP Master STRUCTURE exists, so indent FIRST LINE of HANGER DIMS
        !x = !vreg[1] + ( 3 * dtch)
        !this.mdsObject.abaData.lDimDPosX = !x
        DPOS X $!x Y $!vreg[2]
      else
        !x = !this.mdsObject.abaData.lDimDPosX + ( 3 * dtch)
        !this.mdsObject.abaData.lDimDPosX = !x
        DPOS X $!x Y $!vreg[2]
      endif
    else
      -- Original DPOS Code
      DPOS X $!vreg[1] Y $!vreg[2]
    endif
    --<wd>feb2005
    --$P *** DIM 1 "X" = $!this.mdsObject.abaData.lDimDPosX ******
    !this.createdim( !layerName & '/UD-HANG-2' )
    -- component dimensions
    DIR $!uDir
    do !hele values !hangMem
      new dppt on p1 of $!hele
      handle ANY
        delete dppt
      endhandle
      new dppt on p2 of $!hele
      handle ANY
        delete dppt
      endhandle
      -- Check if this dppt goes to the end of a LISEGA rigid strut, because there may be a slight
      -- difference in length of 1 to 2mm delete the dppt
      if !!ce.ddnm.spref.name.after('/').after('/').matchwild('39????') or !!ce.ddnm.spref.name.after('/').after('/').matchwild('R39????') then
        delete dppt
      endif
    enddo
    LDIM
    -- add the elevation pltx for the 1st and last points
    1
    handle ANY
    elsehandle NONE
      !testRef = DDNA
      --------------------------------------------
      --<wd>11mar2008 - DUN824 - Defect No. P-4405
      --COORD XYZ or COORD ENU is being used
      --      if  !vDir.string().before(' WRT').eq('D') then
      if (!vDir.string().before(' WRT').eq('D')) or (!vDir.string().before(' WRT').eq('-Z')) then
        --<wd>11mar2008 - DUN824 - Defect No. P-4405
        --------------------------------------------
        PLTX unset
      else
        --------------------------------------------
        --<wd>03mar2008 - DUN824 - Defect No. P-4405
        -- PLTX 'EL. #POSU+' PJUST AWAY
        -- Determine the current COORD system, XYZ or ENU????
        if (!coord.upcase().trim().eq('ENU')) then
          PLTX 'EL. #POSU+' PJUST AWAY
        elseif (!coord.upcase().trim().eq('XYZ')) then
          PLTX '#POSU' PJUST AWAY
        endif
        --<wd>03mar2008 - DUN824 - Defect No. P-4405
        --------------------------------------------
      endif
    endhandle
    LDIM
    LAST MEM
    handle ANY
    elsehandle NONE
      -- DTF >>> 21.10.04 changed get leave pos of last mem
      -- and not put duplicate label when only 1 hanger element in hang
      if !!ce.ddna.neq(!testRef)  then
        --------------------------------------------
        --<wd>11mar2008 - DUN824 - Defect No. P-4405
        --if !vDir.string().before(' WRT').eq('D') then
        if (!vDir.string().before(' WRT').eq('D')) or (!vDir.string().before(' WRT').eq('-Z')) then
          --<wd>11mar2008 - DUN824 - Defect No. P-4405
          --------------------------------------------
          PLTX unset
        else
          --------------------------------------------
          --<wd>03mar2008 - DUN824 - Defect No. P-4405
          -- PLTX 'EL. #P2POSU+' PJUST AWAY
          -- Determine the current COORD system, XYZ or ENU????
          if (!coord.upcase().trim().eq('ENU')) then
            PLTX 'EL. #P2POSU+' PJUST AWAY
          elseif (!coord.upcase().trim().eq('XYZ')) then
            PLTX '#P2POSU' PJUST AWAY
          endif
          --<wd>03mar2008 - DUN824 - Defect No. P-4405
          --------------------------------------------
        endif
      endif
      -- DTF <<< End of Mod
    endhandle
    LDIM
    !this.tidydim(!!ce)
    --<wd>feb2005
    --$P *** DIM 2 "X" = $!this.mdsObject.abaData.lDimDPosX ***
    LDIM
    handle NONE
      if (!this.mdsObject.mdsData.mdsGroup) then
        !x = !this.mdsObject.abaData.lDimDPosX
        if (!lNum.eq(1)) then
          !x = !x + (3 * dtch)
          DPOS X $!x Y $!vreg[2]
          !this.mdsObject.abaData.lDimDPosX = !x
        else
          !x = !this.mdsObject.abaData.lDimDPosX + ( 3 * dtch)
          DPOS X $!x Y $!vreg[2]
          !this.mdsObject.abaData.lDimDPosX = !x
        endif
      else
        -- Original DPOS Code
        !x = !vreg[1] + (3 * dtch)
        DPOS X $!x Y $!vreg[2]
      endif
      --<wd>feb2005
      --$P *** DIM 2 "X" = $!this.mdsObject.abaData.lDimDPosX ******
      -- move any dim text that hits the projection lines
      !this.fixdims(!!ce,'U')
    elsehandle ANY
    endhandle
    --<tm>25/04/2005 10:39
    -- new bit to dimension the offset of a dynamic hanger
    --<K.pleschner> May2005
    -- now it works on all skewed hangers
    if !viewIsParallel then
      -- determine general hanger direction and project it onto plane of view
      if !doubleHang then
        !secondHang = !this.hang.owne.memb.last()
        !hangDir = !secondHang.hpos.direction(!secondHang.memb[1].lpos)
      else
        !hangDir = !this.hang.hpos.direction(!this.hang.memb[1].lpos)
      endif
      !viewPlane = object PLANE(e0, Z is $!vDir )
      !projDir = !hangDir.projected(!viewPlane)
      -- determine if projected hanger direction is in main direction (U,D,...)
      !hangAngl = !projDir.angle(!uDirection).int()
      !skewedHang = !hangAngl.eq(0).or(!hangAngl.eq(89)).or(!hangAngl.eq(90)).or(!hangAngl.eq(179)).or(!hangAngl.eq(180)).not()
    else
      !skewedHang = FALSE
    endif
    if !skewedHang then
      !this.createdim( !layerName & '/UD-HANG-3' )
      copy prev
      do !loop from 1 to !!ce.mcount()
        ldim
        $!loop
        pltx ''
      enddo
      ldim
      !x = !vreg[1] + ( 6 * dtch)
      !dir = !projDir.string().before(' WRT')
      dir $!dir
      sort dim
      -- work out the DPOS as the mid point of the view
      !dPosX = !vreg[1] + (0.25 * (!vreg[2] - !vreg[1]))
      !dPosY = !vreg[3] + (0.25 * (!vreg[4] - !vreg[3]))
      DPOS X $!dPosX Y $!dPosY
      if !this.duplicate() then
        delete LDIM
      else
        if !dynamicHang then
          ldim
          !lDimMemb = !!ce.memb
          do !dppt values !lDimMemb
            skip if !dppt.sequ.eq(1)
            skip if !dppt.sequ.eq(2)
            if !dppt.sequ.eq(!dppt.owne.memb.size()) then
              !dppt.ddnm = last SCLA of $!this.hang
              !dppt.nppt = 1
              skip
            endif
            !!ce = !dppt
            delete $!!ce.type
          enddo
        else
        endif
      endif
      -- If the pcla is a 37 type then we need to change the ddnm of the second dppt to hele 1 and the nppt to 1
      ldim
      dppt 1
      handle NONE
        if !!ce.ddnm.spref.name.matchwild('*/37*') or !!ce.ddnm.spref.name.matchwild('*/R37*') then
          !dpptName = !!ce
          goto ddnm
          nex
          !heleDDNM = !!ce
          !!ce = !dpptName
          nex
          handle NONE
            ddnm $!heleDDNM
            nppt 1
          elsehandle ANY
          endhandle
        endif
      endhandle
      -- dimension angle of offset hanger
      --<K.pleschner> May2005
      !this.createadim(!layerName + '/ANGL-HANG')
      on PH of $!this.hang
      !!hangadim = !!ce
      --from P1 of last SCLA of $!this.hang
      !dir = !projDir.string().before(' WRT')
      from dir $!dir
      if !hangAngl.gt(90) then
        to dir $!dDir
      else
        to dir $!uDir
      endif
      !angle = !!ce.exdmtx.before('~').real()
      ADIM
      if !angle.lt(1) then
        -- delete zero angle dimension
        delete ADIM
      else
        --work out the dpos as mid point of the hanger
        !midpoint = !!ce.ddnm.hpos.midpoint(!!ce.ddnm.tpos).string().before(' WRT')
        var !dpos shpos of $!midpoint
        DPOS $!dpos
      endif
    endif
  endif
  --<tm>25/04/2005 14:17
  -- new bit for dimensioning the top of a hanger relative to an anchor plate
  !hangers = !this.hang.owner.member
  !c = 0
  do !hang values !hangers
    !connection = !hang.:MDSANCREF[1]
    handle ANY
      !connection = !hang.tref
      !connGtyp = !connection.catr.gtyp
      handle ANY
        !connGtyp = ''
      endhandle
      if !connGtyp.neq('PLAT') then
        !connection = nulref
      endif
    endhandle
    !unusedP1Dir = !connection.pdir[1].wrt(/* )
    handle ANY
      -- in case its a badref or has no ppoints
    elsehandle NONE
      --if !p1dir.eq(!vDir).or(!p1dir.eq(!vDir.opposite())) then
      -- its a valid view for this dimension type
      $!layerName
      !c = !c + 1
      !this.createdim(!!ce.name & '/CONNECTIONS/' & !c)
      dir $!uDir
      from p0 of $!connection
      to htail of $!hang
      $!layerName
      !c = !c + 1
      !this.createdim(!!ce.name & '/CONNECTIONS/' & !c)
      dir $!rDir
      from p0 of $!connection
      to htail of $!hang
      --endif
    endhandle
  enddo
  -- Find out if any dimensions have only 2 elements and the second is 0
  -- Delete the dimensions
  $!layerName
  var !memLDims coll all LDIM for ce
  do !loopLDims values !memLDims
    !this.tidydim(!loopLDims.dbref())
  enddo
endmethod
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- Method .createLayer(!dimLayer is STRING )
--------------------------------------------
--<wd>02apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
-- Obsolete Parameter Nos and Some Pen Attributes  -- Params passed as string
-- Obsolete Parameter Nos and Some Pen Attributes  -- 1  Projection Line Pen  PLPN
-- Obsolete Parameter Nos and Some Pen Attributes  -- 2  Dimension Line Pen   DLPN
-- Obsolete Parameter Nos and Some Pen Attributes  -- 3  Dimension Text Pen   DTPN
-- Obsolete Parameter Nos and Some Pen Attributes  -- 4  Projection Text Pen  PTPN
-- Obsolete Parameter Nos and Some Pen Attributes  -- 5  Dimension Text Font  DFONT
-- Obsolete Parameter Nos and Some Pen Attributes  -- 6  Projection Text Font PFONT
-- Obsolete Parameter Nos and Some Pen Attributes  -- 7  Dimension Text Size  DTCH
-- Obsolete Parameter Nos and Some Pen Attributes  -- 8  Projection Text Size PTCH
-- Obsolete Parameter Nos and Some Pen Attributes  -- 9  Terminator Size      TSIZE
-- Obsolete Parameter Nos and Some Pen Attributes  -- 10 Terminator           DTERM
-- Obsolete Parameter Nos and Some Pen Attributes  -- 11 Bolt dimensions      on/off
--
-- NEW 12.0 version Parameters (DIMENSION Pen Attributes etc...) passed as a STRING
-- *** IMPORTANT NOTE *** U-Bolt Dimension Holes will NOT apply to MDS HANGERS ***
-- Depending on whether U-Bolt Hole Dimensions are required, the number of parameters may vary!!!
-- Either 12 or 13 parameters my be passed here???
-- i.e.
-- <1> -- When U-Bolt Hole Dimensions are required then parameter 13 MUST be PASSED/DEFINED and set to TRUE
-- <2> -- When parameter 13 is either NOT PASSED/UNDEFINED or DEFINED and SET to FALSE, the U-Bolt Hole Dimensions will NOT be displayed
-- ONLY 12 or 13 parameters are passed here as the ORIGINAL 1st parameter toggle value (TRUE or FALSE)
-- in the STRING of 13 or 14 Parameters has been REMOVED in the MDS ABA MAIN VIEW calling ABA TASK FUNCTION "mdsAbaViewTask.pmlfnc"
--
--  1 Projection Line Style  = PLSTYLE
--  2 Projection Line Colour = PLCOLOUR
--  3 Projection Text Font   = PFONT
--  4 Projection Text Size   = PTCHEIGHT
--  5 Projection Text Colour = PLCOLOUR
--  6 Dimension Line Style   = DLSTYLE
--  7 Dimension Line Colour  = DLCOLOUR
--  8 Dimension Text Font    = DFONT
--  9 Dimension Text Size    = DTCHEIGHT
-- 10 Dimension Text Colour  = DLCOLOUR
-- 11 Terminator Size        = TSIZE
-- 12 Terminators            = DTERMINATOR
-- 13 U-Bolt Hole Dimensions = TRUE or FALSE
--
--<wd>02apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------
--------------------------------------------------------------------------------
-- create the appropriate layer
define method .createLayer(!dimLayer is STRING )
  -- check dimension layer exists
  !layerName = !this.view.name & '/' & !dimLayer
  !!ce = !layerName.dbref()
  handle ANY
    new layer $!layerName
  endhandle
  --     !layer = !!ce
  --------------------------------------------
  --<wd>02apr2008 - DUN824 - Defect No. P-4526
  -- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
  -- At LAYER level
  --
  --<wd>09jun2010 - DFN P-30977 (SI-22656) - All occurrences of !passedParams[?] replaced with !this.params[?]
  --
  --  PLPN  $!this.params[1]
  --  DLPN  $!this.params[2]
  --  TSIZE $!this.params[9]
  --  DTERM $!this.params[10]
  --
  -- Set the Dimension Attributes Form with the Stored Values at the View Task
  -- All of the 'handle any' lines etc.. have been added to ensure that the MDS ABA default value is USED if an ERROR occurs
  -- At LAYER level
  --
  -- Projection Line Attributes
  PLSTYLE $!this.params[1]
  handle ANY
    PLSTYLE Solid
  endhandle
  PLCOLOUR $!this.params[2]
  handle ANY
    PLCOLOUR 4
  endhandle
  -- Dimension Line Attributes
  DLSTYLE $!this.params[6]
  handle ANY
    DLSTYLE Solid
  endhandle
  DLCOLOUR $!this.params[7]
  handle ANY
    DLCOLOUR 4
  endhandle
  TSIZE $!this.params[11]
  handle ANY
    TSIZE 3
  endhandle
  DTERM $!this.params[12]
  handle ANY
    DTERM Arrows
  endhandle
  --
  --<wd>09jun2010 - DFN P-30977 (SI-22656) - All occurrences of !passedParams[?] replaced with !this.params[?]
  --
  --<wd>02apr2008 - DUN824 - Defect No. P-4526
  --------------------------------------------
  -- clear any existing dimensions
  DELETE LAYER MEMBERS
  handle ANY
  endhandle
endmethod
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- loops through all of the DPPTS and checks to see if the are the same as the
-- prev dim. If the dimensions are the same, it returns true
define method .duplicate() is BOOLEAN
  !current = !!ce
  prev
  !prev    = !!ce
  var !coll1 coll all dppt for $!current
  var !coll2 coll all dppt for $!prev
  !!ce = !current
  do !a index !coll1
    if !coll1[!a].dbref().exdmtxt.neq(!coll2[!a].dbref().exdmtxt) then
      return FALSE
    endif
  enddo
  return TRUE
endmethod
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
define method .createdim(!name is STRING)
  NEW LDIM $!name
  --------------------------------------------
  --<wd>02apr2008 - DUN824 - Defect No. P-4526
  -- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
  -- At LDIM level
  --
  --<wd>09jun2010 - DFN P-30977 (SI-22656) - All occurrences of !passedParams[?] replaced with !this.params[?]
  --
  --    DTPN  $!this.params[3]
  --    PTPN  $!this.params[4]
  --    DFONT $!this.params[5]
  --    PFONT $!this.params[6]
  --    DTCH  $!this.params[7]
  --    PTCH  $!this.params[8]
  --
  -- Projection Line Attributes
  PLSTYLE $!this.params[1]
  handle ANY
    PLSTYLE Solid
  endhandle
  PLCOLOUR $!this.params[2]
  handle ANY
    PLCOLOUR 4
  endhandle
  PFONT $!this.params[3]
  handle ANY
    PFONT 3
  endhandle
  PTCHEIGHT $!this.params[4]
  handle ANY
    PTCHEIGHT 3
  endhandle
  PTCOLOUR $!this.params[5]
  handle ANY
    PTCOLOUR 7
  endhandle
  -- Dimension Line Attributes
  DLSTYLE $!this.params[6]
  handle ANY
    DLSTYLE Solid
  endhandle
  DLCOLOUR $!this.params[7]
  handle ANY
    DLCOLOUR 4
  endhandle
  DFONT $!this.params[8]
  handle ANY
    DFONT 3
  endhandle
  DTCHEIGHT $!this.params[9]
  handle ANY
    DTCHEIGHT 3
  endhandle
  DTCOLOUR $!this.params[10]
  handle ANY
    DTCOLOUR 6
  endhandle
  --
  --<wd>09jun2010 - DFN P-30977 (SI-22656) - All occurrences of !passedParams[?] replaced with !this.params[?]
  --
  --<wd>02apr2008 - DUN824 - Defect No. P-4526
  --------------------------------------------
endmethod
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
define method .createadim(!name is STRING)
  NEW ADIM $!name
  --------------------------------------------
  --<wd>02apr2008 - DUN824 - Defect No. P-4526
  -- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
  -- At LDIM level
  --
  --<wd>09jun2010 - DFN P-30977 (SI-22656) - All occurrences of !passedParams[?] replaced with !this.params[?]
  --
  --    DTPN  $!this.params[3]
  --    PTPN  $!this.params[4]
  --    DFONT $!this.params[5]
  --    PFONT $!this.params[6]
  --    DTCH  $!this.params[7]
  --    PTCH  $!this.params[8]
  --
  -- Projection Line Attributes
  PLSTYLE $!this.params[1]
  handle ANY
    PLSTYLE Solid
  endhandle
  PLCOLOUR $!this.params[2]
  handle ANY
    PLCOLOUR 4
  endhandle
  PFONT $!this.params[3]
  handle ANY
    PFONT 3
  endhandle
  PTCHEIGHT $!this.params[4]
  handle ANY
    PTCHEIGHT 3
  endhandle
  PTCOLOUR $!this.params[5]
  handle ANY
    PTCOLOUR 7
  endhandle
  -- Dimension Line Attributes
  DLSTYLE $!this.params[6]
  handle ANY
    DLSTYLE Solid
  endhandle
  DLCOLOUR $!this.params[7]
  handle ANY
    DLCOLOUR 4
  endhandle
  DFONT $!this.params[8]
  handle ANY
    DFONT 3
  endhandle
  DTCHEIGHT $!this.params[9]
  handle ANY
    DTCHEIGHT 3
  endhandle
  DTCOLOUR $!this.params[10]
  handle ANY
    DTCOLOUR 6
  endhandle
  --
  --<wd>09jun2010 - DFN P-30977 (SI-22656) - All occurrences of !passedParams[?] replaced with !this.params[?]
  --
  --<wd>02apr2008 - DUN824 - Defect No. P-4526
  --------------------------------------------
endmethod
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
define method .tidydim(!ldim is DBREF)
  !!ce = !ldim
  SORT DIM
  handle ANY
  endhandle
  -- remove any zero length dimensions
  var !dppts coll all DPPT for ce
  do !dppt values !dppts
    $!dppt
    var !dmtx expanded DMTX
    handle (2,235) $* expanded text not available
      !t = !!ce.type
      delete $!t
    elsehandle NONE
      skip if (!dmtx.eq('unset'))
      if (!dmtx.eq('0')) then
        !t = !!ce.type
        delete $!t
      endif
    endhandle
  enddo
  LDIM
  SORT DIM
  handle ANY
  endhandle
  if !!ce.members.size().lt(2) then
    delete ldim
  endif
endmethod
--------------------------------------------------------------------------------
-----------------------------------------------------------------------------
-- Method to determine if a dppt or dpos DMTX will fit within the
-- projection lines. If text is too large the dpoi or dppt has dtang set
-- to parallel. This will force the dimension text to appear outside the
-- projection lines.
-----------------------------------------------------------------------------
-- Arguments:
-- ldim = LDIM to be processed
-- !shtDir = DIRECTION of ldim on sheet U or R
-----------------------------------------------------------------------------
--------------------------------------------------------------------------------
define method .fixdims(!ldim is DBREF, !shtDir is STRING)
  -->>-<wd>jan2003
  !elem = !ldim
  --<<-<wd>jan2003
  $!ldim
  !units = object COMUNITS(TRUE)
  UNITS MM DIST
  -- get the letter height
  !chei = !!ce.dtch
  !yoff = !chei * 2
  laye
  -- check for imperial units - switch to mm for this procedure and then
  -- switch back at end
  var !ucode ucode
  if (!ucode.upcase().match('MM DIST').eq(0)) then
    UCODE MM DIST
    UPDATE ANNO
    handle ANY
    endhandle
  endif
  VIEW
  !vsca = !!ce.vscale
  -->>-<wd>jan2003
  -- Discovered when trying to output IMPERIAL DIMENSIONS on MDS HANGER Drawings
  -- The command -- $!ldim -- is NOT navigating to the 'LDIM' as REQUIRED, this is because the
  -- variable *** !ldim *** appears to be resetting itself to the VIEW - *** weird or what ???? ***
  -- *** I think I must being going mad!! ***
  -- Anyway resetting the **!!ce = !elem ** (!elem set to !ldim on entry to this method)
  -- instead of the syntax command ** $!ldim ** fixes the problem!!!
  --$!ldim
  !!ce = !elem
  --<<-<wd>jan2003
  var !points coll all ldim members for ce
  -- check each points dimension value
  -- and determine if the dmtx need moving
  do !point values !points
    $!point
    var !dim expa dmtx
    handle ANY
      skip
    endhandle
    skip if (!dim.upcase().eq('UNSET'))
    -- convert the design distance to a sheet distance
    !sDist = $!dim * $!vsca
    skip if (!dim.trim().length().eq(0))
    -- check if the letter height will fit inside the projection lines
    if (!sDist.lt(!chei)) then
      -- move the text
      -- if the dimension goes up the sheet then simply set the DTANG
      if (!shtDir.eq('U') or !shtDir.eq('Z')) then
        DTANG PARALLEL
      else
        DTANG PARALLEL
        DTOF 0 -$!yoff
      endif
    endif
  enddo
  LAYER
  -- reset the ucode and units
  UCODE $!ucode
  UPDATE ANNO
  handle ANY
  endhandle
  !units.restoreSavedUnitsByPtype('DIST')
endmethod
