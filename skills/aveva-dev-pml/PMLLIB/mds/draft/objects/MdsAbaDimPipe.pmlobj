--------------------------------------------------------------------------------
--
-- File: MdsAbaDimPipe.pmlobj
--   Type: Object Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: Draft MDS using ABA for Drawing production
--   Replaces:
--
-- Author: Steve Robinson
-- Created: 2nd July 2002
--
--
-- Description:
-- ------------
-- This object generates E/N coordinate dimensions for MDS ABA support attas.
-- A single dimension is generated with a dppt attached to each atta P0.
-- The ldim then has the dlfg set to PROJ to turn off the dimension arrows
-- and dmtx.
--
-- NOTE: If the view direction is not orthogonal (N,S,E or W) then NO pipe
-- coordinate labels will be generated
--
-- Using this object:
-- ------------------
-- For each view to be annotated make an instance of this object and pass the
-- array of pipe atta DBREFs and view DBREF.
--
-- Before calling the .dimension() method make sure the PIPE_Dims layer
-- exists and had the relevant UCODE, PCODE and other text defaults set. This
-- allows you to control the appearance of the annotation before is it generated.
-- Note: If the dim layer does not exist then the method will create it and
-- and atts cascaded from view level will take effect.
--

-- IMPERIAL UNITS:
-- ---------------
-- The code should work in both metric and imperial units...
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dimension(STRING,STRING,MDSABASUPPORT) -
--  mdsabadimpipe(ARRAY,DBREF)       -
--
--------------------------------------------
--
--------------------------------------------------------------------------------
-- Define Object

define object MDSABADIMPIPE

  member .attas    is ARRAY        $* Array of support atta DBREFS to be dimensioned
  member .view     is DBREF        $* VIEW where dimensions are to be created
  member .units    is COMUNITS

--------------------------------------------------------------------------------
endobject

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
----------------------------------------------------------
-- Constructor to get design data and populate this object
----------------------------------------------------------
-- Arguments:
-- attas = array of DBREFS of support attas to be labelled
-- view = DBREF of view where attas will be dimensioned
----------------------------------------------------------
define method .mdsabadimpipe(!attas is ARRAY, !view is DBREF)

    !units = object COMUNITS(TRUE)
    !this.units = !units
    !saveRef = !!ce
    !this.attas = !attas
    !this.view  = !view
    $!saveRef

endmethod

--------------------------------------------------------------------------------
--------------------------------------------------------------------------------

------------------------------------------------------
-- Method to generate pipe labels for support attas
------------------------------------------------------

--<wd>feb2005
--define method .dimension(!params is STRING,!type is STRING)
define method .dimension(!params is STRING,!type is STRING,!dummymdsobject is MDSABASUPPORT)
--<wd>feb2005

--------------------------------------------
--<wd>02apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
-- Obsolete Parameter Nos and Some Pen Attributes  -- Params passed as string
-- Obsolete Parameter Nos and Some Pen Attributes  -- 1  Projection Line Pen  PLPN
-- Obsolete Parameter Nos and Some Pen Attributes  -- 2  Dimension Line Pen   DLPN
-- Obsolete Parameter Nos and Some Pen Attributes  -- 3  Dimension Text Pen   DTPN
-- Obsolete Parameter Nos and Some Pen Attributes  -- 4  Projection Text Pen  PTPN
-- Obsolete Parameter Nos and Some Pen Attributes  -- 5  Dimension Text Font  DFONT
-- Obsolete Parameter Nos and Some Pen Attributes  -- 6  Projection Text Font PFONT
-- Obsolete Parameter Nos and Some Pen Attributes  -- 7  Dimension Text Size  DTCH
-- Obsolete Parameter Nos and Some Pen Attributes  -- 8  Projection Text Size PTCH
-- Obsolete Parameter Nos and Some Pen Attributes  -- 9  Terminator Size      TSIZE
-- Obsolete Parameter Nos and Some Pen Attributes  -- 10 Terminator           DTERM
-- Obsolete Parameter Nos and Some Pen Attributes  -- 11 Bolt dimensions      on/off
--
-- NEW 12.0 version Parameters (DIMENSION Pen Attributes etc...) passed as a STRING
-- *** IMPORTANT NOTE ***
-- Depending on whether U-Bolt Hole Dimensions are required, the number of parameters may vary!!!
-- Either 12 or 13 parameters my be passed here???
-- i.e.
-- <1> -- When U-Bolt Hole Dimensions are required then parameter 13 MUST be PASSED/DEFINED and set to TRUE
-- <2> -- When parameter 13 is either NOT PASSED/UNDEFINED or DEFINED and SET to FALSE, the U-Bolt Hole Dimensions will NOT be displayed
-- ONLY 12 or 13 parameters are passed here as the ORIGINAL 1st parameter toggle value (TRUE or FALSE)
-- in the STRING of 13 or 14 Parameters has been REMOVED in the MDS ABA MAIN VIEW calling ABA TASK FUNCTION "mdsabaviewtask.pmlfnc"
--
--  1 Projection Line Style  = PLSTYLE
--  2 Projection Line Colour = PLCOLOUR
--  3 Projection Text Font   = PFONT
--  4 Projection Text Size   = PTCHEIGHT
--  5 Projection Text Colour = PLCOLOUR
--  6 Dimension Line Style   = DLSTYLE
--  7 Dimension Line Colour  = DLCOLOUR
--  8 Dimension Text Font    = DFONT
--  9 Dimension Text Size    = DTCHEIGHT
-- 10 Dimension Text Colour  = DLCOLOUR
-- 11 Terminator Size        = TSIZE
-- 12 Terminators            = DTERMINATOR
-- 13 U-Bolt Hole Dimensions = TRUE or FALSE
--
--<wd>02apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

  /FRA/TEMPLATES
  handle ANY
    !pltxflag = TRUE
    !uddimflag = TRUE
-- This was set too FALSE but was probably wrong.
-- Changed to TRUE for Remedy Call 31690 for BEE.
-- !uddimflag = FALSE
  elsehandle NONE
    !pltxflag = FALSE
    !uddimflag = FALSE
  endhandle

--------------------------------------------
--<wd>28feb2008 - DUN824 - Defect No. P-4405
-- Determine if COORD XYZ or COORD ENU is being used
    var !coord coord
--<wd>28feb2008 - DUN824 - Defect No. P-4405
--------------------------------------------

-- !type is either 'COORDINATES' or 'DIMENSIONS
  if (!type.eq('COORDINATES')) then
    !suffix = 'LR-PIPES'
  elseif (!type.eq('DIMENSIONS')) then
    !suffix = 'DM-PIPES'
  endif

  !passedparams = !params.split(',')

-- dimension layer suffix
  !dimLayer = 'PIPE_Dims'

-- navigate to view
  $!this.view

-- get view region for dimension positioning
  !vreg = !!ce.vreg

-- get direction of view
  !vdir = !!ce.dir

--------------------------------------------
--<wd>11mar2008 - DUN824 - Defect No. P-4405
--COORD XYZ or COORD ENU is being used
--  if !vdir.string().before(' WRT').eq('D') then
  if (!vdir.string().before(' WRT').eq('D')) or (!vdir.string().before(' WRT').eq('-Z')) then
--<wd>11mar2008 - DUN824 - Defect No. P-4405
--------------------------------------------

    !uddimflag = FALSE
  endif

-- check dimension layer exists
  set
  */$!dimLayer
  handle any
    new layer */$!dimLayer
  endhandle
  !layer = !!ce

--------------------------------------------
--<wd>02apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
-- -- Set the Dimension Attibutes Form with the Stored Values at the View Task
--  PLPN  $!passedparams[1]
--  DLPN  $!passedparams[2]
--  TSIZE $!passedparams[9]
--  DTERM $!passedparams[10]
--
--  -- tm added for extra labels for bolt holes
--  FONT  $!passedparams[5]
--  CHEI  $!passedparams[7]
--  TPEN  $!passedparams[3]
--  LTERM $!passedparams[10]
--  LLPN  $!passedparams[1]
--  LFRA FALSE
--
-- Set the Dimension Attibutes Form with the Stored Values at the View Task
-- All of the 'handle any' lines etc.. have been added to ensure that the MDS ABA default value is USED if an ERROR occurs
-- At LAYER level
--
-- Projection Line Attributes
    PLSTYLE $!passedparams[1]
    handle ANY
      PLSTYLE Solid
    endhandle
    PLCOLOUR $!passedparams[2]
    handle ANY
      PLCOLOUR 4
    endhandle

-- Dimension Line Attributes
    DLSTYLE $!passedparams[6]
    handle ANY
      DLSTYLE Solid
    endhandle
    DLCOLOUR $!passedparams[7]
    handle ANY
      DLCOLOUR 4
    endhandle

    TSIZE $!passedparams[11]
    handle ANY
      TSIZE 3
    endhandle
    DTERM $!passedparams[12]
    handle ANY
      DTERM Arrows
    endhandle
--
-- Additional LABEL attributes required for U-Bolt Hole Dimensions SET at LAYER level (as per "tm" comment above)
-- Label COLOUR, FONT type and FONT SIZE Attributes
    TXCOLOUR $!passedparams[7]
    handle ANY
      TXCOLOUR 1
    endhandle
    FONT     $!passedparams[8]
    handle ANY
      FONT 3
    endhandle
    CHEIGHT  $!passedparams[9]mm
    handle ANY
      CHEIGHT 4mm
    endhandle

-- Label Leader Line Attributes
    LLSTYLE $!passedparams[1]
    handle ANY
      LLSTYLE Solid
    endhandle
    LLCOLOUR $!passedparams[2]
    handle ANY
      LLCOLOUR 4
    endhandle
    LTERM $!passedparams[12]
    handle ANY
      LTERM Arrows
    endhandle

-- Label Frame Attributes
    LFRA FALSE
    LFSTYLE $!passedparams[1]
    handle ANY
      LLSTYLE Solid
    endhandle
    LFCOLOUR $!passedparams[2]
    handle ANY
      LFCOLOUR 4
    endhandle
--
--<wd>02apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

-- clear any existing dimensions
--    DELETE LAYER MEMBERS
--    handle any
--    endhandle

-- go to stru and get operational direction
-- ONLY generate pipe dims (labels) in views that are normal to
-- the frame YDIR
-- Set the Current Element <The */PIPE_Dims LAYER>
  !ceo = !!ce
  do !atta values !this.attas
    skip if (!atta.name.match('/DATUM').eq(0))
    --!struname = !!ce.name.before('/DATUM')
    !struname = !atta.name.before('/DATUM')
    $!struname

--<wd>mar2003
-- Get the DATUM Atta's ORTHOGONAL DIRECTION and OPPOSITE ORTHOGONAL DIRECTION from the ARRAY <!!mdsarray> of MDSABASUPPORT objects
    do !objindx indices !!mdsarray
     skip if !!mdsarray[!objindx].support.name.neq(!struname)
      !ydir = !!mdsarray[!objindx].mdsdata.datumorthdir
      break
    enddo
-- Navigate Back to the LAYER <The */PIPE_Dims LAYER>
    !!ce = !ceo
    --!ydir = !atta.ori.ydir()

-- RETURN if the DATUM Atta's ORTHOGONAL DIRECTION or OPPOSITE ORTHOGONAL DIRECTION
-- is NOT the SAME as the VIEW DIRECTION
--<wd>mar2003

-->>>-<wd>sep2002
-- return if the stru direction is not same as view direction
--      if (!ydir.neq(!vdir) and !ydir.opposite().neq(!ydir)) then
    if (!ydir.neq(!vdir) and !ydir.opposite().neq(!vdir)) then
--<<<-<wd>sep2002
       return
    endif
  enddo

--------------------------------------------
--<wd>10mar2008 - DUN824 - Defect No. P-4405
-- Now caters for XYZ co-ordinates
--
-- get view direction and determine dimension direction up and to right of
-- view
  var !rdir viewdir right
--  !rdirection = $!rdir
  !rdirection = !rdir.direction()
  var !udir viewdir up
--  !udirection = $!udir
--  !udirection = !udir.direction()
--
--<wd>10mar2008 - DUN824 - Defect No. P-4405
--------------------------------------------

-- check that dimension direction is N,S,E or W otherwise
-- no pipe coordinates will be generated
--<wd>mar2003
   if (!type.eq('COORDINATES')) then
      if !pltxflag then
       if (!rdirection.eq(N)) then
         !pltx = '~C #POSN'
       elseif (!rdirection.eq(S)) then
         !pltx = '~C #POSN'
       elseif (!rdirection.eq(E)) then
         !pltx = '~C #POSE'
       elseif (!rdirection.eq(W)) then
         !pltx = '~C #POSE'
       else
         return
       endif
     else
       return
     endif
   elseif (!type.eq('DIMENSIONS')) then
     !pltx = ''
   endif
--<wd>mar2003

-- create new ldim
-->>-<wd>mar2003
--    NEW LDIM */$!dimLayer/LR-PIPES
-->>-<wd>may2003
--    NEW LDIM */$!dimLayer/$!suffix
--<<-<wd>mar2003

--------------------------------------------------
-- L/R Dimensions
--------------------------------------------------
   do !indx from 1 to 10
     NEW LDIM */$!dimLayer/$!suffix
     handle (41,12) $* Name already exists
       NEW LDIM */$!dimLayer/$!<suffix>-$!indx
       handle (41,12) $* Name already exists
         skip
       elsehandle none
         break
       endhandle
     elsehandle none
       break
     endhandle
   enddo
--<<-<wd>may2003

--------------------------------------------
--<wd>02apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
-- At LDIM level
--
--  DTPN  $!passedparams[3]
--  PTPN  $!passedparams[4]
--  DFONT $!passedparams[5]
--  PFONT $!passedparams[6]
--  DTCH  $!passedparams[7]
--  PTCH  $!passedparams[8]

-- Projection Line Attributes
    PLSTYLE $!passedparams[1]
    handle ANY
      PLSTYLE Solid
    endhandle
    PLCOLOUR $!passedparams[2]
    handle ANY
      PLCOLOUR 4
    endhandle
    PFONT $!passedparams[3]
    handle ANY
      PFONT 3
    endhandle
    PTCHEIGHT $!passedparams[4]
    handle ANY
      PTCHEIGHT 3
    endhandle
    PTCOLOUR $!passedparams[5]
    handle ANY
      PTCOLOUR 7
    endhandle

-- Dimension Line Attributes
    DLSTYLE $!passedparams[6]
    handle ANY
      DLSTYLE Solid
    endhandle
    DLCOLOUR $!passedparams[7]
    handle ANY
      DLCOLOUR 4
    endhandle
    DFONT $!passedparams[8]
    handle ANY
      DFONT 3
    endhandle
    DTCHEIGHT $!passedparams[9]
    handle ANY
      DTCHEIGHT 3
    endhandle
    DTCOLOUR $!passedparams[10]
    handle ANY
      DTCOLOUR 6
    endhandle
--
--<wd>02apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

-- Atta dimensions
  !ldimref = !!ce
  DIR $!rdir

--<wd>mar2003
  !array = ARRAY()
--<wd>mar2003

  do !atta values !this.attas
    new dppt on $!atta pltx '$!pltx'
      handle ANY
      endhandle

--<wd>mar2003
    !array.append(!!ce)
--<wd>mar2003
  enddo
  !save = !!ce

--------------------------------------------
--<wd>02apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
-- There is now a maximum of 13 parameters and not 11 parameters as before at version MDS ABA 11.6
-- At LDIM level
--
-- --<tm>  add ubolt dimensions to the atta
--   if defined(!passedparams[11]) then
--     if !passedparams[11].boolean() then
--
  if defined(!passedparams[13]) then
    if !passedparams[13].boolean() then
--
--<wd>02apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

      do !atta values !this.attas
        !obj = object MDSUBOLTHOLES(!atta,!this.units)
        !obj.adddim(!layer)
      enddo
    endif
  endif

  !!ce = !save

--<wd>mar2003
-- Only Process the Passed Type
  if (!type.eq('COORDINATES')) then
    LDIM
    DLFG PROJ PJUST AWAY OVERSHOOT 0
    SORT DIM
    handle any
    endhandle
    --!y = !vreg[2] + (2 * dtch)
    !y = !vreg[2] + (4 * dtch)
    DPOS X $!vreg[1] Y $!y

  elseif (!type.eq('DIMENSIONS')) then
    LDIM
    DLFG ALL PJUST AWAY OVERSHOOT 1
    SORT DIM
    handle any
    endhandle
    --!y = !vreg[2] + (2 * dtch)
    !y = !vreg[2] + (3 * dtch)
    DPOS X $!vreg[1] Y $!y

    do !indx values !array
      !!ce = !indx
      handle any
        skip
      endhandle
-- <tm> added bit to handle edmtx errors
      !dimtx = !!ce.exdmtxt
      handle any $* -- cannot get EDMTX
        if !!ce.owner.type.eq('LDIM') and !!ce.owner.members.size().eq(1) then
          ldim
          delete ldim
        endif
        skip
      endhandle
      if (!dimtx.eq('0')) then
        delete dppt
-- <tm> added bit to delete empty ldims
        if !!ce.members.size().eq(1) then
          delete ldim
        endif
      else
        skip
      endif
    enddo
  endif
--<wd>mar2003

--------------------------------------------------
-- U/D Dimensions
--------------------------------------------------
  if !uddimflag then

--------------------------------------------
--<wd>11mar2008 - DUN824 - Defect No. P-4405
--COORD XYZ or COORD ENU is being used
--    if !vdir.string().before(' WRT').eq('D') then
    if (!vdir.string().before(' WRT').eq('D')) or (!vdir.string().before(' WRT').eq('-Z')) then
--<wd>11mar2008 - DUN824 - Defect No. P-4405
--------------------------------------------
      !pltx = ''
    else
      if (!type.eq('COORDINATES')) then

--------------------------------------------
--<wd>28feb2008 - DUN824 - Defect No. P-4405
-- Determine the current COORD system, XYZ or ENU????
--        !pltx = 'EL. #POSU+'
        if (!coord.upcase().trim().eq('ENU')) then
          !pltx = 'EL. #POSU+'
        elseif (!coord.upcase().trim().eq('XYZ')) then
          !pltx = '#POSU'
        endif
--<wd>28feb2008 - DUN824 - Defect No. P-4405
--------------------------------------------

      elseif (!type.eq('DIMENSIONS')) then

--------------------------------------------
--<wd>28feb2008 - DUN824 - Defect No. P-4405
-- Determine the current COORD system, XYZ or ENU????
--       !pltx = 'EL. #POSU+'
        if (!coord.upcase().trim().eq('ENU')) then
          !pltx = 'EL. #POSU+'
        elseif (!coord.upcase().trim().eq('XYZ')) then
          !pltx = '#POSU'
        endif
--<wd>28feb2008 - DUN824 - Defect No. P-4405
--------------------------------------------

      endif
    endif

-- Determine the NEW LDIM element name and suffix etc...
    do !indx from 1 to 10
      NEW LDIM */$!dimLayer/$!suffix
      handle (41,12) $* Name already exists
        NEW LDIM */$!dimLayer/$!<suffix>-$!indx
        handle (41,12) $* Name already exists
          skip
        elsehandle none
          break
        endhandle
      elsehandle none
        break
      endhandle
    enddo

--------------------------------------------
--<wd>02apr2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
-- At LDIM level
--
--    DTPN  $!passedparams[3]
--    PTPN  $!passedparams[4]
--    DFONT $!passedparams[5]
--    PFONT $!passedparams[6]
--    DTCH  $!passedparams[7]
--    PTCH  $!passedparams[8]
--
-- Projection Line Attributes
    PLSTYLE $!passedparams[1]
    handle ANY
      PLSTYLE Solid
    endhandle
    PLCOLOUR $!passedparams[2]
    handle ANY
      PLCOLOUR 4
    endhandle
    PFONT $!passedparams[3]
    handle ANY
      PFONT 3
    endhandle
    PTCHEIGHT $!passedparams[4]
    handle ANY
      PTCHEIGHT 3
    endhandle
    PTCOLOUR $!passedparams[5]
    handle ANY
      PTCOLOUR 7
    endhandle

-- Dimension Line Attributes
    DLSTYLE $!passedparams[6]
    handle ANY
      DLSTYLE Solid
    endhandle
    DLCOLOUR $!passedparams[7]
    handle ANY
      DLCOLOUR 4
    endhandle
    DFONT $!passedparams[8]
    handle ANY
      DFONT 3
    endhandle
    DTCHEIGHT $!passedparams[9]
    handle ANY
      DTCHEIGHT 3
    endhandle
    DTCOLOUR $!passedparams[10]
    handle ANY
      DTCOLOUR 6
    endhandle
--
--<wd>02apr2008 - DUN824 - Defect No. P-4526
--------------------------------------------

-- Atta dimensions
    !ldimref = !!ce
    DIR $!udir

--<wd>mar2003
    !array = ARRAY()
--<wd>mar2003

    do !atta values !this.attas
      !attastyp = !atta.styp
      handle ANY
        skip
      elsehandle NONE

--------------------------------------------
--<wd>12mar2008 - DUN824 - Defect No. P-4405
-- Skip MDS TEMPLATE HANGER ATTAS as well as HANGER ATTAS used with the Manufacturer Interfaces
       skip if !attastyp.unset()
       skip if !attastyp.matchwild('FH*') or !attastyp.matchwild('VH*')
--<wd>12mar2008 - DUN824 - Defect No. P-4405
--------------------------------------------

        if !attastyp.eq('MH01') then
          skip
        endif

     endhandle

      new dppt on $!atta pltx '$!pltx'
      handle any
      endhandle
  --<wd>mar2003
      !array.append(!!ce)
  --<wd>mar2003
    enddo

  -- Only Process the Passed Type
    if (!type.eq('COORDINATES')) then
      LDIM
      DLFG PROJ PJUST AWAY OVERSHOOT 0
      SORT DIM
      handle any
      endhandle
      --!y = !vreg[2] + (2 * dtch)
      !y = !vreg[2] + (4 * dtch)
      !x = !vreg[1] + (4 * dtch)
      DPOS X $!x Y $!y

    elseif (!type.eq('DIMENSIONS')) then
      LDIM
      DLFG ALL PJUST AWAY OVERSHOOT 1
      SORT DIM
      handle any
      endhandle
      --!y = !vreg[2] + (2 * dtch)
      !y = !vreg[2] + (3 * dtch)
       !x = !vreg[1] + (4 * dtch)
      DPOS X $!x Y $!y

      !testflag = FALSE
      do !indx values !array
        !!ce = !indx
        handle any
          skip
        endhandle
  -- <tm> added bit to handle edmtx errors
        !dimtx = !!ce.exdmtxt
        handle any $* -- cannot get EDMTX
          if !!ce.owner.type.eq('LDIM') and !!ce.owner.members.size().eq(1) then
            ldim
            delete ldim
          endif
          skip
        endhandle
        --if (!dimtx.eq('0')  ) then
        if (!dimtx.eq('0') or !dimtx.eq('') ) then
          -- dtf if pltx required we need to leave 1 dim
--          if !pltx.neq('') and !count.eq(2) then
         if !pltx.neq('') and !testflag.not() then
            if !!ce.ddnm.name.match('SREF').eq(0) then
              !conntype = p1 conn of ddnm
              if !conntype.eq('HVAS') then
                nppt 0
              else
                nppt 9
              endif
              pltx ''
              !testflag = TRUE
              skip
            elseif !!ce.owner.members.size().gt(1) and !!ce.ddnm.name.match('SREF').gt(0) then
              skip
            endif
          endif
          delete dppt
-- <tm> added bit to delete empty ldims
          if !!ce.members.size().eq(1) then
            if !pltx.neq('') then
              skip
            else
              delete ldim
            endif
          endif
        else
          skip
        endif
      enddo
    endif

  endif

endmethod
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
-- End of Object - mdsabadimpipe
