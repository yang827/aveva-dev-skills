      skip if (!pkey.eq(''))
      -- dim both ends of sctn and clear up any zero length dim points later!
      new dppt on $!ddnm pkey $!pkey pkdi 0
      -- add elevation PLTX if necessary
      if (!sctn.elev) then
--<wd>18dec2008 - Defect No. P-13975 -- Determine if SCTN is vertical and ADD PLTX if TRUE
