--<wd>10mar2008 - DUN824 - Defect No. P-4405
-- Now caters for XYZ co-ordinates
--
    -- get view direction and determine dimension direction up and to right of
    -- view
    var !rdir viewdir right
--    !rdirection = $!rdir
    !rdirection = !rdir.direction()
    var !udir viewdir up
--    !udirection = $!udir
    !udirection = !udir.direction()
--
--<wd>10mar2008 - DUN824 - Defect No. P-4405
--------------------------------------------

    -- collect all stiffeners and base plate subs for stru
    -- base plates will be dimensioned to TR corner on views
    -- stiffeners will be dimensioned to centre of box on views
    var !subs coll all subs with (purp eq 'S' or purp eq 'B') for $!this.stru

    -- create new ldims
    ---------------------------------------------------------------------------
    -- L/R DIMENSION -- For stiffeners and baseplates
    ---------------------------------------------------------------------------
    $!layer
    NEW LDIM */$!dimLayer/LR-PLATE

--------------------------------------------
--<wd>27mar2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
--    DTPN $!passedparams[3]
--    PTPN $!passedparams[4]
--    DFONT $!passedparams[5]
--    PFONT $!passedparams[6]
--    DTCH $!passedparams[7]
--    PTCH $!passedparams[8]

-- Projection Line FONT Attributes
    PFONT $!passedparams[3]
    handle ANY
      PFONT 3
    endhandle
    PTCHEIGHT $!passedparams[4]
    handle ANY
      PTCHEIGHT 3
    endhandle
    PTCOLOUR $!passedparams[5]
    handle ANY
      PTCOLOUR 7
    endhandle

-- Dimension Line FONT Attributes
    DFONT $!passedparams[8]
    handle ANY
      DFONT 3
    endhandle
    DTCHEIGHT $!passedparams[9]
    handle ANY
      DTCHEIGHT 3
    endhandle
    DTCOLOUR $!passedparams[10]
    handle ANY
      DTCOLOUR 6
    endhandle
--
--<wd>27mar2008 - DUN824 - Defect No. P-4526
--------------------------------------------

    !ldimref = !!ce
    DIR $!rdir
    do !sub values !subs
      $!sub
      var !boxes coll all box for ce
      -- dimension stiffeners
      if (purp eq 'S') then
        do !box values !boxes
          -- only dimension the stiffener if its primary direction
          -- is the same as the dimension direction
          !boxref = $!box
          !boxdir = !this.boxdir(!boxref)
          -- skip if (!boxdir.neq(!rdirection) and $
             --       !boxdir.neq(!rdirection.opposite()))
          $!ldimref
          new dppt on $!box
        enddo
      -- dimension baseplates
      elseif (purp eq 'B') then
        do !box values !boxes
          -- only dimension the baseplate if its primary direction
          -- is the same as the view direction
          !boxref = $!box
          !boxdir = !this.boxdir(!boxref)
          -- skip if (!boxdir.neq(!vdir) and $
             --       !boxdir.neq(!vdir.opposite()))
          $!ldimref
          new dpba on $!box baind after
        enddo
      endif
    enddo
    -- check if user has specified a datum position otherwise dimension to stru
    -- origin
    $!ldimref
    if (!this.datumPos.up.unset()) then
      new dppt on $!this.stru
    else
      !dp = !this.datumPos.string().before('WRT')
      new dpoi position $!dp
    endif
    LDIM
    SORT DIM
    handle any
    endhandle
    -- remove any zero length dimensions
    var !dppts coll all (DPPT DPOI) for ce
    do !dppt values !dppts
      $!dppt
      var !dmtx expanded DMTX
      handle (2,235) $* expanded text not available
        !t = !!ce.type
        delete $!t
      elsehandle none
        skip if (!dmtx.eq('unset'))
        if (!dmtx.eq('0')) then
          !t = !!ce.type
          delete $!t
        endif
      endhandle
    enddo
    LDIM
    !dimref = !!ce
    SORT DIM
    handle any
    endhandle
    !y = !vreg[4] - 10
    DPOS X $!vreg[3] Y $!y

    ---------------------------------------------------------------------------
    -- U/D DIMENSION -- For stiffeners and baseplates
    ---------------------------------------------------------------------------
    $!layer
    NEW LDIM */$!dimLayer/UD-PLATE

--------------------------------------------
