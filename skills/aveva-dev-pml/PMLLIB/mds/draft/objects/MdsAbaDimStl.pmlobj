    if (!this.datumPos.up.unset()) then
       new dppt on $!this.stru
    else
      !dp = !this.datumPos.string().before('WRT')
      new dpoi position $!dp
    endif
    LDIM
    SORT DIM
    handle any
    endhandle
    -- remove any zero length dimensions
    var !dppts coll all (DPPT DPOI) for ce
    do !dppt values !dppts
      $!dppt
      var !dmtx expanded DMTX
      handle (2,235) $* expanded text not available
        !t = !!ce.type
        delete $!t
      elsehandle none
        skip if (!dmtx.eq('unset'))
        if (!dmtx.eq('0')) then
          !t = !!ce.type
          delete $!t
        endif
      endhandle
    enddo
    LDIM
    SORT DIM
    handle any
    endhandle
    -- If the dimension has only one remaining dim point and
    -- the pltx is set (elevation) then switch DLFG to projection.
    -- This will display any single elevation point
    if (!!ce.mcount.eq(1)) then
      1
      if (!!ce.pltx.neq('#DEF')) then
        LDIM
        DLFG PROJ
      endif
    endif
    LDIM
    !dimref = !!ce
    DPOS X $!vreg[1] Y $!vreg[2]

    -- Call the method to move any dmtx that may hit projection lines.
    -- Wrap this call in a handle - if anything goes wrong don't let it
    -- bomb the whole dimensioning routine
    LAYE
    var !ucode UCODE
    !units = object COMUNITS(TRUE)
    $!dimref
    !this.fixdims(!dimref,'U')
    handle any
      LAYE
      UCODE $!ucode
      !units.restoreSavedBoreDist()
      update anno
      handle any
      endhandle
    endhandle

-- We need to dimension the eccentricity any connections to plates
-- We only need to dimension the view that is perpendicular to the plate face
-- The P1 of the plate will either point into or out of the view direction

    view
    !viewdirection = dir
    !viewdirectionS = !viewdirection.string().before('WRT').trim()
    !plates = ARRAY()
    !sections = ARRAY()
    do !sctn values !this.sctnData
      !mdsancref = !sctn.sctn.:MdsAncRef
      do !loop from 1 to !mdsancref.size()
        if (!mdsancref[$!loop].badref().not()) then

          -- TEST FIX COMMENTED OUT BY RM ON 15/03/06
          -- added by Richard Martin 10/03/06 FT22 bedplates are not dimensioned correctly
          -- HPD0031691
          --if !mdsancref[$!loop].:MDSSuppType neq 'FT22' then
            !p1dir = !mdsancref[$!loop].pdir[1].wrt(/* ).string().before('WRT').trim()
            !p1diro = !p1dir.direction().opposite().string().before('WRT').trim()
            !pno = 1
          --else
          --  !!ce = !mdsancref[$!loop]
          --  subs 1
          --  1
          --  !mdsancref[$!loop] = !!ce
          --  !pno = 3
          --endif

          !p1dir = !mdsancref[$!loop].pdir[!pno].wrt(/* ).string().before('WRT').trim()
          !p1diro = !p1dir.direction().opposite().string().before('WRT').trim()

          if !p1dir.string().eq(!viewdirectionS) or !p1diro.string().eq(!viewdirectionS) then
            !plates.append(!mdsancref[$!loop])
            !sections.append(!sctn.sctn)
          endif
        endif
      enddo
    enddo

-- The above loop could have found us a sctn and plate if so dimension them

    !dimcounter = 1
    if !sections.size().gt(0) then
    do !dimconn from 1 to !sections.size()
      $!layer
      !dim1num = !dimcounter
      !dim2num = !dimcounter + 1
      NEW LDIM */$!dimLayer/CONNECTIONS/$!dim1Num

--------------------------------------------
--<wd>27mar2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
--      DTPN $!passedparams[3]
--      PTPN $!passedparams[4]
--      DFONT $!passedparams[5]
--      PFONT $!passedparams[6]
--      DTCH $!passedparams[7]
--      PTCH $!passedparams[8]

-- Projection Line FONT Attributes
      PFONT $!passedparams[3]
      handle ANY
        PFONT 3
      endhandle
      PTCHEIGHT $!passedparams[4]
      handle ANY
        PTCHEIGHT 3
      endhandle
      PTCOLOUR $!passedparams[5]
      handle ANY
        PTCOLOUR 7
      endhandle

-- Dimension Line FONT Attributes
      DFONT $!passedparams[8]
      handle ANY
        DFONT 3
      endhandle
      DTCHEIGHT $!passedparams[9]
      handle ANY
        DTCHEIGHT 3
      endhandle
      DTCOLOUR $!passedparams[10]
      handle ANY
        DTCOLOUR 6
      endhandle
--
--<wd>27mar2008 - DUN824 - Defect No. P-4526
--------------------------------------------

      PJUST AWAY
      !ldimref = !!ce
      dir $!udir
      from p1 of $!plates[$!dimconn]
      to $!sections[$!dimconn]
      !dimDist = exdmtx
      if !dimDist.eq('0') then
        ldim
        delete ldim
        !dim2Num = !dim1Num
      else
        !dimcounter = !dimcounter + 1
      endif
      NEW LDIM */$!dimLayer/CONNECTIONS/$!dim2Num

--------------------------------------------
--<wd>27mar2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
--      DTPN $!passedparams[3]
--      PTPN $!passedparams[4]
--      DFONT $!passedparams[5]
--      PFONT $!passedparams[6]
--      DTCH $!passedparams[7]
--      PTCH $!passedparams[8]

-- Projection Line FONT Attributes
      PFONT $!passedparams[3]
      handle ANY
        PFONT 3
      endhandle
      PTCHEIGHT $!passedparams[4]
      handle ANY
        PTCHEIGHT 3
      endhandle
      PTCOLOUR $!passedparams[5]
      handle ANY
        PTCOLOUR 7
      endhandle

-- Dimension Line FONT Attributes
      DFONT $!passedparams[8]
      handle ANY
        DFONT 3
      endhandle
      DTCHEIGHT $!passedparams[9]
      handle ANY
        DTCHEIGHT 3
      endhandle
      DTCOLOUR $!passedparams[10]
      handle ANY
        DTCOLOUR 6
      endhandle
--
--<wd>27mar2008 - DUN824 - Defect No. P-4526
--------------------------------------------

      PJUST AWAY
      !ldimref = !!ce
      dir $!rdir
      from p1 of $!plates[$!dimconn]
      to $!sections[$!dimconn]
      !dimDist = exdmtx
      if !dimDist.eq('0') then
        ldim
        delete ldim
      else
        !dimcounter = !dimcounter + 1
      endif
    enddo
  endif

-- Find out if any dimensions have only 2 elements and the second is 0
-- Delete the dimensions

  $!layer
  var !memldims coll all ldim for ce
  do !loopLdims from 1 to !memldims.size()
    !!ce = !memldims[$!loopLdims].dbref()
    if !!ce.mcount.eq(2) then
      2
      !expandeddmtx = exdmtx
      if !expandeddmtx.eq('0') then
        ldim
        delete ldim
      endif
    endif
  enddo

  VIEW

endmethod

  -----------------------------------------------------------------------------
  -- Method to determine if a dppt or dpos DMTX will fit within the
  -- projection lines. If text is too large the dpoi or dppt has dtang set
  -- to parallel. This will force the dimension text to appear outside the
  -- projection lines.
  -----------------------------------------------------------------------------
  -- Arguments:
  -- ldim = LDIM to be processed
  -- !shtdir = direction of ldim on sheet U or R
  -----------------------------------------------------------------------------
  define method .fixdims(!ldim is DBREF, !shtdir is STRING)
    $!ldim
    !units = object COMUNITS(TRUE)
    UNITS MM DIST
    -- get the letter height
    !chei = !!ce.dtch
    !yoff = !chei * 2
    laye
    -- check for imperial units - switch to mm for this procedure and then
    -- switch back at end
    var !ucode ucode
    if (!ucode.upcase().match('MM DIST').eq(0)) then
      UCODE MM DIST
      UPDATE ANNO
      handle any
      endhandle
    endif
    VIEW
    !vsca = !!ce.vscale
    $!ldim
    var !points coll all ldim members for ce
    -- check each points dimension value
    -- and determine if the dmtx need moving
    do !point values !points
      $!point
      var !dim expa dmtx
      handle any
        skip
      endhandle
      skip if (!dim.upcase().eq('UNSET'))
      -- convert the design distance to a sheet distance
      !sdist = $!dim * $!vsca
      skip if (!dim.trim().length().eq(0))
      -- check if the letter height will fit inside the projection lines
      if (!sdist.lt(!chei)) then
        -- move the text
        -- if the dimension goes up the sheet then simply set the DTANG
        if (!shtdir.eq('U')) then
          DTANG PARALLEL
        else
          DTANG PARALLEL
          DTOF 0 -$!yoff
        endif
      -- if the text width will not fit in between the projection
      -- lines move the text away from the dimension line
      elseif ((!dim.trim().length() * !chei) gt !sdist) then
        !offset = !dim.trim().length() * !chei / 2
        -- move the text
        if (!shtdir.eq('U')) then
          DTOF 0 $!offset
        else
          DTOF 0 -$!offset
        endif
      endif
    enddo
    LAYER
    -- reset the ucode and units
    UCODE $!ucode
    UPDATE ANNO
    handle any
    endhandle
    !units.restoreSavedUnitsByPtype('DIST')
  endmethod

  -----------------------------------------------------------------
  -- Method to return direction of flat side of box:
  --  base plate direction
  --  stiffener direction
  -- This is used during dimensioning of baseplates and stiffeners.
  -----------------------------------------------------------------
  define method .boxdir(!box is DBREF) is DIRECTION
    if (!box.xlen.lt(!box.ylen) and !box.xlen.lt(!box.zlen)) then
      -- xlen is the smallest
      return (!box.pdir[1])
    elseif (!box.ylen.lt(!box.xlen) and !box.ylen.lt(!box.zlen)) then
      -- ylen is the smallest
      return (!box.pdir[2])
    elseif (!box.zlen.lt(!box.xlen) and !box.zlen.lt(!box.ylen)) then
      -- zlen is the smallest
      return (!box.pdir[3])
    else
      -- oh crap - they are all the same size use zlen as direction
      return (!box.pdir[3])
    endif
  endmethod

-- End of Object - mdsabadimstl
