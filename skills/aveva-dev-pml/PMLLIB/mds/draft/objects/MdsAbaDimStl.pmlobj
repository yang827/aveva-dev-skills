      endif

      new dppt on $!ddnm pkey $!pkey pkdi 1
-- add elevation PLTX if necessary
      if (!sctn.elev) then
--<wd>18dec2008 - Defect No. P-13975 -- Determine if SCTN is vertical and ADD PLTX if TRUE
        if (!sctn.dir.up.eq(-1)) or (!sctn.dir.up.eq(1)) then

--<wd>29feb2008 - DUN824 - Defect No. P4405
