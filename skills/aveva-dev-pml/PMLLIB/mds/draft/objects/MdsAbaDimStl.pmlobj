    !ldimref = !!ce
    DIR $!udir
    do !sub values !subs
      $!sub
      var !boxes coll all box for ce
      -- dimension stiffeners
      if (purp eq 'S') then
        do !box values !boxes
          -- only dimension the stiffener if its primary direction
          -- is the same as the dimension direction
          !boxref = $!box
          !boxdir = !this.boxdir(!boxref)
          -- skip if (!boxdir.neq(!udirection) and $
             --       !boxdir.neq(!udirection.opposite()))
          $!ldimref
          new dppt on $!box
        enddo
      -- dimension baseplates
      elseif (purp eq 'B') then
        do !box values !boxes
          -- only dimension the baseplate if its primary direction
          -- is the same as the view direction
          !boxref = $!box
          !boxdir = !this.boxdir(!boxref)
          -- skip if (!boxdir.neq(!vdir) and $
             --       !boxdir.neq(!vdir.opposite()))
          $!ldimref
          new dpba on $!box baind after
        enddo
      endif
    enddo
    -- check if user has specified a datum position otherwise dimension to stru
    -- origin
    $!ldimref
    if (!this.datumPos.up.unset()) then
      new dppt on $!this.stru
    else
      !dp = !this.datumPos.string().before('WRT')
      new dpoi position $!dp
    endif
    LDIM
    SORT DIM
    handle any
    endhandle
    -- remove any zero length dimensions
    var !dppts coll all (DPPT DPOI) for ce
    do !dppt values !dppts
      $!dppt
      var !dmtx expanded DMTX
      handle (2,235) $* expanded text not available
        !t = !!ce.type
        delete $!t
      elsehandle none
        skip if (!dmtx.eq('unset'))
        if (!dmtx.eq('0')) then
          !t = !!ce.type
          delete $!t
        endif
      endhandle
    enddo
    LDIM
    !dimref = !!ce
    SORT DIM
    handle any
    endhandle
    !x = !vreg[3] - 10
    DPOS X $!x Y $!vreg[4]


    ---------------------------------------------------------------------------
    -- L/R DIMENSION -- FOR SCTNS
    ---------------------------------------------------------------------------
    $!layer
    NEW LDIM */$!dimLayer/LR-STEEL

--------------------------------------------
--<wd>27mar2008 - DUN824 - Defect No. P-4526
-- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
--
--    DTPN $!passedparams[3]
--    PTPN $!passedparams[4]
--    DFONT $!passedparams[5]
--    PFONT $!passedparams[6]
--    DTCH $!passedparams[7]
--    PTCH $!passedparams[8]

-- Projection Line FONT Attributes
    PFONT $!passedparams[3]
    handle ANY
      PFONT 3
    endhandle
    PTCHEIGHT $!passedparams[4]
    handle ANY
      PTCHEIGHT 3
    endhandle
    PTCOLOUR $!passedparams[5]
    handle ANY
      PTCOLOUR 7
    endhandle

-- Dimension Line FONT Attributes
    DFONT $!passedparams[8]
    handle ANY
      DFONT 3
    endhandle
    DTCHEIGHT $!passedparams[9]
    handle ANY
      DTCHEIGHT 3
    endhandle
    DTCOLOUR $!passedparams[10]
    handle ANY
      DTCOLOUR 6
    endhandle
--
--<wd>27mar2008 - DUN824 - Defect No. P-4526
--------------------------------------------

    !ldimref = !!ce
    DIR $!rdir
    do !sctn values !this.sctnData
      -- skip sctn if direction same as or opposite to view direction and more
      -- than ONE sctn in stru
      skip if ((!sctn.dir.eq(!this.view.dir) or $
                !sctn.dir.opposite().eq(!this.view.dir)) and $
                !this.sctns.size().gt(1))
      -- To avoid problems with cutback plines (e.g. TOAX on ANGLES where joints
      -- are used)
      -- swap to NA if dimension direction is parallel to dimension direction
      if (!sctn.dir.eq(!rdirection) or !sctn.dir.eq(!rdirection.opposite())) $
      then
        !pkey = 'NA'
      elseif !sctn.sctn.gtyp.eq('PLAT') then
         !pkey = 'BOS'
      else
        !pkey = !sctn.dimkey
      endif
      !ddnm = !sctn.sctn
      skip if (!pkey.eq(''))
      -- dimension both ends of sctn and clear up any zero length dim points
      -- later!
      new dppt on $!ddnm pkey $!pkey pkdi 0
      new dppt on $!ddnm pkey $!pkey pkdi 1
    enddo
    -- check if user has specified a datum position otherwise dimension to stru
    -- origin
    if (!this.datumPos.up.unset()) then
      new dppt on $!this.stru
    else
      !dp = !this.datumPos.string().before('WRT')
      new dpoi position $!dp
    endif

-- If the ATTAS have a nudge position set we need to dimension these as well

    !supportstru = !this.stru
--<kp>jan07
--    if !supportstru.badref().not() then
    if !supportstru.badref().not().and(!supportstru.:mdssupptype.eq(!!mdslsuppdefs.type).not()) then
    -- must not be lighting support
      !supportname = !supportstru.name
      !dname = !supportname + '/DATUM'
      if !dname.dbref().:mdsnudgedist.neq(0) then
        new dppt ddnm $!dname
        nppt 9
      endif
      do !loopthrough from 1 to 50
        !attaname = !supportname + '.$!loopthrough'
        !mdsnudgedist = !attaname.dbref().:mdsnudgedist
          handle ANY
            break
          endhandle
        if !mdsnudgedist.neq(0) then
          new dppt ddnm $!attaname
          nppt 9
        endif
      enddo
    endif

    LDIM
    SORT DIM
    handle any
    endhandle
    -- remove any zero length dimensions
    var !dppts coll all (DPPT DPOI) for ce
    do !dppt values !dppts
      $!dppt
      var !dmtx expanded DMTX
      handle (2,235) $* expanded text not available
        !t = !!ce.type
        delete $!t
      elsehandle none
        skip if (!dmtx.eq('unset'))
        if (!dmtx.eq('0')) then
          !t = !!ce.type
          delete $!t
        endif
      endhandle
    enddo
    LDIM
    !dimref = !!ce
    SORT DIM
    handle any
    endhandle
    DPOS X $!vreg[1] Y $!vreg[2]

    -- Call the method to move any dmtx that may hit projection lines.
    -- Wrap this call in a handle - if anything goes wrong don't let it
    -- bomb the whole dimensioning routine
    LAYE
    var !ucode UCODE
    !units = object COMUNITS(TRUE)
    $!dimref
    !this.fixdims(!dimref,'R')
    handle any
      LAYE
      UCODE $!ucode
      !units.restoreSavedBoreDist()
      update anno
      handle any
      endhandle
    endhandle


    ---------------------------------------------------------------------------
    -- U/D DIMENSION -- U/D DIMENSION -- U/D DIMENSION -- U/D DIMENSION
    ---------------------------------------------------------------------------
    $!layer
    NEW LDIM */$!dimLayer/UD-STEEL

