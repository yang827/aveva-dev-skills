--
-- File: MdsAbaDimStl.pmlobj
--   Type: Object Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: Draft MDS using ABA for Drawing production
--   Replaces:
--
-- Author: Steve Robinson
-- Created: 25 June 2002
--
--
-- Description:
-- ------------
-- This object generates dimensions for MDS ABA support steelwork.
-- The object has methods to collect and classify design data and
-- to generate the dimensions.
--
-- The dimensions are created and positioned around the view frame.
-- There are upto 4 LDIMs created:
--
--   LR-PLATE & UD-PLATE - are the dimensions to base plates or stiffeners
--   these dimensions are located to the right and upper sides of the view frame.
--   This dimension is generated for all subs boxes with the subs purpose set to
--   'S' for stiffener and 'B' for baseplate.
--
--   LR-SCTN * UD-SCTN - are dimensions to the frame SCTN members. These dims
--   are located to the left and lower sides of the view frame. The logic used
--   in the creation of these dimension points is described in the in-line
--   comments of the body of the .dimension() object.
--
-- Using this object:
-- ------------------
-- For each view to be annotated make an instance of this object and pass the
-- STRU and VIEW DBREFs as arguments to the constructor. Once the object is
-- created all of the initialisation should be complete and the view can be
-- dimensioned. To generate the dimensions use the .dimension() method.
--
-- Before calling the .dimension() method make sure the STEEL_Dims layer
-- exists and had the relevant UCODE, PCODE and other text defaults set. This
-- allows you to control the appearance of the annotation before is it generated.
-- Note: If the dim layer does not exist then the method will create it and
-- and atts cascaded from view level will take effect.
--
-- After the object is initialised it's worth checking the .constOK member
-- if this is set to FALSE then something went wrong during initialisation and
-- the dimensioning method will probably not work. An example of a bad constructor
-- result is if there are NO SCTNS in the STRU - in which case NO dimensions would be
-- be created anyway.
--
-- IMPERIAL UNITS:
-- ---------------
-- The code should work in both metric and imperial units...
--
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  mdsabadimstl(DBREF,DBREF)        -
--
--------------------------------------------
--
--
--
--------------------------------------------------------------------------------
-- Define Object
define object MDSABADIMSTL

  member .stru     is DBREF        $* Support structure
  member .view     is DBREF        $* VIEW where dimensions are to be created
  member .constOK  is BOOLEAN      $* TRUE if object constructor executed with
--                                  no errors
  member .sctns    is ARRAY        $* Array of all support sctns (DBREFs)
  member .sctnData is ARRAY        $* Array of sctn data (MDSABASCTNDATA)
  member .oppDir   is DIRECTION    $* Main operational direction of support
  member .datumPos is POSITION     $* Position of support origin

--------------------------------------------------------------------------------
endobject

----------------------------------------------------------
-- Constructor to get design data and populate this object
----------------------------------------------------------
-- Arguments:
-- stru = DBREF of support stru to be dimensioned
-- view = DBREF of view where stru will be dimensioned
----------------------------------------------------------

define method .mdsabadimstl(!stru is DBREF, !view is DBREF)

  !saveRef = !!ce

  !this.constOK = TRUE

-- check we have been passed a valid stru
  if (!stru.type.neq('STRU')) then
    !this.constOK = FALSE
    return
  endif

  !this.stru = !stru
  !this.view = !view

-- get datum position
  $!stru
  set
--*/DATUM
    handle any
    elsehandle none
      !this.datumPos = !!ce.:mdsadploc.wrt(world)
        handle any $* UDA may not set
--<kp>jan07
          if !stru.:mdssupptype.eq(!!mdslsuppdefs.type) then
          -- lighting support
             !lsuppobj = object MDSLSUPPORT(!stru)
             !this.datumPos = !lsuppobj.origin.wrt(worl)
          else
             !this.datumPos = !!ce.:mdsadploc
          endif
--<kp>jan07
        endhandle
    endhandle

-- get all sctns for this stru
  var !sctns coll all sctn for $!this.stru
  if (!sctns.size().eq(0)) then
    !this.constOK = FALSE
    return
  endif

-- Get the dbref for all sctns
  !dbrefs = ARRAY()
  do !sctn values !sctns
    !dbrefs.append(!sctn.dbref() )
  enddo
  !this.sctns = !dbrefs

-- Process all sctns and create sctn data objects for each
  do !sctn values !this.sctns
-- Add the sctn data object to the array
    !this.sctnData.append(object MDSABASCTNDATA(!sctn,!this.view))
  enddo

  $!saveRef

endmethod

  ------------------------------------------------------
  -- Method to generate dimensions for support steelwork
  ------------------------------------------------------
  define method .dimension(!params is STRING)

    -- If the default constructor failed then return

    if !this.constOK.not() then
      return
    endif

