-- Define Object
  define object MDSABADRADATA

    member .template is DBREF
    member .htemplate is DBREF
    member .area is DBREF
    member .drawing is STRING
    member .sheet is STRING
    member .tviews is ARRAY
    member .views is ARRAY
    member .projection is STRING
    member .mainviewadeg is REAL
    member .planviewadeg is REAL
    member .mainscale is REAL

--<wd>feb2005
-- This member stores the "X" value of the DPOS attribute of the previously created "LDIM"
-- for a MDS HANGER in a MDS GROUP via the method !!mdsabadimhang.dimension()
    member .ldimdposx is REAL
--<wd>feb2005


--<wd>18dec2008 - Defect No. P-13975 -- NEW ADEG Value for the SIDE VIEW (DRTMPL default VIEW Direction is E or X wrt /*
    member .sideviewadeg is REAL

--------------------------------------------------------------------------------
  endobject
