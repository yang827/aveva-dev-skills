------------------------------------------------------------------------
--
-- File:            MdsAbaMtoComp.pmlobj
--   Type:          Object Definition
--   Group:         <group>
--     Keyword:     <keyword>
--   Module:        Draft
--   Replaces:
--
-- Author:          Martin Wright
-- Created:         28 May 2002
--
--
-- Description:
-- This object contains the definition for a Graphical report view
-- The constructor argument is a dbref to a IDLI containing area limits.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  loaddata(ARRAY,MDSABASUPPORT)    -                   Loads data to be used through the procedure from
--  mdsabamtocomp(DBREF)             -
--  mdsabamtocomp(DBREF,DBREF)       -                   Sets basic attributes area startpos and endpos
--  positions(DBREF)                 -                   extracts area positions from IDLI data
--  setLastLine(STRING)              -                   sets position of the end of the table
--
------------------------------------------------------------------------
------------------------------------------------------------------------

define object MDSABAMTOCOMP

  -- Used
  member .elements    is ARRAY
  member .quantity    is ARRAY
  member .types       is ARRAY
  member .dbrefs      is ARRAY
  member .descriptions is ARRAY
  member .supname     is STRING
  member .suptype     is STRING
  member .view        is DBREF
  member .startpos    is POSITION
  member .endpos      is POSITION
  member .sctntag      is REAL
  member .sjoitag      is REAL
  member .boxtag       is REAL
  member .taskparams   is ARRAY
  member .endOfTable   is REAL
  member .attas        is ARRAY

endobject

------------------------------------------------------------------------
--
-- Method:      .mdsabamtocomp
--
-- Description: Sets basic attributes area startpos and endpos
--
-- Method Type: constructor method
--
------------------------------------------------------------------------
define method .mdsabamtocomp(!dummyArea is DBREF,!view is DBREF)
  !this.view = !view
  !this.supname = !supname
  !this.positions(!supname)
  !this.endOfTable = 0
endmethod

------------------------------------------------------------------------

--
-- Method:      .mdsabsmtocomp
--
-- Description: Sets basic attributes area startpos and endpos
--
-- Method Type: constructor method
--
------------------------------------------------------------------------
define method .mdsabamtocomp(!supname is DBREF)

  !this.sctntag = 0
  !this.sjoitag = 0
  !this.boxtag = 0
  !this.supname = !supname
  !this.positions(!supname)
  !this.endOfTable = 0

endmethod

------------------------------------------------------------------------
--
-- Method:      .setLastLine()
--
-- Description: sets position of the end of the table
--
-- Method Type: public method
--

------------------------------------------------------------------------
define method .setLastLine(!position is STRING)

  !this.endOfTable = !position.split()[1] & ',' & !position.split()[2]

endmethod

--
-- Method:      .positions()
--
-- Description: extracts area positions from IDLI data
--
-- Method Type: public method
--

------------------------------------------------------------------------
define method .positions(!area is DBREF)

  !pos = !area.idln.limits
  !this.startpos.east  = !pos[1]
  !this.startpos.north = !pos[2]
  !this.startpos.up    = !pos[3]
  !this.endpos.east    = !pos[4]
  !this.endpos.north   = !pos[5]
  !this.endpos.up      = !pos[6]

endmethod

--
-- Method:      .loaddata()
--
-- Description: Loads data to be used through the procedure from
--              the given support name.
--
-- Method Type: public method
--
------------------------------------------------------------------------
define method .loaddata(!params is ARRAY,!mdsobject is MDSABASUPPORT)

  -- Remember where we came in.
  !view = !!ce

  -- Initialise Variable
  !element  = !mdsobject.support

  -- Collect all elements for the current support.
  sw
  !support = !this.supname
  !unusedTest = CREF OF $!support
  handle (2,201)
    --Setting for "MDS GROUP MASTER MDS FRAMEWORK STRUCTURE" and an "INDIVIDUAL MDS FRAMEWORK STRUCTURE"
    !this.suptype = 'SUPP'
  elsehandle NONE
    -- All MDS ANCILLARY and MDS HANGER supports FINISH UP in this CODE even if the CREF of the ATTA is UNSET
    -- MDS Ancillary
    --  Check the Support Type of the passed "!element"
    !typeofsupport = !!mdsabatype(!element)
    if (!typeofsupport.eq('ANCILL')) then
      !this.suptype = 'ATTA'
    else
      !this.suptype = 'HANG'
    endif
  endhandle

  --Get ALL the ATTA components belonging to the MDS GROUP Support Members or the MDS Support
  --Add all the support components to a list
  !tempelements = ARRAY()

  $!this.supname/DATUM
  handle none
    !tempelements.append(!!ce.ref.string())
  elsehandle any
  endhandle

  -- Loop Through and ADD ALL the ATTA components, excluding the SREF ATTA, on the MDS FRAMEWORK STRUCTURE
  -- i.e. !this.suptype.eq('SUPP')
  do !compCount from 1 to 100
    $!this.supname$n.$!compCount
    handle NONE
      -- SKIP if element is NOT an ATTA and NOT a 'MDS' ATTA
      skip if ((!!ce.type.neq('ATTA')) AND (!!ce.type.neq('CTSUPP')))
      skip if (!!ce.spref.name.match('/MDS').neq(1))
      !tempelements.append(!!ce.ref.string())
    elsehandle any
    endhandle
  enddo

  -- Add the MDS HANGER ATTA or the MDS ANCILLARY ATTA for an INDIVIDUAL MDS SUPPORT
  if ((!this.suptype.eq('HANG')) or (!this.suptype.eq('ATTA'))) then
    $!this.supname
    handle none
      !tempelements.append(!!ce.ref.string())
    elsehandle any
    endhandle
  endif

  -- For MDS GROUP Supports -- Add ALL the ATTA DBREFS as STRINGS in the MDS GROUP
  do !indx indices !mdsobject.mdsdata.maingroupmem
    -- SKIP the Master MDS STRUCTURE for the MDS GROUP
    skip if (!mdsobject.mdsdata.maingroupmem[!indx].type.eq('STRU'))
    !tempelements.append(!mdsobject.mdsdata.maingroupmem[!indx].string())
  enddo

  sw
  -- Remove ANY DUPLICATE ATTA entries from the !tempelements ARRAY and RE-INDEX
  !tempelements.unique()
  !this.taskparams = !params
  !!mdsabamtocomp.params = !params
  !this.elements[1] = ARRAY()
  !this.elements[2] = ARRAY()
  !this.elements[3] = ARRAY()
  !this.elements[1].append(!this.taskparams[2].split(',')[1])
  !this.elements[2].append(!this.taskparams[2].split(',')[2])
  !this.elements[3].append(!this.taskparams[2].split(',')[3])

  -- Now make the final elements array ready for use with the table creation
  do !subs index !tempelements
    -- Go off and create the final array with all different lists.

    -- Capture Name of supported element.
    var !name NAME OF OWNER OF OWNER of $!tempelements[$!subs]

    --Check if there's an error getting the description
    !descError = FALSE
    !fullDescription = !tempelements[$!subs].dbref().dtxr
    handle any
      !fullDescription = 'ERROR - Unable to get description of component '
      !descError = TRUE
      !!abaLogging.error('  ERROR - Unable to get description of component ' + !tempelements[$!subs].dbref().name)
    endhandle
    -- KBR Development
    !!cpars = !params
    -- Make sure it doesn't fall over with the old task
    if (!params.size() lt 9) then
      -- switch everything on apart from the reference flag
      !params[9]  = 'On'
      !params[10] = 'On'
      !params[11] = 'On'
      !params[12] = 'On'
      !params[13] = 'On'
      !params[14] = 'Off'
    endif
    if (!params[9].boolean()) then
      !tempString = !name.after('/')
    else
      !tempString = ''
    endif
    !pipingComp = TRUE
    if (!params[10].boolean()) then
      !revision = !tempelements[$!subs].dbref().owner.owner.rev
      handle any
        !pipingComp = FALSE
      endhandle
    endif
    !this.elements[1].append(!this.taskparams[8] & !subs)
    if (!params[10].boolean() AND !pipingComp) then
      !tempString = !tempString + ' (Rev = $!revision) '
    else
      !tempString = !tempString + ' '
    endif

    -- Skip this part if there was an error getting the description
    if (!descError.not()) then
      -- Keep the full description if all the descriptions are on
      if (!params[11].boolean() and !params[12].boolean() and !params[13].boolean()) then
        !description = !fullDescription
      else
        -- Split the description up into it's component parts
        -- Find the description by splitting on the property code
        !propCode = !tempelements[$!subs].dbref().prop.code
        handle ANY
          !propCode = ''
        endhandle
        !desc     = !fullDescription.split(!propCode)
        handle ANY
          !desc[1] = ''
        endhandle
        !matCode  = !tempelements[$!subs].dbref().prop.matr
        handle ANY
          !matCode = ''
        endhandle
        if (!params[11].boolean()) then
          !tempDesc = !desc[1]
        else
          !tempDesc = ' '
        endif
        if (!params[12].boolean()) then
          !tempDesc =  !tempDesc + ' ' + !propCode
        else
          !tempDesc = !tempDesc + ' '
        endif
        if (!params[13].boolean()) then
          !description = !tempDesc + ' ' + !matCode
        else
          !description = !tempDesc + ' '
        endif
      endif
      -- Add reference flag if the flag is on and the shop flag is true
      if (!params[14].boolean()) then
        !shop = !tempelements[$!subs].dbref().shop
        if (!shop) then
          !unusedReplacementText = !params[15]
          handle NONE
            !description = !description + ' ($!params[15])'
          elsehandle ANY
            !description = !description + ' (For Reference Only)'
          endhandle
        endif
      endif
    else
      !description = ||
    endif

    !this.elements[2].append(!tempString + ' ' + !description)
    !this.elements[3].append('1')
    -- KBR Development
  enddo

  !this.attas.clear()
  -- Add one extra element at beginning of array.
  !this.attas[1] = ' '
  !this.attas.appendarray(!tempelements)

  -- Return  to where we came in.
  !!ce = !view

endmethod
