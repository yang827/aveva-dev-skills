-- Created:         10 June 2002
--
--
-- Description:
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getTotals(ARRAY,STRING,BOOLEAN)  -
--  gethangtotals(ARRAY,STRING,BOOLEAN) -
--  loaddata(ARRAY)                  -                   Loads data to be used through the procedure from
--  loadgroupdata(ARRAY,MDSABASUPPORT) -                   Load MDS GROUP data into the member "!!mdsabamtosteel.data"
--  mdsabamtosteel(DBREF)            -
--  mdsabamtosteel(DBREF,DBREF)      -                   Sets basic attributes area startpos and endpos
--  positions(DBREF)                 -                   extracts area positions from IDLI data
--  setLastLine(STRING)              -                   sets position of the end of the table
--
------------------------------------------------------------------------
------------------------------------------------------------------------

define object MDSABAMTOSTEEL

-- Used
  member .elements     is ARRAY
  member .quantity     is ARRAY
  member .types        is ARRAY
  member .dbrefs       is ARRAY
  member .descriptions is ARRAY
  member .supname      is STRING
  member .suptype      is STRING
  member .view         is DBREF
  member .startpos     is POSITION
  member .endpos       is POSITION
  member .sctntag      is REAL
  member .sjoitag      is REAL
  member .boxtag       is REAL
  member .hangtag      is REAL
  member .taskparams   is ARRAY
  member .endOfTable   is REAL

--<wd>jan2005
-- Added the Object array members for MDS FRAMEWORK and MDS HANGER View Tags
  member .struviewtags     is ARRAY
  member .hangviewtags     is ARRAY
--<wd>jan2005

--<wd>jan2005
-- Added the MDS STRUCTURE Object array members for MDS GROUPS
  member .struelements     is ARRAY
  member .strudbrefs       is ARRAY
  member .strutypes        is ARRAY
  member .strudescriptions is ARRAY
  member .struquantity     is ARRAY

-- Added the MDS HANGER Object array members for MDS GROUPS
  member .hangelements     is ARRAY
  member .hangdbrefs       is ARRAY
  member .hangtypes        is ARRAY
  member .hangdescriptions is ARRAY
  member .hangquantity     is ARRAY
--<wd>jan2005

endobject

------------------------------------------------------------------------
--
-- Method:      .mdsabamtosteel
--
-- Description: Sets basic attributes area startpos and endpos
--
-- Method Type: constructor method
--
------------------------------------------------------------------------
define method .mdsabamtosteel(!supname is DBREF,!view is DBREF)
---------------------------------------------------------------------------------
  !this.view = !view
  !this.supname = !supname
  !this.positions(!this.supname)
  !this.endOfTable = 0

-----------------------------------------------------------------------
endmethod
------------------------------------------------------------------------

--
-- Method:      .mdsabsmtoSteel
--
-- Description: Sets basic attributes area startpos and endpos
--
-- Method Type: constructor method
--
------------------------------------------------------------------------
define method .mdsabamtosteel(!view is DBREF)
------------------------------------------------------------------------
--<wd>jan2005 -- !view is the CURRENT VIEW e.g. /MDS-ABA-2-VIEWS(METRIC)-PS7278-FANP09-AREA/S1/V3
  !this.sctntag = 0
  !this.sjoitag = 0
  !this.boxtag  = 0
  !this.hangtag = 0
  !this.supname = !view.string()
  !this.positions(!view)
  !this.endOfTable = 0

------------------------------------------------------------------------
endmethod
------------------------------------------------------------------------
--
-- Method:      .setLastLine()
--
-- Description: sets position of the end of the table
--
-- Method Type: public method
--

------------------------------------------------------------------------
define method .setLastLine(!position is STRING)
------------------------------------------------------------------------

    !this.endOfTable = !position.split()[1] & ',' & !position.split()[2]

endmethod
------------------------------------------------------------------------
--
-- Method:      .positions()
--
-- Description: extracts area positions from IDLI data
--
-- Method Type: public method
--

------------------------------------------------------------------------
define method .positions(!view is DBREF)
------------------------------------------------------------------------
--<wd>jan2005 -- !view is the CURRENT VIEW e.g. /MDS-ABA-2-VIEWS(METRIC)-PS7278-FANP09-AREA/S1/V3
  !pos = !view.idln.limits
  !this.startpos.east  = !pos[1]
  !this.startpos.north = !pos[2]
  !this.startpos.up    = !pos[3]
  !this.endpos.east    = !pos[4]
  !this.endpos.north   = !pos[5]
  !this.endpos.up      = !pos[6]

endmethod
------------------------------------------------------------------------

--
-- Method:      .loaddata()
--
-- Description: Loads data to be used through the procedure from
--              the given support name.
--
-- Method Type: public method
--
------------------------------------------------------------------------
define method .loaddata(!params is ARRAY)
------------------------------------------------------------------------

-- Remember where we came in.
   !view = !!ce

-- Collect all elements for the current support.
   !dbref = !this.supname
   !check = CREF OF $!dbref
-----------------------------
   handle (2,201) $* Element STRUCTURE <struname> does not have attribute CREF
-- MDS Framework Support.
       !this.suptype = 'SUPP'
       var !sctns COLL ALL (SCTN GENSEC) FOR $!dbref
       var !boxes COLL ALL BOX FOR $!dbref
-- This will coll all internal joints but we need to also coll all external joints
    var !jois eval ref of jois for all from !sctns
    var !joie eval ref of joie for all from !sctns
    !allJoints = ARRAY()
    !allJoints.appendArray(!jois)
    !allJoints.appendArray(!joie)
    do !removeUnsets indices !allJoints
      if !allJoints[$!removeUnsets].eq('unset') then
        !allJoints[$!removeUnsets].delete()
        --<wd>jun2005
        -- EXCLUDE all PJOI where the FUNCTION of the CREF(i.e. the owning SCTN) is set to "Q3*" for FANP "Q" type SCTNS
      elseif ((!allJoints[!removeUnsets].dbref().function neq 'DUMMY') and (!allJoints[!removeUnsets].dbref().type eq 'PJOI' and ((matchwild(!allJoints[!removeUnsets].dbref().cref.function, 'Q3*'))))) then

        !allJoints[!removeUnsets].delete()
        --<wd>jun2005

      endif
    enddo
    !allJoints.compress()
    !joints = ARRAY()
    do !externalJoints values !allJoints
      !testStru = stru of $!externalJoints
      -->>>-<wd>sep2003
      --if !testStru.neq(!dbref.dbref()) then
      if ((!testStru.neq(!dbref.dbref())) or (!testStru.eq(!dbref.dbref()) and !externalJoints.dbref().type.eq('PJOI') and !testStru.:mdssupptype.eq('SPECIAL'))) then
        --<<<-<wd>sep2003
        !joints.append(!externalJoints)
      endif
    enddo

    --<wd>jun2005
    -- Collect All Valid SJOI, PJOI and FITT members
    --var !sjois COLL ALL SJOI WITH FUNC NEQ 'DUMMY' FOR $!dbref
    -- EXCLUDE all SJOI with a SPREF matchwild '*Insert*' for FANP "Q" type SCTNS
    var !sjois coll all sjoi with ((func neq 'DUMMY') and (not matchwild(name of spref of sjoi,'*Insert*'))) for $!dbref
    -- EXCLUDE all PJOI where the FUNCTION of the CREF(i.e. the owning SCTN) is set to "Q3*" for FANP "Q" type SCTNS
    --var !sjois append COLL ALL PJOI WITH FUNC NEQ 'DUMMY' FOR $!dbref
    -->>>-<wd>sep2003
    -- var !sjois append COLL ALL PJOI where (:mdssupptype of stru eq 'SPECIAL') FOR $!dbref
    ---<<<<wd>sep2003
    var !sjois append coll all pjoi with ((func neq 'DUMMY') and (type eq 'PJOI' and (not (matchwild(func of cref, 'Q3*'))))) for $!dbref
--<wd>jun2005

       var !fitts COLL ALL FITT WITH FUNC NEQ 'DUMMY' and SPREF NEQ /MDS/LUG-HANG FOR $!dbref

    --<kp>may2011
    -- panels (all soft types) added
    var !panels collect all PANE for $!dbref

-- dtf >>> 7.08.06 before populating the members check to see if elements have badref of catref
    !checkedSctns  = !!mdscheckbadref(!sctns)
    !checkedSjois  = !!mdscheckbadref(!sjois)
    !checkedJoints = !!mdscheckbadref(!joints)
    !checkedFitts  = !!mdscheckbadref(!fitts)

    !this.dbrefs.appendArray(!boxes)
    --!this.dbrefs.appendArray(!sctns)
    --!this.dbrefs.appendArray(!sjois)
    --!this.dbrefs.appendArray(!joints)
    --!this.dbrefs.appendArray(!fitts)
    !this.dbrefs.appendArray(!checkedSctns)
    !this.dbrefs.appendArray(!checkedSjois)
    !this.dbrefs.appendArray(!checkedJoints)
    !this.dbrefs.appendArray(!checkedFitts)
    !this.dbrefs.appendArray(!panels)
-- dtf <<< 7.08.06 end of mod

-- q var !this.dbrefs

-----------------------------
   elsehandle NONE

--<wd>feb2005
-- All MDS ANCILLARY and MDS HANGER supports FINISH UP in this CODE even if the CREF of the ATTA is UNSET
     !element    = !dbref.dbref()
     !nameofatta = !element.name
-- MDS Ancillary
--  Check the Support Type of the passed "!element"
     !typeofsupport = !!mdsabatype(!element)
     if (!typeofsupport.eq('ANCILL')) then
       !this.suptype = 'ATTA'
       !ancills = ARRAY()
       !ancills.append('$!nameofatta' )
       do !indx from 1 to 100
         $!nameofatta$n.$n$!indx
         handle NONE
           !ancills.append('$!nameofatta$n.$n$!indx' )
         elsehandle ANY
           skip
         endhandle
       enddo
       !ancills.compress()
      !this.dbrefs.appendArray(!ancills)

     elseif (!typeofsupport.eq('HANGER')) then
--<wd>feb2005

-- MDS Hanger
       !this.suptype = 'HANG'
       !owner = OWNER OF $!check
       var !hangs COLL ALL HANG MEM FOR $!owner
-- Loop through hangers and remove tubi elements
      do !remove from 1 to !hangs.size()
        if !hangs[$!remove].dbref().type.eq('TUBI') then
-------------------------------------------------
--<wd>jan2005
-- When using MDS with a HANGER MANUFACTURERS DESIGN INTERFACE,IMPLIED RODS may exist so
-- SKIP the implied'TUBI'<'ROD'> elements and DO NOT DELETE them from the !hangs ARRAY()
           skip if !check.href.spref.name.match('MH').gt(0)
--<wd>jan2005
-------------------------------------------------
          !hangs[$!remove].delete()

--<wd>sep2002
        elseif !hangs[$!remove].dbref().type.eq('HELE') then
          if (!hangs[$!remove].dbref().detref.name.eq('/SDTE-PIPE-BORE-ADAPTER')) then
            !hangs[$!remove].delete()
           endif
--<wd>sep2002

         endif
       enddo
       !hangs.compress()
      !this.dbrefs.appendArray(!hangs)

--<wd>jan2005
-- ADD any EXTRA Components which may be required in the MDS ABA MTO for the MDS LISEGA HANGER Interface
-- The MDS LICAD HANGER interface sets the array UDA :USTNUTREF with an array of the SPREFS of the
-- HEXAGON NUTS required at SOME LISEGA HANGER DESIGN DATABASE components
-- **********
-- ** NOTE **
-- **********
-- MDS-LISEGA Interface ONLY.
-- These EXTRA Components will NOT be TAGGED in the MDS ABA DRAWING VIEWS but they will APPEAR in the MTO list
       if (!!mdshangif.upcase().eq('LISEGA')) then
         !hexnuts = ARRAY()
         do !hele values !this.dbrefs
           skip if !hele.dbref().type.eq('TUBI')
           if ( !hele.dbref().:ustnutref.set() ) then
            -- Append as STRINGS the SPREFS stored in the UDA :USTNUTREF to the !hexnuts array
             !nutarray = !hele.dbref().:ustnutref
               handle ANY
                 skip
               endhandle
             do !hnuts values !nutarray
               !xnutref = ref of $!hnuts
               !hnutref = !xnutref.string()
               !hexnuts.append(!hnutref)
             enddo
           endif
         enddo
-- Append the !hexnuts array to the !this.dbrefs array
        !this.dbrefs.appendArray(!hexnuts)
       endif
--<wd>jan2005

--<wd>feb2005
     endif
--<wd>feb2005
   endhandle
-----------------------------

-- Common Code for MDS FRAMEWORKS and MDS HANGERS
-- Set types for all from the elements array
   !elements = !this.dbrefs

--<wd>feb2005
   if (!this.suptype.eq('ATTA')) then
-- All MDS Ancillary Support MEMBERS are "ATTA" types
     !types = ARRAY()
     do !andx indices !elements
       !types[!andx] = 'ATTA'
     enddo
     !this.types = !types
   else
--<wd>feb2005

     var !types EVAL TYPE FOR ALL FROM !elements
     !this.types = !types

--<wd>feb2005
   endif
--<wd>feb2005

-- Now get set all the descriptions for the data.
    do !desc index !this.dbrefs
      if (!this.types[!desc] eq 'SCTN') or (!this.types[!desc] eq 'GENSEC') then
--<wd>mar2003
-- Append the Description of the SCTN Matref
        !matl = !this.dbrefs[!desc].dbref().matref.description
        handle any
          !matl = ''
        elsehandle NONE
          if !matl.eq('') then
            !matl = !this.dbrefs[!desc].dbref().matref.:mdsmatdesc
            if !matl.neq('') then
              !matl = ' (' & !matl & ')'
            endif
          else
            !matl = ' (' & !matl & ')'
          endif
        endhandle
--<wd>mar2003
-- Get description from the MDS attribute :mdssizetag
-- from the SPRF of the CATREF of the SPREF
--<wd>mar2003
        --!temp = :MdsSizeTag OF CATREF OF SPREF OF $!this.dbrefs[$!desc]
        !temp = :MdsSizeTag OF CATREF OF SPREF OF $!this.dbrefs[$!desc] & !matl
--<wd>mar2003
        if !temp.match('unset').eq(1) then
          !temp = NAMN OF CATREF OF SPREF OF $!this.dbrefs[$!desc] & !matl
        endif
        !this.descriptions.append(!temp)
      --<RM> changed the !cutl variable from pml2 to pml1 as the pml2 version is producing values to 10 decimal places - start
      --!cutl = TCTL OF $!this.dbrefs[$!desc]
      var !cutl TCTL OF $!this.dbrefs[$!desc]
      !this.quantity.append(!cutl.real())
      --<RM> changed the !cutl variable from pml2 to pml1 as the pml2 version is producing values to 10 decimal places - end
-->>>-<wd>sep2003
      --elseif (!this.types[!desc] eq 'SJOI' or !this.types[!desc] eq 'FITT') then
      elseif (!this.types[!desc] eq 'PJOI' or !this.types[!desc] eq 'SJOI' or !this.types[!desc] eq 'FITT') then
--<<<-<wd>sep2003

-- get the material description if set

        !matl = !this.dbrefs[!desc].dbref().matref.description
        handle any
          !matl = ''
        elsehandle none
          !matl = ' (' & !matl & ')'
        endhandle

--<wd>05aug2004
-- Get description from the MDS attribute $!params[12] "DTXS" or "DTXR" of DBREF for PJOI, SJOI, FITT
      -- Previously this LINE of CODE was HARD CODED to "DTXR" --see below
        --!temp = dtxr OF $!this.dbrefs[$!desc] & !matl
--<wd>05aug2004
        !temp = $!params[12] OF $!this.dbrefs[$!desc] & !matl
        handle ANY
          !temp = 'Invalid specification ref found'
        elsehandle NONE
          if (!temp.trim()eq('')) then
            !temp = !this.dbrefs[!desc].dbref().type & ' ' & !this.dbrefs[!desc].dbref().name & ' ** $!params[12] attribute is NOT set.'
          endif
        endhandle

        !this.descriptions.append(!temp)
        !this.quantity.append('1')

      elseif (!this.types[!desc] eq 'BOX') then
        -- have to go to BOX to get text string
        $!this.dbrefs[$!desc]

-->>-<wd>jan2003
-- Set the Steel Length(!sctnquan) to the Correct PDMS Distance Units
      -- stored in the form member !!mdsabamtosteel.units

      !distIndex = !!mdsabamtosteel.units.getDimensionIndex('DIST')

      if (!!mdsabamtosteel.units.savedunits[!distIndex].neq('mm')) then
        -- Temporarily Set Distance Units Back to the Required Output units
        $!!mdsabamtosteel.units.savedunits[$!distIndex] distance
        -- Output Plate sizes in INCHES a NOT Feet and INCHES
        !xlen = !!ce.xlen.distance(false,true,true,16,false)
        !ylen = !!ce.ylen.distance(false,true,true,16,false)
        !zlen = !!ce.zlen.distance(false,true,true,16,false)
      else
        !xlen = xlen
        !ylen = ylen
        !zlen = zlen
      endif
      -- If the :mdsmatref is set use the description
      if !!ce.:mdsmatref.set() then
        !materialDesc = !!ce.:mdsmatref.desc
        if !materialDesc.eq('') then
          !materialDesc = !!ce.:mdsmatref.:mdsmatdesc
        endif
      else
        !materialDesc = ''
        endif
-- Set Distance Units Back to Metric in all cases
        MM Distance
--<<-<wd>jan2003
      !sizes = ARRAY()
      !sizes.append(!xlen)
      !sizes.append(!ylen)
      !sizes.append(!zlen)
      !sizes.sort()
      !temp = 'Plate ($!sizes[3] x $!sizes[2] x $!sizes[1] thk.) ' + !materialDesc
      !this.descriptions.append(!temp)
      !this.quantity.append(1)

      --<kp>may2011
      -- PANEls added
    elseif !this.types[!desc].eq('PANE') then
      !pane = !this.dbrefs[!desc].dbref()
      !size = !pane.psize.sort()
      !thk = !pane.lohe
      !materialDesc = ''
      if !pane.matref.badref().not() then
        !materialDesc = !pane.matref.desc
        if !materialDesc.empty() then
          !materialDesc = !pane.matref.:mdsmatdesc
        endif
      endif
      !temp = 'Plate ($!size[2] x $!size[1] x $!thk thk.) ' + !materialDesc
      !this.descriptions.append(!temp)
      !this.quantity.append(1)

    else
      --"INDIVIDUAL" MDS HANGERS - Determine the description for each MDS HANGER component
----------------------------------------------------------------------
        skip if (!this.types[!desc] eq 'TEXT')
--<tm
        !test = !params[12]
        handle NONE
        -- if !!mdsabamtosteel.detailtext eq 'STEXT' then
        -- if !params[12].eq('DTXS') then
            -- !temp = STEXT OF DETREF OF SPREF OF $!this.dbrefs[$!desc]

        !temp = $!params[12] OF $!this.dbrefs[$!desc]
          handle (2,201) (2,114)
          !temp = 'Unable to evaluate $!params[12] for $!this.dbrefs[$!desc]'
--<wd>feb2005
          elsehandle NONE
-- Check for any "IMPLIED ROD" elements used on MDS HANGERS created via a MDS to HANGER MANUFACTURER Interface
            if (!this.types[!desc].eq('TUBI')) then
-- Append the ITLE - "Implied Tube<ROD> Length" to the DESCRIPTION
              !rodlength = ' (' & !this.dbrefs[!desc].dbref().itlength.string() & 'mm)'
              !temp      = !temp & !rodlength
            endif
--<wd>feb2005
          endhandle

          --else
            --!temp = RTEXT OF DETREF OF SPREF OF $!this.dbrefs[$!desc]
              --handle (2,201) (2,114)
               --!temp = 'Unset'
              --endhandle
          --endif

        elsehandle ANY
          !temp = RTEXT OF DETREF OF SPREF OF $!this.dbrefs[$!desc]
          handle (2,201) (2,114)
            !temp = 'Unable to evaluate rtext for $!this.dbrefs[$!desc]'
          endhandle
        endhandle

--<tm fix to use rtex or stext
        !temp2 = |$!temp|
        !this.descriptions.append(!temp2)
        !this.quantity.append(1)
      endif
    enddo


-- Now find how many unique fields there are.
   !index = !this.descriptions.sortedindices()
  !this.types.reindex(!index)
   !this.dbrefs.reindex(!index)
   !this.descriptions.reindex(!index)
   !this.quantity.reindex(!index)
  !tempelements = ARRAY()

   do !make index !this.descriptions
-- get of all the interested bits, ready for use.
     !it = !this.types[!make] & '|' & !this.dbrefs[!make] & '|' & !this.descriptions[!make] & '|' & !this.quantity[!make]
     !tempelements.append(!it)
   enddo

   !this.taskparams = !params

-- Now make the final elements array ready for use with the table creation
-- Go off and create the final array with all different lists.
  !this.elements[1] = ARRAY()
  !this.elements[2] = ARRAY()
  !this.elements[3] = ARRAY()
  !this.elements[4] = ARRAY()
   !this.elements[1].append(!this.taskparams[2].split(|,|)[1])
   !this.elements[2].append('NA')
   !this.elements[3].append(!this.taskparams[2].split(|,|)[2])
   !this.elements[4].append(!this.taskparams[2].split(|,|)[3])

--<wd>jan2005
-- Initialise the BOOLEAN Variable for MDS Framework and MDS Hangers in the MDS GROUP
   !mdsgroup = FALSE
--<wd>jan2005

   if !this.suptype.eq('HANG') then
     !this.gethangtotals(!tempelements,!tempelements[1].split('|')[1], !mdsgroup)
   else
     !this.getTotals(!tempelements,!tempelements[1].split('|')[1], !mdsgroup)
     handle any
-- No steelwork
     endhandle
   endif

-- Return to where we came in.
   !!ce = !view

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--<wd>jan2005
define method .getTotals(!list is ARRAY, !type is STRING, !mdsgroup is BOOLEAN)
------------------------------------------------------------------------
-- !list is a list of all elements
  -- !this.elements[1] = ARRAY()
  -- !this.elements[2] = ARRAY()
  -- !this.elements[3] = ARRAY()
  -- !this.elements[4] = ARRAY()
  -- !this.elements[1].append(!this.taskparams[2].split(|,|)[1])
  -- !this.elements[2].append('NA')
  -- !this.elements[3].append(!this.taskparams[2].split(|,|)[2])
  -- !this.elements[4].append(!this.taskparams[2].split(|,|)[3])

  -- !list is an array of arrays of beams
  -- this seems to be a mess and needs lo0king at
  do !entry value !list

    if (defined(!sctnquan)) then
      !sctnquan.delete()
    endif

    !sctnref  = !entry.split('|')[2]
    if (!sctnref.dbref().type.eq('SCTN')) or (!sctnref.dbref().type.eq('GENSEC')) then
      !this.sctntag = !this.sctntag + 1
       -- !sctnid       = !this.taskparams[8] & !this.sctntag
-- Allow for spool identifiers
      if !this.taskparams[13].boolean() then
        !spoolNum = !sctnref.dbref().:MDSSpool
        !sctnid       = !this.taskparams[8] & !this.sctntag + '($!spoolNum)'
      else
         !sctnid       = !this.taskparams[8] & !this.sctntag
      endif
-->>>-<wd>sep2003
    --elseif (!sctnref.dbref().type.eq('SJOI')) or (!sctnref.dbref().type.eq('FITT')) then
    elseif (!sctnref.dbref().type inset ('PJOI','SJOI','FITT')) then
--<<<-<wd>sep2003
      !this.sjoitag = !this.sjoitag + 1
      !sctnid       = !this.taskparams[10] & !this.sjoitag

    elseif !sctnref.dbref().type.eq('BOX').or(!sctnref.dbref().type.eq('PANE')) then
      !this.boxtag = !this.boxtag + 1
      !sctnid       = !this.taskparams[9] & !this.boxtag

    else
      !this.hangtag = !this.hangtag + 1
      !sctnid       = !this.taskparams[11] & !this.hangtag
    endif
    !sctntext = !entry.split('|')[3]
    !sctnquan = !entry.split('|')[4].real()

--<wd>jan2003
-- Set the Steel Length(!sctnquan) to the Correct PDMS Distance Units
    -- stored in the form member !!mdsabamtosteel.units
    !distIndex = !!mdsabamtosteel.units.getDimensionIndex('DIST')

    if (!!mdsabamtosteel.units.savedunits[!distIndex].neq('mm')) then
      --if (!!mdsabamtosteel.units[3].neq('MM')) then
      onerror golabel /units
-- Temporarily Set Distance Units Back to the Required Output units
      $!!mdsabamtosteel.units.savedunits[$!distIndex] distance
      --$!!mdsabamtosteel.units[3] distance
      if (!sctnquan.gt(1)) then
        !sctnquan = $!sctnquan
        !sctnlen  = !sctnquan.distance(true,false,true,8,true).replace(' ','')
        !sctnquan.delete()
        !sctnquan = !sctnlen
      endif
-- Set Distance Units Back to Metric
      label /units
      onerror return
      MM Distance
    endif
--<wd>jan2003

--<wd>jan2005
-- Check if the MDS FRAMEWORK belongs to a MDS GROUP
      if (!mdsgroup) then
-- MDS FRAMEWORK SUPPORT belongs to a MDS GROUP
        if (!this.struelements[2].findfirst(!sctnref).unset()) then
          !this.struelements[1].append(!sctnid)
          !this.struelements[2].append(!sctnref)
          !this.struelements[3].append(!sctntext)
          !this.struelements[4].append(!sctnquan)
        endif
      else
-- Original Code -- Individual MDS FRAMEWORK SUPPORT
        if (!this.elements[2].findfirst(!sctnref).unset()) then
          !this.elements[1].append(!sctnid)
          !this.elements[2].append(!sctnref)
          !this.elements[3].append(!sctntext)
          !this.elements[4].append(!sctnquan)
        endif
      endif
--<wd>jan2005

  enddo

--<wd>14may2004 - TEMPORARY
  !!fELEM = !this.elements

endmethod

------------------------------------------------------------------------
--<wd>jan2005
define method .gethangtotals(!list is ARRAY, !type is STRING, !mdsgroup is BOOLEAN)

------------------------------------------------------------------------

  -- !this.elements[1] = ARRAY()
  -- !this.elements[2] = ARRAY()
  -- !this.elements[3] = ARRAY()
  -- !this.elements[4] = ARRAY()
  -- !this.elements[1].append(!this.taskparams[2].split(|,|)[1])
  -- !this.elements[2].append('NA')
  -- !this.elements[3].append(!this.taskparams[2].split(|,|)[2])
  -- !this.elements[4].append(!this.taskparams[2].split(|,|)[3])

  --do !sublist values !list
  --  do !entry values !sublist
   do !entry values !list
      !sctnref  = !entry.split('|')[2]
      if (!type eq 'SCTN') or (!type eq 'GENSEC') then
--        !this.sctntag = !this.sctntag + 1
-- Allow for spool identifiers
      --        !spoolNum = !sctnref.dbref().:MDSSpool
      --        !sctnid       = !this.taskparams[8] & !this.sctntag + '($!spoolNum)'
--<wd>sep2003
--      --elseif (!type eq 'SJOI' or !type eq 'FITT') then
      elseif (!type eq 'PJOI' or !type eq 'SJOI' or !type eq 'FITT') then
----<wd>sep2003
--        !this.sjoitag = !this.sjoitag + 1
--        !sctnid       = !this.taskparams[10] & !this.sjoitag
      elseif (!type eq 'BOX') then
--        !this.boxtag = !this.boxtag + 1
--        !sctnid       = !this.taskparams[9] & !this.boxtag
--
      else
-- MDS Hanger
        !this.hangtag = !this.hangtag + 1
        !sctnid       = !this.taskparams[11] & !this.hangtag
      endif

      !sctntext = !entry.split('|')[3]
      !sctnquan = !entry.split('|')[4].real()

--<wd>jan2005
-- Check if the MDS HANGERS belong to a MDS GROUP
      if (!mdsgroup) then
-- MDS HANGER SUPPORTS belong to a MDS GROUP
        !this.hangelements[1].append(!sctnid)
        !this.hangelements[2].append(!sctnref)
        !this.hangelements[3].append(!sctntext)
        !this.hangelements[4].append(!sctnquan)
      else
-- Original Code -- Individual MDS HANGER SUPPORTS
        !this.elements[1].append(!sctnid)
        !this.elements[2].append(!sctnref)
        !this.elements[3].append(!sctntext)
        !this.elements[4].append(!sctnquan)
      endif
--<wd>jan2005

    enddo
 --enddo

--<wd>14may2004 - TEMPORARY VARIABLE for REF ONLY
  !!hELEM = !this.elements

endmethod
------------------------------------------------------------------------
--
--
------------------------------------------------------------------------
------------------------------------------------------------------------
--<wd>jan2005 -- START of New Method .loadgroupdata
------------------------------------------------------------------------
------------------------------------------------------------------------
--
-- Method:      .loadgroupdata()
--
-- Description: Load MDS GROUP data into the member "!!mdsabamtosteel.data"
--              the given MDS GROUP support name.
--
-- Method Type:
--
------------------------------------------------------------------------
define method .loadgroupdata(!params is ARRAY, !mdsobject is MDSABASUPPORT)
------------------------------------------------------------------------
-- Selected MDS Framework Support is the Master MDS STRU in a MDS GROUP
-- i.e. !mdsobject.support

-- Store the ORIGINAL component
   !view = !!ce

-- Collect all PDMS elements for the MAIN MDS GROUP support members in "!mdsobject.mdsdata.maingroupmem"
   !dbref        = !mdsobject.support
   !maingroupmem = !mdsobject.mdsdata.maingroupmem

   do !mainmem indices !maingroupmem

     if (!maingroupmem[!mainmem].type.eq('STRU')) then
-- *** MDS Structure Framework Support ***
       !this.suptype = 'SUPP'
       var !sctns COLL ALL (SCTN GENSEC) FOR $!dbref
      --<kp>may2011
      -- enable PANEls to be listed and tagged
      --var !boxes COLL ALL BOX FOR $!dbref
      var !boxes collect all (BOX PANE) for $!dbref
-- This will coll all internal joints but we need to also coll all external joints
      var !jois eval ref of jois for all from !sctns
      var !joie eval ref of joie for all from !sctns
      !allJoints = ARRAY()
      !allJoints.appendArray(!jois)
      !allJoints.appendArray(!joie)
      do !removeUnsets indices !allJoints
        if !allJoints[$!removeUnsets].eq('unset') then
          !allJoints[$!removeUnsets].delete()

          --<wd>jun2005
          -- EXCLUDE all PJOI where the FUNCTION of the CREF(i.e. the owning SCTN) is set to "Q3*" for FANP "Q" type SCTNS
        elseif ((!allJoints[!removeUnsets].dbref().function neq 'DUMMY') and (!allJoints[!removeUnsets].dbref().type eq 'PJOI' and ((matchwild(!allJoints[!removeUnsets].dbref().cref.function, 'Q3*'))))) then
          -- $P+++++ DELETE PJOI index from the ARRAY !allJoints +++++++
          -- q var !allJoints[!removeUnsets].dbref().fullname
-- $P--------------------
          !allJoints[!removeUnsets].delete()
--<wd>jun2005

         endif
       enddo
      !allJoints.compress()
      !joints = ARRAY()
      do !externalJoints values !allJoints
        !testStru = stru of $!externalJoints
--<wd>feb2005
        --         if ((!testStru.neq(!dbref.dbref())) or (!testStru.eq(!dbref.dbref()) and !externalJoints.dbref().type.eq('PJOI') and !testStru.:mdssupptype.eq('SPECIAL'))) then
        if ((!testStru.neq(!dbref)) or (!testStru.eq(!dbref) and !externalJoints.dbref().type.eq('PJOI') and !testStru.:mdssupptype.eq('SPECIAL'))) then
          --<wd>feb2005
          !joints.append(!externalJoints)
        endif
      enddo

      --<wd>jun2005
      -- Collect All Valid SJOI, PJOI and FITT members
      --var !sjois COLL ALL SJOI WITH FUNC NEQ 'DUMMY' FOR $!dbref
      -- EXCLUDE all SJOI with a SPREF matchwild '*Insert*' for FANP "Q" type SCTNS
      var !sjois coll all sjoi with ((func neq 'DUMMY') and (not matchwild(name of spref of sjoi,'*Insert*'))) for $!dbref
      -- EXCLUDE all PJOI where the FUNCTION of the CREF(i.e. the owning SCTN) is set to "Q3*" for FANP "Q" type SCTNS
      --var !sjois append COLL ALL PJOI WITH FUNC NEQ 'DUMMY' FOR $!dbref
      -->>>-<wd>sep2003
      -- var !sjois append COLL ALL PJOI where (:mdssupptype of stru eq 'SPECIAL') FOR $!dbref
      ---<<<<wd>sep2003
      var !sjois append coll all pjoi with ((func neq 'DUMMY') and (type eq 'PJOI' and (not (matchwild(func of cref, 'Q3*'))))) for $!dbref
      --<wd>jun2005

      var !fitts COLL ALL FITT WITH FUNC NEQ 'DUMMY' and SPREF NEQ /MDS/LUG-HANG FOR $!dbref
      !this.strudbrefs.appendArray(!sctns)
      !this.strudbrefs.appendArray(!boxes)
      !this.strudbrefs.appendArray(!sjois)
      !this.strudbrefs.appendArray(!joints)
      !this.strudbrefs.appendArray(!fitts)

-----------------------------
     elseif (!maingroupmem[!mainmem].type.eq('ATTA')) then
-- *** MDS Hanger Support ***
       --!this.suptype = 'HANG'
       !check = CREF of $!maingroupmem[$!mainmem]
       !owner = OWNER OF CREF of $!maingroupmem[$!mainmem]
       var !hangs COLL ALL HANG MEM FOR $!owner

-- Loop through hangers and remove TUBI elements
      do !remove from 1 to !hangs.size()
        if !hangs[$!remove].dbref().type.eq('TUBI') then
-------------------------------------------------
-- When using MDS with a HANGER MANUFACTURERS DESIGN INTERFACE,IMPLIED RODS may exist so
-- SKIP the implied'TUBI'<'ROD'> elements and DO NOT DELETE them from the !hangs ARRAY()
           skip if !check.href.spref.name.match('MH').gt(0)
-------------------------------------------------
          !hangs[$!remove].delete()

        elseif !hangs[$!remove].dbref().type.eq('HELE') then
          if (!hangs[$!remove].dbref().detref.name.eq('/SDTE-PIPE-BORE-ADAPTER')) then
            !hangs[$!remove].delete()
          endif

        endif
      enddo
      !hangs.compress()
      !this.hangdbrefs.appendArray(!hangs)

-- ADD any EXTRA Components which may be required in the MDS ABA MTO for the MDS LISEGA HANGER Interface
-- The MDS LICAD HANGER interface sets the array UDA :USTNUTREF with an array of the SPREFS of the
-- HEXAGON NUTS required at SOME LISEGA HANGER DESIGN DATABASE components
-- **********
-- ** NOTE **
-- **********
-- MDS-LISEGA Interface ONLY.
-- These EXTRA Components will NOT be TAGGED in the MDS ABA DRAWING VIEWS but they will APPEAR in the MTO list
       if (!!mdshangif.upcase().eq('LISEGA')) then
         !hexnuts = ARRAY()
         do !hele values !this.hangdbrefs
           skip if !hele.dbref().type.eq('TUBI')
           if ( !hele.dbref().:ustnutref.set() ) then
            -- Append as STRINGS the SPREFS stored in the UDA :USTNUTREF to the !hexnuts array
             !nutarray = !hele.dbref().:ustnutref
             handle ANY
               skip
             endhandle
             do !hnuts values !nutarray
               !xnutref = ref of $!hnuts
               !hnutref = !xnutref.string()
               !hexnuts.append(!hnutref)
             enddo
           endif
         enddo
-- Append the !hexnuts array to the !this.hangdbrefs array
        !this.hangdbrefs.appendArray(!hexnuts)
       endif

     endif
   enddo
-----------------------------

-- Unique ARRAY of both MDS STRUCTURAL and MDS HANGER DBREFS
   !this.strudbrefs.unique()
   !this.hangdbrefs.unique()

-- Code for MDS FRAMEWORKS in a MDS GROUP
-- Set types for all from the !struelements array
   !struelements = !this.strudbrefs
   var !stypes EVAL TYPE FOR ALL FROM !struelements
   !this.strutypes = !stypes

-------------------------------------------------
-- Get all the descriptions for the "MDS FRAMEWORK" data/components.
   do !desc index !this.strudbrefs
     if (!this.strutypes[!desc] eq 'SCTN') or (!this.strutypes[!desc] eq 'GENSEC') then
-- Append the Description of the SCTN Matref
       !matl = !this.strudbrefs[!desc].dbref().matref.description
       handle any
         !matl = ''
       elsehandle NONE
         if !matl.eq('') then
           !matl = !this.strudbrefs[!desc].dbref().matref.:mdsmatdesc
           if !matl.neq('') then
             !matl = ' (' & !matl & ')'
           endif
         else
           !matl = ' (' & !matl & ')'
         endif
       endhandle

-- Get description from the MDS attribute :mdssizetag from the SPRF of the CATREF of the SPREF
       !temp = :MdsSizeTag OF CATREF OF SPREF OF $!this.strudbrefs[$!desc] & !matl
       if !temp.match('unset').eq(1) then
         !temp = NAMN OF CATREF OF SPREF OF $!this.strudbrefs[$!desc] & !matl
       endif
       !this.strudescriptions.append(!temp)
      --<RM> changed the !cutl variable from pml2 to pml1 as the pml2 version is producing values to 10 decimal places - start
      --!cutl = TCTL OF  $!this.strudbrefs[$!desc]
      var !cutl TCTL OF  $!this.strudbrefs[$!desc]
      !this.struquantity.append(!cutl.real())
      --<RM> changed the !cutl variable from pml2 to pml1 as the pml2 version is producing values to 10 decimal places - end

     elseif (!this.strutypes[!desc] eq 'PJOI' or !this.strutypes[!desc] eq 'SJOI' or !this.strutypes[!desc] eq 'FITT') then

-- Get the material description if set
       !matl = !this.strudbrefs[!desc].dbref().matref.description
       handle any
         !matl = ''
       elsehandle none
         !matl = ' (' & !matl & ')'
       endhandle

-- Get description from the MDS attribute $!params[12] "DTXS" or "DTXR" of DBREF for PJOI, SJOI, FITT
      -- Previously this LINE of CODE was HARD CODED to "DTXR" --see below
       !temp = $!params[12] OF $!this.strudbrefs[$!desc] & !matl
       handle ANY
         !temp = 'Invalid specification ref found'
       elsehandle NONE
         if (!temp.trim()eq('')) then
           !temp = !this.strudbrefs[!desc].dbref().type & ' ' & !this.strudbrefs[!desc].dbref().name & ' ** $!params[12] attribute is NOT set.'
         endif
       endhandle

       !this.strudescriptions.append(!temp)
       !this.struquantity.append('1')

     elseif (!this.strutypes[!desc] eq 'BOX') then

-- Have to go to BOX to get text string
       $!this.strudbrefs[$!desc]

-- Set the Steel Length(!sctnquan) to the Correct PDMS Distance Units
      -- stored in the form member !!mdsabamtosteel.units
      !distIndex = !!mdsabamtosteel.units.getDimensionIndex('DIST')

      if (!!mdsabamtosteel.units.savedunits[!distIndex].neq('mm')) then

        --if (!!mdsabamtosteel.units[3].neq('MM')) then
        -- Temporarily Set Distance Units Back to the Required Output units
        $!!mdsabamtosteel.units.savedunits[$!distIndex] distance
        --$!!mdsabamtosteel.units[3] distance
        -- Output Plate sizes in INCHES a NOT Feet and INCHES
        !xlen = !!ce.xlen.distance(false,true,true,16,false)
        !ylen = !!ce.ylen.distance(false,true,true,16,false)
        !zlen = !!ce.zlen.distance(false,true,true,16,false)
      else
        !xlen = xlen
        !ylen = ylen
        !zlen = zlen
      endif
      -- If the :mdsmatref is set use the description
      if !!ce.:mdsmatref.set() then
        !materialDesc = !!ce.:mdsmatref.desc
        if !materialDesc.eq('') then
          !materialDesc = !!ce.:mdsmatref.:mdsmatdesc
        endif
      else
        !materialDesc = ''
      endif
      -- Set Distance Units Back to Metric in all cases
      MM Distance

      !sizes = ARRAY()
      !sizes.append(!xlen)
      !sizes.append(!ylen)
      !sizes.append(!zlen)
      !sizes.sort()
      !temp = 'Plate ($!sizes[3] x $!sizes[2] x $!sizes[1] thk.) ' + !materialDesc
       !this.strudescriptions.append(!temp)
       !this.struquantity.append(1)
    elseif !this.strutypes[!desc].eq('PANE') then
      !pane = !this.strudbrefs[!desc].dbref()
      !size = !pane.psize.sort()
      !thk = !pane.lohe
      !materialDesc = ''
      if !pane.matref.badref().not() then
        !materialDesc = !pane.matref.desc
        if !materialDesc.empty() then
          !materialDesc = !pane.matref.:mdsmatdesc
        endif
      endif
      !temp = 'Plate ($!size[2] x $!size[1] x $!thk thk.) ' + !materialDesc
      !this.strudescriptions.append(!temp)
      !this.struquantity.append(1)

     endif
   enddo

-- Code for MDS HANGERS in a MDS GROUP
-- Set types for all from the !hangelements array
   !hangelements = !this.hangdbrefs
   var !htypes EVAL TYPE FOR ALL FROM !hangelements
   !this.hangtypes = !htypes

-- Get all the descriptions for the "MDS HANGER" data/components.
   do !hdesc indices !this.hangdbrefs
     skip if (!this.hangtypes[!hdesc] eq 'TEXT')
     !test = !params[12]
     handle NONE
      !temp = $!params[12] OF $!this.hangdbrefs[$!hdesc]
       handle (2,201) (2,114)
        !temp = 'Unable to evaluate $!params[12] for $!this.hangdbrefs[$!hdesc]'

       elsehandle NONE
-- Check for any "IMPLIED ROD" elements used on MDS HANGERS created via a MDS to HANGER MANUFACTURER Interface
         if (!this.hangdbrefs[!hdesc].dbref().type.eq('TUBI')) then
-- Append the ITLE - "Implied Tube<ROD> Length" to the DESCRIPTION
           !rodlength = ' (' & !this.hangdbrefs[!hdesc].dbref().itlength.string() & 'mm)'
           !temp      = !temp & !rodlength
         endif

       endhandle

     elsehandle ANY
       !temp = RTEXT OF DETREF OF SPREF OF $!this.hangdbrefs[$!hdesc]
       handle (2,201) (2,114)
         !temp = 'Unable to evaluate rtext for $!this.hangdbrefs[$!hdesc]'
       endhandle
     endhandle

     !temp2 = |$!temp|
     !this.hangdescriptions.append(!temp2)
     !this.hangquantity.append(1)
   enddo
-------------------------------------------------
--$P*************** !this.strudbrefs BEFORE Re-indexing*************************
--q var !this.strudbrefs
--q var !this.strudescriptions
--$P
-- Determine the UNIQUE descriptions for the MDS FRAMEWORK in a MDS GROUP
--   !sindex = !this.strudescriptions.sortedindices()
--   !this.strutypes.reindex(!sindex)
--   !this.strudbrefs.reindex(!sindex)
--   !this.strudescriptions.reindex(!sindex)
--   !this.struquantity.reindex(!sindex)
  !strutempelem = ARRAY()
--$P*************** !this.strudbrefs AFTER Re-indexing***************************
--q var !this.strudbrefs
--q var !this.strudescriptions
--$P
--$P+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
   do !make index !this.strudescriptions
-- Get all of the interested bits, ready for use.
     !mtodesc = !this.strutypes[!make] & '|' & !this.strudbrefs[!make] & '|' & !this.strudescriptions[!make] & '|' & !this.struquantity[!make]
     !strutempelem.append(!mtodesc)
   enddo

-------------------------------------------------
-- Determine the UNIQUE descriptions for the MDS HANGERS in a MDS GROUP
   !hindex = !this.hangdescriptions.sortedindices()
   !this.hangtypes.reindex(!hindex)
   !this.hangdbrefs.reindex(!hindex)
   !this.hangdescriptions.reindex(!hindex)
   !this.hangquantity.reindex(!hindex)
  !hangtempelem = ARRAY()

   do !make index !this.hangdescriptions
-- Get all of the interested bits, ready for use.
     !mtodesc = !this.hangtypes[!make] & '|' & !this.hangdbrefs[!make] & '|' & !this.hangdescriptions[!make] & '|' & !this.hangquantity[!make]
     !hangtempelem.append(!mtodesc)
   enddo

-------------------------------------------------


-- Now make the final elements array ready for use with the table creation
-- Go off and create the final array with all different lists.
-- Initialise the ARRAY Variable for MDS Framework and MDS Hangers in the MDS GROUP
   !mdsgroup = TRUE
   !this.taskparams      = !params
  !this.struelements[1] = ARRAY()
  !this.struelements[2] = ARRAY()
  !this.struelements[3] = ARRAY()
  !this.struelements[4] = ARRAY()

-- Add the MTO Column Headings Text to each array member
   !this.struelements[1].append(!this.taskparams[2].split(|,|)[1])
   !this.struelements[2].append('NA')
   !this.struelements[3].append(!this.taskparams[2].split(|,|)[2])
   !this.struelements[4].append(!this.taskparams[2].split(|,|)[3])

  !this.hangelements[1] = ARRAY()
  !this.hangelements[2] = ARRAY()
  !this.hangelements[3] = ARRAY()
  !this.hangelements[4] = ARRAY()

-- Add the MTO Column Headings Text to each array member
  -- this is DONE to TEMPORARILY to KEEP the ARRAYS "!this.hangelements[1], [2], [3] and [4]" -- "IN-LINE" for MDS GROUPS
   !this.hangelements[1].append(!this.taskparams[2].split(|,|)[1])
   !this.hangelements[2].append('NA')
   !this.hangelements[3].append(!this.taskparams[2].split(|,|)[2])
   !this.hangelements[4].append(!this.taskparams[2].split(|,|)[3])

-- Get the Totals etc... for the MDS Framework in the MDS GROUP
  !this.getTotals(!strutempelem,!strutempelem[1].split('|')[1], !mdsgroup)
   handle any
-- No steelwork
   endhandle

-- Get the Totals etc... for the MDS Hangers in the MDS GROUP
   !this.gethangtotals(!hangtempelem,!hangtempelem[1].split('|')[1], !mdsgroup)
   handle ANY
-- No Hangers
   endhandle

-- Clear the !this.elements variable and Reset
   !this.elements.clear()
   !this.elements[1] = ARRAY()
   !this.elements[2] = ARRAY()
   !this.elements[3] = ARRAY()
   !this.elements[4] = ARRAY()
-- Combine the ARRAYS within the ARRAYS of "!this.struelements" and,
-- "!this.hangelements" into the ARRAY "!this.elements"
   do !real from 1 to 4
    !this.elements[!real].appendArray(!this.struelements[!real])
    !this.elements[!real].appendArray(!this.hangelements[!real])
   enddo

-- Navigate back to the ORIGINAL component
   !!ce = !view

 endmethod
------------------------------------------------------------------------
------------------------------------------------------------------------
--<wd>jan2005 --END of New Method .loadgroupdata
------------------------------------------------------------------------
------------------------------------------------------------------------
