--
-- File: MdsAbaSctndata.pmlobj
--   Type: Object Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: Draft MDS using ABA for Drawing production
--   Replaces:
--
-- Author: Steve Robinson
-- Created: 25th June 2002
--
--
-- Description:
--
-- This object holds information about sctns for dimensioning purposes.
-- The object's data is used as part of the MDS ABA steelwork dimensioning.
--
--------------------------------------------------------------------------------
-- Define Object
  define object MDSABASCTNDATA

    member .sctn   is DBREF     $* sctn to be dimensioned
    member .type   is STRING    $* sctn orientation: HORIZ, VERT or SKEW
    member .dimkey is STRING    $* sctn pline PKEY to be dimensioned
    member .dir    is DIRECTION $* sctn primary direction (from POSS to POSE)
    member .elev   is BOOLEAN   $* TRUE is this section dimension requires an
                              --$* elevation label on the projection line text

--------------------------------------------------------------------------------
  endobject

-----------------------------------------------------
-- Constructor method
-----------------------------------------------------
-- Arguments:
-- sctn = DBREF of sctn to be processed
-- view = DBREF of view where sctn will be dimensioned
-----------------------------------------------------
  define method .mdsabasctndata(!sctn is DBREF, !view is DBREF)

-- set tolerance for sctns to be considered horizontal or vertical (deg)
    !tolang = 10

    $!sctn
    !this.sctn = !!ce

-- Get the direction of the extruded sctn
    !ps = !sctn.poss
    !pe = !sctn.pose
    var !sdir const dir $!ps to $!pe

--<wd>29feb2008 -- DUN824, Defect No. P4405
--    !this.dir = $!sdir
    !this.dir = !sdir.direction()
--<wd>29feb2008 -- DUN824, Defect No. P4405

-- switch off the elevation label
    !this.elev = false
-- Determine if sctn is horizontal, vertical or skewed
    if (!this.dir.up.asin().abs().leq(!tolang)) then
      !this.type = 'HORIZ'
    elseif (abs(90 - !this.dir.up.asin().abs()) leq !tolang ) then
      !this.type = 'VERT'
    else
      !this.type = 'SKEW'
    endif

-- if view dir is an elevation and the sctn is horizontal then
-- switch on the sctn elevation label flag
    if (!view.dir.up.neq(-1) and !this.type.eq('HORIZ')) then
      !this.elev = true
    endif

-- Determine pline to be used for dimensioning.
-- This is based on the plines present in the catalogue and
-- is dependant on the pkeys matching those defined in the
-- standard catalogue of steel shapes.
-- Angle = TOAX
-- Channel = FOC
-- TEE = TOS
-- I section = NA
-- Square, rectangular or circular hollow = NA
-- If no match found default to NA
-- If NA not present default to member line
-- Get the plines and MEML
    !plines = !sctn.plna
    !plmem  = !sctn.meml
--    !pldef  = 'NA'
-- do the logic to determine which pline to dimension
    if (!plines.size().eq(0)) then
-- if NO plines then NO dimension - this should never happen!
      !this.dimkey = ''
    else
      if !plines.findfirst('TOS').set().and(!plines.findfirst('LEFT').set()) then
--found the TOS and LEFT so this is a rectangular hollow section (BOX) kpl 09.03.05
         !this.dimkey = 'NA'
      elseif (!plines.findfirst('TOAX').unset().not()) then
-- found the TOAX pline so this is an ANGLE
        !this.dimkey = 'TOAX'
      elseif (!plines.findfirst('FOC').unset().not()) then
-- found the FOC pline so this is a CHANNEL
-- if sctn is horizontal and view dir is elevation then
-- determine upper most pline
        if (!this.type.eq('HORIZ') and !view.dir.up.neq(-1)) then
-- find upper pline
          !el = -9999999
          !plu = ''
          do !pline values !plines
            var !plstartpos ppline $!pline start WRT WORLD

--<wd>29feb2008 -- DUN824, Defect No. P4405
--            !pls = $!plstartpos
            !pls = !plstartpos.position()
--<wd>29feb2008 -- DUN824, Defect No. P4405

            if (!pls.up.gt(!el)) then
              !el = !pls.up
              !plu = !pline
            endif
          enddo
          !this.dimkey = !plu
        else
          -- dimension to face of channel
          !this.dimkey = 'FOC'
        endif
      elseif (!plines.findfirst('TOS').unset().not() and $
              !plines.findfirst('TLW').unset()) then
        -- found the TOS pline but not TLW pline so this is a TEE
        !this.dimkey = 'TOS'
      elseif (!plines.findfirst('NA').unset().not()) then
        -- found the NA pline so this is a I or HOLLOW
        -- if sctn is horizontal and view dir is elevation then
        -- determine upper most pline
        if (!this.type.eq('HORIZ') and !view.dir.up.neq(-1)) then
          -- find upper pline
          !el = -9999999
          !plu = ''
          do !pline values !plines
            var !plstartpos ppline $!pline start WRT WORLD

--<wd>11mar2008 -- DUN824, Defect No. P4405
--            !pls = $!plstartpos
            !pls = !plstartpos.position()
--<wd>11mar2008 -- DUN824, Defect No. P4405

            if (!pls.up.gt(!el)) then
              !el = !pls.up
              !plu = !pline
            endif
          enddo
          !this.dimkey = !plu
        else
-- dimension to NA of sctn
          !this.dimkey = 'NA'
        endif
      else
-- default to member line
        !this.dimkey = !plmem
      endif
    endif

  endmethod
-- End of Object - mdsabasctndata
