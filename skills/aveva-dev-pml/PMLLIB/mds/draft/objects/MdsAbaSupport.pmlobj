-- Description:
-- Object of MDS support data to Generate an ABA Drawing for the Selected Support
--
--------------------------------------------------------------------------------
-- Define Object
  define object mdsabasupport

    member .support is dbref
    member .mdsdata is mdsabadesdata
    member .abadata is mdsabadradata

--------------------------------------------------------------------------------
  endobject
-- End of Object - mdsabasupport


-- method to get target element for setting of UDA (:mdsadp, :mdsadprem,:mdsviewflip,etc.)
-------------------------------------------------------------------------------------------
-- Neale Morris/Karel Pleschner
--
define method .GetElemForUDA() is DBREF

--------------------
--<wd>feb2007<mds12>
-- The commented out code below "ERRORS" when the MDS SUPPORT TYPE is a STRUCTURE
--
--   if !this.support.type.eq('ATTA').and(!this.support.cref.badref().Not()) then
--      !target = !this.support.cref.owner
   if (!this.support.type.eq('ATTA')) then
     if (!this.support.cref.badref().not()) then
       !target = !this.support.cref.owner
     else
       !target = !this.support
     endif
--<wd>feb2007<mds12>
--------------------
   else
      !target = !this.support
   endif

   return !target

endmethod
