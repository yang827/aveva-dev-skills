define object APPDRAMDSABA
endobject
-----------------------------------------------------------------------------------

-----------------------------------------------------------------------------------
define method .modifyForm()
  !this.toolbars()
endmethod
-----------------------------------------------------------------------------------

-----------------------------------------------------------------------------------
define method .barMenu()
  !bmenu = object APPBARMENU()
  !bmenu.add(|Create|, 'MBCREATE')
  !bmenu.add(|Delete|, 'MBDELETE')
  !!appMenuCntrl.addBarMenu(!bmenu, 'ADPCORE')
endmethod
-----------------------------------------------------------------------------------


-----------------------------------------------------------------------------------
define method .displayMenu()
  !menu = object APPMENU('mbDisplay')
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')
endmethod
-----------------------------------------------------------------------------------

-----------------------------------------------------------------------------------
define method .graphMenu()
  !menu = object APPMENU('mbGraphics')
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')
endmethod
-----------------------------------------------------------------------------------

-----------------------------------------------------------------------------------
define method .queryMenu()
  !menu = object APPMENU('mbQuery')
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')
endmethod
-----------------------------------------------------------------------------------

-----------------------------------------------------------------------------------
define method .settingsMenu()
  !menu = object APPMENU('mbSettings')
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')
endmethod
-----------------------------------------------------------------------------------

-----------------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('mbUtils')
  !menu.add('SEPARATOR')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |General ADP Toolbars|, 'GDPTOOLS', 'GeneralADPToolbars')
  !menu.add('SEPARATOR')
  --<RM> 06/05/2011 added a check that certain application defaults db items are loaded before we allow access to the corresponding modification tools for MDS - start
  !mdsOptionDefs = object DBREF('/MDS/OPTION/DEFAULTS')
  handle (2,109)
    !mdsOptionDefs = object DBREF()
  endhandle
  !mdsAttaDefs = object DBREF('/MDS/ATTA/DEFAULTS')
  handle (2,109)
    !mdsAttaDefs = object DBREF()
  endhandle
  !mdsStructureDefs = object DBREF('/MDS/STRUCTURE/DEFAULTS')
  handle (2,109)
    !mdsStructureDefs = object DBREF()
  endhandle
  !mdsTemplates = object DBREF('/MDS/TEMPLATES')
  handle (2,109)
    !mdsStructureDefs = object DBREF()
  endhandle
  if !mdsOptionDefs.unset() or !mdsAttaDefs.unset() or !mdsStructureDefs.unset() or !mdsTemplates.unset() then
    --do nothing
  else
  !menu.add ('CALLBACK',|MDS Drawing Lock |, |pml load form !!mdslockdrwg
    show !!mdslockdrwg| )
  !menu.add('CALLBACK', |MDS Revision Control...|,|pml load form !!mdsReviCntl
  !!mdsReviCntl.init()| )
  !menu.add('CALLBACK', |MDS Scale Override...| ,|pml load form !!mdsAbaScale
  !!mdsAbaScale.init()| )
  /MDS/TEMPLATES
    handle ANY
    elsehandle NONE
  if ((desc of /MDS/TEMPLATES ) eq 'Framatome Templates') then
        !menu.add('CALLBACK', |MDS Symbols...| ,|pml load form !!mdsAbaSymbols
        show !!mdsAbaSymbols| )
  endif
    endhandle
  !menu.add('CALLBACK', |MDS Layer Control...| ,|pml load form !!mdsAbaLayerCtrl
  show !!mdsAbaLayerCtrl| )
  !menu.add('CALLBACK', |MDS Rescale Pipe Symbols| ,|!!mdsReScalePS()| )
  !menu.add('CALLBACK', |Update DM Plotfile|, |!!mdsDpcUpdate()| )
  endif
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')
endmethod
-----------------------------------------------------------------------------------

define method .deleteMenu()
  !menu = object APPMENU('MBDELETE')
  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')
endmethod

-----------------------------------------------------------------------------------
define method .toolbars()
-- this toolbar is defined in the aba admin object
return

endmethod
-----------------------------------------------------------------------------------

-----------------------------------------------------------------------------------
define method .menus()

  !menu = object APPMENU('MBCREATE')
  !menu.add('MENU', |Copy|, 'MBCOPY', 'Copy')
  !menu.add('CALLBACK', |Layer...|, |CALLIBM FCREATE LAYE NO $<$>|, 'Layer')
  !menu.add('CALLBACK', |Note...|, |CALLDRG XCRNOTE|, 'Note')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Department...|, |CALLDRG XDEPT CREATE|, 'Department')
  !menu.add('CALLBACK', |Registry...|, |CALLDRG XREGI CREATE|, 'Registry')
  !menu.add('SEPARATOR')
  !menu.add('MENU', |General ADP|, 'ADPCREATE', 'GeneralADP')

  if defined(!!cdauto) then
    if !!cdauto then
       !menu.add('CALLBACK', |Area ADP Drawings...|, |loadform !!abaProcess !!abaProcess.init()|, 'AreaADPDrawings')
    endif
  endif

  if (defined(!!cadchs)) then
      if ($!!cadchs) then
        !menu.add('FORM', |Hanger & Support Drawings...|, 'CDRBATSUB', 'HangerSupportDrawings')
      else
        !menu.remove('HangerSupportDrawings')
      endif
  endif

-- Build Multi-Discipline Supports Drawing menu
-----------------------------------------------------------------------------------
--<wd>feb2007<mds12>
-- The variable !!kjbmds is NOT DECLARED and/or USED at version MDS12
--
--    if (defined(!!kjbmds)) then
--      if ($!!kjbmds) then
        --add |Multi-Discipline Support| menu .MDSABA
--
--
-- Build Multi-Discipline Supports Drawing menu for version MDS12
  if (defined(!!cdauto)) then
    if (!!cdauto) then

--------------------------------------------------------------
--<wd>feb2007<mds12>
-- Load the MDSDFLTS form for the Default Files if NOT already Loaded
      if (undefined(!!mdsdflts)) then
        pml load form !!mdsdflts
      endif
--<wd>feb2007<mds12>
--------------------------------------------------------------

      --<RM> 06/05/2011 added a check that certain application defaults db items are loaded before we allow access to the corresponding modification tools for MDS - start
      !mdsOptionDefs = object DBREF('/MDS/OPTION/DEFAULTS')
      handle (2,109)
        !mdsOptionDefs = object DBREF()
      endhandle
      !mdsAttaDefs = object DBREF('/MDS/ATTA/DEFAULTS')
      handle (2,109)
        !mdsAttaDefs = object DBREF()
      endhandle
      !mdsStructureDefs = object DBREF('/MDS/STRUCTURE/DEFAULTS')
      handle (2,109)
        !mdsStructureDefs = object DBREF()
      endhandle
      !mdsTemplates = object DBREF('/MDS/TEMPLATES')
      handle (2,109)
        !mdsStructureDefs = object DBREF()
      endhandle
      if !mdsOptionDefs.unset() or !mdsAttaDefs.unset() or !mdsStructureDefs.unset() or !mdsTemplates.unset() then
        --do nothing
      else
      !menu.add('SEPARATOR')
      !menu.add('CALLBACK', |MDS Drawings...| , |!!mdsdflts.init('SELECTION')| , 'mdsADPDrawings')
      !menu.add('CALLBACK', |MDS User View|   , |!!mdsCreUserView()|           , 'mdsUserView')
      !menu.add('CALLBACK', |MDS Over View|   , |!!mdsCreOverView()|           , 'mdsOverView')
      endif
    endif
  endif
--
--      endif
--    endif
--<wd>feb2007<mds12>
-----------------------------------------------------------------------------------

  !!appMenuCntrl.addMenu(!menu, 'ADPCORE')

endmethod
-----------------------------------------------------------------------------------

-----------------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  --!this.displayMenu()
  --!this.graphMenu()
  --!this.queryMenu()
  --!this.settingsMenu()
  !this.utilsMenu()
  !this.deleteMenu()
  !this.menus()
endmethod
