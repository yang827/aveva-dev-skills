--
-- File: mdsabadimatta.pmlobj
--   Type: Object Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: Draft MDS using ABA for Drawing production
--   Replaces:
--
-- Author: Steve Robinson
-- Created: 1st July 2002
--
--
-- Description:
-- ------------
-- This object generates DIMENSIONS & ELEVATIONS etc... for MDS ABA support ATTAS, i.e. MDS ANCILLARIES
--
-- Using this object:
-- ------------------
-- For each view to be annotated make an instance of this object and pass the
-- DBREF of the atta to be dimensioned and the DBREF of the view.
--
-- Before calling the .dimension() method make sure the atta_Dims layer
-- exists and had the relevant UCODE, PCODE and other text defaults set. This
-- allows you to control the appearance of the annotation before is it generated.
-- Note: If the dim layer does not exist then the method will create it and
-- and atts cascaded from view level will take effect.
-- ---------------
-- IMPERIAL UNITS:
-- ---------------
-- The code should work in both metric and imperial units...
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dimension(STRING,MDSABASUPPORT)  -
--  fixdims(DBREF,STRING)            -
--  mdsabadimatta(ARRAY,DBREF)       -
--
define object MDSABADIMATTA

  member .attas    is ARRAY        $* ARRAY of support atta DBREFS to be dimensioned
  member .view     is DBREF        $* VIEW where dimensions are to be created
  member .units    is COMUNITS

  --------------------------------------------------------------------------------
endobject

----------------------------------------------------------
-- Constructor to get design data and populate this object
----------------------------------------------------------
-- Arguments:
-- attas = Array of DBREFS of support ATTAS to be dimensioned
-- view  = DBREF of view where atta will be dimensioned
----------------------------------------------------------
define method .mdsabadimatta(!attas is ARRAY, !view is DBREF)

  !units = object COMUNITS(TRUE)
  !this.units = !units
  !saveRef    = !!ce
  !this.attas = !attas
  !this.view  = !view
  $!saveRef

endmethod

------------------------------------------------------
-- Method to generate dimensions for MDS ANCILLARIES
------------------------------------------------------
define method .dimension(!params is STRING ,!dummymdsobject is MDSABASUPPORT)

  --------------------------------------------
  --<wd>02apr2008 - DUN824 - Defect No. P-4526
  -- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
  --
  -- Obsolete Parameter Nos and Some Pen Attributes  -- Params passed as string
  -- Obsolete Parameter Nos and Some Pen Attributes  -- 1  Projection Line Pen  PLPN
  -- Obsolete Parameter Nos and Some Pen Attributes  -- 2  Dimension Line Pen   DLPN
  -- Obsolete Parameter Nos and Some Pen Attributes  -- 3  Dimension Text Pen   DTPN
  -- Obsolete Parameter Nos and Some Pen Attributes  -- 4  Projection Text Pen  PTPN
  -- Obsolete Parameter Nos and Some Pen Attributes  -- 5  Dimension Text Font  DFONT
  -- Obsolete Parameter Nos and Some Pen Attributes  -- 6  Projection Text Font PFONT
  -- Obsolete Parameter Nos and Some Pen Attributes  -- 7  Dimension Text Size  DTCH
  -- Obsolete Parameter Nos and Some Pen Attributes  -- 8  Projection Text Size PTCH
  -- Obsolete Parameter Nos and Some Pen Attributes  -- 9  Terminator Size      TSIZE
  -- Obsolete Parameter Nos and Some Pen Attributes  -- 10 Terminator           DTERM
  -- Obsolete Parameter Nos and Some Pen Attributes  -- 11 Bolt dimensions      on/off
  --
  -- NEW 12.0 version Parameters (DIMENSION Pen Attributes etc...) passed as a STRING
  -- *** IMPORTANT NOTE ***
  -- Depending on whether U-Bolt Hole Dimensions are required, the number of parameters may vary!!!
  -- Either 12 or 13 parameters my be passed here???
  -- i.e.
  -- <1> -- When U-Bolt Hole Dimensions are required then parameter 13 MUST be PASSED/DEFINED and set to TRUE
  -- <2> -- When parameter 13 is either NOT PASSED/UNDEFINED or DEFINED and SET to FALSE, the U-Bolt Hole Dimensions will NOT be displayed
  -- ONLY 12 or 13 parameters are passed here as the ORIGINAL 1st parameter toggle value (TRUE or FALSE)
  -- in the STRING of 13 or 14 Parameters has been REMOVED in the MDS ABA MAIN VIEW calling ABA TASK FUNCTION "mdsabaviewtask.pmlfnc"
  --
  --  1 Projection Line Style  = PLSTYLE
  --  2 Projection Line Colour = PLCOLOUR
  --  3 Projection Text Font   = PFONT
  --  4 Projection Text Size   = PTCHEIGHT
  --  5 Projection Text Colour = PLCOLOUR
  --  6 Dimension Line Style   = DLSTYLE
  --  7 Dimension Line Colour  = DLCOLOUR
  --  8 Dimension Text Font    = DFONT
  --  9 Dimension Text Size    = DTCHEIGHT
  -- 10 Dimension Text Colour  = DLCOLOUR
  -- 11 Terminator Size        = TSIZE
  -- 12 Terminators            = DTERMINATOR
  -- 13 U-Bolt Hole Dimensions = TRUE or FALSE
  --
  --<wd>02apr2008 - DUN824 - Defect No. P-4526
  --------------------------------------------

  -- Create an ARRAY of the PASSED Parameters
  !passedparams = !params.split(',')

  -- Dimension layer suffix
  !dimLayer = 'ANCILL_Dims'

  -- Navigate to view
  $!this.view

  -- Get view region for dimension positioning
  !vreg = !!ce.vreg

  -- Get direction of view
  !unusedvdir = !!ce.dir

  -- Check dimension layer exists
  set
  */$!dimLayer
  handle ANY
    new layer */$!dimLayer
  endhandle
  !layer = !!ce

  --------------------------------------------
  --<wd>02apr2008 - DUN824 - Defect No. P-4526
  -- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
  --
  --     PLPN  $!passedparams[1]
  --     DLPN  $!passedparams[2]
  --     TSIZE $!passedparams[9]
  --     DTERM $!passedparams[10]
  --
  -- -- tm added for extra labels for bolt holes
  --     FONT  $!passedparams[5]
  --     CHEI  $!passedparams[7]
  --     TPEN  $!passedparams[3]
  --     LTERM $!passedparams[10]
  --     LLPN  $!passedparams[1]
  --     LFRA FALSE
  --
  -- Set the Dimension Attributes Form with the Stored Values at the View Task
  -- All of the 'handle any' lines etc.. have been added to ensure that the MDS ABA default value is USED if an ERROR occurs
  -- At LAYER level
  --
  -- Projection Line FONT Attributes
  PLSTYLE $!passedparams[1]
  handle ANY
    PLSTYLE Solid
  endhandle
  PLCOLOUR $!passedparams[2]
  handle ANY
    PLCOLOUR 4
  endhandle

  -- Dimension Line FONT Attributes
  DLSTYLE $!passedparams[6]
  handle ANY
    DLSTYLE Solid
  endhandle
  DLCOLOUR $!passedparams[7]
  handle ANY
    DLCOLOUR 4
  endhandle

  TSIZE $!passedparams[11]
  handle ANY
    TSIZE 3
  endhandle
  DTERM $!passedparams[12]
  handle ANY
    DTERM Arrows
  endhandle
  --
  -- Additional LABEL attributes required for U-Bolt Hole Dimensions SET at LAYER level (as per "tm" comment above)
  -- Label COLOUR, FONT type and FONT SIZE Attributes
  TXCOLOUR $!passedparams[7]
  handle ANY
    TXCOLOUR 1
  endhandle
  FONT     $!passedparams[8]
  handle ANY
    FONT 3
  endhandle
  CHEIGHT  $!passedparams[9]
  handle ANY
    CHEIGHT 4mm
  endhandle

  -- Label Leader Line Attributes
  LLSTYLE $!passedparams[1]
  handle ANY
    LLSTYLE Solid
  endhandle
  LLCOLOUR $!passedparams[2]
  handle ANY
    LLCOLOUR 4
  endhandle
  LTERM $!passedparams[12]
  handle ANY
    LTERM Arrows
  endhandle

  -- Label Frame Attributes
  LFRA FALSE
  LFSTYLE $!passedparams[1]
  handle ANY
    LLSTYLE Solid
  endhandle
  LFCOLOUR $!passedparams[2]
  handle ANY
    LFCOLOUR 4
  endhandle
  --
  --<wd>02apr2008 - DUN824 - Defect No. P-4526
  --------------------------------------------

  -- Clear any existing dimensions
  DELETE LAYER MEMBERS
  handle ANY
  endhandle

  -- Get view direction and determine dimension direction up and to right of view
  var !udir viewdir up
  !unusedudirection = $!udir

  -- Create new ldims for MDS Ancillaries
  do !indx indices !this.attas
    if !this.attas[$!indx].name.matchwild('*/SREF') then
      skip
    endif
    NEW LDIM */$!dimLayer/UD-ANCILL-$!indx

    --------------------------------------------
    --<wd>02apr2008 - DUN824 - Defect No. P-4526
    -- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
    -- At LDIM level
    --
    --      DTPN  $!passedparams[3]
    --      PTPN  $!passedparams[4]
    --      DFONT $!passedparams[5]
    --      PFONT $!passedparams[6]
    --      DTCH  $!passedparams[7]
    --      PTCH  $!passedparams[8]

    -- Projection Line FONT Attributes
    PLSTYLE $!passedparams[1]
    handle ANY
      PLSTYLE Solid
    endhandle
    PLCOLOUR $!passedparams[2]
    handle ANY
      PLCOLOUR 4
    endhandle
    PFONT $!passedparams[3]
    handle ANY
      PFONT 3
    endhandle
    PTCHEIGHT $!passedparams[4]
    handle ANY
      PTCHEIGHT 3
    endhandle
    PTCOLOUR $!passedparams[5]
    handle ANY
      PTCOLOUR 7
    endhandle

    -- Dimension Line FONT Attributes
    DLSTYLE $!passedparams[6]
    handle ANY
      DLSTYLE Solid
    endhandle
    DLCOLOUR $!passedparams[7]
    handle ANY
      DLCOLOUR 4
    endhandle
    DFONT $!passedparams[8]
    handle ANY
      DFONT 3
    endhandle
    DTCHEIGHT $!passedparams[9]
    handle ANY
      DTCHEIGHT 3
    endhandle
    DTCOLOUR $!passedparams[10]
    handle ANY
      DTCOLOUR 6
    endhandle
    --
    --<wd>02apr2008 - DUN824 - Defect No. P-4526
    --------------------------------------------

    -- Component dimensions
    !unusedldimref = !!ce
    DIR $!udir
    --      do !atta values !attamem
    new dppt on p0 of $!this.attas[$!indx]
    handle ANY
    endhandle
    new dppt on p9 of $!this.attas[$!indx]
    handle ANY
    endhandle
    --      enddo

    LDIM
    -- ADD the ELEVATION PLTX for the 1st and last Dimension Points
    1
    handle ANY
      --$P ++++# 1
      --q var !!error.text
    elsehandle NONE
      --!testref = ddna
      PLTX 'EL. #POSU+' PJUST AWAY
    endhandle
    LDIM
    LAST MEM
    handle ANY
      --$P ++++# 2
      --q var !!error.text
    elsehandle NONE
      --if !!ce.ddna.neq(!testref) then
      PLTX 'EL. #P9POSU+' PJUST AWAY
      --endif
    endhandle

    LDIM
    SORT DIM
    handle ANY
    endhandle

    -- Remove any zero length dimensions
    var !dppts coll all DPPT for ce

    do !dppt values !dppts
      $!dppt
      var !dmtx expanded DMTX
      handle (2,235) $* expanded text not available
        !t = !!ce.type
        delete $!t
      elsehandle NONE
        skip if (!dmtx.eq('unset'))
        if (!dmtx.eq('0')) then
          !t = !!ce.type
          delete $!t
        endif
      endhandle
    enddo

    LDIM
    SORT DIM
    handle ANY
    endhandle

    LDIM
    -- Original DPOS Code
    !x = !vreg[1]
    DPOS X $!x Y $!vreg[2]

    --------------------------------------------
    --<wd>02apr2008 - DUN824 - Defect No. P-4526
    -- CODE modified to use the NEW 12.0 version DRAFT PEN, COLOUR and LINESTYLE attributes
    -- There is now a maximum of 13 parameters and not 11 parameters as before at version MDS ABA 11.6
    -- At LDIM level
    --
    -- --<tm>  add ubolt dimensions to the atta
    --   if defined(!passedparams[11]) then
    --     if !passedparams[11].boolean() then
    --
    if defined(!passedparams[13]) then
      if !passedparams[13].boolean() then
        --
        --<wd>02apr2008 - DUN824 - Defect No. P-4526
        --------------------------------------------
        !obj = object MDSUBOLTHOLES($!this.attas[$!indx],!this.units)
        !obj.adddim(!layer)
      endif
    endif

    -- Move any dim text that hits the projection lines
    !this.fixdims(!!ce,'U')
  enddo

endmethod

-----------------------------------------------------------------------------
-- Method to determine if a dppt or dpos DMTX will fit within within the
-- projection lines. If text is too large the dpoi or dppt has dtang set
-- to parallel. This will force the dimension text to appear outside the
-- projection lines.
-----------------------------------------------------------------------------
-- Arguments:
-- ldim = LDIM to be processed
-- !shtdir = direction of ldim on sheet U or R
-----------------------------------------------------------------------------
define method .fixdims(!ldim is DBREF, !shtdir is STRING)

  !elem = !ldim

  $!ldim
  !units = object COMUNITS(TRUE)
  UNITS MM DIST
  -- Get the letter height
  !chei = !!ce.dtch
  !yoff = !chei * 2
  laye
  -- Check for imperial units - switch to mm for this procedure and then
  -- Switch back at end
  var !ucode ucode
  if (!ucode.upcase().match('MM DIST').eq(0)) then
    UCODE MM DIST
    UPDATE ANNO
    handle ANY
    endhandle
  endif
  VIEW
  !vsca = !!ce.vscale

  -- Discovered when trying to output IMPERIAL DIMENSIONS on MDS atta Drawings
  -- The command -- $!ldim -- is NOT navigating to the 'LDIM' as REQUIRED, this is because the
  -- variable *** !ldim *** appears to be resetting itself to the VIEW - *** weird or what ???? ***
  -- *** I think I must being going mad!! ***
  -- Anyway resetting the **!!ce = !elem ** (!elem set to !ldim on entry to this method)
  -- instead of the syntax command ** $!ldim ** fixes the problem!!!
  !!ce = !elem

  var !points coll all ldim members for ce
  -- Check each points dimension value and determine if the dmtx need moving
  do !point values !points
    $!point
    var !dim expa dmtx
    handle ANY
      skip
    endhandle
    skip if (!dim.upcase().eq('UNSET'))
    -- Convert the design distance to a sheet distance
    !sdist = $!dim * $!vsca
    skip if (!dim.trim().length().eq(0))
    -- Check if the letter height will fit inside the projection lines
    if (!sdist.lt(!chei)) then
      -- Move the text
      -- When the dimension goes up the sheet then simply set the DTANG
      if (!shtdir.eq('U') or !shtdir.eq('Z')) then
        DTANG PARALLEL
      else
        DTANG PARALLEL
        DTOF 0 -$!yoff
      endif
    endif
  enddo
  LAYER

  -- Reset the ucode and units
  UCODE $!ucode
  UPDATE ANNO
  handle ANY
  endhandle
  !units.restoreSavedUnitsByPtype('DIST')
endmethod
-- End of Object - mdsabadimatta
