------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkAgainst(POSITION)           -
--  checkAgainst(REAL,REAL)          -
--  distanceFrom(POSITION)           XYPOSITION
--  gridtag(DBREF)                   STRING
--  mdsabaGridsystem(DBREF)          -
--  poswithin(POSITION)              ANYDATASET
--  string()                         STRING
--
define object MDSABAGRIDSYSTEM

	member .origin is DBREF

	member .xtag is ARRAY
	member .ytag is ARRAY
	member .xoff is ARRAY
	member .yoff is ARRAY

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Default constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]      [Description]
--
-- Return:
--   [Data Type]       [Description]
--
------------------------------------------------------------------------

define method .mdsabaGridsystem(!grid is DBREF)

	if !grid.type.eq('FRMW').or(!grid.type.eq('STRU')) then
		!this.origin = object DBREF('STRU of ' & !grid)
		!type = 'SCTN'
		!xexpr = 'gtyp eq ''XGRD'''
		!yexpr = 'gtyp eq ''YGRD'''
	elseif !grid.type.eq('GRIDSY') then
		!this.origin = !grid
		!type = 'GRIDLN'
		!xexpr = 'grdaxe of owner eq ''X'''
		!yexpr = 'grdaxe of owner eq ''Y'''
	else
		return error 1 'Wrong element type (STRU/FMRW or GRIDSY expected)'
	endif

	-- collect gridlines
	!xgrid = !!mdsCollectAll(!type,!xexpr,!grid)
	!ygrid = !!mdsCollectAll(!type,!yexpr,!grid)

	-- collect data from X gridlines
	!xoff = ARRAY()
	!xtag = ARRAY()
	do !gridline values !xgrid
		if !type.eq('SCTN') then
			!off = !gridline.pos.wrt(!grid).east
		elseif !type.eq('GRIDLN') then
			!off = !gridline.grdoff
		endif
		!xoff.append(!off)
		!xtag.append(!this.gridtag(!gridline))
	enddo
	-- sort X gridlines
  !index = !xoff.sortedIndices()
  !xoff.reindex(!index)
  !xtag.reindex(!index)

	-- collect data from Y gridlines
	!yoff = ARRAY()
	!ytag = ARRAY()
	do !gridline values !ygrid
		if !type.eq('SCTN') then
			!off = !gridline.pos.wrt(!grid).north
		elseif !type.eq('GRIDLN') then
			!off = !gridline.grdoff
		endif
		!yoff.append(!off)
		!ytag.append(!this.gridtag(!gridline))
	enddo
	-- sort Y gridlines
  !index = !yoff.sortedIndices()
  !yoff.reindex(!index)
  !ytag.reindex(!index)

	!this.xoff = !xoff
	!this.xtag = !xtag
	!this.yoff = !yoff
	!this.ytag = !ytag

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridtag(!gridline is DBREF) is STRING

	!tag = STRING()
	if !gridline.type.eq('SCTN') then
		!expr = !!mdsgridSctnTag
		handle ANY
		endhandle
		!defexpr = object EXPRESSION('desc')
	elseif !gridline.type.eq('GRIDLN') then
		!expr = !!mdsgridGridlnTag
		handle ANY
		endhandle
		!defexpr = object EXPRESSION('grdid')
	endif

	!tag = !expr.evaluate(!gridline)
	handle ANY
	endhandle

	if !tag.unset() then
		!tag = !defexpr.evaluate(!gridline)
	endif

	return !tag

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .poswithin(!pos is POSITION) is ANYDATASET

	!xoff = !pos.wrt(!this.origin).east
	!yoff = !pos.wrt(!this.origin).north

	!this.checkAgainst(!xoff,!yoff)
	handle 1
		!outside = true
  elsehandle NONE
		!outside = false
	endhandle

	do !c indices !this.xoff
		if !c.eq(!this.xoff.size()) then
			!left = !c - 1
			!right = !c
			break
		endif
		!left = !c
		!right = !c + 1
		break if !xoff.geq(!this.xoff[!left]).and(!xoff.lt(!this.xoff[!right]))
	enddo

	!xtag[1] = !this.xtag[!left]
	!xtag[2] = !this.xtag[!right]
	!xdim[1] = !xoff - !this.xoff[!left]
	!xdim[2] = !this.xoff[!right] - !xoff

	do !c indices !this.yoff
		if !c.eq(!this.yoff.size()) then
			!below = !c - 1
			!above = !c
			break
		endif
		!below = !c
		!above = !c + 1
		break if !yoff.geq(!this.yoff[!below]).and(!yoff.lt(!this.yoff[!above]))
	enddo

	!ytag[1] = !this.ytag[!below]
	!ytag[2] = !this.ytag[!above]
	!ydim[1] = !yoff - !this.yoff[!below]
	!ydim[2] = !this.yoff[!above] - !yoff

	if !outside then
		!xmin = !this.xoff.first()
		!xmax = !this.xoff.last()
		!ymin = !this.yoff.first()
		!ymax = !this.yoff.last()
		if !xoff.leq(!xmin) then
			!xdim[1] = REAL()
			!xdim[2] = !xmin - !xoff
			!xtag[1] = ' '
			!xtag[2] = !this.xtag.first()
		elseif !xoff.gt(!xmax) then
			!xdim[1] = !xoff - !xmax
			!xdim[2] = REAL()
			!xtag[1] = !this.xtag.last()
			!xtag[2] = ' '
		endif
		if !yoff.leq(!ymin) then
			!ydim[1] = REAL()
			!ydim[2] = !ymin - !yoff
			!ytag[1] = ' '
			!ytag[2] = !this.ytag.first()
		elseif !yoff.gt(!ymax) then
			!ydim[1] = !yoff - !ymax
			!ydim[2] = REAL()
			!ytag[1] = !this.ytag.last()
			!ytag[2] = ' '
		endif
	endif

	!poswithin = object ANYDATASET()
	!poswithin.setAttribute('xtag',!xtag)
	!poswithin.setAttribute('ytag',!ytag)
	!poswithin.setAttribute('xdim',!xdim)
	!poswithin.setAttribute('ydim',!ydim)

	return !poswithin

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkAgainst(!pos is POSITION)

	!xoff = !pos.wrt(!this.origin).east
	!yoff = !pos.wrt(!this.origin).north

	!this.checkAgainst(!xoff,!yoff)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkAgainst(!xoff is REAL, !yoff is REAL)

	if !xoff.lt(!this.xoff.first()).or(!xoff.gt(!this.xoff.last())).or(!yoff.lt(!this.yoff.first())).or(!yoff.gt(!this.yoff.last())) then
		return error 1 'Coordinate X$!xoff Y$!yoff lies outside the grid system $!this.origin.name'
	endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .distanceFrom(!pos is POSITION) is XYPOSITION

	!xoff = !pos.wrt(!this.origin).east
	!yoff = !pos.wrt(!this.origin).north
	!xmin = !this.xoff.first()
	!xmax = !this.xoff.last()
	!ymin = !this.yoff.first()
	!ymax = !this.yoff.last()
	if !xoff.lt(!xmin) then
		!distx = !xmin - !xoff
	elseif !xoff.gt(!xmax) then
		!distx = !xoff - !xmax
	else
		!distx = 100000km
	endif
	if !yoff.lt(!ymin) then
		!disty = !ymin - !yoff
	elseif !yoff.gt(!ymax) then
		!disty = !yoff - !ymax
	else
		!disty = 100000km
	endif

	!dist = object XYPOSITION(!distx,!disty)

	return !dist

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .string() is STRING

	!name = STRING()

	if !this.origin.badref().not() then
		!name = !this.origin.namtyp
	endif

	return !name

endmethod
-- End of method
