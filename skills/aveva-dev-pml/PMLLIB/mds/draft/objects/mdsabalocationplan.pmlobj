------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  coordinates(POSITION,DBREF)      ARRAY
--  gridsystem(POSITION)             MDSABAGRIDSYSTEM
--  mdsabaLocationPlan()             -
--  mdsabaLocationPlan(STRING)       -
--  origin(DBREF)                    DBREF
--  poswithin(POSITION)              ANYDATASET
--
define object MDSABALOCATIONPLAN

  member .grid is ARRAY
  member .origin is STRING

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Default constructor method loading griddata from CATA db
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]      [Description]
--
-- Return:
--   [Data Type]       [Description]
--
------------------------------------------------------------------------

define method .mdsabaLocationPlan()

  !this.grid.clear()
  !this.origin = 'WORL'
  !root = '/MDS/ABAGRIDDATA/DEFAULTS'
  !cata = !root.dbref()
  handle ANY
    return error 1 'CATA $!root does not exist in catalogue db'
  endhandle

  -- extract ORIGIN value
  !gendata = object DBREF(!cata.name & '/GEN/DTSE')
  handle ANY
    return error 1 'Configuration data not available in catalogue db'
  endhandle
  !origin = !gendata.prop.orig
  handle ANY
    return error 1 'Origin definition is not available in catalogue db'
  endhandle
  if !origin.set() then
    !this.origin = !origin
  endif

  -- extract gridline tag patterns
  !tagexpr = object EXPRESSION(!gendata.prop.sctn)
  handle NONE
    !!mdsgridSctnTag = !tagexpr
  elsehandle ANY
  endhandle
  !tagexpr = object EXPRESSION(!gendata.prop.grdl)
  handle NONE
    !!mdsgridGridlnTag = !tagexpr
  elsehandle ANY
  endhandle

  -- extract list of grid systems
  !griddata = object DBREF(!root & '/GRIDS')
  handle ANY
    !griddata = nulref
  endhandle

  if !griddata.set() then
    !gridsystem = ARRAY()
    !alldata = !!mdsCollectAll('DATA','',!griddata)
    !grid = nulref
    do !data values !alldata
      !grid = !data.ppro.block().evaluate()
      handle ANY
        skip
      endhandle
      skip if !grid.badref()
      skip if !grid.type.eq('GRIDSY').or(!grid.type.eq('STRU')).or(!grid.type.eq('FRMW')).not()
      if !grid.type.eq('STRU').or(!grid.type.eq('FRMW')) then
        skip if !grid.purp.neq('GRID')
      endif
      !gridsys = object MDSABAGRIDSYSTEM(!grid)
      handle ANY
        skip
      endhandle
      !gridsystem.append(!gridsys)
    enddo
    !this.grid = !gridsystem
  endif

  if defined(!!mdsgridSctnTag) then
    !!mdsgridSctnTag.delete()
  endif
  if defined(!!mdsgridGridlnTag) then
    !!mdsgridGridlnTag.delete()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Constructor method loading griddata from file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Path to the file
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsabaLocationPlan(!filename is STRING)

  !this.grid.clear()
  !this.origin = 'WORL'

  -- extract ORIGIN value
  !config = object MDSREADEXCEL(!filename)
  !index = !config.table[1].findfirst('ORIGIN')
  if !index.set() then
    !origin = !config.table[2][!index].trim()
    if !origin.match('/').neq(1) then
      !origin = !origin.upcase().substring(1,4)
    endif
    !this.origin = !origin
  endif

  -- extract gridline tag patterns
  !index = !config.table[1].findfirst('SCTNTAG')
  if !index.set() then
    !tagexpr = object EXPRESSION(!config.table[2][!index].trim())
    handle NONE
      !!mdsgridSctnTag = !tagexpr
    elsehandle ANY
    endhandle
  endif
  !index = !config.table[1].findfirst('GRIDLNTAG')
  if !index.set() then
    !tagexpr = object EXPRESSION(!config.table[2][!index].trim())
    handle NONE
      !!mdsgridGridlnTag = !tagexpr
    elsehandle ANY
    endhandle
  endif

  -- extract list of grid systems
  !indexes = !config.table[1].find('GRIDLIST')
  !gridsystem = ARRAY()
  do !c values !indexes
    !gridname = !config.table[2][!c]
    !grid = !gridname.dbref()
    handle ANY
      !gridname = '/' & !gridname
      !grid = !gridname.dbref()
      handle ANY
        skip
      endhandle
    endhandle
    skip if !grid.type.eq('GRIDSY').or(!grid.type.eq('STRU')).or(!grid.type.eq('FRMW')).not()
    if !grid.type.eq('STRU').or(!grid.type.eq('FRMW')) then
      skip if !grid.purp.neq('GRID')
    endif
    !gridsys = object MDSABAGRIDSYSTEM(!grid)
    handle ANY
      skip
    endhandle
    !gridsystem.append(!gridsys)
  enddo
  !this.grid = !gridsystem

  if defined(!!mdsgridSctnTag) then
    !!mdsgridSctnTag.delete()
  endif
  if defined(!!mdsgridGridlnTag) then
    !!mdsgridGridlnTag.delete()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .origin(!datum is DBREF) is DBREF

  !origin = nulref
  if !this.origin.match('/').eq(1) then
    !origin = !this.origin.dbref()
  elseif !this.origin.eq('GRID') then
    !origin = !this.gridsystem(!datum.pos).origin
  else
    !origin = object DBREF(!this.origin & ' of ' & !datum)
  endif

  return !origin

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridsystem(!pos is POSITION) is MDSABAGRIDSYSTEM

  if !this.grid.unset() then
    return error 1 'No valid GRID exists.'
  endif

  do !grid values !this.grid
    !grid.checkAgainst(!pos)
    handle NONE
      !gridsystem = !grid
      break
    elsehandle ANY
    endhandle
  enddo

  if undefined(!gridsystem) then
    !xdist = ARRAY()
    !ydist = ARRAY()
    do !grid values !this.grid
      !dist = !grid.distanceFrom(!pos)
      !xdist.append(!dist.x)
      !ydist.append(!dist.y)
    enddo
    !xindex = !xdist.sortedindices().first()
    !yindex = !ydist.sortedindices().first()
    if !xdist[!xindex].leq(!ydist[!yindex]) then
      !gridsystem = !this.grid[!xindex]
    else
      !gridsystem = !this.grid[!yindex]
    endif
  endif

  return !gridsystem

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .poswithin(!pos is POSITION) is ANYDATASET

  !grid = !this.gridsystem(!pos)
  !posdata = !grid.poswithin(!pos)

  return !posdata

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .coordinates(!datumpos is POSITION, !datum is DBREF) is ARRAY

  !xyz = ARRAY()
  !origin = !this.origin(!datum)
  !pos = !datumpos.wrt(!origin)
  !xyz[1] = !pos.east
  !xyz[2] = !pos.north
  !xyz[3] = !pos.up

  return !xyz

endmethod
-- End of method
