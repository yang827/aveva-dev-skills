-- File:    mdsActiveControl.pmlfrm
-- Type:    Form Definition
-- Group:   Multi Discipline Supports Application
-- Keyword: MDS
-- Module:  Paragon
-- Author:  Joe Wyatt
-- Created: 13/05/09
--
-- Description: Form to active or deactivate MDS standard support types and associated
--              bore sizes in PARAGON so they can/cannot be used in DESIGN.
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  activeSwitchAncils(BOOLEAN)      -
--  activeSwitchBores(BOOLEAN)       -
--  afterSelectChange(ARRAY)         -
--  afterSelectChangeBores(ARRAY)    -
--  applyChanges()                   -
--  boresFrameChange(STRING)         -
--  cancelFormMethod()               -
--  colourGrid(STRING,ARRAY)         -
--  config(STRING)                   -
--  currentTab()                     STRING
--  fillGrid(STRING)                 -
--  init()                           -
--  initGrid(STRING)                 -
--  loadGrid(GADGET,STRING)          -
--  mdsActiveControl()               -
--  reinitAncils()                   -
--  reinitBores()                    -
--  rightClickGrid(ARRAY)            -
--  rightClickGridBores(ARRAY)       -
--  saveToExcel(STRING)              -
--  selectAll(GADGET,STRING)         -
--  setBores()                       -
--  updateActiveParaAncils()         -
--  updateActiveParaBores()          -
--  writeCheck()                     BOOLEAN
--
import 'GridControl'
handle ANY
endhandle

setup form !!mdsActiveControl dialog dock size 53 20
  -- .net library
  using namespace 'Aveva.Pdms.Presentation'
  -- Right-click menu for ancillaries grid gadget
  menu .gridPopup popup
  !this.gridPopup.add( 'CALLBACK', 'Activate', '!this.activeSwitchAncils(TRUE)' )
  !this.gridPopup.add( 'CALLBACK', 'Deactivate', '!this.activeSwitchAncils(FALSE)' )
  !this.gridPopup.add( 'CALLBACK', 'Save Table to Excel...', '!this.saveToExcel(|ancils|)' )
  !this.gridPopup.add( 'CALLBACK', 'Reinitialise Current Table', '!this.reinitAncils()' )
  -- Right-click menu for bores grid gadget
  menu .gridPopupBores popup
  !this.gridPopupBores.add( 'CALLBACK', 'Activate', '!this.activeSwitchBores(TRUE)' )
  !this.gridPopupBores.add( 'CALLBACK', 'Deactivate', '!this.activeSwitchBores(FALSE)' )
  !this.gridPopupBores.add( 'CALLBACK', 'Save Table to Excel...', '!this.saveToExcel(|bores|)' )
  !this.gridPopupBores.add( 'CALLBACK', 'Reinitialise Current Table', '!this.reinitBores()' )

  member .ancils is MDSACTIVECONTROLDATA
  -- Collects all the ancillary types (the tabs)
  !this.ancils.collectAncils()

  frame  .tabsframe tabset                                         at x0 y0         anchor ALL
    -- Creates a tab for each ancillary type
    do !i values !this.ancils.ancilTypes
      !suffix = !i
      !desc = !i
      frame .fr$!<suffix>  '$!desc'                                at xmin ymin
        para  .paActive$!<suffix>                                  at x1   y0.2     anchor L+T text '' width 25 height 1
        container .co$!<suffix> PMLNetCONTROL '$!desc' ANCHOR ALL  at x1   ymax+0.1 width 115 height 26
      exit
      -- adds the net control members
      member .net$!<suffix> is NETGRIDCONTROL
    enddo
  exit
  toggle .toSelectAll  'Select All'          at x1.5              ymax-1.3 anchor L+B call '!this.selectAll('
  button .makeActive   'Activate'   anchor B at xcen form - size  ymin.toSelectAll    call '!this.activeSwitchAncils(TRUE)'  width 10 height 1
  button .makeInactive 'Deactivate' anchor B at xmax+2            ymin                call '!this.activeSwitchAncils(FALSE)' width 10 height 1

  button .key linklabel '<-- Key to Support Types' at xmax.tabsframe y0   call 'show !!mdsActiveControlKey'  anchor R+T   width 15 height 0.5
  -- Defines the Bores Frame on the right-hand side
  frame  .boresFrame                     at xmax.tabsframe ymax-0.3  anchor T+B+R width 14 height 22
    para  .paBoreTitle                   at x1             ymin+0.5  anchor R+T text 'Individual Bore Sizes' width 14 height 1
    para  .paBore                        at xmin           ymax-0.2  anchor R+T text '' width 14 height 1
    para  .paBoreNone                    at xmin           ymax-0.1  anchor R+T text 'None Available' width 14 height 1
    frame  .boresFrameInternal   PANEL   at xmin           ymin-0.4  anchor ALL
      para  .paActiveBore                at xmin ymax+0.2  anchor R+T text '' width 14 height 1
      container .coBORES PMLNetCONTROL '$!desc' anchor ALL at xmin+1 ymax+0.1 width 14 height 22
      member .netBORES is NETGRIDCONTROL
      toggle .toSelectAllBore  'Select All'         at xmin ymax+0.1  anchor R+B call '!this.selectAll('
    exit
    button .makeActiveBore   'Activate'   anchor B  at xmin ymax-0.1 call '!this.activeSwitchBores(TRUE)'  width 7 height 1
    button .makeInactiveBore 'Deactivate' anchor B  at xmax ymin     call '!this.activeSwitchBores(FALSE)' width 7 height 1
  exit

  button .applyChanges   'Apply'   anchor B+L at xmin form        ymax.tabsframe+0.1 call '!this.applyChanges()'     width 10 height 1
  para   .config         at xmax+10 ymin anchor b text 'Configuration '
  button .configFull     'Full' anchor b at xmax + 3 call '!this.config(|FULL|)' width 10 height 1
  button .configBrief    'Brief' anchor b at xmax + 3 call '!this.config(|BRIEF|)' width 10 height 1
  button .discardChanges 'Dismiss' anchor B+R at xmax form - size ymin               call '!this.cancelFormMethod()' width 10 height 1

  member .bores is MDSACTIVECONTROLDATA
  member .prevSaveLocation is STRING
exit

-------------------------------------------------
-- Description: Constructor
-------------------------------------------------
define method .mdsActiveControl()
  using namespace 'Aveva.Pdms.Presentation'
--  !this.callback   = '!this.setup()'
  !this.formRevision = ' $Revision$ '
  !this.initCall     = '!this.init()'
  !this.formTitle    = 'MDS Active Control'
  !this.quitCall     = '!this.cancelFormMethod()'

  do !type value !this.ancils.ancilTypes
    !frameName                   = 'fr' & !type
    !this.$!<frameName>.callback = '!this.loadGrid('
  enddo

  !this.prevSaveLocation = |C:\|
endmethod

-------------------------------------------------------------------------------
-- Description: Init
-------------------------------------------------------------------------------
define method .init()
  !unusedCheck = !this.writeCheck()
  !this.applyChanges.active  = FALSE
  do !suffix values !this.ancils.ancilTypes
    !this.net$!<suffix>.cleargrid()
  enddo
  !frameName                   = 'fr' & !this.ancils.ancilTypes[1]
  !this.$!<frameName>.visible = TRUE
  !this.loadGrid(!!mdsActiveControl.$!<frameName>, 'SHOWN')
  if !this.netBORES.unset() then
    !this.initGrid('BORES')
  endif
endmethod

-------------------------------------------------------------------------------
-- Description: Processes the open callback for changing Tabs
-------------------------------------------------------------------------------
define method .loadGrid(!currentTab is GADGET, !status is STRING)
  !ancilType = !currentTab.tag
  if !status.eq('SHOWN') then
    -- If the grid has already been initialised then only fill it with new data
    if !this.net$!<ancilType>.unset() then
      !this.initGrid(!currentTab.tag)
    elseif !this.net$!<ancilType>.gettitles().unset() then
      !this.fillGrid(!currentTab.tag)
    endif
    !this.boresFrameChange('HIDE')
    !this.updateActiveParaAncils()
    !emptyArray = ARRAY()
    !this.afterSelectChange(!emptyArray)
  endif
endmethod
-------------------------------------------------------------------------------
-- Description: Reinitialise current ancillaries grid
-------------------------------------------------------------------------------
define method .reinitAncils()
  !ancilType = !this.currentTab()
  !this.net$!<ancilType>.cleargrid()
  !this.loadGrid(!!mdsActiveControl.fr$!<ancilType>, 'SHOWN')
endmethod
-------------------------------------------------------------------------------
-- Description: Reinitialise current bores grid
-------------------------------------------------------------------------------
define method .reinitBores()
  !ancilType = !this.currentTab()
  !arrayPos = !this.ancils.ancilTypes.findfirst(!ancilType)
  !whichRow = !this.net$!<ancilType>.getSelectedRowTags()[1]
  !this.bores.changed[!arrayPos][!whichRow.real()].delete()
  handle ANY
  endhandle
  !this.setBores()
endmethod
-------------------------------------------------------------------------------
-- Description: Initialises the specified .net grid gadget object
-------------------------------------------------------------------------------
define method .initGrid(!ancilType is STRING)
  using namespace  'Aveva.Pdms.Presentation'
  !netName = 'net' & !ancilType
  !this.$!<netName> = object NETGRIDCONTROL()
  !this.$!<netName>.columnExcelFilter(FALSE)
  !this.$!<netName>.outlookGroupStyle(FALSE)
  !this.$!<netName>.fixedHeaders(TRUE)
  !this.$!<netName>.fixedRows(FALSE)
  !this.$!<netName>.editableGrid(FALSE)
  !this.$!<netName>.headerSort(TRUE)
  !this.$!<netName>.setLabelVisibility(FALSE)
  !this.$!<netName>.resetcolumnproperties()
  !containerName                  = 'co' & !ancilType
  !this.$!<containerName>.control = !this.$!<netName>.handle()

  if !ancilType.eq('BORES') then
    !this.$!<netName>.addeventhandler('AfterSelectChange', !this, 'afterSelectChangeBores')
    !this.$!<netName>.addeventhandler('OnPopup', !this, 'rightClickGridBores')
  else
    !this.$!<netName>.addeventhandler('AfterSelectChange', !this, 'afterSelectChange')
    !this.$!<netName>.addeventhandler('OnPopup', !this, 'rightClickGrid')
  endif
  !this.fillGrid(!ancilType)
endmethod

-------------------------------------------------------------------------------
-- Description: Fills the specified .net grid gadget object with data
-------------------------------------------------------------------------------
define method .fillGrid(!ancilType is STRING)
  using namespace  'Aveva.Pdms.Presentation'
  !netName = 'net' & !ancilType
  if !ancilType.eq('BORES') then
    !headings = 'No./Bore Size/Active'
    !gridData = !this.bores.sortBores()
    !netDataSource = object NETDATASOURCE(' ', !headings.split('/'), !gridData)
    !this.netBORES.bindToDataSource(!netDataSource)
    -- Hides the third column which contains the active status for bores
    !this.netBORES.setColumnVisibility(3, FALSE)
    !rows = !this.net$!<ancilType>.getcolumn(1)
  else
    !this.ancils.findAncils(!ancilType)
    !gridData = !this.ancils.sortData(!ancilType)
    !headings = 'No./MDS Name/Replacement Name/Description/Active'
    !netDataSource = object NETDATASOURCE(' ', !headings.split('/'), !gridData)
    !this.net$!<ancilType>.bindToDataSource(!netDataSource)
    -- Hides the fifth column which contains the active status for ancillaries
    !this.net$!<ancilType>.setColumnVisibility(5, FALSE)
    !rows = !this.net$!<ancilType>.getcolumn(1)
  endif
  -- Hides the first column which contains the number of the ancillary/bore in its corresponding stored array
  !this.net$!<ancilType>.setColumnVisibility(1, FALSE)
  !this.colourGrid(!ancilType, !rows)
endmethod
-------------------------------------------------------------------------------
-- Description: Colours the specified .net Grid gadget
-------------------------------------------------------------------------------
define method .colourGrid(!ancilType is STRING, !rows is ARRAY)
  if !ancilType.eq('BORES') then
    !colourColumn = 2
    !activeColumn = 3
  else
    !colourColumn = 2
    !activeColumn = 5
  endif
  do !currentRow values !rows
    if !this.net$!<ancilType>.getcell(!currentRow.real(),!activeColumn).boolean() then
      !this.net$!<ancilType>.setCellColor(!currentRow.real(), !colourColumn, 'LIGHTGREEN')
      !this.net$!<ancilType>.setCellToolTip(!currentRow.real(), !colourColumn, 'Active')
    else
      !this.net$!<ancilType>.setCellColor(!currentRow.real(), !colourColumn, 'TOMATO')
      !this.net$!<ancilType>.setCellToolTip(!currentRow.real(), !colourColumn, 'Inactive')
    endif
  enddo
endmethod
-------------------------------------------------------------------------------
-- Description: Updates the 'Active:...' paragraph gadget below the ancillaries grid
-------------------------------------------------------------------------------
define method .updateActiveParaAncils()
  !ancilType = !this.currentTab()
  !numActive = !this.net$!<ancilType>.getcolumn(5).find('TRUE').size()
  !numCurrentAncils = !this.net$!<ancilType>.getNumberRows()
  !this.paActive$!<ancilType>.val = 'Active: ' & !numActive & ' of ' & !numCurrentAncils
endmethod
-------------------------------------------------------------------------------
-- Description: Updates the 'Active:...' paragraph gadget below the bores grid.
-------------------------------------------------------------------------------
define method .updateActiveParaBores()
  !numActive = !this.netBORES.getcolumn(3).find('TRUE').size()
  !numCurrentAncils = !this.netBORES.getNumberRows()
  !this.paActiveBore.val = 'Active: ' & !numActive & ' of ' & !numCurrentAncils
endmethod
-------------------------------------------------------------------------------
-- Description: Controls whether the buttons are shown below the ancillaries grid
--              depending on the number of rows selected in the grid.
--     - if one row is selected the buttons are shown as well as the bores grid
--     - if nothing is selected buttons are greyed out
--     - if all rows are selected the buttons are shown but the bores grid is hidden
--     - if more than one rows are selected the buttons are shown but the bores grid is hidden
-------------------------------------------------------------------------------
define method .afterSelectChange(!data is ARRAY)
  !ancilType = !this.currentTab()
  !this.toSelectAll.val = FALSE
  if !this.net$!<ancilType>.getSelectedRows().size().eq(1) then
    !this.setBores()
    !this.makeActive.active = TRUE
    !this.makeInactive.active = TRUE
  elseif !this.net$!<ancilType>.getSelectedRows().size().eq(0) then
    !this.makeActive.active = FALSE
    !this.makeInactive.active = FALSE
  elseif !this.net$!<ancilType>.getSelectedRows().size().eq(!this.net$!<ancilType>.getNumberRows()) then
    !this.makeActive.active = TRUE
    !this.makeInactive.active = TRUE
    !this.toSelectAll.val = TRUE
    !this.boresFrameChange('HIDE')
  else
    !this.makeActive.active = TRUE
    !this.makeInactive.active = TRUE
    !this.boresFrameChange('HIDE')
  endif
endmethod
-------------------------------------------------------------------------------
-- Description: Controls whether the buttons are shown below the bores grid
--              depending on the number of rows selected in the grid.
--              (similar system to the method above)
-------------------------------------------------------------------------------
define method .afterSelectChangeBores(!data is ARRAY)
  !this.toSelectAllBore.val = FALSE
  if !this.netBORES.getSelectedRows().size().eq(1) then
    !this.makeActiveBore.active = TRUE
    !this.makeInactiveBore.active = TRUE
  elseif !this.netBORES.getSelectedRows().size().eq(0) then
    !this.makeActiveBore.active = FALSE
    !this.makeInactiveBore.active = FALSE
  elseif !this.netBORES.getSelectedRows().size().eq(!this.netBORES.getNumberRows()) then
    !this.makeActiveBore.active = TRUE
    !this.makeInactiveBore.active = TRUE
    !this.toSelectAllBore.val = TRUE
  else
    !this.makeActiveBore.active = TRUE
    !this.makeInactiveBore.active = TRUE
  endif
endmethod
-------------------------------------------------------------------------------
-- Description: Callback for right-clicking on the ancillaries grid.  Shows menu at pointer position.
-------------------------------------------------------------------------------
define method .rightClickGrid(!data is ARRAY)
  !currentContainer = 'co' & !this.currentTab()
  !this.$!<currentContainer>.popup = !this.gridPopup
  !this.$!<currentContainer>.showPopup(!data[0], !data[1])
endmethod
-------------------------------------------------------------------------------
-- Description: Callback for right-clicking on the bores grid.  Shows menu at pointer position.
-------------------------------------------------------------------------------
define method .rightClickGridBores(!data is ARRAY)
  !this.coBORES.popup = !this.gridPopupBores
  !this.coBORES.showPopup(!data[0], !data[1])
endmethod
-------------------------------------------------------------------------------
-- Description: Returns the ancillary type of the currently shown tab (i.e. AC)
-------------------------------------------------------------------------------
define method .currentTab() is STRING
  do !type values !this.ancils.ancilTypes
    !frameName = 'fr' & !type
    if !this.$!<frameName>.visible then
      !tab = !this.$!<frameName>.tag
      break
    endif
  enddo
  if defined(!tab) then
    return !tab
  else
    return !this.ancils.ancilTypes[1]
  endif
endmethod
-------------------------------------------------------------------------------
-- Description: Saves the current grid to excel (for both the ancillaries grid
--              and the bores grid.  Remembers the previous save location in !this.prevSaveLocation
-------------------------------------------------------------------------------
define method .saveToExcel(!gridType is STRING)
  import 'PMLFileBrowser'
  handle ANY
  endhandle
  using namespace 'Aveva.Pdms.Presentation'
  if !gridType.eq('ancils') then
    !ancilType = !this.currentTab()
    !worksheet = !ancilType
  else
    !ancilType = 'BORES'
    !worksheet = !this.paBore.val
  endif
  !browser = object PMLFILEBROWSER('SAVE')
  !browser.show(!this.prevSaveLocation, '$!<worksheet>.xls', 'Save Table to Excel', FALSE, 'Excel Documents|*.xls',1)
  -- Test for no returned file name (i.e. if cancel button is used)
  if (!browser.file().neq('')) then
    !this.prevSaveLocation = !browser.file().replace(|\|, |\///|, -1, 1).before(|///|)
    !this.net$!<ancilType>.saveGridToExcel(!browser.file())
    handle (1000, 0)
      !!alert.warning('Unable to write to file.  File is in use.')
    endhandle
  endif
endmethod
-------------------------------------------------------------------------------
-- Description: Finds the selected rows in the ancillaries grid and stores their
--              changed activated/deactivated status in !this.ancils.changed
-------------------------------------------------------------------------------
define method .activeSwitchAncils(!newStatus is BOOLEAN)
  if !this.writeCheck() then
    !ancilType = !this.currentTab()
    !arrayPos = !this.ancils.ancilTypes.findfirst(!ancilType)
    !selectedRowTags = !this.net$!<ancilType>.getSelectedRowTags()
    !whichRows = ARRAY()
    do !tag values !selectedRowTags
      !row = !this.net$!<ancilType>.getcolumn(1).findfirst(!tag).string()
      !whichRows.append(!row)
      !this.ancils.changed[!arrayPos][!tag.real()] = !newStatus
      !this.net$!<ancilType>.setCellValue(!row.real(), 5, !newStatus.string())
    enddo
    !this.colourGrid(!ancilType, !whichRows)
    !this.updateActiveParaAncils()
  endif
endmethod
-------------------------------------------------------------------------------
-- Description: Finds the selected rows in the bores grid and stores their
--              changed activated/deactivated status in !this.bores.changed
-------------------------------------------------------------------------------
define method .activeSwitchBores(!newStatus is BOOLEAN)
  if !this.writeCheck() then
    !ancilType = !this.currentTab()
    !arrayPos = !this.ancils.ancilTypes.findfirst(!ancilType)
    !ancilRow = !this.net$!<ancilType>.getSelectedRowTags()[1].real()
    !selectedRowTags = !this.netBORES.getSelectedRowTags()
    !boreRows = ARRAY()
    do !tag values !selectedRowTags
      !row = !this.netBORES.getcolumn(1).findfirst(!tag).string()
      !boreRows.append(!row)
      !this.bores.changed[!arrayPos][!ancilRow][!tag.real()] = !newStatus
      !this.netBORES.setCellValue(!row.real(), 3, !newStatus.string())
    enddo
    !this.colourGrid('BORES', !boreRows)
    !this.updateActiveParaBores()
  endif
endmethod
-------------------------------------------------------------------------------
-- Description: Writes changes to the database for all the ancillary and bore
--              absence.
-------------------------------------------------------------------------------
define method .applyChanges()
  !this.ancils.makechangesAncils()
  !this.ancils.changed = ARRAY()
  do !arrayPos indices !this.bores.changed
    do !row indices !this.bores.changed[!arrayPos]
      !currentAncil = !this.ancils.sorted[!arrayPos][!row]
      !this.bores.collectBores(!currentAncil)
      !this.bores.makechangesBores(!arrayPos, !row)
    enddo
  enddo
  !this.bores.changed = ARRAY()
  !this.init()
endmethod
-------------------------------------------------------------------------------
-- Description: Fills the bores grid with the relevant data.
-------------------------------------------------------------------------------
define method .setBores()
  !ancilType = !this.currentTab()
  !arrayPos = !this.ancils.ancilTypes.findfirst(!ancilType)
  !whichRow = !this.net$!<ancilType>.getSelectedRowTags()[1]
  !currentAncil = !this.ancils.sorted[!arrayPos][(!whichRow.real())]
  !this.bores.collectBores(!currentAncil)
  if !this.bores.listAll.size().neq(0) then
    !this.boresFrameChange('SHOW')
    !this.netBORES.cleargrid()
    !this.fillGrid('BORES')
    !this.updateActiveParaBores()
    if defined(!this.bores.changed[!arrayPos][!whichRow.real()]) then
      !rowsString = ARRAY()
      do !row index !this.bores.changed[!arrayPos][!whichRow.real()]
        !this.netBORES.setCellValue(!row, 3, !this.bores.changed[!arrayPos][!whichRow.real()][!row].string())
        !rowsString.append(!row.string())
      enddo
      !this.colourGrid('BORES', !rowsString)
    endif
  else
    !this.boresFrameChange('NONE')
  endif
  !this.paBore.val = !currentAncil.desc
endmethod
-------------------------------------------------------------------------------
-- Description: Uses input variable !switch to control whether the bores grid and
--              associated buttons are shown.
-------------------------------------------------------------------------------
define method .boresFrameChange(!switch is STRING)
  if !switch.eq('SHOW') then
    !this.paBoreNone.visible         = FALSE
    !this.boresFrameInternal.visible = TRUE
    !this.makeActiveBore.active      = TRUE
    !this.makeInactiveBore.active    = TRUE
  elseif !switch.eq('HIDE') then
    !this.paBore.val = ''
    !this.paBoreNone.visible         = TRUE
    !this.boresFrameInternal.visible = FALSE
    !this.makeActiveBore.active      = FALSE
    !this.makeInactiveBore.active    = FALSE
  else
    !this.paBoreNone.visible         = TRUE
    !this.boresFrameInternal.visible = FALSE
    !this.makeActiveBore.active      = FALSE
    !this.makeInactiveBore.active    = FALSE
  endif
  !data = ARRAY()
--  !this.afterSelectChangeBores(!data)
endmethod
-------------------------------------------------------------------------------
-- Description:  Processes the open callback given by the 'Select All' tick boxes
-------------------------------------------------------------------------------
define method .selectAll(!whichFrame is GADGET, !status is STRING)
  if !whichFrame.name().match('BORE').eq(0) then
    !ancilType = !this.currentTab()
  else
    !ancilType = 'BORES'
  endif
 if !status.eq('SELECT') then
   !this.net$!<ancilType>.selectAllRows()
 elseif !this.net$!<ancilType>.getSelectedRows().size().eq(!this.net$!<ancilType>.getNumberRows()) then
   !this.net$!<ancilType>.clearRowSelection()
endif
endmethod
-------------------------------------------------------------------------------
-- Description: Hides the form (and the key form, if open) when executed and if unapplied
--              changes have been made it asks the user whether or not to apply them.
-------------------------------------------------------------------------------
define method .cancelFormMethod()
  if !this.bores.changed.set() or !this.ancils.changed.set() then
  !answer = !!alert.question('Do you wish to apply changes?')
    if !answer.eq('YES') then
      !this.applyChanges()
      !this.hide()
      if defined(!!mdsActiveControlKey) then
        !!mdsActiveControlKey.hide()
      endif
    elseif !answer.eq('NO') then
      !this.ancils.changed = ARRAY()
      !this.bores.changed = ARRAY()
      !this.hide()
      if defined(!!mdsActiveControlKey) then
        !!mdsActiveControlKey.hide()
      endif
    endif
  else
    !this.hide()
    if defined(!!mdsActiveControlKey) then
      !!mdsActiveControlKey.hide()
    endif
  endif
endmethod
-------------------------------------------------------------------------------
-- Description: Checks whether user has database write access
-------------------------------------------------------------------------------
define method .writeCheck() is BOOLEAN

  --<RM> 30/09/09 defect P-25189 changed this so that we navigate to the MDS/MDSAPPDEFAULTS DB before we test write access
  --navigate to atta defaults cata, this should always be present so if it isn't we cant do anything
  /MDS/ATTA/DEFAULTS
  handle(2,109)
    !!alert.warning('The MDS applications defaults database is not present. Changes to the database cannot be performed.')
    !this.applyChanges.active = FALSE
  endhandle
  --<RM> 30/09/09 end of defect P-25189 fix

  !writeFlag = dbwrite
  if !writeFlag.eq(FALSE) then
    !!alert.warning('You do not have write access.  Changes to the database cannot be performed.')
    !this.applyChanges.active = FALSE
  else
    !this.applyChanges.active = TRUE
  endif
  return !writeFlag

endmethod
-------------------------------------------------------------------------------
-- Description: Setup default configuration
-------------------------------------------------------------------------------
define method .config(!type is STRING)
  -- Setup required configuration
  !setup = object MDSDEFAULTSETUP()
  !setup.setup(!type)
  -- Reinitialise form
  !this.init()
endmethod
