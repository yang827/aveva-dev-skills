-- File:    mdsActiveControlKey.pmlfrm
-- Type:    Form Definition
-- Group:   Multi Discipline Supports Application
-- Keyword: MDS
-- Module:  Paragon
-- Author:  Joe Wyatt
-- Created: 13/05/09
--
-- Description: Displays a key to the mdsActiveControl form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  fillNames()                      -
--  mdsActiveControlKey()            -
--
setup form !!mdsActiveControlKey DIALOG DOCK at XR 0.3 YR 0.2

  do !type values !!mdsActiveControl.ancils.anciltypes
    para  .paLetters$!<type>    at x1 ymax anchor L+T text '$!type'         width 5
    para  .paDash$!<type>       at x6 ymin anchor L+T text '-'           width 1
    para  .paName$!<type>       at x8 ymin anchor L+T text 'Ancillaries' width 16
  enddo
-- dummyLine required to make form size correct (it is made invisible in constructor)
    line .dummyLine          at x24 ymax+1  anchor L horizontal       width 1
exit
-------------------------------------------------------------------------------
-- Description: Constructor
-------------------------------------------------------------------------------
define method .mdsActiveControlKey()
--  !this.callback   = '!this.setup()'
  !this.formRevision = ' $Revision$ '
--  !this.initCall     = '!this.init()'
  !this.formTitle    = 'Key to Support Types'
  !this.quitCall     = '!this.hide()'
  !this.dummyLine.visible = FALSE
  !this.fillNames()
endmethod
-------------------------------------------------------------------------------
-- Description: Fills the form with recognised names otherwise it labels them as user defined
-------------------------------------------------------------------------------
define method .fillNames()
  !types = ARRAY()
  !types.append('AC/Ancillary Components')
  !types.append('AN/Anchors')
  !types.append('AT/Ancillaries')
  !types.append('BR/Branch Bracings')
  !types.append('BT/U-Bolts')
  !types.append('CA/Tray Ancillaries')
  !types.append('GT/Guides')
  !types.append('LT/Lugs')
  !types.append('SP/Constant Springs')
  !types.append('ST/Stops')
  !types.append('SU/Slip Units')
  !types.append('RESTS/Rests')
  !types.append('PR/Preliminaries')
  !types.append('TT/Trunnions')

  !types.append('CT/Tray Support Frames')
  !types.append('DT/HVAC Support Frames')
  !types.append('FB/Frame Bracings')
  !types.append('FT/Support Frames')
  !types.append('VT/Vessel Supports')
  !types.append('FH/Fixed Hangers')
  !types.append('VH/Variable Hangers')
  !types.append('REST/Pipe Rests')
  !types.append('ALL/All Support Types')

do !tabType values !!mdsActiveControl.ancils.anciltypes
  do !current values !types
    !currentType = !current.split('/')[1]
    !currentName = !current.split('/')[2]
      if !tabType.eq(!currentType) then
        !this.paName$!<tabType>.val = !currentName
        break
      else
        !this.paName$!<tabType>.val = 'User defined'
      endif
    enddo
  enddo
endmethod
