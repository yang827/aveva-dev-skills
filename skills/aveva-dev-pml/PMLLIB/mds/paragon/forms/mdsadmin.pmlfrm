--
-- File: mdsadmin.pmlfrm
--   Type: Form
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: Design
--   Replaces:
--
-- Author: Michael Board
-- Created:   Wednesday 29th November 2005
--
--
-- Description:
-- Form to show and edit MDS Application Defaults data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  activeHangerInterfacesList()     -
--  allHangerIfacesOff()             BOOLEAN             Return true if all hanger interfaces are disabled
--  cancelFormMethod()               -
--  checkAngleValid(GADGET,STRING)   -
--  checkNumber2to10Valid(GADGET,STRING) -
--  checkNumberValid(GADGET,STRING)  -
--  checkRealValid(GADGET,STRING)    -
--  checkSuppMsValid(GADGET,STRING)  -
--  createMDSHangVFitt()             -
--  defaultHangerInterface()         -
--  init(STRING)                     -
--  mdsAdmin()                       -
--  writeCheck()                     -
--  writeHangerInterfaceToggle(STRING) -                   Sets new value of hanger interface toggle in option array
--  writeIconToggle(REAL)            -
--  writeMdsFrameBracingToggle()     -
--  writeMdsMpuToggle(GADGET,STRING) -
--  writeMdsOriNotToggle()           -
--  writeMdsSpecFlaToggle()          -
--  writeMdsSpeconToggle()           -
--  writeMdsTrunNotesToggle()        -
--  writeMdsUniqueNames()            -
--  writeMdsWeiUnitText()            -
--  writeMdsWeiUnitToggleFalse(GADGET,STRING) -
--  writeMdsWeiUnitToggleOther(GADGET,STRING) -
--  writeMdsWeiUnitToggleTrue(GADGET,STRING) -
--  writeOption(GADGET,STRING)       -
--  writeOption(STRING)              -
--  writeToDatabase()                -
--  writeValue(STRING)               -
--  writeZoneIdAtt(REAL)             -
--  writeZoneIdVal(REAL)             -
--
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
-- DELETE existing FORM definition

kill !!mdsAdmin

----------------------------------------------------------------------

----------------------------------------------------------------------
--
-- M Board 29/11/05

setup form !!mdsAdmin

  !this.initCall = '!this.init(|FORMINIT|)'

  !this.formTitle = 'MDS Admin Data'

  path down

  frame .tabSet TABSET at xmin form

    frame .optionFrame 'Options (1)' at 0 0

      frame .appFrame 'Application Tolerances'

        text .mdsSuppMsText call '!this.writeValue(|mdssuppms|)' tagwid 37 width 13 is STRING
        text .mdsSuppOvText call '!this.writeValue(|mdssuppov|)' tagwid 37 width 13 is STRING
        text .mdsPackDiText call '!this.writeValue(|mdspackdi|)' tagwid 37 width 13 is STRING
        text .mdsPackMoText call '!this.writeValue(|mdspackmo|)' tagwid 37 width 13 is STRING
        text .mdsTrunnLenText call '!this.writeValue(|mdstrunnlen|)' tagwid 37 width 13 is STRING
        !this.mdsTrunnLenText.active = FALSE
        text .mdsSuppClText call '!this.writeValue(|mdssuppcl|)' tagwid 37 width 13 is STRING

      exit

      frame .hangersFrame 'Hangers'
        text .mdsMaxHangText call '!this.writeValue(|mdsmaxhang|)' tagwid 37 width 13 is STRING
        text .mdsMinHangText call '!this.writeValue(|mdsminhang|)' tagwid 37 width 13 is STRING
        text .mdsMaxPivaText call '!this.writeValue(|mdsmaxpiva|)' tagwid 37 width 13 is STRING
        paragraph .pHangersIf text 'Project Hanger Interfaces'
        toggle .mdsHangerIfLISEGAToggle 'Licad' callback '!this.writeHangerInterfaceToggle(|LISEGA|)' at xmax+12 ymin tagwid 9
        toggle .mdsHangerIfPSLToggle 'PSDesigner' callback '!this.writeHangerInterfaceToggle(|PSL|)' at xmin ymax tagwid 9
        toggle .mdsHangerIfCPLToggle 'Witchhanger' callback '!this.writeHangerInterfaceToggle(|CPL|)' at xmin ymax tagwid 9
        toggle .mdsHangerIfMDSToggle 'Standard MDS' callback '!this.writeHangerInterfaceToggle(|MDS|)' at xmin ymax tagwid 9
        option .defaultHangerInterface 'Default Hanger Interface' tagwidth 37 at xmin.pHangersIf ymax callback '!this.defaultHangerInterface()' tagwid 37 width 11

        frame .mdsHangVFittoption 'Interface Hanger Virtual Fittings' at xmax.mdsMaxHangText-35 ymax width 20
          rtoggle .mdsHangVFittEnable 'Enable' tagwid 5
          path right
          rtoggle .mdsHangVFittDisable 'Disable' tagwid 5
        exit

        path down
        text .mdsPivWarnText call '!this.writeValue(|mdspivwarn|)' at xmin.defaultHangerInterface tagwid 37 width 13 is STRING
      exit

      frame .steelworkFrame 'Framework Connection Details'
        text .mdsOffsetText call '!this.writeValue(|mdsoffset|)' tagwid 37 width 13 is STRING
        option .mdsConnsOption call '!this.writeOption(|mdsconns|)' tagwid 37 width 11
        option .mdsConnModsOption call '!this.writeOption(|mdsconnmods|)' tagwid 37 width 11
        option .mdsAutoPadsOption call '!this.writeOption(|mdsautopads|)' tagwid 37 width 11
      exit

    exit

    frame .misctab 'Options (2)' at 0 0

      text .mdsFlaGapText call '!this.writeValue(|mdsflagap|)' tagwid 39 width 13 is STRING

      text .mdsLevChangeText call '!this.writeValue(|mdslevchange|)' tagwid 39 width 13 is STRING

      path down

      text .mdsTranPrefText call '!this.writeValue(|mdstranpref|)' tagwid 39 width 13 is STRING
      text .mdsTrunCodeText call '!this.writeValue(|mdstruncode|)' tagwid 39 width 13 is STRING

      text .mdsWeiTagText call '!this.writeValue(|mdsweitag|)' tagwid 39 width 13 is STRING

      text .mdsSpecPreText call '!this.writeValue(|mdsspecpre|)' tagwid 39 width 13 is STRING

      text .mdsTranIsoText call '!this.writeValue(|mdstraniso|)' tagwid 29 width 23 is STRING

      frame .mdsWeiUnitFrame 'Weight unit' width 40
        rtoggle .mdsWeiUnitToggleTrue '1 (kg)' call '!this.writeMdsWeiUnitToggleTrue('
        path right
        rtoggle .mdsWeiUnitToggleFalse '2.2046 (lbs)' call '!this.writeMdsWeiUnitToggleFalse('
        rtoggle .mdsWeiUnitToggleOther 'Other' call '!this.writeMdsWeiUnitToggleOther('
        text .mdsWeiUnitText call '!this.writeMdsWeiUnitText()' width 6 is STRING
      exit

      path down
      frame .mdsmpuframe 'Dataset code conversion factor' width 40
        rtoggle .mdsmpuToggleTrue 'Metric project' call '!this.writeMdsMpuToggle('
        path right
        rtoggle .mdsmpuToggleFalse 'Imperial project'
      exit
      path down

      toggle .mdsUniqueNames   callback '!this.writeMdsUniqueNames()' 'Unique Support Names'

      toggle .mdsspecflatoggle call '!this.writeMdsSpecFlaToggle()' 'Special Support Number Unique'

      toggle .mdsspecontoggle call '!this.writeMdsSpeconToggle()' 'Special Support Number Checker'

      toggle .mdsorinottoggle call '!this.writeMdsOriNotToggle()' 'Display Orientation in Support Tag on Isometric'

      toggle .mdstrunnotestoggle call '!this.writeMdsTrunNotesToggle()' 'Notes Appear on Isometric Drawings'

      --<wd>11jun2009 - Defect No. P-22109 - Form toggle member added for Framework Bracing
      toggle .mdsFrameBracingToggle call '!this.writeMdsFrameBracingToggle()' 'Display Bracing Members in Isometric MTO'

      path down
    exit

    frame .formsizetab 'Miscellaneous' at 0 0

      frame .formsizeframe 'Form Size Control' height 16

        text .mdsFormAncText  call '!this.writeValue(|mdsformanc|)' tagwid 15 width 8 is STRING
        text .mdsFormBraText  call '!this.writeValue(|mdsformbra|)' tagwid 15 width 8 is STRING
        text .mdsFormCabText  call '!this.writeValue(|mdsformcab|)' tagwid 15 width 8 is STRING
        text .mdsFormFixText  call '!this.writeValue(|mdsformfix|)' tagwid 15 width 8 is STRING
        text .mdsFormFraText  call '!this.writeValue(|mdsformfra|)' tagwid 15 width 8 is STRING
        text .mdsFormGenText  call '!this.writeValue(|mdsformgen|)' tagwid 15 width 8 is STRING
        text .mdsFormGuiText  call '!this.writeValue(|mdsformgui|)' tagwid 15 width 8 is STRING
        text .mdsFormHvaText  call '!this.writeValue(|mdsformhva|)' tagwid 15 width 8 is STRING
        text .mdsFormSliText  call '!this.writeValue(|mdsformsli|)' tagwid 15 width 8 is STRING
        text .mdsFormSprText  call '!this.writeValue(|mdsformspr|)' tagwid 15 width 8 is STRING
        text .mdsFormTruText  call '!this.writeValue(|mdsformtru|)' tagwid 15 width 8 is STRING
        text .mdsFormVesText  call '!this.writeValue(|mdsformves|)' tagwid 15 width 8 is STRING

      exit

      frame .iconframe 'Active Icons' at xmax .formsizeframe ymin.formsizeframe height to max.formsizeframe

        --left side
        toggle .icon1 call '!this.writeIconToggle(1)' tagwid 11
        toggle .icon2 call '!this.writeIconToggle(2)' tagwid 11 at ymax +0.66
        toggle .icon3 call '!this.writeIconToggle(3)' tagwid 11 at ymax +0.66
        toggle .icon4 call '!this.writeIconToggle(4)' tagwid 11 at ymax +0.66
        toggle .icon5 call '!this.writeIconToggle(5)' tagwid 11 at ymax +0.66
        toggle .icon6 call '!this.writeIconToggle(6)' tagwid 11 at ymax +0.66
        toggle .icon7 call '!this.writeIconToggle(7)' tagwid 11 at ymax +0.66
        toggle .icon8 call '!this.writeIconToggle(8)' tagwid 11 at ymax +0.66
        toggle .icon9 call '!this.writeIconToggle(9)' tagwid 11 at ymax +0.66

        --right side
        toggle .icon10 call '!this.writeIconToggle(10)' at xmax .icon1 +3 ymin .icon1 tagwid 10
        toggle .icon11 call '!this.writeIconToggle(11)' tagwid 11 at ymax +0.66
        toggle .icon12 call '!this.writeIconToggle(12)' tagwid 11 at ymax +0.66
        toggle .icon13 call '!this.writeIconToggle(13)' tagwid 11 at ymax +0.66
        toggle .icon14 call '!this.writeIconToggle(14)' tagwid 11 at ymax +0.66
        toggle .icon15 call '!this.writeIconToggle(15)' tagwid 11 at ymax +0.66
        toggle .icon16 call '!this.writeIconToggle(16)' tagwid 11 at ymax +0.66
        toggle .icon17 call '!this.writeIconToggle(17)' tagwid 11 at ymax +0.66

      exit

      frame .zoneframe 'Zone ID' at xmin .formsizeframe ymax .formsizeframe width to max.iconframe

        path right
        para .zoneparaatt at xmin .zoneframe + 15 text 'Attribute'
        para .zoneparaval at xmax .zoneparaatt + 12 text 'Value'

        para .zonepara2 at xmin .zoneframe +1 ymax .zoneparaatt text 'Piping    '
        text .zonetextatt2 at xmin .zoneparaatt call '!this.writeZoneIdAtt(2)' width 15 is STRING
        text .zonetextval2 at xmin .zoneparaval call '!this.writeZoneIdVal(2)' width 15 is STRING

        para .zonepara4 at xmin .zonepara2 ymax .zonepara2 text 'Tray      '
        text .zonetextatt4 at xmin .zoneparaatt call '!this.writeZoneIdAtt(4)' width 15 is STRING
        text .zonetextval4 at xmin .zoneparaval call '!this.writeZoneIdVal(4)' width 15 is STRING

        para .zonepara1 at xmin .zonepara2 ymax .zonepara4 text 'HVAC      '
        text .zonetextatt1 at xmin .zoneparaatt call '!this.writeZoneIdAtt(1)' width 15 is STRING
        text .zonetextval1 at xmin .zoneparaval call '!this.writeZoneIdVal(1)' width 15 is STRING

        para .zonepara3  at xmin .zonepara2 ymax .zonepara1 text 'Supports  '
        text .zonetextatt3 at xmin .zoneparaatt call '!this.writeZoneIdAtt(3)' width 15 is STRING
        text .zonetextval3 at xmin .zoneparaval call '!this.writeZoneIdVal(3)' width 15 is STRING

        para .zonepara5  at xmin .zonepara2 ymax .zonepara3 text 'Hangers  '
        text .zonetextatt5 at xmin .zoneparaatt call '!this.writeZoneIdAtt(5)' width 15 is STRING
        text .zonetextval5 at xmin .zoneparaval call '!this.writeZoneIdVal(5)' width 15 is STRING

      exit
    exit

  exit

  button .apply  'Apply' call '!this.writeToDatabase()' at xmin form ymax form
  path right
  button .dismiss 'Dismiss' call '!this.cancelFormMethod()' at xmax form -size

  member .option is MDSOPTIONDATA
  member .icon is MDSICONDATA
  member .zoneid is MDSZONEIDDATA

  member .modified is BOOLEAN
  member .writeflag is BOOLEAN
  member .vfittevarset is BOOLEAN

exit

-------------------------------------------------------------------------

define method .mdsAdmin()
  --validate calls on text gadgets

  !this.mdsSuppMsText.validatecall = '!this.checkSuppMsValid('
  !this.mdsWeiUnitText.validatecall = '!this.checkRealValid('
  !this.mdsSuppOvText.validatecall = '!this.checkNumberValid('
  !this.mdsPackDiText.validatecall = '!this.checkNumberValid('
  !this.mdsPackMoText.validatecall = '!this.checkNumberValid('
  !this.mdsTrunnLenText.validatecall = '!this.checkNumberValid('
  !this.mdsSuppClText.validatecall = '!this.checkNumberValid('
  !this.mdsMaxHangText.validatecall = '!this.checkAngleValid('
  !this.mdsMinHangText.validatecall = '!this.checkNumberValid('
  !this.mdsMaxPivaText.validatecall = '!this.checkAngleValid('
  !this.mdsPivWarnText.validatecall = '!this.checkAngleValid('
  !this.mdsOffsetText.validatecall = '!this.checkNumberValid('
  !this.mdsFlaGapText.validatecall = '!this.checkNumberValid('
  !this.mdsLevChangeText.validatecall = '!this.checkRealValid('
  !this.mdsTrunCodeText.validatecall = '!this.checkRealValid('
  !this.mdsFormAncText.validatecall = '!this.checkNumber2to10Valid('
  !this.mdsFormBraText.validatecall = '!this.checkNumber2to10Valid('
  !this.mdsFormCabText.validatecall = '!this.checkNumber2to10Valid('
  !this.mdsFormFixText.validatecall = '!this.checkNumber2to10Valid('
  !this.mdsFormFraText.validatecall = '!this.checkNumber2to10Valid('
  !this.mdsFormGenText.validatecall = '!this.checkNumber2to10Valid('
  !this.mdsFormGuiText.validatecall = '!this.checkNumber2to10Valid('
  !this.mdsFormHvaText.validatecall = '!this.checkNumber2to10Valid('
  !this.mdsFormSliText.validatecall = '!this.checkNumber2to10Valid('
  !this.mdsFormSprText.validatecall = '!this.checkNumber2to10Valid('
  !this.mdsFormTruText.validatecall = '!this.checkNumber2to10Valid('
  !this.mdsFormVesText.validatecall = '!this.checkNumber2to10Valid('

  !this.mdsHangVFittoption.callback = '!this.writeOption('
endmethod
-------------------------------------------------------------------

define method .init(!mode is STRING)

  -- If in initialisation mode, go to defaults, put names in list and create
  -- an MDSANCILBORE object for each standard

  if !mode.eq('FORMINIT') then

    !this.modified = FALSE
    --<kp>2012
    !unusedMdsOptions = object DBREF('/MDS/OPTION/DEFAULTS')
    handle ANY
      !!alert.error('/MDS/OPTION/DEFAULTS must exist to modify options')
      return error 1 '' noalert
    endhandle

    !this.writeCheck()

    --Run initialisation of objects to store data in objects

    !this.option.initoptiondata()

    !this.icon.initicondata()

    !unusedTestdbHang = object DBREF('/MDS/ZONEID/DEFAULTS/MDSIDHANG')
    handle any
      !this.zonetextatt5.active = false
      !this.zonetextval5.active = false
    elsehandle none
      !this.zonetextatt5.active = true
      !this.zonetextval5.active = true
    endhandle

    !this.zoneid.initzoneiddata()

    --Descriptions taken from mdsAdmin guide, not from object values
    --which are from DB, which is from DES-SUPP-DEFS (these descriptions
    --not all present)

    !dString = 'Warning\Error\Ignore'
    !rString = 'WARNING\ERROR\IGNORE'

    !dtext = !dString.split('\')
    !rtext = !rString.split('\')

    !this.mdsConnModsOption.tag = 'Modify Support'
    !this.mdsConnModsOption.dtext = !dtext
    !this.mdsConnModsOption.rtext = !rtext

    !temp = !this.option.mdsconnmods[2]
    !this.mdsConnModsOption.select('Rtext',!temp)

    !dString = 'Without Connections\With Connections\With Geometry'
    !rString = '1\2\3'

    !dtext = !dString.split('\')
    !rtext = !rString.split('\')

    !this.mdsConnsOption.tag = 'Create'
    !this.mdsConnsOption.dtext = !dtext
    !this.mdsConnsOption.rtext = !rtext

    !temp = !this.option.mdsConns[2]
    !this.mdsConnsOption.select('Rtext',!temp)

    if !this.option.mpu[2].eq('1') then
      !this.mdsmpuToggleTrue.val = TRUE
    elseif !this.option.mpu[2].eq('25.4') then
      !this.mdsmpuToggleFalse.val = TRUE
    endif
    !uniquenames = !this.option.mdsUniqueNames[2]
    handle ANY
      !uniquenames = false
      !uniquenamesactive = false
    elsehandle NONE
      !uniquenamesactive = true
    endhandle
    !this.mdsUniqueNames.val = !uniquenames
    !this.mdsUniqueNames.active = !uniquenamesactive

    !dString = 'On\Off'
    !rString = 'ON\OFF'

    !dtext = !dString.split('\')
    !rtext = !rString.split('\')

    !this.mdsAutoPadsOption.tag = 'Automatic Pads'
    !this.mdsAutoPadsOption.dtext = !dtext
    !this.mdsAutoPadsOption.rtext = !rtext

    !temp = !this.option.mdsautopads[2]
    !this.mdsAutoPadsOption.select('Rtext',!temp)

    !this.mdsHangerIfLISEGAToggle.val = !this.option.mdsHangIfLisega[2]
    !this.mdsHangerIfPSLToggle.val = !this.option.mdsHangIfPSL[2]
    !this.mdsHangerIfCPLToggle.val = !this.option.mdsHangIfCPL[2]
    !this.mdsHangerIfMDSToggle.val = !this.option.mdsHangIfMDS[2]
    !this.activeHangerInterfacesList()

    if (!this.mdsmpuToggleFalse.val) then
      !!inchFormat = object FORMAT()
      !!inchFormat.dimension   = 'L'
      !!inchFormat.units       = 'INCH'
      !!inchFormat.fraction    = TRUE
      !!inchFormat.denominator = 64
      !!inchFormat.label       = 'in'
      !!inchFormat.inchSeparator = '.'
    endif

    !this.mdsFlaGapText.tag = 'Flange gapping value'
    if (!this.mdsmpuToggleFalse.val) then
      --!inchReal   = object REAL(!this.option.mdsflagap[2] & 'mm',!!inchFormat)
      !inchReal   = object REAL(!this.option.mdsflagap[2],!!inchFormat)
      !inchString = object STRING(!inchReal,!!inchFormat)
      !this.mdsFlaGapText.val = !inchString
    else
      !this.mdsFlaGapText.val = !this.option.mdsflagap[2]
    endif

    !this.mdsFormAncText.tag = 'Anchors'
    !this.mdsFormAncText.val = !this.option.mdsFormanc[2]

    !this.mdsFormBraText.tag = 'Branch reinforcements'
    !this.mdsFormBraText.val = !this.option.mdsFormbra[2]

    !this.mdsFormCabText.tag = 'Cable tray'
    !this.mdsFormCabText.val = !this.option.mdsFormcab[2]

    !this.mdsFormFixText.tag = 'Fixed & variable hangers'
    !this.mdsFormFixText.val = !this.option.mdsFormfix[2]

    !this.mdsFormFraText.tag = 'Frameworks'
    !this.mdsFormFraText.val = !this.option.mdsFormfra[2]

    !this.mdsFormGenText.tag = 'Ancillaries'
    !this.mdsFormGenText.val = !this.option.mdsFormgen[2]

    !this.mdsFormGuiText.tag = 'Guides'
    !this.mdsFormGuiText.val = !this.option.mdsFormgui[2]

    !this.mdsFormHvaText.tag = 'HVAC'
    !this.mdsFormHvaText.val = !this.option.mdsFormhva[2]

    !this.mdsFormSliText.tag = 'Slip units'
    !this.mdsFormSliText.val = !this.option.mdsFormsli[2]

    !this.mdsFormSprText.tag = 'Springs'
    !this.mdsFormSprText.val = !this.option.mdsFormspr[2]

    !this.mdsFormTruText.tag = 'Trunnions'
    !this.mdsFormTruText.val = !this.option.mdsFormtru[2]

    !this.mdsFormVesText.tag = 'Vessel'
    !this.mdsFormVesText.val = !this.option.mdsFormves[2]

    !this.mdsLevChangeText.tag = 'Alternate Representation Level'
    !this.mdsLevChangeText.val = !this.option.mdslevchange[2]

    !this.mdsMaxHangText.tag = 'Max. Horizontal Angle'
    !this.mdsMaxHangText.val = !this.option.mdsMaxHang[2]

    !this.mdsMaxPivaText.tag = 'Max. Pivot Angle'
    !this.mdsMaxPivaText.val = !this.option.mdsmaxpiva[2]

    !this.mdsMinHangText.tag = 'Min. Rod Length'
    if (!this.mdsmpuToggleFalse.val) then
      --!inchReal   = object REAL(!this.option.mdsminhang[2] & 'mm',!!inchFormat)
      !inchReal   = object REAL(!this.option.mdsminhang[2],!!inchFormat)
      !inchString = object STRING(!inchReal,!!inchFormat)
      !this.mdsMinHangText.val = !inchString
    else
      !this.mdsMinHangText.val = !this.option.mdsminhang[2]
    endif

    !this.mdsOffsetText.tag = 'Joint Offset'
    if (!this.mdsmpuToggleFalse.val) then
      --!inchReal   = object REAL(!this.option.mdsoffset[2] & 'mm',!!inchFormat)
      !inchReal   = object REAL(!this.option.mdsoffset[2],!!inchFormat)
      !inchString = object STRING(!inchReal,!!inchFormat)
      !this.mdsOffsetText.val = !inchString
    else
      !this.mdsOffsetText.val = !this.option.mdsoffset[2]
    endif

    !this.mdsPackDiText.tag = 'Max. Packing Dist.'
    if (!this.mdsmpuToggleFalse.val) then
      --!inchReal   = object REAL(!this.option.mdspackdi[2] & 'mm',!!inchFormat)
      !inchReal   = object REAL(!this.option.mdspackdi[2],!!inchFormat)
      !inchString = object STRING(!inchReal,!!inchFormat)
      !this.mdsPackDiText.val = !inchString
    else
      !this.mdsPackDiText.val = !this.option.mdspackdi[2]
    endif

    !this.mdsPackMoText.tag = 'Max. Packing Overlap'
    if (!this.mdsmpuToggleFalse.val) then
      !inchReal   = object REAL(!this.option.mdspackmo[2],!!inchFormat)
      --!inchReal   = object REAL(!this.option.mdspackmo[2] & 'mm',!!inchFormat)
      !inchString = object STRING(!inchReal,!!inchFormat)
      !this.mdsPackMoText.val = !inchString
    else
      !this.mdsPackMoText.val = !this.option.mdspackmo[2]
    endif

    !this.mdsPivWarnText.tag = 'User Warning Angle'
    !this.mdsPivWarnText.val = !this.option.mdspivwarn[2]

    !this.mdsSpecPreText.tag = 'Special Support Number Prefix'
    !this.mdsSpecPreText.val = !this.option.mdsspecpre[2]

    !this.mdsSuppClText.tag = 'Pipe Clearance'
    if (!this.mdsmpuToggleFalse.val) then
      --!inchReal   = object REAL(!this.option.mdssuppcl[2] & 'mm',!!inchFormat)
      !inchReal   = object REAL(!this.option.mdssuppcl[2],!!inchFormat)
      !inchString = object STRING(!inchReal,!!inchFormat)
      !this.mdsSuppClText.val = !inchString
    else
      !this.mdsSuppClText.val = !this.option.mdssuppcl[2]
    endif

    !this.mdsSuppMsText.tag = 'Max. Pipe Slope'
    !this.mdsSuppMsText.val = !this.option.mdssuppms[2]

    !this.mdsSuppOvText.tag = 'Steelwork Overlap'
    if (!this.mdsmpuToggleFalse.val) then
      --!inchReal   = object REAL(!this.option.mdssuppov[2] & 'mm',!!inchFormat)
      !inchReal   = object REAL(!this.option.mdssuppov[2],!!inchFormat)
      !inchString = object STRING(!inchReal,!!inchFormat)
      !this.mdsSuppOvText.val = !inchString
    else
      !this.mdsSuppOvText.val = !this.option.mdssuppov[2]
    endif

    !this.mdsTranIsoText.tag = 'Transport Text'
    !this.mdsTranIsoText.val = !this.option.mdstraniso[2]

    !this.mdsTranPrefText.tag = 'Transport Prefix'
    !this.mdsTranPrefText.val = !this.option.mdstranpref[2]

    !this.mdsTrunCodeText.tag = 'Number of Characters in Trunnion Support Codes Standard'
    !this.mdsTrunCodeText.val = !this.option.mdstruncode[2]

    !this.mdsTrunnLenText.tag = 'Max. Trunnion Length'
    if (!this.mdsmpuToggleFalse.val) then
      --!inchReal   = object REAL(!this.option.mdstrunnlen[2] & 'mm',!!inchFormat)
      !inchReal   = object REAL(!this.option.mdstrunnlen[2],!!inchFormat)
      !inchString = object STRING(!inchReal,!!inchFormat)
      !this.mdsTrunnLenText.val = !inchString
    else
      !this.mdsTrunnLenText.val = !this.option.mdstrunnlen[2]
    endif

    !this.mdsWeiTagText.tag = 'Unit of Weight on Drawings'
    !this.mdsWeiTagText.val = !this.option.mdsweitag[2]

    if !this.option.mdsorinot[2].eq(TRUE) then
      !this.mdsorinottoggle.val = TRUE
    elseif !this.option.mdsorinot[2].eq(FALSE) then
      !this.mdsorinottoggle.val = FALSE
    endif

    if !this.option.mdstrunnotes[2].eq(TRUE) then
      !this.mdstrunnotestoggle.val = TRUE
    elseif !this.option.mdstrunnotes[2].eq(FALSE) then
      !this.mdstrunnotestoggle.val = FALSE
    endif

    if !this.option.mdsWeiUnit[2].eq('1') then
      !this.mdsWeiUnitToggleTrue.val = TRUE
      !this.mdsWeiUnitText.active = FALSE
    elseif !this.option.mdsWeiUnit[2].eq('2.2046') then
      !this.mdsWeiUnitToggleFalse.val = TRUE
      !this.mdsWeiUnitText.active = FALSE
    else
      !this.mdsWeiUnitToggleOther.val = TRUE
      !this.mdsWeiUnitText.active = TRUE
      !this.mdsWeiUnitText.val = !this.option.mdsWeiUnit[2]
    endif

    if !this.option.mdsspecon[2].eq(TRUE) then
      !this.mdsspecontoggle.val = TRUE
    elseif !this.option.mdsspecon[2].eq(FALSE) then
      !this.mdsspecontoggle.val = FALSE
    endif

    if !this.option.mdsspecfla[2].eq(TRUE) then
      !this.mdsspecflatoggle.val = TRUE
    elseif !this.option.mdsspecfla[2].eq(FALSE) then
      !this.mdsspecflatoggle.val = FALSE
    endif

    --Icon section

    do !i index !this.icon.mdsiconname
      !temp1 = '!this.icon' & !i.string() & '.tag'
      $!temp1 = ' ' & !this.icon.mdsiconname[!i]
      !temp2 = '!this.icon' & !i.string() & '.val'
      $!temp2 = !this.icon.mdsiconval[!i]
    enddo

    --<RM> check the !this.zoneid.mdszoneidatt array to make sure there are no elements that appear in the db but not on the form
    --if this is the case skip the form processing for the db element - start
    do !i index !this.zoneid.mdszoneidatt
      !temp2 = '!this.zonetextatt' & !i.string() & '.val'
      $!temp2 = !this.zoneid.mdszoneidatt[!i]
      handle ANY
        !this.zoneid.mdszoneidatt.deleteFrom(!i, 1)
      endhandle
    enddo
    !this.zoneid.mdszoneidatt.compress()
    --<RM> check the !this.zoneid.mdszoneidatt array to make sure there are no elements that appear in the db but not on the form
    --if this is the case skip the form processing for the db element - end

    --Zone ID section

    do !i index !this.zoneid.mdszoneidatt

      !temp2 = '!this.zonetextatt' & !i.string() & '.val'
      !temp3 = '!this.zonetextval' & !i.string() & '.val'
      $!temp2 = !this.zoneid.mdszoneidatt[!i]
      $!temp3 = !this.zoneid.mdszoneidval[!i]

    enddo

    --<wd>20nov2008 - DUN979 - Defect No. P-13392(SI5565) - 'endif' added to match 'if' at line 275
  endif

  --ensure that the new mdshangvfitt option box is greyed out if we are using standard MDS
  !interface = !this.defaultHangerInterface.selection()
  if !interface.neq('MDS') then
    !this.mdsHangVFittoption.active = TRUE
  else
    !this.mdsHangVFittoption.active = FALSE
  endif

  --get the current vfitt option default value and use it to setup the toggle gadgets
  !vfittmode = !this.option.mdsHangVFitt[2]
  handle ANY
    !vfittmode = 'DISABLED'
  endhandle

  if !vfittmode.eq('ENABLED') then
    !this.mdsHangVFittoption.val = 1
  else
    !this.mdsHangVFittoption.val = 2
  endif

  !this.vfittevarset = TRUE

endmethod

----------------------------------------------------------------------
define method .writeValue(!name is STRING)

  !temp1 = '!this.option.' & !name & '[2]'
  !temp2 = '!this.' & !name & 'Text.val'
  $!temp1 = $!temp2


  !this.modified = TRUE

endmethod
------------------------------------------------------------------------
define method .writeOption(!name is STRING)

  !temp1 = '!this.option.' & !name & '[2]'
  !temp2 = '!this.' & !name & 'option.selection()'

  $!temp1 = $!temp2
  !this.modified = TRUE

  --run a check to see if the chosen interface is set up correctly
  if !name.upcase().eq('MDSHANGIF') then
    !interface = $!temp2
    if !interface.neq('MDS') AND !this.vfittevarset eq TRUE then
      !this.mdsHangVFittoption.active = TRUE
    else
      !this.mdsHangVFittoption.active = FALSE
      !this.mdsHangVFittoption.val = 2
      !unusedvfittOption = /MDS/OPTION/DEFAULTS/MDSHANGVFITT
      handle (2, 109)
        return
      elsehandle NONE
        !temp = |'DISABLED'|
        !this.option.mdsHangVFitt[2] = $!temp
      endhandle
    endif
  endif

endmethod
------------------------------------------------------------------------
define method .writeOption(!rtog is GADGET, !event is STRING)

  !tag = !rtog.rtoggle(!rtog.val).tag
  --get the status of the modified flag on entry to writeoption in case we need to exit early because of an error
  !modifiedOnEntry = !this.modified
  !temp1 = '!this.option.mdsHangVFitt' & '[2]'

  if !tag.upcase().eq('ENABLE') then
    !temp2 = |'ENABLED'|
  else
    !temp2 = |'DISABLED'|
  endif

  $!temp1 = $!temp2
  !this.modified = TRUE

  --run a check to see if the chosen interface is set up correctly
  !errorString = ''
  var !mdsHangMacrosEvar evar mdsHangerMacros
  !hangMacrosfile = object FILE(!mdsHangMacrosEvar)
  !hangMacrosFileExists = !hangMacrosfile.exists()
  handle (160,46)
    !errorString = 'The MDShangerMacros environment variable has not yet been defined for the current project, please define the path to the folder that contains hanger connection macros'
  elsehandle NONE
    if !hangMacrosFileExists.not() then
      !errorString = 'The path ' + !mdsHangMacrosEvar + ' does not exist for the defined environment variable MDShangerMacros'
    else
      --check for badly formatted file paths, pdms accepts strings such 'C:\AVEVA\Plant\MDS120~1.sP6\\project\MDS\interface\lif' but the interfaces do not
      if !mdsHangMacrosEvar.match(|\\|).gt(0) or !mdsHangMacrosEvar.match(|//|).gt(0) or !mdsHangMacrosEvar.match(|/\|).gt(0) or !mdsHangMacrosEvar.match(|\/|).gt(0) then
        !errorString = 'The path ' + !mdsHangMacrosEvar + ' is not valid for the manufacturers interface, please remove any double slashes from the evar path MDShangerMacros'
      endif
    endif
  endhandle

  --if errorString is set then there is an error with the hangermacros folder (it doesn't exist or the path cannot be reached
  if !errorString.neq('') then
    if !tag.upcase().eq('DISABLE') then
      --the vfitt entry was previously true but has become corrupted so we must force an update
      !this.modified = TRUE
      return
    endif
    !!alert.warning(!errorString + ' - this OPTION has been reset to Disabled until this issue has been resolved')
    !temp1 = '!this.option.mdsHangVFitt' & '[2]'
    !temp2 = |'DISABLED'|
    $!temp1 = $!temp2
    !rtog.val = 2
    !this.mdsHangVFittoption.active = FALSE
    !this.vfittevarset = FALSE
    if !modifiedOnEntry.eq(FALSE) then
      !this.modified = FALSE
    else
      !this.modified = TRUE
    endif
    return
  endif

  --check that the default value exists. If not do not continue
  !mdsVfittDefault = '/MDS/OPTION/DEFAULTS/MDSHANGVFITT'
  !mdsVfittDefault.dbref()
  handle (2,109)
    --the defaults option does not exist for this OPTION so try to create it silently in the background.
    !this.createMDSHangVFitt()
    handle ANY
      !!alert.error('the defaults option /MDS/OPTION/DEFAULTS/MDSHANGVFITT does not exist and is required to use this OPTION - aborting')
      !temp1 = '!this.option.mdsHangVFitt' & '[2]'
      !temp2 = |'DISABLED'|
      $!temp1 = $!temp2
      !rtog.val = 2
      !this.mdsHangVFittoption.active = FALSE
      !this.vfittevarset = FALSE
      if !modifiedOnEntry.eq(FALSE) then
        !this.modified = FALSE
      else
        !this.modified = TRUE
      endif
      return
    endhandle
  endhandle

endmethod

