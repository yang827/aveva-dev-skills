--------------------------------------------------------------------------
define method .checkNumberValid(!textin is GADGET, !event is STRING)

  !test = object REAL(!textin.val,!!distanceFmt)
  handle ANY
    return error 1 'Value must be a valid distance'
  endhandle
  -- If imperial any real numbers must be converted to inches
  --if (!this.mdsmpuToggleFalse.val) then
  --  !test = !textin.val.real()
  --  handle ANY
  -- Do nothing
  --  elsehandle NONE
  --    !textin.val = !textin.val & 'in'
  --  endhandle
  --endif


endmethod
--------------------------------------------------------------------------
define method .checkAngleValid(!textin is GADGET, !event is STRING)

  !test = object REAL(!textin.val,!!angleFmt)
  handle ANY
    return error 1 'Value must be a valid angle'
  endhandle

endmethod
--------------------------------------------------------------------------
define method .checkRealValid(!textin is GADGET, !event is STRING)

  !test = object REAL(!textin.val,!!realFmt)
  handle ANY
    return error 1 'Value must be a valid real number'
  endhandle
  if (!test.units().isNull().not()) then
    return error 1 'Value must not have any units'
  endif

endmethod
--------------------------------------------------------------------------
define method .checkNumber2to10Valid(!textin is GADGET, !event is STRING)
  !test = object REAL(!textin.val,!!realFmt)
  handle ANY
    return error 1 'Value must be a number'
  elsehandle NONE
    if !textin.val.real().lt(2) OR !textin.val.real().gt(10) then
      return error 1 'Value must be in range 2 to 10'
    endif
  endhandle

endmethod
----------------------------------------------------------------------------
define method .checkSuppMsValid(!textin is GADGET, !event is STRING)
  !test = !textin.val
  !splitArray = !test.split('/')
  if !splitArray.size().neq(2) then
    return error 1 'Enter slope in format 1/30'
  endif
  !top = !splitArray[1].real()
  handle ANY
    return error 1 'Enter slope in format 1/30'
  endhandle
  !bottom = !splitArray[2].real()
  handle ANY
    return error 1 'Enter slope in format 1/30'
  endhandle
  !valueEntered = !top / !bottom
  !maxValue = 1 / 10
  if !valueEntered.gt(!maxValue) then
    return error 1 'Max allowed value 1/10'
  endif

endmethod
-------------------------------------------------------------------------
define method .writeToDatabase()
  --$p writing to database
  --Check modified flag
  if !this.modified.eq(TRUE) then

    !units = object COMUNITS(TRUE)
    if (!!isImperialLength('DIST').not()) then
      UNITS MM DIST
    endif

    if !this.option.mdsWeiUnit[2].eq('') then
      return error 1 'Blank value entered for Weight Unit - Other'
    endif

    do !i values !this.option.arrayofmembernames

      !ref = '!this.option.' & !i & '[3].pproperty'
      !val = '!this.option.' & !i & '[2]'
      if (!i.upcase() inset ('MDSSUPPOV','MDSPACKDI','MDSPACKMO','MDSTRUNNLEN','MDSSUPPCL','MDSMINHANG','MDSOFFSET','MDSFLAGAP')) then
        !valReal = object REAL($!val,!!distanceFmt)
        !valDelim = |( '| & $!valReal & |' )|
      elseif (!i.upcase() inset ('MDSMAXHANG','MDSMAXPIVA','MDSPIVWARN')) then
        !valReal = object REAL($!val,!!angleFmt)
        !valDelim = |( '| & $!valReal & |' )|
      elseif (!i.upcase() inset ('MDSLEVCHANGE','MDSTRUNCODE','MDSFORMANC','MDSFORMBRA','MDSFORMCAB','MDSFORMFIX','MDSFORMFRA','MDSFORMGEN','MDSFORMGUI','MDSFORMHVA','MDSFORMSLI','MDSFORMSPR','MDSFORMTRU','MDSFORMVES','MDSWEIUNIT')) then
        !valReal = object REAL($!val,!!realFmt)
        !valReal=!valReal.value()
        !valDelim = |( '| & $!valReal & |' )|
      elseif (!i.upcase().matchWild ('MDSHANGIF?*')) then
        !valDelim = |( '| & $!val & |' )|
      else
        !valDelim = |( '| & $!val & |' )|
      endif
      $!ref = !valDelim

    enddo

    do !i index !this.icon.icondbref

      !valDelim = |( '| & !this.icon.mdsiconval[!i] & |' )|
      !this.icon.icondbref[!i].pproperty = !valDelim

    enddo

    do !i index !this.zoneid.mdszoneidatt

      !attValDelim = |( '| & !this.zoneid.mdszoneidatt[!i] & |' )|
      !valValDelim = |( '| & !this.zoneid.mdszoneidval[!i] & |' )|

      !this.zoneid.mdszoneidattdbref[!i].pproperty = !attValDelim
      handle any
      endhandle
      !this.zoneid.mdszoneidvaldbref[!i].pproperty = !valValDelim
      handle any
      endhandle

    enddo

    !this.modified = FALSE

    !units.restoreSavedUnitsByPtype('DIST')

  endif

endmethod
--------------------------------------------------------------------------
define method .cancelFormMethod()
  -- $p cancelling form

  !localModifiedFlag = FALSE

  --if modified TRUE flag found, give options in alert

  !modified = !this.modified

  if ($!modified eq TRUE AND !this.writeflag eq TRUE) then
    !localModifiedFlag = TRUE
    !answer = !!alert.question('Do you wish to apply changes?')
    if !answer.eq('YES') then
      !this.writeToDatabase()
      !this.hide()
    elseif !answer.eq('NO') then
      !this.hide()
    elseif !answer.eq('CANCEL') then
    endif
  elseif ($!modified eq TRUE AND !this.writeflag eq FALSE) then
    !localModifiedFlag = TRUE
    !!alert.warning('Changes made on form cannot be applied; you do not have write access')
  endif

  if !localModifiedFlag.eq(FALSE) then
    !this.hide()
  endif

endmethod
---------------------------------------------------------------------------
define method .writeCheck()
  --method to check if user has db write access
  --NB see also kCheckWrite
  --need to check locked as well?
  --see MDSDAC? (Neale)
  !this.writeflag = DBwrite
  if !this.writeflag.eq(FALSE) then
    --no write access
    !!alert.warning('You do not have write access')
    --grey out apply button (as changes cannot be applied to DB)
    !this.apply.active = FALSE
  else
    !this.apply.active = TRUE
  endif

endmethod

---------------------------------------------------------------------
define method .createMDSHangVFitt()

  --first try to create the default with the update datal that should be available in the ...\MDS12.0.sP6\pdmsdata\appdefaultupdates\option\ directory
  var !mdsexe evar 'mds_installed_dir'
  !vfittDatal = !mdsexe + '\pdmsdata\appdefaultupdates\option\MDSHANGVFITT1.pmldat'
  !vfittDatalFile = object FILE(!vfittDatal)
  if !vfittDatalFile.exists() then
    --run the datal to create the appdefaults entry
    /MDS/OPTION/DEFAULTS
    last mem
    markdb
    $m/$!vfittDatalFile
    handle ANY
      undodb 1
      return error 1 noalert
    endhandle
  else
    --the update macro path does not exist for some reason so run a manual input of the catalogue datal
    /MDS/OPTION/DEFAULTS
    last mem
    NEW SECTION /MDS/OPTION/DEFAULTS/MDSHANGVFITT
    DESC 'MDSHANGIF'
    PURP MDS
    GTYP OPTN

    NEW CATEGORY /MDS/OPTION/DEFAULTS/MDSHANGVFITT/CATE
    DESC 'MDSHANGIF'
    FUNC 'OPTION'
    PURP MDS
    GTYP OPTN

    NEW DTSET /MDS/OPTION/DEFAULTS/MDSHANGVFITT/DTSE
    DESC 'MDSHANGIF'
    FUNC 'OPTION'
    GTYP OPTN
    PURP MDS

    NEW DATA /MDS/OPTION/DEFAULTS/MDSHANGVFITT/DATA
    DESC 'If set to TRUE this will generate fitting macros for manufacturers interface hangers'
    DKEY OPTN
    PPRO ( 'DISABLED' )
    PURP MDS
    DTIT 'MDSHANGVFITT'
  endif

  !data = /MDS/OPTION/DEFAULTS/MDSHANGVFITT/DATA
  !this.option.mdsHangVFitt[3] = !data

endmethod
