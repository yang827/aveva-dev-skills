define method .writeMdsUniqueNames()

  !this.option.mdsUniqueNames[2] = !this.mdsUniqueNames.val

  !this.modified = true

endmethod
------------------------------------------------------------------------
--
-- Method:      writeHangerInterfaceToggle
--
-- Description: Sets new value of hanger interface toggle in option array
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#]    [R/RW] [Data Type] [Description]
--   !name   R      STRING      name of hanger interface
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .writeHangerInterfaceToggle(!name is STRING)

  !value = !this.mdsHangerIf$!<name>Toggle.val

  if (!this.allHangerIfacesOff()) then

    !!alert.warning('At least one hanger interface has to be enabled!')
    !this.mdsHangerIf$!<name>Toggle.val = true

  else

    !this.option.mdsHangIf$!<name>[2] = !value
    !this.modified = true

  endif

  !this.activeHangerInterfacesList()

endmethod

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .activeHangerInterfacesList()

  !dtext = ARRAY()
  !rtext = ARRAY()

  if !this.mdsHangerIfLISEGAToggle.val then
    !dtext.append(!this.mdsHangerIfLISEGAToggle.tag)
    !rtext.append('LISEGA')
  endif
  if !this.mdsHangerIfPSLToggle.val then
    !dtext.append(!this.mdsHangerIfPSLToggle.tag)
    !rtext.append('PSL')
  endif
  if !this.mdsHangerIfCPLToggle.val then
    !dtext.append(!this.mdsHangerIfCPLToggle.tag)
    !rtext.append('CPL')
  endif
  if !this.mdsHangerIfMDSToggle.val then
    !dtext.append(!this.mdsHangerIfMDSToggle.tag)
    !rtext.append('MDS')
  endif

  !this.defaultHangerInterface.dtext = !dtext
  !this.defaultHangerInterface.rtext = !rtext

  !index = !rtext.findfirst(!this.option.mdsHangIf[2])
  !this.defaultHangerInterface.val = !index
  handle ANY
    !this.defaultHangerInterface()
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defaultHangerInterface()

  !newval = !this.defaultHangerInterface.string()
  if !newval.neq(!this.option.mdsHangIf[2]) then
    !this.option.mdsHangIf[2] = !this.defaultHangerInterface.string()
    !this.modified = true
  endif

  --ensure that the new mdshangvfitt option box is greyed out if we are using standard MDS
  !interface = !this.defaultHangerInterface.selection()
  if !interface.neq('MDS') then
    !this.mdsHangVFittoption.active = TRUE
  else
    !this.mdsHangVFittoption.active = FALSE
    !callbackstore = !this.mdsHangVFittoption.callback
    !this.mdsHangVFittoption.callback = ''
    !this.mdsHangVFittoption.val = 2
    !temp1 = '!this.option.mdsHangVFitt' & '[2]'
    !temp2 = |'DISABLED'|
    $!temp1 = $!temp2
    !this.mdsHangVFittoption.callback = !callbackstore
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      allHangerIfacesOff
--
-- Description: Return true if all hanger interfaces are disabled
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     Return true if all hanger interfaces are disabled
--
------------------------------------------------------------------------
define method .allHangerIfacesOff() is BOOLEAN

  !names = |LISEGA/PSL/CPL/MDS|

  do !name values !names.split(|/|)

    skip if (!this.mdsHangerIf$!<name>Toggle.val.not())
    return FALSE

  enddo

  return TRUE

endmethod
