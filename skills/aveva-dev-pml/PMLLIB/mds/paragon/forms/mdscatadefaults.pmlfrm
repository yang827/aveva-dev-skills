  !this.converrors.append(|#####################################################################################################|)
  !this.converrors.append(||)
  !this.converrors.append(|<EOF>|)


  -- Write the LOG file
  !this.convlogfile.writefile(|APPEND|,!this.converrors)
  !this.convlogfile.close()
  handle ANY
  endhandle

  -- Issue Message to USER to advise of COMPLETION & LOG file etc..
  !!alert.message(|The MDS12 Application Default Files Conversion into the PARAGON CATA Database has completed.
