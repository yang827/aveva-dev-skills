--
--
-- Description:
-- Form Definition for MDS12.0 Application Defaults Loading Utility in PARAGON
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  cancel()                         -
--  init()                           -
--  upgfiletxt(FORM,STRING,STRING,STRING) BOOLEAN
--
---------------------------------------------------------------------------------------------------
-- MDS APPLICATION PROJECT DEFAULT FILES to be CONVERTED into PARAGON "CATALOGUE" Elements,
-- "DATASETS" etc...
--
-- <1> DES-SUPP-DEFS
-- <2> DES-SUPP-PARS
-- <3> DES-SUPP-HANG
-- <4> DES-SUPP-ALTD
-- <5> DES-SUPP-ID
-- <6> DES-SUPP-ICONS
-- <7> DES-SUPP-MATR
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
--
---------------------------------------------------------------------------------------------------
-- DELETE existing FORM definition
kill !!mdscatadefaults

-- Define form
setup form !!mdscatadefaults

  !this.formtitle  = |Convert Project MDS Defaults Files to Datasets|
  !this.initcall   = |!this.init()|
  !this.cancelcall = |!this.cancel()|

  -- Upgrade Frame
  frame .upgrade | Project MDS Defaults Files | at x0 ymax

    -- Paragraph Gadget for Upgrading DES-SUPP-DEFS
    paragraph .defsfile at xmin+0.25 ymin+0.5 text || width 55 lines 4

    -- Paragraph Gadget for Upgrading DES-SUPP-PARS
    paragraph .parsfile at xmin ymin+2 text || width 55 lines 4

    -- Paragraph Gadget for Upgrading DES-SUPP-HANG
    paragraph .hangfile at xmin ymin+2 text || width 55 lines 4

    -- Paragraph Gadget for Upgrading DES-SUPP-ALTD
    paragraph .altdfile at xmin ymin+2 text || width 55 lines 4

    -- Paragraph Gadget for Upgrading DES-SUPP-ID
    paragraph .idfile at xmin ymin+2 text || width 55 lines 4

    -- Paragraph Gadget for Upgrading DES-SUPP-ICONS
    paragraph .iconfile at xmin ymin+2 text || width 55 lines 4

    --<wd>-26jan2006
    -- Paragraph Gadget for Upgrading DES-SUPP-MATR
    --      paragraph .matrfile at xmin ymin+2 text || width 55 lines 4
    --<wd>-26jan2006

  exit

  -- OK Button
  button .apply  |   OK   | at x0 ymax form+0.5 call |!this.apply()| OK

  -- Cancel Button
  button .cancel | Cancel | at xmax form-10 ymin call |!this.cancel()| cancel

  --------------------------------------
  -- Additional UNDISPLAYED Form Members
  --------------------------------------

  -- Start and Finish Date & Time Strings
  member .sdate is STRING
  member .stime is STRING
  member .xdate is STRING
  member .xtime is STRING

  -- Project Name and Data
  member .project is STRING
  member .mdbname is STRING

  -- MDS Defaults Object member
  --    member .defstocata is MDSDEFSTOCATADB

  -- MDS Defaults File Number
  member .filecount is REAL

  -- MDS Conversion LOG file Messages Array
  member .converrors is ARRAY

  -- MDS Conversion LOG File Object
  member .convlogfile is FILE

  -- Exit form definition
exit

--------------------------------------------------------------------
--------------------------------------------------------------------
--
-- Form Methods are Defined below:
--
--------------------------------------------------------------------
--------------------------------------------------------------------

--------------------------------------------------------------------
--------------------------------------------------------------------

define method .init()
  -- Initialisation Method --
  --
  -------------------------
  -- In the PARAGON module
  -------------------------
  --
  -- Loading the !!mdsdflts FORM will automatically LOAD the PML OBJECT
  -- <MDSFILES>, stored in the PDMS GLOBAL variable *** !!mdsfiles ***,
  -- with the current projects MDS Default FILES
  pml load form !!mdsdflts
  !!mdsdflts.init(||)

  -- Initialise Variable for File count and Reset the .apply gadget active to TRUE
  !this.filecount    = 0
  !this.apply.active = TRUE

  -- ***************************************************
  -- *** IMPORTANT NOTE ***
  -- ***************************************************
  -- ONLY set the !this.apply gadget to ACTIVE = TRUE
  -- when ALL MDS DEFAULT FILE GADGETS are = TRUE
  -- ***************************************************
  -- Set the DES-SUPP-DEFS Default File Paragraph Text
  !defsfile = !this.upgfiletxt(!this, |description|, |DES-SUPP-DEFS|, |.defsfile|)
  if (!defsfile) then
    if (!this.apply.active) then
      !this.apply.active = TRUE
    endif
  else
    !this.apply.active = FALSE
    --    return
  endif

  -- Set the DES-SUPP-PARS Default File Paragraph Text
  !parsfile = !this.upgfiletxt(!this, |dimension|, |DES-SUPP-PARS|, |.parsfile|)
  if (!parsfile) then
    if (!this.apply.active) then
      !this.apply.active = TRUE
    endif
  else
    !this.apply.active = FALSE
    --    return
  endif

  -- Set the DES-SUPP-HANG Default File Paragraph Text
  !hangfile = !this.upgfiletxt(!this, |hangersconfigurations|, |DES-SUPP-HANG|, |.hangfile|)
  if (!hangfile) then
    if (!this.apply.active) then
      !this.apply.active = TRUE
    endif
  else
    !this.apply.active = FALSE
    --    return
  endif

  -- Set the DES-SUPP-ALTD Default File Paragraph Text
  !altdfile = !this.upgfiletxt(!this, |altd|, |DES-SUPP-ALTD|, |.altdfile|)
  if (!altdfile) then
    if (!this.apply.active) then
      !this.apply.active = TRUE
    endif
  else
    !this.apply.active = FALSE
    --    return
  endif

  -- Set the DES-SUPP-ID Default File Paragraph Text
  !idfile = !this.upgfiletxt(!this, |id|, |DES-SUPP-ID|, |.idfile|)
  if (!idfile) then
    if (!this.apply.active) then
      !this.apply.active = TRUE
    endif
  else
    !this.apply.active = FALSE
    --    return
  endif

  -- Set the DES-SUPP-ICONS Default File Paragraph Text
  !iconfile = !this.upgfiletxt(!this, |icons|, |DES-SUPP-ICONS|, |.iconfile|)
  if (!iconfile) then
    if (!this.apply.active) then
      !this.apply.active = TRUE
    endif
  else
    !this.apply.active = FALSE
    --    return
  endif

  --<wd>-26jan2006
  --
  -- *********************************************************************************************
  --  *** IMPORTANT NOTE: The MDS Default File DES-SUPP-MATR is ONLY ever called on the MDS HANGER
  --  ******************* Interface FORM !!mdsVENDOR, which is NOT SHOWN any more in the MDS HANGER
  --                      Interface or Referenced from any where else in the MDS Application etc...
  --                      Therefore the Default File DES-SUPP-MATR is redundant at MDS12 and its DATA
  --                      will NOT be transferred into the MDS12 PARAGON Defaults CATALOGUE DATABASE
  -- ************************************************************************************************

  -- Set the DES-SUPP-MATR Default File Paragraph Text
  --  !matrfile = !this.upgfiletxt(!this, |matr|, |DES-SUPP-MATR|, |.matrfile|)
  --  if (!matrfile) then
  --    !this.apply.active = TRUE
  --  else
  --    !this.apply.active = FALSE
  --    return
  --  endif
  --,
  --<wd>-26jan2006

endmethod

---------------------------------------------------------------------
---------------------------------------------------------------------
define method .upgfiletxt(!dummyForm is FORM, !filetype is STRING, !filename is STRING, !gadget is STRING) is BOOLEAN
  ---------------------------------------------------------------------

  -- Check that the !!mdsfiles object is defined and populated
  if (defined(!!mdsfiles)) then
    !this.filecount = !this.filecount + 1

    -- Determine the !!mdsfiles Object Member, the MDS DEFAULT file NAME
    -- and the Paragraph TEXT gadget name and output text in the gadget.
    !mdsfilestr = |!!mdsfiles.| & !filetype
    !mdsfileobj = $!mdsfilestr
    --    !mdsfilenam = !mdsfileobj.fullname()
    !mdsgadgstr = |!this| & !gadget & |.val|
    --    !mdsfiletyp = !filetype.upcase()
    !mdsactive  = |!this| & !gadget & |.active|

    ---------------------------------------------------------------------
    -- Check ALL the MDS Defaults Files
    if (!mdsfileobj.set()) then

      -- Determine the other Default File variables
      !mdsfilenam = !mdsfileobj.fullname()
      !mdsfiletyp = !filetype.upcase()

      -- Get the Full path Name of the EXISTING MDS Default File
      $!mdsgadgstr = |_____________________________________________________________________
      $!<this.filecount>.  Load the existing $!<mdsfiletyp> Defaults File for the Project,
      i.e.   $!<mdsfilenam>|
      $!mdsactive = TRUE
      return TRUE

    else

      -- Determine the other Default File variables
      !mdsfilenam = !filename
      !mdsfiletyp = !filetype.upcase()

      -- Unable to Proceed with the loading of the MDS12.0 Application Defaults
      $!mdsgadgstr = |_____________________________________________________________________
      $!<this.filecount>.  The Project "$!<mdsfiletyp>" MDS Defaults File "$!<mdsfilenam>" is NOT available.
      *** UNABLE ** to PROCEED with the loading of the MDS12.0 .application Defaults.|
      $!mdsactive = FALSE
      return FALSE

    endif
    -- OK to Proceed with the loading of the MDS12.0 Application Defaults
    return TRUE
    ---------------------------------------------------------------------

  else

    -- Determine the other Default File variables
    !mdsfilenam = !filename
    !mdsfiletyp = !filetype.upcase()

    -- Unable to Proceed with the loading of the MDS12.0 Application Defaults
    $!mdsgadgstr = |_____________________________________________________________________
    $!<this.filecount>.  The Project "$!<mdsfiletyp>" MDS Defaults File "$!<mdsfilenam>" is NOT available.
    *** UNABLE ** to PROCEED with the loading of the MDS12.0 .application Defaults.|
    return FALSE

  endif

endmethod


--------------------------------------------------------------------
--------------------------------------------------------------------
define method .apply()
  --------------------------------------------------------------------

  -- Reset ALL FORM Members etc...
  !this.sdate = ||
  !this.stime = ||

  -- Get the Start DATE & TIME Object Data
  !datetime  = object MDSDATETIMEOBJ()
  !this.sdate = !datetime.datestring
  !this.stime = !datetime.timestring

  -- Determine the Project Code
  !proj = current project
  !code = !proj.code()
  !this.project = !code

  -- Navigate to /* and Check the NAME and TYPE of the PDMS Catalogue Database in PARAGON
  -- *** NOTE ***: "/*" navigates to the FIRST CATA db in the MDB, where as using the word "WORLD"
  --               navigates to the owning "WORLD" element CATA db of the current element in the MDB
  /*
  !dbref = !!ce
  !dbnam = !dbref.dbname.upcase()
  !catadbname = !dbnam

$(
  -- **********************
  -- *** IMPORTANT NOTE ***
  -- **********************
  -- This CODE has been removed so that Clients may use any PDMS CATALOGUE Database where
  -- the PDMS USER has the correct ACCESS rights.
  -- **********************
  --
  -- Check it is the correct MDS DEFAULTS CATALOGUE Database for the current PDMS Project
  -- The CORRECT Database name frmat is: "MDS<project code>/MDSAPPDEFAULTS"
  !catadbname = |MDS| & !code & |/MDSAPPDEFAULTS|
  if (!dbname.eq(!catadbname).not()) then
    !!alert.error(|The PARAGON CATALOGUE database used for LOADIING the MDS Defaults must be named "$!catadbname",
    and be the 1st CATALOGUE database in the current MDB. Aborting the LOADING of the "$!code" project MDS Application Defaults files|)
    handle ANY
    endhandle
    return
  endif
$)

  -- Check the CATA db "/*" is ALLOWED to be MODIFIED
  ---------------------------------------------------
  -- Turn on DAC control variable
  !!mdsdaccontrol(true)
  handle any
  endhandle

  -- Check /* WRITE access
  if(!dbref.dbwrite.not()) then
    !!alert.error(|The current USER does NOT have WRITE access to the CATALOGUE database "$!catadbname".
    Aborting the LOADING of the "$!code" project MDS Application Defaults files|)
    !!mdsdaccontrol(false)
    handle ANY
    endhandle
    return
  endif

  -- Check if /* is LOCKED
  if(!dbref.lock) then
    !!alert.error(|The current CATALOGUE database "$!catadbname" is LOCKED.
    Aborting the LOADING of the "$!code" project MDS Application Defaults files|)
    !!mdsdaccontrol(false)
    handle ANY
    endhandle
    return
  endif

  -- Check Access etc... to the MDS CATALOGUE DEFAULTS Database "$!catadbname""
  -- Check if we can CREATE <a CATA element> below the /* element
  if (!!mdscomclaimdac( /* , |DACCRE|, || ).not()) then
    !!alert.error(!!error.text)
    !!mdsdaccontrol(false)
    handle ANY
    endhandle
    return
  endif



  --<wd>-------------------------------------------------------------------------------------------------
$(
  ---------------------------------------------------------------------
  -- The PML CODE below has been replaced by using the PML function,
  -- (!!mdscomclaimdac( /* , |DACCRE|, || ).not()) -- shown above!!!
  ---------------------------------------------------------------------

  -- Check if /* is Already Claimed
  if(!dbref.lclmh).not()) then
    !!alert.error(|The current CATALOGUE database "$!catadbname" is CLAIMED.
    Aborting the LOADING of the "$!code" project MDS Application Defaults files|)
    !!mdsdaccontrol(false)
    handle any
    endhandle
    return
  endif

  -- Check if DAC QUERY form is loaded and get the status of the DAC -- "ON" or "OFF"
  !checkdacison = !!qryuseracr.dacison
  handle any
    pml load form !!qryuseracr
    !checkdacison = !!qryuseracr.dacison
  endhandle
  -- Check if a CATA can be CREATED when DAC is Switched ON below /*
  if (!checkdacison) then
    !createtest = daccre cata of /*
  endif

$)
  --<wd>-------------------------------------------------------------------------------------------------

  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------
  -- MDS DEFAULT FILES to be CONVERTED into PARAGON "CATALOGUE" Elements -- "DATASETS" etc...
  -- <1> DES-SUPP-DEFS
  -- <2> DES-SUPP-PARS
  -- <3> DES-SUPP-HANG
  -- <4> DES-SUPP-ALTD
  -- <5> DES-SUPP-ID
  -- <6> DES-SUPP-ICONS
  ---------------------------------------------------------------------------------------------------
  -- *** NOT REQUIRED to be CONVERTED -- ***
  -- <7> DES-SUPP-MATR -- This MDS Default File has NOT been CONVERTED into the CATALOGUE DATABASE
  --                      SEE NOTES below at Approximately line 455 in the PML CODE which has been
  --                      COMMENTED OUT! -- <wd>-Friday 20th January 2006 @ 16:30 hrs.
  ---------------------------------------------------------------------------------------------------
  ---------------------------------------------------------------------------------------------------

  -- Initialise Variables
  !project = current project
  !prjcode = !project.code()
  !session = current session
  !user    = !session.user().name
  !this.converrors.clear()

  -- Advise that the MDS Defaults Files for the PDMS Project $!<prjcode> are about to be CONVERTED and UPGRADED for use with version MDS12
  if (!!alert.confirm('The MDS Defaults Files for the PDMS Project $!<prjcode> are about to be CONVERTED and UPGRADED into PARAGON CATALOGUE Database Elements for version MDS12

    *** DO YOU want to CONTINUE with the MDS12 Defaults Files Conversion Upgrade *** ?').eq('NO') ) then

    -- User has ABORTED the MDS12 Defaults Files Conversion and Upgrade
    return

  else
    --------------------------------------------------------------------------------------------------------
    -- User has clicked "YES" and CONFIRMED to Continue with the MDS12 Defaults Files Conversion and Upgrade
    --------------------------------------------------------------------------------------------------------
  endif

  -- Determine the Project INFO directory and the MDS12 Default Files Conversion LOG FILE Storage Directory
  -- Store the LOG file in the %$!<prjcode>INFO% or %PDMSUSER% Directory LOCATION
  !infodir = object FILE(|%$!<prjcode>info%|)
  if (!infodir.exists()) then
    !mds12dir = object FILE(|%$!<prjcode>info%\MDS12-DEFAULTS|)
    if (!mds12dir.exists().not()) then
      syscom |mkdir $!mds12dir|
    endif

  else
    -- ONLY when the MDS PROJECT INFO Directory DOES NOT EXIST, i.e. !infodir
    -- Use the %PDMSUSER% Directory to create the MDS12 Default Files Conversion LOG Storage Directory
    !mds12dir = object FILE(|%pdmsuser%\MDS12-DEFAULTS|)
    if (!mds12dir.exists().not()) then
      syscom |mkdir $!mds12dir|
    endif
  endif

  -- Set the LOG file OBJECT member
  !this.convlogfile = object FILE(|$!<mds12dir>/MDS-DEFAULTS-CONVERSION-to-CATA-DB-$!<this.sdate>-$!<this.stime>.pmllog|)

  -- Write Error Log File Header for the Conversion of the MDS Default Files into
  -- a PDMS PARAGON CATALOGUE Database for the MDS12 Development
  !this.converrors.append(||)
  !this.converrors.append(|#####################################################################################################|)
  !this.converrors.append(|#|)
  !this.converrors.append(|# -- MDS12 Application Default Files Conversion|)
  !this.converrors.append(|# -- into DATASET elements etc... contained within the|)
  !this.converrors.append(|# -- PDMS PARAGON Catalogue Database $!<catadbname>.|)
  !this.converrors.append(|#|)
  !this.converrors.append(|# -- PDMS Project   : $!prjcode |)
  !this.converrors.append(|# -- PARAGON CATA DB: $!catadbname |)
  !this.converrors.append(|# -- Login ID       : $!session.login |)
  !this.converrors.append(|# -- PDMS User      : $!user |)
  !this.converrors.append(|# -- PDMS Process ID: $!session.uniqueid() |)
  !this.converrors.append(|#|)
  !this.converrors.append(|# -- Date           : $!this.sdate |)
  !this.converrors.append(|# -- Time           : $!this.stime |)
  !this.converrors.append(|#|)
  !this.converrors.append(|#####################################################################################################|)
  !this.converrors.append(||)
  !this.converrors.append(||)
  !this.converrors.append(|*****************************************************************************************************|)
  !this.converrors.append(||)

  -- Write the LOG file
  !this.convlogfile.open(|WRITE|)
  !this.convlogfile.writerecord(||)
  !this.convlogfile.close()
  handle ANY
  endhandle

  -- Initialise the PML Object for "12" MDS Defaults Upgrade
  !mdsdefaultsobj = object MDSDEFSTOCATADB()

  -- START Processing this MDS DEFAULT FILE
  !mdsdefsfile = !!mdsfiles.description.fullname()
  !this.converrors.append(||)
  !this.converrors.append(|---------------------------------------------------------------------------------------------------|)
  !this.converrors.append(|______________________________________________________________________|)
  !this.converrors.append(| START Processing the MDS Default File -- DES-SUPP-DEFS |)
  !this.converrors.append(|   i.e. $!<mdsdefsfile> |)
  !this.converrors.append(||)

  $P
  $P*******************************************************************
  clock
  $P *** Processing the MDS Default File -- DES-SUPP-DEFS ***
  $P *** "MDS-APPLICATION-OPTION-DEFAULTS-and-MDS-STANDARD-CLIENT-CODES-and-DESCRIPTIONS etc..." ***
  $P

  -- Load the MDS Application DEFAULTS "!!mdsfiles.description" FILE into a PARAGON Catalogue Database
  -- <1> DES-SUPP-DEFS
  !mdsdefaultsobj.readmdsdefs()

  -- FINISH Processing this MDS DEFAULT FILE
  !this.converrors.append(||)
  !this.converrors.append(|______________________________________________________________________|)
  !this.converrors.append(| FINISH Processing the MDS Default File -- DES-SUPP-DEFS |)
  !this.converrors.append(|   i.e. $!<mdsdefsfile> |)
  !this.converrors.append(||)
  !this.converrors.append(|______________________________________________________________________|)

  ---------------------------------------------------------------------------------------------------

  -- START Processing this MDS DEFAULT FILE
  !mdsdefsfile = !!mdsfiles.dimension.fullname()
  !this.converrors.append(||)
  !this.converrors.append(|---------------------------------------------------------------------------------------------------|)
  !this.converrors.append(|______________________________________________________________________|)
  !this.converrors.append(| START Processing the MDS Default File -- DES-SUPP-PARS |)
  !this.converrors.append(|   i.e. $!<mdsdefsfile> |)
  !this.converrors.append(||)

  $P*******************************************************************
  clock
  $P *** Processing the MDS Default File -- DES-SUPP-PARS ***
  $P *** "MDS-STANDARD-ANCILLARIES-DESIGN-PARAMETERS for each BORE SIZE ***
  $P

  -- Load the MDS Application DEFAULTS "!!mdsfiles.dimension" FILE into a PARAGON Catalogue Database
  -- <2> DES-SUPP-PARS
  !mdsdefaultsobj.readmdspars()

  -- FINISH Processing this MDS DEFAULT FILE
  !this.converrors.append(||)
  !this.converrors.append(|______________________________________________________________________|)
  !this.converrors.append(| FINISH Processing the MDS Default File -- DES-SUPP-PARS |)
  !this.converrors.append(|   i.e. $!<mdsdefsfile> |)
  !this.converrors.append(||)
  !this.converrors.append(|______________________________________________________________________|)

  ---------------------------------------------------------------------------------------------------

  -- START Processing this MDS DEFAULT FILE
  !mdsdefsfile = !!mdsfiles.hangersconfigurations.fullname()
  !this.converrors.append(||)
  !this.converrors.append(|---------------------------------------------------------------------------------------------------|)
  !this.converrors.append(|______________________________________________________________________|)
  !this.converrors.append(| START Processing the MDS Default File -- DES-SUPP-HANG |)
  !this.converrors.append(|   i.e. $!<mdsdefsfile> |)
  !this.converrors.append(||)

  $P*******************************************************************
  clock
  $P *** Processing the MDS Default File -- DES-SUPP-HANG ***
  $P *** "MDS-HANGER-TEMPLATE-DEFAULTS ***
  $P

  -- Load the MDS Application DEFAULTS "!!mdsfiles.hangersconfigurations" FILE into a PARAGON Catalogue Database
  -- <3> DES-SUPP-HANG
  !mdsdefaultsobj.readmdshang()

  -- FINISH Processing this MDS DEFAULT FILE
  !this.converrors.append(||)
  !this.converrors.append(|______________________________________________________________________|)
  !this.converrors.append(| FINISH Processing the MDS Default File -- DES-SUPP-HANG |)
  !this.converrors.append(|   i.e. $!<mdsdefsfile> |)
  !this.converrors.append(||)
  !this.converrors.append(|______________________________________________________________________|)

  ---------------------------------------------------------------------------------------------------

  -- START Processing this MDS DEFAULT FILE
  !mdsdefsfile = !!mdsfiles.altd.fullname()
  !this.converrors.append(||)
  !this.converrors.append(|---------------------------------------------------------------------------------------------------|)
  !this.converrors.append(|______________________________________________________________________|)
  !this.converrors.append(| START Processing the MDS Default File -- DES-SUPP-ALTD |)
  !this.converrors.append(|   i.e. $!<mdsdefsfile> |)
  !this.converrors.append(||)

  $P*******************************************************************
  clock
  $P *** Processing the MDS Default File --DES-SUPP-ALTD ***
  $P *** "MDS-STRUCTURE-TEMPLATE-ALTERNATIVE-CODE-DESCRIPTIONS ***
  $P

  -- Load the MDS Application DEFAULTS "!!mdsfiles.altd" FILE into a PARAGON Catalogue Database
  -- <4> DES-SUPP-ALTD
  !mdsdefaultsobj.readmdsaltd()

  -- FINISH Processing this MDS DEFAULT FILE
  !this.converrors.append(||)
  !this.converrors.append(|______________________________________________________________________|)
  !this.converrors.append(| FINISH Processing the MDS Default File -- DES-SUPP-ALTD |)
  !this.converrors.append(|   i.e. $!<mdsdefsfile> |)
  !this.converrors.append(||)
  !this.converrors.append(|______________________________________________________________________|)

  ---------------------------------------------------------------------------------------------------

  -- START Processing this MDS DEFAULT FILE
  !mdsdefsfile = !!mdsfiles.id.fullname()
  !this.converrors.append(||)
  !this.converrors.append(|---------------------------------------------------------------------------------------------------|)
  !this.converrors.append(|______________________________________________________________________|)
  !this.converrors.append(| START Processing the MDS Default File -- DES-SUPP-ID |)
  !this.converrors.append(|   i.e. $!<mdsdefsfile> |)
  !this.converrors.append(||)

  $P*******************************************************************
  clock
  $P *** Processing the MDS Default File -- DES-SUPP-ID ***
  $P ** "MDS-DESIGN-APPWARE-ID-OPTIONS-DEFAULTS ***
  $P

  -- Load the MDS Application ID DEFAULTS "!!mdsfiles.id" FILE into a PARAGON Catalogue Database
  -- <5> DES-SUPP-ID
  !mdsdefaultsobj.readmdsid()

  -- FINISH Processing this MDS DEFAULT FILE
  !this.converrors.append(||)
  !this.converrors.append(||)
  !this.converrors.append(|______________________________________________________________________|)
  !this.converrors.append(| FINISH Processing the MDS Default File -- DES-SUPP-ID |)
  !this.converrors.append(|   i.e. $!<mdsdefsfile> |)
  !this.converrors.append(||)
  !this.converrors.append(|______________________________________________________________________|)

  ---------------------------------------------------------------------------------------------------

  -- START Processing this MDS DEFAULT FILE
  !mdsdefsfile = !!mdsfiles.icons.fullname()
  !this.converrors.append(||)
  !this.converrors.append(|---------------------------------------------------------------------------------------------------|)
  !this.converrors.append(|______________________________________________________________________|)
  !this.converrors.append(|  START Processing the MDS Default File -- DES-SUPP-ICONS |)
  !this.converrors.append(|    i.e. $!<mdsdefsfile> |)
  !this.converrors.append(||)

  $P*******************************************************************
  clock
  $P *** Processing the MDS Default File -- DES-SUPP-ICONS ***
  $P *** "MDS-DESIGN-APPWARE-ICONS-OPTIONS-DEFAULTS ***
  $P

  -- Load the MDS Application ICONS DEFAULTS "!!mdsfiles.icons" FILE into a PARAGON Catalogue Database
  -- <6> DES-SUPP-ICONS
  !mdsdefaultsobj.readmdsicons()

  -- FINISH Processing this MDS DEFAULT FILE
  !this.converrors.append(||)
  !this.converrors.append(|______________________________________________________________________|)
  !this.converrors.append(|  FINISH Processing the MDS Default File -- DES-SUPP-ICONS |)
  !this.converrors.append(|    i.e. $!<mdsdefsfile> |)

  -- This is the LAST MDS DEFAULT File being Processed so ADD these lines
  !this.converrors.append(||)
  !this.converrors.append(|______________________________________________________________________|)
  !this.converrors.append(|---------------------------------------------------------------------------------------------------|)
  !this.converrors.append(||)

