  clock
  $P*************************...fINISHED******************************************
  $P

  -- Navigate Back to the PARAGON CATALOGUE WORLD Element
  /*

  -- Get the Finish DATE & TIME Object Data
  !xdatetime  = object MDSDATETIMEOBJ()
  !this.xdate = !xdatetime.datestring
  !this.xtime = !xdatetime.timestring

  !this.converrors.append(||)
  !this.converrors.append(|#####################################################################################################|)
  !this.converrors.append(|#|)
  !this.converrors.append(|#|)
  !this.converrors.append(|#    ************************|)
  !this.converrors.append(|#    **** FINISHED ***|)
  !this.converrors.append(|#    ************************|)
  !this.converrors.append(|#|)
  !this.converrors.append(|# -- MDS12 Application Default Files Conversion|)
  !this.converrors.append(|# -- into DATASET elements etc... contained within the|)
  !this.converrors.append(|# -- PDMS PARAGON Catalogue Database $!<catadbname>.|)
  !this.converrors.append(|#|)
  !this.converrors.append(|#|)
  !this.converrors.append(|#    ************************|)
  !this.converrors.append(|#    ***    STARTED at    ***|)
  !this.converrors.append(|#    *** Date: $!<this.sdate> ***|)
  !this.converrors.append(|#    *** Time: $!<this.stime> ***|)
  !this.converrors.append(|#    ************************|)
  !this.converrors.append(|#    ***    FINISHED at   ***|)
  !this.converrors.append(|#    ***  Date: $!<this.xdate>  ***|)
  !this.converrors.append(|#    ***  Time: $!<this.xtime>  ***|)
