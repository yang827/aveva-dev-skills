--
-- File:      mdscompensationmaterials.pmlfrm
-- Type:      Form
-- Group:     Multi Discipline Supports Application
-- Keyword:   MDS
-- Module:    Paragon
-- Replaces:
--
-- Author:    Carl Purseglove
-- Created:   Wednesday 26th June 2013
--
--
-- Description:
-- Form for choosing the possible materials for selection when creating
-- compensating plates.
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add()                            -
--  apply()                          -
--  cancel()                         -
--  changeMat()                      -
--  choices()                        -
--  init()                           -
--  matref()                         -
--  reOrderChoices()                 -
--  reOrderData()                    -
--  remove()                         -
--  selMat()                         -
--

-- Kill existing form definition
kill !!mdscompensationmaterials

-- Define form
setup form !!mdscompensationmaterials

  !this.formtitle  = 'Set Compensation Plate Materials'
  !this.cancelcall = '!this.cancel()'
  !this.initcall = '!this.init()'

  -- Selection Frame
  frame .selframe | Select | at x1 ymax

    -- Numbered list of choices for materials
    list .choices |Choice| at x1 ymax call |!this.selMat()| width 25 length 10

    -- List of Available Materials
    list .matref |Materials| at xmax ymin call |!this.changeMat()| ZeroSelection width 40 length 10

    -- Buttons for adding and removing a choice from the list
    button .add  | Add |   at x1 ymax form+0.5 call |!this.add()|
    button .remove  | Remove |   at xmax.add+1 ymin.add call |!this.remove()|
  exit

  -- Apply Form
  button .apply  | Apply |   at x1 ymax form+0.5 call |!this.apply()|
  -- Dismiss Form
  button .cancel | Dismiss | at xmax form-size ymin call |!this.cancel()| cancel

  -- Index one is always the default material
  member .changedMatrefs is ARRAY

  -- Array is used for storing whether a choice has been added or removed
  member .addRemChoices is ARRAY

exit

--------------------------------------------------------------------
--------------------------------------------------------------------
--
-- Form Methods are Defined below:
--
--------------------------------------------------------------------
--------------------------------------------------------------------
--
--------------------------------------------------------------------
define method .init()
  --------------------------------------------------------------------
  -- Populate Choices Form MDSAPPDEFAULTS
  !this.addRemChoices.clear()
  !this.choices.clear()
  !this.changedMatrefs.clear()
  !this.choices()

  if (!this.choices.rtext[1].dbref().dbwrite eq FALSE) then
    !this.apply.active = FALSE
    !this.add.active = FALSE
    !this.remove.active = FALSE
    !this.matref.active = FALSE
    !!alert.error('You do not have access to modify the compensation material options')
  endif

  -- Always Select the FIRST choice in the list on INITIALISATION
  !this.choices.clearselection()
  !this.choices.select('dtext', 'Default')

  -- Populate Form Material List Array with the available PROPCON Materials
  !this.matref()

  -- Select the chosen material for the currently selected material
  !this.selMat()

endmethod

--------------------------------------------------------------------
define method .choices()
  --------------------------------------------------------------------

  -- Get the list of DATA elements for the choices in the APPDEFAULTS DB
  !materialDefaults = '/MDS/COMPENSATING-PLATES/MATERIAL'
  !matrefData = !!mdsCollectAll('DATA','',!materialDefaults.dbref())

  -- Retrieve the default choice of compensation material
  do !i from 1 to !matrefData.size()
    if (!matrefData[!i].number eq 0) then
      !this.choices.add('Default', !matrefData[!i].name)
      !matrefData.remove(!i)
      break
    endif
  enddo

  -- Add the rest of the choices to the list for selection
  do !i from 1 to !matrefData.size()
    !dtext = 'Material Option ' + !i.string()
    !this.choices.add(!dtext, !matrefData[!i].name)
  enddo

endmethod

--------------------------------------------------------------------
define method .matref()
  --------------------------------------------------------------------

  !currentUnits = !!kgetSetUnits()
  units celsius temp
  units pascal pressure

  -- Initialise variable
  !matexist = false
  !dtext = ARRAY()
  !rtext = ARRAY()

  -- Get all the Materials available in the Propcon Database
  !desc = (desc of /MDS/TEMPLATES )
  handle ANY
    !desc = 'MDS'
  endhandle

  if !desc.eq('Framatome Templates') then
    !sden = !!kcollectallfor('SDEN', ':MdsMts of owner of owner eq |ANCILL|', =0/0)
  else
    !sden = !!kcollectallfor('SDEN', 'sref of owner eq |STD| and pres eq -100000 and temp eq -100000 and pqual of owner eq |MDS|', =0/0)
  endif

  if (defined(!sden) or !sden.size().neq(0)) then
    !bsoli = object BLOCK('!sden[!evalindex].owner.owner')
    !solid = !sden.evaluate(!bsoli)

    !bdesc = object BLOCK('!sden[!evalindex].owner.owner.description')
    !descr = !sden.evaluate(!bdesc)

    !altdesc = object BLOCK('!sden[!evalindex].owner.owner.:MDSMatDesc')
    !altd    = !sden.evaluate(!altdesc)

    !matexist = true
  endif


  -- Load the list with the available materials
  if (!matexist) then

    !order = !descr.sortedindices()

    do !indx values !order
      if !descr[$!indx].neq('') then
        !dtext.append(!descr[!indx])
      else
        !dtext.append(!altd[!indx])
      endif
      !rtext.append(!solid[!indx].string())
    enddo

    !this.matref.dtext = !dtext
    !this.matref.rtext = !rtext

  endif

  !currentUnits.restoreAllSavedUnits()

endmethod

----------------------------------------------------------------------
define method .selMat()
  --------------------------------------------------------------------

  !val = !this.choices.val

  -- if the user has unset the selection then clear the selection
  if ((!val.unset()) OR (!val eq 0)) then
    !this.matref.clearselection()
  else

    !foundMat = FALSE

    -- check whether the material for this choice has been changed before
    !changed = !this.changedMatrefs[!val]
    handle ANY
      -- if it hasnt then get the data dbref from the rtext of the choice list
      !data = !this.choices.rtext[!val].dbref()
      do !i from 1 to !this.matref.rtext.size()
        !mat = !this.matref.rtext[!i].dbref()
        if !data.ppro.match(!mat.name).neq(0) then
          !this.matref.select('rtext', !this.matref.rtext[!i])
          !foundMat = TRUE
        endif
      enddo
    elsehandle NONE
      -- if it has been changed set the selected material to the changed one
      do !i from 1 to !this.matref.rtext.size()
        !mat = !this.matref.rtext[!i].dbref()
        if !changed.match(!mat.name).neq(0) then
          !this.matref.select('rtext', !this.matref.rtext[!i])
          !foundMat = TRUE
        endif
      enddo
    endhandle

    if (!foundMat eq FALSE) then
      !this.matref.clearselection()
    endif
  endif

endmethod

--------------------------------------------------------------------
define method .apply()
  --------------------------------------------------------------------
  -- Check whether any choices have been added or removed
  -- Delete any choices that have been removed
  if (!this.addRemChoices.empty() eq FALSE) then
    !ce = !!ce
    do !i indices !this.addRemChoices
      if (!this.addRemChoices[!i].match('removed').neq(0)) then
        !dbref = !this.addRemChoices[!i].after('removed -').dbref()
        !!ce = !dbref
        own
        delete dtse
      endif
    enddo
    !this.addRemChoices.clear()
    !this.reOrderData()
    !!ce = !ce
    handle ANY
    endhandle
  endif

  -- If there has been no changes then just return
  if (!this.changedMatrefs.empty()) then
    return
  endif

  -- Change the material references on the data elements
  do !i indices !this.changedMatrefs
    !data = !this.choices.rtext[!i].dbref()
    !data.pprop = !this.changedMatrefs[!i]
  enddo

  !this.changedMatrefs.clear()

endmethod

--------------------------------------------------------------------
define method .cancel()
  ------------------------------------------------------------------
  !ce = !!ce

  -- remove any newly added but not applied choices
  do !i indices !this.addRemChoices
    if (!this.addRemChoices[!i].match('added').neq(0)) then
      !dbref = !this.addRemChoices[!i].after('added -').dbref()
      !!ce = !dbref
      own
      delete dtse
      handle ANY
      endhandle
    endif
  enddo

  !this.changedMatrefs.clear()
  !this.addRemChoices.clear()

  !!ce = !ce
endmethod

--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .changeMat()
  ------------------------------------------------------------------------------

  !newMatIndx = !this.matref.val
  !newMat = !this.matref.rtext[!newMatIndx].dbref()
  !newMatPprop = |( '| + !newMat.name + |' )|

  !choiceIndx = !this.choices.val

  --Check that the original value has not been reselected
  !choice = !this.choices.rtext[!choiceIndx].dbref()
  if (!choice.pprop.eqNoCase(!newMatPprop) eq TRUE) then
    !this.changedMatrefs.deleteFrom(!choiceIndx, 1)
  else
    !this.changedMatrefs[!choiceIndx] = !newMatPprop
  endif

endmethod

--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .add()
  ------------------------------------------------------------------------------

  !ce = !!ce
  !newNum = !this.choices.rtext.size()

  !!ce = !this.choices.rtext[!newNum].dbref()
  handle ANY
  elsehandle NONE
    -- Add the new dataset
    !name = '/MDS/COMPENSATING-PLATES/MATERIAL/$!newNum'
    NEW DTSE $!name
    desc 'MAT $!newNum'
    func '$!newNum'
    gtype PANE
    purpose PROP

    -- Add the new data element
    !name = '/MDS/COMPENSATING-PLATES/MATERIAL/$!newNum/MATREF'
    new DATA $!name
    desc 'MAT $!newNum'
    dkey MATR
    pprop ' '
    purpose PROP
    number $!newNum
    dtitle 'Propcon - MDS Material'

    !this.addRemChoices.append('added -$!name')
    -- Add the choice to the list of available choices
    !this.choices.add('Material Option $!newNum', !!ce.name)
    !this.choices.select('dtext', 'Material Option $!newNum')
    !this.selMat()
  endhandle

  !!ce = !ce

endmethod

--------------------------------------------------------------------------------

--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .remove()
  ------------------------------------------------------------------------------
  !ce = !!ce
  !val = !this.choices.val
  -- Make sure that it is not possible to remove the default choice
  if (!val.eq(1)) then
    !!alert.error('Cannot delete the default choice')
    return
  endif

  !rtext = !this.choices.rtext[!val]
  !addRemIndex = 0
  !action = ''
  do !i indices !this.addRemChoices
    if !this.addRemChoices[!i].match(!rtext).neq(0) then
      !action = !this.addRemChoices[!i]
      !addRemIndex = !i
    endif
  enddo
  if !action.match('added').neq(0) then
    -- if the choice has recently been added then just delete the dataset and remove it from the choices
    !dbref = !action.after('added -').dbref()
    !!ce = !dbref
    !this.addRemChoices.deleteFrom(!addRemIndex, 1)
    own
    delete dtse
  else
    -- if the choice has not already been flagged as removed or added, then flag it as removed
    if !addRemIndex.eq(0) then
      !this.addRemChoices.append('removed -$!rtext')
    endif
  endif
  !this.choices.clear(!val)

  !this.changedMatrefs.remove(!val)
  handle ANY
    do !i from (!val + 1) to !this.changedMatrefs.size()
      !this.changedMatrefs[!i-1] = !this.changedMatrefs[!i]
      handle ANY
      endhandle
    enddo
  endhandle

  !this.reOrderChoices()
  !!ce = !ce
  handle ANY
  endhandle
endmethod

--------------------------------------------------------------------------------
--------------------------------------------------------------------

define method .reOrderChoices()
  ------------------------------------------------------------------------------

  !newDtexts = ARRAY()
  do !i indices !this.choices.dtext
    if !i.eq(1) then
      !newDtexts[1] = 'Default'
      skip
    endif
    !num = !i - 1
    !newDtexts[!i] = 'Material Option $!num'
  enddo
  !rtexts = !this.choices.rtext
  !this.choices.dtext = !newDtexts
  !this.choices.rtext = !rtexts

endmethod

--------------------------------------------------------------------------------
--------------------------------------------------------------------

define method .reOrderData()
  ------------------------------------------------------------------------------
  !rtexts = ARRAY()

  do !i indices !this.choices.dtext
    if !i.eq(1) then
      !rtexts[1] = !this.choices.rtext[1]
      skip
    endif

    !rtexts[!i] = !this.choices.rtext[!i]
    !data = !this.choices.rtext[!i].dbref()

    if (!data.badref() eq FALSE) then
      !newNum = !i - 1
      if !data.number neq !newNum then
        !!ce = !data
        num $!newNum
        name /MDS/COMPENSATING-PLATES/MATERIAL/$!newNum/MATREF
        desc 'MAT $!newNum'
        !rtexts[!i] = !!ce.name

        own
        name /MDS/COMPENSATING-PLATES/MATERIAL/$!newNum
        desc 'MAT $!newNum'
        func '$!newNum'
      endif
    endif
  enddo
  !this.choices.rtext = !rtexts

endmethod

