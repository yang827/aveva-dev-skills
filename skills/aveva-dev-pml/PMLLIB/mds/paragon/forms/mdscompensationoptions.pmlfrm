------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  cancel()                         -
--  init()                           -
--  mdsCompensationOptions()         -
--  reset()                          -
--  setprop(STRING)                  -
--

setup form !!mdsCompensationOptions NOQUIT

	frame .gaps 'Gap'
		text .mingap 'Minimum:' tagwidth 14 callback '!this.setprop(''MING'')' width 20 is REAL format !!distanceFmt
		text .maxgap 'Maximum for Plates:' tagwidth 14 at xmin ymax+0.1 callback '!this.setprop(''MAXG'')' width 20 is REAL format !!distanceFmt
		text .maxgapPrfl 'Maximum for Profile:' tagwidth 14 at xmin ymax+0.1 callback '!this.setprop(''MAXP'')' width 20 is REAL format !!distanceFmt
	exit
	frame .thickness 'Plate Thickness' at xmin ymax
		option .thkncalcmethod 'Calculation Method:' tagwidth 14 at xmin.mingap ymax callback '!this.setprop(''THCM'')' width 17.7
		option .accommodate 'Visually Accommodate:' tagwidth 14 at xmin ymax+0.1 callback '!this.setprop(''ATHK'')' width 4
	exit
	frame .rounding 'Rounding' at xmin ymax
		option .roundingmethod 'Calculation Method:' tagwidth 14 at xmin.mingap ymax callback '!this.setprop(''RNDM'')' width 17.7
		text .xrounding 'X-size Value:' tagwidth 14 at xmin ymax+0.1 callback '!this.setprop(''XRND'')' width 20 is REAL format !!distanceFmt
		text .yrounding 'Y-size Value:' tagwidth 14 at xmin ymax+0.1 callback '!this.setprop(''YRND'')' width 20 is REAL format !!distanceFmt
	exit

	button .apply 'Apply' width 5 at xmin form ymax+0.5 callback '!this.apply()' APPLY
	button .dismiss 'Dismiss' width 6 at xmax form -size ymin callback '!this.cancel()'
	button .reset 'Reset' width 6 at xmin-size ymin callback '!this.reset()'

	-- form members
	member .prop is ARRAY
	member .value is ARRAY
	member .data is ARRAY
	member .gadget is ARRAY
	member .modified is BOOLEAN

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsCompensationOptions()

	!this.formtitle = 'MDS Compensation Options'
	!this.initcall = '!this.init()'

	!dflts = object MDSCOMPPLATEDFLTS()
	!rtext = !dflts.methodKey()

	!this.thkncalcmethod.dtext = !dflts.thknMethodDesc()
	!this.thkncalcmethod.rtext = !rtext
	!this.roundingmethod.dtext = !dflts.roundingMethodDesc()
	!this.roundingmethod.rtext = !rtext
	!this.accommodate.dtext = split('On Off')
	!this.accommodate.rtext = split('TRUE FALSE')

	!this.prop = split('MING MAXG MAXP THCM ATHK RNDM XRND YRND')
	!this.gadget[1] = !this.mingap
	!this.gadget[2] = !this.maxgap
	!this.gadget[3] = !this.maxgapPrfl
	!this.gadget[4] = !this.thkncalcmethod
	!this.gadget[5] = !this.accommodate
	!this.gadget[6] = !this.roundingmethod
	!this.gadget[7] = !this.xrounding
	!this.gadget[8] = !this.yrounding

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

	!dtse = object DBREF('/MDS/COMPENSATING-PLATES/OPTIONS/DTSE')
	handle ANY
		return error 1 'DTSE /MDS/COMPENSATING-PLATES/OPTIONS/DTSE does not exist.'
	endhandle

	!value = ARRAY()
	!data = ARRAY()
	!fvalue = 0
	do !c indices !this.prop
		!dkey = !this.prop[!c]
		!fvalue.delete()
		!fvalue = !dtse.fprop.attribute(!dkey)
		if !fvalue.objecttype().eq('REAL') then
			!this.gadget[!c].val = !fvalue
		else
			!rtext = !this.gadget[!c].rtext
			!this.gadget[!c].val = !rtext.findfirst(!fvalue.string())
		endif
		!value.append(!fvalue)
		!data.append(!!mdsCollectAll('DATA','dkey eq ''$!dkey''',!dtse).first())
	enddo

	!this.value = !value
	!this.data = !data
	!this.apply.active = false
	!this.reset.active = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setprop(!prop is STRING)

	!index = !this.prop.findfirst(!prop)
	!oldval = !this.value[!index]
	!gadget = !this.gadget[!index]
	if !oldval.objecttype().eq('REAL') then
		!newval = !gadget.val
		if !newval.unset() then
			!newval = !oldval
		endif
		if !newval.lt(0) then
			!newval = !newval.abs()
		endif
		!gadget.val = !newval
	elseif !prop.eq('ATHK') then
		!newval = !gadget.string().boolean()
	else
		!newval = !gadget.string()
	endif

	!this.value[!index] = !newval
	!this.apply.active = true
	!this.reset.active = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

	do !c indices !this.value
		if !this.value[!c].objecttype().eq('STRING') then
			!this.data[!c].ppro = '( ''' & !this.value[!c] & ''')'
		else
			!this.data[!c].ppro = !this.value[!c].string()
		endif
	enddo

	!this.apply.active = false
	!this.reset.active = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reset()

	if !!alert.confirm('O.K. to reset? You have not applied recent changes you have made.').boolean() then
		!this.init()
	endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cancel()

	if !this.apply.active then
		if !!alert.confirm('O.K. to dismiss? You have not applied recent changes you have made.').boolean().not() then
			return
		endif
	endif

	!this.hide()

endmethod
-- End of method
