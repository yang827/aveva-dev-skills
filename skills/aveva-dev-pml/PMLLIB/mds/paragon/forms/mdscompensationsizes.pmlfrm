------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addEntry(ARRAY,EXPRESSION)       -
--  apply()                          -
--  cancel()                         -
--  defaultExpr()                    -
--  defaultVal()                     -
--  deleteEntry()                    -
--  deleteEntry(ARRAY)               -
--  entry(ARRAY)                     -
--  entrymenu()                      -
--  init()                           -
--  initNew()                        -
--  initNew(ARRAY)                   -
--  mdsCompensationSizes()           -
--  modified()                       BOOLEAN
--  modified(BOOLEAN)                -
--  reset()                          -
--  showPopup(ARRAY)                 -
--  xyprefix()                       STRING
--
import 'GridControl'
handle ANY
endhandle

setup form !!mdsCompensationSizes resizeable

  -- .net library
  using namespace 'Aveva.pdms.presentation'

  frame .tabset TABSET 'tabset' anchor all
    frame .xtab 'X-Size'
      text .defaultExprX 'General Rule' tagwidth 9 anchor t+l+r at xmin+0.5 ymin+0.2 callback '!this.defaultExpr()' width 85 is STRING
      text .defaultValX 'Default Value' tagwidth 9 at xmin ymax+0.1 callback '!this.defaultVal()' width 24 is REAL format !!distanceFmt
      container .xentry PMLNETCONTROL 'NET' at xmin.defaultExprX ymax+0.5  anchor all width 95 heigh 10
    exit
    frame .ytab 'Y-Size'
      text .defaultExprY 'General Rule' tagwidth 9 anchor t+l+r at xmin.defaultExprX ymin.defaultExprX callback '!this.defaultExpr()' width 85 is STRING
      text .defaultValY 'Default Value' tagwidth 9 at xmin ymax+0.1 callback '!this.defaultVal()' width 24 is REAL format !!distanceFmt
      container .yentry PMLNETCONTROL 'NET' at xmin.defaultExprX ymax+0.5 anchor all width 95 heigh 10
    exit
  exit
  button .newEntry 'Add Entry...' linklabel width 7 anchor b+l at xmin ymax+0.1 callback '!this.initNew()'
  button .delEntry 'Remove Entry' linklabel width 9 anchor b+l at xmax+0.4 ymin callback '!this.deleteEntry()'

  -- bottom line
  button .apply 'Apply' width 5 anchor b+l at xmin form ymax+0.5 callback '!this.apply()' APPLY
  button .dismiss 'Dismiss' width 8 anchor b+r at xmax form - size callback '!this.cancel()'
  button .reset 'Reset' width 6 anchor b+r at xmin-size ymin callback '!this.reset()'

  -- form members
  member .xsize is MDSCOMPPLATESIZE
  member .ysize is MDSCOMPPLATESIZE
  member .xref is DBREF
  member .yref is DBREF
  member .xentryControl is NETGRIDCONTROL
  member .yentryControl is NETGRIDCONTROL

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsCompensationSizes()

  !this.initcall = '!this.init()'
  !this.formtitle = 'MDS Compensation Sizes'

  !this.newmenu('xentrymenu','POPUP')
  !this.xentrymenu.callback = '!this.entrymenu()'
  !this.xentrymenu.add('callback','Add Entry...','!this.initNew()','newentry')
  !this.xentrymenu.add('callback','Remove Selected','!this.deleteEntry()','delentry')
  !this.newmenu('yentrymenu','POPUP')
  !this.yentrymenu.callback = '!this.entrymenu()'
  !this.yentrymenu.add('callback','Add Entry...','!this.initNew()','newentry')
  !this.yentrymenu.add('callback','Remove Selected','!this.deleteEntry()','delentry')

  !this.xentry.setpopup(!this.xentrymenu)
  !this.yentry.setpopup(!this.yentrymenu)

  -- create instances of .net control
  using namespace 'Aveva.pdms.presentation'
  !this.xentryControl = object NETGRIDCONTROL()
  !this.xentryControl.addeventhandler('AfterCellUpdate', !this, 'entry')
  !this.xentryControl.addeventhandler('deleteKeyPressed',!this,'deleteEntry')
  !this.xentryControl.addeventhandler('pasteKeyPressed',!this,'initNew')
  !this.xentryControl.addeventhandler('OnPopup',!this,'showPopup')
  !this.xentryControl.splitGrid(false)
  !this.xentryControl.columnExcelFilter(false)
  !this.xentryControl.outlookGroupStyle(false)
  !this.xentryControl.fixedHeaders(false)
  !this.xentryControl.fixedRows(true)
  !this.xentryControl.editableGrid(true)
  !this.xentryControl.headerSort(false)
  !this.xentryControl.singleRowSelection(true)
  !this.xentryControl.columnSummaries(false)
  !this.xentryControl.setlabelvisibility(false)
  !this.xentryControl.rowAddDeleteGrid(false)

  !this.yentryControl = object NETGRIDCONTROL()
  !this.yentryControl.addeventhandler('AfterCellUpdate', !this, 'entry')
  !this.yentryControl.addeventhandler('deleteKeyPressed',!this,'deleteEntry')
  !this.yentryControl.addeventhandler('pasteKeyPressed',!this,'initNew')
  !this.yentryControl.addeventhandler('OnPopup',!this,'showPopup')
  !this.yentryControl.splitGrid(false)
  !this.yentryControl.columnExcelFilter(false)
  !this.yentryControl.outlookGroupStyle(false)
  !this.yentryControl.fixedHeaders(false)
  !this.yentryControl.fixedRows(true)
  !this.yentryControl.editableGrid(true)
  !this.yentryControl.headerSort(false)
  !this.yentryControl.singleRowSelection(true)
  !this.yentryControl.columnSummaries(false)
  !this.yentryControl.setlabelvisibility(false)
  !this.yentryControl.rowAddDeleteGrid(false)

  -- add .net control to PML container for entries
  !this.xentry.control = !this.xentryControl.handle()
  !this.yentry.control = !this.yentryControl.handle()

  -- define header
  !xdataSource = object NETDATASOURCE('Size Table', split('Support Codes\Specific Rule','\'), object ARRAY(),false)
  !this.xentryControl.bindToDataSource(!xdataSource)
  !ydataSource = object NETDATASOURCE('Size Table', split('Support Codes\Specific Rule','\'), object ARRAY(),false)
  !this.yentryControl.bindToDataSource(!ydataSource)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  using namespace  'Aveva.pdms.presentation'

  !xtable = 'SECT /MDS/COMPENSATING-PLATES/X-SIZE'
  !ytable = 'SECT /MDS/COMPENSATING-PLATES/Y-SIZE'
  !this.xsize = object MDSCOMPPLATESIZE(!xtable)
  !this.ysize = object MDSCOMPPLATESIZE(!ytable)
  !this.xref = !xtable.dbref()
  !this.yref = !ytable.dbref()

  !this.defaultExprX.val = !this.xsize.defexpr.string()
  !this.defaultValX.val = !this.xsize.default

  !dataSource = object NETDATASOURCE('X-entry',!this.xentryControl.getTitles(), !this.xsize.rows(), false)
  !this.xentryControl.bindToDataSource(!dataSource)

  !this.defaultExprY.val = !this.ysize.defexpr.string()
  !this.defaultValY.val = !this.ysize.default

  !dataSource = object NETDATASOURCE('Y-entry',!this.yentryControl.getTitles(), !this.ysize.rows(), false)
  !this.yentryControl.bindToDataSource(!dataSource)

  if !this.xref.dbWrite.not() then
    !this.defaultExprX.seteditable(false)
    !this.defaultValX.seteditable(false)
    !this.defaultExprY.seteditable(false)
    !this.defaultValY.seteditable(false)
    !this.xentryControl.editableGrid(false)
    !this.yentryControl.editableGrid(false)
    !this.newEntry.active = false
    !this.delEntry.active = false
  endif

  !this.modified(false)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .entry(!arg is ARRAY)

  !xy = !this.xyprefix()
  !control = !xy & 'ENTRYCONTROL'
  !size = !xy & 'SIZE'

  !row = !arg[0].real()
  !colname = !arg[1]
  !column = !this.attribute(!control).getTitles().findfirst(!colname)

  !newval = !this.attribute(!control).getCell(!row,!column).trim()
  if !column.eq(1) then
    -- Support code
    !oldval = !this.attribute(!size).codes()[!row]
    !this.attribute(!size).setCode(!row,!newval)
    handle ANY
      !!alert.error(!!error.text)
      !newval = !oldval
    endhandle
  else
    -- expression
    !oldval = !this.attribute(!size).expressions()[!row]
    !this.attribute(!size).setExpression(!row,!newval)
    handle ANY
      if !newval.empty() then
        !!alert.error('No expression given.')
      else
        !!alert.error(!!error.text)
      endif
      !newval = !oldval
    endhandle
  endif

  if !newval.neq(!oldval) then
    !this.modified(true)
  endif

  !this.attribute(!control).allGridEvents(false)
  !this.attribute(!control).setCellValue(!row,!column,!newval)
  !this.attribute(!control).allGridEvents(true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defaultExpr()

  !xy = !this.xyprefix()
  !size = !xy & 'SIZE'
  !field = !this.attribute('DEFAULTEXPR' & !xy)
  !oldval = !this.attribute(!size).defexpr.string()
  !newval = !field.val.trim()
  handle ANY
    !newval = ''
  endhandle
  if !newval.empty() then
    !newval = !oldval
  else
    !this.attribute(!size).setExpression(0,!newval)
    handle ANY
      !!alert.error(!!error.text)
      !newval = !oldval
    endhandle
  endif

  if !newval.neq(!oldval) then
    !this.modified(true)
  endif
  !field.val = !newval

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .defaultVal()

  !xy = !this.xyprefix()
  !size = !xy & 'SIZE'
  !field = !this.attribute('DEFAULTVAL' & !xy)
  !oldval = !this.attribute(!size).default
  !newval = !field.val
  if !newval.unset() then
    !newval = !oldval
  elseif !newval.eq(0) then
    !newval = !oldval
  endif

  !newval = !newval.abs()
  !field.val = !newval

  if !newval.neq(!oldval) then
    !this.attribute(!size).default = !newval
    !this.modified(true)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  !washere = !!ce
  !this.xsize.dbWrite(!this.xref)
  !this.ysize.dbWrite(!this.yref)
  !this.modified(false)
  !!ce = !washere
  handle ANY
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .reset()

  if !!alert.confirm('O.k. to reset? You have not applied recent changes you have made.').boolean() then
    !this.init()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cancel()

  if !this.modified() then
    if !!alert.confirm('O.k. to dismiss? You have not applied recent changes you have made.').boolean().not() then
      return
    endif
  endif

  !this.hide()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showPopup(!a is ARRAY)

  !entry = !this.xyprefix() & 'ENTRY'
  if !this.attribute(!entry & 'CONTROL').editableGrid() then
    !this.attribute(!entry).showPopup(!a[0], !a[1] + 2)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .entrymenu()

  !xy = !this.xyprefix()
  !menu = !this.attribute(!xy & 'ENTRYMENU')
  !selected = !this.attribute(!xy & 'ENTRYCONTROL').getSelectedRows().set()
  !menu.setFieldProperty('delentry','visible',!selected)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteEntry(!arg is ARRAY)

  !this.deleteEntry()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteEntry()

  !xy = !this.xyprefix()
  !control = !xy & 'ENTRYCONTROL'
  !size = !xy & 'SIZE'
  !rows = !this.attribute(!control).getSelectedRowTags()
  if !rows.unset() then
    return
  endif
  !row = !rows.first().real()

  if !!alert.confirm('O.k. to remove selected entry?').boolean().not() then
    return
  endif

  !this.attribute(!size).removeEntry(!row)

  -- update grid
  using namespace  'Aveva.pdms.presentation'
  !dataSource = object NETDATASOURCE('Properties',!this.attribute(!control).getTitles(), !this.attribute(!size).rows(), false)
  !this.attribute(!control).bindToDataSource(!dataSource)

  !this.modified(true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initNew(!arg is ARRAY)

  !this.initNew()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initNew()

  !entry = !!fmsys.loadform('mdscompensationsizesentry')
  !entry.setexpr.tag = !this.attribute(!this.xyprefix() & 'TAB').tag & ' Rule'
  !entry.show()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addEntry(!code is ARRAY, !expr is EXPRESSION)

  !xy = !this.xyprefix()
  !control = !xy & 'ENTRYCONTROL'
  !size = !xy & 'SIZE'

  !row[1] = !code.join(' ')
  !row[2] = !expr.string()

  !this.attribute(!size).code.append(!code)
  !this.attribute(!size).expr.append(!expr)

  -- update grid
  using namespace  'Aveva.pdms.presentation'
  !dataSource = object NETDATASOURCE('Properties',!this.attribute(!control).getTitles(), !this.attribute(!size).rows(), false)
  !this.attribute(!control).bindToDataSource(!dataSource)

  !this.modified(true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .xyprefix() is STRING

  if !this.xentry.visible.or(!this.shown().not()) then
    return 'X'
  else
    return 'Y'
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modified(!onoff is BOOLEAN)

  !this.apply.active = !onoff
  !this.reset.active = !onoff

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modified() is BOOLEAN

  return !this.apply.active

endmethod
-- End of method
