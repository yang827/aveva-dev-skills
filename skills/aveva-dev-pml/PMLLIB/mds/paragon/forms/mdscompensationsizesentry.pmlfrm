------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -
--  code()                           -
--  expr()                           -
--  init()                           -
--  mdsCompensationSizesEntry()      -                   Constructor
--  ok()                             -
--  setok()                          -
--  validateExpr()                   -
--

setup form !!mdsCompensationSizesEntry resize

  text .setcode 'Support Codes' tagwidth 10 anchor t+l+r callback '!this.code()' width 60 is STRING
  text .setexpr  tagwidth 10 anchor t+l+r at xmin ymax+0.1 callback '!this.expr()' width 60 is STRING

  button .ok 'OK' width 4at xmin ymax+0.2 anchor b+l callback '!this.ok()' OK
  button .cancel 'Cancel' anchor b+r at xmax form-size ymin callback '!this.cancel()' CANCEL

  -- form members
  member .code is ARRAY
  member .expr is EXPRESSION
  member .owner is FORM

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      mdsCompensationSizesEntry
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsCompensationSizesEntry()

  !this.formtitle = 'Add Entry'
  !this.initcall = '!this.init()'
  !this.setexpr.validatecall = '!this.validateExpr()'

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  !this.code.clear()
  !this.expr = object EXPRESSION()

  !this.setcode.val = STRING()
  !this.setexpr.val = STRING()
  !this.setok()

  !this.owner = !!mdsCompensationSizes
  !this.owner.setactive(false)
  !this.owner.tabset.active = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .code()

  !oldcode = !this.code.join(' ')
  if !oldcode.empty() then
    !oldcode = STRING()
  endif

  !code = !this.setcode.val
  if !code.unset() then
    !code = ''
  endif

  if !code.empty() then
    !this.setcode.val = !oldcode
  else
    !this.code = !code.split()
    !this.setcode.val = !this.code.join(' ')
  endif

  !this.setok()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .expr()

  !oldval = !this.expr.string()
  if !oldval.empty() then
    !oldval = STRING()
  endif

  !expr = !this.setexpr.val
  if !expr.unset() then
    !expr = ''
  endif

  if !expr.empty() then
    !this.setexpr.val = !oldval
  else
    !this.expr = !this.owner.xsize.expression(!expr)
    !this.setexpr.val = !expr
  endif

  !this.setok()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateExpr()

  !expr = !this.setexpr.val
  if !expr.unset() then
    return
  endif
  if !expr.trim().empty() then
    return
  else
    !this.owner.xsize.expression(!expr)
    handle ANY
      !this.ok.active = false
      return error
    endhandle
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .ok()

  !this.owner.addEntry(!this.code, !this.expr)

  !this.cancel()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cancel()

  !this.owner.setactive(true)
  !this.owner.tabset.active = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setok()

  !this.ok.active = !this.code.set().and(!this.expr.set())

endmethod
-- End of method
