------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addce()                          -
--  apply()                          -
--  cancel()                         -
--  checkExpression(GADGET,STRING)   -
--  createData()                     -
--  gridlist()                       ARRAY
--  gridlist(ARRAY)                  -
--  init()                           -
--  mdsConfigGriddata()              -
--  originname()                     -
--  remove()                         -
--  remove(ARRAY)                    -
--  select(ARRAY)                    -
--  showPopup(ARRAY)                 -
--  supportorigin()                  -
--

setup form !!mdsConfigGriddata resizeable

  -- .net library
  import 'GridControl'
  handle ANY
  endhandle
  using namespace 'Aveva.pdms.presentation'

  frame .tagpatterns 'Gridline Tag Patterns' anchor l+r+t
    text .gridlntag 'GRDLN Tag:' tagwidth 9 anchor l+r callback '!this.checkExpression(' width 35 is STRING
    text .sctntag 'SCTN Tag:' tagwidth 9 anchor l+r at xmin ymax callback '!this.checkExpression(' width 35 is STRING
  exit
  frame .supportoriginframe 'Support Coordinates Origin' at xmin ymax anchor l+r+t
    option .supportorigin callback '!this.supportorigin()' width 10.6
    text .originname anchor l+r at xmax+0.1 ymin callback '!this.originname()' width 30 is STRING
  exit
  frame .gridlistframe 'List of Valid Grids' at xmin ymax anchor all
    container .gridlist pmlnetcontrol 'NET' anchor all width 45 height 8
    button .addce 'Add CE' linklabel at xmin ymax anchor l+b width 6 callback '!this.addce()'
    button .remove 'Remove Selected' linklabel anchor l+b width 12 callback '!this.remove()'
  exit

  button .apply 'Apply' at xmin ymax+0.2 anchor l+b callback '!this.apply()'
  button .dismiss 'Dismiss' at xmax form-size ymin anchor r+b callback '!this.cancel()'

  -- members
  member .origin is STRING
  member .gridlntagexpr is EXPRESSION
  member .sctntagexpr is EXPRESSION
  member .gridlistcontrol is NETGRIDCONTROL
  member .gendtse is DBREF
  member .gridlistdtse is DBREF

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mdsConfigGriddata()

  !this.initcall = '!this.init()'
  !this.quitcall = '!this.cancel()'
  !this.supportorigin.dtext = split('Matching Grid/Zone/Site/World/Named Item','/')
  !this.supportorigin.rtext = split('GRID ZONE SITE WORL NAME')

  -- popup menu
  !this.newmenu('gridlistmenu','POPUP')
  !this.gridlistmenu.add('callback','Add CE','!this.addce()','addce')
  !this.gridlistmenu.add('callback','Remove Selected','!this.remove()','remove')
  !this.gridlist.setpopup(!this.gridlistmenu)

  -- create instance of .net control
  using namespace 'Aveva.pdms.presentation'
  !this.gridlistcontrol = object NETGRIDCONTROL()

  -- add PML event handlers to .net control
  !this.gridlistcontrol.addeventhandler('AfterSelectChange',!this,'select')
  !this.gridlistcontrol.addeventhandler('OnPopup',!this,'showPopup')
  !this.gridlistcontrol.addeventhandler('DeleteKeyPressed',!this,'remove')
  !this.gridlistcontrol.splitGrid(false)
  !this.gridlistcontrol.columnExcelFilter(false)
  !this.gridlistcontrol.outlookGroupStyle(false)
  !this.gridlistcontrol.fixedHeaders(false)
  !this.gridlistcontrol.fixedRows(false)
  !this.gridlistcontrol.editableGrid(false)
  !this.gridlistcontrol.headerSort(true)
  !this.gridlistcontrol.singleRowSelection(false)
  !this.gridlistcontrol.columnSummaries(false)
  !this.gridlistcontrol.setlabelvisibility(false)

  -- add .net control to PML container for entries
  !this.gridlist.control = !this.gridlistcontrol.handle()

  -- define header
  !dataSource = object NETDATASOURCE('Gridlist', split('Name Description'), object ARRAY(),false)
  !this.gridlistcontrol.bindToDataSource(!dataSource)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

  -- defaults
  !this.gridlntagexpr = object EXPRESSION('( GRDID )')
  !this.sctntagexpr = object EXPRESSION('( DESC )')
  !this.origin = 'GRID'
  !gridlist = ARRAY()

  !this.apply.active = false
  !this.formtitle = 'MDS ABA Grid Data'

  -- get datasets if exist
  !gendtse = object DBREF('/MDS/ABAGRIDDATA/DEFAULTS/GEN/DTSE')
  handle ANY
    !gendtse = nulref
  endhandle
  !gridlistdtse = object DBREF('/MDS/ABAGRIDDATA/DEFAULTS/GRIDS/DTSE')
  handle ANY
    !gridlistdtse = nulref
  endhandle
  !this.gendtse = !gendtse
  !this.gridlistdtse = !gridlistdtse

  -- load data from datasets
  if !gendtse.set() then
    !this.origin = !gendtse.prop.orig
    handle ANY
    endhandle
    !tagexpr = object EXPRESSION(!gendtse.prop.grdl)
    handle NONE
      !this.gridlntagexpr = !tagexpr
    elsehandle ANY
    endhandle
    !tagexpr = object EXPRESSION(!gendtse.prop.sctn)
    handle NONE
      !this.sctntagexpr = !tagexpr
    elsehandle ANY
    endhandle
  else
    !this.formtitle = !this.formtitle & ' (Not created yet)'
    !this.apply.active = true
  endif

  if !gridlistdtse.set() then
    do !data values !gridlistdtse.memb
      skip if !data.type.neq('DATA')
      !gridname = !data.ppro.after('ID').before(')').trim()
      skip if !gridname.empty()
      skip if !gridname.match('/').neq(1)
      !gridlist.append(!gridname)
    enddo
  endif

  -- present data
  !this.gridlntag.val = !this.gridlntagexpr.string()
  !this.sctntag.val = !this.sctntagexpr.string()
  !this.supportorigin.val = !this.supportorigin.rtext.findfirst(!this.origin)
  handle ANY
    !this.supportorigin.val = !this.supportorigin.rtext.findfirst('NAME')
    !this.originname.val = !this.origin
  endhandle
  !this.originname.visible = !this.supportorigin.string().eq('NAME')

  !this.gridlist(!gridlist)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridlist(!gridlist is ARRAY)

  using namespace 'Aveva.pdms.presentation'

  !rows = ARRAY()
  do !grid values !gridlist
    !row[1] = !grid
    !row[2] = !grid.dbref().desc
    handle ANY
      !row[2] = ''
    endhandle
    !rows.append(!row)
  enddo
  !rows.append(split('.','.'))

  !dataSource = object NETDATASOURCE('Gridlist',!this.gridlistcontrol.getTitles(), !rows, false)
  !this.gridlistcontrol.bindToDataSource(!dataSource)
  !lastrow[1] = !gridlist.size() + 1
  !this.gridlistcontrol.deleteRows(!lastrow)

  !rows.clear()
  !this.select(!rows)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .gridlist() is ARRAY

  !gridlist = ARRAY()
  !rows = !this.gridlistcontrol.getRows()
  do !row values !rows
    !gridlist.append(!row[1])
  enddo

  return !gridlist

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkExpression(!field is GADGET, !dummySignal is STRING)

  !attr = !field.name() & 'EXPR'
  !oldexpr = !this.attribute(!attr)
  !expr = object EXPRESSION(!field.val.trim())
  handle ANY
    !expr = !oldexpr
    !!alert.error(!!error.text)
  elsehandle NONE
    if !expr.valid().not() then
      !expr = !oldexpr
      !!alert.error('Invalid expression')
    else
      if !expr.evaluate(world).objecttype().neq('STRING') then
        !expr = !oldexpr
        !!alert.error('STRING expression expected!')
      endif
    endif
  endhandle

  !field.val = !expr.string()
  !this.attribute(!attr) = !expr

  !this.apply.active = !expr.string()neq(!oldexpr.string())

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showPopup(!a is ARRAY)

  !this.gridlist.showPopup(!a[0], !a[1] + 2)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addce()

  !grid = GRIDSYS
  handle ANY
    !grid = FRMW
    handle ANY
      !grid = STRU
      handle ANY
        !!alert.error(|Selected item is not a valid grid system. only GRIDSYS, STRU, and FRMW grid heirarchies with a purpose of 'GRID' are valid.|)
        return
      endhandle
    endhandle
  endhandle

  !purp = 'GRID'
  if !grid.type.eq('STRU') then
    !purp = !grid.purp
  elseif !grid.type.eq('FRMW') then
    !purp = !grid.purp
    if !purp.neq('GRID') then
      !purp = !grid.owne.purp
    endif
  endif

  if !purp.neq('GRID') then
    !!alert.error(|Selected item is not a valid grid system. only GRIDSYS, STRU, and FRMW grid heirarchies with a purpose of 'GRID' are valid.|)
    return
  endif

  !gridlist = !this.gridlist()
  if !gridlist.find(!grid.name).set() then
    !!alert.error(!grid.namtyp & ' is in the list already!')
    return
  endif

  !row[1] = !grid.name
  !row[2] = !grid.desc
  !this.gridlistcontrol.addRow(!row)

  !this.apply.active = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remove()

  !rows = !this.gridlistcontrol.getSelectedRows()
  if !rows.unset() then
    return
  endif

  if !!alert.confirm('OK to remove selected row(s)?').boolean().not() then
    return
  endif

  !this.gridlistcontrol.deleteSelectedRows()
  !this.apply.active = true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remove(!a is ARRAY)

  !this.remove()

endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .select(!rows is ARRAY)

  !rows = !this.gridlistcontrol.getSelectedRows()
  !this.remove.active = !rows.set()
  !this.gridlistmenu.setfieldproperty('remove','ACTIVE',!rows.set())

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .supportorigin()

  !oldorig = !this.origin
  !orig = !this.supportorigin.string()
  if !orig.eq('NAME') then
    !this.origin = !this.originname.val
  else
    !this.origin = !orig
  endif
  !this.originname.visible = !orig.eq('NAME')

  !this.apply.active = !orig.neq(!oldorig)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .originname()

  !name = !this.originname.val.trim().replace(' ','')
  if !name.empty().or(!name.eq('/')) then
    !this.originname.val = !this.origin
    return
  endif

  if !name.match('/').neq(1) then
    !name = '/' & !name
  endif
  !name.dbref()
  handle ANY
    if !!alert.confirm('Item ' & !name & ' doesn''t exist. Do you wish to use it?').boolean().not() then
      !this.originname.val = !this.origin
      return
    endif
  endhandle

  !this.apply.active = !this.origin.neq(!name)
  !this.origin = !name
  !this.originname.val = !name


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  if !this.origin.empty() then
    !!alert.error('Name of the origin is not set')
    return
  endif

  !old = !!ce
  if !this.gendtse.badref() then
    if !!alert.confirm('Data structure does not exist in catalogue DB. Do you want it to be created?').boolean().not() then
      return
    endif
    !this.createData()
    handle ANY
      !!alert.error(!!error.text)
      return
    endhandle
  endif

  do !data values !this.gendtse.memb
    if !data.dkey.eq('ORIG') then
      !ppro = !this.origin
    elseif !data.dkey.eq('SCTN') then
      !ppro = !this.sctntagexpr.string()
    elseif !data.dkey.eq('GRDL') then
      !ppro = !this.gridlntagexpr.string()
    endif
    !ppro = !ppro.replace('''','''''')
    !!ce = !data
    ppro '$!ppro'
  enddo

  !gridlist = !this.gridlist()
  !!ce = !this.gridlistdtse
  do !c indices !gridlist
    !!ce = !this.gridlistdtse.memb[!c]
    handle ANY
      new DATA
    elsehandle NONE
      unname
    endhandle
    !!ce.name = !!ce.owne.owne.name & '/' & !c
    !!ce.ppro = !gridlist[!c]
  enddo

  -- remove redundant DATA items
  !gridsize = !gridlist.size() + 1
  do !c from !gridsize
    !!ce = !this.gridlistdtse.memb[!c]
    handle ANY
      break
    endhandle
    delete DATA
  enddo

  !this.apply.active = false

  !!ce = !old
  handle ANY
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createData()

  new CATA /MDS/ABAGRIDDATA/DEFAULTS
  desc 'MDS ABA Grid data configuration'
  purp MDS

  new SECT /MDS/ABAGRIDDATA/DEFAULTS/GEN
  desc 'General Settings'
  purp MDS
  new DTSE /MDS/ABAGRIDDATA/DEFAULTS/GEN/DTSE
  !this.gendtse = !!ce
  new DATA /MDS/ABAGRIDDATA/DEFAULTS/GEN/ORIGIN
  dkey ORIG
  ppro ( 'GRID' )
  desc 'Origin'
  !!ce.dtitl = desc
  new DATA /MDS/ABAGRIDDATA/DEFAULTS/GEN/SCTNTAG
  dkey SCTN
  ppro ( '( DESC )' )
  desc 'SCTN Tag Pattern'
  !!ce.dtitl = desc
  new DATA /MDS/ABAGRIDDATA/DEFAULTS/GEN/GRDLNTAG
  dkey GRDL
  ppro ( '( GRDID )' )
  desc 'GRDLN Tag Pattern'
  !!ce.dtitl = desc

  new SECT /MDS/ABAGRIDDATA/DEFAULTS/GRIDS
  desc 'List of available grids'
  purp MDS
  new DTSE /MDS/ABAGRIDDATA/DEFAULTS/GRIDS/DTSE
  !this.gridlistdtse = !!ce
  !this.formtitle = !this.formtitle.before('(').trim()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .cancel()

  if !this.apply.active.and(!this.gendtse.badref().not()) then
    if !!alert.confirm('The changes you have made will be lost. Ok to close the form?').boolean().not() then
      return
    endif
  endif

  !this.hide()

endmethod
-- End of method
