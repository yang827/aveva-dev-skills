--
-- File:		mdslightingdflts.pmlfrm
--   Type:		Form Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		Paragon
--   Replaces:
--
-- Author:		Karel Pleschner
-- Created:		15 Feb 2007
--
--
-- Description:
-- Form to modify lighting defaults
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  cancel()                         -
--  changed()                        BOOLEAN
--  init()                           -
--  mdsLightingDflts()               -
--  populate()                       -
--  reset()                          -
--  setExpression(GADGET)            -
--  setHeight(GADGET)                -
--  settext(GADGET,STRING)           -
--

kill !!mdsLightingDflts

-- Define Form
setup form  !!mdsLightingDflts


-- Body of Form
    !tagwidth = 13
    !textwidth = 40
  frame .support 'Support' at xmin form ymin form
       text .supptype 'Type' tagwidth $!tagwidth at xmin+0.5  ymin+0.6 callback '!this.settext(!this.supptype,''type'')' width $!textwidth is STRING
    text .suppcode 'Code'  tagwidth $!tagwidth at xmin ymax+0.2 callback '!this.setExpression(!this.suppcode)' width $!textwidth is STRING
       text .supporig 'Origin' tagwidth $!tagwidth at xmin ymax+0.2 callback '!this.settext(!this.supporig,''supporig'')' width $!textwidth is STRING
       text .supprepltyp 'Replacement Type' tagwidth $!tagwidth at xmin ymax+0.2 callback '!this.settext(!this.supprepltyp,''replacetype'')' width $!textwidth is STRING
    text .maxheig 'Max. Height' tagwidth $!tagwidth at xmin ymax+0.2 callback '!this.setHeight(!this.maxheig)' width $!textwidth is REAL
    text .minheig 'Min. Height' tagwidth $!tagwidth at xmin ymax+0.2 callback '!this.setHeight(!this.minheig)' width $!textwidth is REAL
    text .stayLimHeig 'Bracket Limit' tagwidth $!tagwidth at xmin ymax+0.2 callback '!this.setHeight(!this.stayLimHeig)' width $!textwidth is REAL
    exit

  frame .lighting 'Lighting' at xmin ymax+0.5
    text .lighttype 'Type' tagwidth $!tagwidth at xmin.stayLimHeig ymin+0.6  callback '!this.settext(!this.lighttype,''idtype'')' width $!textwidth is STRING
    text .filter    'Filter' tagwidth $!tagwidth at xmin ymax+0.2 callback  '!this.setExpression(!this.filter)' width $!textwidth is STRING
       text .lightorig 'Origin' tagwidth $!tagwidth at xmin ymax+0.2 callback '!this.settext(!this.lightorig,''lightorig'')' width $!textwidth is STRING
    text .lightYdir 'Y Direction'  tagwidth $!tagwidth at xmin ymax+0.2 callback '!this.settext(!this.lightYdir,''lightydir'')' width $!textwidth is STRING
    exit

    -- bottom line
  button .apply  'Apply' at xmin FORM ymax+0.5 callback '!this.apply()' APPLY
  button .dismis  'Dismiss' at xmax form-size ymin callback '!this.cancel()'
  button .reset 'Reset' at xmin-size ymin callback '!this.reset()'

    -- form members
  member .dflts is MDSLSUPPDEFS
  member .dfltsBackup is MDSLSUPPDEFS


-- End form definition
exit


-- default constructor
----------------------------------------------------------------------------------------------------
define method .mdsLightingDflts()

  !this.formTitle = 'MDS Lighting Support Defaults'
    !this.initcall = '!this.init()'

endmethod


-- form initialisation
----------------------------------------------------------------------------------------------------
define method .init()


  !this.dflts.mdsLsuppdefs()

    if !this.dflts.error.set() then
       !error = !this.dflts.error
       return error 1 '$!error'
    endif

    !this.dfltsBackup = !this.dflts

    !this.populate()

endmethod
----------------------------------------------------------------------------------------------------


-- populate gadget
----------------------------------------------------------------------------------------------------
define method .populate()

    !this.supptype.val = !this.dflts.type
    !this.suppcode.val = !this.dflts.suppcode.string()
    !this.supporig.val = !this.dflts.supporig
    !this.supprepltyp.val = !this.dflts.replacetype
  !this.maxheig.val = !this.dflts.maxheig
    !this.minheig.val = !this.dflts.minheig
  !this.stayLimHeig.val = !this.dflts.stayLimHeig

    !this.lighttype.val = !this.dflts.idtype
    !this.filter.val = !this.dflts.idfilter.string()
    !this.lightorig.val = !this.dflts.lightorig
  !this.lightYdir.val = !this.dflts.lightYdir

endmethod


-- check suppcode expression
----------------------------------------------------------------------------------------------------
define method .setExpression(!gadget is GADGET)

   -- get gadget property
  !member = !gadget.name()
  !val = !gadget.val
    if !member.eq('SUPPCODE') then
       !datatyp = 'TEXT'
    elseif !member.eq('FILTER') then
       !datatyp = 'LOGICAL'
       !member = 'IDFILTER'
    endif

    -- the original value
  !origval = !this.dflts.$!<member>.string()

    -- check for unset or empty value and if so reset to original value
    if !val.unset() then
       !val = ''
    endif
    !val = !val.trim()
    if !val.empty() then
       !gadget.val = !origval
       return
    endif

   -- check for brackets
   if !val.substring(1,1).eq('(').and(!val.substring(-1,1).eq(')')).not() then
      !val = '( ' + !val + ' )'
   endif

   -- check if is it expression
  !exp = object EXPRESSION(!val)
        handle ANY
          !gadget.val = !origval
          !!alert.error(!gadget.tag + ' must be an expression!')
          return
        endhandle

    -- check if expression is of proper nature
    var !exptyp exptyp $!exp

    if !exptyp[1].trim().neq(!datatyp) then
      !gadget.val = !origval
      !!alert.error(!gadget.tag + ' must be valid $!datatyp expression!')
      return
    endif

    !gadget.val = !val
    !this.dflts.$!<member>.assign(!exp)

endmethod


-- check if form is changed
----------------------------------------------------------------------------------------------------
define method .changed() is BOOLEAN

  !formChanged = !this.dflts.neq(!this.dfltsBackup)

  !codeChanged = !this.dflts.suppcode.string().neq(!this.dfltsBackup.suppcode.string())

  !filterChanged = !this.dflts.idfilter.string().neq(!this.dfltsBackup.idfilter.string())

  return !formChanged.or(!codeChanged).or(!filterChanged)


endmethod



-- set height
----------------------------------------------------------------------------------------------------
define method .setHeight(!gadget is GADGET)

  !member = !gadget.name()
    if !gadget.val.unset() then
       !gadget.val = !this.dflts.$!member
       return
    endif

    if !gadget.val.leq(0) then
       !gadget.val = !this.dflts.$!member
    else
       !this.dflts.$!member = !gadget.val
    endif


endmethod


-- set text
----------------------------------------------------------------------------------------------------
define method .settext(!gadget is GADGET, !member is STRING)

    -- get original value
  !origval = !this.dflts.$!member

    -- check new value for empty or unset string
    !val = !gadget.val
    if !val.unset() then
       !val = ''
    endif
    !val = !val.trim()
    if !val.empty() then
       -- empty string so reset to original value
       !gadget.val = !origval
       return
    endif


    -- apply new value
    !this.dflts.$!member = !val
    !gadget.val = !val


endmethod


-- apply form data
----------------------------------------------------------------------------------------------------
define method .apply()

    if !this.changed() then
    if !!alert.confirm('O.k. to write defaults into DB?').boolean().not() then
          return
       endif
    else
       return
    endif

  !this.dfltsBackup = !this.dflts

  !oldCE = !!ce
  !this.dflts.updatedb()
     handle ANY
    !!ce = !oldCE
      !!alert.error($!!error.text)
     endhandle

endmethod


-- reset form
----------------------------------------------------------------------------------------------------
define method .reset()

    if !this.changed().not() then
       return
    endif

  if !!alert.confirm('O.k. to reset? All changes you have done since last "Apply" will be lost!').boolean().not() then
       return
    endif

  !this.dflts = !this.dfltsBackup

    !this.populate()

endmethod


-- form cancellation
------------------------------------------------------------------------------------------------------
define method .cancel()

    if !this.changed() then
    if !!alert.confirm('You haven''t applied the data you have changed. O.k. to dismiss?').boolean().not() then
          return
       endif
    endif

    !this.hide()

endmethod
