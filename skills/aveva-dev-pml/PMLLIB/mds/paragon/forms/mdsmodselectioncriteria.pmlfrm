------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  desc(REAL)                       -
--  expr(GADGET,STRING)              -
--  getToggleVal(REAL)               -                   Save toggle value in object
--  init()                           -
--  isFunction(STRING)               EXPRESSION
--  mdsModSelectionCriteria()        -
--  temp(GADGET,STRING)              -
--

setup form !!mdsModSelectionCriteria resizeable

  frame .tempframe 'Temperature' anchor t+l+r
    text .temp 'Expression' tagwidth 8 anchor t+l+r callback '!this.temp(' width 60 is STRING
  exit

  frame .frame1 'Criteria 1' at xmin ymax+0.1 anchor t+l+r
    text .desc1 'Description' tagwidth 8 anchor t+l+r at xmin.temp ymax callback '!this.desc(1)' width 60 is STRING
    text .expr1 'Expression' tagwidth 8 anchor t+l+r at xmin ymax+0.1 callback '!this.expr(' width 60 is STRING
    toggle .active1 'Active' tagwidth 4 anchor t+l at xmin ymax callback '!this.getToggleVal(1)'
  exit

  frame .frame2 'Criteria 2' at xmin ymax+0.1 anchor t+l+r
    text .desc2 'Description' tagwidth 8 anchor t+l+r at xmin.temp ymax callback '!this.desc(2)' width 60 is STRING
    text .expr2 'Expression' tagwidth 8 anchor t+l+r at xmin ymax+0.1 callback '!this.expr(' width 60 is STRING
    toggle .active2 'Active' tagwidth 4 anchor t+l at xmin ymax callback '!this.getToggleVal(2)'
  exit

  frame .frame3 'Criteria 3' at xmin ymax+0.1 anchor t+l+r
    text .desc3 'Description' tagwidth 8 anchor t+l+r at xmin.temp ymax callback '!this.desc(3)' width 60 is STRING
    text .expr3 'Expression' tagwidth 8 anchor t+l+r at xmin ymax+0.1 callback '!this.expr(' width 60 is STRING
    toggle .active3 'Active' tagwidth 4 anchor t+l at xmin ymax callback '!this.getToggleVal(3)'
  exit

  frame .frame4 'Criteria 4' at xmin ymax+0.1 anchor t+l+r
    text .desc4 'Description' tagwidth 8 anchor t+l+r at xmin.temp ymax callback '!this.desc(4)' width 60 is STRING
    text .expr4 'Expression' tagwidth 8 anchor t+l+r at xmin ymax+0.1 callback '!this.expr(' width 60 is STRING
    toggle .active4 'Active' tagwidth 4 anchor t+l at xmin ymax callback '!this.getToggleVal(4)'
  exit

  frame .frame5 'Criteria 5' at xmin ymax+0.1 anchor t+l+r
    text .desc5 'Description' tagwidth 8 anchor t+l+r at xmin.temp ymax callback '!this.desc(5)' width 60 is STRING
    text .expr5 'Expression' tagwidth 8 anchor t+l+r at xmin ymax+0.1 callback '!this.expr(' width 60 is STRING
    toggle .active5 'Active' tagwidth 4 anchor t+l at xmin ymax callback '!this.getToggleVal(5)'
  exit

  -- bottom line
  button .apply 'Apply' width 5 anchor l+b at xmin form ymax+0.4 callback '!this.apply()'
  button .cancel 'Dismiss' width 5 anchor r+b at xmax form-size ymin CANCEL
  button .reset 'Reset' width 5 anchor r+b at xmin-size ymin callback '!this.init()' RESET

  -- members
  member .criteria is MDSSELECTIONCRITERIA

  !this.temp.validateCall = '!this.temp('
  do !c from 1 to 5
    !this.attribute('expr' & !c).validateCall = '!this.expr('
  enddo

exit

------------------------------------------------------------------------
--
-- Method:
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .mdsModSelectionCriteria()

  !this.formtitle = 'User Defined Ancillary Selection Criteria'
  !this.initcall = '!this.init()'

endmethod

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  !this.criteria.mdsSelectionCriteria()

  !this.temp.val = !this.criteria.temp
  do !c from 1 to 5

    if !this.criteria.expression[!c].string().match('USERFUNCBRACK').gt(0) then
      --we have a properly formatted function call so display it as intended
      !functionString = '!!' + !this.criteria.expression[!c].string().after('!!').before('USERFUNCBRACK') + '()'
      !this.attribute('expr' & !c).val = !functionString
    else
      !this.attribute('expr' & !c).val = !this.criteria.expression[!c].string()
    endif
    !this.attribute('desc' & !c).val = !this.criteria.description[!c]
    !this.attribute('active' & !c).val = !this.criteria.active[!c]
    !this.attribute('expr' & !c).val
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .temp(!field is GADGET, !action is STRING)

  !val = !this.temp.val
  if !val.unset() then
    !val = ''
  endif
  !val = !val.trim()
  if !val.empty() then
    !val = 'TEMP of BRAN'
  endif

  if ( !action.eq('VALIDATE')) then

    !test = object EXPRESSION(!val)
    handle ANY
      return error 1 'Invalid expression syntax for temperature.'
    elsehandle NONE
      !testresult = !test.evaluate(world)
      handle ANY
        return error 1 'Invalid expression syntax for temperature.'
      elsehandle NONE
        if !testresult.objecttype().neq('REAL') then
          return error 1 'The result of the temperature expression must be a REAL value.'
        endif
      endhandle
    endhandle

  endif

  if !action.eq('SELECT') then

    !this.temp.val = !val
    !this.criteria.temp = !val

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .expr(!field is GADGET, !action is STRING)

  !index = !field.name().substring(!field.name().length()).rEAL()
  !toggle = !this.attribute('active' & !index)

  !expr = object EXPRESSION()
  !val = !field.val
  if !val.unset() then
    !val = ''
  endif
  !val = !val.trim()

  if ( !action.eq('VALIDATE')) then

    -- valid if empty
    if !val.empty() then
      return
    endif

  elseif ( !action.eq('SELECT')) then

    if !val.empty() then
      !field.val = !val
      !this.criteria.expression[!index] = !expr
      !this.criteria.active[!index] = false
      !toggle.val = false
      return
    endif

  endif

  -- fill with missing brackets
  !startbracket = !val.match('(').eq(1)
  !endbracket = !val.matchwild('*)')
  !openBracketCount = !val.occurs('(')
  !closeBracketCount = !val.occurs(')')
  !bracketMismatch = !openBracketCount.neq(!closeBracketCount)
  if !startbracket.not().and(!endbracket) then
    if !bracketMismatch then
      !val = '(' & !val
    endif
  elseif !startbracket.and(!endbracket.not()) then
    if !bracketMismatch then
      !val = !val & ')'
    endif
  elseif !startbracket.not().and(!endbracket.not()) then
    !val = '(' & !val & ')'
  endif
  !val = !val.replace('(','( ').replace(')',' )')
  do
    !val = !val.replace('  ',' ')
    break if !val.match('  ').eq(0)
  enddo

  -- try to run expression on validate
  if !action.eq('VALIDATE') then
    !expr = object EXPRESSION(!val)
    handle ANY
      !expr = !this.isFunction(!val)
      handle 99
        --this is not a valid function so return the error message
        return error 1 'Invalid expression or function call in field $!index'
      endhandle
    elsehandle NONE
      !test = !expr.evaluate(world)
      handle ANY
        return error 1 'Invalid expression in field $!index'
        --!expr = !oldexpr
      elsehandle NONE
        if !test.objecttype().neq('BOOLEAN') then
          return error 1 'The result of the expression in field $!index must be a logical value (TRUE/FALSE).'
        endif
      endhandle
    endhandle

  endif

  if !action.eq('SELECT') then
    !expr = object EXPRESSION(!val)
    handle ANY
      !expr = !this.isFunction(!val)
      handle 99
        --this is not a valid function so return the error message
        return error 1 'Invalid expression or function call in field $!index'
      elsehandle NONE
        --update the field value for a valid function.
        !functionString = '!!' + !expr.string().after('!!').before('USERFUNCBRACK') + '()'
        !field.val = !functionString
      endhandle
    elsehandle NONE
      --update the field value for a valid expression.
      !field.val = !expr.string()
    endhandle
    !this.criteria.expression[!index] = !expr
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .desc(!index is REAL)

  !field = !this.attribute('desc' & !index)
  !val = !field.val
  if !val.unset() then
    !val = !this.criteria.description[!index]
  else
    !val = !val.trim()
  endif

  !this.criteria.description[!index] = !val
  !field.val = !val

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getToggleVal
--
-- Description: Save toggle value in object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getToggleVal(!index is REAL)

  !toggle = !this.attribute('active' & !index)
  !on = !toggle.val
  if !on then
    if !this.criteria.expression[!index].unset() then
      !on = false
      !!alert.error('Cannot make criteria ' & !index & ' active. The expression is unset.')
    endif
  endif
  !this.criteria.active[!index] = !on
  !toggle.val = !on

endmethod

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  -- test toggle values and save in the object
  do !c from 1 to 5
    !this.getToggleVal(!c)
  enddo

  !this.criteria.writeCriteria()

endmethod

------------------------------------------------------------------------
--
-- Method:
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isFunction(!val is STRING) is EXPRESSION

  --we need to try and figure out whether or not the expression string contains a properly formatted function.
  --if it does then we will be able to store it and use it in design

  --the proper format for a function string in this context will be !!functionName() which has no arguments and needs to return a boolean.
  --We will not be able to deal with anything more complex than this as we will be saving a textual representation of this function
  --in the expression object that will be parsed in design to extract it for use.
  !length = !val.length()

  if !val.trim().substring(1,2).eq('!!') and !val.trim().substring(!length - 2).eq('( )') then
    --this is a valid string so return a formatted expression string that can be stored
    !tempString = !val.trim().replace('( )', 'USERFUNCBRACK')
    !returnString = 'vlogical ($!tempString)'
    !returnExpression = object EXPRESSION(!returnString)
    return !returnExpression
  else
    return error 99
  endif

endmethod
