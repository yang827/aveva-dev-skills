  !currentobject.bore[!this.selectedbore.real()].altexpr[!number] = $!temp
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
endmethod
-- End of method definition for .writealtexpr(REAL)

------------------------------------------------------------------------

define method .writealtexprvalid(!textin is GADGET, !action is STRING)
  !currentobject = !this.$!this.currentancil

  !this.checkexprn(!textin)

  !test = !textin.val.split('DESP')
  !test.deleteto(1)
  !test.compress()

  do !i index !test
    !temp = !test[!i].after('[').before(']')
    !indexfound = !currentobject.dpnumber.findfirst(!temp)
    if !indexfound.unset() then
      return error 1 'Design parameter number $!temp invalid'
    endif
  enddo
endmethod
-- End of method definition for .writealtexprvalid(GADGET, STRING)

------------------------------------------------------------------------
define method .writealtdespar(!number1 is REAL,!number2 is REAL)

  !currentobject = !this.$!this.currentancil
  !temp = '!this.altdesptext' & !number1.string() & 'd' & !number2.string() & '.val'
  !currentobject.bore[!this.selectedbore.real()].altdesparval[!number1][!number2] = $!temp
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject

endmethod
-- End of method definition for .writealtdespar(REAL,REAL)
