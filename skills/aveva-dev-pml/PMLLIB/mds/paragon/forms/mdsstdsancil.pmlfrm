--
--
-- Description:
-- Form to modify lighting defaults
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  activeframe(GADGET,STRING)       -
--  activetabinit()                  -
--  altinit(STRING)                  -
--  borematinit(STRING)              -
--  cancelformmethod()               -
--  checkexprn(GADGET)               -
--  createudp()                      -
--  deleteudp()                      -
--  desparsinit()                    -
--  editcolinit(STRING)              -
--  editrowinit(STRING)              -
--  frameevent(GADGET,STRING)        -
--  iconfilter(STRING)               -
--  init(STRING)                     -
--  isofframe(GADGET,STRING)         -
--  mdsstdsancil()                   -
--  selectdesparbore()               -
--  userinit(STRING)                 -
--  writeactiveval(REAL)             -
--  writealtdespar(REAL,REAL)        -
--  writealtexpr(REAL)               -
--  writealtexprvalid(GADGET,STRING) -
--  writeborepropmat()               -
--  writeborepropmatvalid(GADGET,STRING) -
--  writeborepsmc()                  -
--  writeborepsmcvalid(GADGET,STRING) -
--  writecheck()                     -
--  writecolval()                    -
--  writecolvalid(GADGET,STRING)     -
--  writedescription()               -
--  writedescriptionvalid(GADGET,STRING) -
--  writeelev()                      -
--  writeelevvalid(GADGET,STRING)    -
--  writeframedataoption()           -
--  writeframedatatext1()            -
--  writeframedatatext2()            -
--  writenumorexprvalid(GADGET,STRING) -
--  writepropmat()                   -
--  writepropmatvalid(GADGET,STRING) -
--  writepsmc()                      -
--  writepsmcvalid(GADGET,STRING)    -
--  writername()                     -
--  writernamevalid(GADGET,STRING)   -
--  writerowval(REAL)                -
--  writerowvalid(GADGET,STRING)     -
--  writeshopflagval(REAL)           -
--  writesuppfunc()                  -
--  writetodatabase()                -
--  writeuserdespmax(REAL)           -
--  writeuserdespmin(REAL)           -
--  writevend()                      -
--

kill !!mdsstdsancil

setup form !!mdsstdsancil

  -- Check the units
  !unit = object DBREF( '/MDS/OPTION/DEFAULTS/MPU/DATA' )
  handle ANY
    !!alert.error('/MDS/PRELIMINARY/DEFAULTS/MPU/DATA must exist to modify preliminary design parameters')
    return error 1 '' noalert
  elsehandle NONE
    !!unitFormat = object FORMAT()
    if (!unit.ppro.matchwild('*25.4*')) then
      !!unitFormat.dimension   = 'L'
      !!unitFormat.units       = 'INCH'
      !!unitFormat.fraction    = TRUE
      !!unitFormat.denominator = 64
      !!unitFormat.label       = 'in'
      !!unitFormat.inchSeparator = '.'
    else
      !!unitFormat.dimension   = 'L'
      !!unitFormat.units       = 'MM'
      !!unitFormat.dp          = 0
    endif
  endhandle

  !this.initcall = '!this.init(|FORMINIT|)'

  !this.formtitle = 'MDS Ancillary Data'

  para .supstandardtitle text 'Support Standard'
  path right
  para .supstandardname text 'xxxxxx'
  text .datarname 'Standard Replacement Name' call '!this.writername()' tagwid 20 width 13 is STRING
  text .datadescription 'Description' call '!this.writedescription()' tagwid 10 width 44 is STRING
  path down

  frame .tabset TABSET at xmin form

    frame .data 'Standard  ' at 0 0
      --define gadgets in Standard tab

      list .datasectlist call '!this.init(|UPDATE|)' at xmin form +0.5 columns width 23 hei 22

      path down

      button .filtAN 'AN' call |!this.iconfilter('AN')| tooltip 'Anchors'
      path right
      button .filtAT 'AT' call |!this.iconfilter('AT')| tooltip 'Ancillaries'
      button .filtGT 'GT' call |!this.iconfilter('GT')| tooltip 'Guides'
      button .filtBT 'BT' call |!this.iconfilter('BT')| tooltip 'U-Bolts'
      button .filtSU 'SU' call |!this.iconfilter('SU')| tooltip 'Slip Units'

      button .filtST 'ST' call |!this.iconfilter('ST')| at xmin .filtAN ymax .filtAN tooltip 'Stops'
      button .filtAC 'AC' call |!this.iconfilter('AC')|
      button .filtBR 'BR' call |!this.iconfilter('BR')|
      button .filtCA 'CA' call |!this.iconfilter('CA')|
      button .filtLT 'LT' call |!this.iconfilter('LT')|

      button .filtPR 'PR' call |!this.iconfilter('PR')| at xmin .filtST ymax .filtST tooltip 'Preliminaries'
      button .filtALL 'ALL' call |!this.iconfilter('ALL')| tooltip 'All'
      path right

      frame .standardframe 'Standard' at xmax .datasectlist +0.5 ymin .datasectlist
        path down

        frame .activeframe 'Active'
          rtoggle .activetoggletrue 'True' call '!this.activeframe('
          path right
          rtoggle .activetogglefalse 'False'
        exit

        path down

        text .datatext3 'Vendor Reference' call '!this.writevend()' tagwid 26 width 13 is STRING
        text .datatext4 'Elevation Restriction' call '!this.writeelev()' tagwid 26 width 13 is STRING
        text .datatext5 'Pipe Specification Material Code' call '!this.writepsmc()' tagwid 26 width 13 is STRING
        text .datatext6 'Propcon - MDS Ancillary Material' call '!this.writepropmat()' tagwid 26 width 13 is STRING
        text .datasuppfunc 'Support function' call '!this.writesuppfunc()' tagwid 26 width 13 is STRING

        frame .isofframe 'Isometric MTOC Flag'
          rtoggle .isoftoggletrue 'True' call '!this.isofframe('
          path right
          rtoggle .isoftogglefalse 'False'
        exit

      exit

      path down

      frame .standardboreframe 'Bore Specific'
        --frame for bore-specific pipe mat code and propcon
        para .borestand text 'Bore'
        path right
        para .boresizeparastand text 'test'
        path down
        !pixmap = !!pml.getpathname('uparrow16.png')
        button .standupbutton at xmax ymin -0.4 pixmap "$!<pixmap>" call '!this.borematinit(|prev|)'
        !pixmap = !!pml.getpathname('downarrow16.png')
        button .standdownbutton at xmin ymin +.9 pixmap "$!<pixmap>" call '!this.borematinit(|next|)'
        path down
        text .standtext1 'Pipe Specification Material Code' at xmin .borestand ymax .standdownbutton -0.5 call '!this.writeborepsmc()' tagwid 26 width 13 is STRING
        text .standtext2 'Propcon - MDS Ancillary Material' call '!this.writeborepropmat()' tagwid 26 width 13 is STRING
        option .framedataoption 'Framework Clearance Option' call '!this.writeframedataoption()' tagwid 26 width 11
        text .framedatatext1 'Closed End Clearance' call '!this.writeframedatatext1()' tagwid 26 width 13 is REAL format !!unitFormat
        text .framedatatext2 'Open End Clearance' call '!this.writeframedatatext2()' tagwid 26 width 13 is REAL format !!unitFormat

      exit

      frame .plotframe 'plot file' at xmax.standardframe+0.3 ymin.standardframe hei 19.6 wid 40
      --popup to reset limits  on plotfile view
      !plotpopup = !this.newmenu('listpopup')
      !plotpopup.add('callback','Reset limits','!this.plot.add(!this.plot.val)')

      --plotfile view
      view .plot at xmax .datatext3 +4 PLOT
        bord on
        height 18.4
        width 40
        setc 15
      exit

      !this.plot.setpopup(!this.listpopup)
      exit

    exit

    frame .activetab 'Active/Shop Flag  ' at 0 0
      --define gadgets in Active tab
      path down
      frame .activeboreframe 'Active'
        para .mypara text 'Check box(es) to select bore size as active'
        !poscounter = 1
        path right
        do !loopcounter from 1 to 40
          !test = '     '

          if !loopcounter.eq(11) or !loopcounter.eq(21) or !loopcounter.eq(31) then
            toggle .toggle$!loopcounter '$!test' at xmin .toggle$!poscounter ymax .toggle$!poscounter +0.5 call '!this.writeactiveval($!loopcounter)'
            !poscounter = !poscounter + 10
          elseif !loopcounter.eq(1) then
            toggle .toggle$!loopcounter '$!test' at xmin .mypara ymax call '!this.writeactiveval($!loopcounter)'
          else
            toggle .toggle$!loopcounter '$!test' call '!this.writeactiveval($!loopcounter)'
          endif

        enddo
      exit
      path down
      frame .shopflagframe 'Shop Flag'
        --define gadgets in Shop Flag tab
        para .mypara2 text 'Check box(es) to set shop flag as true'
        !poscounter = 1
        path right
        do !loopcounter from 1 to 40
          !test = '     '

          if !loopcounter.eq(11) or !loopcounter.eq(21) or !loopcounter.eq(31) then
            toggle .shoptoggle$!loopcounter '$!test' at xmin .shoptoggle$!poscounter ymax .shoptoggle$!poscounter +0.5 call '!this.writeshopflagval($!loopcounter)'
            !poscounter = !poscounter + 10
          elseif !loopcounter.eq(1) then
            toggle .shoptoggle$!loopcounter '$!test' at xmin .mypara2 ymax call '!this.writeshopflagval($!loopcounter)'
          else
            toggle .shoptoggle$!loopcounter '$!test' call '!this.writeshopflagval($!loopcounter)'
          endif
        enddo
      exit
    exit

    frame .despars 'Parameters' at 0 0
      --define gadgets in Parameters tab
      path down
      list .desparssectlist call '!this.selectdesparbore()' columns width 110 hei 26
    exit

    frame .editrow 'Size      ' at 0 0
      --define gadgets in Size (rows) tab
      path down

      para .bore text 'Bore'
      path right
      para .boresizepara text '    '
      path down

      !pixmap = !!pml.getpathname('uparrow16.png')
      button .upbutton at xmax ymin -0.4 pixmap "$!<pixmap>" call '!this.editrowinit(|prev|)'
      !pixmap = !!pml.getpathname('downarrow16.png')
      button .downbutton at xmin ymin +.9 pixmap "$!<pixmap>" call '!this.editrowinit(|next|)'

      !poscounter = 1
      do !loopcounter from 1 to 39
        !test = '    ' & !loopcounter.string()
        if !loopcounter.eq(14) or !loopcounter.eq(27) then
          text .text$!loopcounter '$!test' at xmax .text$!poscounter + 2 ymin .text$!poscounter call '!this.writerowval($!loopcounter)' tagwid 25 width 10 is STRING
          !poscounter = !poscounter + 13
        elseif !loopcounter.eq(1) then
          text .text$!loopcounter '$!test' at xmin .bore ymax +0.25 call '!this.writerowval($!loopcounter)' tagwid 25 width 10 is STRING
        else
          text .text$!loopcounter '$!test' call '!this.writerowval($!loopcounter)' tagwid 25 width 10 is STRING
        endif
      enddo

    exit

    frame .editcol 'Parameter ' at 0 0
      --define gadgets in Parameter (column) tab
      path down
      para .editcolpara1 text 'Choose parameter to edit'
      option .editcoloption1 'Column' call '!this.editcolinit(|update|)' tagwid 15 width 25
      option .editcoloption2 'From Bore' tagwid 15 width 25
      option .editcoloption3 'To Bore' tagwid 15 width 25
      text .editcoltext4 'Value' call '!this.writecolval()' tagwid 15 width 25 is STRING
      list .editcollist at xmax .editcoloption1 +2 ymin .editcoloption1 columns width 18 hei 24

    exit

    frame .alt 'Alt Expression ' at 0 0
      --define gadgets in Alt Expression tab
      path down
      para .altbore text 'Bore'
      path right
      para .altboresizepara text '    '
      path down

      !pixmap = !!pml.getpathname('uparrow16.png')
      button .altupbutton at xmax ymin -0.4 pixmap "$!<pixmap>" call '!this.altinit(|prev|)'
      !pixmap = !!pml.getpathname('downarrow16.png')
      button .altdownbutton at xmin ymin +.9 pixmap "$!<pixmap>" call '!this.altinit(|next|)'

      text .alttext1 'Alt expression 1' call '!this.writealtexpr(1)' at xmin .altbore tagwid 12 width 18 is STRING
      path right
      text .altdesptext1d1 'Alt despar 1' call '!this.writealtdespar(1,1)' tagwid 12 width 8 is STRING
      path down
      text .altdesptext1d2 'Alt despar 2' call '!this.writealtdespar(1,2)' tagwid 12 width 8 is STRING
      text .altdesptext1d3 'Alt despar 3' call '!this.writealtdespar(1,3)' tagwid 12 width 8 is STRING
      text .altdesptext1d4 'Alt despar 4' call '!this.writealtdespar(1,4)' tagwid 12 width 8 is STRING
      text .altdesptext1d5 'Alt despar 5' call '!this.writealtdespar(1,5)' tagwid 12 width 8 is STRING
      text .altdesptext1d6 'Alt despar 6' call '!this.writealtdespar(1,6)' tagwid 12 width 8 is STRING
      text .alttext2 'Alt expression 2' call '!this.writealtexpr(2)'at xmin .alttext1 tagwid 12 width 18 is STRING
      path right
      text .altdesptext2d1 'Alt despar 1' call '!this.writealtdespar(2,1)' tagwid 12 width 8 is STRING
      path down
      text .altdesptext2d2 'Alt despar 2' call '!this.writealtdespar(2,2)' tagwid 12 width 8 is STRING
      text .altdesptext2d3 'Alt despar 3' call '!this.writealtdespar(2,3)' tagwid 12 width 8 is STRING
      text .altdesptext2d4 'Alt despar 4' call '!this.writealtdespar(2,4)' tagwid 12 width 8 is STRING
      text .altdesptext2d5 'Alt despar 5' call '!this.writealtdespar(2,5)' tagwid 12 width 8 is STRING
      text .altdesptext2d6 'Alt despar 6' call '!this.writealtdespar(2,6)' tagwid 12 width 8 is STRING
    exit

    frame .userdespar 'User Des Pars' at 0 0
      --Define gadgets in User Des Pars tab
      path down

      para .userbore text 'Bore'
      path right
      para .userboresizepara text '    '
      path down

      !pixmap = !!pml.getpathname('uparrow16.png')
      button .userupbutton at xmax ymin -0.4 pixmap "$!<pixmap>" call '!this.userinit(|prev|)'
      !pixmap = !!pml.getpathname('downarrow16.png')
      button .userdownbutton at xmin ymin +.9 pixmap "$!<pixmap>" call '!this.userinit(|next|)'
      button .createudp 'New User Editable Design Parameter' at xmax.userupbutton ymin call '!this.createudp()'

      --<wd>apr2007 -- Added the Button to DELETE an EXISTING User Editable Design Parameter
      button .deleteudp 'Remove User Editable Design Parameter' at xmax.createudp ymin call '!this.deleteudp()'
      --<wd>apr2007

      do !loopcounter from 1 to 12
        path down
        para .userdesppara$!loopcounter at xmin form text 'test' width 12
        path right
        text .userdespmintext$!loopcounter 'Min' call '!this.writeuserdespmin($!loopcounter)' tagwid 5 width 8 is STRING
        text .userdespmaxtext$!loopcounter 'Max' call '!this.writeuserdespmax($!loopcounter)' tagwid 5 width 8 is STRING
      enddo
      path down
    exit

  exit

  --apply and dismiss buttons outside tabbed frame

  button .apply 'Apply' call '!this.writetodatabase()' at xmin form
  path right
  button .dismiss 'Dismiss' call '!this.cancelformmethod()' at xmax form -size

  --callbacks (open callbacks) for tabs

  !this.data.callback = '!this.frameevent('
  !this.activetab.callback = '!this.frameevent('
  !this.despars.callback = '!this.frameevent('
  !this.editrow.callback = '!this.frameevent('
  !this.editcol.callback = '!this.frameevent('
  !this.alt.callback = '!this.frameevent('
  !this.userdespar.callback = '!this.frameevent('

  --form members set in .init

  member .cata is DBREF
  member .cata2 is DBREF
  member .ancilnumber is REAL
  member .currentancil is STRING

  --<wd>july2007
  -- New member added to store the CURRENT ICON FILTER "LIST TYPE" -- The Default on Initialisation is "ALL"
  member .currenticonfilter is STRING
  --<wd>july2007

  member .writeflag is BOOLEAN

  member .deschyphenfound is BOOLEAN

  --form members set in .desparsinit

  member .selectedbore is STRING
  member .despararray is ARRAY
  member .numdespars is REAL
  member .currentsection is DBREF
  member .descarray is ARRAY
  member .descnumberarray is ARRAY
  member .dpnumber is ARRAY

  member .sectcoll is ARRAY

  member .sectdesc is ARRAY

  member .sectdescgen is ARRAY

  member .sectrnamegen is ARRAY

  member .sectdbrefarray is ARRAY

  member .indiceofselectedbore is REAL

  member .ancillistarray is ARRAY

  member .stypelist is ARRAY

  member .ancillistrtext is ARRAY

  member .imperial is BOOLEAN

  -- A member is created for each standard available in /MDS/ATTA/DEFAULTS and MDS/PRELIMINARY/DEFAULTS
  -- Collecting the datasets takes to long work from the names of the datasets
  -- A form member object of type MDSANCILDATA will be created for each standard

  --Check module (paragon or design), don't include active false for design (or show form)

  !datacollgen = ARRAY()
  var !sections coll all sect for /MDS/ATTA/DEFAULTS
  var !sections append coll all sect for /MDS/PRELIMINARY/DEFAULTS
  var !sectionnames eval name for all from !sections
  do !stripnames values !sectionnames
    !stypfromsection = !stripnames.after('/MDS/ATTA/DEFAULTS/').replace('-','')
    if !stypfromsection.eq('') then
      !stypfromsection = !stripnames.after('/MDS/PRELIMINARY/DEFAULTS/').replace('-','')
    endif
    !this.stypelist.append(!stypfromsection)
    --!tempdesc = (pprop of $!stripnames/GEN/DESC )
    !tempccod = (pprop of $!stripnames/GEN/CCOD )
    !this.sectrnamegen.append(!tempccod.after(|( '|).before(|' )|))
    -- !this.sectdescgen.append(!tempdesc.after(|( '|).before(|' )|))
    !this.sectdescgen.append(!stypfromsection)
    !datacollgen.append(ref of $!stripnames/GEN/CODE )
  enddo

  do !setarray values !sections
    !this.sectdbrefarray.append(!setarray.dbref())
  enddo

  do !i from 1 to !this.stypelist.size()
    member .$!this.stypelist[$!i] is MDSANCILDATA
  enddo

exit
-------------------------------------------------------------------------

define method .mdsstdsancil()
  --validate calls on text gadgets
  --gadgets at top of form
  !this.datadescription.validatecall = '!this.writedescriptionvalid('
  !this.datarname.validatecall = '!this.writernamevalid('
  --standard tab
  !this.datatext4.validatecall = '!this.writeelevvalid('
  !this.datatext5.validatecall = '!this.writepsmcvalid('
  !this.datatext6.validatecall = '!this.writepropmatvalid('

  !this.standtext1.validatecall = '!this.writeborepsmcvalid('
  !this.standtext2.validatecall = '!this.writeborepropmatvalid('

  -- row tab
  do !loopcounter from 1 to 39
    !temp = '!this.text' & '$!loopcounter' & '.validatecall'
    $!temp = '!this.writerowvalid('
  enddo
  --column tab
  !this.editcoltext4.validatecall = '!this.writecolvalid('

  --alt tab

  !this.alttext1.validatecall = '!this.writenumorexprvalid('
  !this.alttext2.validatecall = '!this.writenumorexprvalid('

  do !loopcounter from 1 to 6
    !temp1 = '!this.altdesptext1d' & '$!loopcounter' & '.validatecall'
    !temp2 = '!this.altdesptext2d' & '$!loopcounter' & '.validatecall'
    $!temp1 = '!this.writenumorexprvalid('
    $!temp2 = '!this.writenumorexprvalid('
  enddo

  --user despars tab
  do !loopcounter from 1 to 12
    !temp = '!this.userdespmintext' & '$!loopcounter' & '.validatecall'
    !temp2 = '!this.userdespmaxtext' & '$!loopcounter' & '.validatecall'
    $!temp = '!this.writenumorexprvalid('
    $!temp2 = '!this.writenumorexprvalid('
  enddo

endmethod
-- End of method definition for .mdsstdsancil()
-------------------------------------------------------------------

define method .init(!mode is STRING)

  -- If in initialisation mode, navigate to defaults, put names in list and create
  -- an mdsancildata object for each standard

  if !mode.eq('FORMINIT') then

    /MDS/ATTA/DEFAULTS
    handle ANY
      !!alert.error('/MDS/ATTA/DEFAULTS must exist to modify ancillary design parameters')
      return error 1 '' noalert
    elsehandle NONE
      !this.cata = !!ce
    endhandle

    /MDS/PRELIMINARY/DEFAULTS
    handle ANY
      !!alert.error('/MDS/PRELIMINARY/DEFAULTS must exist to modify preliminary design parameters')
      return error 1 '' noalert
    elsehandle NONE
      !this.cata2 = !!ce
    endhandle

    -- Check the units
    !unit = object DBREF( '/MDS/OPTION/DEFAULTS/MPU/DATA' )
    handle ANY
      !!alert.error('/MDS/PRELIMINARY/DEFAULTS/MPU/DATA must exist to modify preliminary design parameters')
      return error 1 '' noalert
    elsehandle NONE
      if (!unit.ppro.matchwild('*25.4*')) then
        !this.imperial = TRUE
      else
        !this.imperial = FALSE
      endif
    endhandle


    --Write check

    !this.writecheck()
    !ancilcata = !this.cata
    !prelimcata = !this.cata2

    var !sectcolltemp coll all sect for $!ancilcata
    var !sectcolltemp append coll all sect for $!prelimcata


    --Test that name is in GEN for all SECT - if not display warning message

    !numsect = !sectcolltemp.size()
    !numgendesc = !this.sectrnamegen.size()
    if !sectcolltemp.size().neq(!this.sectrnamegen.size()) then
      !!alert.warning('$!numsect SECT found, but only $!numgendesc with GEN descriptions - these $!numgendesc are displayed')
    endif

    !headings = ARRAY()
    !headings.append('Name')
    !headings.append('Replacement Name')
    !this.datasectlist.setheadings(!headings)

    --Create objects with name, rname and dbref of all ancils
    --(one-off creation on form definition)
    !tempcounter = 1
    !rtextarray = ARRAY()
    do !i values !this.sectdescgen
      --!tempobjname = '!this.' & !i & '.name'
      !tempobjname = '!this.' & !i & '.mainnameval'
      !tempobjdbref = '!this.' & !i & '.dbref'
      !tempobjrname = '!this.' & !i & '.rnameval'

      $!tempobjname = !this.sectdescgen[!tempcounter]
      $!tempobjdbref = !this.sectdbrefarray[!tempcounter]
      $!tempobjrname = !this.sectrnamegen[!tempcounter]

      --******************************************************
      --UNCOMMENT BELOW LINES TO LOAD ALL OBJECTS AT START
      --!tempruninitdata = '!this.' & !i & '.initdata()'
      --!tempruninitdespars = '!this.' & !i & '.initdespars()'
      --$!tempruninitdata
      --$!tempruninitdespars
      --******************************************************

      --create array of names to put values in list (from objects)
      --!temparray[!tempcounter][1] = $!tempobjname

      !rtextarray[!tempcounter] = $!tempobjname

      !temparray[!tempcounter][2] = $!tempobjrname
      !tempcounter = !tempcounter + 1
    enddo

    !tempcounter = 1
    do !k values !this.stypelist
      !temparray[!tempcounter][1] = !k
      !tempcounter = !tempcounter + 1
    enddo

    !this.ancillistarray = !temparray
    !this.datasectlist.setrows(!this.ancillistarray)
    !this.ancillistrtext = !rtextarray
    !this.datasectlist.rtext = !rtextarray

    --<wd>july2007
    -- New member added to store the CURRENT ICON FILTER "LIST TYPE" -- The Default on Initialisation is 'ALL'
    !this.currenticonfilter = 'ALL'
    --<wd>july2007

  endif

  if !mode.eq('FORMINIT') then
    --current ancil taken from dtext of datasectlist (list on standard tab)
    --**!this.currentancil = !this.datasectlist.dtext[1].split()[1]
    !this.currentancil = !this.datasectlist.rtext[1]
  else
    !this.currentancil = !this.datasectlist.dtext[!this.datasectlist.val].split()[1]
  endif

  --Display plotfile on standard tab
  !this.currentancil = !this.datasectlist.dtext[!this.datasectlist.val].split()[1]


  !test = !!mdsgetplot(!this.currentancil)
  !this.plot.add(!test[1].string())
  handle ANY
    !test = !!mdsgetplot('None')
    !this.plot.add(!test[1].string())
  endhandle

  --Run object datainit (for selected ancil, or first ancil if first display
  --of form)
  --Also run initdespars (object despars init) to get all des par values for
  --current ancillary
  !currentobject = !this.$!this.currentancil
  !currentobject.initdata()

  --if !currentobject.vendanddesparsflag.eq(TRUE) then
  !currentobject.initdespars()
  --endif

  !this.$!this.currentancil = !currentobject

  !this.supstandardname.val = !currentobject.mainnameval

  !this.datarname.val = !currentobject.rnameval

  if !currentobject.suppfuncval.set() then
    !this.datasuppfunc.visible = TRUE
    !this.datasuppfunc.val = !currentobject.suppfuncval
  else
    !this.datasuppfunc.visible = false
  endif


  --objects cannot have '-' in name, so remove
  if !currentobject.description.split()[1].eq('-') then
    !this.datadescription.val = !currentobject.description.after('- ')
  else
    !this.datadescription.val = !currentobject.description
  endif

  if !currentobject.active.eq(TRUE) then
    !this.activetoggletrue.val = TRUE
  elseif !currentobject.active.eq(FALSE) then
    !this.activetogglefalse.val = TRUE
  endif

  !this.datatext3.val = !currentobject.vendval
  --if !currentobject.vendtag.neq('') then
  --  !this.datatext3.tag = !currentobject.vendtag
  --endif
  !this.datatext4.val = !currentobject.elevval
  if (!this.imperial.not() or !this.datatext4.val eq '*' or !this.datatext4.val eq '') then
    !this.datatext4.val = !currentobject.elevval
  else
    !inchReal = object REAL(!currentobject.elevval,!!distanceFmt)
    !inchString = object STRING(!inchReal,!!unitFormat)
    !this.datatext4.val = !inchString
  endif
  --if !currentobject.elevtag.neq('') then
  --  !this.datatext4.tag = !currentobject.elevtag
  --endif
  !this.datatext5.val = !currentobject.pipematval
  --if !currentobject.pipemattag.neq('') then
  --  !this.datatext5.tag = !currentobject.pipemattag
  --endif
  !this.datatext6.val = !currentobject.propval
  --if !currentobject.proptag.neq('') then
  --  !this.datatext6.tag = !currentobject.proptag
  --endif

  if !currentobject.isofval.trim().upcase().eq('TRUE') then
    !this.isoftoggletrue.val = TRUE
  elseif !currentobject.isofval.trim().upcase().eq('FALSE') then
    !this.isoftogglefalse.val = TRUE
  endif

  --**SECTION TO SET TABS AND GADGETS TO INACTIVE/INVISIBLE IF NOT NEEDED

  !this.datatext3.active = TRUE
  !this.datatext4.active = TRUE
  !this.datatext5.active = TRUE
  !this.datatext6.active = TRUE
  !this.isofframe.active = TRUE

  !this.standardboreframe.active = TRUE
  !this.standtext1.active = TRUE
  !this.standtext2.active = TRUE

  !this.activetab.active = TRUE
  !this.despars.active = TRUE
  !this.editrow.active = TRUE
  !this.editcol.active = TRUE
  !this.alt.active = TRUE
  !this.userdespar.active = TRUE

  if !currentobject.vendanddesparsflag.eq(FALSE) then
    !this.datatext3.active = FALSE
    !this.datatext4.active = FALSE
    !this.datatext5.active = FALSE
    !this.datatext6.active = FALSE
    !this.isofframe.active = FALSE

    !this.standardboreframe.active = FALSE

    !this.activetab.active = FALSE
    !this.despars.active = FALSE
    !this.editrow.active = FALSE
    !this.editcol.active = FALSE
    !this.alt.active = FALSE
    !this.userdespar.active = FALSE
  endif

  if !currentobject.boreandclearanceonlyflag.eq(TRUE) then
    !this.standardboreframe.active = TRUE
    !this.standtext1.active = FALSE
    !this.standtext2.active = FALSE
  endif

  !this.indiceofselectedbore = 1

  --run form .desparsinit() - displays despars in list in parameters tab
  --if !currentobject.vendanddesparsflag.eq(TRUE) then
  !this.desparsinit()
  !this.borematinit('tabinit')
  !this.editrowinit('tabinit')
  --endif

endmethod
-- End of method definition for .init(STRING)

-----------------------------------------------------------------
define method .frameevent(!frame is GADGET, !event is STRING)
  --method to trigger methods from selecting tabs
  !currentobject = !this.$!this.currentancil

  if !frame.eq(!this.data) then
    !this.borematinit('tabinit')
  elseif !frame.eq(!this.activetab) then
    !this.activetabinit()
  elseif !frame.eq(!this.despars) then
    !this.desparsinit()
  elseif !frame.eq(!this.editrow) then
    !this.editrowinit('tabinit')
  elseif !frame.eq(!this.editcol) then
    !this.editcolinit('tabinit')
  elseif !frame.eq(!this.alt) then
    !this.altinit('tabinit')
  elseif !frame.eq(!this.userdespar) then
    !this.userinit('tabinit')
  endif

endmethod
-- End of method definition for .frameevent(GADGET, STRING)

---------------------------------------------------------------------
define method .borematinit(!mode is STRING)
  --method to set initial values in bore-specific gadgets on standard tab
  !currentobject = !this.$!this.currentancil
  !boresizearray = ARRAY()

  !framedataoptiondtext = ARRAY()
  !framedataoptionrtext = ARRAY()

  !framedataoptiondtext.append('Geometry')
  !framedataoptionrtext.append('GEOM')

  !framedataoptiondtext.append('Centre Line')
  !framedataoptionrtext.append('CLIN')

  !this.framedataoption.dtext = !framedataoptiondtext
  !this.framedataoption.rtext = !framedataoptionrtext

  do !i values !currentobject.bore
    !boresizearray.append(!i.size)
  enddo

  --pass argument - init, next or prev (initialised tab, clicked next arrow, clicked prev arrow)

  if !mode.eq('tabinit') then

    --!this.boresizearray = !boresizearray

    --on tab initialisation, setup text gadgets and initialise with values
    --from pickedfield of list in previous tab, or first value if no field picked
    if !currentobject.vendanddesparsflag.eq(TRUE) OR !currentobject.boreandclearanceonlyflag.eq(TRUE) then
      !this.selectedbore = !boresizearray[!this.indiceofselectedbore.real()].string()
    endif
    --!this.indiceofselectedbore = 1

    !this.standupbutton.active = TRUE
    !this.standdownbutton.active = TRUE
    if !this.indiceofselectedbore.eq(1) then
      !this.standupbutton.active = FALSE
    elseif !this.indiceofselectedbore.eq(!currentobject.bore.size()) then
      !this.standdownbutton.active = FALSE
    endif

  elseif !mode.eq('prev') then
    !this.standdownbutton.active = TRUE
    --if prev
    !this.indiceofselectedbore = !this.indiceofselectedbore - 1
    if !this.indiceofselectedbore.eq(1) then
      --set indiceofselectedbore back to 1
      !this.standupbutton.active = FALSE
      --!this.indiceofselectedbore = !this.indiceofselectedbore + 1
      --return error 1 'Minimum bore already selected'
      !this.selectedbore = !boresizearray[!this.indiceofselectedbore].string()
    else
      !this.standupbutton.active = TRUE
      !this.selectedbore = !boresizearray[!this.indiceofselectedbore].string()
    endif
    --if next
  elseif !mode.eq('next') then
    !this.standupbutton.active = TRUE
    !this.indiceofselectedbore = !this.indiceofselectedbore + 1
    if !this.indiceofselectedbore.eq(!currentobject.bore.size()) then
      --set indiceofselectedbore back to previously selected (max) value
      --!this.indiceofselectedbore = !this.indiceofselectedbore - 1
      --return error 1 'Maximum bore already selected'
      !this.standdownbutton.active = FALSE
      !this.selectedbore = !boresizearray[!this.indiceofselectedbore].string()
    else
      !this.standdownbutton.active = TRUE
      !this.selectedbore = !boresizearray[!this.indiceofselectedbore].string()
    endif

  endif
  if !currentobject.vendanddesparsflag.eq(TRUE) OR !currentobject.boreandclearanceonlyflag.eq(TRUE) then
    !this.boresizeparastand.val = !this.selectedbore
    !this.standtext1.val = !currentobject.bore[!this.selectedbore.real()].pipemat

    !this.standtext2.val = !currentobject.bore[!this.selectedbore.real()].prop

    !this.framedataoption.select('rtext',!currentobject.bore[!this.selectedbore.real()].frmwclropt)

    if (!this.imperial) then
      !inchReal = object REAL(!currentobject.bore[!this.selectedbore.real()].frmwclosedend & 'mm',!!unitFormat)
      !this.framedatatext1.val = !inchReal
      !inchReal = object REAL(!currentobject.bore[!this.selectedbore.real()].frmwopenend & 'mm',!!unitFormat)
      !this.framedatatext2.val = !inchReal
    else
      !this.framedatatext1.val = !currentobject.bore[!this.selectedbore.real()].frmwclosedend
      !this.framedatatext2.val = !currentobject.bore[!this.selectedbore.real()].frmwopenend
    endif
  else
    !this.boresizeparastand.val = 'unset'
    !this.standtext1.val = ''
    !this.standtext2.val = ''

    !this.framedatatext1.val = 0
    !this.framedatatext2.val = 0
  endif

endmethod
-- End of method definition for .borematinit(STRING)

---------------------------------------------------------------------
define method .activetabinit()
  --method to show active values for each bore, in active tab
  !currentobject = !this.$!this.currentancil

  --set active toggles to not visible - only visible when needed
  do !counter from 1 to 40
    !temp = '!this.toggle' & !counter.string() & '.visible'
    $!temp = FALSE
  enddo

  --set active toggles to not visible - only visible when needed
  do !counter from 1 to 40
    !temp = '!this.shoptoggle' & !counter.string() & '.visible'
    $!temp = FALSE
  enddo

  if !currentobject.vendanddesparsflag.eq(TRUE) then

    --set values of activetoggles, and set to visible if used
    !tempcounter = 1
    do !i value !currentobject.bore
      !temp = '!this.toggle' & $!tempcounter & '.tag'

      $!temp = '$!i.size'

      !temp2 = '!this.toggle' & !tempcounter.string() & '.visible'
      $!temp2 = TRUE

      !temp3 = '!this.toggle' & !tempcounter.string() & '.val'
      $!temp3 = !currentobject.bore[$!i.size].active

      !tempcounter = !tempcounter + 1
    enddo

    --SHOP FLAG TAB INIT ADDED BELOW;

    --set values of activetoggles, and set to visible if used
    !tempcounter = 1
    do !i value !currentobject.bore
      !temp = '!this.shoptoggle' & $!tempcounter & '.tag'
      $!temp = '$!i.size'

      !temp2 = '!this.shoptoggle' & !tempcounter.string() & '.visible'
      $!temp2 = TRUE

      !temp3 = '!this.shoptoggle' & !tempcounter.string() & '.val'
      $!temp3 = !currentobject.bore[$!i.size].shopflag

      !tempcounter = !tempcounter + 1
    enddo
  endif
endmethod
-- End of method definition for .activetabinit()

--------------------------------------------------------------------
define method .desparsinit()

  --run object method initdespars (now run from main init)
  --this method to display data from object in list

  !currentobject = !this.$!this.currentancil

  !this.$!this.currentancil = !currentobject

  if !currentobject.vendanddesparsflag.eq(TRUE) then

    --display object data on form

    !headings = ARRAY()
    !headings.append('Nom bore')
    !headings.append('Active')

    !dtext = ARRAY()

    !tempcounter = 1

    do !i value !currentobject.bore

      !dtext[!tempcounter][1] = !i.size.string()
      !dtext[!tempcounter][2] = !i.active.string()

      !numdespars = !currentobject.bore[!i.size].despar.size()

      do !j from 1 to !numdespars
        if (!this.imperial.not()) then
          !dtext[!tempcounter][!j + 2] = !currentobject.bore[!i.size].despar[!j]
        elseif (!currentobject.bore[!i.size].despar[!j].matchwild('*DESP*')) then
          !dtext[!tempcounter][!j + 2] = !currentobject.bore[!i.size].despar[!j]
        elseif (!currentobject.bore[!i.size].despardescription[!j].matchwild('*mum Insulation Thick*') and !currentobject.bore[!i.size].despar[!j] eq '-1') then
          !dtext[!tempcounter][!j + 2] = !currentobject.bore[!i.size].despar[!j]
        elseif (!this.imperial and !currentobject.bore[!i.size].despartype[!j] eq 'DIST') then
          --P-30561 <RM> added this handle block to account for LT04 and LT07 which have non-numeric despars
          !inchReal = object REAL(!currentobject.bore[!i.size].despar[!j] & 'mm',!!unitFormat)
          handle (2,813)
            !dtext[!tempcounter][!j + 2] = !currentobject.bore[!i.size].despar[!j]
          elsehandle NONE
            !inchString = object STRING(!inchReal,!!unitFormat)
            !dtext[!tempcounter][!j + 2] = !inchString
          endhandle
        else
          !dtext[!tempcounter][!j + 2] = !currentobject.bore[!i.size].despar[!j]
        endif
        --Put design parameter number as headings of list (from 3rd element
        --of !borename, first two are vendor and 0
        if !tempcounter.eq(1) then
          !headings.append(!j.string())
        endif

      enddo

      !tempcounter = !tempcounter + 1

    enddo

    !this.despararray = !dtext
    !this.desparssectlist.setheadings(!headings)
    !this.desparssectlist.setrows(!dtext)
    !this.desparssectlist.val = !this.indiceofselectedbore
  else
    !blank = ARRAY()
    !blank[1] = ''
    !this.desparssectlist.setheadings(!blank)
    !this.desparssectlist.clear()
  endif
endmethod
-- End of method definition for .desparsinit()

----------------------------------------------------------------------
define method .selectdesparbore()

  !this.indiceofselectedbore = !this.desparssectlist.pickedfield

endmethod
-- End of method definition for .selectdesparbore()

----------------------------------------------------------------------

define method .editrowinit(!mode is STRING)
  --method to display descriptions and design parameters for one row at a time of
  --the design parameter list, in the size tab

  !currentobject = !this.$!this.currentancil

  --pass argument - init, next or prev (initialised tab, clicked next arrow, clicked prev arrow)

  if !mode.eq('tabinit') then

    --on tab initialisation, setup text gadgets and initialise with values
    --from pickedfield of list in previous tab, or first value if no field picked

    --loop to set up 39 invisible text gadgets
    do !counter from 1 to 39
      !temp = '!this.text' & !counter.string() & '.visible'
      $!temp = FALSE
    enddo

    --Get selected bore from picked field of list gadget in parameters tab
    --if not picked, defaults to first field
    --if !this.desparssectlist.pickedfield.eq(0) then
    --  return
    --else
    !this.selectedbore = !this.despararray[!this.indiceofselectedbore][1]
    --  !this.selectedbore = !this.despararray[!this.desparssectlist.pickedfield][1]
    --  !this.indiceofselectedbore = !this.desparssectlist.pickedfield
    --endif

    !this.upbutton.active = TRUE
    !this.downbutton.active = TRUE
    if !this.indiceofselectedbore.eq(1) then
      !this.upbutton.active = FALSE
    elseif !this.indiceofselectedbore.eq(!currentobject.bore.size()) then
      !this.downbutton.active = FALSE
    endif

  elseif !mode.eq('prev') then
    !this.downbutton.active = TRUE
    --if prev
    !this.indiceofselectedbore = !this.indiceofselectedbore - 1
    if !this.indiceofselectedbore.eq(1) then

      !this.upbutton.active = FALSE

      !this.selectedbore = !this.despararray[!this.indiceofselectedbore][1]
    else
      !this.upbutton.active = TRUE
      !this.selectedbore = !this.despararray[!this.indiceofselectedbore][1]
    endif
    --if next
  elseif !mode.eq('next') then
    !this.upbutton.active = TRUE
    !this.indiceofselectedbore = !this.indiceofselectedbore + 1
    if !this.indiceofselectedbore.eq(!currentobject.bore.size()) then

      !this.downbutton.active = FALSE
      !this.selectedbore = !this.despararray[!this.indiceofselectedbore][1]
    else
      !this.downbutton.active = TRUE
      !this.selectedbore = !this.despararray[!this.indiceofselectedbore][1]
    endif

  endif

  if !currentobject.vendanddesparsflag.eq(TRUE) then
    !this.boresizepara.val = !this.selectedbore
  else
    !this.boresizepara.val = 'unset'
  endif

  --loop to set values of text gadgets and make invisible those not used
  do !j values !currentobject.dpnumber
    --    !indice = !currentobject.descnumberarray.findfirst(!j.real())
    !temp = '!this.text' & !j.string() & '.tag'

    !temp4 = '!currentobject.bore[' & !this.selectedbore & '].despardescription[' & !j & ']'
    !descwithnum = !j & '. ' & $!temp4

    $!temp = !descwithnum
    !temp2 = '!this.text' & !j.string() & '.val'
    -- Is this an imperial DIST value
    if (!this.imperial.not()) then
      $!temp2 = !currentobject.bore[!this.selectedbore.real()].despar[!j.real()]
    elseif (!currentobject.bore[!this.selectedbore.real()].despar[!j.real()].matchwild('*DESP*')) then
      $!temp2 = !currentobject.bore[!this.selectedbore.real()].despar[!j.real()]
    elseif (!currentobject.bore[!this.selectedbore.real()].despardescription[!j.real()].matchwild('*mum Insulation Thick*') and !currentobject.bore[!this.selectedbore.real()].despar[!j.real()] eq '-1') then
      $!temp2 = !currentobject.bore[!this.selectedbore.real()].despar[!j.real()]
    elseif (!this.imperial and !currentobject.bore[!this.selectedbore.real()].despartype[!j.real()] eq 'DIST') then
      !inchReal   = object REAL(!currentobject.bore[!this.selectedbore.real()].despar[!j.real()] & 'mm',!!unitFormat)
      handle ANY
        --P-30561 <RM> added this handle block to account for LT04 and LT07 which have non-numeric despars
        !inchReal   = object REAL(!currentobject.bore[!this.selectedbore.real()].despar[!j.real()],!!unitFormat)
        handle (2,813)
          $!temp2 = !currentobject.bore[!this.selectedbore.real()].despar[!j.real()]
        elsehandle NONE
          !inchString = object STRING(!inchReal,!!unitFormat)
          $!temp2 = !inchString
        endhandle
      elsehandle NONE
        !inchString = object STRING(!inchReal,!!unitFormat)
        $!temp2 = !inchString
      endhandle
    else
      $!temp2 = !currentobject.bore[!this.selectedbore.real()].despar[!j.real()]
    endif
    !temp3 = '!this.text' & !j.string() & '.visible'
    $!temp3 = TRUE
  enddo

endmethod
-- End of method definition for .editrowinit(STRING)

----------------------------------------------------------------------
define method .editcolinit(!mode is STRING)
  --method to display the values of a design parameter for all bores in parameter

  !currentobject = !this.$!this.currentancil

  if !mode.eq('tabinit') then

    --create array of descriptions with number for option gadget

    !descwithnumarray = ARRAY()
    !descnumarray = ARRAY()

    do !i values !currentobject.bore
      !firstboresize = !i.size
      break
    enddo

    do !j values !currentobject.dpnumber

      !descwithnum = !j & '. ' & !currentobject.bore[!firstboresize].despardescription[!j.real()]

      !descwithnumarray[!j.real()] = !descwithnum
      !descnumarray[!j.real()] = !currentobject.descnumberarray[!j.real()].string()
      handle ANY
        --        $p cannot find design parameter $!j in component dataset setting number to $!j
        !descnumarray[!j.real()] = !j.string()
      endhandle
    enddo

    --set dtext to description with number, rtext to number

    !this.editcoloption1.dtext = !descwithnumarray
    !this.editcoloption1.rtext = !descnumarray

  endif

  --set headings of list to bore and value

  !editcolheadings = ARRAY()
  !editcolheadings.append('Bore')
  !editcolheadings.append('Value')

  !this.editcollist.setheadings(!editcolheadings)

  --loop to create dtext for list gadget, bore number then dp val

  !editcoldtext = ARRAY()
  !boresizes = ARRAY()

  if !currentobject.boreandclearanceonlyflag.not() then

    !tempcounter = 1
    do !i value !currentobject.bore
      !boresizes[!tempcounter] = !i.size.string()

      !editcoldtext[!tempcounter][1] = !i.size.string()
      if (!this.imperial.not()) then
        -- Use the standard if not in imperial
        !editcoldtext[!tempcounter][2] = !i.despar[!this.editcoloption1.selection().real()]
      elseif (!i.despar[!this.editcoloption1.selection().real()].matchwild('*DESP*')) then
        !editcoldtext[!tempcounter][2] = !i.despar[!this.editcoloption1.selection().real()]
        -- otherwise don't try and convert anything with DESP
      elseif (!i.despardescription[!this.editcoloption1.selection().real()].matchwild('*mum Insulation Thick*') and !i.despar[!this.editcoloption1.selection().real()] eq '-1') then
        -- special for insulation being -1 in imperial (do not convert it)
        !editcoldtext[!tempcounter][2] = !i.despar[!this.editcoloption1.selection().real()]
      elseif (!this.imperial and !i.despartype[!this.editcoloption1.selection().real()] eq 'DIST') then
        !inchReal   = object REAL(!i.despar[!this.editcoloption1.selection().real()] & 'mm',!!unitFormat)
        handle ANY
          --P-30561 <RM> added this handle block to account for LT04 and LT07 which have non-numeric despars
          !inchReal   = object REAL(!i.despar[!this.editcoloption1.selection().real()],!!unitFormat)
          handle ANY
            !editcoldtext[!tempcounter][2] = !i.despar[!this.editcoloption1.selection().real()]
          endhandle
        elsehandle NONE
          !inchString = object STRING(!inchReal,!!unitFormat)
          !editcoldtext[!tempcounter][2] = !inchString
        endhandle
      else
        !editcoldtext[!tempcounter][2] = !i.despar[!this.editcoloption1.selection().real()]
        handle ANY
        endhandle
      endif

      !tempcounter = !tempcounter + 1

    enddo

  endif

  --set rows of list to current despar
  !this.editcollist.setrows(!editcoldtext)

  --put list of bore values in two option gadgets
  !this.editcoloption2.dtext = !boresizes
  !this.editcoloption3.dtext = !boresizes

endmethod
-- End of method definition for .editcolinit(STRING)

---------------------------------------------------------------------------------------

define method .altinit(!mode is STRING)
  --method to display alternative expressions and design parameters, by bore

  !this.alttext1.active = TRUE
  !this.alttext2.active = TRUE

  !currentobject = !this.$!this.currentancil

  --pass argument - init, next or prev (initialised tab, clicked next arrow, clicked prev arrow)

  if !mode.eq('tabinit') then

    --if !this.desparssectlist.pickedfield.eq(0) then
    --  return
    --else
    --  !this.selectedbore = !this.despararray[!this.desparssectlist.pickedfield][1]
    !this.selectedbore = !this.despararray[!this.indiceofselectedbore][1]
    -- !this.indiceofselectedbore = !this.desparssectlist.pickedfield
    -- endif

    !this.altupbutton.active = TRUE
    !this.altdownbutton.active = TRUE
    if !this.indiceofselectedbore.eq(1) then
      !this.altupbutton.active = FALSE
    elseif !this.indiceofselectedbore.eq(!currentobject.bore.size()) then
      !this.altdownbutton.active = FALSE
    endif

  elseif !mode.eq('prev') then
    !this.altdownbutton.active = TRUE
    --if prev
    !this.indiceofselectedbore = !this.indiceofselectedbore - 1
    if !this.indiceofselectedbore.eq(1) then
      !this.altupbutton.active = FALSE
      !this.selectedbore = !this.despararray[!this.indiceofselectedbore][1]
    else
      !this.altupbutton.active = TRUE
      !this.selectedbore = !this.despararray[!this.indiceofselectedbore][1]
    endif
    --if next
  elseif !mode.eq('next') then
    !this.altupbutton.active = TRUE
    !this.indiceofselectedbore = !this.indiceofselectedbore + 1
    if !this.indiceofselectedbore.eq(!currentobject.bore.size()) then
      !this.altdownbutton.active = FALSE
      !this.selectedbore = !this.despararray[!this.indiceofselectedbore][1]
    else
      !this.altdownbutton.active = TRUE
      !this.selectedbore = !this.despararray[!this.indiceofselectedbore][1]
    endif

  endif

  do !counter from 1 to 6
    !temp1 = '!this.altdesptext1d' & !counter.string() & '.visible'
    !temp2 = '!this.altdesptext2d' & !counter.string() & '.visible'
    $!temp1 = FALSE
    $!temp2 = FALSE
  enddo

  if !currentobject.vendanddesparsflag.eq(TRUE) then
    !this.altboresizepara.val = !this.selectedbore
  else
    !this.altboresizepara.val = 'unset'
  endif

  !this.alttext1.val = !currentobject.bore[!this.selectedbore.real()].altexpr[1]
  handle ANY
    !this.alttext1.val = 'unset'
    !this.alttext1.active = FALSE
  endhandle
  !this.alttext2.val = !currentobject.bore[!this.selectedbore.real()].altexpr[2]
  handle ANY
    !this.alttext2.val = 'unset'
    !this.alttext2.active = FALSE
  endhandle
  if defined(!currentobject.bore[!this.selectedbore.real()].altexpr[1]) then
    if !currentobject.bore[!this.selectedbore.real()].altexpr[1].unset().not() then

      do !i index !currentobject.bore[!this.selectedbore.real()].altdesparval[1]

        !temp = '!this.altdesptext1d' & !i.string() & '.val'
        !temp2 = '!this.altdesptext1d' & !i.string() & '.tag'
        $!temp = !currentobject.bore[!this.selectedbore.real()].altdesparval[1][!i]

        $!temp2 = 'Alt des par ' & !currentobject.bore[!this.selectedbore.real()].altdesparnumber[1][!i]
        if !currentobject.bore[!this.selectedbore.real()].altdesparval[1][!i].unset().not() then
          !temp3 = '!this.altdesptext1d' & !i.string() & '.visible'
          $!temp3 = TRUE
        endif
      enddo
    endif
  endif
  if defined(!currentobject.bore[!this.selectedbore.real()].altexpr[2]) then
    if !currentobject.bore[!this.selectedbore.real()].altexpr[2].unset().not() then

      do !i index !currentobject.bore[!this.selectedbore.real()].altdesparval[2]

        !temp = '!this.altdesptext2d' & !i.string() & '.val'
        !temp2 = '!this.altdesptext2d' & !i.string() & '.tag'
        $!temp = !currentobject.bore[!this.selectedbore.real()].altdesparval[2][!i]
        $!temp2 = 'Alt des par ' & !currentobject.bore[!this.selectedbore.real()].altdesparnumber[2][!i]
        if !currentobject.bore[!this.selectedbore.real()].altdesparval[2][!i].unset().not() then
          !temp3 = '!this.altdesptext2d' & !i.string() & '.visible'
          $!temp3 = TRUE
        endif
      enddo
    endif
  endif

endmethod
-- End of method definition for .altinit(STRING)
------------------------------------------------------------------------------
define method .userinit(!mode is STRING)

  !currentobject = !this.$!this.currentancil

  --pass argument - init, next or prev (initialised tab, clicked next arrow, clicked prev arrow)

  if !mode.eq('tabinit') then

    do !counter from 1 to 12
      !temp = '!this.userdespmintext' & !counter.string() & '.visible'
      !temp2 = '!this.userdespmaxtext' & !counter.string() & '.visible'
      !temp3 = '!this.userdesppara' & !counter.string() & '.visible'
      $!temp = FALSE
      $!temp2 = FALSE
      $!temp3 = FALSE
    enddo

    --if !this.desparssectlist.pickedfield.eq(0) then
    --  return
    --else
    !this.selectedbore = !this.despararray[!this.indiceofselectedbore][1]
    --  !this.selectedbore = !this.despararray[!this.desparssectlist.pickedfield][1]
    --  !this.indiceofselectedbore = !this.desparssectlist.pickedfield
    --endif

    !this.userupbutton.active = TRUE
    !this.userdownbutton.active = TRUE
    if !this.indiceofselectedbore.eq(1) then
      !this.userupbutton.active = FALSE
    elseif !this.indiceofselectedbore.eq(!currentobject.bore.size()) then
      !this.userdownbutton.active = FALSE
    endif

  elseif !mode.eq('prev') then
    !this.userdownbutton.active = TRUE
    --if prev
    !this.indiceofselectedbore = !this.indiceofselectedbore - 1
    if !this.indiceofselectedbore.eq(1) then
      !this.userupbutton.active = FALSE
      !this.selectedbore = !this.despararray[!this.indiceofselectedbore][1]
    else
      !this.userupbutton.active = TRUE
      !this.selectedbore = !this.despararray[!this.indiceofselectedbore][1]
    endif
    --if next
  elseif !mode.eq('next') then
    !this.userupbutton.active = TRUE
    !this.indiceofselectedbore = !this.indiceofselectedbore + 1
    if !this.indiceofselectedbore.eq(!currentobject.bore.size()) then
      !this.userdownbutton.active = FALSE
      !this.selectedbore = !this.despararray[!this.indiceofselectedbore][1]
    else
      !this.userdownbutton.active = TRUE
      !this.selectedbore = !this.despararray[!this.indiceofselectedbore][1]
    endif

  endif

  if !currentobject.vendanddesparsflag.eq(TRUE) then
    !this.userboresizepara.val = !this.selectedbore
  else
    !this.userboresizepara.val = 'unset'
  endif

  do !i index !currentobject.bore[!this.selectedbore.real()].userdespmin
    !temp = '!this.userdespmintext' & !i.string() & '.val'
    !temp2 = '!this.userdespmaxtext' & !i.string() & '.val'
    !temp3 = '!this.userdesppara' & !i.string() & '.val'
    if (!this.imperial and !currentobject.bore[!this.selectedbore.real()].despartype[!i] eq 'DIST') then
      !inchReal   = object REAL(!currentobject.bore[!this.selectedbore.real()].userdespmin[!i] & 'mm',!!unitFormat)
      !inchString = object STRING(!inchReal,!!unitFormat)
      $!temp = !inchString
      !inchReal   = object REAL(!currentobject.bore[!this.selectedbore.real()].userdespmax[!i] & 'mm',!!unitFormat)
      !inchString = object STRING(!inchReal,!!unitFormat)
      $!temp2 = !inchString
    else
      $!temp = !currentobject.bore[!this.selectedbore.real()].userdespmin[!i]
      $!temp2 = !currentobject.bore[!this.selectedbore.real()].userdespmax[!i]
    endif
    $!temp3 = 'Des par ' & !currentobject.bore[!this.selectedbore.real()].userdespnum[!i]

    !temp4 = '!this.userdespmintext' & !i.string() & '.visible'
    !temp5 = '!this.userdespmaxtext' & !i.string() & '.visible'
    !temp6 = '!this.userdesppara' & !i.string() & '.visible'

    $!temp4 = TRUE
    $!temp5 = TRUE
    $!temp6 = TRUE

  enddo

endmethod

