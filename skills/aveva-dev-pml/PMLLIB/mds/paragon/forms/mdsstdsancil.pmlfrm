define method .writepropmatvalid(!textin is GADGET, !action is STRING)
  --method to validate input into prop mat field
  --collect names of all soli

  !matworldname = '/Material-World'
  !matworldref = !matworldname.dbref()
  handle ANY
    !!alert.warning('$!matworldname not found - cannot verify input into Propcon - MDS Ancillary Material')
  elsehandle NONE

    var !solicoll collect all soli for $!matworldref
    var !solinames eval name for all from !solicoll
    !arrayoftextin = !textin.val.split(',')

    if !arrayoftextin.unset() then
      return error 1 'No blank values should be given (input format example: /CARBON/STEEL)'
    else

      !errorstring = ''

      do !i index !arrayoftextin
        !currenttextin = !arrayoftextin[!i].trim()
        if !currenttextin.eq('') then
          return error 1 'No blank values should be given (input format example: /CARBON/STEEL)'
        elseif !currenttextin.eq('ALL') and !arrayoftextin.size().gt(1) then
          return error 1 'ALL may only be entered with no other codes'
        endif

        !findarray = !solinames.find(!currenttextin)
        if !arrayoftextin[1].eq('ALL') then
          break
        elseif !findarray.unset() then
          !errorstring = !errorstring & ' ' & !currenttextin
        endif
      enddo

      if !errorstring.neq('') then
        return error 1 '$!errorstring not valid pipe material(s)'
      endif
    endif
  endhandle
endmethod
-- End of method definition for .writepropmatvalid(GADGET, STRING)
---------------------------------------------------------------------

