    !valReal = object REAL(!val,!!distanceFmt)
    !currentobject.bore[!this.selectedbore.real()].userdespmin[!number] = !valReal.string()
  else
    !currentobject.bore[!this.selectedbore.real()].userdespmin[!number] = $!temp
  endif
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
  !units.restoreSavedUnitsByPtype('DIST')
endmethod
-- End of method definition for .writeuserdespmin(REAL)
