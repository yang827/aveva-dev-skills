define method .writeelevvalid(!textin is GADGET, !action is STRING)
  --method to validate input into elevation restriction field
  if !textin.val.match(' ').gt(0) then
    return error 1 'Value must not contain spaces'
  endif
  handle ANY
  endhandle
  if (!this.imperial) then
    !test = object REAL(!textin.val,!!unitFormat)
    handle ANY
      if !textin.val.neq('*') then
        return error 1 'Expecting a * character or number'
      endif
    elsehandle NONE
      if(!textin.val.unset() or !textin.val.empty()) then
        return error 1 'Field is unset'
      endif
    endhandle
  else
    !test = !textin.val.real()
    handle ANY
      if !textin.val.neq('*') then
        return error 1 'Expecting a * character or number'
      endif
    elsehandle NONE
      if(!textin.val.unset() or !textin.val.empty()) then
        return error 1 'Field is unset'
      endif
    endhandle
  endif
endmethod
-- End of method definition for .writeelevvalid(GADGET, STRING)

----------------------------------------------------------------

define method .writeelev()

  !units = object COMUNITS(TRUE)
  if (!!isImperialLength('DIST').not()) then
    UNITS MM DIST
  endif
  !currentobject = !this.$!this.currentancil
  !val = !this.datatext4.val
  -- If an imperial we need to store it in mm
  if (!this.imperial and !val neq '*') then
    !valReal = object REAL(!val,!!distanceFmt)
    !currentobject.elevval = !valReal.string()
  else
    !currentobject.elevval = !this.datatext4.val
  endif
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
  !units.restoreSavedUnitsByPtype('DIST')
endmethod
-- End of method definition for .writeelev()

