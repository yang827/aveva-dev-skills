define method .writetodatabase()
  --method to write to database, upon hitting apply button

  !units = object COMUNITS(TRUE)
  if (!!isImperialLength('DIST').not()) then
    UNITS MM DIST
  endif

  do !i values !this.sectdescgen
    --loop through array of descriptions of standards
    --store modified tag, and dbrefs for write backs in local variables

    !modified = '!this.' & !i & '.modified'


    if $!modified eq TRUE then
      --      $P $!i modified, writing newly entered values to DB
      !currentobject = !this.$!i

      !!co = !currentobject

      !rnameref = '!this.' & !i & '.rnamedbref.pproperty'
      !rnamevaldelim = |'| & !currentobject.rnameval & |'|
      $!rnameref = !rnamevaldelim

      !suppfuncref = '!this.' & !i & '.suppfuncdbref.pproperty'
      !suppfuncvaldelim = |'| & !currentobject.suppfuncval & |'|
      handle any
      elsehandle none
        $!suppfuncref = !suppfuncvaldelim
        handle (2,754)
          !!alert.warning('SUPF data element does not exist in /MDS/PRELIMINARY/DEFAULTS. Please upgrade Aveva DB.')
        endhandle
      endhandle

      ---------------------------------------------------------------------------------------------------
      --<wd>july2007
      --Original MJB Code before changes by <wd>july2007
      --Original MJB Code before changes by <wd>july2007       !savedrow = !this.datasectlist.val
      --Original MJB Code before changes by <wd>july2007 --Create objects with name, rname and dbref of all trunnions
      --Original MJB Code before changes by <wd>july2007 --(one-off creation on form definition)
      --Original MJB Code before changes by <wd>july2007       !this.ancillistarray[$!savedrow][2] = !rnamevaldelim.after(|'|).before(|'|)
      --Original MJB Code before changes by <wd>july2007       !this.datasectlist.setrows(!this.ancillistarray)
      --Original MJB Code before changes by <wd>july2007       !this.sectrnamegen[$!savedrow] = !rnamevaldelim.after(|'|).before(|'|)
      --Original MJB Code before changes by <wd>july2007       !this.datasectlist.val = !savedrow

      -- The ORIGINAL setting of !savedrow = !this.datasectlist.val -- DOES NOT GIVE the CORRECT SELECTION in the COMPLETE LIST ('ALL')
      -- of MDS STANDARDS when an ICON FILTER such as 'BT' is clicked and the list stored in the variable "!this.datasectlist" ONLY
      -- represents the 'BT', i.e. U Bolts, type of supports. Therefore the variable "!savedrow" needs to be determined
      -- from the COMPLETE LIST ('ALL') of MDS ANCILLARY Standards stored in the variable "!this.ancillistrtrext"
      -- A new variable is now declared to store the ICON FILTER LIST ROW SELECTION number,
      -- i.e. !savedrowfilter = !this.datasectlist.val
      --      !savedrow = !this.datasectlist.val
      !savedrowfilter = !this.datasectlist.val
      !savedrow =  !this.ancillistrtext.findfirst(!this.datasectlist.dtext [!this.datasectlist.val].split()[1] )
      --<wd>july2007
      ---------------------------------------------------------------------------------------------------

      --Create objects with name, rname and dbref of all trunnions
      --(one-off creation on form definition)
      !this.ancillistarray[$!savedrow][2] = !rnamevaldelim.after(|'|).before(|'|)

      !this.datasectlist.setrows(!this.ancillistarray)

      !this.sectrnamegen[$!savedrow] = !rnamevaldelim.after(|'|).before(|'|)

      ---------------------------------------------------------------------------------------------------
      --<wd>july2007
      -- Ensure the ORIGINAL ICON FILTER "LIST TYPE" is displayed to the user, i.e. 'ALL', 'BT' etc...
      !this.iconfilter(!this.currenticonfilter)

      -- Reselect the ORIGINALLY Selected Row number in the LIST of the Current ICON FILTER type list
      --      !this.datasectlist.val = !savedrow
      !this.datasectlist.val = !savedrowfilter
      --<wd>july2007
      ---------------------------------------------------------------------------------------------------

      !descriptionref = '!this.' & !i & '.descriptiondbref.pproperty'
      !descriptiondelim = |'| & !currentobject.description & |'|
      $!descriptionref = !descriptiondelim

      !activeref = '!this.' & !i & '.dbref.:MDSActive'
      $!activeref = !currentobject.active

      --the following items need text delimeters added to the string to be entered
      --as values in the database (activeref does not - boolean)

      if !currentobject.vendanddesparsflag.eq(TRUE) OR !currentobject.boreandclearanceonlyflag.eq(TRUE) then

        if !currentobject.boreandclearanceonlyflag.not() then

          !vendref = '!this.' & !i & '.venddbref.pproperty'
          !vendvaldelim = |'| & !currentobject.vendval & |'|
          $!vendref = !vendvaldelim
          --handle ANY
          --handle no despars cases
          --elsehandle NONE

          !elevref = '!this.' & !i & '.elevdbref.pproperty'
          !elevvaldelim = |'| & !currentobject.elevval & |'|
          $!elevref = !elevvaldelim

          !pipematref = '!this.' & !i & '.pipematdbref.pproperty'
          !pipematvaldelim = |'| & !currentobject.pipematval & |'|
          $!pipematref = !pipematvaldelim

          !propref = '!this.' & !i & '.propdbref.pproperty'
          !propvaldelim = |'| & !currentobject.propval & |'|
          $!propref = !propvaldelim

          !isofref = '!this.' & !i & '.isofdbref.pproperty'
          !isofvaldelim = |'| & !currentobject.isofval & |'|
          $!isofref = !isofvaldelim

        endif

        do !j values !currentobject.bore
          --loop over bore sizes

          !frmwclosedendref = '!this.' & !i & '.bore[' & !j.size & '].frmwclosedenddbref.pproperty'
          !frmwclosedendvaldelim = !currentobject.bore[!j.size].frmwclosedend
          $!frmwclosedendref = !frmwclosedendvaldelim.string()

          !frmwopenendref = '!this.' & !i & '.bore[' & !j.size & '].frmwopenenddbref.pproperty'
          !frmwopenendvaldelim = !currentobject.bore[!j.size].frmwopenend
          $!frmwopenendref = !frmwopenendvaldelim.string()

          !frmwclroptref = '!this.' & !i & '.bore[' & !j.size & '].frmwclroptdbref.pproperty'
          !frmwclroptvaldelim = |'| & !currentobject.bore[!j.size].frmwclropt & |'|
          $!frmwclroptref = !frmwclroptvaldelim

          if !currentobject.boreandclearanceonlyflag.not() then

            !boreactiveref = '!this.' & !i & '.bore[' & !j.size & '].dbref.:MDSActive'
            $!boreactiveref = !currentobject.bore[!j.size].active

            !shopflagref = '!this.' & !i & '.bore[' & !j.size & '].shopflagdbref.pproperty'
            !shopflagvaldelim = |'| & !currentobject.bore[!j.size].shopflag.string() & |'|
            $!shopflagref = !shopflagvaldelim

            !borepropref = '!this.' & !i & '.bore[' & !j.size & '].propdbref.pproperty'
            !borepropvaldelim = |'| & !currentobject.bore[!j.size].prop & |'|
            $!borepropref = !borepropvaldelim

            !borepipematref = '!this.' & !i & '.bore[' & !j.size & '].pipematdbref.pproperty'
            !borepipematvaldelim = |'| & !currentobject.bore[!j.size].pipemat & |'|
            $!borepipematref = !borepipematvaldelim



            do !p index !currentobject.bore[!j.size].altexpr
              --loop over alternative expressions

              !altexprref = '!this.' & !i & '.bore[' & !j.size & '].altexprdbref[' & !p.string() & '].pproperty'

              !tempstring = '!currentobject.bore[!j.size]' & '.altexpr[' & !p.string() & ']'

              !altexprvaldelim = |( '| & $!tempstring & |' )|

              $!altexprref = !altexprvaldelim

              do !m index !currentobject.bore[!j.size].altdesparval[!p]
                --write alt despar values
                --numbers are currently not edited (same dbref though, just number, not pproperty)
                !altdesparvalref = '!this.' & !i & '.bore[' & !j.size & '].altdespardbref[' & !p.string() & '][' & !m.string() & '].pproperty'
                --!altdesparnumref = '!this.' & !i & '.bore[' & !j.size & '].altdespardbref[' & !p.string() & '][' & !m.string() & '].number'

                !temp = !currentobject.bore[!j.size].altdesparval[!p][!m]
                !altdesparvaldelim = |( | & !temp & | )|

                --!temp2 = !currentobject.bore[!j.size].altdesparnum[!p][!m]
                --!altdesparnumvaldelim = |( | & '!currentobject.bore[!j.size].altdesparnum[' & !p.string() & '][' & !m.string() & ']' & | )|

                $!altdesparvalref = !altdesparvaldelim

              enddo

            enddo

            do !k index !currentobject.bore[!j.size].despar
              !ptype =!currentobject.ptypearray[!k]
              handle ANY
                !ptype = ''
              endhandle
              --loop over despars
              !desparref = '!this.' & !i & '.bore[' & !j.size & '].despardbref[' & !k.string() & '].pproperty'
              if (!ptype eq 'ANGL') then
                !valReal = object REAL(|$!currentobject.bore[$!j.size].despar[$!k]|,!!angleFmt)
                !valReal=!valReal.value()
                !desparvaldelim = |( '| & $!valReal & |' )|
              elseif (!ptype eq 'TEMP') then
                !valReal = object REAL(|$!currentobject.bore[$!j.size].despar[$!k]|,!!temperatureFmt)
                !valReal=!valReal.value()
                !desparvaldelim = |( '| & $!valReal & |' )|
              elseif (!ptype eq 'DIST' and !currentobject.bore[!j.size].despar[!k].matchwild('*DESP*')) then
                !desparvaldelim = |'| & !currentobject.bore[!j.size].despar[!k] & |'|
              elseif (!ptype eq 'DIST' and !currentobject.bore[!j.size].despardescription[!k].matchwild('*mum Insulation Thick*') and !currentobject.bore[!j.size].despar[!k] eq '-1') then
                !desparvaldelim = |'| & !currentobject.bore[!j.size].despar[!k] & |'|
              elseif (!ptype eq 'DIST') then
                !valReal = object REAL(|$!currentobject.bore[$!j.size].despar[$!k]|,!!distanceFmt)
                !valReal=!valReal.value()
                !desparvaldelim = |( '| & $!valReal & |' )|
              else
                !desparvaldelim = |'| & !currentobject.bore[!j.size].despar[!k] & |'|
              endif

              $!desparref = !desparvaldelim
            enddo

            do !n index !currentobject.bore[!j.size].userdespmin
              !userdesparminref = '!this.' & !i & '.bore[' & !j.size & '].userdespmindbref[' & !n.string() & '].pproperty'
              !userdesparmaxref = '!this.' & !i & '.bore[' & !j.size & '].userdespmaxdbref[' & !n.string() & '].pproperty'
              if (!this.imperial and !currentobject.bore[!j.size].despartype[!n] eq 'DIST') then
                !valReal = object REAL(|$!currentobject.bore[$!j.size].userdespmin[$!n]|,!!distanceFmt)
                !userdespminvaldelim = |( '| & $!valReal & |' )|
                !valReal = object REAL(|$!currentobject.bore[$!j.size].userdespmax[$!n]|,!!distanceFmt)
                !userdespmaxvaldelim = |( '| & $!valReal & |' )|
              else
                !userdespminvaldelim = |'| & !currentobject.bore[!j.size].userdespmin[!n] & |'|
                !userdespmaxvaldelim = |'| & !currentobject.bore[!j.size].userdespmax[!n] & |'|
              endif
              $!userdesparminref = !userdespminvaldelim
              $!userdesparmaxref = !userdespmaxvaldelim
            enddo

          endif

        enddo
        --endhandle
        --reset modified flag to false once changes in object have been applied to DB
        $!modified = FALSE

      endif
    endif
  enddo
  !selected = !this.datasectlist.dtext[!this.datasectlist.val].split()
  !this.supstandardname.val = !selected[1]
  !this.datarname.val       = !selected[2]
  !units.restoreSavedUnitsByPtype('DIST')
  !this.init('UPDATE')

endmethod
-- End of method definition for .writetodatabase()

----------------------------------------------------------------------

define method .cancelformmethod()
  !localmodifiedflag = FALSE
  do !i values !this.sectdescgen
    --loop through array of descriptions of standards
    --if modified TRUE flag found, give options in alert

    !modified = '!this.' & !i & '.modified'

    if ($!modified eq TRUE AND !this.writeflag eq TRUE) then
      !localmodifiedflag = TRUE
      !answer = !!alert.question('Do you wish to apply changes?')
      if !answer.eq('YES') then
        !this.writetodatabase()
        !this.hide()
        break
      elseif !answer.eq('NO') then
        !this.hide()
        break
      elseif !answer.eq('CANCEL') then
        break
      endif
    elseif ($!modified eq TRUE AND !this.writeflag eq FALSE) then
      !localmodifiedflag = TRUE
      !!alert.warning('Changes made on form cannot be applied; you do not have write access')
    endif

  enddo

  if !localmodifiedflag.eq(FALSE) then
    !this.hide()
  endif

endmethod
-- End of method definition for .cancelformmethod()

----------------------------------------------------------------------
define method .writecheck()
  --method to check if user has db write access
  --NB see also kCheckWrite
  --need to check locked as well?
  --see MDSDAC?
  !this.writeflag = DBwrite
  if !this.writeflag.eq(FALSE) then
    --no write access
    !!alert.warning('You do not have write access')
    --grey out apply button (as changes cannot be applied to DB)
    !this.apply.active = FALSE
  else
    !this.apply.active = TRUE
  endif

endmethod
-- End of method definition for .writecheck()

---------------------------------------------------------------------

define method .iconfilter(!type is STRING)

  --method to filter list on icon selected
  --modified from method in mdsancill.pmlfrm
  if !type.eq('ALL') then
    !this.datasectlist.setrows(!this.ancillistarray)

    !this.datasectlist.rtext = !this.ancillistrtext
  else

    !tempdtext = ARRAY()

    do !remove from 1 to !this.ancillistarray.size()

      if !this.ancillistarray[$!remove][1].match(!type.trim()).eq(1) then

        --!tempdtext[$!remove][1] = !this.ancillistarray[!remove][1]
        !tempdtext[$!remove][1] = !this.stypelist[!remove]
        !tempdtext[$!remove][2] = !this.ancillistarray[!remove][2]

        !temprtext[$!remove] = !this.ancillistrtext[!remove]
      endif
    enddo

    !this.datasectlist.setrows(!tempdtext)

    !this.datasectlist.rtext = !temprtext
  endif
  !this.init(|UPDATE|)

  --<wd>july2007
  -- New member added to store the CURRENT ICON FILTER "LIST TYPE" -- The Default on Initialisation is "ALL"
  !this.currenticonfilter = !type
  --<wd>july2007

endmethod
-- End of method definition for .iconfilter(STRING)

----------------------------------------------------------------------

---------------------------------------------------------------------

define method .createudp()

  --method to create a new user design parameter
  --modified from method in mdsancill.pmlfrm

  !despar = !!alert.input('Enter Design Parameter Number','0')

  -- test if not still default of 0

  if !despar.eq('0') then
    return
  endif

  -- test if real
  !testint = !despar.real()
  handle ANY
    !!alert.error('The design parameter value must be an integer')
    return
  endhandle

  -- Make sure despar is a integer

  !desint = (int(!testint))

  -- Access correct position in the hierarchy

  !currentobject = !this.$!this.currentancil
  !currentstd = !currentobject.mainnameval
  !currentbore = !this.userboresizepara

  do !loop values !currentobject.bore
    !size = !loop.size
    !!ce = /MDS/ATTA/DEFAULTS/$!currentstd/$!size/UDESPAR
    -- Create user despar
    handle NONE
      LAST MEM
      handle ANY
      endhandle
      NEW DATA /MDS/ATTA/DEFAULTS/$!currentstd/$!size/UDESPAR/$!desint/MIN
      handle (41,12)
        !!alert.error('User design parameter number $!desint already exists')
        delete data
        return
      endhandle
      DESC 'AT01'
      DKEY UMIN
      PPRO ( '0' )
      PURP USER
      NUMB $!desint
      DTIT 'USER DESPAR Minimum Value'
      NEW DATA /MDS/ATTA/DEFAULTS/$!currentstd/$!size/UDESPAR/$!desint/MAX
      DESC 'AT01'
      DKEY UMAX
      --<wd>jun2007 -- Default Maximum Value changed from 1000 to 0<zero>
      --        PPRO ( '1000' )
      PPRO ( '0' )
      --<wd>jun2007
      PURP USER
      NUMB $!desint
      DTIT 'USER DESPAR Maximum Value'
    elsehandle (41,12)
      !!alert.error('User design parameter for $!currentstd at $!currentbore (/MDS/ATTA/DEFAULTS/$!currentstd/$!size/UDESPAR) already exists')
      skip
    elsehandle ANY
      !!alert.error('Unable to find user design parameters area for $!currentstd at $!currentbore (/MDS/ATTA/DEFAULTS/$!currentstd/$!size/UDESPAR)')
      skip
    endhandle
  enddo

  -- Call frame event for tab

  !currentobject.initdata()
  !currentobject.initdespars()
  !this.$!this.currentancil = !currentobject
  !this.userinit('tabinit')

endmethod
-- End of method definition for .createudp()

----------------------------------------------------------------------

---------------------------------------------------------------------

define method .deleteudp()

  --Method to DELETE a User Design Parameter

  !despar = !!alert.input('Enter Design Parameter Number','0')

  -- Test if not still default of 0
  if !despar.eq('0') then
    return
  endif

  -- Test if real
  !testint = !despar.real()
  handle ANY
    !!alert.error('The Design Parameter value must be an integer')
    return
  endhandle

  -- Make sure Despar is a integer
  !desint = (int(!testint))

  -- Access correct position in the hierarchy
  !currentobject = !this.$!this.currentancil
  !currentstd = !currentobject.mainnameval
  !currentbore = !this.userboresizepara

  -- Confirm USER wants to DELETE the SELECTED USER DESIGN Parameters for the Current MDS Support Standard Ancillary Type
  if (!!alert.confirm('REMOVE the User Design Parameter Number $!desint from the MDS Support Type $!currentstd?').eq('NO')) then
    return
  endif

  -- DELETE the SELECTED USER DESIGN Parameters for the Current MDS Support Standard Ancillary Type
  do !loop values !currentobject.bore
    !size = !loop.size
    -- Navigate to the OWNING User Design Parameters DTSE
    !!ce = /MDS/ATTA/DEFAULTS/$!currentstd/$!size/UDESPAR
    -- Delete User Despar
    handle NONE
      /MDS/ATTA/DEFAULTS/$!currentstd/$!size/UDESPAR/$!desint/MIN
      handle (2,109)
        !!alert.error('MINIMUM - User Design Parameter number $!desint does NOT exist for Bore Size $!size')
      elsehandle NONE
        delete data
      endhandle

      /MDS/ATTA/DEFAULTS/$!currentstd/$!size/UDESPAR/$!desint/MAX
      handle (2,109)
        !!alert.error('MAXIMUM - User Design Parameter number $!desint does NOT exist for Bore Size $!size')
      elsehandle NONE
        delete data
      endhandle
    elsehandle ANY
      !!alert.error('Unable to find the User Design Parameter Dataset for $!currentstd at Bore Size $!size i.e. (/MDS/ATTA/DEFAULTS/$!currentstd/$!size/UDESPAR)')
      skip
    endhandle
  enddo

  -- Call frame event for tab
  !currentobject.initdata()
  !currentobject.initdespars()
  !this.$!this.currentancil = !currentobject
  !this.userinit('tabinit')

endmethod
-- End of method definition for .deleteudp()

