define method .writeframedatatext1()
  !currentobject = !this.$!this.currentancil
  !units = object COMUNITS(TRUE)
  if (!!isImperialLength('DIST').not()) then
    UNITS MM DIST
  endif

  -- If an imperial we need to store it in mm
  if (!this.imperial) then
    !val = !this.framedatatext1.val.string()
    !valReal = object REAL(!val,!!distanceFmt)
    !currentobject.bore[!this.selectedbore.real()].frmwclosedend  = !valReal
  else
    !currentobject.bore[!this.selectedbore.real()].frmwclosedend = !this.framedatatext1.val
  endif
  !units.restoreSavedUnitsByPtype('DIST')
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
endmethod
-- End of method definition for .writeframedatatext1()
