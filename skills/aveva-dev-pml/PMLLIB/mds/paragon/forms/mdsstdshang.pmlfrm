--
--
-- Description:
-- Form to modify hanger defaults
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  activeframe(GADGET,STRING)       -
--  cancelformmethod()               -
--  frameevent(GADGET,STRING)        -
--  init(STRING)                     -
--  mdsstdshang()                    -
--  plotselect(STRING)               -
--  selectbottlist()                 -
--  selectrodsizelist()              -
--  writeactiveval(REAL)             -
--  writecheck()                     -
--  writedescription()               -
--  writedescriptionvalid(GADGET,STRING) -
--  writehangconfig(REAL)            -
--  writername()                     -
--  writernamevalid(GADGET,STRING)   -
--  writesuppfunc()                  -
--  writetodatabase()                -
--

kill !!mdsstdshang

setup form !!mdsstdshang

  !this.initcall = '!this.init(|FORMINIT|)'

  !this.formtitle = 'MDS Hanger Data'

  para .supstandardtitle text 'Support Standard'
  path right
  para .supstandardname text 'xxxxxx'
  text .datarname 'Standard Replacement Name' call '!this.writername()' tagwid 20 width 13 is STRING
  -- text .datarname 'Standard Replacement Name' tagwid 20 width 13 is STRING
  text .datadescription 'Description' call '!this.writedescription()' tagwid 10 width 28 is STRING
  path down

  frame .tabset TABSET at xmin form

    frame .data 'Standard  ' at 0 0
      --define gadgets in Standard tab

      list .datasectlist call '!this.init(|UPDATE|)' at xmin form +0.5 columns width 23 hei 30

      path right

      frame .activeframe 'Active' at xmax .datasectlist +0.5 ymin .datasectlist width 25
        rtoggle .activetoggletrue 'True' call '!this.activeframe('
        path right
        rtoggle .activetogglefalse 'False'
      exit

      path down

      frame .hangconfigframe 'Hanger Configuration' width 25

        option .hangconfigoption1 call '!this.writehangconfig(1)' width 4

        path right
        option .hangconfigoption2 call '!this.writehangconfig(2)' width 4
        option .hangconfigoption3 call '!this.writehangconfig(3)' width 4

      exit

      path down

      text .datasuppfunc 'Support function' call '!this.writesuppfunc()' tagwid 12 width 12 is STRING

      frame .plotframe 'plot file' at xmax.hangconfigframe+0.3 ymin.activeframe hei 19.6 wid 40

      --popup to reset limits  on plotfile view
      !plotpopup = !this.newmenu('listpopup')
      !plotpopup.add('callback','Reset limits','!this.plot.add(!this.plot.val)')

      --plotfile view
      view .plot PLOT
        bord on
        height 18.4
        width 40
        setc 15
      exit
      path down
      !this.plot.setpopup(!this.listpopup)

      exit

      !pixmap = !!pml.getpathname('leftarrow16.png')
      button .prevplot pixmap "$!<pixmap>" call '!this.plotselect(|prev|)'
      path right
      !pixmap = !!pml.getpathname('rightarrow16.png')
      para .plotpara text 'Plot x of x'
      button .nextplot pixmap "$!<pixmap>" call '!this.plotselect(|next|)'

    exit

    frame .hangerconfig 'Aliases' at 0 0
      path down
      list .hangeraliaslist columns width 12 hei 30
      path right
    exit

    frame .bott 'Bottom Associated Support Standards' at 0 0
      list .bottassoclist1 call '!this.selectbottlist()' columns width 15 hei 30
      list .bottassoclist2 columns width 15 hei 30

    exit

    frame .rodsizes 'Allowed Rod Sizes' at 0 0
      list .rodsizelist1 call '!this.selectrodsizelist()' columns width 25 hei 30
      list .rodsizelist2 columns width 15 hei 30

    exit

  exit

  --apply and dismiss buttons outside tabbed frame

  button .apply 'Apply' call '!this.writetodatabase()' at xmin form ymax form
  path right
  button .dismiss 'Dismiss' call '!this.cancelformmethod()' at xmax form -size

  --callbacks (open callbacks) for tabs

  !this.data.callback = '!this.frameevent('

  --form members set in .init

  member .currentplotfilenumber is REAL

  member .cata is DBREF
  --member .ancilnumber is REAL
  member .currentancil is STRING

  member .writeflag is BOOLEAN

  member .deschyphenfound is BOOLEAN

  --form members set in .desparsinit

  member .currentsection is DBREF

  member .sectcoll is ARRAY

  member .sectdesc is ARRAY

  member .sectdescgen is ARRAY

  member .sectrnamegen is ARRAY

  member .sectdbrefarray is ARRAY

  member .hangerdefsdata is MDSHANGERDEFSDATA

  member .ancillistarray is ARRAY

  --a named member object for every standard (eg AT01)
  --as members must be defined in form definition, collect names of all SECT and create
  --a form member object of type MDSANCILDATA for each one

  --NB collections below done on form definition
  --COULD BE DONE IN DEFAULT CONSTRUCTOR METHOD?

  --Check module (paragon or design), don't include active false for design (or show form)
  ---OLD - collect descriptions from SECT

  --collect descriptions from GEN
  --now use !this.sectdescgen instead of !this.sectdesc

  var !datacollgen coll all data with dkey eq 'CODE' and name neq '/MDS/HANGER/DEFAULTS/CONFIG/NOTES/GEN/CODE' and name neq '/MDS/HANGER/DEFAULTS/ALIAS/GEN/CODE' and name neq '/MDS/HANGER/DEFAULTS/BOTTOM-ASSOC-STD/GEN/CODE' and name neq '/MDS/HANGER/DEFAULTS/ROD-SIZE/GEN/CODE' for /MDS/HANGER/DEFAULTS

  var !tempsectdescgen eval ppro for all from !datacollgen

  --create array of sect dbref
  do !i indices !datacollgen
    !tempsectdbrefarray[!i] = !datacollgen[!i].dbref().owner.owner.owner
  enddo
  !this.sectdbrefarray = !tempsectdbrefarray

  do !i indices !tempsectdescgen
    !tempsectdescgen[!i] = !tempsectdescgen[!i].after(|( '|).before(|' )|)
    !tempsectdescgen[!i] = !tempsectdescgen[!i].replace('-','')
    if !tempsectdescgen[!i].eq('') then
      !tempsectdescgen[!i] = 'BLANK' & !i
    endif
  enddo

  !this.sectdescgen = !tempsectdescgen

  do !i index !datacollgen
    member .$!this.sectdescgen[$!i] is MDSHANGERDATA
  enddo

exit

-------------------------------------------------------------------------

define method .mdsstdshang()
  --validate calls on text gadgets
  --gadgets at top of form
  !this.datadescription.validatecall = '!this.writedescriptionvalid('
  -- !this.datarname.validatecall = '!this.writernamevalid('

endmethod

--------------------------------------------------------------------

define method .init(!mode is STRING)

  -- If in initialisation mode, go to defaults, put names in list and create
  -- an mdsancilbore object for each standard

  if !mode.eq('FORMINIT') then

    /MDS/HANGER/DEFAULTS

    handle ANY
      !!alert.error('/MDS/HANGER/DEFAULTS must exist to modify hanger design parameters')
      return error 1 '' noalert
    elsehandle NONE
      !this.cata = !!ce
    endhandle

    --Write check

    !this.writecheck()

    !this.hangerdefsdata.dbref = !!ce

    !this.hangerdefsdata.initdata()

    --Hanger aliases

    !headings = ARRAY()
    !headings.append('Standard')
    !headings.append('Alias')

    !this.hangeraliaslist.setheadings(!headings)

    !temparray = ARRAY()

    do !i index !this.hangerdefsdata.aliasarray1
      !temparray[!i][1] = !this.hangerdefsdata.aliasarray1[!i]
      !temparray[!i][2] = !this.hangerdefsdata.aliasarray2[!i]

    enddo

    !this.hangeraliaslist.setrows(!temparray)

    --Hanger bottom associated support standards

    !headings = ARRAY()
    !headings.append('Bottom Hanger Type')

    !this.bottassoclist1.setheadings(!headings)

    !temparray = ARRAY()

    do !i index !this.hangerdefsdata.assocarray

      !temparray[!i][1] = !this.hangerdefsdata.assocarray[!i]

    enddo

    !this.bottassoclist1.setrows(!temparray)

    !headings = ARRAY()
    !headings.append('Support Standard')

    !this.bottassoclist2.setheadings(!headings)

    !temparray = ARRAY()

    do !i index !this.hangerdefsdata.bottassocarray[1]

      !temparray[!i][1] = !this.hangerdefsdata.bottassocarray[1][!i]

    enddo

    !this.bottassoclist2.setrows(!temparray)

    --hanger rod sizes

    !headings = ARRAY()
    !headings.append('Nominal Pipe Size')

    !this.rodsizelist1.setheadings(!headings)

    !temparray = ARRAY()

    do !i index !this.hangerdefsdata.rodsizedescarray

      !temparray[!i][1] = !this.hangerdefsdata.rodsizedescarray[!i]

    enddo

    !this.rodsizelist1.setrows(!temparray)

    !headings = ARRAY()
    !headings.append('Rod Sizes')

    !this.rodsizelist2.setheadings(!headings)

    !temparray = ARRAY()

    do !i index !this.hangerdefsdata.rodsizearray[1]

      !temparray[!i][1] = !this.hangerdefsdata.rodsizearray[1][!i]

    enddo

    !this.rodsizelist2.setrows(!temparray)

    --client codes/replacement names

    var !datacollr coll all data with dkey eq 'CCOD' and name neq '/MDS/HANGER/DEFAULTS/CONFIG/NOTES/GEN/CCOD' and name neq '/MDS/HANGER/DEFAULTS/ALIAS/GEN/CCOD' and name neq '/MDS/HANGER/DEFAULTS/BOTTOM-ASSOC-STD/GEN/CCOD' and name neq '/MDS/HANGER/DEFAULTS/ROD-SIZE/GEN/CCOD' for CATA

    var !tempsectrnamegen eval ppro for all from !datacollr

    do !i indices !tempsectrnamegen
      !tempsectrnamegen[!i] = !tempsectrnamegen[!i].after(|( '|).before(|' )|)
      !tempsectrnamegen[!i] = !tempsectrnamegen[!i].replace('-','')
      if !tempsectrnamegen[!i].eq('') then
        !tempsectrnamegen[!i] = 'BLANK' & !i
      endif
    enddo

    !this.sectrnamegen = !tempsectrnamegen

    --Test that name is in GEN for all SECT - if not display warning message
    !headings = ARRAY()
    !headings.append('Name')
    !headings.append('Replacement Name')
    !this.datasectlist.setheadings(!headings)

    --Create objects with name, rname and dbref of all ancils
    --(one-off creation on form definition)
    !tempcounter = 1
    do !i values !this.sectdescgen
      !tempobjname = '!this.' & !i & '.mainnameval'
      !tempobjdbref = '!this.' & !i & '.dbref'
      !tempobjrname = '!this.' & !i & '.rnameval'
      --******************************************************
      --UNCOMMENT BELOW TWO LINES TO LOAD ALL OBJECTS AT START
      --!tempruninitdata = '!this.' & !i & '.initdata()'
      --!tempruninitdespars = '!this.' & !i & '.initdespars()'
      --******************************************************

      $!tempobjname = !this.sectdescgen[!tempcounter]
      $!tempobjdbref = !this.sectdbrefarray[!tempcounter]
      $!tempobjrname = !this.sectrnamegen[!tempcounter]

      --******************************************************
      --UNCOMMENT BELOW TWO LINES TO LOAD ALL OBJECTS AT START
      --$!tempruninitdata
      --$!tempruninitdespars
      --******************************************************

      --create array of names to put values in list
      !temparray[!tempcounter][1] = $!tempobjname
      !temparray[!tempcounter][2] = $!tempobjrname
      !tempcounter = !tempcounter + 1
    enddo

    !this.ancillistarray = !temparray
    !this.datasectlist.setrows(!this.ancillistarray)

  endif

  --Display plotfile on standard tab

  if !mode.eq('FORMINIT') then
    !test = !!mdsgetplot('VH01')
    !this.plotpara.val = 'Plot 1 of 4'
    !this.plot.add(!test[1].string())
    !this.currentplotfilenumber = 1
    handle ANY
      !test = !!mdsgetplot('None')
      !this.plot.add(!test[1].string())
    endhandle
    --current ancil taken from dtext of datasectlist (list on standard tab)
    !this.currentancil = !this.datasectlist.dtext[1].split()[1]
  else
    !this.currentancil = !this.datasectlist.dtext[!this.datasectlist.val].split()[1]
  endif

  --Run object datainit (for selected ancil, or first ancil if first display
  --of form)
  !this.currentancil = !this.datasectlist.dtext[!this.datasectlist.val].split()[1]
  !currentobject = !this.$!this.currentancil
  !currentobject.initdata()

  !this.$!this.currentancil = !currentobject

  !this.supstandardname.val = !currentobject.mainnameval

  !this.datarname.val = !currentobject.rnameval

  if !currentobject.suppfuncval.set() then
    !this.datasuppfunc.visible = TRUE
    !this.datasuppfunc.val = !currentobject.suppfuncval
  else
    !this.datasuppfunc.visible = false
  endif

  if !currentobject.description.split()[1].eq('-') then
    !this.datadescription.val = !currentobject.description.after('- ')
  else
    !this.datadescription.val = !currentobject.description
  endif

  if !currentobject.active.eq(TRUE) then
    !this.activetoggletrue.val = TRUE
  elseif !currentobject.active.eq(FALSE) then
    !this.activetogglefalse.val = TRUE
  endif

  !arrayofhangerconfigs1 = ARRAY()
  !arrayofhangerconfigs1.append('')
  !arrayofhangerconfigs1.append('T1')
  !arrayofhangerconfigs1.append('T3')
  !arrayofhangerconfigs1.append('T4')
  !arrayofhangerconfigs1.append('T9')
  !arrayofhangerconfigs1.append('T10')
  !arrayofhangerconfigs1.append('T13')
  !arrayofhangerconfigs1.append('T14')

  !arrayofhangerconfigs2 = ARRAY()
  !arrayofhangerconfigs2.append('')
  !arrayofhangerconfigs2.append('M1')
  !arrayofhangerconfigs2.append('M2')
  !arrayofhangerconfigs2.append('M3')

  !arrayofhangerconfigs3 = ARRAY()
  !arrayofhangerconfigs3.append('')
  !arrayofhangerconfigs3.append('B1')
  !arrayofhangerconfigs3.append('B2')
  !arrayofhangerconfigs3.append('B5')
  !arrayofhangerconfigs3.append('B6')
  !arrayofhangerconfigs3.append('B7')
  !arrayofhangerconfigs3.append('B8')
  !arrayofhangerconfigs3.append('B10')
  !arrayofhangerconfigs3.append('B11')
  !arrayofhangerconfigs3.append('B13')
  !arrayofhangerconfigs3.append('B14')
  !arrayofhangerconfigs3.append('B15')
  !arrayofhangerconfigs3.append('B16')
  !arrayofhangerconfigs3.append('B17')

  !this.hangconfigoption1.dtext = !arrayofhangerconfigs1
  !this.hangconfigoption2.dtext = !arrayofhangerconfigs2
  !this.hangconfigoption3.dtext = !arrayofhangerconfigs3

  !indice1 = !this.hangconfigoption1.dtext.findfirst(!currentobject.hangerconfig[1])
  handle ANY
    write 'no config data found'
    !this.hangconfigframe.active = FALSE
  elsehandle NONE
    !this.hangconfigframe.active = TRUE
    !this.hangconfigoption1.val = !indice1

    !indice2 = !this.hangconfigoption2.dtext.findfirst(!currentobject.hangerconfig[2])
    !this.hangconfigoption2.val = !indice2

    !indice3 = !this.hangconfigoption3.dtext.findfirst(!currentobject.hangerconfig[3])
    !this.hangconfigoption3.val = !indice3
  endhandle

endmethod

--------------------------------------------------------------------------------------
define method .plotselect(!mode is STRING)
  --plot select method ran

  if !mode.eq('prev') then
    if !this.currentplotfilenumber.eq(2) then
      !this.currentplotfilenumber = 1
    elseif !this.currentplotfilenumber.eq(3) then
      !this.currentplotfilenumber = 2
    elseif !this.currentplotfilenumber.eq(4) then
      !this.currentplotfilenumber = 3
    endif

  elseif !mode.eq('next') then
    if !this.currentplotfilenumber.eq(1) then
      !this.currentplotfilenumber = 2
    elseif !this.currentplotfilenumber.eq(2) then
      !this.currentplotfilenumber = 3
    elseif !this.currentplotfilenumber.eq(3) then
      !this.currentplotfilenumber = 4
    endif

  endif

  !test = !!mdsgetplot('VH01')

  if !this.currentplotfilenumber.eq(1) then
    !this.plotpara.val = 'Plot 1 of 4'
    !this.plot.add(!test[1].string())
  elseif !this.currentplotfilenumber.eq(2) then
    !this.plotpara.val = 'Plot 2 of 4'
    !this.plot.add(!test[2].string())
  elseif !this.currentplotfilenumber.eq(3) then
    !this.plotpara.val = 'Plot 3 of 4'
    !this.plot.add(!test[3].string())
  elseif !this.currentplotfilenumber.eq(4) then
    !this.plotpara.val = 'Plot 4 of 4'
    !this.plot.add(!test[4].string())
  endif

endmethod
-------------------------------------------------------------------------
define method .selectbottlist()
  --method to list bottom associated support standards when selecting e.g. B1 from list

  !temparray = ARRAY()

  !selectednumber = !this.bottassoclist1.pickedfield

  do !i index !this.hangerdefsdata.bottassocarray[!selectednumber]

    !temparray[!i][1] = !this.hangerdefsdata.bottassocarray[!selectednumber][!i]

  enddo

  !this.bottassoclist2.setrows(!temparray)


endmethod
-----------------------------------------------------------------
define method .selectrodsizelist()
  --method to list rod sizes when select nom pipe size in list

  !temparray = ARRAY()

  !selectednumber = !this.rodsizelist1.pickedfield

  do !i index !this.hangerdefsdata.rodsizearray[!selectednumber]

    !temparray[!i][1] = !this.hangerdefsdata.rodsizearray[!selectednumber][!i]

  enddo

  !this.rodsizelist2.setrows(!temparray)

endmethod
-----------------------------------------------------------------

define method .writehangconfig(!number is REAL)
  --method to write hanger config to object
  !currentobject = !this.$!this.currentancil

  if !number.eq(1) then
    !currentobject.hangerconfig[1] = !this.hangconfigoption1.dtext[!this.hangconfigoption1.val]
  elseif !number.eq(2) then
    !currentobject.hangerconfig[2] = !this.hangconfigoption2.dtext[!this.hangconfigoption2.val]
  elseif !number.eq(3) then
    !currentobject.hangerconfig[3] = !this.hangconfigoption3.dtext[!this.hangconfigoption3.val]
  endif

  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
  --re-init tab?
endmethod
-----------------------------------------------------------------
define method .frameevent(!frame is GADGET, !event is STRING)
  --method to trigger methods from selecting tabs
  if !frame.eq(!this.data) then

  endif

endmethod

----------------------------------------------------------------

define method .writernamevalid(!textin is GADGET, !event is STRING)
  --method to validate input into replacement name field
  --if !textin.val.match(' ').gt(0) then
  --return error 1 'Name must not contain spaces'
  --endif
endmethod

----------------------------------------------------------------

define method .writername()
  --method to write replacement name value to object
  !currentobject = !this.$!this.currentancil
  !currentobject.rnameval = !this.datarname.val
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
endmethod

---------------------------------------------------------------

define method .writedescriptionvalid(!textin is GADGET, !event is STRING)
  --method to validate input into description field
  --checks for '- ' at start of description
  if !textin.val.split()[1].eq('-') then
    !this.deschyphenfound = TRUE
  else
    !this.deschyphenfound = FALSE
  endif
endmethod

---------------------------------------------------------------

define method .writedescription()
  --method to validate input into description field
  !currentobject = !this.$!this.currentancil
  if !this.deschyphenfound.eq(TRUE) then
    !currentobject.description = !this.datadescription.val
  else
    !currentobject.description = '- ' & !this.datadescription.val
  endif
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
endmethod


---------------------------------------------------------------

---------------------------------------------------------------
define method .writesuppfunc()
  --method to write support function value to object
  !currentobject = !this.$!this.currentancil
  !currentobject.suppfuncval = !this.datasuppfunc.val
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
endmethod
-- End of method definition for .writesuppfunc()
---------------------------------------------------------------
----------------------------------------------------------------

define method .activeframe(!dummyRtog is GADGET, !event is STRING)
  !currentobject = !this.$!this.currentancil
  if !event.eq('SELECT') then
    !currentobject.active = TRUE
  elseif !event.eq('UNSELECT') then
    !currentobject.active = FALSE
  endif
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
endmethod

----------------------------------------------------------------------

define method .writeactiveval(!counter is REAL)

  !currentobject = !this.$!this.currentancil
  !temp = '!this.toggle' & $!counter & '.val'

  !loopcounter = 1
  do !i values !currentobject.bore
    if !loopcounter.eq(!counter) then
      !currentobject.bore[!i.size].active = $!temp
    endif
    !loopcounter = !loopcounter + 1
  enddo
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject

endmethod

---------------------------------------------------------------------
define method .writetodatabase()
  --method to write to database, upon hitting apply button
  --writing to database

  do !i values !this.sectdescgen
    --loop through array of descriptions of standards
    --store modified tag, and dbrefs for write backs in local variables

    !modified = '!this.' & !i & '.modified'

    if $!modified eq TRUE then
      write '$!i modified, writing newly entered values to DB'
      !currentobject = !this.$!i

      !rnameref = '!this.' & !i & '.rnamedbref.pproperty'
      !rnamevaldelim = |'| & !currentobject.rnameval & |'|
      $!rnameref = !rnamevaldelim

      !suppfuncref = '!this.' & !i & '.suppfuncdbref.pproperty'
      !suppfuncvaldelim = |'| & !currentobject.suppfuncval & |'|
      handle any
      elsehandle none
        $!suppfuncref = !suppfuncvaldelim
        handle (2,754)
          !!alert.warning('SUPF data element does not exist in /MDS/PRELIMINARY/DEFAULTS. Please upgrade Aveva DB.')
        endhandle
      endhandle
      !savedrow = !this.datasectlist.val

      --Create objects with name, rname and dbref of all trunnions
      --(one-off creation on form definition)
      !this.ancillistarray[$!savedrow][2] = !rnamevaldelim.after(|'|).before(|'|)
      !this.datasectlist.setrows(!this.ancillistarray)
      !this.datasectlist.val = !savedrow

      !descriptionref = '!this.' & !i & '.descriptiondbref.pproperty'
      !descriptiondelim = |'| & !currentobject.description & |'|
      $!descriptionref = !descriptiondelim

      !activeref = '!this.' & !i & '.dbref.:MDSActive'
      $!activeref = !currentobject.active

      !hangerconfigdelim = |( ' | & !currentobject.hangerconfig[1] & | , | & !currentobject.hangerconfig[2] & | , | & !currentobject.hangerconfig[3] & | ' )|

      !hangerconfigref = '!this.' & !i & '.hangerconfigdbref.pproperty'
      $!hangerconfigref = !hangerconfigdelim

      --reset modified flag to false once changes in object have been applied to DB
      $!modified = FALSE

    endif
  enddo
endmethod

----------------------------------------------------------------------

define method .cancelformmethod()
  !localmodifiedflag = FALSE
  do !i values !this.sectdescgen
    --loop through array of descriptions of standards
    --if modified TRUE flag found, give options in alert

    !modified = '!this.' & !i & '.modified'

    if ($!modified eq TRUE AND !this.writeflag eq TRUE) then
      !localmodifiedflag = TRUE
      !answer = !!alert.question('Do you wish to apply changes?')
      if !answer.eq('YES') then
        !this.writetodatabase()
        !this.hide()
        break
      elseif !answer.eq('NO') then
        !this.hide()
        break
      elseif !answer.eq('CANCEL') then
        break
      endif
    elseif ($!modified eq TRUE AND !this.writeflag eq FALSE) then
      !localmodifiedflag = TRUE
      !!alert.warning('Changes made on form cannot be applied; you do not have write access')
    endif

  enddo

  if !localmodifiedflag.eq(FALSE) then
    !this.hide()
  endif

endmethod

----------------------------------------------------------------------
define method .writecheck()
  --method to check if user has db write access
  --NB see also kCheckWrite
  --need to check locked as well?
  --see MDSDAC? (Neale)
  !this.writeflag = DBwrite
  if !this.writeflag.eq(FALSE) then
    --no write access
    !!alert.warning('You do not have write access')
    --grey out apply button (as changes cannot be applied to DB)
    !this.apply.active = FALSE
  else
    !this.apply.active = TRUE
  endif

endmethod

---------------------------------------------------------------------
