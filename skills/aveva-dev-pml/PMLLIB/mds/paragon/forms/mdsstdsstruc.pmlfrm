define method .writerowval(!fieldnumber is REAL)
  !currentobject = !this.$!this.currentancil
  !temp = '!this.text' & '$!fieldnumber' & '.val'
  !val = $!temp
  -- If an imperial we need to store it in mm
  if (!val.matchwild('*in*')) then
    !valReal = object REAL(!val,!!distanceFmt)
    !currentobject.bore[!this.selectedbore.real()].despar[!fieldnumber] = !valReal.string()
  else
    !currentobject.bore[!this.selectedbore.real()].despar[!fieldnumber] = $!temp
  endif
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
endmethod

---------------------------------------------------------------------

define method .writerowvalid(!textin is GADGET, !action is STRING)
  !currentobject = !this.$!this.currentancil
  !numb  = !textin.tag.substring(1,2).real().int()
  !ptype =!currentobject.ptypearray[!numb]

  if (!this.imperial and !ptype eq 'DIST') then
    --section to check valid expression or number is entered
    !test = object REAL(!textin.val,!!unitFormat)
    handle ANY
      !this.checkexprn(!textin)

      !test = !textin.val.split('DESP')
      !test.deleteto(1)
      !test.compress()

      do !i index !test
        !temp = !test[!i].after('[').before(']')
        !indexfound = !currentobject.dpnumber.findfirst(!temp)
        if !indexfound.unset() then
          return error 1 'Design parameter number $!temp invalid'
        endif
      enddo
    endhandle
  else
    --section to check valid expression or number is entered
    !test = !textin.val.real()
    !test = object REAL(!textin.val,!!unitFormat)
    handle ANY
      !this.checkexprn(!textin)

      !test = !textin.val.split('DESP')
      !test.deleteto(1)
      !test.compress()

      do !i index !test
        !temp = !test[!i].after('[').before(']')
        !indexfound = !currentobject.dpnumber.findfirst(!temp)
        if !indexfound.unset() then
          return error 1 'Design parameter number $!temp invalid'
        endif
      enddo
    endhandle
  endif
  --section to check whether USERDESP rules apply, and if so whether they are met

  !desparnumber = !textin.tag.split('.')[1]

  do !p index !currentobject.bore[!this.selectedbore.real()].userdespmin
    if !desparnumber.eq(!currentobject.bore[!this.selectedbore.real()].userdespnum[!p]) then
      --relevant userdesp found
      !testnum = !textin.val.real()
      handle ANY
        write 'not currently validating expressions against user despars'
      elsehandle NONE
        if (!textin.val.real().lt(!currentobject.bore[!this.selectedbore.real()].userdespmin[!p].real()) OR !textin.val.real().gt(!currentobject.bore[!this.selectedbore.real()].userdespmax[!p].real())) then

          --value outside allowed range
          !min = !currentobject.bore[!this.selectedbore.real()].userdespmin[!p].real()
          !max = !currentobject.bore[!this.selectedbore.real()].userdespmax[!p].real()
          return error 1 'Value must be in range $!min to $!max'
        endif
      endhandle
    endif

  enddo

endmethod
---------------------------------------------------------------------

define method .writenumorexprvalid(!textin is GADGET, !action is STRING)
  --method to validate input into gadgets
  --checks input is a real, or a valid expression
  --valid expressions must contain DESP[x] where x is valid despar number

  !currentobject = !this.$!this.currentancil
  !numb = !textin.callback.after('(').before(')').real()
  !ptype =!currentobject.ptypearray[!numb]

  if (!this.imperial and !ptype eq 'DIST') then
    !test = object REAL(!textin.val,!!unitFormat)
    handle ANY
      !this.checkexprn(!textin)

      !test = !textin.val.split('DESP')
      !test.deleteto(1)
      !test.compress()

      do !i index !test
        !temp = !test[!i].after('[').before(']')
        !indexfound = !currentobject.dpnumber.findfirst(!temp)
        if !indexfound.unset() then
          return error 1 'Design parameter number $!temp invalid'
        endif
      enddo
    endhandle
  else
    !test = !textin.val.real()
    handle ANY
      !this.checkexprn(!textin)

      !test = !textin.val.split('DESP')
      !test.deleteto(1)
      !test.compress()

      do !i index !test
        !temp = !test[!i].after('[').before(']')
        !indexfound = !currentobject.dpnumber.findfirst(!temp)
        if !indexfound.unset() then
          return error 1 'Design parameter number $!temp invalid'
        endif
      enddo
    endhandle
  endif


endmethod
-----------------------------------------------------------------------

define method .checkexprn(!textin is GADGET)
  -- Check Expression is valid before Proceeding
  -- This method original version in mdsnewreports.pmlfrm

    !runtime = !textin.val
    if (!runtime.trim().neq(||)) then
      !textin.val = !textin.val.replace('|','''')
      !empty[1] = ' '
      !empty[1].delete()
      var !test coll all with ($!runtime) from !empty
      handle any
       !syntax = !!error.command.after('with ').before(' from').trim()
       return error 1 'Enter a valid expression or a number'
      endhandle
    endif

endmethod

-----------------------------------------------------------------------

define method .writecolval()
  --method to write values entered in column (size) tab to object

  !currentobject = !this.$!this.currentancil

  --loop through bore sizes and set object despar values

  do !i values !currentobject.bore
    if !i.size.geq(!this.editcoloption2.selection().real()) and !i.size.leq(!this.editcoloption3.selection().real()) then
      !val = !this.editcoltext4.val
      -- If an imperial we need to store it in mm
      if (!val.matchwild('*in*')) then
        !valReal = object REAL(!val,!!distanceFmt)
        !currentobject.bore[!i.size].despar[!this.editcoloption1.selection().real()] = !valReal.string()
      else
        !currentobject.bore[!i.size].despar[!this.editcoloption1.selection().real()] = !this.editcoltext4.val
      endif
    endif
  enddo
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
  !this.editcolinit(|update|)
endmethod

----------------------------------------------------------------------

define method .writecolvalid(!textin is GADGET, !action is STRING)

  !currentobject = !this.$!this.currentancil

  --this section to check number or valid expression

  if (!this.imperial and !textin.val.matchwild('*in*')) then
    !test = object REAL(!textin.val,!!unitFormat)
    handle ANY
      !this.checkexprn(!textin)

      !test = !textin.val.split('DESP')
      !test.deleteto(1)
      !test.compress()

      do !i index !test
        !temp = !test[!i].after('[').before(']')
        !indexfound = !currentobject.dpnumber.findfirst(!temp)
        if !indexfound.unset() then
          return error 1 'Design parameter number $!temp invalid'
        endif
      enddo
    endhandle
  else
    !test = !textin.val.real()
    handle ANY
      !this.checkexprn(!textin)

      !test = !textin.val.split('DESP')
      !test.deleteto(1)
      !test.compress()

      do !i index !test
        !temp = !test[!i].after('[').before(']')
        !indexfound = !currentobject.dpnumber.findfirst(!temp)
        if !indexfound.unset() then
          return error 1 'Design parameter number $!temp invalid'
        endif
      enddo
    endhandle
  endif

  --next section to validate against userdespars

  !desparnumber = !this.editcoloption1.rtext[!this.editcoloption1.val]

  do !j index !currentobject.bore
    !minbore = !this.editcoloption2.dtext[!this.editcoloption2.val]
    !maxbore = !this.editcoloption3.dtext[!this.editcoloption3.val]
    if (!currentobject.bore[!j].size.lt(!minbore.real()) OR !currentobject.bore[!j].size.gt(!maxbore.real())) then
      --out of range
    else
      --process bore - in range
      !this.selectedbore = !currentobject.bore[!j].size.string()
      do !p index !currentobject.bore[!this.selectedbore.real()].userdespmin
        if !desparnumber.eq(!currentobject.bore[!this.selectedbore.real()].userdespnum[!p]) then
          --relevant userdesp found
          if (!this.imperial and !textin.val.matchwild('*in*')) then
            -- Special test if imperial
            !testValue = object REAL(!textin.val,!!distanceFmt)

            !minValue  = !currentobject.bore[!this.selectedbore.real()].userdespmin[!p].real()
            !maxValue  = !currentobject.bore[!this.selectedbore.real()].userdespmax[!p].real()
            if (!testValue lt !minValue or !testValue gt !maxValue) then
              !min = object STRING(!minValue,!!unitFormat)
              !max = object STRING(!maxValue,!!unitFormat)
              return error 1 'Value must be in range $!min to $!max'
            endif
          else
            if (!textin.val.real().lt(!currentobject.bore[!this.selectedbore.real()].userdespmin[!p].real()) OR !textin.val.real().gt(!currentobject.bore[!this.selectedbore.real()].userdespmax[!p].real())) then
              --value outside allowed range
              !min = !currentobject.bore[!this.selectedbore.real()].userdespmin[!p].real()
              !max = !currentobject.bore[!this.selectedbore.real()].userdespmax[!p].real()
              !currentbore = !this.selectedbore
              return error 1 'For bore $!currentbore value must be in range $!min to $!max'
            endif
          endif
        endif
      enddo
    endif

  enddo
endmethod

----------------------------------------------------------------------

define method .writeactiveval(!counter is REAL)

  !currentobject = !this.$!this.currentancil
  !temp = '!this.toggle' & $!counter & '.val'

  !loopcounter = 1
  do !i values !currentobject.bore
    if !loopcounter.eq(!counter) then
    !currentobject.bore[!i.size].active = $!temp
    endif
    !loopcounter = !loopcounter + 1
  enddo
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject

endmethod

