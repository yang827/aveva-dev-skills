define method .writepsmcvalid(!textin is GADGET, !action is STRING)
  --method to validate input into pipe spec material code field
  var !pipecoll collect all spec with purp eq 'PIPE' and :mdspipemat neq 'unset'
  var !evalpipe eval :mdspipemat for all from !pipecoll
  !evalpipe.sortunique()
  !arrayoftextin = !textin.val.split(',')
  !errorstring = ''

  do !i index !arrayoftextin
    !currenttextin = !arrayoftextin[!i].trim()
    if !currenttextin.eq('') then
      return error 1 'No blank values should be given (input format example: CS,SS)'
    elseif !currenttextin.eq('ALL') and !arrayoftextin.size().gt(1) then
      return error 1 'ALL may only be entered with no other codes'
    endif

    !findarray = !evalpipe.find(!currenttextin)
    if !arrayoftextin[1].eq('ALL') then
      break
    elseif !findarray.unset() then
      !errorstring = !errorstring & ' ' & !currenttextin
    endif
  enddo

  if !errorstring.neq('') then
    return error 1 '$!errorstring not valid pipe spec material code(s)'
  endif

endmethod

-------------------------------------------------------------------

define method .writepsmc()
  !currentobject = !this.$!this.currentancil
  !currentobject.pipematval = !this.datatext5.val
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
endmethod

