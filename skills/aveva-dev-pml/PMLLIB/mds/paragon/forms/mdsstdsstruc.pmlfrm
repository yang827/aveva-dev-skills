      if !this.listofsectnames1[$!remove].match(!type.trim()).eq(1) then

        !tempDtext[$!remove] = !this.listofsectnames1[!remove]

      endif
    enddo

    !this.frameancillist1.dtext = !tempDtext

  endif
  --!this.init(|UPDATE|)
  !this.frameancillist1.val = 1

endmethod

