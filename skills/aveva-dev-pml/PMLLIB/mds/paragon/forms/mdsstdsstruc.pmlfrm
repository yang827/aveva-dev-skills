define method .writeelevvalid(!textin is GADGET, !action is STRING)
  --method to validate input into elevation restriction field
  if !textin.val.match(' ').gt(0) then
    return error 1 'Value must not contain spaces'
  endif
  handle ANY
  endhandle
  if (!this.imperial) then
    !test = object REAL(!textin.val,!!unitFormat)
    handle ANY
      if !textin.val.neq('*') then
        return error 1 'Expecting a * character or number'
      endif
    elsehandle NONE
      if(!textin.val.unset() or !textin.val.empty()) then
        return error 1 'Field is unset'
      endif
    endhandle
  else
    !test = !textin.val.real()
    handle ANY
      if !textin.val.neq('*') then
        return error 1 'Expecting a * character or number'
      endif
    elsehandle NONE
      if(!textin.val.unset() or !textin.val.empty()) then
        return error 1 'Field is unset'
      endif
    endhandle
  endif
endmethod
-- End of method definition for .writeelevvalid(GADGET, STRING)

