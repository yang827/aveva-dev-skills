define method .writeelev()
  !currentobject = !this.$!this.currentancil
  !val = !this.datatext4.val
  -- If an imperial we need to store it in mm
  if (!this.imperial and !val neq '*') then
    !valReal = object REAL(!val,!!distanceFmt)
    !currentobject.elevval = !valReal.string()
  else
    !currentobject.elevval = !this.datatext4.val
  endif
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
endmethod
-- End of method definition for .writeelev()

