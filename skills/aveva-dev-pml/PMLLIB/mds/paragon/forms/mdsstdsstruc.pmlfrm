define method .writefgrp(!writeflag is BOOLEAN)

  if !this.fgrpoption.selection().eq('LBKT') then
    !this.fgrppara.val = 'Framework Groups
(L Brackets)'
  elseif !this.fgrpoption.selection().eq('CAPO') then
    !this.fgrppara.val = 'Framework Groups
(Cantilevers/Posts)'
  elseif !this.fgrpoption.selection().eq('PDTL') then
    !this.fgrppara.val = 'Framework Groups
(Pedestals)'
  elseif !this.fgrpoption.selection().eq('FRAM') then
    !this.fgrppara.val = 'Framework Groups
(Frames)'
  elseif !this.fgrpoption.selection().eq('BBKT') then
    !this.fgrppara.val = 'Framework Groups
(Braced Brackets)'
  elseif !this.fgrpoption.selection().eq('TPST') then
    !this.fgrppara.val = 'Framework Groups
(T Posts)'
  elseif !this.fgrpoption.selection().eq('MISC') then
    !this.fgrppara.val = 'Framework Groups
(Miscellaneous)'
  endif
  !this.datasectlist.setfocus()
  if !writeflag.eq(TRUE) then
    !currentobject = !this.$!this.currentancil
    !currentobject.fgrp = !this.fgrpoption.selection()
    !currentobject.modified = TRUE
    !this.$!this.currentancil = !currentobject
  endif
endmethod
----------------------------------------------------------------------------

define method .writeframewksele(!mode is STRING)
  --method to add or remove from framework selection list
  !currentobject = !this.$!this.currentancil

  if !mode.eq('add') then

        do !j values !this.frameancillist1.selection()

          !size = !currentobject.framesele.size()
          !currentobject.framesele[!size + 1] = !j

          --if value selected to add is *, remove all from !currentobject.framesele apart from *

          if !j.eq('*') then
            !currentobject.framesele = ARRAY()
            !currentobject.framesele.append('*')
          endif

          --if value selected to add is e.g. AT* remove all with AT found from !currentobject.framesele

          if !j.match('*').neq(0) and !j.neq('*') then
            !k = !j.substring(1,2)
            !kwithstar = !k & '*'
            do !i index !currentobject.framesele
              if !currentobject.framesele[!i].match(!k).neq(0) AND !currentobject.framesele[!i].match(!kwithstar).neq(1) then
                --$p value $!i matches AT, not AT*
                !currentobject.framesele.deletefrom(!i,1)
              endif
            enddo
            !currentobject.framesele.compress()
          endif

          --IF SOMETHING IS ADDED AND * IS IN LIST, REMOVE *

          if !j.neq('*') then
            if !currentobject.framesele.findfirst('*').unset().not() then
              !m = !currentobject.framesele.findfirst('*')
              !currentobject.framesele.deletefrom(!m,1)
              !currentobject.framesele.compress()
            endif
          endif

        enddo

        --IF e.g. AT02 IS ADDED AND AT* IS IN LIST REMOVE AT*

        do !p index !currentobject.framesele
          if !currentobject.framesele[!p].match('*').neq(0) and !currentobject.framesele[!p].neq('*') then
            !r = !currentobject.framesele[!p].substring(1,2)
            do !s values !currentobject.framesele
              if !s.match(!r).neq(0) and !s.match('*').eq(0) then
                --if matches !r, but no *, then delete current p element
                !currentobject.framesele.deletefrom(!p,1)
              endif
            enddo
          endif
        enddo
        !currentobject.framesele.compress()
  elseif !mode.eq('remove') then

    !temp = !currentobject.framesele
    do !k values !this.frameselelist.val

      !temp.deletefrom(!k,1)

    enddo

    !temp.compress()
    !currentobject.framesele = !temp
  endif

  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
  !this.framewktabinit(|seleonly|)

endmethod

---------------------------------------------------------------------
define method .writeframewkrestr(!mode is STRING)
  --method to add or remove from framework restriction list
    !currentobject = !this.$!this.currentancil

  if !mode.eq('add') then

        do !j values !this.frameancillist2.selection()

          !size = !currentobject.framerestr.size()
          !currentobject.framerestr[!size + 1] = !j

          --if value selected to add is *, remove all from !currentobject.framesele apart from *

          if !j.eq('*') then
            !currentobject.framerestr = ARRAY()
            !currentobject.framerestr.append('*')
          endif

          --if value selected to add is e.g. AT* remove all with AT found from !currentobject.framesele

          if !j.match('*').neq(0) and !j.neq('*') then
            !k = !j.substring(1,2)
            !kwithstar = !k & '*'
            do !i index !currentobject.framerestr
              if !currentobject.framerestr[!i].match(!k).neq(0) AND !currentobject.framerestr[!i].match(!kwithstar).neq(1) then
                --value $!i matches AT, not AT*
                !currentobject.framerestr.deletefrom(!i,1)
              endif
            enddo
            !currentobject.framerestr.compress()
          endif

          --IF SOMETHING IS ADDED AND * IS IN LIST, REMOVE *

          if !j.neq('*') then
            if !currentobject.framerestr.findfirst('*').unset().not() then
              !m = !currentobject.framerestr.findfirst('*')
              !currentobject.framerestr.deletefrom(!m,1)
              !currentobject.framerestr.compress()
            endif
          endif

        enddo

        --IF e.g. AT02 IS ADDED AND AT* IS IN LIST REMOVE AT*

        do !p index !currentobject.framerestr
          if !currentobject.framerestr[!p].match('*').neq(0) and !currentobject.framerestr[!p].neq('*') then
            !r = !currentobject.framerestr[!p].substring(1,2)
            do !s values !currentobject.framerestr
              if !s.match(!r).neq(0) and !s.match('*').eq(0) then
                --if matches !r, but no *, then delete current p element
                !currentobject.framerestr.deletefrom(!p,1)
              endif
            enddo
          endif
        enddo
        !currentobject.framerestr.compress()
  elseif !mode.eq('remove') then

    !temp = !currentobject.framerestr
    do !k values !this.framerestrlist.val

      !temp.deletefrom(!k,1)

    enddo

    !temp.compress()
    !currentobject.framerestr = !temp
  endif

  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
  !this.framewktabinit(|restronly|)

endmethod

---------------------------------------------------------------------------
define method .writeframealtcod()
  --method to write alt frame code to object
  !currentobject = !this.$!this.currentancil

  !currentobject.frameacod[!this.framewkcodtablist.pickedfield] = !this.framewkcodtext1.val

  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
  !this.framewkcodtabinit(|tabinit|)
endmethod

-----------------------------------------------------------------------------
define method .writeframealtcodcol()
  !currentobject = !this.$!this.currentancil

  --!start = !currentobject.framefcod.findfirst(!this.framewkcodoption1.selection)
  !start = !this.framewkcodoption1.pickedfield
  !end = !this.framewkcodoption2.pickedfield

  do !i index !currentobject.framefcod
    if !i.geq(!start) and !i.leq(!end) then
      !currentobject.frameacod[!i] = !this.framewkcodtext2.val
    endif
  enddo

  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
  !this.framewkcodtabinit(|tabinit|)

endmethod
----------------------------------------------------------------------

define method .writetodatabase()
  --method to write to database, upon hitting apply button
  --$p writing to database

  do !i values !this.sectdescgen
    --loop through array of descriptions of standards
    --store modified tag, and dbrefs for write backs in local variables

    !modified = '!this.' & !i & '.modified'

    if $!modified eq TRUE then
      write '$!i modified, writing newly entered values to DB'
      !currentobject = !this.$!i

      !rnameref = '!this.' & !i & '.rnamedbref.pproperty'
      !rnamevaldelim = |'| & !currentobject.rnameval & |'|
      $!rnameref = !rnamevaldelim

      !savedRow = !this.datasectlist.val
--Create objects with name, rname and dbref of all trunnions
--(one-off creation on form definition)
      !this.ancillistarray[$!savedRow][2] = !rnamevaldelim.after(|'|).before(|'|)
      !this.datasectlist.setrows(!this.ancillistarray)
      !this.datasectlist.val = !savedRow

      !descriptionref = '!this.' & !i & '.descriptiondbref.pproperty'
      !descriptiondelim = |'| & !currentobject.description & |'|
      $!descriptionref = !descriptiondelim

      !activeref = '!this.' & !i & '.dbref.:MDSActive'
      $!activeref = !currentobject.active

      --framework specific section
      --framework selection and restriction arrays must converted to a string with commas
      --separating each element

      !framemtocref = '!this.' & !i & '.framemtocdbref.pproperty'

      !sizeframesele = !currentobject.framesele.size()
      !frameselestring = |( '|
      do !j index !currentobject.framesele
        if !j.neq(!sizeframesele) then
          !frameselestring = !frameselestring & !currentobject.framesele[!j] & ','
        elseif !j.eq(!sizeframesele) then
          !frameselestring = !frameselestring & !currentobject.framesele[!j]
        endif

      enddo
      !frameselestring = !frameselestring & |' )|

      !frameseleref = '!this.' & !i & '.frameseledbref.pproperty'
      $!frameseleref = !frameselestring
      handle ANY
      elsehandle NONE

      !sizeframerestr = !currentobject.framerestr.size()

      !framerestrstring = |( '|
      do !m index !currentobject.framerestr
        if !m.neq(!sizeframerestr) then
          !framerestrstring = !framerestrstring & !currentobject.framerestr[!m] & ','
        elseif !m.eq(!sizeframerestr) then
          !framerestrstring = !framerestrstring & !currentobject.framerestr[!m]
        endif

      enddo
      !framerestrstring = !framerestrstring & |' )|

        !framerestrref = '!this.' & !i & '.framerestrdbref.pproperty'
      $!framerestrref = !framerestrstring

      do !k index !currentobject.frameacod

          !frameacodref = '!this.' & !i & '.frameacoddbref[' & !k & '].pproperty'
          !framefcodref = '!this.' & !i & '.framefcoddbref[' & !k & '].pproperty'

        !acodvaldelim = |( '| & !currentobject.frameacod[!k] & |' )|
        !fcodvaldelim = |( '| & !currentobject.framefcod[!k] & |' )|

        $!frameacodref = !acodvaldelim
        $!framefcodref = !fcodvaldelim

      enddo

      endhandle

      --FRAMEWORK GROUPS

      !fgrpref = '!this.' & !i & '.fgrpdbref.pproperty'
      !fgrpvaldelim = |( '| & !currentobject.fgrp & |' )|
        handle ANY
        endhandle

      $!fgrpref = !fgrpvaldelim
        handle ANY
        endhandle

      --END FRAMEWORK SPECIFIC SECTION

      --the following items need text delimeters added to the string to be entered
      --as values in the database (activeref does not - boolean)

      !vendref = '!this.' & !i & '.venddbref.pproperty'
      !vendvaldelim = |'| & !currentobject.vendval & |'|
      $!vendref = !vendvaldelim
      handle ANY
        --handle no despars cases
      elsehandle NONE

        !elevref = '!this.' & !i & '.elevdbref.pproperty'
        !elevvaldelim = |'| & !currentobject.elevval & |'|
        $!elevref = !elevvaldelim

        !pipematref = '!this.' & !i & '.pipematdbref.pproperty'
        !pipematvaldelim = |'| & !currentobject.pipematval & |'|
        $!pipematref = !pipematvaldelim

        !propref = '!this.' & !i & '.propdbref.pproperty'
        !propvaldelim = |'| & !currentobject.propval & |'|
        $!propref = !propvaldelim

        !isofref = '!this.' & !i & '.isofdbref.pproperty'
        !isofvaldelim = |'| & !currentobject.isofval & |'|
        $!isofref = !isofvaldelim

        do !j values !currentobject.bore
          --loop over bore sizes
          !boreactiveref = '!this.' & !i & '.bore[' & !j.size & '].dbref.:MDSActive'
          $!boreactiveref = !currentobject.bore[!j.size].active

          !shopflagref = '!this.' & !i & '.bore[' & !j.size & '].shopflagdbref.pproperty'
          !shopflagvaldelim = |'| & !currentobject.bore[!j.size].shopflag.string() & |'|
          $!shopflagref = !shopflagvaldelim

          do !p index !currentobject.bore[!j.size].altexpr
            --loop over alternative expressions

            !altexprref = '!this.' & !i & '.bore[' & !j.size & '].altexprdbref[' & !p.string() & '].pproperty'

            !tempstring = '!currentobject.bore[!j.size]' & '.altexpr[' & !p.string() & ']'

            !altexprvaldelim = |( '| & $!tempstring & |' )|

            $!altexprref = !altexprvaldelim

            do !m index !currentobject.bore[!j.size].altdesparval[!p]
              --write alt despar values
              --numbers are currently not edited (same dbref thought, just number, not pproperty)
              !altdesparvalref = '!this.' & !i & '.bore[' & !j.size & '].altdespardbref[' & !p.string() & '][' & !m.string() & '].pproperty'
              --!altdesparnumref = '!this.' & !i & '.bore[' & !j.size & '].altdespardbref[' & !p.string() & '][' & !m.string() & '].number'

              !temp = !currentobject.bore[!j.size].altdesparval[!p][!m]
              !altdesparvaldelim = |( | & !temp & | )|

              --!temp2 = !currentobject.bore[!j.size].altdesparnum[!p][!m]
              --!altdesparnumvaldelim = |( | & '!currentobject.bore[!j.size].altdesparnum[' & !p.string() & '][' & !m.string() & ']' & | )|

              $!altdesparvalref = !altdesparvaldelim

            enddo

          enddo

          do !k index !currentobject.bore[!j.size].despar
            --loop over despars
            !desparref = '!this.' & !i & '.bore[' & !j.size & '].despardbref[' & !k.string() & '].pproperty'
            !desparvaldelim = |'| & !currentobject.bore[!j.size].despar[!k] & |'|
            $!desparref = !desparvaldelim
          enddo

          do !n index !currentobject.bore[!j.size].userdespmin
            !userdesparminref = '!this.' & !i & '.bore[' & !j.size & '].userdespmindbref[' & !n.string() & '].pproperty'
            !userdespminvaldelim = |'| & !currentobject.bore[!j.size].userdespmin[!n] & |'|
            $!userdesparminref = !userdespminvaldelim
            !userdesparmaxref = '!this.' & !i & '.bore[' & !j.size & '].userdespmaxdbref[' & !n.string() & '].pproperty'
            !userdespmaxvaldelim = |'| & !currentobject.bore[!j.size].userdespmax[!n] & |'|
            $!userdesparmaxref = !userdespmaxvaldelim
          enddo

        enddo
      endhandle
      --reset modified flag to false once changes in object have been applied to DB
      $!modified = FALSE

    endif
  enddo
endmethod

----------------------------------------------------------------------

define method .cancelformmethod()
  !localmodifiedflag = FALSE
  do !i values !this.sectdescgen
  --loop through array of descriptions of standards
    --if modified TRUE flag found, give options in alert

  !modified = '!this.' & !i & '.modified'

    if ($!modified eq TRUE AND !this.writeflag eq TRUE) then
        !localmodifiedflag = TRUE
        !answer = !!alert.question('Do you wish to apply changes?')
        if !answer.eq('YES') then
          !this.writetodatabase()
          !this.hide()
          break
        elseif !answer.eq('NO') then
          !this.hide()
          break
        elseif !answer.eq('CANCEL') then
          break
        endif
      elseif ($!modified eq TRUE AND !this.writeflag eq FALSE) then
        !localmodifiedflag = TRUE
        !!alert.warning('Changes made on form cannot be applied; you do not have write access')
    endif

  enddo

  if !localmodifiedflag.eq(FALSE) then
    !this.hide()
  endif

endmethod

----------------------------------------------------------------------
define method .writecheck()
  --method to check if user has db write access
  --NB see also kCheckWrite
  --need to check locked as well?
  --see MDSDAC? (Neale)
  !this.writeflag = DBwrite
  if !this.writeflag.eq(FALSE) then
    --no write access
    !!alert.warning('You do not have write access')
    --grey out apply button (as changes cannot be applied to DB)
    !this.apply.active = FALSE
  else
    !this.apply.active = TRUE
  endif

endmethod

---------------------------------------------------------------------

define method .iconFilter(!type is STRING)

  --method to filter list on icon selected
  --modified from method in Mdsancill.pmlfrm
  if !type.eq('ALL') then
    !this.datasectlist.setrows(!this.ancillistarray)
  else

    !tempDtext = ARRAY()

    do !remove from 1 to !this.ancillistarray.size()

      if !this.ancillistarray[$!remove][1].match(!type.trim()).eq(1) then

        !tempDtext[$!remove][1] = !this.ancillistarray[!remove][1]
        !tempDtext[$!remove][2] = !this.ancillistarray[!remove][2]
      endif
    enddo

    !this.datasectlist.setrows(!tempDtext)

  endif
  !this.init(|UPDATE|)

endmethod

