define method .writetrunsize(!mode is STRING)
  --method to write trunnion default,min,max sizes to object
  !currentobject = !this.$!this.currentancil

  if !mode.eq('def') then
    !currentobject.bore[!this.selectedbore.real()].trundeflength = !this.trundeftext.val.real()
  elseif !mode.eq('min') then
    !currentobject.bore[!this.selectedbore.real()].trunminlength = !this.trunmintext.val.real()
  elseif !mode.eq('max') then
    !currentobject.bore[!this.selectedbore.real()].trunmaxlength = !this.trunmaxtext.val.real()
  endif

  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
endmethod

----------------------------------------------------------------------
define method .writetrunbore(!mode is STRING)
  !currentobject = !this.$!this.currentancil
  --!this.trunboreremove.active = TRUE
  if !mode.eq('add') then
    -- add in bore
    !currentobject.bore[!this.selectedbore.real()].trunfixeditemborearray.append(!this.trunborelist2.selection('DTEXT'))
    !temp = ARRAY()
    !currentobject.bore[!this.selectedbore.real()].trunfixeditemarray.append(!temp)
    --add a standard to list - from previous trunnion bore

    --!currentobject.bore[!this.selectedbore.real()].trunfixeditemarray[!this.trunborelist1.pickedfield + 1].append(!this.trunfixlist1.selection('DTEXT'))
    --!currentobject.bore[!this.selectedbore.real()].trunfixeditemarray[!this.trunborelist1.dtext.size() + 1].append(!this.trunfixlist1.selection('DTEXT'))
    !currentobject.bore[!this.selectedbore.real()].trunfixeditemarray[!this.trunborelist1.dtext.size() + 1].append(!this.trunfixlist1.dtext[1])

    --!currentobject.bore[!this.selectedbore.real()].trunfixeditemarray[!this.trunborelist1.pickedfield + 1].append(!this.trunfixlist1.selection('DTEXT'))
    --!currentobject.bore[!this.selectedbore.real()].trunfixeditemarray[!this.trunborelist1.dtext.size() + 1].append(!this.trunfixlist1.selection('DTEXT'))

  elseif !mode.eq('remove') then
    --if !this.trunborelist1.dtext.size().eq(1) then
      --!this.trunboreremove.active = FALSE
      --return error 1 'There must be at least one trunnion bore size'
    --else
      !temp = !currentobject.bore[!this.selectedbore.real()].trunfixeditemborearray
      !temp.deletefrom(!this.trunborelist1.pickedfield,1)
      !temp.compress()
      !currentobject.bore[!this.selectedbore.real()].trunfixeditemborearray = !temp

      !temp2 = !currentobject.bore[!this.selectedbore.real()].trunfixeditemarray
      !temp2.deletefrom(!this.trunborelist1.pickedfield,1)
      !temp2.compress()
      !currentobject.bore[!this.selectedbore.real()].trunfixeditemarray = !temp2

      !temp3 = !currentobject.bore[!this.selectedbore.real()].trunfixeditemdbrefarray
      !temp3.deletefrom(!this.trunborelist1.pickedfield,1)
      !temp3.compress()
      !currentobject.bore[!this.selectedbore.real()].trunfixeditemdbrefarray = !temp3

    --endif

  endif
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
  !this.truninit('tabinit')
endmethod
---------------------------------------------------------------------------
define method .writetrunfix(!mode is STRING)
  !currentobject = !this.$!this.currentancil
  --on initialisation set pickedfield to 1
  if !this.trunborelist1.pickedfield.eq(0) then
  --if !this.trunfixlist1.pickedfield.eq(0) then
    !pickedfield = 1
  else
    !pickedfield = !this.trunborelist1.val
    --!pickedfield = !this.trunfixlist1.val
  endif

  if !mode.eq('add') then

    !currentobject.bore[!this.selectedbore.real()].trunfixeditemarray[!pickedfield].append(!this.trunfixlist2.selection('DTEXT'))

  elseif !mode.eq('remove') then

    !temp = !currentobject.bore[!this.selectedbore.real()].trunfixeditemarray[!pickedfield]

    !temp.deletefrom(!this.trunfixlist1.pickedfield,1)
    !temp.compress()
    !currentobject.bore[!this.selectedbore.real()].trunfixeditemarray[!pickedfield] = !temp

  endif
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject

  !this.truninit('tabinit')
  !this.selecttrunbore()
endmethod

