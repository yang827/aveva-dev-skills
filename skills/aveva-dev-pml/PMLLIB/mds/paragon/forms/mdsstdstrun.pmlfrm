---------------------------------------------------------------------

define method .writerowvalid(!textin is GADGET, !action is STRING)
  !currentobject = !this.$!this.currentancil

  --section to check valid expression or number is entered
  !test = !textin.val.real()
  handle ANY
    !this.checkexprn(!textin)

    !test = !textin.val.split('DESP')
    !test.deleteto(1)
    !test.compress()

    do !i index !test
      !temp = !test[!i].after('[').before(']')
      !indexfound = !currentobject.dpnumber.findfirst(!temp)
      if !indexfound.unset() then
        return error 1 'Design parameter number $!temp invalid'
      endif
    enddo
  endhandle

  --section to check whether USERDESP rules apply, and if so whether they are met

  !desparnumber = !textin.tag.split('.')[1]

  do !p index !currentobject.bore[!this.selectedbore.real()].userdespmin
    if !desparnumber.eq(!currentobject.bore[!this.selectedbore.real()].userdespnum[!p]) then
      --relevant userdesp found
      !unusedTestnum = !textin.val.real()
      handle ANY
          -- not currently validating expressions against user despars

      elsehandle NONE
        if (!textin.val.real().lt(!currentobject.bore[!this.selectedbore.real()].userdespmin[!p].real()) OR !textin.val.real().gt(!currentobject.bore[!this.selectedbore.real()].userdespmax[!p].real())) then

          --value outside allowed range
          !min = !currentobject.bore[!this.selectedbore.real()].userdespmin[!p].real()
          !max = !currentobject.bore[!this.selectedbore.real()].userdespmax[!p].real()
          return error 1 'Value must be in range $!min to $!max'
        endif
      endhandle
    endif

  enddo

endmethod
---------------------------------------------------------------------

define method .writenumorexprvalid(!textin is GADGET, !action is STRING)
  --method to validate input into gadgets
  --checks input is a real, or a valid expression
  --valid expressions must contain DESP[x] where x is valid despar number

  !currentobject = !this.$!this.currentancil

  !test = !textin.val.real()
  handle ANY
    !this.checkexprn(!textin)

    !test = !textin.val.split('DESP')
    !test.deleteto(1)
    !test.compress()

    do !i index !test
      !temp = !test[!i].after('[').before(']')
      !indexfound = !currentobject.dpnumber.findfirst(!temp)
      if !indexfound.unset() then
        return error 1 'Design parameter number $!temp invalid'
      endif
    enddo
  endhandle

endmethod

----------------------------------------------------------------------
define method .checkexprn(!textin is GADGET)
  -- Check Expression is valid before Proceeding
  -- This method original version in mdsnewreports.pmlfrm

    !runtime = !textin.val
    if (!runtime.trim().neq(||)) then
      !textin.val = !textin.val.replace('|','''')
      !empty[1] = ' '
      !empty[1].delete()
      var !test coll all with ($!runtime) from !empty
      handle any
       !unusedSyntax = !!error.command.after('with ').before(' from').trim()
       return error 1 'Enter a valid expression or a number'
      endhandle
    endif

endmethod

-----------------------------------------------------------------------

define method .writecolval()
  --method to write values entered in column (size) tab to object

  !currentobject = !this.$!this.currentancil

  --loop through bore sizes and set object despar values

  do !i values !currentobject.bore
    if !i.size.geq(!this.editcoloption2.selection().real()) and !i.size.leq(!this.editcoloption3.selection().real()) then
      !currentobject.bore[!i.size].despar[!this.editcoloption1.selection().real()] = !this.editcoltext4.val
    endif
  enddo
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
  !this.editcolinit(|update|)
endmethod

----------------------------------------------------------------------

define method .writecolvalid(!textin is GADGET, !action is STRING)

  !currentobject = !this.$!this.currentancil

  --this section to check number or valid expression

  !test = !textin.val.real()
  handle ANY
    !this.checkexprn(!textin)

    !test = !textin.val.split('DESP')
    !test.deleteto(1)
    !test.compress()

    do !i index !test
      !temp = !test[!i].after('[').before(']')
      !indexfound = !currentobject.dpnumber.findfirst(!temp)
      if !indexfound.unset() then
        return error 1 'Design parameter number $!temp invalid'
      endif
    enddo
  endhandle

  --next section to validate against userdespars

  !desparnumber = !this.editcoloption1.rtext[!this.editcoloption1.pickedfield]

  do !j index !currentobject.bore
    !minbore = !this.editcoloption2.dtext[!this.editcoloption2.pickedfield]
    !maxbore = !this.editcoloption3.dtext[!this.editcoloption3.pickedfield]
    if (!currentobject.bore[!j].size.lt(!minbore.real()) OR !currentobject.bore[!j].size.gt(!maxbore.real())) then
      --out of range
    else
      --process bore - in range
      !this.selectedbore = !currentobject.bore[!j].size.string()
      do !p index !currentobject.bore[!this.selectedbore.real()].userdespmin
        if !desparnumber.eq(!currentobject.bore[!this.selectedbore.real()].userdespnum[!p]) then
          --relevant userdesp found
          if (!textin.val.real().lt(!currentobject.bore[!this.selectedbore.real()].userdespmin[!p].real()) OR !textin.val.real().gt(!currentobject.bore[!this.selectedbore.real()].userdespmax[!p].real())) then
            --value outside allowed range
            !min = !currentobject.bore[!this.selectedbore.real()].userdespmin[!p].real()
            !max = !currentobject.bore[!this.selectedbore.real()].userdespmax[!p].real()
            !currentbore = !this.selectedbore
            return error 1 'For bore $!currentbore value must be in range $!min to $!max'
          endif
        endif
      enddo
    endif

  enddo
endmethod

----------------------------------------------------------------------

define method .writeactiveval(!counter is REAL)

  !currentobject = !this.$!this.currentancil
  !temp = '!this.toggle' & $!counter & '.val'

  !loopcounter = 1
  do !i values !currentobject.bore
    if !loopcounter.eq(!counter) then
    !currentobject.bore[!i.size].active = $!temp
    endif
    !loopcounter = !loopcounter + 1
  enddo
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject

endmethod

----------------------------------------------------------------------
define method .writeshopflagval(!counter is REAL)

  !currentobject = !this.$!this.currentancil
  !temp = '!this.shoptoggle' & $!counter & '.val'

  !loopcounter = 1
  do !i values !currentobject.bore
    if !loopcounter.eq(!counter) then
      !currentobject.bore[!i.size].shopflag = $!temp
    endif
    !loopcounter = !loopcounter + 1
  enddo
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject

endmethod

--------------------------------------------------------------------

define method .writealtexpr(!number is REAL)
  !currentobject = !this.$!this.currentancil
  !temp = '!this.alttext' & !number.string() & '.val'
  !currentobject.bore[!this.selectedbore.real()].altexpr[!number] = $!temp
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
endmethod

------------------------------------------------------------------------

define method .writealtexprvalid(!textin is GADGET, !action is STRING)
    !currentobject = !this.$!this.currentancil

    !this.checkexprn(!textin)

    !test = !textin.val.split('DESP')
    !test.deleteto(1)
    !test.compress()

    do !i index !test
      !temp = !test[!i].after('[').before(']')
      !indexfound = !currentobject.dpnumber.findfirst(!temp)
      if !indexfound.unset() then
        return error 1 'Design parameter number $!temp invalid'
      endif
    enddo
endmethod

------------------------------------------------------------------------
define method .writealtdespar(!number is REAL)

  !currentobject = !this.$!this.currentancil
  !temp = '!this.altdesptext' & !number.string() & '.val'
  !currentobject.bore[!this.selectedbore.real()].altdesparval[!number] = $!temp
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject

endmethod
----------------------------------------------------------------------
define method .writeuserdespmin(!number is REAL)
  !currentobject = !this.$!this.currentancil
  !temp = '!this.userdespmintext' & !number.string() & '.val'
  !currentobject.bore[!this.selectedbore.real()].userdespmin[!number] = $!temp
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
endmethod
------------------------------------------------------------------------
define method .writeuserdespmax(!number is REAL)
  !currentobject = !this.$!this.currentancil
  !temp = '!this.userdespmaxtext' & !number.string() & '.val'
  !currentobject.bore[!this.selectedbore.real()].userdespmax[!number] = $!temp
  !currentobject.modified = TRUE
  !this.$!this.currentancil = !currentobject
endmethod
-----------------------------------------------------------------------

define method .writetodatabase()
  --method to write to database, upon hitting apply button

  !ce = !!ce

  do !i values !this.sectdescgen
    --loop through array of descriptions of standards
    --store modified tag, and dbrefs for write backs in local variables

    !modified = '!this.' & !i & '.modified'

    if $!modified eq TRUE then
      write '$!i modified, writing newly entered values to DB'

      !currentobject = !this.$!i

-- This modifies the replacement name, if changed we need to update the list gadget
      !rnameref = '!this.' & !i & '.rnamedbref.Pproperty'
      !rnamevaldelim = |'| & !currentobject.rnameval & |'|
      $!rnameref = !rnamevaldelim

      !suppfuncref = '!this.' & !i & '.suppfuncdbref.pproperty'
      !suppfuncvaldelim = |'| & !currentobject.suppfuncval & |'|
      handle any
      elsehandle none
        $!suppfuncref = !suppfuncvaldelim
        handle (2,754)
          !!alert.warning('SUPF data element does not exist in /MDS/PRELIMINARY/DEFAULTS. Please upgrade Aveva DB.')
        endhandle
      endhandle

      !savedrow = !this.datasectlist.val
--Create objects with name, rname and dbref of all trunnions
--(one-off creation on form definition)
      !this.ancillistarray[$!savedrow][2] = !rnamevaldelim.after(|'|).before(|'|)
      !this.datasectlist.setrows(!this.ancillistarray)
      !this.datasectlist.val = !savedrow

      !descriptionref = '!this.' & !i & '.descriptiondbref.Pproperty'
      !descriptiondelim = |'| & !currentobject.description & |'|
      $!descriptionref = !descriptiondelim

      !activeref = '!this.' & !i & '.dbref.:MDSActive'
      $!activeref = !currentobject.active

      --the following items need text delimiters added to the string to be entered
      --as values in the database (activeref does not - boolean)

      !vendref = '!this.' & !i & '.venddbref.Pproperty'
      !vendvaldelim = |'| & !currentobject.vendval & |'|
      $!vendref = !vendvaldelim
      handle ANY
        --handle no despars cases
      elsehandle NONE

        !elevref = '!this.' & !i & '.elevdbref.Pproperty'
        !elevvaldelim = |'| & !currentobject.elevval & |'|
        $!elevref = !elevvaldelim

        !pipematref = '!this.' & !i & '.pipematdbref.Pproperty'
        !pipematvaldelim = |'| & !currentobject.pipematval & |'|
        $!pipematref = !pipematvaldelim

        !propref = '!this.' & !i & '.propdbref.Pproperty'
        !propvaldelim = |'| & !currentobject.propval & |'|
        $!propref = !propvaldelim

        !isofref = '!this.' & !i & '.isofdbref.Pproperty'
        !isofvaldelim = |'| & !currentobject.isofval & |'|
        $!isofref = !isofvaldelim

        do !j values !currentobject.bore
          --loop over bore sizes
          !boreactiveref = '!this.' & !i & '.bore[' & !j.size & '].dbref.:MDSActive'
          $!boreactiveref = !currentobject.bore[!j.size].active

          !shopflagref = '!this.' & !i & '.bore[' & !j.size & '].shopflagdbref.Pproperty'
          !shopflagvaldelim = |'| & !currentobject.bore[!j.size].shopflag.string() & |'|
          $!shopflagref = !shopflagvaldelim

          !trunlendefref = '!this.' & !i & '.bore[' & !j.size & '].trundeflendbref.Pproperty'
          !trunlendefvaldelim =  |( '| & !currentobject.bore[!j.size].trundeflength.string() & |' )|
          $!trunlendefref = !trunlendefvaldelim

          !trunlenminref = '!this.' & !i & '.bore[' & !j.size & '].trunminlendbref.Pproperty'
          !trunlenminvaldelim =  |( '| & !currentobject.bore[!j.size].trunminlength.string() & |' )|
          $!trunlenminref = !trunlenminvaldelim

          !trunlenmaxref = '!this.' & !i & '.bore[' & !j.size & '].trunmaxlendbref.Pproperty'
          !trunlenmaxvaldelim =  |( '| & !currentobject.bore[!j.size].trunmaxlength.string() & |' )|
          $!trunlenmaxref = !trunlenmaxvaldelim

          -- we need to check that no bore sizes no longer exist - if so the corresponding data elements
          -- must be deleted from the db

          !dtseref = !j.dbref.name & '/DTSE'

          !ref = !!ce

          $!dtseref

          var !dataColl coll all DATA for ce

          !existingBoreArray = ARRAY()
          !existingBoreDbrefArray = ARRAY()

          do !t values !dataColl
            if !t.dbref().name.matchwild('*FIXED-ITEMS*') then

              !!ce = !t.dbref()
              !existingBoreDbrefArray.append(!t.dbref())
              --!!ce.pprop.after(|( '|).before(',')
              !existingBoreArray.append(!!ce.pprop.after(|( '|).before(','))
            endif
          enddo

          !!ce = !ref

          !objectBoreArray = !currentobject.bore[!j.size].trunfixeditemborearray

          do !p index !existingBoreArray
            if !objectBoreArray.findfirst(!existingBoreArray[!p]).unset() then

              !!ce = !existingBoreDbrefArray[!p]
              delete DATA
              --$!existingBoreArray[!p]
            endif
          enddo
          !!ce = !ref
          handle any
          endhandle

          -- then change DKEY of DATA elements to OPTA, OPTB, OPTC are in order, if they are not already
          $!dtseref

          var !dataColl coll all DATA for ce
          !existingBoreDbrefArrayNow = ARRAY()

          do !t values !dataColl
            if !t.dbref().name.matchwild('*FIXED-ITEMS*') then
              !!ce = !t.dbref()
              !existingBoreDbrefArrayNow.append(!t.dbref())
              --!!ce.pprop.after(|( '|).before(',')
              --!existingBoreArray.append(!!ce.pprop.after(|( '|).before(','))
            endif
          enddo

          do !d index !existingBoreDbrefArrayNow
            if !d.eq(1) then
              !existingBoreDbrefArrayNow[!d].dkey = 'OPTA'
              !existingBoreDbrefArrayNow[!d].number = 1
              --rename to FIXED-ITEMS/1
              !nameStored = !existingBoreDbrefArrayNow[!d].name.before('FIXED-ITEMS')
              !nameModified = !nameStored & 'FIXED-ITEMS/1'
              !existingBoreDbrefArrayNow[!d].name = !nameModified
            elseif !d.eq(2) then
              !existingBoreDbrefArrayNow[!d].dkey = 'OPTB'
              !existingBoreDbrefArrayNow[!d].number = 2
              --rename to FIXED-ITEMS/2
              !nameStored = !existingBoreDbrefArrayNow[!d].name.before('FIXED-ITEMS')
              !nameModified = !nameStored & 'FIXED-ITEMS/2'
              !existingBoreDbrefArrayNow[!d].name = !nameModified
            elseif !d.eq(3) then
              !existingBoreDbrefArrayNow[!d].dkey = 'OPTC'
              !existingBoreDbrefArrayNow[!d].number = 3
              !nameStored = !existingBoreDbrefArrayNow[!d].name.before('FIXED-ITEMS')
              !nameModified = !nameStored & 'FIXED-ITEMS/3'
              !existingBoreDbrefArrayNow[!d].name = !nameModified
            elseif !d.eq(4) then
              !existingBoreDbrefArrayNow[!d].dkey = 'OPTD'
              !existingBoreDbrefArrayNow[!d].number = 4
              !nameStored = !existingBoreDbrefArrayNow[!d].name.before('FIXED-ITEMS')
              !nameModified = !nameStored & 'FIXED-ITEMS/4'
              !existingBoreDbrefArrayNow[!d].name = !nameModified
            elseif !d.eq(5) then
              !existingBoreDbrefArrayNow[!d].dkey = 'OPTE'
              !existingBoreDbrefArrayNow[!d].number = 5
              !nameStored = !existingBoreDbrefArrayNow[!d].name.before('FIXED-ITEMS')
              !nameModified = !nameStored & 'FIXED-ITEMS/5'
              !existingBoreDbrefArrayNow[!d].name = !nameModified
            elseif !d.eq(6) then
              !existingBoreDbrefArrayNow[!d].dkey = 'OPTF'
              !existingBoreDbrefArrayNow[!d].number = 6
              !nameStored = !existingBoreDbrefArrayNow[!d].name.before('FIXED-ITEMS')
              !nameModified = !nameStored & 'FIXED-ITEMS/6'
              !existingBoreDbrefArrayNow[!d].name = !nameModified
            elseif !d.eq(7) then
              !existingBoreDbrefArrayNow[!d].dkey = 'OPTG'
              !existingBoreDbrefArrayNow[!d].number = 7
              !nameStored = !existingBoreDbrefArrayNow[!d].name.before('FIXED-ITEMS')
              !nameModified = !nameStored & 'FIXED-ITEMS/7'
              !existingBoreDbrefArrayNow[!d].name = !nameModified
            elseif !d.eq(8) then
              !existingBoreDbrefArrayNow[!d].dkey = 'OPTH'
              !existingBoreDbrefArrayNow[!d].number = 8
              !nameStored = !existingBoreDbrefArrayNow[!d].name.before('FIXED-ITEMS')
              !nameModified = !nameStored & 'FIXED-ITEMS/8'
              !existingBoreDbrefArrayNow[!d].name = !nameModified
           elseif !d.eq(9) then
              !existingBoreDbrefArrayNow[!d].dkey = 'OPTI'
              !existingBoreDbrefArrayNow[!d].number = 9
              !nameStored = !existingBoreDbrefArrayNow[!d].name.before('FIXED-ITEMS')
              !nameModified = !nameStored & 'FIXED-ITEMS/9'
              !existingBoreDbrefArrayNow[!d].name = !nameModified
            elseif !d.eq(10) then
              !existingBoreDbrefArrayNow[!d].dkey = 'OPTJ'
              !existingBoreDbrefArrayNow[!d].number = 10
              !nameStored = !existingBoreDbrefArrayNow[!d].name.before('FIXED-ITEMS')
              !nameModified = !nameStored & 'FIXED-ITEMS/10'
              !existingBoreDbrefArrayNow[!d].name = !nameModified
            elseif !d.eq(11) then
              !existingBoreDbrefArrayNow[!d].dkey = 'OPTK'
              !existingBoreDbrefArrayNow[!d].number = 11
              !nameStored = !existingBoreDbrefArrayNow[!d].name.before('FIXED-ITEMS')
              !nameModified = !nameStored & 'FIXED-ITEMS/11'
              !existingBoreDbrefArrayNow[!d].name = !nameModified
            elseif !d.eq(12) then
              !existingBoreDbrefArrayNow[!d].dkey = 'OPTL'
              !existingBoreDbrefArrayNow[!d].number = 12
              !nameStored = !existingBoreDbrefArrayNow[!d].name.before('FIXED-ITEMS')
              !nameModified = !nameStored & 'FIXED-ITEMS/12'
              !existingBoreDbrefArrayNow[!d].name = !nameModified
            elseif !d.eq(13) then
              !existingBoreDbrefArrayNow[!d].dkey = 'OPTM'
              !existingBoreDbrefArrayNow[!d].number = 13
              !nameStored = !existingBoreDbrefArrayNow[!d].name.before('FIXED-ITEMS')
              !nameModified = !nameStored & 'FIXED-ITEMS/13'
              !existingBoreDbrefArrayNow[!d].name = !nameModified
            elseif !d.eq(14) then
              !existingBoreDbrefArrayNow[!d].dkey = 'OPTN'
              !existingBoreDbrefArrayNow[!d].number = 14
              !nameStored = !existingBoreDbrefArrayNow[!d].name.before('FIXED-ITEMS')
              !nameModified = !nameStored & 'FIXED-ITEMS/14'
              !existingBoreDbrefArrayNow[!d].name = !nameModified
            endif
          enddo

          -- then finally add new

          do !k index !currentobject.bore[!j.size].trunfixeditemborearray
            --loop over fixed items

            !fixeditemref = '!this.' & !i & '.bore[' & !j.size & '].trunfixeditemdbrefarray[' & !k.string() & '].Pproperty'

            !fixeditemvaldelim = |( '| & !currentobject.bore[!j.size].trunfixeditemborearray[!k]

            do !m values !currentobject.bore[!j.size].trunfixeditemarray[!k]

              !fixeditemvaldelim = !fixeditemvaldelim & ',' & !m
            enddo

            !fixeditemvaldelim = !fixeditemvaldelim & |' )|

            $!fixeditemref = !fixeditemvaldelim
            handle ANY
                --if no dbref then create DATA element
                !z = !k - 1
                !prevfixeditemref = '!this.' & !i & '.bore[' & !j.size & '].trunfixeditemdbrefarray[' & !z.string() & ']'
                !!ce = $!prevfixeditemref
                  handle any
                    -- no DATA there so create first DATA
                    !check = '!this.' & !i & '.bore[' & !j.size & ']'
                    $!check
                    !newCe = !!ce.name.before('DTSE') & 'MAXLENGTH'

                    !numnew = 1
                    !namenew = !!ce.name
                    !namenew = !namenew.before('/DTSE')

                    !namenew = !namenew & '/' & !currentobject.bore[!j.size].trunfixeditemborearray[!k] & '/FIXED-ITEMS/' & !numnew.string()

                    $!newCe
                  elsehandle none
                    -- DATA exists, so add next one
                !numnew = !!ce.number + 1
                !namenew = !!ce.owner.name
                !namenew = !namenew.before('/DTSE')

                !namenew = !namenew & '/' & !currentobject.bore[!j.size].trunfixeditemborearray[!k] & '/FIXED-ITEMS/' & !numnew.string()
                  endhandle

                if !!ce.dkey.eq('MAXL') then
                  !dkeynew = 'OPTA'
                elseif !!ce.dkey.eq('OPTA') then
                  !dkeynew = 'OPTB'
                elseif !!ce.dkey.eq('OPTB') then
                  !dkeynew = 'OPTC'
                elseif !!ce.dkey.eq('OPTC') then
                  !dkeynew = 'OPTD'
                elseif !!ce.dkey.eq('OPTD') then
                  !dkeynew = 'OPTE'
                elseif !!ce.dkey.eq('OPTE') then
                  !dkeynew = 'OPTF'
                elseif !!ce.dkey.eq('OPTF') then
                  !dkeynew = 'OPTG'
                elseif !!ce.dkey.eq('OPTG') then
                  !dkeynew = 'OPTH'
                elseif !!ce.dkey.eq('OPTH') then
                  !dkeynew = 'OPTI'
                elseif !!ce.dkey.eq('OPTI') then
                  !dkeynew = 'OPTJ'
                elseif !!ce.dkey.eq('OPTJ') then
                  !dkeynew = 'OPTK'
                elseif !!ce.dkey.eq('OPTK') then
                  !dkeynew = 'OPTL'
                else
                  !dkeynew = 'OPTL'
                elseif !!ce.dkey.eq('OPTG') then
                  !dkeynew = 'OPTH'
                elseif !!ce.dkey.eq('OPTH') then
                  !dkeynew = 'OPTI'
                elseif !!ce.dkey.eq('OPTI') then
                  !dkeynew = 'OPTJ'
                elseif !!ce.dkey.eq('OPTJ') then
                  !dkeynew = 'OPTK'
                elseif !!ce.dkey.eq('OPTK') then
                  !dkeynew = 'OPTL'
                elseif !!ce.dkey.eq('OPTL') then
                  !dkeynew = 'OPTM'
                elseif !!ce.dkey.eq('OPTM') then
                  !dkeynew = 'OPTN'
                endif

                if !!ce.typ.eq('DTSE') then
                new data copy prev
                else
                  new data
                  Description 'FIXED-ITEMS'
                  Dtitle 'Trunnion Bore and Fixed Items'
                endif
                --set dkey, number and name

                name $!namenew
                dkey $!dkeynew
                number $!numnew

                --set pproperty from object

                Pproperty $!fixeditemvaldelim

                --store dbref of new element in object

                !currentobject.bore[!j.size].trunfixeditemdbrefarray.append(!!ce)

                !this.$!this.currentancil = !currentobject

            endhandle

          enddo
          do !n index !currentobject.bore[!j.size].userdespmin
            !userdesparminref = '!this.' & !i & '.bore[' & !j.size & '].userdespmindbref[' & !n.string() & '].Pproperty'
            !userdespminvaldelim = |'| & !currentobject.bore[!j.size].userdespmin[!n] & |'|
            $!userdesparminref = !userdespminvaldelim
            !userdesparmaxref = '!this.' & !i & '.bore[' & !j.size & '].userdespmaxdbref[' & !n.string() & '].Pproperty'
            !userdespmaxvaldelim = |'| & !currentobject.bore[!j.size].userdespmax[!n] & |'|
            $!userdesparmaxref = !userdespmaxvaldelim
          enddo
        enddo
      endhandle
      --reset modified flag to false once changes in object have been applied to DB
      $!modified = FALSE

    endif
  enddo

  !!ce = !ce
  handle any
  endhandle

endmethod

----------------------------------------------------------------------

define method .cancelformmethod()
  !localmodifiedflag = FALSE
  do !i values !this.sectdescgen
  --loop through array of descriptions of standards
  --if modified TRUE flag found, give options in alert

  !modified = '!this.' & !i & '.modified'

    if ($!modified eq TRUE AND !this.writeflag eq TRUE) then
        !localmodifiedflag = TRUE
        !answer = !!alert.question('Do you wish to apply changes?')
        if !answer.eq('YES') then
          !this.writetodatabase()
          !this.hide()
          break
        elseif !answer.eq('NO') then
          !this.hide()
          break
        elseif !answer.eq('CANCEL') then
          break
        endif
      elseif ($!modified eq TRUE AND !this.writeflag eq FALSE) then
        !localmodifiedflag = TRUE
        !!alert.warning('Changes made on form cannot be applied; you do not have write access')
    endif

  enddo

  if !localmodifiedflag.eq(FALSE) then
    !this.hide()
  endif

endmethod

----------------------------------------------------------------------
define method .writecheck()
  --method to check if user has db write access
  --NB see also kCheckWrite
  --no lock or MDSDAC checks
  !this.writeflag = dbwrite
  if !this.writeflag.eq(FALSE) then
    --no write access
    !!alert.warning('You do not have write access')
    --grey out apply button (as changes cannot be applied to DB)
    !this.apply.active = FALSE
  else
    !this.apply.active = TRUE
  endif

endmethod

---------------------------------------------------------------------
