-- File:    mdsParagonFormCheck.pmlfnc
-- Type:    Function Definition
-- Group:   Multi Discipline Supports Application
-- Keyword: MDS
-- Module:  Paragon
-- Author:  Joe Wyatt
-- Created: 13/05/09
--
-- Description:  Checks that paragon MDS forms with similar functionalities (i.e. the
--               ability to change the .:mdsActive state) are not shown at the same time
--------------------------------------------------------------------------------
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1      R         FORM       The form that the user is requesting to open
--
-- Return:
--    [Data Type]   [Description]
--------------------------------------------------------------------------------

define function !!mdsParagonFormCheck(!type is STRING)

  --<RM> 25/07/2011, P-39379 changed the !type argument to be a string instead of a form.
  --this is required because we need to ensure that mdsapp default forms do not need to be loaded as part of the
  --paragon startup. when these forms are loaded during startup performance of paragon is impaired due to the collect
  --routines they run. The forms are only loaded now when needed - start
  if !type.eq('ANCILLARIES') then
    !form = !!mdsStdsAncil
    handle (2,751)
      pml load form !!mdsStdsAncil
      !form = !!mdsStdsAncil
    endhandle
  elseif !type.eq('HANGER') then
    !form = !!mdsStdsHang
    handle (2,751)
      pml load form !!mdsStdsHang
      !form = !!mdsStdsHang
    endhandle
  elseif !type.eq('STRUCTURE') then
    !form = !!mdsStdsStruc
    handle (2,751)
      pml load form !!mdsStdsStruc
      !form = !!mdsStdsStruc
    endhandle
  elseif !type.eq('TRUNNION') then
    !form = !!mdsStdsTrun
    handle (2,751)
      pml load form !!mdsStdsTrun
      !form = !!mdsStdsTrun
    endhandle
  elseif !type.eq('ACTIVECONTROL') then
    !form = !!mdsActiveControl
    handle (2,751)
      pml load form !!mdsActiveControl
      !form = !!mdsActiveControl
    endhandle
  elseif !type.eq('CHECKDFLTS') then
    !form = !!mdsChkAppDflts
    handle (2,751)
      pml load form !!mdsChkAppDflts
      !form = !!mdsChkAppDflts
    endhandle
  elseif !type.eq('LIGHTING') then
    !form = !!mdslightingdflts
    handle (2,751)
      pml load form !!mdslightingdflts
      !form = !!mdslightingdflts
    endhandle
  elseif !type.eq('ADMIN') then
    !form = !!mdsAdmin
    handle (2,751)
      pml load form !!mdsAdmin
      !form = !!mdsAdmin
    endhandle
  elseif !type.eq('GRID') then
    !form = !!mdsConfigGriddata
    handle (2,751)
      pml load form !!mdsConfigGriddata
      !form = !!mdsConfigGriddata
    endhandle
  elseif !type.eq('CRITERIA') then
    !form = !!mdsModSelectionCriteria
    handle (2,751)
      pml load form !!mdsModSelectionCriteria
      !form = !!mdsModSelectionCriteria
    endhandle
  endif

  !forms = ARRAY()
  --  !forms.append(!!mdsAdmin) -- this form is only for changing defaults so it is allowed to be shown
  !forms.append(!!mdsStdsAncil)
  handle (2,751)
  endhandle
  !forms.append(!!mdsStdsHang)
  handle (2,751)
  endhandle
  !forms.append(!!mdsStdsStruc)
  handle (2,751)
  endhandle
  !forms.append(!!mdsStdsTrun)
  handle (2,751)
  endhandle
  !forms.append(!!mdsActiveControl)
  handle (2,751)
  endhandle
  --<RM> 25/07/2011, P-39379 changed the !type argument to be a string instead of a form.
  --this is required because we need to ensure that mdsapp default forms do not need to be loaded as part of the
  --paragon startup. when these forms are loaded during startup performance of paragon is impaired due to the collect
  --routines they run. The forms are only loaded now when needed - end

  -- Checks if any forms are open (other than requested form).  If so, user is asked to close form
  do !currentForm values !forms
    if !currentForm.neq(!form) then
      if !currentForm.shown() then
        !answer = !!alert.question(|The form titled '$!<currentForm.formTitle>' must be closed to allow the selected form to open.  Would you like to close it now?|)
        if !answer.eq('YES') then
          !currentForm.cancelFormMethod()
          if !currentForm.shown() then
            return
          endif
        else
          -- If the user selects NO or CANCEL the existing form will stay open and the requested form will not be shown.
          return
        endif
      endif
    endif
  enddo
  -- Shows the requested form if the RETURN above has not been run
  !form.show(|CEN|,0.5, 0.4)
endfunction
