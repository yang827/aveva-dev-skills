--
-- File:		mdschangepar.pmlfnc
--   Type:		Function Definition
--   Group:		Multi Discipline Supports Application
--     Keyword:		MDS
--   Module:		paragon
--   Replaces:
--
-- Author:		N.Morris
-- Created:		Friday 23 April 2004
--
--
-- Description:
-- Function to set all parameters to use PL OD instead of PARA 2 and visa versa
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
--     1     R        DBREF         category
--     2     R        STRING        PLOD or PARA2
--
-- Return:
--    [Data Type]   [Description]
--
-----------------------------------------e---------------------------------------

-- Define Function
define function !!mdschangepar(!Cate is DBREF,!From is STRING,!To is STRING)

-- Is passed element a cate or can we get to a cate

  cate
    handle ANY
      !!Error.Alert('Not a a category')
      return
    endhandle

  !cate = !!ce

-- Confirm changes

  if !!Alert.confirm('Are you sure you want to reset $!from to $!to ').eq('NO') then
    return
  endif

  var !Comps coll all scom for ce
  var !Ptre eval ptre for all from !Comps
  var !Ptre append eval gmre for all from !Comps
  !ptre.unique()

  do !Ptres values !Ptre
    !!ce = !Ptres.dbref()
    var !coll coll all for ce
    do !Reset values !coll
      !!ce = !Reset.dbref()
      !Attrib = Attlist
      do !x values !Attrib
        !Value.delete()
          handle ANY
          endhandle
        if !X.eq('PTCD') then
          !Query = 'PTCDIR'
        else
          !Query = !x
        endif
        !Value = $!Query
        if !Value.objecttype().eq('BOOLEAN') or !Value.objecttype().eq('DBREF') or !Value.objecttype().eq('REAL') then
          skip
        elseif !Value.objecttype().eq('ARRAY') then
          !Value.delete()
          var !value $!query
        endif
        if !value.eq('') or !Value.eq('Unset') or !Value.unset() then
          skip
        endif
        if !value.match(!From).gt(0) then
          !Newvalue = !Value.replace(!From,!To)
          if !Value.neq(!NewValue) then
            !Was = $!x
            $!x $!NewValue
            $P Was $!Was
            $P is $!NewValue
          endif
        endif
      enddo
    enddo
  enddo

  !!ce = !cate


return

endfunction

-- End of file mdschangepar.pmlfnc
