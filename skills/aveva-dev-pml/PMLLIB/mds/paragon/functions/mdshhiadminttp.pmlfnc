--
--------------------------------------------------------------------------------
--   Type: Function Definition
--   Group: Multi Discipline Supports Application
--     Keyword: MDS
--   Module: ADMIN
--   Replaces:
--
--------------------------------------------------------------------------------
-- Description
-- Configure the AVEVA MARINE project TTP in the ADMIN module to communicate with the MDS Application
-- ************************************************************************************************
-- This PML function, i.e. !!mdshhiadminttpp.pmlfnc, MUST be called from the command line in the ADMIN
-- module of the TTP project to create/update the mdb /MDS
-- ************************************************************************************************
--
-- <1> - Copy the TTP project default mdb /TTP to MDB /MDS
-- <2> - Include the required FOREIGN databases from the MDS project into the TTP project and
--       configure the mdb /MDS in the ADMIN module to work with the MDS Applications
--       in the AVEVA MARINE modules PARAGON, OUTFITTING and OUTFITTING DRAFT
-- <3> - Copy the MDS project PARAGON defaults database number 7351 MDS/MDSAPPDEFAULTS into the TTP project
--
--
--
-- ************************************************************************************************
-- *********************
-- ***IMPORTANT NOTE ***
-- *********************
-- Configuration of the PARAGON MDS defaults database number 7351 MDS/MDSAPPDEFAULTS in the TTP project for use by HHI
-- MUST be DONE in the TTP project PARAGON module from the command line by calling the PML function, i.e. !!mdshhiatta(),
-- in the PARAGON module
-- *********************
-- ************************************************************************************************
--
------------------------------------------------------------------------
--
-- Define Function
define function !!mdshhiadminttp()

-- Check the AVEVA Marine Module is "ADMIN"
  !session = current session
  if (!session.module().neq('ADMIN')) then
    !!alert.error('This PML function may ONLY be run in the AVEVA MARINE "ADMIN" module.
    *** ABORTING *** the configuration of the TTP project for the MDS Application')
    return
  endif

-- Check that the MDS project is available from within the TTP project
  var !mdsevar evar 'mds000'
  if (!mdsevar.empty()) then
    !!alert.error('Access to the MDS project is NOT available from within the TTP project
    *** ABORTING *** the configuration of the TTP project for the MDS Application')
    return
  endif

---------------------------------------------------------------------------------------------------

-- Check the "MDS" TEAM exists, and CREATE it if necessary and INCLUDE the required MDS databases
  set team MDS
  handle(39,5)    $* TEAM not found
    create team MDS
    set team MDS
  endhandle

-- Initialise the MDS DB Array
  !mdsdbsarray = ARRAY()

-- INCLUDE as FOREIGN databases shown below from the MDS project into the TTP project
  include db MDS/CATA from project MDS user SYSTEM/XXXXXX
  handle ANY
--    q var !!error
  endhandle
  !mdsdbsarray.append( /*MDS/CATA )

  include db MDS/DESITMPL-PSL from project MDS user SYSTEM/XXXXXX
  handle ANY
  endhandle
  !mdsdbsarray.append( /*MDS/DESITMPL-PSL )

---------------------------------------------------------------------------------------------------
-- ONLY add the DIN STRUCTURAL TEMPLATES to the mdb /MDS as ONLY the "DIN" ORI templates are a complete SET
  include db MDS/DESITMPL-BS from project MDS user SYSTEM/XXXXXX
  handle ANY
  endhandle

  include db MDS/DESITMPL-BS-ORI from project MDS user SYSTEM/XXXXXX
  handle ANY
  endhandle

  include db MDS/DESI-SPECIAL-TMPL-BS from project MDS user SYSTEM/XXXXXX
  handle ANY
  endhandle

---------------------------------------------------------------------------------------------------

  include db MDS/DESITMPL-DIN from project MDS user SYSTEM/XXXXXX
  handle ANY
  endhandle
  !mdsdbsarray.append( /*MDS/DESITMPL-DIN )

  include db MDS/DESITMPL-DIN-ORI from project MDS user SYSTEM/XXXXXX
  handle ANY
  endhandle
  !mdsdbsarray.append( /*MDS/DESITMPL-DIN-ORI )

  include db MDS/DESI-SPECIAL-TMPL-DIN from project MDS user SYSTEM/XXXXXX
  handle ANY
  endhandle
  !mdsdbsarray.append( /*MDS/DESI-SPECIAL-TMPL-DIN )

  include db MDS/PROP from project MDS user SYSTEM/XXXXXX
  handle ANY
  endhandle
  !mdsdbsarray.append( /*MDS/PROP )

  include db MDS/DRAFT from project MDS user SYSTEM/XXXXXX
  handle ANY
  endhandle
  !mdsdbsarray.append( /*MDS/DRAFT )

  include db MDS/WELDS from project MDS user SYSTEM/XXXXXX
  handle ANY
  endhandle
  !mdsdbsarray.append( /*MDS/WELDS )

-- COPY from the MDS Project the PARAGON DEFAULTS database MDS/MDSAPPDEFAULTS as DBNUM 7351 into the TTP project
  copy db MDS/MDSAPPDEFAULTS from project MDS user SYSTEM/XXXXXX to MDS/MDSAPPDEFAULTS FINO 7351
  handle ANY
  endhandle
  !mdsdbsarray.append( /*MDS/MDSAPPDEFAULTS )

-- CREATE a new MDS ABA DRAFT USER database as a USER MDS ABA Drawing creation db
  create db MDS/MDSABA PADD ACCESS MULTIWRITE DBNO 6000
  handle ANY
  endhandle
  !mdsdbsarray.append( /*MDS/MDSABA )

-- CREATE a new MDS DESIGN USER database as a USER MDS SUPPORT DESIGN creation db
  create db MDS/MDSDESIGN DESI ACCESS MULTIWRITE DBNO 6001
  handle ANY
  endhandle
  !mdsdbsarray.append( /*MDS/MDSDESIGN )

---------------------------------------------------------------------------------------------------

-- Check that the MDU project is available from within the TTP project
  var !mduevar evar 'mdu000'
  if (!mduevar.empty()) then
    !!alert.error('***ERROR*** Access to the MDU project is NOT available from within the TTP project.
    The db MDU/CATA will NOT be included from project MDU in to the TTP project')
  else
-- Check the "MDU" TEAM exists, and CREATE it if necessary and INCLUDE the required MDS databases
    set team MDU
    handle(39,5)    $* TEAM not found
      create team MDU
      set team MDU
    endhandle

-- Include as FOREIGN databases shown below from the MDS project into the TTP project
    include db MDU/CATA from project MDU user SYSTEM/XXXXXX
    handle ANY
    endhandle
    !mdsdbsarray.append( /*MDU/CATA )

  endif

---------------------------------------------------------------------------------------------------

-- Check that the CPL project is available from within the TTP project
  var !cplevar evar 'cpl000'
  if (!cplevar.empty()) then
    !!alert.error('***ERROR*** Access to the CPL project is NOT available from within the TTP project.
    The db CPLMDS/CPLCATA will NOT be included from project CPL in to the TTP project')
  else
-- Check the "CPL" TEAM exists, and CREATE it if necessary and INCLUDE the required MDS databases
    set team CPLMDS
    handle(39,5)    $* TEAM not found
      create team CPLMDS
      set team CPLMDS
    endhandle

-- Include as a FOREIGN databases  shown below from the CPL project into the TTP project
    include db CPLMDS/CPLCATA from project CPL user SYSTEM/XXXXXX
    handle ANY
    endhandle
    !mdsdbsarray.append( /*CPLMDS/CPLCATA )

  endif

---------------------------------------------------------------------------------------------------

-- Check that the PSL project is available from within the TTP project
  var !pslevar evar 'psl000'
  if (!pslevar.empty()) then
    !!alert.error('***ERROR*** Access to the PSL project is NOT available from within the TTP project.
    The db MDS/PSL2001 will NOT be included from project PSL in to the TTP project')
  else
-- The "MDS" TEAM already exists, see project MDS above
    set team MDS

-- Include as a FOREIGN databases  shown below from the CPL project into the TTP project
    include db MDS/PSL2001 from project PSL user SYSTEM/XXXXXX
    handle ANY
    endhandle
    !mdsdbsarray.append( /*MDS/PSL2001 )
  endif

---------------------------------------------------------------------------------------------------

-- Check that the LIS project is available from within the TTP project
  var !lisevar evar 'lis000'
  if (!lisevar.empty()) then
    !!alert.error('***ERROR*** Access to the LIS project is NOT available from within the TTP project.
    The dbs LISEGA/LS_CATA and LISEGA/LS_DICT will NOT be included from the project LIS into the TTP project')
  else
-- Check the "LISEGA" TEAM exists, and CREATE it if necessary and INCLUDE the required MDS databases
    set team LISEGA
    handle(39,5)    $* TEAM not found
      create team LISEGA
      set team LISEGA
    endhandle

-- Include as a FOREIGN databases  shown below from the LIS project into the TTP project
    include db LISEGA/LS_CATA from project LIS user SYSTEM/XXXXXX
    handle ANY
    endhandle
    !mdsdbsarray.append( /*LISEGA/LS_CATA )

    include db LISEGA/LS_DICT from project LIS user SYSTEM/XXXXXX
    handle ANY
    endhandle
    !mdsdbsarray.append( /*LISEGA/LS_DICT )
  endif

---------------------------------------------------------------------------------------------------
--<wd>oct2007<mds12>--DUN767--
-- Ensure that the AVEVA MASTER ASSOCIATION DEFINITIONS DB, MASTER/ASSOCDEFN, is included into the /MDS mdb
--
-- Check that the MAS project is available from within the TTP project
  var !masevar evar 'mas000'
  if (!masevar.empty()) then
    !!alert.error('***ERROR*** Access to the MAS project is NOT available from within the TTP project.
    The db MASTER/ASSOCDEFN will NOT be included from the project MAS into the TTP project')
  else
-- Check the "MASTER" TEAM exists, and CREATE it if necessary and INCLUDE the required MDS databases
    set team MASTER
    handle(39,5)    $* TEAM not found
      create team MASTER
      set team MASTER
    endhandle

-- Include as a FOREIGN databases shown below from the LIS project into the TTP project
    include db MASTER/ASSOCDEFN from project MAS user SYSTEM/XXXXXX
    handle ANY
    endhandle
    !mdsdbsarray.append( /*MASTER/ASSOCDEFN )

  endif
--<wd>oct2007<mds12>--DUN767--
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------

-- Determine the MDBs in the TTP project etc...
  !mdbttp = FALSE
  !mdbmds = FALSE
  !mdbs = mdbs
  do !indx indices !mdbs
    if (!mdbs[!indx].name.eq('/TTP')) then
-- The MDB /TTP exists
      !mdbttp = TRUE
    elseif (!mdbs[!indx].name.eq('/MDS')) then
-- The MDB /MDS exists
      !mdbmds = TRUE
    else
      skip
    endif
  enddo

-- Check if the default mdb /TTP exists etc,...
  if (!mdbttp.not()) then
    !!alert.error('***ERROR*** The mdb /TTP does NOT exist.
    A copy of the mdb /TTP to the mdb /MDS is NOT possible.
    Therefore USERS will NOT be able to enter the MDS application')
    return
  else
-- MDB /TTP exists so COPY it to mdb /MDS if required
    if (!mdbmds.not()) then
-- Copy the TTP project default mdb /TTP to MDB /MDS
      copy mdb /TTP to /MDS
      !mdbmds = TRUE
    endif
  endif

-- Add the required MDS databases to the mdb /MDS
  if (!mdbmds) then
    !mdsmdbobject = object MDB( /MDS )
    !mdsmdbdbs    = !mdsmdbobject.current()
    !mdsmdbsize   = !mdsmdbdbs.size()

-- Set /MDS to the current mdb
    set mdb /MDS

-- Loop through the MDS DBs to be added to the mdb /MDS
    do !mdsx indices !mdsdbsarray
      !dbobject = object DB(!mdsdbsarray[!mdsx])
-- Check if the MDS DB already exists in the mdb /MDS
     !finddb = !mdsmdbdbs.findfirst(!dbobject)
      if (!finddb.unset()) then
        if (!dbobject.name.eq('MDS/MDSDESIGN')) then
-- Add this MDS USER DESIGN DB at Position No.1 in the mdb /MDS
          add $!dbobject.name 1
          !mdsmdbsize = !mdsmdbsize + 1
        elseif (!dbobject.name.eq('MDS/MDSABA')) then
--<wd>oct2007<mds12>--DUN767--
-- Ensured that this DB is No.2 in the MDB list by FIRST making it No.1
-- before MDS/MDSDESIGN is eventually made No. 1
-- Add this MDS ABA DB at Position No.2 in the mdb /MDS
          add $!dbobject.name 1
          !mdsmdbsize = !mdsmdbsize + 1
        else
-- Append the remainder of the MDS DBs to the BOTTOM of the mdb list order to the mdb /MDS
          !mdsmdbsize = !mdsmdbsize + 1
          add $!dbobject.name $!mdsmdbsize
        endif
      else
-- The MDS DB is already in the mdb /MDS
        skip
      endif
    enddo

  endif

endfunction
