--     Keyword:		MDS
--   Module:		PARAGON
--   Replaces:
--
--------------------------------------------------------------------------------
-- Description
--
-- Sets the MDS12 DESIGN Application Defaults "ACTIVE" flag to FALSE for the HHI PARAGON /MDS/ATTA/DEFAULTS CATA
-- <1> - EXCEPT the MDS ANCILLARIES - BT01A, BT01B, BT10, BT11, AT66, AT102, AT109 and AT111
--
-- ************************************************************************************************
-- This "HHI" PML function, i.e. !!mdshhiatta.pmlfnc, MUST be called from the command line in the PARAGON
-- module, i.e. !!mdshhiatta(), of the AVEVA MARINE project to create/update the /MDS/ATTA/DEFAULTS Catalogue
-- of MDS ANCILLARY defaults for the MDS application
-- ************************************************************************************************
--
------------------------------------------------------------------------
--
-- Define Function
define function !!mdshhiatta()

-- Check the AVEVA Marine Module is "PARAGON"
  !session  = current session
  !project  = current project
  !projcode = !project.code()
  if (!session.module().neq('PARAGON')) then
    !!alert.error('This PML function, i.e. !!mdshhiatta(), may ONLY be run in the AVEVA MARINE "PARAGON" module.
    *** ABORTING *** the PARAGON MDS Defaults configuration of the AVEVA MARINE project "$!projcode" for the MDS Application')
    return
  endif

-- CHECK the Local Project /MDS/ATTA/DEFAULTS Catalogue exists
  /MDS/ATTA/DEFAULTS
  handle ANY
    !!alert.error('ERROR: $!!error.text - ABORTING the setting of the "ACTIVE" flags for the "HHI" /MDS/ATTA/DEFAULTS CATA')
    return
  elsehandle NONE
    if (!!ce.dbwrite.not()) then
      !!alert.error('ERROR: READ ONLY Database - ABORTING the setting of the "ACTIVE" flags for the "HHI" /MDS/ATTA/DEFAULTS CATA')
      return
    endif
  endhandle

-- Collect all the SECTION elements
  !ctype = |SECTION|
  !scope = /MDS/ATTA/DEFAULTS
--  !filtr = object expression()
-- Collect ALL of the SECTION Elements
  !sect  = object collection()
--  !sect.filter(!filtr)
  !sect.scope(!scope)
  !sect.type(!ctype)
-- SECTION Collection Results Array
$P******************************
q var !sect.results().size()

  !sectarr = !sect.results()

-- Loop Thro Each MDS STANDARD SECTION element and its CATEGORY members
  do !indx indices !sectarr
    !desc = !sectarr[!indx].description
    !prfx = !desc.substring(1,2)
    !numb = !desc.substring(3).real()
    handle (2,441)
-- Unable to convert a STRING to REAL
-- Process the "HHI" MDS ANCILLARIES - BT01A and BT01B - i.e. :mdsactive = TRUE
      if (!desc inset ('BT01A', 'BT01B')) then
        !mdsactive = TRUE
      elseif (!desc.matchwild('*REST*')) then
        !mdsactive = TRUE
      else
        !mdsactive = FALSE
      endif

    elsehandle NONE
-- Skip the MDU project USER Ancillary Standards as ONLY a few of these are PRE-SET to :mdsactive = TRUE and they need to remain so
      if ( (!prfx inset ('AN', 'AT', 'BT', 'GT', 'LT', 'ST')) and (!numb.geq(500)) ) then
        skip
      endif

-- Process the "HHI" MDS ANCILLARIES - BT10, BT11, AT66, AT102, AT109 and AT111 - i.e. :mdsactive = TRUE
      if (!desc inset ('BT10', 'BT11', 'AT66', 'AT102', 'AT109', 'AT111' ) ) then
        !mdsactive = TRUE
      else
        !mdsactive = FALSE
      endif

    endhandle

-- Process ALL the CATEGORY elements below the SECTION element
-- Set the :mdscative UDA at the SECTION element
    !!ce  = !sectarr[!indx]
    :mdsactive $!mdsactive

-- Set the :mdscative UDA at ALL the CATEGORY elements
    !smem = !!ce.mem
    do !memb indices !smem
      if (!smem[!memb].type.eq('CATE')) then
        !!ce = !smem[!memb]
        :mdsactive $!mdsactive
      else
        skip
      endif
    enddo
  enddo

endfunction
