----------------------------------------------------------------------------------------------------
-- object method
define method .plant(!config is STRING)

  -- Config will be either FULL/BRIEF for all available standards or BRIEF for a reduced demo set.
  -- There will be some hard coded standards. i.e. Marine will not include trunnions as standard
  -- and can only be turned on individually.

  -- If config is FULL them turn on all default marine standards
  -- At this point everything is off so only turn on the items you want
  -- All user defined ancillaries will be off and can only be activated individually

  if !config.eq('FULL') then
    -- First do ICONS for FULL
    !this.setAtt('/MDS/ICON/DEFAULTS/ANCHOR'   ,':MDSActive','TRUE')
    !this.setAtt('/MDS/ICON/DEFAULTS/BRANCH'   ,':MDSActive','TRUE')
