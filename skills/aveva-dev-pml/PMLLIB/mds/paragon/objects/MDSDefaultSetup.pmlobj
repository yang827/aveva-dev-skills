--
-- File:    MDSDefaultSetup.pmlobj
--   Type:    Object Definition
--   Group:   Multi Discipline Supports Application
--   Keyword:   MDS
--   Module:    design
--   Replaces:
--
-- Author:    N Morris
-- Created:   Mon 24th August 2009
--
-- Description:-- object to setup the MDS default for Marine/Plant either full/brief configuration
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  allOff()                         -
--  marine(STRING)                   -
--  plant(STRING)                    -
--  setAtt(STRING,STRING,STRING)     -
--  setup(STRING)                    -
--

-- Define Object
define object MDSDEFAULTSETUP

  -- Category member
  member .cata is ARRAY
  -- Category totals
  member .total is REAL

  -- End object
endobject
----------------------------------------------------------------------------------------------------

----------------------------------------------------------------------------------------------------
-- object method
define method .setup(!config is STRING)

  -- Config will be either FULL/BRIEF for all available standards or BRIEF for a reduced demo set.
  -- There will be some hard coded standards. i.e. Marine will not include trunnions as standard
  -- and can only be turned on individually.

  -- Make sure we can write to the database
  !test = /MDS/ATTA/DEFAULTS
  if !test.dbwrite.not() then
    !!alert.error('Unable to write to the MDS defaults database, aborting!')
    return
  endif

  -- Find out if marine or plant and run correct method
  !module = object MODULE()
  if !module.productfamily.upcase().eq('MARINE') then
    if !!alert.confirm('Are you sure you want to reset MDS to the $!config configuration').eq('YES') then
      -- Turn off everything
      !this.allOff()
      !this.marine(!config)
    endif
  else
    if !!alert.confirm('Are you sure you want to reset MDS to the $!config configuration').eq('YES') then
      -- Turn off everything
      !this.allOff()
      !this.plant(!config)
    endif
  endif

endmethod
----------------------------------------------------------------------------------------------------

----------------------------------------------------------------------------------------------------
-- object method
define method .marine(!config is STRING)

  -- Config will be either FULL/BRIEF for all available standards or BRIEF for a reduced demo set.
  -- There will be some hard coded standards. i.e. Marine will not include trunnions as standard
  -- and can only be turned on individually.

  -- If config is FULL them turn on all default marine standards
  -- At this point everything is off so only turn on the items you want
  -- All user defined ancillaries will be off and can only be activated individually

  if !config.eq('FULL') then
    -- First do ICONS for FULL
    !this.setAtt('/MDS/ICON/DEFAULTS/ANCHOR' ,':MDSActive','TRUE')
    !this.setAtt('/MDS/ICON/DEFAULTS/CABLE'  ,':MDSActive','TRUE')
    !this.setAtt('/MDS/ICON/DEFAULTS/GENERAL',':MDSActive','TRUE')
