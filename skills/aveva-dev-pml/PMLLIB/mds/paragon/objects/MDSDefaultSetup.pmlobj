    !this.setAtt('/MDS/HANGER/DEFAULTS/VH81',':MDSActive','TRUE')
    !this.setAtt('/MDS/HANGER/DEFAULTS/VH82',':MDSActive','TRUE')
    !this.setAtt('/MDS/HANGER/DEFAULTS/VH83',':MDSActive','TRUE')
    !this.setAtt('/MDS/HANGER/DEFAULTS/VH84',':MDSActive','TRUE')
    !this.setAtt('/MDS/HANGER/DEFAULTS/VH85',':MDSActive','TRUE')
    !this.setAtt('/MDS/HANGER/DEFAULTS/VH86',':MDSActive','TRUE')
    !this.setAtt('/MDS/HANGER/DEFAULTS/VH87',':MDSActive','TRUE')
    !this.setAtt('/MDS/HANGER/DEFAULTS/VH88',':MDSActive','TRUE')
    !this.setAtt('/MDS/HANGER/DEFAULTS/VH89',':MDSActive','TRUE')
  endif
  --common ancills which need to be present at all times
  !this.setAtt('/MDS/ATTA/DEFAULTS/PIPE-REST',':MDSActive','TRUE')
  !this.setAtt('/MDS/ATTA/DEFAULTS/PIPE-REST-INLINE',':MDSActive','TRUE')
  !this.setAtt('/MDS/ATTA/DEFAULTS/RACK-REST',':MDSActive','TRUE')

endmethod
----------------------------------------------------------------------------------------------------

----------------------------------------------------------------------------------------------------
-- object method
define method .allOff()

  -- Setup list of cata members/totals
  !this.cata.append(/MDS/ATTA/DEFAULTS )
  !this.cata.append(/MDS/TRUNNION/DEFAULTS )
  !this.cata.append(/MDS/ICON/DEFAULTS )
  !this.cata.append(/MDS/HANGER/DEFAULTS )

  -- Get status data for progress bar
  !this.total = 0
  do !getTotal values !this.cata
    !this.total = !this.total + !getTotal.mcount()
  enddo
  !increment = 100 / !this.total

  !!fmsys.setprogress(0)

  -- Loop through each cata and reset to off

  !count = 0
  do !resetCata values !this.cata
    !sects = !resetCata.members
    do !resetSects values !sects
      if !resetSects.owner.name.eq('/MDS/HANGER/DEFAULTS') and !resetSects.name.match('FH').eq(0) and !resetSects.name.match('VH').eq(0) then
        --only process the fixed hanger and variable hanger defaults entries i.e. ignore rod size because if we set the utility to brief mode hangers are available but alternative rod sizing is not
        skip
      endif
      !resetSects.:MdsActive = FALSE
      -- Update FMSYS progress bar
      !count = !count + 1
      !currentProgress = !count * !increment
      !!fmsys.setprogress(!currentProgress)
    enddo
  enddo

  !!fmsys.setprogress(0)

endmethod
----------------------------------------------------------------------------------------------------

----------------------------------------------------------------------------------------------------
-- object method
define method .setAtt(!member is STRING, !att is STRING, !val is STRING)

  !member.dbref().$!att = $!val
  handle (2,109)
    write '$!member not found'
  endhandle

endmethod
----------------------------------------------------------------------------------------------------
