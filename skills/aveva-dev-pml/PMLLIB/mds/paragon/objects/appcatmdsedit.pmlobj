---------------------------------------------------------------------------------------------------------

define object APPCATMDSEDIT
endobject

---------------------------------------------------------------------------------------------------------
-- Method .modifyMenus()
-- This method MUST always exist when modifying a PDMS Application MAIN BAR Menu
-- The PDMS11.6 standard loading procedure for "menu add-ins" searches and runs
-- the method .modifyMenus in each "add-in" PML object
---------------------------------------------------------------------------------------------------------

define method .modifyMenus()

  !this.catModifyMenu()

endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
-- Method .catModifyMenu()
-- This method MUST always be called from the method .modifyMenus shown above to
-- enable the "menu add-ins" to added to the required PDMS Application MAIN BAR Menu,
-- i.e. in this case the PARAGON application Utilities Menu

---------------------------------------------------------------------------------------------------------

define method .catModifyMenu()

  -- Load the MDS12.0 Application Defaults form into the PARAGON GENERAL<i.e. 'ALL'> application
  pml rehash all

  -- Nominate the AVEVA PDMS Application Menu to which the option needs adding, i.e. 'sysutil'
  !menu = object APPMENU('sysmod')

  ----------------------------------------------------------------------------
  -- Check to see if the Current User is a member of the PDMS TEAM "CATADMIN"
  -- and when TRUE the string variable !!cdlnAdmin is set to 'true'
  -- via the macro $M/%PDMSUI%/CLIB/FILES/TEAMCHK $<CATADMIN$>
  ----------------------------------------------------------------------------
  -- Append MDS12 Edit MDS Ancillaries/ATTA DEFAULTS option form to the Modify Menu in the PARAGON Application
  -- The variable !!cdlaAdmin is defined by the Standard PDMS application entry
  -- When !!cdlnAdmin is set to TRUE, the current user is a member of the PDMS TEAM
  -- "CATADMIN" i.e. The PDMS "PARAGON" CATALOGUE ADMINISTRATION TEAM
  --<RM> 06/05/2011 added a check that certain application defaults db items are loaded before we allow access to the corresponding modification tools for MDS - start
  !mdsOptionDefs = object DBREF('/MDS/OPTION/DEFAULTS')
  handle (2,109)
    !mdsOptionDefs = object DBREF()
  endhandle
  !mdsIconDefs = object DBREF('/MDS/ICON/DEFAULTS')
  handle (2,109)
    !mdsIconDefs = object DBREF()
  endhandle
  !mdsLightingDefs = object DBREF('/MDS/LIGHTING/DEFAULTS')
  handle (2,109)
    !mdsLightingDefs = object DBREF()
  endhandle
  !mdsZoneIDDefs = object DBREF('/MDS/ZONEID/DEFAULTS')
  handle (2,109)
    !mdsZoneIDDefs = object DBREF()
  endhandle
  !mdsAttaDefs = object DBREF('/MDS/ATTA/DEFAULTS')
  handle (2,109)
    !mdsAttaDefs = object DBREF()
  endhandle
  !mdsTrunnionDefs = object DBREF('/MDS/TRUNNION/DEFAULTS')
  handle (2,109)
    !mdsTrunnionDefs = object DBREF()
  endhandle
  !mdsPreliminaryDefs = object DBREF('/MDS/PRELIMINARY/DEFAULTS')
  handle (2,109)
    !mdsPreliminaryDefs = object DBREF()
  endhandle
  !mdsStructureDefs = object DBREF('/MDS/STRUCTURE/DEFAULTS')
  handle (2,109)
    !mdsStructureDefs = object DBREF()
  endhandle
  !mdsHangerDefs = object DBREF('/MDS/HANGER/DEFAULTS')
  handle (2,109)
    !mdsHangerDefs = object DBREF()
  endhandle
  !mdsSelCriteria = object DBREF('/MDS/SELECTION-CRITERIA')
  handle (2,109)
    !mdsSelCriteria = object DBREF()
  endhandle
  !mdsCompensationOptn = object DBREF('/MDS/COMPENSATING-PLATES/OPTIONS')
  handle (2,109)
    !mdsCompensationOptn = object DBREF()
  endhandle
  !mdsCompensationXsize = object DBREF('/MDS/COMPENSATING-PLATES/X-SIZE')
  handle (2,109)
    !mdsCompensationXsize = object DBREF()
  endhandle
  !mdsCompensationYsize = object DBREF('/MDS/COMPENSATING-PLATES/Y-SIZE')
  handle (2,109)
    !mdsCompensationYsize = object DBREF()
  endhandle
  !mdsCompensationMaterial = object DBREF('/MDS/COMPENSATING-PLATES/MATERIAL')
  handle (2,109)
    !mdsCompensationMaterial = object DBREF()
  endhandle

  if(defined(!!cdlnAdmin.boolean())) then
    if(!!cdlnAdmin.boolean()) then
      -- Load the MDS12.0 Application Defaults form into the PARAGON GENERAL<i.e. 'ALL'> application
      -- Handle PML form loading ERRORS if the MDS DEFAULTS CATALOGUES DO NO EXIST!, e.g. /MDS/ATTA/DEFAULTS
      !menu.add('separator')
      !menu.add('separator')
      -- <jw - june 09> DUN1133 changed some callbacks below to !!mdsParagonFormCheck() which checks that forms
      --                with similar functionality cannot be shown.  Also added MDS Active Control form
      !menu.add('callback', 'MDS Active Control...', '!!mdsParagonFormCheck(|ACTIVECONTROL|)', 'mdseditactive')
      !menu.add('callback', 'MDS Application Defaults...', '!!mdsParagonFormCheck(|ADMIN|)', 'mdseditdefs')
      !menu.add('callback', 'MDS Ancillary Defaults...', '!!mdsParagonFormCheck(|ANCILLARIES|)', 'mdseditattadefs')
      !menu.add('callback', 'MDS Hanger Template Defaults...', '!!mdsParagonFormCheck(|HANGER|)', 'mdsedithangdefs')
      !menu.add('callback', 'MDS Lighting Support Defaults...', '!!mdsParagonFormCheck(|LIGHTING|)', 'mdseditlightdefs')
      !menu.add('callback', 'MDS Structure Defaults...', '!!mdsParagonFormCheck(|STRUCTURE|)', 'mdseditstrudefs')
      !menu.add('callback', 'MDS Trunnion Defaults...', '!!mdsParagonFormCheck(|TRUNNION|)', 'mdsedittrundefs')
      !menu.add('callback', 'MDS ABA Loc Plan Grid Defaults...', '!!mdsParagonFormCheck(|GRID|)', 'mdsConfigGriddata')
      !menu.add('callback', 'MDS Ancillary Selection Criteria...', '!!mdsParagonFormCheck(|CRITERIA|)', 'mdsselectioncrit')
      !menu.add('form','MDS Compensation Options...','mdscompensationoptions','mdscompensationoptions')
      !menu.add('form','MDS Compensation Sizes...','mdscompensationsizes','mdscompensationsizes')
      !menu.add('form','MDS Compensation Materials...','mdscompensationmaterials','mdscompensationmaterials')
      !menu.add('separator')
      --now check that the pre-requisite defaults exist for each menu item. if they do not deactivate them
      if !mdsOptionDefs.unset() then
        !menu.menu.setactive('MDS Application Defaults...', FALSE)
      endif
      if !mdsOptionDefs.unset() or !mdsAttaDefs.unset() or !mdsPreliminaryDefs.unset() then
        !menu.menu.setactive('MDS Ancillary Defaults...', FALSE)
      endif
      if !mdsOptionDefs.unset() or !mdsAttaDefs.unset() or !mdsPreliminaryDefs.unset() or !mdsStructureDefs.unset() then
        !menu.menu.setactive('MDS Structure Defaults...', FALSE)
      endif
      if !mdsHangerDefs.unset() then
        !menu.menu.setactive('MDS Hanger Template Defaults...', FALSE)
      endif
      if !mdsTrunnionDefs.unset() or !mdsAttaDefs.unset() then
        !menu.menu.setactive('MDS Trunnion Defaults...', FALSE)
        !menu.menu.setactive('MDS Active Control...', FALSE)
      endif
      if !mdsLightingDefs.unset() then
        !menu.menu.setactive('MDS Lighting Support Defaults...', FALSE)
      endif
      if !mdsSelCriteria.unset() and !mdsOptionDefs.unset() then
        !menu.menu.setactive('MDS Ancillary Selection Criteria...', FALSE)
      endif
      if !mdsCompensationOptn.unset() then
        !menu.menu.setactive('MDS Compensation Options...', FALSE)
      endif
      if !mdsCompensationXsize.unset().or(!mdsCompensationYsize.unset()) then
        !menu.menu.setactive('MDS Compensation Sizes...', FALSE)
      endif
      if !mdsCompensationMaterial.unset() then
        !menu.menu.setactive('MDS Compensation Materials...', FALSE)
      endif
      --<RM> 06/05/2011 added a check that certain application defaults db items are loaded before we allow access to the corresponding modification tools for MDS - end
    endif
  endif

  -- Add the MDS12.0 Edit Ancillaries option to the Modify menu in the PARAGON application ONLY
  !!appMenuCntrl.addmenu(!menu, 'ALL')

  -- Nominate the AVEVA PDMS Application Menu to which the option needs adding, i.e. 'sysutil'
  !menu = object APPMENU('sysutil')

  ----------------------------------------------------------------------------
  -- Check to see if the Current User is a member of the PDMS TEAM "CATADMIN"
  -- and when TRUE the string variable !!cdlnAdmin is set to 'true'
  -- via the macro $M/%PDMSUI%/CLIB/FILES/TEAMCHK $<CATADMIN$>
  ----------------------------------------------------------------------------
  -- Append MDS12 Edit MDS Ancillaries/ATTA DEFAULTS option form to the Modify Menu in the PARAGON Application
  -- The variable !!cdlaAdmin is defined by the Standard PDMS application entry
  -- When !!cdlnAdmin is set to TRUE, the current user is a member of the PDMS TEAM
  -- "CATADMIN" i.e. The PDMS "PARAGON" CATALOGUE ADMINISTRATION TEAM
  if(defined(!!cdlnAdmin.boolean())) then
    if(!!cdlnAdmin.boolean()) then
      -- Load the MDS12.0 Application Defaults form into the PARAGON GENERAL<i.e. 'ALL'> application
      -- Handle PML form loading ERRORS if the MDS DEFAULTS CATALOGUES DO NO EXIST!, e.g. /MDS/ATTA/DEFAULTS
      !menu.add('separator')
      !menu.add('callback', 'Check MDS Application Defaults...', '!!mdsParagonFormCheck(|CHECKDFLTS|)', 'mdscheckdflts')
    endif
  endif

  if !mdsAttaDefs.unset() or !mdsTrunnionDefs.unset() or !mdsPreliminaryDefs.unset() or !mdsStructureDefs.unset() then
    !menu.menu.setactive('Check MDS Application Defaults...', FALSE)
    handle (61,558)
      --handle included for when mds is not available at all. i.e. 'the Check MDS Application Defaults...' menu item has not been loaded
    endhandle
  endif

  -- Add the MDS12.0 Edit Ancillaries option to the Modify menu in the PARAGON application ONLY
  !!appMenuCntrl.addmenu(!menu, 'ALL')

endmethod

---------------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------------
