-- File:    mdsActiveControlData.pmlobj
-- Type:    Object Definition
-- Group:   Multi Discipline Supports Application
-- Keyword: MDS
-- Module:  Paragon
-- Author:  Joe Wyatt
-- Created: 13/05/09
--
-- Description: Object that collects, stores, sorts and modifies mds standard support
--              types in PARAGON
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  collectAncils()                  -
--  collectBores(DBREF)              -
--  findAncils(STRING)               -
--  findTypes()                      -
--  makeChangesAncils()              -
--  makeChangesBores(REAL,REAL)      -
--  sortBores()                      ARRAY
--  sortData(STRING)                 ARRAY
--
--    [#]   [R/RW]   [Data Type]   [Description]
--
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------
define object MDSACTIVECONTROLDATA
  member .listAll is ARRAY
  member .sorted is ARRAY
  member .ancilTypes is ARRAY
  member .changed is ARRAY
endobject
-------------------------------------------------------------------------------
-- Description: Collects ancillary data from the specified locations and stores
--              them in !this.listAll
-------------------------------------------------------------------------------
define method .collectAncils()
  !ancilColl = object COLLECTION()
  !ancilColl.type('SECT')
  !ancilLocation = '/MDS/ATTA/DEFAULTS'
  !trunnionLocation = '/MDS/TRUNNION/DEFAULTS'
  !preliminaryLocation = '/MDS/PRELIMINARY/DEFAULTS'
  !structureLocation = '/MDS/STRUCTURE/DEFAULTS'
  !hangerLocation = '/MDS/HANGER/DEFAULTS'
  !ancilColl.scope(!ancilLocation.dbref())
  !ancilColl.addscope(!trunnionLocation.dbref())
  !ancilColl.addscope(!preliminaryLocation.dbref())
  !ancilColl.addscope(!structureLocation.dbref())
  !ancilColl.addscope(!hangerLocation.dbref())
  !this.listAll = !ancilColl.results()
  !this.findTypes()
endmethod
-------------------------------------------------------------------------------
-- Description: Collects data on bore sizes for the specified ancillary and stores
--              them in !this.listAll
-------------------------------------------------------------------------------
define method .collectBores(!currentAncil is DBREF)
  var !col collect all CATE with func neq 'GENERAL' and func neq 'VENDOR' and func neq 'ALTD' and func neq 'CONFIG' and func neq '0' for $!currentAncil
  !this.listAll = !col
endmethod
-------------------------------------------------------------------------------
-- Description: Finds the different support types and stores them in !this.ancilTypes
-------------------------------------------------------------------------------
define method .findTypes()
  !types = ARRAY()
  do !currentAncil values !this.listAll
    !currentName = !currentAncil.desc.substring(1, 2).upcase()
    if !types.findFirst(!currentName).unset() then
      if !currentAncil.desc.upcase().occurs('REST').eq(0) and !currentName.neq('MH') then
        -- NO, MD and AL come from the HANGER/DEFAULTS but are not required
        if !currentName.neq('NO') and !currentName.neq('MD') and !currentName.neq('AL') then
          !types.append(!currentName)
        endif
      endif
    endif
  enddo
  !types.append('REST')
  !types.append('ALL')
  !this.ancilTypes = !types
endmethod
-------------------------------------------------------------------------------
-- Description: Finds all the supports for a given support type and stores them
--              in !this.sorted
-------------------------------------------------------------------------------
define method .findAncils(!ancilType is STRING)
  !ancilNum = !this.ancilTypes.findFirst(!ancilType)
  if undefined(!this.sorted[!ancilNum]) then
    if !ancilType.eq('ALL') then
      !tempSorted = !this.listAll
    else
      !tempSorted = ARRAY()
      do !currentAncil values !this.listAll
        if !currentAncil.desc.upcase().occurs('REST').eq(0) then
          if !currentAncil.desc.substring(1, 2).upcase().eq(!ancilType) then
            !tempSorted.append(!currentAncil)
          endif
        elseif !ancilType.eq('REST') then
          !tempSorted.append(!currentAncil)
        endif
      enddo
    endif
    !this.sorted[!ancilNum] = !tempSorted
  endif
endmethod
-------------------------------------------------------------------------------
-- Description: For a given support type data is collected for each support that has
--              been found and is returned in an array.  This data is row number,
--              mds name, replacement name, description and active status
-------------------------------------------------------------------------------
define method .sortData(!ancilType is STRING) is ARRAY
  !rows = ARRAY()
  !rowNum = 1
  !typeNo = !this.ancilTypes.findFirst(!ancilType)
  do !currentAncil values !this.sorted[!typeNo]
    !ancilName = !currentAncil.name
    !tempRow[1] = !rowNum
    !tempRow[2] = (!currentAncil.desc)
    !tempCcod = (pprop of $!ancilName/GEN/CCOD )
    !tempRow[3] = (!tempCcod.after(|( '|).before(|' )|))
    !tempDesc = (pprop of $!ancilName/GEN/DESC )
    !tempRow[4] = (!tempDesc.after(|( '|).before(|' )|))
    !tempRow[5] = !currentAncil.:MDSActive.string().upcase()
    !rows.append(!tempRow)
    !rowNum = !rowNum + 1
  enddo
  return !rows
endmethod
-------------------------------------------------------------------------------
-- Description: Data is collected for the current bores and is returned in an array
--              This data is row number, bore size and active status
-------------------------------------------------------------------------------
define method .sortBores() is ARRAY
  !rows = ARRAY()
  !rowNum = 1
  do !currentBore values !this.listAll
    !tempRow[1] = !rowNum
    !tempRow[2] = !currentBore.dbref().function
    !tempRow[3] = !currentBore.dbref().:MDSActive.string().upcase()
    !rows.append(!tempRow)
    !rowNum = !rowNum + 1
  enddo
  return !rows
endmethod
-------------------------------------------------------------------------------
-- Description: Writes changes stored in !this.changed to the database
--              (if object is used to store ancillaries)
-------------------------------------------------------------------------------
define method .makeChangesAncils()
  do !arrayPos indices !this.changed
    do !row indices !this.changed[!arrayPos]
      !this.sorted[!arrayPos][!row].:MDSActive = !this.changed[!arrayPos][!row]
    enddo
  enddo
endmethod
-------------------------------------------------------------------------------
-- Description: Writes changes stored in !this.changed to the database
--              (if object is used to store bores)
-------------------------------------------------------------------------------
define method .makeChangesBores(!arrayPos is REAL, !row is REAL)
  do !bore indices !this.changed[!arrayPos][!row]
    !this.listAll[!bore].dbref().:MDSActive = !this.changed[!arrayPos][!row][!bore]
  enddo
endmethod
