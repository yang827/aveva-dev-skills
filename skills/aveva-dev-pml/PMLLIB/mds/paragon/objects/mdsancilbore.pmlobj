----------------------------------------------------------------------
----------------------------------------------------------------------
-- Object to hold data for a particular ancillary bore size
----------------------------------------------------------------------
--
-- M Board 13/12/05

define object MDSANCILBORE

-- define members

  member .size is REAL
  member .active is BOOLEAN
  member .shopflag is BOOLEAN
  member .shopflagdbref is DBREF

  member .pipemat is STRING
  member .pipematdbref is DBREF

  member .prop is STRING
  member .propdbref is DBREF

  member .frmwclosedend is REAL
  member .frmwclosedenddbref is DBREF

  member .frmwopenend is REAL
  member .frmwopenenddbref is DBREF

  member .frmwclropt is STRING
  member .frmwclroptdbref is DBREF

  member .despar is ARRAY
  member .despardbref is ARRAY
  --.dbref held to write back to set active
  member .dbref is DBREF
  -- dbref to scom in component database
  member .scomdbref is DBREF

  member .despardescription is ARRAY
  member .desparnumber is ARRAY
  member .despartype is ARRAY

  member .altexpr is ARRAY
  member .altexprdbref is ARRAY
  member .altdesparval is ARRAY
  member .altdesparnumber is ARRAY
  member .altdespardbref is ARRAY

  member .userdespnum is ARRAY
  member .userdespmin is ARRAY
  member .userdespmax is ARRAY

  member .userdespmindbref is ARRAY
  member .userdespmaxdbref is ARRAY

  member .trundeflength is REAL
  member .trunminlength is REAL
  member .trunmaxlength is REAL
  member .trundeflendbref is DBREF
  member .trunminlendbref is DBREF
  member .trunmaxlendbref is DBREF

  member .trunfixeditemborearray is ARRAY
  member .trunfixeditemarray is ARRAY

  member .trunfixeditemdbrefarray is ARRAY

endobject
