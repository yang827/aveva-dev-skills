----------------------------------------------------------------------
-- Object to get and hold ancillary data
----------------------------------------------------------------------
--
-- M Board 8/11/05

-- 24/01/06 Now gets structure (framework) data M Board
-- 31/01/06 Now gets trunnion data M Board

define object MDSANCILDATA

  --members created for all ancils on form definition

  member .dbref is DBREF

  --member to store component dataset reference

  member .compdetref is DBREF

  --tags/values for text gadgets across top of form

  member .mainnameval is STRING
  member .mainnamedbref is DBREF

  member .rnameval is STRING
  member .rnamedbref is DBREF

  member .description is STRING
  member .descriptiondbref is DBREF

  member .suppfuncval is STRING
  member .suppfuncdbref is DBREF

  --tags/values for text gadgets on standard (first) tab

  member .active is BOOLEAN
  member .vendval is STRING
  --member .vendtag is STRING
  member .venddbref is DBREF
  member .elevval is STRING
  --member .elevtag is STRING
  member .elevdbref is DBREF
  member .pipematval is STRING
  --member .pipemattag is STRING
  member .pipematdbref is DBREF
  member .propval is STRING
  --member .proptag is STRING
  member .propdbref is DBREF
  member .isofval is STRING
  --member .isoftag is STRING
  member .isofdbref is DBREF

  --Framework (structure) specific members
  member .framesele is ARRAY
  member .framerestr is ARRAY
  member .framemtoc is BOOLEAN
  member .frameseledbref is DBREF
  member .framerestrdbref is DBREF
  member .framemtocdbref is DBREF
  member .frameacod is ARRAY
  member .framefcod is ARRAY
  member .frameacoddbref is ARRAY
  member .framefcoddbref is ARRAY
  member .framecodnum is ARRAY

  member .fgrp is STRING
  member .fgrpdbref is DBREF

  --array of bore objects, indiced by their bore size
  member .bore is ARRAY

  member .dpnumber is ARRAY

  --descriptions, description numbers and ptypes from component database
  member .descarray is ARRAY
  member .descnumberarray is ARRAY
  member .ptypearray is ARRAY

  --modified flag
  member .modified is BOOLEAN

  --vendor info and despar info flag (GEN only)
  member .vendanddesparsflag is BOOLEAN

  --flag for PIPE-REST (anything with REST in name) with only bores and clearance information set
  member .boreandclearanceonlyflag is BOOLEAN

endobject

---------------------------------------------------------------------------

define method .initdata()

  !this.modified = FALSE

  --this section to get vendor data and 'bore 0' data from CATA MDS/ATTA/DEFAULTS

  --get description (code) e.g. AT01 and replacement name (client code) e.g. XAT01

  !sectref = !this.dbref
--q var !sectref
  var !datacoll coll all data for $!sectref
  var !dkeycoll eval dkey for all from !datacoll

  do !i index !datacoll
    if !dkeycoll[!i].eq('CODE') then
      !this.mainnameval = !datacoll[!i].dbref().pProperty.after(|( '|).before(|' )|)
      !this.mainnamedbref = !datacoll[!i].dbref()
      break
    endif
  enddo

  do !i index !datacoll
    if !dkeycoll[!i].eq('CCOD') then
      !this.rnameval = !datacoll[!i].dbref().pProperty.after(|( '|).before(|' )|)
      !this.rnamedbref = !datacoll[!i].dbref()
      break
    endif
  enddo

  do !i index !datacoll
    if !dkeycoll[!i].eq('DESC') then
      !this.description = !datacoll[!i].dbref().pProperty.after(|( '|).before(|' )|)
      !this.descriptiondbref = !datacoll[!i].dbref()
      break
    endif
  enddo

  do !i index !datacoll
    if !dkeycoll[!i].eq('SUPF') then
      !this.suppfuncval = !datacoll[!i].dbref().pProperty.after(|( '|).before(|' )|)
      !this.suppfuncdbref = !datacoll[!i].dbref()
      break
    endif
  enddo

  --set active value for standard
  !this.active = !sectref.:mdsactive

  -----------------------------------------------------------------------
  --NEW SECTION TO GET FRAMEWORK SELECTIONS, RESTRICTIONS, FLAG

  var !frameselecoll coll all data with dkey eq 'SELE' for $!sectref
  var !frameselearray eval pprop for all from !frameselecoll
  var !framerestrcoll coll all data with dkey eq 'RSTR' for $!sectref
  var !framerestrarray eval pprop for all from !framerestrcoll
  var !framemtoccoll coll all data with desc eq 'CONFIG-MTOC' for $!sectref
  var !framemtocarray eval pprop for all from !framemtoccoll
  var !framefcodcoll coll all data with dkey eq 'FCOD' for $!sectref
  var !framefcodarray eval pprop for all from !framefcodcoll
  var !frameacodcoll coll all data with dkey eq 'ACOD' for $!sectref
  var !frameacodarray eval pprop for all from !frameacodcoll

  !this.framesele = !frameselearray[1].after(|( '|).before(|' )|).split(',')
  handle ANY
  elsehandle NONE
    !this.framerestr = !framerestrarray[1].after(|( '|).before(|' )|).split(',')
    handle any
    elsehandle none
    !this.frameseledbref = !frameselecoll[1].dbref()
    !this.framerestrdbref = !framerestrcoll[1].dbref()

    if !sectref.owner.name.eq('/MDS/STRUCTURE/DEFAULTS') then

      !this.framemtoc = !framemtocarray[1].after(|( '|).before(|' )|).trim().boolean()
      !this.framemtocdbref = !framemtoccoll[1].dbref()


      do !i index !framefcodcoll
        !this.framefcod[!i] = !framefcodarray[!i].after(|( '|).before(|' )|)

        !this.frameacod[!i] = !frameacodarray[!i].after(|( '|).before(|' )|)
        !this.framecodnum[!i] = !i.string()
        !this.framefcoddbref[!i] =  !framefcodcoll[!i].dbref()
        !this.frameacoddbref[!i] =  !frameacodcoll[!i].dbref()
      enddo
    endif
  endhandle
  endhandle

  --FRAMEWORK GROUP SECTION

  var !framegroupcoll coll all data with dkey eq 'FGRP' for $!sectref
  var !framegrouparray eval pprop for all from !framegroupcoll

  !this.fgrp = !framegrouparray[1].after(|( '|).before(|' )|)
  handle ANY
  elsehandle NONE
    !this.fgrpdbref = !framegroupcoll[1].dbref()
  endhandle
  --END FRAMEWORK GROUP SECTION

  --END FRAMEWORK SECTION
  -----------------------------------------------------------------------

  var !vendcoll collect all data with purp eq 'VEND' for $!sectref
  var !vendprop eval pprop for all from !vendcoll
  --var !vendname eval dtitle for all from !vendcoll
  if !vendprop.unset() then
    write '$!this.mainnameval no design parameters found'
    !this.vendanddesparsflag = FALSE
  else
    !this.vendanddesparsflag = TRUE
  endif

  if !this.mainnameval.match('REST').neq(0) then
    !this.boreandclearanceonlyflag = TRUE
  else
    !this.boreandclearanceonlyflag = FALSE
  endif

  !this.vendval = !vendprop[1].after(|( '|).before(|' )|)
  handle ANY
    !this.vendval = ''
    --!this.vendtag = ''
    !this.elevval = ''
    --!this.elevtag = ''
    !this.pipematval = ''
    --!this.pipemattag = ''
    !this.propval = ''
    --!this.proptag = ''
    !this.isofval = 'true'
    --!this.isoftag = ''
    return
  endhandle
  --!this.vendtag = !vendname[1]
  !this.venddbref = !vendcoll[1].dbref()

  var !elevcoll collect all data with dkey eq 'ELEV' for $!sectref
  var !elevprop eval pprop for all from !elevcoll
  --var !elevname eval dtitle for all from !elevcoll
  !this.elevval = !elevprop[1].after(|( '|).before(|' )|)
  --!this.elevtag = !elevname[1]
  !this.elevdbref = !elevcoll[1].dbref()

  var !pipematcoll collect all data with purp eq 'PIPE' for $!sectref
  var !pipematprop eval pprop for all from !pipematcoll
  --var !pipematname eval dtitle for all from !pipematcoll
  !this.pipematval = !pipematprop[1].after(|( '|).before(|' )|)
  --!this.pipemattag = !pipematname[1]
  !this.pipematdbref = !pipematcoll[1].dbref()

  var !propcoll collect all data with purp eq 'PROP' for $!sectref
  var !propprop eval pprop for all from !propcoll
  --var !propname eval dtitle for all from !propcoll
  !this.propval = !propprop[1].after(|( '|).before(|' )|)
  --!this.proptag = !propname[1]
  !this.propdbref = !propcoll[1].dbref()

  var !isofcoll collect all data with purp eq 'ISOF' for $!sectref
  var !isofprop eval pprop for all from !isofcoll
  --var !isofname eval dtitle for all from !isofcoll
  !this.isofval = !isofprop[1].after(|( '|).before(|' )|)
  --!this.isoftag = !isofname[1]
  !this.isofdbref = !isofcoll[1].dbref()

endmethod

--------------------------------------------------------------------------

define method .initdespars()

  if !this.boreandclearanceonlyflag.not() then

    --First section to collect descriptions from component database if available

    !catename = !this.dbref.name.after('DEFAULTS/')

    if !catename.match('AC17').gt(0) then
      !catename = 'AC17'
    endif

    !repName = '/ATTA-' & !catename
    var !validName exists $!repName
    if (!validName.substring(1,4).boolean().not()) then
      -- Try the replacement name
      !repName = '/ATTA-' & !!mdsStdsAncil.datasectlist.dtext[!!mdsStdsAncil.datasectlist.val].split()[2].after('X')
      var !validName exists $!repName
    endif
    if (!validName.substring(1,4).boolean().not()) then
      write |$!repName not found - cannot collect scom dbrefs and get descriptions|
      !nocatetest = TRUE
    else
      !nocatetest = FALSE
      var !scomcoll coll all scom for $!repName
      --var !scombores eval param[1] for all from !scomcoll
      --collect bores and store dbref for each scom in relevant bore object
      var !scomdtref eval dtref for all from !scomcoll
      --store component dataset reference as member of object (for mdsactive setting)
      !this.compdetref = !scomdtref[1].dbref()
    endif

    !dtse = !this.compdetref

    if !dtse.unset().not() then

      var !datacoll coll all data for $!dtse

      --store arrays of descriptions, and numbers of descriptions in object

      !this.descarray = ARRAY()
      !this.descnumberarray = ARRAY()
      !this.ptypearray = ARRAY()

      do !i index !datacoll
        if !datacoll[!i].dbref().purp.eq('DESP') then
          !this.descarray.append(!datacoll[!i].dbref().dtitle)
          !this.descnumberarray.append(!datacoll[!i].dbref().number)
          !this.ptypearray.append(!datacoll[!i].dbref().ptype)
        endif
      enddo

    endif

  endif

  --This section to set descriptions in object, to those from comp dataset
  --or, if available, local descriptions

  !sectref = !this.dbref

    --CLOSED AND OPEN END SECTION

  var !frmwclosedendcoll coll all data with dkey eq 'CEND' for $!sectref
  var !frmwclosed eval pproperty for all from !frmwclosedendcoll
  var !frmwopenendcoll coll all data with dkey eq 'OEND' for $!sectref
  var !frmwopen eval pproperty for all from !frmwopenendcoll
  var !frmwclroptcoll coll all data with dkey eq 'CLGE' for $!sectref
  var !frmwclropt eval pproperty for all from !frmwclroptcoll

  --END CLOSED AND OPEN END SECTION

  var !catecoll coll all cate with purp eq 'MDS' and (real(func) gt (0)) for $!sectref

  var !boresizes eval function for all from !catecoll

  if !this.boreandclearanceonlyflag.not() then

    var !mdsactive eval :MDSActive for all from !catecoll

    var !borepipematcoll coll all data with purp eq 'PIPE' for $!sectref
    !borepipematcoll.removefirst()
    handle ANY
    endhandle
    var !borepipemat eval pproperty for all from !borepipematcoll

    var !borepropcoll collect all data with purp eq 'PROP' for $!sectref
    !borepropcoll.removefirst()
    handle ANY
    endhandle
    var !boreprop eval pproperty for all from !borepropcoll

    var !isofdatacoll coll all data with dkey eq 'SHOP' for $!sectref
    var !isofarray eval pproperty for all from !isofdatacoll
    --var !altexprcoll coll all data with dkey eq 'AEXP' for $!sectref
    --var !altexpr eval pproperty for all from !altexprcoll

    --create array of bores corresponding to each altexpr - may not be an altexpr
    --for every bore

    var !altexprdtsecoll coll all DTSE with purpose eq 'ALTE' for $!sectref
    var !altbores eval function for all from !altexprdtsecoll

    var !altdespardtsecoll coll all DTSE with purpose eq 'ALTD' for $!sectref

    var !userdtsecoll coll all DTSE with purpose eq 'USER' for $!sectref

  endif

  --create array of mdsancil boreobjects
  --set dp values into each mdsancilbore object
  --use sparse array indexed with bore size value

  !this.bore = ARRAY()

  !mdsancilboreobj = object MDSANCILBORE()

  !tempcounter = 1

  do !i values !boresizes

    !temp = !catecoll[!tempcounter]

    !mdsancilboreobj.size = !boresizes[!tempcounter].real()

    !mdsancilboreobj.frmwclosedend = !frmwclosed[!tempcounter].after(|( |).before(| )|).real()
    handle ANY
    elsehandle NONE
      !mdsancilboreobj.frmwclosedenddbref = !frmwclosedendcoll[!tempcounter].dbref()

      !mdsancilboreobj.frmwopenend = !frmwopen[!tempcounter].after(|( |).before(| )|).real()
      !mdsancilboreobj.frmwopenenddbref = !frmwopenendcoll[!tempcounter].dbref()

      !mdsancilboreobj.frmwclropt = !frmwclropt[!tempcounter].after(|( '|).before(|' )|)
      !mdsancilboreobj.frmwclroptdbref = !frmwclroptcoll[!tempcounter].dbref()
    endhandle

    if !this.boreandclearanceonlyflag.not() then

      !mdsancilboreobj.active = !mdsactive[!tempcounter].boolean()

      !mdsancilboreobj.pipemat = !borepipemat[!tempcounter].after(|( '|).before(|' )|)
      !mdsancilboreobj.pipematdbref = !borepipematcoll[!tempcounter].dbref()

      !mdsancilboreobj.prop = !boreprop[!tempcounter].after(|( '|).before(|' )|)
      !mdsancilboreobj.propdbref = !borepropcoll[!tempcounter].dbref()

      !mdsancilboreobj.shopflag = !isofarray[!tempcounter].after(|( '|).before(|' )|).trim().boolean()
      !mdsancilboreobj.shopflagdbref = !isofdatacoll[!tempcounter].dbref()

      !mdsancilboreobj.dbref = !catecoll[!tempcounter].dbref()

      var !trundeflengthcol collect all data with dkey eq 'DEFL' for $!temp
      var !trunminlengthcol collect all data with dkey eq 'MINL' for $!temp
      var !trunmaxlengthcol collect all data with dkey eq 'MAXL' for $!temp

      var !trundeflength eval pprop for all from !trundeflengthcol
      var !trunminlength eval pprop for all from !trunminlengthcol
      var !trunmaxlength eval pprop for all from !trunmaxlengthcol

      !mdsancilboreobj.trundeflendbref = !trundeflengthcol[1].dbref()
      handle ANY
      elsehandle NONE
        !mdsancilboreobj.trunminlendbref = !trunminlengthcol[1].dbref()
        !mdsancilboreobj.trunmaxlendbref = !trunmaxlengthcol[1].dbref()

        !mdsancilboreobj.trundeflength = !trundeflength[1].after(|( '|).before(|' )|).trim().real()
        !mdsancilboreobj.trunminlength = !trunminlength[1].after(|( '|).before(|' )|).trim().real()
        !mdsancilboreobj.trunmaxlength = !trunmaxlength[1].after(|( '|).before(|' )|).trim().real()

        var !fixeditemcol collect all data with desc eq 'FIXED-ITEMS' for $!temp
        var !fixeditem eval pprop for all from !fixeditemcol

        !borearray = ARRAY()
        !fixedarray = ARRAY()

        do !k index !fixeditem

          !split = !fixeditem[!k].after(|( '|).before(|' )|).split(',')
          !borearray.append(!split[1])
          !fixeditemarray = ARRAY()
          do !m index !split
            if !m.geq(2) then
              !fixeditemarray.append(!split[!m])
              !fixedarray[!k][!m - 1] = !split[!m]
            endif

          enddo

        enddo

        !mdsancilboreobj.trunfixeditemborearray = !borearray
        !mdsancilboreobj.trunfixeditemarray = !fixedarray

        !tempfixarray = ARRAY()
        do !j index !fixeditemcol
          !tempfixarray[!j] = !fixeditemcol[!j].dbref()
        enddo
        !mdsancilboreobj.trunfixeditemdbrefarray = !tempfixarray

      endhandle

      if !nocatetest.neq(TRUE) then

        !mdsancilboreobj.scomdbref = !scomcoll[!tempcounter].dbref()
        handle ANY
          --if no SCOM for this bore just handle error (don't put scom dbref in bore object)
        endhandle

      endif

      if !altbores.findfirst(!i).unset().not() then
        --this bore does have an alternative expression so...
        --$p bore $!i found

        !currentaltexprdtse = !altexprdtsecoll[!altbores.findfirst(!i)]

        var !altexprdatacoll coll all data with dkey eq 'AEXP' for $!currentaltexprdtse

        !currentaltdespardtse = !altdespardtsecoll[!altbores.findfirst(!i)]

        --altexpression array (1D) for bore
        var !altexprarray eval pproperty for all from !altexprdatacoll
        do !r index !altexprarray
          !altexprarray[!r] = !altexprarray[!r].after(|( '|).before(|' )|)
        enddo

        !altdesparvalmultiarray = ARRAY()
        !altdesparnumbermultiarray = ARRAY()
        !altexprarrayofdbrefs = ARRAY()
        !altdespardbrefmultiarray = ARRAY()
        --now create multi-dimensional array of altdespars (may be more than one for each altexpr)
        do !m index !altexprdatacoll
          var !altdespardatacoll coll all data with punits eq 'ALTEXPR/$!m' for  $!currentaltdespardtse

          var !altdesparvalues eval pprop for all from !altdespardatacoll
          var !altdesparnumbers eval number for all from !altdespardatacoll

          do !z index !altdespardatacoll
            !altdesparvalmultiarray[!m][!z] = !altdesparvalues[!z].after(|( |).before(| )|)
            !altdesparnumbermultiarray[!m][!z] = !altdesparnumbers[!z]
            !altdespardbrefmultiarray[!m][!z] = !altdespardatacoll[!z].dbref()
          enddo
          !altexprarrayofdbrefs[!m] = !altexprdatacoll[!m].dbref()
        enddo


        !mdsancilboreobj.altexpr = !altexprarray
        !mdsancilboreobj.altexprdbref = !altexprarrayofdbrefs

        !mdsancilboreobj.altdesparval = !altdesparvalmultiarray
        !mdsancilboreobj.altdesparnumber = !altdesparnumbermultiarray
        !mdsancilboreobj.altdespardbref = !altdespardbrefmultiarray

      else
        --set temporary object alt values to unset
        !mdsancilboreobj.altexpr = ARRAY()
        !mdsancilboreobj.altexprdbref = ARRAY()
        !mdsancilboreobj.altdespardbref = ARRAY()
        !mdsancilboreobj.altdesparval = ARRAY()
        !mdsancilboreobj.altdesparnumber = ARRAY()
      endif

      !temp = !catecoll[!tempcounter]
      var !dpcoll coll all data with purp eq 'DESP' for $!temp
      var !dpvalues eval pproperty for all from !dpcoll
      --Get design parameter number from parameter database
      var !dpnumber eval number for all from !dpcoll
      --var !dpdescription eval dtitle for all from !dpcoll

      !this.dpnumber = !dpnumber

      --loop below could be used to look for/and set local description into database

      --do !j index !dpvalues
      do !j values !dpnumber
        --loop to set values of despar and despardbref for object
        !indice = !this.descnumberarray.findfirst(!j.real())

        !mdsancilboreobj.despar[!j.real()] = !dpvalues[!j.real()].after(|( '|).before(|' )|)
        --!mdsancilboreobj.despar[!dpnumber[!j].real()] = !dpvalues[!j.real()].after(|( '|).before(|' )|)
        !mdsancilboreobj.despardbref[!j.real()] = !dpcoll[!j.real()].dbref()
        --!mdsancilboreobj.despardbref[!dpnumber[!j].real()] = !dpcoll[!j.real()].dbref()
        !mdsancilboreobj.desparnumber[!j.real()] = !dpnumber[!j.real()]
        --!mdsancilboreobj.desparnumber[!dpnumber[!j].real()] = !dpnumber[!j.real()]
        --if !dpdescription[!j.real()].eq('unset') then
          --$p no value in local dtitle
          if !indice.unset() then
          --if !this.descarray.unset() OR !this.descarray[!indice].unset() then
            --$p no value in descarray (comp dtitle) - leaving unset
            !mdsancilboreobj.despardescription[!j.real()] = 'Unset'
            --P-30561 <RM> added this line to add an array element in case we have an unset !indice
            !mdsancilboreobj.despartype[!j.real()] = 'Unset'
            --!this.descarray[!dpnumber[!j].real()] = 'unset'
            --!this.descarray[!indice] = 'unset'
          else
            --$p value in descarray (comp dtitle) - using this
            !mdsancilboreobj.despardescription[!j.real()] = !this.descarray[!indice]
            !mdsancilboreobj.despartype[!j.real()] = !this.ptypearray[!indice]
          endif
        --else
          --$p setting value to that in local dtitle
          --*****NOT SETTING TO LOCAL DTITLE VALUE CURRENTLY****
          --SECOND LINE BELOW USED TO ALWAYS SET TO COMP VALUE IF THERE
          --FIRST LINE TO SET TO LOCAL
          --!mdsancilboreobj.despardescription[!dpnumber[!j].real()] = !dpdescription[!j]
        --  !mdsancilboreobj.despardescription[!dpnumber[!j].real()] = !this.descarray[!j]
        --endif

      enddo

      !userdtseref = !userdtsecoll[!tempcounter].dbref()
      handle ANY
      elsehandle NONE
        var !userdespmincoll coll all data with dkey eq 'UMIN' for $!userdtseref
        var !userdespmaxcoll coll all data with dkey eq 'UMAX' for $!userdtseref

        var !userdespmin eval pproperty for all from !userdespmincoll
        var !userdespmax eval pproperty for all from !userdespmaxcoll
        var !userdespnum eval number for all from !userdespmincoll

        !userdespmindbrefarray = ARRAY()
        !userdespmaxdbrefarray = ARRAY()

        do !n index !userdespmin
          !userdespmin[!n] = !userdespmin[!n].after(|( '|).before(|' )|)
          !userdespmax[!n] = !userdespmax[!n].after(|( '|).before(|' )|)
          !userdespmindbrefarray[!n] = !userdespmincoll[!n].dbref()
          !userdespmaxdbrefarray[!n] = !userdespmaxcoll[!n].dbref()
        enddo

        !mdsancilboreobj.userdespmin = !userdespmin
        !mdsancilboreobj.userdespmax = !userdespmax
        !mdsancilboreobj.userdespnum = !userdespnum
        !mdsancilboreobj.userdespmindbref = !userdespmindbrefarray
        !mdsancilboreobj.userdespmaxdbref = !userdespmaxdbrefarray

      endhandle

    endif

    !tempcounter = !tempcounter + 1

    !this.bore[!i.real()]=!mdsancilboreobj

  enddo

endmethod
-------------------------------------------------------------------------------
