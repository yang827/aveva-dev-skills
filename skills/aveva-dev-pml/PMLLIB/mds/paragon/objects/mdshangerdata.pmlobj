----------------------------------------------------------------------
-- Object to get and hold hanger data
----------------------------------------------------------------------
--
-- M Board 30/01/06


define object MDSHANGERDATA

  --members created for all ancils on form definition

  --member .name is STRING
  member .dbref is DBREF

  --member to store component dataset reference

  --member .compdetref is DBREF

  --tags/values for text gadgets across top of form

  member .mainnameval is STRING
  member .mainnamedbref is DBREF
  --member .mainnametag is STRING
  member .rnameval is STRING
  member .rnamedbref is DBREF

  member .description is STRING
  member .descriptiondbref is DBREF

  member .suppfuncval is STRING
  member .suppfuncdbref is DBREF

  --tags/values for text gadgets on standard (first) tab

  member .active is BOOLEAN

  member .hangerconfig is ARRAY
  member .hangerconfigdbref is DBREF

  --modified flag
  member .modified is BOOLEAN

endobject


---------------------------------------------------------------------------

define method .initdata()

  !this.modified = FALSE

  --get description (code) e.g. AT01 and replacement name (client code) e.g. XAT01

  !sectref = !this.dbref

  var !datacoll coll all data for $!sectref
  var !dkeycoll eval dkey for all from !datacoll

  do !i index !datacoll
    if !dkeycoll[!i].eq('CODE') then
      !this.mainnameval = !datacoll[!i].dbref().pproperty.after(|( '|).before(|' )|)
      !this.mainnamedbref = !datacoll[!i].dbref()
      break
    endif
  enddo

  do !i index !datacoll
    if !dkeycoll[!i].eq('CCOD') then
      !this.rnameval = !datacoll[!i].dbref().pproperty.after(|( '|).before(|' )|)
      !this.rnamedbref = !datacoll[!i].dbref()
      break
    endif
  enddo

  do !i index !datacoll
    if !dkeycoll[!i].eq('DESC') then
      !this.description = !datacoll[!i].dbref().pproperty.after(|( '|).before(|' )|)
      !this.descriptiondbref = !datacoll[!i].dbref()
      break
    endif
  enddo

  do !i index !datacoll
    if !dkeycoll[!i].eq('SUPF') then
      !this.suppfuncval = !datacoll[!i].dbref().pproperty.after(|( '|).before(|' )|)
      !this.suppfuncdbref = !datacoll[!i].dbref()
      break
    endif
  enddo

  --set active value for standard
  !this.active = !sectref.:mdsactive

  do !i index !datacoll
    if !dkeycoll[!i].eq('HCFG') then
      !temparray = !datacoll[!i].dbref().pproperty.after(|( '|).before(|' )|).split(',')
      do !j index !temparray
        !temparray[!j] = !temparray[!j].trim()
      enddo
      !this.hangerconfig = !temparray
      !this.hangerconfigdbref = !datacoll[!i].dbref()
      break
    endif
  enddo

  --!this.initdespars()

endmethod

------------------------------------------------------------------------
