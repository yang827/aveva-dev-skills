----------------------------------------------------------------------
-- Object to get and hold hanger data

--This object to hold;
--Alias
--Bottom-Assoc-Std
--Rod-Size
--NOT STANDARD SPECIFIC (so one object only needed for all hangers)
----------------------------------------------------------------------
--
-- M Board 30/01/06

define object MDSHANGERDEFSDATA

  --members created for all ancils on form definition

  member .aliasarray1 is ARRAY
  member .aliasarray2 is ARRAY

  member .dbref is DBREF

  member .assocarray is ARRAY

  member .bottassocarray is ARRAY

  member .rodsizedescarray is ARRAY

  member .rodsizearray is ARRAY


endobject

---------------------------------------------------------------------------

define method .initdata()

  --modified flag?
  --ALIAS

  !cate = !this.dbref

  var !alias coll all data with dkey eq 'HALS' for $!cate
  var !aliasarray1 eval pprop for all from !alias
  var !aliasarray2 eval dprop for all from !alias

  do !i index !alias
    !aliasarray1[!i] = !aliasarray1[!i].after(|( '|).before(|' )|)
    !aliasarray2[!i] = !aliasarray2[!i].after(|( '|).before(|' )|)

  enddo

  !this.aliasarray1 = !aliasarray1
  !this.aliasarray2 = !aliasarray2

  var !assoc coll all dtse with function eq 'ASSOC-STD' for $!cate
  var !assocarray eval description for all from !assoc

  !this.assocarray = !assocarray

  --var !bottassoc coll all data with dkey eq 'ASTD' for $!cate
  --var !bottassocarray eval pprop for all from !bottassoc

  --BOTT ASSOC SUPP STANDARDS

  !bottassocfinal = ARRAY()

  do !i index !assoc

    !temp = !assoc[!i]

    var !bottassoc coll all data with dkey eq 'ASTD' for $!temp
    var !bottassocarray eval pprop for all from !bottassoc

    !bottassocline = !bottassocarray[1]

    !bottassocsplit = !bottassocline.after(|( '|).before(|' )|).split(',')

    do !k index !bottassocsplit
      !bottassocfinal[!i][!k] = !bottassocsplit[!k].trim()
    enddo

    --!aliasarray1[!i] = !aliasarray1[!i].after(|( '|).before(|' )|)
    --!aliasarray2[!i] = !aliasarray2[!i].after(|( '|).before(|' )|)

  enddo

  !this.bottassocarray = !bottassocfinal

  --ROD SIZES

  var !rodsize coll all data with dkey eq 'RSIZ' for $!cate
  var !rodsizedescarray eval dtitle for all from !rodsize
  var !rodsizearray eval pprop for all from !rodsize


  !this.rodsizedescarray = !rodsizedescarray

  do !i index !rodsize

    !rodsizeline = !rodsizearray[!i]

    !rodsizesplit = !rodsizeline.after(|( '|).before(|' )|).split(',')


    do !k index !rodsizesplit
      !rodsizefinal[!i][!k] = !rodsizesplit[!k].trim()
    enddo

  enddo

  !this.rodsizearray = !rodsizefinal
endmethod

------------------------------------------------------------------------
