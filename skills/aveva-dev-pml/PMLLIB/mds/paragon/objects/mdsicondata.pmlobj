----------------------------------------------------------------------
-- Object to get and hold icon data
----------------------------------------------------------------------
--
-- M Board 6/2/06


define object MDSICONDATA

  member .mdsiconname is ARRAY
  member .mdsiconval is ARRAY
  member .icondbref is ARRAY

endobject

---------------------------------------------------------------------------

define method .initicondata()
  !ce = !!ce
  --!this.modified = FALSE
  /MDS/ICON/DEFAULTS

  --store description and value for each option in member arrays

  var !iconnamecol coll all data with dkey eq 'INAM' for CE
  var !iconvalcol coll all data with dkey eq 'IVAL' for CE

  var !iconname eval pproperty for all from !iconnamecol
  var !iconval eval pproperty for all from !iconvalcol

  do !i index !iconnamecol
    !this.mdsiconname[!i] = !iconname[!i].after(|( '|).before(|' )|)

    !this.mdsiconval[!i] = !iconval[!i].after(|( '|).before(|' )|).boolean()

    !this.icondbref[!i] = !iconvalcol[!i].dbref()
  enddo
  !!ce = !ce
endmethod

-----------------------------------------------------------------------------
