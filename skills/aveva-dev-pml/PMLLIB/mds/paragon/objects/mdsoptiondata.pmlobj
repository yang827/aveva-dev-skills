---------------------------------------------------------------------------

define method .initoptiondata()
  !ce = !!ce
  --!this.modified = FALSE
  /MDS/OPTION/DEFAULTS

  --store description and value for each option in member arrays

  var !optionCol coll all data with dkey eq 'OPTN' for CE

  --<RM> check the !optionCol array to make sure there are no elements that appear in the db but not on the form
  --if this is the case skip the form processing for the db element - start
  do !i index !optionCol
    var !dTitleArray eval dtitle for $!optionCol[$!i]
    var !descArray eval description for $!optionCol[$!i]

    !name = !dTitleArray[1].lowcase()

    !temp1 = '!this.' & !name & '[1]'
    $!temp1 = !descArray[1]
    handle ANY
      !optionCol.deleteFrom(!i, 1)
    endhandle
  enddo
  !optionCol.compress()
  --<RM> check the !optionCol array to make sure there are no elements that appear in the db but not on the form
  --if this is the case skip the form processing for the db element - end

  var !dTitleArray eval dtitle for all from !optionCol
  var !descArray eval description for all from !optionCol
  var !pPropArray eval pproperty for all from !optionCol

  !arrayOfMemberNames = ARRAY()

  do !i index !optionCol
    !name = !dTitleArray[!i].lowcase()
    !arrayOfMemberNames[!i] = !name

    !temp1 = '!this.' & !name & '[1]'
    !temp2 = '!this.' & !name & '[2]'
    !temp3 = '!this.' & !name & '[3]'

    $!temp1 = !descArray[!i]
    !val = !pPropArray[!i].after(|( '|).before(|' )|).trim()

    if !val.upcase().eq('TRUE') OR !val.upcase().eq('FALSE') then
      $!temp2 = !val.boolean()
    else
      $!temp2 = !val
    endif
    $!temp3 = !optionCol[!i].dbref()

  enddo
  !this.arrayOfMemberNames = !arrayOfMemberNames

  !!ce = !ce

endmethod

