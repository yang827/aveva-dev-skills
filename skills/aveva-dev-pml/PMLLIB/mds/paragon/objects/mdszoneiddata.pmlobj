----------------------------------------------------------------------
-- Object to get and hold zoneid data
----------------------------------------------------------------------
--
-- M Board 7/2/06

define object MDSZONEIDDATA

  --member .mdszoneid is ARRAY
  member .mdszoneidatt is ARRAY
  member .mdszoneidval is ARRAY
  member .mdszoneidattdbref is ARRAY
  member .mdszoneidvaldbref is ARRAY

endobject

---------------------------------------------------------------------------

define method .initzoneiddata()
  !ce = !!ce

  --!this.modified = FALSE
  /MDS/ZONEID/DEFAULTS

  var !dtsecol coll all dtse with function eq 'ZONEID' for CE
  --var !description eval description for all from !dtsecol

  var !zoneidattcol coll all data with dkey eq 'ZATT' for CE
  var !zoneidatt eval pproperty for all from !zoneidattcol

  var !zoneidvalcol coll all data with dkey eq 'ZVAL' for CE
  var !zoneidval eval pproperty for all from !zoneidvalcol

  do !i index !dtsecol

    --!this.mdszoneid[!i] = !description[!i]

    !this.mdszoneidatt[!i] = !zoneidatt[!i].after(|( '|).before(|' )|).trim()

    !this.mdszoneidval[!i] = !zoneidval[!i].after(|( '|).before(|' )|).trim()

    !this.mdszoneidattdbref[!i] = !zoneidattcol[!i].dbref()

    !this.mdszoneidvaldbref[!i] = !zoneidvalcol[!i].dbref()

  enddo

  !!ce = !ce
endmethod

-----------------------------------------------------------------------------
