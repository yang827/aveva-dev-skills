-- File:            changepass.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        monitor
--   Replaces:      FCHUPW
--
-- Author:          E.conba
-- Created:         Tue Jan 21 12:18:00 GMT 1997
--
--
-- Description:
-- Form to allow user to change their own PDMS password.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  changePass()                     -                   constructor
--  init()                           -                   constructor
--  okcall()                         -                   action
--


setup form !!changePass

  -- Members
  member .authentication is BOOLEAN

  -- Body of form definition
  path down

  text .oldPasswd      |Current Password     | width 15 noecho string
  text .newPasswd      |New Password         | width 15 noecho string
  text .confirmPasswd  |Confirm New Password | width 15 noecho string

  button .ok at xmin ymax+0.5 |  OK  | APPLY

  button .cancel at xmax form-size ymin |Cancel| CANCEL

exit

------------------------------------------------------------------------
--
-- Method:      .changePass()
--
-- Description: constructor
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .changePass()

  !this.formTitle     = |Change Password|
  !this.iconTitle     = |CH PW|
  !this.callback      = |!this.init()|
  !this.formRevision  = | $Revision: 1.4 $ |

  -- callbacks
  !this.ok.callback            = |!this.okcall()|
  !this.cancel.callback        = |!!alert.warning('User password not changed')|
endmethod

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: constructor
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .init()

!this.oldPasswd.val     = ||
!this.newPasswd.val     = ||
!this.confirmPasswd.val = ||

endmethod

------------------------------------------------------------------------
--
-- Method:      .okcall()
--
-- Description: action
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .okcall()

-- Ensure something is entered for old password
if (!this.oldPasswd.val eq ||) then
  !!alert.error('No current password entered. User password not changed')
  !this.hide()
  return
endif

-- Confirm current password, method on current SESSION object
!sess = CURRENT SESSION
!confirmed = !sess.confirmID( |/| + !this.oldPasswd.val)
handle any
  !confirmed = false
endhandle
if (!confirmed.not()) then
  !!alert.error('The current password you entered is incorrect. User password not changed')
  !this.hide()
  return
endif

if (!this.newPasswd.val eq ||) then
  !!alert.error('No password entered. User password not changed')
  !this.hide()
  !this.oldPasswd.val = ||
  return
endif

if (!this.newPasswd.val neq !this.confirmPasswd.val) then

  !!alert.warning('The Passwords you typed do not match. Type the new password in both text boxes')

else

  -- Ensure the users name has been set, this may not have happened if
  -- this is being run from the pdms login screen and the user has been authenticated
  if (defined(!!pdmslogin) and !!pdmslogin.shown() and !!pdmslogin.authentication) then
    USER $!!pdmslogin.userName.val
  endif

  PASSWORD /$!this.newPasswd.val
  handle (1,59) $* Current limitation of 6 characters password truncated
    !!alert.warning(!!error.text)
  endhandle
  hide !!changePass
endif

  -- Clear out password text values
  !this.oldPasswd.val     = ||
  !this.newPasswd.val     = ||
  !this.confirmPasswd.val = ||
endmethod


-- End of form definition for !!changePass
