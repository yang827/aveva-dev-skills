--
--
-- Description:
-- Form to modify the current MDB's database list status
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getStamps()                      -                   Populate the stamp list gadget(s)
--

-- Initialise variables
!dText = ARRAY()

-- Define form
setup form !!modSessMdb document

  !!modSessMdb.formTitle     = |MDB Session Modification|
  !!modSessMdb.iconTitle     = |MDB MOD|
  !!modSessMdb.callback      = |call !!modSessMdbInit('INIT')|
  !!modSessMdb.formRevision  = | $Revision: 1.11 $ |

  -- Member Definitions
  member .currentSel is REAL

  -- Stamp references
  member .stampRefs is ARRAY

  -- Body of form definition
  option .type at x 0 y 0.5 call |call !!modSessMdbInit('INIT')| width 7

  para   .mdbDesc at xmax+1 y 0.5 width 40 lines 1
  list   .current at x 0 ymax+0.5 |Current DBs| call |!this.getStamps()| anchor all columns width 40 length 10
  button .dSel  at xmax+1 ymin+0.7 tooltip 'Defer selected database'                anchor right pixmap width 16 height 16 call |call !!modSessMdb('DSEL')|
  button .dAll  at xmin ymax+0.1   tooltip 'Defer all databases'                    anchor right pixmap width 16 height 16 call |call !!modSessMdb('DALL')|
  button .cSel  at xmin ymax+0.1   tooltip 'Make selected database current'         anchor right pixmap width 16 height 16 call |call !!modSessMdb('CSEL')|
  button .cAll  at xmin ymax+0.1   tooltip 'Make all databases current'             anchor right pixmap width 16 height 16 call |call !!modSessMdb('CALL')|
  button .swap  at xmin ymax+0.1   tooltip 'Swap selected databases'                anchor right pixmap width 16 height 16 call |call !!modSessMdb('SWAP')|
  button .prot  at xmin ymax+0.1   tooltip 'Set write access for selected database' anchor right pixmap width 16 height 16 call |call !!modSessMdb('PROT')|
  button .reset at xmin ymax+0.1   tooltip 'Reset MDB to system status'             anchor right pixmap width 16 height 16 call |call !!modSessMdb('RESET')|
  list   .deferred at xmax+1 ymin.current |Deferred DBs| anchor top+bottom+right columns width 40 length 10

  list     .stampList 'Stamps' at xmin.current ymax.current+0.25 anchor left+right+bottom SINGLE width 40 length 3

  option .insert at xmin.reset ymax.deferred+0.5 |Insert | anchor right+bottom width 6

  option .sort at xmax form-size ymin |Sort by | anchor right+bottom $
         call |call !!modSessMdbInit('SORT')| width 12

  button .dismiss at xmax form-size ymax+1 |Dismiss| anchor bottom+right $
         call |!!monitor.mdb.setFocus() | CANCEL
  button .format at xmax form-size y 0.5 |Format...| anchor top+right  call |show !!monMdbFmt|

exit
-- End of form definition for !!modSessMdb

-- set icons
!!modSessMdb.dSel.addPixmap(!!pml.getPathName('rightarrow16.png'))
!!modSessMdb.dAll.addPixmap(!!pml.getPathName('rightrightarrow16.png'))
!!modSessMdb.cSel.addPixmap(!!pml.getPathName('leftarrow16.png'))
!!modSessMdb.cAll.addPixmap(!!pml.getPathName('leftleftarrow16.png'))
!!modSessMdb.swap.addPixmap(!!pml.getPathName('leftrightarrow16.png'))
!!modSessMdb.prot.addPixmap(!!pml.getPathName('protectdb16.png'))
!!modSessMdb.reset.addPixmap(!!pml.getPathName('resetmdb16.png'))

-- Assign option gadget values
!dText.append(|Session|)
!dText.append(|System|)
!!modSessMdb.type.dText = !dText
!dText.clear()

!dText.append(|Before|)
!dText.append(|After|)
!!modSessMdb.insert.dText = !dText
!dText.clear()

!dText.append(|Team|)
!dText.append(|Name|)
!dText.append(|Type|)
!dText.append(|Description|)
!!modSessMdb.sort.dText = !dText
!dText.clear()

------------------------------------------------------------------------
--
-- Method:      .getStamps()
--
-- Description: Populate the stamp list gadget(s)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
-- Define method
define method .getStamps()

  -- For advanced shown
  if (defined(!!monitor.openStamp)) then

    -- For opening the mdb at a stamp
    if (!!monitor.openStamp.val) then

      -- Get current db
      !curDb = object DB(!this.current.selection('DTEXT').split()[2])

      -- Get all stamps for this db
      !this.stampRefs = !curDb.refNo.dbref().stpDbs

      -- Sort and populate the gadget
      if (!this.stampRefs.empty()) then

        -- Populate the list gadget
        !dText[1] = 'None Found'
        !this.stampList.dText = !dText

        -- Set stamp gadget inactive
        !this.stampList.active  = false

      else

        -- Populate the list gadget
        !!admStampSort(!this.stampRefs,!!monitor.sort,!this.stampList)

        -- Set stamp gadget active
        !this.stampList.active  = true

      endif

    else
      !this.stampList.active  = false
      !this.stampList.clear()
    endif

  else
    !this.stampList.active  = false
    !this.stampList.clear()
  endif

endmethod
-- End of method definition for .getStamps()
