--
-- File:            monchangeuser.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        monitor
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Fri Feb 27 12:18:00 GMT 1997
--
--
-- Description:
-- Form to allow user to log in as another user.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   action for applying user change
--  init()                           -                   form initialisation
--  monChangeUser()                  -                   constructor
--  setPassword()                    -                   method to check that the username and password supplied
--  setUserName()                    -
--
------------------------------------------------------------------------
setup form !!monChangeUser


  -- Member definitions
  member .authentication is BOOLEAN

  -- Body of form definition
  frame .frame1 '' at xmin ymax
    text   .userName at xmin+1 ymax+0.2 'Username '  width 15 string
    button .uSel at xmax ymin pixmap width 9 height 12

    text   .passwd at xmin.userName ymax.userName 'Password ' width 15 noecho string
  exit

  button .ok     |OK|     at xmax form-10-size ymax+.25 width 8
  button .cancel |Cancel| at xmax+1 ymin width 8 |Cancel| cancel

exit
-- End of form definition for !!monChangeUser

------------------------------------------------------------------------
--
-- Method:      !monChangeUser()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .monChangeUser()

  !this.formTitle     = |Change User|
  !this.iconTitle     = |Change User|
  !this.callback      = |!this.init()|
  !this.formRevision  = | $Revision: 1.14 $ |

  -- set icons
  !this.uSel.addPixmap(!!pml.getPathName('comboboxarrow9x12.png'))

  -- callbacks
  !this.uSel.callback = |show !!selectuser|
  !this.ok.callback   = |!this.apply()|


endmethod
-- End of method definition for .monChangeUser()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .init()

  -- clear the input gadgets
  !this.userName.val = ''
  !this.passwd.val = ''
  !this.passwd.active=true

  -- set the initial gadget focus
  !this.userName.setFocus()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !setPassword()
--
-- Description: method to check that the username and password supplied
--              are valid for entry to the current project.
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .setPassword()

  !sessionData = CURRENT SESSION
  !!sessionSettings.mdb = !sessionData.mdb().name

  -- Get the variable from the form
  !userName = !this.userName.val
  !password = !this.passwd.val

    -- Check that the username is set
  if (!userName.empty()) then

    !this.passwd.val = ''
    !!messageFile.error(150, 22)

  endif

  -- Try and set username and password
  if (!this.authentication) then

    !userPass ='|' & !userName & '|'

  else

    !userPass ='|' & !userName & '|' & '/' & !password

  endif

  USERNAME $!userPass
  handle (43,258) (47,15)

    -- Bad username or password
    !this.passwd.val = ''
    !this.passwd.setFocus()
    !!messageFile.error(150, 21)

  elsehandle (98,205)

    -- Project is locked
    !!messageFile.error(150, 43, !!sessionSettings.project)

  elsehandle (98,204)

    -- Project max users setting has been reached.
    !!messageFile.error(150, 44, !!sessionSettings.project)

  elsehandle any

    !!alert.error(!!error.text.after(|)|))

  elsehandle none

    !!sessionSettings.user  = !this.userName.val
    !!monitor.user.val = !!sessionSettings.user
    !sessionData       = CURRENT SESSION
    !!monitor.priv.val = !sessionData.user().access

    -- set the mdb
    if !!sessionSettings.mdb.neq('Unset') then
      $!!<sessionSettings.mdb>
    endif

    -- rebuild the module menus
    !!moduleMenus(!!monitorMain)

    hide !!monChangeUser

  endhandle

endmethod


-- End of method definition for .setPassword()

------------------------------------------------------------------------
--
-- Method:      !setUserName()
--
-- Description: action for setting userName and checking for Authentication
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .setUserName()

  !authUserName=ARRAY()
  !userNameList=ARRAY()
  !this.authentication = false

  !authentication=authentication
  if (!authentication) then
    -- Is this user authenticated
    !authUser=object authuser()
    !userNames=!authUser.userList()
    handle (2,109)
      -- Not an authenticated user
      !this.passwd.setFocus()
      !this.authentication=false
    elsehandle none
       -- Does the username in the form match any of the authenticated users
       do !i index !userNames
         !userNameList[!i] = !userNames[!i].name
       enddo
       -- This is an authenticated user but is the username FREE if so we still need a password
       -- If not then no password is required
       !userNo=!userNameList.findFirst(!this.userName.val)
       if(!userNo.set()) then
          --is this a free user
          if (!userNames[!userNo].access.upcase() eq 'FREE') then
           -- password required
           !this.passwd.active=true
           !this.passwd.setFocus()
           !this.authentication=false
          else
           !this.passwd.val=''
           !this.passwd.active=false
           !this.authentication=true
          endif
       else
          -- set the user name to the default user
          !this.userName.val=!authUser.defaultUser().name
          handle any
            -- password required
            !this.passwd.active=true
            !this.passwd.setFocus()
            !this.authentication=false
          elsehandle none
            --is this a free user
            !user=object user(!this.userName.val)
            if (!user.access.upcase() eq 'FREE') then
              -- password required
              !this.passwd.active=true
              !this.passwd.setFocus()
              !this.authentication=false
            else
              !this.passwd.val=''
              !this.passwd.active=false
              !this.authentication=true
            endif
          endhandle
       endif
    endhandle

  else

    !this.passwd.setFocus()
    !this.authentication=false

  endif

  if (!this.authentication) then
    !this.setPassword()
  endif

endmethod

-- End of method definition for .setUserName()

------------------------------------------------------------------------
--
-- Method:      apply()
--
-- Description: action for applying user change
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .apply()

  !this.setUserName()
  !this.setPassword()

  -- Prompt user after switch for inter db macros if available
  call !!listIdbMacro()

endmethod
