-- Created:         Mon Jan 20 16:20:20 GMT 1997
--
--
-- Description:
-- Form definition for Listing the users Inter-DB macros
--
------------------------------------------------------------------------

-- Define form
setup form !!monIdbMac document

  !!monIdbMac.formTitle     = |Inter-DB Macros|
  !!monIdbMac.iconTitle     = |IDB MACROS|
  !!monIdbMac.callback      = |call !!listIdbMacro()|
  !!monIdbMac.formRevision  = | $Revision: 1.4 $ |

  -- Body of form definition

  path down
  list .macros | # Connecting to DB           From DB                    File name| anchor all width 80 length 5

  button .delete  |Delete Macro| anchor B+L call |call !!delIdbMacro(!!monIdbMac.macros)|
  button .dismiss at xmax form-size ymin |Dismiss| anchor B+R CANCEL


exit
-- End of form definition for !!monIdbMac
