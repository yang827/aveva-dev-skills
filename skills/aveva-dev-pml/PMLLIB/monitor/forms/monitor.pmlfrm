--
-- File:            monitor.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        monitor
--   Replaces:      MON/MONIT/FMAIN
--
-- Author:          E Conba
-- Created:         Mon Jan 20 11:37:38 GMT 1997
--
--
-- Description:
-- Main form for Monitor appware.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getStamps()                      -                   Populate the stamp list gadget(s)
--  init()                           -                   Form initialisation
--  monitor()                        -                   Constructor
--  open()                           -                   Open stamp gadgets
--  setMdb()                         -                   Set the mdb
--  showAdv()                        -                   Expand the form to show the advanced settings
--  sortStamps()                     -                   Sort the stamp lists
--  stampActive()                    -                   Set stamp gadgets active status
--

-- Initialise Variables
!project         = CURRENT PROJECT
!projectDesc     = !project.description()
!projectMess     = !project.message()

-- Define form
--setup form !!monitor dialog dock left noAlign
layout form !!monitor dialog dock left

  !!monitor.formTitle     = |Monitor|
  !!monitor.iconTitle     = |Monitor|
  !!monitor.initCall      = |!this.init()|
  !!monitor.formRevision  = | $Revision: 1.23 $ |

  -- Form member definition
  member .dispMode is STRING

  -- Stamps
  member .stampRefs is ARRAY

  -- Information about the current project
  path down
  frame .projGrp |Current Project| anchor T+L+R
    !tagw = 15
    path right
    if (!project.Id().set()) then
      para .projIdTx  at x1  text |Project| wid $!tagw
      para .projIdTxColon    text|:|  wid 10
      para .projId   anchor T+L+R width 22 line 1
      !!monitor.projId.val = !project.Id()
    endif

    if (!project.name().set()) then
      para .projNameTx at x1 ymax text |Project Name| wid $!tagw
      para .projNameTxColon       text|:|  wid 10
      para .projName   width 22 line 1
      !!monitor.projName.val = !project.name()
    endif

    para .projCodTx  at x1 ymax   text |Project Code| wid $!tagw
    para .projCodTxColon          text|:|  wid 10
    para .projCod    width 4 line 1

    if (!project.number().set()) then
      para .projNumTx  at x1 ymax text |Project Number| wid $!tagw
      para .projNumTxColon        text|:|  wid 10
      para .projNum    width 20 line 1
      !!monitor.projNum.val  = !project.number()
    endif

    para .cauTx      at x1 ymax   text |Current Active Users: | wid $!tagw
    para .cauTxColon              text|:|  wid 10
    para .cau        width 22 line 1

    if (!project.description().set()) then
      para .projDesTx at x1 ymax text |Description -|
      -- *** OLD STYLE PML ***
      var !text COMPOSE SPACE 0 |$!projectDesc| WIDTH 42 LEFT
      do !i indices !text
        !gadget  = |ProjDes| + !i.string()
        !yOff    = (!i - 1) * 0.6
        -- *** OLD STYLE PML ***
        para .$!<gadget> at x 4 ymax_projDesTx+$!yOff text |$!text[$!i]|
      enddo
    endif

    if (!project.message().set()) then
      para .projMesTx at x1 ymax text |Message -|
      -- *** OLD STYLE PML ***
      var !text COMPOSE SPACE 0 |$!projectMess| WIDTH 42 LEFT
      do !i indices !text
        !gadget  = |ProjMes| + !i.string()
        !yOff    = (!i - 1) * 0.6
        -- *** OLD STYLE PML ***
        para .$!<gadget> at x 4 ymax_projMesTx+$!yOff text |$!text[$!i]|
      enddo
    endif

  exit

  -- Information about the current user
  frame .userGrp |Current User| anchor T+L+R wid.projGrp
    path right
    !tagw = 5
    para .userTx at x1          text |User| wid $!tagw
    para .userTxColon           text|:|  wid 3
    para .user   width 34 line 1

    para .privTx at x1 ymax     text |Privilege| wid $!tagw
    para .privTxColon           text|:|  wid 3
    para .priv   width 8 line 1

    button .userReselect 'Reselect User...' at xmin.privTx ymax+0.2 callback |show !!monChangeUser| wid 12

  exit

  -- Information about the current MDB selection
  frame  .mdbGrp |Multiple Database| anchor T+L+R wid.projGrp
    path right
    !tagw = 15
    text   .mdb  tagwid $!tagw |MDB| at x1 ymax call |!this.setMdb()| width 12 string
    button .mdbForm at xmax  pixmap width 9 height 12 call |show !!selectMdb|
    button .modMdb   |Modify...| at xmax+5  callback 'show !!modSessMdb' width 10

    para   .modeTx  at x1 ymax.mdb+0.2 text |Next Module|
    toggle .mode at xmin.mdb+$!tagw |Read Only|
    button .advanced |Advanced...|  at xmin.modMdb call |!this.showAdv()| wid.modMdb

    if (defined(!!expandStamp)) then
      if (!!expandStamp) then
        para   .oStamp at xmin.mdb ymax+0.4 text |Open at Stamp:|
        toggle .openStamp || at xmax+1 ymin
        para   .stamp at xmin.oStamp ymax+0.4 text 'Stamps                 Sort By '
        option .sort  at xmax ymin width 11
        list   .stampList at xmin.stamp ymax call |!this.setMdb()| SINGLE width 42 length 5
      endif
    endif

  exit

  para   .iDbWarn anchor B+L+R width to max.projGrp lines 1

exit
-- End of form definition for !!monitor

---------------------------------------------------------------------
--
-- Method:      monitor
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .monitor()

  -- Initialise Variables
  !project         = CURRENT PROJECT
  !projectDesc     = !project.description()
  !projectMess     = !project.message()
  !noOfActiveUsers = !project.active()
  !sessionData     = CURRENT SESSION
  VAR !stamp MDBSTAMP
  VAR !userName USER

  -- set icons
  !this.mdbForm.addPixmap(!!pml.getPathName('comboboxarrow9x12.png'))

  -- Give values to the form gadgets
  !this.projCod.val  = !project.code()
  !this.cau.val      = !noOfActiveUsers.string()
  !this.priv.val     = !sessionData.user().access
  !this.mode.val     = false
  !this.mdb.val      = !!sessionSettings.mdb.subString(2)
  handle any
    !this.mdb.val    = ''
  endhandle

  -- Load Global Instance if required
  if(undefined(!!admControl)) then
    call !!comDefineGlobal(object ADMCONTROL())
  endif

  -- Stamp
  if (defined(!!expandStamp)) then
    if (!!expandStamp) then

      -- Set gadgets
      !!admStampSortGadg(!this.sort,'LONG')
      !this.stampActive()
      !this.sort.callback = '!this.sortStamps()'
      !this.openStamp.callback = '!this.open()'
      if (!stamp.neq('** unset **')) then
        !this.openStamp.val = true
        !this.getStamps()
        !this.stampActive()
        !this.stampList.select('DTEXT',!stamp.subString(2))
        !this.setMdb()
      endif

    endif
  endif

  -- Test for a return to monitor with an MDB open at a STAMP
  if (defined(!!expandStamp)) then
  if (!!expandStamp) then
  endif
  endif

  -- For no mdb do not allow a modify
  if (!this.mdb.val.eq('')) then
    !this.modMdb.active = false
  endif

  -- Output user name
  !this.user.val = !userName

endmethod
-- End of method definition for .monitor()

------------------------------------------------------------------------
--
-- Method:      .getStamps()
--
-- Description: Populate the stamp list gadget(s)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
-- Define method
define method .getStamps()

  -- Initialise variables
  !this.stampRefs = ARRAY()

  -- Get all stamps for the selected mdb
  if (!this.mdb.val.neq('')) then

    -- Get all stamps for all dbs
    !mdbObj = object MDB('/' & !this.mdb.val)
    do !dbObj val !mdbObj.current()
      !this.stampRefs.appendArray(!dbObj.refNo.dbref().stpDbs)
    enddo
    !this.stampRefs.sortUnique()

    -- Sort and populate the gadget
    if (!this.stampRefs.empty()) then

      -- Populate the list gadget
      !dtext[1] = 'None Found'
      !this.stampList.dtext = !dtext

    else

      -- Populate the list gadget
      !!admStampSort(!this.stampRefs,!this.sort,!this.stampList)

    endif

  endif

  -- Set list active status
  !this.stampActive()

endmethod
-- End of method definition for .getStamps()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Form initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
-- Define method
define method .init()

  -- For no mdb
  if (!this.mdb.val.eq('') or !this.mdb.val.match(' ').neq(0)) then
    if (defined(!this.openStamp)) then
      !this.openStamp.active = false
    endif
    !this.mdb.setFocus()
  else
    if (defined(!this.openStamp)) then
      !this.openStamp.active = true
    endif
  endif

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .open()
--
-- Description: Open stamp gadgets
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
-- Define method
define method .open()

  -- Populate stamp list
  if (!this.openStamp.val) then
    !this.getStamps()
  endif

  -- Set list active status
  !this.stampActive()

  -- Set mdb
  !this.setMdb()

  -- Test for modify mdb form
  if (defined(!!modSessMdb)) then
    if (!!modSessMdb.shown()) then
      !!modSessMdb.getStamps()
    endif
  endif

endmethod
-- End of method definition for .open()

------------------------------------------------------------------------
--
-- Method:      .setMdb()
--
-- Description: Set the mdb
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
-- Define method
define method .setMdb()

  -- Test for no mdb
  if (!this.mdb.val.eq('')) then

    -- Set modify inactive
    !this.modMdb.active = false

    -- Set stamp gadgets
    if (defined(!this.openStamp)) then
      !this.openStamp.val = false
      !this.stampActive()
    endif

    -- No valid mdb
    !!monitor.mdb.setFocus()
    hide !!modSessMdb

    -- Error
    !!alert.warning('Invalid multiple database "".')
    return

  endif

  -- Set the mdb
  !!setMdb(!this.mdb)

  -- Set modify active
  !this.modMdb.active = true

  -- Refresh for stamp
  if (defined(!this.openStamp)) then
    !this.getStamps()
  endif

endmethod
-- End of method definition for .setMdb()

------------------------------------------------------------------------
--
-- Method:      .showAdv()
--
-- Description: Expand the form to show the advanced settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
-- Define method
define method .showAdv()

  -- Test for modify session mdb form
  if (defined(!!modSessMdb)) then
    !modMdb = !!modSessMdb.shown()
  else
    !modMdb = false
  endif

  -- Populate stamp list
  if (undefined(!this.openStamp)) then
    !!expandStamp = true
    pml reload form !!monitor
    !!monitor.show()
    !!monitor.stampActive()
  else
    !!expandStamp = false
    pml reload form !!monitor
    !!monitor.show()
    !!setMdb(!!monitor.mdb)
  endif

  -- Set mdb
  if (!!monitor.mdb.val.eq('')) then
    !!monitor.mdb.setFocus()
  endif

  -- Test for modify mdb form
  if (!modMdb) then
    !!modSessMdb.show()
    !!modSessMdb.getStamps()
  endif

endmethod
-- End of method definition for .showAdv()

------------------------------------------------------------------------
--
-- Method:      .sortStamps()
--
-- Description: Sort the stamp lists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
-- Define method
define method .sortStamps()

  -- Sort this form stamp list
  !!admStampSort(!this.stampRefs,!this.sort,!this.stampList)

  -- Sort the modify session mdb form
  if (defined(!!modSessMdb)) then
    if (!!modSessMdb.shown()) then
      !!admStampSort(!!modSessMdb.stampRefs,!this.sort,!!modSessMdb.stampList)
    endif
  endif

endmethod
-- End of method definition for .sortStamps()

------------------------------------------------------------------------
--
-- Method:      .stampActive()
--
-- Description: Set stamp gadgets active status
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------------
-- Define method
define method .stampActive()

  if (!this.openStamp.val) then

    -- Set stamp gadgets
    if (!this.stampList.selection().eq('None Found')) then
      !this.sort.active = false
      !this.stampList.active  = false
    else
      !this.sort.active = true
      !this.stampList.active  = true
    endif

  else
    !this.sort.active       = false
    !this.stampList.active  = false
    !this.stampList.clear()
  endif

  -- For the modify mdb session form
  if (defined(!!modSessMdb)) then
    if (!!modSessMdb.shown()) then
      !!modSessMdb.getStamps()
    endif
  endif

endmethod
-- End of method definition for .stampActive()
