-- Define form
setup form !!monitorMain at xr0 yr0 MAIN

  !!monitorMain.formTitle     = |Monitor - AVEVA PDMS|
  !!monitorMain.iconTitle     = |Monitor - AVEVA PDMS|
  !!monitorMain.callback      = ||
  !!monitorMain.formRevision  = | $Revision: 1.16 $ |
  !this.quitCall = |$M "%PMLLIB%/limbo/functions/moduleswitch.pmlfnc" $<EXIT$>|
  !pp = passwordlock

  -- Body of form definition
  bar
    add 'Monitor'  .monitor
    add |Display|  .display
    add |Project|  .project
    add window
    add help
  exit

  menu .monitor
    add 'Modules' menu .modules
    add separator
    add 'Exit' '$M "%PMLLIB%/limbo/functions/moduleswitch.pmlfnc" $<EXIT$>'
  exit

  menu .display
    add |Monitor...|       form !!monitor
    add |Command Window...|  form !!cadcBth
    add |Show Descriptions|       |call !!monitorElemText('DESC')|
    add |Show Names       |       |call !!monitorElemText('NAME')|
  exit

  menu .project
    add |Inter-db Macros...|   form !!monIdbMac
    add |User Status...|       form !!userStatus
    add |List|                 menu .list
    --if (!!monAdminDflts.chPass) then
    if (NOT $!pp) then
      add |Change Password...| form !!changePass
    endif
--    add separator
--    add |Reselect...|          |call !!reLogin()|
  exit


  menu .list
    add |Users...|           form !!userList
    add |Teams...|           form !!teamList
    add |DBs...|             form !!dbList
    add |MDBs...|            form !!mdbList
    add |User Rights...|     form !!qryUserAcr
  exit

exit
-- End of form definition for !!monitorMain

  -- For Marine/Schematic Header
  !mm = object AVEVAModuleManager()
  !product = !mm.CurrentProductName()
  !this.formTitle = 'Monitor - AVEVA $!product'

-- set the modules menu
!!moduleMenus(!!monitorMain)

!!monitorMain.cancelCall   = '$M "%PMLLIB%/limbo/functions/moduleswitch.pmlfnc" $<EXIT$>'
