--
-- File:            monmdbfmt.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        monitor
--   Replaces:      FMDBFMT
--
-- Author:          E.conba
-- Created:         Tue Jan 21 09:19:08 GMT 1997
--
--
-- Description:
-- Form of toggle gadgets that control the appearance of DB entry's in the
-- Modify Session MDB form.
--
------------------------------------------------------------------------
setup form !!monMdbFmt

  !!monMdbFmt.formTitle     = |MDB List Formatting|
  !!monMdbFmt.iconTitle     = |MDB FMT|
  !!monMdbFmt.callback      = |call !!monMdbFmtInit()|
  !!monMdbFmt.formRevision  = | $Revision: 1.5 $ |

  -- Body of form definition
  para   .headCur at x 0 y 0 text |Current DBs|
  toggle .cTeam   at x 0 ymax |Team|        call |!!monUserDflts.cTeam = _cTeam.val| states |false| |true|
  toggle .cType   at x 0 ymax |Type|        call |!!monUserDflts.cType = _cType.val| states |false| |true|
  toggle .cAccess at x 0 ymax |Mode|        call |!!monUserDflts.cAccess = _cAccess.val| states |false| |true|
  toggle .cAccTyp at x 0 ymax |Access|      call |!!monUserDflts.cAccType = _cAccTyp.val| states |false| |true|
  toggle .cAccMod at x 0 ymax |Claim Mode|  call |!!monUserDflts.cAccMode = _cAccMod.val| states |false| |true|
  toggle .cDesc   at x 0 ymax |Description| call |!!monUserDflts.cDesc = _cDesc.val| states |false| |true|
  toggle .cNumb   at x 0 ymax |Number|      call |!!monUserDflts.cNumber = _cNumb.val| states |false| |true|
  toggle .cFile   at x 0 ymax |File|        call |!!monUserDflts.cFile = _cFile.val| states |false| |true|

  para   .headDef at x 23 y 0 text |Deferred DBs|
  toggle .dTeam   at x 23 ymax |Team|           call |!!monUserDflts.dTeam = _dTeam.val| states |false| |true|
  toggle .dType   at x 23 ymax |Type|           call |!!monUserDflts.dType = _dType.val| states |false| |true|
  toggle .dAccTyp at x 23 ymin.cAccTyp |Access| call |!!monUserDflts.dAccType = _dAccTyp.val| states |false| |true|
  toggle .dAccMod at x 23 ymax |Claim Mode|     call |!!monUserDflts.dAccMode = _dAccMod.val| states |false| |true|
  toggle .dDesc   at x 23 ymax |Description|    call |!!monUserDflts.dDesc = _dDesc.val| states |false| |true|
  toggle .dNumb   at x 23 ymax |Number|         call |!!monUserDflts.dNumber = _dNumb.val| states |false| |true|
  toggle .dFile   at x 23 ymax |File|           call |!!monUserDflts.dFile = _dFile.val| states |false| |true|

  button .apply at x 0 ymax form+0.5 |Apply| call |call !!modSessMdbInit('INIT')| APPLY
  button .dismiss at xmax form-size ymin |Dismiss| CANCEL

exit
-- End of form definition for !!monMdbFmt
