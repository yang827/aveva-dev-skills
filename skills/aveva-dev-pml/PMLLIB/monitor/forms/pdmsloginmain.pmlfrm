--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  pdmsLoginMain()                  -
--

setup form !!pdmsLoginMain MAIN

  !!pdmsLoginMain.formTitle     = 'Project Login'
  !!pdmsLoginMain.iconTitle     = 'Project Login'
  !!pdmsLoginMain.callback      = ''
  !!pdmsLoginMain.formRevision  = ' $Revision: 1.6 $ '

  -- Body of form definition

  bar
  exit

exit
-- End of form definition for !!pdmsLoginMain

------------------------------------------------------------------------
--
-- Method:      !pdmsLogin()
--
-- Description: constructor
--
-- Method Type: Procedure
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
define method .pdmsLoginMain()

  !this.bar.add('Control', 'control')
  !menuObj = !this.newMenu('control')
  !menuObj.add('callback', 'Exit', 'FINISH')

  !this.cancelCall = 'FINISH'

endmethod
-- End of method definition for .pdmsLoginMain()
