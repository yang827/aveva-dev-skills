-- File:            selectmdb.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        monitor
--   Replaces:
--
-- Author:          E.conba
-- Created:         Mon Jan 20 14:08:32 GMT 1997
--
--
-- Description:
-- Form definition to allow user selection of working MDB
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  doSelection()                    -                   constructor
--  init(BOOLEAN)                    -                   constructor
--  selectMdb()                      -                   constructor
--
setup form !!selectMdb resize

-- members
  member .textGadget is GADGET

  -- Body of form definition
  option .sort at x5 y 0.5 |Sort by |  width 12
  text .filter at x5 ymax+0.1 |Filter  | width 12 string
  list .mdbs at x 0 ymax+0.5 |MDBs|  anchor all zerosel width 40 length 10

exit
-- End of form definition for !!selectMdb

------------------------------------------------------------------------
--
-- Method:      .selectMdb()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .selectMdb()

  -- Set the default filter value
  !this.filter.val = |*|
  !this.formTitle     = |Select MDB|
  !this.iconTitle     = |SEL MDB|
  !this.callback      = |!this.init(true)|
  !this.formRevision  = | $Revision: 1.6 $ |

  -- callbacks
  !this.sort.callback   = |!this.init(false)|
  !this.filter.callback = |!this.init(false)|
  !this.mdbs.callback   = |!this.doSelection()|

endmethod
-- End of method definition for .selectMdb()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .init(!firstInit is BOOLEAN)

if (!firstInit) then
  !heading=ARRAY()
  !heading.append('Name')
  !heading.append('Description')
  !this.mdbs.setHeadings(!heading)
  !this.sort.dText=!heading
endif

if (!this.filter.val.empty()) then
  !this.filter.val = |*|
endif

-- Get the list of MDBs
!nameList = MDBS


  do !i indices !nameList

    -- Get the name & Description
    !mdbName[!i] = !nameList[!i].name.after('/')
    !mdbDesc[!i] = !nameList[!i].description
    if (!mdbDesc[!i] eq '') then
      !mdbDesc[!i] = |-- No description --|
    endif

  enddo


  if (!nameList.size() eq 0) then
    return
  endif
  -- Sort the list of valid projects
  if (!this.sort.selection('DTEXT') eq |Name|) then
    !sort = !mdbName.sortedIndices()
  elseif (!this.sort.selection('DTEXT') eq |Description|) then
    !sort = !mdbDesc.sortedIndices()
  endif


  -- Build display and replacement texts
  !dispList = ARRAY()
  !replList = ARRAY()

  do !i values !sort

    -- Build the strings to filter
    if (!this.sort.selection('DTEXT') eq |Name|) then
      !filterString = !mdbName[!i]
    elseif (!this.sort.selection('DTEXT') eq |Description|) then
      !filterString = !mdbDesc[!i]
    endif

    -- Discard mdbs not matching filter
    skip if (not !filterString.matchWild(!this.filter.val))

    -- Compose text


    if (!this.sort.selection() eq |Name|) then
      !heading=ARRAY()
      !heading.append('Name')
      !heading.append('Description')
      !this.mdbs.setHeadings(!heading)
      !text=!mdbName[!i] & |	| & !mdbDesc[!i]

    elseif (!this.sort.selection() eq |Description|) then
      !heading=ARRAY()
      !heading.append('Description')
      !heading.append('Name')
      !this.mdbs.setHeadings(!heading)

      !text=!mdbDesc[!i] & |	| & !mdbName[!i]

    endif

    !dispList.append(!text)
    !replList.append(!mdbName[!i])


  enddo

  -- Assign values if defined
  if (!dispList.set()) then
    !this.mdbs.dText = !dispList
    !this.mdbs.rText = !replList
  endif
-- Try to highlight the option


if (defined(!!monitor) and !!monitor.shown()) then
  !this.mdbs.select('RTEXT',!!monitor.mdb.val)
  handle (61,567)
    !this.mdbs.val = 1
  endhandle
elseif (defined(!!pdmslogin) and !!pdmslogin.shown()) then
  !this.mdbs.select('RTEXT',!!pdmslogin.mdb.val)
  handle (61,567)
    !this.mdbs.val = 1
  endhandle
endif


endmethod

------------------------------------------------------------------------
--
-- Method:      !doSelection()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .doSelection()


if (defined(!!monitor) and !!monitor.shown()) then
  !this.textGadget=!!monitor.mdb
elseif (defined(!!pdmslogin) and !!pdmslogin.shown()) then
  !this.textGadget=!!pdmslogin.mdb
elseif (defined(!!admScriptGenerate) and !!admScriptGenerate.shown()) then
  !this.textGadget=!!admScriptGenerate.mdb
endif

  !this.textGadget.val = !this.mdbs.selection()

  -- For opening the mdb at a stamp
  if (defined(!!monitor.openStamp)) then
    if (!!monitor.openStamp.val) then
      !!monitor.getStamps()
    endif
  endif

  -- Set mdb
  call !!setMdb(!this.textGadget)

  -- Monitor modify button
  if (defined(!!monitor)) then
    !!monitor.modMdb.active = true
  endif

  -- Refresh the mdb session modification form
  if (defined(!!modSessMdb)) then
    if (!!modSessMdb.shown()) then
      !!modSessMdbInit('INIT')
      !!modSessMdb.getStamps()
    endif
  endif

endmethod
-- End of method definition for .doSelection()
