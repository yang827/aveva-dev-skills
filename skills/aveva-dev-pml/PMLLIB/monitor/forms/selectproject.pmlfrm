--
--
-- Description:
-- Form definition of project selection form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init(BOOLEAN)                    -                   constructor
--  selectProject()                  -                   constructor
--  setProject()                     -                   action
--


-- Initialise variables

setup form !!selectProject dialog resizable


  -- Body of form definition
  option .sort at x 5 y 0.5 |Sort by |  width 12

  text .filter at x 5 ymax+0.1 |Filter  |  width 12 string
  list .project at x 0 ymax+0.5 anchor all |Projects| anchor all zerosel width 100 length 10

exit
-- End of form definition for !!selectProject
------------------------------------------------------------------------
--
-- Method:      .selectProject()
--
-- Description: constructor
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .selectProject()

   var !marine evar  'AVEVA_MARINE'
  if(!marine.upcase().eq('YES')) then
    !this.formTitle = |MARINE Projects|
  else
    !this.formTitle     = |PDMS Projects|
  endif
  !this.iconTitle     = |PROJ|
  !this.callback      = |!this.init(true)|
  !this.formRevision  = | $Revision: 1.4 $ |


  -- callbacks
  !this.sort.callback     = |!this.init(false)|
  !this.filter.callback   = |!this.init(false)|
  !this.project.callback  = |!this.setProject()|

endmethod

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: constructor
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .init(!firstInit is BOOLEAN)

if (!firstInit) then
  !headings=ARRAY()
  !headings.append('Project')
  !headings.append('Project Code')
  !headings.append('Name')
  !headings.append('Description')
  !this.sort.dtext=!headings
  !headings.append('Number')
  !headings.append('Message')
  !this.project.setHeadings(!headings)
endif

  -- Check that we have a filter string
  if (!this.filter.val.empty()) then
    !this.filter.val = |*|
  endif

  -- Get available projects
  !projList = PROJECTS
  !projList.unique()

  -- Process list of projects to see if they are accessible
  do !i indices !projList

    -- Get the project code
    !projCode[!i] = !projList[!i].code()

    -- See if the code is valid
    PROJECT $!projCode[$!i]
    handle (43,252) (43,260)
      !okay[!i]     = true
      !pCode[!i]    = |*|
      !projDesc[!i] = |-- Description unavailable --|
      !projId[!i]   = !projList[!i].id()
      !projNumb[!i] = !projList[!i].number()
      !projMess[!i] = !projList[!i].message()
      !projName[!i] = !projList[!i].name()
    elsehandle ANY
      !okay[!i]     = false

    elsehandle none

      !okay[!i]     = true
      !pCode[!i]    = | |
      !projDesc[!i] = !projList[!i].description()
      if (!projDesc[!i].unset()) then
        !projDesc[!i] = |-- No description --|
      endif
      !projId[!i]   = !projList[!i].id()
      !projNumb[!i] = !projList[!i].number()
      !projMess[!i] = !projList[!i].message()
      !projName[!i] = !projList[!i].Name()

    endhandle

    if (!okay[!i]) then
    if (!projNumb[!i].unset()) then
       !projNumb[!i] = 'Unset'
    endif
    if (!projMess[!i].unset()) then
       !projMess[!i] = 'Unset'
    endif
    if (!projName[!i].unset()) then
       !projName[!i] = 'Unset'
    endif
    endif
  enddo

  -- Return current project setting
  PROJECT $!!sessionSettings.project
  handle any

    -- Attempt to rectify gadget states
    !proj = CURRENT PROJECT
    handle any
      -- Dummy handle (no rectification)
    elsehandle none
      !!pdmsLogin.project.val = !proj.code().upcase()
      !!pdmsLogin.projName.val = !proj.id()
    endhandle

  endhandle

  -- Sort the list of valid projects
  if (!this.sort.selection('DTEXT') eq |Project Code|) then
    !sort = !projCode.sortedIndices()
  elseif (!this.sort.selection('DTEXT') eq |Description|) then
    !sort = !projDesc.sortedIndices()
  elseif (!this.sort.selection('DTEXT') eq |Project|) then
    !sort = !projId.sortedIndices()
  elseif (!this.sort.selection('DTEXT') eq |Name|) then
    !sort = !projName.sortedIndices()
  endif

  -- Clear the list gadget
  !this.project.clear()

  -- Build display and replacement texts
  !dispList = ARRAY()
  !replList = ARRAY()

  do !i values !sort

    -- Discard any bad projects
    skip if (not !okay[!i])

    -- Build the strings to filter
    if (!this.sort.selection('DTEXT') eq |Project Code|) then
      !filterString = !projCode[!i]
    elseif (!this.sort.selection('DTEXT') eq |Description|) then
      !filterString = !projDesc[!i]
    elseif (!this.sort.selection('DTEXT') eq |Project|) then
      !filterString = !projId[!i]
    elseif (!this.sort.selection('DTEXT') eq |Name|) then
      !filterString = !projName[!i]
    endif

    -- Discard projects not matching filter
    skip if (not !filterString.matchWild(!this.filter.val))

    -- Compose text

    var !unusedTest '$!projDesc[$!i]'
    handle ANY
      !projDesc[!i] = '-- Description unavailable --'
    endhandle

    if (!this.sort.selection('DTEXT') eq |Project Code|) then
      !textLine=!projCode[!i] & '	' & !projId[!i] & '	' & !projName[!i] & '	' & !projDesc[!i] & '	' & !projNumb[!i] & '	' &  !projMess[!i]
      !headings=ARRAY()
      !headings.append('Project Code')
      !headings.append('Project')
      !headings.append('Name')
      !headings.append('Description')
      !headings.append('Number')
      !headings.append('Message')
      !this.project.setHeadings(!headings)
    elseif (!this.sort.selection('DTEXT') eq |Project|) then
      !textLine=!projId[!i] & '	' & !projCode[!i] & '	' & !projName[!i] & '	' & !projDesc[!i] & '	' & !projNumb[!i] & '	' &  !projMess[!i]
      !headings=ARRAY()
      !headings.append('Project')
      !headings.append('Project Code')
      !headings.append('Name')
      !headings.append('Description')
      !headings.append('Number')
      !headings.append('Message')
      !this.project.setHeadings(!headings)
    elseif (!this.sort.selection('DTEXT') eq |Description|) then
      !textLine=!projDesc[!i] & '	' & !projId[!i] & '	' & !projName[!i] & '	' & !projCode[!i] & '	' & !projNumb[!i] & '	' &  !projMess[!i]
      !headings=ARRAY()
      !headings.append('Description')
      !headings.append('Project')
      !headings.append('Name')
      !headings.append('Project Code')
      !headings.append('Number')
      !headings.append('Message')
      !this.project.setHeadings(!headings)
    elseif (!this.sort.selection('DTEXT') eq |Name|) then
      !textLine=!projName[!i] & '	' & !projId[!i] & '	' & !projCode[!i] & '	' & !projDesc[!i] & '	' & !projNumb[!i] & '	' &  !projMess[!i]
      !headings=ARRAY()
      !headings.append('Name')
      !headings.append('Project')
      !headings.append('Project Code')
      !headings.append('Description')
      !headings.append('Number')
      !headings.append('Message')
      !this.project.setHeadings(!headings)
    endif

    !dispList.append(!textLine)
    !replList.append(!projCode[!i])


  enddo

  -- Assign values if defined
  if (!dispList.set()) then
    !this.project.dText = !dispList
    !this.project.rText = !replList
  endif

endmethod
------------------------------------------------------------------------
--
-- Method:      .setProject()
--
-- Description: action
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .setProject()

  !oldProject = !!currentProject

    !project = !this.project.selection('RTEXT').upcase()


  -- Try to set the project
  if (!project ne !!currentProject) then
    PROJECT $!project
    handle (43,252)

      !!messageFile.warning(150, 045, !project)

    elsehandle (43,9)

      !!messageFile.warning(150, 042, !project)

    elsehandle (43,260) (43,253)

      !error = !!error.text.after(|)|)
      !!alert.error(!error)

    elsehandle any

      !!messageFile.warning(150, 041, !project)

    elsehandle none

      !!pdmslogin.project.val    = !project.upcase()
      !!currentProject = !project.upcase()
    -- can not use current project because the user name will not be set so have to go round all the projects
    -- and find out the current project that way
    !projList = PROJECTS
    do !i indices !projList
       if (!projList[!i].evar.substring(1,3).upcase() eq !project.upcase()) then
          !projid=!projlist[!i].id()
       endif
    enddo
      !!pdmslogin.projName.val = !projid
  !!sessionSettings.project = !project
      !!sessionSettings.projName  = !projid

      -- clear MDB for new project
      !!pdmslogin.authentication  = false
      !!pdmslogin.passwd.active   = true
      !!pdmslogin.changePass.active = false
      !!sessionSettings.mdb = ||
      !!pdmslogin.mdb.val         = ||
      !!pdmslogin.userName.val    = ||
      !!pdmslogin.passwd.val      = ||
      !!pdmslogin.userName.setFocus()

    endhandle
    if (!project.upcase() neq !oldProject.upcase()) then
     -- clear MDB for new project
      !!sessionSettings.mdb      = ||
      !!pdmslogin.mdb.val        = ||
      !!pdmslogin.userName.setFocus()
    endif
  endif
  if (defined(!!selectProject)) then
     if (!!selectProject.shown()) then
       !!selectProject.hide()
     endif
  endif

endmethod
