--
-- File:            selectuser.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        monitor
--   Replaces:      FSELUSER
--
-- Author:          E.conba
-- Created:         Tue Jan 28 14:56:20 GMT 1997
--
--
-- Description:
-- Form definition to list project users to select from.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init(BOOLEAN)                    -                   constructor
--  selectUser()                     -                   constructor
--  setUserName()                    -                   action
--

setup form !!selectUser resize


  -- Body of form definition
  option .sort at x5 y 0.5 |Sort by |  width 12

  text .filter at x 5 ymax+0.1 |Filter  | width 12 string
  list .user at x 0 ymax+0.5 |User in Project| anchor all zerosel width 40 length 10

exit
-- End of form definition for !!selectUser

------------------------------------------------------------------------
--
-- Method:      .selectUser()
--
-- Description: constructor
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .selectUser()

  !this.formTitle     = |Select User|
  !this.iconTitle     = |SEL USER|
  !this.callback      = |!this.init(true)|
  !this.formRevision  = | $Revision: 1.5 $ |

  -- callbacks
  !this.sort.callback   = |!this.init(false)|
  !this.filter.callback = |!this.init(false)|
  !this.user.callback   = |!this.setUserName()|

endmethod
------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: constructor
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .init(!firstInit is BOOLEAN)

if (!firstInit) then
   !heading=ARRAY()
   !heading.append('Name')
   !heading.append('Description')
   !this.user.setHeadings(!heading)
   !this.sort.dText=!heading
endif
  -- Check that we have a filter string
  if (!this.filter.val.empty()) then
    !this.filter.val = |*|
  endif

  -- Get a list of project users for this auth user
  if (AUTHENTICATION  ) then
    !loginUser = object AUTHUSER()
    !userList = !loginUser.userList()
    handle(2,109)
      !errorString = 'Your Windows Login name ' & !loginUser.name & ' is not authenticated for this project'
      return error 1 '$!errorString'
    endhandle
  else
   -- Get a list of project users
      !userList = USERS
  endif

  handle (43,251)
       -- Project has not yet been set
       !!messageFile.error(150, 46)

  endhandle


  -- Check that the standard users exist
  if (!userList.unset()) then

    -- Only free users in project
    var !code PROJ CODE
    !!messageFile.error(150, 28,  !code)

  endif

  -- Get description array of users
  do !i indices !userList

    -- Set the user name
    !userName[!i] = !userList[!i].name

    -- Set the description
    !userDesc[!i]  = !userList[!i].description
    if (!userDesc[!i].empty()) then

      !userDesc[!i] = |-- No description --|

    endif

  enddo

  -- Sort the output
  if (!this.sort.selection() eq |Name|) then
    !sort = !userName.sortedIndices()

  elseif (!this.sort.selection() eq |Description|) then
      !sort = !userDesc.sortedIndices()

  endif

  -- Clear the list gadget
  !this.user.clear()

  -- Build display and replacement texts
  !dispList = ARRAY()
  !replList = ARRAY()

  do !i values !sort

    -- Build strings to filter
    if (!this.sort.selection() eq |Name|) then

      -- Filter on username
      !filterString = !userName[!i]

    elseif (!this.sort.selection() eq |Description|) then

      -- Filter on user description
      !filterString = !userDesc[!i]

    endif

    -- Discard entries not matching filter
    skip if (not !filterString.matchWild(!this.filter.val))

    -- Compose text
    if (!this.sort.selection() eq |Name|) then
      !heading=ARRAY()
      !heading.append('Name')
      !heading.append('Description')
      !this.user.setHeadings(!heading)
      !text=!userName[!i] & |	| & !userDesc[!i]

    elseif (!this.sort.selection() eq |Description|) then
      !heading=ARRAY()
      !heading.append('Description')
      !heading.append('Name')
      !this.user.setHeadings(!heading)

      !text=!userDesc[!i] & |	| & !userName[!i]

    endif

    !dispList.append(!text)
    !replList.append(!userName[!i])

  enddo

  -- Assign values if defined
  if (!dispList.set()) then

    !this.user.dText = !dispList
    !this.user.rText = !replList

  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .setUserName()
--
-- Description: action
--
-- Method Type: Procedure
--
--
------------------------------------------------------------------------
define method .setUserName()

  -- Read the gadget value
  if (!this.user.type() eq 'TEXT') then

    !userName = !this.user.val

  elseif (!this.user.type() eq 'LIST') then

    !userName = !this.user.selection('RTEXT')

  else

    return

  endif

  -- Set the value
  if (defined(!!pdmslogin) and !!pdmslogin.shown()) then
    !!pdmslogin.userName.val = !userName
    !!pdmslogin.setUserName()
  elseif (defined(!!monChangeUser) and !!monChangeUser.shown()) then
    !!monChangeUser.userName.val = !userName
    !!monChangeUser.setUserName()
  elseif (defined(!!admScriptGenerate) and !!admScriptGenerate.shown()) then
    !!admScriptGenerate.userName.val = !userName
  endif

  !!sessionSettings.user   = !userName

  -- Dismiss the selection form if displayed
  if (defined(!!selectUser)) then
     if (!!selectUser.shown()) then
       !!selectUser.hide()
     endif
  endif

endmethod
