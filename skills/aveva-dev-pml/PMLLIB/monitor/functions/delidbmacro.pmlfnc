--
--
-- Description:
-- Function to delete the specified Inter-DB macro
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Pointer to List gadget with IDBMacro No.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!delIdbMacro(!list is GADGET)

  -- Check that an IDB macro has been selected
  if (!list.val neq 0) then

    -- Get the macro number from the replacement text
    !macNumb = !list.selection('RTEXT')

    -- Confirm action
    !answer = !!alert.confirm(!!messageFile.messageString(150, 61, !macNumb.string()))

    -- Check user answer
    if (!answer.boolean()) then

      -- User said YES
      DELETE MACRO $!macNumb

      -- Update the form
      call !!listIdbMacro()

    endif

  endif

endfunction
-- End of function definition for !!delIdbMacro
