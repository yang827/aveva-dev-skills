--     Keyword:     GEN
--   Module:        monitor
--   Replaces:
--
-- Author:          E.conba
-- Created:         Mon Jan 20 16:36:14 GMT 1997
--
--
-- Description:
-- Function to populate the Inter-DB macro form list with the current
-- Inter-DB macro information applicable to the current user.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!listIdbMacro()

  !sessionData = CURRENT SESSION
  !teams       = !sessionData.user().teamList()
  !idbmacs     = MACROS

  -- Loop through the list of IdbMacros
  do !i indices !idbmacs

    -- For if the to db has been deleted
    if (!idbmacs[!i].from.name.unset() EQ TRUE) then
        !idbmacs[!i].from.name = 'Unknown'
    endif
    if (!idbmacs[!i].to.name.unset() EQ TRUE) then
        !idbmacs[!i].to.name = 'Unknown'
    endif

    -- Get to DB information
    !toDb = !idbmacs[!i].to.name
    !dbTeam = !idbmacs[!i].to.team.name
    handle any                                  $* handle clause added DFN3389
      skip
    endhandle

    -- See if the user is a member of this team
    !matchTeam = false
    if (!sessionData.user().access.upcase() eq 'FREE') then
      !matchTeam = true
    else
      do !j indices !teams
        -- See if the users team matched the macros TO TEAM
        if (!teams[!j].name eq !dbTeam) then

          !matchTeam = true
          break

        endif

      enddo
    endif

    -- Ignore macro if not matched
    skip if (not !matchTeam)

    -- Get macro information
    !file     = !idbmacs[!i].filename
    !from[!i] = !idbmacs[!i].from.name

    -- Get From DB description
    if (!!sessionSettings.showAs eq |DESC|) then

      -- Show from DB description
      !from[!i] = !idbmacs[!i].from.description

      if (!from[!i].empty()) then

         -- Description is empty
        !from[!i] = !idbmacs[!i].from.name

      else

        -- Check description length
        if (!from[!i].length() gt 26) then

          !from[!i] = !from[!i].subString(1,24) + |>>|

        endif

      endif

    endif

    -- Get To DB description
    if (!!sessionSettings.showAs eq |NAME| or  !idbmacs[!i].to.description.empty()) then

      -- Use to db name
      !to[!i] = !toDb

    else

      -- Use DB description
      !to[!i] = !idbmacs[!i].to.description

      -- Check description does not exceed 26 chars
      if (!to[!i].length() gt 26) then

        -- Truncate description
        !to[!i] = !to[!i].subString(1,24) + |>>|

      endif

    endif

    -- Create display texts

    -- Added at DFN3389
    if (!from[!i].unset()) then
      !from[!i] = ' - '
    endif
    if (!to[!i].unset()) then
      !to[!i] = ' - '
    endif
    -- End DFN3389

    !fromDisp = !from[!i].trim()
    !toDisp   = !to[!i].trim()
    var !display COMPOSE SPACE 0 |$!i| WIDTH 2 RIGHT $
                         SPACE 1 |$!toDisp| WIDTH 26 LEFT $
                         SPACE 1 |$!fromDisp| WIDTH 26 LEFT $
                         SPACE 1 |$!file| WIDTH 26 LEFT

    -- Append text to list of macros
    !macList[!i] = !display[1]

  enddo

  -- Clear the form list
  !!monIdbMac.macros.clear()

  -- If macros are present highlight this in the monitor form
  if (undefined(!macList)) then

    -- No macros present
    !!monitor.iDbWarn.background = !!monitor.background
    !!monitor.iDbWarn.val = ||
    return

  else

    -- Macros present
    !!monitor.iDbWarn.background = 2
    !!monitor.iDbWarn.val = |You have Inter-DB Macros to run|

  endif

  -- Sort the macros by database

  -- DFN3389 we could have sparse arrays
  !to = !to.compress()
  !from = !from.compress()
  !macList = !macList.compress()

  var !sort SORT !to ASCII ASCEND !from ASCII ASCEND

  -- Create empty display text arrays
  !dispMac = ARRAY()
  !replMac = ARRAY()

  -- Append sort arrays to display texts
  do !i values !sort
    if(undefined(!macList[!i.real()])) then
      break
    endif
    !dispMac.append(!macList[!i.real()])
    handle ANY
      -- Just in case
      break
    endhandle
    !replMac.append(!idbmacs[!i.real()].number.string())
  enddo

  -- Assign gadget values
  !!monIdbMac.macros.dText = !dispMac
  !!monIdbMac.macros.rText = !replMac

endfunction
-- End of function definition for !!listIdbMacro
