-- Created:         Tue Jan 21 10:26:29 GMT 1997
--
--
-- Description:
-- Function to modify the session MDB list format on callbacks from
-- Modify Session MDB form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     STRING      Action to perform
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!modSessMdb(!action is STRING)

  !sessionData = CURRENT SESSION

  -- Make all deferred DB's current in session MDB
  if (!action eq |CALL|) then

    -- Check is user really want to perform action
    !answer = !!alert.confirm(!!messageFile.messageString(150, 3))
    if (!answer.boolean().not()) then

      return

    endif

    -- Answered YES

    -- Get current list position
    !selNum = _current.selection('RTEXT').real()

    -- Is there a current position
    if (!selNum.unset()) then

      -- Start at top of the list
      !selNum = 1

    else

      -- If there is a position see if we need to place the DB after it
      if (_Insert.selection('DTEXT') eq |After|) then

        !selNum = !selNum + 1

      endif

    endif

    -- Loop through the deferred database
    do !i

      -- Break if the end of the list is reached
      if (_Deferred.dText.size() + 1 eq !i) then
        break
      endif

      -- Select the database
      _Deferred.val = !i

      -- Calculate insertion point
      !pos = !selNum + !i - 1
      !db  = _Deferred.selection('RTEXT')

      CURRENT $!db $!pos

    enddo

    -- Return if no dbs were made current
    if (undefined(!pos)) then
      return
    endif

  -- Defer all databases in session MDB
  elseif (!action eq |DALL|) then

    -- Get user to confirm action
    !answer = !!alert.confirm(!!messageFile.messageString(150, 4))
    if (!answer.boolean().not()) then
      return
    endif

    -- Answered YES

    -- Loop through current databases in reverse order
    do !i from _current.dText.size() to 1 by -1

      -- Defer database
      DEFER $!i

    enddo

  -- Make the current deferred selection current
  elseif (!action eq |CSEL|) then

    -- Check that we have a selected deferred db
    if (_Deferred.val neq 0) then

      -- Get the current db list position
      !selNum = _current.val

      -- Check there is  a current db
      if (!selNum eq 0) then

        -- No selection so top of the list
        !selNum = 1

      else

        -- Check to see is insert after is required
        if (_Insert.selection('DTEXT') eq |After|) then

          -- Increment list position by one
          !selNum = !selNum + 1

        endif

      endif

      -- Make the database current
      !db = _Deferred.selection('RTEXT')
      CURRENT $!db $!selNum

    else

      -- No selection so return
      return

    endif

    -- Store the current selection number for later
    _currentSel = !selNum

  -- Defer the selected current DB
  elseif (!action eq |DSEL|) then

    -- Get the name of the current database
    !db = _current.selection('RTEXT')

    -- Check we have a DB
    if (!db.empty()) then

      -- Can't defer what doesn't exist
      return

    else

      -- Defer the DB
      DEFER $!db

    endif

  -- Exchange the current selection for the deferred selection
  elseif (!action eq |SWAP|) then

    -- Get the current selections
    !currSel = _current.selection('RTEXT')
    !selDef  = _Deferred.selection('RTEXT')

    -- Make sure both dbs are present
    if (!currSel.empty() or !selDef.empty()) then

      -- One or other was unset so return
      return

    else

      -- Exchange databases
      DEFER $!currSel
      CURRENT $!selDef $!currSel

    endif

    -- Reset the current selection
    _currentSel = !currSel.real()

  -- Make DB read only by PROT command
  elseif (!action eq |PROT|) then

    -- Get the current selection
    !currNo = _current.selection('RTEXT').real()

    -- Check that we have a list position
    if (!currNo.unset()) then
      return
    endif

    -- Get information about the database
    !dbModes     = !sessionData.mode()
    !dbs         = !sessionData.current()
    !dbMode      = !dbModes[!currNo]
    !dbName      = !dbs[!currNo].name

    -- Change the database mode
    if (!dbMode eq |RW|) then

      -- Make the DB read only
      PROT $!dbName R

    else

      -- Make DB read/write (only possible if FREE user or owner)
      PROT $!dbName RW
      handle (39,6)

        !!messageFile.error(150, 6)

      endhandle

    endif

    -- Reset current selection
    _currentSel = !currNo

  -- Reset MDB to Default status
  elseif (!action eq |RESET|) then

    -- Get user to confirm action
    !answer = !!alert.confirm(!!messageFile.messageString(150, 5))
    if (!answer.boolean().not()) then

      return

    endif

    -- Answered YESY

    -- Reset the session MDB
    !mdb = !sessionData.mdb().name
    $!mdb

    -- Update the session setting in case someone changed it by hand
    !!sessionSettings.mdb = !sessionData.mdb().name

  endif

  -- Reinitialise the forms MDB lists
  call !!modSessMdbInit('INIT')

endfunction
-- End of function definition for !!modSessMdb
