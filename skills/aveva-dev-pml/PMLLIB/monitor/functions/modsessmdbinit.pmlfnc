-- Author:          E.conba
-- Created:         Tue Jan 21 09:29:56 GMT 1997
--
--
-- Description:
-- Function to initialise the MDB lists in the Modify Session MDB
-- form based on the toggle setting in the MDB List Formatting form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     STRING      Mode (INIT/SORT)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!modSessMdbInit(!mode is STRING)

  -- Set up the buttons depending on what mode we are in
  if (!!modSessMdb.type.selection('DTEXT') eq |System|) then

    !!modSessMdb.call.active  = false
    !!modSessMdb.cSel.active  = false
    !!modSessMdb.swap.active  = false
    !!modSessMdb.dSel.active  = false
    !!modSessMdb.dAll.active  = false
    !!modSessMdb.prot.active  = false
    !!modSessMdb.reset.active = false

  elseif (!!modSessMdb.type.selection('DTEXT') eq |Session|) then

    !!modSessMdb.call.active  = true
    !!modSessMdb.cSel.active  = true
    !!modSessMdb.swap.active  = true
    !!modSessMdb.dSel.active  = true
    !!modSessMdb.dAll.active  = true
    !!modSessMdb.prot.active  = true
    !!modSessMdb.reset.active = true

  endif

  -- Get the current session info
  !sessionData = CURRENT SESSION

  -- Return if MDB is unset
  if (!sessionData.mdb().name.unset()) then

    -- Raise error and return
    !!messageFile.error(150, 2)

  endif

  -- Mode SORT only applies to deferred DBS. Skip first part if true
  golabel /SORT if (!mode eq |SORT|)

  -- Check to see if the MDB selection form show as we don't want
  -- some bright spark changing MDB while we are in here.
  if (defined (!!selectMdb)) then
     if (!!selectMdb.shown()) then
       !!selectMdb.hide()
     endif
  endif

  -- Get the relevant session data depending upon mode
  if (!!modSessMdb.type.selection('DTEXT') eq |Session|) then

    -- Get the current mdb settings
    !current = !sessionData.current()
    !curMode = !sessionData.mode()

  else

    -- Get the system mdb settings
    !current = !sessionData.mdb().current()
    !curMode = !sessionData.mdb().mode()

  endif

  -- Get the MDB description if applicable
  if (!sessionData.mdb().description.empty()) then

    -- Use the mdb name
    !!modSessMdb.mdbDesc.val = !sessionData.mdb().name

  else

    !!modSessMdb.mdbDesc.val = !sessionData.mdb().description

  endif

  -- Clear out the current DB list and repopulate it
  !!modSessMdb.current.clear()

  !currDispList = ARRAY()
  !currReplList = ARRAY()

  -- Loop through the list of current databases
  do !i indices !current

    !cName = !current[!i].name

    -- Get the db description (use the name if it's unset)
    if (!current[!i].description.empty()) then

      -- Use db name
      !cDesc = !current[!i].name

    else

      !cDesc = !current[!i].description.trim()

    endif

    -- If the team toggle is on, set up the team display variable
    if (!!monUserDflts.cTeam) then

      !cTeam = !current[!i].team.name
      if (!!sessionSettings.showAs eq |NAME| or !current[!i].team.description.empty()) then

        -- Use team name
        !cTeam    = !current[!i].team.name
        !dispTeam = '	' & !cTeam

      else

        !cTeam    = !current[!i].team.description.trim()
        !dispTeam = '	' & !cTeam

      endif

    else

      -- Team name not required
      !dispTeam = ||

    endif

    -- If the type toggle is on, set up the type display variable
    if (!!monUserDflts.cType) then

      !cType    = !current[!i].type
      !dispType = '	' & !cType

    else

      -- Database type not required
      !dispType = ||

    endif

    -- If the mode toggle is on, set up the mode display variable
    if (!!monUserDflts.cAccess) then

      !caccs    = !curMode[!i]
      !dispAccs = '	' & !caccs

    else

      -- Database access mode not required
      !dispAccs = ||

    endif

    -- If the access toggle is on, set up the access display variable
    if (!!monUserDflts.cAccType) then

      !cacct = !current[!i].access
      !dispAcct = '	' & !cacct

    else

      -- Database access not required
      !dispAcct = ||

    endif

    -- If the claim mode toggle is on, set up the claim mode display variable
    if (!!monUserDflts.cAccMode) then

      -- Get claim string
      !caccm = !current[!i].claim

      -- Check to see if string is empty (UPDATE access)
      if (!caccm.unset() or !caccm.empty()) then

        -- Indicate it does not apply
        !caccm = |N/A|

      endif

      -- Set-up the compose text for later
      !dispAccm = '	' & !caccm

    else

      -- Claim mode not required
      !dispAccm = ||

    endif

    -- If the description/name toggle is on, set up the description/name display variable
    if (!!monUserDflts.cDesc) then

      if (!!sessionSettings.showAs eq |DESC|) then

        -- Use the name string if description already shown
        !dispDesc = '	' & !cName
      else

        -- Use the description if name is already shown
        !dispDesc = '	' & !cDesc

      endif
    else

      -- Description not required
      !dispDesc = ||

    endif

    -- If the number toggle is on, set up the number display variable
    if (!!monUserDflts.cNumber) then

      !cNumb    = !current[!i].number
      !dispNumb = '	' & !cNumb

    else

      -- Database number not required
      !dispNumb = ||

    endif

    -- If the file toggle is on, set up the file display variable
    if (!!monUserDflts.cFile) then

      !cFile    = !current[!i].file.part(-1,|/|)
      !dispFile = '	' & !cFile

    else

      -- File name not required
      !dispFile = ||

    endif

    -- Compose the complete display string (depending on display mode)
    if (!!sessionSettings.showAs eq |DESC|) then
      !display = !i & '	' & !cDesc & !dispTeam & !dispType & !dispAccs & !dispAcct & !dispAccm & !dispDesc & !dispNumb & !dispFile

    else

      !display = !i & '	' & !cName & !dispTeam & !dispType & !dispAccs & !dispAcct & !dispAccm & !dispDesc & !dispNumb & !dispFile

    endif

    -- Add the display string to the list (index as replacement text)
    !currDispList.append(!display)
    !currReplList.append(!i.string())

  enddo

  !headers = ARRAY()
  !headers.append('#')

  -- Work out what to put in header
  if (!!sessionSettings.showAs eq 'DESC') then
    !headers.append('Description')
  else
    !headers.append('Name')
  endif

  -- display team?
  if (!!monUserDflts.cTeam) then
    !headers.append('Team')
  endif

  -- display type?
  if (!!monUserDflts.cType) then
    !headers.append('Type')
  endif

  -- display mode?
  if (!!monUserDflts.cAccess) then
    !headers.append('Mode')
  endif

  -- display access?
  if (!!monUserDflts.cAccType) then
    !headers.append('Access')
  endif

  -- display claim mode?
  if (!!monUserDflts.cAccMode) then
    !headers.append('Claim')
  endif

  -- display description?
  if (!!monUserDflts.cDesc) then
    if (!!sessionSettings.showAs eq 'DESC') then
      !headers.append('Name')
    else
      !headers.append('Description')
    endif
  endif

  -- display number?
  if (!!monUserDflts.cNumber) then
    !headers.append('Number')
  endif

  -- display file?
  if (!!monUserDflts.cFile) then
    !headers.append('File')
  endif

  !!modSessMdb.current.setHeadings(!headers)
  !!modSessMdb.current.dText = !currDispList
  !!modSessMdb.current.rText = !currReplList

  -- Select the required item from the list if necessary
  if (!!modSessMdb.currentSel.set() and !!modSessMdb.currentSel neq 0) then

    !!modSessMdb.current.val = !!modSessMdb.currentSel
    !!modSessMdb.currentSel  = 0

  endif


  -- Prepare the list for the deferred databases.
  -- Also code entry point for sort gadget callback
  label /SORT

  -- Get the relevant session data depending upon mode
  if (!!modSessMdb.type.selection('DTEXT') eq |System|) then

    -- Get system state of database
    !deferred = !sessionData.mdb().deferred()

  else

    -- Get session state of current database
    !deferred = !sessionData.deferred()

  endif

  -- Process the list of deferred DB's
  do !i indices !deferred

    -- Set up the team, name, type and description arrays because
    -- we may have to sort on them even if they are not being displayed
    !dTeam[!i] = !deferred[!i].team.name
    !dName[!i] = !deferred[!i].name.after(|/|).trim()
    !dType[!i] = !deferred[!i].type

    -- Get the db description (use the name if it's unset)
    if (!deferred[!i].description.empty()) then

      -- Use database name
      !dDesc[!i] = !deferred[!i].name

    else

      !dDesc[!i] = !deferred[!i].description

    endif

    -- Set the team array to team description/name depending on mode
    if (!!sessionSettings.showAs eq |NAME| or !deferred[!i].team.description.empty()) then

      -- User team name
      !dTeam[!i] = !deferred[!i].team.name

    else

      -- User team description
      !dTeam[!i] = !deferred[!i].team.description.trim()

    endif

  enddo

  -- Do the sorting
  if (!deferred.size() neq 0) then

    if (!!modSessMdb.sort.selection('DTEXT') eq |Team|) then

      -- Sort on team then name
      var !sort SORT !dTeam ASCII ASCEND !dName ASCII ASCEND

    elseif (!!modSessMdb.sort.selection('DTEXT') eq |Name|) then

      -- Sort on name then team
      var !sort SORT !dName ASCII ASCEND !dTeam ASCII ASCEND

    elseif (!!modSessMdb.sort.selection('DTEXT') eq |Type|) then

      -- Sort on db type then team then name
      var !sort SORT !dType ASCII ASCEND !dTeam ASCII ASCEND !dName ASCII ASCEND

    elseif (!!modSessMdb.sort.selection('DTEXT') eq |Description|) then

      -- Sort on description
      var !sort SORT !dDesc ASCII ASCEND

    endif

  else

    -- Make sort a dummy array
    !sort = ARRAY()

  endif

  -- Clear out the deferred dbs list and re-populate it
  !!modSessMdb.deferred.clear()

  !defDispList = ARRAY()
  !defReplList = ARRAY()

  -- Loop through the new indices (unfortunately they are strings)
  do !j values !sort

    -- Make Z a real iteration pointer
    !z = !j.real()

    -- If the team toggle is on, set up the team display variable
    if (!!monUserDflts.dTeam) then

      !dispTeam = !dTeam[!z]

    else

      -- Description not required
      !dispTeam = ||

    endif

    -- If the type toggle is on, set up the type display variable
    if (!!monUserDflts.dType) then

      !dispType = '	' & !dType[!z]

    else

      -- Database type not required
      !dispType = ||

    endif

    -- If the access toggle is on, set up the access display variable
    if (!!monUserDflts.dAccType) then

      !dAcct = !deferred[!z].access
      !dispAcct = '	' & !dAcct

    else

      -- Database access mode not required
      !dispAcct = ||

    endif

    -- If the claim mode toggle is on, set up the claim mode display variable
    if (!!monUserDflts.dAccMode) then

      !daccm = !deferred[!z].claim

      -- Check to see if the string is empty (UPDATE access)
      if (!daccm.empty()) then

        -- Indicate claim not applicable
        !daccm = |N/A|

      endif

      -- Compose text string for later
      !dispAccm = '	' & !daccm

    else

      -- Database claim not required
      !dispAccm = ||

    endif

    -- If the description/name toggle is on, set up the description/name display variable
    if (!!monUserDflts.dDesc) then

      if (!!sessionSettings.showAs eq |DESC|) then

        -- Use database name as description is shown
        !dispDesc = '	' & !deferred[!z].name

      else

        -- User database description as name is shown
        !dispDesc = '	' & !dDesc[!z]

      endif

    else

      -- Database description not required
      !dispDesc = ||

    endif

    -- If the number toggle is on, set up the number display variable
    if (!!monUserDflts.dNumber) then

      !dNumb = !deferred[!z].number
      !dispNumb = '	' & !dNumb

    else

      -- Database number not required
      !dispNumb = ''

    endif

    -- If the file toggle is on, set up the file display variable
    if (!!monUserDflts.dFile) then

      !dFile = !deferred[!z].file.part(-1,|/|)
      !dispFile = '	' & !dFile

    else

      -- Database file not required
      !dispFile = ''

    endif

    -- Compose the complete display string (depending on display mode)
    if (!!sessionSettings.showAs eq |DESC|) then

      !display = !dDesc[!z] & !dispTeam & !dispType & !dispAcct & !dispAccm & !dispDesc & !dispNumb & !dispFile

    else

      !display = !deferred[!z].name & !dispTeam & !dispType & !dispAcct & !dispAccm & !dispDesc & !dispNumb & !dispFile

    endif

    -- Add the display string to the list (index as replacement text)
    !defDispList.append(!display)
    !defReplList.append(!deferred[!z].name)

  enddo

  -- work out headers for columns
  !headers = ARRAY()
  if (!!sessionSettings.showAs eq |DESC|) then
    !headers.append('Description')
  else
    !headers.append('Name')
  endif

  -- show team?
  if (!!monUserDflts.dTeam) then
    !headers.append('Team')
  endif

  -- show type?
  if (!!monUserDflts.dType) then
    !headers.append('Type')
  endif

  -- show access?
  if (!!monUserDflts.dAccType) then
    !headers.append('Access')
  endif

  -- show claim mode?
  if (!!monUserDflts.dAccMode) then
    !headers.append('Claim')
  endif

  -- show team?
  if (!!monUserDflts.dDesc) then
    if (!!sessionSettings.showAs eq |DESC|) then
      !headers.append('Name')
    else
      !headers.append('Description')
    endif
  endif

  -- show number?
  if (!!monUserDflts.dNumber) then
    !headers.append('Number')
  endif

  -- show file?
  if (!!monUserDflts.dFile) then
    !headers.append('File')
  endif

  !!modSessMdb.deferred.setHeadings(!headers)
  !!modSessMdb.deferred.dText = !defDispList
  !!modSessMdb.deferred.rText = !defReplList

  -- Test for monitor open for stamps
  !!modSessMdb.getStamps()

endfunction
-- End of function definition for !!modSessMdbInit
