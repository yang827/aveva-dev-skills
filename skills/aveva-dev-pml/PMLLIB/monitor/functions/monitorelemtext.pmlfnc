--   Module:        monitor
--   Replaces:
--
-- Author:          E.conba
-- Created:         Mon Jan 20 15:59:28 GMT 1997
--
--
-- Description:
-- Function to control the appearance of USERNAME etc as a name string
-- or as a description string for the Main form and any dependent forms
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Value of display mode to use (NAME/DESC)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!monitorElemText(!mode is STRING)

  !sessionData = CURRENT SESSION
  !user        = !sessionData.user().name

  if (Undefined (!!monMdbFmt)) then
    call !!loadForm('monMdbFmt')
  endif
  if (Undefined (!!selectMdb)) then
     call !!loadForm('selectMdb')
  endif
  if (Undefined (!!changePass)) then
     call !!loadForm('changePass')
  endif
  if (Undefined (!!modSessMdb)) then
     call !!loadForm('modSessMdb')
  endif
  -- Load the common library forms applicable to monitor
  if (Undefined (!!userStatus)) then
     call !!loadForm('userStatus')
  endif
  if (Undefined (!!userList)) then
     call !!loadForm('userList')
  endif
  if (Undefined (!!teamList)) then
     call !!loadForm('teamList')
  endif
  if (Undefined (!!mdbList)) then
     call !!loadForm('mdbList')
  endif
  if (Undefined (!!dbList)) then
     call !!loadForm('dbList')
  endif

  -- Update the !!monitor form first
  if (!mode eq |NAME|) then

    -- Element names to be shown
    !!monitor.user.val      = !sessionData.user().name
    !!monMdbFmt.cDesc.tag = |Description|
    !!monMdbFmt.dDesc.tag = |Description|

  elseif (!mode eq |DESC|) then

    -- Element descriptions to be shown
    !userDesc = !sessionData.user().description

    -- Check user description is set
    if (!userDesc.empty()) then
      !userDesc = !user
    endif

    -- Check description does not overrun allotted space
    if (!userDesc.length() gt 33) then
      !userDesc = !userDesc.subString(1,31) + |>>|
    endif

    !!monitor.user.val      = !userDesc
    !!monMdbFmt.cDesc.tag = |Name|
    !!monMdbFmt.dDesc.tag = |Name|
  endif

  !!monitor.dispMode       = !mode
  !!sessionSettings.showAs = !mode
  !!monUserDflts.mode      = !mode

  if (!sessionData.mdb().name.unset().not()) then
    !!monitor.mdb.val = !sessionData.mdb().name.subString(2)
  else
    !!monitor.mdb.val = ''
    !!monitor.mdb.setFocus()
  endif

  -- Update any forms dependent on the display mode
  call !!refreshDependent(!!selectMdb)
  call !!refreshDependent(!!monIdbMac)
  call !!refreshDependent(!!modSessMdb)

  -- Update common library forms
  call !!refreshDependent(!!userList)
  call !!refreshDependent(!!teamList)
  call !!refreshDependent(!!dbList)
  call !!refreshDependent(!!mdbList)
  call !!refreshDependent(!!userStatus)

endfunction
-- End of function definition for !!monitorElemText
