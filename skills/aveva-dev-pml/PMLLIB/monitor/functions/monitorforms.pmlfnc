--
--
-- Description:
-- Function to load all the forms for the monitor GUI, except those
-- forms used by the login functions.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!monitorForms()

  -- Monitor main form
  if (undefined (!!monitor)) then
     call !!loadForm('Monitor')
  endif
  -- Load Monitor auxiliary forms
  if (undefined (!!monIdbMac)) then
     call !!loadForm('MonIdbMac')
  endif

endfunction
-- End of function definition for !!monitorForms
