--
--
-- Description:
-- Function to load the monitor defaults.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!monitorLoadDflts()

  -- Initialise variables
  !defaultFiles   = ARRAY()

  -- Load the User Defaults
  !defaultFiles   = !!searchPaths('mon-user.pmlopt')
  if (!defaultFiles.set()) then

    -- Found some user defaults
    !defaultFiles.invert()

    -- Load the closest to user defaults
    !!runMacro(!defaultFiles[1].file.fullName(),'')
    handle any
      -- Bad file format
      !!messageFile.warning(146, 014,  'Monitor User Defaults',  !defaultFiles[1].file.fullName(),  '- incorrect format')
    endhandle

    -- No data set so use a defaults value
    if (undefined(!!monUserDflts)) then
      !!monUserDflts  = object MONUSERDFLTS()
      !!monUserDflts.mode   = 'NAME'
    endif

    -- Clear the array
    !defaultFiles.clear()
  else

    -- No file set so use a defaults value
    !!monUserDflts  = object MONUSERDFLTS()
    !!monUserDflts.mode   = 'NAME'

  endif

  ---- No need to "Load the Admin defaults" - the password lock is now done in core Admin

endfunction
-- End of function definition for !!monitorLoadDflts
