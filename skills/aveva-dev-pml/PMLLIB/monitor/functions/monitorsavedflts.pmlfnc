--
--
-- Description:
-- Function to write the user defaults to PDMSUSER on a module
-- switch of exit from PDMS.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!monitorSaveDflts()

  -- Initialise variables
  !outputFile   = |"%PDMSUSER%/mon-user.pmlopt"|
  if !outputFile.substring(1,1).eq('/') then
   !outputFile = !outputFile.after('/')
  endif
  !outputData   = ARRAY()

  if (!!monUserDflts.cTeam.unset()) then
    !!monUserDflts   = object MONUSERDFLTS()
    !!monUserDflts.cTeam     = FALSE
    !!monUserDflts.cType     = TRUE
    !!monUserDflts.cAccess   = TRUE
    !!monUserDflts.cAccType  = TRUE
    !!monUserDflts.cAccMode  = FALSE
    !!monUserDflts.cDesc     = FALSE
    !!monUserDflts.cNumber   = FALSE
    !!monUserDflts.cFile     = FALSE
    !!monUserDflts.dTeam     = FALSE
    !!monUserDflts.dType     = TRUE
    !!monUserDflts.dAccType  = FALSE
    !!monUserDflts.dAccMode  = FALSE
    !!monUserDflts.dDesc     = FALSE
    !!monUserDflts.dNumber   = FALSE
    !!monUserDflts.dFile     = FALSE
    !!monUserDflts.mode      = 'NAME'
  endif

  -- Construct output data
  !outputData.append(|---------------------------|)
  !outputData.append(|-- Monitor User Defaults --|)
  !outputData.append(||)
  !outputData.append(|!!monUserDflts   = object MONUSERDFLTS()|)
  !outputData.append(|!!monUserDflts.cTeam     = | + !!monUserDflts.cTeam.string())
  !outputData.append(|!!monUserDflts.cType     = | + !!monUserDflts.cType.string())
  !outputData.append(|!!monUserDflts.cAccess   = | + !!monUserDflts.cAccess.string())
  !outputData.append(|!!monUserDflts.cAccType  = | + !!monUserDflts.cAccType.string())
  !outputData.append(|!!monUserDflts.cAccMode  = | + !!monUserDflts.cAccMode.string())
  !outputData.append(|!!monUserDflts.cDesc     = | + !!monUserDflts.cDesc.string())
  !outputData.append(|!!monUserDflts.cNumber   = | + !!monUserDflts.cNumber.string())
  !outputData.append(|!!monUserDflts.cFile     = | + !!monUserDflts.cFile.string())
  !outputData.append(|!!monUserDflts.dTeam     = | + !!monUserDflts.dTeam .string())
  !outputData.append(|!!monUserDflts.dType     = | + !!monUserDflts.dType.string())
  !outputData.append(|!!monUserDflts.dAccType  = | + !!monUserDflts.dAccType.string())
  !outputData.append(|!!monUserDflts.dAccMode  = | + !!monUserDflts.dAccMode.string())
  !outputData.append(|!!monUserDflts.dDesc     = | + !!monUserDflts.dDesc.string())
  !outputData.append(|!!monUserDflts.dNumber   = | + !!monUserDflts.dNumber.string())
  !outputData.append(|!!monUserDflts.dFile     = | + !!monUserDflts.dFile.string())
  !outputData.append(|!!monUserDflts.mode      = '| + !!monUserDflts.mode +|'|)

  -- Attempt to write out data
  call !!writeFile(!outputFile,'OVERWRITE',!outputData)
  handle any

    -- Error writing user defaults file
    -- No need to inform user, system will be used next time

  endhandle

endfunction
-- End of function definition for !!monitorSaveDflts
