--
--
-- Description:
-- Function to start the monitor appware.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!monitorStart()

  -- Check for graphics device
  if (!!ttyMode()) then

    -- UI not required so return
    return

  endif

  -- Check to see if the session settings have been set. If not this is
  -- because someone has gone into PDMS in TTY mode and then changed
  -- to GRAPHICS from inside.
  !sessionData              = CURRENT SESSION
--  !access                   = !sessionData.user().access.upcase()
  !currentProject           = CURRENT PROJECT
  if (undefined(!!sessionSettings)) then

    -- Set the session settings
    !!sessionSettings         = object PDMSSETTINGS()

    !!sessionSettings.project = !currentProject.code()
    !!sessionSettings.user    = !sessionData.user().name
    !!sessionSettings.mdb     = !sessionData.mdb().name

  endif

  -- OnLine Help initialisation
  $*---now defunct---fminfo help file /%PDMSHELPDIR%/MONITOR.chm callback '$m/%PDMSUI%/MON/ADMIN/HELPABOUT'
  fminfo help callback '$m "%PDMSUI%/MON/ADMIN/HELPABOUT"'

  -- Load monitor defaults
  !!monitorLoadDflts()
  !!sessionSettings.showAs  = !!monUserDflts.mode

  -- Load monitor forms
  call !!monitorForms()

  -- Perform the initial checks on the MDB and set value
--   if (!sessionData.mdb().name.set()) then
--     call !!setMdb(!sessionData.mdb().name)
--   else
--     call !!setMdb(||)
--   endif

  -- Call routine to check for inter DB macros that this user must run
  call !!listIdbMacro()

  -- Initialise the display mode data
  call !!monitorElemText(!!sessionSettings.showAs)

  -- setup the main application window
  !!pdmsAppWindow()

  -- Swap the main form
  if (undefined(!!monitorMain)) then
    pml load form !!monitorMain
  else
    !!moduleMenus(!!monitorMain)
  endif

  if (defined(!!pdmsLogin)) then
    !!pdmsLogin.cancelCall   = ''
  endif
  swap main to !!monitorMain
-- construct forms back into monitor
  if(defined (!!appCntrl)) then
   !!appCntrl.delete()
  endif
  !!appCntrl = object APPCNTRL()

  !!appFormCntrl.constructForms()

  show !!monitor at xr 0 yr 0

  -- Build and show the icon bar
  -- call !!displayModuleBar('call !!monitorSaveDflts()')

endfunction
-- End of function definition for !!monitorStart
