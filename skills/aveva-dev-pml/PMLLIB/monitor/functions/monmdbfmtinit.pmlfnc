--
-- Description:
-- Function to initialise the form for setting the MDB list format
-- when modifying the session MDB.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!monMdbFmtInit()

  -- Initialise form gadgets
  !!monMdbFmt.cTeam.val       = !!monUserDflts.cTeam
  !!monMdbFmt.cType.val       = !!monUserDflts.cType
  !!monMdbFmt.cAccess.val     = !!monUserDflts.cAccess
  !!monMdbFmt.cAccTyp.val     = !!monUserDflts.cAccType
  !!monMdbFmt.cAccMod.val     = !!monUserDflts.cAccMode
  !!monMdbFmt.cDesc.val       = !!monUserDflts.cDesc
  !!monMdbFmt.cNumb.val       = !!monUserDflts.cNumber
  !!monMdbFmt.cFile.val       = !!monUserDflts.cFile
  !!monMdbFmt.dTeam.val       = !!monUserDflts.dTeam
  !!monMdbFmt.dType.val       = !!monUserDflts.dType
  !!monMdbFmt.dAccTyp.val     = !!monUserDflts.dAccType
  !!monMdbFmt.dAccMod.val     = !!monUserDflts.dAccMode
  !!monMdbFmt.dDesc.val       = !!monUserDflts.dDesc
  !!monMdbFmt.dNumb.val       = !!monUserDflts.dNumber
  !!monMdbFmt.dFile.val       = !!monUserDflts.dFile

endfunction
-- End of function definition for !!monMdbFmtInit
