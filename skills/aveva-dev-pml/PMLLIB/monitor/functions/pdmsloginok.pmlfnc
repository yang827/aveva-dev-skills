--
-- File:            pdmsloginok.pmlfnc
--   Type:          Function Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        monitor
--
-- Author:          C.Brown
-- Created:         Tue Jan 28 08:47:01 GMT 1997
--
--
-- Description:
-- OK callback for PDMS Login form.
-- This is run as a macro, as it requires a module switch
--
------------------------------------------------------------------------

  !!fmsys.splashScreen(false)
  !project  = !!pdmsLogin.project.val
  !userObject = object USER(!!pdmsLogin.userName.val)

  if (!!pdmslogin.authentication and !userObject.access.upcase() eq 'GENERAL') then
    -- No password required
    !user     = !!pdmsLogin.userName.val
  else
    if (!!pdmsLogin.passwd.val eq '') then
      !!alert.error('Password Required')
      return
    endif
    !user     = '|' & !!pdmsLogin.userName.val & '|' & '/' & !!pdmsLogin.passwd.val
  endif

  if (!project.trim().empty()) then
    !!messageFile.error(150, 46)
  endif

  if (!!pdmsLogin.mdb.val.trim() eq '') then
    !mdb = ''
  else
    !mdb = '/' + !!pdmsLogin.mdb.val
  endif

  !module = !!pdmsLogin.modules.selection()

  !!sessionSettings.mdb = !mdb

  !loginResult = !!login(!!pdmsLogin.project.val, !user, !mdb, !module)

  if (!loginResult) then
    if (!module.upcase() eq 'MONITOR') then
      call !!monitorStart()

    else
      -- get the moduleswitch.pmlfnc macro
      !moduleSwitch = '$m ' + '"' + !!pml.getPathName('moduleswitch.pmlfnc')+ '"'
      $!<moduleSwitch> $<$!<module>$> $<$!!<pdmsLogin.restore.val>$> $<false$> $<$!!<pdmsLogin.readOnly.val>$>
      handle ANY
        !errorLine = !!error.line
        !errorText = !!error.text
        return error 1 'Failed entering $!<module> ($!<errorText>). $!<errorLine>'
      endhandle
    endif
  endif
