--
-- Description:
-- Function to allow a user to reselect the current project after
-- they have entered PDMS.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!reLogin()

  -- Write the session file
  !!writeSessionFile()

  -- load the pdms login form if undefined
  if (undefined(!!pdmsLogin)) then
    pml load form !!pdmsLogin
  endif

  -- reset the cancel call on the login form
  !!pdmsLogin.reLogin = true

  -- Call the project login function
  call !!login('','','','')

endfunction
-- End of function definition for !!reLogin
