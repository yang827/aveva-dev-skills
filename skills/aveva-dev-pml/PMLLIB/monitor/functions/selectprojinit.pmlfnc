-- Author:          E.conba
-- Created:         Tue Jan 28 14:25:36 GMT 1997
--
--
-- Description:
-- Function to initialise the list of projects displayed in the
-- Projects form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!selectProjInit()

  -- Check that we have a filter string
  if (!!selectProject.filter.val.empty()) then
    !!selectProject.filter.val = |*|
  endif

  -- Get available projects
  !projList = PROJECTS

  -- Process list of projects to see if they are accessible
  do !i indices !projList

    -- Get the project code
    !projCode[!i] = !projList[!i].code().upcase()

    -- See if the code is valid
    PROJECT $!projCode[$!i]
    handle (43,252) (43,260)
      !okay[!i]     = true
      !pCode[!i]    = |*|
      !projDesc[!i] = |-- Description unavailable --|
      !projId[!i]   = !projList[!i].id()
      !projNumb[!i] = !projList[!i].number()
      !projMess[!i] = !projList[!i].message()
      !projName[!i] = !projList[!i].name()
    elsehandle ANY
      !okay[!i]     = false

    elsehandle none

      !okay[!i]     = true
      !pCode[!i]    = | |
      !projDesc[!i] = !projList[!i].description()
      if (!projDesc[!i].unset()) then
        !projDesc[!i] = |-- No description --|
      endif
      !projId[!i]   = !projList[!i].id()
      !projNumb[!i] = !projList[!i].number()
      !projMess[!i] = !projList[!i].message()
      !projName[!i] = !projList[!i].Name()

    endhandle
    if (!projNumb[!i].unset()) then
       !projNumb[!i] = 'Unset'
    endif
    if (!projMess[!i].unset()) then
       !projMess[!i] = 'Unset'
    endif
    if (!projName[!i].unset()) then
       !projName[!i] = 'Unset'
    endif
  enddo

  -- Return current project setting
  PROJECT $!!sessionSettings.project
  handle any

    -- Attempt to rectify gadget states
    !proj = CURRENT PROJECT
    handle any
      -- Dummy handle (no rectification)
    elsehandle none
      !!pdmsLogin.project.val = !proj.code().upcase()
      !!pdmsLogin.projName.val = !proj.id()
    endhandle

  endhandle

  -- Sort the list of valid projects
  if (!!selectProject.sort.selection('DTEXT') eq |Project Code|) then
    !sort = !projCode.sortedIndices()
  elseif (!!selectProject.sort.selection('DTEXT') eq |Description|) then
    !sort = !projDesc.sortedIndices()
  elseif (!!selectProject.sort.selection('DTEXT') eq |Project|) then
    !sort = !projId.sortedIndices()
  elseif (!!selectProject.sort.selection('DTEXT') eq |Name|) then
    !sort = !projName.sortedIndices()
  endif

  -- Clear the list gadget
  !!selectProject.project.clear()

  -- Build display and replacement texts
  !dispList = ARRAY()
  !replList = ARRAY()

  do !i values !sort

    -- Discard any bad projects
    skip if (not !okay[!i])

    -- Build the strings to filter
    if (!!selectProject.sort.selection('DTEXT') eq |Project Code|) then
      !filterString = !projCode[!i]
    elseif (!!selectProject.sort.selection('DTEXT') eq |Description|) then
      !filterString = !projDesc[!i]
    elseif (!!selectProject.sort.selection('DTEXT') eq |Project|) then
      !filterString = !projId[!i]
    elseif (!!selectProject.sort.selection('DTEXT') eq |Name|) then
      !filterString = !projName[!i]
    endif

    -- Discard projects not matching filter
    skip if (not !filterString.matchWild(!!selectProject.filter.val))

    -- Compose List
    var !unusedTest '$!projDesc[$!i]'
    handle ANY
      !projDesc[!i] = '-- Description unavailable --'
    endhandle
    if (!!selectProject.sort.selection('DTEXT') eq |Project Code|) then
      !textLine=!projCode[!i] & '	' & !projId[!i] & '	' & !projName[!i] & '	' & !projDesc[!i] & '	' & !projNumb[!i] & '	' &  !projMess[!i]
      !headings=ARRAY()
      !headings.append('Project Code')
      !headings.append('Project')
      !headings.append('Name')
      !headings.append('Description')
      !headings.append('Number')
      !headings.append('Message')
      !!selectProject.project.setHeadings(!headings)
    elseif (!!selectProject.sort.selection('DTEXT') eq |Project|) then
      !textLine=!projId[!i] & '	' & !projCode[!i] & '	' & !projName[!i] & '	' & !projDesc[!i] & '	' & !projNumb[!i] & '	' &  !projMess[!i]
      !headings=ARRAY()
      !headings.append('Project')
      !headings.append('Project Code')
      !headings.append('Name')
      !headings.append('Description')
      !headings.append('Number')
      !headings.append('Message')
      !!selectProject.project.setHeadings(!headings)
    elseif (!!selectProject.sort.selection('DTEXT') eq |Description|) then
      !textLine=!projDesc[!i] & '	' & !projId[!i] & '	' & !projName[!i] & '	' & !projCode[!i] & '	' & !projNumb[!i] & '	' &  !projMess[!i]
      !headings=ARRAY()
      !headings.append('Description')
      !headings.append('Project')
      !headings.append('Name')
      !headings.append('Project Code')
      !headings.append('Number')
      !headings.append('Message')
      !!selectProject.project.setHeadings(!headings)
    elseif (!!selectProject.sort.selection('DTEXT') eq |Name|) then
      !textLine=!projName[!i] & '	' & !projId[!i] & '	' & !projCode[!i] & '	' & !projDesc[!i] & '	' & !projNumb[!i] & '	' &  !projMess[!i]
      !headings=ARRAY()
      !headings.append('Name')
      !headings.append('Project')
      !headings.append('Project Code')
      !headings.append('Description')
      !headings.append('Number')
      !headings.append('Message')
      !!selectProject.project.setHeadings(!headings)
    endif

    !dispList.append(!textLine)
    !replList.append(!projCode[!i])

  enddo

  -- Assign values if defined
  if (!dispList.set()) then
    !!selectProject.project.dText = !dispList
    !!selectProject.project.rText = !replList
  endif

endfunction
-- End of function definition for !!selectProjInit
