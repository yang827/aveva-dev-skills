-- Created:         Mon Jan 20 12:28:13 GMT 1997
--
--
-- Description:
-- Function to determine or set the session MDB
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R    STRING      String name of MDB to make current
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!setMdb(!textGadget is GADGET)

  -- Initialise variables
  !mdb         = '/' + !textGadget.val
  !sessionData = CURRENT SESSION

  -- Check to see if the argument contained a values
  if (!mdb.empty()) then

    if (!sessionData.mdb().name.set()) then

      -- If the user already has an MDB set then use it
      !textGadget     = !sessionData.mdb().name
      !!sessionSettings.mdb = !sessionData.mdb().name

      return

    elseif (not !!sessionSettings.mdb.unset()) then

      -- if the session file contain an MDB the try that
      !mdb = !!sessionSettings.mdb

    else

      -- No valid value and no MDB set return empty handed
      !textGadget.val     = ||
      !!sessionSettings.mdb = ||

    endif

  endif

  !sessionData = CURRENT SESSION

  -- Check for stamp
  if (defined(!!monitor)) then
    if (defined(!!monitor.openStamp)) then
      if (!!monitor.openStamp.val and !!monitor.stampList.selection().neq('None Found')) then
        !options = 'AT STAMP ' & !!monitor.stampList.selection('RTEXT').dbref().flnm
      else
        !options = ''
      endif
    else
      !options = ''
    endif
  else
    !options = ''
  endif

  -- For testing
  write '$!mdb $!options'

  -- Check to see the new value is valid for use.
  $!mdb $!options
  handle any

    -- Bad Mdb name
    !!messageFile.warning(150, 001, !mdb.subString(2))

    -- Reset mdb to session mdb if applicable
    if (!sessionData.mdb().name.set()) then

      !mdb = !sessionData.mdb().name

    else

      !mdb = ||

    endif

  endhandle

  -- Set new Mdb values
  !textGadget.val     = !mdb.subString(2)
  !!sessionSettings.mdb = !mdb

  -- Hide MDB selection form if shown
  if (defined(!!selectMdb)) then
    if (!!selectMdb.shown()) then
       hide !!selectMdb
    endif
  endif

  -- Test for open stamp gadget
  if (defined(!!monitor.openStamp)) then
    if (!!monitor.mdb.val.neq('')) then
      !!monitor.openStamp.active = true
    endif
  endif

  -- Set focus
  !textGadget.setFocus()

endfunction
-- End of function definition for !!setMdb
