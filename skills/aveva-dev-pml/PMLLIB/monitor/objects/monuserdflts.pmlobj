--
--
-- Description:
-- Monitor user defaults object. These can be save and stored in the
-- users PDMSUSER area, or loaded from any defaults data path.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  monUserDflts()                   -                   constructor
--

-- Define object
define object MONUSERDFLTS

  -- Modify Session MDB List data options
    -- Current DB Team
    member .cTeam      is BOOLEAN
    -- Current DB Type
    member .cType      is BOOLEAN
    -- Current DB Access
    member .cAccess    is BOOLEAN
    -- Current DB Access type
    member .cAccType   is BOOLEAN
    -- Current DB Access mode
    member .cAccMode   is BOOLEAN
    -- Current DB Description
    member .cDesc      is BOOLEAN
    -- Current DB Number
    member .cNumber    is BOOLEAN
    -- Current DB Filename
    member .cFile      is BOOLEAN
    -- Deferred DB Team
    member .dTeam      is BOOLEAN
    -- Deferred DB Type
    member .dType      is BOOLEAN
    -- Deferred DB Access Type
    member .dAccType   is BOOLEAN
    -- Deferred DB Access Mode
    member .dAccMode   is BOOLEAN
    -- Deferred DB Description
    member .dDesc      is BOOLEAN
    -- Deferred DB Number
    member .dNumber    is BOOLEAN
    -- Deferred DB Filename
    member .dFile      is BOOLEAN
    -- Display Mode
    member .mode       is STRING

endobject
-- End of object definition for MONUSERDFLTS

------------------------------------------------------------------------
--
-- Method:      !monUserDflts()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .monUserDflts()

  !this.cTeam     = false
  !this.cType     = true
  !this.cAccess   = true
  !this.cAccType  = true
  !this.cAccMode  = false
  !this.cDesc     = false
  !this.cNumber   = false
  !this.cFile     = false
  !this.dTeam     = false
  !this.dType     = true
  !this.dAccType  = false
  !this.dAccMode  = false
  !this.dDesc     = false
  !this.dNumber   = false
  !this.dFile     = false
  !this.mode      = 'NAME'

endmethod
-- End of method definition for .monUserDflts()
