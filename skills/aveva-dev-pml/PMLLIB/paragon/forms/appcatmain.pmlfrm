setup form !!appCatMain main

  title     |Paragon - AVEVA PDMS|
  icontitle |Paragon - AVEVA PDMS|
  revision  | $$Revision: 1.7 $ |
  !this.quitCall = |CALLIB XEXIT|

  -- !iconSize = !!comSysOpt.iconSize()
  -- icon size is now 16 because we can't change the size of icons on toolbars
  !iconSize = 16

  -- Main bar Menu
  bar
    add |Paragon|   _SYSCAT
    add |Display|   _SYSVIEW
    add |Query|     _SYSQRY
    add |Settings|  _SYSSET
    add |Utilities| _SYSUTIL
    add |Create|    _SYSCRT
    add |Modify|    _SYSMOD
    add |Delete|    _SYSDEL
    add window
    add help
  exit

  -- define ToolBar icons
  -------------------------------------------
  -- Main ToolBar
  -------------------------------------------
  -- get work
  button .mtbGetWork tooltip 'Get Work' pixmap width $!iconSize height $!iconSize callback |GETWORK|

  -- save work
  button .mtbSaveWork tooltip 'Save Work' pixmap width $!iconSize height $!iconSize callback |CALLG MSAVEW|

  -- List Creation/modification
  button .mtbCreateList tooltip 'Create/Modify Lists' pixmap width $!iconSize height $!iconSize callback |CALLIB SHOWFORM _CDCLIST|

  -- Active List/Collection
  option .list tooltip 'Active List' callback |CALLIB ILIST $$_LIST| width 15

  -- Delete CE
  button .mtbDeleteCe tooltip 'Delete CE' pixmap width $!iconSize height $!iconSize callback |CALLIB MDELCE CE true|

  -- Main ToolBar pixmaps
  !this.mtbGetWork.addPixmap(!!PML.getPathName('getwork' & !iconSize & '.png'))
  !this.mtbSaveWork.addPixmap(!!PML.getPathName('savework' & !iconSize & '.png'))
  !this.mtbCreateList.addPixmap(!!PML.getPathName('createlist' & !iconSize & '.png'))
  !this.mtbDeleteCe.addPixmap(!!PML.getPathName('deletece' & !iconSize & '.png'))

  -- Current naming format
  frame .namingFormatToolbar toolbar 'Naming Format'
    text .nfmt 'Naming format' width 35 STRING

    -- make naming format gadget read only
    !this.nfmt.setEditable(false)
  exit
  !!appTbarCntrl.addToolbar('namingFormatToolbar')

  -- now load all the toolbars for the other applications
  !!appCntrl.modifyForm()
exit

------------------------------------------------------------------------
--
-- Method:      .appCatMain()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appCatMain()
  -- set initialisation callback
  !this.initcall = '!this.initialise()'

  -- find out if we're in a global project
  !project = current project
  !isGlobal = !project.isGlobal()

  -- Paragon Menu
  !menu = !this.newMenu('SYSCAT')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Save Work', 'CALLG MSAVEW', 'SaveWork')
  !menu.add('CALLBACK', 'Get Work', 'GETWORK', 'GetWork')
  !menu.add('CALLBACK', 'Extract Control...', 'call !!admExtractCntrl()', 'ExtractControl')
  !menu.add('CALLBACK', 'Session Comment... ', 'show !!msgsavework', 'SessionComment')
  !menu.add('SEPARATOR')
  !!appCntrl.appMenu(!menu, |!!appxload('MODULE', 'APPNAME', false)|)
  !menu.add('SEPARATOR')
  !menu.add('MENU', 'Modules', 'modules', 'Modules')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Exit', 'CALLIB XEXIT', 'Exit')

  !menu = !this.newMenu('SYSVIEW')
  !menu.add('FORM', 'Plot View...', 'plotView', 'PlotView')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Members...', 'CALLIB UFORMS MEMB _CDCMEMBER FREE', 'Members')
  !menu.add('CALLBACK', 'Advanced Members...', 'CALLIB UFORMS MEMB _CDCADVMEMBER FREE', 'AdvancedMembers')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Specifications...', 'CDCSPECLIST', 'Specifications')
  !menu.add('CALLBACK', 'Command Window...', 'show _CADCBTH free', 'CommandLine')
  !menu.add('SEPARATOR')
  !menu.add('TOGGLE',   'Catalogue Explorer', '', 'Catalogue Explorer')
  !menu.add('TOGGLE',   'Search...',  '',                                       'Find Utility')
  !menu.add('TOGGLE',   'Search Results...',  '',                                       'Output Utility')
  !menu.add('SEPARATOR')
  !menu.add('TOGGLE',   'Status Controller',  '',                                       'Status Controller')

  -- Query Menu
  !menu = !this.newMenu('SYSQRY')
  !menu.add('TOGGLE',   'Attributes...',  '', 'Attributes Utility')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Project...', 'qryProject', 'Project')
  !menu.add('FORM', 'User Status...', 'userStatus', 'UserStatus')
  !menu.add('FORM', 'Data Access Control...', 'qrydac', 'DataAccessControl')
  !menu.add('CALLBACK', 'DB Changes...', |call !!displayOutput('Change')|, 'DBChanges')

  -- Settings Menu
  !menu = !this.newMenu('SYSSET')
  !menu.add('CALLBACK', 'System...', '!!comSysOpt.edit()', 'System')
  !menu.add('MENU', 'Graphics', 'SYSGPH', 'Graphics')
  !menu.add('CALLBACK', 'Naming...', 'show !!namOptedit', 'Naming')
  !menu.add('FORM', 'Units...', 'comFormatsSelect', 'Units')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Storage Areas...', 'catSetStorageAreas', 'StorageAreas')
  !menu.add('CALLBACK', 'Model Parameters...', 'CALLCG XMODSET', 'ModelParameters')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Comparison Date...', |!!compdate('MENU','SET')|, 'ComparisonDate')

  if ($!!cdlnAdmin) then
    !menu.add('SEPARATOR')
--    !menu.add('FORM', 'Naming Format...', 'CDTNAMFMT', 'NamingFormat')
    !menu.add('FORM', 'Representation Rules...', 'CDCDREP', 'RepresentationRules')
    !menu.add('FORM', 'Generic Types...', 'CDTADMGTYP', 'GenericTypes')
    !menu.add('SEPARATOR')
--    !menu.add('MENU', 'Design Templates', 'SYSDTMP', 'DesignTemplates')
  endif
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Reset Window Layout', '', 'RESET LAYOUT')
  !menu.add('CALLBACK', 'Explorer...', '', 'Explorer Settings')

  -- Graphics Menu
  !menu = !this.newMenu('SYSGPH')
  !menu.add('CALLBACK', 'Colour...', '!!gphColOpt.edit()', 'Colour')
  !menu.add('CALLBACK', 'Representation...', '!!gphRepOpt.edit()', 'Representation')
  -- !menu.add('FORM', 'Defaults...', 'CDTCGPHDAT', 'Defaults')
  !menu.add('FORM', 'Axes Height...', 'catAxes', 'catAxes')
  !menu.add('SEPARATOR')

  -- Utilities Menu
  !menu = !this.newMenu('SYSUTIL')
  !menu.add('CALLBACK', 'Data Checker...', 'show !!chkStoreView', 'DataChecker')
  !menu.add('MENU', 'Autonaming', 'sysName', 'autonaming')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Lists...     ', 'CALLIB SHOWFORM _CDCLIST', 'Lists')
  !menu.add('CALLBACK', 'Claimlists...', 'show !!lstClaim ', 'Claimlists')
  !menu.add('CALLBACK', 'DB Listing...', |call !!displayOutput('Datal')|, 'DBListing')
  if (!isGlobal) then
    !menu.add('SEPARATOR')
    !menu.add('CALLBACK', 'Transactions...', 'show !!glbTransactions', 'Transactions')
  endif
  !menu.add('SEPARATOR')
  !menu.add('MENU', 'Reporting', 'sysExpReporting', 'expreporting')
  !menu.add('MENU', 'Standard Reporting', 'sysStdReporting', 'stdreporting')
  !menu.add('SEPARATOR')
  !menu.add('MENU', 'Surface Treatment', 'SYSSRF', 'Surface')
  !menu.add('CALLBACK', 'Import Data...', '!!cataLoadCsv(||, object DBREF())', 'LoadCSV')
  !menu.add('CALLBACK', 'Catalogue Copy...', 'show !!catCopy', 'catCopy')

  -- Surface Treatment
  !menu = !this.newMenu('SYSSRF')
  !menu.add('CALLBACK', 'Define', 'show !!sftDefineMain2', 'Define')
  !menu.add('CALLBACK', 'Report', 'show !!sftstandardreport', 'Report')

  -- Autonaming
  !menu = !this.newMenu('sysName')
  !menu.add('CALLBACK', 'CE only', 'call !!autoNameCe(false)', 'CEonly')
  !menu.add('CALLBACK', 'CE offspring', 'call !!autoNameCe(true)', 'CEoffspring')

  -- Report menu
  !menu = !this.newMenu('SYSREP')
  !menu.add('CALLBACK', 'Run...', 'CALLIBR XREPSEL RUN', 'Run')
  !menu.add('CALLBACK', 'Create...', 'CALLIBR XREPDEF', 'Create')
  !menu.add('CALLBACK', 'Modify...', 'CALLIBR XREPSEL MODIFY', 'Modify')
  !menu.add('CALLBACK', 'Delete...', 'CALLIBR XREPSEL DELETE', 'Delete')

  -- Reporting menu
  !menu = !this.newMenu('sysStdReporting')
  !menu.add('MENU', 'Reports', 'SYSREP', 'reports')
  !menu.add('CALLBACK', 'Quick Reports...', 'show !!rptQuick', 'quickReports')

   -- Dev Xpress Reporting menu
  !menu = !this.newMenu('sysExpReporting')
  !menu.add('CALLBACK', 'Run Report...', '', 'Run Report')
  !menu.add('CALLBACK', 'Designer...', '', 'Reporting Designer')

  var !user user
  !u=object user(!user)
  !teamList = !u.teamList()
  do !teamName values !teamList
    if (!teamName.name eq 'AVEVANETADMIN') then
      !menu.add('SEPARATOR')
      !menu.add('CALLBACK', 'Publish To AVEVA Net Configuration', '', 'AVEVA NET Configuration')
      break
    endif
  enddo

  -- H&S Configurations menu
  !menu = !this.newMenu('SYSHSC')
  !menu.add('FORM', 'Template...', 'CDTHSSCONF', 'Template')
  !menu.add('FORM', 'Hanger...', 'CDTHSHCONF', 'Hanger')

  -- H&S Specs menu
  !menu = !this.newMenu('SYSHSS')
  !menu.add('FORM', 'Template...', 'CDTHSSSPEC', 'Template')
  !menu.add('FORM', 'Hanger...', 'CDTHSHSPEC', 'Hanger')
  !menu.add('FORM', 'Span Tables...', 'CDTHSSPTAB', 'SpanTables')

  -- Create Display Form
  !menu = !this.newMenu('SYSCRT')
  !menu.add('FORM', 'Copy...', 'CDTCOPY', 'Copy')

  -- Modify Menu
  !menu = !this.newMenu('SYSMOD')
  !menu.add('FORM', 'Name...', 'CDNAME', 'Name')
  !menu.add('TOGGLE',   'Attributes...',  '', 'Attributes Utility')
  !menu.add('CALLBACK', 'Attributes Global...', 'CALLIBQ INIT
  show _CDCATTGLOB', 'AttributesGlobal')
  !menu.add('FORM', 'Lock...', 'CDLOCK', 'Lock')
  !menu.add('MENU', 'Hierarchy', 'SYSHIER', 'Hierarchy')

  -- Hierarchy menu
  !menu = !this.newMenu('SYSHIER')
  !menu.add('CALLBACK', 'Include...', 'CALLIB UFORMS MEMB _CDCINCLUDE', 'Include')
  !menu.add('CALLBACK', 'Reverse Order', 'CALLIB MREOREV', 'ReverseOrder')
  !menu.add('FORM', 'Reorder...', 'CDCREOAFT', 'Reorder')

  -- Reorder
  !menu = !this.newMenu('REORDER')
  !menu.add('CALLBACK', 'Reverse', 'CALLG MREOREV', 'Reverse')
  !menu.add('FORM', 'Before/After...', 'CDREOAFT', 'BeforeAfter')

  -- Copy Attributes Like
  !menu = !this.newMenu('SYSLIKE')
  !menu.add('CALLBACK', 'Current element', 'CALLG MCOPYLIKE CE   ID', 'CurrentElement')

  -- Deletion Menu
  !menu = !this.newMenu('SYSDEL')
  !menu.add('CALLBACK', 'CE', 'CALLIB MDELCE CE true', 'CE')
  !menu.add('FORM', 'Name...', 'CDCDELNAME', 'Name')
  !menu.add('MENU', 'Members', 'SYSDELMEM', 'Members')

  -- Delete Members Menu
  !menu = !this.newMenu('SYSDELMEM')
  !menu.add('FORM', 'Selection...', 'CDCDELSEL', 'Selection')
  !menu.add('CALLBACK', 'All', 'CALLIB MDELCE CE true $$<$$> true', 'All')

  -- build module menus
  !!moduleMenus(!this)

  -- add menus for other applications
  !!appCntrl.modifyMenus()
endmethod
-- End of method definition for .appCatMain()

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: Initialisation
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()
  -- For Marine/Schematic Header
  !mm = object AVEVAMODULEMANAGER()
  !product = !mm.currentProductName()
  !this.formTitle = 'Paragon - AVEVA $!product'

  -- Build the active list option
  !listForm = !!cdcList
  !this.list.dtext = !listForm.name.dtext
  !this.list.rtext = !listForm.name.rtext
  !this.list.val = !listForm.name.val
  handle ANY
  endhandle
endmethod
-- End of method definition for .initialise()
