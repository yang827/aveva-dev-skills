-- File:            bolttable.pmlfrm
--   Type:          Form Definition
--   Group:         Paragon Application
--     Keyword:
--   Module:        PARAGON
--   Replaces:
--
-- Author:          venkatramanan.iyer
-- Created:
--
--
-- Description:
-- Form for creating Bolt Table
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(STRING)                    -                   apply
--  boltTable()                      -                   Constructor
--  changeMode()                     -                   callback of Changing  Mode between create and modify
--  close()                          -                   hides the form
--  initialise()                     -                   Initialisation method
--  populateData()                   -                   Populate attributes of selected coco to gadgets.
--  textValidation()                 -                   Validate textbox values
--
setup form !!boltTable  size 35 1

  !this.formTitle     = 'Bolt Table'
  !this.iconTitle     = 'Bolt table'
  !this.callback      = ''
  !this.formRevision  = ' $Revision: 1.0 $ '

  -- Body of form definition
  frame .boltTable 'Bolt table' at xmin+0.25         ymin+0.25
      para    .nameTag      at xmin+1         ymin+1    text 'Name      '                   width 6
      text    .name         at xmax+1         ymin                                          width 20 is STRING
      option  .mode         at xmax+1         ymin                                          width 6

      -- Create/Apply
      path down
      vdist 1
      button .create    ' Create '   anchor L+B    at xmin.nameTag
      button .modify    ' Apply  '   anchor L+B    at xmin.nameTag   ymin.create

      -- Cancel
      button .cancel    'Dismiss'    anchor R+B    at xmax form - size   ymin
  exit

  -- Error frame
  frame .errorFrame  at xmin.boltTable ymin.boltTable
    para .errorTag                 at xmin+1               ymin+1        width 40 lines 2
    button .error     'Done'       at xmax.errorTag-size   ymax+0.5 cancel
  exit

  -- Set mode whether to create or modify
  member .setMode is STRING

  -- Store current element
  member .currentElement is DBREF


exit

-- End of form definition for !!boltTable
------------------------------------------------------------------------
--
-- Method:      boltTable
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .boltTable()

    -- Initialise option gadgets

    !modeDText[1]                 = 'Create'
    !modeDText[2]                 = 'Modify'
    !this.mode.dText              = !modeDText

    !modeRText[1]                 = 'CREATE'
    !modeRText[2]                 = 'MODIFY'
    !this.mode.rText              = !modeRText

    !this.mode.callback           = '!this.changeMode()'

    !this.boltTable.visible = true
    !this.errorFrame.visible = false

    --Assign pixmap

    --for create
    !this.create.callback     = '!this.apply(|CREATE|)'
    !this.modify.callback     = '!this.apply(|MODIFY|)'

    --for cancel
    !this.cancel.callback = '!this.close()'

    -- Initialise values for gadgets

    --for boltTable
    !this.name.val            = 'Unset'
    !this.name.callback       = '!this.textValidation()'
    !this.error.callback      = '!this.initialise()'

    !this.changeMode()
    !this.currentElement      = !!ce

endmethod
-- End of method definition for .boltTable()
------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

    !this.currentElement = !!ce

    if(!this.setMode eq 'CREATE')then
      -- Bolt table can be created from BLTA hierarchy or below
      if(!this.currentElement.type inset('WORL','BLTA','LTAB','DTAB','BLIS','SBOL','MBLI','MBOL')) then
          !this.boltTable.visible  = true
          !this.errorFrame.visible = false

      -- Bolt table can be created at the first level of Catalogue hierarchy
      elseif(!this.currentElement.ddepth eq 1) then
          !this.boltTable.visible  = true
          !this.errorFrame.visible = false
      else
        -- Show error box here.
        !!alert.error('BLTA cannot be created within $!<this.currentElement.type>.')

      endif

    else

      if(!this.currentElement.type eq 'BLTA')then
        !this.boltTable.visible  = true
        !this.errorFrame.visible = false
        !this.populateData()
      elseif(!this.currentElement.type inset('BLIS','MBLI','LTAB'))then
        !!ce = !!ce.owner
        !this.currentElement     = !!ce
        !this.boltTable.visible  = true
        !this.errorFrame.visible = false
        !this.populateData()
      elseif(!this.currentElement.type inset('SBOL','MBOL','DTAB'))then
        !!ce = !!ce.owner.owner
        !this.currentElement     = !!ce
        !this.boltTable.visible  = true
        !this.errorFrame.visible = false
        !this.populateData()
      endif
    endif

endmethod
-- End of method definition for .initialise()
------------------------------------------------------------------------
--
-- Method:      changeMode
--
-- Description: callback of Changing  Mode between create and modify
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changeMode()

    !this.setMode              =  !this.mode.selection('RTEXT')

    !this.initialise()

    if(!this.setMode eq 'CREATE')then
      !this.create.visible     =  true
      !this.modify.visible     =  false
      !this.name.val           =  'Unset'

    else
      if(!this.currentElement.type neq 'BLTA')then
        return
      endif
      !this.create.visible     =  false
      !this.modify.visible     =  true
      !this.populateData()
    endif

endmethod
-- End of method definition for .changeMode()

 ------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: hides the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

  !this.hide()

endmethod
-- End of method definition for .close()

 ------------------------------------------------------------------------
--
-- Method:      textValidation
--
-- Description: Validate textbox values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .textValidation()

  if(!this.setMode eq 'MODIFY')then
     if(!this.name.val.trim() neq !!ce.namn)then
       !name    = !!checkName(!this.name.val,'new')
        if(!name.set().not())then
           !this.name.val = object STRING()
        endif
     endif
  else
     !name    = !!checkName(!this.name.val,'new')
     if(!name.set().not())then
       !this.name.val = object STRING()
     endif
  endif

endmethod
-- End of method definition for .textValidation()
------------------------------------------------------------------------
--
-- Method:      populateData
--
-- Description: Populate attributes of selected coco to gadgets.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .populateData()

    !this.name.val              = !this.currentElement.namn
    !name                       = !this.name.val
    if(!name.matchwild('*=*'))then
      !this.name.val            = object STRING()
    endif

endmethod
-- End of method definition for .populateData()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: apply
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   1      R     STRING     Action to be taken whether to create or Modify
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply(!action is STRING)

  if(!action eq 'CREATE') then
    NEW BLTA
    !this.currentElement = !!ce
  endif

      !name = !!checkName(!this.name.val,'new')
  if (!name eq '' or (unset(!name))) then
       return
  else
       !name    = !this.name.val
       !this.currentElement.name = '/' & !name
  endif


endmethod
-- End of method definition for .apply()
