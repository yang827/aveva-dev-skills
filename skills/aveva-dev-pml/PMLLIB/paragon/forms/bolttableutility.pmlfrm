--
-- File:            bolttableutility.pmlfrm
--   Type:          Form Definition
--   Group:         Bolt table Creation
--   Keyword:       CAT
--   Module:        Paragon
--   Replaces:
--
-- Author:          venkatramanan.iyer
-- Created:
--
--
-- Description:     Bolt Creation form for Paragon
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  boltTableUtility()               -                   Constructor method
--  callForm(FORM,STRING)            -
--  initialise()                     -                   Initialisation method
--  track()                          -                   Tracking the current element
--
------------------------------------------------------------------------
setup form !!boltTableUtility size 30 0.5

    !this.formtitle     = 'Bolt Table Utilities '
    !this.iconTitle     = 'Bolt Table Utilities'
    !this.initcall      = '!this.initialise()'
    !this.formRevision  = ' $Revision: 1.5 $ '
    track 'CATACE' callback  '!this.track()'

    -- Menu bar
    bar
      !this.bar.add ('Create','sysCrt')
      !this.bar.add ('Modify','sysMod')

    -- Members of the form.
    member .continue is BOOLEAN

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      boltTableUtility
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .boltTableUtility()

  -- Create Menu
  !menu = !this.newMenu('sysCrt')
  !menu.add('callback', 'Bolt Table...',             '!this.callForm(!!boltTable,|CREATE|)',      'createBoltTable')

  !menu.add('callback', 'Single Bolt List...',       '!this.callForm(!!sBoltList,|CREATE|)',      'createSBoltList')
  !menu.add('callback', 'Single Bolt Elements...',   '!this.callForm(!!sBoltElements,|CREATE|)',  'createSBoltElements')

  !menu.add('callback', 'Multiple Bolt List...',     '!this.callForm(!!mBoltList,|CREATE|)',      'createMBoltList')
  !menu.add('callback', 'Multiple Bolt Elements...', '!this.callForm(!!mBoltElements,|CREATE|)',  'createMBoltElements')

  !menu.add('callback', 'Length Table...',           '!this.callForm(!!lengthTable,|CREATE|)',    'createLengthTable')
  !menu.add('callback', 'Diameter Table...',         '!this.callForm(!!diameterTable,|CREATE|)',  'createDiameterTable')

  -- Modify Menu
  !menu = !this.newMenu('sysMod')

  !menu.add('callback', 'Bolt Table...',             '!this.callForm(!!boltTable,|MODIFY|)',      'modifyBoltTable')

  !menu.add('callback', 'Single Bolt List...',       '!this.callForm(!!sBoltList,|MODIFY|)',      'modifySBoltList')
  !menu.add('callback', 'Single Bolt Elements...',   '!this.callForm(!!sBoltElements,|MODIFY|)',  'modifySBoltElements')

  !menu.add('callback', 'Multiple Bolt List...',     '!this.callForm(!!mBoltList,|MODIFY|)',      'modifyMBoltList')
  !menu.add('callback', 'Multiple Bolt Elements...', '!this.callForm(!!mBoltElements,|MODIFY|)',  'modifyMBoltElements')

  !menu.add('callback', 'Length Table...',           '!this.callForm(!!lengthTable,|MODIFY|)',    'modifyLengthTable')
  !menu.add('callback', 'Diameter Table...',         '!this.callForm(!!diameterTable,|MODIFY|)',  'modifyDiameterTable')

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

    -- Need to allow the forms to be initialised.
    !!boltTableUtility.continue = TRUE

    -- Loading the Bolt table (BLTA) form
    pml load form !!boltTable

    -- Loading the Single Bolt List (BLIS) form
    pml load form !!sBoltList

    -- Loading the Multiple Bolt List (MBLI) form
    pml load form !!mBoltList

    -- Loading the Single Bolt Elements (SBOL) form
    pml load form !!sBoltElements

    -- Loading the Multi Bolt Elements (MBOL) form
    pml load form !!mBoltElements

    -- Loading the Length Table (LTAB) form
    pml load form !!lengthTable

    -- Loading the Diameter Table (DTAB) form
    pml load form !!diameterTable

    -- Need to allow the forms to be initialised.
    !!boltTableUtility.continue = FALSE

   !this.track()

endmethod
-- End of method definition

-------------------------------------------------------------------------
--
-- Method:      callForm
--
-- Description: Invocation method to call forms
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     Form        Form to be called
--    2.   R     STRING      Action to be taken whether to create or to modify
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .callForm(!form is FORM , !action is STRING)

   !formString = '!!' & !form.name()
   !form.mode.select('RTEXT',!action)
   !form.changeMode()
   !form.setMode = !action
   show $!formString

endmethod
-- End of method definition

-------------------------------------------------------------------------
--
-- Method:      track
--
-- Description: Tracking the current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]

-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .track()

   if(!!ce.type eq 'BLIS')then

      !this.sysCrt.setFieldProperty('createBoltTable',    'visible',    true)
      !this.sysCrt.setFieldProperty('createSBoltList',    'visible',    true)
      !this.sysCrt.setFieldProperty('createMBoltList',    'visible',    true)
      !this.sysCrt.setFieldProperty('createLengthTable',  'visible',    true)
      !this.sysCrt.setFieldProperty('createSBoltElements','visible',    true)
      !this.sysCrt.setFieldProperty('createMBoltElements','visible',    false)
      !this.sysCrt.setFieldProperty('createDiameterTable','visible',    false)

      !this.sysMod.setFieldProperty('modifyBoltTable',    'visible',    true)
      !this.sysMod.setFieldProperty('modifySBoltList',    'visible',    true)
      !this.sysMod.setFieldProperty('modifyMBoltList',    'visible',    false)
      !this.sysMod.setFieldProperty('modifyLengthTable',  'visible',    false)
      !this.sysMod.setFieldProperty('modifySBoltElements','visible',    false)
      !this.sysMod.setFieldProperty('modifyMBoltElements','visible',    false)
      !this.sysMod.setFieldProperty('modifyDiameterTable','visible',    false)

   elseif(!!ce.type eq 'SBOL')then

      !this.sysCrt.setFieldProperty('createBoltTable',    'visible',    true)
      !this.sysCrt.setFieldProperty('createSBoltList',    'visible',    true)
      !this.sysCrt.setFieldProperty('createMBoltList',    'visible',    true)
      !this.sysCrt.setFieldProperty('createLengthTable',  'visible',    true)
      !this.sysCrt.setFieldProperty('createSBoltElements','visible',    true)
      !this.sysCrt.setFieldProperty('createMBoltElements','visible',    false)
      !this.sysCrt.setFieldProperty('createDiameterTable','visible',    false)

      !this.sysMod.setFieldProperty('modifyBoltTable',    'visible',    true)
      !this.sysMod.setFieldProperty('modifySBoltList',    'visible',    true)
      !this.sysMod.setFieldProperty('modifyMBoltList',    'visible',    false)
      !this.sysMod.setFieldProperty('modifyLengthTable',  'visible',    false)
      !this.sysMod.setFieldProperty('modifySBoltElements','visible',    true)
      !this.sysMod.setFieldProperty('modifyMBoltElements','visible',    false)
      !this.sysMod.setFieldProperty('modifyDiameterTable','visible',    false)

    elseif(!!ce.type eq 'MBOL')then
      !this.sysCrt.setFieldProperty('createBoltTable',    'visible',    true)
      !this.sysCrt.setFieldProperty('createSBoltList',    'visible',    true)
      !this.sysCrt.setFieldProperty('createMBoltList',    'visible',    true)
      !this.sysCrt.setFieldProperty('createLengthTable',  'visible',    true)
      !this.sysCrt.setFieldProperty('createSBoltElements','visible',    false)
      !this.sysCrt.setFieldProperty('createMBoltElements','visible',    true)
      !this.sysCrt.setFieldProperty('createDiameterTable','visible',    false)

      !this.sysMod.setFieldProperty('modifyBoltTable',    'visible',    true)
      !this.sysMod.setFieldProperty('modifySBoltList',    'visible',    false)
      !this.sysMod.setFieldProperty('modifyMBoltList',    'visible',    true)
      !this.sysMod.setFieldProperty('modifyLengthTable',  'visible',    false)
      !this.sysMod.setFieldProperty('modifySBoltElements','visible',    false)
      !this.sysMod.setFieldProperty('modifyMBoltElements','visible',    true)
      !this.sysMod.setFieldProperty('modifyDiameterTable','visible',    false)

    elseif(!!ce.type eq 'MBLI')then
      !this.sysCrt.setFieldProperty('createBoltTable',    'visible',    true)
      !this.sysCrt.setFieldProperty('createSBoltList',    'visible',    true)
      !this.sysCrt.setFieldProperty('createMBoltList',    'visible',    true)
      !this.sysCrt.setFieldProperty('createLengthTable',  'visible',    true)
      !this.sysCrt.setFieldProperty('createSBoltElements','visible',    false)
      !this.sysCrt.setFieldProperty('createMBoltElements','visible',    true)
      !this.sysCrt.setFieldProperty('createDiameterTable','visible',    false)

      !this.sysMod.setFieldProperty('modifyBoltTable',    'visible',    true)
      !this.sysMod.setFieldProperty('modifySBoltList',    'visible',    false)
      !this.sysMod.setFieldProperty('modifyMBoltList',    'visible',    true)
      !this.sysMod.setFieldProperty('modifyLengthTable',  'visible',    false)
      !this.sysMod.setFieldProperty('modifySBoltElements','visible',    false)
      !this.sysMod.setFieldProperty('modifyMBoltElements','visible',    false)
      !this.sysMod.setFieldProperty('modifyDiameterTable','visible',    false)

    elseif(!!ce.type eq 'LTAB')then
      !this.sysCrt.setFieldProperty('createBoltTable',    'visible',    true)
      !this.sysCrt.setFieldProperty('createSBoltList',    'visible',    true)
      !this.sysCrt.setFieldProperty('createMBoltList',    'visible',    true)
      !this.sysCrt.setFieldProperty('createLengthTable',  'visible',    true)
      !this.sysCrt.setFieldProperty('createSBoltElements','visible',    false)
      !this.sysCrt.setFieldProperty('createMBoltElements','visible',    false)
      !this.sysCrt.setFieldProperty('createDiameterTable','visible',    true)

      !this.sysMod.setFieldProperty('modifyBoltTable',    'visible',    true)
      !this.sysMod.setFieldProperty('modifySBoltList',    'visible',    false)
      !this.sysMod.setFieldProperty('modifyMBoltList',    'visible',    false)
      !this.sysMod.setFieldProperty('modifyLengthTable',  'visible',    true)
      !this.sysMod.setFieldProperty('modifySBoltElements','visible',    false)
      !this.sysMod.setFieldProperty('modifyMBoltElements','visible',    false)
      !this.sysMod.setFieldProperty('modifyDiameterTable','visible',    false)

    elseif(!!ce.type eq 'DTAB')then
      !this.sysCrt.setFieldProperty('createBoltTable',    'visible',    true)
      !this.sysCrt.setFieldProperty('createSBoltList',    'visible',    true)
      !this.sysCrt.setFieldProperty('createMBoltList',    'visible',    true)
      !this.sysCrt.setFieldProperty('createLengthTable',  'visible',    true)
      !this.sysCrt.setFieldProperty('createSBoltElements','visible',    false)
      !this.sysCrt.setFieldProperty('createMBoltElements','visible',    false)
      !this.sysCrt.setFieldProperty('createDiameterTable','visible',    true)

      !this.sysMod.setFieldProperty('modifyBoltTable',    'visible',    true)
      !this.sysMod.setFieldProperty('modifySBoltList',    'visible',    false)
      !this.sysMod.setFieldProperty('modifyMBoltList',    'visible',    false)
      !this.sysMod.setFieldProperty('modifyLengthTable',  'visible',    true)
      !this.sysMod.setFieldProperty('modifySBoltElements','visible',    false)
      !this.sysMod.setFieldProperty('modifyMBoltElements','visible',    false)
      !this.sysMod.setFieldProperty('modifyDiameterTable','visible',    true)

    elseif(!!ce.type eq 'BLTA')then
      !this.sysCrt.setFieldProperty('createBoltTable',    'visible',    true)
      !this.sysCrt.setFieldProperty('createSBoltList',    'visible',    true)
      !this.sysCrt.setFieldProperty('createMBoltList',    'visible',    true)
      !this.sysCrt.setFieldProperty('createLengthTable',  'visible',    true)
      !this.sysCrt.setFieldProperty('createSBoltElements','visible',    false)
      !this.sysCrt.setFieldProperty('createMBoltElements','visible',    false)
      !this.sysCrt.setFieldProperty('createDiameterTable','visible',    false)

      !this.sysMod.setFieldProperty('modifyBoltTable',    'visible',    true)
      !this.sysMod.setFieldProperty('modifySBoltList',    'visible',    false)
      !this.sysMod.setFieldProperty('modifyMBoltList',    'visible',    false)
      !this.sysMod.setFieldProperty('modifyLengthTable',  'visible',    false)
      !this.sysMod.setFieldProperty('modifySBoltElements','visible',    false)
      !this.sysMod.setFieldProperty('modifyMBoltElements','visible',    false)
      !this.sysMod.setFieldProperty('modifyDiameterTable','visible',    false)

    else
      !this.sysCrt.setFieldProperty('createBoltTable',    'visible',    true)
      !this.sysCrt.setFieldProperty('createSBoltList',    'visible',    false)
      !this.sysCrt.setFieldProperty('createMBoltList',    'visible',    false)
      !this.sysCrt.setFieldProperty('createLengthTable',  'visible',    false)
      !this.sysCrt.setFieldProperty('createSBoltElements','visible',    false)
      !this.sysCrt.setFieldProperty('createMBoltElements','visible',    false)
      !this.sysCrt.setFieldProperty('createDiameterTable','visible',    false)

      !this.sysMod.setFieldProperty('modifyBoltTable',    'visible',    false)
      !this.sysMod.setFieldProperty('modifySBoltList',    'visible',    false)
      !this.sysMod.setFieldProperty('modifyMBoltList',    'visible',    false)
      !this.sysMod.setFieldProperty('modifyLengthTable',  'visible',    false)
      !this.sysMod.setFieldProperty('modifySBoltElements','visible',    false)
      !this.sysMod.setFieldProperty('modifyMBoltElements','visible',    false)
      !this.sysMod.setFieldProperty('modifyDiameterTable','visible',    false)

    endif

endmethod
-- End of method definition

-------------------------------------------------------------------------
