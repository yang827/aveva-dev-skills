--    the same form.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  createElement(GADGET,STRING)     -
--  display()                        -
--  init()                           -
--

setup form !!catDisplayPlot dialog dock

  !this.formTitle     = 'Plot Views'
  !this.iconTitle     = 'Plots'
  !this.callback      = ''
  !this.cancelCall    = ''
  !this.initcall      = '!this.init()'
  !this.formRevision  = ' $Revision$ '

  frame .views  anchor all

    view .plot1 plot
    border off
    height 10 width 35
    setcolour black
  exit

  exit
  path down

  member .action is STRING

exit

define method .init()

       !this.display()

endmethod

define method .display()

  -- Load the plot window with an image here, some have odd names, that's why the handles are in here.
    !type = !this.action

    !this.views.visible = true
    edit !!catDisplayPlot.plot1 plot
    add "%PDMSUI%/CAT/plot/pgmp$!type"
        handle (61,230) (61,251)
           add "%PDMSUI%/CAT/plot/pgmn$!type"
               handle (61,230) (61,251)
                  add "%PDMSUI%/CAT/plot/pgm$!type"
                    handle (61,251)
                       !!alert.message('Sorry - No plot for "$!type"')
                    endhandle
               endhandle
        endhandle

endmethod


---------------------------------------------------- Create Elements -----------------------------------------
define method .createElement(!gadget is GADGET, !string is STRING)
!save = !!ce
if (!string.eq('SELECT')) then

-- Create an Element here.
!gad = !gadget.fullname().substring(!gadget.fullname().length())
!create = !this.new$!gad$n.dtext[!this.new$!gad$n.val].lowcase()
!!ce = $!gadget
handle (2,111) (2,761)
  !!alert.message('Create an $!create here, please.')

  -- Load the plot window with an image here, some are named dodgy for some reason, thats
  -- why the handles are in here.

    !!vcat4.views.visible = true
    edit !!vcat4.plot1 plot
    add "%PDMSUI%/CAT/plot/pgmp$!create"
        handle (61,230) (61,251)
           add "%PDMSUI%/CAT/plot/pgmn$!create"
               handle (61,230) (61,251)
                  add "%PDMSUI%/CAT/plot/pgm$!create"
                    handle (61,251)
                       !!alert.message('Sorry - No plot for "$!create"')
                    endhandle
               endhandle
        endhandle

endhandle

-- Goto the owner, and create the element.
!element = !gadget.dtext[!gadget.val]
handle (2,759)
  !option  = !gadget.fullname().split('.')[1] & '.new' & !gad
  !cmnd  = !option & '.dtext[' & !option & '.val]'
  !element = $!cmnd
endhandle

-- Create the new element here now. and display the attributes in the param table window.
new $!element
!ref = !!ce

if (!gad.real().eq(4)) then
    !this.posigeom()
endif

-- Now Add The Contents of the Selected Element
    var !att split attlist of $!ref

    !heading[1] = 'Attribute'
    !heading[2] = 'Description'
    !list[1]    = ARRAY()
    !list[2]    = ARRAY()

    do !x value !att
        var !y $!x of $!ref
        !list[1].append(|$!x|)
        !list[2].append(|$!y|)
    enddo

    !this.paramList$!gad$n.setheadings(!heading)
    !this.paramList$!gad$n.setColumns(!list)

--!!vcatNewElement(!!ce)

endif

!!ce = !save
endmethod
