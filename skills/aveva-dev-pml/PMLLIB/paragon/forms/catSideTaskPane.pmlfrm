setup form !!catSideTaskPane dialog docking right

  !this.formTitle     = 'Right Hand Side Task Pane'
  !this.iconTitle     = 'Train'
  !this.callback      = ''
  !this.cancelCall    = ''
  !this.initcall      = |!this.init('init')|
  !this.formRevision  = ' $Revision$ '

  -- Martin's Task Pane
  frame .martinPane panel                    anchor all                        at x0                     y0

--    paragraph .martinHeader                                                    at x0                   ymax                text 'Warning'
    Button    .create2      'Create Window'    call |!!catParagon.add()|         at x0.5                 ymax
    line .martinLine                         anchor top + left + right         at x0                     ymax                horizontal width 32
--    paragraph .martinIcon                    anchor left + top               at x0.5                   ymax+0.2            pixmap width 32 heigh 32
--    paragraph .martin                        anchor left + right + top       at xmax+2                 ymin                width 26 lines 6
--    button    .martinReload linkLabel 'ReLoad Form' anchor left + top          at x0.5                 ymax                callback '!this.martin(1)' width 28
    list      .martinList   anchor left + right + top                          at x0.5      y20 callback '!!changeAttributes(' columns                      height 20 width 30
    button    .martinLinkAttribute linklabel 'Attribute'anchor left at x0.5 y30 width 6
    text      .martinAttrib   ''  anchor right + left    at xmax.martinLinkAttribute ymin.martinLinkAttribute width 25 is STRING

    button    .martinLinkValue linklabel 'Value' anchor left at x0.5 ymax.martinAttrib+0.5 width 6
    text      .martinValue   ''   anchor right + left    at xmax.martinLinkValue    ymin.martinLinkValue width 25 is STRING

--    button    .martinAttr   linkLabel 'Show Attributes' anchor left + top        at x0.5                   ymax              callback '!this.martin(2)' width 28
--    button    .martinDone   linkLabel 'Back to Top'     anchor left + top        at x0.5                   y16              callback '!this.mainTasks(true)' width 28

  exit

track |PROPCE| call |!!catSideTaskPane.auto(|
track |DESICE| call |!!catSideTaskPane.auto(|
track |PADDCE| call |!!catSideTaskPane.auto(|
track |CATACE| call |!!catSideTaskPane.auto(|


  exit

define method .catSideTaskPane()

       !!catParagon = object catParagon()

endmethod

define method .init(!action is STRING)

      pml load form !!catDisplayPLot
endmethod


define method .auto(!gadget is FORM , !action is STRING)

if (!action.eq('UNSELECT')) then
    return
endif

      var !data attlist
      !list = array()
      !list[1] = array()
      !list[2] = array()

      do !val value !data
         !list[1].append(!val)
         var !arg $!val of ce
         handle (47,15)
           !arg = 'Not Handled'
         endhandle
         !list[2].append(!arg)
      enddo

!headers[1] = 'Attribute'
!headers[2] = 'Value'
!this.martinList.setHeadings(!headers)
!this.martinList.setcolumns(!list)

endmethod
