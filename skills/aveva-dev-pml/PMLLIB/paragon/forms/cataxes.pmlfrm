--
-- Description:
-- Set value for axes height
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  catAxes()                        -                   Constructor
--  init()                           -                   Initialise form
--
------------------------------------------------------------------------
setup form !!catAxes dialog

  !this.formTitle     = 'Axes'
  !this.iconTitle     = 'Axes'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.00 $ '

  text   .axesHeight |Axes Height| tagwidth 9 width 14 is real
  button .ok         |Ok|     at xmin form ymax+0.5 width 6 ok
  button .cancel     |Cancel| at xmax form-size ymin width 6 cancel

exit
-- End of form definition for !!catAxes

------------------------------------------------------------------------
--
-- Method:      .catAxes()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .catAxes()

  -- Set initial size for axes height
  !this.axesHeight.val = 250mm

endmethod
-- End of method definition for .catAxes()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Initialise form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- No action

endmethod
-- End of method definition for .init()
