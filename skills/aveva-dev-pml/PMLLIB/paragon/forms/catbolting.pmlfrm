--
--  Description:   The PML code for the base form of the Bolting Table Utilities UI.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  catbolting()                     -                   Constructor
--  ceApply()                        -                   Bolt Utility Descriptions
--  initialise()                     -                   Initialisation
--
setup form !!catbolting dialog docking noalign

  import 'PipingTablesAddin'
  handle any
  endhandle

  -- Define .net control namespaces
  using namespace 'Aveva.Pdms.Presentation'

  !this.formTitle     = 'Bolt Table Utilities'
  !this.iconTitle     = 'Bolt Table Utilities'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.00 $ '

  -- Form members
  member .netBoltUTable      is BOLTUTILCTRL

  path down
  button .bnCe 'CE'
  para  .paCE at xmax.bnCe+1 ymin.bnCe+.25 width 35
  container .conBoltTable nobox PmlNetControl 'BoltTableUtilities' anchor left + right + bottom + top at xmin.bnCe ymax + .25 width 80 height 26
  path right
  button .bnCancel  'Dismiss'         width 8 anchor right + bottom  at xmax.conBoltTable - size ymax+0.5 CANCEL
  path left
  hdist 1
  button .bnApply   'Apply'           width 8 anchor right + bottom


  frame .fixheight panel at x0 y0 width 0.01 height 27
  exit
  frame .fixwidth panel at x0 y0 width 61 height 0.01
  exit

  !this.bnCe.callback    = |!this.ceApply()|
  !this.bnApply.callback = |!this.netBoltUTable.applyMethod()|

exit
-- End of form definition for !!catbolting

------------------------------------------------------------------------
--
-- Method:      catbolting
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .catbolting()

  using namespace 'Aveva.Pdms.Presentation'

   -- create instance of .net control
   !this.netBoltUTable = object BOLTUTILCTRL()

   -- add .net control to PML container
   !this.conBoltTable.control = !this.netBoltUTable.handle()

endmethod
-- End of method definition for .catbolting()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .initialise()

  using namespace 'Aveva.Pdms.Presentation'

  -- Check element type is valid or force error
  BLTA
  handle (2, 111)
    !!alert.error('Could not find a valid BLTA element from here')
    return error 1 noalert
  endhandle

  -- CE button
  !this.paCE.val = !!ce.flnm

  -- Bolt table
  !this.conBoltTable.visible = false
  !boltTableName             = !!ce.name

  !nds = object PTABLEBUDATASOURCE(!boltTableName)
  !this.netBoltUTable.bindToDataSource(!nds)
  !this.conBoltTable.visible = true

  endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:     ceApply
--
-- Description: Save to Database
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .ceApply()

  -- Show form for describing the description.
  !this.initialise()

  -- Reload data into current form.
  !this.netBoltUTable.reloadData()

endmethod
-- End of method definition for .ceApply

------------------------------------------------------------------------
