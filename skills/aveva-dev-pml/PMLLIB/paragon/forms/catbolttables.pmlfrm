------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  catbolttables()                  -                   Constructor
--  ceApply()                        -                   Bolt Diameter/Length Descriptions
--  getSizeRanges()                  ARRAY               Bolt Descriptions
--  initialise()                     -                   Initialisation
--
setup form !!catbolttables dialog docking noalign
  import 'PipingTablesAddin'
  handle any
  endhandle

  -- Define .net control namespaces
  using namespace 'Aveva.Pdms.Presentation'

  !this.formTitle     = 'Bolt Diameter/Length Table'
  !this.iconTitle     = 'Bolt Table'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.00 $ '

  -- Form members
  member .netBoltTable    is  BOLTTABLECTRL

  path down
  button .bnCe 'CE'
  para  .paCE at xmax.bnCe+1 ymin.bnCe+.25 width 50
  container .conBoltTable nobox PmlNetControl 'BoltTable' anchor all at xmin.bnCe ymax + .25 width 60 height 25
  path right
  button .bnCancel 'Dismiss'           anchor left  + bottom  at xmin form ymax+1 CANCEL
  button .bnSave   'Save Data to File' anchor left  + bottom  at xmax.bnCancel + 10
  button .bnApply  'Apply'             anchor right + bottom at xmax form-size ymin

  !this.bnCe.callback    = |!this.ceApply()|
  !this.bnSave.callback  = |!this.netBoltTable.csvWriter()|
  !this.bnApply.callback = |!this.netBoltTable.applyMethod()|

exit
-- End of form definition for !!catbolttables

------------------------------------------------------------------------
--
-- Method:      catbolttables
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .catbolttables()

  using namespace 'Aveva.Pdms.Presentation'

   -- create instance of .net control
   !this.netBoltTable = object BOLTTABLECTRL()

   -- add .net control to PML container
   !this.conBoltTable.control = !this.netBoltTable.handle()

endmethod
-- End of method definition for .catbolttables()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .initialise()

  using namespace 'Aveva.Pdms.Presentation'

  -- Check element type is valid or force error
  NBRWLD

  -- CE button
  !this.paCE.val = !!ce.flnm

  -- Bolt table
  !this.conBoltTable.visible = false
  !boltTableName             = !!ce.name
  !sizes                     = !this.getSizeRanges()
  !nds                       = object PTABLEBOLTDATASOURCE(!boltTableName, !sizes)
  !this.netBoltTable.bindToDataSource(!nds)
  !this.conBoltTable.visible = true

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:     ceApply
--
-- Description: Bolt Descriptions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .ceApply()

  -- Show form for describing the description.
  !this.initialise()

  -- Reload data into current form.
  !this.netBoltTable.reloadData()

endmethod
-- End of method definition for .getDescriptions()

------------------------------------------------------------------------
--
-- Method:     getSizeRanges
--
-- Description: Bolt Descriptions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .getSizeRanges() is ARRAY

  -- read the defaults file and return the array of sizes for the control.
  !file = ARRAY()

  !defFile = object FILE('%PDMSUI%\cat\dflts\bolting-defaults')

  if (!defFile.exists().not()) then
      -- File not present, use the following as defaults.
      -- Bolting Requirements File.

      !file[1] = '-- Bolt Diameters'
      !file.append('12,MM,0.1/2,INCH')
      !file.append('16,MM,0.5/8,INCH')
      !file.append('20,MM,0.3/4,INCH')
      !file.append('24,MM,0.7/8,INCH')
      !file.append('27,MM,1,INCH')
      !file.append('30,MM,1.1/8,INCH')
      !file.append('33,MM,1.1/4,INCH')
      !file.append('')
      !file.append('-- Bolt Lengths')
      !file.append('20,MM LONG,0.3/4,INCH LONG')
      !file.append('25,MM LONG,1,INCH LONG')
      !file.append('30,MM LONG,1.1/8,INCH LONG')
      !file.append('33,MM LONG,1.1/4,INCH LONG')
      !file.append('50,MM LONG,2,INCH LONG')
      !file.append('70,MM LONG,2.3/4,INCH LONG')
      !file.append('80,MM LONG,3.1/4,INCH LONG')
      !file.append('90,MM LONG,3.1/2,INCH LONG')
      !file.append('100,MM LONG,4,INCH LONG')
      !file.append('110,MM LONG,4.1/4,INCH LONG')
      !file.append('120,MM LONG,4.3/4,INCH LONG')
  else
      !file = !defFile.readfile()
  endif

  return !file

endmethod
-- End of method definition for .getSizeRanges()

------------------------------------------------------------------------
