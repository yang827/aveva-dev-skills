--
--  Description:     deal with COCDES element types, descriptions for COCO's
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  cancel()                         -                   Cancel Method.
--  catcocodescription()             -
--  define()                         -                   Navigation Method.
--  delete()                         -
--  init(BOOLEAN)                    -
--  navigate(BOOLEAN)                -                   Navigation Method.
--
------------------------------------------------------------------------
--
setup form !!catcocodescription dialog resizeable noalign

   import 'GridControl'
   handle any
   endhandle

  -- Define .net control namespaces
  using namespace 'Aveva.Pdms.Presentation'

  !this.formTitle     = 'Connection Compatibility Descriptions'
  !this.iconTitle     = 'Coco Descr'
  !this.formRevision  = ' $Revision: 1.00 $ '
  !this.cancelCall    = '!this.cancel()'
  !this.initCall      = '!this.init(FALSE)'

  -- Form members
  member .listofcocos  is ARRAY
  member .descriptions is ARRAY
  member .listrtexts   is ARRAY

  member .create       is STRING

  member .cocoTable    is DBREF
  member .startelement is DBREF

  member .navornot     is BOOLEAN

  path down
      list .cocos                              anchor l+r+t+b  at x0 y 0          width 50 height 20
      option .coco 'Connection Short Code'     anchor b+l             tagwidth 15 width 6
      text   .desc 'Description'               anchor b+r+l           tagwidth 8  width 43 is STRING
      button .apply 'Apply' anchor right + bottom at xmax form-size ymax+1
      button .delete 'Delete' anchor b at x 23 ymin
      button .cancel 'Dismiss' anchor left + bottom at xmin form ymin

  !this.cocos.callback  = |!this.navigate(TRUE)|
  !this.coco.callback   = |!this.define()|
  !this.apply.callback  = |!this.apply()|
  !this.cancel.callback = |!this.cancel()|
  !this.delete.callback = |!this.delete()|
  !this.desc.callback   = ||

  !this.create            = 'FALSE'

exit
-- End of form definition for !!catcocodescription

------------------------------------------------------------------------
--
-- Method:      constructor
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .catcocodescription()
------------------------------------------------------------------------

    !this.cocoTable = !!ce

endmethod

------------------------------------------------------------------------
--
-- Method:      initialisation
--
-- Description: init
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init(!navornot is BOOLEAN)
------------------------------------------------------------------------
-- Clear the internal lists.
   !this.listofcocos.clear()
   !this.descriptions.clear()
   !this.listrtexts.clear()

-- Remember start element.
   !this.startelement = !!ce

-- Setup the arrays.
  !columns[1] = ARRAY()
  !columns[2] = ARRAY()
  !list[1] = 'None'

-- Grab list of COCO elements defined everywhere.
  var !list split CTYPLI

  !this.coco.dtext = !list.sort()

-- Cycle round COCO's and make list that have descriptions.
   do !entry value !list.sort()

     !columns[1].append(!entry)
     var !dref split cocdref(|$!entry|)

     do !coco value !dref

        break if (!coco.eq('unset'))

         !cocon = COCONNECTION of $!coco
         !descr  = DESC OF $!coco
         !this.listofcocos.append(!cocon)
         !this.descriptions.append(!descr)
         !this.listrtexts.append(!coco)
     enddo

     -- Delete variable to clean out old data.
     !dref.delete()
  enddo

-- Now populate the list with findings.

  !headings[1] = 'Name of COCO'
  !headings[2] = 'Coco Description'

   !columns[1] = !this.listofcocos
   !columns[2] = !this.descriptions

  !this.cocos.setHeadings(!headings)
  !this.cocos.setColumns(!columns)
  !this.cocos.rtext = !this.listrtexts

-- Setup form to first element.
  !this.navigate(!navornot)

endmethod
-- End of form definition for constructor

------------------------------------------------------------------------
--
-- Method:      navigate
--
-- Description: Navigation Method.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .navigate(!nav is BOOLEAN)
------------------------------------------------------------------------
  if (!this.cocos.dtext.size() NE 0) then
   if (!nav or !!ce.type ne 'COCDES' ) then
       !!ce = !this.cocos.rtext[!this.cocos.val].dbref()
   endif

   !this.formTitle = !!ce.fullname
   !this.coco.val = !this.coco.dtext.findfirst(!!ce.coconnection)
   !this.desc.val = !!ce.desc
  endif

endmethod
-- End of form definition for navigate
------------------------------------------------------------------------
--
-- Method:      define
--
-- Description: Navigation Method.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .define()
------------------------------------------------------------------------

    if (undefined(!!catModelViews)) then
        pml load form !!catModelViews
    endif

    !coco = !this.coco.selection()
    !desc = !this.desc.val

-- Decide if we need to create a new COCDES or just nav to old one.
    if (unset(!this.listofcocos.findfirst(!coco))) then

        -- Set this flag ready for creation if the user presses the apply button.
        !this.create       = 'TRUE'
        !this.desc.val = ''

    else

        !this.cocos.val = !this.listofcocos.findfirst(!coco)
        !this.navigate(TRUE)
    endif

endmethod
-- End of form definition for navigate

------------------------------------------------------------------------
--
-- Method:      cancel
--
-- Description: Cancel Method.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()
------------------------------------------------------------------------

-- return to element we were sitting on before we came in.
!!ce = !this.startelement

-- Now kill the form.
kill !!catcocodescription

endmethod
-- End of form definition for cancel

------------------------------------------------------------------------
--
-- Method:      Apply
--
-- Description: Apply Method.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()
------------------------------------------------------------------------

-- Check current element.
   if (!!ce.type ne 'COCDES') then
       !this.navigate(TRUE)
   endif

-- Remember the position of the gadget and replace later.
   !position = !this.cocos.val

-- If the flag is set, create and set attributes.
   if (!this.create.eq('TRUE')) then

       -- Reset the flag
       !this.create = 'FALSE'

       -- This should be the coco table we were editing.
       !!ce = !this.cocoTable

       -- Create the element
          !!catModelViews.createNewElement('COCDES','none')

       -- Position will be one more than we had already.
          !position = !this.cocos.dtext.size() + 1
    elseif (!this.create.eq('CHANGE')) then

       -- Reset the flag
       !this.create = 'FALSE'

    endif

       -- Grab the settings.
       !coco = !this.coco.selection()
       !desc = !this.desc.val

        -- Now associate the references.
        COCONNECTION $!coco
         handle (41,232)
           !!alert.error('No COCO Selected, reselect COCO Association required')
           return
         endhandle
        DESCRIPTION '$!desc'

        -- Now re-populate the form with new list.
        !this.init(FALSE)

        -- Reset the position.
        !this.cocos.val = !position

        -- Reset the fields.
        !this.navigate(FALSE)

endmethod
-- End of form definition for Apply

------------------------------------------------------------------------
--
-- Method:      Delete
--
-- Description: Apply Method.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .delete()
------------------------------------------------------------------------

-- Delete the current COCDES element if required.
   !this.navigate(TRUE)

-- Confirm deletion
   !ans = !!alert.question('Ok to delete current COCDES Element')

   if (!ans.eq('YES')) then

     -- Remember where we are in the list first.
        !selection = !this.cocos.val

     -- Now we can delete one
        DELETE COCDES
          handle any
          endhandle

     -- Refresh the list.
        !this.init(TRUE)

     -- Set the list to the last position.
        !this.cocos.val = !selection
        handle (61,620)
          !this.desc.val = ''
        endhandle

   endif

endmethod
-- End of form definition for delete
