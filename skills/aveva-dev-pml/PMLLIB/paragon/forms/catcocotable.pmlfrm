--
--  Description:     Undefined
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  catcocotable()                   -                   Constructor
--  ceApply()                        -                   Coco Descriptions
--  closeForm()                      -
--  getDescriptions()                -
--  initialise()                     -                   Initialisation
--
setup form !!catcocotable dialog docking noalign
  -- Import .net control
  import 'PipingTablesAddin'
  handle any
  endhandle

  -- Define .net control namespaces
  using namespace 'Aveva.Pdms.Presentation'

  !this.formTitle     = 'Connection Compatibility Table'
  !this.iconTitle     = 'Coco Table'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.00 $ '
  !this.quitCall      = '!this.closeForm()'

  -- Form members
  member .netCocoTable    is COCOCTRL

  path down
  button .bnCe 'CE'
  para  .paCE at xmax.bnCe+1 ymin.bnCe+.25 width 50
  button .cocDes 'Create/Modify Coco Descriptions' at x 15 ymax.bnCe
  container .conCocoTable nobox PmlNetControl 'CocoTable' anchor all at xmin.bnCe ymax + .25 width 60 height 25
  button .bnCancel 'Dismiss' anchor left + bottom at xmin form ymax+1 CANCEL
  button .bnApply  'Apply' anchor right + bottom at xmax form-size ymin

  !this.cocDes.callback  = |!this.getDescriptions()|
  !this.bnCe.callback    = |!this.ceApply()|
  !this.bnApply.callback = |!this.netCocoTable.saveData()|

exit
-- End of form definition for !!catcocotable

------------------------------------------------------------------------
--
-- Method:      catcocotable
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .catcocotable()

  using namespace 'Aveva.Pdms.Presentation'

   -- create instance of .net control
   !this.netCocoTable = object COCOCTRL()

   -- add .net control to PML container
   !this.conCocoTable.control = !this.netCocoTable.handle()

endmethod
-- End of method definition for .catcocotable()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .initialise()

  using namespace 'Aveva.Pdms.Presentation'

  -- Check element type is valid or force error
  CCTA
  handle (2,111)
    -- Error has occurred, likely no the right element type.
  endhandle

  -- CE button
  !this.paCE.val = !!ce.flnm

  -- Coco table
  !this.conCocoTable.visible = false
  !cocoTableName             = !!ce.name
  !nds                       = object PTABLECOCODATASOURCE(!cocoTableName)
  !this.netCocoTable.bindToDataSource(!nds)
  !this.conCocoTable.visible = true

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:     getDescriptions
--
-- Description: Coco Descriptions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .getDescriptions()

  -- Show form for describing the description.
  show !!catcocodescription

endmethod
-- End of method definition for .getDescriptions()

------------------------------------------------------------------------
--
-- Method:     ceApply
--
-- Description: Coco Descriptions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .ceApply()

  -- Show form for describing the description.
  !this.initialise()

  -- Reload data into current form.
  !this.netCocoTable.reloadData()
  handle any
    -- Likely the wrong element type, so alert here.
    !!alert.error(!!error.text & ' Wrong element type selected.')
  endhandle

endmethod
-- End of method definition for .getDescriptions()

------------------------------------------------------------------------

--
-- Method:      closeForm
--
-- Description:
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .closeForm()

  if(!!alert.confirm('OK to close this form').boolean())then
    return
  else
    return error 1
  endif

endmethod
-- End of method definition
