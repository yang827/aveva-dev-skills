------------------------------------------------------------------------
--
-- Method:      .selectAll()
--
-- Description: selects all views in the list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectAll(!menu is MENU, !selected is STRING)

  -- Select all entries on appropriate list
  if (!menu eq !this.selTabListPop) then
    !this.selTabViews.select('RTEXT', !this.selTabViews.rtext)
  elseif (!menu eq !this.specListPop) then
    !this.specViews.select('RTEXT', !this.specViews.rtext)
  elseif (!menu eq !this.modelListPop) then
    !this.modelViews.select('RTEXT', !this.modelViews.rtext)
  elseif (!menu eq !this.partListPop) then
    !this.partViews.select('RTEXT', !this.partViews.rtext)
  endif
  !this.setupMenus()

endmethod
-- End of method definition for .selectAll()
