-- Created:         Thu Jan 25 11:46:15 BST 2007
--
-- Description:
-- Control form for cats and specs views
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  catControl()                     -                   Constructor
--  initialise()                     -                   Initialisation for form
--  removeModelView()                -                   Remove selected entries
--  removePartView()                 -                   Remove selected entries
--  removeSelTabView()               -                   Remove selected entries
--  removeSpecView()                 -                   Remove selected entries
--  select(GADGET,STRING)            -                   Select/Unselect entry
--  selectAll(MENU,STRING)           -                   selects all views in the list
--  setupMenus()                     -                   Set up menus for form
--
------------------------------------------------------------------------
setup form !!catControl dialog dock

  !this.formTitle     = 'View Control'
  !this.iconTitle     = 'Control'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.00 $ '

  frame .tabset tabset anchor all

    -- Selection Table views
    frame .selTabViewFrame |Selection Tables| anchor all at x1 y1.5
      list .selTabViews anchor all multiple width 25 height 6
      path down
      button .selTabViewCreate   |Create|      anchor bottom+left width 5
      path right
      button .selTabViewDelete   |Delete|      anchor bottom+left width 5
      button .selTabViewSettings |Settings...| anchor bottom+left width 8
    exit

    -- Spec views
    frame .specViewFrame |Specs| anchor all at x1 y1.5
      list .specViews anchor all multiple width 25 height 6
      path down
      button .specViewCreate   |Create|      anchor bottom+left width 5
      path right
      button .specViewDelete   |Delete|      anchor bottom+left width 5
      button .specViewSettings |Settings...| anchor bottom+left width 8
    exit

    -- Model views
    frame .modelViewFrame |Models| anchor all at x1 y1.5
      list .modelViews anchor all multiple width 25 height 6
      path down
      button .modelViewCreate   |Create|      anchor bottom+left width 5
      path right
      button .modelViewDelete   |Delete|      anchor bottom+left width 5
      button .modelViewSettings |Settings...| anchor bottom+left width 8
    exit

    -- Part views
    frame .partViewFrame |Parts| anchor all at x1 y1.5
      list .partViews anchor all multiple width 25 height 6
      path down
      button .partViewCreate   |Create|      anchor bottom+left width 5
      path right
      button .partViewDelete   |Delete|      anchor bottom+left width 5
      button .partViewSettings |Settings...| anchor bottom+left width 8
    exit

  exit

exit
-- End of form definition for !!catControl

------------------------------------------------------------------------
--
-- Method:      .catControl()
--
-- Description: Constructor
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .catControl()

  -- Callbacks
  !this.selTabViews.callback         = |!this.select(|
  !this.selTabViewDelete.callback    = |!this.removeSelTabView()|
  !this.selTabViewCreate.callback    = |!!catSelTabViews.add()|
  !this.selTabViewSettings.callback  = ||
  !this.specViews.callback           = |!this.select(|
  !this.specViewDelete.callback      = |!this.removeSpecView()|
  !this.specViewCreate.callback      = |!!catSpecViews.add()|
  !this.specViewSettings.callback    = ||
  !this.modelViews.callback          = |!this.select(|
  !this.modelViewDelete.callback     = |!this.removeModelView()|
  !this.modelViewCreate.callback     = |!!catModelViews.add()|
  !this.modelViewSettings.callback   = ||
  !this.partViews.callback           = |!this.select(|
  !this.partViewDelete.callback      = |!this.removePartView()|
  !this.partViewCreate.callback      = |!!catPartViews.add()|
  !this.partViewSettings.callback    = ||

  -- List popup menus
  !menu = !this.newMenu(|SelTabListPop|)
  !menu.add(|CALLBACK|, |Select All|, |!this.selectAll(|, |selectAll|)
  !menu.add(|SEPARATOR|)
  !menu.add(|CALLBACK|, |Delete|, |!this.removeSelTabView()|, |deleteSelection|)
  !this.selTabViews.setPopup(!menu)
  !menu = !this.newMenu(|specListPop|)
  !menu.add(|CALLBACK|, |Select All|, |!this.selectAll(|, |selectAll|)
  !menu.add(|SEPARATOR|)
  !menu.add(|CALLBACK|, |Delete|, |!this.removeSpecView()|, |deleteSelection|)
  !this.specViews.setPopup(!menu)
  !menu = !this.newMenu(|modelListPop|)
  !menu.add(|CALLBACK|, |Select All|, |!this.selectAll(|, |selectAll|)
  !menu.add(|SEPARATOR|)
  !menu.add(|CALLBACK|, |Delete|, |!this.removeModelView()|, |deleteSelection|)
  !this.modelViews.setPopup(!menu)
  !menu = !this.newMenu(|partListPop|)
  !menu.add(|CALLBACK|, |Select All|, |!this.selectAll(|, |selectAll|)
  !menu.add(|SEPARATOR|)
  !menu.add(|CALLBACK|, |Delete|, |!this.removePartView()|, |deleteSelection|)
  !this.partViews.setPopup(!menu)

endmethod
-- End of method definition for .catControl()

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: Initialisation for form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  -- Populate the selection table view list
  !selTabViews     = ARRAY()
  !selTabViewForms = ARRAY()
  do !i indices !!catSelTabViews.selTabViews
    !selTabViews[!i]     = !!catSelTabViews.selTabViews[!i].formTitle
    !selTabViewForms[!i] = !!catSelTabViews.selTabViews[!i].string()
  enddo
  !selTabViews.compress()
  !selTabViewForms.compress()
  !this.selTabViews.dtext = !selTabViews
  !this.selTabViews.rtext = !selTabViewForms

  -- Populate the spec view list
  !specViews     = ARRAY()
  !specViewForms = ARRAY()
  do !i indices !!catSpecViews.specViews
    !specViews[!i]     = !!catSpecViews.specViews[!i].formTitle
    !specViewForms[!i] = !!catSpecViews.specViews[!i].string()
  enddo
  !specViews.compress()
  !specViewForms.compress()
  !this.specViews.dtext = !specViews
  !this.specViews.rtext = !specViewForms

  -- Populate the model view list
  !modelViews     = ARRAY()
  !modelViewForms = ARRAY()
  do !i indices !!catModelViews.modelViews
    !modelViews[!i]     = !!catModelViews.modelViews[!i].formTitle
    !modelViewForms[!i] = !!catModelViews.modelViews[!i].string()
  enddo
  !modelViews.compress()
  !modelViewForms.compress()
  !this.modelViews.dtext = !modelViews
  !this.modelViews.rtext = !modelViewForms

  -- Populate the part view list
  !partViews     = ARRAY()
  !partViewForms = ARRAY()
  do !i indices !!catPartViews.partViews
    !partViews[!i]     = !!catPartViews.partViews[!i].formTitle
    !partViewForms[!i] = !!catPartViews.partViews[!i].string()
  enddo
  !partViews.compress()
  !partViewForms.compress()
  !this.partViews.dtext = !partViews
  !this.partViews.rtext = !partViewForms

  -- Setup menu
  !this.setupMenus()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      .setupMenus()
--
-- Description: Set up menus for form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setupMenus()

  -- Make delete options inactive if lists empty
  !active = !this.selTabViews.selection().empty().not()
  !this.selTabListPop.setFieldProperty(|deleteSelection|, 'ACTIVE', !active)
  !this.selTabViewDelete.active = !active
  !active = !this.specViews.selection().empty().not()
  !this.specListPop.setFieldProperty(|deleteSelection|, 'ACTIVE', !active)
  !this.specViewDelete.active = !active
  !active = !this.modelViews.selection().empty().not()
  !this.modelListPop.setFieldProperty(|deleteSelection|, 'ACTIVE', !active)
  !this.modelViewDelete.active = !active
  !active = !this.partViews.selection().empty().not()
  !this.partListPop.setFieldProperty(|deleteSelection|, 'ACTIVE', !active)
  !this.partViewDelete.active = !active

endmethod
-- End of method definition for .setupMenus()

------------------------------------------------------------------------
--
-- Method:      .select()
--
-- Description: Select/Unselect entry
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      List gadget
--    2   R      STRING      Select/Unselect
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .select(!list is GADGET, !selected is STRING)

  -- Initialise Variables
  !form   = !list.owner()
  !entry  = !list.pickedField

  -- Show form
  if (!selected eq |SELECT|) then
    !formString = |!!| & !list.rtext[!entry]
    !form       = $!<formString>
    if(!form.shown().not()) then
      !form.show(|FREE|)
    endif
  endif

  -- Setup menu
  !this.setupMenus()

endmethod
-- End of method definition for .select(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      removeSelTabView
--
-- Description:
--   Remove selected entries
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeSelTabView()

  -- Entry must be selected
 !entries = !this.selTabViews.selection('RTEXT')
  if(!entries.size() eq 0) then
    return error 1 |No entry selected|
  endif

  -- Remove each form
  do !i indices !entries
    !formString = '!!' & !entries[!i]
    !form       = $!<formString>
    if (defined(!form)) then
      !!catSelTabViews.remove(!form)
    endif
  enddo

endmethod
-- End of method definition for .removeSelTabView()

