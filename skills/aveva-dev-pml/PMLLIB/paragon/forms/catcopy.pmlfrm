------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addRemoveRefs()                  -                   add or remove references from the grid
--  addToCopyFrom(STRING)            -                   Add elements to the copy from grid
--  addToCopyTo()                    -                   Add elements to the copy to grid
--  applyCopy()                      -                   apply the copy commands
--  catCopy()                        -                   Constructor
--  copyFromRightClick(ARRAY)        -                   Add
--  copyFromRightClickActive(BOOLEAN) -                   Set Grid pop-up active control
--  copyToRightClick(ARRAY)          -                   Add
--  explorerRightClick(ARRAY)        -                   Add
--  findReferences()                 -                   find the references of selected types
--  initialise()                     -                   Initialise form
--  locationRightClick(ARRAY)        -                   set up location grid popup
--  locationRightClickActive(BOOLEAN) -                   Set Grid pop-up active control
--  removeAllFromGrid()              -                   remove all items from the grid
--  removeFromGrid()                 -
--  setCopyLocation(STRING)          -                   set the copy location
--  setNames()                       -                   Change the names in the copy to Grid
--  updateButtons()                  -                   update the add and remove buttons
--  updateExplorerSelection(ARRAY)   -                   Selection of new element updates the current selected element member
--  updateLocation()                 -                   update the location grid
--  updateLocationButtons(ARRAY)     -                   update the location buttons
--  validateCopyToGrid()             -                   validate the grid for names and locations
--

import 'GridControl'
handle any
endhandle
import 'ExplorerAddin'
handle any
endhandle

-- Define form
setup form !!catCopy resize
using namespace 'Aveva.Pdms.Presentation'

   -- Form members
   member .copyFromGrid      is NETGRIDCONTROL
   member .copyToGrid        is NETGRIDCONTROL
   member .locationGrid      is NETGRIDCONTROL
   member .catalogueExplorer is PMLEXPLORERCONTROL
   member .element           is DBREF
   member .copyFrom          is ARRAY
   member .copyTo            is ARRAY
   member .locations         is ARRAY
   member .refTypes          is ARRAY
   member .refs              is ARRAY
   member .copySyntax        is ARRAY

  frame .optionsFrame |Copy Options| at x 0 y 0 anchor t+l height 7
    path down
    frame .nameOptionsFrame |Name| anchor t+l
      rToggle .sameName tagwid 8 |Same Name|
      rToggle .prepend  tagwid 8 |Prefix   |
      path right
      text .prefix width 20 is STRING
    exit
    toggle .references |Include References| at xmin.sameName ymax+0.5
    path right
    button .btnUpdate 'Update' at xmax.prefix-size tooltip 'Update' width 8
  exit

  frame .locationFrame |Copy To Location|  at xmax.optionsFrame+3.5 ymin.optionsFrame anchor t+l+r width 46 height 7
    -- PML Container to host Grid control
    container .netLocationFrame nobox pmlNetControl dock fill
  exit

  button .setLocationSelected pixmap at xmax+0.5 ymin.locationFrame+2 anchor t+r width 16 height 16
  path down
  button .setLocationAll pixmap anchor t+r width 16 height 16

  container .explorerFrame nobox pmlNetControl 'NET' at xmin.optionsFrame ymax.locationFrame+0.5 anchor t+l+b  width.optionsFrame height 20

  path right
    button .addCe pixmap at xmax+0.5 ymin.explorerFrame+3 width 16 height 16
    path down
    button .addCeMem pixmap width 16 height 16
    button .remPicked pixmap width 16 height 16
    button .remAll pixmap width 16 height 16
  path right

  frame .copyFromFrame |Copy From|  at xmin.locationFrame ymin.explorerFrame anchor t+l+r width 50 height 10
  -- PML Container to host Grid control
    container .netCopyFromFrame nobox pmlNetControl dock fill
  exit
  frame .copyToFrame |Copy To| at xmin.copyFromFrame ymax.copyFromFrame anchor ALL width 50 height 10
  -- PML Container to host Grid control
    container .netCopyToFrame nobox pmlNetControl dock fill
  exit

  button .apply 'Apply' at xmax.copyToFrame-9-size ymax+0.25 anchor r+b tooltip 'Apply Copy' width 8
  button .dismiss 'Dismiss' at xmax+.2 ymin anchor r+b tooltip 'Dismiss' width 8 cancel

menu .pmlPopupAdd
  !this.pmlPopupAdd.add( 'CALLBACK', 'Add Element to Copy From', '!this.addToCopyFrom(|ELEMENT|)','element' )
  !this.pmlPopupAdd.add( 'CALLBACK', 'Add Members to Copy From', '!this.addToCopyFrom(|MEMBERS|)','members' )
menu .copyFromPopup
  !this.copyFromPopup.add( 'CALLBACK', 'Remove Selected Rows', '!this.removeFromGrid()', 'Remove')
  !this.copyFromPopup.add('separator')
  !this.copyFromPopup.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.copyFromGrid, ||, |Save As|)', 'EXCEL' )
  !this.copyFromPopup.add( 'callback', 'Print Preview...', '!this.copyFromGrid.printpreview()', 'PRINT' )
menu .copyToPopup
  !this.copyToPopup.add( 'CALLBACK', 'Set Copy Location from Explorer', '!this.setCopyLocation(|EXPLORER|)', 'explorer' )
  !this.copyToPopup.add( 'CALLBACK', 'Set Copy Location from Copy To Location', '!this.setCopyLocation(|LOCATION|)', 'location' )
  !this.copyToPopup.add('separator')
  !this.copyToPopup.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.copyToGrid, ||, |Save As|)', 'EXCEL' )
  !this.copyToPopup.add( 'callback', 'Print Preview...', '!this.copyToGrid.printpreview()', 'PRINT' )
menu .locationPopup
  !this.locationPopup.add( 'CALLBACK', 'Set Copy Location for Selected Copy To Elements', '!this.setCopyLocation(|SELECTED|)', 'selected' )
  !this.locationPopup.add( 'CALLBACK', 'Set Copy Location for All Copy To Elements', '!this.setCopyLocation(|ALL|)', 'ALL' )
  !this.locationPopup.add('separator')
  !this.locationPopup.add( 'callback', 'Export to Excel...', '!!exportToExcel(!this.locationGrid, ||, |Save As|)', 'EXCEL' )
  !this.locationPopup.add( 'callback', 'Print Preview...', '!this.locationGrid.printpreview()', 'PRINT' )

exit


-- End of form definition for !!catCopy

------------------------------------------------------------------------
--
-- Method:      catCopy
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .catCopy()

   using namespace 'Aveva.Pdms.Presentation'

  !this.catalogueExplorer = object PMLEXPLORERCONTROL()
  -- Add Net controls to PML containers
  !this.explorerFrame.control = !this.catalogueExplorer.handle()
  !this.catalogueExplorer.addeventhandler('OnSelectionChanged', !this, 'updateExplorerSelection')
  !this.catalogueExplorer.addeventhandler('OnPopup', !this, 'explorerRightClick')

  -- Add instances of Grid control
  !this.copyFromGrid = object NETGRIDCONTROL()
  !this.copyToGrid = object NETGRIDCONTROL()
  !this.locationGrid = object NETGRIDCONTROL()

  -- Add Grid controls to PML containers
  !this.netCopyFromFrame.control = !this.copyFromGrid.handle()
  !this.netCopyToFrame.control = !this.copyToGrid.handle()
  !this.netLocationFrame.control = !this.locationGrid.handle()

   -- add PML event handlers to Grid control
   !this.copyFromGrid.addeventhandler('OnPopup', !this, 'copyFromRightClick')
   !this.copyToGrid.addeventhandler('AfterSelectChange', !this, 'updateLocationButtons')
   !this.copyToGrid.addeventhandler('OnPopup', !this, 'copyToRightClick')
   !this.locationGrid.addeventhandler('OnPopup', !this, 'locationRightClick')
   !this.locationGrid.addeventhandler('AfterSelectChange', !this, 'updateLocationButtons')

  -- add callbacks
  !this.sameName.callback = '!this.setNames()'
  !this.prepend.callback = '!this.setNames()'
  !this.prefix.callback = '!this.setNames()'
  !this.references.callback = '!this.addRemoveRefs()'
  !this.btnUpdate.callback = '!this.addRemoveRefs()'
  !this.addCe.callback = '!this.addToCopyFrom(|ELEMENT|)'
  !this.addCeMem.callback = '!this.addToCopyFrom(|MEMBERS|)'
  !this.remPicked.callback = '!this.removeFromGrid()'
  !this.remAll.callback = '!this.removeAllFromGrid()'
  !this.setLocationSelected.callback = '!this.setCopyLocation(|SELECTED|)'
  !this.setLocationAll.callback = '!this.setCopyLocation(|ALL|)'
  !this.apply.callback = '!this.applyCopy()'

  -- Set pixmaps
  !this.addCe.addPixmap(!!pml.getPathName('addce16.png'))
  !this.addCeMem.addPixmap(!!pml.getPathName('detaildirectory.png'))
  !this.remPicked.addPixmap(!!pml.getPathName('leftarrow16.png'))
  !this.remAll.addPixmap(!!pml.getPathName('leftleftarrow16.png'))
  !this.setLocationSelected.addPixmap(!!pml.getPathName('downarrow16.png'))
  !this.setLocationAll.addPixmap(!!pml.getPathName('downdownarrow16.png'))

  -- Set tooltips
  !this.addCe.setToolTip ('Add Explorer Element')
  !this.addCeMem.setToolTip ('Add Explorer Element Members')
  !this.remPicked.setToolTip ('Remove Selected Rows')
  !this.remAll.setToolTip ('Remove All Rows')
  !this.setLocationSelected.setToolTip ('Set Copy To Location to Selected Entities in Copy To')
  !this.setLocationAll.setToolTip ('Set Location of All Entities in Copy To')

  !this.formTitle = 'Catalogue Copy'
  !this.iconTitle = 'cataCopy'
  !this.initcall  = '!this.initialise()'
  !this.catalogueExplorer.initialise('Catalogue','/*','')

  !this.refTypes = ARRAY()
  !this.refTypes.append('SFIT')
  !this.refTypes.append('SPRF')
  !this.refTypes.append('SCOM')


endmethod

-- End of method definition for .catCopy()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  using namespace  'Aveva.Pdms.Presentation'


  -- Set parameters
  !this.copyFromGrid.columnExcelFilter(FALSE)
  !this.copyFromGrid.outlookGroupStyle(FALSE)
  !this.copyFromGrid.fixedHeaders(FALSE)
  !this.copyFromGrid.headerSort(FALSE)
  !this.copyFromGrid.fixedRows(FALSE)
  !this.copyFromGrid.columnSummaries(FALSE)
  !this.copyFromGrid.singleRowSelection(FALSE)

  !this.copyToGrid.columnExcelFilter(FALSE)
  !this.copyToGrid.outlookGroupStyle(FALSE)
  !this.copyToGrid.fixedHeaders(FALSE)
  !this.copyToGrid.headerSort(FALSE)
  !this.copyToGrid.fixedRows(FALSE)
  !this.copyToGrid.columnSummaries(FALSE)
  !this.copyToGrid.singleRowSelection(FALSE)

  !this.locationGrid.columnExcelFilter(FALSE)
  !this.locationGrid.outlookGroupStyle(FALSE)
  !this.locationGrid.fixedHeaders(FALSE)
  !this.locationGrid.headerSort(FALSE)
  !this.locationGrid.fixedRows(FALSE)
  !this.locationGrid.columnSummaries(FALSE)
  !this.locationGrid.singleRowSelection(TRUE)

  -- Clear any existing data
  !this.copyFromGrid.clearGrid()
  !this.copyToGrid.clearGrid()
  !this.locationGrid.clearGrid()

  !this.copyFrom.clear()
  !this.copySyntax.clear()
  !this.copyTo.clear()
  !this.locations.clear()
  !this.refs.clear()
  !this.sameName.val = FALSE
  !this.prepend.val = TRUE
  !project = current project
  !this.prefix.val = !project.code()
  !this.prefix.active = TRUE

  !this.references.active = FALSE
  !this.btnUpdate.active = FALSE

  !this.addCe.active = FALSE
  !this.addCeMem.active = FALSE
  !this.remPicked.active = FALSE
  !this.remAll.active = FALSE
  !this.setLocationSelected.active = FALSE
  !this.setLocationAll.active = FALSE
  !this.apply.active = FALSE


endmethod

-- End of method definition for .initialise()


------------------------------------------------------------------------
--
-- Method:      explorerRightClick
--
-- Description: Add
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .explorerRightClick(!data is ARRAY)

	!this.element = !data[2].dbref()
	!element      = !this.element
	!showPopup = FALSE
	-- Only allow items from Read only databases
	if (!element.dbwrite.not()) then
		-- Only allow top level elements members to be copied
	  -- only allow items to be added if they have the same owner type as items
	  -- already added to the grid
			if (!this.copyFromGrid.getRows().size() eq 0 ) then
			  !showPopup = TRUE
			  !type = 'all'
			  if (!element.owner.type eq 'WORL') then
			    !type = 'members'
			  endif
			else
			  !ownerType = !this.copyFromGrid.getRows()[1][3]
			  if (!ownerType eq !element.owner.type) then
			    !showPopup = TRUE
			    !type = 'element'
			  elseif (!ownerType eq !element.type) then
			    !showPopup = TRUE
			    !type = 'members'
			  endif
			endif
    endif

  if (!showPopup) then
    if (!type eq 'all') then
  	  !this.pmlPopupAdd.setFieldProperty('element','VISIBLE',TRUE)
  	  !this.pmlPopupAdd.setFieldProperty('members','VISIBLE',TRUE)
    elseif (!type eq 'element') then
  	  !this.pmlPopupAdd.setFieldProperty('element','VISIBLE',TRUE)
  	  !this.pmlPopupAdd.setFieldProperty('members','VISIBLE',FALSE)
  	elseif (!type eq 'members') then
  	  !this.pmlPopupAdd.setFieldProperty('element','VISIBLE',FALSE)
  	  !this.pmlPopupAdd.setFieldProperty('members','VISIBLE',TRUE)
  	endif
    !this.explorerFrame.popup = !this.pmlPopupAdd
    !this.explorerFrame.showPopup(!data[0], !data[1])
  endif

endmethod
-- End of method definition for .explorerRightClick()


------------------------------------------------------------------------
--
-- Method:      addToCopyFrom
--
-- Description: Add elements to the copy from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING       Option for adding element or members
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addToCopyFrom(!option is STRING)

  using namespace  'Aveva.Pdms.Presentation'

  -- Set headings
  !headings = ARRAY()
  !headings.append('Name')
  !headings.append('Type')
  !headings.append('Type of Owner')
  !tableName = 'Copy From'

  !grid = !this.copyFromGrid.getRows()

  !reference = !this.references.active

  if (!option eq 'ELEMENT') then
    !element = !this.element
    if (!this.copyFrom.findFirst(!element).unset()) then
      !this.copyFrom.append(!element)
      !add = TRUE
    else
      !add = FALSE
    endif
    if (!add) then
      !row = ARRAY()
      !row.append(!element.fullname)
      !row.append(!element.type)
      if (!reference.not()) then
        if (!this.refTypes.findFirst(!element.type).set()) then
          !reference = TRUE
        endif
      endif
      !row.append(!element.owner.type)
      !grid.append(!row)
    endif
  elseif (!option eq 'MEMBERS') then
    !members = !this.element.members
    do !element values !members
      if (!this.copyFrom.findFirst(!element).unset()) then
        !this.copyFrom.append(!element)
        !add = TRUE
      else
        !add = FALSE
      endif
      if (!add) then
        !row = ARRAY()
        !row.append(!element.fullname)
        !row.append(!element.type)
        if (!reference.not()) then
          if (!this.refTypes.findFirst(!element.type).set()) then
            !reference = TRUE
          endif
        endif
        !row.append(!element.owner.type)
        !grid.append(!row)
      endif
    enddo
  elseif (!option eq 'REFERENCES') then
    !refs = !this.refs
    do !element values !refs
      if (!this.copyFrom.findFirst(!element).unset()) then
        !this.copyFrom.append(!element)
        !add = TRUE
      else
        !add = FALSE
      endif
      if (!add) then
        !row = ARRAY()
        !row.append(!element.fullname)
        !row.append(!element.type)
        if (!reference.not()) then
          if (!this.refTypes.findFirst(!element.type).set()) then
            !reference = TRUE
          endif
        endif
        !row.append(!element.owner.type)
        !grid.append(!row)
      endif
    enddo
  endif


  !nds = object NETDATASOURCE(!tableName, !headings, !grid)
  !this.copyFromGrid.bindToDataSource(!nds)
  !this.copyFromGrid.setNameColumnImage()
  !this.addToCopyTo()

  if (!reference) then
    !this.references.active = TRUE
    if (!this.references.val) then
      !this.btnUpdate.active = TRUE
    else
      !this.btnUpdate.active = FALSE
    endif
  else
    !this.references.active = FALSE
    !this.btnUpdate.active = FALSE
  endif

  !this.updateButtons()
  !this.updateLocation()

endmethod
------------------------------------------------------------------------
--
-- Method:      addToCopyTo
--
-- Description: Add elements to the copy to grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addToCopyTo()

  using namespace  'Aveva.Pdms.Presentation'

  -- Set headings
  !headings = ARRAY()
  !headings.append('Copy To Name')
  !headings.append('Copy To')
  !tableName = 'Copy To'

  !grid = !this.copyFromGrid.getRows()
  !originalCopyTo = !this.copyTo
  !this.copyTo = ARRAY()

  !toGrid = ARRAY()
  !index = 1

  do !names values !grid
    !row = ARRAY()
    if (!this.sameName.val) then
      !row.append(!names[1])
    elseif(!this.prepend.val) then
      !newName = !names[1]
      !newName = '/' & !this.prefix.val & '-' & !names[1].after('/')
      !row.append(!newName)
    endif

    if (!originalCopyTo.size() ge !index and defined(!originalCopyTo[!index]) and !originalCopyTo[!index].set()) then
      !row.append(!originalCopyTo[!index].name)
      !this.copyTo.append(!originalCopyTo[!index])
    else
      !row.append('unset')
      !this.copyTo.append(object DBREF())
    endif
    !toGrid.append(!row)
    !index = (!index + 1)
  enddo
  !nds = object NETDATASOURCE(!tableName, !headings, !toGrid)
  !this.copyToGrid.bindToDataSource(!nds)

  !this.validateCopyToGrid()

endmethod

------------------------------------------------------------------------
--
-- Method:      setNames
--
-- Description: Change the names in the copy to Grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setNames()

  if (!this.prepend.val) then
    !prefix = !this.prefix.val.replace(' ','')
    !this.prefix.val = !prefix
    if (!this.prefix.val eq '') then
      !!alert.warning('The prefix can not be empty. Reverting to default prefix')
      !project = current project
      !this.prefix.val = !project.code()
    endif
    !this.prefix.active = TRUE
  else
    !this.prefix.active = FALSE
  endif

  !this.addToCopyTo()

endmethod
------------------------------------------------------------------------
--
-- Method:      copyFromRightClick
--
-- Description: Add
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copyFromRightClick(!data is ARRAY)

  !this.copyFromRightClickActive(!this.copyFromGrid.getRows().size() gt 0)

-- show the pop-up
  !this.netCopyFromFrame.popup = !this.copyFromPopup
  !this.netCopyFromFrame.showPopup(!data[0], !data[1])

endmethod
------------------------------------------------------------------------
--
-- Method:      copyFromRightClickActive
--
-- Description: Add
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .copyFromRightClickActive(!active is BOOLEAN)

  !this.copyFromPopup.setFieldProperty('Remove', 'active', !active)
  !this.copyFromPopup.setFieldProperty('EXCEL', 'active', !active)
  !this.copyFromPopup.setFieldProperty('PRINT' , 'active', !active)


endmethod
------------------------------------------------------------------------
--
-- Method:      copyToRightClick
--
-- Description: Add
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .copyToRightClick(!data is ARRAY)
  if (!this.copyFromGrid.getRows().size() gt 0) then
	  !type = !this.copyFromGrid.getRows()[1][3]
	  !element = !this.element
	  !rowTags = !this.locationGrid.getSelectedRowTags()
	  if (!rowTags.set()) then
	    !location = !this.locations[!rowTags[1].real()]
	  else
	    !location = object DBREF()
	  endif

	  if (!element.dbwrite and !element.type eq !type) then
	  	!this.copyToPopup.setFieldProperty('explorer','active',TRUE)
	  else
	  	!this.copyToPopup.setFieldProperty('explorer','active',FALSE)
	  endif
	  if(!location.set()) then
	  	!this.copyToPopup.setFieldProperty('location','active',TRUE)
	  else
	  	!this.copyToPopup.setFieldProperty('location','active',FALSE)
	  endif
	
	  !this.copyToPopup.setFieldProperty('EXCEL','active',TRUE)
		!this.copyToPopup.setFieldProperty('PRINT','active',TRUE)
	else
		!this.copyToPopup.setFieldProperty('explorer','active',FALSE)
		!this.copyToPopup.setFieldProperty('location','active',FALSE)
		!this.copyToPopup.setFieldProperty('EXCEL','active',FALSE)
		!this.copyToPopup.setFieldProperty('PRINT','active',FALSE)
		
	endif

  !this.netCopyToFrame.popup = !this.copyToPopup
  !this.netCopyToFrame.showPopup(!data[0], !data[1])

endmethod
------------------------------------------------------------------------
--
-- Method:      locationRightClick
--
-- Description: set up location grid popup
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Popup position and reference(s) of selected element(s)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .locationRightClick(!data is ARRAY)

  !this.locationRightClickActive(!this.locationGrid.getRows().size() gt 0)

-- show the pop-up
  !this.netLocationFrame.popup = !this.locationPopup
  !this.netLocationFrame.showPopup(!data[0], !data[1])

endmethod
------------------------------------------------------------------------
--
-- Method:      locationRightClickActive
--
-- Description: Set Grid pop-up active control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .locationRightClickActive(!active is BOOLEAN)

  !this.locationPopup.setFieldProperty('Selected', 'active', !active)
  !this.locationPopup.setFieldProperty('ALL', 'active', !active)
  !this.locationPopup.setFieldProperty('EXCEL' , 'active', !active)
  !this.locationPopup.setFieldProperty('PRINT' , 'active', !active)


endmethod
------------------------------------------------------------------------
--
-- Method:      removFromGrid
--
-- Description: remove elements from the copy from grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING       Option for adding element or members
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeFromGrid()

  using namespace  'Aveva.Pdms.Presentation'

  -- Set headings
  !headings = ARRAY()
  !headings.append('Name')
  !headings.append('Type')
  !headings.append('Type of Owner')
  !tableName = 'Copy From'

  !grid = !this.copyFromGrid.getRows()

  !tags = !this.copyFromGrid.getSelectedRowTags()
  -- remove any references
  do !index index !tags
    !item = !this.copyFromGrid.getRows()[!tags[!index].real()][1].dbref()
    !number = !this.refs.findFirst(!item)
    if (!number.set()) then
      !this.refs.deleteFrom(!number,1)
    endif
    !number = !this.copyFrom.findFirst(!item)
    if (!number.set()) then
      !this.copyFrom.deleteFrom(!number,1)
    endif
  enddo
  !this.refs.compress()

  do !index index !tags
    !grid.deleteFrom(!tags[!index].real(),1)
  enddo
  !grid.compress()

  -- update the cataFrom member
  !this.copyFrom.clear()
  do !element values !grid
    !this.copyFrom.append(!element[1].dbref())
  enddo

  !nds = object NETDATASOURCE(!tableName, !headings, !grid)
  !this.copyFromGrid.bindToDataSource(!nds)
  !this.copyFromGrid.setNameColumnImage()

    -- Set headings for the copy to grid
  !headings = ARRAY()
  !headings.append('Copy To Name')
  !headings.append('Copy To')
  !tableName = 'Copy To'

  !grid = !this.copyToGrid.getRows()

  do !index index !tags
    !grid.deleteFrom(!tags[!index].real(),1)
    !this.copyTo.deleteFrom(!tags[!index].real(),1)
  enddo
  !grid.compress()
  !this.copyTo.compress()

  !nds = object NETDATASOURCE(!tableName, !headings, !grid)
  !this.copyToGrid.bindToDataSource(!nds)

  if (!grid.size() eq 0 ) then
    !this.references.active = FALSE
    !this.btnUpdate.active = FALSE
    !this.references.val = FALSE
  endif

  !this.addToCopyTo()
  !this.updateButtons()
  !this.updateLocation()

endmethod
------------------------------------------------------------------------
--
-- Method:      updateExplorerSelection
--
-- Description: Selection of new element updates the current selected element member
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateExplorerSelection(!data is ARRAY)
  using namespace  'Aveva.Pdms.Presentation'

  !this.element=!data[0].dbref()
  !this.updateButtons()
endmethod

-- End of method definition for .updateExplorerSelection()
------------------------------------------------------------------------
--
-- Method:      setCopyLocation
--
-- Description: set the copy location
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setCopyLocation(!option is STRING)

  !validIcon  = !!pml.getPathName('valid12.png')
  !location = object DBREF()

  if (!option eq 'ALL') then
    -- select all the rows in the copy to grid
    !rowArray = ARRAY()
    !rows=!this.copyToGrid.getRows().size()
    do !index to !rows
      !rowArray.append(!index)
    enddo
    !this.copyToGrid.setSelectedRowTags(!rowArray)
  endif

  !tags = !this.copyToGrid.getSelectedRowTags()

  if (!option eq 'EXPLORER') then
    !location = !this.element
  else
  	if (!this.locationGrid.getSelectedRows().size() gt 0) then
    	!location = !this.locations[!this.locationGrid.getSelectedRowTags()[1].real()]
    endif
  endif

	if (not !location.badref()) then
	  do !rowTag value !tags
	    !index = !rowTag.real()
	    !this.copyToGrid.setCellValue(!index, 2, !location.name)
	    !this.copyTo[!index] = !location
	  enddo
	  !this.validateCopyToGrid()
	endif

endmethod

-- End of method definition for .setCopyLocation()
------------------------------------------------------------------------
--
-- Method:      validateCopyToGrid
--
-- Description: validate the grid for names and locations
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .validateCopyToGrid()

  !this.copySyntax.clear()
  !validIcon  = !!pml.getPathName('valid12.png')
  !failedIcon = !!pml.getPathName('failed12.png')

  -- Highlight any unset locations
  !grid = !this.copyToGrid.getRows()

  do !index index !grid
    -- Does the new name exist in the target database
    !toName = !grid[!index][1].dbref()
    handle (2,109) $* Item does not exist
      !this.copyToGrid.setCellImage(!index, 1, !validIcon)
      !validTo = TRUE
      !newName = !grid[!index][1]
      !copyString = ''
    elsehandle NONE
      --Does the item exist in a read only DB as this is OK
      if (!toName.dbwrite) then
        !this.copyToGrid.setCellImage(!index, 1, !failedIcon)
        !validTo = FALSE
        !newName = !grid[!index][1]
        !copyString = 'ERROR ' & !toName.name & ' already exists in the target databases '
      else
        !validTo = TRUE
        !this.copyToGrid.setCellImage(!index, 1, !validIcon)
        !newName = !grid[!index][1]
        !copyString = ''
      endif
    endhandle
    -- Check the location is set
    !location = !this.copyTo[!index]
    if (!location.unset()) then
      !this.copyToGrid.setCellImage(!index, 2, !failedIcon)
      !validLocation = FALSE
      !copyString = !copyString & 'ERROR location is unset'
    else
      !this.copyToGrid.setCellImage(!index, 2, !validIcon)
      !validLocation = TRUE
    endif

    if (!this.sameName.val) then
      !option = ' SAMENAME '
--      !fromName = !newName
    else
      !prefix = !this.prefix & '-'
      !option = ' PREPEND /' & !prefix
--      !fromName = !newName.replace(!prefix,'',1,1)
    endif
    !fromName = !this.copyFrom[!index]
    !sequence = !fromName.sequ.string()
    !owner    = !fromName.owner.string()

    if (!validTo and !validLocation) then
      !copyString = 'COPY MEM ' & !sequence & ' OF ' & !owner & !option & ' TO ' & !location
      !this.apply.active = TRUE
    endif

    !this.copySyntax.append(!copyString)

  enddo

endmethod

-- End of method definition for .validateCopyToGrid()

------------------------------------------------------------------------
--
-- Method:      findReferences
--
-- Description: find the references of selected types
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .findReferences()

  !grid = !this.copyFromGrid.getRows()
  !elements = ARRAY()

  do !index index !grid
    !elements.append(!grid[!index][1].dbref())
  enddo

  !find = object COLLECTION()
  !find.scope(!elements)
  !find.types(!this.refTypes)
  !results = !find.results()

  -- Find all ptrefs
  !ptre = object BLOCK('!results[!evalIndex].ptre')
  !ptreNames = !results.evaluate(!ptre)
  handle (2,201)
  -- Item does not have a ptre
    !ptreNames = ARRAY()
  elsehandle NONE
    !ptreNames.unique()
  endhandle

  -- Find all gmrefs
  !gmre = object BLOCK('!results[!evalIndex].gmre')
  !gmreNames = !results.evaluate(!gmre)
  handle (2,201)
  -- Item does not have a gmre
    !gmreNames = ARRAY()
  elsehandle NONE
    !gmreNames.unique()
  endhandle

  -- Find all ngmrefs
  !ngmre = object BLOCK('!results[!evalIndex].ngmre')
  !ngmreNames = !results.evaluate(!ngmre)
  handle (2,201)
  -- Item does not have a ngmre
    !ngmreNames = ARRAY()
  elsehandle NONE
    !ngmreNames.unique()
  endhandle

  -- Find all dtrefs
  !dtre = object BLOCK('!results[!evalIndex].dtre')
  !dtreNames = !results.evaluate(!dtre)
  handle (2,201)
  -- Item does not have a dtre
    !dtreNames = ARRAY()
  elsehandle NONE
    !dtreNames.unique()
  endhandle

  -- Find all pstrefs
  !pstr = object BLOCK('!results[!evalIndex].pstr')
  !pstrNames = !results.evaluate(!pstr)
  handle (2,201)
  -- Item does not have a pstr
    !pstrNames = ARRAY()
  elsehandle NONE
    !pstrNames.unique()
  endhandle

  -- Find all gstrefs
  !gstr = object BLOCK('!results[!evalIndex].gstr')
  !gstrNames = !results.evaluate(!gstr)
  handle (2,201)
  -- Item does not have a gstr
    !gstrNames = ARRAY()
  elsehandle NONE
    !gstrNames.unique()
  endhandle

  -- Find all blfarrays
  !blrfArray = object BLOCK('!results[!evalIndex].blrfArray')
  !blrfArrayNames = !results.evaluate(!blrfArray)
  handle (2,201)
    !blrfNames = ARRAY()
  elsehandle NONE
    !blrfNames = ARRAY()
    do !index1 index !blrfArrayNames
      do !index2 index !blrfArrayNames[!index1]
        !blrfNames.append(!blrfArrayNames[!index1][!index2])
      enddo
    enddo
    !blrfNames.unique()
  endhandle

  !references = ARRAY()
  !references.appendArray(!ptreNames)
  !references.appendArray(!gmreNames)
  !references.appendArray(!ngmreNames)
  !references.appendArray(!dtreNames)
  !references.appendArray(!pstrNames)
  !references.appendArray(!gstrNames)
  !references.appendArray(!blrfNames)

  -- Find out if the references are already in the copy from grid
  !newElements = ARRAY()
  do !ref values !references
    if (!this.copyFrom.findFirst(!ref).set()) then
      skip
    else
      if (badref(!ref)) then
        skip
      else
        !newElements.append(!ref)
      endif
    endif
  enddo

  !this.refs.appendArray(!newElements)
  !this.refs.unique()

endmethod

-- End of method definition for .findReferences()

------------------------------------------------------------------------
--
-- Method:      addRemoveRefs
--
-- Description: add or remove references from the grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addRemoveRefs()

  if (!this.references.val) then
  	!numberRefs = !this.refs.size()
  	-- find any new references and add them to the grid
    !this.findReferences()
    if (!this.refs.size() gt !numberRefs) then
      !this.addToCopyFrom('REFERENCES')
    endif
    !this.btnUpdate.active = TRUE
  else
    -- remove the refs from the grid
    -- select them in the grid first
    !grid = !this.copyFromGrid.getRows()
    do !index index !grid
      !item = !grid[!index][1].dbref()
      if (!this.refs.findFirst(!item).set()) then
        !this.copyFromGrid.selectRow(!index)
      endif
    enddo
    !this.removeFromGrid()
    !this.btnUpdate.active = FALSE

  endif

endmethod

-- End of method definition for .addRemoveRefs()
------------------------------------------------------------------------
--
-- Method:      removeAllFromGrid
--
-- Description: remove all items from the grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .removeAllFromGrid()

  !rowArray = ARRAY()
  !rows=!this.copyFromGrid.getRows().size()
  do !index to !rows
    !rowArray.append(!index)
  enddo
  !this.copyFromGrid.setSelectedRowTags(!rowArray)
  !this.removeFromGrid()
endmethod

-- End of method definition for .removeAllFromGrid()
------------------------------------------------------------------------
--
-- Method:      updateButtons
--
-- Description: update the add and remove buttons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateButtons()

  !element     = !this.element
	!showAddButtons = FALSE
	-- Only allow items from Read only databases
	if (!element.dbwrite.not()) then
		-- Do not allow items from specs to be copied
		!hlis = !element.hlis
		if (!hlis.findFirst('SPWL').unset()) then
			-- only allow items to be added if they have the same owner type as items
			-- already added to the grid
			if(!element eq /* ) then
				!showAddButtons = FALSE
			elseif (!this.copyFromGrid.getRows().size() eq 0 ) then
			  !showAddButtons = TRUE
			  !type = 'all'
			else
			  !ownerType = !this.copyFromGrid.getRows()[1][3]
			  if (!ownerType eq !element.owner.type) then
			    !showAddButtons = TRUE
			    !type = 'element'
			  elseif (!ownerType eq !element.type) then
			    !showAddButtons = TRUE
			    !type = 'members'
			  endif
			endif
    endif
  endif

  if (!showAddButtons) then
    if (!type eq 'all') then
  	  !this.addCe.active = TRUE
  	  !this.addCeMem.active = TRUE
    elseif (!type eq 'element') then
  	  !this.addCe.active = TRUE
  	  !this.addCeMem.active = FALSE
  	elseif (!type eq 'members') then
  	  !this.addCe.active = FALSE
  	  !this.addCeMem.active = TRUE
  	endif
  else
    !this.addCe.active = FALSE
  	!this.addCeMem.active = FALSE
  endif

  if (!this.copyFrom.size() eq 0 ) then
    !this.remPicked.active = FALSE
    !this.remAll.active = FALSE
  else
    !this.remPicked.active = TRUE
    !this.remAll.active = TRUE
  endif

endmethod

-- End of method definition for .updateButtons()
------------------------------------------------------------------------
--
-- Method:      updateLocationButtons
--
-- Description: update the location buttons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateLocationButtons(!data is ARRAY)

  !locationSize = !this.locationGrid.getSelectedRows().size()
  !copyToSize   = !this.copyToGrid.getSelectedRows().size()

  if (!locationSize eq 0 ) then
    !this.setLocationSelected.active = FALSE
    !this.setLocationAll.active = FALSE
    --!this.apply.active = FALSE
  else
    if (!copyToSize eq 0 ) then
      !this.setLocationSelected.active = FALSE
      !this.setLocationAll.active = TRUE
      --!this.apply.active = FALSE
    else
      !this.setLocationSelected.active = TRUE
      !this.setLocationAll.active = TRUE
    endif
  endif

  if (!copyToSize eq 0) then
 		!this.apply.active = FALSE
 	else
 		!this.apply.active = TRUE
 	endif

endmethod

-- End of method definition for .updateLocationButtons()
------------------------------------------------------------------------
--
-- Method:      updateLocation
--
-- Description: update the location grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateLocation()

  using namespace  'Aveva.Pdms.Presentation'

  -- Set headings
  !headings = ARRAY()
  !headings.append('Name')
  !headings.append('Type')
  !tableName = 'Location'
  if (!this.copyFrom.size() eq 0 ) then
    -- Clear the location grid of items
    !grid = ARRAY()
    !nds = object NETDATASOURCE(!tableName, !headings, !grid)
    !this.locationGrid.bindToDataSource(!nds)
    !this.locations.clear()

  else
    -- Populate the grid of not already populated
    if (!this.locationGrid.getRows().size() eq 0 ) then
      -- Collect all the items that can be written to
      !type = !this.copyFromGrid.getRows()[1][3]
      !find = object COLLECTION()
      !find.type(!type)
      !find.filter(object EXPRESSION(|DBWRITE|))
      !items = !find.results()
      !grid = ARRAY()
      do !index index !items
        !this.locations.append(!items[!index])
        !row = ARRAY()
        !row.append(!items[!index].name)
        !row.append(!items[!index].type)
        !grid.append(!row)
      enddo

      !nds = object NETDATASOURCE(!tableName, !headings, !grid)
      !this.locationGrid.bindToDataSource(!nds)

    endif
  endif

endmethod
-- End of method definition for .updateLocationButtons()
------------------------------------------------------------------------
--
-- Method:      applyCopy
--
-- Description: apply the copy commands
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .applyCopy()

  !copy = TRUE
  do !index index !this.copySyntax
    if (!this.copySyntax[!index].matchwild('ERROR*')) then
      !answer = !!alert.confirm('Copy commands contain errors and will not copy everything. Do you wish to continue?')
      if (!answer.boolean()) then
        !copy = TRUE
      else
        !copy = FALSE
      endif
      break
    endif
  enddo

  if (!copy) then
    -- make up a file name
    var !unique unique
    !fileName = |%pdmsuser%/| & !unique
    !file = object FILE(!fileName)
    !copySyntax = ARRAY()
    !copySyntax.append('COPY START')
    do !index index !this.copySyntax
      if (!this.copySyntax[!index].matchwild('ERROR*')) then
        skip
      else
        !copySyntax.append(!this.copySyntax[!index])
      endif
    enddo
    !copySyntax.append('COPY END')
    !file.writeFile('OVERWRITE',!copySyntax)
    !!runMacro(!fileName,'')

    handle any
      copy end
      !!alert.error(!!error.text)
    endhandle

    !file.delete()
    !this.initialise()
  endif

endmethod
