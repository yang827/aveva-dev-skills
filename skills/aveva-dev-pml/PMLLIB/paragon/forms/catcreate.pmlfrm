    -- Read defaults file for list of purpose flags.
    !read  = object FILE('%PDMSUI%/CAT/dflts/room-design-defaults')
    do !x value !read.readfile()
      skip if (!x.match('--') ne 0)
      skip if (!x eq '')

      !split = !x.split('/')
      !primaryDList.append(!split[1])
      !primaryRList.append(!x.substring(!x.match('/')))
    enddo

    !this.priType.dtext = !primaryDList
    !this.priType.rtext = !primaryRList

  endif

  -- Setup check
  !this.setupDone = FALSE

