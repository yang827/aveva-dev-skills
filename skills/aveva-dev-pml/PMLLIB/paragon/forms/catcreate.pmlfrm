------------------------------------------------------------------------
--
-- Method:      .setup()
--
-- Description: Setup form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element type to be created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setup(!type is STRING)

  -- Add check for ROOM Design here instead of ACCO.
  if (!!appCntrl.currentApp eq 'ACCO') then
    !this.currentApp = 'ROOM'
  else
    !this.currentApp = !!appCntrl.currentApp
  endif

  -- Setup form for new type to be created
  !typeWords = !type.split()
  !this.type = !typeWords[1]
  if (!typeWords.size() gt 1) then
    !this.purposeType = !typeWords[2]
  else
    !this.purposeType = object STRING()
  endif

  !this.purpose.val = 1

  if (!!catRoomDesign) then

    !longType         = !this.longTypes[!this.elementTypes.findfirst(!type)]
    !this.formTitle   = |Create | & !longType

    -- Setup the purpose pulldown to be as set by menu options.
    if (!this.purpose.dtext.findfirst(!this.type).unset()) then
      -- Unset Variable
      -- Try looking for discipline setting.
      if (!this.purpose.dtext.findfirst(!this.currentApp).unset().not()) then
        !this.purpose.val = !this.purpose.dtext.findfirst(!this.currentApp)
      endif
    else
      !this.purpose.val = !this.purpose.dtext.findfirst(!this.type)
    endif

  else

    -- Add check for BRTAB and RADU or BRAN Definition.
    if (!this.purposeType eq 'REDU') then
      !longType = |Reducer | & !this.longTypes[!this.elementTypes.findfirst(!this.type)]
    elseif (!this.purposeType eq 'BRAN') then
      !longType = |Branch | & !this.longTypes[!this.elementTypes.findfirst(!this.type)]
    elseif (!this.purposeType.eq('TAPP')) then
      !longType = |Branch | & !this.longTypes[!this.elementTypes.findfirst(!this.type)]
    else
      !longType = !this.longTypes[!this.elementTypes.findfirst(!this.type)]
    endif

    if (!this.type eq 'STCA' and !this.purposeType eq 'STORAGE') then
      !this.formTitle   = |Create Structural Storage Area|
    elseif (!this.purposeType eq 'HIER') then
      !this.formTitle   = |Create Part Hierarchy|
    else
      !this.formTitle   = |Create | & !longType
    endif

    -- Setup the purpose pulldown to be as set by menu options.
    if (!this.purpose.dtext.findfirst(!this.purposeType).unset()) then
      -- Unset Variable
      -- Try looking for discipline setting.

      -- Test for Room Design, slightly different here.
      if (!!catRoomDesign) then
        !this.purpose.val = !this.purpose.dtext.findfirst('ROOM')
      else
        if (!this.purpose.dtext.findfirst(!this.currentApp).unset().not()) then
          !this.purpose.val = !this.purpose.dtext.findfirst(!this.currentApp)
        else
          -- Try to see if current PURP is available to be used.
          !this.purpose.val =  !this.purpose.dtext.findfirst(!!ce.purp)
          handle any
          endhandle
        endif
      endif
    else
      !this.purpose.val = !this.purpose.dtext.findfirst(!this.purposeType)
    endif

  endif

  !this.storage.visible = TRUE

  -- Check specific conditions for various setup modes.
  if (!this.type eq 'STCA' and !this.purposeType eq 'STORAGE') then
    -- Grey out storage area toggle.
    !this.storage.visible = FALSE
  endif

  -- Mark setup as done
  !this.setupDone = true

endmethod
-- End of method definition for .setup(STRING)

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Initialise form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()
  ------------------------------------------------------------------------

  -- Check that name is ok first, if unnamed then just use type.
  if (!!ce.namn.substring(1,1) eq '=') then
    !this.name.val = !this.type
    !testname = '/' & !this.name.val
    !dbname = !testname.dbref()
    handle (2,109)
    elsehandle none
      -- Name already exists
      do !x from 1 to 100
        !newName = !testname & !x
        !test = !newName.dbref()
        handle (2,109)
          !this.name.val = !newName.substring(2)
          break
        endhandle
      enddo
    endhandle
  else

    -- We can fill in the first bit by copying the current element name.
    !this.name.val = !!ce.namn & '.' & !this.type
    handle any
    endhandle

    -- Check to see if the first part of the name is *.
    if (!this.name.val.substring(1,2) EQ '*.') then
      !this.name.val = !this.name.val.substring(3) & '1'
    endif

    -- Check name and see if it already exists.
    !testname = '/' & !this.name.val
    !dbname = !testname.dbref()
    handle (2,109)
    elsehandle none
      -- Name already exists
      do !x from 1 to 100
        !newName = !testname & !x
        !test = !newName.dbref()
        handle (2,109)
          !this.name.val = !newName.substring(2)
          break
        endhandle
      enddo
    endhandle

  endif

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .catCE()
--
-- Description: Set form CE
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .catCE()

  -- Validate CE and rebuild high level list
  !this.addSessionArea(!!ce)

  -- Run callback as if user had selected CE in list
  !this.highArea(!this.highArea, |SELECT|)

endmethod
-- End of method definition for .catCE()

------------------------------------------------------------------------
--
-- Method:      .purpose()
--
-- Description: Set Combo settings.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .purpose(!gadget is GADGET, !action is STRING)

  if (!action EQ 'VALIDATE') then

    !text = !gadget.displayText().replace(' ','_')
    if (!text.length() GT 4) then
      !!alert.warning('Purpose character length is limited to 4 characters, it will be truncated')
    endif

    !this.purposeText = !text

  elseif (!action EQ 'SELECT') then

    !this.purposeText = !gadget.selection()

  endif

endmethod
-- End of method definition for .purpose()

------------------------------------------------------------------------
--
-- Method:      .highArea()
--
-- Description: Set high level storage area
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .highArea(!gadget is GADGET, !action is STRING)

  -- Action on user typing text in combo
  if (!action eq |VALIDATE|) then

    -- Validate name and rebuild high level list
    !name = !!checkName(!gadget.displayText().trim(), |OLD|)
    if (!name.set()) then
      !this.addSessionArea(!name.dbref())
    endif

  endif

  -- Action on user typing or selecting in combo
  if (!action inset (|VALIDATE|, |SELECT|)) then

    -- Ignore selection of prompt to type text and only do if low level list is active
    if (!this.highArea.selection() ne !this.defaultHighArea) then

      -- For other types list members of low level storage area that are appropriate type
      do !element values !this.highArea.selection().dbref().members
        if (!element.list.findfirst(!this.type).set()) then
          !row = ARRAY()
          !row[1] = !element.type
          !row[2] = !element.namn
          !this.lowLevelRows.append(!row)
          !rtext.append(!element.ref.string())
        endif
      enddo

    endif

    -- Populate list
    !this.lowArea.setRows(!this.lowLevelRows)
    !this.lowArea.rtext = !rtext

    -- If a low level storage area was found then select it
    if (!this.lowLevelArea.set()) then
      if (!this.lowLevelArea.badref().not()) then
        if (!this.highArea.selection().dbref().members.findfirst(!this.lowLevelArea).set()) then
          !this.lowArea.select(|Rtext|, !this.lowLevelArea.ref.string())
        endif
      endif
    endif

  endif

  -- Activate ok button
  !this.ok.active = (!this.highArea.selection() ne !this.defaultHighArea)

endmethod
-- End of method definition for .highArea(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      .addSessionArea()
--
-- Description: Add storage area entered during session
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element added during session
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addSessionArea(!element is DBREF)

  -- Check that element is appropriate for type of thing to be created
  if (!element.type ne !this.highLevelType) then
    return error 1 |$!<this.highLevelType> required|
  endif

  -- Find element in session list or add it
  !elePos = !this.sessionAreas.findfirst(!element)
  if (!elePos.unset()) then
    !this.sessionAreas.append(!element)
    !elePos = !this.sessionAreas.size()
  endif

endmethod
-- End of method definition for .addSessionArea(DBREF)

------------------------------------------------------------------------
--
-- Method:      .buildHighArea()
--
-- Description: Build high level storage area list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .buildHighArea()

  -- Build list of high level areas
  !dtext = ARRAY()
  !rtext = ARRAY()
  !dtext.append(!this.defaultHighArea)
  !rtext.append(!this.defaultHighArea)
  do !element values !this.sessionAreas
    if (!element.badref().not()) then
      if (!element.type eq !this.highLevelType) then
        !dtext.append(!element.namn)
        !rtext.append(!element.ref.string())
      endif
    endif
  enddo

endmethod
-- End of method definition for .buildHighArea()

------------------------------------------------------------------------
--
-- Method:      .lowArea()
--
-- Description: Set low level storage area
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .lowArea(!gadget is GADGET, !action is STRING)

  -- Ignore unselect action
  if (!action eq |SELECT|) then

    -- Special case for PRTELEs which can be nested
    if (!this.type eq |PRTELE|) then

      -- Retrieve list data
      !rtext       = !gadget.rtext
      !startIndex  = !gadget.val
      !element     = !gadget.selection().dbref()
      !indentLevel = !this.indentLevel[!startIndex]

      -- Check if selected row can be expanded and has not already been expanded
      if (!this.isExpandable(!startIndex, !element)) then

        -- Check for relevant members
        !index = !startIndex
        do !member values !element.members
          if (!this.isListable(!member)) then

            -- Initialise row
            !index = !index + 1
            !row = ARRAY()

            -- Set indent
            !this.indentLevel[!index] = !indentLevel + 1
            !totalIndent = ||
            do !this.indentLevel[!index]
              !totalIndent = !totalIndent & !this.indent
            enddo

            -- Build row for member
            !this.expandable[!index] = TRUE
            if (!this.isExpandable(!member)) then
              !row[1] = !totalIndent & | + | & !member.type
            else
              !row[1] = !totalIndent & !this.indent & !member.type
              !this.expandable[!index] = FALSE
            endif
            !row[2] = !member.namn
            !this.lowLevelRows.insert(!index, !row)
            !rtext.insert(!index, !member.ref.string())

          endif
        enddo

        -- Populate list
        !this.lowArea.setRows(!this.lowLevelRows)
        !this.lowArea.rtext = !rtext

        -- Store flag so this row cannot be expanded again
        !this.expandable[!startIndex] = FALSE

        -- Select row that has just been expanded
        !this.lowArea.val = !startIndex

      endif
    endif

  endif

endmethod
-- End of method definition for .lowArea(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      .isListable()
--
-- Description: Determine if element should be included in low level list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be checked
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if can be listed
--
------------------------------------------------------------------------
define method .isListable(!element is DBREF) is BOOLEAN

  -- Looking for PRTELE that does not have GPART members
  !listable = FALSE
  if (!element.type eq |PRTELE|) then
    !listable = TRUE
    do !member values !element.members
      !listable = (!listable and !member.type ne |GPART|)
    enddo
  endif
  return !listable

endmethod
-- End of method definition for .isListable(DBREF) is BOOLEAN

------------------------------------------------------------------------
--
-- Method:      .isExpandable()
--
-- Description: Determine if low level list row can be expanded
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to be checked
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if can be expanded
--
------------------------------------------------------------------------
define method .isExpandable(!element is DBREF) is BOOLEAN

  -- Looking for PRTELE members that themselves do not have GPART members
  !expandable = FALSE
  do !member values !element.members
    !expandable = (!expandable or !this.isListable(!member))
  enddo
  return !expandable

endmethod
-- End of method definition for .isExpandable(DBREF) is BOOLEAN

------------------------------------------------------------------------
--
-- Method:      .isExpandable()
--
-- Description: Determine if low level list row can be expanded
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Index into expandable member array
--    2   R      DBREF       Element to be checked
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if can be expanded
--
------------------------------------------------------------------------
define method .isExpandable(!index is REAL, !element is DBREF) is BOOLEAN

  -- Special case for PRTELEs which can be nested
  return (!this.isExpandable(!element) and !this.expandable[!index])

endmethod
-- End of method definition for .isExpandable(REAL, DBREF) is BOOLEAN

------------------------------------------------------------------------
--
-- Method:      .namingOption()
--
-- Description: Callback on naming option
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .namingOption()

  -- Deactivate name if autonaming is selected
  !this.name.active = !this.namingOption.selection('RTEXT').boolean().not()

endmethod
-- End of method definition for .namingOption()

------------------------------------------------------------------------
--
-- Method:      .nameValidate()
--
-- Description: Check entered name
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .nameValidate()

  -- Check name

  -- Check for special characters in names.
  if (!this.name.val.match('|') NE 0 OR !this.name.val.match(|'|) NE 0 OR !this.name.val.match(|$$|) NE 0) then
    !ans = !!alert.error('Special characters are not allowed in names')
    !temp = !this.name.val.replace('|','').replace(|'|,'').replace(|$$|,'')
    !this.name.val = !temp
    return
  endif
  !saveName = !this.name.val.replace(' ','_')

  if (!this.name.val.trim() eq ||) then
    !this.name.val = |unset|
  else
    -- change spaces to underscores first if present.
    !name = !!checkName(!this.name.val.replace(' ','_'), |NEW|)

    -- Check for Slash as first character.
    if (!saveName.substring(1,1) eq '/' or !saveName.substring(1,1) eq '=') then
      !this.name.val = !saveName
    else
      !this.name.val = '/' & !saveName
    endif

    -- Check for when name exists, and user may want to know where it is.
    if (unset(!name)) then

      -- Check to see if user wants to check this element out.
      !ans = !!alert.question('Navigate to this element')
      if (!ans EQ 'YES') then
        $!this.name.val
      elseif (!ans eq 'NO') then
        -- Add number to end of the existing name to get a unique name.
        do !i from 1 to 10000
          !newName = !this.name.val & !i
          !test = !newName.dbref()
          handle (2,109)
            !this.name.val = !newName
            break
          endhandle
        enddo
      endif

    endif
  endif

endmethod
-- End of method definition for .nameValidate()

------------------------------------------------------------------------
--
-- Method:      .apply()
--
-- Description: Apply form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  if (!!catRoomDesign) then
    !this.roomCreateApply()
    return
  endif

  -- Check if type can be created
  --  if (!!catRefData.canCreate(!this.type).not()) then
  --    return error 1 noalert
  --  endif

  -- Check to see if we can create this combination.
  if (!this.type eq 'BRTAB' AND not !this.purposeType INSET('BRAN' , 'REDU' , 'PTAP')) then
    !!alert.error(|BRTAB has an invalid purpose, you must set the purpose to 'BRAN','REDU' or 'PTAP'|)
    return
  endif

  -- Set name/autoname flag
  !name = !this.name.val.trim()
  if (!name eq |unset|) then
    -- Allow unnamed
    !name = object STRING()
  else
    -- Check name again as not cleared when checked (to allow user to modify bad name)
    !name = !!checkName(!this.name.val, |NEW|)
    if (!name.unset()) then
      return error 1 noalert
    endif

    -- Remove Spaces from Name.
    !name = !name.replace(' ','_')
    handle any
    endhandle

  endif

  -- Special cases element creation
  if (!this.type eq |TABGRO|) then

    -- Create selection table
    !selTab = object SELECTIONTABLE()

    -- Check for auto name option
    if (!name eq |AUTONAME|) then
      !name = !!namOpt.nameString(!!ce, STRING(), false, false)
      if (!name.unset()) then
        !!alert.warning('Unable to autoname element, set the relevant attribute for the autoname rule and then use "Utilities>Autoname>CE only".')
      else
        !selTab.createTable(!name)
        !selTab.selTable.sptype = !this.currentApp
        !selTab.selTable.purp = !this.purpose.displayText()
      endif
    else
      !selTab.createTable(!name)
      !selTab.selTable.sptype = !this.currentApp
      !selTab.selTable.purp = !this.purpose.displayText()
    endif

    -- As a special case, override the SPTYPE for tables containing steel fixings
    if (!selTab.selTable.purp eq 'STFX') then
      !selTab.selTable.sptype = 'STFX'
    endif

    -- Show new selection table form
    !!catSelTabViews.add()

  elseif (!this.type eq |SPEC|) then
    if (!name.set() and !name.empty().not()) then
      -- Navigate to current SpecWorld, if not spec will created at first CATA DB in list.
      new spec $!name question TYPE
      handle ANY
        SPWL
        handle any
        endhandle
        !dbpos = !!ce

        speconmode
        !!ce = !dbpos

        new specification $!name
        handle any
        exit
        return error 1 |$!!<error.text>|
      endhandle
    exit
  endhandle
else
  return error 1 |Unable to create specification because no name was specified!|
endif

elseif (!this.type eq |NOMTAB|) then
  NEW NOMTAB
  handle (41,8)
    !!alert.error(!!error.text)
    return
  endhandle
  if (!name.set() and !name.empty().not()) then
    NAME $!name
    handle any
    endhandle
  endif

elseif (!this.type eq |WTHTAB|) then
  NEW WTHTAB
  handle (41,8)
    !!alert.error(!!error.text)
    return
  endhandle
  if (!name.set() and !name.empty().not()) then
    NAME $!name
    handle any
    endhandle
  endif

elseif (!this.type eq |PDATAB|) then
  NEW PDATAB
  handle (41,8)
    !!alert.error(!!error.text)
    return
  endhandle
  if (!name.set() and !name.empty().not()) then
    NAME $!name
    handle any
    endhandle
  endif
elseif (!this.type eq |BRTAB|) then
  NEW BRTAB
  handle (41,8)
    !!alert.error(!!error.text)
    return
  endhandle
  if (!name.set() and !name.empty().not()) then
    NAME $!name
    handle any
    endhandle
  endif

elseif (!this.type eq |ROOM|) then
  -- Special case for Room Design.
  NEW $!this.purposeType
  if (!name.set() and !name.empty().not()) then
    NAME $!name
    handle any
    endhandle
  endif

elseif (!this.type EQ |PRTELE|) then
  NEW PRTELE
  if (!name.set()) then
    NAME $!name
    handle any
    endhandle
  endif

elseif (!this.type inset(|CATE|, |STCA|)) then

  !!catModelViews.create(!name, !this.purposeType)
  handle (41,8)
    !!alert.error(!!error.text)
    !oldname = !this.name.val
    show !!catCreate
    !this.name.val = !oldname
    return
  endhandle
else

  -- General case element creation ($!this.type)
  NEW $!<this.type>
  handle (41,8)
    !!alert.error(!!error.text)
    !oldname = !this.name.val
    show !!catCreate
    !this.name.val = !oldname
    return
  elsehandle any
    !!alert.error(!!error.text)
    return
  endhandle

  if (!name.set()) then
    NAME $!name
  endif

endif

!purp = !this.purpose.displayText()
PURPOSE $!purp
handle any
endhandle

-- Special cases for post create action
if (!this.type eq |PRTELE|) then

  if (not !this.purposeType.unset()) then

    -- Check to see if we actually need to show the form.
    if (!this.purposeType ne 'HIER') then
      !!catPartViews.add()
    endif
  endif

elseif (!this.type eq |DRSSET|) then
  !this.form = !!catdrsset
  handle (2,751)
    pml load form !!catdrsset
    !this.form = !!catdrsset
  endhandle

elseif (!this.type eq |SPEC|) then
  !!catSpecViews.add()
elseif (!this.type eq |NOMTAB|) then
  !!catSpecViews.add()
elseif (!this.type eq |WTHTAB|) then
  !!catSpecViews.add()
elseif (!this.type eq |PDATAB|) then
  !!catSpecViews.add()
elseif (!this.type eq |BRTAB|) then
  !!catSpecViews.add()
elseif (!this.type eq |SLOTAB|) then

  !this.form = !!slopeElement
  handle (2,751)
    pml load form !!slopeElement
    !this.form = !!slopeElement
  endhandle

elseif (!this.type eq |CCTA|) then

  !this.form = !!catCocoTable
  handle (2,751)
    pml load form !!catCocoTable
    !this.form = !!catCocoTable
  endhandle

elseif (!this.type eq |NBRWLD|) then

  !this.form = !!catBoltTables
  handle (2,751)
    pml load form !!catBoltTables
    !this.form = !!catBoltTables
  endhandle

elseif (!this.type eq |BLTA|) then

  !this.form = !!catBolting
  handle (2,751)
    pml load form !!catBolting
    !this.form = !!catBolting
  endhandle

endif

-- Show hidden or just to show new form.
if (!this.form.set()) then
  hide !!catCreate
  !this.form.show()
endif

-- Now kill the form.
kill !!catCreate

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      .roomCreateApply()
--
-- Description: Apply form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .roomCreateApply()

  if (!this.priType.val eq 1) then
    !!alert.error(|Please select create type from pull down|)
    return
  endif

  -- Set name/autoname flag
  !name = !this.name.val.trim()
  if (!name eq |unset|) then
    -- Allow unnamed
    !name = object STRING()
  else
    -- Check name again as not cleared when checked (to allow user to modify bad name)
    !newName = !!checkName(!this.name.val, |NEW|)
    if (!newName.unset()) then
      return error 1 noalert
    endif
  endif

  -- Remove Spaces from Name.
  !namNoSpace = !name.replace(' ','_')

  -- Remove first Slash if present.
  if (!namNoSpace.substring(1,1) EQ '/') then
    !namNoSpace = !namNoSpace.substring(2)
  endif

  -- Special cases element creation
  !!catModelViews.create(!name, !this.purposeType, !this.priType.selection().split('/'),!this.priType.selection('DTEXT'))
  handle (41,8)
    !!alert.error(!!error.text)
    !oldname = !this.name.val
    show !!catCreate
    !this.name.val = !oldname
    return
  endhandle

  -- Set the purpose now.
  !purp = !this.purpose.displayText()
  PURPOSE $!purp
  handle any
  endhandle

  -- Show hidden or just to show new form.
  if (!this.form.set()) then
    !this.form.show()
  endif

  -- Now hide the form.
  kill !!catCreate

endmethod
-- End of method definition for .roomCreateApply()

------------------------------------------------------------------------
--
-- Method:      .cancel()
--
-- Description: Cancel form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cancel()

  -- Reset form if defined.
  if (!this.form.set()) then
    !this.form.show()
  endif

  -- Hide form.
  kill !!catCreate

endmethod
-- End of method definition for .cancel()
