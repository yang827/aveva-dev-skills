-- Created:         Mon Mar 20 17:46:15 BST 2007
--
-- Description:
-- Create catalogue hierarchy
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addSessionArea(DBREF)            -                   Add storage area entered during session
--  apply()                          -                   Apply form
--  buildHighArea()                  -                   Build high level storage area list
--  cancel()                         -                   Cancel form
--  catCE()                          -                   Set form CE
--  catCreate()                      -                   Constructor
--  highArea(GADGET,STRING)          -                   Set high level storage area
--  init()                           -                   Initialise form
--  isExpandable(DBREF)              BOOLEAN             Determine if low level list row can be expanded
--  isExpandable(REAL,DBREF)         BOOLEAN             Determine if low level list row can be expanded
--  isListable(DBREF)                BOOLEAN             Determine if element should be included in low level list
--  lowArea(GADGET,STRING)           -                   Set low level storage area
--  nameValidate()                   -                   Check entered name
--  namingOption()                   -                   Callback on naming option
--  purpose(GADGET,STRING)           -                   Set Combo settings.
--  roomCreateApply()                -                   Apply form
--  setup(STRING)                    -                   Setup form
--
------------------------------------------------------------------------
setup form !!catCreate at xr .2 yr .2 resize

  !this.formTitle     = 'Create'
  !this.iconTitle     = 'Create'
  !this.callback      = '!this.init()'
  !this.cancelcall    = '!this.cancel()'
  !this.formRevision  = ' $Revision: 1.00 $ '

  if (!!catRoomDesign) then
    option .priType |Create Type|  anchor left+right+top at x 1 ymin        tagwidth 9 width 30
    text   .name    |       Name|  anchor left+right+bottom at x 1 ymax+0.5 tagwidth 9 width 32 string
  else
    text   .name    |       Name|  anchor left+right+bottom at x 1 ymin     tagwidth 9 width 32 string
  endif

  combo  .purpose   |    Purpose|              anchor left+right+bottom at x 1 ymax+0.5 tagwidth 9 width 30
  toggle .storage   |Use Defined Storage Area| anchor left+right+bottom at x 1 ymax+0.5

  button .ok        |OK|     anchor left+bottom  at xmin form ymax+0.5  width 6
  button .cancel    |Cancel| anchor right+bottom at xmax form-size ymin width 6

  -- Setup check
  member .setupDone         is BOOLEAN

  -- Default combo string
  member .defaultPurpose    is STRING

  -- Type to be created
  member .type              is STRING
  member .longType          is STRING
  member .purposeType       is STRING
  member .purposeText       is STRING

  -- Types for reference and form display.
  member .elementTypes      is ARRAY
  member .longTypes         is ARRAY
  member .ownerTypes        is ARRAY
  member .refDataTypes      is ARRAY
  member .form              is FORM
  member .currentApp        is STRING

  -- Type required for high level storage area
  member .highLevelType     is STRING

  -- High and low level areas from reference data
  member .highLevelArea     is DBREF
  member .lowLevelArea      is DBREF

  -- Rows data for low level list gadget
  member .lowLevelRows      is ARRAY

  -- High level areas added during the session
  member .sessionAreas      is ARRAY

  -- Flags for rows of low level area list to be expandable
  member .expandable        is ARRAY
  member .indentLevel       is ARRAY
  member .indent            is STRING

exit
-- End of form definition for !!catCreate

