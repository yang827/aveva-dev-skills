-- File:            catcreatetop.pmlfrm
--   Type:          Form Definition
--   Group:         vcat
--     Keyword:     vcat
--   Module:        vcat
--   Replaces:
--
-- Author:          M.lewis
-- Created:         Mon Apr 23 11:46:15 BST 2007
--
-- Description:
-- Create catalogue hierarchy
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  catCreateTop()                   -                   Constructor
--  init()                           -                   Initialise form
--  nameValidate()                   -                   Check entered name
--  setup(STRING)                    -                   Setup form
--
------------------------------------------------------------------------
setup form !!catCreateTop

  !this.formTitle     = 'Create'
  !this.iconTitle     = 'Create'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.00 $ '

  text   .name    width 32 string

  button .ok      |Ok|     at xmin form ymax+0.5  width 6 ok
  button .cancel  |Cancel| at xmax form-size ymin width 6 cancel

  -- Setup check
  member .setupDone         is BOOLEAN

  -- Type to be created
  member .type              is STRING
  member .longType          is STRING

exit
-- End of form definition for !!catCreateTop

------------------------------------------------------------------------
--
-- Method:      .catCreateTop()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .catCreateTop()

  -- Form callbacks
  !this.name.callback = |!this.nameValidate()|
  !this.okcall        = |!this.apply()|

  -- Setup check
  !this.setupDone = FALSE

endmethod
-- End of method definition for .catCreateTop()

------------------------------------------------------------------------
--
-- Method:      .setup()
--
-- Description: Setup form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element type to be created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setup(!type is STRING)

  -- Setup form for new type to be created
  if (!!catRefData.isHighLevelElement(!type)) then
    !this.type     = !type
    !this.longType = !!catRefData.getLongType(!type)
  else
    return error 1 |Not an appropriate type for !!catCreateTop|
  endif
  !this.formTitle = |Create | & !this.longType

  -- Mark setup as done
  !this.setupDone = true

endmethod
-- End of method definition for .setup(STRING)

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Initialise form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Setup check
  if (!this.setupDone.not()) then
    return error 1 |Form !!catCreateTop must be setup using function !!catCreate(STRING)|
  endif
  !this.setupDone = false

  -- Clear gadgets
  !this.name.val = |unset|

  -- Check if type can be created
  if (!!catRefData.canCreate(!this.type).not()) then
    return error 1 noalert
  endif

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .nameValidate()
--
-- Description: Check entered name
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .nameValidate()

  -- Check name
  if (!this.name.val.trim() eq ||) then
    !this.name.val = |unset|
  else
    !name = !!checkName(!this.name.val, |NEW|)
  endif

endmethod
-- End of method definition for .nameValidate()

------------------------------------------------------------------------
--
-- Method:      .apply()
--
-- Description: Apply form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  -- Check again if type can be created as form is not blocking and CE may have moved
  if (!!catRefData.canCreate(!this.type).not()) then
    return error 1 noalert
  endif

  -- Set name
  !name = !this.name.val.trim()
  if (!name eq |unset|) then
    -- Allow unnamed
    !name = object STRING()
  else
    -- Check name again as not cleared when checked (to allow user to modify bad name)
    !newName = !!checkName(!this.name.val, |NEW|)
    if (!newName.unset()) then
      return error 1 noalert
    endif
  endif

  -- Create element
  NEW $!<this.type>
  if (!name.set()) then
    NAME /$!name
  endif

endmethod
-- End of method definition for .apply()
