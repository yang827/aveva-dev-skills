-- Created:         Tue Feb 3 09:21:14 GMT 1998
--
--
-- Description:
-- Browse and view detail plotfiles for piping components
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Set dpfn attribute
--  browse()                         -                   Invoke browser for detail plotfile viewer
--  buildList()                      -                   Rebuild list of members of pipe which have dpfns set
--  catDetailPlt()                   -                   Constructor
--  ce(BOOLEAN)                      -                   Check current element
--  clear()                          -                   Clear plotfile in viewer
--  dismiss()                        -                   Tidy up
--  dpfname()                        -                   View plotfile from filename typed in
--  init()                           -                   MTO status initialisation
--  markCe(BOOLEAN)                  -                   Mark or unmark form CE
--  next()                           -                   Reinitialise form for next member
--  previous()                       -                   Reinitialise form for previous member
--  track(FORM,STRING)               -                   Database tracking method
--  view(FILE)                       -                   Display plotfile in viewer
--
------------------------------------------------------------------------
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--

-- Define form
setup form !!catDetailPlt
Import 'pmlfilebrowser'
handle any
endhandle

  !!catDetailPlt.formTitle     = 'Detail Plotfile'
  !!catDetailPlt.iconTitle     = 'Detail'
  !!catDetailPlt.callback      = '!!catDetailPlt.init()'
  !!catDetailPlt.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  member .ce is DBREF
  member .pipe is DBREF
  member .dpfn is FILE
  member .lastViewed is FILE
  member .marked is BOOLEAN
  -- flag to turn off warning during track when this form is shown
  member .warning is BOOLEAN

  -- Forms current element buttons and display
  frame .ceFrame 'Catalogue elements' at xmin ymax
    button .previous at xmin+1 ymax pixmap height 16 width 16
    paragraph .ceText at xmax+1 ymin width 60 lines 1
    button .next at xmax+1 ymin pixmap height 16 width 16
  exit

  -- Plotfile name and view
  frame .plotFrame 'Detail Plotfile' at xmin.ceFrame ymax+0.5
    paragraph .label at xmin+1 ymax text 'Filename'
    button .browse at xmax form-19 ymin 'Browse...'
    button .clear at xmax+1 ymin 'Clear'
    text .dpfname at xmin.label ymax+0.2 width 67 is STRING
    view .plot at xmin.label ymax+0.5 plot
      width 67
      height 16
      borders on
    exit
  exit

  button .apply at xmin form ymax+0.5 ' Apply ' apply
  button .dismiss at xmax form-size ymin 'Dismiss' cancel

  -- setup form tracking
  track |DESICE| |CATACE| callback '!!catDetailPlt.track('

exit

-- End of form definition for !!catDetailPlt

------------------------------------------------------------------------
--
-- Method:      !catDetailPlt()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .catDetailPlt()

  -- Initialise marked flag
  !!catDetailPlt.marked = false

  -- callbacks
  !this.previous.callback = '!!catDetailPlt.previous()'
  !this.next.callback = '!!catDetailPlt.next()'
  !this.browse.callback = '!!catDetailPlt.browse()'
  !this.clear.callback = '!!catDetailPlt.clear()'
  !this.dpfname.callback = '!!catDetailPlt.dpfname()'
  !this.apply.callback = '!!catDetailPlt.apply()'
  !this.cancelCall = '!!catDetailPlt.dismiss()'

  -- default background and foreground colours
  !this.plot.background = 'ivory'
  COLOUR 1 BLACK

  -- pixmaps
  !this.previous.addPixmap(!!PML.getPathName('leftarrow16.png'))
  !this.next.addPixmap(!!PML.getPathName('rightarrow16.png'))

endmethod
-- End of method definition for .catDetailPlt()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: MTO status initialisation
--
-- Method Type: Procedure
-- Arguments:
--   None
--
------------------------------------------------------------------------

define method .init()

  -- error if current element is inappropriate
  !this.warning = true
  !this.ce(true)

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !ce()
--
-- Description: Check current element
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [True if errors to be output]
--
------------------------------------------------------------------------

define method .ce(!report is BOOLEAN)

  -- Beware of owner check at world
  if (!!ce.type eq 'WORL') then
    if ((!report) and (!this.warning))then
      -- 'Can not set dpfn attribute at WORLD level'
      !!alert.warning('Can not set dpfn attribute at WORLD level')
    endif
    return error 1 noalert
  endif

  -- set dpfn attributes for SPCO and SDTE elements only
  if (!!ce.type ne 'SPCO' and !!ce.type ne 'SDTE') then
    -- warn if flag is true
    if (!this.warning) then
      !!alert.warning('Must be a SPCO or SDTE element')
    endif
    return error 1 noalert
  endif

  -- check SPCO and SDTE have Dpfn attribute
  if (!!ce.type eq 'SPCO' or !!ce.type eq 'SDTE') then

    if (!!ce.attributes().findFirst('Dpfname').unset()) then
      if (!this.warning) then
         !!alert.error('Current Element has not got dpfn attribute to set to')
      endif
      return error 1 noalert
    endif

  endif
   -- Connect appropriate CE to form
  !this.markCe(false)
  !this.ce = !!ce
  !this.pipe=!!ce
  !this.ceText.val = !this.ce.fullname
  !this.markCe(true)

  -- Get current dpfn attribute value and view plotfile
  !this.view(OBJECT FILE(!this.ce.dpfn))

  -- Build list for current pipe
  !this.buildList()

  -- Grey out apply button until setting is changed
  !this.apply.active = false

endmethod
-- End of method definition for .ce(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !track()
--
-- Description: Database tracking method
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [FORM]   [Form passed by tracking mechanism]
--   [2] [R] [STRING] [Database type of current element]
--
------------------------------------------------------------------------

-- Define method
define method .track(!dummyForm is FORM, !dummyType is STRING)

  -- turn off database warning during tracking
  !this.warning = false
  -- no error if current element is inappropriate
  !this.ce(false)

endmethod
-- End of method definition for .track(FORM, STRING)

------------------------------------------------------------------------
--
-- Method:      !previous()
--
-- Description: Reinitialise form for previous member
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .previous()

  -- Initialise for previous member
  !!ce = !this.ce
  PREVIOUS
  handle any
    !!alert.error(!!error.text)
  elsehandle none
    !this.init()
  endhandle

endmethod
-- End of method definition for .previous()

------------------------------------------------------------------------
--
-- Method:      !next()
--
-- Description: Reinitialise form for next member
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .next()

  -- Initialise for next member
  !!ce = !this.ce
  NEXT
  handle any
    !!alert.error(!!error.text)
  elsehandle none
    !this.init()
  endhandle

endmethod
-- End of method definition for .next()

------------------------------------------------------------------------
--
-- Method:      !buildList()
--
-- Description: Rebuild list of members of pipe which have dpfns set
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .buildList()

  -- Title for list
  !name = !this.pipe.fullname
  if (!name.substring(1, 5) ne 'PIPE ') then
    !name = 'PIPE ' & !name
  endif

endmethod
-- End of method definition for .buildList()

------------------------------------------------------------------------
--
-- Method:      !clear()
--
-- Description: Clear plotfile in viewer
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .clear()

  -- Unset file data
  !this.dpfn = object FILE()
  !this.dpfname.val = ''

  -- Clear current plotfile display
  !this.plot.clear()

  -- Reactivate apply button if applicable
  !this.apply.active = (!this.ce.dpfn.trim() ne '')

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:      !view()
--
-- Description: Display plotfile in viewer
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [FILE] [Detail plotfile]
--
------------------------------------------------------------------------

define method .view(!plotfile is FILE)

  -- Clear current display
  !this.clear()

  if (!plotfile.unset().not()) then
    if (!plotfile.exists()) then

      -- Display detail plotfile
      !this.plot.add('/' & !plotfile.name())

      -- Store plotfile details
      !this.dpfn = !plotfile
      !this.dpfname.val = !plotfile.name()

      -- Store name of any plotfile viewed so that we can get an initial
      -- browse path even after the current dpfn has been cleared
      !this.lastViewed = !plotfile

      -- Reactivate apply button if applicable
      !this.apply.active = (!this.ce.dpfn.trim() ne '/' & !plotfile.name())

    else

      -- plotfile no longer exists
      !this.plot.clear()
      -- Grey out apply button and retain focus on filename
      !this.apply.active = false
      !this.dpfname.val = !plotfile.name()
      !this.dpfname.setFocus()
      -- 'File #name does not exist'
      !!messageFile.message(146, 9, !plotfile.name())

    endif
  endif

endmethod
-- End of method definition for .view(FILE)

------------------------------------------------------------------------
--
-- Method:      !dpfname()
--
-- Description: View plotfile from filename typed in
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .dpfname()

  if (!this.dpfname.val.trim() eq '') then
    -- Treat blank filename as clear action
    !this.clear()
  else
    -- Test if file exists
    !testFile = object FILE(!this.dpfname.val)
    if (!testFile.exists().not()) then
      !this.plot.clear()
      -- Grey out apply button and retain focus if filename is incorrect
      !this.apply.active = false
      !this.dpfname.setFocus()
      -- 'File #name does not exist'
      !!messageFile.error(146, 9, !testFile.name())
    else
      -- View file if it exists
      !this.view(!testFile)
    endif
  endif

endmethod
-- End of method definition for .dpfname()

------------------------------------------------------------------------
--
-- Method:      !browse()
--
-- Description: Invoke browser for detail plotfile viewer
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .browse()

  -- Set default directory path for file browser
  if (!this.lastViewed.unset()) then
    !path = '%PDMSUSER%'
  else
    !path = !this.lastViewed.pathName()
  endif
  !!fileBrowser(!path, |*.plt|, |View Detail Plotfile|, TRUE, |!!catDetailPlt.view(!!fileBrowser.file)|)

endmethod
-- End of method definition for .browse()

------------------------------------------------------------------------
--
-- Method:      !markCe()
--
-- Description: Mark or unmark form CE
--
-- Method Type: Procedure
-- Arguments
-- 1  R  BOOLEAN  Mark if true, unmark if false
--
------------------------------------------------------------------------

define method .markCe(!mark is BOOLEAN)

  if (!mark) then
    -- Mark new form CE
    MARK $!<this.ce>
    !this.marked = true
  else
    -- Unmark previous form CE
    if (!this.ce.unset().not() and !this.marked) then
      if (!this.ce.badref().not()) then
        UNMARK $!<this.ce>
      endif
      !this.marked = false
    endif
  endif

endmethod
-- End of method definition for .markCe(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !apply()
--
-- Description: Set dpfn attribute
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .apply()

  -- Set dpfn for form's ce
  !!ce = !this.ce
  if (!this.dpfn.unset()) then
    DPFN ''
  else
    !dpfnName = !this.dpfn.name()
    DPFN '$!dpfnName'
  endif

  -- Rebuild list for current pipe
  !this.buildList()

  -- Grey out apply button until setting is changed
  !this.apply.active = false

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      !dismiss()
--
-- Description: Tidy up
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .dismiss()

  -- Unmark form ce
  !this.markCe(false)

endmethod
-- End of method definition for .dismiss()
