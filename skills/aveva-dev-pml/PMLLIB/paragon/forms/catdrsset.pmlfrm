-- Created:         Mon Mar 28 15:59:15 BST 2007
--
-- Description:
-- Modify Paragon Draft symbol sets
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add()                            -                   Add new drsylk
--  applyDrsset()                    -                   Apply changes for Draft symbol link
--  applyDrsylk()                    -                   Apply changes for Draft symbol link
--  catDrsset()                      -                   Constructor
--  criteria(GADGET,STRING)          -                   Callback for criteria combo
--  delete()                         -                   Delete selected drsylk
--  drsName()                        -                   Check entered name
--  drsylkList()                     -                   Callback for symbol link list
--  init()                           -                   Initialise form
--  scaling()                        -                   Callback for scaling flag
--  setReference(GADGET,STRING)      -                   Callback for part reference
--  showSearch()                     -                   Show search for drsylk
--
------------------------------------------------------------------------
setup form !!catDrsset dialog

  !this.formTitle     = 'Draft Symbol Set'
  !this.iconTitle     = 'Drsset'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.00 $ '

  -- Draft symbol set attributes
  frame .drssetFrame |Draft Symbol Set|
    text   .drsName     |Name|          tagwidth 8 width 26 string
    button .drsCE |CE| at xmax+1 ymin width 2
    text   .description |Description|   at xmin.drsName ymax+0.2 tagwidth 8 width 30 string
    text   .function    |Function|      at xmin ymax+0.2 tagwidth 8 width 30 string
    text   .purpose     |Purpose|       at xmin ymax+0.2 tagwidth 8 width 4 string
    button .applyDrsset |Apply Changes| at xmax.drsCE-size ymin width 10
  exit

  -- Draft symbol links
  frame .drsylkListFrame |Draft Symbol Links| at xmin.drssetFrame ymax.drssetFrame+0.5
    list .drsylkList width 30 length 12
    button .add    |Add|    at xmax.drsylkList+1 ymin.drsylkList+1 width 5
    button .delete |Delete| at xmin ymax+0.5 width 5
  exit

  -- Edit symbol link
  frame .drsylkFrame  |Edit Link to Text or Symbol Template| at xmin.drsylkListFrame ymax.drsylkListFrame+0.5
    text   .refVal      |Template| tagwidth 8 width 22 string
    button .refSearch pixmap at xmax+1.5 ymin width 16 height 16
    button .refCE       |CE|   at xmax+1 ymin width 2
    combo  .criteria    |Criteria| at xmin.refVal ymax+0.2 tagwidth 8 width 27
    toggle .scalingFlag | Scale Factors| at xmin.refVal ymax+0.15 tagwidth 8
    text   .xscale      |X| at xmax+1 ymin+0.05 width 3 is REAL
    text   .yscale      |Y| at xmax+1 ymin width 3 is REAL
    button .applyDrsylk |Apply Changes| at xmax.refCE-size ymin width 10
  exit

  -- Close
  button .close |Close| at xmax form-size ymax+0.5 width 6 ok

  -- Drsset
  member .drsset            is DBREF

  -- Drsylks
  member .drsylks           is ARRAY

  -- Default criteria string
  member .defaultCriteria   is STRING


--show !!catDrsset

exit
-- End of form definition for !!catDrsset

------------------------------------------------------------------------
--
-- Method:      .catDrsset()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .catDrsset()

  -- Form callbacks
  !this.drsCE.callback         = |!this.init()|
  !this.drsName.callback       = |!this.drsName()|
  !this.applyDrsset.callback   = |!this.applyDrsset()|
  !this.drsylkList.callback    = |!this.drsylkList()|
  !this.add.callback           = |!this.add()|
  !this.delete.callback        = |!this.delete()|
  !this.refVal.callback        = |!this.setReference(|
  !this.refSearch.callback     = |!this.showSearch()|
  !this.refCE.callback         = |!this.setReference(|
  !this.criteria.callback      = |!this.criteria(|
  !this.scalingFlag.callback   = |!this.scaling()|
  !this.applyDrsylk.callback   = |!this.applyDrsylk()|

  -- Search icons and tooltips
  !searchIcon = !!pml.getpathname('ng_zoomtoselection.png')
  !this.refSearch.addpixmap(!searchIcon)
  !this.refSearch.setTooltip(|Search|)
  !this.refCE.setTooltip(|Use CE|)

  -- Example criteria
  !this.defaultCriteria = |Enter an expression or select from list...|
  !dtext = ARRAY()
  !dtext[1] = !this.defaultCriteria
  !dtext[2] = |ALL VIEW WITH ( ATTRIB PLANV )|
  !dtext[3] = |ALL VIEW WITH ( ATTRIB ELEVV )|
  !dtext[4] = |ALL VIEW WITH ( ATTRIB DIR EQ E ( 45 ) N ( 30 ) D )|
  !this.criteria.dtext = !dtext

endmethod
-- End of method definition for .catDrsset()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Initialise form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Check if at a drsset
  if (!!ce.type eq |DRSSET|) then
    !this.drsset = !!ce
    !listPos = 0
  elseif (!!ce.type eq |DRSYLK|) then
    !this.drsset = !!ce.owner
    !listPos = !!ce.tysequ
  else
    return error 1 |Must be at or below a Draft Symbol Set|
  endif

  -- Set form members
  if (!this.drsset.isNamed) then
    !this.drsName.val = !this.drsset.namn
  else
    !this.drsName.val = |unset|
  endif
  !this.description.val = !this.drsset.description
  !this.function.val    = !this.drsset.function
  !this.purpose.val     = !this.drsset.purpose

  -- Get list of symbol links
  !this.drsylks.clear()
  !dtext = ARRAY()
  !rtext = ARRAY()
  do !drsylk values !this.drsset.members
    if (!drsylk.type eq |DRSYLK|) then
      !this.drsylks.append(!drsylk)
      !dtext.append(!drsylk.namn)
      !rtext.append(!drsylk.ref.string())
    endif
  enddo
  !this.drsylkList.dtext = !dtext
  !this.drsylkList.rtext = !rtext

  -- Initialise symbol link gadgets
  if(defined(!listPos)) then
    if (!listPos gt 0) then
     !this.drsylkList.val = !listPos
    endif
  else
    return
endif

  !this.drsylkList()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .drsName()
--
-- Description: Check entered name
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .drsName()

  -- Check name
  if (!this.drsName.val.set()) then
    if (!this.drsName.val ne !this.drsset.namn) then
      if (!this.drsName.val.trim() eq ||) then
        !this.drsName.val = |unset|
      else
        !newName = !!checkName(!this.drsName.val, |NEW|)
      endif
    endif
  endif

endmethod
-- End of method definition for .drsName()

------------------------------------------------------------------------
--
-- Method:      .drsylkList()
--
-- Description: Callback for symbol link list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .drsylkList()

  -- Initialise
  !this.refVal.val      = |Nulref|
  !this.criteria.val    = 1
  !this.xscale.val      = 1
  !this.yscale.val      = 1
  !this.scalingFlag.val = false

  -- Populate gadgets with selected symbol link data
  if (!this.drsylks.empty().not()) then
    !drsylk = !this.drsylks[!this.drsylkList.val]

    -- Validate template reference
    if (!drsylk.drtmpref.set()) then
      if (!drsylk.drtmpref.badref().not()) then
        !this.refVal.val = !drsylk.drtmpref.namn
      endif
    endif

    -- Criteria
    !criteria = !drsylk.criteria.trim()
    handle (2, 779)
      -- Criteria returns string if set or integer array if unset
      -- Ignore error for method array.trim() not found as this means criteria is unset
    elsehandle none
      !criteriaPos = !this.criteria.dtext.findFirst(!criteria)
      if (!criteriaPos.set()) then
        -- Criteria already in list so select it
        !this.criteria.val = !criteriaPos
      else
        -- Add criteria into list below number one slot (builds up reusable criteria thru session)
        !dtext = !this.criteria.dtext
        !dtext.insert(2, !criteria)
        !this.criteria.dtext = !dtext
        !this.criteria.val = 2
      endif
    endhandle

    -- Attributes
    !this.xscale.val      = !drsylk.xyscale[1]
    !this.yscale.val      = !drsylk.xyscale[2]
    !this.scalingFlag.val = !drsylk.scalingFlag
  endif

  -- Activate gadgets
  !this.delete.active      = (!this.drsylks.empty().not())
  !this.drsylkFrame.active = (!this.drsylks.empty().not())
  !this.scaling()

endmethod
-- End of method definition for .drsylkList()

------------------------------------------------------------------------
--
-- Method:      .add()
--
-- Description: Add new drsylk
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .add()

  -- Create a new symbol link
  if (!this.drsylks.empty()) then
    !!ce = !this.drsset
  else
    !!ce = !this.drsylks.last()
  endif
  NEW DRSYLK
  !name = !this.drsset.name & |-DRSYLK| & !!ce.tysequ
  NAME $!name
  !this.init()

endmethod
-- End of method definition for .add()

------------------------------------------------------------------------
--
-- Method:      .delete()
--
-- Description: Delete selected drsylk
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .delete()

  -- Delete selected symbol link
  if (!!alert.confirm(|OK to delete selected Draft Symbol Link?|) eq |YES|) then
    !!ce = !this.drsylks[!this.drsylkList.val]
    DELETE DRSYLK
    !this.init()
  endif

endmethod
-- End of method definition for .delete()

------------------------------------------------------------------------
--
-- Method:      setReference
--
-- Description: Callback for part reference
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setReference(!gadget is GADGET, !action is STRING)

  -- CE button
  if (!gadget eq !this.refCE) then

    -- Validate CE
    if (not !!ce.type inset(|TXTM|, |SYTM|)) then
      return error 1 |$!!<ce.name> is not a Text or Symbol Template|
    endif
    !this.refVal.val = !!ce.namn

  -- Text input
  elseif (!gadget eq !this.refVal) then

    -- Check for unset
    if (!gadget.val eq || or !gadget.val.lowcase() eq |unset| or !gadget.val.substring(1,2) eq |=0|) then
      !gadget.val = |Nulref|
    else
      -- Validate name
      !newValue = !!checkName(!gadget.val, |OLD|)
      if (!newValue.set()) then
        if (not !newValue.dbref().type inset(|TXTM|, |SYTM|)) then
          !this.drsylkList()
          return error 1 |$!newValue is not a Text or Symbol Template|
        endif
      else
        !this.drsylkList()
      endif
    endif

  endif

endmethod
-- End of method definition for .setReference(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      criteria
--
-- Description: Callback for criteria combo
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .criteria(!gadget is GADGET, !action is STRING)

  -- Action on user typing text into combo
  if (!action eq |VALIDATE|) then

    -- Store new expression into list
    !newText = !this.criteria.displayText().trim()
    !criteriaPos = !this.criteria.dtext.findFirst(!newText)
    if (!criteriaPos.set()) then
      -- Criteria already in list so select it
      !this.criteria.val = !criteriaPos
    else
      -- Add criteria into list below number one slot (builds up reusable criteria thru session)
      !dtext = !this.criteria.dtext
      !dtext.insert(2, !newText)
      !this.criteria.dtext = !dtext
      !this.criteria.val = 2
    endif

  endif

endmethod
-- End of method definition for .criteria(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      .scaling()
--
-- Description: Callback for scaling flag
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .scaling()

  -- Activate scale factors according to scaling flag
  !this.xscale.active = !this.scalingFlag.val
  !this.yscale.active = !this.scalingFlag.val

endmethod
-- End of method definition for .scaling()

------------------------------------------------------------------------
--
-- Method:      .showSearch()
--
-- Description: Show search for drsylk
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showSearch()

  -- Setup search form
  if (undefined(!!catSearch) ) then
    pml load form !!catSearch
  endif
  !searchFor = ARRAY()
  !searchFor[1] = |SYTM|
  !searchFor[2] = |TXTM|
  !!catSearch.setup(!this.refVal, |Text or Symbol Template|, |PADD|, !searchFor)
  show !!catSearch

endmethod
-- End of method definition for .showSearch()

------------------------------------------------------------------------
--
-- Method:      .applyDrsset()
--
-- Description: Apply changes for Draft symbol link
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyDrsset()

  -- Set name
  if (!this.drsName.val.set()) then
    if (!this.drsName.val ne !this.drsset.namn) then
      if (!this.drsName.val.trim() eq |unset|) then
        !dbpos = !!ce
        !!ce = !this.drsset
        UNNAME
        !!ce = !dbpos
      else
        -- Check name again as not cleared when checked (to allow user to modify bad name)
        !newName = !!checkName(!this.drsName.val, |NEW|)
        if (!newName.set()) then
          !this.drsset.name = !newName
        else
          if (!this.drsset.isNamed) then
            !this.drsName.val = !this.drsset.namn
          else
            !this.drsName.val = |unset|
          endif
        endif
      endif
    endif
  endif

  -- Set attributes
  !this.drsset.description = !this.description.val
  !this.drsset.function    = !this.function.val
  !this.drsset.purpose     = !this.purpose.val

endmethod
-- End of method definition for .applyDrsset()

------------------------------------------------------------------------
--
-- Method:      .applyDrsylk()
--
-- Description: Apply changes for Draft symbol link
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyDrsylk()

  -- Get drsylk
  !drsylk =!this.drsylks[!this.drsylkList.val]

  -- Set reference
  if (!this.refVal.val eq |Nulref|) then
    !dbpos = !!ce
    !!ce = !drsylk
    DRTMPREF NULREF
    !!ce = !dbpos
  else
    !name = |/| & !this.refVal.val
    if (!drsylk.drtmpref ne !name.dbref()) then
      !drsylk.drtmpref = !name.dbref()
    endif
  endif

  -- Set attributes
  !xyscale    = ARRAY()
  !xyscale[1] = !this.xscale.val
  !xyscale[2] = !this.yscale.val
  !drsylk.xyscale     = !xyscale
  !drsylk.scalingFlag = !this.scalingFlag.val

  -- Criteria must be set via syntax to encode expression into the internal integer array
  if (!this.criteria.val gt 1) then
    !dbpos = !!ce
    !!ce = !drsylk
    !criteria = !this.criteria.selection()
    CRITERIA $!criteria
    handle (47, 15)
      -- Syntax error on criteria expression
      !!alert.error(|Invalid criteria expression|)
    endhandle
    !!ce = !dbpos
  endif

endmethod
-- End of method definition for .applyDrsylk()
