  !this.shownNotModified[19]     = |LEAV|

  -- attributes that must not be set on this form
  !this.marineProxyHierarchy[1]  = |BLOCK|
  !this.marineProxyHierarchy[2]  = |HCMWLD|
  !this.marineProxyHierarchy[3]  = |COMWLD|
  !this.marineProxyHierarchy[4]  = |MOGWLD|
  !this.marineProxyHierarchy[5]  = |RSOWLD|
  !this.marineProxyHierarchy[6]  = |SSOWLD|
