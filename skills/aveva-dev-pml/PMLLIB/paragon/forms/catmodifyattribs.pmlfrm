--  File:            catmodifyattribs.pmlfrm
--    Type:          Form Definition
--    Group:         VCAT
--      Keyword:     VCAT
--    Module:        VCAT
--  Author:          Mac Lewis
--  Created:         Thu Mar 08 11:35:09 2007

--
--  Description:     Modify All Attributes for current element
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  attribList(GADGET,STRING)        -                   Attribute list callback
--  catModifyAttribs()               -                   Constructor
--  formatReal(REAL)                 STRING              Prepare a real number for presentation to the user
--  getGeodep(GADGET,STRING)         -                   Track referenced elements.
--  init()                           -                   Initialisation for form
--  nameValidate()                   -                   Check entered name
--  navigate(STRING)                 -                   Navigate to referenced element
--  refCE()                          -                   Use CE for reference
--  refValidate()                    -                   Use typed name for reference
--  refresh()                        -                   Refresh form after update
--  setAttribute()                   -                   Set string attribute
--  setBore()                        -                   Set bore attribute
--  setDistance()                    -                   Set distance attribute
--  setExpression()                  -                   Set expression attribute
--  setLogical()                     -                   Set logical attribute
--  setNumeric(REAL)                 -                   Set real attribute
--  setReal()                        -                   Set real attribute
--  setReference()                   -                   Set reference attribute
--  setString()                      -                   Set string attribute
--  showSearch()                     -                   Show search for drsylk
--  track()                          -                   Track CE callback
--  track(GADGET,STRING)             -                   Track CE option
--  updateUndo()                     -                   Refresh form after undo/redo
--

-- Define form
setup form !!catModifyAttribs dialog docking

  !this.formTitle     = 'Modify Attributes'
  !this.iconTitle     = 'Attrib'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.00 $ '

  -- CE button and label
  button .catCE  |CE|    anchor top+left
  toggle .track  |Track| anchor top+left at xmax+1 ymin tagwidth 5 states |FALSE| |TRUE|
  para   .dbwrit         anchor top+left at xmax   ymin width 12 lines 1
  para   .dacmod         anchor top+left at xmax   ymin width 16 lines 1
  path down

  -- Attributes list
  list .attribList anchor all at xmin.catCE ymax+0.2 width 38 height 16

  -- Basic attribute setting gadgets
  frame .attFrame panel anchor bottom+left+right at xmin.attribList ymax.attribList+0.2 width 39
    frame .setAttFrame |Set Attribute| anchor all at xmin ymin
      text   .attVal anchor bottom+left+right width 36 string
      option .geodep |Referenced by:| tagwidth 10 width 24
      button .setAtt |Apply| anchor bottom+left
    exit

  -- String attribute setting gadgets
    frame .setStrFrame |Set Attribute| anchor all at xmin ymin
      textpane .strVal anchor bottom+left+right width 37 length 3
      button   .setStr |Apply| anchor bottom+left at xmin ymax+0.6
    exit

  -- Reference attribute setting gadgets
    frame .setRefFrame |Set Attribute| anchor all at xmin ymin
      para   .refAtt anchor bottom+left width 30 lines 1
      button .refSearch pixmap anchor bottom+right at xmax+0.5 ymin width 16 height 16
      button .refCE |CE| anchor bottom+right       at xmax+1 ymin width 2
      text   .refVal anchor bottom+left+right      at xmin.refAtt ymax+0.3 width 36 string
      button .setRef |Apply| anchor bottom+left    at xmin.refAtt ymax+0.2
      button .navigate |Navigate to Ref|           at xmin.refVal ymin.refVal-1.25
      para   .refPad anchor bottom+left+right      at xmax.setRef+1 ymin.setRef width 30 lines 1
    exit

  -- Logical attribute setting gadgets
    frame .setLogFrame |Set Attribute| anchor all at xmin ymin
      toggle .logVal anchor bottom+left at xmin+2 states |false| |true|
      button .setLog |Apply| anchor bottom+left at xmin.logVal-0.5 ymax+0.2
      para   .logPad anchor bottom+left width 37 lines 1
    exit

  -- Real attribute setting gadgets
    frame .setRealFrame |Set Attribute| anchor all at xmin ymin
      text .realVal anchor bottom+left width 14 string
      button .setReal |Apply| anchor bottom+left
      para   .realPad anchor bottom+left width 37 lines 1
    exit

  -- Distance attribute setting gadgets
    frame .setDistanceFrame |Set Attribute| anchor all at xmin ymin
      text .distanceVal anchor bottom+left width 14 is REAL format !!distanceFmt
      button .setDistance |Apply| anchor bottom+left
      para   .distancePad anchor bottom+left width 37 lines 1
    exit

  -- Bore attribute setting gadgets
    frame .setBoreFrame |Set Attribute| anchor all at xmin ymin
      text .boreVal anchor bottom+left width 14 string
      button .setBore |Apply| anchor bottom+left
      para   .borePad anchor bottom+left width 37 lines 1
    exit

  -- Message frame for attributes that cannot be set
    frame .messageFrame |Message| anchor all at xmin ymin
      para   .paraMessage anchor bottom+left+right width 37 lines 5
    exit
  exit

  -- Element for which form is showing attributes
  member .element               is DBREF

  -- Attribute selected
  member .attrib                is STRING
  -- Attribute definition object for the selected attribute
  member .attributeDefinition   is ATTDEFINITION
  -- Reference element type lookup for initial search criteria
  member .refAttributes         is ARRAY
  member .refTypes              is ARRAY
  member .refDBTypes            is ARRAY
  -- Array of top level Marine proxy element types
  member .marineProxyHierarchy  is ARRAY
  -- Array of system attributes that must not be set on this form
  member .systemAttributes      is ARRAY
  -- Array of attributes that are not set on this form, but may be shown
  member .shownNotModified      is ARRAY

  -- Return character
  member .returnChar            is STRING

  -- Undo event handlers
  member .undoUpdate            is UNDOABLE

  -- Track CE
  track |CATACE| call |!this.track()|
  track |PROPCE| call |!this.track()|
  track |PADDCE| call |!this.track()|
  track |DESICE| call |!this.track()|
  track |SCHECE| call |!this.track()|
  track |ISODCE| call |!this.track()|

exit

-- End of form definition for !!catModifyAttribs

------------------------------------------------------------------------
--
-- Method:      .catModifyAttribs()
--
-- Description: Constructor
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .catModifyAttribs()

  -- Callbacks
  !this.catCE.callback        = |!this.init()|
  !this.navigate.callback     = |!this.navigate(!this.refVal.val)|
  !this.track.callback        = |!this.track(|
  !this.attribList.callback   = |!this.attribList(|
  !this.attVal.callback       = |!this.nameValidate()|
  !this.setStr.callback       = |!this.setString()|
  !this.setAtt.callback       = |!this.setAttribute()|
  !this.setRef.callback       = |!this.setReference()|
  !this.refVal.callback       = |!this.refValidate()|
  !this.refCE.callback        = |!this.refCE()|
  !this.refSearch.callback    = |!this.showSearch()|
  !this.setLog.callback       = |!this.setLogical()|
  !this.setReal.callback      = |!this.setReal()|
  !this.setDistance.callback  = |!this.setDistance()|
  !this.setBore.callback      = |!this.setBore()|
  !this.geodep.callback       = |!this.getGeodep(|

  -- Option setup
  !menu = !this.newMenu('headers')
  -- Define menu
  !menu.add('toggle', 'Description','!this.init()')
  -- Apply popup to attribute list
  !this.attribList.setPopup(!this.headers)

  -- Search icons and tooltips
  !searchIcon = !!pml.getpathname('ng_zoomtoselection.png')
  !this.refSearch.addpixmap(!searchIcon)
  !this.refSearch.setTooltip(|Search|)
  !this.refCE.setTooltip(|Use CE|)

  -- Initialise apply button undo
  !this.undoUpdate.description('Attribute Modify')
  !this.undoUpdate.undoAction('!!catModifyAttribs.updateUndo()')
  !this.undoUpdate.redoAction('!!catModifyAttribs.updateUndo()')
  !this.setReal.setUndoable(!this.undoUpdate)
  !this.setBore.setUndoable(!this.undoUpdate)
  !this.setDistance.setUndoable(!this.undoUpdate)
  !this.setLog.setUndoable(!this.undoUpdate)
  !this.setRef.setUndoable(!this.undoUpdate)
  !this.setAtt.setUndoable(!this.undoUpdate)
  !this.setStr.setUndoable(!this.undoUpdate)

  -- Return character
  !this.returnChar = |
|

  -- Set reference attributes
  !this.refAttributes[1]  = |CATREF|
  !this.refAttributes[2]  = |TMPREF|
  !this.refAttributes[3]  = |DRSSREF|
  !this.refAttributes[4]  = |DETREF|
  !this.refAttributes[5]  = |MATXT|
  !this.refAttributes[6]  = |BLTREF|
  !this.refAttributes[7]  = |CMPREF|
  !this.refAttributes[8]  = |PRTREFERENCE|
  !this.refAttributes[9]  = |GMREF|
  !this.refAttributes[10] = |PTREF|
  !this.refAttributes[11] = |GSTREF|
  !this.refAttributes[12] = |PSTREF|
  !this.refAttributes[13] = |NGMREF|
  !this.refAttributes[14] = |DTREF|
  !this.refAttributes[15] = |CCORREF|
  !this.refAttributes[16] = |DRTMPREF|
  !this.refAttributes[17] = |BENDMACREFERENCE|
  !this.refAttributes[18] = |PSPEC|
  !this.refAttributes[19] = |TSPEC|
  !this.refAttributes[20] = |ISPEC|

  -- Set reference types
  !this.refTypes[1]  = |SCOM SPRF SFIT JOIN|
  !this.refTypes[2]  = |TMPL|
  !this.refTypes[3]  = |DRSSET|
  !this.refTypes[4]  = |SDTE|
  !this.refTypes[5]  = |SMTE|
  !this.refTypes[6]  = |SBOL MBOL|
  !this.refTypes[7]  = |CMPD TUBD|
  !this.refTypes[8]  = |GPART|
  !this.refTypes[9]  = |GMSE|
  !this.refTypes[10] = |PTSE|
  !this.refTypes[11] = |GMSS|
  !this.refTypes[12] = |PTSS|
  !this.refTypes[13] = |NGMS|
  !this.refTypes[14] = |DTSE|
  !this.refTypes[15] = |CCORSE|
  !this.refTypes[16] = |SYTM TXTM|
  !this.refTypes[17] = |FMBEND FMGRP FMWL|
  !this.refTypes[18] = |SPEC|
  !this.refTypes[19] = |SPEC|
  !this.refTypes[20] = |SPEC|

  -- Set reference db types
  !this.refDBTypes[1]  = |CATA|
  !this.refDBTypes[2]  = |DESI|
  !this.refDBTypes[3]  = |PADD|
  !this.refDBTypes[4]  = |CATA|
  !this.refDBTypes[5]  = |CATA|
  !this.refDBTypes[6]  = |CATA|
  !this.refDBTypes[7]  = |PROP|
  !this.refDBTypes[8]  = |CATA|
  !this.refDBTypes[9]  = |CATA|
  !this.refDBTypes[10] = |CATA|
  !this.refDBTypes[11] = |CATA|
  !this.refDBTypes[12] = |CATA|
  !this.refDBTypes[13] = |CATA|
  !this.refDBTypes[14] = |CATA|
  !this.refDBTypes[15] = |CATA|
  !this.refDBTypes[16] = |PADD|
  !this.refDBTypes[17] = |DESI|
  !this.refDBTypes[18] = |CATA|
  !this.refDBTypes[19] = |CATA|
  !this.refDBTypes[20] = |CATA|

  -- attributes that are not seen and must not be set on this form
  !this.systemAttributes[1]      = |ORRF|
  !this.systemAttributes[2]      = |MEMBERS|
  !this.systemAttributes[3]      = |INVF|
  !this.systemAttributes[4]      = |LCNFA|
  !this.systemAttributes[5]      = |RSEQA|
  !this.systemAttributes[6]      = |DDRFA|
  !this.systemAttributes[7]      = |XINCL|
  !this.systemAttributes[8]      = |SMEMB|
  !this.systemAttributes[9]      = |SEXPND|
  !this.systemAttributes[10]     = |RLST|
  !this.systemAttributes[11]     = |PTNH|
  !this.systemAttributes[12]     = |PTNB|
  !this.systemAttributes[13]     = |DRRF|
  !this.systemAttributes[14]     = |SPSP|
  !this.systemAttributes[15]     = |JNUM|
  !this.systemAttributes[16]     = |JOIP|
  !this.systemAttributes[17]     = |BSTA|
  !this.systemAttributes[18]     = |HWRF|
  !this.systemAttributes[19]     = |TWRF|
  !this.systemAttributes[20]     = |SPLN|
  !this.systemAttributes[21]     = |SPLT|
  !this.systemAttributes[22]     = |PTNO|
  !this.systemAttributes[23]     = |PTNT|
  !this.systemAttributes[24]     = |RLOC|
  !this.systemAttributes[25]     = |RLIN|
  !this.systemAttributes[26]     = |RLEX|
  !this.systemAttributes[27]     = |HREL|
  !this.systemAttributes[28]     = |BRLO|
  !this.systemAttributes[29]     = |LNFA|
  !this.systemAttributes[30]     = |CBSTA|

  -- attributes that are seen but must not be set on this form
  !this.shownNotModified[1]      = |OWNER|
  !this.shownNotModified[2]      = |TYPE|
  !this.shownNotModified[3]      = |TMRREF|
  !this.shownNotModified[4]      = |REPCOU|
  !this.shownNotModified[5]      = |TMRMAS|
  !this.shownNotModified[6]      = |TMROWN|
  !this.shownNotModified[7]      = |JOIS|
  !this.shownNotModified[8]      = |JOIE|
  !this.shownNotModified[9]      = |CREF|
  !this.shownNotModified[10]     = |SPRE|
  !this.shownNotModified[11]     = |DESP|
  !this.shownNotModified[12]     = |:HXYSIZE|
  !this.shownNotModified[13]     = |:TXYSIZE|
