-- End of method definition for .catModifyAttribs()

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Initialisation for form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Set form element
  !this.element   = !!ce
  !this.formTitle = ' Attributes of ' & !this.element.flnn

  -- Clear values
  !this.attVal.val  = ||
  !this.strVal.clear()
  !this.refVal.val  = ||
  !this.logVal.val  = false
  !this.realVal.val = ''
  !this.attribList.clear()

  !displayDescription = !this.headers.selected('Description')

  -- List headings
  !headings      = ARRAY()
  !headings[1]   = |Attribute|
  !headings[2]   = |Value|
  if(!displayDescription) then
    !headings[3] = |Description|
  endif
  !this.attribList.setHeadings(!headings)

  -- Display element attributes if form element has been set (setup must have been called)
  if (badref(!this.element)) then
    return
  endif

  -- Get attributes
  !attributes = !this.element.attributes()

  -- Special cases that conflict with syntax
  !memb = !attributes.findFirst(|DraftSSRef|)
  if (!memb.set()) then
    !attributes[!memb] = |Drssref|
  endif

  -- Populate list
  !rtext = ARRAY()
  !rows  = ARRAY()
  !attributeValue = 0

  do !attrib values !attributes
    -- remove all MDS attributes
    skip if( !attrib.subString(1,4).upcase() eq ':MDS')
    skip if( !attrib.upcase() eq 'MEMBERS')
    -- Use ATTDEF to get attribute definition
    !this.attributeDefinition.attLibGet(!attrib)
    !attribName = !this.attributeDefinition.name.upcase()
    !attribQueryText = !this.attributeDefinition.qTxt.upcase()
    -- remove all system attributes
    skip if( !this.systemAttributes.findFirst(!attribName).set())
    !row    = ARRAY()
    !row[1] = !attrib
    -- check for distance types
    !isPosition = !this.attributeDefinition.type.upcase().eq('POSITION')
    !isDistance = !this.attributeDefinition.units.upcase().eq('DISTANCE') and !isPosition.not()
    if( !isDistance ) then
      -- apply current distance format to this attribute
      !row[2] = !!ce.attribute(!attrib).string(!!distanceFmt)
      handle any
        skip
      endhandle
    else
      !attributeValue.delete()
      !attributeValue = !this.element.attribute(!attrib)
      if (!attributeValue.objectType() eq 'ARRAY' and !attributeValue.empty()) then
          -- probably an empty expression
          !row[2] = 'unset'
      else
        -- Use PML1 to process dbref and array attributes such as PAXIS
        var !row[2] ( attrib $!<attrib> of $!<this.element> )
        handle any
          skip
        endhandle
      endif
    endif

    if(!displayDescription) then
      !row[3] = !this.attributeDefinition.fullDescription
    endif

    !rows.append(!row)
    !rtext.append(!attribQueryText)
  enddo

  !this.attribList.setRows(!rows)
  !this.attribList.rtext = !rtext

  -- Run callback if list has a member
  if (!rtext.empty().not()) then
    !this.attribList(!this.attribList, |SELECT|)
  endif

  -- Set reference list if available.
  !dtext = ARRAY()
  !rtext = ARRAY()
  !geodep = GEODEP
  handle (2,201)
    -- Doesn't have geodep, grey out gadget.
    !this.geodep.dtext = !dtext
    !this.geodep.rtext = !rtext
    !this.geodep.active = false
    return
  endhandle

  -- Geodep available
  do !whereUsed value !geodep

     -- do not include owner
     skip if( !whereUsed eq !!ce.owner )
     -- Limit the list to the first 20 available elements.
     break if (!dtext.size() gt 19)

     !dtext.append(!whereUsed.name & ' ( ' & !whereUsed.type & ' )')
     !rtext.append(!whereUsed.string())

  enddo

  !this.geodep.active = !dtext.empty().not()

  !this.geodep.dtext = !dtext
  !this.geodep.rtext = !rtext

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .getGeodep()
--
-- Description: Track referenced elements.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getGeodep(!gadget is GADGET, !action is STRING)

  if (!action eq 'SELECT') then
    -- Track referenced element and then navigate there.
    !!ce = !gadget.selection().dbref()
    !this.init()
  endif

endmethod
-- End of method definition for .track()

------------------------------------------------------------------------
--
-- Method:      .track()
--
-- Description: Track CE callback
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .track()

  -- Track CE
  if (!this.track.val) then
    !this.init()
  endif

endmethod
-- End of method definition for .track()

------------------------------------------------------------------------
--
-- Method:      .navigate()
--
-- Description: Navigate to referenced element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .navigate(!element is STRING)

    !dbele = !element.dbref()
    handle any
      !!alert.error('Cannot navigate to the reference element')
      return
    endhandle
    if( !dbele.unset() ) then
      !!alert.error('Cannot navigate to the reference element. Reference is unset')
      return
    endif
    !!ce = !dbele
    handle any
      !!alert.error('Cannot navigate to the reference element')
    endhandle

endmethod
-- End of method definition for .track()
------------------------------------------------------------------------
--
-- Method:      .track()
--
-- Description: Track CE option
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget
--    2   R      STRING      Action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .track(!gadget is GADGET, !action is STRING)

  -- Initialise for the first time.
  if (!this.catCE.active) then
      !this.init()
  endif

  -- Tracking and CE buttons are mutually exclusive
  !this.catCE.active = !this.track.val.not()
  if (!this.setRefFrame.visible) then
    !this.refCE.active = (!this.refVal.active and !this.track.val.not())
  endif

endmethod
-- End of method definition for .track()

------------------------------------------------------------------------
--
-- Method:      .attribList()
--
-- Description: Attribute list callback
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget
--    2   R      STRING      Action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .attribList(!gadget is GADGET, !action is STRING)

  -- Ignore unselect
  if (!action neq |SELECT|) then
    return
  endif

  -- Hide all panels initially
  !this.setAttFrame.visible   = false
  !this.setStrFrame.visible   = false
  !this.setRefFrame.visible   = false
  !this.setLogFrame.visible   = false
  !this.setRealFrame.visible  = false
  !this.setDistanceFrame.visible  = false
  !this.setBoreFrame.visible  = false
  !this.messageFrame.visible  = false
  !this.paraMessage.val       = ''
  !this.logPad.val            = ' '
  !this.distancePad.val       = ' '
  !this.borePad.val           = ' '
  !this.realPad.val           = ' '
  !this.refPad.val            = ' '

  -- Get selected attribute and its value
  !this.attrib     = !gadget.selection()
  !value           = !this.element.attribute(!this.attrib)
  handle (2,201)
    !this.paraMessage.val      = !this.attrib + ': Cannot set this attribute using this form. Please use the appropriate application user interface to manage this attribute.'
    !this.messageFrame.visible = true
    return
  elsehandle (2,800)
    --P-19045: Fix for CORTAG and CORCGROUP attributes which need an integer qualifier
    !value           = !this.element.attribute(!this.attrib)[1]
    !valueObjectType = !value.objectType()
  elsehandle none
    !valueObjectType = !value.objectType()
  endhandle
  -- Use ATTDEF to get attribute definition
  !this.attributeDefinition.attLibGet(!this.attrib)
  if( !valueObjectType eq 'ARRAY' and  !this.attributeDefinition.iType eq 48 ) then
    -- unset type 48 expression
    !value.delete()
    !value = ''
    !valueObjectType = !value.objectType()
  endif
  -- Use PML1 to process dbref and array attributes such as PAXIS
  var !valString $!<this.attrib> of $!<this.element>
  handle (47,15)
    -- Added for length case, and where syntax matches a function.
    var !valString (attrib $!<this.attrib> of $!<this.element>)
  endhandle
  !attributeName = !this.attributeDefinition.name.upcase()
  !isWord        = (!this.attributeDefinition.type.upcase() eq 'WORD')
  -- Check for string attribute that should be constrained to one line
  !isOneLine     = !this.attributeDefinition.dbType.upcase().eq('INTEGER').and(!this.attributeDefinition.size.gt(1))
  -- Check for local name attributes that should be set on one line
  if (!attributeName inset(|AMAPNM|,|AMPMPN|)) then
    !isOneLine   = true
  endif
  -- check for distance and bore types
  !isPosition    = !this.attributeDefinition.type.upcase().eq('POSITION')
  !isOrientation = !this.attributeDefinition.type.upcase().eq('ORIENTATION')
  !isDistance    = !this.attributeDefinition.units.upcase().eq('DISTANCE') and !isPosition.not() and !isOrientation.not()
  !isBore        = !this.attributeDefinition.units.upcase().eq('BORE')
  !isReal        = !value.objectType().eq(|REAL|).and(!isDistance.not().and(!isBore.not()))
  if( !valueObjectType eq 'ARRAY' and !isOneLine.not() ) then
    if( !this.attributeDefinition.dbType.upcase() eq 'REFERENCE' ) then
      !isArray   = true
    else
      !isArray   = !this.attributeDefinition.units.upcase().neq('NONE')
    endif
  else
    !isArray     = false
  endif
  !isSystemAttribute = !this.systemAttributes.findFirst(!attributeName).set()

  if( !isArray ) then
    !this.paraMessage.val      = !this.attrib + ': Cannot set array attributes using this form. Please use the appropriate application user interface to manage this attribute.'
    !this.messageFrame.visible = true
    return
  elseif( !isSystemAttribute ) then
    !this.paraMessage.val      = !this.attrib + ': Cannot set protected system attributes using this form'
    !this.messageFrame.visible = true
    return
  endif

  -- Check for write access and modify DAC
  !dacmod = TRUE
  var !userName USER
  !user = object USER(!userName)
  if (!user.access ne |Free|) then
    var !dacmodString DACMOD $!<this.attrib>
    !dacmod        = !dacmodString.boolean()
  endif
  if( !dacmod ) then
    !this.dacmod.val = 'DAC Modify allowed'
  else
    !this.dacmod.val = 'DAC Modify denied '
  endif
  if( !!ce.dbwrit ) then
    !this.dbwrit.val = 'Write Permitted'
  else
    !this.dbwrit.val = 'Read only      '
  endif

  -- force !isSettable to be false for special attributes
  !isSettable      = !this.attributeDefinition.settable and !dacmod and !!ce.dbwrit
  -- flag all elements in shown-not-modify list to be read only. Name & Type are special case because the
  -- helpful message for the user should not be shown
  !isShowNotModify = !this.shownNotModified.findFirst(!attributeName).set() and  not !attributeName inset(|OWNER|, |TYPE|)
  !showNotModifyMessage = |Use appropriate application to set this attribute|
  !isSettable      = !isSettable and !isShowNotModify.not()

  -- Allow unset name
  if (!this.attrib.eqNoCase(|Name|)) then
    !isOneLine     = true
    -- name is a pseudo attribute, but it is a special case, so force it to be settable
    !isSettable    = true
    if (!!ce.isNamed) then
      !valString   = !!ce.namn
    else
      !valString   = |unset|
    endif
  endif

  -- disallow write for Marine proxy elements
  !ancestorList    = !!ce.ahList
  if( !ancestorList.empty() ) then
    !topType       = !!ce.hardtype
  else
    !topType       = !ancestorList[1]
  endif
  if( !this.marineProxyHierarchy.findFirst(!topType).set() ) then
    !isSettable           = false
    !isShowNotModify      = true
    !showNotModifyMessage = |Use hull application to set this attribute|
    !this.dbwrit.val      = 'Read only'
  endif

  -- Reference attribute
  if (!valueObjectType eq |DBREF|) then
    !this.setRefFrame.visible = true
    !this.setRefFrame.tag     = !this.attrib
    if (!value.set()) then
      !this.refVal.val = !valString
    else
      !this.refVal.val = |Nulref|
    endif
    !this.refVal.refresh()
    -- If cannot modify on this form...
    if(!isShowNotModify) then
      !this.refPad.val = !showNotModifyMessage
    endif
    -- Can't change owner
    !this.refVal.active    = (!!ce.dbwrit and !isSettable)
    !this.refCE.active     = (!this.refVal.active and !this.track.val.not())
    !this.refSearch.active = !this.refVal.active
    !this.setRef.active    = !this.refVal.active

  -- Expression attribute
  elseif (!isOneLine) then
    !this.setAttFrame.visible = true
    !this.setAttFrame.tag     = !this.attrib
    -- must be careful here - an unset expression returns an empty array
    -- but a set expression returns a string
  -- We need to allow if value is unset
  if(!value.unset().not()) then
    if (!value.empty()) then
      !this.attVal.val = ''
    else
      !this.attVal.val = !valString
    endif
  endif

    !this.attVal.refresh()
    -- If cannot modify on this form...
    if(!isShowNotModify) then
      !this.attVal.val = !showNotModifyMessage
    endif
    -- Can't change type
    !this.attVal.active = (!!ce.dbwrit and !isSettable)
    !this.setAtt.active = !this.attVal.active

  -- Logical attribute
  elseif (!valueObjectType eq |BOOLEAN|) then
    !this.setLogFrame.visible = true
    !this.setLogFrame.tag     = !this.attrib
    !this.logVal.val   = false
    if (!value.set()) then
      !this.logVal.val = !value
    endif
    !this.logVal.refresh()
    !this.logVal.active = (!!ce.dbwrit and !isSettable)
    !this.setLog.active = !this.logVal.active
    -- If cannot modify on this form...
    if(!isShowNotModify) then
      !this.logPad.val  = !showNotModifyMessage
    endif

  -- Real attribute
  elseif (!isReal) then
    !this.setRealFrame.visible = true
    !this.setRealFrame.tag     = !this.attrib
    !this.realVal.val    = !this.formatReal(!value)
    !this.realVal.refresh()
    !this.realVal.active = (!!ce.dbwrit and !isSettable)
    !this.setReal.active = !this.realVal.active
    -- If cannot modify on this form...
    if(!isShowNotModify) then
      !this.realPad.val  = !showNotModifyMessage
    endif

  -- Distance attribute
  elseif (!isDistance) then
    !this.setDistanceFrame.visible = true
    !this.setDistanceFrame.tag     = !this.attrib
    !this.distanceVal.val    = !value
    !this.distanceVal.refresh()
    !this.distanceVal.active = (!!ce.dbwrit and !isSettable)
    !this.setDistance.active = !this.distanceVal.active
    -- If cannot modify on this form...
    if(!isShowNotModify) then
      !this.distancePad.val  = !showNotModifyMessage
    endif

  -- Bore attribute
  elseif (!isBore) then
    !this.setBoreFrame.visible = true
    !this.setBoreFrame.tag     = !this.attrib
    !this.boreVal.val    = !value.string()
    !this.boreVal.refresh()
    !this.boreVal.active = (!!ce.dbwrit and !isSettable)
    !this.setBore.active = !this.boreVal.active
    -- If cannot modify on this form...
    if(!isShowNotModify) then
      !this.borePad.val  =!showNotModifyMessage
    endif

  -- String attribute
  elseif (!valueObjectType eq |STRING| and !isWord.not() and !isOneLine.not()) then
    !this.setStrFrame.visible = true
    !this.setStrFrame.tag     = !this.attrib
    if (!value.set()) then
      !this.strVal.val  = !value.split(!this.returnChar)
    else
      !this.strVal.clear()
    endif
    !this.strVal.refresh()
    -- If cannot modify on this form...
    if(!isShowNotModify) then
      !strMessage[1]    = !showNotModifyMessage
      !this.strVal.val  = !strMessage
    endif
    -- Can't change type
    !this.strVal.active = (!!ce.dbwrit and !isSettable)
    !this.setStr.active = !this.strVal.active

  -- Array or word or special case attribute
  else
    !this.setAttFrame.visible = true
    !this.setAttFrame.tag     = !this.attrib
    !this.attVal.val    = !valString
    !this.attVal.refresh()
    -- If cannot modify on this form...
    if(!isShowNotModify) then
      !this.attVal.val  = !showNotModifyMessage
    endif
    -- Can't change type
    !this.attVal.active = (!!ce.dbwrit and !isSettable)
    !this.setAtt.active = !this.attVal.active

  endif

endmethod
-- End of method definition for .attribList()

------------------------------------------------------------------------
--
-- Method:      .nameValidate()
--
-- Description: Check entered name
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .nameValidate()

  -- Check name
  if (!this.attVal.val.trim() eq ||) then
    !this.attVal.val = |unset|
  elseif (!this.attrib.eqNoCase(|Name|)) then
    !unusedName = !!checkName(!this.attVal.val, |NEW|)
  endif

endmethod
-- End of method definition for .nameValidate()

------------------------------------------------------------------------
--
-- Method:      refValidate
--
-- Description: Use typed name for reference
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refValidate()

  -- Validate name for selected reference attribute
  if (!this.refVal.val.trim().empty() or !this.refVal.val.lowcase() eq |unset| or !this.refVal.val.subString(1,2) eq |=0|) then
    !this.refVal.val = |Nulref|
  else
    !newValue = !!checkName(!this.refVal.val, |OLD|)
    if (!newValue.set()) then
      !index = !this.refAttributes.findFirst(!this.attrib)
      if (!index.set()) then
        if (!this.refTypes[!index].match(!newValue.dbref().type) eq 0) then
          !this.refresh()
          return error 1 |$!<newValue> is not of correct type|
        endif
      endif
    else
      !this.refresh()
    endif
  endif

endmethod
-- End of method definition for .refValidate()

------------------------------------------------------------------------
--
-- Method:      refCE
--
-- Description: Use CE for reference
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refCE()

  -- Validate CE for selected reference attribute
  !index = !this.refAttributes.findFirst(!this.attrib)
  if (!index.set()) then
    if (!this.refTypes[!index].match(!!ce.type) eq 0) then
      if (!this.attrib.eqNoCase(|Drssref|) and !!ce.type.eqNoCase(|DRSYLK|)) then
        DRSSET
      else
        return error 1 |$!!<ce.name> is not of correct type|
      endif
    endif
  endif
  !this.refVal.val = !!ce.flnn

endmethod
-- End of method definition for .refCE()

------------------------------------------------------------------------
--
-- Method:      .showSearch()
--
-- Description: Show search for drsylk
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showSearch()

  -- Set initial search data
  !index = !this.refAttributes.findFirst(!this.attrib)
  if (!index.set()) then
    !dbType    = !this.refDBTypes[!index]
    !searchFor = !this.refTypes[!index].split()
  else
    !dbType    = |CATA|
    !searchFor = ARRAY()
    !searchFor[1] = |SCOM|
  endif

  -- Setup search form
  if (undefined(!!catSearch) ) then
    pml load form !!catSearch
  endif
  !!catSearch.setup(!this.refVal, !this.attrib, !dbType, !searchFor)
  show !!catSearch

endmethod
-- End of method definition for .showSearch()

------------------------------------------------------------------------
--
-- Method:      .setAttribute()
--
-- Description: Set array or name or other attribute
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setAttribute()

  -- Set value for selected attribute and update form
  !attributeValue = !this.attVal.val
  !!ce = !this.element
  if (!this.attrib.eqNoCase(|Name|)) then
    if (!attributeValue eq |unset|) then
      UNNAME
    else
      if (!attributeValue ne !!ce.namn) then
        -- Check name again as not cleared when checked (to allow user to modify bad name)
        !newValue = !!checkName(!attributeValue, |NEW|)
        if (!newValue.set()) then
          NAME $!newValue
          handle any
            !!alert.error(!!error.text)
          endhandle
        endif
      endif
    endif
  elseif( !this.attributeDefinition.iType eq 48 ) then
    -- this is an expression attribute (note that there are other expression types
    -- that are set as general attributes, but these 48 attributes are special)
    !this.setExpression()
    handle any
      !!alert.error(!!error.text)
    endhandle
  elseif( !this.attributeDefinition.type.upcase() eq 'POSITION' ) then
    -- this is a position attribute
    !unusedTempPos = object POSITION(!attributeValue)
    handle any
      !!alert.error(|Value entered is not a valid position|)
    elsehandle none
      -- deal with WRT by using command. Do use PML 2 method to set attribute because position is assumed to be WRT WORLD
      $!<this.attrib> $!<attributeValue>
      handle any
        !!alert.error(!!error.text)
      endhandle
    endhandle
  else
    -- Use PML1 to process array or other attribute
    -- Note that the comment after this command must be retained. It absorbs unmatched string quotes.
    $!<this.attrib> $!<this.attVal.val>
    -- ILLEGAL USE OF STRING DELIMITER '
    handle (47,15) (47,62)
      -- Syntax error or incomplete command line
      !!alert.error(|Value entered is not valid for this attribute| + !!error.text)
    elsehandle (2,562)
      -- probably attempt to set a position expression. Try with ()
      -- beware that last command may have moved the CE
      !this.setExpression()
      handle any
        !!alert.error(!!error.text)
      endhandle
    elsehandle any
      !!alert.error(!!error.text)
    endhandle
  endif
  !this.refresh()

endmethod
-- End of method definition for .setAttribute()

------------------------------------------------------------------------
--
-- Method:      .setExpression()
--
-- Description: Set expression attribute
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setExpression()

  -- Set value for selected attribute and update form
  !!ce = !this.element

  -- check for unset expression
  if( !this.attVal.val.upcase() eq 'UNSET' ) then
    $!<this.attrib> UNSET
  else
    -- handle any error in calling method
    $!<this.attrib> ( $!<this.attVal.val> )
    handle any
      !!alert.error(!!error.text)
    endhandle
  endif

endmethod
-- End of method definition for .setAttribute()

------------------------------------------------------------------------
--
-- Method:      .setString()
--
-- Description: Set string attribute
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setString()

  -- Set value for selected attribute and update form
  !!ce = !this.element
  !value = object STRING()
  do !line values !this.strVal.val
    if (!value.unset()) then
      !value = !line
    else
      !value = !value & !this.returnChar & !line
    endif
  enddo

  -- No vertical bar string delimiter allowed in string
  !value = !value.replace('|',' ')

  $!<this.attrib> |$!value|
  handle (16,39)
    -- Dataset expressions of type TEXT cannot be used as RPROPs.
    -- Try passing the value directly instead of enclosing it with ||
    $!<this.attrib> $!value
    handle (47,15) (47,62)
      -- Syntax error or incomplete command line
      !!alert.error(|Value entered is not valid for this attribute|)
    endhandle
  endhandle
  !this.refresh()

endmethod
-- End of method definition for .setString()

------------------------------------------------------------------------
--
-- Method:      .setReference()
--
-- Description: Set reference attribute
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setReference()

  -- Revalidate and set value for selected reference attribute and update form
  !!ce = !this.element
  if (!this.refVal.val ne |Nulref|) then
    !newValue = !!checkName(!this.refVal.val, |OLD|)
    if (!newValue.set()) then
      $!<this.attrib> $!newValue
      handle any
        !!alert.error(!!error.text)
      endhandle
    endif
  else
    $!<this.attrib> Nulref
    handle any
      !!alert.error(!!error.text)
    endhandle
  endif
  !this.refresh()

endmethod
-- End of method definition for .setReference()

------------------------------------------------------------------------
--
-- Method:      .setLogical()
--
-- Description: Set logical attribute
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setLogical()

  -- Set value for selected attribute
  !!ce = !this.element
  if (!this.attrib.eqNoCase(|LOCK|)) then
    if (!this.logVal.val) then
      LOCK
    else
      UNLOCK
    endif
  else
    $!<this.attrib> $!<this.logVal.val>
  endif
  !this.refresh()

endmethod
-- End of method definition for .setLogical()

------------------------------------------------------------------------
--
-- Method:      .setReal()
--
-- Description: Set real attribute
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setReal()

  -- Set value for selected attribute
  !value           = !this.realVal.val
  !unusedRealValue = !value.real()
  handle any
    !!alert.error(|Value entered is not a valid real number|)
  elsehandle none
    !!ce = !this.element
    $!<this.attrib> $!<value>
    handle (47,15) (47,62)
      -- Syntax error or incomplete command line
      !!alert.error(|Value entered is not valid for this attribute|)
    elsehandle any
      !!alert.error(!!error.text)
    endhandle
  endhandle
  !this.refresh()

endmethod
-- End of method definition for .setReal()

------------------------------------------------------------------------
--
-- Method:      .setDistance()
--
-- Description: Set distance attribute
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDistance()

  -- Set value for selected attribute
  !this.setNumeric(!this.distanceVal.val)

endmethod
-- End of method definition for .setDistance()

------------------------------------------------------------------------
--
-- Method:      .setBore()
--
-- Description: Set bore attribute
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setBore()

  -- Set value for selected attribute
  !!ce = !this.element
  if( !this.boreVal.val.trim().empty() or !this.boreVal.val.trim().upcase() eq |UNSET| ) then
    $!<this.attrib> 0
    !this.refresh()
    return
  endif
  !boreString = !this.boreVal.val
  !unusedBore = object BORE(!this.boreVal.val,!!boreFmt)
  handle(2,820) (2,808)
    !realMetricBore = object REAL(!this.boreVal.val,!!boreFmt)
    handle any
      !!alert.error(|Value entered is not valid for this attribute|)
      !this.refresh()
      return
    endhandle
    if( !!isImperialLength('BORE') ) then
      !realBore = !realMetricBore / 25.4
    else
      !realBore = !realMetricBore
    endif
    !boreString = !realBore.nearestBore().string()
  elsehandle(2,813)
    !!alert.error(|Value entered is not valid for this attribute|)
    !this.refresh()
    return
  endhandle

  $!<this.attrib> $!<boreString>
  handle (47,15) (47,62)
    -- Syntax error or incomplete command line
    !!alert.error(|Value entered is not valid for this attribute|)
  elsehandle any
    !!alert.error(!!error.text)
  endhandle
  !this.refresh()

endmethod
-- End of method definition for .setBore()

------------------------------------------------------------------------
--
-- Method:      .setNumeric()
--
-- Description: Set real attribute
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setNumeric(!value is REAL)

  -- Set value for selected attribute
  !!ce = !this.element
  $!<this.attrib> $!<value>
  handle (47,15) (47,62)
    -- Syntax error or incomplete command line
    !!alert.error(|Value entered is not valid for this attribute|)
  elsehandle any
    !!alert.error(!!error.text)
  endhandle
  !this.refresh()

endmethod
-- End of method definition for .setNumeric()

------------------------------------------------------------------------
--
-- Method:      .formatReal()
--
-- Description: Prepare a real number for presentation to the user
--              as a string
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .formatReal(!value is REAL) is STRING

  -- Deal with double precision number presentation by rounding
  -- to six decimal places
  !stringValue  = !value.string('D6')
  --remove training zeros
  !stringLength = !stringValue.length()
  do !index to !stringValue.length()
    if(!stringValue.subString(!stringLength,1) eq '0' ) then
      -- 0 at end of string - remove it
      !stringLength = !stringLength - 1
    elseif(!stringValue.subString(!stringLength,1) eq '.' ) then
      -- found training decimal point
      !stringLength = !stringLength - 1
      break
    else
      -- finished trimming zeros
      break
    endif
  enddo
  if(!stringLength eq 0) then
    !stringValue = '0'
  else
    !stringValue = !stringValue.subString(1,!stringLength)
  endif
  return !stringValue

endmethod
-- End of method definition for .formatReal()

------------------------------------------------------------------------
--
-- Method:      .refresh()
--
-- Description: Refresh form after update
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .refresh()

  -- Refresh form and select same attribute
  !attrib = !this.attrib
  !!ce = !this.element
  !this.init()

  !this.attribList.select(|Rtext|, !attrib)
  handle any
    return
  endhandle
  !this.attribList(!this.attribList, |SELECT|)

endmethod
-- End of method definition for .refresh()

------------------------------------------------------------------------
--
-- Method:      .updateUndo()
--
-- Description: Refresh form after undo/redo
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateUndo()

  -- Refresh form and select same attribute
  if( !this.shown() ) then
    !this.refresh()
  endif

endmethod
-- End of method definition for .updateUndo()
