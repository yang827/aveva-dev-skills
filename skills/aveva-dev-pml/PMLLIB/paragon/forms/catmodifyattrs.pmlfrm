--
--  Description:     Modify All Attributes for a given element, controls setting of a given attribute.
--
------------------------------------------------------------------------
--
setup form !!catmodifyattrs dialog docking

  !this.formTitle     = 'Modify All Attributes'
  !this.iconTitle     = 'Attrib'
  !this.callback      = ''
  !this.cancelCall    = '!this.cancel()'
  !this.initcall      = '!this.init()'
  !this.formRevision  = ' $Revision$ '

  -- Martin's Task Pane
  frame .mainPanel panel anchor all at x0                 y0

    list      .list   anchor all                at x0.5               ymax callback |!this.setFields()|     columns   height 20 width 30

    button    .linkAttribute linklabel 'Attribute' anchor l+b at x0.5               ymax.list+0.75 width 6
    para      .attrib at xmax.linkAttribute ymax.list+0.55    text '          '

    button    .linkValue linklabel 'Value' anchor l+b        at x0.5               ymax.attrib+0.5                          width 6
    text      .value   ''   anchor right + l+b               at xmax.linkValue     ymin.linkValue  call |!this.setValue()|  width 24 is STRING

    button    .linkSet 'Apply' anchor l+b   at x0.5            ymax.value+0.5 call |!this.setValue()|   width 7
    button    .linkDis 'Cancel' anchor r+b  at xmax form-size  ymax.value+0.5 call ||                   width 7 cancel

  exit

track |PROPCE| call |!this.auto()|
track |CATACE| call |!this.auto()|

  exit

-- ==============================================================================================================

  define method .auto()

      var !data attlist
      !list    = ARRAY()
      !list[1] = ARRAY()
      !list[2] = ARRAY()

      do !val value !data
         !list[1].append(!val)
         var !arg $!val of ce
         handle (47,15)
           !arg = 'Not Handled'
         endhandle
         !list[2].append(!arg)
      enddo

!headers[1] = 'Attribute'
!headers[2] = 'Value'
!this.list.setHeadings(!headers)
!this.list.setcolumns(!list)

endmethod

-- ==============================================================================================================

  define method .init()

    !this.auto()

  endmethod

-- ==============================================================================================================

  define method .setValue()

    !cmnd = !this.attrib.val & ' ' & !this.value.val
    $!cmnd
    handle (47,15)
       -- Try a slash for name.
        !cmnd = !this.attrib.val & ' /' & !this.value.val
       $!cmnd
        handle (47,15)
          -- Try quotes.
               !cmnd = !this.attrib.val & ' |' & !this.value.val & '|'
              $!cmnd
                handle (47,15)
                    -- Try Brackets.
                       !cmnd = !this.attrib.val & ' (' & !this.value.val & ')'
                      $!cmnd
                      handle (47,15)
                         -- Nah didn't work, try again.
                         !!alert.message('Something wrong with "$!cmnd", - Try again')
                      endhandle
                endhandle
        endhandle
    endhandle

    !this.auto()

  endmethod

-- ==============================================================================================================

  define method .setFields()

    !this.attrib.val = !this.list.selection().split('	')[1]
    !this.value.val  = !this.list.selection().split('	')[2]

  endmethod

-- ==============================================================================================================

  define method .cancel()

    kill !!catmodifyattrs

  endmethod
