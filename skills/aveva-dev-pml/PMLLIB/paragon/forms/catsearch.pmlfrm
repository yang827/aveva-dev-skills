--
-- Description:
-- Generic search form for catalogue
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply form
--  catSearch()                      -                   Constructor
--  init()                           -                   Initialise form
--  partResultsSelected(ARRAY)       -                   After select event for search control on the passed form
--  setup(GADGET,STRING,STRING,ARRAY) -                   Setup form
--
------------------------------------------------------------------------
-- Import search control
import 'PMLDBSearch'
handle any
endhandle

setup form !!catSearch

  !this.formTitle     = 'Search'
  !this.iconTitle     = 'Search'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.00 $ '

  -- Define search control namespace
  using namespace 'Aveva.Pdms.Presentation.PMLDBSearchCtrl'

  -- Search control
  container .conSearch nobox PmlNetControl |Search| width 70 height 10

  -- Buttons
  button .apply  |Use Result| at xmin form ymax+0.5  width 8
  button .cancel |Close|      at xmax form-size ymin width 6 ok

  -- Gadget on calling form
  member .callingGadget   is GADGET

  -- Search control members
  member .SearchControl   is PMLDBSearchCtrl
  member .SearchObj       is SearchDefn
  member .searchAttribute is STRING
  member .searchFor       is ARRAY
  member .searchResults   is ARRAY

exit
-- End of form definition for !!catSearch

------------------------------------------------------------------------
--
-- Method:      .catSearch()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .catSearch()

  -- Define search control namespace
  using namespace 'Aveva.Pdms.Presentation.PMLDBSearchCtrl'

  -- Search panel callbacks
  !this.apply.callback        = |!this.apply()|

  -- Create instance of search control
  !this.SearchControl = object PMLDBSearchCtrl()
  !this.SearchControl.addeventhandler('ResultsSelectedEvent', !this, 'partResultsSelected')
  !this.conSearch.control = !this.SearchControl.handle()

endmethod
-- End of method definition for .catSearch()

------------------------------------------------------------------------
--
-- Method:      .setup()
--
-- Description: Setup form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Calling form gadget
--    2   R      STRING      Tag for frame
--    3   R      STRING      DB Type
--    4   R      ARRAY       Types to search for
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setup(!callingGadget is GADGET, !tag is STRING, !dbType is STRING, !searchFor is ARRAY)

  -- Set search info
  !this.callingGadget = !callingGadget
  !this.formTitle     = |Search for | & !tag
  !this.searchFor     = !searchFor
  !this.apply.active  = false

  -- Define search scope
  !searchIn    = ARRAY()
  !searchIn[1] = |/*|
  -- Define filter statements (attribute operator value)
  !filters    = ARRAY()
  !filters[1] = |NAME like *|
  -- Define results columns (attribute heading)
  !columns    = ARRAY()
  !columns[1] = |NAME Name|
  !columns[2] = |OWNER Owner|
  -- Set search control to stay on settings and not switch direct to results
  !displayResults = false
  !this.SearchControl.InitiateSearch(!displayResults, |Search|, !dbType, !searchIn, !searchFor, !filters, !columns)

endmethod
-- End of method definition for .setup(GADGET, STRING, STRING, ARRAY)

------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: Initialise form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()


endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      partResultsSelected
--
-- Description: After select event for search control on the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Search results data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .partResultsSelected(!data is ARRAY)

  -- !data[0], [1], etc are strings of selected dbrefs from search results
  -- Store selected results as form member dbref array
  !this.searchResults.clear()
  do !i from 0 to (!data.size() - 1)
    break if (!data[!i].unset())
    !element = !data[!i].dbref()
    handle any
      -- Ignore if badref
    elsehandle none
      if (!this.searchFor.findFirst(!element.type).unset()) then
        !!alert.error(!element.namn & | is not of correct type|)
      else
        !this.searchResults.append(!element)
      endif
    endhandle
  enddo

  -- Activate gadget
  !this.apply.active = (!this.searchResults.size() eq 1)

endmethod
-- End of method definition for .partResultsSelected(FORM, ARRAY)

------------------------------------------------------------------------
--
-- Method:      .apply()
--
-- Description: Apply form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  -- Set calling form text to selected result
  if (!this.searchResults[1].set()) then
    !this.callingGadget.val = !this.searchResults[1].namn
  endif

endmethod
-- End of method definition for .apply()
