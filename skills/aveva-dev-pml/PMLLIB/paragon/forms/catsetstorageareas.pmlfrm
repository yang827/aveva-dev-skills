-- End of form definition for !!catsetstorageareas

------------------------------------------------------------------------
--
-- Method:      catsetstorageareas
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .catsetstorageareas()

  -- Define area keys for corresponding form gadgets
  -- Piping
  !this.areaKeys.append('PIPECATE~SECT')
  !this.areaKeys.append('PIPEPRTELE~PRTWLD PRTELE')
  !this.areaKeys.append('PIPESPEC~SPWL')
  !this.areaKeys.append('PIPETABLE~TABWLD')
  !this.areaKeys.append('PIPECOMP~CMPT')
  !this.areaKeys.append('PIPEMATL~MATW')
  !this.areaKeys.append('PIPEPTSE~SECT CATE')
  !this.areaKeys.append('PIPEGMSE~SECT CATE')
  !this.areaKeys.append('PIPEBTSE~SECT CATE')
  !this.areaKeys.append('PIPEDTSE~SECT CATE')
  !this.areaKeys.append('PIPESDTE~SECT CATE')
  !this.areaKeys.append('PIPESMTE~SECT CATE')
  -- Structural
  !this.areaKeys.append('STRUSTCA~STSE')
  !this.areaKeys.append('STRUPRTELE~PRTWLD PRTELE')
  !this.areaKeys.append('STRUSPEC~SPWL')
  !this.areaKeys.append('STRUCOMP~CMPT')
  !this.areaKeys.append('STRUMATL~MATW')
  !this.areaKeys.append('STRUPTSE~STSE STCA')
  !this.areaKeys.append('STRUPTSS~STSE STCA')
  !this.areaKeys.append('STRUGMSE~STSE STCA')
  !this.areaKeys.append('STRUGMSS~STSE STCA')
  !this.areaKeys.append('STRUNGMS~STSE STCA')
  !this.areaKeys.append('STRUDTSE~STSE STCA')
  -- Equipment
  !this.areaKeys.append('EQUICATE~SECT')
  !this.areaKeys.append('EQUIPRTELE~PRTWLD PRTELE')
  !this.areaKeys.append('EQUITABGRO~SPWL')

  -- Set storage area gadget callbacks
  do !val values !this.areaKeys
    !key = !val.part(1,'~')
    !textFieldName = |TX| & !key
    !this.attribute(!textFieldName).callback = |!this.actionTextField(|
    !ceButtonName = |BN| & !key
    !this.attribute(!ceButtonName).callback = |!this.actionCeButton(|
  enddo

  -- set other callbacks
  !this.bnApply.callback = |!this.actionApply()|
  !this.bnOk.callback = |!this.actionOk()|

  -- File menus
  !fileMenu = !this.newMenu(|fileMenu|)
  !fileMenu.add(|MENU|, |Save|, |saveLocationMenu|, |SAVE|)
  !fileMenu.add(|MENU|, |Load|, |loadLocationMenu|, |LOAD|)
  --!fileMenu.add(|SEPARATOR|)
  --!fileMenu.add(|MENU|, |Location|, |locationMenu|)
  --!locationMenu = !this.newMenu(|locationMenu|)
  --!locationMenu.add(|TOGGLE|, |User|,    |!this.actionMenu(|, |USER|)
  --!locationMenu.add(|TOGGLE|, |Project|, |!this.actionMenu(|, |PROJ|)
  --!locationMenu.add(|TOGGLE|, |AVEVA|,    |!this.actionMenu(|, |PDMS|)
  !saveLocationMenu = !this.newMenu(|saveLocationMenu|)
  !saveLocationMenu.add(|CALLBACK|, |User|,    |!this.actionMenu(|, |SAVEUSER|)
  !saveLocationMenu.add(|CALLBACK|, |Project|, |!this.actionMenu(|, |SAVEPROJ|)
  !saveLocationMenu.add(|CALLBACK|, |AVEVA|,    |!this.actionMenu(|, |SAVEPDMS|)
  !loadLocationMenu = !this.newMenu(|loadLocationMenu|)
  !loadLocationMenu.add(|CALLBACK|, |User|,    |!this.actionMenu(|, |LOADUSER|)
  !loadLocationMenu.add(|CALLBACK|, |Project|, |!this.actionMenu(|, |LOADPROJ|)
  !loadLocationMenu.add(|CALLBACK|, |AVEVA|,    |!this.actionMenu(|, |LOADPDMS|)
  -- Set save active status depending on user admin status
  if (!!comAdminStatus().not()) then
    !this.saveLocationMenu.setFieldProperty(|SAVEPROJ|, |ACTIVE|, false)
    !this.saveLocationMenu.setFieldProperty(|SAVEPDMS|, |ACTIVE|, false)
  endif

  -- Set location name to the one loaded in !!comDefineGlobal
  if (defined(!!catStorageAreas)) then
    !this.dfltFileArea = !!catStorageAreas.dfltArea
  else
    !this.dfltFileArea = |PDMS|
  endif

  !this.formMainTitle = !this.formTitle

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .initialise()

  -- Ensure the global store exists
  if (undefined(!!catStorageAreas)) then
    !!comDefineGlobal(object CATSTORAGEAREAS())
  endif

  -- Synchronise form with global store
  do !val values !this.areaKeys
    !key = !val.part(1,'~')
    !gadgetName = |TX| & !key
    !dbref = !!catStorageAreas.getArea(!key)
    if (!dbref.badref()) then
      !this.attribute(!gadgetName).clear()
    else
      !this.attribute(!gadgetName).val = !dbref.namn
    endif
  enddo

  -- Set default file area to form name
  !this.formTitle = !this.formMainTitle & ' (' & !!catStorageAreas.dfltArea.replace(|PDMS|, |AVEVA|) & ')'

  -- set current tab for the application
  -- if there is no tab for an application then let it default to last selected tab
  !currentApplication = !!appCntrl.currentApp
  if( !currentApplication eq 'STL' ) then
    !this.frStructural.visible = true
  elseif( !currentApplication eq 'EQUI' ) then
    !this.frEquipment.visible = true
  elseif( !currentApplication eq 'PIPE' ) then
    !this.frPipework.visible = true
  endif

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      actionTextField
--
-- Description: Callback action for text fields
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .actionTextField(!object is GADGET,  !action is STRING)

  if (!action eq |SELECT|) then

    -- Get key and allowed types for the storage area
    !areaKey = !object.name().after('TX')
    do !val values !this.areaKeys
      if (!val.part(1,'~') eq !areaKey) then
        !types = !val.part(2,'~')
        break
      endif
    enddo

    -- Validate the reference
    !refName = !!catValidateRefField(!object, !types)

    -- Text field cleared by user so unset the storage area
    if (!refName.unset()) then
      !!catStorageAreas.clearArea(!areaKey)

    -- Invalid name entered so restore the previous storage area
    elseif (!refName.empty()) then
      !prevArea = !!catStorageAreas.getArea(!areaKey)
      if (!prevArea.set()) then
        !object.val = !prevArea.namn
      endif

    endif

  endif

endmethod
-- End of method definition for .actionTextField(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      actionCeButton
--
-- Description: Callback action for CE buttons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .actionCeButton(!object is GADGET,  !action is STRING)

  if (!action eq |SELECT|) then

    -- Get key and allowed types for the storage area
    !areaKey = !object.name().after('BN')
    do !val values !this.areaKeys
      if (!val.part(1,'~') eq !areaKey) then
        !types = !val.part(2,'~')
        break
      endif
    enddo

    -- Check CE is a valid type for the storage area
    if (!types.occurs(!!ce.type) eq 0) then
      !!alert.warning(|Specified reference is not the correct type, a $!<types> reference is required!|)
    else
      !this.attribute('TX' & !object.name().substring(3)).val = !!ce.namn
    endif

  endif

endmethod
-- End of method definition for .actionCeButton(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      actionApply
--
-- Description: Callback action for Apply button
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .actionApply()

  do !val values !this.areaKeys
    !areaKey = !val.part(1,'~')
    !refName = !this.attribute('TX' & !areaKey).val
    if (!refName.set()) then
      if (!refName.substring(1,1) eq '=') then
        !dbref = object DBREF(!refName)
      else
        !dbref = object DBREF('/' & !refName)
      endif
      !types = !val.part(2,'~').split()
      !!catStorageAreas.setArea(!areaKey, !dbref, !types)
    endif
  enddo

endmethod
-- End of method definition for .actionApply()

------------------------------------------------------------------------
--
-- Method:      actionOk
--
-- Description: Callback action for OK button
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .actionOk()

  !this.actionApply()

endmethod
-- End of method definition for .actionOk()

------------------------------------------------------------------------
--
-- Method:      actionMenu
--
-- Description: Callback action for menu bar
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .actionMenu(!object is MENU,  !action is STRING)

  if (!object eq !this.loadLocationMenu and !action eq |SELECT|) then
    if (!object.pickedFieldName eq |LOADUSER|) then
      !location = |USER|
    elseif (!object.pickedFieldName eq |LOADPROJ|) then
      !location = |PROJ|
    elseif (!object.pickedFieldName eq |LOADPDMS|) then
      !location = |PDMS|
    endif
    !!catStorageAreas.loadFile(!location)
    !this.initialise()
  elseif (!object eq !this.saveLocationMenu and !action eq |SELECT|) then
    if (!object.pickedFieldName eq |SAVEUSER|) then
      !location = |USER|
    elseif (!object.pickedFieldName eq |SAVEPROJ|) then
      !location = |PROJ|
    elseif (!object.pickedFieldName eq |SAVEPDMS|) then
      !location = |PDMS|
    endif
    !!catStorageAreas.saveFile(!location)
    !this.initialise()
  endif

endmethod
-- End of method definition for .actionMenu(menu, STRING)
