      para .paPipeTable text |(TABWLD)| width 13
      text .txPipeComp tagwid 11 |Component| at xmin.txPipeTable ymax+0.25 width 30 is STRING
      button .bnPipeComp |CE| width 2
      para .paPipeComp text |(CMPT)| width 13
      text .txPipeMatl tagwid 11 |Material| at xmin.txPipeComp ymax+0.25 width 30 is STRING
      button .bnPipeMatl |CE| width 2
      para .paPipeMatl text |(MATW)| width 13
      line .lnPipe1 at xmin.txPipeMatl ymax+0.25 horiz width 42 height
      text .txPipePtse tagwid 11 |P-Point Set| at xmin.txPipeMatl ymax+0.25 width 30 is STRING
      button .bnPipePtse |CE| width 2
      para .paPipePtse text |(SECT/CATE)| width 13
      text .txPipeGmse tagwid 11 |Geometry Set| at xmin.txPipePtse ymax+0.25 width 30 is STRING
      button .bnPipeGmse |CE| width 2
      para .paPipeGmse text |(SECT/CATE)| width 13
      text .txPipeBtse tagwid 11 |Bolt Set| at xmin.txPipeGmse ymax+0.25 width 30 is STRING
      button .bnPipeBtse |CE| width 2
      para .paPipeBtse text |(SECT/CATE)| width 13
      text .txPipeDtse tagwid 11 |Data Set| at xmin.txPipeBtse ymax+0.25 width 30 is STRING
      button .bnPipeDtse |CE| width 2
      para .paPipeDtse text |(SECT/CATE)| width 13
      line .lnPipe2 at xmin.txPipeMatl ymax+0.25 horiz width 42 height 1
      text .txPipeSdte tagwid 11 |Detail Text| at xmin.txPipeDtse ymax+0.25 width 30 is STRING
      button .bnPipeSdte |CE| width 2
      para .paPipeSdte text |(SECT/CATE)| width 13
      text .txPipeSmte tagwid 11 |Material Text| at xmin.txPipeSdte ymax+0.25 width 30 is STRING
      button .bnPipeSmte |CE| width 2
      para .paPipeSmte text |(SECT/CATE)| width 13
    exit

    frame .frStructural |Structural| at xmin.frTabset ymin.frTabset dock fill
      text .txStruStca tagwid 11 |Category| width 30 is STRING
      button .bnStruStca |CE| width 2
      para .paStruStca text |(STSE)| width 13
      text .txStruPrtele tagwid 11 |Part Family| at xmin.txStruStca ymax+0.25 width 30 is STRING
      button .bnStruPrtele |CE| width 2
      para .paStruPrtele text |(PRTWLD/PRTELE)| width 13
      text .txStruSpec tagwid 11 |Specification| at xmin.txStruPrtele ymax+0.25 width 30 is STRING
      button .bnStruSpec |CE| width 2
      para .paStruSpec text |(SPWL)| width 13
      text .txStruComp tagwid 11 |Component| at xmin.txStruSpec ymax+0.25 width 30 is STRING
      button .bnStruComp |CE| width 2
      para .paStruComp text |(CMPT)| width 13
      text .txStruMatl tagwid 11 |Material| at xmin.txStruComp ymax+0.25 width 30 is STRING
      button .bnStruMatl |CE| width 2
