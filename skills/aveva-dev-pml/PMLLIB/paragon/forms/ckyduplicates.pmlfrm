--
--
-- Description:
-- Show duplicates in CCTABLEs
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  setList(ARRAY)                   -                   Set the list of duplicates
--
------------------------------------------------------------------------

setup form !!ckyDuplicates
  !!ckyDuplicates.formTitle      = 'Duplicate CTypes'
  !!ckyDuplicates.iconTitle      = 'Duplicates'
  !!ckyDuplicates.callback       = ''
  !!ckyDuplicates.formRevision   = ' $Revision: 1.3 $ '

  frame .dupFrame 'Duplicates' at xmin ymax + 0.2
    textpane .duplicates at xmin + 1 ymax width 60 height 10
  exit

  vdist 1
  path down
  halign left

  button .dismiss 'Dismiss' at xmax.dupFrame - 7 CANCEL

exit

-- End of form definition for !!ckyDuplicates

------------------------------------------------------------------------
--
-- Method:      setList(ARRAY)
--
-- Description: Set the list of duplicates
--
-- Method Type: Procedure
-- Arguments:
--   1  R  ARRAY(STRING) List of duplicate strings
--
------------------------------------------------------------------------

define method .setList(!dupArray is ARRAY)
  !this.duplicates.val = !dupArray
endmethod
-- End of method definition for .setList(ARRAY)
