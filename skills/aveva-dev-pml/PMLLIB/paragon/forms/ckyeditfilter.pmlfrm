-- File:            ckyeditfilter.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        paragon
--   Replaces:
--
-- Author:          S.Bourne
-- Created:         Tue Jul 7 10:45:10 BST 1998
--
--
-- Description:
-- Edit filter for COCO elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkCType1()                    -                   Check the value in the CType1 gadget is valid
--  checkCType2()                    -                   Check the value in the CType2 gadget is valid
--  ckyEditFilter()                  -                   Set gadget values to define a filter that lets everything through
--  updateFilter()                   -                   Set the filter object in !!ckyMainForm
--
------------------------------------------------------------------------

setup form !!ckyEditFilter
  !!ckyEditFilter.formTitle     = 'Edit Filter'
  !!ckyEditFilter.iconTitle     = 'Filter'
  !!ckyEditFilter.callback      = ''
  !!ckyEditFilter.formRevision  = ' $Revision: 1.5 $ '

  -- CType Filters
  frame .cType 'CType Filters'
    path down
    vdist 1

    text .cType1 'CType(1)' callback '!this.checkCType1()' width 6 STRING

    path down
    vdist 0.3

    option .andOr '        ' width 5

    text .cType2 'CType(2)' callback '!this.checkCType2()' width 6 STRING
  exit

  -- CKey Filters
  frame .cKey 'CKey Filter' at xmax.cType + 1 ymin.cType width 14
    path down
    vdist 1

    toggle .pl 'PL' at xmin.cKey + 2

    vdist 0.2

    toggle .fl 'FL'
    toggle .bw 'BW'
    toggle .sw 'SW'
    toggle .cp 'CP' at xmax.pl + 4 ymin.pl
    toggle .sc 'SC'
    toggle .unset 'Unset'
  exit

  button .ok '  OK  ' at xmin.cType ymax.cKey + 1 callback '!this.updateFilter()' OK

  path right
  hdist 22

  button .cancel 'Cancel' CANCEL
exit

-- End of form definition for !!ckyEditFilter

------------------------------------------------------------------------
--
-- Method:      .ckyEditFilter
--
-- Description: Set gadget values to define a filter that lets everything through
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .ckyEditFilter()
  -- Default is to let everything through
  !this.cType1.val = '*'
  !this.cType2.val = '*'
  !this.pl.val = TRUE
  !this.fl.val = TRUE
  !this.bw.val = TRUE
  !this.sw.val = TRUE
  !this.cp.val = TRUE
  !this.sc.val = TRUE
  !this.unset.val = TRUE

  !andOrArray = ARRAY()
  !andOrArray.append ('And')
  !andOrArray.append ('Or')

  !this.andOr.dText = !andOrArray

  if (!!ckyMainForm.filter.useAnd) then
    !this.andOr.select('DTEXT','And')
  else
    !this.andOr.select('DTEXT','Or')
  endif
endmethod
-- End of method definition for .ckyEditFilter()


------------------------------------------------------------------------
--
-- Method:      .updateFilter
--
-- Description: Set the filter object in !!ckyMainForm
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .updateFilter()
  -- Set the filter object in !!ckyMainForm
  !!ckyMainForm.filter.cType1 = !this.cType1.val
  !!ckyMainForm.filter.cType2 = !this.cType2.val
  !!ckyMainForm.filter.pl = !this.pl.val
  !!ckyMainForm.filter.fl = !this.fl.val
  !!ckyMainForm.filter.bw = !this.bw.val
  !!ckyMainForm.filter.sw = !this.sw.val
  !!ckyMainForm.filter.cp = !this.cp.val
  !!ckyMainForm.filter.sc = !this.sc.val
  !!ckyMainForm.filter.unset = !this.unset.val

  if (!this.andOr.selection ('DTEXT') EQ 'And') then
    !!ckyMainForm.filter.useAnd = TRUE
  else
    !!ckyMainForm.filter.useAnd = FALSE
  endif

  !!ckyMainForm.update()
endmethod
-- End of method definition for .updateFilter()


------------------------------------------------------------------------
--
-- Method:      .checkCType1
--
-- Description: Check the value in the CType1 gadget is valid
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .checkCType1()
  if (!this.cType1.val eq '') then
    !this.cType1.val = '*'
  endif
endmethod
-- End of method definition for .checkCType1()


------------------------------------------------------------------------
--
-- Method:      .checkCType2
--
-- Description: Check the value in the CType2 gadget is valid
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .checkCType2()
  if (!this.cType2.val eq '') then
    !this.cType2.val = '*'
  endif
endmethod
-- End of method definition for .checkCType2()
