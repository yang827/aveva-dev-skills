-- Created:         Tue Jul 7 10:45:10 BST 1998
--
--
-- Description:     Main form for defining CKey's on COCO elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  changeCe(DBREF)                  -                   Change the current element
--  ckyMainForm(DBREF)               -                   constructor
--  deleteElem()                     -                   Delete all selected elements from the database
--  modifyCKey()                     -                   Bring up a form to modify the ckey of selected coco elements
--  modifyCKey(STRING)               -                   Modify the CKey of selected COCO elements
--  selectAll()                      -                   Select everything in the coco element list
--  setFilter()                      -                   Show a form to set filter values
--  unSelectAll()                    -                   Unselect everything in the coco element list
--  update()                         -                   Update the display and CKYCOCOELEM object with the current filter
--
------------------------------------------------------------------------

setup form !!ckyMainForm
  !!ckyMainForm.formTitle    = 'Edit CKeys'
  !!ckyMainForm.iconTitle    = 'Edit CKeys'
  !!ckyMainForm.callback     = ''
  !!ckyMainForm.formRevision = ' $Revision: 1.10 $ '

  -- Coco table object
  member .cocoTable is CKYCOCOTABLE

  -- Filter object to filter coco table
  member .filter is CKYFILTER

  path right
  hdist 1

  button .ce at xmin + 1 ymin + 0.5 callback '!this.changeCe(!!ce)'

  paragraph .ceText width 30

  path down
  vdist 0

  frame .setCKeys 'Set CKeys' at xmin.ce
    vdist 1

    button .filterButton 'Filter...' callback '!this.setFilter()'

    path right
    hdist 1

    button .selectAll 'Select All' callback '!this.selectAll()'

    button .unSelectAll 'Unselect All' callback '!this.unSelectAll()'

    path down
    vdist 1

    list .cocoElemList 'CType(1) CType(2) CKey    Name' at xmin.filterButton multiple width 38 length 16
  exit

  path down
  vdist 1

  button .modify 'Modify CKey...' at xmin.ce callback '!this.modifyCKey()' APPLY

  path right
  hdist 1

  button .delete 'Delete' callback '!this.deleteElem()'

  path right
  hdist 11

  button .dismiss 'Dismiss' CANCEL
exit

-- End of form definition for !!ckyMainForm

------------------------------------------------------------------------
--
-- Method:      .ckyMainForm(DBREF)
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .ckyMainForm(!ref is DBREF)
  !this.changeCe(!ref)
endmethod
-- End of method definition for .ckyMainForm(DBREF)


------------------------------------------------------------------------
--
-- Method:      .changeCe(DBREF)
--
-- Description: Change the current element
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .changeCe(!ref is DBREF)
  if (!ref.set()) then
    if (!ref.type eq 'WORL') then
      !okToChangeCe = !!alert.confirm('Are you sure you want to edit CKeys for WORLD?').boolean()
    elseif (!ref.type EQ 'CCTA' OR !ref.type EQ 'COCO') then
      !okToChangeCe = TRUE
    else
      !okToChangeCe = FALSE
    endif

    if (!okToChangeCe) then
      !this.cocoTable.changeCe(!this.filter, !ref)
      !this.ceText.val = !ref.fullName

      !this.cocoElemList.dText = !this.cocoTable.textArray
      !this.cocoElemList.rText = !this.cocoTable.refIndex

      if (NOT !this.cocoTable.duplicates.empty()) then
        show !!ckyDuplicates
        !!ckyDuplicates.setList(!this.cocoTable.duplicates)
      endif
    else
      !!alert.error('Cannot navigate to element of type CCTA from ' & !ref.fullName)
    endif
  endif
endmethod
-- End of method definition for .changeCe(DBREF)


------------------------------------------------------------------------
--
-- Method:      .update()
--
-- Description: Update the display and CKYCOCOELEM object with the current filter
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .update()
  !this.cocoTable.setFilter(!this.filter)

  !this.cocoElemList.dText = !this.cocoTable.textArray
  !this.cocoElemList.rText = !this.cocoTable.refIndex
endmethod
-- End of method definition for .update()


------------------------------------------------------------------------
--
-- Method:      .setFilter()
--
-- Description: Show a form to set filter values
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .setFilter()
  show !!ckyEditFilter
endmethod
-- End of method definition for .setFilter()


------------------------------------------------------------------------
--
-- Method:      .selectAll()
--
-- Description: Select everything in the coco element list
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .selectAll()
  !allValues = ARRAY()

  do !selectIndex indices !this.cocoElemList.dText
    !allValues.append(!selectIndex)
  enddo

  -- This crashes if !allValues is empty
  if (not !allValues.empty()) then
    !this.cocoElemList.val = !allValues
  endif
endmethod
-- End of method definition for .selectAll()


------------------------------------------------------------------------
--
-- Method:      .unSelectAll()
--
-- Description: Unselect everything in the coco element list
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .unSelectAll()
  !this.cocoElemList.clearSelection()
endmethod
-- End of method definition for .unSelectAll()


------------------------------------------------------------------------
--
-- Method:      .modifyCKey()
--
-- Description: Bring up a form to modify the ckey of selected coco elements
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .modifyCKey()
  !cKeyArray = ARRAY()
  !cKeyNumArray = ARRAY()

  -- Build up two parallel arrays of CKey text and number of occurrences
  do !selection values !this.cocoElemList.val
    -- Read the ckey text
    !cKeyText = !this.cocoElemList.rText[!selection].dbRef().cKey

    -- See if this CKey is already in the array
    !foundIndex = !cKeyArray.findFirst(!cKeyText)

    if (!foundIndex.set()) then
      -- It is so increment the number of occurrences
      !cKeyNumArray[!foundIndex] = !cKeyNumArray[!foundIndex] + 1
    else
      -- It isn't so add it into the arrays
      !cKeyArray.append(!cKeyText)
      !cKeyNumArray.append(1)
    endif
  enddo

  -- Find the CKey with the highest number of occurrences
  !highestSoFar = 0

  do !cKeyIndex indices !cKeyNumArray
    if (!cKeyNumArray[!cKeyIndex] GT !highestSoFar) then
      !highestSoFar = !cKeyNumArray[!cKeyIndex]
      !highestCKeyIndex = !cKeyIndex
    endif
  enddo

  if (not !cKeyArray.empty()) then
    show !!ckyModifyCkey

    if (trim(!cKeyArray[!highestCKeyIndex]) eq '') then
      !cKeyArray[!highestCKeyIndex] = 'Unset'
    endif

    -- If the most common ckey occurs in 75% or more cases then use this as the default
    if ((!cKeyNumArray[!highestCKeyIndex] / !this.cocoElemList.val.size()) GEQ 0.75) then
      !!ckyModifyCkey.setSelection(!cKeyArray[!highestCKeyIndex])
    else
      !!ckyModifyCkey.setSelection('')
    endif
  endif
endmethod
-- End of method definition for .modifyCKey()


------------------------------------------------------------------------
--
-- Method:      .modifyCKey(STRING)
--
-- Description: Modify the CKey of selected COCO elements
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .modifyCKey(!newCKey is STRING)
  !thisNewCKey = !newCKey

  -- Check we need to do anything
  if (!thisNewCKey NEQ '') then
    if (!thisNewCKey EQ 'Unset') then
      !thisNewCKey = 'NULL'
    endif

    -- Set the CKeys of each selected element
    do !selection values !this.cocoElemList.val
      !cocoElem = !this.cocoElemList.rText[!selection].dbRef()

      !oldCe = !!ce
      !!ce = !cocoElem
      CKEY $!thisNewCKey
      !!ce = !oldCe
    enddo

    -- Update the display
    !this.update()
  endif
endmethod
-- End of method definition for .modifyCKey(STRING)


------------------------------------------------------------------------
--
-- Method:      .deleteElem()
--
-- Description: Delete all selected elements from the database
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .deleteElem()

 -- Check to see if we have any elements selected, before we ask for deletion.
 -- Start of Defect P-244
 if (!this.cocoElemList.selection()[1].dbRef().badref()) then
     -- We have nothing selected.
     return
 endif
  handle (2,752)
     !!alert.error('Nothing selected for deletion')
      return
  endhandle
-- End of Defect P-244

  if (!!alert.confirm('Are you sure you want to delete selected elements?').boolean()) then
    do !selection values !this.cocoElemList.val
      !cocoElem = !this.cocoElemList.rText[!selection].dbRef()

      TRACE OFF
      !oldCe = !!ce
      !!ce = !cocoElem

      DELETE COCO

      !!ce = !oldCe
    enddo

    !this.changeCe(!this.cocoTable.cocoTabRef)
  endif
endmethod
-- End of method definition for .deleteElem()
