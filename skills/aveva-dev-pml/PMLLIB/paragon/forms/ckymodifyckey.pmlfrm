--   Group:         General Application
--     Keyword:     GEN
--   Module:        paragon
--   Replaces:
--
-- Author:          S.Bourne
-- Created:         Tue Jul 7 10:45:10 BST 1998
--
--
-- Description:     Modify the CKey attribute on COCO elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  ckyModifyCkey()                  -                   constructor
--  modifyCKey()                     -                   Change ckeys of selected elements in !!ckyMainForm to selected ckey
--  setSelection(STRING)             -                   Set the selected ckey
--
------------------------------------------------------------------------

setup form !!ckyModifyCkey
  !!ckyModifyCkey.formTitle     = 'Modify CKey'
  !!ckyModifyCkey.iconTitle     = 'Modify CKey'
  !!ckyModifyCkey.callback      = ''
  !!ckyModifyCkey.formRevision  = ' $Revision: 1.3 $ '

  option .cKey 'CKey ' at xmin + 1 ymin + 1 width 5

  path down
  vdist 1

  button .ok '  OK  ' callback '!this.modifyCKey()' OK

  path right
  hdist 2

  button .cancel 'Cancel' CANCEL
exit

-- End of form definition for !!ckyModifyCkey

------------------------------------------------------------------------
--
-- Method:      .ckyModifyCkey()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .ckyModifyCkey()
  !availableCKeys = ARRAY()

  !availableCKeys.append('')
  !availableCKeys.append('PL')
  !availableCKeys.append('FL')
  !availableCKeys.append('BW')
  !availableCKeys.append('CP')
  !availableCKeys.append('SC')
  !availableCKeys.append('Unset')

  !this.cKey.dText = !availableCKeys
endmethod
-- End of method definition for .ckyModifyCkey()


------------------------------------------------------------------------
--
-- Method:      .setSelection(STRING)
--
-- Description: Set the selected ckey
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .setSelection(!cKeyText is STRING)
  !this.cKey.select('DTEXT', !cKeyText)

  handle (61,567)
    !this.cKey.val = 1
  endhandle
endmethod
-- End of method definition for .setSelection(STRING)


------------------------------------------------------------------------
--
-- Method:      .modifyCKey()
--
-- Description: Change ckeys of selected elements in !!ckyMainForm to selected ckey
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .modifyCKey()
  !!ckyMainForm.modifyCKey(!this.cKey.selection('DTEXT'))
endmethod
-- End of method definition for .modifyCKey()
