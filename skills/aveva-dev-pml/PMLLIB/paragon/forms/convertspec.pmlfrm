define method .netPopupCallbackDestPartWld(!a is ARRAY)

  !this.conDestPartWld.popup = !this.puDestPartWld
  !this.conDestPartWld.showPopup(!a[0], !a[1])

endmethod
-- End of method definition netPopupCallbackDestPartWld()

------------------------------------------------------------------------
--
-- Method:      netPopup
--
-- Description: Service popup menus for all lists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Calling pop up menu reference
--    2   R      STRING      Event action
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netPopup(!object is MENU, !action is STRING)

  -- Get calling popup menu picked field
  !pickedField = !object.pickedFieldName

  --Source spec popup
  if (!object eq !this.puSourceSpec) then
    if (!pickedField eq 'NAVIGATETOSPEC') then
      !!ce = !this.selSourceSpecs[1].sourceSpec
    elseif (!pickedField eq 'VIEWSPEC') then

      -- Defect Number 1356
      !!ce = !this.selSourceSpecs[1].sourceSpec
      !!catSpecViews.add()
      -- Defect Number 1356

    endif

  -- Destination spec world popup
  elseif (!object eq !this.puDestSpecWld) then
    if (!pickedField eq 'NAVIGATETOSPWL') then
      !!ce = !this.selDestSpecWld
    endif

  -- Destination part world popup
  elseif (!object eq !this.puDestPartWld) then
    if (!pickedField eq 'NAVIGATETOPRTW') then
      !!ce = !this.selDestPartWld
    endif

  endif

endmethod
-- End of method definition netPopup()
