-- Description:
-- Create Catalogue Components in Paragon.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Create Elements
--  close()                          -                   Close the form
--  creCataElements()                -                   Constructor
--  initialise()                     -                   Initialisation method
--  nameValidate()                   -                   Validate name of the element
--
------------------------------------------------------------------------

setup form !!creCataElements resizeable

  !this.formTitle     = 'Create'
  !this.iconTitle     = 'Create'
  !this.initcall      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  option .namingOption                  anchor L+R+T  at xmin               ymin                  width 8
  text   .name                          anchor L+R+T  at xmax+1             ymin                  width 20 is STRING
  para   .gtypeTag                      anchor L+R+T  at xmin.namingOption  ymax+0.5       text 'Gtype ' width 6
  option .gtype                         anchor L+R+T  at xmin.name          ymin.gtypeTag         width 18

  -- Apply
  para .createIcon                      anchor L+B    at xmin.gtypeTag      ymax+1          pixmap width 10 height 5
  path right
  button .create   linklabel ' Create'  anchor L+B    at xmax.createIcon+1

  button .cancel   linklabel 'Dismiss'  anchor R+B    at xmax form - size   ymin.create
  para .cancelIcon                      anchor R+B    at xmin.cancel-3      ymin.cancel     pixmap width 10 height 5

  -- Form Members
  member .elementType is STRING

exit

-- End of form definition
------------------------------------------------------------------------
--
-- Method:      creCataElements
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .creCataElements()

    !namingOptionDText[1] = 'Name'
    !namingOptionDText[2] = 'AutoName'
    !this.namingOption.dText = !namingOptionDText
    !namingOptionRText[1] = 'FALSE'
    !namingOptionRText[2] = 'TRUE'
    !this.namingOption.rText = !namingOptionRText

    !this.name.val   = object STRING()
    !this.name.callback = '!this.nameValidate()'

    --!this.createIcon.addPixmap(!!pml.getPathName('create.png'))
    !this.create.callback  = '!this.apply()'

    --!this.cancelIcon.addPixmap(!!pml.getPathName('discard.png'))
    !this.cancel.callback = '!this.close()'

    --Create global instance for the object NAMOPT if it is undefined
    if(undefined(!!namOpt))then
      call !!comDefineGlobal(object NAMOPT())
    endif

    --Create global instance for the object RULESTORE if it is undefined
    if(undefined(!!ruleStore))then
      call !!comDefineGlobal(object RULESTORE())
    endif

endmethod
-- End of method definition for .creCataElements()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

     call !!runmacro('%PDMSUI%\cat\gen\dgTypes','!!creCataElements.gtype pelem 1 1 PAIRS !!CDCARTN')

endmethod
-- End of method definition for .initialisation()
------------------------------------------------------------------------
--
-- Method:      nameValidate
--
-- Description: Validate name of the element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .nameValidate()

  if(!this.namingOption.selection('RTEXT') eq 'FALSE')then
     !name    = !!checkName(!this.name.val,'new')
     if(!name.set().not())then
        !this.name.val = object STRING()
      endif
   endif

endmethod
-- End of method definition for .nameValidate()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Create Elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  !element = !this.elementType
  NEW $!<element>

  !gtyp    = !this.gtype.selection()
  if(!gtyp.set())then
    !gtyp    = !gtyp.trim()
    GTYPE $!gtyp
    handle (41,232)
    endhandle
  endif

  if(!this.namingOption.selection('RTEXT') eq 'TRUE') then
     !name  = !!namOpt.nameString(!!ce, STRING(), false, false)
     if (!name.unset()) then
       !!alert.error('Unable to autoname element, set the relevant attribute for the autoname rule and then use "Utilities>Autoname>CE only".')
     else
       NAME /$!name
     endif

   else
     !name    = !this.name.val
     if(!name.set())then
       NAME /$!name
     endif

   endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  kill !!creCataElements

endmethod
-- End of method definition for .close()
