-- Author:          venkatramanan.iyer
-- Created:
--
-- Description:
-- Appware for creating and Managing COCO Table in Paragon.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(STRING)                    -                   create/Apply attributes
--  changeMode()                     -                   callback of Changing  Mode between create and modify
--  close()                          -                   close the form
--  creCocoElements()                -                   Constructor
--  initialise()                     -                   Initialisation method
--  namingMode()                     -
--  populateData()                   -                   Populate attributes of selected coco to gadgets.
--  textValidation(GADGET)           -                   Validate textbox values
--
------------------------------------------------------------------------

setup form !!creCocoElements size 40 10

  !this.formTitle     = 'Connection Compatibility Elements'
  !this.iconTitle     = 'Connection Compatibility Elements'
  !this.initcall      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  frame .inputFrame 'Input Data'          anchor L+B  at xmin  ymin         width 40
    option .namingOption                  anchor L+B  at xmin+1             ymin+1                width 8
    text   .name                          anchor L+B  at xmax+1             ymin                  width 16 is STRING
    option .mode                          anchor L+B  at xmax+1             ymin                  width 6
    para   .cTypeTag                      anchor L+B  at xmin.namingOption  ymax+0.5       text 'Connection Type ' width 12
    text   .faceCType                     anchor L+B  at xmin.name          ymin.cTypeTag         width 7 is STRING
    text   .endCType                      anchor L+B  at xmax+1             ymin                  width 7 is STRING
    para   .cKeyTag                       anchor L+B  at xmin.namingOption  ymax+0.5       text 'Connection Key  ' width 11
    text   .cKey                          anchor L+B  at xmax+1             ymin                  width 7 is STRING
  exit
  path down
  vdist 0.2

  frame .displayFrame 'Display'           anchor L+R+B                        width 40
    list .cocoTable  'Coco Elements List' anchor L+R+T  at xmin+1             ymin+1                columns  width 37 height 9
  exit

  -- Create/Apply
  para .createIcon                        anchor L+B    at xmin.cTypeTag      ymax+1            pixmap width 10 height 5
  para .modifyIcon                        anchor L+B    at xmin.cTypeTag      ymin.createIcon   pixmap width 10 height 5
  path right
  button .create   linklabel ' Create '   anchor L+B    at xmax.createIcon+1
  button .modify   linklabel ' Apply  '   anchor L+B    at xmax.createIcon+1
  -- Cancel
  button .cancel   linklabel 'Dismiss'    anchor R+B    at xmax form - size   ymin.create
  para .cancelIcon                        anchor R+B    at xmin.cancel-3      ymin.cancel     pixmap width 10 height 5

  -- form Members

  -- Member for storing all connection types
  member .faceCtypeArray is ARRAY
  member .endCtypeArray is ARRAY

  -- Member for storing all connection keys
  member .cKeyArray is ARRAY

  -- Member for storing name of all COCOs
  member .cocoNameArray is ARRAY

  -- Set mode whether to create or modify
  member .setMode is STRING

  -- Set the current Element
  member .currentElement is DBREF

exit

-- End of form definition
------------------------------------------------------------------------
--
-- Method:      creCocoElements
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .creCocoElements()

    !namingOptionDText[1] = 'Name'
    !namingOptionDText[2] = 'AutoName'
    !this.namingOption.dText = !namingOptionDText
    !namingOptionRText[1] = 'FALSE'
    !namingOptionRText[2] = 'TRUE'
    !this.namingOption.rText = !namingOptionRText
    !this.namingOption.callback =  '!this.namingMode()'

    !modeDText[1] = 'Create'
    !modeDText[2] = 'Modify'
    !modeRText[1] = 'CREATE'
    !modeRText[2] = 'MODIFY'
    !this.mode.dText = !modeDText
    !this.mode.rText = !modeRText
    !this.mode.callback = '!this.changeMode()'

    !this.name.val   = object STRING()
    !this.name.callback = '!this.textValidation(!this.name)'

    !this.faceCType.val = object STRING()
    !this.faceCType.callback = '!this.textValidation(!this.faceCType)'

    !this.endCType.val = object STRING()
    !this.endCType.callback = '!this.textValidation(!this.endCType)'

    !this.cKey.val = object STRING()
    !this.cKey.callback = '!this.textValidation(!this.cKey)'

    !this.createIcon.addPixmap(!!pml.getPathName('create.png'))
    !this.create.callback  = '!this.apply(|CREATE|)'

    !this.modifyIcon.addPixmap(!!pml.getPathName('accept.png'))
    !this.modify.callback  = '!this.apply(|MODIFY|)'

    !this.cancelIcon.addPixmap(!!pml.getPathName('discard.png'))
    !this.cancel.callback = '!this.close()'

    !headings[1]  = 'Name'
    !headings[2]  = 'Ctype 1'
    !headings[3]  = 'Ctype 2'
    !headings[4]  = 'Ckey'
    !this.cocoTable.setHeadings(!headings)

      --Create global instance for the object NAMOPT if it is undefined
    if(undefined(!!namOpt))then
      call !!comDefineGlobal(object NAMOPT())
    endif

    --Create global instance for the object RULESTORE if it is undefined
    if(undefined(!!ruleStore))then
      call !!comDefineGlobal(object RULESTORE())
    endif


endmethod
-- End of method definition for .creCocoElements()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

    !this.cocoNameArray = object ARRAY()
    !this.faceCtypeArray  = object ARRAY()
    !this.endCtypeArray = object ARRAY()
    !this.cKeyArray = object ARRAY()

    !collection = object COLLECTION()
    !expression = object EXPRESSION('type eq |COCO|')
    !collection.scope(CCTA)
    !collection.filter(!expression)
    !coco  = !collection.results()

    !cocoNameBlock  = object BLOCK('!coco[!evalIndex].namn')
    !cocoNameBlock  = object BLOCK('!coco[!evalIndex].namn')
    !cocoKeyBlock   = object BLOCK('!coco[!evalIndex].cKey')
    !cocoTypeBlock  = object BLOCK('!coco[!evalIndex].cType')

    !this.cocoNameArray = !coco.evaluate(!cocoNameBlock)
    !this.cKeyArray = !coco.evaluate(!cocoKeyBlock)
    !ctyp = !coco.evaluate(!cocoTypeBlock)
    !list[2] = !this.faceCtypeArray
    !list[3] = !this.endCtypeArray
    !list[4] = !this.cKeyArray

    if(!this.cocoTable.dText.set()) then
      !currentSelection = !this.cocoTable.val
    endif

    !this.cocoTable.dText = object ARRAY()
    !this.cocoTable.rText = object ARRAY()

    !this.cocoTable.setcolumns(!list)
    !this.cocoTable.rText = !this.cocoNameArray

    -- navigate back to previous selection
    if(defined(!currentSelection)) then
      !this.cocoTable.val = !currentSelection
    endif

    !this.mode.select('RTEXT',!this.setMode)
    if(!!ce.type eq 'COCO')then
      !this.cocoTable.select('RTEXT',!!ce.namn)
    endif
    !this.changeMode()

endmethod
-- End of method definition for .initialise()
------------------------------------------------------------------------
--
-- Method:      namingMode
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .namingMode()

  if(!this.namingOption.selection('RTEXT') eq 'TRUE')then
     !this.name.active  = false
  else
     !this.name.active  = true
  endif

endmethod
-- End of method definition for .namingMode()

------------------------------------------------------------------------
--
-- Method:      textValidation
--
-- Description: Validate textbox values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      GADGET    Textbox to be validated
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .textValidation(!gadget is GADGET)

  if(!gadget.name() eq 'NAME')then
      if(!this.namingOption.selection('RTEXT') eq 'FALSE')then
        if(!this.setMode eq 'MODIFY')then
          if(!this.name.val.trim() neq !this.cocoTable.selection())then
            !name    = !!checkName(!this.name.val,'new')
             if(!name.set().not())then
                !this.name.val = !this.cocoTable.selection()
             endif
          endif
        else
          !name    = !!checkName(!this.name.val,'new')
          if(!name.set().not())then
            !this.name.val = object STRING()
          endif
        endif
      endif
  else
      if(!gadget.val.trim() eq '')then
        !gadget.val = object STRING()
      elseif(!gadget.val.trim().length() gt 4)then
        !!alert.error('CTYPE/CKEY should have only for characters.Remaining characters will be removed')
        !gadget.val = !gadget.val.trim().substring(1,4).upcase()
      else
        !gadget.val = !gadget.val.trim().upcase()
      endif
  endif

endmethod
-- End of method definition for .textValidation()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: create/Apply attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING     Action to be performed
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply(!action is STRING)

  if(!!ce.type neq 'CCTA' or !!ce.type neq 'COCO')then
    $!this.currentElement
  endif
  !currentElement = ce

  if(!action eq 'CREATE') then

    NEW COCO

  else

    !cocoElement =  !this.cocoTable.selection()

    /$!cocoElement
    handle(2,109)
      $!cocoElement
    endhandle

  endif


  if(!this.namingOption.selection('RTEXT') eq 'TRUE') then
     !name  = !!namOpt.nameString(!!ce, STRING(), false, false)
     if (!name.unset()) then
       !!alert.error('Unable to autoname element, set the relevant attribute for the autoname rule and then use "Utilities>Autoname>CE only".')
     else
       NAME /$!name
     endif

  else
     !name    = !this.name.val
     if(!name.set())then
       NAME /$!name
     endif

  endif

  !cKey  = !this.cKey.val
  !faceCType = !this.faceCType.val
  !endCType  = !this.endCType.val

  if(!cKey.set())then
     !!ce.cKey = !cKey
  endif

  if (!faceCType.set())then
    !!ce.ctype[1]  = !faceCType
  endif

  if(!endCType.set())then
     !!ce.ctype[2] = !endCType
  endif


  !this.initialise()
  $!currentElement
endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      changeMode
--
-- Description: callback of Changing  Mode between create and modify
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .changeMode()

  if(!this.mode.selection('RTEXT') eq 'CREATE')then
    !this.createIcon.visible =  true
    !this.modifyIcon.visible =  false
    !this.create.visible     =  true
    !this.modify.visible     =  false
    !this.cocoTable.callback =  ''
    !this.name.val           =  object STRING()
    !this.faceCType.val      =  object STRING()
    !this.endCType.val       =  object STRING()
    !this.cKey.val           =  object STRING()
    !this.setMode            =  'CREATE'
  else
    if(!this.cocoTable.dText.unset())then
       !!alert.error('Element is not selected for modification')
       !this.setMode         = 'CREATE'
       !this.mode.select('RTEXT',!this.setMode)
       !this.changeMode()
       return
    endif
    !this.createIcon.visible =  false
    !this.modifyIcon.visible =  true
    !this.create.visible     =  false
       !this.mode.select('RTEXT',!this.setMode)
    !this.cocoTable.callback =  '!this.populateData()'
    !this.populateData()
  endif

endmethod
-- End of method definition for .changeMode()
------------------------------------------------------------------------
--
-- Method:      populateData
--
-- Description: Populate attributes of selected coco to gadgets.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .populateData()

  !selectedIndx       = !this.cocoTable.val

  !this.name.val      = !this.cocoNameArray[!selectedIndx]
  if(!this.cocoNameArray[!selectedIndx].matchwild('*=*'))then
     !this.name.val = object STRING()
  endif
  !this.faceCType.val = !this.faceCtypeArray[!selectedIndx]
  if(!this.faceCtypeArray[!selectedIndx].trim() eq ''or !this.faceCtypeArray[!selectedIndx].unset())then
     !this.faceCType.val = object STRING()
  endif
  !this.endCType.val  = !this.endCtypeArray[!selectedIndx]
  if(!this.endCtypeArray[!selectedIndx].trim() eq '' or !this.endCtypeArray[!selectedIndx].unset())then
     !this.endCType.val = object STRING()
  endif
  !this.cKey.val      = !this.cKeyArray[!selectedIndx]
   if(!this.cKeyArray[!selectedIndx].trim() eq '' or !this.cKeyArray[!selectedIndx].unset())then
     !this.cKey.val = object STRING()
  endif

endmethod
-- End of method definition for .populateData()
------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  !this.hide()

endmethod
-- End of method definition for .close()
