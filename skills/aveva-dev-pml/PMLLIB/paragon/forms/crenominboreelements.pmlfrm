-- File:            crenominboreelements.pmlfrm
--   Type:          Form Definition
--   Group:         Paragon

--   Keyword:       CAT
--   Module:        Paragon
--   Replaces:
--
-- Author:          venkatramanan.iyer
-- Created:
--
-- Description:
-- Create Nominal bore table for non standard bores in Paragon.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(STRING)                    -                   Create/Apply attributes
--  changeMode()                     -                   Change of Mode between create and modify
--  close()                          -                   close the form
--  creNominBoreElements()           -                   Constructor
--  init()                           -                   Initialisation method
--  initialise()                     -                   Initialisation method
--  namingMode()                     -
--  populateData()                   -                   Populate attributes of selected NOMINB to gadgets.
--  textValidation(GADGET)           -                   Validate textbox values
--
------------------------------------------------------------------------

setup form !!creNominBoreElements size 40 10

  !this.formTitle     = 'Nominal Bore Table'
  !this.iconTitle     = 'Nominal Bore Table'
  !this.callback      = '!this.init()'

  -- Body of form definition
  frame .inputFrame 'Input Data'          anchor L+B  at xmin  ymin         width 40
    option .namingOption                  anchor L+B  at xmin+1             ymin+1                width 8
    text   .name                          anchor L+B  at xmax+1             ymin                  width 16 is STRING
    option .mode                          anchor L+B  at xmax+1             ymin                  width 6
    para   .inchBoreTag                   anchor L+B  at xmin.namingOption  ymax+0.5       text 'Bore in inches ' width 12
    text   .inchBore                      anchor L+B  at xmin.name          ymin.inchBoreTag         width 7 is REAL FORMAT !!boreFmt
    para   .mmBoreTag                     anchor L+B  at xmin.namingOption  ymax+0.5       text 'Bore in mm  ' width 11
    text   .mmBore                        anchor L+B  at xmax+1             ymin                  width 7 is REAL FORMAT !!boreFmt
  exit
  path down
  vdist 0.2

  frame .displayFrame 'Display'           anchor L+R+T                        width 40
    list .boreList    'Nominal Bore List' anchor L+R+T  at xmin+1             ymin+1                columns  width 37 height 9
  exit

  -- Create/Apply
  path right
  button .create             ' Create '   anchor L+B    at x0.5 ymax + 0.25
  button .modify             ' Apply  '   anchor L+B    at x0.5
  -- Cancel
  button .cancel             'Dismiss '   anchor R+B    at xmax form - size   ymin.create

  -- form Members

  -- Member for storing all bores
  member .inchBoreArray is ARRAY
  member .mmBoreArray is ARRAY

  -- Member for storing name of all COCOs
  member .nominalBoreArray is ARRAY

  -- Set mode whether to create or modify
  member .setMode is STRING

   -- Set the current Element
  member .currentElement is DBREF
exit

-- End of form definition
------------------------------------------------------------------------
--
-- Method:      creNominBoreElements
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .creNominBoreElements()

    !namingOptionDText[1] = 'Name'
    !namingOptionDText[2] = 'AutoName'
    !this.namingOption.dText = !namingOptionDText
    !namingOptionRText[1] = 'FALSE'
    !namingOptionRText[2] = 'TRUE'
    !this.namingOption.rText = !namingOptionRText
    !this.namingOption.callback =  '!this.namingMode()'

    !modeDText[1] = 'Create'
    !modeDText[2] = 'Modify'
    !modeRText[1] = 'CREATE'
    !modeRText[2] = 'MODIFY'
    !this.mode.dText = !modeDText
    !this.mode.rText = !modeRText
    !this.mode.callback = '!this.changeMode()'

    !this.name.val   = object STRING()
    !this.name.callback = '!this.textValidation(!this.name)'

    !this.inchBore.val = 0
    !this.inchBore.callback = '!this.textValidation(!this.inchBore)'

    !this.mmBore.val = 0
    !this.mmBore.callback = '!this.textValidation(!this.mmBore)'

    !this.create.callback  = '!this.apply(|CREATE|)'
    !this.modify.callback  = '!this.apply(|MODIFY|)'
    !this.cancel.callback = '!this.close()'

    !headings[1]  = 'Name'
    !headings[2]  = 'Bore in inch'
    !headings[3]  = 'Bore in mm'
    !this.boreList.setHeadings(!headings)

      --Create global instance for the object NAMOPT if it is undefined
    if(undefined(!!namOpt))then
      call !!comDefineGlobal(object NAMOPT())
    endif

    --Create global instance for the object RULESTORE if it is undefined
    if(undefined(!!ruleStore))then
      call !!comDefineGlobal(object RULESTORE())
    endif

endmethod
-- End of method definition for .creNominBoreElements()

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialisation method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init()

    !this.changeMode()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

    !this.nominalBoreArray = object ARRAY()
    !this.inchBoreArray  = object ARRAY()
    !this.mmBoreArray = object ARRAY()

    !collection = object COLLECTION()
    !expression = object EXPRESSION('type eq |NOMINB|')
    !collection.scope(NBRWLD)
    !collection.filter(!expression)
    !bores  = !collection.results()

    !nominalBoreBlock = object BLOCK('!bores[!evalIndex].namn')
    !inchBoreBlock = object BLOCK('!bores[!evalIndex].incBore.string()')
    !mmBoreBlock = object BLOCK('!bores[!evalIndex].mmBore.string()')

    !this.nominalBoreArray = !bores.evaluate(!nominalBoreBlock)
    !this.inchBoreArray = !bores.evaluate(!inchBoreBlock)
    !this.mmBoreArray = !bores.evaluate(!mmBoreBlock)

    !list[1] = !this.nominalBoreArray
    !list[2] = !this.inchBoreArray
    !list[3] = !this.mmBoreArray

    if(!this.boreList.dText.set()) then
      !currentSelection = !this.boreList.val
    endif

    !this.boreList.dText = object ARRAY()
    !this.boreList.rText = object ARRAY()

    !this.boreList.setcolumns(!list)
    !this.boreList.rText = !this.nominalBoreArray

    -- navigate back to previous selection
    if(defined(!currentSelection)) then
      !this.boreList.val = !currentSelection
    endif

    !this.mode.select('RTEXT',!this.setMode)
    if(!!ce.type eq 'NOMINB')then
      !this.boreList.select('RTEXT',!!ce.namn)
    endif

    !this.changeMode()

endmethod
-- End of method definition for .initialise()
------------------------------------------------------------------------
--
-- Method:      namingMode
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .namingMode()

  if(!this.namingOption.selection('RTEXT') eq 'TRUE')then
     !this.name.active  = false
  else
     !this.name.active  = true
  endif

endmethod
-- End of method definition for .namingMode()

------------------------------------------------------------------------
--
-- Method:      textValidation
--
-- Description: Validate textbox values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      GADGET    Textbox to be validated
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .textValidation(!gadget is GADGET)

   if(!gadget.name() eq 'NAME')then
      if(!this.namingOption.selection('RTEXT') eq 'FALSE')then
         if(!this.setMode eq 'MODIFY')then
           if(!this.name.val.trim() neq !this.boreList.selection())then
             !name    = !!checkName(!this.name.val,'new')
             if(!name.set().not())then
                !this.name.val = !this.boreList.selection()
             endif
           endif
         else
          !name    = !!checkName(!this.name.val,'new')
          if(!name.set().not())then
             !this.name.val = object STRING()
          endif
         endif
      endif
    else
      if(!gadget.val.set().not())then
        !gadget.val = 0
      else
        !gadget.val.real()
        handle ANY
           !!alert.error('Enter a real value')
        endhandle
      endif
    endif
endmethod
-- End of method definition for .textValidation()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Create/Apply attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply(!action is STRING)

  if(!!ce.type neq 'NBRWLD' or !!ce.type neq 'NOMINB')then
    $!this.currentElement
  endif
     !currentElement = ce

  if(!action eq 'CREATE') then

    NEW NOMINB

  else

    !boreElement =  !this.boreList.selection()
    /$!boreElement
    handle(2,109)
      $!boreElement
    elsehandle (47,15)
      return
    endhandle

  endif

  if(!this.namingOption.selection('RTEXT') eq 'TRUE') then
        !name  = !!namOpt.nameString(!!ce, STRING(), false, false)
    if (!name.unset()) then
      !!alert.error('Unable to autoname element, set the relevant attribute for the autoname rule and then use "Utilities>Autoname>CE only".')
    else
      NAME /$!name
       handle (47,15)
       endhandle
    endif

  else

    !name    = !this.name.val
    if(!name.set())then
      NAME /$!name
       handle (47,15)
       endhandle
    endif

  endif

  !inchBore  = !this.inchBore.val
  if(!inchBore.set().not())then
     INCBORE 0
  else
     INCBORE $!inchBore
  endif

  !mmBore = !this.mmBore.val
  if (!mmBore.set())then
     MMBORE $!mmBore
  else
     MMBORE 0
  endif

  !this.initialise()
  $!currentElement

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      changeMode
--
-- Description: Change of Mode between create and modify
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .changeMode()

  if(!this.mode.selection('RTEXT') eq 'CREATE')then

    !this.modify.visible     =  false
    !this.create.visible     =  true
    !this.boreList.callback  =  ''
    !this.name.val           =  object STRING()
    !this.inchBore.val       =  0
    !this.mmBore.val         =  0
    !this.setMode            = 'CREATE'

  else

    if(!this.boreList.dText.unset())then
    !this.setMode            = 'MODIFY'
    !this.initialise()
--       !!alert.error('Element is not selected for modification')
--       !this.setMode         = 'CREATE'
--       !this.mode.select('RTEXT',!this.setMode)
--       !this.changeMode()
--       return
    endif

    !this.create.visible     =  false
    !this.modify.visible     =  true
    !this.boreList.callback  =  '!this.populateData()'
    !this.setMode            = 'MODIFY'
    !this.populateData()
  endif

endmethod
-- End of method definition for .changeMode()
------------------------------------------------------------------------
--
-- Method:      populateData
--
-- Description: Populate attributes of selected NOMINB to gadgets.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .populateData()

  !selectedIndx       = !this.boreList.val

  !this.name.val      = !this.nominalBoreArray[!selectedIndx]
  if(!this.nominalBoreArray[!selectedIndx].matchwild('*=*'))then
     !this.name.val   = object STRING()
  endif
  !this.inchBore.val  = !this.inchBoreArray[!selectedIndx].real()
  if(!this.inchBoreArray[!selectedIndx]  eq '' or !this.inchBoreArray[!selectedIndx].unset())then
     !this.inchBore.val = 0
  endif
  !this.mmBore.val    = !this.mmBoreArray[!selectedIndx].real()
  if(!this.mmBoreArray[!selectedIndx]  eq '' or !this.mmBoreArray[!selectedIndx].unset())then
     !this.mmBore.val = 0
  endif

endmethod
-- End of method definition for .populateData()
------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  !this.hide()

endmethod
-- End of method definition for .close()
