--   Keyword:       CAT
--   Module:        Paragon
--   Replaces:
--
-- Author:          venkatramanan.iyer
-- Created:
-- Description:
-- Create Nominal bore world in Paragon.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply position
--  close()                          -                   Apply position
--  creNominBoreWld()                -                   Constructor
--  nameValidate()                   -                   Validate name of the element
--
------------------------------------------------------------------------
setup form !!creNominBoreWld resizeable
------------------------------------------------------------------------

  !this.formTitle     = 'Create Nominal Bore World'
  !this.iconTitle     = 'Create'
  !this.initcall      = ''
  !this.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  option .namingOption                  anchor L+R+T  at xmin               ymin                  width 8
  text   .name                          anchor L+R+T  at xmax+1             ymin                  width 20 is STRING

  -- Apply
  path right
  button .create            ' Create '  anchor L+B    at x0.5 y 1.25
  button .cancel             'Dismiss'  anchor R+B    at xmax form - size   ymin.create

exit

-- End of form definition
------------------------------------------------------------------------
--
-- Method:      creNominBoreWld
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .creNominBoreWld()
------------------------------------------------------------------------

    !namingOptionDText[1] = 'Name'
    !namingOptionDText[2] = 'AutoName'
    !this.namingOption.dText = !namingOptionDText
    !namingOptionRText[1] = 'FALSE'
    !namingOptionRText[2] = 'TRUE'
    !this.namingOption.rText = !namingOptionRText

    !this.name.val   = object STRING()
    !this.name.callback = '!this.nameValidate()'

--    !this.createIcon.addPixmap(!!pml.getPathName('create.png'))
    !this.create.callback  = '!this.apply()'

--    !this.cancelIcon.addPixmap(!!pml.getPathName('discard.png'))
    !this.cancel.callback = '!this.close()'

    --Create global instance for the object NAMOPT if it is undefined
    if(undefined(!!namOpt))then
      call !!comDefineGlobal(object NAMOPT())
    endif

    --Create global instance for the object RULESTORE if it is undefined
    if(undefined(!!ruleStore))then
      call !!comDefineGlobal(object RULESTORE())
    endif

endmethod
-- End of method definition for .creCataElements()

------------------------------------------------------------------------
--
-- Method:      nameValidate
--
-- Description: Validate name of the element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .nameValidate()
------------------------------------------------------------------------

  if(!this.namingOption.selection('RTEXT') eq 'FALSE')then
     !name    = !!checkName(!this.name.val,'new')
     if(!name.set().not())then
        !this.name.val = object STRING()
      endif
   endif

endmethod
-- End of method definition for .nameValidate()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Apply
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply()

  NEW NBRWLD
  purp BDIA

  if(!this.namingOption.selection('RTEXT') eq 'TRUE') then
     !name  = !!namOpt.nameString(!!ce, STRING(), false, false)
     if (!name.unset()) then
       !!alert.error('Unable to autoname element, set the relevant attribute for the autoname rule and then use "Utilities>Autoname>CE only".')
     else
       NAME /$!name
     endif

   else
     !name    = !this.name.val
     if(!name.set())then
       NAME /$!name
     endif

   endif
   !this.close()
   !!creNominBoreElements('CREATE')

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  !this.hide()

endmethod
-- End of method definition for .close()
