--
--
-- Description:
-- APPWARE for creating Diameter Table
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addToList()                      -
--  apply(STRING)                    -                   apply
--  changeMode()                     -                   callback of Changing  Mode between create and modify
--  clear()                          -                   Adds a value entered to the current bolt length list.
--  close()                          -                   close the form
--  delete()                         -                   delete data
--  diameterTable()                  -                   Constructor
--  include()                        STRING              include data
--  initialise()                     -                   Initialisation method
--  populateData()                   -                   Populate attributes of selected coco to gadgets.
--  replace()                        -                   replace data
--  selection(GADGET,STRING)         -                   choose type of bolt length entry
--  textValidation(GADGET,STRING)    -                   Validate textbox values
--

setup form !!diameterTable

  !!diameterTable.formTitle     = 'Diameter Table'
  !!diameterTable.iconTitle     = 'Diameter Table'
  !!diameterTable.callback      = '!this.initialise()'
  !!diameterTable.formRevision  = ' $Revision: 1.0 $ '

  -- Body of form definition
   frame .dtab 'Diameter Table' at xmin+0.25      ymin+0.25
      para    .nameTag      at xmin+2             y 1    text 'Name'                 width  5
      text    .name         at xmax+1             y 1                                width 30 is STRING
      option  .mode         at xmax+1             y 1                                width  6

      para .enter at x 1 y 2.25 text 'Add Bolt Lengths by:' width 13
      rtoggle .enterSingle 'Single Value'    tagwidth 8 states 'OFF' 'SINGL'
      rtoggle .enterRange  'Range of Values' tagwidth 8 states 'OFF' 'RANGE'

      para    .blenTag      at x 1                y 3.5  text 'Single Bolt Length'  width 13
      text    .blen         at xmax+1             y 3.5                             width 8 is STRING

      text    .blenTag1  '  Bolt Length Start' at x 1            y 3.5    tagwidth 14    width 5 is REAL
      text    .blenTag2  '  End'               at xmax           y 3.5    tagwidth 4     width 4 is REAL
      text    .blenTag3  '  Step'              at xmax           y 3.5    tagwidth 5     width 4 is REAL

      button  .include     'Include'    anchor L+B  at x 3  y 4.75
      button  .replace     'Replace'    anchor L+B  at xmax+3  y 4.75
      button  .delete      'Delete'     anchor L+B  at xmax+3  y 4.75
      button  .clear       'Clear List' anchor L+B  at xmax+3  y 4.75

      list    .blenList  'Bolt Lengths'      at x 1               ymax+0.5   width 48 height 5
        -- Create/Apply
      path down
      vdist 1

      button .create    ' Create '   anchor L+B    at x 1
      button .modify    ' Apply  '   anchor L+B    at x 1   at ymin

       -- Cancel
      button .cancel    'Dismiss'    anchor R+B    at x 42   ymin
      --para .cancelIcon                         anchor R+B    at xmin.cancel-3      ymin.cancel     pixmap width 10 height 5
   exit

   -- Error frame
   frame .errorFrame  'Error ' at xmin.dtab ymin.dtab
      para .errorTag                          at xmin+1               ymin+1        width 50  lines 2
      button .error     'Done'       at x 22   ymax+0.5
   exit

  -- Set mode whether to create or modify
  member .setMode is STRING

  -- Storing values of Blen of DTAB in string Fmt.
  member .blenString is ARRAY
  member .blenValues is ARRAY

  -- Store current element
  member .currentElement is DBREF

exit
-- End of form definition for !!diameterTable
------------------------------------------------------------------------
--
-- Method:      diameterTable
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .diameterTable()

    -- Initialise option gadgets
    !modedtext[1]                 = 'Create'
    !modedtext[2]                 = 'Modify'
    !this.mode.dtext              = !modedtext

    !modeRText[1]                 = 'CREATE'
    !modeRText[2]                 = 'MODIFY'
    !this.mode.rText              = !modeRText

    !this.mode.callback           = '!this.changeMode()'

    !this.dtab.visible = true
    !this.errorFrame.visible = false

    -- Assign pixmap

    -- for Create
    !this.create.callback     = '!this.apply(|CREATE|)'
    !this.modify.callback     = '!this.apply(|MODIFY|)'

    -- for cancel
    !this.cancel.callback = '!this.close()'

    !this.include.callback   = '!this.include()'
    !this.replace.callback   = '!this.replace()'
    !this.delete.callback    = '!this.delete()'
    !this.clear.callback     = '!this.clear()'

    -- Range selection process.
    !this.enterSingle.callback  = '!this.selection('
    !this.enterRange.callback   = '!this.selection('

    -- Initialise values for gadgets

    -- for DTab
    !this.name.val            = 'Unset'
    !this.name.callback       = '!this.textValidation(!this.name,|NAME|)'
    !this.enterRange.val      = TRUE

    !this.blen.val            = object STRING()
    !this.blen.callback       = '!this.textValidation(!this.blen,|STRING|)'
    !this.error.callback      = '!this.initialise()'

    !this.changeMode()
    !this.currentElement      = !!ce

    -- string format for bolt length
    !!fmt = object FORMAT()
    !!fmt.dp = 3

endmethod
-- End of method definition for .diameterTable()
------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

    !this.currentElement         = !!ce
    if(!this.setMode eq 'CREATE')then

      if(!this.currentElement.type inset('LTAB','DTAB'))then
        !this.dtab.visible       = true
        !this.errorFrame.visible = false
        !this.create.visible     =  true
        !this.modify.visible     =  false
        !this.name.val           = 'Unset'
        !this.blen.val           =  object STRING()
        !this.blenString.clear()
        !this.blenList.dtext     =  !this.blenString

      else
        !this.dtab.visible       = false
        !this.errorFrame.visible = true
        !this.errorTag.val       = 'DTAB can be created within an LTAB. Navigate to LTAB and try.'
      endif

    else

      !this.selection(!this.enterSingle, 'SELECT')

      if(!this.currentElement.type eq 'DTAB')then
        !this.dtab.visible       = true
        !this.errorFrame.visible = false
        !this.create.visible     =  false
        !this.modify.visible     =  true
        !this.populateData()
      else
        !this.dtab.visible       = false
        !this.errorFrame.visible = true
        !this.errorTag.val       = 'Navigate to DTAB and do modify.'
      endif

        !this.addToList()
    endif

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      changeMode
--
-- Description: callback of Changing  Mode between create and modify
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      GADGET      Gadget to be validated
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .changeMode()

  !this.setMode                  =  !this.mode.selection('RTEXT')
  !this.initialise()

endmethod
-- End of method definition for .changeMode()

 ------------------------------------------------------------------------
--
-- Method:      selection
--
-- Description: choose type of bolt length entry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selection(!gadget is GADGET, !action is STRING)

  if (!action EQ 'SELECT') then

      if (!gadget.name() EQ 'ENTERRANGE') then
          !this.blenTag.visible  = FALSE
          !this.blen.visible     = FALSE
          !this.enterSingle.val  = FALSE
          !this.blenTag1.visible = TRUE
          !this.blenTag2.visible = TRUE
          !this.blenTag3.visible = TRUE
      else
          !this.blenTag.visible  = TRUE
          !this.blen.visible     = TRUE
          !this.enterSingle.val  = TRUE
          !this.blenTag1.visible = FALSE
          !this.blenTag2.visible = FALSE
          !this.blenTag3.visible = FALSE
      endif
  endif

endmethod
-- End of method definition for .selection()

 ------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  !this.hide()

endmethod
-- End of method definition for .close()

 ------------------------------------------------------------------------
--
-- Method:      textValidation
--
-- Description: Validate textbox values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      GADGET    Textbox to be validated
--    2    R      STRING    Data Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .textValidation(!gadget is GADGET,!type is STRING)

  if(!type eq 'NAME')then
     if(!this.setMode eq 'MODIFY')then
        if(!gadget.val.trim() neq !!ce.namn)then
          !name    = !!checkName(!gadget.val,'new')
           if(!name.set().not())then
              !gadget.val = object STRING()
           endif
        endif
     else
        !name    = !!checkName(!this.name.val,'new')
        if(!name.set().not())then
          !this.name.val           = 'Unset'
        endif
     endif
  endif

  if(!type eq 'STRING')then
     if(!gadget.val.trim() eq '')then
       !gadget.val = object STRING()
     else
       !gadget.val = !gadget.val.trim()
       !unusedRealValue  = !gadget.val.real()
       handle ANY
         !!alert.error('Enter a real value')
         !gadget.val = object STRING()
        endhandle
     endif
  endif

endmethod
-- End of method definition for .textValidation()
------------------------------------------------------------------------
--
-- Method:      populateData
--
-- Description: Populate attributes of selected coco to gadgets.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .populateData()

  !this.name.val              = !this.currentElement.namn
  !name                       = !this.name.val
  if(!name.matchwild('*=*'))then
    !this.name.val           = 'Unset'
  endif

  do !i indices !this.currentElement.blen
    !this.blenString[!i]      = !this.currentElement.blen[!i].string(!!fmt)
  enddo
  !this.blenList.dtext        = !this.blenString
  if(!this.blenList.dtext.set())then
    !this.blen.val            = !this.blenList.selection('dtext')
    !this.replace.visible     = true
    !this.blenList.callback   = '!this.blen.val = !this.blenList.selection(|dtext|)'
  else
    !this.blen.val            = object STRING()
    !this.replace.visible     = false
    !this.blenList.callback   = ''
  endif

endmethod
-- End of method definition for .populateData()
------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: apply
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   1      R     STRING     Action to be taken whether to create or Modify
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply(!action is STRING)

  !name    = !this.name.val
  if(!action eq 'CREATE') then

    NEW DTAB
    !this.currentElement     = !!ce
  endif
  if(!name.set())then
    !this.currentElement.name = '/' & !name
  endif

  do !i indices !this.blenValues
    !this.currentElement.blen[!i] = !this.blenValues[!i].real()
  enddo

endmethod
-- End of method definition for .apply()
------------------------------------------------------------------------
--
-- Method:      include
--
-- Description: include data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .include() is STRING

if (!this.enterSingle.val) then

     !stepString = !this.blen.val
     handle (46,73)
        return ''
     endhandle

else
     !stepString = ''

     do !step from !this.blenTag1.val to !this.blenTag2.val by !this.blenTag3.val
        !stepString = !stepString & ' , ' & !step
     enddo
     handle (46,73)
        !!alert.error('Field values are not complete.')
        return ''
     endhandle

     !stepString = !stepString.substring(3)

endif

     !temp = !this.blenList.dtext
     !temp.append(!stepString)
     !this.blenList.dtext = !temp
     !this.blenList.val   = !this.blenList.dtext.size()
     handle (61,620)
     endhandle

     -- Re-Initialise the hidden list.
     !this.addToList()

     return !stepString

endmethod
-- End of method definition for .include()

------------------------------------------------------------------------
--
-- Method:      replace
--
-- Description: replace data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .replace()

  !indx                       = !this.blenList.val
  !tempArray                  = !this.blenList.dtext
  !tempArray[!indx]           = !this.include()
  !this.blenList.dtext        = !tempArray

   -- Re-Initialise the hidden list.
  !this.addToList()

  !this.blenList.val          = !indx
  handle (61,620)
  endhandle

endmethod
-- End of method definition for .replace()

------------------------------------------------------------------------
--
-- Method:      delete
--
-- Description: delete data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .delete()

  !this.blenString.clear()
  !indx                       = !this.blenList.val
  !this.blenString            = !this.blenList.dtext
  !this.blenString.removeFrom(!indx,1)
  handle (2,771)
    return
  endhandle

  !this.blenList.dtext        = !this.blenString
  !this.blenList.val          = !indx
  handle (61,620)
  endhandle

  -- Re-Initialise the hidden list.
  !this.addToList()

endmethod
-- End of method definition for .replace()

------------------------------------------------------------------------
--
-- Method:      addtolist
--
-- Description: Adds a value entered to the current bolt length list.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .addToList()

!this.blenValues.clear()

do !lines value !this.blenList.dtext
   if (!lines.match(',') NE 0) then
       do !sep value !lines.split(',')
          !this.blenValues.append(!sep.real())
       enddo
   else
          !this.blenValues.append(!lines.real())
   endif
enddo

!this.blenValues.unique().sort()

endmethod
-- End of method definition for .addToList()

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: Adds a value entered to the current bolt length list.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clear()

!this.blenValues.clear()
!this.blenList.dtext = !this.blenValues

endmethod
-- End of method definition for .clear()
