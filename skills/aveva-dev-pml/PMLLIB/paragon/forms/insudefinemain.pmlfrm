------------------------------------------------------------------------
--
-- Method:      .createNewInscmg()
--
-- Description: Create a new INSCMG entry and update the list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createNewInscmg()

   if (!this.debug) then
      WRITE |Running insuDefineMain.createNewInscmg()|
   endif

   if !this.checkHierarchy() then
     return
   endif

   !safeCE = !!ce
   if (NOT !this.insulationComponent.getInscmgPoint()) then
      !!ce = !this.cataPoint[1].dbref()
      NEW SECT
      PURP INSC
      !this.insulationComponent.inscmgPoint[1] = !!ce.string()
   endif

   !!ce = !this.insulationComponent.inscmgPoint[1].dbref()
   TAIL
   NEW INSCMG
   !!ce = !safeCE

   !this.UpdateInscmgList()
   !this.ngcInscmgList.selectrow( !this.ngcInscmgList.getnumberrows() )

   if (!this.addToSelectionTable) then
	   -- Add to Selection Table
	   do !selected values !this.ngcInscmgList.getSelectedRows()
			!element = !selected[1].dbref()
			!this.AddToSelectionTable(!element)
		enddo
	endif

endmethod
