------------------------------------------------------------------------
--
-- Method:      DisplayLayerThickness()
--
-- Description: Display coating thickness/ fixing consumption data in text box
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayLayerThickness(!data is ARRAY)
  if (!this.debug) then
    WRITE |Running displayLayerThickness()|
  endif

  if (!data.size().neq(1) ) then
    WRITE |Incorrect array passed to displayLayerThickness()|
    return
  endif

  if (!data.set()) then
    !dbref = !this.ngcSelInslayList.getSelectedRows()[1][4].dbref()
    if( (type of $!dbref) eq 'INSLAY') then
      !this.txtThickness.active = TRUE
      !this.txtThickness.val = !this.ngcSelInslayList.getSelectedRows()[1][2].real()
      !this.txtProcde.active = TRUE
      !this.txtProcde.val = !this.ngcSelInslayList.getSelectedRows()[1][3].string()
      !this.btnAddCoating.active = FALSE
      !this.btnUpdate.active = TRUE
      !this.txtConsumption.val = REAL()
      !this.txtConsumption.active = FALSE
      !this.txtProcdeFix.val = ''
      !this.txtProcdeFix.active = FALSE
      !this.btnAddFixing.active = FALSE
      !this.btnUpdateFixing.active = FALSE
    elseif( (type of $!dbref) eq 'INCFIX') then
      !this.txtConsumption.val = !this.ngcSelInslayList.getSelectedRows()[1][2].real()
      !this.txtConsumption.active = TRUE
      !this.txtProcdeFix.val = !this.ngcSelInslayList.getSelectedRows()[1][3].string()
      !this.txtProcdeFix.active = TRUE
      !this.btnAddFixing.active = FALSE
      !this.btnUpdateFixing.active = TRUE
      !this.txtThickness.val = REAL()
      !this.txtThickness.active = FALSE
      !this.txtProcde.val = STRING()
      !this.txtProcde.active = FALSE
      !this.btnAddCoating.active = FALSE
      !this.btnUpdate.active = FALSE
    endif
  endif
endmethod
-- End of method definition for .displayLayerThickness()

------------------------------------------------------------------------
--
-- Method:      .getCataPoint()
--
-- Description: Getting Insulation Material Catalogue point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getCataPoint()

   var !insertpoint collect all CATA with PURP eq 'ICAT'

   if (!insertpoint.unset() OR !insertpoint.size().eq(0)) then
       NEW CATA
       PURP ICAT
       !this.cataPoint[1] = !!ce.string()
   else
       !this.cataPoint = !insertpoint
   endif

   !this.insulationComponent.cataPoint = !this.cataPoint

endmethod
-- End of method definition for .getCataPoint()

------------------------------------------------------------------------
--
-- Method:      .getPrtwldPoint()
--
-- Description: Getting Insulation Part World point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getPrtwldPoint()

	 !saveCE = !!CE
   var !prtwld collect all PRTWLD with PURP eq 'INSU'

   if (!prtwld.unset() OR !prtwld.size().eq(0)) then
			-- Create a new Part World
			NEW PRTWLD PURP INSU
			-- Create a new Part Family
			NEW PRTELE PURP INSU
      !this.prtwldPoint[1] = !!ce.string()
	 else
			!!CE = !prtwld[1].dbref()
			var !prtele collect all PRTELE with PURP eq 'INSU' for CE
			
			if (!prtele.unset() OR !prtele.size().eq(0)) then
				 -- Create a new Part Family
				 NEW PRTELE PURP INSU
	       !this.prtwldPoint[1] = !!ce.string()
			else
				 -- Set CE to PRTELE
				 !!CE = !prtele[1].dbref()
		   	 !this.prtwldPoint = !prtele
			endif			
   endif

   !this.insulationComponent.prtwldPoint = !this.prtwldPoint

   !!CE = !saveCE

endmethod
-- End of method definition for .getPrtwldPoint()

------------------------------------------------------------------------
--
-- Method:      .getSpwldPoint()
--
-- Description: Getting Insulation Specification World point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getSpwldPoint()

	 !saveCE = !!CE

   var !spwld collect all SPWLD with PURP eq 'INSU'

	 -- If not SPWLD with PURPOSE = INSU exists, then create a new SPWLD
   if (!spwld.unset() OR !spwld.size().eq(0)) then
			-- Create a new Specification World
			NEW SPWLD PURP INSU
			-- Create a new Table Group with PURPOSE = INSU
			NEW TABGRO PURP INSU
			-- Create a new Table with DESCRIPTION = INSULATION
			NEW CTABLE DESC 'INSULATION'
			!this.spwldPoint[1] = !!ce.string()
		 	-- Create a new Table Header
		 	NEW TABHEADER
		
--			-- Create a new Table Header
--			NEW TABHEADER
   else
			!!CE = !spwld[1].dbref()
			var !tabgro collect all TABGRO with PURP eq 'INSU' for CE
			if (!tabgro.unset() OR !tabgro.size().eq(0)) then
				 -- Create a new Table Group with PURPOSE = INSU
				 NEW TABGRO PURP INSU
				 -- Create a new Table with DESCRIPTION = INSULATION
				 NEW CTABLE DESC 'INSULATION'
				 !this.spwldPoint[1] = !!ce.string()
				 -- Create a new Table Header
	 			 NEW TABHEADER
			else
				 -- Set CE to TABGRO
				 !!CE = !tabgro[1].dbref()
				 var !ctable collect all CTABLE with DESC eq 'INSULATION' for CE
				 if (!ctable.unset() OR !ctable.size().eq(0)) then
				 		-- Create a new Table with DESCRIPTION = INSULATION
				 		NEW CTABLE DESC 'INSULATION'
				 		!this.spwldPoint[1] = !!ce.string()
					  -- Create a new Table Header
					  NEW TABHEADER
				 else
						-- Set CE to CTABLE
						!!CE = !ctable[1].dbref()
       			!this.spwldPoint[1] = !!ce.string()
					 	var !thead collect all TABHEADER for CE
					 	if (!thead.unset() OR !thead.size().eq(0)) then
						   -- Create a new Table Header
						   NEW TABHEADER
						endif
				 endif
			endif			
   endif

   !this.insulationComponent.spwldPoint = !this.spwldPoint
   !!CE = !saveCE

	
endmethod
-- End of method definition for .getSpwldPoint()

------------------------------------------------------------------------
--
-- Method:      .checkHierarchy()
--
-- Description: Checks the hierarchy to make sure that there is a CATA with
--      purp ICAT and if not it checks to see if one can be created.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkHierarchy() is BOOLEAN

  if (!this.debug) then
    WRITE |Running insuDefineMain.checkHierarchy()|
  endif

  --Save the current element.
  !saveCE = !!ce
  --Firstly search through the current CATA's with purp ICAT and see if we can write to any of them.
  do !index index !this.cataPoint
    !!ce = !this.cataPoint[!index].dbref()
    handle ANY
      !dbWrite = FALSE
      break
    elsehandle NONE
      !dbWrite = dbwrite
      if !dbWrite then
        if !index.eq(1) then
          return FALSE
        else
          --If the CATA we can write to is not the first in the cataPoint array then
          --we need it to be as the program uses this to create the surface treatments under.
          !this.cataPoint.insert(1, !this.cataPoint[!index])
          !this.cataPoint.remove(!index + 1)
          !this.insulationComponent.cataPoint = !this.cataPoint
          if !this.cataPoint[1].dbref().mCount().lt(2) then
            !this.createHierarchy('SECT')
          endif
          return FALSE
        endif
      endif
    endhandle
  enddo

  --Ask the user if they want us to create the CATA, if not return TRUE which will terminate the event.
  !answer = !!alert.confirm('There is no current catalogue for Insulations with write access available. $
                    Would you like the hierarchy creating for you?')
  if !answer.eq('NO') then
    !!ce = !saveCE
    return TRUE
  endif

  -- Make sure we have write enabled dbs available too us.
  !session = current session
  !writeAbleDbs = FALSE
  do !index index !session.current()
    if !session.status()[!index].eq('RW') then
      if !session.current()[!index].type.eq('CATA') then
        !writeAbleDbs = TRUE
        break
      endif
    endif
  enddo
  if !writeAbleDbs.not() then
    !!alert.message('All the Databases are Read-Only.')
    return TRUE
  endif

  -- And Finally lets find somewhere and create the CATA.
  !!ce = !saveCE
  if dbwrite then
    --If we can write to the saved current element then find the route element of that.
    if !!ce.name.neq('/*') then
      do
        --Cycle up through the hierarchy till we get to a point where we can create a CATA
        if !!ce.owner.name.eq('/*') then
          break
        else
          !!ce = !!ce.owner
        endif
      enddo
    endif
  else
    --Get the members of world and cycle through till we find one with dbwrite.
    !world = object DBREF('/*')
    do !element values !world.members
      !!ce = !element
      if dbwrite then
        break
      endif
    enddo
  endif

  !this.createHierarchy('ALL')

  return FALSE

endmethod
--End of method definition for .checkHierarchy()
------------------------------------------------------------------------
--
-- Method:      .createHierarchy()
--
-- Description: Creates the insulation hierarchy.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createHierarchy(!type is STRING)
	
	if !type.eq('ALL') then
	  --Create the CATA with PURP ICAT and place first in cataPoint Array.
	  NEW CATA
	  PURP ICAT
	  --Name the CATA for completion.
	  !inc = 1
	  do
	    !!ce.name = '/Space-Management-Cata-' + !inc.string()
	    handle (41,12)
	      !inc = !inc + 1
	    elsehandle NONE
	      break
	    endhandle
	  enddo
	  !this.cataPoint.insert(1, !!ce.name)
	  !this.insulationComponent.cataPoint = !this.cataPoint
	endif

  --Create the Insulation Components SECT and the Insulation Materials SECT
  NEW SECT
  PURP INSC
  --Name the Paint Section
  !inc = 1
  do
    !!ce.name = '/Insulation-Materials-' + !inc.string()
    handle (41,12)
      !inc = !inc + 1
    elsehandle NONE
      break
    endhandle
  enddo
  NEW SECT
  PURP INSM
  --Name the Insulation Components Section
  !inc = 1
  do
    !!ce.name = '/Insulation-Components-' + !inc.string()
    handle (41,12)
      !inc = !inc + 1
    elsehandle NONE
      break
    endhandle
  enddo

endmethod

--End of method definition for .createHierarchy()
