------------------------------------------------------------------------
--
-- Method:      generateInsmatList()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .generateInsmatList()

  if (!this.debug) then
    WRITE |Running insuDefineMain.generateInsmatList()|
  endif

-- setup controls for PML containers
  using namespace 'Aveva.pdms.presentation'

  if (NOT !this.insulationComponent.getInsulationPoint()) then
      -- create new sect with purp is INSM
      $!this.cataPoint[1]
      NEW SECT
      PURP INSM
      !this.insulationComponent.insmatPoint[1] = !!ce.string()
  else
      !allinsmats = !this.insulationComponent.getAllInsmat()

      -- Bind INSMAT data to grid
  !nds = object NETDATASOURCE('Insmats', !this.insmatHeadings, !this.insmatDisplayHeadings, !allinsmats)
  !this.ngcInsmatList.bindToDataSource(!nds)
  endif

endmethod
-- End of method definition for .generateInsmatList()

------------------------------------------------------------------------
--
-- Method:      generateInsufList()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .generateInsufList()

  if (!this.debug) then
    WRITE |Running insuDefineMain.generateInsufList()|
  endif

-- setup controls for PML containers
  using namespace 'Aveva.pdms.presentation'

  if (NOT !this.insulationComponent.getInsulationPoint()) then
      -- create new sect with purp is INSM
      $!this.cataPoint[1]
      NEW SECT
      PURP INSM
      !this.insulationComponent.insmatPoint[1] = !!ce.string()
  else
      !allinsufs = !this.insulationComponent.getAllInsuf()

      -- Bind INSUF data to grid
  !nds = object NETDATASOURCE('Insufs', !this.insufHeadings, !allinsufs)
  !this.ngcInsufList.bindToDataSource(!nds)
  endif

endmethod
-- End of method definition for .generateInsufList()

------------------------------------------------------------------------
--
-- Method:      UpdateInscmgList()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .UpdateInscmgList()

  if (!this.debug) then
    WRITE |Running insuDefineMain.UpdateInscmgList()|
  endif

-- setup controls for PML containers
  using namespace 'Aveva.pdms.presentation'

  if (NOT !this.insulationComponent.getInscmgPoint()) then
      -- create new sect with purp is INSC
      $!this.cataPoint[1]
      NEW SECT
      PURP INSC
      !this.insulationComponent.inscmgPoint[1] = !!ce.string()
  else
      !allinscmgs = !this.insulationComponent.getAllInscmg()

      -- Bind Insulation Components data to grid
      !nds = object NETDATASOURCE('Insulation Component Groups', !this.insCmgHeadings, !allinscmgs)
      !this.ngcInscmgList.bindToDataSource(!nds)
  endif

endmethod
-- End of method definition for .UpdateInscmgList()

------------------------------------------------------------------------
--
-- Method:      UpdateInscmpList()
--
-- Description: Update the INSCMP net grid control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .UpdateInscmpList( !cInscmg is DBREF)
  if (!this.debug) then
    WRITE |Running insuDefineMain.UpdateInscmpList()|
  endif

  --Purpose
  !purp = !this.GetPurpose()

  !list = object ARRAY()
  !list = !this.insulationComponent.getInscmpList( !cInscmg, !purp)

  -- Bind Insulation Components data to grid
  using namespace 'Aveva.pdms.presentation'
  !nds = object NETDATASOURCE('Insulation Components', !this.insCmpHeadings, !list)
  !this.ngcInscmpList.bindToDataSource(!nds)

  -- Reset layers
  !this.ngcSelInslayList.clearGrid()
  --!this.selectedInsCmp = object DBREF()
endmethod
-- End of method definition for .UpdateInscmpList

------------------------------------------------------------------------
--
-- Method:      UpdateInslayList()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateInslayList(!data is ARRAY)

  if (!data.size().neq(1) ) then
    WRITE |Incorrect array passed to updateInslayList()|
    return
  endif

-- !data[0][1] will be the ROWTAG for the selected row

  !chosen = !data[0]

  if (defined(!chosen[1]) ) then
    !this.generateInslayList()
  endif

endmethod
-- End of method definition for .updateInslayList()


------------------------------------------------------------------------
--
-- Method:      generateInslayList()
--
-- Description: Update the data grid for insulation layers/fixings based on the selected INSCMP
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .generateInslayList()

  if (!this.debug) then
    WRITE |Running insuDefineMain.generateInslayList()|
  endif

-- setup controls for PML containers
  using namespace 'Aveva.pdms.presentation'

  !entry = !this.ngcInscmpList.getSelectedRows()[1]
  !element = !entry[1].dbref()

  !allentries = object ARRAY()
  !allcoatings = !element.members

  !!thkFormater = object FORMAT()
  !!thkFormater.UNITS = 'MM'
  !!thkFormater.DIMENSION = 'L'


-- Generate data for rows

    do !item values !allcoatings
      if (!this.debug) then
        q var !item
      endif
      !rowdata = object ARRAY()
      if (!item.INMTRF.set() ) then
        if (NOT BADREF(!item.INMTRF)) then
            !rowdata[1] = !item.INMTRF.desc
        else
            -- if INMTRF is Badref, skip
            skip
        endif
      else
         -- if INMTRF is Null, skip
         skip
      endif
      !rowdata[2] = !item.thickn.String(!!thkFormater)
      !rowdata[3] = !item.procde
      !rowdata[4] = !item.name
      if (!this.debug) then
        q var !rowdata
      endif
      !allentries.append(!rowdata)
    enddo

-- Bind example data to grid
  !nds = object NETDATASOURCE('INSLAYs', !this.inslayHeadings, !this.inslayDisplayHeadings, !allentries)
  !this.ngcSelInslayList.bindToDataSource(!nds)
  !this.ngcSelInslayList.setColumnVisibility(4,FALSE)

endmethod
-- End of method definition for .generateInslayList()

------------------------------------------------------------------------
--
-- Method:      AddLayer()
--
-- Description: Add chosen data into the defined coatings list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addLayer()

    if (!this.txtThickness.val.unset() ) then
      !!alert.error('No value specified for thickness')
      return
    endif

    if (NOT !this.GetInscmp().set()) then
       !!alert.error('Not selected INSCMP on Grid Control')
       return FALSE
    endif

    if (NOT !this.ngcInsmatList.getSelectedRows().set()) then
      !!alert.error('Not selected INSMAT on Grid Control')
      return FALSE
    endif

-- Create new hierarchy element
    !safeCE = !!ce
    do !rowTag values !this.ngcInsmatList.getSelectedRowTags()
       !selected = !this.ngcInsmatList.getRow( !rowTag )

       !cInscmp = !this.GetInscmp()
       $!cInscmp
       TAIL
       NEW INSLAY
       INMTRF $!selected[1]
       THICKN $!this.txtThickness.val
       PROCDE |$!this.txtProcde.val|
    enddo
    !!ce = !safeCE
-- Update the displayed grid data
    !this.generateInslayList()

endmethod
-- End of method definition for .addLayer()

------------------------------------------------------------------------
--
-- Method:      AddFixing()
--
-- Description: Add chosen data into the defined coatings list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addFixing()

    if (!this.txtConsumption.val.unset() ) then
      !!alert.error('No value specified for consumption')
      return
    endif

    if (NOT !this.GetInscmp().set()) then
       !!alert.error('Not selected INSCMP on Grid Control')
       return FALSE
    endif

    if (NOT !this.ngcInsufList.getSelectedRows().set()) then
      !!alert.error('Not selected INSUF on Grid Control')
      return FALSE
    endif

-- Create new hierarchy element
    !safeCE = !!ce
    do !rowTag values !this.ngcInsufList.getSelectedRowTags()
       !selected = !this.ngcInsufList.getRow( !rowTag )

       !cInscmp = !this.GetInscmp()
       $!cInscmp
       TAIL
       NEW INCFIX
       INMTRF $!selected[1]
       THICKN $!this.txtConsumption.val
       PROCDE |$!this.txtProcdeFix.val|
    enddo
    !!ce = !safeCE
-- Update the displayed grid data
    !this.generateInslayList()

endmethod
-- End of method definition for .addFixing()

------------------------------------------------------------------------
--
-- Method:      Method:      UpdateThickness()
--
-- Description: Update thickness for INSLAY/ consumption for INCFIX
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateThickness()
  if (!this.debug) then
    WRITE |Running sftDefineCoatings.updateThickness()|
  endif

  if (NOT !this.ngcSelInslayList.getSelectedRows().set() ) then
    !!alert.error('Not selected INSLAY/INCFIX on Grid Control')
    return
  endif

  !safeCE = !!ce
  do !selected values !this.ngcSelInslayList.getSelectedRows()
     -- update element
     !dbref = !selected[4].dbref()
     $!dbref
     if( (type of $!dbref) eq 'INSLAY') then
       if (!this.txtThickness.val.unset() ) then
        !!alert.error('No value specified for thickness')
        return
       endif
       THICKN $!this.txtThickness.val
       !this.txtThickness.val = object REAL()
       PROCDE |$!this.txtProcde.val|
       !this.txtProcde.val = object STRING()
       --Update thickness and density of Insulation component
       !this.ngcInscmpList.RefreshTable()
     elseif( (type of $!dbref) eq 'INCFIX') then
       if (!this.txtConsumption.val.unset() ) then
        !!alert.error('No value specified for thickness')
        return
       endif
       THICKN $!this.txtConsumption.val
       !this.txtConsumption.val = object REAL()
       PROCDE |$!this.txtProcdeFix.val|
       !this.txtProcdeFix.val = object STRING()
     endif
  enddo

  !!ce = !safeCE

  !this.generateInslayList()
endmethod
-- End of method definition for .showExampleData()

------------------------------------------------------------------------
--
-- Method:      moveUp()
--
-- Description: Move selected entry higher in the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .moveUp()

  if (!this.debug) then
    WRITE |Running sftDefineMain.moveUp()|
  endif

  if (NOT !this.ngcSelInslayList.getSelectedRows().set()) then
    !!alert.error('Not selected move INSLAY item in Grid Control')
    return FALSE
  else
    !selected = !this.ngcSelInslayList.getSelectedRowTags()[1].real()
  endif

  if (NOT !this.ngcInscmpList.getSelectedRows().set()) then
    !!alert.error('Not selected INSCMP item in Grid Control')
    return FALSE
  else
    !element = !this.ngcInscmpList.getSelectedRowTags()[1].dbref()
  endif

  !safeCE = !!ce

  if (!selected.eq(1) ) then
    !!alert.error('Cannot move up from first position')
    return
  endif

-- Move to the selected SRFTRT element
  $!element

  !newpos = !selected - 1
  REO $!selected BEF $!newpos
  !!ce = !safeCE

  !this.generateInslayList()

endmethod
-- End of method definition for .moveUp()

------------------------------------------------------------------------
--
-- Method:      MoveDown()
--
-- Description: Move selected entry lower in the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .moveDown()

  if (!this.debug) then
    WRITE |Running sftDefineMain.moveDown()|
  endif

  if (NOT !this.ngcSelInslayList.getSelectedRows().set()) then
    !!alert.error('Not selected move INSLAY item in Grid Control')
    return FALSE
  else
    !selected = !this.ngcSelInslayList.getSelectedRowTags()[1].real()
  endif

  if (NOT !this.ngcInscmpList.getSelectedRows().set()) then
    !!alert.error('Not selected INSCMP item in Grid Control')
    return FALSE
  else
    !element = !this.ngcInscmpList.getSelectedRowTags()[1].dbref()
  endif

  !maxmem = !element.members.size()
  !safeCE = !!ce

  if (!selected.eq(!maxmem) ) then
    !!alert.error('Cannot move down from last position')
    return
  endif

-- Move to the selected SRFTRT element
  $!element

  !newpos = !selected + 1
  REO $!selected AFT $!newpos
  !!ce = !safeCE

  !this.generateInslayList()

endmethod
-- End of method definition for .moveDown()


------------------------------------------------------------------------
--
-- Method:      MoveToTop()
--
