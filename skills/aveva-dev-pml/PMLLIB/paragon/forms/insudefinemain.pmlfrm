-- File:            insudefinemain.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        Paragon
--   Replaces:
--
-- Author:          Kristofer Scherling
-- Created:         <day> <date> <time> <year>
--
--
--  Description:     Main Paragon form for Insulation definitions
--                   Used for management of INSMAT, INSCMP and INSCMP elements
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  AddToSelectionTable(DBREF)       -
--  CreateTableItem()                -                   Create a table for Insulation Component Group entry
--  GetInscmg()                      DBREF               Get current selected INSCMG element.
--  GetInscmp()                      DBREF               Get current selected INSCMP element.
--  GetPurpose()                     STRING              Get current purpose string.
--  UpdateInscmgList()               -
--  UpdateInscmpList(DBREF)          -                   Update the INSCMP net grid control
--  UpdateInscmpTable()              -                   Event handler for dropdown box purpose.
--  addFixing()                      -
--  addLayer()                       -                   Add layer into selected component
--  afterInscmgCellChanges(ARRAY)    -                   Check the changes made to editable cell and save if permitted
--  afterInscmpCellChanges(ARRAY)    -                   Check the changes made to editable cell and save if permitted
--  afterInsmatCellChanges(ARRAY)    -                   Check the changes made to editable cell and save if permitted
--  afterInsmatSelectChange(ARRAY)   -                   Update thickness textbox on Insulation material tab.
--  afterInsufCellChanges(ARRAY)     -                   check the changes made to editable cell in INSUF NETGRIDCONTROL, save if permitted
--  afterInsufSelectChange(ARRAY)    -                   Update thickness textbox on Insulation fixing tab.
--  applyCellChanges(ARRAY)          -                   Check the changes made to editable cell and save if permitted
--  applyChangesInscmg(ARRAY)        -                   Check the changes made to editable cell and save if permitted
--  cbUpdateMaterial(STRING)         -                   CallBack Function, called from modal dialog when material has been selected.
--  checkHierarchy()                 BOOLEAN             Checks the hierarchy to make sure that there is a CATA with
--  closeCallback()                  -                   Close CallBack Function
--  copyInsCmg()                     -                   Copy the selected Insulation Component Group entry to create a new entry
--  copyInsCmp()                     -                   Copy the selected SurfTreat entry to create a new entry
--  copyInsmat()                     -                   Copy the selected INSMAT entry to create a new entry
--  copyInsuf()                      -                   Copy the selected INSUF entry to create a new entry
--  createHierarchy(STRING)          -                   Creates the Insulation hierarchy.
--  createNewInscmg()                -                   Create a new INSCMG entry and update the list
--  createNewInscmp()                -                   Create a new PAINT entry and update the list
--  createNewInsmat()                -                   Create a new INSMAT entry and update the list
--  createNewInsuf()                 -                   Create a new INSUF entry and update the list
--  deleteInsCmg()                   -                   Delete the selected Insulation Component Group entry
--  deleteInsCmp()                   -                   Delete the selected SurfTreat entry
--  deleteInslayAll()                -
--  deleteInslayEntry()              -
--  deleteInsmat()                   -                   Delete the selected INSMAT entry
--  deleteInsuf()                    -                   Delete the selected INSUF entry
--  displayLayerThickness(ARRAY)     -
--  generateInslayList()             -
--  generateInsmatList()             -
--  generateInsufList()              -
--  getCataPoint()                   -                   Getting Paint Catalogue point
--  getPrtwldPoint()                 -                   Getting Part World point
--  getSpwldPoint()                  -                   Getting Specification World point
--  initialise()                     -
--  inscmpPopupHandler(ARRAY)        -
--  insmatPopupHandler(ARRAY)        -
--  insudefinemain()                 -                   Constructor
--  insufPopupHandler(ARRAY)         -                   Handle selection from Popup menu
--  moveDown()                       -
--  moveToBottom()                   -
--  moveToTop()                      -
--  moveUp()                         -                   Move selected entry higher in the list
--  selInslayPopupHandler(ARRAY)     -
--  selectedInscmgChanged(ARRAY)     -                   Update inscmp list
--  setMaterial()                    -                   Set material( density)on selected INSMAT entry
--  toggleState(GADGET)              -                   Sets whether the toggle is ticked or not
--  updateInslayList(ARRAY)          -
--  updateThickness()                -
--
------------------------------------------------------------------------

import 'GridControl'
handle (1000,0)
endhandle

-- Specify the namespace so we can refer to the .NET stuff
using namespace 'Aveva.pdms.presentation'
	
------------------------------------------------------------------------
-- Form:      Insulation
------------------------------------------------------------------------

setup form !!insuDefineMain dialog docking size 76 29

-- Define titles and initialisation call
  !this.formTitle = 'Insulation definition'
  !this.iconTitle = 'Insulation'
  !this.initcall  = '!this.initialise()'

  vdist 0.5
  hdist 2
  path down

  frame .fixheight panel at x0 y0 width 0 height 28
  exit

  frame .fixwidth  panel at x0 y0 width 110 height 0
  exit

-- *******************************************************************************************************
-- Insulation components list on the left side

  path down
  frame .frmInsCmg 'Insulation Component Groups'         at xmin+0.5                      anchor top+left            height 12.3
      container .conInsCompGroupGrid nobox PMLNetCONTROL 'NET'                            anchor top+left            width 52 height 10

      button  .btnCreateCmg           'New'          at ymax.conInsCompGroupGrid                                             width 10      callback '!this.createNewInscmg()'
      hdist 2.5
      path right
      button .btnCopyCmg              'Copy'                                                                                  width 10      callback '!this.copyInsCmg()'
      hdist 2.5
      button .btnDeleteInsCmg         'Delete'                                                                                width 10      callback '!this.deleteInsCmg()'
      hdist 2.5
      toggle .togAddToSelectionTable  'Add to Selection Table'                                                                tagwid 10      call |!this.toggleState(!this.togAddToSelectionTable)|
      hdist 2.5
  exit
  path down
  frame .frmInsulation  'Insulation components'         at ymax.frmInsCmg+0.5                                 anchor bottom+left
      option    .insCmpPurpSel  |Purpose|                                                                                                callback '!this.UpdateInscmpTable()'  width 9
      container .conInsulationGrid nobox PMLNetCONTROL 'NET'                              anchor top+bottom+left            width 52 height 10

      button .btnCreateInsulationLayer      ' New '   at ymax.conInsulationGrid                                             width 10     callback '!this.createNewInscmp()'
      hdist 2.5
      path right
      button .btncopyInsCmp     '  Copy  '                                                                                  width 10     callback '!this.copyInsCmp()'
      hdist 2.5
      button .btndeleteInsCmp   ' Delete '                                                                                  width 10     callback '!this.deleteInsCmp()'
      hdist 2.5
      button .btnRefreshSurfTreat  ' Refresh'                                                                               width 10     callback '!this.UpdateInscmpTable()'
      hdist 2.5
      path down
  exit

  LINE .lineV1                                             at xmax.frmInsulation + 1 ymin form anchor left+top+bottom VERT                   width 1  height 28.5

-- *******************************************************************************************************
--Available INSMATs at the BOTTOM RIGHT

  frame .tabset TABSET 'tabset'                            at xmax.lineV1 + 1 y 0.25 anchor bottom+left+right+top

      frame .frmInsmat  'Materials'                  at 0 0                          anchor bottom+left+right+top
          container .conInsmatGrid nobox PMLNetCONTROL 'NET'  at xmin+1 ymin+0.5     anchor bottom+right+left+top   width 51 height 9
          button .btnAddInsmat      ' New '     at xmin.conInsmatGrid + 2 ymax.conInsmatGrid+0.5 anchor bottom+left   width 10               callback '!this.createNewInsmat()'
          path right
          hdist 2
          button .btnCopyInsmat     '  Copy  '                                                    anchor bottom+left   width 10               callback '!this.copyInsmat()'
          hdist 2
          button .btnDeleteInsmat   ' Delete '                                                    anchor bottom+left   width 10               callback '!this.deleteInsmat()'
          hdist 2
          button .btnRefreshInsmat  ' Refresh'                                                    anchor bottom+left   width 10               callback '!this.generateInsmatList()'
          hdist 2
          path down
          -- Definition of thickness for new coating
          frame .frmAddLayer  'Add/Update Coating'                 at xmin.conInsmatGrid ymax.btnAddInsmat+1 anchor top+left           width 35 height 2
             text .txtThickness    'Thickness'                     tagwidth 8                                                width 8 is REAL
             text .txtProcde       'Proc Desc'                     tagwidth 8                                               width 20 is STRING
             button .btnAddCoating '  ADD '                        at xmax.txtThickness + 1  ymin.txtThickness                                      callback '!this.addLayer()'
             button .btnUpdate     'UPDATE'                        at xmax.btnAddCoating + 1 ymin.txtThickness                                      callback '!this.updateThickness()'
          exit
    exit

    frame .frmInsuf 'Fixings'                                   at 0 0            anchor bottom+left+right+top
          container .conInsufGrid nobox PMLNetCONTROL 'NET'  at xmin + 1 ymin + 0.5   anchor bottom+right+left+top   width 51 height 9
          button  .btnAddInsuf      ' New '                       at xmin.conInsufGrid + 2 ymax.conInsufGrid + 0.5 anchor bottom+left width 10                callback '!this.createNewInsuf()'
          path  right
          hdist 2
          button  .btnCopyInsuf     'Copy'                                                         anchor bottom+left width 10                callback '!this.copyInsuf()'
          hdist 2
          button  .btnDeleteInsuf     'Delete'                                                     anchor bottom+left width 10                callback '!this.deleteInsuf()'
          hdist 2
          button  .btnRefreshInsuf     'Refresh'                                                  anchor bottom+left width 10                callback '!this.generateInsufList()'
          hdist 2
          path down
          -- Definition number of fixings / area unit
          frame .frmAddFix  'Add/Update Fixing'                 at xmin.conInsufGrid ymax.btnAddInsuf+1 anchor top+left           width 35 height 2
             text .txtConsumption    'C/C'              tagwidth 8                                    width 8 is REAL
             text .txtProcdeFix       'Proc Desc'                     tagwidth 8                                               width 20 is STRING
             button .btnAddFixing    '  ADD '                   at xmax.txtConsumption + 1  ymin.txtConsumption                          callback '!this.addFixing()'
             button .btnUpdatefixing 'UPDATE'                   at xmax.btnAddFixing + 1 ymin.txtConsumption                             callback '!this.updateThickness()'
          exit
    exit

  exit

  path down
  LINE .lineH1                                             at xmin.tabset ymax.tabset + 0.1 anchor right+left+top HORIZ  width .tabset height 1

-- *******************************************************************************************************
-- Selected insulation layers on the top right side
  frame .frmSelLayers 'Selected Layers'                   at xmax.lineV1+1 ymax.lineH1           anchor bottom+top+left+right
    container .conSelLayerGrid nobox PMLNetCONTROL 'NET'               anchor bottom+top+left+right                               width 52 height 8
  exit

-- *******************************************************************************************************
-- Right click menu for managing INSMAT
  menu .mnuInsmatOptions popup
    !this.mnuInsmatOptions.add( 'CALLBACK', 'Create','!this.createNewInsmat()' )
    !this.mnuInsmatOptions.add( 'CALLBACK', 'Copy','!this.copyInsmat()' )
    !this.mnuInsmatoptions.add( 'CALLBACK', 'Set Material', '!this.setMaterial()' )
    !this.mnuInsmatOptions.add( 'SEPARATOR' )
    !this.mnuInsmatOptions.add( 'CALLBACK', 'Delete','!this.deleteInsmat()' )

-- Right click menu for managing INSUF
  menu .mnuInsufOptions popup
    !this.mnuInsufOptions.add( 'CALLBACK', 'Create','!this.createNewInsuf()' )
    !this.mnuInsufOptions.add( 'CALLBACK', 'Copy','!this.copyInsuf()' )
    !this.mnuInsufOptions.add( 'SEPARATOR' )
    !this.mnuInsufOptions.add( 'CALLBACK', 'Delete','!this.deleteInsuf()' )

-- Right click menu for managing Insulation Components
  menu .mnuInscmpOptions popup
    !this.mnuInscmpOptions.add( 'CALLBACK', 'Create','!this.createNewInscmp()' )
    !this.mnuInscmpOptions.add( 'CALLBACK', 'Copy','!this.copyInsCmp()' )
    !this.mnuInscmpOptions.add( 'SEPARATOR' )
    !this.mnuInscmpOptions.add( 'CALLBACK', 'Delete','!this.deleteInsCmp()' )

-- Right click menu for managing selected layers
  menu .mnuOrdering popup
    !this.mnuOrdering.add( 'CALLBACK', 'Move to first place','!this.moveToTop()' )
    !this.mnuOrdering.add( 'CALLBACK', 'Move up one place','!this.moveUp()' )
    !this.mnuOrdering.add( 'CALLBACK', 'Move down one place','!this.moveDown()')
    !this.mnuOrdering.add( 'CALLBACK', 'Move to last place','!this.moveToBottom()')
    !this.mnuOrdering.add( 'SEPARATOR' )
    !this.mnuOrdering.add( 'CALLBACK', 'Remove selected layer','!this.deleteInslayEntry()')
    !this.mnuOrdering.add( 'CALLBACK', 'Remove all layers','!this.deleteInslayAll()')

-- *******************************************************************************************************
-- End of FORM definition

-- Define member variables
   member .ngcInsmatList      is  NETGRIDCONTROL
   member .ngcInsufList       is  NETGRIDCONTROL

   member .ngcInscmgList  is  NETGRIDCONTROL
   member .ngcInscmpList  is  NETGRIDCONTROL
   member .ngcSelInslayList is  NETGRIDCONTROL

   member .insmatHeadings         is  ARRAY
   member .insmatDisplayHeadings  is  ARRAY
   member .insufHeadings          is  ARRAY
   member .cataPoint              is  ARRAY
   member .prtwldPoint            is  ARRAY
   member .spwldPoint             is  ARRAY
   member .insCmgHeadings         is  ARRAY
   member .insCmpHeadings         is  ARRAY
   member .inslayHeadings         is  ARRAY
   member .inslayDisplayHeadings  is  ARRAY
   member .insCmpPurp             is  ARRAY
   member .insCmpPurpDisp         is  ARRAY

   --member .selectedInsCmp    is  DBREF
   member .debug             is  BOOLEAN
   member .insulationComponent      is  INSGETTING

-- Stored the new name with '/'
   member .newName           is  STRING
   member .rowTag            is  STRING
   member .columnTag         is  STRING
   member .flag              is  REAL
   member .fInscmg           is  REAL

   member .addToSelectionTable is BOOLEAN

exit
------------------------------------------------------------------------
--
-- Method:      insudefinemain
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insudefinemain()

-- Control of additional debugging messages during processing
  !this.debug = FALSE
  if (defined(!!debug) ) then
    !this.debug = TRUE
  endif

-- setup controls for PML containers
  using namespace 'Aveva.pdms.presentation'

-- add .Net control to PML container for INSMAT and INSUF
  !this.ngcInsmatList = object NETGRIDCONTROL()
  !this.conInsmatGrid.control = !this.ngcInsmatList.handle()
  !this.ngcInsufList = object NETGRIDCONTROL()
  !this.conInsufGrid.control = !this.ngcInsufList.handle()

-- add .Net control to PML container
  !this.ngcInscmgList = object NETGRIDCONTROL()
  !this.conInsCompGroupGrid.control = !this.ngcInscmgList.handle()
  !this.ngcInscmpList = object NETGRIDCONTROL()
  !this.conInsulationGrid.control = !this.ngcInscmpList.handle()

  !this.conInsmatGrid.popup = !this.mnuInsmatOptions
  !this.conInsufGrid.popup = !this.mnuInsufOptions
  !this.conInsulationGrid.popup = !this.mnuInscmpOptions

-- add .Net control to PML container for selected COATINGS
  !this.ngcSelInslayList = object NETGRIDCONTROL()
  !this.conSelLayerGrid.control = !this.ngcSelInslayList.handle()

-- add PML event handlers to .Net control
  !this.ngcInsmatList.addeventhandler('BeforeCellUpdate', !this, 'ApplyCellChanges')
  !this.ngcInsmatList.addeventhandler('OnPopup', !this, 'insmatPopupHandler')
  !this.ngcInsmatList.addeventhandler('AfterCellUpdate', !this, 'afterInsmatCellChanges')
  !this.ngcInsmatList.addeventhandler('AfterSelectChange', !this, 'afterInsmatSelectChange')

  !this.ngcInsufList.addeventhandler('BeforeCellUpdate', !this, 'ApplyCellChanges')
  !this.ngcInsufList.addeventhandler('OnPopup', !this, 'insufPopupHandler')
  !this.ngcInsufList.addeventhandler('AfterCellUpdate', !this, 'afterInsufCellChanges')
  !this.ngcInsufList.addeventhandler('AfterSelectChange', !this, 'afterInsufSelectChange')

  !this.ngcInscmpList.addeventhandler('BeforeCellUpdate', !this, 'ApplyCellChanges')
  !this.ngcInscmpList.addeventhandler('AfterCellUpdate', !this, 'afterInscmpCellChanges')
  !this.ngcInscmpList.addeventhandler('OnPopup', !this, 'inscmpPopupHandler')
  !this.ngcInscmpList.addeventhandler('AfterSelectChange', !this, 'updateInslayList')

  !this.ngcSelInslayList.addeventhandler('OnPopup', !this, 'selInslayPopupHandler')
  !this.ngcSelInslayList.addeventhandler('AfterSelectChange', !this, 'displayLayerThickness')

  !this.ngcInscmgList.addeventhandler('BeforeCellUpdate', !this, 'applyChangesInscmg')
  !this.ngcInscmgList.addeventhandler('AfterCellUpdate', !this, 'afterInscmgCellChanges')
  !this.ngcInscmgList.addeventhandler('AfterSelectChange', !this, 'selectedInscmgChanged')

  !this.conSelLayerGrid.popup = !this.mnuOrdering

  !this.cancelCall        = '!this.closeCallback()'

endmethod
-- End of method definition for .insudefinemain()


------------------------------------------------------------------------
--
-- Method:      Initialise()
--
-- Description: Initialise the form each time it is displayed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  if (!this.debug) then
    WRITE |Running insuDefineMain.initialise()|
  endif

-- setup controls for PML containers
  using namespace 'Aveva.pdms.presentation'

-- Setup the display grid headings
  !this.insmatHeadings[1] = 'NAME'
  !this.insmatHeadings[2] = 'DESCRIPTION'
  !this.insmatHeadings[3] = 'MAKER'
  !this.insmatHeadings[4] = 'DNSTY'

  !this.insmatDisplayHeadings = !this.insmatHeadings
  !this.insmatDisplayHeadings[4] = 'DENSITY'

  !this.insufHeadings[1]  = 'NAME'
  !this.insufHeadings[2]  = 'DESCRIPTION'
  !this.insufHeadings[3]  = 'MAKER'

  !this.insCmpHeadings[1] = 'NAME'
  !this.insCmpHeadings[2] = 'FIRERA'
  !this.insCmpHeadings[3] = 'NOISECAT'
  !this.insCmpHeadings[4] = 'THERMAL'
  !this.insCmpHeadings[5] = 'PRICEEST'
  !this.insCmpHeadings[6] = 'THICKNESS'
  !this.insCmpHeadings[7] = 'DNSTY'

  !this.insCmgHeadings[1] = 'NAME'
  !this.insCmgHeadings[2] = 'DESCRIPTION'

  !this.inslayHeadings[1] = 'DESCRIPTION'
  !this.inslayHeadings[2] = 'THICKNESS'
  !this.inslayHeadings[3] = 'PROCDE'
  !this.inslayHeadings[4] = 'NAME'

  !this.inslayDisplayHeadings = !this.inslayHeadings
  !this.inslayDisplayHeadings[2] = 'THCK'

  !this.insCmpPurp[1] = 'HPLA'
  !this.insCmpPurp[2] = 'HSTI'

  !this.insCmpPurpDisp[1] = 'PLATE'
  !this.insCmpPurpDisp[2] = 'STIFFENER'

  !t = true
  !f = false

-- Basic settings for INSMAT grid
  !this.ngcInsmatList.columnExcelFilter(!t)
  !this.ngcInsmatList.outlookGroupStyle(!f)
  !this.ngcInsmatList.fixedHeaders(!f)
  !this.ngcInsmatList.fixedRows(!t)
  !this.ngcInsmatList.editableGrid(!t)
  !this.ngcInsmatList.singlerowselection(!f)
  !this.ngcInsmatList.setalternaterowcolor(231, 231, 231)

-- Basic settings for INSUF grid
  !this.ngcInsufList.columnExcelFilter(!t)
  !this.ngcInsufList.outlookGroupStyle(!f)
  !this.ngcInsufList.fixedHeaders(!f)
  !this.ngcInsufList.fixedRows(!t)
  !this.ngcInsufList.editableGrid(!t)
  !this.ngcInsufList.singlerowselection(!f)
  !this.ngcInsufList.setalternaterowcolor(231, 231, 231)

-- Basic settinss for Insulation Component Group grid
  !this.ngcInscmgList.columnExcelFilter(!f)
  !this.ngcInscmgList.outlookGroupStyle(!f)
  !this.ngcInscmgList.fixedHeaders(!f)
  !this.ngcInscmgList.fixedRows(!t)
  !this.ngcInscmgList.editableGrid(!t)
  !this.ngcInscmgList.singlerowselection(!t)
  !this.ngcInscmgList.setalternaterowcolor(231, 231, 231)

-- Basic settings for Insulation Component grid
  !this.ngcInscmpList.columnExcelFilter(!f)
  !this.ngcInscmpList.outlookGroupStyle(!f)
  !this.ngcInscmpList.fixedHeaders(!f)
  !this.ngcInscmpList.fixedRows(!t)
  !this.ngcInscmpList.editableGrid(!t)
  !this.ngcInscmpList.singlerowselection(!t)
  !this.ngcInscmpList.setalternaterowcolor(231, 231, 231)
  --!this.ngcInscmpList.setEditableColumn(6,!f)

-- Basic settings for SELECTED Insulation Layer grid
  !this.ngcSelInslayList.columnExcelFilter(!f)
  !this.ngcSelInslayList.outlookGroupStyle(!f)
  !this.ngcSelInslayList.fixedHeaders(!f)
  !this.ngcSelInslayList.fixedRows(!f)
  !this.ngcSelInslayList.editableGrid(!f)
  !this.ngcSelInslayList.singlerowselection(!f)
  !this.ngcSelInslayList.setalternaterowcolor(231, 231, 231)
  !this.ngcSelInslayList.headerSort(!f)
  !this.ngcSelInslayList.setColumnVisibility(4,FALSE)

-- Init the dropdown for inscmp purpose
  !this.insCmpPurpSel.dtext = !this.insCmpPurpDisp
  !this.insCmpPurpSel.rtext = !this.insCmpPurp

  !this.insulationComponent = object INSGETTING()

-- Getting Catalogue Point
  !this.getCataPoint()

-- Getting Part World Point
  !this.getPrtwldPoint()

-- Getting Specification World Point
  !this.getSpwldPoint()

  if (!this.cataPoint.set()) then
--  Gather all data for display on Insulation Component tab
    !this.UpdateInscmgList()
--  Display data on Materials tab
    !this.generateInsmatList()
--  Display data on Fixings tab
    !this.generateInsufList()
  endif

  !this.flag = 0
  !this.fInscmg = 0

  !this.btnAddCoating.active = FALSE
  !this.btnUpdate.active = FALSE
  !this.btnAddFixing.active = FALSE
  !this.btnUpdateFixing.active = FALSE
  !this.txtConsumption.active = FALSE
  !this.txtProcdeFix.active = FALSE
  !this.txtThickness.active = FALSE
  !this.txtProcde.active = FALSE

  !this.addToSelectionTable = FALSE

endmethod
-- End of method definition for .initialise()


------------------------------------------------------------------------
--
-- Method:      insmatPopupHandler()
--
-- Description: Handle selection from Popup menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insmatPopupHandler(!data is ARRAY)

-- Check that some rows are selected before showing the menu
  if (!data.size() gt 2) then
    !this.conInsmatGrid.showPopup(!data[0], !data[1])
  endif

endmethod
-- End of method definition for .insmatPopupHandler()

------------------------------------------------------------------------
--
-- Method:      insufPopupHandler()
--
-- Description: Handle selection from Popup menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .insufPopupHandler(!data is ARRAY)

-- Check that some rows are selected before showing the menu
  if (!data.size() gt 2) then
    !this.conInsufGrid.showPopup(!data[0], !data[1])
  endif

endmethod
-- End of method definition for .insufPopupHandler()

------------------------------------------------------------------------
--
-- Method:      inscmpPopupHandler()
--
-- Description: Handle selection from Insulation Component Popup menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .inscmpPopupHandler(!data is ARRAY)

-- Check that some rows are selected before showing the menu
  if (!data.size().gt(2) ) then
    !this.conInsulationGrid.showPopup(!data[0], !data[1])
  endif

endmethod
-- End of method definition for .inscmpPopupHandler()

------------------------------------------------------------------------
--
-- Method:      selInslayPopupHandler()
--
-- Description: Handle selection from Popup menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selInslayPopupHandler(!data is ARRAY)


-- Check that some rows are selected before showing the menu
  if (!data.size() gt 2) then
    !this.conSelLayerGrid.showPopup(!data[0], !data[1])
  endif

endmethod
-- End of method definition for .selInslayPopupHandler()

------------------------------------------------------------------------
--
-- Method:      .deleteInsmat()
--
-- Description: Delete the selected Insulation material entry
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteInsmat()

  if (!this.debug) then
    WRITE |Running insuDefineMain.deleteInsmat()|
  endif

  if (NOT !this.ngcInsmatList.getSelectedRows().set()) then
    !!alert.error('Not selected INSMAT item in Grid Control')
    return
  endif

  if ( !!alert.confirm('Delete insulation material - are you sure?').eq('YES') ) then
     !safeCE = !!ce
     do !selected values !this.ngcInsmatList.getSelectedRows()
         !element = !selected[1].dbref()
         $!element
         DELETE INSMAT
     enddo

     !this.ngcInsmatList.deleteSelectedRows()
     !!ce = !safeCE
     handle (2,822)
        -- Cannot set current element to an unset reference
        -- (i.e. item has been deleted)
     endhandle
  endif

endmethod
-- End of method definition for .deleteInsmat()

