------------------------------------------------------------------------
--
-- Method:      .createNewInscmp()
--
-- Description: Create a new INSCMP entry and update the list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createNewInscmp()

   if (!this.debug) then
      WRITE |Running insuDefineMain.createNewInscmp()|
   endif

   !cInscmg = !this.GetInscmg()
   if( !cInscmg.set()) then
     !safeCE = !!ce
     !!ce = !cInscmg
     TAIL
     NEW INSCMP
     !purp = !this.GetPurpose()
     PURP $!purp
     !!ce = !safeCE
     !this.UpdateInscmpList( !cInscmg)
     !this.ngcInscmpList.selectrow( !this.ngcInscmpList.getnumberrows() )
   else
     !!alert.error(|No INSCMG is selected|)
   endif

endmethod
-- End of method definition for .createNewInscmp()

------------------------------------------------------------------------
--
-- Method:      deleteInslayEntry()
--
-- Description: Remove selected entry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteInslayEntry()

  if ( !!alert.confirm('Delete selected INSLAY - Are you sure?').eq('YES') ) then
      !safeCE = !!ce
      do !selected values !this.ngcSelInslayList.getSelectedRows()
          -- delete element
          !dbref = !selected[4].dbref()
          $!dbref
          if( (type of $!dbref) eq 'INSLAY') then
            delete INSLAY
          elseif( (type of $!dbref) eq 'INCFIX') then
            delete INCFIX
          endif
      enddo
      !!ce = !safeCE
      handle (2,822)
        -- Cannot set current element to an unset reference
        -- (i.e. item has been deleted)
      endhandle

      !this.ngcSelInslayList.deleteSelectedRows()
  endif

endmethod
-- End of method definition for .deleteInslayEntry()


------------------------------------------------------------------------
--
-- Method:      deleteInslayAll()
--
-- Description: Remove all insulation layers
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteInslayAll()

  if ( !!alert.confirm('Delete ALL INSLAYs - Are you sure?').eq('YES') ) then

    !safeCE = !!ce

   !inscmp = !this.ngcInscmpList.getSelectedRows()[1][1]
-- Move to the selected INSCMP element
    $!inscmp

    delete INSCMP MEM

    !!ce = !safeCE
    handle (2,822)
        -- Cannot set current element to an unset reference
        -- (i.e. item has been deleted)
    endhandle

    !this.generateInslayList()

  endif
endmethod
-- End of method definition for .deleteInslayAll()

------------------------------------------------------------------------
--
-- Method:      .applyChangesInscmg()
--
-- Description: Check the changes made to editable cell and save if permitted
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyChangesInscmg(!data is ARRAY)

  if (!this.debug) then
    WRITE |Running insuDefineMain.applyChangesInscmg()|
    q var !data
$(  q var !data
<ARRAY>
   [0]  <STRING> 'aaaaa'        (new value)
   [1]  <STRING> '=15353/363'   (row tag)
   [2]  <STRING> 'NAME'        (column header)
   [3]  <BOOLEAN> TRUE          (control flag)

$)
  endif

-- This flag is using due to quit update cell. Once running the afterCellUpdate is 1, otherwise 0
-- You can be able to write the name without '/' in Grid Cell
  if (!this.fInscmg eq 1 ) then
      !this.newName = object STRING()
      !this.fInscmg = 0
      return
  endif

  !item = !data[1].dbref()

  !this.newName = object STRING()
  if ((!data[2] eq 'NAME') and (!data[0].subString(1,1) neq '/')) then
     !data[0] = '/' + !data[0]
     !this.newName = !data[0]
     !this.rowTag = !data[1]
     !this.columnTag = !data[2]
  endif

  !item.$!data[2] = !data[0]

  handle (41,12)
     !error = 'Name ' + !data[0] + ' already used'
     !!alert.error(!error)
     !data[3] = FALSE
     return
  elsehandle (2,794)
     !item.$!data[2] = Real(!data[0])
     handle (2,441)
        !error = 'Unable to convert string ' + !data[0] + ' to a REAL value'
        !!alert.error(!error)
        !data[3] = FALSE
        return
     endhandle
  endhandle

endmethod
-- End of method definition for .applyChangesInscmg()

------------------------------------------------------------------------
--
-- Method:      .applyCellChanges()
