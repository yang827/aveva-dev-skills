$)
  endif

-- This flag is using due to quit update cell. Once running the afterCellUpdate is 1, otherwise 0
-- You can be able to write the name without '/' in Grid Cell
  if (!this.flag eq 1 ) then
      !this.newName = object STRING()
      !this.flag = 0
      return
  endif

  !item = !data[1].dbref()

  !this.newName = object STRING()
  if ((!data[2] eq 'NAME') and (!data[0].subString(1,1) neq '/')) then
     !data[0] = '/' + !data[0]
     !this.newName = !data[0]
     !this.rowTag = !data[1]
     !this.columnTag = !data[2]
  endif

  !item.$!data[2] = !data[0]

  handle (41,12)
     !error = 'Name ' + !data[0] + ' already used'
     !!alert.error(!error)
     !data[3] = FALSE
     return
  elsehandle (2,794)
     !item.$!data[2] = Real(!data[0])
     handle (2,441)
        !error = 'Unable to convert string ' + !data[0] + ' to a REAL value'
        !!alert.error(!error)
        !data[3] = FALSE
        return
     endhandle
  endhandle

endmethod
