------------------------------------------------------------------------
--
-- Method:      .createNewInsmat()
--
-- Description: Create a new INSMAT entry and update the list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createNewInsmat()

   if (!this.debug) then
      WRITE |Running insuDefineMain.createNewInsmat()|
   endif

   if !this.checkHierarchy() then
     return
   endif

   !safeCE = !!ce
   if (NOT !this.insulationComponent.getInsulationPoint()) then
      !!ce = !this.cataPoint[1].dbref()
      NEW SECT
      PURP INSM
      !this.insulationComponent.insmatPoint[1] = !!ce.string()
   endif

   !!ce = !this.insulationComponent.insmatPoint[1].dbref()
   TAIL
   NEW INSMAT
   !!ce = !safeCE

   !this.generateInsmatList()
   !this.ngcInsmatList.selectrow( !this.ngcInsmatList.getnumberrows() )

endmethod
-- End of method definition for .createNewInsmat()

