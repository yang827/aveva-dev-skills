------------------------------------------------------------------------
--
-- Method:      .copyInsmat()
--
-- Description: Copy the selected INSMAT entry to create a new entry
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .copyInsmat()

  if (!this.debug) then
    WRITE |Running insuDefineMain.copyInsmat()|
  endif

  if (NOT !this.ngcInsmatList.getSelectedRows().set()) then
      !!alert.error('Not selected INSMAT item in Grid Control')
      return
  endif

   !safeCE = !!ce
   do !selected values !this.ngcInsmatList.getSelectedRows()
       !element = !selected[1].dbref()
       $!element
       END
       TAIL
       NEW INSMAT
       COPY $!element
   enddo

   !!ce = !safeCE

   !this.generateInsmatList()
-- Select the last entry in the list i.e. the new one!
  !this.ngcInsmatList.selectrow( !this.ngcInsmatList.getnumberrows() )

endmethod
-- End of method definition for .copyInsmat()

