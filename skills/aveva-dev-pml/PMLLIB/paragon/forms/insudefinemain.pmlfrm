------------------------------------------------------------------------
--
-- Method:      .cbUpdateMaterial()
--
-- Description: CallBack Function, called from modal dialog when material has been selected.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .cbUpdateMaterial( !arg is STRING)
  if (!this.debug) then
    WRITE |Running insuDefineMain.cbUpdateMaterial()|
  endif

  if (NOT !this.ngcInsmatList.getSelectedRows().set()) then
    !!alert.error('Not selected INSMAT item in Grid Control')
    return FALSE
  endif

  do !selected values !this.ngcInsmatList.getSelectedRows()
    !element = !selected[1].dbref()
    !element.MATREF = object DBREF(!arg)
  enddo

-- Update lists
  !this.generateInsmatList()
  !this.UpdateInscmgList()
endmethod
--End of method definition for .cbUpdateMaterial()

------------------------------------------------------------------------
--
-- Method:      .afterInsmatSelectChange()
--
-- Description: Update thickness textbox on Insulation material tab.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .afterInsmatSelectChange(!data is ARRAY)
  if (!this.debug) then
    WRITE |Running afterInsmatSelectChange()|
  endif

  !this.txtThickness.active = TRUE
  !this.txtThickness.val = REAL()
  !this.txtProcde.active = TRUE
  !this.txtProcde.val = STRING()
  !this.btnAddCoating.active = TRUE
  !this.btnUpdate.active = FALSE

endmethod
--End of method definition for .cbUpdateMaterial()

------------------------------------------------------------------------
--
-- Method:      .selectedInscmgChanged()
--
-- Description: Update inscmp list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectedInscmgChanged(!data is ARRAY)
  if (!this.debug) then
    WRITE |Running selectedInscmgChanged(!data is ARRAY)|
  endif

  if( !data.size().gt(0)) then
    if( !data[0].size().gt(0) and !data[0][1].set() )then
      --Selected element
      !selected = !data[0][1].dbref()
      !this.UpdateInscmpList( !selected)
    endif
  endif

endmethod
--End of method definition for .selectedInscmgChanged(!data is ARRAY)

------------------------------------------------------------------------
--
-- Method:      .afterInsufSelectChange()
--
-- Description: Update thickness textbox on Insulation fixing tab.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .afterInsufSelectChange(!data is ARRAY)
  if (!this.debug) then
    WRITE |Running afterInsufSelectChange()|
  endif

  !this.txtConsumption.val = REAL()
  !this.txtConsumption.active = TRUE
  !this.txtProcdeFix.val = ''
  !this.txtProcdeFix.active = TRUE
  !this.btnAddFixing.active = TRUE
  !this.btnUpdateFixing.active = FALSE
endmethod
--End of method definition for .afterInsufSelectChange(!data is ARRAY)

------------------------------------------------------------------------
--
-- Method:      .UpdateInscmpTable()
--
-- Description: Event handler for dropdown box purpose.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .UpdateInscmpTable()
  if (!this.debug) then
    WRITE |Running UpdateInscmpTable()|
  endif

  !cInscmg = !this.GetInscmg()
  if( !cInscmg.set()) then
    !this.UpdateInscmpList( !cInscmg)
  endif

endmethod
--End of method definition for .UpdateInscmpTable()

------------------------------------------------------------------------
--
-- Method:      .GetPurpose()
--
-- Description: Get current purpose string.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .GetPurpose() is STRING
  if (!this.debug) then
    WRITE |Running GetPurpose()|
  endif

  return !this.insCmpPurpSel.selection()
endmethod
--End of method definition for .GetPurpose()

------------------------------------------------------------------------
--
-- Method:      .GetInscmg()
--
-- Description: Get current selected INSCMG element.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .GetInscmg() is DBREF
  if (!this.debug) then
    WRITE |Running GetInscmg()|
  endif

  !cInscmg = object DBREF()

  if ( !this.ngcInscmgList.getSelectedRows().set()) then
    !cInscmg = !this.ngcInscmgList.getSelectedRows()[1][1].dbref()
  endif

  return !cInscmg
endmethod
--End of method definition for .GetInscmg

------------------------------------------------------------------------
--
-- Method:      .GetInscmp()
--
-- Description: Get current selected INSCMP element.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .GetInscmp() is DBREF
  if (!this.debug) then
    WRITE |Running GetInscmp()|
  endif

  !cInscmp = object DBREF()

  if( !this.ngcInscmpList.getSelectedRows().set()) then
    !cInscmp = !this.ngcInscmpList.getSelectedRows()[1][1].dbref()
  endif

  return !cInscmp
endmethod
--End of method definition for .GetInscmp

------------------------------------------------------------------------
--
-- Method:      .CreateTableItem()
--
-- Description: Create a table for Insulation Component Group entry
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .CreateTableItem()

  if (!this.debug) then
    WRITE |Running insuDefineMain.CreateTableItem()|
  endif

  if (NOT !this.GetInscmg().set()) then
    !!alert.error('No selected INSCMG items in Grid Control')
    return FALSE
  endif

	do !selected values !this.ngcInscmgList.getSelectedRows()
		!element = !selected[1].dbref()
		!this.AddToSelectionTable(!element)
	enddo

endmethod
-- End of method definition for .CreateTableItem()

------------------------------------------------------------------------
--
-- Method:      .AddToSelectionTable()
--
-- Description: Add to Selection Table
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .AddToSelectionTable(!element is DBREF)

  if (!this.debug) then
    WRITE |Running insuDefineMain.AddToSelectionTable()|
  endif

	!saveCE = !!CE
	
	-- Getting Part World Point
  !this.getPrtwldPoint()

	-- Getting Specification World Point
  !this.getSpwldPoint()

	if (!element.type.eq('INSCMG')) then

		-- Create a new GPART
		!!CE = !this.prtwldPoint[1].dbref()
		NEW GPART
		-- Set Insuref to point at the Insulation stored in !element
		!!CE.INSUREF = !element
		-- Save a reference to the GPART
		!gpartElem = !!CE

		-- Create a new Table Item
		!!CE = !this.spwldPoint[1].dbref()
		NEW TABITEM
		-- Set Prtreference to point at the GPART stored in !gpartElem
		!!CE.PrtReference = !gpartElem
	endif

	!!CE = !saveCE

endmethod
-- End of method definition for .AddToSelectionTable()

------------------------------------------------------------------------
--
-- Method:      .toggleState(GADGET)
--
-- Description: Sets whether the toggle is ticked or not
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toggleState(!tog is GADGET)
	if (!tog.val) then
		!this.addToSelectionTable = TRUE
	else
		!this.addToSelectionTable = FALSE
	endif
endmethod
-- End of method definition for .toggleState()
