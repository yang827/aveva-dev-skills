--
-- Description:
-- APPWARE for creating BOLT Table
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(STRING)                    -                   apply
--  changeMode()                     -                   callback of Changing  Mode between create and modify
--  close()                          -                   close the form
--  include()                        -                   include
--  initialise()                     -                   Initialisation method
--  loadsbr()                        -                   replace
--  mBoltElements()                  -                   Constructor
--  populateData()                   -                   Populate attributes of selected coco to gadgets.
--  remove()                         -                   remove from list
--  replace()                        -                   replace
--  textValidation(GADGET,STRING)    -                   Validate textbox values
--

setup form !!mBoltElements  size 50 10

  !!mBoltElements.formTitle     = 'Multi Bolt Elements'
  !!mBoltElements.iconTitle     = 'Multi Bolt Elements'
  !!mBoltElements.callback      = ''
  !!mBoltElements.formRevision  = ' $Revision: 1.0 $ '

  -- Body of form definition
   frame .mbol 'Multi Bolt Elements' at xmin+1         ymin+0.5
      para    .nameTag      at xmin+1         ymin+1    text 'Name            '     width 14
      text    .name         at xmax+1         ymin                                  width 25 is STRING
      option  .mode         at xmax+1         ymin                                  width  6
      para    .sbrTag       at xmin.nameTag   ymax+0.5  text 'Single Bolt Name'     width 14
      text    .sbltr        at xmax+1         ymin                                  width 25 is STRING
      button  .include      'Include'   anchor L+B    at xmin+2.75  ymax+.25
      button  .replace      'Replace'   anchor L+B    at xmax+0.25  ymin
      option  .sBoltArrayIncludeOption      at xmin.mode            ymin.sbltr            width  6
      list    .singleBoltRefList  'Single bolt array'    at xmin.nameTag  ymax+0.55 width 47 height 6

      -- Create/Apply
      path down
      vdist 0.5

      button .create    ' Create '   anchor L+B    at xmin.nameTag
      button .modify    ' Apply  '   anchor L+B    at xmin.nameTag  ymin

      -- Cancel
      button .cancel    'Dismiss'    anchor R+B    at xmax form - size   ymin

   exit

   -- Error frame
   frame .errorFrame 'Error ' at xmin.mbol ymin.mbol
      para .errorTag                          at xmin+1               ymin+1        width 50 lines 2
      button .error     'Done'       at xmax.errorTag-size   ymax+0.5
   exit

   -- Pop-up Menu
   --menu.removeMenu popup
   --!this.removeMenu.add('CALLBACK' , 'Remove from the list' ,'!this.remove()')

   --!this.singleBoltRefList.setpopup(!this.removeMenu)

   -- Set mode whether to create or modify
   member .setMode is STRING

   -- Storing values of sbrarray  string Fmt.
   member .sbltDText is ARRAY
   member .sbltRText is ARRAY

     -- Store current element
   member .currentElement is DBREF

exit
-- End of form definition for !!mBoltElements
------------------------------------------------------------------------
--
-- Method:      mBoltElements
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .mBoltElements()

    -- Initialise option gadgets

    !modeDText[1]                 = 'Create'
    !modeDText[2]                 = 'Modify'
    !modeRText[1]                 = 'CREATE'
    !modeRText[2]                 = 'MODIFY'

    !this.mode.dText              = !modeDText
    !this.mode.rText              = !modeRText
    !this.mode.callback           = '!this.changeMode()'

    !this.mbol.visible = true
    !this.errorFrame.visible = false

    !sBoltArrayIncludeOptionDText[1]              = 'CE'
    !sBoltArrayIncludeOptionDText[2]              = 'Pick from List'
    !this.sBoltArrayIncludeOption.dText           = !sBoltArrayIncludeOptionDText

    !sBoltArrayIncludeOptionRText[1]              = 'CE'
    !sBoltArrayIncludeOptionRText[2]              = 'LIST'
    !this.sBoltArrayIncludeOption.rText           = !sBoltArrayIncludeOptionRText

    !this.sBoltArrayIncludeOption.callback        = '!this.loadsbr()'

    --Assign pixmap

    --for Create
    --!this.createIcon.addPixmap(!!pml.getPathName('create.png'))
    !this.create.callback         = '!this.apply(|CREATE|)'
    --!this.modifyIcon.addPixmap(!!pml.getPathName('accept.png'))
    !this.modify.callback         = '!this.apply(|MODIFY|)'
    !this.include.callback        = '!this.include()'
    !this.replace.callback        = '!this.replace()'
    --for cancel
    --!this.cancelIcon.addPixmap(!!pml.getPathName('discard.png'))
    !this.cancel.callback         = '!this.close()'

    -- Initialise values for gadgets

    --for DTab
    !this.name.val                = object STRING()
    !this.name.callback           = '!this.textValidation(!this.name,|NAME|)'

    !this.sbltr.val               = object STRING()
    !this.sbltr.callback          = '!this.textValidation(!this.sbltr,|DBREF|)'

    !this.error.callback          = '!this.initialise()'
    !this.changeMode()
    !this.currentElement          = !!ce

endmethod
-- End of method definition for .mBoltElements()
------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

    !this.currentElement = !!ce
    if(!this.setMode eq 'CREATE')then
      if(!this.currentElement.type inset('MBLI','MBOL'))then
        !this.mbol.visible       = true
        !this.errorFrame.visible = false
        --!this.createIcon.visible =  true
        --!this.modifyIcon.visible =  false
        !this.create.visible     =  true
        !this.modify.visible     =  false
        !this.replace.visible    =  false
        !this.name.val           =  object STRING()
        !this.sbltr.val          =  object STRING()
        !this.sbltDText.clear()
        !this.sbltRText.clear()
        !this.singleBoltRefList.dText     =  !this.sbltDText
        !this.singleBoltRefList.rText     =  !this.sbltRText
      else
        !this.mbol.visible = false
        !this.errorFrame.visible = true
        !this.errorTag.val       = 'MBOL can be created within an MBLI. Navigate to MBLI or below.'
      endif

    else

      if(!this.currentElement.type eq 'MBOL')then
        !this.mbol.visible       = true
        !this.errorFrame.visible = false
        --!this.createIcon.visible = false
        --!this.modifyIcon.visible = true
        !this.create.visible     = false
        !this.modify.visible     = true
        !this.replace.visible    = true
        !this.populateData()
      else
        !this.mbol.visible       = false
        !this.errorFrame.visible = true
        !this.errorTag.val       = 'Navigate to MBOL and do modify.'
      endif
    endif

endmethod
-- End of method definition for .initialise()
------------------------------------------------------------------------
--
-- Method:      changeMode
--
-- Description: callback of Changing  Mode between create and modify
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      GADGET      Gadget to be validated
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .changeMode()

  !this.setMode =  !this.mode.selection('RTEXT')
  !this.initialise()

endmethod
-- End of method definition for .changeMode()

 ------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  !this.hide()

endmethod
-- End of method definition for .close()

 ------------------------------------------------------------------------
--
-- Method:      textValidation
--
-- Description: Validate textbox values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      GADGET    Textbox to be validated
--    2    R      STRING    Data Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .textValidation(!textGadget is GADGET,!type is STRING)

  if(!type eq 'NAME')then
      if(!this.setMode eq 'MODIFY')then
         if(!textGadget.val.trim() neq !!ce.namn)then
           !name    = !!checkName(!textGadget.val,'new')
            if(!name.set().not())then
               !textGadget.val = object STRING()
            endif
         endif
      else
         !name    = !!checkName(!this.name.val,'new')
         if(!name.set().not())then
           !this.name.val = object STRING()
         endif
      endif

  elseif(!type eq 'STRING')then
      if(!textGadget.val.trim() eq '')then
        !textGadget.val = object STRING()
      else
        !textGadget.val = !textGadget.val.trim()
      endif

  elseif(!type eq 'DBREF')then

      if(!textGadget.val.trim() eq '' or !textGadget.val.unset())then
         !textGadget.val = object STRING()
      else
          if(!textGadget.val.trim().substring(1,1) neq '/')then
            !textGadget.val = '/' & !textGadget.val.trim()
          endif
          !gtype = !textGadget.val.trim().dbref().type
          handle ANY
             !!alert.error('Enter a valid Element')
             !textGadget.val = object STRING()
             return
          endhandle
          if(!gtype neq 'SBOL')then
             !!alert.error('Enter any SBOL name')
             !textGadget.val = object STRING()
          endif
      endif
  endif

endmethod
-- End of method definition for .textValidation()
------------------------------------------------------------------------
--
-- Method:      populateData
--
-- Description: Populate attributes of selected coco to gadgets.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .populateData()

  !this.name.val              = !this.currentElement.namn
  !name                       = !this.name.val
  if(!name.matchwild('*=*'))then
    !this.name.val            = object STRING()
  endif
  do !i indices !this.currentElement.sbrArray
    if(!this.currentElement.sbrArray[!i].unset())then
       break
    endif
    !this.sbltDText[!i]       = !this.currentElement.sbrArray[!i].flnn
    !this.sbltRText[!i]       = !this.currentElement.sbrArray[!i].flnm

  enddo
  !this.singleBoltRefList.dText        = !this.sbltDText
  !this.singleBoltRefList.rText        = !this.sbltRText

  if(!this.singleBoltRefList.dText.set())then
    !this.sbltr.val           = !this.singleBoltRefList.selection('RTEXT')
    !this.replace.visible     = true
    !this.singleBoltRefList.callback   = '!this.sbltr.val = !this.singleBoltRefList.selection(|RTEXT|)'
  else
    !this.sbltr.val           = object STRING()
    !this.replace.visible     = false
    !this.singleBoltRefList.callback   = ''
  endif

endmethod
-- End of method definition for .populateData()
------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: apply
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   1      R     STRING     Action to be taken whether to create or Modify
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply(!action is STRING)

  !name    = !this.name.val
  if(!action eq 'CREATE') then
    $!this.currentElement
    NEW MBOL
    !this.currentElement     = !!ce
  endif

  if(!name.set())then
    !this.currentElement.name = '/' & !name
  endif

  if(!this.singleBoltRefList.dText.set())then
    do !i indices !this.singleBoltRefList.dText
      !this.currentElement.sbrArray[!i] = !this.singleBoltRefList.rText[!i].dbref()
    enddo
  endif

endmethod
-- End of method definition for .apply()
------------------------------------------------------------------------
--
-- Method:      include
--
-- Description: include
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .include()

  if(!this.sbltr.val.set())then
      !this.sbltRText.append(!this.sbltr.val)
    if(!this.sbltr.val.trim().substring(1,1) eq '/' )then
      !this.sbltDText.append(!this.sbltr.val.after('/'))
    else
      !this.sbltDText.append(!this.sbltr.val)
    endif
    !this.sbltDText.unique()
    !this.sbltRText.unique()
    !this.singleBoltRefList.dText  = object ARRAY()
    !this.singleBoltRefList.dText  = !this.sbltDText
    !this.singleBoltRefList.rText  = !this.sbltRText
  endif

endmethod
-- End of method definition for .include()
------------------------------------------------------------------------
--
-- Method:      replace
--
-- Description: replace
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .replace()

  if(!this.sbltr.val.set())then
    !indx                        = !this.singleBoltRefList.val
    if(!this.sbltr.val.trim().substring(1,1) eq '/' )then
      !this.sbltDText[!indx]     = !this.sbltr.val.after('/')
    else
      !this.sbltDText[!indx]     = !this.sbltr.val
    endif
    !this.sbltRText[!indx]       = !this.sbltr.val
    !this.sbltDText.unique()
    !this.sbltRText.unique()
    !this.singleBoltRefList.dText         = object ARRAY()
    !this.singleBoltRefList.rText         = object ARRAY()
    !this.singleBoltRefList.dText         = !this.sbltDText.unique()
    !this.singleBoltRefList.rText         = !this.sbltRText.unique()
  endif

endmethod
-- End of method definition for .replace()
------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: remove from list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remove()

  if(!this.sbltr.val.set())then
    !indx                        = !this.singleBoltRefList.val
    if(!indx le 0)then
      return
    endif
    !this.sbltDText[!indx].delete()
    !this.sbltRText[!indx].delete()
    !this.sbltDText.compress().unique()
    !this.sbltRText.compress().unique()
    !this.singleBoltRefList.dText         = object ARRAY()
    !this.singleBoltRefList.rText         = object ARRAY()
    !this.singleBoltRefList.dText         = !this.sbltDText
    !this.singleBoltRefList.rText         = !this.sbltRText
  endif

endmethod
-- End of method definition for .remove()
------------------------------------------------------------------------
--
-- Method:      loadsbr
--
-- Description: replace
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadsbr()
  if(!this.sBoltArrayIncludeOption.selection() eq 'CE')then
    if(!!ce.type eq 'SBOL')then
      !this.sbltr.val = !!ce.flnm
    else
      !!alert.error('The element type is not a valid one.Enter name of an SBOL')
    endif
  else
    pml load form !!refElemList
    !!refElemList.elementType = 'SBOL'
    !!refElemList.refElemList()
    show !!refElemList
  endif

endmethod
-- End of method definition for .loadsbr()
