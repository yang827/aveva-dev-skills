--
--  File:            paragondeleteconfirm.pmlfrm
--    Type:          Form Definition
--    Group:         CATA
--      Keyword:     CATA
--    Module:        Paragon
--  Author:          M.Barlow
--  Created:         Tue Mar 24 14:44:51 2009
--
-- Description    Form to confirm delete in Paragon
--                Works with paragon delete manager object CATDELETE
--                in CATDELETE global singleton !!catDeleteManager
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  action()                         -                   Action triggered when form closes Calls !!catDeleteManager
--  caption(STRING)                  -                   Set question for user
--  close()                          -                   close form
--  confirm(BOOLEAN)                 -                   Callback for YES & NO buttons. Calls !!catDeleteManager
--  initialise()                     -                   initialise
--  paragonDeleteConfirm()           -                   Constructor
------------------------------------------------------------------------

setup form !!paragonDeleteConfirm  blocking

  -- Default answer
  member .default      is STRING
  -- true if user pressed YES button. false for NO
  member .yesOrNo      is BOOLEAN
  -- Has user switched off delete confirmation
  member .askAgain     is BOOLEAN

  para   .icon pixmap
  para   .question     at xmax.icon+3 ymin+0.5 text ' ' width 22 lines 3
  toggle .togAskAgain  at x2 ymax |Don't ask me again to confirm this action| tagwidth 26
  -- OK and Cancel are not working in blocking forms
  button .yes          at x0 ymax+0.2      'Yes' width 7
  button .no           at xmax form-size   'No'  width 7

exit
-- End of form definition for !!paragonDeleteConfirm
------------------------------------------------------------------------
--
-- Method:      paragonDeleteConfirm()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
--
define method .paragonDeleteConfirm()

-- form setup
   !this.formTitle               = 'Confirm'
   !this.iconTitle               = 'Confirm'
   !this.cancelCall              = '!this.action()'
   !this.callback                = '!this.initialise()'
   !this.icon.addPixmap(!!pml.getPathname('qm35.png'))

   !this.yes.callback            = '!this.confirm(true)'
   !this.no.callback             = '!this.confirm(false)'
   !this.default                 = 'YES'

endmethod
-- End of method definition for .alertOnceConfirm()
------------------------------------------------------------------------
--
-- Method:      initialise()
--
-- Description: initialise
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  !this.attribute(!this.default).setFocus()

    -- It is the calling codes responsibility to remember whether the
    -- user wants confirmation to be displayed
  !this.togAskAgain.val = false
  !this.askAgain        = true
  !this.yesOrNo         = false

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:     caption
--
-- Description: Set question for user
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Question for user
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .caption( !caption is STRING)

  !this.question.val = !caption

endmethod
-- End of method definition for showAgain()

------------------------------------------------------------------------
--
-- Method:     confirm
--
-- Description: Callback for YES & NO buttons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [BOOLEAN]   [YES=true or NO=false]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .confirm(!yesOrNo is BOOLEAN)

  !this.yesOrNo  = !yesOrNo
  !this.askAgain = !this.togAskAgain.val.not()
  -- actioned by close form callback
  !this.close()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:     action
--
-- Description: Action triggered when form closes. Calls !!catDeleteManager
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .action()

  !!catDeleteManager.confirmDelete(!this.yesOrNo, !this.askAgain)

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:     close
--
-- Description: close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

!this.hide()

endmethod
-- End of method definition
