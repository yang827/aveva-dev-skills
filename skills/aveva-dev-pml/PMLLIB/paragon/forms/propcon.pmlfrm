-- Created:         Tue Feb 27 11:46:15 BST 2007
--
-- Description:
-- Attribute edit
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  attribArgs(STRING)               STRING              Create argument string for attribute gadget callbacks
--  attribList(DBREF,GADGET,GADGET)  -                   Callback for part attribute list
--  attribValue(DBREF,GADGET,GADGET) -                   Set new value of attribute
--  init()                           -
--  newElement(GADGET,STRING)        -                   Create new component or material data element
--  propCon()                        -                   Constructor
--  showAttributes(DBREF,GADGET,GADGET) -                   Show attributes panel
--  showCmpd()                       -                   Show component data panel
--  showCmpd(GADGET,STRING)          -                   Use a component data element from the selection or recent list
--  showMatl()                       -                   Show material data panel
--  showMatl(GADGET,STRING)          -                   Use a material data element from the selection or recent list
--  updateCmpdRecent()               -                   Update recent component data list
--  updateMatlRecent()               -                   Update recent material data list
--
------------------------------------------------------------------------
setup form !!propCon dialog docking noalign

  !this.formTitle     = 'Properties'
  !this.iconTitle     = 'Properties'
  !this.callback      = '!this.initialise()'
  !this.formRevision  = ' $Revision: 1.00 $ '

  -- Component world panel
  frame .cmpwFrame panel anchor all at x0 y0

    -- Component world element panel
    frame .cmpdFrame |Component Data| anchor all height 23

      -- Component world element parents, siblings and offspring
      option .cmpdFamily anchor top+left+right width 24
      button .cmpdCE |CE| anchor top+right at xmax+1 ymin

      -- Recently used component world elements
      option .cmpdRecent |Recent| anchor top+right at xmax+1 ymin tagwidth 6 width 24

      -- Currently displayed component world element
      para .cmpdNameTag at xmin.cmpdFamily ymax+0.2 width 6 lines 1
      para .cmpdName at xmax ymin width 28 lines 1

      -- Create new component world element
      option .cmpdNew |New| anchor top+right at xmax.cmpdRecent-size ymin width 6

      -- Component world element attributes
      frame .cmpdAttribFrame panel anchor top+left+right at xmin.cmpdFamily ymax.cmpdNew
        list .cmpdAttribList |Attributes|  anchor left+right at xmin.cmpdFrame width 64.4 height 24
        text .cmpdAttribValue |Value| tagWidth 12 anchor left+right at xmin.cmpdAttribList ymax.cmpdAttribList+0.5 width 53 string
      exit

    exit

    -- Material panel link
    button .material linklabel |Material Data| anchor left+bottom at xmin ymax+0.5 width 12

    -- Padding
    para .cmpdPadding anchor left+bottom at xmax+1 ymax-0.5 width 32 lines 1

  exit

  -- Material world panel
  frame .matwFrame panel anchor all at x0 y0

    -- Material world element panel
    frame .matlFrame |Material Data| anchor all height 23

      -- Material world element parents, siblings and offspring
      option .matlFamily anchor top+left+right width 24
      button .matlCE |CE| anchor top+right at xmax+1 ymin

      -- Recently used material world elements
      option .matlRecent |Recent| anchor top+right at xmax+1 ymin tagwidth 6 width 24

      -- Currently displayed material world element
      para .matlNameTag at xmin.cmpdFamily ymax+0.2 width 6 lines 1
      para .matlName at xmax ymin width 28 lines 1

      -- Create new material world element
      option .matlNew |New| anchor top+right at xmax.matlRecent-size ymin width 6

      -- Material world element attributes
      frame .matlAttribFrame panel anchor all at xmin.matlFamily ymax.matlNew
        list .matlAttribList |Attributes| anchor all at xmin.matlFrame width 64.4 height 24
        text .matlAttribValue |Value| tagwidth 12 anchor left+right+bottom at xmin.matlAttribList ymax.matlAttribList+0.5 width 53 string
     exit

    exit

    -- Component panel link
    button .components linklabel |Component Data| anchor left+bottom at xmin ymax+0.5 width 12

    -- Padding
    para .matlPadding anchor left+bottom at xmax+1 ymax-0.5 width 32 lines 1

  exit

  -- Element being worked on
  member .element         is DBREF

exit
-- End of form definition for !!propCon

------------------------------------------------------------------------
--
-- Method:      .propCon()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .propCon()

  -- Form callbacks
  !this.callback                 = |!!propCon.init()|

  -- Component world selection callbacks
  !this.cmpdFamily.callback      = |!!propCon.showCmpd(|
  !this.cmpdCE.callback          = |!!propCon.showCmpd()|
  !this.cmpdRecent.callback      = |!!propCon.showCmpd(|
  !this.cmpdNew.callback         = |!!propCon.newElement(|

  -- Component data attribute panel callbacks
  !this.cmpdAttribList.callback  = |!!propCon.attribList(|     & !this.attribArgs(|cmpd|) & |)|
  !this.cmpdAttribValue.callback = |!!propCon.attribValue(|    & !this.attribArgs(|cmpd|) & |)|

  -- Material world selection callbacks
  !this.matlFamily.callback      = |!!propCon.showMatl(|
  !this.matlCE.callback          = |!!propCon.showMatl()|
  !this.matlRecent.callback      = |!!propCon.showMatl(|
  !this.matlNew.callback         = |!!propCon.newElement(|

  -- Material data attribute panel callbacks
  !this.matlAttribList.callback  = |!!propCon.attribList(|     & !this.attribArgs(|matl|) & |)|
  !this.matlAttribValue.callback = |!!propCon.attribValue(|    & !this.attribArgs(|matl|) & |)|

  !this.components.callback      = |!!propCon.showCmpd()|
  !this.material.callback        = |!!propCon.showMatl()|

  -- Attribute list headings
  !headings    = ARRAY()
  !headings[1] = |Attribute|
  !headings[2] = |Value|
  !this.cmpdAttribList.setHeadings(!headings)
  !this.matlAttribList.setHeadings(!headings)

endmethod
-- End of method definition for .propCon()

------------------------------------------------------------------------
--
-- Method:      attribArgs
--
-- Description: Create argument string for attribute gadget callbacks
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type that forms part of gadget names: part, prtele or prtwld
-- Return:
--   [Data Type] [Description]
--    STRING      Argument string to append to callback
--
------------------------------------------------------------------------

define method .attribArgs(!type is STRING) is STRING

  -- Formulate arguments string
  return |!this.element, | & |!this.| & !type & |AttribList, | & |!this.| & !type & |AttribValue|

endmethod
-- End of method definition for .attribArgs(STRING, STRING) is STRING

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: Initialisation for form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

  -- Show appropriate panel
  if (!!ce.type inset(|MATW|, |SOLI|, |FLUI|, |TDEN|, |SDEN|)) then
    !this.showMatl()
  else
    !this.showCmpd()
  endif

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      showCmpd
--
-- Description: Show component data panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showCmpd()

  -- Set panel visibilities
  !this.cmpwFrame.visible = true
  !this.matwFrame.visible = false

  -- Initialise
  !this.element = object DBREF()
  !this.cmpdNameTag.val = |CMPD|
  !this.cmpdName.val    = |None selected|
  !cmpds   = ARRAY()
  !members = ARRAY()
  !dtext   = ARRAY()
  !rtext   = ARRAY()
  !newOpts = ARRAY()

  -- Always include option to create new component world
  !newOpts.append(|CMPW|)

  -- Display component data
  if (!!ce.type inset(|CMPW|, |CMPT|, |CMPD|, |TUBD|, |CABD|)) then

    -- Get CE info
    !this.element = !!ce
    !this.cmpdNameTag.val = !!ce.type
    !this.cmpdName.val    = !!ce.namn

    -- Add CE to recent cmpd list and update it
    !!catRecentObjects.add(!!ce)
    !this.updateCmpdRecent()

    -- Add options to create new component data elements
    !newOpts.append(|CMPT|)
    if (!this.element.type ne |CMPW|) then
      !newOpts.append(|CMPD|)
      !newOpts.append(|TUBD|)
      !newOpts.append(|CABD|)
    endif

    -- Get owners
    if (!this.element.type ne |CMPW|) then
      !owner = !this.element.owner
      do
        !cmpds.append(!owner)
        !owner = !owner.owner
        break if (not !owner.type inset(|CMPT|, |CMPW|, |CABD|))
      enddo
      !cmpds.invert()
    endif

    -- Get siblings
    do !member values !this.element.owner.members
      if (!member.type inset(|CMPW|, |CMPT|, |CMPD|, |TUBD|, |CABD|)) then
        !cmpds.append(!member)
      endif
    enddo

    -- Get members
    do !member values !this.element.members
      if (!member.type inset(|CMPT|, |CMPD|, |TUBD|, |CABD|)) then
        !members.append(!member)
      endif
    enddo

    -- Insert members below CE in list
    !cePos = !cmpds.findFirst(!this.element)
    if (!members.empty().not()) then
      !cmpds.insertArray(!cePos + 1, !members)
    endif

    -- Set text arrays for option list
    !dtext = !cmpds.evaluate(object block(|!cmpds[!evalIndex].flnn|))
    !rtext = !cmpds.evaluate(object block(|!cmpds[!evalIndex].ref.string()|))

    -- Indent hierarchy
    !interval = |  |
    do !i indices !cmpds
      if (!cmpds[!i].type eq |CMPT|) then
        !dtext[!i] = !interval & !dtext[!i]
      elseif (!cmpds[!i].type inset(|CMPD|, |TUBD|, |CABD|)) then
        !dtext[!i] = !interval & !interval & !dtext[!i]
      endif
    enddo

  else

    -- At any other type not a material data element so collect all component worlds
    var !cmpws collect all cmpw
    !cmpds = !cmpws.evaluate(object block(|!cmpws[!evalIndex].dbref()|))
    !dtext.appendArray(!cmpds.evaluate(object block(|!cmpds[!evalIndex].flnn|)))
    !rtext.appendArray(!cmpds.evaluate(object block(|!cmpds[!evalIndex].ref.string()|)))

  endif

  -- Populate component data selection
  !this.cmpdFamily.dtext = !dtext
  !this.cmpdFamily.rtext = !rtext

  -- Select CE in list if available
  if (!dtext.empty().not()) then
    !this.cmpdFamily.select('Rtext', !!ce.ref.string())
    handle any
      !this.cmpdFamily.val = 1
    endhandle
  endif

  -- Initialise attributes panel
  !this.showAttributes(!this.element, !this.cmpdAttribList, !this.cmpdAttribValue)

  -- Initialise options for creating new elements
  !this.cmpdNew.dtext = !newOpts
  !this.cmpdNew.select(|Dtext|, !this.cmpdNameTag.val)
  handle any
    -- No action if not available
  endhandle

endmethod
-- End of method definition for .showCmpd()

------------------------------------------------------------------------
--
-- Method:      showMatl
--
-- Description: Show material data panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showMatl()

  !this.cmpwFrame.visible = false
  !this.matwFrame.visible = true

  -- Initialise
  !this.element = object DBREF()
  !this.matlNameTag.val = |SOLI|
  !this.matlName.val    = |None selected|
  !matls   = ARRAY()
  !members = ARRAY()
  !dtext   = ARRAY()
  !rtext   = ARRAY()
  !newOpts = ARRAY()

   -- Always include option to create new material world
  !newOpts.append(|MATW|)

  -- Display material data
  if (!!ce.type inset(|MATW|, |SOLI|, |FLUI|, |TDEN|, |SDEN|)) then

    -- Get CE info
    !this.element = !!ce
    !this.matlNameTag.val = !!ce.type
    !this.matlName.val    = !!ce.namn

    -- Add CE to recent cmpd list and update it
    !!catRecentObjects.add(!!ce)
    !this.updateMatlRecent()

    -- Add options to create new material data elements
    !newOpts.append(|SOLI|)
    !newOpts.append(|FLUI|)
    if (!this.element.type ne |MATW|) then
      !newOpts.append(|TDEN|)
    endif
    if (!this.element.type inset (|TDEN|, |SDEN|)) then
      !newOpts.append(|SDEN|)
    endif

    -- Get owners
    if (!this.element.type ne |MATW|) then
      !owner = !this.element.owner
      do
        !matls.append(!owner)
        !owner = !owner.owner
        break if (not !owner.type inset(|MATW|, |SOLI|, |FLUI|, |TDEN|))
      enddo
      !matls.invert()
    endif

    -- Get siblings
    do !member values !this.element.owner.members
      if (!member.type inset(|MATW|, |SOLI|, |FLUI|, |TDEN|, |SDEN|)) then
        !matls.append(!member)
      endif
    enddo

    -- Get members
    do !member values !this.element.members
      if (!member.type inset(|SOLI|, |FLUI|, |TDEN|, |SDEN|)) then
        !members.append(!member)
      endif
    enddo

    -- Insert members below CE in list
    !cePos = !matls.findFirst(!this.element)
    if (!members.empty().not()) then
      !matls.insertArray(!cePos + 1, !members)
    endif

    -- Set text arrays for option list
    !dtext = !matls.evaluate(object block(|!matls[!evalIndex].flnn|))
    !rtext = !matls.evaluate(object block(|!matls[!evalIndex].ref.string()|))

    -- Indent hierarchy
    !interval = |  |
    do !i indices !matls
      if (!matls[!i].type inset(|SOLI|, |FLUI|)) then
        !dtext[!i] = !interval & !dtext[!i]
      elseif (!matls[!i].type eq |TDEN|) then
        !dtext[!i] = !interval & !interval & !dtext[!i]
      elseif (!matls[!i].type eq |SDEN|) then
        !dtext[!i] = !interval & !interval & !interval & !dtext[!i]
      endif
    enddo

  else

    -- At any other type not a component data element so collect all material worlds
    var !matws collect all matw
    !matls = !matws.evaluate(object block(|!matws[!evalIndex].dbref()|))
    !dtext.appendArray(!matls.evaluate(object block(|!matls[!evalIndex].flnn|)))
    !rtext.appendArray(!matls.evaluate(object block(|!matls[!evalIndex].ref.string()|)))

  endif

  -- Populate material data selection
  !this.matlFamily.dtext = !dtext
  !this.matlFamily.rtext = !rtext

  -- Select CE in list if available
  if (!dtext.empty().not()) then
    !this.matlFamily.select('Rtext', !!ce.ref.string())
    handle any
      !this.matlFamily.val = 1
    endhandle
  endif

  -- Initialise attributes panel
  !this.showAttributes(!this.element, !this.matlAttribList, !this.matlAttribValue)

  -- Initialise options for creating new elements
  !this.matlNew.dtext = !newOpts
  !this.matlNew.select(|Dtext|, !this.matlNameTag.val)
  handle any
    -- No action if not available
  endhandle

endmethod
-- End of method definition for .showMatl()

------------------------------------------------------------------------
--
-- Method:      showCmpd
--
-- Description: Use a component data element from the selection or recent list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showCmpd(!gadget is GADGET, !action is STRING)

  -- Ignore hidden action
  if (!action eq |SELECT|) then

    -- Set form member to selected member and reinitialise
    !!ce = !gadget.selection().dbref()
    handle (2, 107)
      -- Undefined reference (deleted element)
      !!alert.error(|Recent element no longer available|)
      !this.updateCmpdRecent()
    endhandle
    !this.init()

  endif

endmethod
-- End of method definition for .showCmpd(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      showMatl
--
-- Description: Use a material data element from the selection or recent list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showMatl(!gadget is GADGET, !action is STRING)

  -- Ignore hidden action
  if (!action eq |SELECT|) then

    -- Set form member to parts member and reinitialise
    !!ce = !gadget.selection().dbref()
    handle (2, 107)
      -- Undefined reference (deleted element)
      !!alert.error(|Recent element no longer available|)
      !this.updateMatlRecent()
    endhandle
    !this.init()

  endif

endmethod
-- End of method definition for .showMatl(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      updateCmpdRecent
--
-- Description: Update recent component data list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateCmpdRecent()

  -- Update recent component data list
  !this.cmpdRecent.dtext = !!catRecentObjects.dtext(|CMPW CMPT CMPD TUBD CABD|)
  !this.cmpdRecent.rtext = !!catRecentObjects.rtext(|CMPW CMPT CMPD TUBD CABD|)

endmethod
-- End of method definition for .updateCmpdRecent()

------------------------------------------------------------------------
--
-- Method:      updateMatlRecent
--
-- Description: Update recent material data list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateMatlRecent()

  -- Update recent material data list
  !this.matlRecent.dtext = !!catRecentObjects.dtext(|MATW SOLI FLUI TDEN SDEN|)
  !this.matlRecent.rtext = !!catRecentObjects.rtext(|MATW SOLI FLUI TDEN SDEN|)

endmethod
-- End of method definition for .updateMatlRecent()

------------------------------------------------------------------------
--
-- Method:      newElement
--
-- Description: Create new component or material data element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .newElement(!gadget is GADGET, !action is STRING)

  -- Get form
  !form = !gadget.owner()

  -- Ignore hidden action
  if (!action eq |SELECT|) then

    -- Get type of element to be created
    if (!gadget eq !form.cmpdNew) then
      !type = !form.cmpdNew.selection()
    elseif (!gadget eq !form.matlNew) then
      !type = !form.matlNew.selection()
    endif

    -- Go to appropriate level for new element
    -- Core error handling covers creation at wrong level
    if (!type eq |CMPW|) then
      if (!!ce.type inset(|CMPT|, |CMPD|, |TUBD|, |CABD|)) then
        CMPW
      elseif (!!ce.type ne |WORL|) then
        if (!!ce.owner.type ne |WORL|) then
          WORLD
        endif
      endif
    elseif (!type eq |MATW|) then
      if (!!ce.type inset(|FLUI|, |SOLI|, |TDEN|, |SDEN|)) then
        MATW
      elseif (!!ce.type ne |WORL|) then
        if (!!ce.owner.type ne |WORL|) then
          WORLD
        endif
      endif
    endif

    -- Create new element at current list position
    NEW $!type

    -- Reinitialise form
    !this.init()

  endif

endmethod
-- End of method definition for .newPartElement(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      showAttributes
--
-- Description: Show attributes panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element being queried
--    2   R      GADGET      Attribute list gadget
--    3   R      GADGET      Attribute value gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showAttributes(!element is DBREF, !attList is GADGET, !attValue is GADGET)

  -- Set panel visibilities
  if (!this.cmpdFrame.visible) then
    !this.cmpdAttribFrame.visible    = true
  elseif (!this.matlFrame.visible) then
    !this.matlAttribFrame.visible    = true
  endif

  -- Store prior selection
  !selection = !attList.selection()

  -- Initialise
  !rtext = ARRAY()
  !rows  = ARRAY()
  !row   = ARRAY()
  !value = object STRING()
  !attValue.val = ||

  -- Repopulate attributes
  if (!element.badref().not()) then
    if (!element.set()) then
      !attributes = !element.attributes()
      do !attribute values !attributes
        !value.delete()
        !value = !element.attribute(!attribute)
        if (not !value.objectType() inset(|ARRAY|, |DBARRATT|)) then
          !row[1] = !attribute
          !row[2] = ||
          if (!value.objectType() eq |DBREF|) then
            if (!value.badref().not()) then
              if (!value.set()) then
               !row[2] = !value.flnn
              endif
            endif
          else
            if( !value.objectType() eq 'REAL' ) then
              !row[2] = !value.queryString()
            else
              !row[2] = !value.string()
            endif
          endif
          !rows.append(!row)
          !rtext.append(!attribute)
        endif
      enddo
    endif
  endif
  !attList.setRows(!rows)
  !attList.rtext = !rtext

  -- Reselect same attribute
  if (!rows.size() gt 0) then
    !attList.select(|Rtext|, !selection)
    handle any
      !attList.val = 1
    endhandle
    !this.attribList(!element, !attList, !attValue)
  else
    !attValue.val = ''
    !attValue.tag = 'No attributes'
    !attValue.active = false
  endif

endmethod
-- End of method definition for .showAttributes(DBREF, GADGET, GADGET)

------------------------------------------------------------------------
--
-- Method:      attribList
--
-- Description: Callback for part attribute list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element being queried
--    2   R      GADGET      Attribute list gadget
--    3   R      GADGET      Attribute value gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .attribList(!element is DBREF, !attList is GADGET, !attValue is GADGET)

  -- Set panel visibilities
  if (!this.cmpdFrame.visible) then
    !this.cmpdAttribFrame.visible    = true
  elseif (!this.matlFrame.visible) then
    !this.matlAttribFrame.visible    = true
  endif

  -- Get values for selected attribute
  !attribute = !attList.selection()
  !value = !element.attribute(!attribute)
  if (!value.objectType() eq |DBREF|) then
    if (!value.set()) then
     !valString = !value.flnn
    else
      !valString = ||
    endif
  else
    !valString = !value.string()
  endif

  -- Set gadget values
  !attValue.val = !valString
  !attValue.tag = !attribute

  -- Can't change type or owner
  !attValue.active = (not !attribute inset(|Type|, |Owner|))

endmethod
-- End of method definition for .attribList(DBREF, GADGET, GADGET)

------------------------------------------------------------------------
--
-- Method:      attribValue
--
-- Description: Set new value of attribute
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element being queried
--    2   R      GADGET      Attribute list gadget
--    3   R      GADGET      Attribute value gadget
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .attribValue(!element is DBREF, !attList is GADGET, !attValue is GADGET)

  -- Get gadget values
  !attributeName = !attList.selection()
  !attribute = !element.attribute(!attributeName)
  !attribType = !attribute.objectType()
  !value      = !attValue.val

  -- Validate value
  if (!attribType eq |STRING|) then
    if (!attributeName eq |Name|) then
      !newValue = !!checkName(!value, |NEW|)
      if (!newValue.unset()) then
        -- Error in name already reported
        return
      endif
    else
      !newValue = !value
    endif
  elseif (!attribType eq |BOOLEAN|) then
    if (!value.boolean()) then
      !newValue = true
    else
      !newValue = false
    endif
  elseif (!attribType eq |DBREF|) then
    !oldValue = !!checkName(!value, |OLD|)
    if (!oldValue.unset()) then
      -- Error in name already reported
      return
    endif
    !newValue = !oldValue.dbref()
  elseif (!attribType eq |REAL|) then
    !newValue = !value.real()
  endif

  -- Set attribute and reinitialise attributes panel
  !element.attribute(!attributeName) = !newValue
  !this.showAttributes(!element, !attList, !attValue)

endmethod
-- End of method definition for .attribValue(DBREF, GADGET, GADGET)
