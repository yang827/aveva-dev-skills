--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  populateValue()                  -
--  refElemList()                    -                   Constructor
--

setup form !!refElemList  size 22 5

  !!refElemList.formTitle     = 'DTAB List'
  !!refElemList.iconTitle     = 'DTAB List'
  !!refElemList.formRevision  = ' $Revision: 1.0 $ '

  list .elementList  'Element List for Reference'      at xmin       ymin          width 22 height 5

   --Element Type to be listed
  member .elementType is STRING
exit
-- End of form definition for !!refElemList
------------------------------------------------------------------------
--
-- Method:      refElemList
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refElemList()

    !collection = object COLLECTION()
    !expression = object EXPRESSION('type eq |$!this.elementType|')

    !!refElemList.formTitle     = '$!this.elementType' & ' ' &  'List'
    !!refElemList.iconTitle     = '$!this.elementType' & ' ' &  'List'

    !collection.scope(BLTA)
    handle (2,111)
       return
    endhandle
    !collection.filter(!expression)
    !elements    = !collection.results()

    !this.elementList.dText = !elements.evaluate(object BLOCK('!elements[!evalIndex].flnn'))
    !this.elementList.rText = !elements.evaluate(object BLOCK('!elements[!evalIndex].flnm'))
    !this.elementList.callback  = '!this.populateValue()'

endmethod
-- End of method definition for .refElemList()
------------------------------------------------------------------------
--
-- Method:      populateValue
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .populateValue()

    if(!this.elementType eq 'DTAB')then
      !!sBoltElements.nstdblen.val = !this.elementList.selection(|RTEXT|)
    else
      !!mBoltElements.sbltr.val    = !this.elementList.selection(|RTEXT|)
    endif
    !this.hide()

endmethod
-- End of method definition for .populateValue()
