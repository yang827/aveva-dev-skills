------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(STRING)                    -                   apply
--  changeMode()                     -                   callback of Changing  Mode between create and modify
--  close()                          -                   close the form
--  deleteItem()                     -                   callback of deleting the selected line from the lists.
--  include(STRING)                  -                   include
--  initialise()                     -                   Initialisation method
--  loadnstdblen()                   -                   replace
--  populateData()                   -                   Populate attributes of selected coco to gadgets.
--  remove(GADGET,ARRAY)             -                   remove from list
--  replace(STRING)                  -                   replace
--  sBoltElements()                  -                   Constructor
--  setListVal(GADGET,STRING)        -                   callback of setting lists to be same val.
--  textValidation(GADGET,STRING)    -                   Validate textbox values
--

setup form !!sBoltElements  size 50 12

  !!sBoltElements.formTitle     = 'Single Bolt Elements'
  !!sBoltElements.iconTitle     = 'Single Bolt Elements'
  !!sBoltElements.initcall      = '!this.initialise()'
  !!sBoltElements.formRevision  = ' $Revision: 1.0 $ '

  -- Body of form definition
  frame .sbol 'Single Bolt Elements' at xmin+1         ymin+0.25
      para    .nameTag          at xmin+1         ymin+1    text 'Name                '     width  14
      text    .name             at xmax+1         ymin                                      width 24 is STRING
      option  .mode             at xmax+1         ymin                                      width  6
      para    .bDiaTag          at xmin.nameTag   ymax+0.5  text 'Bolt Diameter       '     width 14
      text    .bDia             at xmax+1         ymin                                      width 8 is STRING
      para    .lenTag           at xmax+2         ymin      text ' Bolt Length        '     width 14
      text    .length           at xmax+1         ymin                                      width 8 is REAL
      para    .noffTag          at xmin.nameTag   ymax+0.5  text 'No.off Bolts        '     width 14
      text    .noff             at xmax+1         ymin                                      width 8 is REAL
      para    .xtraLenTag       at xmax+2         ymin      text ' Extra Length       '     width 14
      text    .xtraLen          at xmax+1         ymin                                      width 8 is REAL
      para    .nstdblenTag      at xmin.nameTag   ymax+0.5  text 'Non Std. Bolt Length'     width 14
      text    .nstdblen         at xmax+1         ymin                                      width 24 is STRING
      option  .dtabIncludeMode     at xmax+1         ymin                                      width  6

      frame .displayList    'Bolt Items and Bolt Item lengths '   at x 1                ymax+.5     width 45
        para    .bItemsTag        at x 1               ymax+0.5  text 'Bolt Item'     width 8
        text    .bItems           at xmax              ymin                            width 8 is STRING
        button  .includebItem     'Insert '            at xmin   ymax+0.5
      button  .replacebItem     'Replace '           at xmax+2  ymin
        button  .deletebItem      'Delete '            at xmax+2 ymin
        para    .bItLenTag        at xmax.bItems+3     ymin.bItems  text 'Bolt Item Length'     width 11
      text    .bItLen           at xmax+1         ymin                            width 8 is REAL
--      button  .includebItLen    'Include '           at xmax+2 ymin
--      button  .replacebItLen    'Replace '           at xmax+2 ymin
        list .bItemList     'Bolt Items'                          at x1             ymax.includebItem+.25    width 21 height 5
        list .bItemLenList  'Bolt Items Lengths'                  at xmax+2             ymin         width 21 height 5
      exit

        -- Create/Apply
      --para .createIcon                        anchor L+B    at xmin.nameTag      ymax+1                pixmap width 10 height 5
      --para .modifyIcon                        anchor L+B    at xmin.nameTag      ymin.createIcon       pixmap width 10 height 5
      path down
      vdist 2

      button .create   ' Create '   anchor L+B    at xmin.nameTag
      button .modify   ' Apply  '   anchor L+B    at xmin.nameTag   ymin

       -- Cancel
      button .cancel    'Dismiss'    anchor R+B    at xmax form - size   ymin
      --para .cancelIcon                        anchor R+B    at xmin.cancel-3      ymin.cancel          pixmap width 10 height 5
  exit

  -- Error frame
  frame .errorFrame  'Error ' at xmin.sbol ymin.sbol
    para .errorTag                          at xmin+1               ymin+1        width 50  lines 2
    button .error    'Done'       at xmax.errorTag-size   ymax+0.5
  exit

  -- Set mode whether to create or modify
  member .setMode is STRING

  -- Store current element
  member .currentElement is DBREF

  -- Storing values of BItem  in string Fmt.
  member .bItemString is ARRAY

  -- Storing values of BItemlen  in string Fmt.
  member .bItemlenString is ARRAY

 --menu.removeBItem popup
 --!this.removeBItem.add('CALLBACK' , 'Remove from the list' ,'!this.remove(!this.bItemList,!this.bItemString)')

 --menu.removeBItlen popup
 --!this.removeBItlen.add('CALLBACK' , 'Remove from the list' ,'!this.remove(!this.bItemLenList,!this.bItemlenString)')

 --!this.bItemList.setpopup(!this.removeBItem)
 --!this.bItemLenList.setpopup(!this.removeBItlen)

exit
-- End of form definition for !!sBoltElements
------------------------------------------------------------------------
--
-- Method:      sBoltElements
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sBoltElements()

    -- Initialise option gadgets

    !modedtext[1]                 = 'Create'
    !modedtext[2]                 = 'Modify'
    !modeRText[1]                 = 'CREATE'
    !modeRText[2]                 = 'MODIFY'

    !this.mode.dtext              = !modedtext
    !this.mode.rText              = !modeRText
    !this.mode.callback           = '!this.changeMode()'

    !this.sbol.visible = true
    !this.errorFrame.visible = false

    !dtabIncludeModedtext[1]         = 'CE'
    !dtabIncludeModedtext[2]         = 'Pick from List'
    !dtabIncludeModeRText[1]         = 'CE'
    !dtabIncludeModeRText[2]         = 'LIST'
    !this.dtabIncludeMode.dtext      = !dtabIncludeModedtext
    !this.dtabIncludeMode.rText      = !dtabIncludeModeRText
    !this.dtabIncludeMode.callback   = ''
    !this.dtabIncludeMode.dtext      = !dtabIncludeModedtext
    !this.dtabIncludeMode.rText      = !dtabIncludeModeRText

    --Assign pixmap

    --for create
    --!this.createIcon.addPixmap(!!pml.getPathName('create.png'))
    !this.create.callback         = '!this.apply(|CREATE|)'
    --!this.modifyIcon.addPixmap(!!pml.getPathName('accept.png'))
    !this.modify.callback         = '!this.apply(|MODIFY|)'

    --for cancel
    --!this.cancelIcon.addPixmap(!!pml.getPathName('discard.png'))
    !this.cancel.callback         = '!this.close()'

    -- Initialise values for gadgets

    !this.name.val                   =  'Unset'
    !this.name.callback              = '!this.textValidation(!this.name,|NAME|)'

    !this.bDia.val                   = object STRING()
    !this.bDia.callback              = '!this.textValidation(!this.bDia,|STRING|)'

    !this.length.val                 = 0
    !this.length.callback            = '!this.textValidation(!this.length,|REAL|)'

    !this.noff.val                   = 0
    !this.noff.callback              = '!this.textValidation(!this.noff,|REAL|)'

    !this.xtraLen.val                = 0
    !this.xtraLen.callback           = '!this.textValidation(!this.xtraLen,|REAL|)'

    !this.bItems.val                 = object STRING()
    !this.bItems.callback            = '!this.textValidation(!this.bItems,|STRING|)'

    !this.bItLen.val                 = object REAL()
    !this.bItLen.callback            = '!this.textValidation(!this.bItLen,|REAL|)'

    !this.nstdblen.val               = object STRING()
    !this.nstdblen.callback          = '!this.textValidation(!this.nstdblen,|DBREF|)'
    !this.dtabIncludeMode.callback   = '!this.loadnstdblen()'

    !this.bItemList.callback         = |!this.setListVal(|
    !this.bItemLenList.callback      = |!this.setListVal(|

    !this.deletebItem.callback       = |!this.deleteItem()|

    !this.includebItem.callback      = '!this.include(|BITEM|)'
--    !this.includebItLen.callback     = '!this.include(|BITLEN|)'

    !this.replacebItem.callback      = '!this.replace(|BITEM|)'
--    !this.replacebItLen.callback     = '!this.replace(|BITLEN|)'

    !this.error.callback             = '!this.initialise()'
    !this.changeMode()
    !this.currentElement             = !!ce

endmethod
-- End of method definition for .sBoltElements()
------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

    !this.currentElement              = !!ce
    if(!this.setMode eq 'CREATE')then
      if(!this.currentElement.type inset('BLIS','SBOL'))then
         !this.sbol.visible           = true
         !this.errorFrame.visible     = false
         --!this.createIcon.visible     =  true
         --!this.modifyIcon.visible     =  false
         !this.create.visible         =  true
         !this.modify.visible         =  false
--         !this.replacebItem.visible   =  false
--         !this.replacebItLen.visible  =  false
         !this.name.val               =  'Unset'
         !this.bDia.val               =  object STRING()
         !this.length.val             =  0
         !this.xtraLen.val            =  0
         !this.noff.val               =  0
         !this.bItems.val             =  object STRING()
         !this.bItLen.val             =  0
         !this.nstdblen.val           =  object STRING()
         !this.bItemList.dtext        =  object ARRAY()
         !this.bItemLenList.dtext     =  object ARRAY()
         !this.bItemString            =  object ARRAY()
         !this.bItemlenString         =  object ARRAY()
         !!boltTableUtility.continue  =  TRUE
      else
--        !this.sbol.visible            = false
--        !this.errorFrame.visible      = true
          if (not !!boltTableUtility.continue) then
                  !!alert.error('SBOL can be created within an BLIS. Navigate to BLIS or below.')
          endif
--        !this.errorTag.val            = 'SBOL can be created within an BLIS. Navigate to BLIS or below.'
      endif
    else
      if(!this.currentElement.type eq 'SBOL')then
        !this.sbol.visible            = true
        !this.errorFrame.visible      = false
        --!this.createIcon.visible      = false
        --!this.modifyIcon.visible      = true
        !this.create.visible          = false
        !this.modify.visible          = true
--        !this.replacebItem.visible    = true
--        !this.replacebItLen.visible   = true
        !this.populateData()
      else
--        !this.sbol.visible            = false
--        !this.errorFrame.visible      = true
          !!alert.error('Navigate to SBOL and try again.')
          !this.mode.val = 1
--        !this.errorTag.val            = 'Navigate to SBOL and do modify.'
      endif
    endif

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      changeMode
--
-- Description: callback of Changing  Mode between create and modify
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .changeMode()

    !this.setMode                  =  !this.mode.selection('RTEXT')
    !this.initialise()

endmethod
-- End of method definition for .changeMode()

 ------------------------------------------------------------------------
--
-- Method:      setListVal
--
-- Description: callback of setting lists to be same val.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setListVal(!gadget is GADGET, !action is STRING)

   if (!action eq 'UNSELECT') then
       return
   endif
  if (!gadget.name() EQ 'BITEMLIST') then
      !this.bItemLenList.val = !this.bItemList.val
      !val = !this.bItemList.val
  else
      !this.bItemList.val = !this.bItemLenList.val
      !val = !this.bItemLenList.val
  endif

  if (!this.mode.val eq 2) then
      !this.bItems.val = !this.bItemList.dtext[!val]
      !this.bItLen.val = !this.bItemLenList.dtext[!val].real()
  endif

endmethod
-- End of method definition for .setListVal()

------------------------------------------------------------------------
--
-- Method:      deleteItem
--
-- Description: callback of deleting the selected line from the lists.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteItem()

-- Grab the lists and removed the selected item.

    !val = !this.bItemList.val
    if (!val eq 0) then
        return
    endif

    !items = !this.bItemList.dtext
    !lengs = !this.bItemLenList.dtext
    !items.removeFrom(!val,1)
    !lengs.removeFrom(!val,1)
    !this.bItemString.removeFrom(!val,1)
    !this.bItemlenString.removeFrom(!val,1)

-- Re-instate the lists with one deleted.
    !this.bItemList.dtext    = !items
    !this.bItemLenList.dtext = !lengs

-- Select the next value to the one deleted.
    !this.bItemList.val      = !val - 1
    handle any
    elsehandle none
    !this.bItemLenList.val   = !val - 1
    endhandle


endmethod
-- End of method definition for .setListVal()
 ------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: close the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  !this.hide()

endmethod
-- End of method definition for .close()

 ------------------------------------------------------------------------
--
-- Method:      textValidation
--
-- Description: Validate textbox values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      GADGET    Textbox to be validated
--    2    R      STRING    Data Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .textValidation(!gadget is GADGET,!type is STRING)

  if(!type eq 'NAME')then
      !this.name.val = !this.name.val.replace(' ','_')
      if(!this.setMode eq 'MODIFY')then
         if(!gadget.val.trim() neq !!ce.namn)then
           !name    = !!checkName(!gadget.val,'new')
            if(!name.set().not())then
               !gadget.val = !!ce.namn
            endif
         endif
      else
         !name    = !!checkName(!this.name.val,'new')
         if(!name.set().not())then
               !this.name.val  =  'Unset'
         endif
      endif
  endif
  if(!type eq 'STRING')then
      if(!gadget.val.trim() eq '')then
        !gadget.val = object STRING()
      else
        !gadget.val = !gadget.val.trim()
      endif
      if (!gadget.name() eq 'BITEMS') then
          !gadget.val = !gadget.val.substring(1,4).upcase()
          handle (61,618) (2,754)
          endhandle
      endif
  endif
  if(!type eq 'REAL')then
      if(!gadget.val.unset())then
        !gadget.val = 0
      else
        !gadget.val = !gadget.val
      endif
  endif
  if(!type eq 'DBREF')then

      if(!gadget.val.trim() eq '' or !gadget.val.unset())then
         !gadget.val = object STRING()
      else
          if(!gadget.val.trim().substring(1,1) neq '/')then
            !gadget.val = '/' & !gadget.val.trim()
          endif
          !gtype = !gadget.val.trim().dbref().type
          handle ANY
             !!alert.error('Enter a valid Element')
             !gadget.val = object STRING()
             return
          endhandle
          if(!gtype neq 'DTAB')then
             !!alert.error('Enter any DTAB name')
             !gadget.val = object STRING()
          endif
      endif
  endif

endmethod
-- End of method definition for .textValidation()
------------------------------------------------------------------------
--
-- Method:      populateData
--
-- Description: Populate attributes of selected coco to gadgets.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .populateData()

    !this.name.val                  = !this.currentElement.namn
    !name                           = !this.name.val
    if(!name.matchwild('*=*'))then
         !this.name.val               =  'Unset'
    endif
    !this.bDia.val                  = !this.currentElement.bDia
    if(!this.bDia.val.trim().occurs('(').gt(0))then
      !this.bDia.val                = !this.bDia.val.after('(').before(')').trim()
    endif

    if(!this.currentElement.length.set())then
      !this.length.val              = !this.currentElement.length
    else
      !this.length.val              = 0
    endif

    if(!this.currentElement.xtraLen.set())then
      !this.xtraLen.val             = !this.currentElement.xtraLen
    else
      !this.xtraLen.val             = 0
    endif

    if(!this.currentElement.noff.set())then
      !this.noff.val                = !this.currentElement.noff
    else
      !this.noff.val                = 0
    endif

    if(!this.currentElement.nstdb.set())then
      !this.nstdblen.val            = !this.currentElement.nstdb.flnm
    else
      !this.nstdblen.val            = object STRING()
    endif

    !this.bItemString               = object ARRAY()
    !this.bItemlenString            = object ARRAY()

    do !i indices !this.currentElement.bItems
      !this.bItemString[!i]         = !this.currentElement.bItems[!i]
    enddo

    do !i indices !this.currentElement.bItLen
      !this.bItemlenString[!i]      = !this.currentElement.bItLen[!i].string()
    enddo

    !this.bItemList.dtext           = object ARRAY()
    !this.bItemLenList.dtext        = object ARRAY()

    !this.bItemList.dtext           = !this.bItemString
    !this.bItemLenList.dtext        = !this.bItemlenString

    if(!this.bItemList.dtext.set())then
       !this.bItems.val             = !this.bItemList.selection('dtext')
--       !this.bItemList.callback     = '!this.bItems.val = !this.bItemList.selection(|dtext|)'
       !this.replacebItem.visible   = true
    else
       !this.bItems.val             = object STRING()
--       !this.bItemList.callback     = ''
       !this.replacebItem.visible   = false
    endif
    if(!this.bItemLenList.dtext.set())then
       !this.bItLen.val             = !this.bItemLenList.selection('dtext').real()
--       !this.bItemLenList.callback  = '!this.bItLen.val = !this.bItemLenList.selection(|dtext|).real()'
--       !this.replacebItLen.visible  = true
    else
       !this.bItLen.val             = 0
--       !this.bItemLenList.callback  = ''
--       !this.replacebItLen.visible  = false
    endif

endmethod
-- End of method definition for .populateData()
------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: apply
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   1      R     STRING     Action to be taken whether to create or Modify
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply(!action is STRING)

  !name           = !this.name.val
  !bDia           = !this.bDia.val
  !length         = !this.length.val
  !xtraLen        = !this.xtraLen.val
  !noff           = !this.noff.val
  if(!this.nstdblen.val.set()) then
    !nstdblenStr    = !this.nstdblen.val.trim()
    !nstdblen       = !nstdblenStr.dbref()
  endif

  if(!action eq 'CREATE') then
    NEW SBOL
    !this.currentElement     = !!ce
  endif

  if(!name.set())then
    !this.currentElement.name = '/' & !name
  endif

  if(!bDia.set())then
    !this.currentElement.bDia = !bDia
    handle any
    endhandle
  endif

  if(!length.set())then
    !this.currentElement.length =  !length
    handle any
    endhandle
  endif

  if(!xtraLen.set())then
    !this.currentElement.xtraLen = !xtraLen
    handle any
    endhandle
  endif

  if(!noff.set())then
    !this.currentElement.noff = !noff
    handle any
    endhandle
  endif

  if(defined(!nstdblen) and !nstdblen.set())then
    !this.currentElement.nstdblen = !nstdblen
    handle any
    endhandle
  endif

  do !i indices !this.bItemLenList.dtext
    !this.currentElement.bItLen[!i] = !this.bItemLenList.dtext[!i].real()
    handle any
    endhandle
  enddo

  do !i indices !this.bItemList.dtext
    !this.currentElement.bItems[!i] = !this.bItemList.dtext[!i]
    handle any
    endhandle
  enddo

endmethod
-- End of method definition for .apply()
------------------------------------------------------------------------
--
-- Method:      include
--
-- Description: include
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .include(!attribName is STRING)

    if(!this.bItems.val.set())then
      !indx                     = !this.bItemList.val + 1
      !this.bItemString.insert(!indx, !this.bItems.val.substring(1,4).upcase())
      !this.bItemlenString.insert(!indx, !this.bItLen.val.string())

      !this.bItemLenList.dtext  = object ARRAY()
      !this.bItemList.dtext     = object ARRAY()

      !this.bItemList.dtext     = !this.bItemString
      !this.bItemLenList.dtext  = !this.bItemlenString
      !this.bItemList.val       = !indx
      handle (61,620)
         !this.bItemList.val    = 1
         !this.bItemLenList.val = 1
      elsehandle none
         !this.bItemLenList.val = !indx
    endhandle
  endif

endmethod
-- End of method definition for .include()
------------------------------------------------------------------------
--
-- Method:      replace
--
-- Description: replace
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .replace(!attribName is STRING)

    if(!this.bItems.val.set())then
      !indx                        = !this.bItemList.val
      !this.bItemString[!indx]     = !this.bItems.val.substring(1,4).upcase()
    !this.bItemlenString[!indx]  = !this.bItLen.val.string()

    !this.bItemLenList.dtext     = object ARRAY()
      !this.bItemList.dtext        = object ARRAY()

      !this.bItemList.dtext        = !this.bItemString
      !this.bItemLenList.dtext     = !this.bItemlenString
      !this.bItemList.val          = !indx
      handle (61,620)
         !this.bItemList.val       = 1
         !this.bItemLenList.val    = 1
      elsehandle none
         !this.bItemLenList.val    = !indx
    endhandle
  endif

endmethod
-- End of method definition for .replace()
------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: remove from list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .remove(!listGadget is GADGET,!memberGadget is ARRAY)

    !indx                        = !listGadget.val
    if(!indx le 0)then
      return
    endif
    !memberGadget[!indx].delete()
    !memberGadget.compress().unique()
    !listGadget.dtext         = object ARRAY()
    !listGadget.rText         = object ARRAY()
    !listGadget.dtext         = !memberGadget
    !listGadget.rText         = !memberGadget

endmethod
-- End of method definition for .remove()
------------------------------------------------------------------------
--
-- Method:      loadnstdblen
--
-- Description: replace
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .loadnstdblen()
  if(!this.dtabIncludeMode.selection() eq 'CE')then
    if(!!ce.type eq 'DTAB')then
      !this.nstdblen.val = !!ce.flnm
    else
      !!alert.error('The element type is not a valid one. Enter name of a DTAB')
    endif
  else
    pml load form !!refElemList
    !!refElemList.elementType  = 'DTAB'
    !!refElemList.refElemList()
    show !!refElemList
  endif

endmethod
-- End of method definition for .loadnstdblen()
