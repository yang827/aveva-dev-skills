--   Module:        PARAGON
--   Replaces:
--
-- Author:          venkatramanan.iyer
-- Created:
--
--
-- Description:
-- Form for creating Single Bolt List
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(STRING)                    -                   apply
--  changeMode()                     -                   callback of Changing  Mode between create and modify
--  close()                          -                   hides the form
--  initialise()                     -                   Initialisation method
--  populateData()                   -                   Populate attributes of selected coco to gadgets.
--  sBoltList()                      -                   Constructor
--  textValidation()                 -                   Validate textbox values
--
setup form !!sBoltList  size 35 1

  !this.formTitle     = 'Single Bolt List'
  !this.iconTitle     = 'Single Bolt List'
  !this.callback      = ''
  !this.formRevision  = ' $Revision: 1.0 $ '

  -- Body of form definition
  frame .blis 'Single Bolt List' at xmin+1         ymin+0.5
      para    .nameTag      at xmin+1         ymin+1    text 'Name      '                   width 6
      text    .name         at xmax+1         ymin                                          width 20 is STRING
      option  .mode         at xmax+1         ymin                                          width 6

      -- Create/Apply
      path down
      vdist 1
      button .create   ' Create '   anchor L+B    at xmin.nameTag
      button .modify   ' Apply  '   anchor L+B    at xmin.nameTag     ymin

      -- Cancel
      button .cancel   'Dismiss'    anchor R+B    at xmax form - size   ymin
  exit

  -- Error frame
  frame .errorFrame  'Error ' at xmin.blis ymin.blis
    para .errorTag                          at xmin+1               ymin+1        width 40 lines 2
    button .error     'Done'       at xmax.errorTag-size   ymax+0.5
  exit

  -- Set mode whether to create or modify
  member .setMode is STRING


  -- Store current element
  member .currentElement is DBREF

exit

-- End of form definition for !!sBoltList
------------------------------------------------------------------------
--
-- Method:      sBoltList
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sBoltList()

    -- Initialise option gadgets

    !modeDText[1]                 = 'Create'
    !modeDText[2]                 = 'Modify'
    !modeRText[1]                 = 'CREATE'
    !modeRText[2]                 = 'MODIFY'
    !this.mode.dText              = !modeDText
    !this.mode.rText              = !modeRText
    !this.mode.callback           = '!this.changeMode()'

    !this.blis.visible = true
    !this.errorFrame.visible = false

    --Assign pixmap

    --for create
    !this.create.callback     = '!this.apply(|CREATE|)'
    !this.modify.callback     = '!this.apply(|MODIFY|)'

    --for cancel
    !this.cancel.callback = '!this.close()'

    -- Initialise values for gadgets

    --for BLis
    !this.name.val            =  'Unset'
    !this.name.callback       = '!this.textValidation()'
    !this.error.callback      = '!this.initialise()'

    !this.changeMode()
    !this.currentElement      = !!ce

endmethod
-- End of method definition for .sBoltList()
------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Initialisation method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

    !this.currentElement = !!ce
    if(!this.setMode eq 'CREATE')then

      if(!this.currentElement.type inset('BLTA','LTAB','DTAB','BLIS','SBOL','MBLI','MBOL'))then
          !this.blis.visible       = true
          !this.errorFrame.visible = false
          !this.create.visible     =  true
          !this.modify.visible     =  false
          !this.name.val           =  'Unset'
      else
        !this.blis.visible         = false
        !this.errorFrame.visible   = true
        !this.errorTag.val = 'BLIS can be created within an BLTA. Navigate to BLTA or below.'
      endif

    else

      if(!this.currentElement.type eq 'BLIS')then
        !this.blis.visible       = true
        !this.errorFrame.visible = false
        !this.create.visible     =  false
        !this.modify.visible     =  true
        !this.populateData()
      elseif(!this.currentElement.type eq 'SBOL')then
        !!ce = !!ce.owner
        !this.currentElement     = !!ce
        !this.blis.visible       = true
        !this.errorFrame.visible = false
        !this.create.visible     =  false
        !this.modify.visible     =  true
        !this.populateData()
      else
        !this.blis.visible       = false
        !this.errorFrame.visible = true
        !this.errorTag.val = 'Navigate to BLIS and do modify.'
      endif
    endif

endmethod
-- End of method definition for .initialise()
------------------------------------------------------------------------
--
-- Method:      changeMode
--
-- Description: callback of Changing  Mode between create and modify
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .changeMode()

    !this.setMode              =  !this.mode.selection('RTEXT')
    !this.initialise()

endmethod
-- End of method definition for .changeMode()

 ------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: hides the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close()

  !this.hide()

endmethod
-- End of method definition for .close()

 ------------------------------------------------------------------------
--
-- Method:      textValidation
--
-- Description: Validate textbox values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .textValidation()

  if(!this.setMode eq 'MODIFY')then
     if(!this.name.val.trim() neq !!ce.namn)then
       !name    = !!checkName(!this.name.val,'new')
        if(!name.set().not())then
           !this.name.val = 'Unset'
        endif
     endif
  else
     !name    = !!checkName(!this.name.val,'new')
     if(!name.set().not())then
       !this.name.val = 'Unset'
     endif
  endif

endmethod
-- End of method definition for .textValidation()
------------------------------------------------------------------------
--
-- Method:      populateData
--
-- Description: Populate attributes of selected coco to gadgets.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .populateData()

    !this.name.val              = !this.currentElement.namn
    !name                       = !this.name.val
    if(!name.matchwild('*=*'))then
      !this.name.val           =  'Unset'
    endif

endmethod
-- End of method definition for .populateData()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: apply
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   1      R     STRING     Action to be taken whether to create or Modify
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .apply(!action is STRING)

  !name    = !this.name.val
  if(!action eq 'CREATE') then
    NEW BLIS
    !this.currentElement      = !!ce
  endif

  if(!name.set())then
    !this.currentElement.name = '/' & !name
  endif

endmethod
-- End of method definition for .apply()
