--
--  Description:     Selection of paint and definition of coating information
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addCoating()                     -                   Add chosen data into the defined coatings list
--  displayCoatingData(ARRAY)        -
--  generateCoatingList()            -
--  generatePaintList()              -
--  initialise()                     -
--  moveDown()                       -
--  moveToBottom()                   -
--  moveToTop()                      -
--  moveUp()                         -
--  paintPopupHandler(ARRAY)         -
--  paintSelectionHandler(ARRAY)     -
--  removeAll()                      -                   Remove selected entry
--  removeEntry()                    -
--  selCoatingPopupHandler(ARRAY)    -
--  setSurfTreatLabel(STRING)        -
--  sftDefineCoatings()              -
--  updateThickness()                -
--
------------------------------------------------------------------------

import 'GridControl'
handle (1000,0)
endhandle

-- Specify the namespace so we can refer to the .NET stuff
using namespace 'Aveva.Pdms.Presentation'
	
------------------------------------------------------------------------
-- Form:      sftDefineCoatings
------------------------------------------------------------------------

--setup form !!sftDefineCoatings dialog  size 55 12
--setup form !!sftDefineCoatings dialog
setup form !!sftDefineCoatings dialog docking size 57 28

-- Define titles and initialisation call
  !this.formTitle = 'Coating Definition'
  !this.iconTitle = 'Coating Definition'
  !this.initcall  = '!this.initialise()'

  hdist 1
  halign centre
  path right
  vdist 0.5

  para .parSelSurfTreat at xmin form + 5 ymin form + 0.3  TEXT ' ' width 35

  frame .frmPaintList  'Available PAINT elements' at xmin form   ymax + 0.3  width 55 height 12
    container .conPaintGrid PMLNetCONTROL 'NET'   at xmin + 0.2  ymin + 0.5 dock fill
  exit

  path down
-- Definition of thickness for new coating
  frame .frmAddCoating  'Add new Coating' at xmin form + 10   ymax + 0.5  width 35 height 2
--    text .txtSelectedPaint tagwidth 10 'Selected Paint' at xmin + 1 ymin + 0.6  width 20 is STRING
    text .txtThickness     tagwidth 8 'Thickness'        width 8 is REAL
    button .btnAdd        '  ADD '     at xmax.txtThickness + 1  ymin.txtThickness call |!this.addCoating()|
    button .btnUpdate     'UPDATE'  at xmax.btnAdd + 1        ymin.txtThickness call |!this.updateThickness()|
  exit

-- Listing of all defined coatings for the current SRFTRT element
  frame .frmSelCoatingList  'Selected Coatings (first to last)' at xmin form   ymax + 0.5  width 55 height 10
    container .conSelCoatingGrid PMLNetCONTROL 'NET'   at xmin        ymin + 0.5 dock fill
  exit

-- Right click menu for managing defined coatings
  menu .mnuOrdering popup
    !this.mnuOrdering.add( 'CALLBACK', 'Move to first place','!this.moveToTop()' )
    !this.mnuOrdering.add( 'CALLBACK', 'Move up one place','!this.moveUp()' )
    !this.mnuOrdering.add( 'CALLBACK', 'Move down one place','!this.moveDown()')
    !this.mnuOrdering.add( 'CALLBACK', 'Move to last place','!this.moveToBottom()')
    !this.mnuOrdering.add( 'SEPARATOR' )
    !this.mnuOrdering.add( 'CALLBACK', 'Remove selected COATING','!this.removeEntry()')
    !this.mnuOrdering.add( 'CALLBACK', 'Remove all COATINGs','!this.removeAll()')

-- End of FORM definition

-- Define member variables
   member .ngcPaintList      is  NETGRIDCONTROL
   member .ngcSelCoatingList is  NETGRIDCONTROL

   member .paintHeadings     is  ARRAY
   member .coatingHeadings   is  ARRAY

   member .selectedSurfTreat is  DBREF
   member .selectedPaint     is  DBREF
   member .debug             is  BOOLEAN
   member .selSurfaceTreat   is  SFTGETTING
exit

------------------------------------------------------------------------
--
-- Method:      sftDefineCoatings
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sftDefineCoatings()

-- Control of additional debugging messages during processing
  !this.debug = FALSE
  if (defined(!!debug) ) then
    !this.debug = TRUE
  endif

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

-- add .Net control to PML container for list of ALL COATINGS
  !this.ngcPaintList = object NETGRIDCONTROL()
  !this.conPaintGrid.control = !this.ngcPaintList.handle()

-- add PML event handlers to .Net control
  !this.ngcPaintList.addeventhandler('AfterSelectChange', !this, 'PaintSelectionHandler')
  !this.ngcPaintList.addeventhandler('OnPopup', !this, 'PaintPopupHandler')

--  !this.conPaintGrid.popup = !this.mnuSelecting

-- add .Net control to PML container for selected COATINGS
  !this.ngcSelCoatingList = object NETGRIDCONTROL()
  !this.conSelCoatingGrid.control = !this.ngcSelCoatingList.handle()

-- add PML event handlers to .Net control
  !this.ngcSelCoatingList.addeventhandler('OnPopup', !this, 'SelCoatingPopupHandler')
  !this.ngcSelCoatingList.addeventhandler('AfterSelectChange', !this, 'DisplayCoatingData')
  !this.conSelCoatingGrid.popup = !this.mnuOrdering

-- set icons
--  !this.btnAddCoating.addPixmap(!!pml.getPathName('downarrow16.png'))
--  !this.btnRemCoating.addPixmap(!!pml.getPathName('uparrow16.png'))

endmethod
-- End of method definition for .sftDefineCoatings()

------------------------------------------------------------------------
--
-- Method:      Initialise()
--
-- Description: Initialise the form each time it is displayed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  if (!this.debug) then
    WRITE |Running sftDefineCoatings.initialise()|
  endif

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

-- Setup the display grid headings
  !this.paintHeadings[1] = 'NAME'
  !this.paintHeadings[2] = 'DESCRIPTION'
  !this.paintHeadings[3] = 'MAKER'

  !this.coatingHeadings[1] = 'DESCRIPTION'
  !this.coatingHeadings[2] = 'MAKER'
  !this.coatingHeadings[3] = 'THICKNESS'
  !this.coatingHeadings[4] = 'NAME'

  !t = true
  !f = false

-- Basic settings for PAINT grid
  !this.ngcPaintList.columnExcelFilter(!t)
  !this.ngcPaintList.outlookGroupStyle(!f)
  !this.ngcPaintList.fixedHeaders(!f)
  !this.ngcPaintList.fixedRows(!f)
  !this.ngcPaintList.editableGrid(!f)
  !this.ngcPaintList.singlerowselection(!f)
  !this.ngcPaintList.setalternaterowcolor('lightgray')

-- Basic settings for SELECTED COATING grid
  !this.ngcSelCoatingList.columnExcelFilter(!f)
  !this.ngcSelCoatingList.outlookGroupStyle(!f)
  !this.ngcSelCoatingList.fixedHeaders(!f)
  !this.ngcSelCoatingList.fixedRows(!f)
  !this.ngcSelCoatingList.editableGrid(!f)
  !this.ngcSelCoatingList.singlerowselection(!f)
  !this.ngcSelCoatingList.setalternaterowcolor('lightgray')
  !this.ngcSelCoatingList.headerSort(!f)

  !this.generatePaintList()
  !this.generateCoatingList()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      PaintPopupHandler()
--
-- Description: Handle selection from Popup menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .paintPopupHandler(!data is ARRAY)


-- Check that some rows are selected before showing the menu
  if (!data[2].set() ) then
    !this.conPaintGrid.showPopup(!data[0], !data[1])
  endif

endmethod
-- End of method definition for .paintPopupHandler()

------------------------------------------------------------------------
--
-- Method:      PaintSelectionHandler()
--
-- Description: Handle selection from Popup menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .paintSelectionHandler(!data is ARRAY)

  if (!data.set() ) then
-- !data[0][1] will hold the row tag for the selected entry (e.g. <STRING> '=15353/365')
    !rowtag = !data[0][1]
--  !this.txtSelectedPaint.val = !rowtag.dbref().desc
    !this.selectedPaint = !rowtag.dbref()
  endif

endmethod
-- End of method definition for .paintSelectionHandler()

------------------------------------------------------------------------
--
-- Method:      SelCoatingPopupHandler()
--
-- Description: Handle selection from Popup menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selCoatingPopupHandler(!data is ARRAY)


-- Check that some rows are selected before showing the menu
  if (!data[2].set() ) then
    !this.conSelCoatingGrid.showPopup(!data[0], !data[1])
  endif

endmethod
-- End of method definition for .selCoatingPopupHandler()

------------------------------------------------------------------------
--
-- Method:      MoveUp()
--
-- Description: Move selected entry higher in the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .moveUp()

  !selected = !this.ngcSelCoatingList.getSelectedRowTags()[1].real()

  !safeCE = !!ce

  if (!selected.eq(1) ) then
    !!alert.error('Cannot move up from first position')
    return
  endif

-- Move to the selected SRFTRT element
  $!this.selectedSurfTreat

  !newpos = !selected - 1
  REO $!selected BEF $!newpos
  !!ce = !safeCE

  !this.generateCoatingList()

endmethod
-- End of method definition for .moveUp()

------------------------------------------------------------------------
--
-- Method:      MoveDown()
--
-- Description: Move selected entry lower in the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .moveDown()

  !selected = !this.ngcSelCoatingList.getSelectedRowTags()[1].real()
  !maxmem = !this.selectedSurfTreat.members.size()
  !safeCE = !!ce

  if (!selected.eq(!maxmem) ) then
    !!alert.error('Cannot move down from last position')
    return
  endif

-- Move to the selected SRFTRT element
  $!this.selectedSurfTreat

  !newpos = !selected + 1
  REO $!selected AFT $!newpos
  !!ce = !safeCE

  !this.generateCoatingList()

endmethod
-- End of method definition for .moveDown()

------------------------------------------------------------------------
--
-- Method:      MoveToTop()
--
-- Description: Move selected entry lower in the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .moveToTop()

  !selected = !this.ngcSelCoatingList.getSelectedRowTags()[1].real()
  !safeCE = !!ce

  if (!selected.eq(1) ) then
    !!alert.error('Element is already at first position')
    return
  endif

-- Move to the selected SRFTRT element
  $!this.selectedSurfTreat

  REO $!selected BEF 1
  !!ce = !safeCE

  !this.generateCoatingList()

endmethod
-- End of method definition for .moveToTop()

------------------------------------------------------------------------
--
-- Method:      MoveToBottom()
--
-- Description: Move selected entry lower in the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .moveToBottom()

  !selected = !this.ngcSelCoatingList.getSelectedRowTags()[1].real()
  !maxmem = !this.selectedSurfTreat.members.size()
  !safeCE = !!ce

  if (!selected.eq(!maxmem) ) then
    !!alert.error('Element is already at last position')
    return
  endif

-- Move to the selected SRFTRT element
  $!this.selectedSurfTreat

  REO $!selected AFT $!maxmem
  !!ce = !safeCE

  !this.generateCoatingList()

endmethod
-- End of method definition for .moveToBottom()

------------------------------------------------------------------------
--
-- Method:      RemoveEntry()
--
-- Description: Remove selected entry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeEntry()

  if ( !!alert.confirm('Delete selected COATING - Are you sure?').eq('YES') ) then
    !safeCE = !!ce
    do !selected values !this.ngcSelCoatingList.getSelectedRows()
        -- delete element
        !dbref = !selected[4].dbref()
        $!dbref
        delete COATING
    enddo
    !!ce = !safeCE
    handle (2,822)
-- Cannot set current element to an unset reference
-- (i.e. item has been deleted)
    endhandle

    --!this.generateCoatingList()
    !this.ngcSelCoatingList.deleteSelectedRows()
  endif

endmethod
-- End of method definition for .removeEntry()

------------------------------------------------------------------------
--
-- Method:      removeAll()
--
-- Description: Remove selected entry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeAll()

  if ( !!alert.confirm('Delete ALL COATINGs - Are you sure?').eq('YES') ) then

    !safeCE = !!ce

-- Move to the selected SRFTRT element
    $!this.selectedSurfTreat

    delete SRFTRT MEM

    !!ce = !safeCE
    handle (2,822)
-- Cannot set current element to an unset reference
-- (i.e. item has been deleted)
    endhandle

    !this.generateCoatingList()
  endif

endmethod
-- End of method definition for .removeAll()

------------------------------------------------------------------------
--
-- Method:      AddCoating()
--
-- Description: Add chosen data into the defined coatings list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addCoating()

    if (!this.txtThickness.val.unset() ) then
      !!alert.error('No value specified for thickness')
      return
    endif

    if (NOT !this.ngcPaintList.getSelectedRows().set()) then
      !!alert.error('Not selected PAINT on Grid Control')
      return FALSE
    endif

-- Create new hierarchy element
    !safeCE = !!ce
    do !rowtag values !this.ngcPaintList.getSelectedRowTags()
       -- New method on Grid Control : GetRow(STRING)
       !selected = !this.ngcPaintList.getRow( !rowtag )

       $!this.selectedSurfTreat
       TAIL
       NEW COATIN
       PAIREF $!selected[1]
       CTHICK ( $!this.txtThickness.val / 1000)
    enddo
    !!ce = !safeCE
-- Update the displayed grid data
    !this.generateCoatingList()

endmethod
-- End of method definition for .addCoating()

------------------------------------------------------------------------
--
-- Method:      SetSurfTreatLabel()
--
-- Description: Set the para gadget to the provided text (e.g. "BRAN /B-100-FA-1/B1")
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setSurfTreatLabel(!value is STRING)

  !this.parSelSurfTreat.val = 'Surface Treatment: ' + !value
  !this.selectedSurfTreat = !value.dbref()

endmethod
-- End of method definition for .setSurfTreatLabel()

------------------------------------------------------------------------
--
-- Method:      GeneratePaintList()
--
-- Description: Show example data to demonstrate form controls
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .generatePaintList()

  if (!this.debug) then
    WRITE |Running sftDefineCoatings.generatePaintList()|
  endif

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

  if (NOT !this.selSurfaceTreat.getPaintPoint()) then
      return
  endif

  !allpaints = !this.selSurfaceTreat.getAllPaintCode()

-- Bind example data to grid
  !nds = object NETDATASOURCE('Paints', !this.paintHeadings, !allpaints)
  !this.ngcPaintList.bindToDataSource(!nds)

endmethod
-- End of method definition for .generatePaintList()

------------------------------------------------------------------------
--
-- Method:      GenerateCoatingList()
--
-- Description: Show example data to demonstrate form controls
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .generateCoatingList()

  if (!this.debug) then
    WRITE |Running sftDefineCoatings.generateCoatingList()|
  endif

-- setup controls for PML containers
  using namespace 'Aveva.Pdms.Presentation'

-- Currently restricted to single CATE or SECT - needs to handle multiples!

  !allcoatings = !this.selectedSurfTreat.members

  handle any
-- Temporary handle in case COATING element not in this version of PDMS
    !!alert.error(!!error.text)
    return
  endhandle

  !allentries = object ARRAY()
  if (!allcoatings.size().eq(0) ) then
    !!alert.warning('Selected element currently has no coatings defined')

  else
-- Generate data for rows
    do !item values !allcoatings
      !rowdata = object ARRAY()
      if (!item.pairef.set() ) then
        !rowdata[1] = !item.pairef.desc
        !rowdata[2] = !item.pairef.maker
      else
        !rowdata[1] = object STRING()
        !rowdata[2] = object STRING()
      endif
      !rowdata[3] = ( !item.cthick * 1000)
      !rowdata[4] = !item.name
      !allentries.append(!rowdata)
    enddo

  endif

-- Bind example data to grid
  !nds = object NETDATASOURCE('Selected Coatings', !this.coatingHeadings, !allentries)
  !this.ngcSelCoatingList.bindToDataSource(!nds)
  !this.ngcSelCoatingList.setColumnVisibility(4,FALSE)

endmethod
-- End of method definition for .generateCoatingList()

------------------------------------------------------------------------
--
-- Method:      UpdateThickness()
--
-- Description: Update thickness for COATING
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateThickness()
  if (!this.debug) then
    WRITE |Running sftDefineCoatings.updateThickness()|
  endif

  if (!this.txtThickness.val.unset() ) then
    !!alert.error('No value specified for thickness')
    return
  endif

  if (NOT !this.ngcSelCoatingList.getSelectedRows().set() ) then
    !!alert.error('Not selected COATING on Grid Control')
    return
  endif

  !safeCE = !!ce
  do !selected values !this.ngcSelCoatingList.getSelectedRows()
     -- update element
     !dbref = !selected[4].dbref()
     $!dbref
     CTHICK ( $!this.txtThickness.val / 1000)
  enddo
  !this.txtThickness.val = object REAL()
  !!ce = !safeCE

  !this.generateCoatingList()

endmethod
-- End of method definition for .ShowExampleData()

------------------------------------------------------------------------
--
-- Method:      DisplayCoatingData()
--
-- Description: Display coating thickness data o text box
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayCoatingData(!data is ARRAY)

  if (!data.size().neq(1) ) then
    WRITE |Incorrect array passed to DisplayCoatingData()|
    return
  endif

$(  q var !data
<ARRAY>
   [0]  <STRING> 'aaaaa'        (new value)
   [1]  <STRING> '=15353/363'   (row tag)
   [2]  <STRING> 'MAKER'        (column header)
   [3]  <BOOLEAN> TRUE          (control flag)

$)
   if (!data.unset()) then
   else
       !this.txtThickness.val = !this.ngcSelCoatingList.getSelectedRows()[1][3].real()
   endif

endmethod
-- End of method definition for .displayCoatingData()
