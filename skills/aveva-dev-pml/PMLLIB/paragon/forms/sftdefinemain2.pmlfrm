------------------------------------------------------------------------
--
-- Method:      UpdateCoatingList()
--
-- Description: Take user selection and populate the main form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateCoatingList(!data is ARRAY)

  if (!data.size().neq(1) ) then
    WRITE |Incorrect array passed to UpdateCoatingList()|
    return
  endif

-- !data[0][1] will be the ROWTAG for the selected row

  !chosen = !data[0]

  if (defined(!chosen[1]) ) then
    !this.selectedSurfTreat = !this.ngcSurfTreatList.getSelectedRows()[1][1].dbref()
    !this.generateCoatingList()
  endif

endmethod
-- End of method definition for .updateCoatingList()


------------------------------------------------------------------------
--
-- Method:      GenerateCoatingList()
--
-- Description: Update the data grid for coatings based on the selected SRFTRT
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .generateCoatingList()

  if (!this.debug) then
    WRITE |Running sftDefineMain2.generateCoatingList()|
  endif

-- setup controls for PML containers
  using namespace 'Aveva.pdms.presentation'

  !entry = !this.ngcSurfTreatList.getSelectedRows()[1]
  !element = !entry[1].dbref()

  !allEntries = object ARRAY()
  !allCoatings = !element.members

  -- Display thicknesses in microns or mil (thou)
  if (!!isImperialLength('DIST')) then
    !this.txtThickness.tag = 'Thickness (mil)'
    !this.coatingHeadings[3] = 'THICKNESS (MIL)'
    !!sftThicknessFmt.units = 'THOU'
  else
    !this.txtThickness.tag = 'Thickness (microns)'
    !this.coatingHeadings[3] = 'THICKNESS (MICRONS)'
    !!sftThicknessFmt.units = 'MICRONS'
  endif

-- Generate data for rows
    do !item values !allCoatings
      !rowData = object ARRAY()
      if (!item.pairef.set() ) then
        if (NOT BADREF(!item.pairef)) then
            !rowData[1] = !item.pairef.desc
            !rowData[2] = !item.pairef.maker
        else
            -- if paint ref is a bad ref, skip
            skip
        endif
      else
         -- if paint ref is null, skip
         skip
      endif

     !rowData[3] = !item.cthick.string(!!sftThicknessFmt)
     !rowData[4] = !item.name
     !allEntries.append(!rowData)
    enddo

-- Bind example data to grid
  !nds = object NETDATASOURCE('Selected Coatings', !this.coatingHeadings, !allEntries)
  !this.ngcSelCoatingList.bindToDataSource(!nds)
  !this.ngcSelCoatingList.setColumnVisibility(4,FALSE)

endmethod
-- End of method definition for .generateCoatingList()

------------------------------------------------------------------------
--
-- Method:      AddCoating()
--
-- Description: Add chosen data into the defined coatings list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addCoating()

    if (!this.txtThickness.val.unset() ) then
      !!alert.error('No value specified for thickness')
      return
    endif

    if (NOT !this.ngcSurfTreatList.getSelectedRows().set()) then
       !!alert.error('Not selected SRFTRT on Grid Control')
       return FALSE
    endif

    if (NOT !this.ngcPaintList.getSelectedRows().set()) then
      !!alert.error('Not selected PAINT on Grid Control')
      return FALSE
    endif

-- Create new hierarchy element
    !safeCE = !!ce
    do !rowTag values !this.ngcPaintList.getSelectedRowTags()
       -- New method on Grid Control : GetRow(STRING)
       !selected = !this.ngcPaintList.getRow( !rowTag )

       $!this.selectedSurfTreat
       TAIL
       NEW COATIN
       PAIREF $!selected[1]
       !!ce.cthick = !this.txtThickness.val
    enddo
    !!ce = !safeCE
-- Update the displayed grid data
    !this.generateCoatingList()

endmethod
-- End of method definition for .addCoating()

------------------------------------------------------------------------
--
-- Method:      Method:      UpdateThickness()
--
-- Description: Update thickness for COATING
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateThickness()
  if (!this.debug) then
    WRITE |Running sftDefineCoatings.updateThickness()|
  endif

  if (!this.txtThickness.val.unset() ) then
    !!alert.error('No value specified for thickness')
    return
  endif

  if (NOT !this.ngcSelCoatingList.getSelectedRows().set() ) then
    !!alert.error('Not selected COATING on Grid Control')
    return
  endif

  do !selected values !this.ngcSelCoatingList.getSelectedRows()
     -- update element
    !dbref = !selected[4].dbref()
    !dbref.cthick = !this.txtThickness.val

  enddo
  !this.txtThickness.val = object REAL()

  !this.generateCoatingList()
endmethod
-- End of method definition for .updateThickness()

------------------------------------------------------------------------
--
-- Method:      moveUp()
--
-- Description: Move selected entry higher in the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .moveUp()

  if (!this.debug) then
    WRITE |Running sftDefineMain.moveUp()|
  endif

  if (NOT !this.ngcSelCoatingList.getSelectedRows().set()) then
    !!alert.error('Not selected move COATING item in Grid Control')
    return FALSE
  else
    !selected = !this.ngcSelCoatingList.getSelectedRowTags()[1].real()
  endif

  if (NOT !this.ngcSurfTreatList.getSelectedRows().set()) then
    !!alert.error('Not selected SRFTRT item in Grid Control')
    return FALSE
  else
    !element = !this.ngcSurfTreatList.getSelectedRowTags()[1].dbref()
  endif

  !safeCE = !!ce

  if (!selected.eq(1) ) then
    !!alert.error('Cannot move up from first position')
    return
  endif

-- Move to the selected SRFTRT element
  $!element

  !newPosition = !selected - 1
  REORDER $!selected BEFORE $!newPosition
  !!ce = !safeCE

  !this.generateCoatingList()

endmethod
-- End of method definition for .moveUp()

------------------------------------------------------------------------
--
-- Method:      MoveDown()
--
-- Description: Move selected entry lower in the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .moveDown()

  if (!this.debug) then
    WRITE |Running sftDefineMain.moveDown()|
  endif

  if (NOT !this.ngcSelCoatingList.getSelectedRows().set()) then
    !!alert.error('Not selected move COATING item in Grid Control')
    return FALSE
  else
    !selected = !this.ngcSelCoatingList.getSelectedRowTags()[1].real()
  endif

  if (NOT !this.ngcSurfTreatList.getSelectedRows().set()) then
    !!alert.error('Not selected SRFTRT item in Grid Control')
    return FALSE
  else
    !element = !this.ngcSurfTreatList.getSelectedRowTags()[1].dbref()
  endif

  !maximumMembers = !element.members.size()
  !safeCE = !!ce

  if (!selected.eq(!maximumMembers) ) then
    !!alert.error('Cannot move down from last position')
    return
  endif

-- Move to the selected SRFTRT element
  $!element

  !newPosition = !selected + 1
  REORDER $!selected AFTER $!newPosition
  !!ce = !safeCE

  !this.generateCoatingList()

endmethod
-- End of method definition for .moveDown()


------------------------------------------------------------------------
--
-- Method:      MoveToTop()
--
-- Description: Move selected entry lower in the list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .moveToTop()

  if (!this.debug) then
    WRITE |Running sftDefineMain.moveToTop()|
  endif

  if (NOT !this.ngcSelCoatingList.getSelectedRows().set()) then
    !!alert.error('Not selected move COATING item in Grid Control')
    return FALSE
  else
    !selected = !this.ngcSelCoatingList.getSelectedRowTags()[1].real()
  endif

  if (NOT !this.ngcSurfTreatList.getSelectedRows().set()) then
    !!alert.error('Not selected SRFTRT item in Grid Control')
    return FALSE
  else
    !element = !this.ngcSurfTreatList.getSelectedRowTags()[1].dbref()
  endif

  !safeCE = !!ce

  if (!selected.eq(1) ) then
    !!alert.error('Element is already at first position')
    return
  endif

-- Move to the selected SRFTRT element
  $!element

  REORDER $!selected BEFORE 1
  !!ce = !safeCE

  !this.generateCoatingList()

endmethod
-- End of method definition for .moveToTop()


------------------------------------------------------------------------
--
-- Method:      MoveToBottom()
--
-- Description: Move selected entry lower in the list
--
