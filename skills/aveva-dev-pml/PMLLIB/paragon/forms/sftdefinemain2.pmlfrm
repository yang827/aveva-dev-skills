--
-- Author:          Ricky Thompson
-- Created:         <day> <date> <time> <year>
--
--
--  Description:     Alternate prototype of main Paragon form for Surface Treatment
--                   Used for management of PAINT, COATING and SRFTRT elements
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addCoating()                     -
--  afterPaintCellChanges(ARRAY)     -                   Check the changes made to editable cell and save if permitted
--  afterSurfaceCellChanges(ARRAY)   -                   Check the changes made to editable cell and save if permitted
--  applyCellChanges(ARRAY)          -                   Check the changes made to editable cell and save if permitted
--  checkHierarchy()                 BOOLEAN             Checks the hierarchy to make sure that there is a CATA with
--  chooseCoating()                  -
--  closeCallback()                  -                   Close CallBack Function
--  copyPaint()                      -                   Copy the selected PAINT entry to create a new entry
--  copySurfTreat()                  -                   Copy the selected SurfTreat entry to create a new entry
--  createHierarchy(STRING)          -                   Creates the surface treatment hierarchy.
--  createNewPaint()                 -                   Create a new PAINT entry and update the list
--  createNewSurfTreat()             -                   Create a new PAINT entry and update the list
--  deleteCoatingAll()               -
--  deleteCoatingEntry()             -
--  deletePaint()                    -                   Delete the selected PAINT entry
--  deleteSurfTreat()                -                   Delete the selected SurfTreat entry
--  displayCoatingData(ARRAY)        -
--  generateCoatingList()            -
--  generatePaintList()              -
--  generateSurfTreatList()          -
--  getCataPoint()                   -                   Getting Paint Catalogue point
--  initialise()                     -
--  moveDown()                       -
--  moveToBottom()                   -
--  moveToTop()                      -
--  moveUp()                         -                   Move selected entry higher in the list
--  paintPopupHandler(ARRAY)         -
--  selCoatingPopupHandler(ARRAY)    -
--  sftDefineMain2()                 -
--  surfTreatPopupHandler(ARRAY)     -
--  updateCoatingList(ARRAY)         -
--  updateThickness()                -
--
------------------------------------------------------------------------

import 'GridControl'
handle (1000,0)
endhandle

-- Specify the namespace so we can refer to the .NET stuff
using namespace 'Aveva.pdms.presentation'
	
------------------------------------------------------------------------
-- Form:      SurfaceTreatment
------------------------------------------------------------------------

setup form !!sftDefineMain2 dialog docking size 83 29

-- Define titles and initialisation call
  !this.formTitle = 'Surface Treatment definition'
  !this.iconTitle = 'Surface Treatment'
  !this.initcall  = '!this.initialise()'

  vdist 0.5
  hdist 2
  path down

  frame .fixheight panel at x0 y0 width 0 height 28
  exit

  frame .fixwidth  panel at x0 y0 width 110 height 0
  exit


-- SURFACE TREATMENT down the left side

  para .parSurfTreat                                       at xmin + 0.5 y 0.25 text 'Surface Treatments'
  container .conSurfTreatGrid nobox PMLNETCONTROL 'NET'                              anchor top+bottom+left                width 55 height 24
  path down

  frame .frmSurfTreat  ''                                  at ymax form - 3          anchor bottom+left              width 35 height 2
      button .btnAddSurfTreat      ' Create '              at  ymin + 0.7                                            width 10               callback '!this.createNewSurfTreat()'
      hdist 2.5
      path right
      button .btnCopySurfTreat     '  Copy  '                                                                        width 10               callback '!this.copySurfTreat()'
      hdist 2.5
      button .btnDeleteSurfTreat   ' Delete '                                                                        width 10               callback '!this.deleteSurfTreat()'
      hdist 2.5
      button .btnRefreshSurfTreat  ' Refresh'                                                                        width 10               callback '!this.generateSurfTreatList()'
      hdist 2.5
      path down
  exit

  LINE .lineV1                                             at xmax.frmSurfTreat + 1 ymin form anchor left+top+bottom VERT                   width 1  height 28.5

  para .parSelCoatings                                     at xmax.lineV1 + 1 y 0.25 text 'Selected Coatings'
  container .conSelCoatingGrid nobox PMLNETCONTROL 'NET'               anchor right+left+top                               width 60 height 8
  vdist 0.2
-- Sequencing buttons for controlling order of selected coatings
  frame .frmMove 'Move coating'
     button .btnOrderUp                                                                                      pixmap  width 16 height 16     callback '!this.moveUp()'
     hdist 0.5
     path right
     button .btnOrderTop                                                                                     pixmap  width 16 height 16     callback '!this.moveToTop()'
     button .btnOrderDn                                                                                      pixmap  width 16 height 16     callback '!this.moveDown()'
     button .btnOrderBtm                                                                                     pixmap  width 16 height 16     callback '!this.moveToBottom()'
  exit
  -- Definition of thickness for new coating
  frame .frmAddCoating  'Add/Update Coating'               at ymin.frmMove                                           width 35 height 2
     text .txtThickness    'Thickness'                     tagwidth 14                                               width 8 is REAL format !!sftThicknessFmt
     button .btnAddCoating '  Add '                        at xmax.txtThickness + 1  ymin.txtThickness                                      callback '!this.addCoating()'
     button .btnUpdate     'Update'                        at xmax.btnAddCoating + 1 ymin.txtThickness                                      callback '!this.updateThickness()'
  exit
  path down
  LINE .lineH1                                             at xmin.conSelCoatingGrid ymax.frmAddCoating + 0.1 anchor right+left+top HORIZ  width .conSelCoatingGrid height 1

--Available PAINTs at the BOTTOM RIGHT

  frame .tabset TABSET 'tabset'                            at xmax.lineV1 + 1 ymax.lineH1 + 0.1 anchor bottom+left+right+top

      frame .frmPaint  'Paint definition'                  at 0 0
          frame .frmPaintList 'List of PAINT elements'  at xmin.frmPaint +  0.1     anchor bottom+right+left+top   width 50 height 11.5
              container .conPaintGrid nobox PMLNetCONTROL 'NET'  at xmin + 1 ymin + 0.5   anchor bottom+right+left+top   width 54.5 height 11
          exit
          button .btnAddPaint      ' Create '     at xmin.frmPaintList + 2 ymax.frmPaintList+0.5 anchor bottom+left   width 10               callback '!this.createNewPaint()'
          path right
          hdist 2
          button .btnCopyPaint     '  Copy  '                                                    anchor bottom+left   width 10               callback '!this.copyPaint()'
          hdist 2
          button .btnDeletePaint   ' Delete '                                                    anchor bottom+left   width 10               callback '!this.deletePaint()'
          hdist 2
          button .btnRefreshPaint  ' Refresh'                                                    anchor bottom+left   width 10               callback '!this.generatePaintList()'
          hdist 2
          path down
    exit
  exit

-- Right click menu for managing paint
  menu .mnuPaintOptions popup
    !this.mnuPaintOptions.add( 'CALLBACK', 'Create','!this.createNewPaint()' )
    !this.mnuPaintOptions.add( 'CALLBACK', 'Copy','!this.copyPaint()' )
    !this.mnuPaintOptions.add( 'SEPARATOR' )
    !this.mnuPaintOptions.add( 'CALLBACK', 'Delete','!this.deletePaint()' )

-- Right click menu for managing paint

-- Right click menu for managing surface treatments
  menu .mnuSurfTreatOptions popup
    !this.mnuSurfTreatOptions.add( 'CALLBACK', 'Create','!this.createNewSurfTreat()' )
    !this.mnuSurfTreatOptions.add( 'CALLBACK', 'Copy','!this.copySurfTreat()' )
    !this.mnuSurfTreatOptions.add( 'SEPARATOR' )
    !this.mnuSurfTreatOptions.add( 'CALLBACK', 'Delete','!this.deleteSurfTreat()' )
--    !this.mnuSurfTreatOptions.add( 'SEPARATOR' )
--    !this.mnuSurfTreatOptions.add( 'CALLBACK', 'Manage coatings','!this.chooseCoating()' )

-- Right click menu for managing defined coatings
  menu .mnuOrdering popup
    !this.mnuOrdering.add( 'CALLBACK', 'Move to first place','!this.moveToTop()' )
    !this.mnuOrdering.add( 'CALLBACK', 'Move up one place','!this.moveUp()' )
    !this.mnuOrdering.add( 'CALLBACK', 'Move down one place','!this.moveDown()')
    !this.mnuOrdering.add( 'CALLBACK', 'Move to last place','!this.moveToBottom()')
    !this.mnuOrdering.add( 'SEPARATOR' )
    !this.mnuOrdering.add( 'CALLBACK', 'Remove selected Coating','!this.deleteCoatingEntry()')
    !this.mnuOrdering.add( 'CALLBACK', 'Remove all Coatings','!this.deleteCoatingAll()')

-- End of FORM definition

-- Define member variables
   member .ngcPaintList      is  NETGRIDCONTROL

   member .ngcSurfTreatList  is  NETGRIDCONTROL
   member .ngcSelCoatingList is  NETGRIDCONTROL

   member .paintHeadings     is  ARRAY
   member .cataPoint         is  ARRAY
   member .surfTreatHeadings is  ARRAY
   member .coatingHeadings   is  ARRAY

   member .selectedSurfTreat is  DBREF
   member .debug             is  BOOLEAN
   member .surfaceTreat      is  SFTGETTING

-- Stored the new name with '/'
   member .newName           is  STRING
   member .rowTag            is  STRING
   member .columnTag         is  STRING
   member .flag              is  REAL

exit
------------------------------------------------------------------------
--
-- Method:      sftDefineMain2
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sftDefineMain2()

-- Control of additional debugging messages during processing
  !this.debug = FALSE
  if (defined(!!debug) ) then
    !this.debug = TRUE
  endif

  !this.btnOrderTop.addPixmap(!!pml.getPathName('upuparrow16.png'))
  !this.btnOrderUp.addPixmap(!!pml.getPathName('uparrow16.png'))
  !this.btnOrderDn.addPixmap(!!pml.getPathName('downarrow16.png'))
  !this.btnOrderBtm.addPixmap(!!pml.getPathName('downdownarrow16.png'))

-- setup controls for PML containers
  using namespace 'Aveva.pdms.presentation'

-- add .Net control to PML container for PAINT
  !this.ngcPaintList = object NETGRIDCONTROL()
  !this.conPaintGrid.control = !this.ngcPaintList.handle()

-- add .Net control to PML container for SRFTRT
  !this.ngcSurfTreatList = object NETGRIDCONTROL()
  !this.conSurfTreatGrid.control = !this.ngcSurfTreatList.handle()

  !this.conPaintGrid.popup = !this.mnuPaintOptions

  !this.conSurfTreatGrid.popup = !this.mnuSurfTreatOptions

-- add .Net control to PML container for selected COATINGS
  !this.ngcSelCoatingList = object NETGRIDCONTROL()
  !this.conSelCoatingGrid.control = !this.ngcSelCoatingList.handle()

-- add PML event handlers to .Net control
  !this.ngcPaintList.addEventHandler('BeforeCellUpdate', !this, 'ApplyCellChanges')
  !this.ngcPaintList.addEventHandler('OnPopup', !this, 'PaintPopupHandler')
  !this.ngcPaintList.addEventHandler('AfterCellUpdate', !this, 'afterPaintCellChanges')

  !this.ngcSurfTreatList.addEventHandler('BeforeCellUpdate', !this, 'ApplyCellChanges')
  !this.ngcSurfTreatList.addEventHandler('AfterCellUpdate', !this, 'afterSurfaceCellChanges')
  !this.ngcSurfTreatList.addEventHandler('OnPopup', !this, 'SurfTreatPopupHandler')
  !this.ngcSurfTreatList.addEventHandler('AfterSelectChange', !this, 'UpdateCoatingList')

-- add PML event handlers to .Net control
--!this.ngcSelCoatingList.addEventHandler('BeforeCellUpdate', !this, 'ApplyCellChanges')
  !this.ngcSelCoatingList.addEventHandler('OnPopup', !this, 'SelCoatingPopupHandler')
  !this.ngcSelCoatingList.addEventHandler('AfterSelectChange', !this, 'DisplayCoatingData')

  !this.conSelCoatingGrid.popup = !this.mnuOrdering

  !this.cancelCall        = '!this.closeCallback()'
endmethod
-- End of method definition for .sftDefineMain2()


------------------------------------------------------------------------
--
-- Method:      Initialise()
--
-- Description: Initialise the form each time it is displayed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .initialise()

  if (!this.debug) then
    WRITE |Running sftDefineMain2.initialise()|
  endif

-- setup controls for PML containers
  using namespace 'Aveva.pdms.presentation'

-- Setup the display grid headings
  !this.paintHeadings[1] = 'NAME'
  !this.paintHeadings[2] = 'DESCRIPTION'
  !this.paintHeadings[3] = 'MAKER'

  !this.surfTreatHeadings[1] = 'NAME'
  --!this.surfTreatHeadings[2] = 'TRCODE'
  !this.surfTreatHeadings[2] = 'SURMATERIAL'
  !this.surfTreatHeadings[3] = 'SHOPRIMER'
  !this.surfTreatHeadings[4] = 'SURPREPARATION'

  !this.coatingHeadings[1] = 'DESCRIPTION'
  !this.coatingHeadings[2] = 'MAKER'
  !this.coatingHeadings[3] = 'THICKNESS'
  !this.coatingHeadings[4] = 'NAME'

  !t = true
  !f = false

-- Basic settings for PAINT grid - column specific settings go in POPULATEHOLELIST()
  !this.ngcPaintList.columnExcelFilter(!t)
  !this.ngcPaintList.outlookGroupStyle(!f)
  !this.ngcPaintList.fixedHeaders(!f)
  !this.ngcPaintList.fixedRows(!t)
  !this.ngcPaintList.editableGrid(!t)
  !this.ngcPaintList.singlerowselection(!f)
  !this.ngcPaintList.setAlternateRowColor(231, 231, 231)

-- Basic settings for SURFTREAT grid - column specific settings go in POPULATEHOLELIST()
  !this.ngcSurfTreatList.columnExcelFilter(!f)
  !this.ngcSurfTreatList.outlookGroupStyle(!f)
  !this.ngcSurfTreatList.fixedHeaders(!f)
  !this.ngcSurfTreatList.fixedRows(!t)
  !this.ngcSurfTreatList.editableGrid(!t)
  !this.ngcSurfTreatList.singlerowselection(!t)
  !this.ngcSurfTreatList.setAlternateRowColor(231, 231, 231)

-- Basic settings for SELECTED COATING grid
  !this.ngcSelCoatingList.columnExcelFilter(!f)
  !this.ngcSelCoatingList.outlookGroupStyle(!f)
  !this.ngcSelCoatingList.fixedHeaders(!f)
  !this.ngcSelCoatingList.fixedRows(!f)
  !this.ngcSelCoatingList.editableGrid(!f)
  !this.ngcSelCoatingList.singlerowselection(!f)
  !this.ngcSelCoatingList.setAlternateRowColor(231, 231, 231)
  !this.ngcSelCoatingList.headerSort(!f)
  !this.ngcSelCoatingList.setColumnVisibility(4,FALSE)

  !this.surfaceTreat = object SFTGETTING()

  -- Define a global format to use for displaying thickness
  !!sftThicknessFmt = object FORMAT()
  !!sftThicknessFmt.dp            = 2
  !!sftThicknessFmt.dimension     = 'L'
  !!sftThicknessFmt.label         = ||
  !!sftThicknessFmt.trailZeros    = false

  -- Set displayed and formatted units
  if (!!isImperialLength('DIST')) then
     !this.txtThickness.tag = 'Thickness (mil)'
    !!sftThicknessFmt.units = 'THOU'
 else
    !this.txtThickness.tag = 'Thickness (microns)'
    !!sftThicknessFmt.units = 'MICRONS'
  endif

-- Getting Catalogue Point
  !this.getCataPoint()

  if (!this.cataPoint.set()) then
    -- Gather all data for display on SRFTRT tab
      !this.generateSurfTreatList()
-- Gather all data for display on PAINT tab
  !this.generatePaintList()
  endif

  !this.flag = 0

endmethod
-- End of method definition for .initialise()


------------------------------------------------------------------------
--
-- Method:      PaintPopupHandler()
--
-- Description: Handle selection from Popup menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .paintPopupHandler(!data is ARRAY)

-- Check that some rows are selected before showing the menu
  if (defined(!data[2]) and !data[2].set() ) then
    !this.conPaintGrid.showPopup(!data[0], !data[1])
  endif

endmethod
-- End of method definition for .paintPopupHandler()

------------------------------------------------------------------------
--
-- Method:      SurfTreatPopupHandler()
--
-- Description: Handle selection from Surface Treatment Popup menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .surfTreatPopupHandler(!data is ARRAY)

-- Check that some rows are selected before showing the menu
  if (defined(!data[2]) and !data[2].set() ) then
    !this.conSurfTreatGrid.showPopup(!data[0], !data[1])
  endif

endmethod
-- End of method definition for .surfTreatPopupHandler()

------------------------------------------------------------------------
--
-- Method:      SelCoatingPopupHandler()
--
-- Description: Handle selection from Popup menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selCoatingPopupHandler(!data is ARRAY)


-- Check that some rows are selected before showing the menu
  if (defined(!data[2]) and !data[2].set() ) then
    !this.conSelCoatingGrid.showPopup(!data[0], !data[1])
  endif

endmethod
-- End of method definition for .selCoatingPopupHandler()


------------------------------------------------------------------------
--
-- Method:      ChooseCoating()
--
-- Description: Display the list of Coatings and allow user selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .chooseCoating()

  if (NOT !this.ngcSurfTreatList.getSelectedRows()set() ) then
    !!alert.error('Not selected SRFTRT on Grid Control')
    return
  else
    loadform !!sftDefineCoatings
  endif
--  !message = !selected[1][1]
  !!sftDefineCoatings.setSurfTreatLabel( !selected[1][1] )
  --show !!sftDefineCoatings

endmethod
-- End of method definition for .chooseCoating()

------------------------------------------------------------------------
--
-- Method:      .deletePaint()
--
-- Description: Delete the selected PAINT entry
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deletePaint()

  if (!this.debug) then
    WRITE |Running sftDefineMain2.deletePaint()|
  endif

  if (NOT !this.ngcPaintList.getSelectedRows().set()) then
    !!alert.error('Not selected PAINT item in Grid Control')
    return
  endif

  if ( !!alert.confirm('Delete paint - are you sure?').eq('YES') ) then
     !safeCE = !!ce
     do !selected values !this.ngcPaintList.getSelectedRows()
         !element = !selected[1].dbref()
         $!element
         DELETE PAINT
     enddo

     !this.ngcPaintList.deleteSelectedRows()
     !!ce = !safeCE
     handle (2,822)
        -- Cannot set current element to an unset reference
        -- (i.e. item has been deleted)
     endhandle
  endif

endmethod
-- End of method definition for .deletePaint()


------------------------------------------------------------------------
--
-- Method:      .deleteSurfTreat()
--
-- Description: Delete the selected SurfTreat entry
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteSurfTreat()

  if (!this.debug) then
    WRITE |Running sftDefineMain2.deleteSurfTreat()|
  endif

  if (NOT !this.ngcSurfTreatList.getSelectedRows().set()) then
    !!alert.error('Not selected SRFTRT item in Grid Control')
    return FALSE
  endif

  if ( !!alert.confirm('Delete Surface Treatment - are you sure?').eq('YES') ) then
       !safeCE = !!ce
       do !selected values !this.ngcSurfTreatList.getSelectedRows()
            !element = !selected[1].dbref()
            $!element
            DELETE SRFTRT
        enddo
        !this.ngcSurfTreatList.deleteSelectedRows()
        !this.ngcSelCoatingList.clearGrid()
        !!ce = !safeCE
        handle (2,822)
           -- Cannot set current element to an unset reference
           -- (i.e. item has been deleted)
        endhandle
  endif

endmethod
-- End of method definition for .deleteSurfTreat()

------------------------------------------------------------------------
--
-- Method:      .copyPaint()
--
-- Description: Copy the selected PAINT entry to create a new entry
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .copyPaint()

  if (!this.debug) then
    WRITE |Running sftDefineMain2.copyPaint()|
  endif

  if (NOT !this.ngcPaintList.getSelectedRows().set()) then
      !!alert.error('Not selected PAINT item in Grid Control')
      return
  endif
$(
<ARRAY>
   [1]  <STRING> '/Paint-002'
   [2]  <STRING> 'Hempadur 4563'
   [3]  <STRING> 'KCC'
 $)
   !safeCE = !!ce
   do !selected values !this.ngcPaintList.getSelectedRows()
       !element = !selected[1].dbref()
       $!element
       END
       TAIL
       NEW PAINT
       COPY $!element
   enddo

   !!ce = !safeCE

   !this.generatePaintList()
-- Select the last entry in the list i.e. the new one!
  !this.ngcPaintList.selectrow( !this.ngcPaintList.getnumberrows() )

endmethod
-- End of method definition for .copyPaint()

------------------------------------------------------------------------
--
-- Method:      .copySurfTreat()
--
-- Description: Copy the selected SurfTreat entry to create a new entry
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .copySurfTreat()

  if (!this.debug) then
    WRITE |Running sftDefineMain2.copySurfTreat()|
  endif

  if (NOT !this.ngcSurfTreatList.getSelectedRows().set()) then
      !!alert.error('Not selected copy item in Grid Control')
      return FALSE
  endif

 !safeCE = !!ce
  do !selected values !this.ngcSurfTreatList.getSelectedRows()
     !element = !selected[1].dbref()
     $!element
     END
     TAIL
     NEW SRFTRT
--  Option to copy members commented out for usability, maybe best removed?
--
--  if ( !!alert.confirm('Copy the assigned coatings as well?').eq('YES') ) then
     COPY $!element
--  else
--    COPY ATTRIB OF $!element
--  endif
  enddo
  !!ce = !safeCE

  !this.generateSurfTreatList()
-- Select the last entry in the list i.e. the new one!
  !this.ngcSurfTreatList.selectrow( !this.ngcSurfTreatList.getnumberrows() )

endmethod
-- End of method definition for .copySurfTreat()

------------------------------------------------------------------------
--
-- Method:      .createNewPaint()
--
-- Description: Create a new PAINT entry and update the list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createNewPaint()

   if (!this.debug) then
      WRITE |Running sftDefineMain2.createNewPaint()|
   endif

   if !this.checkHierarchy() then
     return
   endif

   !safeCE = !!ce
   if (NOT !this.surfaceTreat.getPaintPoint()) then
      !!ce = !this.cataPoint[1].dbref()
      NEW SECT
      PURP PAIN
      !this.surfaceTreat.paintPoint[1] = !!ce.string()
   endif

   !!ce = !this.surfaceTreat.paintPoint[1].dbref()
   TAIL
   NEW PAINT
   !!ce = !safeCE

   !this.generatePaintList()
   !this.ngcPaintList.selectrow( !this.ngcPaintList.getnumberrows() )

endmethod
-- End of method definition for .createNewPaint()

------------------------------------------------------------------------
--
-- Method:      .createNewSurfTreat()
--
-- Description: Create a new PAINT entry and update the list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createNewSurfTreat()

   if (!this.debug) then
      WRITE |Running sftDefineMain2.createNewSurfTreat()|
   endif

   if !this.checkHierarchy() then
     return
   endif

   !safeCE = !!ce
   if (NOT !this.surfaceTreat.getSurfacePoint()) then
      !!ce = !this.cataPoint[1].dbref()
      NEW SECT
      PURP SURF
      !this.surfaceTreat.surfacePoint[1] = !!ce.string()
   endif

   !!ce = !this.surfaceTreat.surfacePoint[1].dbref()
   TAIL
   NEW SRFTRT
   !!ce = !safeCE

   !this.generateSurfTreatList()
   !this.ngcSurfTreatList.selectrow( !this.ngcSurfTreatList.getnumberrows() )

endmethod
-- End of method definition for .createNewSurfTreat()

------------------------------------------------------------------------
--
-- Method:      DeleteCoatingEntry()
--
-- Description: Remove selected entry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteCoatingEntry()

  if ( !!alert.confirm('Delete selected COATING - Are you sure?').eq('YES') ) then
      !safeCE = !!ce
      do !selected values !this.ngcSelCoatingList.getSelectedRows()
          -- delete element
          !dbref = !selected[4].dbref()
          $!dbref
          delete COATING
      enddo
      !!ce = !safeCE
      handle (2,822)
        -- Cannot set current element to an unset reference
        -- (i.e. item has been deleted)
      endhandle

    --!this.generateCoatingList()
      !this.ngcSelCoatingList.deleteSelectedRows()
  endif

endmethod
-- End of method definition for .deleteCoatingEntry()


------------------------------------------------------------------------
--
-- Method:      DeleteCoatingAll()
--
-- Description: Remove selected entry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteCoatingAll()

  if ( !!alert.confirm('Delete All Coatings - Are you sure?').eq('YES') ) then

    !safeCE = !!ce

   !surfTreat = !this.ngcSurfTreatList.getSelectedRows()[1][1]
-- Move to the selected SRFTRT element
    $!surfTreat

    delete SRFTRT MEM

    !!ce = !safeCE
    handle (2,822)
        -- Cannot set current element to an unset reference
        -- (i.e. item has been deleted)
    endhandle

    !this.generateCoatingList()

  endif

endmethod
-- End of method definition for .deleteCoatingAll()

------------------------------------------------------------------------
--
-- Method:      .applyCellChanges()
--
-- Description: Check the changes made to editable cell and save if permitted
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyCellChanges(!data is ARRAY)

  if (!this.debug) then
    WRITE |Running sftDefineMain2.applyCellChanges()|
  endif

$(  q var !data
<ARRAY>
   [0]  <STRING> 'myString'     (new value)
   [1]  <STRING> '=15353/363'   (row tag)
   [2]  <STRING> 'NAME'         (column header)
   [3]  <BOOLEAN> TRUE          (control flag)
$)

-- This flag is using due to quit update cell. Once running the afterCellUpdate is 1, otherwise 0
-- You can be able to write the name without '/' in Grid Cell
  if (!this.flag eq 1 ) then
      !this.newName = object STRING()
      !this.flag = 0
      return
  endif

      !item = !data[1].dbref()

  !this.newName = object STRING()
  if ((!data[2] eq 'NAME') and (!data[0].subString(1,1) neq '/')) then
     !data[0] = '/' + !data[0]
     !this.newName = !data[0]
     !this.rowTag = !data[1]
     !this.columnTag = !data[2]
  endif

  !item.$!data[2] = !data[0]

  handle (41,12)
     !error = 'Name ' + !data[0] + ' already used'
     !!alert.error(!error)
     !data[3] = FALSE
     return
  elsehandle (2,794)
     !item.$!data[2] = !data[0].boolean()
     handle(2,775)
        !error = 'Unable to convert string ' + !data[0] + ' to a boolean value'
        !!alert.error(!error)
        !data[3] = FALSE
        return
     elsehandle(2,794)
        !error = 'Cannot assign to attribute. Object must be of type <BOOLEAN>'
        !!alert.error(!error)
        !data[3] = FALSE
        return
     endhandle
  endhandle

endmethod
-- End of method definition for .applyCellChanges()

------------------------------------------------------------------------
--
-- Method:      .afterSurfaceCellChanges()
--
-- Description: Check the changes made to editable cell and save if permitted
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .afterSurfaceCellChanges(!data is ARRAY)

  if (!this.debug) then
    WRITE |Running sftDefineMain2.afterSurfaceCellChanges()|
  endif

  if (!this.newName.set()) then
      !this.flag = 1
      !this.ngcSurfTreatList.setCellValue(!this.rowTag, !this.columnTag, !this.newName)
  endif

endmethod
-- End of method definition for .afterSurfaceCellChanges()

