------------------------------------------------------------------------
--
-- Method:      GeneratePaintList()
--
-- Description: Show example data to demonstrate form controls
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .generatePaintList()

  if (!this.debug) then
    WRITE |Running sftDefineMain2.generatePaintList()|
  endif

-- setup controls for PML containers
  using namespace 'Aveva.pdms.presentation'

  if (NOT !this.surfaceTreat.getPaintPoint()) then
      -- create new sect with purp is PAIN
      $!this.cataPoint[1]
      NEW SECT
      PURP PAIN
      !this.surfaceTreat.paintPoint[1] = !!ce.string()
  else
  !allPaints = !this.surfaceTreat.getAllPaintCode()

      -- Bind paint data to grid
  !nds = object NETDATASOURCE('Paints', !this.paintHeadings, !allPaints)
  !this.ngcPaintList.bindToDataSource(!nds)
  endif

endmethod
-- End of method definition for .generatePaintList()

