      !this.surfaceTreat.surfacePoint[1] = !!ce.string()
  else
  !allSurfTreat = !this.surfaceTreat.getAllSurfaceCode()

      -- Bind Surface Treatment data to grid
  !nds = object NETDATASOURCE('Surface Treatments', !this.surfTreatHeadings, !allSurfTreat)
