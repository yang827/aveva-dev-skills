------------------------------------------------------------------------
--
-- Method:      .getCataPoint()
--
-- Description: Getting Paint Catalogue point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getCataPoint()


   var !insertPoint collect all CATA with PURP eq 'PCAT'

   if (!insertPoint.unset() OR !insertPoint.size().eq(0)) then
       NEW CATA
       PURP PCAT
       !this.cataPoint[1] = !!ce.string()
   else
       !this.cataPoint = !insertPoint
   endif

   !this.surfaceTreat.cataPoint = !this.cataPoint

endmethod
-- End of method definition for .getCataPoint()
------------------------------------------------------------------------
--
-- Method:      .checkHierarchy()
--
-- Description: Checks the hierarchy to make sure that there is a CATA with
--      purp PCAT and if not it checks to see if one can be created.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkHierarchy() is BOOLEAN

  if (!this.debug) then
    WRITE |Running sftDefineMain2.checkHierarchy()|
  endif

  --Save the current element.
  !saveCE = !!ce
  --Firstly search through the current CATA's with purp PCAT and see if we can write to any of them.
  do !index index !this.cataPoint
    !!ce = !this.cataPoint[!index].dbref()
    handle ANY
      !dbWrite = FALSE
      break
    elsehandle NONE
      !dbWrite = dbwrite
      if !dbWrite then
        if !index.eq(1) then
          return FALSE
        else
          --If the CATA we can write to is not the first in the cataPoint array then
          --we need it to be as the program uses this to create the surface treatments under.
          !this.cataPoint.insert(1, !this.cataPoint[!index])
          !this.cataPoint.remove(!index + 1)
          !this.surfaceTreat.cataPoint = !this.cataPoint
          if !this.cataPoint[1].dbref().mCount().lt(2) then
            !this.createHierarchy('SECT')
          endif
          return FALSE
        endif
      endif
    endhandle
  enddo

  --Ask the user if they want us to create the CATA, if not return TRUE which will terminate the event.
  !answer = !!alert.confirm('There is no catalogue for surface treatments with write access. Would you like the hierarchy creating?')
  if !answer.eq('NO') then
    !!ce = !saveCE
    return TRUE
  endif

  -- Make sure we have write enabled dbs available too us.
  !session = current session
  !writeAbleDbs = FALSE
  do !index index !session.current()
    if !session.status()[!index].eq('RW') then
      if !session.current()[!index].type.eq('CATA') then
        !writeAbleDbs = TRUE
        break
      endif
    endif
  enddo
  if !writeAbleDbs.not() then
    !!alert.message('All the Databases are Read-Only.')
    return TRUE
  endif

  -- And Finally lets find somewhere and create the CATA.
  !!ce = !saveCE
  if dbwrite then
    --If we can write to the saved current element then find the route element of that.
    if !!ce.name.neq('/*') then
      do
        --Cycle up through the hierarchy till we get to a point where we can create a CATA
        if !!ce.owner.name.eq('/*') then
          break
        else
          !!ce = !!ce.owner
        endif
      enddo
    endif
  else
    --Get the members of world and cycle through till we find one with dbwrite.
    !world = object DBREF('/*')
    do !element values !world.members
      !!ce = !element
      if dbwrite then
        break
      endif
    enddo
  endif

  !this.createHierarchy('ALL')

  return FALSE

endmethod
--End of method definition for .checkHierarchy()
------------------------------------------------------------------------
--
-- Method:      .createHierarchy()
--
-- Description: Creates the surface treatment hierarchy.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createHierarchy(!type is STRING)
	
	if !type.eq('ALL') then
	  --Create the CATA with PURP PCAT and place first in cataPoint Array.
	  NEW CATA
	  PURP PCAT
	  --Name the CATA for completion.
	  !inc = 1
	  do
	    !!ce.name = '/Surf-Treat-Cata-' + !inc.string()
	    handle (41,12)
	      !inc = !inc + 1
	    elsehandle NONE
	      break
	    endhandle
	  enddo
	  !this.cataPoint.insert(1, !!ce.name)
	  !this.surfaceTreat.cataPoint = !this.cataPoint
	endif

  --Create the Paint SECT and the Surface Treatment SECT
  NEW SECT
  PURP PAIN
  --Name the Paint Section
  !inc = 1
  do
    !!ce.name = '/Surf-Treat-Paint-' + !inc.string()
    handle (41,12)
      !inc = !inc + 1
    elsehandle NONE
      break
    endhandle
  enddo
  NEW SECT
  PURP SURF
  --Name the Surface Treatment Section
  !inc = 1
  do
    !!ce.name = '/Surf-Treat-Surf-' + !inc.string()
    handle (41,12)
      !inc = !inc + 1
    elsehandle NONE
      break
    endhandle
  enddo

endmethod
--End of method definition for .createHierarchy()
------------------------------------------------------------------------
--
-- Method:      .closeCallback()
--
-- Description: Close CallBack Function
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
