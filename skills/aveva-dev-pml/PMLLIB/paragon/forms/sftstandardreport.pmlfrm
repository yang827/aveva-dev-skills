--
--
--  Description:     Form used in Paragon for Surface Treatment report
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  closeCallback()                  -                   Close CallBack Function
--  generateSurfTreatList()          -                   Show surface treatment list data
--  getCataPoint()                   -                   Getting Paint Catalogue point
--  initialise()                     -
--  popupHandler(ARRAY)              -                   Handle selection from Popup menu
--  printList()                      -                   Print preview the grid data
--  saveToXLS()                      -                   Save the grid data to Excel file
--  sftstandardreport()              -                   Constructor
--
------------------------------------------------------------------------

import 'PMLFileBrowser'
handle (1000,0)
endhandle

import 'GridControl'
handle (1000,0)
endhandle

-- Specify the namespace so we can refer to the .NET stuff
using namespace 'Aveva.pdms.presentation'

------------------------------------------------------------------------
-- Form:      SurfaceTreatment
------------------------------------------------------------------------

setup form !!sftstandardreport dialog docking size 86 28

-- Define titles and initialisation call
  !this.formTitle = 'Surface Treatment Standard Report'
  !this.iconTitle = 'Surface Treatment'
  !this.initcall  = '!this.initialise()'

  hdist 1
  halign centre
  path right
  vdist 0.5

-- SURFACE TREATMENT tab
      frame .frmSurfTreatList  'List of Surface Treatment'   at xmin form + 0.5   ymin  anchor all width 96 height 25
        container .conSurfTreatGrid nobox PMLNetCONTROL 'NET'      at xmin              ymin + 0.5     dock fill
      exit
      path down
      button .btnAddSurfTreat      '  Print  '               at xmin + 27          ymax + 0.5        anchor b callback '!this.printList()'
      path right
      hdist 2
      button .btnCopySurfTreat     '  Excel  '                                                      anchor b callback '!this.saveToXLS()'
      button .btnRefreshSurfTreat  ' Refresh '                                                      anchor b callback '!this.generateSurfTreatList()'
      button .btnShowSurfaceTreat  ' Show Standard '                                                anchor b callback 'show !!sftdefinemain2'
      button .btnDismiss           ' Dismiss '                                                      anchor b callback '!this.closeCallback()'
      path down

menu .mnupopup popup
  !this.mnupopup.add( 'CALLBACK', ' Print  ','!this.printList()' )
  !this.mnupopup.add( 'CALLBACK', ' Excel  ','!this.saveToXLS()' )
  !this.mnupopup.add( 'CALLBACK', ' Refresh','!this.generateSurfTreatList()')
-- Define member variables
   member .ngcSurfTreatList  is  NETGRIDCONTROL

   member .surfTreatHeadings is  ARRAY

   member .debug             is  BOOLEAN

   member .cataPoint         is  ARRAY

-- Define collection data from PARAGON with PURPOSE filter
   member .surfaceTreat      is  SFTGETTING
exit


------------------------------------------------------------------------
--
-- Method:      sftstandardreport
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sftstandardreport()

-- Control of additional debugging messages during processing
  !this.debug = FALSE
  if (defined(!!debug) ) then
    !this.debug = TRUE
  endif

-- setup controls for PML containers
  using namespace 'Aveva.pdms.presentation'

-- add .Net control to PML container for SRFTRT
  !this.ngcSurfTreatList = object NETGRIDCONTROL()
  !this.conSurfTreatGrid.control = !this.ngcSurfTreatList.handle()

  !this.ngcSurfTreatList.addeventhandler('OnPopup', !this, 'PopupHandler')
  !this.conSurfTreatGrid.popup = !this.mnupopup
  !this.cancelCall        = '!this.closeCallback()'
endmethod
-- End of method definition for .sftstandardreport()


------------------------------------------------------------------------
--
-- Method:      Initialise()
--
-- Description: Initialise the form each time it is displayed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  if (!this.debug) then
    WRITE |Running sftstandardreport.initialise()|
  endif

-- setup controls for PML containers
  using namespace 'Aveva.pdms.presentation'

-- Setup the display grid headings

  !this.surfTreatHeadings[1] = 'NAME'
  !this.surfTreatHeadings[2] = 'DESCR'
  !this.surfTreatHeadings[3] = 'SURMAT'
  !this.surfTreatHeadings[4] = 'SHOPRI'
  !this.surfTreatHeadings[5] = 'SURPRE'
  !this.surfTreatHeadings[6] = 'PAINT DESC'
  !this.surfTreatHeadings[7] = 'MAKER'
  !this.surfTreatHeadings[8] = 'THICKNESS (MICRONS)'

  !t = true
  !f = FALSE

-- Basic settings for SURFTREAT grid - column specific settings go in POPULATEHOLELIST()
  !this.ngcSurfTreatList.columnExcelFilter(!f)
  !this.ngcSurfTreatList.outlookGroupStyle(!f)
  !this.ngcSurfTreatList.fixedHeaders(!f)
  !this.ngcSurfTreatList.fixedRows(!f)
  !this.ngcSurfTreatList.headerSort(!f)
  !this.ngcSurfTreatList.editableGrid(!f)
  !this.ngcSurfTreatList.singlerowselection(!t)

  !this.surfaceTreat = object SFTGETTING()
-- Getting Catalogue Point
  !this.getCataPoint()

-- Gather all data for display on SRFTRT tab
  !this.generateSurfTreatList()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      GenerateSurfTreatList()
--
-- Description: Show surface treatment list data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .generateSurfTreatList()

  if (!this.debug) then
      WRITE |Running sftstandardreport.generateSurfTreatList()|
  endif

-- setup controls for PML containers
  using namespace 'Aveva.pdms.presentation'

  if (NOT !this.surfaceTreat.getSurfacePoint()) then
      !!alert.warning('Can not found a suitable SECT or CATE element (PURP=SURF)')
      return
  endif

  !allSurfTreat = !this.surfaceTreat.getAllSurfaceCode()

  if (!allSurfTreat.size().eq(0) ) then
    !!alert.warning('Selected element has no surface treatment')
  else
    -- Generate data for rows
    !allEntries = object ARRAY()

    !rowColour = object ARRAY()
    !totalItem = 1
    !currentColour = 'white'

    -- Create a format for the treatment thicknesses
    !thicknessFmt = object FORMAT()
    !thicknessFmt.dp            = 2
    !thicknessFmt.dimension     = 'L'
    !thicknessFmt.label         = ||
    !thicknessFmt.trailZeros    = false

    -- Set displayed and formatted units
    if (!!isImperialLength('DIST')) then
      !this.surfTreatHeadings[8] = 'THICKNESS (MIL)'
      !thicknessFmt.units = 'THOU'
    else
      !this.surfTreatHeadings[8] = 'THICKNESS (MICRONS)'
      !thicknessFmt.units = 'MICRONS'
    endif

    do !idx index !allSurfTreat
      !rowData = object ARRAY()
      !surface = !allSurfTreat[!idx].dbref()
      !allCoatings = !surface.members
      -- Generate data for rows
      !count = 0

      do !item values !allCoatings
          if (!count.eq(0) ) then
              !rowData[1] = !surface.name
              !rowData[2] = !surface.descr
              !rowData[3] = !surface.surmat
              !rowData[4] = !surface.shopri.string()
              !rowData[5] = !surface.surpre
              if (!totalItem neq 1) then
                  if (!currentColour eq 'white') then
                      !currentColour =  'lightGray'
                  else
                      !currentColour =  'white'
                  endif
              endif
          else
              !rowData[1] = ''
              !rowData[2] = ''
              !rowData[3] = ''
              !rowData[4] = ''
              !rowData[5] = ''
          endif
          if (!item.pairef.set() ) then
               if (NOT BADREF(!item.pairef)) then
                  !rowData[6] = !item.pairef.desc
                  !rowData[7] = !item.pairef.maker
               else
                   -- if paintRef is Badref, skip
                   skip
               endif
            else
              -- if paintRef is Null, skip
               skip
          endif
           -- grid row colour setting
          !rowColour[!totalItem] = !currentColour

        -- Format treatment thickness
        !rowData[8] = !item.cthick.string(!thicknessFmt)
        !allEntries.append(!rowData)
        !count = !count + 1
        !totalItem = !totalItem + 1
      enddo
    enddo
  endif

-- Bind example data to grid
  !nds = object NETDATASOURCE('Surface Treatments', !this.surfTreatHeadings, !allEntries)
  !this.ngcSurfTreatList.bindToDataSource(!nds)
  -- grid row colour setting
  do !rowId index !rowColour
     !this.ngcSurfTreatList.setRowColor(!rowId,!rowColour[!rowId])
  enddo

endmethod
-- End of method definition for .generateSurfTreatList()

------------------------------------------------------------------------
--
-- Method:      .getCataPoint()
--
-- Description: Getting Paint Catalogue point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getCataPoint()

   if (!this.debug) then
      WRITE |Running sftstandardreport.getCataPoint()|
   endif

   var !insertPoint collect all CATA with PURP eq 'PCAT'

   if (!insertPoint.unset() OR !insertPoint.size().eq(0)) then
       NEW CATA
       PURP PCAT
       !this.cataPoint[1] = !!ce.string()
   else
       !this.cataPoint = !insertPoint
   endif

   !this.surfaceTreat.cataPoint = !this.cataPoint

endmethod
-- End of method definition for .getCataPoint()

------------------------------------------------------------------------
--
-- Method:      .closeCallback()
--
-- Description: Close CallBack Function
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .closeCallback()
  if (!this.debug) then
      WRITE |Running sftstandardreport.closeCallback()|
  endif
  hide !!sftstandardreport
endmethod
-- End of method definition for .closeCallback()

------------------------------------------------------------------------
--
-- Method:      PrintList()
--
-- Description: Print preview the grid data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .printList()

  if (!this.ngcSurfTreatList.getNumberRows().neq(0)) then
    !this.ngcSurfTreatList.printPreview()
  else
    !!alert.error('No data to print')
  endif

endmethod
-- End of method definition for .printList()

------------------------------------------------------------------------
--
-- Method:      .saveToXLS()
--
-- Description: Save the grid data to Excel file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveToXLS()

  if (!this.ngcSurfTreatList.getNumberRows().eq(0)) then
    !!alert.error('No data to save')
    return
  endif

  using namespace 'AVEVA.PDMS.Presentation'
  !browser = object PMLFILEBROWSER('SAVE')

-- Default to first location from PDMSUSER evar
  !pdmsUser = !!evarSplit('PDMSUSER')
  !directory = !pdmsUser[1]

  !seedFile = 'SurfaceTreatment'
  !title = 'Save Surface Treatment List As'
  !existFlag = FALSE
  !filter = 'Microsoft Office Excel files (*.xls)|*.xls'
  !filterIndex = 1

-- Show Browser
  !browser.show(!directory, !seedFile, !title, !existFlag, !filter, !filterIndex)

-- Set selected file
  !saveFile = object FILE( !browser.file() )

  if ( !saveFile.set() ) then
    !this.ngcSurfTreatList.saveGridToExcel(!saveFile.string())
    handle (1000,0)
      !!alert.error('Could not write file: ' + !saveFile.string() + ' - ' + !!error.text )
    elsehandle none
      !!alert.message('File saved: ' + !saveFile.string() )
    endhandle
  endif

endmethod
-- End of method definition for .saveToXLS()

------------------------------------------------------------------------
--
-- Method:      PopupHandler()
--
-- Description: Handle selection from Popup menu
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .popupHandler(!data is ARRAY)

-- Check that some rows are selected before showing the menu
  if (!data.size() gt 2) then
    !this.conSurfTreatGrid.showPopup(!data[0], !data[1])
  endif

endmethod
-- End of method definition for .popupHandler()
