-- Description:
-- Form to create a slope element in the catalogue.
--

------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -
--  checkType(STRING)                -
--  formatAngle(REAL)                STRING
--  getName()                        -
--  initialise()                     -                   Initialisation when form is displayed
--  kill()                           -                   called when the destroyed
--  quit()                           -                   called when the form is closed
--  setAngle(GADGET,GADGET)          -
--  setGadgets(DBREF)                -
--  setSlope(GADGET,GADGET)          -                   try to parse the different mechanisms for slope
--  setSlope(REAL,GADGET)            -
--  setVisibility(BOOLEAN)           -
--  slopeElement()                   -                   Constructor
--  track()                          -
--

setup form !!slopeElement dialog

  track 'CATACE'    call '!this.track()'

  !this.icontitle       = 'Slope Element'
  !this.formtitle       = 'Pipe Slope Element Editor'
  !this.formrevision    = ' $Revision: 0.0 $ '
  !this.initcall        = '!this.initialise()'
  !this.quitcall        = |!this.quit()|
  !this.killingcall     = |!this.kill()|
  valign centre

  -- Form controls
  option   .mode call |!this.checkType(!this.mode.selection('RTEXT'))| width 6
  !list[1]  = |Create|
  !rlist[1] = |NEW|
  !list[2]  = |Modify|
  !rlist[2] = |OLD|

  !this.mode.dtext  = !list
  !this.mode.rtext  = !rlist

  text .name at xmax+1 ymin call |!this.getName()| width 35 scroll 50 nam


  frame .legAttributeFrame  at xmin.mode ymax width 45 height 5
    vdist 0.15

    --MINSLOPE The minimum slope allowed matching the design requirement
    --MAXSLOPE The maximum slope allowed with the slope range
    --DEFSLOPE The default slope to be applied during standard model routing
    --MINVERT  The minimum slope allowable to ensure free flow of solids
    --DISPUNIT An attribute to determine how the slope is represented

    path down
    option .definition 'Slope Mode    ' at x1 y0.5 call |!this.setGadgets(!this.ce)|  width 8

    !list[1] = '1 in '
    !list[2] = 'Angle'
    !list[3] = 'Percent'
    !list[4] = 'Value in '
    !this.definition.dtext = !list

    --text .value at xmax+1 ymin 'Value' width 7 is REAL

    text    .defSlope   |Default slope  | at x1 tagwidth 15 call |!this.setSlope(!this.defSlope,!this.defAngle)| tooltip 'Default slope' width 10 is STRING
    text    .defAngle 'Angle' at xmax+1  ymin               call |!this.setAngle(!this.defSlope,!this.defAngle)| tooltip 'Default slope angle' width 10  is REAL format !!slopeFmt
    text    .minSlope at xmin .defSlope ymax    tagwidth 15  'Minimum Slope  ' call |!this.setSlope(!this.minSlope,!this.minAngle)| tooltip 'Minimum allowable slope' width 10 is STRING
    text    .minAngle 'Angle'  at xmax+1 ymin                 call |!this.setAngle(!this.minSlope,!this.minAngle)| tooltip 'Minimum allowable slope angle' width 10   is REAL format !!slopeFmt
    text    .maxSlope at xmin .defSlope ymax tagwidth 15 'Maximum Slope ' call |!this.setSlope(!this.maxSlope,!this.maxAngle)| tooltip 'Maximum allowable slope' width 10 is STRING
    text    .maxAngle 'Angle'  at xmax +1 ymin call |!this.setAngle(!this.maxSlope,!this.maxAngle)| tooltip 'Maximum allowable slope angle'  width 10   is REAL format !!slopeFmt
    text    .minVert at xmin .defSlope ymax tagwidth 15 'Minimum Vertical ' call |!this.setSlope(!this.minVert,!this.minVertAngle)|tooltip 'Minimum allowable vertical slope ' width 10 is STRING
    text    .minVertAngle 'Angle'  at xmax +1 ymin call |!this.setAngle(!this.minVert,!this.minVertAngle)| tooltip ' Minimum allowable vertical angle 'width 10  is REAL format !!slopeFmt

    path down

  exit

  button .apply 'Apply' at xmin .legAttributeFrame ymax call |!this.apply()|
  button .closeButton   'Dismiss'  width 8 at xmax .legAttributeFrame-size ymin call |!this.quit()|

 member .ce               is DBREF
 member .slotab           is DBREF

exit
--End of form definition

------------------------------------------------------------------------
--
-- Method:      .slopeElement()
--
-- Description: Constructor
------------------------------------------------------------------------
define method .slopeElement()

   !!slopeFmt = !!angleFmt

endmethod

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: Initialise the form each time it is displayed
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
--
------------------------------------------------------------------------

define method .initialise()

!!slopeFmt = !!angleFmt
!!slopeFmt.dp = 4

!this.ce = !!ce

!this.setGadgets(!!ce)
handle ANY
endhandle

if !!ce.type inset('SLOTAB','SLOELE') then
   if !!ce.type.eq('SLOTAB') then
     !this.slotab = !!ce
     !this.mode.val = 1
     !this.setGadgets( object DBREF() )
     !this.name.val = 'unset'
   elseif !!ce.type.eq('SLOELE') then
     !this.slotab = !!ce.owner
     !this.mode.val = 2

     if !this.ce.name.match('=').eq(1) then
       	!this.name.val = 'unset'
       	else
         !this.name.val = !!ce.name.after('/')
     endif
   endif
   -- Make sure the form is enabled
   !this.setVisibility(true)
else
   -- Disable the form
   !this.setVisibility(false)
endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .quit
--
-- Description: called when the form is closed
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .quit()

  !this.hide()

endmethod

------------------------------------------------------------------------
--
-- Method:      .kill
--
-- Description: called when the destroyed
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .kill()

  !this.quit()

endmethod

------------------------------------------------------------------------
--
-- Method:   setSlope()
-- Description: try to parse the different mechanisms for slope
--
------------------------------------------------------------------------
define method .setSlope(!gadget is GADGET,!target is GADGET)

  -- Fetch the contents of the gadget
  !input = !gadget.val
  if (!input.unset()) then
    !input = ''
  endif
  !input = !input.trim('LRM').upcase()

  -- Set a default value of zero
  !value = 0

  -- Parse the input if there is any
  if (not !input.empty() and !input ne 'UNSET' ) then

    !selection = !this.definition.selection()

    -- Handle values in the format 'x in y'
    if (!selection inset ('1 in ', 'Value in ')) then

      !start = !input.before('IN')
      !finish = !input.after('IN')
      !inFound = !input.match('IN') ne 0

      !firstValue = !start.real()
      handle any
        if (!inFound) then
          !!alert.error('First value is not a valid number')
        else
          !!alert.error('Value is not a valid number')
        endif
        return
      endhandle

      if (!firstValue.unset()) then
        !!alert.error('First value has not been set')
        return
      endif

      -- Handle the second value if there is one
      if (!inFound) then

        if (!selection eq '1 in ' and !firstValue ne 1 ) then
          !!alert.error('First value should be 1')
          return
        endif

        !secondValue = !finish.real()
        handle any
          !!alert.error('Second value is not a valid number')
          return
        endhandle

        if (!secondValue.unset()) then
          !!alert.error('Second value has not been set')
          return
        endif

        !value = atan( !firstValue / !secondValue)
        handle (2, 430) $* Division by zero
        endhandle

      else
        !value = atan( 1.0 / !firstValue)
        handle (2, 430) $* Division by zero
        endhandle
      endif

    elseif (!selection eq 'Angle') then
      !value = !input.real()
      handle any
        !!alert.error('Input value is not numeric')
        return
      endhandle
    elseif (!selection eq 'Percent') then
      !input = !input.trim('R', '%')
      !value = !input.real()

      handle any
        !!alert.error('Input value is not numeric')
        return
      endhandle

      !value = atan(!value / 100)
      endif

  endif

  if (!value.unset() or !value le 0) then
    !gadget.val = 'unset'
    !value = 0
  endif

  !this.setSlope(!value,!target)

endmethod

------------------------------------------------------------------------
--
-- Method:   setAngle()
--
define method .setAngle(!destination is GADGET,!source is GADGET)

  !destination.val = !this.formatAngle(!source.val)
  if (!source.val.unset()) then
    !source.val = 0
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:   setSlope()
--
define method .setSlope(!slope is REAL,!target is GADGET)

  !target.val = !slope

endmethod

------------------------------------------------------------------------
--
-- Method:   apply()
--
--Method to create a new SLOELE or modify the current one
--
define method .apply()

if !this.name.val.eq('unset') then
  !!alert.error('Invalid name - Please enter a valid name')
  return
endif

if !this.defAngle.val.eq(0) then
	 !!alert.error('Invalid Default Slope - Please enter a valid slope or angle')
   return
endif

-- Create object for checking write access
!dbCheck = object COMCHECKDBWRITE()
!dbCheck.showAlert = true

!mode = !this.mode.selection()
if (!mode eq |NEW|) then

  -- Check write access
  if (not !dbCheck.checkDbWrite(!this.slotab)) then
    return
  endif

   -- its a new element
  !!ce = !this.slotab
  last mem
  handle ANY
  endhandle
  new SLOELE
endif

-- Check write access
if (not !dbCheck.checkDbWrite(!!ce)) then
  return
endif

-- now set all the attributes

if (!mode eq 'NEW') then
  !test = !!checkName (!this.name.val, !mode)
  if (!test.unset()) then
    return
  endif
endif

!!ce.name = '/' & !this.name.val

handle ANY
  !!alert.error('Invalid name entered - Name unchanged')
endhandle

!!ce.description = !this.defSlope.val
!!ce.minSlope    = !this.minAngle.val
!!ce.maxSlope    = !this.maxAngle.val
!!ce.defSlope    = !this.defAngle.val
!!ce.minVert     = !this.minVertAngle.val

!this.initialise()

endmethod

------------------------------------------------------------------------
--
-- Method:  getName
--
--Method to create a new SLOELE or modify the current one
--
define method .getName()


-- to navigate to existing item --
if      !this.name.val.match('/') eq (0) then
	      /$!this.name.val
handle any
endhandle
endif

-- check name entered with checkName --

        !test = !!checkName (!this.name.val,'NEW')
if      !test.eq('unset') then
        !this.name.val = !!ce.name.string().after('/')

endif

 --to unset name if element is unnamed--
if      !this.name.val.eq(||) then
        (!this.name.val = |unset|)

   if      (!this.name.val.set()) then
           !!ce.name = !this.name.val
     else

       handle Any
       endhandle
   endif

endif

endmethod

------------------------------------------------------------------------
--
-- Method:   .checkType
--       to check the type
--Method to check the type of the current element
--
define method .checkType(!option is STRING)

if !option.eq('OLD') then
  if !!ce.type.neq('SLOELE') then

     !!alert.error('Cannot modify a SLOTAB with this form')
     !this.mode.select('RTEXT', 'NEW')

  endif
endif

if !option.neq('OLD') then
  if !!ce.type.eq('SLOELE') then
   !this.name.val = 'unset'
  endif
endif

endmethod


-----------------------------------------------------------------------
--
-- Method:   apply()
--
--Method to create a new SLOELE or modify the current one
--
--
define method .setGadgets(!element is DBREF )

if (!element.unset()) then

  !this.defAngle.val      = 0
  !this.minAngle.val      = 0
  !this.maxAngle.val      = 0
  !this.minVertAngle.val  = 0

  !this.defSlope.val       = !this.formatAngle( 0 )
  !this.minSlope.val       = !this.formatAngle( 0 )
  !this.maxSlope.val       = !this.formatAngle( 0 )
  !this.minVert.val        = !this.formatAngle( 0 )

elseif (!element.type eq 'SLOTAB') then

  !this.defSlope.val       = !this.formatAngle(!this.defAngle.val)
  !this.minSlope.val       = !this.formatAngle(!this.minAngle.val)
  !this.maxSlope.val       = !this.formatAngle(!this.maxAngle.val)
  !this.minVert.val        = !this.formatAngle(!this.minVertAngle.val)

else

  !this.defAngle.val      = !element.defSlope
  !this.minAngle.val      = !element.minSlope
  !this.maxAngle.val      = !element.maxSlope
  !this.minVertAngle.val  = !element.minVertical

  !this.defSlope.val       = !this.formatAngle(!element.defSlope    )
  !this.minSlope.val       = !this.formatAngle(!element.minSlope    )
  !this.maxSlope.val       = !this.formatAngle(!element.maxSlope    )
  !this.minVert.val        = !this.formatAngle(!element.minVertical )

endif

endmethod

------------------------------------------------------------------------
--
-- Method:  formatAngle()
--
-- Description format the passed angle into a string according to the current mode.
--
define method .formatAngle(!angle is REAL) is STRING

  if (!angle.eq(0) or !angle.unset()) then
    return 'unset'
  elseif !this.definition.selection().eq( 'Angle' ) then
     -- grey out the first text gadgets
    return !angle.string()
  elseif !this.definition.selection().eq(  '1 in ' ) then
     !tan = tan(!angle)
     !slope = 1 / !tan
     !rounded = !slope.nint().string(!!realFmt)
     return '1 in ' & !rounded
  elseif !this.definition.selection().eq( 'Percent') then
     !tan = tan(!angle) * 100
     !rounded = !tan.string(!!realFmt)
     return !rounded & ' %'
  else
    -- option is 'value in '
     !tan = tan(!angle)
     !slope = 1 / !tan
     !rounded = !slope.nint().string(!!realFmt)
     return '1 in ' & !rounded
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:   track()
--
--Method to track the current element and rebuild the form if it changes
--
define method .track()
     -- Blank out gadgets if ce is not a slope element or a slope table --
if !!ce.type.neq('SLOELE').and(!!ce.type.neq('SLOTAB')) then
	!this.setVisibility(false)
else
	!this.setVisibility(true)
endif
!this.initialise()

endmethod

--------------------------------------------------------------------------
----
---- Method:   apply()
----
----Method to validate that a gadget has the correct relationship with another
----
--define method .validate(!gadget is GADGET)
--
--endmethod


------------------------------------------------------------------------
--
-- Method:   .setVisibility()
--
-- Method to make gadgets on the form visible or not
--

define method .setVisibility(!action is BOOLEAN)

!this.defAngle.active      = !action
!this.minAngle.active      = !action
!this.maxAngle.active      = !action
!this.minVertAngle.active  = !action
!this.defSlope.active      = !action
!this.minSlope.active      = !action
!this.maxSlope.active      = !action
!this.minVert.active       = !action
!this.name.active          = !action
!this.mode.active          = !action
!this.definition.active    = !action
!this.apply.active         = !action

endmethod
