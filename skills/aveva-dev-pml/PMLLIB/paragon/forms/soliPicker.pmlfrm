--
--
--  Description:     Select a SOLI element from MATW, modal dialog.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  closeCallback()                  -                   Form close callback
--  generateSoliList()               -                   Generate the soli list in NGC
--  initialise()                     -                   Form initcall callback
--  okCall()                         -                   OK button callback
--  setSelectedCallbackMethod(STRING) -
--  soliPicker()                     -                   Constructor
--
------------------------------------------------------------------------

import 'GridControl'
handle (1000,0)
endhandle

-- Specify the namespace so we can refer to the .NET stuff
using namespace 'Aveva.pdms.presentation'

------------------------------------------------------------------------
-- Form:      SoliPicker
------------------------------------------------------------------------
setup form !!soliPicker blockingdialog size 20 5

-- Define titles and initialisation call
  !this.formTitle = 'Pick material'
  !this.iconTitle = 'Pick material'
  !this.initcall  = '!this.initialise()'

  vdist 0.5
  hdist 2
  path down

  container .conMtrlGrid nobox PMLNetCONTROL 'NET'                              anchor top+bottom+left                width 50 height 24
  button    .btnOk        |Normal|   'OK'               width 12     callback  '!this.okCall()'
  path right
  button    .btnCancel    |Normal|   'Cancel'    at xmax.btnOk+24 ymin.btnOk       width 12     CANCEL

-- *******************************************************************************************************

-- Define member variables
  member .selectedSoli      is  DBREF
  member .cb                is  STRING
  member .debug             is  BOOLEAN
  member .ngcMtrlList       is  NETGRIDCONTROL
exit

------------------------------------------------------------------------
--
-- Method:      solipicker
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .soliPicker()

-- Control of additional debugging messages during processing
  !this.debug = FALSE
  if (defined(!!debug) ) then
    !this.debug = TRUE
  endif

  using namespace 'Aveva.pdms.presentation'

  !this.ngcMtrlList = object NETGRIDCONTROL()
  !this.conMtrlGrid.control = !this.ngcMtrlList.handle()

  !this.cancelCall        = '!this.closeCallback()'
endmethod
-- End of method definition for .insudefinemain()

------------------------------------------------------------------------
--
-- Method:      Initialise()
--
-- Description: Initialise the form each time it is displayed
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  if (!this.debug) then
    WRITE |Running soliPicker.initialise()|
  endif

  !this.ngcMtrlList.columnExcelFilter( TRUE )
  !this.ngcMtrlList.outlookGroupStyle( FALSE )
  !this.ngcMtrlList.fixedHeaders( FALSE )
  !this.ngcMtrlList.fixedRows( FALSE )
  !this.ngcMtrlList.editableGrid( FALSE )
  !this.ngcMtrlList.singlerowselection( TRUE )
  !this.ngcMtrlList.setalternaterowcolor(231, 231, 231)

-- Update list
  !this.generateSoliList()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      .closeCallback()
--
-- Description: Close CallBack Function
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .closeCallback()
   hide !!soliPicker
endmethod
-- End of method definition for .closeCallback()

------------------------------------------------------------------------
--
-- Method:      okCall()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .okCall()
  if (!this.debug) then
    WRITE |Running soliPicker.okCall()|
  endif

  if (NOT !this.ngcMtrlList.getSelectedRows().set()) then
    !!alert.error('Not selected SOLI item in Grid Control')
    return
  endif

  if( !this.cb.set() ) then
      !arr = !this.ngcMtrlList.getSelectedRows().First()
      if( !arr.set() ) then
        !cell = !arr[1]
        !ref = !cell.dbref()
        !str = !ref.String()
        -- Build callback command
        !meth = '!this.owner().' + !this.cb + '(''' + !str + ''')'
        -- Execute callback
        if (!this.debug) then
          $p $!meth
        endif
        $!meth
        !this.closeCallback()
      endif
   elseif( !this.debug ) then
     WRITE |Warning no callback function has been set|
   endif

endmethod
-- End of method definition for .okCall()

------------------------------------------------------------------------
--
-- Method:      generateSoliList()
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .generateSoliList()
  using namespace 'Aveva.pdms.presentation'

  var !solids collect all SOLI
  !attribs = |NAME DESC|
  !data = object NETDATASOURCE('SOLIds', !attribs.split(), !solids)
  !this.ngcMtrlList.bindToDataSource(!data)
endmethod
-- End of method definition for .generateSoliList

------------------------------------------------------------------------
--
-- Method:      setSelectedCallbackMethod()
--
-- Description: Set the name of callback method on parent form, which
--              should be called after successfully selecting a SOLI
--              element in the list and clicking OK button in dialog.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setSelectedCallbackMethod( !cbMethodName is STRING )
  if( !cbMethodName.set()) then
    !this.cb = !cbMethodName
  endif
endmethod
