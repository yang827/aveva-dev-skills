--
--
-- Description:
-- Show errors from setting PCONNs
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  setList(ARRAY)                   -                   Set the list of duplicates
--
------------------------------------------------------------------------

setup form !!spcPConnErrors
  !!spcPConnErrors.formTitle      = 'Duplicate CTypes'
  !!spcPConnErrors.iconTitle      = 'Duplicates'
  !!spcPConnErrors.callback       = ''
  !!spcPConnErrors.formRevision   = ' $Revision: 1.3 $ '

  frame .errorFrame 'Errors' at xmin ymax + 0.2
    textpane .errors at xmin + 1 ymax width 60 height 10
  exit

  vdist 1
  path down
  halign left

  button .dismiss 'Dismiss' at xmax.errorFrame - 7 CANCEL

exit

-- End of form definition for !!spcPConnErrors

------------------------------------------------------------------------
--
-- Method:      setList(ARRAY)
--
-- Description: Set the list of duplicates
--
-- Method Type: Procedure
-- Arguments:
--   1  R  ARRAY(STRING) List of duplicate strings
--
------------------------------------------------------------------------

define method .setList(!errorArray is ARRAY)
  !this.errors.val = !errorArray
endmethod
-- End of method definition for .setList(ARRAY)
