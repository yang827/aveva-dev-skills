--     Keyword:     GEN
--   Module:        paragon
--   Replaces:
--
-- Author:          S.Bourne
-- Created:         Tue Jul 7 10:45:10 BST 1998
--
--
-- Description:
--     Change the PCONNs for a given SKEY
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  changeCe(DBREF)                  -                   Change the current SPWL element
--  changePConns()                   -                   Change the PCONNs of SPCOMs in selected SPECs
--  selectAllSpec()                  -                   Select all elements in the SPEC list
--  spcPConnsForSkey()               -                   Constructor
--
------------------------------------------------------------------------

setup form !!spcPConnsForSkey
  !!spcPConnsForSkey.formTitle      = 'Modify PConns'
  !!spcPConnsForSkey.iconTitle      = 'Modify PConns'
  !!spcPConnsForSkey.callback       = ''
  !!spcPConnsForSkey.formRevision   = ' $Revision: 1.6 $ '

  path down
  vdist 1

  button .currSpwl 'CE' at ymin + 0.5 callback '!this.changeCe(!!ce)'

  path right
  hdist 1

  para .currSpwlText width 50

  path down
  vdist 0

  frame .selectSpecs 'Select Specs' at xmin.currSpwl
    vdist 1

    button .selectAllSpec 'Select All' callback '!this.selectAllSpec()'

    path right
    hdist 1

    button .unSelectAllSpec 'Unselect All' callback '!this.specList.clearSelection()'

    path down
    vdist 1

    list .specList 'SPEC Elements' at xmin.selectAllSpec MULTIPLE width 23 height 25
  exit

  path right
  hdist 2

  text .skeyName ' SKey ' at ymin + 1 width 10 STRING

  path down
  vdist 1

  frame .modifyPConns 'ModifyPConns'
    text .from 'From ' width 26 STRING
    text .to 'To   ' width 26 STRING
  exit

  textpane .output 'Output' width 32 height 11

  vdist 0

  toggle .reportChanges 'Report changes to file'

  vdist 1

  text .filename 'File ' width 26 STRING

  button .apply 'Apply' at xmin.selectSpecs ymax.selectSpecs + 1 callback '!this.changePConns()' APPLY

  button .dismiss 'Dismiss' at xmax.modifyPConns - 8 ymin.apply CANCEL
exit

-- End of form definition for !!spcPConnsForSkey

------------------------------------------------------------------------
--
-- Method:      spcPConnsForSkey()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--
------------------------------------------------------------------------

define method .spcPConnsForSkey()
  !this.changeCe(!!ce)
  !this.from.val = '*'

  !this.output.setEditable(false)

  !this.reportChanges.val = TRUE
  !this.filename.val = '%PDMSUSER%/PConnsReport.txt'
endmethod
-- End of method definition for .spcPConnsForSkey()


------------------------------------------------------------------------
--
-- Method:      changeCe(DBREF)
--
-- Description: Change the current SPWL element
--
-- Method Type: Procedure
-- Arguments:
--   1   R   DBREF    New current element
--
------------------------------------------------------------------------
define method .changeCe(!newCe is DBREF)

  !specNames = ARRAY()

  !typeList[1] = 'SPWL'
  !typeList[2] = 'WORL'
  !owner = !!dtbOwnerOfTypes(!newCe, !typeList)

  !this.currSpwlText.val = !owner.fullType + ': ' + !owner.fullName

  if (!owner.unset() or !owner.type eq 'WORL') then
    var !specElems COLLECT ALL SPEC
  else
    var !specElems COLLECT ALL SPEC FOR $!owner
  endif

  do !specElement values !specElems
    !specNames.append(!specElement.dbRef().fullName)
  enddo

  !this.specList.dText = !specNames
  !this.specList.rText = !specElems

endmethod
-- End of method definition for .changeCe(DBREF)


------------------------------------------------------------------------
--
-- Method:      selectAllSpec()
--
-- Description: Select all elements in the SPEC list
--
-- Method Type: Procedure
-- Arguments:
--
------------------------------------------------------------------------

define method .selectAllSpec()
  !selection = !this.specList.rText

  !this.specList.select('RTEXT', !selection)
endmethod
-- End of method definition for .selectAllSpec()


------------------------------------------------------------------------
--
-- Method:      changePConns()
--
-- Description: Change the PCONNs of SPCOMs in selected SPECs
--
-- Method Type: Procedure
-- Arguments:
--
------------------------------------------------------------------------

define method .changePConns()
  !errors = ARRAY()
  !skey = !this.skeyName.val

  !oldPConns = !this.from.val.split()
  !newPConns = !this.to.val.split()

  if (!oldPConns.size() EQ 1) then
    if (!oldPConns[1] EQ '*') then
      do !newPConnIndex indices !newPConns
        if (!newPConnIndex NEQ 1) then
          !oldPConns.append('*')
        endif
      enddo
    endif
  endif

  !changes = ARRAY()

  -- initialise object cache for scom data
  !cache = object SPCSCOMCACHE()

  do !specRef values !this.specList.selection('RTEXT')
    !spec = object SPCSPECSKEY(!specRef.dbRef())
    !errors.append ('SPEC ' & !specRef.dbRef().fullName)

    !spec.changePConns(!skey, !oldPConns, !newPConns, !errors, !changes, !cache)
  enddo

  -- delete scom object cache
  !cache.delete()

  !this.output.val = !errors

  if (!this.reportChanges.val) then
    !changeFile = object FILE(!this.filename.val)
    !changeFile.writeFile('WRITE', !changes)
  endif
endmethod
-- End of method definition for .changePConns()
