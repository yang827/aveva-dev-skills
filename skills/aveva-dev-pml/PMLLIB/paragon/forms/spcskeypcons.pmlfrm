-- Author:          S.Bourne
-- Created:         Tue Jul 7 10:45:10 BST 1998
--
--
-- Description:
-- Define rules for PCONs associated with SKEYs
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyRules()                     -                   Apply the current set of rules to a spec
--  includeRule()                    -                   include a new rule in the rule list for an skey
--  init()                           -                   Initialise the form to use the current element
--  init(DBREF)                      -                   Initialise the form to use the DBREF
--  initRule()                       -                   initialise the ppoint/pcon display for the currently selected pcon rule
--  initRuleList()                   -                   initialise the rule list
--  initSKeyList()                   -                   initialise the skey list
--  readFile()                       -                   Read rules in from a file
--  removeRule()                     -                   Remove the rule for the specified ppoint from the rules for the current skey.
--  replaceRule()                    -                   replace the rule for the specified ppoint with a new rule
--  spcSKeyPCons()                   -                   constructor
--  update()                         -                   Update the skey and rule lists
--  writeFile()                      -                   Write the current rules out to a file
--
------------------------------------------------------------------------

setup form !!spcSKeyPCons
  !!spcSKeyPCons.formTitle       = 'Define PConnections for Symbol Keys'
  !!spcSKeyPCons.iconTitle       = 'SKey PCons'
  !!spcSKeyPCons.callback        = ''
  !!spcSKeyPCons.formRevision    = ' $Id: spcskeypcons.pmlfrm,v 1.7 2002/08/30 16:22:33 pne Exp $ '

  member .rules is ARRAY
  member .specCompOwner is SPCSPECCOMPOWNER

  bar
    add 'File' .fileMenu
  exit

  button .ce 'CE' callback |!this.init(!!ce)|

  path right

  paragraph .ceText width 50

  path DOWN
  halign left
  vdist 1

  list .skey 'Symbol Key' at xmin_ce callback |!this.initRuleList()| width 12 length 15

  vdist 0

  toggle .hideRules 'Hide SKeys with rules' callback |!this.update()|

  button .apply 'Update Spec' at ymax_hideRules + 2 callback |!this.applyRules()|

  frame .editFrame 'Edit Connection Types' at xmax.hideRules + 3 ymin.skey

    text .pPoint 'P-Point Number      ' at xmin.editFrame + 1 ymin.editFrame + 1 width 10 NUMERIC

    text .newConnType 'New connection type ' width 10 STRING

    button .include 'Include' callback |!this.includeRule()|

    path right
    hdist 3

    button .replace 'Replace' callback |!this.replaceRule()|

    button .remove 'Remove ' callback |!this.removeRule()|

    path down
    vdist 1

    list .connTypes 'Connection Types' at xmin.editFrame + 1 callback |!this.initRule()| width 28 length 8
  exit

  button .dismiss 'Dismiss' at xmax_connTypes - 8 ymin_apply CANCEL

exit

------------------------------------------------------------------------
--
-- Method:      spcSKeyPCons()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .spcSKeyPCons()
  -- Build menu bar

  !this.newMenu('fileMenu')
  !this.fileMenu.add('callback', 'Save', '!!spcSKeyPCons.writeFile()')
  !this.fileMenu.add('callback', 'Load', '!!spcSKeyPCons.readFile()')

  !this.include.active = FALSE
  !this.replace.active = FALSE
  !this.remove.active  = FALSE
endmethod
-- End of method definition for .spcSKeyPCons()


------------------------------------------------------------------------
--
-- Method:      init()
--
-- Description: Initialise the form to use the current element
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .init()
  !this.init(!!ce)
endmethod
-- End of method definition for .init()


------------------------------------------------------------------------
--
-- Method:      update()
--
-- Description: Update the skey and rule lists
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .update()
  !this.initSKeyList()
  !this.initRuleList()
endmethod
-- End of method definition for .update()


------------------------------------------------------------------------
--
-- Method:      init(DBREF)
--
-- Description: Initialise the form to use the DBREF
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .init(!ref is DBREF)
  !dbRef = !ref
  !oldDbRef = !dbRef

  do
    break if !dbRef.badRef()
    break if (!dbRef.type eq 'SPEC')
    !dbRef = !dbRef.own
  enddo

  if (not !dbRef.badRef()) then
    !this.ceText.val = !dbRef.fullName
    !this.rules.clear()
    !errors = ARRAY()

    !this.specCompOwner = object SPCSPECCOMPOWNER(!dbRef, !errors)

    do !skeyElem values !this.specCompOwner.skeys
      !rule = object SPCSKEYRULE()
      !rule.skey = !skeyElem.getName()
      !this.rules.append(!rule)
    enddo

    !this.initSKeyList()
    !this.initRuleList()

    if (not !errors.empty()) then
      show !!spcSpecErrors
      !!spcSpecErrors.spcSpecErrors(!errors)
    endif
  else
    !!alert.error('Cannot navigate to element of type SPEC from ' & !oldDbRef.fullName)
  endif
endmethod
-- End of method definition for .init(DBREF)


------------------------------------------------------------------------
--
-- Method:      initSKeyList()
--
-- Description: initialise the skey list
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .initSKeyList()
  !sKeyArray = ARRAY()
  !indexArray = ARRAY()

  do !ruleIndex indices !this.rules
    !ruleElem = !this.rules[!ruleIndex]

    if (!ruleElem.isNull() or (not !this.hideRules.val)) then
      !indexArray.append(string(!ruleIndex))
      !sKeyArray.append(!ruleElem.skey)
    endif
  enddo

  !this.skey.dText = !sKeyArray
  !this.skey.rText = !indexArray
endmethod
-- End of method definition for .initSKeyList()


------------------------------------------------------------------------
--
-- Method:      initRuleList()
--
-- Description: initialise the rule list
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .initRuleList()
  !pruleArray = ARRAY()
  !indexArray = ARRAY()

  if (!this.skey.val neq 0) then
    !ruleIndex = REAL(!this.skey.rText[!this.skey.val])

    do !pruleIndex indices !this.rules[!ruleIndex].pointRules
      !prule = !this.rules[!ruleIndex].pointRules[!pruleIndex]

      !pruleArray.append('P' & string(!prule.pPoint) & $
                       '      ' & !prule.connType)
      !indexArray.append(string(!pruleIndex))
    enddo
  endif

  !this.connTypes.dText = !pruleArray
  !this.connTypes.rText = !indexArray
  !this.initRule()
endmethod
-- End of method definition for .initRuleList()


------------------------------------------------------------------------
--
-- Method:      initRule()
--
-- Description: initialise the ppoint/pcon display for the currently selected pcon rule
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .initRule()
  if (!this.skey.val neq 0 and !this.connTypes.val neq 0) then
    !ruleIndex = REAL(!this.skey.rText[!this.skey.val])
    !pruleIndex = REAL(!this.connTypes.rText[!this.connTypes.val])

    !this.pPoint.val = STRING(!this.rules[!ruleIndex].pointRules[!pruleIndex].pPoint)
    !this.newConnType.val = !this.rules[!ruleIndex].pointRules[!pruleIndex].connType
    !this.include.active = TRUE
    !this.replace.active = TRUE
    !this.remove.active  = TRUE
  else
    !this.pPoint.val = ''
    !this.newConnType.val = ''

    if (!this.skey.val eq 0) then
      !this.include.active = FALSE
    else
      !this.include.active = TRUE
    endif

    !this.replace.active = FALSE
    !this.remove.active  = FALSE
  endif
endmethod
-- End of method definition for .initRule()


------------------------------------------------------------------------
--
-- Method:      applyRules()
--
-- Description: Apply the current set of rules to a spec
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .applyRules()
  !errors = ARRAY()

  do !ruleElem values !this.rules
    !this.specCompOwner.applyRule(!ruleElem,!errors)
  enddo

  if (not !errors.empty()) then
    show !!spcSpecErrors
    !!spcSpecErrors.spcSpecErrors(!errors)
  endif
endmethod
-- End of method definition for .applyRules()


------------------------------------------------------------------------
--
-- Method:      includeRule()
--
-- Description: include a new rule in the rule list for an skey
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .includeRule()
  !ruleIndex = REAL(!this.skey.rText[!this.skey.val])

  if (not !this.rules[!ruleIndex].includePPRule(real(!this.pPoint.val), trim(!this.newConnType.val))) then
    !!alert.error('Connection type for P' & !this.pPoint.val & ' already exists - Use Replace')
  endif

  !this.initRuleList()
endmethod
-- End of method definition for .includeRule()


------------------------------------------------------------------------
--
-- Method:      replaceRule()
--
-- Description: replace the rule for the specified ppoint with a new rule
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .replaceRule()
  !ruleIndex = REAL(!this.skey.rText[!this.skey.val])

  if (not !this.rules[!ruleIndex].replacePPRule(real(!this.pPoint.val), trim(!this.newConnType.val))) then
    !!alert.error('Connection type for P' & !this.pPoint.val & ' does not exist - Use Include')
  endif

  !this.initRuleList()
endmethod
-- End of method definition for .replaceRule()


------------------------------------------------------------------------
--
-- Method:      removeRule()
--
-- Description: Remove the rule for the specified ppoint from the rules for the current skey.
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .removeRule()
  !ruleIndex = REAL(!this.skey.rText[!this.skey.val])
  !this.rules[!ruleIndex].removePPRule(real(!this.pPoint.val))

  !pPoint = !this.pPoint.val
  !connType = !this.newConnType.val

  !this.initRuleList()

  !this.pPoint.val = !pPoint
  !this.newConnType.val = !connType
endmethod
-- End of method definition for .removeRule()


------------------------------------------------------------------------
--
-- Method:      writeFile()
--
-- Description: Write the current rules out to a file
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .writeFile()
  if (not !this.rules.empty()) then
    !output = ARRAY()

    !output.append('!!spcSKeyPCons.init(' & !this.specCompOwner.scomOwnerRef.ref & ')')
    !output.append('!!spcSKeyPCons.rules.clear()')

    do !ruleIndex indices !this.rules
      !ruleElem = !this.rules[!ruleIndex]
      !output.append('!!spcSKeyPCons.rules[' & string(!ruleIndex) & '] = OBJECT SPCSKEYRULE()')
      !ruleElem.print(!output, '!!spcSKeyPCons.rules[' & string(!ruleIndex) & ']')
    enddo

    !output.append('!!spcSKeyPCons.initRuleList()')

    openfile "spcskeypcons.mac" overwrite !token

    do !i indices !output
      writefile $!token |$!output[$!i]|
    enddo

    closefile $!token
  endif
endmethod
-- End of method definition for .writeFile()


------------------------------------------------------------------------
--
-- Method:      readFile()
--
-- Description: Read rules in from a file
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .readFile()
  $m "spcskeypcons.mac"

  handle (44,33)
    !!alert.error('No file to load')
  endhandle
endmethod
-- End of method definition for .readFile()
