--
--
-- Description:
-- Show errors in spec
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  spcSpecErrors(ARRAY)             -                   Initialisation
--
------------------------------------------------------------------------

setup form !!spcSpecErrors
  !!spcSpecErrors.formTitle      = 'Errors'
  !!spcSpecErrors.iconTitle      = 'Errors'
  !!spcSpecErrors.callback       = ''
  !!spcSpecErrors.formRevision   = ' $Revision: 1.3 $ '

  frame .errorFrame 'Errors' at xmin ymax + 0.2
    textpane .errorList at xmin + 1 ymax width 40 height 10
  exit

  vdist 1
  path down
  halign left

  button .dismiss 'Dismiss' at xmax.errorFrame - 7 CANCEL

exit

-- End of form definition for !!spcSpecErrors

------------------------------------------------------------------------
--
-- Method:      spcSpecErrors()
--
-- Description: Initialisation
--
-- Method Type: Procedure
-- Arguments:
--   1  R  ARRAY(STRING) List of error strings
--
------------------------------------------------------------------------

define method .spcSpecErrors(!errorArray is ARRAY)
  !this.errorList.val = !errorArray
endmethod
-- End of method definition for .spcSpecErrors(ARRAY)
