-- File:            spcspecreport.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        paragon
--   Replaces:
--
-- Author:          S.Bourne
-- Created:         Tue Jul 7 10:45:10 BST 1998
--
--
-- Description:
--     Produce report(s) on SPEC elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init()                           -                   form initialisation
--  report()                         -                   Report on each selected SPEC
--  selectAllSpec()                  -                   Select all elements in the list of SPECs
--  setCe()                          -                   form initialisation
--  spcSpecReport()                  -                   Constructor
--
------------------------------------------------------------------------

setup form !!spcSpecReport
  !!spcSpecReport.formTitle      = 'PCON/SKEY Compatibility Reports'
  !!spcSpecReport.iconTitle      = 'PCONS/SKEY Reports'
  !!spcSpecReport.callback       = '!this.init()'
  !!spcSpecReport.formRevision   = ' $Revision: 1.5 $ '

  path down
  vdist 1

  button .ce 'CE' callback '!this.setCe()'
  path right
  hdist 1
  para   .ceName width 30 height 1

  path down
  vdist 0.5

  text .directory 'Directory ' at xmin.ce width 28 STRING

  frame .defineReport 'Define Report'
    button .selectAllSpec 'Select All' callback '!this.selectAllSpec()'

    path right
    hdist 1

    button .unSelectAllSpec 'Unselect All' callback '!this.specList.clearSelection()'

    path down
    vdist 1

    list .specList 'SPEC Elements' at xmin.selectAllSpec MULTIPLE width 35 height 15
  exit

  path down
  vdist 1

  button .apply 'Apply' callback '!this.report()' at xmin.specList APPLY

  button .dismiss 'Dismiss' at xmax.defineReport - 8 ymin.apply CANCEL
exit

-- End of form definition for !!spcSpecReport

------------------------------------------------------------------------
--
-- Method:      spcSpecReport()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--
------------------------------------------------------------------------

define method .spcSpecReport()
  !specNames = ARRAY()
  var !specElems COLLECT ALL SPEC

  do !specElement values !specElems
    !specNames.append(!specElement.dbRef().fullName)
  enddo

  !this.specList.dText = !specNames
  !this.specList.rText = !specElems

  !this.directory.val = '%PDMSUSER%'
endmethod
-- End of method definition for .spcSpecReport()


------------------------------------------------------------------------
--
-- Method:      .init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
-- Arguments:
--
------------------------------------------------------------------------

define method .init()

  !this.setCe()

  !this.directory.val = '%PDMSUSER%'

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      .setCe()
--
-- Description: form initialisation
--
-- Method Type: Procedure
-- Arguments:
--
------------------------------------------------------------------------

define method .setCe()

  !specNames = ARRAY()

  !typeList[1] = 'SPWL'
  !typeList[2] = 'WORL'
  !owner = !!dtbOwnerOfTypes(!!ce, !typeList)

  !this.ceName.val = !owner.fullType + ': ' + !owner.fullName

  if (!owner.unset() or !owner.type eq 'WORL') then
    var !specElems COLLECT ALL SPEC
  else
    var !specElems COLLECT ALL SPEC FOR $!owner
  endif

  do !specElement values !specElems
    !specNames.append(!specElement.dbRef().fullName)
  enddo

  !this.specList.dText = !specNames
  !this.specList.rText = !specElems

endmethod
-- End of method definition for .setCe()

------------------------------------------------------------------------
--
-- Method:      selectAllSpec()
--
-- Description: Select all elements in the list of SPECs
--
-- Method Type: Procedure
-- Arguments:
--
------------------------------------------------------------------------

define method .selectAllSpec()
  !selection = !this.specList.rText

  !this.specList.select('RTEXT', !selection)
endmethod
-- End of method definition for .selectAllSpec()


------------------------------------------------------------------------
--
-- Method:      report()
--
-- Description: Report on each selected SPEC
--
-- Method Type: Procedure
-- Arguments:
--
------------------------------------------------------------------------

define method .report()
  !cocoElems = ARRAY()
  !output = ARRAY()

  do !spec values !this.specList.selection('RTEXT')
    !specName = !spec.dbRef().fullName
    PROMPT 'Processing SPEC $!specName'
    var !spcomElems COLLECT ALL SPCOM FOR $!spec

    !reportSpec = object SPCSPEC(!spcomElems, !cocoElems)
    !output.clear()
    !reportSpec.check(!output, 'Processing SPEC ' & !spec.dbRef().fullName)

    !filename = !spec.dbRef().name
    !filename = !filename.subString(2)
    !filename = !filename.replace('/','-')
    !filename = !filename.replace('\','-')
    !filename = !filename.replace('*','_')

    !filename = !this.directory.val & '/' & !filename & '.csv'

    !file = object FILE(!filename)
    !file.writeFile('OVERWRITE',!output)
  enddo

  PROMPT 'Done'
endmethod
-- End of method definition for .report()
