--
--  Description:     Choose form for selection tables
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  actions(GADGET,STRING)           -                   Gadget actions for main form
--  apply()                          -                   Set spref of design element to selected table item.
--  choose()                         -                   Choose matching table items from selection table
--  clearView()                      -                   Clear the 3D view
--  disableLocalEdit()               -                   Allow client of this form to disable local control (mode = 0)
--  firstShown()                     -                   Actions when form is shown for the first time.
--  getSelection()                   DBREF               Get current selected item
--  initSelTableList()               -                   Initialise table group option list
--  initSelTypeList()                -                   Initialise Selection table option list
--  initTable()                      -                   Initialise the selected Type
--  initialise()                     -                   Form initialisation
--  manageFrames(REAL)               -                   Manage the visibility of the create & modify frames
--  netAfterSelect(ARRAY)            -                   After select event for .net control
--  showPlot()                       -                   Show plot form for selected item.
--  showProps()                      -                   Show properties form for selected item.
--  stChoose()                       -                   Constructor
--
------------------------------------------------------------------------
import 'GridControl'
handle any
endhandle

--- form definition
setup form !!stChoose dialog docking size 50 35

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Grid control members
  member .netSelTabItems   is NETGRIDCONTROL

  -- Other members
  member .newItemName      is STRING
  member .selTables        is ARRAY
  member .selectedSelTab   is SELECTIONTABLE
  member .comprop          is COMPROP

  -- Questions and answers
  member .choices          is ARRAY
  member .selectedItem     is DBREF

  -- 3D view
  member .drawlist         is REAL

  path down

  frame .frCreate panel anchor top + left + right width 50
    option .opAutoName width 10
    text .txName at xmax.opAutoName+2 ymin.opAutoName width 30 is STRING
  exit

  frame .frModify panel anchor top + left + right at xmin.frCreate ymin.frCreate width 50
    button .bnCe 'CE'
    para   .paCeName at xmax.bnCe+2 ymin.bnCe text '' width 35
  exit

  -- Selection groups and tables
  option .opSelTables at xmin form tagwid 6 '' anchor left + right + top width 35
  option .opSelTypes tagwid 6 '' anchor left + right + top width 35
  toggle .tgDefault tagwid 6 'Default'

  -- PML container to host .NET grid control
  container .conSelTabItems nobox PmlNetControl 'Table items' anchor top + left + right at xmin form width 50 height 15

  -- 3D view
  frame .frView3D '3D view' anchor top + left + right width 50 height 10
    view .vwView3D volume
    exit
  exit

  button .bnProperties 'Properties...' at xmin form anchor top + left
  button .bnPlotfile 'PlotFile...' at xmax form-size ymin.bnProperties anchor top + right

  button .bnApply 'Apply' at xmin form ymax.bnProperties+1 anchor top + left apply
  button .bnCancel 'Cancel' at xmax form-size ymin.bnApply anchor top + right cancel

exit

------------------------------------------------------------------------
--
-- Method:      stChoose
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .stChoose()

  -- Form details
  !this.formTitle = 'Choose'
  !this.iconTitle = 'Choose'
  !this.initCall  = '!this.initialise()'
  !this.firstShownCall  = '!this.firstShown()'
  --!this.cancelCall  = '!!stChooseData.hide()'
  --!this.killingCall  = '!this.Kill()'

  -- Set auto-scroll
  !this.autoScroll = true

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Create grid control objects
  !this.netSelTabItems  = object NETGRIDCONTROL()
  -- Add event handlers to .net container
  --!this.netSelTabItems.addEventHandler('OnPopup', !this, 'netPopupCallback')
  !this.netSelTabItems.addEventHandler('AfterSelectChange', !this, 'netAfterSelect')
  -- Set grid properties
  !this.netSelTabItems.fixedHeaders(false)
  --!this.netSelTabItems.fixedRows(false)
  !this.netSelTabItems.outlookGroupStyle(true)
  !this.netSelTabItems.columnExcelFilter(true)
  !this.netSelTabItems.headerSort(true)
  !this.netSelTabItems.columnSummaries(false)
  !this.netSelTabItems.singleRowSelection(true)
  !this.netSelTabItems.setAlternateRowColor('WHITE')

  -- Add grid controls to containers
  !this.conSelTabItems.control  = !this.netSelTabItems.handle()

  -- Set autoName option text
  !dtext[1] = |Name|
  !dtext[2] = |Autoname|
  !rtext[1] = |NAME|
  !rtext[2] = |AUTO|
  !this.opAutoName.dtext = !dtext
  !this.opAutoName.rtext = !rtext

  -- Callbacks
  !this.opAutoName.callback = |!this.actions(|
  !this.txName.callback = |!this.actions(|
  !this.bnCe.callback = |!this.actions(|
  !this.opSelTables.callback = |!this.actions(|
  !this.opSelTypes.callback = |!this.actions(|
  !this.bnProperties.callback = |!this.showProps()|
  !this.bnPlotfile.callback = |!this.showPlot()|
  !this.bnApply.callback = |!this.apply()|

  -- 3D view / local drawlist
  !this.vwView3D.shaded = true
  !viewDir[1] = 0.57735
  !viewDir[2] = 0.57735
  !viewDir[3] = -0.57735
  !this.vwView3D.direction = !viewDir
  !this.drawlist = !!gphDrawlists.createDrawList()

endmethod
-- End of method definition for .stChoose()

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: Form initialisation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  -- Check global variable stChooseData is defined
  if (undefined(!!stChooseData)) then
    return error 1 |!!stChooseData global variable not defined!|
  endif

  -- Set create or modify mode
  !mode = !!stChooseData.mode
  if (!mode eq 1) then
    !this.opAutoName.val = 1
    !this.txName.val = object STRING()
    !this.paCeName.val = ''
    !this.newItemName = object STRING()
  elseif (!mode eq 2) then
    -- Set forms current element
    if (!!stChooseData.desItem.badref()) then
      return error 1 |Bad definition of !!stChooseData global variable, .desigItem must be set for Modify function!|
    endif
    !this.paCeName.val = !!stChooseData.desItem.fullname
  else
    return error 1 |Bad definition of !!stChooseData global variable, .mode must be 1 (create) or 2 (modify)!|
  endif
  -- Show create or modify frame
  !this.manageFrames(!mode)

  -- Set form title and list tags
  !this.formTitle = |Choose | & !!stChooseData.formTitle
  !this.opSelTables.tag = !!stChooseData.tableTag
  !this.opSelTypes.tag = !!stChooseData.typeTag

  -- Set selection tables
  !this.selTables = !!stChooseData.getSelTabs()

  -- Populate the table list
  !this.initSelTableList()

  -- Populate the type list
  !this.initSelTypeList()

  -- Initialise the selected type
  !this.initTable()

  -- Make properties and plotfile buttons inactive
  !this.bnProperties.active = false
  !this.bnPlotfile.active = false
  !this.bnApply.active = false

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      initSelTableList
--
-- Description: Initialise selection table option list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSelTableList()

  if (!this.selTables.size() gt 0) then
    -- Populate table group option list
    !dtext = !this.selTables.evaluate(object BLOCK(|!this.selTables[!evalIndex].name|))
    !this.opSelTables.dtext = !dtext
    -- Set selected table
    !this.selectedSelTab = object SELECTIONTABLE(!this.selTables[1])
  else
    -- Set list for none
    !dtext[1] = 'None'
    !this.opSelTables.dtext = !dtext
    -- Unset selected table group
    !this.selectedSelTab = object SELECTIONTABLE()
  endif

endmethod
-- End of method definition for .initSelTableList()
------------------------------------------------------------------------
--
-- Method:      initSelTypeList
--
-- Description: Initialise selection type option list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSelTypeList()

  if (!this.selTables.size() gt 0) then

    -- Get types for selected table
    !types = !this.selectedSelTab.getTypes()

    -- Populate type list
    if (!types.set()) then
      !this.opSelTypes.dtext = !types

      -- Select specified table type
      if (!!stChooseData.tableType.set()) then
        -- Get type index for specified type
        !typeIndex = REAL()
        do !ind indices !types
          if (!types[!ind].trim().upcase() eq !!stChooseData.tableType) then
            !typeIndex = !ind
            break
          endif
        enddo
        -- Select table type in option list and SELECTIONTABLE object
        if (!typeIndex.set()) then
          !this.opSelTypes.val = !typeIndex
        else
          !!alert.warning(|Invalid table type specified in !!stChooseData global object. The first type in the table will be selected!|)
        endif
      endif

    else
      !dtext[1] = 'None'
      !this.opSelTypes.dtext = !dtext
    endif

  -- Set list for none
  else
    !dtext[1] = 'None'
    !this.opSelTypes.dtext = !dtext
  endif

endmethod
-- End of method definition for .initSelTypeList()

------------------------------------------------------------------------
--
-- Method:      initTable
--
-- Description: Initialise the selected Type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initTable()

  -- Clear 3D view
  !this.clearView()

  -- Clear choose list
  !this.netSelTabItems.clearGrid()

  -- Show choose list
  if (!this.opSelTypes.selection() ne 'None')then
    !this.selectedSelTab.setType(!this.opSelTypes.val)
    !this.choose()
  endif

endmethod
-- End of method definition for .initTable()

------------------------------------------------------------------------
--
-- Method:      clearView
--
-- Description: Clear the 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearView()

  -- Clear 3D view
  if (!this.drawlist.set()) then
    !drawlist = !!gphDrawlists.drawlist(!this.drawlist)
    !drawlist.removeAll()
    !this.vwView3D.active = false
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      actions
--
-- Description: Gadget actions for main form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actions(!object is GADGET, !action is STRING)

  -- CE button
  if (!object eq !this.opAutoName and !action eq |SELECT|) then
    if (!this.opAutoName.selection() eq |NAME|) then
      !this.newItemName = object STRING()
      !this.txName.clear()
      !this.txName.active = true
    elseif (!this.opAutoName.selection() eq |AUTO|) then
      !this.txName.val = ''
      !this.txName.active = false
    endif

  -- Name text field
  elseif (!object eq !this.txName and !action eq |SELECT|) then
    -- Check for valid name
    !name = !!checkName(!this.txName.val, |NEW|)
    -- Set name field
    if (!name.set()) then
      -- Set new name
      !this.newItemName = !name
      !this.txName.val = !this.newItemName
    else
      -- Restore stored name
      !this.txName.val = !this.newItemName
    endif

  -- CE button
  elseif (!object eq !this.bnCe and !action eq |SELECT|) then
    if (!!ce.type eq !!stChooseData.desItem.type) then
      !!stChooseData.desItem = !!ce
      !this.initialise()
    else
      !!alert.error(|Wrong element type, $!!<stChooseData.desItem.type> expected!|)
    endif

  -- Table group option list
  elseif (!object eq !this.opSelTables and !action eq |SELECT|) then
    !this.selectedSelTab = object SELECTIONTABLE(!this.selTables[!this.opSelTables.val])
    !this.initSelTypeList()
    !this.initTable()

  -- Selection table option list
  elseif (!object eq !this.opSelTypes and !action eq |SELECT|) then
    !this.initTable()

  endif

endmethod
-- End of method definition for .actions()

------------------------------------------------------------------------
--
-- Method:      choose
--
-- Description: Choose matching table items from selection table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .choose()

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Get choice from selection table (answer data types converted to text)
  !questions = !!stChooseData.questions
  !answers = !!stChooseData.answers
  if (!questions.unset() or !questions.empty()) then
    !choiceItems = !this.selectedSelTab.choose(!!stChooseData.desItem, |TEXT|, !this.tgDefault.val)
  else
    !choiceItems = !this.selectedSelTab.choose(!!stChooseData.desItem, !questions, !answers, |TEXT|, !this.tgDefault.val)
  endif

  -- Save choices
  !this.choices.clear()
  do !ind indices !choiceItems
    !this.choices.append(!choiceItems[!ind].removeFirst())
  enddo

  -- Clear table ready for repopulating
  !this.netSelTabItems.clearGrid()

  -- Get headings for table
  !headings = object ARRAY()
  !headings.append('Item Name')
  !headings.appendArray(!this.selectedSelTab.getQuestions(|PURP|))
  !headings.appendArray(!this.selectedSelTab.stdGpartAtts)

  -- Total indicator
  !chooseTi = 'Choose'

  -- Bind to data source
  !ndsItems = object NETDATASOURCE(!chooseTi, !headings, !choiceItems)
  !this.netSelTabItems.bindToDataSource(!ndsItems)
  -- Select first row in the list
  !this.netSelTabItems.selectRow(0)

endmethod
-- End of method definition for .choose()

------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: Set spref of design element to selected table item.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  -- Create mode
  if (!!stChooseData.mode eq 1) then
    -- Create new design item and name it
    NEW $!!stChooseData.desType
    if (!this.opAutoName.selection() eq |AUTO|) then
      !autoName = !!namOpt.nameString(!!ce, object STRING(), false, false)
      if (!autoName.unset()) then
        !!alert.error(|Unable to Autoname element, set the autoname rule and then use 'Utilities>Autoname>CE only'|)
      else
        !!ce.name = !autoName
      endif
    else
      if (!this.newItemName.set()) then
        !!ce.name = !this.newItemName
      endif
    endif

  -- Modify mode
  elseif (!!stChooseData.mode eq 2) then
    !!ce = !!stChooseData.desItem
  endif

  -- Set spref to selected table item
  !type = !!ce.hardtype
  if (!this.selectedItem.prtref.badref().not()) then

    if (!type eq |NOZZ|) then
      !this.comprop.setProperties(!!ce)
      !this.comprop.unsetDesiElement()
      !!ce.catref = !this.selectedItem

    elseif (!type eq |EQUI|) then
      if (!!stChooseData.mode eq 1) then
        NEW TMPL
        COPY REXE $!this.selectedItem.tmpref
        END
        !this.comprop.setProperties(!!ce)
        SPREF UNSET
        !this.comprop.unsetDesiElement()
      elseif (!!stChooseData.mode eq 2) then
        !!alert.warning(|Cant change template ref of existing Equipment, spref will not be modified!|)
      endif

    else
      !this.comprop.setProperties(!!ce)
      !this.comprop.unsetDesiElement()
      !!ce.spref = !this.selectedItem
    endif

  else
    !!alert.warning(|Bad selection table item definition, spref will not be modified!|)
  endif

  -- Set any attributes specified in selection table
  !attribs = !this.selectedSelTab.getDesAttributes(!this.selectedItem)
  do !ind indices !attribs
    !!ce.attribute(!attribs[!ind][1]) = !attribs[!ind][2]
  enddo

  -- Clear name field for next item
  !this.newItemName = object STRING()
  !this.txName.clear()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      disableLocalEdit
--
-- Description: Allow client of this form to disable local control (mode = 0)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .disableLocalEdit()

  -- disable local create and modify controls
  !this.manageFrames(0)

endmethod
-- End of method definition for .disableLocalEdit()

------------------------------------------------------------------------
--
-- Method:      manageFrames
--
-- Description: Manage the visibility of the create & modify frames
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .manageFrames(!mode is REAL)

  -- Create mode
  if (!mode eq 1) then
    !this.frModify.visible = false
    !this.frCreate.visible = true
  -- Modify mode
  elseif (!mode eq 2) then
    !this.frCreate.visible = false
    !this.frModify.visible = true
  elseif (!mode eq 0) then
    -- allow mode to allow client of this form to disable local control (mode = 0)
    !this.frCreate.visible = false
    !this.frModify.visible = false
  endif

endmethod
-- End of method definition for .manageFrames()
------------------------------------------------------------------------
--
-- Method:      netAfterSelect
--
-- Description: After select event for .net control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       !a[0] is array of selected row tags (strings)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netAfterSelect(!a is ARRAY)

  -- Item is selected
  if (!a[0].set()) then
    -- Selected table item
    !this.selectedItem = !this.choices[!a[0][1].real()]

    -- Get local drawlist
    !drawlist = !!gphDrawlists.drawlist(!this.drawlist)

    -- Show in 3D view
    !gpart = !this.selectedItem.prtref
    if (!gpart.badref().not()) then
      !drawlist.removeAll()
      if (!gpart.tmpref.badref().not()) then
        !!gphViews.limits(!this.vwView3D, !gpart.tmpref)
        !drawlist.add(!gpart.tmpref)
        !this.vwView3D.active = true
      elseif (!gpart.catref.badref().not()) then
        !!gphViews.limits(!this.vwView3D, !gpart.catref)
        !drawlist.add(!gpart.catref)
        !this.vwView3D.active = true
      else
        !this.vwView3D.active = false
      endif
    endif

    -- Activate apply button
    !this.bnApply.active = true

    -- Initialise properties for new item
    if (!!stChooseData.mode eq 1) then
      !this.comprop.initialise(!this.selectedItem)
      handle any
        !this.bnProperties.active = false
        !this.bnPlotfile.active = false
      elsehandle none
        !this.bnProperties.active = true
        if (!this.comprop.checkPlot()) then
          !this.bnPlotfile.active = true
        else
          !this.bnPlotfile.active = false
        endif
        --!this.template.editFormBlockOwn(true)
        !this.comprop.autoCacheValues(true)
      endhandle

    -- Initialise properties for existing item
    elseif (!!stChooseData.mode eq 2) then
      !this.comprop.initialise(!!stChooseData.desItem)
      handle any
        !this.bnProperties.active = false
        !this.bnPlotfile.active = false
      elsehandle none
        !this.bnProperties.active = true
        if (!this.comprop.checkPlot()) then
          !this.bnPlotfile.active = true
        else
          !this.bnPlotfile.active = false
        endif
        --!this.template.editFormBlockOwn(true)
        !this.comprop.autoCacheValues(true)
      endhandle

    endif

  -- Item is not selected
  else
    -- Deactivate buttons
    !this.bnProperties.active = false
    !this.bnPlotfile.active = false
    !this.bnApply.active = false
    -- Clear 3D view
    !this.clearView()

  endif

endmethod
-- End of method definition for .netAfterSelect()

------------------------------------------------------------------------
--
-- Method:      getSelection
--
-- Description: Get current selected item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    DBREF       DBREF of selected item
--
------------------------------------------------------------------------
define method .getSelection() is DBREF

  return !this.selectedItem

endmethod
-- End of method definition for .getSelection()

------------------------------------------------------------------------
--
-- Method:      showProps
--
-- Description: Show properties form for selected item.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showProps()

  !this.comprop.editProperties()

endmethod
-- End of method definition for .showProps()

------------------------------------------------------------------------
--
-- Method:      showPlot
--
-- Description: Show plot form for selected item.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showPlot()

  !this.comprop.displayPlot()

endmethod
-- End of method definition for .showPlot()

------------------------------------------------------------------------
--
-- Method:      firstShown
--
-- Description: Actions when form is shown for the first time.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .firstShown()

  -- Add 3D view to view system (this shows the form)
  !!gphViews.add(!this.vwView3D)

  -- Add 3D view to drawlist
  if (!this.drawlist.unset()) then
    !this.drawlist = !!gphDrawlists.createDrawList()
  endif
  !!gphDrawlists.attachView(!this.drawlist, !this.vwView3D)

endmethod
-- End of method definition for .firstShown()
