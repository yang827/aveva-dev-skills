define function !!catModelViewInit(!form is FORM)

-- Set the limits border for the viewing gadget.
  !form.getElement.viewBorder       = 0
  !form.getElement.viewDirection[1] = -0.6
  !form.getElement.viewDirection[2] = 0.6
  !form.getElement.viewDirection[3] = -0.5

-- Load the form with the selected CATE
  !action = !form.setCe.callback & '!form.compAttribList , |SELECT|)'
  $!action

  !form.view.direction = !form.getElement.viewDirection

  if( !form.component.badref().not() ) then
    if( !form.component.type eq 'SPRF' ) then
      !array[1] = 0
      !array[2] = 1
      !array[3] = 0
      -- Set -Z View Direction for SPRF
      !form.view.direction = !array
      !array[1] = 0
      !array[2] = 0
      !array[3] = -1
      -- Set -Z View Direction for SPRF
      !form.view.direction = !array
    endif
  endif

  -- Initialise the view from the settings in the representation form

  !drawlist = !!gphDrawlists.drawlist(!form.view)
  if(defined(!!gphDrawlistRep)) then
    !!gphDrawlistRep.drawlist = !drawlist
    !!gphDrawlistRep.view = !form.view
    !!gphDrawlistRep.apply()
  endif

endfunction
