define function !!catModelViewsGetList(!gadget is GADGET, !action is STRING)
----------------------------------------------------------------------
-- catModelViewsGetList SELECT=$!action

if (!action.eq('UNSELECT')) then
    return
endif

-- Check the form owner and set the current element.
!form = !gadget.owner()

-- Navigate to item selected.
       $!gadget

-- Deal with category Selection of component.
    if (!gadget.eq(!form.categoryCont)) then

       -- Call the setce button to load component selected and change the forms.
        !call = !form.setCe.callback & '!gadget , |SELECT|)'
       $!call

    elseif (!gadget.eq(!form.ptrefList)) then

          -- Set the list equal to the members of the reference.
          !form.ptse.setEdit(!!ce,!form.ptrefList)

    elseif (!gadget.eq(!form.coreList)) then

          -- Set the list equal to the members of the reference.
          !form.core.setEdit(!!ce,!form.coreList)

    elseif (!gadget.eq(!form.plineList)) then

           -- Set the list equal to the members of the reference.
          !form.ptss.setEdit(!!ce,!form.plineList)

    elseif (!gadget.eq(!form.gmrefList)) then

          -- Setup the positive geometry list and make available geometry associated to this task.
          !form.gmse.setEdit(!!ce,!form.gmrefList)

    elseif (!gadget.eq(!form.gstrefList)) then

          -- Set the list equal to the members of the reference.
          !form.gmss.setEdit(!!ce,!form.gstrefList)

    elseif (!gadget.eq(!form.ngmrefList)) then

          -- Set the list equal to the members of the reference.
          !form.ngms.setEdit(!!ce,!form.ngmrefList)

    elseif (!gadget.eq(!form.dtseList)) then

          !form.dtse.listCallback(!form.dtseList, !form.dtse.table, !form.dtseList.val)

    elseif (!gadget.eq(!form.compAttribList)) then

          -- Deal with Selection of component.
          -- Callback from !!catModelViewsGetList last elseif statement
    else
          !gadgetname = !gadget.name()
          !formname   = !gadget.owner().name()
          write |Code needed for $!formname$n>$!gadgetname|
          -- Callback from !!catModelViewsGetList last else statement
    endif

endfunction
