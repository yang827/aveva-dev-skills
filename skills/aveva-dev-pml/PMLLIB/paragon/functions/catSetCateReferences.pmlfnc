--
--  File:            catSetCateReferences.pmlfnc
--    Type:          Function Definition
--    Group:         Undefined
--      Keyword:     Undefined
--    Module:        Undefined
--  Author:          Undefined
--  Created:         Mon Feb 26 11:14:22 2007

--
--  Description:     Undefined
--
----------------------------------------------------------------------------
define function !!catSetCateReferences(!gadget is GADGET, !action is STRING)
----------------------------------------------------------------------------

if (!action.eq('UNSELECT')) then
    return
endif

-- Set the form variable ready for later use.
!form   = !gadget.owner()

-- Save tracking status and disable tracking, to stop the forms from updating.
!modifyAttributesTrack = !!catModifyAttribs.track.val
!formTrack = !form.trackCE.val
!!catModifyAttribs.track.val = FALSE
!form.trackCE.val            = FALSE

-- Return the form view to be visible if we have turned it off.
!form.viewFrame.visible = TRUE

-- Attach to gadget selection.
$!gadget
handle (2,109)

-- Try the current form component.
   $!form.component
   handle (2,109)
	   !!alert.message(!!error.text)
	   -- Error occurs if the element has either been deleted, or renamed. check the rtext.
	 elsehandle none
	   !!catModelViews.setce(!gadget, 'SELECT')
	 endhandle
elsehandle any	
  !!catModifyAttribs.track.val = !modifyAttributesTrack
  !form.trackCE.val = !formTrack
  return
endhandle

-- Fill out the list of available GTYPES. and for ($!!ce.gtyp)
!!catModelViews.checkCombo(!form.categoryfield2, 'INIT')

-- Set the frames up.
-- ====================================================================================================
if (!!ce.type.eq('SCOM') or !!ce.type.eq('JOIN') or !!ce.type.eq('SFIT') or !!ce.type.eq('SPRF')) then
-- ====================================================================================================

!list = !form.getElement.setList(!form,!!ce.type)
!form.component = !!ce

-- Set the references into the store
!form.getElement.getRefs(!form.component,!list)

-- Set the name.
!form.compfield0.val = !!ce.name

-- Set the description.
var !description description of $!form.component
!form.compfield1.val = !description

-- Fill out the list of available GTYPES. and for ($!!ce.gtyp)
!!catModelViews.checkCombo(!form.compfield2, 'INIT')

-- Set the list gadget to reflect the current gtype for the current component.
!form.compfield2.val = !form.compfield2.dtext.findfirst(!form.component.gtype)
  handle any
    !form.compfield2.val = 1
  endhandle

-- Complete the rest of the required fields.

-- handle visibility and active state of the P-Point gadgets
  !pLineSetRef             = !form.component.ptref
  handle (2,201)
    -- this element does not have P-POINTS
    !form.compfield3.visible   = FALSE
    !form.compAction3.visible  = FALSE
    !form.ceField3.visible     = FALSE
  elsehandle none
    !form.compfield3.visible   = TRUE
    !form.compAction3.visible  = TRUE
    !form.ceField3.visible     = TRUE
    !form.compfield3.active    = TRUE
    !form.compAction3.active   = TRUE
    !form.ceField3.active      = TRUE
    !form.compfield3.val       = !pLineSetRef.name
    handle (2,754)
      !form.compfield3.val     = '=0/0'
    elsehandle (2,759) (2,202)
      !form.compfield3.val     = ''
      !form.compfield3.active  = FALSE
      !form.compAction3.active = FALSE
      !form.ceField3.active    = FALSE
    endhandle
  endhandle

-- switch on potentially hidden fields (depends on last use of this form)
!form.compfield6.visible  = TRUE
!form.ceField6.visible    = TRUE
!form.compAction6.visible = TRUE

-- Show or hide fields for the electrical app
if (!!appCntrl.currentApp eq 'ELEC') then
  if (!form.subType eq 'CORE') then
    !form.compfield4.visible = FALSE
    !form.compfield5.visible = FALSE
    !form.compfield6.visible = TRUE

    !form.ceField4.visible = FALSE
    !form.ceField5.visible = FALSE
    !form.ceField6.visible = TRUE

    !form.compAction4.visible = FALSE
    !form.compAction5.visible = FALSE
    !form.compAction6.visible = TRUE
  else
    !form.compfield4.visible = TRUE
    !form.compfield5.visible = TRUE
    !form.compfield6.visible = FALSE

    !form.ceField4.visible = TRUE
    !form.ceField5.visible = TRUE
    !form.ceField6.visible = FALSE

    !form.compAction4.visible = TRUE
    !form.compAction5.visible = TRUE
    !form.compAction6.visible = FALSE

  endif
else
    !form.compfield4.visible = TRUE
    !form.compfield5.visible = TRUE
endif

-- Deal with geometry set or Cable cores.
!form.compfield4.val = !form.component.gmref.name
handle (2,754)
  !form.compfield4.val = '=0/0'
elsehandle (2,759) (2,202)
  -- Add check here for steelwork and SPRF.
  if (!!appCntrl.currentApp inset('STL','ACCO')) then
      -- Try gstref here too.
      !form.compfield4.val = !form.component.gstref.name
        handle (2,754) (2,202)
          !form.compfield4.val = '=0/0'
        endhandle
  endif
endhandle

-- Deal with DataSet reference
if (defined(!form.compfield5)) then
 !form.compfield5.val = !form.component.dtref.name
  handle (2,754)
    var !dtref DTREF
    !form.compfield5.val = !dtref
  elsehandle (2,202)
  elsehandle (2,759)
  elsehandle none
  endhandle
endif

-- SPRF (steel profiles) have different gadgets to 3D geometry
if( !!ce.type eq 'SPRF' ) then
  !form.compfield6.visible  = FALSE
  !form.ceField6.visible    = FALSE
  !form.compAction6.visible = FALSE
  !form.compfield4.tag      = 'Profile Geom'
elseif( !!ce.type eq 'SCOM' ) then
  !form.compfield4.tag      = 'Geometry Set'
else
  !form.compfield4.tag      = '+ve Geometry'
endif

-- Check for defined here, as for some applications it won't be.
if (defined(!form.compfield6)) then
  if (!!appCntrl.currentApp eq 'ELEC' and !form.subType eq 'CORE') then
    !form.compfield6.val = !form.component.ccorref.name
    handle (2,754)
      !form.compfield6.val = '=0/0'
    elsehandle (2,759) (2,202)
    endhandle
    !form.compfield6.active   = TRUE
    !form.compAction6.active  = TRUE
    !form.ceField6.active     = TRUE

  else
    !form.compfield6.active   = TRUE
    !form.compAction6.active  = TRUE
    handle any
    endhandle
    !form.ceField6.active     = TRUE
    handle any
    endhandle
    !form.compfield6.val = !form.component.ngmref.name
    handle (2,754)
      !form.compfield6.val      = '=0/0'
    elsehandle (2,759) (2,202)
      !form.compfield6.val      = ''
      !form.compfield6.active   = FALSE
      !form.compAction6.active  = FALSE
       handle any
       endhandle
      !form.ceField6.active     = FALSE
       handle any
       endhandle
    elsehandle none
    endhandle
  endif

  if (not !!appCntrl.currentApp inset ('ELEC')) then
    -- Sort the bolting reference.
    var !blrfarray blrfarray of $!form.component
    handle (2,201)
    -- This not needed for current type.
    elsehandle none
      !form.compfield6.val      = !blrfarray
      !form.compAction6.active  = TRUE
      !form.ceField6.active     = TRUE
      !form.compfield6.active   = TRUE
    endhandle
  endif

endif

-- handle visibility and active state of the P-Line gadgets
if (defined(!form.compfield7)) then
  !form.compfield7.active   = TRUE
  !form.compAction7.active  = TRUE
  !form.ceField7.active     = TRUE
  !componentRef             = !form.component.pstref
  handle (2,201)
    -- this element does not have P-LINES
    !form.compfield7.visible   = FALSE
    !form.compAction7.visible  = FALSE
    !form.ceField7.visible     = FALSE
  elsehandle none
    !form.compfield7.visible   = TRUE
    !form.compAction7.visible  = TRUE
    !form.ceField7.visible     = TRUE
    -- Element has P-Line set reference attribute
    !form.compfield7.val = !componentRef.name
    handle (2,754)
      !form.compfield7.val      = '=0/0'
    elsehandle (2,759) (2,202)
      !form.compfield7.val      = ''
      !form.compfield7.active   = FALSE
      !form.compAction7.active  = FALSE
      !form.ceField7.active     = FALSE
    endhandle
  endhandle

endif
-- Set the reference flag
!form.dbrefno.val = !form.compAttribList.rtext[!form.compAttribList.val] & | (| & !form.compAttribList.rtext[!form.compAttribList.val].dbref().type & |)|

-- Deal with Parameters.

var !param param of $!form.component
  !form.compParams.val = !param

-- ==============================================================================================
elseif (!!ce.type.eq('CATE') or !!ce.type.eq('SECT')) then
-- ==============================================================================================

!list[1] = 'Name,Gtype,Parameters'
!list[2] = 'namn,gtype,param'

-- Set the references into the store
!form.getElement.getCate(!form,!form.component.owner,!form.component.type,!list)
  handle (2,202) (2,754)
   !!alert.error(!!error.text)
  endhandle

-- ==============================================================================================
elseif (!!ce.type.eq('STCA') or !!ce.type.eq('STSE')) then
-- ==============================================================================================

!list[1] = 'Name,Gtype,Parameters'
!list[2] = 'namn,gtype,param'

-- Set the references into the store
!form.getElement.getCate(!form,!form.component.owner,!form.component.type,!list)

-- ==============================================================================================
elseif (!!ce.type.eq('PTSE')) then
-- ==============================================================================================

!form.ptse.setRefs(!!ce,!form.ptrefList)
!form.currentGadget   = !form.ptrefList

-- ==============================================================================================
elseif (!!ce.type.eq('CCORSE')) then
-- ==============================================================================================

!form.core.setRefs(!!ce,!form.coreList)
!form.currentGadget   = !form.coreList

-- ==============================================================================================
elseif (!!ce.type.eq('PTSS')) then
-- ==============================================================================================

!form.ptss.setRefs(!!ce,!form.plineList)
!form.currentGadget   = !form.plineList

-- ==============================================================================================
elseif (!!ce.type.eq('GMSE')) then
-- ==============================================================================================

!form.gmse.setRefs(!!ce,!form.gmrefList)
!form.currentGadget   = !form.gmrefList

-- ==============================================================================================
elseif (!!ce.type.eq('GMSS')) then
-- ==============================================================================================

!form.gmss.setRefs(!!ce,!form.gstrefList)
!form.currentGadget   = !form.gstrefList

-- ==============================================================================================
elseif (!!ce.type.eq('NGMS')) then
-- ==============================================================================================

!form.ngms.setRefs(!!ce,!form.ngmrefList)
!form.currentGadget   = !form.ngmrefList

-- ==============================================================================================
elseif (!!ce.type.eq('DTSE')) then
-- ==============================================================================================

!form.dtse.setRefs(!!ce,!form.dtseList)
!form.dtse.listCallback(!form.dtseList, !form.dtse.table, 1)
!form.currentGadget   = !form.dtseList

-- ==============================================================================================
elseif (!!ce.type.eq('BTSE')) then
-- ==============================================================================================

!form.btse.setRefs(!!ce,!form.btseList)
!form.btse.listCallback(!form.btseList, !form.btse.table, 1)
!form.currentGadget   = !form.btseList

else

     !!alert.message('Code needed for ($!!ce.type) in catSetReferences function')

endif

-- Check to see if we have a selected row, and if not select the right one.
if (!form.cateTable.getselectedrows().empty()) then
    !form.cateTable.selectRow(1)
endif

-- ====================================
-- Now set the right frame to be shown.
-- ====================================

    !form.refData.setFrame(!!ce.type,!form)

 -- Restore tracking

!!catModifyAttribs.track.val = !modifyAttributesTrack
!form.trackCE.val = !formTrack

endfunction
