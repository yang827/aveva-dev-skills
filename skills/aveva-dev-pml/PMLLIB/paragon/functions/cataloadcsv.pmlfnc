--
-- Description:
-- Display and initialise catalogue import form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Method to call after importing the data
--    2   R      DBREF       Element to use as template for new elements
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!cataLoadCsv(!callback is STRING, !sourceElement is DBREF)

-- Initialise Variables
  if(not defined(!!spreadsheetImport)) then
    pml reload form !!spreadsheetImport
  endif

  -- Configure the form to process catalogue data
  !!spreadsheetImport.setDataHandler( object CATALOADER(!sourceElement))

  -- Set the callback to evaluate after a successful import
  !!spreadsheetImport.setImportCallback(!callback)

  -- start with the file open dialogue
  !!spreadsheetImport.browse()

endfunction
-- End of function definition
