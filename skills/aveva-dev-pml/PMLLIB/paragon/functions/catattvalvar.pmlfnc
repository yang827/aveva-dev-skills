--
-- File:            catattvalvar.pmlfnc
--   Type:          Function
--   Group:         General
--     Keyword:     PARAGON
--   Module:        Paragon
--   Replaces:      None
--
-- Author:          D.Kettle
-- Created:         Thu Mar 22 14:00:00 GMT 2007
--
-- Description:
-- Check if attribute values are the same or different for an array of objects,
-- used for populating UI attribute fields for multiple object selections.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       List of objects to check
--    2   R      ARRAY       List of attribute names to check
-- Return:
--   [Data Type] [Description]
--    ARRAY       Value of attribute if it is the same for all objects,
--                or the string '<Multiple Values>' if the value is not the same for
--                all objects.
--
------------------------------------------------------------------------
define function !!catattvalvar(!refList is ARRAY, !attList is ARRAY) is ARRAY

  -- Check for empty lists
  if (!refList.Empty()) then
    return error 1 |Reference list is empty in function !!catattvalvar()|
  elseif(!attList.Empty()) then
    return error 1 |Attribute list is empty in function !!catattvalvar()|
  endif

  -- Initialise variables
  !varyStr = |<Multiple Values>|
  !retVals = object ARRAY()

  -- Loop through attribute names
  do !aInd indices !attList

    -- Loop through ref list to get attribute values
    !attVals = object ARRAY()
    do !rInd indices !refList
      -- Append attribute value to array for attribute name
      -- Array type attribute
      if (!attList[!aInd].matchwild(|*[*]|) eq true) then
        !attName = !attList[!aInd].before(|[|)
        !attIndex = !attList[!aInd].after(|[|).before(|]|).real()
        !attVals.append(!refList[!rInd].attribute(!attName)[!attIndex])
        handle (2,805)(2,766)
          return error 1 |$!attList[$!aInd] is not a valid attribute for a $!refList[$!rInd].type in function !!catattvalvar()|
        endhandle
      -- Non array type attributes
      else
        !attVals.append(!refList[!rInd].attribute(!attList[!aInd]))
        handle (2,805)(2,766)
          return error 1 |$!attList[$!aInd] is not a valid attribute for a $!refList[$!rInd].type in function !!catattvalvar()|
        endhandle
      endif
    enddo

    -- Check for differences and assign value accordingly
    !attVals.unique()
    if (!attVals.size() ne 1) then
    -- Must be differences
      !retVals.append(!varyStr)
    else
    -- Must be the same
      !retVals.append(!attVals[1])
    endif

  enddo

  return !retVals

endfunction
-- End of function definition for !!catattvalvar( ARRAY, ARRAY) ARRAY
