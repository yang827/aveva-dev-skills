--
-- Description:
-- Setup catCreate form to create Paragon elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of element to be created
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!catCreate(!type is STRING)

  if (!type eq 'ROOM DESIGN') then
    !!catRoomDesign = TRUE
  else
    !!catRoomDesign = FALSE
  endif

  if (undefined(!!catCreate)) then
    pml load form !!catCreate
  endif

       !!catCreate.setup(!type.upcase())
  show !!catCreate at xr .2 yr .2

endfunction
-- End of function definition for !!catCreate(STRING)
