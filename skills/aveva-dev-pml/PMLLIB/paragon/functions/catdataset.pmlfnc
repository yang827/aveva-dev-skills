-- Author:          S.Bentley
-- Created:         Wed Nov  23 13:39:27 "GMT 2002
--
--
-- Description:
-- Specific function to create / modify dataset and data elements
--
-- Invokes parameter list form.
-- Arguments: <createFlag>
--   1 - Create flag
-- Global Arguments: None
-- Returns: None
--
------------------------------------------------------------------------
define function !!catDataSet(!createFlag is BOOLEAN)

  -- Initialise Variables
  !refe = !!ce

  -- Create a dataset if required and record its reference
  if(!createFlag) then
    -- Create DTSE
    NEW DTSE
    handle ANY
      !!alert.error(!!error.text)
      return
    endhandle
    !dtse = !!ce
  else
    -- If we are modifying then navigate to the dataset
    DTSE
    handle ANY
      -- See if there is a dtref we could use
      !dtref = !!ce.dtref
      handle ANY
        !!alert.error('Not a Dataset element')
        -- Navigate back to original item
        !!ce = !refe
        return
      elsehandle NONE
        if (!dtref.badref()) then
          !!alert.error('Not a Dataset element')
          -- Navigate back to original item
          !!ce = !refe
          return
        else
          !dtse = !dtref
        endif
      endhandle
    elsehandle NONE
      !dtse = !!ce
    endhandle
  endif

  -- Define the form and form member
  if (defined(!!catDataSet)) then
    -- Set user data
   !!catDataSet.dataSet = !dtse
  else
    pml load form !!catDataSet
    -- Set user data
   !!catDataSet.dataSet = !dtse
  endif

  -- initialise the form for this dataset
  if (!!catDataSet.shown().not()) then
    show !!catDataSet
  else
   !!catDataSet.init('', '')
  endif

  -- Navigate back to original item
  !!ce = !refe

  return

endfunction
-- End of function definition for !!catDataSet(BOOLEAN)
