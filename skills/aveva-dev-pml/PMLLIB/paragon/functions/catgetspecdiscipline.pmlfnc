--
--  Description:
--  Work out discipline for the supplied specification
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Specification to get discipline for
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Discipline data
--                [1] Discipline identifier
--                [2] Main discipline display text
--                [3] Sub-discipline display text
--
------------------------------------------------------------------------
define function !!catgetspecdiscipline(!specification is DBREF) is ARRAY

  -- Define multi-purpose discipline strings
  !piping        = 'PIPING INSU TRACING BOLT'
  !hAndS         = 'HANG HCFG HMML HCLR SSTL SCFG HSPT'
  !asl           = 'ASL ASLF HAND'
  !penetrations  = 'PENI PENH'
  !identifier    = 'UNKNOWN'
  !discipline    = 'Unknown'
  !subDiscipline = 'Unknown'

  -- Check for Limbospecs
  if (!specification.question eq 'LIMB') then
    !identifier = '*LIMBOSPEC'
    !discipline = '*Limbospec'
    !subDiscipline = '*Limbospec'

  -- Test for known discipline purposes
  --elseif (!specification.purpose eq 'PIPI') then
  --  !identifier = 'PIPING'
  --  !discipline = 'Piping'
  --  !subDiscipline = 'Piping'

  -- Test for known discipline purposes
  --elseif (!specification.purpose eq 'PIPE') then
  --  !identifier = 'PIPING'
  --  !discipline = 'Piping'
  --  !subDiscipline = 'Piping'

  --elseif (!specification.purpose eq 'INSU') then
  --  !identifier = 'PIPING'
  --  !discipline = 'Piping'
  --  !subDiscipline = 'Insulation'

  elseif (!specification.purpose eq 'EQUI') then
    !identifier = 'EQUI'
    !discipline = 'Equipment'
    !subDiscipline = 'Equipment'

  elseif (!specification.purpose eq 'SUBE') then
    !identifier = 'EQUI'
    !discipline = 'Equipment'
    !subDiscipline = 'Sub-Equipment'

  elseif (!specification.purpose eq 'ESPT') then
    !identifier = 'EQUI'
    !discipline = 'Equipment'
    !subDiscipline = 'Equipment supports'

  elseif (!specification.purpose eq 'NOZZ') then
    !identifier = 'EQUI'
    !discipline = 'Equipment'
    !subDiscipline = 'Nozzles'

  elseif (!specification.purpose eq 'STL') then
    !identifier = 'STL'
    !discipline = 'Structures'
    !subDiscipline = 'Profiles'

  elseif (!specification.purpose eq 'PLT') then
    !identifier = 'STL'
    !discipline = 'Structures'
    !subDiscipline = 'Panels & Plates'

  elseif (!specification.purpose eq 'PFIT') then
    !identifier = 'STL'
    !discipline = 'Structures'
    !subDiscipline = 'Panel Fittings'

  elseif (!specification.purpose eq 'JOIN') then
    !identifier = 'STL'
    !discipline = 'Structures'
    !subDiscipline = 'Joints'

  elseif (!specification.purpose eq 'HVAC') then
    !identifier = 'HVAC'
    !discipline = 'HVAC'
    !subDiscipline = 'HVAC'

  -- FITT is used for structures and HVAC
  elseif (!specification.purpose eq 'FITT') then
    if (!specification.namn.substring(1,8) inset ('CADCHVAC','AVEVAHVA')) then
      !identifier = 'HVAC'
      !discipline = 'HVAC'
      !subDiscipline = 'HVAC Fittings'
    else
      !identifier = 'STL'
      !discipline = 'Structures'
      !subDiscipline = 'Fittings'
    endif

  elseif (!specification.purpose eq 'SBFI') then
    !identifier = 'STL'
    !discipline = 'Structures'
    !subDiscipline = 'Sub-Fittings'

  elseif (!specification.purpose eq 'WALL') then
    !identifier = 'STL'
    !discipline = 'Structures'
    !subDiscipline = 'Walls'

  elseif (!specification.purpose eq 'FLR') then
    !identifier = 'STL'
    !discipline = 'Structures'
    !subDiscipline = 'Floors/Screeds'

  elseif (!specification.purpose eq 'WFIT') then
    !identifier = 'STL'
    !discipline = 'Structures'
    !subDiscipline = 'Wall Fittings'

  elseif (!specification.purpose eq 'FFIT') then
    !identifier = 'STL'
    !discipline = 'Structures'
    !subDiscipline = 'Floor Fitting'

  elseif (!asl.occurs(!specification.purpose) gt 0) then
    !identifier = 'STL'
    !discipline = 'Structures'
    !subDiscipline = 'Access Stairs & Ladders'

  elseif (!hAndS.occurs(!specification.purpose) gt 0) then
    !identifier = 'STL'
    !discipline = 'Structures'
    !subDiscipline = 'Hangers & Supports'

  elseif (!penetrations.occurs(!specification.purpose) gt 0) then
    !identifier = 'STL'
    !discipline = 'Structures'
    !subDiscipline = 'Penetrations'

  elseif (!specification.evaluate(object BLOCK(|MCOUNT TEXT|)) ne 0) then
    -- Purpose must be unset or empty so try TEXT 1 member of spec
    !stext = !specification.evaluate(object BLOCK(|STEXT OF TEXT 1|))
    if (!stext.unset().not() and !stext.empty().not()) then
      -- Check for piping discipline
      if (!stext.upcase() eq 'PIPING') then
        !identifier = 'PIPING'
        !discipline =  'Piping'
        !subDiscipline = 'Piping'
      elseif (!stext.upcase().substring(1,4) eq 'INSU') then
        !identifier = 'INSU'
        !discipline =  'Piping'
        !subDiscipline = 'Insulation'
      elseif (!stext.upcase() eq 'TRACING') then
        !identifier = 'TRACING'
        !discipline =  'Piping'
        !subDiscipline = 'Tracing'
      elseif (!stext.upcase() eq 'BOLT') then
        !identifier = 'BOLT'
        !discipline =  'Piping'
        !subDiscipline = 'Bolting'
      elseif (!stext.upcase() eq 'TRAY') then
        !identifier = 'TRAY'
        !discipline =  'Electrical'
        !subDiscipline =  'Cable Trays'
      elseif (!stext.upcase() eq 'HVAC') then
        !identifier = 'HVAC'
        !discipline =  'HVAC'
        !subDiscipline =  'HVAC'
      elseif (!stext.upcase() eq 'HANG') then
        !identifier = 'STL'
        !discipline =  'Structures'
        !subDiscipline =  'Hangers & Supports'
      else
        !identifier = 'UNKNOWN'
        !discipline =  'Unknown'
        !subDiscipline = !stext
      endif
    endif

    -- Convert stexts containing the string HVAC or DUCTWORK to 'HVAC'
    if (!subDiscipline.occurs('HVAC') gt 0 or !subDiscipline.upcase().occurs('DUCTWORK') gt 0) then
      !identifier = 'HVAC'
      !discipline = 'HVAC'
      !subDiscipline = 'HVAC'
    endif

  -- Test for unknown purposes
  elseif (!specification.purpose.set() and !specification.purpose.empty().not()) then
    !identifier = 'UNKNOWN'
    !discipline = 'Unknown'
    !subDiscipline = !specification.purpose

  else
    -- No discipline set
    !identifier = 'UNKNOWN'
    !discipline = 'Unknown'
    !subDiscipline = 'Unknown'
  endif

  !returnArray[1] = !identifier
  !returnArray[2] = !discipline
  !returnArray[3] = !subDiscipline

  return !returnArray

endfunction
-- End of function definition for !!catgetspecdiscipline
