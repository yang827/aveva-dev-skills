--
-- Description:
-- Setup catModifyAttribs form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!catModifyAttribs()

  -- Force reinitialisation of form
  if (defined(!!catModifyAttribs)) then
    if (!!catModifyAttribs.shown()) then
      hide !!catModifyAttribs
    endif
  endif
  show !!catModifyAttribs

endfunction
-- End of function definition for !!catModifyAttribs()
