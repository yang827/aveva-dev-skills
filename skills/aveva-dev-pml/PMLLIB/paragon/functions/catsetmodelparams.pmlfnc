define function !!catSetModelParams(!element is DBREF)
-------------------------------------------------------------------------------------------------------

-- Load model parameters based on information held at DATASET if required.
-- Should be one or two attributes set under purpose to say where the reference is placed.

-- Set the catalogue parameters.
   do !i index !element.param

   	  MODEL SET CATA PARAM $!i $!element.param[$!i]
   	  handle any
   	    -- MODEL SET CATA PARAM $!i $!element.param[$!i]
   	  endhandle

   enddo

-- Check the model settings form to see whether other parameters should be updated
   if ( defined (!!cdtModSet) and !!cdtModSet.onlyUpdateParas.val eq true) then
     return
   endif

-- Set default Insulation Parameter
   MODEL SET IPARAM 1 50
   handle any
   endhandle

-- Check stored DATAset parameters.
if (badref(!element.dtref)) then
	  return
endif

do !data value !element.dtref.mem
   if (!data.purpose.eq('ATTA') or !data.purpose.eq('OWNE') or !data.purpose.eq('DESI') or !data.purpose.eq('IPAR')) then

         -- The third entry in the split list is the id reference we need to capture the params from.
         if !data.purpose.eq('DESI').not() then
            !param = !data.dpro.split()[3].dbref().param
            handle any
              write 'Error - Bad parameter reference: Cannot set model parameters'
              return
            endhandle
         endif

         if (!data.purpose.eq('ATTA')) then

            do !i index !param
               MODEL SET APARAM $!i $!param[$!i]
                 handle any
                     write 'Error - MODEL SET APARAM $!i $!param[$!i]'
                 endhandle
            enddo

         elseif (!data.purpose.eq('OWNE')) then

            do !i index !param
               MODEL SET OPARAM $!i $!param[$!i]
                 handle any
                     write 'Error - MODEL SET OPARAM $!i $!param[$!i]'
                 endhandle
            enddo

         elseif (!data.purpose.eq('DOWN')) then

            do !i index !param
               MODEL SET DESI OPARAM $!i $!param[$!i]
                 handle any
                 write 'Error - MODEL SET DESI OPARAM $!i $!param[$!i]'
                 endhandle
            enddo

         elseif (!data.purpose.eq('DATT')) then

            do !i index !param
               MODEL SET DESI APARAM $!i $!param[$!i]
                 handle any
                 write 'Error - MODEL SET DESI APARAM $!i $!param[$!i]'
                 endhandle
            enddo

         elseif (!data.purpose.eq('IPAR')) then

               !num = !data.numb
               !val = !data.dpro
               var !val ( $!val )
               MODEL SET IPARAM $!num $!val
                 handle any
                 write 'Error - MODEL SET IPARAM $!num $!val'
                 endhandle

         else
               !num = !data.numb
               !val = !data.dpro
               var !val ( $!val )
               MODEL SET DESIGN PARAM $!num $!val
                 handle any
                 write 'Error - MODEL SET DESIGN $!num $!val'
                 endhandle
         endif

   elseif (!data.purpose.eq('DESP')) then
   -- Handle case where we have set design parameters from dpro values.
               !num   = !data.numb
               !val   = !element.fprde.attribute(!data.dKey)
               handle any
                 !val = !data.dpro
                 var !val ( $!val )
                 handle (2,201)
                    return
                 endhandle
                 if (!val.eq('')) then
                     return
                 endif
               endhandle

               -- Skip if the default property is not set
               skip if (!val.unset())

               MODEL SET DESIGN PARAM $!num $!val
               handle (16,13)
                 -- Despar error, likely zero value.
                 !!alert.message(!!error.text & ' DESPAR = ' & !num )
               elsehandle (47,62)
                 -- Check Val here for additional units information.
                 !realValue          = !val.real()
                 !stringValueNoUnits = !realValue.string()
                 MODEL SET DESIGN PARAM $!num $!stringValueNoUnits
                 handle any
                   write 'Error - MODEL SET DESIGN PARAM $!num $!stringValueNoUnits'
                 endhandle
               elsehandle any
                 write 'Error - MODEL SET DESIGN PARAM $!num $!val'

               endhandle
   endif

   -- If !val is defined, delete it so that it can be safely reused
   if (defined(!val)) then
     !val.delete()
   endif

enddo

endfunction
