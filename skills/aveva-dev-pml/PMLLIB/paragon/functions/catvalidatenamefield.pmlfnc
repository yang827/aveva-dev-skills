--  File:            catvalidatenamefield.pmlfnc
--    Type:          Function Definition
--    Group:         Undefined
--      Keyword:     Undefined
--    Module:        Paragon
--  Author:          D. Kettle
--  Created:         Tue Jul 31 15:17:43 2007
--
--  Description:     Validate a new name entered into a name text gadget
--
----------------------------------------------------------------------
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Text gadget to be checked
-- Return:
--   [Data Type] [Description]
--    STRING      Unset = cleared by user, empty = invalid name, string = validated name
--
------------------------------------------------------------------------
define function !!catValidateNameField(!object is GADGET) is STRING

  -- Get name from text gadget
  if (!object.val.set()) then
    !enteredName = !object.val.trim()
  else
    !enteredName = ''
  endif

  -- Check for text field cleared by user
  if (!enteredName.empty()) then
    !object.clear()
    return object STRING()
  endif

  -- Check for valid name
  !name = !!checkName(!enteredName, |NEW|)

  -- CheckName error
  if (!name.unset()) then
    !object.clear()
    return ''

  -- Entered name is invalid
  elseif (!enteredName.substring(1,1) eq '=') then
    !object.clear()
    !!alert.warning(|First character in name must not be '='|)
    return ''

  -- Entered name is ok so accept it
  else
    !object.val = !name.after('/')
    return !name

  endif

endfunction
-- End of function definition for !!catValidateNameField(GADGET)STRING
