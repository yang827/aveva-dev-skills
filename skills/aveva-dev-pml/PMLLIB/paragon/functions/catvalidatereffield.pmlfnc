--
--  Description:
--  Validate that the reference entered into a text gadget is an existing
--  element of the specified type(s)
--
----------------------------------------------------------------------
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Text gadget to be checked
--    2   R      STRING      Allowed element types for the reference
-- Return:
--   [Data Type] [Description]
--    STRING      Unset = cleared by user, empty = invalid ref, string = validated ref
--
------------------------------------------------------------------------
define function !!catValidateRefField(!object is GADGET, !types is STRING) is STRING

  -- Get owning form
  !form = !object.owner()

  -- Check for text field cleared by user
  if (!object.val.unset() or !object.val.empty()) then
    !object.clear()
    return object STRING()
  else
    !enteredName = !object.val.trim()
  endif

  -- Check if first character is a '/' or '='
  if (!enteredName.substring(1,1) inset('/', '=')) then
    !name = !enteredName
  else
    !name = '/' & !enteredName
  endif

  -- Check for valid name
  !dbRef = !name.dbref()
  handle any
    -- Name is invalid
    !!alert.warning(|Invalid reference name!|)
    !object.clear()
    return ''
  elsehandle none
    -- Check for nulref ('=0' or '=0/0' entered into text field)
    if (!dbref.unset()) then
      !object.clear()
      return object STRING()
    -- Check for correct element type
    elseif (!types.occurs(!dbRef.type) eq 0) then
      !!alert.warning(|Specified reference is not the correct type, a $!<types> reference is required!|)
      !object.clear()
      return ''
    -- Name is ok
    else
      !object.val = !dbref.namn
      return !dbref.name
    endif

  endhandle

endfunction
-- End of function definition for !!catValidateRefField(GADGET, STRING)STRING
