-- Description:
-- Invocation for standard creCataElements form.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]    [Description]
--     1   R      STRING        Element Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!creCataElements(!elementType is STRING)

  -- creCataElements form has been loaded

    pml reload form !!creCataElements

    !!creCataElements.elementType = !elementType

    !!creCataElements.formtitle       = 'Create' & ' ' & !elementType

    show !!creCataElements

endfunction
-- End of function definition for creCataElements
