-- Define function
define function !!creCocoElements(!mode is STRING)

    if(!!ce.type neq 'CCTA' and !!ce.type neq 'COCO') then
      !!alert.error ( 'Run this from COCO Table')
      return
    endif

  --creCocoElements form has been loaded

    pml reload form !!creCocoElements
    !!creCocoElements.setMode = !mode
    !!creCocoElements.currentElement = ce
    show !!creCocoElements

endfunction
-- End of function definition for creCocoElements
