-- Define function
define function !!creNominBoreElements(!mode is STRING)

    if(!!ce.type neq 'NBRWLD' and !!ce.type neq 'NOMINB') then
      !!alert.error ('Run this from NBRWLD or NOMINB')
      return
    endif

  -- creNominBoreElements form has been loaded

    pml reload form !!creNominBoreElements
    !!creNominBoreElements.setMode = !mode
    !!creNominBoreElements.currentElement = ce
    show !!creNominBoreElements

endfunction
-- End of function definition for creNominBoreElements
