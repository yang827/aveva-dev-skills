--
-- Description:
--   Upgrades the Standard Steel Catalogue Pline sets to include
--   additional Pline for Center of Geometry.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--  Description:     Undefined
--
