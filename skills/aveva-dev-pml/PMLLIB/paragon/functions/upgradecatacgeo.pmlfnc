define function !!upgradeCataCGEO()
  -- Used for storing grid layout XML file
  !pdmsUser = !!evarSplit('PDMSUSER')
  !logFile = !pdmsUser[1] & '\upgradeCataCGEO.log'
  !plUpgrade = object CGEOCATAUPGRADE(!logFile)
  !plUpgrade.startUpgrade()
  --$p left in as user needs to know where to find info later
  --$p Log file created at $!logFile
endfunction
