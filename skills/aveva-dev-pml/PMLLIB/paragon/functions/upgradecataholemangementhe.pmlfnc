--  File:            upgradecataholemangementhe.pmlfnc
--  Author:          M.Barlow
--  Created:         14/10/2015
--
--  Description: Add elliptical HE type hole to the hole management catalogue, with preserved references
--
------------------------------------------------------------------------
define function !!upgradeCataHoleMangementHE()

  !test = object DBREF('/HM-FIXI/TYPE-HE')
  handle (2,109)
    -- this error should occur if the project needs to be updated
  elsehandle none
    !!alert.error('The elliptical HE hole type is already loaded in this project')
    return
  endhandle

  -- HE is added after HO type hole
  !test = object DBREF('/HM-FIXI/TYPE-HO')
  handle (2,109)
    -- this error occurs if the hole management catalogue is not found
    !!alert.error('Hole management catalogue not found in this project. (HO type hole not found)')
    return
  endhandle

  !result = !!alert.confirm('OK to load hole management HE type hole into the catalogue?')
  if( !result neq 'YES' ) then
    !!alert.message('Addition of HE hole type to the catalogue has been aborted')
    return
  endif

  -- =====================================================================================
  -- load HE hole type catalogue data

  -- =15193/63058 is /HM-FIXI/TYPE-HO
OLD =15193/63058
END
NEW STCATEGORY /HM-FIXI/TYPE-HE REF =15193/70588

OLD =15193/70588
