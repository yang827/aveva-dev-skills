--
--
-- Description:     Add-in object for Paragon Room Design application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  barMenu()                        -                   Adds options to the bar menu for this application
--  createMenu()                     -                   Adds options to the Create menu
--  deleteMenu()                     -                   Adds options to the Delete menu
--  displayMenu()                    -                   Adds options to the Display menu
--  graphMenu()                      -                   Adds options to the Graphics menu
--  menus()                          -                   Creates menus for this application
--  modifyForm()                     -                   Makes modifications to the main form
--  modifyMenu()                     -                   Adds options to the Modify menu
--  modifyMenus()                    -                   Runs all other menu creation methods
--  queryMenu()                      -                   Adds options to the Query menu
--  settingsMenu()                   -                   Adds options to the Settings menu
--  toolbars()                       -                   Creates toolbars for this application
--  utilsMenu()                      -                   Adds options to the Utilities menu
--
------------------------------------------------------------------------
define object APPCATACCO
endobject
-- End of object definition for APPCATACCO

------------------------------------------------------------------------
--
-- Method:      .modifyForm()
--
-- Description: Makes modifications to the main form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()
  !this.toolbars()
endmethod
-- End of method definition for .modifyForm()

------------------------------------------------------------------------
--
-- Method:      .barMenu()
--
-- Description: Adds options to the bar menu for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .barMenu()
--   !bmenu = object APPBARMENU()
--   !!appMenuCntrl.addBarMenu('ACCO', !bmenu)
endmethod
-- End of method definition for .barMenu()

------------------------------------------------------------------------
--
-- Method:      .displayMenu()
--
-- Description: Adds options to the Display menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayMenu()
  !menu = object APPMENU('sysView')
  !!appMenuCntrl.addMenu(!menu, 'ACCO')
endmethod
-- End of method definition for .displayMenu()

------------------------------------------------------------------------
--
-- Method:      .graphMenu()
--
-- Description: Adds options to the Graphics menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .graphMenu()
  !menu = object APPMENU('none')
  !!appMenuCntrl.addMenu(!menu, 'ACCO')
endmethod
-- End of method definition for .graphMenu()

------------------------------------------------------------------------
--
-- Method:      .queryMenu()
--
-- Description: Adds options to the Query menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .queryMenu()
  !menu = object APPMENU('sysQry')
  !!appMenuCntrl.addMenu(!menu, 'ACCO')
endmethod
-- End of method definition for .queryMenu()

------------------------------------------------------------------------
--
-- Method:      .settingsMenu()
--
-- Description: Adds options to the Settings menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .settingsMenu()
  !menu = object APPMENU('sysSet')
  !!appMenuCntrl.addMenu(!menu, 'ACCO')
endmethod
-- End of method definition for .settingsMenu()

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('sysUtil')
  !menu.add(|SEPARATOR|)
  !menu.add('FORM', 'Convert Spec...', 'convertSpec', 'ConvertSpecACCO')
  !!appMenuCntrl.addMenu(!menu, 'ACCO')
endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .createMenu()
--
-- Description: Adds options to the Create menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createMenu()

  !menu = object APPMENU('sysCrt')
  !menu.add(|SEPARATOR|)
  !menu.add('CALLBACK', |Catalogue...|, |!!catCreate('CATA')|, 'AccoCatalogue')
  !menu.add('CALLBACK', |Section...|,   |!!catCreate('STSE ROOM')|, 'AccoSectionSTSE')
  !menu.add('CALLBACK', |Category for Room Design...|, |!!catCreate('ROOM DESIGN')|, 'AccoCrCate')
  !menu.add('SEPARATOR')
  !menu.add(|MENU|, |Selection Table|, |ACCOCRSELTAB|, |AccoSelTab|)
  !menu.add(|MENU|, |Part|,            |ACCOCRPART|,   |AccoPart|)
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Text...|, |CALLCT XCRTEXT CREATE|, 'AccoCrText')
  !menu.add('CALLBACK', |Draft Symbol Set...|, |!!catCreate('DRSSET')|, 'AccoCrDrsset')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Properties...', 'propCon', 'AccoCrPropCon')
  !!appMenuCntrl.addMenu(!menu, 'ACCO')

endmethod
-- End of method definition for .createMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenu()
--
-- Description: Adds options to the Modify menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenu()

  !menu = object APPMENU('sysMod')
  !menu.add(|SEPARATOR|)
  !menu.add(|CALLBACK|, |Selection Table Group...|, |!!catSelTabViews.add()|, |AccMoSelTab|)
  !menu.add('CALLBACK', |Part Family...|,     |!!catPartViews.add()|,   |AccoMoPartFamily|)
  !menu.add('CALLBACK', |Category...|,        |!!catModelViews.add()|,  |AccoMoCategoryCATE|)
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Text...|, |CALLCT XCRTEXT MODIFY|, 'AccoMoText')
  !menu.add('FORM', |Draft Symbol Set...|, |catDrsset|, 'AccoMoDrsset')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Properties...', 'propCon', 'AccoMoPropCon')
  !!appMenuCntrl.addMenu(!menu, 'ACCO')

endmethod
-- End of method definition for .modifyMenu()

------------------------------------------------------------------------
--
-- Method:      .deleteMenu()
--
-- Description: Adds options to the Delete menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteMenu()
  !menu = object APPMENU('sysDel')
  !!appMenuCntrl.addMenu(!menu, 'ACCO')
endmethod
-- End of method definition for .deleteMenu()

------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()
endmethod
-- End of method definition for .toolbars()

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()

  !menu = object APPMENU('ACCOCRSELTAB')
  !menu.add('CALLBACK', 'World...',  |!!catCreate('SPWL')|,   'AccoCrStSpwl')
  !menu.add('CALLBACK', 'Table...',  |!!catCreate('TABGRO')|, 'AccoCrStTable')
  !!appMenuCntrl.addMenu(!menu, 'ACCO')

  !menu = object APPMENU('ACCOCRPART')
  !menu.add('CALLBACK', |World...|,     |!!catCreate('PRTWLD ACCO')|, 'AccoCrPartWorld')
  !menu.add('CALLBACK', |Hierarchy...|, |!!catCreate('PRTELE HIER')|, 'AccoCrPartHier')
  !menu.add('CALLBACK', |Family...|,    |!!catCreate('PRTELE ACCO')|, 'AccoCrPartFamily')
  !!appMenuCntrl.addMenu(!menu, 'ACCO')

endmethod
-- End of method definition for .menus()


------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.createMenu()
  !this.modifyMenu()
  !this.deleteMenu()
  !this.menus()
endmethod
-- End of method definition for .modifyMenus()
