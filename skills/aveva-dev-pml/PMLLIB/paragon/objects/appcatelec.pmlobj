------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()

  -- Create Category
  !menu = object APPMENU('ELECCOMPTMPL')
  !menu.add('CALLBACK', |for Cable Tray...|,                |!!catCreate('CATE TRAY')|, 'forComponent')
  !menu.add('CALLBACK', |for Cable Cores...|,               |!!catCreate('CATE CORE')|, 'forCores')
  !menu.add('CALLBACK', |for Cable Node Representation...|, |!!catCreate('CATE REPR')|, 'forCoreRepre')
  !!appMenuCntrl.addMenu(!menu, 'ELEC')

  !menu = object APPMENU('ELECCRSELTAB')
  !menu.add('CALLBACK', 'World...',  |!!catCreate('SPWL')|,   'ElecCrStSpwl')
  !menu.add('CALLBACK', 'Table...',  |!!catCreate('TABGRO')|, 'ElecCrStTable')
  !!appMenuCntrl.addMenu(!menu, 'ELEC')

  !menu = object APPMENU('ELECCRPART')
  !menu.add('CALLBACK', |World...|,     |!!catCreate('PRTWLD ELEC')|, 'ElecCrPartWorld')
  !menu.add('CALLBACK', |Hierarchy...|, |!!catCreate('PRTELE HIER')|, 'ElecCrPartHier')
  !menu.add('CALLBACK', |Family...|,    |!!catCreate('PRTELE ELEC')|, 'ElecCrPartFamily')
  !!appMenuCntrl.addMenu(!menu, 'ELEC')

   !menu = object APPMENU('COMPAREUPDATE')
   !menu.add('CALLBACK', |Open|, '', 'Compare / Update')
   !menu.add('CALLBACK', |Compare CE|, '', 'Compare CE')
    !!appMenuCntrl.addMenu(!menu, 'ELEC')

endmethod
-- End of method definition for .menus()


------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.createMenu()
  !this.modifyMenu()
  !this.deleteMenu()
  !this.menus()
endmethod
-- End of method definition for .modifyMenus()
