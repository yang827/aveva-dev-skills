------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('sysUtil')
  !menu.add(|SEPARATOR|)
  !menu.add('FORM', 'Convert Spec...', 'convertSpec', 'ConvertSpecELEC')
  !menu.add(|SEPARATOR|)
  --!menu.add('TOGGLE', 'Compare / Update', '', 'Compare / Update')
   !menu.add('MENU', |Compare / Update|, |COMPAREUPDATE|, |CompareUpdate|)
  !!appMenuCntrl.addMenu(!menu, 'ELEC')
endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .createMenu()
--
-- Description: Adds options to the Create menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createMenu()

  !menu = object APPMENU('sysCrt')
  !menu.add(|SEPARATOR|)
  !menu.add('CALLBACK', |Catalogue...|, |!!catCreate('CATA')|, 'ElecCatalogue')
  !menu.add('CALLBACK', |Section...|,   |!!catCreate('SECT')|, 'ElecSectionSECT')
  !menu.add('MENU', |Category|, 'ELECCOMPTMPL', 'ElecCategoryCate')
--  !menu.add('CALLBACK', |Category...|,  |!!catCreate('CATE SCOM')|, 'ElecCrCate')
  !menu.add('SEPARATOR')
  !menu.add(|MENU|, |Selection Table|, |ELECCRSELTAB|, |ElecSelTab|)
  !menu.add(|MENU|, |Part|,            |ELECCRPART|,   |ElecPart|)
  !menu.add('CALLBACK', |Detail Text...|, |CALLCT XCRDTEX CREATE|, 'ElecCrDetailText')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Text...|, |CALLCT XCRTEXT CREATE|, 'ElecCrText')
  !menu.add('CALLBACK', |Draft Symbol Set...|, |!!catCreate('DRSSET')|, 'ElecCrDrsset')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Properties...', 'propCon', 'ElecCrPropCon')
  !!appMenuCntrl.addMenu(!menu, 'ELEC')

endmethod
-- End of method definition for .createMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenu()
--
-- Description: Adds options to the Modify menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenu()

  !menu = object APPMENU('sysMod')
  !menu.add(|SEPARATOR|)
  !menu.add(|CALLBACK|, |Selection Table Group...|, |!!catSelTabViews.add()|, |ElecMoSelTab|)
  !menu.add('CALLBACK', |Part Family...|,     |!!catPartViews.add()|,   |ElecMoPartFamily|)
  !menu.add('CALLBACK', |Category...|,        |!!catModelViews.add()|,  |ElecMoCategoryCATE|)
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Text...|, |CALLCT XCRTEXT MODIFY|, 'ElecMoText')
  !menu.add('CALLBACK', |Detail Text...|, |CALLCT XCRDTEX MODIFY|, 'ElecMoDetailText')
  !menu.add('FORM', |Draft Symbol Set...|, |catDrsset|, 'ElecMoDrsset')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Properties...', 'propCon', 'ElecMoPropCon')
  !!appMenuCntrl.addMenu(!menu, 'ELEC')

endmethod
-- End of method definition for .modifyMenu()

------------------------------------------------------------------------
