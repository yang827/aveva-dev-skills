------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('sysUtil')
  !menu.add(|SEPARATOR|)
  !menu.add('FORM', 'Convert Spec...', 'convertSpec', 'ConvertSpecEQUI')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')
endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .createMenu()
--
-- Description: Adds options to the Create menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createMenu()

  !menu = object APPMENU('sysCrt')
  !menu.add(|SEPARATOR|)
  !menu.add('CALLBACK', |Catalogue...|, |!!catCreate('CATA')|, 'EquiCatalogue')
  !menu.add('CALLBACK', |Section...|  , |!!catCreate('SECT')|, 'EquiSectionSECT')
  !menu.add('MENU', |Category|, 'EQUICOMPTMPL', 'EquiCategoryCate')
--  !menu.add('CALLBACK', |Category...|,  |!!catCreate('CATE SCOM')|, 'EquiCrCate')
--  !menu.add('CALLBACK', |Nozzle Spec...|, |CALLCSP XNOZZSPEC|, 'NozzleSpec')
  !menu.add('SEPARATOR')
  !menu.add(|MENU|, |Specification|, |EQUICRSPEC|, |EquiSpec|)
  !menu.add(|MENU|, |Selection Table|, |EQUICRSELTAB|, |EquiSelTab|)
  !menu.add(|MENU|, |Part|,            |EQUICRPART|,   |EquiPart|)
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Text...|, |CALLCT XCRTEXT CREATE|, 'EquiCrText')
  !menu.add('CALLBACK', |Draft Symbol Set...|, |!!catCreate('DRSSET')|, 'EquiCrDrsset')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Properties...', 'propCon', 'EquiCrPropCon')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

endmethod
-- End of method definition for .createMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenu()
--
-- Description: Adds options to the Modify menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenu()

  !menu = object APPMENU('sysMod')
  !menu.add(|SEPARATOR|)
  !menu.add('CALLBACK', |Specification...|, |!!catSpecViews.add()|, |PipeMoPipeSpec|)
  !menu.add(|CALLBACK|, |Selection Table Group...|, |!!catSelTabViews.add()|, |EquiMoSelTab|)
  !menu.add('CALLBACK', |Part Family...|,     |!!catPartViews.add()|,   |EquiMoPartFamily|)
  !menu.add('CALLBACK', |Category...|,        |!!catModelViews.add()|,  |EquiMoCategoryCATE|)
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Text...|, |CALLCT XCRTEXT MODIFY|, 'EquiMoText')
  !menu.add('FORM', |Draft Symbol Set...|, |catDrsset|, 'EquiMoDrsset')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Properties...', 'propCon', 'EquiMoPropCon')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

endmethod
-- End of method definition for .modifyMenu()

------------------------------------------------------------------------
