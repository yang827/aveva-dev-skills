------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()

  !menu = object APPMENU('EQUICRSPEC')
  !menu.add('CALLBACK', |World...|,         |!!catCreate('SPWL')|, 'PipeCrSpecWorld')
  !menu.add('CALLBACK', |Specification...|, |!!catCreate('SPEC')|, 'PipeCrPipeSpec')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

  -- Create Category
  !menu = object APPMENU('EQUICOMPTMPL')
  !menu.add('CALLBACK', |for Component...|, |!!catCreate('CATE SCOM')|, 'forComponent')
  !menu.add('CALLBACK', |for Templates...|, |!!catCreate('CATE TMPL')|, 'forTemplates')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

  !menu = object APPMENU('EQUICRSELTAB')
  !menu.add('CALLBACK', 'Spec World...',  |!!catCreate('SPWL')|,   'EquiCrStSpwl')
  !menu.add('CALLBACK', 'Table Group...',  |!!catCreate('TABGRO')|, 'EquiCrStTable')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

  !menu = object APPMENU('EQUICRPART')
  !menu.add('CALLBACK', |World...|,     |!!catCreate('PRTWLD EQUI')|, 'EquiCrPartWorld')
  !menu.add('CALLBACK', |Hierarchy...|, |!!catCreate('PRTELE HIER')|, 'EquiCrPartHier')
  !menu.add('CALLBACK', |Family...|,    |!!catCreate('PRTELE EQUI')|, 'EquiCrPartFamily')
  !!appMenuCntrl.addMenu(!menu, 'EQUI')

endmethod
-- End of method definition for .menus()


------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.createMenu()
  !this.modifyMenu()
  !this.deleteMenu()
  !this.menus()
endmethod
-- End of method definition for .modifyMenus()
