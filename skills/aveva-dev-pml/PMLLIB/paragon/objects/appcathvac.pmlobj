--
------------------------------------------------------------------------
define method .graphMenu()
  !menu = object APPMENU('none')
  !!appMenuCntrl.addMenu(!menu, 'HVAC')
endmethod
-- End of method definition for .graphMenu()

------------------------------------------------------------------------
--
-- Method:      .queryMenu()
--
-- Description: Adds options to the Query menu
--
