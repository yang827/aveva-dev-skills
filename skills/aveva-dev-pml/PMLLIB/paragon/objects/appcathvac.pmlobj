------------------------------------------------------------------------
define method .settingsMenu()
  !menu = object APPMENU('sysSet')
  !!appMenuCntrl.addMenu(!menu, 'HVAC')
endmethod
-- End of method definition for .settingsMenu()

------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('sysUtil')
  !menu.add(|SEPARATOR|)
  !menu.add('FORM', 'Convert Spec...', 'convertSpec', 'ConvertSpecHVAC')
  !!appMenuCntrl.addMenu(!menu, 'HVAC')
endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .createMenu()
--
-- Description: Adds options to the Create menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createMenu()

  !menu = object APPMENU('sysCrt')
  !menu.add(|SEPARATOR|)
  !menu.add('CALLBACK', |Catalogue...|, |!!catCreate('CATA')|, 'HvacCatalogue')
  !menu.add('CALLBACK', |Section...|,   |!!catCreate('SECT')|, 'HvacSectionSECT')
  !menu.add('CALLBACK', |Category...|,  |!!catCreate('CATE SCOM')|, 'HvacCrCate')
  !menu.add('SEPARATOR')
  !menu.add(|MENU|, |Selection Table|, |HVACCRSELTAB|, |HvacSelTab|)
  !menu.add(|MENU|, |Part|,            |HVACCRPART|,   |HvacPart|)
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Text...|, |CALLCT XCRTEXT CREATE|, 'HvacCrText')
  !menu.add('CALLBACK', |Detail Text...|, |CALLCT XCRDTEX CREATE|, 'HvacCrDetailText')
  !menu.add('CALLBACK', |Material Text...|, |CALLCT XCRMTEX CREATE|, 'HvacCrMaterialText')
  !menu.add('CALLBACK', |Draft Symbol Set...|, |!!catCreate('DRSSET')|, 'HvacCrDrsset')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Properties...', 'propCon', 'HvacCrPropCon')
  !!appMenuCntrl.addMenu(!menu, 'HVAC')

endmethod
-- End of method definition for .createMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenu()
--
-- Description: Adds options to the Modify menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenu()

  !menu = object APPMENU('sysMod')
  !menu.add(|SEPARATOR|)
  !menu.add(|CALLBACK|, |Selection Table Group...|, |!!catSelTabViews.add()|, |HvacMoSelTab|)
  !menu.add('CALLBACK', |Part Family...|,     |!!catPartViews.add()|,   |HvacMoPartFamily|)
  !menu.add('CALLBACK', |Category...|,        |!!catModelViews.add()|,  |HvacMoCategoryCATE|)
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Text...|, |CALLCT XCRTEXT MODIFY|, 'HvacMoText')
  !menu.add('CALLBACK', |Detail Text...|, |CALLCT XCRDTEX MODIFY|, 'HvacMoDetailText')
  !menu.add('CALLBACK', |Material Text...|, |CALLCT XCRMTEX MODIFY|, 'HvacMoMaterialText')
  !menu.add('FORM', |Draft Symbol Set...|, |catDrsset|, 'HvacMoDrsset')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Properties...', 'propCon', 'HvacMoPropCon')
  !!appMenuCntrl.addMenu(!menu, 'HVAC')

endmethod
-- End of method definition for .modifyMenu()

------------------------------------------------------------------------
--
-- Method:      .deleteMenu()
--
-- Description: Adds options to the Delete menu
--
-- Method Type: Procedure
