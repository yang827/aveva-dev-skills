endmethod
-- End of method definition for .deleteMenu()

------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()
endmethod
-- End of method definition for .toolbars()

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()

  !menu = object APPMENU('HVACCRSELTAB')
  !menu.add('CALLBACK', 'Spec World...',  |!!catCreate('SPWL')|,   'HvacCrStSpwl')
  !menu.add('CALLBACK', 'Table Group...',  |!!catCreate('TABGRO')|, 'HvacCrStTable')
  !!appMenuCntrl.addMenu(!menu, 'HVAC')

  !menu = object APPMENU('HVACCRPART')
  !menu.add('CALLBACK', |World...|,     |!!catCreate('PRTWLD HVAC')|, 'HvacCrPartWorld')
  !menu.add('CALLBACK', |Hierarchy...|, |!!catCreate('PRTELE HIER')|, 'HvacCrPartHier')
  !menu.add('CALLBACK', |Family...|,    |!!catCreate('PRTELE HVAC')|, 'HvacCrPartFamily')
  !!appMenuCntrl.addMenu(!menu, 'HVAC')

endmethod
-- End of method definition for .menus()


------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.createMenu()
  !this.modifyMenu()
  !this.deleteMenu()
  !this.menus()
endmethod
-- End of method definition for .modifyMenus()
