------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()

  !menu = object APPMENU('PIPECRSPEC')
  !menu.add('CALLBACK', |World...|,         |!!catCreate('SPWL PIPE')|, 'PipeCrSpecWorld')
  !menu.add('CALLBACK', |Specification...|, |!!catCreate('SPEC PIPE')|, 'PipeCrPipeSpec')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  !menu = object APPMENU('PIPECRTABLE')
  !menu.add('CALLBACK', |World...|,            |!!catCreate('TABWLD PIPE')|, 'PipeCrSpecWorld')
  !menu.add('CALLBACK', |Size Range Table...|, |!!catCreate('NOMTAB PIPE')|, 'PipeCrPipeNb')
  !menu.add('CALLBACK', |Branch Table...|,     |!!catCreate('BRTAB BRAN')|, 'PipeCrPipeBt')
  !menu.add('CALLBACK', |Reducer Table...|,    |!!catCreate('BRTAB REDU')|, 'PipeCrPipeRt')
  !menu.add('CALLBACK', |Wall Thickness Table...|,    |!!catCreate('WTHTAB PIPE')|, 'PipeCrTabWorld')
  !menu.add('CALLBACK', |Pipe Data Table...|,    |!!catCreate('PDATAB PIPE')|, 'PipeDataTabWorld')
  !menu.add('CALLBACK', |Slope Element Table...|,   |!!catCreate('SLOTAB PIPE')|, 'PipeCrSlopeWorld')

  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  !menu = object APPMENU('PIPECRPART')
  !menu.add('CALLBACK', |World...|,      |!!catCreate('PRTWLD PIPE')|, 'PipeCrPartWorld')
  !menu.add('CALLBACK', |Hierarchy...|,  |!!catCreate('PRTELE HIER')|, 'PipeCrPartHier')
  !menu.add('CALLBACK', |Family...|,     |!!catCreate('PRTELE PIPE')|, 'PipeCrPartFamily')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  -- Create Nominal Bore Tables
  !menu = object APPMENU('NBRW')
  !menu.add('CALLBACK', 'Table...', 'show !!creNominBoreWld', 'NBRWLD')
  !menu.add('CALLBACK', 'Elements...', '!!creNominBoreElements(|CREATE|)', 'NominalBoreTable')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

endmethod
-- End of method definition for .menus()


------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.createMenu()
  !this.modifyMenu()
  !this.deleteMenu()
  !this.menus()
endmethod
-- End of method definition for .modifyMenus()
