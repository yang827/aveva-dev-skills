------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('sysUtil')
  !menu.add(|SEPARATOR|)
  !menu.add('FORM', 'Convert Spec...', 'convertSpec', 'ConvertSpecPIPE')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Modify CKeys...', 'ckymainform', 'ModifyCKeys')
  !menu.add('FORM', 'PCONN/SKEY Report...', 'spcspecreport', 'PCONNSKEYReport')
  !menu.add('FORM', 'Modify PConns...', 'spcpconnsforskey', 'ModifyPConns')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')
endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .createMenu()
--
-- Description: Adds options to the Create menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createMenu()

  !menu = object APPMENU('sysCrt')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Catalogue...|, |!!catCreate('CATA')|, 'Catalogue')
  !menu.add('CALLBACK', |Section...|,   |!!catCreate('SECT')|, 'SectionSECT')
  !menu.add('CALLBACK', |Category...|,  |!!catCreate('CATE SCOM')|, 'PipeCrCate')
  !menu.add('SEPARATOR')
  !menu.add(|MENU|, |Specification|, |PIPECRSPEC|, |PipeSpec|)
  !menu.add(|MENU|, |Spec Table|, |PIPECRTABLE|, |PipeTable|)
  !menu.add(|MENU|, |Part|, |PIPECRPART|, |PipePart|)
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Data Set...|, |CALLCG FCREATE DTSE|, 'PipeCrDataSet')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Text...|, |CALLCT XCRTEXT CREATE|, 'PipeCrText')
  !menu.add('CALLBACK', |Detail Text...|, |CALLCT XCRDTEX CREATE|, 'PipeCrDetailText')
  !menu.add('CALLBACK', |Material Text...|, |CALLCT XCRMTEX CREATE|, 'PipeCrMaterialText')
  !menu.add('CALLBACK', |Draft Symbol Set...|, |!!catCreate('DRSSET')|, 'PipeCrDrsset')
  !menu.add('FORM', 'Slope Element...', 'slopeElement', 'slopeElement')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK' , 'Bolt Diameter/Length Table...' , |!!catCreate('NBRWLD')|, 'PipeCrNbrwld')
  !menu.add('CALLBACK' , 'Bolt Table Utilities...' , |!!catCreate('BLTA')|, 'PipeCrBlta')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK' , 'Coco Table...' , |!!catCreate('CCTA')|, 'PipeCrCcta')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Properties...', 'propCon', 'PipeCrPropCon')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

endmethod
-- End of method definition for .createMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenu()
--
-- Description: Adds options to the Modify menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenu()

  !menu = object APPMENU('sysMod')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Specification...|, |!!catSpecViews.add()|, |PipeMoPipeSpec|)
  !menu.add('CALLBACK', |Spec Table...|,    |!!catSpecViews.add()|, |PipeMoPipeTable|)
  !menu.add('CALLBACK', |Part Family...|,   |!!catPartViews.add()|, |PipeMoPartFamily|)
  !menu.add('CALLBACK', |Category...|,      |!!catModelViews.add()|,|PipeMoCategoryCATE|)
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Data Set...|, |call !!catDataSet(false)|, 'PipeMoDataSet')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Text...|, |CALLCT XCRTEXT MODIFY|, 'PipeMoText')
  !menu.add('CALLBACK', |Detail Text...|, |CALLCT XCRDTEX MODIFY|, 'PipeMoDetailText')
  !menu.add('CALLBACK', |Material Text...|, |CALLCT XCRMTEX MODIFY|, 'PipeMoMaterialText')
  !menu.add('FORM', |Detail Plot...|, 'catDetailPlt', 'DetailPlot')
  !menu.add('FORM', |Draft Symbol Set...|, |catDrsset|, 'PipeMoDrsset')
  !menu.add('FORM', 'Slope Element...', 'slopeElement', 'slopeElement')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Bolt Diameter/Length Table...', 'catBoltTables', 'BoltMoCcta')
  !menu.add('FORM' , 'Bolt Table Utilities...' , 'catbolting', 'PipeCrBlta')
--  !menu.add('CALLBACK', 'Nominal Dimension Table...', '!!creNominBoreElements(|MODIFY|)', 'NominalBoreTable')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Coco Table...', 'catcocotable', 'PipeMoCcta')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Properties...', 'propCon', 'PipeMoPropCon')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

endmethod
-- End of method definition for .modifyMenu()

