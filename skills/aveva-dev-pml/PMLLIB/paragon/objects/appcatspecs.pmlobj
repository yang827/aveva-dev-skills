------------------------------------------------------------------------
--
-- Method:      .createMenu()
--
-- Description: Adds options to the Create menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createMenu()
  !menu = object APPMENU('sysCrt')
  !menu.add('SEPARATOR')
  !menu.add('FORM', |Spec. World|, 'CDTCRTSPWL', 'SpecWorld')
  !menu.add('FORM', |Specification...|, 'CDTCRTSPEC', 'Specification')
  !menu.add('CALLBACK', |Profile Spec...|, |CALLCSP XPRFLSPEC|, 'ProfileSpec')
  !menu.add('CALLBACK', |Nozzle Spec...|, |CALLCSP XNOZZSPEC|, 'NozzleSpec')
  !!appMenuCntrl.addMenu(!menu, 'SPECS')
endmethod
-- End of method definition for .createMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenu()
--
-- Description: Adds options to the Modify menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenu()
  !menu = object APPMENU('sysMod')
  !menu.add('SEPARATOR')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Specification...|, |CALLCSP XBLDSPEC|, 'Specification')
  !!appMenuCntrl.addMenu(!menu, 'SPECS')
endmethod
-- End of method definition for .modifyMenu()

------------------------------------------------------------------------
