------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('sysUtil')

  -- Only for marine, add the hull insulation entry
  !mm = object AVEVAMODULEMANAGER()
  if (!mm.currentProductName().upcase().eq('HULL & OUTFITTING')) then
    !menu.add(|SEPARATOR|)
    !menu.add('FORM', 'Insulation...', 'insuDefineMain', 'Insulation')
  endif

  !menu.add(|SEPARATOR|)
  !menu.add('FORM', 'Convert Spec...', 'convertSpec', 'ConvertSpecSTL')
  !!appMenuCntrl.addMenu(!menu, 'STL')
endmethod
-- End of method definition for .utilsMenu()

------------------------------------------------------------------------
--
-- Method:      .createMenu()
--
-- Description: Adds options to the Create menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createMenu()

  !menu = object APPMENU('sysCrt')
  !menu.add(|SEPARATOR|)
  !menu.add('CALLBACK', |Catalogue...|, |!!catCreate('CATA')|, 'stlCatalogue')
  !menu.add('CALLBACK', |Section...|,   |!!catCreate('STSE')|, 'stlSectionSTSE')
  !menu.add('MENU', |Category|, 'stlSTCA', 'stlCategorySTCA')
  !menu.add('SEPARATOR')
  !menu.add(|MENU|, |Specification|,   |STLCRSPEC|,   |STLSpec|)
  !menu.add(|MENU|, |Selection Table|, |STLCRSELTAB|, |StlSelTab|)
  !menu.add(|MENU|, |Part|,            |STLCRPART|,   |StlPart|)
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Profile Spec...|, |CALLCSP XPRFLSPEC|, 'ProfileSpec')
  !menu.add('CALLBACK', |Data Set...|,     |CALLCG FCREATE DTSE|, 'stlCrDataSet')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Text...|, |CALLCT XCRTEXT CREATE|, 'stlCrText')
  !menu.add('CALLBACK', |Draft Symbol Set...|, |!!catCreate('DRSSET')|, 'stlCrDrsset')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Properties...', 'propCon', 'stlCrPropCon')
  !!appMenuCntrl.addMenu(!menu, 'STL')

endmethod
-- End of method definition for .createMenu()

------------------------------------------------------------------------
--
-- Method:      .modifyMenu()
--
-- Description: Adds options to the Modify menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenu()

  !menu = object APPMENU('sysMod')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Specification...|,         |!!catSpecViews.add()|,   |PipeMoPipeSpec|)
  !menu.add(|CALLBACK|, |Selection Table Group...|, |!!catSelTabViews.add()|, |StlMoSelTab|)
  !menu.add('CALLBACK', |Part Family...|,           |!!catPartViews.add()|,   |StlMoPartFamily|)
  !menu.add('CALLBACK', |Category...|,              |!!catModelViews.add()|,  |StlMoCategorySTCA|)
  !menu.add(|SEPARATOR|)
  !menu.add('CALLBACK', |Data Set...|, |call !!catDataSet(false)|, 'stlMoDataSet')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Text...|,  |CALLCT XCRTEXT MODIFY|, 'stlMoText')
  !menu.add('FORM', |Draft Symbol Set...|, |catDrsset|, 'stlMoDrsset')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Properties...', 'propCon', 'stlMoPropCon')
  !!appMenuCntrl.addMenu(!menu, 'STL')

endmethod
-- End of method definition for .modifyMenu()

