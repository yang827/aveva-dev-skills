------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()

  !menu = object APPMENU('STLCRSPEC')
  !menu.add('CALLBACK', |World...|,         |!!catCreate('SPWL')|, 'PipeCrSpecWorld')
  !menu.add('CALLBACK', |Specification...|, |!!catCreate('SPEC')|, 'PipeCrPipeSpec')
  !!appMenuCntrl.addMenu(!menu, 'STL')
  -- Create Category
  !menu = object APPMENU('stlSTCA')
  !menu.add('CALLBACK', |for Storage...|,   |!!catCreate('STCA STORAGE')|, 'forStorage')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |for Profiles...|,  |!!catCreate('STCA SPRF')|, 'forProfiles')
  !menu.add('CALLBACK', |for Joints...|,    |!!catCreate('STCA JOIN')|, 'forJoints')
  !menu.add('CALLBACK', |for Fittings...|,  |!!catCreate('STCA SFIT')|, 'forFittings')
  !menu.add('CALLBACK', |for Templates...|, |!!catCreate('STCA TMPL')|, 'forTemplates')
  !!appMenuCntrl.addMenu(!menu, 'STL')

  !menu = object APPMENU('STLCRSELTAB')
  !menu.add('CALLBACK', 'World...',        |!!catCreate('SPWL')|,   'StlCrStSpwl')
  !menu.add('CALLBACK', 'Table Group...',  |!!catCreate('TABGRO')|, 'StlCrStTable')
  !!appMenuCntrl.addMenu(!menu, 'STL')

  !menu = object APPMENU('STLCRPART')
  !menu.add('CALLBACK', |World...|,     |!!catCreate('PRTWLD STL')|, 'StlCrPartWorld')
  !menu.add('CALLBACK', |Hierarchy...|, |!!catCreate('PRTELE HIER')|, 'StlCrPartHier')
  !menu.add('CALLBACK', |Family...|,    |!!catCreate('PRTELE STL')|, 'StlCrPartFamily')
  !!appMenuCntrl.addMenu(!menu, 'STL')

endmethod
-- End of method definition for .menus()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.barMenu()
  !this.displayMenu()
  !this.graphMenu()
  !this.queryMenu()
  !this.settingsMenu()
  !this.utilsMenu()
  !this.createMenu()
  !this.modifyMenu()
  !this.deleteMenu()
  !this.menus()
endmethod
