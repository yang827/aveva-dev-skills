define object CATBTSEELEMENT
----------------------------------------------------------------------

  -- List of graphical views
  member .headings       is ARRAY
  member .columns        is ARRAY
  member .members        is ARRAY
  member .currentType    is STRING
  member .parameters     is ARRAY
  member .table          is TABLE
  member .report         is REPORT
  member .rtext          is ARRAY
  member .dtext          is ARRAY
  -- Saved reference to gadget used to select item to delete
  -- Necessary because of delete confirmation dialogue callback
  member .savedDeleteGadget is GADGET

endobject
-- End of object definition for CATBTSEELEMENT

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method

------------------------------------------------------------------------
define method .globalInstance()
------------------------------------------------------------------------

  -- Create Global Variable
  !!catbtseElement = !this

endmethod

------------------------------------------------------------------------------------------------------------------------
define method .listCallback(!gadget is GADGET, !table is TABLE, !dummyRow is REAL)
------------------------------------------------------------------------------------------------------------------------
-- Set the fields of the form based on current selected element.

!form = !gadget.owner()

!element = !this.dtext[!gadget.val]
handle (2,752)
    -- What to do here as we have no BLTP elements.
    if (!!ce.type EQ 'BTSE') then
      -- For BTSE Element.
      !this.radioCallback(!form.btsesame, 'SELECT')
    endif

    return
endhandle

-- Navigate to the selected element.
!!ce = !this.rtext[!gadget.val].dbref()
   !members = !!ce.member

-- Set the form values to the current element settings.
!!catModelViews.setFormFields(!form, !!ce)

    if (!!ce.type EQ 'BTSE' and !members.empty()) then
      -- For BTSE Element.

        !this.radioCallback(!form.btsesame, 'SELECT')

     else
       -- For BLTP Element.

        !this.radioCallback(!form.btsediff, 'SELECT')

     endif

endmethod

-------------------------------------------------------------------------------------------------------
define method .radioCallback(!gadget is GADGET, !action is STRING)
-------------------------------------------------------------------------------------------------------

if (!action EQ 'UNSELECT') then
     return
endif

    !form = !gadget.owner()

    if (!gadget.name() EQ 'BTSESAME') then

      if (!!ce.type EQ 'BLTP') then
          BTSE
      endif

      !form.btsesame.val     = TRUE
      !form.btseList.visible = FALSE
      !form.btseDel.active   = FALSE
      !form.btsenew.active   = FALSE
      !form.btsecop.active   = FALSE
	
      !form.bltpdesc.visible = FALSE
      !form.bltpnumb.visible = FALSE
      !form.bltpbdia.visible = FALSE
      !form.bltpbtyp.visible = FALSE
      !form.bltpbthk.visible = FALSE

      !form.btsedesc.visible = TRUE
      !form.btsefunc.visible = TRUE
      !form.btsenoff.visible = TRUE
      !form.btsebdia.visible = TRUE
      !form.btsebtyp.visible = TRUE
      !form.btsebthk.visible = TRUE
      !form.btsegtyp.visible = TRUE
      !form.btsepurp.visible = TRUE

    else

      -- Grey out the fields here because there are no bolt points.
      if (!form.btseList.dtext.empty()) then
          !form.bltpdesc.active = FALSE
          !form.bltpnumb.active = FALSE
          !form.bltpbdia.active = FALSE
          !form.bltpbtyp.active = FALSE
          !form.bltpbthk.active = FALSE
          !form.bltpdesc.val = ''
          !form.bltpnumb.val = REAL()
          !form.bltpbdia.val = ''
          !form.bltpbtyp.val = ''
          !form.bltpbthk.val = ''
      else
          !form.bltpdesc.active = TRUE
          !form.bltpnumb.active = TRUE
          !form.bltpbdia.active = TRUE
          !form.bltpbtyp.active = TRUE
          !form.bltpbthk.active = TRUE
      endif

      !form.btsediff.val     = TRUE
      !form.btseList.visible = TRUE
      !form.btseDel.active   = TRUE
      !form.btsenew.active   = TRUE
      !form.btsecop.active   = TRUE
	
      !form.bltpdesc.visible = TRUE
      !form.bltpnumb.visible = TRUE
      !form.bltpbdia.visible = TRUE
      !form.bltpbtyp.visible = TRUE
      !form.bltpbthk.visible = TRUE

      !form.btsedesc.visible = FALSE
      !form.btsefunc.visible = FALSE
      !form.btsenoff.visible = FALSE
      !form.btsebdia.visible = FALSE
      !form.btsebtyp.visible = FALSE
      !form.btsebthk.visible = FALSE
      !form.btsegtyp.visible = FALSE
      !form.btsepurp.visible = FALSE

      !!ce = !form.btse.members[!form.btseList.val]
      handle (2,752)
      endhandle

endif

endmethod

-------------------------------------------------------------------------------------------------------
define method .setRefs(!element is DBREF, !gadget is GADGET)
-------------------------------------------------------------------------------------------------------
-- Get the members for the given Gmse element and populate the form with these values.

!this.members = !element.member

!form = !gadget.owner()

  !coll = object COLLECTION()
  !coll.type(|BLTP|)
  !coll.scope(!element)

  !headings = ARRAY()
  !headings.append('Numb')
  !headings.append('Bdiam')
  !headings.append('Btype')
  !headings.append('BThkne')

  !column = ARRAY()
  !column.append(object column(object expression('Numb')  ,true,true,'Numb'))
  !column.append(object column(object expression('BDia')  ,true,true,'BDia'))
  !column.append(object column(object expression('Btype') ,true,true,'Btype'))
  !column.append(object column(object expression('Bthk')  ,true,true,'Bthk'))

  !format = object COLUMNFORMAT()

  !table = object TABLE()
  !table.table(!coll.results(),!column)

  !report = object REPORT(!table)
  !report.addcolumn('Numb',  !format,'Numb')
  !report.addcolumn('BDia',  !format,'BDia')
  !report.addcolumn('Btype', !format,'Btype')
  !report.addcolumn('Bthk' ,!format,'Bthk')

  !gadget.setHeadings(!report.columnHeadings())

  !gadget.setRows(!report.rows())
  !rtext = ARRAY()
  !dtext = ARRAY()

  !report.results(!dtext,!rtext)

  !this.rtext  = !rtext
  !this.dtext  = !dtext
  !this.table  = !table
  !this.report = !report

  -- Add tracking elements.
  !form.getElement.addToTrack(!form, !rtext, 7)

  -- Fill in the attributes for the appropriate frame/form field.
  !!catModelViews.setFormFields(!form, !element)

endmethod

---------------------------------------------------------------------------------------------------------------
define method .buttonCallback(!gadget is GADGET, !action is STRING)
---------------------------------------------------------------------------------------------------------------
!form = !gadget.owner()

-- We are currently at the selected element in the list,
!!ce = !this.rtext[!gadget.val].dbref()
handle (2,752)
endhandle

-- so we need to either change the attributes, or copy one, or create new.

if (!action EQ 'APPLY') then
    -- Make sure we are at one of the selected Bolt points or Bolt set before we do anything.

    if (!!ce.type NE 'BTSE' AND !!ce.type NE 'BLTP') then
        !!ce = !this.rtext[!gadget.val].dbref()
    handle (2,752)
        -- Handle where nothing exists.
      endhandle
    endif
endif

    -- Remember which item was selected.
    !selected = !gadget.val

if (!action EQ 'NEW') then
    !!catModelViews.createNewElement('BLTP','none')
    !selected = !selected + 1

elseif (!action EQ 'COPY') then
    !!catModelViews.createNewElement('BLTP','COPY')
    !selected = !selected + 1

elseif (!action EQ 'APPLY') then

    -- Applying the attributes.
    !!catModelViews.formApply(!form, !!ce)

endif

    -- Update the menus to reflect the latest state of bolt points.
    !!catSetCateReferences(!form.compAttribList,'SELECT')

    -- Now reselect the gadget value.
    if (!form.btsediff.val) then
    !gadget.val = !selected

    !!ce = !this.rtext[!selected].dbref()
    handle any
    endhandle
    endif

-- Refresh Form Variables and list.
   !!catModelViews.btseListCallback(!form)

endmethod

------------------------------------------------------------------------------------------------------------------------
define method .delete(!gadget is GADGET)
------------------------------------------------------------------------------------------------------------------------
-- Delete the selected BOLT/BTSE element in hierarchy and repopulate form.

-- First attach to element in the gadget we have selected, Just in case someone clicked in the members list.
   !form = !gadget.owner()
   !element = !form.btse.rtext[!gadget.val].dbref()
   handle (2,752)
      -- List empty.
      return
   endhandle

  -- handle unset DBREF caused by clicking on selection being empty
  if( !element.unset() ) then
    !!alert.error('Empty list: Nothing to delete')
    return
  endif

  -- save gadget for form update callback
  !this.savedDeleteGadget = !gadget

  -- verify delete and delete element
  -- This will call back to the .confirmedDelete() method if the delete is successful
  !!catDeleteManager.deleteElement(!element,!this)

endmethod

------------------------------------------------------------------------------------------------------------------------
define method .confirmedDelete()
------------------------------------------------------------------------------------------------------------------------
-- Delete the selected BOLT/BTSE element in hierarchy and repopulate form.
-- TAKE CARE. This is a callback for the paragon delete confirm dialogue
-- Only called if delete is successful and form needs to be updated

-- First attach to element in the gadget we have selected, Just in case someone clicked in the members list.
   !form     = !this.savedDeleteGadget.owner()
   !selected = !this.savedDeleteGadget.val

-- Now re-populate the list with the new element, and place yourself there ready for apply.
   !!catSetCateReferences(!form.compAttribList, 'SELECT')

-- Reposition the list to the position we were at.
   !this.savedDeleteGadget.val = !selected - 1
   handle (61,620)
   -- Handle the situation where we select the zero field.
     !this.savedDeleteGadget.val = 1
     handle (61,620)
        -- Handle case where we have just deleted the only entry in the list.
     endhandle
   endhandle

-- Refresh Form Variables and list.
   !!catModelViews.btseListCallback(!form)

endmethod
