define object CATCATEELEMENT
----------------------------------------------------------------------

  -- List of graphical views
  member .headings       is ARRAY
  member .columns        is ARRAY
  member .members        is ARRAY
  member .currentType    is STRING
  member .parameters     is ARRAY
  member .table          is TABLE
  member .report         is REPORT
  member .rtext          is ARRAY
  member .dtext          is ARRAY
  -- Saved reference to gadget used to select item to delete
  -- Necessary because of delete confirmation dialogue callback
  member .savedDeleteGadget is GADGET

endobject
-- End of object definition for catCateElement
------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method

------------------------------------------------------------------------
define method .globalInstance()
------------------------------------------------------------------------

  -- Create Global Variable
  !!catCateElement = !this

endmethod

------------------------------------------------------------------------------------------------------------------------
define method .listCallback(!gadget is GADGET, !table is TABLE, !row is REAL)
------------------------------------------------------------------------------------------------------------------------
-- Set the fields of the form based on current selected element.

!form = !gadget.owner()

!list = !table.row(!row)

!form.dtsekey.val  = !list[2]
!form.dtsedesc.val = !list[4]
!form.dtsedefa.val = !list[6]
!form.dtseexpr.val = !list[7]

endmethod

---------------------------------------------------------------------------------------------------------------
define method .categoryCellUpdate(!form is FORM, !data is ARRAY)
---------------------------------------------------------------------------------------------------------------
-- Create new element based on selected element in list.

$(
  if (!form.cateTable.getRow(!data[1])[1].substring(1,1) eq '=') then
    !cellContents = !form.cateTable.getRow(!data[1])[1]
  else
    !cellContents = '/' & !form.cateTable.getRow(!data[1])[1]
  endif

  !!ce = !cellContents.dbref()

-- Check for empty cells.
if (!cellContents.dbref().badref()) then
     !data[3] = FALSE
     return
endif
$)

-- Set Current Element (CE) by getting element from grid position 1
  if (!!catModelViews.getNameFromGrid(!form.cateTable.getRow(!data[1])[1]).not()) then
    !data[3] = FALSE
    return
  endif

!save = !!ce
-- Check here to see if the GTYPE is being set.
if (!data[2] EQ 'Gtype') then

   -- Check the length of the data, to see if we have more than 4 characters.
   if (!data[0].length() GT 4) then

       -- Reset the field back to what it was, and exit.
          !!alert.error('Sorry, Only Four Characters Allowed')
          !data[3] = FALSE
   else
       -- Set GTYPE to that being passed.
       !!ce.attribute('gtype') = !data[0]

   endif

   -- Now abort from this routine.
      return

elseif (!data[2] EQ 'Name') then

     -- Change Name of Element
     !name = '/' & !data[0]
     !name = !name.replace('//','/')
     if (!name.dbref().badref()) then
           !data[3] = FALSE
     else
          !!alert.error('Name already exists.')
           !data[3] = FALSE
     endif
     handle (2,109)
           -- Name don't exist.
           NAME $!name

           -- Now force the name to include the slash, so callback copes with it.
           !form.forceCellValue = TRUE
           !form.cateTable.setCellValue(!data[1],!data[2],!!ce.name)
     endhandle

   -- Now abort from this routine.
      return

endif

do !i index !form.cateTable.getColumns()
    if (!form.cateTable.getColumns()[!i] EQ !data[2]) then
    	  !column = !i - 2
    	  break
    endif
enddo

-- !column is the parameter that has been changed.

-- Navigate to the element, and grab the parameters.
!!ce = !save

var !param SPLIT PARAM

-- Now change the value we had for the one we have now in the data array, place[0]
      !param[!column] = !data[0]

      !newParam = ''
      do !j value !param
         !newParam = !newParam & ' ' & !j
      enddo

      -- Now deal with the values changing, or not if an error occurs.
      !error = !!catModelViews.command(|PARAM|, !newParam)
      if (!error.empty() eq false) then
      	  !data[3] = FALSE
      	  !!alert.error(!error[1] & ' ' & !error[2])
      endif

-- Now add the model to the view to show change.
!form.getElement.addModel(!form, !!ce)

endmethod

-------------------------------------------------------------------------------------------------------
define method .delete(!gadget is ANY)
-------------------------------------------------------------------------------------------------------
-- Delete the current selected element.

   !form = !gadget.owner()
   !deleteOwner = FALSE

   -- Make current element the selected component.
   if (!form.cateTable.getselectedRows().empty()) then
       !!alert.error('No Component Selected')
       return
   endif

   -- Check to see if there is only one row.
   if (!form.cateTable.getRows().size() EQ 1) then
       !ans = !!alert.confirm('Only one component in list, Deleting will require form to be closed - Continue')
       if (!ans EQ 'YES') then
           !deleteOwner = TRUE
       endif
   endif

   -- Now delete this element.

   -- Best check to see if we delete all the components, as we need at least one.
   if (!form.cateTable.getRows()[2][1].length() EQ 1) then
       !!alert.error('Unable to delete last component.')
       return
   endif

   -- Set Current Element (CE) by getting element from grid position 1
   if (!!catModelViews.getNameFromGrid(!form.cateTable.getselectedRows()[1][1]).not()) then
     return
   endif

  -- verify delete and delete element
  -- This will call back to the .confirmedDelete() method if the delete is successful
  if( !deleteOwner ) then
    -- If deleting owner, user has already been asked to confirm
    !!ce = !!ce.owner
    !type = !!ce.type
    DELETE $!type

    -- Now delete the form too.
    !formName = '!!' & !form.name()
    kill $!formName
  else
    -- save gadget for form update callback
    !this.savedDeleteGadget = !gadget
    !!catDeleteManager.deleteElement(!!ce,!this)
  endif

endmethod

------------------------------------------------------------------------------------------------------------------------
define method .confirmedDelete()
------------------------------------------------------------------------------------------------------------------------
-- TAKE CARE. This is a callback for the paragon delete confirm dialogue
-- Delete the selected element in hierarchy and repopulate form
-- Only called if delete is successful and form needs to be updated

  -- Get details of form gadget used to select element to delete
  -- Now delete the selected row.
  !form     = !this.savedDeleteGadget.owner()
   -- Which row have we selected.
   !currentGridPosition = !form.cateTable.getSelectedRowTags()[1].real()
  !form.cateTable.deleteSelectedRows()

  -- Now populate the list gadget with new details.
  !!catModelViews.setCe(!form.compAttribList, 'SELECT')

  -- Reselect the first row in list.
  !form.cateTable.selectRow(!currentGridPosition - 1)

endmethod

-------------------------------------------------------------------------------------------------------
define method .newCopy(!form is FORM, !action is STRING)
-------------------------------------------------------------------------------------------------------
  -- Create new element based on selected element in list.
  if (!form.cateTable.getselectedRows().empty()) then
	  if (!action EQ 'NEW') then
      !ans = !!alert.confirm('No row selected, Ok to create at the end of the list')
      if (!ans.eq('NO')) then
        return
      else
        -- Goto the end of the list of elements and create new one.
        -- check to see if we have blank lines.
        if (!form.cateTable.getRows().size() LT 10) then
          do !check from 9 to 1 by -1
            !name = !form.cateTable.getRow(!check)[1]
            if (!name eq '') then
              skip
            endif
            if (!name.substring(1,1) ne ('/') and !name.substring(1,1) ne '=') then
              !name = '/' & !name
            endif
            !!ce = !name.dbref()
            handle (2,822) (2,813) (2,761)
              skip
            elsehandle none
              !!ce = !name.dbref()
              !beforeRow  = !check
              break
            endhandle
          enddo
        else
          !beforeRow = !form.cateTable.getRows().size()
          !name = !form.cateTable.getRow(!beforeRow)[1]
          if (!name eq '') then
            return
          endif
          if (!name.substring(1,1) ne ('/') and !name.substring(1,1) ne '=') then
            !name = '/' & !name
          endif
            !!ce = !name.dbref()
          handle (2,822) (2,813) (2,761)
            return
          endhandle

        endif
      endif
    else
      !!alert.message('No row selected, COPY Not Possible')
      return
    endif
   !form.cateTable.selectRow(!beforeRow)
  else


  endif
  -- Get element from grid position 1
  if (!!catModelViews.getNameFromGrid(!form.cateTable.getselectedRows()[1][1]).not()) then
    return
  endif
  !type = !!ce.type
  !beforeRow = !form.cateTable.getSelectedRowTags()[1].real()
  handle (2,752)
    !beforeRow = !form.cateTable.getRows().size()
  endhandle

  !type = !!ce.type
-- Decide what we are doing here, copying or creating new.
   if (!action eq 'NEW') then
     !create = !!catModelViews.createNewElement(!type,'AUTONAME')
   else
     !create = !!catModelViews.createNewElement(!type,!action)
   endif

-- Navigate to owner, to display category.
   OWNER

   if (!create) then
       -- Now populate the list gadget with new details.
       !!catSetCateReferences(!form.categoryCont, 'SELECT')
   endif

-- Select the row that will now be the current element.
   !form.cateTable.selectRow(!beforeRow + 1)

endmethod
