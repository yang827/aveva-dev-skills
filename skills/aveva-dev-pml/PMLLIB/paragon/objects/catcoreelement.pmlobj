--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(GADGET)                    -
--  catCoreElement()                 -
--  copy(GADGET)                     -
--  create(GADGET)                   -
--  delete(GADGET)                   -
--  globalInstance()                 -                   Create global instance of object
--  setEdit(DBREF,GADGET)            -
--  setRefs(DBREF,GADGET)            -                   Get the members of the current PTREF and fill out the form.
--
define object CATCOREELEMENT
----------------------------------------------------------------------

  -- List of graphical views
  member .headings       is ARRAY
  member .columns        is ARRAY
  member .rtext          is ARRAY
  member .members        is ARRAY
  member .currentType    is STRING

endobject
-- End of object definition for catcoreElement

----------------------------------------------------------------------
define method .catCoreElement()
----------------------------------------------------------------------

  !this.headings[1] = 'Numb'
  !this.headings[2] = 'Type'
  !this.headings[3] = 'Purp'
  !this.headings[4] = 'Tag'
  !this.headings[5] = 'Group'

endmethod
-- End of object definition for catCoreElement
------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method

------------------------------------------------------------------------
define method .globalInstance()
------------------------------------------------------------------------

  -- Create Global Variable
  !!catCoreElement = !this

endmethod

------------------------------------------------------------------------
--
-- Method:      setRefs
--
-- Description: Get the members of the current PTREF and fill out the form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method

-------------------------------------------------------------------------------------------------------
define method .setRefs(!element is DBREF, !gadget is GADGET)
-------------------------------------------------------------------------------------------------------
-- Get the members for the given CORE SET element and populate the form with these values.

    !this.members = !element.member

!this.rtext.clear()
!this.columns.clear()

!this.columns[1] = ARRAY()
!this.columns[2] = ARRAY()
!this.columns[3] = ARRAY()
!this.columns[4] = ARRAY()
!this.columns[5] = ARRAY()

do !i value !this.members
   !this.columns[1].append(!i.number.string())
   !this.columns[2].append(!i.type)
   !this.columns[3].append(!i.purp)
   !this.columns[4].append(!i.cortag[1])
   !this.columns[5].append(!i.corcgroup[1])
   !this.rtext.append(!i.string())
enddo


!gadget.setHeadings(!this.headings)
!gadget.setColumns (!this.columns)
!gadget.rtext     = !this.rtext
!form             = !gadget.owner()

-- Now call the reference for the first in the list.
!this.setEdit(!this.rtext[1].dbref(),!gadget)
   handle (2,752)
     -- Do nothing
   endhandle

-- Add elements to tracking list.
!form = !gadget.owner()
!form.getElement.addToTrack(!form, !this.rtext, 4)

endmethod

-------------------------------------------------------------------------------------------------------
define method .setEdit(!element is DBREF, !gadget is GADGET)
-------------------------------------------------------------------------------------------------------
-- Having the gadget get entry and set the form edit up ready for use to change things if required.

!form = !gadget.owner()

-- Set the form fields with values.
!!catModelViews.setFormFields(!form, !element)

endmethod

-------------------------------------------------------------------------------------------------------
define method .create(!gadget is GADGET)
-------------------------------------------------------------------------------------------------------
!save = !!ce
-- Having the gadget get entry and set the form edit up ready for use to change things if required.

!form = !gadget.owner()
-- First off set the current element to that selected in the points list, for continuity.
!!ce = !form.coreList.selection().dbref()
    handle (2,822)
       -- Likely because we are creating a new one.
    endhandle

!currentPosition = !form.coreList.val

-- Turn off AutoNaming if switched on.
    !turnNamingOn = FALSE
if (!!namOptEdit.data.auto) then
    !!namOptEdit.data.auto = FALSE
    !turnNamingOn = TRUE
endif

!type = |CABCOR|

-- Only allow creation if write access.
if (!!catModelViews.createNewElement(!type,'AUTONAME')) then
    -- Now refresh the list and make that the current selection.
    !form.core.setRefs(!!ce.owner, !form.coreList)
    !form.coreList.val = !currentPosition + 1
    !form.core.setEdit(!!ce,!form.coreList)
endif

-- Turn it back on again, if required.
if (!turnNamingOn) then
    !!namOptEdit.data.auto = TRUE
endif

-- Return to element if we moved away from it coming into this routine.
!!ce = !save

--reselect the list we have just come from and adjust selection.
!form.coreList.val = !currentPosition + 1
!!catmodelviewsGetList(!form.coreList, 'SELECT')

endmethod

---------------------------------------------------------------------------------------------------
define method .copy(!list is GADGET)
---------------------------------------------------------------------------------------------------
-- Having the gadget get entry and set the form edit up ready for use to change things if required.

!form = !list.owner()

$!list
!currentPosition = !list.val
if !list.val.eq(0) then
	--P-19043: If list is empty !list.val is 0, cannot copy if list is empty.
  !!alert.error('No cores to copy. The list is empty.')
  return
endif

-- Get type.
   !type = !!ce.type

-- Turn off AutoNaming if switched on.
    !turnNamingOn = FALSE
if (!!namOptEdit.data.auto) then
    !!namOptEdit.data.auto = FALSE
    !turnNamingOn = TRUE
endif

!type = |CABCOR|

if (!!catModelViews.createNewElement(!type,'COPY')) then
    -- Now refresh the list and make that the current selection.
    !form.core.setRefs(!!ce.owner, !form.coreList)
    !form.coreList.val = !currentPosition + 1
    !form.core.setEdit(!!ce,!form.coreList)
endif

-- Turn it back on again, if required.
if (!turnNamingOn) then
    !!namOptEdit.data.auto = TRUE
endif

--reselect the list we have just come from and adjust selection.
!form.coreList.val = !currentPosition + 1
!!catmodelviewsGetList(!form.coreList, 'SELECT')

endmethod
------------------------------------------------------------------------------------------------------------------------
define method .delete(!gadget is GADGET)
------------------------------------------------------------------------------------------------------------------------
-- Delete the selected DATA element in hierarchy and repopulate form.

-- First attach to element in the gadget we have selected, so element is created in the right place in list.

-- Now re-populate the list with the new element, and place yourself there ready for apply.
!form     = !gadget.owner()
!selected = !gadget.val

-- Set the current element to that selected and delete.
!!ce = !gadget.selection().dbref()
handle (2,822)
  !!alert.error('Nothing to delete')
  return
endhandle

!type = !!ce.type
DELETE $!type

-- Refresh Form Variables and list.
!!catSetCateReferences(!form.compAttribList, 'SELECT')

-- Re-assign the selected gadget to one less than we had, as one has just been deleted.
!gadget.val = !selected - 1
   handle (61,620)
     -- Handle the situation where we select the zero field.
       !gadget.val = 1
          handle (61,620)
          -- Handle case where we have just deleted the only entry in the list.
          endhandle
   endhandle

-- Refresh Form Variables and list.
!!catmodelviewsGetList(!gadget, 'SELECT')

endmethod

-------------------------------------------------------------------------------------------------------
define method .apply(!gadget is GADGET)
-------------------------------------------------------------------------------------------------------
!save = !!ce

-- Set form variable.
!form = !gadget.owner()

-- Remember Selected position and use later to reselect.
!selected = !gadget.val

-- Attach to element selected in the list first, just in case we have moved away.
!!ce = !gadget.selection().dbref()

-- Set the form fields with values.
!!catModelViews.formApply(!form, !!ce)

-- Refresh Variables and list.
!!catSetCateReferences(!form.compAttribList, 'SELECT')

--reselect the list we have just come from and adjust selection.
!gadget.val = !selected
!!catmodelviewsGetList(!gadget, 'SELECT')

endmethod
