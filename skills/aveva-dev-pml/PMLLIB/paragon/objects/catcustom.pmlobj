------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  catCustom()                      -                   Constructor
--  registerForm(FORM,STRING)        -                   Register a form to receive notification of changes
--  update()                         -                   Update all registered forms
--  update(FORM)                     -                   Update a registered form
--
------------------------------------------------------------------------

define object catcustom

  -- Control
  member .registeredForms     is ARRAY
  member .registeredMethods   is ARRAY

  -- Navigator
  member .navDbname           is BOOLEAN
  member .navOwnerName        is BOOLEAN
  member .navReadWrite        is BOOLEAN

  -- Selection Tables
  member .sTActive            is BOOLEAN
  member .sTItemName          is BOOLEAN
  member .sTPartName          is BOOLEAN
  member .sTPriType           is BOOLEAN
  member .sTSecType           is BOOLEAN
  member .sTDesc              is BOOLEAN

  -- Pipe Specifications

endobject

------------------------------------------------------------------------
--
-- Method:      catCustom
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .catCustom()


endmethod
-- End of method definition for .catCustom()

------------------------------------------------------------------------
--
-- Method:      registerForm
--
-- Description: Register a form to receive notification of changes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM       Form to register
--    2   R      STRING     Method to call on update
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .registerForm(!form is FORM, !method is STRING)

  !this.registeredForms.append(!form)
  !this.registeredMethods.append(!method)

endmethod
-- End of method definition for .registerForm(FORM, STRING)

------------------------------------------------------------------------
--
-- Method:      update
--
-- Description: Update all registered forms
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .update()

  do !ind indices !this.registeredForms
    !this.update(!this.registeredForms[!ind])
  enddo

endmethod
-- End of method definition for .registerForm(FORM)
------------------------------------------------------------------------
--
-- Method:      update
--
-- Description: Update a registered form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM       Form to register
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .update(!form is FORM)

  -- Find form index in register
  !index = !this.registeredForms.findFirst(!form)

  -- Execute registered method for form
  !functionBlock = object BLOCK('!!' & !this.registeredForms[!index].name() & !this.registeredMethods[!index])
  !functionBlock.evaluate()

endmethod
-- End of method definition for .registerForm(FORM)
