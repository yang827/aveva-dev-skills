--    Module:        Paragon
--  Author:          Malcolm Barlow
--  Created:         Jul 21 2009
--
--  Description:     Manage catalogue component properties (data set)
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  appendData()                     DBREF               Create new DATA at the end of the list and make it current
--  catDataSet()                     -                   Constructor
--  catDataSet(DBREF)                -                   Constructor - Initialise for given data set
--  getDataSet()                     DBREF               Return data set DTSE reference
--  getParameterData()               ARRAY               Return array of Parameters defined by this data set
--  newData(STRING,DBREF)            DBREF               Create new DATA at given location the list and make it current
--  nextData()                       DBREF               Move current DATA to next DATA element
--
----------------------------------------------------------------------
define object CATDATASET
----------------------------------------------------------------------

  -- DBREF of data set DTSE element
  member .dataSet        is DBREF
  -- DBREF of current data element
  member .currentData    is DBREF

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      .catDataSet()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
-- Arguments:
--
------------------------------------------------------------------------
define method .catDataSet()

  -- unset DBREF indicates that this object has not been attached to a DTSE
  !this.dataSet     = object DBREF()
  -- unset DBREF indicates that a DATA element in this object has not been made current
  !this.currentData = object DBREF()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .catDataSet()
--
-- Description: Constructor - Initialise for given data set
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Data set DTSE element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .catDataSet(!element is DBREF)

  -- initialise object
  !this.catDataSet()

  if( badref(!element) ) then
    return
  endif

  if( !element.type eq 'DATA' ) then
    !dataSetRef = !element.owner
  else
    !dataSetRef = !element
  endif

  if( !dataSetRef.type eq 'DTSE' ) then
    !this.dataSet = !element
  endif

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .getDataSet()
--
-- Description: Return data set DTSE reference
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Data set DBREF (unset if not linked to a data set element)
--
------------------------------------------------------------------------
define method .getDataSet() is DBREF

  return !this.dataSet

endmethod

------------------------------------------------------------------------
--
-- Method:      .nextData()
--
-- Description: Move current DATA to next DATA element
--              Note: not keeping an index into the array of members
--              because the member list could change between calls
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Data set DBREF (unset if not linked to a data set element)
--
------------------------------------------------------------------------
define method .nextData() is DBREF

  if( badref(!this.dataSet) ) then
    !this.currentData = object DBREF()
    return !this.currentData
  endif

  !members = !this.dataSet.members

  if( !members.empty() ) then
    !this.currentData = object DBREF()
    return !this.currentData
  endif

  -- find first or next DATA element
  if( !this.currentData.unset() ) then
    !this.currentData = !members[1]
  else
    !saveCE     = !!ce
    !!ce        = !this.currentData
    NEXT
    handle any
      !this.currentData = object DBREF()
    elsehandle none
      !this.currentData = !!ce
    endhandle
    !!ce=!saveCE
  endif

  return !this.currentData

endmethod

------------------------------------------------------------------------
--
-- Method:      .getParameterData()
--
-- Description: Return array of Parameters defined by this data set
--              There should be a complete set of parameter definitions
--              from 1 to n but this may not be true if one has been
--              deleted out from the sequence or if duplicate definitions
--              are present
--              Logic is complicated because parameters should be defined
--              as PURP=PARA and Number=Parameter number.
--              However, some applications do not store parameters in data sets.
--              Bad practice in the past has used PURP=DATA.
--              More bad practice uses property keys (APAR,BPAR etc) linked to
--              parameters.
--              This method looks for PARA definitions first, then DATA definitions.
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Number of Parameter DATA references
--
------------------------------------------------------------------------
define method .getParameterData() is ARRAY

  if( badref(!this.dataSet) ) then
    return ARRAY()
  endif

  -- First try PURP=PARA
  !parameterCollection = object COLLECTION()
  !members = !this.dataSet.members
  if( !members.empty() ) then
    return ARRAY()
  endif
  !parameterCollection.scope(!members)
  !parameterCollection.type('DATA')
  !parameterCollection.filter(object EXPRESSION(|PURP eq 'PARA'|))
  !parameterData = !parameterCollection.results()

  -- get parameter numbers from DATA element Number attribute (not necessarily in correct order or complete)
  !parameterDataReference = ARRAY()
  do !data values !parameterData
    !parameterNumber      = !data.number
    skip if( !parameterNumber lt 0 )
    if( !parameterNumber eq 0 ) then
      -- allow for bad definitions where the number attribute is not set
      -- try to get the parameter number from the expression
      !propertyExpression = !data.ppro.replace(' ','')
      skip if( not !propertyExpression.before('[') inset('(ATTRIBPARA','(ATTRIBWPAR','(ATTRIBCPAR') )
      skip if( !propertyExpression.after(']') neq ')' )
      !number = !propertyExpression.after('[').before(']')
      !parameterNumber = !number.real().nInt()
      handle any
        -- skip if any problem with the number extracted from the expression
        skip
      endhandle
    endif
    skip if( !parameterNumber leq 0 )
    -- ignore duplicate parameter number. First DATA element for this parameter number is accepted
    skip if( defined(!parameterDataReference[!parameterNumber]) )
    !parameterDataReference[!parameterNumber] = !data
  enddo

  -- Next try PURP=DATA
  !parameterCollection.filter(object EXPRESSION(|PURP eq 'DATA'|))
  !parameterData = !parameterCollection.results()
  do !data values !parameterData
    !parameterNumber      = !data.number
    skip if( !parameterNumber leq 0 )
    -- ignore duplicate parameter number. First DATA element for this parameter number is accepted
    skip if( defined(!parameterDataReference[!parameterNumber]) )
    -- extra check on the expression to confirm that this is a parameter
    -- remove spaces to make test more reliable
    !propertyExpression = !data.ppro.replace(' ','')
    !expression         = '(ATTRIBPARA[' + !parameterNumber.string('D0') + '])'
    if( !propertyExpression neq !expression ) then
      -- allow for possible word parameter expression
      !expression = '(ATTRIBWPAR[' + !parameterNumber.string('D0') + '])'
      if( !propertyExpression neq !expression ) then
        -- allow for CPAR expression
        !expression = '(ATTRIBCPAR[' + !parameterNumber.string('D0') + '])'
        skip if( !propertyExpression neq !expression )
      endif
    endif
    !parameterDataReference[!parameterNumber] = !data
  enddo

  return !parameterDataReference

endmethod

------------------------------------------------------------------------
--
-- Method:      .appendData()
--
-- Description: Create new DATA at the end of the list and make it current
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Data set DBREF (unset if not linked to a data set element)
--
------------------------------------------------------------------------
define method .appendData() is DBREF

  if( badref(!this.dataSet) ) then
    !this.currentData = object DBREF()
    return !this.currentData
  endif

  !members = !this.dataSet.members

  !saveCE = !!ce

  if( !members.empty() ) then
    !!ce = !this.dataSet
  else
    !!ce = !members.last()
  endif

  NEW DATA
  handle any
    !this.currentData = object DBREF()
  elsehandle none
    !this.currentData = !!ce
  endhandle

  !!ce = !saveCE

  return !this.currentData

endmethod

------------------------------------------------------------------------
--
-- Method:      .newData()
--
-- Description: Create new DATA at given location the list and make it current
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Data set DBREF (unset if not linked to a data set element)
--
------------------------------------------------------------------------
define method .newData(!locationQualifier is STRING, !location is DBREF) is DBREF

  if( badref(!this.dataSet) ) then
    !this.currentData = object DBREF()
    return !this.currentData
  endif

  if( badref(!location) ) then
    !this.currentData = object DBREF()
    return !this.currentData
  endif

  -- Given location must be within this data set
  if( !location.owner neq !this.dataSet ) then
    !this.currentData = object DBREF()
    return !this.currentData
  endif

  !saveCE = !!ce

  if( !locationQualifier.upcase() eq 'BEFORE' ) then
    !qualifier = 'BEFORE'
  else
    !qualifier = 'AFTER'
  endif

  NEW DATA $!<qualifier> $!<location>
  handle any
    !this.currentData = object DBREF()
  elsehandle none
    !this.currentData = !!ce
  endhandle

  !!ce = !saveCE

  return !this.currentData

endmethod
