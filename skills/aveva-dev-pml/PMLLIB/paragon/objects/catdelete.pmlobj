--    Group:         CATA
--      Keyword:     CATA
--    Module:        Paragon
--  Author:          M.Barlow
--  Created:         Tue Mar 24 14:44:18 2009
--
-- Description:
--  Paragon Delete control object. Paired with form !!paragonDeleteConfirm
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  catDelete()                      -                   Constructor
--  clear()                          -                   Clear members of this form
--  confirmDelete(BOOLEAN,BOOLEAN)   -                   CALLBACK FROM !!paragonDeleteConfirm
--  deleteElement(DBREF,ANY)         -
--  error()                          STRING              Returns last error
--  errors()                         ARRAY               Returns error stack
--  globalInstance()                 -                   Create global instance of object (using !!comDefineGlobal)
--
------------------------------------------------------------------------
--

define object CATDELETE

  -- Elements to delete (array of DBREFs)
  member .deleteList            is ARRAY

  -- Control object. Stored in element 1 of this array because this is
  -- the only way to record an object of ANY type
  member .controlObject         is ARRAY

  -- Error stack (returned from delete manager)
  member .errorStack            is ARRAY

  -- Ask to confirm deletion
  member .askForConfirmation    is BOOLEAN

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:     catDelete
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .catDelete()

  -- Initialise Variables
  !this.askForConfirmation = true

  -- Check that deleteManager has been loaded
  if(undefined(!!deleteManager)) then
    !!deleteManager = object DELETEMANAGER()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object (using !!comDefineGlobal)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .globalInstance()

  -- Create Global Variable
  !!catDeleteManager = !this

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:     deleteElement
--
-- Description: CALLBACK from form delete function
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [ANY]       Object to repair model view after delete
--   [2] [R]    [ANY]       Object to repair model view after delete
--                          MUST PROVIDE .confirmedDelete() method
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteElement(!elementToDelete is DBREF, !controlObject is ANY)

  -- check for DAC and other data access controls
  if( !elementToDelete.dacDel.not() ) then
    !!alert.error('Data Access Control (DAC) does not give you permission to delete ' & !elementToDelete.fullname)
    return
  endif
  if( !!dbrefUpdate(!elementToDelete).not() ) then
    !!alert.error('You do not have permission to delete ' & !elementToDelete.fullname & ' : ' & !!error.text )
    return
  endif

  !this.deleteList       = ARRAY()
  !this.deleteList[1]    = !elementToDelete
  -- Control object. Stored in element 1 of this array because this is
  -- the only way to record an object of ANY type
  !this.controlObject    = ARRAY()
  !this.controlObject[1] = !controlObject

  if( !this.askForConfirmation ) then

    -- Check if elements should be deleted, allowing user to suppress confirmation
    if( undefined(!!paragonDeleteConfirm) ) then
      pml load form !!paragonDeleteConfirm
    endif
    !!paragonDeleteConfirm.caption('OK to delete selected elements?')
    -- blocking form
    show !!paragonDeleteConfirm  at xr0.4 yr0.45

  else

    -- No confirmation required. Delete elements and ask control object to refresh form
    !this.deleteElements()
    !this.clear()

  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     confirmDelete
--
-- Description: CALLBACK FROM !!paragonDeleteConfirm
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [BOOLEAN]   Confirm: YES=true or NO=false
--   [2] [R]    [BOOLEAN]   Show this dialogue again YES=true or NO=false
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .confirmDelete(!confirmDelete is BOOLEAN, !askAgain is BOOLEAN)

  !this.askForConfirmation = !askAgain
  if( !confirmDelete ) then
    -- Perform delete
    !this.deleteElements()
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     clear
--
-- Description: Clear members of this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clear()

  -- Initialise Variables
  !this.deleteList    = ARRAY()
  !this.controlObject = ARRAY()

endmethod
-- End of method

 ------------------------------------------------------------------------
 --
 -- Method:     deleteElements
 --
 -- Description: Delete elements in the list of elements
 --
 -- Method Type: Function/Procedure
 -- Arguments:
 --   [#] [R/RW] [Data Type] [Description]
 -- Return:
 --   [Data Type] [Description]
 --
 ------------------------------------------------------------------------

 define method .deleteElements()

   -- Initialise Variables
   !this.errorStack.clear()

   -- Delete element using standard delete manager
   if(!!deleteManager.dbDelete(!this.deleteList, false)) then
   	 !curele = !!CE
     !this.controlObject[1].confirmedDelete()
     !!CE = !curele
   else
     -- Error in deletion
     !this.errorStack  = !!deleteManager.errors()
     if( defined(!this.errorStack[1])) then
       !!alert.error(!this.errorStack[1][2])
      endif

   endif

 endmethod
 -- End of method

------------------------------------------------------------------------
--
-- Method:     errors
--
-- Description: Returns error stack
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       2D array of element and error
--
------------------------------------------------------------------------

define method .errors() is ARRAY

  return !this.errorStack

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:     error
--
-- Description: Returns last error
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING      Last error message
--
------------------------------------------------------------------------

define method .error() is STRING

  if( defined(!this.errorStack[1])) then
    return !this.errorStack[1][2]
  else
    return ''
  endif

endmethod
-- End of method
