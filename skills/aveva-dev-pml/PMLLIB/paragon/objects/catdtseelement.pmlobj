define object CATDTSEELEMENT
----------------------------------------------------------------------

  -- List of graphical views
  member .headings       is ARRAY
  member .columns        is ARRAY
  member .members        is ARRAY
  member .currentType    is STRING
  member .parameters     is ARRAY
  member .table          is TABLE
  member .report         is REPORT
  member .rtext          is ARRAY
  member .dtext          is ARRAY
  member .purposedtype   is ARRAY
  member .purposertype   is ARRAY
  member .datadefdtype   is ARRAY
  member .datadefrtype   is ARRAY
  -- Saved reference to gadget used to select item to delete
  -- Necessary because of delete confirmation dialogue callback
  member .savedDeleteGadget is GADGET

endobject
-- End of object definition for catDtseElement

----------------------------------------------------------------------
define method .catDtseElement()
----------------------------------------------------------------------

 -- Definitions for Purpose flag setting.
 !this.purposedtype[1] = 'Null'
 !this.purposedtype.append('Design Parameter')
 !this.purposedtype.append('Parameter')
 !this.purposedtype.append('Attribute')
 !this.purposedtype.append('Expression')
 !this.purposedtype.append('Plotfile')
 !this.purposedtype.append('Set Attached Element')
 !this.purposedtype.append('Set Owning Element')
 !this.purposedtype.append('Set Design Param')
 !this.purposedtype.append('Set Attached Despar')
 !this.purposedtype.append('Set Owning Despar')
 !this.purposedtype.append('Set Insulation Params')

 !this.purposertype[1] = 'UNSE'
 !this.purposertype.append('DESP')
 !this.purposertype.append('PARA')
 !this.purposertype.append('ATTR')
 !this.purposertype.append('EXPR')
 !this.purposertype.append('PLOT')
 !this.purposertype.append('ATTA')
 !this.purposertype.append('OWNE')
 !this.purposertype.append('DESI')
 !this.purposertype.append('DATT')
 !this.purposertype.append('DOWN')
 !this.purposertype.append('IPAR')

  --initialise PTYP list
  !this.setPTypes(true)

endmethod
-- End of object definition for catDtseElement
------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method

------------------------------------------------------------------------
define method .globalInstance()
------------------------------------------------------------------------

  -- Create Global Variable
  !!catDtseElement = !this

endmethod



------------------------------------------------------------------------------------------------------------------------
define method .apply(!gadget is GADGET, !element is DBREF)
------------------------------------------------------------------------------------------------------------------------

!form = !gadget.owner()

!form.datapurp.val = !this.purposertype[!form.datadefn.val]

-- remember which one is selected, and pass this to the listCallback later on in here.
!selected = !gadget.val

-- Set the PTYPE Attribute.
!form.dataptyp.val = !form.dataptypeOpt.rtext[!form.dataptypeOpt.val]

-- Now call the form apply method to set attributes.
!!catModelViews.formApply(!form,!element)

if( !element.type eq 'DATA' ) then
  -- check that the key is set
  if( !element.dKey.trim().empty() ) then
    !!alert.warning( 'The property key has not been set. This property cannot be used unless the key field is set')
  else
    -- check for duplicate keys in this data set
    !collection      = object COLLECTION()
    !collection.scope( !element.owner )
    !collection.type( 'DATA' )
    !key             = !element.dKey
    !collection.filter( object EXPRESSION(|DKEY eq '| + !key + |'|) )
    if( !collection.results().size() gt 1 ) then
      !!alert.warning( 'The property key ' + !key + ' has already been used in this Data Set. Property keys should be unique within a Data Set')
    endif
  endif
endif

-- Reset the parameters just in case they have changed and we want to see the effect of that change.
!!catSetModelParams(!form.component)

-- Reload form for Data elements, refresh list.
!form.dtse.setRefs(!!ce.owner,!form.dtseList)
!form.dtseList.val = !selected
!form.dtse.listCallback(!form.dtseList, !form.dtse.table, !selected)

endmethod

------------------------------------------------------------------------------------------------------------------------
define method .listCallback(!gadget is GADGET, !table is TABLE, !row is REAL)
------------------------------------------------------------------------------------------------------------------------
--alpha request clear
-- Dataset Method listCallback. ($!row)
-- Set the fields of the form based on current selected element.
--Used when the user selects from the data set list of elements.

!form    = !gadget.owner()

!unusedTest = $!gadget
handle (2,107)
    -- Element no longer exists, for some other reason, may have been deleted.
    !!catSetCateReferences(!form.compAttribList,'SELECT')
    return
elsehandle (47,62)
endhandle

!element = !this.dtext[!gadget.val]
handle (2,752)
  -- Form is likely empty of members.
endhandle

-- Add check for no members on selected DTSE list.
if (!gadget.dtext.size() EQ 0) then
   -- Grey out the gadgets so we have to create a new one.
   !form.dtseProperty.active = FALSE
   !form.dtsedata.active     = FALSE
   !form.dtsedel.active      = FALSE
   !form.dtseapp.active      = FALSE
   !form.dtsecop.active      = FALSE
    return
endif

!list = !table.row(!row)
!form.datadkey.val = !list[2]
!form.datadtit.val = !list[4]
!form.datadpro.val = !list[6]
!form.datappro.val = !list[7].replace('ATTRIB ','')
!form.datanumb.val  = !list[8]
!form.datalhide.val = !list[10].not()
!form.datapurp.val  = !list[11]
!form.dataptyp.val  = !list[12]

-- Set the form gadget to their respective settings.
!form.datanumb.active  = FALSE
!form.dtsedata.active  = TRUE
!form.datalhide.active = TRUE
!form.datadkey.active  = TRUE
!form.datadkey.visible = TRUE
!form.datarbut.visible = FALSE
!form.datappro.active  = TRUE
!form.datadpro.active  = TRUE
!form.dataptypeOpt.active = TRUE

-- Set the data type option box
!form.dataptypeOpt.val = !form.dataptypeOpt.rtext.findfirst(!form.dataptyp.val)
handle (61,620)
  !form.dataptypeOpt.val = 1
endhandle

-- Set the option gadget to the correct setting for the purpose setting.
if (!form.datapurp.val inset('OWNE', 'ATTA', 'DESI', 'DATT', 'DOWN', 'IPAR')) then

    !form.datadefn.val     = !form.datadefn.rtext.findfirst(!form.datapurp.val)
    !form.datanumb.val     = !form.datappro.val.after('[').before(']').trim().real()
    !form.datanumb.active  = FALSE
    !form.datalhide.active = FALSE
    !form.datalhide.val    = FALSE
    !form.datadkey.active  = FALSE
    !form.datadpro.active  = TRUE
    !form.datarbut.visible = TRUE
    !form.datadkey.visible = FALSE
    !form.dataptypeOpt.active = FALSE

    if !form.datapurp.val.eq('DESI') then
       !form.datanumb.val     = !list[8]
       !form.datanumb.active  = TRUE
    endif


elseif (!form.datapurp.val.eq('DESP')) then

    !form.datadefn.val = !form.datadefn.rtext.findfirst('DESP')
    !form.datanumb.val = !form.datappro.val.after('[').before(']').trim().real()
    !form.datanumb.active = TRUE
    !form.datappro.active = FALSE

elseif (!form.datapurp.val.eq('PARA')) then

    !form.datadefn.val = !form.datadefn.rtext.findfirst('PARA')
    !form.datanumb.val = !form.datappro.val.after('[').before(']').trim().real()
    !form.datanumb.active = TRUE
    !form.datappro.active = FALSE

elseif (!form.datapurp.val.eq('ATTR')) then

    -- Extract attribute name
    !form.datadefn.val = !form.datadefn.rtext.findfirst('ATTR')
    !attributeName     = !list[7].after('ATTRIB').before(')').trim()
    !form.datadkey.val = !attributeName
    !form.datappro.active = FALSE
    !form.dataptypeOpt.active = FALSE

else
  !form.datadefn.val = !this.purposertype.findfirst(!form.datapurp.val)
  handle (61,620)
     !form.datadefn.val = 1
  endhandle

endif

-- Navigate to the selected element.
-- Changed from gadget.val to row to see if that clears problems with apply functioning.

if (!this.rtext[!row].dbref().badref().not()) then
    !!ce = !this.rtext[!row].dbref()
endif

endmethod

------------------------------------------------------------------------------------------------------------------------
define method .options(!first is GADGET, !second is GADGET)
------------------------------------------------------------------------------------------------------------------------
-- -- Set options for the pulldown, choice of type of data elements.
-- !first is the data definition gadget (PURP)
-- !second is the data type gadget (PTYP)

!form     = !first.owner()
!selected = !first.selection()
!dataType = !second.selection()
!dataVal  = !second.val
!numeric  = ( !selected.substring(1,4).upcase() inset('DESP','PARA'))
!this.setPTypes(!numeric.not())

!second.clear()
!second.dtext = !this.datadefdtype
!second.rtext = !this.datadefrtype

!second.val   = !dataVal
handle any
  !second.val = 1
endhandle

-- Deactivate the number field.
   !form.datanumb.active = FALSE
   !form.datappro.active = TRUE
   !form.datadkey.active   = TRUE
   !form.datadpro.active   = TRUE
   !form.dataptypeOpt.active  = TRUE
   !form.datalhide.active  = TRUE
   !form.datadpro.tag =  'Default'
   !form.datappro.tag = 'Expression'
   !form.datadtit.tag      = 'Description'
   !form.datapurp.val      = |UNSE|
   !form.dtsedata.active   = TRUE
   !form.datadkey.visible  = TRUE
   !form.datarbut.visible  = FALSE

    -- Fill in the pprop field with the relevant information.
    !form.datappro.val = ||
     -- Selected String = $!selected

if (!selected.substring(1,4) inset('ATTA', 'OWNE', 'DATT', 'DESI', 'DOWN') ) then

    -- Activate the number field. (Selected String = $!selected )

    if (!selected.substring(1,4).upcase() EQ 'DESI') then
        !form.datanumb.active  = TRUE
    endif

    !form.datappro.active  = FALSE
    !form.dataptypeOpt.active = FALSE
    !form.datadpro.active  = TRUE
    !form.datalhide.active = FALSE
    !form.datadpro.tag     = '    Reference'
    !form.datadkey.active  = FALSE
    !form.datadkey.visible = FALSE
    !form.datarbut.visible = TRUE
    !form.datapurp.val = !selected.substring(1,4).upcase()
    !form.datappro.val = ||

elseif (!selected.substring(1,4).upcase() EQ 'DESP') then
    -- Activate the number field.
    !form.datanumb.active = TRUE
    !form.datappro.active = FALSE

    -- Fill in the pprop field with the relevant information.
    !form.datappro.val = |(DESP [| & !form.datanumb.val & |])|
    !form.datapurp.val = |DESP|

elseif (!selected.substring(1,4).upcase() EQ 'PARA') then
    -- Activate the number field.
    !form.datanumb.active = TRUE
    !form.datappro.active = FALSE

    -- Fill in the pprop field with the relevant information.
    if( !dataType eq 'WORD' ) then
      -- Word type parameter
      !form.datappro.val = |(WPAR [| & !form.datanumb.val & |])|
    else
      -- numeric parameter
      !form.datappro.val = |(PARA [| & !form.datanumb.val & |])|
    endif
    !form.datapurp.val = |PARA|

elseif (!selected.substring(1,4).upcase() EQ 'ATTR') then
    -- Activate the number field.
    !form.dataptypeOpt.active = FALSE
    !form.datappro.active = FALSE

    if (!form.datadkey.val.trim().length().eq(0)) then
      !!alert.error('Please enter required attribute in KEY Field')
    else
      -- Get user input for dkey
      !dkey   = !form.datadkey.val.trim().upcase()

      -- Create an attribute object, extract type and units
      !attrib = object ATTRIBUTE(!dkey)
      !ptype  = !attrib.units()
      !atType = !attrib.type()

      -- Check the user entered value is a valid attribute
      if (!atType.eq('UNKNOWN')) then
        !!alert.error('$!dkey is not a valid attribute')
        !form.datadkey.val = ''
        !form.dataptypeOpt.val = 1
      else

        -- Check the entered attribute is of type real
        if (!atType.eq('REAL')) then
          -- See if attribute has any units
          if (!ptype.eq('NONE')) then
            !ptype = 'REAL'
          endif
          -- Find the attribute units in the data type option list
          !index = !form.dataptypeOpt.rtext.findFirst(!ptype)
          -- If units not in the list set to NULL
          if (!index.unset()) then
            !index = 1
          endif
          !form.dataptypeOpt.val = !index
          -- Fill in the pprop field with the relevant information.
          !form.datappro.val = |(ATTRIB | & !form.datadkey.val & |)|
          !form.datapurp.val = |ATTR|
        else
          -- Return error if attribute is not a REAL
          !!alert.error('Attribute needs to be of type REAL')
          !form.datadkey.val = ''
          !form.dataptypeOpt.val = 1
        endif
      endif
    endif

elseif (!selected.substring(1,4).upcase() EQ 'PLOT') then
    -- Activate the number field.
    !orient[1] = 'Portrait'
    !orient[2] = 'Landscape'
    !second.dtext = !orient
    !second.rtext = !orient

    -- Change the wording of the gadget
    !form.datadpro.tag =  '  Sub-Dir'
    !form.datappro.tag = '             File'
    !form.datalhide.active = FALSE
    !form.datalhide.val    = FALSE

endif

endmethod

------------------------------------------------------------------------------------------------------------------------
define method .swapFrame(!true is GADGET, !false is GADGET,!action is STRING)
------------------------------------------------------------------------------------------------------------------------

-- Hide the data list and show the modify Frame.
!true.visible  = TRUE
!false.visible = FALSE
!form = !true.owner()

if (!action EQ 'SELECT') then
endif

endmethod

------------------------------------------------------------------------------------------------------------------------
define method .new(!gadget is GADGET)
------------------------------------------------------------------------------------------------------------------------
-- Create New DTSE element in hierarchy and repopulate form.

   !form = !gadget.owner()

-- Store the current list position, add one because that is where the new one will be, used later in this method.
   !selected = !gadget.val + 1

-- First attach to element in the gadget we have selected, so element is created in the right place in list.
  if (!gadget.dtext.empty()) then
    -- Find the data set for the current component
    !!ce = !form.component.dtref
    handle any
      !!alert.error('Data Set element not found for this category')
      return
    endhandle
  else
    -- Attach to the selected DATA element if available.
    !!ce = !gadget.selection().dbref()
  endif

-- Create new dtse element here.
  if (!!catModelViews.createNewElement('DATA','AUTONAME')) then

    -- set necessary default attribute values
    !!ce.dKey        = 'UNSE'

    -- Make available the gadgets.
    !form.dtseProperty.active = TRUE
    !form.dtsedata.active     = TRUE
    !form.dtsedel.active      = TRUE
    !form.dtseapp.active      = TRUE
    !form.dtsecop.active      = TRUE

-- Now re-populate the list with the new element, and place yourself there ready for apply.
    !!catSetCateReferences(!form.compAttribList, 'SELECT')

-- Track to element just defined.
    !form.dtseList.val = !selected
    handle (61,620)
      -- None selected
    endhandle
    !form.dtse.listCallback(!form.dtseList, !form.dtse.table, !selected)

  endif

endmethod

------------------------------------------------------------------------------------------------------------------------
define method .cop(!gadget is GADGET)
------------------------------------------------------------------------------------------------------------------------
-- Create New DTSE element in hierarchy and repopulate form.

-- First attach to element in the gadget we have selected, so element is created in the right place in list.
   !form     = !gadget.owner()
   !selected = !gadget.val + 1
   !!ce      = !gadget.selection().dbref()

   -- Create new dtse element here.
    if (!!catModelViews.createNewElement('DATA','COPY')) then

      -- Now re-populate the list with the new element, and place yourself there ready for apply.
         !!catSetCateReferences(!form.compAttribList, 'SELECT')

      -- Track to element just defined.
         !form.dtseList.val = !selected
         !form.dtse.listCallback(!form.dtseList, !form.dtse.table, !selected)
    endif

endmethod

------------------------------------------------------------------------------------------------------------------------
define method .delete(!gadget is GADGET)
------------------------------------------------------------------------------------------------------------------------
-- Delete the selected DATA element in hierarchy and repopulate form.

  -- Get element selected for delete
  !element  = !gadget.selection().dbref()
  handle (2,822)
    !!alert.error('Nothing to delete')
    return
  endhandle

  -- handle unset DBREF caused by clicking on selection being empty
  if( !element.unset() ) then
    !!alert.error('Empty list: Nothing to delete')
    return
  endif

  -- save gadget for form update callback
  !this.savedDeleteGadget = !gadget

  -- verify delete and delete element
  -- This will call back to the .confirmedDelete() method if the delete is successful
  !!catDeleteManager.deleteElement(!element,!this)

endmethod

------------------------------------------------------------------------------------------------------------------------
define method .confirmedDelete()
------------------------------------------------------------------------------------------------------------------------
-- Delete the selected DATA element in hierarchy and repopulate form.
-- TAKE CARE. This is a callback for the paragon delete confirm dialogue
-- Only called if delete is successful and form needs to be updated

  -- Get details of form gadget used to select element to delete
  !form     = !this.savedDeleteGadget.owner()
  !selected = !this.savedDeleteGadget.val

  -- Now re-populate the list with the new element, and place yourself there ready for apply.
  !!catSetCateReferences(!form.compAttribList, 'SELECT')

  -- Reposition the list to one less than we had, as one has just been deleted
  !selected = !selected - 1
  !this.savedDeleteGadget.val = !selected
  handle (61,620)
    -- Handle the situation where we select the zero field.
    !selected = 1
  endhandle
  !form.dtse.listCallback(!form.dtseList, !form.dtse.table, !selected)

endmethod

-------------------------------------------------------------------------------------------------------
define method .setRefs(!element is DBREF, !gadget is GADGET)
-------------------------------------------------------------------------------------------------------
-- Get the members for the given Gmse element and populate the form with these values.

!this.members = !element.member

!form = !gadget.owner()

 -- Define grid control namespace
   using namespace 'Aveva.Pdms.Presentation'

  !coll = object COLLECTION()
  !coll.type(|DATA|)
  !coll.scope(!element)

  !headings = ARRAY()
  !headings.append('type')
  !headings.append('dkey')
  !headings.append('dtitle')
--  !headings.append('description')
--  !headings.append('name')
--  !headings.append('dprop')
--  !headings.append('pprop')
--  !headings.append('number')
--  !headings.append('ruse')
!column = ARRAY()
  !column.append(object column(object expression('Type')  ,true,true,'Type'))
  !column.append(object column(object expression('dkey')  ,true,true,'Dkey'))
  !column.append(object column(object expression('Descr') ,true,true,'Descr'))
  !column.append(object column(object expression('dtitle'),true,true,'Dtitle'))
  !column.append(object column(object expression('name')  ,true,true,'Name'))
  !column.append(object column(object expression('dprop') ,true,true,'DProp'))
  !column.append(object column(object expression('pprop') ,true,true,'PProp'))
  !column.append(object column(object expression('number'),true,true,'Number'))
  !column.append(object column(object expression('ruse')  ,true,true,'Ruse'))
  !column.append(object column(object expression('lhide') ,true,true,'Lhide'))
  !column.append(object column(object expression('purp')  ,true,true,'Purp'))
  !column.append(object column(object expression('ptyp')  ,true,true,'Ptyp'))

  !format = object COLUMNFORMAT()

  !table = object TABLE()
  !table.table(!coll.results(),!column)

  !report = object REPORT(!table)
  !report.addColumn('Type',  !format,'Type')
  !report.addColumn('Dkey',  !format,'Dkey')
  !report.addColumn('Dtitle',!format,'Description')

--  !report.addColumn('Descr', !format,'Descr')
--  !report.addColumn('Name',  !format,'Name')
--  !report.addColumn('DProp', !format,'DProp')
--  !report.addColumn('PProp', !format,'PProp')
--  !report.addColumn('Number',!format,'Numb')

  !gadget.setHeadings(!report.columnHeadings())
  !gadget.setRows(!report.rows())
  !rtext = ARRAY()
  !dtext = ARRAY()

  !report.results(!dtext, !rtext)

  !this.rtext   = !rtext
  !this.dtext   = !dtext
  !this.table   = !table
  !this.report  = !report
  !gadget.rtext = !rtext

  !form.getElement.addToTrack(!form, !rtext, 6)

endmethod

-------------------------------------------------------------------------------------------------------
define method .setPTypes(!nonNumeric is BOOLEAN)
--  Initialise PTYPE option gadget
--  Argument false for numeric types only. Add non-numeric types if true
-------------------------------------------------------------------------------------------------------

  !numeric           = !!comFormats.getNumericPTypeList()
  !dtext             = !numeric[3]
  !rtext             = !numeric[1]
  if( !nonNumeric ) then
    !dtext.append('String')
    !dtext.append('Logical')
    !rtext.append('TEXT')
    !rtext.append('LOG')
  endif
  !this.datadefdtype.clear()
  !this.datadefrtype.clear()
  !this.datadefdtype[1] = 'Null'
  !this.datadefrtype[1] = ''
  !this.datadefdtype.appendArray(!dtext)
  !this.datadefrtype.appendArray(!rtext)
  !this.datadefdtype.append('Word')
  !this.datadefrtype.append('WORD')

endmethod
