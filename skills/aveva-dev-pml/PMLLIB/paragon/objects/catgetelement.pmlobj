elseif (!dbref.type.eq('GMSE')) then

-- Get GMSE Data

elseif (!dbref.type.eq('DTSE')) then

-- Get DTSE Data

endif


endmethod
-------------------------------------------------------------------------------------------------------
define method .fitComponent(!form is FORM, !ce is DBREF)
-------------------------------------------------------------------------------------------------------

-- Grab the limits of the component in question.
!limits = !ce.wvol

if (!limits.set() ) then

    -- Workout and set the limits for the view gadget.
    !vlimits[1] = !limits[1]
    !vlimits[2] = !limits[4]
    !vlimits[3] = !limits[2]
    !vlimits[4] = !limits[5]
    !vlimits[5] = !limits[3]
    !vlimits[6] = !limits[6]

    -- Apply the limits and view the component.
      !form.view.limits     = !vlimits
      handle (61,620)
      endhandle

endif

endmethod

----------------------------------------------------------------------------------------------------
define method .addModel(!form is FORM, !ce is DBREF)
----------------------------------------------------------------------------------------------------

  -- Fit component into graphics window.
  !!catModelViews.limits(!form)

-- Add component to graphical view, deal with drawlist code here too,
-- If disabled then just add to current graphics view.

  if (!form.localDrawlists) then
    !drawlist = !!gphDrawlists.drawlist(!form.drawlist)
    !drawlist.removeAll()
    !drawlist.add(!ce)
  else
    model $!ce
  endif

endmethod

-------------------------------------------------------------------------------
define method .returnFromSearch(!gadget is GADGET,!type is STRING)
-------------------------------------------------------------------------------

!form = !gadget.owner()

-- Set the value in the relevant form.
!gadget.val = !form.returnList.val

-- Now setup the frame ready for use again.
!form.refData.setFrame(!form.returnFrame,!form)

endmethod
