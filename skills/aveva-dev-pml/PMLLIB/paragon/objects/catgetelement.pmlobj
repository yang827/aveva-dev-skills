define object CATGETELEMENT
----------------------------------------------------------------------

  -- List of graphical views
  member .headings       is ARRAY
  member .columns        is ARRAY
  member .modelRtext     is ARRAY
  member .rtext          is ARRAY
  member .dtext          is ARRAY
  member .category       is ARRAY
  member .currentElement is ARRAY
  member .viewBorder     is REAL
  member .viewDirection  is ARRAY
  member .trackElements  is ARRAY
  member .setParameters  is BOOLEAN
  member .highlighted    is DBREF
  member .validElements  is ARRAY

endobject
-- End of object definition for catGetElement

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
