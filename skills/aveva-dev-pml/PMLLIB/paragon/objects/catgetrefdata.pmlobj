-- Define object
define object CATGETREFDATA

  -- List of graphical views
  member .listContents       is ARRAY
  member .parameters         is ARRAY

endobject
-- End of object definition for catGetRefData

--Define Method to get data based on current element type.
-- ===================================================================== G E T   D A T A =============
define method .getData(!element is DBREF, !form is FORM) is ARRAY
-- ===================================================================== G E T   D A T A =============

-- Result is a double array.
-- First argument is the title for the list gadget.
-- Second argument is the contents of the list gadget.
-- Third argument is the contents of the rtext for the list gadget.

!result       = ARRAY()
!result[1]    = ARRAY()
!result[2]    = ARRAY()
!result[2][1] = ARRAY()
!result[2][2] = ARRAY()
!result[3]    = ARRAY()
!result[4]    = ARRAY()
!result[5]    = ARRAY()
!result[5][1] = ARRAY()
!result[5][2] = ARRAY()
!result[5][3] = ARRAY()

!save = !!ce
!!ce = !element

    !result[1].append('Name')
    !result[1].append('Description')

if (!!ce.type.eq('SCOM')) then
    !result[2][1].append(!!ce.gtype)
    !result[2][1].append('Owner')
    !result[2][1].append('Ptref')
    !result[2][1].append('Gmref')
    !result[2][1].append('Dtref')
    !result[2][1].append('Blrfarray')

    !result[2][2].append(!!ce.name)
    !result[2][2].append(!!ce.owner.name)
    !result[2][2].append(!!ce.ptref.name)
    !result[2][2].append(!!ce.gmref.name)
    var !dtref DTREF
    !result[2][2].append(!dtref)
    var !blrf blrfarray of ce
    !result[2][2].append(!blrf)

    var !params split param
    !form.numParams = !params.size()

-- Output references for navigation
    !result[3].append(!!ce.string())
    !result[3].append(!!ce.owner.ref.string())
    !result[3].append(!!ce.ptref.string())
    !result[3].append(!!ce.gmref.string())
    !result[3].append(!dtref)
    !result[3].append(!blrf)

-- Now get the param names and descriptions.
--    var !pas coll all text with matchwild (name , '*PA*') for owner
    !pas = !this.getNumberParams(!!ce.owner)
    var !ste eval stext for all from !pas

    !result[4].append('Number')
    !result[4].append('Data')
    !result[4].append('Description')

    do !pa index !params
       !result[5][1].append(!pa.string())
       !result[5][2].append(!params[!pa].string())
       !result[5][3].append(!ste[!pa])
    enddo

elseif (!!ce.type.eq('SPRF')) then

else
     !!alert.message('$!!ce.type Not coded for from goGetRefData Object')
      !result[1].clear()
      !result[2].clear()
      !result[3].clear()
      !result[4].clear()
      !result[5].clear()

endif

!!ce = !save
return !result

endmethod
-- End of object definition for goGetRefData

--Define Method to get data based on current element type.
-- ==================================================================================================
define method .getList(!element is DBREF, !form is FORM) is ARRAY
-- ==================================================================================================
!save = !!ce

-- Result is a double array.
-- First argument is the title for the list gadget.
-- Second argument is the contents of the list gadget.
-- Third argument is the contents of the rtext for the list gadget.

!!ce = !element
!!alert.message(!!ce.type)

!result       = ARRAY()
!result[1]    = ARRAY()
!result[2]    = ARRAY()
!result[2][1] = ARRAY()
!result[2][2] = ARRAY()
!result[3]    = ARRAY()

--                                    =============== S C O M ==============
if (!!ce.type.eq('SCOM')) then

var !scom coll all scom for owner

    !result[1].append('Name')
       do !par from 1 to !this.getNumberParams(!!ce).size()
          !result[1].append(!par.string())
       enddo

do !ind index !scom

    -- Navigate to the scom in question.
    !!ce = !scom[!ind].dbref()

    -- Set the array entry to match this scom with params.
    !result[2][1].append(!!ce.name.string())
    !result[3].append(!!ce.string())

    var !params split param
   do !par index !params
      !result[2][1 + !par].append(!params[!par])
      handle (2,752)
        !result[2][1 + !par] = ARRAY()
        !result[2][1 + !par].append(!params[!par])
      endhandle
   enddo
enddo

--                                    =============== C A T E ==============
elseif (!!ce.type.eq('CATE')) then

var !cate coll all cate for owner

    !result[1].append('Name')
    !result[1].append('Owner')
    !result[1].append('Description')
    !result[1].append('Purpose')

    !result[2][3] = ARRAY()
    !result[2][4] = ARRAY()

do !ind index !cate

    -- Navigate to the scom in question.
    !!ce = !cate[!ind].dbref()

    -- Set the array entry to match this cate with params.
    !result[2][1].append(!!ce.name.string())
    !result[3].append(!!ce.name.string())
    !result[2][2].append(!!ce.owner.name.string())
    !result[2][3].append(!!ce.description)
    !result[2][4].append(!!ce.purpose)

enddo

--                                    =============== P T S E ==============
elseif (!!ce.type.eq('PTSE')) then

var !ptse split mem

    !result[1].append('Name')
    !result[1].append('Number')
    !result[1].append('Type')
    !result[1].append('Description')
--    !result[1].append('Pconnect')
--    !result[1].append('Pbore')
--    !result[1].append('Pdistance')

    !result[2][3] = ARRAY()
    !result[2][4] = ARRAY()
--    !result[2][5] = ARRAY()
--    !result[2][6] = ARRAY()
--    !result[2][7] = ARRAY()

do !ind index !ptse

    -- Navigate to the scom in question.
    !!ce = !ptse[!ind].dbref()

    -- Set the array entry to match this scom with params.
    !result[2][1].append(!!ce.name.string())

    -- Rtext values
    !result[3].append(!!ce.string())

    !result[2][2].append(!!ce.number.string())
    !result[2][3].append(!!ce.type)
    !result[2][4].append(!!ce.description)
--    !result[2][5].append(!!ce.pconnect)
--    !result[2][6].append(!!ce.pbore)
--    !result[2][7].append(!!ce.pdistance)
--    handle (2,201)
--          !result[2][7].append(' ')
--    endhandle

enddo

--                                    =============== P T S E ==============
elseif (!!ce.type.eq('DTSE')) then

var !dtse split mem

    !result[1].append('Name')
    !result[1].append('Dkey')
    !result[1].append('Pprop')
    !result[1].append('Dprop')
    !result[1].append('Purpose')
    !result[1].append('Dtitle')

    !result[2][3] = ARRAY()
    !result[2][4] = ARRAY()
    !result[2][5] = ARRAY()
    !result[2][6] = ARRAY()

do !ind index !dtse

    -- Navigate to the scom in question.
    !!ce = !dtse[!ind].dbref()

    -- Set the array entry to match this scom with params.
    !result[2][1].append(!!ce.name.string())

    -- Rtext values
    !result[3].append(!!ce.string())

    !result[2][2].append(!!ce.dkey)
    !result[2][3].append(!!ce.pprop)
    !result[2][4].append(!!ce.dprop)
    !result[2][5].append(!!ce.purpose)
    !result[2][6].append(!!ce.dtitle)

enddo
--                                    =============== G M S E ==============
elseif (!!ce.type.eq('GMSE')) then

var !gmse split mem

    !result[1].append('Name')
    !result[1].append('Type')

do !ind index !gmse

    -- Navigate to the scom in question.
    !!ce = !gmse[!ind].dbref()

    -- Set the array entry to match this scom with params.
    !result[2][1].append(!!ce.name.string())

    -- Rtext values
    !result[3].append(!!ce.string())

    !result[2][2].append(!!ce.type)

enddo

else
     !!alert.message(!!ce.type & ' No code found for element in getList method')
endif

!!ce = !save
return !result

endmethod
-- End of object definition for getList

--Define Method to set frame and form gadget visibility
-- ==================================================================================================
define method .setFrame(!type is STRING, !form is FORM)
-- ==================================================================================================

if (!!ce.badref() OR !!ce.owner.badref()) then
    return
endif

-- Set all frames to invisible, then just make the one needed visible.
    !form.dtseframe.visible     = FALSE
    !form.ptrefframe.visible    = FALSE
    !form.plineframe.visible    = FALSE
    !form.compframe.visible     = FALSE
    !form.gmseframe.visible     = FALSE
    !form.gmseapply.visible     = FALSE
    !form.btseapply.visible     = FALSE
    !form.plineapply.visible    = FALSE
    !form.ngmsapply.visible     = FALSE
    !form.dtseapp.visible       = FALSE
    !form.gstrefframe.visible   = FALSE
    !form.ngmsframe.visible     = FALSE
    !form.searchframe.visible   = FALSE
    !form.btseframe.visible     = FALSE
    !form.coreframe.visible     = FALSE
    !form.cateframe.visible     = FALSE
    !form.categoryframe.visible = FALSE
    !form.common.visible        = FALSE
    !form.loopframe.visible     = FALSE

-- Cycle round geometry frames and make them hidden too.
    do !frame value !form.hiddenGadgets
       !form.attribute(!frame).visible = FALSE
    enddo

-- Just deal with parameters here and abort.
if (!type.eq('PARAM')) then
    !form.paramframe.active   = TRUE
    !form.cateframe.visible   = TRUE
    return
endif

if (!type.eq('CATEGORY')) then
    !form.categoryframe.visible = TRUE
    !!catModelViews.setcategory(!form.categoryframe,'SELECT')

elseif (!type.eq('CATE') or !type.eq('STSE') or !type.eq('STCA') or !type.eq('SECT')) then
    !form.cateframe.visible    = TRUE

elseif (!type.eq('PTSE') or !!ce.owner.type EQ 'PTSE') then
    !form.ptrefframe.visible   = TRUE

elseif (!type.eq('PTSS') or !type.eq('PLIN')) then
    !form.common.visible       = TRUE
    !form.plineframe.visible   = TRUE
    !form.plineapply.visible   = TRUE

elseif (!type.eq('GMSS') or !!ce.owner.type EQ 'GMSS') then
    !form.common.visible            = TRUE
    !form.gstrefframe.visible       = TRUE
    !form.attribute(!type).visible  = TRUE
    handle (2,759)
    endhandle

elseif (!type.eq('DTSE') or !type.eq('DATA')) then
    !form.dtseframe.visible   = TRUE
    !form.dtseapp.visible     = TRUE

elseif (!type.eq('GMSE') or !!ce.owner.type EQ 'GMSE' or !!ce.owner.owner.type EQ 'GMSE') then

    !form.common.visible            = TRUE
    !form.gmseframe.visible         = TRUE
    !form.gmseapply.visible         = TRUE
    !form.attribute(!type).visible  = TRUE
    handle (2,759)
    elsehandle (2,766)
        !!alert.confirm('Menus Structure needed for "' & !type & '"')
    endhandle

elseif (!type.eq('NGMS') or !!ce.owner.type EQ 'NGMS') then
    !form.common.visible            = TRUE
    !form.ngmsframe.visible         = TRUE
    !form.ngmsapply.visible         = TRUE
    !form.attribute(!type).visible  = TRUE
    handle (2,759)
    elsehandle (2,766)
        !!alert.confirm('Menus Structure needed for "$!type"')
    endhandle

elseif (!type.eq('SCOM') or !type.eq('JOIN') or !type.eq('SFIT') or !type.eq('SPRF')) then
    !form.compframe.visible   = TRUE

elseif (!type.eq('BTSE') or !type.eq('BLTP')) then
    !form.btseframe.visible   = TRUE
    !form.btseapply.visible   = TRUE

elseif (!type.eq('LIST')) then
    !form.searchframe.visible = TRUE

elseif (!type.eq('PARAM')) then
       !form.paramframe.visible = TRUE

elseif (!type inset('CABCOR','CCORSE')) then
       !form.coreframe.visible = TRUE

else
    !form.attribute(!type).visible  = TRUE
    handle any
      !!alert.message('Need code for ($!type) in catGetRefData Object for frame visibility.')
    endhandle

endif

endmethod
-- End of object definition for goGetRefData

-- ==================================================================================================
define method .getNumberParams(!element is DBREF) is ARRAY
-- ==================================================================================================
!save = !!ce

!!ce = !element
    var !pas coll all text with matchwild (name , '*PA*') for owner

  return !pas
!!ce = !save
endmethod
-- End of object definition for getList

--Define Method to get gtype option list for scom data.
-- ==================================================================================================
define method .getGtype(!element is DBREF) is ARRAY
-- ==================================================================================================
-- Decide what app we are in and decide what gtype files to open.
   !return[1] = !!catModelViews.gtypeComboText
   !return[2] = !!ce.gtyp
   handle (2,201)
     -- Likely Unknown App so return empty array.
     !return = ARRAY()
     return !return
   endhandle

if (!!appCntrl.currentApp.eq('STL')) then

       -- Standard Steelwork Elements.
       !input1 = object FILE('%PDMSDFLTS%/UI-GTYPE-SELEM')

       -- Additional Steelwork Elements.
       !input2 = object FILE('%PDMSDFLTS%/UI-GTYPE-STELEM')

       -- Fittings.
       !input3 = object FILE('%PDMSDFLTS%/UI-GTYPE-FELEM')

       -- Joints.
       !input4 = object FILE('%PDMSDFLTS%/UI-GTYPE-JELEM')

       !list = !input1.readfile()
       !list.appendarray(!input2.readfile())
       !list.appendarray(!input3.readfile())
       !list.appendarray(!input4.readfile())

elseif (!!appCntrl.currentApp.eq('ELEC')) then

       !input = object FILE('%PDMSDFLTS%/UI-GTYPE-TELEM')
       !list  = !input.readfile()

else

       !input = object FILE('%PDMSDFLTS%/UI-GTYPE-PELEM')
       !list  = !input.readfile()

endif

-- Right, now split the list into two groups, what you see and what it is.
do !i value !list.unique().sort()

  -- Ignore comment lines, that start with a hash character.
  skip if (!i.substring(1,1).eq('#'))

  !return.append(!i.split('\')[1])

enddo

  -- Return the sorted list.
  return !return

endmethod
-- End of object definition for getList

-- ==================================================================================================
define method .getRefList(!type is STRING, !name is STRING, !where is STRING, !return is GADGET)
-- ==================================================================================================

     -- Set form gadget name.
     !form = !return.owner()

   -- Check gadget is active before showing search panel.
   if (!form.attribute(!return.name()).active) then

     !form.returnToFrame = !return.name()

     -- Show relevant form.
     !form.refData.setFrame('LIST',!form)

     -- Search Panel actions here.
     !args[1] = '*'
     !args[2] = !where
     !args[3] = !name
     !args[4] = !form
     !form.searchData    = !args
     !form.resultsTarget = !return
     !!catModelViews.initSearch(!args)

    endif

endmethod
-- End of object definition for getList

