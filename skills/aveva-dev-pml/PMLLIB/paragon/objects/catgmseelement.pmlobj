define object CATGMSEELEMENT
-----------------------------------------------------------------------

  -- List of graphical views
  member .headings       is ARRAY
  member .columns        is ARRAY
  member .rtext          is ARRAY
  member .members        is ARRAY

  member .currentFrame   is STRING
  member .listofframes   is ARRAY
  member .plotRequired   is ARRAY
  member .plotSupplied   is ARRAY

  member .currentType    is STRING
  member .currentGadget  is GADGET
  member .repredtext     is ARRAY
  member .reprertext     is ARRAY
  member .nappdtext      is ARRAY
  member .napprtext      is ARRAY
  member .obstdtext      is ARRAY
  member .obstrtext      is ARRAY

endobject
-- End of object definition for catGmseElement

