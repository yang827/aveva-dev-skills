------------------------------------------------------------------------
--
-- Method:      setRefs
--
-- Description: Get the members of the current PTREF and fill out the form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method

-------------------------------------------------------------------------------------------------------
define method .setRefs(!element is DBREF, !gadget is GADGET)
-------------------------------------------------------------------------------------------------------
-- Get the members for the given Gmse element and populate the form with these values.

!form         = !gadget.owner()
!this.members = !element.member
!this.rtext.clear()
!this.columns.clear()

!this.columns[1] = ARRAY()
!this.columns[2] = ARRAY()

do !i value !this.members
   !this.columns[1].append(!i.name)
   !this.columns[2].append(!i.type)
   !this.rtext.append(!i.string())

   -- Check here for negative or sub members of this element.
   !subs = !i.members

   do !sub value !subs
      -- Do not show SLOOP elements in the list. Only the owning extrusion can be modified
      skip if(!sub.type eq 'SLOO')
      !this.columns[1].append(!sub.name)
      !this.columns[2].append('...' & !sub.type)
      !this.rtext.append(!sub.string())
   enddo
enddo

-- Populate the form with the contents recovered.
!gadget.setHeadings(!this.headings)
!gadget.setColumns (!this.columns)
!gadget.rtext     = !this.rtext

-- Now call the reference for the first in the list.
!this.setEdit(!this.rtext[1].dbref(),!gadget)
   handle (2,752)
     -- Mean we haven't any geometry, likely new element.
   endhandle

-- Sort out which frames to show and which to hide.
-- List of frames contains a list of element types which match with frame tags
!this.listofframes = !!ce.list

--P-18961: Added an extra clause to the if, CE could be a negative extrusion in which
--case it is the list of the owner of the owner you want.
if (!!ce.type EQ 'GMSE') then
   !form.gmseCreate.dtext = !!ce.list.sort()
   !form.ngmsCreate.active = FALSE
elseif(!!ce.owner.type EQ 'GMSE') then
   !form.gmseCreate.dtext = !!ce.owner.list.sort()
   !this.listofframes.appendARRAY(!!ce.owner.list)
else
   !form.gmseCreate.dtext = !!ce.owner.owner.list.sort()
   !this.listofframes.appendARRAY(!!ce.owner.list)
   !this.listofframes.appendARRAY(!!ce.owner.owner.list)
endif

!this.listofframes.unique()

-- Add elements to tracking list.
!form.getElement.addToTrack(!form, !this.rtext, 5)

endmethod

-------------------------------------------------------------------------------------------------------
define method .setEdit(!element is DBREF, !gadget is GADGET)
-------------------------------------------------------------------------------------------------------
-- GMSE Having the gadget get entry and set the form edit up ready for use to change things if required.

!form = !gadget.owner()

!!ce = !gadget.selection().dbref()
handle (47,62) (2,822)
  -- No elements left in the list.
  -- set type to the current element
  -- Cannot derive the point set from the P-point list - use the component reference
  !!ce = !form.component.gmref
  handle any
    !!alert.error('Geometry Set element not found for this category')
    return
  endhandle
endhandle

!type = !!ce.type

-- Set the correct visibility for the gadgets here for negative/positive geometry.
!form.ngmsFrame.visible  = FALSE
!form.ngmsApply.visible  = FALSE

!form.gmseFrame.visible  = TRUE
!form.gmseApply.visible  = TRUE

-- Set the current element type in positive geometry list
!form.gmseCreate.val = !form.gmseCreate.dtext.findfirst(!!ce.type)
handle any
endhandle

-- Set the right geometry frame.
!this.setFrame(!form, !type)
handle (2,759)
  -- Wrong element type being shown, as we have no elements in list.
endhandle

-- Check Attribute list for NAPP flag setting.
!attList = !!ce.attList

-- Check to see what element types we can create here, fill out option gadget.
-- Grey out the NAPP flag at this point, if we don't need it
!form.napp.active       = !attList.findfirst('NAPP').set()

-- Grey out the negative option gadget if we have no negative members
if (!!ce.list.size() lt 2 or !!ce.type eq 'GMSE') then
    !form.ngmsCreate.active = FALSE
else
    !form.ngmsCreate.active = TRUE
    !memberTypes           = !!ce.list.sort()
    -- remove SLOOP from the list for SEXT etc.
    !loopIndex = !memberTypes.findfirst('SLOO')
    if( !loopIndex.set() ) then
      !memberTypes.remove(!loopIndex)
    endif
    !form.ngmsCreate.dtext = !memberTypes
endif

-- Fill in the attributes for the appropriate frame/form field.
!!catModelViews.setFormFields(!form, !!ce)

-- Show the plot if required.
!this.showPlot(!form)

endmethod

-------------------------------------------------------------------------------------------------------------------
define method .showPlot(!form is FORM)
-------------------------------------------------------------------------------------------------------------------
-- Show Plot for geometry Type $!!ce.type
-- Display the relevant plot for this geometry type.

!v = !form.name().after('MODELVIEW')

-- First decide what form is shown and which plot to show.

if (unset(!this.plotRequired.findfirst(!!ce.type))) then
     -- No Plot Available
     edit !!modelview$!v$n.plot1 plot
     add "%PDMSUI%/CAT/plot/pgmnoplot"
     exit
else
     -- Plot for Component.
     !displayPlotName = 'add /%PDMSUI%/CAT/plot/' & !this.plotSupplied[!this.plotRequired.findfirst(!!ce.type)]
     edit !!modelview$!v$n.plot1 plot
     $!displayPlotName
        handle (61,251)
              add "%PDMSUI%/CAT/plot/pgmnoplot"
        endhandle
     exit

endif

if (!form.showPlot.val) then
-- Show view gadget.
!form.viewFrame.visible = FALSE

	else
-- Hide view gadget.
!form.viewFrame.visible = TRUE
	endif

endmethod

-- ==================================================================================================
define method .hulapp(!gadget is GADGET, !dummySelect is STRING)
-- ==================================================================================================

!form = !gadget.owner()
!type = !!ce.type

if (!form.attribute(!type & 'hulapp').val) then
    !active = TRUE
else
    !active = FALSE
endif

if (!gadget eq !form.attribute(!type & 'hulapp')) then
    !form.attribute(!type & 'bvsegn').active = $!active
       handle (2,766)
       -- Handle case where we don't have these form fields, at this time for SPRO
       endhandle
    !form.attribute(!type & 'bvcodn').active = $!active
       handle (2,766)
       -- Handle case where we don't have these form fields, at this time for SPRO
       endhandle
    !form.attribute(!type & 'spla').active = $!active
       handle (2,766)
       -- Handle case where we don't have these form fields, at this time for SEXT
       endhandle
endif

endmethod

-- ==================================================================================================
define method .loopOk(!gadget is GADGET, !type is STRING)
-- ==================================================================================================

-- Check to see if we are coming in here from the negative geometry set.
!form         = !gadget.owner()
!lastPosition = !this.currentGadget.val

-- manage visibility of extrusion panels
  !extrusionType = !!ce.type
  !form.sext.visible        = FALSE
  !form.nsex.visible        = FALSE
  !form.srev.visible        = FALSE
  !form.nsre.visible        = FALSE
  if( !extrusionType eq 'NSEX' ) then
  !form.sext.visible        = TRUE
  elseif( !extrusionType eq 'SEXT' ) then
    !form.nsex.visible      = TRUE
  elseif( !extrusionType eq 'SREV' ) then
    !form.srev.visible      = TRUE
  elseif( !extrusionType eq 'NSRE' ) then
    !form.nsre.visible      = TRUE
  endif
  !form.common.visible      = TRUE
  !form.ngmsFrame.visible   = FALSE
  !form.gmseFrame.visible   = FALSE
  !form.loopFrame.visible   = FALSE

-- Decide where we came from and set the appropriate owner in menus.
!types[1] = 'NGMS'
if (!!dtbOwnerOfTypes(!!ce,!types).set()) then
  !form.ngmsFrame.visible   = TRUE
else
  !form.gmseFrame.visible   = TRUE
endif

-- Reselect the form to reflect current state.
-- Reset the lower lists to those elements left.
!!catSetCateReferences(!form.compAttribList,'SELECT')

-- Reinstate current element, because the previous call will have changed this.
if (!this.currentGadget.count GT 0) then
  !this.currentGadget.val = !lastPosition
endif

!!catmodelviewsGetList(!this.currentGadget, 'SELECT')

endmethod

-------------------------------------------------------------------------------------------------------
define method .setFrame(!form is FORM, !item is STRING)
-------------------------------------------------------------------------------------------------------
-- Set Frame for geometry Type $!item
-- Having the gadget get entry and set the form edit up ready for use to change things if required.

-- Hide all the geometry frames.
!this.listofframes.appendARRAY(!!ce.list)
!this.listofframes.unique()

do !frame value !this.listofframes
   !form.attribute(!frame).visible = FALSE
   handle (2,759) (2,766)
    -- ignore frames not found for this element type
   endhandle
enddo

-- handle special case for SLOOP elements
  if (!item EQ 'SLOO') then

    !form.loopFrame.visible = TRUE
    !form.common.visible    = FALSE
    !form.nsex.visible      = FALSE
    !form.sext.visible      = FALSE
    !form.nsre.visible      = FALSE
    !form.srev.visible      = FALSE
    -- Hide certain gadgets, to stop them being pressed.
    !form.ngmsApply.visible = FALSE
    !form.gmseApply.visible = FALSE
    !form.gmseFrame.visible   = FALSE
    !form.ngmsFrame.visible   = FALSE
    !form.gstrefFrame.visible = FALSE

   else

     -- Now set frame visibility for this element type ($!item).
     !form.attribute(!item).visible = TRUE
     handle (2,766)
       !!alert.message('Frame not defined for $!!ce.type (Looking for Gadget "$!item")')
     endhandle

   endif

endmethod

------------------------------------------------------------------------------------------------------
define method .loadRepresentation(!dtext is ARRAY, !rtext is ARRAY)
------------------------------------------------------------------------------------------------------

!this.repredtext = !dtext
!this.reprertext = ARRAY()
 do !i index !rtext
   !this.reprertext[!i] = !rtext[!i].replace('\', ',')
 enddo

 !this.repredtext.insert(1, 'Unknown')
 !this.reprertext.insert(1, '0,10,0,false,false')

endmethod


-----------------------------------------------------------------------------------------------------------
define method .copyGeometry(!gadget is GADGET, !type is STRING)
-----------------------------------------------------------------------------------------------------------
-- Load object with appropriate settings for the representation list in gadgets.
!form = !gadget.owner()
!!ce  = !type.dbref()
handle any
  !!alert.error('Cannot copy: No element selected')
  return
endhandle

-- Show plot of the geometry to be created.
!this.showPlot(!form)

-- Turn off AutoNaming if switched on.
    !turnNamingOn = FALSE
if (!!namOptEdit.data.auto) then
    !!namOptEdit.data.auto = FALSE
    !turnNamingOn = TRUE
endif

-- Create a new $!type here.
!create = !!catModelViews.createNewElement(!!ce.type,'COPY')

if (!create EQ FALSE) then
    return
endif

-- Turn it back on again, if required.
if (!turnNamingOn) then
    !!namOptEdit.data.auto = TRUE
endif

-- Now set the attributes in the form.
!newRef = !!ce.string()
!this.updateSelection(!gadget,!newRef)

-- Display plot if necessary.
!this.showPlot(!form)

endmethod

-----------------------------------------------------------------------------------------------------------
define method .createNewPrim(!gadget is GADGET, !type is STRING)
-----------------------------------------------------------------------------------------------------------
-- Load object with appropriate settings for the representation list in gadgets.
!form = !gadget.owner()

-- Save position for later use.
!position = !gadget.val

-- Show plot of the geometry to be created.
!this.showPlot(!form)

-- Set the right geometry frame for the type of element to be created.
!this.setFrame(!form, !type)

-- Turn off AutoNaming if switched on.
    !turnNamingOn = FALSE
if (!!namOptEdit.data.auto) then
    !!namOptEdit.data.auto = FALSE
    !turnNamingOn = TRUE
endif

-- Create a new $!type here.
!create = !!catModelViews.createNewElement(!type,'AUTONAME')

if (!create EQ FALSE) then
    return
endif

-- Turn it back on again, if required.
if (!turnNamingOn) then
    !!namOptEdit.data.auto = TRUE
endif

-- Now set the attributes in the form.
-- turn on tube flag by default, allowing for any element that does not have this attribute
if( !type inset('LINE','SLINE') ) then
  -- default to CL on for LINE elements
  CLFLAG TRUE
else
  TUFLAG TRUE
  handle any
  endhandle
endif
!newRef = !!ce.string()
!this.updateSelection(!gadget,!newRef)

-- Display plot if necessary.
!this.showPlot(!form)

endmethod

---------------------------------------------------------------------------------------------------------
define method .updateSelection(!gadget is GADGET, !newReference is STRING)
---------------------------------------------------------------------------------------------------------
  -- Update selection after new element created

  !form = !gadget.owner()

  -- Now set the attributes in the form.
  !!catModelViews.setFormFields(!form, !!ce)

  -- Reset the lower lists to those elements left.
  !!catSetCateReferences(!form.compAttribList,'SELECT')

  -- Return to previous selection position.
  !gadget.select('RTEXT',!newReference)
  handle any
    !gadget.val = 1
  endhandle

  -- Set the form so it reflects the element we have just created.
  !!catmodelviewsGetList(!gadget, 'SELECT')

endmethod

---------------------------------------------------------------------------------------------------------
define method .deletePrim(!gadget is GADGET)
---------------------------------------------------------------------------------------------------------
-- Delete primitive selected in supplied list gadget.
!form = !gadget.owner()

-- Navigate to element selected.
!!ce = !gadget.selection().dbref()

-- Remember where we are in the list, and return to that position after deletion.
!position = !gadget.val

-- Now delete the element
DELETE $!!ce.type

-- Reset the lower lists to those elements left.
!!catSetCateReferences(!form.compAttribList,'SELECT')

-- Return to previous selection position.
if (!position GE 2) then
    !gadget.val = !position - 1
    !!ce = !gadget.selection().dbref()
endif


endmethod

------------------------------------------------------------------------------------------------------------------------------
define method .setVertices(!gadget is GADGET, !element is DBREF, !listGadget is STRING)
------------------------------------------------------------------------------------------------------------------------------
-- Load object with appropriate vertices from a given extrusion element.

!form               = !gadget.owner()
!this.currentGadget = !form.attribute(!listGadget)

-- Set the ce from the selection in the list gadget
!!ce = object DBREF(!this.currentGadget.selection())

handle any
  -- test for current element owned by element with vertices
  if (!element.type inset('SPVE','SLOO')) then
    !!ce = !element.owner
  elseif (!element.type eq 'SVER') then
    !!ce = !element.owner.owner
  else
    !!ce = !element
  endif
endhandle

-- Hide certain gadgets, to stop them being pressed.
!form.ngmsApply.visible = FALSE
!form.gmseApply.visible = FALSE

-- Set the current type ready for dealing with different forms.
!form.gmse.currentType = !!ce.type

-- Get rows as results from the existing loop vertices.
if (!!ce.type EQ 'SPRO') then
  -- Profile elements
  VAR !pointList COLLECT ALL SPVE FOR CE
elseif (!!ce.type.subString(1,1) eq 'N') then
  -- Negative primitive
  VAR !pointList COLLECT ALL SVER FOR CE
else
  -- Positive primitive. Make sure that member negative vertices are not found
  !saveCE = !!ce
  SLOOP 1
  handle any
    !pointList = ARRAY()
  elsehandle none
    VAR !pointList COLLECT ALL SVER FOR CE
  endhandle
  !!ce = !saveCE
endif

-- Define grid control namespace
   using namespace 'Aveva.Pdms.Presentation'
  !rows = ARRAY()
  !desc = 'Points'
  !headings[1] = 'Ref'
  !headings[2] = 'Name'
  !headings[3] = 'PX'
  !headings[4] = 'PY'
  !headings[5] = 'PRAD'
  if (!!ce.type EQ 'SPRO') then
      !headings[6] = 'DX'
      !headings[7] = 'DY'
      !headings[8] = 'DRAD'
  endif

-- Try and Navigate to the first element in the list, if this fails we have no points.
   if( !pointList.empty() ) then
     -- No vertices in the list. Try to create one.
     if (!element.type EQ 'SPRO') then
        NEW SPVE
     else
        NEW SLOO
        NEW SVER
     endif
     !points[1] = !!ce
   else
     -- Convert the list of string variables into a list of DBREF.
     !points = !pointList.evaluate(object block(|!pointList[!evalIndex].dbref()|))
   endif

-- Cycle round the points found, removing the ATTRIB word to make the statements look clearer.
  do !i index !points
     !rows[!i] = ARRAY()
     !rows[!i][1] = !points[!i].string()
     !rows[!i][2] = !points[!i].name
     !rows[!i][3] = !points[!i].px.replace('ATTRIB ','')
     !rows[!i][4] = !points[!i].py.replace('ATTRIB ','')
     !rows[!i][5] = !points[!i].prad.replace('ATTRIB ','')
     if (!!ce.type EQ 'SPRO') then
       !rows[!i][6] = !points[!i].dx.replace('ATTRIB ','')
       !rows[!i][7] = !points[!i].dy.replace('ATTRIB ','')
       !rows[!i][8] = !points[!i].drad.replace('ATTRIB ','')
     endif
  enddo

  !contents = object NETDATASOURCE(!desc, !headings, !rows)

  !form.sextLoop.bindToDataSource(!contents)

  -- hide the reference column to be used for unique ID and navigation
  !form.sextLoop.setColumnVisibility(1,false)

-- Display the loop frame so the user can modify the points.
!this.setFrame(!form, 'SLOO')

endmethod

-----------------------------------------------------------------------------------------------------------
define method .vertexValue(!form is FORM, !data is ARRAY)
-----------------------------------------------------------------------------------------------------------
-- issue the parameter to the loop we are currently sitting on, and the position of the vertex we have just changed.

-- Attach to element in grid
!vertexRef = !form.sextLoop.getRow(!data[1].real())[1]
!!ce = !vertexRef.dbref()
handle any
  -- catch case where user has deleted element while it is displayed in the list
  !!alert.error('Cannot find this vertex. Please refresh the data on this form')
  return
endhandle

-- reinstate value from DB if field is cleared
!expression = !data[0].trim()
if( !expression.empty() ) then
  !!alert.error('You must enter a valid value or expression for this field')
  !data[3] = false
  return
endif

-- setup command to modify the vertex
!cmnd = !data[2] + ' ( ' + !expression + ' )'

-- issue command for changing attributes on vertex
$!cmnd
-- ILLEGAL USE OF STRING DELIMITER '
handle (47,15) (16,19) (47,62)
  !!alert.error(!!error.text + ': ' + !!error.command)
  !data[3] = false
elsehandle  (2,404)
  -- illegal expression
  !!alert.error(!!error.text + ': ' + !cmnd)
  !data[3] = false
elsehandle any
  !!alert.error(!!error.text + ': ' + !!error.command)
  !data[3] = false
endhandle
-- Make sure that CE is reinstated after the command has been issued
!!ce = !vertexRef.dbref()

endmethod

-------------------------------------------------------------------------------------------------------------
define method .moveVertex(!form is FORM, !gadget is ANY, !direction is STRING)
-------------------------------------------------------------------------------------------------------------
-- Move a vertex up or down the list being edited.

-- Nothing selected.
if (!gadget.getSelectedRows().empty()) then
    !!alert.message('No Vertex has been selected')
    return
endif

-- Trying to move the start backwards.
if (!direction EQ 'BEFORE' and !gadget.getSelectedRowTags()[1].real() EQ 1) then
    !!alert.message('Vertex is already at the start')
    return
endif

-- Trying to move the end forwards.
if (!direction EQ 'AFTER' and !gadget.getSelectedRowTags()[1].real() EQ !gadget.getRows().size()) then
    !!alert.message('Vertex is already at the end')
    return
endif

!position    = !gadget.getSelectedRowTags()[1].real()

-- Move to new position and reload form contents.
end

if (!direction EQ 'BEFORE') then
             !newPosition = !position - 1
    reorder $!position $!direction $!newPosition
else
             !newPosition = !position + 1
    reorder $!position $!direction $!newPosition
endif

-- Reinstate the list to reflect new list.
   if (!!ce.owner.type eq 'SPRO') then
      !this.setVertices(!gadget, !!ce.owner, 'gstreflist')
   else
      !this.setVertices(!form.loopcont, !!ce,  'gmreflist')
   endif

-- Program select the row that this is in now.
!gadget.selectRow(!newPosition)

endmethod

-----------------------------------------------------------------------------------------------------------
define method .newVertex(!gadget is GADGET, !action is STRING)
-----------------------------------------------------------------------------------------------------------
-- issue the parameter to the loop we are currently sitting on, and the position of the vertex we have just changed.
--$!gadget
!form = !gadget.owner()

-- get selected vertex
!selectedRow = !form.sextLoop.getSelectedRows()
if( !selectedRow.empty() ) then
  !!alert.error('Please select a vertex in the list')
  return
endif
-- get selected vertex DBREF
!selectedVertexRef = !selectedRow[1][1]
!!ce = !selectedVertexRef.dbref()
handle any
  -- this should only happen if the user has deleted a vertex while it is displayed in the list
  !!alert.error('Cannot find selected vertex. Please refresh the list')
  return
endhandle
!type = !!ce.type

if (!action EQ 'NEW') then
    NEW $!type
elseif (!action EQ 'COPY') then
    NEW $!type COPY PREV
endif

!sequence = !!ce.sequence
-- Reinstate list.
   !types[1] = 'NGMS'
   if (!!ce.owner.type eq 'SPRO') then
      !this.setVertices(!gadget, !!ce.owner, 'gstreflist')
   elseif (!!dtbOwnerOfTypes(!!ce,!types).set()) then
      -- negative geometry list
      !this.setVertices(!gadget, !!ce.owner.owner, 'ngmreflist')
   else
      -- positive geometry list
      !this.setVertices(!gadget, !!ce.owner.owner, 'gmreflist')
   endif

-- Select the one we have just made in the list.
   !form.sextLoop.selectRow(!sequence)

-- Refresh View.
   !form.view.refresh()

endmethod

-----------------------------------------------------------------------------------------------------------
define method .delVertex(!gadget is GADGET, !action is STRING)
-----------------------------------------------------------------------------------------------------------
-- issue the parameter to the loop we are currently sitting on, and the position of the vertex we have just changed.

$!gadget

!form      = !gadget.owner()
if (!form.sextLoop.getSelectedRowTags().empty()) then
    !!alert.error('No vertex selected for deletion')
     return
endif

-- Attach to selected vertex.
!vertexRef = !form.sextLoop.getRow(!form.sextLoop.getSelectedRowTags()[1].real())[1]
!!ce       = !vertexRef.dbref()
handle any
  -- catch case where user has deleted element while it is displayed in the list
  !!alert.error('Cannot find this vertex. Please refresh the data on this form')
  return
endhandle

!type      = !!ce.type
-- find out if in positive or negative geometry set
!types[1]  = 'GMSE'
!types[2]  = 'NGMS'
!types[3]  = 'GMSS'
!setOwner  = !!dtbOwnerOfTypes(!!ce,!types)
!position  = !form.sextLoop.getSelectedRowTags()

!isOnlyPoint = !form.sextLoop.getRows().size().eq(1)

-- Delete this vertex
!owner = !!ce.owner.type
DELETE $!!ce.type

if (!isOnlyPoint) then
   -- Best delete the owner here too - but not for SPRO
   if( !owner neq 'SPRO' ) then
     DELETE $!owner
   endif

   -- Now carry out loop ok button to return to geometry list.
   !this.loopOk(!gadget, 'SELECT')

   -- No need to do anything else here and return.
   return
endif

-- Reinstate list.
if( !setOwner.type.unset() ) then
  !this.setVertices(!gadget, !!ce,  'gmreflist')
else
  if( !setOwner.type eq 'GMSE' ) then
        !this.setVertices(!gadget, !!ce,  'gmreflist')
  elseif( !setOwner.type eq 'NGMS' ) then
        !this.setVertices(!gadget, !!ce,  'ngmreflist')
  elseif( !setOwner.type eq 'GMSS' ) then
      !this.setVertices(!gadget, !!ce, 'gstreflist')
   else
      !this.setVertices(!gadget, !!ce,  'gmreflist')
  endif
 endif

-- Refresh View.
--!form.view.refresh()
!!catModelViews.updateAllViews()

!form.sextLoop.selectRow(!position)
handle any
endhandle

endmethod

-----------------------------------------------------------------------------------------------------------
define method .setRepresentation(!gadget is GADGET)
-----------------------------------------------------------------------------------------------------------
-- Set the relevant gadgets to the settings in the representation gadget, use the rtext value and split
-- it up into its parts separated by the comma.

!form = !gadget.owner()
!list = !gadget.rtext[!gadget.val].split(',')

!form.leve1.val = !list[1].real()
!form.leve2.val = !list[2].real()

!form.obst.val  = !form.obst.rtext.findfirst(!list[3])

!form.clfl.val  = $!list[4]
!form.tufl.val  = $!list[5]

endmethod
