    exit

    --===============================================          ============================================================
    --                                           Category Attributes
    --===============================================          ============================================================
    -- Swap out panels here.. for various outputs.
    frame .categoryFrame panel '' at x 0.25 ymax.outside + .2         anchor left + right + bottom
       para .categoryRefPara at x0.5 y0.25 text 'Category:'
       para .categorydbrefno at xmax.categoryRefPara ymin text '                                                                   '
       text .catename '           Name'     at x1 Y1.5 anchor left                      tagwidth 10      width 33 is STRING
       text .catedesc ' Description'        at x1 Y2.5 anchor left                      tagwidth 10      width 33 is STRING
       text .catefunc '    Function'        at x1 Y3.5 anchor left                      tagwidth 10      width 33 is STRING
       text .catepurp '     Purpose'        at x1 Y4.5 anchor left                      tagwidth 10      width 33 is STRING
       combo .categoryField2 'Generic Type' at x1 Y5.5 anchor left                      tagwidth 10      width 25

--=============================================== STEEL ===========================================================
    if (!curApp eq 'STL' or !curApp eq 'HVAC' or !curApp eq 'EQUI' or !curApp eq 'ACCO') then
       text .categoryField3 ' P-Point Set' at x48 Y1.5  anchor left                     tagwidth 10      width 28 is STRING
       text .categoryField4 '+ve Geometry' at x48 Y2.5  anchor left                     tagwidth 10      width 28 is STRING
       text .categoryField6 '-ve Geometry' at x48 Y3.5  anchor left                     tagwidth 10      width 28 is STRING
       text .categoryField5 '    Data Set' at x48 Y4.5  anchor left                     tagwidth 10      width 28 is STRING
       text .categoryField7 '  P-Line Set' at x48 Y5.5  anchor left                     tagwidth 10      width 28 is STRING

       button .categoryAction6 ' ' at xmax.categoryField6 ymin.categoryField6  anchor left pixmap width 16 height 16   width 16
       button .categoryCeField6 'CE'   at xmax.categoryAction6 ymin.categoryAction6 anchor left                        width 2

       button .categoryAction7 ' '   at xmax.categoryField7 ymin.categoryField7 anchor l pixmap          width 16 height 16
       button .categoryCeField7 'CE' at xmax.categoryAction7 ymin.categoryAction7 anchor left            width 2

--=============================================== P I P I N G ===========================================================
  else
       text .categoryField3 ' P-Point Set' at x48 Y1.5  anchor left                     tagwidth 10      width 28 is STRING
       text .categoryField4 'Geometry Set' at x48 Y2.5  anchor left                     tagwidth 10      width 28 is STRING
       text .categoryField5 '    Data Set' at x48 Y3.5  anchor left                     tagwidth 10      width 28 is STRING
  endif
--=======================================================================================================================

