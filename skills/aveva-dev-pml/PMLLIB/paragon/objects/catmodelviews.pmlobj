------------------------------------------------------------------------
--
-- Method:      netResultsSelected
--
-- Description: Select the specified rows on the specified form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
--    2   R      ARRAY       Rows to be selected
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netResultsSelected(!form is FORM, !rows is ARRAY)
------------------------------------------------------------------------

  -- Save search results as DBREF's
  !dbRefNos = ARRAY()
  do !val values !rows
    !dbRefNos.append(!val)
  enddo
  !form.searchResults = !dbRefNos.evaluate(object BLOCK(|!dbRefNos[!evalIndex].dbref()|))

endmethod
-- End of method definition for .netResultsSelected(FORM, ARRAY)

------------------------------------------------------------------------
define method .recent(!form is FORM, !element is STRING)
------------------------------------------------------------------------

-- Turn off tracking here, to stop the forms from updating.
   if (!!catModifyAttribs.track.val) then
        !!catModifyAttribs.track.val = FALSE
   endif
-- Set current element to that selected from option pulldown.
  !!ce = !element.dbref()
  handle (2,109)

    !!alert.error(!!error.text)

    !ans = !!alert.question('Remove this item from the recent list?')

    if (!ans EQ 'YES') then
        !temp = !form.recent.dtext
        !temp.remove(!form.recent.val)
        !form.recent.dtext = !temp
    endif

  elsehandle none

     -- Now call the setCe method to initialise the menu layout.
    !this.setCe(!form.compAttribList, 'SELECT')
    !form.recent.select('DTEXT', !element)
  endhandle

endmethod
-- End of method definition for .recent option gadget

------------------------------------------------------------------------
define method .category() is DBREF
------------------------------------------------------------------------
-- return the owning hierarchy name.

   CATE
   handle (2,111)
         STCA
         handle (2,111)
             SECT
             handle (2,111)
               STSE
               handle (2,111)
               endhandle
             endhandle
         endhandle
   endhandle

return !!ce

endmethod
-- End of method definition for .category option gadget

------------------------------------------------------------------------
define method .selectCe(!gadget is GADGET, !selected is ARRAY)
------------------------------------------------------------------------

-- Sets up the forms based on the user pressing the CE button on the model view form.
-- Set the form element to be the SCOM selected or one found if not at an SCOM.

!form            = !gadget.owner()
!form.formTitle  = !this.getFormTitle(!form)
!form.helpcontextid     = 'HID_CATMODELVIEW'
!form.parentType = !this.category()
handle(2,758)
  -- This might be because we are selecting and none valid parent type, or out of step category.
  return
endhandle

!list = !form.getElement.setList(!form, !form.component.type)
if (!list[1] EQ 'None') then
    return
endif

-- Set the references into the store
!form.getElement.getRefs(!form.component,!list)

-- Set the lists to saved data.
!form.getElement.setList(!form.compAttribList)

-- Save the current rtext state of the form just filled up.
!form.getElement.modelRtext = !form.getElement.rtext

-- Load model parameters if present in the DATA Set.
!!catSetModelParams(!form.component)

-- Add elements to tracking list.
!form.trackedElements.clear()
!form.getElement.addToTrack(!form, !form.getElement.modelRtext, 1)

-- Turn off setting the grid control up, as this causes a double selection and looses the selection.
!form.getElement.setParameters = FALSE

-- Set the lists to saved data.
!form.getElement.getParams(!form.params1,!form.component)

-- Add the component to the graphics window.
!form.getElement.addModel(!form, !form.component)

-- Treat this as someone pressing the first in the list, setting the lower pane values.
!!catSetCateReferences(!form.compAttribList,'SELECT')

endmethod

------------------------------------------------------------------------
define method .setCategory(!gadget is GADGET, !action is STRING)
------------------------------------------------------------------------
-- Category form, fills out category information, when this frame is shown.

!form    = !gadget.owner()

!this.setFormFields(!form, !!ce)

endmethod

------------------------------------------------------------------------
define method .getFormTitle(!form is FORM) is STRING
------------------------------------------------------------------------

!return  = |Model View: | & !!ce.prmown.namn & | > | & !form.component.name & ' - ' & !form.component.desc

return !return

endmethod

------------------------------------------------------------------------
define method .setCe(!gadget is GADGET, !action is STRING)
------------------------------------------------------------------------
-- Sets up the forms based on the user pressing the CE button on the model view form.
-- Set the form element to be the SCOM selected or one found if not at an SCOM.

if (!action.eq('UNSELECT')) then
    return
endif

-- Set form.
   !form    = !gadget.owner()

-- Save the CE
!savedCe = !!ce

-- Make sure the current element is one of the list, if we are not at one go find one
!tempComponent = !form.getElement.setCe(!form.component)
if( badref(!tempComponent) ) then
    !!alert.error(|Can't find a valid component element from here|)
    return
endif

!form.component = !tempComponent
!!ce = !tempComponent

!categoryPurpose = PURP OF CATE
handle any
  !categoryPurpose = PURP OF OWNER
    handle any
      !categoryPurpose = ''
    endhandle
endhandle

-- Set the sub Type, used to choose different edit types
!!catModelViews.type = !categoryPurpose
!form.subType        =  !categoryPurpose

--Set the current type for the scom.
--This alters what attributes are set by the scom.
if (!form.subType.set()) then
  !form.scom.currentType = !form.subType
endif

-- clear parameter name field
!form.paramStex.val = ''

-- If the new CE is already listed in the category table, select it without
-- reloading all the references etc. The exception is if a parameter has changed
-- in which case the table must be rebuilt
!names = !form.cateTable.getColumn(|Name|)
!row = !names.findFirst(!savedCe.namn)
if (!row.set() AND !action NE 'PARAMCHANGE') then
  !!catModelViews.selectCe(!form.compAttribList, !form.cateTable.getSelectedRows())
  !!ce = !savedCe

  -- Select the appropriate row of the table but first disable events so that selectCE
  -- doesn't get called again. Using selectCE, followed by SelectRow in this way stops
  -- the CE flashing on the Catalogue Explorer
  !form.cateTable.allGridEvents(false)
  !form.cateTable.selectRow(!row)
  !form.cateTable.allGridEvents(true)
else  $* Element not found in the category table so reset everything
  -- Set list of references.
  !list = !form.getElement.setList(!form, !form.component.type)
  if (!list[1] EQ 'None') then
      return
  endif

  -- Set form title.
  !form.formTitle  = !this.getFormTitle(!form)

  -- Set the references into the store
  !form.getElement.getRefs(!form.component,!list)

  -- Set the lists to saved data.
  !form.getElement.setList(!form.compAttribList)

  -- Save the current rtext state of the form just filled up.
  !form.getElement.modelRtext = !form.getElement.rtext

  -- Load model parameters if present in the DATA Set.
  !!catSetModelParams(!form.component)

  -- Add elements to tracking list.
  !form.trackedElements.clear()
  !form.getElement.addToTrack(!form, !form.getElement.modelRtext, 1)

  -- Set the lists to saved data.
  !form.getElement.getParams(!form.params1,!form.component)

  -- Add the component to the graphics window.
  !form.getElement.addModel(!form, !form.component)

  if( !form.component.badref().not() ) then
    if( !form.component.type eq 'SPRF' ) then
      !array[1] = 0
      !array[2] = 1
      !array[3] = 0
      -- Set -Z View Direction for SPRF
      !form.view.direction = !array
      !array[1] = 0
      !array[2] = 0
      !array[3] = -1
      -- Set -Z View Direction for SPRF
      !form.view.direction = !array
    endif
  endif

  -- Treat this as someone pressing the first in the list, setting the lower pane values.
  !!catSetCateReferences(!form.compAttribList,'SELECT')

  -- Add this category to the recent list gadget on the form.
  !form.getElement.addToRecent(!form, !this.category())

  -- Select the appropriate row of the table and then restore the CE
  !names = !form.cateTable.getColumn(|Name|)
  !row = !names.findFirst(!savedCe.namn)
  if (!row.unset()) then
    !row = 1
  endif
  -- Select the appropriate row of the table, disabling events first
  !form.cateTable.allGridEvents(false)
  !form.cateTable.selectRow(!row)
  !form.cateTable.allGridEvents(true)

  !!ce = !savedCe

  -- Set the frame to be the first frame in the list.
  --!form.refData.setFrame(!form.component.type, !form)
endif

endmethod

------------------------------------------------------------------------
--
-- Method:      getElement
--
-- Description: Method to return an element that will be the current element.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element type required.
--    2   R      GADGET      Gadget the selection of where we are now is contained.
-- Return:
--   Element Current element that is the required type.
--
------------------------------------------------------------------------
define method .goGetElement(!type is STRING, !gadget is GADGET) is DBREF
------------------------------------------------------------------------

-- try and find the required element type from here by looking locally, before
-- navigating.
!save = !!ce

 do from 1 to 10
  !!ce = !gadget.selection().dbref()
  handle (2,822)
      end
     var !list coll all $!type for ce
     $!list[1]
     handle (2,752)
       skip
     endhandle
  elsehandle none
  endhandle
 enddo

  !return = !!ce

!!ce = !save
return !return

endmethod
-- End of method definition for .showSearch(FORM)


