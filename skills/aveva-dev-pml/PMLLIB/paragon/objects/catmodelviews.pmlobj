       button .cateCopy   'Copy'       at xmax.cateCreate+1 y 11.2          anchor left                     width 7
       button .cateImpo   'Import...'  at xmax.cateCopy+1 y 11.2            anchor left                     width 7
       button .cateExpo   'Export...'  at xmax.cateImpo+1 y 11.2            anchor left                     width 7
       text   .cateComp   ' '          at xmax.cateExpo+1 Y 11.2            anchor left                     width 1 is STRING
    exit

    --===============================================          ============================================================
    --                                                  BLRF
    --===============================================          ============================================================
    frame .btseFrame panel '' at x 0.25 ymax.outside + .2            anchor left + right + bottom
       list .btseList |Bolting References | at y0.3      anchor left height 12           width 34

      frame .bltpFrame panel at x36 y1 anchor left + right width 56 height 8.0
         rtoggle .btsesame  'No of Identical Bolts (BTSE)'           at x8                    tagwidth 20 states 'OFF' 'SAME'
         rtoggle .btsediff  'Individual Bolts (BLTP)'                at xmax ymin             tagwidth 20 states 'OFF' 'DIFF'

         text .bltpdesc '                       Description'  at x1 y1.5 anchor left + right tagwidth 18 width 36 is STRING
         text .bltpnumb '              Bolt Point Number'     at x1 y2.5 anchor left + right tagwidth 18 width 20 is REAL FORMAT !!integerFmt
         text .bltpbdia '        Bolt Diameter (BDIA)'        at x1 y3.5 anchor left + right tagwidth 18 width 36 is STRING
         text .bltpbtyp '             Bolt Type (BTYP)'       at x1 y4.5 anchor left + right tagwidth 18 width 36 is STRING
         text .bltpbthk ' Bolting Thickness (BTHK)'           at x1 y5.5 anchor left + right tagwidth 18 width 36 is STRING

         text .btsedesc '                       Description'  at x1 y1.5 anchor left + right tagwidth 18 width 36 is STRING
         text .btsefunc '                           Function' at x1 y2.5 anchor left + right tagwidth 18 width 36 is STRING
         text .btsenoff '            Number of (NOFF)'        at x1 y3.5 anchor left + right tagwidth 18 width 20 is REAL FORMAT !!integerFmt
         text .btsebdia '         Bolt Diameter (BDIA)'       at x1 y4.5 anchor left + right tagwidth 18 width 36 is STRING
         text .btsebtyp '             Bolt Type (BTYP)'       at x1 y5.5 anchor left + right tagwidth 18 width 36 is STRING
         text .btsebthk ' Bolting Thickness (BTHK)'           at x1 y6.5 anchor left + right tagwidth 18 width 36 is STRING
         text .btsegtyp '                              Gtype' at x1 y7.5 anchor left + right tagwidth 18 width 36 is STRING
         text .btsepurp '                           Purpose'  at x1 y8.5 anchor left + right tagwidth 18 width 36 is STRING

      exit

       button .btseDel ''      at x 1  y 9.5   anchor left             pixmap width 16 height 16
       button .btsenew 'New'   at x 17 y 9.5   anchor left   width 7
       button .btsecop 'Copy'  at x 26 y 9.5   anchor left   width 7

       button .btseAttribs linklabel at x1 Y 11        anchor left   'All Attributes'  width 8
    exit

-- =========================================================================================================================
--                                              End of form definitions.
-- =========================================================================================================================

    -- Define popup menu for grid parameter control.
    menu .paramPopup
      !this.paramPopup.add   ('CALLBACK','Copy This Component',  |!!catModelViews.paramPopup(|)
      !this.paramPopup.add   ('CALLBACK','Delete This Component',|!!catModelViews.paramPopup(|)

    -- Define grid control namespace
    using namespace 'Aveva.Pdms.Presentation'
    using namespace 'Aveva.Pdms.Presentation.PMLDBSearchCtrl'

    -- Grid control members
    member .cateTable       is NETGRIDCONTROL
    member .compParam       is NETGRIDCONTROL
    member .sextloop        is NETGRIDCONTROL
    member .nsexLoop        is NETGRIDCONTROL
    member .sproLoop        is NETGRIDCONTROL
    member .eventClick      is EVENTCLICK

    -- Component being worked on
    member .component       is DBREF
    member .parentType      is DBREF

    -- Drawlist for this view
    member .drawlist        is REAL

 -- Search Control.
    member .searchControl   is PMLDBSEARCHCTRL
    member .searchResults   is ARRAY
    member .resultsTarget   is GADGET

    -- Search criteria
    member .searchGadget    is GADGET
    member .searchData      is ARRAY
    member .refData         is CATGETREFDATA
    member .getElement      is CATGETELEMENT
    member .ptse            is CATPTSEELEMENT
    member .core            is CATCOREELEMENT
    member .ptss            is CATPTSSELEMENT
    member .scom            is CATSCOMELEMENT
    member .gmse            is CATGMSEELEMENT
    member .gmss            is CATGMSSELEMENT
    member .ngms            is CATNGMSELEMENT
    member .dtse            is CATDTSEELEMENT
    member .btse            is CATBTSEELEMENT
    member .cate            is CATCATEELEMENT
    member .subType         is STRING
    member .trackedElements is ARRAY
    member .ignoreNextTrack is BOOLEAN
    member .numParams       is REAL
    member .returnGadget    is GADGET
    member .returnFrame     is STRING
    member .hiddenGadgets   is ARRAY
    member .catePosinTable  is REAL
    member .selectedRow     is REAL
    member .paraPosinTable  is REAL
    member .currentGadget   is GADGET
    member .cellSelected    is ARRAY
    member .cellReference   is DBREF
    member .forceCellValue  is BOOLEAN
    member .updateCellVal   is BOOLEAN

    member .returnToFrame   is STRING
    member .homeDirectory   is STRING

    !this.napp.dtext        = !this.gmse.nappdtext
    !this.napp.rtext        = !this.gmse.napprtext
    !this.obst.dtext        = !this.gmse.obstdtext
    !this.obst.rtext        = !this.gmse.obstrtext

    !this.datadefn.dtext    = !this.dtse.purposedtype
    !this.datadefn.rtext    = !this.dtse.purposertype
    !this.dataptypeOpt.dtext   = !this.dtse.datadefdtype
    !this.dataptypeOpt.rtext   = !this.dtse.datadefrtype
    !this.datapurp.visible  = FALSE
    !this.dataptyp.visible  = FALSE
    !this.datarbut.visible  = FALSE

    -- Global or local drawlist
    member .localDrawlists  is BOOLEAN

  track |CATACE| call |!this.getElement.track(!this, !!ce)|

  exit

  -- Pseudo form constructor
  !form = $!formName

  !form.linepts3.active    = FALSE
  !form.lineppoint3.active = FALSE
  !form.btsesame.val       = TRUE
  !form.subType            = ''

  !form.trackCE.callback     = |!this.getElement.track(!this, !!ce)|
  !form.ignoreNextTrack      = FALSE

 -- Representation gadgets
  !form.taxes.callback  = |!!catModelViews.setRepre(|
  !form.trepr.callback  = |!!catModelViews.setRepre(|
  !!catModelViews.loadRepre(!form)

  -- Add instances of .net control
  !form.cateTable = object NETGRIDCONTROL()
  !form.compParam = object NETGRIDCONTROL()
  !form.sextloop  = object NETGRIDCONTROL()
  !form.nsexLoop  = object NETGRIDCONTROL()
  !form.sproLoop  = object NETGRIDCONTROL()

  -- Initialise object to hold grid event pointers
  !form.eventClick = object EVENTCLICK(!form)

  -- Set grid properties
  !form.cateTable.fixedHeaders(false)
  !form.cateTable.outlookGroupStyle(false)
  !form.cateTable.columnExcelFilter(false)
  !form.cateTable.headerSort(true)
  !form.cateTable.columnSummaries(false)
  !form.cateTable.singleRowSelection(true)
  !form.cateTable.setAlternateRowColor(240,240,255)
  !form.cateTable.editableGrid(true)

  -- Add event handlers to grid control
  !form.cateTable.addEventHandler('BeforeCellUpdate'   , !form.eventClick, 'ModelCellUpdate')
  !form.cateTable.addEventHandler('AfterCellUpdate'    , !form.eventClick, 'afterCellUpdate')
  !form.cateTable.addEventHandler('OnPopup'            , !form.eventClick, 'ModelParamPopup')
  !form.cateTable.addEventHandler('AfterSelectChange'  , !form.eventClick, 'ModelAfterSelect')

  !form.compParam.outlookGroupStyle(false)
  !form.compParam.columnExcelFilter(false)
  !form.compParam.headerSort(false)
  !form.compParam.columnSummaries(false)
  !form.compParam.singleRowSelection(true)
  !form.compParam.setAlternateRowColor(240,240,255)
  !form.compParam.editableGrid(true)

  -- Add event handlers to grid control
  !form.compParam.addEventHandler('BeforeCellUpdate'  , !form.eventClick, 'parameterCellUpdate')

  !form.sextloop.outlookGroupStyle(false)
  !form.sextloop.columnExcelFilter(false)
  !form.sextloop.headerSort(false)
  !form.sextloop.fixedHeaders(false)
  !form.sextloop.columnSummaries(false)
  !form.sextloop.singleRowSelection(true)
  !form.sextloop.setAlternateRowColor(240,240,255)
