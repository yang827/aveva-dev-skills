------------------------------------------------------------------------
--
-- Method:      viewCE
--
-- Description: View scom related to current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .viewCE(!gadget is GADGET, !action is STRING)
------------------------------------------------------------------------

  -- Get form from which button was pressed
  !form  = !gadget.owner()

  -- Clear drawlist and add CE
  REMOVE ALL
  if (!!ce.type eq |SCOM|) then
    !addElement = !!ce
  elseif (!!ce.type eq |SPCO| or !!ce.type eq |GPART|) then
    !addElement = !!ce.catref
  elseif (!!ce.type eq |TABITE|) then
    !addElement = !!ce.prtref.catref
    handle any
      !addElement = object DBREF()
    endhandle
  else
    !addElement = !!ce.spref.catref
    handle any
      -- Does not have spref
      !addElement = object DBREF()
    endhandle
  endif
  if( not badref(!addElement) ) then
      add $!<addElement>
  endif

  -- Part reference settings
  !rows    = ARRAY()
  !rows[1] = ARRAY()
  !rows[2] = ARRAY()
  !rows[3] = ARRAY()
  !rows[4] = ARRAY()
  !rtext   = ARRAY()
  if (!!ce.type eq |SPCO| or !!ce.type eq |GPART|) then

    -- catref
    !rows[1].append(|Catref|)
    if (!!ce.catref.set()) then
      !rows[1].append(!!ce.catref.name)
      !rtext[1] = !!ce.catref.ref.string()
    else
      !rows[1].append(|unset|)
      !rtext[1] = |unset|
    endif
    !rows[1].append(||)

    -- detref
    !rows[2].append(|Detref|)
    if (!!ce.detref.set()) then
      !rows[2].append(!!ce.detref.name)
      !rows[2].append(!!ce.dtxr)
      !rtext[2] = !!ce.detref.ref.string()
    else
      !rows[2].append(|unset|)
      !rows[2].append(|unset|)
      !rtext[2] = |unset|
    endif

    -- matxt
    !rows[3].append(|Matxt|)
    if (!!ce.matxt.set()) then
      !rows[3].append(!!ce.matxt.name)
      !rows[3].append(!!ce.mtxx)
      !rtext[3] = !!ce.matxt.ref.string()
    else
      !rows[3].append(|unset|)
      !rows[3].append(|unset|)
      !rtext[3] = |unset|
    endif

    -- bltref
    !rows[4].append(|Bltref|)
    if (!!ce.bltref.set()) then
      !rows[4].append(!!ce.bltref.name)
      !rtext[4] = !!ce.bltref.ref.string()
    else
      !rows[4].append(|unset|)
      !rtext[4] = |unset|
    endif
    !rows[4].append(||)

    -- Populate list
    !form.partRefList.setRows(!rows)
    !form.partRefList.rtext = !rtext

  else

    return error 1 |Not a part or spcom|

  endif

  -- Part property settings
  !rows    = ARRAY()
  !rows[1] = ARRAY()
  !rows[2] = ARRAY()
  !rows[3] = ARRAY()
  !rows[4] = ARRAY()
  !rtext   = ARRAY()

  if (!!ce.type eq |SPCO| or !!ce.type eq |GPART|) then

    -- Name etc
    !rows[1].append(|Name|)
    !rows[1].append(!!ce.namn)
    !rtext[1] = !!ce.name
    !rows[2].append(|Discipline|)
    !rows[2].append(||)
    !rtext[2] = |Discipline|
    !rows[3].append(|Description|)
    if (!!ce.detref.set()) then
      !description = !!ce.dtxr
      if (!!ce.matxt.set()) then
        !description = !description & | | & !!ce.mtxx
      endif
    else
      !description = |unset|
    endif
    !rows[3].append(!description)
    !rtext[3] = !description
    !rows[4].append(|Size|)
    !rows[4].append(||)
    !rtext[4] = |Size|

    -- Populate list
    !form.partPropList.setRows(!rows)
    !form.partPropList.rtext = !rtext

  endif

endmethod
-- End of method definition for .viewCE(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      updateAllViews
--
-- Description: Updates the component displays for all ModelViews
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .updateAllViews()

  do !modelView value !!catModelViews.modelViews
    !drawlist = !!gphDrawlists.drawlist(!modelView.drawlist)
    !drawlist.update()
    if (!modelView.getElement.highlighted EQ !!ce) then
     !drawlist.unhighlight(!modelView.getElement.highlighted)
     !drawlist.highlight(!modelView.getElement.highlighted, 292)
    endif
  enddo

endmethod
-- End of method definition for updateAllViews



------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: Remove part view from the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .remove(!form is FORM)

  -- Get form index
  !index = !this.viewIndex(!form)

  -- Return if we can't find the form in the system
  if (!index.unset()) then
    return
  endif

  -- Remove form from the system
  !this.modelViews[!index].delete()

  if (!form.localDrawlists) then
    !!gphDrawlists.detachView(!form.drawlist, !form.view)
    !!gphDrawlists.deleteDrawList(!form.drawlist)
  endif

  -- Remove the form from the view system (this kills the form)
  !!gphViews.remove(!form.view)

  -- Kill the form
  --!formString = '!!' & !form.string()
  --kill $!<formString>

  -- Update control form if exists and shown
  if (defined(!!catControl)) then
    if (!!catControl.shown()) then
      !!catControl.initialise()
    endif
  endif

endmethod
-- End of method definition for .remove(FORM)

------------------------------------------------------------------------
--
-- Method:      viewIndex
--
-- Description: Get form index in the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--    REAL        Index in the form list
--
------------------------------------------------------------------------

define method .viewIndex(!form is FORM) is REAL

  -- Loop through list
  do !i indices !this.modelViews
    if (!form eq !this.modelViews[!i]) then
      return !i
    endif
  enddo
  return REAL()

endmethod
-- End of method definition for .viewIndex(FORM) REAL

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Form bar menu selected from
--    2   R      STRING      Select state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close(!menu is MENU, !dummySelected is STRING)

  -- Remove form from the system
  !form   = !menu.owner()
  !this.remove(!form)

endmethod
-- End of method definition for .close(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close(!form is FORM)

  -- Remove form from the system
  !this.remove(!form)

  -- Remove callback from spreadSheetImport form
  if (defined (!!spreadSheetImport)) then
    !callback = '!!catSetCateReferences(!!' + !form.name() + '.compAttribList, |SELECT|)'
    !!spreadSheetImport.removeImportCallback(!callback)
  endif

endmethod
-- End of method definition for .close(FORM)

------------------------------------------------------------------------
--
-- Method:      nextAvailable
--
-- Description: Next available form number
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        Available number
--
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .nextAvailable() is REAL
------------------------------------------------------------------------

  -- Return next
  return !this.modelViews.maxIndex() + 1

endmethod

-- End of method definition for .nextAvailable() REAL
------------------------------------------------------------------------
--
-- Method:      loadRepre
--
-- Description: Load representation rules
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Model form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadRepre(!form is FORM)

  -- Interface to old form
  !repRuleKeys = !!cdcdrep.key.rtext
  !repRuleDesc = !!cdcdrep.desc.dtext

  -- Load representation rules
  !dtext = ARRAY()
  !rtext = ARRAY()
  !dtext.append(|Choose|)
  !rtext.append(|Choose|)
  !dtext.appendArray(!repRuleDesc)
  !rtext.appendArray(!repRuleKeys)
  !dtext.append(|Re-load|)
  !rtext.append(|RELOAD|)
  !form.trepr.dtext = !dtext
  !form.trepr.rtext = !rtext

  -- Load geometry representation rules
  !form.gmse.loadrepresentation(!repRuleDesc, !!cdcdrep.data.dtext)
  !form.repre.dtext = !form.gmse.repredtext
  !form.repre.rtext = !form.gmse.reprertext

endmethod
-- End of method definition for .loadRepre(FORM)

------------------------------------------------------------------------
--
-- Method:      setRepre
--
-- Description: Set representation
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setRepre(!gadget is GADGET, !action is STRING)
------------------------------------------------------------------------

  -- Get form and gadget value
  !form = !gadget.owner()

  -- Get local drawlist
  if (!form.localDrawlists) then
      !drawlist = !!gphDrawlists.drawlist(!form.drawlist)
  endif

  if (!gadget ne !form.trepr) then
    if (!gadget.val) then
      !onOff = |On|
    else
      !onOff = |Off|
    endif
  endif

  -- Interface to old form

  if (undefined(!!cataxes)) then
      pml load form !!cataxes
  endif
  !axesHeight   = !!cataxes.axesHeight.val
  !repRuleKeys  = !!cdcdrep.key.rtext
  !repRuleData  = !!cdcdrep.data.rtext

  if (!gadget eq !form.taxes) then

    if (!gadget.val) then
      AXES AT N0 E0 U0 HEIGHT $!axesHeight
    else
      AXES OFF
    endif

  -- Representation options
  elseif (!gadget eq !form.trepr) then

    -- Ignore unselect
    if (!action eq |UNSELECT|) then
      return
    endif

    -- Reload representation rules from form
    if (!gadget.selection() eq |RELOAD|) then
      !this.loadRepre(!form)
      !this.setRepreField(!form, !form.getElement.highlighted)
      return
    endif

    -- Get representation settings ...
    !leve = ARRAY()
    !obst = REAL()
    !clfl = BOOLEAN()
    !tufl = BOOLEAN()
    if (!gadget.selection() eq |Choose|) then

      -- ... from current element (primitive)
      if (!!ce.attributes().findFirst(|Obstruction|).set()) then
        !obst = !!ce.obstruction
      endif
      if (!!ce.attributes().findFirst(|Level|).set()) then
        !leve = !!ce.level
      endif
      if (!!ce.attributes().findFirst(|Clflag|).set()) then
        !clfl = !!ce.clflag
      endif
      if (!!ce.attributes().findFirst(|Tuflag|).set()) then
        !tufl = !!ce.tuflag
      endif

    else

      -- ... from representation rules
      !repNumber = !repRuleKeys.findFirst(!gadget.selection())
      if (!repNumber.set()) then
        !data    = !repRuleData[!repNumber].split(|\|)
        !leve[1] = !data[2].real()
        !leve[2] = !data[3].real()
        !obst    = !data[4].real()
        !clfl    = !data[5].boolean()
        !tufl    = !data[6].boolean()
      endif

    endif

    -- Abort if settings not acquired
    if (!leve.empty()) then
      return
    endif

    -- Levels
    if (!form.localDrawlists) then
      !drawlist.nozzLevel(!leve[1])
      !drawlist.pipeLevel(!leve[1])
      !drawlist.struLevel(!leve[1])
      !drawlist.level(!leve[1])
    else
      REPRE LEVEL NOZZ $!leve[1]
      REPRE LEVEL PIPE $!leve[1]
      REPRE LEVEL STRU $!leve[1]
      REPRE LEVEL $!leve[1]
    endif

    -- Centreline flag
    if (!clfl.set()) then
      if (!form.localDrawlists) then
        !drawlist.centreLine(!clfl)
      else
        if (!clfl) then
          REPRE CL ON
          REPRE PROFILE CL ON
        else
          REPRE CL OFF
          REPRE PROFILE CL OFF
        endif
      endif
    endif

    -- Tube flag
    if (!tufl.set()) then
      if (!form.localDrawlists) then
        !drawlist.tube(!tufl)
      else
        if (!tufl) then
          REPRE TUBE ON
          REPRE PROFILE ON
        else
          REPRE TUBE OFF
          REPRE PROFILE OFF
        endif
      endif
    endif

    -- Obstruction
    if (!obst.set()) then
      if (!form.localDrawlists) then
        !drawlist.obstruction((!obst gt 0))
      else
        if (!obst gt 0) then
          REPRE OBST ON
          REPRE PROFILE OBST ON
        else
          REPRE OBST OFF
          REPRE PROFILE OBST ON
        endif
      endif
    endif

  endif

  -- Update display and representation form
  if (!form.localDrawlists) then

    if (defined(!!gphDrawlistRep) and !!gphDrawlistRep.view eq !form.view) then
      !!gphDrawlistRep.initialise()
      !!gphDrawlistRep.apply()
    else
      !drawlist.update()
    endif
  else

    remove all
    add $!<form.component>
  endif

  -- Now highlight the element that was already highlighted, because it will no longer be highlighted.
  !form.getElement.track(!form, !form.getElement.highlighted)


endmethod
-- End of method definition for .setRepre(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      limits
--
-- Description: Set view limits to element volume
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .limits(!form is FORM)

  -- Set limits
  if (!form.component.set()) then
    if (!form.component.badref().not()) then
      if( !form.component.type eq 'SPRF' ) then
        -- special case for calculating the view limits of SPRF elements
        !volume = object VOLUME(!form.component)
        if( !volume.unset() ) then
          !!gphViews.limits(!form.view, !form.component)
        else
          -- expand Z of volume to show extrusion
          !volume.to.up = !volume.to.up + 1000mm
          !!gphViews.limits(!form.view, !volume)
        endif
      else
        -- calculate limits from component geometry
        !!gphViews.limits(!form.view, !form.component)
      endif
    endif
  endif

endmethod
-- End of method definition for .limits(FORM)

------------------------------------------------------------------------
--
-- Method:      limitsIncrease
--
-- Description: Increase view limits
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Model view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .limitsIncrease(!form is FORM)

  -- Increase limits
  !limits = !form.view.limits
  do !i to 5 by 2
    !limits[!i]     = !limits[!i]     - 500mm
    !limits[!i + 1] = !limits[!i + 1] + 500mm
  enddo
  !form.view.limits = !limits

endmethod
-- End of method definition for .limitsIncrease(FORM)

------------------------------------------------------------------------
--
-- Method:      limitsDecrease
--
-- Description: Decrease view limits
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .limitsDecrease(!form is FORM)

  -- Decrease limits
  !limits = !form.view.limits
  do !i to 5 by 2
    if ((!limits[!i + 1] - !limits[!i]) gt 1000mm) then
      !limits[!i]     = !limits[!i]     + 500mm
      !limits[!i + 1] = !limits[!i + 1] - 500mm
    endif
  enddo
  !form.view.limits = !limits

endmethod
-- End of method definition for .limitsDecrease(FORM)

------------------------------------------------------------------------
--
-- Method:      categoryCellUpdate
--
-- Description: Handles the BeforeCellUpdate event from the CategoryTable
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Model form
--    2   R      ARRAY       Cell update information.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .categoryCellUpdate(!form is FORM, !data is ARRAY)
------------------------------------------------------------------------
-- BeforeCellUpdate Grid Control Callback
-- Category Cell Update
!save = !!ce

-- Prevent editing of empty rows
!oldTableName      = !form.cateTable.getRow(!data[1])[1]
if (!oldTableName eq ' ') then
  !data[3] = false
  !!alert.message('This row cannot be edited as it does not contain a valid element')
  return
endif

if (!data[2] eq 'Name') then
  !renamedElement = !this.renameFromGrid(!oldTableName, !data)
  if( !renamedElement.set() ) then
    !form.cellSelected   = !data
    !form.cellReference  = !renamedElement.ref
    !form.forceCellValue = TRUE
  endif
endif

-- Check here if the forced setting of the cell is being actioned and abort if it is.

if (!form.forceCellValue) then
  !form.forceCellValue = FALSE
  return
endif

if (!form.cateTable.getColumns().findFirst(!data[2]) gt 2) then
  -- We are dealing with a parameter value here.
  -- Data given to change the entry for a given parameter value.
  !form.scom.modifyParameterValue(!form, !data)
  if (!data[0] eq 'unset') then
    !data[0] = '0'
  endif
  if (!form.updateCellVal) then
    --the data in the !data array has been changed and the contents of the cell need updating
    !form.cellSelected  = !data
  endif
  -- Update the form with the parameters for this component
  !form.getElement.getParams(!form.params1,!form.component)

  -- Abort this method here.
  return
endif

  !componentName  = !form.cateTable.getRow(!data[1])[1]
  if (!componentName.substring(1,1) eq '=') then
    !cellContents = !componentName
  elseif (!componentName.substring(1,1) neq '/') then
    !cellContents = '/' & !componentName
  else
    -- check for multiple /
    !cellContents = !componentName
    !cellRef = object DBREF(!cellContents)
    handle any
      !cellContents = '/' & !componentName
    endhandle
  endif

  !cellRef = !cellContents.dbref()
  handle any
    !!alert.error(!cellContents & ' does not exist')
    !data[3] = FALSE
    return
  endhandle

-- Data given to change the entry for a given parameter value.
!form.cate.categoryCellUpdate(!form, !data)

-- Update the parameters for this component. $!form.component
!form.getElement.getParams(!form.params1,!form.component)

-- Return to previous element.
!!ce = !save

endmethod
-- End of method definition for .categoryCellUpdate


------------------------------------------------------------------------
--
-- Method:      getNameFromGrid
--
-- Description: Sets the current element from a string (assumed to have
--              come from a grid cell)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      String from grid cell
--
-- Return:
--   [Data Type] [Description]
--   BOOLEAN    True if the name is a valid dbref
------------------------------------------------------------------------
define method .getNameFromGrid(!stringFromCell is STRING) is BOOLEAN
------------------------------------------------------------------------

  if (!stringFromCell.substring(1,1) ne '/') then
    !!ce = object DBREF('/' & !stringFromCell)
    handle any
    elsehandle none
      return TRUE
    endhandle
  endif
  !!ce = !stringFromCell.dbref()
  handle any
    return FALSE
  endhandle

  return TRUE

endmethod
-- End of method definition for .getNameFromGrid()


------------------------------------------------------------------------
--
-- Method:      getName
--
-- Description: Load representation rules
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Before Name
--    2   R      STRING      Name after User has Changed Field
-- Return:
--   [Data Type] [Description]
--    ARRAY       [1] STRING     Original Name (with / if named)
--                               '0' If error
--                [2] STRING     New Name (with / if named)
--                               ''  Empty string if UNNAME required
--                               '0' If error
--
------------------------------------------------------------------------
define method .getName(!before is STRING, !name is STRING) is ARRAY
------------------------------------------------------------------------
  if (!before.substring(1,1) eq '=' ) then
    !return[1] = !before
  elseif(!before.substring(1,1) ne '/') then
    !return[1] = '/' & !before
  else
    -- check for multiple /
    !validName = object DBREF(!before)
    handle any
      !return[1] = '/' & !before
    elsehandle none
      !return[1] = !before
    endhandle
  endif
  -- check validity of original name
  !validName = object DBREF(!return[1])
  handle any
    --return a null dbref to force the error handlers to reset to the previous value
    !return[1] = '0'
    !return[2] = '0'
  endhandle

  --first check to see if special characters appears in the name. Reject it if so
  if ((!name.match('$$') ne 0) or (!name.match('$@') ne 0)) then
    !return[1] = '0'
    !return[2] = '0'
    return !return
  endif

  -- Check to see if we have a valid name or not

  if (!name.trim().empty()) then
  -- UNNAME element

      -- return null new name to indicate UNNAME required
      !return[2] = ''

  elseif (!name.substring(1,1) eq '=') then
  -- Name if dbref type
      if (!name.dbref().badref().not()) then
          !return[2] = !name
      else
          !return[2] = !before
      endif
      handle any
        --probably something silly for a name like '=1234'
        --return a null dbref to force the error handlers to reset to the previous value
        !return[1] = '0'
        !return[2] = '0'
      endhandle


  elseif (!name.substring(1,1) eq '/') then
  -- Name if name without slash type

      if (!name.dbref().badref().not()) then
          !return[2] = !name
      else
          !return[2] = !before
      endif
      handle (2,109)
          !return[2] = !name
      elsehandle (2,813)
        --return a null dbref to force the error handlers to reset to the previous value
        !return[1] = '0'
        !return[2] = '0'
      endhandle

  else
  -- Name needs a slash type, and checking
      !test = '/' & !name
      if (!test.dbref().badref().not()) then
          !return[2] = !test
      else
          !return[2] = !before
      endif
      handle (2,109)
          !return[2] = !test
      elsehandle (2,813)
        --return a null dbref to force the error handlers to reset to the previous value
        !return[1] = '0'
        !return[2] = '0'
      endhandle

  endif

  return !return

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      vertexCellUpdate
--
-- Description: Load representation rules
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Model form
--    2   R      ARRAY       Cell update information.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .vertexCellUpdate(!form is FORM, !data is ARRAY)
------------------------------------------------------------------------

-- Prevent editing of empty rows
!oldTableName      = !form.sextloop.getRow(!data[1])[1]
if (!oldTableName eq ' ') then
  !data[3] = false
  !!alert.message('This row cannot be edited as it does not contain a valid element')
  return
endif

if (!data[2].upcase().trim() eq 'NAME') then
  !this.renameFromGrid(!oldTableName, !data)
  return
endif

-- Data given to change the entry for a given parameter value.
!form.gmse.vertexValue(!form, !data)

-- refresh the graphics view.
!form.view.refresh()

endmethod
-- End of method definition for .vertexCellUpdate

------------------------------------------------------------------------
--
-- Method:      renameFromGrid
--
-- Description: action rename element in grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Original name of element to be changed from grid
--    2   RW     ARRAY       Cell update information.
-- Return:
--   [Data Type] [Description]
--    DBREF       Reference of renamed element or unset if rename failed
--
------------------------------------------------------------------------
define method .renameFromGrid(!oldName is STRING, !data is ARRAY) is DBREF
------------------------------------------------------------------------

  !return = object DBREF()
  if (!data[2].upcase().trim() neq 'NAME') then
    return
  endif

  !save = !!ce
  -- get original name (with / for named elements)
  !oldNormalizedName = !this.getName(!oldName, !oldName)[1]
  -- Save position in hierarchy just in case we are not there.
  !!ce               = !oldNormalizedName.dbref()
  handle (2,813)
    -- Cannot convert string to dbref
    !data[3] = FALSE
  elsehandle (2,107) (2,109)
    !data[3] = FALSE
  elsehandle any
    -- catch for other problems (e.g. DACS)
    !!alert.message(!!error.text)
    !data[3] = FALSE
  elsehandle none
    -- found element using the old name. Try to set new name
    !newName            = !data[0]
    !newNormalizedName  = !this.getName(!oldName, !newName)[2]
    if( !newNormalizedName.empty() ) then
      -- UNSET name
      UNNAME CE
      handle any
        !!alert.message(!!error.text)
        !data[3] = FALSE
      endhandle
      !return = !!ce
    elseif (!newNormalizedName.substring(1,1) ne '=') then
      -- Naming an element
      !!ce.name = !newNormalizedName
      handle (47,15)
        !!alert.message('Invalid name')
        !data[3] = FALSE
      elsehandle (41,12) (47,62)
        !!alert.message('Name already exists')
        !data[3] = FALSE
      elsehandle any
        !!alert.message(!!error.text)
        !data[3] = FALSE
      endhandle
      -- if success, then return reference of renamed element, otherwise it remains unset
      if( !data[3] ) then
        !return = !!ce
      endif
    endif
    !!ce = !save
  endhandle
  return !return

endmethod
-- End of method definition for .renameFromGrid

------------------------------------------------------------------------
--
-- Method:      AfterSelect
--
-- Description: Load representation rules
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Model form
--    2   R      ARRAY       Cell update information.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modelAfterSelect(!form is FORM, !data is ARRAY)
------------------------------------------------------------------------
-- AfterSelectChange Grid Control Callback
-- Model Cell Update, when the user selects an element from the category list/grid control
-- Data given to change the entry for a given parameter value.
-- carry out call to ce button from here as we have picked another row in the grid control.

-- Extract the element name from the column list of components in the category list.

-- Make sure we haven't picked an empty field here.
  if (not !form.cateTable.getSelectedRowTags().empty()) then
    if (!form.cateTable.getRow(!form.cateTable.getSelectedRowTags()[1])[1].length() eq 1) then
      return
    endif
  endif
  !form.catePosinTable = !data[0][1].real()
    handle (2,752)
      return
    endhandle

-- Set Current Element (CE) by getting element from grid position 1
  if (!!catModelViews.getNameFromGrid(!form.cateTable.getRow(!data[0][1])[1]).not()) then
    return
  endif

  !form.component = !!ce

-- Now add the current component to the view.
--!form.getElement.addModel(!form, !!ce)

-- Update the parameters for this component. $!form.component
--!form.getElement.getParams(!form.params1,!form.component)

-- Hold the selected row from gadget category grid.
!form.selectedRow = !form.cateTable.getSelectedRowTags()[1].real()

-- Now select the element for display and editing purposes.
!!catModelViews.selectCe(!form.compAttribList, !form.cateTable.getSelectedRows())

endmethod
-- End of method definition for .modelAfterSelect)

------------------------------------------------------------------------
define method .vertexAfterSelect(!form is FORM, !data is ARRAY)
------------------------------------------------------------------------

-- Data given to change the entry for a given parameter value.
-- carry out call to ce button from here as we have picked another row in the grid control.

-- Extract the element name from the column list of components in the category list

!position = !data[0][1].real()
handle (2,752)
   return
endhandle

!element = !form.sextloop.getRow(!position)[1]

-- Set current element so that the setCe method can set the current element.
!form.ignoreNextTrack = true
!!ce = !element.dbref()

-- Now add the current component to the view.
--!form.getElement.addModel(!form, !!ce)

endmethod
-- End of method definition for .vertexAfterSelect)


