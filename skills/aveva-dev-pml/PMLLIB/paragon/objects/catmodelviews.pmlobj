------------------------------------------------------------------------
define method .nameElement(!name is STRING)
------------------------------------------------------------------------

-- Abort if naming has not been loaded yet.
   if (undefined(!!namOptEdit)) then
       return
   endif

-- Call autonaming here.
if (!name eq 'AUTONAME' and !!namOptEdit.data.auto) then
    !autoName  = !!namOpt.nameString(!!ce, STRING(), false, false)
    if (!autoName.unset()) then
      if (!!ce.type ne 'DATA') then
          !!alert.error('Unable to autoname element, set the relevant attribute for the autoname rule and then use "Utilities>Autoname>CE only".')
      endif
    else
      if (!autoName.substring(1,1) ne '=') then
          ---- Naming as $!autoName
        NAME /$!autoName
      endif
    endif
elseif (!name eq 'AUTONAME' and !!namOptEdit.data.auto EQ FALSE) then
     -- Do nothing, leave name alone.
else
    if (!name.set()) then
      if (!name.length() NE 0) then
          if (!name.substring(1,1) EQ '=') then
              -- Do Nothing
          else
             if (!name.substring(1,1) eq '/') then
               !tempName = !name
             else
               -- try name with /
               !tempName = '/' + !name
             endif
             -- Name it /$!name
             NAME $!<tempName>
             handle (47,15)(41,303)(41,12)
               -- leave unnamed if syntax error, name too long, name already used
             endhandle
          endif
      endif
    endif
endif

endmethod
-- End of method definition

---------------------------------------------------------------------------
define method .command(!attribute is STRING, !argument is STRING) is ARRAY
---------------------------------------------------------------------------
-- Method to carry out commands, all commands happen here so checks can be made for
-- error conditions in one place.

!return = ARRAY()

!cmnd = !attribute & ' ' & !argument
$!cmnd
  handle any
    !return[1] = !!error.text
    !return[2] = !!error.line
    return !return
  endhandle

return !return

endmethod
-- End of method

---------------------------------------------------------------------------------
define method .createNewElement(!type is STRING, !name is STRING) is BOOLEAN
---------------------------------------------------------------------------------
-- Create new element here, check for read only condition and Dac create ability.
-- Return true for success and false for failure.
    !save  = !!ce
    !track = FALSE
    !elecType = ''
     -- Add Discipline type to incoming type to create.
    if (!!appCntrl.currentApp inset('STL')) then
        !storage = 'STRU' & !type.upcase()

    elseif (!!appCntrl.currentApp inset('EQUI')) then
        !storage = 'EQUI' & !type.upcase()

    elseif (!!appCntrl.currentApp inset('PIPE')) then
        !storage = 'PIPE' & !type.upcase()

    elseif (!!appCntrl.currentApp inset('ELEC')) then
        !storage = 'ELEC' & !type.upcase()
        !elecType = PURP OF SECT

    else
        !storage = !!appCntrl.currentApp & !type.upcase()

    endif

    -- Turn off tracking here, to stop the forms from updating.
    if (!!catModifyAttribs.track.val) then
        !track = TRUE
        !!catModifyAttribs.track.val = FALSE
    endif

    -- Create the New Element.
    if (!!ce.dbWrite) then

      -- Check to see if the catcreate toggle is set or not.
      if (!!catcreate.storage.val) then

        -- Navigate to where we need to be to create new element.
        !area = !!catStorageAreas.getArea(!storage)

        -- Navigate to area defined, or stay where we are.
        if (!area.unset().not()) then
            !!ce = !area
        endif

      endif
      handle any
      endhandle

      if (!name.eq('COPY')) then

        NEW $!type COPY PREV

        -- Check here for ELEC App, and copy CCORSE Element too.
        if (!!appCntrl.currentApp.eq('ELEC') AND !elecType eq 'CORE') then
          !ccorse = !!ce.ccorref
          handle (2,201)
            -- CCORREF doesn't exist, probably because a CABCOR rather than a SCOM is being copied
          elsehandle none
            !scom = !!ce
            NEW CCORSE COPY $!ccorse
            !scom.ccorref = !!ce
          endhandle
        endif

      else

        -- Now create the new element ($!type)
        if( !type inset('SCOM','SFIT','JOIN','SPRF') and !!ce.type eq !type ) then
          -- make a copy of the previous elements and clear the parameters
          NEW $!<type> COPY PREV
          !!ce.description = ''
          !compParameters  = object CATPARAMETERSET(!!ce)
          !nParameters     = !compParameters.numberOfParameters()
          do !paramIndex from 1 to !nParameters
            PARAM NUMBER $!<paramIndex> 0
            handle any
              break
            endhandle
          enddo
        else
          NEW $!<type>
          handle (41,8)
            --  Cannot create ELEMENT at this level.
            !!alert.error('Cannot create ELEMENT type ' + !type + ' at this level')
            return FALSE
          endhandle
        endif
      endif

        -- If storage is COPY, then copy previous element.
        -- Name element $!name$n.
        if (!name eq 'COPY') then
            !this.nameElement('AUTONAME')

        elseif (!name eq 'AUTONAME') then

            !this.nameElement('AUTONAME')

        elseif (!name eq 'none') then

             -- Do nothing, element doesn't need to be named.
        else
            !this.nameElement(!name)
        endif

        -- Return success.
          return TRUE

    else

       !dbn = !!ce.dbName
       !!alert.warning('You only have read access to the current DB (' & !dbn & ')')
        return FALSE

    endif

    if (!track) then
      -- Tracking back on if required.
        !!catModifyAttribs.track.val = TRUE
    endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:   browse
--
-- Description: Display file browser to open a file
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .browse(!gadget is GADGET, !action is STRING)
------------------------------------------------------------------------

  !form = !gadget.owner()

  -- Use new std browser
  Import 'PMLFILEBROWSER'
  handle (1000,0)
    -- check for file browser already loaded
  endhandle
  using namespace 'Aveva.Pdms.Presentation'

  -- Check to see if we are importing, or exporting.
  if (!gadget.name().upcase().eq('CATEEXPO')) then $* Export file

    !fileBrowser = object PMLFILEBROWSER('SAVE')

     -- Export Sense.
    !fileBrowser.show(!form.homeDirectory, '', 'Export Data', false, 'CSV File (*.csv)|*.csv|Microsoft Excel File (*.xls)|*.xls', 2)

     if (!fileBrowser.file().empty()) then
         return
     endif

     -- Determine the file extension so as to decide how to save the file
     !list = !fileBrowser.file().split('.')
     !extension = !list.last().upcase()
     !file = object FILE(!fileBrowser.file())
     if (!extension eq 'XLS') then
       !this.saveGridToExcelFile(!fileBrowser.file(), !form.cateTable, !form)
       handle any
         !!alert.error(!!error.text)
       endhandle
     else
       !this.saveGridToCSVFile(!file, !form.cateTable)
       handle any
         !!alert.error(!!error.text)
       endhandle
     endif
    !form.homeDirectory = !file.pathName()

  else $* Import file

    -- As references are not exported or imported, they are copied from an existing element.
    -- The element used is either the first selected element (if any) in the component table
    -- or the last element in the table

    !name = ''
    if (not !form.cateTable.getSelectedRows().empty()) then
      !name = !form.cateTable.getSelectedRows()[1][1]
    endif
    if (!name.empty()) then
      -- Find the last valid element in the table
      do !row from !form.cateTable.getNumberRows() to 1 by -1
        skip if (!form.cateTable.getRow(!row)[1].length() EQ 1)
          !name = !form.cateTable.getRow(!row)[1]
        break
      enddo
    endif

    -- Convert the name to a dbRef
    !element =!name.dbref()
    handle (2, 813) (2, 111)
      !name = '/' + !name
      !element =!name.dbref()
    endhandle

    -- Open the spread sheet import form
    !callback = '!!catSetCateReferences(!!' + !form.name() + '.compAttribList, |SELECT|)'
    !!cataLoadCSV(!callback, !element)

  endif
endmethod
-- End of method definition


------------------------------------------------------------------------
--
-- Method:   saveGridToCSVFile
--
-- Description: Save the contents of a NETGRIDCONTROL to a comma separated text file
--
--
------------------------------------------------------------------------
define method .saveGridToCSVFile(!file is FILE, !grid is ANY)

  !output = ARRAY()

  -- Issue a command line warning if the !grid argument is not a net grid control
  if (!grid.string().split('.').last() NE 'NetGridControl') then
    write |Warning: The second argument to .saveGridToFile should have been a NetGridControl|
  endif

  --  Build header line and add to the output array including extra columns for type and description
  !numColumns = !grid.getColumns().size()
  !header = 'Type'
  do !column from 1 to !numColumns
      !header = !header & ',' & !grid.getColumnKey(!column)
  enddo
  !header = !header + ',Description'
  !output.append(!header)

  -- For each row of the grid generate a line and add it to the output array
  !rows = !grid.getRows()
  do !row values !rows

    skip if (!row[1] EQ ' ' OR !row[1].empty())
    do !column index !row
      if (!column EQ 1) then
        !dbref = object DBREF('/' + !row[!column])
        handle any
          !dbref = !row[!column].dbref()
        endhandle
        !line = !dbref.type + ',' + !row[!column]
      else
        !line = !line & ',' & !row[!column]
      endif
    enddo
    !line = !line + ',' + !dbref.desc
    !output.append(!line)
  enddo

  -- Finally write the file
  !file.writeFile('OVERWRITE', !output)

endmethod

------------------------------------------------------------------------
--
-- Method:   saveGridToExcelFile
--
-- Description: Save the contents of a NETGRIDCONTROL to an Excel file
--
------------------------------------------------------------------------
define method .saveGridToExcelFile(!fileName is STRING, !grid is ANY, !form is FORM)
   using namespace 'Aveva.Pdms.Presentation'

  -- Retrieve data from grid
  !rows = !grid.getRows()
  !columns = !grid.getColumns()

  -- Add the element type to the start of each row and the description to the end
  !columns.insert(1, 'Type')
  !columns.append('Description')
  !numberRows = 0
  do !row values !rows
    break if (!row[1] EQ ' ' OR !row[1].empty())
    !dbref = object DBREF('/' + !row[1])
    handle any
      !dbref = !row[1].dbref()
    endhandle
    !row.insert(1, !dbref.type)
    !row.append(!dbref.desc)
    !numberRows = !numberRows + 1
  enddo

  -- Purge empty rows
  if (!numberRows lt !rows.size()) then
    !rows.deleteFrom(!numberRows + 1)
  endif

  !contents = object NETDATASOURCE('ExportGrid' , !columns, !rows)
  !exportGrid = object NETGRIDCONTROL()
  !exportGrid.bindToDataSource(!contents)
  !exportGrid.saveGridToExcel(!fileName)

endmethod
-- End of method saveGridToExcelFile

---------------------------------------------------------------------------------------------------------
define method .modifyAttributes(!element is DBREF)
---------------------------------------------------------------------------------------------------------
  -- Load or hide attributes form as appropriate
  if (undefined(!!catModifyAttribs)) then
    pml load form !!catModifyAttribs
  elseif (!!catModifyAttribs.shown()) then
    hide !!catModifyAttribs
  endif

  -- Setup attributes form for element associated with gadget
--  !!catModifyAttribs.setup(!element)

if (DBWRITE) then
     show !!catModifyAttribs
else
    !!alert.warning('You only have read access to this element')
     show !!catModifyAttribs
endif
endmethod
-- End of method

---------------------------------------------------------------------------------------------------------
define method .categoryAttributes(!form is FORM, !element is DBREF, !type is STRING)
---------------------------------------------------------------------------------------------------------

if (!type eq 'SET') then

       !form.categorydbrefno.val = !!ce.name
       !form.catename.val        = !!ce.name
       !form.catedesc.val        = !!ce.desc
       !form.catefunc.val        = !!ce.func
       !form.catepurp.val        = !!ce.purp

       if (unset(!form.categoryField2.dtext.findFirst(!!ce.gtyp))) then
          !form.categoryField2.val  = 1
          handle (61,620)
          endhandle
       else
          !form.categoryField2.val  = !form.categoryField2.dtext.findFirst(!!ce.gtyp)
       endif

       !form.categoryField3.val = !!ce.ptref.name
       handle (2,754)
              !form.categoryField3.val = 'unset'
       elsehandle any
       endhandle

       !form.categoryField4.val = !!ce.gmref.name
       handle (2,754)
              !form.categoryField4.val = 'unset'
       elsehandle any
       endhandle

       !form.categoryField5.val = !!ce.dtref.name
       handle (2,754)
              !form.categoryField5.val = 'unset'
       elsehandle any
       endhandle

    if (defined(!form.categoryField6)) then

       !form.categoryField6.val = !!ce.ngmref.name
       handle (2,754)
              !form.categoryField6.val = 'unset'
       elsehandle any
       endhandle

       !form.categoryField7.val = !!ce.pstref.name
       handle (2,754)
              !form.categoryField7.val = 'unset'
       elsehandle any
       endhandle

    endif

endif

endmethod

---------------------------------------------------------------------------------------------------------
define method .setFormFields(!form is FORM, !element is DBREF)
-----------------------------------------------------------------------------------------------------------
-- Having the gadget get entry and set the form edit up ready for use to change things if required.
-- Set forms Method.
-- Navigate to element.
!!ce = !element
!type = !!ce.type

if (!type inset ('CATE','STCA')) then
    !this.categoryAttributes(!form, !!ce, 'SET')
    return
endif

-- Decision as to whether the gadget exists is dependant on the combination of the prefix and attribute names.
-- example: gmse and tufl = gmsetufl,
-- if the gadget is not found and causes an error then it just moves to next attribute for current element.

-- deactivate NAPP, plines don't have NAPP.
!form.napp.active  = FALSE
!form.obst.active  = FALSE
!form.repre.active = FALSE

!atts = !element.attlist

    do !attribute value !atts

       -- Set the form field for this attribute from current element. ($!type & $!attribute)

       var !att $!attribute of $!element
       handle (47,15)
           -- Handle cases where PDMS is not dealing with the attribute name correctly.
           if (!attribute EQ 'PTCD') then
               var !att PTCDI of $!element
           endif
       endhandle

       if (defined(!unset)) then
           !unset.delete()
       endif

       if (!attribute EQ 'PTCD') then
           !unset = PTCDI
       else
           !unset = $!attribute
       endif

       -- Sort out specific attribute problems.
       if (!attribute EQ 'LEVE') then
           !leve = !!ce.level
           !form.attribute(!attribute & 1).val = !leve[1]
           !form.attribute(!attribute & 2).val = !leve[2]
           skip

       elseif (!attribute EQ 'PURP') then
           !purpose = !!ce.purpose
           !form.attribute(!type & !attribute).val = !purpose
           handle any
             !form.attribute(!attribute).val = !purpose
             handle any
               skip
             endhandle
           endhandle
           skip

       elseif (!attribute EQ 'PTS') then
           var !pts split PTS

           if (defined(!pts)) then
              !form.attribute(!type & !attribute & 1).val = !pts[1]
              !form.attribute(!type & !attribute & 2).val = !pts[2]
              handle (2,752)
              endhandle
              !form.attribute(!type & !attribute & 3).val = ''
              !form.attribute(!type & 'Tang').val         = FALSE
              !!catModelViews.lineTangent(!form.linepts1, 'UNSELECT')

              if (!pts.size() EQ 3) then
                  !form.attribute(!type & !attribute & 2).val = !pts[3]
                  !form.attribute(!type & !attribute & 3).val = !pts[2]
                  !form.attribute(!type & 'Tang').val         = TRUE
                  !!catModelViews.lineTangent(!form.linepts1, 'SELECT')
              endif

           else
              !form.attribute(!type & !attribute & 1).val = ''
              !form.attribute(!type & !attribute & 2).val = ''
              !form.attribute(!type & !attribute & 3).val = ''
           endif

           skip

       elseif (!attribute inset('TUFL','CLFL')) then
            !form.attribute(!attribute).val = !!ce.attribute(!attribute)
            skip

       elseif (!attribute inset('HULAPP','DESXCL')) then
            !form.attribute(!type & !attribute).val = !!ce.attribute(!attribute)

            -- Run method to decide whether the bevel gadgets need to be active or not.
            !form.gmse.hulapp(!form.attribute(!type & 'hulapp'), 'SELECT')
            skip

       elseif (!attribute EQ 'NAPP') then
            if (!type.substring(1, 1) EQ 'N') then
               -- Only enable the NAPP option for negative geometry set items
               !form.attribute(!attribute).active = TRUE
            endif
            !optionSelected    = !!ce.attribute(!attribute)
            !form.repre.active = TRUE
            !form.attribute(!attribute).val = !form.attribute(!attribute).rtext.findFirst(!optionSelected.string())
            skip

       elseif (!attribute EQ 'OBST') then
            !form.attribute(!attribute).active = TRUE
            !form.repre.active = TRUE
            !optionSelected    = !!ce.attribute(!attribute)
            !form.attribute(!attribute).val = !form.attribute(!attribute).rtext.findFirst(!optionSelected.string())
            skip

       endif

       -- Remove the ATTRIB Value from any setting to make it look more readable.
       !removeATTRIB = !att.replace('ATTRIB ','')

       !test = (!form.attribute(!type & !attribute))
       handle (2,766)
          -- Skip the attributes we are not setting for this frame ($!type & $!attribute)
          skip
       endhandle

       -- Set the form field for this attribute from current element. ($!type & $!attribute)
       if (!form.attribute(!type & !attribute).type() EQ 'LIST') then
           !form.attribute(!type & !attribute).val = !form.attribute(!type & !attribute).rtext.findFirst(!removeATTRIB)
           handle (61,620)
             -- Handle case where value is unset.

             !form.attribute(!type & !attribute).val = 1
           endhandle
       else
          if (!removeATTRIB EQ 'unset') then
              !form.attribute(!type & !attribute).val = 'unset'
          else
              !form.attribute(!type & !attribute).val = !removeATTRIB
              handle (61,618)
                -- Try REAL Value for this reply.
                   !form.attribute(!type & !attribute).val = !removeATTRIB.real()
              endhandle
          endif
       endif

       -- Delete variables so the sense doesn't cause problems.
       !att.delete()

    enddo

    !this.setRepreField(!form, !element)

endmethod

-----------------------------------------------------------------------------------------------------
--
-- Method:      setRepreField
--
-- Description: Updates the selection in the geometry 'Repr' option box based on the specified element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM       Form
--    2   R      DBREF      Geometry element
-- Return:
--   [Data Type] [Description]
--
-----------------------------------------------------------------------------------------------------
define method .setRepreField(!form is FORM, !element is DBREF)
-----------------------------------------------------------------------------------------------------

  !rtext = !element.level[1] & ',' & !element.level[2] & ',' & !element.obst & ',' & !element.clfl.string() & ',' & !!ce.tufl.string()
  handle any
  elsehandle none
    !form.repre.val =  !form.repre.rtext.findFirst(!rtext.lowcase())
     handle (61,620)
        !form.repre.val =  1
     endhandle
  endhandle

endmethod
-- End of method setRepreField

-----------------------------------------------------------------------------------------------------
define method .formApply(!form is FORM, !element is DBREF)
------------------------------------------------------------------------------------------------------
-- Form apply, this sets all the relevant attributes for the current element for the current context, all
-- values will be set as far as possible, any that fail will be ignored and it moves to the next attribute.

-- Navigate to element
!!ce = !element

-- Make sure it is claimed.
if (!!dbRefUpdate(!element).not()) then
   !!alert.error(!!error.text)
endif

-- Grab type
!type    = !element.type

-- Store attributes ready for setting.
!atts = !element.attlist

-- Run round the attributes and see if the form has this particular attribute setting.
  do !attribute value !atts
    !att = !attribute.substring(1,4)

    if (defined(!val)) then
      !val.delete()
    endif

    !val = !form.attribute(!type & !attribute).val
    handle (2,759) (99,532) (2,766)

      -- Handle error because $!attribute gadget doesn't exist.

      if (!attribute EQ 'LEVE') then
        -- Deal with the LEVEL Attribute.
        !values[1] = !form.attribute(!attribute & 1).val
        !values[2] = !form.attribute(!attribute & 2).val
        !!ce.attribute('LEVE') =  !values
        skip

      elseif (!attribute eq 'PURP') then
        -- PURPOSE attribute
        !purp = !form.attribute(!attribute).val
        if (!purp.length() gt 4) then
            !!alert.error('Purpose limited to 4 characters - truncated.')
        endif
        !cmnd = 'PURPOSE ' & !form.attribute(!attribute).val.substring(1,4)
        $!cmnd
        handle (47,62)
        endhandle
        skip

      elseif (!attribute eq ('PTS')) then
        -- Deal with PTS Attribute.
         !string[1] = !form.attribute(!type & !attribute & 1).val
         !string[2] = !form.attribute(!type & !attribute & 2).val

        if (!form.lineTang.val) then
         !string[3] = !form.attribute(!type & !attribute & 3).val
         !string[3] = !string[3].upcase().replace('P','').replace('T','')
         !cmnd = 'SETPOINT ' & !string[1] & 'T' & !string[3] & !string[2]
        else
         !cmnd = 'SETPOINT ' & !string[1] & ' ' & !string[2]
        endif

         $!cmnd
         handle (47,62)
            -- !!alert.error(!!error.text)
            -- Incomplete command line, means likely pressed apply button without filling in data.
         endhandle
        skip

      elseif (!attribute inset ('TUFL','CLFL')) then
        -- Deal with TUFL and CLFL Attributes.
        !!ce.attribute(!attribute) =  !form.attribute(!attribute).val
        skip

      elseif (!attribute inset ('NAPP','OBST')) then
        -- NAPP and OBST Flag Setting
        !setting = !form.attribute(!attribute).rtext[!form.attribute(!attribute).val].real()
        !!ce.attribute(!attribute) = !setting
        skip

      else
        -- Attribute $!attribute not catered for.

      endif
    elsehandle none

      -- Set the attribute just set by combination of type and attribute.
      -- if other than those above.
      -- Now set the attribute on the element.

      -- Check to see if the gadget we are using is a LIST gadget
      if (!form.attribute(!type & !attribute).type() EQ 'LIST') then

        !!ce.attribute(!attribute) = !form.attribute(!type & !attribute).rtext[!form.attribute(!type & !attribute).val]
        handle (2,794)
          -- Handle case where value is expected to be a real.
          !!ce.attribute(!attribute) = !form.attribute(!type & !attribute).rtext[!form.attribute(!type & !attribute).val].real()
        endhandle

      else

        -- Check for LHIDE here and swap sense.
        if (!attribute.eq('LHIDE')) then
          !swap = !val.boolean().not()
          $!attribute $!swap
          handle (2,9)
            !!alert.error(!!error.text)
            -- Too many values for DTITL ($!attribute $!swap)
          endhandle
          skip
        endif

        -- Deal with the PLINE and PKEY Setting for the parent NAREF attribute setting.
        if (!type EQ 'PLIN' AND !attribute EQ 'PKEY' AND !form.attribute(!type & !attribute).val.upcase() EQ 'NA') then
          -- Set the NAREF of the parent here.
          !!ce.owner.naref = !!ce
          handle any
              !!alert.error(!!error.text)
          endhandle
        endif
        handle (2,754)
          -- Likely means someone has pressed the APPLY button with the SKEY not set to anything.
        endhandle

        -- Handle null or empty values used to unset attributes
        if( !val.unset() or (!val.objectType() eq 'STRING' and !val.trim().empty())) then
          if( !attribute eq 'PCON' ) then
            !cmnd = 'PCONN 0'
          else
            !cmnd = !attribute & | unset|
          endif

          $!cmnd
          handle (47,15)
            -- Syntax error
            -- handle horrible attributes that have no default value, but unset is an invalid setting
            -- ignore 'unset' value causing syntax error
            if( !val.objectType() ne 'STRING' ) then
              !!alert.error('Invalid attribute value: ' + !!error.command)
            endif
          elsehandle (2,47)
            -- handles setting NUMB attribute with unset number. Use core default setting
          elsehandle any
            !!alert.error(!!error.text + ': ' + !!error.command)
          endhandle
          skip
        endif

        -- Check for PPROP and DPROP in case RUSE flag needs to be cleared
        if (!attribute inset('PPRO', 'DPRO')) then
          !this.setAttribute(!attribute, !val)
          handle (16, 39) $* 'Dataset expressions of type TEXT cannot be used as RPROPs
            -- Unset RUSE then fall through and try to set the attribute again
            UNSETR
          endhandle
        endif

        -- Set any other attribute
        !this.setAttribute(!attribute, !val)

      endif
    endhandle
  enddo

endmethod

-----------------------------------------------------------------------------------------------------
--
-- Method:
--
-- Description: Updates the form gadgets after the representation form changes settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
-----------------------------------------------------------------------------------------------------
define method .setAttribute(!attribute is STRING, !val is ANY)

  -- Set the attribute
  $!attribute $!val

-- ILLEGAL USE OF STRING DELIMITER '
  handle (47,15) (16,19) (47,62) (2,113) (47,50) (2, 109)
    -- Try Brackets.
    !cmnd = !attribute & | (| & !val & |)|
    $!cmnd
-- ILLEGAL USE OF STRING DELIMITER '
    handle (47,15) (2,402) (47,62) (2,404) (2,201) (47,50) (2,10)
      -- Syntax error, text expression expected, incomplete command line, real expression expected, attribute does not exist,
      -- foreign language text, data of wrong type
      -- Try Quotes.
      !cmnd = !attribute & ' |' & !val & '|'
      $!cmnd
      handle (47,15)
        -- Syntax Error or unit qualifier error, we should not get here if the code above has handled all cases.
        !!alert.error(|Invalid expression: $!attribute ($!val)|)
      elsehandle (2,9)
        !!alert.error(|Too many values for $!attribute ($!val)|)
      elsehandle any
        !!alert.error(!!error.text)
      endhandle
    endhandle
  endhandle

endmethod
-- End of method .setAttribute

-----------------------------------------------------------------------------------------------------
--
-- Method:      onRepresentationChange
--
-- Description: Updates the form gadgets after the representation form changes settings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R
-- Return:
--   [Data Type] [Description]
--
-----------------------------------------------------------------------------------------------------

define method .onRepresentationChange(!form is FORM)

  !form.ppoints.val = !!gphDrawlistRep.pPointsG.val
  !form.plines.val = !!gphDrawlistRep.pLinesG.val

endmethod
-- End of method definition for .onRepresentationChange
