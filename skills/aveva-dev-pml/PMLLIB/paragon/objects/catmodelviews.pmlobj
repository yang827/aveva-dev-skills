    !form.compAction6.callback = |!this.refData.getRefList('SCOM','CCORSE','*',!this.compField6)|

    !form.ceField3.callback = |!!catModelViews.currentElement(!this.ceField3,'PTSE','compField3')|
    !form.ceField4.callback = |!!catModelViews.currentElement(!this.ceField4,'GMSE','compField4')|
    !form.ceField5.callback = |!!catModelViews.currentElement(!this.ceField5,'DTSE','compField5')|
    !form.ceField6.callback = |!!catModelViews.currentElement(!this.ceField6,'CCORSE','compField6')|

    !form.categoryAction3.callback = |!this.refData.getRefList('SCOM','PTSE','*',!this.categoryField3)|
    !form.categoryAction4.callback = |!this.refData.getRefList('SCOM','GMSE','*',!this.categoryField4)|

    !form.categoryCeField3.callback = |!!catModelViews.currentElement(!this.categoryCeField3,'PTSE','categoryField3')|
    !form.categoryCeField4.callback = |!!catModelViews.currentElement(!this.categoryCeField4,'GMSE','categoryField4')|
    !form.categoryCeField5.callback = |!!catModelViews.currentElement(!this.categoryCeField5,'DTSE','categoryField5')|

  else

    !form.compAction3.callback = |!this.refData.getRefList('SCOM','PTSE','*',!this.compField3)|
    !form.compAction4.callback = |!this.refData.getRefList('SCOM','GMSE','*',!this.compField4)|
    !form.compAction5.callback = |!this.refData.getRefList('SCOM','DTSE','*',!this.compField5)|
    !form.compAction6.callback = |!this.refData.getRefList('SCOM','BTSE','*',!this.compField6)|

    !form.ceField3.callback = |!!catModelViews.currentElement(!this.ceField3,'PTSE','compField3')|
    !form.ceField4.callback = |!!catModelViews.currentElement(!this.ceField4,'GMSE','compField4')|
    !form.ceField5.callback = |!!catModelViews.currentElement(!this.ceField5,'DTSE','compField5')|
    !form.ceField6.callback = |!!catModelViews.currentElement(!this.ceField6,'BTSE','compField6')|

    !form.categoryAction3.callback = |!this.refData.getRefList('SCOM','PTSE','*',!this.categoryField3)|
    !form.categoryAction4.callback = |!this.refData.getRefList('SCOM','GMSE','*',!this.categoryField4)|
    !form.categoryAction5.callback = |!this.refData.getRefList('SCOM','DTSE','*',!this.categoryField5)|

    !form.categoryCeField3.callback = |!!catModelViews.currentElement(!this.categoryCeField3,'PTSE','categoryField3')|
    !form.categoryCeField4.callback = |!!catModelViews.currentElement(!this.categoryCeField4,'GMSE','categoryField4')|
    !form.categoryCeField5.callback = |!!catModelViews.currentElement(!this.categoryCeField5,'DTSE','categoryField5')|

  endif

  !this.cateAction.addpixmap(!backIcon)
  !this.datarbut.addpixmap(!backIcon)
  !this.compAction3.addpixmap(!backIcon)
  !this.compAction4.addpixmap(!backIcon)
  !this.compAction5.addpixmap(!backIcon)
  handle (2,759)
  endhandle
  !this.compAction6.addpixmap(!backIcon)

  !this.categoryAction3.addpixmap(!backIcon)
  !this.categoryAction4.addpixmap(!backIcon)
  !this.categoryAction5.addpixmap(!backIcon)
  handle (2,759)
  endhandle

  if (!curApp eq 'STL' or !curApp eq 'HVAC' or !curApp eq 'EQUI' or !curApp eq 'ACCO') then
      !this.categoryAction6.addpixmap(!backIcon)
      !this.compAction7.addpixmap(!backIcon)
      !this.categoryAction7.addpixmap(!backIcon)
  elseif (!curApp eq 'ELEC') then

  else
      !this.compAction6.addpixmap(!backIcon)
  endif

  !this.paramUp.addpixmap(!upIcon)
  !this.paramDn.addpixmap(!downIcon)
  -- Bug fix for P-18266, P-18742, P-22819 Moving parameters is too dangerous to leave
  -- exposed to the end user. Buttons are hidden here but may be reinstated later
  -- when parameter move can be safely implemented
  !this.paramUp.visible = false
  !this.paramDn.visible = false
  -- end Bug fix

  !this.sextup.addpixmap(!upIcon)
  !this.sextdn.addpixmap(!downIcon)

  !this.gmseDelete.addpixmap (!deleteIcon)
  !this.gmssDelete.addpixmap (!deleteIcon)
  !this.ngmsDelete.addpixmap (!deleteIcon)
  !this.dtsedel.addpixmap    (!deleteIcon)
  !this.btseDel.addpixmap    (!deleteIcon)
  !this.ptrefDelete.addpixmap(!deleteIcon)
  !this.plineDelete.addpixmap(!deleteIcon)
  !this.coreDelete.addpixmap (!deleteIcon)
  !this.cateDelete.addpixmap (!deleteIcon)
  !this.paramDelete.addpixmap(!deleteIcon)
  !this.sextdel.addpixmap    (!deleteIcon)

  !form.view.borders      = TRUE
  !form.view.shaded       = TRUE

  !dtext[1] = |Axial P-Point (PTAX)|
  !dtext[2] = |Cartesian P-Point (PTCA)|
  !dtext[3] = |Mixed Type P-Point (PTMI)|
  !dtext[4] = |Position Type P-Point (PTPOS)|
  !rtext[1] = |PTAX|
  !rtext[2] = |PTCA|
  !rtext[3] = |PTMI|
  !rtext[4] = |PTPOS|

-- ppoint creation.
  !form.ptrefCreate.dtext = !dtext
  !form.ptrefCreate.rtext = !rtext
  !form.ptrefCreate.callback = |!!modelView| & !number & |.ptse.createNew(!!modelView| & !number & |, | & |!!modelView| & !number & |.ptrefCreate.selection())|
  !form.ptrefCopy.callback   = |!!modelView| & !number & |.ptse.copy(!!modelView| & !number & |.ptrefList)|

-- Apply Actions.
  !form.coreApply.callback     = |!!modelView| & !number & |.ptse.apply (!!modelView| & !number & |.coreList)|
  !form.ptrefApply.callback    = |!!modelView| & !number & |.ptse.apply (!!modelView| & !number & |.ptrefList)|
  !form.gmseApply.callback     = |!!modelView| & !number & |.ptse.apply (!!modelView| & !number & |.gmrefList)|
  !form.gmssApply.callback     = |!!modelView| & !number & |.ptse.apply (!!modelView| & !number & |.gstrefList)|
  !form.dtseapp.callback       = |!!modelView| & !number & |.dtse.apply (!!modelView| & !number & |.dtselist,!!modelView| & !number & |.dtselist.selection().dbref())|
  !form.ngmsApply.callback     = |!!modelView| & !number & |.ptse.apply (!!modelView| & !number & |.ngmrefList)|
  !form.compApply.callback     = |!!modelView| & !number & |.scom.apply (!!modelView| & !number & |)|
  !form.plineApply.callback    = |!!modelView| & !number & |.ptss.apply (!!modelView| & !number & |.plineList)|
  !form.categoryApply.callback = |!!modelView| & !number & |.scom.categoryApply (!!modelView| & !number & |)|

-- Pline creation.
  !form.plineList.callback     = |!!catModelViewsGetList(|

  !pskeyd[1] = |NULL|
  !pskeyd.append(|Butt Weld|)
  !pskeyd.append(|Compression|)
  !pskeyd.append(|Flange|)
  !pskeyd.append(|Screwed|)
  !pskeyd.append(|Socket Weld|)
  !pskeyd.append(|Plain|)

  !pskeyr[1] = |NULL|
  !pskeyr.append(|BW|)
  !pskeyr.append(|CP|)
  !pskeyr.append(|FL|)
  !pskeyr.append(|SC|)
  !pskeyr.append(|SW|)
  !pskeyr.append(|PL|)
  !form.ptaxpske.dtext = !pskeyd
  !form.ptaxpske.rtext = !pskeyr
  !form.ptcapske.dtext = !pskeyd
  !form.ptcapske.rtext = !pskeyr
  !form.ptmipske.dtext = !pskeyd
  !form.ptmipske.rtext = !pskeyr
  !form.ptpospske.dtext = !pskeyd
  !form.ptpospske.rtext = !pskeyr

  !pvifd[1] = |Visible in All|
  !pvifd.append(|Visible in DRAFT|)
  !pvifd.append(|Visible in DESIGN|)
  !pvifd.append(|Not Visible|)

  !pvifr[1]   = |0|
  !pvifr.append(|1|)
  !pvifr.append(|2|)
  !pvifr.append(|3|)

  !form.ptaxpvif.dtext = !pvifd
  !form.ptaxpvif.rtext = !pvifr
  !form.ptcapvif.dtext = !pvifd
  !form.ptcapvif.rtext = !pvifr
  !form.ptmipvif.dtext = !pvifd
  !form.ptmipvif.rtext = !pvifr
  !form.ptpospvif.dtext = !pvifd
  !form.ptpospvif.rtext = !pvifr

  !form.localDrawlists = true

  -- View settings
  !form.view.direction   = !!catModelViews.viewDirection
  !form.view.borders     = false
  !form.view.shaded      = true
  !form.view.background  = !!cdcaccol[2]

  -- View menus
  !form.newMenu('lviewPopup')
  !form.newMenu('lmouseMenu')
  !form.newMenu('llookMenu')
  !form.newMenu('lisoMenu')
  !form.newMenu('llimitsMenu')
  !form.newMenu('lrotateMenu')
  !form.newMenu('lsettingsMenu')

  !form.lviewPopup.add('menu', 'View Control', 'lmouseMenu')
  !form.lviewPopup.add('separator')
  !form.lviewPopup.add('menu', 'Look',         'llookMenu')
  !form.lviewPopup.add('menu', 'Iso',          'lisoMenu')
  !form.lviewPopup.add('menu', 'Limits',       'llimitsMenu')
  !form.lviewPopup.add('separator')
  !form.lviewPopup.add('menu', 'Settings',     'lsettingsMenu')

  !form.lmouseMenu.add('callback', 'Zoom  F2',   '!!gphViews.doMenuAction(')
  !form.lmouseMenu.add('callback', 'Pan  F3',     '!!gphViews.doMenuAction(')
  !form.lmouseMenu.add('callback', 'Rotate  F5', '!!gphViews.doMenuAction(')
  !form.lmouseMenu.add('callback', 'Walk  F6',   '!!gphViews.doMenuAction(')

  !form.llookMenu.add('callback', ' Z',          '!!gphViews.look(')
  !form.llookMenu.add('callback', '-Z',          '!!gphViews.look(')
  !form.llookMenu.add('callback', ' Y',          '!!gphViews.look(')
  !form.llookMenu.add('callback', '-Y',          '!!gphViews.look(')
  !form.llookMenu.add('callback', ' X',          '!!gphViews.look(')
  !form.llookMenu.add('callback', '-X',          '!!gphViews.look(')
  !form.llookMenu.add('separator')
  !form.llookMenu.add('CALLBACK', 'Explicit...', '!!gphViews.lookExplicit(')

  !form.lisoMenu.add('callback', 'One',          '!!gphViews.isometric(')
  !form.lisoMenu.add('callback', 'Two',          '!!gphViews.isometric(')
  !form.lisoMenu.add('callback', 'Three',        '!!gphViews.isometric(')
  !form.lisoMenu.add('callback', 'Four',         '!!gphViews.isometric(')

  !form.llimitsMenu.add('callback', 'Model',     '!!catModelViews.limits(' & !formName & ')')
  !form.llimitsMenu.add('separator')
  !form.llimitsMenu.add('callback', 'Increase',  '!!catModelViews.limitsIncrease(' & !formName & ')')
  !form.llimitsMenu.add('callback', 'Decrease',  '!!catModelViews.limitsDecrease(' & !formName & ')')

  !form.lsettingsMenu.callback = '!!gphViews.graphicsToggles('
  !form.lsettingsMenu.add('toggle', 'Eye  F7',         '!!gphViews.doMenuAction(')
  !form.lsettingsMenu.add('toggle', 'Shaded  F8',      '!!gphViews.doMenuAction(')
  !form.lsettingsMenu.add('toggle', 'Borders  F9',     '!!gphViews.doMenuAction(')
  !form.lsettingsMenu.add('toggle', 'Perspective  F4', '!!gphViews.doMenuAction(')
  !form.lsettingsMenu.add('separator')
  !form.lsettingsMenu.add('callback', 'Background...',  '!!gphViews.colour(')

  !form.view.setPopup(!form.lviewPopup)

  -- Set tooltips.
  !form.refData.setTooltips(!form)

  -- Sort out hiding the geometry forms.
  !formlist = !form.gadgets()

  !form.forceCellValue = FALSE
  !form.updateCellVal = FALSE
  -- Sort out hiding the geometry gadgets.
  !form.cateComp.visible = FALSE

  -- Hide specific gadgets for marine applications.
     var !marine evar 'AVEVA_MARINE'
     if (!marine.upcase() NE 'YES') then
           !form.sexthulapp.visible = FALSE
           !form.sextbvsegn.visible = FALSE
           !form.sextbvcodn.visible = FALSE
           !form.nsexhulapp.visible = FALSE
           !form.nsexSplate.visible = FALSE
           !form.nsexbvsegn.visible = FALSE
           !form.nsexbvcodn.visible = FALSE
           !form.sprohulapp.visible = FALSE
           !form.sprodesxcl.visible = FALSE
           !form.sprospla.visible   = FALSE
     endif

  -- Cycle round gadgets and hide the geometry ones prior to being used.
     !print = false
  do !f value !formlist

     -- Capture the names of frames for hiding the frames for geometry definition, after this point.
     -- This also captures the GMSS frames.
     if (!f.name().string() EQ 'GMSEFRAME') then
         !print = true
         skip
     endif

     -- Turn off capturing names of frames for geometry after the frame they are in.
     if (!f.name().string() EQ 'SEARCHFRAME') then
         !print = false
     endif

     -- Make invisible the ones we have in this main frame
     if (!print) then
      if (!f.type() EQ 'FRAME') then
         !name = !f.name()
         -- Now make invisible the geometry frames.
         !form.attribute(!name).visible = FALSE

         -- Add to hidden list of gadgets, ready for later.
         !form.hiddenGadgets.append(!name)
      endif
     endif
  enddo

  -- Load any forms that need to be around for everything to work.
  -- Setup the modify Attributes form.
  if( not defined(!!catModifyAttribs) ) then
    pml load form !!catModifyAttribs
  endif

  return !form

endmethod
-- End of method definition for .defineForm(REAL) is FORM

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialise method for the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init(!form is FORM)

  -- Check at appropriate level
  if (!!ce.type not inset(|CATE|, |STCA|)) then
    !listOrder1 = !!ce.ahlist.findFirst(|CATE|)
    !listOrder2 = !!ce.ahlist.findFirst(|STCA|)
    if (!listOrder1.set()) then
      !!ce = !!ce.ownlst[!listOrder1]
    elseif (!listOrder2.set()) then
      !!ce = !!ce.ownlst[!listOrder2]
    else
      return error 1 |Current element is not a Category or Structural Category|
    endif
  endif

  -- Set initial frame visibility
  !this.showAttributes(!form)

  -- Set basic reference options
  !dtext    = ARRAY()
  !dtext[1] = |unset|
  !dtext[2] = |Search...|
  !dtext[3] = |Use CE|

endmethod
-- End of method definition for .init(FORM)

------------------------------------------------------------------------
--
-- Method:      checkCombo
--
-- Description: Checks and sets up combo lists
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkCombo(!gadget is GADGET, !action is STRING)

  -- Get previous list and remove the "Choose or enter GType"
  !currentList = !gadget.dtext
  if (defined(!currentList[1])) then
    if (!currentList[1] eq !this.gtypeComboText) then
        !currentList.removeFirst()
    endif
  endif

-- Used when creating a new entry by user input.
if (!action eq 'VALIDATE') then

  -- Go get the current DTEXT
  !newEntry     = !gadget.displayText().substring(1,4)

  if (unset(!currentList.findFirst(!newEntry))) then
      !currentList.append(!newEntry)
      !currentList.unique().sort().invert()
      !currentList.append(!this.gtypeComboText)
      !gadget.dtext = !currentList.invert()
      !gadget.val   = !gadget.dtext.findFirst(!newEntry)
  endif

-- Used when modifying a new entry by user input.
elseif (!action eq 'CURRENT') then

  !newEntry     = !!ce.gtype
    handle any
      !newEntry = ''
    endhandle

   if (!newEntry eq '') then
      !gadget.val   = 1
   elseif (unset(!currentList.findFirst(!!ce.gtype))) then
      !currentList.append(!newEntry)
      !currentList.unique().sort().invert()
      !currentList.append(!this.gtypeComboText)
      !gadget.dtext = !currentList.invert()
      !gadget.val   = !gadget.dtext.findFirst(!newEntry)
  endif

-- Used when creating the list first time.
elseif (!action eq 'INIT') then

   !form = !gadget.owner()
-- Fill out the list of available GTYPES. and for ($!!ce.gtyp)
   if (!gadget.dtext.empty()) then
     -- Setup the list for the first time.
        !gadget.dtext = !form.refData.getGtype(!!ce)
   else
     -- Call this for each elements we edit from now on, make the list reflect all those GTYES we find.
        !this.checkCombo(!gadget, 'CURRENT')
    endif
    -- Removes blank entries from dtext array to stop field appearing blank in form
    !blankEntry = !gadget.dtext.findFirst('')
    if (!blankEntry.set() AND !blankEntry.neq(0)) then
      !tmp = !gadget.dtext
      !tmp.removefrom(!blankEntry,1)
      !gadget.dtext = !tmp
    endif

endif

endmethod
-- End of method definition for .checkCombo(gadget,string)
------------------------------------------------------------------------
--
-- Method:      initSearch
--
-- Description: Initialise Search panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSearch(!args is ARRAY)

  -- Set initial search criteria
  -- Array 1 = Name of elements to search for.
  -- Array 2 = Scope of search.
  -- Array 3 = Type of element to search for
  -- Array 4 = The form we are in at this point.
  !name   = !args[1]
  !searchScope = !args[2]
  !types  = !args[3]
  !form   = !args[4]

  -- Data base types
  !dbType = |CATA|

  -- Element types
  !eleTypes[1] = !types

  -- Scope list
  !scope[1] = !searchScope
  --!scope[1] = |PIPE-PRTWLD|
  --!scope[2] = |EQUI-PRTWLD|
  --!scope[3] = |STL-PRTWLD|
  --!scope[4] = |ACCO-PRTWLD|
  --!scope[5] = |HVAC-PRTWLD|
  --!scope[6] = |ELEC-PRTWLD|
  -- Attribute filters
  !filters[1] = |NAME like | & !name

  -- Results columns
  !columns[1] = |DESC Description|
  !columns[2] = |NAME Name|

  -- Disable the 'Use selected' button as there are no results to select
  !form.bnSearchAdd.active = false

  -- Initialise search control
  !displayResults = false

  !form.searchControl.initiateSearch(!displayResults, |Search|, !dbType, !scope, !eleTypes, !filters, !columns)

endmethod
-- End of method definition for .initSearch(FORM)

------------------------------------------------------------------------
--
-- Method:      checkNumberOfParams
--
-- Description: Check that the text gadget contains the correct number of parameters
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Value of the field.
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkNumberOfParams(!gadget is GADGET)

!form = !gadget.owner()

!dbref = !form.component

var !params param of $!dbref
if (!params.upcase() EQ 'UNSET') then
  !numParams = 0
else
  !numParams = !params.split().size()
endif

!numValues = !gadget.val.split().size()
handle (2, 754)(2, 759)   $* gadget value is unset, empty or contains only white space
    !numValues = 0
endhandle

if (!numParams ne !numValues) then
  !restoreParams = !!alert.confirm('The parameters text box does not contain the same number of values as the component.' & $
                                   ' Do you want to restore the original component parameters?')
  if (!restoreParams.boolean()) then
    !gadget.val = !params
  endif
endif

endmethod
-- End of method definition for .checkNumberOfParams(GADGET)

------------------------------------------------------------------------
--
-- Method:      modelResultsSelected
--
-- Description: After select event for search control on the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Model View form
--    2   R      ARRAY       Search results data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modelResultsSelected(!form is FORM, !data is ARRAY)

  -- !data[0], [1], ... are strings of selected elements from search results
  -- Store selected results as form member dbref array

  !form.searchResults.clear()

  do !i from 0 to (!data.size() - 1)
    break if (!data[!i].unset())
       !element = !data[!i].dbref()
    handle any
      -- Ignore if badref
    elsehandle none

        -- Add this element to the list.
        !form.searchResults.append(!element)

    endhandle
  enddo

  -- Activate gadget
  !form.bnSearchAdd.active = (!form.searchResults.size() eq 1)

endmethod
-- End of method definition for .partResultsSelected(FORM, ARRAY)

------------------------------------------------------------------------
define method .auto(!form is FORM)

    !form.getElement.setAttributes()

endmethod
-- End of method definition for .auto(FORM)

------------------------------------------------------------------------
define method .lineTangent(!gadget is GADGET, !action is STRING)

    !form = !gadget.owner()

    if (!action EQ 'SELECT') then
       !form.linepts3.active    = TRUE
       !form.lineppoint3.active = TRUE
    else
       !form.linepts3.active    = FALSE
       !form.lineppoint3.active = FALSE
    endif

endmethod
-- End of method definition for .auto(FORM)

------------------------------------------------------------------------
define method .backButton(!gadget is GADGET)

    !form = !gadget.owner()

    -- Set the first field as current.
    !gadget.val = 1
    !!catSetCateReferences(!form.compAttribList,'SELECT')

endmethod
-- End of method definition for .auto(FORM)
------------------------------------------------------------------------
define method .currentElement(!gadget is GADGET, !what is STRING, !where is STRING)


 !form = !gadget.owner()

 -- Check for active gadgets.
 if (!form.attribute(!where).active) then

   do !type value !what.split(',')
      if (!!ce.type eq !type) then
        -- Set the field value to the current element.
           !form.attribute(!where).val = !!ce.name
           break
      endif
   enddo

 endif

endmethod
-- End of method definition for .auto(FORM)

------------------------------------------------------------------------
define method .checkSlash(!gadget is GADGET)

    if (!gadget.val.set()) then
      if (!gadget.val.trim().empty().not()) then
        if (!gadget.val.substring(1,1) ne ('/') and !gadget.val.substring(1,1) ne '=') then
          !gadget.val = '/' & !gadget.val
        endif
      endif
    endif

endmethod
-- End of method definition for .checkSlash(!gadget)

------------------------------------------------------------------------
define method .showPointsNlines(!gadget is GADGET)

    !form = !gadget.owner()

    if(undefined(!!gphDrawlistRep)) then
      pml load form !!gphDrawlistRep
    endif

    !!gphDrawlistRep.setup(!form.view)
    !!gphDrawlistRep.initialise()

    if (!gadget.name() EQ 'PPOINTS') then
        !!gphDrawlistRep.pPointsG.val = !gadget.val
        !!gphDrawlistRep.pPointsNumbersG.val = !gadget.val

    else
        !!gphDrawlistRep.pLinesG.val = !gadget.val
        !!gphDrawlistRep.pLinesPkeyG.val = !gadget.val

    endif

    -- Call the apply method, which updates the graphics.
       !!gphDrawlistRep.apply()

    -- Now highlight the element that was already highlighted, because it will no longer be highlighted.
       !form.getElement.track(!form, !form.getElement.highlighted)

endmethod
-- End of method definition for .showPointsNlines(!gadget)

------------------------------------------------------------------------
define method .representation(!form is FORM)

-- Representation form
    if(undefined(!!gphDrawlistRep)) then
      pml load form !!gphDrawlistRep
    endif

    !!gphDrawlistRep.setup(!form.view)
    !!gphDrawlistRep.setAfterApplyCallback('!!catModelViews.onRepresentationChange(!!' + !form.name() + ')')
    show !!gphDrawlistRep

endmethod
-- End of method definition for .representation

------------------------------------------------------------------------
--
-- Method:      tabset
--
-- Description: Rename part
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling Gadget Reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tabset(!gadget is GADGET, !string is STRING)
------------------------------------------------------------------------
!save = !!ce
if (!string.eq('SHOWN')) then

!tab = !gadget

!form = !gadget.owner()

!ref = !form.partAttribList.selection()
$!ref

!!catSetCateReferences(!form.partAttribList, !string)
!!catSetComponentValues(!tab, !string)

endif

!!ce = !save
endmethod
-- End of method definition for .tabset()

------------------------------------------------------------------------
--
-- Method:      pickppoint
--
-- Description: Rename part
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling Gadget Reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickppoint(!gadget is GADGET, !string is STRING)
------------------------------------------------------------------------
   !form = !gadget.owner()
   !!returnGadget = !string

  -- Check to see if PPOINTS are switched on.
  if (!!gphDrawlistRep.pPointsG.val) then

  -- Set Defaults for Modes
  !form.view.navi.cursor     = 'Pointer'
  !form.view.navi.prompt     = 'Navigate : '

  !form.view.pick.cursor     = 'Pointer'
  !form.view.pick.prompt     = 'Pick Element : '

  !form.view.point.cursor    = 'Pick'
  !form.view.point.prompt    = 'Point Ppoint : '

  !form.view.default.cursor   = 'Pointer'
  !form.view.default.prompt   = '  '

  !form.view.callback = '!!catModelViews.inModeData('
  !form.view.setinmode('POINT')

  else

     !!alert.message('PPoints are not switched on - enable through Representation')

  endif
   handle (2,751)
     -- No points to pick.
   endhandle

   !form.prompt.background = !form.background

endmethod
-- End of method definition for .pickppoint()

------------------------------------------------------------------------
--
-- Method:      inmodedata
--
-- Description: Rename part
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling Gadget Reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .inModeData(!gadget is GADGET, !string is STRING)
------------------------------------------------------------------------
  !form = !gadget.owner()

  -- Grab data from cursor pick.
  !ref = !form.view.inmode.data[3]

  -- reset cursor mode back default condition of navigating.
  !form.view.point.cursor   = 'Pointer'
  !form.view.point.prompt   = ''

  !form.view.setinmode('DEFAULT')
  !form.view.runInMode('Native')

  !form.attribute(!!returnGadget).val = 'P' & !ref.number.string()

   !form.prompt.background = !form.background
endmethod
-- End of method definition for .inModeData()

------------------------------------------------------------------------
--
-- Method:      actionSearch
--
-- Description:  Gadget actions for Search panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionSearch(!gadget is GADGET, !action is STRING)

  -- Get owning form
  !form = !gadget.owner()

  -- Button actions
  -- return current element back to current component.
  !!ce = !form.component

  -- Check for when we are setting the current element.
  if (!gadget eq !form.bnSearchAdd and !action eq |SELECT| and !form.resultsTarget eq !form.cateComp) then
      -- We are setting the current element.
      !!ce = !form.searchResults[1].name.dbref()
      !!catModelViews.setCe(!gadget, !action)
--      !!catSetCateReferences(!form.compAttribList,'SELECT')
      return
  endif

  -- Add selected search results to table
  if (!gadget eq !form.bnSearchAdd and !action eq |SELECT|) then
  -- Set the gadget to the value from the search panel.

      !form.resultsTarget.val = !form.searchResults[1].name
      handle (2,752)
      endhandle

      if (!form.returnToFrame.match('CATEGORY') ne 0) then
          !form.refData.setFrame(!form.component.owner.type,!form)
      else
          !form.refData.setFrame(!form.component.type,!form)
      endif

  elseif (!gadget eq !form.bnSearchNew and !action eq |SELECT|) then
  -- Initialise new search
       !this.initSearch(!form.searchData)

  elseif (!gadget eq !form.bnReturn and !action eq |SELECT|) then
  -- Return to Front Panel for Search Changes
      -- Reset the lower lists to those elements left.
      --!form.refData.setFrame('LIST',!form)
        !!catSetCateReferences(!form.compAttribList,'SELECT')

  endif


endmethod
-- End of method definition for .actionSearch()

------------------------------------------------------------------------
--
-- Method:      rename
--
-- Description: Rename part
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .rename(!form is FORM)
------------------------------------------------------------------------

  -- Check and rename part
  if (!form.partName.val.trim() eq ||) then
    return error 1 |Name required|
  endif
  !newName = !!checkName(!form.partName.val, |NEW|)
  !form.part.name = !newName

endmethod
-- End of method definition for .rename(FORM)

