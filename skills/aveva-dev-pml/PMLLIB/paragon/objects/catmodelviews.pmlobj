       button .categoryAction4 ' ' at xmax.categoryField4 ymin.categoryField4  anchor left pixmap width 16 height 16   width 16
       button .categoryAction5 ' ' at xmax.categoryField5 ymin.categoryField5  anchor left pixmap width 16 height 16   width 16

