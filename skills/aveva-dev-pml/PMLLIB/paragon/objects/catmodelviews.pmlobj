      !form.searchGadget = !gadget
      !this.showSearch(!form)

    -- Set ref to current element
    elseif (!gadget.selection() eq |Use CE|) then


    else

      -- Typed in reference

    endif

  endif

endmethod
-- End of method definition for .refCombo(GADGET, STRING)

