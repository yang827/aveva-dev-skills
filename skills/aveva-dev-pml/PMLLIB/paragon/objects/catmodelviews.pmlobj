    exit

    --===============================================          ============================================================
    --                                                  DTSE
    --===============================================          ============================================================
    frame .dtseFrame panel '' at x 0.25 ymax.outside + .4     anchor left + right + bottom
       list .dtselist |Data References| at y0.3               anchor left           height 12   width 31

      frame .dtseProperty 'Property' at xmax.dtselist + 1     anchor all
        text   .datadtit 'Description'                        anchor left+right  tagwidth 8     width 38 is STRING
        text   .datadkey 'Key'         at xmax ymin           anchor right       tagwidth 3     width 6  is STRING
        option .datadefn 'Definition'  at xmin.datadtit ymax+1         anchor left        tagwidth 8     width 14
        text   .datanumb 'No.'         at xmin.datadkey       anchor right       tagwidth 3     width 6 is REAL FORMAT !!integerFmt
        text   .datapurp 'purpose'     at x 0 y 0 width 1 is STRING
        text   .dataptyp 'ptype'       at x 0 y 0 width 1 is STRING

        -- Button for reference on desi elements.
        button   .datarbut ''           at xmax.datadtit + 5 ymin.datadkey   anchor right pixmap           width 1 height 16
      exit

      frame .dtsedata 'Data' at xmin ymax.dtseProperty + 2               anchor all
        option .dataptypeOpt 'Type'    at               y 0                 anchor       left             width 10
        text   .datadpro  '     Default' at xmax.dataptypeOpt +0.7 ymin.dataptypeOpt anchor right+left tagwidth 9  width 28 is STRING
        text   .datappro  'Expression'    at x0            ymax+1        anchor right+left tagwidth 8  width 48 is STRING
      exit

       toggle .datalhide 'Display'    at xmax.dtselist + 2 ymax.dtseProperty + .6
       button .dtsedel ''               at x 1  y 9.5 pixmap                                width 16 height 16
       button .dtsenew 'New'            at x 17 y 9.5                                       width 7
       button .dtsecop 'Copy'           at x 25.25 y 9.5                                       width 7
       button .dtseAttribs linklabel    at x1 Y 11          anchor left   'All Attributes'  width 8

    exit
       button .dtseapp 'Apply'          at x 85 ymax.outside + 12.2     anchor right + bottom			width 8

