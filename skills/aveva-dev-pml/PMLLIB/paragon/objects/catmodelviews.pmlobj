------------------------------------------------------------------------
define method .paramPopup(!menu is MENU, !action is STRING)
------------------------------------------------------------------------
!form = !menu.owner()

if (!menu.pickedfield.lowcase().match('copy') ne 0) then

       -- Copy element
      !form.cate.newcopy(!form,'COPY')
else
      -- Delete this component.
      !form.cate.delete(!form.cateDelete)
endif

endmethod

