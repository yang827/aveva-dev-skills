  !form.gmssCopy.callback       = |!!modelView| & !number & |.gmse.copyGeometry(!!modelView| & !number & |.gstrefList,!!modelView| & !number & |.gstrefList.selection())|
  !form.gmseCreate.callback     = |!!modelView| & !number & |.gmse.createNewPrim(!!modelView| & !number & |.gmrefList,!!modelView| & !number & |.gmseCreate.selection())|
  !form.ngmsCreate.callback     = |!!modelView| & !number & |.gmse.createNewPrim(!!modelView| & !number & |.gmrefList,!!modelView| & !number & |.ngmsCreate.selection())|
  !form.gmssCreate.callback     = |!!modelView| & !number & |.gmse.createNewPrim(!!modelView| & !number & |.gstrefList,!!modelView| & !number & |.gmssCreate.selection())|
