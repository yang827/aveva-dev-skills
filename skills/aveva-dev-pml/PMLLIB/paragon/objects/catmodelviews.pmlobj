--
-- Description:
-- object for part view control
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add()                            -                   Add new model view into the system
--  add(FORM)                        -                   Add existing model view into the system
--  catModelViews()                  -                   Constructor
--  create(STRING,STRING)            -                   Add new category into current hierarchy
--  create(STRING,STRING,ARRAY,STRING) -                   Add new category into current hierarchy
--  createStorageArea(STRING,STRING,STRING) DBREF
--  defineForm(REAL)                 FORM                Create new model view form
--  globalInstance()                 -                   Create global instance of object
--
------------------------------------------------------------------------

-- Define object
define object CATMODELVIEWS

  -- List of graphical views
  member .modelViews       is ARRAY
  member .type             is STRING
  member .gtypeComboText   is STRING

  -- View direction
  member .viewDirection     is ARRAY

endobject
-- End of object definition for catModelViews

------------------------------------------------------------------------
--
-- Method:      catModelViews
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .catModelViews()

  -- View direction Iso 2
  !direction = object DIRECTION(|N 45 W 35.264 D|)
  !this.viewDirection[1] = !direction.east
  !this.viewDirection[2] = !direction.north
  !this.viewDirection[3] = !direction.up

  !this.gtypeComboText = |Choose or Enter GTYPE...|

  pml load form !!catModifyAttribs

endmethod
-- End of method definition for .catModelViews()

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  -- Create Global Variable
  !!catModelViews = !this

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add existing partView into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .add(!form is FORM)

  -- Add form to system
  !this.modelViews.append(!form)

  -- Add to view system (this shows the form)
  !!gphViews.add(!form.view)

  -- Attach drawlist to view (must be after form is shown)
  if (!form.localDrawlists) then
    !form.drawlist = !!gphDrawlists.createDrawlist()
    !!gphDrawlists.attachView(!form.drawlist, !form.view)
  endif

  -- Display scom (must be done after drawlist attach)
  !!catmodelViewInit(!form)

  -- Update control form if exists and shown
  if (defined(!!catControl)) then
    if (!!catControl.shown()) then
      !!catControl.initialise()
    endif
  endif

  -- Set the home directory to PDMSUSER
  !pdmsUser = object FILE('%PDMSUSER%')
  !form.homeDirectory = !pdmsUser.fullName()

endmethod
-- End of method definition for .add(FORM)

------------------------------------------------------------------------
--
-- Method:      createStorageArea
--
-- Description: Creates the Element type given in storage area set in reference area.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type
--    2   R      STRING      Discipline
--    3   R      STRING      Name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .createStorageArea(!type is STRING, !dummyDiscipline is STRING, !name is STRING) is DBREF
------------------------------------------------------------------------

  if( !this.createNewElement(!type,!name) ) then
    !ref = !!ce
  else
    !ref = object DBREF()
  endif

  return !ref

endmethod
-- End of method definition for .createStorageArea(STRING,STRING,STRING)

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Add new category into current hierarchy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Name
--    2   R      STRING      Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
------------------------------------------------------------------------------------------------
define method .create(!name is STRING, !type is STRING, !types is ARRAY, !description is STRING)
------------------------------------------------------------------------------------------------

-- Get purpose of eventual element and structure.
   !purpose = !types[2].trim()

-- now create the required owning structure for the room design elements.
   !storageArea = !this.createStorageArea(!types[4], !!appCntrl.currentApp, !name)
   if( !storageArea.unset() ) then
     return
   endif
   !!ce.purp = !purpose

-- Set the description for the owner here to the pulldown menu selection.
   !!ce.description = |$!description|
   handle any
   endhandle

-- Check the current type of element, and abort if not the correct type.
   if (!!ce.type ne !types[4].trim()) then
       !!alert.error('Not at the correct position in hierarchy, need to be at an' & !types[3].trim() & ' to continue')
       return
   endif

-- now create the required structure for the room design elements.
      !param   = ''
      !refList = ARRAY()
   do !x from 5 to !types.size() - 1
      -- Just add check here for PARAM Case.
      if (!types[!x].trim().substring(1,4) eq 'PARA') then
         !param = !types[!x]
      elseif(!types[!x].trim() eq 'TEXT') then
         -- delay creation of parameters until after component defined
         skip
      else
         !storageArea = !this.createStorageArea(!types[!x], !!appCntrl.currentApp, 'AUTONAME')
         !refList.append(!storageArea)
      endif
   enddo

-- Now create the final element type we want.
   !this.createStorageArea(!types[!types.size()], !!appCntrl.currentApp, 'AUTONAME')
   !component = !!ce

-- Now go set the references for the data types defined.
   do !att value !!ce.attlist
      skip if (!att inset('NAME','TYPE','LOCK','OWNER','DESC','GTYP','PARAM'))

      -- Run round the reflist types and try and connect them together, errors if wrong type.
      do !typ value !refList
         !cmnd = !att & | | & !typ
         $!cmnd
         handle (47,15) (41,52)
         endhandle
      enddo
   enddo

-- Now set the parameters if defined.
   if (!param ne '') then
      !parameterSet = object CATPARAMETERSET(!component)
      !parameterSet.appendParameter('Parameter 1')
      !!ce = !component
      $!param
   endif

-- Now call the add method to display the empty structure we have just created.
   !this.add()

endmethod
-- End of method definition for .create(STRING, STRING, ARRAY)

------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: Add new category into current hierarchy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Name
--    2   R      STRING      Type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
------------------------------------------------------------------------
define method .create(!name is STRING, !type is STRING)
------------------------------------------------------------------------

  -- Load Naming object if not already loaded.
  if (undefined(!!namOptEdit)) then
      loadform !!namOptEdit
      !!namOptEdit.load()
  endif

-- Create Method for -$!name$n- and -$!type$n- for $!!appCntrl.currentApp Module
-- Called from catCreate form ok button.

!this.type = !type

-- Check to see if can in fact create something here.
if (dbwrite EQ FALSE) then
    -- Output message here and abort.
    !!alert.error('Unable to create elements here - Read Only DB')
    return
endif

  !blrf  = =0/0
  !check = !!ce

--                                                     ===================
------------------------------------------------------  STEELWORK
--                                                     ===================
-- ===========================================================
if (!type EQ 'STORAGE' AND !!appCntrl.currentApp.eq('STL')) then
-- ===========================================================

  !storageArea = !this.createStorageArea('STCA', !!appCntrl.currentApp, !name)
  return

elseif (!!appCntrl.currentApp inset(|STL|,|ACCO|,|ROOM|) AND !type NE 'TMPL') then

  -- Create the STCA element here with empty text shown.
    !stca = !this.createStorageArea('STCA', !!appCntrl.currentApp, !name)
    if( !stca.unset() ) then
      -- wrong place in hierarchy or access denied
      return
    endif
    !dtse = !this.createStorageArea('DTSE', !!appCntrl.currentApp, 'AUTONAME')

    if (!this.type NE 'SFIT') then
      !ptss = !this.createStorageArea('PTSS', !!appCntrl.currentApp, 'AUTONAME')
    endif

  -- ====================================== J O I N    &     S F I T ======================
  if (!this.type EQ 'JOIN' or !this.type EQ 'SFIT') then
  -- ====================================== J O I N    &     S F I T ======================

    -- Create a new GMSE Element (Negative Geometry) here
    !gmse = !this.createStorageArea('GMSE', !!appCntrl.currentApp, 'AUTONAME')
    if( !gmse.unset() ) then
      -- wrong place in hierarchy or access denied
      return
    endif
    !ptse = !this.createStorageArea('PTSE', !!appCntrl.currentApp, 'AUTONAME')
    !ngms = !this.createStorageArea('NGMS', !!appCntrl.currentApp, 'AUTONAME')

    -- Create an new element here with references set.
    !!ce = !stca
    LAST MEMBER OF STCA
      handle (2,113)
      endhandle
    !component = !this.createStorageArea(!this.type, !!appCntrl.currentApp, 'AUTONAME')

    PTREF  $!ptse
    if (!this.type NE 'SFIT') then
      PSTREF $!ptss
        handle (41,232)
          -- Doesn't Have this attribute. skip
        endhandle
    endif
    GMREF  $!gmse
    DTREF  $!dtse
    NGMREF $!ngms

-- =============================================== S P R F ===========================
  elseif (!type EQ 'SPRF') then
-- =============================================== S P R F ===========================

    -- Create the elements necessary for the SProfile
    !gmss  = !this.createStorageArea('GMSS', !!appCntrl.currentApp, 'AUTONAME')
    if( !gmss.unset() ) then
      -- wrong place in hierarchy or access denied
      return
    endif

    !!ce = !stca
    LAST MEMBER OF STCA
      handle (2,113)
      endhandle

    -- Create an empty SPRF element here with references set.
    !component = !this.createStorageArea('SPRF', !!appCntrl.currentApp, 'AUTONAME')
    PSTREF $!ptss
    GSTREF $!gmss
    DTREF  $!dtse

  endif

  -- ===================================== First Parameter ===========================
  -- Create first parameter for steelwork type components
  !parameterSet = object CATPARAMETERSET(!component)
  !parameterSet.appendParameter('Parameter 1')
  !!ce = !component
  PARAM 0


-- =========================================================
elseif (!type EQ 'TMPL' AND !!appCntrl.currentApp.eq('STL')) then
-- =========================================================

  -- Create the STCA element here with empty text shown.
  !stca = !this.createStorageArea('STCA', !!appCntrl.currentApp, !name)
  if( !stca.unset() ) then
    -- wrong place in hierarchy or access denied
    return
  endif

  if (!!ce eq !check) then
      return
  endif

  !!ce = !stca
  LAST MEMBER OF STCA
    handle (2,113)
    endhandle
  !sFit = !this.createStorageArea('SFIT', !!appCntrl.currentApp, 'AUTONAME')

  if( !sFit.set() ) then
    -- Create first parameter
    !parameterSet = object CATPARAMETERSET(!sFit)
    !parameterSet.appendParameter('Parameter 1')
    !!ce = !sFit
    PARAM 0

  endif
  !save = !!ce

-- ==========================================================
elseif (!type EQ 'TMPL' AND !!appCntrl.currentApp.eq('EQUI')) then
-- ==========================================================

  -- Create the CATE element here with empty text shown.
  !cate = !this.createStorageArea('CATE', !!appCntrl.currentApp, !name)
  if( !cate.unset() ) then
    -- wrong place in hierarchy or access denied
    return
  endif
  !scom = !this.createStorageArea('SCOM', !!appCntrl.currentApp, 'AUTONAME')

  -- Create first parameter
  !parameterSet = object CATPARAMETERSET(!scom)
  !parameterSet.appendParameter('Parameter 1')
  !!ce = !scom
  PARAM 0

  !save = !!ce

--                                                     =======================
------------------------------------------------------   E L E C T R I C A L
--                                                     =======================

-- ==========================================================
elseif (!type EQ 'CORE' AND !!appCntrl.currentApp.eq('ELEC')) then
-- ==========================================================

  -- Create the CATE element here with empty text shown.
  !cate = !this.createStorageArea('CATE', !!appCntrl.currentApp, !name)
  if( !cate.unset() ) then
    -- wrong place in hierarchy or access denied
    return
  endif
  if (!!ce eq !check) then
      return
  endif
  !!ce.purp = !this.type
  !ptse = !this.createStorageArea('PTSE',  !!appCntrl.currentApp, 'AUTONAME')
  !core = !this.createStorageArea('CCORSE',!!appCntrl.currentApp, 'AUTONAME')

  !!ce = !cate
  LAST MEMBER OF CATE
  handle (2,113)
  endhandle

  !scom = !this.createStorageArea('SCOM',  !!appCntrl.currentApp, 'AUTONAME')
  -- Create first parameter
  !parameterSet = object CATPARAMETERSET(!scom)
  !parameterSet.appendParameter('Parameter 1')
  !!ce = !scom
  PARAM 0

  PTREF   $!ptse
  CCORREF $!core
  !save = !!ce

elseif (!type inset ('TRAY','REPR') AND !!appCntrl.currentApp.eq('ELEC')) then
-- ===========================================================

  -- Create the CATE element here with empty text shown.
  !cate = !this.createStorageArea('CATE', !!appCntrl.currentApp, !name)
  if( !cate.unset() ) then
    -- wrong place in hierarchy or access denied
    return
  endif
  if (!!ce eq !check) then
      return
  endif
  !!ce.purp = !this.type
  !ptse = !this.createStorageArea('PTSE', !!appCntrl.currentApp, 'AUTONAME')
  !gmse = !this.createStorageArea('GMSE', !!appCntrl.currentApp, 'AUTONAME')
  !dtse = !this.createStorageArea('DTSE', !!appCntrl.currentApp, 'AUTONAME')

  !!ce = !cate
  LAST MEMBER OF CATE
    handle (2,113)
    endhandle
  !scom = !this.createStorageArea('SCOM', !!appCntrl.currentApp, 'AUTONAME')
  PTREF   $!ptse
  PTREF $!ptse
  GMREF $!gmse
  DTREF $!dtse

  -- create first parameter
  !parameterSet = object CATPARAMETERSET(!scom)
  !parameterSet.appendParameter('Parameter 1')
  !!ce = !scom
  PARAM 0

else
--                                                       =====================================
--------------------------------------------------------- P I P I N G AND ALL THE O T H E R S
--                                                       =====================================

  -- Create the appropriate elements here with empty text shown.
  !cate = !this.createStorageArea('CATE', !!appCntrl.currentApp, !name)
  if( !cate.unset() ) then
    -- wrong place in hierarchy or access denied
    return
  endif
  if (!!ce eq !check) then
      return
  endif
  !this.createStorageArea('SDTE', !!appCntrl.currentApp, 'AUTONAME')
  !ptse = !this.createStorageArea('PTSE', !!appCntrl.currentApp, 'AUTONAME')
  !gmse = !this.createStorageArea('GMSE', !!appCntrl.currentApp, 'AUTONAME')
  !dtse = !this.createStorageArea('DTSE', !!appCntrl.currentApp, 'AUTONAME')
  !blrf = !this.createStorageArea('BTSE', !!appCntrl.currentApp, 'AUTONAME')

  -- Create an empty SCOM element here with references set.
  !!ce = !cate
  LAST MEMBER OF CATE
    handle (2,113)
    endhandle
  !scom = !this.createStorageArea('SCOM', !!appCntrl.currentApp, 'AUTONAME')

  PTREF $!ptse
  GMREF $!gmse
  DTREF $!dtse
  BLRFA $!blrf

  -- create nominal bore first parameter
  !parameterSet = object CATPARAMETERSET(!scom)
  !parameterSet.appendParameter('Nominal Bore')
  !!ce = !scom
  PARAM 0

endif

  -- Now call the add method to display the empty structure we have just created.
  !this.add()

endmethod

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add new partView into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .add()

  -- Load Naming object if not already loaded.
  if (undefined(!!namOptEdit)) then
      loadform !!namOptEdit
      !!namOptEdit.load()
  endif

  -- Make sure that the current element is in a catalogue hierarchy
  !categoryType[1] = 'CATA'
  if( badref( !!dtbOwnerOfTypes(!!ce,!categoryType)) ) then
    !!alert.error('Cannot find a valid component element from here. Please select a catalogue (CATA) hierarchy')
    return
  endif

  -- Create new form and add to system
  !this.add(!this.defineForm(!this.nextAvailable()))

endmethod
-- End of method definition for .add(FORM)

------------------------------------------------------------------------
--
-- Method:      defineForm
--
-- Description: Add a new model view into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Form number
-- Return:
--   [Data Type] [Description]
--    FORM        Form created
--
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .defineForm(!number is REAL) is FORM
------------------------------------------------------------------------

   import 'GridControl'
   handle any
   endhandle

   import 'PMLDBSearch'
   handle any
   endhandle

  -- Icons used in following Form definition.

  !backIcon                  = !!pml.getPathName('ng_zoomtoselection.png')
  !deleteIcon                = !!pml.getPathName('deletece24.png')
  !downIcon                  = !!pml.getPathName('downarrow16.png')
  !upIcon                    = !!pml.getPathName('uparrow16.png')
  !curApp                    = !!appCntrl.currentApp
  !appType                   = PURP OF CATE
  handle any
       !appType = PURP OF CATE 1
     handle any
       !appType = 'TRAY'
    endhandle
  endhandle

  -- Added this because the anchor of the pixmap buttons needs to change for different modules.
    if (!curApp eq 'STL' or !curApp eq 'HVAC' or !curApp eq 'EQUI' or !curApp eq 'ACCO') then
         !anchor  = 'left'
    else
         !anchor  = 'right'
    endif

  -- Form definition
  !formName   = |!!modelView| & !number
  setup form $!formName dialog docking

    $!<formName>.formTitle     = |Category Editor | & !number
    $!<formName>.iconTitle     = |Category|
    $!<formName>.formRevision  = | $Revision: 1.00 $ |

    frame .fixheight panel at x0 y0 width 1 height 34.5
    exit
    frame .fixwidth panel at x0 y0 width 93 height 0.01
    exit

        button .cateAction ' ' at x0.2 y0.10 pixmap width 1 height 1  anchor left + top               width 16
        button .setCe ' CE '   at xmax.cateAction+0.2 y0.10           anchor left + top               width 5
        option .recent ''      at xmax.setCe+0.5 ymin   tagwidth 1    anchor left + right + top       width 20
    path right
      hdist .5
      toggle .trackCE 'Track'                tagwidth 5              anchor right + top
      toggle .taxes  'Axes'                  tagwidth 4              anchor right + top
      toggle .pPoints 'P-Points'             tagwidth 6              anchor right + top
      toggle .plines  'P-Lines'              tagwidth 5              anchor right + top
      button .representation 'Representation...'          width 11   anchor right + top
      option .trepr  'Repr'                  tagwidth 4              anchor right + top          width 12

    frame .compAttributesFrame panel ''         at x0    ymax                 width 30
       list .compAttribList |Model References:| at x0.25 y0.35  anchor bottom width 29 height 10
    exit

    --===============================================          ============================================================
    --                                                3D View
    --===============================================          ============================================================
    frame .viewFrame panel '' at xmax+0.1 ymin+0.1 anchor all
    para .prompt at x0 y 0 width 60 lines 1
      view .view   at xmin ymax  prompt .prompt volume                                        width 61 height 19.9

      -- Input Modes
        -- Navigate
        inmode create _navi       type |DES_NAVIGATE|
        -- Standard Element Pick
        inmode create _pick       type |DES_PICK|
        -- ppoints
        inmode create _point      type |DES_PICK_POINT|
        -- Default (Navigation)
        inmode create _default    type |DES_NAVIGATE|

    exit
    exit

    --===============================================          ============================================================
    --                                             2D Geometry View
    --===============================================          ============================================================
    frame .plotFrame ''               anchor all at xmin.viewFrame ymax.prompt         width 61 height 19.9
           view .plot1  at x0.1 y0.1   plot
           border on
           height 8
           width 30
           setcolour black
           exit
    exit

    --===============================================          ============================================================
    --                                             Errors List Gadget
    --===============================================          ============================================================
    frame .errorsFrame ''               anchor all at xmin.viewFrame ymax.prompt         width 58 height 18
           list .errors at x 0 y 0                                                       width 58 height 18
    exit

    --===============================================          ============================================================
    --                                              Parameter List
    --===============================================          ============================================================

    frame .params panel ''                    anchor top + left at x0 ymax.compAttributesFrame-.3 width 30
       list .params1 |Parameter Definitions:| anchor top        at x0.2                          width 29 height 11.4
    exit

    --===============================================            ==========================================================
    --                                           LOWER PARAMETER LIST
    --===============================================            ==========================================================
    frame .paramFrame panel '' at x 0.2 ymax.params - 0.8              anchor left + top    width 30
       text .paramStex |Desc:| at xmin y .85    tagwidth 5   width 25 is STRING
       button .paramDelete ''           at x 1 y 2            anchor left                 pixmap width 16 height 16
       button .paramApply 'Apply'       at x 5 ymin           anchor left                         width 5
       button .paramCreate 'New'        at x12 ymin           anchor left                 width 5
       button .paramUp ''               at x20 ymin           anchor left                 pixmap  width 16 height 16
       button .paramDn ''               at x24 ymin           anchor left                 pixmap  width 16 height 16
    exit

    line .outside at x 0 ymax.paramDelete + 2                 anchor left + right + bottom  horizontal width 94

    --===============================================          ============================================================
    --                                          SCOM, SPRF, SFIT, JOIN,
    --===============================================          ============================================================
    -- Swap out panels here.. for various outputs.
    frame .compFrame panel '' at x 0.25 ymax.outside + .2         anchor left + right + bottom
       para .refPara at x0.5 y0.25 text 'References:'
       para .dbrefno at xmax.refPara ymin text '                                                                        '
       text .compField0 ' Name' at x1 Y1.5 anchor left                              tagwidth 10      width 35 is STRING
       text .compField1 ' Description' at x1 Y2.5 anchor left                       tagwidth 10      width 35 is STRING
       combo .compField2 'Generic Type' at x1 Y3.5 anchor left                      tagwidth 10      width 25

--=============================================== STEEL ===========================================================
    if (!curApp eq 'STL' or !curApp eq 'HVAC' or !curApp eq 'EQUI' or !curApp eq 'ACCO') then
       text .compField3 ' P-Point Set' at x1  Y4.5  anchor left                     tagwidth 10      width 27 is STRING
       text .compField4 '+ve Geometry' at x49 Y1.5  anchor right+left               tagwidth 10      width 27 is STRING
       text .compField5 '    Data Set' at x49 Y2.5  anchor right+left               tagwidth 10      width 27 is STRING
       text .compField6 '-ve Geometry' at x49 Y3.5  anchor right+left               tagwidth 10      width 27 is STRING
       text .compField7 '  P-Line Set' at x49 Y4.5  anchor right+left               tagwidth 10      width 27 is STRING

       button .compAction7 ' ' at xmax.compField7 ymin.compField7 anchor right pixmap                width 1 height 1 width 16
       button .ceField7 'CE'   at xmax.compAction7 ymin.compAction7 anchor right                     width 2

--=============================================== C A B L E ===========================================================
  elseif (!curApp eq 'ELEC') then

       text .compField3 ' P-Point Set' at x50 Y1.5  anchor right+left               tagwidth 10      width 27 is STRING
       text .compField4 '+ve Geometry' at x50 Y2.5  anchor right+left               tagwidth 10      width 27 is STRING
       text .compField5 '    Data Set' at x50 Y3.5  anchor right+left               tagwidth 10      width 27 is STRING
       text .compField6 ' Cable Cores' at x50 Y2.5  anchor right+left               tagwidth 10      width 27 is STRING

--=============================================== P I P I N G ===========================================================
  else
       text .compField3 ' P-Point Set' at x50 Y1.5  anchor right+left               tagwidth 10      width 27 is STRING
       text .compField4 'Geometry Set' at x50 Y2.5  anchor right+left               tagwidth 10      width 27 is STRING
       text .compField5 '    Data Set' at x50 Y3.5  anchor right+left               tagwidth 10      width 27 is STRING
       text .compField6 '    Bolt Set' at x50 Y4.5  anchor right+left               tagwidth 10      width 27 is STRING

  endif
--=======================================================================================================================

       text .compParams 'Parameters' at x1 y5.5 anchor right + left 								tagwidth 10      width 76 is STRING

       button .compAction3 ' ' at xmax.compField3 ymin.compField3  anchor $!anchor pixmap width 1 height 1 width 16
       button .compAction4 ' ' at xmax.compField4 ymin.compField4  anchor right pixmap width 1 height 1 width 16
       button .compAction5 ' ' at xmax.compField5 ymin.compField5  anchor right pixmap width 1 height 1 width 16
       button .compAction6 ' ' at xmax.compField6 ymin.compField6  anchor right pixmap width 1 height 1 width 16


       button .ceField3 'CE'   at xmax.compAction3 ymin.compAction3 anchor $!anchor                        width 2
