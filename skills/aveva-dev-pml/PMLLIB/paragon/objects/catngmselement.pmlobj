define object CATNGMSELEMENT
----------------------------------------------------------------------

  -- List of graphical views
  member .headings       is ARRAY
  member .columns        is ARRAY
  member .rtext          is ARRAY
  member .members        is ARRAY
  member .geometryTypes  is ARRAY
  member .currentType    is STRING
  member .currentElement is DBREF

endobject
-- End of object definition for catngmselement

----------------------------------------------------------------------
define method .catngmselement()
----------------------------------------------------------------------

  !this.headings[1] = 'Name'
  !this.headings[2] = 'Type'

  !this.geometryTypes[1] = 'NSBO'
  !this.geometryTypes.append('NSCO')
  !this.geometryTypes.append('NLSN')
  !this.geometryTypes.append('NSSP')
  !this.geometryTypes.append('NLCY')
  !this.geometryTypes.append('NSCY')
  !this.geometryTypes.append('NSCT')
  !this.geometryTypes.append('NSRT')
  !this.geometryTypes.append('NSDS')
  !this.geometryTypes.append('NSSL')
  !this.geometryTypes.append('NLPY')
  !this.geometryTypes.append('NSEX')
  !this.geometryTypes.append('NSRE')

endmethod
-- End of method definition for catngmselement()
------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method

------------------------------------------------------------------------
define method .globalInstance()
------------------------------------------------------------------------

  -- Create Global Variable
  !!catngmselement = !this

endmethod

------------------------------------------------------------------------
--
-- Method:      setRefs
--
-- Description: Get the members of the current PTREF and fill out the form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method

-------------------------------------------------------------------------------------------------------
define method .setRefs(!element is DBREF, !gadget is GADGET)
-------------------------------------------------------------------------------------------------------
-- Get the members for the given ngms element and populate the form with these values.

!form         = !gadget.owner()
!this.members = !element.member
!this.rtext.clear()
!this.columns.clear()

!this.columns[1] = ARRAY()
!this.columns[2] = ARRAY()

do !i value !this.members
   !this.columns[1].append(!i.name)
   !this.columns[2].append(!i.type)
   !this.rtext.append(!i.string())
enddo

-- Populate the form with the contents recovered.
!gadget.setHeadings(!this.headings)
!gadget.setColumns (!this.columns)
!gadget.rtext     = !this.rtext

-- Now call the reference for the first in the list.
!this.setEdit(!this.rtext[1].dbref(),!gadget)
   handle (2,752)
     -- Mean we haven't any geometry, likely new element.
   endhandle

-- Set the creation List based on what we get from list.
if (!!ce.type EQ 'NGMS') then
   !form.ngmsCreate1.dtext = !!ce.list
else
   !form.ngmsCreate1.dtext = !!ce.owner.list
endif

-- Add elements to tracking list.
!form.getElement.addToTrack(!form, !this.rtext, 8)

endmethod

-------------------------------------------------------------------------------------------------------
define method .setEdit(!element is DBREF, !gadget is GADGET)
-------------------------------------------------------------------------------------------------------
-- Having the gadget get entry and set the form edit up ready for use to change things if required.

!form = !gadget.owner()
!item = !gadget.selection().dbref().type
handle (2,754)
 return
endhandle

-- Set the correct visibility for the gadgets here for negative/positive geometry.
!form.ngmsFrame.visible = TRUE
!form.ngmsApply.visible = TRUE

!form.gmseFrame.visible  = FALSE
!form.gmseApply.visible  = FALSE

-- Set the right geometry frame.
!this.setFrame(!form, !item)

-- Fill in the attributes for the appropriate frame.
!!catModelViews.setFormFields(!form, !element)

endmethod

-------------------------------------------------------------------------------------------------------------------
define method .showPlot(!form is FORM, !dummyPlot is STRING)
-------------------------------------------------------------------------------------------------------------------
-- Show Plot for geometry Type
-- Not currently implemented

return

endmethod


-------------------------------------------------------------------------------------------------------
define method .setFrame(!form is FORM, !item is STRING)
-------------------------------------------------------------------------------------------------------
-- Set Frame for geometry Type
-- Having the gadget get entry and set the form edit up ready for use to change things if required.

-- Show the right geometry definition.

do !i value !this.geometryTypes

   if (!i.eq(!item)) then
       !form.attribute(!i).visible = TRUE
       !this.showPlot(!form, !item)
       !this.currentType = !item
   else
        !form.attribute(!i).visible = FALSE
   endif
enddo

return

-- Show the right plot file in the appropriate window.

       !form.params.visible = TRUE
       !form.viewFrame.visible = TRUE
       !form.plotFrame.visible = FALSE
       !form.geomFrame.visible = FALSE
       !form.errorsFrame.visible = FALSE

if (!item.eq('PLOT')) then

   if (!form.sidePLot1.val) then
       !form.params.visible = FALSE
       !form.geomFrame.visible = TRUE
  else
       !form.viewFrame.visible = FALSE
       !form.plotFrame.visible = TRUE
       !form.geomFrame.visible = FALSE
  endif
          return

elseif (!item.eq('VIEW')) then

       !form.viewFrame.visible = TRUE

   if (!form.sidePLot1.val) then
       !form.geomFrame.visible = FALSE
  else
       !form.geomFrame.visible = TRUE
       !form.plotFrame.visible = FALSE
  endif

         return

elseif (!item.eq('RESET')) then

       !form.params.visible = TRUE
       !form.viewFrame.visible = TRUE
       !form.plotFrame.visible = FALSE
       !form.geomFrame.visible = FALSE
       !form.errorsFrame.visible = FALSE

endif

endmethod
