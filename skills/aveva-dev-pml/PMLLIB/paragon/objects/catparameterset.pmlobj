--    Type:          Object Definition
--    Group:         VCAT
--      Keyword:     VCAT
--    Module:        Paragon
--  Author:          Malcolm Barlow
--  Created:         Jul 21 2009
--
--  Description:     Manage catalogue category parameter definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addParameterData(REAL,STRING)    BOOLEAN             Add a new DATA element for parameter
--  appendParameter(STRING)          BOOLEAN             Append a new parameter
--  catParameterSet()                -                   Constructor
--  catParameterSet(DBREF)           -                   Constructor - Initialise for given component
--  deleteParameter(REAL)            BOOLEAN             Delete given parameter
--  findDataSet()                    DBREF               Find data set for component category
--  getCategoryFamily()              ARRAY               Find all components sharing the same category
--  getComponentFamily()             -                   Find all components sharing this parameter definition
--  getParameterDataRef(REAL)        DBREF               return parameter DATA DBREF
--  getParameterDefinition()         DBREF               Gather parameter definitions for this category
--  getParameterTextRef(REAL)        DBREF               return parameter TEXT DBREF
--  getParameterTitle(REAL)          STRING              return parameter title as a string
--  getParameterValue(REAL)          STRING              return parameter value as a string
--  numberOfParameters()             REAL                return number of parameters for the current component
--  setParameterTitle(REAL,STRING)   BOOLEAN             Set given parameter title
--  update()                         -                   Initialise parameters for the current component
--
----------------------------------------------------------------------
define object CATPARAMETERSET
----------------------------------------------------------------------

  -- List of default data set parameter DKEY
  member .names              is ARRAY
  -- DBREF of component used to initialise this object
  member .component          is DBREF
  -- Array (of STRING) of valid component types
  member .componentTypes     is ARRAY
  -- DBREF of category containing these parameters
  member .category           is DBREF
  -- DBREF of data set DTSE element
  member .dataSetRef         is DBREF
  -- Array of Text element DBREF for parameters (indexed by parameter number)
  -- Could be empty if there are no parameters or parameters are not defined
  -- as text elements
  member .textElements       is ARRAY
  -- Array of parameter titles (indexed by parameter number)
  member .parameterTitles    is ARRAY
  -- Array of DATA elements for parameters (indexed by parameter number)
  -- This array could be sparse if there are gaps in the parameter
  -- information in the data set. It could be empty if there are no parameters
  -- or the parameters are not defined in the dataset
  member .parameterDataReference  is ARRAY
  -- parameter data set
  member .dataSet            is CATDATASET
  -- Numeric and word (string) parameters for this component
  member .componentParam     is ARRAY
  member .componentWordParam is ARRAY
  -- array of all components found to be sharing the parameter definition of the current component
  member .componentFamily    is ARRAY
  -- maximum number of parameters in the component Family
  member .maximumParameters  is REAL

endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      .catParameterSet()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
-- Arguments:
--
------------------------------------------------------------------------
define method .catParameterSet()

  -- unset DBREF indicates that this object has not been attached to a category
  !this.category         = object DBREF()
  -- unset DBREF indicates that this object has not been attached to a DTSE
  !this.dataSetRef       = object DBREF()
  -- unset data set object for new definitions
  !this.dataSet          = object CATDATASET()
  -- clear table of parameter data
  !this.textElements     = object ARRAY()
  !this.parameterDataReference = object ARRAY()

  -- The alphabet letters needed.
  !letterArray[1]  = 'A'
  !letterArray[2]  = 'B'
  !letterArray[3]  = 'C'
  !letterArray[4]  = 'D'
  !letterArray[5]  = 'E'
  !letterArray[6]  = 'F'
  !letterArray[7]  = 'G'
  !letterArray[8]  = 'H'
  !letterArray[9]  = 'I'
  !letterArray[10] = 'J'
  !letterArray[11] = 'K'
  !letterArray[12] = 'L'
  !letterArray[13] = 'M'
  !letterArray[14] = 'N'
  !letterArray[15] = 'O'
  !letterArray[16] = 'P'
  !letterArray[17] = 'Q'
  !letterArray[18] = 'R'
  !letterArray[19] = 'S'
  !letterArray[20] = 'T'
  !letterArray[21] = 'U'
  !letterArray[22] = 'V'
  !letterArray[23] = 'W'
  !letterArray[24] = 'X'
  !letterArray[25] = 'Y'
  !letterArray[26] = 'Z'

  --Create array of 100 default parameter names for the PARAM element
  -- APAR, BPAR,CPAR,.., ZPAR
  do !i from 1 to 26
   !this.names[!i] = !letterArray[!i] & !letterArray[16] & !letterArray[1] & !letterArray[18]
  enddo
  -- AAPA, ABPA,...,ZBPA
    do !i from 27 to 52
   !this.names[!i] = !letterArray[1] & !letterArray[(!i - 26)] & !letterArray[16] & !letterArray[1]
  enddo
  -- BAPA, BBPA,...,BAPA
    do !i from 53 to 78
   !this.names[!i] = !letterArray[2] & !letterArray[(!i - 52)] & !letterArray[16] & !letterArray[1]
  enddo
  -- CAPA, CBPA,..., CZPA
  do !i from 79 to 104
   !this.names[!i] = !letterArray[3] & !letterArray[(!i - 78)] & !letterArray[16] & !letterArray[1]
  enddo

  -- initialise valid component types
  !this.componentTypes[1] = 'SCOM'
  !this.componentTypes[2] = 'SFIT'
  !this.componentTypes[3] = 'SPRF'
  !this.componentTypes[4] = 'JOIN'

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .catParameterSet()
--
-- Description: Constructor - Initialise for given component
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Component element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .catParameterSet(!element is DBREF)

  -- initialise object
  !this.catParameterSet()

  if( badref(!element) ) then
    return
  endif

  -- types of catalogue category elements
  if( !this.componentTypes.findFirst(!element.hardType).unset() ) then
    -- Wrong location in hierarchy
    return
  endif

  -- get category and data set references
  !this.component  = !element
  !this.category   = !element.owner
  -- find data set for current component or component category
  !this.dataSetRef = !this.findDataSet()

  -- get parameters for this component
  !this.update()

endmethod
-- End of method definition
-----------------------------------------------------------------------
--
-- Method:      .update()
--
-- Description: Initialise parameters for the current component
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .update()

  -- get parameters for this component
  !this.componentParam     = !this.component.param
  !this.componentWordParam = !this.component.wparam

  !this.getParameterDefinition()

endmethod
-- End of method definition

------------------------------------------------------------------------
--
-- Method:      .getParameterDefinition()
--
-- Description: Gather parameter definitions for this category
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Data set DBREF (unset if not linked to a data set element)
--
------------------------------------------------------------------------
define method .getParameterDefinition() is DBREF

  -- find category text elements
  !textCollection     = object COLLECTION()
  !textCollection.scope(!this.category)
  !textCollection.type('TEXT')
  !this.textElements  = !textCollection.results()

  -- check for PAn naming convention
  !textInOrder   = ARRAY()
  !notNamedPA    = ARRAY()
  do !text values !this.textElements
    -- sort texts into order if PA named
    !textName    = !text.namn
    !cateNamePos = !textName.match('PA')

    if (!cateNamePos gt 1) then
      ---- Name like AAEA200NN-PA1
      !param = !textName.after(|PA|)
    elseif (!cateNamePos eq 1) then
      ---- Name like PA1-AAEA200NN
      !param = !textName.after(|PA|).before(|-|)
    else
      ---- Not PA named - add to remainder list
      !notNamedPA.append(!text)
      skip
    endif
    !paramReal = !param.real()
    handle (2,441)
      -- Unable to convert string to real
      !notNamedPA.append(!text)
      skip
    endhandle
    if( undefined(!textInOrder[!paramReal] ) ) then
      -- text found for parameter !paramReal
      !textInOrder[!paramReal] = !text
    endif
  enddo

  -- concatenate PA named texts and others
  -- ASSUMPTION: If no PA named TEXT, The first n TEXT elements are assumed to be parameter definitions,
  -- and are in the correct order
  !textInOrder.appendArray(!notNamedPA)
  !this.textElements       = !textInOrder

  -- find Data Set parameters
  if( badref(!this.dataSetRef) ) then
    -- try to find a data
    !this.parameterDataReference = ARRAY()
  else
    !this.dataSet                = object CATDATASET(!this.dataSetRef)
    -- get parameters from DATA element (not necessarily complete)
    !this.parameterDataReference = !this.dataSet.getParameterData()
  endif

  -- get maximum number of parameters from all components sharing this definition
  !this.getComponentFamily()

  -- get titles from text STEXT and DATA element DTITLE
  -- favour DATA elements over TEXT elements
  !this.parameterTitles = ARRAY()
  do !paramIndex from 1 to !this.maximumParameters
    !title = ''
    if( defined(!this.parameterDataReference[!paramIndex]) ) then
      !title = !this.parameterDataReference[!paramIndex].dTitle
    endif
    if( !title.empty() ) then
      -- No title found - try TEXT element
      if( defined(!textInOrder[!paramIndex]) ) then
        !title = !textInOrder[!paramIndex].sText
      endif
    endif
    !this.parameterTitles[!paramIndex] = !title
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      .numberOfParameters()
--
-- Description: return number of parameters for the current component
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        Number of parameters
--
------------------------------------------------------------------------
define method .numberOfParameters() is REAL

  return !this.maximumParameters

endmethod

------------------------------------------------------------------------
--
-- Method:      .getParameterValue()
--
-- Description: return parameter value as a string
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Parameter number
-- Return:
--   [Data Type] [Description]
--    STRING      Parameter value
--
------------------------------------------------------------------------
define method .getParameterValue(!index is REAL) is STRING

  -- use PML 1 syntax to deal with parameter precision and word parameters
  VAR !value PARAM NUMBER $!<index> OF $!<this.component>
  handle any
    !value = object STRING()
  endhandle

  return !value

endmethod

------------------------------------------------------------------------
--
-- Method:      .getParameterDataRef()
--
-- Description: return parameter DATA DBREF
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Parameter number
-- Return:
--   [Data Type] [Description]
--    DBREF       DATA element for this parameter (unset if none)
--
------------------------------------------------------------------------
define method .getParameterDataRef(!index is REAL) is DBREF

  -- check for DATA element for this parameter
  if( defined(!this.parameterDataReference[!index]) ) then
    !value = !this.parameterDataReference[!index]
  else
    !value = object DBREF()
  endif

  return !value

endmethod

------------------------------------------------------------------------
--
-- Method:      .getParameterTextRef()
--
-- Description: return parameter TEXT DBREF
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Parameter number
-- Return:
--   [Data Type] [Description]
--    DBREF       TEXT element for this parameter (unset if none)
--
------------------------------------------------------------------------
define method .getParameterTextRef(!index is REAL) is DBREF

  -- check for DATA element for this parameter
  if( defined(!this.textElements[!index]) ) then
    !value = !this.textElements[!index]
  else
    !value = object DBREF()
  endif

  return !value

endmethod

------------------------------------------------------------------------
--
-- Method:      .getParameterTitle()
--
-- Description: return parameter title as a string
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Parameter number
-- Return:
--   [Data Type] [Description]
--    STRING      Parameter title
--
------------------------------------------------------------------------
define method .getParameterTitle(!index is REAL) is STRING

  if( defined(!this.parameterTitles[!index]) ) then
    !title = !this.parameterTitles[!index]
  else
    !title = 'Unset'
  endif

  return !title

endmethod

------------------------------------------------------------------------
--
-- Method:      .setParameterTitle()
--
-- Description: Set given parameter title
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Parameter number
--    2   R      STRING      Parameter title
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if at least one parameter definition element could be modified
--
------------------------------------------------------------------------
define method .setParameterTitle(!index is REAL, !parameterTitle is STRING) is BOOLEAN

  !modified = false
  -- check for TEXT element for this parameter
  if( defined(!this.textElements[!index]) ) then
    -- Change TEXT description if user has write access
    if( !this.textElements[!index].modAtt.sText ) then
      !this.textElements[!index].sText = !parameterTitle
      !modified = true
    endif
  endif

  -- check for DATA element for this parameter
  if( defined(!this.parameterDataReference[!index]) ) then
    -- Change DATA title if user has write access
    if( !this.parameterDataReference[!index].modAtt.dTitle ) then
      !this.parameterDataReference[!index].dTitle = !parameterTitle
      !modified = true
    endif
  endif

  return !modified

endmethod

------------------------------------------------------------------------
--
-- Method:      .deleteParameter()
--
-- Description: Delete given parameter
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Parameter number
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if parameter deleted
--
------------------------------------------------------------------------
define method .deleteParameter(!index is REAL) is BOOLEAN

  -- check that parameter definition can be modified
  if( defined(!this.textElements[!index]) ) then
    if( !this.textElements[!index].modDel.sText.not() ) then
      !!alert.error('Access denied to delete ' + !this.textElements[!index].fullName)
      return false
    endif
  endif

  -- check for DATA element for this parameter
  if( defined(!this.parameterDataReference[!index]) ) then
    if( !this.parameterDataReference[!index].modDel.number.not() ) then
      !!alert.error('Access denied to delete ' + !this.parameterDataReference[!index].fullName)
      return false
    endif
  endif

  -- get number of components sharing this parameter definition
  !numComponents  = !this.componentFamily.size()

  if( !numComponents gt 0 ) then
    if( !index eq !this.maximumParameters ) then
      -- Deleting the last parameter, so other parameters do not need to shuffle up
      !reply = !!alert.confirm('Any expressions using the deleted parameter will fail, and must be resolved by the user. ' + !numComponents.string('D0') + ' components use this parameter. Do you want to continue?')
      if( !reply eq 'NO' ) then
        return false
      endif
    else
      -- Deleting parameter that will cause other parameters to change
      !!alert.warning('This parameter cannot be removed because it may be used by expressions in ' + !numComponents.string('D0') + ' components. Parameter lists may become invalid if this parameter is removed')
      return false
    endif
  endif

  -- only enter this code if a parameter delete has been permitted

  -- abort if any one of the components cannot be changed
  do !comp values !this.componentFamily
    if( !comp.modAtt.param.not() ) then
      !!alert.error('Parameter deletion aborted: Access denied to change parameters for ' + !comp.fullName)
      return false
    endif
  enddo

  -- data access checks OK. Now remove parameters and delete
  do !comp values !this.componentFamily
    !params = !comp.param
    !wParams = !comp.wparam

    !params.remove(!index)
    !wParams.remove(!index)

    handle any
      skip
    endhandle

    !save = !!ce
    !!ce  = !comp
    if( !params.empty() ) then
      -- unset parameters
      PARAM UNSET
    else
      -- Build a string containing the normal and word parameters
      !paramString = ''
      do !paramIndex index !params
        if (!wParams[!paramIndex].empty()) then
          !paramString = !paramString + ' ' + !params[!paramIndex].string()
        else
          !paramString = !paramString + ' ' + !wParams[!paramIndex]
        endif
      enddo
      -- Set the parameters from the string
      PARAM $!paramString
    endif
    !!ce  = !save

  enddo

  -- check for TEXT element for this parameter
  if( defined(!this.textElements[!index]) ) then
    !!ce = !this.textElements[!index]
    DELETE TEXT
  endif

  -- check for DATA element for this parameter
  if( defined(!this.parameterDataReference[!index]) ) then
    !!ce = !this.parameterDataReference[!index]
    DELETE DATA
  endif

  !this.update()

endmethod

------------------------------------------------------------------------
--
-- Method:      .appendParameter()
--
-- Description: Append a new parameter
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Parameter title
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if parameter appended
--
------------------------------------------------------------------------
define method .appendParameter(!title is STRING) is BOOLEAN

  -- component parameter count
  !numParameters = !this.maximumParameters

  if( !numParameters gt 0 ) then

    -- Find correct sequence order for new parameter elements
    -- first remove non-parameter text elements
    !parameterText = !this.textElements
    !parameterText.deleteFrom(!numParameters + 1)

    -- check that parameter definition can be modified
    if( !parameterText.size() gt 0 ) then
      if( defined(!parameterText[!numParameters]) ) then
        !lastText = !parameterText[!numParameters]
      else
        !lastText = !parameterText.last()
      endif
    else
      -- text elements probably not used for this category
      !lastText = object DBREF()
    endif

    -- check for DATA element for this parameter
    if( !this.parameterDataReference.size() gt 0 ) then
      if( defined(!this.parameterDataReference[!numParameters]) ) then
        !lastData = !this.parameterDataReference[!numParameters]
      else
        !lastData = !this.parameterDataReference.last()
      endif
    else
      -- data set elements probably not used for this category
      !lastData = object DBREF()
    endif

  else

    -- no parameters defined. Create new parameter elements under their owning elements
    !lastText = !this.category
    !lastData = !this.dataSetRef

  endif

  -- data access checks OK. Now add parameter = 0
  !saveCurrent     = !!ce
  !parameterNumber = !numParameters  + 1
  do !comp values !this.componentFamily
    -- allow for gaps in the parameter list by filling with zeros
    !params = !comp.param
    -- if there is already a parameter in this field, do not change it
    skip if defined(!params[!parameterNumber])
    !nextIndex  = !params.maxIndex() + 1
    !!ce        = !comp
    do !index from !nextIndex to !parameterNumber
      PARAM NUMB $!<index> 0
      handle any
        break
      endhandle
    enddo
  enddo
  !!ce = !saveCurrent

  -- create TEXT element for this parameter
  !created   = true
  if( !lastText.set() ) then
    !!ce     = !lastText
    -- Use PA naming scheme if category is named
    if( !this.category.isNamed ) then
      !name = !this.category.name + '-PA' + !parameterNumber.string('D0')
    else
      !name = 'AUTONAME'
    endif
    !created = !!catModelViews.createNewElement('TEXT',!name)
    if( !created ) then
      !!ce.sText = !title
      handle any
        -- title not set of empty
      endhandle
      !!ce.purp  = 'PARA'
    endif
  endif

  -- Add new DATA element for this parameter
  if( !lastData.set() ) then
    !!ce     = !lastData
    !created = !this.addParameterData(!parameterNumber,!title)
  endif

  -- refresh this object
  !this.update()

  return !created

endmethod

------------------------------------------------------------------------
--
-- Method:      .addParameterData()
--
-- Description: Add a new DATA element for parameter
--              CE must be in correct position for NEW DATA
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       Parameter number
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if DATA element created
--
------------------------------------------------------------------------
define method .addParameterData(!parameterNumber is REAL,!title is STRING) is BOOLEAN

  !created        = false
  if( badref(!this.dataSetRef) ) then
    return false
  endif
  !parameterCount = !parameterNumber
  !name = !this.names[!parameterNumber]

  -- Look for a DATA element already created for this parameter
  !dataSet = object CATDATASET(!this.dataSetRef)
  !parameterArray = !dataSet.getParameterData()
  if( defined(!parameterArray[!parameterNumber]) ) then
    return true
  endif

  -- Make sure there are no duplicate DKEYS
  do
    -- Look for DATA element with the requested key
    !dataCollection = object COLLECTION()
    !dataCollection.scope(!this.dataSetRef)
    !dataCollection.type('DATA')
    !dataCollection.filter(object EXPRESSION(|DKEY eq '| + !name + |'| ))
    -- set DKEY, avoiding name clash
    if( !dataCollection.results().size() gt 0) then
      -- name already used. Increment to next name
      !parameterCount = !parameterCount + 1
      !name           = !this.names[!parameterCount]
      handle any
        !name = 'PARA'
      elsehandle none
        skip
      endhandle
    endif
    -- Create new DATA element at position for this parameter
    !created = !!catModelViews.createNewElement('DATA','AUTONAME')
    DKEY $!name
    PPROP ( PARA[$!parameterNumber ] )
    DPROP ( 0 )
    PURP PARA
    NUMB $!parameterNumber
    DTITLE |$!title|
    break
      	
  enddo

  return !created
        	
endmethod

------------------------------------------------------------------------
--
-- Method:      .getCategoryFamily()
--
-- Description: Find all components sharing the same category
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       All components in current category
--
------------------------------------------------------------------------
define method .getCategoryFamily() is ARRAY

  -- get all components in this category
  !compCollection = object COLLECTION()
  !compCollection.scope(!this.category)
  !compCollection.types(!this.componentTypes)
  !compElements   = !compCollection.results()

  return !compElements

endmethod

------------------------------------------------------------------------
--
-- Method:      .findDataSet()
--
-- Description: Find data set for component category
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF       Data set used be this category (unset if none found)
--
------------------------------------------------------------------------
define method .findDataSet() is DBREF

  !dataSet = object DBREF()

  -- if data set reference is unset on the current component, find it in the category
  if( badref(!this.component.dtRef) ) then

    -- try data set in same category
    !dataSetCollection = object COLLECTION()
    !dataSetCollection.scope(!this.category)
    !dataSetCollection.type('DTSE')
    !dataSets  = !dataSetCollection.results()
    if( !dataSets.size() gt 0 ) then
      -- assume first data set if more than one
      !dataSet = !dataSets[1]
    else
      -- no local data set - look for a shared data set
      do !comp values !this.getCategoryFamily()
        if( not badref(!comp.dtRef) ) then
          !dataSet = !comp.dtRef
          break
        endif
      enddo
    endif

  else

    -- data set reference is set
    !dataSet = !this.component.dtRef

  endif

  return !dataSet

endmethod

------------------------------------------------------------------------
--
-- Method:      .getComponentFamily()
--
-- Description: Find all components sharing this parameter definition
--
-- Method Type: Procedure
--
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getComponentFamily()

  -- Get all components that use the data set (if present)
  -- check for DATA element for this parameter
  !usedBy = ARRAY()
  if( not badref(!this.dataSetRef) ) then
    !geoDep  = !this.dataSetRef.geoDep
    -- remove anything that is not a component type element
    do !element values !geoDep
      skip if( !this.componentTypes.findFirst(!element.hardType).unset() )
      !usedBy.append(!element)
    enddo
  endif

  -- get all components using this parameter definition into a single array
  !this.componentFamily = !this.getCategoryFamily().union(!usedBy)

  -- get maximum parameter count
  !maxParameters = 0
  do !comp values !this.componentFamily
    !maxParameters = !maxParameters.max(!comp.param.size())
  enddo
  !this.maximumParameters = !maxParameters

endmethod
