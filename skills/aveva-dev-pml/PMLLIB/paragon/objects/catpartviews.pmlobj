--
--
-- Description:
-- Object for part view control
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add()                            -                   Add new partView into the system
--  add(FORM)                        -                   Add existing partView into the system
--  catPartViews()                   -                   Constructor
--  defineForm(REAL)                 FORM                Add new partView into the system
--  globalInstance()                 -                   Create global instance of object
--
------------------------------------------------------------------------

-- Define object
define object CATPARTVIEWS

  -- List of graphical views
  member .partViews         is ARRAY

  -- List Headings
  member .famListAttribs    is ARRAY
  member .famListHeadings   is ARRAY
  member .refListHeadings   is ARRAY
  member .coatingHeadings   is ARRAY

  -- Create options
  member .createLabels      is ARRAY
  member .createOpts        is ARRAY

  -- Attribute settings
  member .partAttributes    is ARRAY
  member .symAttributes     is ARRAY
  member .surfAttributes    is ARRAY

  -- References settings
  member .refLabels         is ARRAY
  member .refAttributes     is ARRAY
  member .refTypes          is ARRAY
  member .refDBTypes        is ARRAY

  -- View direction
  member .viewDirection     is ARRAY

endobject
-- End of object definition for catPartViews

------------------------------------------------------------------------
--
-- Method:      catPartViews
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .catPartViews()

  -- Set part family list attributes
  !this.famListAttribs[1] = |Name|
  !this.famListAttribs[2] = |Pritype|
  !this.famListAttribs[3] = |Sectype|
  !this.famListAttribs[4] = |Description|

  -- Set part family list headings
  !this.famListHeadings[1] = |Name|
  !this.famListHeadings[2] = |Type|
  !this.famListHeadings[3] = |Subtype|
  !this.famListHeadings[4] = |Description|

  -- Set create labels
  !this.createLabels[1] = |New Part|
  !this.createLabels[2] = |Copies of Selected Parts|
  !this.createLabels[3] = |Parts from Category|
  !this.createLabels[4] = |Parts from Template Area|

  -- Set create options
  !this.createOpts[1] = |NEW|
  !this.createOpts[2] = |COPY|
  !this.createOpts[3] = |CATE|
  !this.createOpts[4] = |TMAR|

  -- Set part attributes
  !this.partAttributes[1] = |Name|
  !this.partAttributes[2] = |Pritype|
  !this.partAttributes[3] = |Sectype|
  !this.partAttributes[4] = |Description|
  !this.partAttributes[5] = |Comment|
  !this.partAttributes[6] = |Purpose|
  !this.partAttributes[7] = |Lselec|

  -- Set marine diagram symbol attributes
  !this.symAttributes[1] = |SymGroup|
  !this.symAttributes[2] = |SymName|

  -- Set surface treatment attributes
  !this.surfAttributes[1] = |Pucd|
  !this.surfAttributes[2] = |Stcd|

  -- Set reference list headings
  !this.refListHeadings[1] = |Reference|

  -- Set reference headings
  do !i to 7
    !this.refLabels[!i] = ARRAY()
  enddo
  !this.refLabels[1][1] = |3D Model|
  !this.refLabels[2][1] = |3D Template|
  !this.refLabels[3][1] = |2D Symbols|
  !this.refLabels[4][1] = |Iso Description|
  !this.refLabels[5][1] = |Iso Material|
  !this.refLabels[6][1] = |Bolts|
  !this.refLabels[7][1] = |Weight|
  !this.refLabels[8][1] = |Surface Treatment|
  !this.refLabels[9][1] = |Pipe Data Table|

  -- Set reference attributes
  !this.refAttributes[1] = |Catref|
  !this.refAttributes[2] = |Tmpref|
  !this.refAttributes[3] = |Drssref|
  !this.refAttributes[4] = |Detref|
  !this.refAttributes[5] = |Matxt|
  !this.refAttributes[6] = |Bltref|
  !this.refAttributes[7] = |Cmpref|
  !this.refAttributes[8] = |Srftref|
  !this.refAttributes[9] = |Pdaref|

  -- Set reference types
  !this.refTypes[1] = |SCOM SPRF SFIT JOIN|
  !this.refTypes[2] = |TMPL|
  !this.refTypes[3] = |DRSSET|
  !this.refTypes[4] = |SDTE|
  !this.refTypes[5] = |SMTE|
  !this.refTypes[6] = |SBOL MBOL|
  !this.refTypes[7] = |CMPD TUBD CABD|
  !this.refTypes[8] = |SRFTRT|
  !this.refTypes[9] = |PDATAB WTHTAB|
  !this.refTypes[10] = |CTSTRA CTRISE CTBEND CTTEE CTCROS CTREDU|

  -- Set reference db types
  !this.refDBTypes[1] = |CATA|
  !this.refDBTypes[2] = |DESI|
  !this.refDBTypes[3] = |CATA|
  !this.refDBTypes[4] = |CATA|
  !this.refDBTypes[5] = |CATA|
  !this.refDBTypes[6] = |CATA|
  !this.refDBTypes[7] = |PROP|
  !this.refDBTypes[8] = |CATA|
  !this.refDBTypes[9] = |CATA|

  -- Set coating list headings
  !this.coatingHeadings[1] = |Coating|
  !this.coatingHeadings[2] = |Thickness|

  -- View direction Iso 2
  !direction = object DIRECTION(|N 45 W 35.264 D|)
  !this.viewDirection[1] = !direction.east
  !this.viewDirection[2] = !direction.north
  !this.viewDirection[3] = !direction.up

endmethod
-- End of method definition for .catPartViews()

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  -- Create Global Variable
  !!catPartViews = !this

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add existing partView into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .add(!form is FORM)
  -- Add form to system
  !this.partViews.append(!form)

  -- Add to view system (this shows the form)
  !!gphViews.add(!form.view)

  -- Attach drawlist to view (must be after form is shown)
  if (!form.localDrawlists) then
    !form.drawlist = !!gphDrawlists.createDrawlist()
    !!gphDrawlists.attachView(!form.drawlist, !form.view)
  endif

  -- Display part (must be done after drawlist attach)
  !this.showPart(!form)

  -- Update control form if it exists and is shown
  if (defined(!!catControl)) then
    if (!!catControl.shown()) then
      !!catControl.initialise()
    endif
  endif

  -- Show form
  --!form.show('AT', 0, 0)

endmethod
-- End of method definition for .add(FORM)

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add new partView into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .add()

  if (!!appCntrl.currentApp eq 'ELEC') then
     !this.refTypes[7] = |CABD CMPD|
     !this.refLabels[7][1] = |Physical Properties|
  else
     !this.refTypes[7] = |CMPD TUBD|
     !this.refLabels[7][1] = |Weight|

  endif


  -- Create new form and add to system
  !this.add(!this.defineForm(!this.nextAvailable()))
endmethod
-- End of method definition for .add(FORM)

------------------------------------------------------------------------
--
-- Method:      defineForm
--
-- Description: Add new partView into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Form number
-- Return:
--   [Data Type] [Description]
--    FORM        Form created
--
------------------------------------------------------------------------

-- Define method
define method .defineForm(!number is REAL) is FORM

  -- Import controls
  import 'PMLDBSearch'
  handle any
  endhandle
  import 'GridControl'
  handle any
  endhandle

  -- Form definition
  !formName   = |!!catPartEdit| & !number
  setup form $!formName dialog docking noalign

    $!<formName>.formTitle     = |Edit Part | & !number
    $!<formName>.iconTitle     = |Part|
    $!<formName>.formRevision  = | $Revision: 1.00 $ |

    -- Define namespaces
    using namespace 'Aveva.Pdms.Presentation'
    using namespace 'Aveva.Pdms.Presentation.PMLDBSearchCtrl'

    -- Fix the width before slider bar appears.
       frame .fixwidth panel at x0 y0 width 80 height 0.01
       exit

    -- Top buttons
      button .partCE |CE| at x0 y0
      option .recentParts at xmax+1 ymin width 23
      button .representation  |Representation...| at xmax+1 ymin width 12

    -- Part family
    frame .partFamily panel anchor all at xmin form ymax.partCE+0.25 width 80 height 18
      container .conTable nobox PmlNetControl 'Table' anchor all at xmin.partCE ymax.partCE width 79 height 17
      button .selectAll  linklabel anchor bottom + right width 6 |Select All|  at xmax-20 ymax.conTable+0.25
      button .selectNone  linklabel anchor bottom + right width 9 |Clear Selection|
    exit

    -- Tasks frame
    frame .tasksFrame panel anchor bottom+left+right at xmin.partFamily ymax width 80 height 12
      frame .partTasks |Tasks| anchor all
        para  .paPropList at xmin+2 ymin+1 text |View and Edit Properties| width 20
        line .lnPropList at xmin ymax-0.2 horizontal width 20 height 1
        button .attributes |General Attributes| linklabel at xmin ymax width 20
        button .references |References|         linklabel at xmin ymax width 20
        para .blank1                                      at xmin ymax text '' width 20
        button .nav3d |Navigate to 3D Model|      linklabel at xmin ymax width 20
        button .navgp |Navigate to Selected Part| linklabel at xmin ymax width 20
        para .blank2                                      at xmin ymax text '' width 20
        button .mod3d |Modify 3D Model|         linklabel at xmin ymax width 20
        para  .paPartList at xmax.paPropList+10 ymin.paPropList text |Create and Delete Parts| width 20
        line .lnPartList at xmin ymax-0.2 horizontal width 20 height 1
        button .crNewPart   |Create a New Part|               linklabel at xmin ymax width 20
        button .crCopyPart  |Create Copies of Selected Parts| linklabel at xmin ymax width 20
        button .crCatePart  |Create Parts from Category|      linklabel at xmin ymax width 20
        button .crTmplPart  |Create Parts from Template Area| linklabel at xmin ymax width 20
        line .lnDelPart at xmin ymax horizontal width 20 height 1
        button .deleteParts |Delete Selected Parts|           linklabel at xmin ymax width 20
        button .close       |Close| at xmin.selectNone+5 ymax+2.5 width 5 anchor right+bottom cancel
      exit
    exit

    -- Part attributes
    frame .partAttributesFrame panel anchor bottom+left at xmin.tasksFrame ymin.tasksFrame
      frame .partAttribs |Tasks > General Attributes| anchor all
        text .name        |Name|                         tagwidth 8 width 24 string
        text .pritype     |Type|        at xmin ymax+0.2 tagwidth 8 width 6 string
        text .sectype     |Subtype|     at xmax+3 ymin   tagwidth 8 width 6 string
        text .description |Description| at xmin.name ymax+0.2 tagwidth 8 width 24 string
        text .comment     |Comment|     at xmin ymax+0.2 tagwidth 8 width 24 string
        text .purpose     |Purpose|     at xmin ymax+0.2 tagwidth 8 width 4 string
        toggle .lselec | Allow Reference from Design| at xmin.purpose+1 ymax+0.2 tagwidth 18 states |false| |true|
        para   .lvaries at xmax ymin+0.2 width 12 lines 1
        button .partAttribsApply |Apply Changes| at xmin.purpose+8 ymax+1 width 10
        button .allPartAttribs   |Edit All Attributes...| at xmax+1 ymin width 12
      exit
      button .backAttribs |Back to Tasks| linklabel at xmin ymax+1.4 width 10
    exit

    -- Part references
    frame .partRefsFrame panel anchor bottom+left at xmin.tasksFrame ymin.tasksFrame
      frame .partRefs |Tasks > References| anchor all
        list .partRefList width 12 height 10
        para   .refTag    at xmax+1 ymin+1 width 6 lines 1
        button .refSearch pixmap at xmax+4 ymin width 16 height 16
        button .refCE     |CE|   at xmax+1 ymin width 2
        text   .refVal    at xmin.refTag ymax+0.2 width 16 string
        button .partRefsApply |Apply Change| at xmax-size ymax+0.2 width 10
        button .editRef  |Edit Reference...| at xmax-size ymax.partRefList-1 width 16
      exit
      button .backRefs |Back to Tasks| linklabel at xmin ymax+2.5 width 10
    exit

    -- Part search
    frame .partSearchFrame panel anchor bottom+left+right at xmin.tasksFrame ymin.tasksFrame
      frame .partSearch |Search| anchor all
        container .conSearch nobox PmlNetControl |Search| anchor all            width 70 height 10
        button .backToRefs |Back| linklabel anchor top+right at xmax+1 ymin+0.3 width 4
        button .useResults |Use|  anchor top+right at xmin ymax.conSearch-1.6   width 4
      exit
    exit

    -- 3D View
    frame .partViewFrame panel anchor left+right+bottom at xmax.partAttributesFrame ymin.tasksFrame-0.5
      view .view volume width 40 height 12
      exit
    exit

    -- Symbols View
    frame .symbolFrame panel anchor left+bottom at xmax.partAttributesFrame ymin.tasksFrame
      frame .marineSymbols |Marine Diagram Symbols|
        text .symGroup |Symbol Group|                  tagwidth 10 width 27 string
        text .symName  |Symbol Name|  at xmin ymax+0.2 tagwidth 10 width 27 string
        button .partSymApply |Apply Changes| at xmax-size ymax+0.2 width 10
      exit
      frame .symbolAttribs |Draft Symbol Set| at xmin ymax+0.2
        list .drsylkList width 36 length 4
        text .template |Template|    at xmin ymax+0.2 tagwidth 10 width 27 string
        text .criteria |Criteria|    at xmin ymax+0.2 tagwidth 10 width 27 string
      exit
    exit

    -- Detail text
    frame .detailFrame panel anchor left+bottom at xmax.partAttributesFrame ymin.tasksFrame
      frame .detailAttribs |Iso Description| anchor all
        text .skey  |Skey|                   tagwidth 5 width 4 string
        text .rtext |Rtext| at xmin ymax+0.2 tagwidth 5 width 32 string
        text .stext |Stext| at xmin ymax+0.2 tagwidth 5 width 32 string
        text .ttext |Ttext| at xmin ymax+0.2 tagwidth 5 width 32 string
        para .dpara at xmin ymax+1.03                   width 2 lines 1
      exit
    exit

    -- Material text
    frame .materialFrame panel anchor left+bottom at xmax.partAttributesFrame ymin.tasksFrame
      frame .materialAttribs |Iso Material| anchor all
        text .xtext |Xtext|                  tagwidth 5 width 32 string
        text .ytext |Ytext| at xmin ymax+0.2 tagwidth 5 width 32 string
        text .ztext |Ztext| at xmin ymax+0.2 tagwidth 5 width 32 string
        para .mpara at xmin ymax+2.15                   width 2 lines 1
      exit
    exit

    -- Weight
    frame .weightFrame panel anchor left+bottom at xmax.partAttributesFrame ymin.tasksFrame
      frame .weightAttribs |Weight| anchor all
        text .weight |Weight| tagwidth 7 width 30 string
        para .wpara at xmin ymax+4.38    width 2 lines 1
      exit
    exit

    -- Bolts
    frame .boltsFrame panel anchor left+bottom at xmax.partAttributesFrame ymin.tasksFrame
      frame .boltsAttribs |Bolt Set| anchor all
        list .sboltList width 36 length 4
        text .blist     |Bolt List|  at xmin ymax+0.2 tagwidth 10 width 27 string
        text .bdiameter |Diameter|   at xmin ymax+0.2 tagwidth 10 width 27 string
        text .blength   |Length|     at xmin ymax+0.2 tagwidth 10 width 27 is REAL FORMAT !!distanceFmt
        text .noff      |Number Off| at xmin ymax+0.2 tagwidth 10 width 27 is REAL FORMAT !!integerFmt
      exit
    exit

    -- Surface treatment
    frame .surfFrame panel anchor left+bottom at xmax.partAttributesFrame ymin.tasksFrame
      frame .surfAttribs |Surface Treatment Codes|
        text .pucd    |Punch Code|  tagwidth 16 width 6 string
        text .stcd    |Surface Treatment Code| at xmin ymax+0.2 tagwidth 16 width 6 string
        button .surfApply |Apply Changes|      at xmax+4 ymin               width 10
      exit
      frame .surfRefs |Surface Treatment Details|  at xmin ymax+0.2
        text .surmat  |Surface Material|    tagwidth 16                     width 21 string
        text .surprep |Surface Preparation| at xmin ymax+0.2    tagwidth 16 width 21 string
        toggle .shoppri | Shop Primer|      at xmin+16 ymax+0.2 tagwidth 16 states |false| |true|
        list .coatingList                   at xmin.surmat ymax+0.2 width 36 length 4
      exit
    exit

    -- Part family being worked on
    member .prtele          is DBREF

    -- Currently selected parts
    member .parts           is ARRAY

    -- Reference panel element
    member .refElement      is DBREF

    -- Drawlist for this view
    member .drawlist        is REAL

    -- Current item displayed in view
    member .viewedElement   is DBREF

    -- Draft Symbol Set Links
    member .drsylks         is ARRAY

    -- Sbolts
    member .sbolts          is ARRAY

    -- Search control members
    member .searchControl   is PMLDBSEARCHCTRL
    member .searchObj       is SEARCHDEFN
    member .searchAttribute is STRING
    member .searchDBType    is STRING
    member .searchTypeUser  is STRING
    member .searchType      is STRING
    member .searchTypes     is STRING
    member .searchResults   is ARRAY
    member .searchReturn    is STRING

    -- .net events object
    member .eventClick      is EVENTCLICK

    -- Grid controls
    member .netTable        is NETGRIDCONTROL

    -- Edits flags
    member .touched         is BOOLEAN
    member .subTouched      is BOOLEAN
    member .partRefListVal  is REAL

    -- "Clipboard" elements
    member .clipboard       is ARRAY

    -- Global or local drawlist
    member .localDrawlists  is BOOLEAN

  exit

  -- Pseudo form constructor (note that must use full object name below as !this is the form here)
  !form = $!formName

  -- Form callbacks
  !form.callback                    = |!!catPartViews.init(|          & !formName & |)|
  !form.cancelCall                  = |!!catPartViews.close(|         & !formName & |)|

  -- Part family panel callbacks
  !form.selectAll.callback          = |!!catPartViews.selectPart(|
  !form.selectNone.callback         = |!!catPartViews.selectPart(|
  !form.partCE.callback             = |!!catPartViews.partCE(|        & !formName & |)|
  !form.recentParts.callback        = |!!catPartViews.recentParts(|
  !form.representation.callback     = |!!catPartViews.representation(| & !formName & |)|
  !form.navgp.callback              = |!!catPartViews.tablePopup(| & !formName & |.navgp, 'NAV2THISPART')|
  !form.nav3d.callback              = |!!catPartViews.tablePopup(| & !formName & |.nav3d, 'NAV23DMODEL')|
  !form.mod3d.callback              = |!!catPartViews.tablePopup(| & !formName & |.nav3d, 'EDIT3DMODEL')|

  -- Task panel callbacks
  !form.attributes.callback        = |!!catPartViews.showAttributes(| & !formName & |)|
  !form.references.callback        = |!!catPartViews.showReferences(| & !formName & |)|
  !form.crNewPart.callback         = |!!catPartViews.createParts(|
  !form.crCopyPart.callback        = |!!catPartViews.createParts(|
  !form.crCatePart.callback        = |!!catPartViews.createParts(|
  !form.crTmplPart.callback        = |!!catPartViews.createParts(|
  !form.deleteParts.callback       = |!!catPartViews.deleteParts(|    & !formName & |)|

  -- Attribute panel callbacks
  !form.name.callback              = |!!catPartViews.setAttribute(|
  !form.pritype.callback           = |!!catPartViews.setAttribute(|
  !form.sectype.callback           = |!!catPartViews.setAttribute(|
  !form.description.callback       = |!!catPartViews.setAttribute(|
  !form.comment.callback           = |!!catPartViews.setAttribute(|
  !form.purpose.callback           = |!!catPartViews.setAttribute(|
  !form.lselec.callback            = |!!catPartViews.setAttribute(|
  !form.partAttribsApply.callback  = |!!catPartViews.setAttribute(|
  !form.allPartAttribs.callback    = |!!catPartViews.modifyAttribs(|
  !form.backAttribs.callback       = |!!catPartViews.showTasks(|      & !formName & |)|

  -- Reference panel callbacks
  !form.partRefList.callback       = |!!catPartViews.partRefList(|    & !formName & |)|
  !form.refVal.callback            = |!!catPartViews.setReference(|
  !form.refSearch.callback         = |!!catPartViews.showSearch(|
  !form.refCE.callback             = |!!catPartViews.setReference(|
  !form.partRefsApply.callback     = |!!catPartViews.setReference(|
  !form.editRef.callback           = |!!catPartViews.editRef(|        & !formName & |)|
  !form.symGroup.callback          = |!!catPartViews.setMDSymAtts(|
  !form.symName.callback           = |!!catPartViews.setMDSymAtts(|
  !form.partSymApply.callback      = |!!catPartViews.setMDSymAtts(|
  !form.pucd.callback              = |!!catPartViews.setSurfAtts(|
  !form.stcd.callback              = |!!catPartViews.setSurfAtts(|
  !form.surfApply.callback         = |!!catPartViews.setSurfAtts(|
  !form.drsylkList.callback        = |!!catPartViews.drsylkList(|     & !formName & |)|
  !form.sboltList.callback         = |!!catPartViews.sboltList(|      & !formName & |)|
  !form.backRefs.callback          = |!!catPartViews.showTasks(|      & !formName & |)|

  -- Search panel callbacks
  !form.useResults.callback        = |!!catPartViews.useResults(|
  !form.backToRefs.callback        = |!!catPartViews.useResults(|

  -- Search icons
  !searchIcon = !!pml.getpathname('ng_zoomtoselection.png')
  !form.refSearch.addpixmap(!searchIcon)

  -- .net events object
  !form.eventClick    = object EVENTCLICK(!form)

  -- Create instance of search control
  !form.searchControl = object PMLDBSEARCHCTRL()
  !form.searchControl.addEventHandler('ResultsSelectedEvent', !form.eventClick, 'partResultsSelected')
  !form.conSearch.control = !form.searchControl.handle()

  -- List headings, rows and rtext
  !form.partRefList.setHeadings(!!catPartViews.refListHeadings)
  !form.partRefList.setRows(!!catPartViews.refLabels)
  !form.partRefList.rtext = !!catPartViews.refAttributes
  !form.coatingList.setHeadings(!!catPartViews.coatingHeadings)

  -- View settings
  !form.view.direction   = !!catPartViews.viewDirection
  !form.view.borders     = false
  !form.view.shaded      = true
  !form.view.background  = !!cDCACCOL[2]

  -- View menus
  !form.newMenu('lviewPopup')
  !form.newMenu('lmouseMenu')
  !form.newMenu('llookMenu')
  !form.newMenu('lisoMenu')
  !form.newMenu('llimitsMenu')
  !form.newMenu('lrotateMenu')
  !form.newMenu('lsettingsMenu')

  !form.lviewPopup.add('menu', 'View Control', 'lmouseMenu')
  !form.lviewPopup.add('separator')
  !form.lviewPopup.add('menu', 'Look',         'llookMenu')
  !form.lviewPopup.add('menu', 'Iso',          'lisoMenu')
  !form.lviewPopup.add('menu', 'Limits',       'llimitsMenu')
  !form.lviewPopup.add('separator')
  !form.lviewPopup.add('menu', 'Settings',     'lsettingsMenu')

  -- The exact spacings in the texts for these menu entries must be maintained
  !form.lmouseMenu.add('callback', 'Zoom  F2',    '!!gphViews.doMenuAction(')
  !form.lmouseMenu.add('callback', 'Pan  F3',     '!!gphViews.doMenuAction(')
  !form.lmouseMenu.add('callback', 'Rotate  F5',  '!!gphViews.doMenuAction(')
  !form.lmouseMenu.add('callback', 'Walk  F6',    '!!gphViews.doMenuAction(')

  !form.llookMenu.add('callback', ' Z',          '!!gphViews.look(')
  !form.llookMenu.add('callback', '-Z',          '!!gphViews.look(')
  !form.llookMenu.add('callback', ' Y',          '!!gphViews.look(')
  !form.llookMenu.add('callback', '-Y',          '!!gphViews.look(')
  !form.llookMenu.add('callback', ' X',          '!!gphViews.look(')
  !form.llookMenu.add('callback', '-X',          '!!gphViews.look(')
  !form.llookMenu.add('separator')
  !form.llookMenu.add('CALLBACK', 'Explicit...', '!!gphViews.lookExplicit(')

  !form.lisoMenu.add('callback', 'One',          '!!gphViews.isometric(')
  !form.lisoMenu.add('callback', 'Two',          '!!gphViews.isometric(')
  !form.lisoMenu.add('callback', 'Three',        '!!gphViews.isometric(')
  !form.lisoMenu.add('callback', 'Four',         '!!gphViews.isometric(')

  !form.llimitsMenu.add('callback', 'Model',     '!!catPartViews.limits(' & !formName & ')')
  !form.llimitsMenu.add('separator')
  !form.llimitsMenu.add('callback', 'Increase',  '!!catPartViews.limitsIncrease(' & !formName & ')')
  !form.llimitsMenu.add('callback', 'Decrease',  '!!catPartViews.limitsDecrease(' & !formName & ')')

  -- The exact spacings in the texts for these menu entries must be maintained
  !form.lsettingsMenu.callback = '!!gphViews.graphicsToggles('
  !form.lsettingsMenu.add('toggle', 'Eye  F7',          '!!gphViews.doMenuAction(')
  !form.lsettingsMenu.add('toggle', 'Shaded  F8',       '!!gphViews.doMenuAction(')
  !form.lsettingsMenu.add('toggle', 'Borders  F9',      '!!gphViews.doMenuAction(')
  !form.lsettingsMenu.add('toggle', 'Perspective  F4',  '!!gphViews.doMenuAction(')
  !form.lsettingsMenu.add('separator')
  !form.lsettingsMenu.add('callback', 'Background...',  '!!gphViews.colour(')

  !form.view.setPopup(!form.lviewPopup)

  -- Define popup menu for .conTable
  !menu = !form.newMenu('puTable', 'POPUP')
  !menu.add('MENU', 'Navigate', 'puNavigateList', 'NAVIGATE')
  !menu.add('MENU', 'Edit', 'puEditList', 'EDIT')
  !menu.add('SEPARATOR','Sep1' )
  !menu.add('CALLBACK', 'Copy', '!!catPartViews.tablePopup(', 'COPY')
  !menu.add('CALLBACK', 'Paste', '!!catPartViews.tablePopup(', 'PASTE')
  !menu = !form.newMenu('puNavigateList', 'POPUP')
  !menu.add('CALLBACK', 'Selected Part', '!!catPartViews.tablePopup(', 'THISPART')
  do !i indices !!catPartViews.refAttributes
    !menu.add('CALLBACK', !!catPartViews.refLabels[!i][1], '!!catPartViews.tablePopup(', !!catPartViews.refAttributes[!i])
  enddo
  !menu = !form.newMenu('puEditList', 'POPUP')
  !menu.add('CALLBACK', !!catPartViews.refLabels[1][1], '!!catPartViews.tablePopup(', 'EDITCATE')

  -- Add instances of .net table control
  !form.netTable = object NETGRIDCONTROL()
  -- Add event handlers to grid control
  !form.netTable.addEventHandler('OnPopup', !form.eventClick, 'partRightClick')
  !form.netTable.addEventHandler('AfterSelectChange', !form.eventClick, 'partAfterSelect')
  -- Set grid properties
  !form.netTable.fixedHeaders(false)
  !form.netTable.outlookGroupStyle(false)
  !form.netTable.columnExcelFilter(true)
  !form.netTable.headerSort(true)
  !form.netTable.columnSummaries(false)
  !form.netTable.singleRowSelection(false)
  !form.netTable.setAlternateRowColor('WHITE')
  -- Add grid control to .net container
  !form.conTable.control  = !form.netTable.handle()
  -- Add popup to .net container
  !form.conTable.popup = !form.puTable

  -- Reference panel read only gadgets (make inactive as more intuitive than not editable)
  !form.template.active  = false
  !form.criteria.active  = false
  !form.skey.active      = false
  !form.rtext.active     = false
  !form.stext.active     = false
  !form.ttext.active     = false
  !form.xtext.active     = false
  !form.ytext.active     = false
  !form.ztext.active     = false
  !form.blist.active     = false
  !form.bdiameter.active = false
  !form.blength.active   = false
  !form.noff.active       = false
  !form.weight.active     = false
  !form.surmat.active      = false
  !form.surprep.active     = false
  !form.shoppri.active     = false
  !form.coatingList.active = false

  !form.refCE.settooltip(|Use CE|)
  !form.refSearch.settooltip(|Search Panel for Reference Data.|)

  -- Multiple draw lists flag
  !form.localDrawlists = true

  -- Search Tool Settings.
  !form.searchTypeUser = ''

  return !form

endmethod
-- End of method definition for .defineForm(REAL) is FORM

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialise method for the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .init(!form is FORM)

  -- Initialise
  !form.prtele = object DBREF()
  !form.parts  = ARRAY()
  !form.clipboard  = ARRAY()
  !form.touched    = false
  !form.subTouched = false
  !form.partRefListVal = 1

  -- Get to appropriate level
  if (!!ce.type eq |GPDATA|) then
    if (!!ce.owner.type eq |GPART|) then
      GPART
    endif
  endif

  -- Only show form if a part family has been found
  if (!!ce.type eq |GPART|) then

    -- At a part
    !form.parts[1] = !!ce
    !form.prtele   = !!ce.owner

  elseif (!!ce.type eq |PRTELE|) then

    -- At a prtele so check if it is a part family (has parts and not prtele members)
    !foundGpart  = false
    !foundPrtele = false
    do !member values !!ce.members
      if (!member.type eq |GPART|) then
        !foundGpart  = true
      elseif (!member.type eq |PRTELE|) then
        !foundPrtele = true
      endif
    enddo
    if (!foundGpart or !foundPrtele.not()) then
      !form.prtele = !!ce
      !form.parts  = ARRAY()
    else
       PRTELE 1
       handle any
           return error 1 |1 Current element is not a GPART or part family PRTELE|
       elsehandle none
           !this.init(!form)
       endhandle
    endif

  else
    -- None found, try the first PRTELE
    PRTELE 1
    handle any
        return error 1 |2 Current element is not a GPART or part family PRTELE|
    elsehandle none
        !this.init(!form)
    endhandle
  endif
  -- Must return from this method before showPart(FORM) is called from add(FORM)

endmethod
-- End of method definition for .init(FORM)

------------------------------------------------------------------------
--
-- Method:      showPart
--
-- Description: Display part
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showPart(!form is FORM)

  -- Display part
  !form.formTitle = |Part Family: | & !form.prtele.name
  !form.helpcontextid     = 'HID_CATPARTEDIT'
  !!catRecentObjects.add(!form.prtele)
  !this.updateRecentParts(!form)

  -- Initialise panels
  !this.showPartFamily(!form)
  !this.showTasks(!form)

  -- Activate gadgets
  !this.activate(!form)

endmethod
-- End of method definition for .showPart(FORM)

------------------------------------------------------------------------
--
-- Method:      clearView
--
-- Description: Clear 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .clearView(!form is FORM)

  -- Clear drawlist
  if (!form.localDrawlists) then
    !drawlist = !!gphDrawlists.drawlist(!form.drawlist)
    !drawlist.removeAll()
  else
    remove all
  endif
  !form.viewedElement = object DBREF()

endmethod
-- End of method definition for .clearView(FORM)

------------------------------------------------------------------------
--
-- Method:      viewPart
--
-- Description: Display part in 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .viewPart(!form is FORM)

  -- Check for valid template or scom
  !viewRef = object DBREF()
  if (!form.parts.size() eq 1) then
    if (!form.parts[1].set()) then
      if (!form.parts[1].badref().not()) then
        if (!form.parts[1].tmpref.set()) then
          if (!form.parts[1].tmpref.badref().not()) then
            !viewRef = !form.parts[1].tmpref
          endif
        elseif (!form.parts[1].catref.set()) then
          if (!form.parts[1].catref.badref().not()) then
            !viewRef = !form.parts[1].catref
          endif
        endif
      endif
    endif
  endif

  -- Display if valid element found
  if (!viewRef.set()) then
    !this.viewElement(!form, !viewRef)
  else
    !this.clearView(!form)
  endif

endmethod
-- End of method definition for .viewPart(FORM)

------------------------------------------------------------------------
--
-- Method:      viewElement
--
-- Description: Display element in 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
--    2   R      DBREF       Element (template or scom)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .viewElement(!form is FORM, !element is DBREF)

  -- Display if required element is not already displayed and is valid
  if (!form.viewedElement ne !element) then
    !this.clearView(!form)
    if (!element.set()) then
      if (!element.badref().not()) then
        !form.viewedElement = !element

        -- Set limits
        !this.limits(!form)

        -- Set model parameters
        if (!element.type ne |TMPL|) then
          !!catSetModelParams(!element)
        endif

        -- Add to drawlist
        if (!form.localDrawlists) then
          !drawlist = !!gphDrawlists.drawlist(!form.drawlist)
          !drawlist.add(!element)
        else
          add $!element
        endif

      endif
    endif
  endif

endmethod
-- End of method definition for .viewElement(FORM, DBREF)

------------------------------------------------------------------------
--
-- Method:      limits
--
-- Description: Set view limits to element volume
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .limits(!form is FORM)

  -- Set limits
  if (!form.viewedElement.set()) then
    if (!form.viewedElement.badref().not()) then
      !!gphViews.limits(!form.view, !form.viewedElement)
    endif
  endif

endmethod
-- End of method definition for .limits(FORM)

------------------------------------------------------------------------
--
-- Method:      limitsIncrease
--
-- Description: Increase view limits
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .limitsIncrease(!form is FORM)

  -- Increase limits
  !limits = !form.view.limits
  do !i to 5 by 2
    !limits[!i]     = !limits[!i]     - 500mm
    !limits[!i + 1] = !limits[!i + 1] + 500mm
  enddo
  !form.view.limits = !limits

endmethod
-- End of method definition for .limitsIncrease(FORM)

------------------------------------------------------------------------
--
-- Method:      limitsDecrease
--
-- Description: Decrease view limits
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .limitsDecrease(!form is FORM)

  -- Decrease limits
  !limits = !form.view.limits
  do !i to 5 by 2
    if ((!limits[!i + 1] - !limits[!i]) gt 1000mm) then
      !limits[!i]     = !limits[!i]     + 500mm
      !limits[!i + 1] = !limits[!i + 1] - 500mm
    endif
  enddo
  !form.view.limits = !limits

endmethod
-- End of method definition for .limitsDecrease(FORM)

------------------------------------------------------------------------
--
-- Method:      representation
--
-- Description: Decrease view limits
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .representation(!form is FORM)

  -- Representation form
  if(undefined(!!gphDrawlistRep)) then
    pml load form !!gphDrawlistRep
  endif
  !!gphDrawlistRep.setup(!form.view)
  show !!gphDrawlistRep

endmethod
-- End of method definition for .representation(FORM)

------------------------------------------------------------------------
--
-- Method:      checkBadParts
--
-- Description: Check for deleted parts in selection
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .checkBadParts(!form is FORM)

  -- Check for deleted parts
  if (!form.prtele.badref()) then
    return error 1 |Selected part family is no longer available|
  endif
  do !part values !form.parts
    if (!part.badref()) then
      !this.clearView(!form)
      return error 1 |A part in the selection is no longer available|
    endif
  enddo

endmethod
-- End of method definition for .checkBadParts(FORM)

------------------------------------------------------------------------
--
-- Method:      showPartFamily
--
-- Description: Show part family panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showPartFamily(!form is FORM)

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Store currently selected parts as this will be cleared by the grid events when grid is cleared
  !selectedParts = !form.parts

  -- Clear grid ready for repopulating
  !form.netTable.clearGrid()

  -- Total indicator
  !specTi = 'Part Family'

  -- Repopulate part family
  !itemList = ARRAY()
  if (!form.prtele.set()) then
    if (!form.prtele.badref().not()) then
      do !element values !form.prtele.members
        if (!element.type eq |GPART|) then
          !itemList.append(!element.name)
        endif
      enddo
    endif
  endif

  -- Bind to data source
  !ndsTable = object NETDATASOURCE(!specTi, !this.famListAttribs, !this.famListHeadings, !itemList)
  !form.netTable.bindToDataSource(!ndsTable)

  -- Select currently selected parts
  if (!itemList.size() gt 0) then
    !rows = !form.netTable.getRows()
    -- Turn grid events off and on to avoid updating for every index
    !form.netTable.allGridEvents(false)
    do !i indices !rows
      if (!selectedParts.findFirst(!rows[!i][1].dbref()).set()) then
        !form.netTable.selectRow(!i)
      endif
    enddo
    !form.netTable.allGridEvents(true)
  endif

endmethod
-- End of method definition for .showPartFamily(FORM, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      selectPart
--
-- Description: Callback for select part buttons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .selectPart(!gadget is GADGET, !action is STRING)

  -- Get form
  !form = !gadget.owner()

  -- Select all in part family list
  if (!gadget eq !form.selectAll) then
    !form.parts.clear()
    !rows = !form.netTable.getRows()
    -- Turn grid events off and on to avoid updating for every index
    !form.netTable.allGridEvents(false)
    do !i indices !rows
      !part = !rows[!i][1].dbref()
      handle any
        return error 1 |A part in the selection is no longer available|
      endhandle
      !form.netTable.selectRow(!i)
      !form.parts.append(!part)
    enddo
    !form.netTable.allGridEvents(true)

  -- Clear selection
  elseif (!gadget eq !form.selectNone) then
    -- Turn grid events off and on to avoid update
    !form.netTable.allGridEvents(false)
    !form.netTable.clearRowSelection()
    !form.netTable.allGridEvents(true)
    !form.parts.clear()

  endif

  -- Update form display
  if (!form.partAttributesFrame.visible) then
    !this.showAttributes(!form)
  elseif (!form.partRefsFrame.visible) then
    !this.showReferences(!form)
  else
    !this.showTasks(!form)
  endif

  -- Activate gadgets
  !this.activate(!form)

endmethod
-- End of method definition for .selectPart(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      netPopupCallback
--
-- Description: Pop up menu event for .net control on the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
--    2   R      ARRAY       Grid data
--                           [0] Cursor X
--                           [1] Cursor Y
--                           [2] Array of selected row tags (STRING data type)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netPopupCallback(!form is FORM, !data is ARRAY)

  -- Activate menu fields for single selection only
  if (!form.parts.size() eq 1) then
    !form.puTable.setFieldProperty('NAVIGATE', 'ACTIVE', true)
    !form.puTable.setFieldProperty('EDIT', 'ACTIVE', true)

    -- Activate set references
    !values = !!catAttValVar(!form.parts, !this.refAttributes)
    !form.puNavigateList.setFieldProperty('THISPART', 'ACTIVE', true)
    do !i indices !this.refAttributes
      !active = (!values[!i].set() and !values[!i].badref().not())
      !form.puNavigateList.setFieldProperty(!this.refAttributes[!i], 'ACTIVE', !active)
    enddo

  else
    !form.puTable.setFieldProperty('NAVIGATE', 'ACTIVE', false)
    !form.puTable.setFieldProperty('EDIT', 'ACTIVE', false)
  endif

  -- Activate copy and paste fields
  !form.puTable.setFieldProperty('COPY', 'ACTIVE', true)
  !form.puTable.setFieldProperty('PASTE', 'ACTIVE', !form.clipboard.empty().not())

  -- Show popup
  !form.conTable.showPopup(!data[0], !data[1])

endmethod
-- End of method definition for .netPopupCallback(FORM, ARRAY)

------------------------------------------------------------------------
--
-- Method:      tablePopup
--
-- Description: Pop up menu actions for .net control on the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Button callback for frame links for .net control
--    1   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tablePopup(!gadget is GADGET, !action is STRING)

  -- Get calling popup menu details
  !form = !gadget.owner()

  -- check for empty list
  if( not defined(!form.parts[1]) ) then
    !!alert.error('Cannot perform action because part list is empty')
    return
  endif

  -- Process popup
  if (!action EQ 'NAV23DMODEL') then
    -- Navigate to reference element
      !!ce = !form.parts[1].catref
      handle(2,822)
        !!alert.error('3D Model Reference unset')
      elsehandle any
        !!alert.error(!!error.text)
      endhandle
  elseif (!action eq 'NAV2THISPART') then
    -- Navigate to selected part
      !!ce = !form.parts[1]
  elseif (!action eq 'EDIT3DMODEL') then
    -- Show model edit form
      !!ce = !form.parts[1].catref
    handle(2,822)
       !!alert.error('3D Model Reference unset')
    elsehandle none
      !!catModelViews.add()
    endhandle
  endif

endmethod
-- End of method definition for .tablePopup()

------------------------------------------------------------------------
--
-- Method:      tablePopup
--
-- Description: Pop up menu actions for .net control on the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU       Pop up menu for .net control
--    1   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tablePopup(!object is MENU, !action is STRING)

  -- Get calling popup menu details
  !form = !object.owner()
  !pickedField = !object.pickedFieldName

  -- Process popup
  !navigatePick = !this.refAttributes.findFirst(!pickedField)
  if (!navigatePick.set()) then
    -- Navigate to reference element
    !!ce = !form.parts[1].attribute(!this.refAttributes[!navigatePick])
  elseif (!pickedField eq 'THISPART') then
    -- Navigate to selected part
    !!ce = !form.parts[1]
  elseif (!pickedField eq 'EDITCATE') then
    -- Show model edit form
    !!ce = !form.parts[1].catref
    handle(2,822)
       !!alert.error('3D Model Reference unset')
    elsehandle none
    !!catModelViews.add()
    endhandle
  elseif (!pickedField eq 'COPY') then
    -- Store current selection
    !form.clipboard = !form.parts
  elseif (!pickedField eq 'PASTE') then
    -- Select stored selection and create copies
    !form.parts = !form.clipboard
    !this.createParts(!form.crCopyPart, |SELECT|)
  endif

endmethod
-- End of method definition for .tablePopup()

------------------------------------------------------------------------
--
-- Method:      netAfterSelect
--
-- Description: After select event for .net control on the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
--    2   R      ARRAY       Grid data, !data[0] is array of selected row tags
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netAfterSelect(!form is FORM, !data is ARRAY)

    -- Store parts selection
  if (!data[0].set()) then
    !form.parts.clear()
    do !partRef values !data[0]
      !part = !partRef.dbref()
      handle any
        return error 1 |A part in the selection is no longer available|
      endhandle
      !form.parts.append(!part)
    enddo
  endif

    -- Update form display
  if (!form.partAttributesFrame.visible) then
    !this.showAttributes(!form)
    elseif (!form.partRefsFrame.visible) then
      !this.showReferences(!form)
    else
    !this.showTasks(!form)
  endif

  -- Activate gadgets
  !this.activate(!form)

endmethod
-- End of method definition for .netAfterSelect(FORM, ARRAY)

------------------------------------------------------------------------
--
-- Method:      partCE
--
-- Description: Reinitialise the form for the current element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .partCE(!form is FORM)

  -- Reinitialise form for CE
  !this.init(!form)
  !this.showPart(!form)

endmethod
-- End of method definition for .partCE(FORM)

------------------------------------------------------------------------
--
-- Method:      recentParts
--
-- Description: Use a part from the recent parts list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .recentParts(!gadget is GADGET, !action is STRING)

  -- Get form
  !form = !gadget.owner()

  -- Ignore hidden action
  if (!action eq |SELECT|) then

    -- Set form member to parts member
    !!ce = !gadget.selection().dbref()
    handle (2, 107)
      -- Undefined reference (deleted element)
      !!alert.error(|Selected part family is no longer available|)
      !this.updateRecentParts(!form)
    elsehandle none
      !this.init(!form)
      !this.showPart(!form)
    endhandle

  endif

endmethod
-- End of method definition for .recentParts(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      updateRecentParts
--
-- Description: Update recent parts list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateRecentParts(!form is FORM)

  -- Update recent parts list
  !form.recentParts.dtext = !!catRecentObjects.dtext(|PRTELE|)
  !form.recentParts.rtext = !!catRecentObjects.rtext(|PRTELE|)

endmethod
-- End of method definition for .updateRecentParts(FORM)

------------------------------------------------------------------------
--
-- Method:      showTasks
--
-- Description: Show attributes panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showTasks(!form is FORM)

  -- Check for unapplied edits
  if (!form.touched or !form.subTouched) then
    if (!!alert.confirm(|There are unapplied changes. Ok to discard these?|) eq |NO|) then
      return error 1 noalert
    endif
  endif

  -- Set panel visibilities
  !form.tasksFrame.visible          = true
  !form.partAttributesFrame.visible = false
  !form.partRefsFrame.visible       = false
  !form.partSearchFrame.visible     = false
  !form.partViewFrame.visible       = false
  !form.symbolFrame.visible         = false
  !form.detailFrame.visible         = false
  !form.materialFrame.visible       = false
  !form.boltsFrame.visible          = false
  !form.weightFrame.visible         = false
  !form.surfFrame.visible           = false

  -- Initialise apply states
  !form.touched    = false
  !form.subTouched = false

endmethod
-- End of method definition for .showTasks(FORM)

------------------------------------------------------------------------
--
-- Method:      showAttributes
--
-- Description: Show attributes panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showAttributes(!form is FORM)

  -- Set panel visibilities
  !form.tasksFrame.visible          = false
  !form.partAttributesFrame.visible = true
  !form.partRefsFrame.visible       = false
  !form.partSearchFrame.visible     = false
  !form.partViewFrame.visible       = true
  !form.symbolFrame.visible         = false
  !form.detailFrame.visible         = false
  !form.materialFrame.visible       = false
  !form.boltsFrame.visible          = false
  !form.weightFrame.visible         = false
  !form.surfFrame.visible           = false

  -- Initialise values
  !form.name.val        = object STRING()
  !form.pritype.val     = object STRING()
  !form.sectype.val     = object STRING()
  !form.description.val = object STRING()
  !form.comment.val     = object STRING()
  !form.purpose.val     = object STRING()
  !this.checkBadParts(!form)
  !this.viewPart(!form)

  -- Set values allowing for variance in selected parts
  if (!form.parts.empty().not()) then
    !values = !!catAttValVar(!form.parts, !this.partAttributes)
    -- Show name only for single part in selection
    if (!form.parts.size() eq 1) then
      if (!form.parts[1].isNamed) then
        !form.name.val = !form.parts[1].namn
      else
        !form.name.val = |unset|
      endif
    else
      !form.name.val = |<Multiple Values>|
    endif
    !form.pritype.val     = !values[2]
    !form.sectype.val     = !values[3]
    !form.description.val = !values[4]
    !form.comment.val     = !values[5]
    !form.purpose.val     = !values[6]
    if (!values[7].objectType() eq |STRING|) then
      !form.lselec.val    = false
      !form.lvaries.val   = |<Multiple Values>|
    else
      !form.lselec.val    = !values[7]
      !form.lvaries.val   = ||
    endif
  endif

  -- Activate gadgets
  !form.partAttributesFrame.active = !form.parts.empty().not()
  !form.name.active                = (!form.parts.size() eq 1)
  !form.allPartAttribs.active      = (!form.parts.size() eq 1)

  -- Initialise apply state
  !form.touched = false
  !form.partAttribsApply.active = false

endmethod
-- End of method definition for .showAttributes(FORM)

------------------------------------------------------------------------
--
-- Method:      setAttribute
--
-- Description: Callback for part attribute
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setAttribute(!gadget is GADGET, !action is STRING)

  -- Get form
  !form = !gadget.owner()

  -- Set flag to show gadget edited
  !form.touched = true
  !form.partAttribsApply.active = true

  -- Name
  if (!gadget eq !form.name) then

    -- Validate name only for single part in selection
    if (!form.parts.size() eq 1) then
      if (!gadget.val ne !form.parts[1].namn) then
        if (!gadget.val.trim() eq ||) then
          !gadget.val = |unset|
        else
          !newName = !!checkName(!gadget.val, |NEW|)
        endif
      endif
    endif

  -- Apply button
  elseif (!gadget eq !form.partAttribsApply) then

    -- Set attributes if not varying
    do !part values !form.parts
      if (!form.pritype.val ne |<Multiple Values>|) then
        !part.pritype = !form.pritype.val
      endif
      if (!form.sectype.val ne |<Multiple Values>|) then
        !part.sectype = !form.sectype.val
      endif
      if (!form.description.val ne |<Multiple Values>|) then
        !part.description = !form.description.val
      endif
      if (!form.comment.val ne |<Multiple Values>|) then
        !part.comment = !form.comment.val
      endif
      if (!form.purpose.val ne |<Multiple Values>|) then
        !part.purpose = !form.purpose.val
      endif
      !part.lselec = !form.lselec.val
    enddo
    -- Name updated only for single part in selection
    if (!form.parts.size() eq 1) then
      if (!form.name.val ne !form.parts[1].namn) then
        if (!form.name.val.trim() eq |unset|) then
          !dbpos = !!ce
          !!ce = !form.parts[1]
          if (!!ce.isNamed eq true) then
          UNNAME
          endif
          !!ce = !dbpos
        else
          -- Check name again as not cleared when checked (to allow user to modify bad name)
          !newName = !!checkName(!form.name.val, |NEW|)
          if (!newName.set()) then
            !form.parts[1].name = !newName
          else
            if (!form.parts[1].isNamed) then
              !form.name.val = !form.parts[1].namn
            else
              !form.name.val = |unset|
            endif
          endif
        endif
      endif
    endif

    -- Clear flag to show gadgets edited
    !form.touched = false
    !form.partAttribsApply.active = false

    -- Update part family view
    !this.showPartFamily(!form)

  endif

endmethod
-- End of method definition for .setAttribute(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      modifyAttribs
--
-- Description: Modify attributes for element related to part
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .modifyAttribs(!gadget is GADGET, !action is STRING)

  -- Get form
  !form = !gadget.owner()

  -- Show attributes form for element associated with gadget
  !!ce = !form.parts[1]
  !!catModifyAttribs()

endmethod
-- End of method definition for .modifyAttribs(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      showReferences
--
-- Description: Show references panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showReferences(!form is FORM)

  -- Set panel visibilities
  !form.tasksFrame.visible          = false
  !form.partAttributesFrame.visible = false
  !form.partRefsFrame.visible       = true
  !form.partSearchFrame.visible     = false

  -- Activate gadgets
  !form.partRefsFrame.active = !form.parts.empty().not()
  !form.symbolFrame.active   = !form.parts.empty().not()
  !form.detailFrame.active   = !form.parts.empty().not()
  !form.materialFrame.active = !form.parts.empty().not()
  !form.boltsFrame.active    = !form.parts.empty().not()
  !form.weightFrame.active   = !form.parts.empty().not()
  !form.editRef.active       = false

  -- Initialise to first item in list
  !this.partRefList(!form)

endmethod
-- End of method definition for .showReferences(FORM)

------------------------------------------------------------------------
--
-- Method:      partRefList
--
-- Description: Callback for part reference list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .partRefList(!form is FORM)

  -- Check for unapplied edits
  if (!form.touched or !form.subTouched) then
    if (!!alert.confirm(|There are unapplied changes. Ok to discard these?|) eq |NO|) then
      -- Reselect previous selection without running callback so edits preserved
      !form.partRefList.val = !form.partRefListVal
      return error 1 noalert
    endif
  endif
  !form.partRefListVal = !form.partRefList.val

  -- Set panel visibilities
  !form.partViewFrame.visible = (!form.partRefList.val lt 3)
  !form.symbolFrame.visible   = (!form.partRefList.val eq 3)
  !form.detailFrame.visible   = (!form.partRefList.val eq 4)
  !form.materialFrame.visible = (!form.partRefList.val eq 5)
  !form.boltsFrame.visible    = (!form.partRefList.val eq 6)
  !form.weightFrame.visible   = (!form.partRefList.val eq 7)
  !form.surfFrame.visible     = (!form.partRefList.val eq 8)

  -- Initialise gadgets
  !form.refElement   = object DBREF()
  !form.refTag.val   = !form.partRefList.selection()
  if (!form.partRefList.selection() eq |Drssref|) then
    -- 2D symbols combines marine diagram symbol edits on panel with link to modify Drsset form
    !form.editRef.tag  = |Edit Draft Symbol Set...|
  else
    !form.editRef.tag  = |Edit | & !this.refLabels[!form.partRefList.val][1] & |...|
  endif
  !form.refVal.val    = |Nulref|
  !form.symGroup.val  = object STRING()
  !form.symName.val   = object STRING()
  !form.template.val  = object STRING()
  !form.criteria.val  = object STRING()
  !form.skey.val      = object STRING()
  !form.rtext.val     = object STRING()
  !form.stext.val     = object STRING()
  !form.ttext.val     = object STRING()
  !form.xtext.val     = object STRING()
  !form.ytext.val     = object STRING()
  !form.ztext.val     = object STRING()
  !form.blist.val     = object STRING()
  !form.bdiameter.val = object STRING()
  !form.blength.val   = 0
  !form.noff.val      = 0
  !form.weight.val    = object STRING()
  !form.weight.tag    = |Weight|
  !form.drsylks.clear()
  !form.drsylkList.clear()
  !form.sbolts.clear()
  !form.sboltList.clear()
  !form.pucd.val      = object STRING()
  !form.stcd.val      = object STRING()
  !form.surmat.val    = object STRING()
  !form.surprep.val   = object STRING()
  !form.shoppri.val   = false
  !form.coatingList.clear()
  !this.clearView(!form)
  !this.checkBadParts(!form)

  -- Get values for reference allowing for variance in selected parts
  if (!form.parts.empty().not()) then

    if (!form.refTag.val eq |Drssref|) then
      -- Marine Diagram symbol attributes are displayed when 2D symbols reference is selected
      !symValues = !!catAttValVar(!form.parts, !this.symAttributes)
      !form.symGroup.val = !symValues[1]
      !form.symName.val  = !symValues[2]
    elseif (!form.refTag.val eq |Srftref|) then
      -- Surface treatment attributes are displayed when surface treatment reference is selected
      !surfValues = !!catAttValVar(!form.parts, !this.surfAttributes)
      !form.pucd.val = !surfValues[1]
      !form.stcd.val = !surfValues[2]
    endif

    !values = !!catAttValVar(!form.parts, !this.refAttributes)

    if (!values[!form.partRefList.val].objectType() eq |STRING|) then

      -- Multiple values
      !form.refVal.val = |<Multiple Values>|

    elseif (!values[!form.partRefList.val].set()) then

      -- Single value
      if (!values[!form.partRefList.val].badref().not()) then
        !form.refElement = !values[!form.partRefList.val]
        !form.refVal.val = !form.refElement.namn

        -- Display view for catref or tmpref
        if (!form.refTag.val inset(|Catref|, |Tmpref|)) then
          !this.viewElement(!form, !form.refElement)

        -- Display Draft symbol set links
        elseif (!form.refTag.val eq |Drssref|) then
          !dtext = ARRAY()
          !rtext = ARRAY()
          do !drsylk values !form.refElement.members
            if (!drsylk.type eq |DRSYLK|) then
              !form.drsylks.append(!drsylk)
              !dtext.append(!drsylk.namn)
              !rtext.append(!drsylk.ref.string())
            endif
          enddo
          !form.drsylkList.dtext = !dtext
          !form.drsylkList.rtext = !rtext
          !this.drsylkList(!form)

        -- Display data for detail text
        elseif (!form.refTag.val eq |Detref|) then
          !form.skey.val = !form.refElement.skey
          !form.rtext.val = !form.refElement.rtext
          !form.stext.val = !form.refElement.stext
          !form.ttext.val = !form.refElement.ttext

        -- Display data for material text
        elseif (!form.refTag.val eq |Matxt|) then
          !form.xtext.val = !form.refElement.xtext
          !form.ytext.val = !form.refElement.ytext
          !form.ztext.val = !form.refElement.ztext

        -- Display data for bolt set
        elseif (!form.refTag.val eq |Bltref|) then
          !dtext = ARRAY()
          !rtext = ARRAY()
          if (!form.refElement.type eq |SBOL|) then
            !form.sbolts.append(!form.refElement)
          elseif (!form.refElement.type eq |MBOL|) then
            !form.sbolts.appendArray(!form.refElement.sbrarray)
          endif
          do !sbolt values !form.sbolts
            if (!sbolt.set()) then
              !dtext.append(!sbolt.namn)
              !rtext.append(!sbolt.ref.string())
            endif
          enddo
          !form.sboltList.dtext = !dtext
          !form.sboltList.rtext = !rtext
          !this.sboltList(!form)

        -- Display data for component or unit weight
        elseif (!form.refTag.val eq |Cmpref|) then
          if (!form.refElement.type eq |CMPD|) then
            !form.weight.tag = |Cweight|
            !form.weight.val = !form.refElement.cweight
          elseif (!form.refElement.type inset(|CABD|, |TUBD|)) then
            !form.weight.tag = |Uweight|
            !form.weight.val = !form.refElement.uweight
          endif

        -- Display surface treatment data
        elseif (!form.refTag.val eq |Srftref|) then
          !form.surmat.val  = !form.refElement.surMaterial
          !form.surprep.val = !form.refElement.surPreparation
          !form.shoppri.val = !form.refElement.shoPrimer
          !rows = ARRAY()

          -- Define a global format to use for displaying thickness
          !thicknessFmt = object FORMAT()
          !thicknessFmt.dp            = 2
          !thicknessFmt.dimension     = 'L'
          !thicknessFmt.trailzeros    = false

          -- Set format units
          !coatingHeadings = !!catPartViews.coatingHeadings
          if (!!isImperialLength('DIST')) then
            !thicknessFmt.units = 'THOU'
            !coatingHeadings[2] = !coatingHeadings[2] + ' (mil)'
          else
            !thicknessFmt.units = 'MICRONS'
            !coatingHeadings[2] = !coatingHeadings[2] + ' (microns)'
          endif
          !form.coatingList.setHeadings(!coatingHeadings)

          do !coating values !form.refElement.members
            if (!coating.type eq |COATIN|) then
              !row = ARRAY()
              !row.append(!coating.namn)
              !coatThick = !coating.cThickness.string(!thicknessFmt)
              !row.append(!coatThick)
              !rows.append(!row)
            endif
          enddo
          !form.coatingList.setRows(!rows)

        endif

      endif
    endif
  endif

  -- Initialise apply states
  !form.touched    = false
  !form.subTouched = false
  !form.partRefsApply.active = false
  !form.partSymApply.active  = false
  !form.surfApply.active     = false

  -- Activate gadget
  !form.editRef.active = (!form.partRefList.selection() ne |Tmpref| and !form.refElement.set())

endmethod
-- End of method definition for .partRefList(FORM)

------------------------------------------------------------------------
--
-- Method:      setReference
--
-- Description: Callback for part reference
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setReference(!gadget is GADGET, !action is STRING)

  -- Get form
  !form = !gadget.owner()

  -- CE button
  if (!gadget eq !form.refCE) then

    -- Validate CE
    if (!this.refTypes[!form.partRefList.val].match(!!ce.type) eq 0) then
      if (!form.refTag.val eq |Drssref| and !!ce.type eq |DRSYLK|) then
        DRSSET
      else
        return error 1 |$!!<ce.name> is not of correct type|
      endif
    endif
    !form.refVal.val = !!ce.namn

    -- Set flag to show gadget edited
    !form.touched = true
    !form.partRefsApply.active = true

  -- Text input
  elseif (!gadget eq !form.refVal) then

    -- Check for unset
    if (!gadget.val eq || or !gadget.val.lowcase() eq |unset| or !gadget.val.substring(1,2) eq |=0|) then
      !gadget.val = |Nulref|
    else
      -- Validate name
      !newValue = !!checkName(!gadget.val, |OLD|)
      if (!newValue.set()) then
        if (!this.refTypes[!form.partRefList.val].match(!newValue.dbref().type) eq 0) then
          !this.partRefList(!form)
          return error 1 |$!newValue is not of correct type|
        endif
      else
        !this.partRefList(!form)
      endif
    endif

    -- Set flag to show gadget edited
    !form.touched = true
    !form.partRefsApply.active = true

  -- Apply button
  elseif (!gadget eq !form.partRefsApply) then

   -- Cycle round the selected parts and set references.
   do !part value !form.parts

    -- Set reference
    if (!form.refVal.val eq |Nulref|) then
      !dbpos = !!ce
      !!ce = !part
      $!<form.refTag.val> NULREF
      !!ce = !dbpos
    elseif (!form.refVal.val ne |<Multiple Values>|) then
         if (!form.refVal.val.substring(1,1) ne '=') then
      !name = |/| & !form.refVal.val
         else
             !name = !form.refVal.val
         endif
      if (!part.attribute(!form.refTag.val) ne !name.dbref()) then
        !part.attribute(!form.refTag.val) = !name.dbref()
      endif
    endif

   enddo

    -- Clear flag to show gadgets edited
    !form.touched = false
    !form.partRefsApply.active = false

    -- Reinitialise panel
    !this.showReferences(!form)

  endif

endmethod
-- End of method definition for .setReference(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      editRef
--
-- Description: Show appropriate form to edit reference
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .editRef(!form is FORM)

  -- Show appropriate form to edit reference
  if (!form.refElement.set()) then
    if (!form.refElement.badref().not()) then
      !!ce = !form.refElement
      if (!form.partRefList.selection() eq |Catref|) then
        !!catModelViews.add()
      elseif (!form.partRefList.selection() eq |Drssref|) then
        show !!catDrsset
      elseif (!form.partRefList.selection() eq |Detref|) then
        $m "%PDMSUI%/cat/text/XCRDTEX" $<MODIFY$>
      elseif (!form.partRefList.selection() eq |Matxt|) then
        $m "%PDMSUI%/cat/text/XCRMTEX" $<MODIFY$>
      elseif (!form.partRefList.selection() eq |Bltref|) then
        show !!catBolting
      elseif (!form.partRefList.selection() eq |Cmpref|) then
        show !!propcon
      elseif (!form.partRefList.selection() eq |Srftref|) then
        show !!sftDefineMain2
      elseif (!form.partRefList.selection() eq |Pdaref|) then
        !!catSpecViews.add()
      endif
    endif
  endif

endmethod
-- End of method definition for .editRef(FORM)

------------------------------------------------------------------------
--
-- Method:      setMDSymAtts
--
-- Description: Set marine diagram symbol attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setMDSymAtts(!gadget is GADGET, !action is STRING)

  -- Get form
  !form = !gadget.owner()

  -- Set flag to show gadget edited
  !form.subTouched = true
  !form.partSymApply.active = true

  -- Apply button
  if (!gadget eq !form.partSymApply) then

    -- Set attributes if not varying
    do !part values !form.parts
      if (!form.symGroup.val ne |<Multiple Values>|) then
      !part.symGroup = !form.symGroup.val
    endif
      if (!form.symName.val ne |<Multiple Values>|) then
      !part.symName = !form.symName.val
    endif
  enddo

    -- Clear flag to show gadgets edited
    !form.subTouched = false
    !form.partSymApply.active = false

  endif

endmethod
-- End of method definition for .setMDSymAtts(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      setSurfAtts
--
-- Description: Set surface treatment attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .setSurfAtts(!gadget is GADGET, !action is STRING)

  -- Get form
  !form = !gadget.owner()

  -- Set flag to show gadget edited
  !form.subTouched = true
  !form.surfApply.active = true

  -- Apply button
  if (!gadget eq !form.surfApply) then

    -- Set attributes if not varying
    do !part values !form.parts
      if (!form.pucd.val ne |<Multiple Values>|) then
        !part.pucd = !form.pucd.val
      endif
      if (!form.stcd.val ne |<Multiple Values>|) then
        !part.stcd = !form.stcd.val
      endif
    enddo

    -- Clear flag to show gadgets edited
    !form.subTouched = false
    !form.surfApply.active = false

  endif

endmethod
-- End of method definition for .setSurfAtts(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      drsylkList
--
-- Description: Callback for draft symbol link list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .drsylkList(!form is FORM)

  -- Initialise
  !form.template.val = object STRING()
  !form.criteria.val = object STRING()

  -- Populate gadgets with selected symbol link data
  if (!form.drsylks.empty().not()) then
    !drsylk = !form.drsylks[!form.drsylkList.val]

    -- Template reference
    if (!drsylk.drtmpref.set()) then
      if (!drsylk.drtmpref.badref().not()) then
        !form.template.val  = !drsylk.drtmpref.namn
      endif
    endif

    -- Criteria
    !form.criteria.val = !drsylk.criteria.trim()
    handle (2, 779)
      -- Criteria returns string if set or integer array if unset
      -- Ignore error for method array.trim() not found as this means criteria is unset
    endhandle
  endif

endmethod
-- End of method definition for .drsylkList(FORM)

------------------------------------------------------------------------
--
-- Method:      sboltList
--
-- Description: Callback for bolt list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sboltList(!form is FORM)

  -- Initialise
  !form.blist.val     = object STRING()
  !form.bdiameter.val = object STRING()
  !form.blength.val   = 0
  !form.noff.val      = 0

  -- Populate gadgets with selected sbolt data
  if (!form.sbolts.empty().not()) then
    !sbolt = !form.sbolts[!form.sboltList.val]
    !form.blist.val     = !sbolt.owner.namn
    !form.bdiameter.val = !sbolt.bdiameter
    !form.blength.val   = !sbolt.length
    !form.noff.val      = !sbolt.noff
  endif

endmethod
-- End of method definition for .sboltList(FORM)

------------------------------------------------------------------------
--
-- Method:      showSearch
--
-- Description: Show search panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showSearch(!gadget is GADGET, !action is STRING)

  -- Get form
  !form = !gadget.owner()

  -- Set search info
  !form.searchReturn    = |References|
  !form.searchAttribute = !form.refTag.val
  !form.searchDBType    = !this.refDBTypes[!form.partRefList.val]
  !form.searchTypes     = !this.refTypes[!form.partRefList.val]

  -- Initialise search
  !this.showSearch(!form)

endmethod
-- End of method definition for .showSearch(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      showSearch
--
-- Description: Show search panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .showSearch(!form is FORM)

  -- Set panel visibilities
  !form.tasksFrame.visible          = false
  !form.partAttributesFrame.visible = false
  !form.partRefsFrame.visible       = false
  !form.partSearchFrame.visible     = true
  !form.partViewFrame.visible       = false
  !form.symbolFrame.visible         = false
  !form.detailFrame.visible         = false
  !form.materialFrame.visible       = false
  !form.boltsFrame.visible          = false
  !form.weightFrame.visible         = false
  !form.surfFrame.visible           = false

  -- Set search info
  !form.partSearch.tag  = |Search for | & !form.searchAttribute
  !form.searchResults.clear()
  !form.useResults.active = false
  -- Define search scope
  !dbType      = !form.searchDBType
  !searchFor   = !form.searchTypes.split()
  !searchIn    = ARRAY()
  !searchIn[1] = |/*|
  -- Define filter statements (attribute operator value)
  !filters    = ARRAY()
  !filters[1] = |NAME like *|
  -- Define results columns (attribute heading)
  !columns    = ARRAY()
  !columns[1] = |NAME Name|
  !columns[2] = |OWNER Owner|
  -- Set search control to stay on settings and not switch direct to results
  !displayResults = false
  !form.searchControl.initiateSearch(!displayResults, |Search|, !dbType, !searchIn, !searchFor, !filters, !columns)

endmethod
-- End of method definition for .showSearch(FORM)

------------------------------------------------------------------------
--
-- Method:      partResultsSelected
--
-- Description: After select event for search control on the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
--    2   R      ARRAY       Search results data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .partResultsSelected(!form is FORM, !data is ARRAY)

  -- !data[0], [1], etc are strings of selected dbrefs from search results
  -- Store selected results as form member dbref array
  !form.searchResults.clear()
  do !i from 0 to (!data.size() - 1)
    break if (!data[!i].unset())
      !element = !data[!i].dbref()
    handle any
      -- Ignore if badref
    elsehandle none
      if (!form.searchControl.showEleText().match(!element.type) eq 0) then
        !!alert.confirm(!element.namn & | is not of the correct type|)
      else
        !form.searchResults.append(!element)
      endif
    endhandle
  enddo

  -- Activate gadget
  !form.useResults.active = (!form.searchResults.size() eq 1)
  !form.useResults.active = TRUE

  -- Set the Selected User Search Types
  !form.searchTypeUser = !form.searchControl.showEleText()

endmethod
-- End of method definition for .partResultsSelected(FORM, ARRAY)

------------------------------------------------------------------------
--
-- Method:      useResults
--
-- Description: Use results of search
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .useResults(!gadget is GADGET, !action is STRING)

  -- Get form
  !form = !gadget.owner()
  !save = !!ce

  if (!gadget eq !form.useResults) then

    if (!form.searchReturn eq |References|) then

      -- Show reference panel, set text to selected result and set flag to show gadget edited
    !this.showReferences(!form)
    if (!form.searchResults[1].set()) then
      !form.refVal.val = !form.searchResults[1].namn
        !form.touched = true
        !form.partRefsApply.active = true
      endif

    elseif (!form.searchReturn eq |Tasks|) then

      -- Show tasks panel, set CE to selected result and run create part method
--      !this.showTasks(!form)
      if (!form.searchResults[1].set()) then

          if (!form.searchAttribute eq |Category|) then
              !this.createParts(!form.crCatePart, |SELECT|)

          elseif (!form.searchAttribute eq |Template|) then
              !this.createParts(!form.crTmplPart, |SELECT|)
          endif

      endif

    endif

  elseif (!gadget eq !form.backToRefs) then

    -- Show calling panel unchanged
    if (!form.searchReturn eq |References|) then
      !this.showReferences(!form)
    elseif (!form.searchReturn eq |Tasks|) then
      !this.showTasks(!form)
    endif

  endif

  -- Return to original element
     !!ce = !save

endmethod
-- End of method definition for .useResults(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      createParts
--
-- Description: Create new parts in the current part family
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .createParts(!gadget is GADGET, !action is STRING)

  -- Get form
  !form        = !gadget.owner()
  !elementList = ARRAY()

  -- Check can create parts in part family
  !dbpos = !!ce
  !!ce = !form.prtele
  handle any
    write |$!!error.text|
    return error 1 noalert
  endhandle

  !!ce = !dbpos

  -- This is only done the first time we use search panel.
if (defined(!form.searchResults[1])) then
  if (not !form.searchResults[1].set()) then
    if (!form.searchTypeUser.length() eq 0) then
      if (!gadget eq !form.crCatePart) then
        !form.searchTypeUser = |CATE STCA|
      else
        -- Choose type depending on application as a start
        if (!!appCntrl.currentApp eq 'ELEC') then
           !form.searchTypeUser = !this.refTypes[10]
        else
          !form.searchTypeUser = |TMAR|
        endif
      endif
    endif
  endif
endif

  -- Check type if creating parts from category or template
  if (!gadget eq !form.crCatePart) then
   if (!!ce.type.eq(|CATE|)) then
      !catePos = 1
      !stcaPos = object STRING()
   elseif (!!ce.type.eq(|STCA|)) then
      !stcaPos = 1
      !catePos = object STRING()
   else
      !catePos = !!ce.ahlist.findFirst(|CATE|)
      !stcaPos = !!ce.ahlist.findFirst(|STCA|)

    if(defined(!form.searchResults[1])) then
     -- Create and select parts from source object members
   !elementList = !form.searchResults[1].members

     -- This is the allowed types to filter - SCOM,...
    !allowedTypes = !this.refTypes[1] & | | & !this.refTypes[2] & | | & !this.refTypes[9]

    -- Cycle round element list and add parts as they are validated.
      do !element value !elementList

       if (!allowedTypes.match(!element.type) gt 0) then
       !!ce = !form.prtele
        NEW GPART
        -- Assign the required CATREF to the GPART
        !!ce.catref = !element
       endif

      enddo
     endif

      -- Reinitialise form
     !this.showPartFamily(!form)
  if (!form.partAttributesFrame.visible) then
      !this.showAttributes(!form)
  elseif (!form.partRefsFrame.visible) then
      !this.showReferences(!form)
  else
      !this.showTasks(!form)
  endif

   endif

      if (!catePos.unset() and !stcaPos.unset()) then

        -- CE is not of correct type so run search
        !form.searchReturn    = |Tasks|
        !form.searchAttribute = |Category|
        !form.searchDBType    = |CATA|
        !form.searchTypes     = |CATE|

        if (!!appCntrl.currentApp inset('STL')) then
          !form.searchTypes     = |STCA|
        endif

        !form.searchTypeUser  = !form.searchTypes
        !this.showSearch(!form)

        return

      elseif (!catePos.set()) then
        CATE
        !elementList = !!ce.members
      else
        STCA
        !elementList = !!ce.members
      endif

  elseif (!gadget eq !form.crTmplPart) then

      -- Check for valid types.
        if (!form.searchResults.empty()) then
          -- CE is not of correct type so run search
          !form.searchReturn    = |Tasks|
          !form.searchAttribute = |Template|
          !form.searchDBType    = |DESI|
          !form.searchTypes     = |TMPL|

          if (!!appCntrl.currentApp inset('ELEC')) then
            !form.searchTypes     = !this.refTypes[10]
          endif

           !form.searchTypeUser  = !form.searchTypes
           !this.showSearch(!form)
             return
        else
            -- Check for valid elements at this point.
            do !addTmpl value !form.searchResults
               if (!form.searchTypes.match(!addTmpl.type) ne 0) then
                 -- Add this element to list, as it is a valid element type.
                 !elementList.append(!addTmpl)
               endif
            enddo
        endif

  endif

  -- Set CE to last member of part family
    if (!form.prtele.badref()) then
      return error 1 |This part family is no longer available|
    endif
    !!ce = !form.prtele
  LAST GPART
  handle any
    -- No members
  endhandle

  -- New part
  if (!gadget eq !form.crNewPart) then
    -- Create and select new part
    NEW GPART
    if (!!namOpt.auto()) then
      !name = !!namOpt.nameString(!!ce, STRING(), false, false)
      if (!name.set()) then
        NAME /$!name
      endif
    endif
    !form.parts.clear()
    !form.parts[1] = !!ce

  -- Copy Selected Parts
  elseif (!gadget eq !form.crCopyPart) then

    -- Create and select new parts
    !newParts = ARRAY()
    do !part values !form.parts
      if (!part.badref()) then
        !!alert.error(|A part in the selection is no longer available|)
      else
        NEW GPART COPY $!part
        if (!!namOpt.auto()) then
          !name = !!namOpt.nameString(!!ce, STRING(), false, false)
          if (!name.set()) then
            NAME /$!name
          endif
        endif
        !newParts.append(!!ce)
      endif
    enddo
    !form.parts.clear()
    !form.parts.appendArray(!newParts)

  -- From category, structural category or template area
  else

    -- Create and select parts from source object members
    !allowedTypes = !this.refTypes[1] & | | & !this.refTypes[2] & | | & !this.refTypes[9]
    !newParts = ARRAY()

    -- Cycle round element list and add parts as they are validated.
    do !element value !elementList
      if (!allowedTypes.match(!element.type) gt 0) then
        NEW GPART

        !newParts.append(!!ce)

          -- Set GPART attributes from the template - done here to allow autonaming to
          -- use the TMPL element
        if (!gadget eq !form.crTmplPart) then
          !!ce.tmpref = !element
          !!ce.description = !element.description
          !!ce.pritype = !element.owner.function
          !!ce.sectype = !element.func
        else
          !!ce.catref = !element
        endif

        if (!!namOpt.auto()) then
          !name = !!namOpt.nameString(!!ce, STRING(), false, false)
          if (!name.set()) then
            NAME /$!name
          endif
        endif

      endif
    enddo

    !!ce = !dbpos
    !form.parts.clear()
    !form.parts.appendArray(!newParts)

  endif

  -- Reinitialise form
     !this.showPartFamily(!form)
  if (!form.partAttributesFrame.visible) then
      !this.showAttributes(!form)
  elseif (!form.partRefsFrame.visible) then
      !this.showReferences(!form)
  else
      !this.showTasks(!form)
  endif

  -- Clear Results Array
     !form.searchResults.clear()

  -- Activate gadgets
     !this.activate(!form)

endmethod
-- End of method definition for .createParts(FORM)

------------------------------------------------------------------------
--
-- Method:      activate
--
-- Description: Callback for create part option
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .activate(!form is FORM)

  -- Activate buttons
  !form.attributes.active   = !form.parts.empty().not()
  !form.references.active   = !form.parts.empty().not()
  !form.deleteParts.active  = !form.parts.empty().not()
  !form.crCopyPart.active   = !form.parts.empty().not()

endmethod
-- End of method definition for .activate(FORM)

------------------------------------------------------------------------
--
-- Method:      deleteParts
--
-- Description: Delete selected parts
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .deleteParts(!form is FORM)

  -- Delete the selected parts
  if (!form.parts.empty().not()) then
    if (!!alert.confirm(|OK to delete selected parts?|) eq |YES|) then

      -- Delete the parts
      !dbpos = !!ce
      do !part values !form.parts
        !!ce = !part
        DELETE GPART
      enddo

      -- Reset db position allowing for it to have been a deleted part
      if (!dbpos.badref().not()) then
        !!ce = !dbpos
      endif

      -- Reinitialise form
      !form.parts.clear()
      !this.showPartFamily(!form)
      if (!form.partAttributesFrame.visible) then
        !this.showAttributes(!form)
      elseif (!form.partRefsFrame.visible) then
        !this.showReferences(!form)
      else
        !this.showTasks(!form)
      endif

      -- Activate gadgets
      !this.activate(!form)

    endif
  endif

endmethod
-- End of method definition for .deleteParts(FORM)

------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: Remove part view from the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .remove(!form is FORM)

  -- Get form index
  !index = !this.viewIndex(!form)

  -- Return if we can't find the form in the system
  if (!index.unset()) then
    return
  endif

  -- Remove form from the system
  !this.partViews[!index].delete()

  if (!form.localDrawlists) then
    !!gphDrawlists.detachView(!form.drawlist, !form.view)
    !!gphDrawlists.deleteDrawList(!form.drawlist)
  endif

  -- Remove the form from the view system (this kills the form)
  !!gphViews.remove(!form.view)

  -- Update control form if exists and shown
  if (defined(!!catControl)) then
    if (!!catControl.shown()) then
      !!catControl.initialise()
    endif
  endif

endmethod
-- End of method definition for .remove(FORM)

------------------------------------------------------------------------
--
-- Method:      viewIndex
--
-- Description: Get form index in the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Part view form
-- Return:
--   [Data Type] [Description]
--    REAL        Index in the form list
--
------------------------------------------------------------------------

define method .viewIndex(!form is FORM) is REAL

  -- Loop through list
  do !i indices !this.partViews
    if (!form eq !this.partViews[!i]) then
      return !i
    endif
  enddo
  return REAL()

endmethod
-- End of method definition for .viewIndex(FORM) REAL

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Form bar menu selected from
--    2   R      STRING      Select state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close(!menu is MENU, !dummySelected is STRING)

  -- Remove form from the system
  !form   = !menu.owner()
  !unusedField  = !menu.pickedField
  !this.remove(!form)

endmethod
-- End of method definition for .close(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close(!form is FORM)

  -- Remove form from the system
  !this.remove(!form)

endmethod
-- End of method definition for .close(FORM)

------------------------------------------------------------------------
--
-- Method:      nextAvailable
--
-- Description: Next available form number
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        Available number
--
------------------------------------------------------------------------

define method .nextAvailable() is REAL

  return !this.partViews.maxIndex() + 1

endmethod
-- End of method definition for .nextAvailable() REAL
