--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  catPipeTableCodes()              -
--  clearCodes(STRING)               -
--  getCodes(STRING)                 ARRAY               Return the codes for the specified type
--  globalInstance()                 -                   Create global instance of object
--  loadFile()                       -                   Load pipe table codes from defaults file
--  loadFile(STRING)                 -                   Load pipe table codes from defaults file
--  saveFile(STRING)                 -                   Save storage areas to defaults file
--  setCodes(STRING,ARRAY)           -                   Set the specified codes
--

define object CATPIPETABLECODES

  -- File
  member .fileName        is STRING
  member .dfltFile        is FILE
  member .dfltArea        is STRING
  member .dfltPaths       is ARRAY    $* DEFAULTFILE objects
  member .delimiter       is STRING

  -- Short codes
  member .scheduleCodes   is ARRAY
  member .branchCodes     is ARRAY
  member .reducerCodes    is ARRAY
  member .tappingCodes    is ARRAY
  member .reduGreyAreaReadOnly is BOOLEAN
  member .branGreyAreaReadOnly is BOOLEAN
  member .tappGreyAreaReadOnly is BOOLEAN

endobject
-- End of object definition for catpipetablecodes

------------------------------------------------------------------------
--
-- Method:      catpipetablecodes
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .catPipeTableCodes()

  -- Set default file data
  !this.fileName = |cat-pipetablecodes.pmldat|
  !this.delimiter = |~|

  -- Find the most local defaults path (in PDMSDFLTS, {PRJ}DFLTS, or PDMSUSER)
  !this.dfltPaths = !!searchpaths(!this.fileName)
  if (!this.dfltPaths.size() gt 0) then
    -- Set default file
    !this.dfltFile = !this.dfltPaths.last().file
    !this.dfltArea = !this.dfltPaths.last().defaultType
    -- Load defaults from file
    !this.loadFile()
  else
    !this.dfltArea = |PDMS|
  endif

endmethod
-- End of method definition for .catPipeTableCodes()

------------------------------------------------------------------------
--
-- Method:      loadFile
--
-- Description: Load pipe table codes from defaults file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadFile()

  -- Load defaults into temporary defaults array
  if (!this.dfltFile.unset()) then
    return
  else
    -- Load temporary defaults array
    !!runMacro(!this.dfltFile.fullname(), '')
    handle any
    endhandle
  endif

  -- Save codes
  !this.scheduleCodes.clear()
  !this.branchCodes.clear()
  !this.reducerCodes.clear()
  !this.tappingCodes.clear()
  !this.reduGreyAreaReadOnly = FALSE
  !this.branGreyAreaReadOnly = FALSE
  !this.tappGreyAreaReadOnly = FALSE

  do !val values !!tmpCatScheduleCodes
    !this.scheduleCodes.append(!val)
  enddo
  do !val values !!tmpCatBranchCodes
    !this.branchCodes.append(!val)
  enddo
  do !val values !!tmpCatReducerCodes
    !this.reducerCodes.append(!val)
  enddo
  do !val values !!tmpCatTappingCodes
    !this.tappingCodes.append(!val)
  enddo

  if (defined(!!tmpCatReducerReadOnlyArea)) then
    if(!!tmpCatReducerReadOnlyArea.set()) then
      !this.reduGreyAreaReadOnly = !!tmpCatReducerReadOnlyArea
    endif
    !!tmpCatReducerReadOnlyArea.delete()
  endif

  if (defined(!!tmpCatTappingReadOnlyArea)) then
    if(!!tmpCatTappingReadOnlyArea.set()) then
      !this.tappGreyAreaReadOnly = !!tmpCatTappingReadOnlyArea
    endif
    !!tmpCatTappingReadOnlyArea.delete()
  endif

  if (defined(!!tmpCatBranchReadOnlyArea)) then
    if (!!tmpCatBranchReadOnlyArea.set()) then
      !this.branGreyAreaReadOnly = !!tmpCatBranchReadOnlyArea
    endif
    !!tmpCatBranchReadOnlyArea.delete()
  endif

  -- Delete temporary default arrays
  if (defined(!!tmpCatScheduleCodes)) then
    !!tmpCatScheduleCodes.delete()
  endif
  if (defined(!!tmpCatBranchCodes)) then
    !!tmpCatBranchCodes.delete()
  endif
  if (defined(!!tmpCatReducerCodes)) then
    !!tmpCatReducerCodes.delete()
  endif
  if (defined(!!tmpCatTappingCodes)) then
    !!tmpCatTappingCodes.delete()
  endif

endmethod
-- End of method definition for .loadFile()

------------------------------------------------------------------------
--
-- Method:      loadFile
--
-- Description: Load pipe table codes from defaults file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Default area (PDMS, PROJ, or USER)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadFile(!area is STRING)

  -- Load defaults into temporary defaults array
  !pathKey = !area.upcase()
  !dfltFile = object FILE()
  do !ind indices !this.dfltPaths
    if (!this.dfltPaths[!ind].defaultType eq !pathKey) then
      !dfltFile = !this.dfltPaths[!ind].file
      break
    endif
  enddo
  if (!dfltFile.unset()) then
    return error 1 |Unable to locate pipe table codes default file for $!<area>!|
  else
    !this.dfltFile = !dfltFile
    !this.dfltArea = !pathKey
    !this.loadFile()
  endif

endmethod
-- End of method definition for .loadFile(STRING)

------------------------------------------------------------------------
--
-- Method:      saveFile
--
-- Description: Save storage areas to defaults file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Default area (PDMS, PROJ, or USER)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveFile(!area is STRING)

  -- Construct environment variable for file path
  !pathKey = !area.upcase()
  if (!pathKey eq |PDMS|) then
    !evar = 'PDMSDFLTS'
  elseif (!pathKey eq |PROJ|) then
    !project = current project
    !evar = !project.code() & 'DFLTS'
  elseif (!pathKey eq |USER|) then
    !evar = 'PDMSUSER'
  else
    return error 1 |Invalid path Key for file area, you must specify PDMS, PROJ or USER!|
  endif
  -- Test if environment variable is set
  var !evarTest evar $!<evar>
  if (!evarTest.empty()) then
    return error 1 |Environment variable $!<evar> is unset!|
  endif
  -- Check that the directory path does exist
  !path = '%' & !evar & '%\'
  !directory = object FILE(!path)
  if (!directory.exists().not()) then
    return error 1 |Can't find directory $!<directory>, pipe table codes default file will not be saved!|
  endif
  -- Create file object
  !file = object FILE(!path & !this.fileName)

  -- Compile lines for file
  -- File header
  !lines = ARRAY()
  !lines.append(|-- Data file containing default pipe table codes in Paragon|)
  -- Schedule codes
  if (!this.scheduleCodes.size() ne 0) then
    !lines.append(||)
    !lines.append(|-- Schedule codes|)
    !lines.append(|!!tmpCatScheduleCodes = ARRAY()|)
    do !val values !this.scheduleCodes
      !lines.append(|!!tmpCatScheduleCodes.append('| & !val & |')|)
    enddo
  endif
  -- Branch codes
  if (!this.branchCodes.size() ne 0) then
    !lines.append(||)
    !lines.append(|-- Branch codes|)
    !lines.append(|!!tmpCatBranchCodes = ARRAY()|)
    do !val values !this.branchCodes
      !lines.append(|!!tmpCatBranchCodes.append('| & !val & |')|)
    enddo
  endif
  -- Reducer codes
  if (!this.reducerCodes.size() ne 0) then
    !lines.append(||)
    !lines.append(|-- Reducer codes|)
    !lines.append(|!!tmpCatReducerCodes = ARRAY()|)
    do !val values !this.reducerCodes
      !lines.append(|!!tmpCatReducerCodes.append('| & !val & |')|)
    enddo
  endif

  -- Tapping codes
  if (!this.tappingCodes.size() ne 0) then
    !lines.append(||)
    !lines.append(|-- Tapping codes|)
    !lines.append(|!!tmpCatTappingCodes = ARRAY()|)
    do !val values !this.tappingCodes
      !lines.append(|!!tmpCatTappingCodes.append('| & !val & |')|)
    enddo
  endif

  -- Write the file
  !file.writefile('WRITE', !lines)
  handle (160,44)
    -- User doesn't want to overwrite
  elsehandle none
    -- Reload search paths in case this is a new file
    !this.dfltPaths = !!searchpaths(!this.fileName)
    -- Set file details
    !this.dfltFile = !file
    !this.dfltArea = !pathKey
  endhandle

endmethod
-- End of method definition for .saveFile(STRING)

------------------------------------------------------------------------
--
-- Method:      setCodes
--
-- Description: Set the specified codes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of code (SCHEDULE, BRANCH, or REDUCER)
--    2   R      ARRAY       Codes for the specified type
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCodes(!type is STRING, !codes is ARRAY)

  if (!type.upcase() eq |SCHEDULE|) then
    !this.scheduleCodes = !codes
  elseif (!type.upcase() eq |BRANCH|) then
    !this.branchCodes = !codes
  elseif (!type.upcase() eq |REDUCER|) then
    !this.reducerCodes = !codes
  elseif (!type.upcase() eq |TAPPING|) then
    !this.tappingCodes = !codes
  else
    return error 1 |Invalid code Key, you must specify SCHEDULE, BRANCH REDUCER or TAPPING!|
  endif

endmethod
-- End of method definition for .setCodes(STRING, ARRAY)

------------------------------------------------------------------------
--
-- Method:      getCodes
--
-- Description: Return the codes for the specified type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of code (SCHEDULE, BRANCH or REDUCER)
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Codes for the specified type
--
------------------------------------------------------------------------
define method .getCodes(!type is STRING) is ARRAY

  if (!type.upcase() eq |SCHEDULE|) then
    return !this.scheduleCodes
  elseif (!type.upcase() eq |BRANCH|) then
    return !this.branchCodes
  elseif (!type.upcase() eq |REDUCER|) then
    return !this.reducerCodes
  elseif (!type.upcase() eq |TAPPING|) then
    return !this.tappingCodes
  else
    return error 1 |Invalid code Key, you must specify SCHEDULE, BRANCH or REDUCER!|
  endif

endmethod
-- End of method definition for .getCodes(STRING)ARRAY

------------------------------------------------------------------------
--
-- Method:      clearCode
--
-- Description: Clear codes for the specified type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of code (SCHEDULE, BRANCH or REDUCER)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearCodes(!type is STRING)

  if (!type.upcase() eq |SCHEDULE|) then
    !this.scheduleCodes.clear()
  elseif (!type.upcase() eq |BRANCH|) then
    !this.branchCodes.clear()
  elseif (!type.upcase() eq |REDUCER|) then
    !this.reducerCodes.clear()
  elseif (!type.upcase() eq |TAPPING|) then
    !this.tappingCodes.clear()
  else
    return error 1 |Invalid code Key, you must specify SCHEDULE, BRANCH, REDUCER or TAPPING!|
  endif

endmethod
-- End of method definition for .clearCodes(STRING)

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .globalInstance()

  -- Create Global Variable
  !!catPipeTableCodes = !this

endmethod
-- End of method definition for .globalInstance()
