--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(GADGET)                    -
--  catPtseElement()                 -
--  confirmedDelete()                -
--  copy(GADGET)                     -
--  createNew(FORM,STRING)           -
--  delete(GADGET)                   -
--  globalInstance()                 -                   Create global instance of object
--  setEdit(DBREF,GADGET)            -
--  setFrame(FORM,DBREF)             -
--  setRefs(DBREF,GADGET)            -                   Get the members of the current PTREF and fill out the form.
--
define object CATPTSEELEMENT
----------------------------------------------------------------------

  -- P-point list members
  member .headings       is ARRAY
  member .columns        is ARRAY
  member .rtext          is ARRAY
  member .members        is ARRAY
  member .currentType    is STRING
  -- Saved reference to gadget used to select item to delete
  -- Necessary because of delete confirmation dialogue callback
  member .savedDeleteGadget is GADGET

endobject
-- End of object definition for catPtseElement

----------------------------------------------------------------------
define method .catPtseElement()
----------------------------------------------------------------------

  !this.headings[1] = 'Numb'
  !this.headings[2] = 'Type'

endmethod
-- End of object definition for catPtseElement
------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method

------------------------------------------------------------------------
define method .globalInstance()
------------------------------------------------------------------------

  -- Create Global Variable
  !!catPtseElement = !this

endmethod

------------------------------------------------------------------------
--
-- Method:      setRefs
--
-- Description: Get the members of the current PTREF and fill out the form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method

-------------------------------------------------------------------------------------------------------
define method .setRefs(!element is DBREF, !gadget is GADGET)
-------------------------------------------------------------------------------------------------------
-- Get the members for the given PTSE element and populate the form with these values.

-- Check to see if we are adding to an existing points list, or starting one
if (!element.type ne 'PTSE' ) then
    !this.members = !element.member
else
    !this.members = !element.member
endif

!this.rtext.clear()
!this.columns.clear()

!this.columns[1] = ARRAY()
!this.columns[2] = ARRAY()

do !i value !this.members
   !this.columns[1].append(!i.number.string())
   !this.columns[2].append(!i.type)
   !this.rtext.append(!i.string())
enddo


!gadget.setHeadings(!this.headings)
!gadget.setColumns (!this.columns)
!gadget.rtext     = !this.rtext
!form             = !gadget.owner()

-- Now call the reference for the first in the list.
!this.setEdit(!this.rtext[1].dbref(),!gadget)
   handle (2,752)
     -- Mean we haven't any ppoints, likely new element.
     -- Best we hide all the forms, until the user defines one
     !form.ppaxial.visible = FALSE
     !form.ppmixed.visible = FALSE
     !form.ppcart.visible  = FALSE
     !form.ppptpos.visible = FALSE
   endhandle

!!catmodelviewsGetList(!gadget, 'SELECT')

-- Add elements to tracking list.
!form = !gadget.owner()
!form.getElement.addToTrack(!form, !this.rtext, 4)

endmethod

-------------------------------------------------------------------------------------------------------
define method .setEdit(!element is DBREF, !gadget is GADGET)
-------------------------------------------------------------------------------------------------------
-- Having the gadget get entry and set the form edit up ready for use to change things if required.

!form = !gadget.owner()

-- Set correct frame to be visible, and fill in specific attributes.
!this.setFrame(!form,!element)

-- Set the form fields with values.
!!catModelViews.setFormFields(!form, !element)

!form.ptse.currentType = !!ce.type

endmethod

-------------------------------------------------------------------------------------------------------
define method .setFrame(!form is FORM, !element is DBREF)
-------------------------------------------------------------------------------------------------------
-- Having the gadget get entry and set the form edit up ready for use to change things if required.

!form.ptse.currentType =  !element.type

    !form.ppaxial.visible = FALSE
    !form.ppcart.visible  = FALSE
    !form.ppmixed.visible = FALSE
    !form.ppptpos.visible = FALSE

if (!element.type.eq('PTAX')) then
-- PTAX

    !form.ppaxial.visible = TRUE

elseif (!element.type.eq('PTCA')) then
-- PTCA

    !form.ppcart.visible  = TRUE

elseif (!element.type.eq('PTMI')) then
-- PTMI

    !form.ppmixed.visible = TRUE

elseif (!element.type.eq('PTPOS')) then
-- PTPOS

    !form.ppptpos.visible = TRUE

endif

endmethod

-------------------------------------------------------------------------------------------------------
define method .createNew(!form is FORM, !type is STRING)
-------------------------------------------------------------------------------------------------------
!save = !!ce
-- Having the gadget get entry and set the form edit up ready for use to change things if required.

-- First off set the current element to that selected in the points list, for continuity.
!!ce = !form.ptrefList.selection().dbref()
  handle (2,822)
    -- Cannot derive the point set from the P-point list - use the component reference
    !!ce = !form.component.ptre
    handle any
      !!alert.error('Point Set element not found for this category')
      !!ce = !save
      return
    endhandle
  endhandle

!currentPosition = !form.ptrefList.val

-- Turn off AutoNaming if switched on.
    !turnNamingOn = FALSE
if (!!namOptEdit.data.auto) then
    !!namOptEdit.data.auto = FALSE
    !turnNamingOn = TRUE
endif

-- Only allow creation if write access.
if (!!catModelViews.createNewElement(!type,'AUTONAME')) then
    -- Now refresh the list and make that the current selection.
    !form.ptse.setRefs(!!ce.owner, !form.ptrefList)
    !form.ptrefList.val = !currentPosition + 1
    !form.ptse.setEdit(!!ce,!form.ptrefList)
endif

-- Turn it back on again, if required.
if (!turnNamingOn) then
    !!namOptEdit.data.auto = TRUE
endif

-- Return to element if we moved away from it coming into this routine.
!!ce = !save

--reselect the list we have just come from and adjust selection.
!form.ptrefList.val = !currentPosition + 1
!!catmodelviewsGetList(!form.ptrefList, 'SELECT')

endmethod

---------------------------------------------------------------------------------------------------
define method .copy(!list is GADGET)
---------------------------------------------------------------------------------------------------
-- Having the gadget get entry and set the form edit up ready for use to change things if required.

!form = !list.owner()

-- First off set the current element to that selected in the points list, for continuity.
!!ce = !list.selection().dbref()
    handle (2,822)
      -- Nothing selected to copy
      !!alert.error('Cannot perform copy - selection is invalid')
      return
    endhandle
!currentPosition = !list.val

-- Get type.
   !type = !!ce.type

-- Turn off AutoNaming if switched on.
    !turnNamingOn = FALSE
if (!!namOptEdit.data.auto) then
    !!namOptEdit.data.auto = FALSE
    !turnNamingOn = TRUE
endif

if (!!catModelViews.createNewElement(!type,'COPY')) then
    -- Now refresh the list and make that the current selection.
    !form.ptse.setRefs(!!ce.owner, !form.ptrefList)
    !form.ptrefList.val = !currentPosition + 1
    !form.ptse.setEdit(!!ce,!form.ptrefList)
    !!catmodelviewsGetList(!form.ptrefList, 'SELECT')
endif

-- Turn it back on again, if required.
if (!turnNamingOn) then
    !!namOptEdit.data.auto = TRUE
endif

endmethod
------------------------------------------------------------------------------------------------------------------------
define method .delete(!gadget is GADGET)
------------------------------------------------------------------------------------------------------------------------
-- Delete the selected DATA element in hierarchy and repopulate form.

  -- Get element selected for delete
  !element = !gadget.selection().dbref()
  handle (2,822)
    !!alert.error('Nothing to delete')
    return
  endhandle

  -- handle unset DBREF caused by clicking on selection being empty
  if( !element.unset() ) then
    !!alert.error('Empty list: Nothing to delete')
    return
  endif

  -- save gadget for form update callback
  !this.savedDeleteGadget = !gadget

  -- verify delete and delete element
  -- This will call back to the .confirmedDelete() method if the delete is successful
  !!catDeleteManager.deleteElement(!element,!this)

endmethod

------------------------------------------------------------------------------------------------------------------------
define method .confirmedDelete()
------------------------------------------------------------------------------------------------------------------------
-- TAKE CARE. This is a callback for the paragon delete confirm dialogue
-- Delete the selected element in hierarchy and repopulate form
-- Only called if delete is successful and form needs to be updated

  -- Get details of form gadget used to select element to delete
  !form     = !this.savedDeleteGadget.owner()
  !selected = !this.savedDeleteGadget.val

  -- Refresh Form Variables and list.
  !!catSetCateReferences(!form.compAttribList, 'SELECT')

  -- Re-assign the selected gadget to one less than we had, as one has just been deleted.
  !this.savedDeleteGadget.val = !selected - 1
   handle (61,620)
     -- Handle the situation where we select the zero field.
     !this.savedDeleteGadget.val = 1
     handle (61,620)
        -- Handle case where we have just deleted the only entry in the list.
        return
     endhandle
   endhandle

  -- Refresh Form Variables and list.
  !!catmodelviewsGetList(!this.savedDeleteGadget, 'SELECT')

  -- force update graphics
  !drawlist = !!gphDrawlists.drawlist(!form.drawlist)
  handle any
    return
  endhandle
  !drawlist.update()
  handle any
  endhandle

endmethod

-------------------------------------------------------------------------------------------------------
define method .apply(!gadget is GADGET)
-------------------------------------------------------------------------------------------------------
!save = !!ce

-- Set form variable.
!form = !gadget.owner()

-- Remember Selected position and use later to reselect.
!selected = !gadget.val

-- Attach to element selected in the list first, just in case we have moved away.
!!ce = !gadget.selection().dbref()
handle (2,822)
  return
endhandle

-- Set the form fields with values.
!!catModelViews.formApply(!form, !!ce)

-- Refresh Variables and list.
!!catSetCateReferences(!form.compAttribList, 'SELECT')

--reselect the list we have just come from and adjust selection.
!gadget.val = !selected
!!catmodelviewsGetList(!gadget, 'SELECT')

endmethod
