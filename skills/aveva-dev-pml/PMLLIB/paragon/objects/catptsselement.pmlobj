--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(GADGET)                    -
--  catptssElement()                 -
--  copyPLine(GADGET,STRING)         -
--  create(GADGET,STRING,STRING)     -
--  createNewPrim(GADGET,STRING)     -
--  globalInstance()                 -                   Create global instance of object
--  setEdit(DBREF,GADGET)            -
--  setRefs(DBREF,GADGET)            -                   Get the members of the current PTREF and fill out the form.
--
----------------------------------------------------------------------
define object CATPTSSELEMENT
----------------------------------------------------------------------

  -- List of graphical views
  member .headings       is ARRAY
  member .columns        is ARRAY
  member .rtext          is ARRAY
  member .members        is ARRAY
  member .currentType    is STRING

endobject
-- End of object definition for catptssElement

----------------------------------------------------------------------
define method .catptssElement()
----------------------------------------------------------------------

  !this.headings[1] = 'Pkey'
  !this.headings[2] = 'Type'

endmethod
-- End of object definition for catptssElement
------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method

------------------------------------------------------------------------
define method .globalInstance()
------------------------------------------------------------------------

  -- Create Global Variable
  !!catptssElement = !this

endmethod

------------------------------------------------------------------------
--
-- Method:      setRefs
--
-- Description: Get the members of the current PTREF and fill out the form.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method

-------------------------------------------------------------------------------------------------------
define method .setRefs(!element is DBREF, !gadget is GADGET)
-------------------------------------------------------------------------------------------------------
-- Get the members for the given ptss element and populate the form with these values.

!this.members = !element.member
!this.rtext.clear()
!this.columns.clear()

!this.columns[1] = ARRAY()
!this.columns[2] = ARRAY()

do !i value !this.members
   !this.columns[1].append(!i.pkey)
   !this.columns[2].append(!i.type)
   !this.rtext.append(!i.string())
enddo


!gadget.setHeadings(!this.headings)
!gadget.setColumns (!this.columns)
!gadget.rtext     = !this.rtext
!form             = !gadget.owner()

-- Now set the attributes in the form.
!!catModelViews.setFormFields(!form, !this.rtext[1].dbref())
handle (2,752)
  -- Array 1 does not exist, likely no members.
endhandle

endmethod

-------------------------------------------------------------------------------------------------------
define method .setEdit(!element is DBREF, !gadget is GADGET)
-------------------------------------------------------------------------------------------------------
-- Having the gadget get entry and set the form edit up ready for use to change things if required.

!form = !gadget.owner()

-- Set correct frame to be visible, and fill in specific attributes.
!form.plineFrame.visible = TRUE
!form.ptss.currentType = !element.type

-- Fill in the attributes for the appropriate frame.
!!catModelViews.setFormFields(!form, !element)

endmethod

-------------------------------------------------------------------------------------------------------
define method .createNewPrim(!gadget is GADGET, !type is STRING)
-------------------------------------------------------------------------------------------------------

  -- Create a new PLINE
  !this.create(!gadget, !type, 'AUTONAME')

endmethod

-------------------------------------------------------------------------------------------------------
define method .copyPLine(!gadget is GADGET, !type is STRING)
-------------------------------------------------------------------------------------------------------

  -- create copy of PLINE
  !this.create(!gadget, !type, 'COPY')

endmethod

-------------------------------------------------------------------------------------------------------
define method .create(!gadget is GADGET, !type is STRING, !action is STRING)
-------------------------------------------------------------------------------------------------------
!save = !!ce
-- Having the gadget get entry and set the form edit up ready for use to change things if required.

!form = !gadget.owner()

-- First off set the current element to that selected in the points list, for continuity.
!!ce = !form.plineList.selection().dbref()
  handle (2,822)
    -- Cannot derive the point set from the P-point list - use the component reference
    !!ce = !form.component.pstref
    handle any
      !!alert.error('P-Line Set element not found for this category')
      !!ce = !save
      return
    endhandle
  endhandle

-- Remember where we are in the list.
!currentPosition = !form.plineList.val

-- Go create a new element if we can.
if( !!catModelViews.createNewElement(!type,!action) ) then
  -- default to tube flag on new element
  if( !action.upcase() neq 'COPY' ) then
    TUFLAG TRUE
    handle any
    endhandle
  endif
  -- Set the current element type.
  !form.ptss.currentType = !type
  -- Now refresh the list and make that the current selection.
  !form.ptss.setRefs(!!ce.owner, !form.plineList)
  !form.plineList.val = !currentPosition + 1
  !form.ptss.setEdit(!!ce,!form.plineList)
  !!catmodelviewsGetList(!form.plineList, 'SELECT')
endif

-- Return to element if we moved away from it coming into this routine.
!!ce = !save
endmethod

-------------------------------------------------------------------------------------------------------
define method .apply(!gadget is GADGET)
-------------------------------------------------------------------------------------------------------
-- Apply callback for pline apply button from form.

!form = !gadget.owner()

-- Set current element to that passed into this method.
!!ce = !gadget.selection().dbref()

-- Apply the current fields from the form.
!!catModelViews.formApply(!form,!!ce)

-- Refresh the pline list as current list contents.
!val = !form.plineList.val
!form.ptss.setRefs(!!ce.owner, !form.plineList)
!form.plineList.val = !val
!!catmodelviewsGetList(!form.plineList, 'SELECT')

endmethod
