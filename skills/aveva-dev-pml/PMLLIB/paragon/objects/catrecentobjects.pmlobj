--
--
-- Description:
-- List of recently worked on objects
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(ANY)                         -                   Add object to list
--  clear()                          -                   Clear list
--  dtext()                          ARRAY               Return dtext (array of dbref names) for option gadget
--  dtext(STRING)                    ARRAY               Return dtext (array of dbref names) for option gadget
--  globalInstance()                 -                   Create global instance of object
--  inset(STRING,STRING)             BOOLEAN             Test if string1 is in set of strings2
--  list()                           ARRAY               Return all dbrefs in list
--  list(STRING)                     ARRAY               Return dbrefs of given types in list
--  objects()                        ARRAY               Return all objects in list
--  objects(STRING)                  ARRAY               Return all objects of given types in list
--  pop()                            ANY                 Pop object as if off a stack
--  remove(ANY)                      -                   Remove object from list
--  rtext()                          ARRAY               Return rtext (array of db ref number strings) for option gadget
--  rtext(STRING)                    ARRAY               Return rtext (array of db ref number strings) for option gadget
--
------------------------------------------------------------------------

-- Define object
define object catRecentObjects

  -- List of objects
  member .recentObjects    is ARRAY

endobject
-- End of object definition for catRecentObjects

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .globalInstance()

  -- Create Global Variable
  !!catRecentObjects = !this

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add object to list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Any object being worked on
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .add(!object is ANY)

  -- Add object to end of list
  !this.remove(!object)
  !this.recentObjects.append(!object)

endmethod

-- End of method definition for .add(ANY)

------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: Remove object from list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         Any object being worked on
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .remove(!object is ANY)

  -- Remove object from list
  --!found = !this.recentObjects.findFirst(!object)
  -- Can't use findFirst on array of mixed objects so check types first then check equivalence
  !found = REAL()
  do !i indices !this.recentObjects
    if (!this.recentObjects[!i].objectType() eq !object.objectType()) then
      if (!this.recentObjects[!i] eq !object) then
        !found = !i
      endif
    endif
  enddo
  if (!found.set()) then
    !this.recentObjects[!found].delete()
  endif

endmethod

-- End of method definition for .remove(ANY)

------------------------------------------------------------------------
--
-- Method:      pop
--
-- Description: Pop object as if off a stack
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ANY         Object at end of list
--
------------------------------------------------------------------------

-- Define method
define method .pop() is ANY

  -- Remove latest object and return it
  !object = !this.recentObjects.last()
  !this.remove(!object)
  return !object

endmethod

-- End of method definition for .pop() is ANY

------------------------------------------------------------------------
--
-- Method:      objects
--
-- Description: Return all objects in list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       All recent objects
--
------------------------------------------------------------------------

-- Define method
define method .objects() is ARRAY

  -- Return list of objects
  !this.recentObjects.compress()
  return !this.recentObjects

endmethod
-- End of method definition for .objects() is ARRAY

------------------------------------------------------------------------
--
-- Method:      objects
--
-- Description: Return all objects of given types in list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Object types
-- Return:
--   [Data Type] [Description]
--    ARRAY       All recent objects of given object types
--
------------------------------------------------------------------------

-- Define method
define method .objects(!types is STRING) is ARRAY

  -- Return list of objects
  !objects = ARRAY()
  do !object values !this.objects()
    if (!this.inset(!object.objectType(), !types)) then
      !objects.append(!object)
    endif
  enddo
  return !objects

endmethod
-- End of method definition for .objects(STRING) is ARRAY

------------------------------------------------------------------------
--
-- Method:      list
--
-- Description: Return all dbrefs in list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       All dbrefs from recent objects
--
------------------------------------------------------------------------

-- Define method
define method .list() is ARRAY

  -- Return list of dbrefs
  !dbrefs = ARRAY()
  do !object values !this.objects()
    if (!object.objectType() eq |DBREF|) then
      !dbrefs.append(!object)
    endif
  enddo
  return !dbrefs

endmethod
-- End of method definition for .list() is ARRAY

------------------------------------------------------------------------
--
-- Method:      list
--
-- Description: Return dbrefs of given types in list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element types
-- Return:
--   [Data Type] [Description]
--    ARRAY       All dbrefs from recent objects
--
------------------------------------------------------------------------

-- Define method
define method .list(!types is STRING) is ARRAY

  -- Return list of dbrefs of given type
  !dbrefs = ARRAY()
  do !object values !this.list()
    if (!object.badref().not()) then
      if (!this.inset(!object.type, !types)) then
      !dbrefs.append(!object)
      endif
    endif
  enddo
  return !dbrefs

endmethod
-- End of method definition for .list() is ARRAY

------------------------------------------------------------------------
--
-- Method:      dtext
--
-- Description: Return dtext (array of dbref names) for option gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Dtext for option gadget
--
------------------------------------------------------------------------

-- Define method
define method .dtext() is ARRAY

  -- Return list of dbrefs
  !dbrefs = !this.list().invert()
  return !dbrefs.evaluate(object block(|!dbrefs[!evalindex].flnn|))

endmethod
-- End of method definition for .dtext() is ARRAY

------------------------------------------------------------------------
--
-- Method:      dtext
--
-- Description: Return dtext (array of dbref names) for option gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element types
-- Return:
--   [Data Type] [Description]
--    ARRAY       Dtext for option gadget
--
------------------------------------------------------------------------

-- Define method
define method .dtext(!types is STRING) is ARRAY

  -- Return list of dbrefs
  !dbrefs = !this.list(!types).invert()
  return !dbrefs.evaluate(object block(|!dbrefs[!evalindex].flnn|))

endmethod
-- End of method definition for .dtext(STRING) is ARRAY

------------------------------------------------------------------------
--
-- Method:      rtext
--
-- Description: Return rtext (array of db ref number strings) for option gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY       Rtext for option gadget
--
------------------------------------------------------------------------

-- Define method
define method .rtext() is ARRAY

  -- Return list of dbrefs
  !dbrefs = !this.list().invert()
  return !dbrefs.evaluate(object block(|!dbrefs[!evalindex].ref.string()|))

endmethod
-- End of method definition for .rtext() is ARRAY

------------------------------------------------------------------------
--
-- Method:      rtext
--
-- Description: Return rtext (array of db ref number strings) for option gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Element types
-- Return:
--   [Data Type] [Description]
--    ARRAY       Rtext for option gadget
--
------------------------------------------------------------------------

-- Define method
define method .rtext(!types is STRING) is ARRAY

  -- Return list of dbrefs
  !dbrefs = !this.list(!types).invert()
  return !dbrefs.evaluate(object block(|!dbrefs[!evalindex].ref.string()|))

endmethod
-- End of method definition for .rtext(STRING) is ARRAY

------------------------------------------------------------------------
--
-- Method:      clear
--
-- Description: Clear list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .clear()

  -- Clear list
  !this.recentObjects.clear()

endmethod
-- End of method definition for .clear()

------------------------------------------------------------------------
--
-- Method:      inset
--
-- Description: Test if string1 is in set of strings2
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      String to test for presence in set
--    2   R      STRING      Space delimited set of strings
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if string is in set
--
------------------------------------------------------------------------

-- Define method
define method .inset(!string is STRING, !setOfStrings is STRING) is BOOLEAN

  -- Equivalent of inset function without need for comma delimited individual strings
  !inset = false
  do !memberOfSet values !setOfStrings.upcase().split()
    if (!string.upcase() eq !memberOfSet) then
      !inset = true
    endif
  enddo
  return !inset

endmethod
-- End of method definition for .inset(STRING, STRING) is BOOLEAN
