-- End of method definition for .checkType()

------------------------------------------------------------------------
--
-- Method:      isHighLevelElement
--
-- Description: Check the type is a high level storage element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if high level storage element
--
------------------------------------------------------------------------
-- Define method
define method .isHighLevelElement(!type is STRING) is BOOLEAN

  -- Check if type is high level storage element
  !result = FALSE
  !index = !this.elementTypes.findFirst(!type)
  if (!index.set()) then
    !result = (!index ge !this.highLevelStart and !index le !this.highLevelEnd)
  endif
  return !result

endmethod
-- End of method definition for .isHighLevelElement(STRING) is BOOLEAN

------------------------------------------------------------------------
--
-- Method:      isLowLevelElement
--
-- Description: Check the type is a low level storage element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if low level storage element
--
------------------------------------------------------------------------
-- Define method
define method .isLowLevelElement(!type is STRING) is BOOLEAN

  -- Check if type is low level storage element
  !result = FALSE
  !index = !this.elementTypes.findFirst(!type)
  if (!index.set()) then
    !result = (!index ge !this.lowLevelStart and !index le !this.lowLevelEnd)
  endif
  return !result

endmethod
-- End of method definition for .isLowLevelElement(STRING) is BOOLEAN

------------------------------------------------------------------------
--
-- Method:      isCreatableElement
--
-- Description: Check the type is a creatable element for storage area purposes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if creatable element
--
------------------------------------------------------------------------
-- Define method
define method .isCreatableElement(!type is STRING) is BOOLEAN

  -- Check if type is creatable element
  !result = FALSE
  !index = !this.elementTypes.findFirst(!type)

  if (!index.set()) then
    !result = (!index ge !this.creatableStart and !index le !this.creatableEnd)
  endif
  return !result

endmethod
-- End of method definition for .isCreatableElement(STRING) is BOOLEAN

------------------------------------------------------------------------
--
-- Method:      getLongType
--
-- Description: Return long type for element type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type
-- Return:
--   [Data Type] [Description]
--    STRING      Long type
--
------------------------------------------------------------------------
-- Define method
define method .getLongType(!type is STRING) is STRING

  -- Get long type
  !result = object STRING()
  !index = !this.elementTypes.findFirst(!type)
  if (!index.set()) then
    !result = !this.longTypes[!index]
  endif
  return !result

endmethod
-- End of method definition for .getLongType(STRING) is STRING

------------------------------------------------------------------------
--
-- Method:      getOwnerType
--
-- Description: Return owner type for element type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type
-- Return:
--   [Data Type] [Description]
--    STRING      Owner type
--
------------------------------------------------------------------------
-- Define method
define method .getOwnerType(!type is STRING) is STRING

  -- Get owner type
  !result = object STRING()
  !index = !this.elementTypes.findFirst(!type)
  if (!index.set()) then
    !result = !this.ownerTypes[!index]
  endif
  return !result

endmethod
-- End of method definition for .getOwnerType(STRING) is STRING

------------------------------------------------------------------------
--
-- Method:      getRefDataType
--
-- Description: Return RefData type for element type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type
-- Return:
--   [Data Type] [Description]
--    STRING      RefData type name
--
------------------------------------------------------------------------
-- Define method
define method .getRefDataType(!type is STRING) is STRING

  -- Get RefData type
  !result = object STRING()
  !index = !this.elementTypes.findFirst(!type)
  if (!index.set()) then
    !result = !this.refDataTypes[!index]
  endif

  return !result

endmethod
-- End of method definition for .getRefDataType(STRING) is STRING

------------------------------------------------------------------------
--
-- Method:      highLevelType
--
-- Description: Return high level storage type for element type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type
-- Return:
--   [Data Type] [Description]
--    STRING      High level storage type name
--
------------------------------------------------------------------------
-- Define method
define method .highLevelType(!type is STRING) is STRING

  -- Get high level storage type
  !result = object STRING()
  if (!this.isHighLevelElement(!type)) then
    !result = !type
  else
    !ownerType = !this.getOwnerType(!type)
    if (!this.isHighLevelElement(!ownerType)) then
      !result = !ownerType
    elseif (!ownerType eq |TABGRO|) then
      !result = |SPWL|
    elseif (!ownerType inset(|SECT|, |STSE|, |SECT STSE|)) then
      !result = |CATA|
    endif
  endif
  return !result

endmethod
-- End of method definition for .highLevelType(STRING) is STRING

------------------------------------------------------------------------
--
-- Method:      .canCreate()
--
-- Description: Check if element can be created
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if creatable element
--
------------------------------------------------------------------------
define method .canCreate(!type is STRING) is BOOLEAN

  -- Check if type can be created at or above CE
  !result = TRUE
  !list = ARRAY()
  !element = !!ce
  do
    !list.appendArray(!element.list)
    break if (!element.type eq |WORL|)
    !element = !element.owner
  enddo
  if (!list.findFirst(!type.upcase()).unset()) then
    !result = FALSE
    !!alert.error(|Cannot create a | & !type & | at this level|)
  endif

  -- Check for write access
  if (!result) then
    if (!!ce.dbwrit.not()) then
      !result = FALSE
      !!alert.error(|You do not have write access to the current element|)
    endif
  endif

  -- Check if creation allowed by DAC
  if (!result) then
    var !userName USER
    !user = object USER(!userName)
    if (!user.access ne |Free|) then
      var !daccre DACCRE $!type
      if (!daccre.boolean().not()) then
        !result = FALSE
        !!alert.error(|You are not allowed to create a | & !type & | here|)
      endif
    endif
  endif

  return !result

endmethod
-- End of method definition for .canCreate()

------------------------------------------------------------------------
--
-- Method:      !toggleLocation()
--
-- Description: Toggle the location for saving rules
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Menu that has been picked
--    2   R      STRING      User action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toggleLocation(!menu is MENU, !action is STRING)

  -- Get the last picked field
  !field = !menu.pickedField

  -- Initialise all gadgets
  !menu.select(|User|,    false)
  !menu.select(|Project|, false)
  !menu.select(|PDMS|,    false)

  -- Select the picked field
  !menu.select(!field, true)
  !this.currentLoc = !field

  -- Disable save options for non-admin users
  if (not $!!cdlnAdmin) then
    !this.form.fileMenu.setActive(|Save|, (not !field inset(|Project|, |PDMS|)))
  endif

endmethod
-- End of method definition for .toggleLocation(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      !save()
--
-- Description: Save the defaults
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .save()

  -- Check if form updates are waiting to be applied
  if (!this.updated) then
    !this.setRefData()
  endif

  -- Get fileName for current location
  if (!this.currentLoc eq |User|) then
    !saveFile = object FILE(|%PDMSUSER%/| & !this.fileName)
  elseif (!this.currentLoc eq |Project|) then
    if (not $!!cdlnAdmin) then
      return error 1 |You must be an administrative user to save project settings|
    endif
    !project = CURRENT PROJECT
    !evar    = !project.evar.subString(1,3) + |DFLTS|
    var !projdflts evar $!evar
    if (!projdflts eq ||) then
      return error 1 |Environment variable $!evar is unset|
    endif
    !saveFile = object FILE(|%| + !evar + |%/| + !this.fileName)
  elseif (!this.currentLoc eq |PDMS|) then
    if (not $!!cdlnAdmin) then
      return error 1 |You must be an administrative user to save PDMSDFLTS settings|
    endif
    !saveFile = object FILE(|%PDMSDFLTS%/| + !this.fileName)
  endif

  -- Initialise array for file contents
  !saveContents = ARRAY()

  -- Write header information
  !saveContents.append(|-- Data file containing default storage areas for reference data by discipline in Paragon|)
  !saveContents.append(|!!tmpcatRefData = ARRAY()|)
  !saveContents.append(||)

  -- Get ref data for each discipline
  do !valDis values !!catRefData.disciplines
    !saveContents.append(|-- | & !valDis)
    do !valType values !!catRefData.formData
      skip if (!valType[1] eq |LINE|)
      !memName = !valDis & !valType[1]
      !memVal  = !this.attribute(!memName)
      !setting = !this.strUnset
      if (!memVal.set()) then
        if (!memVal.badref().not()) then
          !setting = !memVal.name
        endif
      endif
      !saveContents.append('!!tmpcatRefData.append(|' & !memName & !this.delim & !setting & '|)')
    enddo
    !saveContents.append(||)
  enddo

  -- Write out the file
  !saveFile.writeFile(|OVERWRITE|, !saveContents)
  handle (41,319)
    -- Privileges not sufficient
    return error 1 |You do not have write access to $!saveFile|
  elsehandle none
    !!alert.message(!saveFile & | saved successfully|)
  endhandle

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      !load()
--
-- Description: load the defaults
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .load()

  -- Get fileName for current location
  if (!this.currentLoc eq |User|) then
    !loadFile = |%PDMSUSER%/| & !this.fileName
  elseif (!this.currentLoc eq |Project|) then
    !project = CURRENT PROJECT
    !evar    = !project.evar.subString(1,3) + |DFLTS|
    var !projdflts evar $!evar
    if (!projdflts eq ||) then
      return error 1 |Environment variable $!evar is unset|
    endif
    !loadFile = |%| + !evar + |%/| + !this.fileName
  elseif (!this.currentLoc eq |PDMS|) then
    !loadFile = |%PDMSDFLTS%/| + !this.fileName
  endif

  -- Define temporary array for defaults
  !!tmpcatRefData = object ARRAY()

  -- Read defaults into temporary array
  $m "$!loadFile"

  -- Clear member and form settings only after file read with no errors
  do !valDis values !!catRefData.disciplines
    do !valType values !!catRefData.formData
      skip if (!valType[1] eq |LINE|)
      !memName = !valDis & !valType[1]
      !this.attribute(!memName) = object DBREF()
      !this.form.attribute(!this.tKey.after('.') & !memName).val = !this.strUnset
    enddo
  enddo

  -- Process the defaults
  if (!!tmpcatRefData.set()) then
    do !val values !!tmpcatRefData

      -- Get member
      !memName = !val.part(1,!this.delim)
      !this.attribute(!memName) = nulref
      handle any
        -- Must be bad member name
        skip
      endhandle

      -- Get reference
      !eleName = !val.part(2,!this.delim)
      skip if (!eleName eq !this.strUnset)
      !element = object DBREF(!eleName)
      -- handle (2,109)(2,751)(2,813)
      handle any
        -- Bad element name or no name field in defaults file
        skip
      endhandle

      -- Store if valid ref type
      if (!this.checkType(!memName, !element)) then
        !this.attribute(!memName) = !element
        !this.form.attribute(!this.tKey.after('.') & !memName).val = !eleName
      endif

    enddo
  endif

  -- Delete temporary array
  !!tmpcatRefData.delete()

endmethod
-- End of method definition for .load()
