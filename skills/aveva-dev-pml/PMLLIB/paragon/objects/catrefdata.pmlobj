------------------------------------------------------------------------
--
-- Method:      catRefData
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .catRefData()

  -- Defaults file
  !this.fileName   = |cat-refdata.pmldat|
  !this.currentLoc = |User|
  !this.updated    = FALSE

  -- Discipline keys - must be uppercase
  !disciplineStr = |GEN ACCO ELEC EQUI HVAC PIPE STL|
  !this.disciplines = !disciplineStr.split()

  -- Form data for gadget names, tag text, and paragraph text
  !typeStr = |CATE~Categories~CATA|
  !this.formData[1] = !typeStr.split('~')
  !typeStr = |SPEC~Specifications~SPWL|
  !this.formData[2] = !typeStr.split('~')
  !typeStr = |PRTF~Part Families~PRTWLD|
  !this.formData[3] = !typeStr.split('~')
  !typeStr = |CMPD~Component Data~CMPW|
  !this.formData[4] = !typeStr.split('~')
