-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .getDisciplines() is ARRAY

  return !this.disciplines

endmethod
-- End of method definition for .getDisciplines()


------------------------------------------------------------------------
--
-- Method:      getTypes
--
-- Description: return all Type keys
-- for use with .getRefData(!discipline,!type) method
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .getTypes() is ARRAY

  !types = object ARRAY()
  do !ind indices !this.formData
    skip if (!this.formData[!ind][1] eq 'LINE')
    !types.append(!this.formData[!ind][1])
  enddo

  return !types

endmethod
-- End of method definition for .getTypes()


------------------------------------------------------------------------
--
-- Method:      getTypeDescs
--
-- Description: return all type descriptions as shown on the form
