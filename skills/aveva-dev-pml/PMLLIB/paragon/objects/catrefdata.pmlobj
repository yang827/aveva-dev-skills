--
------------------------------------------------------------------------
-- Define method
define method .getTypeDescs() is ARRAY

  !types = object ARRAY()
  do !ind indices !this.formData
    skip if (!this.formData[!ind][1] eq 'LINE')
    !types.append(!this.formData[!ind][2])
  enddo

  return !types

endmethod
-- End of method definition for .getTypeDescs()


------------------------------------------------------------------------
--
-- Method:      getDbTypes
--
-- Description: return all storage area DB types as shown on the form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .getDbTypes() is ARRAY

  !types = object ARRAY()
  do !ind indices !this.formData
    skip if (!this.formData[!ind][1] eq 'LINE')
    !types.append(!this.formData[!ind][3])
