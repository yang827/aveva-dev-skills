------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .globalInstance()

  -- Create Global Variable
  !!catRefData = !this
  !!catRefData.defineForm()

endmethod
-- End of method definition for .globalInstance()


------------------------------------------------------------------------
--
-- Method:      defineForm
--
-- Description: Define form for setting reference data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .defineForm()

  !formName   = |!!catsetrefdata|
  setup form $!formName dialog noalign

    -- Load/Save menu
    bar
      add 'File' .fileMenu
    exit

    path down

    -- Define tab set
    frame .frTabset tabset
      -- Create tab for each discipline
      do !valDis values !!catRefData.disciplines
        !frameName = !!catRefData.fKey & !valDis
        frame $!frameName |$!valDis| at xmin.frTabset ymin.frTabset dock fill
          -- Text input fields for ce names
          do !valType values !!catRefData.formData
            if (!valType[1] eq 'LINE') then
              !lineName = '.LN' & !valDis & !valType[1] & !valType[2]
              line $!lineName horiz width 57 height 1
            else
              !textName = !!catRefData.tKey & !valDis & !valType[1]
              text $!textName tagwid $!!catRefData.tWid |$!valType[2]| callback |!!catRefData.setText(| width 30 is STRING
            endif
          enddo
          -- CE buttons
          do !valType values !!catRefData.formData
            skip if (!valType[1] eq 'LINE')
            !btnName = !!catRefData.bKey & !valDis & !valType[1]
            !textName = !!catRefData.tKey & !valDis & !valType[1]
            button $!btnName |CE| at xmax$!textName$n+1 ymin$!textName callback |!!catRefData.setCe(| width 2
          enddo
          -- Paragraphs for required data type
          do !valType values !!catRefData.formData
            skip if (!valType[1] eq 'LINE')
            !paraName = !!catRefData.pKey & !valDis & !valType[1]
            !btnName = !!catRefData.bKey & !valDis & !valType[1]
            para $!paraName at xmax$!btnName$n+1 ymin$!btnName text |$!valType[3]| width 9
          enddo
        exit
      enddo
    exit


    -- Default, Ok, cancel, apply buttons
    button .default |Default| width 6 callback |!!catRefData.setDefaults()|
    path left
    button .apply |Apply| width 6 at xmax form - size callback |!!catRefData.setRefData()| APPLY
    button .ok |OK| width 6 OK
    button .cancel |Cancel| width 6 CANCEL

  exit
  !form = $!formName
  !!catRefData.form = $!formName

  -- Pseudo constructor
  -- Form details
  !form.formTitle       = |Reference Data|
  !form.iconTitle       = |Ref. Data|
  !form.initCall        = |!!catRefData.formInitialise()|
  !form.okCall          = |!!catRefData.formOk()|
  !form.cancelCall      = |!!catRefData.formCancel()|
  !form.formRevision    = |$Revision: 1.0 $ |

  -- Load/Save menu
  !form.newMenu(|fileMenu|)
  !form.fileMenu.add(|callback|, |Save|, |!!catRefData.save()|)
  !form.fileMenu.add(|callback|, |Load|, |!!catRefData.load()|)
  !form.fileMenu.add(|separator|)
  !form.fileMenu.add(|menu|, |Location|, |locationMenu|)
  !form.newMenu('locationMenu')
  !form.locationMenu.add(|toggle|, |User|,    |!!catRefData.toggleLocation(|)
  !form.locationMenu.add(|toggle|, |Project|, |!!catRefData.toggleLocation(|)
  !form.locationMenu.add(|toggle|, |PDMS|,    |!!catRefData.toggleLocation(|)
  !form.locationMenu.select(|User|, true)

  -- Load defaults even if form never shown
  !!catRefData.setDefaults()

endmethod
-- End of method definition for .globalInstance()


------------------------------------------------------------------------
--
-- Method:      formInitialise
--
-- Description: Initialisation for reference data form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .formInitialise()

  -- Make appropriate tab visible for current application discipline
  !discipline = !!appCntrl.currentApp()
  !this.form.attribute(!this.fKey.after('.') & !discipline).visible = true

endmethod
-- End of method definition for .formInitialise()


------------------------------------------------------------------------
--
-- Method:      setDefaults
--
-- Description: Set default storage areas from default file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .setDefaults()

  -- Load defaults from user, project or pdmsdflts
  !this.currentLoc = |User|
  !this.load()
  handle any
    -- User settings not available so load project settings
    !this.currentLoc = |Project|
    !this.load()
    handle any
      -- Project settings not available so load pdmsdflts
      !this.currentLoc = |PDMS|
      !this.load()
      handle any
        -- Ignore any error
      endhandle
    endhandle
  endhandle

  -- Set menu to where defaults were loaded
  !this.form.locationMenu.select(!this.currentLoc, true)

  -- Form fields are now aligned with member data
  !this.updated = FALSE

endmethod
-- End of method definition for .setDefaults()


------------------------------------------------------------------------
--
-- Method:      formOk
--
-- Description: Ok callback for reference data form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .formOk()

  !this.setRefData()

endmethod
-- End of method definition for .formOk()


------------------------------------------------------------------------
--
-- Method:      formCancel
--
-- Description: Cancel callback for reference data form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .formCancel()

  -- Discard changes so form fields are now aligned with member data
  !this.updated = FALSE

endmethod
-- End of method definition for .formCancel()


------------------------------------------------------------------------
--
-- Method:      setCe
--
-- Description: Callback for all CE buttons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .setCe(!object is GADGET, !action is STRING)

  if (!action eq 'SELECT') then

    -- Get details
    !memName = !object.name().subString(3)
    !ref = !!ce

    -- Check for valid ref type and set text field to name of CE
    if (!this.checkType(!memName, !ref).not()) then
      return error 1 |Invalid element type|
    endif

    -- Set text field
      !this.form.attribute(!this.tKey.after('.') & !memName).val = !ref.name

    -- Mark form data as no longer aligned with member data
    !this.updated = TRUE

  endif

endmethod
-- End of method definition for .setCe()

------------------------------------------------------------------------
--
-- Method:      setText
--
-- Description: Callback for all text fields
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .setText(!object is GADGET, !action is STRING)

  if (!action eq 'SELECT') then

    -- Get details
    !memName = !object.name().subString(3)
    !eleName = !object.val

    -- Check for empty text field
    if (!eleName.unset()) then
      !eleName = !this.strUnset
    elseif (!eleName eq ||) then
      !eleName = !this.strUnset
    endif

    -- Unset ref
    if (!eleName eq !this.strUnset) then
      !object.val = !this.strUnset

    else

    -- Check for valid name
    !ref = object DBREF(!eleName)
    handle(2,107)(2,109)(2,813)
      -- Invalid ref/name
      -- Set name back to the value it had before it was changed
      !lastRef = !this.getRefData(!memName)
      if (!lastRef.badref()) then
        !object.val = !this.strUnset
      else
        !object.val = !lastRef.name
      endif
        return error 1 |Invalid name|
    endhandle

    -- Check for valid ref type for text field
    if (!this.checkType(!memName, !ref).not()) then
      -- Set name back to the value it had before it was changed
      !lastRef = !this.getRefData(!memName)
      if (!lastRef.badref()) then
        !object.val = !this.strUnset
      else
        !object.val = !lastRef.name
      endif
        return error 1 |Invalid element type|
    endif

    endif

    -- Mark form data as no longer aligned with member data
    !this.updated = TRUE

  endif

endmethod
-- End of method definition for .setText()

------------------------------------------------------------------------
--
-- Method:      setRefData
--
-- Description: Set storage area for the passed reference data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .setRefData()

  -- Get all text field names on form
  !formMemNames = !this.form.attributes()
  do !val values !formMemNames
    -- Only process text fields
    if (!val.subString(1,2) eq !this.tKey.after('.')) then
      !text = !this.form.attribute(!val).val
      !memName = !val.subString(3)
      !this.attribute(!memName) = object DBREF()
      if (!text ne !this.strUnset) then
        !this.attribute(!memName) = object DBREF(!text)
        handle any
          -- Ignore if badref
        endhandle
      endif
    endif
  enddo

  -- Form fields are now aligned with member data
  !this.updated = FALSE

endmethod
-- End of method definition for .setRefData()


------------------------------------------------------------------------
--
-- Method:      getRefData
--
-- Description: Get storage area for the passed reference data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .getRefData(!member is STRING) is DBREF

  return !this.attribute(!member)

endmethod
-- End of method definition for .getRefData()


------------------------------------------------------------------------
--
-- Method:      getRefData
--
