------------------------------------------------------------------------
--
-- Method:      checkType
--
-- Description: Check the Type is a valid list type for the Ref
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .checkType(!type is STRING, !ref is DBREF) is BOOLEAN

  return (!this.form.attribute(!this.pKey.after('.') & !type).val.match(!ref.type) gt 0)

endmethod
-- End of method definition for .checkType()


------------------------------------------------------------------------
