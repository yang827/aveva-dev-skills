endmethod
-- End of method definition for .getRefData()


------------------------------------------------------------------------
--
-- Method:      setRefData
--
-- Description: Set storage area for the passed reference data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .setRefData(!discipline is STRING, !type is STRING)

  -- Set current element to the required storage area position, or just return current element and dont
  -- move anywhere if the value is not set.
  !!alert.message(!discipline & ' ' & !type)
--  !this.attribute(!discipline & !type)

endmethod
