define object CATSCOMELEMENT
----------------------------------------------------------------------

  -- List of graphical views
  member .headings       is ARRAY
  member .columns        is ARRAY
  member .dtext          is ARRAY
  member .descriptions   is ARRAY
  member .rtext          is ARRAY
  member .texts          is ARRAY
  member .members        is ARRAY
  member .names          is ARRAY
  member .currentType    is STRING

endobject

----------------------------------------------------------------------
define method .catScomElement()
----------------------------------------------------------------------

-- The alphabet letters needed.
!letterArray[1] = 'A'
!letterArray[2] = 'B'
!letterArray[3] = 'C'
!letterArray[4] = 'D'
!letterArray[5] = 'E'
!letterArray[6] = 'F'
!letterArray[7] = 'G'
!letterArray[8] = 'H'
!letterArray[9] = 'I'
!letterArray[10] = 'J'
!letterArray[11] = 'K'
!letterArray[12] = 'L'
!letterArray[13] = 'M'
!letterArray[14] = 'N'
!letterArray[15] = 'O'
!letterArray[16] = 'P'
!letterArray[17] = 'Q'
!letterArray[18] = 'R'
!letterArray[19] = 'S'
!letterArray[20] = 'T'
!letterArray[21] = 'U'
!letterArray[22] = 'V'
!letterArray[23] = 'W'
!letterArray[24] = 'X'
!letterArray[25] = 'Y'
!letterArray[26] = 'Z'


--Create the Array parameters for the 100 elements need for the PARAM element
-- APAR, BPAR,CPAR,.., ZPAR
  do !i from 1 to 26
   !this.names[!i] = !letterArray[!i] & !letterArray[16] & !letterArray[1] & !letterArray[18]
  enddo
-- AAPA, ABPA,...,ZBPA
  do !i from 27 to 52
   !this.names[!i] = !letterArray[1] & !letterArray[(!i - 26)] & !letterArray[16] & !letterArray[1]
  enddo
-- BAPA, BBPA,...,BAPA
  do !i from 53 to 78
   !this.names[!i] = !letterArray[2] & !letterArray[(!i - 52)] & !letterArray[16] & !letterArray[1]
  enddo
-- CAPA, CBPA,..., CZPA
  do !i from 79 to 104
   !this.names[!i] = !letterArray[3] & !letterArray[(!i - 78)] & !letterArray[16] & !letterArray[1]
  enddo

endmethod

-- End of object definition for catScomElement
-------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------
-- Define method

--------------------------------------------------------------------------
define method .globalInstance()
--------------------------------------------------------------------------

  -- Create Global Variable
  !!catScomElement = !this

endmethod

-- Define method

-------------------------------------------------------------------------------
define method .categoryApply(!form is FORM)
-------------------------------------------------------------------------------

!!ce = !form.categorydbrefno.val.dbref()

 if (!form.catename.val.substring(1,1) ne '=' and !form.catename.val.substring(1,1) ne '/') then
   NAME  /$!form.catename.val
else
   NAME  $!form.catename.val
endif

DESCR |$!form.catedesc.val|
       handle any
       endhandle

PURP   $!form.catepurp.val
       handle any
       endhandle

FUNC  |$!form.catefunc.val|
       handle any
       endhandle

!gtype = !form.categoryField2.selection()
GTYPE $!gtype
       handle (47,62)
         -- Field value not set.
         GTYPE UNSET
         !form.categoryField2.val = 1
       elsehandle (47,15)
         if (!gtype NE !form.categoryField2.selection()) then
           !!alert.error('Invalid generic type')
           !form.categoryField2.val = 1
         endif
       endhandle


PTREF $!form.categoryField3.val

       handle (47,62)
          PTREF NULREF
       elsehandle any
         !!alert.warning(|Invalid point set reference!|)
         return
       endhandle
GMREF $!form.categoryField4.val
       handle (47,62)
          GMREF NULREF
       elsehandle any
         GSTREF $!form.categoryField4.val
         handle (47,62)
           GSTREF NULREF
         elsehandle any
           !!alert.warning(|Invalid geometry set reference!|)
           return
         endhandle
       endhandle


DTREF $!form.categoryField5.val
       handle (47,62)
          DTREF NULREF
       elsehandle any
         !!alert.warning(|Invalid data set reference!|)
         return
       endhandle

if (!!appCntrl.currentApp.eq('STL')) then

    NGMREF $!form.categoryField6.val
        handle (47,62)
          NGMREF NULREF
        elsehandle any
          !!alert.warning(|Invalid negative geometry set reference!|)
          return
        endhandle


    PSTREF $!form.categoryField7.val
        handle (47,62)
          PSTREF NULREF
        elsehandle any
          !!alert.warning(|Invalid structural point set reference!|)
          return
        endhandle

  else

      if (defined(!form.categoryField6)) then
         BLRFARRAY $!form.categoryField6.val
         handle (47,62)
           BLRFARRAY NULREF
         elsehandle any
           !!alert.warning(|Invalid bolt set reference!|)
           return
         endhandle
      endif
  endif

endmethod

-- Define method

-------------------------------------------------------------------------------
define method .apply(!form is FORM)
-------------------------------------------------------------------------------
-- Obsolete description of fields - these vary with discipline
--       text .compField1 ' Description'
--       option .compField2 'Generic Type'
--       text .compField3 ' P-Point Set'
--       text .compField4 'Geometry Set'
--       text .compField5 '    Data Set'
--       text .compField6 '  Bolt Holes'
--       text .compField7 '  Parameters'

-- Nav to correct element.
!!ce = !form.component
!form.formTitle  = !!catModelViews.getFormTitle(!form)

-- Name element
!!catModelViews.nameElement(!form.compField0.val)

!list = !form.getElement.setList(!form,!form.component.type)
if (!list[1] EQ 'None') then
    return
endif
-- Set the references into the store
--!form.getElement.getRefs(!form.component,!list)

-- Set the lists to saved data.
--!form.getElement.setList(!form.compAttribList)

-- Reset the form to reflect any changes.
--  !!catModelViews.setCe(!form.compAttribList, 'SELECT')

DESCR |$!form.compField1.val|

!gtype = !form.compField2.displaytext().trim()

GTYPE $!gtype
    handle (47,62)
      -- Field value not set.
      GTYPE UNSET
      !form.compField2.val = 1
    elsehandle (47,15)
      if (!gtype NE !form.compField2.selection()) then
        !!alert.error('Invalid generic type')
        !form.compField2.val = 1
      endif
    endhandle

-- Do not try to set a PTREF on SPRF element
if( !form.component.type neq 'SPRF' ) then
  PTREF $!form.compField3.val
         handle (47,62)
            PTREF NULREF
         elsehandle any
           !!alert.warning(|Invalid point set reference!|)
           return
         endhandle
endif

if( !!ce.attributes().findfirst('Gmref').set() ) then
      -- Geometry in a component geometry set (GMSE)
GMREF $!form.compField4.val
       handle (47,62)
          GMREF NULREF
       elsehandle any
          !!alert.warning(|Invalid geometry set reference!|)
          return
       endhandle
else
      -- Geometry in a structural geometry set (GMSS)
GSTREF $!form.compField4.val
         handle (47,62)
           GSTREF NULREF
         elsehandle any
           !!alert.warning(|Invalid geometry set reference!|)
           return
         endhandle
endif

DTREF $!form.compField5.val
       handle (47,62)
          DTREF NULREF
       elsehandle any
         !!alert.warning(|Invalid data set reference!|)
         return
       endhandle

if (!!appCntrl.currentApp.eq('STL')) then

  -- Do not try to set a PTREF on SPRF element
  if( !form.component.type neq 'SPRF' ) then
    NGMREF $!form.compField6.val
        handle (47,62)
          NGMREF NULREF
        elsehandle any
          !!alert.warning(|Invalid negative geometry set reference!|)
          return
        endhandle
  endif

  if( !!ce.attributes().findfirst('Pstref').set() ) then
    -- only set P-line reference for those structural elements that have P-lines
    PSTREF $!form.compField7.val
        handle (47,62)
          PSTREF NULREF
        elsehandle any
          !!alert.warning(|Invalid structural PLINE set reference!|)
          return
        endhandle
  endif

elseif (!!appCntrl.currentApp.eq('ACCO')) then

  -- Do not try to set a PTREF on SPRF element
  if( !form.component.type neq 'SPRF' ) then
    NGMREF $!form.compField6.val
        handle (47,62)
          NGMREF NULREF
        elsehandle any
          !!alert.warning(|Invalid negative geometry set reference!|)
          return
        endhandle
  endif


elseif (!!appCntrl.currentApp.eq('ELEC') and !this.currentType eq 'CORE') then

  CCORREF $!form.compField6.val

       handle (47,62)
         CCORREF NULREF
       elsehandle any
         !!alert.warning(|Invalid cable core set reference!|)
         return
       endhandle
else

      if (defined(!form.compField6)) then
         BLRFARRAY $!form.compField6.val
         handle (47,62)
           BLRFARRAY NULREF
         elsehandle any
           !!alert.warning(|Invalid bolt set reference!|)
           return
         endhandle
      endif
endif

!paramString = !form.compParams.val
PARAM $!paramString
  handle (47,62)
  endhandle

-- Set the form title if things have changed.
!form.formTitle  = !!catModelViews.getFormTitle(!form)

-- Set the references into the store
!form.getElement.getRefs(!form.component,!list)

-- Set the lists to saved data.
!form.getElement.setList(!form.compAttribList)

-- Set the form title if things have changed.
!form.formTitle  = !!catModelViews.getFormTitle(!form)

-- Set the parameters list
!form.getElement.getParams(!form.params1,!form.component)

-- Set the reference name too.
!form.dbrefno.val = !form.component.name & | (| & !form.component.type & |)|

endmethod

---------------------------------------------------------------------------------------------------------------------------
define method .checkName(!name is STRING) is BOOLEAN
---------------------------------------------------------------------------------------------------------------------------

!newName = !name

-- Check to see if this object exists.
if (!newName.substring(1,1) ne '/') then
    !newName = '/' & !name
endif

       -- Basic Check name routine.
!unusedCheck = !name.dbref()
handle (2,813) (2,109)
   return false
endhandle

   -- Everything ok, return
   return TRUE

endmethod

---------------------------------------------------------------------------------------------------------------------------
define method .createElement(!gadget is GADGET, !name is STRING, !type is STRING) is DBREF
---------------------------------------------------------------------------------------------------------------------------
!save = !!ce

-- First check to see if the item exists, create if it doesn't
!setName = !name

if (!setName.substring(1,1) ne '/') then
    !setName = '/' & !name
endif

if (!this.checkName(!setName).eq(FALSE)) then

   -- Create this new element and set the field to that just created.

   if (!!catModelViews.createElement(!type)) then
       !!catModelViews.nameElement(!setName)
   endif

endif

   !gadget.val = !setName
   !!ce = !save
   return !setName.dbref()

endmethod

---------------------------------------------------------------------------------------------------------------------------
define method .moveParam(!gadget is GADGET, !direction is STRING)
---------------------------------------------------------------------------------------------------------------------------

-- Set max and min.
!min = 1
!max = !gadget.dtext.size()
!form           = !gadget.owner()

-- Check position to see if movement is wrong solution.
!!ce = !this.texts[!gadget.val]
!pos = !gadget.val

if (!pos EQ !min AND !direction EQ 'UP') then
    !!alert.error('Parameter is already at the start of the list.')
    return
elseif (!pos EQ !max AND !direction EQ 'DN') then
    !!alert.error('Parameter is already at the end of the list.')
    return
endif

!ans = !!alert.confirm('This operation will affect ALL the components in the current category, do you want to continue?')

if (!ans.boolean()) then

  !seq = SEQUENCE

  if (!direction EQ 'DN') then
      !newPos = 'AFTER'
      !newSeq = !seq + 1
  else
      !newPos = 'BEFORE'
      !newSeq = !seq - 1
  endif

  -- Goto owner and change the order of the parameter in the sequence list.
     OWNER
     REORDER $!seq $!newPos $!newSeq

  -- Now cycle round all the components, and re-order the parameters.

  do !comp value !form.cateTable.getcolumn(1)

     !name = !comp
     !element = !name.dbref()

     handle (2,813)
       !name = |/| + !name
     endhandle
     !element = !name.dbref()
     skip if (!element.badref())

     !param   = !element.param

     -- Now organise the list with the parameter moved.
     !para = !param.removeFrom(!pos, 1)

     if (!direction EQ 'DN') then
         !param.insertArray(!pos + 1, !para)
         !listPos = !pos + 1
     else
         !param.insertArray(!pos - 1, !para)
         !listPos = !pos - 1
     endif

     !element.param = !param

  enddo

  -- Refresh the list, to reflect the current order and state.
   !!catModelViews.setCe(!form.compAttribList, 'PARAMCHANGE')
   !form.params1.val = !listPos


endif

endmethod

---------------------------------------------------------------------------------------------------------------------------
define method .displayParam(!gadget is GADGET, !position is REAL)
---------------------------------------------------------------------------------------------------------------------------

  !form            = !gadget.owner()
  !parameterNumber = !gadget.val
  !component       = !form.scom.rtext[!gadget.val]

  !parameterDefinition = object CATPARAMETERSET(!component)
  !form.paramStex.val  = !parameterDefinition.getParameterTitle(!parameterNumber)

endmethod

-----------------------------------------------------------------------------------------
define method .applyParam(!gadget is GADGET)
-----------------------------------------------------------------------------------------
-- Apply parameter values from form fields based on selected parameter.

  !form           = !gadget.owner()
  !currentListPos = !gadget.val
  -- New description
  !text           = !form.paramStex.val
  -- get parameter definition for this component
  !parameterNumber     = !gadget.val
  if( !parameterNumber eq 0 ) then
    !!alert.error( 'Cannot change parameter title because no parameter is selected' )
    return
  endif
  if( !text.trim().empty() ) then
    !reply = !!alert.confirm('Do you want to clear the title of parameter ' + !parameterNumber.string('D0'))
    if( !reply neq 'YES' ) then
      return
    endif
  endif

  -- save CE to restore later so that functions in the bottom panel work correctly
  !savedCE = !!ce

  !parameterDefinition = object CATPARAMETERSET(!form.component)
  -- set parameter description in the DB
  !changed = !parameterDefinition.setParameterTitle(!parameterNumber,!text)
  if( !changed.not() ) then
    !!alert.warning('The system cannot change the Parameter Title because a parameter definition element does not exist or access to it is denied')
  endif


-- Now reload the form reference data with all the current information
  if( badref( !parameterDefinition.getParameterDataRef(!currentListPos) ) ) then
    !!ce = !form.component
  else
    !!ce = !parameterDefinition.getParameterDataRef(!currentListPos).owner
  endif
  !!catModelViews.setCe(!form.compAttribList, 'PARAMCHANGE')

-- Now reselect the next parameter in the list
  !gadget.val = !currentListPos

-- Set the display for the parameter
  !this.displayParam(!gadget, !currentListPos)

-- restore CE one entry to this function
  !!ce = !savedCE

endmethod

-------------------------------------------------------------------------------------------------------------
define method .setParam(!gadget is GADGET, !position is REAL)
-------------------------------------------------------------------------------------------------------------
-- Set parameter form fields based on selected parameter.
  !form = !gadget.owner()

  !parameterNumber     = !gadget.val
  !parameterDefinition = object CATPARAMETERSET(!form.component)
  !form.paramStex.val  = !parameterDefinition.getParameterTitle(!parameterNumber)

-- Set the right frame for visualisation
  !!ce = !form.component
  !form.refData.setFrame('PARAM',!form)

  !form.paramFrame.visible = TRUE

-- Set the display for the parameter
  !this.displayParam(!gadget, !position)

endmethod

---------------------------------------------------------------------------------------------------------------------------
define method .newParam(!gadget is GADGET, !type is STRING)
---------------------------------------------------------------------------------------------------------------------------
-- Create a new or copy an existing parameter.

  !form = !gadget.owner()

-- Grab the current element for when we create a copy.
  !text     = !form.paramStex.val

  -- save CE to restore later so that functions in the bottom panel work correctly
  !savedCE = !!ce

  -- get parameter definition for this component
  !parameterDefinition = object CATPARAMETERSET(!form.component)
  !parameterDefinition.appendParameter(!text)

-- Now reload the form reference data with all the current information.
   !!ce = !form.component
   !!catModelViews.setCe(!form.compAttribList, 'PARAMCHANGE')

   -- restore CE and handle error in case it has been deleted
   !!ce = !savedCE
   handle any
   endhandle

-- Now select the next parameter in the list, the one we just created.
   if( !gadget.dtext.size() gt 0 ) then
     !gadget.val = !gadget.dtext.size()
     -- Set the display for the parameter
     !this.displayParam(!gadget, !gadget.dtext.size())
   endif

endmethod

---------------------------------------------------------------------------------------------------------------------------
define method .delParam(!gadget is GADGET)
---------------------------------------------------------------------------------------------------------------------------
-- Delete an existing parameter.

  !form       = !gadget.owner()
  !currentPos = !gadget.val

  if( !currentPos eq 0 ) then
    !!alert.error('No parameter selected')
    return
  endif
  if( !currentPos eq 1 and !gadget.dtext.size() eq 1 ) then
    -- At least one parameter must remain
    !!alert.error('There must be at least one parameter on each component')
    return
  endif

  -- save CE to restore later so that functions in the bottom panel work correctly
  !savedCE = !!ce

  -- get parameter definition for this component
  !parameterDefinition = object CATPARAMETERSET(!form.component)

  !parameterDefinition.deleteParameter(!currentPos)

-- Now reload the form reference data with all the current information.
   !!ce = !form.component
   !!catModelViews.setCe(!form.compAttribList, 'PARAMCHANGE')

-- Reselect the parameter in front of the one we deleted.
   if (!currentPos gt !gadget.dtext.size()) then
     !currentPos = !gadget.dtext.size()
   endif
   !gadget.val = !currentPos
   handle any
     -- No parameters left to display
   endhandle

   -- restore CE and handle error in case it has been deleted
   !!ce = !savedCE
   handle any
   endhandle

endmethod

-----------------------------------------------------------------------------------------------------------------------------------
define method .modifyParameterValue(!form is FORM, !data is ARRAY)
-----------------------------------------------------------------------------------------------------------------------------------
-- Change the value of a parameter value from the grid control.

-- Set the form to ignore the next tracking message - avoids an Infragistics error from !form.cateTable
  !form.ignoreNextTrack = TRUE

-- Set Current Element (CE) by getting element from grid position 1
  if (!!catModelViews.getNameFromGrid(!form.cateTable.getRow(!data[1])[1]).not()) then
    return
  endif

-- now find out which parameter we are changing.
  !firstParameterColumn = 3
  !whichParam = !form.cateTable.getColumns().findfirst(!data[2]) - !firstParameterColumn + 1
  -- use old syntax to get original value to handle WORD parameters
  VAR !originalValue PARAM $!whichParam
  handle any
    !originalValue = 'unset'
  endhandle

-- Cycle round and only check and change the specified parameter.
if (!form.updateCellVal eq true) then
  !form.updateCellVal = false
  return
endif

--first try to evaluate the value as a real (metric)
!isReal = true
!stringParameterValue = !data[0].string().trim()
!exp = object EXPRESSION(!stringParameterValue)
handle any
  !isReal = false
elsehandle none
  !realParamVal = REAL()
  !realParamVal = !exp.evaluate(!!ce)
  handle any
    !isReal = false
  endhandle
endhandle

-- if it's not possible to get a real number for the entered value,
-- assume it's supposed to be a string
if (!isReal and (!realParamVal.set())) then
  -- Use REAL parameter value
  !stringParameterValue = !realParamVal.string()
else
  -- Use STRING parameter value
  !longString = ( !stringParameterValue.length() gt 4 )

  -- Perform some basic error checking on the string
  !invalidWord = false
  !stringParameterValue = !stringParameterValue.upcase()

  -- Test that the string contains only alphabetic characters
  !alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
  do !i from 1 to 4
    !letter = substring(!stringParameterValue,!i,1)
    if (!alphabet.match(!letter) eq 0) then
       !invalidWord = true
       break
    endif
  enddo

  if (!invalidWord) then
    !!alert.message('String must be a maximum of 4 letters long and contain only alphabetic characters')
    if( !originalValue.upcase() eq 'UNSET' ) then
      !stringParameterValue = '0'
    else
      !stringParameterValue = !originalValue
    endif
  else
    -- valid word
    if( !longString ) then
      if( !stringParameterValue.upcase() eq 'UNSET' ) then
        !!alert.message('Parameter values may not be set to UNSET')
        !stringParameterValue = '0'
      else
        -- truncate to four characters
        !!alert.message('String is too long. Truncating to 4 characters')
        !stringParameterValue = !stringParameterValue.substring(1,4)
      endif
    endif
    if( !stringParameterValue.empty() ) then
      -- just check whether a value has been set
      -- if not then insert a 0 to prevent it being removed
      if( !originalValue.upcase() eq 'UNSET' ) then
        !stringParameterValue = '0'
      else
        !stringParameterValue = !originalValue
      endif
    endif
  endif
endif

-- update grid value if changed
if (!stringParameterValue NE !data[0].string()) then
  !data[0] = !stringParameterValue
  !form.updateCellVal = true
endif

-- Now set the parameter to that just created
  PARAM NUMBER $!<whichParam> $!<stringParameterValue>
  handle (47,62)
  endhandle

endmethod
