--
--
-- Description:
-- Object for selection table view control
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add()                            -                   Add new selTabView into the system
--  add(FORM)                        -                   Add existing selTabView into the system
--  add(REAL)                        -                   Add existing selTabView into the system
--  defineForm(REAL)                 FORM                Create new selTabView form
--  editSelTab(STRING)               -                   Create new selection table
--  globalInstance()                 -                   Create global instance of object
--
------------------------------------------------------------------------
define object CATSELTABVIEWS

  -- List of selection table views
  member .selTabViews       is ARRAY

endobject
-- End of object definition for catSelTabViews

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .globalInstance()

  -- Create Global Variable
  !!catSelTabViews = !this

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add existing selTab view into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Selection table view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .add(!form is FORM)

  -- Add form to system
  !this.selTabViews.append(!form)

  -- Update control form if exists and shown
  if (defined(!!catControl)) then
    if (!!catControl.shown()) then
      !!catControl.initialise()
    endif
  endif

  -- Show form
  !form.show('AT', 0, 0)

endmethod
-- End of method definition for .add(FORM)

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add existing selTab view into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Selection table view form number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .add(!number is REAL)

  -- Add form to system
  !formName   = |!!catSelTabEdit| & !number
  !form = $!formName
  handle any
    -- Form not defined
    return
  endhandle
  !this.selTabViews[!number] = !form

  -- Update control form if exists and shown
  if (defined(!!catControl)) then
    if (!!catControl.shown()) then
      !!catControl.initialise()
    endif
  endif

  -- Show form
  !form.show('AT', 0, 0)

endmethod
-- End of method definition for .add(REAL)

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add new selTab view into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .add()

  -- Create new form and add to system
  !this.add(!this.defineForm(!this.nextAvailable()))

endmethod
-- End of method definition for .add(FORM)


------------------------------------------------------------------------
--
-- Method:      editSelTab
--
-- Description: Add new selTabView for editing the current selection table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .editSelTab(!action is STRING)

  -- Check hierarchy and get selection table details
  if (!!ce.type ne 'CTABLE') then
    !listOrder = !!ce.ahlist.findfirst(|CTABLE|)
    if (!listOrder.unset()) then
      return error 1 |Wrong element type, CTABLE expected!|
    else
      !!ce = !!ce.ownlst[!listOrder]
    endif
  endif

  -- Create new form and add to system
  !this.add()

endmethod
-- End of method definition for .editSelTab(STRING)

------------------------------------------------------------------------
--
-- Method:      defineForm
--
-- Description: Define new selTab view form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Form number
-- Return:
--   [Data Type] [Description]
--    FORM        Form created
--
------------------------------------------------------------------------
define method .defineForm(!number is REAL) is FORM

  import 'GridControl'
  handle any
  endhandle

  import 'PMLDBSearch'
  handle any
  endhandle

  -- Form definition
  !formName   = |!!catSelTabEdit| & !number
  setup form $!formName dialog docking noalign

    $!<formName>.formTitle     = |Edit Selection Table | & !number
    $!<formName>.iconTitle     = |Sel. Tab.|
    $!<formName>.formRevision  = | $Revision: 1.00 $ |

    -- Define .net control namespaces
    using namespace 'Aveva.Pdms.Presentation'
    using namespace 'Aveva.Pdms.Presentation.PMLDBSearchCtrl'

    -- Grid control
    member .ngcTable        is NETGRIDCONTROL

    -- Search control
    member .searchControl   is PMLDBSEARCHCTRL
    member .searchResults   is ARRAY

    -- Redirection object for .net control events
    member .eventClick      is EVENTCLICK

    -- Selection table members
    member .selTable        is SELECTIONTABLE
    member .selectedRows    is ARRAY

    -- Predefined text to show in various places on the form
    member .emptyString     is STRING
    member .varyStr         is STRING
    member .answerFmts      is ARRAY
    member .activeTags      is ARRAY
    member .aTypeStr        is STRING
    member .newQuesStr      is STRING

    -- Clipboard
    member .clipboard       is ARRAY

    path right
    button .bnCe 'CE'
    option .opRecentSelTables width 30
    option .opTableTypes 'Headings' tagwidth 8 noReselect width 20

    path down
    -- PML container to host .NET grid control for main Table
    container .conTable nobox PmlNetControl 'Table' anchor all at xmin form ymax.bnCe width 72 height 18
    path left
    button .bnRowSelNone linklabel anchor bottom + right width 9 'Clear Selection' at xmax.conTable - size ymax.conTable
    button .bnRowSelAll linklabel anchor bottom + right width 7 'Select All'

    path down
    -- Task buttons
    frame .frTasks anchor bottom + left + right at xmin form ymax.conTable+1.5 width 72 height 12
      para  .paTableTasks at ymin+1 text 'Table' width 12
      line .lnTableTasks at ymax-0.2 horizontal width 10 height 1
      button .bnTableAtts linklabel width 12 'Table Attributes...'
      button .bnBlank     linklabel ''
      button .bnEditPart  linklabel width 12 'Edit Part Family...'
      button .bnEditModel linklabel width 14 'Edit Model Category...'
      para  .paTypeTasks  at xmax.paTableTasks+3 ymin.paTableTasks text 'Headings' width 18
      line .lnTypeTasks1 at ymax-0.2 horizontal width 16 height 1
      button .bnAddType linklabel width 18 'Add Heading...'
      button .bnTypeAtts linklabel width 18 'Edit Heading Attributes...'
      button .bnEditCriteria linklabel width 18 'Edit Heading Questions...'
      line .lnTypeTasks2 at ymax.paTypeTasks+5 horizontal width 16 height 1
      button .bnDeleteType linklabel width 18 'Delete Heading...'
      para  .paItemTasks  at xmax.paTypeTasks+3 ymin.paTypeTasks text 'Items' width 13
      line .lnItemTasks1 at ymax-0.2 horizontal width 12 height 1
      button .bnAddFromCe linklabel width 14 'Add Items (from CE)'
      button .bnSearch linklabel width 14 'Add Items (Search)...'
      button .bnEditItems linklabel width 13 'Edit Selection...'
      line .lnItemTasks2 at ymax.paItemTasks+5 horizontal width 12 height 1
      button .bnDeleteItems linklabel width 13 'Delete Selection'
    exit

    -- Table attributes panel
    frame .frTableAtts 'Table Attributes' anchor bottom + left + right at xmin.frTasks ymin.frTasks width 72 height 12
      text .txTableAttsName tagwidth 8 'Name' width 50 scroll 60 is STRING
      text .txTableAttsDesc tagwidth 8 'Description' width 50 scroll 60 is STRING
      option .opDiscipline 'Discipline' tagwidth 8 noReselect width 10
      text .txSubDiscipline tagwidth 10 'Sub-Discipline' at xmax.opDiscipline+5 ymin.opDiscipline width 4 is STRING
      text .txInputBy tagwidth 8 'Input By' at xmin.opDiscipline ymax+1 width 30 scroll 60 is STRING
      text .txIssue tagwidth 8 'Issue' width 30 scroll 60 is STRING
      text .txstatus tagwidth 8 'Status' width 30 scroll 60 is STRING
      button .bnTableAttsCancel 'Back' anchor right at xmax.frTableAtts-9 ymax.frTableAtts - size  width 7
      path left
      button .bnTableAttsApply 'Apply' anchor right width 7
    exit

    -- Add type panel
    path down
    frame .frAddType 'Add Heading' anchor bottom + left + right at xmin.frTasks ymin.frTasks width 72 height 12
      text .txAddTypeDesc tagwidth 12 'Description' anchor left + right width 35 scroll 120 is STRING
      button .bnAddTypeCancel 'Back' anchor right at xmax.frAddType-9 ymax.frAddType - size width 7
      path left
      button .bnAddTypeApply 'Apply' anchor right width 7
    exit

    -- Type attributes panel
    path down
    frame .frTypeAtts 'Edit Heading' anchor bottom + left + right at xmin.frTasks ymin.frTasks width 72 height 12
      text .txTypeAttsDesc tagwidth 12 'Description' anchor left + right width 35 scroll 120 is STRING
      text .txTypeAttsName tagwidth 12 'Name' anchor left + right width 35 scroll 120 is STRING
      text .txTypeAttsPurp tagwidth 12 'Purpose' width 4 scroll 4 is STRING
      button .bnTypeAttsCancel 'Back' anchor right at xmax.frTypeAtts-9 ymax.frTypeAtts - size width 7
      path left
      button .bnTypeAttsApply 'Apply' anchor right width 7
    exit

    -- Edit criteria panel
    path down
    frame .frCriteria 'Edit Questions' anchor bottom + left + right at xmin.frTasks ymin.frTasks width 72 height 12
      frame .frQuesList panel anchor left at xmin.frCriteria+1 ymin.frCriteria+1 width 25 height 8
        list .lsQuestions 'Questions' zerosel noReselect width 30 length 8
        button .bnQuesAdd 'Add Question' width 9
        path right
        button .bnQuesDelete pixmap at xmax.lsQuestions-15
        button .bnQuesUp pixmap
        button .bnQuesDown pixmap
        path down
      exit
      frame .frQuesEnter panel anchor left + right at xmax.lsQuestions+2 ymin.frQuesList+0.25 width 20 height 7
          text .txQuesPurp tagwidth 10 'Purpose' width 4 scroll 4 is STRING
          text .txQuesDesc tagwidth 10 'Description' anchor left + right width 20 scroll 120 is STRING
          option .opQuesType 'Question Type' tagwidth 10 at ymax.txQuesDesc+1 width 10
          text .txQuesQues tagwidth 10 'Question' anchor left + right width 20 scroll 120 is STRING
          option .opAnsType 'Answer Type' tagwidth 10 at ymax.txQuesQues+1 width 10
          text .txQuesDflt tagwidth 10 'Default Answer' anchor left + right width 20 scroll 120 is STRING
        exit
      button .bnCriteriaCancel 'Back' anchor right at xmax.frCriteria-9 ymax.frCriteria - size width 7
      path left
      button .bnCriteriaApply 'Apply' anchor right width 7
    exit

    -- Answers panel
    path down
    frame .frItem 'Edit Items' anchor bottom + left + right at xmin.frTasks ymin.frTasks width 72 height 12
      list .lsItemQues 'Questions' at xmin.frItem+1 ymin.frItem+1 zerosel noReselect width 30 length 8
      text .txItemName tagwidth 7 'Name' anchor left + right at xmax.lsItemQues+2 ymin.lsItemQues+0.25 width 23 scroll 120 is STRING
      text .txPartref tagwidth 7 'Part Ref.' anchor left + right width 23 scroll 120 is STRING
      frame .frItemStatus '' at xmin.txItemName+7
        path right
        rtoggle .rtActive 'Active' tagwidth 5
        rtoggle .rtInActive 'Inactive' tagwidth 5
      exit
      path down
      option .opItemFmt 'Format' tagwidth 7 at xmin.txItemName ymax.frItemStatus+1.5 width 7
      text .txItemAns 'Answer' tagwidth 7  anchor left + right at ymax.opItemFmt+0.25 width 23 scroll 120 is STRING
      para  .paItemFmt at xmin.opItemFmt+7 text '' width 23
      button .bnItemCancel 'Back' anchor right at xmax.frItem-9 ymax.frItem - size width 7
      path left
      button .bnItemApply 'Apply' anchor right width 7
    exit

    -- Search definition panel
    path down
    frame .frSearchDef 'Search' anchor bottom + left + right at xmin.frTasks ymin.frTasks width 72 height 12
      container .conSearch nobox PmlNetControl 'Search' anchor all width 70 height 10
      path left
      button .bnSearchCancel 'Back' anchor bottom + right at xmax.frSearchDef-10 ymax.conSearch width 8
      button .bnSearchNew 'New Search' anchor bottom + right width 8
      button .bnSearchAdd 'Add Selected' anchor bottom + right width 8
    exit

    -- Frame to force vertical scroll bar on resize below minimum form size
    frame .frForceVerticalScrollBars panel at xmin form ymin form width 1 height 30
    exit

    -- Define popup menu for .conTable
    !menu = !this.newMenu('puTable', 'POPUP')
    !menu.add('MENU', 'Navigate', 'puNavigateList', 'NAVIGATE')
    !menu.add('MENU', 'Edit', 'puEditList', 'EDIT')
    !menu.add('SEPARATOR','Sep1' )
    !menu.add('CALLBACK', 'Copy', '!!catSelTabViews.tablePopup(', 'COPY')
    !menu.add('CALLBACK', 'Paste', '!!catSelTabViews.tablePopup(', 'PASTE')
    !menu = !this.newMenu('puNavigateList', 'POPUP')
    !menu.add('CALLBACK', 'Table Item', '!!catSelTabViews.tablePopup(', 'NAVTABITE')
    !menu.add('CALLBACK', 'Part', '!!catSelTabViews.tablePopup(', 'NAVprtref')
    !menu.add('CALLBACK', 'Model Component', '!!catSelTabViews.tablePopup(', 'NAVCATREF')
    !menu.add('CALLBACK', 'Template', '!!catSelTabViews.tablePopup(', 'NAVTMPREF')
    !menu = !this.newMenu('puEditList', 'POPUP')
    !menu.add('CALLBACK', 'Part Family', '!!catSelTabViews.tablePopup(', 'EDITPART')
    !menu.add('CALLBACK', 'Model Category', '!!catSelTabViews.tablePopup(', 'EDITCATE')

  exit

  -- Pseudo form constructor

  -- Form
  !form = $!formName
  !form.formTitle     = |Edit Selection Table | & !number
  !form.iconTitle     = |Sel. Tab.|
  !form.formRevision  = | $Revision: 1.00 $ |
  !form.callback      = |!!catSelTabViews.init(| & !formName & |)|
  !form.cancelCall    = |!!catSelTabViews.close(| & !formName & |)|
  !form.autoscroll    = false
  !form.helpcontextid = 'HID_CATSELTABEDIT'

  -- Main Form
  !form.emptyString                = |Empty|
  !form.bnCe.callback              = |!!catSelTabViews.init(| & !formName & |)|
  !form.opRecentSelTables.callback = |!!catSelTabViews.actionMain(|
  !form.opTableTypes.callback      = |!!catSelTabViews.actionMain(|
  !form.bnRowSelAll.callback       = |!!catSelTabViews.actionMain(|
  !form.bnRowSelNone.callback      = |!!catSelTabViews.actionMain(|
  !form.varyStr                    = |<Multiple values>|
  !form.aTypeStr                   = |Answer Type:  |
  !form.newQuesStr                 = |NEWQ|

  -- Tasks panel
  !form.bnEditPart.callback     = |!!catSelTabViews.linkLabelCall(|
  !form.bnEditModel.callback    = |!!catSelTabViews.linkLabelCall(|
  !form.bnTableAtts.callback    = |!!catSelTabViews.managePanels(|
  !form.bnAddType.callback      = |!!catSelTabViews.managePanels(|
  !form.bnTypeAtts.callback     = |!!catSelTabViews.managePanels(|
  !form.bnDeleteType.callback   = |!!catSelTabViews.actionTasks(|
  !form.bnEditCriteria.callback = |!!catSelTabViews.managePanels(|
  !form.bnAddFromCe.callback    = |!!catSelTabViews.actionTasks(|
  !form.bnSearch.callback       = |!!catSelTabViews.managePanels(|
  !form.bnEditItems.callback    = |!!catSelTabViews.managePanels(|
  !form.bnDeleteItems.callback  = |!!catSelTabViews.actionTasks(|

  -- Table attributes panel
  !form.txTableAttsName.callback   = |!!catSelTabViews.checkNameField(|
  !disciplineDStr                  = |Unknown Room Electrical Equipment HVAC Steelwork|
  !disciplineD                     = !disciplineDStr.split()
  !disciplineRStr                  = |UNKNOWN ROOM ELEC EQUI HVAC STL|
  !disciplineR                     = !disciplineRStr.split()
  -- Include steelwork fixing
  if (!!appCntrl.currentApp.eq('STL')) then
     !disciplineD.append('Fixing')
     !disciplineR.append('STFX')
  endif
  !form.opDiscipline.dtext         = !disciplineD
  !form.opDiscipline.rtext         = !disciplineR
  !form.bnTableAttsApply.callback  = |!!catSelTabViews.actionTableAtts(|
  !form.bnTableAttsCancel.callback = |!!catSelTabViews.actionTableAtts(|

  -- Add type panel
  !form.txAddTypeDesc.callback   = |!!catSelTabViews.actionAddType(|
  !form.bnAddTypeApply.callback  = |!!catSelTabViews.actionAddType(|
  !form.bnAddTypeCancel.callback = |!!catSelTabViews.actionAddType(|

  -- Type attributes panel
  !form.txTypeAttsDesc.callback   = |!!catSelTabViews.actionTypeAtts(|
  !form.txTypeAttsName.callback   = |!!catSelTabViews.checkNameField(|
  !form.txTypeAttsPurp.callback   = |!!catSelTabViews.actionTypeAtts(|
  !form.bnTypeAttsApply.callback  = |!!catSelTabViews.actionTypeAtts(|
  !form.bnTypeAttsCancel.callback = |!!catSelTabViews.actionTypeAtts(|

  -- Criteria panel
  !form.lsQuestions.callback = |!!catSelTabViews.actionCriteria(|
  !quesTypeD[1] = |Text|
  !quesTypeD[2] = |Word|
  !quesTypeD[3] = |Expression|
  !quesTypeD[4] = |Attribute|
  !quesTypeR[1] = |TEXT|
  !quesTypeR[2] = |WORD|
  !quesTypeR[3] = |EXPR|
  !quesTypeR[4] = |ATTR|
  !form.opQuesType.dtext = !quesTypeD
  !form.opQuesType.rtext = !quesTypeR
  !ansTypeD[1] = |Text|
  !ansTypeD[2] = |Word|
  !ansTypeD[3] = |Real|
  !ansTypeD[4] = |Boolean|
  !ansTypeR[1] = |TEXT|
  !ansTypeR[2] = |WORD|
  !ansTypeR[3] = |REAL|
  !ansTypeR[4] = |BOOL|
  !form.opAnsType.dtext = !ansTypeD
  !form.opAnsType.rtext = !ansTypeR
  !form.bnQuesAdd.callback = |!!catSelTabViews.actionCriteria(|
  !form.bnQuesUp.callback = |!!catSelTabViews.actionCriteria(|
  !form.bnQuesUp.addPixmap(!!pml.getPathName(|uparrow16.png|))
  !form.bnQuesDown.callback = |!!catSelTabViews.actionCriteria(|
  !form.bnQuesDown.addPixmap(!!pml.getPathName(|downarrow16.png|))
  !form.bnQuesDelete.callback = |!!catSelTabViews.actionCriteria(|
  !form.bnQuesDelete.addPixmap(!!pml.getPathName(|deletece24.png|))
  !form.bnCriteriaApply.callback = |!!catSelTabViews.actionCriteria(|
  !form.bnCriteriaCancel.callback = |!!catSelTabViews.actionCriteria(|

  -- Items panel
  !form.lsItemQues.callback = |!!catSelTabViews.actionItems(|
  !form.opItemFmt.callback = |!!catSelTabViews.actionItems(|
  !form.answerFmts[1] = |{ ANY }|
  !form.answerFmts[2] = |{ AAAA BBBB CCCC ....  }|
  !form.answerFmts[3] = |{ 100 200 }|
  !form.answerFmts[4] = |{| & !form.varyStr & |}|
  !form.txItemName.callback = |!!catSelTabViews.checkNameField(|
  !form.txPartref.callback = |!!catSelTabViews.checkNameField(|
  !form.bnItemApply.callback = |!!catSelTabViews.actionItems(|
  !form.bnItemCancel.callback = |!!catSelTabViews.actionItems(|

  -- Initialise object to hold .net event pointers
  !form.eventClick = object EVENTCLICK(!form)

  -- Search definition panel
  !form.searchControl = object PMLDBSEARCHCTRL()
  !form.searchControl.addEventHandler('ResultsSelectedEvent', !form.eventClick, 'selTabResultsSelected')
  !form.conSearch.control = !form.searchControl.handle()
  !form.bnSearchAdd.callback = |!!catSelTabViews.actionSearch(|
  !form.bnSearchNew.callback = |!!catSelTabViews.actionSearch(|
  !form.bnSearchCancel.callback = |!!catSelTabViews.actionSearch(|

  -- Add instances of .net control
  !form.ngcTable = object NETGRIDCONTROL()
  -- Add event handlers to grid control
  !form.ngcTable.addEventHandler('OnPopup', !form.eventClick, 'selTabRightClick')
  !form.ngcTable.addEventHandler('AfterSelectChange', !form.eventClick, 'selTabAfterSelect')
  -- Set grid properties
  !form.ngcTable.fixedHeaders(false)
  !form.ngcTable.outlookGroupStyle(false)
  !form.ngcTable.columnExcelFilter(false)
  !form.ngcTable.headerSort(false)
  !form.ngcTable.columnSummaries(false)
  !form.ngcTable.singleRowSelection(false)
  !form.ngcTable.setAlternateRowColor('WHITE')

  -- Add grid control to .net container
  !form.conTable.control  = !form.ngcTable.handle()

  -- Add popup to .net container
  !form.conTable.popup = !form.puTable

  return !form

endmethod
-- End of method definition for .defineForm(REAL) is FORM

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialise method for the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init(!form is FORM)

  -- Check hierarchy and get selection table details
  if (!!ce.type eq 'TABGRO') then
    !form.selTable = object SELECTIONTABLE(!!ce)
  else
    !listOrder = !!ce.ahlist.findfirst(|TABGRO|)
    if (!listOrder.unset()) then
      return error 1 |Wrong element type, TABGRO expected!|
    else
      !!ce = !!ce.ownlst[!listOrder]
      !form.selTable = object SELECTIONTABLE(!!ce)
    endif
  endif

  -- Add CE to recent CE's option list
  !!catRecentObjects.add(!!ce)
  !this.updateRecentSelTables(!form)
  !form.opRecentSelTables.select(|RTEXT|, !!ce.string())

  -- Initialise table types option list
  !this.initOpTableTypes(!form)

  -- Set form name
  !this.setFormName(!form)

  -- Set table attributes panel visible
  !this.managePanels(!form.frTasks, '')

  -- Initialise tasks panel
  !this.initTasks(!form)

  -- Initialise table attributes panel
  !this.initTableAtts(!form)

  -- Initialise table attributes panel
  !this.initType(!form)

endmethod
-- End of method definition for .init(FORM)

------------------------------------------------------------------------
--
-- Method:      initOpTableTypes
--
-- Description: Initialise table types option list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initOpTableTypes(!form is FORM)

  -- Get table types
  !tableTypes = !form.selTable.getTypes()

  -- Initialise option list
  if (!tableTypes.empty()) then
    !dtext[1] = |None|
    !rtext[1] = |0|
    !form.opTableTypes.dtext = !dtext
    !form.opTableTypes.rtext = !rtext
  else
    !form.opTableTypes.dtext = !tableTypes
    !strIndices = ARRAY()
    do !ind indices !tableTypes
      !strIndices.append(!ind.string('D0'))
    enddo
    !form.opTableTypes.rtext = !strIndices
    -- Select the current table type to match the selection table
    !form.opTableTypes.val = !form.selTable.typeIndex
  endif

endmethod
-- End of method definition for .initOpTableTypes(FORM)

------------------------------------------------------------------------
--
-- Method:      initType
--
-- Description: Initialise form for currently selected table type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initType(!form is FORM)

  -- Set selected table
  !typeIndex       = !form.opTableTypes.selection().real()
  !unusedResponse  = !form.selTable.setType(!typeIndex)
  handle (2,766)
     -- Means that nothing came back here, so continue to populate the grid.
     -- does not return a result, hence no error, so continue.
  elsehandle any
     -- Likely here that the return message is "Selection table type index out of range!"
     -- Error occurred, clear table to leave it blank.
  endhandle

  -- Initialise edit type panel
  !this.initTypeAtts(!form)
  !this.initCriteria(!form, |QLIST|, 1)

  -- Initialise items panel
  !form.selectedRows.clear()
  !this.initItems(!form, true, true, true, false)

  -- Populate table
  !this.populateTable(!form)

endmethod
-- End of method definition for .initType(FORM)

------------------------------------------------------------------------
--
-- Method:      actionMain
--
-- Description: Gadget actions for main form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionMain(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  -- Button actions
  -- Recent selection tables list
  if (!object eq !form.opRecentSelTables and !action eq |SELECT|) then
    !!ce = !object.selection().dbref()
    handle (2,107)
      -- Bad table ref (must have been deleted)
      !!alert.error (|Selected group is no longer available|)
      !this.updateRecentSelTables(!form)
    elsehandle none
      !this.init(!form)
    endhandle

  -- Table types option list
  elseif (!object eq !form.opTableTypes and !action eq |SELECT|) then
    !this.initType(!form)
    --!this.managePanels(!form.bnEditItems, '')

  -- Select all
  elseif (!object eq !form.bnRowSelAll and !action eq |SELECT|) then
    -- Make array of all row indices
    !rows = ARRAY()
    do !cnt from 1 to !form.ngcTable.getNumberRows()
      !rows.append(!cnt)
    enddo
    -- Select rows
    !this.netSelectRows(!form, !rows)

  -- Select none
  elseif (!object eq !form.bnRowSelNone and !action eq |SELECT|) then
    !this.netSelectRows(!form, object ARRAY())

  endif

endmethod
-- End of method definition for .actionMain(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      initTasks
--
-- Description: Initialise Tasks panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initTasks(!form is FORM)

  -- Types labels
  if (!form.selTable.getTypeCount() eq 0) then
    !form.bnTypeAtts.active = false
    !form.bnDeleteType.active = false
  else
    !form.bnTypeAtts.active = true
    !form.bnDeleteType.active = true
  endif

  -- Add items labels
  if (!form.selTable.getTypeCount() eq 0) then
    !form.bnAddFromCe.active = false
    !form.bnSearch.active = false
  else
    !form.bnAddFromCe.active = true
    !form.bnSearch.active = true
  endif

  -- Edit criteria labels
  if (!form.selTable.getTypeCount() eq 0) then
    !form.bnEditCriteria.active = false
  else
    !form.bnEditCriteria.active = true
  endif

  -- Edit items labels
  if (!form.selTable.getTypeCount() eq 0) then
    !form.bnEditItems.active   = false
    !form.bnDeleteItems.active = false
    !form.bnEditModel.active   = false
    !form.bnEditPart.active    = false
  else
    if (!form.selectedRows.size() eq 0) then
      !form.bnEditItems.active   = false
      !form.bnDeleteItems.active = false
      !form.bnEditModel.active   = false
      !form.bnEditPart.active    = false
    else
      !form.bnEditModel.active   = true
      !form.bnEditPart.active    = true
      !form.bnEditItems.active   = true
      !form.bnDeleteItems.active = true
    endif
  endif

endmethod
-- End of method definition for .initTasks(FORM)

------------------------------------------------------------------------
--
-- Method:      actionTasks
--
-- Description: Gadget actions for Tasks panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionTasks(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  -- Button actions
  -- Delete type
  if (!object eq !form.bnDeleteType and !action eq |SELECT|) then
    -- Don't allow deletion if ctable has any items in it
    if (!form.selTable.items.size() ne 0) then
      !!alert.message(|Can't delete type containing items, delete items first then try again!|)
      return
    endif
    -- Confirm deletion
    !type = !form.selTable.getType()
    !answer = !!alert.confirm(|Delete type $!<type>, are you sure?|)
    if (!answer eq |YES|) then
      -- Delete type
      !form.selTable.deleteType()
      -- Update form
      !this.initOpTableTypes(!form)
      !this.initTasks(!form)
      !this.initType(!form)
      -- Set attributes panel visible
      !this.managePanels(!form.frTasks, '')
    endif

  -- Add from CE
  elseif (!object eq !form.bnAddFromCe and !action eq |SELECT|) then
    -- Remember original CE
    !dbref = !!ce
    -- collect gparts
    var !gpartRefs collect all gpart for ce
    if (!gpartRefs.empty()) then
      !!alert.warning(|No GPART members found in $!<dbref.name>|)
      return
    else
      !gparts = !gpartRefs.evaluate(object BLOCK(|!gpartRefs[!evalIndex].dbref()|))
    endif
    -- Add to table
    !this.addToTable(!form, !gparts)
    -- Restore original CE
    !!ce = !dbref

  -- Delete selection
  elseif (!object eq !form.bnDeleteItems and !action eq |SELECT|) then
    -- Get confirmation before deleting items
    if (!form.selectedRows.unset()) then
      !!alert.message(|No items selected!|)
      return
    else
      !answer = !!alert.confirm(|Are you sure?|)
      if (!answer eq |NO|) then
        return
      endif
    endif
    -- Delete items from table
    !form.selTable.deleteItems(!form.selectedRows)
    -- Update form
    !this.populateTable(!form)
    -- Clear form selection
    !this.netSelectRows(!form, object ARRAY())

  endif

endmethod
-- End of method definition for .actionTasks(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      managePanels
--
-- Description: Manage panel visibility
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .managePanels(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  -- Hide all panes
  !form.frTasks.visible = false
  !form.frTableAtts.visible = false
  !form.frAddType.visible = false
  !form.frTypeAtts.visible = false
  !form.frCriteria.visible = false
  !form.frItem.visible = false
  !form.frSearchDef.visible = false

  -- Show appropriate pane and take required action
  if (!object eq !form.frTasks) then
    !form.frTasks.visible = true
  -- Table attributes
  elseif (!object eq !form.bnTableAtts) then
    !this.initTableAtts(!form)
    !form.frTableAtts.visible = true
  -- Add type
  elseif (!object eq !form.bnAddType) then
    !this.initAddType(!form)
    !form.frAddType.visible = true
  -- Type attributes
  elseif (!object eq !form.bnTypeAtts) then
    !this.initTypeAtts(!form)
    !form.frTypeAtts.visible = true
  -- Criteria
  elseif (!object eq !form.bnEditCriteria) then
    !index = !form.lsQuestions.val
    !this.initCriteria(!form, |QLIST|, !index)
    !form.frCriteria.visible = true
  -- Items
  elseif (!object eq !form.bnEditItems) then
    !this.initItems(!form, true, true, true, false)
    !form.frItem.visible = true
  -- Search
  elseif (!object eq !form.bnSearch) then
    !this.initSearch(!form)
    !form.frSearchDef.visible = true
  endif

endmethod
-- End of method definition for .managePanels(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      initTableAtts
--
-- Description: Initialise selection table group Attributes panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initTableAtts(!form is FORM)

  -- Populate attribute fields
  !form.txTableAttsName.val = !this.txEmptyToUnset(!form.selTable.name)
  !form.txTableAttsDesc.val = !this.txEmptyToUnset(!form.selTable.description)
  !form.opDiscipline.select(|RTEXT|, !form.selTable.discipline)
  handle (61,567)
    !form.opDiscipline.val = 1
  endhandle
  !form.txSubDiscipline.val = !this.txEmptyToUnset(!form.selTable.subDiscipline)
  !form.txInputBy.val = !this.txEmptyToUnset(!form.selTable.inputBy)
  !form.txIssue.val = !this.txEmptyToUnset(!form.selTable.issue)
  !form.txstatus.val = !this.txEmptyToUnset(!form.selTable.status)

endmethod
-- End of method definition for .initTableAtts(FORM)

------------------------------------------------------------------------
--
-- Method:      actionTableAtts
--
-- Description:  Gadget actions for Attributes panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionTableAtts(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  -- Button actions
  -- Apply
  if (!object eq !form.bnTableAttsApply and !action eq |SELECT|) then
    !attributes = object ARRAY()
    -- Collate other attributes
    !attributes.append(!this.txUnsetToEmpty(!form.txTableAttsName.val).trim())
    !attributes.append(!this.txUnsetToEmpty(!form.txTableAttsDesc.val).trim())
    !attributes.append(!this.txUnsetToEmpty(!form.opDiscipline.selection()))
    !attributes.append(!this.txUnsetToEmpty(!form.txSubDiscipline.val).trim())
    !attributes.append(!this.txUnsetToEmpty(!form.txInputBy.val).trim())
    !attributes.append(!this.txUnsetToEmpty(!form.txIssue.val).trim())
    !attributes.append(!this.txUnsetToEmpty(!form.txstatus.val).trim())

    -- Set attributes
    !form.selTable.setTableAtts(!attributes)

    -- Refresh form name
    !this.setFormName(!form)

    -- Refresh recent selection tables list
    !this.updateRecentSelTables(!form)

    -- Refresh attributes panel
    !this.initTableAtts(!form)

  -- Cancel
  elseif (!object eq !form.bnTableAttsCancel and !action eq |SELECT|) then
    -- Set table attributes panel visible
    !this.managePanels(!form.frTasks, '')

  endif

endmethod
-- End of method definition for .actionTableAtts(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      initAddType
--
-- Description: Initialise Create Type panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initAddType(!form is FORM)

  !form.txAddTypeDesc.clear()

endmethod
-- End of method definition for .initAddType(FORM)

------------------------------------------------------------------------
--
-- Method:      actionAddType
--
-- Description:  Gadget actions for Create Type panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionAddType(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  -- Button actions
  -- Apply
  if (!object eq !form.bnAddTypeApply and !action eq |SELECT|) then

    -- Get values from panel
    !attVals = object ARRAY()
    !attVals.append(!this.txUnsetToEmpty(!form.txAddTypeDesc.val).trim())
    !attVals.append('')
    !attVals.append('')

    -- Check for valid Description
    if (!attVals[1].empty()) then
      return error 1 |You must enter a description for the new type!|
    endif

    -- Create new type
    !form.selTable.newType()

    -- Set attribute values for new type
    !form.selTable.setTypeAtts(!attVals)

    -- Update form
    !this.initOpTableTypes(!form)
    !this.initTasks(!form)
    !this.initType(!form)

    -- Set Edit Type panel visible
    !this.managePanels(!form.bnTypeAtts, '')

  -- Cancel
  elseif (!object eq !form.bnAddTypeCancel and !action eq |SELECT|) then
    -- Set Tasks panel visible
    !this.managePanels(!form.frTasks, '')

  endif

endmethod
-- End of method definition for .actionAddType(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      initTypeAtts
--
-- Description: Initialise Type Attributes panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initTypeAtts(!form is FORM)

  -- Get type attributes for current type
  !typeAtts = !form.selTable.getTypeAtts()

  -- Populate attribute fields
  if (!typeAtts.unset()) then
    !form.txTypeAttsDesc.clear()
    !form.txTypeAttsName.clear()
    !form.txTypeAttsPurp.clear()
  else
    !form.txTypeAttsDesc.val = !this.txUnsetToEmpty(!typeAtts[1])
    !form.txTypeAttsName.val = !this.txUnsetToEmpty(!typeAtts[2])
    !form.txTypeAttsPurp.val = !this.txUnsetToEmpty(!typeAtts[3])
  endif

endmethod
-- End of method definition for .initTypeAtts(FORM)

------------------------------------------------------------------------
--
-- Method:      actionTypeAtts
--
-- Description: Gadget actions for Type Attributes panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionTypeAtts(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  -- Button actions
  -- Apply
  if (!object eq !form.bnTypeAttsApply and !action eq |SELECT|) then

    -- Get values from panel
    !attVals = object ARRAY()
    !attVals.append(!this.txUnsetToEmpty(!form.txTypeAttsDesc.val).trim())
    !attVals.append(!this.txUnsetToEmpty(!form.txTypeAttsName.val).trim())
    !attVals.append(!this.txUnsetToEmpty(!form.txTypeAttsPurp.val).trim())

    -- Check for valid Description
    if (!attVals[1].empty()) then
      return error 1 |You must enter a description for the new type!|
    endif

    -- Set type attributes
    !form.selTable.setTypeAtts(!attVals)

    -- Update form
    !this.initOpTableTypes(!form)
    !this.initType(!form)

  -- Cancel
  elseif (!object eq !form.bnTypeAttsCancel and !action eq |SELECT|) then
    -- Set Edit Type panel visible
    !this.managePanels(!form.frTasks, '')

  endif

endmethod
-- End of method definition for .actionTypeAtts(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      initCriteria
--
-- Description: Initialise Criteria panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
--    2   R      REAL        Section of panel to update
--    3   R      REAL        Index of question to select
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initCriteria(!form is FORM, !action is STRING, !index is REAL)

  -- Question list
  if (!action eq |QLIST|) then
  -- Populate questions list
  !headStr = 'NUM PURP QTYPE DESCRIPTION'
  !form.lsQuestions.setHeadings(!headStr.split())
  !selTabHdg = ARRAY()
  !questions = !form.selTable.getQuestions()
  if (!questions.set()) then
    do !ind indices !questions
      !selTabHdg[!ind][1] = !ind.string()                             $* List order
      !selTabHdg[!ind][2] = !this.txEmptyToUnset(!questions[!ind][1]) $* question purpose
      !selTabHdg[!ind][3] = !this.txEmptyToUnset(!questions[!ind][4]) $* question type
      handle (2,752)
        -- This message reported after CTABLE has been incorrectly setup with answers and questions.
        !!alert.error(!!error.text & ' Error in extracting Question and Answers from TABHEA and TABHQU Elements. Grid may contain incorrect information.')
        return
      endhandle

      !selTabHdg[!ind][4] = !this.txEmptyToUnset(!questions[!ind][2]) $* question description
    enddo
  endif
  !form.lsQuestions.setRows(!selTabHdg)
  -- Select question in list
  if (!questions.empty()) then
    !form.lsQuestions.val = 0
  else
    !form.lsQuestions.val = !index
  endif
  -- Activate the delete button if there are any questions in the list
  if (!form.lsQuestions.dtext.empty()) then
    !form.bnQuesDelete.active = false
  else
    !form.bnQuesDelete.active = true
  endif
    -- Initialise question list on items panel
    !this.initItems(!form, true, true, false, false)
  endif

  -- Question attributes
  if (!action inset(|QATTS|, |QLIST|)) then
    !setIndex = !form.lsQuestions.val
    if (!setIndex ne 0) then
      -- Get question details
      !question = !form.selTable.getQuestion(!setIndex)
      !form.txQuesPurp.val = !this.txEmptyToUnset(!question[1])
      !form.txQuesDesc.val = !this.txEmptyToUnset(!question[2])
      !form.opQuesType.select('RTEXT',!question[4])
      handle any
          !form.opQuesType.val = 1
      endhandle
      !form.txQuesQues.val = !this.txEmptyToUnset(!question[3])
      !form.opAnsType.select('RTEXT', !question[6])
      if (!question[6] eq |REAL|) then
        !form.txQuesDflt.val = !this.txEmptyToUnset(!question[5].string())
      else
        !form.txQuesDflt.val = !this.txEmptyToUnset(!question[5])
      endif
      !form.frQuesEnter.active = true
    else
      -- Clear question details
      !form.txQuesPurp.clear()
      !form.txQuesDesc.clear()
      !form.txQuesQues.clear()
      !form.txQuesDflt.clear()
      !form.opQuesType.val     = 1
      !form.opAnsType.val      = 1
      !form.frQuesEnter.active = false
    endif
  endif

endmethod
-- End of method definition for .initCriteria(FORM, STRING, REAL)

------------------------------------------------------------------------
--
-- Method:      actionCriteria
--
-- Description: Gadget actions for Questions panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionCriteria(!object is GADGET, !action is STRING)

  -- Get gadget details
  !form = !object.owner()

  -- Item selected in questions list
  if (!object eq !form.lsQuestions) then
    if (!action eq |SELECT|) then
      !this.initCriteria(!form, |QATTS|, 0)
    elseif (!action eq |UNSELECT|) then
      !this.initCriteria(!form, |QATTS|, 0)
    endif

  -- Reorder question up
  elseif (!object eq !form.bnQuesUp and !action eq |SELECT|) then
    -- Get selected index in question list (will be zero if empty)
    !index = !form.lsQuestions.val
    if (!index gt 1) then
      !newIndex = !index - 1
      !form.selTable.reorderQuestion(!index, !newIndex)
      -- Update heading panel
      !this.initCriteria(!form, |QLIST|, !newIndex)
      -- Select the reordered question in the list
      !form.lsQuestions.val = !newIndex
      -- Update main table
      !this.populateTable(!form)
      -- Reselect the rows
      !this.netSelectRows(!form, !form.selectedRows)
    endif

  -- Reorder question down
  elseif (!object eq !form.bnQuesDown and !action eq |SELECT|) then
    -- Get selected index in question list (will be zero if empty)
    !index = !form.lsQuestions.val
    if (!index ne 0 and !index lt !form.lsQuestions.dtext.size()) then
      !newIndex = !index + 1
      !form.selTable.reorderQuestion(!index, !newIndex)
      -- Update heading panel
      !this.initCriteria(!form, |QLIST|, !newIndex)
      -- Select the reordered question in the list
      !form.lsQuestions.val = !newIndex
      -- Update main table
      !this.populateTable(!form)
      -- Reselect the rows
      !this.netSelectRows(!form, !form.selectedRows)
    endif

  -- Add a new question
  elseif (!object eq !form.bnQuesAdd and !action eq |SELECT|) then
    -- Check for existing 'new' question
    if (!form.selTable.checkNewQuesPurp(!form.newQuesStr).not()) then
      !!alert.warning(|Duplicate questions are not allowed, the $!<form.newQuesStr> question is already defined!|)
    else
      -- Insert new question
      !newIndex = !form.selTable.newQuestion(!form.newQuesStr)
      -- Update heading panel
      !this.initCriteria(!form, |QLIST|, !newIndex)
      -- Update main table
      !this.populateTable(!form)
      -- Reselect the rows
      !this.netSelectRows(!form, !form.selectedRows)
    endif

  -- Delete a question
  elseif (!object eq !form.bnQuesDelete and !action eq |SELECT|) then
    -- Get index for currently selected question
    !form.selTable.deleteQuestion(!form.lsQuestions.val)
    -- Update heading panel
    !this.initCriteria(!form, |QLIST|, 1)
    -- Update main table
    !this.populateTable(!form)
    -- Reselect the rows
    !this.netSelectRows(!form, !form.selectedRows)

  -- Apply modifications to question attributes
  elseif (!object eq !form.bnCriteriaApply and !action eq |SELECT|) then
    -- Question attributes for selected question
    !index = !form.lsQuestions.val
    if (!index gt 0) then
      -- Get values from headings panel
      !questionVals = object ARRAY()
      !questionVals.append(!this.txUnsetToEmpty(!form.txQuesPurp.val).trim())
      !questionVals.append(!this.txUnsetToEmpty(!form.txQuesDesc.val).trim())
      !questionVals.append(!this.txUnsetToEmpty(!form.txQuesQues.val).trim())
      !questionVals.append(!form.opQuesType.selection(|RTEXT|))
      !questionVals.append(!this.txUnsetToEmpty(!form.txQuesDflt.val).trim())
      !questionVals.append(!form.opAnsType.selection(|RTEXT|))
      -- Check if answer type has changed and get confirmation if it has
      -- (the corresponding answer will be unset for all table items if the answer type has changed)
      if (!questionVals[6] ne !form.selTable.heading.members[!index].ansType) then
        !answer = !!alert.confirm(|Changing the 'Answer type' will clear this answer on all table items. Do you want to proceed?|)
        if (!answer eq |YES|) then
          -- Set values
          !form.selTable.setQuestion(!index, !questionVals)
        endif
      else
        !form.selTable.setQuestion(!index, !questionVals)
      endif
    endif
    -- Update type option list
    !this.initOpTableTypes(!form)
    -- Update edit type panel
    !this.initCriteria(!form, |QLIST|, !index)
    !form.lsQuestions.val = !index
    -- Update main table
    !this.populateTable(!form)
    -- Reselect the rows
    !this.netSelectRows(!form, !form.selectedRows)

  -- Apply modifications to question attributes
  elseif (!object eq !form.bnCriteriaCancel and !action eq |SELECT|) then
    -- Set Tasks panel visible
    !this.managePanels(!form.frTasks, '')

  endif

endmethod
-- End of method definition for .actionCriteria(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      initItems
--
-- Description: Initialise Answers panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
--    2   R      STRING      Sections of panel to update (QLIST ANSWER ATTS FORMAT)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initItems(!form is FORM, !qlist is BOOLEAN, !answerFields is BOOLEAN, !attribFields is BOOLEAN, !format is BOOLEAN)

  -- Populate questions list on Edit Items panel
  if (!qlist) then
    !quesStr = 'NUM PURP TYPE DESCRIPTION'
    !form.lsItemQues.setHeadings(!quesStr.split())
    !questions = !form.selTable.getQuestions()
    !selTabQues = object ARRAY()
    if (!questions.set()) then
      do !ind indices !questions
        !selTabQues[!ind][1] = !ind.string()                             $* List order
        !selTabQues[!ind][2] = !this.txEmptyToUnset(!questions[!ind][1]) $* question purpose
        !selTabQues[!ind][3] = !this.txEmptyToUnset(!questions[!ind][4]) $* answer type
        !selTabQues[!ind][4] = !this.txEmptyToUnset(!questions[!ind][2]) $* question description
      enddo
    endif
    !form.lsItemQues.setRows(!selTabQues)
  endif

  -- Display answer details
  if (!answerFields) then
    -- No items selected, or empty first row selected, or no questions in list
  if (!form.selectedRows.unset() or !form.selectedRows.empty() $
          or !form.ngcTable.getRow(1)[1] eq !form.emptyString or !form.lsItemQues.val eq 0) then
      -- Answer fields inactive
      !form.opItemFmt.clear()
      !form.paItemFmt.val = ||
      !form.txItemAns.clear()
      !form.opItemFmt.active = false
      !form.txItemAns.active = false
      !form.paItemFmt.active = false

  -- Items and question are selected
  else
      -- Get selected answer index
      !ansIndex = !form.lsItemQues.val

      -- Get selected answer details for selected table items
      !answerValues = ARRAY()
      !answerFormats = ARRAY()
      do !val values !form.selectedRows
        !answer = !form.selTable.getAnswer(!form.selTable.items[!val], !ansIndex)
        !answerValues.append(!answer[1])
        !answerFormats.append(!answer[3])
      enddo
      -- Same type for all selected rows so just use the last one for answer type
      !answerType = !answer[2]

      -- Set up answer format option list
      !itemFmtDStr = |Single|
      !itemFmtRStr = |SING|
      !form.opItemFmt.dtext = !itemFmtDStr.split()
      !form.opItemFmt.rtext = !itemFmtRStr.split()
      -- Add MULT format if selected type is WORD
      if (!answerType eq |WORD|) then
        !form.opItemFmt.add(|Multiple|, |MULT|)
      -- Add MULT & RANG formats if selected type is REAL
      elseif (!answerType eq |REAL|) then
        !form.opItemFmt.add(|Multiple|, |MULT|)
        !form.opItemFmt.add(|Range|, |RANG|)
      endif
      -- Check for different format values
      !displayFmt = !this.checkVaries(!form, !answerFormats)
      if (!displayFmt eq !form.varyStr) then
        !form.opItemFmt.add(!form.varyStr)
      endif

      if (!form.opItemFmt.rtext.find(!displayFmt).set()) then
        !form.opItemFmt.select(|RTEXT|, !displayFmt)
        -- Display format help string
        if (!form.opItemFmt.selection() eq !form.varyStr) then
          !form.paItemFmt.val = !form.answerFmts[4]
        else
          !form.paItemFmt.val = !form.answerFmts[!form.opItemFmt.val]
        endif

        -- Check for different answer values and display
        !displayValue = !this.checkVaries(!form, !answerValues)

        !form.txItemAns.val = !this.txEmptyToUnset(!displayValue)

        -- Answer fields active
        !form.opItemFmt.active = true
        !form.txItemAns.active = true
        !form.paItemFmt.active = true
      else
        !form.opItemFmt.active = false
        !form.txItemAns.active = false
        !form.paItemFmt.active = false
      endif
    endif

  endif

  -- Display item attributes
  if (!attribFields) then
    if (!form.selectedRows.empty().not()) then
      -- Get selected answer details for selected table items
      !itemNames = ARRAY()
      !itemprtrefs = ARRAY()
      !itemStates = ARRAY()
      do !val values !form.selectedRows
        !name = !form.selTable.getItemName(!val)
        !itemNames.append(!name)
        if (!form.selTable.items[!val].prtref.set()) then
          !part = !form.selTable.items[!val].prtref.namn
        else
          !part = !form.selTable.items[!val].prtref.string()
        endif
        !itemprtrefs.append(!part)
        !state = !form.selTable.items[!val].lactive
        !itemStates.append(!state)
      enddo
      -- Display item name
      !displayName = !this.checkVaries(!form, !itemNames)
      !form.txItemName.val = !displayName
      if (!displayName eq !form.varyStr) then
        !form.txItemName.active = false
      else
        !form.txItemName.active = true
      endif
      -- Display part ref name
      !displayName = !this.checkVaries(!form, !itemprtrefs)
      !form.txPartref.val = !displayName
      if (!displayName eq !form.varyStr) then
        !form.txPartref.active = false
      else
        !form.txPartref.active = true
      endif
      -- Display active state
      !itemStates.unique()
      if (!itemStates.size() gt 1) then
        !form.frItemStatus.val = 0
      elseif (!itemStates[1]) then
        !form.frItemStatus.val = 1
      else
        !form.frItemStatus.val = 2
      endif
    else
      !form.txItemName.clear()
      !form.txItemName.active = false
      !form.txPartref.clear()
      !form.txPartref.active = false
      !form.frItemStatus.val = 0
    endif
  endif

  -- Display format help string
  if (!format) then
    -- Get selected answer index
    !form.paItemFmt.val = !form.answerFmts[!form.opItemFmt.val]
  endif

endmethod
-- End of method definition for .initItems(FORM)

------------------------------------------------------------------------
--
-- Method:      actionItems
--
-- Description:  Gadget actions for Answers panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionItems(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  -- Button actions
  -- Apply
  if (!object eq !form.bnItemApply and !action eq |SELECT|) then
    -- Remember selected rows
    !rowIndices = !form.selectedRows

    -- Set attributes
    -- Name
    !name = !form.txItemName.val
    if (!name eq !form.varyStr) then
      !attribVals[1] = object STRING()
    else
      !attribVals[1] = !name
    endif
    -- Part ref
    !partRefName = !form.txPartref.val
    if (!partRefName eq !form.varyStr) then
      !attribVals[2] = object DBREF()
    elseif (!partRefName.substring(1,1) ne '/' and !partRefName.substring(1,1) ne '=') then
      !newName = '/' & !partRefName
      !attribVals[2] = !newName.dbref()
    else
      !attribVals[2] = !partRefName.dbref()
    endif
    -- Active status
    if (!form.frItemStatus.val eq 0) then
      !attribVals[3] = object BOOLEAN()
    elseif (!form.frItemStatus.val eq 1) then
      !attribVals[3] = true
    else
      !attribVals[3] = false
    endif
    -- Set item attributes for selected table items
    do !val values !form.selectedRows
      !form.selTable.setItemAtts(!form.selTable.items[!val], !attribVals)
    enddo

    -- Set answers
    !index = !form.lsItemQues.val
    -- Set answer for selected table items
    if (!index gt 0) then
      -- Get answer value
      !answer = !this.txUnsetToEmpty(!form.txItemAns.val).trim()
      if (!answer eq !form.varyStr) then
        !answerVals[1] = object STRING()
      else
        !answerVals[1] = !answer
      endif
      -- Get answer format
      !format = !form.opItemFmt.selection()
      if (!format eq !form.varyStr) then
        !answerVals[2] = object STRING()
      else
        !answerVals[2] = !format
      endif
      -- Set answer for selected table items
      do !val values !form.selectedRows
        !form.selTable.setAnswer(!form.selTable.items[!val], !index, !answerVals)
      enddo
    endif

    -- Update main table on form
    !this.populateTable(!form)
    -- Reselect the rows
    !this.netSelectRows(!form, !rowIndices)
    -- Update item panel on form
    !this.initItems(!form, false, true, true, false)

  -- Criteria list
  elseif (!object eq !form.lsItemQues) then
    if (!action eq |SELECT|) then
      !this.initItems(!form, false, true, false, false)
    elseif (!action eq |UNSELECT|) then
      !this.initItems(!form, false, true, false, false)
    endif

  -- Answer format option list
  elseif (!object eq !form.opItemFmt and !action eq |SELECT|) then
    !this.initItems(!form, false, false, false, true)

  -- Cancel
  elseif (!object eq !form.bnItemCancel and !action eq |SELECT|) then
    !this.managePanels(!form.frTasks, '')

  endif

endmethod
-- End of method definition for .actionItems()

------------------------------------------------------------------------
--
-- Method:      initSearch
--
-- Description: Initialise Search panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSearch(!form is FORM)

  -- Set initial search criteria
  -- Data base types
  !dbType = |CATA|
  -- Element types
  !eleTypes = ARRAY()
  !eleTypes[1] = |GPART|
  -- Scope list
  !scope = ARRAY()
  !scope[1] = |/*|
  -- Attribute filters
  !filters = ARRAY()
  !filters[1] = |NAME like *|
  -- Results columns
  !columns = ARRAY()
  !columns[1] = |PRITYP Type|
  !columns[2] = |SECTYP Sub-Type|
  !columns[3] = |DESC Description|
  !columns[4] = |NAME Name|

  -- Initialise search control
  !displayResults = false
  !form.searchControl.initiateSearch(!displayResults, |Search|, !dbType, !scope, !eleTypes, !filters, !columns)

endmethod
-- End of method definition for .initSearch(FORM)

------------------------------------------------------------------------
--
-- Method:      actionSearch
--
-- Description:  Gadget actions for Search panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionSearch(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  -- Button actions
  -- Add selected search results to table
  if (!object eq !form.bnSearchAdd and !action eq |SELECT|) then
    !this.addToTable(!form, !form.searchResults)
    -- Set Edit Items panel visible
    !this.managePanels(!form.bnEditItems, '')

  -- Initialise new search
  elseif (!object eq !form.bnSearchNew and !action eq |SELECT|) then
    !this.initSearch(!form)

  -- Cancel
  elseif (!object eq !form.bnSearchCancel and !action eq |SELECT|) then
    !this.managePanels(!form.frTasks, '')

  endif

endmethod
-- End of method definition for .actionSearch()

------------------------------------------------------------------------
--
-- Method:      netResultsSelected
--
-- Description: Select the specified rows on the specified form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
--    2   R      ARRAY       Rows to be selected
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netResultsSelected(!form is FORM, !rows is ARRAY)

  -- Save search results as dbref's
  !dbrefNos = ARRAY()
  do !val values !rows
    !dbrefNos.append(!val)
  enddo
  !form.searchResults = !dbrefNos.evaluate(object BLOCK(|!dbrefNos[!evalIndex].dbref()|))

endmethod
-- End of method definition for .netResultsSelected(FORM, ARRAY)

------------------------------------------------------------------------
--
-- Method:      populateTable
--
-- Description: Populate form table from selection table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .populateTable(!form is FORM)

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Initialise column headings
  !selTabHdg = ARRAY()

  -- Get currently selected type
  !typeIndex = !form.opTableTypes.selection().real()

  -- Heading for item active state
  !selTabHdg.append('Active')

  -- Heading for item active state
  !selTabHdg.append('Item Name')

  -- Headings for questions
  if (!typeIndex gt 0) then
    !questions = !form.selTable.getQuestions()
    do !ind indices !questions
      !selTabHdg[!ind + 2] = !questions[!ind][1] $* question purpose
      --!selTabHdg[!ind + 2] = !questions[!ind][2] $* question description
      if (!selTabHdg[!ind + 2].empty()) then
        !selTabHdg[!ind + 2] = |Unset|
      endif
    enddo
  endif
  -- Headings for gpart attributes
  !attHdgs = ARRAY()
  !attHdgs.append(|Part Name|)
  !attHdgs.append(|Primary Type|)
  !attHdgs.append(|Sub Type|)
  !attHdgs.append(|Description|)
  !selTabHdg.appendArray(!attHdgs)

  !form.selTable.setHeadingsList()

  -- Get table item details for the table rows (from SelectionItem members)
  !selTabRowSet = object ARRAY()
  if (!typeIndex gt 0) then
    !selTabRowSet = !form.selTable.getItems()
  endif

  -- If there are no items in the table then a dummy row is needed to show the headings
  if (!selTabRowSet.unset() or !selTabRowSet.empty()) then
    do !ind indices !selTabHdg
      !selTabRowSet[1][!ind] = !form.emptyString
    enddo
  endif

  -- Clear grid ready for repopulating
  !form.ngcTable.clearGrid()

  -- Total indicator
  !selTabTi = 'Selection Table'

  -- Bind to data source
  !ndsTable = object NETDATASOURCE(!selTabTi, !selTabHdg, !selTabRowSet)
  !form.ngcTable.bindToDataSource(!ndsTable)
  -- Select first row in the list
  !form.ngcTable.selectRow(0)

endmethod
-- End of method definition for .populateTable()

------------------------------------------------------------------------
--
-- Method:      addToTable
--
-- Description: Pop up menu event for .net control on the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
--    2   R      ARRAY       Grid data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addToTable(!form is FORM, !gparts is ARRAY)

$(
  -- Don't allow duplicate gparts in spec
  !itemGparts = !form.selTable.items.evaluate(object BLOCK(|!form.selTable.items[!evalIndex].prtref|))
  !newGparts = ARRAY()
  do !ind indices !gparts
    if (!itemGparts.findfirst(!gparts[!ind]).unset()) then
      !newGparts.append(!gparts[!ind])
    endif
  enddo
  if (!newGparts.empty()) then
    !!alert.warning(|Table items already exist for these GPART's|)
    return
  endif
$)

  !newGparts = !gparts
  -- Get index position to insert new items
  !insertIndex = !form.selTable.getItemCount() + 1
  ---- Add each gpart to the selection table
  !newIndices = !form.selTable.newItems(!newGparts, !insertIndex)

  -- Check for autonaming
  !dbPos = !!ce
  if (!!namOpt.auto()) then
    do !val values !newIndices
      !!ce = !form.selTable.items[!val]
      !newName = '/' & !!namOpt.nameString(!!ce, string(), false, false)
      if (!newName.set()) then
        !!ce.name = !newName
      endif
    enddo
  endif
  !!ce = !dbPos

  -- Update form
  !this.populateTable(!form)
  -- Select new parts
  !this.netSelectRows(!form, !newIndices)

endmethod
-- End of method definition for .addToTable(FORM, ARRAY)

------------------------------------------------------------------------
--
-- Method:      netPopupCallback
--
-- Description: Pop up menu event for .net control on the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
--    2   R      ARRAY       Grid data
--                           [0] Cursor X
--                           [1] Cursor Y
--                           [2] Array of selected row tags (STRING data type)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netPopupCallback(!form is FORM, !data is ARRAY)

  -- Set menu fields that are valid for single selection only
  if (!form.selectedRows.size() eq 1) then
    !form.puTable.setFieldProperty('NAVIGATE', 'ACTIVE', true)
    !form.puTable.setFieldProperty('EDIT', 'ACTIVE', true)
    -- Set menu fields for valid reference attributes only
    !refStr = |prtref CATREF TMPREF|
    !refs = !refStr.split()
    do !val values !refs
      !popupFieldName = 'NAV' & !val
      !dbref = !form.selTable.items[!form.selectedRows[1]].attribute(!val)
      handle (2,232)
        !form.puNavigateList.setFieldProperty(!popupFieldName , 'ACTIVE', false)
      elsehandle none
        if (!dbref.badref()) then
          !form.puNavigateList.setFieldProperty(!popupFieldName , 'ACTIVE', false)
        else
          !form.puNavigateList.setFieldProperty(!popupFieldName , 'ACTIVE', true)
        endif
      endhandle
    enddo
    -- Set edit menu fields depending of valid refs
    if (!form.selTable.items[!form.selectedRows[1]].prtref.badref()) then
      !form.puTable.setFieldProperty('EDIT', 'ACTIVE', false)
    else
      !form.puTable.setFieldProperty('EDIT', 'ACTIVE', true)
      if (!form.selTable.items[!form.selectedRows[1]].prtref.catref.badref()) then
        !form.puEditList.setFieldProperty('EDITCATE', 'ACTIVE', false)
      else
        !form.puEditList.setFieldProperty('EDITCATE', 'ACTIVE', true)
      endif
    endif
  else
    !form.puTable.setFieldProperty('NAVIGATE', 'ACTIVE', false)
    !form.puTable.setFieldProperty('EDIT', 'ACTIVE', false)
  endif
  -- Activate copy and paste fields
  !form.puTable.setFieldProperty('COPY', 'ACTIVE', true)
  !form.puTable.setFieldProperty('PASTE', 'ACTIVE', !form.clipboard.empty().not())

  -- Show popup
  !form.conTable.showPopup(!data[0], !data[1])

endmethod
-- End of method definition for .netPopupCallback(FORM, ARRAY)

------------------------------------------------------------------------
--
-- Method:      tablePopup
--
-- Description: Pop up menu actions for .net control on the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU       Pop up menu for .net control
--    1   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tablePopup(!object is MENU, !action is STRING)

  -- Get calling popup menu details
  !form = !object.owner()
  !pickedField = !object.pickedFieldName

  --Source spec popup
  if (!pickedField eq 'NAVTABITE') then
    !!ce = !form.selTable.items[!form.selectedRows[1]]
  elseif (!pickedField eq 'NAVprtref') then
    !!ce = !form.selTable.items[!form.selectedRows[1]].prtref
  elseif (!pickedField eq 'NAVCATREF') then
    !!ce = !form.selTable.items[!form.selectedRows[1]].catref
  elseif (!pickedField eq 'NAVTMPREF') then
    !!ce = !form.selTable.items[!form.selectedRows[1]].tmpref
  elseif (!pickedField eq 'EDITPART') then
      !!ce = !form.selTable.items[!form.selectedRows[1]].prtref
      !!catPartViews.add()
  elseif (!pickedField eq 'EDITCATE') then
    !!ce = !form.selTable.items[!form.selectedRows[1]].catref
        !!catModelViews.add()
  elseif (!pickedField eq 'COPY') then
      -- Retrieve selected dbRefs from table
      !form.clipboard.clear()
      do !row values !form.selectedRows
        !form.clipboard.append(!form.selTable.items[!row])
      enddo
  elseif (!pickedField eq 'PASTE') then
   !addedItemIndices = !form.selTable.copyItems(!form.clipboard)
   !this.populateTable(!form)
   !this.netSelectRows(!form, !addedItemIndices)
  endif

endmethod
-- End of method definition for .tablePopup()

------------------------------------------------------------------------
define method .linkLabelCall(!gadget is GADGET, !action is STRING)

  !form = !gadget.owner()

if (!gadget eq !form.bnEditModel) then
        !!ce  = !form.selTable.items[!form.selectedRows[1]].catref
        handle any
           return
        endhandle
        !!catModelViews.add()
else
        !!ce  = !form.selTable.items[!form.selectedRows[1]].prtref
        handle any
           return
        endhandle
        !!catPartViews.add()
endif

endmethod
------------------------------------------------------------------------
--
-- Method:      netAfterSelect
--
-- Description: After select event for .net control on the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
--    2   R      ARRAY       Grid data, !a[0] is array of selected row tags
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netAfterSelect(!form is FORM, !a is ARRAY)

  -- Only process genuine user select events
  if (!a[0].set()) then
    -- Don't select the 'empty' row when table is empty
    if (!form.ngcTable.getRow(1)[1] eq !form.emptyString) then
      return
    endif
    -- Select items
    !form.selectedRows.clear()
    do !val values !a[0]
      !form.selectedRows.append(!val.real())
    enddo
  else
    !form.selectedRows.clear()
  endif

  -- Initialise panels for the new selection
  !this.initTasks(!form)
  !this.initItems(!form, false, true, true, false)

endmethod
-- End of method definition for .netAfterSelect(FORM, ARRAY)

------------------------------------------------------------------------
--
-- Method:      netSelectRows
--
-- Description: Select the specified rows on the specified form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
--    2   R      ARRAY       Rows to be selected
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netSelectRows(!form is FORM, !rows is ARRAY)

  -- Clear selection
  if (!rows.unset() or !rows.empty()) then
    -- Turn grid events off and on to avoid update
    !form.ngcTable.allGridEvents(false)
    !form.ngcTable.clearRowSelection()
    !form.ngcTable.allGridEvents(true)
    -- Clear form selection
    !form.selectedRows.clear()

  -- Don't select the 'empty' row when table is empty
  elseif (!rows.size() eq 1 and !form.ngcTable.getRow(1)[1] eq !form.emptyString) then
    return

  -- Select rows
  elseif (!rows.size() gt 0) then
    !rowTags = ARRAY()
    do !val values !rows
      !rowTags.append(!val.string())
    enddo
    -- Turn grid events off and on to avoid updating for every index
    !form.ngcTable.allGridEvents(false)
    !form.ngcTable.setSelectedRowTags(!rowTags)
    !form.ngcTable.allGridEvents(true)
    -- Reset form selection
    !form.selectedRows = !rows

  endif

  -- Initialise panels for the new selection
  !this.initTasks(!form)
  !this.initItems(!form, false, true, true, false)

endmethod
-- End of method definition for .netSelectRows(FORM, ARRAY)

------------------------------------------------------------------------
--
-- Method:      buttonPick
--
-- Description: Show child form on button pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .buttonPick(!gadget is GADGET, !action is STRING)

  -- Get form from which button was pressed
  !parentForm  = !gadget.owner()

  -- Check child form has been defined
  if (undefined(!!catChildForm)) then
    pml load form !!catChildForm
  endif

  -- Setup and display form
  !!catChildForm.setup(|for | & !parentForm.formTitle)
  !!catChildForm.show()

endmethod
-- End of method definition for .buttonPick(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: Remove selTab view from the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .remove(!selTabView is FORM)

  -- Get form index
  !index = !this.viewIndex(!selTabView)

  -- Return if we can't find the form in the system
  if (!index.unset()) then
    return
  endif

  -- Remove form from the system
  !this.selTabViews[!index].delete()

  -- Kill the form
  !formString = '!!' & !selTabView.string()
  kill $!<formString>

  -- Update control form if exists and shown
  if (defined(!!catControl)) then
    if (!!catControl.shown()) then
      !!catControl.initialise()
    endif
  endif

endmethod
-- End of method definition for .remove(FORM)

------------------------------------------------------------------------
--
-- Method:      viewIndex
--
-- Description: Get form index in the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
-- Return:
--   [Data Type] [Description]
--    REAL        Index in the form list
--
------------------------------------------------------------------------
define method .viewIndex(!form is FORM) is REAL

  -- Loop through list
  do !i indices !this.selTabViews
    if (!form eq !this.selTabViews[!i]) then
      return !i
    endif
  enddo
  return REAL()

endmethod
-- End of method definition for .viewIndex(FORM) REAL

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Form bar menu selected from
--    2   R      STRING      Select state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close(!menu is MENU, !dummyselected is STRING)

  -- Remove form from the system
  !form   = !menu.owner()
  !unusedfield  = !menu.pickedField
  !this.remove(!form)

endmethod
-- End of method definition for .close(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close(!form is FORM)

  -- Remove form from the system
  !this.remove(!form)

endmethod
-- End of method definition for .close(FORM)

------------------------------------------------------------------------
--
-- Method:      nextAvailable
--
-- Description: Next available form number
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        Available number
--
------------------------------------------------------------------------
define method .nextAvailable() is REAL

  -- Return next
  return !this.selTabViews.maxIndex() + 1

endmethod
-- End of method definition for .nextAvailable() is REAL

------------------------------------------------------------------------
--
-- Method:      setFormName
--
-- Description: Set the form name to the Selection Table name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setFormName(!form is FORM)

  !form.formTitle     = !form.selTable.name
  !form.iconTitle     = !form.selTable.name

endmethod
-- End of method definition for .setFormName(FORM)

------------------------------------------------------------------------
--
-- Method:      updateRecentSelTables
--
-- Description: Update recent selection tables list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .updateRecentSelTables(!form is FORM)

  -- Update recent parts list
  !form.opRecentSelTables.dtext = !!catRecentObjects.dtext(|TABGRO|)
  !form.opRecentSelTables.rtext = !!catRecentObjects.rtext(|TABGRO|)

endmethod
-- End of method definition for .updateRecentSelTables(FORM)

------------------------------------------------------------------------
--
-- Method:      txEmptyToUnset
--
-- Description: Convert empty stings to unset strings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        Available number
--
------------------------------------------------------------------------
define method .txEmptyToUnset(!text is STRING) is STRING

  if (!text.set() and !text.empty()) then
    return object STRING()
  else
    return !text
  endif

endmethod
-- End of method definition for .txEmptyToUnset(STRING)

------------------------------------------------------------------------
--
-- Method:      txUnsetToEmpty
--
-- Description: Convert unset strings to empty strings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        Available number
--
------------------------------------------------------------------------
define method .txUnsetToEmpty(!text is STRING) is STRING

  if (!text.unset()) then
    return ''
  else
    return !text
  endif

endmethod
-- End of method definition for .txUnsetToEmpty(STRING)

------------------------------------------------------------------------
--
-- Method:      checkVaries
--
-- Description: Check if array values are the same or vary
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       SelTab view form
--    2   R      ARRAY       Values to check
--
-- Return:
--   [Data Type] [Description]
--    REAL        The value or the varies string (specified in form member)
--
------------------------------------------------------------------------
define method .checkVaries(!form is FORM, !values is ARRAY) is STRING

  -- Check for differences and assign value accordingly
  !values.unique()
  if (!values.size() ne 1) then
  -- Must be differences
    return !form.varyStr
  else
  -- Must be the same
    return !values[1]
  endif

endmethod
-- End of method definition for .checkVaries(FORM, ARRAY)

------------------------------------------------------------------------
--
-- Method:      checkNameField
--
-- Description: Check name entered into text field
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkNameField(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()
  !objectName = !object.name()

  -- Name text fields
  if (!objectName inset(|TXTABLEATTSNAME|, |TXTYPEATTSNAME|, |TXITEMNAME|) and !action eq |SELECT|) then

    -- Get name from text field and verify
    !enteredName = !object.val.trim()
    !name = !!checkName(!enteredName, |NEW|)

    -- Entered name is invalid so restore previous name in text field
    if (!name.unset() or !enteredName.substring(1,1) eq '=') then
      -- Table name
      if (!objectName eq |TXTABLEATTSNAME|) then
        !object.val = !form.selTable.name
      -- Type name
      elseif (!objectName eq |TXTYPEATTSNAME|) then
        !object.val = !form.selTable.getTypeAtts()[2]
      -- Item name
      elseif (!objectName eq |TXITEMNAME|) then
        !this.initItems(!form, false, false, true, false)
      endif

    -- Entered name is ok so accept it
    else
      !object.val = !name.after('/')
    endif

  -- Reference text fields
  elseif (!objectName eq |txPartref| and !action eq |SELECT|) then

    -- Get name from text field and verify
    !enteredName = !object.val.trim()

    -- Make sure first character is a '/' or '='
    if (!enteredName.substring(1,1) ne '/' and !enteredName.substring(1,1) ne '=') then
      !name = '/' & !enteredName
    else
      !name = !enteredName
    endif

    -- Check for valid name
    !dbref = !name.dbref()
    handle (2,109)(2,813)
      -- Name is invalid so restore previous name in text field
      !!alert.warning(|Invalid part reference name!|)
      !this.initItems(!form, false, false, true, false)
    elsehandle none
      -- Entered name is ok so accept it
      if (!enteredName.substring(1,1) eq '/') then
        !object.val = !enteredName.after('/')
      else
        !object.val = !enteredName
      endif
    endhandle

  endif

endmethod
-- End of method definition for .checkNameField(GADGET, STRING)
