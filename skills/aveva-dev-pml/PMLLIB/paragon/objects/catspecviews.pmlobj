    -- Rename panel
    path down
    frame .frRename anchor bottom + left + right at xmin.frSpec ymin.frSpec width 80 height 13
      frame .frRenameOptions panel at xmin+1 ymin + 1
        rtoggle .rtRenameAuto 'Auto Name'
        rtoggle .rtRenameName 'Specify'
        rtoggle .rtRenameReplace 'Replace'
        rtoggle .rtRenameSizes 'Sizes'
        toggle  .tRenameComponents 'Rename Components' tagWidth 14 at ymax .rtRenameSizes - 1
      exit
      frame .frRenameDetails panel anchor left + right at xmax+3 ymin
        text .txRenameDetail1 tagwidth 7 'Detail1' anchor left + right at xmax.tRenameComponents + 1 width 50 scroll 60 is STRING
        text .txRenameDetail2 tagwidth 7 'Detail2' anchor left + right at ymax+1 width 50 scroll 60 is STRING
      exit
      path left
      button .bnRenameBack 'Back'   anchor right at xmax.frRename-10 ymax.frRename-1.25 width 7
      button .bnRenameApply 'Apply' anchor right                                        width 7
    exit

    -- Search definition panel
    path down
    frame .frSearch 'Search Items'                      anchor bottom + left + right at xmin.frSpec ymin.frSpec width 80 height 13
      container .conSearch nobox PmlNetControl 'Search' anchor all width 78 height 10
      path left
      button .bnSearchBack 'Back'        anchor right at xmax.frSearch-10 ymax.frSearch-1.25 width 8
      button .bnSearchNew 'New Search'   anchor right width 8
      button .bnSearchAdd 'Use Selected' anchor right width 12
    exit

