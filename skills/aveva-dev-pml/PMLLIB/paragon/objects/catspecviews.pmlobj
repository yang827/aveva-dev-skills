      button .bnSpecAddComps     linklabel                                           width 12 'Add New Items...'
      button .bnSpecAddLimbo     linklabel                                           width 12 'Add From Limbo...'
      button .bnSpecEditCompAns  linklabel                                           width 12 'Edit Answers...'
      button .bnSpecEditCompRefs linklabel                                           width 12 'Edit References...'
      button .bnSpecEditUserAtts linklabel                                           width 12 |Edit Extra UDA's...|
      button .bnSpecCompRename   linklabel                                           width 12 'Rename Items...'
      line .lnSpecComps2        at ymin.frSpec+8.5 horizontal                        width 10                      height 0.5
      button .bnSpecRemComps     linklabel                                           width 12 'Remove to Limbo'
      button .bnSpecDelComps     linklabel                                           width 12 'Delete Permanently'
    exit

