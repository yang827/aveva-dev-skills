    !form.isModReducer = true

  -- Description
  elseif (!object eq !form.txReducerDesc and !action eq |SELECT|) then
    !form.isModReducer = true

  -- Back
  elseif (!object eq !form.bnReducerBack and !action eq |SELECT|) then
    if (!form.isModReducer eq true and dbwrite) then
      !confirm = !!alert.question(|Apply changes before going back?|)
      if (!confirm eq |CANCEL|) then
        return
      elseif (!confirm eq |YES|) then
        !this.applyReducer(!form)
      else
        !form.isModReducer = false
      endif
    endif
    !this.manageMainPanels(!form.frCompTable)
