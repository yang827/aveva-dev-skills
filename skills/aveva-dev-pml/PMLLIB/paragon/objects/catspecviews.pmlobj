    member .compEditCatref    is STRING
    member .compEditDetail    is STRING
    member .compEditMatxt     is STRING
    member .compEditCmpref    is STRING
    member .compEditBltref    is STRING
    member .compEditTmpref    is STRING
    member .compEditPDaRef    is STRING

    path right
    button .bnce 'CE'
    option .opRecentCes width 30

    -- Components
    option .opHeadings 'Headings' tagwidth 7         at xmax+5                   width 15
    frame .frCompTable panel 'Components' anchor all at xmin form ymax.bnce+0.25 width 80 height 19
      -- Grid control for spec components table
      container .conCompTable nobox PmlNetControl 'Table' anchor all    at xmin.bnce ymax.bnce width 79 height 17
      frame .frViewMode panel                             anchor bottom at xmin+28 ymax
        rtoggle .rtStandard 'Eng. View' tagwidth 7
        rtoggle .rtCad 'CAD View' tagwidth 7
      exit
      button .bnRowSelAll linklabel  anchor bottom + right width 6 'Select All' at xmax+10 ymax.conCompTable+0.25
      button .bnRowSelNone linklabel anchor bottom + right width 9 'Clear Selection'
    exit

    -- Nominal bores
    frame .frConNomBore panel 'Nominal Bores'              anchor all at xmin.frCompTable ymin.frCompTable width 80 height 26
