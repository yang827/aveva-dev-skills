    member .currentQues            is ARRAY
    member .currentQuals           is ARRAY
    member .currentDflts           is ARRAY
    member .components             is ARRAY
    member .updateList             is ARRAY
    member .selectedRows           is ARRAY
    member .compAdddbref           is DBREF
