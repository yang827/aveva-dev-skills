      option .opSpecBltMeth 'Bolting Method' tagwidth 12 at xmax+7 noReselect    width 8
      text .txSpecAttMatRef tagwidth 15 'Material Text Ref.' anchor left + right at xmin.opSpeclineType ymax+0.5 width 50 scroll 60 is STRING
      button .bnSpecAttMatRefS      anchor right pixmap                          width 1
      button .bnSpecAttMatRefC 'CE' anchor right at xmax+2                       width 2
      text .txSpecAttFluRef tagwidth 15 'Fluid Ref.' anchor left + right at xmin.txSpecAttMatRef ymax.txSpecAttMatRef+0.25 width 50 scroll 60 is STRING
      button .bnSpecAttFluRefS      anchor right pixmap                          width 1
      button .bnSpecAttFluRefC 'CE' anchor right at xmax+2                       width 2
      text .txSpecAttBspec tagwidth 15 'Bolt Spec.' anchor left + right at xmin.txSpecAttFluRef ymax.txSpecAttFluRef+0.25 width 50 scroll 60 is STRING
      button .bnSpecAttBspecS      anchor right pixmap                           width 1
