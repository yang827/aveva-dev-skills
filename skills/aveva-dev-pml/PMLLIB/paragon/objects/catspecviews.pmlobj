endmethod
-- End of method definition for .actionReducer(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      applyReducer
--
-- Description: Apply action for Reducer panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyReducer(!form is FORM)

  -- Set db element attributes
  !name = !this.txUnsetToEmpty(!form.txReducerName.val).trim()
  !this.setName(!form, !form.reducerTab, !name)
  !form.reducerTab.purpose = !this.txUnsetToEmpty(!form.txReducerPurp.val).trim()
  !form.reducerTab.description = !this.txUnsetToEmpty(!form.txReducerDesc.val).trim()

  -- Reset panel modified flag
  !form.isModReducer = false

  -- Apply button action.
  !form.netReducer.savedata()

endmethod
-- End of method definition for .applyReducer(FORM)

------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      initTapping
--
-- Description: Initialise Tapping table for specification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initTapping(!form is FORM)

  -- Check that initialisation is required
  if (!form.isInitTapping.not()) then
    !form.isInitTapping = true
    return
  endif

  using namespace  'Aveva.Pdms.Presentation'

  -- Set current bore units
  !boreUnitFlag = !form.metricBoreFlag

  -- Initialise Tapping short codes
  !shortCodes = !!catPipeTableCodes.getCodes(|Tapping|)
  -- Set type flag false for Tapping table
  !typeFlag = TRUE
  -- Get table name
  !branName = !form.TappingTab.name
  !reduName = !form.branchTab.name
  handle (2,754)
  !reduName = ''
  endhandle

  -- Populate branch/Tapping table
  !form.frConTapping.visible = false
  !tds = object PTABLEBRDATASOURCE(!branName, !reduName, !shortCodes, !boreUnitFlag, !typeFlag, !!catPipeTableCodes.branGreyAreareadOnly)
  !form.netTapping.bindToDataSource(!tds)
  !form.frConTapping.visible = true

  -- Initialise attribute panel
  !form.txTappingName.val = !form.TappingTab.namn
  !form.txTappingPurp.val = !this.txEmptyToUnset(!form.TappingTab.purpose)
  !form.txTappingDesc.val = !this.txEmptyToUnset(!form.TappingTab.description)

  -- Reset panel modified flag
  !form.isModTapping = false

endmethod
-- End of method definition for .initTapping(FORM)

------------------------------------------------------------------------
--
-- Method:      actionTapping
--
-- Description: Gadget actions for Tapping table panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionTapping(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  -- Gadget actions
  -- Name
  if (!object eq !form.txTappingName and !action eq |SELECT|) then
    !validatedName = !!catValidateNameField(!form.txTappingName)
    if (!validatedName.set() and !validatedName.empty()) then
      !prevName = !form.TappingTab.namn
      !form.txTappingName.val = !prevName
    endif
    !form.isModTapping = true

  -- Purpose
  elseif (!object eq !form.txTappingPurp and !action eq |SELECT|) then
    !form.isModTapping = true

  -- Description
  elseif (!object eq !form.txTappingDesc and !action eq |SELECT|) then
    !form.isModTapping = true

  -- Back
  elseif (!object eq !form.bnTappingBack and !action eq |SELECT|) then
    if (!form.isModTapping eq true and dbwrite) then
      !confirm = !!alert.question(|Apply changes before going back?|)
      if (!confirm eq |CANCEL|) then
        return
      elseif (!confirm eq |YES|) then
        !this.applyTapping(!form)
      else
        !form.isModTapping = false
      endif
    endif
    !this.manageMainPanels(!form.frCompTable)
    !this.popTaskPanel(!form)
    return

  endif

endmethod
-- End of method definition for .actionTapping(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      applyTapping
--
-- Description: Apply action for Tapping panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyTapping(!form is FORM)

  -- Set db element attributes
  !name = !this.txUnsetToEmpty(!form.txTappingName.val).trim()
  !this.setName(!form, !form.TappingTab, !name)
  !form.TappingTab.purpose = !this.txUnsetToEmpty(!form.txTappingPurp.val).trim()
  !form.TappingTab.description = !this.txUnsetToEmpty(!form.txTappingDesc.val).trim()

  -- Reset panel modified flag
  !form.isModTapping = false

  -- Apply button action.
  !form.netTapping.savedata()

endmethod
-- End of method definition for .applyTapping(FORM)

------------------------------------------------------------------------




--
-- Method:      initSpecGenAtts
--
-- Description: Initialise specification general attributes panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSpecGenAtts(!form is FORM)
  -- Check that initialisation is required
  if (!form.isInitSpecGenAtts.not()) then
    !form.isInitSpecGenAtts = true
    return
  endif

  -- Name
  !specName = !form.specification.name()
  if (!specName.substring(1,1) eq '/') then
    !specName = !specName.after('/')
  endif
  !form.txSpecAttName.val = !specName

  -- ***
  !form.txSpecAttDesc.val = !this.txEmptyToUnset(!form.specdbref.description)

  -- Discipline
  !discipline = !form.specification.disciplineText()
  !legalDisciplines = !form.opSpecType.rtext
  if (!discipline.empty() or !legalDisciplines.findFirst(!discipline).unset()) then
    !form.opSpecType.select('RTEXT', 'NONE')
  else
    !form.opSpecType.select('RTEXT', !discipline)
  endif

  -- ***
  !form.txSpecInputBy.val = !this.txEmptyToUnset(!form.specdbref.finputby)
  !form.txSpecIssue.val = !this.txEmptyToUnset(!form.specdbref.fissue)
  !form.txSpecStatus.val = !this.txEmptyToUnset(!form.specdbref.fstatus)
  !form.bnSpecGenAttApply.active = !form.isSpecUpdateable

  -- Reset panel modified flag
  !form.isModSpecGenAtts = false

endmethod
-- End of method definition for .initSpecGenAtts(FORM)

------------------------------------------------------------------------
--
-- Method:      actionSpecGenAtts
--
-- Description: Gadget actions for spec engineering attributes panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionSpecGenAtts(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  -- Gadget actions
  -- Name
  if (!object eq !form.txSpecAttName and !action eq |SELECT|) then
    !validatedName = !!catValidateNameField(!form.txSpecAttName)
    if (!validatedName.set() and !validatedName.empty()) then
      !prevName = !form.specification.name()
      if (!prevName.substring(1,1) eq '/') then
        !prevName = !prevName.after('/')
      endif
      !form.txSpecAttName.val = !prevName
    endif

  -- *** Modify all attributes
  elseif (!object eq !form.bnSpecGenAll and !action eq |SELECT|) then
    !!ce = !form.specdbref
    !!catModifyAttribs()

  -- Back button
  elseif (!object eq !form.bnSpecGenAttBack and !action eq |SELECT|) then
    if (!form.isModSpecGenAtts eq true and !form.isSpecUpdateable) then
      !confirm = !!alert.question(|Apply changes before going back?|)
      if (!confirm eq |CANCEL|) then
        return
      elseif (!confirm eq |YES|) then
        !this.applySpecGenAtts(!form)
      else
        !form.isModSpecGenAtts = false
      endif
    endif
    !this.popTaskPanel(!form)
    return

  endif

  -- Set the frames modified flag to true
  if (!object ne !form.bnSpecGenAll) then
    !form.isModSpecGenAtts = true
  endif

endmethod
-- End of method definition for .actionSpecGenAtts(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      applySpecGenAtts
--
-- Description: Apply action for spec engineering attributes panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applySpecGenAtts(!form is FORM)

  -- Specification type
  !discipline = !form.opSpecType.selection()
  if (!discipline eq |NONE|) then
    !confirm = !!alert.confirm(|Spec Type is not set, are you sure you want to proceed?|)
    if (!confirm eq |NO|) then
      return
    else
      !discipline = ||
    endif
  endif

  -- set Spec purpose from discipline
  if (!discipline eq |PIPING|) then
    !form.specdbref.purpose = |PIPE|
  else
    !form.specdbref.purpose = !discipline
  endif

  !form.specification.setDisciplineText(!discipline)
  !this.saveToDb(!form, false)

  -- Reset form title
  !this.setFormName(!form)

  -- Set db element attributes
  !form.specdbref.description = !this.txUnsetToEmpty(!form.txSpecAttDesc.val).trim()
  !form.specdbref.finputby    = !this.txUnsetToEmpty(!form.txSpecInputBy.val).trim()
  !form.specdbref.fissue      = !this.txUnsetToEmpty(!form.txSpecIssue.val).trim()
  !form.specdbref.fstatus     = !this.txUnsetToEmpty(!form.txSpecStatus.val).trim()

  -- Unset modified flag
  !form.isModSpecGenAtts = false

endmethod
-- End of method definition for .applySpecGenAtts(FORM)

------------------------------------------------------------------------
--
-- Method:      initSpecCadAtts
--
-- Description: Initialise specification CAD attributes panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSpecCadAtts(!form is FORM)

  -- Check that initialisation is required
  if (!form.isInitSpecCadAtts.not()) then
    !form.isInitSpecCadAtts = true
    return
  endif

  !lineType = !form.specification.lineType()
  !lineTypeFound = !lineType inset(|NULL|, |FP|, |FX|)
  if (!lineTypeFound.not() and !form.isSpecUpdateable.not() ) then
    !form.opSpeclineType.clear()
    !dtext[1] = !lineType
    !form.opSpeclineType.dtext = !dtext
  else
    if (!form.opSpeclineType.count ne 3) then
      !form.opSpeclineType.clear()
      !form.opSpeclineType.add(|Null|, |NULL|)
      !form.opSpeclineType.add(|Fixed pipe|, |FP|)
      !form.opSpeclineType.add(|Fixed Length|, |FX|)
    endif
    if (!lineTypeFound.not()) then
      !!alert.warning(|Specification has an invalid line type of $!<lineType>, attribute will be unset!|)
      !lineType = 'NULL'
    endif
  endif

  !form.opSpeclineType.select('RTEXT', !lineType)

  -- Fill Rating field using the current pressure units
  !rating = !form.specification.rating()
  !form.txSpecRating.val = !rating.currentUnits(object MEASURE('Pressure')).value()

  -- Get ref names
  !refAttStr = |MATREF FLUREF BSPEC NOMREF BRREF REDREF PDAREF|
  !refAtts = !refAttStr.split()
  !refNames = ARRAY()
  do !ind indices !refAtts
    !refNames[!ind] = !this.getRefStr(!form, !form.specification, !refAtts[!ind])
  enddo

  -- Set ref name fields
  !form.txSpecAttMatRef.val = !refNames[1]
  !form.txSpecAttFluRef.val = !refNames[2]
  !form.txSpecAttBspec.val = !refNames[3]
  !form.txSpecAttNomRef.val = !refNames[4]
  !form.txSpecAttBrRef.val = !refNames[5]
  !form.txSpecAttRedRef.val = !refNames[6]
  !form.txSpecAttPDaRef.val = !refNames[7]

  -- Set the appropriate bolting method
  !form.opSpecBltMeth.val = !form.opSpecBltMeth.rtext.findFirst(!form.specification.bltmethod())
  handle (61,620)
      !form.opSpecBltMeth.val = 2
  endhandle

  -- Disable apply button for read-only databases
  !form.bnSpecCadAttApply.active = !form.isSpecUpdateable

  -- Reset panel modified flag
  !form.isModSpecCadAtts = false

endmethod
-- End of method definition for .initSpecCadAtts(FORM)

------------------------------------------------------------------------
--
-- Method:      actionSpecCadAtts
--
-- Description: Gadget actions for spec CAD attributes panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionSpecCadAtts(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  -- Gadget actions
  -- Line type & rating
  if (!object eq !form.opSpeclineType and !action eq |SELECT|) then
    !form.isModSpecCadAtts = true

  elseif (!object eq !form.txSpecRating and !action eq |SELECT|) then
    !form.isModSpecCadAtts = true

  -- Ref text fields
  elseif (!object eq !form.txSpecAttMatRef and !action eq |SELECT|) then
    !validatedRef = !!catValidateRefField(!form.txSpecAttMatRef, 'SOLI')
    if (!validatedRef.set() and !validatedRef.empty()) then
      !prevName = !this.getRefStr(!form, !form.specification, 'MATREF')
      !form.txSpecAttMatRef.val = !prevName
    else
      if (!validatedRef.unset()) then
        !form.txSpecAttMatRef.val = !form.unsetRefStr
      endif
      !form.isModSpecCadAtts = true
    endif
  elseif (!object eq !form.txSpecAttFluRef and !action eq |SELECT|) then
    !validatedRef = !!catValidateRefField(!form.txSpecAttFluRef, 'FLUI')
    if (!validatedRef.set() and !validatedRef.empty()) then
      !prevName = !this.getRefStr(!form, !form.specification, 'FLUREF')
      !form.txSpecAttFluRef.val = !prevName
    else
      if (!validatedRef.unset()) then
        !form.txSpecAttFluRef.val = !form.unsetRefStr
      endif
      !form.isModSpecCadAtts = true
    endif
  elseif (!object eq !form.txSpecAttBspec and !action eq |SELECT|) then
    !validatedRef = !!catValidateRefField(!form.txSpecAttBspec, 'SPEC')
    if (!validatedRef.set() and !validatedRef.empty()) then
      !prevName = !this.getRefStr(!form, !form.specification, 'BSPEC')
      !form.txSpecAttBspec.val = !prevName
    else
      if (!validatedRef.unset()) then
        !form.txSpecAttBspec.val = !form.unsetRefStr
      endif
      !form.isModSpecCadAtts = true
    endif
  elseif (!object eq !form.txSpecAttNomRef and !action eq |SELECT|) then
    !validatedRef = !!catValidateRefField(!form.txSpecAttNomRef, 'NOMTAB')
    if (!validatedRef.set() and !validatedRef.empty()) then
      !prevName = !this.getRefStr(!form, !form.specification, 'NOMREF')
      !form.txSpecAttNomRef.val = !prevName
    else
      if (!validatedRef.unset()) then
        !form.txSpecAttNomRef.val = !form.unsetRefStr
      endif
      !form.isModSpecCadAtts = true
    endif
  elseif (!object eq !form.txSpecAttBrRef and !action eq |SELECT|) then
    !validatedRef = !!catValidateRefField(!form.txSpecAttBrRef, 'BRTAB')
    if (!validatedRef.set() and !validatedRef.empty()) then
      !prevName = !this.getRefStr(!form, !form.specification, 'BRREF')
      !form.txSpecAttBrRef.val = !prevName
    else
      if (!validatedRef.unset()) then
        !form.txSpecAttBrRef.val = !form.unsetRefStr
      endif
      !form.isModSpecCadAtts = true
    endif
  elseif (!object eq !form.txSpecAttRedRef and !action eq |SELECT|) then
    !validatedRef = !!catValidateRefField(!form.txSpecAttRedRef, 'BRTAB')
    if (!validatedRef.set() and !validatedRef.empty()) then
      !prevName = !this.getRefStr(!form, !form.specification, 'REDREF')
      !form.txSpecAttRedRef.val = !prevName
    else
      if (!validatedRef.unset()) then
        !form.txSpecAttRedRef.val = !form.unsetRefStr
      endif
      !form.isModSpecCadAtts = true
    endif
   elseif (!object eq !form.txSpecAttPDaRef and !action eq |SELECT|) then
    !validatedRef = !!catValidateRefField(!form.txSpecAttPDaRef, 'PDATAB')
    if (!validatedRef.set() and !validatedRef.empty()) then
      !prevName = !this.getRefStr(!form, !form.specification, 'PDAREF')
      !form.txSpecAttPDaRef.val = !prevName
    else
      if (!validatedRef.unset()) then
        !form.txSpecAttPDaRef.val = !form.unsetRefStr
      endif
      !form.isModSpecCadAtts = true
    endif

  -- Ref search buttons
  elseif (!object eq !form.bnSpecAttMatRefS and !action eq |SELECT|) then
    !form.isInitSearch           = true
    !form.searchCallFrame        = |SPECCADATTS|
    !form.searchCallGadget       = !form.txSpecAttMatRef
    !form.searchDbType           = |PROP|
    !form.searchScope.clear()
    !form.searchScope[1]         = |/*|
    !form.searchEleTypes.clear()
    !form.searchEleTypes[1]      = |SOLI|
    !form.searchFilters.clear()
    --!form.searchFilters[1]       = |NAME like *|
    !form.searchMultiSel         = false
    !form.searchColumns.clear()
    !form.searchColumns[1]       = |DBNAME Database|
    !form.searchColumns[2]       = |OWNER.NAME Owner|
    !form.searchColumns[3]       = |NAME Name|
    !form.searchColumns[4]       = |DESC Description|
    !this.pushTaskPanel(!form.frSearch, |Search (Material)|)
  elseif (!object eq !form.bnSpecAttFluRefS and !action eq |SELECT|) then
    !form.isInitSearch           = true
    !form.searchCallFrame        = |SPECCADATTS|
    !form.searchCallGadget       = !form.txSpecAttFluRef
    !form.searchDbType           = |PROP|
    !form.searchScope.clear()
    !form.searchScope[1]         = |/*|
    !form.searchEleTypes.clear()
    !form.searchEleTypes[1]      = |FLUI|
    !form.searchFilters.clear()
    --!form.searchFilters[1]       = |NAME like *|
    !form.searchMultiSel         = false
    !form.searchColumns.clear()
    !form.searchColumns[1]       = |DBNAME Database|
    !form.searchColumns[2]       = |OWNER.NAME Owner|
    !form.searchColumns[3]       = |NAME Name|
    !form.searchColumns[4]       = |DESC Description|
    !this.pushTaskPanel(!form.frSearch, |Search (Fluid)|)
  elseif (!object eq !form.bnSpecAttBspecS and !action eq |SELECT|) then
    !form.isInitSearch           = true
    !form.searchCallFrame        = |SPECCADATTS|
    !form.searchCallGadget       = !form.txSpecAttBspec
    !form.searchDbType           = |CATA|
    !form.searchScope.clear()
    !form.searchScope[1]         = |/*|
    !form.searchEleTypes.clear()
    !form.searchEleTypes[1]      = |SPEC|
    !form.searchFilters.clear()
    --!form.searchFilters[1]       = |NAME like *|
    !form.searchMultiSel         = false
    !form.searchColumns.clear()
    !form.searchColumns[1]       = |DBNAME Database|
    !form.searchColumns[2]       = |OWNER.NAME Owner|
    !form.searchColumns[3]       = |NAME Name|
    !form.searchColumns[4]       = |DESC Description|
    !this.pushTaskPanel(!form.frSearch, |Search (Bolt Spec.)|)
  elseif (!object eq !form.bnSpecAttNomRefS and !action eq |SELECT|) then
    !form.isInitSearch           = true
    !form.searchCallFrame        = |SPECCADATTS|
    !form.searchCallGadget       = !form.txSpecAttNomRef
    !form.searchDbType           = |CATA|
    !form.searchScope.clear()
    !form.searchScope[1]         = |/*|
    !form.searchEleTypes.clear()
    !form.searchEleTypes[1]      = |NOMTAB|
    !form.searchFilters.clear()
    --!form.searchFilters[1]       = |NAME like *|
    !form.searchMultiSel         = false
    !form.searchColumns.clear()
    !form.searchColumns[1]       = |DBNAME Database|
    !form.searchColumns[2]       = |OWNER.NAME Owner|
    !form.searchColumns[3]       = |NAME Name|
    !form.searchColumns[4]       = |DESC Description|
    !this.pushTaskPanel(!form.frSearch, |Search (N.b. Table)|)
  elseif (!object eq !form.bnSpecAttBrRefS and !action eq |SELECT|) then
    !form.isInitSearch           = true
    !form.searchCallFrame        = |SPECCADATTS|
    !form.searchCallGadget       = !form.txSpecAttBrRef
    !form.searchDbType           = |CATA|
    !form.searchScope.clear()
    !form.searchScope[1]         = |/*|
    !form.searchEleTypes.clear()
    !form.searchEleTypes[1]      = |BRTAB|
    !form.searchFilters.clear()
    --!form.searchFilters[1]       = |NAME like *|
    !form.searchFilters[1]       = |PURP = BRAN|
    !form.searchMultiSel         = false
    !form.searchColumns.clear()
    !form.searchColumns[1]       = |DBNAME Database|
    !form.searchColumns[2]       = |OWNER.NAME Owner|
    !form.searchColumns[3]       = |NAME Name|
    !form.searchColumns[4]       = |DESC Description|
    !this.pushTaskPanel(!form.frSearch, |Search (Branch Table)|)
  elseif (!object eq !form.bnSpecAttRedRefS and !action eq |SELECT|) then
    !form.isInitSearch           = true
    !form.searchCallFrame        = |SPECCADATTS|
    !form.searchCallGadget       = !form.txSpecAttRedRef
    !form.searchDbType           = |CATA|
    !form.searchScope.clear()
    !form.searchScope[1]         = |/*|
    !form.searchEleTypes.clear()
    !form.searchEleTypes[1]      = |BRTAB|
    !form.searchFilters.clear()
    --!form.searchFilters[1]       = |NAME like *|
    !form.searchFilters[1]       = |PURP = REDU|
    !form.searchMultiSel         = false
    !form.searchColumns.clear()
    !form.searchColumns[1]       = |DBNAME Database|
    !form.searchColumns[2]       = |OWNER.NAME Owner|
    !form.searchColumns[3]       = |NAME Name|
    !form.searchColumns[4]       = |DESC Description|
    !this.pushTaskPanel(!form.frSearch, |Search (Reducer Table)|)
   elseif (!object eq !form.bnSpecAttPDaRefS and !action eq |SELECT|) then
    !form.isInitSearch           = true
    !form.searchCallFrame        = |SPECCADATTS|
    !form.searchCallGadget       = !form.txSpecAttPDaRef
    !form.searchDbType           = |CATA|
    !form.searchScope.clear()
    !form.searchScope[1]         = |/*|
    !form.searchEleTypes.clear()
    !form.searchEleTypes[1]      = |PDATAB|
    !form.searchFilters.clear()
    --!form.searchFilters[1]       = |NAME like *|
    !form.searchMultiSel         = false
    !form.searchColumns.clear()
    !form.searchColumns[1]       = |DBNAME Database|
    !form.searchColumns[2]       = |OWNER.NAME Owner|
    !form.searchColumns[3]       = |NAME Name|
    !form.searchColumns[4]       = |DESC Description|
    !this.pushTaskPanel(!form.frSearch, |Search (Pipe Data Table)|)

  -- Ref CE buttons
  elseif (!object eq !form.bnSpecAttMatRefC and !action eq |SELECT|) then
    if (!!ce.type eq |SOLI|) then
      !form.txSpecAttMatRef.val = !!ce.namn
      !form.isModSpecCadAtts = true
    else
      !!alert.warning(|Specified reference is not the correct type, a SOLI reference is required!|)
    endif
  elseif (!object eq !form.bnSpecAttFluRefC and !action eq |SELECT|) then
    if (!!ce.type eq |FLUI|) then
      !form.txSpecAttFluRef.val = !!ce.namn
      !form.isModSpecCadAtts = true
    else
      !!alert.warning(|Specified reference is not the correct type, a FLUI reference is required!|)
    endif
  elseif (!object eq !form.bnSpecAttBspecC and !action eq |SELECT|) then
    if (!!ce.type eq |SPEC|) then
      !form.txSpecAttBspec.val = !!ce.namn
      !form.isModSpecCadAtts = true
    else
      !!alert.warning(|Specified reference is not the correct type, a SPEC reference is required!|)
    endif
  elseif (!object eq !form.bnSpecAttNomRefC and !action eq |SELECT|) then
    if (!!ce.type eq |NOMTAB|) then
      !form.txSpecAttNomRef.val = !!ce.namn
      !form.isModSpecCadAtts = true
    else
      !!alert.warning(|Specified reference is not the correct type, a NOMTAB reference is required!|)
    endif
  elseif (!object eq !form.bnSpecAttBrRefC and !action eq |SELECT|) then
    if (!!ce.type eq |BRTAB| and !!ce.purpose eq |BRAN|) then
      !form.txSpecAttBrRef.val = !!ce.namn
      !form.isModSpecCadAtts = true
    else
      !!alert.warning(|Specified reference is not the correct type, a BRTAB reference with a purpose of BRAN is required!|)
    endif
  elseif (!object eq !form.bnSpecAttRedRefC and !action eq |SELECT|) then
    if (!!ce.type eq |BRTAB| and !!ce.purpose eq |REDU|) then
      !form.txSpecAttRedRef.val = !!ce.namn
      !form.isModSpecCadAtts = true
    else
      !!alert.warning(|Specified reference is not the correct type, a BRTAB reference with a purpose of REDU is required!|)
    endif
  elseif (!object eq !form.bnSpecAttPDaRefC and !action eq |SELECT|) then
    if (!!ce.type eq |PDATAB|) then
      !form.txSpecAttPDaRef.val = !!ce.namn
      !form.isModSpecCadAtts = true
    else
      !!alert.warning(|Specified reference is not the correct type, a PDATAB reference is required!|)
    endif

  -- Back button
  elseif (!object eq !form.bnSpecCadAttBack and !action eq |SELECT|) then
    if (!form.isModSpecCadAtts eq true and !form.isSpecUpdateable) then
      !confirm = !!alert.question(|Apply changes before going back?|)
      if (!confirm eq |CANCEL|) then
        return
      elseif (!confirm eq |YES|) then
        !this.applySpecCadAtts(!form)
      else
        !form.isModSpecCadAtts = false
      endif
    endif
    !this.popTaskPanel(!form)
    return

  endif

endmethod
-- End of method definition for .actionSpecCadAtts(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      applySpecCadAtts
--
-- Description: Apply action for spec CAD attributes panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applySpecCadAtts(!form is FORM)
  -- Line type and bolt method
  !form.specification.setlineType(!form.opSpeclineType.selection())
  !form.specification.setbltmethod(!form.opSpecBltMeth.selection())

  -- Convert rating to database units and store in the specification
  !dimension = object MEASURE('Pressure')
  !rating = !form.txSpecRating.val
  if (!rating.unset()) then
    !rating = 0
  endif
  !rating = !rating.cast(!dimension.currentUnits())
  !form.specification.setRating(!rating.dbUnits())

  -- Main spec reference attributes
  !this.setRefStr(!form, !form.specification, |MATREF|, !this.txUnsetToEmpty(!form.txSpecAttMatRef.val))
  !this.setRefStr(!form, !form.specification, |FLUREF|, !this.txUnsetToEmpty(!form.txSpecAttFluRef.val))
  !this.setRefStr(!form, !form.specification, |BSPEC|,  !this.txUnsetToEmpty(!form.txSpecAttBspec.val))
  !this.setRefStr(!form, !form.specification, |NOMREF|, !this.txUnsetToEmpty(!form.txSpecAttNomRef.val))
  !this.setRefStr(!form, !form.specification, |BRREF|,  !this.txUnsetToEmpty(!form.txSpecAttBrRef.val))
  !this.setRefStr(!form, !form.specification, |REDREF|, !this.txUnsetToEmpty(!form.txSpecAttRedRef.val))
  !this.setRefStr(!form, !form.specification, |PDAREF|, !this.txUnsetToEmpty(!form.txSpecAttPDaRef.val))

  -- Update form variables
  !nomBoreRef = !form.specification.dbref(|NOMREF|)
  if (!nomBoreRef.badref()) then
    !form.nomBoreTab = object DBREF()
  else
    !form.nomBoreTab = !nomBoreRef
  endif
  !branchRef = !form.specification.dbref(|BRREF|)
  if (!branchRef.badref()) then
    !form.branchTab = object DBREF()
  else
    !form.branchTab = !branchRef
  endif
  !reducerRef = !form.specification.dbref(|REDREF|)
  if (!reducerRef.badref()) then
    !form.reducerTab = object DBREF()
  else
    !form.reducerTab = !reducerRef
  endif

  -- Save changes
  !this.saveToDb(!form, false)

  -- Unset modified flag
  !form.isModSpecCadAtts = false

endmethod
-- End of method definition for .applySpecCadAtts(FORM)

------------------------------------------------------------------------
--
-- Method:      initSpecUpdateAtts
--
-- Description: Initialise the update attributes panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSpecUpdateAtts(!form is FORM)

  using namespace 'Aveva.Pdms.Presentation'

  -- Set grid headings
  !heading = ARRAY()
  !heading.append('Name')
  !heading.append('Attribute')
  !heading.append('New Reference')

  -- Create row data for grid. Attribute names are converted into the attribute descriptions used
  -- as headings in the main component grid.
  !rows = !form.updateList
   do !row value !rows
    if (!row[2] eq 'CATR') then
      !row[2] = !form.cadRefsD[2]
    elseif (!row[2] eq 'DETR') then
      !row[2] = !form.cadRefsD[3]
    elseif (!row[2] eq 'MATX') then
      !row[2] = !form.cadRefsD[4]
    elseif (!row[2] eq 'CMPR') then
      !row[2] = !form.cadRefsD[5]
    elseif (!row[2] eq 'BLTR') then
      !row[2] = !form.cadRefsD[6]
    elseif (!row[2] eq 'TMPR') then
      !row[2] = !form.cadRefsD[7]
    elseif (!row[2] eq 'PDAREF') then
      !row[2] = !form.cadRefsD[8]
    endif
  enddo

  -- Clear grid ready for repopulating
  !form.netUpdateTable.clearGrid()

  -- Bind to data source
  !ndsTable = object NETDATASOURCE('Update table', !heading, !rows, FALSE)
  !form.netUpdateTable.bindToDataSource(!ndsTable)

  -- Select the whole list
  !selectedRowTags = !rows.indices()
  !form.netUpdateTable.allGridEvents(false)
  !form.netUpdateTable.setSelectedRowTags(!selectedRowTags)
  !form.netUpdateTable.allGridEvents(true)
  !form.bnSpecUpdateAttApply.active = !form.isSpecUpdateable

endmethod
-- End of method definition for .initSpecUpdateAtts(FORM)

------------------------------------------------------------------------
--
-- Method:      actionSpecUpdateAtts
--
-- Description: Gadget actions for update component attributes panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionSpecUpdateAtts(!object is GADGET, !action is STRING)
  -- Get owning form
  !form = !object.owner()

  -- Back button
  if (!object eq !form.bnSpecUpdateAttBack and !action eq |SELECT|) then
   !form.updateList.compress()
   !this.popTaskPanel(!form)

  -- Apply button
  elseif (!object eq !form.bnSpecUpdateAttApply and !action eq |SELECT|) then
    -- Update the selected rows
    !initialCE = !!ce
    !selectedRowTags = !form.netUpdateTable.getSelectedRowTags()
    !deletedRowTags = ARRAY()
    do !rowTag value !selectedRowTags
      !row = !form.updateList[!rowTag.real()]
      !spco = !row[1]
      !attribute = !row[2]
      !reference = !row[3]

      $!spco $!attribute $!reference
      handle none
        !deletedRowTags.append(!rowTag)
        !form.updateList.deleteFrom(!rowTag.real(), 1)
      elsehandle any
      endhandle
    enddo
    !!ce = !initialCE

    -- Delete rows from table - events are turned off to improve performance
    !form.netUpdateTable.allGridEvents(false)
    !form.netUpdateTable.deleteRows(!deletedRowTags)
    !form.netUpdateTable.allGridEvents(true)

    if (!deletedRowTags.size() NE !selectedRowTags.size()) then
      !!alert.error(|One or more attributes could not be updated|)
    else
      !form.bnSpecUpdateAttApply.active = false
    endif

    -- Update the specification and component table
    !form.specification = object CATSPECIFICATION(!form.specdbref)
    !form.currentHdg = object SPECHEADING(!form.specification, !form.opHeadings.selection().real())
    !this.populateTable(!form)
  endif

endmethod
-- End of method definition for .actionSpecUpdateAtts(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      initHeadingEdit
--
-- Description: Initialise components edit panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initHeadingEdit(!form is FORM)

  -- Check that initialisation is required
  if (!form.isInitHeadingEdit.not()) then
    !form.isInitHeadingEdit = true
    return
  endif

  -- Populate questions list headings
  !headStr = 'NUM QUESTION DEFAULT'
  !form.lsHeadingList.setHeadings(!headStr.split())
  -- Populate questions list details
  !questions = ARRAY()

  do !cnt from 1 to !form.currentHdg.questionsCount()
    -- Question index
    !questions[!cnt][1] = !cnt.string()
    -- Question including qualifier
    if (!form.currentQuals[!cnt].unset()) then
      !questions[!cnt][2] = !form.currentQues[!cnt]
    else
      !questions[!cnt][2] = !form.currentQues[!cnt] & !form.currentQuals[!cnt]
    endif
    -- Default
    !questions[!cnt][3] = !form.currentDflts[!cnt]
  enddo
  !form.lsHeadingList.setrows(!questions)

  -- Initialise question attribute fields
  --<TM fix to make the rows update after a delete
  if !form.currentHdg.questionsCount().gt(0) then
     !this.selectQuestion(!form, 1)
  else
     !this.selectQuestion(!form, 0)
  endif

  -- Reset panel modified flag
  !form.isModHeadingEdit = false

endmethod
-- End of method definition for .initHeadingEdit(FORM)

------------------------------------------------------------------------
--
-- Method:      actionHeadingEdit
--
-- Description: Gadget actions for HeadingsEdit panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionHeadingEdit(!object is GADGET, !action is STRING)

 -- Get owning form
  !form = !object.owner()

  -- Gadget actions
  -- Question list
  if (!object eq !form.lsHeadingList) then
    if (!action eq |SELECT|) then
      !this.selectQuestion(!form, !form.lsHeadingList.val)

    elseif (!action eq |UNSELECT|) then
      !this.selectQuestion(!form, 0)
    endif

  -- Question combo
  elseif (!object eq !form.cmHeadingQues and !action ne |UNSELECT|) then
    if (!action eq |VALIDATE|) then
      !enteredText = !form.cmHeadingQues.displayText().replace(' ', '').substring(1,4).upcase()

      -- Check that the entered text represents a valid question
      var !hashValue HASH( !enteredText )
      handle any
      endhandle
      if (undefined(!hashValue) or !hashValue.real() eq 0) then
        !!alert.error('The question contains illegal characters - specification questions can only contain the characters A-Z')
        return
      endif

      if (!form.cmHeadingQues.rtext.findFirst(!enteredText).unset()) then
        !form.cmHeadingQues.add(!enteredText)
      endif
      !form.cmHeadingQues.select(|RTEXT|, !enteredText)
    endif
    -- Set qualifier
    if (!form.cmHeadingQues.selection() inset(|PBOR|, |PCON|)) then
      !form.opHeadingQual.val = 2
    else
      !form.opHeadingQual.val = 1
    endif
    -- Set default
    --!form.txHeadingDflt.val = '-'
    -- Update headings
    !this.updateHeadings(!form)

  -- Qualifier
  elseif (!object eq !form.opHeadingQual and !action eq |SELECT|) then
    -- Update headings
    !this.updateHeadings(!form)

  -- Default
  elseif (!object eq !form.txHeadingDflt and !action eq |SELECT|) then
    -- Update headings
    !this.updateHeadings(!form)
    !form.currentHdg.updateComponentDefaults(!form.lsHeadingList.val)

  -- Add question
  elseif (!object eq !form.bnHeadingQAdd and !action eq |SELECT|) then
    -- Duplicate questions not allowed
    do !cnt from 1 to !form.currentQues.size()
      if (!form.currentQues[!cnt] eq !form.newQuesStr) then
        !!alert.message(|Duplicate questions are not allowed, the $!<form.newQuesStr> question is already defined!|)
        return
      endif
    enddo
    -- Create the question
    !okFlag = !form.currentHdg.setQuestion(!form.newQuesStr, 0, true)
    if (!okFlag) then
      -- Update corresponding form members
      !this.updateQQDMems(!form)
      -- Update panel
      !form.isInitHeadingEdit = true
      !this.initHeadingEdit(!form)
      -- Select the new question
      !ind = !form.currentHdg.questionsCount()
      !form.lsHeadingList.val = !ind
      !this.selectQuestion(!form, !ind)
      -- Set modified flag
      !form.isModHeadingEdit = true
    else
      !!alert.warning(|Unknown error creating new question!|)
      return
    endif

  -- Move up
  elseif (!object eq !form.bnHeadingQUp and !action eq |SELECT|) then
    !this.reorderQuestion(!form, !form.lsHeadingList.val, |UP|)
    handle none
      !form.isModHeadingEdit = true
    endhandle

  -- Move down
  elseif (!object eq !form.bnHeadingQDown and !action eq |SELECT|) then
    !this.reorderQuestion(!form, !form.lsHeadingList.val, |DOWN|)
    handle none
      !form.isModHeadingEdit = true
    endhandle

  -- Delete question
  elseif (!object eq !form.bnHeadingQDelete and !action eq |SELECT|) then
    !ind = !form.lsHeadingList.val
    if (!ind EQ 0) then
        !!alert.error('No Question selected')
        return
    endif
    !okFlag = !form.currentHdg.deleteQuestion(!ind)
    if (!okFlag) then
      -- Update corresponding form members
      !this.updateQQDMems(!form)
      -- Update panel and select the new question
      !form.isInitHeadingEdit = true
      !this.initHeadingEdit(!form)
      -- Set modified flag
      !form.isModHeadingEdit = true
    else
      !!alert.warning(|Unknown error deleting question!|)
      return
    endif

  -- Delete Standard Heading
  elseif (!object eq !form.bnStdHeadingDelete and !action eq |SELECT|) then

        !head = !form.bnStdHeadList.dtext[!form.bnStdHeadList.val]
        !ans  = !!alert.confirm('Ok to delete Standard Heading ' & !head)

       if (!ans EQ 'YES') then
           -- If answer is yes, then we delete the listing we have.

           -- Save to the arrays first, delete as appropriate and re-list them.
           !position = !form.bnStdHeadList.val
           !dtext = !form.bnStdHeadList.dtext
           !rtext = !form.bnStdHeadList.rtext
           !dtext.removeFrom(!form.bnStdHeadList.val,1)
           !rtext.removeFrom(!form.bnStdHeadList.val,1)
           !form.bnStdHeadList.dtext = !dtext
           !form.bnStdHeadList.rtext = !rtext

           -- Reinstate the position we were at.
            !form.bnStdHeadList.val = !position
            handle (61,620)
               -- Likely that there are no longer any headings available.
               !clear = ARRAY()
               !form.bnSpecHeadings.dtext = !clear

            elsehandle none
              -- Set the heading list to reflect the next list item.
                 !!catSpecViews.selectHeadings(!form.bnStdHeadList, 'SELECT')
            endhandle
       endif

  -- Back button
  elseif (!object eq !form.bnHeadingBack and !action eq |SELECT|) then
    if (!form.isModHeadingEdit eq true) then
      !confirm = !!alert.question(|Apply changes before going back?|)
      if (!confirm eq |CANCEL|) then
        return
      elseif (!confirm eq |YES|) then
        !this.applyHeadingEdit(!form)
      else
        !form.isModHeadingEdit = false
        if (!form.currentHdgIsNew) then
          !form.specification.deleteHeading(!form.opHeadings.selection().real())
          !this.initOpHeadings(!form)
          !this.actionCompTable(!form.opHeadings, |SELECT|)
          !form.currentHdgIsNew = false
        else
          !this.actionCompTable(!form.opHeadings, |SELECT|)
        endif
      endif
    endif
           !this.popTaskPanel(!form)
           return

   -- Back Button on Standard Headings Form.
   elseif (!object eq !form.bnSpecHeadingsBack and !action eq |SELECT|) then

      -- Return back to normal headings panel.
         !this.popTaskPanel(!form)

   -- Save headings to external file.
   elseif (!object eq  !form.bnSaveSpecHeadings OR !object eq  !form.bnSaveSpecHeadings2 AND !action eq |SELECT|) then

      -- First gather all the lists together and sort them out into unique list.
         !completeList  = ARRAY()

      -- Gather Spec headings.
      -- Gather Standard Headings previously used.
      -- Add them all together to make one list.
      -- Save Specification Headings to Defaults file.
      -- Make unique list here and sort it before we save the list to file.
       do !headList from 1 to 2
          if (!headList eq 1) then
              !completeDtext = !form.bnSpecHeadList.dtext
              !completeRtext = !form.bnSpecHeadList.rtext
              !completeQuest = !form.headingQuest
          else
              !completeDtext = !form.bnStdHeadList.dtext
              !completeRtext = !form.bnStdHeadList.rtext
              !completeQuest = !form.stdHeadingQuest
          endif

          do !specHead index !completeDtext
               !string  = |Heading Type = | & !completeDtext[!specHead] & ';'
               !heading = !completeQuest[!completeRtext[!specHead].real()]
                handle (2,752)
                   -- Likely reason is the spec in question has an empty heading, will be not there.
                   skip
                endhandle

            do !x index !heading
              do !y index !heading[!x]
                 if (!y eq 1) then
                     !string = !string & !heading[!x][!y]
                 else
                     !string = !string & ',' & !heading[!x][!y]
                 endif
              enddo
                 !string = !string & ';'
            enddo
               !completeList.append(!string)
          enddo
       enddo

      -- Now we have a shortened unique list, we can save it to file.
      -- Making it unique here will stop the file growing and including duplications.

        !form.headingsFile.open('write')
        handle (41,319)
          !!alert.message(!!error.text & ' Writing to PDMSUSER Directory')
          -- Can't write to file requested, PNS
          -- Write to PDMSUSER instead.
             !form.headingsFile = !form.userHeadingsFile
             !form.headingsFile.open('overwrite')
        endhandle

      -- Setup the start if the file, ready for saving.
      -- First test to see if we can actually write to the file, if not then save to the pdmsuser directory.
         !headOfFile = ARRAY()
         !headOfFile.append(|--|)
         !headOfFile.append(|-- Standard headings For Specification Creation.|)
         !headOfFile.append(|-- =============================================|)
         !headOfFile.append(|--|)
         !form.headingsFile.writefile('append',!headOfFile)

      -- Write the bulk of the file based on what we have.
        do !heading value !completeList.unique().sort()
          do !line value !heading.split(';')
           !form.headingsFile.writerecord(!line)
          enddo
        enddo

         !form.headingsFile.close()

   elseif (!object eq !form.bnLoadSpecHeadings) then

         -- Load Specification Headings from Defaults file.
            !this.loadHeadings(!form)

   endif

endmethod
-- End of method definition for .actionHeadingEdit(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      updateHeadings
--
-- Description: Update current heading with changes to heading edit panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateHeadings(!form is FORM)

  -- Get current question index
     !quesIndex = !form.lsHeadingList.val

  -- Update corresponding form members
  -- Question
     !form.currentQues[!quesIndex] = !form.cmHeadingQues.selection()
     !form.currentHdg.setQuestion(!form.currentQues[!quesIndex], !quesIndex, false)

  -- Qualifier
      !qualStr = !form.opHeadingQual.selection()
  if (!qualStr eq 'None') then
      !qualifier = -1
      !form.currentQuals[!quesIndex] = object STRING()
  else
      !qualifier = !qualStr.real()
      !form.currentQuals[!quesIndex] = !qualStr
  endif
      !form.currentHdg.setQualifier(!qualifier, !quesIndex)

  -- Default
      !defaultStr = !this.txUnsetToEmpty(!form.txHeadingDflt.val.trim())
  if (!defaultStr.empty()) then
      !defaultStr = '-'
  endif
      !form.currentDflts[!quesIndex] = !defaultStr
      !this.setHdgDefault(!form, !defaultStr, !quesIndex)

  -- Update heading list
     !this.initHeadingEdit(!form)
     !form.lsHeadingList.val = !quesIndex

  -- Initialise question attribute fields
     !this.selectQuestion(!form, !quesIndex)

  -- Set modified flag
     !form.isModHeadingEdit = true

endmethod
-- End of method definition for .updateHeadings(FORM)

------------------------------------------------------------------------
--
-- Method:      getHdgDefault
--
-- Description: Get default for specified question
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--    2   R      REAL        Question index
--
-- Return:
--   [Data Type] [Description]
--    STRING      Default as STRING data type
--
------------------------------------------------------------------------
define method .getHdgDefault(!form is FORM, !index is REAL) is STRING

  -- Initialise return array
  !default = STRING()

  -- Get default
  !stringDefault = !form.currentHdg.stringDefault(!index).replace('NONE', '-').replace('EQUA', '=')
    handle any
       !stringDefault = !default
    endhandle
  if (!stringDefault.empty()) then
    -- ***** Need to add FORMAT here for bore or real values????? ****
    !default = !form.currentHdg.realDefault(!index).string()
  else
    !default = !stringDefault
  endif

  return !default

endmethod
-- End of method definition for .getHdgDefault(FORM, REAL)STRING

------------------------------------------------------------------------
--
-- Method:      selectQuestion
--
-- Description: Update question attribute gadgets for specified question
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--    2   R      REAL        Question index
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectQuestion(!form is FORM, !index is REAL)

  if (!index gt 0) then
    -- Question
    !question = !form.currentQues[!index]
    if (!form.cmHeadingQues.rtext.findFirst(!question).unset()) then
      !form.cmHeadingQues.add(!question)
    endif
    !form.lsHeadingList.val = !index

    !form.cmHeadingQues.select(|RTEXT|, !question)
    -- Qualifier
    !qualifier = !form.currentQuals[!index]
    if (!qualifier.unset()) then
      !form.opHeadingQual.val = 1
    else
      !form.opHeadingQual.select(|RTEXT|, !qualifier)
    endif
    -- Default
    !form.txHeadingDflt.val = !form.currentDflts[!index]
    -- Activate attribute fields and heading list buttons
    !form.frHeadingEnter.active = true
    !form.bnHeadingQUp.active   = false
    !form.bnHeadingStd.active   = true
    !form.bnHeadingQDown.active = false

    -- Decide which button should be active and which one not.
    if (!form.lsHeadingList.val eq 1) then
        !form.bnHeadingQDown.active = true
        !form.bnHeadingQUp.active   = false
    elseif (!form.lsHeadingList.val eq !form.currentHdg.questionsCount()) then
        !form.bnHeadingQDown.active = false
        !form.bnHeadingQUp.active   = true
    else
        !form.bnHeadingQDown.active = true
        !form.bnHeadingQUp.active   = true
    endif

        !form.bnHeadingQDelete.active = true
  else
    --Deactivate attribute fields and heading list buttons
    !form.frHeadingEnter.active   = false
    !form.bnHeadingQUp.active     = false
    !form.bnHeadingQDown.active   = false
    !form.bnHeadingQDelete.active = false
    !form.bnHeadingStd.active     = true
  endif

endmethod
-- End of method definition for .selectQuestion(FORM, REAL)

------------------------------------------------------------------------
--
-- Method:      reorderQuestion
--
-- Description: Move question up or down one place in the current heading
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--    2   R      REAL        Question index
--    2   R      STRING      Direction (UP or DOWN)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .reorderQuestion(!form is FORM, !indexArg is REAL, !action is STRING)

  -- Make variable local to ensure it can be modified
  !index = !indexArg

  -- Test for valid index
  !qCount = !form.currentHdg.questionsCount()
  if (!action eq |UP| and !index le 1) then
    return error 1 |Can't reorder question before index number 1!|
  elseif (!action eq |DOWN| and !index ge !qCount) then
    return error 1 |Can't reorder question after last index!|
  endif

  -- Insert new question and set up old/new indices
  !question = !form.currentHdg.question(!index)
  if (!action eq |UP|) then
    !indQold = !index + 1
    !indQnew = !index - 1
    !okFlag = !form.currentHdg.setQuestion(!question, !indQnew, true)
  elseif (!action eq |DOWN|) then
    !indQold = !index
    !indQnew = !index + 2
    if (!index le (!qCount - 2)) then
      !okFlag = !form.currentHdg.setQuestion(!question, !indQnew, true)
    elseif (!index ge (!qCount - 1)) then
      !okFlag = !form.currentHdg.setQuestion(!question, 0, true)
    endif
  else
    return error 1 |Invalid direction given for reorder operation, UP or DOWN must be specified!|
  endif

  -- Process new question
  if (!okFlag) then

    -- Set qualifier and default to match old question
    !qualifier = !form.currentHdg.qualifier(!indQold).real()
    !form.currentHdg.setQualifier(!qualifier, !indQnew)
    !default = !this.getHdgDefault(!form, !indQold)
    !this.setHdgDefault(!form, !default, !indQnew)

    -- Get component answers for the existing question and copy them for the new question
    do !indC from 1 to !form.currentHdg.componentCount()
      !component = object SPECCOMPONENT(!form.currentHdg, !indC)
      !answerType = !component.answerType(!indQold)
      if (!answerType eq |STRING|) then
        !component.addStringAnswer(!component.stringAnswer(!indQold), !indQnew)
      elseif (!answerType eq |REAL|) then
        !component.addRealAnswer(!component.realAnswer(!indQold), !indQnew)
      elseif (!answerType eq |RANGE|) then
        !rAns = !component.rangeAnswer(!indQold)
        !component.addRangeAnswer(!rAns[1], !rAns[2], !indQnew)
      endif
      !form.currentHdg.addComponent(!component, !indC, false)
    enddo

    -- Delete the old question
    !form.currentHdg.deleteQuestion(!indQold)

    -- Update corresponding form members
    !this.updateQQDMems(!form)
    -- Update panel
    !form.isInitHeadingEdit = true
    !this.initHeadingEdit(!form)

    -- Select the new question
    if (!action eq |DOWN|) then
      !indQnew = !indQnew - 1
    endif
    !form.lsHeadingList.val = !indQnew
    !this.selectQuestion(!form, !indQnew)

  else
    return error 1 |Unknown error trying to reorder question!|
  endif

endmethod
-- End of method definition for .reorderQuestion(FORM)
------------------------------------------------------------------------
--
-- Method:      applySpecHeading
--
-- Description: Apply action for Spec Headings Selection panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applySpecHeading(!form is FORM)

    -- Now clear the headings list and replace with the selected set.
       do !ind from !form.currentHdg.questionsCount() to 1 by -1
          !form.currentHdg.deleteQuestion(!ind)
       enddo

       -- Clear arrays by reassigning - clear() method cannot be used as it fails if element 0 exists
       !form.lsHeadingList.dtext = ARRAY()
       !form.currentQues = ARRAY()
       !form.currentQuals = ARRAY()
       !form.currentDflts = ARRAY()

       -- Cycle round the questions being set.
       do !questions index !form.bnSpecHeadings.dtext

          -- Split the question into chunks.
          !question = !form.bnSpecHeadings.dtext[!questions].split()

          -- Now we create the question.
          !!catSpecViews.actionHeadingEdit(!form.bnHeadingQAdd, 'SELECT')

          -- Set the question to one of those available from the list.
          !form.cmHeadingQues.val = !form.cmHeadingQues.rtext.findFirst(!question[2].substring(1,4))

          -- Now set the type of question we have.
          !!catSpecViews.actionHeadingEdit(!form.cmHeadingQues, 'SELECT')

          -- Set the qualifier
          if (!question[2].length() GT 4) then
              if (unset(!form.opHeadingQual.rtext.findFirst(!question[2].substring(5)))) then

                  !form.opHeadingQual.val = 1
              else

                  !form.opHeadingQual.val = !form.opHeadingQual.rtext.findFirst(!question[2].substring(5))
              endif
          else
                  !form.opHeadingQual.val = 1
          endif

          -- Set the qualifier in the system here, after setting the gadgets.
            !!catSpecViews.actionHeadingEdit(!form.opHeadingQual, 'SELECT')

          -- Set the default
             !form.txHeadingDflt.val = !question[3]
            !!catSpecViews.actionHeadingEdit(!form.txHeadingDflt, 'SELECT')
       enddo

    -- Return back to normal headings panel.
       !this.popTaskPanel(!form)

       !form.frSpecHeadings.visible = false
       !form.frHeadingEdit.visible  = true

   -- Set the Heading from what we have already set.
      !form.txCompAddHtype.val = !form.currentHeading

endmethod
-- End of method definition for .applySpecHeading(FORM)

------------------------------------------------------------------------
--
-- Method:      validateHeadingQuestions
--
-- Description: Check that heading questions are valid - i.e. that they
--              don't conflict with the speconmode syntax graph for
--              headings (found in file spc.grf)
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     SPECHEADING Heading to check
--
-- Return:
--   [Data Type] [Description]
--   STRING      An empty string or the reason the heading is not valid
--
------------------------------------------------------------------------
define method .validateHeadingQuestions(!heading is SPECHEADING) is STRING
  -- Check that a heading's questions are legal and don't conflict with the
  -- speconmode syntax graph (see file spc.grf).

  -- Array of questions that must have a qualifier
  !questionsWithQualifiers = ARRAY()
  !questionsWithQualifiers.append('PB/ORE')
  !questionsWithQualifiers.append('PC/ONN')

  -- Array of questions that cannot have a qualifier
  !questionsWithoutQualifiers = ARRAY()
  !questionsWithoutQualifiers.append('ST/YPE')
  !questionsWithoutQualifiers.append('ANG/LE')
  !questionsWithoutQualifiers.append('RAD/IUS')
  !questionsWithoutQualifiers.append('TEM/PERATURE')
  !questionsWithoutQualifiers.append('PR/ESSURE')
  !questionsWithoutQualifiers.append('RAT/ING')
  !questionsWithoutQualifiers.append('SHOP')
  !questionsWithoutQualifiers.append('DEP/TH')
  !questionsWithoutQualifiers.append('WID/TH')
  !questionsWithoutQualifiers.append('CTYS/TART')
  !questionsWithoutQualifiers.append('CTYE/ND')
  !questionsWithoutQualifiers.append('CTYA/TTACHED')
  !questionsWithoutQualifiers.append('CTYO/WNING')
  !questionsWithoutQualifiers.append('FIX/TY')
  !questionsWithoutQualifiers.append('GRAD/E')
  !questionsWithoutQualifiers.append('FIRE/SISTANCE')
  !questionsWithoutQualifiers.append('ITHI/CKNESS')
  !questionsWithoutQualifiers.append('AREA')
  !questionsWithoutQualifiers.append('WEIG/HT')
  !questionsWithoutQualifiers.append('DIME/NSION')
  !questionsWithoutQualifiers.append('CTYPE')
  !questionsWithoutQualifiers.append('INER/TIA')
  !questionsWithoutQualifiers.append('THIC/KNESS')

  -- Array of reference names - these cannot be used for question names
  !referenceNames = ARRAY()
  !referenceNames.append('CAT/REF')
  !referenceNames.append('DET/AIL')
  !referenceNames.append('MATX/T')
  !referenceNames.append('CMP/REF')
  !referenceNames.append('BLT/REF')
  !referenceNames.append('TMPR/EFERENCE')
  !referenceNames.append('PRTREF/ERENCE')
  !referenceNames.append('PDAREF/ERENCE')

  do !i to !heading.questionsCount()
    !question  = !heading.question(!i)
    !qualifier = !heading.qualifier(!i).real()

    -- Check whether the question must have a qualifier
    if (!this.matchQuestionToCommands(!question, !questionsWithQualifiers)) then
      if (!qualifier lt 0) then
        return |Question '| + !question + |' cannot be used without a qualifier|
      endif
    -- Check whether the question is prohibited from having a qualifier
    elseif (!this.matchQuestionToCommands(!question, !questionsWithoutQualifiers)) then
      if (!qualifier ge 0) then
        return |Question '| + !question + |' cannot be used with a qualifier|
      endif
    -- Check the question does not conflict with a reference name
    elseif (!this.matchQuestionToCommands(!question, !referenceNames)) then
      return |'| + !question + |' cannot be used as a question, it is reserved for use as a reference name|
    endif
  enddo
  return ''
endmethod

------------------------------------------------------------------------
--
-- Method:      matchQuestionsToCommands
--
-- Description: Checks whether a question string matches any of the entries
--              in an array of command strings.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING     Question to check
--    2   R      ARRAY      Array of command strings
--
-- Return:
--   [Data Type] [Description]
--   BOOLEAN     Whether a match was found
--
------------------------------------------------------------------------

define method .matchQuestionToCommands(!question is STRING, !commands is ARRAY) is BOOLEAN

  -- The command strings are expected to be of the form 'ABC/DEF' where the characters
  -- after the '/' are optional for matching
  do !command value !commands
    !delimiterPosition = !command.match(|/|)
    !fullCommand = !command.replace(|/|, '')
    !fullCommand = !fullCommand.substring(1, !question.length())

    if ((!fullCommand EQ !question) AND (!question.length() GE !delimiterPosition - 1)) then
      return true
    endif
  enddo
  return false
endmethod
-- End of method matchQuestionsToCommands

------------------------------------------------------------------------
--
-- Method:      applyHeadingEdit
--
-- Description: Apply action for Heading Edit panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyHeadingEdit(!form is FORM)

  -- First check for errors in the heading. If any are found, display an error message and return.
  !errorMessage = !this.validateHeadingQuestions(!form.currentHdg)
  if (!errorMessage.length() gt 0) then
    !!alert.error(!errorMessage)
    return
  endif

  -- Make a copy of the selected heading
  !hdgIndex = !form.opHeadings.selection().real()
  !savedHeading = object SPECHEADING(!form.specification, !hdgIndex)

  -- Update specification object with heading details
  !okFlag = !form.specification.addHeading(!form.currentHdg, !hdgIndex, false)

  if (!okFlag) then
    if (!form.currentHdg.componentCount() gt 0) then

      -- Remove components to limbo first or the columns will not get moved
      -- Do this in speconmode
      !this.speconmode('speconmode')
          do !cnt from 1 to !form.currentHdg.componentCount()
            !component = object SPECCOMPONENT(!form.currentHdg, !cnt)
            !spcoName = !component.name()
            remove $!<spcoName>
              handle (2,109)
              endhandle
          enddo

      !this.speconmode('exit')

      -- save changes to db
      !this.saveToDb(!form, true)

      handle (17, 7)
        !!alert.warning(|Heading could not be changed - specification would contain duplicate entries.|)
        -- Restore heading
        !form.currentHdg = !savedHeading
        !form.specification.addHeading(!form.currentHdg, !hdgIndex, false)
        !this.saveToDb(!form, false)
      elsehandle any
        !!alert.warning(!!error.text)
        !form.currentHdg = !savedHeading
        !form.specification.addHeading(!form.currentHdg, !hdgIndex, false)
        !this.saveToDb(!form, false)
      endhandle

      -- Update specification object
      !form.specification = object CATSPECIFICATION(!form.specdbref)
      -- Update headings option list and reselect the heading by name
      -- (heading index probably changed after the removes)
      !oldHeading = !form.opHeadings.selection(|DTEXT|)
      !this.initOpHeadings(!form)

      if (!oldHeading.occurs(|[|) eq 0) then
        -- Only one heading for this type
        !newHeading = !oldHeading
      else
        -- Multiple headings of the same type (so find the last index?)
        -- *** Do this when you get time
        !newHeading = !oldHeading
      endif
      !form.opHeadings.select(|DTEXT|, !newHeading)
      !this.actionCompTable(!form.opHeadings, |SELECT|)
    --<TM> addition to make sure it updates the list if you change the headings and there are no components
    elseif !form.currentHdg.questionsCount().gt(0) then
      -- Clear grid to ensure headings are reset
      !form.netCompTable.clearGrid()
      !this.actionCompTable(!form.opHeadings, |SELECT|)
    endif
    -- Set modified flag
    !form.isModHeadingEdit = false
    -- Set new heading flag
    !form.currentHdgIsNew = false
  elseif (!okFlag.not()) then
    !!alert.warning(|Unknown error applying heading modifications!|)
    return
  endif

endmethod
-- End of method definition for .applyHeadingEdit(FORM)

------------------------------------------------------------------------
--
-- Method:      setHdgDefault
--
-- Description: Get default for specified question
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--    2   R      STRING      Default as STRING data type
--    3   R      REAL        Question index
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setHdgDefault(!form is FORM, !default is STRING, !index is REAL)

  -- Convert to correct data type
  !realDefault = !default.real()
  handle any
    -- Must be a string default
    !form.currentHdg.setStringDefault(!default, !index)
    !form.currentHdg.setRealDefault(0, !index)
  elsehandle none
    -- Must be a real default
    -- ***** Need to test FORMAT here for bore or real values????? ****
    !form.currentHdg.setRealDefault(!realDefault, !index)
    !form.currentHdg.setStringDefault('', !index)
  endhandle

endmethod
-- End of method definition for .setHdgDefault(FORM, REAL)

------------------------------------------------------------------------
--
-- Method:      initCompAdd
--
-- Description: Initialise Components Add panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initCompAdd(!form is FORM)

  -- Check that initialisation is required
  if (!form.isInitCompAdd.not()) then
    !form.isInitCompAdd = true
    return
  endif

  -- Initialise option list text
  !codeTypesD = ARRAY()
  !codeTypesR = ARRAY()

  -- Set form units in case they have been changed on the command line
  !this.setFormUnits(!form)

  -- Set nominal bores
  !form.nomBores.clear()
  if (!form.nomBoreTab.set()) then
    !nbTable = object CATNBTABLE(!form.nomBoreTab, !form.boreUnits, !form.distanceUnits)
    do !val values !nbTable.bores()
      !form.nomBores.append(!val.string(!form.boreFormat))
    enddo
  else
    if (!form.boreUnits eq |MM|) then
      !bores = nombmm bores
    else
      !bores = nombin bores
    endif
    do !val values !bores
      !form.nomBores.append(!val.string(!form.boreFormat))
    enddo
  endif
  !codeTypesD.append(|User Defined|)
  !codeTypesR.append(|USER|)

  -- Get pbore numbers in current heading
  !pboreNums = ARRAY()
  do !val values !form.currentQues.find(|PBOR|)
     !pboreNums.append(!form.currentQuals[!val])
  enddo

  -- Set branch size range codes
  !form.branchCodes.clear()
  if (!form.branchTab.set() and !pboreNums.findFirst(|3|).set()) then
    !branchTable = object CATBRTABLE(!form.branchTab, !form.boreUnits)
    !form.branchCodes = !branchTable.shortCodes()
    if (!form.branchCodes.set()) then
        !form.branchCodes.unique()
        !codeTypesD.append(|By Branch Code|)
        !codeTypesR.append(|BRANCH|)
    endif
  endif

  -- Set reducer size range codes
  !form.reducerCodes.clear()
  if (!form.reducerTab.set() and !pboreNums.findFirst(|2|).set()) then
    !reducerTable = object CATBRTABLE(!form.reducerTab, !form.boreUnits)
    !form.reducerCodes = !reducerTable.shortCodes()
    if (!form.reducerCodes.set()) then
        !form.reducerCodes.unique()
        !codeTypesD.append(|By Reducer Code|)
        !codeTypesR.append(|REDUCER|)
    endif
  endif

  if (!form.txCompAddHtype.val EQ 'INSU') then
    !codeTypesD = ARRAY()
    !codeTypesR = ARRAY()
    !codeTypesD.append(|Insulation Spec|)
    !codeTypesR.append(|INSU|)
  elseif (!form.txCompAddHtype.val EQ 'BOLT') then
    !codeTypesD = ARRAY()
    !codeTypesR = ARRAY()
    !codeTypesD.append(|Bolting Spec|)
    !codeTypesR.append(|BOLT|)
  endif

  -- Set range type option list
  !form.opCompAddCodes.dtext = !codeTypesD
  !form.opCompAddCodes.rtext = !codeTypesR

  -- Set size range list visibility
  !this.actionCompAdd(!form.opCompAddCodes, |SELECT|)

  -- Set Heading Type field
  !headingType = !form.opHeadings.selection(|DTEXT|).before(' [')

  -- Set the Heading tag to active or not, based on the current spec heading.
   if (!headingType eq |Empty| or !headingType eq |None|) then
       !form.txCompAddHtype.clear()
       !form.txCompAddHtype.active = true

    -- Check here to see if we have already chosen from a standard heading.
      if (!form.isHeadingStd) then
          !headingType                = !form.currentHeading
          !form.txCompAddHtype.val    = !headingType
          !form.txCompAddHtype.active = false

      endif

   else
      !form.txCompAddHtype.val = !headingType
      !form.txCompAddHtype.active = false
   endif

  -- Set Heading Type field
     if (!form.isHeadingStd AND !headingType EQ 'BOLT') then
        !form.txCompAddStype.tag = 'BTYPe'
        !form.txCompAddStype.val = 'BOLT'

        -- Check the purpose of the SPEC/TEXT Element.
        !this.setStext(!form,'BOLT')
        !form.tgCompAddAll.active = FALSE
        !form.tgAddAllBores.visible = FALSE

     elseif (!form.isHeadingStd AND !headingType EQ 'INSU') then
        -- Set the appropriate text box settings for Insulation.
        !form.txCompAddStype.tag = 'STYPe'
        !form.txCompAddStype.val = 'INSU'

        -- Check the purpose of the SPEC/TEXT Element.
        !this.setStext(!form,'INSU')

        -- Change the include all sizes toggle on the main form.
        !form.tgCompAddAll.active = FALSE
        !form.tgAddAllBores.visible = FALSE

     else
        !form.txCompAddStype.tag = 'STYPe'
        !form.tgCompAddAll.active = TRUE
        !this.setAddAllBoresToggle(!form)
     endif

  -- Apply panel modified flag
  !form.isModCompAdd = false

endmethod
-- End of method definition for .initCompAdd(FORM)

------------------------------------------------------------------------
--
-- Method:      setStext
--
-- Description: Go gets sizes of components for current hierarchy element.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM     Element
--    2   R      STRING     Element
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setStext(!form is FORM, !type is STRING)

-- Set the STEXT of the SPEC TEXT Element to the setting we have, for BOLT and INSU

-- Set the spec, and remember where we are just in case we have to create the element.
        !save = !!ce
        !specRef = !form.specification.name()
        !!ce = !specRef.dbref()
        !unusedboltpurp = stext of TEXT 1 of $!specRef
        handle (2,113)
          -- TEXT element not there.
          !!ce = !specRef.dbref()
          NEW TEXT
          STEXT '$!type'
        elsehandle none
          TEXT 1 of $!specRef
          STEXT '$!type'
        endhandle

-- Return to last element.
        !!ce = !save

endmethod
-- End of method definition for .setStext(STRING)

------------------------------------------------------------------------
--
-- Method:      setAddAllBoresToggle
--
-- Description: Show or hide the 'Add all bores' toggle
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM       Specification form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setAddAllBoresToggle(!form is FORM)

  if (!form.opCompAddCodes.selection() ne |USER|) then
    !form.tgAddAllBores.visible = FALSE
  else
    -- Check if there is a PBOR2 or a PBOR3 and make the 'Add all bores' toggle visible
    !form .tgAddAllBores.visible = FALSE
    do !val values !form.currentQues.find(|PBOR|)
      !pboreNum = !form.currentQuals[!val]
      if (!pboreNum eq (|2|)) then
        !form .tgAddAllBores.visible = TRUE
        !form.tgAddAllBores.tag = |Add all PBOR1 and PBOR2 sizes|
        break
      elseif (!pboreNum eq (|3|)) then
        !form .tgAddAllBores.visible = TRUE
        !form.tgAddAllBores.tag = |Add all PBOR1 and PBOR3 sizes|
        break
      endif
    enddo
  endif
endmethod
-- End of method definition for .setAddAllBoresToggle(FORM)

------------------------------------------------------------------------
--
-- Method:      getComponentSizes
--
-- Description: Gets the sizes of components for the current hierarchy element.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      ARRAY      Component sizes expressed as strings
--    3   R      STRING     Action to perform
--    4   R      STRING     GType of components to select
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getComponentSizes(!object is GADGET, !owner is STRING, !action is STRING, !gtype is STRING) is ARRAY
  -- Get owning form
  !form = !object.owner()

  !cle = ARRAY()

  !name = !owner
  if (not !name.substring(1,1) inset(|/|, |=|, ||)) then
    !name = '/' & !name
  endif

  !ref = !name.dbref()
  handle (2,111)
    return !cle
  endhandle

  -- Check for unset variable here
  if (unset(!ref)) then
      return !cle
  endif

  -- Set the component and go get all the SCOM sizes.
  if (!ref.type EQ 'PRTELE') then

    var !gparts coll all GPART for $!ref
    var !scoms eval catref for all from !gparts

  else

    var !scoms coll all SCOM for $!ref
  endif

  if (!gtype.set()) then
    !allScoms = !scoms
    var !scoms coll all SCOM with gtype eq |$!gtype| from !allScoms
  endif

  !range = ARRAY()

  do !scom value !scoms
     !range.append(!scom.dbref().param[1].real())
  enddo
  -- Sort array into numeric order.
  !range.sort()

  -- Now we have the range, go set the range gadgets.
  !componentSizes = ARRAY()
  !this.setFormUnits(!form)
  do !v value !range
    if (!gtype.set()) then
      !val = !v.string()
    else
      !val = !this.formatRealAsNominalBore(!form, !v, !gtype.set())
    endif
    !componentSizes.append(!val)
  enddo
  !form.opCompAddFrom.dtext  = !componentSizes.unique()
  !form.opCompAddTo.dtext    = !componentSizes.unique()

  if (!action EQ 'SETRANGES') then

    -- Now set the range gadgets to high and low values ready for action.
    if (!componentSizes.size() GT 0) then
      !form.opCompAddFrom.val    = 1
      !form.opCompAddTo.val      = !componentSizes.size()
    endif
  endif
  return !componentSizes

endmethod
-- End of method definition for .getComponentSizes(GADGET, STRING, STRING) ARRAY

------------------------------------------------------------------------
--
-- Method:      actionCompAdd
--
-- Description: Gadget actions for Components Add panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionCompAdd(!object is GADGET, !action is STRING)
  -- Get owning form
  !form = !object.owner()

  -- Gadget actions
  -- Add codes
  if (!object eq !form.opCompAddCodes and !action eq |SELECT|) then
    if (!form.opCompAddCodes.selection() eq |USER|) then

      -- Save the selections from the From and To option gadgets
      !from = !form.opCompAddFrom.selection()
      !to   = !form.opCompAddTo.selection()

      -- Fill the From and To gadgets with the available bores
      !form.opCompAddFrom.dtext    = !form.nomBores
      !form.opCompAddTo.dtext      = !form.nomBores

      -- Set or restore the selections in the From and To gadgets
      !form.opCompAddFrom.select('DTEXT', !from)
      handle (61,567) $* From selection not found
        !form.opCompAddFrom.val = 1
      endhandle

      !form.opCompAddTo.select('DTEXT', !to)
      handle (61,567) $* To selection not found
        !form.opCompAddTo.val = !form.opCompAddTo.dtext.size()
      endhandle

      !form.frCompAddCodes.visible = false
      !form.frCompAddRange.visible = true

    elseif (!form.opCompAddCodes.selection() inset(|INSU|, |BOLT|)) then

      !form.opCompAddFrom.dtext    = !this.getComponentSizes(!object, !form.txCompAddName.val, |SETLISTS|, !form.opCompAddCodes.selection())
      !form.opCompAddTo.dtext      = !form.opCompAddFrom.dtext
      if (!form.opCompAddTo.dtext.size() GT 0) then
        !form.opCompAddTo.val        = !form.opCompAddTo.dtext.size()
      endif
      !form.frCompAddCodes.visible = false
      !form.frCompAddRange.visible = true

    elseif (!form.opCompAddCodes.selection() eq |BRANCH|) then
      !codeHdgs[1] = 'Branch Codes'
      !form.lsCompAddCodes.setHeadings(!codeHdgs[1])
      !form.lsCompAddCodes.dtext   = !form.branchCodes
      !form.frCompAddRange.visible = false
      !form.frCompAddCodes.visible = true

    elseif (!form.opCompAddCodes.selection() eq |REDUCER|) then
      !codeHdgs[1] = 'Reducer Codes'
      !form.lsCompAddCodes.setHeadings(!codeHdgs[1])
      !form.lsCompAddCodes.dtext   = !form.reducerCodes
      !form.frCompAddRange.visible = false
      !form.frCompAddCodes.visible = true

    endif
    -- Stype field
    if (!form.opCompAddCodes.selection() eq |USER|) then

      -- If there is a default value for STYPE, use it
      !defaultSType = ''
      -- Ignore first question which is always type
      do !index from 2 to !form.currentHdg.questionsCount()
        if (!form.currentHdg.question(!index) EQ 'STYP') then
          !default = !form.currentHdg.stringDefault(!index)

          if (!default inset('-', '=', 'NONE', 'EQUA') ) then
            break
          endif
          !defaultSType = !default
          break
        endif
      enddo

      if (!defaultSType ne '' and (!form.txCompAddStype.val.unset() or !form.txCompAddStype.val.length() eq 0)) then
        !form.txCompAddStype.val = !defaultSType
      else
        !form.txCompAddStype.clear()
      endif

    else
      !form.txCompAddStype.val = !form.lsCompAddCodes.selection()
    endif
    !this.setAddAllBoresToggle(!form)

  -- Add codes selection list
  elseif (!object eq !form.lsCompAddCodes and !action eq |SELECT|) then
    -- Stype field
    if (!form.opCompAddCodes.selection() eq |USER|) then
      !form.txCompAddStype.clear()
    else
      !form.txCompAddStype.val = !form.lsCompAddCodes.selection()
    endif

  -- Size range 'From' option list
  elseif (!object eq !form.opCompAddFrom and !action eq |SELECT|) then
    !from = !form.opCompAddFrom.selection()
    !to = !form.opCompAddTo.selection()
    !form.opCompAddTo.dtext = !form.opCompAddFrom.dtext.from(!form.opCompAddFrom.val)
    if (!to.real() lt !from.real()) then
      !form.opCompAddTo.select('DTEXT', !from)
    else
      !form.opCompAddTo.select('DTEXT', !to )
    endif

  -- Stype text field
  elseif (!object eq !form.txCompAddStype and !action eq |SELECT|) then
    !form.isModCompAdd = true

  -- Heading Type text field
  elseif (!object eq !form.txCompAddHtype and !action eq |SELECT|) then
    !form.isModCompAdd = true

  -- Category list
  elseif (!object eq !form.bnCompAddCateList and !action eq |SELECT|) then
    !form.refListCallFrame  = |COMPADD|
    !form.refListCallGadget = !form.txCompAddName
    !form.refListCallType   = |CATE|
    !form.refListSingleSel  = true
    --!form.isInitRefList   = false
    !this.pushTaskPanel(!form.frRefList, |Categories|)

  -- Part Family List
  elseif (!object eq !form.bnCompAddPartList and !action eq |SELECT|) then
    !form.refListCallFrame  = |COMPADD|
    !form.refListCallGadget = !form.txCompAddName
    !form.refListCallType   = |PRTELE|
    !form.refListSingleSel  = true
    --!form.isInitRefList   = false
    !this.pushTaskPanel(!form.frRefList, |Part Families|)

  -- Search
  elseif (!object eq !form.bnCompAddSearch and !action eq |SELECT|) then
    !form.searchCallFrame        = |COMPADD|
    !form.searchCallGadget       = !form.txCompAddName
    !form.searchDbType           = |CATA|
    !form.searchScope.clear()
    !form.searchScope[1]         = |/*|
    !form.searchEleTypes.clear()
    !form.searchEleTypes[1]      = |CATE|
    !form.searchFilters.clear()
    !form.searchFilters[1]       = |CSTA like *ANSI*|
    !form.searchMultiSel         = false
    !form.searchColumns.clear()
    !form.searchColumns[1]       = |DESC Description|
    !form.searchColumns[2]       = |NAME Name|
    !form.searchColumns[3]       = |OWNER.NAME Owner|
    !form.searchColumns[4]       = |DBNAME Database|
    !form.isInitSearch           = true
    !this.pushTaskPanel(!form.frSearch, |Search|)

  -- CE button
  elseif (!object eq !form.bnCompAddCe and !action eq |SELECT|) then
    if (!!ce.type eq |SECT| and !!ce.mcount(|SCOM|) eq 0) then
      !!alert.warning(|Specified reference has no SCOM members!|)
      !form.compAdddbref = object DBREF()
      !form.txCompAddName.clear()
      !form.txCompAddDesc.clear()
    elseif (!!ce.type eq |PRTELE| and !!ce.mcount(|GPART|) eq 0) then
      !!alert.warning(|Specified reference has no GPART members!|)
      !form.compAdddbref = object DBREF()
      !form.txCompAddName.clear()
      !form.txCompAddDesc.clear()
    elseif (!!ce.type inset(|GPART|, |PRTELE|, |SCOM|, |CATE|, |SECT| )) then

      -- For Insulation/Bolting purposes, go collect SCOMS and check sizes, to set size range ready
      -- for when the searching takes place and the component selection happens.
      if (!form.opCompAddCodes.selection() inset(|INSU|, |BOLT|)) then
          !this.getComponentSizes(!object, !!ce.string(), |SETRANGES|, !form.opCompAddCodes.selection())
      endif

      !form.compAdddbref      = !!ce
      !form.txCompAddName.val = !!ce.namn
      !description            = !!ce.description
      if (!description.unset() or !description.empty()) then
        !form.txCompAddDesc.clear()
      else
        !form.txCompAddDesc.val = !description
      endif
        !form.isModCompAdd = true

    else
      !!alert.warning(|Specified element is not the correct type, the element must be a GPART, PRTELE, SCOM, CATE, or SECT!|)
      !form.compAdddbref = object DBREF()
      !form.txCompAddName.clear()
      !form.txCompAddDesc.clear()
    endif

  -- Add from text field
  elseif (!object eq !form.txCompAddName and !action eq |SELECT|) then
    !validatedRef = !!catValidateRefField(!form.txCompAddName, 'GPART PRTELE SCOM CATE SECT')
    if (!validatedRef.unset() or !validatedRef.empty()) then
      !form.compAdddbref = object DBREF()
      !form.txCompAddName.clear()
      !form.txCompAddDesc.clear()
      --!form.isModSpecCadAtts = true
    else
      -- Check name format
      !name = !form.txCompAddName.val
      if (not !name.substring(1,1) inset(|/|, |=|)) then
        !name = '/' & !name
      endif
      -- Set reference
      !form.compAdddbref = !name.dbref()
      if (!form.compAdddbref.type eq |PRTELE| and !form.compAdddbref.mcount(|GPART|) eq 0) then
        !!alert.warning(|Specified reference has no GPART members!|)
        !form.compAdddbref = object DBREF()
        !form.txCompAddName.clear()
        !form.txCompAddDesc.clear()
      elseif (!form.compAdddbref.type inset(|CATE|, |SECT|) and !form.compAdddbref.mcount(|SCOM|) eq 0) then
        !!alert.warning(|Specified reference has no SCOM members!|)
        !form.compAdddbref = object DBREF()
        !form.txCompAddName.clear()
        !form.txCompAddDesc.clear()
      else
        !form.txCompAddName.val = !form.compAdddbref.namn
        !description = !form.compAdddbref.description
        if (!description.unset() or !description.empty()) then
          !form.txCompAddDesc.clear()
        else
          !form.txCompAddDesc.val = !description
        endif
      endif
      if (!form.opCompAddCodes.selection() inset(|INSU|, |BOLT|)) then
        !form.opCompAddFrom.dtext    = !this.getComponentSizes(!object, !form.txCompAddName.val, |SETLISTS|, !form.opCompAddCodes.selection())
        !form.opCompAddTo.dtext      = !form.opCompAddFrom.dtext
        if (!form.opCompAddTo.dtext.size() GT 0) then
          !form.opCompAddTo.val        = !form.opCompAddTo.dtext.size()
        endif
      endif
    endif
    !form.isModCompAdd = true

  -- Back button
  elseif (!object eq !form.bnCompAddBack and !action eq |SELECT|) then
    if (!form.isModCompAdd eq true and !form.isSpecUpdateable) then
      !confirm = !!alert.question(|Apply changes before going back?|)
      if (!confirm eq |CANCEL|) then
        return
      elseif (!confirm eq |YES|) then
        !this.applyCompAdd(!form)
      else
        !form.isModCompAdd = false
      endif
    endif
    !form.txCompAddStype.clear()
    !this.popTaskPanel(!form)
    return

  endif

endmethod
-- End of method definition for .actionCompAdd(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      applyCompAdd
--
-- Description: Apply action for Component Add panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyCompAdd(!form is FORM)

  -- Check for a valid heading type if adding components to an empty heading
  !headingType = !form.opHeadings.selection(|DTEXT|).before(' [')
  !enteredHeading = !form.txCompAddHtype.val

  if (!headingType eq |Empty| and !enteredHeading.unset()) then
    !!alert.message(|Heading Type must be set for the first components added to Empty heading!|)
    return
  elseif (!headingType eq |Empty|) then
    -- **** Add a check here to test if the entered heading TYPE is valid
  endif

  -- Set type for new components
  !alertType = !form.txCompAddStype.tag

  if (!form.currentQues.findFirst(|TYPE|).set()) then

      if (!headingType eq |Empty|) then
        !type = !enteredHeading
      else
        !type = !headingType
      endif
      !typeQuestion = |TYPE|

  elseif (!form.currentQues.findFirst(|BTYP|).set()) then
          !type         = |BOLT|
          !typeQuestion = |BTYP|

  elseif (!form.txCompAddHtype.val EQ 'INSU') then
          !type         = |INSU|
          !typeQuestion = |TYPE|

  else
    !!alert.message(|Bad heading definition, the first question must be TYPE or BTYPE, new components will not be created!|)
    return
  endif

  -- Check for a valid stype
  !stype = !form.txCompAddStype.val

  -- Stop the process here if the STYPE isn't set, need one to continue.
  if (!stype.unset() OR !stype.trim().empty()) then
    !!alert.message(!alertType & | must be set, please enter | & !alertType & | required and try again!|)
    return
  endif

  -- Set the temporary name starting index and autoName list for new components
  !tmpNameIndex = !form.currentHdg.componentCount() + 1
  !newSpcoNamesList = ARRAY()

  -- Check name format of Add From name
  if (!form.txCompAddName.val.set()) then
      !addFromName = !form.txCompAddName.val.trim()
    if (not !addFromName.substring(1,1) inset(|/|, |=|, ||)) then
       !addFromName = '/' & !addFromName
    endif
  else
      !addFromName = STRING()
  endif

  -- Add an individual component
  if (!addFromName.set() and not !addFromName.dbref().badref() and !addFromName.dbref().type inset(|GPART|, |SCOM|)) then
    -- Create spec component
    !specComp = object SPECCOMPONENT(!form.currentHdg)

    -- Set type
   !specComp.addStringAnswer(!type, !form.currentQues.findFirst(!typeQuestion))

    -- Set stype
    if (!form.currentQues.findFirst(|STYP|).set()) then
        !specComp.addStringAnswer(!stype, !form.currentQues.findFirst(|STYP|))
    endif

    -- Set prtref or catref
    !prtCatRef = !addFromName.dbref()
    if (!prtCatRef.type eq |GPART|) then
        !specComp.setRef(|PRTREF|, !prtCatRef)
    else
        !specComp.setRef(|CATREF|, !prtCatRef)
    endif

    !this.setUnitsToMetric()

    -- Set pbore answers
    !pbore1 = object BORE()
    do !val values !form.currentQues.find(|PBOR|)
      !pboreNum = !form.currentQuals[!val].real()
      if (!pboreNum eq 0) then
        !pboreNum = 1
      endif
      if (!prtCatRef.type eq |GPART|) then
        if (!addFromName.dbref().catref.badref()) then
          skip
        else
          !pbore = !addFromName.dbref().catref.ppbore[!pboreNum]
          handle any
            skip
          endhandle
        endif
      else
        !pbore = !addFromName.dbref().ppbore[!pboreNum]
        handle any
          skip
        endhandle
      endif

      if (!pboreNum eq 1) then
        !pbore1 = !pbore
      elseif (!pbore.unset() and !pbore1.set()) then
        !msg = 'Bore ' + !pboreNum.string() + ' could not be evaluated.'
        !msg = !msg + ' Do you want to use the value from the first bore?'
        !answer = !!alert.confirm(!msg).boolean()
        if (!answer) then
          !pbore = !pbore1
        endif
      endif

      !specComp.addRealAnswer(!pbore.real(), !val)
    enddo

   !this.restoreFormUnits(!form)

    -- Name the new component
    if (!prtCatRef.badref()) then
      !specComp.rename(!form.specification.name() & '/' & !form.opHeadings.selection(|DTEXT|).before(' [') & '-' & !stype)
    else
      !specComp.rename(!form.specification.name() & '/' & !prtCatRef.namn)
    endif

    -- Save new component back to spec heading
    !specComp.setExisting(false)
    !form.currentHdg.addComponent(!specComp, 0, true)
    !newSpcoNamesList.append(!specComp.name())

  -- Add a size range
  else

    !selection = !form.opCompAddCodes.selection()
    if (!selection eq |USER|) then
      do !val values !form.currentQues.find(|PBOR|)
        !pboreNum = !form.currentQuals[!val]
        if (!pboreNum eq |3|) then
          !selection = |BRANCH|
          break
        elseif (!pboreNum eq |2|) then
          !selection = |REDUCER|
          break
        endif
      enddo
    endif

    -- Get user defined size range, or use ranges set by type being BOLTing or INSUlation
    !form.pboreCombos.clear()
    if (!type eq |INSU| OR !type eq |BOLT|) then

      !tmpBores = !form.opCompAddFrom.dtext.from(!form.opCompAddFrom.dtext.findFirst(!form.opCompAddFrom.selection()))
      handle (2,754)
        -- Likely the size range is not set.
        !!alert.message('No matching items were found')
        return
      endhandle
      !tmpBores = !tmpBores.to(!form.opCompAddTo.dtext.findFirst(!form.opCompAddTo.selection()))

      do !val values !tmpBores

        -- Set bores for insulation/bolting conditions, rather than normal bore conditions.
        !pbores[1] = object BORE(!val.real())
        !pbores[2] = object BORE(0)
        !form.pboreCombos.append(!pbores)

      enddo

    elseif (!selection eq |USER|) then
      !tmpBores = !form.nomBores.from(!form.nomBores.findFirst(!form.opCompAddFrom.selection()))
      !tmpBores = !tmpBores.to(!tmpBores.findFirst(!form.opCompAddTo.selection()))

      do !val values !tmpBores

        -- Add check for bolt conditions, rather than normal bore conditions.
       !pbores[1] = !val.bore()
       !pbores[2] = object BORE(0)
       !form.pboreCombos.append(!pbores)

      enddo

    -- Add branch size range
    elseif (!selection eq |BRANCH|) then
      if (!form.branchTab.badref() or !form.opCompAddCodes.selection() eq |USER|) then
        !tmpBores = !form.nomBores.from(!form.nomBores.findFirst(!form.opCompAddFrom.selection()))
        !tmpBores = !tmpBores.to(!tmpBores.findFirst(!form.opCompAddTo.selection()))
        do !indHeaderBore indices !tmpBores

          -- For the second bore, add all possible bores or just those smaller or equal to the first bore
          if (!form.tgAddAllBores.val) then
            !lastBoreIndex = !tmpBores.size()
          else
            !lastBoreIndex = !indHeaderBore
          endif
          do !indBranchBore to !lastBoreIndex
            !pbores[1] = !tmpBores[!indHeaderBore].bore()
            !pbores[2] = !tmpBores[!indBranchBore].bore()
            !form.pboreCombos.append(!pbores)
          enddo
        enddo

      else
        !branchTable = object CATBRTABLE(!form.branchTab, !form.boreUnits)
        !selectedCode = !form.lsCompAddCodes.selection()
        !headerBores = !branchTable.bores()
        !branchBores = !branchTable.bores()

        do !indH indices !headerBores
          do !indB indices !branchBores
            !shortCodes = !branchTable.shortCodes(!headerBores[!indH], !branchBores[!indB])
            skip if (!shortCodes.findFirst(!selectedCode).unset())
            !pbores[1] = !headerBores[!indH].bore()
            !pbores[2] = !branchBores[!indB].bore()
            !form.pboreCombos.append(!pbores)
          enddo
        enddo
      endif

    -- Add reducer size range
    elseif (!selection eq |REDUCER|) then
      if (!form.reducerTab.badref() or !form.opCompAddCodes.selection() eq |USER|) then
        !tmpBores = !form.nomBores.from(!form.nomBores.findFirst(!form.opCompAddFrom.selection()))
        !tmpBores = !tmpBores.to(!tmpBores.findFirst(!form.opCompAddTo.selection()))
        do !indLargeBore indices !tmpBores

          -- For the second bore, add all possible bores or just those smaller than the first bore
          if (!form.tgAddAllBores.val) then
            !lastBoreIndex = !tmpBores.size()
          else
            !lastBoreIndex = !indLargeBore - 1
          endif

          do !indSmallBore to !lastBoreIndex
            !pbores[1] = !tmpBores[!indLargeBore].bore()
            !pbores[2] = !tmpBores[!indSmallBore].bore()
            !form.pboreCombos.append(!pbores)
          enddo
        enddo
      else
        !reducerTable = object CATBRTABLE(!form.reducerTab, !form.boreUnits)
        !selectedCode = !form.lsCompAddCodes.selection()
        !largeBores = !reducerTable.bores()
        !smallBores = !reducerTable.bores()
        do !indL indices !largeBores
          do !indS indices !smallBores
            !shortCodes = !reducerTable.shortCodes(!largeBores[!indL], !smallBores[!indS])
            skip if (!shortCodes.findFirst(!selectedCode).unset())
            !pbores[1] = !largeBores[!indL].bore()
            !pbores[2] = !smallBores[!indS].bore()
            !form.pboreCombos.append(!pbores)
          enddo
        enddo
      endif
    endif

    -- Get scom or gpart refs (if any)
    if (!addFromName.set() and not !addFromName.empty()) then
      var !itemRefs collect all (scom gpart) for $!<addFromName>
      !foundItems = !itemRefs.evaluate(object BLOCK(|!itemRefs[!evalIndex].dbref()|))
    else
      !foundItems = ARRAY()
    endif

    -- Second pbore number depends on the type of add code
    if (!selection inset(|USER|,|INSU|, |BOLT|)) then
      !secondPpNum = 0
    elseif (!selection eq |BRANCH|) then
      !secondPpNum = 3
    elseif (!selection eq |REDUCER|) then
      !secondPpNum = 2
    endif

    -- Find the first bore for each item
    !foundBores = ARRAY()
    do !item value !foundItems
      -- Always test catref pbores even for gparts
      !testItem = !item.catref
      !catrefPbore[1] = object BORE()

      if (!testItem.badref().not()) then
        -- Get pbore 1
        !catrefPbore[1] = !testItem.ppbore[1]
        handle any
          -- Check here for bolting and insulation conditions.
          if (!type EQ 'BOLT' or !type EQ 'INSU') then
              !catrefPbore[1] = object BORE(!testItem.param[1])
          endif
        endhandle
      endif
     !foundBores.append(!catrefPbore)
    enddo

    -- Process each size combination
    do !indP indices !form.pboreCombos

      -- Check each gpart/scom in turn for matching pbores
      !prtCatRef = object DBREF()

      do !indF indices !foundItems
        -- Always test catref pbores even for gparts
        !testItem = !foundItems[!indF].catref
        if (!testItem.badref().not()) then
          -- Check for match with first bore
          if (!form.pboreCombos[!indP][1] eq !foundBores[!indF][1]) then
            -- If it has not been done already, evaluate the second bore and store it for future use.
            if (not defined(!foundBores[!indF][2])) then
              if (!secondPpNum eq 0) then
                !foundBores[!indF][2] = object BORE(0)
              else
                !foundBores[!indF][2] = !testItem.ppbore[!secondPpNum]
                handle any
                  skip
                endhandle

                -- If the second bore could not be evaluated, ask the user what to do
                if (!foundBores[!indF][2].unset()) then
                  if (undefined (!answer)) then
                    !msg = 'The second bore value could not be evaluated for one or more components.'
                    !msg = !msg + ' Do you want to set the second bore equal to the first and continue?'
                    !answer = !!alert.confirm(!msg).boolean()
                    if (not !answer) then
                      return
                    endif
                  endif
                  if (!answer) then
                    !foundBores[!indF][2] = !foundBores[!indF][1]
                  endif
                endif
              endif
            endif

            -- Check second bore
            if (!form.pboreCombos[!indP][2] eq !foundBores[!indF][2]) then
              !prtCatRef = !foundItems[!indF]
               -- Remove from lists because we don't need to test for this one again, we're using it this time!
              !foundItems.remove(!indF)
              !foundBores.remove(!indF)
              break
            endif
          endif
        endif
      enddo
      -- Check toggle for creating spec component without prtref/catref
      skip if (!form.tgCompAddAll.val.not() and !prtCatRef.badref())

      -- Create new spec component
      !specComp = object SPECCOMPONENT(!form.currentHdg)

      -- Set type question
      !specComp.addStringAnswer(!type, !form.currentQues.findFirst(!typeQuestion))

      -- Set Stype question
      -- **** Check this for insulation/tracing/bolting specs!!!!
      if (!form.currentQues.findFirst(|STYP|).set()) then
          !specComp.addStringAnswer(!stype, !form.currentQues.findFirst(|STYP|))
      endif

      -- Check here for bolting situations.
      if (!form.currentQues.findFirst(|BTYP|).set()) then
          !specComp.addStringAnswer(!stype, !form.currentQues.findFirst(|BTYP|))
      endif

      !this.setUnitsToMetric()

      -- Set pbore answers
      do !val values !form.currentQues.find(|PBOR|)

        !pboreNum = !form.currentQuals[!val]

        if (!selection inset(|USER|,|INSU|,|BOLT|)) then
          if (!pboreNum inset(|0|, |1|, |2|)) then
            !specComp.addRealAnswer(!form.pboreCombos[!indP][1].real(), !val)
          elseif (!pboreNum eq |3|) then
            !specComp.addRealAnswer(!form.pboreCombos[!indP][2].real(), !val)
          endif
        elseif (!selection eq |BRANCH|) then
          if (!pboreNum inset(|0|, |1|, |2|)) then
            !specComp.addRealAnswer(!form.pboreCombos[!indP][1].real(), !val)
          elseif (!pboreNum eq |3|) then
            !specComp.addRealAnswer(!form.pboreCombos[!indP][2].real(), !val)
          endif
        elseif (!selection eq |REDUCER|) then
          if (!pboreNum inset(|0|, |1|)) then
            !specComp.addRealAnswer(!form.pboreCombos[!indP][1].real(), !val)
          elseif (!pboreNum eq |2|) then
            !specComp.addRealAnswer(!form.pboreCombos[!indP][2].real(), !val)
          endif
        endif
      enddo


      -- Bolting specs requirements.
      do !val values !form.currentQues.find(|BDIA|)

          -- Bolting specs requirements.
          !pboreNum = !form.currentQuals[!val]
          !specComp.addRealAnswer(!form.pboreCombos[!indP][1].real(), !val)

      enddo

      !this.restoreFormUnits(!form)

      -- Set catref or gpart ref (if there is one)
      if (!prtCatRef.badref().not()) then
        if (!prtCatRef.type eq |GPART|) then
          !specComp.setRef(|PRTREF|, !prtCatRef)
        elseif (!prtCatRef.type eq |SCOM|) then
          !specComp.setRef(|CATREF|, !prtCatRef)
        endif
      endif

      -- Name the new component
      do !cnt from !tmpNameIndex to 10000
        !newSpcoName = !form.specification.name() & '/' & !type & '-' & !cnt
        if (!!exists(!newSpcoName, '', '')) then
          !tmpNameIndex = !tmpNameIndex + 1
        else
          !specComp.rename(!newSpcoName)
          !newSpcoNamesList.append(!newSpcoName)
          !tmpNameIndex = !tmpNameIndex + 1
          break
        endif
      enddo

      -- Save new component back to spec heading
      !specComp.setExisting(false)
      !form.currentHdg.addComponent(!specComp, 0, true)

    enddo

  endif

  -- Save the heading back to the spec.
  if (!form.currentHdg.componentCount() eq 0) then
    !!alert.message('No matching items were found')
    return
  endif
  !form.specification.addHeading(!form.currentHdg, !form.opHeadings.selection().real(), false)

  -- Save changes to db
  !this.saveToDb(!form, false)
  handle any
    !!alert.error(!!error.text)
  elsehandle none
    if (!!namOpt.auto()) then
      -- autoName the new components
      do !val values !newSpcoNamesList
        !!ce = !val.dbref()
        !autoName = !!namOpt.nameString(!!ce, object STRING(), false, false)
        handle any
          !autoName = object STRING()
        endhandle
        if (!autoName.unset().not()) then
          !!ce.name = '/' & !autoName
        endif
      enddo
    endif
  endhandle

  -- Reinitialise the specification object
  !form.specification = object CATSPECIFICATION(!form.specdbref)

  -- Update headings as they sometimes get confused
  !oldHeading = !form.opHeadings.selection(|DTEXT|)
  !this.initOpHeadings(!form)
  !form.opHeadings.select(|DTEXT|, !enteredHeading)
  handle (61, 567) $* Heading not found
    !form.opHeadings.val = 1
  endhandle
  !this.actionCompTable(!form.opHeadings, |SELECT|)
  !form.txCompAddStype.val = !stype

  -- Unset modified flag
  !form.isModCompAdd = false

endmethod
-- End of method definition for .applyCompAdd(FORM)

------------------------------------------------------------------------
--
-- Method:      initCompAddLimbo
--
-- Description: Initialise the Add From Limbo panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initCompAddLimbo(!form is FORM)

  -- Check that initialisation is required
  if (!form.isInitCompAddLimbo.not()) then
    !form.isInitCompAddLimbo = true
    return
  endif

  -- Initialise the text control tags from the current heading questions
  do !index
    !fieldName = |TXCOMPADDLIMBO| & !index
    !field = !form.attribute(!fieldName)
    handle (2,766) $* Gadget does not exist
      break
    endhandle

    if (!index le !form.currentQues.size()) then
      !question = !form.currentQues[!index]

      !previousTag = !field.tag
      !field.tag = !question

      if (!form.currentQuals[!index].set()) then
         !field.tag = !field.tag + !form.currentQuals[!index]
      endif

      -- Set type to the heading
      if (!question eq |TYPE|) then
        !field.val = !form.opHeadings.selection(|DTEXT|)
      elseif (!field.tag ne !previousTag) then $* If the question has changed, reset the text answers
        !field.val = ''
      endif
      !field.visible = true
    else
      !field.visible = false
    endif
  enddo

  -- Make frame active
  !form.frCompAddLimbo.active = true
  !form.isModCompAddLimbo = false

endmethod
-- End of method definition for  .initCompAddLimbo

------------------------------------------------------------------------
--
-- Method:      actionCompAddLimbo
--
-- Description: Gadget actions for Add from Limbo panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionCompAddLimbo(!gadget is GADGET, !action is STRING)

  !form = !gadget.owner()

  if (!action EQ |SELECT|) then
    if (!gadget eq !form.bnCompAddLimboBack) then
      if (!form.isModCompAddLimbo eq true) then
        !confirm = !!alert.question(|Apply changes before going back?|)
        if (!confirm eq |CANCEL|) then
          return
        elseif (!confirm eq |YES|) then
          !this.applyCompAddLimbo(!form)
        else
          !form.isModCompAddLimbo = false
        endif
      endif
      !this.popTaskPanel(!form)
      return

    elseif (!gadget eq !form.bnCompAddLimboSearch) then
      !form.isInitSearch           = true
      !form.searchCallFrame        = |COMPADDLIMBO|
      !form.searchCallGadget       = !form.txCompAddLimboName
      !form.searchDbType           = |CATA|
      !form.searchScope.clear()
      !form.searchScope[1]         = |/*|
      !form.searchEleTypes.clear()
      !form.searchEleTypes[1]      = |SPCO|
      !form.searchFilters.clear()
      !form.searchFilters[1]       = |OWNER like *LIMBO*|
      !form.searchMultiSel         = false
      !form.searchColumns.clear()
      !form.searchColumns[1]       = |NAME Name|
      !form.searchColumns[2]       = |OWNER.NAME Owner|
      !form.searchColumns[3]       = |CATREF Component|
      !form.searchColumns[4]       = |DBNAME Database|
      !this.pushTaskPanel(!form.frSearch, |Search (Limbo))|)
    elseif (!gadget eq !form.bnCompAddLimboCE or !gadget eq !form.txCompAddLimboName) then
      !element = object DBREF()
      if (!gadget eq !form.bnCompAddLimboCE) then
        !element = !!ce
      elseif (!gadget eq !form.txCompAddLimboName) then
        !name = !form.txCompAddLimboName.val
        !name = !!checkName(!name, 'OLD')
        if (!name.unset()) then
          return
        endif
        !element = !name.dbref()
      endif

      if (not !element.badref()) then
        if (!this.isLimboSpco(!element)) then
          !this.setAddLimboFields(!form, !element)
          !form.txCompAddLimboName.val = !element.namn
        endif
        !form.txCompAddLimboName.setFocus()
      endif
    endif
  endif

endmethod
-- End of method definition for .actionCompAddLimbo

------------------------------------------------------------------------
--
-- Method:      applyCompAddLimbo
--
-- Description: Apply actions for component add from limbo panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyCompAddLimbo(!form is FORM)

  -- Validate SPCO
  !name = !form.txCompAddLimboName.val
  !name = !!checkName(!name, 'OLD')
  if (!name.unset()) then
    return
  else
    !element = !name.dbref()
  endif

  if (not !this.isLimboSpco(!element)) then
    return
  endif

  !component = object SPECCOMPONENT(!form.currentHdg)
  !component.rename(!element.namn)
  !component.setExisting(true)

  -- Check heading type

  !this.setUnitsToMetric()

  -- Set all answers
  !type = ''
  do !index indices !form.currentQues

    !question = !form.currentQues[!index]
    -- Get answer and answer type
    !answerField = |TXCOMPADDLIMBO| & !index
    !answer = !form.attribute(!answerField).val

    if ((!question eq 'TYPE' or !question eq 'BTYP')  and !answer.set()) then
      !type = !answer.trim()
    endif

    if (!answer.unset() or !answer.trim().empty()) then
      !!alert.error(!question & ' must be set')
      return
    endif

    -- Check for a number range()
    if (!answer.occurs(|,|) eq 1) then
      -- Set range answer
      !range[1] = !answer.before(|,|).trim().real()
      !range[2] = !answer.after(|,|).trim().real()
      !component.addRangeAnswer(!range[1], !range[2], !index)
    else
      -- Set text or real answer
      !realAnswer = !answer.trim().real()
      handle any
        !component.addStringAnswer(!answer, !index)
      elsehandle none
        if (NOT !form.metricBoreFlag AND !form.currentQues[!ind] EQ |PBOR|) then
          !bore = !realAnswer.nearestBore()
          !this.setUnitsToMetric()
          !realAnswer = !bore.real()
          !this.restoreFormUnits(!form)
        endif
        !component.addRealAnswer(!realAnswer, !index)
      endhandle
    endif

  enddo
  !this.restoreFormUnits(!form)

  -- Set all the references
  !component.setRef(|PRTREF|, !element.prtref)
  !component.setRef(|CATREF|, !element.catref)
  !component.setRef(|DETAIL|, !element.detref)
  !component.setRef(|MATXT|,  !element.matxt)
  !component.setRef(|CMPREF|, !element.cmpref)
  !component.setRef(|BLTREF|, !element.bltref)
  !component.setRef(|TMPREF|, !element.tmpref)
  !component.setRef(|PDAREF|, !element.pdaref)

  -- Find the heading index
  !hdgIndex = !form.opHeadings.selection().real()

  -- Save heading modifications back to the specification object
  !form.currentHdg.addComponent(!component, 0, false)
  !okFlag = !form.specification.addHeading(!form.currentHdg, !hdgIndex, false)

  if (!okFlag) then
    if (!form.currentHdg.componentCount() gt 0) then

      -- Save changes to db
      !this.saveToDb(!form, true)
      handle (17, 7)
        !message = 'The component could not be removed from limbo - the answers duplicate an existing entry in the specification.'
        !!alert.warning(!message)
      elsehandle any
        !!alert.warning(!!error.text)
      endhandle

      -- Reinitialise the specification object
      !form.specification = object CATSPECIFICATION(!form.specdbref)
      !this.initOpHeadings(!form)

      -- Select a heading from the current type
      !selectedHeading = !type
      !headings = !form.opHeadings.dtext
      if (!headings.findFirst(!selectedHeading).set()) then
        !form.opHeadings.select(|DTEXT|, !selectedHeading)
      else
        -- Previously selected heading not found so try the current first answer instead
        !firstAnswer = !form.txCompEditAns1.val
        if (!headings.findFirst(!firstAnswer).set()) then
         !form.opHeadings.select(|DTEXT|, !firstAnswer)
        else
          -- Answer not found
          !headingSelected = FALSE
          do !heading value !headings
            if (!heading.before(' [') EQ !firstAnswer) then
              !form.opHeadings.select(|DTEXT|, !heading)
              !headingSelected = TRUE
              break
            endif
          enddo
          if (NOT !headingSelected) then
            !form.opHeadings.val = 1
          endif
        endif
      endif

      !this.actionCompTable(!form.opHeadings, |SELECT|)
    endif
    -- Unset modified flag
    !form.isModCompAddLimbo = false
    !form.isInitCompAddLimbo = false
  elseif (!okFlag.not()) then
    !!alert.warning(|Unknown error applying component answer modifications!|)
    return
  endif

endmethod
-- End of method definition for .applyCompAddLimbo

------------------------------------------------------------------------
--
-- Method:      isLimboSpco
--
-- Description: Test whether an element is a valid SPCO owned by a LimboSpec
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to check
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is element is a SPCO owned by a LimboSpec
--
------------------------------------------------------------------------
define method .isLimboSpco(!element is DBREF) is BOOLEAN

  if (!element.type eq |SPCO| and !element.owner.name.match(|/*LIMBOSPEC|) eq 1 and !element.owner.ques eq |LIMB|) then
    return true
  else
    !!alert.error(|Element must be a SPCO directly owned by a limbo specification|)
  endif
  return false

endmethod
-- End of method isLimboSpco

------------------------------------------------------------------------
--
-- Method:     setAddLimboFields
--
-- Description: Sets the text field in the 'Add from Limbo' panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Element to check
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True is element is a SPCO owned by a LimboSpec
--
------------------------------------------------------------------------
define method .setAddLimboFields(!form is FORM, !element is DBREF)

  -- Find catref and fill the bore gadgets
  if (not !element.prtref.badref()  and not !element.prtref.catref.badref()) then
    !catref = !element.prtref.catref
  elseif (not !element.catref.badref()) then
    !catref = !element.catref
  endif

  if (defined(!catref)) then
    do !index indices !form.currentQues

      !question = !form.currentQues[!index]
      !answer = STRING()
      if (!question eq 'TYPE') then
        -- Fill type from the heading
        !answer = !form.opHeadings.selection(|DTEXT|)
      elseif (!question eq |PBOR|) then
        -- Fetch bores from the catalogue component or part
        !qualifier = !form.currentQuals[!index]
        if (!qualifier.unset() or !qualifier eq '0' ) then
          !qualifier = '1'
        endif

        !bore = !catref.ppbore[!qualifier.real()]
        !answer = !bore.string(!form.boreFormat)
      elseif (!index eq !form.currentQues.size()) then
        -- Use the SPCO to find answers for the last question
        if (!element.tansw.set() and !element.tansw.trim().length() ne 0) then
          !answer = !element.tansw
        elseif (!element.answ ne !element.maxans) then
          !answer = !element.answ.string() + ' , ' + !element.maxansw.string()
        elseif (!element.answ ne 0) then
          !answer = !element.answ
        endif
      endif

      if (!answer.set()) then
        if (!answer.upcase() ne 'UNSET') then
          !form.attribute('TXCOMPADDLIMBO' &!index).val = !answer
        endif
      endif
    enddo
  endif
endmethod
-- End of methods .setAddLimboFields

------------------------------------------------------------------------
--
-- Method:      initCompEditAns
--
-- Description: Initialise components edit answers panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initCompEditAns(!form is FORM)

  -- Set form units in case they have been changed on the command line
  !this.setFormUnits(!form)

  -- Hide all answer fields
  do !cnt from 1 to 17
    !answerField = |TXCOMPEDITANS| & !cnt
    !form.attribute(!answerField).tag = !cnt.string()
    !form.attribute(!answerField).visible = false
  enddo

  -- Show answer fields for questions in the current heading
  do !ind indices !form.currentQues
    !tag = !form.currentQues[!ind]
    !qualifier = !form.currentQuals[!ind]
    if (!qualifier.set()) then
      !tag = !tag + !qualifier
    endif
    !answerField = |TXCOMPEDITANS| & !ind
    !form.attribute(!answerField).tag = !tag
    !form.attribute(!answerField).visible = true
  enddo

  -- Get answers for selected rows and set the corresponding text fields
  if (!form.selectedRows.empty().not()) then
    -- Get answers and check for multiple values for each answer
    !answers = ARRAY()

    !useExactBore = !this.useExactBore(!form)
    do !ind indices !form.currentQues
      !tmpAns = object ARRAY()
      !question = !form.currentQues[!ind]

      do !val values !form.selectedRows
        !tmpAns.append(!this.getComponentAnswers(!form, !question, !form.components[!val], !ind, !useExactBore))
      enddo
      !answers.append(!this.checkVaries(!form, !tmpAns))
    enddo
    -- Set answer fields
    do !ind indices !form.currentQues
      !form.attribute(|TXCOMPEDITANS| & !ind).val = !answers[!ind]
    enddo
    -- Make frame active
    !form.frCompEditAns.active = true
    -- Check for part ref set
    !this.checkPrtrefSet(!form)
  else
    -- Make frame inactive
    !form.frCompEditAns.active = false
    -- Clear answer fields
    do !ind indices !form.currentQues
      !form.attribute(|TXCOMPEDITANS| & !ind).clear()
    enddo
  endif

  -- Reset panel modified flag
  !form.isModCompEditAns = false

endmethod
-- End of method definition for .initCompEditAns(FORM)

------------------------------------------------------------------------
--
-- Method:      actionCompEditAns
--
-- Description: Gadget actions for components edit answers panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionCompEditAns(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  -- Gadget actions
  -- Text field validation
  if (!object.name().substring(1,13) eq |TXCOMPEDITANS| and !action eq |VALIDATE|) then
    -- Check answer format
    if (!object.val.unset() or !object.val.trim().empty()) then
      return error 1 |Blank answers are not allowed, a value must be entered!|
    elseif (!object.val.occurs(|,|) gt 1) then
      return error 1 |Invalid answer format, (text strings must not contain commas)|
    elseif (!object.val.occurs(|,|) eq 1) then
      !parts = !object.val.split(|,|)
      do !val values !parts
        !unusedRealVal = !val.trim().real()
        handle any
          return error 1 |Invalid answer format (text strings must not contain commas)|
        endhandle
      enddo
    endif

    -- Set modified flag
    !form.isModCompEditAns = true

  -- Back button
  elseif (!object eq !form.bnCompEditAnsBack and !action eq |SELECT|) then
    if (!form.isModCompEditAns eq true) then
      !confirm = !!alert.question(|Apply changes before going back?|)
      if (!confirm eq |CANCEL|) then
        return
      elseif (!confirm eq |YES|) then
        !this.applyCompEditAns(!form)
      else
        !form.isModCompEditAns = false
      endif
    endif
    !this.popTaskPanel(!form)
    return

  endif

endmethod
-- End of method definition for .actionCompEditAns(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      applyCompEditAns
--
-- Description: Apply action for component edit answers panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyCompEditAns(!form is FORM)

  -- Process answers
  do !ind indices !form.currentQues
    -- Get answer and answer type
    !answerField = |TXCOMPEDITANS| & !ind
    !answer = !form.attribute(!answerField).val
    -- Skip multiple values
    skip if (!answer eq !form.varyStr)
    -- Skip unset answers
    skip if (!answer.unset())

    -- Check for a number range()
    if (!answer.occurs(|,|) eq 1) then
      !rangeFlag = true
    else
      !rangeFlag = false
    endif
    -- Set answer on all selected speccomponents
    !spcoNames = ARRAY()
    do !val values !form.selectedRows
      -- Remember spco names for re-selecting rows in main table
      !spcoNames.append(!form.components[!val].name())
      if (!rangeFlag) then
        -- Set range answer
        !range[1] = !answer.before(|,|).trim().real()
        !range[2] = !answer.after(|,|).trim().real()
        !form.components[!val].addRangeAnswer(!range[1], !range[2], !ind)
      else
        -- Set text or real answer
        !realAnswer = !answer.trim().real()
        handle any
          !form.components[!val].addStringAnswer(!answer, !ind)
        elsehandle none
          if (NOT !form.metricBoreFlag AND !form.currentQues[!ind] EQ |PBOR|) then
            !bore = !realAnswer.nearestBore()
            !this.setUnitsToMetric()
            !realAnswer = !bore.real()
            !this.restoreFormUnits(!form)
          endif
          !form.components[!val].addRealAnswer(!realAnswer, !ind)
        endhandle
      endif
      -- Save speccomponent modifications back to specheading object
      !form.components[!val].setExisting(true)
      !form.currentHdg.addComponent(!form.components[!val], !val, false)
    enddo
  enddo

  -- Save the heading in case a restore is needed
  !hdgIndex = !form.opHeadings.selection().real()
  !savedHeading = object SPECHEADING(!form.specification, !hdgIndex)

  -- Save heading modifications back to the specification object
  !okFlag = !form.specification.addHeading(!form.currentHdg, !hdgIndex, false)
  if (!okFlag) then

    if (!form.currentHdg.componentCount() gt 0) then

      -- Save changes to db
      !this.saveToDb(!form, true)
      handle (17, 7)
        !message = 'These answers duplicate existing entries in the specification. '
        !message = !message + ' If you continue, one or more components will be moved to limbo. Continue?'
        !continue = !!alert.confirm(!message)
        if (!continue.boolean().not()) then
          -- Restore previous heading
          !form.specification.addHeading(!savedHeading, !hdgIndex, false)
          !this.saveToDb(!form, false)
          handle any
            !!alert.warning(!!error.text)
          endhandle
        endif
      elsehandle any
        !!alert.warning(!!error.text)
      endhandle

      -- Reinitialise the specification object
      !form.specification = object CATSPECIFICATION(!form.specdbref)

      !selectedHeading = !form.opHeadings.selection(|DTEXT|)
      !this.initOpHeadings(!form)

      -- Select a heading
      !headings = !form.opHeadings.dtext
      if (!headings.findFirst(!selectedHeading).set()) then
        !form.opHeadings.select(|DTEXT|, !selectedHeading)
      else
        -- Previously selected heading not found so try the current first answer instead
        !firstAnswer = !form.txCompEditAns1.val
        if (!headings.findFirst(!firstAnswer).set()) then
         !form.opHeadings.select(|DTEXT|, !firstAnswer)
        else
          -- Answer not found
          !headingSelected = FALSE
          do !heading value !headings
            if (!heading.before(' [') EQ !firstAnswer) then
              !form.opHeadings.select(|DTEXT|, !heading)
              !headingSelected = TRUE
              break
            endif
          enddo
          if (NOT !headingSelected) then
            !form.opHeadings.val = 1
          endif
        endif
      endif

      !this.actionCompTable(!form.opHeadings, |SELECT|)
    endif
    -- Unset modified flag
    !form.isModCompEditAns = false
  elseif (!okFlag.not()) then
    !!alert.warning(|Unknown error applying component answer modifications!|)
    return
  endif

  -- Reselect rows in main table
  !rowIndices = ARRAY()
  do !ind indices !form.components
    !name = !form.components[!ind].name()
    if (!spcoNames.findFirst(!name).set()) then
      !rowIndices.append(!ind)
    endif
  enddo

  -- Ensure at least on row is selected, otherwise the Apply and Back buttons are disabled
  if (!rowIndices.empty()) then
    !rowIndices.append(1)
  endif

  !this.netSelectRows(!form, !rowIndices)

endmethod
-- End of method definition for .applyCompEditAns(FORM)

------------------------------------------------------------------------
--
-- Method:      initCompEditRefs
--
-- Description: Initialise component edit references panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initCompEditRefs(!form is FORM)

  -- Check that initialisation is required
  if (!form.isInitCompEditRefs.not()) then
    !form.isInitCompEditRefs = true
    return
  endif

  if (!form.selectedRows.empty().not()) then
    -- Get references for selected table items
    !prtrefNames = ARRAY()
    !catrefNames = ARRAY()
    !detailNames = ARRAY()
    !matxtNames = ARRAY()
    !cmprefNames = ARRAY()
    !bltrefNames = ARRAY()
    !tmprefNames = ARRAY()
    !pDaRefNames = ARRAY()

    -- Check for multiple values for each reference
    do !val values !form.selectedRows
      !prtrefNames.append(!this.getRefStr(!form, !form.components[!val], |PRTREF|))
      !catrefNames.append(!this.getRefStr(!form, !form.components[!val], |CATREF|))
      !detailNames.append(!this.getRefStr(!form, !form.components[!val], |DETAIL|))
      !matxtNames.append(!this.getRefStr(!form, !form.components[!val], |MATXT|))
      !cmprefNames.append(!this.getRefStr(!form, !form.components[!val], |CMPREF|))
      !bltrefNames.append(!this.getRefStr(!form, !form.components[!val], |BLTREF|))
      !tmprefNames.append(!this.getRefStr(!form, !form.components[!val], |TMPREF|))
      !pDaRefNames.append(!this.getRefStr(!form, !form.components[!val], |PDAREF|))
    enddo
    -- Set ref values in gadgets and form members
    !this.setCompEditRef(!form, |PRTREF|, !this.checkVaries(!form, !prtrefNames))
    !this.setCompEditRef(!form, |CATREF|, !this.checkVaries(!form, !catrefNames))
    !this.setCompEditRef(!form, |DETAIL|, !this.checkVaries(!form, !detailNames))
    !this.setCompEditRef(!form, |MATXT|, !this.checkVaries(!form, !matxtNames))
    !this.setCompEditRef(!form, |CMPREF|, !this.checkVaries(!form, !cmprefNames))
    !this.setCompEditRef(!form, |BLTREF|, !this.checkVaries(!form, !bltrefNames))
    !this.setCompEditRef(!form, |TMPREF|, !this.checkVaries(!form, !tmprefNames))
    !this.setCompEditRef(!form, |PDAREF|, !this.checkVaries(!form, !pDaRefNames))
    -- Make frame active
    !form.frCompEditRefs.active = true
    -- Check for part ref set
    !this.checkPrtrefSet(!form)

    -- Disable apply button for read-only databases
    !form.bnCompEditRefsApply.active = !form.isSpecUpdateable

  else
    -- Clear all references
    !this.setCompEditRef(!form, |PRTREF|, object STRING())
    !this.setCompEditRef(!form, |CATREF|, object STRING())
    !this.setCompEditRef(!form, |DETAIL|, object STRING())
    !this.setCompEditRef(!form, |MATXT|, object STRING())
    !this.setCompEditRef(!form, |CMPREF|, object STRING())
    !this.setCompEditRef(!form, |BLTREF|, object STRING())
    !this.setCompEditRef(!form, |TMPREF|, object STRING())
    !this.setCompEditRef(!form, |PDAREF|, object STRING())
    -- Make frame inactive
    !form.frCompEditRefs.active = false

  endif

  -- Reset panel modified flag
  !form.isModCompEditRefs = false

endmethod
-- End of method definition for .initCompEditRefs(FORM)

------------------------------------------------------------------------
--
-- Method:      actionCompEditRefs
--
-- Description: Gadget actions for component edit references panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionCompEditRefs(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  -- Gadget actions
  -- Ref text fields
  if (!object eq !form.txCompEditPrtref and !action eq |SELECT|) then
    !validatedRef = !!catValidateRefField(!form.txCompEditPrtref, |GPART|)
    if (!validatedRef.set() and !validatedRef.empty()) then
      !form.txCompEditPrtref.val = !form.compEditPrtref
    elseif (!validatedRef.unset()) then
      !this.setCompEditRef(!form, |PRTREF|, !form.unsetRefStr)
      !form.isModCompEditRefs = true
    else
      !this.setCompEditRef(!form, |PRTREF|, !validatedRef.dbref().namn)
      !form.isModCompEditRefs = true
    endif
  elseif (!object eq !form.txCompEditCatref and !action eq |SELECT|) then
    !validatedRef = !!catValidateRefField(!form.txCompEditCatref, |SCOM|)
    if (!validatedRef.set() and !validatedRef.empty()) then
      !form.txCompEditCatref.val = !form.compEditCatref
    elseif (!validatedRef.unset()) then
      !this.setCompEditRef(!form, |CATREF|, !form.unsetRefStr)
      !form.isModCompEditRefs = true
    else
      !this.setCompEditRef(!form, |CATREF|, !validatedRef.dbref().namn)
      !form.isModCompEditRefs = true
    endif
  elseif (!object eq !form.txCompEditDetail and !action eq |SELECT|) then
    !validatedRef = !!catValidateRefField(!form.txCompEditDetail, |SDTE|)
    if (!validatedRef.set() and !validatedRef.empty()) then
      !form.txCompEditDetail.val = !form.compEditDetail
    elseif (!validatedRef.unset()) then
      !this.setCompEditRef(!form, |DETAIL|, !form.unsetRefStr)
      !form.isModCompEditRefs = true
    else
      !this.setCompEditRef(!form, |DETAIL|, !validatedRef.dbref().namn)
      !form.isModCompEditRefs = true
    endif
  elseif (!object eq !form.txCompEditMatxt and !action eq |SELECT|) then
    !validatedRef = !!catValidateRefField(!form.txCompEditMatxt, |SMTE|)
    if (!validatedRef.set() and !validatedRef.empty()) then
      !form.txCompEditMatxt.val = !form.compEditMatxt
    elseif (!validatedRef.unset()) then
      !this.setCompEditRef(!form, |MATXT|, !form.unsetRefStr)
      !form.isModCompEditRefs = true
    else
      !this.setCompEditRef(!form, |MATXT|, !validatedRef.dbref().namn)
      !form.isModCompEditRefs = true
    endif
  elseif (!object eq !form.txCompEditCmpref and !action eq |SELECT|) then
    !validatedRef = !!catValidateRefField(!form.txCompEditCmpref, |CMPD TUBD|)
    if (!validatedRef.set() and !validatedRef.empty()) then
      !form.txCompEditCmpref.val = !form.compEditCmpref
    elseif (!validatedRef.unset()) then
      !this.setCompEditRef(!form, |CMPREF|, !form.unsetRefStr)
      !form.isModCompEditRefs = true
    else
      !this.setCompEditRef(!form, |CMPREF|, !validatedRef.dbref().namn)
      !form.isModCompEditRefs = true
    endif
  elseif (!object eq !form.txCompEditBltref and !action eq |SELECT|) then
    !validatedRef = !!catValidateRefField(!form.txCompEditBltref, |SBOL MBOL|)
    if (!validatedRef.set() and !validatedRef.empty()) then
      !form.txCompEditBltref.val = !form.compEditBltref
    elseif (!validatedRef.unset()) then
      !this.setCompEditRef(!form, |BLTREF|, !form.unsetRefStr)
      !form.isModCompEditRefs = true
    else
      !this.setCompEditRef(!form, |BLTREF|, !validatedRef.dbref().namn)
      !form.isModCompEditRefs = true
    endif
  elseif (!object eq !form.txCompEditTmpref and !action eq |SELECT|) then
    !validatedRef = !!catValidateRefField(!form.txCompEditTmpref, |TMPL|)
    if (!validatedRef.set() and !validatedRef.empty()) then
      !form.txCompEditTmpref.val = !form.compEditTmpref
    elseif (!validatedRef.unset()) then
      !this.setCompEditRef(!form, |TMPREF|, !form.unsetRefStr)
      !form.isModCompEditRefs = true
    else
      !this.setCompEditRef(!form, |TMPREF|, !validatedRef.dbref().namn)
      !form.isModCompEditRefs = true
    endif
  elseif (!object eq !form.txcompEditPDaRef and !action eq |SELECT|) then
    !validatedRef = !!catValidateRefField(!form.txcompEditPDaRef, |PDATAB WTHTAB|)
    if (!validatedRef.set() and !validatedRef.empty()) then
      !form.txcompEditPDaRef.val = !form.compEditPDaRef
    elseif (!validatedRef.unset()) then
      !this.setCompEditRef(!form, |PDAREF|, !form.unsetRefStr)
      !form.isModCompEditRefs = true
    else
      !this.setCompEditRef(!form, |PDAREF|, !validatedRef.dbref().namn)
      !form.isModCompEditRefs = true
    endif

  -- Search buttons
  elseif (!object eq !form.bnCompEditPrtrefS and !action eq |SELECT|) then
    !form.isInitSearch           = true
    !form.searchCallFrame        = |COMPEDITREFS|
    !form.searchCallGadget       = !form.txCompEditPrtref
    !form.searchDbType           = |CATA|
    !form.searchScope.clear()
    !form.searchScope[1]         = |/*|
    !form.searchEleTypes.clear()
    !form.searchEleTypes[1]      = |GPART|
    !form.searchFilters.clear()
    --!form.searchFilters[1]       = |NAME like *|
    !form.searchMultiSel         = false
    !form.searchColumns.clear()
    !form.searchColumns[1]       = |DESC Description|
    !form.searchColumns[2]       = |NAME Name|
    !form.searchColumns[3]       = |OWNER.NAME Owner|
    !form.searchColumns[4]       = |DBNAME Database|
    !this.pushTaskPanel(!form.frSearch, |Search (Part)|)
  elseif (!object eq !form.bnCompEditCatrefS and !action eq |SELECT|) then
    !form.isInitSearch           = true
    !form.searchCallFrame        = |COMPEDITREFS|
    !form.searchCallGadget       = !form.txCompEditCatref
    !form.searchDbType           = |CATA|
    !form.searchScope.clear()
    !form.searchScope[1]         = |/*|
    !form.searchEleTypes.clear()
    !form.searchEleTypes[1]      = |SCOM|
    !form.searchFilters.clear()
    --!form.searchFilters[1]       = |NAME like *|
    !form.searchMultiSel         = false
    !form.searchColumns.clear()
    !form.searchColumns[1]       = |OWNER.cSTA Standard|
    !form.searchColumns[2]       = |GTYPE Gtype|
    !form.searchColumns[3]       = |OWNER.DESC Description|
    !form.searchColumns[4]       = |NAME Name|
    !form.searchColumns[5]       = |OWNER.NAME Owner|
    !form.searchColumns[6]       = |DBNAME Database|
    !this.pushTaskPanel(!form.frSearch, |Search (Catalogue)|)
  elseif (!object eq !form.bnCompEditDetailS and !action eq |SELECT|) then
    !form.isInitSearch           = true
    !form.searchCallFrame        = |COMPEDITREFS|
    !form.searchCallGadget       = !form.txCompEditDetail
    !form.searchDbType           = |CATA|
    !form.searchScope.clear()
    !form.searchScope[1]         = |/*|
    !form.searchEleTypes.clear()
    !form.searchEleTypes[1]      = |SDTE|
    !form.searchFilters.clear()
    --!form.searchFilters[1]       = |NAME like *|
    !form.searchMultiSel         = false
    !form.searchColumns.clear()
    !form.searchColumns[1]       = |RTEXT Rtext|
    !form.searchColumns[2]       = |NAME Name|
    !form.searchColumns[3]       = |SKEY Skey|
    !form.searchColumns[4]       = |OWNER.NAME Owner|
    !form.searchColumns[5]       = |DBNAME Database|
    --!form.searchColumns[6]       = |STEXT Stext|
    !form.searchColumns[6]       = |TTEXT Ttext|
    !this.pushTaskPanel(!form.frSearch, |Search (Iso Detail)|)
  elseif (!object eq !form.bnCompEditMatxtS and !action eq |SELECT|) then
    !form.isInitSearch           = true
    !form.searchCallFrame        = |COMPEDITREFS|
    !form.searchCallGadget       = !form.txCompEditMatxt
    !form.searchDbType           = |CATA|
    !form.searchScope.clear()
    !form.searchScope[1]         = |/*|
    !form.searchEleTypes.clear()
    !form.searchEleTypes[1]      = |SMTE|
    !form.searchFilters.clear()
    --!form.searchFilters[1]       = |NAME like *|
    !form.searchMultiSel         = false
    !form.searchColumns.clear()
    !form.searchColumns[1]       = |XTEXT Xtext|
    !form.searchColumns[2]       = |NAME Name|
    !form.searchColumns[3]       = |YTEXT Ytext|
    !form.searchColumns[4]       = |ZTEXT Ztext|
    !form.searchColumns[5]       = |OWNER.NAME Owner|
    !form.searchColumns[6]       = |DBNAME Database|
    !this.pushTaskPanel(!form.frSearch, |Search (Iso Material)|)
  elseif (!object eq !form.bnCompEditCmprefS and !action eq |SELECT|) then
    !form.isInitSearch           = true
    !form.searchCallFrame        = |COMPEDITREFS|
    !form.searchCallGadget       = !form.txCompEditCmpref
    !form.searchDbType           = |PROP|
    !form.searchScope.clear()
    !form.searchScope[1]         = |/*|
    !form.searchEleTypes.clear()
    !form.searchEleTypes[1]      = |CMPD|
    !form.searchEleTypes[2]      = |TUBD|
    !form.searchFilters.clear()
    --!form.searchFilters[1]       = |NAME like *|
    !form.searchMultiSel         = false
    !form.searchColumns.clear()
    !form.searchColumns[1]       = |TYPE Type|
    !form.searchColumns[2]       = |NAME Name|
    !form.searchColumns[3]       = |CWEI Component Weight|
    !form.searchColumns[4]       = |UWEI Unit Weight|
    !form.searchColumns[5]       = |OWNER.NAME Owner|
    !form.searchColumns[6]       = |DBNAME Database|
    !this.pushTaskPanel(!form.frSearch, |Search (Property component)|)
  elseif (!object eq !form.bnCompEditBltrefS and !action eq |SELECT|) then
    !form.isInitSearch           = true
    !form.searchCallFrame        = |COMPEDITREFS|
    !form.searchCallGadget       = !form.txCompEditBltref
    !form.searchDbType           = |CATA|
    !form.searchScope.clear()
    !form.searchScope[1]         = |/*|
    !form.searchEleTypes.clear()
    !form.searchEleTypes[1]      = |SBOL|
    !form.searchEleTypes[2]      = |MBOL|
    !form.searchFilters.clear()
    --!form.searchFilters[1]       = |NAME like *|
    !form.searchMultiSel         = false
    !form.searchColumns.clear()
    !form.searchColumns[1]       = |TYPE Type|
    !form.searchColumns[2]       = |NAME Name|
    !form.searchColumns[3]       = |OWNER.NAME Owner|
    !form.searchColumns[4]       = |DBNAME Database|
    !this.pushTaskPanel(!form.frSearch, |Search (Part Ref)|)
  elseif (!object eq !form.bnCompEditTmprefS and !action eq |SELECT|) then
    !form.isInitSearch           = true
    !form.searchCallFrame        = |COMPEDITREFS|
    !form.searchCallGadget       = !form.txCompEditTmpref
    !form.searchDbType           = |DESI|
    !form.searchScope.clear()
    !form.searchScope[1]         = |/*|
    !form.searchEleTypes.clear()
    !form.searchEleTypes[1]      = |TMPL|
    !form.searchFilters.clear()
    --!form.searchFilters[1]       = |NAME like *|
    !form.searchMultiSel         = false
    !form.searchColumns.clear()
    !form.searchColumns[1]       = |DESC Description|
    !form.searchColumns[2]       = |NAME Name|
    !form.searchColumns[3]       = |OWNER.NAME Owner|
    !form.searchColumns[4]       = |DBNAME Database|
    !this.pushTaskPanel(!form.frSearch, |Search (Part Ref)|)
  elseif (!object eq !form.bncompEditPDaRefS and !action eq |SELECT|) then
    !form.isInitSearch           = true
    !form.searchCallFrame        = |COMPEDITREFS|
    !form.searchCallGadget       = !form.txcompEditPDaRef
    !form.searchDbType           = |CATA|
    !form.searchScope.clear()
    !form.searchScope[1]         = |/*|
    !form.searchEleTypes.clear()
    !form.searchEleTypes[1]      = |PDATAB|
    !form.searchEleTypes[2]      = |WTHTAB|
    !form.searchFilters.clear()
    --!form.searchFilters[1]       = |NAME like *|
    !form.searchMultiSel         = false
    !form.searchColumns.clear()
    !form.searchColumns[1]       = |DESC Description|
    !form.searchColumns[2]       = |NAME Name|
    !form.searchColumns[3]       = |OWNER.NAME Owner|
    !form.searchColumns[4]       = |DBNAME Database|
    !this.pushTaskPanel(!form.frSearch, |Search (Pipe Data Ref)|)

  -- Ref CE buttons
  elseif (!object eq !form.bnCompEditPrtrefC and !action eq |SELECT|) then
    if (!!ce.type eq |GPART|) then
      !this.setCompEditRef(!form, |PRTREF|, !!ce.namn)
      !form.isModCompEditRefs = true
    else
      !!alert.warning(|Specified reference is not the correct type, a GPART reference is required!|)
    endif
  elseif (!object eq !form.bnCompEditCatrefC and !action eq |SELECT|) then
    if (!!ce.type eq |SCOM|) then
      !this.setCompEditRef(!form, |CATREF|, !!ce.namn)
      !form.isModCompEditRefs = true
    else
      !!alert.warning(|Specified reference is not the correct type, a SCOM reference is required!|)
    endif
  elseif (!object eq !form.bnCompEditDetailC and !action eq |SELECT|) then
    if (!!ce.type eq |SDTE|) then
      !this.setCompEditRef(!form, |DETAIL|, !!ce.namn)
      !form.isModCompEditRefs = true
    else
      !!alert.warning(|Specified reference is not the correct type, a SDTE reference is required!|)
    endif
  elseif (!object eq !form.bnCompEditMatxtC and !action eq |SELECT|) then
    if (!!ce.type eq |SMTE|) then
      !this.setCompEditRef(!form, |MATXT|, !!ce.namn)
      !form.isModCompEditRefs = true
    else
      !!alert.warning(|Specified reference is not the correct type, a SMTE reference is required!|)
    endif
  elseif (!object eq !form.bnCompEditCmprefC and !action eq |SELECT|) then
    if (!!ce.type inset(|CMPD|, |TUBD|)) then
      !this.setCompEditRef(!form, |CMPREF|, !!ce.namn)
      !form.isModCompEditRefs = true
    else
      !!alert.warning(|Specified reference is not the correct type, a CMPD or TUBD reference is required!|)
    endif
  elseif (!object eq !form.bnCompEditBltrefC and !action eq |SELECT|) then
    if (!!ce.type inset(|SBOL|, |MBOL|)) then
      !this.setCompEditRef(!form, |BLTREF|, !!ce.namn)
      !form.isModCompEditRefs = true
    else
      !!alert.warning(|Specified reference is not the correct type, a SBOL or MBOL reference is required!|)
    endif
  elseif (!object eq !form.bnCompEditTmprefC and !action eq |SELECT|) then
    if (!!ce.type eq |TMPL|) then
      !this.setCompEditRef(!form, |TMPREF|, !!ce.namn)
      !form.isModCompEditRefs = true
    else
      !!alert.warning(|Specified reference is not the correct type, a TMPL reference is required!|)
    endif
  elseif (!object eq !form.bncompEditPDaRefC and !action eq |SELECT|) then
    if (!!ce.type eq |PDATAB| or !!ce.type eq |WTHTAB|) then
      !this.setCompEditRef(!form, |PDAREF|, !!ce.namn)
      !form.isModCompEditRefs = true
    else
      !!alert.warning(|Specified reference is not the correct type, a PDATAB/WTHTAB reference is required!|)
    endif

  -- Ref Link buttons
  elseif (!object eq !form.bnCompEditPrtrefL and !action eq |SELECT|) then
    !form.refListCallFrame = |COMPEDITREFS|
    !form.refListCallGadget = !form.txCompEditPrtref
    !form.refListCallType = |GPART|
    !form.refListSingleSel = true
    --!form.isInitRefList = false
    !this.pushTaskPanel(!form.frRefList, |Gparts|)
  elseif (!object eq !form.bnCompEditCatrefL and !action eq |SELECT|) then
    !form.refListCallFrame = |COMPEDITREFS|
    !form.refListCallGadget = !form.txCompEditCatref
    !form.refListCallType = |SCOM|
    !form.refListSingleSel = true
    --!form.isInitRefList = false
    !this.pushTaskPanel(!form.frRefList, |Scoms|)
  elseif (!object eq !form.bnCompEditDetailL and !action eq |SELECT|) then
    !form.refListCallFrame = |COMPEDITREFS|
    !form.refListCallGadget = !form.txCompEditDetail
    !form.refListCallType = |SDTE|
    !form.refListSingleSel = true
    --!form.isInitRefList = false
    !this.pushTaskPanel(!form.frRefList, |Detail texts|)
  elseif (!object eq !form.bnCompEditMatxtL and !action eq |SELECT|) then
    !form.refListCallFrame = |COMPEDITREFS|
    !form.refListCallGadget = !form.txCompEditMatxt
    !form.refListCallType = |SMTE|
    !form.refListSingleSel = true
    --!form.isInitRefList = false
    !this.pushTaskPanel(!form.frRefList, |Material Text|)
  elseif (!object eq !form.bnCompEditCmprefL and !action eq |SELECT|) then
    !form.refListCallFrame = |COMPEDITREFS|
    !form.refListCallGadget = !form.txCompEditCmpref
    !form.refListCallType = |CMPD|
    !form.refListSingleSel = true
    --!form.isInitRefList = false
    !this.pushTaskPanel(!form.frRefList, |Cmpds|)
  elseif (!object eq !form.bnCompEditBltrefL and !action eq |SELECT|) then
    !form.refListCallFrame = |COMPEDITREFS|
    !form.refListCallGadget = !form.txCompEditBltref
    !form.refListCallType = |SBOL|
    !form.refListSingleSel = true
    --!form.isInitRefList = false
    !this.pushTaskPanel(!form.frRefList, |Single Bolts|)
  elseif (!object eq !form.bnCompEditTmprefL and !action eq |SELECT|) then
    !form.refListCallFrame = |COMPEDITREFS|
    !form.refListCallGadget = !form.txCompEditTmpref
    !form.refListCallType = |TMPL|
    !form.refListSingleSel = true
    --!form.isInitRefList = false
    !this.pushTaskPanel(!form.frRefList, |Templates|)
   elseif (!object eq !form.bncompEditPDaRefL and !action eq |SELECT|) then
    !form.refListCallFrame = |COMPEDITREFS|
    !form.refListCallGadget = !form.txcompEditPDaRef
    !form.refListCallType = |PDATAB|
    !form.refListSingleSel = true
    --!form.isInitRefList = false
    !this.pushTaskPanel(!form.frRefList, |Pipe Data Table|)


  -- Back button
  elseif (!object eq !form.bnCompEditRefsBack and !action eq |SELECT|) then
    if (!form.isModCompEditRefs eq true and !form.isSpecUpdateable) then
      !confirm = !!alert.question(|Apply changes before going back?|)
      if (!confirm eq |CANCEL|) then
        return
      elseif (!confirm eq |YES|) then
        !this.applyCompEditRefs(!form)
      else
        !form.isModCompEditRefs = false
      endif
    endif
    !this.popTaskPanel(!form)
    return

  endif

endmethod
-- End of method definition for .actionCompEditRefs(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      applyCompEditRefs
--
-- Description: Apply action for component edit references panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyCompEditRefs(!form is FORM)

  if (!form.selectedRows.size() eq 0) then
    return
  endif

  !spcoNames = ARRAY()
  do !val values !form.selectedRows
    !spcoNames.append(!form.components[!val].name())
    if (!this.txUnsetToEmpty(!form.txCompEditPrtref.val) ne !form.unsetRefStr) then
      -- If prtref is set then don't set the other refs
      !this.setRefStr(!form, !form.components[!val], |PRTREF|, !this.txUnsetToEmpty(!form.txCompEditPrtref.val))
    else
      -- If prtref is not set then set all refs
      !this.setRefStr(!form, !form.components[!val], |PRTREF|, !this.txUnsetToEmpty(!form.txCompEditPrtref.val))
      !this.setRefStr(!form, !form.components[!val], |CATREF|, !this.txUnsetToEmpty(!form.txCompEditCatref.val))
      !this.setRefStr(!form, !form.components[!val], |DETAIL|, !this.txUnsetToEmpty(!form.txCompEditDetail.val))
      !this.setRefStr(!form, !form.components[!val], |MATXT|,  !this.txUnsetToEmpty(!form.txCompEditMatxt.val))
      !this.setRefStr(!form, !form.components[!val], |CMPREF|, !this.txUnsetToEmpty(!form.txCompEditCmpref.val))
      !this.setRefStr(!form, !form.components[!val], |BLTREF|, !this.txUnsetToEmpty(!form.txCompEditBltref.val))
      !this.setRefStr(!form, !form.components[!val], |TMPREF|, !this.txUnsetToEmpty(!form.txCompEditTmpref.val))
      !this.setRefStr(!form, !form.components[!val], |PDAREF|, !this.txUnsetToEmpty(!form.txcompEditPDaRef.val))
    endif
    -- Save speccomponent modifications back to specheading object
    !form.components[!val].setExisting(true)
    !form.currentHdg.addComponent(!form.components[!val], !val, false)
  enddo

  -- Save specheading modifications back to specification object
  !hdgIndex = !form.opHeadings.selection().real()
  !okFlag = !form.specification.addHeading(!form.currentHdg, !hdgIndex, false)
  if (!okFlag) then
    if (!form.currentHdg.componentCount() gt 0) then
      -- save changes to db
      !this.saveToDb(!form, false)
      handle any
        !!alert.warning(!!error.text)
      endhandle

      -- Reinitialise the specification object
      !form.specification = object CATSPECIFICATION(!form.specdbref)
      !this.actionCompTable(!form.opHeadings, |SELECT|)
    endif
    -- Unset modified flag
    !form.isModCompEditRefs = false
  elseif (!okFlag.not()) then
    !!alert.warning(|Unknown error applying component reference modifications!|)
    return
  endif

  -- Reselect rows in main table
  !rowIndices = ARRAY()
  do !ind indices !form.components
    !name = !form.components[!ind].name()
    if (!spcoNames.findFirst(!name).set()) then
      !rowIndices.append(!ind)
    endif
  enddo
  !this.netSelectRows(!form, !rowIndices)

endmethod
-- End of method definition for .applyCompEditRefs(FORM)

------------------------------------------------------------------------
--
-- Method:      setCompEditRef
--
-- Description: Set new reference on component edit references panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--    2   R      STRING      Name of reference attribute
--    3   R      STRING      Value to set reference to
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCompEditRef(!form is FORM, !attName is STRING, !attValue is STRING)

  -- Set form reference gadget and members
  if (!attValue.unset()) then
    !form.attribute(|TXCOMPEDIT| & !attName).clear()
    !form.attribute(|COMPEDIT| & !attName) = object STRING()
  elseif (!attValue.set()) then
    !form.attribute(|TXCOMPEDIT| & !attName).val = !attValue
    !form.attribute(|COMPEDIT| & !attName) = !attValue
  endif

  -- Check prtref and set active state of other ref gadgets accordingly
  !this.checkPrtrefSet(!form)

endmethod
-- End of method definition for .setCompEditRef(FORM, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      initCompUserAtts
--
-- Description: Initialise the 'Edit Extra UDAs' panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initCompEditUserAtts(!form is FORM)

  -- Check that initialisation is required
  if (!form.isInitCompEditUserAtts.not()) then
    !form.isInitCompEditUserAtts = true
    return
  endif

  -- The first time the panel is displayed, find all the UDA names defined for SPCOs and build lists
  -- of the UDA names and types. If the UDA cannot be edited by this form the type is set to an empty string.
  -- Currently Array, Position, Direction and Orientation type UDAs cannot be edited.

  if (!form.findUserAttNames) then
    -- Create arrays to match attribute type codes to type names
    !editableUserAttTypeCodes = ARRAY()
    !editableUserAttTypeCodes.append(1) $* Integer
    !editableUserAttTypeCodes.append(2) $* Real
    !editableUserAttTypeCodes.append(3) $* Logical
    !editableUserAttTypeCodes.append(4) $* Text
    !editableUserAttTypeCodes.append(5) $* Reference
    !editableUserAttTypeCodes.append(6) $* Word

    !editableUserAttTypes = ARRAY()
    !editableUserAttTypes.append('INTEGER')
    !editableUserAttTypes.append('REAL')
    !editableUserAttTypes.append('LOGICAL')
    !editableUserAttTypes.append('TEXT')
    !editableUserAttTypes.append('REFERENCE')
    !editableUserAttTypes.append('WORD')

    -- Retrieve the first component - there must always be at least one before this panel can be displayed
    -- for the first time
    !specComponent = !form.components[1]
    !componentRef = !specComponent.name().dbref()

    -- Find names of all UDAs defined for this component
    !form.userAttNames = !componentRef.attribute('UDALIS')
    !attDefinition = object ATTDEFINITION()
    !form.userAttTypes = ARRAY()

    do !userAttName value !form.userAttNames
      !attDefinition.attLibGet(!userAttName)
      !userAttType = STRING()
      if (!editableUserAttTypeCodes.findFirst(!attDefinition.typeCode).set()) then
        -- Word attributes appear to have a typeCode set to 4 instead of the expected 6 so a check
        -- on iType is used to identify word attributes. In 12.1 this may be fixed.
        if (!attDefinition.iType eq 11) then
          !userAttType = 'WORD'
        else
          !userAttType = !editableUserAttTypes[!attDefinition.typeCode]
        endif
        -- Check for arrays and pseudo attributes
        if((!userAttType ne 'TEXT' and !userAttType ne 'WORD' and !attDefinition.size ne 1) or !attDefinition.definition.eqNoCase('Pseudo')) then
          !userAttType = STRING()
        endif
      endif
     !form.userAttTypes.append(!userAttType)
    enddo

    -- Make the relevant text gadgets and CE buttons visible
    !gadgetIndex = 1
    !userAttNames = !form.userAttNames
    do !userAttIndex indices !form.userAttTypes
      !userAttType = !form.userAttTypes[!userAttIndex]
      if (!userAttType.set()) then
        !textGadget = !form.userAttTextGadgets[!gadgetIndex]
        !textGadget.tag = !userAttNames[!userAttIndex]
        !textGadget.visible = true

        !enableButtons = !userAttType eq 'REFERENCE'
        !form.userAttCeButtons[!gadgetIndex].active = !enableButtons
        !form.userAttCeButtons[!gadgetIndex].visible = !enableButtons
        !form.userAttSearchButtons[!gadgetIndex].active = !enableButtons
        !form.userAttSearchButtons[!gadgetIndex].visible = !enableButtons

        !gadgetIndex = !gadgetIndex + 1
        break if (!gadgetIndex gt !form.userAttTextGadgets.size())
      endif
    enddo

  -- Hide unused gadgets
    do !gadgetIndex from !gadgetIndex to !form.userAttTextGadgets.size()
      !form.userAttTextGadgets[!gadgetIndex].visible = false
      !form.userAttSearchButtons[!gadgetIndex].visible = false
      !form.userAttCeButtons[!gadgetIndex].visible = false
    enddo
    !form.findUserAttNames = false
  endif

  -- Get UDAs for the selected rows, set the corresponding text fields and optionally
  -- enable the CE buttons
  if (!form.selectedRows.empty().not()) then
    -- Get answers and check for multiple values for each UDA
    !userAtts = ARRAY()
    !gadgetIndex = 1
    !userAttNames = !form.userAttNames
    do !index indices !userAttNames
      !tmpUserAtts = object ARRAY()
      !userAttType = !form.userAttTypes[!index]
      if (!userAttType.set()) then
        !userAttName = !userAttNames[!index]
        do !row values !form.selectedRows
          !specComponent = !form.components[!row]
          !componentRef = !specComponent.name().dbref()

          !userAtt = !componentRef.attribute(!userAttName)
          if (!userAttType EQ 'REFERENCE') then
            if (!userAtt.unset()) then
              !userAttString = !form.unsetRefStr
            elseif (!userAtt.badref()) then
              !userAttString = !form.badRefStr
            else
              !userAttString = !userAtt.attribute('NAMN')
            endif
          else
            if (!userAtt.set()) then
              !userAttString = !userAtt.string()
            else
              !userAttString = 'Unset'
            endif
          endif
          !tmpUserAtts.append(!userAttString)
          !userAtt.delete()
        enddo
        !userAttValue = !this.checkVaries(!form, !tmpUserAtts)
        !form.userAttTextGadgets[!gadgetIndex].val = !userAttValue
        !userAtts.append(!userAttValue)
        !gadgetIndex = !gadgetIndex + 1
      endif
    enddo

    -- Make frame active
    !form.frCompEditUserAtts.active = true
  else
    -- Make frame inactive
    !form.frCompEditUserAtts.active = false
    -- Empty text gadgets
    do !textGadget values !form.userAttTextGadgets
      !textGadget.val = ''
    enddo
  endif

  -- Reset panel modified flag
  !form.isModCompEditUserAtts = false

endmethod
-- End of method definition for .initCompEditUserAtts(FORM)

------------------------------------------------------------------------
--
-- Method:      actionCompEditUserAtts
--
-- Description: Gadget actions for edit UDAs panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionCompEditUserAtts(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()
  if (!action eq |SELECT|) then

     -- CE buttons
    !gadgetIndex = !form.userAttCeButtons.findFirst(!object)
    if (!gadgetIndex.set()) then
      !form.userAttTextGadgets[!gadgetIndex].val = !!ce.namn
      !form.isModCompEditUserAtts = true
      return
    endif

    -- Search button
    !gadgetIndex = !form.userAttSearchButtons.findFirst(!object)
    if (!gadgetIndex.set()) then
      !form.isInitSearch           = true
      !form.searchCallFrame        = |COMPEDITUDAS|
      !form.searchCallGadget       = !form.userAttTextGadgets[!gadgetIndex]
      !form.searchDbType           = |CATA|
      !form.searchScope.clear()
      !form.searchScope[1]         = |/*|
      !form.searchEleTypes.clear()
      !form.searchEleTypes[1]      = ||
      !form.searchFilters.clear()
      !form.searchMultiSel         = false
      !form.searchColumns.clear()
      !form.searchColumns[1]       = |NAME Name|
      !form.searchColumns[2]       = |OWNER.NAME Owner|
      !form.searchColumns[3]       = |CATREF Component|
      !form.searchColumns[4]       = |DBNAME Database|
      !this.pushTaskPanel(!form.frSearch, |Search (UDA Reference))|)

    -- Back button
    elseif (!object eq !form.bnCompEditUserAttsBack) then

      if (!form.isModCompEditUserAtts eq true) then
        !confirm = !!alert.question(|Apply changes before going back?|)
        if (!confirm eq |CANCEL|) then
          return
        elseif (!confirm eq |YES|) then
          !this.applyCompEditUserAtts(!form)
        else
          !form.isModCompEditUserAtts = false
        endif
      endif
      !this.popTaskPanel(!form)
    endif
  endif

endmethod
-- End of method definition for .actionCompEditUserAtts(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      applyCompEditUserAtts
--
-- Description: Apply action for edit UDAs panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyCompEditUserAtts(!form is FORM)

  !savedCE = !!ce
  !userAttNames = !form.userAttNames
  !gadgetIndex = 1
  do !index indices !userAttNames
    !userAttName = !userAttNames[!index]
    !userAttType = !form.userAttTypes[!index]
    !selectedRows = !form.netCompTable.getSelectedRows()
    if (!userAttType.set()) then
      do !row values !selectedRows
        !value = !form.attribute(|TXCOMPEDITUSERATT| & !gadgetIndex).val
        skip if (!value eq !form.varyStr)
        !component = !row[1]
        !this.setUserAtt(!form, !component, !userAttName, !userAttType,  !value)
        handle any
          !!alert.error(!!error.text)
          !!ce = !savedCE
          return
        endhandle
      enddo
      !gadgetIndex = !gadgetIndex + 1
    endif
  enddo

  -- Unset modified flag
  !form.isModCompEditUserAtts = false
  !this.initCompEditUserAtts(!form)
  !!ce = !savedCE

endmethod
  -- End of method definition for .applyCompEditUserAtts(FORM)

------------------------------------------------------------------------
--
-- Method:      setUserAtt
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     element     Element
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setUserAtt(!form is FORM, !elementName is STRING, !userAttName is STRING, !userAttType is STRING, !rawValue is STRING)

  !element = !elementName.dbref()
  !value = !this.txUnsetToEmpty(!rawValue)
  !value = !value.trim()
  if (!userAttType EQ 'REFERENCE') then
    if (!value ne !form.badRefStr) then
      !name = !value.trim()
      !dbref = !name.dbref()
      handle any
        !name = '/' & !name
      endhandle
      !element.attribute(!userAttName) = !name.dbref()
      handle (41,52)
        return error 1 |Error setting $!userAttName$n. Incorrect reference type|
      elsehandle (2, 107)
        return error 1 |Error setting $!userAttName$n. Undefined reference|
      elsehandle (2,796)
        $!element $!userAttName unset
      elsehandle any
        return error 1 |$!userAttName$n could not be set|
      endhandle
    endif
  elseif (!userAttType eq 'LOGICAL') then

    if (!value.empty()) then
      if (!element.attribute(!userAttName).set()) then
        return error 1 |Error setting $!userAttName$n. Unset or invalid data|
      else
        return
      endif
    endif
    !element.attribute(!userAttName) = !value.boolean()
    handle any
      return  error 1 |Error setting attribute $!userAttName|
    endhandle

  elseif (!userAttType eq 'TEXT') then
    !element.attribute(!userAttName) = !value
    handle any
        return error 1 |$!!error.text|
    endhandle
  elseif (!userAttType eq 'WORD') then
    $!element $!userAttName |$!value|

    handle any
      return error 1 |Error setting attribute $!userAttName|
    endhandle
  else
    !element.attribute(!userAttName) = !value.real()
    handle any
      if (!value.trim().empty()) then
        if (!element.attribute(!userAttName).unset()) then
          return
        endif
        !errorMessage = |Error setting | & !userAttName & |. Unset or invalid data|
      else
        !errorMessage = |Error setting attribute| & !userAttName
      endif
      return error 1 |$!errorMessage|
    endhandle
  endif

endmethod
-- End of method definition for .setUserAtt(FORM)

------------------------------------------------------------------------
--
-- Method:      checkPrtrefSet
--
-- Description: Check if prtref is set on component edit refs panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkPrtrefSet(!form is FORM)

  if (!form.txCompEditPrtref.val ne !form.unsetRefStr) then
    !form.txCompEditCatref.active  = false
    !form.bnCompEditCatrefS.active = false
    !form.bnCompEditCatrefC.active = false
    !form.txCompEditDetail.active  = false
    !form.bnCompEditDetailS.active = false
    !form.bnCompEditDetailC.active = false
    !form.bnCompEditDetailL.active = false
    !form.txCompEditMatxt.active   = false
    !form.bnCompEditMatxtS.active  = false
    !form.bnCompEditMatxtC.active  = false
    !form.bnCompEditMatxtL.active  = false
    !form.txCompEditCmpref.active  = false
    !form.bnCompEditCmprefS.active = false
    !form.bnCompEditCmprefC.active = false
    !form.bnCompEditCmprefL.active = false
    !form.txCompEditBltref.active  = false
    !form.bnCompEditBltrefS.active = false
    !form.bnCompEditBltrefC.active = false
    !form.bnCompEditBltrefL.active = false
    !form.txCompEditTmpref.active  = false
    !form.bnCompEditTmprefS.active = false
    !form.bnCompEditTmprefC.active = false
    !form.bnCompEditTmprefL.active = false
    !form.txcompEditPDaRef.active  = false
    !form.bncompEditPDaRefS.active = false
    !form.bncompEditPDaRefC.active = false
    !form.bncompEditPDaRefL.active = false
  else
    !form.txCompEditCatref.active  = true
    !form.bnCompEditCatrefS.active = true
    !form.bnCompEditCatrefC.active = true
    !form.bnCompEditDetailC.active = true
    !form.txCompEditDetail.active  = true
    !form.bnCompEditDetailS.active = true
    !form.bnCompEditDetailL.active = true
    !form.txCompEditMatxt.active   = true
    !form.bnCompEditMatxtS.active  = true
    !form.bnCompEditMatxtC.active  = true
    !form.bnCompEditMatxtL.active  = true
    !form.txCompEditCmpref.active  = true
    !form.bnCompEditCmprefS.active = true
    !form.bnCompEditCmprefC.active = true
    !form.bnCompEditCmprefL.active = true
    !form.txCompEditBltref.active  = true
    !form.bnCompEditBltrefS.active = true
    !form.bnCompEditBltrefC.active = true
    !form.bnCompEditBltrefL.active = true
    !form.txCompEditTmpref.active  = true
    !form.bnCompEditTmprefS.active = true
    !form.bnCompEditTmprefC.active = true
    !form.bnCompEditTmprefL.active = true
    !form.txcompEditPDaRef.active  = true
    !form.bncompEditPDaRefS.active = true
    !form.bncompEditPDaRefC.active = true
    !form.bncompEditPDaRefL.active = true
  endif

endmethod
-- End of method definition for .checkPrtrefSet(FORM)

------------------------------------------------------------------------
--
-- Method:      initRename
--
-- Description: Initialise rename panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initRename(!form is FORM)

  -- Check that initialisation is required
  if (!form.isInitRename.not()) then
    !form.isInitRename = true
    return
  endif

  -- Reset toggle to auto name
  !form.frRenameOptions.val = 1
  !this.actionRename(!form.frRenameOptions, |SELECT|)

  -- Get element type being renamed
  if (!form.renameCallGadget eq !form.bnSpecRename) then
    !type = |SPEC|
    !form.rtRenameSizes.visible = false
  elseif (!form.renameCallGadget eq !form.bnSpecCompRename) then
    !type = |SPCO|
    !form.rtRenameSizes.visible = false
  endif

  -- Set apply button active state#
  if (!form.selectedRows.size() eq 0 and !type eq |SPCO|) then
    !form.bnRenameApply.active = false
  else
    !form.bnRenameApply.active = true
  endif

  -- Apply panel modified flag
  !form.isModRename = false

endmethod
-- End of method definition for .initRename(FORM)

------------------------------------------------------------------------
--
-- Method:      actionRename
--
-- Description: Gadget actions for rename panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionRename(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  -- Gadget actions
  -- Option toggles
  if (!object eq !form.frRenameOptions and !action eq |SELECT|) then

    !form.tRenameComponents.visible = !form.renameCallGadget eq !form.bnSpecRename

    -- Auto name
    if (!form.frRenameOptions.val eq 1) then
      !form.txRenameDetail2.visible = false
      !form.txRenameDetail1.tag = 'Message'
      if (!form.renameCallGadget eq !form.bnSpecRename) then
        !form.txRenameDetail1.val = |Press Apply to auto-name the specification|
      else
        !form.txRenameDetail1.val = |Press Apply to auto-name the selected components|
      endif
      !form.txRenameDetail1.editable = false
      !form.txRenameDetail1.visible = true

    -- Specify
    elseif (!form.frRenameOptions.val eq 2) then
      !form.txRenameDetail2.visible = false
      !form.txRenameDetail1.clear()
      !form.txRenameDetail1.tag = 'Specify'
      !form.txRenameDetail1.editable = true
      !form.txRenameDetail1.visible = true
    -- Replace
    elseif (!form.frRenameOptions.val eq 3) then
      !form.txRenameDetail1.tag = 'Replace'
      !form.txRenameDetail1.clear()
      !form.txRenameDetail1.editable = true
      !form.txRenameDetail1.visible = true
      !form.txRenameDetail2.tag = 'With'
      !form.txRenameDetail2.clear()
      !form.txRenameDetail2.visible = true
    -- Sizes
    elseif (!form.frRenameOptions.val eq 4) then
      !form.txRenameDetail2.visible = false
      !form.txRenameDetail1.val = |Press APPLY to append component sizes to item names|
      !form.txRenameDetail1.tag = 'Message'
      !form.txRenameDetail1.editable = false
      !form.txRenameDetail1.visible = true
    endif

  -- Details 1
  elseif (!object eq !form.txRenameDetail1 and !action eq |SELECT|) then
    if (!form.frRenameOptions.val eq 2) then
      !validatedName = !!catValidateNameField(!form.txRenameDetail1)
      if (!validatedName.set() and !validatedName.empty()) then
        !form.txRenameDetail1.clear()
      endif
      !form.isModRename = true
    endif

  -- Details 2
  elseif (!object eq !form.txRenameDetail2 and !action eq |SELECT|) then
    !form.isModRename = true

  -- Back button
  elseif (!object eq !form.bnRenameBack and !action eq |SELECT|) then
    if (!form.isModRename eq true) then
      !confirm = !!alert.question(|Apply changes before going back?|)
      if (!confirm eq |CANCEL|) then
        return
      elseif (!confirm eq |YES|) then
        !this.applyRename(!form)
      else
        !form.isModRename = false
      endif
    endif
    !this.popTaskPanel(!form)
    return

  endif

endmethod
-- End of method definition for .actionRename(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      applyRename
--
-- Description: Apply action for rename panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyRename(!form is FORM)

  -- Save current element and row selection
  !dbpos = !!ce

  -- Find the currently selected items
  !selectedRows = !form.selectedRows

  !update = !this.rename(!form)
  handle any
    !update = true
    !!alert.error(!!error.text)
  endhandle

  -- Reinitialise the specification object
  if (!update) then
    !!catSpecViews.init(!form, false)
    !this.netSelectRows(!form, !selectedRows)
  endif

  -- Reset modified flag
  !form.isModRename = false

  -- Restore current element
  !!ce = !dbpos

endmethod
-- End of method .applyRename

------------------------------------------------------------------------
--
-- Method:      rename
--
-- Description: Rename specification and/or components
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if the specification has changed and the form needs updating
--
------------------------------------------------------------------------
define method .rename(!form is FORM) is BOOLEAN

  -- Get element type being renamed
  if (!form.renameCallGadget eq !form.bnSpecRename) then
    !type = |SPEC|
  elseif (!form.renameCallGadget eq !form.bnSpecCompRename) then
    !type = |SPCO|
  endif

  !unname = object BLOCK('ce unname')
  -- Remember names for reselecting after specification refresh
  !spcodbrefs = object ARRAY()
  !renameList = object ARRAY()
  -- Auto name
  if (!form.frRenameOptions.val eq 1) then
    if (!type eq |SPEC|) then
      !renameList.append(!form.specdbref)
      if (!form.tRenameComponents.val) then
        !renameList.appendArray(!!collectAllFor('SPCO', '', !form.specdbref))
      endif
    else $* Selected components only
      do !row values !form.selectedRows
        !spcodbrefs.append(!form.components[!row].name().dbref())
      enddo
      !renameList = !spcodbrefs
    endif

    !index = 0
    !size = !renameList.size()
    do !element values !renameList
      -- Autonaming is slow so display a progress bar
      if (!index.modulo(!size / 10.0).int() eq 0 ) then
         !!fmsys.setProgress(100 * !index / !size)
      endif
      -- Unname element so that the autoname index is not incremented unless necessary
      !name = STRING()
      if (!element.isnamed) then
        !name = !element.name
        !element.evaluate(!unname)
      endif

      -- Move ce to the element as the some naming rules rely on this
      !!ce = !element
      !autoName = !!namOpt.nameString(!element, object STRING(), false, false)
      handle any
        -- Restore name
        if (!name.set()) then
          !element.name = !name
        endif
        !!alert.error(!element.namn + ' could not be auto-named. Naming rule does not exist or is not valid for this element.')
        return true
      endhandle
      if (!autoName.unset().not()) then
        !element.name = '/' + !autoName
      elseif (!name.set()) then
        -- Restore name
        !element.name = !name
      endif
      !index = !index + 1
    enddo
    !!fmsys.setProgress(0.0)

  -- Specify
  elseif (!form.frRenameOptions.val eq 2) then
    !newName = !this.txUnsetToEmpty(!form.txRenameDetail1.val).trim()
    if (!newName.empty()) then
        !ans = !!alert.question(|No name specified, Do you want un-name the element(s)|)
        if (!ans EQ 'YES') then
          if (!type eq |SPEC|) then
            !renameList.append(!form.specdbref)
            if (!form.tRenameComponents.val) then
              !renameList.appendArray(!!collectAllFor('SPCO', '', !form.specdbref))
            endif
          else
            do !row value !form.selectedRows
              !spcodbrefs.append(!form.components[!row].name().dbref())
            enddo
           !renameList = !spcodbrefs
          endif

          do !element value !renameList
             !!ce = !element
             unname
          enddo
        else
          !form.txRenameDetail1.clear()
          return false
        endif
    else
      if (!newName.substring(1,1) eq '/') then
        !renameStr = !newName
      else
        !renameStr = '/' & !newName
      endif

      if (!type eq |SPEC|) then
        if (!form.tRenameComponents.val) then
          !!alert.warning(|The 'Specify' option cannot be used when 'Rename components' is set|)
          return false
        endif
        !form.specdbref.name = !renameStr
      elseif (!form.selectedRows.size() eq 1) then
        !element = !form.components[!form.selectedRows[1]].name().dbref()
        !element.name = !renameStr
        !spcodbrefs.append(!element)
      else
        !!alert.warning(|The 'Specify' option is only valid for renaming single items. Please select a single item and try again!|)
        return false
      endif
    endif

  -- Replace
  elseif (!form.frRenameOptions.val eq 3) then
    !oldString = !this.txUnsetToEmpty(!form.txRenameDetail1.val).trim()
    !newString = !this.txUnsetToEmpty(!form.txRenameDetail2.val).trim()
    if (!oldString.empty() or !newString.empty()) then
      !!alert.warning(|Both values must be entered, please enter values and try again!|)
      return false
    endif
    if (!type eq |SPEC|) then
      !!ce = !form.specdbref
      !specName = !!ce.name
      if (!specName.match(!oldString) gt 0) then
        !renameStr = !specName.replace(!oldString, !newString)
        !!ce.name = !renameStr
        handle any
          !!alert.error(!!error.text)
          return
        elsehandle none
          if (!form.tRenameComponents.val) then
            rename all $!<specName> $!<renameStr>
            handle any
              !!alert.error(!!error.text)
            endhandle
          endif
        endhandle
      else
        !!alert.warning(|The 'Replace' string does not occur in the specification name!|)
        !!ce = !dbpos
        return false
      endif
    else
      do !val values !form.selectedRows
        !spcoName = !form.components[!val].name()
        !element = !spcoName.dbref()
        !spcodbrefs.append(!element)
        if (!spcoName.match(!oldString) gt 0) then
          !renameStr = !spcoName.replace(!oldString, !newString)
          !element.name = !renameStr
        endif
      enddo
    endif

  endif

  return true

endmethod
-- End of method definition for .applyRename(FORM)

------------------------------------------------------------------------
--
-- Method:      initSearch
--
-- Description: Initialise Search panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSearch(!form is FORM)

  -- Check that initialisation is required
  if (!form.isInitSearch.not()) then
    !form.isInitSearch = true
    return
  endif

  !form.searchResults.clear()
  !form.bnSearchAdd.active = false

  -- Initialise search control
  !displayResults = false
  !form.searchControl.initiateSearch(!displayResults, |Search|, !form.searchDbType,$
     !form.searchScope, !form.searchEleTypes, !form.searchFilters, !form.searchColumns)

  -- Reset panel modified flag
  !form.isModSearch = false

endmethod
-- End of method definition for .initSearch(FORM)

------------------------------------------------------------------------
--
-- Method:      actionSearch
--
-- Description:  Gadget actions for Search panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionSearch(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  -- Gadget actions
  -- Initialise new search
  if (!object eq !form.bnSearchNew and !action eq |SELECT|) then
    !form.isInitSearch = true
    !this.initSearch(!form)

  -- Back button
  elseif (!object eq !form.bnSearchBack and !action eq |SELECT|) then
    -- Unset the init flag of the calling panel, there may be other
    -- modified gadgets that haven't been applied yet.
    !form.attribute(|ISINIT| & !form.searchCallFrame) = false
    !this.popTaskPanel(!form)

  endif

endmethod
-- End of method definition for .actionSearch(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      applySearch
--
-- Description: Apply action for Search panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applySearch(!form is FORM)
  if (!form.searchCallFrame eq |SPECCADATTS|) then
    !form.searchCallGadget.val = !form.searchResults[1].namn
    !form.isInitSpecCadAtts    = false
    !form.isModSpecCadAtts     = true

  elseif (!form.searchCallFrame eq |COMPADD|) then
    !form.compAdddbref         = !form.searchResults[1]
    !form.searchCallGadget.val = !form.searchResults[1].namn
    !form.txCompAddDesc.val    = !form.searchResults[1].description
    !form.isInitCompAdd        = false
    !form.isModCompAdd         = true

    if (!form.opCompAddCodes.selection() inset(|INSU|, |BOLT|)) then
      !this.getComponentSizes(!form.searchCallGadget, !form.searchResults[1].string(), |SETRANGES|, !form.opCompAddCodes.selection())
    endif

  elseif (!form.searchCallFrame eq |COMPADDLIMBO|) then
    !element = !form.searchResults[1]
    !form.isInitCompAddLimbo = false

    -- Check type and owner
    if (!this.isLimboSpco(!element)) then
      !form.searchCallGadget.val = !element.namn
      !this.setAddLimboFields(!form, !element)
      !form.isModCompAddLimbo  = true
    else
      return
    endif

  elseif (!form.searchCallFrame eq |COMPEDITUDAS|) then
    !element = !form.searchResults[1]
    !form.isInitCompEditUserAtts = false
    !form.searchCallGadget.val = !element.namn
    !form.isModCompEditUserAtts  = true

  elseif (!form.searchCallFrame eq |COMPEDITREFS|) then
    !attName = !form.searchCallGadget.name().after('TXCOMPEDIT')
    !this.setCompEditRef(!form, !attName, !form.searchResults[1].namn)
    !form.isInitCompEditRefs   = false
    !form.isModCompEditRefs    = true
  endif

  -- Go back to calling panel
  !this.popTaskPanel(!form)

endmethod
-- End of method definition for .applySearch(FORM)

------------------------------------------------------------------------
--
-- Method:      initRefList
--
-- Description: Initialise reference list for specified list type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initRefList(!form is FORM)

  using namespace  'Aveva.Pdms.Presentation'

  -- Get list name to populate
  !refListName  = |REFLIST|  & !form.refListCallType & |S|
  !refAttsName  = |REFATTS|  & !form.refListCallType & |S|
  !refDbRefName = |REFdbref| & !form.refListCallType & |S|



  -- Populate list array on first show of panel or on refresh
  if (!form.attribute(!refListName).unset()) then
    !attributeNames = !form.attribute(!refAttsName)

    -- Collect all the relevant elements
    !elementCollection = object COLLECTION()
    !elementCollection.type(!form.refListCallType)
    !elementDbRefs = !elementCollection.results()

    -- Create expressions to evaluate
    !expressions = ARRAY()
    do !valA values !attributeNames
      !expressions.append(OBJECT EXPRESSION(!valA))
    enddo

    -- Compile rows for table
    !rows = ARRAY()
    do !valD values !elementDbRefs
      !line = object ARRAY()
      do !valA values !expressions
        !line.append(!valA.evaluate(!valD))
      enddo
      !rows.append(!line)
    enddo

    !form.attribute(!refDbRefName) = !elementDbRefs
    !form.attribute(!refListName) = !rows
  endif

  -- Clear grid ready for repopulating
  !form.netRefList.clearGrid()

  -- Set single row selection
  !form.netRefList.singleRowSelection(!form.refListSingleSel)

  -- Total indicator
  !listTi = !form.refListCallType & | List|

  -- Bind to data source
  !ndsTable = object NETDATASOURCE(!listTi, !form.attribute(!refAttsName), !form.attribute(!refListName))
  !form.netRefList.bindToDataSource(!ndsTable)

  -- Select first row in the list
  !form.bnRefListAdd.active = false
  !form.netRefList.selectRow(0)
endmethod
-- End of method definition for .initRefList(FORM)

------------------------------------------------------------------------
--
-- Method:      actionRefList
--
-- Description: Gadget actions for reference list panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionRefList(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  -- Gadget actions
  -- Refresh
  if (!object eq !form.bnRefListNew and !action eq |SELECT|) then
    -- Get list name and clear it
    !refListName = |REFLIST| & !form.refListCallType & |S|
    !refDbRefName  = |REFdbref| & !form.refListCallType & |S|
    !form.attribute(!refListName).clear()
    !form.attribute(!refDbRefName ).clear()
    -- Initialise the list
    !this.initRefList(!form)

  -- Back
  elseif (!object eq !form.bnRefListBack and !action eq |SELECT|) then
    -- Unset the init flag of the calling panel, there may be other
    -- modified gadgets that haven't been applied yet.
    !!ce = !form.specdbref
    !form.attribute(|ISINIT| & !form.refListCallFrame) = false
    !this.popTaskPanel(!form)

  endif

endmethod
-- End of method definition for .actionRefList(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      applyRefList
--
-- Description: Apply action for reference list panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyRefList(!form is FORM)
  if (!form.refListCallFrame eq |COMPADD|) then
    !refDbRefName                = |REFdbref| & !form.refListCallType & |S|
    !rowIndex                   = !form.selectedRefListRows[1]
    !dbref                      = !form.attribute(!refDbRefName )[!rowIndex]
    !form.compAdddbref          = !dbref
    !form.refListCallGadget.val = !dbref.namn
    !form.txCompAddDesc.val     = !dbref.description
    !form.isInitCompAdd         = false
    !form.isModCompAdd          = true
    !!ce                        = !form.specdbref

    if (!form.opCompAddCodes.selection() inset(|INSU|, |BOLT|)) then
     !this.getComponentSizes(!form.refListCallGadget, !dbref.string(), |SETRANGES|, !form.opCompAddCodes.selection())
    endif

  elseif (!form.refListCallFrame eq |COMPADDLIMBO|) then
    !refDbRefName                = |REFdbref| & !form.refListCallType & |S|
    !rowIndex                   = !form.selectedRefListRows[1]
    !dbref                      = !form.attribute(!refDbRefName )[!rowIndex]
    !form.compAdddbref          = !dbref
    !form.refListCallGadget.val = !dbref.namn
    !form.isInitCompAddLimbo    = false
    !form.isModCompAddLimbo     = true
    !!ce                        = !form.specdbref

  elseif (!form.refListCallFrame eq |COMPEDITREFS|) then
    !refDbRefName     = |REFdbref| & !form.refListCallType & |S|
    !rowIndex        = !form.selectedRefListRows[1]
    !dbref           = !form.attribute(!refDbRefName )[!rowIndex]
    -- Convert call type to ref type for .setCompEditRef() method
    !callTypeStr     = |GPART SCOM SDTE SMTE CMPD TUBD SBOL MBOL TMPL WTHTAB|
    !callTypes       = !callTypeStr.split()
    !refTypeStr      = |PRTREF CATREF DETAIL MATXT CMPREF CMPREF BLTREF BLTREF TMPREF PDAREF|
    !refTypes        = !refTypeStr.split()
    !refTypeIndex    = !callTypes.findFirst(!form.refListCallType)
    -- Set selected reference
    !this.setCompEditRef(!form, !refTypes[!refTypeIndex], !dbref.namn)
    -- Set task panel flags
    !form.isInitCompEditRefs = false
    !form.isModCompEditRefs  = true
    !!ce                     = !form.specdbref
  endif

  -- Go back to calling panel
  !this.popTaskPanel(!form)

endmethod
-- End of method definition for .applyRefList(FORM)

------------------------------------------------------------------------
--
-- Method:      updateRecentCes
--
-- Description: Update recent CE list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateRecentCes(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  if (!object eq !form.opRecentCes and !action eq |SELECT|) then
    !!ce = !object.selection().dbref()
    handle (2,107)
      -- Bad spec ref (must have been deleted)
      !!alert.error (|Selected specification is no longer available|)
      if (!form.cataType inset ('BRAN', 'REDU')) then
        !type = |BRTAB|
      else
        !type = !form.cataType
      endif
      !form.opRecentCes.dtext = !!catRecentObjects.dtext(!type)
      !form.opRecentCes.rtext = !!catRecentObjects.rtext(!type)
    elsehandle none
      !this.init(!form, true)
    endhandle
  endif

endmethod
-- End of method definition for .updateRecentCes(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      setFormName
--
-- Description: Set the form name to the Specification name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setFormName(!form is FORM)

  if (!form.cataType eq |SPEC|) then
    !formTitle = |Specification|
    if (!form.isSpecUpdateable) then
      !formTitle= !formTitle & |: |
    else
      !formTitle = !formTitle & | [Read Only]: |
    endif
    if (!form.mode eq 1) then
      !form.formTitle = !formTitle & !form.specification.name() & | (Engineering view)|
    else
      !form.formTitle = !formTitle & !form.specification.name() & | (CAD view)|
    endif
    !form.iconTitle = !form.specification.name()
  elseif (!form.cataType eq |NOMTAB|) then
    !form.formTitle = |Size Range: | & !form.nomBoreTab.namn
    !form.iconTitle = !form.nomBoreTab.namn
  elseif (!form.cataType eq |WTHTAB|) then
    !form.formTitle = |Wall Thickness Table: | & !form.nomBoreTab.namn
    !form.iconTitle = !form.nomBoreTab.namn
  elseif (!form.cataType eq |PDATAB|) then
    !form.formTitle = |Pipe Data Table: | & !form.nomBoreTab.namn
    !form.iconTitle = !form.nomBoreTab.namn
  elseif (!form.cataType eq |BRTAB:BRAN|) then
    !form.formTitle = |Branch Table: | & !form.branchTab.namn
    !form.iconTitle = !form.branchTab.namn
  elseif (!form.cataType eq |BRTAB:REDU|) then
    !form.formTitle = |Reducer Table: | & !form.reducerTab.namn
    !form.iconTitle = !form.reducerTab.namn
  elseif (!form.cataType eq |BRTAB:PTAP|) then
    !form.formTitle = |Pipe Tapping Table: | & !form.tappingTab.namn
    !form.iconTitle = !form.tappingTab.namn
  endif

endmethod
-- End of method definition for .setFormName(FORM)

------------------------------------------------------------------------
--
-- Method:      txEmptyToUnset
--
-- Description: Convert empty stings to unset strings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      String to convert for use in text input gadget
--
-- Return:
--   [Data Type] [Description]
--    STRING      Converted string
--
------------------------------------------------------------------------
define method .txEmptyToUnset(!text is STRING) is STRING

  if (!text.set() and !text.empty()) then
    return object STRING()
  else
    return !text
  endif

endmethod
-- End of method definition for .txEmptyToUnset(STRING)STRING

------------------------------------------------------------------------
--
-- Method:      txUnsetToEmpty
--
-- Description: Convert unset strings to empty strings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      String from text input gadget to convert
--
-- Return:
--   [Data Type] [Description]
--    STRING      Converted string
--
------------------------------------------------------------------------
define method .txUnsetToEmpty(!text is STRING) is STRING

  if (!text.unset()) then
    return ''
  else
    return !text
  endif

endmethod
-- End of method definition for .txUnsetToEmpty(STRING)STRING


------------------------------------------------------------------------
--
-- Method:      setUnitsToMetric
--
-- Description: Set bore and distance units to metric
--
------------------------------------------------------------------------
define method .setUnitsToMetric()
  -- Setting distance units may not be necessary but is done as a
  -- precautionary measure
  UNITS MM DIST
  UNITS MM BORE

  -- Set pressure units to database units
  !dimension = object MEASURE('Pressure')
  !dimension.setUnits(!dimension.dbUnit())

endmethod

------------------------------------------------------------------------
--
-- Method:      restoreFormUnits
--
-- Description: Restore bore and distance units to the form's values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
------------------------------------------------------------------------
define method .restoreFormUnits(!form is FORM )

  UNITS $!<form.distanceUnits> DIST
  UNITS $!<form.boreUnits> BORE

  !dimension = object MEASURE('Pressure')
  !dimension.setUnits(!form.pressureUnit)

endmethod

------------------------------------------------------------------------
--
-- Method:      saveToDb
--
-- Description: Run the spec into the database in it's current state
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--    2   R      BOOLEAN     Whether error (17,7) should be returned
--                           or an alert message displayed
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveToDb(!form is FORM, !returnError17 is BOOLEAN)

    !tmpFile = !form.specification.publish(false)

    -- Select metric units if necessary
    !this.setUnitsToMetric()
    !this.speconmode('speconmode')
    !!runMacro(!tmpFile, '')

    handle (17,7)
      $S+
      if (!returnError17) then
        !this.tidyUpAfterSaveToDb(!form, !tmpFile)
        return error
      else
        !!alert.error(|Error (17,7) Duplicate entries are trying to be defined in the spec, or the same search has been used more than once.|)
      endif
    elsehandle any
      $S+
      !this.tidyUpAfterSaveToDb(!form, !tmpFile)
      return error 1 |$!!<error.text>|
    endhandle

    !this.tidyUpAfterSaveToDb(!form, !tmpFile)

endmethod
-- End of method definition for .saveToDb(FORM)

------------------------------------------------------------------------
--
-- Method:      tidyUpAfterSaveToDb
--
-- Description: Tidy up after saving to the database
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--    2   R      STRING      File name

-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .tidyUpAfterSaveToDb(!form is FORM, !fileName is STRING )
  !this.speconmode('exit')
  !this.restoreFormUnits(!form)
  !form.specification.deleteFile(!fileName)
endmethod
-- End of method definition for .tidyUpAfterSaveToDb(STRING)

------------------------------------------------------------------------
--
-- Method:      buttonPick
--
-- Description: Show child form on button pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      Gadget actioned
--    2   R      STRING      Action invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .buttonPick(!gadget is GADGET, !action is STRING)

  -- Get form from which button was pressed
  !parentForm  = !gadget.owner()

  -- Check child form has been defined
  if (undefined(!!catChildForm)) then
    pml load form !!catChildForm
  endif

  -- Setup and display form
  !!catChildForm.setup(|for | & !parentForm.formTitle)
  !!catChildForm.show()

endmethod
-- End of method definition for .buttonPick(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      remove
--
-- Description: Remove spec view from the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .remove(!specView is FORM)

  -- Get form index
  !index = !this.viewIndex(!specView)

  -- Return if we can't find the form in the system
  if (!index.unset()) then
    return
  endif

  -- Remove form from the system
  !this.specViews[!index].delete()

  -- Kill the form
  !formString = '!!' & !specView.string()
  kill $!<formString>

  -- Update control form if exists and shown
  if (defined(!!catControl)) then
    if (!!catControl.shown()) then
      !!catControl.initialise()
    endif
  endif

endmethod
-- End of method definition for .remove(FORM)

------------------------------------------------------------------------
--
-- Method:      viewIndex
--
-- Description: Get form index in the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
-- Return:
--   [Data Type] [Description]
--    REAL        Index in the form list
--
------------------------------------------------------------------------

define method .viewIndex(!form is FORM) is REAL

  -- Loop through list
  do !i indices !this.specViews
    if (!form eq !this.specViews[!i]) then
      return !i
    endif
  enddo
  return REAL()

endmethod
-- End of method definition for .viewIndex(FORM) REAL

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU        Form bar menu selected from
--    2   R      STRING      Select state
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close(!menu is MENU, !dummySelected is STRING)

  -- Remove form from the system
  !form   = !menu.owner()
  !unusedField  = !menu.pickedField
  !this.remove(!form)

endmethod
-- End of method definition for .close(MENU, STRING)

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: Close the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .close(!form is FORM)

  -- Remove form from the system
  !this.remove(!form)

endmethod
-- End of method definition for .close(FORM)

------------------------------------------------------------------------
--
-- Method:      nextAvailable
--
-- Description: Next available form number
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    REAL        Available number
--
------------------------------------------------------------------------

define method .nextAvailable() is REAL

  return !this.specViews.maxIndex() + 1

endmethod
-- End of method definition for .nextAvailable() REAL

------------------------------------------------------------------------
--
-- Method:      netPopupCallback
--
-- Description: Pop up menu event for .net control on the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
--    2   R      ARRAY       Grid data
--                           [0] Cursor X
--                           [1] Cursor Y
--                           [2] Array of selected row tags (STRING data type)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netPopupCallback(!form is FORM, !data is ARRAY)

  -- Set menu fields that are valid for single selection only
  if (!form.selectedRows.size() eq 1 and !form.mode eq 2) then
    !form.puTable.setFieldProperty('NAVIGATE', 'ACTIVE', true)
    !form.puTable.setFieldProperty('EDIT', 'ACTIVE', true)
    -- Set menu fields for valid reference attributes only
    do !val values !form.cadRefsR
      !popupFieldName = 'NAV' & !val
      !refStr = !this.getRefStr(!form, !form.components[!form.selectedRows[1]], !val)
      if (!refStr eq !form.unsetRefStr or !refStr eq !form.badRefStr) then
        !form.puNavigateList.setFieldProperty(!popupFieldName , 'ACTIVE', false)
      else
        !form.puNavigateList.setFieldProperty(!popupFieldName , 'ACTIVE', true)
      endif
    enddo
    -- Set menu fields for valid edit forms only
    !editRefs[1] = |PRTREF|
    !editRefs[2] = |CATREF|
    do !val values !editRefs
      !popupFieldName = 'EDIT' & !val
      !refStr = !this.getRefStr(!form, !form.components[!form.selectedRows[1]], !val)
      if (!refStr eq !form.unsetRefStr or !refStr eq !form.badRefStr) then
        !form.puEditList.setFieldProperty(!popupFieldName , 'ACTIVE', false)
      else
        !form.puEditList.setFieldProperty(!popupFieldName , 'ACTIVE', true)
      endif
    enddo

  else
    !form.puTable.setFieldProperty('NAVIGATE', 'ACTIVE', false)
    !form.puTable.setFieldProperty('EDIT', 'ACTIVE', false)
  endif

  -- Show popup
  !form.conCompTable.showPopup(!data[0], !data[1])

endmethod
-- End of method definition for .netPopupCallback(FORM, ARRAY)

------------------------------------------------------------------------
--
-- Method:      tablePopup
--
-- Description: Pop up menu actions for .net control on the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      MENU       Pop up menu for .net control
--    1   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tablePopup(!object is MENU, !action is STRING)

  -- Get calling popup menu details
  !form = !object.owner()
  !pickedField = !object.pickedFieldName

  --Source spec popup
  if (!pickedField eq 'NAVSPCO') then
    !!ce = !form.components[!form.selectedRows[1]].name().dbref()
  elseif (!pickedField eq 'NAVCATREF') then
    !!ce = !form.components[!form.selectedRows[1]].getRef('CATREF')
  elseif (!pickedField eq 'NAVDETAIL') then
    !!ce = !form.components[!form.selectedRows[1]].getRef('DETAIL')
  elseif (!pickedField eq 'NAVMATXT') then
    !!ce = !form.components[!form.selectedRows[1]].getRef('MATXT')
  elseif (!pickedField eq 'NAVCMPREF') then
    !!ce = !form.components[!form.selectedRows[1]].getRef('CMPREF')
  elseif (!pickedField eq 'NAVBLTREF') then
    !!ce = !form.components[!form.selectedRows[1]].getRef('BLTREF')
  elseif (!pickedField eq 'NAVPRTREF') then
    !!ce = !form.components[!form.selectedRows[1]].getRef('PRTREF')
  elseif (!pickedField eq 'NAVTMPREF') then
    !!ce = !form.components[!form.selectedRows[1]].getRef('TMPREF')
  elseif (!pickedField eq 'NAVPDAREF') then
    !!ce = !form.components[!form.selectedRows[1]].getRef('PDAREF')
  elseif (!pickedField eq 'EDITPRTREF') then
    !!ce = !form.components[!form.selectedRows[1]].getRef('PRTREF')
    !!catPartViews.add()
  elseif (!pickedField eq 'EDITCATREF') then
    !!ce = !form.components[!form.selectedRows[1]].getRef('CATREF')
    !!catModelViews.add()
  --elseif (!pickedField eq 'COPY') then
  --
  --  *** Copy item ***
  --elseif (!pickedField eq 'PASTE') then
  --
  --  *** Paste item ***
  endif

endmethod
-- End of method definition for .tablePopup()

------------------------------------------------------------------------
--
-- Method:      netAfterSelect
--
-- Description: After select event for component grid control on the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--    2   R      ARRAY       Grid data, !a[0] is array of selected row tags
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netAfterSelect(!form is FORM, !a is ARRAY)

  -- Only process genuine user select events
  if (!a[0].set()) then
    -- Don't select the 'empty' row when table is empty
    if (!form.netCompTable.getRow(1)[1] eq !form.emptyString) then
      return
    endif
    -- Select items
    !form.selectedRows.clear()
    do !val values !a[0]
      !form.selectedRows.append(!val.real())
    enddo
  else
    !form.selectedRows.clear()
  endif

  -- Initialise the shown task panel if required
  if (!form.frSpec.visible) then
    !this.initSpec(!form)
  elseif (!form.frCompEditAns.visible) then
    !this.initCompEditAns(!form)
  elseif (!form.frCompEditRefs.visible) then
    !form.isInitCompEditRefs = true
    !this.initCompEditRefs(!form)
  elseif (!form.frCompEditUserAtts.visible) then
    !form.isInitCompEditUserAtts = true
    !this.initCompEditUserAtts(!form)
  elseif (!form.frRename.visible) then
    !form.isInitRename = true
    !this.initRename(!form)
  endif

endmethod
-- End of method definition for .netAfterSelect(FORM, ARRAY)

------------------------------------------------------------------------
--
-- Method:      netSelectRows
--
-- Description: Select the specified rows on the specified form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--    2   R      ARRAY       Rows to be selected
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netSelectRows(!form is FORM, !rows is ARRAY)

  -- Clear selection
  if (!rows.unset() or !rows.empty()) then
    -- Turn grid events off and on to avoid update
    !form.netCompTable.allGridEvents(false)
    !form.netCompTable.clearRowSelection()
    !form.netCompTable.allGridEvents(true)
    -- Clear form selection
    !form.selectedRows.clear()

  -- Don't select the 'empty' row when table is empty
  elseif (!rows.size() eq 1 and !form.netCompTable.getRow(1)[1] eq !form.emptyString) then
    return

  -- Select rows
  elseif (!rows.size() gt 0) then
    !rowTags = ARRAY()
    do !val values !rows
      !rowTags.append(!val.string())
    enddo
    -- Turn grid events off and on to avoid updating for every index
    !form.netCompTable.allGridEvents(false)
    !form.netCompTable.setSelectedRowTags(!rowTags)
    !form.netCompTable.allGridEvents(true)
    -- Reset form selection
    !form.selectedRows = !rows

  endif

  -- Initialise the shown task panel if required
  if (!form.frSpec.visible) then
    !this.initSpec(!form)
  elseif (!form.frCompEditAns.visible) then
    !this.initCompEditAns(!form)
  elseif (!form.frCompEditRefs.visible) then
    !form.isInitCompEditRefs = true
    !this.initCompEditRefs(!form)
  elseif (!form.frRename.visible) then
    !form.isInitRename = true
    !this.initRename(!form)
  endif

endmethod
-- End of method definition for .netSelectRows(FORM, ARRAY)

------------------------------------------------------------------------
--
-- Method:      netResultsSelected
--
-- Description: Select the specified rows on the specified form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SpecView form
--    2   R      ARRAY       Selected rows
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netResultsSelected(!form is FORM, !rows is ARRAY)

  -- Save search results as dbref's
  !dbrefNos = ARRAY()
  do !val values !rows
    !dbrefNos.append(!val)
  enddo
  !form.searchResults = !dbrefNos.evaluate(object BLOCK(|!dbrefNos[!evalIndex].dbref()|))

  if (!form.searchResults.empty()) then
    !form.bnSearchAdd.active = false
  else
    !form.bnSearchAdd.active = true
  endif

endmethod
-- End of method definition for .netResultsSelected(FORM, ARRAY)

------------------------------------------------------------------------
--
-- Method:      netRefListSelect
--
-- Description: After select event for ref list grid control on the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--    2   R      ARRAY       Grid data, !a[0] is array of selected row tags
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netRefListSelect(!form is FORM, !a is ARRAY)

  -- Get list name to populate
  --!refListName = |REFLIST| & !form.refListCallType & |S|
  --!refAttsName = |REFATTS| & !form.refListCallType & |S|
  !refDbRefName  = |REFdbref| & !form.refListCallType & |S|

  -- Only process genuine user select events
  if (!a[0].set()) then
    -- Select items
    !form.selectedRefListRows.clear()
    do !val values !a[0]
      !form.selectedRefListRows.append(!val.real())
    enddo
    -- Navigate to selected item
    !rowIndex = !form.selectedRefListRows[1]
    !form.bnRefListAdd.active = true
    !!ce = !form.attribute(!refDbRefName )[!rowIndex]
  else
    !form.selectedRefListRows.clear()
    !form.bnRefListAdd.active = false
    !!ce = !form.specdbref
  endif

endmethod
-- End of method definition for .netRefListSelect(FORM, ARRAY)

------------------------------------------------------------------------
--
-- Method:      netUpdateTableSelect
--
-- Description: Handler for the 'after select' event for the update table grid control
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--    2   R      ARRAY       Element zero contains the array of selected row tags
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .netUpdateTableSelect(!form is FORM, !rows is ARRAY)

  if (!rows[0].set()) then
    !form.bnSpecUpdateAttApply.active = !form.isSpecUpdateable
  else
    !form.bnSpecUpdateAttApply.active = false
  endif


endmethod
-- End of method definition for .netUpdateTableSelect(FORM, ARRAY)

------------------------------------------------------------------------
--
-- Method:      checkVaries
--
-- Description: Check if array values are the same or vary
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
--    2   R      ARRAY       Values to check
--
-- Return:
--   [Data Type] [Description]
--    REAL        The value or the varies string (specified in form member)
--
------------------------------------------------------------------------
define method .checkVaries(!form is FORM, !values is ARRAY) is STRING

  -- Check for differences and assign value accordingly
  !values.unique()
  if (!values.size() ne 1) then
  -- Must be differences
    return !form.varyStr
  else
  -- Must be the same
    return !values[1]
  endif

endmethod
-- End of method definition for .checkVaries(FORM, ARRAY)STRING

------------------------------------------------------------------------
--
-- Method:      setName
--
-- Description: Set element name after checking for '/', '=', unname, etc.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        SelTab view form
--    2   R      dbref       Element ref to name
--    3   R      STRING      Name string
--
-- Return:
--   [Data Type] [Description]
--    REAL        The value or the varies string (specified in form member)
--
------------------------------------------------------------------------
define method .setName(!form is FORM, !element is DBREF, !name is STRING)

  if (!name.empty()) then
    !!ce = !element
    unname
  elseif (!name.substring(1,1) eq |=|) then
    return
  elseif (!name.substring(1,1) ne |/|) then
    !element.name = '/' & !name
  else
    !element.name = !name
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      setFormUnits
--
-- Description: Set the forms units and bore format
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setFormUnits(!form is FORM)

  if (!!isImperialLength('BORE')) then
    !form.boreUnits        = |INCH|
    !form.metricBoreFlag   = false
    !form.boreFormat.dp    = 3
  else
    !form.boreUnits        = |MM|
    !form.metricBoreFlag   = true
    !form.boreFormat.units = |MM|
    !form.boreFormat.dp    = 0
  endif

  -- Set current distance units
  if(!!isImperialLength('DIST')) then
    !form.distanceUnits  = |INCH|
    !form.metricDistFlag = false
  else
    !form.distanceUnits  = |MM|
    !form.metricDistFlag = true
  endif

  -- Store current pressure unit
  !dimension = object MEASURE('Pressure')
  !form.pressureUnit = !dimension.currentUnits()

endmethod
-- End of method definition for .setFormUnits(FORM)

------------------------------------------------------------------------
--
-- Method:      formatRealAsNominalBore
--
-- Description: Takes a real nominal bore size in mm and converts it to a string
--              using the forms current bore format
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--    2   R      REAL        Real bore size in mm
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .formatRealAsNominalBore(!form is FORM, !boreSize is REAL, !useExactBore is BOOLEAN) is STRING

  if (!form.metricBoreFlag) then
    if (!useExactBore) then
      !bore = object BORE(!boreSize)
    else
      !bore = !boreSize.nearestBore()
    endif

  else
    !bore = object BORE(!boreSize.string(), !form.metricBoreFormat)
    handle (2,808) $* Input is not a bore value
      !this.setUnitsToMetric()
      !bore = !boreSize.nearestBore()
      !this.restoreFormUnits(!form)
    endhandle

  endif
  !str = !bore.string(!form.boreFormat)

  return !str
endmethod
-- End of method definition for formatRealAsNominalBore(FORM, REAL)


------------------------------------------------------------------------
--
-- Method:      useExactBore
--
-- Description: Function called to decide whether the exact bore or
--              the nearest bore should be used when formatting a bore.
--              Currently true is only returned for insulation
--              components
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .useExactBore(!form is FORM) is BOOLEAN

  !useExactBore = FALSE
  if (!form.currentHdg.componentCount() GT 0) then
    !compType = !this.getCompAnswer(!form, |TYPE|, !form.currentHdg, 1)
    if (!compType EQ |INSU|) then
      !useExactBore = TRUE
    endif
  endif
  return !useExactBore
endmethod
-- End of method definition for useExactBore(FORM)

------------------------------------------------------------------------
--
-- Method:      stripTrailingZeroes
--
-- Description: For a string representation of a real number, returns a
--              string with redundant trailing zeroes removed
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW    STRING      Truncated version of string
--
------------------------------------------------------------------------
define method .stripTrailingZeroes(!str is STRING)

  if (!str.match('.') GT 0 and !str.match('EX') eq 0) then
    !str = !str.trim('R', '0')
    !str = !str.trim('R', '.')
  endif

endmethod
-- End of method definition for stripTrailingZeroes(STRING)
