  endhandle

  -- Populate branch/reducer table
  !form.frConReducer.visible = false
  !tds = object PTABLEBRDATASOURCE(!branName, !reduName, !shortCodes, !boreUnitFlag, !typeFlag, !!catPipeTableCodes.reduGreyAreareadOnly)
