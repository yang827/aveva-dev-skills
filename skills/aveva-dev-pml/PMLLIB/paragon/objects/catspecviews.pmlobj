      text .txSpecAttNomRef tagwidth 15 'N.b. Ref.' anchor left + right at xmin.txSpecAttBspec ymax.txSpecAttBspec+0.25 width 50 scroll 60 is STRING
      button .bnSpecAttNomRefS      anchor right pixmap                          width 1
