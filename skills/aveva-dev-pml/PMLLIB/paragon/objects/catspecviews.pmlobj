      text .txBranchDesc tagwidth 8 'Description' at xmin.txBranchName ymax.txBranchName+0.25 width 50 scroll 60 is STRING
      path left
      button .bnBranchBack  'Back'  anchor right at xmax.frBranch-10 ymax+0.5 width 7
      button .bnBranchApply 'Apply' anchor right width 7
    exit

    -- Reducer task frame
    path down
    frame .frReducer anchor bottom + left + right at xmin form ymax.frConReducer width 80 height 5
      text .txReducerName tagwidth 8 'Name' at ymin+1.25 width 50 scroll 60 is STRING
      text .txReducerPurp tagwidth 8 'Purpose' at xmax+2 ymin width 4 scroll 4 is STRING
      text .txReducerDesc tagwidth 8 'Description' at xmin.txReducerName ymax.txReducerName+0.25 width 50 scroll 60 is STRING
      path left
      button .bnReducerBack 'Back'   anchor right at xmax.frReducer-10 ymax+0.5 width 7
      button .bnReducerApply 'Apply' anchor right width 7
    exit
    path down

     -- Tapping task frame
    frame .frTapping anchor bottom + left + right at xmin form ymax.frConTapping width 80 height 5
      text .txTappingName tagwidth 8 'Name' at ymin+1.25 width 50 scroll 60 is STRING
      text .txTappingPurp tagwidth 8 'Purpose' at xmax+2 ymin width 4 scroll 4 is STRING
      text .txTappingDesc tagwidth 8 'Description' at xmin.txTappingName ymax.txTappingName+0.25 width 50 scroll 60 is STRING
      path left
      button .bnTappingBack 'Back'   anchor right at xmax.frTapping-10 ymax+0.5 width 7
      button .bnTappingApply 'Apply' anchor right width 7
    exit

    -- Add headings panel
    path right
    frame .frHeadingEdit anchor bottom + left + right at xmin.frSpec ymin.frSpec                   width 80 height 13
      frame .frHeadingList panel anchor left          at xmin.frHeadingEdit+1 ymin.frHeadingEdit+1 width 25 height 8
        list .lsHeadingList 'Questions' zerosel                                                    width 31 length 8
        button .bnHeadingQAdd 'Add Question'    width 9 at xmin.lsHeadingList ymax.lsHeadingList+0.25
        button .bnHeadingQDelete pixmap at xmax+9
        button .bnHeadingQUp     pixmap
        button .bnHeadingQDown   pixmap
        button .bnHeadingStd 'Use Standard Heading Sets' width 18 at xmin.bnHeadingQAdd ymax.bnHeadingQAdd+1.25
        button .bnSaveSpecHeadings2 'Save Headings' at xmax.bnHeadingStd+1 ymin.bnHeadingStd     width 12
      exit

      frame .frHeadingEnter panel anchor left + right at xmax.frHeadingList ymin.frHeadingList+1 width 22 height 8
        combo .cmHeadingQues  tagwidth 8 'Question'                                              width 8 scroll 6
        option .opHeadingQual tagwidth 6 'Qualifier'  at xmax+2                                  width 5
        text .txHeadingDflt   tagwidth 8 'Default' anchor left + right at xmin.cmHeadingQues ymax.cmHeadingQues+1 width 25 scroll 60 is STRING
      exit
      path left
      button .bnHeadingBack 'Back'   anchor right at xmax.frHeadingEdit-10 ymax.frHeadingEdit-1.25 width 7
      button .bnHeadingApply 'Set Headings' anchor right                                           width 12
    exit

    -- Standard Spec Headings.
    frame .frSpecHeadings anchor bottom + left + right at xmin.frSpec ymin.frSpec width 80 height 13
      path right
      list .bnSpecHeadList 'Current Spec Headings'  at y1 width 15 length 12
      list .bnStdHeadList  'Standard Headings'      at y1 width 15 length 12
      list .bnSpecHeadings 'Questions and Defaults' at y1 width 31 length 8
      button .bnStdHeadingDelete pixmap at xmax.bnStdHeadList + 1 ymax.bnStdHeadList - 1
      button .bnSaveSpecHeadings 'Save Headings' at xmin.bnSpecHeadList ymax.bnSpecHeadList + 0.75  width 16
      button .bnLoadSpecHeadings 'Load Headings'                                                    width 16
      path left
      button .bnSpecHeadingsBack 'Back'   anchor right at xmax.frSpecHeadings-10 ymax.frSpecHeadings-1.25 width 7
      button .bnSpecHeadingsApply 'Use Selected Headings' anchor right                                    width 16
    exit

    -- Add items panel
    path down
    frame .frCompAdd anchor bottom + left + right at xmin.frSpec ymin.frSpec width 80 height 13
      --container .conItemTable nobox PmlNetCONTROL 'Items' anchor left + right at Xmin+2 Ymin+0.5 width 40 height 10
      frame .frCompAddCodes panel at xmin+2 ymin+1 width 16 height 8
        list .lsCompAddCodes noReselect            width 12 length 10
      exit
      frame .frCompAddRange 'Size Range' at xmin.frCompAddCodes+1 ymin.frCompAddCodes+0.5 width 15 height 7.5
        option .opCompAddFrom tagwidth 4 'From' at ymin+2 width 5
        option .opCompAddTo   tagwidth 4 'To'   at ymax+1 width 5
      exit
      option .opCompAddCodes '' at xmin width 11
      text .txCompAddStype tagwidth 5 'STYPe' anchor left + right at xmax.frCompAddCodes+2 ymin.frCompAdd+1.5 width 20 scroll 60 is STRING
      text .txCompAddHtype tagwidth 10 'Heading Type' anchor right at xmax+2 ymin width 15 is STRING
      frame .frCompAddFrom 'Add From' anchor left + right at xmin.txCompAddStype ymax+1 width 45 height 5
        path right
        button .bnCompAddCateList linklabel 'Category List...' at xmin+9 width 12
        button .bnCompAddPartList linklabel 'Part Family List...'        width 12
        button .bnCompAddCe linklabel 'CE'                               width 3
        button .bnCompAddSearch linklabel 'Search...'                    width 12
        path down
        text .txCompAddName tagwidth 8 'Name' anchor left + right at xmin.frCompAddFrom+1 ymax+0.25 width 43 scroll 60 is STRING
        text .txCompAddDesc tagwidth 8 'Description' anchor left + right at ymax0.25 width 43 scroll 120 is STRING
        toggle .tgCompAddAll |Add complete size range (include sizes where gpart/scom can't be found)| tagwidth 47
        toggle .tgAddAllBores |Add all PBOR1 and PBOR2 sizes| tagwidth 47
      exit
      path left
      button .bnCompAddBack 'Back'   anchor right at xmax.frCompAdd-10 ymax.frCompAdd-1.25 width 7
      button .bnCompAddApply 'Apply' anchor right                                          width 7
    exit


