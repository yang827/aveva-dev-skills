------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: Initialise method for the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--    2   R      BOOLEAN     Check SPCO's against GParts
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init(!form is FORM, !checkSpcoReferences is BOOLEAN)

  -- Check hierarchy
  !typeStr = |SPEC NOMTAB BRTAB WTHTAB PDATAB|
  !types = !typeStr.split()
  if (!types.findFirst(!!ce.type).unset()) then
    !ahTypes = !types.intersect(!!ce.ahList)
    if (!ahTypes.unset()) then
      return error 1 |Wrong element type, element must be a SPEC, NOMTAB or BRTAB!|
    else
      !type = !ahTypes[1]
      !!ce = !!ce.evaluate(object BLOCK(|$!type|))
    endif
  else
    !type = !!ce.type
  endif

  -- Set form's element type on first show of form
  if (!form.cataType eq |NONE|) then
    if (!type eq |BRTAB|) then
      if (!!ce.purpose eq |BRAN|) then
        !form.cataType = |BRTAB:BRAN|
      elseif (!!ce.purpose eq |REDU|) then
        !form.cataType = |BRTAB:REDU|
      elseif (!!ce.purpose eq |PTAP|) then
        !form.cataType = |BRTAB:PTAP|
      else
        return error 1 |BRTAB has an invalid purpose, you must set the purpose to 'BRAN','REDU' or PTAP!|
      endif
    else
      !form.cataType = !type
    endif
  endif

  -- Initialise form for the form's element type
  !formType = !form.cataType.before(':')
  if (!type ne !formType) then
    return error 1 |Element type must be a $!<formType>!|
  elseif (!type eq |SPEC|) then
    !form.specification = object CATSPECIFICATION(!!ce)
    -- *** Save specification dbref if originated from db!!!
    !form.specdbref = !!ce
    -- ***
    -- Decide whether to allow modification of the specification.
    -- Check for write access and that the first question is TYPE
    !form.isSpecUpdateable = !!dbRefUpdatable(!form.specdbref) and !form.specdbref.attribute(|Question|) eq |TYPE| and !form.isReadOnly.not()

    -- Check for empty questions on any SELE
    !coll = object COLLECTION()
    !coll.type('SELE')
    !coll.scope(!form.specdbref)
    !coll.filter(object EXPRESSION(|QUES EQ ''|))
    if (!coll.results().size() gt 0) then
      !form.isSpecUpdateable = false
    endif

    -- Check that a valid text answer has been set on all the top level SELEs and SPCOs
    !members = !form.specdbref.members
    do !item values !members
      if (!item.type inset('SELE', 'SPCO')) then
        if (!item.tans.trim().empty()) then
          !form.isSpecUpdateable = false
        endif
      endif
    enddo

    -- If the spec cannot be modified,change the word edit to the word show
    if (!form.isSpecUpdateable) then
      !form.bnSpecGenAtts.tag = 'Edit Spec Atts..'
      !form.bnSpecCadAtts.tag = 'Edit CAD Atts..'
    else
      !form.bnSpecGenAtts.tag = 'Show Spec Atts..'
      !form.bnSpecCadAtts.tag = 'Show CAD Atts..'
    endif

    !form.nomBoreTab = !form.specification.dbref('NOMREF')
    !form.branchTab = !form.specification.dbref('BRREF')
    !form.reducerTab = !form.specification.dbref('REDREF')
    !form.tappingTab = !form.specification.dbref('BRREF')

  elseif ((!type eq |NOMTAB|) or  (!type eq |WTHTAB|) or  (!type eq |PDATAB|)) then
    !form.nomBoreTab = !!ce
    !form.specification = object CATSPECIFICATION()
    !form.branchTab =  object DBREF()
    !form.reducerTab =  object DBREF()
    !form.tappingTab  =  object DBREF()
  elseif (!type eq |BRTAB|) then
    !testPurp = !form.cataType.after(':')
    if (!!ce.purpose ne !testPurp) then
      return error 1 |Wrong type of BRTAB, a purpose of $!<testPurp> expected!|
    elseif (!!ce.purpose eq |BRAN|) then
      !form.branchTab = !!ce
      !form.specification = object CATSPECIFICATION()
      !form.nomBoreTab = object DBREF()
      !form.reducerTab =  object DBREF()
      !form.tappingTab =  object DBREF()
    elseif (!!ce.purpose eq |REDU|) then
      !form.reducerTab = !!ce
      !form.specification = object CATSPECIFICATION()
      !form.nomBoreTab = object DBREF()
      !form.branchTab =  object DBREF()
      !form.tappingTab =  object DBREF()
    elseif (!!ce.purpose eq |PTAP|) then
      !form.tappingTab = !!ce
      !form.specification = object CATSPECIFICATION()
      !form.nomBoreTab = object DBREF()
      !form.branchTab =  object DBREF()
    else
      return error 1 |BRTAB has an invalid purpose, you must set the purpose to 'BRAN','REDU' or PTAP!|
    endif
  endif

  -- Setup the default bore format and the metric bore format
  !form.boreFormat               = object FORMAT()
  !form.boreFormat.dp            = 0
  !form.boreFormat.dimension     = 'L'
  !form.boreFormat.fraction      = false
  !form.boreFormat.denominator   = 32
  !form.boreFormat.padFractions  = true
  !form.boreFormat.inchSeparator = |.|
  !form.boreFormat.ftLabel       = |'|
  !form.boreFormat.trailZeros    = false
  !form.boreFormat.zeros         = false
  !form.boreFormat.label         = ||

  !form.metricBoreFormat         = !form.boreFormat
  !form.metricBoreFormat.units   = |MM|

  !this.setFormUnits(!form)

  -- Add CE to recent CE's option list
  !this.initRecentObjects(!form, !!ce)

  -- Clear task panels & stack
  !form.frSpec.visible             = false
  !form.frNomBore.visible          = false
  !form.frBranch.visible           = false
  !form.frReducer.visible          = false
  !form.frTapping.visible          = false
  !form.frSpecGenAtts.visible      = false
  !form.frSpecCadAtts.visible      = false
  !form.frSpecUpdateAtts.visible   = false
  !form.frHeadingEdit.visible      = false
  !form.frSpecHeadings.visible     = false
  !form.frCompAdd.visible          = false
  !form.frCompAddLimbo.visible     = false
  !form.frCompEditAns.visible      = false
  !form.frCompEditRefs.visible     = false
  !form.frCompEditUserAtts.visible = false
  !form.frRename.visible           = false
  !form.frSearch.visible           = false
  !form.frRefList.visible          = false
  !form.frCateList.visible         = false
  !form.frPartList.visible         = false
  !form.mode                       = 2
  !form.frViewMode.val             = 2

  !form.taskPanelStack.clear()
  -- Set appropriate main & task panel visible and initialise them
  if (!form.cataType eq |SPEC|) then
    !this.manageMainPanels(!form.frCompTable)
    !this.initCompTable(!form)
    !this.loadHeadings(!form)
    !this.pushTaskPanel(!form.frSpec, |Tasks|)

    if (!checkSpcoReferences) then
      !updateList = !form.specification.checkSpcoReferences()
      if (!updateList.size() gt 0) then
        !form.updateList = !updateList
        !form.bnSpecUpdateAtts.active = true
        !!alert.message(|There are mismatched reference attributes between some specification components and the associated Gparts. | &$
                        |Use 'Update Atts...' to update the specification components.|)
      else
        !form.updateList = ARRAY()
        !form.bnSpecUpdateAtts.active = false
      endif
    endif

  elseif ((!form.cataType eq |NOMTAB|) or (!form.cataType eq |WTHTAB|)or (!form.cataType eq |PDATAB|) ) then
    !this.manageMainPanels(!form.frConNomBore)
    !this.pushTaskPanel(!form.frNomBore, '')
    !form.bnNomBoreBack.active = false
  elseif (!form.cataType eq |BRTAB:BRAN|) then
    !this.manageMainPanels(!form.frConBranch)
    !this.pushTaskPanel(!form.frBranch, '')
    !form.bnBranchBack.active = false
  elseif (!form.cataType eq |BRTAB:REDU|) then
    !this.manageMainPanels(!form.frConReducer)
    !this.pushTaskPanel(!form.frReducer, '')
    !form.bnReducerBack.active = FALSE
  elseif (!form.cataType eq |BRTAB:PTAP|) then
    !this.manageMainPanels(!form.frConTapping)
    !this.pushTaskPanel(!form.frTapping, '')
    !form.bnTappingBack.active = false
  endif

  -- Set form title
  !this.setFormName(!form)

endmethod
-- End of method definition for .init(FORM)

------------------------------------------------------------------------
--
-- Method:      initRecentObjects
--
-- Description: Initialise method for the passed form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initRecentObjects(!form is FORM, !dbref is DBREF)

  !!catRecentObjects.add(!dbref)
  !dtext = object ARRAY()
  !rtext = object ARRAY()
  !typeDtext = !!catRecentObjects.dtext(!dbref.type)
  !typeRtext = !!catRecentObjects.rtext(!dbref.type)
  -- Remove BRTAB's with the wrong purpose
  do !ind indices !typeDtext
    skip if (!dbref.type eq |BRTAB| and !typeRtext[!ind].dbref().purpose ne !form.cataType.after(':'))
    !dtext.append(!typeDtext[!ind])
    !rtext.append(!typeRtext[!ind])
  enddo
  -- Re-populate recent CE's option list
  !form.opRecentCes.dtext = !dtext
  !form.opRecentCes.rtext = !rtext
  !form.opRecentCes.select(|RTEXT|, !dbref.string())

endmethod
-- End of method definition for .initRecentObjects(FORM)

------------------------------------------------------------------------
--
-- Method:      manageMainPanels
--
-- Description: Manage main panel visibility
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .manageMainPanels(!object is GADGET)

  -- Get owning form
  !form = !object.owner()

  -- Hide all task panes
  !form.frCompTable.visible = false
  !form.frConNomBore.visible = false
  !form.frConBranch.visible = false
  !form.frConReducer.visible = false
  !form.frConTapping.visible = false

  -- Show appropriate pane and take required action
  if (!object eq !form.frCompTable) then
    !form.frCompTable.visible = true
    if (!form.mode eq 1) then
      !form.opHeadings.visible = false
    else
      !form.opHeadings.visible = true
    endif
  elseif (!object eq !form.frConNomBore) then
    !form.frConNomBore.visible = true
    !form.opHeadings.visible = false
  elseif (!object eq !form.frConBranch) then
    !form.frConBranch.visible = true
    !form.opHeadings.visible = false
  elseif (!object eq !form.frConReducer) then
    !form.frConReducer.visible = true
    !form.opHeadings.visible = false
  elseif (!object eq !form.frConTapping) then
    !form.frConTapping.visible = true
    !form.opHeadings.visible = false
  endif

  -- Manage recent CE's list
  if (!object ne !form.frCompTable and !form.cataType eq |SPEC|) then
    !form.bnce.visible = false
    !form.opRecentCes.visible = false
  else
    !form.bnce.visible = true
    !form.opRecentCes.visible = true
  endif

endmethod
-- End of method definition for .manageMainPanels(GADGET)

------------------------------------------------------------------------
--
-- Method:      speconmode
--
-- Description: Check to see if we are stuck in speconmode or not.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .speconmode(!mode is STRING)
-- Need this method just in case we get into speconmode and then try and get in again.
-- As this will cause syntax errors and then the whole user interface fails.

-- Argument !mode will check to see if exit works.
-- If it causes error then we know we are still in speconmode and we need to exit.

if (!mode EQ 'speconmode') then

    -- Enter speconmode, if we can.
    speconmode
      handle (47,15)
        -- We must be already in speconmode, do nothing.
      endhandle

elseif (!mode EQ 'exit') then

     -- Exit from speconmode.
     exit
      handle (47,15)
        -- We must be already be out of speconmode, do nothing.
      endhandle
endif

endmethod
-- End of method definition for .speconmode(STRING)

------------------------------------------------------------------------
--
-- Method:      pushTaskPanel
--
-- Description: Push a panel onto the panel stack and make it visible
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pushTaskPanel(!panelRef is GADGET, !panelTag is STRING)
  -- Get owning form
  !form = !panelRef.owner()

  !!fmsys.setProgress(10)

  -- Hide previous panel
  !index = !form.taskPanelStack.size()
  if (!index gt 0) then
    !form.taskPanelStack[!index][1].visible = false
  endif

  !!fmsys.setProgress(20)

  -- Push new panel onto the stack and show it
  !panel[1][1] = !panelRef
  !panel[1][2] = !panelTag

  !form.taskPanelStack.appendArray(!panel)
  !this.initTaskPanel(!panelRef)
  !panelRef.visible = true

  !!fmsys.setProgress(30)

  -- Set panel name
  !fullTag = STRING()
  do !ind indices !form.taskPanelStack
    if (!ind eq 1) then
      !fullTag = !form.taskPanelStack[!ind][2]
    else
      !fullTag = !fullTag & ' -> ' & !form.taskPanelStack[!ind][2]
    endif
  enddo
  !panelRef.tag = !fullTag

  !!fmsys.setProgress(40)

  -- Set state of view mode
  if (!form.taskPanelStack.size() eq 1) then
    -- Must be main Task panel
    !form.frViewMode.active = true
  else
    -- Must be other panel
    !form.frViewMode.active = false
  endif

  !!fmsys.setProgress(0)

endmethod
-- End of method definition for .pushTaskPanel(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      popTaskPanel
--
-- Description: Pop a panel off the panel stack and restore previous panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .popTaskPanel(!form is FORM)

  if (!form.taskPanelStack.size() gt 1) then
    -- Pop current panel off the stack and hide it
    !currentPanel = !form.taskPanelStack.removeLast()
    !currentPanel[1].visible = false
    -- Show previous panel
    if (!form.taskPanelStack.size() gt 0) then
      !previousPanel = !form.taskPanelStack.last()
      !this.initTaskPanel(!previousPanel[1])
      !previousPanel[1].visible = true
    endif
  else
    return error 1 |Panel stack index out of range!|
  endif

  -- Set panel name
  !fullTag = STRING()
  do !ind indices !form.taskPanelStack
    if (!ind eq 1) then
      !fullTag = !form.taskPanelStack[!ind][2]
    else
      !fullTag = !fullTag & ' -> ' & !form.taskPanelStack[!ind][2]
    endif
  enddo
  !previousPanel[1].tag = !fullTag

  -- Set state of view mode
  if (!form.taskPanelStack.size() eq 1) then
    -- Must be main Task panel
    !form.frViewMode.active = true
  else
    -- Must be other panel
    !form.frViewMode.active = false
  endif

endmethod
-- End of method definition for .popTaskPanel(FORM)

------------------------------------------------------------------------
--
-- Method:      initTaskPanel
--
-- Description: Initialise the specified task panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initTaskPanel(!panelRef is GADGET)

  -- Get owning form
  !form = !panelRef.owner()

  -- Direct to corresponding panel initialisation method
  if (!panelRef eq !form.frSpec) then
    !this.initSpec(!form)
    !form.helpcontextid     = 'HID_CATSPEC'
  -- Piping tables
  elseif (!panelRef eq !form.frNomBore) then
    !this.initNomBore(!form)
    !form.helpcontextid     = 'HID_CATSPEC_NOMBORE'
  elseif (!panelRef eq !form.frBranch) then
    !this.initBranch(!form)
    !form.helpcontextid     = 'HID_CATSPEC_BRANCH'
  elseif (!panelRef eq !form.frReducer) then
    !this.initReducer(!form)
    !form.helpcontextid     = 'HID_CATSPEC_REDUCER'
  elseif (!panelRef eq !form.frTapping) then
    !this.initTapping(!form)
    !form.helpcontextid     = 'HID_CATSPEC_TAPPING'
  -- Spec attributes
  elseif (!panelRef eq !form.frSpecGenAtts) then
    !this.initSpecGenAtts(!form)
    !form.helpcontextid     = 'HID_CATSPEC_GEN'
  elseif (!panelRef eq !form.frSpecUpdateAtts) then
    !this.initSpecUpdateAtts(!form)
    !form.helpcontextid     = 'HID_CATSPEC_UPDATEATTS'
  elseif (!panelRef eq !form.frSpecCadAtts) then
    !this.initSpecCadAtts(!form)
    !form.helpcontextid     = 'HID_CATSPEC_CAD'
  -- Spec headings
  elseif (!panelRef eq !form.frHeadingEdit) then
    !this.initHeadingEdit(!form)
    !form.helpcontextid     = 'HID_CATSPEC_HEADING'
  -- Spec components
  elseif (!panelRef eq !form.frCompAdd) then
    !this.initCompAdd(!form)
    !form.helpcontextid     = 'HID_CATSPEC_COMPADD'
  elseif (!panelRef eq !form.frCompAddLimbo) then
    !this.initCompAddLimbo(!form)
    !form.helpcontextid     = 'HID_CATSPEC_COMPLIMBO'
  elseif (!panelRef eq !form.frCompEditAns) then
    !this.initCompEditAns(!form)
    !form.helpcontextid     = 'HID_CATSPEC_COMPEDIT'
  elseif (!panelRef eq !form.frCompEditUserAtts) then
    !this.initCompEditUserAtts(!form)
    !form.helpcontextid     = 'HID_CATSPEC_COMPUDAS'
  elseif (!panelRef eq !form.frCompEditRefs) then
    !this.initCompEditRefs(!form)
    !form.helpcontextid     = 'HID_CATSPEC_COMPEDREF'
  elseif (!panelRef eq !form.frRename) then
    !this.initRename(!form)
    !form.helpcontextid     = 'HID_CATSPEC_RENAME'
  -- Search
  elseif (!panelRef eq !form.frSearch) then
    !this.initSearch(!form)
    !form.helpcontextid     = 'HID_CATSPEC_SEARCH'
  -- Reference list
  elseif (!panelRef eq !form.frRefList) then
    !this.initRefList(!form)
    !form.helpcontextid     = 'HID_CATSPEC_REFLIST'
  endif

endmethod
-- End of method definition for .initTaskPanel(GADGET)

------------------------------------------------------------------------
--
-- Method:      selectHeadings
--
-- Description: Populate standard headings from user defined file.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectHeadings(!gadget is GADGET, !action is STRING)
------------------------------------------------------------------------

if (!action EQ 'UNSELECT') then
    return
endif

!form              = !gadget.owner()
!form.isHeadingStd = TRUE

-- Load the list gadget with all the choices we have from the given list.
!list = ARRAY()

if (!gadget EQ !form.bnSpecHeadList) then
!form.bnStdHeadingDelete.active = FALSE
!form.currentHeading            = !form.bnSpecHeadList.dtext[!form.bnSpecHeadList.val]

  do !x index !form.headingQuest[!form.bnSpecHeadList.selection().real()]

   do !y index !form.headingQuest[!form.bnSpecHeadList.selection().real()][!x]
      if (undefined(!list[!x])) then
          !list[!x] = ARRAY()
      endif
          !thirdArg = !form.headingQuest[!form.bnSpecHeadList.selection().real()][!x][3]
          skip if (!y EQ 3)

          !arg = !form.headingQuest[!form.bnSpecHeadList.selection().real()][!x][!y]
          if (!y EQ 2 AND !thirdArg NE '-1') then
              !list[!x].append(!arg & !thirdArg)
          else
              if (!arg EQ '') then
                  !arg = '0'
              endif
              !list[!x].append(!arg.trim())
          endif
   enddo

  enddo

elseif (!gadget EQ !form.bnStdHeadList) then
!form.bnStdHeadingDelete.active = TRUE
!form.currentHeading            = !form.bnStdHeadList.dtext[!form.bnStdHeadList.val]

      -- Cycle round the standard questions we have available.
      do !entry value !form.stdHeadingQuest[!form.bnStdHeadList.selection().real()]

        -- Deal with each heading in turn.
        do !y index !entry
          skip if (!y EQ 3)
           if (undefined(!list[!entry[1].real()])) then
               !list[!entry[1].real()] = ARRAY()
               !num = !entry[1].real()
           endif

              !thirdArg = !entry[3]
          if (!y EQ 2 AND !thirdArg NE '-1') then
              !list[!num].append(!entry[!y] & !thirdArg)
          else
              if (!entry[!y] EQ '') then
                  !entry[!y] = '0'
              endif
              !list[!num].append(!entry[!y].trim())
          endif
        enddo
      enddo

endif

-- Finally set the rows in the list gadget to that we have made.
!form.bnSpecHeadings.setrows(!list)

endmethod
-- End of method definition for .selectHeadings(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      loadHeadings
--
-- Description: Populate standard headings from user defined file.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadHeadings(!form is FORM)
------------------------------------------------------------------------

-- Load standard headings from operating system file.
   !readStandards = !form.headingsFile.readfile()
   handle (160,9)
     -- File doesn't exist.
     !readStandards = ARRAY()
   endhandle

-- Clear all existing arrays first
   !form.stdHeadingDTypes.clear()
   !form.stdHeadingRTypes.clear()
   !form.stdHeadingQuest.clear()
   !headingSet = FALSE

-- Cycle round the standard headings file and gather all the headings for the list gadget.
do !line value !readStandards

   -- Skip comment lines.
   skip if (!line.substring(1,1) EQ '-')

   -- This will be encountered when the end of the heading is reached.
   if (!headingSet AND !line EQ '') then
       -- Move the details to the next category.
          !headingSet = FALSE

       -- Reset Entry Counter
          !entry = 0
       skip
   endif

   -- Used to reset the heading flag and move to next HEADING or capture details.
   if (!headingSet) then
       if (!line.substring(1,4).upcase() EQ 'HEAD') then
           !headingSet = FALSE
       else

           -- Increment entry counter for the next heading.
              !entry = !entry + 1

           -- Now add the details for this heading.
           if (undefined(!form.stdHeadingQuest[!currentNumber])) then
                         !form.stdHeadingQuest[!currentNumber] = ARRAY()
           endif
              do !y index !line.split(',')
                  if (undefined(!form.stdHeadingQuest[!currentNumber][!entry])) then
                                !form.stdHeadingQuest[!currentNumber][!entry] = ARRAY()
               endif
                        !stringDefault = !line.split(',')[!y].trim().upcase().replace('NONE','-').replace('EQUA','=')
                        !form.stdHeadingQuest[!currentNumber][!entry].append(!stringDefault)
              enddo
       endif
   endif

   -- Output the current HEADING onto gadget list.
   if (!headingSet.not()) then
       -- Check for the start of the heading.
       if (!line.substring(1,4).upcase() EQ 'HEAD') then
           -- Found a heading, start the process of collecting information.
              !type = !line.split('=')[2].trim()
              !form.stdHeadingDTypes.append(!type)
              !form.stdHeadingRTypes.append(!form.stdHeadingDTypes.size().string('d0'))
              !currentNumber = !form.stdHeadingDTypes.size()

           -- Set Entry Counter
              !entry = 0
              !headingSet = TRUE
              skip
       endif
   endif

enddo

-- Organise the lists and populate the lists.
   !sort = !form.stdHeadingDTypes.sortedIndices()
   !form.bnStdHeadList.dtext = !form.stdHeadingDTypes.reindex(!sort)
   !form.bnStdHeadList.rtext = !form.stdHeadingRTypes.reindex(!sort)

-- Clear all existing arrays first
   !form.headingDTypes.clear()
   !form.headingRTypes.clear()
   !form.headingQuest.clear()

-- Cycle round the current specification we have loaded and find all the headings, because
-- we might want to use one again, if we add to the spec.

do !x from 1 to !form.specification.headingCount(true)
   !headings = object SPECHEADING(!form.specification,!x)
    skip if (!headings.componentCount() LT 1)

   do !y from 1 to !headings.questionsCount()

      if (!y EQ 1) then
          !comps = object SPECCOMPONENT(!headings,1)
          !type = !comps.stringAnswer(1)
          !form.headingDTypes.append(!type)
          !form.headingRTypes.append(!form.headingDTypes.size().string('d0'))
      endif

          if (undefined(!form.headingQuest[!x])) then
              !form.headingQuest[!x] = ARRAY()
          endif
          if (undefined(!form.headingQuest[!x][!y])) then
               !form.headingQuest[!x][!y] = ARRAY()
          endif
          !form.headingQuest[!x][!y].append(|$!y|)
          !form.headingQuest[!x][!y].append(!headings.question(!y))
          !form.headingQuest[!x][!y].append(!headings.qualifier(!y))
          !stringDefault = !headings.stringDefault(!y).upcase().replace('NONE','-').replace('EQUA','=')
          !form.headingQuest[!x][!y].append(!stringDefault)
   enddo

enddo

-- Organise the lists and populate the lists.
          !sort = !form.headingDTypes.sortedIndices()
          !form.bnSpecHeadList.dtext = !form.headingDTypes.reindex(!sort)
          !form.bnSpecHeadList.rtext = !form.headingRTypes.reindex(!sort)

          !heading    = ARRAY()
          !heading[1] = |NO|
          !heading[2] = |QUESTION|
          !heading[3] = |DEFAULT|
          !form.bnSpecHeadings.setHeadings(!heading)

endmethod
-- End of method definition for .loadHeadings(FORM)

------------------------------------------------------------------------
--
-- Method:      initCompTable
--
-- Description: Populate form table from specification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initCompTable(!form is FORM)

  -- Set view mode (1 = Standard view, 2 = CAD view)
  !form.mode = 2
  !form.frViewMode.val = 2

  -- Set heading option list and current headings
  !this.initOpHeadings(!form)

  -- Erase current data to clear headings and then initialise the table
  !form.netCompTable.clearGrid()
  !this.actionCompTable(!form.opHeadings, |SELECT|)

endmethod
-- End of method definition for .initCompTable(FORM)

------------------------------------------------------------------------
--
-- Method:      initOpHeadings
--
-- Description: Initialise headings option list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initOpHeadings(!form is FORM)

  -- Standard view
  if (!form.mode eq 1) then

    -- Hide Headings option list
    !form.opHeadings.visible = false

    -- Unset current spec heading
    !form.currentHdg = object SPECHEADING()

  -- CAD view
  elseif (!form.mode eq 2) then

    -- Show Headings option list
    !form.opHeadings.visible = true

    -- Get heading count from spec
    !headingCount = !form.specification.headingCount(true)

    -- Initialise headings option list
    !opHeadingsD = ARRAY()
    !opHeadingsR = ARRAY()
    if (!headingCount gt 0) then
      do !hCnt from 1 to !headingCount
        !heading = object SPECHEADING(!form.specification, !hCnt)
        -- Check for empty headings
        if (!heading.componentCount() eq 0) then
          !dtext = 'Empty'
        else
        -- Get TYPE or BTYP answer
        !component = object SPECCOMPONENT(!heading, 1)
          !dtext = !component.stringAnswer(1)
        endif
        -- Set heading list
        !opHeadingsD.append(!dtext)
        !opHeadingsR.append(!hCnt.string())
      enddo
      -- Add count to end of duplicate heading types
      !testHeadings = !opHeadingsD
      do !valHdg values !testHeadings
        !dupTypeInds = !opHeadingsD.find(!valHdg)
        if (!dupTypeInds.size() gt 1) then
          do !indDup indices !dupTypeInds
            !hIndex = !dupTypeInds[!indDup]
            !opHeadingsD[!hIndex] = !opHeadingsD[!hIndex] & ' [' & !indDup & ']'
          enddo
        endif
      enddo
    else
      !opHeadingsD[1] = 'None'
      !opHeadingsR[1] = '0'
    endif

    -- Sort headings and set option list
    !sortOrder = !opHeadingsD.sortedIndices()
    !opHeadingsD.reindex(!sortOrder)
    !opHeadingsR.reindex(!sortOrder)
    !form.opHeadings.dtext = !opHeadingsD
    !form.opHeadings.rtext = !opHeadingsR

    -- Set current heading
    if (!headingCount gt 0) then
      !headingIndex = !form.opHeadings.rtext[!form.opHeadings.val].real()
      !form.currentHdg = object SPECHEADING(!form.specification, !headingIndex)
    else
      !form.currentHdg = object SPECHEADING()
    endif

  endif

endmethod
-- End of method definition for .initOpHeadings(FORM)

------------------------------------------------------------------------
--
-- Method:      populateTable
--
-- Description: Populate form table from specification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .populateTable(!form is FORM)

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  -- Get spec heading row for current heading and mode
  !specHdg = !this.getSpecHdgs(!form)

  -- Get spec item details for the table rows
  !specRowSet = !this.getSpecRows(!form)

  -- If there are no items in the spec then a dummy row is needed to show the headings
  if (!specRowSet.unset() or !specRowSet.empty()) then
    do !ind indices !specHdg
      !specRowSet[1][!ind] = !form.emptyString
    enddo
  endif

  -- Total indicator
  !specTi = 'Specification'

  -- Bind to data source
  !ndsTable = object NETDATASOURCE(!specTi, !specHdg, !specRowSet, FALSE)
  !form.netCompTable.bindToDataSource(!ndsTable)

  -- Select first row in the list
  !form.netCompTable.selectRow(0)

endmethod
-- End of method definition for .populateTable(FORM)

------------------------------------------------------------------------
--
-- Method:      getSpecHdgs
--
-- Description:  Compile spec heading row for current heading and mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getSpecHdgs(!form is FORM) is ARRAY

  -- initialise heading array
  !attHdgs = ARRAY()

  -- Standard mode
  if (!form.mode eq 1) then
    !attHdgs[1] = 'Item'
    !attHdgs[2] = 'Size Range'
    !attHdgs.appendArray(!form.stdRefsD)

  -- CAD mode
  elseif (!form.mode eq 2) then
    -- Get heading details
    !attHdgs.append(|Name|)
    if (!form.currentQues.size() gt 0) then
      do !cnt from 1 to !form.currentQues.size()
        if (!form.currentQuals[!cnt].unset()) then
          !attHdgs.append(!form.currentQues[!cnt])
        else
          !attHdgs.append(!form.currentQues[!cnt] & !form.currentQuals[!cnt])
        endif
      enddo
      !attHdgs.appendArray(!form.cadRefsD)
    else
      !attHdgs[1] = 'None'
    endif

  endif

  return !attHdgs

endmethod
-- End of method definition for .getSpecHdgs(FORM) ARRAY

------------------------------------------------------------------------
--
-- Method:      getSpecRows
--
-- Description:  Compile spec information into rows for Standard or CAD view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getSpecRows(!form is FORM) is ARRAY

  -- Initialise row array
  !tmpRows  = ARRAY()
  !rows     = ARRAY()
  !sortKeys = ARRAY()

  -- Set form units in case they have been changed on the command line
  !this.setFormUnits(!form)

  -- Clear spec information
  !form.components.clear()

  -- Compile spec information
  -- Standard mode
  if (!form.mode eq 1) then

    -- Process components for each heading
    do !hCnt from 1 to !form.specification.headingCount(true)
      !heading = object SPECHEADING(!form.specification, !hCnt)
      -- Get component details

      do !cCnt from 1 to !heading.componentCount()
        !component = object SPECCOMPONENT(!heading, !cCnt)
        !tmpRow = object ARRAY()

        -- Component type
        !compType = !this.getCompAnswer(!form, |TYPE|, !heading, !cCnt)
        !tmpRow.append(!compType)

        -- P1 bore
        !catref = !component.getRef('CATREF')
        if (!catref.unset()) then
          !p1bore = !form.unsetAttStr
        elseif (!catref.badref()) then
          !p1bore = !form.badRefStr
        else
          if (!compType ne |BOLT|) then
            !p1bore = !catref.ppbore[1].string(!form.boreFormat)
            handle (2,779)
               !p1bore = '0'
            endhandle
          else
            !boltRef = !component.getRef('BLTREF')
            if (!boltRef.badref()) then
              !p1bore = '0'
            else
              !p1bore = !boltRef.bdiameter
              handle (2,230)
                !p1bore = 'Protected'
              endhandle
            endif
          endif
        endif
        !tmpRow.append(!p1bore)

        -- References
        do !val values !form.stdRefsR
          if (!val eq |DETAIL|) then
            !detailTxt = !this.getRefStr(!form, !component, !val, !form.detTxtAtt)
            !tmpRow.append(!detailTxt)
          elseif (!val eq |MATXT|) then
            !materialTxt = !this.getRefStr(!form, !component, !val, !form.matTxtAtt)
            !tmpRow.append(!materialTxt)
          else
            !tmpRow.append(!this.getRefStr(!form, !component, !val))
          endif
        enddo

        !fullDesc = !detailTxt & ' ' & !materialTxt

        -- Append row
        !tmpRows.append(!tmpRow)
        -- Append sort key for row
        !sortKeys.append(!fullDesc)
      enddo
    enddo

    -- Return if spec has no items in it
    if (!tmpRows.empty()) then
      return !rows
    endif

    -- Sort components by sort key
    !sortIndices = !sortKeys.sortedIndices()
    !sortKeys.reindex(!sortIndices)
    !tmpRows.reindex(!sortIndices)

    -- Find first and last index for each component size in each range
    -- First in group
    !firstInGroup = ARRAY()
    !figCompare = !sortKeys
    !figCompare.insert(1,|*~#|)
    !figCompare.removeLast()
    do !cnt from 1 to !sortKeys.size()
      if (!sortKeys[!cnt] ne !figCompare[!cnt]) then
        !firstInGroup.append(!cnt)
      endif
    enddo

    -- Last in group
    !lastInGroup = ARRAY()
    !ligCompare = !sortKeys
    !ligCompare.removeFirst()
    !ligCompare.append(|*~#|)
    do !cnt from 1 to !sortKeys.size()
      if (!sortKeys[!cnt] ne !ligCompare[!cnt]) then
        !lastInGroup.append(!cnt)
      endif
    enddo

    -- Compile commodities (size ranges)
    !boreIndex = 2
    do !cnt from 1 to !firstInGroup.size()
      !range = ARRAY()
      do !rowIndex from !firstInGroup[!cnt] to !lastInGroup[!cnt]
        !bore = !tmpRows[!rowIndex][!boreIndex].real()
         handle (2, 441) $* Calculator error
          -- String could not be converted to a real, typically because the entry is a bolt, so just use the string
          -- and assume that the range is determined purely by the entries at the start and end of the group
          !range.append(!tmpRows[!rowIndex][!boreIndex])
          !range.append(!tmpRows[!lastInGroup[!cnt]][!boreIndex])
          break
        endhandle

        if (!bore.unset()) then
          -- If the bore is unset then force it to zero, otherwise sorting the range will fail
          !bore = 0
        endif
        !range.append(!bore)

      enddo

      -- Only sort the range if it contains real numbers
      if (!range[1].objectType() eq 'REAL') then
        !range.sort()
      endif

      !sizeRange = !range.first().string() & ' - ' & !range.last().string()
      !commodityRow = !tmpRows[!firstInGroup[!cnt]]
      !commodityRow[2] = !sizeRange
      !rows.append(!commodityRow)
    enddo

  -- CAD mode
  elseif (!form.mode eq 2) then

   !useExactBore = !this.useExactBore(!form)
    do !cCnt from 1 to !form.currentHdg.componentCount()
      -- save component

      !form.components.append(object SPECCOMPONENT(!form.currentHdg, !cCnt))
      -- Compile row
      !row = object ARRAY()
      -- Get name
      !row.append(!form.components[!cCnt].name())
      -- Get answers
      !compAnswers = object ARRAY()

      do !qCnt from 1 to !form.currentHdg.questionsCount()
        !question = !form.currentHdg.question(!qCnt)
        !compAnswers.append(!this.getComponentAnswers(!form, !question, !form.components[!cCnt], !qCnt, !useExactBore))
      enddo

      !row.appendArray(!compAnswers)
      do !val values !form.cadRefsR
        if (!val eq |DETAIL|) then
          !row.append(!this.getRefStr(!form, !form.components[!cCnt], !val, !form.detTxtAtt))
        elseif (!val eq |MATXT|) then
          !row.append(!this.getRefStr(!form, !form.components[!cCnt], !val, !form.matTxtAtt))
        else
          !row.append(!this.getRefStr(!form, !form.components[!cCnt], !val))
        endif
      enddo
      !rows.append(!row)
    enddo
  endif
  return !rows

endmethod
-- End of method definition for .getSpecRows(FORM) ARRAY


------------------------------------------------------------------------
--
-- Method:      getCompAnswer
--
-- Description: Get answer to supplied question for specification component
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]     [Description]
--    1   R      FORM            Spec view form
--    2   R      STRING          Question to be answered
--    3   R      SPECHEADING     Specification heading object
--    4   R      REAL            Heading component index
--
-- Return:
--   [Data Type] [Description]
--    STRING      Answer as STRING data type
--
------------------------------------------------------------------------
define method .getCompAnswer(!form is FORM, !question is STRING, !heading is SPECHEADING, !compIndex is REAL) is STRING

  -- Get component from heading
  !component = object SPECCOMPONENT(!heading, !compIndex)
  !answer = STRING()

  -- Find TYPE question and answer
  !questionsCount = !heading.questionsCount()
  if (!questionsCount gt 0) then
    -- Get question index
    do !qCnt from 1 to !questionsCount
      -- **** Add extra bit for qualifier here!!!! ****
      --!fullQuestion = !heading.question(!qCnt) & !heading.qualifier(!qCnt)
      !fullQuestion = !heading.question(!qCnt)
      if (!fullQuestion eq !question) then
        -- Get the answer
        !answer = !this.getComponentAnswers(!form, !question, !component, !qCnt, FALSE)
      endif
    enddo
  endif

  return !answer

endmethod
-- End of method definition for .getCompAnswer(FORM, STRING, SPECHEADING, REAL)STRING

------------------------------------------------------------------------
--
-- Method:      getCompAnswer
--
-- Description: Get answer to supplied question index for specification component
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]     [Description]
--    1   R      FORM            Spec view form
--    2   R      SPECCOMPONENT   Specification component object
--    3   R      REAL            Answer index
--
-- Return:
--   [Data Type] [Description]
--    STRING      Answer as STRING data type
--
------------------------------------------------------------------------
define method .getComponentAnswers(!form is FORM, !question is STRING, !component is SPECCOMPONENT, !answerIndex is REAL, !useExactBore is BOOLEAN) is STRING

  -- Get data type of answer
  !answerType = !component.answerType(!answerIndex)

  -- Get answer as STRING data type
  if (!answerType eq |STRING|) then
    !answer = !component.stringAnswer(!answerIndex)
  elseif (!answerType eq |REAL|) then
    !realAnswer = !component.realAnswer(!answerIndex)
    if (!question EQ |PBOR|) then

      !answer = !this.formatRealAsNominalBore(!form, !realAnswer, !useExactBore)

    else
      !answer = !realAnswer.string('D6')
      !this.stripTrailingZeroes(!answer)
    endif

  elseif (!answerType eq |RANGE|) then
    -- ***** Need to add FORMAt here for bore or real values????? ****
    !rangeAnswers = !component.rangeAnswer(!answerIndex)
    !answer = !rangeAnswers[1].string() & | , | & !rangeAnswers[2].string()
  endif
  return !answer

endmethod
-- End of method definition for .getComponentAnswers(FORM, SPECCOMPONENT, REAL)STRING

------------------------------------------------------------------------
--
-- Method:      getRefStr
--
-- Description: Get ref name or ref attribute value for specification component
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]     [Description]
--    1   R      FORM            Spec view form
--    2   R      ANY             CatSpecification or SpecComponent object
--    3   R      STRING          Name of reference
--    4   R      STRING          Name of reference attribute
--
-- Return:
--   [Data Type] [Description]
--    STRING      Reference name or reference attribute value
--
------------------------------------------------------------------------
define method .getRefStr(!form is FORM, !object is ANY, !refName is STRING, !attribName is STRING) is STRING

  if (!object.objectType() eq |CATSPECIFICATION|) then
    !dbref = !object.dbref(!refName)
  elseif (!object.objectType() eq |SPECCOMPONENT|) then
    !dbref = !object.getRef(!refName)
  endif
  if (!dbref.unset()) then
    !refString = !form.unsetRefStr
  else
    if (!dbref.badref().not()) then
      if (!attribName.set()) then
        !refString = !dbref.attribute(!attribName.upcase())
      else
        !refString = !dbref.namn
      endif
    else
      !refString = !form.badRefStr
    endif
  endif

  return !refString

endmethod
-- End of method definition for .getRefStr(FORM, ANY, STRING, STRING)STRING

------------------------------------------------------------------------
--
-- Method:      getRefStr
--
-- Description: Get reference name for specification component
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]     [Description]
--    1   R      FORM            Spec view form
--    2   R      ANY             CatSpecification or SpecComponent object
--    3   R      STRING          Name of reference attribute
--
-- Return:
--   [Data Type] [Description]
--    STRING      Reference name
--
------------------------------------------------------------------------
define method .getRefStr(!form is FORM, !object is ANY, !refName is STRING) is STRING

  !attribName = object STRING()
  !refString = !this.getRefStr(!form, !object, !refName, !attribName)
  return !refString

endmethod
-- End of method definition for .getRefStr(FORM, ANY, STRING)STRING

------------------------------------------------------------------------
--
-- Method:      setRefStr
--
-- Description: Set ref name or ref attribute value for specification component
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]     [Description]
--    1   R      FORM            Spec view form
--    2   R      ANY             Object who's reference is being set
--    3   R      STRING          Name of reference attribute
--    4   R      STRING          Name of db element to set it to
--
-- Return:
--   [Data Type] [Description]
--    dbref       DB element that was set
--
------------------------------------------------------------------------
define method .setRefStr(!form is FORM, !specOrComp is ANY, !refAttName is STRING, !element is ANY) is DBREF

  if (!element.objectType() eq 'DBREF') then
    !dbref = !element.attribute(!refAttName)
  else

    -- Don't set refs for the 'multiple values' string
    if (!element eq !form.varyStr) then
      return
    endif

    -- name format
    !name = !element
    if (not !name.substring(1,1) inset(|/|, |=|)) then
      !name = '/' & !name
    endif

    -- Get the db element to set the reference attribute to
    if (!name.empty() or !name eq !form.unsetRefStr or !name eq !form.badRefStr) then
      !dbref = object DBREF()
    else
      !dbref = !name.dbref()
      handle any
        !dbref = object DBREF()
      endhandle
    endif
  endif


  -- Set the reference
  if (!specOrComp.objectType() eq |CATSPECIFICATION| and !dbref.badref()) then
          !specOrComp.cleardbref(!refAttName)

  elseif (!specOrComp.objectType() eq |CATSPECIFICATION| and !dbref.badref().not()) then
          !specOrComp.setdbref(!refAttName, !dbref)

  elseif (!specOrComp.objectType() eq |SPECCOMPONENT| and !dbref.badref()) then
          !specOrComp.clearRef(!refAttName)

  elseif (!specOrComp.objectType() eq |SPECCOMPONENT| and !dbref.badref().not()) then
          !specOrComp.setRef(!refAttName, !dbref)

  endif

  return !dbref

endmethod
-- End of method definition for .setRefStr(FORM, ANY, STRING, STRING)dbref

------------------------------------------------------------------------
--
-- Method:      actionCompTable
--
-- Description: Gadget actions for component table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionCompTable(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  -- Select heading index
  if (!object eq !form.opHeadings and !action eq |SELECT|) then

    if (!form.mode eq 1) then
      --*****---------*********

    elseif (!form.mode eq 2) then
      -- Clear arrays by reassigning - clear() method cannot be used as it fails if element 0 exists
      !form.currentQues = ARRAY()
      !form.currentQuals = ARRAY()
      !form.currentDflts = ARRAY()
      -- Set current heading
      if (!form.opHeadings.selection().real() gt 0) then
        -- Save current heading

        !form.currentHdg = object SPECHEADING(!form.specification, !form.opHeadings.selection().real())
        handle (17,59)
            -- Error here is "The index passed exceeds the number of positions available", need to reinstate the spec
            -- with the form, so they at least match up.
            -- Make sure we are at the right specification.
            !!ce = !form.specification.name().dbref()

            -- Now re-instate the specification.
            !!catSpecViews.init(!form, false)
        endhandle
        -- Save current questions, qualifiers, & defaults
        !this.updateQQDMems(!form)
      else
        -- No headings in spec
        !form.currentHdg = object SPECHEADING()
        -- Clear questions, qualifiers, & defaults
        !this.updateQQDMems(!form)
      endif
    endif
    -- Populate table
    !this.populateTable(!form)
    -- Initialise the shown task panel if required
    if (!form.frSpec.visible) then
      !this.initSpec(!form)
    elseif (!form.frHeadingEdit.visible) then
      !form.isInitHeadingEdit = true
      !this.initHeadingEdit(!form)
    elseif (!form.frCompAdd.visible) then
      !form.isInitCompAdd = true
      !this.initCompAdd(!form)
    elseif (!form.frCompAddLimbo.visible) then
      !form.isInitCompAddLimbo = true
      !this.initCompAddLimbo(!form)
    elseif (!form.frCompEditAns.visible) then
      !this.initCompEditAns(!form)
    elseif (!form.frCompEditRefs.visible) then
      !form.isInitCompEditRefs = true
      !this.initCompEditRefs(!form)
    elseif (!form.frCompEditUserAtts.visible) then
      !form.isInitCompEditUserAtts = true
      !this.initCompEditUserAtts(!form)
    endif

  -- View mode
  elseif (!object eq !form.frViewMode and !action eq |SELECT|) then

    !form.opHeadings.val = 1

    !this.initSpec(!form)

    -- Set heading option list and current headings
    !this.initOpHeadings(!form)
    -- Populate table
    !this.populateTable(!form)
    -- Set form name
    !this.setFormName(!form)

  -- Select all
  elseif (!object eq !form.bnRowSelAll and !action eq |SELECT|) then
    -- Make array of all row indices
    !rows = ARRAY()
    do !cnt from 1 to !form.netCompTable.getNumberRows()
      !rows.append(!cnt)
    enddo
    -- Select rows
    !this.netSelectRows(!form, !rows)

  -- Clear selection
  elseif (!object eq !form.bnRowSelNone and !action eq |SELECT|) then
    !this.netSelectRows(!form, object ARRAY())

  endif

endmethod
-- End of method definition for .actionCompTable()

------------------------------------------------------------------------
--
-- Method:      updateQQDMems
--
-- Description: Update forms currentQues, currentQuals, & currentDflts
--              members inline with current heading
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateQQDMems(!form is FORM)

  !form.currentQues.clear()
  !form.currentQuals.clear()
  !form.currentDflts.clear()

  do !cnt from 1 to !form.currentHdg.questionsCount()

    !form.currentQues[!cnt] = !form.currentHdg.question(!cnt)
    !tmpQualifier           = !form.currentHdg.qualifier(!cnt)

    -- **** Temporary fix for TYPE question getting the same qualifier as the first PBOR question
    if (!tmpQualifier ne '-1' and !form.currentQues[!cnt] ne |TYPE|) then
      !form.currentQuals[!cnt] = !tmpQualifier
    else
      !form.currentQuals[!cnt] = object STRING()
    endif
    !form.currentDflts[!cnt] = !this.getHdgDefault(!form, !cnt)
    handle any
    endhandle
  enddo

endmethod
-- End of method definition for .updateQQDMems(FORM)

------------------------------------------------------------------------
--
-- Method:      initSpec
--
-- Description: Initialise specification task panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSpec(!form is FORM)

 if (!form.frViewMode.val eq 1) then
      -- In ENG mode
     !form.mode = 1

     !form.bnSpecGenAtts.active      = false
     !form .bnSpecCadAtts.active     = false
     !form .bnSpecUpdateAtts.active  = false
     !form.bnSpecRename.active       = false
     !form.paSpecList.active         = false
     !form.bnSpecNomBore.active      = false
     !form.bnSpecBranch.active       = false
     !form.bnSpecReducer.active      = false
     !form.bnSpecTapping.active      = false
     !form.paSpecTypes.active        = false
     !form.bnSpecAddHdg.active       = false
     !form.bnSpecHdgAtts.active      = false
     !form.bnSpecDelHdg.active       = false
     !form.paSpecComps.active        = false
     !form.bnSpecAddComps.active     = false
     !form.bnSpecAddLimbo.active     = false
     !form.bnSpecEditCompAns.active  = false
     !form.bnSpecEditCompRefs.active = false
     !form.bnSpecEditUserAtts.active = false
     !form.bnSpecCompRename.active   = false
     !form.bnSpecRemComps.active     = false
     !form.bnSpecDelComps.active     = false
     !form.paSpecAtts.active         = false

     --  Change the tag for excel export.
     !form.bnSpecExport.tag = 'Export to Excel...'

 -- In CAD mode.
 elseif (!form.frViewMode.val eq 2) then
     !form.mode = 2

     !form.paSpecAtts.active       = true
     !form.bnSpecGenAtts.active    = true
     !form.bnSpecCadAtts.active    = true
     !form.bnSpecUpdateAtts.active = !form.updateList.set()
     !form.bnSpecRename.active     = !form.isSpecUpdateable
     !form.paSpecList.active       = true

      -- Set active state for Table link labels
     if (!form.nomBoreTab.badref()) then
       !form.bnSpecNomBore.active = false
     else
       !form.bnSpecNomBore.active = true
     endif
     if (!form.branchTab.badref()) then
       !form.bnSpecBranch.active  = false
     else
       !form.bnSpecBranch.active  = true
     endif
     if (!form.reducerTab.badref()) then
       !form.bnSpecReducer.active = false
     else
       !form.bnSpecReducer.active = true
     endif
     if (!form.tappingTab.badref()) then
       !form.bnSpecTapping.active = false
     else
       !form.bnSpecTapping.active = true
     endif

     !form.paSpecTypes.active    = true
     !form.bnSpecAddHdg.active   =!form.isSpecUpdateable

     -- Set active state for Heading link labels
     --<TM 30/11/2007 08:02> fix for sending dodgy headings to the specheading object
     if !form.opHeadings.dtext[1].eq('None') then
       !form.bnSpecHdgAtts.active  = false
       !form.bnSpecDelHdg.active   = false
     elseif (!form.currentHdg.componentCount() gt 0) then
       !form.bnSpecHdgAtts.active  = !form.isSpecUpdateable
       !form.bnSpecDelHdg.active   = false
     else
       !form.bnSpecHdgAtts.active  = !form.isSpecUpdateable
       !form.bnSpecDelHdg.active   = true
     endif

     !form.paSpecComps.active    = true

     -- Set active state for Items link labels
     if (!form.opHeadings.dtext[1].eq('None')) then
       !form.bnSpecAddComps.active     = false
       !form.bnSpecAddLimbo.active     = false
       !form.bnSpecEditCompAns.active  = false
       !form.bnSpecEditCompRefs.active = false
       !form.bnSpecEditUserAtts.active = false
       !form.bnSpecCompRename.active   = false
       !form.bnSpecRemComps.active     = false
       !form.bnSpecDelComps.active     = false
     else
       !form.bnSpecAddComps.active     = !form.isSpecUpdateable
       !form.bnSpecAddLimbo.active     = !form.isSpecUpdateable
       if (!form.selectedRows.size() eq 0) then
         !form.bnSpecEditCompAns.active  = false
         !form.bnSpecEditCompRefs.active = false
         !form.bnSpecEditUserAtts.active = false
         !form.bnSpecCompRename.active   = false
         !form.bnSpecRemComps.active     = false
         !form.bnSpecDelComps.active     = false
       else
         !allowEdit = (!form.currentHdg.componentCount() gt 0) and !form.isSpecUpdateable
         !form.bnSpecEditCompAns.active  = !allowEdit
         !form.bnSpecEditCompRefs.active = !allowEdit
         !form.bnSpecEditUserAtts.active = !allowEdit
         !form.bnSpecCompRename.active   = !allowEdit
         !form.bnSpecRemComps.active     = !allowEdit
         !form.bnSpecDelComps.active     = !allowEdit
       endif
     endif

 !form.bnSpecExport.tag = 'Export...'
 endif

endmethod
-- End of method definition for .initSpec(FORM)

------------------------------------------------------------------------
--
-- Method:      actionSpec
--
-- Description: Gadget actions for specification task panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionSpec(!object is GADGET, !action is STRING)

  if (!action eq |SELECT|) then
    using namespace 'Aveva.Pdms.Presentation'

    -- Get owning form
    !form = !object.owner()

    -- Management
    -- Spec attributes
    if (!object eq !form.bnSpecGenAtts) then
      !this.pushTaskPanel(!form.frSpecGenAtts, |General Attributes|)
    elseif (!object eq !form.bnSpecCadAtts) then
      !this.pushTaskPanel(!form.frSpecCadAtts, |Cad Attributes|)
    elseif (!object eq !form.bnSpecUpdateAtts) then
      !form.updateList = !form.specification.checkSpcoReferences()
      !this.pushTaskPanel(!form.frSpecUpdateAtts, |Update Spec Component Attributes From Part Attributes|)
    elseif (!object eq !form.bnSpecRename) then
      !form.renameCallGadget = !form.bnSpecRename
      !this.netSelectRows(!form, object ARRAY())
      !this.pushTaskPanel(!form.frRename, |Rename Specification|)
    elseif (!object eq !form.bnSpecExport) then
      !fileBrowser = object PMLFILEBROWSER('SAVE')
      !specName = !form.specification.name()

      -- If in CAD mode write the SPEC to .txt file.
      if(!form.mode eq 2) then
        !fileSeedName = !specName.after('/').replace('/','-') & |-SPEC.txt|
        !fileBrowser.show(|%PDMSUSER%|, !fileSeedName, |Export to Specon Output file|, false, 'txt files (*.txt)|*.txt', 1)
        !fileName = !fileBrowser.file()
        if (!fileName.empty()) then
          return
        endif
        !fileName = '"' & !fileName & '"'
        !this.speconmode('speconmode')
           file $!<fileName> over wi 120 char
           out new $!<specName>
           term
        !this.speconmode('exit')

      -- If in Eng mode, save to EXCEL file WYSIWYG.
      elseif(!form.mode eq 1) then

        !fileSeedName = !specName.after('/').replace('/','-') & |-EXCEL.xls|
        !fileBrowser.show(|%PDMSUSER%|, !fileSeedName, |Export to Excel Output file|, false, 'xls files (*.xls)|*.xls', 1)
        !fileName = !fileBrowser.file()
        if (!fileName.empty()) then
          return
        endif

        !form.netCompTable.saveGridToExcel(!fileName)

    endif

    -- Piping Tables
    elseif (!object eq !form.bnSpecNomBore) then
      !this.pushTaskPanel(!form.frNomBore, |Size Range|)
      !this.manageMainPanels(!form.frConNomBore)
    elseif (!object eq !form.bnSpecBranch) then
      !this.pushTaskPanel(!form.frBranch, |Branch Table|)
      !this.manageMainPanels(!form.frConBranch)
    elseif (!object eq !form.bnSpecReducer) then
      !this.pushTaskPanel(!form.frReducer, |Reducer Table|)
      !this.manageMainPanels(!form.frConReducer)
    elseif (!object eq !form.bnSpecTapping) then
      !this.pushTaskPanel(!form.frTapping, |Tapping Table|)
      !this.manageMainPanels(!form.frConTapping)

    -- Headings
    elseif (!object eq !form.bnSpecAddHdg) then

      -- Check that no other empty headings exist
      if (!form.opHeadings.dtext.findFirst(|Empty|).set()) then
        !!alert.warning(|Spec already has an empty heading!|)
        return
      endif

      -- Create new spec heading
      !newHeading = object SPECHEADING()
  --    if (!form.specification.disciplineText().substring(1,4) eq |BOLT|) then
  --      !newHeading.setQuestion(|BTYP|, 0, true)
  --    else
        !newHeading.setQuestion(|TYPE|, 0, true)
  --    endif
      !okFlag = !form.specification.addHeading(!newHeading, 0, true)
      if (!okFlag) then
        -- Update headings option list
        !this.initOpHeadings(!form)
        -- Select new heading
        !newHdgIndex = !form.specification.headingCount(true)
        !form.opHeadings.select(|RTEXT|, !newHdgIndex.string())
        !this.actionCompTable(!form.opHeadings, |SELECT|)
        -- Show heading edit panel
        !form.isInitHeadingEdit = true
        !this.pushTaskPanel(!form.frHeadingEdit, |Headings|)
        -- Set modified flag
        !form.isModHeadingEdit = true
        -- Set new heading flag
        !form.currentHdgIsNew = true
        -- Now fire the first question to initialise the list.
        !!catSpecViews.actionHeadingEdit(!form.lsHeadingList,'SELECT')
      else
        !!alert.warning(|Unknown error creating new heading!|)
        return
      endif
    elseif (!object eq !form.bnSpecHdgAtts) then
      !form.isInitHeadingEdit = true
      !this.pushTaskPanel(!form.frHeadingEdit, |Headings|)
    elseif (!object eq !form.bnSpecDelHdg) then
      if (!form.currentHdg.componentCount() eq 0) then
        !answer = !!alert.confirm(|Delete heading, are you sure?|)
        if (!answer eq |YES|) then
          !form.specification.deleteHeading(!form.opHeadings.selection().real())
          !this.initOpHeadings(!form)
          !this.actionCompTable(!form.opHeadings, |SELECT|)
        endif
      else
        !!alert.message(|Cannot delete heading containing items, delete items first then try again!|)
        return
      endif

    -- Edit components
    elseif (!object eq !form.bnSpecAddComps) then
            !this.pushTaskPanel(!form.frCompAdd, |Add Items|)

    elseif (!object eq !form.bnHeadingStd) then
            !this.pushTaskPanel(!form.frSpecHeadings, |Add Standard Headings|)
    elseif (!object eq !form.bnSpecAddLimbo) then
            !this.pushTaskPanel(!form.frCompAddLimbo, |Add From Limbo|)

     elseif (!object eq !form.bnSpecEditCompAns) then
            !this.pushTaskPanel(!form.frCompEditAns, |Edit Answers|)

    elseif (!object eq !form.bnSpecEditCompRefs) then
            !this.pushTaskPanel(!form.frCompEditRefs, |Edit References|)

    elseif (!object eq !form.bnSpecEditUserAtts) then
          !this.pushTaskPanel(!form.frCompEditUserAtts, |Edit UserAtts|)

    elseif (!object eq !form.bnSpecCompRename) then
            !form.renameCallGadget = !form.bnSpecCompRename
            !this.pushTaskPanel(!form.frRename, |Rename Items|)

    elseif ((!object eq !form.bnSpecRemComps or !object eq !form.bnSpecDelComps)) then

      if (!object eq !form.bnSpecRemComps) then
        !answer = !!alert.confirm(|Remove selected items to Limbo, are you sure?|)
        !delete = false
      else
        !answer = !!alert.confirm(|Delete selected items permanently, are you sure?|)
        !delete = true
      endif

      if (!answer eq |NO|) then
        return
      endif

      !specName = !form.specification.name()
      !rows = !form.selectedRows
      !savePlace = !!ce
      !this.speconmode('speconmode')

      do !val values !rows.invert()
        !component = object SPECCOMPONENT(!form.currentHdg, !val)
        !name = !component.name()
        old specification $!<specName>

        if (!delete) then
          if (!!dbRefUpdate(!name.dbref())) then
            !!ce = $!<name>
            !type = !!ce.type
            delete $!<type>
          else
            !this.speconmode('exit')
            !!alert.error(!!error.text)
          endif
          handle (2,107)
            -- Undefined reference.
          endhandle
        else $* Remove to limbo
          remove $!<name>
        endif
      enddo

      -- Exit SpeconMode
      !this.speconmode('exit')

      !form.specification = object CATSPECIFICATION(!form.specdbref)

      -- Return back to element we were at before we came into this bit.
      if (!delete) then
        !!ce = !savePlace
        handle (2,822)
          !!ce = !form.specdbref
        endhandle
      endif

      --  Rebuild the headings list
      !selectedHeading = !form.opHeadings.val
      !this.initOpHeadings(!form)
      if (!selectedHeading GT !form.opHeadings.count) then
        !form.opHeadings.val = !form.opHeadings.count
      else
        !form.opHeadings.val = !selectedHeading
      endif

      !this.actionCompTable(!form.opHeadings, |SELECT|)
      !selectedRows[0] = STRING()
      !this.netAfterSelect(!form, !selectedRows)
    endif
  endif

endmethod
-- End of method definition for .actionSpec(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      initNomBore
--
-- Description: Initialise nominal bore table for specification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initNomBore(!form is FORM)

  -- Check that initialisation is required
  if (!form.isInitNomBore.not()) then
    !form.isInitNomBore = true
    return
  endif

  using namespace  'Aveva.Pdms.Presentation'

  -- Set form units in case they have been changed on the command line
  !this.setFormUnits(!form)

  -- Initialise schedules
  !schedules = !!catPipeTableCodes.getCodes(|SCHEDULE|)

  -- Set current units
  !boreUnitFlag = !form.metricBoreFlag
  !distUnitFlag = !form.metricDistFlag

  -- Populate nombore table
  !tds = object PTABLENBDATASOURCE(!form.nomBoreTab.name, !schedules, !boreUnitFlag, !distUnitFlag)
  !form.frConNomBore.visible = false
  !form.netNomBore.bindToDataSource(!tds)
  !form.frConNomBore.visible = true

  -- Initialise attribute panel
  !form.txNomBoreName.val = !form.nomBoreTab.namn
  !form.txNomBorePurp.val = !this.txEmptyToUnset(!form.nomBoreTab.purpose)
  !form.txNomBoreDesc.val = !this.txEmptyToUnset(!form.nomBoreTab.description)

  -- Reset panel modified flag
  !form.isModNomBore = false

endmethod
-- End of method definition for .initNomBore(FORM)

------------------------------------------------------------------------
--
-- Method:      actionNomBore
--
-- Description: Gadget actions for nominal bore panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET     Calling gadget reference
--    2   R      STRING     Event action
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .actionNomBore(!object is GADGET, !action is STRING)

  -- Get owning form
  !form = !object.owner()

  -- Gadget actions
  -- Name
  if (!object eq !form.txNomBoreName and !action eq |SELECT|) then
    !validatedName = !!catValidateNameField(!form.txNomBoreName)
    if (!validatedName.set() and !validatedName.empty()) then
      !prevName = !form.nomBoreTab.namn
      !form.txNomBoreName.val = !prevName
    endif
    !form.isModNomBore = true

  -- Purpose
  elseif (!object eq !form.txNomBorePurp and !action eq |SELECT|) then
    !form.isModNomBore = true

  -- Description
  elseif (!object eq !form.txNomBoreDesc and !action eq |SELECT|) then
    !form.isModNomBore = true

  -- Back
  elseif (!object eq !form.bnNomBoreBack and !action eq |SELECT|) then
    if (!form.isModNomBore eq true and dbwrite) then
      !confirm = !!alert.question(|Apply changes before going back?|)
      if (!confirm eq |CANCEL|) then
        return
      elseif (!confirm eq |YES|) then
        !this.applyNomBore(!form)
      else
        !form.isModNomBore = false
      endif
    endif
    !this.manageMainPanels(!form.frCompTable)
    !this.popTaskPanel(!form)
    return

  endif

endmethod
-- End of method definition for .actionNomBore(GADGET, STRING)

------------------------------------------------------------------------
--
-- Method:      applyNomBore
--
-- Description: Apply action for Nominal Bore panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applyNomBore(!form is FORM)

  -- Set db element attributes
  !name = !this.txUnsetToEmpty(!form.txNomBoreName.val).trim()
  !this.setName(!form, !form.nomBoreTab, !name)
  !form.nomBoreTab.purpose = !this.txUnsetToEmpty(!form.txNomBorePurp.val).trim()
  !form.nomBoreTab.description = !this.txUnsetToEmpty(!form.txNomBoreDesc.val).trim()

  -- Unset modified flag
  !form.isModNomBore = false

  -- Run Apply Method.
  !form.netNomBore.applyMethod()

endmethod
-- End of method definition for .applyNomBore(FORM)

------------------------------------------------------------------------
--
-- Method:      initBranch
--
-- Description: Initialise branch table for specification
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initBranch(!form is FORM)

  -- Check that initialisation is required
  if (!form.isInitBranch.not()) then
    !form.isInitBranch = true
    return
  endif

  using namespace  'Aveva.Pdms.Presentation'

  -- Set current bore units
  !boreUnitFlag = !form.metricBoreFlag

  -- Initialise reducer short codes
  !shortCodes = !!catPipeTableCodes.getCodes(|BRANCH|)
  -- Set type flag true for branch table
  !typeFlag = true
  -- Get table name
  !reduName = !form.reducerTab.name
  handle (2,754)
  !reduName = ''
  endhandle
  !branName = !form.branchTab.name

  -- Populate branch/reducer table
  !form.frConBranch.visible = false
  !tds = object PTABLEBRDATASOURCE(!branName, !reduName, !shortCodes, !boreUnitFlag, !typeFlag, !!catPipeTableCodes.branGreyAreareadOnly)
  !form.netBranch.bindToDataSource(!tds)
  !form.frConBranch.visible = true

  -- Initialise attribute panel
  !form.txBranchName.val = !form.branchTab.namn
  !form.txBranchPurp.val = !this.txEmptyToUnset(!form.branchTab.purpose)
  !form.txBranchDesc.val = !this.txEmptyToUnset(!form.branchTab.description)

  -- Reset panel modified flag
  !form.isModBranch = false


endmethod
-- End of method definition for .initBranch(FORM)

