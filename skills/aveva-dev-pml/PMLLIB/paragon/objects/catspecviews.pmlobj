    -- Frames to force horizontal & vertical scroll bar on resize below minimum form size
    frame .frForceHorizontalScrollBars panel at xmin form ymin form width 80 height 0.5
    exit
    frame .frForceVerticalScrollBars   panel at xmin form ymin form width 1  height 30
    exit

    -- Define popup menu for .conCompTable
    !menu = !this.newMenu('puTable', 'POPUP')
    !menu.add('MENU', 'Navigate', 'puNavigateList', 'NAVIGATE')
    !menu.add('MENU', 'Edit', 'puEditList', 'EDIT')
    --!menu.add('SEPARATOR','Sep1' )
    --!menu.add('CALLBACK', 'Copy', '!!catSpecViews.tablePopup(', 'COPY')
    --!menu.add('CALLBACK', 'Paste', '!!catSpecViews.tablePopup(', 'PASTE')
    !menu = !this.newMenu('puNavigateList', 'POPUP')
    !menu.add('CALLBACK', 'Spec Component', '!!catSpecViews.tablePopup(', 'NAVSPCO')
    !menu.add('CALLBACK', 'Catalogue Component', '!!catSpecViews.tablePopup(', 'NAVCATREF')
    !menu.add('CALLBACK', 'Detail Text', '!!catSpecViews.tablePopup(', 'NAVDETAIL')
    !menu.add('CALLBACK', 'Material Text', '!!catSpecViews.tablePopup(', 'NAVMATXT')
    !menu.add('CALLBACK', 'Component Property', '!!catSpecViews.tablePopup(', 'NAVCMPREF')
    !menu.add('CALLBACK', 'Bolt set', '!!catSpecViews.tablePopup(', 'NAVBLTREF')
    !menu.add('CALLBACK', 'Part', '!!catSpecViews.tablePopup(', 'NAVPRTREF')
    !menu.add('CALLBACK', 'Template', '!!catSpecViews.tablePopup(', 'NAVTMPREF')
    !menu.add('CALLBACK', 'Pipe Data Table', '!!catSpecViews.tablePopup(', 'NAVPDAREF')
    !menu = !this.newMenu('puEditList', 'POPUP')
    !menu.add('CALLBACK', 'Part Family', '!!catSpecViews.tablePopup(', 'EDITPRTREF')
    !menu.add('CALLBACK', 'Model Category', '!!catSpecViews.tablePopup(', 'EDITCATREF')

  exit

  -- Pseudo form constructor
  !form = $!formName
  !form.callback         = |!!catSpecViews.init(| & !formName & |, true)|
  !form.cancelCall       = |!!catSpecViews.close(| & !formName & |)|

  -- Set catalogue element type for this form (this won't change after the first show)
  !form.cataType = |NONE|

  -- Initialise object to hold .net event pointers
  !form.eventClick = object EVENTCLICK(!form)

  -- Settings
  !form.detTxtAtt = |RTEXT|
  !form.matTxtAtt = |XTEXT|

  -- Reference strings
  -- Standard view
  !form.stdRefsD[1] = |Description|
  !form.stdRefsD[2] = |Material Text|
  !refStrR = |DETAIL MATXT|
  !form.stdRefsR = !refStrR.split()
  -- CAD view
  !form.cadRefsD = ARRAY()
  !form.cadRefsD.append(|Part Ref| )
  !form.cadRefsD.append(|Catalogue Ref|)
  !form.cadRefsD.append(|Detail Ref|)
  !form.cadRefsD.append(|Material Text Ref|)
  !form.cadRefsD.append(|Component Ref|)
  !form.cadRefsD.append(|Bolt Ref|)
  !form.cadRefsD.append(|Template Ref|)
  !form.cadRefsD.append(|Pipe Data Ref|)
  !refStrR = |PRTREF CATREF DETAIL MATXT CMPREF BLTREF TMPREF PDAREF|
  !form.cadRefsR = !refStrR.split()

  -- General strings
  !form.emptyString = |Empty|
  !form.unsetAttStr = |-- unset --|
  !form.unsetRefStr = |=0/0|
  !form.varyStr     = |<Multiple values>|
  !form.badRefStr   = |-- unknown ref --|
  !form.newQuesStr  = |NEWQ|

  -- Button icons
  !searchIcon    = !!pml.getpathname('ng_zoomtoselection.png')
  !upArrowIcon   = !!pml.getpathname('uparrow16.png')
  !downArrowIcon = !!pml.getpathname('downarrow16.png')
  !deleteIcon    = !!pml.getpathname('deletece16.png')

  -- Forms current element
  !form.bnce.callback        = |!!catSpecViews.init(| & !formName & |, true)|
  !form.opRecentCes.callback = |!!catSpecViews.updateRecentCes(|

  -- Spec component table
  !form.opHeadings.callback   = |!!catSpecViews.actionCompTable(|
  !form.frViewMode.callback   = |!!catSpecViews.actionCompTable(|
  !form.bnRowSelAll.callback  = |!!catSpecViews.actionCompTable(|
  !form.bnRowSelNone.callback = |!!catSpecViews.actionCompTable(|
  -- Add instance of .net component table control
  !form.netCompTable = object NETGRIDCONTROL()
  -- Add event handlers to component table control
  !form.netCompTable.addEventHandler('OnPopup', !form.eventClick, 'specRightClick')
  !form.netCompTable.addEventHandler('AfterSelectChange', !form.eventClick, 'specAfterSelect')
  -- Set component table control properties
  !form.netCompTable.fixedHeaders(false)
  !form.netCompTable.outlookGroupStyle(false)
  !form.netCompTable.columnExcelFilter(false)
  !form.netCompTable.headerSort(true)
  !form.netCompTable.columnSummaries(false)
  !form.netCompTable.singleRowSelection(false)
  !form.netCompTable.setAlternateRowColor('WHITE')
  -- Add component table control to .net container
  !form.conCompTable.control  = !form.netCompTable.handle()
  -- Add popup to .net container
  !form.conCompTable.popup = !form.puTable

  -- Add instances of .net nominal bore control
  !form.netNomBore = object NOMINALBORESCTRL()
  -- Add nominal bore control to .net container
  !form.conNomBore.control  = !form.netNomBore.handle()

  -- Add instances of .net branch table control
  !form.netBranch = object BRANCHREDUCERCTRL()
  -- Add branch table control to .net container
  !form.conBranch.control  = !form.netBranch.handle()

  -- Add instances of .net reducer table control
  !form.netReducer = object BRANCHREDUCERCTRL()
  -- Add reducer table control to .net container
  !form.conReducer.control  = !form.netReducer.handle()

    -- Add instances of .net reducer table control
  !form.netTapping = object BRANCHREDUCERCTRL()
  -- Add reducer table control to .net container
  !form.conTapping.control  = !form.netTapping.handle()

  -- Specification panel
  !form.bnSpecGenAtts.callback   = |!!catSpecViews.actionSpec(|
  !form.bnSpecCadAtts.callback   = |!!catSpecViews.actionSpec(|
  !form.bnSpecUpdateAtts.callback = |!!catSpecViews.actionSpec(|
  !form.bnSpecRename.callback    = |!!catSpecViews.actionSpec(|
  !form.bnSpecExport.callback    = |!!catSpecViews.actionSpec(|
  !form.bnSpecNomBore.callback   = |!!catSpecViews.actionSpec(|
  !form.bnSpecBranch.callback    = |!!catSpecViews.actionSpec(|
  !form.bnSpecReducer.callback   = |!!catSpecViews.actionSpec(|
  !form.bnSpecAddHdg.callback    = |!!catSpecViews.actionSpec(|
  !form.bnSpecHdgAtts.callback   = |!!catSpecViews.actionSpec(|
  !form.bnSpecDelHdg.callback    = |!!catSpecViews.actionSpec(|
  !form.bnSpecAddComps.callback  = |!!catSpecViews.actionSpec(|
  !form.bnSpecAddLimbo.callback  = |!!catSpecViews.actionSpec(|
  !form.bnSpecAddComps.callback  = |!!catSpecViews.actionSpec(|
  !form.bnHeadingStd.callback    = |!!catSpecViews.actionSpec(|
  !form.bnSpecEditCompAns.callback  = |!!catSpecViews.actionSpec(|
  !form.bnSpecEditCompRefs.callback = |!!catSpecViews.actionSpec(|
  !form.bnSpecEditUserAtts.callback     = |!!catSpecViews.actionSpec(|
  !form.bnSpecCompRename.callback   = |!!catSpecViews.actionSpec(|
  !form.bnSpecRemComps.callback     = |!!catSpecViews.actionSpec(|
  !form.bnSpecDelComps.callback     = |!!catSpecViews.actionSpec(|
  !form.bnStdHeadingDelete.settooltip(|Delete Standard Heading from Defaults File (Needs a save).|)

  -- Nominal bores panel
  !form.txNomBoreName.callback  = |!!catSpecViews.actionNomBore(|
  !form.txNomBorePurp.callback  = |!!catSpecViews.actionNomBore(|
  !form.txNomBoreDesc.callback  = |!!catSpecViews.actionNomBore(|
  !form.bnNomBoreApply.callback = |!!catSpecViews.applyNomBore(| & !formName & |)|
  !form.bnNomBoreBack.callback  = |!!catSpecViews.actionNomBore(|

  -- Branch table panel
  !form.txBranchName.callback  = |!!catSpecViews.actionBranch(|
  !form.txBranchPurp.callback  = |!!catSpecViews.actionBranch(|
  !form.txBranchDesc.callback  = |!!catSpecViews.actionBranch(|
  !form.bnBranchApply.callback = |!!catSpecViews.applyBranch(| & !formName & |)|
  !form.bnBranchBack.callback  = |!!catSpecViews.actionBranch(|

  -- Reducer table panel
  !form.txReducerName.callback  = |!!catSpecViews.actionReducer(|
  !form.txReducerPurp.callback  = |!!catSpecViews.actionReducer(|
  !form.txReducerDesc.callback  = |!!catSpecViews.actionReducer(|
  !form.bnReducerApply.callback = |!!catSpecViews.applyReducer(| & !formName & |)|
  !form.bnReducerBack.callback  = |!!catSpecViews.actionReducer(|

  -- Tapping table panel
  !form.txTappingName.callback  = |!!catSpecViews.actionTapping(|
  !form.txTappingPurp.callback  = |!!catSpecViews.actionTapping(|
  !form.txTappingDesc.callback  = |!!catSpecViews.actionTapping(|
  !form.bnTappingApply.callback = |!!catSpecViews.applyTapping(| & !formName & |)|
  !form.bnTappingBack.callback  = |!!catSpecViews.actionTapping(|

  -- Spec general attributes panel
  --!form.txSpecAttName.callback = |!!catSpecViews.actionSpecGenAtts(|
  !form.txSpecAttName.active = false
  !form.txSpecAttDesc.callback = |!!catSpecViews.actionSpecGenAtts(|
  !specTypeDStr = |Piping Insulation Tracing Bolting None|
  !specTypeD    = !specTypeDStr.split()
