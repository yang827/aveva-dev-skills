    exit

    path down
    -- Spec tasks frame
    frame .frSpec anchor bottom + left + right at xmin form ymax.frCompTable         width 80                      height 13
      para  .paSpecAtts         at xmin+5 ymin+1 text 'Specification'                width 12
      line .lnSpecAtts          at ymax-0.2 horizontal                               width 10                      height 0.5
      button .bnSpecGenAtts      linklabel                                           width 12 'Edit Spec Atts...'
      button .bnSpecCadAtts      linklabel                                           width 12 'Edit CAD Atts...'
      button .bnSpecUpdateAtts    linklabel                                           width 12 'Update Atts...'
      button .bnSpecRename       linklabel                                           width 12 'Rename Spec...'
      button .bnSpecExport       linklabel                                           width 12 'Export...'
      para  .paSpecList         at xmax.paSpecAtts+2 ymin.paSpecAtts text 'Tables'   width 12
      line .lnSpecList          at ymax-0.2 horizontal                               width 10                      height 0.5
      button .bnSpecNomBore      linklabel                                           width 12 'Size Range...'
      button .bnSpecBranch       linklabel                                           width 12 'Branch Table...'
      button .bnSpecReducer      linklabel                                           width 12 'Reducer Table...'
      button .bnSpecTapping      linklabel                                           width 12 'Tapping Table...'
      para  .paSpecTypes        at xmax.paSpecList+2 ymin.paSpecList text 'Headings' width 12
      line .lnSpecTypes1        at ymax-0.2 horizontal                               width 9                       height 0.5
      button .bnSpecAddHdg       linklabel                                           width 12 'Add Heading...'
      button .bnSpecHdgAtts      linklabel                                           width 12 'Edit Heading...'
