--
--
-- Description:
-- Object for specification view control
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add()                            -                   Add new specView into the system
--  add(BOOLEAN)                     -                   Add a new specView into the system
--  add(FORM)                        -                   Add existing specView into the system
--  add(REAL)                        -                   Add existing specView into the system
--  defineForm(REAL)                 FORM                Create new specView form
--  globalInstance()                 -                   Create global instance of object
--
------------------------------------------------------------------------
-- Define object
define object CATSPECVIEWS

  -- List of graphical views
  member .specViews       is ARRAY

endobject
-- End of object definition for catSpecViews

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .globalInstance()

  -- Create Global Variable
  !!catSpecViews = !this

endmethod
-- End of method definition for .globalInstance()

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add existing specView into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Spec view form
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .add(!form is FORM)

  -- Add form to system
  !this.specViews.append(!form)

  -- Update control form if exists and shown
  if (defined(!!catControl)) then
    if (!!catControl.shown()) then
        !!catControl.initialise()
    endif
  endif

  -- Show form
  !form.show('AT', 0, 0)

endmethod
-- End of method definition for .add(FORM)

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add existing specView into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Spec view form number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .add(!number is REAL)

  -- Add form to system
  !formName   = |!!catSpecEdit| & !number
  !form = $!formName
  handle any
    -- Form not defined
    return
  endhandle
  !this.specViews[!number] = !form

  -- Update control form if exists and shown
  if (defined(!!catControl)) then
    if (!!catControl.shown()) then
      !!catControl.initialise()
    endif
  endif

  -- Show form
  !form.show('AT', 0, 0)

endmethod
-- End of method definition for .add(REAL)

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add new specView into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .add()

  -- Create new form and add to system
  !this.add(!this.defineForm(!this.nextAvailable()))

endmethod
-- End of method definition for .add(FORM)

------------------------------------------------------------------------
--
-- Method:      add
--
-- Description: Add a new specView into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     BOOLEAN     If set, form is read only version
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .add(!readOnly is BOOLEAN)

  -- Create new form and add to system
  !form = !this.defineForm(!this.nextAvailable())
  !form.isReadOnly = !readOnly
  !this.add(!form)
endmethod
-- End of method definition for .add(FORM)

------------------------------------------------------------------------
--
-- Method:      defineForm
--
-- Description: Add new specView into the system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Form number
-- Return:
--   [Data Type] [Description]
--    FORM        Form created
--
------------------------------------------------------------------------
-- Define method
define method .defineForm(!number is REAL) is FORM

  import 'GridControl'
  handle any
  endhandle
  import 'PipingTablesAddin'
  handle any
  endhandle
  import 'PMLDBSearch'
  handle any
  endhandle
  import 'PMLFileBrowser'
  handle any
  endhandle

