    -- Frame initialisation flags & data
    member .isInitNomBore          is BOOLEAN
    member .isInitBranch           is BOOLEAN
    member .isInitReducer          is BOOLEAN
    member .isInitTapping          is BOOLEAN
    member .isInitSpecGenAtts      is BOOLEAN
    member .isInitSpecCadAtts      is BOOLEAN
    member .isInitHeadingEdit      is BOOLEAN
    member .isInitCompAdd          is BOOLEAN
    member .isInitCompAddLimbo     is BOOLEAN
    member .isInitCompEditRefs     is BOOLEAN
    member .isInitCompEditUserAtts is BOOLEAN

    member .isInitRename           is BOOLEAN
    member .renameCallGadget       is GADGET

    member .isInitSearch           is BOOLEAN
    member .searchCallFrame        is STRING
    member .searchCallGadget       is GADGET
    member .searchDbType           is STRING
    member .searchScope            is ARRAY
    member .searchEleTypes         is ARRAY
    member .searchFilters          is ARRAY
    member .searchMultiSel         is BOOLEAN
    member .searchColumns          is ARRAY

    member .isInitRefList          is BOOLEAN
    member .refListCallFrame       is STRING
    member .refListCallGadget      is GADGET
    member .refListCallType        is STRING
    member .refListSingleSel       is BOOLEAN
    member .selectedRefListRows    is ARRAY

    -- Frame modified status
    member .isModNomBore           is BOOLEAN
    member .isModBranch            is BOOLEAN
    member .isModReducer           is BOOLEAN
    member .isModTapping           is BOOLEAN

    member .isModSpecGenAtts       is BOOLEAN
    member .isModSpecCadAtts       is BOOLEAN
    member .isModHeadingEdit       is BOOLEAN
    member .isModCompAdd           is BOOLEAN
    member .isModCompAddLimbo      is BOOLEAN
    member .isModCompEditAns       is BOOLEAN
    member .isModCompEditRefs      is BOOLEAN
    member .isModCompEditUserAtts  is BOOLEAN
    member .isModRename            is BOOLEAN
    member .isModSearch            is BOOLEAN
    member .isModRefList           is BOOLEAN
    member .isHeadingStd           is BOOLEAN

    -- Component reference members
