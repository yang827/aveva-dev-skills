  !formName   = |!!catSpecEdit| & !number
  setup form $!<formName> dialog docking noalign

    $!<formName>.formTitle     = |Edit Specification | & !number
    $!<formName>.iconTitle     = ||
    $!<formName>.formRevision  = | $Revision: 1.00 $ |

    -- Define .net control namespaces
    using namespace 'Aveva.Pdms.Presentation'
    using namespace 'Aveva.Pdms.Presentation.PMLDBSearchCtrl'

    -- .net controls
    member .netCompTable           is NETGRIDCONTROL
    member .netNomBore             is NOMINALBORESCTRL
    member .netBranch              is BRANCHREDUCERCTRL
    member .netReducer             is BRANCHREDUCERCTRL
    member .netTapping             is BRANCHREDUCERCTRL

    member .searchControl          is PMLDBSEARCHCTRL
    member .netRefList             is NETGRIDCONTROL
    member .netUpdateTable         is NETGRIDCONTROL

    -- Redirection object for .net control events
    member .eventClick             is EVENTCLICK

    -- Results for search and ref list controls
    member .searchResults          is ARRAY
    member .refListCates           is ARRAY
    member .refAttsCates           is ARRAY
    member .refdbrefCates          is ARRAY
    member .refListScoms           is ARRAY
    member .refAttsScoms           is ARRAY
    member .refdbrefScoms          is ARRAY
    member .refListPrteles         is ARRAY
    member .refAttsPrteles         is ARRAY
    member .refdbrefPrteles        is ARRAY
    member .refListGparts          is ARRAY
    member .refAttsGparts          is ARRAY
    member .refdbrefGparts         is ARRAY
    member .refListSdtes           is ARRAY
    member .refAttsSdtes           is ARRAY
    member .refdbrefSdtes          is ARRAY
    member .refListSmtes           is ARRAY
    member .refAttsSmtes           is ARRAY
    member .refdbrefSmtes          is ARRAY
    member .refListCmpds           is ARRAY
    member .refAttsCmpds           is ARRAY
    member .refdbrefCmpds          is ARRAY
    member .refListSbols           is ARRAY
    member .refAttsSbols           is ARRAY
    member .refdbrefSbols          is ARRAY
    member .refListTmpls           is ARRAY
    member .refAttsTmpls           is ARRAY
    member .refdbrefTmpls          is ARRAY
    member .refListLimbos          is ARRAY
    member .refAttsLimbos          is ARRAY
    member .refdbrefLimbos         is ARRAY
    member .refListPDaTabs         is ARRAY
    member .refAttsPDaTabs         is ARRAY
    member .refdbrefPDaTabs        is ARRAY
    member .headings               is ARRAY
    member .headingDTypes          is ARRAY
    member .headingRTypes          is ARRAY
    member .headingQuest           is ARRAY
    member .stdHeadingDTypes       is ARRAY
    member .stdHeadingRTypes       is ARRAY
    member .stdHeadingQuest        is ARRAY
    member .findUserAttNames       is BOOLEAN
    member .userAttNames           is ARRAY
    member .userAttTypes           is ARRAY
    member .userAttTextGadgets     is ARRAY
    member .userAttSearchButtons   is ARRAY
    member .userAttCeButtons       is ARRAY
    member .userHeadingsFile       is FILE
    member .headingsFile           is FILE

    member .currentHeading         is STRING

    -- Form management
    member .taskPanelStack         is ARRAY
    member .isReadOnly             is BOOLEAN
    member .isSpecUpdateable       is BOOLEAN

    -- Type of element being viewed/edited
    member .cataType               is STRING
    member .nomBoreTab             is DBREF
    member .nomBores               is ARRAY
    member .pboreCombos            is ARRAY
    member .branchTab              is DBREF
    member .branchCodes            is ARRAY
    member .reducerTab             is DBREF
    member .reducerCodes           is ARRAY
    member .tappingTab             is DBREF
    member .tappingCodes           is ARRAY

    -- Units
