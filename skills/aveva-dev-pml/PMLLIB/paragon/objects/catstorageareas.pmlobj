--    Group:         Undefined
--      Keyword:     Undefined
--    Module:        Paragon
--  Author:          D. Kettle
--  Created:         Tue Jul 31 15:09:13 2007
--
--  Description:     Default storage areas for database elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  catstorageareas()                -                   Constructor
--  clearArea(STRING)                -                   Clear the specified storage area from the store
--  getArea(STRING)                  DBREF               Return the specified storage area
--  globalInstance()                 -                   Create global instance of object
--  loadFile()                       -                   Load storage areas from defaults file
--  loadFile(STRING)                 -                   Load storage areas from defaults file
--  saveFile(STRING)                 -                   Save storage areas to defaults file
--  setArea(STRING,DBREF,ARRAY)      BOOLEAN             Set the specified storage area
--
------------------------------------------------------------------------
define object CATSTORAGEAREAS

  -- File
  member .fileName      is STRING
  member .dfltFile      is FILE
  member .dfltArea      is STRING
  member .dfltPaths     is ARRAY    $* DEFAULTFILE objects
  member .delimiter     is STRING

  -- Storage areas
  member .storeTable    is ELEMENTSTORETABLE

endobject
-- End of object definition for catstorageareas

------------------------------------------------------------------------
--
-- Method:      catstorageareas
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .catstorageareas()

  -- Set default file data
  !this.fileName = |cat-storageareas.pmldat|
  !this.delimiter = |~|

  -- Initialise store table
  !this.storeTable = object ELEMENTSTORETABLE('Paragon Element Store', 'Storage areas for Paragon')

  -- Find the most local defaults path (in PDMSDFLTS, {PRJ}DFLTS, or PDMSUSER)
  !this.dfltPaths = !!searchpaths(!this.fileName)
  if (!this.dfltPaths.size() gt 0) then
    -- Set default file
    !this.dfltFile = !this.dfltPaths.last().file
    !this.dfltArea = !this.dfltPaths.last().defaultType
    -- Load defaults from file
    !this.loadFile()
  else
    !this.dfltArea = |PDMS|
  endif

endmethod
-- End of method definition for .catstorageareas()

------------------------------------------------------------------------
--
-- Method:      loadFile
--
-- Description: Load storage areas from defaults file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadFile()

  -- Load defaults into temporary defaults array
  if (!this.dfltFile.unset()) then
    return
  else
    -- Initialise store table
    !this.storeTable = object ELEMENTSTORETABLE('Paragon Element Store', 'Storage areas for Paragon')
    -- Load temporary defaults array
    !!runMacro(!this.dfltFile.fullname(), '')
    handle any
    endhandle
  endif

  -- Save defaults into element store
  do !val values !!tmpCatStorageAreas
    !areaKey = !val.part(1, !this.delimiter).trim()
    !elementName = !val.part(2, !this.delimiter).trim()
    !allowableTypes = !val.part(3, !this.delimiter).split()
    !this.storeTable.storeTypes(!areaKey, !allowableTypes)
    !dbref = !elementName.dbref()
    handle any
      !this.storeTable.clear(!areaKey)
    elsehandle none
      if (!dbref.set() and !this.storeTable.setStore(!areaKey, !dbref).not()) then
        !this.storeTable.clear(!areaKey)
      endif
    endhandle
  enddo

  -- Delete temporary defaults array
  if (defined(!!tmpCatStorageAreas)) then
    !!tmpCatStorageAreas.delete()
  endif

endmethod
-- End of method definition for .loadFile()

------------------------------------------------------------------------
--
-- Method:      loadFile
--
-- Description: Load storage areas from defaults file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Default area, PDMS, PROJ, or USER
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadFile(!area is STRING)

  -- Load defaults into temporary defaults array
  !dfltFile = object FILE()
  do !ind indices !this.dfltPaths
    if (!this.dfltPaths[!ind].defaultType eq !area) then
      !dfltFile = !this.dfltPaths[!ind].file
      break
    endif
  enddo
  if (!dfltFile.unset()) then
    return error 1 |Unable to locate storage area default file for $!<area>!|
  else
    !this.dfltFile = !dfltFile
    !this.dfltArea = !area
    !this.loadFile()
  endif

endmethod
-- End of method definition for .loadFile(STRING)

------------------------------------------------------------------------
--
-- Method:      saveFile
--
-- Description: Save storage areas to defaults file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Path key (PDMS, PROJ, or USER)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveFile(!pathKey is STRING)

  -- Construct environment variable for file path
  if (!pathKey.upcase() eq |PDMS|) then
    !evar = 'PDMSDFLTS'
  elseif (!pathKey.upcase() eq |PROJ|) then
    !project = current project
    !evar = !project.code() & 'DFLTS'
  elseif (!pathKey.upcase() eq |USER|) then
    !evar = 'PDMSUSER'
  else
    return error 1 |Invalid path Key for storage area, you must specify PDMS, PROJ or USER!|
  endif
  -- Test if environment variable is set
  var !evarTest evar $!<evar>
  if (!evarTest.empty()) then
    return error 1 |Environment variable $!<evar> is unset!|
  endif
  -- Check that the directory path does exist
  !path = '%' & !evar & '%\'
  !directory = object FILE(!path)
  if (!directory.exists().not()) then
    return error 1 |Can't find directory $!<directory>, storage area default file will not be saved!|
  endif
  -- Create file object
  !file = object FILE(!path & !this.fileName)

  -- Compile lines for file
  -- File header
  !lines = ARRAY()
  !lines.append(|-- Data file containing default storage areas by discipline in Paragon|)
  !lines.append(|!!tmpCatStorageAreas = ARRAY()|)
  --Storage areas
  do !val values !this.storeTable.storageareas
    -- Key
    !key = !val.key
    -- Storage area name
    !storageArea = !val.element
    if (!storageArea.badref()) then
      !areaName = ''
    else
      !areaName = !storageArea.name
    endif
    -- Types
    !types = STRING()
    do !ind indices !val.types
      if (!ind eq 1) then
        !types = !val.types[!ind]
      else
        !types = !types & ' '  & !val.types[!ind]
      endif
    enddo
    !lines.append(|!!tmpCatStorageAreas.append('| & !key & !this.delimiter & !areaName & !this.delimiter & !types & |')|)
  enddo
  -- Write the file
  !file.writefile('WRITE', !lines)
  handle (160,44)
    -- User doesn't want to overwrite
  elsehandle none
    -- Reload search paths in case this is a new file
    !this.dfltPaths = !!searchpaths(!this.fileName)
    -- Set file details
    !this.dfltFile = !file
    !this.dfltArea = !pathKey.upcase()
  endhandle

endmethod
-- End of method definition for .saveFile(STRING)

------------------------------------------------------------------------
--
-- Method:      setArea
--
-- Description: Set the specified storage area
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setArea(!areaKey is STRING, !dbref is DBREF, !types is ARRAY) is BOOLEAN

  if (!this.storeTable.setStore(!areaKey.upcase(), !dbref)) then
    !this.storeTable.storeTypes(!areaKey.upcase(), !types)
    return true
  else
    return false
  endif

endmethod
-- End of method definition for .setArea(STRING, DBREF, ARRAY)BOOLEAN

------------------------------------------------------------------------
--
-- Method:      getArea
--
-- Description: Return the specified storage area
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getArea(!areaKey is STRING) is DBREF

  return !this.storeTable.getStore(!areaKey.upcase())

endmethod
-- End of method definition for .getArea(STRING)DBREF

------------------------------------------------------------------------
--
-- Method:      clearArea
--
-- Description: Clear the specified storage area from the store
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearArea(!areaKey is STRING)

  !this.storeTable.clear(!areaKey.upcase())

endmethod
-- End of method definition for .clearArea(STRING, DBREF)

------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: Create global instance of object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define method
define method .globalInstance()

  -- Create Global Variable
  !!catstorageareas = !this

endmethod
-- End of method definition for .globalInstance()
