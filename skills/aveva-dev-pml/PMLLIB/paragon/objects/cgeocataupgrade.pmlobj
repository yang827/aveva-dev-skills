--
-- Description:
--   Upgrades the Standard Steel Catalogue Pline sets to include
--   additional Pline for Center of Geometry.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cgeoCataUpgrade()                -
--  cgeoCataUpgrade(STRING)          -
--  getCdef(STRING)                  ARRAY
--  getDBdef(STRING)                 ARRAY
--  getIdef(STRING)                  ARRAY
--  getJBdef(STRING)                 ARRAY
--  getLdef(STRING)                  ARRAY
--  getOdef(STRING)                  ARRAY
--  getOtherDef(STRING)              ARRAY
--  getRHSdef(STRING)                ARRAY
--  getTdef(STRING)                  ARRAY
--  startUpgrade()                   -
--  unhandledSCTNTypes()             -
--  upgradePLINE(DBREF,ARRAY)        REAL
--
--  Description:     Undefined
--  ===========                      ======              ===========
--  cgeoCataUpgrade()                -
--  cgeoCataUpgrade(STRING)          -
--  getCdef(STRING)                  ARRAY
--  getDBdef(STRING)                 ARRAY
--  getIdef(STRING)                  ARRAY
--  getJBdef(STRING)                 ARRAY
--  getLdef(STRING)                  ARRAY
--  getOdef(STRING)                  ARRAY
--  getOtherDef(STRING)              ARRAY
--  getRHSdef(STRING)                ARRAY
--  getTdef(STRING)                  ARRAY
--  startUpgrade()                   -
--  unhandledSCTNTypes()             -
--  upgradePLINE(DBREF,ARRAY)        REAL
--

define object CGEOCATAUPGRADE

  member .errors is ARRAY
  member .errorStatus is ARRAY
  member .map is ARRAY

  member .errNone is REAL
  member .errAU is REAL
  member .errEQNA is REAL
  member .errNoMac is REAL
  member .errNoNA is REAL
  member .errRefFail is REAL
  member .errOverW is REAL
  member .errEval is REAL
  member .errUnref is REAL

  member .cpData is STRING
  member .fileName is STRING
  member .recordLog is ARRAY
  member .upgraded is ARRAY
endobject

define method .cgeoCataUpgrade()
  !this.cgeoCataUpgrade('\cgeocataupgrade.log')
endmethod

define method .cgeoCataUpgrade(!fnam is STRING)

  -- define error codes
  !this.errNone = 1
  !this.errAU = 2
  !this.errEQNA = 3
  !this.errNoMac = 4
  !this.errNoNA = 5
  !this.errRefFail = 6
  !this.errOverW = 7
  !this.errEval = 8
  !this.errUnref = 9
  --strings representing errors
  !this.errors[!this.errNone]  = |Upgraded|
  !this.errors[!this.errAU]    = |Already updated|
  !this.errors[!this.errEQNA]  = |Same as NA. CGEO PLINE not required|
  !this.errors[!this.errNoMac] = |No upgrade macro available for SCTN type|
  !this.errors[!this.errNoNA]  = |NA does not exist|
  !this.errors[!this.errRefFail] = |Reference does not exist|
  !this.errors[!this.errOverW] = |Updated|
  !this.errors[!this.errEval]  = |Unable to evaluate expression|
  !this.errors[!this.errUnref] = |Not referenced by any SPRFs. Unable to upgrade|

  --strings representing error severity
  !this.errorStatus[!this.errNone] = ||
  !this.errorStatus[!this.errAU] = |Message|
  !this.errorStatus[!this.errEQNA] = |Message|
  !this.errorStatus[!this.errNoMac] = |Warning|
  !this.errorStatus[!this.errNoNA] = |Critical Warning|
  !this.errorStatus[!this.errRefFail] = |Critical Error|
  !this.errorStatus[!this.errOverW] = |Message|
  !this.errorStatus[!this.errEval] = |Error|
  !this.errorStatus[!this.errUnref] = |Warning|

  --cardinal point data used to create new PLIN
  !this.cpData = |LEVEL 99 99 TUFL TRUE CLFL TRUE|

  --Create arrays corresponding roughly to the various shapes of sctns
  --available. If possible it's recommended to try to use an existing
  --algorithm to describe the Center of Geometry, however, as not all
  --catalog definitions follow the same conventions, specific definitions
  --may require new algorithms to be used. Once an approximate shape has been
  --decided, the appropriate calculations can be done in the relevant
  --getXXXdef functions e.g. getRHSDef(...), getTdef(...), getIDef(...), etc


  --List of T-shaped SCTN specification names
  !tShape[1] = |/BS-PTSS-TEE|
  !tShape[2] = |/DIN-PTSS-DINT|
  !tShape[3] = |/JIS-PTSS-TEE|
  !tShape[4] = |/AISC-PTSS-WT-PRFL|
  !tShape[5] = |/CISC-PTSS-WT-PRFL|
  !tShape[6] = |/AISC-PTSS-MT-PRFL|
  !tShape[7] = |/AS_BT_PTSS|
  !tShape[8] = |/AISC-PTSS-ST-PRFL|
  !tShape[9] = |/AS_CT_PTSS|
  !tShape[10] = |/Generic-Tee-Profile/PTSS|

  -- >> Add further specs for T-shaped SCTNs here. e.g
  -- >> !tShape[11] = |/new-spec-name|

  --List of I-shaped SCTN specification names
  !iShape[1]  = |/BS-PTSS-BEAM|
  !iShape[2]  = |/BS-PTSS-RSJ|
  !iShape[3]  = |/DIN-PTSS-DINI|
  !iShape[4]  = |/DIN-PTSS-BEAM|
  !iShape[5]  = |/JIS-PTSS-BEAM|
  !iShape[6]  = |/JIS-PTSS-JISI|
  !iShape[7]  = |/AISC-PTSS-W-PRFL|
  !iShape[8]  = |/AISC-PTSS-S-PRFL|
  !iShape[9]  = |/CISC-PTSS-W-PRFL|
  !iShape[10] = |/CISC-PTSS-S-PRFL|
  !iShape[11] = |/AISC-PTSS-M-PRFL|
  !iShape[12] = |/AISC-PTSS-HP-PRFL|
  !iShape[13] = |/AS_UB_PTSS|
  !iShape[14] = |/AS_UC_PTSS|
  !iShape[15] = |/AS_WB_PTSS|
  !iShape[16] = |/AS_WC_PTSS|
  !iShape[17] = |/AS_TFB_PTSS|
  !iShape[18] = |/IG-PTSS|
  !iShape[19] = |/ASL/Flat-Bar/PTSS|
  !iShape[20] = |/MHULL/PANEL-SUPPORT/JOIN/PTSS|

  -- >> Add further specs that for I-shaped SCTNs here. e.g
  -- >> !iShape[21] = |/new-spec-name|

  --List of O-shaped SCTN specification names
  !oShape[1] = |/BS-PTSS-TUBE|
  !oShape[2] = |/DIN-PTSS-TUBE|
  !oShape[3] = |/JIS-PTSS-TUBE|
  !oShape[4] = |/AISC-PTSS-THS-PRFL|
  !oShape[5] = |/CISC-PTSS-THS-PRFL|
  !oShape[6] = |/AS_CHS_PTSS|
  !oShape[7] = |/AISC-PTSS-HSS-TUBE-PRFL|
  !oShape[8] = |/ASL/BS-PTSS-TUBE|

  -- >> Add further specs for O-shaped SCTNs here. e.g
  -- >> !oShape[9] = |/new-spec-name|

  --List of C (or U) -shaped SCTN specification names
  !cShape[1] = |/BS-PTSS-BSC|
  !cShape[2] = |/DIN-PTSS-DINU|
  !cShape[3] = |/JIS-PTSS-JISU|
  !cShape[4] = |/AISC-PTSS-C-PRFL|
  !cShape[5] = |/CISC-PTSS-C-PRFL|
	!cShape[6] = |/AISC-PTSS-MC-PRFL|
	!cShape[7] = |/AS_TFC_PTSS|
	!cShape[8] = |/AS_PFC_PTSS|
	!cShape[9] = |/ASL/BS-PTSS-BSC |
	!cShape[10] = |/BS-PTSS-PFC|
	!cShape[11] = |/ASL/BS-PTSS-PFC|
	!cShape[12] = |/CG-PTSS|
	!cShape[13] = |/SWE-PTSS-UPE|
  -- >> Add further specs that follow the AVEVA standard definition
  -- >> for a C-shaped SCTN here. e.g
  -- >> !cShape[14] = |/new-spec-name|

  --List of L-shaped SCTN specification names
  !lShape[1] = |/BS-PTSS-ANG|
  !lShape[2] = |/DIN-PTSS-ANG|
  !lShape[3] = |/DIN-PTSS-ANG-PLT|
  !lShape[4] = |/JIS-PTSS-ANG|
  !lShape[5] = |/JIS-PTSS-JANG|
  !lShape[6] = |/AISC-PTSS-L-PRFL|
  !lShape[7] = |/CISC-PTSS-L-PRFL|
  !lShape[8] = |/NZ_ANG_PTSS|
  !lShape[9] = |/AS_ANG_PTSS|
  !lShape[10] = |/ASL/BS-PTSS-ANG|
  !lShape[11] = |/LP-PTSS|
  !lShape[12] = |/Generic-Angle-Profile/PTSS|
  -- >> Add further specs for L-shaped SCTNs here. e.g
  -- >> !lShape[13] = |/new-spec-name|

  --List of RHS-shaped SCTN specification names
  !rhsShape[1] = |/BS-PTSS-BOX|
  !rhsShape[2] = |/DIN-PTSS-BOX|
  !rhsShape[3] = |/JIS-PTSS-BOX|
  !rhsShape[4] = |/AISC-PTSS-HS-PRFL|
  !rhsShape[5] = |/CISC-PTSS-HS-PRFL|
  !rhsShape[6] = |/AS_SHS_PTSS|
  !rhsShape[7] = |/AISC-PTSS-HSS-BOX-PRFL|
  !rhsShape[8] = |/AS_RHS_PTSS|
  !rhsShape[9] = |/ASL/BS-PTSS-BOX|
  !rhsShape[10] = |/SWE-PTSS-KKR|
  -- >> Add further specs for an RHS-shaped SCTNs here. e.g
  -- >> !rhsShape[11] = |/new-spec-name|


  --List of Japanes bulb-shaped SCTN specification names
  !jbShape[1] = |/JIS-PTSS-JISB|
  -- >> Add further specs for a Japanese bulb-shaped SCTNs here. e.g
  -- >> !jbShape[2] = |/new-spec-name|

  --List of German bulb-shaped SCTN specification names
  !dbShape[1] = |/DIN-PTSS-BULB|
  !dbShape[2] = |/HP-PTSS|
  -- >> Add further specs for German standard bulb-shaped SCTNs here. e.g
  -- >> !dbShape[3] = |/new-spec-name|

  --List of all other SCTN specification names that can be
  --upgraded. Each name may need to be processed separately within
  --the calculating subroutine
	!otherShape[1] = |/TREAD-PTSS|
	!otherShape[2] = |/ASL/Hexagonal-Bar/PTSS|
	!otherShape[3] = |/ASL/Circular-Bar/PTSS|
	!otherShape[4] = |/ASL/Square-Bar/PTSS|
	!otherShape[5] = |/GENERAL-BEAMS-PTSS-RECT-FIX|
	!otherShape[6] = |/GENERAL-BEAMS-PTSS-RECT-VARI|
	!otherShape[7] = |/GENERAL-CIRC-PTSS|
  !otherShape[8] = |/FB-PTSS|
  !otherShape[9] = |/BG-PTSS|
  -- >> Add further specs that don't follow any general convention
  -- >> for a SCTN definitions here. e.g
  -- >> !otherShape[3] = |/new-spec-name|



  -- Combine all accepted SCTN spec lists into a single table
  !this.map[1] = !tShape
  !this.map[2] = !iShape
  !this.map[3] = !oShape
  !this.map[4] = !cShape
  !this.map[5] = !lShape
  !this.map[6] = !rhsShape
  !this.map[7] = !jbShape
  !this.map[8] = !dbShape
  !this.map[9] = !otherShape

  !this.fileName = !fnam
endmethod


define method .startUpgrade()

  -- Start at WORL
  trace off
--  alpha log /cgeocataupgrade.log overwrite
  !origin = !!ce
  WORL
  var !catas collect all CATA
  -- Go to first CATA
  do !cata values !catas
    -- Loop through all CATA elements
    -- Collect all PTSS in this CATA
    $!cata
    var !ptssColl collect all PTSS for CE

    -- Process each PTSS
    do !id values !ptssColl
      $!id
      !name = ( flnm )
      !res = !this.errNone
      !unavailable = true
      do !i index !this.map
        if (!this.map[!i].findFirst(!name).unset()) then
          skip	
        endif
        !unavailable = false
        !res = !this.errNoMac
        if (!i eq 1) then
        	 -- get T-shaped sctn CGEO pline definition
      	  !plDef = !this.getTdef(!name)
    	  elseif (!i eq 2) then
        	 -- get I-shaped sctn CGEO pline definition
        	!plDef = !this.getIdef(!name)
        elseif (!i eq 3) then
        	 -- get O-shaped sctn CGEO pline definition
          !plDef = !this.getOdef(!name)
        elseif (!i eq 4) then
        	 -- get C-shaped sctn CGEO pline definition
      	  !plDef = !this.getCdef(!name)
			  elseif (!i eq 5) then
        	 -- get L-shaped sctn CGEO pline definition
        	!plDef = !this.getLdef(!name)
        elseif (!i eq 6) then
        	 -- get RHS-shaped sctn CGEO pline definition
        	!plDef = !this.getRHSdef(!name)
        elseif (!i eq 7) then
        	 -- get Japanese bulb-shaped sctn CGEO pline definition
        	!plDef = !this.getJBdef(!name)
        elseif (!i eq 8) then
        	 -- get German bulb-shaped sctn CGEO pline definition
        	!plDef = !this.getDBdef(!name)
        elseif (!i eq 9) then
        	-- handle other shapes
        	!plDef = !this.getOtherDef(!name)
        endif
        --upgrade the PLINEs
        !res = !this.upgradePLINE(!!ce, !plDef)
        break
      enddo
      if (!unavailable eq false) then
        !name = ( flnm )
        !this.upgraded.append(!name)
        !stat = !this.errorStatus[!res]
        !err = !this.errors[!res]
        !strng = 'CGEO PLINE Upgrade $!stat >>>> $!name - $!err'
        $P $!strng
        !this.recordLog.append(!strng)

      endif
      -- Forget unmapped items
    enddo
  enddo

  !!ce = !origin
  trace on
  --save the catalog changes
  savework
  -- save the log file
  !strng = 'Your Catalogues have now been upgraded.'
  $P   $!strng
  !this.recordLog.append(!strng)
  !f = object FILE(!this.fileName)
  !f.writefile('OVERWRITE', !this.recordLog)
  handle (41,319)
    $p Unable to create log file $!<this.fileName>
  endhandle

  -- Re-enable to list all types that it is possible to upgrade but are not referenced
  -- by any SPRFs
$(  !unupgraded = object ARRAY()
  do !i index !this.map
    do !j value !this.map[!i]
      !unupgraded.append(!j)
    enddo
  enddo
  do !j value !this.upgraded
    !first = !unupgraded.findFirst(!j)
    if (!first.unset().not()) then
      !unupgraded.deleteFrom(!first, 1)	
    endif
  enddo
  !unupgraded.compress()
  !f.writefile('APPEND', !unupgraded)
  handle (41,319)
    $p Unable to append to log file $!<this.filename>
  endhandle
$)
endmethod

define method .getTdef(!name is STRING) is ARRAY
  --set definitions for T-shaped sctn CGEO pline
  !return[1] = |0|
  if (!name eq |/Generic-Tee-Profile/PTSS| ) then
  	!return[2] = |( ATTRIB CPARA[ 2 ] / 2.0 )|
  else
    !return[2] = |( ATTRIB CPARA[ 5 ] - ( ATTRIB CPARA[ 2 ] / 2.0 ) )|
  endif
  if (!name eq |/CISC-PTSS-WT-PRFL|) then
  	!return[2] = |( ATTRIB CPARA[ 5 ] - ( ATTRIB CPARA[ 1 ] / 2.0 ) )|
  	!return[3] = |-Y|
  else
    !return[3] = |X|
  endif
  return !return
endmethod

define method .getIdef(!name is STRING) is ARRAY
  --set definitions for I-shaped sctn CGEO pline
  if (!name eq |/IG-PTSS|) then
  	!return[1] = |(0.5 * ATTRIB CPAR[2])|
  	!return[2] = |(0.5 * ATTRIB CPAR[1])|
  	
  else
    !return[1] = |0|
    !return[2] = |0|
  	
  endif
  !return[3] = |Y|
  return !return
endmethod

define method .getOdef(!name is STRING) is ARRAY
  --set definitions for O-shaped sctn CGEO pline
  !return[1] = |0|
  !return[2] = |0|
  !return[3] = |X|
  return !return
endmethod

define method .getCdef(!name is STRING) is ARRAY
  --set definitions for C-shaped sctn CGEO pline
  if (!name eq '/CG-PTSS') then
  	!return[1] = |( ATTRIB CPARA[ 2 ] * 0.5)|
  	!return[2] = |( ATTRIB CPARA[ 1 ] * 0.5 )|
  else
    !return[1] = |( ( ATTRIB CPARA[ 2 ] / 2.0 ) - ATTRIB CPARA[ 5 ] )|
    !return[2] = |0|
  endif
  !return[3] = |Y|
  return !return
endmethod

define method .getLdef(!name is STRING) is ARRAY
  --set definitions for L-shaped sctn CGEO pline
  if (!name eq '/LP-PTSS') then
  	!return[1] = |(ATTRIB CPARA[ 2 ] * 0.5 )|
  	!return[2] = |(ATTRIB CPARA[ 1 ] * 0.5 )|
    !return[3] = |Y|
  elseif (!name eq '/Generic-Angle-Profile/PTSS') then
  	!return[1] = |(ATTRIB CPARA[ 1 ] / 2.0 )|
  	!return[2] = |( (ATTRIB CPARA[ 2 ] - ATTRIB CPARA[ 3 ] ) / 2.0 )|
    !return[3] = |X|
  elseif (!name eq '/DIN-PTSS-ANG-PLT') then
  	!return[1] = |(- ATTRIB CPARA[ 5 ] + (ATTRIB CPARA[ 2 ] / 2.0 ) ) |
  	!return[2] = |( (- ATTRIB PARA[ 1 ] - ATTRIB DESP[ 1 ] ) / 2.0 )|
    !return[3] = |Y|
  else
    !return[1] = |( ( ATTRIB CPARA[ 2 ] / 2.0 ) - ATTRIB CPARA[ 5 ] )|
    !return[2] = |( ATTRIB CPARA[ 4 ] - ( ATTRIB CPARA[ 1 ] / 2.0 ) )|
    !return[3] = |Y|
  endif
  return !return
endmethod

define method .getRHSdef(!name is STRING) is ARRAY
  --set definitions for RHS-shaped sctn CGEO pline
  !return[1] = |0|
  !return[2] = |0|
  !return[3] = |Y|
  return !return
endmethod

define method .getJBdef(!name is STRING) is ARRAY
  --set definitions for JB-shaped sctn CGEO pline
  !return[1] = |( ( ( ATTRIB CPARA[ 2 ] + ATTRIB CPARA[ 3 ]  + ATTRIB CPARA[5]) / 2.0 )-ATTRIB CPARA[ 8 ]) |
  !return[2] = |( ATTRIB CPARA[ 7 ] - ( ATTRIB CPARA[ 1 ] / 2.0 ) )|
  !return[3] = |Y|
  return !return
endmethod

define method .getDBdef(!name is STRING) is ARRAY
  --set definitions for DB-shaped sctn CGEO pline
  !return[1] = |( ( ATTRIB CPARA[ 2 ] + ATTRIB CPARA[ 3 ] ) / 2.0 )|
  !return[2] =|( ATTRIB CPARA[ 1 ] / 2.0 )|
  !return[3] = |Y|
  return !return
endmethod

define method .getOtherDef(!name is STRING) is ARRAY
  --set definitions for other type of sctns CGEO pline
  !return[1] = |0|
  !return[2] = |0|
  !return[3] = |Y|
  if (!name eq |/ASL/Hexagonal-Bar/PTSS|) then
  	!return[3] = |X|
  elseif ((!name eq |/FB-PTSS|) or $
          (!name eq |/BG-PTSS|)) then
  	!return[1] = |( 0.5 * ATTRIB CPAR[2])|
  	!return[2] = |( 0.5 * ATTRIB CPAR[1])|
  elseif (!name eq |/TREAD-PTSS|) then
  	!return[1] = |( 0.5 * ATTRIB CPAR[1])|
  	!return[2] = |( 0.5 * ATTRIB CPAR[2])|
  	!return[3] = |X|
  endif

  return !return
endmethod

define method .upgradePLINE(!ref is DBREF, !pldefs is ARRAY) is REAL

  -- Initialisation
  !error  = !this.errNone
  !origin = !ref
  !!ce = !ref
  -- find the existing NA PLIN
  var !na COLLECT ALL PLIN WITH (PKEY eq |NA|) FOR CE

  --check if the CGEO pline has already been created
  VAR !cg COLLECT ALL PLIN WITH (PKEY eq |CGEO|) FOR CE

  if (!na.empty()) then
    --NA does not exist for this type of SCTN. Serious catalog error
    --but is not within this macros remit to fix
    !error = !this.errNoNA	
  endif

  if (!cg.empty().not()) then
  	-- CGEO PLIN has already been defined
  	!error = !this.errAU
 		--delete the existing pline. If for some reason the definition
 		-- of the cgeo has changed it may happen that its not necessary
 		-- any more
 		!!ce = !cg[1].dbref()
 		DELETE PLIN
 		!!ce = !ref
  endif

  $!ref
  handle any
    --should never happen!
    !error = !this.errRefFail
    !!ce = !origin
    return !error
  endhandle
   --find the sprfs that reference this particular NA
  !geos = !!ce.geodep
  if (!geos.empty()) then
    --bail out if nothing references this pline
    !error = !this.errUnref
    !!ce = !origin
    return !error	
  endif
  --now try to find a sprf that references the pline
  !sprf = object DBREF()
  do !aref values !geos
    if (!aref.type eq 'SPRF') then
      !sprf = !aref	
      break
    endif
  enddo
  if (!sprf.unset()) then
		--couldnt find a sprf that references the pline.
    !error = !this.errUnref
    !!ce = !origin
    return !error	
  endif

  -- as cannot evaluate expressions that include design parameters from here
  -- will just skip any tests that include them. Should not happen often as is
  -- bad practice to include design parameter references in catalog definitions
  !skipNATest = FALSE
  if (!!ce.flnm eq '/DIN-PTSS-ANG-PLT') then
  	!skipNATest = true
  endif
  if (!na.empty().not() and !skipNATest.not()) then
    --check the new CGEO PLIN would have the same definition as the NA
    !naDb = !na[1].dbref()

    --evaluate the PX and PY of the NA PLINE
    !naPX = !sprf.evaluate(object block(!naDb.px)).string()
    handle any
      !strng = 'Unable to evaluate expression $!<naDb.px>'
      $P $!strng
      !this.recordLog.append(!strng)
      return !this.errEval
    endhandle
    !naPY = !sprf.evaluate(object block(!naDb.px)).string()
    handle any
      !strng = 'Unable to evaluate expression $!<naDb.py>'
      $P $!strng
      !this.recordLog.append(!strng)
      return !this.errEval
    endhandle
    !naPAX = !naDb.plax

		--evaluate the PX and PY of the desired CGEO PLINE
		!cgeoPX = !sprf.evaluate(object block(!pldefs[1])).string()
		handle any
      !strng = 'Unable to evaluate expression $!<pldefs[1]>'
      $P $!strng
      !this.recordLog.append(!strng)
      return !this.errEval
    endhandle
		!cgeoPY = !sprf.evaluate(object block(!pldefs[2])).string()
    handle any
      !strng = 'Unable to evaluate expression $!<pldefs[2]>'
      $P $!strng
      !this.recordLog.append(!strng)
      return !this.errEval
    endhandle
		!cgeoPAX = !pldefs[3]
		

    if ((!naPX eq !cgeoPX) and $
        (!naPY eq !cgeoPY) and $
        (!naPAX eq !cgeoPAX)) then
       -- new pline would lie exactly on top of NA pline. No need to create
       -- a new one.
      !error = !this.errEQNA
      !!ce = !origin
      return !error
    endif
  endif
  --create new PLINe
	  NEW PLIN $!<this.cpData>
    PKEY CGEO
  PX $!<pldefs[1]> PY $!<pldefs[2]> PLAX $!<pldefs[3]>

  !!ce = !origin
  return !error

endmethod

define method .unhandledSCTNTypes()
--NOT USED BY UPGRADE FUNCTION IN NORMAL OPERATION
  !origin = !!ce
  WORL
  !sctns = object COLLECTION()
  !sctns.type('SPRF')
  !sctns.scope(!!ce)
  !res = !sctns.results()
  !handled = object ARRAY()
  !unhandled = object ARRAY()
  do !i values !res
    !name = !i.pstref.name
    handle any
      skip
    endhandle
		!found = false
    do !j values !handled
      if (!j eq !name) then
        !found = true	
        break
      endif
    enddo
    if (!found) then
    	skip
    endif
    do !k values !unhandled
      if (!k eq !name) then
        !found = true	
        break
      endif
    enddo
    if (!found) then
    	skip
    endif

    do !m values !this.map
     if (!m.findFirst(!name).unset()) then
     	 skip
     else
     	 !handled.append(!name)
     	 !found = true
     	 break
     endif
    enddo
    if (!found) then
   	  skip
    endif
--    $p unable to process $!name
    !unhandled.append(!name)
  enddo
  !unusedO = !handled.size()
  !unusedP = !unhandled.size()
--  $p $!unusedO handled.... $!unusedP unhandled
endmethod
