--
--
-- Description:
-- Object to represent a collection of COCO elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  changeCe(CKYFILTER,DBREF)        -                   Change the database element this represents using a filter
--  changeCe(DBREF)                  -                   Change the element this represents
--  ckyCocoTable(DBREF)              -                   Constructor
--  getCocoElems(DBREF)              ARRAY               Get all COCO elements under DBREF
--  getText(DBREF)                   STRING
--  setFilter(CKYFILTER)             -                   Set the filter this uses
--
------------------------------------------------------------------------

define object CKYCOCOTABLE
  member .cocoTabRef is DBREF

  member .textArray is ARRAY

  member .refIndex is ARRAY

  member .duplicates is ARRAY
endobject
-- End of object definition for CKYCOCOTABLE

------------------------------------------------------------------------
--
-- Method:      .ckyCocoTable(DBREF)
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--    1   R     DBREF       Database element this is to represent
--
------------------------------------------------------------------------

define method .ckyCocoTable(!cocoRef is DBREF)
  !this.changeCe(!cocoRef)
endmethod
-- End of method definition for .ckyCocoTable(DBREF)


------------------------------------------------------------------------
--
-- Method:      .getText(DBREF) is STRING
--
-- Description: Get the text to display for a COCO element
--
-- Method Type: Function
-- Arguments:
--    1   R     DBREF       Database element this is to represent
-- Return:
--    STRING                Text to display for a COCO element
--
------------------------------------------------------------------------

define method .getText(!cocoElem is DBREF) is STRING
  !cKey = !cocoElem.cKey

  if (!cKey eq '') then
    !cKey = 'Unset'
  endif

  var !text COMPOSE |$!cocoElem.cType[1]| WIDTH 9 |$!cocoElem.cType[2]| WIDTH 9 |$!cKey| WIDTH 6 |$!cocoElem.fullName|

  return (!text[1])
endmethod
-- End of method definition for .getText(DBREF) STRING


------------------------------------------------------------------------
--
-- Method:      .getCocoElems(DBREF)
--
-- Description: Get all COCO elements under DBREF
--
-- Method Type: Function
-- Arguments:
--    1   R     DBREF       Database element to collect coco elements
--                          from
-- Return:
--   ARRAY       Array of DBREFs under !cocoRef
--
------------------------------------------------------------------------

define method .getCocoElems(!cocoRef is DBREF) is ARRAY
  !cocoElems = ARRAY()

  if (!cocoRef.set()) then
    !this.duplicates.clear()
    !stringCocoElems = ARRAY()

    -- Move up to CCTA element if necessary
    if (!cocoRef.type neq 'CCTA' and !cocoRef.type neq 'WORL') then
      if (!cocoRef.owner.type eq 'CCTA') then
        !cocoRef = !cocoRef.owner
      endif
    endif

    -- Collect all the COCO elements under !cocoRef
    if (!cocoRef.type eq 'CCTA') then
      var !stringCocoElems COLLECT ALL COCO FOR $!cocoRef

      do !cocoElement values !stringCocoElems
        !cocoElems.append(!cocoElement.dbRef())
      enddo

      !cocoTabs = ARRAY()
      !cocoTabs.append(!cocoRef)
    elseif (!cocoRef.type eq 'WORL') then
      -- Check for duplicates in same coco tables
      var !cocoTabs COLLECT ALL CCTA

      var !stringCocoElems COLLECT ALL COCO

      do !cocoElement values !stringCocoElems
        !cocoElems.append(!cocoElement.dbRef())
      enddo
    else
      !!alert.error('Cannot navigate to element of type CCTA from ' & !cocoRef.fullName)
    endif

    -- Check for duplicates in each CCTABLE
    do !cocoTabString values !cocoTabs

      var !dupCocoElems COLLECT ALL COCO FOR $!cocoTabString

      -- Evaluate CTypes in forward and reverse order (to spot duplicates of the
      -- form (X, Y) and (Y, X)
      var !cTypeList EVALUATE (CTYPE[1] + ' ' + CTYPE[2]) FOR ALL FROM !dupCocoElems
      var !cTypeList2 EVALUATE (CTYPE[2] + ' ' + CTYPE[1]) FOR ALL FROM !dupCocoElems

      !cTypeList.appendArray(!cTypeList2)

      -- Append the array of coco elements to itself to give two parallel
      -- arrays of ctypes and dbrefs
      !dupCocoElems2 = !dupCocoElems
      !dupCocoElems.appendArray(!dupCocoElems2)

      -- Sort these two arrays by ctype
      !sortIndex = !cTypeList.sortedIndices()

      !cTypeList.reIndex(!sortIndex)
      !dupCocoElems.reIndex(!sortIndex)

      -- Find adjacent pairs of ctypes which are the same
      do !cTypeIndex indices !cTypeList
        skip if (!cTypeIndex eq !cTypeList.maxIndex())

        -- If ctypes are equal and dbrefs are not then a duplicate has been found
        if (!cTypeList[!cTypeIndex] eq !cTypeList[!cTypeIndex + 1] and $
            !dupCocoElems[!cTypeIndex] neq !dupCocoElems[!cTypeIndex + 1]) then
          !elem1 = !dupCocoElems[!cTypeIndex].dbRef().fullName
          !elem2 = !dupCocoElems[!cTypeIndex + 1].dbRef().fullName

          -- Make sure elem1 and elem2 are output in alphabetical order
          -- so duplicates referenced twice can be easily removed
          if (!elem1 LT !elem2) then
            !this.duplicates.append(!elem1 & ' has the same ctypes as ' & !elem2)
          else
            !this.duplicates.append(!elem2 & ' has the same ctypes as ' & !elem1)
          endif
        endif
      enddo
    enddo

    -- Make sure list of duplicates references each duplicate only once
    !this.duplicates.unique()
  endif

  return !cocoElems
endmethod
-- End of method definition for .getCocoElems(DBREF) ARRAY


------------------------------------------------------------------------
--
-- Method:      .changeCe(DBREF)
--
-- Description: Change the element this represents
--
-- Method Type: Procedure
-- Arguments:
--    1   R     DBREF       New database element for this to represent
--
------------------------------------------------------------------------

define method .changeCe(!cocoRef is DBREF)
  !cocoElemArray = !this.getCocoElems(!cocoRef)
  !this.cocoTabRef = !cocoRef

  !this.textArray.clear()
  !this.refIndex.clear()

  do !cocoElem values !cocoElemArray
    !this.textArray.append(!this.getText(!cocoElem))
    !this.refIndex.append(!cocoElem.name)
  enddo
endmethod
-- End of method definition for .changeCe(DBREF)


------------------------------------------------------------------------
--
-- Method:      .changeCe(ckyFilter,DBREF)
--
-- Description: Change the database element this represents using a filter
--
-- Method Type: Procedure
-- Arguments:
--    1   R     ckyFilter   Filter to use
--    2   R     DBREF       DBREF of new element
--
------------------------------------------------------------------------

define method .changeCe(!filter is CKYFILTER, !cocoRef is DBREF)
  if (!filter.isNull()) then
    -- Faster this way
    !this.changeCe(!cocoRef)
  else
    !cocoElemArray = !this.getCocoElems(!cocoRef)
    !this.cocoTabRef = !cocoRef

    !this.textArray.clear()
    !this.refIndex.clear()

    do !cocoElem values !cocoElemArray
      if (!filter.matches(!cocoElem.cType[1], !cocoElem.cType[2], !cocoElem.cKey)) then
        !this.textArray.append(!this.getText(!cocoElem))
        !this.refIndex.append(!cocoElem.name)
      endif
    enddo
  endif
endmethod
-- End of method definition for .changeCe(CKYFILTER, DBREF)


------------------------------------------------------------------------
--
-- Method:      .setFilter(ckyFilter)
--
-- Description: Set the filter this uses
--
-- Method Type: Procedure
-- Arguments:
--    1   R     ckyFilter   Filter to use
--
------------------------------------------------------------------------

define method .setFilter(!filter is CKYFILTER)
  if (!filter.isNull()) then
    -- Faster this way
    !this.changeCe(!this.cocoTabRef)
  else
    !cocoElemArray = !this.getCocoElems(!this.cocoTabRef)
    !this.textArray.clear()
    !this.refIndex.clear()

    do !cocoElem values !cocoElemArray
      if (!filter.matches(!cocoElem.cType[1], !cocoElem.cType[2], !cocoElem.cKey)) then
        !this.textArray.append(!this.getText(!cocoElem))
        !this.refIndex.append(!cocoElem.name)
      endif
    enddo
  endif
endmethod
-- End of method definition for .setFilter(CKYFILTER)
