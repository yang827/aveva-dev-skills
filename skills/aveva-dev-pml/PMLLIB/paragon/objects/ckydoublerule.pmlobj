------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(DBREF)                     BOOLEAN
--  ckyDoubleRule(STRING,STRING,STRING) -
--  getCKey()                        STRING
--  getText()                        STRING
--  print(ARRAY,STRING)              -
--
define object CKYDOUBLERULE
  member .conn1 is STRING
  member .conn2 is STRING
  member .cKey  is STRING
endobject
-- End of object definition for CKYDOUBLERULE

define method .ckyDoubleRule(!theConn1 is STRING,!theConn2 is STRING,!theCKey is STRING)
  if (!theConn1 lt !theConn2) then
    !this.conn1 = !theConn1
    !this.conn2 = !theConn2
  else
    !this.conn1 = !theConn2
    !this.conn2 = !theConn1
  endif

  !this.cKey  = !theCKey
endmethod
-- End of method definition for .ckyDoubleRule(STRING,STRING,STRING)

define method .apply(!cocoElem is DBREF) is BOOLEAN
  !applied = FALSE

  if (trim(!this.cKey) neq '') then
    if (not !cocoElem.cType.find(!this.conn1).unset() and $
        not !cocoElem.cType.find(!this.conn2).unset()) then
      !oldCe = !!ce
      !!ce = !cocoElem

      CKEY $!this.cKey

      !!ce = !oldCe

      !applied = TRUE
    endif
  endif

  return !applied
endmethod
-- End of method definition for .apply(DBREF) BOOLEAN

define method .getText() is STRING
  return !this.conn1 & '   ' & !this.conn2
endmethod
-- End of method definition for .getText() STRING

define method .getCKey() is STRING
  return !this.cKey
endmethod
-- End of method definition for .getCKey() STRING

define method .print(!output is ARRAY, !objectName is STRING)
  !output.append(!objectName & | = OBJECT ckyDoubleRule('| & $
                 !this.conn1 & |','| & !this.conn2 & |','| & !this.cKey & |')|)
endmethod
-- End of method definition for .print(ARRAY, STRING)
