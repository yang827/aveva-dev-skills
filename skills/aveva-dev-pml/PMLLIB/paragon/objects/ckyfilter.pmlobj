-- Created:         Wed Jul 8 09:13:44 BST 1998
--
--
-- Description:
-- Filter for coco elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  ckyFilter()                      -                   Constructor
--  ckyFilter(STRING,STRING)         -                   Constructor
--  isNull()                         BOOLEAN             Returns TRUE if this filter lets everything through
--  matches(STRING,STRING,STRING)    BOOLEAN
--
------------------------------------------------------------------------

define object CKYFILTER
  member .cType1 is STRING
  member .cType2 is STRING

  member .useAnd is BOOLEAN

  member .pl is BOOLEAN
  member .fl is BOOLEAN
  member .bw is BOOLEAN
  member .sw is BOOLEAN
  member .cp is BOOLEAN
  member .sc is BOOLEAN
  member .unset is BOOLEAN
endobject
-- End of object definition for CKYFILTER


------------------------------------------------------------------------
--
-- Method:      .ckyFilter()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------

define method .ckyFilter()
  -- Initially let everything through
  !this.cType1 = '*'
  !this.cType2 = '*'
  !this.useAnd = TRUE

  !this.pl = TRUE
  !this.fl = TRUE
  !this.bw = TRUE
  !this.sw = TRUE
  !this.cp = TRUE
  !this.sc = TRUE
  !this.unset = TRUE
endmethod
-- End of method definition for .ckyFilter()


------------------------------------------------------------------------
--
-- Method:      .ckyFilter(STRING,STRING)
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--    1   R     STRING      CType 1
--    2   R     STRING      CType 2
--
------------------------------------------------------------------------

define method .ckyFilter(!ct1 is STRING, !ct2 is STRING)
  !this.cType1 = !ct1
  !this.cType2 = !ct2
  !this.useAnd = TRUE

  !this.pl = TRUE
  !this.fl = TRUE
  !this.bw = TRUE
  !this.sw = TRUE
  !this.cp = TRUE
  !this.sc = TRUE
  !this.unset = TRUE
endmethod
-- End of method definition for .ckyFilter(STRING, STRING)


------------------------------------------------------------------------
--
-- Method:      .matches(STRING,STRING,STRING) is BOOLEAN
--
-- Description: Returns TRUE if ctypes and ckey match this filter
--
-- Method Type: Function
-- Arguments:
--    1   R     STRING      CType 1
--    1   R     STRING      CType 2
--    1   R     STRING      CKey
-- Return:
--   BOOLEAN    TRUE if ctypes and ckey match this filter
--
------------------------------------------------------------------------

define method .matches(!ct1 is STRING, !ct2 is STRING, !ck is STRING) is BOOLEAN
  if (!this.useAnd) then
    !cTypesMatch = !ct1.matchWild(!this.cType1) and !ct2.matchWild(!this.cType2)
  else
    !cTypesMatch = !ct1.matchWild(!this.cType1) or !ct2.matchWild(!this.cType2)
  endif

  !cKeyMatch = !ck EQ 'PL' and !this.pl or !ck EQ 'FL' and !this.fl or !ck EQ 'BW'and !this.bw or !ck EQ 'SW'and !this.sw or !ck EQ 'CP'and !this.cp or !ck EQ 'SC'and !this.sc or !ck EQ ''and !this.unset

  return (!cTypesMatch and !cKeyMatch)
endmethod
-- End of method definition for .matches(STRING, STRING, STRING) BOOLEAN


------------------------------------------------------------------------
--
-- Method:      .isNull()
--
-- Description: Returns TRUE if this filter lets everything through
--
-- Method Type: Function
-- Arguments:
--
-- Return:
--   BOOLEAN    TRUE if this filter lets everything through
--
------------------------------------------------------------------------

define method .isNull() is BOOLEAN
  return (!this.cType1 eq '*' and !this.cType2 eq '*' and !this.pl and !this.fl and !this.bw and !this.sw and !this.cp and !this.sc and !this.unset)
endmethod
-- End of method definition for .isNull() BOOLEAN
