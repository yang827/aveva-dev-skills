------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addToTop(ANY)                    -
--  apply(DBREF)                     -
--  getIndices(BOOLEAN)              ARRAY
--  getText(BOOLEAN)                 ARRAY
--  moveDown(REAL)                   REAL
--  moveToBottom(REAL)               REAL
--  moveToTop(REAL)                  REAL
--  moveUp(REAL)                     REAL
--  print(ARRAY,STRING)              -
--
define object CKYRULEARRAY
  member .ruleArray is ARRAY
endobject
-- End of object definition for CKYRULEARRAY

define method .apply(!dbRef is DBREF)
  do !rule values !this.ruleArray
    break if (!rule.apply(!dbRef))
  enddo
endmethod
-- End of method definition for .apply(DBREF)

define method .moveToTop(!index is REAL) is REAL
  !tmpRule = !this.ruleArray[!index]
  !this.ruleArray.remove(!index)
  !this.addToTop(!tmpRule)

  return !this.ruleArray.minIndex()
endmethod
-- End of method definition for .moveToTop(REAL) REAL

define method .moveToBottom(!index is REAL) is REAL
  !tmpRule = !this.ruleArray[!index]
  !this.ruleArray.remove(!index)
  !this.ruleArray.append(!tmpRule)

  return !this.ruleArray.maxIndex()
endmethod
-- End of method definition for .moveToBottom(REAL) REAL

define method .moveUp(!index is REAL) is REAL
  !newIndex = !index

  if (!newIndex neq !this.ruleArray.minIndex()) then
    !newIndex = !newIndex - 1
    !tmpRule = !this.ruleArray[!index]
    !this.ruleArray.deleteFrom(!index,1)
    !this.ruleArray[!index] = !this.ruleArray[!newIndex]
    !this.ruleArray.deleteFrom(!newIndex,1)
    !this.ruleArray[!newIndex] = !tmpRule
  endif

  return !newIndex
endmethod
-- End of method definition for .moveUp(REAL) REAL

define method .moveDown(!index is REAL) is REAL
  !newIndex = !index

  if (!newIndex neq !this.ruleArray.maxIndex()) then
    !newIndex = !newIndex + 1
    !tmpRule = !this.ruleArray[!index]
    !this.ruleArray.deleteFrom(!index,1)
    !this.ruleArray[!index] = !this.ruleArray[!newIndex]
    !this.ruleArray.deleteFrom(!newIndex,1)
    !this.ruleArray[!newIndex] = !tmpRule
  endif

  return !newIndex
endmethod
-- End of method definition for .moveDown(REAL) REAL

define method .addToTop(!rule is ANY)
  !this.ruleArray.insert(!this.ruleArray.minIndex(),!rule)
endmethod
-- End of method definition for .addToTop(ANY)

define method .getText(!hideRules is BOOLEAN) is ARRAY
  !result = ARRAY()

  do !rule values !this.ruleArray
    if (!rule.cKey eq '' or not !hideRules) then
      !result.append(!rule.getText())
    endif
  enddo

  return !result
endmethod
-- End of method definition for .getText(BOOLEAN) ARRAY

define method .getIndices(!hideRules is BOOLEAN) is ARRAY
  !result = ARRAY()

  do !ruleIndex indices !this.ruleArray
    if (!this.ruleArray[!ruleIndex].cKey eq '' or not !hideRules) then
      !result.append(string(!ruleIndex))
    endif
  enddo

  return !result
endmethod
-- End of method definition for .getIndices(BOOLEAN) ARRAY

define method .print(!output is ARRAY,!objectName is STRING)
  do !rule values !this.ruleArray
    !rule.print(!output,'!rule')
    !output.append(!objectName & '.ruleArray.append(!rule)')
    !output.append('!rule.delete()')
  enddo
endmethod
-- End of method definition for .print(ARRAY,STRING)
