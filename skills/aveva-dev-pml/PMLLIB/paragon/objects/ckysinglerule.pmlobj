------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply(DBREF)                     BOOLEAN
--  ckySingleRule(STRING,STRING)     -
--  getCKey()                        STRING
--  getText()                        STRING
--  print(ARRAY,STRING)              -
--
define object CKYSINGLERULE
  member .conn is STRING
  member .cKey  is STRING
endobject
-- End of object definition for CKYSINGLERULE

define method .ckySingleRule(!theConn is STRING,!theCKey is STRING)
  !this.conn = !theConn
  !this.cKey  = !theCKey
endmethod
-- End of method definition for .ckySingleRule(STRING,STRING)

define method .apply(!cocoElem is DBREF) is BOOLEAN
  !applied = FALSE

  if (trim(!this.cKey) neq '') then
    if (not !cocoElem.cType.find(!this.conn).unset()) then
      !oldCe = !!ce
      !!ce = !cocoElem

      CKEY $!this.cKey

      !!ce = !oldCe

      !applied = TRUE
    endif
  endif

  return !applied
endmethod
-- End of method definition for .apply(DBREF) BOOLEAN

define method .getText() is STRING
  return !this.conn
endmethod
-- End of method definition for .getText() STRING

define method .getCKey() is STRING
  return !this.cKey
endmethod
-- End of method definition for .getCKey() STRING

define method .print(!output is ARRAY, !objectName is STRING)
  !output.append(!objectName & | = OBJECT ckySingleRule('| & $
                 !this.conn & |','| & !this.cKey & |')|)
endmethod
-- End of method definition for .print(ARRAY, STRING)
