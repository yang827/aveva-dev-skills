  -- Pass modelCellUpdate event to controlling object
  !!catModelViews.categoryCellUpdate(!this.form, !data)

endmethod
-- End of method definition for .modelCellUpdate(ARRAY)

------------------------------------------------------------------------
--
-- Method:     afterCellUpdate
--
-- Description: Process selection in grid control for related form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Grid data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .afterCellUpdate(!data is ARRAY)

    !forceupdate = false
    if (!this.form.cellSelected[0] eq '') then
        -- Temporarily disable events to prevent a second 'BeforeCellUpdate' event being generated by
        -- the call to setCellValue
        !this.form.cateTable.allGridEvents(false)
        !this.form.cateTable.setCellValue(!this.form.cellSelected[1].real(),1,!this.form.cellReference.string())
        !this.form.cateTable.allGridEvents(true)

        !this.form.forceCellValue = TRUE
        !forceupdate = true
    endif
    handle (2,752)
    endhandle
    if (!this.form.forceCellValue eq true) then
    	--update the form with the new name
      !!catSetCateReferences(!this.form.compAttribList,'SELECT')
    endif
    if (!this.form.updateCellVal ) then
    	  !whichParam = !this.form.cateTable.getcolumns().findfirst(!this.form.cellSelected[2])
        !this.form.cateTable.setCellValue(!this.form.cellSelected[1].real(),!whichParam,!this.form.cellSelected[0].string())
        !this.form.updateCellVal = false
        --update the form with the new parameter values
        !!catSetCateReferences(!this.form.compAttribList,'SELECT')
    endif
    handle (2,752)
    endhandle
    if (!forceupdate eq false) then
    	!this.form.forceCellValue = false
    endif
endmethod

