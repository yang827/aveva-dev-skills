------------------------------------------------------------------------
--
-- Method:      modelCellUpdate
--
-- Description: Process selection in grid control for related form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Grid data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

