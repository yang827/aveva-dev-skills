--
-- Description:
-- Object for redirecting C# control events when using forms with multiple instances
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  afterCellUpdate(ARRAY)           -                   Process selection in grid control for related form
--  eventClick(FORM)                 -                   Constructor
--  modelAfterSelect(ARRAY)          -                   Process selection in grid control for related form
--  modelCellUpdate(ARRAY)           -                   Process selection in grid control for related form
--  modelParampopup(ARRAY)           -                   Process selection in grid control for related form
--  modelResultsSelected(ARRAY)      -                   Process selection in search control for related form
--  modelViewResultsSelected(ARRAY)  -                   Process selection in search control for related form
--  parameterCellUpdate(ARRAY)       -                   Process selection in grid control for related form
--  partAfterSelect(ARRAY)           -                   Process selection in grid control for related form
--  partResultsSelected(ARRAY)       -                   Process selection in search control for related form
--  partRightClick(ARRAY)            -                   Process selection in grid control for related form
--  selTabAfterSelect(ARRAY)         -                   Process selection in grid control for related form
--  selTabResultsSelected(ARRAY)     -                   Process selection in search control for related form
--  selTabRightClick(ARRAY)          -                   Process selection in grid control for related form
--  specAfterSelect(ARRAY)           -                   Process selection in grid control for related form
--  specAfterUpdateTableSelect(ARRAY) -                   Process selection in grid control for component update
--  specRefListSelect(ARRAY)         -                   Process selection in ref list grid control for spec form
--  specResultsSelected(ARRAY)       -                   Process selection in search control for related form
--  specRightClick(ARRAY)            -                   Process selection in grid control for related form
--  vertexAfterSelect(ARRAY)         -                   Process selection in grid control for related form
--  vertexCellUpdate(ARRAY)          -                   Process selection in grid control for related form
--
------------------------------------------------------------------------

-- Define object
define object EVENTCLICK

  -- Form
  member .form       is FORM

endobject
-- End of object definition for eventClick

------------------------------------------------------------------------
--
-- Method:      eventClick
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FORM        Form on which C# control right click is to be actioned
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .eventClick(!form is FORM)

  -- Store form
  !this.form = !form

endmethod
-- End of method definition for .eventClick(ARRAY)

------------------------------------------------------------------------
