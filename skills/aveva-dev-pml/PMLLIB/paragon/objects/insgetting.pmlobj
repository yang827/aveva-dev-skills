--
-- Description:
--   Object getting information related to insulation
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getAllInscmg()                   ARRAY               Getting all insulation component groups
--  getAllInsmat()                   ARRAY               Getting all insulation material elements
--  getAllInsuf()                    ARRAY               Getting all insulation fixing elements
--  getInscmgPoint()                 BOOLEAN             Getting Insulation component groups point
--  getInscmpList(DBREF,STRING)      ARRAY
--  getInsulationPoint()             BOOLEAN             Getting Paint Code point
--  insgetting()                     -                   Constructor
--
------------------------------------------------------------------------

define object INSGETTING
   member .cataPoint         is  ARRAY
   member .prtwldPoint       is  ARRAY
   member .spwldPoint        is  ARRAY
   member .insmatPoint       is  ARRAY
   member .inscmgPoint       is  ARRAY

   member .debug             is  BOOLEAN
endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      insgetting()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .insgetting()

  !this.debug = FALSE
  if (defined(!!debug) ) then
    !this.debug = TRUE
  endif

endmethod
-- End of method definition for .insgetting()

------------------------------------------------------------------------
--
-- Method:      .getInsulationPoint()
--
-- Description: Getting all INSMAT containers
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getInsulationPoint() is BOOLEAN

   !this.insmatPoint = object ARRAY()
   !insmatall = object ARRAY()

   do !idx index !this.cataPoint
     var !insertpoint collect all SECT with PURP eq 'INSM' for $!this.cataPoint[$!idx]
     !insmatall.appendArray(!insertpoint)
   enddo

   if (!insmatall.unset() OR !insmatall.size().eq(0)) then
       return FALSE
   else
       !this.insmatPoint = !insmatall
       return TRUE
   endif

endmethod
-- End of method definition for .getInsulationPoint()

------------------------------------------------------------------------
--
-- Method:      .getInscmgPoint()
--
-- Description: Getting Insulation component groups point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getInscmgPoint() is BOOLEAN

   !this.inscmgPoint = object ARRAY()
   !inscmgall = object ARRAY()

   do !idx index !this.cataPoint
      var !insertpoint collect all SECT with PURP eq 'INSC' for $!this.cataPoint[$!idx]
      !inscmgall.appendArray(!insertpoint)
   enddo

   if (!inscmgall.unset() OR !inscmgall.size().eq(0)) then
       return FALSE
   else
       !this.inscmgPoint = !inscmgall
       return TRUE
   endif

endmethod
-- End of method definition for .getInscmgPoint()

------------------------------------------------------------------------
--
-- Method:      .getAllInsmat()
--
-- Description: Getting all INSMAT elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getAllInsmat() is ARRAY
-- Currently restricted to single CATE or SECT - needs to handle multiples!
   !allInsmats = object ARRAY()
   do !idx index !this.insmatPoint
      !scope = !this.insmatPoint[!idx].dbref()
      var !rtnArray collect all INSMAT for $!scope
      !allInsmats.appendArray(!rtnArray)
   enddo

   return !allInsmats

endmethod
-- End of method definition for .getAllInsmat()

------------------------------------------------------------------------
--
-- Method:      .getAllInsuf()
--
-- Description: Getting all INSUF elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getAllInsuf() is ARRAY
-- Currently restricted to single CATE or SECT - needs to handle multiples!
   !allInsufs = object ARRAY()
   do !idx index !this.insmatPoint
      !scope = !this.insmatPoint[!idx].dbref()
      var !rtnArray collect all INSUF for $!scope
      !allInsufs.appendArray(!rtnArray)
   enddo

   return !allInsufs

endmethod
-- End of method definition for .getAllInsuf()

------------------------------------------------------------------------
--
-- Method:      .getAllInscmg()
--
-- Description: Getting all insulation component groups
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getAllInscmg() is ARRAY

   if (!this.debug) then
      WRITE |Running insGetting.getAllInscmg()|
   endif

-- Currently restricted to single CATA or SECT - needs to handle multiples!
   !allinsu = object ARRAY()
   do !idx index !this.inscmgPoint
      !scope = !this.inscmgPoint[!idx].dbref()
      var !rtnArray collect all INSCMG for $!scope
      !allinsu.appendArray(!rtnArray)
   enddo

   return !allinsu

endmethod
-- End of method definition for .getAllInscmg()

------------------------------------------------------------------------
--
-- Method:      .getInscmpList()
--
-- Description: Getting all insulation components in given group
--              and with given purpose
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getInscmpList( !currentInscmg is DBREF, !purp is STRING  ) is ARRAY
  if (!this.debug) then
      WRITE |Running insGetting.getInscmpList()|
      q var !currentInscmg
      q var !purp
  endif
  !list = object ARRAY()

  -- Collect insulation components
  var !rtnArray collect all INSCMP with PURP eq !purp for $!currentInscmg
  !list.appendArray(!rtnArray)

  return !list
endmethod
