-- Created:         Thu Jan 25 09:46:16 BST 2007
--
--
-- Description:
-- Build parts from catalog
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  build(DBREF)                     -                   Build parts family
--  buildParts(DBREF,DBREF)          -                   Build parts family
--  partsFromCata(DBREF)             -                   Constructor
--
------------------------------------------------------------------------

-- Define object
define object partsFromCata

  -- Catalogue/Section/Category
  member .me              is DBREF

  -- Owning part world/element
  member .owner           is DBREF

  -- Top level part element that gets created
  member .newTopLevel     is DBREF

  -- Sections
  member .sections        is ARRAY

  -- Categories
  member .categories      is ARRAY

  -- Texts
  member .texts           is ARRAY

  -- Scoms
  member .scoms           is ARRAY

endobject
-- End of object definition for partsFromCata

------------------------------------------------------------------------
--
-- Method:      partsFromCata
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Source element to build parts from
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .partsFromCata(!me is DBREF)

  -- Build data
  if (not !me.type inset(|CATA|, |SECT|, |CATE|)) then
    return error 1 |Catalogue or Section or Category required|
  endif
  !this.me = !me
  do !item values !me.members
    if (!item.type eq |SECT|) then
      !this.sections.append(object partsFromCata(!item))
    elseif (!item.type eq |CATE|) then
      !this.categories.append(object partsFromCata(!item))
    elseif (!item.type eq |SDTE|) then
      !this.texts.append(!item.rtex)
    elseif (!item.type eq |TEXT|) then
      !this.texts.append(!item.stex)
    elseif (!item.type eq |SCOM|) then
      !this.scoms.append(!item)
    endif
  enddo

endmethod
-- End of method definition for .partsFromCata(DBREF)

------------------------------------------------------------------------
--
-- Method:      build
--
-- Description: Build parts family
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Owning element to build part family under
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .build(!owner is DBREF)

  -- Build part family
  if (not !owner.type inset(|PRTWLD|, |PRTELE|)) then
    return error 1 |Part world or part element required|
  endif
  !this.owner = !owner
  !this.buildParts(!this.owner, !this.owner)
  !!ce = !this.newTopLevel

endmethod
-- End of method definition for .build(DBREF)

------------------------------------------------------------------------
--
-- Method:      buildParts
--
-- Description: Build parts family
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Owning part world/element at this level
--    2   R      DBREF       Owning part world/element where build invoked
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .buildParts(!parent is DBREF, !owner is DBREF)

  -- Build part family
  !!ce = !parent
  !endOfCommand = ||
  if (!!ce.members.empty().not()) then
    !endOfCommand = | after last member|
  endif
  !name = !this.me.name & |-prtele|
  new prtele $!endOfCommand
  name $!name
  handle any
    -- Leave unnamed
  endhandle
  !prtele = !!ce
  if (!parent eq !owner) then
    !this.newTopLevel = !!ce
  endif

  -- Build part elements
  do !section values !this.sections
    !section.buildParts(!prtele, !owner)
  enddo
  do !category values !this.categories
    !category.buildParts(!prtele, !owner)
  enddo
  !!ce = !prtele
  if (defined(!this.texts[1])) then
    !!ce.description = !this.texts[1]
  endif

  -- Build parts
  do !scom values !this.scoms
    !!ce = !prtele
    !endOfCommand = ||
    if (!!ce.members.empty().not()) then
      !endOfCommand = | after last member|
    endif
    !name = !scom.name & |-part|
    new gpart $!endOfCommand
    name $!name
    handle any
      -- Leave unnamed
    endhandle
    !!ce.catref = !scom
  enddo

endmethod
-- End of method definition for .buildParts(DBREF)
