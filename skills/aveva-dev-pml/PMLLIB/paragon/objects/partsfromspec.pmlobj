--
--
-- Description:
-- Build parts from spec
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  build(DBREF)                     -                   Build parts family
--  buildParts(DBREF,BOOLEAN,REAL,STRING) -                   Build parts family for each type in spec
--  partsFromSpec(DBREF)             -                   Constructor
--
------------------------------------------------------------------------

-- Define object
define object partsFromSpec

  -- Spec/Sele
  member .me              is DBREF

  -- Owning part world/element
  member .owner           is DBREF

  -- Top level part element that gets created
  member .newTopLevel     is DBREF

  -- Selectors
  member .selectors       is ARRAY

  -- Texts
  member .texts           is ARRAY

  -- Spcoms
  member .spcoms          is ARRAY

endobject
-- End of object definition for partsFromSpec

------------------------------------------------------------------------
--
-- Method:      partsFromSpec
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .partsFromSpec(!me is DBREF)

  -- Build data
  if (not !me.type inset(|SPEC|, |SELE|)) then
    return error 1 |Spec or Sele required|
  endif
  !this.me = !me
  do !item values !me.members
    if (!item.type eq |SELE|) then
      !this.selectors.append(object partsFromSpec(!item))
    elseif (!item.type eq |TEXT|) then
      !this.texts.append(!item.stex)
    elseif (!item.type eq |SPCO|) then
      !this.spcoms.append(!item)
    endif
  enddo

endmethod
-- End of method definition for .partsFromSpec()

------------------------------------------------------------------------
--
-- Method:      build
--
-- Description: Build parts family
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Owning element to build part family under
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .build(!owner is DBREF)

  -- Build part family
  if (not !owner.type inset(|PRTWLD|, |PRTELE|)) then
    return error 1 |Part world or part element required|
  endif
  !this.owner = !owner
  !!ce = !this.owner
  !endOfCommand = ||
  if (!!ce.members.empty().not()) then
    !endOfCommand = | after last member|
  endif
  !name = !this.me.name & |-prtele|
  new prtele $!endOfCommand
  name $!name
  handle any
    -- Leave unnamed
  endhandle
  !this.newTopLevel = !!ce
  !prtele = !!ce
  if (defined(!this.texts[1])) then
    !prtele.description = !this.texts[1]
  endif
  !partCount = 0
  do !sele values !this.selectors
    !sele.buildParts(!prtele, true, !partCount, !this.me.name & |-| & !this.me.ques)
  enddo
  !!ce = !this.newTopLevel

endmethod
-- End of method definition for .build(DBREF)

------------------------------------------------------------------------
--
-- Method:      buildParts
--
-- Description: Build parts family for each type in spec
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define method
define method .buildParts(!parent is DBREF, !level is BOOLEAN, !partCount is REAL, !parentDesc is STRING)

  -- Build part family
  !!ce = !parent
  !answer = !this.me.tans
  if (!answer.empty()) then
    !answer = !this.me.answ.string()
  endif
  !description = !parentDesc & |-| & !answer & |-| & !this.me.ques
  if (!level) then
    !endOfCommand = ||
    if (!!ce.members.empty().not()) then
      !endOfCommand = | after last member|
    endif
    !name = !parent.name.substring(-7) & !answer & |-prtele|
    new prtele $!endOfCommand
    name $!name
    handle any
      -- Leave unnamed
    endhandle
  endif
  !prtele = !!ce

  -- Build part elements
  do !sele values !this.selectors
    !sele.buildParts(!prtele, false, !partCount, !description)
  enddo

  -- Build parts
  do !spco values !this.spcoms
    !!ce = !prtele
    !endOfCommand = ||
    if (!!ce.members.empty().not()) then
      !endOfCommand = | after last member|
    endif
    !answer = !spco.tans
    if (!answer.empty()) then
      !answer = !spco.answ.string()
    endif
    !partCount = !partCount + 1
    !name = !prtele.name.substring(-7) & !partCount
    new gpart $!endOfCommand
    name $!name
    handle any
      -- Leave unnamed
    endhandle
    !!ce.description = !description & |-| & !answer
    if (!spco.catref.set()) then
      !!ce.catref = !spco.catref
    endif
    if (!spco.detref.set()) then
      !!ce.detref = !spco.detref
    endif
    if (!spco.matxt.set()) then
      !!ce.matxt  = !spco.matxt
    endif
    if (!spco.cmpref.set()) then
      !!ce.cmpref = !spco.cmpref
    endif
    if (!spco.bltref.set()) then
      !!ce.bltref = !spco.bltref
    endif
    if (!spco.tmpref.set()) then
      !!ce.tmpref = !spco.tmpref
    endif
  enddo

endmethod
-- End of method definition for .buildParts()
