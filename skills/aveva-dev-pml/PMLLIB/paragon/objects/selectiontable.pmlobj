--
--  Description:     Manipulate selection table in database.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkNewQuesPurp(STRING)         BOOLEAN             Check for invalid or duplicate question purpose.
--  choose(ARRAY,ARRAY,STRING,BOOLEAN) ARRAY               Choose table items in Design.
--  choose(DBREF,ARRAY,ARRAY,STRING,BOOLEAN) ARRAY               Choose table items in Design.
--  choose(DBREF,STRING,BOOLEAN)     ARRAY               Choose table items in Design.
--  choose(STRING,BOOLEAN)           ARRAY               Choose table items in Design.
--  chooseItems(DBREF,ARRAY,ARRAY,BOOLEAN) ARRAY               Choose table items in Design.
--  chooseSpecificItem(DBREF,STRING) ARRAY               Return item details for the given item without filtering
--  convertItemToString(ARRAY)       ARRAY
--  copyItems(ARRAY)                 ARRAY               Copy items to the end of the table
--  createTable()                    DBREF               Create a new table in the database
--  createTable(STRING)              DBREF               Create a new table in the database
--  deleteItems(ARRAY)               -                   Delete items from the table
--  deleteQuestion(DBREF)            -                   Delete specified question
--  deleteQuestion(REAL)             -
--  deleteQuestion(STRING)           -                   Delete specified question
--  deleteType()                     -                   Delete the current cTable from selection table group
--  getAnswer(DBREF,REAL)            ARRAY               Get answer details for the specified item & answer
--  getAnswer(DBREF,STRING)          ARRAY               Get answer detail for specified table item and purpose for display.
--  getAnswerRaw(DBREF,REAL)         ARRAY               Get answer details for the specified item & answer
--  getAnswers(DBREF)                ARRAY               Get answer details for specified table item for display.
--  getDefaultRaw(DBREF)             ARRAY               Get default answer for the specified question
--  getDesAttributes(DBREF)          ARRAY               Returns all Attribute questions
--  getItem(DBREF)                   ARRAY               Get item details for the specified table item, including
--  getItem(REAL)                    ARRAY               Get item details for specified item index for display, including
--  getItemCount()                   REAL                Get total number of items in table
--  getItemName(DBREF)               STRING              Get item name
--  getItemName(REAL)                STRING              Get item name
--  getItemRaw(DBREF,ARRAY)          ARRAY               Get item details for the specified table item, including
--  getItemRaw(DBREF,ARRAY,ARRAY)    ARRAY               Get item details for the specified table item, including
--  getItems()                       ARRAY               Get item details of all items in table for display, including
--  getQuestion(DBREF)               ARRAY               Get attributes for the specified question
--  getQuestion(REAL)                ARRAY
--  getQuestion(STRING,STRING)       ARRAY               Get details for the question with the specified attribute value
--  getQuestionCount()               REAL
--  getQuestionIndex(STRING,STRING)  REAL                Get question index for specified purpose.
--  getQuestionRaw(DBREF)            ARRAY               Get attributes for the specified question
--  getQuestions()                   ARRAY               Returns Headings as an array of arrays
--  getQuestions(STRING)             ARRAY               Returns specified attribute for all questions in heading
--  getTableAtts()                   ARRAY
--  getType()                        STRING              get the current selection table type
--  getTypeAtts()                    ARRAY               Get attributes for the current type
--  getTypeCount()                   REAL                Get number of types in the selection table
--  getTypes()                       ARRAY               Get all selection table types
--  newItems(ARRAY)                  ARRAY               Add new items to the end of the table
--  newItems(ARRAY,REAL)             ARRAY               Add new items at specified index in the table
--  newQuestion(STRING)              REAL                Create new heading question at the specified index position
--  newType()                        REAL                Create a new cTable in the database and make it the current type
--  newType(STRING,STRING,STRING)    REAL                Create a new cTable in the database and make it the current type
--  reorderQuestion(REAL,REAL)       -
--  select(DBREF,DBREF)              -                   Select table items in Design.
--  selectionTable(DBREF)            -                   Constructor for specified selection table
--  setActive(REAL,BOOLEAN)          ARRAY               Set table item active state.
--  setAnswer(DBREF,REAL,ARRAY)      -                   Set specified answer for specified table item.
--  setHeadingsList()                -                   Sets the headings array for later checking when changing CTABLEs
--  setItemAtts(DBREF,ARRAY)         -                   Set table item attributes.
--  setQuestion(REAL,ARRAY)          -
--  setTableAtts(ARRAY)              -
--  setType(REAL)                    -                   Set the current type to the specified type index
--  setType(STRING)                  -                   Set the index for the current selection table type
--  setTypeAtts(ARRAY)               -                   Set attributes for the current type
--
------------------------------------------------------------------------
define object SELECTIONTABLE

  -- Group attributes
  member .selTable        is DBREF                $*
  member .name            is STRING               $*
  member .description     is STRING               $*
  member .discipline      is STRING               $*
  member .subDiscipline   is STRING               $*
  member .inputBy         is STRING               $*
  member .issue           is STRING               $*
  member .status          is STRING               $*

  -- Group members
  member .cTables         is ARRAY                $*
  member .typeIndex       is REAL                 $*

  -- Table attributes
  member .typeTable       is DBREF                $*

  -- Table members
  member .heading         is DBREF
  member .items           is ARRAY
  member .stdGpartAtts    is ARRAY
  member .headings        is ARRAY
  member .errorCount      is REAL

endobject

------------------------------------------------------------------------
--
-- Method:      selectionTable
--
-- Description: Constructor for specified selection table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Selection table (TABGRO)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectionTable(!table is DBREF)

  -- Check element is a selection table
  if (!table.type ne |TABGRO|) then
    return error 1 |Wrong element type, TABGRO expected!|
  endif

  -- Get selection group details
  !this.selTable = !table
  --if (!table.attribute('ISNAMED')) then
    !this.name = !table.namn
  --else
  --  !this.name = ''
  --endif
  !this.description   = !table.description
  !this.discipline    = !table.sptype
  !this.subDiscipline = !table.purpose
  !this.inputBy       = !table.finputby
  !this.issue         = !table.fissue
  !this.status        = !table.fstatus

  -- Set standard GPART attributes for getItem() methods
  !this.stdGpartAtts[1] = |NAME|
  !this.stdGpartAtts[2] = |PRITYPE|
  !this.stdGpartAtts[3] = |SECTYPE|
  !this.stdGpartAtts[4] = |DESCRIPTION|

  -- Get cTable members
  !this.cTables = !this.selTable.evaluate(object BLOCK('MEM CTABLE'))
  -- Set cTable details
  if (!this.cTables.empty()) then
    !this.setType(0)
  else
    !this.setType(1)
    handle any
    endhandle
  endif

endmethod
-- End of method definition for .selectionTable(DBREF)

------------------------------------------------------------------------
--
-- Method:      setHeadingsList
--
-- Description: Sets the headings array for later checking when changing CTABLEs
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setHeadingsList()

  -- reset error count
  !this.errorCount = 0

  -- Sort through Questions, get a list of headings.
  !questions = !this.getQuestions()
  do !question index !questions
     !this.headings[!question] = !questions[!question][1]
  enddo

endmethod
-- End of method definition for .setHeadingsList()

------------------------------------------------------------------------
--
-- Method:      createTable
--
-- Description: Create a new selection table group in the database
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    DBREF       Reference of new selection table group
--
------------------------------------------------------------------------
define method .createTable() is DBREF

  !name = STRING()
  return !this.createTable(!name)

endmethod
-- End of method definition for .createTable()DBREF

------------------------------------------------------------------------
--
-- Method:      createTable
--
-- Description: Create a new selection table group in the database
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING       Name of selection table group
--
-- Return:
--   [Data Type] [Description]
--    DBREF       Reference of new selection table group
--
------------------------------------------------------------------------
define method .createTable(!name is STRING) is DBREF

  -- Check for correct db node
  if (!!ce.type ne 'SPWL' and !!ce.type ne 'TABGRO') then
    --return error 1 |Wrong element type, TABGRO or CTABLE expected!|
    -- Let the core navigate or handle errors
   SPWL
  endif

  -- Create new table and heading
  NEW TABGRO

  -- Name new table and heading
  if (!name.set() and !name.empty().not()) then
    if (!name.substring(1,1) ne '/') then
      !tableName = '/' & !name
    else
      !tableName = !name
    endif
    NAME $!<tableName>
    handle any
    endhandle
  endif

  -- Initialise selection table with new type
  !this.selectionTable(!!ce)

  return !this.selTable

endmethod
-- End of method definition for .createTable(STRING)DBREF

------------------------------------------------------------------------
--
-- Method:      setTableAtts
--
-- Description: Set selection table group attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of group attributes (all of type STRING)
--                           [1] Name
--                           [2] Description
--                           [3] Discipline
--                           [4] Sub-Discipline
--                           [5] Input by
--                           [6] Issue
--                           [7] Status
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setTableAtts(!attributes is ARRAY)

  -- Remember current element
  !dbpos = !!ce

  -- Navigate to table
  !!ce = !this.selTable

  -- Set name
  if (!attributes[1].empty().not() and !attributes[1].substring(1,1) ne |=|) then
    if (!attributes[1].substring(1,1) ne |/|) then
      !!ce.name = '/' & !attributes[1]
  else
      !!ce.name = !attributes[1]
    endif
  endif
  !this.name = !!ce.namn

  -- Set other attributes
  !!ce.description    = !attributes[2]
  !this.description   = !attributes[2]
  !!ce.sptype         = !attributes[3]
  !this.discipline    = !attributes[3]
  !!ce.purpose        = !attributes[4]
  !this.subDiscipline = !attributes[4]
  !!ce.finputby       = !attributes[5]
  !this.inputBy       = !attributes[5]
  !!ce.fissue         = !attributes[6]
  !this.issue         = !attributes[6]
  !!ce.fstatus        = !attributes[7]
  !this.status        = !attributes[7]

  -- Restore current element
  !!ce = !dbpos

endmethod
-- End of method definition for .setTableAtts(ARRAY)

------------------------------------------------------------------------
--
-- Method:      getTableAtts
--
-- Description: get selection table group attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of group attributes (all of type STRING)
--                [1] Name
--                [2] Description
--                [3] Discipline
--                [4] Sub-Discipline
--                [5] Input by
--                [6] Issue
--                [7] Status
--
------------------------------------------------------------------------
define method .getTableAtts() is ARRAY

  !attributes = ARRAY()
  !attributes.append(!this.name)
  !attributes.append(!this.description)
  !attributes.append(!this.discipline)
  !attributes.append(!this.subDiscipline)
  !attributes.append(!this.inputBy)
  !attributes.append(!this.issue)
  !attributes.append(!this.status)

  return !attributes

endmethod
-- End of method definition for .getTableAtts()ARRAY

-----------------------------------------------------------------------
--
-- Method:      newType
--
-- Description: Create a new cTable in the database and make it the current type
-- This one used from catSelTabViews.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        Type index of new cTable
--
------------------------------------------------------------------------
define method .newType() is REAL

  -- Remember current element
  !dbpos = !!ce

  -- Navigate to appropriate place in hierarchy
  !!ce = !this.selTable
  if (!!ce.mcount ne 0) then
    LAST MEMBER
  endif

  -- Create new table and heading
  NEW CTABLE
    NEW TABHEA
    END
  !typeSequence = !!ce.tysequence

  -- Update object with new cTable
  !this.cTables = !this.selTable.evaluate(object BLOCK('MEM CTABLE'))
  !this.setType(!typeSequence)

  -- Restore current element
  !!ce = !dbpos

  return !typeSequence

endmethod
-- End of method definition for .newType()REAL

------------------------------------------------------------------------
--
-- Method:      newType
--
-- Description: Create a new cTable in the database and make it the current type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    RW     STRING     Prefix of CTABLE name.
--    2    RW     STRING     Current Specification Name.
--    3    RW     STRING     Heading Name for CTABLE.
--
-- Return:
--   [Data Type] [Description]
--    REAL        Type index of new cTable
--
------------------------------------------------------------------------
define method .newType(!prefix is STRING, !specName is STRING, !heading is STRING) is REAL

  -- Remember current element
  !dbpos = !!ce

  -- Navigate to appropriate place in hierarchy
  !!ce = !this.selTable
  if (!!ce.mcount ne 0) then
    LAST MEMBER
  endif

  -- Create new table and heading
  NEW CTABLE
    !!ce.descr = !heading
    --  Remove any spaces in the heading and replace them with underscore characters
    !heading = !heading.trim()
    !heading = !heading.replace(' ','_')

    !!ce.name  = !prefix & '/' & !specName & '/' & !heading
    NEW TABHEA
    END
  !typeSequence = !!ce.tysequence

  -- Update object with new cTable
  !this.cTables = !this.selTable.evaluate(object BLOCK('MEM CTABLE'))
  !this.setType(!typeSequence)

  -- Restore current element
  !!ce = !dbpos

  return !typeSequence

endmethod
-- End of method definition for .newType()REAL

------------------------------------------------------------------------
--
-- Method:      deleteType
--
-- Description: Delete the current cTable from selection table group
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteType()

  -- Check for valid type index
  if (!this.typeIndex eq 0) then
    return error 1 |Type index out of range, current type will not be deleted!|
  endif

  -- Remember current element
  !dbpos = !!ce

  !!ce = !this.typeTable
  DELETE CTABLE

  -- Update object remaining cTable members
  !this.cTables = !this.selTable.evaluate(object BLOCK('MEM CTABLE'))
  -- Set cTable details
  if (!this.cTables.empty()) then
    !this.setType(0)
  else
    !this.setType(1)
  endif

  -- Restore current element (if it has not been deleted!)
  if (!dbpos.badref().not()) then
    !!ce = !dbpos
  endif

endmethod
-- End of method definition for .deleteType()

------------------------------------------------------------------------
--
-- Method:      setType
--
-- Description: Set the current type to the specified type index
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Table type index
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setType(!index is REAL)

  -- Set cTable details
  if (!this.cTables.empty() and !index eq 0) then
    !this.typeIndex = 0
    !this.typeTable = object DBREF()
    !this.heading   = object DBREF()
    !this.items     = object ARRAY()
    -- get headings list for this table
    !this.setHeadingsList()
  elseif (!index gt 0 and !index le !this.cTables.size()) then
    !this.typeIndex = !index
    !this.typeTable = !this.cTables[!index]
    !this.heading = !this.typeTable.evaluate(object BLOCK('TABHEA 1'))
         handle (2,113)
            !this.typeIndex = 0
            !this.typeTable = object DBREF()
            !this.heading   = object DBREF()
            !this.items     = object ARRAY()
             return error 1 |Selection table does not have any headers!|
         endhandle
    -- get headings list for this table
    !this.setHeadingsList()
    -- get items to populate this table
    !this.items = !this.typeTable.evaluate(object BLOCK('MEM TABITE'))
  else

     return error 1 |Selection table type index out of range!|
  endif

endmethod
-- End of method definition for .setType(REAL)

------------------------------------------------------------------------
--
-- Method:      setType
--
-- Description: Set the index for the current selection table type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Table type
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setType(!type is STRING)

  -- Check for valid type
  !types = !this.cTables.evaluate(object BLOCK(|!this.cTables[!evalIndex].description.trim().upcase()|))
  !index = !types.findFirst(!type.trim().upcase())
  if (!index.unset()) then
    return error 1 |Selection table does not contain items of type $!<type>!|
  else
    !this.setType(!index)
  endif

endmethod
-- End of method definition for .setType(STRING)

------------------------------------------------------------------------
--
-- Method:      getType
--
-- Description: get the current selection table type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getType() is STRING

  -- Initialise return string
  !type = STRING()

  -- Get types for current type index
  if (!this.typeIndex ne 0) then
    !type = !this.cTables[!this.typeIndex].description
  endif

  return !type

endmethod
-- End of method definition for .getType()STRING

------------------------------------------------------------------------
--
-- Method:      getTypes
--
-- Description: Get all selection table types
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getTypes() is ARRAY

  -- Initialise return string
  !types = ARRAY()

  -- Get types for current type index
  if (!this.typeIndex ne 0) then
    !types = !this.cTables.evaluate(object BLOCK(|!this.cTables[!evalIndex].description|))
  endif

  return !types

endmethod
-- End of method definition for .getTypes()ARRAY

------------------------------------------------------------------------
--
-- Method:      getTypeCount
--
-- Description: Get number of types in the selection table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        Number of types
--
------------------------------------------------------------------------
define method .getTypeCount() is REAL

  return !this.cTables.size()

endmethod
-- End of method definition for .getTypeCount()REAL

------------------------------------------------------------------------
--
-- Method:      setTypeAtts
--
-- Description: Set attributes for the current type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      Array       Type attributes
--                           [1] Description
--                           [2] Name
--                           [3] Purpose
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setTypeAtts(!attributes is ARRAY)

  -- Check that current type is set
  if (!this.typeIndex ne 0) then

    -- Remember current element
    !dbpos = !!ce
    -- Navigate to cTable
    !!ce = !this.typeTable

    -- Set name
    if (!attributes[2].empty().not() and !attributes[2].substring(1,1) ne |=|) then
      if (!attributes[2].substring(1,1) ne |/|) then
        !!ce.name = '/' & !attributes[2]
      else
        !!ce.name = !attributes[2]
      endif
    endif

    -- Set other attributes
    !!ce.description = !attributes[1]
    !!ce.purpose = !attributes[3]

    -- Restore current element
    !!ce = !dbpos

  endif

endmethod
-- End of method definition for .setTypeAtts(ARRAY)

------------------------------------------------------------------------
--
-- Method:      getTypeAtts
--
-- Description: Get attributes for the current type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of type attributes (all of type STRING)
--                [1] Description
--                [2] Name
--                [3] Purpose
--
------------------------------------------------------------------------
define method .getTypeAtts() is ARRAY

  -- Initialise return array
  !attributes = ARRAY()

  -- Get attributes for current type
  if (!this.typeIndex ne 0) then
    !attributes.append(!this.typeTable.description)
    !attributes.append(!this.typeTable.namn)
    !attributes.append(!this.typeTable.purpose)
  endif

  return !attributes

endmethod
-- End of method definition for .getTypeAtts()ARRAY

------------------------------------------------------------------------
--
-- Method:      newQuestion
--
-- Description: Create new heading question at the specified index position
--              in the heading members list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Purpose for new question
--
-- Return:
--   [Data Type] [Description]
--    REAL        Index position of new question
--
------------------------------------------------------------------------
define method .newQuestion(!purpose is STRING) is REAL

  -- Remember current element
  !dbpos = !!ce

  -- Navigate to correct place in heading members
  !!ce = !this.heading
  if (!!ce.members.size() ne 0) then
    LAST MEMBER
  endif
  -- Create new heading question
  NEW TABHQU
  QTYPE TEXT
  ANSTYPE TEXT
  !!ce.purpose = !purpose
  -- Remember index for return
  !index = !!ce.sequence

  -- Add heading answer to all items in the table
  do !val values !this.items
    -- Navigate to correct place in item members
    !!ce = !val
    if (!!ce.members.size() ne 0) then
      LAST MEMBER
    endif
    -- Create new answer
    NEW TABQUE
    RFLAG SING
    WANSWERS UNSET
    !!ce.purpose = !purpose
  enddo

  -- Restore current element
  !!ce = !dbpos

  return !index

endmethod
-- End of method definition for .newQuestion(STRING)REAL

------------------------------------------------------------------------
--
-- Method:      setQuestion
--
-- Description: Set heading question attributes. and corresponding answer attributes
--              Note: this method will clear the corresponding answer on all table
--                    items if the answer type (ANSTYPE) has changed.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Index of question in the heading members list
--    2   R      ARRAY       Array of attributes to set
--                           [1] Purpose
--                           [2] Description
--                           [3] Question
--                           [4] Question type (TEXT, WORD, EXPR, ATTR)
--                           [5] Default
--                           [6] Answer type (TEXT, WORD, REAL, BOOL)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setQuestion(!index is REAL, !headingVals is ARRAY)

  -- Check for valid type index
  if (!this.typeIndex eq 0) then
    return error 1 |Type index out of range, Question attributes will not be set!|
  endif

  -- Remember current element
  !dbpos = !!ce

  -- Navigate to heading member
  !!ce = !this.heading.members[!index]

  -- Unset all attributes first
  PURPOSE UNSET
  DESCRIPTION UNSET
  QUESTION UNSET
  QUSEXPRESSION UNSET
  TQUESTION UNSET
  QTYPE UNSET
  DEFAULT 0
  TDEFAULT UNSET
  ATTSET NONE
  ANSTYPE TEXT

  -- Set purpose
  if (!headingVals[1].empty().not()) then
    !!ce.purpose = !headingVals[1]
  endif

  -- Set description (if it's not unset)
  if (!headingVals[2].empty().not()) then
    !!ce.description =  !headingVals[2]
  endif

  -- Set question (if it's not unset)
  if (!headingVals[3].empty().not()) then
    if (!headingVals[4] eq |TEXT|) then
      !!ce.tQuestion = !headingVals[3].upcase()
    elseif (!headingVals[4] eq |WORD|) then
      !!ce.question = !headingVals[3].replace(' ','')
    elseif (!headingVals[4] eq |ATTR|) then
      !!ce.attset = !headingVals[3].replace(' ','')
      handle (47,15)
        --!!alert.message(|Invalid attribute, question will remain unset!|)
      endhandle
    elseif (!headingVals[4] eq |EXPR|) then
      QUSEXPRESSION ($!headingVals[3])
      handle (47,15)
        --!!alert.message(|Invalid expression, question will remain unset!|)
      endhandle
    endif
  endif

  -- Set question type (TEXT, WORD, EXPR, ATTR)
  QTYPE $!headingVals[4]

  -- Set default answer
  if (!headingVals[5].empty().not()) then
    if (!headingVals[6] eq |TEXT|) then
      !!ce.tdefault = !headingVals[5]
    elseif (!headingVals[6] eq |WORD|) then
      !!ce.tdefault = !headingVals[5].substring(1,6).replace(' ','').upcase()
    elseif (!headingVals[6] eq |REAL|) then
      !tmpReal = !headingVals[5].real()
      handle (2,441)
        --!!alert.message(|Unable to convert string $!<headingVals[5]> to a REAL value, setting default answer to 0|)
      elsehandle none
        !!ce.default = !tmpReal
      endhandle
    elseif (!headingVals[6] eq |BOOL|) then
      if (!headingVals[5].upcase() inset(|TRUE|, |FALSE|)) then
        !!ce.tdefault = !headingVals[5].upcase()
      else
        --!!alert.message(|Unable to convert string $!<headingVals[5]> to a BOOLEAN value, default answer will remain unset!|)
      endif
    endif
  endif

  -- Set answer type (TEXT, WORD, REAL, BOOL)
  !!ce.anstype = !headingVals[6]

  -- Remember question dbref
  !question = !!ce
  -- Copy changes to item answers
  if (!headingVals[6] ne !this.heading.members[!index].anstype) then
    -- Modify all attributes and clear answers
    do !val values !this.items
      -- Navigate to item
      !!ce = !val.members[!index]
      -- Unset all table item specific attributes first
      TABANSWERS UNSET
      TANSWER UNSET
      WANSWERS UNSET
      -- Synchronise with heading atts
      COPY LIKE $!question
      !!ce.rFlag = 'SING'
    enddo
  else
    -- Modify all attributes except answers
    do !val values !this.items
      -- Navigate to item
      !!ce = !val.members[!index]
      -- Synchronise with heading atts
      !answerRFlag = !!ce.rFlag
      COPY LIKE $!question
      !!ce.rFlag = !answerRFlag
    enddo
  endif

  -- Restore current element
  !!ce = !dbpos

endmethod
-- End of method definition for .setQuestion(REAL, ARRAY)

------------------------------------------------------------------------
--
-- Method:      reorderQuestion
--
-- Description: Reorder question in heading members list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Initial index of question in heading members list
--    2   R      REAL        New index of question in heading members list
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .reorderQuestion(!oldIndex is REAL, !newIndex is REAL)

  -- Remember current element
  !dbpos = !!ce

  -- Navigate to main heading
  !!ce = !this.heading

  -- Reorder questions
  if (!oldIndex lt !newIndex) then
    REORDER $!oldIndex AFTER $!newIndex
  elseif (!oldIndex gt !newIndex) then
    REORDER $!oldIndex BEFORE $!newIndex
  endif

  -- Reorder answers for all items in the table
  do !val values !this.items
    -- Navigate to item
    !!ce = !val
    -- Reorder answers
    if (!oldIndex lt !newIndex) then
      REORDER $!oldIndex AFTER $!newIndex
    elseif (!oldIndex gt !newIndex) then
      REORDER $!oldIndex BEFORE $!newIndex
    endif
  enddo

  -- Restore current element
  !!ce = !dbpos

endmethod
-- End of method definition for .reorderQuestion(REAL, REAL)

------------------------------------------------------------------------
--
-- Method:      getQuestionRaw
--
-- Description: Get attributes for the specified question
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DB ref of question
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of question attributes
--                [1] Purpose
--                [2] Description
--                [3] Question
--                [4] Question type (TEXT, WORD, EXPR, ATTR)
--                [5] Default (data type of answer type)
--                [6] Answer type (TEXT, WORD, REAL, BOOL)
--
------------------------------------------------------------------------
define method .getQuestionRaw(!ref is DBREF) is ARRAY

  -- Remember current element
  !questionRef = !ref

  -- Initialise return array
  !atts = ARRAY()

  -- Purpose & description
  !atts.append(!questionRef.purpose)
  !atts.append(!questionRef.description)

  -- Question
  if (!questionRef.qtype eq |TEXT|) then
    !atts.append(!questionRef.tQuestion)
  elseif (!questionRef.qtype eq |WORD|) then
    !atts.append(!questionRef.question)
  elseif (!questionRef.qtype eq |ATTR|) then
    !atts.append(!questionRef.attset)
  elseif (!questionRef.qtype eq |EXPR|) then
    if (!questionRef.qusexpression.set()) then
      !atts.append(!questionRef.qusexpression)
    else
      !atts.append('')
    endif
  endif

  -- Question type
  !atts.append(!questionRef.qtype)

  -- Default value and data type (returns empty object for unset values)
--  !default = !this.getDefaultRaw(!questionRef)
  !atts.appendArray(!this.getDefaultRaw(!questionRef))

  return !atts

endmethod
-- End of method definition for .getQuestionRaw(DBREF)ARRAY

------------------------------------------------------------------------
--
-- Method:      getQuestion
--
-- Description: Get attributes for the specified question
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DB ref of question
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of question attributes
--                [1] Purpose
--                [2] Description
--                [3] Question
--                [4] Question type (TEXT, WORD, EXPR, ATTR)
--                [5] Default as string
--                [6] Answer type (TEXT, WORD, REAL, BOOL)
--
------------------------------------------------------------------------
define method .getQuestion(!ref is DBREF) is ARRAY

  -- Initialise return array
  !atts = !this.getQuestionRaw(!ref)

  -- Default as string data type (returns empty string for unset values)
  if (!atts[5].objectType() ne |STRING|) then
    !tmpAtt = !atts[5].string()
    !atts[5].delete()
    !atts[5] = !tmpAtt
  endif

  return !atts

endmethod
-- End of method definition for .getQuestion(DBREF)ARRAY

------------------------------------------------------------------------
--
-- Method:      getQuestion
--
-- Description: Get attributes for the specified question
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Index of question in the heading members list
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of question attributes
--                [1] Purpose
--                [2] Description
--                [3] Question
--                [4] Question type (TEXT, WORD, EXPR, ATTR)
--                [5] Default as string
--                [6] Answer type (TEXT, WORD, REAL, BOOL)
--
------------------------------------------------------------------------
define method .getQuestion(!index is REAL) is ARRAY

  -- Initialise return array
  !questionVals = ARRAY()

  -- Get question details for current heading
  if (!this.typeIndex ne 0) then
    if (!index gt !this.getQuestionCount() or !index lt 1) then
      return error 1 |Question index $!<index> is out of range!|
    else
      !questionVals = !this.getQuestion(!this.heading.members[!index])
    endif
  endif

  return !questionVals

endmethod
-- End of method definition for .getQuestion(REAL)ARRAY

------------------------------------------------------------------------
--
-- Method:      getQuestion
--
-- Description: Get details for the question with the specified attribute value
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Which attribute to match (PURP, DESC, QUES)
--    2   R      STRING      Value of attribute to match
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of question attributes
--                [1] Purpose
--                [2] Description
--                [3] Question
--                [4] Question type (TEXT, WORD, EXPR, ATTR)
--                [5] Default as string
--                [6] Answer type (TEXT, WORD, REAL, BOOL)
--
------------------------------------------------------------------------
define method .getQuestion(!option is STRING, !attribVal is STRING) is ARRAY

  -- Remember current element
  !dbpos = !!ce

  -- Initialise return array
  !questionVals = ARRAY()

  -- Get question details for current type
  if (!this.typeIndex ne 0) then

    -- Get question with matching attribute value
    !ref = DBREF()
    do !val values !this.heading.members
      if (!option eq |PURP|) then
        if (!val.purpose eq !attribVal) then
          !ref = !val
          break
        endif
      elseif (!option eq |DESC|) then
        if (!val.description eq !attribVal) then
          !ref = !val
          break
        endif
      elseif (!option eq |QUES|) then
        if (!val.qtype eq |TEXT|) then
          if (!val.tQuestion eq !attribVal) then
            !ref = !val
            break
          endif
        elseif (!val.qtype eq |WORD|) then
          if (!val.question eq !attribVal) then
            !ref = !val
            break
          endif
        elseif (!val.qtype eq |ATTR|) then
          if (!val.attset eq !attribVal) then
            !ref = !val
            break
          endif
        elseif (!val.qtype eq |EXPR|) then
          if (!val.qusexpression eq !attribVal) then
            !ref = !val
            break
          endif
        endif
      else
        return error 1 |Invalid option $!<option>!|
      endif
    enddo

    -- Get question attributes
    if (!ref.badref().not()) then
      !questionVals = !this.getQuestion(!ref)
    endif

  endif

  -- Restore current element
  !!ce = !dbpos

  return !questionVals

endmethod
-- End of method definition for .getQuestion(STRING, STRING)ARRAY

------------------------------------------------------------------------
--
-- Method:      getQuestions
--
-- Description: Returns attributes for all questions in heading as
--              an array of arrays
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of arrays of question attributes (unset if no questions)
--                [n][1] Purpose
--                [n][2] Description
--                [n][3] Question
--                [n][4] Question type (TEXT, WORD, EXPR, ATTR)
--                [n][5] Default as string
--                [n][6] Answer type (TEXT, WORD, REAL, BOOL)
--
------------------------------------------------------------------------
define method .getQuestions() is ARRAY

  -- Initialise return array
  !questions = object ARRAY()

  -- Get questions for current type
  if (!this.typeIndex ne 0) then
    do !val values !this.heading.members
      !questions.append(!this.getQuestion(!val))
    enddo
  endif

  return !questions

endmethod
-- End of method definition for .getQuestions()ARRAY

------------------------------------------------------------------------
--
-- Method:      getQuestions
--
-- Description: Returns specified attribute for all questions in heading
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Which question attribute to return (PURP, DESC, QUES)
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of question attributes (unset if no questions)
--
------------------------------------------------------------------------
define method .getQuestions(!option is STRING) is ARRAY

  -- Initialise return array
  !questions = ARRAY()

  -- Process questions for current type
  if (!this.typeIndex ne 0) then
    if (!this.heading.members.set()) then
      -- Get values for specified attribute
      do !val values !this.heading.members
        if (!option eq |PURP|) then
          !questions.append(!this.getQuestion(!val)[1])
        elseif (!option eq |DESC|) then
          !questions.append(!this.getQuestion(!val)[2])
        elseif (!option eq |QUES|) then
          !questions.append(!this.getQuestion(!val)[3])
        endif
      enddo
    endif
  endif

  return !questions

endmethod
-- End of method definition for .getQuestions(STRING)ARRAY

------------------------------------------------------------------------
--
-- Method:      getDesAttributes
--
-- Description: Returns all Attribute questions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Table item
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of arrays of attributes/values
--                [n][1] Attribute name
--                [n][2] Attribute value
--
------------------------------------------------------------------------
define method .getDesAttributes(!item is DBREF) is ARRAY

  -- Initialise return array
  !attribs = object ARRAY()

  -- Get design attributes for current type
  if (!this.typeIndex ne 0) then
    -- Return if no questions
    if (!this.heading.members.set()) then
      do !ind indices !this.heading.members
        !data = object ARRAY()
        if (!this.heading.members[!ind].qtype eq |ATTR|) then
          -- Attribute name
          !data[1] = !this.getQuestion(!ind)[3]
          -- Attribute value
          !data[2] = !this.getAnswer(!item, !ind)[1]
          !attribs.append(!data)
        endif
      enddo
    endif
  endif

  return !attribs

endmethod
-- End of method definition for .getDesAttributes(DBREF)ARRAY

------------------------------------------------------------------------
--
-- Method:      getQuestionIndex
--
-- Description: Get question index for specified attribute.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Which attribute to match (PURP, DESC, QUES)
--    2   R      STRING      Value of attribute to match
--
-- Return:
--   [Data Type] [Description]
--    REAL        Question index
--
------------------------------------------------------------------------
define method .getQuestionIndex(!option is STRING, !value is STRING) is REAL

  -- Get question index for specified attribute and value
  !index = !this.getQuestions(!option).findFirst(!value)

  return !index

endmethod
-- End of method definition for .getQuestionIndex(STRING, STRING)REAL

------------------------------------------------------------------------
--
-- Method:      getQuestionCount
--
-- Description: Get total number of questions in heading
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        Number of questions
--
------------------------------------------------------------------------
define method .getQuestionCount() is REAL

  -- Initialise return value
  !qCount = REAL()

  -- Get count for current heading
  if (!this.typeIndex ne 0) then
    !qCount = !this.heading.members.size()
  endif

  return !qCount

endmethod
-- End of method definition for .getQuestionCount()REAL

------------------------------------------------------------------------
--
-- Method:      deleteQuestion
--
-- Description: Delete specified question
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Ref of question
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteQuestion(!ref is DBREF)

  -- Remember current element
  !dbpos = !!ce

  -- Navigate to question
  !!ce = !ref

  -- Remember index in members list
  !index = !!ce.sequence

  -- Delete heading question
  DELETE TABHQU

  -- Delete answer from all items in the table
  do !val values !this.items
    -- Navigate to answer
    !!ce = !val.members[!index]
    DELETE TABQUE
  enddo

  -- Restore current element
  !!ce = !dbpos
  handle any
  endhandle

endmethod
-- End of method definition for .deleteQuestion(DBREF)

------------------------------------------------------------------------
--
-- Method:      deleteQuestion
--
-- Description: Delete specified question
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Index of question in heading members list
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteQuestion(!index is REAL)

  -- Check for valid type index
  if (!this.typeIndex eq 0) then
    return error 1 |Type index out of range, question will not be deleted!|
  endif

  -- Delete question
  !this.deleteQuestion(!this.heading.members[!index])

endmethod
-- End of method definition for .deleteQuestion(REAL)

------------------------------------------------------------------------
--
-- Method:      deleteQuestion
--
-- Description: Delete specified question
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Purpose of question
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteQuestion(!purpose is STRING)

  -- Check for valid type index
  if (!this.typeIndex eq 0) then
    return error 1 |Type index out of range, question will not be deleted!|
  endif

  -- Remember current element
  !dbpos = !!ce

  -- Get question with matching purpose
  !ref = DBREF()
  do !val values !this.heading.members
    if (!val.purpose eq !purpose) then
      !ref = !val
      break
    endif
  enddo

  -- Restore current element
  !!ce = !dbpos

  -- Delete question or return if question not found
  if (!val.badref()) then
    return error 1 |Can't find question with purpose $!<purpose>!|
  else
    !this.deleteQuestion(!val)
  endif

endmethod
-- End of method definition for .deleteQuestion(STRING)

------------------------------------------------------------------------
--
-- Method:      getDefaultRaw
--
-- Description: Get default answer for the specified question
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DB ref of question
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of question attributes (empty object if unset)
--                [1] Default answer (data type of answer type)
--                [2] Answer type (TEXT, WORD, REAL, BOOL)
--
------------------------------------------------------------------------
define method .getDefaultRaw(!ref is DBREF) is ARRAY

  -- Initialise return array
  !dfltAtts = ARRAY()

  -- Check the default answer or leave unset
  !answerType = !ref.anstype

--  if (!answerType eq 'NONE') then
--      -- Where it has come from an old spec.
--      !answerType = 'TEXT'
--  endif

  if (!answerType inset(|TEXT|, |WORD|)) then
      !default = !ref.tdefault
         if (!default.empty()) then
             !default = STRING()
         endif
  elseif (!answerType eq |REAL|) then
          !default = !ref.default
             if (!default ne 0) then
                 !default = !ref.default
             else
                 !default = REAL()
             endif
  elseif (!answerType eq |BOOL|) then
      !tmpBoolDefault = !ref.tdefault
         if (!tmpBoolDefault.empty()) then
             !default = BOOLEAN()
         else
             !default = !tmpBoolDefault.boolean()
         endif
  else
       -- Handle case where user has defined his own answer type.
       !default = STRING()
  endif

  !dfltAtts.append(!default)
  !dfltAtts.append(!answerType)

  return !dfltAtts

endmethod
-- End of method definition for .getDefaultRaw(DBREF)ARRAY


------------------------------------------------------------------------
--
-- Method:      copyItems
--
-- Description: Copy items to the end of the table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of items
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Indices for new table items
--
------------------------------------------------------------------------
define method .copyItems(!copyItems is ARRAY) is ARRAY

    !indices = ARRAY()
    !startIndex = !this.items.maxIndex()

    !!ce = !this.items.last()
    do !item indices !copyItems
      -- Copy item and add to arrays
      NEW $!copyItems[$!item].type copy $!copyItems[$!item]
      !this.items.append(!!ce)
      !indices.append(!startIndex + !item)

      -- Use autonaming if required
      if (!!namOpt.auto()) then
        !name = STRING()
        !name = !!namOpt.nameString(!!ce, STRING(), false, false)
        handle any
          -- Most likely the naming rule could not be applied
          write |$!!error.text|
        endhandle
        if (!name.set()) then
          NAME /$!name
        endif
      endif
    enddo
    return !indices
endmethod
-- End of method definition for .copyItems(ARRAY)

------------------------------------------------------------------------
--
-- Method:      newItems
--
-- Description: Add new items to the end of the table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of GPART refs
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Indices for new table items
--
------------------------------------------------------------------------
define method .newItems(!newGParts is ARRAY) is ARRAY

  return !this.newItems(!newGParts, !this.getItemCount() + 1)

endmethod
-- End of method definition for .newItems(ARRAY)ARRAY

------------------------------------------------------------------------
--
-- Method:      newItems
--
-- Description: Add new items at specified index in the table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of GPART refs
--    2   R      ARRAY       Index for first new item
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Indices for new table items
--
------------------------------------------------------------------------
define method .newItems(!gParts is ARRAY, !index is REAL) is ARRAY

  -- Check for empty gParts array
  if (!gParts.unset()) then
    return error 1 |GPART array is empty!|
  endif

  -- Check for invalid index
  if (!index.unset() or !index eq 0) then
    return error 1 |Invalid array index!|
  endif

  -- Remember current element
  !dbpos = !!ce

  -- Navigate to correct index in the table
  if (!index eq 1) then
    !!ce = !this.typeTable
  else
    !!ce = !this.typeTable.members[!index - 1]
  endif

  -- Create new table items along with associated answers
  !newIndices = ARRAY()
  do !ind indices !gParts

    -- Create table item and set GPART ref
    NEW TABITE
    !!ce.prtref = !gParts[!ind]
    !newIndices.append(!!ce.tysequence)
    -- Create answer elements to match the headings
    do !val values !this.heading.members
      NEW TABQUE
      WANSWERS UNSET
      -- Synchronise with heading atts
      COPY LIKE $!val
      -- Set RFLAG (NONE, SING, RANG, MULT)
      RFLAG SING
    enddo
  enddo

  -- Update object with new items
  !this.setType(!this.typeIndex)

  -- Restore current element
  !!ce = !dbpos

  return !newIndices

endmethod
-- End of method definition for .newItems(ARRAY, REAL)ARRAY

------------------------------------------------------------------------
--
-- Method:      getItemCount
--
-- Description: Get total number of items in table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        Number of items
--
------------------------------------------------------------------------
define method .getItemCount() is REAL

  -- Initialise return size
  !size = REAL()

  -- Get item count for current type
  if (!this.typeIndex ne 0) then
    !size = !this.items.size()
  endif

  return !size

endmethod
-- End of method definition for .getItemCount()REAL

------------------------------------------------------------------------
--
-- Method:      deleteItems
--
-- Description: Delete items from the table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of table items to be deleted
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteItems(!itemIndices is ARRAY)

  -- Check for valid type index
  if (!this.typeIndex eq 0) then
    return error 1 |Type index out of range, items will not be deleted!|
  endif

  -- Remember current element
  !dbpos = !!ce

  -- Delete items
  do !val values !itemIndices
    !!ce = !this.items[!val]
    DELETE TABITE
  enddo

  -- Update object after deleting items
  !this.setType(!this.typeIndex)

  -- Restore current element (if it has not been deleted!)
  if (!dbpos.badref().not()) then
    !!ce = !dbpos
  endif

endmethod
-- End of method definition for .deleteItems(ARRAY)

------------------------------------------------------------------------
--
-- Method:      getItemRaw
--
-- Description: Get item details for the specified table item, including
--              all answer values and the specified GPART attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DB ref of selection table item
--    2   R      ARRAY       Array of GPART attributes to be included in results
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of item details
--                [1]          Item selectable state
--                [2]          Item namn
--                [3] to   [n] Item answers (DBATTR data types)
--                [n+1] to [?] GPART attribute values
--
------------------------------------------------------------------------
define method .getItemRaw(!itemVal is DBREF, !attributes is ARRAY) is ARRAY

  -- Initialise return array
  !currentHeadings = ARRAY()

  -- Set the current heading columns to that in the current CTABLE
  do !q value !this.getQuestions()
    !currentHeadings.append(!q[1])
  enddo

  !tableItem = !this.getItemRaw(!itemVal, !attributes, !currentHeadings)

  return !tableItem

endmethod
-- End of method definition for .getItemRaw(DBREF, ARRAY)ARRAY

------------------------------------------------------------------------
--
-- Method:      getItemRaw
--
-- Description: Get item details for the specified table item, including
--              all answer values and the specified GPART attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DB ref of selection table item
--    2   R      ARRAY       Array of GPART attributes to be included in results
--    3   R      ARRAY       Array of Headings
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of item details
--                [1]          Item selectable state
--                [2]          Item namn
--                [3] to   [n] Item answers (DBATTR data types)
--                [n+1] to [?] GPART attribute values
--
------------------------------------------------------------------------
define method .getItemRaw(!itemVal is DBREF, !attributes is ARRAY, !currentHeadings is ARRAY) is ARRAY

  -- Initialise return array
  !tableItem = ARRAY()

  -- Item active state
  !tableItem.append(!itemVal.lactive)

  -- Name without prefix
  !tableItem.append(!itemVal.namn)

  -- Raw answers, but make the array same size as heading questions, or if there are no headings
  -- then make the answers array empty.

  -- If we have no headings, then just set the answers array empty.
  if (!currentHeadings.empty()) then
      !answers = ARRAY()
  else
    -- Or set the fields to blank for the number of headings we have,
    -- to get blank fields in the grid.
    do !i ind !currentHeadings
       !answers[!i] = ''
    enddo
  endif

  !itemMembers = !itemVal.members
  do !ind indices !itemMembers

    !indexToUse = !currentHeadings.findFirst(!itemMembers[!ind].purp)
    -- get string answer
    !answers[!indexToUse] =  !this.getAnswer(!itemVal, !indexToUse)[1]
    handle (2,752)
      -- An error with questions and answers is most likely here.
      return !tableItem
    elsehandle (2,756)
      !this.errorCount = !this.errorCount + 1
      !purp = !itemMembers[!ind].purp
      write |Can't find -$!purp$n- in current CTABLE Headings for element $!itemVal|
      if (!this.errorCount lt 5) then
        !!alert.message(|Can't find -$!purp$n- in current CTABLE Headings for element $!itemVal|)
      elseif (!this.errorCount eq 6) then
        !!alert.message(|Too many errors are occurring, suppressing message, see command window for details|)
      endif
    endhandle
  enddo

  !tableItem.appendArray(!answers)

  -- GPART attributes
  do !attVal values !attributes
    if (!itemVal.prtref.badref()) then
      !tableItem.append('---')
    else
      !tableItem.append(!itemVal.prtref.attribute(!attVal))
    endif
  enddo

  return !tableItem

endmethod
-- End of method definition for .getItemRaw(DBREF, ARRAY, ARRAY)ARRAY

------------------------------------------------------------------------
--
-- Method:      getItem
--
-- Description: Get item details for the specified table item, including
--              all answer values and the standard GPART attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DB ref of selection table item
--    2   R      ARRAY       Array of GPART attributes to be included in results
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of item details
--                [1]        Item selectable state
--                [2]        Item namn
--                [3] to [n] Item answers
--                [n+1]      GPART name
--                [n+2]      GPART primary type
--                [n+3]      GPART Secondary type
--                [n+4]      GPART description
--
------------------------------------------------------------------------
define method .getItem(!itemVal is DBREF) is ARRAY

  -- Get raw item details
  !rawDetails = !this.getItemRaw(!itemVal, !this.stdGpartAtts)

  return !this.convertItemToString(!rawDetails)

endmethod
-- End of method definition for .getItem(DBREF)ARRAY

------------------------------------------------------------------------
--
-- Method:      convertItemString
--
-- Description: Convert item details in input item array to STRING
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY      Array of item details
--                          [1]        Item selectable state
--                          [2]        Item namn
--                          [3] to [n] Item answers
--                          [n+1]      GPART name
--                          [n+2]      GPART primary type
--                          [n+3]      GPART Secondary type
--                          [n+4]      GPART description
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of item details converted to STRING
--
------------------------------------------------------------------------
define method .convertItemToString(!rawDetails is ARRAY) is ARRAY

  -- Convert to strings
  !itemDetails = ARRAY()
  do !val values !rawDetails

    !answer = ''

    -- Convert arrays to a concatenated string
    if (!val.objectType() eq |ARRAY|) then
      do !ind indices !val
        if (!val[!ind].objectType() ne |STRING|) then
          !answer = !answer & | | & !val[!ind].string()
        else
          !answer = !answer & | | & !val[!ind]
        endif
      enddo
      !answer = !answer.trim()

    -- Convert real to string
    elseif (!val.objectType() eq |REAL|) then
      !answer = !val.string()

    -- Convert boolean to string
    elseif (!val.objectType() eq |BOOLEAN|) then
      !answer = !val.string()

    -- Convert unset strings to empty strings
    else
      if (!val.set()) then
        !answer = !val
      else
        !answer = ''
      endif

    endif

    !itemDetails.append(!answer)
  enddo

  return !itemDetails

endmethod
-- End of method definition for .convertItemToString(ARRAY)ARRAY

------------------------------------------------------------------------
--
-- Method:      getItem
--
-- Description: Get item details for specified item index for display, including
--              all answer values and the standard GPART attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Index of table item in selection table
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of item details
--                [1]        Item selectable state
--                [2]        Item namn
--                [3] to [n] Item answers
--                [n+1]      GPART name
--                [n+2]      GPART primary type
--                [n+3]      GPART Secondary type
--                [n+4]      GPART description
--
------------------------------------------------------------------------
define method .getItem(!index is REAL) is ARRAY

  -- Initialise return array
  !item = ARRAY

  -- Get item[!index] details from the current type
  if (!this.typeIndex ne 0) then
    !item = !this.getItem(!this.items[!index])
  endif

  return !item

endmethod
-- End of method definition for .getItem(REAL)ARRAY

------------------------------------------------------------------------
--
-- Method:      getItems
--
-- Description: Get item details of all items in table for display, including
--              all answer values and the standard GPART attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of arrays of item details for all items in the table
--                [1]        Item selectable state
--                [2]        Item namn
--                [3] to [n] Item answers
--                [n+1]      GPART name
--                [n+2]      GPART primary type
--                [n+3]      GPART Secondary type
--                [n+4]      GPART description
--
------------------------------------------------------------------------
define method .getItems() is ARRAY

  -- Initialise return array
  !tableItems = object ARRAY()

  -- Get details for each item for the current type
  if (!this.typeIndex ne 0) then
    do !itemVal values !this.items
      !tableItems.append(!this.getItem(!itemVal))
    enddo
  endif

  return !tableItems

endmethod
-- End of method definition for .getItems()ARRAY

------------------------------------------------------------------------
--
-- Method:      getItemName
--
-- Description: Get item name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DB ref of selection table item
--
-- Return:
--   [Data Type] [Description]
--    STRING      Item name (without leading '/')
--
------------------------------------------------------------------------
define method .getItemName(!itemVal is DBREF) is STRING

  return !itemVal.namn

endmethod
-- End of method definition for .getItemName(DBREF)STRING

------------------------------------------------------------------------
--
-- Method:      getItemName
--
-- Description: Get item name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Index of selection table item
--
-- Return:
--   [Data Type] [Description]
--    STRING      Item name (without leading '/')
--
------------------------------------------------------------------------
define method .getItemName(!index is REAL) is STRING

  return !this.items[!index].namn

endmethod
-- End of method definition for .getItemName(REAL)STRING

------------------------------------------------------------------------
--
-- Method:      getAnswerRaw
--
-- Description: Get answer details for the specified item & answer index
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DB ref of selection table item
--    2   R      REAL        Index of answer in table item member list
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of answer details
--                [1] Answer value  (data type of DBATT)
--                [2] Answer type   (TEXT WORD REAL BOOL)
--                [3] Answer format (SING MULT RANG)
--
------------------------------------------------------------------------
define method .getAnswerRaw(!item is DBREF, !index is REAL) is ARRAY

  -- Initialise return array, with empty strings.
  -- The following array will be populated during this process, left blank if question not available or
  -- filled with blanks if answer is not available
  !itemAnswer = ARRAY()

  -- Check for valid type index
  if (!this.typeIndex eq 0) then
    return !itemAnswer
  endif

  -- Check for invalid index
  if (!index eq 0) then
    return error 1 |Index 0 not allowed!|
  endif

  -- Get the question/answer
  -- Find answer with the same purpose as the selected heading
  !aRef = object DBREF()

  do !itemMember values !item.members
      if (!this.headings[!index] eq !itemMember.purp) then
         !aRef = !itemMember
         break
      endif
  enddo

  -- If no answer was found, set the answer value, format and type to empty strings and return
  if (!aRef.unset()) then
     !itemAnswer[1] = ''
     !itemAnswer[2] = ''
     !itemAnswer[3] = ''
     return !itemAnswer
  endif

  -- Find the question
  !qRef = !this.heading.members[!index]
  if (!qRef.badref()) then
      return !itemAnswer
  endif

  -- Text answer type
  !answerType = !qRef.anstype
  if (!answerType eq |TEXT|) then
    if (!aRef.tanswer.empty()) then
      !itemAnswer.append(object STRING())
    else
      !itemAnswer.append(!aRef.tanswer)
    endif
    !itemAnswer.append(|TEXT|)
    !itemAnswer.append(|SING|)

  -- Word answer type
  elseif (!answerType eq |WORD|) then
    if (!aRef.wanswers.set()) then
      if (!aRef.rFlag eq 'SING') then
        !itemAnswer.append(!aRef.wanswers[1])
        !itemAnswer.append(|WORD|)
        !itemAnswer.append(|SING|)
      elseif (!aRef.rFlag eq 'MULT') then
        !itemAnswer.append(!aRef.wanswers)
        !itemAnswer.append(|WORD|)
        !itemAnswer.append(|MULT|)
      else
        return error 1 |Illegal attribute combination WANSWERS & RFLAG!|
      endif
    else
      !itemAnswer.append(object STRING())
      !itemAnswer.append(|WORD|)
      !itemAnswer.append(|SING|)
    endif

  -- Real answer type
  elseif (!answerType eq |REAL|) then
    if (!aRef.tabanswers.set()) then
      if (!aRef.rFlag eq 'SING') then
        !itemAnswer.append(!aRef.tabanswers[1])
        !itemAnswer.append(|REAL|)
        !itemAnswer.append(|SING|)
      elseif (!aRef.rFlag eq 'MULT') then
        !itemAnswer.append(!aRef.tabanswers)
        !itemAnswer.append(|REAL|)
        !itemAnswer.append(|MULT|)
      elseif (!aRef.rFlag eq 'RANG') then
        !tmpAnswers[1] = !aRef.tabanswers[1]
        !tmpAnswers[2] = !aRef.tabanswers[2]
        !itemAnswer.append(!tmpAnswers)
        !itemAnswer.append(|REAL|)
        !itemAnswer.append(|RANG|)
      else
        return error 1 |Illegal attribute combination TABANSWER & RFLAG!|
      endif
    else
      !itemAnswer.append(object REAL())
      !itemAnswer.append(|REAL|)
      !itemAnswer.append(|SING|)
    endif

  -- Boolean answer type
  elseif (!qRef.anstype eq |BOOL|) then
    if (!aRef.tanswer.empty()) then
      !itemAnswer.append(object BOOLEAN())
    else
      !itemAnswer.append(!aRef.tanswer.boolean())
    endif
    !itemAnswer.append(|BOOL|)
    !itemAnswer.append(|SING|)

  endif

  return !itemAnswer

endmethod
-- End of method definition for .getAnswerRaw(DBREF, REAL)ARRAY

------------------------------------------------------------------------
--
-- Method:      getAnswer
--
-- Description: Get answer details for the specified item & answer
--              and convert to string data types for display in UI
--
-- Method Type: Function/Procedure
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DB ref of selection table item
--    2   R      REAL        Index of answer in table item member list
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of answer details
--                [1] Answer value  (STRING data type)
--                [2] Answer type   (TEXT WORD REAL BOOL)
--                [3] Answer format (SING MULT RANG)
--
------------------------------------------------------------------------
define method .getAnswer(!item is DBREF, !index is REAL) is ARRAY

  -- Initialise return array
  !stringValues = ARRAY()

  -- Check for valid type index
  if (!this.typeIndex eq 0) then
    return !stringValues
  endif

  -- Get raw details
  !rawValues = !this.getAnswerRaw(!item, !index)

  -- Convert to strings
  !answer = ''

  -- Convert arrays to a concatenated string
  !answerType = !rawValues[1].objectType()
  if (!answerType eq |ARRAY|) then
    do !ind indices !rawValues[1]
      if (!rawValues[1][!ind].objectType() ne |STRING|) then
        !answer = !answer & | | & !rawValues[1][!ind].string()
      else
        !answer = !answer & | | & !rawValues[1][!ind]
      endif
    enddo
    !answer = !answer.trim()

  -- Convert real to string
  elseif (!answerType eq |REAL|) then
    !answer = !rawValues[1].string()

  -- Convert boolean to string
  elseif (!answerType eq |BOOLEAN|) then
    !answer = !rawValues[1].string()

  -- Convert unset strings to empty strings
  else
    if (!rawValues[1].set()) then
      !answer = !rawValues[1]
    else
      !answer = ''
    endif
  endif

  -- Assign string values
  !stringValues[1] = !answer
  !stringValues[2] = !rawValues[2]
  !stringValues[3] = !rawValues[3]

  return !stringValues

endmethod
-- End of method definition for .getAnswer(DBREF, REAL)ARRAY

------------------------------------------------------------------------
--
-- Method:      getAnswer
--
-- Description: Get answer detail for specified table item and purpose for display.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DB ref of selection table item
--    2   R      STRING      Purpose of answer
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of answer details
--                [1] Answer value  (STRING data type)
--                [2] Answer type   (TEXT WORD REAL BOOL)
--                [3] Answer format (SING MULT RANG)
--
------------------------------------------------------------------------
define method .getAnswer(!item is DBREF, !purpose is STRING) is ARRAY

  -- Initialise answer index
  !index = REAL()

  -- Get index of question with specified purpose for current type
  if (!this.typeIndex ne 0) then
    !purposes = !this.heading.members.evaluate(object BLOCK(|!this.heading.members[!evalIndex].purpose|))
    !index = !purposes.findFirst(!purpose)
  endif

  -- Get answer for specified question
  if (!index.unset()) then
    return error 1 |Can't find question with purpose $!<purpose>!|
  else
    return !this.getAnswer(!item, !index)
  endif

endmethod
-- End of method definition for .getAnswer(DBREF, STRING)ARRAY

------------------------------------------------------------------------
--
-- Method:      getAnswers
--
-- Description: Get answer details for specified table item for display.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DB ref of selection table item
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of arrays of answer details
--                [n][1] Answer value  (STRING data type)
--                [n][2] Answer type   (TEXT WORD REAL BOOL)
--                [n][3] Answer format (SING MULT RANG)
--
------------------------------------------------------------------------
define method .getAnswers(!item is DBREF) is ARRAY

  -- Initialise return array
  !answers = ARRAY()

  -- Get details for each item in for the current type
  if (!this.typeIndex eq 0) then
    do !ind indices !item.members
      !answers.append(!this.getAnswer(!item, !ind))
    enddo
  endif

  return !answers

endmethod
-- End of method definition for .getAnswers(DBREF)ARRAY

------------------------------------------------------------------------
--
-- Method:      setAnswer
--
-- Description: Set specified answer for specified table item.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DB ref of selection table item
--    2   R      REAL        Index of answer in the table item members list
--    3   R      ARRAY       Array of attributes to set
--                           [1] Answer value  (STRING data type)
--                           [2] Answer format (SING MULT RANG)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setAnswer(!item is DBREF, !index is REAL, !answerVals is ARRAY)

  -- Check for valid type index
  if (!this.typeIndex eq 0) then
    return error 1 |Type index out of range, Answer attributes will not be set!|
  endif

  -- Remember current element
  !dbpos = !!ce

  -- Find the index to the correct answer by matching the question and answer purposes
  -- (in case the table item is missing some answers)

  do !i index !item.members
    if (!item.members[!i].purp eq !this.getQuestion(!index)[1]) then
        !indexToAnswer = !i
    endif
  enddo

  -- If an answer doesn't exist, return without doing anything
  if (not defined(!indexToAnswer)) then
    return
  endif
  -- Navigate to answer member
  !!ce = !item.members[!indexToAnswer]

  -- Get answer type
  !answerType = !this.getQuestion(!indexToAnswer)[6]

  -- Text answer
  if (!answerType eq |TEXT|) then
    TABANSWER UNSET
    WANSWERS UNSET
    !!ce.rFlag = |SING|
    if (!answerVals[1].set()) then
      TANSWER UNSET
      !!ce.tanswer = !answerVals[1].trim()
    endif

  -- Word answer
  elseif (!answerType eq |WORD|) then
    TANSWER UNSET
    TABANSWER UNSET
    if (!answerVals[2] eq |SING|) then
      !!ce.rFlag = |SING|
      if (!answerVals[1].set()) then
        WANSWERS UNSET
        !!ce.wanswers[1] = !answerVals[1].replace(' ','')
      endif
    elseif (!answerVals[2] eq |MULT|) then
      !!ce.rFlag = |MULT|
      if (!answerVals[1].set()) then
        WANSWERS UNSET
        !splitAnswers = !answerVals[1].split()
        do !ind indices !splitAnswers
          !!ce.wanswers[!ind] = !splitAnswers[!ind]
        enddo
      endif
    endif

  -- Real answer
  elseif (!answerType eq |REAL|) then
    TANSWER UNSET
    WANSWERS UNSET
    if (!answerVals[2] eq |SING|) then
      !!ce.rFlag = |SING|
      if (!answerVals[1].set()) then
        TABANSWER UNSET
        !!ce.tabanswer[1] = !answerVals[1].real()
      endif
    elseif (!answerVals[2] eq |MULT|) then
      !!ce.rFlag = |MULT|
      if (!answerVals[1].set()) then
        TABANSWER UNSET
        !splitAnswers = !answerVals[1].split()
        do !ind indices !splitAnswers
          !!ce.tabanswer[!ind] = !splitAnswers[!ind].real()
        enddo
      endif
    elseif (!answerVals[2] eq |RANG|) then
      !!ce.rFlag = |RANG|
      if (!answerVals[1].set()) then
        TABANSWER UNSET
        !splitAnswers = !answerVals[1].split()
        !!ce.tabanswer[1] = !splitAnswers[1].real()
        !!ce.tabanswer[2] = !splitAnswers[2].real()
      endif
    endif

  -- Boolean answer
  elseif (!answerType eq |BOOL|) then
    TABANSWER UNSET
    WANSWERS UNSET
    !!ce.rFlag = |SING|
    if (!answerVals[1].set() and !answerVals[1].upcase() inset(|TRUE|, |FALSE|)) then
      TANSWER UNSET
      !!ce.tanswer = !answerVals[1].upcase()
    endif

  endif

  -- Restore current element
  !!ce = !dbpos

endmethod
-- End of method definition for .setAnswer(DBREF, REAL, ARRAY)

------------------------------------------------------------------------
--
-- Method:      setItemAtts
--
-- Description: Set table item attributes.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DB ref of selection table item
--    2   R      ARRAY       Array of attributes to set
--                           [1] Item Name  (STRING data type)
--                           [2] Prtref (DBREF data type)
--                           [3] Active state (BOOLEAN data type)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setItemAtts(!item is DBREF, !attributes is ARRAY)

  -- Check for valid type index
  if (!this.typeIndex eq 0) then
    return error 1 |Type index out of range, Item attributes will not be set!|
  endif

  -- Remember current element
  !dbpos = !!ce

  -- Navigate to item
  !!ce = !item

  -- Name
  if (!attributes[1].set() and !attributes[1].substring(1,1) ne |=|) then
    if (!attributes[1].substring(1,1) ne |/|) then
      !!ce.name = '/' & !attributes[1]
    else
      !!ce.name = !attributes[1]
    endif
  endif
  -- Part ref
  if (!attributes[2].set()) then
    !!ce.prtref = !attributes[2]
  endif
  -- Active state
  if (!attributes[3].set()) then
    !!ce.lactive = !attributes[3]
  endif

  -- Restore current element
  !!ce = !dbpos

endmethod
-- End of method definition for .setItem(DBREF, ARRAY)

------------------------------------------------------------------------
--
-- Method:      checkNewQuesPurp
--
-- Description: Check for invalid or duplicate question purpose.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      New purpose
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     True if purpose is valid, false if purpose is already
--                used or is invalid
--
------------------------------------------------------------------------
define method .checkNewQuesPurp(!newPurp is STRING) is BOOLEAN

  -- Get current question purposes
  !purposes = ARRAY()
  do !val values !this.heading.members
    !purposes.append(!val.purpose)
  enddo

  if (!newPurp.unset()) then
    return false
  elseif (!newPurp.trim().empty() or !purposes.findFirst(!newPurp).set() or !newPurp.match(| |) gt 0) then
    return false
  else
    return true
  endif


endmethod
-- End of method definition for .checkNewQuesPurp(STRING)BOOLEAN

------------------------------------------------------------------------
--
-- Method:      setActive
--
-- Description: Set table item active state.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       DB ref of selection table item
--    2   R      BOOLEAN     Design active state for table item
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setActive(!index is REAL, !active is BOOLEAN) is ARRAY

  -- Remember current element
  !dbpos = !!ce

  -- Navigate to answer member
  !!ce = !this.items[!index]
  !!ce.lactive = !active

  -- Restore current element
  !!ce = !dbpos

endmethod
-- End of method definition for .setActive(REAL, BOOLEAN)ARRAY

------------------------------------------------------------------------
--
-- Method:      chooseItems()
--
-- Description: Choose table items in Design.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Design element for choose operation
--    2   R      ARRAY       Array of choose question purposes
--    3   R      ARRAY       Array of matching chose answers (data type must match answer type)
--    4   R      STRING      Default flag (true = use defaults, false = don't use defaults)
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Table items matching the choose criteria
--
------------------------------------------------------------------------
define method .chooseItems(!designItem is DBREF, !questionIdentifiers is ARRAY, !answersToQuestions is ARRAY, !default is BOOLEAN) is ARRAY

  -- Check for valid type index
  if (!this.typeIndex eq 0) then
    return error 1 |Type index out of range, no items will be chosen!|
  endif

  -- Return all table items if there are no questions in table
  if (!this.getQuestionCount() eq 0) then
    -- Remove inactive items
    !activeItems = ARRAY()
    do !item value !this.items
      if (!item.lactive) then
        !activeItems.append(!item)
      endif
    enddo
    return !activeItems
  endif

  -- Check for matching question and answer arguments
  !quesPurps     = !questionIdentifiers
  !chooseAnswers = !answersToQuestions
  if (!quesPurps.compress().size() ne !chooseAnswers.compress().size()) then
      return error 1 |Number of questions does not match number of answers!|
  endif

  -- Remember current element
  !dbpos = !!ce

  -- Initialise question and answer arrays
  !questions = ARRAY()
  !answers = ARRAY()

  -- Get all questions/answers (leave answer unset if not supplied and no default)
  do !index indices !this.heading.members
    !questions[!index] = !this.heading.members[!index].purpose
    !caInd = !quesPurps.findFirst(!questions[!index])
    -- Choose questions
    if (!this.heading.members[!index].qtype inset(|TEXT|, |WORD|, |ATTR|)) then
      if (!caInd.set()) then
        -- Use the supplied answer
        !answers[!index] = !chooseAnswers[!caInd]
      else
        -- Check the default answer or leave unset
        if (!default) then
          !answers[!index] = !this.getDefaultRaw(!this.heading.members[!index])[1]
        else
          !answerType = !this.getQuestion(!index)[6]
          if (!answerType inset(|TEXT|, |WORD|)) then
            !answers[!index] = STRING()
          elseif (!answerType eq |REAL|) then
            !answers[!index] = REAL()
          elseif (!answerType eq |BOOL|) then
            !answers[!index] = BOOLEAN()
          endif
        endif
      endif
    -- Expression questions
    elseif (!this.heading.members[!index].qtype eq |EXPR|) then
      if (!designItem.badref()) then
        if (!caInd.set()) then
          -- Use the supplied answer
          !answers[!index] = !chooseAnswers[!caInd]
        else
          -- Check the default answer or leave unset
          if (!default) then
            !answers[!index] = !this.getDefaultRaw(!this.heading.members[!index])[1]
          else
            !answerType = !this.getQuestion(!index)[6]
            if (!answerType inset(|TEXT|, |WORD|)) then
              !answers[!index] = STRING()
            elseif (!answerType eq |REAL|) then
              !answers[!index] = REAL()
            elseif (!answerType eq |BOOL|) then
              !answers[!index] = BOOLEAN()
            endif
          endif
        endif
      else
        -- Evaluate expression for dbref
        !questionExpression = !this.heading.members[!index].qusexpression
        if( !questionExpression.empty() ) then
          -- get default answer for unset expression
          -- Check the default answer or leave unset
          if (!default) then
            !answers[!index] = !this.getDefaultRaw(!this.heading.members[!index])[1]
          else
            !answerType = !this.getQuestion(!index)[6]
            if (!answerType inset(|TEXT|, |WORD|)) then
              !answers[!index] = STRING()
            elseif (!answerType eq |REAL|) then
              !answers[!index] = REAL()
            elseif (!answerType eq |BOOL|) then
              !answers[!index] = BOOLEAN()
            endif
          endif
        else
          !expression[!index] = !questionExpression
          !answers[!index] = !designItem.evaluate(object BLOCK(!expression[!index]))
          handle (2,201)(2,102)
            !answers[!index] = object EXPRESSION()
          endhandle
        endif
        -- take care to allow for expressions with different result type
        !questionExpression.delete()
      endif
    endif
  enddo

  -- Get details of items with matching answers
  !matchItems = ARRAY()

  do !itemVal values !this.items

    -- Ignore inactive items
    skip if (!itemVal.lactive.not())

    -- Set match flag
    !matchFlag = true

    -- Set the match flag to false if any answers do NOT match
    do !ind indices !this.heading.members

      -- Don't match item if unable to evaluate expression question
      if (!answers[!ind].objectType() eq |EXPRESSION|) then
        !matchFlag = false
        break
      endif

      -- Skip unset answers (i.e. match item if answer is unset)
      skip if (!answers[!ind].unset())

      -- Get answer details
      !tableAnswer = !this.getAnswerRaw(!itemVal, !ind)

      -- Skip unset table answers (i.e. match item if table answer is unset)
      skip if (!tableAnswer[1].unset())

      -- Check for text answer
      if (!tableAnswer[2] eq |TEXT|) then
        if (!tableAnswer[1] ne !answers[!ind]) then
          !matchFlag = false
          break
        endif

      -- Check for word answer
      elseif (!tableAnswer[2] eq |WORD|) then
        if (!tableAnswer[3] eq |SING|) then
          if (!tableAnswer[1] ne !answers[!ind]) then
            !matchFlag = false
            break
          endif
        elseif (!tableAnswer[3] eq |MULT|) then
          if (!tableAnswer[1].findFirst(!answers[!ind]).unset()) then
            !matchFlag = false
            break
          endif
        endif

      -- Check for real answer
      elseif (!tableAnswer[2] eq |REAL|) then
        if (!tableAnswer[3] eq |SING|) then
          if (!tableAnswer[1] ne !answers[!ind]) then
            !matchFlag = false
            break
          endif
        elseif (!tableAnswer[3] eq |MULT|) then
          if (!tableAnswer[1].findFirst(!answers[!ind]).unset()) then
            !matchFlag = false
            break
          endif
        elseif (!tableAnswer[3] eq |RANG|) then
          if (!tableAnswer[1] lt !answers[!ind][1] or !tableAnswer[1] gt !answers[!ind][2] ) then
            !matchFlag = false
            break
          endif
        endif

      -- Check for boolean answer
      elseif (!tableAnswer[2] eq |BOOL|) then
        if (!tableAnswer[1] ne !answers[!ind]) then
          !matchFlag = false
          break
        endif

      endif
    enddo

    -- If all answers match then add to list
    if (!matchFlag) then
      !matchItems.append(!itemVal)
    endif

  enddo

  -- Restore current element
  !!ce = !dbpos

  return !matchItems

endmethod
-- End of method definition for .chooseItems(DBREF, ARRAY, ARRAY, BOOLEAN)ARRAY

------------------------------------------------------------------------
--
-- Method:      choose()
--
-- Description: Choose table items in Design.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Design element for choose operation
--    2   R      STRING      Return option (RAW, TEXT)
--    3   R      BOOLEAN     Default flag (true = use defaults, false = don't use defaults)
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Item details for table items matching the choose criteria
--
------------------------------------------------------------------------
define method .choose(!designItem is DBREF, !option is STRING, !default is BOOLEAN) is ARRAY

  -- Choose items
  !chooseItems = !this.choose(!designItem, object ARRAY(), object ARRAY(), !option, !default)
  return !chooseItems

endmethod
-- End of method definition for .choose(DBREF, STRING, BOOLEAN)ARRAY

------------------------------------------------------------------------
--
-- Method:      choose()
--
-- Description: Choose table items in Design.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Return option (RAW, TEXT)
--    2   R      BOOLEAN     Default flag (true = use defaults, false = don't use defaults)
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Item details for table items matching the choose criteria
--
------------------------------------------------------------------------
define method .choose(!option is STRING, !default is BOOLEAN) is ARRAY

  -- Choose items
  !chooseItems = !this.choose(object DBREF(), object ARRAY(), object ARRAY(), !option, !default)
  return !chooseItems

endmethod
-- End of method definition for .choose(STRING, BOOLEAN)ARRAY

------------------------------------------------------------------------
--
-- Method:      choose()
--
-- Description: Choose table items in Design.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Design element for choose operation
--    2   R      ARRAY       Array of question purposes
--    3   R      ARRAY       Array of matching answers
--    4   R      STRING      Return option (RAW, TEXT)
--    5   R      BOOLEAN     Default flag (true = use defaults, false = don't use defaults)
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Item details for table items matching the choose criteria
--
------------------------------------------------------------------------
define method .choose(!designItem is DBREF, !questions is ARRAY, !chooseAnswers is ARRAY, !option is STRING, !default is BOOLEAN) is ARRAY

  -- Check option string
  if (!option.upcase() ne |RAW| and !option.upcase() ne |TEXT|) then
    return error 1 |Option string must be 'RAW' or 'TEXT'!|
  endif

  -- Choose items
  !chooseItems = !this.chooseItems(!designItem, !questions, !chooseAnswers, !default)

  -- Set the current heading columns to that in the current CTABLE
  !currentHeadings = ARRAY()
  do !q value !this.getQuestions()
    !currentHeadings.append(!q[1])
  enddo

  -- Get item details
  !items = ARRAY()
  do !ind indices !chooseItems
    !items[!ind]   = !this.getItemRaw(!chooseItems[!ind], !this.stdGpartAtts, !currentHeadings)
    if (!option.upcase() eq |TEXT|) then
      !items[!ind] = !this.convertItemToString(!items[!ind])
    endif
    -- Delete first array element because it will have the wrong type. Replace by item DBREF
    !items[!ind][1].delete()
    !items[!ind][1] = !chooseItems[!ind]
  enddo

  return !items

endmethod
-- End of method definition for .choose(DBREF, ARRAY, ARRAY, STRING, BOOLEAN)ARRAY

------------------------------------------------------------------------
--
-- Method:      choose()
--
-- Description: Choose table items in Design.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Array of question purposes
--    2   R      ARRAY       Array of matching answers
--    3   R      STRING      Return option (RAW, TEXT)
--    4   R      BOOLEAN     Default flag (true = use defaults, false = don't use defaults)
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Item details for table items matching the choose criteria
--
------------------------------------------------------------------------
define method .choose(!questions is ARRAY, !chooseAnswers is ARRAY, !option is STRING, !default is BOOLEAN) is ARRAY

  -- Check option string
  if (!option.upcase() ne |RAW| and !option.upcase() ne |TEXT|) then
    return error 1 |Option string must be 'RAW' or 'TEXT'!|
  endif

  -- Choose items
  !chooseItems = !this.choose(object DBREF(), !questions, !chooseAnswers, !option, !default)
  return !chooseItems

endmethod
-- End of method definition for .choose(ARRAY, ARRAY, STRING, BOOLEAN)ARRAY

------------------------------------------------------------------------
--
-- Method:      chooseSpecificItem()
--
-- Description: Return item details for the given item without filtering
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Table Item element for choose operation
--    2   R      STRING      Return option (RAW, TEXT)
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       Item details for table items matching the choose criteria
--
------------------------------------------------------------------------
define method .chooseSpecificItem(!tableItem is DBREF, !option is STRING) is ARRAY

  -- Initialise return array
  !items = object ARRAY()

  -- Check option string
  if (!option.upcase() ne |RAW| and !option.upcase() ne |TEXT|) then
    return error 1 |Option string must be 'RAW' or 'TEXT'!|
  endif

  if ( badref(!tableItem) ) then
    return error 1 |Unknown selection table item|
  endif

  if (!option.upcase() eq |RAW|) then
    !items= !this.getItemRaw(!tableItem, !this.stdGpartAtts).from(2)
    handle any
      return error 1 |Invalid selection table item|
    endhandle
  elseif (!option.upcase() eq |TEXT|) then
    !items = !this.getItem(!tableItem).from(2)
    handle any
      return error 1 |Invalid selection table item|
    endhandle
  endif

  return !items

endmethod
-- End of method definition for .chooseSpecificItem(DBREF, STRING)ARRAY

------------------------------------------------------------------------
--
-- Method:      select()
--
-- Description: Select table items in Design.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Design element
--    2   R      DBREF       Table item
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .select(!designItem is DBREF, !tableItem is DBREF)

  -- Spref on design item
  --!designItem.spref = !tableItem
  !designItem.spref = !tableItem.prtref

  -- Set attributes if required
  do !ind indices !this.heading.members
    if (!this.heading.members[!ind].qtype eq |ATTR|) then
      !attName = !this.heading.members[!ind].attset
      !attVal = !this.getAnswerRaw(!tableItem, !ind)[1]
      !designItem.attribute(!attName) = !attVal
    endif
  enddo

endmethod
-- End of method definition for .select(DBREF, DBREF)
