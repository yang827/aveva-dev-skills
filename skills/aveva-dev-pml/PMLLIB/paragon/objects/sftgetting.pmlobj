-- Description:
--   Object getting information which related to surface treatment
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getAllPaintCode()                ARRAY               Getting all paint elements
--  getAllSurfaceCode()              ARRAY               Getting all surface treatment elements
--  getPaintPoint()                  BOOLEAN             Getting Paint Code point
--  getSurfacePoint()                BOOLEAN             Getting Surface Code point
--  sftgetting()                     -
--
------------------------------------------------------------------------

define object SFTGETTING
   member .cataPoint         is  ARRAY
   member .paintPoint        is  ARRAY
   member .surfacePoint      is  ARRAY

endobject
-- End of object definition


------------------------------------------------------------------------
--
-- Method:      SFTGETTING
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .sftgetting()

-- This constructor unused at present
   !this.paintPoint.clear()
   !this.surfacePoint.clear()
   !this.cataPoint.clear()

-- Getting CATALOG Point
--   !this.getCataPoint()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      .getPaintPoint()
--
-- Description: Getting Paint Code point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getPaintPoint() is BOOLEAN

   !this.paintPoint = object ARRAY()
   !paintall = object ARRAY()

   do !idx index !this.cataPoint
       var !insertpoint collect all CATE with PURP eq 'PAIN' for $!this.cataPoint[$!idx]
       if (!insertpoint.size().eq(0) ) then
           var !insertpoint collect all SECT with PURP eq 'PAIN' for $!this.cataPoint[$!idx]
       endif
       !paintall.appendArray(!insertpoint)
   enddo

   if (!paintall.unset() OR !paintall.size().eq(0)) then
       return FALSE
   else
   !this.paintPoint = !paintall
   return TRUE
   endif

endmethod
-- End of method definition for .GetFacePoint()

------------------------------------------------------------------------
--
-- Method:      .getSurfacePoint()
--
-- Description: Getting Surface Code point
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getSurfacePoint() is BOOLEAN

   !this.surfacePoint = object ARRAY()
   !surfaceall = object ARRAY()

   do !idx index !this.cataPoint
      var !insertpoint collect all CATE with PURP eq 'SURF' for $!this.cataPoint[$!idx]
      if (!insertpoint.size().eq(0) ) then
          var !insertpoint collect all SECT with PURP eq 'SURF' for $!this.cataPoint[$!idx]
      endif
      !surfaceall.appendArray(!insertpoint)
   enddo

   if (!surfaceall.unset() OR !surfaceall.size().eq(0)) then
       return FALSE
   else
   !this.surfacePoint = !surfaceall
   return TRUE
   endif

endmethod
-- End of method definition for .getSurfacePoint()

------------------------------------------------------------------------
--
-- Method:      .getAllPaintCode()
--
-- Description: Getting all paint elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getAllPaintCode() is ARRAY
-- Currently restricted to single CATE or SECT - needs to handle multiples!
   !allpaints = object ARRAY()
   do !idx index !this.paintPoint
      !scope = !this.paintPoint[!idx].dbref()
      var !rtnArray collect all PAINT for $!scope
      !allpaints.appendArray(!rtnArray)
   enddo

   return !allpaints

endmethod
-- End of method definition for .getAllPaintCode()

------------------------------------------------------------------------
--
-- Method:      .getAllSurfaceCode()
--
-- Description: Getting all surface treatment elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getAllSurfaceCode() is ARRAY
-- Currently restricted to single CATA or SECT - needs to handle multiples!
   !allsrftrt = object ARRAY()
   do !idx index !this.surfacePoint
      !scope = !this.surfacePoint[!idx].dbref()
      var !rtnArray collect all SRFTRT for $!scope
      !allsrftrt.appendArray(!rtnArray)
   enddo

   return !allsrftrt

endmethod
-- End of method definition for .getAllSurfaceCode()
