--
--
-- Description:
-- This represents a mapping from PCONN to the most common CKEY
-- associated with it
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(ARRAY)                       -
--  getCommonCKey(STRING)            STRING
--  print()                          -                   Print out for debugging
--
------------------------------------------------------------------------

define object SPCPCONNLIST

  -- Array of PCONNs
  member .pConns is ARRAY

  -- Parallel array of most common cKeys
  member .cKeys is ARRAY
endobject
-- End of object definition for SPCPCONNLIST

------------------------------------------------------------------------
--
-- Method:      .add (ARRAY)
--
-- Description: Add COCO elements to this
--
-- Method Type: Procedure
-- Arguments:
--    1   R     ARRAY       Array of COCO elements
--
------------------------------------------------------------------------

define method .add(!cocoArray is ARRAY)
  -- Array of arrays. This is a parallel array to PConns and maps a pcon
  -- to a list of associated CKEYs
  !cKey2Array = ARRAY()

  -- Similar to above, but the frequency of a CKEY is recorded rather than
  -- a CKEY name
  !numCKey2Array = ARRAY()

  do !cocoE values !cocoArray
    !cocoElem = !cocoE.dbRef()

    -- Get Connection types and cKey
    !firstConnType = !cocoElem.cType[1]
    !secondConnType = !cocoElem.cType[2]
    !cKey = !cocoElem.cKey

    if (!cKey EQ '') then
      !cKey = 'Unset'
    endif

    -- Find the PCONN in the PCONN array
    !pConnsIndex = !this.pConns.findFirst (!firstConnType)

    if (!pConnsIndex.set()) then
      -- Find the array of CKEYs associated with the pconn
      !cKeysIndex = !cKey2Array [!pConnsIndex].findFirst(!cKey)

      if (!cKeysIndex.set()) then
        -- The same CKEY has already been associated with the PCONN,
        -- so increment the frequency.
        !numCKey2Array [!pConnsIndex] [!cKeysIndex] = $
              !numCKey2Array [!pConnsIndex] [!cKeysIndex] + 1
      else
        -- No CKEY has been associated with the PCONN, so add the
        -- new CKEY and set the frequency to 1.
        !cKey2Array [!pConnsIndex].append(!cKey)
        !numCKey2Array [!pConnsIndex].append(1)
      endif
    else
      -- This PCONN has not been encounter before so add it and
      -- set associated CKEY and its frequency (1)
      !cKeyArray = ARRAY()
      !numCKeyArray = ARRAY()

      !cKeyArray.append (!cKey)
      !numCKeyArray.append (1)

      !this.pConns.append(!firstConnType)
      !cKey2Array.append(!cKeyArray)
      !numCKey2Array.append(!numCKeyArray)
    endif

    !pConnsIndex = !this.pConns.findFirst (!secondConnType)

    if (!pConnsIndex.set()) then
      !cKeysIndex = !cKey2Array [!pConnsIndex].findFirst(!cKey)

      if (!cKeysIndex.set()) then
        !numCKey2Array [!pConnsIndex] [!cKeysIndex] = $
              !numCKey2Array [!pConnsIndex] [!cKeysIndex] + 1
      else
        !cKey2Array [!pConnsIndex].append(!cKey)
        !numCKey2Array [!pConnsIndex].append(1)
      endif
    else
      !cKeyArray = ARRAY()
      !numCKeyArray = ARRAY()

      !cKeyArray.append (!cKey)
      !numCKeyArray.append (1)

      !this.pConns.append(!secondConnType)
      !cKey2Array.append(!cKeyArray)
      !numCKey2Array.append(!numCKeyArray)
    endif

  enddo

  do !pConnIndex indices !this.pConns
    !maxCKey = 'Ambiguous'
    !sum = 0

    do !numCKey2Num values !numCKey2Array[!pConnIndex]
      !sum = !sum + !numCKey2Num
    enddo

    do !cKey2Index indices !cKey2Array[!pConnIndex]

      if (!numCKey2Array[!pConnIndex][!cKey2Index] GEQ !sum * 0.75) then
        !maxCKey = !cKey2Array[!pConnIndex][!cKey2Index]
      endif
    enddo

    !this.cKeys[!pConnIndex] = !maxCKey
  enddo
endmethod
-- End of method definition for .add(ARRAY)


------------------------------------------------------------------------
--
-- Method:      .getCommonCKey(STRING) is STRING
--
-- Description: get the most commonly associated CKEY for a CTYPE
--
-- Method Type: Function
-- Arguments:
--    1   R     STRING      Connection type
-- Return:
--   STRING                 Most commonly associated CKEY
--
------------------------------------------------------------------------

define method .getCommonCKey(!connType is STRING) is STRING
  !pConnIndex = !this.pConns.findFirst (!connType)

  if (!pConnIndex.set()) then
    !cKey = !this.cKeys[!pConnIndex]
  else
    !cKey = 'Not Found'
  endif

  return (!cKey)
endmethod
-- End of method definition for .getCommonCKey(STRING) STRING


------------------------------------------------------------------------
--
-- Method:      .print()
--
-- Description: Print out for debugging
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--
------------------------------------------------------------------------

define method .print()
  do !pConnIndex indices !this.pConns
    !output = !this.pConns[!pConnIndex] & ' ' & !this.cKeys[!pConnIndex]
    QUERY VARIABLE !output
  enddo
endmethod
-- End of method definition for .print()
