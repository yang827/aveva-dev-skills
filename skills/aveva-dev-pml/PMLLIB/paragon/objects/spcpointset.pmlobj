--
--
-- Description:
-- PointSet represents a PTSET element for the purpose of applying a
-- rule to the points under it
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyRule(SPCSKEYRULE,ARRAY)     -                   Apply a rule to the points underneath this
--  print(ARRAY)                     -                   Print out this
--  spcPointSet(DBREF,DBREF)         -
--
------------------------------------------------------------------------

define object SPCPOINTSET
  member .pointSetRef is DBREF

  member .catRef is DBREF

  member .skeys is ARRAY
endobject
-- End of object definition for SPCPOINTSET

------------------------------------------------------------------------
--
-- Method:      pointSet
--
-- Description: Initialise this with dbref and theCatref
--
-- Method Type: Procedure
-- Arguments:
--   1 R  DBREF Database element of the pointset this is to represent
--   2 R  DBREF Database element of the referencing SCOMPONENT
--
------------------------------------------------------------------------

define method .spcPointSet(!dbRef is DBREF, !theCatref is DBREF)
  !this.pointSetRef = !dbRef
  !this.catRef = !theCatref
endmethod
-- End of method definition for .spcPointSet(DBREF, DBREF)

------------------------------------------------------------------------
--
-- Method:      print
--
-- Description: Print out this
--
-- Method Type: Procedure
-- Arguments:
--   1 RW ARRAY(STRING)  Output text
-- Return:
--
------------------------------------------------------------------------

define method .print(!output is ARRAY)
  !output.append('  Catalogue component P-points:-')
  !output.append('P-point number |  Connection type')
  !output.append('---------------|-----------------')

  do !point values !this.pointSetRef.members
     -- Skip unset PCONs
     skip if (!point.pcon eq '0')
     skip if (!point.pcon eq 'NULL')

     if (match(!point.pconnection,'PARAM') gt 0) then
       var !param SPLIT PARAM OF $!<this.catRef>

       !index = REAL(after(!point.pconnection,'PARAM'))

       !output.append('        ' & !point.number &$
                      '      |      ' & !param[!index] &$
                      '          PARAM ' & !index &$
                      ' of ' & !this.catRef.name)
     else
       !output.append('        ' & !point.number &$
                      '      |      ' & !point.pcon &$
                      '          ' & !this.catRef.type &$
                      '  ' & !this.catRef.name)
     endif
  enddo
endmethod
-- End of method definition for .print(ARRAY)

------------------------------------------------------------------------
--
-- Method:      applyRule
--
-- Description: Apply a rule to the points underneath this
--
-- Method Type: Procedure
-- Arguments:
--   1 R  SKeyRule      Rule to apply
--   2 RW ARRAY(STRING) Error messages
-- Return:
--
------------------------------------------------------------------------

define method .applyRule(!rule is SPCSKEYRULE, !errors is ARRAY)
  -- Ignore null rules
  if (not !rule.isNull()) then

    do !memIndex indices !this.pointSetRef.members
      !pconstr = !this.pointSetRef.members[!memIndex].pcon
      !pPointNum = !this.pointSetRef.members[!memIndex].number
      !newConnType = !rule.getRule(!pPointNum)

      -- Check there is a rule defined for this point
      if (!newConnType neq '') then

        if (match(!pconstr, 'PARAM') gt 0) then
          -- Need to change param on referencing SCOMPONENT
          !okToChange = TRUE
          !paraNum = REAL(after(!pconstr,'PARAM'))

          do !memInd indices !this.pointSetRef.members
            -- Check altering this parameter would not conflict with other
            -- point rules using the same param

            !memElem = !this.pointSetRef.members[!memInd]

            if (!pconstr eq !memElem.pcon and $
                !newConnType neq !rule.getRule(!memElem.number)) then

              !errors.append('Error setting param ' & !paraNum & $
                             ' of ' & !this.catRef.name & ' to ' & !newConnType & $
                             ' for symbol key ' & !rule.skey)
              !okToChange = FALSE
            endif
          enddo

          if (!okToChange) then
            !saveCe = !!ce
            !!ce = !this.catRef

            param num $!paraNum $!newConnType

            !!ce = !saveCe
          endif
        else
          -- Need to change actual pcon on point
          PCON $!newConnType
        endif
      endif
    enddo
  endif
endmethod
-- End of method definition for .applyRule(SPCSKEYRULE, ARRAY)
