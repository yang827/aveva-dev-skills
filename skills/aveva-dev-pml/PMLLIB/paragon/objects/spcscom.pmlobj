--
-- Author:          S.Bourne
-- Created:         Wed Jul 8 09:13:44 BST 1998
--
--
-- Description:
-- This represents an SCOM element
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  anyCKeyForPConn(SPCPCONNLIST,STRING) BOOLEAN
--  anyPSKeySet()                    BOOLEAN
--  check()                          BOOLEAN
--  getPConn(DBREF)                  STRING
--  getPConns()                      ARRAY
--  getPSKey(DBREF)                  STRING
--  getPSKeys()                      ARRAY
--  getReport()                      STRING
--  pConnsEqualTo(ARRAY)             BOOLEAN
--  setPconns(ARRAY,ARRAY,ARRAY,SPCSCOMCACHE) -                   Set the PCONNS associated with this SCOM to the
--  spcScom(DBREF)                   -                   Constructor
--
------------------------------------------------------------------------

define object SPCSCOM

  -- DBREF of SCOM element
  member .scomRef is DBREF

endobject
-- End of object definition for SPCSCOM

------------------------------------------------------------------------
--
-- Method:      .spcScom(DBREF)
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--    1   R      DBREF      DBREF of the SCOM this is to represent
-- Return:
--
------------------------------------------------------------------------

define method .spcScom(!theSComRef is DBREF)
  !this.scomRef = !theSComRef
endmethod
-- End of method definition for .spcScom(DBREF)


------------------------------------------------------------------------
--
-- Method:      .anyPSKeySet() is BOOLEAN
--
-- Description: Return TRUE iff any PSKEY was set.
--
-- Method Type: Function
-- Arguments:
-- Return:
--   BOOLEAN     TRUE iff any PSKEY was set.
--
------------------------------------------------------------------------

define method .anyPSKeySet() is BOOLEAN
  !result = FALSE

  do !point values !this.scomRef.ptref.members
    if (!point.pskey NEQ '') then
      !result = TRUE
    endif
  enddo

  return (!result)
endmethod
-- End of method definition for .anyPSKeySet() BOOLEAN


------------------------------------------------------------------------
--
-- Method:      .getPSKey(!point is DBREF) is STRING
--
-- Description: Get a PSKEY value
--
-- Method Type: Function
-- Arguments:
--    1   R     DBREF of Point
-- Return:
--   STRING     PSKEY value
--
------------------------------------------------------------------------

define method .getPSKey(!point is DBREF) is STRING
  if (!point.pskey NEQ '') then
    !pSKeyText = !point.pskey
  else
    !pSKeyText = 'NULL'
  endif

  return (!pSKeyText)
endmethod
-- End of method definition for .getPSKey(DBREF) STRING


------------------------------------------------------------------------
--
-- Method:      .getPSKeys() is ARRAY
--
-- Description: Get an array of PSKEY values
--
-- Method Type: Function
-- Arguments:
-- Return:
--   ARRAY       Array of PSKEY values
--
------------------------------------------------------------------------

define method .getPSKeys() is ARRAY
  !pSKeys = ARRAY()

  do !point values !this.scomRef.ptref.members
    !pSKeys.append(!this.getPSKey(!point))
  enddo

  return (!pSKeys)
endmethod
-- End of method definition for .getPSKeys() ARRAY


------------------------------------------------------------------------
--
-- Method:      .getPConn(DBREF) is STRING
--
-- Description: Get a PCONN value
--
-- Method Type: Function
-- Arguments:
--    1   R     DBREF of Point
-- Return:
--   STRING       PCONN value
--
------------------------------------------------------------------------

define method .getPConn(!point is DBREF) is STRING
  !connType = !point.pConn.string()

  if (!connType.match('PARAM') NEQ 0) then
    TRACE OFF
    !oldCe = !!ce

    !!ce = !this.scomRef

    !paramNum = REAL(after(!connType,'PARAM'))

    !connType.delete()

    var !connType PARAM $!paramNum

    !!ce = !oldCe
  endif

  return (!connType)
endmethod
-- End of method definition for .getPConn(DBREF) STRING


------------------------------------------------------------------------
--
-- Method:      .getPConns() is ARRAY
--
-- Description: Get an array of PCONN values
--
-- Method Type: Function
-- Arguments:
-- Return:
--   ARRAY       Array of PCONN values
--
------------------------------------------------------------------------

define method .getPConns() is ARRAY
  !connTypeArray = ARRAY()

  do !point values !this.scomRef.ptref.members
    !connType = !this.getPConn(!point)

    if (!connType NEQ '0' AND !connType NEQ 'NULL' AND !connType NEQ 'NUL') then
      !connTypeArray.append(!connType)
    endif
  enddo

  return (!connTypeArray)
endmethod
-- End of method definition for .getPConns() ARRAY



------------------------------------------------------------------------
--
-- Method:      .anyCKeyForPConn(SPCPCONNLIST, STRING) is BOOLEAN
--
-- Description: Return TRUE iff there is a PCONN with
--              a common CKEY equal to STRING
--
-- Method Type: Function
-- Arguments:
--    1   R     SPCPCONNLIST    Mapping from PCONN to most commonly
--                              associated CKEY
--    2   R     STRING          CKey
-- Return:
--   BOOLEAN                    Return TRUE iff there is a PCONN with
--                              a common CKEY equal to STRING
--
------------------------------------------------------------------------

define method .anyCKeyForPConn(!pConnList is SPCPCONNLIST, !cKey is STRING) is BOOLEAN
  !cKeyFound = FALSE
  !cTypeArray = !this.getPConns()

  do !cType values !cTypeArray
    if (!pConnList.getCommonCKey (!cType) EQ !cKey) then
      !cKeyFound = TRUE
    endif
  enddo

  return (!cKeyFound)
endmethod
-- End of method definition for .anyCKeyForPConn(SPCPCONNLIST, STRING) BOOLEAN


------------------------------------------------------------------------
--
-- Method:      .getReport() is STRING
--
-- Description: Get a report on SCOM
--
-- Method Type: Function
-- Arguments:
-- Return:
--   STRING      Report text
--
------------------------------------------------------------------------

define method .getReport() is STRING
  if (!this.scomRef.ptref.set() AND !this.scomRef.type EQ 'SCOM') then
    !report = ''

    do !point values !this.scomRef.ptref.members
      !pConnText = !this.getPConn(!point)
      !pSKeyText = !this.getPSKey(!point)

      if (!pConnText NEQ '0' AND !pConnText NEQ 'NULL' AND !pConnText NEQ 'NUL') then
        !report = !report & ',' & !pConnText

        if (!pSKeyText NEQ 'NULL' AND !pSKeyText NEQ 'NUL') then
          !report = !report & ' (' & !pSKeyText & ')'
        endif
      endif
    enddo
  else
    !report = ',Bad PTRef'
  endif

  return (!report)
endmethod
-- End of method definition for .getReport() STRING


------------------------------------------------------------------------
--
-- Method:      .check() is BOOLEAN
--
-- Description: Check this SCOM doesn't have any potential problems
--
-- Method Type: Function
-- Arguments:
-- Return:
--   BOOLEAN     TRUE iff there are no potential problems
--
------------------------------------------------------------------------

define method .check() is BOOLEAN
  if (!this.scomRef.ptref.unset()) then
    !result = FALSE
  else
    !result = TRUE
  endif

  return (!result)
endmethod
-- End of method definition for .check() BOOLEAN


------------------------------------------------------------------------
--
-- Method:      .pConnsEqualTo(ARRAY) is BOOLEAN
--
-- Description: See if the PCONNS associated with this SCOM match the
--              given PCONNS
--
-- Method Type: Function
-- Arguments:
--  1 R ARRAY   PCONNs to compare with (can include wildcards)
-- Return:
--   BOOLEAN    TRUE iff the PCONNS associated with this SCOM match the
--              given PCONNS
--
------------------------------------------------------------------------

define method .pConnsEqualTo(!pConns is ARRAY) is BOOLEAN
  !thisPConns = !this.getPConns()

  if (!pConns.size() EQ !thisPConns.size()) then
    !equal = TRUE

    do !pConnIndex indices !thisPConns
      if (Defined(!pConns[!pConnIndex])) then
        if (NOT !thisPConns[!pConnIndex].matchWild(!pConns[!pConnIndex])) then
          !equal = FALSE
        endif
      else
        !equal = FALSE
      endif

      break if NOT !equal
    enddo
  else
    !equal = FALSE
  endif

  return (!equal)
endmethod
-- End of method definition for .pConnsEqualTo(ARRAY) BOOLEAN


------------------------------------------------------------------------
--
-- Method:      .setPconns(ARRAY, ARRAY)
--
-- Description: Set the PCONNS associated with this SCOM to the
--              given PCONNS
--
-- Method Type: Procedure
-- Arguments:
--   1   R   ARRAY          New PCONNs
--   2   RW  ARRAY          Array of problems encountered
--   3   RW  ARRAY          Array of strings to output to file
--   4   RW  SPCSCOMCACHE   SCOM object cache
--
------------------------------------------------------------------------

define method .setPconns(!pConns is ARRAY, !errors is ARRAY, !changes is ARRAY, !cache is SPCSCOMCACHE)

  if (!this.scomRef.ptref.set()) then

    do !point values !this.scomRef.ptref.members
      !pPointNum = !point.number

      if (Defined (!pConns[!pPointNum])) then
        !pconstr = !point.pConn
        !newConnType = !pConns[!pPointNum]

        if (match(!pconstr, 'PARAM') gt 0) then
          -- Need to change param on referencing SCOMPONENT
          !okToChange = TRUE
          !paraNum = REAL(after(!pconstr,'PARAM'))

          do !memInd indices !this.scomRef.ptref.members
            -- Check altering this parameter would not conflict with other
            -- point rules using the same param

            !memElem = !this.scomRef.ptref.members[!memInd]

            if (!pconstr eq !memElem.pcon) then
              -- This may affect other PCONNs
              if (Undefined (!pConns[!memElem.number])) then

                !errors.append('    Error setting param ' & !paraNum & $
                               ' of ' & !this.scomRef.name & ' to ' & !newConnType)
                !okToChange = FALSE
              elseif (!pConns[!memElem.number] NEQ !newConnType) then
                -- Changing the PCONN would change another PCONNs value
                !errors.append('    Error setting param ' & !paraNum & $
                               ' of ' & !this.scomRef.name & ' to ' & !newConnType)
                !okToChange = FALSE
              endif
            endif
          enddo

          if (!okToChange) then
            TRACE OFF
            !saveCe = !!ce
            !!ce = !this.scomRef

            var !oldVal PARAM $!paraNum

            -- store data in scom object cache
            !cacheData[1] = !this.scomRef.fullName
            !cacheData[2] = 'PARAM NUM ' & !paraNum.string() & ' ' & !oldVal
            !fromString = !cache.store(!this.scomRef, !paraNum, !cacheData)

            if (!oldVal ne !newConnType) then
              PARAM NUM $!paraNum $!newConnType
              !changes.append('')
              !changes.append('-- SCOM:  ' & !this.scomRef.fullName)
              !changes.append('-- Changed parameter ' & !paraNum & ' from ' & !oldVal & ' to ' & !newConnType)
              !changes.append('-- ' & !this.scomRef.fullName)
              !changes.append('-- PARAM NUM ' & !paraNum.string() & ' ' & !newConnType)
              !changes.append('-- The following commands will undo the changes')
              !changes.appendArray(!fromString)
            endif

            !!ce = !saveCe
          endif
        else
          TRACE OFF
          !saveCe = !!ce
          !!ce = !point

          !oldVal = !point.pcon
          -- Need to change actual pcon on point
          -- store data in scom object cache
          !cacheData[1] = !point.fullName
          !cacheData[2] = 'PCON ' & !oldVal
          !fromString = !cache.store(!point, 1, !cacheData)

          if (!oldVal ne !newConnType) then
            PCON $!newConnType
            !changes.append('')
            !changes.append('-- ' & !point.type & ':  ' & !point.fullName)
            !changes.append('-- Changed pcon from ' & !oldVal & ' to ' & !newConnType)
            !changes.append('-- ' & !point.fullName)
            !changes.append('-- PCON ' & !newConnType)
            !changes.append('-- The following commands will undo the changes')
            !changes.appendArray(!fromString)
          endif

          !!ce = !saveCe
        endif
      endif
    enddo
  endif
endmethod
-- End of method definition for .setPconns(ARRAY, ARRAY, ARRAY, SPCSCOMCACHE)
