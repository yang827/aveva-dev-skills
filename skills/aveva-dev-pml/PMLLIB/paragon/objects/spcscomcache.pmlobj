--
--
-- Description:
-- This stores information for SCOM element that have been modified
-- by the .setPconns method of the SPCSCOM object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  store(DBREF,REAL,ARRAY)          ARRAY               Store data for dbref and return stored data
--
------------------------------------------------------------------------

define object SPCSCOMCACHE

  -- DBREF ARRAY to act as reference table
  member .scomIndex is ARRAY

  -- 3 dimensional sparse array to store cached data
  member .data is ARRAY

endobject
-- End of object definition for SPCSCOMCACHE


------------------------------------------------------------------------
--
-- Method:      .store(DBREF, REAL, ARRAY)
--
-- Description: Store data in the object
--
-- Method Type: Procedure
-- Arguments:
--    1   R      DBREF      DBREF of the SCOM
--    2   R      REAL       Parameter number
--    3   R      ARRAY      Strings to store
-- Return:
--    ARRAY      Array of stored strings
------------------------------------------------------------------------
define method .store(!scom is DBREF, !parameter is REAL, !data is ARRAY) is ARRAY

  -- check that the scom has not been added previously
  !index = !this.scomIndex.findFirst(!scom)

  if (!index.unset()) then
    !this.scomIndex.append(!scom)
    !this.data[!this.scomIndex.size()][!parameter] = !data
    !returnData = !data
  elseif (undefined(!this.data[!index][!parameter])) then
    !this.data[!index][!parameter] = !data
    !returnData = !data
  else
    !returnData = !this.data[!index][!parameter]
  endif

  return !returnData

endmethod
-- End of method definition for .store(DBREF, REAL, ARRAY) ARRAY
