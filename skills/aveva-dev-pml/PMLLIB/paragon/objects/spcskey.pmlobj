--
--
-- Description:
-- SKey represents an SDTEXT database element and contains references
-- to any point sets associated with that SKey
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getName()                        STRING              Get the name of this skey
--  print(ARRAY)                     -                   Print out this SKey
--  spcSkey(DBREF)                   -
--
------------------------------------------------------------------------

define object SPCSKEY
  -- DBRef of SDTEXT element
  member .skeyRef is DBREF

  -- References to any associated point sets.
  member .pointSets is ARRAY
endobject
-- End of object definition for SPCSKEY

------------------------------------------------------------------------
--
-- Method:      sKey
--
-- Description: Initialisation
--
-- Method Type: Procedure
-- Arguments:
--   1 R  DBREF  database element of the skey
--
------------------------------------------------------------------------

define method .spcSkey(!dbRef is DBREF)
  !this.skeyRef = !dbRef
endmethod
-- End of method definition for .spcSkey(DBREF)

------------------------------------------------------------------------
--
-- Method:      getName
--
-- Description: Get the name of this skey
--
-- Method Type: Procedure
-- Arguments:
-- Return:
--   STRING     Name of this skey.
--
------------------------------------------------------------------------

define method .getName() is STRING
  return !this.skeyRef.skey
endmethod
-- End of method definition for .getName() STRING

------------------------------------------------------------------------
--
-- Method:      print
--
-- Description: Print out this SKey
--
-- Method Type: Procedure
-- Arguments:
--   1 R  ARRAY(STRING)  Output text
-- Return:
--
------------------------------------------------------------------------

define method .print(!output is ARRAY)
  !output.append('')
  !output.append('SKEY ' & !this.skeyRef.skey)
  !output.append('=========')
  !output.append('')
endmethod
-- End of method definition for .print(ARRAY)
