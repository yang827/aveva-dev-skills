--   Module:        paragon
--   Replaces:
--
-- Author:          S.Bourne
-- Created:         Wed Jul 8 09:13:44 BST 1998
--
--
-- Description:
-- SKeyRule defines the connection types associated with a given skey
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getRule(REAL)                    STRING              Get the pcon for a rule
--  includePPRule(REAL,STRING)       BOOLEAN             Add a rule for the connection type of a ppoint
--  isNull()                         BOOLEAN             Return TRUE iff this rule is a null rule
--  print(ARRAY,STRING)              -
--  removePPRule(REAL)               -                   Remove a rule for a ppoint
--  replacePPRule(REAL,STRING)       BOOLEAN             Add a rule for the connection type of a ppoint
--
------------------------------------------------------------------------

define object SPCSKEYRULE
  -- SKey name
  member .skey is STRING

  -- Rules for ppoint associated with skey
  member .pointRules is ARRAY
endobject
-- End of object definition for SPCSKEYRULE

------------------------------------------------------------------------
--
-- Method:      getRule
--
-- Description: Get the pcon for a rule
--
-- Method Type: Function
-- Arguments:
--   [1 R  REAL             ppoint number
-- Return:
--   STRING                 pcon for given ppoint
--
------------------------------------------------------------------------

define method .getRule(!pPoint is REAL) is STRING
  !result = ''

  do !pointRuleElem values !this.pointRules
    if (!pointRuleElem.pPoint eq !pPoint) then
      !result = !pointRuleElem.connType
    endif
  enddo

  return !result
endmethod
-- End of method definition for .getRule(REAL) STRING

------------------------------------------------------------------------
--
-- Method:      isNull
--
-- Description: Return TRUE iff this rule is a null rule
--
-- Method Type: Function
-- Arguments:
-- Return:
--   BOOLEAN    TRUE iff this rule is a null rule
--
------------------------------------------------------------------------

define method .isNull() is BOOLEAN
  return (!this.pointRules.empty())
endmethod
-- End of method definition for .isNull() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      includePPRule
--
-- Description: Add a rule for the connection type of a ppoint
--
-- Method Type: Procedure
-- Arguments:
--   1 R  REAL   ppoint number
--   2 R  STRING new connection type
--
------------------------------------------------------------------------

define method .includePPRule(!pPoint is REAL, !connType is STRING) is BOOLEAN
  !done = FALSE

  -- Don't bother with undefined rules
  if (trim(!connType) neq '' and trim(!this.getRule(!pPoint)) eq '') then
    -- No rule found so add a new one.
    !newPRule = object SPCPOINTRULE()
    !newPRule.pPoint = !pPoint
    !newPRule.connType = TRIM(!connType)
    !this.pointRules.append(!newPRule)
    !done = TRUE
  endif

  return !done
endmethod
-- End of method definition for .includePPRule(REAL, STRING) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      replacePPRule
--
-- Description: Add a rule for the connection type of a ppoint
--
-- Method Type: Procedure
-- Arguments:
--   1 R  REAL   ppoint number
--   2 R  STRING new connection type
--
------------------------------------------------------------------------

define method .replacePPRule(!pPoint is REAL, !connType is STRING) is BOOLEAN
  !done = FALSE

  -- Don't bother with undefined rules
  if (trim(!connType) neq '') then
    -- Try and find a rule to modify
    do !prule values !this.pointRules
      if (!prule.pPoint eq !pPoint) then
        !done = TRUE
        !prule.connType = TRIM(!connType)
      endif
    enddo
  endif

  return !done
endmethod
-- End of method definition for .replacePPRule(REAL, STRING) BOOLEAN

------------------------------------------------------------------------
--
-- Method:      removePPRule
--
-- Description: Remove a rule for a ppoint
--
-- Method Type: Procedure
-- Arguments:
--   1 R  REAL   PPoint number
--
------------------------------------------------------------------------

define method .removePPRule(!pPoint is REAL)
  !removeIndex = REAL()

  -- Find rule for ppoint
  do !pruleIndex indices !this.pointRules
    if (!this.pointRules[!pruleIndex].pPoint eq !pPoint) then
      !removeIndex = !pruleIndex
    endif
  enddo

  if (!removeIndex.set()) then
    -- Found rule so remove it
    !this.pointRules.remove(!removeIndex)
  endif
endmethod
-- End of method definition for .removePPRule(REAL)

define method .print(!output is ARRAY, !objectName is STRING)
  !output.append(!objectName & '.skey = ' & |'| & !this.skey & |'|)

  do !pointRuleElem values !this.pointRules
    !output.append('!rule = object SPCPOINTRULE()')
    !output.append('!rule.pPoint = ' & string(!pointRuleElem.pPoint))
    !output.append('!rule.connType = ' & |'| & !pointRuleElem.connType & |'|)
    !output.append(!objectName & '.pointRules.append(!rule)')
  enddo
endmethod
-- End of method definition for .print(ARRAY, STRING)
