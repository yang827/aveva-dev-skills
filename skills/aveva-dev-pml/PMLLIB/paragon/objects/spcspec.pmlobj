--
--
-- Description:
-- This contains a list of SPCOM elements and an spcPConnList containing
-- pcon and ckey data for a number of coco elements.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  check(ARRAY,STRING)              -                   Output possible problems with these SPCOMs
--  spcSpec(ARRAY,ARRAY)             -                   Constructor
--
------------------------------------------------------------------------

define object SPCSPEC

  -- Mapping from PCONN to most common skey
  member .pConnList is SPCPCONNLIST

  -- List of SPCOM elements
  member .spcomList is ARRAY

endobject
-- End of object definition for SPCSPEC

------------------------------------------------------------------------
--
-- Method:      .spcSpec(ARRAY, ARRAY)
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--    1   R     ARRAY       Array of SPCOM DBREFs
--    2   R     ARRAY       Array of COCO DBREFs
--
------------------------------------------------------------------------

define method .spcSpec(!spcomArray is ARRAY, !dummyCocoArray is ARRAY)
  !this.pConnList.pConns.clear()
  !this.pConnList.cKeys.clear()

  !this.spcomList.clear()

--  !this.pConnList.add(!cocoArray)

  do !spcomElem values !spcomArray
    !this.spcomList.append(OBJECT spcSpecComponent (!spcomElem.dbRef()))
  enddo
endmethod
-- End of method definition for .spcSpec(ARRAY, ARRAY)


------------------------------------------------------------------------
--
-- Method:      .check(ARRAY)
--
-- Description: Output possible problems with these SPCOMs
--
-- Method Type: Procedure
-- Arguments:
--   1   RW   ARRAY     Output
-- Return:
--
------------------------------------------------------------------------

define method .check(!output is ARRAY, !preText is STRING)
  !size = !this.spcomList.size()
  !count = 0
  !interval = !size / 20
  !currInterval = 0

  if (!interval GT 20) then
    !interval = 20
  endif

  !output.append (',,PPoint 1, PPoint 2, PPoint 3, PPoint 4')
  !output.append ('SPCom, SKey, PConn (PSKey), PConn (PSKey), PConn (PSKey), PConn (PSKey)')

  do !spcomElem values !this.spcomList
--    if (NOT !spcomElem.check(!this.pConnList)) then

    !output.append(!spcomElem.getReport())

    if (!count GEQ !currInterval) then
      !percentDone = NINT(100 * (!count / !size))
      PROMPT '$!preText($!percentDone%)'

      !currInterval = !currInterval + !interval
    endif

    !count = !count + 1

--    endif
  enddo

  PROMPT '$!preText(100%)'
endmethod
-- End of method definition for .check(ARRAY, STRING)
