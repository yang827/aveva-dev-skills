--
--
-- Description:
-- This represents a SPCOM element
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  check(SPCPCONNLIST)              BOOLEAN
--  getReport()                      STRING
--  pConnsEqualTo(ARRAY)             BOOLEAN
--  setPconns(ARRAY,ARRAY,ARRAY,SPCSCOMCACHE) -                   Set the PCONNs associated with this SPCOM
--  spcSpecComponent(DBREF)          -                   Constructor
--
------------------------------------------------------------------------

define object SPCSPECCOMPONENT

  -- DBEF of SPCOM element
  member .spcomRef is DBREF

endobject
-- End of object definition for SPCSPECCOMPONENT

------------------------------------------------------------------------
--
-- Method:      .spcSpecComponent(DBREF)
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--    1   R     DBREF       DBREF of the SPCOM this is to represent
--
------------------------------------------------------------------------

define method .spcSpecComponent(!theSpcomRef is DBREF)
  !this.spcomRef = !theSpcomRef
endmethod
-- End of method definition for .spcSpecComponent(DBREF)


------------------------------------------------------------------------
--
-- Method:      .check(spcPConnList) is BOOLEAN
--
-- Description: Check this SPCOM is OK
--
-- Method Type: Function
-- Arguments:
--    1   R     spcPConnList    Mapping from CType to most commonly
--                              associated CKey
-- Return:
--    BOOLEAN                   TRUE iff this was OK
--
------------------------------------------------------------------------

define method .check(!pConnList is SPCPCONNLIST) is BOOLEAN
  !result = TRUE

  if (!this.spcomRef.detRef.unset()) then
    !result = FALSE
  elseif (!this.spcomRef.catRef.unset()) then
    !result = FALSE
  else

    !scom = object SPCSCOM(!this.spcomRef.catRef)
    !skey = !this.spcomRef.detRef.skey

    -- Always set to FALSE until flange criteria determined
    !skeyIsFlange = FALSE

    if (NOT !scom.check()) then
      !result = FALSE
    elseif (!scom.anyPSKeySet()) then
      !result = FALSE
    elseif (!scom.anyCKeyForPConn (!pConnList,'Ambiguous')) then
      !result = FALSE
    elseif (!skeyIsFlange) then
      if (NOT !scom.check()) then
        !result = FALSE
      elseif (!scom.anyCKeyForPConn (!pConnList,'FL')) then
        !result = FALSE
      elseif (!skey EQ 'FLBL' OR !skey EQ 'FLFL' OR !skey EQ 'FLLB') then
        !result = FALSE
      elseif (!skey EQ 'FLSC') then
        if (NOT !scom.anyCKeyForPConn (!pConnList,'SC')) then
          !result = FALSE
        endif
      else
        if (NOT !scom.anyCKeyForPConn (!pConnList,'BW')) then
          !result = FALSE
        endif
      endif
    elseif (!skey.subString(3,2) EQ 'FL') then
      if (NOT !scom.anyCKeyForPConn (!pConnList,'FL')) then
        !result = FALSE
      endif
    elseif (!skey.subString(3,2) EQ 'BW') then
      if (NOT !scom.anyCKeyForPConn (!pConnList,'BW')) then
        !result = FALSE
      endif
    elseif (!skey.subString(3,2) EQ 'SC') then
      if (NOT !scom.anyCKeyForPConn (!pConnList,'SC')) then
        !result = FALSE
      endif
    elseif (!skey.subString(3,2) EQ 'SW') then
      if (NOT !scom.anyCKeyForPConn (!pConnList,'SW')) then
        !result = FALSE
      endif
    elseif (!skey.subString(3,2) EQ 'PL') then
      if (NOT !scom.anyCKeyForPConn (!pConnList,'PL')) then
        !result = FALSE
      endif
    elseif (!skey.subString(3,2) EQ 'CP') then
      if (NOT !scom.anyCKeyForPConn (!pConnList,'CP')) then
        !result = FALSE
      endif
    else
      !result = FALSE
    endif
  endif

  return (!result)
endmethod
-- End of method definition for .check(SPCPCONNLIST) BOOLEAN


------------------------------------------------------------------------
--
-- Method:      .getReport() is STRING
--
-- Description: Get a report for this SPCOM
--
-- Method Type: Function
-- Arguments:
-- Return:
--   STRING      Report text
--
------------------------------------------------------------------------

define method .getReport() is STRING
  if (!this.spcomRef.detRef.set()) then
    !skey = !this.spcomRef.detRef.skey
  else
    !skey = 'DetRef Unset'
  endif

  if (!this.spcomRef.catRef.set()) then
    !scom = object SPCSCOM(!this.spcomRef.catRef)
    !connTypes = !scom.getReport()
  else
    !connTypes = 'CatRef Unset'
  endif

  return (!this.spcomRef.fullName & ',' & !skey & !connTypes)
endmethod
-- End of method definition for .getReport() STRING


------------------------------------------------------------------------
--
-- Method:      .pConnsEqualTo(ARRAY) is BOOLEAN
--
-- Description: Return TRUE iff the PCONNs associated with this SPCOM
--              match the given PCONNs
--
-- Method Type: Function
-- Arguments:
--    1   R  ARRAY     PCONNs to compare against
-- Return:
--   BOOLEAN           TRUE iff the PCONNs associated with this SPCOM
--                     match the given PCONNs
--
------------------------------------------------------------------------

define method .pConnsEqualTo(!pConns is ARRAY) is BOOLEAN
  !scom = object SPCSCOM(!this.spcomRef.catRef)

  return (!scom.pConnsEqualTo(!pConns))
endmethod
-- End of method definition for .pConnsEqualTo(ARRAY) BOOLEAN


------------------------------------------------------------------------
--
-- Method:      .setPconns(ARRAY, ARRAY)
--
-- Description: Set the PCONNs associated with this SPCOM
--
-- Method Type: PROCEDURE
-- Arguments:
--   1   R   ARRAY          New PCONNs
--   2   RW  ARRAY          Errors encountered
--   3   RW  ARRAY          Array of strings to output to file
--   4   RW  SPCSCOMCACHE   SCOM object cache

--
------------------------------------------------------------------------

define method .setPconns(!pConns is ARRAY, !errors is ARRAY, !changes is ARRAY, !cache is SPCSCOMCACHE)
  !scom = object SPCSCOM(!this.spcomRef.catRef)

  !scom.setPconns(!pConns, !errors, !changes, !cache)
endmethod
-- End of method definition for .setPconns(ARRAY, ARRAY, ARRAY, SPCSCOMCACHE)
