--
--
-- Description:
-- This represents a SPEC element
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  changePConns(STRING,ARRAY,ARRAY,ARRAY,ARRAY,SPCSCOMCACHE) -                   Change the pconns for an skey
--  spcSpecSkey(DBREF)               -                   Constructor
--
------------------------------------------------------------------------

define object SPCSPECSKEY
  member .specRef is DBREF
endobject
-- End of object definition for SPCSPECSKEY


------------------------------------------------------------------------
--
-- Method:      .spcSpecSkey(DBREF)
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--    1   R     DBREF       DBREF of the SPEC this is to represent
--
------------------------------------------------------------------------

define method .spcSpecSkey(!theSpecRef is DBREF)
  !this.specRef = !theSpecRef
endmethod
-- End of method definition for .spcSpecSkey(DBREF)


------------------------------------------------------------------------
--
-- Method:      .changePConns(STRING,ARRAY,ARRAY,ARRAY)
--
-- Description: Change the pconns for an skey
--
-- Method Type: Procedure
-- Arguments:
--    1   R     STRING         Skey
--    2   R     ARRAY          Array of old PCONNS
--    3   R     ARRAY          Array of new PCONNS
--    4   RW    ARRAY          Array of strings reporting any problems
--    5   RW    ARRAY          Array of strings to output to file
--    6   RW    SPCSCOMCACHE   SCOM object cache
--
------------------------------------------------------------------------

define method .changePConns(!skey is STRING, !oldPConns is ARRAY, !newPConns is ARRAY, !errors is ARRAY, !changes is ARRAY, !cache is SPCSCOMCACHE)

  var !spcoms COLLECT ALL SPCOM WHERE (SKEY OF DETREF EQ '$!skey') FOR $!this.specRef

  !count = 0

  do !spcomElem values !spcoms

    if (!spcomElem.dbRef().detRef.set()) then

      if (!spcomElem.dbRef().detRef.skey eq !skey) then

        !spcom = object SPCSPECCOMPONENT(!spcomElem.dbRef())

        if (!spcom.pConnsEqualTo(!oldPConns)) then
          !count = !count + 1
          !spcom.setPconns(!newPConns, !errors, !changes, !cache)
        endif

      endif
    endif
  enddo

  !errors.append('')
  !errors.append('    ' & !count.string() & ' SPCOM elements matched')
  !errors.append('')
endmethod
-- End of method definition for .changePConns(STRING, ARRAY, ARRAY, ARRAY, ARRAY, SPCSCOMCACHE)
