------------------------------------------------------------------------
--
-- Method:      setData
--
-- Description: Initialise selection table choice in modify mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Design element being modified
--    2   R      DBREF       Scope for table search (TABGRO or SPWL)
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setData(!desElem is DBREF, !scope is DBREF)

  !desType = object STRING()
  !purpose = object STRING()
  !tableType = object STRING()
  !mode = 2
  !this.setData(!desType, !desElem, !scope, !purpose, !tableType, !mode)

