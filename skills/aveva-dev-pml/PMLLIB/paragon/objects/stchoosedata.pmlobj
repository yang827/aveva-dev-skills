-- End of method definition for .setData(DBREF, DBREF)

------------------------------------------------------------------------
--
-- Method:      setData
--
-- Description: Initialise selection table choice in modify mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Design element being modified
--    2   R      STRING      Table purpose for table search
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setData(!desElem is DBREF, !purpose is STRING)

  !desType = object STRING()
  !scope = object DBREF()
  !tableType = object STRING()
  !mode = 2
  !this.setData(!desType, !desElem, !scope, !purpose, !tableType, !mode)

endmethod
-- End of method definition for .setData(DBREF, STRING)

------------------------------------------------------------------------
--
-- Method:      setData
--
-- Description: Initialise selection table choice in modify mode for given application
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Design element being modified
--    2   R      STRING      Table purpose for table search
--    3   R      STRING      Application. Match Table SPTYPE (word attribute) in table search
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setData(!desElem is DBREF, !purpose is STRING, !application is STRING)

  !desType = object STRING()
  !scope = object DBREF()
  !tableType = object STRING()
  !mode = 2
  !this.setDataMembers(!desType, !desElem, !scope, !purpose, !tableType, !mode)
  -- set application
  !this.setApplication(!application)
  !this.setTable()

endmethod
-- End of method definition for .setData(DBREF, STRING, STRING)

------------------------------------------------------------------------
--
-- Method:      setData
--
-- Description: Initialise selection table choice in modify mode for given application
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Design element being modified
--    2   R      STRING      Table purpose for table search
--    3   R      STRING      Application Match Table SPTYPE (word attribute) in table search
--    4   R      STRING      ComponentClass over rides Application Match Table SPTYPE (word attribute) in table search
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setData(!desElem is DBREF, !purpose is STRING, !application is STRING, !componentClass is STRING)

  !desType = object STRING()
  !scope = object DBREF()
  !tableType = object STRING()
  !mode = 2
  !this.setDataMembers(!desType, !desElem, !scope, !purpose, !tableType, !mode)
  -- set word to match with the TABGRO SPTYPE attribute
  -- allows for a table that does not belong to a specific application
  -- **** This actually over rides the application member
  if( !componentClass.unset() ) then
    -- empty string not allowed - default to current application string
    !this.setApplication(!application)
  else
    !this.application = !componentClass
  endif
  !this.setTable()

endmethod
-- End of method definition for .setData(DBREF, STRING, STRING, STRING)
------------------------------------------------------------------------
--
-- Method:      setData
--
-- Description: Initialise selection table choice in modify mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Design element being modified
--    2   R      DBREF       Scope for table search
--    3   R      STRING      Table type
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setData(!desElem is DBREF, !scope is DBREF, !tableType is STRING)

  !desType = object STRING()
  !purpose = object STRING()
  !mode = 2
  !this.setData(!desType, !desElem, !scope, !purpose, !tableType, !mode)

endmethod
-- End of method definition for .setData(DBREF, DBREF, STRING)

------------------------------------------------------------------------
--
-- Method:      setTitle
--
-- Description: Set choose form tile
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setTitle(!title is STRING)

  !this.formTitle = !title.trim()

endmethod
-- End of method definition for .setTitle()

------------------------------------------------------------------------
--
-- Method:      setApplication
--
-- Description: Set current application
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setApplication()

  !currentApp = !!appCntrl.currentApp()
  if (!currentApp inset(|STLWRK|, |PANEL|, |CIVIL|)) then
    !this.application = |STL|
  elseif (!currentApp eq |ROOMDESIGN|) then
    !this.application = |ROOM|
  elseif (!currentApp eq |HVACADV|) then
    !this.application = |HVAC|
  elseif (!currentApp.substring(1,4) eq |CABL|) then
    !this.application = |ELEC|
  elseif (!currentApp eq |DTMP|) then
    !this.application = |GEN|
  else
    !this.application = !currentApp
  endif

endmethod
-- End of method definition for .setApplication()

------------------------------------------------------------------------
--
-- Method:      setApplication
--
-- Description: Set current application
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Force set the application
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setApplication(!application is STRING)

  -- check that string is a valid application
  if( !!appCntrl.findApplic(!application) ) then
    -- set local application identifier
    -- map to local identifier
    if (!application inset(|STLWRK|, |PANEL|, |CIVIL|)) then
      !this.application = |STL|
    elseif (!application eq |ROOMDESIGN|) then
      !this.application = |ROOM|
    elseif (!application eq |HVACADV|) then
      !this.application = |HVAC|
    elseif (!application.substring(1,4) eq |CABL|) then
      !this.application = |ELEC|
    elseif (!application eq |DTMP|) then
      !this.application = |GEN|
    else
      !this.application = !application
    endif
  else
    -- Fallback is to get current application string if forced string not found
    !this.setApplication()
  endif

endmethod
-- End of method definition for .setApplication(STRING)

------------------------------------------------------------------------
--
-- Method:      setTable
--
-- Description: Set list of selection tables
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setTable()

  -- Find tables matching specified application and purpose
  if (!this.scope.badref()) then
    if (!this.purpose.unset() or !this.purpose.empty()) then
      var !colSelTab collect all TABGRO with SPTYPE eq '$!<this.application>'
    else
      var !colSelTab collect all TABGRO with SPTYPE eq '$!<this.application>' and PURP eq '$!<this.purpose>'
    endif
  elseif (!this.scope.type inset (|TABGRO|, |SPWL|)) then
    if (!this.purpose.unset() or !this.purpose.empty()) then
      var !colSelTab collect all TABGRO for $!<this.scope>
    else
      var !colSelTab collect all TABGRO with PURP eq '$!<this.purpose>' for $!<this.scope>
    endif
  else
    !colSelTab = ARRAY()
  endif

  -- Save tables
  if (!colSelTab.unset()) then
    -- Clear table array if no tables are found
    !this.selTabs.clear()
  else
    -- Save table dbref's
    !this.selTabs = !colSelTab.evaluate(object BLOCK(|!colSelTab[!evalIndex].dbref()|))
  endif

endmethod
-- End of method definition for .setTable()

------------------------------------------------------------------------
--
-- Method:      getSelTabs
--
-- Description: Return selection table choice
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getSelTabs() is ARRAY

  return !this.selTabs

endmethod
-- End of method definition for .getSelTabs()

------------------------------------------------------------------------
--
-- Method:      getDesignItem
--
-- Description: Return current design element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDesignItem() is DBREF

  return !this.desItem

endmethod
-- End of method definition for .getDesignItem()

------------------------------------------------------------------------
--
-- Method:      getItemSelectionTable
--
-- Description: Return selection table for this Design Item
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getItemSelectionTable() is DBREF

  !tableType[1] = 'CTABLE'
  !cTable       = !!dtbOwnerOfTypes(!this.desItem.spref, !tableType)

  return !cTable

endmethod
-- End of method definition for .getItemSelectionTable()

------------------------------------------------------------------------
--
-- Method:      show
--
-- Description: Show choose form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .show()

  -- Load form and add to view system (this shows the form)
  loadform !!stchoose
  !!gphViews.add(!!stchoose.vwView3D)

  -- Create local drawlist and add to 3D view
  if (!!stchoose.drawlist.unset()) then
    !!stchoose.drawlist = !!gphDrawlists.createDrawList()
  endif
  !!gphDrawlists.attachView(!!stchoose.drawlist, !!stchoose.vwView3D)

endmethod
-- End of method definition for .show()

------------------------------------------------------------------------
--
-- Method:      hide
--
-- Description: Hide choose form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .hide()

  -- Remove local drawlist from drawlist system
  !!gphDrawlists.detachAllViews(!!stchoose.drawlist)

  -- Remove form from view system (this kills the form)
  !!gphViews.remove(!!stchoose.vwView3D)

endmethod
-- End of method definition for .setData()

------------------------------------------------------------------------
--
-- Method:      setData
--
-- Description: Initialise selection table choice in create mode with given SPTYPE
--              Avoid the automatic match with current application and
--              match with the supplied SPTYPE instead
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of design element to be created
--    2   R      STRING      Table purpose for table search
--    3   R      STRING      Match Table SPTYPE (word attribute) in table search
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setData(!desType is STRING, !purpose is STRING, !componentClass is STRING)

  !desElem   = object DBREF()
  !scope     = object DBREF()
  !tableType = object STRING()
  !mode      = 1
  !this.setDataMembers(!desType, !desElem, !scope, !purpose, !tableType, !mode)
  -- set word to match with the TABGRO SPTYPE attribute
  -- allows for a table that does not belong to a specific application
  if( !componentClass.empty() ) then
    -- empty string not allowed - default to current application
    !this.setApplication()
  else
    !this.application = !componentClass
  endif
  !this.setTable()

endmethod
-- End of method definition for .setData(STRING, STRING, STRING)
