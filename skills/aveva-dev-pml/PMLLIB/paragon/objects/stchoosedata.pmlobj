--
--  Description:
--  Set up choose form for selection tables in Design
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clearData()                      -                   Reset form data to default values
--  getDesignItem()                  DBREF               Return current design element
--  getItemSelectionTable()          DBREF               Return selection table for this Design Item
--  getSelTabs()                     ARRAY               Return selection table choice
--  hide()                           -                   Hide choose form
--  setApplication()                 -                   Set current application
--  setApplication(STRING)           -                   Set current application
--  setData(DBREF)                   -                   Initialise selection table choice in modify mode
--  setData(DBREF,DBREF)             -                   Initialise selection table choice in modify mode
--  setData(DBREF,DBREF,STRING)      -                   Initialise selection table choice in modify mode
--  setData(DBREF,STRING)            -                   Initialise selection table choice in modify mode
--  setData(DBREF,STRING,STRING)     -                   Initialise selection table choice in modify mode for given application
--  setData(DBREF,STRING,STRING,STRING) -                   Initialise selection table choice in modify mode for given application
--  setData(STRING)                  -                   Initialise selection table choice in create mode
--  setData(STRING,DBREF)            -                   Initialise selection table choice in create mode
--  setData(STRING,DBREF,DBREF,STRING,STRING,REAL) -                   Set selection table / choose data for form
--  setData(STRING,DBREF,STRING)     -                   Initialise selection table choice in create mode
--  setData(STRING,STRING)           -                   Initialise selection table choice in create mode
--  setData(STRING,STRING,STRING)    -                   Initialise selection table choice in create mode with given SPTYPE
--  setDataMembers(STRING,DBREF,DBREF,STRING,STRING,REAL) -                   Set member data for this object
--  setTable()                       -                   Set list of selection tables
--  setTitle(STRING)                 -                   Set choose form tile
--  show()                           -                   Show choose form
--  stChooseData()                   -                   Default constructor
--
------------------------------------------------------------------------
define object STCHOOSEDATA

  -- Choose data
  member .desItem         is DBREF                $*
  member .questions       is ARRAY                $*
  member .answers         is ARRAY                $*
  member .tableType       is STRING               $*

  -- Form data
  member .formTitle       is STRING               $*
  member .desType         is STRING               $*
  member .mode            is REAL                 $* 1 = Create, 2 = Modify
  member .application     is STRING               $*
  member .scope           is DBREF                $*
  member .purpose         is STRING               $*
  member .selTabs         is ARRAY                $*

  -- Form attributes
  member .tableTag        is STRING               $*
  member .typeTag         is STRING               $*

endobject

------------------------------------------------------------------------
--
-- Method:      stChooseData
--
-- Description: Default constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .stChooseData()

  !this.clearData()

endmethod
-- End of method definition for .stChooseData()

------------------------------------------------------------------------
--
-- Method:      clearData
--
-- Description: Reset form data to default values
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .clearData()

  -- Choose data
  !this.desItem = object DBREF()
  !this.questions.clear()
  !this.answers.clear()
  !this.tableType = object STRING()

  -- Form data
  !this.mode = 1
  !this.desType = object STRING()
  !this.application = object STRING()
  !this.scope = object DBREF()
  !this.purpose = object STRING()
  !this.selTabs.clear()

  -- Form attributes
  !this.tableTag = 'Table'
  !this.typeTag = 'Type'

endmethod
-- End of method definition for .clearData()

------------------------------------------------------------------------
--
-- Method:      setData
--
-- Description: Set selection table / choose data for form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of design element to be created (for mode 1)
--    2   R      DBREF       Design element being modified (for mode 2)
--    3   R      DBREF       Scope for table search (TABGRO or SPWL)
--    4   R      STRING      Table purpose for table search
--    5   R      STRING      Table type to select
--    6   R      REAL        Mode, 1 = Create, 2 = Modify
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setData(!desType is STRING, !desElem is DBREF, !scope is DBREF, !purpose is STRING, !tableType is STRING, !mode is REAL)

  -- Set members data for this object
  !this.setDataMembers(!desType, !desElem, !scope, !purpose, !tableType, !mode)

  -- Table selection
  !this.setApplication()
  !this.setTable()

endmethod
-- End of method definition for .setData(STRING, DBREF, DBREF, STRING, STRING, REAL)

------------------------------------------------------------------------
--
-- Method:      setDataMembers
--
-- Description: Set member data for this object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of design element to be created (for mode 1)
--    2   R      DBREF       Design element being modified (for mode 2)
--    3   R      DBREF       Scope for table search (TABGRO or SPWL)
--    4   R      STRING      Table purpose for table search
--    5   R      STRING      Table type to select
--    6   R      REAL        Mode, 1 = Create, 2 = Modify
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setDataMembers(!desType is STRING, !desElem is DBREF, !scope is DBREF, !purpose is STRING, !tableType is STRING, !mode is REAL)

  -- Design item being chosen
  if (!desElem.badref().not()) then
    !this.desItem = !desElem
  elseif (!desType.unset().not() and !desType.empty().not()) then
    !this.desType = !desType
  else
    return error 1 |Bad element or type definition in !!stChooseData object!|
  endif

  -- Scope
  if (!scope.badref()) then
    !this.scope = object DBREF()
  elseif (!scope.type inset (|TABGRO|, |SPWL|)) then
    !this.scope = !scope
  else
    return error 1 |Invalid element type for scope in form data, TABGRO or SPWL expected!|
  endif

  -- Purpose
  if (!purpose.set()) then
    !this.purpose = !purpose.trim().substring(1,4).upcase()
  else
    !this.purpose = object STRING()
  endif

  -- Table type
  if (!tableType.set()) then
    !this.tableType = !tableType.trim().upcase()
  else
    !this.tableType = object STRING()
  endif

  -- Create/Modify mode
  !this.mode = !mode

endmethod
-- End of method definition for .setData(STRING, DBREF, DBREF, STRING, STRING, REAL)

------------------------------------------------------------------------
--
-- Method:      setData
--
-- Description: Initialise selection table choice in create mode
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Type of design element to be created
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setData(!desType is STRING)

  !desElem = object DBREF()
  !scope = object DBREF()
  !purpose = object STRING()
  !tableType = object STRING()
  !mode = 1
  !this.setData(!desType, !desElem, !scope, !purpose, !tableType, !mode)

endmethod
-- End of method definition for .setData(STRING)

