--    Module:        DESIGN
--  Author:          Daniel(Jaehun.Choi)
--  Created:         5 September 2012
--
--  Description:     evaluate auto name
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      element type
-- Return:
--   [Data Type] [Description]
--    STRING     return to evaluated auto-name
--
------------------------------------------------------------------------
-- Define function
define function !!comAutoName(!elementType is STRING) is STRING
  !saveCe = !!ce

  !createFlag = true
  !result = ''

  new $!<elementType>
  handle any
    !createFlag = false
    return !result
  endhandle

  if (!createFlag) then
    !result = !!namOpt.nameString(!!ce, '', false, false)
    delete $!<elementType>
  endif

  !!ce = !saveCe
  handle any
  endhandle

  if (!result.set()) then
    if (!result.substring(1,1) ne '/') then
      !result = '/' & !result
    endif
  endif

  return !result
endfunction
-- End of function definition
