--  Created:         5 September 2012
--
--  Description:     call form at specific position
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      form name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!comCallForm(!formName is STRING)
  if (undefine($!formName)) then
    pml reload form $!formName
  endif

  show $!formName at xr0.5 yr0.3
endfunction
-- End of function definition
