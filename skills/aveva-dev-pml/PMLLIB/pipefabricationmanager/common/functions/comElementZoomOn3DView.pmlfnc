--    Module:        DESIGN
--  Author:          Daniel(Jaehun.Choi)
--  Created:         5 September 2012
--
--  Description:     zoom a element on 3d view
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element db ref
--    2    R     BOOLEAN     flag for confirm to add drawlist
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!comElementZoomOn3DView(!element is DBREF, !confirmAdd is BOOLEAN)
  !currentView = !!fmSys.currentDocument().view
  handle(2,759)
    return
  endhandle

  -- check whether selected support is belong to the current draw list or not.
  !token         = !!gphDrawlists.token(!currentView)
  !drawlist      =  !!gphDrawlists.drawlist(!token)
  !existDrawlist = !drawlist.members().findFirst(!element)

  if (!existDrawlist.unset() and !confirmAdd) then
    !answer = !!alert.confirm('Do you want to add $!<element.flnm> on 3D view?')
    if (!answer ne 'YES') then
      return
    endif
  endif

  add $!<element>
  handle any
    return
  endhandle

  -- get display elements and its volume
  !volume = object VOLUME(!element)
  handle ANY
    return
  endhandle

  !from = !volume.from
  !to = !volume.to

  -- Through Point
  !throughPoint = !from.midPoint(!to)
  handle ANY
    return
  endhandle

  -- Set metric format
  !format= object FORMAT()
  !format.units = 'MM'
  !format.dp= 0
  !format.dimension = 'L'

  -- Set through point
  !through[1] = !throughPoint.east.string(!format).real()
  !through[2] = !throughPoint.north.string(!format).real()
  !through[3] = !throughPoint.up.string(!format).real()
  !!fmSys.currentDocument().view.through = !through

  -- Set view radius
  !radius = !from.distance(!to).string(!format).real() / 2 * 1.25
  !radius = !radius.max(500mm)
  !!fmSys.currentDocument().view.radius  = !radius
endmethod
-- End of function definition
