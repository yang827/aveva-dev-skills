--  Created:         5 September 2012
--
--  Description:     evaluate element reference with specific element type
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      find element type
--    2    R     DBREF       evaluated element reference
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!comEvalElementWithType(!findElementType is STRING, !sourceElement is DBREF) is DBREF
  !result = object DBREF()

  !checkType = !findElementType.trim().upCase()

  if (!sourceElement.hardType eq '$!<checkType>') then
    !result = !sourceElement
  else
    !index = !sourceElement.ahList.findFirst(!checkType)
    if (!index.set()) then
      !result = !sourceElement.ownLst[!index]
    endif
  endif

  return !result
endfunction
-- End of function definition
