--
--  Description:     check element is valid or not
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R      DBREF     element
--
-- Return:
--   [Data Type] [Description]
--    1     R      BOOLEAN   return checking result
--
------------------------------------------------------------------------
define function !!comIsValidElement(!elementName is STRING) is BOOLEAN
  !element = !elementName.dbRef()
  handle any
    return false
  endhandle

  if (!element.badRef()) then
    return false
  endif

  return true
endfunction
-- End of function definition
