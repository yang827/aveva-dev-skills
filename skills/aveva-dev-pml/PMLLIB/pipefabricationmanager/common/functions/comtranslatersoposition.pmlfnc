--
--  File:            comTranslateRsoPosition.pmlfnc
--    Type:          Function Definition
--    Group:         common
--      Keyword:     common
--    Module:        common
--  Author:          Daniel(Jaehun Choi)
--  Created:         24 April 2014
--
--  Description:     translate position from world position to ship position using RSO plane
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      search direction
--    2   R      POSITION    search position
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!comTranslateRsoPosition(!searchDirection is STRING, !searchPosition is POSITION) is STRING
  !result  = ''

  !checkDir = object DIRECTION(!searchDirection)
  handle(2,813)
    return !result
  endhandle

  !rsoList = !!collectAllFor('HRSO', |RSDIM ne '' and mcount gt 0|, world)
  if (!rsoList.unset()) then
    write 'No RSO elements(HRSO) which have RSDIM as valid value in the project'
    return !result
  endif

  !checkLine = object LINE(!searchPosition, !searchPosition.offset(!checkDir, 100mm))

  !auxMargin = 500mm

  !distanceList    = object ARRAY()
  !refSurfaceList  = object ARRAY()
  !refPositionList = object ARRAY()

  do !rsoRef values !rsoList
    !rsoSurfaceList = !rsoRef.members
    do !rsoSurfaceRef values !rsoSurfaceList
      !rsoDimDirStr = !rsoSurfaceRef.owner.rsDim.upcase().replace('DIM','')
      skip if (!rsoDimDirStr.empty())
      !isValidDirection = !checkDir.isParallel(!rsoDimDirStr.direction())
      handle any
        skip
      endhandle

      skip if (!isValidDirection.not())

      !profileObject = object PROFILE(!rsoSurfaceRef)
      handle any
        skip
      endhandle

      !profileObject.close()

      !planeObject = !profileObject.plane()

      -- evaluate intersection point between rso plane and check line which made by given 3d position and direction
      !intersection = !planeObject.intersection(!checkLine)
      handle any
        skip
      endhandle

      skip if (!intersection.unset())
      !nearPosition = !intersection
      !offsetDir    = !nearPosition.direction(!searchPosition)

      skip if (!offsetDir.isParallel(!checkDir).not())

      if (!profileObject.isWithout(!searchPosition)) then
        !edgeLines = !profileObject.edges()
        !nearEdgesIndices = !profileObject.nearEdges(!searchPosition)

        !onBoundaryLine = false
        do !index values !nearEdgesIndices
          if (!edgeLines[!index].on(!searchPosition, true)) then
            !onBoundaryLine = true
            break
          endif
        enddo

        if (!onBoundaryLine.not()) then
          !planeNearPos = !planeObject.near(!searchPosition)
          !isValidOffset = false
          do !index values !nearEdgesIndices
            !edgeDistance = !edgeLines[!index].distance(!planeNearPos)
            if (!edgeDistance le !auxMargin) then
              !isValidOffset = true
              break
            endif
          enddo
          skip if (!isValidOffset.not())
        endif
      endif

      !distance = !searchPosition.distance(!nearPosition)
      !distanceList.append(!distance)

      !refSurfaceList.append(!rsoSurfaceRef)
      !refPositionList.append(!nearPosition)
    enddo
  enddo

  if (!distanceList.unset()) then
    return !result
  endif

  !sortedIndices = !distanceList.sortedIndices()

  !distanceList.reIndex(!sortedIndices)
  !refSurfaceList.reIndex(!sortedIndices)
  !refPositionList.reIndex(!sortedIndices)

  !orthDir = !refPositionList[1].direction(!searchPosition)
  if (!orthDir eq !checkDir) then
    !sign = '+'
  else
    !sign = '-'
  endif

  !stringFormat = !!distanceFMT
  !stringFormat.dp = 0

  !offset = !!comValueConvert(!distanceList[1], !stringFormat.units).nint()

  !result = !refSurfaceList[1].owner.namn.replace('_RSO_','') & ' ' & !sign & ' ' & !offset

  return !result
endfunction
