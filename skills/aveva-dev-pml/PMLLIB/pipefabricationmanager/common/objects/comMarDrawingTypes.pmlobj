------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  comMarDrawingTypes()             -                   constructor
--  evaluate()                       -                   evaluate data
--  evaluateDrawingTypesForNewDrawing() -
--  evaluateSDBformat()              -                   evaluate data from SDB format
--  evaluateXMLformat()              -                   evaluate data from XML format
--  getPaddData(STRING)              ARRAY               get padd data
--
------------------------------------------------------------------------
import 'PipeFabricationAddin'
handle ANY
endhandle

if(!!module().productfamily.upCase() eq 'MARINE') then
  import 'evaluateMarineDrawingTypes'
  handle any
  endhandle
endif

-- Define object
define object COMMARDRAWINGTYPES
  member .envFilePath     is STRING
  member .marDbNameList   is ARRAY
  member .departmentList  is ARRAY
  member .registryList    is ARRAY
  member .isXMLformat     is BOOLEAN

  member .marPtypes       is ARRAY
  member .drawingTypes    is ARRAY
  member .marDBNames      is ARRAY
endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      comMarDrawingTypes
-- Description: constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .comMarDrawingTypes()
  var !projCode PROJ CODE
  !marEnvCode = !projCode & 'MAR'
  var !marEnvPath evar |$!marEnvCode|
  !this.envFilePath = !marEnvPath & '\d065' & !projCode & '.xml'
  !this.isXMLformat = true

  !envFile = object FILE(!this.envFilePath)
  if (!envFile.exists().not()) then
    !this.envFilePath = !marEnvPath & '\d065' & !projCode & '.sbd'
    !this.isXMLformat = false
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluate
-- Description: evaluate
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .evaluate()
  !envFile = object FILE(!this.envFilePath)
  if (!envFile.exists().not()) then
    return
  endif

  if (!this.isXMLformat) then
    !this.evaluateXMLformat()
  else
    !this.evaluateSDBformat()
  endif

  !this.marDbNameList.append('SB_SETTINGS_DB')
  !this.departmentList.append('/DEPT_DEFAULT')
  !this.registryList.append('/REGI_DEFAULT')

  !this.marDbNameList.append('SBH_RECEIPT')
  !this.departmentList.append('/General')
  !this.registryList.append('/MarDwg')
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateSDBformat
-- Description: evaluate data from SDB file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .evaluateSDBformat()
  !envFile = object FILE(!this.envFilePath)
  if (!envFile.exists().not()) then
    return
  endif

  !this.marDbNameList.clear()
  !this.departmentList.clear()
  !this.registryList.clear()

  !contents = !envFile.readFile()
  do !readLine values !contents
    skip if (!readLine.substring(1,1) eq '!')
    skip if (!readLine.occurs('_PADD') eq 0)

    !data = !readLine.split(' ').unique()
    skip if (!data.unset())

    !key = !data[1].upCase().trim()
    !values = !data[3].split(';')
    handle any
      skip
    endhandle

    !marDbName = !key.before('_PADD')
    !deptName = !values[1]
    !regiName = !values[2]

    !this.marDbNameList.append(!marDbName.trim())
    !this.departmentList.append('/' & !deptName)
    !this.registryList.append('/' & !regiName)
  enddo
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateXML format
-- Description: evaluate data from XML file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .evaluateXMLformat()
  using namespace 'Aveva.Pdms.PipeFabrication.Xml'

  !xml = object PMLXMLDOCUMENT()
  !xml.load(!this.envFilePath)
  handle any
    return
  endhandle

  !this.marDbNameList.clear()
  !this.departmentList.clear()
  !this.registryList.clear()

  !elements = !xml.getElementsByTagName('var')

  do !i index !elements
    !element = !elements[!i]
    !key  = !element.getAttribute('name').upCase().trim()
    !value = !element.getText().trim()

    skip if (!key.occurs('_PADD') eq 0)

    !paddInfo = !value.split(';')

    !marDbName = !key.replace('_PADD','')

    !this.marDbNameList.append(!marDbName)
    !this.departmentList.append('/' & !paddInfo[1])
    !this.registryList.append('/' & !paddInfo[2])
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getPaddData
-- Description: get padd data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      mar db name
-- Return:
--   [Data Type] [Description]
--    ARRAY
--
------------------------------------------------------------------------
define method .getPaddData(!marDbName is STRING) is ARRAY
  !table = object ARRAY()
  !index = !this.marDbNameList.findFirst(!marDbName)

  if (!index.unset()) then
    return !table
  endif

  !deptName = !this.departmentList[!index]
  !regiName = !this.registryList[!index]

  !table.append(!deptName)
  !table.append(!regiName)

