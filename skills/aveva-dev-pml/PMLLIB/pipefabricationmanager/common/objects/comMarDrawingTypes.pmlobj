  return !table
endmethod
-- End of method

define method .evaluateDrawingTypesForNewDrawing()
  if(!!module().productfamily.upCase() ne 'MARINE') then
    return
  endif

  using namespace 'evaluateMarineDrawingTypes'

  !marDrawingTypes = object GETMARDRAWINGTYPES()
  !marDrawingTypes.evaluate()

  !this.marPtypes     = !marDrawingTypes.getMarPtypes()
  !this.drawingTypes  = !marDrawingTypes.getDrawingTypes()
  !this.marDBNames    = !marDrawingTypes.getDbNames()

  !removeDBnames = split('SBH_3AX_SKETCHDB,SBD_PICT,SBD_STD,SBD_FORM',',')
  do !dbName values !removeDBnames
    !index = !this.marDBNames.findFirst(!dbName)
    skip if (!index.unset())

    !this.marDBNames.remove(!index)
    !this.drawingTypes.remove(!index)
    !this.marPtypes.remove(!index)
  enddo
endmethod
