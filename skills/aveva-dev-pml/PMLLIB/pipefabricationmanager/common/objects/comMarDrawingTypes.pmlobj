--          return !table
--        else
--          !!ce = !departments[1]
--        endif
--      else
--        switch
--      endif
--    endif
--
--    new DEPT
--    name $!<deptName>
--    handle any
--      !!alert.confirm(!!error.text)
--      return !table
--    endhandle
--
--    !departmentRef = ce
--
--  endhandle
--
--  !registryRef   = object DBREF(!this.registryList[!index])
--  handle any
--    if (!!ce.dbType ne 'PADD') then
--      SWITCH
--    endif
--
--    new REGI
--    name $!<regiName>
--    handle any
--      return !table
--    endhandle
--
