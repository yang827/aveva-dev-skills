--
--  Description:     api for marine drafting
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dwgClose()                       -                   dwg close
--  dwgOpen(STRING,BOOLEAN)          -                   dwg open
--  dwgRepaint()                     -                   dwg repaint
--  dwgSave()                        -                   dwg save
--  mardradraftingapi()              -                   constructor
--  refreshCanvas()                  -                   refresh canvas
--
------------------------------------------------------------------------
import 'marAPI'
handle (1000,0)
endhandle

-- Define object
define object MARDRADRAFTINGAPI
  member .mDraft is ARRAY
  member .mUi    is ARRAY
  member .mUtil  is ARRAY
endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      mardradraftingapi
-- Description: constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .mardradraftingapi()
  using namespace 'AVEVA.Marine.Drafting'
  !this.mDraft.append(object MARDRAFTING())

  using namespace 'Aveva.Marine.UI'
  !this.mUi.append(object MARUI())

  using namespace 'Aveva.Marine.Utility'
  !this.mUtil.append(object MARUTIL())
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dwgSave
-- Description: dwg save
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dwgSave()
  if (!this.mDraft[1].dwgCurrent().not()) then
    return
  endif

  !this.mDraft[1].dwgSave()
  handle any
    !this.mUi[1].messageNoconfirm(!!error.text)
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dwgClose
-- Description: dwg close
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dwgClose()
  if (!this.mDraft[1].dwgCurrent().not()) then
    return
  endif

  if (!this.mDraft[1].dwgIsModified().not()) then
    !this.mDraft[1].dwgClose()
    return
  endif

  !answer = !!alert.question('Do you want to save the current drawing?' )
  if (!answer ne 'YES') then
    !this.mDraft[1].dwgClose()
    return
  endif

  !this.dwgSave()

  !this.mDraft[1].dwgClose()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dwgOpen
-- Description: dwg open
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      sheet name
--    2    R     BOOLEAN     check modify status
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dwgOpen(!sheetName is STRING, !checkModifyStatus is BOOLEAN)
  if (!checkModifyStatus) then
    !this.close()
  endif

  if (!this.mDraft[1].dwgCurrent()) then
    !this.mDraft[1].dwgClose()
  endif

  !this.mDraft[1].dwgOpen(!sheetName)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      dwgRepaint
-- Description: dwg repaint
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dwgRepaint()
  if (!this.mDraft[1].dwgCurrent().not()) then
    return
  endif

  !this.mDraft[1].dwgRepaint()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refreshCanvas
-- Description: refresh canvas
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .refreshCanvas()
  !this.mUi[1].appWindowRefresh()
endmethod
-- End of method
