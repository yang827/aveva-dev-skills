--------------------------------------------------------------------------------
--
-- Method:      onClickModifyBendRadius
--
-- Description: call when 'Modify Bend Radius' is clicked
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickModifyBendRadius()

  !rowTags = !this.gridDetails.getSelectedRowTags()
  if !rowTags.empty() then
    !!alert.message('Select bends to modify!')
    return
  endif

  !bendRefs = object ARRAY()

  do !rowTag values !rowTags

    !row = !this.gridDetails.getRow(!rowTag)
    !bendRef = !row[1].dbref()
    handle ANY
      !bendRef = object DBREF()
    endhandle

    if !bendRef.badref() then
      !!alert.error('Cannot get the selected element ' + !row[2] + '!')
      return
    endif

    !bendRefs.append(!bendRef)
  enddo

  !this.undo.description('Modify Bend Radius')
  !this.modifyBendRadius(!bendRefs)
  handle ANY
    !!alert.error(!!error.text)
  endhandle
  !this.undo.endUndoable()

  !this.refreshErrors()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      modifyBendRadius
--
-- Description: modify bend radius of the given bend components
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       bend components
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .modifyBendRadius(!bendRefs is ARRAY)

  !!edgCntrl.remove('PF - Pick Bends to Modify Radius')

  !column = !this.gridDetails.getColumn(1)

  do !bendRef values !bendRefs

    !branRef = !bendRef.owner
    !bendMacRef = !this.getBendingMachineReference(!branRef)

    !bendDetail = object ARRAY()
    !bendDetail[1] = !bendRef
    !bendDetail[2] = !bendRef.radius
    !bendDetail[3] = object DBREF()
    !bendDetail[4] = object REAL()

    if !bendMacRef.badref().not() then
      !this.findAvailableBendingMachine(!bendDetail, !bendMacRef)

      !oldBendRadius = !bendDetail[2]
      !newBendingMachine = !bendDetail[3]
      !newBendRadius = !bendDetail[4]

      if !newBendingMachine.badref().not() and !newBendRadius.set() then

        !newRadiusMM = !!comConvertUnknownValue(!newBendRadius, 'MM')
        !oldRadiusMM = !!comConvertUnknownValue(!bendRef.radius, 'MM')
        if !newRadiusMM.nint().neq(!oldRadiusMM.nint()) then

          !bendRef.radius = !newBendRadius
          handle ANY

            !error = object ARRAY()
            !error[1] = !bendRef
            !error[2] = !bendRef.moderr.radius

            !this.inputErrorMessage(!error)

          elsehandle NONE
            !enough = !this.checkBeforeAfterTubeLength(!bendRef)
            if !enough.not() then
              !bendRef.radius = !oldBendRadius
            endif
          endhandle

        endif
      else

        -- new bending machine reference cannot handle this bend
        !message = !bendMacRef.namty + ' cannot handle the OD (' + $
          !bendRef.aodiam.string(!!distanceFmt) + ') and wall thickness (' + !bendRef.awallt.string(!!distanceFmt) + ')'

        !error = object ARRAY()
        !error[1] = !bendRef
        !error[2] = !message

        !this.inputErrorMessage(!error)
      endif

    else
      !error = object ARRAY()
      !error[1] = !bendRef
      !error[2] = 'No BendMacReference is defined'

      !this.inputErrorMessage(!error)
    endif

    !oldBendRadius      = !bendDetail[2]
    !newBendingMachine  = !bendDetail[3]
    !newBendRadius      = !bendRef.radius

    !index = !column.findFirst(!bendRef.refNo.string())
    if !index.set() then

      !this.gridDetails.setCellValue(!index, 2, !bendRef.flnm)
      !this.gridDetails.setCellValue(!index, 3,  !bendRef.aodiam.string(!!distanceFmt))

      !changeStatus = 1

      if !newBendRadius.neq(!oldBendRadius) then
        !radiusString = 'Original radius of ' + !oldBendRadius.string(!!distanceFmt) + ' changed to ' + !newBendRadius.string(!!distanceFmt)
      else
        !radiusString = 'Original radius of ' + !oldBendRadius.string(!!distanceFmt) + ' not changed'
        if (!this.errorEntries.findFirst(!bendRef.refNo.string()).unset()) then
          !changeStatus = 2
        else
          !changeStatus = 3
        endif
      endif
      !this.gridDetails.setCellValue(!index, 4, !radiusString)

      if !newBendingMachine.set() then
        !newMachineName = !newBendingMachine.name
      else
        !newMachineName = ''
      endif

      !this.gridDetails.setCellValue(!index, 5, !newMachineName)
      !this.gridDetails.setCellValue(!index, 6, !oldBendRadius.string())
      !this.gridDetails.setCellValue(!index, 7, !newBendRadius.string())

      !this.gridDetails.setCellImage(!index, 2, !this.changeStatusImages[!changeStatus])
    endif

  enddo

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickPickBendsToModify
--
-- Description: callback called when 'Pick Bends to Modify Radius' is clicked
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickPickBendsToModify()

  !packet = object EDGPACKET()
  !packet.action = |!!pfAssignBendingMachine.onActionPickBend(!this.return)|
  !packet.escape = |!!pfAssignBendingMachine.onClickModifyBendRadius()|

  --!packet.definePosition('Pick part or <ESC> to finish')
  !packet.elementPick('Pick bends or <ESC> to finish')
  !packet.pickPacket.picks[1].pick.input[3] = |TYPE EQ 'BEND'|
  --!packet.pickPacket.picks[1].pick.input[5] = |FALSE|
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.description = 'PF - Pick Bends to Modify Radius'
  !packet.remove = false
  --!packet.form = !!pfFeedExcess

  if !!edgCntrl.add(!packet) then
    UNENHANCE ALL
    !this.gridDetails.clearRowSelection()
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      onActionPickBend
--
-- Description: callback called when a bend is picked during 'Pick Bends to Modify Radius' EDG session
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       EDG data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onActionPickBend(!data is ARRAY)

  if !data.unset() OR !data.empty() then
    return
  endif

  !item = !data[1].item
  if !item.compType.neq('VAR') then
    !!alert.message(!item.namty + ' is not a variable angle / variable radius bend(COMPTYPE = VAR)!')
  else
    !column = !this.gridDetails.getColumn(1)
    !index = !column.findFirst(!item.refNo.string())
    if !index.set() then
      !rowTag  = !this.gridDetails.getRowTag(!index)
      !rowTags = !this.gridDetails.getSelectedRowTags()
      !tagIndex = !rowTags.findFirst(!rowTag)
      if !tagIndex.set() then
        -- remove
        !rowTags.remove(!tagIndex)
      else
        -- add
        !rowTags.append(!rowTag)
      endif
      !this.gridDetails.setSelectedRowTags(!rowTags)
    endif

  endif
endmethod

-- Fix Issue 97660 (SI 57761)
--------------------------------------------------------------------------------
--
-- Method:      onClickRemoveSelected
--
-- Description: remove selected items from grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickRemoveSelected()
  -- delete selected rows
  !this.gridTargets.deleteSelectedRows()
endmethod

-- Fix Issue 105115 (SI 60022)
--------------------------------------------------------------------------------
--
-- Method:      inputErrorMessage
--
-- Description: input error message
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      ARRAY         error contents
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .inputErrorMessage(!errorContents is ARRAY)
  !elementRefNo = !errorContents[1].refNo.string()

  if (!this.errorEntries.findFirst(!elementRefNo).set()) then
    return
  endif

  !this.errors.append(!errorContents)
  !this.errorEntries.append(!elementRefNo)
endmethod

-- Fix Issue 117737 (SI 64116)
--------------------------------------------------------------------------------
--
-- Method:      initialiseDetails
--
-- Description: initialise detail grid
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       bend components
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .initialiseDetails()
  !bendRefList = object ARRAY()
  !rowIndex    = 0

  do !rowData values !this.gridTargets.getRows()
    !ownerRef = !rowData[1].dbref()
    handle any
      !error = object ARRAY()
      !error[1] = !rowData[1]
      !error[2] = 'Invalid reference'

      !this.inputErrorMessage(!error)
    endhandle

    !bendRefs = !!collectAllFor('BEND', |COMPTYPE EQ 'VAR'|, !ownerRef)
    skip if (!bendRefs.unset())













    do !bendRef values !bendRefs
      skip if (!bendRefList.findFirst(!bendRef).set())

      !bendDetail = object ARRAY()
      !bendDetail[1] = !bendRef
      !bendDetail[2] = !bendRef.radius
      !bendDetail[3] = object DBREF()
      !bendDetail[4] = object REAL()

     !branref = !bendRef.owner
     !bendMacRef = !this.getBendingMachineReference(!branref)
      if !bendMacRef.badref() then
        !bendMacRefName = ''
       else
         !bendMacRefName = !bendMacRef.flnm
       endif
      -- bend radius from assigned bending machine
      if !bendMacRef.badref().not() then
        !this.findAvailableBendingMachine(!bendDetail, !bendMacRef)
      endif

      !newBendRadius = !bendDetail[4]

      !row = object ARRAY()
      !row.append(!bendRef.refNo.string())
      !row.append(!bendRef.flnm)
      !row.append(!bendRef.aodiam.string(!!distanceFmt))

      !oldBendRadius = !!comConvertUnknownValue(!bendRef.radius, 'MM')
      !oldBendRadius = !oldBendRadius.string(!!distanceFmt).real()
      --!bendRadius     = 'Original radius of ' + !oldBendRadius.string(!!distanceFmt) + ' not changed'
      !bendRadius     = 'Current Radius is ' + !oldBendRadius.string(!!distanceFmt)

      if (!newBendRadius.set()) then
        if (!oldBendRadius ne !newBendRadius) then
          !bendRadius = 'Current radius of ' + !oldBendRadius.string(!!distanceFmt) + ' does not match machine radius of ' & !newBendRadius
        endif
      endif

      !row.append(!bendRadius)
      !row.append(!bendMacRefName)

      !bendRefList.append(!bendRef)
      !this.gridDetails.addRow(!row)
      !this.gridDetails.setCellImage(!bendRefList.size(), 2, !this.changeStatusImages[2])
    enddo
  enddo

  !this.gridDetails.autoFitColumns()
endmethod
