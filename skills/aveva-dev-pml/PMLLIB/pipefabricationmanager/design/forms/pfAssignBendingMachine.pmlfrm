------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   modify the bending machine of selected elements
--  checkBeforeAfterTubeLength(DBREF) BOOLEAN             check if the straight tube length before/after the given BEND is enough or not
--  findAvailableBendingMachine(ARRAY,DBREF) -                   find a bending machine which can handle the given bend element from given bending machine reference
--  getBendingMachineReference(DBREF) DBREF               return bending machine reference of the given element
--  getTargetBranches(DBREF,ARRAY)   ARRAY               get all target branches under the given scope
--  highlightAndZoom(DBREF)          -                   highlight and zoom the given element
--  init()                           -                   initialize this form
--  initialiseDetails()              -                   initialise detail grid
--  inputErrorMessage(ARRAY)         -                   input error message
--  modifyBendRadius(ARRAY)          -                   modify bend radius of the given bend components
--  modifyBendingMachineReference(ARRAY,DBREF) -                   modify bending machine reference of the given element with the new bending machine referenc
--  onActionPickBend(ARRAY)          -                   callback called when a bend is picked during 'Pick Bends to Modify Radius' EDG session
--  onClickAddTo3DView()             -                   add the selected element to 3D view
--  onClickHighlight()               -                   callback called when highlight checkbox is clicked
--  onClickModifyBendRadius()        -                   callback called when 'Modify Bend Radius' is clicked
--  onClickNavigateTo()              -                   navigate the selected element in the design explorer
--  onClickNavigateToBend()          -                   navigate the selected bend in the design explorer
--  onClickNavigateToError()         -                   navigate the selected error element in the design explorer
--  onClickPickBendsToModify()       -                   callback called when 'Pick Bends to Modify Radius' is clicked
--  onClickRemoveFrom3DView()        -                   remove the selected elements from 3D view
--  onClickRemoveSelected()          -                   remove selected items from grid control
--  onClickZoomTo()                  -                   zoom to the selected element in the 3D view
--  onClickZoomToBend()              -                   zoom to the selected bend in the 3D view
--  onClickZoomToError()             -                   zoom to the selected error in the 3D view
--  onGridDetailsAfterSelectChange(ARRAY) -                   called when the selection in the detail grid is changed
--  onGridDetailsPopup(ARRAY)        -                   show context menu for the detail grid control
--  onGridErrorsAfterSelectChange(ARRAY) -                   callback called when an error is selected in the error list
--  onGridErrorsPopup(ARRAY)         -                   show context menu for the error grid control
--  onGridTargetsAfterSelectChange(ARRAY) -                   callback called when the selection is changed
--  onGridTargetsPopup(ARRAY)        -                   show popup menu in the target grid gadget
--  pfAssignBendingMachine()         -                   constructor
--  quit()                           -                   called before the form is closed
--  refreshBendingMachines()         -                   populates the bending machine list
--  refreshDetails()                 -                   populates the detail grid gadget
--  refreshErrors()                  -                   populates the error grid gadget
--  refreshTargets()                 -                   populates the target elements
--  selectCE()                       -                   select the current element and refresh the target list
--  tidy(DBREF)                      -                   tidy the bending machine attribute of the given element
--  zoom(VOLUME)                     -                   zoom the area defined by the given volume object
--
--------------------------------------------------------------------------------
import 'GridControl'
handle any
endhandle

setup form !!pfAssignBendingMachine dialog dock resizable varchars
  using namespace 'Aveva.Pdms.Presentation'

  !this.initcall  = '!this.init()'
  !this.quitCall  = '!this.quit()'
  !this.formTitle = 'Assign Bending Machine'

  button .btnCE 'Add CE' callback '!this.selectCE()' width 8
  para .parCE width 28
  --toggle .togZoom 'Zoom when selected' anchor t+r

  path down
  container .netTarget PMLNETCONTROL 'targets' at xmin.btnCE ymax.btnCE + 0.25 anchor l+t+r width 50 height 12

  toggle .togHighlight 'Highlight selected elements' callback '!this.onClickHighlight()' anchor l+t tooltip 'Highlight selected elements'

  frame .frameBendingMachine 'Assign Bending Machine' anchor l+t+r width 50
    option .optMachines anchor l+t+r width 35.5 tooltip 'Select bending machine'
    path right
    button .btnApply 'Apply' callback '!this.apply()' anchor r+t wid 8 tooltip 'Apply selected bending machine'
    path down
    toggle .togModifyModel 'Modify Bend Radius' at xmin.optMachines tooltip 'Modify bend radius'
    path right
    toggle .togTidy 'Tidy' tooltip 'Tidy bending machine reference'
  exit

  path down
  frame .frameTabs tabset at xmin.frameBendingMachine anchor all wid 50 hei 12

    frame .frameDetails 'Details' dock fill
      container .netDetails nobox PMLNETCONTROL 'Details' dock fill
    exit

    frame .frameErrors 'Errors' dock fill
      container .netErrors nobox PMLNETCONTROL 'Errors' dock fill
    exit
  exit

  member .gridTargets       is NETGRIDCONTROL

  member .gridDetails       is NETGRIDCONTROL

  member .gridErrors        is NETGRIDCONTROL

  member .undo              is UNDOABLE

--  member .scopeRef          is DBREF

  member .details           is ARRAY

  member .errors            is ARRAY

  member .errorEntries      is ARRAY

  member .changeStatusImages is ARRAY
exit

--------------------------------------------------------------------------------
--
-- Method:      pfAssignBendingMachine
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfAssignBendingMachine()

  using namespace 'Aveva.Pdms.Presentation'

  -- initialize grid control
  !this.gridTargets = object NETGRIDCONTROL()
  !this.gridTargets.editableGrid(false)
  !this.gridTargets.columnExcelFilter(true)
  !this.gridTargets.setNameColumnImage()
  !this.gridTargets.outlookGroupStyle(false)
  !this.gridTargets.fixedHeaders(false)
  !this.gridTargets.fixedRows(false)
  !this.gridTargets.addEventHandler('AfterSelectChange',  !this, 'onGridTargetsAfterSelectChange')
  !this.gridTargets.addEventHandler('OnPopup',            !this, 'onGridTargetsPopup')
  !this.netTarget.control = !this.gridTargets.handle()

  !this.gridDetails = object NETGRIDCONTROL()
  !this.gridDetails.editableGrid(false)
  !this.gridDetails.columnExcelFilter(false)
  !this.gridDetails.setNameColumnImage()
  !this.gridDetails.outlookGroupStyle(false)
  !this.gridDetails.fixedHeaders(false)
  !this.gridDetails.fixedRows(false)
  !this.gridDetails.scrollSelectedRowToView(true)
  --!this.gridDetails.singleRowSelection(false)
  !this.gridDetails.addEventHandler('AfterSelectChange',  !this, 'onGridDetailsAfterSelectChange')
  !this.gridDetails.addEventHandler('OnPopup',            !this, 'onGridDetailsPopup')
  !this.netDetails.control = !this.gridDetails.handle()

  !this.gridErrors = object NETGRIDCONTROL()
  !this.gridErrors.editableGrid(false)
  !this.gridErrors.columnExcelFilter(false)
  !this.gridErrors.setNameColumnImage()
  !this.gridErrors.outlookGroupStyle(false)
  !this.gridErrors.fixedHeaders(false)
  !this.gridErrors.fixedRows(false)
  --!this.gridDetails.singleRowSelection(true)
  !this.gridErrors.addEventHandler('AfterSelectChange',  !this, 'onGridErrorsAfterSelectChange')
  !this.gridErrors.addEventHandler('OnPopup',            !this, 'onGridErrorsPopup')
  !this.netErrors.control = !this.gridErrors.handle()

  -- initialize context menu
  !this.newMenu('targetPopup')
  !this.targetPopup.add('CALLBACK', 'Remove Selected',            '!this.onClickRemoveSelected()',          'REMOVE_SELECTED')
  !this.targetPopup.add('SEPARATOR')
  !this.targetPopup.add('CALLBACK', 'Select All',                 '!this.gridTargets.selectAllRows()',      'SELECT_ALL')
  !this.targetPopup.add('CALLBACK', 'Unselect All',               '!this.gridTargets.clearRowSelection()',  'UNSELECT_ALL')
  !this.targetPopup.add('SEPARATOR')
  !this.targetPopup.add('CALLBACK', 'Add to 3D View',             '!this.onClickAddTo3DView()',             'ADD_TO_3DVIEW')
  !this.targetPopup.add('CALLBACK', 'Remove from 3D View',        '!this.onClickRemoveFrom3DView()',        'REMOVE_FROM_3DVIEW')
  !this.targetPopup.add('SEPARATOR')
  !this.targetPopup.add('CALLBACK', 'Zoom To',                    '!this.onClickZoomTo()',                  'ZOOM_TO')
  !this.targetPopup.add('CALLBACK', 'Navigate To',                '!this.onClickNavigateTo()',              'NAVIGATE_TO')
  !this.netTarget.popup = !this.targetPopup

  !this.newMenu('detailPopup')
  !this.detailPopup.add('CALLBACK', 'Modify Bend Radius',         '!this.onClickModifyBendRadius()',        'MODIFY_SELECTEDS')
  !this.detailPopup.add('CALLBACK', 'Pick Bends to Modify Radius','!this.onClickPickBendsToModify()',       'PICK_BENDS')
  !this.detailPopup.add('SEPARATOR')
  !this.detailPopup.add('CALLBACK', 'Select All',                 '!this.gridDetails.selectAllRows()',      'SELECT_ALL_DETAILS')
  !this.detailPopup.add('CALLBACK', 'Unselect All',               '!this.gridDetails.clearRowSelection()',  'UNSELECT_DETAILS')
  !this.detailPopup.add('SEPARATOR')
  !this.detailPopup.add('CALLBACK', 'Zoom To',                    '!this.onClickZoomToBend()',              'ZOOM_TO')
  !this.detailPopup.add('CALLBACK', 'Navigate To',                '!this.onClickNavigateToBend()',          'NAVIGATE_TO')
  !this.netDetails.popup = !this.detailPopup

  !this.newMenu('errorPopup')
  !this.errorPopup.add('CALLBACK', 'Select All',                 '!this.gridErrors.selectAllRows()',        'SELECT_ALL_ERRORS')
  !this.errorPopup.add('CALLBACK', 'Unselect All',               '!this.gridErrors.clearRowSelection()',    'UNSELECT_ERRORS')
  !this.errorPopup.add('SEPARATOR')
  !this.errorPopup.add('CALLBACK', 'Zoom To',                     '!this.onClickZoomToError()',             'ZOOM_TO')
  !this.errorPopup.add('CALLBACK', 'Navigate To',                 '!this.onClickNavigateToError()',         'NAVIGATE_TO')
  !this.netErrors.popup = !this.errorPopup

  !headings = object ARRAY()
  !headings[1] = 'Tag'
  !headings[2] = 'Bend'
  !headings[3] = 'OD'
  !headings[4] = 'Radius'
  !headings[5] = 'Bending Machine'
  !headings[6] = 'OldRadius'
  !headings[7] = 'NewRadius'

  !dataSource = object NETDATASOURCE('Details', !headings, object ARRAY())
  !this.gridDetails.bindToDataSource(!dataSource)
  !this.gridDetails.setColumnVisibility(1, false)
  !this.gridDetails.setColumnVisibility(6, false)
  !this.gridDetails.setColumnVisibility(7, false)
  !this.gridDetails.setColumnTextAlignment('OD', 'RIGHT')
  !this.gridDetails.autoFitColumns()

  !headings    = object ARRAY()
  !headings[1] = 'Tag'
  !headings[2] = 'Name'
  !headings[3] = 'Description'

  !dataSource = object NETDATASOURCE('Errors', !headings, object ARRAY())
  !this.gridErrors.bindToDataSource(!dataSource)
  !this.gridErrors.setColumnVisibility(1, false)
  !this.gridErrors.autoFitColumns()

  !this.frameErrors.tag = 'Errors (0)'


  -- modify bend radius
  !this.togModifyModel.val = true
  !this.togTidy.val = false

  !this.changeStatusImages.clear()
  !this.changeStatusImages.append(!!pml.getPathname('greenball12.png'))
  !this.changeStatusImages.append(!!pml.getPathname('yellowball12.png'))
  !this.changeStatusImages.append(!!pml.getPathname('redball12.png'))
endmethod

--------------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: initialize form
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .init()

  -- initialize pipe fabrication context
  !context = object PFCONTEXT()
  !context.globalInstance()

  !this.gridTargets.clearGridData()

  !this.selectCE()
  !this.refreshBendingMachines()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      selectCE
--
-- Description: select CE and refresh target grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .selectCE()

  UNENHANCE ALL

  BRAN
  handle ANY
    -- ignore
  endhandle

--  !this.scopeRef = !!ce
  !this.parCE.val = !!ce.name

  -- refresh target elements
  !this.refreshTargets()

  -- refresh detail information
  !this.details.clear()
  !this.gridDetails.clearGridData()

  !this.initialiseDetails()

  -- refresh errors
  !this.errors.clear()
  !this.errorEntries.clear()
  !this.gridErrors.clearGridData()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      refreshBendingMachines
--
-- Description: populate option gadget for bending machine reference
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .refreshBendingMachines()

  !dtext = object ARRAY()
  !rtext = object ARRAY()

  !fmwlRefs = !!collectAllFor('FMWL', '', WORLD)
  do !fmwlRef values !fmwlRefs
    !dtext.append(!fmwlRef.namty)
    !rtext.append(!fmwlRef.refNo.string())

    !fmgrpRefs = !!collectAllFor('FMGRP', '', !fmwlRef)
    do !fmgrpRef values !fmgrpRefs
      !dtext.append('  ' + !fmgrpRef.namty)
      !rtext.append(!fmgrpRef.refNo.string())

      !fmbendRefs = !!collectAllFor('FMBEND', |ACTTYPE EQ 'FMBEND'|, !fmgrpRef)
      do !fmbendRef values !fmbendRefs
        !dtext.append('    ' + !fmbendRef.namty)
        !rtext.append(!fmbendRef.refNo.string())
      enddo
    enddo
  enddo

  !dtext.append('Nulref')
  !rtext.append('')

  !this.optMachines.dtext = !dtext
  !this.optMachines.rtext = !rtext

endmethod


--------------------------------------------------------------------------------
--
-- Method:      quit
--
-- Description: clear screen and remove the aid number
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .quit()
  !!edgCntrl.remove('PF - Pick Bends to Modify Radius')
  UNENHANCE ALL
endmethod

--------------------------------------------------------------------------------
--
-- Method:      onGridTargetsPopup
--
-- Description: show context menu for the target grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onGridTargetsPopup(!data is ARRAY)

  !targetSelected = !data.size().gt(2)
  !this.targetPopup.setFieldProperty('ADD_TO_3DVIEW',       'ACTIVE', !targetSelected)
  !this.targetPopup.setFieldProperty('REMOVE_FROM_3DVIEW',  'ACTIVE', !targetSelected)
  !this.targetPopup.setFieldProperty('ZOOM_TO',             'ACTIVE', !targetSelected)
  !this.targetPopup.setFieldProperty('NAVIGATE_TO',         'ACTIVE', !targetSelected)

  !count = !this.gridTargets.getNumberRows()
  !this.targetPopup.setFieldProperty('SELECT_ALL',          'ACTIVE', !count.gt(0))
  !this.targetPopup.setFieldProperty('UNSELECT_ALL',        'ACTIVE', !count.gt(0))

  !this.netTarget.showPopup(!data[0], !data[1])
endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickAddTo3DView
--
-- Description: add the selected target elements to 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickAddTo3DView()

  !rowTags = !this.gridTargets.getSelectedRowTags()
  do !rowTag values !rowTags
    !targetRef = !this.gridTargets.getCell(!rowTag, 'Tag').dbref()
    handle ANY
    elsehandle NONE
      ADD $!targetRef
    endhandle
  enddo

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickRemoveFrom3DView
--
-- Description: remove the selected elements from 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickRemoveFrom3DView()
  !rowTags = !this.gridTargets.getSelectedRowTags()
  do !rowTag values !rowTags
    !targetRef = !this.gridTargets.getCell(!rowTag, 'Tag').dbref()
    handle ANY
    elsehandle NONE
      REM $!targetRef
    endhandle
  enddo
endmethod


--------------------------------------------------------------------------------
--
-- Method:      onClickZoomTo
--
-- Description: zoom to the selected target element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickZoomTo()
  !targetRefs = object ARRAY()

  !rowTags = !this.gridTargets.getSelectedRowTags()
  do !rowTag values !rowTags
    !targetRef = !this.gridTargets.getCell(!rowTag, 'Tag').dbref()
    handle ANY
    elsehandle NONE
      if !targetRef.set() then
        !targetRefs.append(!targetRef)
      endif
    endhandle
  enddo

  if !targetRefs.empty().not() then
    !this.zoom(object VOLUME(!targetRefs))
  endif
endmethod


--------------------------------------------------------------------------------
--
-- Method:      onClickNavigateTo
--
-- Description: navigate the selected target in the design hierarchy
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickNavigateTo()
  !rowTags = !this.gridTargets.getSelectedRowTags()
  if !rowTags.empty().not() then
    !targetRef = !this.gridTargets.getCell(!rowTags.last(), 'Tag').dbref()
    handle ANY
    elsehandle NONE
      if !targetRef.set() then
        !!ce = !targetRef
      endif
    endhandle
  endif
endmethod


--------------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: change bending machine reference of the selected target elements
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .apply()

  -- clear old data
  UNENHANCE ALL

  !this.details.clear()
  !this.errors.clear()
  !this.errorEntries.clear()

  !this.gridDetails.clearGridData()
  !this.gridErrors.clearGridData()

  -- get all target elements
  !targetRefs = object ARRAY()
  !rowTags = !this.gridTargets.getSelectedRowTags()
  do !rowTag values !rowTags
    !row = !this.gridTargets.getRow(!rowTag)
    !targetRef = !row[1].dbref()
    handle ANY
      !!alert.error('Cannot get the selected element ' + !row[2])
--      !this.refreshTargets()
      return
    endhandle

    -- grouping by type
    if !targetRef.badref().not() then
      !targetRefs.append(!targetRef)
    endif

  enddo

  if !targetRefs.empty() then
    !!alert.message('Select targets')
    return
  endif

  -- get selected bending machine reference
  !machineName = !this.optMachines.selection('rtext')
  if !machineName.empty() then
    !machineRef = object DBREF()
  else
    !machineRef = !machineName.dbref()
    handle ANY
      !!alert.error('Cannot get ' + !this.optMachines.selection('dtext'))
      !this.refreshBendingMachines()
      return
    endhandle
  endif

  !this.undo.description('Change Bending Machine Reference ')
  !this.modifyBendingMachineReference(!targetRefs, !machineRef)
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  !this.undo.endUndoable()

  -- refresh bending machine reference
  !rowCount = !this.gridTargets.getNumberRows()
  do !i to !rowCount
    !targetRef = !this.gridTargets.getCell(!i, 1).dbref()
    handle ANY
      !targetRef = object ARRAY()
    endhandle

    !bendMacRef = !targetRef.bendMacRef

    !machineName = ''
    if !bendMacRef.set() and !bendMacRef.badref().not() then
      !machineName = !bendMacRef.name
    endif

    !this.gridTargets.setCellValue(!i, 4, !machineName)
  enddo

  -- refresh details
  !this.refreshDetails()

  -- refresh errors
  !this.refreshErrors()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      modifyBendingMachineReference
--
-- Description: modify bending machine reference of the given element with the new bending machine reference
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      ARRAY       target elements
--    2    R      DBREF       new bending machine reference
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .modifyBendingMachineReference(!targetRefs is ARRAY, !newBendMacRef is DBREF)

  !modifyModel  = !this.togModifyModel.val
  !tidy = !this.togTidy.val

  -- get all bend information
  !allBendCount = 0
  !modifyCount = 0

  UNENHANCE ALL

  do !targetRef values !targetRefs

    !detailDatum = object ARRAY()
    !detailDatum[1] = !targetRef
    !detailDatum[2] = !targetRef.bendMacReference
    !detailDatum[3] = object DBREF()
    !detailDatum[4] = object ARRAY()

    if !newBendMacRef.badref() and !targetRef.type.neq('ZONE') then
      -- get owner's bending machine reference
      !ownerBendMacRef = !this.getBendingMachineReference(!targetRef.owner)
      !detailDatum[3] = !ownerBendMacRef
    endif

    -- get all branches under target
    !branRefs = !this.getTargetBranches(!targetRef, !targetRefs)
    do !branRef values !branRefs

      !branDatum = object ARRAY()
      !branDatum[1] = !branRef
      !branDatum[2] = object ARRAY()

      -- get all bends under the current branch
      !bendRefs = !!collectAllFor('BEND', |COMPTYPE EQ 'VAR'|, !branRef)

      !allBendCount = !allBendCount + !bendRefs.size()

      do !bendRef values !bendRefs

        !bendDetail = object ARRAY()
        !bendDetail[1] = !bendRef
        !bendDetail[2] = !bendRef.radius
        !bendDetail[3] = object DBREF()
        !bendDetail[4] = object REAL()

        -- get new bending machine and bend radius
        if !newBendMacRef.badref().not() then
          !this.findAvailableBendingMachine(!bendDetail, !newBendMacRef)
        else
          -- given bending machine is unset, let's try to use owner's bending machine reference
          !ownerBendMacRef = !detailDatum[3]
          if !ownerBendMacRef.badref().not() then
            !this.findAvailableBendingMachine(!bendDetail, !ownerBendMacRef)
          endif
        endif

        !newBendRadius = !bendDetail[4]
        if !newBendRadius.set() then
          !newRadiusMM = !!comConvertUnknownValue(!newBendRadius, 'MM')
          !oldRadiusMM = !!comConvertUnknownValue(!bendRef.radius, 'MM')
          if !newRadiusMM.nint().neq(!oldRadiusMM.nint()) then
            !modifyCount = !modifyCount + 1

            if !modifyModel then
              ENHANCE $!bendRef COLOUR $!!gphColOpt.highlight
            endif
          endif
        endif

--        if !modifyModel then
--          -- get new bending machine and bend radius
--          if !newBendMacRef.set() then
--            !this.findAvailableBendingMachine(!bendDetail, !newBendMacRef)
--          else
--            -- given bending machine is unset, let's try to use owner's bending machine reference
--            !ownerBendMacRef = !detailDatum[3]
--            if !ownerBendMacRef.set() then
--              !this.findAvailableBendingMachine(!bendDetail, !ownerBendMacRef)
--            endif
--          endif
--
--          !newBendRadius = !bendDetail[4]
--          if !newBendRadius.set() and !newBendRadius.string(!!distanceFmt).neq(!bendRef.radius.string(!!distanceFmt)) then
--            !modifyCount = !modifyCount + 1
--          endif
--        endif

        !branDatum[2].append(!bendDetail)
      enddo

      !detailDatum[4].append(!branDatum)
    enddo

    !this.details.append(!detailDatum)
  enddo

  -- confirm modification
  if !modifyModel then

    if !modifyCount.gt(0) then
      !answer = !!alert.confirm('Bend radius will be changed. Continue?')
      if !answer.neq('YES') then
        UNENHANCE ALL
        !this.onClickHighlight()
        return
      endif
    endif

    UNENHANCE ALL

    -- modify bend machine reference and bend radius
    do !i indices !this.details

      --!rollback = false

      !targetRef       = !this.details[!i][1]
      --!oldBendMacRef   = !details[!i][2]
      !ownerBendMacRef = !this.details[!i][3]

      -- get actual bending machine reference
      !bendMacRef = object DBREF()
      if !newBendMacRef.badref().not() then
        !bendMacRef = !newBendMacRef
      elseif !ownerBendMacRef.badref().not() then
        !bendMacRef = !ownerBendMacRef
      endif

      if !bendMacRef.badref().not() then
        !targetRef.bendMacReference = !newBendMacRef
        handle ANY

          !error = object ARRAY()
          !error[1] = !targetRef
          !error[2] = !targetRef.moderr.bendMacReference

          !this.inputErrorMessage(!error)
          --!rollback = true

        elsehandle NONE

          do !j indices !this.details[!i][4]
            do !k indices !this.details[!i][4][!j][2]

              !bendRef            = !this.details[!i][4][!j][2][!k][1]
              !oldBendRadius      = !this.details[!i][4][!j][2][!k][2]
              !newBendingMachine  = !this.details[!i][4][!j][2][!k][3]
              !newBendRadius      = !this.details[!i][4][!j][2][!k][4]

              if !newBendingMachine.set() then

                !bendRef.radius = !newBendRadius
                handle ANY

                  !error = object ARRAY()
                  !error[1] = !bendRef
                  !error[2] = !bendRef.moderr.radius

                  !this.inputErrorMessage(!error)

                  --!rollback = true

                elsehandle NONE
                  !enough = !this.checkBeforeAfterTubeLength(!bendRef)
                  if !enough.not() then
                    !bendRef.radius = !oldBendRadius
                  endif
                endhandle

                -- check before/after tube length
                --!this.checkBeforeAfterTubeLength(!bendRef)
                --!passed = !this.checkBeforeAfterTubeLength(!bendRef)
                --if !passed.not() then
                --  !rollback = true
                --endif

              else

                -- new bending machine reference cannot handle this bend
                !message = !bendMacRef.namty + ' cannot handle the OD (' + $
                  !bendRef.aodiam.string(!!distanceFmt) + ') and wall thickness (' + !bendRef.awallt.string(!!distanceFmt) + ')'

                !error = object ARRAY()
                !error[1] = !bendRef
                !error[2] = !message

                !this.inputErrorMessage(!error)

                --!rollback = true

              endif

            enddo
          enddo

        endhandle
      else

        !targetRef.bendMacReference = !newBendMacRef
        handle ANY
          !error = object ARRAY()
          !error[1] = !targetRef
          !error[2] = !targetRef.moderr.bendMacReference

          !this.inputErrorMessage(!error)
        elsehandle NONE

          !error = object ARRAY()
          !error[1] = !targetRef
          !error[2] = 'No BendMacReference is defined'

          !this.inputErrorMessage(!error)
        endhandle

        --!rollback = true
      endif

--      if !rollback then
--
--        -- rollback bending machine reference
--        !targetRef.bendMacReference = !oldBendMacRef
--
--        -- rollback all bend radius
--        do !j indices !details[!i][4]
--          do !k indices !details[!i][4][!j][2]
--
--            -- rollback bend radius
--            !bendRef       = !details[!i][4][!j][2][!k][1]
--            !oldBendRadius = !details[!i][4][!j][2][!k][2]
--            !bendRef.radius = !oldBendRadius
--
--            -- reset new bending machine
--            !details[!i][4][!j][2][!k][3] = object DBREF()
--          enddo
--        enddo
--
--      else
--        if !tidy then
--          !this.tidy(!targetRef)
--          handle ANY
--            -- ignore
--          endhandle
--        endif
--      endif
        if !tidy then
          !this.tidy(!targetRef)
          handle ANY
            -- ignore
          endhandle
        endif

    enddo

  else

    do !targetRef values !targetRefs
      !targetRef.bendMacReference = !newBendMacRef
      handle ANY
        !error = object ARRAY()
        !error[1] = !targetRef
        !error[2] = !!error.text

        !this.inputErrorMessage(!error)
      elsehandle NONE
        if !tidy then
          !this.tidy(!targetRef)
          handle ANY
            -- ignore
          endhandle
        endif
      endhandle

    enddo
  endif

  !this.onClickHighlight()
endmethod


--------------------------------------------------------------------------------
--
-- Method:      refreshTargets
--
-- Description: search target elements and populate grid control with the result
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .refreshTargets()
  using namespace 'Aveva.Pdms.Presentation'

  !headings = object ARRAY()
  !headings[1] = 'Tag'
  !headings[2] = 'Name'
  !headings[3] = 'Type'
  !headings[4] = 'BendMacReference'

  !elementRefNoList = !this.gridTargets.getColumn(1)

  !targetGridElements = object ARRAY()
  do !elementName values !elementRefNoList
    !dbref = !elementName.dbref()
    handle any
      !dbref = object DBREF()
    endhandle

    skip if (!dbref.badref())

    !targetGridElements.append(!dbref)
  enddo

  !searchTypes = object ARRAY()
  if (!!ce.type eq 'BRAN') then
    !searchTypes.append('BRAN')
  elseif (!!ce.type eq 'PIPE') then
    !searchTypes.append('PIPE')
    !searchTypes.append('BRAN')
  else
    !searchTypes.append('ZONE')
    !searchTypes.append('PIPE')
    !searchTypes.append('BRAN')
  endif

  !collection = object COLLECTION()
  !collection.types(!searchTypes)
  !collection.scope(!!ce)
  !results = !collection.results()

  do !entry values !results
    !index  = !targetGridElements.findFirst(!entry)
    if (!index.set()) then
      !targetGridElements.remove(!index)
    endif

   !targetGridElements.append(!entry)
  enddo

  !targetGridElements.unique()

  !rows = object ARRAY()
  do !entry values !targetGridElements
    !row = object ARRAY()
    !row[1] = !entry.refNo.string()
    !row[2] = !entry.flnm
    !row[3] = !entry.type

    !bendMacRef = !entry.bendMacReference
    if !bendMacRef.badref() then
      !row[4] = ''
    else
      !row[4] = !bendMacRef.name
    endif

    !rows.append(!row)
  enddo

  !dataSource = object NETDATASOURCE('Targets', !headings, !rows)
  !this.gridTargets.bindToDataSource(!dataSource)
  !this.gridTargets.setColumnVisibility(1, false)
  !this.gridTargets.autoFitColumns()
  !this.gridTargets.clearRowSelection()

  !this.btnApply.active = false

endmethod

define method .refreshDetails()

  !this.errorEntries.unique()
  !this.gridDetails.clearGridData()

  !rowIndex = 1
  do !i indices !this.details
    !targetRef = !this.details[!i][1]
    do !j indices !this.details[!i][4]
      !branRef = !this.details[!i][4][!j][1]
      do !k indices !this.details[!i][4][!j][2]
        !bendRef            = !this.details[!i][4][!j][2][!k][1]
        !oldBendRadius      = !this.details[!i][4][!j][2][!k][2]
        !newBendingMachine  = !this.details[!i][4][!j][2][!k][3]
        !newBendRadius      = !bendRef.radius

        !row = object ARRAY()
        !row[1] = !bendRef.refNo.string()
        !row[2] = !bendRef.flnm
        !row[3] = !bendRef.aodiam.string(!!distanceFmt)

        !changeStatus = 1

        if !newBendRadius.neq(!oldBendRadius) then
          !row[4] = 'Original radius of ' + !oldBendRadius.string(!!distanceFmt) + ' changed to ' + !newBendRadius.string(!!distanceFmt)
        else
          !row[4] = 'Original radius of ' + !oldBendRadius.string(!!distanceFmt) + ' not changed'
          if (!this.errorEntries.findFirst(!row[1]).unset()) then
            !changeStatus = 2
          else
            !changeStatus = 3
          endif
        endif

        if !newBendingMachine.set() then
          !row[5] = !newBendingMachine.name
        else
          !row[5] = ''
        endif

        !row[6] = !oldBendRadius.string()
        !row[7] = !newBendRadius.string()

        !this.gridDetails.addRow(!row)

        !this.gridDetails.setCellImage(!rowIndex, 2, !this.changeStatusImages[!changeStatus])
        !rowIndex = !rowIndex + 1
      enddo
    enddo
  enddo

  !this.gridDetails.autoFitColumns()
  !this.gridDetails.clearRowSelection()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      refreshErrors
--
-- Description: populate all bends which cannot be remodelled with the new bending machine
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      ARRAY       array of bend references
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .refreshErrors()

  !this.gridErrors.clearGridData()

  do !i indices !this.errors
    !row = object ARRAY()
    !row[1] = !this.errors[!i][1].refNo.string()
    !row[2] = !this.errors[!i][1].flnm
    !row[3] = !this.errors[!i][2]

    !this.gridErrors.addRow(!row)
  enddo

  !this.gridErrors.autoFitColumns()
  !this.gridErrors.clearRowSelection()

  !this.frameErrors.tag = 'Errors (' + !this.errors.size().string() + ')'

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onGridTargetsAfterSelectChange
--
-- Description: called when selection is changed in the target grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      ARRAY       event arguments
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onGridTargetsAfterSelectChange(!data is ARRAY)
  -- Fix for Issue 94966 (SI-56461)
  UNENHANCE ALL

  !targetRefs = object ARRAY()

  !rowTags = !this.gridTargets.getSelectedRowTags()
  do !rowTag values !rowTags
    !targetRef = !this.gridTargets.getCell(!rowTag, 'Tag').dbref()
    handle ANY
      -- cannot get the selected element reference, just refresh list and return
--      !this.refreshTargets()
      return
    endhandle
    !targetRefs.append(!targetRef)
  enddo

  !this.btnApply.active = !targetRefs.empty().not()

  if !this.togHighlight.val then
    do !targetRef values !targetRefs
      ENHANCE $!targetRef COLOUR $!!gphColOpt.highlight
    enddo
  endif

endmethod


--------------------------------------------------------------------------------
--
-- Method:      onGridErrorsAfterSelectChange
--
-- Description: called when the selection in the error grid is changed
--              highlight an element which is related to the selected error entry
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      ARRAY       event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onGridErrorsAfterSelectChange(!data is ARRAY)

  UNENHANCE ALL

  -- get selected error item
  !rowTags = !this.gridErrors.getSelectedRowTags()
  if !rowTags.empty() then
    return
  endif

  !elements = object ARRAY()
  do !rowTag values !rowTags
    !row = !this.gridErrors.getRow(!rowTag)

    !element = !row[1].dbref()
    handle ANY
      !element = object DBREF()
    endhandle

    if !element.set() then
      !elements.append(!element)
    else
      !!alert.error('Cannot get the selected element ' + !row[2])
    endif
  enddo

  if !elements.empty() then
    return
  endif

  -- highlight & zoom
  do !element values !elements
    ENHANCE $!element COLOUR $!!gphColOpt.highlight
  enddo

  --!this.zoom(object VOLUME(!elements))

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onGridDetailsAfterSelectChange
--
-- Description: called when the selection in the detail grid is changed
--              highlight the selected bend element
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      ARRAY       event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onGridDetailsAfterSelectChange(!data is ARRAY)

  UNENHANCE ALL

  -- get selected detail item
  !rowTags = !this.gridDetails.getSelectedRowTags()
  if !rowTags.empty() then
    return
  endif

  !bendRefs = object ARRAY()

  do !rowTag values !rowTags
    !row = !this.gridDetails.getRow(!rowTag)
    !bendRef = !row[1].dbref()
    handle ANY
      !bendRef = object DBREF()
    endhandle

    if !bendRef.set() then
      !bendRefs.append(!bendRef)
    else
      !!alert.error('Cannot get the selected element ' + !row[2])
    endif
  enddo

  if !bendRefs.empty() then
    return
  endif

  -- highlight & zoom
  do !bendRef values !bendRefs
    ENHANCE $!bendRef COLOUR $!!gphColOpt.highlight
  enddo

  --!branRefs = object ARRAY()
  --do !bendRef values !bendRefs
  --  !branRefs.append(!bendRef.owner)
  --enddo

  --!this.zoom(object VOLUME(!bendRefs))

endmethod


--------------------------------------------------------------------------------
--
-- Method:      getBendingMachineReference
--
-- Description: return bending machine reference of the given element
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      DBREF       ZONE or PIPE or BRAN element
-- Return:
--   [Data Type] [Description]
--    DBREF       bending machine reference
--------------------------------------------------------------------------------
define method .getBendingMachineReference(!targetRef is DBREF) is DBREF

  !bendMacRef = !targetRef.bendMacReference
  !targetType = !targetRef.type
  if !bendMacRef.badref() then
    if !targetType.eq('BRAN') then
      !bendMacRef = !targetRef.owner.bendMacReference
      if !bendMacRef.badref() then
        !bendMacRef = !targetRef.owner.owner.bendMacReference
      endif
    elseif !targetType.eq('PIPE') then
      !bendMacRef = !targetRef.owner.bendMacReference
    endif
  endif
  if !bendMacRef.badref() then
    !bendMacRef = object DBREF()
  endif

  return !bendMacRef
endmethod

--------------------------------------------------------------------------------
--
-- Method: findAvailableBendingMachine
--
-- Description: find a bending machine which can handle the given bend element from given bending machine reference
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    RW     ARRAY       bend information
--    2    R      DBREF       bending machine reference
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .findAvailableBendingMachine(!bendDetail is ARRAY, !bendMacRef is DBREF)

  !bendRef = !bendDetail[1]

  !outsideDiameter = !bendRef.aodiam
  !wallThickness = !bendRef.awallt

  !outsideDiameter = !!pfContext.formatOD(!outsideDiameter).real()
  !wallThickness = !!pfContext.formatWallThickness(!wallThickness).real()

  !filter = |OD EQ $!outsideDiameter AND WTHICKNESS EQ $!wallThickness|
  !fmbdimRefs = !!collectAllFor('FMBDIM', !filter, !bendMacRef)
  if !fmbdimRefs.empty() then
    !filter = |OD EQ $!outsideDiameter AND WTHICKNESS EQ 0|
    !fmbdimRefs = !!collectAllFor('FMBDIM', !filter, !bendMacRef)
    if !fmbdimRefs.empty() then
      !filter = |OD EQ 0 AND WTHICKNESS EQ 0|
      !fmbdimRefs = !!collectAllFor('FMBDIM', !filter, !bendMacRef)
    endif
  endif

  if !fmbdimRefs.empty().not() then
    -- given bending machine can handle this bend
    !fmbdimRef = !fmbdimRefs.first()
    -- cache FMBEND
    !bendDetail[3] = !fmbdimRef.owner

    -- cache new bend radius
    if !fmbdimRef.benpir.eq(0) and !fmbdimRef.bradius.gt(0) then
      -- old style
      !bendDetail[4] = !fmbdimRef.od * !fmbdimRef.bradius
    else
      -- new style
      !bendDetail[4] = !fmbdimRef.benpir
    endif
  endif
endmethod


--------------------------------------------------------------------------------
--
-- Method: tidy
--
-- Description: tidy bending machine reference
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      DBREF       target
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .tidy(!targetRef is DBREF)

  !machineRef = !targetRef.bendMacReference

  if !machineRef.badref().not() then

    !targetType = !targetRef.type
    if !targetType.eq('ZONE') then

      -- unset if the bending machine reference is same with the owners's
      !pipeRefs = !!collectAllFor('PIPE', 'BENDMACREF EQ $!machineRef', !targetRef)
      do !pipeRef values !pipeRefs
        !pipeRef.bendMacReference = object DBREF()
        handle ANY
        endhandle

        -- unset if the bending machine reference of child branch is same with the parent pipe
        !branRefs = !!collectAllFor('BRAN', 'BENDMACREF EQ $!machineRef', !pipeRef)
        do !branRef values !branRefs
          !branRef.bendMacReference = object DBREF()
          handle ANY
          endhandle
        enddo
      enddo

      -- unset if the bending machine reference of child pipe is same with the parent pipe
      !pipeRefs = !!collectAllFor('PIPE', 'UNSET(BENDMACREF)', !targetRef)
      do !pipeRef values !pipeRefs
        !branRefs = !!collectAllFor('BRAN', 'BENDMACREF EQ $!machineRef', !pipeRef)
        do !branRef values !branRefs
          !branRef.bendMacReference = object DBREF()
          handle ANY
          endhandle
        enddo
      enddo

    elseif !targetType.eq('PIPE') then

      -- unset if the bending machine reference of child branch is same with the parent pipe
      !branRefs = !!collectAllFor('BRAN', 'BENDMACREF EQ $!machineRef', !targetRef)
      do !branRef values !branRefs
        !branRef.bendMacReference = object DBREF()
        handle ANY
        endhandle
      enddo

      !zoneRef = !targetRef.owner
      -- unset if the bending machine reference is same with the owners's
      if !machineRef.eq(!zoneRef.bendMacReference) then
        !targetRef.bendMacReference = object DBREF()
        handle ANY
        endhandle
      endif

    elseif !targetType.eq('BRAN') then

      !pipeRef = !targetRef.owner
      if !machineRef.eq(!pipeRef.bendMacReference) then

        -- unset if the bending machine reference of the branch is same with the parent pipe
        !targetRef.bendMacReference = object DBREF()
        handle ANY
        endhandle
      elseif !pipeRef.bendMacReference.badref() then

        -- unset if the bending machine reference of the branch is same with the parent zone and pipe's is unset
        !zoneRef = !pipeRef.owner
        if !machineRef.eq(!zoneRef.bendMacReference) then
          !targetRef.bendMacReference = object DBREF()
          handle ANY
          endhandle
        endif
      endif
    endif
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method: getTargetBranches
--
-- Description: return all branches of which bendMacReference is not defined in the given element
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      DBREF       target
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of branches
--------------------------------------------------------------------------------
define method .getTargetBranches(!targetRef is DBREF, !targetRefs is ARRAY) is ARRAY

  !results = object ARRAY()

  !filter = 'UNSET(BENDMACREF)'

  --!bendMacReference = !targetRef.bendMacReference
  --if !bendMacReference.badref() then
  --  !filter = 'UNSET(BENDMACREF)'
  --else
  --  !filter = 'BENDMACREF EQ $!bendMacReference OR UNSET(BENDMACREF)'
  --endif

  !targetType = !targetRef.type
  if !targetType.eq('ZONE') then
    !pipeRefs = !!collectAllFor('PIPE', !filter, !targetRef)
    do !pipeRef values !pipeRefs
      if !targetRefs.findFirst(!pipeRef).unset() then
        !branRefs = !!collectAllFor('BRAN', !filter, !pipeRef)
        do !branRef values !branRefs
          if !targetRefs.findFirst(!branRef).unset() then
            !results.append(!branRef)
          endif
        enddo
      endif
    enddo
  elseif !targetType.eq('PIPE') then
    !branRefs = !!collectAllFor('BRAN', !filter, !targetRef)
    do !branRef values !branRefs
      if !targetRefs.findFirst(!branRef).unset() then
        !results.append(!branRef)
      endif
    enddo
  elseif !targetType.eq('BRAN') then
    !results.append(!targetRef)
  endif

  return !results

endmethod

--------------------------------------------------------------------------------
--
-- Method: highlightAndZoom
--
-- Description: highlight and zoom the given element
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      DBREF       element to be highlighted and zoomed
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .highlightAndZoom(!element is DBREF)

  UNENHANCE ALL

  !!fmSys.currentDocument().view.refresh()
  ENHANCE $!element COLOUR $!!gphColOpt.highlight
  if !element.owner.type.eq('BRAN') then
    !this.zoom(object VOLUME(!element.owner ))
  else
    !this.zoom(object VOLUME(!element))
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method: zoom
--
-- Description: zoom the area of the given volume
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      VOLUME      volume to zoom
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .zoom(!volume is VOLUME)

  !from         = !volume.from
  !to           = !volume.to

  -- Through Point
  !throughPoint   = !from.midPoint(!to)
  handle ANY
    return
  endhandle

  -- Set metric format
  !format           = object FORMAT()
  !format.units     = 'MM'
  !format.dp        = 0
  !format.dimension = 'L'

  -- Set through point
  !through[1]     = !throughPoint.east.string(!format).real()
  !through[2]     = !throughPoint.north.string(!format).real()
  !through[3]     = !throughPoint.up.string(!format).real()
  !!fmSys.currentDocument().view.through = !through

  -- Set view radius
  !radius         = !from.distance(!to).string(!format).real() / 2
  !radius         = !radius.max(500mm)
  !!fmSys.currentDocument().view.radius = !radius
endmethod

--------------------------------------------------------------------------------
--
-- Method: checkBeforeAfterTubeLength
--
-- Description: check if the straight tube length before/after the given BEND is enough or not
--
-- Method Type: Function
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      DBREF       bend element
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .checkBeforeAfterTubeLength(!bendRef is DBREF) is BOOLEAN

  !branRef = !bendRef.owner
  !memberRefs = !branRef.members
  !memberCount = !memberRefs.size()

  -- check if there is enough tube length before/after the bend
  !enoughPrevTubeLength = true
  !enoughNextTubeLength = true

  !sequence = !bendRef.sequence
  if !sequence.eq(1) then
    !prevPosition = !branRef.hPosition
  else
    !prevPosition = !memberRefs[!sequence - 1].lPosition
  endif

  if !bendRef.aPosition.neq(!prevPosition) then
    !direction = !bendRef.aPosition.direction(!prevPosition)
    handle (2, 891)
      -- An invalid zero direction has been obtained
      -- This means the two positions are same
    elsehandle NONE
      !enoughPrevTubeLength = !bendRef.aDirection.dot(!direction).geq(0)
      if !enoughPrevTubeLength.not() then
        !distance = !bendRef.aPosition.distance(!prevPosition)
        !enoughPrevTubeLength = !distance.leq(1mm)
      endif
    endhandle
  endif

  if !sequence.eq(!memberCount) then
    !nextPosition = !branRef.tPosition
  else
    !nextPosition =!memberRefs[!sequence + 1].aPosition
  endif

  if !bendRef.lPosition.neq(!nextPosition) then
    !direction = !bendRef.lPosition.direction(!nextPosition)
    handle (2, 891)
      -- An invalid zero direction has been obtained
    elsehandle NONE
      !enoughNextTubeLength = !bendRef.lDirection.dot(!direction).geq(0)
      if !enoughPrevTubeLength.not() then
        !distance = !bendRef.lPosition.distance(!nextPosition)
        !enoughPrevTubeLength = !distance.leq(1mm)
      endif
    endhandle
  endif

  if !enoughPrevTubeLength.not() or !enoughNextTubeLength.not() then

    !message = 'Not enough tube length '
    if !enoughPrevTubeLength.not() then
      !message = !message + 'before'
    endif
    if !enoughNextTubeLength.not() then
      if !enoughPrevTubeLength.not() then
        !message = !message + '/'
      endif
      !message = !message + 'after'
    endif
    !message = !message + ' ' + !bendRef.namty

    !error = object ARRAY()
    !error[1] = !bendRef
    !error[2] = !message

    !this.inputErrorMessage(!error)

    return false

  endif

  return true
endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickHighlight
--
-- Description: callback called when highlight checkbox is clicked
--              enhance/unenhance selected elements
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickHighlight()

  UNENHANCE ALL

  !checked = !this.togHighlight.val
  if !checked.not() then
    return
  endif

  !rowTags = !this.gridTargets.getSelectedRowTags()
  if !rowTags.empty() then
    return
  endif

  -- highlight selected target elements
  do !rowTag values !rowTags
    !element = !this.gridTargets.getCell(!rowTag, 'Tag').dbref()
    handle ANY
      !element = object DBREF()
    endhandle

    if !element.badref().not() then
      if !element.hardType eq 'BRAN' then
        !members = !element.members
        do !entry values !members
          ENHANCE $!entry COLOUR $!!gphColOpt.highlight
          if !entry.tGeom then
            !tubeRef = IL TUBE of $!entry
            ENHANCE $!tubeRef COLOUR $!!gphColOpt.highlight
          endif
        enddo
      else
        ENHANCE $!element COLOUR $!!gphColOpt.highlight
      endif
    endif
  enddo

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onGridDetailsPopup
--
-- Description: show context menu for the detail grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onGridDetailsPopup(!data is ARRAY)
--  if (!this.btnApply.active.not()) then
--    return
--  endif

  !selected = !data.size().gt(2)
--  !this.detailPopup.setFieldProperty('ZOOM_TO',     'ACTIVE', !selected)
--  !this.detailPopup.setFieldProperty('NAVIGATE_TO', 'ACTIVE', !selected)

  !modify = false
  !rowTags = !this.gridDetails.getSelectedRowTags()
  do !rowTag values !rowTags
    !row = !this.gridDetails.getRow(!rowTag)
    !oldBendRadius = !row[6].real()
    !newBendRadius = !row[7].real()
    if !newBendRadius.set() then
      !modify = true
      break
    endif
  enddo
--  !this.detailPopup.setFieldProperty('MODIFY_SELECTEDS', 'ACTIVE', !modify)

  !pickBends = false
  !count = !this.gridDetails.getNumberRows()
  do !i to !count
    !row = !this.gridDetails.getRow(!i)
    !oldBendRadius = !row[6].real()
    !newBendRadius = !row[7].real()
    if !newBendRadius.set() then
      !pickBends = true
      break
    endif
  enddo

--  !this.detailPopup.setFieldProperty('PICK_BENDS', 'ACTIVE', !pickBends)

  !count = !this.gridDetails.getNumberRows()
  !this.detailPopup.setFieldProperty('SELECT_ALL_DETAILS',  'ACTIVE', !count.gt(0))
  !this.detailPopup.setFieldProperty('UNSELECT_DETAILS',    'ACTIVE', !count.gt(0))

  !this.netDetails.showPopup(!data[0], !data[1])
endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickZoomToBend
--
-- Description: zoom to the selected bend element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickZoomToBend()

  UNENHANCE ALL

  !rowTags = !this.gridDetails.getSelectedRowTags()
  if !rowTags.empty() then
    return
  endif

  !elements = object ARRAY()

  do !rowTag values !rowTags
    !row = !this.gridDetails.getRow(!rowTag)
    !bendRef = !row[1].dbref()
    handle ANY
      !bendRef = object DBREF()
    endhandle

    if !bendRef.badref() then
      !!alert.error('Cannot get the selected element ' + !row[2] + '!')
      return
    else
      !elements.append(!bendRef)
    endif
  enddo

  if !elements.empty() then
    return
  endif

  do !element values !elements
    ENHANCE $!element COLOUR $!!gphColOpt.highlight
  enddo

  !this.zoom(object VOLUME(!elements))

endmethod

--------------------------------------------------------------------------------
