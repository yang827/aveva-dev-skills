-- Author:          DoHyoung Kim (Bright)
-- Created:         Tuesday 6th December 2012
--
--
-- Description:     form to modify attributes of piping component
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   apply modified attributes to the target element
--  getLooseAllowableConnection()    REAL                get loose connection position
--  initialize()                     -                   initialize form
--  isDirty(BOOLEAN)                 BOOLEAN             check if the form is modified or not
--  moveNext()                       -                   move to next component
--  movePrevious()                   -                   move to previous component
--  onClickClose()                   -                   close this form
--  onClickLoose()                   -                   callback for clicking the loose toggle box
--  onClickOffline()                 -                   callback for clicking the offline toggle box
--  pfComponentAttributes()          -                   constructor
--  quit()                           -                   clear screen
--  selectTarget(DBREF)              -                   set the given component to current element
--  setGadgetForLoose()              -
--  showComponentInfo()              -                   mark the current element
--  trackCE()                        -                   database tracking method for changing CE
--  updateAttributes()               -                   save the modified attributes to database
--
------------------------------------------------------------------------
setup form !!pfComponentAttributes dialog

  !this.formTitle = 'Component Attributes'
  !this.initCall  = '!this.initialize()'
  !this.quitCall  = '!this.quit()'

  path down
  frame .formComponent 'Piping Component' width 31
    button    .btnPrevious at xmin + 1 ymax pixmap callback '!this.movePrevious()' height 16 width 16
    paragraph .parTarget at xmax + 1 ymin width 20
    button    .btnNext at xmax + 1 ymin pixmap callback '!this.moveNext()' height 16 width 16
  exit

  toggle .togLoose   'Loose Component'  tagwidth 30  at x 1 callback '!this.onClickLoose()'
  toggle .togDefaultExcess 'Apply Default Loose Excess' callback '!this.btnApply.active = !this.isDirty(TRUE)'
  toggle .togOffline 'Offline Component' at x 1 callback '!this.onClickOffline()'
  toggle .togShop    'Shop Fabrication Material' at x 1 callback '!this.btnApply.active = !this.isDirty(FALSE)'


  button .btnApply   at xmin form ymax + 0.5 ' Apply ' wid 9 callback '!this.apply()' apply
  path right
  button .btnReset   at ymin ' Reset ' wid 9 callback '!this.selectTarget(!this.target)'
  button .btnDismiss at xmax form-size ymin  'Dismiss' wid 9 callback '!this.onClickClose()'

  track |DESICE| callback '!this.trackCE()'

  member .undo                is UNDOABLE

  member .target              is DBREF

  member .looseConnection     is REAL

  member .loose               is BOOLEAN

  member .offline             is BOOLEAN

  member .shop                is BOOLEAN

  member .defaultExcess       is BOOLEAN

  member .shownCompAttrForm   is BOOLEAN

  member .aidNoForElement     is REAL

exit

--------------------------------------------------------------------------------
--
-- Method:      pfComponentAttributes
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------

define method .pfComponentAttributes()
  !this.btnPrevious.addPixmap(!!pml.getPathName('leftarrow16.png'))
  !this.btnNext.addPixmap(!!pml.getPathName('rightarrow16.png'))
  !this.aidNoForElement       = !!aidNumbers.add('PF - Component Attribute')
  !this.shownCompAttrForm = false
endmethod

--------------------------------------------------------------------------------
--
-- Method:      initialize
--
-- Description: initialize form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------

define method .initialize()
  !this.shownCompAttrForm = true

  !context = object PFCONTEXT()
  !context.globalInstance()

  !this.btnApply.active = false
  !this.btnReset.active = false

  !this.togDefaultExcess.tag = 'Apply Default Loose Excess (' + !!pfDefaults.txtDefaultLooseExcess.val.string(!!distanceFmt) + ')'

  !this.selectTarget(!!ce)
  !this.setGadgetForLoose()
endmethod

--------------------------------------------------------------------------------
--
-- Method:      selectTarget
--
-- Description: set the given element to CE
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       piping component
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .selectTarget(!target is DBREF)

  UNENHANCE ALL

  if !this.target.badref().not() then
    --UNMARK $!<this.target>
    UNMARK ALL
    handle ANY
      -- dummy
    endhandle
  endif

  !pipeComponent = !target.owner.badref().not() and !target.owner.type.eq('BRAN') and !target.owner.owner.type.eq('PIPE')
  if !pipeComponent and !target.type.eq('TUBI') then
    !prevRef = PREV OF $!target
    handle (2, 113)
      -- no previous piping component
      !nextRef = NEXT OF $!target
      handle (2, 113)
        -- no next piping component
        !pipeComponent = false
      elsehandle NONE
        !target = !nextRef
      endhandle
    elsehandle NONE
      !target = !prevRef
    endhandle
  endif

  !this.formComponent.active     = !pipeComponent
  !this.togLoose.active         = !pipeComponent
  !this.togDefaultExcess.active = !pipeComponent
  !this.togOffline.active       = !pipeComponent
  !this.togShop.active          = !pipeComponent
  !this.btnApply.active         = false
  !this.btnReset.active         = !pipeComponent

  if !pipeComponent.not() then
    -- not piping component
    !this.target = object DBREF()
    !this.parTarget.val = 'Navigate to Piping Component'
    !this.togLoose.val = false
    !this.togDefaultExcess.val = false
    !this.togOffline.val = false
    !this.togShop.val = false
    return
  endif

  !this.target = !target
  !this.parTarget.val = !this.target.namesq.upCase()

  MARK $!<this.target>
  !this.showComponentInfo()
  ENHANCE $!<this.target> COL $!!<gphColOpt.highlight.code>

  -- check if previous component exists
  !prevRef = PREV OF $!target
  handle (2, 113)
    !this.btnPrevious.active = false
  elsehandle NONE
    !this.btnPrevious.active = true
  endhandle

  -- check if next component exists
  !nextRef = NEXT OF $!target
  handle (2, 113)
    !this.btnNext.active = false
  elsehandle NONE
    !this.btnNext.active = true
  endhandle

  -- loose attribute
  !loose = !target.loose
  handle ANY
    !loose = false
    !this.togLoose.active = false
  elsehandle NONE
    !this.togLoose.active = true
  endhandle
  !this.togLoose.val = !loose

  -- shop attribute
  !shop = !target.shop
  handle ANY
    !shop = false
    !this.togShop.active = false
  elsehandle NONE
    !this.togShop.active = true
  endhandle
  !this.togShop.val = !shop

  -- offline attribute
  !offline = !this.target.loffline
  handle ANY
    !this.togOffline.active = false
    !offline = false
  elsehandle NONE
    !this.togOffline.active = true
  endhandle
  !this.togOffline.val = !offline

  -- loose excess
  !arriveExcess = !this.target.aexcess
  handle ANY
    !arriveExcess = object REAL()
  endhandle

  !leaveExcess= !this.target.lexcess
  handle ANY
    !leaveExcess = object REAL()
  endhandle

  !this.looseConnection = !this.getLooseAllowableConnection()

  if !arriveExcess.set() and !leaveExcess.set() and !loose and !offline.not() and !this.looseConnection.set() then
    !this.togDefaultExcess.active = true
    if !this.looseConnection.eq(!this.target.arrive) then
      !this.togDefaultExcess.val = !arriveExcess.eq(!!pfDefaults.txtDefaultLooseExcess.val)
    elseif !this.looseConnection.eq(!this.target.leave) then
      !this.togDefaultExcess.val = !leaveExcess.eq(!!pfDefaults.txtDefaultLooseExcess.val)
    else
      !this.togDefaultExcess.val = false
    endif
  else
    !this.togDefaultExcess.active = false
    !this.togDefaultExcess.val = false
  endif

  -- save attributes
  !this.loose         = !loose
  !this.offline       = !offline
  !this.shop          = !shop
  !this.defaultExcess = !this.togDefaultExcess.val

endmethod

--------------------------------------------------------------------------------
--
-- Method:      showComponentInfo
--
-- Description:  mark the current element
--
-- Method Type: Procedure
-- Arguments:
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .showComponentInfo()

    !markLooseFlag =  !!pfModifySpool.btnShowLooseComponents.val
    unmark all
    aid clear all $!!<pfModifySpool.aidNoForLoose>
    aid clear all $!<this.aidNoForElement>
    if (!markLooseFlag) then
      !pipeComponents= !!collectAllFor('BRAN MEM', ||, pipe of $!<this.target>)
        do !entry values !pipeComponents
          !isLoose = !entry.loose
           handle any
           !isLoose = false
           endhandle
          if (!isLoose.not()) then
           if (!entry eq !this.target) then
            mark $!entry
            endif
            skip
           endif

        if (!entry eq !this.target) then
          !aidInformation = '[Loose] ' & !this.target.flnm.before(' of ')
        else
          !aidInformation = 'Loose'
        endif
        !entryPos= !entry.pos
        if (!aidInformation eq 'Loose') then
          !a12 = !entry.pos.wrt(world)
          !dir= !entry.ori.zdir().string().split(|WRT|)[1].trim()
          aid arrow numb 1 at $!a12 DIR $!dir HEIGHT 200 PROP 0.1
          !np = !a12.offset(!dir.direction(),200)
          aid text num $!<this.aidNoForElement> |$!aidInformation| at $!np
        else
          AID CLEAR ARROW ALL
          aid text num $!<this.aidNoForElement> |$!aidInformation| at $!entryPos
        endif
       enddo
    else
      aid clear all $!<this.aidNoForElement>
      MARK $!<this.target>
    endif
endmethod
--------------------------------------------------------------------------------
--
-- Method:      trackCE
--
-- Description: database tracking method for changing CE
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .trackCE()

  if !!ce.eq(!this.target) then
    return
  endif

  -- confirm changes
  !dirty = !this.isDirty(TRUE)
  if !dirty then
    !answer = !!alert.confirm('OK to discard changes?')
    if !answer.eq('NO') then
      !!ce = !this.target
      return
    endif
  endif

  !this.selectTarget(!!ce)
  !this.setGadgetForLoose()
endmethod

define method .setGadgetForLoose()
  if (!!ce.hardType eq 'FLAN' and !!ce.compType eq 'ALLO' and !!ce.aExcess eq 0 and !!ce.lExcess eq 0) then
    !isLooseFlange = true
    !this.togLoose.tag = 'Loose Component - (Comptype = ALLO)'
  else
    !this.togLoose.tag = 'Loose Component'
    !isLooseFlange = false
  endif

  !this.togLoose.active         = !isLooseFlange.not()
  !this.togOffline.active       = !isLooseFlange.not()
  !this.togShop.active          = !isLooseFlange.not()

  if(!isLooseFlange.not()) then
    if(!this.looseConnection.set()) then
      !this.togDefaultExcess.active = !isLooseFlange.not()
    else
      !this.togDefaultExcess.active = false
    endif
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      movePrevious
--
-- Description: move to the previous component
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .movePrevious()

  PREV
  handle (2, 113)
    !!alert.message('First component!')
    return
  endhandle

  --!this.selectTarget(!!ce)

endmethod

--------------------------------------------------------------------------------
--
-- Method:      moveNext
--
-- Description: move to the next component
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .moveNext()

  NEXT
  handle (2, 113)
    -- we are at tail of branch
    !!alert.message('Last component!')
    return
  endhandle

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickLoose
--
-- Description: update status of the toggle box for default loose excess
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickLoose()

  !loose = !this.togLoose.val
  !offline = !this.togOffline.val

  if !loose and !offline.not() and !this.looseConnection.set() then
    !this.togDefaultExcess.active = true
    !this.togDefaultExcess.val = true
  else
    !this.togDefaultExcess.active = false
    !this.togDefaultExcess.val = false
  endif

  !dirty = !this.isDirty(TRUE)
  !this.btnApply.active = !dirty

endmethod


--------------------------------------------------------------------------------
--
-- Method:      onClickOffline
--
-- Description: update status of the toggle box for default loose excess
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickOffline()

  !loose = !this.togLoose.val
  !offline = !this.togOffline.val

  if !loose and !offline.not() and !this.looseConnection.set() then
    !this.togDefaultExcess.active = true
  else
    !this.togDefaultExcess.active = false
    !this.togDefaultExcess.val = false
  endif

  !dirty = !this.isDirty(TRUE)
  !this.btnApply.active = !dirty

endmethod

--------------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: apply the modified attributes to the target element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .apply()

  if !this.target.badref() then
    !!alert.error('Bad reference!')
    return
  endif

  !this.undo.description('Modify Component Attributes')
  !this.undo.add()

  !this.updateAttributes()
  handle ANY
    !!alert.error(!!error.text)
  endhandle
  !this.showComponentInfo()

  !this.undo.endUndoable()

  if(defined(!!pfModifySpool)) then
    !!pfModifySpool.refreshEndExcesses()
  endif

  --!this.selectTarget(!this.target)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      updateAttributes
--
-- Description: update component attributes with user given values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .updateAttributes()

  -- shop flag
  if !this.togShop.active then
    !this.target.shop = !this.togShop.val
    handle (41, 232)
      -- Element does not have attribute SHOP
      -- ignore error
    endhandle
  endif

  !defaultExcess = !!pfDefaults.txtDefaultLooseExcess.val
  -- loose flag
  !loose = !this.togLoose.val
  if !this.togLoose.active then
    !this.target.loose = !loose
    !looseError = false
    handle (41, 232)
      -- Element does not have attribute LOOSE
      -- ignore error
      !looseError = true
    endhandle
    if(!looseError.not()) then
      if (!this.looseConnection.eq(!this.target.arrive)) then
        if((!this.target.order eq 1) AND (!this.target.order lt !this.target.owner.members.size())) then
          !order = !this.target.order + 1
           elseif(!this.target.order eq !this.target.owner.members.size()) then
          !order = !this.target.order
        else
          !order = !this.target.order - 1
        endif
        !leaveComponent = !this.target.owner.members[!order]
        if(!leaveComponent.type eq 'WELD') then
          !this.target.aexcess = !leaveComponent.aexcess
          !leaveComponent.aexcess = 0mm
        endif
      elseif !this.looseConnection.eq(!this.target.leave) then
        if((!this.target.order eq !this.target.owner.members.size()) AND (!this.target.order gt 1)) then
          !order = !this.target.order - 1
           elseif(!this.target.order eq !this.target.owner.members.size()) then
          !order = !this.target.order
        else
          !order = !this.target.order + 1
        endif
        !arriveComponent = !this.target.owner.members[!order]
        if(!arriveComponent.type eq 'WELD') then
          !this.target.lexcess = !arriveComponent.lexcess
          !arriveComponent.lexcess = 0mm
        endif
      endif
    endif
  endif

  !useDefaultExcess = !this.togDefaultExcess.val
  if !loose.not() then
    !this.target.aexcess = 0mm
    !this.target.lexcess = 0mm
  elseif !loose and !useDefaultExcess then
    if !this.looseConnection.eq(!this.target.arrive) then
      if((!this.target.order eq 1) AND (!this.target.order lt !this.target.owner.members.size())) then
        !order = !this.target.order + 1
         elseif(!this.target.order eq !this.target.owner.members.size()) then
          !order = !this.target.order
      else
        !order = !this.target.order - 1
      endif
      !leaveComponent = !this.target.owner.members[!order]
      if(!leaveComponent.type eq 'WELD') then
        !leaveComponent.aexcess = 0mm
      endif
      !this.target.aexcess = !defaultExcess
    elseif !this.looseConnection.eq(!this.target.leave) then
      if((!this.target.order eq !this.target.owner.members.size()) AND (!this.target.order gt 1)) then
        !order = !this.target.order - 1
         elseif(!this.target.order eq !this.target.owner.members.size()) then
          !order = !this.target.order
      else
        !order = !this.target.order + 1
      endif
      !arriveComponent = !this.target.owner.members[!order]
      if(!arriveComponent.type eq 'WELD') then
        !arriveComponent.lexcess = 0mm
        !excessFromWeld = true
      endif
      !this.target.lexcess = !defaultExcess
    endif
  elseif !loose and !useDefaultExcess.not() then
    if !this.looseConnection.eq(!this.target.arrive) then
      if(!this.target.aexcess.eq(!defaultExcess)) then
        !this.target.aexcess = 0mm
      endif
    elseif !this.looseConnection.eq(!this.target.leave) then
      if(!this.target.lexcess.eq(!defaultExcess)) then
        !this.target.lexcess = 0mm
      endif
    endif
  endif

  -- loffline flag
  !this.target.loffline = !this.togOffline.val
  handle (41, 232)
    -- Element does not have attribute LOFFLINE
    -- ignore error
  endhandle

  -- save attributes
  !this.loose         = !this.togLoose.val
  !this.offline       = !this.togOffline.val
  !this.shop          = !this.togShop.val
  !this.defaultExcess = !this.togDefaultExcess.val

endmethod

--------------------------------------------------------------------------------
--
-- Method:      getLooseExcessAllowableEnd
--
-- Description: check if the target element is spool boundary or not
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .getLooseAllowableConnection() is REAL

  !branRef = !this.target.owner

  !isArriveSpoolLimit = false
  !isLeaveSpoolLimit = false

  -- 1. check if there a spool break at the arrive position

  !prevComp = IARRIVE TUBE OF $!<this.target>
  handle ANY
    -- no previous tube
    !index = !branRef.members.findFirst(!this.target)
    if !index.set() and !index.gt(1) then
      !prevComp = !branRef.members[!index - 1]
    else
      -- no previous component
      !prevComp = object DBREF()
    endif
  endhandle

  if !prevComp.unset() then
    -- we are at the head of branch

    !href = !branRef.href

    if !href.badref().not() and !href.type.eq('BRAN') and !href.owner.eq(!branRef.owner) then
      -- same pipe, different branch
      -- BRANCH TO BRANCH connection

      !hpos = !branRef.hpos
      !distToHead = !hpos.distance(!href.hpos)
      !distToTail = !hpos.distance(!href.tpos)

      if !distToHead.lt(!distToTail) then
        -- connected to the head of another branch
        !tubeRef = ILEAVE TUBE OF $!href
        handle ANY
          -- no tube
          if !href.mcount().gt(0) then
            !compRef = !href.members[1]
            !isArriveSpoolLimit = !compRef.shop.not()
          else
            -- no members in the connected branch
            -- just assume that not spool limit
          endif
        elsehandle NONE
          -- not spool limit
        endhandle
      else
        -- connected to the tail of another branch
        !tubeRef = IARRIVE TUBE OF $!href
        handle ANY
          -- no tube
          if !href.mcount().gt(0) then
            !compRef = !href.members[!href.mcount()]
            !isArriveSpoolLimit = !compRef.shop.not()
          else
            -- no members in the connected branch
            -- just assume that not spool limit
          endif
        elsehandle NONE
          -- not spool limit
        endhandle
      endif
    elseif !href.badref().not() and !href.owner.owner.eq(!branRef.owner) then
      -- connected to component (TEE, OLET, CROSS...)
      !isArriveSpoolLimit = !href.shop.not()
    else
      !isArriveSpoolLimit = true
    endif
  else
    if !prevComp.type.eq('TUBI') then
      -- not spool limit
    else
      !isArriveSpoolLimit = !prevComp.shop.not()
    endif
  endif

  -- 2. check if there a spool break at the leave position

  !nextComp = ILEAVE TUBE OF $!<this.target>
  handle ANY
    -- no next tube
    !index = !branRef.members.findFirst(!this.target)
    if !index.set() and !index.lt(!branRef.mcount()) then
      !nextComp = !branRef.members[!index + 1]
    else
      -- no next component
      !nextComp = object DBREF()
    endif
  endhandle

  if !nextComp.unset() then
    -- we are at the head of branch

    !tref = !branRef.tref
    if !tref.badref().not() and !tref.type.eq('BRAN') and !tref.owner.eq(!branRef.owner) then
      -- same pipe, different branch
      -- BRANCH TO BRANCH connection

      !tpos = !branRef.tpos
      !distToHead = !tpos.distance(!tref.hpos)
      !distToTail = !tpos.distance(!tref.tpos)

      if !distToHead.lt(!distToTail) then
        -- connected to the head of another branch
        !tubeRef = ILEAVE TUBE OF $!tref
        handle ANY
          -- no tube
          if !tref.mcount().gt(0) then
            !compRef = !tref.members[1]
            !isLeaveSpoolLimit = !compRef.shop.not()
          else
            -- no members in the connected branch
            -- just assume that not spool limit
          endif
        elsehandle NONE
          -- not spool limit
        endhandle
      else
        -- connected to the tail of another branch
        !tubeRef = IARRIVE TUBE OF $!tref
        handle ANY
          -- no tube
          if !tref.mcount().gt(0) then
            !compRef = !tref.members[!tref.mcount()]
            !isLeaveSpoolLimit = !compRef.shop.not()
          else
            -- no members in the connected branch
            -- just assume that not spool limit
          endif
        elsehandle NONE
          -- not spool limit
        endhandle
      endif
    elseif !tref.badref().not() and !tref.owner.owner.eq(!branRef.owner) then
      -- connected to component (TEE, OLET, CROSS...)
      !isLeaveSpoolLimit = !tref.shop.not()
    else
      !isLeaveSpoolLimit = true
    endif
  else
    if !nextComp.type.eq('TUBI') then
      -- not spool limit
    else
      !isLeaveSpoolLimit = !nextComp.shop.not()
    endif
  endif

  -- 3. check branch connections

  -- 3.1 check for TEE or OLET or CROSS
  !crfarray = !this.target.crfarray
  handle ANY
    -- not a CROSS
    !crfarray = object ARRAY()
    !cref = !this.target.cref
    handle ANY
      -- not a TEE or OLET
    elsehandle NONE
      !crfarray[1] = object DBREF()
      !crfarray[2] = object DBREF()
      !crfarray[3] = object DBREF()

      !arrive = !this.target.arrive
      !leave = !this.target.leave
      if !arrive.eq(1) and !leave.eq(2) then
        !crfarray[3] = !cref
      elseif !arrive.eq(1) and !leave.eq(3) then
        !crfarray[2] = !cref
      elseif !arrive.eq(2) and !leave.eq(1) then
        !crfarray[3] = !cref
      elseif !arrive.eq(2) and !leave.eq(3) then
        !crfarray[1] = !cref
      elseif !arrive.eq(3) and !leave.eq(2) then
        !crfarray[1] = !cref
      else
        !crfarray[2] = !cref
      endif
    endhandle
  endhandle

  !conSpoolLimits = object ARRAY()

  do !i indices !crfarray

    !conSpoolLimits[!i] = true

    !cref = !crfarray[!i]

    if !cref.badref().not() and !cref.type.eq('BRAN') and !cref.owner.eq(!branRef.owner) then

      !pos = !this.target.ppos[!i]
      !distToHead = !pos.distance(!cref.hpos)
      !distToTail = !pos.distance(!cref.tpos)

      !isHead = !distToHead.lt(!distToTail)

      if !isHead then
        -- connected to the head of another branch
        !tubeRef = ILEAVE TUBE OF $!cref
        handle ANY
          -- no tube
          if !cref.mcount().gt(0) then
            !compRef = !cref.members[1]
            !conSpoolLimits[!i] = !compRef.shop.not()
          else
            -- no members in the connected branch
            -- just assume that it is spool limit
          endif
        elsehandle NONE
          !conSpoolLimits[!i] = false
        endhandle
      else
        -- connected to the tail of another branch
        !tubeRef = IARRIVE TUBE OF $!cref
        handle ANY
          -- no tube
          if !cref.mcount().gt(0) then
            !compRef = !cref.members[!cref.mcount()]
            !conSpoolLimits[!i] = !compRef.shop.not()
          else
            -- no members in the connected branch
            -- just assume that it is spool limit
          endif
        elsehandle NONE
          !conSpoolLimits[!i] = false
        endhandle
      endif
    endif
  enddo

  if !isArriveSpoolLimit and !isLeaveSpoolLimit.not() then
    do !spoolLimit values !conSpoolLimits
      if !spoolLimit.not() then
        return object REAL()
      endif
    enddo
    return !this.target.leave
  elseif !isLeaveSpoolLimit and !isArriveSpoolLimit.not() then
    do !spoolLimit values !conSpoolLimits
      if !spoolLimit.not() then
        return object REAL()
      endif
    enddo
    return !this.target.arrive
  endif

  return object REAL()
endmethod

--------------------------------------------------------------------------------
--
-- Method:      quit
--
-- Description: clear screen
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .quit()

   AID CLEAR ARROW ALL
  !this.shownCompAttrForm = false
  -- confirm changes
  !dirty = !this.isDirty(FALSE)
  if !dirty then
    !answer = !!alert.confirm('OK to discard changes?')
    if !answer.eq('NO') then
      return error 1 noalert
    endif
  endif

  if !this.target.badref().not() then
    UNMARK $!<this.target>
    handle ANY
      -- dummy
    endhandle
  endif

  if defined(!!pfModifySpool) then
    !!pfModifySpool.refreshLooseComponents()
  endif

  aid clear all $!<this.aidNoForElement>
  AID CLEAR ARROW ALL
endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickClose
--
-- Description: close this form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickClose()
  !this.quit()
  !this.hide()
endmethod

--------------------------------------------------------------------------------
--
-- Method:      isDirty
--
-- Description: check if the form is modified or not
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     return true if the form is modified
--------------------------------------------------------------------------------
define method .isDirty(!showMessages is BOOLEAN) is BOOLEAN

  !dirty = false

  if !this.target.badref().not() then

    !loose          = !this.togLoose.val
    !offline        = !this.togOffline.val
    !shop           = !this.togShop.val
    !defaultExcess  = !this.togDefaultExcess.val

    if(!defaultExcess AND !showMessages) then

      if !this.looseConnection.eq(!this.target.arrive) then
        if((!this.target.order eq 1) AND (!this.target.order lt !this.target.owner.members.size())) then
          !order = !this.target.order + 1
         elseif(!this.target.order eq !this.target.owner.members.size()) then
          !order = !this.target.order
        else
          !order = !this.target.order - 1
        endif
        !leaveComponent = !this.target.owner.members[!order]
        if(!leaveComponent.type eq 'WELD') then
          !excess = !leaveComponent.aexcess
          !excessFromWeld = true
        else
          !excess = !this.target.aexcess
          !excessFromWeld = false
        endif
      elseif !this.looseConnection.eq(!this.target.leave) then
        if((!this.target.order eq !this.target.owner.members.size()) AND (!this.target.order gt 1)) then
          !order = !this.target.order - 1
           elseif(!this.target.order eq !this.target.owner.members.size()) then
          !order = !this.target.order
        else
          !order = !this.target.order + 1
        endif
        !arriveComponent = !this.target.owner.members[!order]
        if(!arriveComponent.type eq 'WELD') then
          !excess = !arriveComponent.lexcess
          !excessFromWeld = true
        else
          !excess = !this.target.lexcess
          !excessFromWeld = false
        endif
      endif

      if(!excess neq !!pfDefaults.txtDefaultLooseExcess.val AND !excess neq 0) then
        !answer = !!alert.confirm('Would you like to override the current excess of $!excess with the default of $!!pfDefaults.txtDefaultLooseExcess.val')
        if(!answer eq 'NO') then
          !this.togDefaultExcess.val = false
        endif
      endif
    endif

    if(!loose.not() and !showMessages) then
      if((!this.target.aexcess.neq(50mm) AND !this.target.aexcess.neq(0mm)) OR (!this.target.lexcess.neq(50mm) AND !this.target.lexcess.neq(0mm))) then
        !!alert.warning('All excess set on the component will be lost')
      endif
    endif

    if !this.loose.neq(!loose) or !this.offline.neq(!offline) or !this.shop.neq(!shop) or !this.defaultExcess.neq(!defaultExcess) then
      !dirty = true
    endif
  endif

  return !dirty

endmethod
