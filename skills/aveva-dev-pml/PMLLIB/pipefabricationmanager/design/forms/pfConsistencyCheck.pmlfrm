--------------------------------------------------------------------------------
--
-- Method:      onClickZoomToBranch
--
-- Description: zoom to the selected pipe branch
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickZoomToBranch()
  !branRefs = object ARRAY()

  !rowTags = !this.gridBranches.getSelectedRowTags()
  do !rowTag values !rowTags
    !branRefNo = !this.gridBranches.getCell(!rowTag, 'REF_NO')
    !branRef = !branRefNo.dbref()
    handle ANY
    elsehandle NONE
      if !branRef.set() then
        !branRefs.append(!branRef)
      endif
    endhandle
  enddo

  if !branRefs.empty().not() then
    !this.zoom(object VOLUME(!branRefs))
  endif
endmethod


