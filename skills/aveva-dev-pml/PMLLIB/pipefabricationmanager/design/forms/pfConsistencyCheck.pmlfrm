--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickNavigateToBranch()
  !rowTags = !this.gridBranches.getSelectedRowTags()
  if !rowTags.empty().not() then
    !branRefNo = !this.gridBranches.getCell(!rowTags.last(), 'REF_NO')
    !branRef = !branRefNo.dbref()
    handle ANY
    elsehandle NONE
      if !branRef.set() then
        !!ce = !branRef
      endif
    endhandle
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      zoom
--
-- Description: zoom to the given volume
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .zoom(!volume is VOLUME)
  !from = !volume.from
  !to   = !volume.to

  -- Through Point
  !throughPoint   = !from.midPoint(!to)
  handle ANY
    return
  endhandle

  -- Set through point
  !through[1] = !!comValueConvert(!throughPoint.east, 'MM')
  !through[2] = !!comValueConvert(!throughPoint.north, 'MM')
  !through[3] = !!comValueConvert(!throughPoint.up, 'MM')
  !!fmSys.currentDocument().view.through = !through

  -- Set view radius
  !radius = !!comValueConvert(!from.distance(!to), 'MM') * 0.5
  --!radius = !radius.max(500mm)
  !!fmSys.currentDocument().view.radius  = !radius
endmethod

-- Fix Issue 96905, Pipe Fabrication: Fabr.Consistency Check - navigating to element when selecting it
--------------------------------------------------------------------------------
--
-- Method:      navigate
--
-- Description: navigate to the selected element in the CHECK CE result list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .navigate()

  !index = !this.lstCheckCE.val
  if !index.eq(0) then
    return
  endif

  !element = object DBREF()

  do !i from !index to 1 by -1
    !text = !this.lstCheckCE.dtext[!i]
    !element = !text.dbref()
    handle ANY
      !element = object DBREF()
    endhandle

    if !element.badref().not() then
      !!ce = !element
      break
    endif
  enddo
endmethod
--//

-- Fix Issue 96547
--------------------------------------------------------------------------------
--
-- Method:      highlightSelectedBranches
--
-- Description: highlight selected branches
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .highlightSelectedBranches()

  UNENHANCE ALL
  handle ANY
  endhandle

  if !this.togHighlight.val.not() then
    return
  endif

  !rowTags = !this.gridBranches.getSelectedRowTags()
  if !rowTags.empty() then
    return
  endif

  do !rowTag values !rowTags
    !branRefNo = !this.gridBranches.getCell(!rowTag, 'REF_NO')
    !branRef = !branRefNo.dbref()
    handle ANY
      !branRef = object DBREF()
    endhandle

    if !branRef.badref().not() then
      ENHANCE $!branRef COLOUR $!!gphColOpt.highlight
      handle ANY
      endhandle
    endif
  enddo

endmethod
--//


--Fix Issue 97612
--------------------------------------------------------------------------------
--
-- Method:      onClickSetToPassed
--
-- Description: set the selected branches to passed or not passed
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      BOOLEAN       true : passed, false : not passed
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickSetToPassed(!passed is BOOLEAN)

  !rowTags = !this.gridBranches.getSelectedRowTags()
  if !rowTags.empty() then
    !!alert.message('Select branches!')
    return
  endif

  !refNos = !this.gridBranches.getColumn('REF_NO')

  do !rowTag values !rowTags
    !row = !this.gridBranches.getRow(!rowTag)
    !branRef = !row[1].dbref()
    handle ANY
      !!alert.error('Cannot get BRAN ' + !row[3])
      skip
    endhandle

    !rowIndex = !refNos.findFirst(!row[1])
    if !rowIndex.set() then
      if !passed then

        !branchIndex = !this.branRefs.findFirst(!branRef)
        skip if !branchIndex.unset()

        if defined(!this.checkResults[!branchIndex]) then

          -- let's check the error level
          !resultGroup = !this.checkResults[!branchIndex]

          !validOrWarning = true
          do !i indices !resultGroup
            !errorLevel = !resultGroup[!i].getResultLevel()
            if !errorLevel.gt(2) then
              -- error
              !validOrWarning = false
              break
            endif
          enddo

          -- set to passed
          if !validOrWarning then
            !branRef.:PFConsChk = true
            handle ANY
              !!alert.error(!!error.text)
            endhandle
          endif

        endif
      else
        if !branRef.:PFConsChk then
          !branRef.:PFConsChk = false
          handle ANY
            !!alert.error(!!error.text)
          endhandle
        endif
      endif

      -- refresh grid row
      if !branRef.:PFConsChk then
        !image = !!pml.getPathname('valid12.png')
        !statusString = 'Passed'
      else
        !image = !!pml.getPathname('requires12.png')
        !statusString = 'Not passed'
      endif
      !this.gridBranches.setCellValue(!rowIndex, 4, !statusString)
      !this.gridBranches.setCellImage(!rowIndex, 3, !image)

    endif
  enddo

endmethod
--//

-- Fix Issue 97671
--------------------------------------------------------------------------------
--
-- Method:      onClickRemoveSelected
--
-- Description: remove selected branches from grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickRemoveSelected()

  !rowTags = !this.gridBranches.getSelectedRowTags()
  if !rowTags.empty() then
    !!alert.message('Select branches!')
    return
  endif

  -- remove BRAN element
  do !rowTag values !rowTags
    !branRef = !this.gridBranches.getCell(!rowTag, 'REF_NO').dbref()
    handle ANY
      -- invalid branch reference, just ignore it
      skip
    endhandle

    -- remove the branch from local storage and check result
    !index = !this.branRefs.findFirst(!branRef)
    if !index.set() then
      !this.branRefs.removeFrom(!index, 1)
      !this.checkResults.removeFrom(!index, 1)
    endif
  enddo

  -- delete selected rows
  !this.gridBranches.deleteSelectedRows()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickRemoveAll
--
-- Description: remove all branches from grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickRemoveAll()

  !this.gridBranches.clearGridData()
  !this.branRefs.clear()
  !this.checkResults.clear()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      applyOptions
--
-- Description: apply options
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .applyOptions()
  !this.saveEnvironmentFile()
  !this.setupCheckGroups()
endmethod

--------------------------------------------------------------------------------
--
-- Method:      loadEnvironmentFile
--
-- Description: load environment file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .loadEnvironmentFile()
  !readData = !this.environmentFile.readFile()
  handle any
    return
  endhandle

  !this.togCheckFull.val          = !readData[1].boolean()
  handle (61,618)
  endhandle
  !this.togCheckBranch.val        = !readData[2].boolean()
  handle (61,618)
  endhandle
  !this.togCheckSpecification.val = !readData[3].boolean()
  handle (61,618)
  endhandle
  !this.togCheckModel.val         = !readData[4].boolean()
  handle (61,618)
  endhandle
  !this.togCheckAttribute.val     = !readData[5].boolean()
  handle (61,618)
  endhandle
  !this.togCheckValve.val         = !readData[6].boolean()
  handle (61,618)
  endhandle

  !this.setupCheckGroups()
endmethod

--------------------------------------------------------------------------------
--
-- Method:      saveEnvironmentFile
--
-- Description: save environment file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .saveEnvironmentFile()
  !table = object ARRAY()
  !table.append(!this.togCheckFull.val.string())
  !table.append(!this.togCheckBranch.val.string())
  !table.append(!this.togCheckSpecification.val.string())
  !table.append(!this.togCheckModel.val.string())
  !table.append(!this.togCheckAttribute.val.string())
  !table.append(!this.togCheckValve.val.string())

  !this.environmentFile.writeFile('OVER', !table)
  handle any
  endhandle

  !this.environmentFile.close()
endmethod
