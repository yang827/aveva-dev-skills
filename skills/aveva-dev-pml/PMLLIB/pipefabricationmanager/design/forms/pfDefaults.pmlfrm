-- File:            pfDefaults.pmlfrm
--   Type:          Form Definition
--   Group:         Pipe Fabrication
--     Keyword:     PF
--   Module:        Design
--   Replaces:
--
-- Author:          DoHyoung Kim (Bright)
-- Created:         Tuesday 6th December 2011
--
-- Description:     Form for modifying default values
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   save modified values to storage
--  checkJointLetterLength(GADGET,STRING) -
--  initialize()                     -                   initialize form
--  updateJointNumber()              -                   update joint number
--
--------------------------------------------------------------------------------

-- Define form
setup form !!pfDefaults dialog varchars

  using namespace 'Aveva.Pdms.Presentation'

  !this.formTitle  = 'Pipe Fabrication Defaults'
  !this.initCall   = '!this.initialize()'

  path down

  frame .frameDefaults '' width 45 height 10

    para   .parDefaultLooseExcess text 'Default excess for loose component'
    path right
    text   .txtDefaultLooseExcess '' at xmax.frameDefaults - 11 wid 10 is REAL format !!distanceFmt

    path down
    para   .parDefaultInsertExcess at xmin.parDefaultLooseExcess text 'Default excess for insert connection'
    path right
    text   .txtDefaultInsertExcess  '' at xmin.txtDefaultLooseExcess wid 10 is REAL format !!distanceFmt

    path down
    para   .parDefaultSurfaceExcess at xmin.parDefaultLooseExcess text 'Default excess for surface connection'
    path right
    text   .txtDefaultSurfaceExcess  '' at xmin.txtDefaultLooseExcess wid 10 is REAL format !!distanceFmt

    path down
    para   .parDefaultSaddleExcess at xmin.parDefaultLooseExcess text 'Default excess for saddle connection'
    path right
    text   .txtDefaultSaddleExcess  '' at xmin.txtDefaultLooseExcess wid 10 is REAL format !!distanceFmt

    path down
    para   .parDefaultBossExcess at xmin.parDefaultLooseExcess text 'Default excess for boss connection'
    path right
    text   .txtDefaultBossExcess  '' at xmin.txtDefaultLooseExcess wid 10 is REAL format !!distanceFmt

    path down
    para   .parDefaultMitreExcess at xmin.parDefaultLooseExcess text 'Default excess for mitre connection'
    path right
    text   .txtDefaultMitreExcess '' at xmin.txtDefaultLooseExcess wid 10 is REAL format !!distanceFmt

    path down
    para   .parDefaultWeldPrefix at xmin.parDefaultLooseExcess text 'Default Weld Prefix'
    path right
    text   .txtDefaultWeldPrefix '' at xmin.txtDefaultLooseExcess callback |!this.checkJointLetterLength(| wid 4 is STRING
    path down

    toggle .toupdtManCreateedWelds    'Update manually created welds when using the Weld Handling form' at xmin.parDefaultLooseExcess
    toggle .togNegativeFirstFeed      'Negative first feed' at xmin.parDefaultLooseExcess
    toggle .togXYZBendingTable        'XYZ Bending Table'
    toggle .togReverseBendingDataOrder        'Reverse order of Bending Data on Spool Drawing'
    toggle .togAllowFeedExcess        'Allow automated feed excess'
    toggle .togAllowBendEndExcess     'Allow automated end excess for bending machine'
    toggle .togAllowExtrEndExcess     'Allow automated end excess for extrusion machine'
    toggle .togDisableSpoolType       'Always set spool type to shop'
    --Fix Issue 96876, Rewording of 'Fabrication Consistency Check Not Passed' Required
    toggle .togAllowConsCheckDrawing  'Show "Modelling Consistency Check not passed" on Spool Drawing'
    --//
    toggle .togAutoNamingRules        'Use Auto Naming Rules'
    -- Fix Issue 110766 - New option to ignore errors relating to the OLD Bolting Method
    toggle .togDisablePartNumberMsg   'Disable Bolting error messages in Pipe Spool Validation'
    -- Fix Issue 110438 - Provide option to bypass SKEY model consistency check
    toggle .togDisableSkeyMsg         'Disable SKEY error messages in Modelling Consistency Check'
	toggle .togGalvanizationCheck     'Apply Surface treatment functionality to Galvanization tank'

    toggle .togUpdateJointNumber 'Update the Joint Prefix and Joint Number attribute of a gasket' callback |!this.updateJointNumber()|

    path down
    para   .parDefaultJointPrefix at x2 text 'Prefix for Joint'
    path right
    text   .txtDefaultJointPrefix '' at xmax1 callback |!this.checkJointLetterLength(| wid 4 is STRING
    path down
	

  exit

  button .btnOK     'OK'      at xmax.frameDefaults - 35 width 10 callback '!this.apply()' OK
  path right
  button .btnCancel 'Cancel'  at xmax.frameDefaults - 23 width 10 CANCEL
  button .btnApply  'Apply'   at xmax.frameDefaults - 11 width 10 callback '!this.apply()' APPLY

  member .undo      is UNDOABLE

exit

--------------------------------------------------------------------------------
--
-- Method:      initialize
--
-- Description: initialize form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .initialize()

  -- Fix Issue 98926 (SI#58186) 12.1.SP4#DVD RC5 - PF - Config Admin Errors
  !appldwRefs = !!collectAllFor('APPLDW', |FUNC EQ 'PipeFabrication'|, WORLD)
  if !appldwRefs.empty() then
    return error 1 |No APPLDW defined for Pipe Fabrication. Please create one with FUNC = 'PipeFabrication'|
  endif
  -- End of Fix Issue 98926

  if defined(!!pfContext) then
    !!pfContext.delete()
  endif

  !context = object PFCONTEXT()
  !context.globalInstance()

  !this.txtDefaultLooseExcess.val    = !!pfContext.defaultLooseExcess
  !this.txtDefaultInsertExcess.val   = !!pfContext.defaultInsertExcess
  !this.txtDefaultSurfaceExcess.val  = !!pfContext.defaultSurfaceExcess
  !this.txtDefaultSaddleExcess.val   = !!pfContext.defaultSaddleExcess
  !this.txtDefaultBossExcess.val     = !!pfContext.defaultBossExcess
  !this.txtDefaultMitreExcess.val    = !!pfContext.defaultMitreExcess
  !this.toupdtManCreateedWelds.val   = !!pfContext.updtManCreateedWelds
  !this.togNegativeFirstFeed.val     = !!pfContext.firstFeedNegative
  !this.togXYZBendingTable.val       = !!pfContext.xyzBendingTable
  !this.togReverseBendingDataOrder.val = !!pfContext.reverseBendingDataOrder
  !this.togAllowFeedExcess.val       = !!pfContext.allowFeedExcess
  !this.togAllowBendEndExcess.val    = !!pfContext.allowBendEndExcess
  !this.togAllowExtrEndExcess.val    = !!pfContext.allowExtrEndExcess
  !this.togDisableSpoolType.val      = !!pfContext.disableSpoolType
  !this.togAllowConsCheckDrawing.val = !!pfContext.allowConsCheckDrawing
  !this.togAutoNamingRules.val       = !!pfContext.autoNamingRules
  !this.togDisablePartNumberMsg.val  = !!pfContext.disablePartumberMsg
  !this.togDisableSkeyMsg.val        = !!pfContext.disableSkeyMsg
  !this.txtDefaultWeldPrefix.val     = !!pfContext.defaultPrefixForWeld
  !this.togUpdateJointNumber.val     = !!pfContext.updateJointForGasket
  !this.txtDefaultJointPrefix.val    = !!pfContext.defaultPrefixForJoint
  !this.togGalvanizationCheck.val    = !!pfContext.defaultGalvanizationCheck

  !this.frameDefaults.active = !!pfContext.editable
  !this.btnOK.active = !!pfContext.editable
  !this.btnApply.active = !!pfContext.editable

  !this.updateJointNumber()
endmethod

--------------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: save all default values to storage
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .apply()

  if !this.txtDefaultLooseExcess.val.unset() then
    !this.txtDefaultLooseExcess.val = 0mm
  endif
  if !this.txtDefaultInsertExcess.val.unset() then
    !this.txtDefaultInsertExcess.val = 0mm
  endif
  if !this.txtDefaultSurfaceExcess.val.unset() then
    !this.txtDefaultSurfaceExcess.val = 0mm
  endif
  if !this.txtDefaultSaddleExcess.val.unset() then
    !this.txtDefaultSaddleExcess.val = 0mm
  endif
  if !this.txtDefaultBossExcess.val.unset() then
    !this.txtDefaultBossExcess.val = 0mm
  endif
  if !this.txtDefaultMitreExcess.val.unset() then
    !this.txtDefaultMitreExcess.val = 0mm
  endif

  !!pfContext.defaultLooseExcess    = !this.txtDefaultLooseExcess.val
  !!pfContext.defaultInsertExcess   = !this.txtDefaultInsertExcess.val
  !!pfContext.defaultSurfaceExcess  = !this.txtDefaultSurfaceExcess.val
  !!pfContext.defaultSaddleExcess   = !this.txtDefaultSaddleExcess.val
  !!pfContext.defaultBossExcess     = !this.txtDefaultBossExcess.val
  !!pfContext.defaultMitreExcess    = !this.txtDefaultMitreExcess.val
  !!pfContext.updtManCreateedWelds  = !this.toupdtManCreateedWelds.val
  !!pfContext.firstFeedNegative     = !this.togNegativeFirstFeed.val
  !!pfContext.xyzBendingTable       = !this.togXYZBendingTable.val
  !!pfContext.reverseBendingDataOrder = !this.togReverseBendingDataOrder.val
  !!pfContext.allowFeedExcess       = !this.togAllowFeedExcess.val
  !!pfContext.allowBendEndExcess    = !this.togAllowBendEndExcess.val
  !!pfContext.allowExtrEndExcess    = !this.togAllowExtrEndExcess.val
  !!pfContext.disableSpoolType      = !this.togDisableSpoolType.val
  !!pfContext.allowConsCheckDrawing = !this.togAllowConsCheckDrawing.val
  !!pfContext.autoNamingRules       = !this.togAutoNamingRules.val
  !!pfContext.disablePartumberMsg   = !this.togDisablePartNumberMsg.val
  !!pfContext.disableSkeyMsg        = !this.togDisableSkeyMsg.val
  !!pfContext.defaultPrefixForWeld  = !this.txtDefaultWeldPrefix.val
  !!pfContext.updateJointForGasket  = !this.togUpdateJointNumber.val
  !!pfContext.defaultPrefixForJoint = !this.txtDefaultJointPrefix.val
  !!pfContext.defaultGalvanizationCheck = !this.togGalvanizationCheck.val

  !this.undo.description('Save Defaults')
  !this.undo.add()

  !!pfContext.saveDefaults()
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  !this.undo.endUndoable()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      updateJointNumber
--
-- Description: update joint number
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .updateJointNumber()
  !this.txtDefaultJointPrefix.active = !this.togUpdateJointNumber.val
endmethod


--------------------------------------------------------------------------------
--
-- Method:      checkJointPrefix
--
-- Description: check joint prefix
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .checkJointLetterLength(!gadget is GADGET, !dummyString is STRING)
  if (!gadget.val.empty()) then
    return
  endif

  if (!gadget.val.trim().length() gt 4) then
    !!alert.message('Exceed limit length! First four letters will used for Prefix.')
    !gadget.val = substring(!gadget.val.trim(),1, 4).upcase()
  else
    !gadget.val = !gadget.val.trim().upcase()
  endif
endmethod
