--
-- Description:     Form for pipe end excess
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  displayPieceExcess()             -                   display excess values
--  onActionSetEndExcess(ARRAY)      -                   give an excess to the tube picked
--  onClickApplyExcess()             -                   apply excess values
--  onClickResetExcess()             -                   reset excess values
--  onEscapeSetEndExcess()           -                   escape the EDG process
--  onInitialize()                   -                   initialize form
--  onQuit()                         -                   quit form
--  pfEndExcess()                    -                   constructor
--  setEndExcess()                   -                   initiate an EDG process
--  validateExcessValue(GADGET,STRING) -                   validate the excess value by user
--
--------------------------------------------------------------------------------
-- Define form
setup form !!pfEndExcess dialog

  !this.formTitle  = 'End Excess'
  !this.initcall   = '!this.onInitialize()'
  !this.quitCall   = '!this.onQuit()'

  path down
  frame .frameDirection 'End Excess' wid 23
    text .txtArriveExcess 'Arrive' tagwid 6 callback '!this.validateExcessValue(' is REAL format !!distanceFmt
    text .txtLeaveExcess  'Leave'  tagwid 6 callback '!this.validateExcessValue(' is REAL format !!distanceFmt
  exit

  button .btnApply 'Apply' callback '!this.onClickApplyExcess()' width 6 APPLY
  path right
  button .btnResest 'Reset' callback '!this.onClickResetExcess()' width 6 RESET
  button .btnDismiss 'Dismiss' callback '!this.onQuit()' width 6 CANCEL

  member  .arriveBoundary       is DBREF

  member  .leaveBoundary        is DBREF

  member  .partRefs             is ARRAY

  member  .aidNumber            is REAL

  member  .undo                 is UNDOABLE

exit

--------------------------------------------------------------------------------
--
-- Method:      pfEndExcess
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfEndExcess()

  --if defined(!!pfModifySpool) then
  --  !this.aidNumber = !!pfModifySpool.aidNoForEndExcess
  --else
  --  !this.aidNumber = !!aidNumbers.add('PF - End Excess')
  --endif
  !this.aidNumber = !!fmSys.loadForm('pfModifySpool').aidNoForEndExcess

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onInitialize
--
-- Description: initialize this form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onInitialize()

  !this.btnApply.active = false
  !this.txtArriveExcess.val = 0
  !this.txtLeaveExcess.val = 0

  !!aidNumbers.hide(!this.aidNumber)
  !this.aidNumber = !!fmSys.loadForm('pfModifySpool').aidNoForEndExcess

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onQuit
--
-- Description: quit form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onQuit()

  if defined(!!pfModifySpool) then
    !!pfModifySpool.refreshEndExcesses()
  else
    UNENHANCE ALL
    --AID CLEAR TEXT $!this.aidNumber
    !!aidNumbers.hide(!this.aidNumber)
    handle ANY
    endhandle
  endif

  !!edgCntrl.remove('PF - Set End Excess')

endmethod

--------------------------------------------------------------------------------
--
-- Method:      validateExcessValue
--
-- Description: validate the excess value provided by user
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      text gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .validateExcessValue(!source is GADGET, !dummyString is STRING)

  !value = !source.val
  if !value.unset() or !value.lt(0mm) then
    !source.val = 0mm
  endif
endmethod


--------------------------------------------------------------------------------
--
-- Method:      setEndExcess
--
-- Description: initiate an EDG process for modifying end excess values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .setEndExcess()

  !!edgCntrl.remove('PF - Set End Excess')

  !packet = object EDGPACKET()
  !packet.action = |!!pfEndExcess.onActionSetEndExcess(!this.return)|
  !packet.escape = |!!pfEndExcess.onEscapeSetEndExcess()|
  --!packet.definePosition('Pick part or <ESC> to finish')
  !packet.elementPick('Pick tubing or bend or <ESC> to finish')
  !packet.pickPacket.picks[1].pick.input[3] = |TYPE EQ 'TUBI' OR TYPE EQ 'BEND' OR TYPE EQ 'FTUB'|
  --!packet.pickPacket.picks[1].pick.input[5] = |TYPE EQ 'TUBING'|
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.description = 'PF - Set End Excess'
  --!packet.remove = false
  --!packet.form = !!pfEndExcess

  !!edgCntrl.add(!packet)
  --if !!edgCntrl.add(!packet) then
  --  !this.showPieceExcess(!!ce)
  --endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onActionSetEndExcess
--
-- Description: display excess values of the picked tube
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       EDG data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onActionSetEndExcess(!data is ARRAY)

  if !data.unset() OR !data.empty() then
    return
  endif

  !item = !data[1].item

  UNENHANCE ALL
  --AID CLEAR TEXT $!this.aidNumber
  !!aidNumbers.hide(!this.aidNumber)
  handle ANY
  endhandle

  if !item.type.neq('BRAN') and !item.owner.type.neq('BRAN') then
    return
  endif

  !!pfGetTubeParts(!item, !this.arriveBoundary, !this.leaveBoundary, !this.partRefs)

  !!pfGetExcessComponents(!this.arriveBoundary, !this.leaveBoundary)

  if !this.partRefs.empty() or !this.arriveBoundary.unset() or !this.leaveBoundary.unset() then
    --!!alert.error('No tubes or bends!')
  else

    !this.show('FREE')

      !this.txtArriveExcess.val = !this.arriveBoundary.lexcess
      !this.txtArriveExcess.active = true

      !this.txtLeaveExcess.val = !this.leaveBoundary.aexcess
      !this.txtLeaveExcess.active = true

    !this.btnApply.active = true

    !this.displayPieceExcess()
  endif

  if (((!this.arriveBoundary.lexcess eq !!pfDefaults.txtDefaultLooseExcess.val) AND !this.arriveBoundary.loose) AND ((!this.leaveBoundary.aexcess eq !!pfDefaults.txtDefaultLooseExcess.val) AND !this.leaveBoundary.loose)) then
    !warningMessage = 'The existing Arrive and Leave value is set to the default loose excess of $!!pfContext.defaultLooseExcess'
  elseif((!this.arriveBoundary.lexcess eq !!pfDefaults.txtDefaultLooseExcess.val) AND !this.arriveBoundary.loose) then
    !warningMessage = 'The existing Arrive value is set to the default loose excess of $!!pfContext.defaultLooseExcess'
  elseif((!this.leaveBoundary.aexcess eq !!pfDefaults.txtDefaultLooseExcess.val) AND !this.leaveBoundary.loose) then
    !warningMessage = 'The existing Leave value is set to the default loose excess of $!!pfContext.defaultLooseExcess'
  endif

  if(defined(!warningMessage)) then
    !!alert.warning('$!warningMessage')
  endif

endmethod


--------------------------------------------------------------------------------
--
-- Method:      displayPieceExcess
--
-- Description: display end excess values with aid elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .displayPieceExcess()

  UNENHANCE ALL

  AID CLEAR TEXT $!this.aidNumber
  handle ANY
  endhandle

  if !this.partRefs.empty() or !this.arriveBoundary.badref() or !this.leaveBoundary.badref() then
    return
  endif

  do !partRef values !this.partRefs
    ENHANCE $!<partRef> COL $!!<gphColOpt.highlight.code>
  enddo

  if !this.arriveBoundary.type.eq('BRAN') then
    !arrivePosition = !this.arriveBoundary.hpos
  else
    !arrivePosition = !this.arriveBoundary.lpos
  endif

  if !this.leaveBoundary.type.eq('BRAN') then
    !leavePosition = !this.leaveBoundary.tpos
  else
    !leavePosition = !this.leaveBoundary.apos
  endif


  !arriveExcess = !this.arriveBoundary.lexcess.string(!!distanceFmt)
  !leaveExcess = !this.leaveBoundary.aexcess.string(!!distanceFmt)

  AID TEXT NUM $!this.aidNumber |Arrive : $!arriveExcess| AT $!arrivePosition
  AID TEXT NUM $!this.aidNumber |Leave : $!leaveExcess| AT $!leavePosition

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onEscapeSetEndExcess
--
-- Description: clear aid elements and hide this form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onEscapeSetEndExcess()

  UNENHANCE ALL

  AID CLEAR TEXT $!this.aidNumber
  handle ANY
    -- dummy
  endhandle

  !this.hide()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickApplyExcess
--
-- Description: apply the excess values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickApplyExcess()

  if !this.partRefs.empty() or !this.arriveBoundary.badref() or !this.leaveBoundary.badref() then
    return
  endif

  !this.undo.description('Set End Excess')
  !this.undo.add()

  !this.arriveBoundary.lexcess = !this.txtArriveExcess.val
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  !this.leaveBoundary.aexcess = !this.txtLeaveExcess.val
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  !this.undo.endUndoable()

  !this.displayPieceExcess()
  --if defined(!!pfModifySpool) then
  --  !!pfModifySpool.refreshEndExcesses()
  --endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickResetExcess
--
-- Description: reset excess values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickResetExcess()

  !this.txtArriveExcess.val = 0mm
  !this.txtLeaveExcess.val = 0mm

endmethod
