--
-- Description:
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkCopyName()                  -                   check that the name of the element in the copy field is valid
--  checkName()                      -                   check that the name is valid
--  create()                         -                   create an element of given type and name
--  init()                           -                   initialize form
--  modify()                         -                   modify the name of the element
--  pfFabMachineCrt()                -                   constructor
--
--------------------------------------------------------------------------------
setup form !!pfFabMachineCrt dialog

  !this.formtitle = 'Create'
  !this.initCall  = '!this.init()'

  path down
  text .txtName        'Name:       ' at x1 ymax + 0.5 width 32 is STRING
  text .txtDescription 'Description:' width 32 STRING

  toggle .togCopy      '' at x6 ymax + 0.5 callback '!this.txtCopyName.active = !this.togCopy.val'
  text   .txtCopyName  'Copy:' at xmax ymin width 32 is STRING

  button .btnApply     ' Apply ' at x1 ymax + 0.5 callback |!this.create()|
  button .btnDismiss   'Dismiss' at xmax form-size ymin cancel

  -- mode : new or modify
  member .mode       is STRING

  -- element type
  member .type       is STRING

  -- current element
  member .current    is DBREF

  -- undoable
  member .undo       is UNDOABLE

exit

--------------------------------------------------------------------------------
--
-- Method:      pfFabMachineCrt
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfFabMachineCrt()

  !this.txtName.validateCall = '!this.checkName()'
  !this.txtCopyName.validateCall = '!this.checkCopyName()'

endmethod

--------------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: initialize form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .init()

   -- Undoable
   !this.undo.description('')
   !this.undo.undoAction('')
   !this.undo.redoAction('')
   !this.btnApply.setUndoable(!!pfFabMachineCrt.undo)

   if !this.mode.eq('new') then
      !this.btnApply.callback  = '!this.create()'
      !this.togCopy.active     = true
      !this.togCopy.val        = false
      !this.txtCopyName.active = false
   elseif !this.mode.eq('modify') then
      !this.btnApply.callback = '!this.modify()'
      !this.txtName.val = !this.current.name
      !this.txtDescription.val = !this.current.description
      !this.togCopy.active     = false
      !this.togCopy.val        = false
      !this.txtCopyName.active = false
   endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      create
--
-- Description: called when the apply button is pressed when the mode is 'new'
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .create()

  !!ce = !this.current

  --check that the name gadget is populated
  if !this.txtName.val.trim().eq('') then
    !!alert.message('Enter a name')
    !this.txtName.setFocus()
    return
  elseif !this.txtDescription.val.eq('')then
    !!alert.message('Enter a description')
    !this.txtDescription.setFocus()
    return
  endif

  -- Create new elements
  if !this.togCopy.val then
    NEW $!this.type $!this.txtName.val COPY $!this.txtCopyName.val
    handle ANY
      !!alert.error(!!error.text)
      return
    endhandle
  else
    NEW $!this.type $!this.txtName
    handle ANY
      !!alert.error(!!error.text)
      return
    endhandle
  endif

  !!ce.desc = !this.txtDescription.val.trim()

  if !this.type.eq('FMWL') then
    !this.owner().refreshFabricationMachineWorlds()
    !this.owner().optMachineWorld.select('rtext', !!ce.name)
    handle ANY
      -- dummy
    endhandle
    !this.owner().onFabricationMachineWorldChanged()
  elseif !this.type.eq('FMGRP') then
    !this.owner().refreshFabricationMachineGroups()
    !this.owner().optMachineGroup.select('rtext', !!ce.name)
    handle ANY
      -- dummy
    endhandle
    !this.owner().onFabricationMachineGroupChanged()
  elseif !this.type.eq('FMBEND') then
    !this.owner().selectCurrent(!!ce)
  elseif !this.type.eq('FMWELD') then
    !this.owner().selectCurrent(!!ce)
  elseif !this.type.eq('FMEXTR') then
    !this.owner().selectCurrent(!!ce)
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      modify
--
-- Description: called when the apply button is pressed when the mode is 'modify'
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .modify()

  !!ce = !this.current

  --check that the name gadget is populated
  if !this.txtName.val.trim().eq('') then
    !!alert.message('Enter a name')
    !this.txtName.setFocus()
    return
  elseif !this.txtDescription.val.trim().eq('')then
    !!alert.message('Enter a description')
    !this.txtDescription.setFocus()
    return
  endif

  !!ce.name =!this.txtName.val.trim()
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle
  !!ce.desc =  !this.txtDescription.val.trim()

  if !this.type.eq('FMWL') then
    !this.owner().refreshFabricationMachineWorlds()
    !this.owner().optMachineWorld.select('rtext', !!ce.name)
    handle ANY
      -- dummy
    endhandle
    !this.owner().onFabricationMachineWorldChanged()
  elseif !this.type.eq('FMGRP') then
    !this.owner().refreshFabricationMachineGroups()
    !this.owner().optMachineGroup.select('rtext', !!ce.name)
    handle ANY
      -- dummy
    endhandle
    !this.owner().onFabricationMachineGroupChanged()
  elseif !this.type.eq('FMWELD') then
    !this.owner().selectCurrent(!!ce)
  elseif !this.type.eq('FMBEND') then
    !this.owner().selectCurrent(!!ce)
  elseif !this.type.eq('FMEXTR') then
    !this.owner().selectCurrent(!!ce)
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: called to check that the given name is valid for a new element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .checkName()

  !name = !!checkName(!this.txtName.val, 'NEW')
  if !name.set() then
    !this.txtName.val = !name
  else
    !this.txtName.setFocus()
    return error 1 noalert
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      checkName
--
-- Description: called to check that the name of the element in the copy field is valid
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .checkCopyName()

  !name = !!checkName(!this.txtCopyName.val, 'OLD')
  if !name.unset() then
    !this.txtCopyName.setFocus()
    return error 1 noalert
  endif

  !element = !name.dbref()
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  -- Fix for Issue 95137 (SI-56508)
  if !element.actType.neq(!this.type) then
    !!alert.error('Copy element not of the correct type')
    !this.txtCopyName.setFocus()
    return error 1 noalert
  endif

  !this.txtCopyName.val = !name
endmethod
