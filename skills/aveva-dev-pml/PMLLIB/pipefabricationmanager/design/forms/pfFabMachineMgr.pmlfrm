--------------------------------------------------------------------------------
--
-- Method:      gridBendCollisionPlanesBeforeCellUpdate
--
-- Description: called before updating a collision plane
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridBendCollisionPlanesBeforeCellUpdate(!args is ARRAY)

  !value = !args[0].real()
  handle (2,441)
    !!alert.error('Cannot convert string to REAL')
    !args[3] = false
    return
  endhandle

  if !value.unset() then
    !value = 0
  endif

  !fmbplnRef = !this.gridBendCollisionPlanes.getCell(!args[1], 'REFNO').dbRef()
  handle ANY
    !fmbplnRef = object DBREF()
  endhandle

  if !fmbplnRef.set() then

    if !args[2].eq('X Min') then
      !attName = 'minPlnPosition'
      !attValue = !fmbplnRef.minPlnPosition
      !attValue.east = !value
    elseif !args[2].eq('Y Min') then
      !attName = 'minPlnPosition'
      !attValue = !fmbplnRef.minPlnPosition
      !attValue.north = !value
    elseif !args[2].eq('Z Min') then
      !attName = 'minPlnPosition'
      !attValue = !fmbplnRef.minPlnPosition
      !attValue.up = !value
    elseif !args[2].eq('X Max') then
      !attName = 'maxPlnPosition'
      !attValue = !fmbplnRef.maxPlnPosition
      !attValue.east = !value
    elseif !args[2].eq('Y Max') then
      !attName = 'maxPlnPosition'
      !attValue = !fmbplnRef.maxPlnPosition
      !attValue.north = !value
    elseif !args[2].eq('Z Max') then
      !attName = 'maxPlnPosition'
      !attValue = !fmbplnRef.maxPlnPosition
      !attValue.up = !value
    endif

    !fmbplnRef.attribute(!attName) = !attValue
    handle ANY
      !!alert.error(!!error.text)
      !args[3] = false
    endhandle
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      gridBendCollisionPlanesAfterCellUpdate
--
-- Description: called after updating a collision plane
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridBendCollisionPlanesAfterCellUpdate(!args is ARRAY)

  !fmbplnRef = !this.gridBendCollisionPlanes.getCell(!args[0], 'REFNO').dbRef()
  handle ANY
    !fmbplnRef = object DBREF()
  endhandle

  if !fmbplnRef.unset() then
    !!alert.error('Cannot get the selected FMBPLN')
    !this.refreshBendCollisionPlanes()
    return
  endif

  !this.gridBendCollisionPlanes.allGridEvents(false)

  if !args[1].eq('X Min') then
    !this.gridBendCollisionPlanes.setCellValue(!args[0], !args[1], !fmbplnRef.minPlnPosition.east.string(!!distanceFmt))
  elseif !args[1].eq('Y Min')  then
    !this.gridBendCollisionPlanes.setCellValue(!args[0], !args[1], !fmbplnRef.minPlnPosition.north.string(!!distanceFmt))
  elseif !args[1].eq('Z Min')  then
    !this.gridBendCollisionPlanes.setCellValue(!args[0], !args[1], !fmbplnRef.minPlnPosition.up.string(!!distanceFmt))
  elseif !args[1].eq('X Max')  then
    !this.gridBendCollisionPlanes.setCellValue(!args[0], !args[1], !fmbplnRef.maxPlnPosition.east.string(!!distanceFmt))
  elseif !args[1].eq('Y Max')  then
    !this.gridBendCollisionPlanes.setCellValue(!args[0], !args[1], !fmbplnRef.maxPlnPosition.north.string(!!distanceFmt))
  elseif !args[1].eq('Z Max')  then
    !this.gridBendCollisionPlanes.setCellValue(!args[0], !args[1], !fmbplnRef.maxPlnPosition.up.string(!!distanceFmt))
  endif

  !this.gridBendCollisionPlanes.allGridEvents(true)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      refreshBendStretchData
--
-- Description: refresh the stretch data grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .refreshBendStretchData()
  using namespace 'Aveva.Pdms.Presentation'

  !rows = object ARRAY()

  !fmbendRef = !this.optBendMachine.selection().dbRef()
  handle ANY
    !!alert.error('Cannot get the selected FMBEND')
    !this.onFabricationMachineGroupChanged()
    return
  endhandle

  if !fmbendRef.set() then
    !fmbsstRefs = !!collectAllFor('FMBSST', |ACTTYPE EQ 'FMBSST'|, !fmbendRef)
    do !fmbsstRef values !fmbsstRefs
      !row = object ARRAY()
      !row.append(!fmbsstRef.refNo.string())
      !row.append(!!pfContext.formatOD(!fmbsstRef.od))
      !row.append(!!pfContext.formatWallThickness(!fmbsstRef.wThickness))
      if !fmbsstRef.matRef.badref() then
        !material = 'Unset'
      else
        !material = !fmbsstRef.matRef.name
      endif
      !row.append(!material)
      !row.append(!!pfContext.formatStretchFactor(!fmbsstRef.stfProportional))
      !row.append(!!pfContext.formatStretchFactor(!fmbsstRef.stfConstant))
      !rows.append(!row)
    enddo
  endif

  !titles = object ARRAY()
  !titles.append('REFNO')
  !titles.append('OD')
  !titles.append('WThickness')
  !titles.append('Matref')
  !titles.append('STFProportional')
  !titles.append('STFConstant')

  !ds = object NETDATASOURCE('Bending Stretch Data', !titles, !rows, 'Bending Stretch Data')

  !this.gridBendStretchData.bindToDataSource(!ds)
  !this.gridBendStretchData.setColumnVisibility('REFNO', false)
  !this.gridBendStretchData.setColumnTextAlignment('OD', 'RIGHT')
  !this.gridBendStretchData.setColumnTextAlignment('WThickness', 'RIGHT')
  !this.gridBendStretchData.setColumnTextAlignment('STFProportional', 'RIGHT')
  !this.gridBendStretchData.setColumnTextAlignment('STFConstant', 'LEFT')
  !this.createMaterialValueList()
  --!this.gridBendStretchData.assignValueListToColumn('MATREF', 4)
  if !this.firstTimeStretchData then
    !this.firstTimeStretchData = false
    !this.gridBendStretchData.autoFitColumns()
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      createBendStretchData
--
-- Description: create a new stretch data element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
