--------------------------------------------------------------------------------
--
-- Method:      changeNameDescription
--
-- Description: toggle between name and description for display text
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .changeNameDescription()

  !world = !this.optMachineWorld.selection()
  !group = !this.optMachineGroup.selection()

  !machine = ''
  !machineType = !this.optMachineType.selection()
  if !machineType.eq('BENDING') then
    !machine = !this.optBendMachine.selection()
  elseif !machineType.eq('WELDING') then
    !machine = !this.optWeldMachine.selection()
  elseif !machineType.eq('EXTRUSION') then
    !machine = !this.optExtrMachine.selection()
  endif

  !this.refreshFabricationMachineWorlds()
  !this.optMachineWorld.select('rtext', !world)
  handle ANY
    --dummy
  endhandle
  !this.refreshFabricationMachineGroups()
  !this.optMachineGroup.select('rtext', !group)
  handle ANY
    --dummy
  endhandle

  !this.refreshFabricationMachines()
  if !machineType.eq('BENDING') then
    !this.optBendMachine.select('rtext', !machine)
    handle ANY
      --dummy
    endhandle
  elseif !machineType.eq('WELDING') then
    !this.optWeldMachine.select('rtext', !machine)
    handle ANY
      --dummy
    endhandle
  elseif !machineType.eq('EXTRUSION') then
    !this.optExtrMachine.select('rtext', !machine)
    handle ANY
      --dummy
    endhandle
  endif

  --!this.onFabricationMachineChanged()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      showCollisionPlane
--
-- Description: display a collision plane with aid elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R      STRING     name
--    2    R      POSITION   minimum position
--    3    R      POSITION   maximum position
--    4    R      BOOLEAN    hide previous aid elements
--    5    R      ANY        colour
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .showCollisionPlane(!name is STRING, !posMin is POSITION, !posMax is POSITION, !hidePreviousAids is BOOLEAN, !colour is ANY)

  !colourObject = object COLOUR(!colour)
  !colourCode = !colourObject.code

  -- Get the middle position of the combined
  !middlePosition = !posMin.midPoint(!posMax).wrt( /* )

  -- Create a default plane
  !plane = object PLANE(!middlePosition, object ORIENTATION('Z is Z and X is X'))

  !pos = !middlePosition

  -- Get the plane size

  --Fix Issue 97743
  --!xSize = (!posMax.east - !posMin.east)
  --!ySize = (!posMax.north - !posMin.north)
  --if (!xSize eq 0) then
  if !posMax.east.string(!!distanceFmt).eq(!posMin.east.string(!!distanceFmt)) then
    !pos.east = 0
  --elseif (!ySize eq 0) then
  elseif !posMax.north.string(!!distanceFmt).eq(!posMin.north.string(!!distanceFmt)) then
    !pos.north = 0
  else
    !pos.up = 0
  endif
  --//

  !plane = !plane.towards(!pos)

  -- Define and draw the plane using plane generated from a !position.plane(!posMin, !posMax)
  !position = !posMin
  -- If the Z values are equal we have a horizontal plane

  --Fix Issue 97743
  --if ((!posMax.up eq !posMin.up)) then
  if !posMax.up.string(!!distanceFmt).eq(!posMin.up.string(!!distanceFmt)) then
  --//
    !position.north = !posMax.north
  else
    !position.up = !posMax.up
  endif

  !xSize = !position.distance(!posMin)
  !ySize = !position.distance(!posMax)
  !newPlane = !position.plane(!posMin, !posMax)
  handle ANY
    -- invalid plane?
    !!alert.error('Invalid Plane! Check the dimensions')
    AID CLEAR ALL
    return
  endhandle
  !newPlane.position = !middlePosition

  -- Display positions
  if (!hidePreviousAids) then
    AID CLEAR ALL
  endif

  -- Allocate Aid numbers
  !aidNo = !!aidNumbers.add('PF Collision Plane')

  -- Draw a graphical plane to indicate the fitting position
  !collisionPlane = object GPHPLANE(!newPlane)
  !collisionPlane.description = 'Plane $!name'
  !collisionPlane.tag = true
  !collisionPlane.x = !xSize
  !collisionPlane.y = !ySize

  -- Colour does not work if fill is on, because a plane has no independent colour method
  !collisionPlane.draw(!aidNo, true, !colourCode)

endmethod

--------------------------------------------------------------------------------
--
-- Method:      gridBendCollisionPlanesAfterSelectChange
--
-- Description: called when the selection of the collision plane grid is changed
--              display collision plane(s) in the 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       event arguments
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridBendCollisionPlanesAfterSelectChange(!args is ARRAY)

  if !args.unset() or !args.size().eq(0) or !args[0].empty() then
    return
  endif

  !this.loadCollisionPlanes(!args[0])

endmethod

--------------------------------------------------------------------------------
--
-- Method:      gridBendCollisionPlanesBeforeCellActivate
--
-- Description: display the selected collision plane in the 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       event arguments
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridBendCollisionPlanesBeforeCellActivate(!args is ARRAY)
  -- Fix for Issue 94909 (SI-56252)
  if !args.unset() or !args.size().eq(0) then
    return
  endif

  !rowTags = object ARRAY()
  !rowTags.append(!args[0])

  !this.loadCollisionPlanes(!rowTags)

endmethod


--------------------------------------------------------------------------------
--
-- Method:      saveReport
--
-- Description: write a fabrication machine report file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      machine type (FMBEND, FMWELD or FMEXTR)
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .saveReport(!machine is STRING)

  !dbRef          = object DBREF()
  !bendDims       = object ARRAY()
  !bendPlanes     = object ARRAY()
  !bendStretch    = object ARRAY()
  !bendSpringback = object ARRAY()
  !weldSkeys      = object ARRAY()
  !weldDims       = object ARRAY()
  !weldCons       = object ARRAY()
  !extrDims       = object ARRAY()
  !extrDistance   = object ARRAY()
  !lines  = object ARRAY()

  -- Check Machine Type
  if !machine.eq('FMBEND') then

    if !this.optBendMachine.val.eq(0) then
      !!alert.message('Select a bending machine!')
      return
    endif

    !dbRef = object DBREF(!this.optBendMachine.selection())
    handle ANY
      !dbRef = object DBREF()
    endhandle

    if !dbRef.unset() then
      !!alert.error('Cannot get the selected FMBEND')
      !this.onFabricationMachineGroupChanged()
      return
    endif

    !bendDims = !this.gridBendDimensions.getRows()
    !bendDims.insert(1, !this.gridBendDimensions.getColumns())

    !bendPlanes = !this.gridBendCollisionPlanes.getRows()
    !bendPlanes.insert(1, !this.gridBendCollisionPlanes.getColumns())

    !bendStretch = !this.gridBendStretchData.getRows()
    !bendStretch.insert(1, !this.gridBendStretchData.getColumns())

    !bendSpringback =!this.gridBendSpringbackData.getRows()
    !bendSpringback.insert(1, !this.gridBendSpringbackData.getColumns())

  elseif !machine.eq('FMWELD') then

    if !this.optWeldMachine.val.eq(0) then
      !!alert.message('Select a welding machine!')
      return
    endif

    !dbRef = object DBREF(!this.optWeldMachine.selection())
    handle ANY
      !dbRef = object DBREF()
    endhandle

    if !dbRef.unset() then
      !!alert.error('Cannot get the selected FMWELD')
      !this.onFabricationMachineGroupChanged()
      return
    endif

    !weldSkeys = !this.gridWeldableFlangeSkey.getRows()
    !weldSkeys.insert(1, !this.gridWeldableFlangeSkey.getColumns())

    !weldDims = !this.gridWeldDimensions.getRows()
    !weldDims.insert(1, !this.gridWeldDimensions.getColumns())

    !weldCons = !this.gridWeldConnections.getRows()
    !weldCons.insert(1, !this.gridWeldConnections.getColumns())

  elseif !machine.eq('FMEXTR') then

    if !this.optExtrMachine.val.eq(0) then
      !!alert.message('Select an extrusion machine!')
      return
    endif

    !dbRef = object DBREF(!this.optExtrMachine.selection())
    handle ANY
      !dbRef = object DBREF()
    endhandle

    if !dbRef.unset() then
      !!alert.error('Cannot get the selected FMEXTR')
      !this.onFabricationMachineGroupChanged()
      return
    endif

    !extrDims = !this.gridExtrDimensions.getRows()
    !extrDims.insert(1, !this.gridExtrDimensions.getColumns())

    !extrDistance = !this.gridMinExtrDistance.getRows()
    !extrDistance.insert(1, !this.gridMinExtrDistance.getColumns())

  else
    !!alert.error('Invalid argument')
    return
  endif

  using namespace 'Aveva.Pdms.Presentation'
  !browser = object PMLFILEBROWSER('save')
  !fileName = !dbRef.name.replace('/', '') & '.txt'
  !browser.show('%PDMSUSER%', !fileName, 'Save Report', false, 'Text File (*.txt)|*.txt', 1)
  !file = !!file(!browser.file())

  if(!file.unset()) then
    return
  endif

  -- Time and User information
  !dateTime = object DATETIME()
  !session  = CURRENT SESSION

  if (!machine eq 'FMBEND') then
    -- File header
    !lines.append('Bending Machine Report File')
    !lines.append('~~~~~~~~~~~~~~~~~~~~~~~~~~~')
    !lines.append('')
    !lines.append('  Created By : ' & !session.name)
    !lines.append('        Date : ' & !dateTime)
    !lines.append('')

    -- General Table
    !lines.append('General Data')
    !lines.append('~~~~~~~~~~~~')
    !lines.append('   Bending Machine name                         : ' & !dbRef.name )
    !lines.append('   Description                                  : ' & !dbRef.description )
    !lines.append('   Proportional Stretch Factor                  : ' & !!pfContext.formatStretchFactor(!dbRef.stfProportional))
    !lines.append('   Constant Stretch Factor                      : ' & !!pfContext.formatStretchFactor(!dbRef.stfConstant))
    !lines.append('   Bending Direction                            : ' & !dbRef.benDirection)
    !lines.append('   Pipe Rotation                                : ' & !dbRef.benRotation)
    --!lines.append('   Compensate bending activities for Springback : ' & !dbRef.compensate.string())
    !lines.append('   Incremental Springback                       : ' & !dbRef.stepSpringback.string())

    !lines.append('')

    -- Dimension Table
    !lines.append('Dimension Table')
    !lines.append('~~~~~~~~~~~~~~~')

    !col = object ARRAY()
    do !i indices !bendDims[1]
      !col[!i] = 3
    enddo

    do !i indices !bendDims
      do !j indices !bendDims[!i]
        !col[!j] = !col[!j].max(!bendDims[!i][!j].length())
      enddo
    enddo

    do !i indices !bendDims
      var !line COMPOSE |$!bendDims[$!i][2]| width $!col[2] R spaces 2 $
      |$!bendDims[$!i][3]| width $!col[3] R spaces 2 $
      |$!bendDims[$!i][4]| width $!col[4] R spaces 2 $
      |$!bendDims[$!i][5]| width $!col[5] R spaces 2 $
      |$!bendDims[$!i][6]| width $!col[6] R spaces 2 $
      |$!bendDims[$!i][7]| width $!col[7] R spaces 2 $
      |$!bendDims[$!i][8]| width $!col[8] R spaces 2 $
      |$!bendDims[$!i][9]| width $!col[9] R spaces 2 $
      |$!bendDims[$!i][10]| width $!col[10] R spaces 2 $
      |$!bendDims[$!i][11]| width $!col[11] R

      !lines.appendArray(!line)
    enddo

    !lines.append('')

    -- Planes Table
    !lines.append('Collision Plane Table')
    !lines.append('~~~~~~~~~~~~~~~~~~~~~')

    !col.clear()
    do !i indices !bendPlanes[1]
      !col[!i] = 3
    enddo

    do !i indices !bendPlanes
      do !j indices !bendPlanes[!i]
        !col[!j] = !col[!j].max(!bendPlanes[!i][!j].length())
      enddo
    enddo

    do !i indices !bendPlanes
      var !line COMPOSE |$!bendPlanes[$!i][2]| width $!col[2] R spaces 2 $
      |$!bendPlanes[$!i][3]| width $!col[3] R spaces 2 $
      |$!bendPlanes[$!i][4]| width $!col[4] R spaces 2 $
      |$!bendPlanes[$!i][5]| width $!col[5] R spaces 2 $
      |$!bendPlanes[$!i][6]| width $!col[6] R spaces 2 $
      |$!bendPlanes[$!i][7]| width $!col[7] R

      !lines.appendArray(!line)
    enddo

    !lines.append('')

    -- Stretch Table
    !lines.append('Bending Stretch Table')
    !lines.append('~~~~~~~~~~~~~~~~~~~~~')

    !col.clear()
    do !i indices !bendStretch[1]
      !col[!i] = 3
    enddo

    do !i indices !bendStretch
      do !j indices !bendStretch[!i]
        !col[!j] = !col[!j].max(!bendStretch[!i][!j].length())
      enddo
    enddo

    do !i indices !bendStretch
      var !line COMPOSE |$!bendStretch[$!i][2]| width $!col[2] R spaces 2 $
      |$!bendStretch[$!i][3]| width $!col[3] R spaces 2 $
      |$!bendStretch[$!i][4]| width $!col[4] L spaces 2 $
      |$!bendStretch[$!i][5]| width $!col[5] R spaces 2 $
      |$!bendStretch[$!i][6]| width $!col[6] R
      !lines.appendArray(!line)
    enddo

    !lines.append('')

    -- Springback Table
    !lines.append('Bending Springback Table')
    !lines.append('~~~~~~~~~~~~~~~~~~~~~~~~')

    !col.clear()
    do !i indices !bendSpringback[1]
      !col[!i] = 3
    enddo

    do !i indices !bendSpringback
      do !j indices !bendSpringback[!i]
        !col[!j] = !col[!j].max(!bendSpringback[!i][!j].length())
      enddo
    enddo

    do !i indices !bendSpringback
      var !line COMPOSE |$!bendSpringback[$!i][2]| width $!col[2] R spaces 2 $
      |$!bendSpringback[$!i][3]| width $!col[3] R spaces 2 $
      |$!bendSpringback[$!i][4]| width $!col[4] L spaces 2 $
      |$!bendSpringback[$!i][5]| width $!col[5] R spaces 2 $
      |$!bendSpringback[$!i][6]| width $!col[6] R
      !lines.appendArray(!line)
    enddo

  elseif !machine.eq('FMWELD') then

    -- File header
    !lines.append('Welding Machine Report File')
    !lines.append('~~~~~~~~~~~~~~~~~~~~~~~~~~~')
    !lines.append('')
    !lines.append('  Created By : ' & !session.name)
    !lines.append('        Date : ' & !dateTime)
    !lines.append('')

    -- General Table
    !lines.append('General Data')
    !lines.append('~~~~~~~~~~~~')
    !lines.append('   Welding Machine name     : ' & !dbRef.name)
    !lines.append('   Description              : ' & !dbRef.description)
    !lines.append('   Minimum Outer Diameter   : ' & !!pfContext.formatOD(!dbRef.minOD))
    !lines.append('   Maximum Outer Diameter   : ' & !!pfContext.formatOD(!dbRef.maxOD))
    !lines.append('   Minimum Length of Pipe   : ' & !dbRef.minLP.string(!!distanceFmt))
    !lines.append('   Maximum Length of Pipe   : ' & !dbRef.maxLP.string(!!distanceFmt))
    !lines.append('')

    -- SKEY Table
    !lines.append('Weldable Flange Table')
    !lines.append('~~~~~~~~~~~~~~~~~~~')

    do !i indices !weldSkeys
      !lines.append(!weldSkeys[!i][2])
    enddo

    !lines.append('')

    !lines.append('Dimension Table')
    !lines.append('~~~~~~~~~~~~~~~~~~~~~~~')

    !col = object ARRAY()
    do !i indices !weldDims[1]
      !col[!i] = 3
    enddo

    do !i indices !weldDims
      do !j indices !weldDims[!i]
        !col[!j] = !col[!j].max(!weldDims[!i][!j].length())
      enddo
    enddo

    do !i indices !weldDims
      var !line COMPOSE |$!weldDims[$!i][2]| width $!col[2] R spaces 2 $
      |$!weldDims[$!i][3]| width $!col[3] R spaces 2 $
      |$!weldDims[$!i][4]| width $!col[4] L spaces 2 $
      |$!weldDims[$!i][5]| width $!col[5] R spaces 2 $
      |$!weldDims[$!i][6]| width $!col[6] R spaces 2 $
      |$!weldDims[$!i][7]| width $!col[7] R
      !lines.appendArray(!line)
    enddo

    !lines.append('')
    !lines.append('Connection Table')
    !lines.append('~~~~~~~~~~~~~~~~~~~~~')
    do !i indices !weldCons
      !lines.append(!weldCons[!i][2])
    enddo

  elseif !machine.eq('FMEXTR') then
    -- File header
    !lines.append('Extrusion Machine Report File')
    !lines.append('~~~~~~~~~~~~~~~~~~~~~~~~~~~')
    !lines.append('')
    !lines.append('  Created By : ' & !session.name)
    !lines.append('        Date : ' & !dateTime)
    !lines.append('')

    -- Fix Issue 97673, 12.1.SP4#DVD RC3 - PF - Extrusion Machine Report Missing Name
    -- General Table
    !lines.append('General Data')
    !lines.append('~~~~~~~~~~~~')
    !lines.append('   Extrusion Machine name                       : ' & !dbRef.name )
    !lines.append('   Description                                  : ' & !dbRef.description )
    -- //

    !lines.append('')

    !lines.append('Dimension Table')
    !lines.append('~~~~~~~~~~~~~~~~~~~~~~~')

    !col = object ARRAY()
    do !i indices !extrDims[1]
      !col[!i] = 3
    enddo

    do !i indices !extrDims
      do !j indices !extrDims[!i]
        !col[!j] = !col[!j].max(!extrDims[!i][!j].length())
      enddo
    enddo

    do !i indices !extrDims
      var !line COMPOSE |$!extrDims[$!i][2]| width $!col[2] R spaces 2 $
      |$!extrDims[$!i][3]| width $!col[3] R spaces 2 $
      |$!extrDims[$!i][4]| width $!col[4] L spaces 2 $
      |$!extrDims[$!i][5]| width $!col[5] R spaces 2 $
      |$!extrDims[$!i][6]| width $!col[6] R spaces 2 $
      |$!extrDims[$!i][7]| width $!col[7] R spaces 2 $
      |$!extrDims[$!i][8]| width $!col[8] R spaces 2 $
      |$!extrDims[$!i][9]| width $!col[9] R spaces 2 $
      |$!extrDims[$!i][10]| width $!col[10] R
      !lines.appendArray(!line)
    enddo

    !lines.append('')
    !lines.append('Minimum Distance Table')
    !lines.append('~~~~~~~~~~~~~~~~~~~~~~')

    !col.clear()
    do !i indices !extrDistance[1]
      !col[!i] = 3
    enddo

    do !i indices !extrDistance
      do !j indices !extrDistance[!i]
        !col[!j] = !col[!j].max(!extrDistance[!i][!j].length())
      enddo
    enddo

    do !i indices !extrDistance
      var !line COMPOSE |$!extrDistance[$!i][2]| width $!col[2] R spaces 2 $
      |$!extrDistance[$!i][3]| width $!col[3] R spaces 2 $
      |$!extrDistance[$!i][4]| width $!col[4] R spaces 2 $
      |$!extrDistance[$!i][5]| width $!col[5] R
      !lines.appendArray(!line)
    enddo
  endif

  -- Footer
  !lines.append('')
  !lines.append('End of Fabrication Machine Report File')

  -- Close the file
  !file.writefile('overwrite',!lines)
  !file.close()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      deleteGridSelectedRows
--
-- Description: delete the selected elements in the given grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ANY         net grid control
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .deleteGridSelectedRows(!grid is ANY)

  !rowTags = !grid.getSelectedRowTags()
  if !rowTags.empty() then
    return
  endif

  !res = !!alert.confirm('OK to delete?')
  if !res.neq('YES') then
    return
  endif

  do !rowTag values !rowTags
    !dbRef = !grid.getCell(!rowTag, 'REFNO').dbRef()
    handle ANY
      !dbRef = object DBREF()
    endhandle

    if !dbRef.set() then
      !!ce = !dbRef
      DELETE $!<dbRef.actType>
      handle ANY
        !!alert.error(!!error.text)
      elsehandle NONE
        !rows = object ARRAY()
        !rows.append(!rowTag)
        !grid.deleteRows(!rows)
      endhandle
    endif
  enddo
endmethod

--------------------------------------------------------------------------------
--
-- Method:      validateWeldPipeOD
--
-- Description: validate the value of the given gadget as pipe outside diameter
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      event originator
--    2   R      STRING      action string
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .validateWeldPipeOD(!gadget is GADGET, !dummyString is STRING)

  !message = ''

  !value = !gadget.val.real()
  handle (2,441)
    !value = object REAL()
    !message = 'Cannot convert string to REAL'
  endhandle

  if !value.set() and !value.lt(0) then
    !message = 'Invalid OD'
  endif

  if !message.neq('') then
    !fmweldRef = !this.optWeldMachine.selection().dbRef()
    handle ANY
      !fmweldRef = object DBREF()
    endhandle

    if !fmweldRef.set() then
      if !gadget.eq(!this.txtWeldMinOD) then
        !gadget.val = !!pfContext.formatOD(!fmweldRef.minOD)
      elseif !gadget.eq(!this.txtWeldMaxOD) then
        !gadget.val = !!pfContext.formatOD(!fmweldRef.maxOD)
      endif
      !gadget.refresh()
    endif

    !gadget.setFocus()

    return error 1 '$!message'
  endif

  if !value.unset() then
    !value = 0
  endif

  !gadget.val = !!pfContext.formatOD(!value)

endmethod

--------------------------------------------------------------------------------
--
-- Method:      validateWeldPipeLength
--
-- Description: validate the value of the given gadget as pipe length
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      event originator
--    2   R      STRING      action string
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .validateWeldPipeLength(!gadget is GADGET, !dummyString is STRING)

  !message = ''

  !value = !gadget.val.real()
  handle (2, 441)
    !value = object REAL()
    !message = 'Cannot convert string to REAL'
  endhandle

  if !value.set() and !value.lt(0) then
    !message = 'Invalid pipe length'
  endif

  if !message.neq('') then
    !fmweldRef = !this.optWeldMachine.selection().dbRef()
    handle ANY
      !fmweldRef = object DBREF()
    endhandle

    if !fmweldRef.set() then
      if !gadget.eq(!this.txtWeldMinLP) then
        !gadget.val = !fmweldRef.minLP.string(!!distanceFmt)
      elseif !gadget.eq(!this.txtWeldMaxLP) then
        !gadget.val = !fmweldRef.maxLP.string(!!distanceFmt)
      endif
      !gadget.refresh()
    endif

    !gadget.setFocus()

    return error 1 '$!message'
  endif

  if !value.unset() then
    !value = 0
  endif

  !gadget.val = !value.string(!!distanceFmt)

endmethod

--------------------------------------------------------------------------------
--
-- Method:      validateSTFC
--
-- Description: validate the value of the given gadget as constant stretch factor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      event originator
--    2   R      STRING      action string
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .validateSTFC(!gadget is GADGET, !dummyString is STRING)

  !fmbendRef = !this.optBendMachine.selection().dbRef()

  if !gadget.val.unset() then
    !gadget.val = !!pfContext.formatStretchFactor(!fmbendRef.stfConstant)
    !gadget.refresh()
    return error 1 'A value must be provided for STF C'
  endif

  !constant = !gadget.val.real()
  handle (2,441)
    !gadget.val = !!pfContext.formatStretchFactor(!fmbendRef.stfConstant)
    !gadget.refresh()
    return error 1 'Cannot convert string to REAL'
  endhandle

  !minValue = 0.0000011
  if !constant.lt(!minValue) then
    !gadget.val = !!pfContext.formatStretchFactor(!fmbendRef.stfConstant)
    !gadget.refresh()
    return error 1 'STFC too small'
  endif

  !proportional = !fmbendRef.stfProportional
  !valid = !this.isValidStretchFactor(!constant, !proportional, false)
  if !valid.gt(0) then
    return error 1 'The combination of Proportional and Constant is invalid'
  elseif !valid.lt(0) then
    !!alert.message('The combination of Proportional and Constant is potentially invalid')
  endif

  !gadget.val = !!pfContext.formatStretchFactor(!constant)

endmethod


--------------------------------------------------------------------------------
--
-- Method:      validateSTFC
--
-- Description: validate the value of the given gadget as proportional stretch factor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      event originator
--    2   R      STRING      action string
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .validateSTFP(!gadget is GADGET, !dummyString is STRING)

  !fmbendRef = !this.optBendMachine.selection().dbRef()

  if !gadget.val.unset() then
    !gadget.val = !!pfContext.formatStretchFactor(!fmbendRef.stfProportional)
    !gadget.refresh()
    return error 1 'A value must be provided for STF P'
  endif

  !proportional = !gadget.val.real()
  handle (2,441)
    !gadget.val = !!pfContext.formatStretchFactor(!fmbendRef.stfProportional)
    !gadget.refresh()
    return error 1 'Cannot convert string to REAL'
  endhandle

  !constant = !fmbendRef.stfConstant
  !valid = !this.isValidStretchFactor(!constant, !proportional, false)
  if !valid.gt(0) then
    return error 1 'The combination of Proportional and Constant is invalid'
  elseif !valid.lt(0) then
    !!alert.message('The combination of Proportional and Constant is potentially invalid')
  endif

  !gadget.val = !!pfContext.formatStretchFactor(!proportional)

endmethod


--------------------------------------------------------------------------------
--
-- Method:      refreshBendDimensions
--
-- Description: refresh the bend dimension grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .refreshBendDimensions()
  using namespace 'Aveva.Pdms.Presentation'

  !rows = object ARRAY()

  !fmbendRef = !this.optBendMachine.selection().dbRef()
  handle ANY
    !!alert.error('Cannot get the selected FMBEND')
    !this.onFabricationMachineGroupChanged()
    return
  endhandle
  --Array to collect OD values
  !collectOD= object ARRAY()
  if !fmbendRef.set() then
    !fmbdimRefs = !!collectAllFor('FMBDIM', 'ACTTYPE EQ |FMBDIM|', !fmbendRef)
    do !fmbdimRef values !fmbdimRefs
      --!rows.append(!fmbdimRef.name)

      !row = object ARRAY()
      !row.append(!fmbdimRef.refNo.string())
      !row.append(!!pfContext.formatOD(!fmbdimRef.od))
      !row.append(!!pfContext.formatWallThickness(!fmbdimRef.wThickness))
      !row.append(!fmbdimRef.benpip.string(!!distanceFmt))
      !row.append(!fmbdimRef.benpif.string(!!distanceFmt))
      !row.append(!fmbdimRef.benpil.string(!!distanceFmt))
      !row.append(!fmbdimRef.benmlf.string(!!distanceFmt))
      !row.append(!fmbdimRef.grip.string(!!distanceFmt))
      !row.append(!fmbdimRef.benmll.string(!!distanceFmt))
      !row.append(!!pfContext.formatBendRadiusRatio(!fmbdimRef.bRadius))
      !row.append(!fmbdimRef.benpir.string(!!distanceFmt))
      !collectOD.append(!row[2].real())
      !rows.append(!row)
    enddo
  endif
--collecting the sorted indices for OD values
  !index = object ARRAY()
  !index = !collectOD.SortedIndices()
  --arranging the grid in ascending order
  !rows.reindex(!index)
  !titles = object ARRAY()
  !titles.append('REFNO')
  !titles.append('OD')
  !titles.append('WThickness')
  !titles.append('PIP')
  !titles.append('PIF')
  !titles.append('PIL')
  !titles.append('MLF')
  !titles.append('Grip')
  !titles.append('MLL')
  !titles.append('BRatio')
  !titles.append('PIR')

  !ds = object NETDATASOURCE('Bending Dimensions', !titles, !rows, 'Bending Dimensions')
  !this.gridBendDimensions.bindToDataSource(!ds)
  !this.gridBendDimensions.setColumnVisibility('REFNO', false)
  do !i indices !titles
    skip if !i.eq(!titles.size())
    !this.gridBendDimensions.setColumnTextAlignment(!titles[!i], 'RIGHT')
  enddo
  if !this.firstTimeBend then
    !this.firstTimeBend = false
    !this.gridBendDimensions.autoFitColumns()
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      createBendDimension
--
-- Description: create a new bend dimension element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .createBendDimension()

  !fmbendRef = !this.optBendMachine.selection().dbRef()
  handle ANY
    !fmbendRef = object DBREF()
  endhandle

  if !fmbendRef.unset() then
    !!alert.error('Cannot get the selected FMBEND')
    !this.onFabricationMachineGroupChanged()
    return
  endif

  !rowTags = !this.gridBendDimensions.getSelectedRowTags()
  if !rowTags.empty() then
    -- create after last element
    !!ce = !fmbendRef
    LAST FMBDIM
    handle ANY
    endhandle
  else
    -- Fix for Issue 94907 (SI-56257)
    -- create after the last selected element
    !rowTag = !rowTags.last()
    !refNo = !this.gridBendDimensions.getCell(!rowTag, 'REFNO')
    !fmbdimRef = !refNo.dbRef()
    handle ANY
      !!alert.error('Cannot get the selected FMBDIM')
      !this.refreshBendDimensions()
      return
    endhandle

    !!ce = !fmbdimRef
  endif

  NEW FMBDIM
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  using namespace  'Aveva.Pdms.Presentation'
  if (!rowTags.empty().not()) then
    !this.rowSelection(!this.gridBendDimensions, !refNo.dbRef())
  endif
  !fmbdimRef = !!ce
  !row = object ARRAY()
  !row.append(!fmbdimRef.refNo.string())
  !row.append(!!pfContext.formatOD(!fmbdimRef.od))
  !row.append(!!pfContext.formatWallThickness(!fmbdimRef.wThickness))
  !row.append(!fmbdimRef.benpip.string(!!distanceFmt))
  !row.append(!fmbdimRef.benpif.string(!!distanceFmt))
  !row.append(!fmbdimRef.benpil.string(!!distanceFmt))
  !row.append(!fmbdimRef.benmlf.string(!!distanceFmt))
  !row.append(!fmbdimRef.grip.string(!!distanceFmt))
  !row.append(!fmbdimRef.benmll.string(!!distanceFmt))
  !row.append(!!pfContext.formatBendRadiusRatio(!fmbdimRef.bRadius))
  !row.append(!fmbdimRef.benpir.string(!!distanceFmt))
  !this.gridBendDimensions.addRow(!row)
  !this.gridBendDimensions.moveSelectedRowsDown()
  !this.gridBendDimensions.clearRowSelection()
--  !this.gridBendDimensions.selectRow(!this.gridBendDimensions.getNumberRows())

  --!this.refreshBendDimensions()

  !refNos = !this.gridBendDimensions.getColumn('REFNO')
  !index = !refNos.findFirst(!fmbdimRef.refNo.string())
  if !index.set() then
    !this.gridBendDimensions.selectRow(!index)
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      copyBendDimension
--
-- Description: copy a bend dimension element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .copyBendDimension()

  !rowTags = !this.gridBendDimensions.getSelectedRowTags()
  if !rowTags.empty() then
    return
  endif

  !rowTag = !rowTags.last()
  !fmbdimRef = !this.gridBendDimensions.getCell(!rowTag, 'REFNO').dbRef()
  handle ANY
    !fmbdimRef = object DBREF()
  endhandle

  if !fmbdimRef.unset() then
    !!alert.error('Cannot get the selected FMBDIM')
    !this.refreshBendDimensions()
    return
  endif

  !!ce = !fmbdimRef
  NEW FMBDIM COPY PREV
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  !this.refreshBendDimensions()

  !refNos = !this.gridBendDimensions.getColumn(1)
  !index = !refNos.findFirst(!!ce.refNo.string())
  if !index.set() then
    !this.gridBendDimensions.selectRow(!index)
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      gridBendDimensionsBeforeCellUpdate
--
-- Description: called before updating the bend dimension
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridBendDimensionsBeforeCellUpdate(!args is ARRAY)

  !row = !this.gridBendDimensions.getRow(!args[1])
  !fmbdimRef = !row[1].dbRef()
  handle ANY
    !fmbdimRef = object DBREF()
  endhandle

  if !fmbdimRef.unset() then
    !!alert.error('Cannot get the selected FMBEND')
    !this.refreshBendDimensions()
    return
  endif

  !attValue = !args[0].real()
  handle ANY
    !!alert.error('Cannot convert string to REAL')
    !args[3] = false
    return
  endhandle

  if !attValue.unset() then
    !attValue = 0
  elseif !attValue.lt(0) then
    !!alert.error('Invalid value')
    !args[3] = false
    return
  endif

  if !args[2].eq('OD') then
    if !attValue.eq(0) then
      !!alert.error('Invalid OD')
      !args[3] = false
      return
    endif
    !attName = 'OD'
    -- Fix Issue 96530
    !attValue = !!comConvertUnknownValue(!attValue, !!pfContext.odWallRadiusFmt.units)
    --//
  elseif !args[2].eq('WThickness') then
    !attName = 'WThickness'
    -- Fix Issue 96530
    !attValue = !!comConvertUnknownValue(!attValue, !!pfContext.odWallRadiusFmt.units)
    --//
  elseif !args[2].eq('PIP') then
    !attName = 'benpip'
  elseif !args[2].eq('PIL') then
    !attName = 'benpil'
  elseif !args[2].eq('PIF') then
    !attName = 'benpif'
  elseif !args[2].eq('MLF') then
    !attName = 'benmlf'
  elseif !args[2].eq('Grip') then
    !attName = 'Grip'
  elseif !args[2].eq('MLL') then
    !attName = 'benmll'
  elseif !args[2].eq('BRatio') then
    !attName = 'bRadius'
  elseif !args[2].eq('PIR') then
    !attName = 'benpir'
  endif

  !fmbdimRef.attribute(!attName) = !attValue
  handle ANY
    !!alert.error(!!error.text)
    !args[3] = false
    return
  endhandle

  if !attName.eq('OD') then
    if !fmbdimRef.od.eq(0) then
      !fmbdimRef.bRadius = 0
    else
      !fmbdimRef.bRadius = !fmbdimRef.benpir / !fmbdimRef.od
    endif
  elseif !attName.eq('bRadius') then
    if !fmbdimRef.od.eq(0) then
      !fmbdimRef.benpir = 0
    else
      !bendpir = !fmbdimRef.bRadius * !fmbdimRef.od
      !fmbdimRef.benpir = !bendpir.value().string(!!distanceFMT).real()
    endif
  elseif !attName.eq('benpir') then
    if !fmbdimRef.od.eq(0) then
      !fmbdimRef.bRadius = 0
    else
      !fmbdimRef.bRadius = !fmbdimRef.benpir / !fmbdimRef.od
    endif
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      gridBendDimensionsAfterCellUpdate
--
-- Description: called after updating the bend dimension
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridBendDimensionsAfterCellUpdate(!args is ARRAY)

  !fmbdimRef = !this.gridBendDimensions.getCell(!args[0], 'REFNO').dbRef()
  handle ANY
    !fmbdimRef = object DBREF()
  endhandle

  if !fmbdimRef.unset() then
    !!alert.error('Cannot get the selected FMBDIM')
    !this.refreshBendDimensions()
    return
  endif

  !this.gridBendDimensions.allGridEvents(false)
  if !args[1].eq('OD') then
    !this.gridBendDimensions.setCellValue(!args[0], !args[1], !!pfContext.formatOD(!fmbdimRef.od))
    !this.gridBendDimensions.setCellValue(!args[0], 'BRatio', !!pfContext.formatBendRadiusRatio(!fmbdimRef.bRadius))
  elseif !args[1].eq('WThickness') then
    !this.gridBendDimensions.setCellValue(!args[0], !args[1], !!pfContext.formatWallThickness(!fmbdimRef.wThickness))
  elseif !args[1].eq('PIP') then
    !this.gridBendDimensions.setCellValue(!args[0], !args[1], !fmbdimRef.benpip.string(!!distanceFmt))
  elseif !args[1].eq('PIF') then
    !this.gridBendDimensions.setCellValue(!args[0], !args[1], !fmbdimRef.benpif.string(!!distanceFmt))
  elseif !args[1].eq('PIL') then
    !this.gridBendDimensions.setCellValue(!args[0], !args[1], !fmbdimRef.benpil.string(!!distanceFmt))
  elseif !args[1].eq('MLF') then
    !this.gridBendDimensions.setCellValue(!args[0], !args[1], !fmbdimRef.benmlf.string(!!distanceFmt))
  elseif !args[1].eq('Grip') then
    !this.gridBendDimensions.setCellValue(!args[0], !args[1], !fmbdimRef.grip.string(!!distanceFmt))
  elseif !args[1].eq('MLL') then
    !this.gridBendDimensions.setCellValue(!args[0], !args[1], !fmbdimRef.benmll.string(!!distanceFmt))
  elseif !args[1].eq('BRatio') or !args[1].eq('PIR') then
    !this.gridBendDimensions.setCellValue(!args[0], 'BRatio', !!pfContext.formatBendRadiusRatio(!fmbdimRef.bRadius))
    !this.gridBendDimensions.setCellValue(!args[0], 'PIR', !fmbdimRef.benpir.string(!!distanceFmt))
  endif
  --Refreshing the grid after the update
  !this.refreshBendDimensions()
  !this.gridBendDimensions.allGridEvents(true)

endmethod

--------------------------------------------------------------------------------
--
-- Method:      refreshBendCollisionPlanes
--
-- Description: refresh the collision plane grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .refreshBendCollisionPlanes()
  using namespace 'Aveva.Pdms.Presentation'

  !rows = object ARRAY()

  !fmbendRef = !this.optBendMachine.selection().dbRef()
  handle ANY
    !!alert.error('Cannot get the selected FMBEND')
    !this.onFabricationMachineGroupChanged()
    return
  endhandle

  if !fmbendRef.set() then
    !fmbplnRefs = !!collectAllFor('FMBPLN', 'ACTTYPE EQ |FMBPLN|', !fmbendRef)
    do !fmbplnRef values !fmbplnRefs
      !row = object ARRAY()
      !row[1] = !fmbplnRef.refNo.string()
      !row[2] = !fmbplnRef.minPlnPosition.east.string(!!distanceFmt)
      !row[3] = !fmbplnRef.minPlnPosition.north.string(!!distanceFmt)
      !row[4] = !fmbplnRef.minPlnPosition.up.string(!!distanceFmt)
      !row[5] = !fmbplnRef.maxPlnPosition.east.string(!!distanceFmt)
      !row[6] = !fmbplnRef.maxPlnPosition.north.string(!!distanceFmt)
      !row[7] = !fmbplnRef.maxPlnPosition.up.string(!!distanceFmt)
      !rows.append(!row)
    enddo
  endif

  !titles = object ARRAY()
  !titles.append('REFNO')
  !titles.append('X Min')
  !titles.append('Y Min')
  !titles.append('Z Min')
  !titles.append('X Max')
  !titles.append('Y Max')
  !titles.append('Z Max')

  !ds = object NETDATASOURCE('Bending Collision Planes', !titles, !rows, 'Bending Collision Planes')
  !this.gridBendCollisionPlanes.bindToDataSource(!ds)
  !this.gridBendCollisionPlanes.setColumnVisibility('REFNO', false)

  do !i indices !titles
    skip if !i.eq(!titles.size())
    !this.gridBendCollisionPlanes.setColumnTextAlignment(!titles[!i], 'RIGHT')
  enddo
  if !this.firstTimeBendCollisionPlanes then
    !this.firstTimeBendCollisionPlanes = false
    !this.gridBendCollisionPlanes.autoFitColumns()
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      createBendCollisionPlane
--
-- Description: create a new collision plane element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .createBendCollisionPlane()

  !fmbendRef = !this.optBendMachine.selection().dbRef()
  handle ANY
    !fmbendRef = object DBREF()
  endhandle

  if !fmbendRef.unset() then
    !!alert.error('Cannot get the selected FMBEND')
    !this.onFabricationMachineGroupChanged()
    return
  endif

  !rowTags = !this.gridBendCollisionPlanes.getSelectedRowTags()
  if !rowTags.empty() then
    !!ce = !fmbendRef
    LAST FMBPLN
    handle ANY
      -- dummy
    endhandle
  else
    -- Fix for Issue 94907 (SI-56257)
    -- create after the last selected element
    !rowTag = !rowTags.last()
    !refNo = !this.gridBendCollisionPlanes.getCell(!rowTag, 'REFNO')
    !fmbplnRef = !refNo.dbRef()
    handle ANY
      !!alert.error('Cannot get the selected FMBPLN')
      !this.refreshBendCollisionPlanes()
      return
    endhandle

    !!ce = !fmbplnRef
  endif

  NEW FMBPLN
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  using namespace  'Aveva.Pdms.Presentation'
  if (!rowTags.empty().not()) then
    !this.rowSelection(!this.gridBendCollisionPlanes, !refNo.dbRef())
  endif

  !fmbplnRef = !!ce
  !fmbplnRef.minPlnPosition = object POSITION('X 0 Y 0 Z 0')
  !fmbplnRef.maxPlnPosition = object POSITION('X 1000mm Y 0 Z 1000mm')

  !row = object ARRAY()
  !row[1] = !fmbplnRef.refNo.string()
  !row[2] = !fmbplnRef.minPlnPosition.east.string(!!distanceFmt)
  !row[3] = !fmbplnRef.minPlnPosition.north.string(!!distanceFmt)
  !row[4] = !fmbplnRef.minPlnPosition.up.string(!!distanceFmt)
  !row[5] = !fmbplnRef.maxPlnPosition.east.string(!!distanceFmt)
  !row[6] = !fmbplnRef.maxPlnPosition.north.string(!!distanceFmt)
  !row[7] = !fmbplnRef.maxPlnPosition.up.string(!!distanceFmt)
  !this.gridBendCollisionPlanes.addRow(!row)
  !this.gridBendCollisionPlanes.moveSelectedRowsDown()
  !this.gridBendCollisionPlanes.clearRowSelection()
  --!this.gridBendCollisionPlanes.selectRow(!this.gridBendCollisionPlanes.getNumberRows())

  --!this.refreshBendCollisionPlanes()

  !refNos = !this.gridBendCollisionPlanes.getColumn('REFNO')
  !index = !refNos.findFirst(!fmbplnRef.refNo.string())
  if !index.set() then
    !this.gridBendCollisionPlanes.selectRow(!index)
  endif

endmethod

