--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  isValidStretchFactor(REAL,REAL,BOOLEAN) REAL                check if the given stretch factors are valid or not
--  rowSelection(NETGRIDCONTROL,DBREF) -                   used for row selection
--
---------------------------------------------------------------------------------
import 'GridControl'
handle any
endhandle

import 'PmlFileBrowser'
handle any
endhandle

setup form !!pfFabMachineMgr dialog resizable varchars

  using namespace 'Aveva.Pdms.Presentation'

  !this.formTitle       = 'Fabrication Machine Manager'
  !this.initCall        = '!this.initialize()'
  !this.quitCall        = '!this.quit()'
  !this.firstShownCall  = '!this.firstShown()'

  frame .frameOptions 'Options' anchor t+l+r width 72
    button .btnCE  'CE' tooltip 'Select Current Element' callback |!this.selectCurrent(!!ce)| width 8
    toggle .togName 'Display Name/Description' at x 13 ymin.btnCE callback '!this.changeNameDescription()'

    option .optMachineWorld 'Fabrication World:' at xmin.btnCE ymax.btnCE+0.2 anchor t+l+r tagwid 13 callback '!this.onFabricationMachineWorldChanged()' tooltip 'Select an existing Fabrication Machine World' width 56
    button .btnCreateMachineWorld at xmax.optMachineWorld+0.2 ymin.optMachineWorld anchor t+r pixmap callback |!this.createElement('FMWL')| width 16 height 16

    option .optMachineGroup 'Fabrication Group:' at xmin.optMachineWorld ymax.optMachineWorld+0.1 anchor t+l+r tagwid 13 callback '!this.onFabricationMachineGroupChanged()' tooltip 'Select an existing Fabrication Machine Group' width 56
    button .btnCreateMachineGroup at xmax.optMachineGroup+0.2 ymin.optMachineGroup anchor t+r pixmap callback |!this.createElement('FMGRP')| width 16 height 16

    option .optMachineType 'Machine Type:' at xmax.optMachineWorld ymax.optMachineGroup+0.1 tagwid 13 anchor t+l+r at xmin.optMachineWorld callback '!this.onMachineTypeChanged()' tooltip 'Fabrication machine type' width 56
  exit

  frame .frameBendMachine 'Bending Machine' anchor all at xmin.frameOptions ymax.frameOptions+0.2 width 72 height 25

    option .optBendMachine 'Bending Machine:' anchor t+l+r tagwid 13 callback '!this.onFabricationMachineChanged()' tooltip 'Current machine selection' width 56
    button .btnCreateBendMachine at xmax.optBendMachine+0.2 ymin.optBendMachine anchor t+r pixmap callback |!this.createElement('FMBEND')| width 16 height 16

    text .txtStfProportional 'STF Proportional:' at xmin.optBendMachine ymax.optBendMachine+0.2 tagwid 13 callback '!this.applyAttributeChanges(|BENDING|)' width 10 is STRING
    text .txtStfConstant 'STF Constant:' at xmin.optBendMachine ymax.txtStfProportional+0.1 tagwid 13 callback '!this.applyAttributeChanges(|BENDING|)' width 10 is STRING

    option .optBendDirection 'Bending Direction:' at xmax.txtStfProportional+0.5 ymin.txtStfProportional callback '!this.applyAttributeChanges(|BENDING|)' tagwid 13 width 10
    option .optBendRotation 'Pipe Rotation:' at xmin.optBendDirection ymin.txtStfConstant callback '!this.applyAttributeChanges(|BENDING|)' tagwid 13 width 10

    -- Fix for Issue 94962 (SI-56457)
    -- toggle .togCompensate 'Compensate' at xmax.optBendDirection+1 ymin.optBendDirection callback '!this.applyAttributeChanges(|BENDING|)'
    -- Fix for Issue 94963 (SI-56458), Stepwise -> Incremental
    toggle .togStepwiseSpringback 'Incremental Springback' at xmax.optBendDirection+1 ymin.optBendDirection callback '!this.applyAttributeChanges(|BENDING|)'
    toggle .togAdjustMll 'MLL to include length of last bend' at xmin.togStepwiseSpringback ymin.togStepwiseSpringback + 1 callback '!this.adjustMll(|BENDING|)'

    button .btnBendLegend at xmax.optBendMachine - 2 ymax.optBendMachine + 3.3 anchor t+r pixmap callback '!this.showLegend(|FMBEND|)' wid 16 hei 16

    frame .frameBendingTabs tabset anchor all at xmin.optBendMachine ymax.togStepwiseSpringback+2.2 width 72 height 20
      frame .frameBendingDimensions panel 'Bending Dimensions' anchor all at xmin.optBendMachine width 72 height 20
        container .conBendDimensions nobox PMLNETCONTROL 'Table items' anchor all width 72 height 20
      exit

      frame .frameBendCollisionPlanes panel 'Collision Planes' anchor all at xmin.optBendMachine width 72 height 20
        container .conBendCollisionPlanes nobox PMLNETCONTROL 'Table items' anchor l+t+r width 72 height 8
        frame .frameCollisionPlaneView panel at xmin.conBendCollisionPlanes ymax.conBendCollisionPlanes+0.1 width 72 height 12
          view .view volume
            limits auto
            isometric 3
          exit
        exit
      exit
      frame .frameBendStretch panel 'Stretch' anchor all at xmin.optBendMachine width 72 height 20
        container .conBendStretchData nobox PMLNETCONTROL 'Table items' anchor all width 72 height 20
      exit
      frame .frameSpringback panel 'Springback' anchor all at xmin.optBendMachine width 72 height 20
        container .conBendSpringbackData nobox PMLNETCONTROL 'Table items' anchor all width 72 height 20
      exit
    exit
    button .btnReportBendMachine 'Save Report...' linklabel at xmin.optBendMachine ymax.frameBendingTabs+0.1 anchor b+l callback |!this.saveReport('FMBEND')| tooltip 'Save Report'
  exit

  frame .frameWeldMachine 'Welding Machine' anchor all at xmin.frameOptions ymax.frameOptions+0.2 width 72 height 25
    option .optWeldMachine 'Welding Machine:' anchor t+l+r tagwid 13 callback '!this.onFabricationMachineChanged()' width 56
    button .btnCreateWeldMachine at xmax.optWeldMachine +0.2 ymin.optWeldMachine anchor t+r pixmap callback |!this.createElement('FMWELD')| width 16 height 16 tooltip 'Create Welding Machine'

    frame .frameWeldOD 'Outer Diameter' anchor t+l at xmin.optWeldMachine ymax.optWeldMachine+0.2 width 20
      text .txtWeldMinOD 'Minimum:' tagwid 7 callback '!this.applyAttributeChanges(|WELDING|)' width 10 is STRING
      text .txtWeldMaxOD 'Maximum:' tagwid 7 at xmin.txtWeldMinOD ymax.txtWeldMinOD+0.1 callback '!this.applyAttributeChanges(|WELDING|)' width 10 is STRING
    exit

    frame .frameWeldPipeLength 'Length of Pipe' anchor t+l at xmax.frameWeldOD+0.7 ymin.frameWeldOD width 20
      text .txtWeldMinLP 'Minimum:' tagwid 7 callback '!this.applyAttributeChanges(|WELDING|)' width 10 is STRING
      text .txtWeldMaxLP 'Maximum:' tagwid 7 at xmin.txtWeldMinLP ymax.txtWeldMinLP+0.1 callback '!this.applyAttributeChanges(|WELDING|)' width 10 is STRING
    exit

    button .btnWeldLegend at xmax.optWeldMachine - 2 ymax.optWeldMachine + 3.3 anchor t+r pixmap callback '!this.showLegend(|FMWELD|)' wid 16 hei 16

    frame .frameWeldingTabs tabset anchor all at xmin.frameBendingTabs ymin.frameBendingTabs width 72 height 20
      frame .frameWeldableFlanges panel 'Weldable Flanges ' anchor all at xmin.optBendMachine width 72 height 20
        container .conWeldableFlangeSkey nobox PMLNETCONTROL 'Table items' anchor all width 72 height 20
      exit
      frame .frameWeldDimensions panel 'Welding Dimensions' anchor all at xmin.optBendMachine width 72 height 20
        container .conWeldDimensions nobox PMLNETCONTROL 'Table items' anchor all width 72 height 20
      exit
      frame .frameWeldConnections panel 'Weld Connections' anchor all at xmin.optBendMachine width 72 height 20
        container .conWeldConnections nobox PMLNETCONTROL 'Table items' anchor all width 72 height 20
      exit
    exit
    button .btnReportWeldMachine linklabel 'Save Report...'  at xmin.optBendMachine ymax.frameWeldingTabs+0.1 anchor b+l callback |!this.saveReport('FMWELD')| tooltip 'Save Report'
  exit

  frame .frameExtrusionMachine 'Extrusion Machine' anchor all at xmin.frameOptions ymax.frameOptions+0.2 width 72 height 25
    option .optExtrMachine 'Extrusion Machine:' anchor t+l+r tagwid 13 callback '!this.onFabricationMachineChanged()' width 56
    button .btnCreateExtrMachine at xmax.optExtrMachine+0.2 ymin.optExtrMachine anchor T+R pixmap callback |!this.createElement('FMEXTR')| width 16 height 16 tooltip 'Create Extrusion Machine'

    button .btnExtrLegend at xmax.optExtrMachine - 2 ymax.optExtrMachine + 3.3 anchor t+r pixmap callback '!this.showLegend(|FMEXTR|)' wid 16 hei 16

    frame .frameExtrusionTabs tabset anchor all at xmin.frameBendingTabs ymin.frameBendingTabs width 72 height 20
      frame .frameExtrDimensions panel 'Extrusion Dimensions' anchor all at xmin.optBendMachine width 72 height 20
        container .conExtrDimensions nobox PMLNETCONTROL 'Table items' anchor all width 72 height 20
      exit

      frame .frameMinExtrusionDistance panel 'Dist. between Extrusions' anchor all at xmin.optBendMachine width 72 height 20
        container .conMinExtrDistance nobox PMLNETCONTROL' Table items' anchor all width 72 height 20
      exit
    exit
    button .btnReportExtrMachine linklabel 'Save Report...'  at xmin.optBendMachine ymax.frameExtrusionTabs+0.1 anchor b+l callback |!this.saveReport('FMEXTR')| tooltip 'Save Report'
  exit

  -----Member Variables-----

  -- Local View Drawlist
  member .drawlist is DRAWLIST

  -- Grid control members
  member .gridBendDimensions        is NETGRIDCONTROL
  member .gridBendCollisionPlanes   is NETGRIDCONTROL
  member .gridBendStretchData       is NETGRIDCONTROL
  member .gridBendSpringbackData    is NETGRIDCONTROL
  member .gridWeldableFlangeSkey    is NETGRIDCONTROL
  member .gridWeldDimensions        is NETGRIDCONTROL
  member .gridWeldConnections       is NETGRIDCONTROL
  member .gridExtrDimensions        is NETGRIDCONTROL
  member .gridMinExtrDistance       is NETGRIDCONTROL

  member .materials                 is ARRAY
  member .firstTimeBend             is BOOLEAN
  member .firstTimeBendCollisionPlanes   is BOOLEAN
  member .firstTimeStretchData      is BOOLEAN
  member .firstTimeSpringbackData   is BOOLEAN
  member .firstTimeWeldFlangeSkey   is BOOLEAN
  member .firstTimeWeld             is BOOLEAN
  member .firstWeldConnections      is BOOLEAN
  member .firstTimeExtr             is BOOLEAN
  member .firstTimeMinExtrDistance  is BOOLEAN
exit

--------------------------------------------------------------------------------
--
-- Method:      pfFabMachineMgr
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfFabMachineMgr()

  using namespace 'Aveva.Pdms.Presentation'

  --!uvalidRefs = !!collectAllFor('UVALID', '', /PFBendingDirection )
  --do !uvalidRef values !uvalidRefs
  !this.optBendDirection.add('Left', 'LEFT')
  !this.optBendDirection.add('Right', 'RIGH')
  !this.optBendDirection.add('Up', 'UP')
  --enddo

  --!uvalidRefs = !!collectAllFor('UVALID', '', /PFBendingRotation )
  --do !uvalidRef values !uvalidRefs
  !this.optBendRotation.add('Clockwise', 'CLOC')
  !this.optBendRotation.add('Counterclockwise', 'CNTC')
  !this.optBendRotation.add('Both', 'BOTH')
  --enddo

  -- Default to element name as description often unset
  !this.togName.val = true

  -- Define Machine Type drop down list
  !this.optMachineType.add('Bending Machine',   'BENDING')
  !this.optMachineType.add('Welding Machine',   'WELDING')
  !this.optMachineType.add('Extrusion Machine', 'EXTRUSION')

  -- Pixmap
  !pngCreate = !!pml.getPathName('ad_t_002.png')
  !this.btnCreateMachineWorld.addPixmap(!pngCreate)
  !this.btnCreateMachineGroup.addPixmap(!pngCreate)
  !this.btnCreateBendMachine.addPixmap(!pngCreate)
  !this.btnCreateWeldMachine.addPixmap(!pngCreate)
  !this.btnCreateExtrMachine.addPixmap(!pngCreate)

  !pngInfo = !!pml.getPathName('info16.png')
  !this.btnBendLegend.addPixmap(!pngInfo)
  !this.btnWeldLegend.addPixmap(!pngInfo)
  !this.btnExtrLegend.addPixmap(!pngInfo)

  --Create Grid Controls
  !this.gridBendDimensions      = object NETGRIDCONTROL()
  !this.gridBendCollisionPlanes = object NETGRIDCONTROL()
  !this.gridBendStretchData     = object NETGRIDCONTROL()
  !this.gridBendSpringbackData  = object NETGRIDCONTROL()
  !this.gridWeldableFlangeSkey  = object NETGRIDCONTROL()
  !this.gridWeldDimensions      = object NETGRIDCONTROL()
  !this.gridWeldConnections     = object NETGRIDCONTROL()
  !this.gridExtrDimensions      = object NETGRIDCONTROL()
  !this.gridMinExtrDistance     = object NETGRIDCONTROL()

  --Make the associations to call the functions to pop-up the menus.
  !this.gridBendDimensions.addEventHandler('OnPopup',       !this, 'showBendDimensionContextMenu')
  !this.gridBendCollisionPlanes.addEventHandler('OnPopup',  !this, 'showBendCollisionPlaneContextMenu')
  !this.gridBendStretchData.addEventHandler('OnPopup',      !this, 'showBendStretchContextMenu')
  !this.gridBendSpringbackData.addEventHandler('OnPopup',   !this, 'showBendSpringbackContextMenu')
  !this.gridWeldableFlangeSkey.addEventHandler('OnPopup',   !this, 'showWeldableFlangeSkeyContextMenu')
  !this.gridWeldDimensions.addEventHandler('OnPopup',       !this, 'showWeldDimensionContextMenu')
  !this.gridWeldConnections.addEventHandler('OnPopup',      !this, 'showWeldConnectionContextMenu')
  !this.gridExtrDimensions.addEventHandler('OnPopup',       !this, 'showExtrusionDimensionContextMenu')
  !this.gridMinExtrDistance.addEventHandler('OnPopup',      !this, 'showMinExtrusionDistanceContextMenu')

  --Define Grid Options
  !this.gridBendDimensions.fixedHeaders(false)
  !this.gridBendDimensions.columnExcelFilter(true)
  !this.gridBendDimensions.outlookGroupStyle(false)
  !this.gridBendDimensions.editableGrid(true)
  !this.gridBendDimensions.autofitcolumns()
  !this.gridBendDimensions.setAlternateRowColor('WHITE')
  !this.gridBendDimensions.headerSort(true)

  !this.gridBendCollisionPlanes.fixedHeaders(false)
  !this.gridBendCollisionPlanes.columnExcelFilter(true)
  !this.gridBendCollisionPlanes.outlookGroupStyle(false)
  !this.gridBendCollisionPlanes.editableGrid(true)
  !this.gridBendCollisionPlanes.autofitcolumns()
  !this.gridBendCollisionPlanes.setAlternateRowColor('WHITE')
  !this.gridBendCollisionPlanes.headerSort(true)
  !this.gridBendCollisionPlanes.addEventHandler('AfterSelectChange',  !this, 'gridBendCollisionPlanesAfterSelectChange')
  !this.gridBendCollisionPlanes.addEventHandler('BeforeCellActivate', !this, 'gridBendCollisionPlanesBeforeCellActivate')

  !this.gridBendStretchData.fixedHeaders(false)
  !this.gridBendStretchData.columnExcelFilter(true)
  !this.gridBendStretchData.outlookGroupStyle(false)
  !this.gridBendStretchData.editableGrid(true)
  !this.gridBendStretchData.autofitcolumns()
  !this.gridBendStretchData.setAlternateRowColor('WHITE')
  !this.gridBendStretchData.headerSort(true)

  !this.gridBendSpringbackData.fixedHeaders(false)
  !this.gridBendSpringbackData.columnExcelFilter(true)
  !this.gridBendSpringbackData.outlookGroupStyle(false)
  !this.gridBendSpringbackData.editableGrid(true)
  !this.gridBendSpringbackData.autofitcolumns()
  !this.gridBendSpringbackData.setAlternateRowColor('WHITE')
  !this.gridBendSpringbackData.headerSort(true)

  !this.gridWeldableFlangeSkey.fixedHeaders(false)
  !this.gridWeldableFlangeSkey.columnExcelFilter(true)
  !this.gridWeldableFlangeSkey.outlookGroupStyle(false)
  !this.gridWeldableFlangeSkey.editableGrid(true)
  !this.gridWeldableFlangeSkey.autofitcolumns()
  !this.gridWeldableFlangeSkey.setAlternateRowColor('WHITE')
  !this.gridWeldableFlangeSkey.headerSort(true)

  !this.gridWeldDimensions.fixedHeaders(false)
  !this.gridWeldDimensions.columnExcelFilter(true)
  !this.gridWeldDimensions.outlookGroupStyle(false)
  !this.gridWeldDimensions.editableGrid(true)
  !this.gridWeldDimensions.autofitcolumns()
  !this.gridWeldDimensions.setAlternateRowColor('WHITE')
  !this.gridWeldDimensions.headerSort(true)

  !this.gridWeldConnections.fixedHeaders(false)
  !this.gridWeldConnections.columnExcelFilter(true)
  !this.gridWeldConnections.outlookGroupStyle(false)
  !this.gridWeldConnections.editableGrid(true)
  !this.gridWeldConnections.autofitcolumns()
  !this.gridWeldConnections.setAlternateRowColor('WHITE')
  !this.gridWeldConnections.headerSort(true)

  !this.gridExtrDimensions.fixedHeaders(false)
  !this.gridExtrDimensions.columnExcelFilter(true)
  !this.gridExtrDimensions.outlookGroupStyle(false)
  !this.gridExtrDimensions.editableGrid(true)
  !this.gridExtrDimensions.autofitcolumns()
  !this.gridExtrDimensions.setAlternateRowColor('WHITE')
  !this.gridExtrDimensions.headerSort(true)

  !this.gridMinExtrDistance.fixedHeaders(false)
  !this.gridMinExtrDistance.columnExcelFilter(true)
  !this.gridMinExtrDistance.outlookGroupStyle(false)
  !this.gridMinExtrDistance.editableGrid(true)
  !this.gridMinExtrDistance.autofitcolumns()
  !this.gridMinExtrDistance.setAlternateRowColor('WHITE')
  !this.gridMinExtrDistance.headerSort(true)

  --Add the grid controls to their containers.
  !this.conBendDimensions.control       = !this.gridBendDimensions.handle()
  !this.conBendCollisionPlanes.control  = !this.gridBendCollisionPlanes.handle()
  !this.conBendStretchData.control      = !this.gridBendStretchData.handle()
  !this.conBendSpringbackData.control   = !this.gridBendSpringbackData.handle()
  !this.conWeldableFlangeSkey.control   = !this.gridWeldableFlangeSkey.handle()
  !this.conWeldDimensions.control       = !this.gridWeldDimensions.handle()
  !this.conWeldConnections.control      = !this.gridWeldConnections.handle()
  !this.conExtrDimensions.control       = !this.gridExtrDimensions.handle()
  !this.conMinExtrDistance.control      = !this.gridMinExtrDistance.handle()

  -- Tooltips
  !this.btnCE.setTooltip('Select Current Element')
  !this.btnCreateMachineWorld.setTooltip('Create Fabrication Machine World')
  !this.btnCreateMachineGroup.setTooltip('Create Fabrication Machine Group')
  !this.btnCreateBendMachine.setTooltip('Create Bending Machine')
  !this.btnCreateWeldMachine.setTooltip('Create Welding Machine')
  !this.btnCreateExtrMachine.setTooltip('Create Extrusion Machine')

  !this.txtStfConstant.validateCall = '!this.validateSTFC('
  !this.txtStfProportional.validateCall = '!this.validateSTFP('

  !this.txtWeldMinOD.validateCall = '!this.validateWeldPipeOD('
  !this.txtWeldMaxOD.validateCall = '!this.validateWeldPipeOD('
  !this.txtWeldMinLP.validateCall = '!this.validateWeldPipeLength('
  !this.txtWeldMaxLP.validateCall = '!this.validateWeldPipeLength('

  !this.gridBendDimensions.addEventHandler('BeforeCellUpdate',      !this, 'gridBendDimensionsBeforeCellUpdate')
  !this.gridBendDimensions.addEventHandler('AfterCellUpdate',       !this, 'gridBendDimensionsAfterCellUpdate')
  !this.gridBendCollisionPlanes.addEventHandler('BeforeCellUpdate', !this, 'gridBendCollisionPlanesBeforeCellUpdate')
  !this.gridBendCollisionPlanes.addEventHandler('AfterCellUpdate',  !this, 'gridBendCollisionPlanesAfterCellUpdate')
  !this.gridBendStretchData.addEventHandler('BeforeCellUpdate',     !this, 'gridBendStretchDataBeforeCellUpdate')
  !this.gridBendStretchData.addEventHandler('AfterCellUpdate',      !this, 'gridBendStretchDataAfterCellUpdate')
  !this.gridBendSpringbackData.addEventHandler('BeforeCellUpdate',  !this, 'gridBendSpringbackDataBeforeCellUpdate')
  !this.gridBendSpringbackData.addEventHandler('AfterCellUpdate',   !this, 'gridBendSpringbackDataAfterCellUpdate')
  !this.gridWeldableFlangeSkey.addEventHandler('BeforeCellUpdate',  !this, 'gridWeldableFlangeSkeyBeforeCellUpdate')
  !this.gridWeldableFlangeSkey.addEventHandler('AfterCellUpdate',   !this, 'gridWeldableFlangeSkeyAfterCellUpdate')
  !this.gridWeldDimensions.addEventHandler('BeforeCellUpdate',      !this, 'gridWeldDimensionsBeforeCellUpdate')
  !this.gridWeldDimensions.addEventHandler('AfterCellUpdate',       !this, 'gridWeldDimensionsAfterCellUpdate')
  !this.gridWeldConnections.addEventHandler('BeforeCellUpdate',     !this, 'gridWeldConnectionsBeforeCellUpdate')
  !this.gridWeldConnections.addEventHandler('AfterCellUpdate',      !this, 'gridWeldConnectionsAfterCellUpdate')
  !this.gridExtrDimensions.addEventHandler('BeforeCellUpdate',      !this, 'gridExtrDimensionsBeforeCellUpdate')
  !this.gridExtrDimensions.addEventHandler('AfterCellUpdate',       !this, 'gridExtrDimensionsAfterCellUpdate')
  !this.gridMinExtrDistance.addEventHandler('BeforeCellUpdate',     !this, 'gridMinExtrDistanceBeforeCellUpdate')
  !this.gridMinExtrDistance.addEventHandler('AfterCellUpdate',      !this, 'gridMinExtrDistanceAfterCellUpdate')

  !menu = !this.newMenu('menuEditWorld')
  !menu.add('CALLBACK', 'Modify World', '!this.modifyElement(!this.optMachineWorld, |FMWL|)',               'MODIFY')
  !menu.add('CALLBACK', 'Delete World', '!this.deleteElement(!this.optMachineWorld)',                       'DELETE')
  !this.optMachineWorld.setPopup(!menu)

  !menu = !this.newMenu('menuEditGroup')
  !menu.add('CALLBACK', 'Modify Group', '!this.modifyElement(!this.optMachineGroup, |FMGRP|)',              'MODIFY')
  !menu.add('CALLBACK', 'Delete Group', '!this.deleteElement(!this.optMachineGroup)',                       'DELETE')
  !this.optMachineGroup.setPopup(!menu)

  !menu = !this.newMenu('menuEditBend')
  !menu.add('CALLBACK', 'Modify Bending Machine', '!this.modifyElement(!this.optBendMachine, |FMBEND|)',    'MODIFY')
  !menu.add('CALLBACK', 'Delete Bending Machine', '!this.deleteElement(!this.optBendMachine)',              'DELETE')
  !this.optBendMachine.setPopup(!menu)

  !menu = !this.newMenu('menuEditWeld')
  !menu.add('CALLBACK', 'Modify Welding Machine', '!this.modifyElement(!this.optWeldMachine, |FMWELD|)',    'MODIFY')
  !menu.add('CALLBACK', 'Delete Welding Machine', '!this.deleteElement(!this.optWeldMachine)',              'DELETE')
  !this.optWeldMachine.setPopup(!menu)

  !menu = !this.newMenu('menuEditExtr')
  !menu.add('CALLBACK', 'Modify Extrusion Machine', '!this.modifyElement(!this.optExtrMachine, |FMEXTR|)', 'MODIFY')
  !menu.add('CALLBACK', 'Delete Extrusion Machine', '!this.deleteElement(!this.optExtrMachine)',            'DELETE')
  !this.optExtrMachine.setPopup(!menu)

  !menu = !this.newMenu('menuBendDimension')
  !menu.add('CALLBACK', 'Create',             '!this.createBendDimension()',                                    'CREATE')
  !menu.add('CALLBACK', 'Copy',               '!this.copyBendDimension()',                                      'COPY')
  !menu.add('CALLBACK', 'Delete',             '!this.deleteGridSelectedRows(!this.gridBendDimensions)',         'DELETE')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.gridBendDimensions, ||, |Save As|)',       'EXCEL')
  !menu.add('CALLBACK', 'Print Preview...',   '!this.gridBendDimensions.printPreview()',                        'PRINT')

  !menu = !this.newMenu('menuBendCollisionPlane')
  !menu.add('CALLBACK', 'Create',             '!this.createBendCollisionPlane()',                               'CREATE')
  !menu.add('CALLBACK', 'Copy',               '!this.copyBendCollisionPlane()',                                 'COPY')
  !menu.add('CALLBACK', 'Delete',             '!this.deleteGridSelectedRows(!this.gridBendCollisionPlanes)',    'DELETE')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.gridBendCollisionPlanes, ||, |Save As|)',  'EXCEL')
  !menu.add('CALLBACK', 'Print Preview...',   '!this.gridBendCollisionPlanes.printPreview()',                   'PRINT')

  !menu = !this.newMenu('menuBendStretch')
  !menu.add('CALLBACK', 'Create',             '!this.createBendStretchData()',                                  'CREATE')
  !menu.add('CALLBACK', 'Copy',               '!this.copyBendStretchData()',                                    'COPY')
  !menu.add('CALLBACK', 'Delete',             '!this.deleteGridSelectedRows(!this.gridBendStretchData)',        'DELETE')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.gridBendStretchData, ||, |Save As|)',      'EXCEL')
  !menu.add('CALLBACK', 'Print Preview...',   '!this.gridBendStretchData.printPreview()',                       'PRINT')

  !menu = !this.newMenu('menuBendSpringback')
  !menu.add('CALLBACK', 'Create',             '!this.createBendSpringbackData()',                               'CREATE')
  !menu.add('CALLBACK', 'Copy',               '!this.copyBendSpringbackData()',                                 'COPY')
  !menu.add('CALLBACK', 'Delete',             '!this.deleteGridSelectedRows(!this.gridBendSpringbackData)',     'DELETE')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.gridBendSpringbackData, ||, |Save As|)',   'EXCEL')
  !menu.add('CALLBACK', 'Print Preview...',   '!this.gridBendSpringbackData.printPreview()',                    'PRINT')

  !menu = !this.newMenu('menuWeldableFlangeSkey')
  !menu.add('CALLBACK', 'Create',             '!this.createWeldableFlangeSkey()',                               'CREATE')
  !menu.add('CALLBACK', 'Copy',               '!this.copyWeldableFlangeSkey()',                                 'COPY')
  !menu.add('CALLBACK', 'Delete',             '!this.deleteGridSelectedRows(!this.gridWeldableFlangeSkey)',     'DELETE')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.gridWeldSkeyData, ||, |Save As|)',         'EXCEL')
  !menu.add('CALLBACK', 'Print Preview...',   '!this.gridWeldableFlangeSkey.printPreview()',                    'PRINT')

  !menu = !this.newMenu('menuWeldDimension')
  !menu.add('CALLBACK', 'Create',             '!this.createWeldDimension()',                                    'CREATE')
  !menu.add('CALLBACK', 'Copy',               '!this.copyWeldDimension()',                                      'COPY')
  !menu.add('CALLBACK', 'Delete',             '!this.deleteGridSelectedRows(!this.gridWeldDimensions)',         'DELETE')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.gridWeldDimensions, ||, |Save As|)',       'EXCEL')
  !menu.add('CALLBACK', 'Print Preview...',   '!this.gridWeldDimensions.printPreview()',                        'PRINT')

  !menu = !this.newMenu('menuWeldConnection')
  !menu.add('CALLBACK', 'Create',             '!this.createWeldConnection()',                                   'CREATE')
  !menu.add('CALLBACK', 'Copy',               '!this.copyWeldConnection()',                                     'COPY')
  !menu.add('CALLBACK', 'Delete',             '!this.deleteGridSelectedRows(!this.gridWeldConnections)',        'DELETE')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.gridWeldConnections, ||, |Save As|)',      'EXCEL')
  !menu.add('CALLBACK', 'Print Preview...',   '!this.gridWeldConnections.printPreview()',                       'PRINT')

  !menu = !this.newMenu('menuExtrDimension')
  !menu.add('CALLBACK', 'Create',             '!this.createExtrusionDimension()',                               'CREATE')
  !menu.add('CALLBACK', 'Copy',               '!this.copyExtrusionDimension()',                                 'COPY')
  !menu.add('CALLBACK', 'Delete',             '!this.deleteGridSelectedRows(!this.gridExtrDimensions)',         'DELETE')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.gridExtrDimensions, ||, |Save As|)',       'EXCEL')
  !menu.add('CALLBACK', 'Print Preview...',   '!this.gridExtrDimensions.printPreview()',                        'PRINT')

  !menu = !this.newMenu('menuMinExtrDistance')
  !menu.add('CALLBACK', 'Create',             '!this.createMinExtrusionDistance()',                             'CREATE')
  !menu.add('CALLBACK', 'Copy',               '!this.copyMinExtrusionDistance()',                               'COPY')
  !menu.add('CALLBACK', 'Delete',             '!this.deleteGridSelectedRows(!this.gridMinExtrDistance)',   'DELETE')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.gridMinExtrDistance, ||, |Save As|)', 'EXCEL')
  !menu.add('CALLBACK', 'Print Preview...',   '!this.gridMinExtrDistance.printPreview()',                  'PRINT')


  !this.conBendDimensions.popup       = !this.menuBendDimension
  !this.conBendCollisionPlanes.popup  = !this.menuBendCollisionPlane
  !this.conBendStretchData.popup      = !this.menuBendStretch
  !this.conBendSpringbackData.popup   = !this.menuBendSpringback
  !this.conWeldableFlangeSkey.popup   = !this.menuWeldableFlangeSkey
  !this.conWeldDimensions.popup       = !this.menuWeldDimension
  !this.conWeldConnections.popup      = !this.menuWeldConnection
  !this.conExtrDimensions.popup       = !this.menuExtrDimension
  !this.conMinExtrDistance.popup      = !this.menuMinExtrDistance

  -- Issue 95125 (SI-56508), Enhancement request on context menu in 3D view
  -- create popup menu for collision plane view
  !this.newMenu('viewPopup')
  !this.newMenu('mouseMenu')
  !this.newMenu('settingsMenu')
  !this.newMenu('sLookMenu')
  !this.newMenu('sPlanMenu')

  !this.viewPopup.add('menu', 'View Control',  'mouseMenu')
  !this.viewPopup.add('separator')
  !this.viewPopup.add('menu', 'Settings',  'settingsMenu')

  !this.mouseMenu.add('callback', 'Zoom  F2', '!!gphViews.doMenuAction(')
  !this.mouseMenu.add('callback', 'Pan  F3', '!!gphViews.doMenuAction(')
  !this.mouseMenu.add('callback', 'Rotate  F5', '!!gphViews.doMenuAction(')
  !this.mouseMenu.add('callback', 'Walk  F6', '!!gphViews.doMenuAction(')

  !this.settingsMenu.callback = '!!gphViews.graphicsToggles('
  !this.settingsMenu.add('toggle', 'Eye  F7', '!!gphViews.doMenuAction(')
  !this.settingsMenu.add('toggle', 'Shaded  F8', '!!gphViews.doMenuAction(')
  !this.settingsMenu.add('toggle', 'Borders  F9', '!!gphViews.doMenuAction(')
  !this.settingsMenu.add('toggle', 'Perspective  F4', '!!gphViews.doMenuAction(')
  -- Fix for Issue 94908 (SI-56253), background colour menu is added
  !this.settingsMenu.add('separator')
  !this.settingsMenu.add('callback', 'Background...',  '!!gphViews.colour(')

  !this.viewPopup.add('menu', 'Look',      'sLookMenu')
  !this.viewPopup.add('menu', 'Plan',      'sPlanMenu')
  !this.viewPopup.add('menu', 'Isometric', 'sIsometric')

  var !coordinate coordinate
  if !coordinate.eq('XYZ') then
    !this.sLookMenu.add('callback', ' X',       '!!gphViews.look(')
    !this.sLookMenu.add('callback', '-X',       '!!gphViews.look(')
    !this.sLookMenu.add('callback', ' Y',       '!!gphViews.look(')
    !this.sLookMenu.add('callback', '-Y',       '!!gphViews.look(')
    !this.sLookMenu.add('callback', ' Z',       '!!gphViews.look(')
    !this.sLookMenu.add('callback', '-Z',       '!!gphViews.look(')

    !this.sPlanMenu.add('callback', ' Y',       '!!gphViews.plan(')
    !this.sPlanMenu.add('callback', '-Y',       '!!gphViews.plan(')
    !this.sPlanMenu.add('callback', ' X',       '!!gphViews.plan(')
    !this.sPlanMenu.add('callback', '-X',       '!!gphViews.plan(')
  else
    !this.sLookMenu.add('callback', 'Up',          '!!gphViews.look(')
    !this.sLookMenu.add('callback', 'Down',        '!!gphViews.look(')
    !this.sLookMenu.add('callback', 'North',       '!!gphViews.look(')
    !this.sLookMenu.add('callback', 'South',       '!!gphViews.look(')
    !this.sLookMenu.add('callback', 'East',        '!!gphViews.look(')
    !this.sLookMenu.add('callback', 'West',        '!!gphViews.look(')

    !this.sPlanMenu.add('callback', 'North',      '!!gphViews.plan(')
    !this.sPlanMenu.add('callback', 'South',      '!!gphViews.plan(')
    !this.sPlanMenu.add('callback', 'East',       '!!gphViews.plan(')
    !this.sPlanMenu.add('callback', 'West',       '!!gphViews.plan(')
  endif

  !this.sIsometric.add('callback', 'One',         '!!gphViews.isometric(')
  !this.sIsometric.add('callback', 'Two',         '!!gphViews.isometric(')
  !this.sIsometric.add('callback', 'Three',       '!!gphViews.isometric(')
  !this.sIsometric.add('callback', 'Four',        '!!gphViews.isometric(')

  !this.view.setPopup(!this.viewPopup)
  !this.firstTimeBend = true
  !this.firstTimeBendCollisionPlanes = true
  !this.firstTimeStretchData = true
  !this.firstTimeSpringbackData = true
  !this.firstTimeWeldFlangeSkey = true
  !this.firstTimeWeld = true
  !this.firstWeldConnections = true
  !this.firstTimeExtr = true
  !this.firstTimeMinExtrDistance = true
endmethod


--------------------------------------------------------------------------------
--
-- Method:      initialize
--
-- Description: initialize form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .initialize()

  -- initialize pipe fabrication context
  !context = object PFCONTEXT()
  !context.globalInstance()

  -- create value list for weld connections ------------------------------------
  !connections = object ARRAY()
  !cocdesRefs = !!collectAllFor('COCDES', '', WORLD )
  do !cocdesRef values !cocdesRefs
    !connections.append(!cocdesRef.coconnection)
  enddo
  !this.gridWeldConnections.createValueList('CONNECTION', !connections)

  !this.firstTimeBend = true
  !this.firstTimeBendCollisionPlanes = true
  !this.firstTimeStretchData = true
  !this.firstTimeSpringbackData = true
  !this.firstTimeWeldFlangeSkey = true
  !this.firstTimeWeld = true
  !this.firstWeldConnections = true
  !this.firstTimeExtr = true
  !this.firstTimeMinExtrDistance = true
  -- refresh fabrication world, group and machines------------------------------
  !this.refreshFabricationMachineWorlds()
  !this.refreshFabricationMachineGroups()
  !this.refreshFabricationMachines()
  !this.onMachineTypeChanged()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      createMaterialValueList
--
-- Description: create material value list
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .createMaterialValueList()

  using namespace 'Aveva.Pdms.Presentation'

  !this.materials.appendArray(!this.gridBendStretchData.getColumn('Matref'))
  !this.materials.appendArray(!this.gridBendSpringbackData.getColumn('Matref'))
  !this.materials.appendArray(!this.gridWeldDimensions.getColumn('Matref'))
  !this.materials.appendArray(!this.gridExtrDimensions.getColumn('Matref'))
  !this.materials.unique()
  !this.materials.sort()
  !index = !this.materials.findFirst('Unset')
  if !index.set() then
    !this.materials.remove(!index)
  endif
  !index = !this.materials.findFirst('Search...')
  if !index.set() then
    !this.materials.remove(!index)
  endif
  !this.materials.insert(1, 'Unset')
  !this.materials.append('Search...')

  !this.gridBendStretchData.createValueList('MATREF', !this.materials)
  !this.gridBendSpringbackData.createValueList('MATREF', !this.materials)
  !this.gridWeldDimensions.createValueList('MATREF', !this.materials)
  !this.gridExtrDimensions.createValueList('MATREF', !this.materials)

  !this.gridBendStretchData.assignValueListToColumn('MATREF', 4)
  !this.gridBendSpringbackData.assignValueListToColumn('MATREF', 4)
  !this.gridWeldDimensions.assignValueListToColumn('MATREF', 4)
  !this.gridExtrDimensions.assignValueListToColumn('MATREF', 4)

  --!columns = !grid.getColumns()
  --!index = !columns.findFirst(!columnKey)
  --if !index.set() then
  --  !grid.assignValueListToColumn('MATREF', !index)
  --endif

endmethod


--------------------------------------------------------------------------------
--
-- Method:      firstShown
--
-- Description: called when the form is first shown
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .firstShown()

  -- Add 3D view to view system (this shows the form)
  --!!gphViews.add(!this.view)

   -- 3D view / local drawlist
  --!!gphMinimumMenus(!this)
  --!this.view.background = 15

  -- initialize the volume view gadget
  !this.drawlist.attachView(!this.view)
  !this.view.background = 15
  !this.view.showAxes = true

  var !coord COORD
  if !coord.eq('XYZ') then
     !this.view.labelStyle = 'XYZ'
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onMachineTypeChanged
--
-- Description: called when the machine type is changed
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onMachineTypeChanged()

  !machineType = !this.optMachineType.selection()
  if !machineType.eq('BENDING') then
    !this.frameWeldMachine.visible          = false
    !this.frameExtrusionMachine.visible     = false
    !this.frameBendMachine.visible          = true
    !this.frameBendingDimensions.visible    = true
    !this.frameBendCollisionPlanes.visible  = false
    !this.frameBendStretch.visible          = false
    !this.frameSpringback.visible           = false
  elseif !machineType.eq('WELDING') then
    !this.frameBendMachine.visible          = false
    !this.frameExtrusionMachine.visible     = false
    !this.frameWeldMachine.visible          = true
    !this.frameWeldableFlanges.visible      = true
    !this.frameWeldDimensions.visible       = false
    !this.frameWeldConnections.visible      = false
  elseif !machineType.eq('EXTRUSION') then
    !this.frameWeldMachine.visible          = false
    !this.frameBendMachine.visible          = false
    !this.frameExtrusionMachine.visible     = true
    !this.frameExtrDimensions.visible       = true
    !this.frameMinExtrusionDistance.visible = false
  endif

  !this.onFabricationMachineGroupChanged()
endmethod

--------------------------------------------------------------------------------
--
-- Method:      createElement
--
-- Description: set up and show !!pfFabMachineCrt form with the given element type
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      element type to be created
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .createElement(!type is STRING)

  !machineCreationDialog = !!fmsys.loadForm('pfFabMachineCrt')
  !machineCreationDialog.type = !type
  !machineCreationDialog.mode = 'new'

  if !type.eq('FMWL') then
    !fmwlRef = !this.optMachineWorld.selection().dbRef()
    handle ANY
      !!alert.error('Cannot get the selected FMWL')
      !this.refreshFabricationMachineWorlds()
      !this.onFabricationMachineWorldChanged()
      return
    endhandle

    if !fmwlRef.set() and !fmwlRef.dbWrite then
      !machineCreationDialog.current = !fmwlRef
    else
      !machineCreationDialog.current = WORLD
    endif
    !machineCreationDialog.formTitle = 'Create Fabrication Machine World'

  elseif !type.eq('FMGRP') then
    !fmgrpRef = !this.optMachineGroup.selection().dbRef()
    handle ANY
      !!alert.error('Cannot get the selected FMGRP')
      !this.onFabricationMachineWorldChanged()
      return
    endhandle

    if !fmgrpRef.set() then
      !machineCreationDialog.current = !fmgrpRef
    else
      !fmwlRef = !this.optMachineWorld.selection().dbRef()
      handle ANY
        !this.refreshFabricationMachineWorlds()
        !this.onFabricationMachineWorldChanged()
        return
      endhandle

      if !fmwlRef.set() then
        !machineCreationDialog.current = !fmwlRef
      else
        !!alert.error('A Fabrication Machine World must be created before a Fabrication Machine Group')
        return
      endif
    endif
    -- Fix Issue 95283, Create Fabrication Group -> Create Fabrication Machine Group
    !machineCreationDialog.formTitle = 'Create Fabrication Machine Group'

  elseif !type.eq('FMBEND') then
    !fmbendRef = !this.optBendMachine.selection().dbRef()
    handle ANY
      !!alert.error('Cannot get the selected FMBEND')
      !this.onFabricationMachineGroupChanged()
      return
    endhandle

    if !fmbendRef.set() then
      !machineCreationDialog.current = !fmbendRef
    else

      !fmgrpRef = !this.optMachineGroup.selection().dbRef()
      handle ANY
        !!alert.error('Cannot get the selected FMGRP')
        !this.onFabricationMachineWorldChanged()
        return
      endhandle

      if !fmgrpRef.set() then
        !machineCreationDialog.current = !fmgrpRef
      else
        !!alert.error('A Fabrication Machine Group must be created before a Bending Machine')
        return
      endif
    endif
    !machineCreationDialog.formTitle = 'Create Bending Machine'

  elseif !type.eq('FMWELD') then
    !fmweldRef = !this.optWeldMachine.selection().dbRef()
    handle ANY
      !!alert.error('Cannot get the selected FMWELD')
      !this.onFabricationMachineGroupChanged()
      return
    endhandle

    if !fmweldRef.set() then
      !machineCreationDialog.current = !fmweldRef
    else

      !fmgrpRef = !this.optMachineGroup.selection().dbRef()
      handle ANY
        !!alert.error('Cannot get the selected FMGRP')
        !this.onFabricationMachineWorldChanged()
        return
      endhandle

      if !fmgrpRef.set() then
        !machineCreationDialog.current = !fmgrpRef
      else
        !!alert.error('A Fabrication Machine Group must be created before a Welding Machine')
        return
      endif
    endif
    !machineCreationDialog.formTitle = 'Create Welding Machine'

  elseif !type.eq('FMEXTR') then
    !fmextrRef = !this.optExtrMachine.selection().dbRef()
    handle ANY
      !!alert.error('Cannot get the selected FMEXTR')
      !this.onFabricationMachineGroupChanged()
      return
    endhandle

    if !fmextrRef.set() then
      !machineCreationDialog.current = !fmextrRef
    else
      !fmgrpRef = !this.optMachineGroup.selection().dbRef()
      handle ANY
        !!alert.error('Cannot get the selected FMGRP')
        !this.onFabricationMachineWorldChanged()
        return
      endhandle

      if !fmgrpRef.set() then
        !machineCreationDialog.current = !fmgrpRef
      else
        !!alert.error('A Fabrication Machine Group must be created before a Extrusion Machine')
        return
      endif
    endif
    !machineCreationDialog.formTitle = 'Create Extrusion Machine'
  endif

  !machineCreationDialog.show()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      deleteElement
--
-- Description: delete the selected element in the given option gadget
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      option gadget
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .deleteElement(!gadget is GADGET)

  !dtext = !gadget.selection()
  !dbRef = !dtext.dbRef()
  handle ANY
    !dbRef = object DBREF()
  endhandle

  if !dbRef.set() then
    !!ce = !dbRef
    !!deleteCE()
  endif

  if !gadget.eq(!this.optMachineWorld) then
    !this.refreshFabricationMachineWorlds()
    !this.onFabricationMachineWorldChanged()
  elseif !gadget.eq(!this.optMachineGroup) then
    !this.refreshFabricationMachineGroups()
    !this.onFabricationMachineGroupChanged()
  else
    !this.refreshFabricationMachines()
    !this.onFabricationMachineChanged()
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      modifyElement
--
-- Description: set up and show !!pfFabMachineCrt with the given element and type
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      option gadget
--    2   R      STRING      element type
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .modifyElement(!gadget is GADGET, !type is STRING)

  !machineCreationDialog = !!fmsys.loadForm('pfFabMachineCrt')
  !machineCreationDialog.type = !type
  !machineCreationDialog.mode = 'modify'

  if !type.eq('FMWL') then
    !fmwlRef = !this.optMachineWorld.selection().dbRef()
    handle ANY
      !fmwlRef = object DBREF()
    endhandle

    if !fmwlRef.unset() then
      !!alert.error('Cannot get the selected FMWL')
      !this.refreshFabricationMachineWorlds()
      !this.onFabricationMachineWorldChanged()
      return
    endif

    !machineCreationDialog.current = !fmwlRef
    !machineCreationDialog.formTitle = 'Modify Fabrication Machine World'

  elseif !type.eq('FMGRP') then
    !fmgrpRef = !this.optMachineGroup.selection().dbRef()
    handle ANY
      !fmgrpRef = object DBREF()
    endhandle

    if !fmgrpRef.unset() then
      !!alert.error('Cannot get the selected FMGRP')
      !this.onFabricationMachineWorldChanged()
      return
    endif

    !machineCreationDialog.current =  !fmgrpRef
    !machineCreationDialog.formTitle = 'Modify Fabrication Machine Group'

  elseif !type.eq('FMBEND') then
    !fmbendRef = !this.optBendMachine.selection().dbRef()
    handle ANY
      !fmbendRef = object DBREF()
    endhandle

    if !fmbendRef.unset() then
      !!alert.error('Cannot get the selected FMBEND!')
      !this.onFabricationMachineGroupChanged()
      return
    endif

    !machineCreationDialog.current = !fmbendRef
    !machineCreationDialog.formTitle = 'Modify Bending Machine'

  elseif !type.eq('FMWELD') then
    !fmweldRef = !this.optWeldMachine.selection().dbRef()
    handle ANY
      !fmweldRef = object DBREF()
    endhandle

    if !fmweldRef.unset() then
      !!alert.error('Cannot get the selected FMWELD!')
      !this.onFabricationMachineGroupChanged()
      return
    endif

    !machineCreationDialog.current = !fmweldRef
    !machineCreationDialog.formTitle = 'Modify Welding Machine'

  elseif !type.eq('FMEXTR') then
    !fmextrRef = !this.optExtrMachine.selection().dbRef()
    handle ANY
      !fmextrRef = object DBREF()
    endhandle

    if !fmextrRef.unset() then
      !!alert.error('Cannot get the selected FMEXTR!')
      !this.onFabricationMachineGroupChanged()
      return
    endif

    !machineCreationDialog.current = !fmextrRef
    !machineCreationDialog.formTitle = 'Modify Extrusion Machine'
  endif

  !machineCreationDialog.show()

endmethod



--------------------------------------------------------------------------------
--
-- Method:      adjustMll
--
-- Description: update the bending machine mllin attribute value with the check box value
--
-- Method Type: Procedure
-- Arguments:

-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .adjustMll(!type is STRING)

if !type.eq('BENDING') then
  !fmbendRef = !this.optBendMachine.selection().dbRef()
if !fmbendRef.set() then
  !fmbendRef.MLLIN = !this.togAdjustMll.val
else
  !this.togAdjustMll.val = false
endif
endif

endmethod
--------------------------------------------------------------------------------
--
-- Method:      applyAttributeChanges
--
-- Description: update the machine attributes with the new form value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      machine type (BENDING or WELDING)
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .applyAttributeChanges(!type is STRING)

  if !type.eq('BENDING') then
    !fmbendRef = !this.optBendMachine.selection().dbRef()
    handle ANY
      !!alert.error('Cannot get the selected FMBEND')
      !this.onFabricationMachineGroupChanged()
      return
    endhandle

    if !fmbendRef.set() then
      !fmbendRef.stfProportional  = !this.txtStfProportional.val.real()
      handle ANY
        !!alert.error(!!error.text)
        return
      endhandle
      !fmbendRef.stfConstant      = !this.txtStfConstant.val.real()
      -- Fix for Issue 94962 (SI-56457)
      -- !fmbendRef.compensate       = !this.togCompensate.val
      !fmbendRef.compensate       = true
      !fmbendRef.benDirection     = !this.optBendDirection.selection()
      !fmbendRef.benRotation      = !this.optBendRotation.selection()

      if !fmbendRef.stepSpringback.neq(!this.togStepwiseSpringback.val) then
        !fmbendRef.stepSpringback = !this.togStepwiseSpringback.val
        !this.refreshBendSpringbackData()
      endif
    endif
  elseif !type.eq('WELDING') then
    !fmweldRef = !this.optWeldMachine.selection().dbRef()
    handle ANY
      !!alert.error('Cannot get the selected FMWELD')
      !this.onFabricationMachineGroupChanged()
      return
    endhandle

    if !fmweldRef.set() then
      !fmweldRef.minOD = !this.txtWeldMinOD.val.real()
      handle ANY
        !!alert.error(!!error.text)
        return
      endhandle
      !fmweldRef.maxOD = !this.txtWeldMaxOD.val.real()
      !fmweldRef.minLP = !this.txtWeldMinLP.val.real()
      !fmweldRef.maxLP = !this.txtWeldMaxLP.val.real()
    endif
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      refreshFabricationMachineWorlds
--
-- Description: refresh the option gadget for fabrication machine worlds
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .refreshFabricationMachineWorlds()

  !this.optMachineWorld.clear()
  !fmwlRefs = !!collectAllFor('FMWL', '', WORLD )
  if !fmwlRefs.empty().not() then
    do !fmwlRef values !fmwlRefs
      if !this.togName.val then
        !this.optMachineWorld.add(!fmwlRef.name, !fmwlRef.name)
      else
        !this.optMachineWorld.add(!fmwlRef.desc, !fmwlRef.name)
      endif
    enddo
    !this.optMachineWorld.val = 1
    !this.btnCreateMachineWorld.active = !fmwlRefs[1].dbWrite
  else
    !this.btnCreateMachineWorld.active = true
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onFabricationMachineWorldChanged
--
-- Description: called when the fabrication machine world is changed
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onFabricationMachineWorldChanged()

  !fmwlRef = !this.optMachineWorld.selection().dbRef()
  handle ANY
    !!alert.error('Cannot get the selected FMWL!')
    !this.refreshFabricationMachineWorlds()
    return
  endhandle

  !active = !fmwlRef.set() and !fmwlRef.dbWrite

  !this.btnCreateMachineWorld.active = !active

  !this.menuEditWorld.setFieldProperty('MODIFY', 'active', !active)
  !this.menuEditWorld.setFieldProperty('DELETE', 'active', !active)

  !this.refreshFabricationMachineGroups()
  !this.onFabricationMachineGroupChanged()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      refreshFabricationMachineGroups
--
-- Description: refresh the option gadget for fabrication machine groups
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .refreshFabricationMachineGroups()

  !this.optMachineGroup.clear()

  !fmwlRef = !this.optMachineWorld.selection().dbRef()
  handle ANY
    !!alert.error('Cannot get the selected FMWL!')
    !this.refreshFabricationMachineWorlds()
    return
  endhandle

  !active = !fmwlRef.set() and !fmwlRef.dbWrite

  !this.btnCreateMachineGroup.active  = !active
  !this.btnCreateBendMachine.active   = !active
  !this.btnCreateWeldMachine.active   = !active
  !this.btnCreateExtrMachine.active   = !active

  !dtext = object ARRAY()
  !rtext = object ARRAY()

  if !fmwlRef.set() then
    !fmgrpRefs = !!collectAllFor('FMGRP', '', !fmwlRef)
    do !fmgrpRef values !fmgrpRefs
      if !this.togName.val then
        !dtext.append(!fmgrpRef.name)
      else
        !dtext.append(!fmgrpRef.desc)
      endif
      !rtext.append(!fmgrpRef.name)
    enddo
  endif

  !this.optMachineGroup.dtext = !dtext
  !this.optMachineGroup.rtext = !rtext

  if !dtext.empty().not() then
    !this.optMachineGroup.val = 1
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      selectCurrent
--
-- Description: make the given fabrication machine element active
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       database element
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .selectCurrent(!element is DBREF)

  !!ce = !element
  FMBEND
  handle ANY
    FMWELD
    handle ANY
      FMEXTR
      handle ANY
        !!alert.error('Not a Fabrication Machine!')
        return
      endhandle
    endhandle
  endhandle

  !machineRef = !!ce

  !this.refreshFabricationMachineWorlds()
  !this.optMachineWorld.select('rtext', !machineRef.owner.owner.name)
  !this.refreshFabricationMachineGroups()
  !this.optMachineGroup.select('rtext', !machineRef.owner.name)

  if !machineRef.actType.eq('FMBEND') then
    !this.optMachineType.select('rtext', 'BENDING')
    !this.onMachineTypeChanged()
    !this.optBendMachine.select('rtext', !machineRef.name)
    !this.onFabricationMachineChanged()
  elseif !machineRef.actType.eq('FMWELD') then
    !this.optMachineType.select('rtext', 'WELDING')
    !this.onMachineTypeChanged()
    !this.optWeldMachine.select('rtext', !machineRef.name)
    !this.onFabricationMachineChanged()
  elseif !machineRef.actType.eq('FMEXTR') then
    !this.optMachineType.select('rtext', 'EXTRUSION')
    !this.onMachineTypeChanged()
    !this.optExtrMachine.select('rtext', !machineRef.name)
    !this.onFabricationMachineChanged()
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      quit
--
-- Description: called when the form is destroyed
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .quit()
  AID CLEAR ALL
endmethod


--------------------------------------------------------------------------------
--
-- Method:      loadCollisionPlanes
--
-- Description: draw all collision planes with aid elements in the 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       row tags selected in the collision plane grid
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .loadCollisionPlanes(!rowTags is ARRAY)

  --Initialise variables
  !minEast  = -1000mm
  !minNorth = -1000mm
  !minUp    = -1000mm
  !maxEast  =  1000mm
  !maxNorth =  1000mm
  !maxUp    =  1000mm

  -- If none selected do them all
  --!rows = !this.gridBendCollisionPlanes.getSelectedRows()
  --if !rows.empty() then
  --  !rows = !this.gridBendCollisionPlanes.getRows()
  --endif

  do !i indices !rowTags
    !refNo = !this.gridBendCollisionPlanes.getCell(!rowTags[!i], 'REFNO')
    !fmbplnRef = !refNo.dbRef()
    handle ANY
      skip
    endhandle

    !minPosition = !fmbplnRef.minPlnPosition.wrt( /* )
    !maxPosition = !fmbplnRef.maxPlnPosition.wrt( /* )

    !hidePreviousAids = !i.eq(1)

    !colour = !i + 1

    !this.showCollisionPlane(!fmbplnRef.tyseq.string(), !minPosition, !maxPosition, !hidePreviousAids, !colour)

    !minEast  = (MIN(!minEast,  !minPosition.east,  !maxPosition.east))
    !minNorth = (MIN(!minNorth, !minPosition.north, !maxPosition.north))
    !minUp    = (MIN(!minUp,    !minPosition.up,    !maxPosition.up))
    !maxEast  = (MAX(!maxEast,  !minPosition.east,  !maxPosition.east))
    !maxNorth = (MAX(!maxNorth, !minPosition.north, !maxPosition.north))
    !maxUp    = (MAX(!maxUp,    !minPosition.up,    !maxPosition.up))

  enddo

  !limits = object ARRAY()
  !limits[1] = !!comValueConvert(!minEast,  'MM')
  !limits[2] = !!comValueConvert(!maxEast,  'MM')
  !limits[3] = !!comValueConvert(!minNorth, 'MM')
  !limits[4] = !!comValueConvert(!maxNorth, 'MM')
  !limits[5] = !!comValueConvert(!minUp,    'MM')
  !limits[6] = !!comValueConvert(!maxUp,    'MM')
  !this.view.limits = !limits
endmethod


