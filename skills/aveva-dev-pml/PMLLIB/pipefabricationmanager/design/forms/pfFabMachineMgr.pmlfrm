--------------------------------------------------------------------------------
--
-- Method:      gridMinExtrDistanceBeforeCellUpdate
--
-- Description: called before updating a minimum distance between extrusions
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridMinExtrDistanceBeforeCellUpdate(!args is ARRAY)

  !dbRef = !this.gridMinExtrDistance.getCell(!args[1], 'REFNO').dbRef()
  handle ANY
    !dbRef = object DBREF()
  endhandle

  if !dbRef.unset() then
    return
  endif

  !attValue = !args[0].real()
  handle (2, 441)
    !!alert.error('Cannot convert string to REAL')
    !args[3] = false
    return
  endhandle

  if !attValue.unset() then
    !attValue = 0
  elseif !attValue.lt(0) then
    !!alert.error('Invalid value')
    !args[3] = false
    return
  endif

  if !args[2].eq('MOD') then
    if !attValue.eq(0) then
      !!alert.error('Invalid OD')
      !args[3] = false
      return
    endif
    !attName = 'od'
    -- Fix Issue 96530
    !attValue = !!comConvertUnknownValue(!attValue, !!pfContext.odWallRadiusFmt.units)
    --//
  elseif !args[2].eq('BODA') then
    !attName = 'extboa'
    -- Fix Issue 96530
    !attValue = !!comConvertUnknownValue(!attValue, !!pfContext.odWallRadiusFmt.units)
    --//
  elseif !args[2].eq('BODB') then
    !attName = 'extbob'
    -- Fix Issue 96530
    !attValue = !!comConvertUnknownValue(!attValue, !!pfContext.odWallRadiusFmt.units)
    --//
  elseif !args[2].eq('EAA') then
    !attName = 'exteaa'
  endif

  !dbRef.attribute(!attName) = !attValue
  handle ANY
    !!alert.error(!!error.text)
    !args[3] = false
  endhandle
endmethod

--------------------------------------------------------------------------------
--
-- Method:      gridMinExtrDistanceAfterCellUpdate
--
-- Description: called after updating a minimum distance between extrusions
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridMinExtrDistanceAfterCellUpdate(!args is ARRAY)
  !dbRef = !this.gridMinExtrDistance.getCell(!args[0], 'REFNO').dbRef()
  handle ANY
    !dbRef = object DBREF()
  endhandle

  if !dbRef.unset() then
    !!alert.error('Cannot get the selected FMEDNE')
    !this.refreshMinExtrusionDistance()
    return
  endif

  !this.gridMinExtrDistance.allGridEvents(false)
  if !args[1].eq('MOD') then
    !this.gridMinExtrDistance.setCellValue(!args[0], !args[1], !!pfContext.formatOD(!dbRef.od))
  elseif !args[1].eq('BODA') then
    !this.gridMinExtrDistance.setCellValue(!args[0], !args[1], !!pfContext.formatOD(!dbRef.extboa))
  elseif !args[1].eq('BODB') then
    !this.gridMinExtrDistance.setCellValue(!args[0], !args[1], !!pfContext.formatOD(!dbRef.extbob))
  elseif !args[1].eq('EAA') then
    !this.gridMinExtrDistance.setCellValue(!args[0], !args[1], !dbRef.exteaa.string(!!distanceFmt))
  endif
  !this.gridMinExtrDistance.allGridEvents(true)

endmethod

--------------------------------------------------------------------------------
--
-- Method:      showLegend
--
-- Description: show a legend dialog for the given machine type
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      machine type (FMBEND, FMWELD or FMEXTR)
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .showLegend(!type is STRING)

  if !type.eq('FMBEND') then
    !formTitle = 'Bending Machine Information'
    !pixmap = !!pml.getPathName('bendmachlegend.png')
  elseif !type.eq('FMWELD') then
    !formTitle = 'Welding Machine Information'
    !pixmap = !!pml.getPathName('weldmachlegend.png')
  elseif !type.eq('FMEXTR') then
    !formTitle = 'Extrusion Machine Information'
    !pixmap = !!pml.getPathName('extrmachlegend.png')
  else
    return
  endif

  setup form !!pfFabricationMachineLegend dialog
    para .parImage at x 0 pixmap width 600 height 500
  exit

  pml reload form !!pfFabricationMachineLegend
  !!pfFabricationMachineLegend.formTitle = !formTitle
  !!pfFabricationMachineLegend.parImage.addPixmap(!pixmap)
  !!pfFabricationMachineLegend.show()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      isValidStretchFactor
--
-- Description: check if the given stretch factors are valid or not
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      REAL        constant stretch factor
--    2    R      REAL        proportional stretch factor
--    3    R      BOOLEAN     allow zeros
-- Return:
--   [Data Type]             [Description]
--    REAL                    0 : valid, 1 : invalid, -1 : potentially invalid
--------------------------------------------------------------------------------
define method .isValidStretchFactor(!stfc is REAL, !stfp is REAL, !allowZeros is BOOLEAN) is REAL

-- return constants, do not change!
  !valid = 0
  !invalid = 1
  !potentiallyInvalid = -1

  if(!allowZeros AND (!stfc EQ 0) AND (!stfp EQ 0)) then
    -- this is a valid case
    return !valid
  endif

  -- bend angle = 0:
  !val0 = !stfc

  -- bend angle = 180o:
  !val1 = !stfc - !stfp * 3.14159 / 2.

  -- valid limits
  !valMin = 0.0000011
  !valMax = 1.0

  if((!val0.lt(!valMin)) and (!val1.lt(!valMin))) then
    return !invalid
  endif

  if((!val0.gt(!valMax)) and (!val1.gt(!valMax))) then
    return !invalid
  endif

  if((!val0.lt(!valMin)) or (!val0.gt(!valMax))) then
    return !potentiallyInvalid
  endif

  if((!val1.lt(!valMin)) or (!val1.gt(!valMax))) then
    return !potentiallyInvalid
  endif

  return !valid

endmethod

--------------------------------------------------------------------------------
--
-- Method:      rowSelection
--
-- Description: used for row selection
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type]        [Description]
--    1    R      NETGRIDCONTROL    constant stretch factor
--    2    R      REAL              proportional stretch factor
-- Return:
--   [Data Type]             [Description]
--------------------------------------------------------------------------------
define method .rowSelection(!grid is NETGRIDCONTROL, !fmRef is DBREF)
  using namespace 'Aveva.Pdms.Presentation'
  !index = 0
  !refNos = !grid.getColumn('REFNO')
  !index = !refNos.findFirst(!fmRef.refNo.string())
  !TotalRows = !grid.getNumberRows()
  do !loop from !index to !TotalRows
   !grid.selectRow(!loop)
  enddo
endmethod
