--------------------------------------------------------------------------------
--
-- Method:      gridExtrDimensionsBeforeCellUpdate
--
-- Description: called before updating the extrusion dimension
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridExtrDimensionsBeforeCellUpdate(!args is ARRAY)

  !dbRef = !this.gridExtrDimensions.getCell(!args[1], 'REFNO').dbRef()
  handle ANY
    !dbRef = object DBREF()
  endhandle

  if !dbRef.unset() then
    return
  endif

  if !args[2].eq('Matref') then

    if !args[0].eq('Search...') then
      !selectMaterialDialog = !!fmsys.loadForm('pfFabSelectMaterial')
      !selectMaterialDialog.actionString = |!!pfFabMachineMgr.gridExtrDimensions.setCellValue('| + !args[1] + |', '| + !args[2] + |', '!result')|
      !selectMaterialDialog.show()
      !args[3] = false
      return
    elseif !args[0].upCase().eq('UNSET') then
      !attValue = object DBREF()
    else
      !attValue = !args[0].dbRef()
      handle ANY
        !!alert.error('Invalid Matref')
        !args[3] = false
        return
      endhandle
    endif

    !attName = 'matref'

  else
    !attValue = !args[0].real()
    handle ANY
      !!alert.error('Cannot convert string to REAL')
      !args[3] = false
      return
    endhandle

    if !attValue.unset() then
      !attValue = 0
    elseif !attValue.lt(0) then
      !!alert.error('Invalid value')
      !args[3] = false
      return
    endif

    if !args[2].eq('MOD') then
      if !attValue.eq(0) then
        !!alert.error('Invalid OD')
        !args[3] = false
        return
      endif
      !attName = 'od'
      -- Fix Issue 96530
      !attValue = !!comConvertUnknownValue(!attValue, !!pfContext.odWallRadiusFmt.units)
      --//
    elseif !args[2].eq('WThickness') then
      !attName = 'wThickness'
      -- Fix Issue 96530
      !attValue = !!comConvertUnknownValue(!attValue, !!pfContext.odWallRadiusFmt.units)
      --//
    elseif !args[2].eq('BOD') then
      !attName = 'extbod'
      -- Fix Issue 96530
      !attValue = !!comConvertUnknownValue(!attValue, !!pfContext.odWallRadiusFmt.units)
      --//
    elseif !args[2].eq('EAB') then
      !attName = 'exteab'
    elseif !args[2].eq('EAK') then
      !attName = 'exteak'
    elseif !args[2].eq('EAH') then
      !attName = 'exteah'
    elseif !args[2].eq('EHE') then
      !attName = 'extehe'
    elseif !args[2].eq('ANT') then
      !attName = 'extant'
    endif
  endif

  !dbRef.attribute(!attName) = !attValue
  handle ANY
    !!alert.error(!!error.text)
    !args[3] = false
  endhandle
endmethod

--------------------------------------------------------------------------------
--
-- Method:      gridExtrDimensionsAfterCellUpdate
--
-- Description: called after updating the extrusion dimension
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridExtrDimensionsAfterCellUpdate(!args is ARRAY)

  !fmedimRef = !this.gridExtrDimensions.getCell(!args[0], 'REFNO').dbRef()
  handle ANY
    !fmedimRef = object DBREF()
  endhandle

  if !fmedimRef.unset() then
    !!alert.error('Cannot get the selected FMEDIM')
    !this.refreshExtrusionDimensions()
    return
  endif

  !this.gridExtrDimensions.allGridEvents(false)
  if !args[1].eq('MOD') then
    !this.gridExtrDimensions.setCellValue(!args[0], !args[1], !!pfContext.formatOD(!fmedimRef.od))
  elseif !args[1].eq('WThickness') then
    !this.gridExtrDimensions.setCellValue(!args[0], !args[1], !!pfContext.formatWallThickness(!fmedimRef.wThickness))
  elseif !args[1].eq('Matref') then
    if !fmedimRef.matRef.set() then
      !material = !fmedimRef.matRef.name
    else
      !material = 'Unset'
    endif
    !this.gridExtrDimensions.setCellValue(!args[0], !args[1], !material)
    !this.createMaterialValueList()

  elseif !args[1].eq('BOD') then
    !this.gridExtrDimensions.setCellValue(!args[0], !args[1], !!pfContext.formatOD(!fmedimRef.extbod))
  elseif !args[1].eq('EAB') then
    !this.gridExtrDimensions.setCellValue(!args[0], !args[1], !fmedimRef.exteab.string(!!distanceFmt))
    !attName = 'exteab'
  elseif !args[1].eq('EAK') then
    !this.gridExtrDimensions.setCellValue(!args[0], !args[1], !fmedimRef.exteak.string(!!distanceFmt))
  elseif !args[1].eq('EAH') then
    !this.gridExtrDimensions.setCellValue(!args[0], !args[1], !fmedimRef.exteah.string(!!distanceFmt))
  elseif !args[1].eq('EHE') then
    !this.gridExtrDimensions.setCellValue(!args[0], !args[1], !fmedimRef.extehe.string(!!distanceFmt))
  elseif !args[1].eq('ANT') then
    !this.gridExtrDimensions.setCellValue(!args[0], !args[1], !fmedimRef.extant.string(!!angleFmt))
  endif
  !this.gridExtrDimensions.allGridEvents(true)

endmethod

