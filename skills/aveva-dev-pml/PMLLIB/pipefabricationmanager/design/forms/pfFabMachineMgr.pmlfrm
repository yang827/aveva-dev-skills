--
--------------------------------------------------------------------------------
define method .createBendStretchData()

  !fmbendRef = !this.optBendMachine.selection().dbRef()
  handle ANY
    !fmbendRef = object DBREF()
  endhandle

  if !fmbendRef.unset() then
    !!alert.error('Cannot get the selected FMBEND')
    !this.onFabricationMachineGroupChanged()
    return
  endif

  !rowTags = !this.gridBendStretchData.getSelectedRowTags()
  if !rowTags.empty() then
    !!ce = !fmbendRef
    LAST FMBSST
    handle ANY
      -- dummy
    endhandle
  else
    -- Fix for Issue 94907 (SI-56257)
    -- create after the last selected element
    !rowTag = !rowTags.last()
    !refNo = !this.gridBendStretchData.getCell(!rowTag, 'REFNO')
    !fmbsstRef = !refNo.dbRef()
    handle ANY
      !!alert.error('Cannot get the selected FMBSST')
      !this.refreshBendStretchData()
      return
    endhandle

    !!ce = !fmbsstRef
  endif

  NEW FMBSST
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  using namespace  'Aveva.Pdms.Presentation'
  if (!rowTags.empty().not()) then
    !this.rowSelection(!this.gridBendStretchData, !refNo.dbRef())
  endif
  !fmbsstRef = !!ce

  --!this.refreshBendStretchData()

  !row = object ARRAY()
  !row.append(!fmbsstRef.refNo.string())
  !row.append(!!pfContext.formatOD(!fmbsstRef.od))
  !row.append(!!pfContext.formatWallThickness(!fmbsstRef.wThickness))

  if !fmbsstRef.matRef.set() then
    !material = !fmbsstRef.matRef.name
  else
    !material = 'Unset'
  endif
  !row.append(!material)

  !row.append(!!pfContext.formatStretchFactor(!fmbsstRef.stfProportional))
  !row.append(!!pfContext.formatStretchFactor(!fmbsstRef.stfConstant))
  !this.gridBendStretchData.addRow(!row)
  !this.gridBendStretchData.moveSelectedRowsDown()
  !this.gridBendStretchData.clearRowSelection()
  --!this.gridBendStretchData.selectRow(!this.gridBendStretchData.getNumberRows())
  !refNos = !this.gridBendStretchData.getColumn('REFNO')
  !index = !refNos.findFirst(!fmbsstRef.refNo.string())
  if !index.set() then
    !this.gridBendStretchData.selectRow(!index)
  endif

endmethod


--------------------------------------------------------------------------------
--
-- Method:      copyBendStretchData
--
-- Description: copy a stretch data element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .copyBendStretchData()

  !rowTags = !this.gridBendStretchData.getSelectedRowTags()
  if !rowTags.empty() then
    return
  endif

  !fmbsstRef = !this.gridBendStretchData.getCell(!rowTags.last(), 'REFNO').dbRef()
  handle ANY
    !fmbsstRef = object DBREF()
  endhandle

  if !fmbsstRef.unset() then
    !!alert.error('Cannot get the selected FMBSST')
    !this.refreshBendStretchData()
    return
  endif

  !!ce = !fmbsstRef
  NEW FMBSST COPY PREV
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  !this.refreshBendStretchData()

  !refNos = !this.gridBendStretchData.getColumn('REFNO')
  !index = !refNos.findFirst(!!ce.refNo.string())
  if !index.set() then
    !this.gridBendStretchData.selectRow(!index)
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      gridBendStretchDataBeforeCellUpdate
--
-- Description: called before updating the stretch data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridBendStretchDataBeforeCellUpdate(!args is ARRAY)

  !fmbsstRef = !this.gridBendStretchData.getCell(!args[1], 'REFNO').dbRef()
  handle ANY
    !fmbsstRef = object DBREF()
  endhandle

  if !fmbsstRef.set() then
    if !args[2].eq('Matref') then

      if !args[0].eq('Search...') then
        !selectMaterialDialog = !!fmsys.loadForm('pfFabSelectMaterial')
        !selectMaterialDialog.actionString = |!!pfFabMachineMgr.gridBendStretchData.setCellValue('| + !args[1] + |', '| + !args[2] + |', '!result')|
        !selectMaterialDialog.show()
        !args[3] = false
        return
      elseif !args[0].upCase().eq('UNSET') then
        !attValue = object DBREF()
      else
        !attValue = !args[0].dbRef()
        handle ANY
          !attValue = object DBREF('/' + !args[0])
          handle ANY
            !!alert.error('Invalid Matref')
            !args[3] = false
            return
          endhandle
        endhandle
      endif

      !attName = 'Matref'
    else
      !attValue = !args[0].real()
      handle (2, 441)
        !!alert.error('Cannot convert string to REAL')
        !args[3] = false
        return
      endhandle

      if !attValue.unset() then
        !attValue = 0
      elseif !attValue.lt(0) then
        !!alert.error('Invalid value')
        !args[3] = false
        return
      endif

      if !args[2].eq('OD') then
        if !attValue.eq(0) then
          !!alert.error('Invalid OD')
          !args[3] = false
          return
        endif
        !attName = 'OD'
        -- Fix Issue 96530
        !attValue = !!comConvertUnknownValue(!attValue, !!pfContext.odWallRadiusFmt.units)
        --//
      elseif !args[2].eq('WThickness') then
        !attName = 'WThickness'
        -- Fix Issue 96530
        !attValue = !!comConvertUnknownValue(!attValue, !!pfContext.odWallRadiusFmt.units)
        --//
      elseif !args[2].eq('STFProportional') then
        !attName = 'STFProportional'

        !valid = !this.isValidStretchFactor(!fmbsstRef.stfConstant, !attValue, true)
        if !valid.gt(0) then
          !!alert.error('The combination of Proportional and Constant is invalid')
          !args[3] = false
          return
        elseif !valid.lt(0) then
          !!alert.message('The combination of Proportional and Constant is potentially invalid')
        endif

      elseif !args[2].eq('STFConstant') then
        !attName = 'STFConstant'

        !valid = !this.isValidStretchFactor(!attValue, !fmbsstRef.stfProportional, true)
        if !valid.gt(0) then
          !!alert.error('The combination of Proportional and Constant is invalid')
          !args[3] = false
          return
        elseif !valid.lt(0) then
          !!alert.message('The combination of Proportional and Constant is potentially invalid')
        endif
      endif
    endif

    !fmbsstRef.attribute(!attName) = !attValue
    handle ANY
      !!alert.error(!!error.text)
      !args[3] = false
    endhandle
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      gridBendStretchDataAfterCellUpdate
--
-- Description: called after updating the stretch data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridBendStretchDataAfterCellUpdate(!args is ARRAY)

  using namespace 'Aveva.Pdms.Presentation'

  !fmbsstRef = !this.gridBendStretchData.getCell(!args[0], 'REFNO').dbRef()
  handle ANY
    !fmbsstRef = object DBREF()
  endhandle

  if !fmbsstRef.unset() then
    !!alert.error('Cannot get the selected FMBSST')
    !this.refreshBendStretchData()
    return
  endif

  !this.gridBendStretchData.allGridEvents(false)
  if !args[1].eq('OD') then
    !this.gridBendStretchData.setCellValue(!args[0], !args[1], !!pfContext.formatOD(!fmbsstRef.od))
  elseif !args[1].eq('WThickness') then
    !this.gridBendStretchData.setCellValue(!args[0], !args[1], !!pfContext.formatWallThickness(!fmbsstRef.wThickness))
  elseif !args[1].eq('Matref') then
    if !fmbsstRef.matRef.unset() then
      !name = 'Unset'
    else
      !name = !fmbsstRef.matRef.name
    endif
    !this.gridBendStretchData.setCellValue(!args[0], !args[1], !name)
    !this.createMaterialValueList()
  elseif !args[1].eq('STFProportional') then
    !this.gridBendStretchData.setCellValue(!args[0], !args[1], !!pfContext.formatStretchFactor(!fmbsstRef.stfProportional))
  elseif !args[1].eq('STFConstant') then
    !this.gridBendStretchData.setCellValue(!args[0], !args[1], !!pfContext.formatStretchFactor(!fmbsstRef.stfConstant))
  endif
  !this.gridBendStretchData.allGridEvents(true)

endmethod


--------------------------------------------------------------------------------
--
-- Method:      refreshBendSpringbackData
--
-- Description: refresh the springback grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .refreshBendSpringbackData()
  using namespace 'Aveva.Pdms.Presentation'

  !fmbendRef = !this.optBendMachine.selection().dbRef()
  handle ANY
    !!alert.error('Cannot get the selected FMBEND')
    !this.onFabricationMachineGroupChanged()
    return
  endhandle


  !titles = object ARRAY()
  !titles.append('REFNO')
  !titles.append('OD')
  !titles.append('WThickness')
  !titles.append('Matref')
  !titles.append('ANGSPA')
  !titles.append('ANGSPB')

  !rows = object ARRAY()

  if !fmbendRef.set() then

    if !fmbendRef.stepSpringback then
      !fmssbkRefs = !!collectAllFor('FMSSBK', '', !fmbendRef)
      do !fmssbkRef values !fmssbkRefs
        !row = object ARRAY()
        !row.append(!fmssbkRef.refNo.string())
        !row.append(!!pfContext.formatOD(!fmssbkRef.od))
        !row.append(!!pfContext.formatWallThickness(!fmssbkRef.wThickness))
        if !fmssbkRef.matRef.unset() then
          !material = 'Unset'
        else
          !material = !fmssbkRef.matRef.name
        endif
        !row.append(!material)
        !row.append(!fmssbkRef.benAngle.string(!!angleFmt))
        !row.append(!fmssbkRef.sprAngle.string(!!angleFmt))
        !rows.append(!row)
      enddo

      !titles[5] = 'Bending Angle'
      !titles[6] = 'Springback Angle'

    else
      !fmbsstRefs = !!collectAllFor('FMBSST', 'ACTTYPE EQ |FMBSST|', !fmbendRef)
      do !fmbsstRef values !fmbsstRefs
        !row = object ARRAY()
        !row.append(!fmbsstRef.refNo.string())
        !row.append(!!pfContext.formatOD(!fmbsstRef.od))
        !row.append(!!pfContext.formatWallThickness(!fmbsstRef.wThickness))
        if !fmbsstRef.matRef.unset() then
          !material = 'Unset'
        else
          !material = !fmbsstRef.matRef.name
        endif
        !row.append(!material)
        !row.append(!fmbsstRef.angspa.string(!!angleFmt))
        !row.append(!fmbsstRef.angspb.string(!!angleFmt))
        !rows.append(!row)
      enddo
    endif
  endif

  !ds = object NETDATASOURCE('Bending Springback Data', !titles, !rows, 'Bending Springback Data')
  !this.gridBendSpringbackData.bindToDataSource(!ds)
  !this.gridBendSpringbackData.setColumnVisibility('REFNO', false)
  !this.gridBendSpringbackData.setColumnTextAlignment(!titles[2], 'RIGHT')
  !this.gridBendSpringbackData.setColumnTextAlignment(!titles[3], 'RIGHT')
  !this.gridBendSpringbackData.setColumnTextAlignment(!titles[5], 'RIGHT')
  !this.gridBendSpringbackData.setColumnTextAlignment(!titles[6], 'LEFT')
  !this.createMaterialValueList()
  if !this.firstTimeSpringbackData then
    !this.firstTimeSpringbackData = false
    !this.gridBendSpringbackData.autoFitColumns()
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      createBendSpringbackData
--
-- Description: create a new element for bending springback data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .createBendSpringbackData()

  using namespace 'Aveva.Pdms.Presentation'

  !fmbendRef = !this.optBendMachine.selection().dbRef()
  handle ANY
    !fmbendRef = object DBREF()
  endhandle

  if !fmbendRef.unset() then
    !!alert.error('Cannot get the selected FMBEND')
    !this.onFabricationMachineGroupChanged()
    return
  endif

  !rowTags = !this.gridBendSpringbackData.getSelectedRowTags()

--  !!ce = !fmbendRef

--  !row = object ARRAY()

  if !fmbendRef.stepSpringback then

    if !rowTags.empty() then
      !!ce = !fmbendRef

      LAST FMSSBK
      handle ANY
        -- no members
      endhandle

    else
      -- Fix for Issue 94907 (SI-56257)
      !rowTag = !rowTags.last()
      !refNo = !this.gridBendSpringbackData.getCell(!rowTag, 'REFNO')
      !fmssbkRef = !refNo.dbRef()
      handle ANY
        !!alert.error('Cannot get the selected FMSSBK')
        !this.refreshBendSpringbackData()
        return
      endhandle

      !!ce = !fmssbkRef
    endif

    NEW FMSSBK
    handle ANY
      !!alert.error(!!error.text)
      return
    endhandle

    using namespace  'Aveva.Pdms.Presentation'
    if (!rowTags.empty().not()) then
      !this.rowSelection(!this.gridBendSpringbackData, !refNo.dbRef())
    endif
    !fmssbkRef = !!ce
    !row = object ARRAY()
    !row.append(!fmssbkRef.refNo.string())
    !row.append(!!pfContext.formatOD(!fmssbkRef.od))
    !row.append(!!pfContext.formatWallThickness(!fmssbkRef.wThickness))

    if !fmssbkRef.matRef.set() then
      !material = !fmssbkRef.matRef.name
    else
      !material = 'Unset'
    endif
    !row.append(!material)

    !row.append(!fmssbkRef.benAngle.string(!!angleFmt))
    !row.append(!fmssbkRef.sprAngle.string(!!angleFmt))
    !this.gridBendSpringbackData.addRow(!row)
    !this.gridBendSpringbackData.moveSelectedRowsDown()
    !this.gridBendSpringbackData.clearRowSelection()

  else

    if !rowTags.empty() then
      !!ce = !fmbendRef
      LAST FMBSST
      handle ANY
        -- no members
      endhandle

    else
      -- Fix for Issue 94907 (SI-56257)
      !rowTag = !rowTags.last()
      !refNo = !this.gridBendSpringbackData.getCell(!rowTag, 'REFNO')
      !fmbsstRef = !refNo.dbRef()
      handle ANY
        !!alert.error('Cannot get the selected FMBSST')
        !this.refreshBendSpringbackData()
        return
      endhandle

      !!ce = !fmbsstRef
    endif

    NEW FMBSST
    handle ANY
      !!alert.error(!!error.text)
      return
    endhandle

    using namespace  'Aveva.Pdms.Presentation'
    if (!rowTags.empty().not()) then
      !this.rowSelection(!this.gridBendSpringbackData, !refNo.dbRef())
    endif

    !fmbsstRef = !!ce
    !row = object ARRAY()
    !row.append(!fmbsstRef.refNo.string())
    !row.append(!!pfContext.formatOD(!fmbsstRef.od))
    !row.append(!!pfContext.formatWallThickness(!fmbsstRef.wThickness))

    if !fmbsstRef.matRef.set() then
      !material = !fmbsstRef.matRef.name
    else
      !material = 'Unset'
    endif
    !row.append(!material)

    !row.append(!fmbsstRef.angspa.string(!!angleFmt))
    !row.append(!fmbsstRef.angspb.string(!!angleFmt))
    !this.gridBendSpringbackData.addRow(!row)
    !this.gridBendSpringbackData.moveSelectedRowsDown()
    !this.gridBendSpringbackData.clearRowSelection()
  endif

--  !this.gridBendSpringbackData.addRow(!row)

  !refNo = !!ce.refNo.string()

  --!this.refreshBendSpringbackData()

  !refNos = !this.gridBendSpringbackData.getColumn('REFNO')
  !index = !refNos.findFirst(!refNo)
  if !index.set() then
    !this.gridBendSpringbackData.selectRow(!index)
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      copyBendSpringbackData
--
-- Description: copy a bending springback data element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .copyBendSpringbackData()

  !rowTags = !this.gridBendSpringbackData.getSelectedRowTags()
  if !rowTags.empty() then
    return
  endif

  !elemRef = !this.gridBendSpringbackData.getCell(!rowTags.last(), 'REFNO').dbRef()
  handle ANY
    !elemRef = object DBREF()
  endhandle
  if !elemRef.unset() then
    !!alert.error('Cannot get the selected FMBSST or FMSSBK')
    !this.refreshBendSpringbackData()
    return
  endif

  !!ce = !elemRef
  NEW $!<elemRef.actType> COPY $!elemRef
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  !this.refreshBendSpringbackData()

  !refNos = !this.gridBendSpringbackData.getColumn('REFNO')
  !index = !refNos.findFirst(!!ce.refNo.string())
  if !index.set() then
    !this.gridBendSpringbackData.selectRow(!index)
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      gridBendSpringbackDataBeforeCellUpdate
--
-- Description: called before updating the bending springback data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridBendSpringbackDataBeforeCellUpdate(!args is ARRAY)

  !dbRef = !this.gridBendSpringbackData.getCell(!args[1], 'REFNO').dbRef()
  handle ANY
    !dbRef = object DBREF()
  endhandle

  if !dbRef.unset() then
    return
  endif

  if !args[2].eq('Matref') then

    if !args[0].eq('Search...') then
      !selectMaterialDialog = !!fmsys.loadForm('pfFabSelectMaterial')
      !selectMaterialDialog.actionString = |!!pfFabMachineMgr.gridBendSpringbackData.setCellValue('| + !args[1] + |', '| + !args[2] + |', '!result')|
      !selectMaterialDialog.show()
      !args[3] = false
      return
    elseif !args[0].upCase().eq('UNSET') then
      !attValue = object DBREF()
    else
      !attValue = !args[0].dbRef()
      handle ANY
        !!alert.error('Invalid Matref')
        !args[3] = false
        return
      endhandle
    endif

    !attName = 'Matref'
  else
    !attValue = !args[0].real()
    handle ANY
      !!alert.error('Cannot convert string to REAL')
      !args[3] = false
      return
    endhandle

    if !attValue.unset() then
      !attValue = 0
    elseif !attValue.lt(0) then
      !!alert.error('Invalid value')
      !args[3] = false
      return
    endif

    if !args[2].eq('OD') then
      if !attValue.eq(0) then
        !!alert.error('Invalid OD')
        !args[3] = false
        return
      endif
      !attName = 'OD'
      -- Fix Issue 96530
      !attValue = !!comConvertUnknownValue(!attValue, !!pfContext.odWallRadiusFmt.units)
      --//
    elseif !args[2].eq('WThickness') then
      !attName = 'WThickness'
      -- Fix Issue 96530
      !attValue = !!comConvertUnknownValue(!attValue, !!pfContext.odWallRadiusFmt.units)
      --//
    elseif !args[2].eq('ANGSPA') then
      !attName = 'ANGSPA'
    elseif !args[2].eq('ANGSPB') then
      !attName = 'ANGSPB'
    elseif !args[2].eq('Bending Angle') then
      !attName = 'benAngle'
    elseif !args[2].eq('Springback Angle') then
      !attName = 'sprAngle'
    endif
  endif

  !dbRef.attribute(!attName) = !attValue
  handle ANY
    !!alert.error(!!error.text)
    !args[3] = false
  endhandle

endmethod

--------------------------------------------------------------------------------
--
-- Method:      gridBendSpringbackDataAfterCellUpdate
--
-- Description: called after updating the bending springback data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridBendSpringbackDataAfterCellUpdate(!args is ARRAY)

  using namespace 'Aveva.Pdms.Presentation'

  !dbRef = !this.gridBendSpringbackData.getCell(!args[0], 'REFNO').dbRef()
  handle ANY
    !dbRef = object DBREF()
  endhandle

  if !dbRef.unset() then
    !!alert.error('Cannot get the selected FMBSST or FMSSBK')
    !this.refreshBendSpringbackData()
    return
  endif

  !this.gridBendSpringbackData.allGridEvents(false)
  if !args[1].eq('OD') then
    !this.gridBendSpringbackData.setCellValue(!args[0], !args[1], !!pfContext.formatOD(!dbRef.od))
  elseif !args[1].eq('WThickness') then
    !this.gridBendSpringbackData.setCellValue(!args[0], !args[1], !!pfContext.formatWallThickness(!dbRef.wThickness))
  elseif !args[1].eq('Matref') then
    if !dbRef.matRef.set() then
      !material = !dbRef.matRef.name
    else
      !material = 'Unset'
    endif
    !this.gridBendSpringbackData.setCellValue(!args[0], !args[1], !material)
    !this.createMaterialValueList()
  elseif !args[1].eq('ANGSPA') then
    !this.gridBendSpringbackData.setCellValue(!args[0], !args[1], !dbRef.angspa.string(!!angleFmt))
  elseif !args[1].eq('ANGSPB') then
    !this.gridBendSpringbackData.setCellValue(!args[0], !args[1], !dbRef.angspb.string(!!angleFmt))
  elseif !args[1].eq('Bending Angle') then
    !this.gridBendSpringbackData.setCellValue(!args[0], !args[1], !dbRef.benAngle.string(!!angleFmt))
  elseif !args[1].eq('Springback Angle') then
    !this.gridBendSpringbackData.setCellValue(!args[0], !args[1], !dbRef.sprAngle.string(!!angleFmt))
  endif
  !this.gridBendSpringbackData.allGridEvents(true)
endmethod


--------------------------------------------------------------------------------
--
-- Method:      onFabricationMachineGroupChanged
--
-- Description: called when the fabrication machine group is changed
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onFabricationMachineGroupChanged()

  !fmgrpRef = !this.optMachineGroup.selection().dbRef()
  handle ANY
    !!alert.error('Cannot get the selected FMGRP')
    !this.onFabricationMachineWorldChanged()
    return
  endhandle

  !active = !fmgrpRef.set() and !fmgrpRef.dbWrite
  !this.menuEditGroup.setFieldProperty('MODIFY', 'active', !active)
  !this.menuEditGroup.setFieldProperty('DELETE', 'active', !active)

  !this.refreshFabricationMachines()
  !this.onFabricationMachineChanged()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      refreshFabricationMachines
--
-- Description: refresh the option gadget for the fabrication machines
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .refreshFabricationMachines()

  !dtext = object ARRAY()
  !rtext = object ARRAY()

  !machineType = !this.optMachineType.selection()

  !fmgrpRef = !this.optMachineGroup.selection().dbRef()
  handle ANY
    !!alert.error('Cannot get the selected FMGRP')
    !this.onFabricationMachineWorldChanged()
    return
  endhandle

  if !fmgrpRef.set() then
    !results = object ARRAY()
    if !machineType.eq('BENDING') then
      !results = !!collectAllFor('FMBEND', 'ACTTYPE EQ |FMBEND|', !fmgrpRef)
    elseif !machineType.eq('WELDING') then
      !results = !!collectAllFor('FMWELD', 'ACTTYPE EQ |FMWELD|', !fmgrpRef)
    elseif !machineType.eq('EXTRUSION') then
      !results = !!collectAllFor('FMEXTR', 'ACTTYPE EQ |FMEXTR|', !fmgrpRef)
    endif

    do !i indices !results
      !rtext.append(!results[!i].name)
      if !this.togName.val then
        !dtext.append(!results[!i].name)
      else
        !dtext.append(!results[!i].desc)
      endif
    enddo
  endif

  if !machineType.eq('BENDING') then
    !this.optBendMachine.dtext = !dtext
    !this.optBendMachine.rtext = !rtext
  elseif !machineType.eq('WELDING') then
    !this.optWeldMachine.dtext = !dtext
    !this.optWeldMachine.rtext = !rtext
  elseif !machineType.eq('EXTRUSION') then
    !this.optExtrMachine.dtext = !dtext
    !this.optExtrMachine.rtext = !rtext
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      onFabricationMachineChanged
--
-- Description: called when the fabrication machine is changed
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onFabricationMachineChanged()

  !machineType = !this.optMachineType.selection()

  if !machineType.eq('BENDING') then

    !this.btnReportBendMachine.active = !this.optBendMachine.val.gt(0)

    !fmbendRef = !this.optBendMachine.selection().dbRef()
    handle ANY
      !!alert.error('Cannot get the selected FMBEND')
      !this.onFabricationMachineGroupChanged()
      return
    endhandle

    !active = !fmbendRef.set() and !fmbendRef.dbWrite
   if !fmbendRef.set() then
    !this.togAdjustMll.val = !fmbendRef.MLLIN
   else
    !this.togAdjustMll.val = false
   endif
    !this.menuEditBend.setFieldProperty('MODIFY', 'active', !active)
    !this.menuEditBend.setFieldProperty('DELETE', 'active', !active)

    --!this.conBendDimensions.active      = !active
    --!this.conBendCollisionPlanes.active = !active
    --!this.conBendStretchData.active     = !active
    --!this.conBendSpringbackData.active  = !active
    !this.gridBendDimensions.editableGrid(!active)
    !this.gridBendCollisionPlanes.editableGrid(!active)
    !this.gridBendStretchData.editableGrid(!active)
    !this.gridBendSpringbackData.editableGrid(!active)

    !this.txtStfProportional.active     = !active
    !this.txtStfConstant.active         = !active
    -- MoM from Knowledge transfer workshop 8./9.05.2013
    -- !this.togCompensate.active          = !active
    !this.togStepwiseSpringback.active  = !active
    !this.optBendDirection.active       = !active
    !this.optBendRotation.active        = !active

    if !fmbendRef.set() then
      !this.txtStfProportional.val        = !!pfContext.formatStretchFactor(!fmbendRef.stfProportional)
      !this.txtStfConstant.val            = !!pfContext.formatStretchFactor(!fmbendRef.stfConstant)
      -- MoM from Knowledge transfer workshop 8./9.05.2013
      -- !this.togCompensate.val             = !fmbendRef.compensate
      !this.togStepwiseSpringback.val     = !fmbendRef.stepSpringback

      !this.optBendDirection.select('rtext', !fmbendRef.benDirection)
      handle ANY
        !this.optBendDirection.select('rtext', 'LEFT')
      endhandle
      !this.optBendRotation.select('rtext',  !fmbendRef.benRotation)
      handle ANY
        !this.optBendRotation.select('rtext', 'BOTH')
      endhandle
    endif

    !this.refreshBendDimensions()
    !this.refreshBendCollisionPlanes()
    !this.refreshBendStretchData()
    !this.refreshBendSpringbackData()

    if !fmbendRef.set() then
      !!ce = !fmbendRef
    endif

  elseif !machineType.eq('WELDING') then

    !this.btnReportWeldMachine.active = !this.optWeldMachine.val.gt(0)

    !fmweldRef = !this.optWeldMachine.selection().dbRef()
    handle ANY
      !!alert.error('Cannot get the selected FMWELD')
      !this.onFabricationMachineGroupChanged()
      return
    endhandle

    !active = !fmweldRef.set() and !fmweldRef.dbWrite

    !this.menuEditWeld.setFieldProperty('MODIFY', 'active', !active)
    !this.menuEditWeld.setFieldProperty('DELETE', 'active', !active)

    !this.gridWeldableFlangeSkey.editableGrid(!active)
    !this.gridWeldDimensions.editableGrid(!active)
    !this.gridWeldConnections.editableGrid(!active)

    !this.frameWeldOD.active = !active
    !this.frameWeldPipeLength.active = !active

    if !fmweldRef.set() then
      !this.txtWeldMinOD.val = !!pfContext.formatOD(!fmweldRef.minOD)
      !this.txtWeldMaxOD.val = !!pfContext.formatOD(!fmweldRef.maxOD)
      !this.txtWeldMinLP.val = !fmweldRef.minLP.string(!!distanceFmt)
      !this.txtWeldMaxLP.val = !fmweldRef.maxLP.string(!!distanceFmt)
    endif

    !this.refreshWeldableFlangeSkey()
    !this.refreshWeldDimensions()
    !this.refreshWeldConnections()

    if !fmweldRef.set() then
      !!ce = !fmweldRef
    endif

  elseif !machineType.eq('EXTRUSION') then

    !this.btnReportExtrMachine.active = !this.optExtrMachine.val.gt(0)

    !fmextrRef = !this.optExtrMachine.selection().dbRef()
    handle ANY
      !!alert.error('Cannot get the selected FMEXTR')
      !this.onFabricationMachineGroupChanged()
      return
    endhandle

    !active = !fmextrRef.set() and !fmextrRef.dbWrite

    !this.menuEditExtr.setFieldProperty('MODIFY', 'active', !active)
    !this.menuEditExtr.setFieldProperty('DELETE', 'active', !active)

    --!this.conExtrDimensions.active = !active
    --!this.conMinExtrDistance.active = !active
    !this.gridExtrDimensions.editableGrid(!active)
    !this.gridMinExtrDistance.editableGrid(!active)

    !this.refreshExtrusionDimensions()
    !this.refreshMinExtrusionDistance()

    if !fmextrRef.set() then
      !!ce = !fmextrRef
    endif
  endif

endmethod


--------------------------------------------------------------------------------
--
-- Method:      refreshWeldableFlangeSkey
--
-- Description: refresh the grid control for weldable flange skeys
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .refreshWeldableFlangeSkey()

  !fmweldRef = !this.optWeldMachine.selection().dbRef()
  handle ANY
    !!alert.error('Cannot get the selected FMWELD')
    !this.onFabricationMachineGroupChanged()
    return
  endhandle

  !rows = object ARRAY()
  if !fmweldRef.set() then
    !fmwskRefs = !!collectAllFor('FMWSK', 'ACTTYPE EQ |FMWSK|', !fmweldRef)
    do !fmwskRef values !fmwskRefs
      !row = object ARRAY()
      !row.append(!fmwskRef.refNo.string())
      !row.append(!fmwskRef.skey)
      !rows.append(!row)
    enddo
  endif

  !titles = object ARRAY()
  !titles.append('REFNO')
  !titles.append('Skey')

  using namespace 'Aveva.Pdms.Presentation'
  !ds = object NETDATASOURCE('Weldable Flange Data', !titles, !rows, 'Welding Machine Weldable Flange Data')
  !this.gridWeldableFlangeSkey.bindToDataSource(!ds)
  !this.gridWeldableFlangeSkey.setColumnVisibility('REFNO', false)
  if !this.firstTimeWeldFlangeSkey then
    !this.firstTimeWeldFlangeSkey = false
    !this.gridWeldableFlangeSkey.autoFitColumns()
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      createWeldableFlangeSkey
--
-- Description: create a new element for weldable flange skey
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .createWeldableFlangeSkey()

  !fmweldRef = !this.optWeldMachine.selection().dbRef()
  handle ANY
    !fmweldRef = object DBREF()
  endhandle

  if !fmweldRef.unset() then
    !!alert.error('Cannot get the selected FMWELD')
    !this.onFabricationMachineGroupChanged()
    return
  endif

  !rowTags = !this.gridWeldableFlangeSkey.getSelectedRowTags()
  if !rowTags.empty() then
    !!ce = !fmweldRef
    LAST FMWSK
    handle ANY
      -- dummy
    endhandle
  else
    -- Fix for Issue 94907 (SI-56257)
    -- create after the last selected element
    !rowTag = !rowTags.last()
    !refNo = !this.gridWeldableFlangeSkey.getCell(!rowTag, 'REFNO')
    !fmwskRef = !refNo.dbRef()
    handle ANY
      !!alert.error('Cannot get the selected FMWSK')
      !this.refreshWeldableFlangeSkey()
      return
    endhandle

    !!ce = !fmwskRef
  endif

  NEW FMWSK
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  using namespace  'Aveva.Pdms.Presentation'
  if (!rowTags.empty().not()) then
    !this.rowSelection(!this.gridWeldableFlangeSkey, !refNo.dbRef())
  endif
  !fmwskRef = !!ce

  --!this.refreshWeldableFlangeSkey()

  !row = object ARRAY()
  !row.append(!!ce.refNo.string())
  !row.append(!!ce.skey)
  !this.gridWeldableFlangeSkey.addRow(!row)
  !this.gridWeldableFlangeSkey.moveSelectedRowsDown()
  !this.gridWeldableFlangeSkey.clearRowSelection()
--  !this.gridWeldableFlangeSkey.selectRow(!this.gridWeldableFlangeSkey.getNumberRows())
  !refNos = !this.gridWeldableFlangeSkey.getColumn('REFNO')
  !index = !refNos.findFirst(!fmwskRef.refNo.string())
  if !index.set() then
    !this.gridWeldableFlangeSkey.selectRow(!index)
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      createWeldableFlangeSkey
--
-- Description: copy a weldable flange skey element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .copyWeldableFlangeSkey()

  !rowTags = !this.gridWeldableFlangeSkey.getSelectedRowTags()
  if !rowTags.empty() then
    return
  endif

  !dbRef = !this.gridWeldableFlangeSkey.getCell(!rowTags.last(), 'REFNO').dbRef()
  handle ANY
    !dbRef = object DBREF()
  endhandle
  if !dbRef.unset() then
    !!alert.error('Cannot get the selected FMWSK')
    !this.refreshWeldableFlangeSkey()
    return
  endif

  !!ce = !dbRef
  NEW FMWSK COPY PREV
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  !this.refreshWeldableFlangeSkey()

  !refNos = !this.gridWeldableFlangeSkey.getColumn('REFNO')
  !index = !refNos.findFirst(!!ce.refNo.string())
  if !index.set() then
    !this.gridWeldableFlangeSkey.selectRow(!index)
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      gridWeldableFlangeSkeyBeforeCellUpdate
--
-- Description: called before updating weldable flange skey
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridWeldableFlangeSkeyBeforeCellUpdate(!args is ARRAY)

  !skey = !args[0].trim().upCase()
  if !skey.length().gt(4) then
    !!alert.error('Invalid Skey')
    !args[3] = false
    return
  endif

  !fmwskRef = !this.gridWeldableFlangeSkey.getCell(!args[1], 'REFNO').dbRef()
  handle ANY
    !fmwskRef = object DBREF()
  endhandle

  if !fmwskRef.set() then
    !fmwskRef.skey = !skey
    handle ANY
      !!alert.error(!!error.text)
      !args[3] = false
    endhandle
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      gridWeldableFlangeSkeyAfterCellUpdate
--
-- Description: called after updating weldable flange skey
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridWeldableFlangeSkeyAfterCellUpdate(!args is ARRAY)

  !fmwskRef = !this.gridWeldableFlangeSkey.getCell(!args[0], 'REFNO').dbRef()
  handle ANY
    !fmwskRef = object DBREF()
  endhandle

  if !fmwskRef.unset() then
    !!alert.error('Cannot get the selected FMWSK')
    !this.refreshWeldableFlangeSkey()
    return
  endif

  !this.gridWeldableFlangeSkey.allGridEvents(false)
  !this.gridWeldableFlangeSkey.setCellValue(!args[0], !args[1], !fmwskRef.skey)
  !this.gridWeldableFlangeSkey.allGridEvents(true)
endmethod


--------------------------------------------------------------------------------
--
-- Method:      refreshWeldDimensions
--
-- Description: refresh the grid control for weld dimensions
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .refreshWeldDimensions()

  !fmweldRef = !this.optWeldMachine.selection().dbRef()
  handle ANY
    !!alert.error('Cannot get the selected FMWELD')
    !this.onFabricationMachineGroupChanged()
    return
  endhandle


  !rows = object ARRAY()
  if !fmweldRef.set() then
    !fmwdimRefs = !!collectAllFor('FMWDIM', 'ACTTYPE EQ |FMWDIM|', !fmweldRef)
    do !fmwdimRef values !fmwdimRefs
      !row = object ARRAY()
      !row.append(!fmwdimRef.refNo.string())
      !row.append(!!pfContext.formatOD(!fmwdimRef.od))
      !row.append(!!pfContext.formatWallThickness(!fmwdimRef.wThickness))

      if !fmwdimRef.matRef.set() then
        !material = !fmwdimRef.matRef.name
      else
        !material = 'Unset'
      endif
      !row.append(!material)

      !row.append(!fmwdimRef.welManual.string(!!distanceFmt))
      !row.append(!fmwdimRef.welMachine.string(!!distanceFmt))
      !row.append(!fmwdimRef.welOrbital.string(!!distanceFmt))
      !rows.append(!row)
    enddo
  endif

  !titles = object ARRAY()
  !titles.append('REFNO')
  !titles.append('OD')
  !titles.append('WThickness')
  !titles.append('Matref')
  !titles.append('WHN')
  !titles.append('WMN')
  !titles.append('WON')

  using namespace 'Aveva.Pdms.Presentation'
  !ds = object NETDATASOURCE('Welding Dimensions', !titles, !rows, 'Welding Dimensions')
  !this.gridWeldDimensions.bindToDataSource(!ds)
  !this.gridWeldDimensions.setColumnVisibility('REFNO', false)
  !this.gridWeldDimensions.setColumnTextAlignment('OD', 'RIGHT')
  !this.gridWeldDimensions.setColumnTextAlignment('WThickness', 'RIGHT')
  !this.gridWeldDimensions.setColumnTextAlignment('WHN', 'RIGHT')
  !this.gridWeldDimensions.setColumnTextAlignment('WMN', 'RIGHT')
  !this.gridWeldDimensions.setColumnTextAlignment('WON', 'LEFT')
  !this.createMaterialValueList()
  if !this.firstTimeWeld then
    !this.firstTimeWeld = false
    !this.gridWeldDimensions.autoFitColumns()
  endif
endmethod


--------------------------------------------------------------------------------
--
-- Method:      createWeldDimension
--
-- Description: create a new element for weld dimension
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .createWeldDimension()

  !fmweldRef = !this.optWeldMachine.selection().dbRef()
  handle ANY
    !fmweldRef = object DBREF()
  endhandle

  if !fmweldRef.unset() then
    !!alert.error('Cannot get the selected FMWELD')
    !this.onFabricationMachineGroupChanged()
    return
  endif

  !rowTags = !this.gridWeldDimensions.getSelectedRowTags()
  if !rowTags.empty() then
    !!ce = !fmweldRef
    LAST FMWDIM
    handle ANY
      -- dummy
    endhandle
  else
    -- Fix for Issue 94907 (SI-56257)
    -- create after the last selected element
    !rowTag = !rowTags.last()
    !refNo = !this.gridWeldDimensions.getCell(!rowTag, 'REFNO')
    !fmwdimRef = !refNo.dbRef()
    handle ANY
      !!alert.error('Cannot get the selected FMWDIM')
      !this.refreshWeldDimensions()
      return
    endhandle

    !!ce = !fmwdimRef
  endif

  NEW FMWDIM
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  using namespace  'Aveva.Pdms.Presentation'
  if (!rowTags.empty().not()) then
    !this.rowSelection(!this.gridWeldDimensions, !refNo.dbRef())
  endif

  !fmwdimRef = !!ce
  !row = object ARRAY()
  !row.append(!!ce.refNo.string())
  !row.append(!!pfContext.formatOD(!!ce.od))
  !row.append(!!pfContext.formatWallThickness(!!ce.wThickness))

  if !!ce.matRef.set() then
    !material = !!ce.matRef.name
  else
    !material = 'Unset'
  endif
  !row.append(!material)

  !row.append(!!ce.welManual.string(!!distanceFmt))
  !row.append(!!ce.welMachine.string(!!distanceFmt))
  !row.append(!!ce.welOrbital.string(!!distanceFmt))
  !this.gridWeldDimensions.addRow(!row)
  !this.gridWeldDimensions.moveSelectedRowsDown()
  !this.gridWeldDimensions.clearRowSelection()
--  !this.gridWeldDimensions.selectRow(!this.gridWeldDimensions.getNumberRows())

  --!this.refreshWeldDimensions()
  !refNos = !this.gridWeldDimensions.getColumn('REFNO')
  !index = !refNos.findFirst(!fmwdimRef.refNo.string())
  if !index.set() then
    !this.gridWeldDimensions.selectRow(!index)
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      copyWeldDimension
--
-- Description: copy a weld dimension element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .copyWeldDimension()

  !rowTags = !this.gridWeldDimensions.getSelectedRowTags()
  if !rowTags.empty() then
    return
  endif

  !elemRef = !this.gridWeldDimensions.getCell(!rowTags.last(), 'REFNO').dbRef()
  handle ANY
    !elemRef = object DBREF()
  endhandle

  if !elemRef.unset() then
    !!alert.error('Cannot get the selected FMWDIM')
    !this.refreshWeldDimensions()
    return
  endif

  !!ce = !elemRef
  NEW FMWDIM COPY PREV
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  !this.refreshWeldDimensions()

  !refNos = !this.gridWeldDimensions.getColumn('REFNO')
  !index = !refNos.findFirst(!!ce.refNo.string())
  if !index.set() then
    !this.gridWeldDimensions.clearRowSelection()
    !this.gridWeldDimensions.selectRow(!index)
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      gridWeldDimensionsBeforeCellUpdate
--
-- Description: called before updating the weld dimension
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridWeldDimensionsBeforeCellUpdate(!args is ARRAY)

  !dbRef = !this.gridWeldDimensions.getCell(!args[1], 'REFNO').dbRef()
  handle ANY
    !dbRef = object DBREF()
  endhandle

  if !dbRef.unset() then
    return
  endif

  if !args[2].eq('Matref') then

    if !args[0].eq('Search...') then
      !selectMaterialDialog = !!fmsys.loadForm('pfFabSelectMaterial')
      !selectMaterialDialog.actionString = |!!pfFabMachineMgr.gridWeldDimensions.setCellValue('| + !args[1] + |', '| + !args[2] + |', '!result')|
      !selectMaterialDialog.show()
      !args[3] = false
      return
    elseif !args[0].upCase().eq('UNSET') then
      !attValue = object DBREF()
    else
      !attValue = !args[0].dbRef()
      handle ANY
        !!alert.error('Invalid Matref')
        !args[3] = false
        return
      endhandle
    endif

    !attName = 'matref'
  else
    !attValue = !args[0].real()
    handle (2, 441)
      !!alert.error('Cannot convert string to REAL')
      !args[3] = false
      return
    endhandle

    if !attValue.unset() then
      !attValue = 0
    elseif !attValue.lt(0) then
      !!alert.error('Invalid value')
      !args[3] = false
      return
    endif

    if !args[2].eq('OD') then
      if !attValue.eq(0) then
        !!alert.error('Invalid OD')
        !args[3] = false
        return
      endif
      !attName = 'od'
      -- Fix Issue 96530
      !attValue = !!comConvertUnknownValue(!attValue, !!pfContext.odWallRadiusFmt.units)
      --//
    elseif !args[2].eq('WThickness') then
      !attName = 'wThickness'
      -- Fix Issue 96530
      !attValue = !!comConvertUnknownValue(!attValue, !!pfContext.odWallRadiusFmt.units)
      --//
    elseif !args[2].eq('WHN') then
      !attName = 'welManual'
    elseif !args[2].eq('WMN') then
      !attName = 'welMachine'
    elseif !args[2].eq('WON') then
      !attName = 'welOrbital'
    endif
  endif

  !dbRef.attribute(!attName) = !attValue
  handle ANY
    !!alert.error(!!error.text)
    !args[3] = false
  endhandle
endmethod

--------------------------------------------------------------------------------
--
-- Method:      gridWeldDimensionsAfterCellUpdate
--
-- Description: called after updating the weld dimension
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridWeldDimensionsAfterCellUpdate(!args is ARRAY)

  !fmwdimRef = !this.gridWeldDimensions.getCell(!args[0], 'REFNO').dbRef()
  handle ANY
    !!alert.error('Cannot get the selected FMWDIM')
    !this.refreshWeldDimensions()
    return
  endhandle

  !this.gridWeldDimensions.allGridEvents(false)

  if !args[1].eq('OD') then
    !this.gridWeldDimensions.setCellValue(!args[0], !args[1], !!pfContext.formatOD(!fmwdimRef.od))
  elseif !args[1].eq('WThickness') then
    !this.gridWeldDimensions.setCellValue(!args[0], !args[1], !!pfContext.formatWallThickness(!fmwdimRef.wThickness))
  elseif !args[1].eq('Matref') then
    if !fmwdimRef.matRef.set() then
      !material = !fmwdimRef.matRef.name
    else
      !material = 'Unset'
    endif
    !this.gridWeldDimensions.setCellValue(!args[0], !args[1], !material)
    !this.createMaterialValueList()

  elseif !args[1].eq('WHN') then
    !this.gridWeldDimensions.setCellValue(!args[0], !args[1], !fmwdimRef.welManual.string(!!distanceFmt))
  elseif !args[1].eq('WMN') then
    !this.gridWeldDimensions.setCellValue(!args[0], !args[1], !fmwdimRef.welMachine.string(!!distanceFmt))
  elseif !args[1].eq('WON') then
    !this.gridWeldDimensions.setCellValue(!args[0], !args[1], !fmwdimRef.welOrbital.string(!!distanceFmt))
  endif

  !this.gridWeldDimensions.allGridEvents(true)
endmethod


--------------------------------------------------------------------------------
--
-- Method:      refreshWeldConnections
--
-- Description: refresh the grid control for weld connections
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .refreshWeldConnections()

  !fmweldRef = !this.optWeldMachine.selection().dbRef()
  handle ANY
    !!alert.error('Cannot get the selected FMWELD')
    !this.onFabricationMachineGroupChanged()
    return
  endhandle

  !rows = object ARRAY()
  if !fmweldRef.set() then
    !fmwconRefs = !!collectAllFor('FMWCON', '', !fmweldRef)
    do !fmwconRef values !fmwconRefs
      !row = object ARRAY()
      !row.append(!fmwconRef.refNo.string())

      !connection = !fmwconRef.welConnection.trim()
      !row.append(!connection)

      -- Fix for Issue 94906 (SI-56259), description column added
      !description = ''
      if !connection.empty().not() then
        !cocdesRefs = !!collectAllFor('COCDES', |COCONNECTION EQ '$!connection'|, /* )
        if !cocdesRefs.empty().not() then
          !description = !cocdesRefs[1].description
        endif
      endif
      !row.append(!description)

      --!row.append(!fmwconRef.welConnection)
      !rows.append(!row)
    enddo
  endif

  !titles = object ARRAY()
  !titles.append('REFNO')
  !titles.append('Connection')
  !titles.append('Description')

  using namespace 'Aveva.Pdms.Presentation'
  !ds = object NETDATASOURCE('Weld Connections', !titles, !rows, 'Weld Connections')
  !this.gridWeldConnections.bindToDataSource(!ds)
  !this.gridWeldConnections.setColumnVisibility(1, false)
  !this.gridWeldConnections.setEditableColumn(3, false)
  if !this.firstWeldConnections then
    !this.firstWeldConnections = false
    !this.gridWeldConnections.autoFitColumns()
  endif
  !this.gridWeldConnections.assignValueListToColumn('CONNECTION', 2)

endmethod

--------------------------------------------------------------------------------
--
-- Method:      gridWeldConnectionsBeforeCellUpdate
--
-- Description: called before updating the weld connection
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridWeldConnectionsBeforeCellUpdate(!args is ARRAY)

  !connectionType = !args[0].trim().upCase()
  if !connectionType.empty().not() then
    !result = !!collectAllFor('COCDES', 'Coconnection EQ |' + !connectionType + '|', WORLD )
    if !result.empty() then
      !!alert.error('Invalid Connection Type')
      !args[3] = false
      return
    endif

    !connectionTypes = !this.gridWeldConnections.getColumn(2)
    if !connectionTypes.findFirst(!connectionType).set() then
      !!alert.message('Already selected')
      !args[3] = false
      return
    endif
  endif

  !fmwconRef = !this.gridWeldConnections.getCell(!args[1], 'REFNO').dbRef()
  handle ANY
    !fmwconRef = object DBREF()
  endhandle

  if !fmwconRef.set() then
    !fmwconRef.welConnection = !connectionType
    handle ANY
      !!alert.error(!!error.text)
      !args[3] = false
    endhandle
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      gridWeldConnectionsAfterCellUpdate
--
-- Description: called after updating the weld connection
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .gridWeldConnectionsAfterCellUpdate(!args is ARRAY)
  !fmwconRef = !this.gridWeldConnections.getCell(!args[0], 'REFNO').dbRef()
  handle ANY
    !fmwconRef = object DBREF()
  endhandle

  if !fmwconRef.unset() then
    !!alert.error('Cannot get the selected FMWCON')
    !this.refreshWeldConnections()
    return
  endif

  !this.gridWeldConnections.allGridEvents(false)

  !connection = !fmwconRef.welConnection
  !this.gridWeldConnections.setCellValue(!args[0], 'Connection', !connection)

  !description = ''
  if !connection.empty().not() then
    !cocdesRefs = !!collectAllFor('COCDES', |COCONNECTION EQ '$!connection'|, /* )
    if !cocdesRefs.empty().not() then
      !description = !cocdesRefs[1].description
    endif
  endif
  !this.gridWeldConnections.setCellValue(!args[0], 'Description', !description)

  !this.gridWeldConnections.allGridEvents(true)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      createWeldConnection
--
-- Description: create a weld connection element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .createWeldConnection()

  !fmweldRef = !this.optWeldMachine.selection().dbRef()
  handle ANY
    !fmweldRef = object DBREF()
  endhandle
  if !fmweldRef.unset() then
    !!alert.error('Cannot get the selected FMWELD')
    !this.onFabricationMachineGroupChanged()
    return
  endif

  !rowTags = !this.gridWeldConnections.getSelectedRowTags()
  if !rowTags.empty() then

    !!ce = !fmweldRef
    LAST FMWCON
    handle ANY
      -- dummy
    endhandle

  else
    -- Fix for Issue 94907 (SI-56257)
    -- create after the last selected element
    !rowTag = !rowTags.last()
    !refNo = !this.gridWeldConnections.getCell(!rowTag, 'REFNO')
    !fmwconRef = !refNo.dbRef()
    handle ANY
      !!alert.error('Cannot get the selected FMWCON')
      !this.refreshWeldConnections()
      return
    endhandle

    !!ce = !fmwconRef
  endif

  NEW FMWCON
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  using namespace  'Aveva.Pdms.Presentation'
  if (!rowTags.empty().not()) then
    !this.rowSelection(!this.gridWeldConnections, !refNo.dbRef())
  endif

  !fmwconRef = !!ce

  !row = object ARRAY()
  !row.append(!!ce.refNo.string())
  !row.append(!!ce.Connection)
  !row.append('')
  !this.gridWeldConnections.addRow(!row)
  !this.gridWeldConnections.moveSelectedRowsDown()
  !this.gridWeldConnections.clearRowSelection()
  --!this.gridWeldConnections.selectRow(!this.gridWeldConnections.getNumberRows())
  --!this.refreshWeldConnections()
  !refNos = !this.gridWeldConnections.getColumn('REFNO')
  !index = !refNos.findFirst(!fmwconRef.refNo.string())
  if !index.set() then
    !this.gridWeldConnections.selectRow(!index)
  endif


endmethod

--------------------------------------------------------------------------------
--
-- Method:      copyWeldConnection
--
-- Description: copy a weld connection element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .copyWeldConnection()
  !rowTags = !this.gridWeldConnections.getSelectedRowTags()
  if !rowTags.empty() then
    return
  endif

  !dbRef = !this.gridWeldConnections.getCell(!rowTags.last(), 'REFNO').dbRef()
  handle ANY
    !!alert.error('Cannot get the selected FMWCON')
    !this.refreshWeldConnections()
    return
  endhandle

  !!ce = !dbRef
  NEW FMWCON COPY PREV
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  !this.refreshWeldConnections()

  !refNos = !this.gridWeldConnections.getColumn('REFNO')
  !index = !refNos.findFirst(!!ce.refNo.string())
  if !index.set() then
    !this.gridWeldConnections.clearRowSelection()
    !this.gridWeldConnections.selectRow(!index)
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      refreshExtrusionDimensions
--
-- Description: refresh the grid control for extrusion dimensions
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .refreshExtrusionDimensions()

  !fmextrRef = !this.optExtrMachine.selection().dbRef()
  handle ANY
    !!alert.error('Cannot get the selected FMEXTR')
    !this.onFabricationMachineGroupChanged()
    return
  endhandle

  !rows = object ARRAY()
  if !fmextrRef.set() then
    !fmedimRefs = !!collectAllFor('FMEDIM', 'ACTTYPE EQ |FMEDIM|', !fmextrRef)
    do !fmedimRef values !fmedimRefs
      !row = object ARRAY()
      !row.append(!fmedimRef.refNo.string())
      !row.append(!!pfContext.formatOD(!fmedimRef.od))
      !row.append(!!pfContext.formatWallThickness(!fmedimRef.wThickness))

      if !fmedimRef.matRef.set() then
        !material = !fmedimRef.matRef.name
      else
        !material = 'Unset'
      endif
      !row.append(!material)

      !row.append(!!pfContext.formatOD(!fmedimRef.extbod))
      !row.append(!fmedimRef.exteab.string(!!distanceFmt))
      !row.append(!fmedimRef.exteak.string(!!distanceFmt))
      !row.append(!fmedimRef.exteah.string(!!distanceFmt))
      !row.append(!fmedimRef.extehe.string(!!distanceFmt))
      !row.append(!fmedimRef.extant.string(!!angleFmt))
      !rows.append(!row)
    enddo
  endif

  !titles = object ARRAY()
  !titles.append('REFNO')
  !titles.append('MOD')
  !titles.append('WThickness')
  !titles.append('Matref')
  !titles.append('BOD')
  !titles.append('EAB')
  !titles.append('EAK')
  !titles.append('EAH')
  !titles.append('EHE')
  !titles.append('ANT')

  using namespace 'Aveva.Pdms.Presentation'
  !ds = object NETDATASOURCE('Extrusion Dimensions', !titles, !rows, 'Extrusion Dimensions')
  !this.gridExtrDimensions.bindToDataSource(!ds)
  !this.gridExtrDimensions.setColumnVisibility('REFNO', false)
  !this.gridExtrDimensions.setColumnTextAlignment('MOD', 'RIGHT')
  !this.gridExtrDimensions.setColumnTextAlignment('WThickness', 'RIGHT')
  !this.gridExtrDimensions.setColumnTextAlignment('BOD', 'RIGHT')
  !this.gridExtrDimensions.setColumnTextAlignment('EAB', 'RIGHT')
  !this.gridExtrDimensions.setColumnTextAlignment('EAK', 'RIGHT')
  !this.gridExtrDimensions.setColumnTextAlignment('EAH', 'RIGHT')
  !this.gridExtrDimensions.setColumnTextAlignment('EHE', 'RIGHT')
  !this.gridExtrDimensions.setColumnTextAlignment('ANT', 'LEFT')
  !this.createMaterialValueList()
  if !this.firstTimeExtr then
    !this.firstTimeExtr = false
    !this.gridExtrDimensions.autoFitColumns()
  endif
endmethod

