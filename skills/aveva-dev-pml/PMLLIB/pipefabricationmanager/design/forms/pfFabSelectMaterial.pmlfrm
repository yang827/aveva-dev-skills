-- Created:         Tuesday 6th December 2012
--
--  Description:     Search for and select material form for Fabrication Machine
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applySearch()                    -                   apply action for search panel
--  init()                           -                   initialise form
--  initSearch()                     -                   initialise search panel
--  pfFabSelectMaterial()            -                   constructor
--  specResultsSelected(ARRAY)       -                   process selection in search control for related form
--
import 'PMLDBSearch'
handle any
endhandle

setup form !!pfFabSelectMaterial block

  -- Define .net control namespaces
  using namespace 'Aveva.Pdms.Presentation'
  using namespace 'Aveva.Pdms.Presentation.PMLDBSearchCtrl'

  !this.formTitle   = 'Select Material'
  !this.initcall    = '!this.init()'

  -- Search definition panel
  path down
  frame .frSearch 'Search'              anchor all at x0.5 ymin width 79 height 11
    container .conSearch nobox PmlNetControl 'Search' dock fill width 78 height 10
    path left

    button .bnSearchBack 'Dismiss'      anchor b+r at xmax.frSearch-10 ymax.frSearch-1.25 width 8 callback '!this.searchResult = object DBREF()' CANCEL
    button .bnSearchNew  'New Search'   anchor b+r width 8 callback '!this.initSearch()'
    button .bnSearchAdd  'Use Selected' anchor b+r width 12 callback '!this.applySearch()'
  exit

  -- .net controls
  member .searchControl      is PMLDBSEARCHCTRL

  member .searchDbType       is STRING
  member .searchScope        is ARRAY
  member .searchEleTypes     is ARRAY
  member .searchFilters      is ARRAY
  member .searchMultiSel     is BOOLEAN
  member .searchColumns      is ARRAY
  member .searchResult       is DBREF

  member .actionString       is STRING

exit

------------------------------------------------------------------------
--
-- Method:      pfFabSelectMaterial
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pfFabSelectMaterial()

  -- Define .net control namespaces
  using namespace 'Aveva.Pdms.Presentation'
  using namespace 'Aveva.Pdms.Presentation.PMLDBSearchCtrl'

  -- Add instance of .net search control
  !this.searchControl         = object PMLDBSEARCHCTRL()
  !this.searchControl.addEventHandler('ResultsSelectedEvent', !this, 'specResultsSelected')
  !this.conSearch.control     = !this.searchControl.handle()

endmethod

------------------------------------------------------------------------
--
-- Method:      init
--
-- Description: initialize
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .init()

    !this.searchDbType           = |CATA|
    !this.searchScope.clear()
    !this.searchScope[1]         = |/*|
    !this.searchEleTypes.clear()
    !this.searchEleTypes[1]      = |SMTE|
    !this.searchFilters.clear()
    --!this.searchFilters[1]       = |NAME like *|
    !this.searchMultiSel         = false
    !this.searchColumns.clear()
    !this.searchColumns[1]       = |XTEXT Xtext|
    !this.searchColumns[2]       = |NAME Name|
    !this.searchColumns[3]       = |YTEXT Ytext|
    !this.searchColumns[4]       = |ZTEXT Ztext|
    !this.searchColumns[5]       = |OWNER.NAME Owner|
    !this.searchColumns[6]       = |DBNAME Database|

  -- Populate the search fields
  !this.initSearch()

endmethod

------------------------------------------------------------------------
--
-- Method:      initSearch
--
-- Description: initialise search panel
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initSearch()

  !this.searchResult = object DBREF()
  !this.bnSearchAdd.active = false

  -- Initialise search control
  !displayResults = false
  !this.searchControl.initiateSearch(!displayResults, |Search|, !this.searchDbType, $
     !this.searchScope, !this.searchEleTypes, !this.searchFilters, !this.searchColumns)

endmethod


------------------------------------------------------------------------
--
-- Method:      applySearch
--
-- Description: apply action for search panel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .applySearch()

  if !this.searchResult.badref().not() and !this.actionString.empty().not() then
    !actionString = !this.actionString.replace('!result', !this.searchResult.name)
    !block = object BLOCK(!actionString)
    !block.evaluate()
    handle ANY
      -- dummy
    endhandle
  endif

  !this.hide()

endmethod

------------------------------------------------------------------------
--
-- Method:      specResultsSelected
--
-- Description: select the specified rows on the specified form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Search results data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .specResultsSelected(!data is ARRAY)

  -- Save search results as dbref's
  if !data.size().gt(0) then
    !this.searchResult = !data[0].dbref()
  else
    !this.searchResult = object DBREF()
  endif

  !this.bnSearchAdd.active = !this.searchResult.set()

endmethod
