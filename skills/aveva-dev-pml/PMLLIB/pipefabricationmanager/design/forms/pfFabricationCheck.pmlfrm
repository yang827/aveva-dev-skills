--------------------------------------------------------------------------------
--
-- Method:      zoom
--
-- Description: zoom to the given volume
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .zoom(!volume is VOLUME)
  !from = !volume.from
  !to   = !volume.to

  -- Through Point
  !throughPoint   = !from.midPoint(!to)
  handle ANY
    return
  endhandle

  -- Set through point
  !through[1] = !!comValueConvert(!throughPoint.east, 'MM')
  !through[2] = !!comValueConvert(!throughPoint.north, 'MM')
  !through[3] = !!comValueConvert(!throughPoint.up, 'MM')
  !!fmSys.currentDocument().view.through = !through

  -- Set view radius
  !radius = !!comValueConvert(!from.distance(!to), 'MM') * 0.5
  !radius = !radius.max(300mm)
  !!fmSys.currentDocument().view.radius  = !radius
endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickRenameAllSpools
--
-- Description: rename all spools in the selected pipe
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickRenameAllSpools()

  -- set the selected spool element to current element
  -- if the current element is not under SITE element, !!nameOpt.nameString makes an error
  if !!pfContext.autoNamingRules.not() then
    !!alert.message('Auto Naming is not on!')
    return
  endif

  !spool = !this.fabCheckCtrl.getSelectedSpool()
  !name = !spool.pspoolElement()
  if !name.unset() or !name.empty() then
    return
  endif

  !pspoolRef = !name.dbref()
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  !!ce = !pspoolRef

  !undo = object UNDOABLE()
  !undo.description('PF - Rename Spools')
  !undo.add()

  !this.fabCheckCtrl.renameAllSpools()
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  !undo.endUndoable()

endmethod

