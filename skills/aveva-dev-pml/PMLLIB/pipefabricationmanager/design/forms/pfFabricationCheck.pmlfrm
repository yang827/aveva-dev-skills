--------------------------------------------------------------------------------
--
-- Method:      onClickAddPipesTo3DView
--
-- Description: add the selected pipes to 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickAddPipesTo3DView()

  using namespace 'Aveva.Pdms.PipeFabrication.FabricationCheck'

  !pipeRefs = object ARRAY()

  !pipes = !this.fabCheckCtrl.getSelectedPipes()
  do !pipe values !pipes

    !pipeRef = !pipe.name().dbref()
    handle ANY
      !pipeRef = object DBREF()
    endhandle

    if !pipeRef.badref().not() then
      ADD $!pipeRef
      !pipeRefs.append(!pipeRef)
    endif
  enddo

  if !pipeRefs.empty().not() then
    !this.zoom(object VOLUME(!pipeRefs))
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickRemovePipesFrom3DView
--
-- Description: remove the selected pipes from 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickRemovePipesFrom3DView()
  using namespace 'Aveva.Pdms.PipeFabrication.FabricationCheck'

  !pipes = !this.fabCheckCtrl.getSelectedPipes()
  do !pipe values !pipes

    !pipeRef = !pipe.name().dbref()
    handle ANY
      !pipeRef = object DBREF()
    endhandle

    if !pipeRef.badref().not() then
      REM $!pipeRef
    endif
  enddo
endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickDefaultFabricationMachines
--
-- Description: change mode to 'default fabrication machines'
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      mode for default fabrication machines, PIPE, SPOOL, PIECE
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickDefaultFabricationMachines(!mode is STRING)

  !this.changeMode('DEF')
  !this.defaultMachineMode = !mode

  !this.machineTree.loadDefaults()
  !this.machineTree.loadMachines()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      changeMode
--
-- Description: show/hide the form controls according to the given mode
--              DEF : mode for default fabrication machines
--              OPT : mode for optimization priorities
--              CHK : mode for fabrication check
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      mode string
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .changeMode(!mode is STRING)

  !isDefault = !mode.eq('DEF')
  !isOptimization = !mode.eq('OPT')
  !isCheck = !isDefault.not() and !isOptimization.not()

  !this.netCtrlFabCheck.visible = !isCheck
  !this.togZoom.visible = !isCheck
  !this.btnValidate.visible = !isCheck
  !this.btnModifySpool.visible = !isCheck
  !this.btnWeldHandling.visible = !isCheck
  !this.btnDefaultMachines.visible = !isCheck
  !this.btnRelease.visible = !isCheck

  !this.parMachineTree.visible = !isDefault
  !this.netControlMachineTree.visible = !isDefault
  !this.btnApplyDefaultMachines.visible = !isDefault
  !this.btnCancelDefaultMachines.visible = !isDefault
  !this.btnDefaultMachinesFromPipe.visible = !isDefault
  !this.btnDefaultMachinesFromPipe.active = !isDefault

  !this.parOptimization.visible = !isOptimization
  !this.lstOptimizationPriority.visible = !isOptimization
  !this.btnMovePriorityUp.visible = !isOptimization
  !this.btnMovePriorityDown.visible = !isOptimization
  !this.btnResetPriorities.visible = !isOptimization
  !this.btnApplyPriorities.visible = !isOptimization
  !this.btnClosePriorities.visible = !isOptimization
  !this.btnApplyPriorities.active = false
  if !isOptimization then
    !this.lstOptimizationPriority.setFocus()
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickOptimizationPriorities
--
-- Description: change mode to 'optimization priorities'
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickOptimizationPriorities()

  !this.refreshOptimizationPriorities(!this.fabCheckCtrl.optimizationPriorities())
  !this.changeMode('OPT')
  !this.optimizationPrioritySelected()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickSelectDefaultMachinesFromCE
--
-- Description: select default fabrication machines from the selected pipe
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickSelectDefaultMachinesFromCE()

  !scopeRef = BRAN
  handle ANY
    !scopeRef = PIPE
    handle ANY
      !scopeRef = ZONE
      handle ANY
        !scopeRef = object DBREF()
      endhandle
    endhandle
  endhandle

  if !scopeRef.badref() then
    !!alert.message('Select one of BRAN, PIPE or ZONE')
    return
  endif

  !bendMacRef = !scopeRef.bendMacRef
  if !bendMacRef.badref() and !scopeRef.type.eq('BRAN') then
    !scopeRef = !scopeRef.owner
    !bendMacRef = !scopeRef.bendMacRef
  endif

  if !bendMacRef.badref() and !scopeRef.type.eq('PIPE') then
    !scopeRef = !scopeRef.owner
    !bendMacRef = !scopeRef.bendMacRef
  endif

  if !bendMacRef.unset() then
    !!alert.error('No BendMacReference assigned!')
    return
  endif

  if !bendMacRef.badref() then
    !!alert.error('Bad BendMacReference!')
    return
  endif

  !this.machineTree.uncheckAll()
  !this.machineTree.checkMachine(!bendMacRef.name)

endmethod

