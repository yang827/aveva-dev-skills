--------------------------------------------------------------------------------
--
-- Method:      onPipeSpoolSelected
--
-- Description: called when the selection of the spool grid is changed
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      ARRAY         grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onPipeSpoolSelected(!args is ARRAY)

  if UNDEFINED(!args[0]) then
    return
  endif

  UNENHANCE ALL
  -- Fix Issue 97155
  handle ANY
    return
  endhandle
  --//

  !components = object ARRAY()

  !pipeSpool = !args[0]
  !namesInSpool = !pipeSpool.allComponents()
  do !namesByBranch values !namesInSpool
    do !name values !namesByBranch
      !component = !name.dbref()
      handle ANY
      elsehandle NONE
        !components.append(!component)
        ENHANCE $!name COLOUR $!!gphColOpt.highlight

        -- highlight PIPCA elements if exist
        do !memberRef values !component.members
          ENHANCE $!memberRef COLOUR $!!gphColOpt.highlight
        enddo

      endhandle
    enddo
  enddo

  if !this.togZoom.val then
    !this.zoom(object VOLUME(!components))
  endif

endmethod

