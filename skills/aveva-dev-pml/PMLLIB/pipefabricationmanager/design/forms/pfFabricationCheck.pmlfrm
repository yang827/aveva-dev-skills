--
-- Method:      onClickZoomToPipe
--
-- Description: zoom to the selected pipe
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickZoomToPipe()

  !pipeRefs = object ARRAY()

  !pipes = !this.fabCheckCtrl.getSelectedPipes()
  do !pipe values !pipes
    !pipeRef = !pipe.name().dbref()
    if !pipeRef.badref().not() then
      !pipeRefs.append(!pipeRef)
    endif
  enddo

  if !pipeRefs.empty().not() then
    !volume = object VOLUME(!pipeRefs)
    !this.zoom(!volume)
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickZoomToSpool
--
-- Description: zoom to the selected pipe spool
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickZoomToSpool()

  !components = object ARRAY()

  !spool = !this.fabCheckCtrl.getSelectedSpool()

  !names = !spool.arriveBoundaries()
  do !name values !names
    !component = !name.dbref()
    handle ANY
      !component = object DBREF()
    endhandle
    if !component.badref().not() then
      !components.append(!component)
    endif
  enddo

  !names = !spool.leaveBoundaries()
  do !name values !names
    !component = !name.dbref()
    handle ANY
      !component = object DBREF()
    endhandle
    if !component.badref().not() then
      !components.append(!component)
    endif
  enddo

  !namesByBranch = !spool.allComponents()
  do !names values !namesByBranch
    do !name values !names
      !component = !name.dbref()
      handle ANY
        !component = object DBREF()
      endhandle
      if !component.badref().not() then
        !components.append(!component)
      endif
    enddo
  enddo

  !this.zoom(object VOLUME(!components))
endmethod

