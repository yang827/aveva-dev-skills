--
-- Method:      onClickNavigateToPipe
--
-- Description: navigate the selected pipe in the design hierarchy
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickNavigateToPipe()
  !pipeRefs = object ARRAY()

  !pipes = !this.fabCheckCtrl.getSelectedPipes()
  do !pipe values !pipes
    !pipeRef = !pipe.name().dbref()
    if !pipeRef.badref().not() then
      !pipeRefs.append(!pipeRef)
    endif
  enddo

  !!ce = !pipeRefs.last()

endmethod

