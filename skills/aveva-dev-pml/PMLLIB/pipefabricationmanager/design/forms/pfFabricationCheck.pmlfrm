--
-- Method:      refreshPipeList
--
-- Description: refresh the pipe grid control
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickAddCE()
  !scopeRef = PIPE
  handle (2,111)
    --Cannot access element type PIPE
    if !!ce.type.neq('SITE') and !!ce.type.neq('ZONE') then
      !!alert.message('Select SITE or ZONE!')
      return
    endif

    !scopeRef = !!ce
  endhandle

  !this.parCE.val = !scopeRef.name
  !this.fabCheckCtrl.selectPipes(!scopeRef.name)

endmethod

