--------------------------------------------------------------------------------
--
-- Method:      onClickApplyDefaultMachines
--
-- Description: apply the selected fabrication machines to default and save them to file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickApplyDefaultMachines()
  !this.machineTree.saveDefaults()
  !modified = !this.getDefaultFabricationMachines()

  if !modified then
    if !this.defaultMachineMode.eq('SPOOL') then
      !this.fabCheckCtrl.invalidatePipeSpools(false)
    elseif !this.defaultMachineMode.eq('PIECE') then
      !this.fabCheckCtrl.invalidatePipePieces(false)
    else
      !this.fabCheckCtrl.invalidatePipes(false)
    endif
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickDeletePipes
--
-- Description: delete all spool elements in the selected pipes
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickDeletePipes()

  -- Issue 95321
  !res = !!alert.confirm('OK to delete?')
  if !res.neq('YES') then
    return
  endif

  !undo = object UNDOABLE()
  !undo.description(|PF - Delete Spools|)
  !undo.add()

  !this.fabCheckCtrl.deleteSpoolInformation()
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  !undo.endUndoable()
endmethod



