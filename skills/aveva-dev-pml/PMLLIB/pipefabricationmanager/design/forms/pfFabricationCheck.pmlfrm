--
-- Description:     Form for pipe fabrication check
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyOptimizationPriorities()    -                   apply modified optimization priorities
--  changeMode(STRING)               -                   hide/show form controls according to the current mode (DEF, OPT, CHK)
--  createPartNo(DBREF)              -                   crate part no. for the given pipe
--  enableReleaseButton()            -                   enable or disable the ready button
--  getDefaultFabricationMachines()  BOOLEAN             get default fabrication machines user selected in the machine tree control
--  moveSelectedCriterionDown()      -                   move the selected optimization criterion down
--  moveSelectedCriterionUp()        -                   move the selected optimization criterion up
--  onCheckMessageSelected(ARRAY)    -
--  onClickAddCE()                   -                   add pipes under CE and populate the grid with them
--  onClickAddPipesTo3DView()        -                   add the selected pipes to the 3D view
--  onClickApplyDefaultMachines()    -                   apply default fabrication machines with the selected machines
--  onClickChangeSpoolType(STRING)   -                   modify the spool type of the selected spool with the given type
--  onClickDefaultFabricationMachines(STRING) -                   change mode to 'default fabrication machines'
--  onClickDeletePipePieces()        -                   delete selected pipe piece information
--  onClickDeletePipeSpools()        -                   delete selected pipe spool information
--  onClickDeletePipes()             -                   delete all spools in the selected pipes
--  onClickHighlightPipePiece()      -                   highlight the selected pipe piece
--  onClickHighlightSpool()          -                   highlight the selected pipe spool
--  onClickModifySpoolName()         -                   modify spool name by manually
--  onClickNavigateToPipe()          -                   navigate the selected pipe in the design hierarchy
--  onClickNavigateToPipePiece()     -                   navigate the selected pipe piece in the design hierarchy
--  onClickNavigateToSpool()         -                   navigate the selected pipe spool in the design hierarchy
--  onClickOptimizationPriorities()  -                   change mode to 'optimization priorities'
--  onClickReleasePipeSpools()       -                   release selected spools
--  onClickReleasePipes()            -                   callback called when the ready release is clicked
--  onClickRemoveAll()               -                   remove all pipes from the grid control
--  onClickRemovePipesFrom3DView()   -                   remove the selected pipes from 3D view
--  onClickRemoveSelectedPipes()     -                   remove selected pipes from the grid control
--  onClickRenameAllSpools()         -                   rename all spools in the selected pipe
--  onClickRenameSpools()            -                   rename the selected spool
--  onClickSelectAllPipes()          -                   select all pipes in the grid
--  onClickSelectDefaultMachinesFromCE() -                   select default fabrication machines from CE
--  onClickUnselectAllPipes()        -                   unselect all pipes in the grid
--  onClickValidatePipePiece(BOOLEAN,BOOLEAN,BOOLEAN) -                   validate selected pipe piece
--  onClickValidatePipeSpool(BOOLEAN,BOOLEAN,BOOLEAN) -                   validate selected pipe spool
--  onClickValidatePipes(BOOLEAN,BOOLEAN,BOOLEAN) -                   validate the selected pipes for fabrication
--  onClickZoomToPipe()              -                   zoom to the selected pipe in the 3D view
--  onClickZoomToPipePiece()         -                   zoom to the selected pipe piece in the 3D view
--  onClickZoomToSpool()             -                   zoom to the selected pipe spool in the 3D view
--  onDetailSelected(ARRAY)          -                   display information about the selected check result item in 3D view
--  onInitialize()                   -                   initialize form
--  onKill()                         -                   called when the form is destroyed
--  onPipePieceSelected(ARRAY)       -                   called when a pipe piece is selected
--  onPipeSelected(ARRAY)            -                   called when a pipe is selected
--  onPipeSpoolSelected(ARRAY)       -                   called when a pipe spool is selected
--  onQuit()                         -                   quit form
--  onShowPopup(ARRAY)               -                   show a context menu
--  optimizationPrioritySelected()   -                   called when an optimization criterion is selected
--  pfFabricationCheck()             -                   constructor
--  refreshOptimizationPriorities(ARRAY) -                   refresh the list for optimization priorities with the given priority values
--  resetOptimizationPriorities()    -                   reset optimization priorities with the global values
--  zoom(VOLUME)                     -                   zoom to the given volume
--
--------------------------------------------------------------------------------
import 'GridControl'
handle any
endhandle

import 'PMLFileBrowser'
handle any
endhandle

import 'PipeFabricationAddin'
handle ANY
endhandle

-- Define form
setup form !!pfFabricationCheck dialog dock right varchars

  using namespace 'Aveva.Pdms.Presentation'
  using namespace 'Aveva.Pdms.PipeFabrication.FabricationCheck'

  !this.formTitle   = 'Fabrication Check'
  !this.initcall    = '!this.onInitialize()'
  !this.quitCall    = '!this.onQuit()'
  !this.killingCall = '!this.onKill()'

  --track 'DBCHANGED' call '!this.trackDbChanged()'

  button .btnAddCE 'Add CE' callback '!this.onClickAddCE()' wid 7
  para .parCE anchor l+t+r text '<none>' wid 24.5
  button .btnValidate 'Validate' callback '!this.onClickValidatePipes(false, false, false)' anchor t+r wid 7 tooltip 'Check selected pipes for fabrication'
  button .btnRelease 'Release' callback '!this.onClickReleasePipes()' anchor t+r wid 7 tooltip 'Make selected pipes ready'

  path down
  container .netCtrlFabCheck nobox PMLNETCONTROL '' anchor all at xmin.btnAddCE wid 50 hei 25

  toggle .togZoom 'Zoom when selected' anchor l+b
  button .btnModifySpool linkl 'Modify Spool...' at xmax.togZoom ymin.togZoom form !!pfModifySpool anchor l+b
  -- Fix for Issue 94884
  button .btnWeldHandling linkl 'Weld Handling...'at xmax.btnModifySpool ymin.togZoom form !!pfWeldHandling anchor l+b
  path down
  button .btnDefaultMachines linkl 'Select Default Fabrication Machines' at xmin.togZoom callback '!this.onClickDefaultFabricationMachines(|PIPE|)' anchor l+b

  -- define gadgets for default machines
  para .parMachineTree at xmin.netCtrlFabCheck ymin.netCtrlFabCheck anchor l+t text 'Select Default Fabrication Machines'
  container .netControlMachineTree PMLNETCONTROL 'Machine Tree' anchor l+r+t at ymax.parMachineTree - 0.2 wid 50 hei 15
  button .btnDefaultMachinesFromPipe linkl 'Select machines from current element' callback '!this.onClickSelectDefaultMachinesFromCE()' anchor l+t
  path right
  button .btnApplyDefaultMachines 'Apply' callback '!this.onClickApplyDefaultMachines()' at x 33.5 anchor r+t wid 7
  button .btnCancelDefaultMachines 'Back' callback '!this.changeMode(||)' anchor r+t wid 7
  --//

  path down
  para .parOptimization at xmin.netCtrlFabCheck ymin.netCtrlFabCheck anchor l+r+t text 'Optimization Priorities' wid 30
  list .lstOptimizationPriority at ymax.parOptimization - 0.2 callback '!this.optimizationPrioritySelected()' anchor l+r+t width 48 height 8
  button .btnMovePriorityUp   'Up'    anchor l+t callback '!this.moveSelectedCriterionUp()'   wid 7
  path right
  button .btnMovePriorityDown 'Down'  at ymin.btnMovePriorityUp  callback '!this.moveSelectedCriterionDown()'anchor l+t wid 7
  button .btnResetPriorities  'Reset' at xmax.btnMovePriorityDown + 8.5 ymin.btnMovePriorityUp callback '!this.resetOptimizationPriorities()' anchor t+r wid 7
  button .btnApplyPriorities  'Apply' at ymin.btnMovePriorityUp callback '!this.applyOptimizationPriorities()' anchor t+r wid 7
  button .btnClosePriorities  'Back'  at ymin.btnMovePriorityUp callback '!this.changeMode(||)' anchor t+r wid 7


  member .fabCheckCtrl            is PIPEFABRICATIONCONTROL

  member .machineTree             is MACHINETREECONTROL

  member .aidNoForResult          is REAL

  member .defaultMachineMode      is STRING

exit

--------------------------------------------------------------------------------
--
-- Method:      pfFabricationCheck
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfFabricationCheck()

  -- initialise grid controls

  using namespace 'Aveva.Pdms.Presentation'
  using namespace 'Aveva.Pdms.PipeFabrication.FabricationCheck'

  !this.fabCheckCtrl = object PIPEFABRICATIONCONTROL()
  !this.fabCheckCtrl.addEventHandler('OnPipeSelected',         !this, 'onPipeSelected')
  !this.fabCheckCtrl.addEventHandler('OnPipeSpoolSelected',    !this, 'onPipeSpoolSelected')
  !this.fabCheckCtrl.addEventHandler('OnPipePieceSelected',    !this, 'onPipePieceSelected')
  !this.fabCheckCtrl.addEventHandler('OnCheckMessageSelected', !this, 'onCheckMessageSelected')
  !this.fabCheckCtrl.addEventHandler('OnDetailSelected',       !this, 'onDetailSelected')
  !this.fabCheckCtrl.addEventHandler('OnPopup',                !this, 'onShowPopup')
  !this.netCtrlFabCheck.control = !this.fabCheckCtrl.handle()

  !this.newMenu('pipePopup')
  !this.pipePopup.add('CALLBACK', 'Validate Pipes',             '!this.onClickValidatePipes(false, false, false)',   'CHECK_PIPES')
  !this.pipePopup.add('CALLBACK', 'Validate Pipes With...',     '!this.onClickValidatePipes(false, false, true)',    'CHECK_PIPES_WITH')
  !this.pipePopup.add('CALLBACK', 'Set to Manually Bent',       '!this.onClickValidatePipes(true, false, false)',    'MANUAL_PIPE')
  !this.pipePopup.add('CALLBACK', 'Set to Miminum Feed Excess', '!this.onClickValidatePipes(false, true, false)',    'APPLY_FEED_EXCESS')
  !this.pipePopup.add('CALLBACK', 'Select Default Fabrication Machines', '!this.onClickDefaultFabricationMachines(|PIPE|)', 'DEF_MACH_PIPE')
  !this.pipePopup.add('CALLBACK', 'Release',                    '!this.onClickReleasePipes()',            'RELEASE_PIPES')
  !this.pipePopup.add('CALLBACK', 'Delete Spool Information',   '!this.onClickDeletePipes()',             'DELETE_SPOOLS')
  -- Fix Issue 97671
  !this.pipePopup.add('SEPARATOR')
  !this.pipePopup.add('CALLBACK', 'Add CE',                     '!this.onClickAddCE()',                    'ADD_CE')
  !this.pipePopup.add('CALLBACK', 'Remove Selected',            '!this.onClickRemoveSelectedPipes()',      'REMOVE_SELECTED')
  !this.pipePopup.add('CALLBACK', 'Remove All',                 '!this.onClickRemoveAll()',                'REMOVE_ALL')
  --//

  !this.pipePopup.add('SEPARATOR')
  !this.pipePopup.add('CALLBACK', 'Select All',                 '!this.onClickSelectAllPipes()',          'SELECT_ALL')
  !this.pipePopup.add('CALLBACK', 'Unselect All',               '!this.onClickUnselectAllPipes()',        'UNSELECT_ALL')
  !this.pipePopup.add('SEPARATOR')
  !this.pipePopup.add('CALLBACK', 'Add to 3D View',             '!this.onClickAddPipesTo3DView()',        'ADD_TO_3DVIEW')
  !this.pipePopup.add('CALLBACK', 'Remove from 3D View',        '!this.onClickRemovePipesFrom3DView()',   'REMOVE_FROM_3DVIEW')
  !this.pipePopup.add('SEPARATOR')
  !this.pipePopup.add('CALLBACK', 'Optimization Priorities', '!this.onClickOptimizationPriorities()',     'OPTIMIZATION')
  !this.pipePopup.add('SEPARATOR')
  !this.pipePopup.add('CALLBACK', 'Zoom To',                    '!this.onClickZoomToPipe()',              'ZOOM_TO')
  !this.pipePopup.add('CALLBACK', 'Navigate To',                '!this.onClickNavigateToPipe()',          'NAVIGATE_TO')
  --!this.netControlPipes.popup = !this.pipePopup

  !this.newMenu('spoolPopup')
  --!this.spoolPopup.add('TOGGLE',    'Show All Excesses',         '!this.onClickShowAllExcessesInSpool()',  'SHOW_EXCESSES')

  !this.spoolPopup.add('CALLBACK',  'Validate Spools',          '!this.onClickValidatePipeSpool(false,false,false)',   'CHECK_SPOOL')
  !this.spoolPopup.add('CALLBACK',  'Validate Spools With...',  '!this.onClickValidatePipeSpool(false,false, true)',    'CHECK_SPOOL_WITH')
  !this.spoolPopup.add('CALLBACK',  'Set to Manually Bent',     '!this.onClickValidatePipeSpool(true, false, false)',    'MANUAL_SPOOL')
  !this.spoolPopup.add('CALLBACK',  'Set to Miminum Feed Excess', '!this.onClickValidatePipeSpool(false, true, false)',    'APPLY_FEED_EXCESS')
  !this.spoolPopup.add('CALLBACK',  'Select Default Fabrication Machines', '!this.onClickDefaultFabricationMachines(|SPOOL|)', 'DEF_MACH_SPOOL')
  !this.spoolPopup.add('CALLBACK',  'Release',                  '!this.onClickReleasePipeSpools()',       'RELEASE_SPOOLS')
  !this.spoolPopup.add('CALLBACK',  'Delete Spool Information', '!this.onClickDeletePipeSpools()',            'DELETE_SPOOLS')
  !this.spoolPopup.add('SEPARATOR')
  !this.spoolPopup.add('CALLBACK',  'Modify Name...',           '!this.onClickModifySpoolName()',         'MODIFY_SPOOL_NAME')
  !this.spoolPopup.add('CALLBACK',  'Rename Spools',            '!this.onClickRenameSpools()',            'RENAME_SPOOLS')
  !this.spoolPopup.add('CALLBACK',  'Rename All Spools',        '!this.onClickRenameAllSpools()',         'RENAME_ALL_SPOOLS')
  !this.spoolPopup.add('SEPARATOR')
  !this.spoolPopup.add('TOGGLE',    'Change Spool Type (SHOP)', '!this.onClickChangeSpoolType(|SHOP|)',   'SPOOL_TYPE_SHOP')
  !this.spoolPopup.add('TOGGLE',    'Change Spool Type (FITT)', '!this.onClickChangeSpoolType(|FITT|)',   'SPOOL_TYPE_FITT')
  !this.spoolPopup.add('TOGGLE',    'Change Spool Type (SITE)', '!this.onClickChangeSpoolType(|SITE|)',   'SPOOL_TYPE_SITE')
  !this.spoolPopup.add('SEPARATOR')
  !this.spoolPopup.add('CALLBACK',  'Zoom To',                  '!this.onClickZoomToSpool()',             'ZOOM_TO')
  !this.spoolPopup.add('CALLBACK',  'Navigate To',              '!this.onClickNavigateToSpool()',         'NAVIGATE_TO')
  !this.spoolPopup.add('CALLBACK',  'Highlight',                '!this.onClickHighlightSpool()',          'HIGHLIGHT_SPOOL')
  --!this.netControlSpools.popup = !this.spoolPopup

  !this.newMenu('piecePopup')
  !this.piecePopup.add('CALLBACK', 'Validate Pipe Pieces',      '!this.onClickValidatePipePiece(false, false, false)',   'CHECK_PIECE')
  !this.piecePopup.add('CALLBACK', 'Validate Pipe Pieces With...', '!this.onClickValidatePipePiece(false, false, true)',    'CHECK_PIECE_WITH')
  !this.piecePopup.add('CALLBACK', 'Set to Manually Bent',      '!this.onClickValidatePipePiece(true, false, false)',    'MANUAL_PIECE')
  !this.piecePopup.add('CALLBACK', 'Set to Miminum Feed Excess', '!this.onClickValidatePipePiece(false, true,false)',   'APPLY_FEED_EXCESS')
  !this.piecePopup.add('CALLBACK', 'Select Default Fabrication Machines', '!this.onClickDefaultFabricationMachines(|PIECE|)', 'DEF_MACH_PIECE')
  !this.piecePopup.add('CALLBACK', 'Delete Piece Information', '!this.onClickDeletePipePieces()',        'DELETE_PIECES')
  !this.piecePopup.add('SEPARATOR')
  --!this.piecePopup.add('TOGGLE', 'Show All Excesses',     '!this.onClickShowAllExcessesInPipePiece()',  'SHOW_EXCESSES')
  --!this.piecePopup.add('SEPARATOR')
  !this.piecePopup.add('CALLBACK', 'Zoom To',                   '!this.onClickZoomToPipePiece()',             'ZOOM_TO')
  !this.piecePopup.add('CALLBACK', 'Navigate To',               '!this.onClickNavigateToPipePiece()',         'NAVIGATE_TO')
  !this.piecePopup.add('CALLBACK', 'Highlight',                 '!this.onClickHighlightPipePiece()',          'HIGHLIGHT_PIECE')
  --!this.netControlPipePieces.popup = !this.piecePopup

  !this.aidNoForResult = !!aidNumbers.add('Pipe Fabrication Check Result')

  !this.btnValidate.active = false
  --!this.btnStop.active  = false

  !this.machineTree = object MACHINETREECONTROL()
  !this.netControlMachineTree.control = !this.machineTree.handle()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onShowPipePopupMenu
--
-- Description: shows a context menu for pipes
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onShowPopup(!data is ARRAY)

  using namespace 'Aveva.Pdms.PipeFabrication.FabricationCheck'

  if !data.unset() then
    return
  endif

  !x = !data[0]
  !y = !data[1]
  !type = !data[2]

  !this.pipePopup.setFieldProperty('APPLY_FEED_EXCESS', 'ACTIVE', !!pfContext.allowFeedExcess.not())
  !this.spoolPopup.setFieldProperty('APPLY_FEED_EXCESS', 'ACTIVE', !!pfContext.allowFeedExcess.not())
  !this.piecePopup.setFieldProperty('APPLY_FEED_EXCESS', 'ACTIVE', !!pfContext.allowFeedExcess.not())

  if !type.eq('PIPE') then

    !pipes = !this.fabCheckCtrl.getSelectedPipes()

    !acceptable = true
    do !i indices !pipes
      !status = !pipes[!i].fabricationStatus()
      if !status.neq('ValidWithWarning') and !status.neq('ValidForFabrication') and !status.neq('ReadyForFabrication') then
        !acceptable = false
        break
      endif
    enddo

    -- Fix Issue 97390
    !spoolOrPieceExists = false
    do !i indices !pipes
      !spools = !pipes[!i].pipeSpools()
      do !j indices !spools
        !name = !spools[!j].pspoolElement()
        !pspoolRef = !name.dbref()
        handle ANY
        elsehandle NONE
          !spoolOrPieceExists = !pspoolRef.badref().not()
        endhandle

        break if !spoolOrPieceExists

        !pieces = !spools[!j].pipePieces()
        do !k indices !pieces
          !name = !pieces[!k].ppieceElement()
          !ppieceRef = !name.dbref()
          handle ANY
          elsehandle NONE
            !spoolOrPieceExists = !ppieceRef.badref().not()
          endhandle

          break if !spoolOrPieceExists
        enddo

        break if !spoolOrPieceExists
      enddo
    enddo
    --//

    !containsBends = false
    if !pipes.size().eq(1) then
      !spools = !pipes[1].pipeSpools()
      do !i indices !spools
        !pieces = !spools[!i].pipePieces()
        do !j indices !pieces
          if !pieces[!j].bendComponents().size().gt(0) then
            !containsBends = true
            break
          endif
        enddo

        if !containsBends then
          break
        endif
      enddo
    endif

    !pipeSelected = !pipes.empty().not()

    !pipeCount = !this.fabCheckCtrl.pipeCount()

    --!this.pipePopup.setFieldProperty('ADD_CE',         'ACTIVE', !pipeSelected)
    !this.pipePopup.setFieldProperty('REMOVE_SELECTED',       'ACTIVE', !pipeSelected)
    !this.pipePopup.setFieldProperty('REMOVE_ALL',            'ACTIVE', !pipeCount.gt(0))
    !this.pipePopup.setFieldProperty('ADD_TO_3DVIEW',         'ACTIVE', !pipeSelected)
    !this.pipePopup.setFieldProperty('REMOVE_FROM_3DVIEW',    'ACTIVE', !pipeSelected)
    !this.pipePopup.setFieldProperty('ZOOM_TO',               'ACTIVE', !pipeSelected)
    !this.pipePopup.setFieldProperty('CHECK_PIPES',           'ACTIVE', !pipeSelected)
    !this.pipePopup.setFieldProperty('CHECK_PIPES_WITH',      'ACTIVE', !pipeSelected)
    !this.pipePopup.setFieldProperty('DEF_MACH_PIPE',         'ACTIVE', !pipeSelected)
    !this.pipePopup.setFieldProperty('RELEASE_PIPES',         'ACTIVE', !acceptable)
    !this.pipePopup.setFieldProperty('NAVIGATE_TO',           'ACTIVE', !pipeSelected)
    !this.pipePopup.setFieldProperty('DELETE_SPOOLS',         'ACTIVE', !pipeSelected.and(!spoolOrPieceExists))
    !this.pipePopup.setFieldProperty('MANUAL_PIPE',           'ACTIVE', !pipeSelected.and(!containsBends))
    !this.netCtrlFabCheck.popup = !this.pipePopup
    !this.netCtrlFabCheck.showPopup(!x, !y)

  elseif !type.eq('SPOOL') then

    !spool = !this.fabCheckCtrl.getSelectedSpool()
    !spoolSelected = !spool.set()
    !pspoolExists = false
    !spoolType = ''

    !name = !spool.pspoolElement()
    if !name.empty().not() then
      !pspoolRef = !name.dbref()
      handle ANY
      elsehandle NONE
        if !pspoolRef.badref().not() then
          !pspoolExists = true
          !spoolType = !pspoolRef.pstyp
        endif
      endhandle
    endif

    !containsBends = false
    !pieces = !spool.pipePieces()
    do !i indices !pieces
      if !pieces[!i].bendComponents().size().gt(0) then
        !containsBends = true
        break
      endif
    enddo

    !status = !spool.fabricationStatus()
    !acceptable = !status.eq('ValidWithWarning') or !status.eq('ValidForFabrication') or !status.eq('ReadyForFabrication')

    !this.spoolPopup.setFieldProperty('CHECK_SPOOL',      'ACTIVE',   !spoolSelected)
    !this.spoolPopup.setFieldProperty('CHECK_SPOOL_WITH', 'ACTIVE',   !spoolSelected)
    !this.spoolPopup.setFieldProperty('DEF_MACH_SPOOL',   'ACTIVE',   !spoolSelected)
    !this.spoolPopup.setFieldProperty('SPOOL_TYPE_SHOP',  'ACTIVE',   !spoolType.empty().not())
    !this.spoolPopup.setFieldProperty('SPOOL_TYPE_FITT',  'ACTIVE',   !spoolType.empty().not())
    !this.spoolPopup.setFieldProperty('SPOOL_TYPE_SITE',  'ACTIVE',   !spoolType.empty().not())
    !this.spoolPopup.setFieldProperty('SPOOL_TYPE_SHOP',  'SELECTED', !spoolType.eq('SHOP'))
    !this.spoolPopup.setFieldProperty('SPOOL_TYPE_FITT',  'SELECTED', !spoolType.eq('FITT'))
    !this.spoolPopup.setFieldProperty('SPOOL_TYPE_SITE',  'SELECTED', !spoolType.eq('SITE'))

    --!autoNaming = !!namOpt.auto
    !autoNaming = !!pfContext.autoNamingRules

    !this.spoolPopup.setFieldProperty('MODIFY_SPOOL_NAME',  'ACTIVE', !spoolSelected.and(!pspoolExists))
    !this.spoolPopup.setFieldProperty('RENAME_SPOOLS',      'ACTIVE', !spoolSelected.and(!pspoolExists).and(!autoNaming))
    !this.spoolPopup.setFieldProperty('RENAME_ALL_SPOOLS',  'ACTIVE', !pspoolExists.and(!autoNaming))
    !this.spoolPopup.setFieldProperty('RELEASE_SPOOLS',     'ACTIVE', !spoolSelected.and(!acceptable))
    !this.spoolPopup.setFieldProperty('DELETE_SPOOLS',      'ACTIVE', !spoolSelected.and(!pspoolExists))
    !this.spoolPopup.setFieldProperty('MANUAL_SPOOL',       'ACTIVE', !spoolSelected.and(!containsBends))
    !this.spoolPopup.setFieldProperty('ZOOM_TO',            'ACTIVE', !spoolSelected)
    !this.spoolPopup.setFieldProperty('NAVIGATE_TO',        'ACTIVE', !pspoolExists)
    !this.spoolPopup.setFieldProperty('HIGHLIGHT_SPOOL',    'ACTIVE', !spoolSelected)
    !this.netCtrlFabCheck.popup = !this.spoolPopup
    !this.netCtrlFabCheck.showPopup(!x, !y)

  elseif !type.eq('PIECE') then

    !piece = !this.fabCheckCtrl.getSelectedPipePiece()
    !pieceSelected = !piece.set()
    !containsBends = !piece.bendComponents().empty().not()
    !ppieceExists = false

    !name = !piece.ppieceElement()
    if !name.empty().not() then
      !ppieceRef = !name.dbref()
      handle ANY
      elsehandle NONE
        if !ppieceRef.badref().not() then
          !ppieceExists = true
        endif
      endhandle
    endif

    --!status = !piece.fabricationStatus()
    --!acceptable = !status.eq('ValidWithWarning') or !status.eq('ValidForFabrication') or !status.eq('ReadyForFabrication')

    !this.piecePopup.setFieldProperty('CHECK_PIECE',        'ACTIVE', !pieceSelected)
    !this.piecePopup.setFieldProperty('CHECK_PIECE_WITH',   'ACTIVE', !pieceSelected)
    !this.piecePopup.setFieldProperty('DEF_MACH_PIECE',     'ACTIVE', !pieceSelected)
    !this.piecePopup.setFieldProperty('DELETE_PIECES',      'ACTIVE', !pieceSelected.and(!ppieceExists))
    !this.piecePopup.setFieldProperty('MANUAL_PIECE',       'ACTIVE', !pieceSelected.and(!containsBends))
    !this.piecePopup.setFieldProperty('ZOOM_TO',            'ACTIVE', !pieceSelected)
    !this.piecePopup.setFieldProperty('NAVIGATE_TO',        'ACTIVE', !ppieceExists)
    !this.piecePopup.setFieldProperty('HIGHLIGHT_PIECE',    'ACTIVE', !pieceSelected)
    !this.netCtrlFabCheck.popup = !this.piecePopup
    !this.netCtrlFabCheck.showPopup(!x, !y)

  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      optimizationPrioritySelected
--
-- Description: called whenever an optimization priority item is selected
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .optimizationPrioritySelected()
  !this.btnMovePriorityUp.active = !this.lstOptimizationPriority.val.gt(1)
  !this.btnMovePriorityDown.active = !this.lstOptimizationPriority.val.lt(!this.lstOptimizationPriority.count)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      refreshOptimizationPriorities
--
-- Description: populate the optimization priority grid with the given order
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .refreshOptimizationPriorities(!priorities is ARRAY)

  !descriptions = object ARRAY()
  -- Issue 94897(SI-56401), change wording
  !descriptions[1] = 'Maximize pre-welded flanges'
  !descriptions[2] = 'Minimize cut length'
  !descriptions[3] = 'Minimize pipe overhang'
  !descriptions[4] = 'Single, pre-welded flanges not clutched'
  !descriptions[5] = 'Maximize machine extrusions'

  !criteria = object ARRAY()
  !criteria[1] = 'MAX_PREWELD_FLANGE'
  !criteria[2] = 'MIN_SAW_LEN'
  !criteria[3] = 'MIN_LEN_OUT_MACH'
  !criteria[4] = 'PUT_FLANGE_OUT'
  !criteria[5] = 'MAX_MACH_EXTRUSION'

  !headings = object ARRAY()
  !headings[1] = 'Priority'
  !headings[2] = 'Criteria'
  !this.lstOptimizationPriority.setHeadings(!headings)

  !rows  = object ARRAY()
  do !i indices !priorities
    !row = object ARRAY()
    !row[1] = !i.string()

    !index = !criteria.findFirst(!priorities[!i])
    !row[2] = !descriptions[!index]
    !rows.append(!row)
  enddo

  !this.lstOptimizationPriority.setRows(!rows)
  !this.lstOptimizationPriority.rtext = !priorities

endmethod

--------------------------------------------------------------------------------
--
-- Method:      moveSelectedCriterionUp
--
-- Description: move the selected optimization criterion up
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .moveSelectedCriterionUp()
  if !this.lstOptimizationPriority.val.lt(2) then
    return
  endif

  !this.btnApplyPriorities.active = true

  !index = !this.lstOptimizationPriority.val
  !rtext = !this.lstOptimizationPriority.rtext

  !previous = !rtext[!index - 1]
  !rtext[!index - 1] = !rtext[!index]
  !rtext[!index] = !previous

  !this.refreshOptimizationPriorities(!rtext)
  !this.lstOptimizationPriority.val = !index - 1
  !this.lstOptimizationPriority.setFocus()

  !this.optimizationPrioritySelected()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      applyOptimizationPriorities
--
-- Description: update optimization priorities of the fabrication machine manager
--              with the current priority order
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .applyOptimizationPriorities()
  !priorities = !this.lstOptimizationPriority.rtext
  !this.fabCheckCtrl.optimizationPriorities(!priorities)
  !this.btnApplyPriorities.active = false
endmethod

--------------------------------------------------------------------------------
--
-- Method:      resetOptimizationPriorities
--
-- Description: reset optimization priorities
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .resetOptimizationPriorities()
  !this.refreshOptimizationPriorities(!!pfContext.optimizationPriorities)
  if !this.lstOptimizationPriority.rtext.empty().not() then
    !this.lstOptimizationPriority.val = 1
  endif
  !this.optimizationPrioritySelected()
  !this.btnApplyPriorities.active = false
endmethod

--------------------------------------------------------------------------------
--
-- Method:      moveSelectedCriterionDown
--
-- Description: move the selected item down
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .moveSelectedCriterionDown()
  if !this.lstOptimizationPriority.val.gt(!this.lstOptimizationPriority.count - 1) then
    return
  endif

  !this.btnApplyPriorities.active = true

  !index = !this.lstOptimizationPriority.val
  !rtext = !this.lstOptimizationPriority.rtext

  !next = !rtext[!index + 1]
  !rtext[!index + 1] = !rtext[!index]
  !rtext[!index] = !next

  !this.refreshOptimizationPriorities(!rtext)
  !this.lstOptimizationPriority.val = !index + 1
  !this.lstOptimizationPriority.setFocus()

  !this.optimizationPrioritySelected()

endmethod


