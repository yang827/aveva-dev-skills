--------------------------------------------------------------------------------
--
-- Method:      onClickNavigateToSpool
--
-- Description: navigate the selected spool in the design hierarchy
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickNavigateToSpool()

  !spool = !this.fabCheckCtrl.getSelectedSpool()
  if !spool.set() then
    !name = !spool.pspoolElement()
    !pspoolRef = !name.dbref()
    handle ANY
    elsehandle NONE
      if !pspoolRef.badref().not() then
        !!ce = !pspoolRef
      endif
    endhandle
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickNavigateToPipePiece
--
-- Description: navigate the selected pipe piece in the design hierarchy
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickNavigateToPipePiece()
  !piece = !this.fabCheckCtrl.getSelectedPipePiece()
  if !piece.set() then
    !ppieceRef = !piece.ppieceElement().dbref()
    handle ANY
    elsehandle NONE
      if !ppieceRef.badref().not() then
        !!ce = !ppieceRef
      endif
    endhandle
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onInitialize
--
-- Description: initialize this form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onInitialize()

  if defined(!!pfContext) then
    !!pfContext.delete()
  endif

  !context = object PFCONTEXT()
  !context.globalInstance()

  !this.changeMode('')

  !this.machineTree.loadDefaults()
  !this.getDefaultFabricationMachines()

  !this.fabCheckCtrl.optimizationPriorities(!!pfContext.optimizationPriorities)

  !this.fabCheckCtrl.removeAllPipes()

  !this.onClickAddCE()
  !this.enableReleaseButton()

  !this.fabCheckCtrl.subscribeDbChanges(true)

endmethod


--------------------------------------------------------------------------------
--
-- Method:      getDefaultFabricationMachines
--
-- Description: get default fabrication machines user selected in the machine tree control
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .getDefaultFabricationMachines() is BOOLEAN

  !newBendingMachines = !this.machineTree.getDefaultBendingMachines()
  !oldBendingMachines = !this.fabCheckCtrl.defaultBendingMachines()
  !this.fabCheckCtrl.defaultBendingMachines(!newBendingMachines)

  !newWeldingMachines = !this.machineTree.getDefaultWeldingMachines()
  !oldWeldingMachines = !this.fabCheckCtrl.defaultWeldingMachines()
  !this.fabCheckCtrl.defaultWeldingMachines(!newWeldingMachines)

  !newExtrusionMachines = !this.machineTree.getDefaultExtrusionMachines()
  !oldExtrusionMachines = !this.fabCheckCtrl.defaultExtrusionMachines()
  !this.fabCheckCtrl.defaultExtrusionMachines(!newExtrusionMachines)

  return !newBendingMachines.size().neq(!oldBendingMachines.size()) or  $
         !newWeldingMachines.size().neq(!oldWeldingMachines.size()) or  $
         !newExtrusionMachines.size().neq(!oldExtrusionMachines.size()) or  $
         !newBendingMachines.intersect(!oldBendingMachines).size().neq(!newBendingMachines.size()) or $
         !newWeldingMachines.intersect(!oldWeldingMachines).size().neq(!newWeldingMachines.size()) or $
         !newExtrusionMachines.intersect(!oldExtrusionMachines).size().neq(!newExtrusionMachines.size())

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onQuit
--
-- Description: quit this form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onQuit()

  !this.fabCheckCtrl.removeAllPipes()
  handle ANY
  endhandle

  !this.fabCheckCtrl.subscribeDbChanges(false)
  handle ANY
  endhandle

  !!aidNumbers.hide(!this.aidNoForResult)
  handle ANY
  endhandle

  UNENHANCE ALL
  handle ANY
  endhandle
endmethod

