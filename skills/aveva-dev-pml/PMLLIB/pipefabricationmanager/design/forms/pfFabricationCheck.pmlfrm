--------------------------------------------------------------------------------
--
-- Method:      onGridPipesAfterSelectChange
--
-- Description: the selected pipe is changed.
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onPipeSelected(!args is ARRAY)

  UNENHANCE ALL
  -- Fix Issue 97155
  handle ANY
    return
  endhandle
  --//

  if undefined(!args[0]) then
    return
  endif

  !pipe = !args[0]
  !pipeRef = !pipe.name().dbref()
  handle ANY
    return
  endhandle

  !this.btnValidate.active = true

  if !this.togZoom.val then
    ENHANCE $!pipeRef COLOUR $!!gphColOpt.highlight
    !this.zoom(object VOLUME(!pipeRef))
  endif

  !this.enableReleaseButton()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      enableReleaseButton
--
-- Description: enable/disable the release button
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .enableReleaseButton()
  !pipes = !this.fabCheckCtrl.getSelectedPipes()
  !acceptable = false
  if !pipes.empty() then
    !this.btnValidate.active = false
  else
    !this.btnValidate.active = true
    !acceptable = true
    do !i indices !pipes
      !status = !pipes[!i].fabricationStatus()
      if !status.neq('ValidWithWarning') then
        !acceptable = false
        break
      endif
    enddo
  endif

  !this.btnRelease.active = !acceptable
endmethod


--------------------------------------------------------------------------------
--
-- Method:      onGridPipePiecesAfterSelectChange
--
-- Description: called when the selected pipe piece is changed
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onPipePieceSelected(!args is ARRAY)

  if UNDEFINED(!args[0]) then
    return
  endif

  UNENHANCE ALL
  -- Fix Issue 97155
  handle ANY
    return
  endhandle
  --//

  !pipePiece = !args[0]

  ---aidNoForResult

  if !pipePiece.isPureMitrePiece() then
    !name = !pipePiece.arriveBoundary()

    !component = !name.dbref()
    handle ANY
    elsehandle NONE
      ENHANCE $!component COLOUR $!!gphColOpt.highlight

      !tagPosition = !component.position
      !tagText = 'Pipe Piece ' + !pipePiece.index().string()
      aid clear all $!<this.aidNoForResult>
      AID TEXT NUM $!this.aidNoForResult '$!tagText' AT $!tagPosition

    endhandle
  else

    !bendComponent = object DBREF()
    !names = !pipePiece.allComponents()
    do !name values !names

      !component = !name.dbref()
      handle ANY
      elsehandle NONE
        ENHANCE $!component COLOUR $!!gphColOpt.highlight

        if !bendComponent.badref() and !component.hardType.eq('BEND') then
          !bendComponent = !component
        endif
      endhandle
    enddo

    !tagPosition = object POSITION()
    if !bendComponent.badref() then

      !arriveBoundary = !pipePiece.arriveBoundary().dbref()
      handle ANY
        !arriveBoundary = object DBREF()
      endhandle
      !leaveBoundary = !pipePiece.leaveBoundary().dbref()
      handle ANY
        !leaveBoundary = object DBREF()
      endhandle

      if !arriveBoundary.badref().not() and !leaveBoundary.badref().not() then
        if !arriveBoundary.hardType.eq('BRAN') then
          !startPosition = !arriveBoundary.hposition
        else
          !startPosition = !arriveBoundary.lposition
          handle ANY
            !startPosition = !arriveBoundary.position
          endhandle
        endif
        if !leaveBoundary.hardType.eq('BRAN') then
          !endPosition = !leaveBoundary.tposition
        else
          !endPosition = !leaveBoundary.aposition
          handle ANY
            !endPosition = !leaveBoundary.position
          endhandle
        endif
        !tagPosition = !startPosition.midPoint(!endPosition)
      elseif !arriveBoundary.badref().not() then
        if !arriveBoundary.hardType.eq('BRAN') then
          !tagPosition = !arriveBoundary.hposition
        else
          !tagPosition = !arriveBoundary.lposition
          handle ANY
            !tagPosition = !arriveBoundary.position
          endhandle
        endif
      elseif !leaveBoundary.badref().not() then
        if !leaveBoundary.hardType.eq('BRAN') then
          !tagPosition = !leaveBoundary.tposition
        else
          !tagPosition = !leaveBoundary.aposition
          handle ANY
            !tagPosition = !leaveBoundary.position
          endhandle
        endif
      else
        -- ???
      endif

    else
      !tagPosition = !bendComponent.position
    endif

    if !tagPosition.set() then
      !tagText = 'Pipe Piece ' + !pipePiece.index().string()
      aid clear all $!<this.aidNoForResult>
      AID TEXT NUM $!this.aidNoForResult '$!tagText' AT $!tagPosition
    endif
  endif

  if !this.togZoom.val then
    --!this.zoom(object VOLUME(!components))
    !components = object ARRAY()
    !pipeSpool = !pipePiece.pipeSpool()
    !namesInSpool = !pipeSpool.allComponents()
    do !namesByBranch values !namesInSpool
      do !name values !namesByBranch
        !component = !name.dbref()
        handle ANY
        elsehandle NONE
          !components.append(!component)
        endhandle
      enddo
    enddo

    if !components.empty().not() then
      !this.zoom(object VOLUME(!components))
    endif

  endif
endmethod

