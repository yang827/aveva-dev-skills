--
-- Description:     Form for pipe end excess
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  displayCurrentGripLength()       -                   display Current Grip Length values with aid elements
--  displayFeedExcess()              -                   display feed excess in 3D view
--  onActionSetFeedExcess(ARRAY)     -                   give feed excess to the component picked by EDG
--  onClickApplyExcess()             -                   apply feed excess value
--  onClickResetExcess()             -                   reset feed excess value
--  onEscapeSetFeedExcess()          -                   clear aid elements and hide this form
--  onInitialize()                   -                   initialize form
--  onQuit()                         -                   quit form
--  pfFeedExcess()                   -                   constructor
--  setFeedExcess()                  -                   start an EDG process for feed excess value
--  validateExcessValue(GADGET,STRING) -                   validate the excess value given by user
--
--------------------------------------------------------------------------------
-- Define form
setup form !!pfFeedExcess dialog

  !this.formTitle  = 'Feed Excess'
  !this.initcall   = '!this.onInitialize()'
  !this.quitCall   = '!this.onQuit()'

  path down
  frame .frameFeedExcess '' wid 23
    text .txtFeedExcess 'Feed Excess' tagwid 10 callback '!this.validateExcessValue(' is REAL format !!distanceFmt
    para   .parCG text 'Current Grip' wid 9
    path right
    para .parCGVAL width 8
    path down
  exit

  button .btnApply 'Apply'     callback '!this.onClickApplyExcess()' width 6 APPLY
  path right
  button .btnResest 'Reset'    callback '!this.onClickResetExcess()' width 6 RESET
  button .btnDismiss 'Dismiss' callback '!this.onQuit()' width 6 CANCEL


  member  .bendRef              is DBREF

  member  .aidNumber            is REAL

  member  .undo                 is UNDOABLE

  member .tubiRefVal            is DBREF

exit

--------------------------------------------------------------------------------
--
-- Method:      pfFeedExcess
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfFeedExcess()

  --if defined(!!pfModifySpool) then
  --  !this.aidNumber = !!pfModifySpool.aidNoForFeedExcess
  --else
  --  !this.aidNumber = !!aidNumbers.add('PF - Feed Excess')
  --endif

  !this.aidNumber = !!fmSys.loadForm('pfModifySpool').aidNoForFeedExcess

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onInitialize
--
-- Description: initialize this form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onInitialize()

  !this.btnApply.active = false
  !this.txtFeedExcess.val = 0mm
  !this.bendRef = object DBREF()

  !!aidNumbers.hide(!this.aidNumber)
  !this.aidNumber = !!fmSys.loadForm('pfModifySpool').aidNoForFeedExcess

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onQuit
--
-- Description: quit form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onQuit()

  !!edgCntrl.remove('PF - Set Feed Excess')

  if defined(!!pfModifySpool) then
    !!pfModifySpool.refreshFeedExcesses()
  else
    UNENHANCE ALL
    --AID CLEAR TEXT $!this.aidNumber
    !!aidNumbers.hide(!this.aidNumber)
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      validateExcessValue
--
-- Description: validate the excess value provided by user
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      text gadget
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .validateExcessValue(!source is GADGET, !dummyString is STRING)
  !value = !source.val
  if !value.unset() or !value.lt(0mm) then
    !source.val = 0mm
  endif

endmethod


--------------------------------------------------------------------------------
--
-- Method:      setFeedExcess
--
-- Description: start an EDG process for feed excess value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     return false if no feed excess exists
--------------------------------------------------------------------------------
define method .setFeedExcess()

  !packet = object EDGPACKET()
  !packet.action = |!!pfFeedExcess.onActionSetFeedExcess(!this.return)|
  !packet.escape = |!!pfFeedExcess.onEscapeSetFeedExcess()|
  --!packet.definePosition('Pick part or <ESC> to finish')
  !packet.elementPick('Pick pipe component or <ESC> to finish')
  !packet.pickPacket.picks[1].pick.input[3] = |TYPE EQ 'TUBI' OR (TYPE EQ 'FTUB' AND SKEY EQ 'TUBE')|
  --!packet.pickPacket.picks[1].pick.input[5] = |FALSE|
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.description = 'PF - Set Feed Excess'
  !packet.remove = false
  --!packet.form = !!pfFeedExcess

  !!edgCntrl.add(!packet)

endmethod


--------------------------------------------------------------------------------
--
-- Method:      onActionSetFeedExcess
--
-- Description: give feed excess to the component picked by EDG
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       EDG data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onActionSetFeedExcess(!data is ARRAY)

  if !data.unset() OR !data.empty() then
    return
  endif

  !item = !data[1].item

  !tubiRef = IL TUB OF $!item
  handle ANY
    !!alert.error('Not a pipe tube!')
    return
  endhandle
  !this.tubiRefVal = !tubiRef

  !branchRef = !tubiRef.owner
  !i = !branchRef.npdesc.findFirst(!tubiRef)
  if !i.unset() then
    !!alert.error('Not a pipe tube!')
    return
  endif

  if !i.eq(1) or !i.eq(!branchRef.npdesc.size()) or !branchRef.npdesc[!i - 1].type.neq('BEND') or !branchRef.npdesc[!i + 1].type.neq('BEND') then
    !!alert.error('Not between bends!')
    return
  endif

  UNENHANCE ALL
  !!aidNumbers.hide(!this.aidNumber)

  !this.show('FREE')

  !this.txtFeedExcess.val = !item.usefed
  !this.bendRef = !item

  !this.btnApply.active = true

  !this.displayFeedExcess()
  !this.displayCurrentGripLength()
endmethod


--------------------------------------------------------------------------------
--
-- Method:      onEscapeSetFeedExcess
--
-- Description: clear aid elements and hide this form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onEscapeSetFeedExcess()

  UNENHANCE ALL
  --AID CLEAR TEXT $!this.aidNumber
  --handle ANY
  --  -- dummy
  --endhandle
  !!aidNumbers.hide(!this.aidNumber)

  !this.hide()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickApplyExcess
--
-- Description: apply the excess values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickApplyExcess()

  !this.undo.description('Set Feed Excess')
  !this.undo.add()

  !this.bendRef.usefed = !this.txtFeedExcess.val

  !this.undo.endUndoable()

  !this.displayFeedExcess()

  --if defined(!!pfModifySpool) then
  --  !!pfModifySpool.refreshFeedExcesses()
  --endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onClickResetExcess
--
-- Description: reset feed excess value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onClickResetExcess()
  !this.txtFeedExcess.val = 0mm

endmethod


--------------------------------------------------------------------------------
--
-- Method:      displayFeedExcess
--
-- Description: display feed excess values with aid elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .displayFeedExcess()

  UNENHANCE ALL

  --AID CLEAR TEXT $!this.aidNumber
  --handle ANY
  --endhandle
  !!aidNumbers.hide(!this.aidNumber)

  if !this.bendRef.badref().not() then
    !nextBendRef = NEXT BEND OF $!this.bendRef
    handle ANY
      return
    endhandle

    !tubiRef = IL TUB OF $!this.bendRef
    handle ANY
    elsehandle NONE
      ENHANCE $!tubiRef COL $!!<gphColOpt.highlight.code>
    endhandle

    !position = !this.bendRef.lposition.midPoint(!nextBendRef.aposition).wrt( /* )
    !feedExcess = !this.bendRef.usefed
    !feedString = 'Feed : ' + !feedExcess.string(!!distanceFmt)
    AID TEXT NUM $!this.aidNumber |$!feedString| AT $!position
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      .displayCurrentGripLength
--
-- Description: display Current Grip Length values with aid elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .displayCurrentGripLength()
    !result = object DBREF()

    !ref = !this.tubiRefVal

    !chkbndmcref = !!dtbgetownertype(!ref,|BRAN|).bendmacreference
    if (badref(!chkbndmcref)) then
      !chkbndmcref = !!dtbgetownertype(!ref,|PIPE|).bendmacreference

      if (badref(!chkbndmcref)) then
         !chkbndmcref = !!dtbgetownertype(!ref,|ZONE|).bendmacreference
      endif
    endif

    if (badref(!chkbndmcref)) then
      !this.parCGVAL.val = 'unset'
      return
    endif

    !scope =  !chkbndmcref
    !bendElement = !this.bendRef
    !bendOd = !bendElement.aOd.nint()
    !bendWTK = !bendElement.awallt
    !bendRad = !bendElement.rad
    !bendingMachDimList = !!collectAllFor('FMBDIM', '', !scope)

    do !bendMachDimRef values !bendingMachDimList
      !bendMachDimOd = !bendMachDimRef.od.nint()
      !bendMachDimWTK = !bendMachDimRef.wThickness
      !bendMachDimRadious = !bendMachDimRef.benpir

      if (!bendOd eq !bendMachDimOd and !bendWTK eq !bendMachDimWTK and !bendRad eq !bendMachDimRadious) then
        !result = !bendMachDimRef
	    break
      elseif (!bendOd eq !bendMachDimOd and !bendMachDimWTK eq 0 and !bendRad eq !bendMachDimRadious) then
         !result = !bendMachDimRef
	    break
      elseif (!bendMachDimOd eq 0 and !bendMachDimWTK eq 0 and !bendRad eq !bendMachDimRadious) then
         !result = !bendMachDimRef
	    break
      endif
    enddo

    if (!result.badRef()) then
      !this.parCGVAL.val = 'unset'
      return
    endif

    !this.parCGVAL.val = !result.Grip.string(!!distanceFmt)

endmethod
