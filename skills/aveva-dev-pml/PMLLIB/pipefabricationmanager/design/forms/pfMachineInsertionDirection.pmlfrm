-- Description:
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   apply the selected machine insertion direction
--  displayInsertionDirection(STRING) -                   display the given insertion direction with aid elements
--  onAction(ARRAY)                  -                   show this form with the insertion direction of the picked tube
--  onEscape()                       -                   clear screen and hide this form
--  onQuit()                         -                   quit form
--  pfMachineInsertionDirection()    -                   constructor
--  setInsertionDirection()          -                   initiate the EDG process for machine insertion direction
--
--------------------------------------------------------------------------------

setup form !!pfMachineInsertionDirection dialog

  !this.formTitle = 'Machine Insertion Direction'
  !this.quitCall  = '!this.onQuit()'

  frame .frmDirection 'Insertion Direction'
    rtoggle .rtoHead 'Arrive' callback |!this.displayInsertionDirection('ARRI')|
    rtoggle .rtoTail 'Leave ' callback |!this.displayInsertionDirection('LEAV')|
    rtoggle .rotAuto 'Auto  ' callback |!this.displayInsertionDirection('AUTO')|
  exit

  path down
  button .btnApply 'Apply' callback '!this.apply()' width 8 APPLY
  path right
  button .btnDismiss 'Dismiss' callback '!this.onQuit()' width 8 CANCEL

  member  .arriveBoundary is DBREF

  member  .leaveBoundary  is DBREF

  member  .tubeParts      is ARRAY

  member  .bendRefs       is ARRAY

  member  .aidNumber      is REAL

  member  .undo           is UNDOABLE

exit

--------------------------------------------------------------------------------
--
-- Method:      pfMachineInsertionDirection
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfMachineInsertionDirection()

  !this.aidNumber = !!aidNumbers.add('PF - Machine Insertion Direction')

  !this.frmDirection.val = 3

endmethod


--------------------------------------------------------------------------------
--
-- Method:      onQuit
--
-- Description: clear screen and remove pending EDG
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onQuit()
  !!aidNumbers.hide(!this.aidNumber)
  !!edgCntrl.remove('PF - Machine Insertion Direction')
endmethod

--------------------------------------------------------------------------------
--
-- Method:      setInsertionDirection
--
-- Description: initiate an EDG process for machine insertion direction
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .setInsertionDirection()

  !!edgCntrl.remove('PF - Machine Insertion Direction')

  !packet = object EDGPACKET()
  !packet.action = |!!pfMachineInsertionDirection.onAction(!this.return)|
  !packet.escape = |!!pfMachineInsertionDirection.onEscape()|
  --!packet.definePosition('Pick part or <ESC> to finish')
  !packet.elementPick('Pick tube or bend or <ESC> to finish')
  !packet.pickPacket.picks[1].pick.input[3] = |TYPE EQ 'TUBI' or TYPE EQ 'BEND'|
  --!packet.pickPacket.picks[1].pick.input[5] = |TRUE|
  !packet.pickPacket.picks[1].pick.modifiable = false
  !packet.description = 'PF - Machine Insertion Direction'
  !packet.remove = false
  --!packet.form = !!pfMachineInsertionDirection

  !!edgCntrl.add(!packet)

endmethod


--------------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: apply the selected insertion direction
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .apply()

  !clutch = 'AUTO'
  if !this.frmDirection.val.eq(1) then
    !clutch = 'ARRI'
  elseif !this.frmDirection.val.eq(2) then
    !clutch = 'LEAV'
  endif

  !this.undo.description('Set Machine Insertion Direction')
  !this.undo.add()

  do !partRef values !this.tubeParts
    if !partRef.type.eq('BEND') then
      !partRef.clutch = !clutch
    endif
  enddo

  !this.undo.endUndoable()

  !this.displayInsertionDirection(!clutch)

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onEscape
--
-- Description: clear screen and hide this form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onEscape()
  !!aidNumbers.hide(!this.aidNumber)
  !this.hide()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onAction
--
-- Description: display this form with the insertion direction of the picked component
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onAction(!data is ARRAY)

  if !data.unset() OR !data.empty() then
    return
  endif

  !this.arriveBoundary = object DBREF()
  !this.leaveBoundary = object DBREF()
  !this.tubeParts.clear()
  !this.bendRefs.clear()

  !!pfGetTubeParts(!data[1].item, !this.arriveBoundary, !this.leaveBoundary, !this.tubeParts)

  !clutch = ''
  do !partRef values !this.tubeParts
    if !partRef.type.eq('BEND') then
      !this.bendRefs.append(!partRef)

      if !clutch.empty() and !partRef.clutch.set() then
        !clutch1 = !partRef.clutch.upCase()
        if !clutch1.eq('ARRI') or !clutch1.eq('LEAV') or !clutch1.eq('AUTO') then
          !clutch = !clutch1
        endif
      endif

    endif
  enddo

  if !this.bendRefs.empty() then

    !this.arriveBoundary = object DBREF()
    !this.leaveBoundary = object DBREF()
    !this.tubeParts.clear()

    -- Fix Issue 97973
    !this.frmDirection.val = 3
    !this.frmDirection.active = false
    --//

    !this.btnApply.active = false

    !!alert.message('No pulled bends!')
    return
  endif

  !this.frmDirection.active = true
  !this.btnApply.active = true

  if !clutch.eq('ARRI') then
    !this.frmDirection.val = 1
  elseif !clutch.eq('LEAV') then
    !this.frmDirection.val = 2
  else
    !this.frmDirection.val = 3
  endif

  !this.displayInsertionDirection(!clutch)

  !this.show('FREE')

endmethod

--------------------------------------------------------------------------------
--
-- Method:      displayInsertionDirection
--
-- Description: display insertion direction with aid elements
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      insertion direction (ARRI, LEAV, AUTO)
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .displayInsertionDirection(!clutch is STRING)

  -- Fix Issue 97973
  if !this.tubeParts.empty() or !this.arriveBoundary.badref() or !this.leaveBoundary.badref() then
    return
  endif
  --//

  do !partRef values !this.tubeParts
    ENHANCE $!<partRef> COL $!!<gphColOpt.highlight.code>
  enddo

  !headPosition = !this.tubeParts.first().apos
  !tailPosition = !this.tubeParts.last().lpos

  AID TEXT NUM $!this.aidNumber 'Arrive' AT $!headPosition
  AID TEXT NUM $!this.aidNumber 'Leave' AT $!tailPosition

  !bendRef = !this.bendRefs.first()
  !outDiameter = !bendRef.aodiam * 2.5

  if !clutch.eq('ARRI') then
    !position = !headPosition

    if !this.arriveBoundary.type.eq('BRAN') then
      !direction = !this.arriveBoundary.hdir.opposite()
    else
      !direction = !this.arriveBoundary.adir
    endif

    AID ARROW NUM $!this.aidNumber AT $!position DIR $!direction HEI $!outDiameter PROP 1
  elseif !clutch.eq('LEAV') then
    !position = !tailPosition

    -- Fix Issue 96916, Pipe Fabrication: Errors when choosing Leave as Insert Direction
    --if !this.arriveBoundary.type.eq('BRAN') then
    if !this.leaveBoundary.type.eq('BRAN') then
    --//
      !direction = !this.leaveBoundary.tdir.opposite()
    else
      !direction = !this.leaveBoundary.ldir
    endif

    AID ARROW NUM $!this.aidNumber AT $!position DIR $!direction HEI $!outDiameter PROP 1
  endif

endmethod
