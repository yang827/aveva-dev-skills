--------------------------------------------------------------------------------
--
-- Method:      getSpoolBreakCandidates
--
-- Description: get spool break candidates
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .getSpoolBreakCandidates(!partRef is DBREF)
  !this.spoolBreaks.clear()
  !found = false
  !branRef = !partRef.owner
  !partType = !partRef.type

  -- get only valid components and tubes
  !memberRefs = object ARRAY()
  !memberRefs1 = !!collectAllFor('BRAN MEM', '', !branRef)
  do !memberRef values !memberRefs1
    if (!memberRef.type.eq('TUBI')) then
      !itlength = !memberRef.itlength
      handle ANY
      elsehandle NONE
        if (!itlength.geq(1mm)) then
          !memberRefs.append(!memberRef)
        endif
      endhandle
    elseif (!memberRef.type.eq('ATTA')) then
      if (!memberRef.spkbrk) then
        !memberRefs.append(!memberRef)
      endif
    else
      !memberRefs.append(!memberRef)
    endif
  enddo

  !index = !memberRefs.findFirst(!partRef)
  if (!index.unset()) then
    return
  endif

  -- find previous & next component
  !count = !memberRefs.size()
  if (!index.gt(1)) then
    !prevRef = !memberRefs[!index - 1]
  else
    !prevRef = !branRef
  endif

  if (!index.lt(!count)) then
    !nextRef = !memberRefs[!index + 1]
  else
    !nextRef = !branRef
  endif

  --we don't want to draw spool limits at P1/P2 side of OLET
  if(!partRef.type.neq(|OLET|)) then
    if (!prevRef.type.eq('BRAN') or !prevRef.type.eq('TUBI')) then
      !candidate = object ARRAY()
      !candidate[1] = !partRef
      !candidate[2] = true
      !candidate[3] = false
      !candidate[4] = object DBREF()
      !this.spoolBreaks.append(!candidate)
    else
      !candidate = object ARRAY()
      !candidate[1] = !partRef
      !candidate[2] = true
      !candidate[3] = !prevRef.shop.not()
      !candidate[4] = !prevRef
      !this.spoolBreaks.append(!candidate)
    endif
    if (!nextRef.type.eq('BRAN') or !nextRef.type.eq('TUBI')) then
      !candidate = object ARRAY()
      !candidate[1] = !partRef
      !candidate[2] = false
      !candidate[3] = false
      !candidate[4] = object DBREF()
      !this.spoolBreaks.append(!candidate)
    else
      -- leave boundary is a component
      !candidate = object ARRAY()
      !candidate[1] = !partRef
      !candidate[2] = false
      !candidate[3] = !nextRef.shop.not()
      !candidate[4] = !nextRef
      !this.spoolBreaks.append(!candidate)
    endif
  endif
  --192248
  if (!partRef.type inset ('TEE', 'OLET')) then
    if !partRef.cref.unset().eq(TRUE) then
      !candidate = object ARRAY()
      !candidate[1] = !partRef
      !candidate[2] = !this.modeforfirstCompTCref
      !candidate[3] = false
      !candidate[4] = object DBREF()
      !this.spoolBreaks.append(!candidate)
    else
      if !partRef.cref.type.eq('BRAN') then
        !weldlist = !!collectAllfor('weld',||,!partRef.cref)
        !candidate = object ARRAY()
        !candidate[1] = !partRef.cref
        !candidate[2] = !this.modeforfirstCompTCref
        !candidate[3] = false
        if (!this.modeforfirstCompTCref eq true) then
          !position    = !partRef.cref.hpos.wrt(world)
        else
          !position    = !partRef.cref.tpos.wrt(world)
        endif
        if (!weldlist.size() gt 0) then
          do !weldRef values !weldlist
            if(!weldRef.pos.wrt(world).distance(!position).string('d1').real().leq(0.5) ) then
              !found = true
            endif
          enddo
        endif
        if(!found eq true) then
          !candidate[3] = true
        else
          !candidate[3] = false
        endif
        !candidate[4] = object DBREF()
        !this.spoolBreaks.append(!candidate)
      endif
    endif
  endif
  --/192248

endmethod


--------------------------------------------------------------------------------
--
-- Method:      createSpoolBreakWithWeld
--
-- Description: create spool-break with weld
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .createSpoolBreakWithWeld(!partRef is DBREF, !forward is BOOLEAN)
  if (!forward) then
    FORWARD
  else
    BACKWARD
  endif

  !creationPosition = ''
  if (!partRef.type.eq('BRAN') and !partRef.mcount().gt(0)) then
    !creationPosition = ' BEFORE 1'
  endif
  !!ce = !partRef
  --192248
  -- check if the first component selected is the TEE/OLET and it's CREF is connected to another BRAN
  if(!this.selectedPartRefs[0].type inset ('TEE', 'OLET')) then
    if ( !this.selectedPartRefs[0].cref eq !this.selectedPartRefs[1]) then
      if(!this.selectedPartRefs.size() eq 2) then
        !!ce = !this.selectedPartRefs[1]
        !partRef = !this.selectedPartRefs[1]
      else
        !!ce = !this.selectedPartRefs[2]
        !partRef = !this.selectedPartRefs[2]
      endif
      !this.bTweldCreated = true
      !this.selectedPartRefs[2].type
      handle any
        !!ce = !partRef
      elsehandle none
        if(!this.selectedPartRefs[2].tgeom) then
          !!ce = il tube of $!this.selectedPartRefs[2]
        else
          !!ce = !this.selectedPartRefs[2]
        endif
      endhandle
      if( !this.bTweldCreated eq true) then
        if(!this.modeforSecondCompTCref eq true) then
          NEW WELD FORWARD
        else
          NEW WELD BACKWARD
        endif
      endif
    endif
  endif
  --/192248
  -- create weld component with the /WELDGAP spec
  if( !this.bTweldCreated eq FALSE) then
    NEW WELD $!creationPosition
  endif
  handle ANY
    !!alert.error(!!error.text)
  elsehandle NONE

    -- select spec
    SELECT WITH SPEC /WELDGAP STYPE FWS

    -- set weld gap length as 0.001 to show the shape(if 0, the shape is not displayed)
    DESP NUM 1 0.001m

    if(!this.selectedPartRefs[0].type.neq(|TEE|) and !this.selectedPartRefs[0].type.neq(|OLET|)) then
      !!ce.lstu = !this.selectedPartRefs[0].lstu
    endif
    !newComponent = !!ce


    -- change arrive/leave if mode is backward
    if (!forward.not()) then
      !arrive = !newComponent.arrive
      !newComponent.arrive = !newComponent.leave
      !newComponent.leave = !arrive
    endif

    CONNECT
    handle ANY
      -- (7, 3)
      --!res = !!alert.confirm('Incompatible connection types. Force to connect?')
      --if !res.eq('YES') then

      FCONNECT
      handle ANY
        !!alert.error(!!error.text)
        DELETE WELD
      endhandle
      --else
      --  DELETE WELD
      --endif
    endhandle

    ORIENTATE

  endhandle

endmethod
--------------------------------------------------------------------------------
--
-- Method:      modifyComponentAttributes
--
-- Description: modify component attributes
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .modifyComponentAttributes()
  --116359
  if(defined(!!pfComponentAttributes) and !!pfComponentAttributes.shown().eq(TRUE)) then
    !this.result = false
    return
  else
    !this.toCheckActiveFunctionality('PF-Component Attributes')
  endif
  --/116359
  if(!this.result) then
    !this.pickMode = false
    !this.quitEDG()
    !!fmSys.loadForm('pfComponentAttributes').show('FREE')
  endif
  !this.bfirstSession = true
  !this.result = true
endmethod

--------------------------------------------------------------------------------
--
-- Method:      createMultipleSpool
--
-- Description: create multiple spool
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .createMultipleSpool()
  !edgMsg = !!edgCntrl.state.packet.description
  !!edgcntrl.remove(!edgMsg)
  !this.clearAll()
  !this.quitEDG()
  !this.showSpoolLimits()
  !!pfCallMergeSpools()
  !this.result = true
endmethod

--116359
--------------------------------------------------------------------------------
define method .toCheckActiveFunctionality(!form is STRING)
  !this.result = true
  !activeForm = !this.toCheckActiveForms()
  if (!activeForm.unset().eq(FALSE) or !!edgCntrl.stack.size().neq(0)) then
    !edgMsg = !!edgCntrl.state.packet.description
    if(!form.eq(!edgMsg) and  !edgMsg.neq('PF - Set Spool Limit')) then
      !this.result = false
      return
    endif
    if (!edgMsg.eq(|Standard Navigate|)) then
      !edgMsg =  !activeForm.formTitle
    endif
    !acon = !!alert.confirm('OK to replace currently active application/utility "$!edgMsg?"')
    if (!acon.upcase().eq(|YES|)) then
      if(!activeForm.unset().eq(FALSE)) then
        hide !!$!activeForm
      endif
      !this.quitEDG()
      aid clear all
      unmark all
      unenhance all
      !this.showSpoolLimits()
      !this.showEndExcesses()
      !this.showFeedExcesses()
      !this.showLooseComponents()
      !!edgCntrl.remove(!edgMsg)
      !this.result = TRUE
    else
      !this.result = FALSE
      !this.showSpoolLimits()
      !this.showEndExcesses()
      !this.showFeedExcesses()
      !this.showLooseComponents()
      return
    endif
  endif
endmethod
--/116359
--
-- Method:      callFabricationCheck
--
-- Description: callback for fabrication check form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .callFabricationCheck()
  !this.quitEDG()
  if (undefined(!!pfFabricationCheck)) then
    pml load form !!pfFabricationCheck
  endif

  show !!pfFabricationCheck
endmethod

--------------------------------------------------------------------------------
--
-- Method:      callWeldHandling
--
-- Description: callback for weld handling form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .callWeldHandling()
  !this.quitEDG()
  !!comcallform(|!!pfWeldHandling|)
endmethod


--------------------------------------------------------------------------------
--
-- Method:      existCurrentGraphicalView
--
-- Description: Check exists in current Graphical view or not
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
--    1   R      DBREF       pipe element
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------

define method .existCurrentGraphicalView(!pipeRef is DBREF) is BOOLEAN
  !result = false

  !currentView = !!fmSys.currentDocument().view
  handle(2,759)
    return !result
  endhandle

  -- check whether selected pipe is belong to the current draw list or not.
  !token    = !!gphDrawlists.token(!currentView)
  !drawlist = !!gphDrawlists.drawlist(!token)

  !members = !drawlist.members()
  do !entry values !members
    skip if (!entry.ahlist.findFirst('PIPE').unset())

    !ownerPipeRef = PIPE of $!<entry>
    if (!pipeRef eq !ownerPipeRef) then
      !result = true
      break
    endif
  enddo

  if(!this.traverse.neq(true)) then
    if (!result.not()) then
      !!alert.message('The selected pipe is not present in the 3D View')
    endif
  endif

  return !result
endmethod
