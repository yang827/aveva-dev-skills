  !this.hideEndExcesses()
  if (!this.btnShowEndExcess.tag.subString(1, 4).eq('Hide')) then
    !this.showEndExcesses(!this.pipeRef, true)
    handle ANY
    endhandle
  endif
  !this.blnRefreshEndExcesses = false
endmethod

