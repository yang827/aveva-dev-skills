-- Created:         Tuesday 6th December 2012
--
-- Description:     Form for pipe spool modification
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  branchCheckForOlet(DBREF)        -                   called when the second component picked is a branch and first component being OLET
--  callFabricationCheck()           -                   callback for fabrication check form
--  callWeldHandling()               -                   callback for weld handling form
--  checkExistSplitLimits(DBREF,DBREF) BOOLEAN
--  checkExistSplitLimitsonTEE(DBREF,DBREF) BOOLEAN
--  clearAll()                       -                   clear all aids and unenhance all elements
--  collectOletBranches(DBREF)       -                   collects all OLET branches
--  createMultipleSpool()            -                   create multiple spool
--  createSpoolBreakWithWeld(DBREF,BOOLEAN) -
--  drawSpoolBreak(DBREF,BOOLEAN,BOOLEAN) -                   draw a spool break at the position decided by the given information
--  drawSpoolBreak(DBREF,REAL,BOOLEAN) -                   draw a spool break at the position decided by the given information
--  drawSpoolBreakForTeeCRef(DBREF,BOOLEAN,BOOLEAN) -                   display a plane at the given position of the given TEE CREF position
--  drawSpoolBreaksAroundComponent(DBREF) -                   draw spool breaks around the given component
--  existCurrentGraphicalView(DBREF) BOOLEAN
--  firstComponentSelected(ARRAY)    ANY                 callback called when the first component is selected to create/delete a spool break
--  getNextSpoolColour()             COLOUR              return the next available colour for a spool limit
--  getSpoolBreakCandidates(DBREF)   -
--  hideEndExcesses()                -                   hide all end excess values
--  hideFeedExcesses()               -                   hide all feed excess values
--  hideLooseComponents()            -                   unenhance all loose components
--  hideSpoolLimits()                -                   hide all spool limits
--  modifyComponentAttributes()      -                   modify component attributes
--  nonBranchCheckForOlet(ARRAY)     -                   called when the second component picked is not a branch and first component being OLET
--  oletBranchCheck(ARRAY)           -                   checks all OLET branches based on some conditions for drawing spool breaks around OLET
--  onActionSetSpoolLimit(ARRAY)     -                   create a spool limit between piping components
--  onBranchHeadConnectedToOlet(ARRAY) BOOLEAN             called when the branch head is connected to OLET
--  onBranchTailConnectedToOlet(ARRAY) BOOLEAN             called when the branch tail is connected to OLET
--  onEscapeSetSpoolLimit()          -                   clean up screen after modifying a spool break
--  onInitialize()                   -                   initialize form
--  onQuit()                         -                   quit form
--  pfModifySpool()                  -                   constructor
--  quitEDG()                        -                   quit all pending EDG processes
--  refreshEndExcesses()             -                   refresh end excess information
--  refreshFeedExcesses()            -                   refresh feed excess information
--  refreshLooseComponents()         -                   refresh loose component information
--  refreshSpoolLimits()             -                   refresh spool break information
--  secondComponentSelected(ARRAY)   ANY                 callback called when the second component is selected to create/delete spool break
--  setEndExcess()                   -                   set an end excess value
--  setFeedExcess()                  -                   set a feed excess value
--  setMachineInsertionDirection()   -                   set user defined machine insertion direction
--  setSpoolLimit(STRING)            -                   initiate an EDG process for setting spool limits
--  showEndExcesses()                -                   display all end excesses of the current element
--  showEndExcesses(DBREF,BOOLEAN)   BOOLEAN             display all end excesses of the given pipe element
--  showFeedExcesses()               -                   display all feed excesses of the current element
--  showFeedExcesses(DBREF,BOOLEAN)  BOOLEAN             display all feed excesses of the given pipe element
--  showLooseComponents()            -                   display all loose components in the current element
--  showLooseComponents(DBREF,BOOLEAN) BOOLEAN             display all loose components in the given pipe element
--  showPickErrorForOlet(STRING)     -                   called when the second component picked is on P1/P2 side and not on P3 side of the OLET
--  showSpoolLimits()                -                   display all spool limits of the current element
--  showSpoolLimits(DBREF,BOOLEAN,BOOLEAN) -                   display all spool limits of the given pipe element
--  toCheckActiveForms()             FORM
--  toCheckActiveFunctionality(STRING) -
--  trackCE()                        -                   track current element
--
--------------------------------------------------------------------------------

import 'PipeFabricationAddin'
handle ANY
endhandle

-- Define form
setup form !!pfModifySpool dialog dock varchars

  !this.formTitle  = 'Modify Spool'
  !this.initCall   = |!this.onInitialize()|
  !this.quitCall   = '!this.onQuit()'

  path right
  para .paraCurrentPipe text 'Pipe: <none>' wid 30

  path down
  -- Fix for Issue 94932 (SI-56444) wording changed
  frame .frameEndExcess foldup 'User End & Feed Excess' at xmin.paraCurrentPipe anchor l+t+r wid 30
    button .btnShowEndExcess  linklabel 'Show User End Excess'   callback '!this.showEndExcesses()'
    button .btnSetEndExcess   linklabel 'Set User End Excess'    callback '!this.setEndExcess()'
    button .btnShowFeedExcess linklabel 'Show User Feed Excess'  callback '!this.showFeedExcesses()'
    button .btnSetFeedExcess  linklabel 'Set User Feed Excess'  callback '!this.setFeedExcess()'
  exit

  frame .frameLooseComponent foldup 'Components Attributes' anchor l+t+r wid 30
    button .btnShowLooseComponents linklabel 'Show Loose Components'       callback '!this.showLooseComponents()'
    button .btnModifyComponents    linklabel 'Modify Component Attributes' callback '!this.modifyComponentAttributes()'
  exit

  frame .frameSpoolLimit foldup 'Spool Limits' anchor l+t+r wid 30
    button .btnShowSpoolLimits linklabel 'Show Spool Limits'  callback '!this.showSpoolLimits()'
    button .btnSetSpoolLimit linklabel   'Add/Remove Spool Limits - No Welds'    callback |!this.setSpoolLimit('')|
    button .btnSetSpoolLimiWithWeld linklabel 'Add/Remove Spool Limits - Welds' callback |!this.setSpoolLimit('WELD')|
  exit

  frame .frameInsertionDirection foldup 'Machine Insertion Direction' anchor l+t+r wid 30
    button .btnSetMachineInsertionDirection linklabel 'Set Machine Insertion Directions' callback '!this.setMachineInsertionDirection()'
  exit

  frame .frameSpoolMerge foldup 'Multiple Spools' anchor l+t+r wid 30
    button .btnSpoolMerge linklabel 'Create Multiple Spool' callback '!this.createMultipleSpool()'
  exit

  button .btnFabricationCheck linklabel 'Fabrication Check...' callback '!this.callFabricationCheck()'
  button .btnWeldHandling linklabel 'Weld Handling...' callback '!this.callWeldHandling()'

  button .btnClearScreen linklabel 'Clear All' callback '!this.clearAll()'

  track 'DESICE' call '!this.trackCE()'

  member  .aidNoForEndExcess          is REAL

  member  .aidNoForFeedExcess         is REAL

  member  .aidNoForLoose              is REAL

  member  .aidNoForSpoolLimit         is REAL

  member  .pipeRef                    is DBREF

  member  .branRef                    is DBREF

  member  .zoneRef                    is DBREF

  member  .siteRef                    is DBREF

  member  .worldRef                   is DBREF

  member  .colours                    is ARRAY

  member  .colourIndex                is REAL

  member  .fieldColour                is COLOUR

  member  .undo                       is UNDOABLE

  member  .spoolBreaks                is ARRAY

  member  .pickMode                   is BOOLEAN

  member  .breakMode                  is STRING

  member  .replaceSplitType           is BOOLEAN

  member .spoolLimitMode              is STRING

  -- array for storing enhanced elements
  member  .endExcessComponents        is ARRAY

  member  .feedExcessComponents       is ARRAY

  member  .looseComponents            is ARRAY

  member  .spoolLimitsComponents      is ARRAY

  member .bfirstSession is BOOLEAN
  member .result        is BOOLEAN
  --192248
  member .selectedPartRefs            is ARRAY
  member .bTweldCreated               is BOOLEAN
  member .modeforfirstCompTCref      is BOOLEAN
  member .modeforSecondCompTCref     is BOOLEAN
  --/192248
  member .blnRefreshEndExcesses          is BOOLEAN
  member .blnRefreshFeedExcesses          is BOOLEAN
  member .blnRefreshSpoolLimits          is BOOLEAN
  member .blnRefreshLooseComponents          is BOOLEAN
  member .traverse               is BOOLEAN
  --member to store first component that is picked
  member .firComp is  DBREF
exit

--------------------------------------------------------------------------------
--
-- Method:      pfModifySpool
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfModifySpool()

  !this.aidNoForEndExcess   = !!aidNumbers.add('PF - End Excess')
  !this.aidNoForFeedExcess  = !!aidNumbers.add('PF - Feed Excess')
  !this.aidNoForLoose       = !!aidNumbers.add('PF - Loose Component')
  !this.aidNoForSpoolLimit  = !!aidNumbers.add('PF - Spool Limit')

  !this.colours.append(object COLOUR('steelblue'))
  !this.colours.append(object COLOUR('blue'))
  !this.colours.append(object COLOUR('green'))
  !this.colours.append(object COLOUR('deeppink'))
  !this.colours.append(object COLOUR('white'))
  !this.colours.append(object COLOUR('cyan'))
  !this.colours.append(object COLOUR('mauve'))
  !this.colours.append(object COLOUR('brown'))

  !this.colourIndex = 1

  !this.fieldColour = object COLOUR('darkgrey')

  !this.pickMode = false

  !this.bfirstSession = false

  if(undefined(!!pfDefaults)) then
    pml load form !!pfDefaults
    !!pfDefaults.initialize()
  endif
  !this.btnShowEndExcess.active  = false
  !this.btnShowFeedExcess.active = false
  !this.btnShowLooseComponents.active = false
  !this.btnShowSpoolLimits.active = false
  !this.blnRefreshEndExcesses = false
  !this.blnRefreshFeedExcesses = false
  !this.blnRefreshLooseComponents = false
  !this.blnRefreshSpoolLimits = false
endmethod
--------------------------------------------------------------------------------
--116359
define method .toCheckActiveForms() is FORM
  !!fmSys.loadForm(|PFENDEXCESS|)
  !!fmSys.loadForm(|PFFEEDEXCESS|)
  !!fmSys.loadForm(|PFCOMPONENTATTRIBUTES|)
  !!fmSys.loadForm(|PFMACHINEINSERTIONDIRECTION|)
  !form[1] = !!pfendexcess
  !form[2] = !!pffeedexcess
  !form[3] = !!pfcomponentattributes
  !form[4] = !!pfmachineinsertiondirection
  !formName = object FORM()
  do !x from 1 to !form.size()
    if (defined(!form[$!x]) and !form[$!x].shown().eq(TRUE)) then
      !formName = !form[$!x]
      !!fmSys.loadForm(!formName.string())
    endif
  enddo
  return !formName
endmethod
--/116359
--------------------------------------------------------------------------------
--
-- Method:      onInitialize
--
-- Description: initialize form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onInitialize()
  !this.trackCE()
  !this.clearAll()
endmethod

--------------------------------------------------------------------------------
--
-- Method:      onQuit
--
-- Description: clear all aid elements and quit all pending EDG processes
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onQuit()
  !this.clearAll()
  !this.quitEDG()
endmethod
--------------------------------------------------------------------------------
--
-- Method:      quitEDG
--
-- Description: quit all pending EDG processes
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .quitEDG()
  if (!this.pickMode) then
    return
  endif
  !!edgCntrl.remove('PF - Set End Excess')
  !!edgCntrl.remove('PF - Set Feed Excess')
  !!edgCntrl.remove('PF - Set Spool Limit')
  !!edgCntrl.remove('PF - Reset Spool Limit')
  !!edgCntrl.remove('PF - Machine Insert Direction')
  !!edgCntrl.remove('PF - Machine Insertion Direction')
  !this.pickMode = false
endmethod

--------------------------------------------------------------------------------
--
-- Method:      trackCE
--
-- Description: track pipe element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .trackCE()
  if (!this.pickMode) then
    return
  endif
  !this.traverse = TRUE
  !this.result = TRUE
  -- check db type
  !active  = false
  if (!!ce.dbType eq 'DESI') then
    !pipeRef = PIPE OF CE
    handle ANY
      !pipeRef = object DBREF()
    endhandle
    if (!pipeRef.set()) then
      !active = true
    endif
  endif
  if (!active) then
    !this.pipeRef = !pipeRef
    !this.paraCurrentPipe.val = 'Pipe: ' + !pipeRef.namn

    if (!this.existCurrentGraphicalView(!pipeRef)) then
      !this.btnShowEndExcess.active = !this.showEndExcesses(!pipeRef, true)
      !this.btnShowFeedExcess.active = !this.showFeedExcesses(!pipeRef, true)
      !this.btnShowLooseComponents.active = !this.showLooseComponents(!pipeRef, true)
      !this.btnShowSpoolLimits.active = !active
      if (!this.btnShowSpoolLimits.tag eq 'Hide Spool Limits') then
        !this.showSpoolLimits(!this.pipeRef, true, true)
      endif
    endif
  else
    if(!this.pipeRef.set()) then
      !this.showSpoolLimits(!this.pipeRef, false, false)
      !this.btnShowSpoolLimits.tag = 'Show Spool Limits'
      !notMultipleSpool = true
      if(defined(!!pfsplitmergespools) and !!pfsplitmergespools.shown()) then
        !notMultipleSpool = !!pfsplitmergespools.spoolManager.isPickMode.not()
      endif
      if(!notMultipleSpool) then
        UNENHANCE ALL
      endif
      AID CLEAR ALL
      !this.btnShowSpoolLimits.active = false
      !this.pipeRef = object DBREF()
      !this.paraCurrentPipe.val = 'Pipe: <none>'
    endif
  endif
  !this.traverse = FALSE
endmethod

--------------------------------------------------------------------------------
--
-- Method:      showEndExcesses
--
-- Description: show all end excesses of the current element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .showEndExcesses()
  if (!this.pipeRef.badref().not()) then
    if (!this.existCurrentGraphicalView(!this.pipeRef)) then
      UNENHANCE ALL
      AID CLEAR ALL
      !result = !this.showEndExcesses(!this.pipeRef, true)
      if !this.blnRefreshEndExcesses.not() then
        if !this.btnShowSpoolLimits.val then
          !this.refreshSpoolLimits()
        endif
        if !this.btnShowFeedExcess.val then
          !this.refreshFeedExcesses()
        endif
        if !this.btnShowLooseComponents.val then
          !this.refreshLooseComponents()
        endif
      endif
      if (!result) then
        if (!this.btnShowEndExcess.val) then
          !this.btnShowEndExcess.tag = 'Hide User End Excess'
        else
          !this.btnShowEndExcess.tag = 'Show User End Excess'
        endif
      endif
    else
      if (!this.btnShowEndExcess.tag eq 'Hide User End Excess') then
        !this.hideEndExcesses()
        !this.btnShowEndExcess.tag = 'Show User End Excess'
      endif
    endif
  else
    !this.hideEndExcesses()
    !this.btnShowEndExcess.active = false
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      hideEndExcesses
--
-- Description: clear all information for end excess values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .hideEndExcesses()
  do !part values !this.endExcessComponents
    UNENHANCE $!part
    handle (2,121)
    endhandle
  enddo

  !this.endExcessComponents.clear()
  !!aidNumbers.hide(!this.aidNoForEndExcess)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      showEndExcesses
--
-- Description: display all end excess values of the given pipe element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       pipe element
--    2   R      BOOLEAN     if true, no message box is displayed
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     return true if excess value exists in the given pipe element
--------------------------------------------------------------------------------
define method .showEndExcesses(!item is DBREF, !silent is BOOLEAN) is BOOLEAN

  !this.hideEndExcesses()
  !saveCe = !!ce

  !!ce = PIPE
  handle ANY
    return false
  endhandle

  !pieces = object ARRAY()

  !parts = !!collectAllFor('TUBI BEND FTUB', '', !!ce)
  do !part values !parts

    !found = false
    do !j indices !pieces
      if (!pieces[!j][3].findFirst(!part).set()) then
        !found = true
        break
      endif
    enddo

    if (!found.not()) then
      !arriveBoundary = object DBREF()
      !leaveBoundary = object DBREF()
      !tubeParts = object ARRAY()
      !!pfGetTubeParts(!part, !arriveBoundary, !leaveBoundary, !tubeParts)

      !!pfGetExcessComponents(!arriveBoundary, !leaveBoundary)

      if (!arriveBoundary.set() and !leaveBoundary.set() and !tubeParts.empty().not()) then
        !piece = object ARRAY()
        !piece[1] = !arriveBoundary
        !piece[2] = !leaveBoundary
        !piece[3] = !tubeParts
        !pieces.append(!piece)
      endif
    endif
  enddo

  !endExcessExists = false

  !showEndExcess = !this.btnShowEndExcess.val

  do !i indices !pieces
    !arriveBoundary = !pieces[!i][1]
    !leaveBoundary = !pieces[!i][2]

    !arriveExcess = !arriveBoundary.lExcess
    --handling error if element does not have attribute lExcess
    handle (2,201)
      !arriveExcess  = 0
    endhandle

    !leaveExcess = !leaveBoundary.aExcess
    --handling error if element does not have attribute aExcess
    handle (2,201)
      !leaveExcess  = 0
    endhandle

    if (!arriveExcess.gt(0mm) or !leaveExcess.gt(0mm)) then
      if (!showEndExcess) then
        !tubeParts = !pieces[!i][3]
        if (!arriveExcess.gt(0mm)) then
          !excessString = !arriveExcess.string(!!distanceFmt)
          !position = !tubeParts.first().aPosition.wrt(world)
          AID TEXT NUM $!this.aidNoForEndExcess |Arrive : $!excessString| AT $!position
        endif

        if (!leaveExcess.gt(0mm)) then
          !excessString = !leaveExcess.string(!!distanceFmt)
          !position = !tubeParts.last().lPosition.wrt(world)
          AID TEXT NUM $!this.aidNoForEndExcess |Leave : $!excessString| AT $!position
        endif

        do !part values !tubeParts
          ENHANCE $!part COL $!!<gphColOpt.highlight.code>

          if (!this.endExcessComponents.findFirst(!part).unset()) then
            !this.endExcessComponents.append(!part)
          endif
        enddo
      endif

      !endExcessExists = true
    endif
  enddo

  if (!endExcessExists.not()) then
    !this.btnShowEndExcess.active = false
  endif


  !!ce = !saveCe
  handle any
  endhandle

  return !endExcessExists

endmethod

--------------------------------------------------------------------------------
--
-- Method:      setEndExcess
--
-- Description: set end excess
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .setEndExcess()
  !this.toCheckActiveFunctionality('PF - Set End Excess')
  if (!this.result) then
    !this.quitEDG()
    !!fmSys.loadForm('pfEndExcess').setEndExcess()
  endif
  !this.result = true
endmethod

--------------------------------------------------------------------------------
--
-- Method:      showSpoolLimits
--
-- Description: display all spool limits of the current pipe element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .showSpoolLimits()
  if (!this.pipeRef.badref().not()) then
    if (!this.existCurrentGraphicalView(!this.pipeRef)) then
      if (!this.btnShowSpoolLimits.tag eq 'Hide Spool Limits') then
        !this.btnShowSpoolLimits.val = false
        UNENHANCE ALL
        AID CLEAR ALL
      else
        !this.btnShowSpoolLimits.val = true
        UNENHANCE ALL
        AID CLEAR ALL
      endif
      if !this.blnRefreshSpoolLimits.not() then
        if !this.btnShowEndExcess.val then
          !this.refreshEndExcesses()
        endif
        if !this.btnShowFeedExcess.val then
          !this.refreshFeedExcesses()
        endif
        if !this.btnShowLooseComponents.val then
          !this.refreshLooseComponents()
        endif
      endif
      !this.showSpoolLimits(!this.pipeRef, true, true)
      if (!this.btnShowSpoolLimits.val) then
        !this.btnShowSpoolLimits.tag = 'Hide Spool Limits'
      else
        !this.btnShowSpoolLimits.tag = 'Show Spool Limits'
      endif
    else
      if (!this.btnShowSpoolLimits.tag eq 'Hide Spool Limits') then
        !this.hideSpoolLimits()
        !this.btnShowSpoolLimits.tag = 'Show Spool Limits'
      endif
    endif
  else
    !this.hideSpoolLimits()
    !this.btnShowSpoolLimits.active = false
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      showSpoolLimits
--
-- Description: display all spool limits of the given pipe element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       pipe element
--    2   R      BOOLEAN     if true, a spool is enhanced with next available colour
--    3   R      BOOLEAN     if true, a plane is displayed
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .showSpoolLimits(!pipeRef is DBREF, !byColour is BOOLEAN, !byPlane is BOOLEAN)

  !this.hideSpoolLimits()

  if (!this.btnShowSpoolLimits.val.not()) then
    return
  endif
  using namespace 'Aveva.Pdms.PipeFabrication.FabricationCheck'

  !!fmSys.currentDocument().view.refresh()

  !pipe = object PFPIPEPML(!pipeRef.name)
  !pipeSpools = !pipe.pipeSpools()
  -- collect TEE and Branches
  !teeBranches = object ARRAY()
  !teeRefs = !!collectAllFor('TEE', |Csfbreak eq TRUE|, !pipeRef)
  do !teeRef values !teeRefs
    !cref = !teeRef.cref
    handle ANY
    endhandle

    if (!cref neq Nulref) then
      if (!cref.tsfbreak eq TRUE) then
        !teeBranches.append(!cref)
      endif
    endif
  enddo

  do !j indices !teeBranches
    !teeBranch = !teeBranches[!j]

    if (!teeBranch.type.eq('BRAN')) then
      !href = !teeBranch.href
      !tref = !teeBranch.tref
      if (!href.unset() and !tref.unset()) then
        -- connected to an external model
      elseif(!href.unset() and !tref.type.eq('TEE')) then
        if (!tref.csfbreak) then
          !this.drawSpoolBreak(!teeBranch, false, true)
        endif
      elseif(!href.type.eq('TEE') and !tref.unset()) then
        if (!href.csfbreak) then
          !this.drawSpoolBreak(!teeBranch, true, true)
        endif
      elseif(!href.type.eq('TEE') and !tref.type.eq('TEE')) then
        if (!href.csfbreak and !tref.csfbreak) then
          !this.drawSpoolBreak(!teeBranch, true, true)
          !this.drawSpoolBreak(!teeBranch, false, true)
        elseif(!href.csfbreak and !tref.csfbreak.not()) then
          !this.drawSpoolBreak(!teeBranch, true, true)
        elseif(!href.csfbreak.not() and !tref.csfbreak) then
          !this.drawSpoolBreak(!teeBranch, false, true)
        endif
      elseif(!href.type.eq('TEE') and !tref.type.eq('BRAN')) then
        !this.drawSpoolBreak(!teeBranch, true, true)
      elseif(!href.type.eq('BRAN') and !tref.type.eq('TEE')) then
        !this.drawSpoolBreak(!teeBranch, false, true)
      endif
    endif
  enddo
  -- collect OLET and Branches
  !this.collectOletBranches(!pipeRef)
  -- highlight field parts
  !branRefs = !!collectAllFor('BRAN', '', !pipeRef)
  do !branRef values !branRefs
    do !memberRef values !branRef.members
      !shop = !memberRef.shop
      handle ANY
        !shop = false
      endhandle

      if (!shop.not()) then
        ENHANCE $!memberRef COLOUR $!<this.fieldColour>

        if (!this.spoolLimitsComponents.findFirst(!memberRef).unset()) then
          !this.spoolLimitsComponents.append(!memberRef)
        endif

        -- mark information for spool limit
        if (!memberRef.hardtype eq 'WELD' and !memberRef.shop.not() and !memberRef.loff.not()) then
          AID TEXT NUM $!this.aidNoForSpoolLimit '<WELD>' AT $!<memberRef.pos>
        endif
      else
        -- mark information for spool limit
        !spoolLimitByNoneWeld = !memberRef.asfbreak or !memberRef.lsfbreak or !memberRef.csfbreak
        handle any
          !spoolLimitByNoneWeld = false
        endhandle

        if (!spoolLimitByNoneWeld) then
          AID TEXT NUM $!this.aidNoForSpoolLimit '<BREAK>' AT $!<memberRef.pos>
        endif
      endif
    enddo
  enddo

  -- enhance spools
  !this.colourIndex = 1
  do !i indices !pipeSpools
    !pipeSpool = !pipeSpools[!i]
    !arriveBoundaryNames = !pipeSpool.arriveBoundaries()
    !leaveBoundaryNames = !pipeSpool.leaveBoundaries()
    !arriveBoundaries = object ARRAY()
    !leaveBoundaries = object ARRAY()

    do !name values !arriveBoundaryNames
      !arriveBoundaries.append(!name.dbref())
    enddo

    do !name values !leaveBoundaryNames
      !leaveBoundaries.append(!name.dbref())
    enddo

    !allComponents = object ARRAY()
    !namesList = !pipeSpool.allComponents()
    do !names values !namesList
      do !name values !names
        !allComponents.append(!name.dbref())
      enddo
    enddo

    -- highlight all components
    if (!byColour) then
      !colour = !this.getNextSpoolColour()
      do !partRef values !allComponents
        ENHANCE $!partRef COLOUR $!colour

        if (!this.spoolLimitsComponents.findFirst(!partRef).unset()) then
          !this.spoolLimitsComponents.append(!partRef)
        endif
      enddo
    endif

    -- draw boundary planes
    if (!byPlane) then

      do !j indices !arriveBoundaries

        !arriveBoundary = !arriveBoundaries[!j]
        !leaveBoundary = !leaveBoundaries[!j]
        if (!arriveBoundary.type.eq('BRAN')) then

          !href = !arriveBoundary.href
          if (!href.unset()) then
            -- connected to an external model
            !this.drawSpoolBreak(!arriveBoundary, true, true)
            handle ANY
              !!alert.error(!!error.text)
            endhandle
          else
            if (!href.type.eq('BRAN')) then
              --checking if the connection is head-head.If it is,then the href will be in the arrive boundaries.If this condition is not included then
              --a dummy limit will be drawn which misleads us to think that there are two limits.
              if(!href.href.eq(!arriveBoundary)) then
                if(!arriveBoundaries.findFirst(!href).unset()) then
                  !this.drawSpoolBreak(!arriveBoundary, true, true)
                endif
              elseif(!leaveBoundaries.findFirst(!href).unset()) then
                !this.drawSpoolBreak(!arriveBoundary, true, true)
              endif
            else
              if (!allComponents.findFirst(!href).set()) then
                -- internally connected
              else

                !this.drawSpoolBreak(!arriveBoundary, true, true)
                handle ANY
                  !!alert.error(!!error.text)
                endhandle
              endif
            endif
          endif

          if (!arriveBoundary.tGeom) then
            !!ce = !arriveBoundary
            var !tubeShop HEADTUBE SHOP
            same
            if (!tubeShop.boolean().not()) then
              !this.drawSpoolBreak(!arriveBoundary, true, true)
              handle ANY
                !!alert.error(!!error.text)
              endhandle
            endif
          endif
        else
          !index = !allComponents.findFirst(!arriveBoundary)
          if (!index.set()) then
            if(!arriveBoundary.hardtype inset ('TEE', 'OLET')) then
              if(!arriveBoundary.asfbreak eq TRUE) then
                !this.drawSpoolBreak(!arriveBoundary, true, true)
                handle ANY
                  !!alert.error(!!error.text)
                endhandle
              endif
            endif
          else
            !this.drawSpoolBreak(!arriveBoundary, false, true)
            handle ANY
              !!alert.error(!!error.text)
            endhandle
          endif
        endif

        if (!leaveBoundary.type.eq('BRAN')) then
          !tref = !leaveBoundary.tref
          if (!tref.unset()) then
            -- connected to an external model
            !this.drawSpoolBreak(!leaveBoundary, false, true)
            handle ANY
              !!alert.error(!!error.text)
            endhandle
          else
            if (!tref.type.eq('BRAN')) then
              --checking if the connection is tail-tail.If it is,then the tref will be in the leave boundaries.If this condition is not included then
              --a dummy limit will be drawn which misleads us to think that there are two limits.
              if(!tref.tref.eq(!leaveBoundary)) then
                if(!leaveBoundaries.findFirst(!tref).unset()) then
                  !this.drawSpoolBreak(!leaveBoundary, false, true)
                endif
              elseif(!arriveBoundaries.findFirst(!tref).unset()) then
                !this.drawSpoolBreak(!leaveBoundary, false, true)
              endif
              handle ANY
                !!alert.error(!!error.text)
              endhandle
            else
              -- Fix for Issue 95233 (SI-56589)
              --if !allComponents.findFirst(!tref) then
              if (!allComponents.findFirst(!tref).set()) then
                -- internally connected
              else
                !this.drawSpoolBreak(!leaveBoundary, false, true)
                handle ANY
                  !!alert.error(!!error.text)
                endhandle
              endif
            endif
          endif
        else
          !index = !allComponents.findFirst(!leaveBoundary)
          if (!index.set()) then
            !this.drawSpoolBreak(!leaveBoundary, false, true)
            handle ANY
              !!alert.error(!!error.text)
            endhandle
          else
            !this.drawSpoolBreak(!leaveBoundary, true, true)
            handle ANY
              !!alert.error(!!error.text)
            endhandle
          endif
        endif

      enddo
    endif
  enddo
  if (!this.btnShowLooseComponents.val and !this.looseComponents.set()) then
    do !partRef values !this.looseComponents
      ENHANCE $!<partRef> COL $!!<gphColOpt.highlight.code>
    enddo
  endif
endmethod


--------------------------------------------------------------------------------
--
-- Method:      collectOletBranches
--
-- Description: collects all OLET branches
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R       DBREF     DBREF of pipe
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .collectOletBranches(!pipeRef is DBREF)
  !oletBranchs = object ARRAY()
  !oletRefs = !!collectAllFor('OLET', |Csfbreak eq TRUE|, !pipeRef)
  do !oleRef values !oletRefs
    !cref = !oleRef.cref
    if (!cref neq Nulref) then
      if (!cref.tsfbreak eq TRUE) then
        !oletBranchs.append(!cref)
      endif
    endif
  enddo
  !this.oletBranchCheck(!oletBranchs)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      oletBranchCheck
--
-- Description: checks all OLET branches based on some conditions for drawing spool breaks around OLET
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R       ARRAY     array of OLETS
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .oletBranchCheck(!oletBranchs is ARRAY)
  do !j indices !oletBranchs
    !oletBranch = !oletBranchs[!j]
    if (!oletBranch.type.eq('BRAN')) then
      !href = !oletBranch.href
      !tref = !oletBranch.tref
      if (!href.unset() and !tref.unset()) then
        -- connected to an external model
      elseif(!href.unset() and !tref.type.eq('OLET')) then
        if (!tref.csfbreak) then
          !this.drawSpoolBreak(!oletBranch, false, true)
        endif
      elseif(!href.type.eq('OLET') and !tref.unset()) then
        if (!href.csfbreak) then
          !this.drawSpoolBreak(!oletBranch, true, true)
        endif
      elseif(!href.type.eq('OLET') and !tref.type.eq('OLET')) then
        if (!href.csfbreak and !tref.csfbreak) then
          !this.drawSpoolBreak(!oletBranch, true, true)
          !this.drawSpoolBreak(!oletBranch, false, true)
        elseif(!href.csfbreak and !tref.csfbreak.not()) then
          !this.drawSpoolBreak(!oletBranch, true, true)
        elseif(!href.csfbreak.not() and !tref.csfbreak) then
          !this.drawSpoolBreak(!oletBranch, false, true)
        endif
      elseif(!href.type.eq('OLET') and !tref.type.eq('BRAN')) then
        !this.drawSpoolBreak(!oletBranch, true, true)
      elseif(!href.type.eq('BRAN') and !tref.type.eq('OLET')) then
        !this.drawSpoolBreak(!oletBranch, false, true)
      endif
    endif
  enddo
endmethod

--------------------------------------------------------------------------------
--
-- Method:      drawSpoolBreak
--
-- Description: display a plane at the given position of the given element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       component
--    2   R      REAL        ppoint number
--    3   R      BOOLEAN     true if the spool is not a real spool limit
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .drawSpoolBreak(!partRef is DBREF, !ppoint is REAL, !alreadyExists is BOOLEAN)

  !position = !partRef.ppos[!ppoint]
  !direction = !partRef.pdir[!ppoint]
  !outDiameter = !partRef.pod[!ppoint]
  if (!outDiameter.eq(0)) then
    !outDiameter = !partRef.ppbo[!ppoint].real()
    if (!outDiameter.eq(0)) then
      !outDiameter = !partRef.owner.phod
      if (!outDiameter.eq(0)) then
        !outDiameter = !partRef.owner.ptod
        if (!outDiameter.eq(0)) then
          !outDiameter = 100mm
        endif
      endif
    endif
  endif

  !size = !outDiameter * 3

  !pointVector = object POINTVECTOR(!position, !direction)
  !plane = !pointVector.plane()

  !gphPlane = object GPHPLANE(!plane)
  !gphPlane.x = !size
  !gphPlane.y = !size
  !gphPlane.filled(!alreadyExists)
  !gphPlane.draw(!this.aidNoForSpoolLimit, false)

endmethod

--------------------------------------------------------------------------------
--
-- Method:      drawSpoolBreak
--
-- Description: display a plane at the given position of the given element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       component
--    2   R      BOOLEAN     if true, the spool limit is displayed at the arrive position of the given component
--    3   R      BOOLEAN     true if the spool is not a real spool limit
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .drawSpoolBreak(!partRef is DBREF, !arrive is BOOLEAN, !alreadyExists is BOOLEAN)

  if (!arrive) then
    if (!partRef.type.eq('BRAN')) then
      !position    = !partRef.hpos
      !direction   = !partRef.hdir
      !outDiameter = !partRef.phod
    elseif (!partRef.type.eq('TUBI')) then
      !position    = !partRef.aPosition
      !direction   = !partRef.ori.ydir()
      !outDiameter = !partRef.param[2]
    else
      !position    = !partRef.aPosition
      !direction   = !partRef.adir
      !outDiameter = !partRef.pod[!partRef.arrive]
      if (!outDiameter.eq(0)) then
        !outDiameter = !partRef.ppbo[!partRef.arrive].real()
        if (!outDiameter.eq(0)) then
          !outDiameter = !partRef.owner.phod
          if (!outDiameter.eq(0)) then
            !outDiameter = !partRef.owner.ptod
            if (!outDiameter.eq(0)) then
              !outDiameter = 100mm
            endif
          endif
        endif
      endif
    endif
  else
    if (!partRef.type.eq('BRAN')) then
      !position    = !partRef.tpos
      !direction   = !partRef.tdir
      !outDiameter = !partRef.ptod
    elseif (!partRef.type.eq('TUBI')) then
      !position    = !partRef.lPosition
      !direction   = !partRef.ori.ydir()
      !outDiameter = !partRef.param[2]
    else
      !position    = !partRef.lPosition
      !direction   = !partRef.ldir
      !outDiameter = !partRef.pod[!partRef.leave]
      if (!outDiameter.eq(0)) then
        !outDiameter = !partRef.ppbo[!partRef.leave].real()
        if (!outDiameter.eq(0)) then
          !outDiameter = !partRef.owner.phod
          if (!outDiameter.eq(0)) then
            !outDiameter = !partRef.owner.ptod
            if (!outDiameter.eq(0)) then
              !outDiameter = 100mm
            endif
          endif
        endif
      endif
    endif
  endif

  !size = !outDiameter * 3

  !pointVector = object POINTVECTOR(!position, !direction)
  !plane = !pointVector.plane()

  !gphPlane = object GPHPLANE(!plane)
  !gphPlane.x = !size
  !gphPlane.y = !size
  !gphPlane.filled(!alreadyExists)
  !gphPlane.draw(!this.aidNoForSpoolLimit, false)
endmethod

--192248
--------------------------------------------------------------------------------
--
-- Method:      .drawSpoolBreakForTeeCRef
--
-- Description: display a plane at the given position of the given TEE CREF position
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       component
--    2   R      BOOLEAN     if true, the spool limit is displayed at the arrive position of the given component
--    3   R      BOOLEAN     true if the spool is not a real spool limit
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------

define method .drawSpoolBreakForTeeCRef(!partRef is DBREF, !arrive is BOOLEAN, !alreadyExists is BOOLEAN)

  if(!this.modeforSecondCompTCref eq true) then
    !position    = !this.selectedPartRefs[1].hpos
    !direction   = !this.selectedPartRefs[1].hdir
    !outDiameter = !this.selectedPartRefs[1].phod
  else
    !position    = !this.selectedPartRefs[1].tpos
    !direction   = !this.selectedPartRefs[1].tdir
    !outDiameter = !this.selectedPartRefs[1].ptod
  endif

  !size = !outDiameter * 3
  !pointVector = object POINTVECTOR(!position, !direction)
  !plane = !pointVector.plane()

  !gphPlane = object GPHPLANE(!plane)
  !gphPlane.x = !size
  !gphPlane.y = !size

  !gphPlane.filled(!alreadyExists.not())
  !gphPlane.draw(!this.aidNoForSpoolLimit, false)

endmethod
--/192248
--------------------------------------------------------------------------------
--
-- Method:      hideSpoolLimits
--
-- Description: hide all spool limits
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .hideSpoolLimits()
  do !part values !this.spoolLimitsComponents
    UNENHANCE $!part
    handle (2,121)
    endhandle
  enddo
  !this.spoolLimitsComponents.clear()
  !!aidNumbers.hide(!this.aidNoForSpoolLimit)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getNextSpoolColour
--
-- Description: return next available colour for a spool
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .getNextSpoolColour() is COLOUR
  !colour = !this.colours[!this.colourIndex]
  !this.colourIndex = !this.colourIndex + 1
  if (!this.colourIndex.gt(!this.colours.size())) then
    !this.colourIndex = 1
  endif
  return !colour
endmethod

--------------------------------------------------------------------------------
--
-- Method:      clearAll
--
-- Description: clear all aid elements and unenhance all elements. reset all button titles
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .clearAll()
  UNENHANCE ALL
  AID CLEAR ALL

  !this.btnShowEndExcess.tag = 'Show User End Excess'
  !this.btnShowFeedExcess.tag = 'Show User Feed Excess'
  !this.btnShowLooseComponents.tag = 'Show Loose Components'
  !this.btnShowSpoolLimits.tag = 'Show Spool Limits'

endmethod

--------------------------------------------------------------------------------
--
-- Method:      showLooseComponents
--
-- Description: display all loose components of the current element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .showLooseComponents()
  if (!this.pipeRef.badref().not()) then
    if (!this.existCurrentGraphicalView(!this.pipeRef)) then
      UNENHANCE ALL
      AID CLEAR ALL
      if !this.blnRefreshLooseComponents.not() then
        if !this.btnShowEndExcess.val then
          !this.refreshEndExcesses()
        endif
        if !this.btnShowFeedExcess.val then
          !this.refreshFeedExcesses()
        endif
        if !this.btnShowSpoolLimits.val then
          !this.refreshSpoolLimits()
        endif
      endif
      !result = !this.showLooseComponents(!this.pipeRef, true)
      if (!result) then
        if (!this.btnShowLooseComponents.val) then
          !this.btnShowLooseComponents.tag = 'Hide Loose Components'
        else
          !this.btnShowLooseComponents.tag = 'Show Loose Components'
        endif
      endif
    else
      if (!this.btnShowLooseComponents.tag eq 'Hide Loose Components') then
        !this.hideLooseComponents()
        !this.btnShowLooseComponents.tag = 'Show Loose Components'
      endif
    endif
  else
    !this.hideLooseComponents()
    !this.btnShowLooseComponents.active = false
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      showLooseComponents
--
-- Description: display all loose components of the given element
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       pipe element
--    2   R      BOOLEAN     if true, message box is displayed
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     return false if no loose component exists
--------------------------------------------------------------------------------
define method .showLooseComponents(!pipeRef is DBREF, !silent is BOOLEAN) is BOOLEAN

  !this.hideLooseComponents()

  !hasLooseParts = false

  if(!pipeRef.set()) then

    !showLooseComponents = !this.btnShowLooseComponents.val

    !branchRefs = !!collectAllFor('BRAN', '', !pipeRef)
    do !branchRef values !branchRefs
      do !partRef values !branchRef.members

        !loose = !partRef.loose
        handle ANY
          !loose = false
        endhandle

        if (!loose and !partRef.hardtype eq 'FLAN') then
          if (!partRef.compType.upcase() eq 'ALLO' AND !partRef.aExcess eq 0 and !partRef.lExcess eq 0) then
            !loose = false
          endif
        endif

        if (!loose) then
          if (!showLooseComponents) then
            -- highlight
            ENHANCE $!<partRef> COL $!!<gphColOpt.highlight.code>
            if (defined(!!pfComponentAttributes) and !!pfComponentAttributes.shownCompAttrForm.not()) then
              -- display text 'Loose'
              AID TEXT NUM $!this.aidNoForLoose 'Loose' AT $!<partRef.pos>
            elseif (!this.bfirstSession eq false) then
              AID TEXT NUM $!this.aidNoForLoose 'Loose' AT $!<partRef.pos>
            endif
          endif
          if (!this.looseComponents.findFirst(!partRef).unset()) then
            !this.looseComponents.append(!partRef)
          endif
          !hasLooseParts = true
        endif
      enddo
    enddo
    if (!hasLooseParts.not()) then
      !this.btnShowLooseComponents.active = false
    endif
  endif

  return !hasLooseParts
endmethod

--------------------------------------------------------------------------------
--
-- Method:      hideLooseComponents
--
-- Description: hide all loose components
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .hideLooseComponents()
  AID CLEAR ARROW ALL
  if (defined(!!pfComponentAttributes) and !!pfComponentAttributes.shown() and !!pfComponentAttributes.shownCompAttrForm eq TRUE) then
    if(!!dtbGetOwnerType(!!ce,|PIPE|).unset() or !!ce.type inset (|PIPE|,|BRAN|)) then
    else
      --!!pfComponentAttributes.selectTarget(!!pfComponentAttributes.target)
      !!pfComponentAttributes.selectTarget(!!ce)
    endif
  else
    do !part values !this.looseComponents
      UNENHANCE $!part
      UNMARK $!part
    enddo
    !!aidNumbers.hide(!this.aidNoForLoose)
    !this.looseComponents.clear()
  endif
endmethod


--------------------------------------------------------------------------------
--
-- Method:      hideFeedExcesses
--
-- Description: hide all feed excess values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .hideFeedExcesses()
  do !part values !this.feedExcessComponents
    UNENHANCE $!part
  enddo

  !this.feedExcessComponents.clear()
  !!aidNumbers.hide(!this.aidNoForFeedExcess)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      showFeedExcesses
--
-- Description: display all feed excess values
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .showFeedExcesses()
  if (!this.pipeRef.badref().not()) then
    if (!this.existCurrentGraphicalView(!this.pipeRef)) then
      UNENHANCE ALL
      AID CLEAR ALL
      if !this.blnRefreshFeedExcesses.not() then
        if !this.btnShowEndExcess.val then
          !this.refreshEndExcesses()
        endif
        if !this.btnShowLooseComponents.val then
          !this.refreshLooseComponents()
        endif

        if !this.btnShowSpoolLimits.val then
          !this.refreshSpoolLimits()
        endif
      endif
      !result = !this.showFeedExcesses(!this.pipeRef, true)
      if (!result) then
        if (!this.btnShowFeedExcess.val) then
          !this.btnShowFeedExcess.tag = 'Hide User Feed Excess'
        else
          !this.btnShowFeedExcess.tag = 'Show User Feed Excess'
        endif
      endif
    else
      if (!this.btnShowFeedExcess.tag eq 'Hide User Feed Excess') then
        !this.hideFeedExcesses()
        !this.btnShowFeedExcess.tag = 'Show User Feed Excess'
      endif
    endif
  else
    !this.hideFeedExcesses()
    !this.btnShowFeedExcess.active = false
  endif

endmethod


--------------------------------------------------------------------------------
--
-- Method:      showFeedExcesses
--
-- Description: display all feed excess values of the given pipe element
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       pipe element
--    2   R      BOOLEAN     if false, no message box is displayed
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     return false if no feed excess exists
--------------------------------------------------------------------------------
define method .showFeedExcesses(!pipeRef is DBREF, !silent is BOOLEAN) is BOOLEAN
  !this.hideFeedExcesses()
  !hasFeedExcess = false

  !showFeedExcess = !this.btnShowFeedExcess.val

  !branchRefs = !!collectAllFor('BRAN', '', !pipeRef)
  do !branchRef values !branchRefs

    !bendRef = object DBREF()
    !components = object ARRAY()
    !feedExcess = 0mm

    !memberRefs = !!collectAllFor('BRAN MEM', '', !branchRef)
    do !partRef values !memberRefs
      !partType = !partRef.type
      if (!partType.eq('BEND')) then

        if (!bendRef.set() and !feedExcess.gt(0mm)) then
          if (!showFeedExcess) then
            -- display feed excess
            !position = !bendRef.lpos.midPoint(!partRef.apos)
            !feedString = 'Feed : ' + !feedExcess.string(!!distanceFmt)
            AID TEXT NUM $!this.aidNoForFeedExcess |$!feedString| AT $!position

            -- highlight components between bends
            do !component values !components
              ENHANCE $!component COL $!!<gphColOpt.highlight.code>
              if (!this.feedExcessComponents.findFirst(!component).unset()) then
                !this.feedExcessComponents.append(!component)
              endif
            enddo
          endif

          !hasFeedExcess = true
        endif

        !feedExcess = !partRef.usefed
        if (!feedExcess.gt(0mm)) then
          !bendRef = !partRef
        else
          !bendRef = object DBREF()
        endif
        !components.clear()

      else
        !components.append(!partRef)
      endif
    enddo

  enddo

  if (!hasFeedExcess.not()) then
    !this.btnShowFeedExcess.active = false
    return false
  endif

  return !hasFeedExcess
endmethod


--------------------------------------------------------------------------------
--
-- Method:      setFeedExcess
--
-- Description: start an EDG process for setting feed excess value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     return false if no feed excess exists
--------------------------------------------------------------------------------
define method .setFeedExcess()
  !this.toCheckActiveFunctionality( 'PF - Set Feed Excess')
  if(!this.result) then
    !this.quitEDG()
    !!fmSys.loadForm('pfFeedExcess').setFeedExcess()
  endif
  !this.result = true
endmethod

--------------------------------------------------------------------------------
--
-- Method:      setSpoolLimit
--
-- Description: initiate an EDG process for setting spool limits
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      mode for spool limits
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .setSpoolLimit(!mode is STRING)

  !this.spoolLimitMode = !mode
  --116359
  !edgMsg = !!edgCntrl.state.packet.description
  if(!mode.eq(!this.breakMode) and  !edgMsg.eq('PF - Set Spool Limit')) then
    !this.result = false
    return
  else
    !this.toCheckActiveFunctionality('PF - Set Spool Limit')
  endif
  --/116359
  !this.breakMode = !mode
  if(!this.result) then
    !this.quitEDG()
    !this.pickMode = true

    !packet = object EDGPACKET()
    !packet.action = |!!pfModifySpool.onActionSetSpoolLimit(!this.return)|
    !packet.escape = |!!pfModifySpool.onEscapeSetSpoolLimit()|

    !elementFilter = |TYPE of OWNER of OWNER eq 'PIPE'|

    --!packet.definePosition('Pick part or <ESC> to finish')
    !packet.pickPacket.picks.append(object EDGPICKTYPE())
    !packet.pickPacket.picks.append(object EDGPICKTYPE())
    !packet.pickPacket.picks[1].stdElement('Pick first component or <ESC> to finish')
    !packet.pickPacket.picks[1].action = '!!pfModifySpool.firstComponentSelected(!this.return)'
    !packet.pickPacket.picks[1].pick.input[3] = !elementFilter

    !packet.pickPacket.picks[1].pick.input[5] = |false|
    !packet.pickPacket.picks[1].pick.modifiable = false

    !packet.pickPacket.picks[2].stdElement('Pick second component or <ESC> to finish')
    !packet.pickPacket.picks[2].action = '!!pfModifySpool.secondComponentSelected(!this.return)'
    !packet.pickPacket.picks[2].pick.input[3] = !elementFilter
    --!packet.pickPacket.picks[2].pick.input[5] = |TRUE|
    !packet.pickPacket.picks[2].pick.modifiable = false

    --!packet.pickPacket.picks[1].pick.input[3] = |TYPE EQ 'TUBING'|
    --!packet.pickPacket.picks[1].pick.input[6] = |FACET|
    --!packet.pickPacket.picks[1].pick.input[5] = true
    --!packet.pickPacket.picks[1].pick.modifiable = false
    !packet.description = 'PF - Set Spool Limit'
    !packet.remove = false
    !!edgCntrl.add(!packet)
  endif
  !this.result = true
endmethod


--------------------------------------------------------------------------------
--
-- Method:      componentSelected
--
-- Description: highlight the coupling component picked by EDG
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       EDG data
-- Return:
--   [Data Type] [Description]
--    ANY         the coupling component
--------------------------------------------------------------------------------
define method .firstComponentSelected(!data is ARRAY) is ANY

  --192248
  !this.bTweldCreated = false
  --/192248
  !item = !data[1].item
  --!this.firCompType = !item.type
  !this.firComp = !item
  if (!data[1].type.eq('TUBING')) then
    if (!data[1].tubing.eq('LEAVE') or !data[1].tubing.eq('HEAD')) then
      !partRef = ILEAVE TUB OF $!item
    else
      !partRef = IARRIVE TUB OF $!item
    endif

    -- reject if the tube length is shorter than 1mm
    !itlength = !partRef.itlength
    handle ANY
      !itlength = 0mm
    endhandle

    if (!itlength.lt(1mm)) then
      return
    endif

  else
    !partRef = !item
  endif

  !partType = !partRef.type

  --192248
  if(!partRef.type inset ('TEE', 'OLET')) then
    if (!partRef.cref.set()) then
      if(!partRef.cref.type eq 'BRAN') then
        if(!partRef.cref.href eq !partRef) then
          !this.modeforfirstCompTCref = true
        elseif(!partRef.cref.tref eq !partRef) then
          !this.modeforfirstCompTCref = false
        endif
      endif
    else
      !this.modeforfirstCompTCref = false
    endif
  endif
  --/192248

  if (!partType.eq('BEND') and !partRef.actncuts.gt(0)) then
    if(!this.spoolLimitMode.neq('WELD')) then
      !!alert.message('Cannot set a spool limit at a mitre bend!')
      return
    endif
  endif

  if (!partType.eq('ATTA') and !partRef.spkbrk.not()) then
    !!alert.message('Cannot set a spool limit at an off-line ATTA!')
    return
  endif

  if (!partType.neq('TUBI')) then
    !offline = !partRef.loffline
    handle ANY
      !offline = false
    endhandle

    !shop = !partRef.shop
    handle ANY
      !shop = false
    endhandle
    if (!shop.not()) then
      !!alert.message('Cannot (re)set a spool limit at a filed component!')
      return
    endif
  endif

  if (!this.breakMode.neq('WELD')) then

    !asfbreak = !partRef.asfbreak
    handle ANY
      !!alert.message('Selected component does not have attributes ASFBR and LSFBR!')
      return
    endhandle
    !this.drawSpoolBreaksAroundComponent(!partRef)
  else
    !this.getSpoolBreakCandidates(!partRef)
    if (!this.spoolBreaks.empty()) then
      return
    endif

    do !i indices !this.spoolBreaks
      !this.drawSpoolBreak(!this.spoolBreaks[!i][1], !this.spoolBreaks[!i][2], !this.spoolBreaks[!i][3])
    enddo

  endif

  ENHANCE $!<partRef> COL $!!<gphColOpt.highlight.code>
  return !data[1]
endmethod

--------------------------------------------------------------------------------
--
-- Method:      drawSpoolBreaksAroundComponent
--
-- Description: draw spool breaks around the given component
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       a component
--    2   R      BOOL        if true, the spool break information is saved into member variable
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .drawSpoolBreaksAroundComponent(!partRef is DBREF)
  !asfbreak = !partRef.asfbreak
  handle any
    return
  endhandle
  !lsfbreak = !partRef.lsfbreak
  handle any
    return
  endhandle
  !csfbreak = !partRef.csfbreak
  handle any
    return
  endhandle
  if(!partRef.hardtype.eq('OLET')) then
    !oletPpoint = 3
    !this.drawSpoolBreak(!partRef,!oletPpoint,!csfbreak)
    handle ANY
      !!alert.error(!!error.text)
      return
    endhandle
  else
    !arrive = !partRef.arrive
    !leave = !partRef.leave
    !this.drawSpoolBreak(!partRef, !arrive, !asfbreak)
    handle ANY
      !!alert.error(!!error.text)
    endhandle

    !this.drawSpoolBreak(!partRef, !leave, !lsfbreak)
    handle ANY
      !!alert.error(!!error.text)
    endhandle

    if(!partRef.hardtype.eq('TEE')) then
      if (!partRef.cref.set()) then
        if(!arrive eq 1) then
          if(!leave eq 2) then
            !teebran = 3
          else
            !teebran = 2
          endif
        elseif(!arrive eq 2) then
          if(!leave eq 1) then
            !teebran = 3
          else
            !teebran = 1
          endif
        elseif(!arrive eq 3) then
          if(!leave eq 1) then
            !teebran = 2
          else
            !teebran = 1
          endif
        endif

        !this.drawSpoolBreak(!partRef, !teebran, !csfbreak)
        handle ANY
          !!alert.error(!!error.text)
        endhandle
      endif
    endif
  endif
endmethod


--------------------------------------------------------------------------------
--
-- Method:      secondComponentSelected
--
-- Description: callback called when the second component is selected for creating/deleting a spool break
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       EDG data
-- Return:
--   [Data Type]   [Description]
--    EDGPICKDATA   EDG pick data
--------------------------------------------------------------------------------
define method .secondComponentSelected(!data is ARRAY) is ANY
  !item = !data[1].item
  --checking if the first component type is olet or not
  if(!this.firComp.type.eq('OLET')) then
    --checking whether the second component picked is branch or not
    if(!item.type.eq('BRAN')) then
      !this.branchCheckForOlet(!item)
    else
      !this.nonBranchCheckForOlet(!data)
    endif
  endif

  if (!data[1].type.eq('TUBING')) then
    if (!data[1].tubing.eq('LEAVE') or !data[1].tubing.eq('HEAD')) then
      !partRef = ILEAVE TUB OF $!item
    else
      !partRef = IARRIVE TUBE OF $!item
    endif
  else
    !partRef = !item
  endif

  ENHANCE $!<partRef> COL $!!<gphColOpt.highlight.code>

  return !data[1]
endmethod

--------------------------------------------------------------------------------
--
-- Method:      branchCheckForOlet
--
-- Description: called when the second component picked is a branch and first component being OLET
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R       DBREF     DBREF of second component picked
-- Return:
--   [Data Type]   [Description]
--
--------------------------------------------------------------------------------
define method .branchCheckForOlet(!item is DBREF)
  --Checking if the second element picked is on the P1/P2 side of the OLET
  !chAdir = !this.firComp.adir.eq(!item.hdir) or !this.firComp.adir.eq(!item.tdir)
  !chLdir =  !this.firComp.ldir.eq(!item.hdir) or !this.firComp.ldir.eq(!item.tdir)

  if(!chAdir or !chLdir) then
    !message = |main|
    !this.showPickErrorForOlet(!message)
  else
    --checking if the picked component is not on the P3 side of the OLET
    if(!this.firComp.cref.neq(!item)) then
      --if the component picked is not on the P1/P2/P3 side of the OLET
      !message = |random|
      !this.showPickErrorForOlet(!message)
    endif
  endif
endmethod


--------------------------------------------------------------------------------
--
-- Method:      nonBranchCheckForOlet
--
-- Description: called when the second component picked is not a branch and first component being OLET
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R       ARRAY       EDG data
-- Return:
--   [Data Type]   [Description]
--
--------------------------------------------------------------------------------
define method .nonBranchCheckForOlet(!data is ARRAY)
  !item = !data[1].item
  --Checking if the second element picked is on the P1/P2 side of the OLET
  !chAdir = !this.firComp.adir.eq(!item.adir) or !this.firComp.adir.eq(!item.ldir)
  !chLdir =  !this.firComp.ldir.eq(!item.adir) or !this.firComp.ldir.eq(!item.ldir)
  --if the picked second component is in the arrive/leave direction of the olet then popping an error
  if(!chAdir or !chLdir) then
    !message = |main|
    !this.showPickErrorForOlet(!message)
  else
    --checking whether the head of the branch is connected to olet
    if(!this.firComp.cref.href.eq(!this.firComp)) then
      !set = !this.onBranchHeadConnectedToOlet(!data)
      --checking whether the tail of the branch is connected to olet
    elseif(!this.firComp.cref.tref.eq(!this.firComp)) then
      !set = !this.onBranchTailConnectedToOlet(!data)
    endif
    if(!set) then
      --if the component picked is not on the P1/P2/P3 side of the OLET
      !message = |random|
      !this.showPickErrorForOlet(!message)
    endif
  endif
endmethod


--------------------------------------------------------------------------------
--
-- Method:      onBranchHeadConnectedToOlet
--
-- Description:  called when the branch head is connected to OLET
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R       ARRAY       EDG data
-- Return:
--   [Data Type]   [Description]
--    BOOLEAN       returns false, if second component picked is on the P3 side of OLET
--------------------------------------------------------------------------------
define method .onBranchHeadConnectedToOlet(!data is ARRAY) is BOOLEAN
  !set = true
  !item = !data[1].item
  if(!this.firComp.cref.members[1].type.neq(|WELD|)) then
    if(!this.firComp.cref.members[1].eq(!item)) then
      !set = false
      return !set
    endif
    --For removal of "spool limits with welds" where weld will be a part of the branch,checking if the second component picked is
    --same as the second member of the branch(ignoring the first member which is weld) or if it is the ileave tube of the weld.
  else
    if(!this.firComp.cref.members[2].eq(!item) or (!data[1].type.eq(|TUBING|) and !this.firComp.cref.members[1].eq(!item))) then
      !set = false
      return !set
    endif
  endif
  return !set
endmethod


--------------------------------------------------------------------------------
--
-- Method:      onBranchTailConnectedToOlet
--
-- Description: called when the branch tail is connected to OLET
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R       ARRAY       EDG data
-- Return:
--   [Data Type]   [Description]
--  BOOLEAN       returns false, if second component picked is on the P3 side of OLET
--------------------------------------------------------------------------------
define method .onBranchTailConnectedToOlet(!data is ARRAY) is BOOLEAN
  !set = true
  !item = !data[1].item
  !branchCount = !item.owner.members.size()
  if(!this.firComp.cref.members[!branchCount].type.neq(|WELD|)) then
    if(!this.firComp.cref.members[!branchCount].eq(!item)) then
      !set = false
      return !set
    endif
  else
    --For removal of "spool limits with welds" where weld will be a part of the branch,checking if the second component picked is
    --same as the last second member of the branch(ignoring the first member which is weld) or if it is the ileave tube of the weld.
    if(!this.firComp.cref.members[!branchCount - 1 ].eq(!item) or (!data[!branchCount].type.eq(|TUBING|) and !this.firComp.cref.members[!branchCount - 1].eq(!item))) then
      !set = false
      return !set
    endif
  endif
  return !set
endmethod


--------------------------------------------------------------------------------
--
-- Method:      onMainLinePickErrorForOlet
--
-- Description: called when the second component picked is on P1/P2 side of the OLET
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type]   [Description]
--
--------------------------------------------------------------------------------
define method .showPickErrorForOlet(!message is STRING)
  if(!message.eq(|main|)) then
    !!alert.warning( |Cannot set a spool limit on main branch using an off-line component!| )
    !this.onEscapeSetSpoolLimit()
  else
    !!alert.warning( |Cannot set a spool limit here..| )
    !this.onEscapeSetSpoolLimit()
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      onEscapeSetSpoolLimit
--
-- Description: callback called when the EDG process for creating/deleting a spool break is escaped
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type]   [Description]
--
--------------------------------------------------------------------------------
define method .onEscapeSetSpoolLimit()
  !this.pickMode = false
  !this.quitEDG()

  UNENHANCE ALL
  !this.hideSpoolLimits()
  if (!this.btnShowSpoolLimits.tag.subString(1, 4).eq('Hide')) then
    !this.showSpoolLimits(!this.pipeRef, true, true)
    handle ANY
    endhandle
  endif
endmethod



--------------------------------------------------------------------------------
--
-- Method:      onActionSetSpoolLimit
--
-- Description: set a spool limit at the picked coupling component
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       EDG data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onActionSetSpoolLimit(!data is ARRAY)
  --192248
  !bcrefcompselected = false
  !bremoveWeld = false
  !this.selectedPartRefs = object ARRAY()
  --/192248

  if !data[1][1].item.eq(!data[1][2].item) and $
    !data[1][1].type.eq(!data[1][2].type) and $
    !data[1][1].tubing.eq(!data[1][2].tubing) then
    -- same component selected twice - just let's restart
    !this.onEscapeSetSpoolLimit()
    return
  endif

  !partRef1 = !data[1][1].item
  !partRef2 = !data[1][2].item
  --192248
  !this.selectedPartRefs[0] = !partRef1
  !this.selectedPartRefs[1] = !partRef2
  if(!this.selectedPartRefs[0].type inset ('TEE', 'OLET')) then
    if(!this.selectedPartRefs[1].type neq 'BRAN') then
      if(!this.selectedPartRefs[0].cref eq !partRef2.owner) then
        !this.selectedPartRefs[1] = !partRef2.owner
        !this.selectedPartRefs[2] = !partRef2
      endif
    endif
  endif
  --/192248

  if (!data[1][1].type.eq('TUBING')) then
    if (!data[1][1].tubing inset ('LEAVE', 'HEAD')) then
      !partRef1 = ILEAVE TUB OF $!partRef1
    else
      !partRef1 = IARRIVE TUBE OF $!partRef1
    endif
  endif


  if (!data[1][2].type.eq('TUBING')) then
    if (!data[1][2].tubing inset ('LEAVE', 'HEAD')) then
      !partRef2 = ILEAVE TUB OF $!partRef2
    else
      !partRef2 = IARRIVE TUBE OF $!partRef2
    endif
  endif
  --192248
  --check always if component first partref1 is TEE or OLET and partref2 is equal to partref1 cref
  if(!this.selectedPartRefs[0].type inset ('TEE', 'OLET') and (!this.selectedPartRefs[0].cref eq !this.selectedPartRefs[1])) then
    !bcrefcompselected = true
    if(!this.selectedPartRefs[0].cend eq 'HEAD') then
      !this.modeforSecondCompTCref = true
    else
      !this.modeforSecondCompTCref = false
    endif
  else
    !bcrefcompselected = false
  endif
  --/192248

  --222712
  -- check whether there is split limit for P3 position of TEE
  if(!bcrefcompselected eq true) then
    if(!this.checkExistSplitLimitsonTEE(!partRef1,!partRef2)) then
      return
    endif
    -- check whether there is split limit
  else
    --/222712
    if (!this.checkExistSplitLimits(!partRef1, !partRef2)) then
      return
    endif
  endif


  if (!partRef1.type.eq('TUBI')) then
    !position1 = !partRef1.apos.midPoint(!partRef1.lpos)
    !adir = !partRef1.lpos.direction(!partRef1.apos)
    !ldir = !adir.opposite()
  else
    !position1 = !partRef1.pos
    !adir = !partRef1.adir
    !ldir = !partRef1.ldir
  endif

  if (!partRef2.type.eq('TUBI')) then
    !position2 = !partRef2.itpos
  else
    !position2 = !partRef2.pos
  endif



  if (!this.breakMode.eq('WELD')) then
    -- create a spool break with WELD
    -- find the nearest break position
    --192248
    if(!bcrefcompselected eq true) then
      --incase of OLET spool breaks will not be there at P1/P2 side so spoolBreaks array contains only 1 member
      if(!this.spoolBreaks.size().gt(1)) then
        !data = !this.spoolBreaks[3]
      else
        !data = !this.spoolBreaks[1]
      endif
      !partRef = !data[1]
      !arrive = !data[2]
      !exists = !data[3]
      !bremoveWeld = !exists
      !limitRef = !data[4]
      --/192248
    else
      if(!this.spoolbreaks.size() gt 2) then
        !this.spoolbreaks.remove(3)
      endif
      !dotValues = object ARRAY()
      do !i indices !this.spoolBreaks

        !partRef    = !this.spoolBreaks[!i][1]
        !objectType = !this.spoolBreaks[!i][2].objectType()

        if (!objectType.eq('REAL')) then
          !ppoint = !this.spoolBreaks[!i][2]
          !dotValues.append(!position1.direction(!position2).dot(!partRef.pdir[!ppoint]))
          !this.spoolBreaks[!i][2] = !this.modeforSecondCompTCref
        else
          !arrive = !this.spoolBreaks[!i][2]
          if (!arrive) then
            !dotValues.append(!position1.direction(!position2).dot(!adir))
          else
            !dotValues.append(!position1.direction(!position2).dot(!ldir))
          endif
        endif

      enddo

      !sortedIndices = !dotValues.sortedIndices()
      !data = !this.spoolBreaks[!sortedIndices.last()]

      !partRef  = !data[1]
      !arrive   = !data[2]
      !exists   = !data[3]
      !limitRef = !data[4]
    endif

    !!aidNumbers.hide(!this.aidNoForSpoolLimit)
    --192248
    if(!bcrefcompselected eq true) then
      !this.drawSpoolBreakForTeeCRef(!this.selectedPartRefs[0], !arrive, !exists)
    else
      --/192248
      !this.drawSpoolBreak(!partRef, !arrive, !exists.not())
    endif
    --192248
    if (!bremoveWeld eq true) then
      ENHANCE $!<this.selectedPartRefs[1]> COL $!!<gphColOpt.highlight.code>
      !res = !!alert.confirm('OK to remove?')
      if (!res.eq('YES')) then
        !this.undo.description('Delete Spool Limit')
        !this.undo.add()
        !weldlist = !!collectAllfor('weld',||,!this.selectedPartRefs[1])
        if (!this.modeforfirstCompTCref eq true) then
          !position    = !this.selectedPartRefs[1].hpos.wrt(world)
          !firstweldtodelete = first mem of $!this.selectedPartRefs[1]
        else
          !position    = !this.selectedPartRefs[1].tpos.wrt(world)
          !lastweldtodelete = last mem of $!this.selectedPartRefs[1]
        endif
        if (!weldlist.size() gt 0) then
          do !weldRef values !weldlist
            if (!this.modeforfirstCompTCref eq true) then
              if(!weldRef.pos.wrt(world).distance(!position).string('d1').real().eq(0) or (!firstweldtodelete eq !weldRef) ) then
                !!ce = !weldRef
                DELETE WELD
              endif
            else
              if(!weldRef.pos.wrt(world).distance(!position).string('d1').real().eq(0) or (!lastweldtodelete eq !weldRef) ) then
                !!ce = !weldRef
                DELETE WELD
              endif
            endif
          enddo
        endif
        handle ANY
          !!alert.error(!!error.text)
        endhandle
        !this.undo.endUndoable()
      endif
      --/192248
    elseif ((!exists) and (!bcrefcompselected eq false)) then
      if (!limitRef.type.eq('WELD')) then
        ENHANCE $!<limitRef> COL $!!<gphColOpt.highlight.code>
        !res = !!alert.confirm('OK to remove?')
        if (!res.eq('YES')) then

          !this.undo.description('Delete Spool Limit')
          !this.undo.add()

          !!ce = !limitRef
          DELETE WELD
          handle ANY
            !!alert.error(!!error.text)
          endhandle

          !this.undo.endUndoable()
        endif
      else
        !!alert.message('Cannot reset the spool limit of field component!')
      endif

    else
      if (!this.replaceSplitType) then
        !res = 'YES'
      else
        !res = !!alert.confirm('OK to add?')
      endif

      if (!res.eq('YES')) then

        !this.undo.description('Set Spool Limit')
        !this.undo.add()

        var !mode mode
        if (!partRef.type.eq('TUBI')) then
          !forward = !arrive
          if (!arrive) then
            !prevRef = PREV OF $!partRef
            handle ANY
              -- no previous component. this means we are at the head of branch
              !partRef = !partRef.owner
            elsehandle NONE
              -- previous component exists
              !partRef = !prevRef
            endhandle
          else
            !nextRef = NEXT OF $!partRef
            handle ANY
              -- no next component. this means we are at the tail of branch
              !partRef = !partRef.owner
            elsehandle NONE
              -- next component exists
              !partRef = !nextRef
            endhandle
          endif
        else
          !forward = !arrive.not()
        endif
        !this.createSpoolBreakWithWeld(!partRef, !forward)
        handle ANY
        endhandle
        $!mode

        !this.undo.endUndoable()

      endif
    endif
  else

    -- create a spool break by ASFBREAK or LSFBREAK and TSFBREAK

    !dot1 = !position1.direction(!position2).dot(!adir)
    !dot2 = !position1.direction(!position2).dot(!ldir)

    !existTube = !partRef1.type eq 'TUBI' or !partRef2.type eq 'TUBI'
    --check if there is a break created at arrive or leave side (This is for special case where we are trying to create spool break between "tee" of one branch and another branch)
    !checkIfItIsTee = !partRef1.type.eq(|TEE|) or !partRef2.type.eq(|TEE|)
    !checkForTeeOnArriveOrLeave = !checkIfItIsTee and (!dot1.lt(!dot2) OR !dot1.gt(!dot2))
    --check if the owners of the both components are different.If they are,then checking if the second component picked is on the arrive or leave side of tee
    --if the component picked is on the arrive/leave side of the tee then we are not entering this if condition and going into the
    --else part where other breaks are handled.(since the following if condition is only meant for p3 side of tee)
    if (own of $!partRef1 neq own of $!partRef2 AND !checkForTeeOnArriveOrLeave.not()) then

      if (!partRef1.type inset ('TEE', 'OLET')) then
        !arrive = !partRef1.arrive
        !leave  = !partRef1.leave
        --if the first component is olet then setting spool break only at the p3 side of the olet
        if (!partRef1.type.eq('OLET')) then
          !ppoint = 3
        else
          if(!arrive eq 1) then
            if(!leave eq 2) then
              !ppoint = 3
            else
              !ppoint = 2
            endif
          elseif(!arrive eq 2) then
            if(!leave eq 1) then
              !ppoint = 3
            else
              !ppoint = 1
            endif
          elseif(!arrive eq 3) then
            if(!leave eq 1) then
              !ppoint = 2
            else
              !ppoint = 1
            endif
          endif
        endif
        !exists = !partRef1.csfbreak and !partRef2.owner.tsfbreak
        !href = !partRef2.owner.href
        handle any
          !href = Nulref
        endhandle
        !tref = !partRef2.owner.tref
        handle any
          !tref = Nulref
        endhandle
        !!aidNumbers.hide(!this.aidNoForSpoolLimit)

        if(!exists) then
          !this.drawSpoolBreak(!partRef1, !ppoint, !exists)
          !res = !!alert.confirm('OK to remove?')
          if (!res.eq('YES')) then
            !this.undo.description('Delete Spool Limit')
            !this.undo.add()

            if (!href neq Nulref and !tref neq Nulref) then
              if($!partRef1 eq $!href) then
                !partRef1.csfbreak = false
                if(!tref.hardtype inset ('TEE', 'OLET') and !tref.csfbreak eq FALSE) then
                  !partRef2.owner.tsfbreak = false
                endif
              endif

              if($!partRef1 eq $!tref) then
                !partRef1.csfbreak = false
                if(!href.hardtype inset ('TEE', 'OLET') and !href.csfbreak eq FALSE) then
                  !partRef2.owner.tsfbreak = false
                endif
              endif
            elseif(!href eq Nulref or !tref eq Nulref) then
              !partRef1.csfbreak = false
              !partRef2.owner.tsfbreak = false
            endif
            !this.undo.endUndoable()
          endif
        else
          !this.drawSpoolBreak(!partRef1, !ppoint, !exists)
          if (!this.replaceSplitType) then
            !res = 'YES'
          else
            !res = !!alert.confirm('OK to add?')
          endif
          if (!res.eq('YES')) then
            !this.undo.description('Set Spool Limit')
            !this.undo.add()
            !partRef1.csfbreak = true
            !partRef2.owner.tsfbreak = true
            !this.undo.endUndoable()
          endif
        endif
        --Creates a spool break if owner of the two picked components is different and the first component is other than TEE
      else
        if (!dot1.lt(!dot2)) then
          -- leave point
          !arrive = false
          !ppoint = !partRef1.leave
          !exists = !partRef1.lsfbreak
        else
          -- arrive point
          !arrive = true
          !ppoint = !partRef1.arrive
          !exists = !partRef1.asfbreak
        endif

        if (!existTube.not()) then
          if (!arrive) then
            !exists = !partRef2.lsfbreak
            handle ANY
              !!alert.error(!!error.text)
            endhandle
          else
            !exists = !partRef1.lsfbreak
            handle ANY
              !!alert.error(!!error.text)
            endhandle
          endif
        endif

        !!aidNumbers.hide(!this.aidNoForSpoolLimit)

        if (!exists) then
          !this.drawSpoolBreak(!partRef1, !ppoint, !exists)

          !res = !!alert.confirm('OK to remove?')
          if (!res.eq('YES')) then

            !this.undo.description('Delete Spool Limit')
            !this.undo.add()

            if (!existTube) then
              if (!arrive) then
                !partRef1.asfbreak = false
                handle ANY
                  !!alert.error(!!error.text)
                endhandle
              else
                !partRef1.lsfbreak = false
                handle ANY
                  !!alert.error(!!error.text)
                endhandle
              endif
            else
              if (!arrive) then
                !firstComp  = !partRef2
                !secondComp = !partRef1
              else
                !firstComp  = !partRef1
                !secondComp = !partRef2
              endif

              !firstComp.csfbreak = false
              handle ANY
                !!alert.error(!!error.text)
              endhandle

              !firstComp.lsfbreak = false
              handle ANY
                !!alert.error(!!error.text)
              endhandle

              !secondComp.csfbreak = false
              !secondComp.asfbreak = false
              handle ANY
                !!alert.error(!!error.text)
              endhandle
            endif

            !this.undo.endUndoable()

          endif
        else
          !this.drawSpoolBreak(!partRef1, !ppoint, !exists)
          if (!this.replaceSplitType) then
            !res = 'YES'
          else
            !res = !!alert.confirm('OK to add?')
          endif

          if (!res.eq('YES')) then
            !this.undo.description('Set Spool Limit')
            !this.undo.add()

            if (!existTube) then
              if (!arrive) then
                !partRef1.asfbreak = true
                handle ANY
                  !!alert.error(!!error.text)
                endhandle
              else
                !partRef1.lsfbreak = true
                handle ANY
                  !!alert.error(!!error.text)
                endhandle
              endif
            else
              if (!arrive) then
                !firstComp  = !partRef2
                !secondComp = !partRef1
              else
                !firstComp  = !partRef1
                !secondComp = !partRef2
              endif

              !firstComp.lsfbreak = true
              !secondComp.asfbreak = true
              handle ANY
                !!alert.error(!!error.text)
              endhandle
            endif

            !this.undo.endUndoable()

          endif
        endif
      endif
    else
      !tsfexist = false
      -- create a spool break by ASFBREAK or LSFBREAK
      if (!dot1.lt(!dot2)) then
        -- leave point
        !arrive = false
        !ppoint = !partRef1.leave
        !exists = !partRef1.lsfbreak
        --if second component is of type branch then taking tsfbreak into account(special case TEE)
        if(!partRef2.type.eq(|BRAN|)) then
          !tsfexist = !partRef2.tsfbreak
        endif
      else
        -- arrive point
        !arrive = true
        !ppoint = !partRef1.arrive
        !exists = !partRef1.asfbreak
        --if second component is of type branch then taking tsfbreak into account(special case TEE)
        if(!partRef2.type.eq(|BRAN|)) then
          !tsfexist = !partRef2.tsfbreak
        endif
      endif

      if (!existTube.not()) then
        if (!arrive) then
          !exists = !partRef2.lsfbreak
          handle ANY
            !!alert.error(!!error.text)
          endhandle
        else
          !exists = !partRef1.lsfbreak
          handle ANY
            !!alert.error(!!error.text)
          endhandle
        endif
      endif

      !!aidNumbers.hide(!this.aidNoForSpoolLimit)

      if (!exists) then
        !this.drawSpoolBreak(!partRef1, !ppoint, !exists)

        !res = !!alert.confirm('OK to remove?')
        if (!res.eq('YES')) then

          !this.undo.description('Delete Spool Limit')
          !this.undo.add()

          if (!existTube) then
            if (!arrive) then
              !partRef1.asfbreak = false
              handle ANY
                !!alert.error(!!error.text)
              endhandle
              --if TSFBREAK exists then making it false.
              if(!tsfexist) then
                !partRef2.tsfbreak = false
              endif
            else
              !partRef1.lsfbreak = false
              handle ANY
                !!alert.error(!!error.text)
              endhandle
              --if TSFBREAK exists then making it false.
              if(!tsfexist) then
                !partRef2.tsfbreak = false
              endif
            endif
          else
            if (!arrive) then
              !firstComp  = !partRef2
              !secondComp = !partRef1
            else
              !firstComp  = !partRef1
              !secondComp = !partRef2
            endif

            !firstComp.csfbreak = false
            handle ANY
              !!alert.error(!!error.text)
            endhandle

            !firstComp.lsfbreak = false
            handle ANY
              !!alert.error(!!error.text)
            endhandle

            !secondComp.csfbreak = false
            !secondComp.asfbreak = false
            handle ANY
              !!alert.error(!!error.text)
            endhandle
          endif

          !this.undo.endUndoable()

        endif
      else

        !this.drawSpoolBreak(!partRef1, !ppoint, !exists)
        if (!this.replaceSplitType) then
          !res = 'YES'
        else
          !res = !!alert.confirm('OK to add?')
        endif

        if (!res.eq('YES')) then
          !this.undo.description('Set Spool Limit')
          !this.undo.add()

          if (!existTube) then
            if (!arrive) then
              !partRef1.asfbreak = true
              handle ANY
                !!alert.error(!!error.text)
              endhandle
            else
              !partRef1.lsfbreak = true
              handle ANY
                !!alert.error(!!error.text)
              endhandle
            endif
          else
            if (!arrive) then
              !firstComp  = !partRef2
              !secondComp = !partRef1
            else
              !firstComp  = !partRef1
              !secondComp = !partRef2
            endif

            !firstComp.lsfbreak = true
            !secondComp.asfbreak = true
            handle ANY
              !!alert.error(!!error.text)
            endhandle
          endif

          !this.undo.endUndoable()

        endif
      endif
    endif
  endif

  --192248
  !this.spoolBreaks = object ARRAY()
  --/192248
  !this.onEscapeSetSpoolLimit()

endmethod

--222712
define method .checkExistSplitLimitsonTEE(!partRef1 is DBREF, !partRef2 is DBREF) is BOOLEAN

  if(!partRef1.type inset ('TEE','OLET')) then
    !this.replaceSplitType = false
    !branchMembers = !partRef2.owner.members
    !splitWeldRef  = object DBREF()
    if (!this.breakMode eq 'WELD') then
      if(!this.selectedPartRefs[1].tsfbreak eq true) then
        !answer = !!alert.confirm(|A spool limit is already defined at this location using the 'No weld' option. Do you wish to replace this with a weld?|)
        if (!answer ne 'YES') then
          return true
        else
          !this.replaceSplitType = true
          !this.selectedPartRefs[1].tsfbreak = false
          !this.selectedPartRefs[0].csfbreak = false
          return false
        endif
      else
        return false
      endif
    else
      !savece = !this.selectedPartRefs[1]
      if(!this.modeforSecondCompTCref eq true) then
        !weldPresent = !branchMembers[1]
        handle any
          --if the branch contains no elements
          !weldPresent = OBJECT DBREF()
          !weldPresent = !partRef2.owner
        endhandle
      else
        !weldPresent = !branchMembers[!branchMembers.size()]
      endif
      if(!weldPresent.type eq 'WELD') then
        !answer = !!alert.confirm(|A spool limit is already defined at this location using the 'weld' option. Do you wish to replace this with a No weld?|)
        if (!answer ne 'YES') then
          return true
        else
          !this.replaceSplitType = true
          !splitWeldRef  = !weldPresent
          !pickedTube = false
          if (!splitWeldRef.tGeom) then
            !pickedTube = true
          endif
          if (!splitWeldRef.sequ gt 1) then
            !prevRef = !branchMembers[!splitWeldRef.sequ - 1]
          else
            !prevRef = !splitWeldRef.owner
          endif
          !!ce = !splitWeldRef
          delete WELD
          handle any
            !!ce = !savece
            return true
          endhandle
          if (!prevRef.badref().not()) then
            !partRef2 = il tube of $!prevRef
          endif
        endif
        return false
      endif
    endif
  endif
  return false

endmethod
--/222712
--------------------------------------------------------------------------------
define method .checkExistSplitLimits(!partRef1 is DBREF, !partRef2 is DBREF) is BOOLEAN
  !this.replaceSplitType = false
  -- check whether there is split limit
  if (own of $!partRef1 neq own of $!partRef2) then
    if (!partRef1.hardtype inset ('TEE', 'OLET') and !partRef2.hardtype.eq('TUBI')) then
      !checkPart1 = 'csfbreak'
      !checkPart2 = 'tsfbreak'
    endif
  else
    if (!partRef1.apos.distance(!partRef2.lpos) lt !partRef1.lpos.distance(!partRef2.apos)) then
      !checkPart = 'asfbreak'
    else
      !checkPart = 'lsfbreak'
    endif
  endif
  if (!this.breakMode eq 'WELD') then
    !existSpoolLimit = !partRef1.$!<checkPart>
    handle any
      !existSpoolLimit = false
    endhandle

    if (!existSpoolLimit.not()) then
      return false
    endif

    !answer = !!alert.confirm(|A spool limit is already defined at this location using the 'No weld' option. Do you wish to replace this with a weld?|)
    if (!answer ne 'YES') then
      return true
    endif

    if (!partRef1.asfbreak) then
      !partRef1.asfbreak = false
    elseif (!partRef1.lsfbreak) then
      !partRef1.lsfbreak = false
    elseif (!partRef2.asfbreak) then
      !partRef2.asfbreak = false
    elseif (!partRef2.lsfbreak) then
      !partRef2.lsfbreak = false
    endif
    !this.replaceSplitType = true
  else
    if(own of $!partRef1 neq own of $!partRef2) then
      -- check spool limit exists or not for (OLET or TEE) / BRANCH Connection
      if (!partRef1.hardtype inset ('TEE','OLET') and !partRef1.csfbreak eq TRUE ) then
        if(!partRef2.owner.tsfbreak eq TRUE) then
          -- spool limit exists
          return false
        endif
      endif
    else
      !branchMembers = !partRef1.owner.members
      !fromIndex     = !partRef1.sequ
      !toIndex       = !partRef2.sequ

      if (!fromIndex gt !toIndex) then
        !temp      = !fromIndex
        !fromIndex = !toIndex
        !toIndex   = !temp
      endif

      if (!fromIndex gt !toIndex) then
        !step = -1
      else
        !step = 1
      endif

      !splitWeldRef  = object DBREF()
      !splitEntryRef = object DBREF()
      do !i from !fromIndex to !toIndex by $!step
        !entry = !branchMembers[!i]
        handle any
        endhandle

        !existSpoolLimit = !entry.asfbreak or !entry.lsfbreak or !entry.csfbreak
        handle any
          !existSpoolLimit = false
        endhandle

        if (!existSpoolLimit) then
          !splitEntryRef = !entry
        endif

        if (!entry.hardtype eq 'WELD' and !entry.shop.not()) then
          !splitWeldRef  = !entry
        endif
      enddo

      if (!splitWeldRef.badref()) then
        return false
      endif

      !existSplitWeld = !partRef1.lpos.distance(!splitWeldRef.apos) lt 0.002 or !partRef1.apos.distance(!splitWeldRef.lpos) lt 0.002
      if (!existSplitWeld.not()) then
        return false
      endif

      !answer = !!alert.confirm(|A spool limit is already defined at this location using a weld. Do you wish to replace this using the 'No weld' option?|)
      if (!answer ne 'YES') then
        return true
      endif

      !pickedTube = false
      if (!splitWeldRef.tGeom) then
        !pickedTube = true
      endif

      if (!partRef2.hardtype eq 'TUBI') then
        if (!splitWeldRef.sequ gt 1) then
          !prevRef = !branchMembers[!splitWeldRef.sequ - 1]
        else
          !prevRef = !splitWeldRef.owner
        endif
      else
        !prevRef = object DBREF()
      endif

      !saveCe = !!ce

      if (!splitEntryRef.badref().not()) then
        !splitEntryRef.$!checkPart = false
      endif

      --    if (!splitEntryRef.badref().not()) then
      --      if (!splitEntryRef.asfbreak) then
      --        !splitEntryRef.asfbreak = false
      --      else
      --        !splitEntryRef.lsfbreak = false
      --      endif
      --    endif

      if (!existSplitWeld.not()) then
        return false
      endif

      !!ce = !splitWeldRef
      delete WELD
      handle any
        !!alert.error(!!error.text)
        return true
      endhandle

      if (!prevRef.badref().not()) then
        !partRef2 = il tube of $!prevRef
      endif

      !!ce = !saveCe
      handle any
      endhandle

      !this.replaceSplitType = true
    endif
  endif

  return false
endmethod


--------------------------------------------------------------------------------
--
-- Method:      setMachineInsertionDirection
--
-- Description:
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .setMachineInsertionDirection()
  !this.toCheckActiveFunctionality('PF - Machine Insertion Direction')
  if(!this.result) then
    !this.quitEDG()
    !!fmSys.loadForm('pfMachineInsertionDirection').setInsertionDirection()
  endif
  !this.result = true
endmethod

