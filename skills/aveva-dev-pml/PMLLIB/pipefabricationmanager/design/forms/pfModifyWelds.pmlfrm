--
--  Description:     modify weld attributes
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   modify weld attributes
--  close()                          -                   close this form
--  initialise()                     -
--  pfModifyWelds()                  -                   constructor
--  track()                          -                   To track current element
--
------------------------------------------------------------------------
--- form definition
setup form !!pfModifyWelds
  !this.initcall  = |!this.initialise()|
  !this.formTitle = 'Modify Welds'
  track 'DESICE'    call '!this.track()'

  frame .frameModifyAtt '' at x0 y0

     para   .currentSpec  anchor t+l at x1 text 'CurrentSpec: ' width 18
     path down
        frame .sourceFrame 'Modify Welds From' anchor l+r+t width 20
          rtoggle .fromSpec   tagwidth 8  'Spec.'
          path right
          rtoggle .fromConfig tagwidth 8  'Config.'
        exit
    path down
    option .weldingType  'Weld Type'  tagwidth 8 at x1 width 10

    path down
    option .machType  'Fab. Type'   tagwidth 8 at x1 call || width 10
    path down
    button .btnApply1    'Apply'    at x0 call |!this.apply()|
    button .btnDismiss1  'Cancel'  at xmax form-size ymin  call |!this.close()|

  exit

  member .weldList is ARRAY
  member .ownerForm is FORM
  member .weldControl         is PFWELDCONTROL
  member .pipeWeldGapData     is ARRAY
  member .weldTypefrommainform is STRING
  member .currspec is STRING
  member .errorList           is ARRAY

  exit

------------------------------------------------------------------------
--
-- Method:      pfModifyWelds
-- Description: constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pfModifyWelds()
--  !this.shopType.dText = split('TRUE,FALSE',',')
--  !this.shopType.rText = split('TRUE,FALSE',',')
  !this.machType.dText = split('Manual,Machine,Orbital',',')
  !this.machType.rText = split('MANU,MACH,ORBI',',')
   !this.track()
endmethod
-- End of method

define method .initialise()

    !this.weldingType.dText = split('SHOP,FIELD,SITE',',')
    !this.weldingType.active = true

    if (!this.weldTypefrommainform eq 'SHOP') then
        !this.weldingType.val = 1
    elseif (!this.weldTypefrommainform eq 'FIELD') then
        !this.weldingType.val = 2
    elseif (!this.weldTypefrommainform eq 'SITE') then
        !this.weldingType.val  = 3
    endif

    !this.currentSpec.val = 'CurrentSpec: ' & !this.currspec
    if(!this.currspec eq 'WELDGAP') then
      !this.fromConfig.val = true
    else
      !this.fromSpec.val = true
    endif
endmethod

------------------------------------------------------------------------
--
-- Method:      track
-- Description: To Track Current Element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .track()

  if (!!ce.type.eq('WELD')) then
    !this.machType.val = !this.machType.rtext.findFirst(!!ce.WeldType)
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      apply
-- Description: apply
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()

  !newstype = ''
  !machType = !this.machType.rText[!this.machType.val]
  !weldType = !this.weldingType.rText[!this.weldingType.val]
  if (!weldType eq 'SHOP') then
    !shop = 'true'
  else
    !shop = 'false'
  endif
  !this.hide()

  !this.ownerForm.changeAttributes(!this.weldList, !shop, !machType, !this.fromSpec.val ,!weldType)
  UNMARK ALL
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      close
-- Description: close
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()
  !this.hide()
  UNMARK ALL
endmethod
