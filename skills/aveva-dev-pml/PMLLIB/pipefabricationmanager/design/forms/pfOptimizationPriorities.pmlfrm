--   Type:          Form Definition
--   Group:         Pipe Fabrication
--     Keyword:     PF
--   Module:        Design
--   Replaces:
--
-- Author:          DoHyoung Kim (Bright)
-- Created:         Tuesday 6th December 2012
--
-- Description:     Form for pipe fabrication optimization priorities
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   apply modified priorities
--  moveSelectedCriteriaDown()       -                   move the selected item down
--  moveSelectedCriteriaUp()         -                   move the selected item up
--  onInitialize()                   -                   initialize form
--  pfOptimizationPriorities()       -                   constructor
--  refreshPriorities(ARRAY)         -                   refresh the priority list
--
--------------------------------------------------------------------------------
-- Define form
setup form !!pfOptimizationPriorities dialog

  using namespace 'Aveva.Pdms.Presentation'

  !this.formTitle  = 'Optimization Priorities'
  !this.initcall   = |!this.onInitialize()|

  !upArrowIcon   = !!pml.getPathName('uparrow16.png')
  !downArrowIcon = !!pml.getPathName('downarrow16.png')

  path down
  frame .frmPriority 'Optimization Priorities'
    list   .lstPriority anchor t+l+r callback '' tooltip '' width 49 height 8
    button .btnMovePriorityUp   'Up'   pixmap /$!upArrowIcon   width 16 height 16 at xmax.lstPriority + 0.2 ymin.lstPriority anchor t+l callback '!this.moveSelectedCriteriaUp()' tooltip 'Move selected criteria up'
    button .btnMovePriorityDown 'Down' pixmap /$!downArrowIcon width 16 height 16 at xmax.lstPriority + 0.2 ymax.btnMovePriorityUp + 0.2 anchor t+l callback '!this.moveSelectedCriteriaDown()' tooltip 'Move selected criteria down'
  exit

  button .btnApply  'Apply'  at xmax.frmPriority-size callback '!this.apply()' width 10
  path left
  button .btnCancel 'Cancel' width 10 CANCEL
  button .btnOK     'OK'     callback '!this.apply()'  width 10 OK


  member .descriptions    is ARRAY

  member .criteria        is ARRAY

  member .undo            is UNDOABLE

exit

--------------------------------------------------------------------------------
--
-- Method:      pfOptimizationPriorities
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfOptimizationPriorities()

  -- Fix for Issue 94897 (SI-56401), wording changed
  !this.descriptions[1] = 'Maximize pre-welded flanges'
  !this.descriptions[2] = 'Minimize cut length'
  !this.descriptions[3] = 'Minimize pipe overhang'
  !this.descriptions[4] = 'Single, pre-welded flanges not clutched'
  !this.descriptions[5] = 'Maximize machine extrusions'

  !this.criteria[1] = 'MAX_PREWELD_FLANGE'
  !this.criteria[2] = 'MIN_SAW_LEN'
  !this.criteria[3] = 'MIN_LEN_OUT_MACH'
  !this.criteria[4] = 'PUT_FLANGE_OUT'
  !this.criteria[5] = 'MAX_MACH_EXTRUSION'

  !headings = object ARRAY()
  !headings[1] = 'Priority'
  !headings[2] = 'Criteria'
  !this.lstPriority.setHeadings(!headings)

endmethod

--------------------------------------------------------------------------------
--
-- Method:      refreshPriorities
--
-- Description: refresh the priority list with the given order
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array of priority
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .refreshPriorities(!priorities is ARRAY)

  !rows  = object ARRAY()
  do !i indices !priorities
    !row = object ARRAY()
    !row[1] = !i.string()

    !index = !this.criteria.findFirst(!priorities[!i])
    !row[2] = !this.descriptions[!index]
    !rows.append(!row)
  enddo

  !this.lstPriority.setRows(!rows)
  !this.lstPriority.rtext = !priorities

  -- enable/disable modification
  !this.frmPriority.active = !!pfContext.editable
  !this.btnApply.active = false
  !this.btnOK.active = false

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onInitialize
--
-- Description: initialize form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onInitialize()

  -- Fix Issue 98926 (SI#58186) 12.1.SP4#DVD RC5 - PF - Config Admin Errors
  !appldwRefs = !!collectAllFor('APPLDW', |FUNC EQ 'PipeFabrication'|, WORLD)
  if !appldwRefs.empty() then
    return error 1 |No APPLDW defined for Pipe Fabrication. Please create one with FUNC = 'PipeFabrication'|
  endif
  -- End of Fix Issue 98926

  if defined(!!pfContext) then
    !!pfContext.delete()
  endif

  !context = object PFCONTEXT()
  !context.globalInstance()

  !this.refreshPriorities(!!pfContext.optimizationPriorities)
  !this.lstPriority.val = 1

endmethod

--------------------------------------------------------------------------------
--
-- Method:      moveSelectedCriteriaUp
--
-- Description: move the selected item up
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .moveSelectedCriteriaUp()

  if !this.lstPriority.val.lt(2) then
    return
  endif

  !index = !this.lstPriority.val
  !rtext = !this.lstPriority.rtext

  !previous = !rtext[!index - 1]
  !rtext[!index - 1] = !rtext[!index]
  !rtext[!index] = !previous

  !this.refreshPriorities(!rtext)
  !this.lstPriority.val = !index - 1
  !this.lstPriority.setFocus()

  !this.btnApply.active = !!pfContext.editable
  !this.btnOK.active = !!pfContext.editable

endmethod

--------------------------------------------------------------------------------
--
-- Method:      moveSelectedCriteriaDown
--
-- Description: move the selected item down
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .moveSelectedCriteriaDown()
  if !this.lstPriority.val.gt(!this.lstPriority.count - 1) then
    return
  endif

  !index = !this.lstPriority.val
  !rtext = !this.lstPriority.rtext

  !next = !rtext[!index + 1]
  !rtext[!index + 1] = !rtext[!index]
  !rtext[!index] = !next

  !this.refreshPriorities(!rtext)
  !this.lstPriority.val = !index + 1
  !this.lstPriority.setFocus()

  !this.btnApply.active = !!pfContext.editable
  !this.btnOK.active = !!pfContext.editable

endmethod


--------------------------------------------------------------------------------
--
-- Method:      apply
--
-- Description: apply the priorities
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .apply()
  !rtext = !this.lstPriority.rtext
  !!pfContext.optimizationPriorities = !rtext

  !this.undo.description('PF - Save Optimization Priorities')
  !this.undo.add()
  !!pfContext.saveDefaults()
  handle ANY
    !!alert.error(!!error.text)
  elsehandle NONE

    !this.btnApply.active = false
    !this.btnOK.active = false

  endhandle

  !this.undo.endUndoable()
endmethod
