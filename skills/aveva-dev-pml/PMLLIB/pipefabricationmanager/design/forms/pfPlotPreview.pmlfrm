------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  displayMessage()                 -                   display message
--  pfPlotPreview()                  -                   constructor
--  print(STRING)                    -                   print
--  selectSheet()                    -
--  showPlot(STRING)                 -                   show plot
--
---------------------------------------------------------------------
-- define form
--- form definition
import 'PMLNetUtilities'
handle any
endhandle

setup form !!pfPlotPreview dialog dock right varchars
  !this.formTitle     = 'Isometric Drawing'

  -- define popup
  menu .viewPopup
    add |Background Colour...| |!!colourSelectLoad('!!pfPlotPreview.plot.background = !!colourSelectGet()', 'Background Colour', !!pfPlotPreview.plot.background)|
  exit

  -- Icon size from the common control
  !iconSize = !!comSysOpt.iconSize()

  -- Messages...
--  button .isomessages at x0 y0 tooltip 'Messages...' pixmap width $!iconSize height $!iconSize callback |!this.displayMessage()|
  -- Print...
  button .isoprintSetUp at x0 y0 tooltip 'Print Setup...' pixmap width $!iconSize height $!iconSize callback |!!comPltBatchPrint('SETUP',object ARRAY())|
  button .isoprint    at xmax tooltip 'Print' pixmap width $!iconSize height $!iconSize callback |!this.print('PRINT')|

  option .sheets 'Sheets' at xmax+1 ymin call |!this.selectSheet()| width 40

  -- define plot view
  view .plot at x0 y1 plot
    height 14
    borders on
  exit

  frame .drawingViewFrame panel anchor all at x0 y1 width 70 height 15
    container .netImageViewerFrame PMLNetCONTROL 'NET' dock fill
  exit

  member .plotFilePath is STRING
  member .messageFile  is STRING

  using namespace 'Aveva.Pdms.PMLNet'
  member .imageViewer    is PMLIMAGEVIEWERCONTROL
exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      pfPlotPreview
-- Description: constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pfPlotPreview()
  !this.plot.setPopup(!this.viewPopup)
  !this.plot.background = 'black'

  !iconSize = !!comSysOpt.iconSize()

  -- Add pixmap to buttons
--  !this.isomessages.addPixmap(!!pml.getPathName('reports' & !iconSize & '.png'))
  !this.isoprintSetUp.addPixmap(!!pml.getPathName('printsetup' & !iconSize & '.png'))
  !this.isoprint.addPixmap(!!pml.getPathName('print' & !iconSize & '.png'))

  using namespace 'Aveva.Pdms.PMLNet'
  !this.imageViewer = object PMLIMAGEVIEWERCONTROL()
  !this.netImageViewerFrame.control = !this.imageViewer.handle()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showPlot
--
-- Description: show plot file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     plot file path
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showPlot(!plotFile is STRING)
  !this.drawingViewFrame.visible = false
  !this.plot.visible = true
  !imageViewFlag = false

  !isTiffFormat = !plotFile.upcase().occurs('.TIFF') gt 0

  if (!isTiffFormat) then
    !tempFile = object FILE(!plotFile)
    if (!tempFile.exists()) then
      !imageViewFlag = true
    else
      !plotFile = |%pdmsdflts%\pipeSketch\noPiece.plt|
    endif
  endif

  if (!imageViewFlag) then
    !this.plot.visible = false
    !this.drawingViewFrame.visible = true
    !this.imageViewer.showImage(!plotFile)
    handle any
      !this.imageViewer.clearImage()
    endhandle
  else
    !this.plot.clear()
    !this.plot.add(!plotFile)
    handle any
    endhandle
  endif

--  if (!plotFile.substring(2,1) eq '%') then
--    !this.plotFilePath = !plotFile.substring(2)
--  endif

--  !this.plotFilePath = !plotFile.replace(|/|,|\|).substring(2)
  !this.plotFilePath = !plotFile.replace(|/|,|\|)

--  !this.plot.SETHighlight(1)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      displayMessage
-- Description: display message
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayMessage()
  -- Read messages
  !messFile = !this.messageFile
  !messageFileObject = object FILE(!this.messageFile)
  if( not !messageFileObject.exists() ) then
    !!alert.error(|Cannot find message file | + !messFile)
  else
    -- load messages form
    if( not defined(!!isdPreviewMessages)) then
      pml load form !!isdPreviewMessages
    endif
    !array       = !messageFileObject.readFile()
    !!isdPreviewMessages.message.dText = !array
    !!isdPreviewMessages.show()
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      print
-- Description: print
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      task
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .print(!task is STRING)
  if (!task eq 'PRINT') then
    -- plot with selected supports

    !plotFile = object FILE(!this.plotFilePath)
    handle any
      !!alert.error(!!error.text)
      return
    endhandle

    if (!plotFile.exists().not()) then
      !!alert.message('Plot File does not exist : ' & !this.plotFilePath)
      return
    endif

    !plotFileList[1] = !plotFile.fullname()

    !!comPltBatchPrint('PLOT',!plotFileList)
  endif
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      selectSheet
-- Description: select sheet
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectSheet()
  if (!this.sheets.dText.unset()) then
    return
  endif

  !selectedDrawingPath = !this.sheets.rText[!this.sheets.val]
  !this.showPlot(!selectedDrawingPath)

endmethod
