------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addPipesTo3DView()               -                   add selected pipes to 3D view
--  addSpoolsTo3DView()              -                   add selected spools to 3D view
--  enhanceSpool(DBREF)              -                   highlight the given element
--  export()                         -                   export spool data as excel file
--  initialize()                     -                   initialize form
--  navigateToPipeSpool()            -                   navigate the selected pipe in design hierarchy
--  onGridSpoolsAfterSelectChange(ARRAY) -                   callback when the grid row selection is changed
--  onGridSpoolsBeforeCellUpdate(ARRAY) -                   update spool
--  pfSpoolAttributes()              -                   constructor
--  refresh()                        -                   refresh the spool grid
--  removePipesFrom3DView()          -                   remove selected pipes from 3D view
--  removeSpoolsFrom3DView()         -                   remove selected spools from 3D view
--  showPopupMenu(ARRAY)             -                   show grid popup menu
--  toggleHighlightSpool()           -                   highlight the selected spool
--  zoomToPipeSpool()                -                   zoom to the selected spool
--
--------------------------------------------------------------------------------
import 'GridControl'
handle ANY
endhandle

import 'PMLFileBrowser'
handle ANY
endhandle

-- Define form
setup form !!pfSpoolAttributes dialog dock

  using namespace 'Aveva.Pdms.Presentation'

  !this.formTitle  = 'Spool Attributes'
  !this.initcall   = '!this.initialize()'

  path right
  button .btnRefresh   'CE'     anchor l+t callback '!this.refresh()'
  button .btnExport    'Export' anchor l+t callback '!this.export()'
  toggle .togHighlight 'Highlight when selected' anchor l+t callback '!this.toggleHighlightSpool()'

  path down
  container .netControlSpools PMLNETCONTROL 'Spools' anchor all at xmin.btnRefresh width 100 height 10

  member .gridSpools  is NETGRIDCONTROL

  member .columns     is ARRAY

exit

--------------------------------------------------------------------------------
--
-- Method:      pfSpoolAttributes
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfSpoolAttributes()

  -- initialise grid controls
  using namespace 'Aveva.Pdms.Presentation'
  !this.gridSpools  = object NETGRIDCONTROL()
  !this.netControlSpools.control = !this.gridSpools.handle()
  !this.gridSpools.editableGrid(true)
  !this.gridSpools.autofitcolumns()
  !this.gridSpools.fixedHeaders(true)
  --!this.gridSpools.readOnlyCellColor('red')
  !this.gridSpools.bulkEditableGrid(true)
  --!this.gridSpools.addEventHandler('AfterCellUpdate', !this, 'onSeatDataAfterCellUpdate')
  !this.gridSpools.addEventHandler('AfterSelectChange', !this, 'onGridSpoolsAfterSelectChange')
  !this.gridSpools.addEventHandler('BeforeCellUpdate', !this, 'onGridSpoolsBeforeCellUpdate')

  -- popup menu
  !this.newMenu('popupMenu')
  !this.popupMenu.add('CALLBACK', 'Select All', '!this.gridSpools.selectAllRows()')
  !this.popupMenu.add('SEPARATOR')
  !this.popupMenu.add('CALLBACK', 'Add Pipes to 3D View', '!this.addPipesTo3DView()')
  !this.popupMenu.add('CALLBACK', 'Add Spools to 3D View', '!this.addSpoolsTo3DView()')
  !this.popupMenu.add('CALLBACK', 'Remove Pipes from 3D View', '!this.removePipesFrom3DView()')
  !this.popupMenu.add('CALLBACK', 'Remove Spools from 3D View', '!this.removeSpoolsFrom3DView()')
  !this.popupMenu.add('SEPARATOR')
  !this.popupMenu.add('CALLBACK', 'Zoom To', '!this.zoomToPipeSpool()')
  !this.popupMenu.add('CALLBACK', 'Navigate To', '!this.navigateToPipeSpool()')
  !this.popupMenu.add('SEPARATOR')
  !this.popupMenu.add('CALLBACK', 'Save to Excel', '!this.export()')

  !this.gridSpools.addEventHandler('OnPopup', !this, 'showPopupMenu')

endmethod

--------------------------------------------------------------------------------
--
-- Method:      showPopupMenu
--
-- Description: shows a context menu for the spool grid
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .showPopupMenu(!data is ARRAY)
  if !data.unset() then
    return
  endif

  !this.netControlSpools.popup = !this.popupMenu
  !this.netControlSpools.showPopup(!data[0], !data[1])
endmethod


--------------------------------------------------------------------------------
--
-- Method:      initialize
--
-- Description: initialize form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .initialize()
  !this.refresh()
endmethod

--------------------------------------------------------------------------------
--
-- Method:      refresh
--
-- Description: refresh the spool grid
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .refresh()

  !this.columns = !!pfGetColumnsForSpool()

  !scopeRef = PIPE OF CE
  handle (2, 111)
    -- Cannot access element type PIPE from the level of ~~
    !scopeRef = !!ce
  endhandle

  !pspoolRefs = !!collectAllFor('PSPOOL', '', !scopeRef)

  !spoolNames = object ARRAY()
  do !pspoolRef values !pspoolRefs
    !spoolNames.append(!pspoolRef.name)
  enddo

  using namespace  'Aveva.Pdms.Presentation'
  !dataSource = object NETDATASOURCE('Spools', !this.columns[1], !this.columns[2], !spoolNames)
  !this.gridSpools.bindToDataSource(!dataSource)

  do !i indices !this.columns[3]
    !value = !this.columns[3][!i]
    if !value.set() then
      !objectType = !value.objectType()
      if !objectType.eq('ARRAY') AND !value.empty().not() then
        !this.gridSpools.createValueList(!this.columns[1][!i], !value)
        !this.gridSpools.assignValueListToColumn(!this.columns[1][!i], !i)
      elseif !objectType.eq('STRING') AND !value.substring(1, 2).eq('!!') then
        !block = object BLOCK(!value)
        !result = !block.evaluate()
        if !result.objectType().eq('ARRAY') then
          !this.gridSpools.createValueList(!this.columns[1][!i], !result)
          !this.gridSpools.assignValueListToColumn(!this.columns[1][!i], !i)
        endif
      endif
    endif
    !value.delete()
  enddo

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onGridSpoolsBeforeCellUpdate
--
-- Description: update the spool with the modified cell value
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onGridSpoolsBeforeCellUpdate(!args is ARRAY)
  !this.gridSpools.doDabaconCellUpdate(!args)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      export
--
-- Description: export spool data as excel file
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .export()

  using namespace 'Aveva.Pdms.Presentation'

  !fileBrowser = object PMLFILEBROWSER('SAVE')
  !fileBrowser.show('C:\\', 'report.xls', 'Save as', false, 'Excel files (*.xls)|*.xls|All files (*.*)|*.*', 1)
  !fileName = !fileBrowser.file()
  if (!fileName neq '') then
    !this.gridSpools.saveGridToExcel(!fileName)
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      addPipesTo3DView
--
-- Description: add selected pipes to 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .addPipesTo3DView()
  !pipeRefs = object ARRAY()
  !rowTags = !this.gridSpools.getSelectedRowTags()
  do !rowTag values !rowTags
    !pspoolRef = !rowTag.dbref()
    handle ANY
      !!alert.error(!!error.text)
    elsehandle NONE
      !pipeRefs.append(!pspoolRef.owner.owner)
    endhandle
  enddo

  do !pipeRef values !pipeRefs
    ADD $!pipeRef
  enddo
endmethod

--------------------------------------------------------------------------------
--
-- Method:      addSpoolsTo3DView
--
-- Description: add selected spools to 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .addSpoolsTo3DView()
  !rowTags = !this.gridSpools.getSelectedRowTags()
  do !rowTag values !rowTags
    !pspoolRef = !rowTag.dbref()
    handle ANY
      !!alert.error(!!error.text)
    elsehandle NONE
      ADD $!pspoolRef
    endhandle
  enddo
endmethod

--------------------------------------------------------------------------------
--
-- Method:      removePipesFrom3DView
--
-- Description: remove selected pipes from 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .removePipesFrom3DView()

  !pipeRefs = object ARRAY()
  !rowTags = !this.gridSpools.getSelectedRowTags()
  do !rowTag values !rowTags
    !pspoolRef = !rowTag.dbref()
    handle ANY
      !!alert.error(!!error.text)
    elsehandle NONE
      !pipeRefs.append(!pspoolRef.owner.owner)
    endhandle
  enddo

  do !pipeRef values !pipeRefs
    REMOVE $!pipeRef
  enddo
endmethod

--------------------------------------------------------------------------------
--
-- Method:      removeSpoolsFrom3DView
--
-- Description: remove selected spools from 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .removeSpoolsFrom3DView()

  !rowTags = !this.gridSpools.getSelectedRowTags()
  do !rowTag values !rowTags
    !pspoolRef = !rowTag.dbref()
    handle ANY
      !!alert.error(!!error.text)
