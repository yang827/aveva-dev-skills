--------------------------------------------------------------------------------
--
-- Method:      navigateToPipeSpool
--
-- Description: navigate the current pipe in the design hierarchy
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .navigateToPipeSpool()
  !rowTags = !this.gridSpools.getSelectedRowTags()
  if !rowTags.empty().not() then
    !pspoolRef = !rowTags.first().dbref()
    handle ANY
      !!alert.error(!!error.text)
    elsehandle NONE
      !!ce = !pspoolRef
    endhandle
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      zoomToPipeSpool
--
-- Description: zoom to the selected spool in the 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .zoomToPipeSpool()
  !rowTags = !this.gridSpools.getSelectedRowTags()
  if !rowTags.empty() then
    return
  endif

  !pspoolRef = !rowTags.first().dbref()
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  !volume = object VOLUME(!pspoolRef)
  !from = !volume.from
  !to = !volume.to

  if !from.unset() OR !to.unset() then
    !!alert.error(!pspoolRef.name + ' has no volume!')
    return
  endif

  !throughPoint = !from.midPoint(!to).wrt( /* )

  !throughPointXYZ = object ARRAY()
  !throughPointXYZ[1] = !!comConvertUnknownValue(!throughPoint.east, 'MM')
  !throughPointXYZ[2] = !!comConvertUnknownValue(!throughPoint.north, 'MM')
  !throughPointXYZ[3] = !!comConvertUnknownValue(!throughPoint.up, 'MM')

  !!fmSys.currentDocument().view.through = !throughPointXYZ

  !radius = !!comConvertUnknownValue(!from.distance(!to), 'MM') / 2 * 1.25
  !!fmSys.currentDocument().view.radius = !radius

endmethod

--------------------------------------------------------------------------------
--
-- Method:      onGridSpoolsAfterSelectChange
--
-- Description: highlight the selected spool
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--    1   R      ARRAY               grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .onGridSpoolsAfterSelectChange(!args is ARRAY)

  UNENHANCE ALL
  if UNDEFINED(!args[0]) OR !args[0].empty() then
    return
  endif

  !pspoolRef = !args[0][1].dbref()
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  if !this.togHighlight.val then
    !this.enhanceSpool(!pspoolRef)
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      toggleHighlightSpool
--
-- Description: highlight the selected spool
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--    1   R      ARRAY               grid event data
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .toggleHighlightSpool()
  !rowTags = !this.gridSpools.getSelectedRowTags()
  if !rowTags.empty() then
    return
  endif

  !pspoolRef = !rowTags.last().dbref()
  handle ANY
    !!alert.error(!!error.text)
    return
  endhandle

  !this.enhanceSpool(!pspoolRef)

endmethod

--------------------------------------------------------------------------------
--
-- Method:      enhanceSpool
--
-- Description: highlight the given spool
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]         [Description]
--    1   R      DBREF               spool element
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .enhanceSpool(!pspoolRef is DBREF)

  do !i indices !pspoolRef.psarfa

    !arriveRef = !pspoolRef.psarfa[!i]
    !leaveRef = !pspoolRef.pslrfa[!i]

    if !arriveRef.type.eq('BRAN') then
      !branRef = !arriveRef
    else
      !branRef = !arriveRef.owner
    endif
    !memberRefs = !!collectAllFor('BRAN MEM', '', !branRef)

    !startIndex = !memberRefs.findFirst(!arriveRef)
    if !startIndex.unset() then
      !startIndex = 1
    else
      !startIndex = !startIndex + 1
    endif

    !endIndex = !memberRefs.findFirst(!leaveRef)
    if !endIndex.unset() then
      !endIndex = !memberRefs.size()
    else
      !endIndex = !endIndex - 1
    endif

    do !j from !startIndex to !endIndex
      !partRef = !memberRefs[!j]
      ENHANCE $!partRef COLOUR $!!<gphColOpt.highlight>
    enddo
  enddo

endmethod
