--
--  Description:     display thread end types
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   create thread data on a component
--
------------------------------------------------------------------------

--- form definition
setup form !!pfThreadEndTypes block
  !this.formTitle  = 'Thread Types'

  option .threadTypes 'Thread Type' tagwidth 10 width 19

  path down

  button .btnApply    'Apply'   at x0 call |!this.apply()|
  button .btnDismiss  'Cancel'  at xmax form-size ymin  CANCEL

  member .isHeadPart        is BOOLEAN
  member .branchRef         is DBREF
  member .sourceTubeRef     is DBREF
  member .slantedEndObject  is PFFABRICATIONPIPEENDCONTROL
  member .ownerForm         is FORM
exit
-- End of method

------------------------------------------------------------------------
--
-- Method:      apply
-- Description: create thread data on a component
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY
--
------------------------------------------------------------------------
define method .apply()
  !this.hide()

  --!threadInfo = !this.threadType.displayText()
  !threadInfo = !this.threadTypes.rText[!this.threadTypes.val]
  if (!this.threadTypes.displayText().empty()) then
    !connectionType = ' '
    !threadLength   = ' '
  else
    !connectionType = !this.threadTypes.displayText().after('(').before(',')
    !threadLength   = !this.threadTypes.displayText().part(3,',').before(')')
  endif

  !cocdes = !!collectAllFor('COCDES', |coconnection eq '$!<threadInfo>'|, world)
  if (!cocdes.set()) then
    !threadMark = !threadInfo & '@' & !cocdes[1].description & ' ' & !connectionType & ' ' & !threadLength & ' Long'
  else
    !!alert.error(|Cannot find a COCDES which has coconnection as '$!<threadInfo>' from COCO table|)
    return
  endif


  !angle = 999
  !this.slantedEndObject.createPipeEnd(!this.branchRef, !this.sourceTubeRef, !angle, !this.isHeadPart, false, !threadMark, object PLANE(), '', 0)

  !this.ownerForm.orientation.val = '*Orientation : ' & !this.slantedEndObject.orientation

  if (!this.ownerForm.displayPipEnd.val) then
    !this.ownerForm.displayFabPipeEnd()
  else
    aid clear all $!<this.ownerForm.aidNumber>
  endif
endmethod
