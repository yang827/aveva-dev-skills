--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addSourceElement(EDGPICKDATA)    -                   add source element
--  addWeldElement(EDGPICKDATA)      -                   Add weld Elements by graphical pick
--  changeAttributes(ARRAY,STRING,STRING) -                   change attributes
--  changeAttributes(ARRAY,STRING,STRING,BOOLEAN,STRING) -                   change attributes
--  changeItemsOnGrid()              -                   change items on grid
--  changes()                        -                   changes
--  checkCe()                        -                   check ce
--  checkWeldGapTableExist()         BOOLEAN             check whether weld gap table does exist
--  createWeld(BOOLEAN)              -                   create weld
--  createWeldWithPickedElements()   -                   create weld with picked elements
--  deleteWelds(BOOLEAN)             -                   Deletes the welds based on the answer from the form !!pfWeldHandlingDeleteConfirm
--  displayWeldList()                -                   display weld list
--  errorListGridPopupCallback(ARRAY) -                   error list grid popup callback
--  exportImage(STRING)              -                   export image
--  exportWeldList()                 -                   export weld list
--  getCurrentRef()                  DBREF               get current ref
--  getWeldPrefix()                  STRING              get weld prefix
--  gridPopupCallback(ARRAY)         -                   grid popup callback
--  highlightWelds()                 -                   highlight selected welds
--  initialise()                     -                   initialise
--  loadConfigData()                 -
--  markWeldData()                   -                   mark weld data
--  markWeldElement(DBREF)           -                   mark weld element
--  markWelds()                      -                   mark welds
--  navigateElementOn3dView(BOOLEAN) -                   navigate element on 3d view
--  navigateToExplorer(MENU,STRING)  -                   navigate to explorer
--  orderweldlistOnCheck(REAL)       -
--  pfweldhandling()                 -                   constructor
--  pickElement()                    -                   pick element
--  pickWeldElement()                -                   EDG Graphical pick for welds
--  populateErrorList(ARRAY)         -
--  populateGrid(ARRAY)              -                   populate grid
--  removeWelds()                    -                   remove welds
--  removeWelds(BOOLEAN)             -                   remove welds
--  saveToExcel(BOOLEAN)             -                   save to excel
--  selectChange(ARRAY)              -                   select change
--  selectChangeOnErrorList(ARRAY)   -                   select change on error list
--  setCe()                          -                   set ce
--  setExportPath()                  -                   set export path
--  setPopupMenus(BOOLEAN)           -                   set popup menus
--  setWeldType()                    -                   set weld type
--  showModifyWeld()                 -                   To show the pfModifyWelds form
--  showModifyWeldForm(ARRAY)        -
--  tidy()                           -                   tidy
--  track()                          -                   track
--  validateWeldData(ARRAY)          -
--
------------------------------------------------------------------------
import 'GridControl'
handle any
endhandle

import 'PMLNetUtilities'
handle any
endhandle

import 'PDMSCommands'
handle any
endhandle

import 'PMLFileBrowser'
handle any
endhandle

--- form definition
setup form !!pfweldhandling dialog dock right varchars
  !this.formTitle = 'Weld Handling'
  !this.initcall  = |!this.initialise()|
  !this.quitcall  = '!this.tidy()'

  track 'DESICE'    call '!this.track()'

  frame .mainFrame tabset anchor all
    frame .createFrame 'Create/Modify'
      frame .stroageFrame '' anchor l+r+t  width 44
        button .ceButton pixmap 'CE' callback |!this.setCe()| width 16.5 height 16
        para   .ceLabel  anchor t+l+r text '' width 26
      exit

      --  path down
      --  vdist 0.5

      frame .createWeldFrame  foldUp ' Create ' anchor l+r+t at xMin yMax0.2 width 44
        frame .sourceFrame 'Create Welds From' anchor l+r+t width 41
          rtoggle .fromSpec   tagwidth 8  'Spec.'   callback '!this.zeroGap.active = false'
          path right
          rtoggle .fromConfig tagwidth 8  'Config.' callback '!this.zeroGap.active = true'
          toggle .zeroGap 'Zero Gap'
        exit

        path down

        option .fabricationType tagwidth 12 'Fabrication Type'  width 7
        path right
        option .weldingType  ''  width 7

        --button .weldingType  toggle 'SHOP' at xMax1 yMin width 5 callback |!this.setWeldType()|
        path right
        button .createCE anchor   t+r at xmax1  pixmap callback |!this.createWeld(false)| width 16.5 height 16 tooltip 'Create Welds on CE'
        button .createPick anchor t+r at xmax0.5   ymin pixmap callback |!this.createWeld(true)|  width 16.5 height 16 tooltip 'Create Welds by Picking'
        path down
        toggle .upDate 'Append Weld Number' at x0
        path right
        para   .weldPrefixTag  anchor t+l at xmax3 text 'Default Weld Prefix: ' width 20
        path down
      exit

      frame .modifyWeldFrame foldUp ' Modify ' anchor all at xMin yMax0.2 width 43.5 height 7
        button .modifyApply 'Changes...' anchor t+l pixmap callback |!this.changes()| width 16 height 16  tooltip 'Modify Welds'
        path right
        button .refreshList 'Refresh...' anchor t+l pixmap width 16 height 16 callback |!this.displayWeldList()| tooltip 'Refresh Weld List'
        path right
        button .removeWelds anchor t+r  pixmap at xmax.modifyWeldFrame - 5 callback |!this.removeWelds(true)|  width 16.5 height 16 tooltip 'Remove All Welds'
        path right
        button .removePartialWelds anchor t+r  pixmap at xmax.removeWelds + 0.5  callback |!this.removeWelds(false)| width 16 height 16 tooltip 'Remove Selected Welds'
        path down
        using namespace 'Aveva.Pdms.Presentation'
        container .gridContainer PMLNetControl anchor all at x0    'weldList' width 42 height 10
        path down
        button .exportResult linkl 'Export Weld List...' anchor b+l  callback |!this.saveToExcel(true)| tooltip 'Export Weld List...'
        toggle .navigage 'Zoom when selected' anchor l+b at x0 callback |!this.navigateElementOn3dView(true)|
        path right
        toggle .markWeldInfo 'Mark Weld Info.'  anchor r+b at xmax12 callback |!this.markWeldData()|
        path down
        toggle .highlightConnections 'Highlight Elements' anchor l+b at x0 callback |!this.highlightWelds()|
      exit
    exit

    frame .errorListFrame 'Error List'
      container .errorListContainer PMLNetControl anchor all at x0 y0   'errorList' width 42
      toggle .navigageOnErrorList 'Navigate on 3D view' anchor l+b at x0 callback |!this.navigateElementOn3dView(false)|
    exit
  exit

  member .pickedElements    is ARRAY

  using namespace 'Aveva.Pdms.Presentation'
  member .weldControl       is PFWELDCONTROL
  member .dataGrid          is NETGRIDCONTROL
  member .weldListGrid      is NETGRIDCONTROL
  member .errorListGrid     is NETGRIDCONTROL

  member .dataGridHeadings  is ARRAY
  member .weldListHeadings  is ARRAY
  member .errorListHeading  is ARRAY

  member .aidNumber         is REAL
  member .aidNumberForSetOnTee is REAL
  member .sTypes            is ARRAY

  member .weldData          is ARRAY
  member .distanceData      is ARRAY
  member .weldsToModify     is ARRAY

  member .weldcount is REAL
  member .nweldsaddedusingweldhandlingform is REAL

exit

------------------------------------------------------------------------
--
-- Method:      pfweldhandling
-- Description: constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pfweldhandling()
  !this.fabricationType.dText = split('Manual,Machine,Orbital',',')
  !this.fabricationType.rText = split('MANU,MACH,ORBI',',')

  !this.createCE.addPixmap(!!pml.getPathName('group16.png'))
  !this.createPick.addPixmap(!!pml.getPathName('pickpos16.png'))
  !this.ceButton.addPixmap(!!pml.getPathName('ce16.png'))
  --  !this.exportFileBrowser.addPixmap(!!pml.getPathName('openbrowser.png'))
  !this.removeWelds.addPixmap(!!pml.getPathName('alldelete16.png'))
  !this.removePartialWelds.addPixmap(!!pml.getPathName('multidelete16.png'))
  !this.modifyApply.addPixmap(!!pml.getPathName('updateidlist16.png'))
  !this.refreshList.addPixmap(!!pml.getPathName('refresh16.png'))

  !this.fromSpec.val = true
  !this.zeroGap.active = false
  !this.upDate.val = true

  using namespace 'Aveva.Pdms.Presentation'

  !this.dataGrid            = object NETGRIDCONTROL()
  !this.gridContainer.control = !this.dataGrid.handle()

  !this.dataGrid.outlookGroupStyle(false)

  !this.dataGridHeadings = split('Name,Weld Type,Fab. Type, Spool Limit,Number',',')

  !this.dataGrid.addEventHandler('afterSelectChange', !this, 'selectChange')
  !this.dataGrid.addEventHandler('OnPopup',           !this, 'gridPopupCallback')
  !this.setPopupMenus(true)

  !this.weldListGrid = object NETGRIDCONTROL()

  !this.weldListHeadings = split('Name,Bore,Shop,Weld Type,Wall Thickness,Circumference,Weld Gap,Material',',')
  --  !this.exportPath.val = !!evarSplit('PDMSUSER')[1]

  !this.aidNumber = !!aidNumbers.add('weldHandling')
  !this.aidNumberForSetOnTee = !!aidNumbers.add('weldHandlingForSetOnTee')

  !this.weldingType.dText = split('SHOP,FIELD,SITE',',')
  --  !this.weldingType.rText = split('SWN,FWN,FWS',',')

  !this.errorListGrid = object NETGRIDCONTROL()
  !this.errorListContainer.control = !this.errorListGrid.handle()
  !this.errorListGrid.outlookGroupStyle(false)

  !this.errorListGrid.addEventHandler('afterSelectChange', !this, 'selectChangeOnErrorList')
  !this.errorListGrid.addEventHandler('OnPopup',           !this, 'errorListGridPopupCallback')
  !this.setPopupMenus(false)

  !this.errorListHeading = split('Name,Description', ',')

  !this.weldcount = 0
  !this.nweldsaddedusingweldhandlingform = 0

  if (undefined(!!pfweldgapconfig)) then
    pml load form !!pfweldgapconfig
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setExportPath
-- Description: set export path
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setExportPath()
  --  !this.weldingType.tag        = 'SHOP'
  --  !this.weldingType.background = 'YELLOW'

  using namespace 'Aveva.Pdms.Presentation'

  -- Initialise variables
  !folderBrowser = object PMLFOLDERBROWSER()

  -- Show the folder browser
  !folderBrowser.show('Select Output Folder',true)
  !path = !folderBrowser.selectedPath()
  if (!path.empty()) then
    return
  endif

  -- Use the selected folder
  !this.exportPath.val = !folderBrowser.selectedPath()
  handle any
    !!alert.message('Cancel selecting output folder')
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      gridPopupCallback
-- Description: grid popup callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
