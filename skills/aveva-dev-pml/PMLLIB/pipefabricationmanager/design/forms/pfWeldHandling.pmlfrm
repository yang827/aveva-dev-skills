-- Method:      errorListGridPopupCallback
-- Description: error list grid popup callback
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .errorListGridPopupCallback(!data is ARRAY)
  !this.errorListContainer.showPopup(!data[0], !data[1])
endmethod

------------------------------------------------------------------------
--
-- Method:      setPopupMenus
-- Description: set popup menus
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setPopupMenus(!isDataGrid is BOOLEAN)
  if (!isDataGrid) then
    !popupName   = 'gridPopupMenu'
    !controlName = 'gridContainer'
    !gridName    = 'dataGrid'
    !isWeldList  = true
  else
    !popupName   = 'errorListPopupMenu'
    !controlName = 'errorListContainer'
    !gridName    = 'errorListGrid'
    !isWeldList  = false
  endif

  !popup = !this.newMenu(!popupName)

  !popup.add('toggle', 'Navigate on Explorer',    '!this.navigateToExplorer(')
  !popup.add('separator')
  if (!isDataGrid) then
    !popup.add('callback',   'Modify Welds',     '!this.changeItemsOnGrid()', '' )
    --    !popup.add('separator')
    --    !popup.add('callback', 'Copy Image from 3D View', '!this.exportImage(|COPY|)')
    --    !popup.add('callback', 'Save Image from 3D View', '!this.exportImage(|SAVE|)')
  endif

  !popup.add('separator')
  !popup.add('callback', 'Export to Excel', '!this.saveToExcel($!isWeldList)')
  !popup.add('callback', 'Print Preview', '!this.$!<gridName>.printPreview()')


  !this.$!<controlName>.popup = !popup

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
-- Description: initialise
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()
  !this.checkCe()
  !this.ceLabel.val = !!ce.flnm

  if (!this.fromSpec.val) then
    !this.zeroGap.val = false
    !this.zeroGap.active = false
  else
    !this.zeroGap.active = true
  endif
  !this.displayWeldList()

  !this.fromConfig.active = true
  if (!this.checkWeldGapTableExist().not()) then
    !this.fromConfig.active = false
  endif

  !createButtonEnable = !this.fromConfig.active or !this.fromSpec.active

  !this.createCE.active   = !createButtonEnable
  !this.createPick.active = !createButtonEnable

  !unusedWeldPrefix = !this.getWeldPrefix()
  !this.populateErrorList(object ARRAY())
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkWeldGapTableExist
-- Description: check whether weld gap table does exist
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkWeldGapTableExist() is BOOLEAN
  !appldwRefs = !!collectAllFor('APPLDW', |FUNC EQ 'PipeFabrication'|, /* )

  !existWeldGapTable = true
  if (!appldwRefs.empty()) then
    !existWeldGapTable = false
  else
    -- check APPDAR for weld gap config
    !weldApparRefs = !!collectAllFor('APPDAR', |FUNC EQ 'WELD.GAP-CONFIG'|, !appldwRefs[1] )
    if (!weldApparRefs.unset()) then
      !existWeldGapTable = false
    endif
  endif

  if (!existWeldGapTable.not()) then
    !!alert.message('There is no weld gap table. Please create the table.')
    return false
  endif

  return true
endmethod

define method .loadConfigData()
  -- load stypes
  if (undefined(!!pfweldgapconfig)) then
    pml load form !!pfweldgapconfig
  endif

  !!pfweldgapconfig.loadOption()
  handle any
    !sTypes = split('SWN,FWN,FWS',',')
  elsehandle none
    !sTypes = !!pfweldgapconfig.sTypes
  endhandle

  !this.sTypes = !sTypes

  -- set flag for fitting to fitting
  if (!!pfweldgapconfig.fittingConnectionFrame.val eq 1) then
    !weldForFittingFlag = 'NOT'
  elseif (!!pfweldgapconfig.fittingConnectionFrame.val eq 2) then
    !weldForFittingFlag = 'ZERO'
  else
    !weldForFittingFlag = 'GAP'
  endif

  !this.weldControl.weldGapTypeForFittings = !weldForFittingFlag

  -- set flag for slip-on flange
  !this.weldControl.singleWeldForSlipOn = !!pfweldgapconfig.slipOnFrame.val eq 1
  handle any
    !this.weldControl.singleWeldForSlipOn = false
  endhandle

  -- set Stype for socket welds
  !this.weldControl.stypeForShopSocketWeld = ''
  !this.weldControl.stypeForFieldSocketWeld = ''
  !this.weldControl.stypeForSiteSocketWeld = ''
  if (!!pfweldgapconfig.swFromSpec.val and !!pfweldgapconfig.socketShopStype.val.empty().not() and !!pfweldgapconfig.socketFieldStype.val.empty().not()  and !!pfweldgapconfig.socketSiteStype.val.empty().not()) then
    !this.weldControl.stypeForShopSocketWeld = !!pfweldgapconfig.socketShopStype.val.upCase()
    !this.weldControl.stypeForFieldSocketWeld = !!pfweldgapconfig.socketFieldStype.val.upCase()
    !this.weldControl.stypeForSiteSocketWeld = !!pfweldgapconfig.socketSiteStype.val.upCase()
  endif

  !this.weldControl.slipOnWeldFromSpec = !!pfweldgapconfig.slipOnFromSpec.val
  handle any
    !this.weldControl.slipOnWeldFromSpec = false
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      checkCe
-- Description: check ce
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkCe()
  --  !isValidType = !!ce.ahList.findFirst('SITE').set() or $
  --                 !!ce.ahList.findFirst('PIPE').set() or $
  --                 !!ce.ahList.findFirst('BRAN').set()

  !this.fromSpec.active = true

  !pipeRef = pipe of ce
  handle any
    if (!!ce.hardType inset ('ZONE','SITE')) then
      return
    else
      !!alert.message('This function can support only under SITE level')
      return
    endif
  endhandle

  if (!!ce.ahList.findFirst('PIPE').set()) then
    PIPE
  endif

  !pipingSpec = pspec of PIPE
  handle (2,111)
    !checkWeldSpecFlag = false
  elsehandle none
    !checkWeldSpecFlag = true
  endhandle

  !this.fromSpec.active = true

  if (!checkWeldSpecFlag) then
    if (!pipingSpec.badRef()) then
      !!alert.message('The current pipe does not have pipe spec')
      return
    endif

    !checkWeldSpec = !!collectAllFor('SELE', |tans eq 'WELD'|, !pipingSpec)
    !weldSpecExist = !checkWeldSpec.set()

    if (!weldSpecExist.not()) then
      !!alert.message('There is no weld spec in the current pipe spec ' & !pipingSpec.name)
      !this.fromSpec.active = false
      !this.fromConfig.val = true
    endif
  endif

  return

  !!alert.message('This function can support only PIPE level')
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setWeldType
-- Description: set weld type
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setWeldType()
  if (!this.weldingType.val) then
    !this.weldingType.tag        = 'FIELD'
    !this.weldingType.background = 'ORANGE'
  else
    !this.weldingType.tag        = 'SHOP'
    !this.weldingType.background = 'YELLOW'
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setCe
-- Description: set ce
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setCe()
  !this.checkCe()
  !this.ceLabel.val = !!ce.flnm
  !this.displayWeldList()

  !this.fromConfig.active = true
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getCurrentRef
-- Description: get current ref
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    DBREF      return to current ref
--
------------------------------------------------------------------------
define method .getCurrentRef() is DBREF
  !element = object DBREF(!this.ceLabel.val)
  handle any
    !!alert.error('Please check element name')
    !element = object DBREF()
  endhandle

  return !element
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createWeld
-- Description: create weld
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     BOOLEAN     is pick mode
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createWeld(!isPickMode is BOOLEAN)

  --here is the place where welds are created using weld handling form--we can check for the existing welds which are created using component creation form
  !element = object DBREF(!this.ceLabel.val)
  !compCreatedWeldsCnt = !!collectallfor('weld',|wldnumber eq 0|,!element)
  if(!this.nweldsaddedusingweldhandlingform eq 0 and !compCreatedWeldsCnt.size() gt 0) then
    !this.nweldsaddedusingweldhandlingform = 1
  endif
  !element = !this.getCurrentRef()
  if (!element.badRef()) then
    return
  endif


  !this.loadConfigData()

  --  !isShop          = !this.weldingType.val.not()
  !weldStype        = !this.sTypes[!this.weldingType.val]
  !weldPrefix       = !this.getWeldPrefix()
  !fabricationType  = !this.fabricationType.rText[!this.fabricationType.val]
  !appendNumberMode = !this.upDate.val
  !useSpec          = !this.fromSpec.val
  !zeroGap          = !this.zeroGap.val

  !this.weldControl.selectedStypeIndex = !this.weldingType.val
  --  !this.weldControl.debugMode = true
  !this.weldControl.isShopWeld = !this.weldingType.displayText().upCase() eq 'SHOP'

  if (!isPickMode) then
    !this.pickElement()
  else
    if (!element eq WORLD) then
      !!alert.message('This function can support only under SITE level')
      return
    endif

    !this.weldControl.createWeld(!element, !useSpec, !weldStype, !weldPrefix, !fabricationType, !appendNumberMode, !zeroGap)
    --157504
    if ( !!pfweldgapconfig.swCompOutOfSpec.val eq TRUE) then
      !outofspeccount = !!collectallfor('weld','spec of spref neq pspec of pipe ',!!dtbGetOwnerType(!element,|PIPE|))
      if (!outofspeccount.size() gt 0) then
        if(!this.weldControl.pipecompsoutofspec gt 0) then
          !totcount = !outofspeccount.size() - !this.weldControl.pipecompsoutofspec
         if(!totcount neq 0) then
          !!alert.message(!totcount.string() & ' ' & 'welds created out of Spec' )
          !this.weldControl.pipecompsoutofspec = 0
         endif
        else
        !!alert.message(!outofspeccount.size().string() & ' ' & 'welds created out of Spec' )
         endif
      endif
    endif
  endif
 !this.weldControl.pipecompsoutofspec = 0
  --/157504
  !this.displayWeldList()
  if (!this.markWeldInfo.val) then
    !this.markWeldData()
  endif

  if (!this.weldControl.errorList.set()) then
    if(!isPickMode.not()) then
      !!alert.message(!this.weldControl.errorList.size() & ' welds could not be created. Please check Error List tab')
    endif
    !this.populateErrorList(!this.weldControl.errorList)
  else
    !this.populateErrorList(object ARRAY())
  endif

  --Renumber/Rename all of the welds, and refresh the grid displaying them
  if(!appendNumberMode.not()) then
    !this.weldControl.renumberAllWelds(!element)
    !this.displayWeldList()
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createWeldWithPickedElements
-- Description: create weld with picked elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createWeldWithPickedElements()
  --  !isShop          = !this.weldingType.val.not()
  !this.loadConfigData()

  unenhance all
  aid clear all $!<this.aidNumberForSetOnTee>

  !weldPrefix       = !this.getWeldPrefix()
  !weldStype        = !this.sTypes[!this.weldingType.val]
  !fabricationType  = !this.fabricationType.rText[!this.fabricationType.val]
  !appendNumberMode = !this.upDate.val
  !useSpec          = !this.fromSpec.val
  !zeroGap          = !this.zeroGap.val

  !saveCe = !!ce

  --!this.weldControl.createWeld(!this.pickedElements, !useSpec, !isShop, !weldPrefix, !fabricationType, !appendNumberMode, !zeroGap)
  !this.weldControl.createWeld(!this.pickedElements, !useSpec, !weldStype, !weldPrefix, !fabricationType, !appendNumberMode, !zeroGap)

  !!ce = !saveCe
  handle any
  endhandle

  unenhance all

  !this.displayWeldList()
  if (!this.markWeldInfo.val) then
    !this.markWeldData()
  endif

  if (!this.weldControl.errorList.set()) then
    !!alert.message(!this.weldControl.errorList.size() & ' welds could not be created. Please check Error List tab')
    !this.populateErrorList(!this.weldControl.errorList)
  else
    !this.populateErrorList(object ARRAY())
  endif

  --  unenhance all
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addSourceElement
-- Description: add source element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addSourceElement(!pickData is EDGPICKDATA)
  !element = !pickData.item

  if (not(!element.hardType inset ('TEE','BRAN')) and !pickData.type eq 'TUBING')then
    !inValidComponent = true
    if (!element.hardType ne 'BRAN') then
      !ownerRef = !element.owner
      !tubeRef  = il tube of $!<element>
      !tubeLine = object LINE(!tubeRef.aPos, !tubeRef.lPos)
      !pickPos  = !tubeLine.near(!pickData.pickLine.position)
      if (!element.sequ lt !ownerRef.mCount) then
        !nextComp = !ownerRef.members[!element.sequ + 1]
        if (!nextComp.aPos.distance(!nextComp.lPos) lt 0.5mm) then
          if (!tubeLine.near(!nextComp.pos).distance(!pickPos) lt !tubeLine.near(!element.pos).distance(!pickPos)) then
            !element = !nextComp
            !inValidComponent = false
          endif
        endif
      endif
    endif

    if (!inValidComponent) then
      !!alert.message('Pick a Component')
      return
    endif
  else
    if (!element.hardType eq 'TEE' ) then
      if (!pickData.type eq 'TUBING') then
        if (!element.aPos.distance(!element.lPos) lt 0.5mm and !element.tGeom) then
          !tubeRef  = il tube of $!<element>
          !tubeLine = object LINE(!tubeRef.aPos, !tubeRef.lPos)
          !pickPos  = !tubeLine.near(!pickData.pickLine.position)

          if (!tubeRef.aPos.distance(!pickPos) gt !tubeRef.lPos.distance(!pickPos)) then
            !!alert.message('Pick a Component')
            return
          endif
        else
          !!alert.message('Pick a Component')
          return
        endif
      endif
    endif
  endif

  if (!element.hardType eq 'BRAN') then
    if (!element.tGeom) then
      !tubeRef = il tube of $!<element>
      !tubeLine = object LINE(!tubeRef.aPos, !tubeRef.lPos)
      !pickPos  = !tubeLine.near(!pickData.pickLine.position)
    else
      !pickPos = !pickData.pickLine.position
    endif

    if (!element.hPos.distance(!pickPos) lt !element.tPos.distance(!pickPos)) then
      !pickKey = 'HREF'
    else
      !pickKey = 'TREF'
    endif

    if (!element.$!<pickKey>.badRef().not()) then
      !connectedEntry = !element.$!<pickKey>
      if (!connectedEntry.hardType eq 'TEE' and !connectedEntry.aPos.distance(!connectedEntry.lPos) lt 0.5mm) then
        !element = !connectedEntry
      else
        !!alert.message('Pick a Component')
        return
      endif
    else
      !pickKey = ''
    endif

    if (!element.tGeom) then
      if (!element.mCount gt 0 and !element.members[1].hardType eq 'TEE') then
        !tubeRef = il tube of $!<element>
        !tubeLine = object LINE(!tubeRef.aPos, !tubeRef.lPos)
        !pickPos  = !tubeLine.near(!pickData.pickLine.position)

        !teeElement = !element.members[1]
        if (!teeElement.aPos.distance(!teeElement.lPos) lt 0.5mm) then
          if (!tubeRef.aPos.distance(!pickPos) le !tubeRef.lPos.distance(!pickPos)) then
            !!alert.message('Pick a Component')
            return
          endif

          !element = !teeElement
        endif
      else
        if (!pickKey.empty()) then
          !!alert.message('Pick a Component')
          return
        endif
      endif
    endif
  endif

  !isValidComponent = !this.weldControl.isValidElementForWeld(!element)
  if (!isValidComponent.not()) then
    !!alert.message('Pick valid element to weld')
    return
  endif

  !isExistWeldOnComp = !this.weldControl.checkExistWeldOnComponent(!element)
  if (!isExistWeldOnComp) then
    !!alert.message('Pick element has WELD already')
    return
  endif

  !members = !element.owner.members

  !index = !this.pickedElements.findFirst(!element)
  if (!index.set()) then
    unenhance $!element
    !this.pickedElements.remove(!index)
  else
    if (!element.hardType eq 'TEE' and !element.aPos.distance(!element.lPos) lt 0.5mm) then
      AID TEXT NUMBER $!<this.aidNumberForSetOnTee> '<Set-On Tee>' AT $!element.pos
    endif

    enhance $!element colour $!!gphColOpt.highlight.code
    !this.pickedElements.append(!element)
  endif

  if (!this.pickedElements.unset()) then
    aid clear all $!<this.aidNumberForSetOnTee>
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickElement
-- Description: pick element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickElement()
  !this.pickedElements.clear()

  -- define packet for group elements
  !packet                = object EDGPACKET()
  !packet.description    = 'Pick component to create weld'
  !packet.priority       = 1
  !packet.action        = '!!pfweldhandling.addSourceElement(!this.return[1])'
  !packet.remove         = false
  !packet.pickPacket.stdElement('Pick component to create weld or <ESC> to finish')
  !packet.pickPacket.picks[1].pick.input[3]   = '((type of owner) eq |BRAN| and type ne |WELD|'
  !packet.escape         = |!!pfweldhandling.createWeldWithPickedElements()|

  -- Add event to system
  !!edgCntrl.add(!packet)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pickWeldElement
-- Description: EDG Graphical pick for welds.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pickWeldElement()

  !this.weldData.clear()
  !this.weldsToModify.clear()

  !packet                                   = object EDGPACKET()
  !packet.description                       = 'Pick Weld Element'
  !packet.priority                          = 1
  !packet.action                            = '!!pfWeldHandling.addWeldElement(!this.return[1])'
  !packet.remove                            = false
  !packet.pickPacket.stdElement('Pick Weld or <ESC> to finish')
  !packet.pickPacket.picks[1].pick.input[3] = ''
  !packet.escape = |!!pfWeldHandling.showModifyWeld()|
  !!edgCntrl.add(!packet)

endmethod

------------------------------------------------------------------------
--
-- Method:      addWeldElement
-- Description: Add welds by graphical pick
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addWeldElement( !pickData is EDGPICKDATA )

  if (!!dtbGetOwnerType( !pickData.item , 'PIPE' ).unset() ) then
    !!alert.message( 'Wrong Element Type Selected' )
    return
  endif

  if(!pickData.item.type.neq('WELD')) then
  !this.weldData = !!collectAllFor( |WELD| , || , !!dtbGetOwnerType( !pickData.item , 'PIPE' ) )
  else
    !this.weldData.append(!pickData.item)
  endif
  if ( !this.weldData.size().gt(0) ) then
    !pickPosition = !pickData.pickLine.position
    !this.distanceData = !this.weldData.evaluate( object BLOCK( |!this.weldData[!evalindex].pos.wrt(world).distance(!pickPosition)| ) )
    !newArVal = !this.distanceData
    !newArVal.sort()
    !valFind = !this.distanceData.findFirst(!newArVal[1])
    !weldSelected = !this.weldData[!valFind]
    !number = !weldSelected.wldnumber
    !weldText = 'WELD' + !number.string()
    !weldPos = !weldSelected.pos.wrt(world)
    !aidStatus = object STRING()
    VAR !aidStatus AID TEXT $!number
    handle (41,6)
    endHandle
    if ( !aidStatus.eq(||) ) then
      AID TEXT NUMBER $!number '$!weldText' AT $!weldPos
      !this.weldsToModify.append(!weldSelected)
      !this.weldsToModify.unique()
    else
      AID CLEAR ALL $!number
      !this.weldsToModify.unique()
      !index = !this.weldsToModify.findFirst(!weldSelected)
      !this.weldsToModify.remove(!index)
    endif
  else
    !!alert.message('No welds in Pipe for Selection')
    return
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      markWelds
-- Description: mark welds
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .markWelds()
  if (!this.showWeld.val) then
    !this.showWeld.tag        = 'Unmark Weld No.'

    !element = !this.getCurrentRef()
    if (!element.badRef()) then
      return
    endif

    !weldList = !!collectAllFor('WELD', '', !element)
    do !weldRef values !weldList
      !weldInfo = !weldRef.wldNumber
      AID TEXT NUMBER $!<this.aidNumber> '$!weldInfo' AT $!weldRef.pos
    enddo

  else
    !this.showWeld.tag        = 'Mark Weld No.'
    aid clear all $!<this.aidNumber>
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      displayWeldList
-- Description: display weld list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .displayWeldList()

  !contents = object ARRAY()
  if (defined(!!pfContext)) then
    !!pfContext.delete()
  endif
  !context = object PFCONTEXT()
  !context.globalInstance()

  !element = object DBREF(!this.ceLabel.val)
  !weldList = !!collectAllFor('WELD','',!element)

  if (!this.nweldsaddedusingweldhandlingform eq 0) then
    !element = object DBREF(!this.ceLabel.val)
    !compCreatedWeldsCnt = !!collectallfor('weld',|wldnumber eq 0|,!element)
    if(!compCreatedWeldsCnt.size() gt 0) then
      !this.nweldsaddedusingweldhandlingform = 2
    endif
  endif

  if (!!pfcontext.updtManCreateedWelds and !this.nweldsaddedusingweldhandlingform ge 1) then
    !this.orderweldlistOnCheck(!this.nweldsaddedusingweldhandlingform)
    !this.nweldsaddedusingweldhandlingform = 0
  else
    handle any
      !this.populateGrid(object ARRAY())
      return
    endhandle
    !attributeKeys = split('name,shop,weldType,spoolLimit,wldNumber',',')
    do !i index !weldList
      !weldRef = !weldList[!i]
      !table = object ARRAY()
      do !attribute values !attributeKeys
        if(!attribute EQ |shop|) then
          !wType = !weldRef.stype
          if ((!wType eq !!pfWeldGapConfig.shopStype.val) OR (!wType eq !!pfWeldGapConfig.socketShopStype.val)) then
             !table.append(|SHOP|)
          elseif ((!wType eq !!pfWeldGapConfig.fieldStype.val) OR (!wType eq !!pfWeldGapConfig.socketFieldStype.val)) then
              !table.append(|FIELD|)
          elseif ((!wType eq !!pfWeldGapConfig.siteStype.val) OR (!wType eq !!pfWeldGapConfig.socketSiteStype.val)) then
              !table.append(|SITE|)
          else
              if( !wType eq 'SWN') then
               !table.append(|SHOP|)
              elseif (!wType eq 'FWN') then
               !table.append(|FIELD|)
              elseif (!wType eq 'FWS') then
               !table.append(|SITE|)
              else
               !table.append(||)
              endif
          endif
        elseif(!attribute EQ |spoolLimit|) then
          if(!weldRef.shop.not() AND !weldRef.loff.not()) then
            !table.append(|True|)
          else
            !table.append(|False|)
          endif
        else
          !table.append(!weldRef.$!<attribute>)
        endif
      enddo
      !contents.append(!table)
    enddo

    !this.populateGrid(!contents)
    !activateFlag = !this.dataGrid.getRows().set()
    !this.removeWelds.active        = !activateFlag
    !this.removePartialWelds.active = !activateFlag
  endif

  !this.weldControl.lastWeldNumber = !weldList.size()
endmethod
-- End of method

--update manually created welds when using the weld handling form
--Substring(REAL index,REAL nchars)


define method .orderweldlistOnCheck(!createWeldDecision is REAL)

  !element = object DBREF(!this.ceLabel.val)
  !componentCreateWeldCount = !!collectallfor('weld',|wldnumber eq 0|,!element)

  --Used to identify how many welds we originaly had with weld number 0 before removing
  --welds that do not need to be renumbered.
  !weldsWithZeroWeldNum = !componentCreateWeldCount.size()

  --Remove welds that have previously been assigned a number and a name based on their number
  --as we do not want to change their name
  do !i index !componentCreateWeldCount
    if(!componentCreateWeldCount[!i].isnamed) then
      !componentCreateWeldCount.deleteFrom(!i, 1)
    endif
  enddo

  --Reindex the array after removing the elements
  !componentCreateWeldCount.compress()

  !element = object DBREF(!this.ceLabel.val)
  !weldList = !!collectAllFor('WELD','',!element)
  !attributeKeys = split('wldNumber,name,shop,weldType,wldPref',',')

  --Attempt to get the weld auto naming rule and use it.
  !weldNamingRule= !!namopt.getName('Pipe Weld Name')

  if(!weldNamingRule.unset()) then
    !weldName = |'/' & !!dtbGetOwnerType(!weldRef,'PIPE').namn & '/' & substring('0000' & !weldRef.wldn,-3,3)|
  else
    !weldNameFormat = !weldNamingRule.format.replace('!!ce', '!weldRef')
    !weldName = |'/' & $!weldNameFormat|
  endif


  !contents = object ARRAY()
  if (!createWeldDecision eq 2) then
    !lastindexofweld = !weldList.size() - !componentCreateWeldCount.size() + 1
    do !i index !componentCreateWeldCount
      !weldRef = !componentCreateWeldCount[!i]
      do !attribute values !attributeKeys
        if(!attribute eq 'wldNumber') then
          !weldRef.$!<attribute> = !lastindexofweld
        elseif(!attribute eq 'name') then
          !weldRef.$!<attribute> = $!weldName
        elseif(!attribute eq 'wldPref') then
          !weldRef.$!<attribute> = !!pfContext.defaultPrefixForWeld
        endif
      enddo
      !lastindexofweld = !lastindexofweld + 1
    enddo
  elseif (!createWeldDecision eq 1) then
    !wccreatedCompCre = !componentCreateWeldCount.size()
    !firstFound = 0

    !prevWeldNumber = 0
    !weldlistInvertedCopy = !weldList.invert()
    -- for weld number
    !invertedCount = !weldlistInvertedCopy.size()
    do !i index !weldlistInvertedCopy
      !weldRef = !weldlistInvertedCopy[!i]
      !attributeKeys = split('wldNumber,name,shop,weldType,',',')
      do !attribute values !attributeKeys
        if(!attribute eq 'wldNumber') then
          if (!weldRef.$!<attribute> gt 0) then
            if (!firstFound eq 0) then
              !weldRef.$!<attribute> = !weldRef.$!<attribute> + !wccreatedCompCre
            else
              !weldRef.$!<attribute> = !prevWeldNumber - 1
            endif
            !prevWeldNumber = !weldRef.$!<attribute>
          elseif (!weldRef.$!<attribute> eq 0) then
            !weldRef.wldprefix=!this.getWeldPrefix()
            if (!firstFound eq 0 and !invertedCount eq !weldlistInvertedCopy.size()) then
              !weldRef.$!<attribute> = !weldlistInvertedCopy.size()
              !prevWeldNumber = !weldlistInvertedCopy.size()
              !firstFound = 1
            elseif (!firstFound eq 0 and !invertedCount neq !weldlistInvertedCopy.size()) then
              !wccreatedCompCre = !wccreatedCompCre - 1
              !weldRef.$!<attribute> = !prevWeldNumber - 1
              !prevWeldNumber = !weldRef.$!<attribute>
              !firstFound = 1
            else
              !wccreatedCompCre = !wccreatedCompCre - 1
              !weldRef.$!<attribute> = !prevWeldNumber - 1
              !prevWeldNumber =  !weldRef.$!<attribute>
            endif
          endif
        endif
      enddo
      !invertedCount = !invertedCount - 1
    enddo
    --/ weld number
    -- weldname
    !weldNo = 0
    do !i index !weldlistInvertedCopy
      !weldRef = !weldlistInvertedCopy[!i]
      !attributeKeys = split('wldNumber,name,shop,weldType,',',')
      do !attribute values !attributeKeys
        if(!attribute eq 'wldNumber') then
          !weldNo = !weldRef.$!<attribute>
        elseif(!attribute eq 'name') then
          !weldRef.$!<attribute> = $!weldName
        endif
      enddo
    enddo
    --/ weldname

  endif
  !attributeKeys = split('name,shop,weldType,spoolLimit,wldNumber',',')
  if (!createWeldDecision eq 1) then
    !weldList = !weldList.invert()
  endif
  do !i index !weldList
    !weldRef = !weldList[!i]
    !table = object ARRAY()
    do !attribute values !attributeKeys
      if(!attribute EQ |shop|) then
        !wType = !weldRef.stype
        if ((!wType eq !!pfWeldGapConfig.shopStype.val) OR (!wType eq !!pfWeldGapConfig.socketShopStype.val)) then
          !table.append(|SHOP|)
        elseif ((!wType eq !!pfWeldGapConfig.fieldStype.val) OR (!wType eq !!pfWeldGapConfig.socketFieldStype.val)) then
          !table.append(|FIELD|)
        elseif ((!wType eq !!pfWeldGapConfig.siteStype.val) OR (!wType eq !!pfWeldGapConfig.socketSiteStype.val)) then
          !table.append(|SITE|)
        else
          !table.append(||)
        endif
      elseif(!attribute EQ |spoolLimit|) then
        if(!weldRef.shop.not() AND !weldRef.loff.not()) then
          !table.append(|True|)
        else
          !table.append(|False|)
        endif
      else
        !table.append(!weldRef.$!<attribute>)
      endif
    enddo
    !contents.append(!table)
  enddo
  --Displaying with correct order in the GRID---------------------
  !this.populateGrid(!contents)
  !activateFlag = !this.dataGrid.getRows().set()
  !this.removeWelds.active        = !activateFlag
  !this.removePartialWelds.active = !activateFlag

--Check if some welds still exist with a weld number of 0. If so inform the user
  if (!weldsWithZeroWeldNum neq !componentCreateWeldCount.size()) then
    !!alert.warning('Current Pipe contains welds with Weld Number of 0. Please check and modify as required.')
  endif

endmethod

-- End of method


------------------------------------------------------------------------
--
-- Method:      populateGrid
-- Description: populate grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       contents
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .populateGrid(!contents is ARRAY)
  using namespace 'Aveva.Pdms.Presentation'
  !nds          = object NETDATASOURCE('Search Result', !this.dataGridHeadings, !contents)

  !this.dataGrid.bindToDataSource(!nds)
  !this.validateWeldData(!contents)
  !this.dataGrid.autofitcolumns()
endmethod
-- End of method

define method .populateErrorList(!contents is ARRAY)
  using namespace 'Aveva.Pdms.Presentation'
  !nds = object NETDATASOURCE('Error List', !this.errorListHeading, !contents)

  !this.errorListGrid.bindToDataSource(!nds)
endmethod

------------------------------------------------------------------------
--
-- Method:      checkWeldNumberOverlap
-- Description: check weld number overlap
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       contents
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateWeldData(!contents is ARRAY)
  !weldNumberList = object ARRAY()

  !existFittingToFittingConnectionWithGap = false

  do !i index !contents
    !weldNumber = !contents[!i][1] & '_' & !contents[!i][4]

    !this.dataGrid.setRowColor(!i, 'WHITE')
    if (!weldNumberList.findFirst(!weldNumber).unset()) then
      !weldNumberList.append(!weldNumber)
    else
      !this.dataGrid.setRowColor(!i, 'YELLOW')
    endif

    !weldRef = !contents[!i][1].dbRef()
    handle any
      skip
    endhandle

    skip if (!weldRef.badRef())
    -- check whether there is overlapped weld
    if (!weldRef.sequ gt 1 and !weldRef.sequ le !weldRef.owner.mCount) then
      !prevEntry = !weldRef.owner.members[!weldRef.sequ - 1]
      if (!prevEntry.hardType eq 'WELD') then
        !isValidDistance = !prevEntry.pos.distance(!weldRef.pos) gt 0
        if (!isValidDistance.not()) then
          !this.dataGrid.setRowColor(!i, 'YELLOW')
        endif
      endif
    endif

    -- check whether there is weld for fitting to fitting connection
    !weldGap = !weldRef.desp[1]
    skip if (!weldGap le 0)

    if (!weldRef.sequ eq 1) then
      !fittingToFittingFlag = !weldRef.owner.tGeom.not() and !weldRef.tGeom.not()
    else
      do !tempSeq from !weldRef.sequ to 2 by -1
        !prevEntry = !weldRef.owner.members[!tempSeq - 1]
        break if (!prevEntry.hardType ne 'ATTA')
      enddo

      if (!prevEntry.sequ eq 1 and !prevEntry.hardType eq 'ATTA') then
        !prevEntry = !prevEntry.owner
      endif

      !fittingToFittingFlag = !prevEntry.tExist.not() and !prevEntry.tGeom.not() and !weldRef.tGeom.not()
    endif
    skip if (!fittingToFittingFlag.not())

    if (!existFittingToFittingConnectionWithGap.not()) then
      !existFittingToFittingConnectionWithGap = true
    endif

    !this.dataGrid.setRowColor(!i, 'CYAN')
  enddo

  if (!existFittingToFittingConnectionWithGap) then
    !!alert.warning(|Please check component positions. A weld with a specific gap has been inserted between the original fitting to fitting connection.|)
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectChange
-- Description: select change
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectChange(!data is ARRAY)
  if(!data.unset()) then
    return
  endif

  !selectedRowData = !this.dataGrid.getRow(!data[0][1])
  handle any
    return
  endhandle

  !selectedItemRef = !selectedRowData[1].dbRef()
  handle any
    !!alert.message('Selected item has bad reference. Please refresh this list.')
    return
  endhandle

  !navigateOnExplorer = !this.gridContainer.popup.selected('Navigate on Explorer')
  handle any
    !navigateOnExplorer = false
  endhandle

  if (!navigateOnExplorer) then
    !!ce = !selectedItemRef
  endif

  if (!this.navigage.val) then
    !this.navigateElementOn3dView(true)
  endif

  !this.markWeldData()

  !this.highlightWelds()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectChangeOnErrorList
-- Description: select change on error list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectChangeOnErrorList(!data is ARRAY)
  if (!data.unset()) then
    return
  endif

  !selectedRowData = !this.errorListGrid.getRow(!data[0][1])
  handle any
    return
  endhandle

  !selectedItemRef = !selectedRowData[1].dbRef()
  handle any
    !!alert.message('Selected item has bad reference.')
    return
  endhandle

  !navigateOnExplorer = !this.errorListContainer.popup.selected('Navigate on Explorer')
  handle any
    !navigateOnExplorer = false
  endhandle

  if (!navigateOnExplorer) then
    !!ce = !selectedItemRef
  endif

  if (!this.navigageOnErrorList.val) then
    !this.navigateElementOn3dView(false)
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      navigateToExplorer
-- Description: navigate to explorer
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     MENU        menu
--    2    R     STRING      task
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .navigateToExplorer(!dummyMenu is MENU, !task is STRING)
  if (!dummyMenu.name() eq 'GRIDPOPUPMENU') then
    !gridName = 'dataGrid'
  else
    !gridName = 'errorListGrid'
  endif

  !selectedItems =  !this.$!<gridName>.getSelectedRows()
  if (!selectedItems.unset()) then
    return
  endif

  if (!task ne 'SELECT') then
    return
  endif

  !selectedRef = !selectedItems[1][1].dbRef()
  handle any
    !selectedRef = object DBREF()
  endhandle

  if (!selectedRef.badRef()) then
    !!alert.message('Selected item has bad reference')
    return
  endif

  !!ce = !selectedRef
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      navigateElementOn3dView
-- Description: navigate element on 3d view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .navigateElementOn3dView(!isDataGrid is BOOLEAN)
  if (!isDataGrid) then
    !gridName = 'dataGrid'
  else
    !gridName = 'errorListGrid'
  endif

  !selectedItems =  !this.$!<gridName>.getSelectedRows()
  if (!selectedItems.unset()) then
    return
  endif

  !selectedRef = !selectedItems[1][1].dbRef()
  handle any
    !selectedRef = object DBREF()
  endhandle

  if (!selectedRef.badRef()) then
    !!alert.message('Selected item has bad reference')
    return
  endif

  !!comElementZoomOn3DView(!selectedRef, false)

  if (!isDataGrid.not()) then
    unmark all
    mark $!selectedRef
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      exportImage
-- Description: export image
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      task type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .exportImage(!taskType is STRING)
  using namespace 'Aveva.Pdms.PMLNet'
  !clipboard = object PMLCLIPBOARD()

  using namespace 'Aveva.Pdms.Presentation.PDMSCommands'
  !commandManager = object PMLNETCOMMANDMANAGER()

  --DON'T CHANGE CAPITAL STRING. IT OCCURS ERROR!!!!
  !commandManager.executeCommand('AVEVA.View.CopyImage.Size1')

  if (!taskType eq 'COPY') then
    return
  endif

  using Namespace 'Aveva.Pdms.Presentation'
  !browser = object PMLFILEBROWSER('save')

  --default to first location from PDMSUSER evar
  !pdmsUser = !!evarSplit('PDMSUSER')
  !directory = !pdmsUser[1]

  !title = 'Export Image'

  !existFlag = false
  !filter = 'Image File (*.png)|*.png'
  !filterIndex = 1

  --show Browser
  !browser.show(!directory, 'Current View', !title, !existFlag, !filter, !filterIndex)
  handle (1000,0)
    !!alert.message('Cancel saving to image file')
  endhandle

  !imagePath = !browser.file()
  !clipboard.saveImage(!imagePath)
  handle (1000,0)
    !!alert.message('Cancel saving to image file')
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      saveToExcel
-- Description: save to excel
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveToExcel(!isDataGrid is BOOLEAN)
  if (!isDataGrid) then
    --    !gridName = 'dataGrid'
    --    !fileName = 'weldList.xls'
    !this.exportWeldList()
    return
  endif

  !gridName = 'errorListGrid'
  !fileName = 'errorList.xls'

  if (!this.$!<gridName>.getNumberRows() eq 0) then
    !!alert.warning('No data to export')
    return
  endif

  using namespace 'Aveva.Pdms.Presentation'

  !browser = object PMLFILEBROWSER('SAVE')
  !pdmsUser = !!evarSplit('PDMSUSER')[1]

  --show Browser
  !browser.show(!pdmsUser, !fileName, 'Save To Excel', false, 'Microsoft Office Excel Files (*.xls)|*.xls', 1)
  if (!browser.file().empty()) then
    !!alert.message('Cancel exporting to excel file')
    return ''
  endif

  !this.$!<gridName>.saveGridToExcel(!browser.file())
  handle any
    !!alert.message('Cancel exporting to excel file')
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      queryWeldList
-- Description: query weld list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .exportWeldList()
  !weldData = !this.dataGrid.getRows()

  if (!weldData.unset()) then
    !!alert.message('There is no item.')
    return
  endif
  --dataGridHeadings = split('Name,Shop,Type,Number',',')

  !contents = object ARRAY()

  do !rowData values !weldData
    !weldName   = !rowData[1]
    !weldShop   = !rowData[2]
    !weldType   = !rowData[3]
    !weldNumber = !rowData[4]

    !weldRef = !weldName.dbRef()
    handle any
      !weldRef = object DBREF()
    endhandle

    if (!weldRef.badRef()) then
      !boreSize      = '---'
      !wallThickness = '---'
      !circumference = '---'
      !weldGap       = '---'
      !material      = '---'
    else
      !boreSize           = !weldRef.lbore.string()
      !wallThickness      = !this.weldControl.evaluateWallThickness(!weldRef)
      !circumferenceValue = 2 * PI * (max(!weldRef.lod, !weldRef.aOd) / 2)
      handle any
        !circumference = '---'
      endhandle

      !circumference      = !circumferenceValue.string(!!distanceFMT)
      !weldGap            = !weldRef.desp[1].string(!!distanceFMT)
      !material           = !this.weldControl.evaluateMaterial(!weldRef)
    endif

    !table = object ARRAY()
    !table.append(!weldName)
    !table.append(!boreSize)
    !table.append(!weldShop)
    !table.append(!weldType)
    !table.append(!wallThickness)
    !table.append(!circumference)
    !table.append(!weldGap)
    !table.append(!material)

    !contents.append(!table)
  enddo

  if (!contents.unset()) then
    !!alert.message('There is no item')
    return
  endif

  using namespace 'Aveva.Pdms.Presentation'

  !browser = object PMLFILEBROWSER('SAVE')
  !pdmsUser = !!evarSplit('PDMSUSER')[1]

  --show Browser
  !fileName = 'weldList.xls'
  !browser.show(!pdmsUser, !fileName, 'Export To Excel', false, 'Microsoft Office Excel Files (*.xls)|*.xls', 1)
  if (!browser.file().empty()) then
    !!alert.message('Cancel exporting to excel file')
    return
  endif

  using namespace 'Aveva.Pdms.Presentation'
  !nds = object NETDATASOURCE('Welding List', !this.weldListHeadings, !contents)
  !this.weldListGrid.bindToDataSource(!nds)
  !this.weldListGrid.saveGridToExcel(!browser.file())
  handle any
    !!alert.message('Cancel exporting to excel file')
    --  elsehandle none
    --    !!alert.message('Export Completed!')
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      removeWelds
-- Description: remove welds
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeWelds()
  !selectedItems =  !this.dataGrid.getSelectedRows()
  if (!selectedItems.unset()) then
    return
  endif

  !answer = !!alert.confirm('Are you sure to remove selected items?')
  if (!answer ne 'YES') then
    return
  endif

  !saveCe = !!ce
  do !entry values !selectedItems
    !selectedRef = !entry[1].dbRef()
    handle any
      !selectedRef = object DBREF()
    endhandle

    skip if (!selectedRef.badRef())

    !!ce = !selectedRef
    delete WELD
    handle any
    endhandle
  enddo

  !!ce = !saveCe

  !this.nweldsaddedusingweldhandlingform = 0
  !this.displayWeldList()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      removeWelds
-- Description: remove welds
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     BOOLEAN     flag all remove
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeWelds(!flagAllRemove is BOOLEAN)
  !this.nweldsaddedusingweldhandlingform = 0

  if(undefined(!!pfWeldhandlingdeleteconfirm)) then
    pml load form !!pfWeldhandlingdeleteconfirm
  endif

  if (!flagAllRemove.not()) then
    !selectedItems =  !this.dataGrid.getSelectedRows()
    if (!selectedItems.unset()) then
      !!alert.message('Please select item(s) on the grid')
      return
    endif
  endif

  !!pfWeldhandlingdeleteconfirm.show('cen', 0.5, 0.5)
  !!pfWeldhandlingdeleteconfirm.removeall = !flagallremove

  if (!flagAllRemove) then
    !!pfWeldhandlingdeleteconfirm.caption('Are you sure to delete all items?')
  else
    !!pfWeldhandlingdeleteconfirm.caption('Are you sure to delete selected items?')
  endif

  !pipeRef = !this.getCurrentRef()
  if (!pipeRef.badRef()) then
    return
  endif

  !weldList = !!collectAllFor('WELD','', !pipeRef)
  !allSpoolLimitWelds = true

  do !weldRef values !weldList
    skip if(!weldRef.shop.not() AND !weldRef.loff.not())
    !allSpoolLimitWelds = false
  enddo
  if(!allSpoolLimitWelds) then
    !!pfWeldhandlingdeleteconfirm.togIncludeSpoolLimits.val = true
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteWelds
-- Description: Deletes the welds based on the answer from the form !!pfWeldHandlingDeleteConfirm
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     BOOLEAN     flag all remove
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteWelds(!flagAllRemove is BOOLEAN)
  !answer = !!pfWeldHandlingDeleteConfirm.yesOrNo
  if (!answer ne 'YES') then
    return
  endif
  !saveCe = !!ce

  if (!flagAllRemove) then
    !pipeRef = !this.getCurrentRef()
    if (!pipeRef.badRef()) then
      return
    endif

    !weldList = !!collectAllFor('WELD','', !pipeRef)

    --Check if we want to delete spool limits as well as other welds
    if(!!pfWeldHandlingDeleteConfirm.togIncludeSpoolLimits.val) then
      do !weldRef values !weldList
        !!ce = !weldRef
        delete WELD
        handle any
        endhandle
      enddo
    else
      do !weldRef values !weldList
        !!ce = !weldRef
        --Skip if it's a spool limit weld
        skip if(!!ce.shop.not() AND !!ce.loff.not())
        delete WELD
        handle any
        endhandle
      enddo
    endif

  else
    !selectedItems =  !this.dataGrid.getSelectedRows()
    do !entry values !selectedItems
      !selectedRef = !entry[1].dbRef()
      handle any
        !selectedRef = object DBREF()
      endhandle

      skip if (!selectedRef.badRef())

      !!ce = !selectedRef
      delete WELD
      handle any
      endhandle
    enddo
  endif

  !!ce = !saveCe
  handle any
  endhandle

  !this.displayWeldList()

  !this.markWeldData()
  if (!flagAllRemove) then
    aid clear all $!<this.aidNumber>
    unenhance all
  endif
endmethod
--End of method

------------------------------------------------------------------------
--
-- Method:      markWeldData
-- Description: mark weld data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .markWeldData()
  --  unenhance all
  aid clear all $!<this.aidNumber>

  if (!this.markWeldInfo.val.not()) then
    aid clear all $!<this.aidNumber>
    !this.highlightWelds()
    return
  endif

  !selectedItems =  !this.dataGrid.getSelectedRows()
  if (!selectedItems.unset()) then
    return
  endif

  do !entry values !selectedItems
    !selectedRef = !entry[1].dbRef()
    handle any
      !selectedRef = object DBREF()
    endhandle

    skip if (!selectedRef.badRef())

    !this.markWeldElement(!selectedRef)
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      markWeldElement
-- Description: mark weld element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .markWeldElement(!element is DBREF)

  if (!element.badRef()) then
    return
  endif

  enhance $!element colour $!!gphColOpt.highlight.code
  !weldGap = !element.aPos.distance(!element.lPos).string(!!distanceFMT)

  !weldInfo = '<' & !element.wldNumber & '> Gap:' & !weldGap

  AID TEXT NUMBER $!<this.aidNumber> '$!weldInfo' AT $!element.pos

  !height   = 3mm
  !diameter = !element.aOd + 3mm
  AID CYLINDER NUMBER $!<this.aidNumber> AT $!<element.pos>  ORI Z IS $!<element.aDir> HEIGH $!<height> DIAM $!<diameter> FILLED ON
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showModifyWeld
-- Description: To show the pfModifyWelds form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showModifyWeld()

  AID CLEAR ALL
  !this.showModifyWeldForm(!this.weldsToModify)

endmethod

------------------------------------------------------------------------
--
-- Method:      changes
-- Description: changes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changes()

  !oriRef = !!ce
  if (!!ce.type.neq('WELD')) then
    !this.pickWeldElement()
  else
    !weldsToModify = object ARRAY()
    !weldsToModify.append(!!ce)
    !this.showModifyWeldForm(!weldsToModify)
  endif
  !!ce = !oriRef

  unenhance all
  aid clear all $!<this.aidNumber>

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      highlightWelds
-- Description: highlight selected welds
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .highlightWelds()
  unenhance all

  if (!this.highlightConnections.val.not()) then
    if (!this.markWeldInfo.val.not()) then
      aid clear all $!<this.aidNumber>
    endif
    return
  endif

  !selectedItems =  !this.dataGrid.getSelectedRows()
  if (!selectedItems.unset()) then
    return
  endif

  !aidCylinderHeight   = 3mm

  !weldList = object ARRAY()
  do !entry value !selectedItems
    !weldRef = !entry[1].dbRef()
    handle any
      !weldRef = object DBREF()
    endhandle

    skip if (!weldRef.badRef())

    !ownerMembers = !weldRef.owner.members
    if (!weldRef.sequ eq 1) then
      --147089
      if(!weldRef.owner.mcount eq 1) then
       !listHteeexists = !weldRef.owner.href
        handle any
        elsehandle none
       if(!listHteeexists.unset()) then
         !listTteeexists = !weldRef.owner.tref
         handle any
         elsehandle none
         if(!listTteeexists.unset()) then
         else
          enhance $!listTteeexists colour $!!gphColOpt.highlight.code
         endif
         endhandle
       else
        enhance $!listHteeexists colour $!!gphColOpt.highlight.code
       endif
       endhandle
      endif
     --/147089
      if (!weldRef.owner.tGeom) then
        !tubeRef = il tube of $!weldRef.owner
        enhance $!tubeRef colour $!!gphColOpt.highlight.code
        --147089
        if(!weldRef.owner.mcount eq 1) then
         !listTteeexists = !weldRef.owner.tref
         handle any
          elsehandle none
        if(!listTteeexists.unset()) then
          !listHteeexists = !weldRef.owner.href
          handle any
          elsehandle none
          if(!listHteeexists.unset()) then
          else
            enhance $!listHteeexists colour $!!gphColOpt.highlight.code
          endif
          endhandle
        else
          enhance $!listTteeexists colour $!!gphColOpt.highlight.code
        endif
        endhandle
        endif
        --/147089
     !mynextweld = next of $!weldRef
       handle any
      elsehandle none
      if(!mynextweld.type.eq('WELD')) then
        !mynextsonflan = next of $!mynextweld
        if(!mynextsonflan.type eq 'FLAN' and !mynextsonflan.skey eq 'FLSO') then
          enhance $!mynextsonflan colour $!!gphColOpt.highlight.code
        endif
      endif
      --/147089
      endhandle
      endif
    else
      --147089
      if(!weldRef.seq eq !weldRef.owner.mcount) then
        !listTteeexists = !weldRef.owner.tref
         handle any
          elsehandle none
        if(!listTteeexists.unset()) then
          !listHteeexists = !weldRef.owner.href
          handle any
          elsehandle none
          if(!listHteeexists.unset()) then
          else
            enhance $!listHteeexists colour $!!gphColOpt.highlight.code
          endif
          endhandle
        else
          enhance $!listTteeexists colour $!!gphColOpt.highlight.code
        endif
        endhandle
      endif
      --/147089
      !previousComponent = !ownerMembers[!weldRef.sequ - 1]
      enhance $!previousComponent colour $!!gphColOpt.highlight.code
      --147089
      if (!previousComponent.type eq 'FLAN' and !previousComponent.skey eq 'FLSO') then
        !mytubetohighlight = next of $!weldRef
        handle any
        elsehandle none
       if(!mytubetohighlight.type eq 'WELD') then
          if(!mytubetohighlight.tGeom) then
            !mytubetohighlightweld = il tube of $!mytubetohighlight
           enhance $!mytubetohighlightweld colour $!!gphColOpt.highlight.code
          endif
        endif
       endhandle
      elseif (!previousComponent.type eq 'WELD') then
       if(!previousComponent.seq neq 1) then
        !isSliponFlan = prev of $!previousComponent
        if(!isSliponFlan.type eq 'FLAN' and !isSliponFlan.SKEY eq 'FLSO') then
          enhance $!isSliponFlan colour $!!gphColOpt.highlight.code
        endif
       endif
      endif
      --/147089

      --147089
      !nextsliponFlange = next of $!weldRef
       handle any
      elsehandle none
      if(!nextsliponFlange.type eq 'FLAN' and !nextsliponFlange.skey eq 'FLSO') then
        !prevweld = prev of $!weldRef
        if(!prevweld.type eq 'WELD') then
          if(!prevweld.seq eq 1) then
            !branown= !prevweld.owner
            if(!branown.tGeom) then
              !leavetubeofbran = il tube of $!branown
              enhance $!leavetubeofbran colour $!!gphColOpt.highlight.code
            endif
          else
             !prevunknownelement = prev of $!prevweld
             if(!prevunknownelement.tGeom) then
               !leavetubeofElement = il tube of $!prevunknownelement
               enhance $!leavetubeofElement colour $!!gphColOpt.highlight.code
             endif
          endif
        endif
      endif
     endhandle
      --/147089

      if (!previousComponent.tGeom) then
        !tubeRef = il tube of $!previousComponent
        enhance $!tubeRef colour $!!gphColOpt.highlight.code
      endif
    endif

    if (!weldRef.sequ lt !ownerMembers.size()) then
      !nextComponent     = !ownerMembers[!weldRef.sequ + 1]
      enhance $!nextComponent colour $!!gphColOpt.highlight.code
    endif

    if (!weldRef.tGeom) then
      !tubeRef = il tube of $!weldRef
      enhance $!tubeRef colour $!!gphColOpt.highlight.code
    endif

    enhance $!weldRef colour $!!gphColOpt.highlight.code

    if (!this.markWeldInfo.val.not()) then
      AID TEXT NUMBER $!<this.aidNumber> '<WELD>' AT $!weldRef.pos
    endif

    !aidCylinderDiameter = !weldRef.aOd + 3mm
    -- 147089 Handled Special case for issue 147089 Regarding set on Tee
    if (!weldRef.sequ lt !ownerMembers.size()) then
    !nextelement = next of $!weldRef
      if (!nextelement.type eq 'TEE') then
        if (!nextelement.skey eq 'TESO') then
          if(!nextelement.tgeom) then
          !nextTube = il TUBE OF $!nextelement
          enhance $!nextTube colour $!!gphColOpt.highlight.code
          endif
        if (!nextelement.cref.type eq 'BRAN') then
          !branRef = !nextelement.cref
          if(!branRef.href eq !nextelement) then
              if(!branRef.tgeom) then
            !connTube = il TUBE OF $!branRef
              else
                !connTube = il TUBE OF $!branRef.members[1]
              endif
            enhance $!connTube colour $!!gphColOpt.highlight.code
          else
              if(!branRef.tgeom) then
            !connTube = ia TUBE OF $!branRef
              else
                !connTube = ia TUBE OF $!branRef.members[!branRef.members.size() - 1]
              endif
             enhance $!connTube colour $!!gphColOpt.highlight.code
            endif
        endif
        endif
      endif
    endif

    --/147089 Handled Special case for issue 147089 Regarding set on Tee
    AID CYLINDER NUMBER $!<this.aidNumber> AT $!<weldRef.pos>  ORI Z IS $!<weldRef.aDir> HEIGH $!<aidCylinderHeight> DIAM $!<aidCylinderDiameter> FILLED ON
  enddo
endmethod

------------------------------------------------------------------------
--
-- Method:      changeItemsOnGrid
-- Description: change items on grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changeItemsOnGrid()

  !selectedItems =  !this.dataGrid.getSelectedRows()
  if (!selectedItems.unset()) then
    return
  endif
  !weldList = object ARRAY()
  do !entry value !selectedItems
    !weldRef = !entry[1].dbRef()
    handle any
      !weldRef = object DBREF()
    endhandle

    skip if (!weldRef.badRef())

    !weldList.append(!weldRef)
  enddo

  !this.showModifyWeldForm(!weldList)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      changeAttributes
-- Description: change attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       element list
--    2    R     STRING      shop
--    3    R     STRING      weld fab type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changeAttributes(!elementList is ARRAY, !shop is STRING, !weldFabType is STRING)
  aid clear all $!<this.aidNumber>

  if (!shop.empty() and !weldFabType.empty()) then
    return
  endif

  do !entry values !elementList
    if (!shop.empty().not()) then
      !entry.shop = $!shop
    endif

    if (!weldFabType.empty().not()) then

      !entry.weldType = |$!weldFabType|
    endif

  enddo

  !this.displayWeldList()
endmethod
-- End of method

------------------------------------------------------------------------------

-- Method:      changeAttributes
-- Description: change attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       element list
--    2    R     STRING      shop
--    3    R     STRING      weld fab type
--    4----R     STRING      spec type
-- Return:
--   [Data Type] [Description]
-----------------------------------------------------------------------------------
define method .changeAttributes(!elementList is ARRAY, !shop is STRING, !weldFabType is STRING, !isspec is BOOLEAN, !newsType is STRING)

  --107910
  !countoferrorwelds = 0
  --/107910

  if(!this.weldControl.errorList.size().geq(1)) then
    !this.weldControl.errorList.clear()
  endif

  aid clear all $!<this.aidNumber>
  if (!shop.empty() and !weldFabType.empty()) then
    return
  endif
  !savece = !!ce



  do !entry values !elementList
    !!ce = !entry

    --Determine if the entry is a socket weld or not
    !isEntrySocketWeld = false
    if((!entry.stype eq !!pfWeldGapConfig.socketShopStype.val) OR (!entry.stype eq !!pfWeldGapConfig.socketFieldStype.val) OR (!entry.stype eq !!pfWeldGapConfig.socketSiteStype.val)) then
      !isEntrySocketWeld = true
    endif

    --Select the correct stype to use based on if a Butt/Socket weld
    if(!isEntrySocketWeld) then
      if(!newsType eq 'SHOP') then
        !stype = !!pfWeldGapConfig.socketShopStype.val
      elseif (!newsType eq 'FIELD') then
        !stype = !!pfWeldGapConfig.socketFieldStype.val
      else
        !stype = !!pfWeldGapConfig.socketSiteStype.val
      endif
    else
      if(!newsType eq 'SHOP') then
        !stype = !!pfWeldGapConfig.shopStype.val
      elseif (!newsType eq 'FIELD') then
        !stype = !!pfWeldGapConfig.fieldStype.val
      else
        !stype = !!pfWeldGapConfig.siteStype.val
      endif
    endif

    if(!isspec eq  true) then
     CHOOSE WITH STYP $!stype
     handle any
       !countoferrorwelds = !countoferrorwelds + 1
       !this.weldControl.inputErrorList(!!ce.flnm, 'The stype specified does not exist in the current Pipe specification')
       skip
     elsehandle none
     endhandle
    else
      !weldgapSpec = SELECT SPEC /WELDGAP WITH STYP $!stype
      handle any
        !countoferrorwelds = !countoferrorwelds + 1
        !this.weldControl.inputErrorList(!!ce.flnm, 'The stype specified does not exist in the current Pipe specification')
        skip
      elsehandle none
        spref $!weldgapSpec[1]
      endhandle
    endif

    if !isspec then
      DESP unset
    else
      !weldGap = !this.weldControl.getWeldGapFromConfigTable(!!ce)
      handle any
        !weldGap = 0
      endhandle
      DESP $!weldGap
    endif

    if (!shop.empty().not()) then
      !entry.shop = $!shop
    endif
    if (!weldFabType.empty().not()) then
      !entry.weldType = |$!weldFabType|
    endif
  enddo

  !!ce = !savece
  !this.displayWeldList()
  if (!countoferrorwelds.geq(1)) then
    !!alert.message(!countoferrorwelds & ' welds could not be modified. Please check Error List tab')
    !this.populateErrorList(!this.weldControl.errorList)
  endif

endmethod



------------------------------------------------------------------------
--
-- Method:      track
-- Description: track
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .track()
  if (!!ce.hardType ne 'WELD') then
    return
  endif

  !rows = !this.dataGrid.getRows()
  do !i indices !rows
    !weldRef = !rows[!i][1].dbRef()
    handle any
      skip
    endhandle

    skip if (!weldRef.badRef())

    if (!weldRef eq !!ce) then
      !this.dataGrid.clearRowSelection()
      !this.dataGrid.selectRow(!i)
    endif
  enddo
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getWeldPrefix
-- Description: get weld prefix
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING     return to default prefix for weld
--
------------------------------------------------------------------------
define method .getWeldPrefix() is STRING
  !result = ''

  if (defined(!!pfContext)) then
    !!pfContext.delete()
  endif

  !context = object PFCONTEXT()
  !context.globalInstance()

  !result = !!pfContext.defaultPrefixForWeld

  !defaultWeldPrefix = !result
  if (!defaultWeldPrefix.empty()) then
    !defaultWeldPrefix = '(unset)'
  endif

  !this.weldPrefixTag.val = 'Default Weld Prefix: ' & !defaultWeldPrefix

  return !result
endmethod

------------------------------------------------------------------------
--
-- Method:      tidy
-- Description: tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tidy()
  !!edgCntrl.escape()

  aid clear all $!<this.aidNumber>
  aid clear all $!<this.aidNumberForSetOnTee>
  unenhance all

  !this.hide()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showModifyWeldForm
-- Description: showModifyWeldForm
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R         ARRAY       Welds to modify
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showModifyWeldForm(!weldsToModify is ARRAY)

  if(!weldsToModify.size().gt(0) ) then
    !flagtocontinue = 'YES'
    if (undefined(!!pfmodifywelds)) then
      pml load form !!pfmodifywelds
    endif
    --107910
    if (!weldsToModify.size() neq 0) then
      !firstWeldRef = !weldsToModify[1]
    endif
  --/107910
  --107910
      !specVal = !!dtbGetOwnerType(!firstWeldRef.spref,|SPEC|).namn
      !!pfmodifywelds.currspec = !specVal
      !isSpecSame = true
      !wType = !firstWeldRef.stype
      if (!weldsToModify.size() gt 1) then
        do !weldRef value !weldsToModify
        !memspec = !!dtbGetOwnerType(!weldRef.spref,|SPEC|).namn
         if(!memspec neq !specVal) then
          !isSpecSame = false
          break
         endif
        enddo
        if(!isSpecSame eq false) then
          !status = !!alert.confirm('The specs for the selected welds vary. Would you like to continue?')
          if(!status eq 'YES') then
            !specVal = 'Spec varies'
            !!pfmodifywelds.currspec = !specVal
            else
          !flagtocontinue = false
          endif
        endif
       endif
    if(!flagtocontinue eq 'YES') then
      if ((!wType eq !!pfWeldGapConfig.shopStype.val) OR (!wType eq !!pfWeldGapConfig.socketShopStype.val)) then
        !!pfmodifywelds.weldTypefrommainform = 'SHOP'
      elseif ((!wType eq !!pfWeldGapConfig.fieldStype.val) OR (!wType eq !!pfWeldGapConfig.socketFieldStype.val)) then
        !!pfmodifywelds.weldTypefrommainform = 'FIELD'
      elseif ((!wType eq !!pfWeldGapConfig.siteStype.val) OR (!wType eq !!pfWeldGapConfig.socketSiteStype.val)) then
        !!pfmodifywelds.weldTypefrommainform = 'SITE'
      endif

       !index = !!pfmodifywelds.machType.rText.findFirst(!firstWeldRef.weldType)

      if (!index.set()) then
        !!pfmodifywelds.machType.val = !index
      endif

      !!pfmodifywelds.weldList = !weldsToModify
      !!pfmodifywelds.ownerForm = !this

      show !!pfmodifywelds at xr0.5 yr0.3
    endif
  else
    !!alert.message('No proper weld element selected')
    return
  endif

endmethod
-- End of method
