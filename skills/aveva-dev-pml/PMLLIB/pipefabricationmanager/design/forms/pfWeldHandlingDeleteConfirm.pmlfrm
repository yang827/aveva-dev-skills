--
--  File:            pfWeldHandlingDeleteConfirm.pmlfrm
--    Type:          Form Definition
--    Group:         Pipe Fabrication
--      Keyword:     Pipe Fabrication
--    Module:        Design
--  Author:          D. Nolan
--  Created:         Mon January 11 14:44:51 2016
--
-- Description    Form to confirm delete of welds from the
--                weld handling form and whether or not to
--                include spool limits in the deletion
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  action()                         -                   Action triggered when form closes
--  caption(STRING)                  -                   Set question for user
--  close()                          -                   close form
--  confirm(STRING)                  -                   Callback for YES & NO buttons
--  initialise()                     -                   initialise
--  pfWeldHandlingDeleteConfirm()    -                   Constructor
------------------------------------------------------------------------

setup form !!pfWeldHandlingDeleteConfirm  blocking

  -- Default answer
  member .default      is STRING
  -- true if user pressed YES button. false for NO
  member .yesOrNo      is STRING

  member .removeAll is BOOLEAN

  para   .icon pixmap
  para   .question     at xmax.icon+3 ymin+0.5 text '' width 22 lines 3
  toggle .togIncludeSpoolLimits  at x2 ymax |Include Spool Limits| tagwidth 26
  -- OK and Cancel are not working in blocking forms
  button .yes          at x7 ymax+0.2          'Yes' width 7
  button .no           at xmax+1               'No'  width 7

exit
-- End of form definition for !!pfWeldHandlingDeleteConfirm
------------------------------------------------------------------------
--
-- Method:      pfWeldHandlingDeleteConfirm()
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
--
define method .pfWeldHandlingDeleteConfirm()

-- form setup
   !this.formTitle               = 'Confirm'
   !this.iconTitle               = 'Confirm'
   !this.cancelCall              = '!this.action()'
   !this.callback                = '!this.initialise()'
   !this.icon.addPixmap(!!pml.getPathname('qm35.png'))

   !this.yes.callback            = '!this.confirm(|YES|)'
   !this.no.callback             = '!this.confirm(|NO|)'
   !this.default                 = 'YES'

endmethod
-- End of method definition for .alertOnceConfirm()
------------------------------------------------------------------------
--
-- Method:      initialise()
--
-- Description: initialise
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

  !this.attribute(!this.default).setFocus()

  !this.togIncludeSpoolLimits.val = false
  !this.yesOrNo                   = 'NO'
  !this.removeAll                 = false

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:     confirm
--
-- Description: Callback for YES & NO buttons
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--   [1] [R]    [BOOLEAN]   [YES=true or NO=false]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .confirm(!yesOrNo is STRING)

  !this.yesOrNo  = !yesOrNo
  -- actioned by close form callback
  !this.close()

endmethod
-- End of method definition

define method .action()

  !!pfWeldHandling.deleteWelds(!this.removeAll)

endmethod

define method .caption( !caption is STRING)

  !this.question.val = !caption

endmethod

------------------------------------------------------------------------
--
-- Method:     close
--
-- Description: close form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()

!this.hide()

endmethod
-- End of method definition
