--  File:            pfweldgapcreatespecs.pmlfrm
--    Type:          Form Definition
--    Group:         Pipe Fabrication
--      Keyword:     PF
--    Module:        Design
--  Author:          Jaehun Choi(Daniel)
--  Created:         11 April 2014
--
--  Description:     create missing spec for weld gap
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   callback for applying
--  close()                          -                   callback for closing
--  initialise()                     -                   initialise form
--  pfweldgapcreatespecs()           -                   constructor
--
------------------------------------------------------------------------
--- form definition
setup form !!pfweldgapcreatespecs
  !this.formTitle  = 'Weld Gap Config'
  !this.initCall   = '!this.initialise()'
  !this.cancelCall = '!this.close()'

  para .description text 'Select spec(s) for weld gap'
  path down
  list .missedSpecList multiple width 30 height 20
  button .apply 'Apply'   callback |!this.apply()|
  path right
  button .dismiss 'Dismiss' at xmax form-size callback |!this.close()|

  member .missedSpecData is ARRAY
  member .storageRef     is DBREF
exit
------------------------------------------------------------------------
--
-- Method:      pfweldgapcreatespecs
-- Description: constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pfweldgapcreatespecs()
  !headings[1] = 'Spec. Name'
  !this.missedSpecList.setHeadings(!headings)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
-- Description: initialise form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()
  !dText = object ARRAY()
  do !specData values !this.missedSpecData
    !dText.append(!specData[2])
  enddo

  !this.missedSpecList.dText = !dText
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      apply
-- Description: callback for applying
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()
  !selection = !this.missedSpecList.selection()
  if (!selection.unset()) then
    !!alert.message('Select Spec')
    return
  endif

  if (!this.storageRef.badRef()) then
    !!alert.message('Invalid reference : ' & !this.storageRef.string())
    return
  endif

  !saveCe = !!ce

  !!ce = !this.storageRef

  do !selectedSpecName values !selection
    do !specData values !this.missedSpecData
      !weldGapData = !specData[1]
      !specName    = !specData[2]

      skip if (!specName ne !selectedSpecName)

      new APPLDA

      !name = !!ce.owner.flnm & !weldGapData.specName
      name $!name
      handle (41,12)
        write |Duplicate specification names exist in Catalogue. Please check Catalogue data $!<specName>|
        skip
      endhandle
      func |$!weldGapData.specName|

      !boreSize      = !weldGapData.boreSizeData
      !thicknessData = !weldGapData.wallThicknessData

      !currentUnits = object COMUNITS()
      !currentUnits.saveCurrentUnits()

      units mm bore
      units mm distance

      do !index index !boreSize
        !bore = !boreSize[!index]

        new DDSE
        handle any
          !!alert.error(!!error.text)

          !!ce = !saveCe
          handle any
          endhandle

          return
        endhandle

        !name = !!ce.owner.flnm & '/' & !bore.string()
        name $!name

        !insertBore = !bore.real().bore()
        number $!insertBore

        !wallThickness = !thicknessData[!index]

        new DDAT
        dTitle |$!wallThickness|

        Ddprop '0'
      enddo
      !currentUnits.restoreAllSavedUnits()
      end
    enddo
  enddo

  !!ce = !saveCe
  handle any
  endhandle

  !this.close()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      close
-- Description: callback for closing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()
  !this.hide()

  !!pfweldgapconfig.initialise()
  show !!pfweldgapconfig at xr0.5 yr0.3
endmethod
-- End of method
