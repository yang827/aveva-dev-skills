--
-- Description:    calculate signed angle between directions
--
--------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION   direction 1
--    2   R      DIRECTION   direction 2
--    3   R      DIRECTION   reference direction
-- Return:
--   [Data Type] [Description]
--    REAL        the signed angle between direction 1 and 2
--------------------------------------------------------------------------------
define function !!pfAngleBetweenDirsWithSign(!dir1 is DIRECTION, !dir2 is DIRECTION, !dir3 is DIRECTION) is REAL

  if (!dir1.unset() or !dir2.unset() or !dir3.unset()) then
    return 0degree
  endif

  !origin = object POSITION()
  !origin.east = 0
  !origin.north = 0
  !origin.up = 0
  !origin.origin = /*

  !pointVector = object POINTVECTOR(!origin, !dir3)
  !plane = !pointVector.plane()
  !planeDir = !plane.direction()

  if (!dir1.dot(!planeDir).abs() gt 0.999) then
    !d1 = !dir1
  else
    !d1 = !dir1.projected(!plane)
  endif

  if (!dir2.dot(!planeDir).abs() gt 0.999) then
    !d2 = !dir2
  else
    !d2 = !dir2.projected(!plane)
  endif

  !angle = !d1.angle(!d2)
  handle ANY
    return 90degree
  endhandle
  if !angle.eq(0degree) or !angle.eq(180degree) then
    return !angle
  endif

  !dotValue = !dir3.dot(!d1.cross(!d2))
  handle ANY
    return 90degree
  endhandle

  if !dotValue.lt(0) then
    !angle = !angle * -1
  endif

  return !angle


