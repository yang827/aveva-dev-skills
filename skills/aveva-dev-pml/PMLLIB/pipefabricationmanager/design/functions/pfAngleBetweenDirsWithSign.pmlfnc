--  if !length2.eq(0) then
--    return 90degree
--  endif
--
--  !length3 = SQRT(!d3.east * !d3.east + !d3.north * !d3.north + !d3.up * !d3.up)
--  if !length3.eq(0) then
--    return 90degree
--  endif
--
--  !dotValue = (!d1.east * !d2.east + !d1.north * !d2.north + !d1.up * !d2.up) / (!length1 * !length2)
--  if !dotValue.geq(1.0) then
--    return 0degree
--  endif
--
--  if !dotValue.leq(-1.0) then
--    return 180degree
--  endif
