--
--  Description:     calculate slanted end data
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       fTube reference
--
-- Return:
--   [Data Type] [Description]
--   ARRAY        Return to slanted end data
--   [1]          slanted angle (cutting angle)
--   [2]          slanted direction
--   [3]          rotate angle
--   [4]          standard direction as unit direction
--   [5]          slanted direction as unit direction
--
------------------------------------------------------------------------
-- Define function
define function !!pfCalculateSlantedEndData(!fTubeRef is DBREF) is ARRAY
--  !branchRef = !fTubeRef.owner
--  !members   = !branchRef.members

  !isStartMember = !fTubeRef.sequ eq 1

  !result = object ARRAY()

  !isDebugMode = false

--  -- get reference component
--  if (!isStartMember) then
--    !startIndex = 2
--    !endIndex   = !branchRef.mCount
--    !step       = 1
--  else
--    !startIndex = !branchRef.mCount - 1
--    !endIndex   = 1
--    !step       = -1
--  endif
--
--  !refComponent = object DBREF()
--  do !i from $!<startIndex> to $!<endIndex> by $!<step>
--    !entry = !members[!i]
--    skip if (!entry.hardType eq 'ATTA')
--
--    !volume = object VOLUME(!entry)
--    handle any
--      skip
--    endhandle
--
--    skip if (!volume.from.eq(!volume.to))
--
--    !refComponent = !entry
--    break
--  enddo

  !isStartMember = !fTubeRef.sequ eq 1
  if (!isStartMember) then
    !baseDir = !fTubeRef.aDir
  else
    !baseDir = !fTubeRef.lDir
  endif

  !centreLine = object LINE(!fTubeRef.pos, !fTubeRef.pos.offset(!fTubeRef.lDir, 100mm))

  !firstLength  = !fTubeRef.pos.distance(!centreLine.near(!fTubeRef.pPos[4]))
  !secondLength = !fTubeRef.pos.distance(!centreLine.near(!fTubeRef.pPos[5]))

  if (!firstLength lt !secondLength) then
    !startPoint = 5
    !endPoint   = 4
  else
    !startPoint = 4
    !endPoint   = 5
  endif

  !ori   = object ORIENTATION('Z is ' & !fTubeRef.aDir)
  !plane = object PLANE(!fTubeRef.pos, !ori)
  !slantedDir = !plane.near(!fTubeRef.pPos[!startPoint]).direction(!plane.near(!fTubeRef.pPos[!endPoint])).wrt(world)

  !orthogonalOri = object ORIENTATION('X is ' & !fTubeRef.aDir)
  !orthogonalPlane = object PLANE(!fTubeRef.pos, !orthogonalOri)
  !standardDir     = !orthogonalPlane.orientation.yDir().opposite()

  !cross = !standardDir.cross(!slantedDir)
  handle (2,891)
    !rotateAngle = 180
    !turnAngle   = 0
    !unitDir1  = !standardDir
    !unitDir2  = !standardDir
  elsehandle none
    !unitDir1  = !standardDir
    !unitDirLength = sqrt(pow(!standardDir.east,2) + pow(!standardDir.north,2) + pow(!standardDir.up,2))

    !unitDir1.east  = !unitDir1.east  / !unitDirLength
    !unitDir1.north = !unitDir1.north / !unitDirLength
    !unitDir1.up    = !unitDir1.up    / !unitDirLength

    !unitDir2 = !slantedDir
    !unitDirLength = sqrt(pow(!slantedDir.east,2) + pow(!slantedDir.north,2) + pow(!slantedDir.up,2))

    !unitDir2.east  = !unitDir2.east  / !unitDirLength
    !unitDir2.north = !unitDir2.north / !unitDirLength
    !unitDir2.up    = !unitDir2.up    / !unitDirLength

    !rotateAngle = !unitDir1.angle(!unitDir2)
    !turnAngle = !unitDir1.angle(!unitDir2.opposite())

    !isSameDir = !baseDir.string().before('WRT') eq !cross.string().before('WRT')
    if (!isSameDir) then
      !rotateAngle = 360 - !rotateAngle
      !turnAngle = !turnAngle * -1
    endif

    if (!isDebugMode) then
      pin1 at $!fTubeRef.pos
      pin1 dir $!unitDir1

      pin2 at $!fTubeRef.pos
      pin2 dir $!unitDir2
    endif
  endhandle

  !slantedAngle = !fTubeRef.desp[1].string('D0')

  !inclAngle    = 180 - !fTubeRef.desp[1]

  !slantedDir = !slantedDir.opposite()

  !result.append(!slantedAngle)
  !result.append(!slantedDir.string().before('WRT').replace(' ', ''))
  !result.append(!rotateAngle.string('D0'))
  !result.append(!inclAngle.string('D0'))
  !result.append(!turnAngle.string('D0'))
  !result.append(!unitDir1)
  !result.append(!unitDir2)

  if (!isDebugMode) then
    !dir = !slantedDir.string().before('WRT')
    write '[dir: $!dir]'
    write '[angle: $!rotateAngle]'
  endif

  return !result
endfunction
