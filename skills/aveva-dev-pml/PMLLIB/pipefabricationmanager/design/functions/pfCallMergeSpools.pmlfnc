-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!pfCallMergeSpools()
  if(!!module().productfamily.upCase() eq 'MARINE') then
    !moduleName = 'Outfitting'
  else
    !moduleName = 'Design'
  endif
  --!errorMessage = |Function currently unavailable. Please check Isodraft DB write access and ensure $!moduleName has R/W access to Isodraft via the Module Definitions in Admin|
  if (!!ce.dbType ne 'ISOD') then
    !errorMessage = |Cannot find an ISODRAFT database containing a writeable ISODEP - Please check Isodraft DB write access and ensure $!moduleName has R/W access to Isodraft via the Module Definitions in Admin|
    !isoDraftWorlds = !!collectAllFor('WORL', |dbType eq 'ISOD' AND dbWrite eq true|, world)
    if (!isoDraftWorlds.unset()) then
      !!alert.warning(!errorMessage)
      return
    endif
  else
    -- ce dbtype is ISOD
    !errorMessage = |Cannot find a writeable ISODRAFT database - Please check Isodraft DB write access and ensure $!moduleName has R/W access to Isodraft via the Module Definitions in Admin|
    if (!!ce.dbwrite.not()) then
      !!alert.warning(!errorMessage)
      return
    endif
  endif

  -- load form
  if (undefine(!!pfsplitmergespools)) then
    pml reload form !!pfsplitmergespools
  endif

  -- show form
  show !!pfsplitmergespools free at xr0.5 yr0.3
endfunction
