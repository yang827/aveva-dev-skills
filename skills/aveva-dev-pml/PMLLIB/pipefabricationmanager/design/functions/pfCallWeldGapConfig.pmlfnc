--  File:            pfCallWeldGapConfig.pmlfnc
--    Type:          Function Definition
--    Group:         Pipe Fabrication
--      Keyword:     PF
--    Module:        Design
--  Author:          Jaehun Choi(Daniel)
--  Created:         10 July 2013
--
--  Description:     call weld gap config form
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!pfCallWeldGapConfig()
  !saveCe = !!ce

  !weldConfigFunction  = 'WELD.GAP-CONFIG'
  !weldConfigName      = '/PFWeldGaps'

  if (undefined(!!pfweldgapconfig)) then
    pml load form !!pfweldgapconfig
  endif

  !pipeSpecList    = !!collectAllFor('SPEC',|purp eq 'PIPE'|, world)
  !pipeSpecNames   = !pipeSpecList.evaluate(object BLOCK(|!pipeSpecList[!evalIndex].name|))

  !weldGapDataList = object ARRAY()
  !unusedSpecNames = !!pfweldgapconfig.evaluateWeldGapTable(!pipeSpecNames, !weldGapDataList)

  if (!weldGapDataList.unset()) then
    !!alert.message('There is no valid weld gap')
    return
  endif

  if (!!pfweldgapconfig.errorList.set()) then
    do !errorMessage values !!pfweldgapconfig.errorList
      write '$!<errorMessage>'
    enddo
  endif

  !updateFormFlag = false
  !appldwRefs = !!collectAllFor('APPLDW', |FUNC EQ 'PipeFabrication'|, /* )
  if !appldwRefs.empty() then
    !!alert.error('No APPLDW defined for Pipe Fabrication! Please create one with FUNC=PipeFabrication.')
    return
  endif

  !missedSpecData = object ARRAY()
  !specNameList   = object ARRAY()
  !duplicatedSpec = object ARRAY()

  -- check APPDAR for weld gap config
  !weldApparRefs = !!collectAllFor('APPDAR', |FUNC EQ '$!<weldConfigFunction>'|, !appldwRefs[1] )
  if (!weldApparRefs.unset()) then
    !answer = !!alert.confirm('No APPDAR defined for Weld Gap Config. Do you want to create it?')
    if (!answer ne 'YES') then
      !!ce = !saveCe
      handle any
      endhandle

      return
    endif

    !!ce = !appldwRefs[1]

    NEW APPDAR
    handle any
      !!alert.confirm(!!error.text)

      !!ce = !saveCe
      handle any
      endhandle

      return
    endhandle

    name $!weldConfigName
    handle any
      !name = '/' & !!ce.refNo.string() & '$!<weldConfigName>'
      name $!name
    endhandle

    !weldApparRefs[1] = !!ce
    !updateFormFlag = true

    func '$!<weldConfigFunction>'

    do !weldGapData values !weldGapDataList
      !table = object ARRAY()
      !table.append(!weldGapData)
      !table.append(!weldGapData.specName)

      if (!specNameList.findFirst(!weldGapData.specName).set()) then
        !duplicatedSpec.append(!weldGapData.specName)
      else
        !specNameList.append(!weldGapData.specName)
        !missedSpecData.append(!table)
      endif
    enddo

  else
    -- check data partially
    do !i index !weldGapDataList
      !weldGapData = !weldGapDataList[!i]
      !specName    = !weldGapData.specName

      !existSpecFlag   = !!collectAllFor('APPLDA', |func eq '$!<specName>'|, !weldApparRefs[1]).set()

      skip if (!existSpecFlag)

      !table = object ARRAY()
      !table.append(!weldGapData)
      !table.append(!specName)

      if (!specNameList.findFirst(!weldGapData.specName).set()) then
        !duplicatedSpec.append(!weldGapData.specName)
      else
        !specNameList.append(!weldGapData.specName)
        !missedSpecData.append(!table)
      endif
    enddo
  endif

  !checkDBwrite = object COMCHECKDBWRITE()
  !checkDBwrite.showAlert = true
  !isValidPermission = !checkDBwrite.checkDBwrite(!weldApparRefs[1])

  if (!missedSpecData.set() and !isValidPermission) then
    if (!duplicatedSpec.set()) then
      !duplicatedSpec.unique()
      !duplicatedSpecNames = ''
      do !tempName values !duplicatedSpec
        !duplicatedSpecNames = !duplicatedSpecNames & !tempName & ' '
      enddo

      !!alert.message('Duplicate specification names exist in Catalogue. Please check Catalogue data ' & !duplicatedSpecNames)
    endif

    !createMissingSpec = !!alert.confirm('Do you wish to create missing specs?') eq 'YES'
    if (!createMissingSpec) then
      if (undefined(!!pfWeldGapCreateSpecs)) then
        pml load form !!pfWeldGapCreateSpecs
      endif

      !!pfWeldGapCreateSpecs.missedSpecData = !missedSpecData
      !!pfWeldGapCreateSpecs.storageRef     = !weldApparRefs[1]

      show !!pfWeldGapCreateSpecs at xr0.5 yr0.45
    else
      !missedSpecData = object ARRAY()
    endif
  endif

  !!ce = !saveCe
  handle any
  endhandle

  if (!updateFormFlag) then
    !!pfweldgapconfig.initialise()
  endif

  if (!missedSpecData.unset()) then
    show !!pfweldgapconfig at xr0.5 yr0.3
  endif
endmethod
