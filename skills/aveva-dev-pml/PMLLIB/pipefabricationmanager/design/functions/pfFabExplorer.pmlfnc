-- Define function
define function !!pffabexplorer()
  if(!!module().productfamily.upCase() eq 'MARINE') then
    !addInName = 'OutfittingAddins.xml'
  else
    !addInName = 'DesignAddins.xml'
  endif

  !errorMessage = |Failed to display FABRICATION EXPLORER. "PipeFabricationAddin" should be assigned on "| & !addInName &  | and Check module definition on ADMIN"|

  import 'PipeFabricationAddin'
  handle any
  endhandle

  using namespace 'Aveva.Pdms.PipeFabrication.FabricationExplorer'

  !fabExplorer = object PFFABRICATIONEXPLORERPML()
  handle (46,87)
    !!alert.error(!errorMessage)
    return
  endhandle

  if (!!appDesMain.explorersMenu.selected('Fabrication Explorer')) then
    !fabExplorer.show()
    handle any
      !!alert.error(!errorMessage)
      return
    endhandle
  else
    !fabExplorer.hide()
    handle any
      !!alert.error(!errorMessage)
      return
    endhandle
  endif
endfunction
