--
--
-- Description:    return the data for columns in the form !!pfSpoolAttributes
--
--------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY       array of column data
--                [ [1 : the attribute name,
--                   2 : the column title,
--                   3 : array for value list or function name], ...]
--
--------------------------------------------------------------------------------
define function !!pfGetColumnsForSpool() is ARRAY

  !columns = object ARRAY()
  !columns[1] = object ARRAY()    $* attribute
  !columns[2] = object ARRAY()    $* title
  !columns[3] = object ARRAY()    $* value list


  !columns[1].append('NAME')
  !columns[2].append('Name')
  !columns[3].append('')

  !columns[1].append('DESC')
  !columns[2].append('Description')
  !columns[3].append('')

  !columns[1].append('NWEI')
  !columns[2].append('Weight')
  !columns[3].append('0')

  !columns[1].append('PLANU')
  !columns[2].append('Planning Unit')
  !columns[3].append('')

  -- spool type
  !columns[1].append('PSTYP')
  !columns[2].append('Spool Type')

  !spoolTypes = object ARRAY()
  !spoolTypes.append('SHOP')
  !spoolTypes.append('FITT')
  !spoolTypes.append('SITE')
  !columns[3].append(!spoolTypes)

  -- note
--  !columns[1].append(':NOTE')
--  !columns[2].append('Note')
--  !columns[3].append('')

  -- insert a new column for 'ship class'
  -- UDA name
  !columns[1].append(':CLASS')

  -- display name
  !columns[2].append('Class')

  -- value list
  !classList = object ARRAY()
  !classList.append('ABS')
  !classList.append('BV')
  !classList.append('GL')
  !classList.append('KR')
  !classList.append('LR')
  !classList.append('RINA')
  !classList.append('RS')
  !columns[3].append(!classList)

  -- bending machine
--  !columns[1].append(':BENDMC')
--  !columns[2].append('Bending Machine')
--  !columns[3].append('')
--
--
--  !columns[1].append(':BENDCON')
--  !columns[2].append('Bending Condition')
--  !columns[3].append('')

  !columns[1].append(':PIECETYPE')
  !columns[2].append('Piece Type')
  !columns[3].append('')

  -- installation information
  !columns[1].append(':INST')
  !columns[2].append('Install Info.')
  !columns[3].append('')

--  !columns[1].append(':SHOPTEST')
--  !columns[2].append('Shop Test')
--  !columns[3].append('')

--  !columns[1].append(':PAINT')
--  !columns[2].append('Paint Code')
--  !columns[3].append('')

--  !columns[1].append(':TREAT')
--  !columns[2].append('Treatment')
--  !columns[3].append('')

  !columns[1].append(':GALV')
  !columns[2].append('Galv.')
  !columns[3].append('')

--  !columns[1].append(':PENE')
--  !columns[2].append('Penetration')
--  !columns[3].append('')

  !columns[1].append(':REVNO')
  !columns[2].append('Revision No.')
  !columns[3].append('')

  !columns[1].append(':STAGE')
  !columns[2].append('Install Stage')
  !columns[3].append('')

  -- insert a new column for 'BLOCK'
  -- UDA
  !columns[1].append(':BLOCK')
  -- Display Name
  !columns[2].append('Block')
  -- Function to create value list
  !columns[3].append(|!!pfGetValueListForSpool(':BLOCK')|)

  return !columns

endfunction
