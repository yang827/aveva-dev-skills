--
--  File:            pfGetExcessComponents.pmlfnc
--  Author:          David Nolan
--  Created:         10/05/2016
--
--  Description:  Determine if the components the welds are for are loose and if so return the dbrefs of the loose components.
--
------------------------------------------------------------------------
define function !!pfGetExcessComponents(!arriveBoundary is DBREF, !leaveBoundary is DBREF)

  if(!arriveBoundary.type eq 'WELD') then
    if((!arriveBoundary.order eq 1) OR (!arriveBoundary.order eq !arriveBoundary.owner.members.size())) then
      !order = !arriveBoundary.order
    else
      !order = !arriveBoundary.order - 1
    endif

    !arriveComponent = !arriveBoundary.owner.members[!order]

    if(!arriveComponent.loose) then
      !arriveBoundary = !arriveComponent
    endif

  endif

  if(!leaveBoundary.type eq 'WELD') then
    if((!leaveBoundary.order eq 1) OR (!leaveBoundary.order eq !leaveBoundary.owner.members.size())) then
      !order = !leaveBoundary.order
    else
      !order = !leaveBoundary.order + 1
    endif
    !leaveComponent = !leaveBoundary.owner.members[!order]

    if(!leaveComponent.loose) then
      !leaveBoundary = !leaveComponent
    endif

  endif

endfunction
