-- File:            pfGetExtrusionCollarHeight.pmlfnc
--   Type:          Function Definition
--   Group:         Pipe Fabrication
--     Keyword:     PF
--   Module:        Design
--   Replaces:
--
-- Author:          DoHyoung Kim(Bright)
-- Created:         Monday 11st June 2012
--
--
-- Description:     return extrusion collar height of the given connection
--
--------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type]             [Description]
--    1   R      PIPESTUBINCONNECTION    connection object
-- Return:
--   [Data Type] [Description]
--    REAL        extrusion collar height defined by the given connection object
--------------------------------------------------------------------------------
define function !!pfGetExtrusionCollarHeight(!connection is PIPESTUBINCONNECTION) is REAL

  -- return if the connection type is not 'extrusion'
  if !connection.componentType.neq('SEX') then
    return object REAL()
  endif

  -- get main/branch outside diameter, wall thickness, material reference
  !mainOD = !connection.mainTubeOD
  !wallThickness = !connection.wallThickness
  !branchOD = !connection.stubInTubeOD
  !matRef = object DBREF()
  !branRef = object DBREF()

  !component = !connection.insertComponent
  if !component.badref().not() then
    !tubeSpref = object DBREF()
    if !component.type.eq('BRAN') then
      !branRef = !component
      !tubeSpref = !component.hstube
    elseif !component.owner.type.eq('BRAN') then
      !branRef = !component.owner
      !tubeSpref = !component.lstube
    endif

    if !tubeSpref.badref().not() then
      !matRef = !tubeSpref.matxt
      if !matRef.badref() then
        !matRef = !tubeSpref.matRef
      endif
    endif
  endif

  if !branRef.badref() then
    return object REAL()
  endif

  -- get bending machine reference
  !bendMacRef = !branRef.bendMacReference
  if !bendMacRef.badref() then
    !pipeRef = !branRef.owner
    !bendMacRef = !pipeRef.bendMacReference
    if !bendMacRef.badref() then
      !zoneRef = !pipeRef.owner
      !bendMacRef = !zoneRef.bendMacReference
    endif
  endif

  if !bendMacRef.badref() then
    return object REAL()
  endif

  -- find extrusion dimensions for the given connection

  !fmedimRefs = object ARRAY()

  -- 1. mainOD & wallThickness & materialRef & branchOD
  if !matRef.set() then
    !filter = 'OD EQ ' + !mainOD.string() + ' AND WTHICKNESS EQ ' + !wallThickness.string() + ' AND MATREF EQ ' + !matRef.string() + ' AND EXTBOD EQ ' + !branchOD.string()
    !fmedimRefs = !!collectAllFor('FMEDIM', !filter,  !bendMacRef)
  endif

  -- 2. mainOD & wallThickness & unset & branchOD
  if !fmedimRefs.empty() then
    !filter = 'OD EQ ' + !mainOD.string() + ' AND WTHICKNESS EQ ' + !wallThickness.string() + ' AND UNSET(MATREF) AND EXTBOD EQ ' + !branchOD.string()
    !fmedimRefs = !!collectAllFor('FMEDIM', !filter,  !bendMacRef)
  endif

  -- 3. mainOD & 0mm & materialRef & branchOD
  if !fmedimRefs.empty() and !matRef.set() then
    !filter = 'OD EQ ' + !mainOD.string() + ' AND WTHICKNESS EQ 0mm AND MATREF EQ ' + !matRef.string() + ' AND EXTBOD EQ ' + !branchOD.string()
    !fmedimRefs = !!collectAllFor('FMEDIM', !filter,  !bendMacRef)
  endif

  -- 4. mainOD & 0mm & unset & branchOD
  if !fmedimRefs.empty() then
    !filter = 'OD EQ ' + !mainOD.string() + ' AND WTHICKNESS EQ 0mm AND UNSET(MATREF) AND EXTBOD EQ ' + !branchOD.string()
    !fmedimRefs = !!collectAllFor('FMEDIM', !filter,  !bendMacRef)
  endif

  -- 5. mainOD & 0mm & unset & 0mm
  if !fmedimRefs.empty() then
    !filter = 'OD EQ ' + !mainOD.string() + ' AND WTHICKNESS EQ 0mm AND UNSET(MATREF) AND EXTBOD EQ 0mm'
    !fmedimRefs = !!collectAllFor('FMEDIM', !filter,  !bendMacRef)
  endif

  -- 6. 0mm & 0mm & unset & 0mm
  if !fmedimRefs.empty() then
    !filter = 'OD EQ 0mm AND WTHICKNESS EQ 0mm AND UNSET(MATREF) AND EXTBOD EQ 0mm'
    !fmedimRefs = !!collectAllFor('FMEDIM', !filter,  !bendMacRef)
  endif

  if !fmedimRefs.empty() then
    return object REAL()
  endif

  return !fmedimRefs[1].exteah

endfunction
