-- File:            pfGetTubeParts.pmlfnc
--   Type:          Function Definition
--   Group:         Pipe Fabrication
--     Keyword:     PF
--   Module:        Common
--   Replaces:
--
-- Author:          DoHyoung Kim(Bright)
-- Created:         Wednesday 7th December 2011
--
--
-- Description:    return all tube parts included the given part reference
--
--------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       part ref (bran or component)
--    2   R      BOOLEAN     if true, attachments are included \
--    3   RW     ARRAY       result tube parts (return value)
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define function !!pfGetTubeParts(!partRef is DBREF, !arriveBoundary is DBREF, !leaveBoundary is DBREF, !tubeParts is ARRAY)

  !arriveBoundary = object DBREF()
  !leaveBoundary = object DBREF()
  !tubeParts.clear()

  !partType = !partRef.type

  !index = object REAL()
  if !partType.eq('BRAN') then
    !branRef = !partRef
    !index = 1
  else
    !branRef = !partRef.owner
  endif

  -- get all members of the branch
  !memberRefs = !!collectAllFor('BRAN MEM', '', !branRef)
  if !memberRefs.empty() then
    return
  endif

  -- find index of the given part
  if !index.unset() then
    !index = !memberRefs.findFirst(!partRef)
    if !index.unset() then
      return
    endif
  endif

  -- get arrive boundary component
  do !i from !index to 1 by -1

    !memberRef  = !memberRefs[!i]
    !memberType = !memberRef.type

    if !memberType.eq('TUBI') then
      !length = !memberRef.itlen
      handle ANY
        !length = 0mm
      endhandle

      if !length.gt(0mm) then
        !tubeParts.append(!memberRef)
      endif

    elseif !memberType.eq('BEND') then

      if !memberRef.shop then
        !ncuts = !memberRef.actNCuts
        if !ncuts.gt(0) then
          !arriveBoundary = !memberRef
          break
        else
          !tubeParts.append(!memberRef)
        endif
      else
        !arriveBoundary = !memberRef
        break
      endif

    elseif !memberType.eq('ATTA') then
       !spkbrk = !memberRef.spkbrk
      if !spkbrk then
        !arriveBoundary = !memberRef
        break
      else
        !tubeParts.append(!memberRef)
      endif
    elseif !memberRef.shop.not() then
      !arriveBoundary = !memberRef
      break

    elseif !memberType.eq('FTUB') then
      !skey = !memberRef.skey
      if !skey.set() and !skey.eq('TUBE') then
        !tubeParts.append(!memberRef)
      else
        !arriveBoundary = !memberRef
        break
      endif

    else
      !lOffline = !memberRef.lOffline
      handle ANY
        !lOffline = false
      endhandle

      if !lOffline then
        !tubeParts.append(!memberRef)
      else
        !arriveBoundary = !memberRef
        break
      endif
    endif
  enddo

  if !arriveBoundary.unset() then
    !arriveBoundary = !branRef
  endif

  !tubeParts = !tubeParts.invert()

  -- get leave boundary component
  !memberCount = !memberRefs.size()
  do !i from !index + 1 to !memberCount

    !memberRef  = !memberRefs[!i]
    !memberType = !memberRef.type

    if !memberType.eq('TUBI') then
      !length = !memberRef.itlen
      handle ANY
        !length = 0mm
      endhandle

      if !length.gt(0mm) then
        !tubeParts.append(!memberRef)
      endif

    elseif !memberType.eq('BEND') then

      if !memberRef.shop then
        !ncuts = !memberRef.actNCuts
        if !ncuts.gt(0) then
          !leaveBoundary = !memberRef
          break
        else
          !tubeParts.append(!memberRef)
        endif
      else
        !leaveBoundary = !memberRef
        break
      endif

    elseif !memberType.eq('ATTA') then
       !spkbrk = !memberRef.spkbrk
      if !spkbrk then
        !leaveBoundary = !memberRef
        break
      else
        !tubeParts.append(!memberRef)
      endif
    elseif !memberRef.shop.not() then
      !leaveBoundary = !memberRef
      break

    elseif !memberType.eq('FTUB') then
      !skey = !memberRef.skey
      if !skey.set() and !skey.eq('TUBE') then
        !tubeParts.append(!memberRef)
      else
        !leaveBoundary = !memberRef
        break
      endif

    else
      !lOffline = !memberRef.lOffline
      handle ANY
        -- the component does not have the attribute 'lOffline'
        !lOffline = false
      endhandle

      if !lOffline then
        !tubeParts.append(!memberRef)
      else
        !leaveBoundary = !memberRef
        break
      endif
    endif
  enddo

  if !leaveBoundary.unset() then
    !leaveBoundary = !branRef
  endif

endmethod
