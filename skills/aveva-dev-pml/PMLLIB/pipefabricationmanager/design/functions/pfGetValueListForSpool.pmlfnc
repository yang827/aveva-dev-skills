--
-- Description:    sample.
--                 return the value list for columns in the form !!pfSpoolAttributes
--
--------------------------------------------------------------------------------
--
-- Function Type:   Function
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      attribute name
-- Return:
--   [Data Type] [Description]
--    ARRAY       value list
--
--------------------------------------------------------------------------------
define function !!pfGetValueListForSpool(!attName is STRING) is ARRAY

  !valueList = object ARRAY()

  if !attName.eq(':BLOCK') then

    !world = /*

    do !member values !world.members
      if !member.type.eq('BLOCK') then
        !valueList.append(!member.namn)
      endif
    enddo

  endif

  return !valueList

endfunction
