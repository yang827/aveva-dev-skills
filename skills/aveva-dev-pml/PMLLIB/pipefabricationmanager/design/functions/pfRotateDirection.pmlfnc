--
-- Description:    rotate a direction with the given angle and reference direction
--
--------------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DIRECTION   direction to be rotated
--    2   R      REAL        angle
--    3   R      DIRECTION   reference direction
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define function !!pfRotateDirection(!dir1 is DIRECTION, !angle is REAL, !dir2 is DIRECTION)

--  !c1 = COS(!angle)
--
--  !dir1 = !dir1.wrt( /* )
--  !dir2 = !dir2.wrt( /* )
--
--  !length = SQRT(!dir2.east * !dir2.east + !dir2.north * !dir2.north + !dir2.up * !dir2.up)
--  if !length.eq(0) then
--    !dir1.east = 0
--    !dir1.north = 0
--    !dir1.up = 0
--  else
--    !dir2.east = !dir2.east / !length
--    !dir2.north = !dir2.north / !length
--    !dir2.up = !dir2.up / !length
--
--    !c2 = (1.0 - !c1) * !dir1.dot(!dir2)
--    !c3 = SIN(!angle)
--
--    !x = !c1 * !dir1.east + !c2 * !dir2.east + !c3 * (!dir2.north * !dir1.up - !dir2.up * !dir1.north)
--    !y = !c1 * !dir1.north + !c2 * !dir2.north + !c3 * (!dir2.up * !dir1.east - !dir2.east * !dir1.up)
--    !z = !c1 * !dir1.up + !c2 * !dir2.up + !c3 * (!dir2.east * !dir1.north - !dir2.north * !dir1.east)
--
--    !dir1.east = !x
--    !dir1.north = !y
--    !dir1.up = !z
--  endif

    !dir1 = !dir1.wrt( /* )
    !dir2 = !dir2.wrt( /* )

    !x1 = !dir1.east
    !y1 = !dir1.north
    !z1 = !dir1.up

    !x2 = !dir2.east
    !y2 = !dir2.north
    !z2 = !dir2.up

    !len2 = SQRT(!x2 * !x2 + !y2 * !y2 + !z2 * !z2)
    if !len2.eq(0) then
      !dir1.east = 0
      !dir1.north = 0
      !dir1.up = 0
      return
    endif

    !x2 = !x2 / !len2
    !y2 = !y2 / !len2
    !z2 = !z2 / !len2

    !dot = !x1 * !x2 + !y1 * !y2 + !z1 * !z2

    !c1 = COS(!angle)
    !c2 = (1.0 - !c1) * !dot
    !c3 = SIN(!angle)

    !x = !c1 * !x1 + !c2 * !x2 + !c3 * (!y2 * !z1 - !z2 * !y1)
    !y = !c1 * !y1 + !c2 * !y2 + !c3 * (!z2 * !x1 - !x2 * !z1)
    !z = !c1 * !z1 + !c2 * !z2 + !c3 * (!x2 * !y1 - !y2 * !x1)

    !dir1.east = !x
    !dir1.north = !y
    !dir1.up = !z

endfunction
