--
--
-- Description:    rotate a position with the given angle, origin and reference direction
--
--------------------------------------------------------------------------------
--
-- Function Type:   Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      POSITION    position to be rotated
--    2   R      REAL        angle
--    3   R      POSITION    origin position
--    4   R      DIRECTION   reference direction
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define function !!pfRotatePosition(!pos is POSITION, !angle is REAL, !origin is POSITION, !dir is DIRECTION)

  --!dir = !dir.wrt( /* )

  --!length = SQRT(!dir.east * !dir.east + !dir.north * !dir.north + !dir.up * !dir.up)
  --if !length.eq(0) then
  --  !pos.east = 0
  --  !pos.north = 0
  --  !pos.up = 0
  --else

--    !ux = !dir.east / !length
--    !uy = !dir.north / !length
--    !uz = !dir.up / !length

    !ux = !dir.east
    !uy = !dir.north
    !uz = !dir.up

    --!pos = !pos.wrt( /* )
    --!origin = !origin.wrt( /* )

    !dx = !pos.east - !origin.east
    !dy = !pos.north - !origin.north
    !dz = !pos.up - !origin.up

    !dot = !dx * !ux + !dy * !uy + !dz * !uz

    !c1 = COS(!angle)
    !c2 = (1.0 - !c1) * !dot
    !c3 = SIN(!angle)

    !x = !c1 * !dx + !c2 * !ux + !c3 * (!uy * !dz - !uz * !dy)
    !y = !c1 * !dy + !c2 * !uy + !c3 * (!uz * !dx - !ux * !dz)
    !z = !c1 * !dz + !c2 * !uz + !c3 * (!ux * !dy - !uy * !dx)

    !pos.east = !x + !origin.east
    !pos.north = !y + !origin.north
    !pos.up = !z + !origin.up

  --endif

endfunction
