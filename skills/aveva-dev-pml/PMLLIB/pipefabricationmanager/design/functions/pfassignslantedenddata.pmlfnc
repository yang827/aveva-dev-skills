--  Created:         21 October 2014
--
--  Description:     assign slanted data into pipe end
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!pfassignslantedenddata()
  if (undefined(!!pfFabricationPipeEnd)) then
    pml load form !!pfFabricationPipeEnd
  endif

  !isValidType = !!ce.hardType eq 'FTUB' and !!ce.compType eq 'SEND'
  handle any
    !isValidType = false
  endhandle

  if (!isValidType.not()) then
    return
  endif

  if (!!ce.dbWrite.not()) then
    return
  endif

  !slantedData = !!pfCalculateSlantedEndData(!!ce)

  if (!!pfFabricationPipeEnd.note.val.occurs('{deg}') gt 0) then
    !insertNote = '[$!slantedData[2]]' & !!pfFabricationPipeEnd.note.val.replace('{deg}', !slantedData[1]) & 'deg'
  else
    !insertNote = '[$!slantedData[2]]' & !!pfFabricationPipeEnd.slantedEndNote.replace('{deg}', !slantedData[1]) & 'deg'
  endif

  !!ce.matn = |$!insertNote|
  handle any
  endhandle
endfunction
