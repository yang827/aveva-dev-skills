-- Define function
define function !!pfcallconsistencycheck()
  if (undefined(!!pfConsistencyCheck)) then
    pml load form !!pfConsistencyCheck
  endif

  show !!pfConsistencyCheck at xr0.5 yr0.45
endmethod
