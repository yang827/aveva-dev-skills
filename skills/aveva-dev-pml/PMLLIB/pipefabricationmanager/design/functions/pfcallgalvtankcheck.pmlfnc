-- Define function
define function !!pfcallgalvtankcheck()
  if (undefined(!!pfGalvanizationTankCheck)) then
    pml load form !!pfGalvanizationTankCheck
  endif

  show !!pfGalvanizationTankCheck at xr0.5 yr0.45
endmethod
