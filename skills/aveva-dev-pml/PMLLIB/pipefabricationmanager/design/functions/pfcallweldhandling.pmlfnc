-- Define function
define function !!pfcallweldhandling()
  !weldControlObject = object PFWELDCONTROL()
  if (!weldControlObject.weldGapSpecRef.badRef()) then
    return
  endif

  if (undefined(!!pfWeldHandling)) then
    pml reload form !!pfWeldHandling
  endif

  show !!pfWeldHandling
endmethod
