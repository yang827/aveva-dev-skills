--
--  Description:     set production check option
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!pipeSetProductionCheckOption()
  if (defined(!!productionChecksEnabled)) then
    return
  endif

  -- default value of "production check enabled" is true
  !!productionChecksEnabled = true

  -- define variable for activating "production check form"
  var !productionChecksEnabledValue evar PRODUCTIONCHECKSENABLED
  if (not !productionChecksEnabledValue.empty()) then
    !!productionChecksEnabled = object BOOLEAN(!productionChecksEnabledValue)
    handle (2,775)
    endhandle
  endif
endfunction
