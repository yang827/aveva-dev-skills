------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !!pipeSetProductionCheckOption()

  if !!productionChecksEnabled then
    return
  endif

  !bmenu = object APPBARMENU()
  !bmenu.add('Pipe Fabrication', 'PIPEFABRICATION')
  !!appMenuCntrl.addBarMenu(!bmenu, 'PIPE')

  !menu = object APPMENU('PIPEFABRICATION')
  !menu.add('MENU', 'Modelling',          'PFMODELLING')
  !menu.add('MENU', 'Spooling & Checks',  'PFSPOOLING')
  !menu.add('MENU', 'Drawings',           'PFDRAWING')
  !menu.add('MENU', 'Export Fabrication Data',   'PFPRODDATA')
  !menu.add('MENU', 'Configuration',      'PFCONFIG')

--  var !team team
--  !teams = !team.split()
--  !isDesAdmin = !teams.findFirst('FABADMIN').set()
--  !menu.menu.setFieldProperty('Configuration', 'ACTIVE', !isDesAdmin)

  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  !menu = object APPMENU('PFCONFIG')
  !menu.add('FORM', 'Fabrication Machine Manager...', 'pfFabMachineMgr')
  !menu.add('FORM', 'Optimization Criteria for Bending & Welding...', 'pfOptimizationPriorities')
  !menu.add('FORM', 'Galvanization Tank Volume...', 'pfGalvanizationTankConfig')
  !menu.add('CALLBACK', 'Weld Gap...', '!!pfCallWeldGapConfig()')
  !menu.add('FORM', 'Modelling Consistency Check...', 'pfConsistencyCheckConfig')
  !menu.add('FORM', 'Threaded Ends...', 'pfThreadEngagementConfig')
  !menu.add('FORM', 'Defaults...', 'pfDefaults')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')


  !menu = object APPMENU('PFMODELLING')
  !menu.add('FORM', 'Assign Bending Machine...', 'pfAssignBendingMachine')
  !menu.add('FORM', 'Fabricated Pipe Ends...', 'pfFabricationPipeEnd')
  !menu.add('CALLBACK', 'Modelling Consistency Check...',  '!!pfcallconsistencycheck()')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  !menu = object APPMENU('PFSPOOLING')
  !menu.add('CALLBACK', 'Weld Handling...',         '!!pfCallWeldHandling()')
  !menu.add('FORM', 'Modify Spool...',          'pfModifySpool')
  !menu.add('FORM', 'Additional Spool Attributes...', 'pfSpoolAttributes')
  !menu.add('FORM', 'Fabrication Check...',             'pfFabricationCheck')
  !menu.add('CALLBACK', 'Galvanization Tank Check...',    '!!pfcallgalvtankcheck()')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  !menu = object APPMENU('PFDRAWING')
  !menu.add('CALLBACK', 'Spool Drawings...',          |!!pfPipeSpoolDrawing()|)
  !menu.add('CALLBACK', 'Fabrication Isometrics...',  |!!pfIsoDrawing('FAB')|)
  !menu.add('CALLBACK', 'Installation Isometrics...', |!!pfIsoDrawing('EREC')|)
--  !menu.add('FORM', 'Define Spool Type for Isometrics...', |pfPipeIsometricDrawing|)

--  !menu.add('CALLBACK', 'Fabrication Isometrics...',  |!!pfCreateIsoDrawing('FAB')|)
--  !menu.add('CALLBACK', 'Installation Isometrics...', |!!pfCreateIsoDrawing('EREC')|)
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

  !menu = object APPMENU('PFPRODDATA')
  -- Issue 95185(SI-56537)
  -- !menu.add('CALLBACK', 'Pipe Workshop Information...',   '!!alert.message(|Not implemented yet!|)')
  !menu.add('FORM',   'Fabrication NC Data...',   'pfFabricationNCData')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')

endmethod
-- End of method definition for .modifyMenus()
