--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  pfAssemblyActivity(STRING,DBREF) -                   constructor
--
--------------------------------------------------------------------------------
define object PFASSEMBLYACTIVITY


  member  .activityType             is STRING

  member  .component                is DBREF

  member  .rotation                 is REAL

  member  .inclination              is REAL

  member  .turning                  is REAL

  member  .referencePlaneComponent  is DBREF

  member  .remarks                  is ARRAY

endobject


--------------------------------------------------------------------------------
--
-- Method:      pfAssemblyActivity
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      activity type
--    2   R      DBREF       component reference
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfAssemblyActivity(!activityType is STRING, !component is DBREF)

  !this.activityType = !activityType
  !this.component = !component

endmethod


