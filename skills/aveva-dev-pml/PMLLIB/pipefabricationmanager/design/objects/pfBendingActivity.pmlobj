--
-- Description:     object for bending activity
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  pfBendingActivity()              -                   constructor
--  pfBendingActivity(REAL,REAL,REAL) -                   constructor with feed, rotate and bend
--
--------------------------------------------------------------------------------
define object PFBENDINGACTIVITY

  member  .feed         is REAL

  member  .rotate       is REAL

  member  .bend         is REAL

endobject

--------------------------------------------------------------------------------
--
-- Method:      pfBendingActivity
--
-- Description: constructor, all values are initialized with 0
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfBendingActivity()

  !this.feed = 0mm
  !this.rotate = 0degree
  !this.bend = 0degree

endmethod

--------------------------------------------------------------------------------
--
-- Method:      pfBendingActivity
--
-- Description: constructor with feed, rotate and bend
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      REAL        feed length
--    2    R      REAL        rotation angle
--    3    R      REAL        bending angle
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfBendingActivity(!feed is REAL, !rotate is REAL, !bend is REAL)

  !this.feed = !feed
  !this.rotate = !rotate
  !this.bend = !bend

endmethod
