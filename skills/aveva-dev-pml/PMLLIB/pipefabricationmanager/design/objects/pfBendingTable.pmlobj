-- Description:     object for bending table
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  pfBendingTable()                 -                   constructor
--
--------------------------------------------------------------------------------
define object PFBENDINGTABLE

  -- pipe piece reference
  member  .pipePiece            is DBREF

  -- bending machine reference
  member  .bendingMachine       is DBREF

  -- length outside machine
  member  .lengthOutsideMachine is REAL

  -- length inside machine
  member  .lengthInsideMachine  is REAL

  -- bending activities
  member  .activities           is ARRAY

  -- information of bending elements
  member  .bendingElementsInfo  is ARRAY
endobject

--------------------------------------------------------------------------------
--
-- Method:      pfBendingTable
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfBendingTable()
  !this.lengthOutsideMachine = 0mm
  !this.lengthInsideMachine = 0mm
endmethod
