--
-- Description:     object for checking branch consistency
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  check(DBREF,ARRAY)               -                   check branch consistency by running CHECK
--  initialize()                     -                   initialize this object
--
--------------------------------------------------------------------------------
define object PFBRANCHECK
  -- no members
endobject

--------------------------------------------------------------------------------
--
-- Method:      initialize
--
-- Description: not used in this object
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--
-- Return:
--   [Data Type]             [Description]
--
--------------------------------------------------------------------------------
define method .initialize()
  -- no operation
endmethod

--------------------------------------------------------------------------------
--
-- Method:      check
--
-- Description: check branch consistency by running CHECK
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       target branch element
--    2   RW     ARRAY       check results
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .check(!targetRef is DBREF, !results is ARRAY)
  !pfConsistencyCheckObject = object PFPIPECONSISTENCYCHECK()

  !fullCheck   = true
  if (defined(!!pfConsistencyCheck)) then
    !fullCheck = !!pfConsistencyCheck.togCheckFull.val
  endif

  !checkResult = !pfConsistencyCheckObject.check(!targetRef, !fullCheck)
  if (!checkResult.not()) then
    !results.append(object PFBRANCHECKRESULT(!targetRef))
  endif
endmethod
