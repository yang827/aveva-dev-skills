--------------------------------------------------------------------------------
--
-- Method:      display
--
-- Description: display check result in 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .display()
  !!ce = !this.branRef

  !memberRefs = !!collectAllFor('BRAN MEM', '', !this.branRef)
  do !memberRef values !memberRefs
    ENHANCE $!memberRef COLOUR $!!gphColOpt.highlight
  enddo

  !this.zoom(!this.branRef)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getMessage
--
-- Description: return detail check result string
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    STRING      detail check result string
--------------------------------------------------------------------------------
define method .getMessage() is STRING

  --if defined(!this.errorMessages[!this.errorCode]) then
  --  return !this.errorMessages[!this.errorCode]
  --endif
  --return 'Unknown : ' + !this.errorCode.string()

  return 'Data Consistency Check failed. Refer to the result of CHECK CE'

endmethod

