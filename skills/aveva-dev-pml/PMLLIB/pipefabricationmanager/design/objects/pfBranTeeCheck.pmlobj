--
-- Description:     check unconnected tee or olet components
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  check(DBREF,ARRAY)               -                   check unconnected tee or olet components
--  initialize()                     -                   initialize this object
--
--------------------------------------------------------------------------------
define object PFBRANTEECHECK
  -- no members
endobject

--------------------------------------------------------------------------------
--
-- Method:      initialize
--
-- Description: not used in this object
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--
-- Return:
--   [Data Type]             [Description]
--
--------------------------------------------------------------------------------
define method .initialize()
  -- no operation
endmethod

--------------------------------------------------------------------------------
--
-- Method:      check
--
-- Description: check unconnected tee or olet components
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       target branch element
--    2   RW     ARRAY       check results
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .check(!targetRef is DBREF, !results is ARRAY )

  do !memberRef values !targetRef.members
    !type = !memberRef.type
    if !type.eq('TEE') or !type.eq('OLET') then
      if !memberRef.cref.badref() then
        !results.append(object PFBRANTEECHECKRESULT(!memberRef))
      endif
    endif
  enddo

endmethod
