--   Replaces:
--
-- Author:          HyunJong Roh (Nick)
-- Created:         Tuesday 6th December 2011
--
-- Description:     result for unconnected tee or olet check
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  display()                        -                   display check result in the 3D view
--  fix(STRING)                      BOOLEAN             fix the problem
--  getMessage()                     STRING              return detailed result message
--  getResultLevel()                 REAL                return error level
--  getSolutionMethods()             ARRAY               return solution methods to fix the problem
--  pfBranTeeCheckResult(DBREF)      -                   constructor
--  zoom(DBREF)                      -                   zoom the given element
--
--------------------------------------------------------------------------------
define object PFBRANTEECHECKRESULT
  member  .componentRef is DBREF
endobject

--------------------------------------------------------------------------------
--
-- Method:      pfBranTeeCheckResult
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       tee or olet component
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfBranTeeCheckResult(!componentRef is DBREF)
  !this.componentRef = !componentRef
endmethod

--------------------------------------------------------------------------------
--
-- Method:      display
--
-- Description: display check result in 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .display()
  !!ce = !this.componentRef
  ENHANCE $!this.componentRef COLOUR $!!gphColOpt.highlight
  !this.zoom(!this.componentRef)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getMessage
--
-- Description: return detail check result string
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    STRING      detail check result string
--------------------------------------------------------------------------------
define method .getMessage() is STRING
  return !this.componentRef.namty + ' is not connected'
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getResultLevel
--
-- Description: return error level
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        error level
--                1 : information, 2 : warning, 3 : error
--------------------------------------------------------------------------------
define method .getResultLevel() is REAL
  return 2
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getSolutionMethods()
--
-- Description: return solution methods to fix the problem
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY     array of solution methods
--------------------------------------------------------------------------------
define method .getSolutionMethods() is ARRAY
  !solutions = object ARRAY()
  !solutions[1] = 'Delete'
  return !solutions
endmethod

--------------------------------------------------------------------------------
--
-- Method:      fix
--
-- Description: try to fix the problem
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      solution method
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     return true if the problem is fixed
--------------------------------------------------------------------------------
define method .fix(!dummyMethod is STRING) is BOOLEAN

  !res = !!alert.confirm('Are you sure to delete the selected component?')
  if !res.eq('YES') then
    !!ce = !this.componentRef

    !undo = object UNDOABLE()
    !undo.description('PF - Fix Inconsistency')
    !undo.add()

    DELETE $!this.componentRef.type
    handle ANY
      !!alert.error(!!error.text)
      !undo.endUndoable()
      return false
    endhandle

    !undo.endUndoable()

    return true
  endif

  return false
endmethod

--------------------------------------------------------------------------------
--
-- Method:      zoom
--
-- Description: zoom the given element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       element to be zoomed
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .zoom(!element is DBREF)

  !volume = object VOLUME(!element)

  !from = !volume.from
  !to   = !volume.to

  -- Through Point
  !throughPoint = !from.midPoint(!to)
  handle ANY
    return
  endhandle

  -- Set metric format
  !format           = object FORMAT()
  !format.units     = 'MM'
  !format.dp        = 0
  !format.dimension = 'L'

  -- Set through point
  !through[1] = !throughPoint.east.string(!format).real()
  !through[2] = !throughPoint.north.string(!format).real()
  !through[3] = !throughPoint.up.string(!format).real()
  !!fmSys.currentDocument().view.through = !through

  -- Set view radius
  !radius = !from.distance(!to).string(!format).real() / 2 * 1.25
  !radius = !radius.max(500mm)
  !!fmSys.currentDocument().view.radius  = !radius
endmethod
