--
-- Description:     object for branch connection
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getBranchDirection()             DIRECTION           return the branch direction
--  getConnectionExcess()            REAL
--  getConnectionType()              STRING              return the branch connection type
--  pfBranchConnection(DBREF,REAL,DBREF,BOOLEAN) -                   constructor
--
--------------------------------------------------------------------------------
define object PFBRANCHCONNECTION

  -- connection component (TEE, CROS...)
  member  .conPart        is DBREF

  member  .head           is BOOLEAN

  -- ppoint number
  member  .ppoint         is REAL

  -- pipe piece which is connected to this branch connection
  member  .pipePiece      is DBREF

  -- reference plane component
  --member  .refPart        is DBREF

  -- reference plane direction
  --member  .planeDirection is DIRECTION

endobject

--------------------------------------------------------------------------------
--
-- Method:      pfBranchConnection
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      DBREF       connection component (TEE, CROS...)
--    2    R      REAL        ppoint number
--    3    R      DBREF       pipe piece reference which is connected to this branch connection
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfBranchConnection(!conPart is DBREF, !ppoint is REAL, !ppieceRef is DBREF, !head is BOOLEAN)
  !this.conPart = !conPart
  !this.ppoint = !ppoint
  !this.pipePiece = !ppieceRef
  !this.head = !head
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getBranchDirection
--
-- Description: return the branch direction
--
-- Method Type: Function
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    DIRECTION   branch direction
--------------------------------------------------------------------------------
define method .getBranchDirection() is DIRECTION

  if !this.conPart.type.eq('PIPCA') then
    return !this.conPart.ddir
  else
    return !this.conPart.pdir[!this.ppoint]
  endif
endmethod


--------------------------------------------------------------------------------
--
-- Method:      getConnectionType
--
-- Description: return the branch connection type
--
-- Method Type: Function
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    STRING      branch connection type
--------------------------------------------------------------------------------
define method .getConnectionType() is STRING

-- Tribon M3
-- EXT Extrusion, machine
-- MEX Extrusion, manual
-- DRL Drill
-- SDL Saddle (main pipe steel)
-- MSD Manual saddling (main pipe non steel)
-- SRF On surface
-- BRN Burn

-- Stub-In in AM
--/00TVSAH Saddle Connection for Head             (CompType Attribute set to SSAH)
--/00TVSAT Saddle Connection for Tail             (CompType Attribute set to SSAT)
--/00TVVVH Stub in Connection for Head            (CompType Attribute set to STUH)
--/00TVVVT Stub in Connection for Tail            (CompType Attribute set to STUT)
--/00TVEXH Extruded Boss Connection for Head      (CompType Attribute set to SEXH)
--/00TVEXT Extruded Boss Connection for Tail      (CompType Attribute set to SEXT)
--/00TVSUH Stub In Insert Tee Connection for Head (CompType Attribute set to SSUH)
--/00TVSUT Stub In Insert Tee Connection for Tail (CompType Attribute set to SSUT)
--/BBTY5XH Welding Boss NPT Connection for Head   (CompType Attribute set to TAPH)
--/BBTY5XT Welding Boss NPT Connection for Tail   (CompType Attribute set to TAPT)
--/BFTWXXH Welding Boss BW Connection for Head    (CompType Attribute set to BOSH)
--/BFTWXXT Welding Boss BW Connection for Head    (CompType Attribute set to BOST)

--  !compType = !this.conPart.compType
--  if !compType.eq('SSAH') or !compType.eq('SSAT') then
--    return 'SDL'
--  elseif !compType.eq('STUH') or !compType.eq('STUT') then
--    return 'SRF'
--  elseif !compType.eq('SEXH') or !compType.eq('SEXT') then
--      return 'MEX'
--      return 'EXT'
--  elseif !compType.eq('SSUH') or !compType.eq('SSUT') then
--    return 'DRL'
--  elseif !compType.eq('TAPH') or !compType.eq('TAPT') then
--    return 'TAP'
--  elseif !compType.eq('BOSH') or !compType.eq('BOST') then
--    return 'BOS'
--  endif

  !type = !this.conPart.type

  !branchType = ''
  if !type.eq('PIPCA') then
    !branchType = !this.conPart.purpose
  elseif !type.eq('PTAP') then
    do !member values !this.conPart.members
      if !member.type.eq('PIPCA') then
        !branchType = !member.purpose
        break
      endif
    enddo
  endif

  if !branchType.eq('') then
    return ''
  elseif !branchType.eq('SSA') then
    return 'SDL'
  elseif !branchType.eq('STU') then
    return 'DRL'
  elseif !branchType.eq('SEX') then
    return 'EXT'
  elseif !branchType.eq('SSU') then
    return 'SRF'
  elseif !branchType.eq('TAP') then
    return 'BOS'
  endif

  return ''
endmethod

--------------------------------------------------------------------------------
