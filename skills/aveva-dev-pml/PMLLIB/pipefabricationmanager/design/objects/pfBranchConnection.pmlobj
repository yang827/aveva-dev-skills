--------------------------------------------------------------------------------
define method .getConnectionExcess() is REAL
--  !compType = !this.conPart.compType
--  if !compType.eq('SSAH') or !compType.eq('SSAT') then
--    return !!pfContext.defaultBossExcess
--  endif

  return 0mm

endmethod
