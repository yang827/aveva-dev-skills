--
-- Description:     object for consistency check group
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  check(DBREF,ARRAY)               -                   check the given branch element
--  getTitle()                       STRING              return the group title
--  initialize()                     -                   initialize check items
--  pfConsistencyCheckGroup(STRING)  -                   constructor
--
--------------------------------------------------------------------------------
define object PFCONSISTENCYCHECKGROUP

  -- group title
  member  .title    is STRING

  -- checkers in the group
  member  .checks   is ARRAY

endobject

--------------------------------------------------------------------------------
--
-- Method:      pfConsistencyCheckGroup
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      STRING      group title
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfConsistencyCheckGroup(!title is STRING)
  !this.title = !title
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getTitle
--
-- Description: return the title of this group
--
-- Method Type: Function
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    STRING      title
--------------------------------------------------------------------------------
define method .getTitle() is STRING
  return !this.title
endmethod

--------------------------------------------------------------------------------
--
-- Method:      check
--
-- Description: do checks against the given target element
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      DBREF       target element
--    2    RW     ARRAY       check results
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .check(!targetRef is DBREF, !results is ARRAY)
  do !i indices !this.checks
    !this.checks[!i].check(!targetRef, !results)
  enddo
endmethod

--------------------------------------------------------------------------------
--
-- Method:      initialize
--
-- Description: initialize check items
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .initialize()
  do !i indices !this.checks
    !this.checks[!i].initialize()
  enddo
endmethod
