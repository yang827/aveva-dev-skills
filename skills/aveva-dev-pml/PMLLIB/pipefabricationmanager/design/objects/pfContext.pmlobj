--
-- Description:     object for pipe fabrication context
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  formatBendRadiusRatio(REAL)      STRING              format bend radius ratio
--  formatOD(REAL)                   STRING              format outside diameter
--  formatStretchFactor(REAL)        STRING              format stretch factor
--  formatWallThickness(REAL)        STRING              format wall thickness
--  globalInstance()                 -                   make the instance global
--  initialize()                     -                   initialize context object
--  loadDefaults()                   -                   load default values from the storage
--  pfContext()                      -                   constructor
--  saveDefaultValue(STRING,ANY)     -                   save a default value into DDAT element
--  saveDefaults()                   -                   save default values to the storage
--
--------------------------------------------------------------------------------

define object PFCONTEXT

  -- formats -------------------------------------------------------------------
  member  .odWallRadiusFmt        is FORMAT

  member  .stretchFactorFmt       is FORMAT

  -- defaults ------------------------------------------------------------------

  member  .editable               is BOOLEAN

  member  .defaultLooseExcess     is REAL

  member  .defaultInsertExcess    is REAL

  member  .defaultSurfaceExcess   is REAL

  member  .defaultSaddleExcess    is REAL

  member  .defaultBossExcess      is REAL

  member  .defaultMitreExcess     is REAL

  member  .allowBendEndExcess     is BOOLEAN

  member  .allowExtrEndExcess     is BOOLEAN

  member  .allowFeedExcess        is BOOLEAN

  member  .allowConsCheckDrawing  is BOOLEAN

  member  .optimizationPriorities is ARRAY
  member  .updtManCreateedWelds   is BOOLEAN

  member  .firstFeedNegative      is BOOLEAN

  member  .xyzBendingTable        is BOOLEAN

  member  .reverseBendingDataOrder is BOOLEAN

  member  .disableSpoolType       is BOOLEAN

  member  .autoNamingRules        is BOOLEAN

  member  .disablePartumberMsg    is BOOLEAN

  member  .disableSkeyMsg         is BOOLEAN

  member  .defaultPrefixForWeld   is STRING

  member  .updateJointForGasket   is BOOLEAN

  member  .defaultPrefixForJoint  is STRING

  member  .defaultGalvanizationCheck is BOOLEAN
endobject

--------------------------------------------------------------------------------
--
-- Method:      pfContext
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfContext()

  !this.defaultLooseExcess    = 0mm
  !this.defaultInsertExcess   = 0mm
  !this.defaultSurfaceExcess  = 0mm
  !this.defaultSaddleExcess   = 0mm
  !this.defaultBossExcess     = 0mm
  !this.defaultMitreExcess    = 0mm

  !this.allowBendEndExcess    = true
  !this.allowExtrEndExcess    = true
  !this.allowFeedExcess       = true
  !this.updtManCreateedWelds  = true
  !this.firstFeedNegative     = true
  !this.allowConsCheckDrawing = false
  !this.xyzBendingTable       = false
  !this.reverseBendingDataOrder = false
  !this.disableSpoolType      = false
  !this.autoNamingRules       = true

  !this.disablePartumberMsg   = true
  !this.disableSkeyMsg        = true

  !this.defaultPrefixForWeld  = ''
  !this.updateJointForGasket  = false
  !this.defaultPrefixForJoint = ''

  !this.defaultGalvanizationCheck = false

  -- clutch end priority
  !this.optimizationPriorities[1] = 'MAX_PREWELD_FLANGE'
  !this.optimizationPriorities[2] = 'MIN_SAW_LEN'
  !this.optimizationPriorities[3] = 'MIN_LEN_OUT_MACH'
  !this.optimizationPriorities[4] = 'PUT_FLANGE_OUT'
  !this.optimizationPriorities[5] = 'MAX_MACH_EXTRUSION'

endmethod

--------------------------------------------------------------------------------
--
-- Method:      globalInstance
--
-- Description: make this instance global object
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .globalInstance()
  if (not(defined(!!pfContext))) then
    !!pfContext = !this
    !!pfContext.initialize()
  endif
endmethod

----------------------------------------------------------------------------------
----
---- Method:      initialize
----
---- Description: initialize member variables
----
---- Method Type: Procedure
---- Arguments:
----   [#]  [R/RW] [Data Type] [Description]
----
---- Return:
----   [Data Type] [Description]
----
----------------------------------------------------------------------------------
define method .initialize()

  !this.odWallRadiusFmt = !!distanceFmt
  --!this.odWallRadiusFmt.label = 'UNITS'
  --!this.odWallRadiusFmt.dimension = 'L'
  if (!!isImperialLength('DIST')) then
    !this.odWallRadiusFmt.dp = 3
    !this.odWallRadiusFmt.units = 'INCH'
  else
    !this.odWallRadiusFmt.dp = 2
    !this.odWallRadiusFmt.units = 'MM'
  endif

  !this.stretchFactorFmt = !!realFmt
  !this.stretchFactorFmt.dp = 5

  !this.loadDefaults()
endmethod

--------------------------------------------------------------------------------
--
-- Method:      formatOD
--
-- Description: format the given outside diameter
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      REAL        outside diameter
-- Return:
--   [Data Type] [Description]
--    STRING      outside diameter string
--------------------------------------------------------------------------------
define method .formatOD(!outDiameter is REAL) is STRING
  return !outDiameter.string(!this.odWallRadiusFmt)
endmethod


--------------------------------------------------------------------------------
--
-- Method:      formatWallThickness
--
-- Description: format the given wall thickness
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      REAL        wall thickness
-- Return:
--   [Data Type] [Description]
--    STRING      wall thickness string
--------------------------------------------------------------------------------
define method .formatWallThickness(!wallThickness is REAL) is STRING
  return !wallThickness.string(!this.odWallRadiusFmt)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      formatBendRadiusRatio
--
-- Description: format the given bend radius ratio
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      REAL        bend radius ratio against the outside diameter
-- Return:
--   [Data Type] [Description]
--    STRING      formatted string
--------------------------------------------------------------------------------
define method .formatBendRadiusRatio(!ratio is REAL) is STRING
  return !ratio.string(!this.stretchFactorFmt)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      formatStretchFactor
--
-- Description: format the given stretch factor
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      REAL        stretch factor
-- Return:
--   [Data Type] [Description]
--    STRING      formatted string
--------------------------------------------------------------------------------
define method .formatStretchFactor(!factor is REAL) is STRING
  return !factor.string(!this.stretchFactorFmt)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      saveDefaults
--
-- Description: save default values to the storage
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type]             [Description]
--
--------------------------------------------------------------------------------
define method .saveDefaults()
  !saveCe = !!ce

  -- get application data world for pipe fabrication
  !appldwRefs = !!collectAllFor('APPLDW', |FUNC EQ 'PipeFabrication'|, /* )
  if !appldwRefs.empty() then
    !!alert.error(|No APPLDW defined for Pipe Fabrication. Please create one with FUNC = 'PipeFabrication'|)
    return
  endif

  -- get APPDAR
  !appdarRefs = !!collectAllFor('APPDAR', |FUNC EQ 'DEFAULTS'|, !appldwRefs.first())
  if !appdarRefs.empty() then

    !!ce = !appldwRefs.first()
    NEW APPDAR FUNC 'DEFAULTS'
    !appdarRef = !!ce

  else
    !appdarRef = !appdarRefs.first()
  endif

  -- get APPLDA
  !appldaRefs = !!collectAllFor('APPLDA', |FUNC EQ 'DEFAULTS'|, !appdarRef)
  if !appldaRefs.empty() then

    !!ce = !appdarRef
    NEW APPLDA FUNC 'DEFAULTS'
    !appldaRef = !!ce

  else
    !appldaRef = !appldaRefs.first()
  endif

  -- get DDSE elements for default values
  !ddseRefs = !!collectAllFor('DDSE', |FUNC EQ 'DEFAULTS'|, !appldaRef)
  if !ddseRefs.empty() then

    !!ce = !appldaRef
    NEW DDSE FUNC 'DEFAULTS'
    !ddseRef = !!ce

  else
    !ddseRef = !ddseRefs.first()
  endif

  !!ce = !ddseRef
  DELETE DDSE MEM
  handle any
    !!alert.error(!!error.text)
    !!ce = !saveCe
    handle any
    endhandle

    return
  endhandle

  -- save default values
  !this.saveDefaultValue('ALLOW_FEED_EXCESS',     !this.allowFeedExcess)
  !this.saveDefaultValue('ALLOW_BEND_END_EXCESS', !this.allowBendEndExcess)
  !this.saveDefaultValue('ALLOW_EXTR_END_EXCESS', !this.allowExtrEndExcess)
  !this.saveDefaultValue('LOOSE_DEF_EXCESS',      !this.defaultLooseExcess)
  !this.saveDefaultValue('INSERT_DEF_EXCESS',     !this.defaultInsertExcess)
  !this.saveDefaultValue('SURFACE_DEF_EXCESS',    !this.defaultSurfaceExcess)
  !this.saveDefaultValue('SADDLE_DEF_EXCESS',     !this.defaultSaddleExcess)
  !this.saveDefaultValue('BOSS_DEF_EXCESS',       !this.defaultBossExcess)
  !this.saveDefaultValue('MITRE_DEF_EXCESS',      !this.defaultMitreExcess)
  !this.saveDefaultValue('UPDATE_MANUAL_CREATED_WELDS', !this.updtManCreateedWelds)
  !this.saveDefaultValue('NEG_FIRST_FEED',        !this.firstFeedNegative)
  !this.saveDefaultValue('ALLOW_CONST_DRWG',      !this.allowConsCheckDrawing)
  !this.saveDefaultValue('XYZ_BENDING_TABLE',     !this.xyzBendingTable)
  !this.saveDefaultValue('REVERSE_BENDING_DATA_ORDER',!this.reverseBendingDataOrder)
  !this.saveDefaultValue('DISABLE_SPOOL_TYPE',    !this.disableSpoolType)
  !this.saveDefaultValue('AUTO_NAMING_RULES',     !this.autoNamingRules)
  !this.saveDefaultValue('DISABLE_PARTNUMBER_MSG',!this.disablePartumberMsg)
  !this.saveDefaultValue('DISABLE_SKEY_MSG',      !this.disableSkeyMsg)

  !this.saveDefaultValue('DEFAULT_PREFIX_WELD',   !this.defaultPrefixForWeld)
  !this.saveDefaultValue('UPDATE_JOINT_GASKET',   !this.updateJointForGasket)
  !this.saveDefaultValue('DEFAULT_PREFIX_JOINT',  !this.defaultPrefixForJoint)
  !this.saveDefaultValue('GALVANIZATION_CHECK_VAL', !this.defaultGalvanizationCheck)

  -- save optimization priorities
  NEW DDAT DTITLE 'BEND_PRIORITY'
  do !criterion values !this.optimizationPriorities
    NEW VVALUE VALIDV |$!criterion|
  enddo

  !!ce = !saveCe
  handle any
  endhandle
endmethod

--------------------------------------------------------------------------------
--
-- Method:      saveDefaultValue
--
-- Description: save a default value into DDAT element
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      STRING      default name
--    2    R      ANY         default value
-- Return:
--   [Data Type]             [Description]
--
--------------------------------------------------------------------------------
define method .saveDefaultValue(!name is STRING, !value is ANY)
  NEW DDAT
  !!ce.dtitle = !name

  if (!value.objectType() eq 'STRING') then
    !!ce.ddproperty = |'$!<value>'|
  else
    !!ce.ddproperty = !value.string()
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      loadDefaults
--
-- Description: load default values from the storage
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type]             [Description]
--
--------------------------------------------------------------------------------
define method .loadDefaults()

  !appldwRefs = !!collectAllFor('APPLDW', |FUNC EQ 'PipeFabrication'|, /* )
  if !appldwRefs.empty() then
    -- allow creating new APPLDW for defaults
    !this.editable = true
    return
  endif

  !appldwRef = !appldwRefs.first()

  !this.editable = !appldwRef.dbWrite

  -- get APPDAR
  !appdarRefs = !!collectAllFor('APPDAR', |FUNC EQ 'DEFAULTS'|, !appldwRef)
  if !appdarRefs.empty() then
    return
  endif

  -- get APPLDA
  !appldaRefs = !!collectAllFor('APPLDA', |FUNC EQ 'DEFAULTS'|, !appdarRefs.first())
  if !appldaRefs.empty() then
    return
  endif

  !ddseRefs = !!collectAllFor('DDSE', |FUNC EQ 'DEFAULTS'|, !appldaRefs.first())
  if !ddseRefs.empty() then
    return
  endif

  do !ddatRef values !ddseRefs[1].members

    skip if !ddatRef.type.neq('DDAT')

    !dtitle = !ddatRef.dtitle.upCase()
    !block = object BLOCK(!ddatRef.ddproperty)

    if !dtitle.eq('ALLOW_FEED_EXCESS') then
      !this.allowFeedExcess = !block.evaluate()
      handle ANY
        !this.allowFeedExcess = true
      endhandle
    elseif !dtitle.eq('ALLOW_BEND_END_EXCESS') then
      !this.allowBendEndExcess = !block.evaluate()
      handle ANY
        !this.allowBendEndExcess = true
      endhandle
    elseif !dtitle.eq('ALLOW_EXTR_END_EXCESS') then
      !this.allowExtrEndExcess = !block.evaluate()
      handle ANY
        !this.allowExtrEndExcess = true
      endhandle
    elseif !dtitle.eq('LOOSE_DEF_EXCESS') then
      !this.defaultLooseExcess = !block.evaluate()
      handle ANY
        !this.defaultLooseExcess = 0mm
      endhandle
    elseif !dtitle.eq('INSERT_DEF_EXCESS') then
      !this.defaultInsertExcess = !block.evaluate()
      handle ANY
        !this.defaultInsertExcess = 0mm
      endhandle
    elseif !dtitle.eq('SURFACE_DEF_EXCESS') then
      !this.defaultSurfaceExcess = !block.evaluate()
      handle ANY
        !this.defaultSurfaceExcess = 0mm
      endhandle
    elseif !dtitle.eq('SADDLE_DEF_EXCESS') then
      !this.defaultSaddleExcess = !block.evaluate()
      handle ANY
        !this.defaultSaddleExcess = 0mm
      endhandle
    elseif !dtitle.eq('BOSS_DEF_EXCESS') then
      !this.defaultBossExcess = !block.evaluate()
      handle ANY
        !this.defaultBossExcess = 0mm
      endhandle
    elseif !dtitle.eq('MITRE_DEF_EXCESS') then
      !this.defaultMitreExcess = !block.evaluate()
      handle ANY
        !this.defaultMitreExcess = 0mm
      endhandle
    elseif !dtitle.eq('UPDATE_MANUAL_CREATED_WELDS') then
      !this.updtManCreateedWelds = !block.evaluate()
      handle ANY
        !this.updtManCreateedWelds = false
      endhandle
    elseif !dtitle.eq('NEG_FIRST_FEED') then
      !this.firstFeedNegative = !block.evaluate()
      handle ANY
        !this.firstFeedNegative = false
      endhandle
    elseif !dtitle.eq('XYZ_BENDING_TABLE') then
      !this.xyzBendingTable = !block.evaluate()
      handle ANY
        !this.xyzBendingTable = false
      endhandle
    elseif !dtitle.eq('REVERSE_BENDING_DATA_ORDER') then
      !this.reverseBendingDataOrder = !block.evaluate()
      handle ANY
        !this.reverseBendingDataOrder = false
      endhandle
    elseif !dtitle.eq('DISABLE_SPOOL_TYPE') then
      !this.disableSpoolType = !block.evaluate()
      handle ANY
        !this.disableSpoolType = false
      endhandle
    elseif !dtitle.eq('BEND_PRIORITY') then

      !priorities = object ARRAY()
      do !vvalueRef values !ddatRef.members

        skip if !vvalueRef.type.neq('VVALUE')

        !block = object BLOCK(!vvalueRef.validValue)
        !criterion = !block.evaluate()
        handle ANY
          skip
        endhandle

        !criterion = !criterion.trim().upCase()
        if !this.optimizationPriorities.findFirst(!criterion).set() then
          !priorities.append(!criterion)
        endif
      enddo

      -- check the criterion is valid and add it to array if valid
      do !criterion values !this.optimizationPriorities
        if !priorities.findFirst(!criterion).unset() then
          !priorities.append(!criterion)
        endif
      enddo

      !this.optimizationPriorities = !priorities

    elseif !dtitle.eq('ALLOW_CONST_DRWG') then
      !this.allowConsCheckDrawing = !block.evaluate()
      handle ANY
        !this.allowConsCheckDrawing = false
      endhandle
    elseif !dtitle.eq('AUTO_NAMING_RULES') then
      !this.autoNamingRules = !block.evaluate()
      handle ANY
        !this.autoNamingRules = true
      endhandle
    elseif !dtitle.eq('DISABLE_PARTNUMBER_MSG') then
      !this.disablePartumberMsg = !block.evaluate()
      handle ANY
        !this.disablePartumberMsg = true
      endhandle
    elseif !dtitle.eq('DISABLE_SKEY_MSG') then
      !this.disableSkeyMsg = !block.evaluate()
      handle ANY
        !this.disableSkeyMsg = true
      endhandle
    elseif !dtitle.eq('DEFAULT_PREFIX_WELD') then
      !this.defaultPrefixForWeld = !block.evaluate().upCase()
      handle ANY
        !this.defaultPrefixForWeld = ''
      endhandle
    elseif !dtitle.eq('UPDATE_JOINT_GASKET') then
      !this.updateJointForGasket = !block.evaluate()
      handle ANY
        !this.updateJointForGasket = false
      endhandle

    elseif !dtitle.eq('DEFAULT_PREFIX_JOINT') then
      !this.defaultPrefixForJoint = !block.evaluate().upCase()
      handle ANY
        !this.defaultPrefixForJoint = ''
      endhandle
	elseif !dtitle.eq('GALVANIZATION_CHECK_VAL') then
	  !this.defaultGalvanizationCheck = !block.evaluate()
	  handle ANY
	    !this.defaultGalvanizationCheck = false
	  endhandle
    endif
  enddo

endmethod

----------------------------------------------------------------------------------
----
---- Method:      isValidStretchFactor
----
---- Description: check if the given stretch factors are valid or not
----
---- Method Type: Procedure
---- Arguments:
----   [#]  [R/RW] [Data Type] [Description]
----    1    R      REAL        constant stretch factor
----    2    R      REAL        proportional stretch factor
----    3    R      BOOLEAN     allow zeros
---- Return:
----   [Data Type]             [Description]
----    REAL                    0 : valid, 1 : invalid, -1 : potentially invalid
----------------------------------------------------------------------------------
--define method .isValidStretchFactor(!stfc is REAL, !stfp is REAL, !allowZeros is BOOLEAN) is REAL
--
---- return constants, do not change!
--  !valid = 0
--  !invalid = 1
--  !potentiallyInvalid = -1
--
--  if(!allowZeros AND (!stfc EQ 0) AND (!stfp EQ 0)) then
--    -- this is a valid case
--    return !valid
--  endif
--
--  -- bend angle = 0:
--  !val0 = !stfc
--
--  -- bend angle = 180o:
--  !val1 = !stfc - !stfp * 3.14159 / 2.
--
--  -- valid limits
--  !valMin = 0.0000011
--  !valMax = 1.0
--
--  if((!val0.lt(!valMin)) and (!val1.lt(!valMin))) then
--    return !invalid
--  endif
--
--  if((!val0.gt(!valMax)) and (!val1.gt(!valMax))) then
--    return !invalid
--  endif
--
--  if((!val0.lt(!valMin)) or (!val0.gt(!valMax))) then
--    return !potentiallyInvalid
--  endif
--
--  if((!val1.lt(!valMin)) or (!val1.gt(!valMax))) then
--    return !potentiallyInvalid
--  endif
--
--  return !valid
--
--endmethod
