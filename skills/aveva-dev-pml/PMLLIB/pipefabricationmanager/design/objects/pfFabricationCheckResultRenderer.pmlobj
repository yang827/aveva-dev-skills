--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            pfFabricationCheckResultRenderer.pmlobj
--   Type:          Object Definition
--   Group:         Pipe Fabrication
--     Keyword:     PF
--   Module:        Design
--   Replaces:
--
-- Author:          DoHyoung Kim (Bright)
-- Created:         Monday 11st June 2012
--
-- Description:     display fabrication check result in the 3D view
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  displayEndExcess(REAL,BOOLEAN,REAL) -                   display end excess
--  getConnectionPoint(DBREF)        REAL                return the connection ppoint of the given component
--  highlight(ARRAY)                 -                   highlight components
--  highlight(ARRAY,BOOLEAN)         -                   highlight components and zoom the components
--  highlight(DBREF)                 -                   highlight the given element
--  highlight(DBREF,BOOLEAN)         -                   highlight and zoom the given element
--  highlightPipePiece()             -                   highlight current pipe piece
--  highlightPipePiece(BOOLEAN)      -                   highlight current pipe piece and zoom it
--  pfFabricationCheckResultRenderer(ARRAY) -                   constructor
--  render(REAL)                     -                   display information in the 3D view
--  renderDetail(REAL,ARRAY)         -                   display detail information in the 3D view
--  toDirection(ARRAY)               DIRECTION           convert array of real to direction object
--  toPosition(ARRAY)                POSITION            convert array of real to position object
--  zoom(VOLUME)                     -                   zoom the given area
--  zoomPipeSpool()                  -                   zoom the current pipe spool
--  zoomPipeSpool(REAL)              -                   zoom the current pipe spool with margin
--
--------------------------------------------------------------------------------
define object PFFABRICATIONCHECKRESULTRENDERER

  member  .code       is REAL

  member  .level      is REAL

  member  .result     is PFCHECKRESULTPML

  member  .pipePiece  is PFPIPEPIECEPML

  member  .args       is ARRAY

endobject

------------------------------------------------------------------------
--
-- Method:      pfFabricationCheckResultRenderer
-- Description: constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       fabrication check message data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pfFabricationCheckResultRenderer(!args is ARRAY)

  !this.code      = !args[0]
  !this.level     = !args[1]
  !this.result    = !args[2]
  !this.pipePiece = !this.result.pipePiece()
  !this.args      = !args

endmethod

------------------------------------------------------------------------
--
-- Method:      render
-- Description: display information in the 3D view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        aid number
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .render(!aidNumber is REAL)

  UNENHANCE ALL
  !!aidNumbers.hide(!aidNumber)

  if !this.code.eq(1) then
    -- user end excess
    !this.zoomPipeSpool()

    !arrive = !this.args[3]
    if !arrive then
      !excess = !!comConvertUnknownValue(!this.result.userArriveExcess(), 'MM')
    else
      !excess = !!comConvertUnknownValue(!this.result.userLeaveExcess(), 'MM')
    endif

    if !this.pipePiece.isPureMitrePiece() then

      !name = !this.pipePiece.arriveBoundary()
      !component = !name.dbref()
      handle ANY
        !component = object DBREF()
      endhandle

      if !component.set() then
        !textPosition = !component.position
        !infoString = 'User excess : ' + !excess.string(!!distanceFmt)
        AID TEXT NUM $!aidNumber '$!infoString' AT $!textPosition
      endif
    else
      !names = !this.pipePiece.allComponents()
      !components = object ARRAY()
      do !name values !names
        !component = !name.dbref()
        handle ANY
        elsehandle NONE
          !components.append(!component)
        endhandle
      enddo

      if !arrive.not() then
        !components.invert()
      endif

      do !component values !components
        --if !component.type.eq('BEND') then
        --  break
        --endif
        ENHANCE $!component COLOUR $!!gphColOpt.highlight
      enddo

      if !arrive then
        !endPosition  = !this.toPosition(!this.result.arrivePosition())
        !endDirection = !this.toDirection(!this.result.arriveDirection())
      else
        !endPosition  = !this.toPosition(!this.result.leavePosition())
        !endDirection = !this.toDirection(!this.result.leaveDirection())
      endif

      !outsideDiameter = !!comConvertUnknownValue(!this.result.outsideDiameter(), 'MM')

      !midPosition = !endPosition.offset(!endDirection, !excess / 2)
      !pointVector = object POINTVECTOR(!endPosition, !endDirection)
      !orientation = !pointVector.plane().orientation
      !diameter = !outsideDiameter + 2mm
      AID CYLI NUM $!aidNumber POS $!midPosition ORI $!orientation DIA $!diameter HEI $!excess FILL ON

      !textPosition = !endPosition.offset(!orientation.xdir(), !diameter * 0.7).offset(!endDirection, !excess / 2)
      !infoString = 'User excess : ' + !excess.string(!!distanceFmt)
      AID TEXT NUM $!aidNumber '$!infoString' AT $!textPosition
    endif
  elseif !this.code.eq(2) then
    -- user feed excess
    !this.zoomPipeSpool()
    !feedExcesses = !this.result.userFeedExcesses()
    !index      = !this.args[3]
    !feedExcess = !!comConvertUnknownValue(!feedExcesses[!index], 'MM')
    !bend1 = object DBREF()
    !bend2 = object DBREF()
    !bendIndex = -1
    !names = !this.pipePiece.allComponents()
    do !name values !names
      !component = !name.dbref()
      handle ANY
        break
      endhandle

      if !component.type.eq('BEND') then
        !bendIndex = !bendIndex + 1
        if !bendIndex.eq(!index) then
          !bend1 = !component
          skip
        endif

        if !bendIndex.gt(!index) then
          !bend2 = !component
          break
        endif
      endif

      if !index.eq(!bendIndex) then
        ENHANCE $!component COLOUR $!!gphColOpt.highlight
      endif
    enddo

    ENHANCE $!bend1 COLOUR $!!gphColOpt.highlight
    ENHANCE $!bend2 COLOUR $!!gphColOpt.highlight

    !textPosition = !bend1.lpos.midPoint(!bend2.apos)
    !infoString = 'User feed : ' + !feedExcess.string(!!distanceFmt)
    AID TEXT NUM $!aidNumber '$!infoString' AT $!textPosition

  elseif !this.code.eq(3) then
    -- too long cut-length
    !this.highlightPipePiece()

  elseif !this.code.eq(4) then
    -- loose part
    !this.zoomPipeSpool()
    !name = !this.args[3]
    !component = !name.dbref()
    handle ANY
    elsehandle NONE
      if !component.badref().not() then
        ENHANCE $!component COLOUR $!!gphColOpt.highlight

        AID TEXT NUM $!aidNumber 'Loose' AT $!<component.pos>
      endif
    endhandle

  elseif !this.code.eq(5) then
    -- data consistency check
    !name = !this.pipePiece.arriveBoundary()
    !component = !name.dbref()
    handle ANY
      !component = object DBREF()
    endhandle

    if !component.set() then
      if !component.type.eq('BRAN') then
        !branRef = !component
      else
        !branRef = !component.owner
      endif

      ENHANCE $!branRef COLOUR $!!gphColOpt.highlight
      !this.zoom(object VOLUME(!branRef))
    endif

  elseif !this.code inset (6, 7, 8, 9) then

    -- excess for branch connection
    !this.zoomPipeSpool()

    !arrive = !this.args[3]

    !names = !this.pipePiece.allComponents()
    !components = object ARRAY()
    do !name values !names
      !component = !name.dbref()
      handle ANY
      elsehandle NONE
        !components.append(!component)
      endhandle
    enddo

    do !component values !components
      ENHANCE $!component COLOUR $!!gphColOpt.highlight
    enddo

    if !arrive then
      !excess = !!comConvertUnknownValue(!this.result.arriveBranchConnectionExcess(), 'MM')
      !endPosition  = !this.toPosition(!this.result.arrivePosition())
      !endDirection = !this.toDirection(!this.result.arriveDirection())
    else
      !excess = !!comConvertUnknownValue(!this.result.leaveBranchConnectionExcess(), 'MM')
      !endPosition  = !this.toPosition(!this.result.leavePosition())
      !endDirection = !this.toDirection(!this.result.leaveDirection())
    endif

    !outsideDiameter = !!comConvertUnknownValue(!this.result.outsideDiameter(), 'MM')

    !midPosition = !endPosition.offset(!endDirection, !excess / 2)
    !pointVector = object POINTVECTOR(!endPosition, !endDirection)
    !orientation = !pointVector.plane().orientation
    !diameter = !outsideDiameter + 2mm
    AID CYLI NUM $!aidNumber POS $!midPosition ORI $!orientation DIA $!diameter HEI $!excess FILL ON

    !textPosition = !endPosition.offset(!orientation.xdir(), !diameter * 0.7).offset(!endDirection, !excess / 2)
    !infoString = 'Excess : ' + !excess.string(!!distanceFmt)
    AID TEXT NUM $!aidNumber '$!infoString' AT $!textPosition

  elseif !this.code.eq(10) then
    -- excess for mitre connection

    --[0]  <REAL> 10
    --[1]  <REAL> 1
    --[2]  <AVEVA.PDMS.PIPEFABRICATION.FABRICATIONCHECK.PFCHECKRESULTPML> Aveva.Pdms.PipeFabrication.FabricationCheck.PFCheckResultPML
    --[3]  <BOOLEAN> FALSE
    --[4]  <REAL> 50

    if !this.pipePiece.isPureMitrePiece() then
      return
    endif

    !this.zoomPipeSpool()

    !arrive = !this.args[3]

    -- highlight component
    !names = !this.pipePiece.allComponents()
    !components = object ARRAY()
    do !name values !names
      !component = !name.dbref()
      handle ANY
      elsehandle NONE
        !components.append(!component)
      endhandle
    enddo

    do !component values !components
      ENHANCE $!component COLOUR $!!gphColOpt.highlight
    enddo

    -- draw excess
    if !arrive then
      !excess = !!comConvertUnknownValue(!this.result.arriveMitreExcess(), 'MM')
      !endPosition  = !this.toPosition(!this.result.arrivePosition())
      !endDirection = !this.toDirection(!this.result.arriveDirection())
    else
      !excess = !!comConvertUnknownValue(!this.result.leaveMitreExcess(), 'MM')
      !endPosition  = !this.toPosition(!this.result.leavePosition())
      !endDirection = !this.toDirection(!this.result.leaveDirection())
    endif

    !outsideDiameter = !!comConvertUnknownValue(!this.result.outsideDiameter(), 'MM')

    !midPosition = !endPosition.offset(!endDirection, !excess / 2)
    !pointVector = object POINTVECTOR(!endPosition, !endDirection)
    !orientation = !pointVector.plane().orientation
    !diameter = !outsideDiameter + 2mm
    AID CYLI NUM $!aidNumber POS $!midPosition ORI $!orientation DIA $!diameter HEI $!excess FILL ON

    !textPosition = !endPosition.offset(!orientation.xdir(), !diameter * 0.7).offset(!endDirection, !excess / 2)
    !infoString = 'Excess : ' + !excess.string(!!distanceFmt)
    AID TEXT NUM $!aidNumber '$!infoString' AT $!textPosition

  elseif !this.code.eq(101) then
    -- no suitable bending machine
    !this.highlightPipePiece()

  elseif !this.code.eq(102) then
    -- all bends are not the same radius

    !names = !this.pipePiece.bendComponents()
    !components = object ARRAY()
    do !name values !names
      !component = !name.dbref()
      handle ANY
      elsehandle NONE
        !components.append(!component)
      endhandle
    enddo

    !this.highlight(!components)

    do !component values !components
      !radius = !component.radius
      !position = !component.position
      !infoString = !radius.string(!!distanceFmt)
      AID TEXT NUM $!aidNumber '$!infoString' AT $!position
    enddo

  elseif !this.code inset (103, 104, 105) then
    -- too long machine insertion length

    !this.highlightPipePiece()

    !insertionLength = !this.args[3]
    !maxLength = !this.args[4]

    !bendingDirectionForward = !this.result.bendingDirectionForward()
    if !bendingDirectionForward then
      !endExcess    = !!comConvertUnknownValue(!this.result.leaveExcess(), 'MM')
      if !this.result.leaveFlangeManuallyWelded() then
        !endPosition  = !this.toPosition(!this.result.leavePosition())
      else
        !component = !this.pipePiece.leaveComponent().dbref()
        !endPosition  = !component.lpos
      endif
      !endDirection = !this.toDirection(!this.result.leaveDirection())
    else
      !endExcess    = !!comConvertUnknownValue(!this.result.arriveExcess(), 'MM')
      if !this.result.arriveFlangeManuallyWelded() then
        !endPosition  = !this.toPosition(!this.result.arrivePosition())
      else
        !component = !this.pipePiece.arriveComponent().dbref()
        !endPosition  = !component.apos
      endif
      !endDirection = !this.toDirection(!this.result.arriveDirection())
    endif

    !endPosition = !endPosition.offset(!endDirection, !endExcess)

    !outsideDiameter = !!comConvertUnknownValue(!this.result.outsideDiameter(), 'MM')
    !pointVector = object POINTVECTOR(!endPosition, !endDirection)
    !orientation = !pointVector.plane().orientation

    if !endExcess.gt(0mm) then
      !midPosition = !endPosition.offset(!endDirection, !endExcess / 2)
      !diameter = !outsideDiameter + 2mm
      AID CYLI NUM $!aidNumber POS $!midPosition ORI $!orientation DIA $!diameter HEI $!endExcess FILL ON
    endif

    !normalDirection = !orientation.xdir()
    !leaderLength = !this.result.outsideDiameter() * 2
    !leaderLine = object GPHLINE(object LINE(!endPosition, !endPosition.offset(!normalDirection, !leaderLength + 30mm)))
    !leaderLine.draw(!aidNumber, false)

    !dimensionPosition = !endPosition.offset(!normalDirection, !leaderLength)
    !dimensionLine = object GPHLINE(object LINE(!dimensionPosition, !dimensionPosition.offset(!endDirection, !leaderLength * -3)))
    !dimensionLine.draw(!aidNumber, false)

    !arrowPosition = !dimensionPosition.offset(!endDirection, -30mm)
    AID ARROW NUM $!aidNumber AT $!arrowPosition DIR $!endDirection HEI 30mm PROP 1

    !infoString = 'Insertion Length ' + !insertionLength.string(!!distanceFmt) + ' (Max. ' + !maxLength.string(!!distanceFmt) + ')'
    !textPosition = !dimensionPosition.offset(!normalDirection, 50mm)
    AID TEXT NUM $!aidNumber '$!infoString' AT $!textPosition

  elseif !this.code.eq(106) then
    -- bending clashes with a collision plane
    !this.highlightPipePiece()

  elseif !this.code inset (107, 108) then
    -- automated end excess for bending
    !arrive     = !this.args[3]
    !excess     = !!comConvertUnknownValue(!this.args[4], 'MM')
    !minLength  = !this.args[5]
    !tubeLength = !this.args[6]

    !this.zoomPipeSpool(!excess)

    !names = !this.pipePiece.allComponents()
    !components = object ARRAY()
    do !name values !names
      !component = !name.dbref()
      handle ANY
      elsehandle NONE
        !components.append(!component)
      endhandle
    enddo

    if !arrive.not() then
      !components.invert()
    endif

    do !component values !components
      --if !component.type.eq('BEND') then
      --  break
      --endif
      ENHANCE $!component COLOUR $!!gphColOpt.highlight
    enddo

    if !arrive then
      !endPosition  = !this.toPosition(!this.result.arrivePosition())
      !endDirection = !this.toDirection(!this.result.arriveDirection())
      --!mitreLength  = !this.result.arriveMitreLength()
    else
      !endPosition  = !this.toPosition(!this.result.leavePosition())
      !endDirection = !this.toDirection(!this.result.leaveDirection())
      --!mitreLength  = !this.result.leaveMitreLength()
    endif

    --!endPosition = !endPosition.offset(!endDirection, !mitreLength)

    !outsideDiameter = !this.result.outsideDiameter()

    !midPosition = !endPosition.offset(!endDirection, !excess / 2)
    !pointVector = object POINTVECTOR(!endPosition, !endDirection)
    !orientation = !pointVector.plane().orientation
    !diameter = !outsideDiameter + 2mm
    AID CYLI NUM $!aidNumber POS $!midPosition ORI $!orientation DIA $!diameter HEI $!excess FILL ON

    !textPosition = !endPosition.offset(!orientation.xdir(), !diameter * 0.7).offset(!endDirection, !excess / 2)
    !infoString = 'End excess : ' + !excess.string(!!distanceFmt)
    AID TEXT NUM $!aidNumber '$!infoString' AT $!textPosition

  elseif !this.code.eq(109) then
    -- automated feed excess

    !this.zoomPipeSpool()

    !index      = !this.args[3]
    !feedExcess = !!comConvertUnknownValue(!this.args[4], 'MM')
    --!gripLength = !!comConvertUnknownValue(!this.args[5], 'MM')
    --!tubeLength = !!comConvertUnknownValue(!this.args[6], 'MM')

    !bend1 = object DBREF()
    !bend2 = object DBREF()
    !bendIndex = -1
    !names = !this.pipePiece.allComponents()
    do !name values !names
      !component = !name.dbref()
      handle ANY
        break
      endhandle

      if !component.type.eq('BEND') then
        !bendIndex = !bendIndex + 1
        if !bendIndex.eq(!index) then
          !bend1 = !component
          skip
        endif

        if !bendIndex.gt(!index) then
          !bend2 = !component
          break
        endif
      endif

      if !index.eq(!bendIndex) then
        ENHANCE $!component COLOUR $!!gphColOpt.highlight
      endif
    enddo

    ENHANCE $!bend1 COLOUR $!!gphColOpt.highlight
    ENHANCE $!bend2 COLOUR $!!gphColOpt.highlight

    !textPosition = !bend1.lpos.midPoint(!bend2.apos)
    !infoString = 'Machine feed : ' + !feedExcess.string(!!distanceFmt)
    AID TEXT NUM $!aidNumber '$!infoString' AT $!textPosition

  elseif !this.code inset (110, 111) then
    -- too short start/end tube length

    !this.zoomPipeSpool()

    !arrive = !this.args[3]
    !minLength = !!comConvertUnknownValue(!this.args[4], 'MM')
    !tubeLength = !!comConvertUnknownValue(!this.args[5], 'MM')

    !names = !this.pipePiece.allComponents()
    !components = object ARRAY()
    do !name values !names
      !component = !name.dbref()
      handle ANY
      elsehandle NONE
        !components.append(!component)
      endhandle
    enddo

    if !arrive.not() then
      !components.invert()
    endif

    do !component values !components
      if !component.type.eq('BEND') then
        break
      endif
      ENHANCE $!component COLOUR $!!gphColOpt.highlight
    enddo

    if !arrive then
      !endPosition  = !this.toPosition(!this.result.arrivePosition())
    else
      !endPosition  = !this.toPosition(!this.result.leavePosition())
    endif

    !infoString = !tubeLength.string(!!distanceFmt) + ' (Min. ' + !minLength.string(!!distanceFmt) + ')'
    AID TEXT NUM $!aidNumber '$!infoString' AT $!endPosition

  elseif !this.code.eq(112) then
    -- too short tube length between bends

    !this.zoomPipeSpool()

    !index = !this.args[3]
    !minLength = !!comConvertUnknownValue(!this.args[4], 'MM')
    !tubeLength = !!comConvertUnknownValue(!this.args[5], 'MM')

    !bend1 = object DBREF()
    !bend2 = object DBREF()
    !bendIndex = -1
    !names = !this.pipePiece.allComponents()
    do !name values !names
      !component = !name.dbref()
      handle ANY
        break
      endhandle

      if !component.type.eq('BEND') then
        !bendIndex = !bendIndex + 1
        if !bendIndex.eq(!index) then
          !bend1 = !component
          skip
        endif

        if !bendIndex.gt(!index) then
          !bend2 = !component
          break
        endif
      endif

      if !index.eq(!bendIndex) then
        ENHANCE $!component COLOUR $!!gphColOpt.highlight
      endif
    enddo

    ENHANCE $!bend1 COLOUR $!!gphColOpt.highlight
    ENHANCE $!bend2 COLOUR $!!gphColOpt.highlight

    !textPosition = !bend1.lpos.midPoint(!bend2.apos)
    !infoString = !tubeLength.string(!!distanceFmt) + ' (Min. ' + !minLength.string(!!distanceFmt) + ')'
    AID TEXT NUM $!aidNumber '$!infoString' AT $!textPosition

  elseif !this.code.eq(113) then
    -- bent manually
    !this.highlightPipePiece()

  elseif !this.code.eq(201) then
    -- no suitable flange welding machines
    !this.highlightPipePiece()

  elseif !this.code.eq(202) then
    -- bending machine does not support pre-welded flanges

    !this.zoomPipeSpool()

    !flanRef = !this.args[3].dbref()
    handle ANY
    elsehandle NONE
      !this.highlight(!flanRef, false)
    endhandle

  elseif !this.code.eq(203) then
    -- bending machine does not support pre-welded lap-joint stub end
    !this.zoomPipeSpool()

    !flanRef = !this.args[3].dbref()
    handle ANY
    elsehandle NONE
      !this.highlight(!flanRef, false)
    endhandle
  elseif !this.code.eq(204) then
    -- invalid flange group
    !this.zoomPipeSpool()

    !flanRef = !this.args[3].dbref()
    handle ANY
    elsehandle NONE
      !this.highlight(!flanRef, false)
    endhandle
  elseif !this.code.eq(205) then
    -- invalid od for flange welding

    !this.zoomPipeSpool()
    !name = !this.args[3]
    !component = !name.dbref()
    handle ANY
    elsehandle NONE
      if !component.badref().not() then
        !this.highlight(!component, false)
      endif
    endhandle

  elseif !this.code.eq(206) then
    -- invalid pipe length for flange welding
    !this.zoomPipeSpool()

    !name = !this.args[3]
    !component = !name.dbref()
    handle ANY
    elsehandle NONE
      if !component.badref().not() then
        !this.highlight(!component, false)
      endif
    endhandle

    !arrive = !this.args[4]
    !tubeLength = !!comConvertUnknownValue(!this.args[5], 'MM')
    --!minPL = !!comConvertUnknownValue(!this.args[6], 'MM')
    --!maxPL = !!comConvertUnknownValue(!this.args[7], 'MM')

    if !arrive then
      !endPosition  = !component.apos
      !endDirection = !component.adir
    else
      !endPosition  = !component.lpos
      !endDirection = !component.ldir
    endif

    !outsideDiameter = !this.result.outsideDiameter()

    !pointVector = object POINTVECTOR(!endPosition, !endDirection)
    !orientation = !pointVector.plane().orientation

    !leaderLength = !outsideDiameter * 2
    !leaderDirection = !orientation.xdir()
    !position1 = !endPosition.offset(!leaderDirection, !leaderLength + 30mm)

    !leaderLine = object GPHLINE(object LINE(!endPosition, !position1))
    !leaderLine.draw(!aidNumber, false)

    !dimensionPosition1 = !endPosition.offset(!leaderDirection, !leaderLength)
    !dimensionPosition2 = !dimensionPosition1.offset(!endDirection, -300mm)
    !dimensionLine = object GPHLINE(object LINE(!dimensionPosition1, !dimensionPosition2))
    !dimensionLine.tag = true
    !dimensionLine.description = !tubeLength.string(!!distanceFmt)
    !dimensionLine.draw(!aidNumber, false)

    !arrowPosition = !dimensionPosition1.offset(!endDirection, -30mm)
    AID ARROW NUM $!aidNumber AT $!arrowPosition DIR $!endDirection HEI 30mm PROP 1

  elseif !this.code.eq(207) then
    -- manual flange welding - end excess exists
    !this.zoomPipeSpool()

    !component = !this.args[3].dbref()
    handle ANY
      return
    endhandle

    !this.highlight(!component, false)

    !arrive = !this.args[4]
    if !arrive then
      !excess = !!comConvertUnknownValue(!this.result.arriveExcess(), 'MM')
    else
      !excess = !!comConvertUnknownValue(!this.result.leaveExcess(), 'MM')
    endif

    if !arrive then
      !endPosition  = !this.toPosition(!this.result.arrivePosition())
      !endDirection = !this.toDirection(!this.result.arriveDirection())
    else
      !endPosition  = !this.toPosition(!this.result.leavePosition())
      !endDirection = !this.toDirection(!this.result.leaveDirection())
    endif

    !outsideDiameter = !this.result.outsideDiameter()

    !midPosition = !endPosition.offset(!endDirection, !excess / 2)
    !pointVector = object POINTVECTOR(!endPosition, !endDirection)
    !orientation = !pointVector.plane().orientation
    !diameter = !outsideDiameter + 2mm
    AID CYLI NUM $!aidNumber POS $!midPosition ORI $!orientation DIA $!diameter HEI $!excess FILL ON

  elseif !this.code.eq(208) then
    -- flange clashes with a collision plane
    !this.zoomPipeSpool()

    !component = !this.args[3].dbref()
    handle ANY
      return
    endhandle

    !this.highlight(!component, false)

  elseif !this.code.eq(209) then
    -- too close to machine extrusion
    --[0]  <REAL> message code
    --[1]  <REAL> message level
    --[2]  <AVEVA.PDMS.PIPEFABRICATION.FABRICATIONCHECK.PFCHECKRESULTPML> check result object
    --[3]  <BOOLEAN> arrive
    --[4]  <STRING> flange reference no.
    --[5]  <STRING> extrusion reference no.
    --[6]  <REAL> minimum distance (EAK)
    --[7]  <REAL> distance from the centre of extrusion to the surface of flange

    -- zoom spool
    !this.zoomPipeSpool()

    -- highlight flange
    !flange = !this.args[4].dbref()
    handle ANY
      return
    endhandle

    !this.highlight(!flange, false)

    -- highlight a branch including the extrusion
    !extrusion = !this.args[5].dbref()
    handle ANY
      return
    endhandle

    !this.highlight(!extrusion, false)

    !cref = !extrusion.cref
    if !cref.badref() then
      return
    endif

    !this.highlight(!cref, false)

    -- draw dimension
    !arrive = !this.args[3]
    !minDistance = !!comConvertUnknownValue(!this.args[6], 'MM')
    !distance = !!comConvertUnknownValue(!this.args[7], 'MM')

    !outsideDiameter = !!comConvertUnknownValue(!this.result.outsideDiameter(), 'MM')
    !leaderLength = !outsideDiameter * 2

    if !arrive then
      !direction = !extrusion.adir
    else
      !direction = !extrusion.ldir
    endif

    !leaderDirection = !direction.cross(!extrusion.pdir[3]).cross(!direction)

    !position1 = !extrusion.pos
    !leaderLine = object GPHLINE(object LINE(!position1, !position1.offset(!leaderDirection, !leaderLength + 30mm)))
    !leaderLine.draw(!aidNumber, false)

    !position2 = !position1.offset(!direction, !distance)
    !leaderLine = object GPHLINE(object LINE(!position2, !position2.offset(!leaderDirection, !leaderLength + 30mm)))
    !leaderLine.draw(!aidNumber, false)

    !position1 = !position1.offset(!leaderDirection, !leaderLength)
    !position2 = !position2.offset(!leaderDirection, !leaderLength)
    !dimensionLine = object GPHLINE(object LINE(!position1, !position2))
    !dimensionLine.tag = true
    !dimensionLine.description = !distance.string(!!distanceFmt) + ' < Min. ' + !minDistance.string(!!distanceFmt)
    !dimensionLine.draw(!aidNumber, false)

    !direction1 = !position2.direction(!position1)
    !arrowPosition1 = !position1.offset(!direction1, -30mm)
    AID ARROW NUM $!aidNumber AT $!arrowPosition1 DIR $!direction1 HEI 30mm PROP 1

    !direction2 = !position1.direction(!position2)
    !arrowPosition2 = !position2.offset(!direction2, -30mm)
    AID ARROW NUM $!aidNumber AT $!arrowPosition2 DIR $!direction2 HEI 30mm PROP 1

  elseif !this.code.eq(251) or !this.code.eq(252) or !this.code.eq(253) then

    !this.highlightPipePiece()

    !tubeLength = !!comConvertUnknownValue(!this.args[3], 'MM')

    !arriveBoundary = !this.pipePiece.arriveBoundary().dbref()
    handle ANY
      return
    endhandle

    !leaveBoundary = !this.pipePiece.leaveBoundary().dbref()
    handle ANY
      return
    endhandle

    !outsideDiameter = !!comConvertUnknownValue(!this.result.outsideDiameter(), 'MM')

    if !arriveBoundary.type.eq('WELD') then
      !this.highlight(!arriveBoundary, false)
      !startPosition = !arriveBoundary.pos
      !startDirection = !arriveBoundary.adir
    else
      !startDirection = !arriveBoundary.ldir.opposite()
      !startPosition = !arriveBoundary.lpos
      if !arriveBoundary.type.eq('BEND') and !arriveBoundary.actNCuts.gt(0) then
        !radius = !arriveBoundary.radius
        !angle = !arriveBoundary.angle
        !od = !arriveBoundary.lod
        !cuts = !arriveBoundary.actNCuts
        !mitreLength = (!radius - !outsideDiameter / 2.0) * TAN(!angle * 0.5 / !cuts)
        !startPosition = !startPosition.offset(!startDirection, !mitreLength)
      endif
    endif

    if !leaveBoundary.type.eq('WELD') then
      !this.highlight(!leaveBoundary, false)
      !endPosition = !leaveBoundary.pos
      !endDirection = !leaveBoundary.ldir
    else
      !endPosition = !leaveBoundary.apos
      !endDirection = !leaveBoundary.adir.opposite()
      if !leaveBoundary.type.eq('BEND') and !leaveBoundary.actNCuts.gt(0) then
        !radius = !leaveBoundary.radius
        !angle = !leaveBoundary.angle
        !od = !leaveBoundary.lod
        !cuts = !leaveBoundary.actNCuts
        !mitreLength = (!radius - !outsideDiameter / 2.0) * TAN(!angle * 0.5 / !cuts)
        !endPosition = !endPosition.offset(!endDirection, !mitreLength)
      endif
    endif

    !leaderLength = !outsideDiameter * 1.5

    !pointVector = object POINTVECTOR(!startPosition, !startDirection)
    !orientation = !pointVector.plane().orientation
    !leaderDirection = !orientation.xdir()

    !leaderLine1 = object GPHLINE(object LINE(!startPosition, !startPosition.offset(!leaderDirection, !leaderLength + 30mm)))
    !leaderLine1.draw(!aidNumber, false)

    !leaderLine2 = object GPHLINE(object LINE(!endPosition, !endPosition.offset(!leaderDirection, !leaderLength + 30mm)))
    !leaderLine2.draw(!aidNumber, false)

    !dimensionPos1 = !startPosition.offset(!leaderDirection, !leaderLength)
    !dimensionPos2 = !endPosition.offset(!leaderDirection, !leaderLength)
    !dimensionLine = object GPHLINE(object LINE(!dimensionPos1, !dimensionPos2))
    !dimensionLine.tag = true
    !dimensionLine.description = !tubeLength.string(!!distanceFmt)
    !dimensionLine.draw(!aidNumber, false)

    !arrowPos1 = !dimensionPos1.offset(!startDirection, -30mm)
    !arrowPos2 = !dimensionPos2.offset(!endDirection, -30mm)

    AID ARROW NUM $!aidNumber AT $!arrowPos1 DIR $!startDirection HEI 30mm PROP 1
    AID ARROW NUM $!aidNumber AT $!arrowPos2 DIR $!endDirection HEI 30mm PROP 1


  elseif !this.code.eq(301) then
    -- no extrusion machines
    !this.zoomPipeSpool()

    !names = !this.pipePiece.extrusionComponents()
    do !name values !names
      !component = !name.dbref()
      handle ANY
      elsehandle NONE

        !cref = !component.cref
        if !cref.badref().not() then
          !this.highlight(!cref, false)
        endif
      endhandle
    enddo

  elseif !this.code.eq(302) then
    -- too sloping

    !component = !this.args[3].dbref()
    handle ANY
      return
    endhandle

    !this.highlight(!component, false)

    !angle = !!comConvertUnknownValue(!this.args[4], 'DEG')
    !tolerance = !!comConvertUnknownValue(!this.args[5], 'DEG')

    !cref = !component.cref
    if !cref.badref() then
      return
    endif

    !this.highlight(!cref, false)
    !this.zoomPipeSpool()

    !ppoint = !this.getConnectionPoint(!component)
    !outsideDiameter = !!comConvertUnknownValue(!this.result.outsideDiameter(), 'MM')

    !branchPosition = !component.ppos[!ppoint]
    !branchDirection = !component.pdir[!ppoint]

    !pointVector = object POINTVECTOR(!component.apos, !component.adir)
    !line = !pointVector.line(1000mm)
    !normalDirection = !line.near(!branchPosition).direction(!branchPosition)

    !viewDirection = !normalDirection.cross(!branchDirection)
    !viewDir = object ARRAY()
    !viewDir[1] = !!comValueConvert(!viewDirection.east, 'MM')
    !viewDir[2] = !!comValueConvert(!viewDirection.north, 'MM')
    !viewDir[3] = !!comValueConvert(!viewDirection.up, 'MM')
    !!fmSys.currentDocument().view.direction = !viewDir

    !leaderLength = !outsideDiameter * 3

    !endPosition1 = !branchPosition.offset(!branchDirection, !leaderLength)
    !endPosition2 = !branchPosition.offset(!normalDirection, !leaderLength)

    !leaderLine1 = object GPHLINE(object LINE(!branchPosition, !endPosition1))
    !leaderLine2 = object GPHLINE(object LINE(!branchPosition, !endPosition2))
    !leaderLine1.draw(!aidNumber, false)
    !leaderLine2.draw(!aidNumber, false)
    AID ARROW NUM $!aidNumber AT $!endPosition1 DIR $!branchDirection HEI 30mm PROP 1
    AID ARROW NUM $!aidNumber AT $!endPosition2 DIR $!normalDirection HEI 30mm PROP 1

    !midPosition = !branchPosition.offset(!branchDirection.bisect(!normalDirection), !leaderLength)
    !arc = !endPosition1.arcThru(!midPosition, !endPosition2, !normalDirection.cross(!branchDirection))
    !dimensionArc = object GPHCIRCLE(!arc)
    !dimensionArc.detail = false
    !dimensionArc.draw(!aidNumber, false)

    !infoString = 'Angle ' + !angle.string(!!angleFmt) + ' > Tolerance ' + !tolerance.string(!!angleFmt) + ')'
    !midPosition = !endPosition1.midPoint(!endPosition2)
    !textPosition = !branchPosition.offset(!branchPosition.direction(!midPosition), !leaderLength + 30mm)
    AID TEXT NUM $!aidNumber '$!infoString' AT $!textPosition

  elseif !this.code.eq(303) then
    -- not on straight tube
    !component = !this.args[3].dbref()
    handle ANY
      return
    endhandle

    !this.highlight(!component, false)

    !cref = !component.cref
    if !cref.badref().not() then
      !this.highlight(!cref, false)
    endif

    !this.zoomPipeSpool()

  elseif !this.code.eq(304) then

    -- too close to bend
    !component = !this.args[3].dbref()
    handle ANY
      return
    endhandle

    !bend = !this.args[4].dbref()
    handle ANY
      return
    endhandle

    !cref = !component.cref
    if !cref.badref() then
      return
    endif

    !this.highlight(!cref, false)
    !this.zoomPipeSpool()

    !minDistance = !!comConvertUnknownValue(!this.args[5], 'MM')

    if !component.seq.lt(!bend.seq) then
      !bendPosition = !bend.apos
    else
      !bendPosition = !bend.lpos
    endif

    !distance = !component.pos.distance(!bendPosition)

    !outsideDiameter = !!comConvertUnknownValue(!this.result.outsideDiameter(), 'MM')
    !leaderLength = !outsideDiameter * 2

    !ppoint = !this.getConnectionPoint(!component)
    !direction = !component.pdir[!ppoint].opposite()

    !position1 = !component.pos
    !leaderLine = object GPHLINE(object LINE(!position1, !position1.offset(!direction, !leaderLength + 30mm)))
    !leaderLine.draw(!aidNumber, false)

    !position2 = !bendPosition
    !leaderLine = object GPHLINE(object LINE(!position2, !position2.offset(!direction, !leaderLength + 30mm)))
    !leaderLine.draw(!aidNumber, false)

    !position1 = !position1.offset(!direction, !leaderLength)
    !position2 = !position2.offset(!direction, !leaderLength)
    !dimensionLine = object GPHLINE(object LINE(!position1, !position2))
    !dimensionLine.tag = true
    !dimensionLine.description = !distance.string(!!distanceFmt) + ' < Min. ' + !minDistance.string(!!distanceFmt)
    !dimensionLine.draw(!aidNumber, false)

    !direction1 = !position2.direction(!position1)
    !arrowPosition1 = !position1.offset(!direction1, -30mm)
    AID ARROW NUM $!aidNumber AT $!arrowPosition1 DIR $!direction1 HEI 30mm PROP 1

    !direction2 = !position1.direction(!position2)
    !arrowPosition2 = !position2.offset(!direction2, -30mm)
    AID ARROW NUM $!aidNumber AT $!arrowPosition2 DIR $!direction2 HEI 30mm PROP 1

  elseif !this.code.eq(305) then

    -- too close to previous/next extrusion
    !component1 = !this.args[3].dbref()
    handle ANY
      return
    endhandle

    !this.highlight(!component1, false)

    !cref = !component1.cref
    if !cref.badref() then
      return
    endif

    !component2 = !this.args[4].dbref()
    handle ANY
      return
    endhandle

    !this.highlight(!cref, false)
    !this.zoomPipeSpool()

    !minDistance = !!comConvertUnknownValue(!this.args[5], 'MM')
    !distance = !component1.pos.distance(!component2.pos)
    !outsideDiameter = !!comConvertUnknownValue(!this.result.outsideDiameter(), 'MM')
    !leaderLength = !outsideDiameter * 2

    !ppoint = !this.getConnectionPoint(!component1)
    !direction = !component1.pdir[!ppoint].opposite()

--    !viewDirection = !component1.adir.cross(!direction)
--    !viewDir = object ARRAY()
--    !viewDir[1] = !!comValueConvert(!viewDirection.east, 'MM')
--    !viewDir[2] = !!comValueConvert(!viewDirection.north, 'MM')
--    !viewDir[3] = !!comValueConvert(!viewDirection.up, 'MM')
--    !!fmSys.currentDocument().view.direction = !viewDir

    !position1 = !component1.pos
    !leaderLine = object GPHLINE(object LINE(!position1, !position1.offset(!direction, !leaderLength + 30mm)))
    !leaderLine.draw(!aidNumber, false)

    !position2 = !component2.pos
    !leaderLine = object GPHLINE(object LINE(!position2, !position2.offset(!direction, !leaderLength + 30mm)))
    !leaderLine.draw(!aidNumber, false)

    !position1 = !position1.offset(!direction, !leaderLength)
    !position2 = !position2.offset(!direction, !leaderLength)
    !dimensionLine = object GPHLINE(object LINE(!position1, !position2))
    !dimensionLine.tag = true
    !dimensionLine.description = !distance.string(!!distanceFmt) + ' < Min. ' + !minDistance.string(!!distanceFmt)
    !dimensionLine.draw(!aidNumber, false)

    !direction1 = !position2.direction(!position1)
    !arrowPosition1 = !position1.offset(!direction1, -30mm)
    AID ARROW NUM $!aidNumber AT $!arrowPosition1 DIR $!direction1 HEI 30mm PROP 1

    !direction2 = !position1.direction(!position2)
    !arrowPosition2 = !position2.offset(!direction2, -30mm)
    AID ARROW NUM $!aidNumber AT $!arrowPosition2 DIR $!direction2 HEI 30mm PROP 1

  elseif !this.code.eq(306) then
    -- too close to pipe end
    !component = !this.args[3].dbref()
    handle ANY
      return
    endhandle

    !this.highlight(!component, false)

    !cref = !component.cref
    if !cref.badref() then
      return
    endif

    !this.highlight(!cref, false)
    !this.zoomPipeSpool()

    !this.highlight(!component)

    !arrive = !this.args[4]
    !distance = !!comConvertUnknownValue(!this.args[5], 'MM')
    !minDistance = !!comConvertUnknownValue(!this.args[6], 'MM')
    !outsideDiameter = !!comConvertUnknownValue(!this.result.outsideDiameter(), 'MM')
    !leaderLength = !outsideDiameter * 2

    !ppoint = !this.getConnectionPoint(!component)
    !direction = !component.pdir[!ppoint].opposite()
    !direction = !direction.cross(!component.adir).cross(!component.adir)

    !position1 = !component.pos
    !leaderLine = object GPHLINE(object LINE(!position1, !position1.offset(!direction, !leaderLength + 30mm)))
    !leaderLine.draw(!aidNumber, false)

    if !arrive then
      !position2 = !position1.offset(!component.adir, !distance)
    else
      !position2 = !position1.offset(!component.ldir, !distance)
    endif
    !leaderLine = object GPHLINE(object LINE(!position2, !position2.offset(!direction, !leaderLength + 30mm)))
    !leaderLine.draw(!aidNumber, false)

    !position1 = !position1.offset(!direction, !leaderLength)
    !position2 = !position2.offset(!direction, !leaderLength)
    !dimensionLine = object GPHLINE(object LINE(!position1, !position2))
    !dimensionLine.tag = true
    !dimensionLine.description = !distance.string(!!distanceFmt) + ' < Min. ' + !minDistance.string(!!distanceFmt)
    !dimensionLine.draw(!aidNumber, false)

    !direction1 = !position2.direction(!position1)
    !arrowPosition1 = !position1.offset(!direction1, -30mm)
    AID ARROW NUM $!aidNumber AT $!arrowPosition1 DIR $!direction1 HEI 30mm PROP 1

    !direction2 = !position1.direction(!position2)
    !arrowPosition2 = !position2.offset(!direction2, -30mm)
    AID ARROW NUM $!aidNumber AT $!arrowPosition2 DIR $!direction2 HEI 30mm PROP 1

  elseif !this.code.eq(307) then
    -- extrusion position is too high
    !component = !this.args[3].dbref()
    handle ANY
      return
    endhandle

    !this.highlight(!component, false)

    !cref = !component.cref
    if !cref.badref() then
      return
    endif

    !this.highlight(!cref, false)

    !machineHeight = !!comConvertUnknownValue(!this.args[4], 'MM')

    !ppoint = !this.getConnectionPoint(!component)

    !position = !component.pos
    --!extrusionDirection = !component.pdir[!ppoint]
    --!bottomDirection = !extrusionDirection.opposite()
    !branchPosition = !component.ppos[3]
    !bottomDirection = !branchPosition.direction(!position)
    !extrusionDirection = !bottomDirection.opposite()
    !bottomPosition = !position.offset(!bottomDirection, !machineHeight)
    !pointVector = object POINTVECTOR(!bottomPosition, !extrusionDirection)
    !bottomPlane = !pointVector.plane()

    !names = !this.pipePiece.allComponents()
    !components = object ARRAY()
    do !name values !names
      !component1 = !name.dbref()
      handle ANY
      elsehandle NONE
        !components.append(!component1)
      endhandle
    enddo
    !volume = object VOLUME(!components)
    !size = !volume.from.distance(!volume.to) * 1.5

    !this.zoomPipeSpool()

    !plane = object GPHPLANE(!bottomPlane)
    !plane.x = !size
    !plane.y = !size
    !plane.filled(true)
    !plane.draw(!aidNumber, false)

    !dimensionLine = object GPHLINE(object LINE(!position, !bottomPosition))
    !dimensionLine.description = 'Machine height : ' + !machineHeight.string(!!distanceFmt)
    !dimensionLine.tag = true

    !dimensionLine.draw(!aidNumber, false)

    !arrowPosition1 = !position.offset(!bottomDirection, 30mm)
    !arrowPosition2 = !bottomPosition.offset(!extrusionDirection, 30mm)
    AID ARROW NUM $!aidNumber AT $!arrowPosition1  DIR $!extrusionDirection HEI 30mm PROP 1
    AID ARROW NUM $!aidNumber AT $!arrowPosition2  DIR $!bottomDirection HEI 30mm PROP 1

  elseif !this.code.eq(308) then
    -- no extrusion dimension defined
    !component = !this.args[3].dbref()
    handle ANY
      return
    endhandle

    !this.highlight(!component, false)

    !cref = !component.cref
    if !cref.badref() then
      return
    endif

    !this.highlight(!cref, false)
    !this.zoomPipeSpool()

  elseif !this.code.eq(309) then
    -- no minimum distance between extrusions defined
    !component = !this.args[3].dbref()
    handle ANY
      return
    endhandle

    !this.highlight(!component, false)

    !cref = !component.cref
    if !cref.badref() then
      return
    endif

    !this.highlight(!cref, false)
    !this.zoomPipeSpool()

  elseif !this.code.eq(310) then
    -- unconnected extrusions
    !component = !this.args[3].dbref()
    handle ANY
      return
    endhandle

    !this.highlight(!component, false)
    !this.zoomPipeSpool()

    !outsideDiameter = !!comConvertUnknownValue(!this.result.outsideDiameter(), 'MM')
    !pointVector = object POINTVECTOR(!component.pos, !component.adir)

    !plane = object GPHPLANE(!pointVector.plane())
    !plane.x = !outsideDiameter * 2
    !plane.y = !outsideDiameter * 2
    !plane.filled(true)
    !plane.draw(!aidNumber, false)

    !!ce = !component

  elseif !this.code.eq(311) then
    -- automated end excess for extrusion

    !component = !this.args[3].dbref()
    handle ANY
      return
    endhandle

    !this.highlight(!component, false)

    !cref = !component.cref
    if !cref.badref() then
      return
    endif

    !this.highlight(!component, false)
    !this.highlight(!cref, false)
    !this.zoomPipeSpool()

    !arrive = !this.args[4]
    !distanceToEnd   = !!comConvertUnknownValue(!this.args[5], 'MM')
    !minLength = !!comConvertUnknownValue(!this.args[6], 'MM')
    !excess = !minLength - !distanceToEnd

    if !arrive then
      !endPosition  = !this.toPosition(!this.result.arrivePosition())
      !endDirection = !this.toDirection(!this.result.arriveDirection())
    else
      !endPosition  = !this.toPosition(!this.result.leavePosition())
      !endDirection = !this.toDirection(!this.result.leaveDirection())
    endif

    !outsideDiameter = !!comConvertUnknownValue(!this.result.outsideDiameter(), 'MM')

    !midPosition = !endPosition.offset(!endDirection, !excess / 2)
    !pointVector = object POINTVECTOR(!endPosition, !endDirection)
    !orientation = !pointVector.plane().orientation
    !diameter = !outsideDiameter + 2mm
    AID CYLI NUM $!aidNumber POS $!midPosition ORI $!orientation DIA $!diameter HEI $!excess FILL ON

    !textPosition = !endPosition.offset(!orientation.xdir(), !diameter * 0.7).offset(!endDirection, !excess / 2)
    !infoString = 'End excess : ' + !excess.string(!!distanceFmt)
    AID TEXT NUM $!aidNumber '$!infoString' AT $!textPosition

  elseif !this.code.eq(312) then
    -- invalid collar height
    !component = !this.args[3].dbref()
    handle ANY
      return
    endhandle

    !this.highlight(!component, false)

    !cref = !component.cref
    if !cref.badref() then
      return
    endif

    !this.highlight(!component, false)
    !this.highlight(!cref, false)
    !this.zoomPipeSpool()

    !collarHeight = !!comConvertUnknownValue(!this.args[4], 'MM')
    !machineDefined = !!comConvertUnknownValue(!this.args[5], 'MM')

    !position = !component.pos
    !infoString = 'Collar height ' + !collarHeight.string(!!distanceFmt) + ' (Machine defined ' + !machineDefined.string(!!distanceFmt) + ')'
    AID TEXT NUM $!aidNumber '$!infoString' AT $!position

  elseif !this.code.eq(313) then
    -- Length including end excess for extrusion is longer than max. pipe length for pre-welded flanges
    --    [0]  code
    --    [1]  error level
    --    [2]  check result object
    --    [3]  extrusion element
    --    [4]  arrive
    --    [5]  excess
    --    [6]  length including excess
    --    [7]  max pipe length
    --    [8]  pre-welded flange

    -- highlight the branch including the extrusion
    !component = !this.args[3].dbref()
    handle ANY
      return
    endhandle

    !this.highlight(!component, false)

    !cref = !component.cref
    if !cref.badref() then
      return
    endif

    !this.highlight(!component, false)
    !this.highlight(!cref, false)

    -- highlight flange
    !flange = !this.args[8].dbref()
    handle ANY
    elsehandle NONE
      !this.highlight(!flange, false)
    endhandle

    -- zoom spool
    !this.zoomPipeSpool()

    -- draw end excess
    !arrive = !this.args[4]
    !excess = !!comConvertUnknownValue(!this.args[5], 'MM')

    if !arrive then
      !endPosition  = !this.toPosition(!this.result.arrivePosition())
      !endDirection = !this.toDirection(!this.result.arriveDirection())
    else
      !endPosition  = !this.toPosition(!this.result.leavePosition())
      !endDirection = !this.toDirection(!this.result.leaveDirection())
    endif

    !outsideDiameter = !!comConvertUnknownValue(!this.result.outsideDiameter(), 'MM')

    !midPosition = !endPosition.offset(!endDirection, !excess / 2)
    !pointVector = object POINTVECTOR(!endPosition, !endDirection)
    !orientation = !pointVector.plane().orientation
    !diameter = !outsideDiameter + 2mm
    AID CYLI NUM $!aidNumber POS $!midPosition ORI $!orientation DIA $!diameter HEI $!excess FILL ON

    -- draw dimension

    !lengthIncludingExcess = !!comConvertUnknownValue(!this.args[6], 'MM')
    !maxLP = !!comConvertUnknownValue(!this.args[7], 'MM')

    !position = !endPosition.offset(!endDirection, !excess)
    !leaderDirection = !component.pdir[3].cross(!component.adir).cross(!component.adir)

    !leaderLength = !diameter * 2
    !position1 = !position.offset(!leaderDirection, !leaderLength + 30mm)

    !leaderLine = object GPHLINE(object LINE(!position, !position1))
    !leaderLine.draw(!aidNumber, false)

    !dimensionPosition1 = !position.offset(!leaderDirection, !leaderLength)
    !dimensionPosition2 = !dimensionPosition1.offset(!endDirection, -300mm)
    !dimensionLine = object GPHLINE(object LINE(!dimensionPosition1, !dimensionPosition2))
    !dimensionLine.tag = true
    !dimensionLine.description = !lengthIncludingExcess.string(!!distanceFmt) + ' > Max. ' + !maxLP.string(!!distanceFmt)
    !dimensionLine.draw(!aidNumber, false)

    !arrowPosition = !dimensionPosition1.offset(!endDirection, -30mm)
    AID ARROW NUM $!aidNumber AT $!arrowPosition DIR $!endDirection HEI 30mm PROP 1

  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      getConnectionPoint
-- Description: return connection ppoint number
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       component
-- Return:
--   [Data Type] [Description]
--    REAL        ppoint number
------------------------------------------------------------------------
define method .getConnectionPoint(!component is DBREF) is REAL
  !arrive = !component.arrive
  !leave = !component.leave

  if !arrive.eq(1) and !leave.eq(2) then
    !ppoint = 3
  elseif !arrive.eq(1) and !leave.eq(3) then
    !ppoint = 2
  elseif !arrive.eq(2) and !leave.eq(1) then
    !ppoint = 3
  elseif !arrive.eq(2) and !leave.eq(3) then
    !ppoint = 1
  elseif !arrive.eq(3) and !leave.eq(1) then
    !ppoint = 2
  else
    !ppoint = 1
  endif

  return !ppoint
endmethod

------------------------------------------------------------------------
--
-- Method:      toPosition
-- Description: convert the given array of real to position object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array of real
-- Return:
--   [Data Type] [Description]
--    POSITION    position object
------------------------------------------------------------------------
define method .toPosition(!xyz is ARRAY) is POSITION
  !position = object POSITION()
  !position.origin = /*
  !position.east  = !!comConvertUnknownValue(!xyz[1], 'MM')
  !position.north = !!comConvertUnknownValue(!xyz[2], 'MM')
  !position.up    = !!comConvertUnknownValue(!xyz[3], 'MM')
  return !position
endmethod

------------------------------------------------------------------------
--
-- Method:      toDirection
-- Description: convert the given array of real to direction object
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       array of real
-- Return:
--   [Data Type] [Description]
--    POSITION    direction object
------------------------------------------------------------------------
define method .toDirection(!xyz is ARRAY) is DIRECTION
  !direction = object DIRECTION()
  !direction.origin = /*
  !direction.east  = !!comConvertUnknownValue(!xyz[1], 'MM')
  !direction.north = !!comConvertUnknownValue(!xyz[2], 'MM')
  !direction.up    = !!comConvertUnknownValue(!xyz[3], 'MM')
  return !direction
endmethod

------------------------------------------------------------------------
--
-- Method:      highlightPipePiece
-- Description: highlight pipe piece
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .highlightPipePiece()
  !this.highlightPipePiece(true)
endmethod

------------------------------------------------------------------------
--
-- Method:      highlightPipePiece
-- Description: highlight pipe piece
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     true if zoom is wanted
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .highlightPipePiece(!zoom is BOOLEAN)
  !names = !this.pipePiece.allComponents()
  !components = object ARRAY()
  do !name values !names
    !component = !name.dbref()
    handle ANY
    elsehandle NONE
      !components.append(!component)
    endhandle
  enddo
  !this.highlight(!components, false)

  if !zoom then
    --!this.zoom(object VOLUME(!components))
    !this.zoomPipeSpool()
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      zoomPipeSpool
-- Description: zoom pipe spool
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .zoomPipeSpool()
  !this.zoomPipeSpool(100.0mm)
endmethod

------------------------------------------------------------------------
--
-- Method:      zoomPipeSpool
-- Description: zoom pipe piece
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        margin
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .zoomPipeSpool(!margin is REAL)
  !pipeSpool = !this.pipePiece.pipeSpool()
  !namesByBranch = !pipeSpool.allComponents()
  !components = object ARRAY()
  do !names values !namesByBranch
    do !name values !names
      !component = !name.dbref()
      handle ANY
      elsehandle NONE
        if !component.type.neq('BRAN') then
          !components.append(!component)
        endif
      endhandle
    enddo
  enddo
  if !components.empty().not() then

    !volume = object VOLUME(!components)
    !volume.from.east  = !volume.from.east  - !margin
    !volume.from.north = !volume.from.north - !margin
    !volume.from.up    = !volume.from.up    - !margin
    !volume.to.east    = !volume.to.east    + !margin
    !volume.to.north   = !volume.to.north   + !margin
    !volume.to.up      = !volume.to.up      + !margin

    !this.zoom(!volume)
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      highlight
-- Description: highlight a component
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF        component
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .highlight(!component is DBREF)
  !this.highlight(!component, true)
endmethod

------------------------------------------------------------------------
--
-- Method:      highlight
-- Description: highlight components
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       components
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .highlight(!components is ARRAY)
  !this.highlight(!components, true)
endmethod

------------------------------------------------------------------------
--
-- Method:      highlight
-- Description: highlight a component
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       components
--    2   R      BOOLEAN     true if zoom is wanted
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .highlight(!component is DBREF, !zoom is BOOLEAN)

  ENHANCE $!component COLOUR $!!gphColOpt.highlight

  if !component.type.eq('PTAP') then
    do !member values !component.members
      ENHANCE $!member COLOUR $!!gphColOpt.highlight
    enddo
  endif

  if !zoom then
    --!this.zoom(object VOLUME(!component))
    !this.zoomPipeSpool()
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:      highlight
-- Description: highlight components
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       components
--    2   R      BOOLEAN     true if zoom is wanted
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .highlight(!components is ARRAY, !zoom is BOOLEAN)

  do !component values !components
    ENHANCE $!component COLOUR $!!gphColOpt.highlight
  enddo

  if !zoom then
    --if !components.empty().not() then
    --  !this.zoom(object VOLUME(!components))
    --endif
    !this.zoomPipeSpool()
  endif

endmethod

--------------------------------------------------------------------------------
--
-- Method:      zoom
--
-- Description: zoom to the given volume
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--    1    R      VOLUME                       volume object
-- Return:
--   [Data Type]             [Description]
--
--------------------------------------------------------------------------------
define method .zoom(!volume is VOLUME)

  !from = !volume.from
  !to   = !volume.to

  -- Through Point
  !throughPoint   = !from.midPoint(!to)
  handle ANY
    return
  endhandle

  -- Set through point
  !through[1] = !!comConvertUnknownValue(!throughPoint.east, 'MM')
  !through[2] = !!comConvertUnknownValue(!throughPoint.north, 'MM')
  !through[3] = !!comConvertUnknownValue(!throughPoint.up, 'MM')
  !!fmSys.currentDocument().view.through = !through

  -- Set view radius
  !radius = !!comConvertUnknownValue(!from.distance(!to) / 2.0, 'MM')
  !radius = !radius.max(500mm)
  !!fmSys.currentDocument().view.radius  = !radius

endmethod

--------------------------------------------------------------------------------
--
-- Method:      renderDetail
--
-- Description: display detail information of check result
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--    1    R      REAL                         AID number
--    2    R      ARRAY                        event arguments
-- Return:
--   [Data Type]             [Description]
--
--------------------------------------------------------------------------------
define method .renderDetail(!aidNo is REAL, !args is ARRAY)
  using namespace 'Aveva.Pdms.PipeFabrication.FabricationCheck'

  !pipePiece = !args[0]
  !id = !args[1].last()

  !this.pipePiece = !pipePiece

  UNENHANCE ALL
  !!aidNumbers.hide(!aidNo)

  !this.highlightPipePiece(true)

  !status = !pipePiece.fabricationStatus()
  if !status.eq('ValidationRequired') then
    return
  endif

  !ppieceRef = !pipePiece.ppieceElement().dbref()
  handle ANY
    !ppieceRef = object DBREF()
  endhandle

  !result = !pipePiece.checkResult()

  if !id.eq('CLUTCH') then

    !bends = !pipePiece.bendComponents()
    if !bends.empty() then
      return
    endif

    !arriveBoundary = !pipePiece.arriveBoundary().dbref()
    handle ANY
      return
    endhandle

    !leaveBoundary = !pipePiece.leaveBoundary().dbref()
    handle ANY
      return
    endhandle

    if !status.eq('ReadyForFabrication') and !ppieceRef.badref().not() then
      !clutch = !ppieceRef.bwithf.not()
    else
      !clutch = !result.bendingDirectionForward().not()
    endif

    if !arriveBoundary.type.eq('BRAN') then
      !od = !arriveBoundary.phod
    else
      !od = !arriveBoundary.lod
    endif

    if !clutch then
      if !arriveBoundary.type.eq('BRAN') then
        !position = !arriveBoundary.hpos
        !direction = !arriveBoundary.hdir.opposite()
      else
        !position = !arriveBoundary.lpos
        !direction = !arriveBoundary.ldir.opposite()
      endif
      !mitreLength = !!comConvertUnknownValue(!pipePiece.arriveMitreLength(), 'MM')
      if !mitreLength.gt(0) then
        !position = !position.offset(!direction, !mitreLength)
      endif
    else
      if !leaveBoundary.type.eq('BRAN') then
        !position = !leaveBoundary.tpos
        !direction = !leaveBoundary.tdir.opposite()
      else
        !position = !leaveBoundary.apos
        !direction = !leaveBoundary.adir.opposite()
      endif
      !mitreLength = !!comConvertUnknownValue(!pipePiece.leaveMitreLength(), 'MM')
      if !mitreLength.gt(0) then
        !position = !position.offset(!direction, !mitreLength)
      endif
    endif

    !vector = object POINTVECTOR(!position, !direction)
    !plane = object GPHPLANE(!vector.plane())
    !plane.x = !od * 2
    !plane.y = !od * 2
    !plane.filled(true)
    !plane.draw(!aidNo, false)

  elseif !id.eq('ARRIVE_FLANGE') then

    !component = !pipePiece.arriveComponent().dbref()
    handle ANY
    elsehandle NONE
      if !component.type inset ('FLAN', 'LJSE') then
        !this.highlight(!component, true)
      endif
    endhandle
  elseif !id.eq('LEAVE_FLANGE') then

    !component = !pipePiece.leaveComponent().dbref()
    handle ANY
    elsehandle NONE
      if !component.type inset ('FLAN', 'LJSE') then
        !this.highlight(!component, true)
      endif
    endhandle

  elseif !id.eq('USER_ARRIVE_EXCESS') then

    if !status.eq('ReadyForFabrication') and !ppieceRef.badref().not() then
      !excess = !ppieceRef.uaexss
    else
      !excess = !!comConvertUnknownValue(!result.userArriveExcess(), 'MM')
    endif

    !this.displayEndExcess(!aidNo, true, !excess)

  elseif !id.eq('USER_LEAVE_EXCESS') then

    if !status.eq('ReadyForFabrication') and !ppieceRef.badref().not() then
      !excess = !ppieceRef.ueexss
    else
      !excess = !!comConvertUnknownValue(!result.userLeaveExcess(), 'MM')
    endif

    !this.displayEndExcess(!aidNo, false, !excess)

  elseif !id.eq('BEND_ARRIVE_EXCESS') then

    if !status.eq('ReadyForFabrication') and !ppieceRef.badref().not() then
      !excess = !ppieceRef.baexss
    else
      !excess = !!comConvertUnknownValue(!result.bendingArriveExcess(), 'MM')
    endif

    !this.displayEndExcess(!aidNo, true, !excess)

  elseif !id.eq('BEND_LEAVE_EXCESS') then
    if !status.eq('ReadyForFabrication') and !ppieceRef.badref().not() then
      !excess = !ppieceRef.blexss
    else
      !excess = !!comConvertUnknownValue(!result.bendingLeaveExcess(), 'MM')
    endif

    !this.displayEndExcess(!aidNo, false, !excess)

  elseif !id.eq('EXTR_ARRIVE_EXCESS') then

    if !status.eq('ReadyForFabrication') and !ppieceRef.badref().not() then
      !excess = !ppieceRef.aexcess
    else
      !excess = !!comConvertUnknownValue(!result.extrusionArriveExcess(), 'MM')
    endif

    !this.displayEndExcess(!aidNo, true, !excess)

  elseif !id.eq('EXTR_LEAVE_EXCESS') then

    if !status.eq('ReadyForFabrication') and !ppieceRef.badref().not() then
      !excess = !ppieceRef.lexcess
    else
      !excess = !!comConvertUnknownValue(!result.extrusionLeaveExcess(), 'MM')
    endif

    !this.displayEndExcess(!aidNo, false, !excess)

  elseif !id.eq('USER_FEED_EXCESS') or !id.eq('MACH_FEED_EXCESS') then

    !bends = !pipePiece.bendComponents()
    if !bends.empty() then
      return
    endif

    !bendRefs = object ARRAY()
    do !bend values !bends
      !bendRef = !bend.dbref()
      handle ANY
        return
      endhandle
      if !bendRef.badref().not() then
        !bendRefs.append(!bendRef)
      endif
    enddo

    if !bendRefs.empty() then
      return
    endif

    if !id.eq('USER_FEED_EXCESS') then
      if !status.eq('ReadyForFabrication') and !ppieceRef.badref().not() then
        !excessList = !ppieceRef.minfed
      else
        !excessList = object ARRAY()
        do !value values !result.userFeedExcesses()
          !excess = !!comConvertUnknownValue(!value, 'MM')
          !excessList.append(!excess)
        enddo
      endif
    else
      if !status.eq('ReadyForFabrication') and !ppieceRef.badref().not() then
        !excessList = !ppieceRef.fedexs
      else
        !excessList = object ARRAY()
        do !value values !result.machineFeedExcesses()
          !excess = !!comConvertUnknownValue(!value, 'MM')
          !excessList.append(!excess)
        enddo
      endif
    endif

    !bendCount = !bendRefs.size()
    do !i to !bendCount - 1

      !bendRef1 = !bendRefs[!i]
      !bendRef2 = !bendRefs[!i + 1]

      !position = !bendRef1.lpos.midPoint(!bendRef2.apos)

      !excess = 0
      if defined(!excessList[!i]) then
        !excess = !excessList[!i]
      endif

      !infoString = !excess.string(!!distanceFmt)
      AID TEXT NUM $!aidNo '$!infoString' AT $!position

    enddo
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      displayEndExcess
--
-- Description: display end excess
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--    1    R      REAL                         AID number
--    2    R      BOOLEAN                      arrive or leave
--    3    R      REAL                         excess length
-- Return:
--   [Data Type]             [Description]
--
--------------------------------------------------------------------------------
define method .displayEndExcess(!aidNumber is REAL, !arrive is BOOLEAN, !excess is REAL)

  using namespace 'Aveva.Pdms.PipeFabrication.FabricationCheck'

  if !excess.eq(0) then
    return
  endif

  !arriveBoundary = !this.pipePiece.arriveBoundary().dbref()
  handle ANY
    return
  endhandle

  !leaveBoundary = !this.pipePiece.leaveBoundary().dbref()
  handle ANY
    return
  endhandle

  if !arriveBoundary.type.eq('BRAN') then
    !od = !arriveBoundary.phod
  else
    !od = !arriveBoundary.lod
  endif

  if !arrive then
    if !arriveBoundary.type.eq('BRAN') then
      !position = !arriveBoundary.hpos
      !direction = !arriveBoundary.hdir.opposite()
    else
      !position = !arriveBoundary.lpos
      !direction = !arriveBoundary.ldir.opposite()
    endif
    !mitreLength = !!comConvertUnknownValue(!this.pipePiece.arriveMitreLength(), 'MM')
    if !mitreLength.gt(0) then
      !position = !position.offset(!direction, !mitreLength)
    endif
  else
    if !leaveBoundary.type.eq('BRAN') then
      !position = !leaveBoundary.tpos
      !direction = !leaveBoundary.tdir.opposite()
    else
      !position = !leaveBoundary.apos
      !direction = !leaveBoundary.adir.opposite()
    endif
    !mitreLength = !!comConvertUnknownValue(!this.pipePiece.leaveMitreLength(), 'MM')
    if !mitreLength.gt(0) then
      !position = !position.offset(!direction, !mitreLength)
    endif
  endif

  !midPosition = !position.offset(!direction, !excess / 2)
  !pointVector = object POINTVECTOR(!position, !direction)
  !orientation = !pointVector.plane().orientation
  !diameter = !od + 2mm
  AID CYLI NUM $!aidNumber POS $!midPosition ORI $!orientation DIA $!diameter HEI $!excess FILL ON

  !textPosition = !position.offset(!orientation.xdir(), !od * 0.7).offset(!direction, !excess / 2)
  !infoString = !excess.string(!!distanceFmt)
  AID TEXT NUM $!aidNumber '$!infoString' AT $!textPosition

endmethod
