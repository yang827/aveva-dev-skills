--
--  File:            pfFileManager.pmlobj
--  Author:          tony martin
--  Created:         13/04/2016
--
--  Description:  Manages all of the file interactions in pipe fabrication spool drawing generation
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  constructDrawingStatus(FILE)     STRING              create a string describing the files available
--  createPreviewFile()              FILE                copies the preview file into the preview directory
--  deleteFile(FILE)                 BOOLEAN             delete the passed file
--  deleteFile(STRING)               BOOLEAN             convert the passed string to a file and get it deleted
--  deleteIsoFiles()                 -
--  deleteOldPreviews()              -                   deletes any preview file that it can
--  getDirectories()                 -                   ensure that all base directories are set and have been created
--  getIsoDirectory()                -
--  getPdmsUserPath()                -                   get the pdmsuser path from pdmsuser evar
--  getPlotDirectoryName()           -                   remove trailing \ to avoid double ones later
--  getPlotFile()                    FILE                return a file object with the name of the expected plotfile
--  getPreviewDirectory()            -                   find the
--  getSpoolFileData(DBREF,STRING)   STRING              returns a string to populate the table drawing form
--  getSpoolNames(DBREF)             STRING              gets any existing files for preview or plotting
--  getUnderlayFileNames()           -                   get the names of the iso directory and iso files for the
--  initialise()                     -                   go and investigate what it can find
--  pfFileManager()                  -                   Basic Constructor method
--  pfFileManager(DBREF,STRING)      -                   Constructor method with passed spool and reginame
--  pfFileManager(DBREF,STRING,STRING,STRING) -
--  pfFileManager(STRING,STRING)     -                   Constructor method
--  removeTrailingBackslash(STRING)  STRING              remove trailing \ to avoid double ones later
--  renameIsoPlotFile()              -                   remove the 001 from the isodraft output file
--  setDepartmentName(STRING)        -                   set the department name appending _DEPT if required
--  setProductType()                 -                   find out if we are plant or marine
--  setRegiName(STRING)              -
--  setSpool(DBREF)                  -                   set the passed dbref as the current spool and get its names
--  tidyNameString(STRING)           STRING              remove unwanted characters in the passed string
--
define object PFFILEMANAGER

  -- object members
  -- initial strings taken from the design hierarchy or marine environment
  -- the registryString is the base name for the plotfile directory
  -- the actual registry name in DRAFT with _REGI added
  member .regiName is STRING
  -- the department name based on the site or marine drawing type
  member .departmentName is STRING
  -- this should be the final plot file
  member .plotFile is FILE
  -- the path of the material file
  member .materialFile is STRING
  -- the current spool
  member .spool is DBREF
  -- spool name string for the drawing and plot file names
  member .spoolName is STRING
  -- original plot file name if one exists
  member .oldPlotFile is STRING
  -- name of the draft overlay file in the iso sub directory
  member .overlayFileName is STRING
  -- the plot directory main level
  member .plotDirectory is FILE
  -- the isometric underlay directory
  member .isoDirectory is FILE
  -- the isometric underlay directory name
  member .isoExportPath is STRING
  -- the isometric plot file name for isodraft
  member .isoPlotName is STRING
  -- the dxf file name
  member .dxfName is STRING
  -- the pdmsuser directory location
  member .pdmsUserPath is STRING
  -- the pdmswk directory name
  member .pdmsWorkPath is STRING
  -- the preview directory for previewing multiple versions of one plot
  member .previewDirectory is FILE
  -- the name of the current preview file for the pdf viewer
  member .previewFile is FILE
  -- save the product family
  member .productFamily is STRING

endobject

----------------------------------------------------------------------
--
-- Method:      .pfFileManager()
--
-- Description: Basic Constructor method
----------------------------------------------------------------------
define method .pfFileManager()

  -- find out if we are plant or marine
  !this.setProductType()
  !this.getPdmsUserPath()

endmethod

----------------------------------------------------------------------
--
-- Method:      .pfFileManager()
--
-- Description: Basic constructor method for starting with a registry
-- and department name
----------------------------------------------------------------------
define method .pfFileManager(!regiName is STRING, !deptName is STRING)

  -- find out if we are plant or marine
  !this.setProductType()

  !this.setRegiName(!regiName)
  !this.setDepartmentName(!deptName)

  -- now get all the directories
  !this.getDirectories()

endmethod

----------------------------------------------------------------------
--
-- Method:      .pfFileManager()
--
-- Description: Constructor method for creating iso overlay plots
--
--
----------------------------------------------------------------------
define method .pfFileManager(!spool is DBREF, !isoDirectory is STRING, !regiName is STRING ,!deptName is STRING)

  -- find out if we are plant or marine
  !this.setProductType()
  --Format the registry name
  !this.setRegiName(!regiName)
  --Format the department name
  !this.setDepartmentName(!deptName)
  -- Assign the current spool
  !this.setSpool(!spool)
  !this.isoExportPath = !this.removeTrailingBackslash(!isoDirectory)
  !this.pdmsUserPath = !this.isoExportPath

  -- get the new iso files
  !this.getUnderlayFileNames()

endmethod

----------------------------------------------------------------------
--
-- Method:      .pfFileManager()
--
-- Description: Constructor method with passed spool and reginame
--
----------------------------------------------------------------------
define method .pfFileManager(!spool is DBREF, !regiName is STRING)

  -- find out if we are plant or marine
  !this.setProductType()
  !this.regiName     = !regiName
  !this.setSpool(!spool)

endmethod

----------------------------------------------------------------------
--
-- Method:     .setDepartmentName
--
-- Description: set the registry name appending _REGI if required
--
----------------------------------------------------------------------
define method .setRegiName(!regiName is STRING)

  if !regiName.match('_REGI').eq(0) then
    !this.regiName =  !this.tidyNameString(!regiName) & '_REGI'
  else
    !this.regiName =  !this.tidyNameString(!regiName)
  endif

  -- add the single / back
  !this.regiName = '/' & !this.regiName

endmethod

----------------------------------------------------------------------
--
-- Method:     .setDepartmentName
--
-- Description: set the department name appending _DEPT if required
--
----------------------------------------------------------------------
define method .setDepartmentName(!deptName is STRING)

  if !deptName.match('_DEPT').eq(0) then
    !this.departmentName =  !this.tidyNameString(!deptName) & '_DEPT'
  else
    !this.departmentName =  !this.tidyNameString(!deptName)
  endif

  !this.departmentName = '/' & !this.departmentName

endmethod

----------------------------------------------------------------------
--
-- Method:     .initialise()
--
-- Description: initialise the base attributes from what is known
--
----------------------------------------------------------------------
define method .initialise()

  -- get the base directories
  !this.getDirectories()
  --set the spool name text after removing illegal characters
  !this.spoolName = !this.getSpoolNames(!this.spool)
  -- set the plot file name based on the calculated spool name text
  !this.plotFile = !this.getPlotFile()
  if !this.plotFile.exists() then
    !this.oldPlotFile = !this.plotFile.fullName()
  endif

endmethod

----------------------------------------------------------------------
--
-- Method:     .getDirectories()
--
-- Description: ensure that all base directories are set and have been created
--
----------------------------------------------------------------------
define method .getDirectories()

  !this.getPdmsUserPath()
  !this.getPlotDirectoryName()
  --get preview Directory now in PDMSWK - only needed for plant ??
  !this.getPreviewDirectory()
  !this.getIsoDirectory()


endmethod

----------------------------------------------------------------------
--
-- Method:     .setSpool()
--
-- Description: set the passed dbref as the current spool and get its names
--
----------------------------------------------------------------------
define method .setSpool(!spool is DBREF)

  -- set the dbref
  !this.spool = !spool
  -- set the rest of the attributes
  !this.initialise()

endmethod

----------------------------------------------------------------------
--
-- Method:      .getSpoolNames
--
-- Description: gets any existing files for preview or plotting
--
---------------------------------------------------------------------
define method .getSpoolNames(!spool is DBREF) is STRING

  if !this.spool.name.eq('') then
    !spoolName = !!generateFileName(!spool.refNo.string())
  else
    !spoolName = !!generateFileName(!spool.namn)
  endif

  !spoolName = !this.tidyNameString(!spoolName)

  return !spoolName

endmethod

----------------------------------------------------------------------
--
-- Method:      getSpoolFileData
--
-- Description: returns a string to populate the table drawing form
-- table Drwg Status
--
---------------------------------------------------------------------
define method .getSpoolFileData(!spool is DBREF,!regiName is STRING) is STRING

  !this.setProductType()

  !this.regiName = !regiName
  !this.setSpool( !spool )
  if !this.plotFile.exists() then
    !returnString = !this.constructDrawingStatus(!this.plotFile)
  else
    !returnString = 'none'
  endif

  return !returnString

endmethod

------------------------------------------------------------------------
--
-- Method:      .constructDrawingStatus
-- Description: create a string describing the files available
--
------------------------------------------------------------------------
define method .constructDrawingStatus(!file is FILE)is STRING

  !date = !file.dtm()
  !string = 'created '

  if !date.minute().lt(10) then
    !minute = '0' & !date.minute()
  else
    !minute = !date.minute()
  endif
  !string = !string & !date.date() & ' ' & !date.monthString() & ' ' & !date.year() & ' ' & !date.hour() & ':'  & !minute

  return !string

endmethod


----------------------------------------------------------------------
--
-- Method:     .deleteIsoFiles()
--
-- Description: used to delete the old isometric files when we are using an overlay
--
----------------------------------------------------------------------
define method .deleteIsoFiles()

  !fileList = !this.isoDirectory.files()
  do !file values !fileList
    if !file.fullName().match(!this.spoolName).gt(0) then
      !this.deleteFile( !file )
    endif
  enddo

endmethod

----------------------------------------------------------------------
--
-- Method:     .getUnderlayFileNames
--
-- Description: get the names of the iso directory and iso files for the
-- iso underlay.
--
----------------------------------------------------------------------
define method .getUnderlayFileNames()

  !this.materialFile =  !this.isoDirectory.fullName() & '\' & !this.spoolName & '-matl'
  !this.isoPlotName  =  !this.isoDirectory.fullName() & '\' & 'U-' & !this.spoolName & |.iso.plt|
  !longName =  |U-| & !this.spoolName
  !this.dxfName = !this.isoDirectory.fullName() & '\' & !longName
  !this.overlayFileName =  !this.isoDirectory.fullName() & '\' & 'U-' & !this.spoolName & |.iso.plt|

endmethod

----------------------------------------------------------------------
--
-- Method:     .getPlotFile()
--
-- Description: return a file object with the name of the expected plotfile
--
----------------------------------------------------------------------
define method .getPlotFile() is FILE

  if(!this.productFamily.eq( 'MARINE' )) then
    !plotFile = object FILE(!this.plotDirectory.fullName() & '\' & !this.spoolName & |.TIFF|)
  else
    !plotFile = object FILE(!this.plotDirectory.fullName() & '\' & !this.spoolName & |.PDF|)
  endif

  return !plotFile

endmethod

----------------------------------------------------------------------
--
-- Method:     .renameIsoPlotFile()
-- Description: remove the 001 from the isodraft output file
-- not called internally
---------------------------------------------------------------------
define method .renameIsoPlotFile()

  !fileList = !this.isoDirectory.files()
  do !file values !fileList
    if !file.fullName().match(!this.spoolName).gt(0) then
      -- we have found either a .plt file or a .dxf file
      -- U-2MZ-HP0916_PS_002.iso.plt001
      -- U-2MZ-HP0916_PS_002.iso.plt001.dxf
      if !file.fullName().match('.dxf').eq( !file.fullName().length() - 3) then
        -- its a dxf file
        skip if !file.fullName().match('iso.dxf').gt(0)
        !newName = !file.fullName().before('.plt') & '.dxf'
        !this.dxfName = !newName
      elseif !file.fullName().match('matl0').gt(0) then
        --  its matl
        !newName = !file.fullName().before('matl0') & 'matl'
      elseif !file.fullName().match('.plt').gt(0) then
        -- its plt
        !newName = !file.fullName().before('.plt') & '.plt'
      else
        skip
      endif
      !existingFile = object FILE(!newName)
      -- delete the old file
      if !existingFile.exists() then
        !this.deleteFile(!existingFile)
      endif
      !file.move(object FILE('$!newName'))
      handle any
      endhandle
    endif

  enddo


endmethod

----------------------------------------------------------------------
--
-- Method:     .createPreviewFile()
--
-- Description: copies the preview file into the preview directory
--
-----------------------------------------------------------------------
define method .createPreviewFile() is FILE

  -- delete the old preview files for this spool
  !this.deleteOldPreviews()

  !previewFile = object FILE(!this.previewDirectory & '\' &  !this.spoolName & '.PDF')
  -- the file is in use by someone else
  if !previewFile.exists() then
    -- we need to create a temporary file with a different name
    !test = !this.deleteFile(!previewFile)
    if !test.not() then
      do !a from 1 to 20
        !previewFile = object FILE(!this.previewDirectory & '\' &  !this.spoolName & 'p' & !a &  '.PDF')
        !test = !previewFile.exists()
        break if !test.not()
      enddo
    endif
  endif
  !this.plotFile.copy(!previewFile)
  !this.previewFile = !previewFile

endmethod

----------------------------------------------------------------------
--
-- Method:     .deleteOldPreviews()
--
-- Description: deletes any preview file that it can
--
---------------------------------------------------------------------
define method .deleteOldPreviews()

  !fileList = !this.previewDirectory.files()
  do !file values !fileList
    if !file.name().match(!this.spoolName).gt(0) then
      --  try to delete the old copy
      !test = !this.deleteFile(!file)
      if !test then
        -- deleted $!file
      else
        -- FAILED to delete $!file
      endif
    endif
  enddo

endmethod

----------------------------------------------------------------------
--
-- Method:      .getPreviewDirectory()
--
-- Description:  find the
--
---------------------------------------------------------------------
define method .getPreviewDirectory()

  !previewName = !this.pdmsWorkPath & '\preview'
  !this.previewDirectory = object FILE(!previewName)
  if !this.previewDirectory.exists().not() then
    syscom 'MD $!previewName'
  endif

endmethod

----------------------------------------------------------------------
--
-- Method:      .getPreviewDirectory()
--
-- Description:  get the iso directory
--
---------------------------------------------------------------------
define method .getIsoDirectory()

  !this.isoDirectory = object FILE(|$!this.plotDirectory\iso\|)
  if (!this.isoDirectory.exists().not()) then
    syscom 'md $!this.isoDirectory'
  endif

endmethod

----------------------------------------------------------------------
--
-- Method:      .deleteFile
--
-- Description: convert the passed string to a file and get it deleted
--
---------------------------------------------------------------------
define method .deleteFile(!file is STRING) is BOOLEAN

  !testFile = object FILE(|$!file|)
  if !testFile.exists() then
    return !this.deleteFile(!testFile)
  endif

endmethod
----------------------------------------------------------------------
--
-- Method:      .deleteFile
--
-- Description: delete the passed file
--
---------------------------------------------------------------------
define method .deleteFile(!file is FILE) is BOOLEAN

  !file.deleteFile()
  handle any
    return FALSE
  endhandle
  -- make sure its been deleted
  if !file.exists() then
    -- we failed to delete it
    return FALSE
  endif
  return TRUE

endmethod

------------------------------------------------------------------------
--
-- Method:     .getPlotDirectoryName()
--
-- Description: remove trailing \ to avoid double ones later
--
------------------------------------------------------------------------
define method .getPlotDirectoryName()

  !spoolDirectory = !this.tidyNameString(!this.regiName.before('_REGI'))
  !plotDirectory =  !this.pdmsUserPath & '\' & !spoolDirectory

  !this.plotDirectory = object FILE(!plotDirectory)

  if !this.plotDirectory.exists().not() then
    syscom 'MD "$!this.plotDirectory"'
    -- being as we have just made the plot directory we need to make the iso directory as well
    !this.getIsoDirectory()
  endif

endmethod

------------------------------------------------------------------------
--
-- Method:     .getPdmsUserPath()
--
-- Description: get the pdmsuser path from pdmsuser evar
--
------------------------------------------------------------------------
define method .getPdmsUserPath()

  !this.pdmsUserPath = !!evarSplit('PDMSUSER')[1]
  !this.pdmsUserPath = !this.removeTrailingBackslash(!this.pdmsUserPath)
  !this.pdmsWorkPath = !!evarSplit('PDMSWK')[1]
  !this.pdmsWorkPath = !this.removeTrailingBackslash(!this.pdmsWorkPath)

endmethod

------------------------------------------------------------------------
--
-- Method:     .removeTrailingBackslash
--
-- Description: remove trailing \ to avoid double ones later
--
------------------------------------------------------------------------
define method .removeTrailingBackslash(!string is STRING) is STRING

  if !string.substring(!string.length() , 1).eq('\') then
    !newString = !string.substring(1, !string.length() - 1)
    handle any
      return !string
    endhandle
  else
    return !string
  endif

  return !newString

endmethod

------------------------------------------------------------------------
--
-- Method:     .tidyNameString
--
-- Description: remove unwanted characters in the passed string
--
------------------------------------------------------------------------
define method .tidyNameString(!input is STRING) is STRING

  --check if the spool name has '/' as it causes a problem
  !invalidStr  = |/|
  !invalidList = !invalidStr.split('')
  !newSpoolName = ''

  do !i from 1 to !input.length()
    !char = substring(!input, !i, 1)

    !index = !invalidList.find(!char)
    if (!index.set()) then
      if (!i eq 1 and !char eq '/') then
        !newSpoolName = !newSpoolName
      else
        !newSpoolName = !newSpoolName + '_'
      endif
    else
      !newSpoolName = !newSpoolName + !char
    endif
  enddo

  return !newSpoolName

endmethod

------------------------------------------------------------------------
--
-- Method:     setProductType()
--
-- Description: find out if we are plant or marine
------------------------------------------------------------------------
define method .setProductType()

  !this.productFamily = !!module().productFamily.upCase()

endmethod
