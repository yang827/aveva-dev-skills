--   Type:          Object Definition
--   Group:         Pipe Fabrication
--     Keyword:     PF
--   Module:        Design
--   Replaces:
--
-- Author:          HyunJong Roh (Nick)
-- Created:         Tuesday 6th December 2011
--
-- Description:     result for checking offset angle between flanges
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  display()                        -                   display check result in the 3D view
--  fix(STRING)                      BOOLEAN             fix the problem
--  getMessage()                     STRING              return detailed result message
--  getResultLevel()                 REAL                return error level
--  getSolutionMethods()             ARRAY               return solution methods to fix the problem
--  pfFlangeRotationCheckResult(DBREF,DBREF,REAL,REAL) -
--  zoom(VOLUME)                     -                   zoom the given volume area
--
--------------------------------------------------------------------------------
define object PFFLANGEROTATIONCHECKRESULT

  member  .component1     is DBREF

  member  .component2     is DBREF

  member  .ppoint1        is REAL

  member  .ppoint2        is REAL

  member  .flangeUtility  is PFFLANGEUTILITY

endobject


define method .pfFlangeRotationCheckResult(!component1 is DBREF, !component2 is DBREF, !ppoint1 is REAL, !ppoint2 is REAL)

  !type1 = !component1.type
  !type2 = !component2.type

  !swap = false

  if !type1.eq('FLAN') then
    if !type2.eq('FLAN') then
      !pzdir1 = !this.flangeUtility.getAlignmentDirection(!component1, !ppoint1)
      !pzdir2 = !this.flangeUtility.getAlignmentDirection(!component2, !ppoint2)

      !zdir = object DIRECTION('Z')
      if !pzdir1.dot(!zdir).lt(!pzdir2.dot(!zdir)) then
        !swap = true
      endif
    else
      !swap = true
    endif
  endif

  if !swap then
    !this.component1 = !component2
    !this.component2 = !component1
    !this.ppoint1 = !ppoint2
    !this.ppoint2 = !ppoint1
  else
    !this.component1 = !component1
    !this.component2 = !component2
    !this.ppoint1 = !ppoint1
    !this.ppoint2 = !ppoint2
  endif

endmethod


--------------------------------------------------------------------------------
--
-- Method:      display
--
-- Description: display check result in 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .display()

  -- highlight
  ENHANCE $!this.component1 COLOUR $!!gphColOpt.highlight
  ENHANCE $!this.component2 COLOUR $!!gphColOpt.highlight

  -- decide arrow height
  !arrowHeight = 0mm

  !outsideDiameter = !this.component1.pod[!this.ppoint1]
  if !outsideDiameter.eq(0mm) then
    !outsideDiameter = !this.component2.pod[!this.ppoint2]
  endif

  if !outsideDiameter.eq(0mm) then
    !bore = !this.component1.ppbo[!this.ppoint1]
    if !outsideDiameter.eq(0mm) then
      !bore = !this.component2.ppbo[!this.ppoint2]
    endif
    if !bore.eq(0mm) then
      !arrowHeight = 200mm
    else
      !arrowHeight = !bore * 2.5
    endif
  else
    !arrowHeight = !outsideDiameter * 2
  endif

  if !arrowHeight.eq(0mm) then
    !arrowHeight = 300mm
  endif

  -- draw alignment directions
  !direction1 = !this.flangeUtility.getAlignmentDirection(!this.component1, !this.ppoint1)

  -- draw direction for the first component
  !position1 = !this.component1.ppos[!this.ppoint1]
  !position2 = !position1.offset(!direction1, !arrowHeight)
  AID LINE $!position1 TO $!position2
  AID ARROW AT $!position2 DIR $!direction1 HEI 50 PROP 1
  AID TEXT '$!this.component1.flnn' AT $!position2

  -- draw direction for the second component
  !direction2 = !direction1
  !axis = !this.component2.pdir[!this.ppoint2].opposite()
  !offsetAngle = !this.flangeUtility.getAlignmentOffsetAngle(!this.component1, !this.component2, !this.ppoint1, !this.ppoint2, !axis)
  !!pfRotateDirection(!direction2, -!offsetAngle, !axis)

  !position2 = !position1.offset(!direction2, !arrowHeight)

  AID LINE $!position1 TO $!position2
  AID ARROW AT $!position2 DIR $!direction2 HEI 50 PROP 1
  AID TEXT '$!this.component2.flnn' AT $!position2

  -- zoom
  !partRefs = object ARRAY()
  !partRefs.append(!this.component1)
  !partRefs.append(!this.component2)

  !this.zoom(object VOLUME(!partRefs))

endmethod

--------------------------------------------------------------------------------
--
-- Method:      getMessage
--
-- Description: return detail check result string
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    STRING      detail check result string
--------------------------------------------------------------------------------
define method .getMessage() is STRING

  !axis = !this.component1.pdir[!this.ppoint1]
  !offsetAngle = !this.flangeUtility.getAlignmentOffsetAngle(!this.component1, !this.component2, !this.ppoint1, !this.ppoint2, !axis)

  return 'Bolt hole alignment error ('+ !offsetAngle.string(!!angleFmt) + ') between ' + !this.component1.flnm + ' and ' + !this.component2.flnm
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getResultLevel
--
-- Description: return error level
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        error level
--                1 : information, 2 : warning, 3 : error
--------------------------------------------------------------------------------
define method .getResultLevel() is REAL
  return 3
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getSolutionMethods()
--
-- Description: return solution methods to fix the problem
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY     array of solution methods
--------------------------------------------------------------------------------
define method .getSolutionMethods() is ARRAY

  !solutions = object ARRAY()

  if !this.component1.type.eq('FLAN') then
    !solutions.append('Fix ' + !this.component1.flnm)
  endif

  if !this.component2.type.eq('FLAN') then
    !solutions.append('Fix ' + !this.component2.flnm)
  endif

  return !solutions

endmethod

--------------------------------------------------------------------------------
--
-- Method:      fix
--
-- Description: try to fix the problem
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      solution method
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     return true if the problem is fixed
--------------------------------------------------------------------------------
define method .fix(!method is STRING) is BOOLEAN

  !fixFirst = !method.match(!this.component1.flnm).gt(0)
  !fixSecond = !method.match(!this.component2.flnm).gt(0)

  !pzdir1 = !this.flangeUtility.getAlignmentDirection(!this.component1, !this.ppoint1)
  !pzdir2 = !this.flangeUtility.getAlignmentDirection(!this.component2, !this.ppoint2)

  !rotationAxis = !this.component2.pdir[!this.ppoint2].opposite()

  !angle = !!pfAngleBetweenDirsWithSign(!pzdir1, !pzdir2, !rotationAxis)

  if !fixFirst then
    !!ce = !this.component1
  elseif !fixSecond then
    !angle = -1 * !angle
    !!ce = !this.component2
  endif

  ROTATE BY $!angle ABOUT $!rotationAxis
  handle ANY
    !!alert.error(!!error.text)
    return false
  endhandle

  return true
endmethod

--------------------------------------------------------------------------------
--
-- Method:      zoom
--
-- Description: zoom the given element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      VOLUME      volume to be zoomed
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .zoom(!volume is VOLUME)

  !from = !volume.from
  !to   = !volume.to

  -- Through Point
  !throughPoint = !from.midPoint(!to)
  handle ANY
    return
  endhandle

  -- Set metric format
  !format           = object FORMAT()
  !format.units     = 'MM'
  !format.dp        = 0
  !format.dimension = 'L'

  -- Set through point
  !through[1] = !throughPoint.east.string(!format).real()
  !through[2] = !throughPoint.north.string(!format).real()
  !through[3] = !throughPoint.up.string(!format).real()
  !!fmSys.currentDocument().view.through = !through

  -- Set view radius
  !radius = !from.distance(!to).string(!format).real() / 2 * 1.25
  !radius = !radius.max(500mm)
  !!fmSys.currentDocument().view.radius  = !radius

endmethod
