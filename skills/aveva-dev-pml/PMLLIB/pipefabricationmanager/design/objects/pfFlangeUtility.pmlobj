------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getAlignmentDirection(DBREF,REAL) DIRECTION           return the alignment direction at the given connection point for the specified component
--  getAlignmentOffsetAngle(DBREF,DBREF,REAL,REAL,DIRECTION) REAL                return the alignment offset angle between the given two components
--  getAlignmentOffsetAngle(DBREF,REAL,DIRECTION,DIRECTION) REAL                return the alignment offset angle against the given direction
--  getAlignmentOffsetAngle(REAL,REAL,DIRECTION,DIRECTION,DIRECTION) REAL                return the alignment offset angle between the given directions
--  getBoltNumber(DBREF,REAL)        REAL                return the bolt number at the given connection point
--
--------------------------------------------------------------------------------
define object PFFLANGEUTILITY
  -- no members
endobject

--------------------------------------------------------------------------------
--
-- Method:      getAlignmentOffsetAngle
--
-- Description: return the alignment offset angle by bolt numbers and directions of flanges
--
-- Method Type: Function
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--    1    R      REAL                         bolt number 1
--    2    R      REAL                         bolt number 2
--    3    R      DIRECTION                    component alignment direction 1
--    4    R      DIRECTION                    component alignment direction 2
--    5    R      DIRECTION                    axis of rotation
-- Return:
--   [Data Type]             [Description]
--    REAL                    flange offset angle
--------------------------------------------------------------------------------
define method .getAlignmentOffsetAngle(!numberBolt1 is REAL, !numberBolt2 is REAL, !pzdir1 is DIRECTION, !pzdir2 is DIRECTION, !dir is DIRECTION) is REAL
  !offsetAngle = !!pfAngleBetweenDirsWithSign(!pzdir2, !pzdir1, !dir)

--  if !numberBolt1.gt(0) then
--    if !numberBolt2.gt(0) then
--
--      -- ex) numberBolt1: 8, numberBolt2 : 4, offsetAngle 130
--
--      !boltAngle1 = 360degree / !numberBolt1
--      !boltAngle2 = 360degree / !numberBolt2
--      -->     boltAngle1 = 45degree
--      -->     boltAngle2 = 90degree
--
--      !offsetAngle = !offsetAngle.modulo(!boltAngle2.value())
--      -->    offsetAngle = 40
--
--      if !offsetAngle.eq(!boltAngle1) then
--        !offsetAngle = 0degree
--      elseif !offsetAngle.gt(!boltAngle1) then
--        !offsetAngle = !offsetAngle - !boltAngle1
--      endif
--    else
--      !boltAngle = 360degree / !numberBolt1
--      !offsetAngle = !offsetAngle.modulo(!boltAngle.value())
--      --if !offsetAngle.gt(!boltAngle / 2) then
--      --  !offsetAngle = !offsetAngle - !boltAngle
--      --endif
--    endif
--  else
--    if !numberBolt2.gt(0) then
--      !boltAngle = 360degree / !numberBolt2
--      !offsetAngle = !offsetAngle.modulo(!boltAngle.value())
--      --if !offsetAngle.gt(!boltAngle / 2) then
--      --  !offsetAngle = !offsetAngle - !boltAngle
--      --endif
--    else
--      -- skip
--    endif
--  endif

  !numberBolt = !numberBolt1.max(!numberBolt2)
  if !numberBolt.gt(0) then
    !boltAngle = 360degree / !numberBolt
    !offsetAngle = !offsetAngle.modulo(!boltAngle.value())
  endif

  return !offsetAngle

endmethod

--------------------------------------------------------------------------------
--
-- Method:      getAlignmentOffsetAngle
--
-- Description: return the alignment offset angle against the given direction
--
-- Method Type: Function
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--    1    R      DBREF                        component
--    2    R      REAL                         connection point
--    3    R      DIRECTION                    reference plane direction
--    4    R      DIRECTION                    axis of rotation
-- Return:
--   [Data Type]             [Description]
--    REAL                    flange offset angle
--------------------------------------------------------------------------------
define method .getAlignmentOffsetAngle(!flanRef is DBREF, !ppoint is REAL, !refPlaneDirection is DIRECTION, !axis is DIRECTION) is REAL
  !pzdir = !this.getAlignmentDirection(!flanRef, !ppoint)

  !dot = !refPlaneDirection.dot(!axis).abs()
  if (!dot gt 0.999) then
    !refDir = !refPlaneDirection
  else
    !refDir = !refPlaneDirection.cross(!axis)
  endif

  !offsetAngle = !!pfAngleBetweenDirsWithSign(!refDir, !pzdir, !axis)

  !numberBolt = !this.getBoltNumber(!flanRef, 0)
  if !numberBolt.gt(0) then
    !boltAngle = 360degree / !numberBolt
    !offsetAngle = !offsetAngle.modulo(!boltAngle.value())
    --if !offsetAngle.gt(!boltAngle / 2) then
    --  !offsetAngle = !offsetAngle - !boltAngle
    --endif
  endif

  return !offsetAngle
endmethod


--------------------------------------------------------------------------------
--
-- Method:      getBoltNumber
--
-- Description: return the bolt number of the given component at the specified connection point
--
-- Method Type: Function
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--    1    R      DBREF                        component
--    2    R      REAL                         connection point number
-- Return:
--   [Data Type]             [Description]
--    REAL                    bolt number
--------------------------------------------------------------------------------
define method .getBoltNumber(!partRef is DBREF, !ppoint is REAL) is REAL

  -- try to get bolt number by new bolting method
  -- SPCO
  !blrfarray = !partRef.spref.catref.blrfarray
  handle ANY
    -- SCOM
    !blrfarray = !partRef.spref.blrfarray
    handle ANY
      !blrfarray = object ARRAY()
    endhandle
  endhandle

  !count = !blrfarray.size()
  if !count.gt(0) then
    -- try to find bolt number at the specified ppoint
    if !ppoint.gt(0) and !count.geq(!ppoint) then
      !btseRef = !blrfarray[!ppoint]
      if !btseRef.badref().not() then
        if (!btseRef.mcount('BLTP') gt 0) then
          !boltCount = !btseRef.mcount('BLTP')
        else
          !boltCount = !btseRef.noff
        endif
--        !boltCount = !btseRef.noff + !btseRef.mcount('BLTP')
        return !boltCount
      endif
    endif

    -- return the bolt number of the first valid BTSE in BLRF
    do !btseRef values !blrfarray
      if !btseRef.badref().not() then
        if (!btseRef.mcount('BLTP') gt 0) then
          !boltCount = !btseRef.mcount('BLTP')
        else
          !boltCount = !btseRef.noff
        endif
--        !boltCount = !btseRef.noff + !btseRef.mcount('BLTP')
        return !boltCount
      endif
    enddo
  endif

  -- old bolting method
  !bltref = !partRef.spref.bltref
  handle ANY
    return 0
  endhandle

  if !bltref.badref().not() then
    if !bltref.type.eq('SBOL') then
      return !bltref.noff
    elseif !bltref.type.eq('MBOL') then
      !boltCount = 0
      do !sbolRef values !bltref.sbrarray
        if !sbolRef.type.eq('SBOL') then
          !boltCount = !boltCount + !sbolRef.noff
        endif
      enddo
      return !boltCount
    endif
  endif

  return 0

endmethod


--------------------------------------------------------------------------------
--
-- Method:      getAlignmentDirection
--
-- Description: return the alignment direction of the given component at the given connection position
--
-- Method Type: Function
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--    1    R      DBREF                        component
--    2    R      REAL                         ppoint number
-- Return:
--   [Data Type]             [Description]
--    DIRECTION               alignment direction
--------------------------------------------------------------------------------
define method .getAlignmentDirection(!component is DBREF, !ppoint is REAL) is DIRECTION

  -- 1. try to get pzdir at the given ppoint
  !pzdir = !component.pzdir[!ppoint]
  if !pzdir.set() and !pzdir.east.set() and !pzdir.north.set() and !pzdir.up.set() and !pzdir.origin.set() then
    return !pzdir
  endif

  -- 2. try to get pzdir of the component
  !pzdir = !component.pzdir
  if !pzdir.set() and !pzdir.east.set() and !pzdir.north.set() and !pzdir.up.set() and !pzdir.origin.set() then
    return !pzdir
  endif

  -- 3. try to get zdir of the given component
  return !component.ori.zdir()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      getAlignmentOffsetAngle
--
-- Description: return alignment offset angle between two components
--
-- Method Type: Function
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--    1    R      DBREF                        first component
--    2    R      DBREF                        second component
--    3    R      REAL                         connection ppoint number of the first component
--    4    R      REAL                         connection ppoint number of the second component
--    5    R      DIRECTION                    rotation axis
-- Return:
--   [Data Type]              [Description]
--    REAL                    offset angle
--------------------------------------------------------------------------------
define method .getAlignmentOffsetAngle(!component1 is DBREF, !component2 is DBREF, !ppoint1 is REAL, !ppoint2 is REAL, !axis is DIRECTION) is REAL
  !numberBolt1 = !this.getBoltNumber(!component1, !ppoint1)
  !numberBolt2 = !this.getBoltNumber(!component2, !ppoint2)

  !pzdir1 = !this.getAlignmentDirection(!component1, !ppoint1)
  !pzdir2 = !this.getAlignmentDirection(!component2, !ppoint2)

  return !this.getAlignmentOffsetAngle(!numberBolt1, !numberBolt2, !pzdir1, !pzdir2, !axis)

endmethod
