--
-- Description:     check spool volume against the given tank volume
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  check(DBREF,ARRAY)               ARRAY               check spool volume against the given tank volume
--  compare(ARRAY)                   -
--  evauateBoundary(ARRAY,BOOLEAN)   ARRAY
--  getLimitsDiagonalLength(ARRAY)   ARRAY
--  getPosition(DBREF)               -
--  newPoint(ARRAY)                  STRING
--  showVolume(DBREF)                -
--
--------------------------------------------------------------------------------
define object PFGALVANIZATIONTANKCHECKER

  member .positions          is ARRAY
  member .datum              is POSITION
  member .tankVol            is ARRAY
  member .check              is STRING
  member .resultArray        is ARRAY
  member .bore               is REAL
  member .splVolume          is PFSPOOLVOLUME
  member .aidNumber          is REAL
endobject

--------------------------------------------------------------------------------
--
-- Method:      check
--
-- Description:
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       target spool
--    2   R      ARRAY       tank volume
-- Return:
--   [Data Type] [Description]
--    ARRAY       check result
--------------------------------------------------------------------------------
define method .check(!pspool is DBREF, !tankVol is ARRAY) is ARRAY
  !this.check = 'Fail'
  !this.tankVol = !tankVol

  !this.resultArray.clear()

  !!pfGalvCheckFlag = true

  !this.splVolume.getVolume(!pspool)
  !spoolVolume  = !this.splVolume.volume

  !tankVolumeValue  = !tankVol[1]     * !tankVol[2]     * !tankVol[3]
  !spoolVolumeValue = !spoolVolume[1] * !spoolVolume[2] * !spoolVolume[3]

  !isValidSpoolVolume = !spoolVolumeValue le !tankVolumeValue

  !spoolVolume.sort()
  !tankVol.sort()

  if (!isValidSpoolVolume.not()) then
    !this.resultArray.appendArray(!spoolVolume)
    !this.resultArray.append('Fail')

    return !this.resultArray
  endif

  !tankLimits  = !this.evauateBoundary(!tankVol, true)
  !spoolLimits = !this.evauateBoundary(!spoolVolume, false)

  !isValidCondition = false
  !matchCount = 0

  do !spoolLimit values !spoolLimits
    !canBeIncluded = false
    !spoolVolumeXlength = !spoolLimit.limits()[2].x
    !spoolVolumeYlength = !spoolLimit.limits()[2].y

    do !i index !tankLimits
      !tankLimit = !tankLimits[!i]

      !tankVolumeXlength  = !tankLimit.limits()[2].x
      !tankVolumeYlength  = !tankLimit.limits()[2].y

      if (!spoolVolumeXlength gt !tankVolumeXlength and !spoolVolumeYlength gt !tankVolumeYlength) then
        break
      endif

      if (!tankLimit.isWithin(!spoolLimit)) then
        !canBeIncluded = true
        !matchCount = !matchCount + 1
        !tankLimits.remove(!i)
        break
      else
        if (!spoolVolumeXlength lt !tankVolumeXlength and !spoolVolumeXlength lt !tankVolumeYlength) then
          !orthOffsetValue = !spoolVolumeXlength * 0.5
        else
          !orthOffsetValue = !spoolVolumeYlength * 0.5
        endif

        !edges = !tankLimit.edges()

        !tankOrthLine = object LINE(!edges[1].startPosition, !edges[2].endPosition)
        !offsetDir    = !tankOrthLine.direction().cross(!edges[1].direction().cross(!edges[2].direction()))

        !offsetLine1  = !tankOrthLine.offset(!offsetDir, !orthOffsetValue)
        !offsetLine2  = !tankOrthLine.offset(!offsetDir.opposite(), !orthOffsetValue)

        !firstLine  = object LINE(!edges[1].intersection(!offsetLine1), !edges[2].intersection(!offsetLine1))
        !secondLine = object LINE(!edges[4].intersection(!offsetLine2), !edges[3].intersection(!offsetLine2))

        !thirdLine  = object LINE(!firstLine.startPosition, !firstLine.near(!secondLine.endPosition))
        !fourthLine = object LINE(!secondLine.startPosition, !secondLine.near(!firstLine.endPosition))

        !limitLength = min(!thirdLine.length(), !fourthLine.length())

        if (!limitLength gt !spoolVolumeXlength and !limitLength gt !spoolVolumeYlength) then
          !canBeIncluded = true
          !isValidCondition = true
          break
        endif
      endif
    enddo

    if (!matchCount eq 3) then
      !isValidCondition = true
      break
    endif

    if (!canBeIncluded.not()) then
      !isValidCondition = false
      break
    endif

    break if (!isValidCondition)
  enddo

  if (!isValidCondition) then
    !this.resultArray.appendArray(!spoolVolume)
    !this.resultArray.append('Pass')
  else
    !this.resultArray.appendArray(!spoolVolume)
    !this.resultArray.append('Fail')
  endif

  return !this.resultArray
endmethod

define method .getLimitsDiagonalLength(!volume is ARRAY) is ARRAY
  !result = object ARRAY()

  !width  = !volume[1]
  !height = !volume[2]
  !depth  = !volume[3]

  !planDiagonalLength = sqrt( power(!width, 2) + power(!height, 2))
  !elevDiagonalLength = sqrt( power(!width, 2) + power(!depth, 2))
  !sectDiagonalLength = sqrt( power(!height,2) + power(!depth, 2))

  !result.append(!planDiagonalLength)
  !result.append(!elevDiagonalLength)
  !result.append(!sectDiagonalLength)

  !result.sort()

  return !result
endmethod

define method .showVolume(!spoolRef is DBREF)
  !this.splVolume.getVolume(!spoolRef)
  !this.splVolume.drawVolume(!this.aidNumber)
endmethod


--------------------------------------------------------------------------------
--
-- Method:      newPoint
--
-- Description:
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     ARRAY        edge points
-- Return:
--   [Data Type] [Description]
--    STRING
--------------------------------------------------------------------------------
define method .newPoint(!edges is ARRAY) is STRING
 do !angleA from 0 to 85 by 5
   !edges = !this.positions
   do !i index !edges
    !this.datum = !edges[1]
    !lengthX = !edges[!i].east - !this.datum.east
    !lengthY = !edges[!i].north - !this.datum.north
    !lengthZ = !edges[!i].up - !this.datum.up

    !distX = !lengthX * cos (!angleA) - !lengthY * sin (!angleA)
    !distY = !lengthX * sin (!angleA) + !lengthY * cos (!angleA)
    !edges[!i].east = !this.datum.east + !distX
    !edges[!i].north = !this.datum.north + !distY
   enddo

   !this.compare(!edges)

   if (!this.check eq 'Pass') then
    return !this.check
   endif

   !angleEdgesA = !edges

   do !angleB from 5 to 180 by 5

     !edges = !angleEdgesA
     do !j index !edges
      !lengthX = !edges[!j].east - !this.datum.east
      !lengthY = !edges[!j].north - !this.datum.north
      !lengthZ = !edges[!j].up - !this.datum.up
      !distX = !lengthX * cos (!angleB) - !lengthZ * sin (!angleB)
      !distZ = !lengthX * sin (!angleB) + !lengthZ * cos (!angleB)

      !edges[!j].east = !this.datum.east + !distX
      !edges[!j].up = !this.datum.up + !distZ
     enddo

      !this.compare(!edges)
      if (!this.check eq 'Pass') then
        return !this.check
      endif
   enddo
 enddo
 return !this.check
endmethod


--------------------------------------------------------------------------------
--
-- Method:      compare
--
-- Description:
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     ARRAY        edge points
-- Return:
--   [Data Type] [Description]
--    STRING
--------------------------------------------------------------------------------
define method .compare(!edges is ARRAY)

  !xPosList = object ARRAY()
  !yPosList = object ARRAY()
  !zPosList = object ARRAY()
  !lengthArray = object ARRAY()
  do !edge value !edges
    !xPosList.append(!edge.east)
    !yPosList.append(!edge.north)
    !zPosList.append(!edge.up)
  enddo

  !xPosList.sort()
  !yPosList.sort()
  !zPosList.sort()

  !xMin = !xPosList.first()
  !xMax = !xPosList.last()

  !yMin = !yPosList.first()
  !yMax = !yPosList.last()

  !zMin = !zPosList.first()
  !zMax = !zPosList.last()

  !xLength = !xMax - !xMin
  !yLength = !yMax - !yMin
  !zLength = !zMax - !zMin

  --!xCenter = (!xMax + !xMin) / 2
  --!yCenter = (!yMax + !yMin) / 2
  --!zCenter = (!zMax + !zMin) / 2

  !lengthArray[1] = !xLength
  !lengthArray[2] = !yLength
  !lengthArray[3] = !zLength

  !lengthArray.sort()

  if (!lengthArray[1] lt !this.tankVol[1]) and (!lengthArray[2] lt !this.tankVol[2]) and (!lengthArray[3] lt !this.tankVol[3]) then
    !this.check = 'Pass'

  else
    !this.check = 'Fail'
  endif

  !this.resultArray[1] = !lengthArray[1].string(|d0|)
  !this.resultArray[2] = !lengthArray[2].string(|d0|)
  !this.resultArray[3] = !lengthArray[3].string(|d0|)
  !this.resultArray[4] = !this.check

endmethod


--------------------------------------------------------------------------------
--
-- Method:      getPosition
--
-- Description:
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R     ARRAY        edge points
-- Return:
--   [Data Type] [Description]
--    STRING
--------------------------------------------------------------------------------
define method .getPosition(!element is DBREF)

  !localVolume = object LOCALVOLUME(!element, !element)

  !fromPos     = !localVolume.from
  !toPos       = !localVolume.to

  !isBranTube = false
  if (!element.hardType eq 'TUBI') then
    !ownerRef = !element.flnm.after('ileave tube of').dbRef()
    if (!ownerRef.hardType eq 'BRAN') then
      !fromPos = !element.aPos
      !toPos   = !element.lPos
      !isBranTube = true
    endif
  endif
  !box    = !localVolume.box()
  !boxOri = !box.orientation

  if (!element.iPara.set()) then
    !insulationValue = !element.iPara[1]
  else
    !insulationValue = 0
  endif

  if (!isBranTube) then
    !box.xLength = !element.lBore.real() + !insulationValue
    !box.yLength = !element.lBore.real() + !insulationValue
    !box.zLength = !element.ltLength
  endif

  !box.position = !fromPos.midPoint(!toPos)

  !xDir = !boxOri.xDir()
  !yDir = !boxOri.yDir()
  !zDir = !boxOri.zDir()

  if (!element.hardType eq 'TUBI') then
    if (!isBranTube) then
      !boxOri = object ORIENTATION('Z is ' & !yDir.string().before('WRT') & ' and Y is ' & !xDir.string().before('WRT'))
    endif
  else
    !boxOri = object ORIENTATION('Y is ' & !yDir.string().before('WRT') & ' and Z is ' & !zDir.string().before('WRT'))
--    !boxOri = object ORIENTATION('Z is ' & !yDir.STRING().before('WRT') & ' and Y is ' & !xDir.STRING().before('WRT'))
  endif

  !box.orientation = !boxOri

  --!gphBox = object GPHBOX(!box)
--  !gphBox.draw(123)

  if (!isBranTube) then
    !xDir = !boxOri.zDir()
    !yDir = !boxOri.yDir().opposite()
  else
    !xDir = !boxOri.xDir()
    !yDir = !boxOri.yDir()
  endif
  if (!isBranTube) then
    !crossDir = !xDir.cross(!yDir).opposite()
    !tempFromPos  = !fromPos.offset(!crossDir, !box.xLength * 0.5 )
    !fromPos  = !tempFromPos.offset(!yDir.opposite(), !box.xLength * 0.5 )

    !tempToPos = !toPos.offset(!crossDir, !box.xLength * 0.5 )
    !toPos     = !tempToPos.offset(!yDir, !box.xLength * 0.5).offset(!crossDir.opposite(), !box.xLength)
    --!newtoPos  = !tempToPos.offset(!yDir, !box.xLength * 0.5).offset(!crossDir, !box.xLength)
  endif

  -- evaluate front panel
  !pv1 = object POINTVECTOR(!fromPos, !xDir)
  !pv2 = object POINTVECTOR(!fromPos, !yDir)
  !pv3 = !pv1.through(!toPos)
  !pv4 = !pv2.through(!toPos)

  !pointVectorNew3 = object POINTVECTOR(!fromPos, !zDir.opposite())
  !pointVectorPos = !pointVectorNew3.through(!toPos)

  !frontVertex = object ARRAY()
  !frontVertex[1] = !fromPos
  !frontVertex[2] = !pv3.position
  !frontVertex[4] = !pv4.position
  if (!isBranTube) then
    !frontVertex[3] = !frontVertex[4].offset(!xDir, !frontVertex[1].distance(!frontVertex[2]))
  else
--    !frontVertex[3] = !frontVertex[4].offset(!boxOri.xDir(), !fromPos.distance(!frontVertex[2]))
    !frontVertex[3] = !pointVectorPos.position
  endif
  -- evaluate back panel
  --!pv5  = object POINTVECTOR(!fromPos, !boxOri.zDir())
  --!pv6  = !pv5.through(!toPos)
  --!dir  = !pv5.position.direction(!pv6.position)
  --!dist = !pv5.position.distance(!pv6.position)


  !pointVector1 = object POINTVECTOR(!toPos, !xDir)
  !pointVector2 = object POINTVECTOR(!toPos, !yDir)
  !pointVector3 = !pointVector1.through(!fromPos)
  !pointVector4 = !pointVector2.through(!fromPos)

  !pointVectorNew3 = object POINTVECTOR(!toPos, !zDir.opposite())
  !pointVectorPos = !pointVectorNew3.through(!fromPos)

  !rearVertex = object ARRAY()
  !rearVertex[1] = !toPos
  !rearVertex[2] = !pointVector3.position
  !rearVertex[4] = !pointVector4.position

  if (!isBranTube) then
    !rearVertex[3] = !rearVertex[4].offset(!xDir.opposite(), !rearVertex[1].distance(!rearVertex[2]))
  else
--    !frontVertex[3] = !frontVertex[4].offset(!boxOri.xDir(), !fromPos.distance(!frontVertex[2]))
    !rearVertex[3] = !pointVectorPos.position
  endif
  !this.positions.append(!frontVertex[1])
  !this.positions.append(!frontVertex[2])
  !this.positions.append(!frontVertex[3])
  !this.positions.append(!frontVertex[4])
  !this.positions.append(!rearVertex[1])
  !this.positions.append(!rearVertex[2])
  !this.positions.append(!rearVertex[3])
  !this.positions.append(!rearVertex[4])

endmethod

define method .evauateBoundary(!volume is ARRAY, !isForTank is BOOLEAN) is ARRAY
  !result = object ARRAY()

  !xLen = !volume[1]
  !yLen = !volume[2]
  !zLen = !volume[3]

  !xDir = U
  !yDir = U
  !zDir = U

  if (!isForTank) then
    !xLen = !xLen + 0.1mm
    !yLen = !yLen + 0.1mm
    !zLen = !zLen + 0.1mm

    !basePos = E -0.1mm N -0.1mm U -0.1mm
  else
    !basePos = E 0mm N 0mm U 0mm
  endif

  !vertex1 = object ARRAY()
  !vertex1.append(!basePos)
  !vertex1.append(E $!<xLen> N 0 U 0)
  !vertex1.append(E $!<xLen> N $!<yLen> U 0)
  !vertex1.append(E 0 N $!<yLen> U 0)
  !vertex1.append(!basePos)

  !vertex2 = object ARRAY()
  !vertex2.append(!basePos)
  !vertex2.append(E $!<xLen> N 0 U 0)
  !vertex2.append(E $!<xLen> N $!<zLen> U 0)
  !vertex2.append(E 0 N $!<zLen> U 0)
  !vertex2.append(!basePos)

  !vertex3 = object ARRAY()
  !vertex3.append(!basePos)
  !vertex3.append(E $!<yLen> N 0 U 0)
  !vertex3.append(E $!<yLen> N $!<zLen> U 0)
  !vertex3.append(E 0 N $!<zLen> U 0)
  !vertex3.append(!basePos)

  !profile1 = object PROFILE(!basePos, object ORIENTATION('Z is ' & !zDir.string().before('WRT')), !vertex1)
  !profile2 = object PROFILE(!basePos, object ORIENTATION('Z is ' & !yDir.string().before('WRT')), !vertex2)
  !profile3 = object PROFILE(!basePos, object ORIENTATION('Z is ' & !xDir.string().before('WRT')), !vertex3)

  !result.append(!profile1)
  !result.append(!profile2)
  !result.append(!profile3)

  return !result
endmethod
