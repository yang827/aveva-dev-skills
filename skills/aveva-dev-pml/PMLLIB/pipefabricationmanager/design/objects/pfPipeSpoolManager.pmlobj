--
-- Description:     pipe spool manager object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  getActivityTables(DBREF)         ARRAY               return assembly activity tables of the given pipe spool
--  getBendingTable(DBREF)           PFBENDINGTABLE      return bending table of the given pipe piece
--  getBendingTable(DBREF,BOOLEAN)   PFBENDINGTABLE      return bending table of the given pipe piece with xyz option
--  getBendingTables(DBREF)          ARRAY               return bending tables of the given pipe spool
--  getBendingVertices(DBREF)        ARRAY               return vertices of xyz bending table
--  getWeldingTables(DBREF)          ARRAY               return flange welding tables of the given pipe spool
--  getXYZBendingTables(DBREF)       ARRAY               return bending tables of the given pipe spool with xyz option
--  pfPipeSpoolManager()             -                   constructor
--
--------------------------------------------------------------------------------
define object PFPIPESPOOLMANAGER

  member  .assemblyActMgr   is PFASSEMBLYACTIVITYMANAGER

  member  .flangeUtility    is PFFLANGEUTILITY

endobject

--------------------------------------------------------------------------------
--
-- Method:      pfPipeSpoolManager
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--
-- Return:
--   [Data Type]             [Description]
--
--------------------------------------------------------------------------------
define method .pfPipeSpoolManager()

  -- initialize pipe fabrication context
  !context = object PFCONTEXT()
  !context.globalInstance()

endmethod

--------------------------------------------------------------------------------
--
-- Method:      getActivityTables
--
-- Description: return assembly activity table of the given pipe spool
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--    1    R      DBREF                        pipe spool element
-- Return:
--   [Data Type]             [Description]
--    ARRAY                   array of assembly activities
--------------------------------------------------------------------------------
define method .getActivityTables(!pspoolRef is DBREF) is ARRAY
  return !this.assemblyActMgr.getAssemblyActivities(!pspoolRef)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getBendingTables
--
-- Description: return bending tables of the given pipe spool
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--    1    R      DBREF                        pipe spool element
-- Return:
--   [Data Type]             [Description]
--    ARRAY                   array of bending table
--------------------------------------------------------------------------------
define method .getBendingTables(!pspoolRef is DBREF) is ARRAY

  !bendingTables = object ARRAY()

  do !ppieceRef values !pspoolRef.pprfa
    !bendingTable = !this.getBendingTable(!ppieceRef)
    if !bendingTable.set() and !bendingTable.activities.empty().not() then
      !bendingTables.append(!bendingTable)
    endif
  enddo

  return !bendingTables
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getXYZBendingTables
--
-- Description: return xyz bending tables of the given pipe spool
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--    1    R      DBREF                        pipe spool element
-- Return:
--   [Data Type]             [Description]
--    ARRAY                   array of xyz bending table
--------------------------------------------------------------------------------
define method .getXYZBendingTables(!pspoolRef is DBREF) is ARRAY

  !bendingTables = object ARRAY()

  do !ppieceRef values !pspoolRef.pprfa
    !bendingTable = !this.getBendingTable(!ppieceRef, true)
    if !bendingTable.set() and !bendingTable.activities.empty().not() then
      !bendingTables.append(!bendingTable)
    endif
  enddo

  return !bendingTables

endmethod

--------------------------------------------------------------------------------
--
-- Method:      getWeldingTables
--
-- Description: return flange welding tables of the given pipe spool
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--    1    R      DBREF                        pipe spool element
-- Return:
--   [Data Type]             [Description]
--    ARRAY                   array of flange welding table
--------------------------------------------------------------------------------
define method .getWeldingTables(!pspoolRef is DBREF) is ARRAY

  !weldingTables = object ARRAY()

  do !ppieceRef values !pspoolRef.pprfa

    !fmweldRef = !ppieceRef.weldmc
    skip if !fmweldRef.badref()

    !weldingTable = object PFWELDINGTABLE()
    !weldingTable.pipePiece = !ppieceRef

    -- welding machine
    !weldingTable.weldingMachine = !fmweldRef

    -- arrive flange
    !arriveType = ''
    if !ppieceRef.awdarr then
      !arriveRef  = !ppieceRef.pparef
      !arriveType = !arriveRef.type
      if !arriveType.eq('WELD') and !arriveRef.shop then
        !sequence = !arriveRef.sequence
        if !sequence.gt(1) then
          !branRef    = !arriveRef.owner
          !arriveRef  = !branRef.members[!sequence - 1]
          !arriveType = !arriveRef.type
        endif
      endif

      if !arriveRef.shop and (!arriveType.eq('FLAN') or !arriveType.eq('LJSE')) then
        !weldingTable.arriveFlange = !arriveRef
        !weldingTable.arriveFlangeWelded = true
      endif
    endif
    --//

    -- leave flange
    !leaveType = ''
    if !ppieceRef.awdlev then
      !leaveRef  = !ppieceRef.pplref
      !leaveType = !leaveRef.type
      if !leaveType.eq('WELD') and !leaveRef.shop then
        !sequence = !leaveRef.sequence
        !branRef = !leaveRef.owner
        if !sequence.lt(!branRef.mcount()) then
          !leaveRef  = !branRef.members[!sequence + 1]
          !leaveType = !leaveRef.type
        endif
      endif

      if !leaveRef.shop and (!leaveType.eq('FLAN') or !leaveType.eq('LJSE')) then
        !weldingTable.leaveFlange = !leaveRef
        !weldingTable.leaveFlangeWelded = true
      endif
    endif
    --//

    -- calculate flange offset angle -----------------------------------------
    if !weldingTable.arriveFlangeWelded and !weldingTable.leaveFlangeWelded and !arriveType.eq('FLAN') and !leaveType.eq('FLAN') then

      !arriveFlange = !weldingTable.arriveFlange
      !leaveFlange  = !weldingTable.leaveFlange

      !arriveFlangeDir = !this.flangeUtility.getAlignmentDirection(!arriveFlange, !arriveFlange.arrive)
      !leaveFlangeDir = !this.flangeUtility.getAlignmentDirection(!leaveFlange, !leaveFlange.leave)

      do !boundaryPart values !ppieceRef.aelrfa
        if !boundaryPart.type.eq('BEND') then
          !axis = !boundaryPart.ldir.cross(!boundaryPart.adir)
          !!pfRotateDirection(!arriveFlangeDir, !boundaryPart.angle, !axis)
        endif
      enddo

      !boltNumber1 = !this.flangeUtility.getBoltNumber(!arriveFlange, !arriveFlange.arrive)
      !boltNumber2 = !this.flangeUtility.getBoltNumber(!leaveFlange, !leaveFlange.leave)

      !offsetAngle = !this.flangeUtility.getAlignmentOffsetAngle(!boltNumber1, !boltNumber2, !arriveFlangeDir, !leaveFlangeDir, !leaveFlange.adir)
      !weldingTable.angle = !offsetAngle

    endif
    --//

    if !weldingTable.arriveFlangeWelded or !weldingTable.leaveFlangeWelded then
      !weldingTables.append(!weldingTable)
    endif

  enddo

  return !weldingTables

endmethod


--------------------------------------------------------------------------------
--
-- Method:      getBendingTable
--
-- Description: return bending table for the given pipe piece
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--    1    R      DBREF                        pipe piece reference
-- Return:
--   [Data Type]             [Description]
--    PFBENDINGTABLE          bending table
--------------------------------------------------------------------------------
define method .getBendingTable(!ppieceRef is DBREF) is PFBENDINGTABLE
  return !this.getBendingTable(!ppieceRef, !!pfContext.xyzBendingTable)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getBendingTable
--
-- Description: return bending table for the given pipe piece
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--    1    R      DBREF                        pipe piece reference
--    2    R      BOOLEAN                      true : xyz bending table
-- Return:
--   [Data Type]             [Description]
--    PFBENDINGTABLE          bending table
--------------------------------------------------------------------------------
define method .getBendingTable(!ppieceRef is DBREF, !xyz is BOOLEAN) is PFBENDINGTABLE

  !bendingTable = object PFBENDINGTABLE()
  !bendingTable.pipePiece = !ppieceRef

  if !ppieceRef.ppcnbd then

    !bendingTable.bendingMachine       = !ppieceRef.bendmc
    !bendingTable.lengthInsideMachine  = !ppieceRef.lenInside
    !bendingTable.lengthOutsideMachine = !ppieceRef.lenOutside

    if !xyz then
      !vertices = !this.getBendingVertices(!ppieceRef)
      do !vertex values !vertices
        !bendingTable.activities.append(object PFBENDINGACTIVITY(!vertex.east, !vertex.north, !vertex.up))
      enddo
    else
      !comUnits  = object COMUNITS()
      !distUnit  = !comUnits.getCurrentUnitsByPtype('DIST')
      !angleUnit = !comUnits.getCurrentUnitsByPtype('ANGL')

      !activityValues = !ppieceRef.:PFBendAct

      !count = !activityValues.size()
      do !i to !count by 3
        !activity = object PFBENDINGACTIVITY()

        if !i.eq(1) and !ppieceRef.mcbent and !!pfContext.firstFeedNegative then
          !activity.feed = !bendingTable.lengthInsideMachine * -1
        else
          !activity.feed = !!comConvertUnknownValue(!activityValues[!i], !distUnit)
        endif

        if !count.geq(!i + 1) then
          !activity.rotate = !!comConvertUnknownValue(!activityValues[!i + 1], !angleUnit)
          if !count.geq(!i + 2) then
            !activity.bend = !!comConvertUnknownValue(!activityValues[!i + 2], !angleUnit)
          endif
        endif
        !bendingTable.activities.append(!activity)
      enddo
    endif
  endif

  -- get bending element information( radius, length)
  do !partRef values !ppieceRef.cmprfa
    skip if (!partRef.type ne 'BEND')

    !bendInfo = object PFBENDINGELEMENTINFO(!partRef)
    !bendingTable.bendingElementsInfo.append(!bendInfo)
  enddo

  return !bendingTable
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getBendingVertices
--
-- Description: return vertices of xyz bending table
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--    1    R      DBREF                        pipe piece reference
--
-- Return:
--   [Data Type]             [Description]
--    ARRAY                   bending points of pipe piece
--------------------------------------------------------------------------------
define method .getBendingVertices(!ppieceRef is DBREF) is ARRAY
  !vertices = object ARRAY()

  !bendRefs = object ARRAY()
  do !partRef values !ppieceRef.cmprfa
    if !partRef.type.eq('BEND') then
      !bendRefs.append(!partRef)
    endif
  enddo

  if !bendRefs.empty() then
    return !vertices
  endif

  !arriveBoundary = !ppieceRef.pparef
  !leaveBoundary  = !ppieceRef.pplref

  !arriveBoundaryType = !arriveBoundary.type
  !leaveBoundaryType  = !leaveBoundary.type

  -- start vertex, always  0,0,0 -----------------------------------------------
  !origin        = object POSITION()
  !origin.east   = 0mm
  !origin.north  = 0mm
  !origin.up     = 0mm
  !origin.origin = /*

  !vertices.append(!origin)
  --//

  -- vertex for the first bend  ------------------------------------------------
  !legLength = 0mm
  if !arriveBoundaryType.eq('BRAN') then
    !legLength = !arriveBoundary.hpos.distance(!bendRefs[1].pos)
  elseif !arriveBoundaryType.eq('BEND') then
    !mitreLength = 0mm
    !numberOfCuts = !arriveBoundary.actNCuts
    if !numberOfCuts.gt(0) then
      !outDiameter = !arriveBoundary.aodiam
      !bendAngle   = !arriveBoundary.angle
      !bendRadius  = !arriveBoundary.radius
      !mitreLength = (!bendRadius + !outDiameter / 2) * TAN(!bendAngle * 0.5 / !numberOfCuts)
    endif
    !legLength = !mitreLength + !arriveBoundary.lpos.distance(!bendRefs[1].pos)
  else
    !legLength = !arriveBoundary.lpos.distance(!bendRefs[1].pos)
    if !arriveBoundary.type.eq('FLAN') then
      !legLength = !legLength + !arriveBoundary.flallowance
    endif
  endif

  !legLength = !legLength + !ppieceRef.baexss.max(!ppieceRef.uaexss).max(!ppieceRef.aexcess)
  !direction = !bendRefs[1].adir.opposite()

  !vertex = !origin.offset(!direction, !legLength)
  !vertices.append(!vertex)
  --//

  -- vertices of bends after the first bend ------------------------------------
  !bendFeedExcesses = !ppieceRef.fedexs
  !userFeedExcesses = !ppieceRef.minfed

  !bendFeedCount = !bendFeedExcesses.size()
  !userFeedCount = !userFeedExcesses.size()

  !loop = !bendRefs.size() - 1
  do !i to !loop

    if !i.leq(!bendFeedCount) then
      !bendFeedExcess = !bendFeedExcesses[!i]
    else
      !bendFeedExcess = 0mm
    endif

    if !i.leq(!userFeedCount) then
      !userFeedExcess = !userFeedExcesses[!i]
    else
      !userFeedExcess = 0mm
    endif

    !legLength = !bendRefs[!i].pos.distance(!bendRefs[!i + 1].pos) + !bendFeedExcess.max(!userFeedExcess)
    !direction = !bendRefs[!i].ldir

    !vertex = !vertex.offset(!direction, !legLength)
    !vertices.append(!vertex)
  enddo
  --//

  -- end vertex ----------------------------------------------------------------
  !legLength = 0mm
  !lastBendRef = !bendRefs.last()
  if !leaveBoundaryType.eq('BRAN') then
    !legLength = !lastBendRef.pos.distance(!leaveBoundary.tpos)
  elseif !leaveBoundaryType.eq('BEND') then
    !mitreLength = 0mm
    !numberOfCuts = !leaveBoundary.actNCuts
    if !numberOfCuts.gt(0) then
      !outDiameter = !leaveBoundaryType.aodiam
      !bendAngle   = !leaveBoundaryType.angle
      !bendRadius  = !leaveBoundaryType.radius
      !mitreLength = (!bendRadius + !outDiameter / 2) * TAN(!bendAngle * 0.5 / !numberOfCuts)
    endif
    !legLength = !mitreLength + !lastBendRef.pos.distance(!leaveBoundary.apos)
  else
    !legLength = !lastBendRef.pos.distance(!leaveBoundary.apos)
    if !leaveBoundary.type.eq('FLAN') then
      !legLength = !legLength + !leaveBoundary.flallowance
    endif
  endif

  !legLength = !legLength + !ppieceRef.blexss.max(!ppieceRef.ueexss).max(!ppieceRef.lexcess)
  !direction = !lastBendRef.ldir

  !vertex = !vertex.offset(!direction, !legLength)
  !vertices.append(!vertex)
  --//

  if !ppieceRef.bwithf then
    -- reverse it
    !vertices.invert()

    !dx = !vertices[1].east
    !dy = !vertices[1].north
    !dz = !vertices[1].up

    do !i indices !vertices
      !vertices[!i].east  = !vertices[!i].east  - !dx
      !vertices[!i].north = !vertices[!i].north - !dy
      !vertices[!i].up    = !vertices[!i].up    - !dz
    enddo

  endif

  return !vertices
endmethod
