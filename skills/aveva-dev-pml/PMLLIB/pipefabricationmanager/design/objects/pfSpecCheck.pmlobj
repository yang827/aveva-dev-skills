define object PFSPECCHECK
  -- no members
endobject

--------------------------------------------------------------------------------
--
-- Method:      initialize
--
-- Description: not used in this object
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type]                  [Description]
--
-- Return:
--   [Data Type]             [Description]
--
--------------------------------------------------------------------------------
define method .initialize()
  -- no operation
endmethod

--------------------------------------------------------------------------------
--
-- Method:      check
--
-- Description: check specification reference of components
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       target branch element
--    2   RW     ARRAY       check results
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .check(!targetRef is DBREF, !results is ARRAY )

  !memberRefs = !targetRef.members
  --!branSpec = !targetRef.pspec
  do !memberRef value !memberRefs
    if !memberRef.spref.badref() then
      !results.append(object PFSPECCHECKRESULT(!memberRef))
    endif

--    if !memberRef.actType ne ':THRE' then
--      if !memberRef.type ne 'FTUB' then
--        if !memberRef.spref.badref() then
--          !results.append(object PFSPECCHECKRESULT(!memberRef))
--        else
--          !compSpec = spec of $!memberRef.spref
--          if !branSpec ne !compSpec then
--            !results.append(object PFSPECCHECKRESULT(!memberRef))
--          endif
--        endif
--      endif
--    endif
  enddo
endmethod
