--
-- Description:     result for checking spref of components
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  display()                        -                   display check result in the 3D view
--  fix(STRING)                      BOOLEAN             fix the problem
--  getMessage()                     STRING              return detailed result message
--  getResultLevel()                 REAL                return error level
--  getSolutionMethods()             ARRAY               return solution methods to fix the problem
--  pfSpecCheckResult(DBREF)         -                   constructor
--  zoom(DBREF)                      -                   zoom the given element
--
--------------------------------------------------------------------------------
define object PFSPECCHECKRESULT
  member  .partRef is DBREF
endobject

--------------------------------------------------------------------------------
--
-- Method:      pfSpecCheckResult
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       component which has invalid spref
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfSpecCheckResult(!partRef is DBREF)
  !this.partRef = !partRef
endmethod

--------------------------------------------------------------------------------
--
-- Method:      display
--
-- Description: display check result in 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .display()

  !!ce = !this.partRef
  ENHANCE $!this.partRef COLOUR $!!gphColOpt.highlight
  !this.zoom(!this.partRef)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getMessage
--
-- Description: return detail check result string
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    STRING      detail check result string
--------------------------------------------------------------------------------
define method .getMessage() is STRING

  --if !this.partRef.spref.badref() then
  return !this.partRef.namty + ' : Bad spref'
  --else
  --  !compSpec = !this.partRef.spref.spowner.namn
  --  !branSpec = !this.partRef.owner.pspec.namn
  --  return 'Component spec. (' + !compSpec + ') is different from branch (' + !branSpec + ')'
  --endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getResultLevel
--
-- Description: return error level
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        error level
--                1 : information, 2 : warning, 3 : error
--------------------------------------------------------------------------------
define method .getResultLevel() is REAL
  return 3
endmethod

--
-- Method:      getSolutionMethods()
--
-- Description: return solution methods to fix the problem
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY     array of solution methods
--------------------------------------------------------------------------------
define method .getSolutionMethods() is ARRAY
  !methods = object ARRAY()
  !methods[1] = 'Choose component'
  !methods[2] = 'Delete component'
  return !methods
endmethod

--------------------------------------------------------------------------------
--
-- Method:      fix
--
-- Description: try to fix the problem
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      solution method
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     return true if the problem is fixed
--------------------------------------------------------------------------------
define method .fix(!method is STRING) is BOOLEAN

  !!ce = !this.partRef

  !undo = object UNDOABLE()
  !undo.description('PF - Fix Inconsistency')
  !undo.add()

  if !method.eq('Choose component') then

    --!spref = !this.partRef.spref

    !pspec = !this.partRef.owner.pspec
    if !pspec.badref() then
      !pspec = !this.partRef.owner.owner.pspec
    endif

    if !pspec.badref() then
      CHOOSE $!this.partRef.type
    else
      CHOOSE $!this.partRef.type SPEC $!pspec
    endif

    --if !this.partRef.spref.neq(!spref) then
    --!recheck = true
    --endif
  else
    !elementName = !this.partRef.flnm
    if (!!alert.confirm('OK to delete $!<elementName>?') ne 'YES') then
      return false
    endif

    DELETE $!<this.partRef.type>
    handle ANY
      !!alert.error(!!error.text)
      !undo.endUndoable()
      return false
    endhandle
  endif

  !undo.endUndoable()

  return true
endmethod

--------------------------------------------------------------------------------
--
-- Method:      zoom
--
-- Description: zoom the given element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       element to be zoomed
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .zoom(!element is DBREF)

  !volume = object VOLUME(!element)

  !from = !volume.from
  !to = !volume.to

  -- Through Point
  !throughPoint = !from.midPoint(!to)
  handle ANY
    return
  endhandle

  -- Set metric format
  !format           = object FORMAT()
  !format.units     = 'MM'
  !format.dp        = 0
  !format.dimension = 'L'

  -- Set through point
  !through[1] = !throughPoint.east.string(!format).real()
  !through[2] = !throughPoint.north.string(!format).real()
  !through[3] = !throughPoint.up.string(!format).real()
  !!fmSys.currentDocument().view.through = !through

  -- Set view radius
  !radius = !from.distance(!to).string(!format).real() / 2 * 1.25
  !radius = !radius.max(500mm)
  !!fmSys.currentDocument().view.radius  = !radius
endmethod
