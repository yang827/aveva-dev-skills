--
-- Description:     object for thread engagement data
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  pfThreadEngagement(STRING,STRING,BORE,REAL) -                   constructor
--  string()                         STRING              return string representation of the instance
--
--------------------------------------------------------------------------------
define object PFTHREADENGAGEMENT

  member  .connection   is STRING

  member  .description  is STRING

  member  .bore         is BORE

  member  .length       is REAL

endobject

--------------------------------------------------------------------------------
--
-- Method:      pfThreadEngagement
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      STRING        connection
--    2   R      STRING        description
--    3   R      BORE          bore
--    4   R      REAL          thread length
-- Return:
--   [Data Type]              [Description]
--
--------------------------------------------------------------------------------
define method .pfThreadEngagement(!connection is STRING, !description is STRING, !bore is BORE, !length is REAL)

  !this.connection = !connection
  !this.description = !description
  !this.bore = !bore
  !this.length = !length

endmethod

--------------------------------------------------------------------------------
--
-- Method:      string
--
-- Description: return string representation of the instance
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type]              [Description]
--    STRING                   string representation of the instance
--------------------------------------------------------------------------------
define method .string() is STRING
  return !this.connection + ', ' + !this.description + ', ' + !this.bore.string(!!boreFmt) + ', ' + !this.length.string(!!distanceFmt)
endmethod
