-- File:            pfThreadEngagementTable.pmlobj
--   Type:          Object Definition
--   Group:         Pipe Fabrication
--     Keyword:     PF
--   Module:        Design
--   Replaces:
--
-- Author:          DoHyoung Kim(Bright)
-- Created:         Wednesday 20th March 2013
--
-- Description:     object for thread engagement table
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  clear()                          -                   clear all data
--  load()                           -                   load all thread engagement data
--  lookup(STRING,BORE)              PFTHREADENGAGEMENT  lookup a thread engagement data by the given connection and bore
--
--------------------------------------------------------------------------------
define object PFTHREADENGAGEMENTTABLE

  member  .connections  is ARRAY

  member  .boreGroups   is ARRAY

  member  .dataGroups   is ARRAY

endobject

--------------------------------------------------------------------------------
--
-- Method:      lookup
--
-- Description: lookup a thread engagement data by the given connection and bore
--
-- Method Type: Function
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--    1   R      STRING        connection
--    2   R      BORE          bore
-- Return:
--   [Data Type]              [Description]
--    PFTHREADENGAGEMENTDATA   thread engagement data of the given connection and bore
--------------------------------------------------------------------------------
define method .lookup(!connection is STRING, !bore is BORE) is PFTHREADENGAGEMENT

  !conIndex = !this.connections.findFirst(!connection)
  if !conIndex.set() then
    !boreIndex = !this.boreGroups[!conIndex].findFirst(!bore)
    if !boreIndex.set() then
      return !this.dataGroups[!conIndex][!boreIndex]
    endif
  endif

  return object PFTHREADENGAGEMENT()
endmethod

--------------------------------------------------------------------------------
-- Method:      clear
--
-- Description: clear all data
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type]              [Description]
--
--------------------------------------------------------------------------------

define method .clear()
  !this.connections.clear()
  !this.boreGroups.clear()
  !this.dataGroups.clear()
endmethod

--------------------------------------------------------------------------------
--
-- Method:      load
--
-- Description: load all thread engagement data from database
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type]   [Description]
--
-- Return:
--   [Data Type]              [Description]
--
--------------------------------------------------------------------------------
define method .load()

  !this.clear()

  !appldwRefs = !!collectAllFor('APPLDW', |FUNC EQ 'PipeFabrication'|, /* )
  if !appldwRefs.empty() then
    return
  endif

  !ddseRefs = !!collectAllFor('DDSE', |FUNC EQ 'THREAD'|, !appldwRefs.first())
  if !ddseRefs.empty() then
    return
  endif

  !ddseRef = !ddseRefs.first()
  do !ddatRef values !ddseRef.members

    skip if !ddatRef.type.neq('DDAT')

    !connection  = !ddatRef.dkey
    !description = !ddatRef.description

    !block = object BLOCK(!ddatRef.ddproperty)
    !bore = !block.evaluate().bore()
    handle ANY
      !bore = object BORE(0mm)
    endhandle

    !block = object BLOCK(!ddatRef.dddfault)
    !threadLength = !block.evaluate().real()
    handle ANY
      !threadLength = 0mm
    endhandle

    !data = object PFTHREADENGAGEMENT(!connection, !description, !bore, !threadLength)

    !index = !this.connections.findFirst(!connection)
    if !index.unset() then
      !this.connections.append(!connection)
      !this.boreGroups.append(object ARRAY())
      !this.dataGroups.append(object ARRAY())
      !index = !this.connections.size()
    endif

    !this.boreGroups[!index].append(!bore)
    !this.dataGroups[!index].append(!data)
  enddo

endmethod
