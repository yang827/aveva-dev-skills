--
-- Method:      check
--
-- Description: check valve flow direction
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       target branch element
--    2   RW     ARRAY       check results
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .check(!targetRef is DBREF, !results is ARRAY )

  !memberRefs = !targetRef.members

  do !memberRef values !memberRefs
    !type = !memberRef.type
    if !type.eq('VALV') then

      if !memberRef.arrive.neq(1) then
        !results.append(object PFVALVEDIRCHECKRESULT(!memberRef))
      endif

