--   Module:        Design
--   Replaces:
--
-- Author:          HyunJong Roh (Nick)
--                  DoHyoung Kim (Bright)
-- Created:         Tuesday 6th December 2011
--
-- Description:     result object for checking valve flow direction
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  display()                        -                   display check result in the 3D view
--  fix(STRING)                      BOOLEAN             fix the problem
--  getMessage()                     STRING              return detailed result message
--  getPosition(DBREF)               -                   draw valve direction in the 3D view
--  getResultLevel()                 REAL                return error level
--  getSolutionMethods()             ARRAY               return solution methods to fix the problem
--  pfValveDirCheckResult(DBREF)     -                   constructor
--  zoom(DBREF)                      -                   zoom the given element
--
--------------------------------------------------------------------------------
define object PFVALVEDIRCHECKRESULT

  member  .valveRef is DBREF

endobject

--------------------------------------------------------------------------------
--
-- Method:      pfValveDirCheckResult
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       valve component
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfValveDirCheckResult(!valveRef is DBREF)
  !this.valveRef = !valveRef
endmethod

--------------------------------------------------------------------------------
--
-- Method:      display
--
-- Description: display check result in 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .display()

  !!ce = !this.valveRef

  ENHANCE $!this.valveRef COLOUR $!!gphColOpt.highlight

  !this.getPosition(!this.valveRef)

  !this.zoom(!this.valveRef)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getMessage
--
-- Description: return detail check result string
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    STRING      detail check result string
--------------------------------------------------------------------------------
define method .getMessage() is STRING
  return 'Valve flow direction is opposite against the branch : ' + !this.valveRef.flnm
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getResultLevel
--
-- Description: return error level
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        error level
--                1 : information, 2 : warning, 3 : error
--------------------------------------------------------------------------------
define method .getResultLevel() is REAL
  return 3
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getSolutionMethods()
--
-- Description: return solution methods to fix the problem
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY     array of solution methods
--------------------------------------------------------------------------------
define method .getSolutionMethods() is ARRAY
  !solutions = object ARRAY()
  !solutions[1] = 'Flip valve'
  return !solutions
endmethod

--------------------------------------------------------------------------------
--
-- Method:      fix
--
-- Description: try to fix the problem
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      solution method
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     return true if the problem is fixed
--------------------------------------------------------------------------------
define method .fix(!dummyMethod is STRING) is BOOLEAN

  !undo = object UNDOABLE()
  !undo.description('PF - Fix Inconsistency')
  !undo.add()

  !!ce = !this.valveRef
  FLIP ORI
  handle ANY
    !!alert.error(!!error.text)
  endhandle

  !undo.endUndoable()

  return true
endmethod

--------------------------------------------------------------------------------
--
-- Method:      zoom
--
-- Description: zoom the given element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       element to be zoomed
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .zoom(!element is DBREF)

  !volume = object VOLUME(!element)

  !from = !volume.from
  !to   = !volume.to

  -- Through Point
  !throughPoint = !from.midPoint(!to)
  handle ANY
    return
  endhandle

  -- Set metric format
  !format           = object FORMAT()
  !format.units     = 'MM'
  !format.dp        = 0
  !format.dimension = 'L'

  -- Set through point
  !through[1] = !throughPoint.east.string(!format).real()
  !through[2] = !throughPoint.north.string(!format).real()
  !through[3] = !throughPoint.up.string(!format).real()
  !!fmSys.currentDocument().view.through = !through

  -- Set view radius
  !radius = !from.distance(!to).string(!format).real() / 2 * 1.25
  !radius = !radius.max(500mm)
  !!fmSys.currentDocument().view.radius  = !radius
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getPosition
--
-- Description: draw valve direction in the 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       valve component
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .getPosition(!valveRef is DBREF)

  !localVolume = object LOCALVOLUME(!valveRef, !valveRef)
  !fromPos     = !localVolume.from
  !toPos       = !localVolume.to

  !aPosition = !this.valveRef.aPosition
  !lPosition = !this.valveRef.lPosition
  !lDirection = !this.valveRef.lDirection
  !zdir = !this.valveRef.ori.zdir()

  !pointVector = object POINTVECTOR(!aPosition, !lDirection)
  !orientation = !pointVector.plane().orientation


  !line = !pointVector.line(1000mm)
  !dist1 = !fromPos.distance(!line.near(!fromPos))
  !dist2 = !toPos.distance(!line.near(!toPos))

  !radius = !dist1.max(!dist2)

  !endPosition1 = !aPosition.offset(!zdir, !radius)
  !endPosition2 = !endPosition1.offset(!lDirection, !aPosition.distance(!lPosition))
  !midPosition = !endPosition1.midPoint(!endPosition2)
  !height = !endPosition1.distance(!endPosition2)
  AID CYLI POS $!midPosition ORI $!orientation DIAM 15mm HEI $!height FILL ON

  !arrowPosition = !endPosition2.offset(!lDirection, -60mm)
  AID ARROW AT $!arrowPosition DIR $!lDirection HEI 80mm PROP 1

endmethod
