------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  checkDBWritable (PFWELDDATA)     BOOLEAN
--  checkExistWeldOnComponent(DBREF) BOOLEAN             check exist weld on component
--  createWeld(ARRAY,BOOLEAN,STRING,STRING,STRING,BOOLEAN,BOOLEAN) -                   create weld
--  createWeld(DBREF,BOOLEAN,STRING,STRING,STRING,BOOLEAN,BOOLEAN) -                   create weld
--  createWeldOnBranch(PFWELDDATA)   BOOLEAN             create weld on branch
--  evaluateAdjacentEntry(DBREF,BOOLEAN) DBREF               evaluate adjacent entry
--  evaluateBoreSize(PFWELDDATA)     REAL                evaluate Bore size
--  evaluateChooseConditions(DBREF)  BOOLEAN             evaluate choose conditions
--  evaluateCkey(STRING,STRING)      STRING
--  evaluateConfigureTable()         -                   evaluate configure table
--  evaluateMaterial(DBREF)          STRING              evaluate wall thickness
--  evaluateSourceData(DBREF)        -                   evaluate source data
--  evaluateSourceDataUsingComponents(ARRAY) -                   evaluate source data using components
--  evaluateWallThickness(DBREF)     STRING              evaluate wall thickness
--  getPositionForWeld(DBREF)        ARRAY               get position for weld
--  getWeldGapFromConfigTable(DBREF) REAL                get weld gap from config table
--  inputErrorList(STRING,STRING)    -                   input error list
--  inputWeldData()                  -                   input weld data
--  isValidConditionForTube(STRING)  STRING
--  isValidElementForWeld(DBREF)     BOOLEAN             is valid element for weld
--  isValidVolume(DBREF)             BOOLEAN             check whether element has valid volume or not
--  moveWeldForSlipOnFlangeInnerPart(ARRAY) -                   move weld into the slip-on flange
--  pfweldcontrol()                  -                   constructor
--  relocatedBranchMembers(ARRAY)    -                   relocated branch members
--  relocatedBranchMembers(ARRAY,ARRAY) -                   relocated branch members
--  removeAllWelds(DBREF)            -                   remove all welds
--  renumberAllWelds(DBREF)          -                   renumber All Welds
--  setAttributes(DBREF)             -                   set attributes
--  setStartWeldNumber(DBREF)        -                   set start weld number
--  setWeldAttributes(ARRAY)         -                   set weld attributes
--  setWeldAttributes(ARRAY,ARRAY)   -                   set weld attributes
--  validateEntryForFittingToFittingWeld(DBREF) -                   validateEntryForFittingToFittingWeld
--  validateEntryForWeld(DBREF)      -                   check whether entry is valid for weld or not
--
------------------------------------------------------------------------
-- Define object
define object PFWELDCONTROL
  member .validKeys              is ARRAY
  member .sourceData             is ARRAY
  member .sourceList             is ARRAY
  --  member .weldRefList            is ARRAY
  member .sType                  is STRING
  member .weldPrefix             is STRING
  member .lastWeldNumber         is REAL
  member .fabricationType        is STRING
  member .isAppendMode           is BOOLEAN
  member .weldConfigData         is ARRAY
  member .pipingSpecNames        is ARRAY
  member .configSpecMembers      is ARRAY
  member .useSpecFlag            is BOOLEAN
  member .zeroGap                is BOOLEAN
  member .weldGapSpecRef         is DBREF
  member .isShopWeld             is BOOLEAN
  member .isValidEnv             is BOOLEAN
  member .cocoTable              is CKYCOCOTABLE
  member .errorOccurred          is BOOLEAN
  member .applySlipOnFlange      is BOOLEAN
  member .chooseConditions       is STRING
  member .shopConditions         is STRING
  member .previousPipeSpec       is DBREF
  member .debugMode              is BOOLEAN
  member .singleWeldForSlipOn    is BOOLEAN
  member .weldGapTypeForFittings is STRING
  member .undo                   is UNDOABLE
  member .errorList              is ARRAY
  member .refTeeList             is ARRAY
  member .stypeForShopSocketWeld is STRING
  member .stypeForFieldSocketWeld is STRING
  member .stypeForSiteSocketWeld is STRING
  member .stypeForWeldConfig     is ARRAY
  member .selectedStypeIndex     is REAL
  member .originalStype          is STRING
  member .originalConditions     is STRING
  member .slipOnWeldFromSpec     is BOOLEAN
  member .checkDbWriteObject  is COMCHECKDBWRITE
  --157504
  member .pipecompsoutofspec      is REAL
  --/157504
endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      pfweldcontrol
-- Description: pfweldcontrol
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pfweldcontrol()
  !this.validKeys = split('BW,SW',',')

  !this.evaluateConfigureTable()

  !this.isValidEnv = true

  --  if (!this.pipingSpecNames.unset()) then
  --    !!alert.message(|Function currently unavailable. Please make APPDAR with 'WELD.GAP-CONFIG' in function attribute|)
  --    !this.isValidEnv = false
  --    return
  --  endif
  --157504
  !this.pipecompsoutofspec = 0
  --/157504
  !this.weldGapSpecRef = /WELDGAP
  handle any
    !this.weldGapSpecRef = object DBREF()
  endhandle

  if (!this.weldGapSpecRef.badRef()) then
    !!alert.message('Function currently unavailable. Please check Spec for Weld Gap (/WELDGAP) in the paragon.')
    !this.isValidEnv = false
  endif

  !this.debugMode = false
  if (!this.weldGapSpecRef.badRef()) then
    return
  endif

  !weldSpcoForConfig = !!collectAllFor('SPCO', '', !this.weldGapSpecRef)

  !configStypes = object ARRAY()
  do !spco values !weldSpcoForConfig
    !configStypes.append(!spco.owner.tans)
  enddo

  !configStypes.unique()

  !this.stypeForWeldConfig = !configStypes
  !this.checkDbWriteObject.showalert  = false

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateCkey
-- Description: evaluate connection key
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      arrive connection
--    2   R      STRING      leave connection
-- Return:
--   [Data Type] [Description]
--    1   R      STRING      return to connection key
--
------------------------------------------------------------------------
define method .evaluateCkey(!arriveConnection is STRING, !leaveConnection is STRING) is STRING
  !result = ''
  !this.cocoTable.changeCe(world)
  if (!this.cocoTable.textArray.unset()) then
    return !result
  endif

  !cocoTableData = !this.cocoTable.textArray
  do !data values !cocoTableData
    if (!data.occurs('ANY') gt 0) then
      !leaveConnectionKey = 'ANY'
    else
      !leaveConnectionKey = !leaveConnection
    endif

    var !buttWeldKey1   COMPOSE |$!arriveConnection|    WIDTH 9 |$!leaveConnectionKey| WIDTH 9 |BW|
    var !buttWeldKey2   COMPOSE |$!leaveConnectionKey|  WIDTH 9 |$!arriveConnection|   WIDTH 9 |BW|

    var !socketWeldKey1 COMPOSE |$!arriveConnection|    WIDTH 9 |$!leaveConnectionKey| WIDTH 9 |SW|
    var !socketWeldKey2 COMPOSE |$!leaveConnectionKey|  WIDTH 9 |$!arriveConnection|   WIDTH 9 |SW|

    !searchButtWeld   = !data.occurs(!buttWeldKey1[1])   gt 0 OR !data.occurs(!buttWeldKey2[1]) gt 0
    !searchSocketWeld = !data.occurs(!socketWeldKey1[1]) gt 0 OR !data.occurs(!socketWeldKey2[1]) gt 0

    skip if (!searchButtWeld.not() and !searchSocketWeld.not())

    if (!searchButtWeld) then
      !result = 'BW'
    else
      !result = 'SW'
    endif

    break
  enddo

  if (!this.debugMode) then
    !debugString = '[evaluateCkey] : arriveConnection : $!arriveConnection, leaveConnection : $!leaveConnection, result : $!result'
    write '$!debugString'
  endif

  return !result
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateConfigureTable
-- Description: evaluate configure table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .evaluateConfigureTable()
  -- check APPLDW for Pipe Fabrication Manager
  !appldwRefs = !!collectAllFor('APPLDW', |FUNC EQ 'PipeFabrication'|, /* )
  if (!appldwRefs.empty()) then
    return
  endif

  !configDataRef = !!collectAllFor('APPDAR', |FUNC eq 'WELD.GAP-CONFIG'|, !appldwRefs[1])
  handle any
    !configDataRef = object DBREF()
  endhandle

  !members = !configDataRef[1].members
  handle any
    return
  endhandle
  !this.pipingSpecNames   = !members.evaluate(object BLOCK(|!members[!evalIndex].func|))
  !this.configSpecMembers = !members
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      renumberAllWelds
-- Description: renumber All Welds
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .renumberAllWelds(!element is DBREF)

  !this.lastWeldNumber = 1
  !weldList = !!collectAllFor('WELD','',!element)

  --Free up all names to avoid using the same name twice
  do !i index !weldList

    !pipeName = !!dtbGetOwnerType(!weldList[!i],|PIPE|).namn
    !weldName = '/' & !pipeName & '\tempName' & !i.string()

    !weldList[!i].name = !weldName

  enddo

  --Attempt to get the weld auto naming rule and use it.
  !weldNamingRule= !!namopt.getName('Pipe Weld Name')

  if(!weldNamingRule.unset()) then
    !weldName = |'/' & !!dtbGetOwnerType(!weldList[!i],'PIPE').namn & '/' & substring('0000' & !weldList[!i].wldn,-3,3)|
  else
    !weldNameFormat = !weldNamingRule.format.replace('!!ce', '!weldList[!i]')
    !weldName = |'/' & $!weldNameFormat|
  endif

  --Assign the name/weldnumber to the weld
  do !i index !weldList
    !weldList[!i].wldnumber = !this.lastWeldNumber
    !this.lastWeldNumber = !this.lastWeldNumber + 1

    !weldList[!i].name = $!weldName
  enddo

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createWeld
-- Description: create weld
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element
--    2    R     BOOLEAN     use spec
--    3    R     BOOLEAN     is shop
--    4    R     STRING      weld prefix
--    5    R     STRING      fabrication type
--    6    R     BOOLEAN     is append mode
--    7    R     BOOLEAN     zero gap
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createWeld(!element is DBREF, !useSpec is BOOLEAN, !weldStype is STRING, !weldPrefix is STRING, !fabricationType is STRING, !isAppendMode is BOOLEAN, !zeroGap is BOOLEAN)
  !this.originalStype = !weldStype
  !this.evaluateSourceData(!element)

  if (!this.sourceData.unset()) then
    return
  endif

  !saveCe = !!ce

  !this.undo.description('createWelds')
  !this.undo.add()

  !this.zeroGap           = !zeroGap
  !this.useSpecFlag       = !useSpec
  !this.weldPrefix        = !weldPrefix
  !this.fabricationType   = !fabricationType
  !this.isAppendMode      = !isAppendMode
  !this.errorOccurred     = false

  !this.errorList.clear()
  !this.refTeeList.clear()

  if (!this.previousPipeSpec.badRef()) then
    if (!element.hardType eq 'PIPE') then
      !this.previousPipeSpec = !element.pSpec
    endif
    !this.chooseConditions  = ''
  else
    if (!this.previousPipeSpec ne !element.pSpec) then
      !this.previousPipeSpec = !element.pSpec
      !this.chooseConditions  = ''
    endif
  endif

  if (!this.useSpecFlag.not()) then
    if (!this.weldGapSpecRef.badRef()) then
      !!alert.message('There is no weldgap spec. please install it.')
      return
    endif
  endif

  if (!this.isShopWeld) then
    !this.shopConditions = 'SHOP TRUE'
  else
    !this.shopConditions = 'SHOP FALSE'
  endif

  !this.setStartWeldNumber(!element)

  !count = !this.sourceData.size()

  !this.sType = !weldStype

  var !mode mode
  FORWARD

  prompt 'Creating Welds...'

  -- branch list which has relocated components.
  !relocatedBranchList = object ARRAY()
  !relocatedComponents = object ARRAY()

  !neededToMoveList = object ARRAY()

  do !i from 1 to !count
    !weldData = !this.sourceData[!i]

    -- check DB write access of the branch
    if(!this.checkDBWritable(!weldData).not()) then
      skip
    endif

    !response = !this.createWeldOnBranch(!weldData)

    if (!response.not()) then
      if (!!error.text.occurs('(61,164)') gt 0 and !this.useSpecFlag) then
        --        if (!this.stypeForSocketWeld.empty()) then
        !this.inputErrorList(!weldData.sourceElement.flnm, 'The Stype specified on the Weld Gap Config form does not exist in the current Pipe specification')
        --        else
        --          !this.inputErrorList(!weldData.sourceElement.flnm, |The current pipe spec does not contain welds with stype is '$!this.stypeForSocketWeld'|)
        --        endif
      elseif (!this.useSpecFlag and !!error.text.occurs('(2,822)') gt 0) then
        break
      else
        !this.inputErrorList(!weldData.sourceElement.flnm, !!error.text)
      endif

      skip
    endif

    skip if (!weldData.createdWeldRef.badRef())

    if (!weldData.newPosition.unset().not()) then
      !neededToMoveList.append(!weldData)
    endif

    !needToBeRelocated = !weldData.isFittingToFitting and !weldData.createdWeldRef.desp[1] gt 0
    handle (2,754)
      !needToBeRelocated = false
    endhandle

    !sourceBranchRef   = !weldData.sourceElement.owner

    if (!needToBeRelocated) then
      if (!relocatedComponents.findFirst(!weldData.createdWeldRef).unset()) then
        !relocatedComponents.append(!weldData.createdWeldRef)
      endif

      --      !index =  !relocatedBranchList.findFirst(!sourceBranchRef)
      --      if (!index.unset()) then
      --        !relocatedBranchList.append(!sourceBranchRef)
      --        !relocatedComponents[!relocatedBranchList.size()] = !weldData.createdWeldRef
      --      endif
    endif

    if(!weldData.sourceElement.loose.not() AND (!weldData.sourceElement.aexcess.neq(0mm) OR !weldData.sourceElement.lexcess.neq(0mm))) then
      if(undefined(!answer)) then
        !answer = !!alert.confirm('Creating welds may affect excesses currently set. Ok to continue?')
        if(!answer.eq('NO')) then
          UNDODB
          return
        endif
      endif
    endif

    !!displayProgress(!i, !count)
  enddo

  --Collect all of the welds that have just been created for the given element and pass on to set the attributes of them
  var !createdWelds coll all welds for $!element.ref

  if (!createdWelds.unset() and !this.useSpecFlag.not()) then
    --    !!alert.message('There was no suitable data in the Weld Gap Table')
    return
  endif

  prompt 'Sorting out welds'

  !this.relocatedBranchMembers(!relocatedComponents)
  --  !this.relocatedBranchMembers(!relocatedBranchList, !relocatedComponents)
  !this.setWeldAttributes(!createdWelds)
  !this.moveWeldForSlipOnFlangeInnerPart(!neededToMoveList)

  !this.undo.endUndoable()
  prompt dismiss

  !!fmsys.setProgress(0)
  $!mode

  !this.chooseConditions = ''

  !!ce = !saveCe
  handle any
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createWeld
-- Description: create weld
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       source elements
--    2    R     BOOLEAN     use spec
--    3    R     BOOLEAN     is shop
--    4    R     STRING      weld prefix
--    5    R     STRING      fabrication type
--    6    R     BOOLEAN     is append mode
--    7    R     BOOLEAN     zero gap
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createWeld(!sourceElements is ARRAY, !useSpec is BOOLEAN, !weldStype is STRING, !weldPrefix is STRING, !fabricationType is STRING, !isAppendMode is BOOLEAN, !zeroGap is BOOLEAN)
  !this.originalStype = !weldStype
  !this.evaluateSourceDataUsingComponents(!sourceElements)
  if (!this.sourceData.unset()) then
    return
  endif

  !this.undo.description('createWelds')
  !this.undo.add()

  !this.zeroGap           = !zeroGap
  !this.useSpecFlag       = !useSpec
  !this.weldPrefix        = !weldPrefix
  !this.fabricationType   = !fabricationType
  !this.isAppendMode      = !isAppendMode
  !this.errorOccurred      = false

  !this.errorList.clear()
  !this.refTeeList.clear()

  --  !this.isAppendMode  = true
  !pipeRef = pipe of $!sourceElements[1]
  !this.setStartWeldNumber(!pipeRef)

  if (!this.previousPipeSpec.badRef()) then
    !this.previousPipeSpec = !pipeRef.pSpec
    !this.chooseConditions  = ''
  else
    if (!this.previousPipeSpec ne !pipeRef.pSpec) then
      !this.previousPipeSpec = !pipeRef.pSpec
      !this.chooseConditions  = ''
    endif
  endif
  if (!this.isShopWeld) then
    !this.shopConditions = 'SHOP TRUE'
  else
    !this.shopConditions = 'SHOP FALSE'
  endif

  var !mode mode
  FORWARD

  !saveCe = !!ce
  !count = !this.sourceData.size()

  !this.sType = !weldStype

  var !mode mode
  FORWARD

  prompt 'Creating Welds...'

  -- branch list which has relocated components.
  !relocatedBranchList = object ARRAY()
  !relocatedComponents = object ARRAY()

  !createdWelds    = object ARRAY()
  !createdSequence = object ARRAY()
  !neededToMoveList = object ARRAY()

  do !i from 1 to !count
    !weldData = !this.sourceData[!i]

    -- check DB write access of the branch
    if(!this.checkDBWritable(!weldData).not()) then
      skip
    endif

    !response = !this.createWeldOnBranch(!weldData)

    if (!response.not()) then
      if (!!error.text.occurs('(61,164)') gt 0 and !this.useSpecFlag) then
        !this.inputErrorList(!weldData.sourceElement.flnm, 'The Stype specified on the Weld Gap Config form does not exist in the current Pipe specification')
      elseif (!this.useSpecFlag and !!error.text.occurs('(2,822)') gt 0) then
        break
      else
        !this.inputErrorList(!weldData.sourceElement.flnm, !!error.text)
      endif

      skip
    endif

    skip if (!weldData.createdWeldRef.badRef())

    !createdWelds.append(!weldData.createdWeldRef)

    !insertSequence = substring('000000' & !weldData.createdWeldRef.owner.owner.sequ, -6,6) & $
    substring('000000' & !weldData.createdWeldRef.owner.sequ, -6,6) & $
    substring('000000' & !weldData.createdWeldRef.sequ, -6,6)

    !createdSequence.append(!insertSequence)

    if (!weldData.newPosition.unset().not()) then
      !neededToMoveList.append(!weldData)
    endif

    !needToBeRelocated = !weldData.isFittingToFitting and !weldData.createdWeldRef.desp[1] gt 0
    !sourceBranchRef   = !weldData.sourceElement.owner


    if (!needToBeRelocated) then
      !index =  !relocatedBranchList.findFirst(!sourceBranchRef)
      if (!index.unset()) then
        !relocatedBranchList.append(!sourceBranchRef)
        !relocatedComponents[!relocatedBranchList.size()] = !weldData.createdWeldRef
      endif
    endif

    if(!weldData.sourceElement.loose.not() AND (!weldData.sourceElement.aexcess.neq(0mm) OR !weldData.sourceElement.lexcess.neq(0mm))) then
      if(undefined(!answer)) then
        !answer = !!alert.confirm('Creating welds may affect excesses currently set. Ok to continue?')
        if(!answer.eq('NO')) then
          UNDODB
          return
        endif
      endif
    endif

    !!displayProgress(!i, !count)
  enddo

  if (!createdWelds.unset() and !this.useSpecFlag.not()) then
    --    !!alert.message('There was no suitable data in the Weld Gap Table')
    return
  endif

  prompt 'Sorting out welds'

  --Check to see if all welds being created belong to the same pipe, if so we can collect all created welds to set attributes on
  --rather than set the attributes in created sequence
  !owningPipe = !sourceElements[1].owner.owner
  !sameOwner = true
  do !component values !sourceElements
    if(!owningPipe neq !component.owner.owner) then
      !sameOwner = false
      break
    endif
  enddo

  if(!sameOwner) then
    --Collect all of the welds that have just been created for the given element and pass on to set the attributes of them
    var !createdWelds collect all welds for $!owningPipe
    !this.setWeldAttributes(!createdWelds)
  else
    --Set the attributes of the weld in their created sequence rather than gathered sequence
    !this.setWeldAttributes(!createdSequence, !createdWelds)
  endif
  !this.relocatedBranchMembers(!relocatedComponents)
  --  !this.relocatedBranchMembers(!relocatedBranchList, !relocatedComponents)
  !this.moveWeldForSlipOnFlangeInnerPart(!neededToMoveList)

  !this.undo.endUndoable()
  prompt dismiss

  !!fmsys.setProgress(0)
  $!mode

  !this.chooseConditions = ''

  !!ce = !saveCe
  handle any
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      moveWeldForSlipOnFlangeInnerPart
-- Description: move weld into the slip-on flange
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .moveWeldForSlipOnFlangeInnerPart(!neededToMoveList is ARRAY)
  do !weldData values !neededToMoveList
    !!ce = !weldData.createdWeldRef

    if (!weldData.isArrive.not()) then
      !oldName       = !!ce.name
      !oldWeldNumber = !!ce.wldNumber
      unname
      !moveDir = !!ce.lDir.wrt(world)
      !additionalOffset = !weldData.sourceElement.lPos.distance(!weldData.sourceElement.pos)
    else
      !moveDir = !!ce.aDir.wrt(world)
      !additionalOffset = !weldData.sourceElement.aPos.distance(!weldData.sourceElement.pos)
    endif

    !flangeRef = !weldData.sourceElement
    --!flangeRef = prev flange
    --    handle any
    --      return
    --    endhandle

    !localVolume = object LOCALVOLUME(!flangeRef, !flangeRef)
    !box = !localVolume.box()
    !size = object ARRAY()
    !size.append(!box.xLength)
    !size.append(!box.yLength)
    !size.append(!box.zLength)
    !size.sort()

    --    !offsetDist = !size[1] - !flangeRef.aPos.distance(!flangeRef.lPos)
    !offsetDist = !size[1] - !additionalOffset

    --    conn to prev
    --    handle any
    --      return
    --    endhandle

    !newPosition = !weldData.createdWeldRef.pos.offset(!moveDir, !offsetDist)

    POS $!newPosition

    --If the source element is a branch it will not have an lstu available, instead we should take the welds lstu value for the weld from the hstu of the branch.
    if(!weldData.sourceElement.type.neq('BRAN')) then
      !weldData.createdWeldRef.lstu = !weldData.sourceElement.lstu
    else
      !weldData.createdWeldRef.lstu = !weldData.sourceElement.hstu
    endif
    LOFF TRUE

    if (!weldData.isArrive.not()) then
      !prevWeld = prev weld
      handle any
      elsehandle none
        !!ce = !prevWeld
        !newName = !!ce.name
        !newWeldNumber = !!ce.wldNumber

        name $!oldName
        handle any
        endhandle

        wldNumber $!oldWeldNumber

        !!ce = !weldData.createdWeldRef
        name $!newName
        handle any
        endhandle

        wldNumber $!newWeldNumber
      endhandle
    endif
  enddo
endmethod

------------------------------------------------------------------------
--
-- Method:      setWeldAttributes
-- Description: set weld attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setWeldAttributes(!createdSequence is ARRAY, !createdWelds is ARRAY)
  !sortedIndices = !createdSequence.sortedIndices()
  !createdWelds.reIndex(!sortedIndices)

  do !weldRef values !createdWelds
    !this.setAttributes(!weldRef)
  enddo
endmethod
------------------------------------------------------------------------
--
-- Method:      setWeldAttributes
-- Description: set weld attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setWeldAttributes(!createdWelds is ARRAY)
  do !weldRef values !createdWelds
    !this.setAttributes(!weldRef.dbref())
  enddo
endmethod
------------------------------------------------------------------------
--
-- Method:      relocatedBranchMembers
-- Description: relocated branch members
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .relocatedBranchMembers(!relocatedComponents is ARRAY)
  do !entry values !relocatedComponents
    !branchRef = !entry.owner

    !members = !!collectAllFor(|BRAN MEM|,||,!branchRef)
    !mCount = !members.size()


    !weldList  = !!collectAllFor('WELD', '', !branchRef)
    !weldSize  = !weldList.size()
    !moveOffset = !entry.desp[1]

    if (!entry eq !weldList[1] and !entry.sequ gt 1) then

      !fromIndex = !entry.sequ
      !toIndex   = 1
      !moveDir    = !entry.aDir.string().before('WRT')

      !existTube = false
      do !i from !fromIndex to !toIndex by -1
        if (!members[!i].tGeom) then
          !existTube = true
          break
        endif
      enddo

      if (!existTube.not()) then
        do !i from !fromIndex to !toIndex by -1
          !element = !members[!i]
          !!ce = !element
          by $!moveDir $!moveOffset

          if (!element.hardType inset ('OLET','TEE') and !element.cRef.badRef().not()) then
            !!ce = !element.cRef
            by $!moveDir $!moveOffset
          endif
        enddo
      endif

      if (!branchRef.tGeom.not()) then
        !branchRef.hPos = !branchRef.hPos.offset(object DIRECTION(!moveDir), !moveOffset)
      endif

    elseif (!entry eq !weldList[!weldSize] and !entry.sequ lt !mCount) then
      !fromIndex = !entry.sequ + 1
      !toIndex   = !mCount

      !moveDir    = !entry.lDir.string().before('WRT')

      do !i from !fromIndex to !toIndex
        if (!members[!i].tGeom) then
          !toIndex = !members[!i].sequ
          break
        endif
      enddo

      do !i from !fromIndex to !toIndex
        !element = !members[!i]
        if (!element.type.eq(|TUBI|)) then
          break
        endif
        !!ce = !element
        by $!moveDir $!moveOffset

        if (!element.hardType inset ('OLET','TEE') and !element.cRef.badRef().not()) then
          !!ce = !element.cRef
          by $!moveDir $!moveOffset
        endif
      enddo

      !branchRef.tPos = !branchRef.tPos.offset(object DIRECTION(!moveDir), !moveOffset)
    else
      !fromIndex = !entry.sequ + 1
      !toIndex   = !mCount

      !moveDir    = !entry.lDir.string().before('WRT')

      do !i from !fromIndex to !toIndex
        !element = !members[!i]

        if (!element.type.eq(|TUBI|)) then
          break
        endif
        !!ce = !element
        if (!element.eq(!entry).not()) then
          by $!moveDir $!moveOffset
        endif

        if (!element.hardType inset ('OLET','TEE') and !element.cRef.badRef().not()) then
          !!ce = !element.cRef
          by $!moveDir $!moveOffset
        endif
      enddo
    endif

  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      relocatedBranchMembers
-- Description: relocated branch members
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .relocatedBranchMembers(!relocatedBranchList is ARRAY, !relocatedComponents is ARRAY)

  do !index index !relocatedBranchList
    !branchRef = !relocatedBranchList[!index]
    !members   = !branchRef.members

    if (!branchRef.tRef.badRef()) then
      !minIndex = !relocatedComponents[!index].sequ + 1
      !maxIndex = !branchRef.mCount
      !step     = 1
      !connectionKey = 'prev'
    else
      !minIndex = !relocatedComponents[!index].sequ - 1
      !maxIndex = 1
      !step     = -1
      !connectionKey = 'next'
    endif

    do !i from !minIndex to !maxIndex by $!step
      !entry = !members[!i]
      !!ce = !entry
      skip if (!entry.hardType ne 'WELD' and !entry.tGeom)

      !ori = ori

      conn to $!<connectionKey>
      handle any
      elsehandle none
        ori $!ori
      endhandle

      break if (!entry.tGeom)
    enddo

    if (!branchRef.tGeom.not() and !branchRef.hPos.distance(!members.first().aPos) gt 0) then
      !branchRef.hPos = !members.first().aPos
    endif

    if (!members.last().tGeom.not() and !branchRef.tPos.distance(!members.last().aPos) gt 0) then
      !branchRef.tPos = !members.last().lPos
    endif


  enddo
endmethod

------------------------------------------------------------------------
--
-- Method:      setStartWeldNumber
-- Description: set start weld number
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setStartWeldNumber(!element is DBREF)
  !this.lastWeldNumber = 1

  if (!this.isAppendMode) then
    !weldList = !!collectAllFor('WELD', |spref ne nulref|,!element)
    !weldNumbers = object ARRAY()

    do !entry values !weldList
      skip if (!entry.badRef())

      !weldNumbers.append(!entry.wldNumber)
    enddo

    if (!weldNumbers.set()) then
      !sortedNumbers = !weldNumbers.sortUnique()
      !this.lastWeldNumber = !sortedNumbers.last() + 1
    endif
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      removeAllWelds
-- Description: remove all welds
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeAllWelds(!element is DBREF)
  !weldList = !!collectAllFor('WELD', '', pipe of $!element)
  do !weldRef values !weldList
    !!ce = !weldRef
    delete WELD
  enddo
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setAttributes
-- Description: set attributes
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setAttributes(!weldRef is DBREF)
  if (!weldRef.badRef()) then
    return
  endif

  if (!weldRef.wldNumber gt 0) then
    return
  endif

  !!ce = !weldRef

  wldNumber $!this.lastWeldNumber
  handle any
    return
  endhandle

  !this.lastWeldNumber = !this.lastWeldNumber + 1

  weldType $!this.fabricationType
  handle any
    write 'Weld element does not have weldtype attribute'
  endhandle
  --  handle (99,532)
  --    write 'Undefined UDA weldType on the MDB'
  --  endhandle

  call !!autoNameCe(false)

  same
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateBoreSize
-- Description: evaluate Bore size
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     PPWELDDATA  weld data
-- Return:
--   [Data Type] [Description]
--    1    R      return to evaluated bore size
------------------------------------------------------------------------
define method .evaluateBoreSize(!weldData is PFWELDDATA) is REAL
  !element = !weldData.sourceElement

  if (!element.hardType eq 'BRAN') then
    if (!element.mCount gt 0) then
      !boreSize = !element.members[1].aBore.real().value()
    else
      !boreSize = !element.hBore.real().value()
    endif
  else
    if (!element.hardType eq 'REDU') then
      if (!weldData.isArrive) then
        !boreSize = !element.aBore.real().value()
      else
        !boreSize = !element.lBore.real().value()
      endif
    else
      if (!element.aBore eq !element.lBore) then
        !boreSize = !element.aBore.real().value()
      else
        if (!weldData.isArrive) then
          !boreSize = !element.aBore.real().value()
        else
          !boreSize = !element.lBore.real().value()
        endif
      endif
    endif
  endif

  return !boreSize
endmethod

------------------------------------------------------------------------
--
-- Method:      createWeldOnBranch
-- Description: create weld on branch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     PPWELDDATA  weld data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createWeldOnBranch(!weldData is PFWELDDATA) is BOOLEAN
  !!ce = !weldData.sourceElement

  if (!!ce.type.eq('BRAN') and !!ce.sequ.eq(1)) then
    !isContainTube = !!ce.tGeom
  else
    !isContainTube = !!ce.tGeom or ( !weldData.sourceElement.sequ eq 1 and !weldData.sourceElement.owner.tGeom )
  endif

  if (!this.useSpecFlag.not()) then
    !testWeld = !this.stypeForWeldConfig.findFirst(!this.sType)
    if !testWeld.unset() then
      !!error.text = 'The Stype specified on the Weld Gap Config form does not exist in the current Pipe specification'
      return false
    endif
    !configStype = !this.stypeForWeldConfig[!testWeld]

    !weldGap = !this.getWeldGapFromConfigTable(!!ce)
    if (!weldGap lt 0) then
      return false
    endif

    --    if (!weldData.isSocketWeld and !this.errorOccurred.not() and !weldGap ne 0) then
    --      !!alert.message('Can create only socket weld with zero gap')
    --      !this.errorOccurred = true
    --    endif

    --    if (!weldData.isSocketWeld and !weldGap ne 0) then
    --      return true
    --    endif
  else
    !configStype = !this.sType
  endif

  !zeroGapForFittings = false
  if (!weldData.isFittingToFitting) then
    !zeroGapForFittings = !this.weldGapTypeForFittings eq 'ZERO'
  endif

  !this.originalConditions = ''
  if (!weldData.isSlipOnFlange or !weldData.isSocketWeld or !zeroGapForFittings) then
    !this.sType = !this.originalStype
    if (!this.useSpecFlag) then
      if (!weldData.isSocketWeld and !this.stypeForShopSocketWeld.empty().not() and !this.stypeForFieldSocketWeld.empty().not() and !this.stypeForSiteSocketWeld.empty().not()) then
        !this.originalConditions = !this.chooseConditions
        !useSpec = true
        --Assign the correct stype for the types of socket weld
        if(!this.stype eq !!pfweldgapconfig.shopStype.val) then
          !this.sType = !this.stypeForShopSocketWeld
        elseif (!this.stype eq !!pfweldgapconfig.fieldStype.val) then
          !this.sType = !this.stypeForFieldSocketWeld
        else
          !this.sType = !this.stypeForSiteSocketWeld
        endif
      elseif (!weldData.isSlipOnFlange and !this.slipOnWeldFromSpec) then
        !useSpec = true
      else
        !useSpec = false
        !weldGap = 0
      endif
    else
      !useSpec = false
      !weldGap = 0
      !spco = !this.weldGapSpecRef.name & '/' & !this.evaluateBoreSize(!weldData) & '/' & !this.sType
    endif
  else
    !this.sType = !this.originalStype
    !useSpec = !this.useSpecFlag
  endif

  !posKey  = 'AFTER'
  !connKey = 'PREV'
  if (!weldData.isArrive and !!ce.hardType ne 'BRAN') then
    !posKey = 'BEFORE'
    !connKey = 'NEXT'
  endif

  if (!weldData.sourceElement.hardType eq 'BRAN' and !weldData.isArrive.not()) then
    if (!weldData.sourceElement.mCount gt 0) then
      !!ce = last mem of $!weldData.sourceElement
      !posKey = 'AFTER'
    endif
  endif
  --157504
  !eleRefVal = !weldData.sourceElement
  if (!eleRefVal.type.eq(|BRAN|)) then
    !specVal = !eleRefVal.pspec.namn
  else
    !specVal = !!dtbGetOwnerType(!eleRefVal.spref,|SPEC|).namn
  endif

  if ( !!pfweldgapconfig.swCompOutOfSpec.val eq FALSE) then
    if(!weldData.sourceElement.type eq 'BRAN') then
      !pipeSpecVal = !weldData.sourceElement.pspec.namn
    else
      !pipeSpecVal = !!dtbGetOwnerType(!weldData.sourceElement,|PIPE|).pspec.namn
    endif
    !specVal = !pipeSpecVal
  else
    if(!weldData.sourceElement.type eq 'BRAN') then
      !pipeSpecVal = !weldData.sourceElement.pspec.namn
    else
      !pipeSpecVal = !!dtbGetOwnerType(!weldData.sourceElement,|PIPE|).pspec.namn
    endif
  endif
  --/157504

  if (!useSpec) then
    --NEW WELD CHOOSE WITH STYP $!this.sType EDGE FITU ALLO FALSE
    if (!this.chooseConditions.empty()) then
      NEW WELD $!posKey CHOOSE SPEC /$!specVal WITH $!this.shopConditions STYP $!this.sType
      handle any
        !errorMessage = !!error.text
        delete weld
        handle any
          !!error.text = !errorMessage
          return false
        endhandle
        !!ce = !weldData.sourceElement
        NEW WELD $!posKey CHOOSE SPEC /$!specVal WITH STYP $!this.sType
        handle any
          !errorMessage = !!error.text
          delete weld
          !!error.text = !errorMessage
          return false
        endhandle
      endhandle

      if (!this.evaluateChooseConditions(!!ce).not()) then
        delete weld
        return false
      endif
    else
      --  NEW WELD $!posKey CHOOSE WITH $!this.chooseConditions $!this.shopConditions STYP $!this.sType
      NEW WELD $!posKey CHOOSE SPEC /$!specVal WITH $!this.chooseConditions $!this.shopConditions STYP $!this.sType
      handle any
        !errorMessage = !!error.text
        delete weld
        if(!pipeSpecVal.neq(!specVal)) then
          !errorMessage = 'Out of spec welds not created as similar welds do not exist in the $!specVal specification'
        else
          if(!errorMessage.occurs('(61,164)') gt 0) then
            --This probably needs to be improved as 61,164 refers to a mismatch in given criteria so could be any of the choose conditions
            !errorMessage = 'The Stype specified on the Weld Gap Config form does not exist in the current Pipe specification'
          endif
        endif
        !!error.text = !errorMessage
        return false
      endhandle
    endif
    !weldGap = !!ce.aPos.distance(!!ce.lPos)
    DESP NUM 1 $!weldGap
    handle any
      !errorMessage = !!error.text
      delete weld
      !!error.text = !errorMessage
      return false
    endhandle
  else
    NEW WELD $!posKey
    handle any
      !errorMessage = !!error.text
      delete weld
      !!error.text = !errorMessage
      return false
    endhandle

    !weldgapSpec = SELECT SPEC /WELDGAP WITH STYP $!this.sType
    handle any
      !errorMessage = !!error.text
      delete weld
      !!error.text = !errorMessage
      return false
    endhandle
    --157504
    !this.pipecompsoutofspec = !this.pipecompsoutofspec + 1
    --/157504
    spref $!weldgapSpec[1]
    handle any
      !errorMessage = !!error.text
      delete weld
      return false
    endhandle
    DESP NUM 1 $!weldGap
    handle any
      !errorMessage = !!error.text
      delete weld
      !!error.text = !errorMessage
      return false
    endhandle
  endif

  if (!weldData.isFittingToFitting and !weldGap gt 0 and !this.errorOccurred.not()) then
    !this.errorOccurred = true
  endif

  !weldRef = !!ce
  !weldData.createdWeldRef = !weldRef

  if (!this.weldPrefix.empty().not()) then
    !weldRef.wldprefix = |$!<this.weldPrefix>|
  endif

  if (!weldData.sourceElement.hardType eq 'BRAN') then
    if (!weldData.isArrive) then
      conn
    else
      if (!weldData.sourceElement.mCount gt 1 and !weldData.sourceElement.tRef.badRef().not() and $
        !weldData.sourceElement.tRef.hardType inset ('TEE','OLET')) then

        !tailPos    = !weldData.sourceElement.tPos.wrt(world)
        !lastMember = Last mem of $!weldData.sourceElement

        !!ce = !weldData.sourceElement
        reorder $!weldRef after $!lastMember
        !!ce = !weldRef
        if(!!ce.abore neq !lastMember.lbore) then
          CHOOSE SPEC /$!specVal WITH STYP $!this.sType
        endif
        conn to prev
        !weldRef.pos = !tailPos
      else
        conn to pt
        handle any
        endhandle
      endif
    endif
  else
    if (!weldRef.sequ eq 1 and !weldRef.owner.hRef.badRef().not() and !isContainTube.not()) then
      conn to ph
    elseif (!weldRef.sequ eq !weldRef.owner.mCount and !weldRef.owner.tRef.badRef().not()) then
      conn to $!connKey
    else
      conn to $!connKey
    endif
  endif

  if (!this.isShopWeld) then
    shop TRUE
  else
    shop false
  endif

  -- select the lstu for all welds
  if(!weldData.sourceElement.type.neq('BRAN')) then
    !weldRef.lstu = !weldData.sourceElement.lstu
  else
    !weldRef.lstu = !weldData.sourceElement.hstu
  endif

  handle any
  endhandle


  if (!this.originalConditions.empty().not()) then
    !this.chooseConditions = !this.originalConditions
  endif
  return true
endmethod

-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateAdjacentEntry
-- Description: evaluate adjacent entry
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element ref
--    2    R     BOOLEAN     flag for check forward direction
-- Return:
--   [Data Type] [Description]
--    1    R     DBREF       return to adjacent entry
--
------------------------------------------------------------------------
define method .evaluateAdjacentEntry(!element is DBREF, !isForward is BOOLEAN) is DBREF
  !result = object DBREF()

  !sourceBranchRef = bran of $!element
  !members  =  !sourceBranchRef.members
  !memberCount = !sourceBranchRef.mCount

  if (!isForward) then
    if (!element.sequ ge !memberCount) then
      return !result
    endif
    !fromIndex = !element.sequ  + 1
    !toIndex   = !members.size()
    !step      = 1
  else
    if (!element.sequ le 1) then
      return !result
    endif

    !fromIndex = !element.sequ - 1
    !toIndex   = 1
    !step      = -1
  endif

  do !i from $!fromIndex to $!toIndex by $!step
    !element = !members[!i]
    skip if (!element.hardType eq 'ATTA')
    !result = !element
    break
  enddo

  return !result
endmethod

------------------------------------------------------------------------
--
-- Method:      evaluateChooseConditions
-- Description: evaluate choose conditions
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element ref
-- Return:
--   [Data Type] [Description]
--    1    R     BOOLEAN     return to evaluated result
--
------------------------------------------------------------------------
define method .evaluateChooseConditions(!element is DBREF) is BOOLEAN
  if (!this.chooseConditions.empty().not()) then
    return true
  endif

  !saveCe = !!ce

  !!ce = !element.spref
  handle (2,822)
    return false
  endhandle

  !answers   = object ARRAY()
  !questions = object ARRAY()

  do
    break if (!!ce.tans eq 'WELD')

    !answers.append(!!ce.tans)
    !!ce = !!ce.owner

    !questions.append(!!ce.question)
  enddo

  !answers.remove(!answers.size())
  !questions.remove(!questions.size())

  !removeIndex = !questions.findFirst('SHOP')
  !answers.remove(!removeIndex)
  !questions.remove(!removeIndex)

  !removeIndex = !questions.findFirst('STYP')
  !answers.remove(!removeIndex)
  !questions.remove(!removeIndex)

  !this.chooseConditions = ''
  do !i index !questions
    !this.chooseConditions =!this.chooseConditions & !questions[!i] & ' ' & !answers[!i] & ' '
  enddo

  !!ce = !saveCe
  handle any
  endhandle

  return true
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      isValidConditionForTube
-- Description: check condition for tube
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      connection type
-- Return:
--   [Data Type] [Description]
--    1    R     STRING      return to evaluated ckey
--
------------------------------------------------------------------------
define method .isValidConditionForTube(!connectionType is STRING) is STRING
  !result = ''

  do !key values !this.validKeys
    -- check arrive connection
    if (!connectionType.occurs(!key) gt 0) then
      !result = !key
      break
    endif
  enddo

  return !result
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      isValidVolume
-- Description: check whether element has valid volume or not
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element
-- Return:
--   [Data Type] [Description]
--    1    R     BOOLEAN     return to check result
--
------------------------------------------------------------------------
define method .isValidVolume(!element is DBREF) is BOOLEAN
  -- check volume
  !volume = object VOLUME(!element)
  handle any
    return false
  endhandle

  if (!volume.unset()) then
    return false
  endif

  !result = !volume.from.eq(!volume.to).not()

  return !result
endmethod

------------------------------------------------------------------------
--
-- Method:      validateEntryForWeld
-- Description: check whether entry is valid for weld or not
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF      element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateEntryForWeld(!entry is DBREF)
  !branchRef = !entry.owner
  !members   = !branchRef.members
  if (!entry.hardType eq 'BRAN') then
    return
  else
    !isValidDistance = !entry.aPos.distance(!entry.lPos) gt 0
    if (!entry.hardType inset ('TEE','OLET') and !isValidDistance.not()) then
      !prevComponent = object DBREF()
      !nextComponent = object DBREF()

      !isValidPrevDist = true
      !isValidNextDist = true

      !prevComponent = !members[!entry.sequ - 1]
      handle any
      endhandle

      !nextComponent = !members[!entry.sequ + 1]
      handle any
      endhandle

      if (!prevComponent.badRef().not() and !prevComponent.hardType eq 'WELD') then
        !isValidPrevDist = !prevComponent.aPos.distance(!entry.pos).nint() gt 0 and $
        !prevComponent.lPos.distance(!entry.pos).nint() gt 0
      endif

      if (!nextComponent.badRef().not() and !nextComponent.hardType eq 'WELD') then
        !isValidNextDist = !nextComponent.aPos.distance(!entry.pos).nint() gt 0 and $
        !nextComponent.lPos.distance(!entry.pos).nint() gt 0
      endif

      !isValidDistance = !isValidPrevDist and !isValidNextDist
    else
      !isValidDistance = !entry.aPos.distance(!entry.lPos) gt 0
    endif
  endif

  if (!entry.type ne 'PTAP' and !isValidDistance) then
    if (!entry.sequ eq 1) then
      if (!entry.owner.tGeom and !isValidDistance) then
        -- bran
        --   tube
        --   flan
        --!connectionKey = !this.isValidConditionForTube(!entry.aCon)
        !connectionKey = !this.evaluateCkey('TUB', !entry.aCon)

        if (!this.debugMode) then
          !debugString = '[ Case 1: entry sequ 1 and bran has tube : connection key : $!connectionKey ]'
          write '$!debugString'
        endif

        if (!connectionKey.empty().not()) then
          !this.inputWeldData(!entry, true, false, !connectionKey eq 'SW', '' ,!entry.hardType eq 'FLAN' and !entry.sKey eq 'FLSO', false)
        endif
      endif

      if (!entry.tGeom) then
        -- bran
        --   flan
        --   tube
        --!connectionKey = !this.isValidConditionForTube(!entry.lCon)
        !connectionKey = !this.evaluateCkey(!entry.lCon, 'TUB')

        if (!this.debugMode) then
          !debugString = '[ case 2: entry sequ 1 and element has tube : connection key : $!connectionKey ]'
          write '$!debugString'
        endif

        if (!connectionKey.empty().not()) then
          !this.inputWeldData(!entry, false, false, !connectionKey eq 'SW', '' ,!entry.hardType eq 'FLAN' and !entry.sKey eq 'FLSO', false)
        endif
      else
        -- bran
        --   flan
        --   redu
        if (!entry.sequ lt !branchRef.mCount) then
          !nextEntry = !members[!entry.sequ + 1]

          --skip if (!this.isValidVolume(!nextEntry).not())
          if (!this.isValidVolume(!nextEntry) and !this.weldGapTypeForFittings ne 'NOT') then
            !isInvalidCondition = !nextEntry.hardType inset ('WELD','GASK')

            if (!isInvalidCondition.not()) then
              !connectionKey = !this.evaluateCkey(!entry.lCon, !nextEntry.aCon)
              if (!connectionKey.empty().not()) then
                !this.inputWeldData(!entry, false, false, !connectionKey eq 'SW', '' ,!entry.hardType eq 'FLAN' and !entry.sKey eq 'FLSO', true)
              endif
            endif
          endif
        endif
      endif
    else
      !prevComp = !members[!entry.sequ - 1]
      if ((!prevComp.tGeom and !prevComp.hardType ne 'GASK') or !prevComp.hardType eq 'ATTA')  then
        if (!prevComp.hardType inset ('WELD','ATTA')) then
          !checkConnectionFlag = true
        else
          !checkConnectionFlag = !this.isValidVolume(!prevComp)
        endif

        if (!checkConnectionFlag) then
          !connectionKey = !this.evaluateCkey('TUB', !entry.aCon)
          --will not create any weld on set on tee on mainline if it is the previous component
          if (!connectionKey.empty().not() and !entry.sKey.neq('TESO')) then
            !this.inputWeldData(!entry, true, false, !connectionKey eq 'SW', '' ,!entry.hardType eq 'FLAN' and !entry.sKey eq 'FLSO', false)
          endif
        endif
      endif
      --will not create any weld if it is set on tee
      if (!entry.tGeom and !entry.sKey.neq('TESO')) then
        !connectionKey = !this.evaluateCkey(!entry.lCon, 'TUB')
        if (!connectionKey.empty().not()) then
          --            if (!prevComp.hardType eq 'GASK' and !prevComp.tGeom and !entry.sequ eq 2) then
          --              !this.inputWeldData(!entry, true, false, !connectionKey eq 'SW', '' ,!entry.hardType eq 'FLAN' and !entry.sKey eq 'FLSO', false)
          --            else
          !this.inputWeldData(!entry, false, false, !connectionKey eq 'SW', '' ,!entry.hardType eq 'FLAN' and !entry.sKey eq 'FLSO', false)
          --endif
        endif
      else
        if (!entry.sequ lt !branchRef.mCount) then
          !nextComp = !members[!entry.sequ + 1]
          if (!this.isValidVolume(!nextComp) and!nextComp.hardType ne 'GASK' and !nextComp.hardType ne 'WELD' and !this.weldGapTypeForFittings ne 'NOT') then
            !connectionKey = !this.evaluateCkey(!entry.lCon, !nextComp.aCon)
            if (!connectionKey.empty().not() and !entry.sKey.neq('TESO')) then
              !this.inputWeldData(!entry, false, false, !connectionKey eq 'SW', '' ,!entry.hardType eq 'FLAN' and !entry.sKey eq 'FLSO', true)
            endif
          endif
        endif
      endif
    endif
  endif

  if (!entry.hardType inset ('TEE','OLET') and !entry.cRef.badRef().not() and !entry.cEnd.empty().not()) then
    var !p3Con p3 con of $!entry
    !isValidDistance = !entry.pPos[1].distance(!entry.pPos[2]) geq 0 or !entry.pos.distance(!entry.pPos[3]) geq 0

    !tempMember = object DBREF()
    if (!entry.cEnd eq 'HEAD') then
      !tempMember = !entry.cRef.members.first()
      handle any
      endhandle
    else
      !tempMember = !entry.cRef.members.last()
      handle any
      endhandle
    endif

    if (!tempMember.badRef().not() and !tempMember.hardType eq 'WELD') then
      !isValidDistance = !entry.pPos[3].distance(!tempMember.aPos).nint() gt 0 and $
      !entry.pPos[3].distance(!tempMember.lPos).nint() gt 0
    endif
    if (!isValidDistance) then
      if (!entry.cRef.tGeom) then
        if (!entry.mCount eq 0) then
          !connectionKey = !this.evaluateCkey(!p3Con, 'TUB')

          --If the TEE is a set-on-tee we want to add weld only on the p3 side
          if(!entry.fitLen.geq(0)) then
            if (!connectionKey.empty().not()) then
              if (!entry.cEnd eq 'HEAD') then
                !this.inputWeldData(!entry.cRef, true, false, !connectionKey eq 'SW', '' ,false, false)
              else
                !this.inputWeldData(!entry.cRef, false, false, !connectionKey eq 'SW', '' ,false, false)
              endif
            endif
          endif
        elseif (!entry.type eq 'PTAP') then
          !connectionKey = !this.evaluateCkey(!p3Con, 'TUB')
          if (!connectionKey.empty().not()) then
            if (!entry.cEnd eq 'HEAD') then
              !this.inputWeldData(!entry.cRef, true, false, !connectionKey eq 'SW', '' ,false, false)
            else
              !this.inputWeldData(!entry.cRef, false, false, !connectionKey eq 'SW', '' ,false, false)
            endif
          endif
        endif
      else
        !weldExist  = false
        if (!entry.sequ lt !branchRef.mCount) then
          !nextComp = !members[!entry.sequ + 1]
          !weldExist = !nextComp.type.eq('WELD')
        endif
        if (!entry.type eq 'TEE' and !entry.tExist and !weldExist.neq(TRUE)) then
          !connectionKey = !this.evaluateCkey(!p3Con, 'TUB')
          if (!connectionKey.empty().not()) then
            if (!entry.cEnd eq 'HEAD') then
              !this.inputWeldData(!entry.cRef, true, false, !connectionKey eq 'SW', '' ,false, false)
            else
              !this.inputWeldData(!entry.cRef, false, false, !connectionKey eq 'SW', '' ,false, false)
            endif
          endif
        endif
        if (!entry.cEnd eq 'HEAD') then
          !firstMember = !entry.cRef.members.first()
        else
          !firstMember = !entry.cRef.members.last()
        endif

        if (!this.isValidVolume(!firstMember) and !firstMember.hardType ne 'WELD' and !firstMember.hardType ne 'GASK') then
          !connectionKey = !this.evaluateCkey(!p3Con, !firstMember.aCon)

          if (!connectionKey.empty().not() and !this.weldGapTypeForFittings ne 'NOT') then
            if (!entry.cEnd eq 'HEAD') then
              !this.inputWeldData(!firstMember, true, false, !connectionKey eq 'SW', '' ,!firstMember.hardType eq 'FLAN' and !firstMember.sKey eq 'FLSO', true)
            else
              !this.inputWeldData(!firstMember, false, false, !connectionKey eq 'SW', '' ,!firstMember.hardType eq 'FLAN' and !firstMember.sKey eq 'FLSO', true)
            endif
          endif
        endif
      endif
    endif
  endif

  !nsbcElements = !!collectAllFor('PIPCA','', !entry)
  if (!nsbcElements.set()) then
    do !nElement values !nsbcElements
      skip if (!nElement.cRef.badRef() or !nElement.cEnd.empty())

      if (!nElement.cEnd eq 'HEAD') then
        !this.inputWeldData(!nElement.cRef, true, false, false, '' ,false, false)
      else
        !this.inputWeldData(!nElement.cRef, false, false, false, '' ,false, false)
      endif
    enddo
  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      evaluateSourceData
-- Description: evaluate source data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .evaluateSourceData(!element is DBREF)
  !this.sourceData.clear()
  !this.sourceList.clear()
  --  !this.weldRefList.clear()

  !branchList = !!collectAllFor('BRAN','', !element)
  if (!branchList.unset()) then
    return
  endif

  !this.cocoTable.changeCe(world)

  do !branchRef values !branchList
    !members = !branchRef.members
    !count   = !branchRef.mCount

    do !i index !members
      !entry = !members[!i]

      -- check volume
      skip if (!this.isValidVolume(!entry).not())
      skip if (!entry.hardType inset ('BEND','GASK','WELD','ATTA'))
      !this.validateEntryForWeld(!entry)
    enddo
  enddo
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateSourceDataUsingComponents
-- Description: evaluate source data using components
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       source elements
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .evaluateSourceDataUsingComponents(!sourceElements is ARRAY)
  !this.sourceData.clear()
  !this.sourceList.clear()

  !this.cocoTable.changeCe(world)
  do !entry values !sourceElements
    !branchRef = bran of $!entry

    skip if (!this.isValidVolume(!entry).not())
    skip if (!entry.hardType inset ('BEND','GASK','WELD'))

    --Check to see if we have a weld neck flange, if so we need a fitting to fitting weld
    if(!entry.hardType eq 'FLAN' and !entry.skey eq 'FLWN') then
      !this.validateEntryForFittingToFittingWeld(!entry)
    else
      !this.validateEntryForWeld(!entry)
    endif
  enddo
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      inputWeldData
-- Description: input weld data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element ref
--    2    R     BOOLEAN     is arrive
--    3    R     BOOLEAN     is tee connection
--    4    R     BOOLEAN     is socket weld
--    5    R     STRING      connection end
--    6    R     BOOLEAN     is slip-on flange
--    7    R     BOOLEAN     is fitting to fitting connection
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .inputWeldData(!elementRef is DBREF, !isArrive is BOOLEAN, !isTeeConnection is BOOLEAN, !isSocketWeld is BOOLEAN, $
  !connectionEnd is STRING, !isSlipOnFlange is BOOLEAN, !isFittingToFittingConnection is BOOLEAN)

  if (!elementRef.hardType eq 'OLET') then
    if (!this.refTeeList.findFirst(!elementRef).set()) then
      return
    else
      !this.refTeeList.append(!elementRef)
    endif
  elseif (!elementRef.hardType eq 'TEE') then
    -- check set-on tee
    !isSetOnTee = false
    if (!elementRef.aPos.distance(!elementRef.lPos) lt 0.5)  then
      !isSetOnTee = true
    endif
    if (!isSetOnTee) then
      if (!this.refTeeList.findFirst(!elementRef).set()) then
        return
      else
        !this.refTeeList.append(!elementRef)
      endif
    endif
  endif
  !checkKey = !elementRef.ref.string() & '-' & !isArrive.string()
  if (!this.sourceList.findFirst(!checkKey).set()) then
    return
  else
    !this.sourceList.append(!checkKey)
  endif

  !weldData = object PFWELDDATA()
  !weldData.sourceElement   = !elementRef
  !weldData.isArrive        = !isArrive
  !weldData.isTeeConnection = !isTeeConnection
  !weldData.isSocketWeld    = !isSocketWeld
  !weldData.connectionEnd   = !connectionEnd
  !weldData.isSlipOnFlange  = !isSlipOnFlange
  !weldData.isFittingToFitting = !isFittingToFittingConnection

  if (!isSlipOnFlange and !this.singleWeldForSlipOn.not()) then
    if (!isArrive) then
      !moveDir = !elementRef.aDir.wrt(world)
    else
      !moveDir = !elementRef.lDir.wrt(world)
    endif

    !localVolume = object LOCALVOLUME(!elementRef, !elementRef)
    !box = !localVolume.box()
    !size = object ARRAY()
    !size.append(!box.xLength)
    !size.append(!box.yLength)
    !size.append(!box.zLength)
    !size.sort()

    !weldData.newPosition = !elementRef.pos.offset(!moveDir, !size[1])
    !this.sourceData.append(!weldData)
  endif

  !weldData.newPosition = object POSITION()
  !this.sourceData.append(!weldData)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      isValidElementForWeld
-- Description: is valid element for weld
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element
-- Return:
--   [Data Type] [Description]
--    BOOLEAN
--
------------------------------------------------------------------------
define method .isValidElementForWeld(!element is DBREF) is BOOLEAN
  !result = false

  if (!element.hardType eq 'WELD') then
    return !result
  endif

  !branchRef = bran of $!<element>
  !members   = !branchRef.members

  !isTeeTypeElement = !element.hardType inset ('TEE','OLET')

  !firstResult  = false
  !secondResult = false
  if (!element.sequ eq 1 or !element.hardType eq 'BRAN') then
    if (!element.tGeom) then
      !firstResult  = !element.tGeom
    else
      if (!element.sequ eq 1 and !branchRef.tGeom) then
        !firstResult = true
      elseif (!element.sequ lt !branchRef.mCount) then
        !nextComp = !members[!element.sequ + 1]
        !firstResult = !this.evaluateCkey(!element.lCon, !nextComp.aCon).empty().not()
      endif
    endif

    !secondResult = !element.tGeom

    !result = !firstResult or !secondResult
  elseif (!element.sequ ne !branchRef.mCount) then
    if (!element.sequ gt 1) then
      !prevComp = !members[!element.sequ - 1]
      if (!prevComp.tGeom) then
        !firstResult = true
      else
        !firstResult = !this.evaluateCkey(!prevComp.lCon, !element.aCon).empty().not()
      endif

      if (!element.tGeom) then
        !secondResult = true
      else
        !nextComp = !members[!element.sequ + 1]
        !secondResult = !this.evaluateCkey(!element.lCon, !nextComp.aCon).empty().not()
      endif

      !result = !firstResult or !secondResult
    else
      !firstResult = !element.tGeom

      if (!element.tGeom.not()) then
        !nextComp = !members[!element.sequ + 1]
        !secondResult = !this.evaluateCkey(!element.lCon, !nextComp.aCon).empty().not()
      endif

      !result = !firstResult or !secondResult
    endif
  else
    !prevComp = !members[!element.sequ - 1]
    if (!prevComp.tGeom) then
      !firstResult = true
    else
      !firstResult = !this.evaluateCkey(!prevComp.lCon, !element.aCon).empty().not()
    endif

    if (!element.tGeom) then
      !secondResult = true
    else
      !secondResult = !this.evaluateCkey(!prevComp.lCon, !element.aCon).empty().not()
    endif

    !result = !firstResult or !secondResult
  endif

  if (!element.hardType inset ('TEE','OLET') and !element.cRef.badRef().not()) then
    var !p3Con p3 con of $!element

    !branchResult = !this.isValidConditionForTube(!p3Con).empty().not()

    !result = !firstResult or !secondResult or !branchResult
  endif
  return !result
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getPositionForWeld
-- Description: get position for weld
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element
-- Return:
--   [Data Type] [Description]
--    ARRAY
--
------------------------------------------------------------------------
define method .getPositionForWeld(!element is DBREF) is ARRAY
  !isTeeTypeElement = !element.hardType inset ('TEE','OLET')

  !arriveWeld   = false
  !leaveWeld    = false
  !connectWeld  = false

  do !key values !this.validKeys
    if (!element.aConn.occurs(!key) gt 0 and !arriveWeld.not()) then
      !arriveWeld = true
    endif

    if (!element.lConn.occurs(!key) gt 0 and !leaveWeld.not()) then
      !leaveWeld = true
    endif

    skip if (!isTeeTypeElement.not())

    var !p3Con p3 con of $!element
    if (!p3Con.occurs(!key) gt 0 and !connectWeld.not() and !element.cEnd.set()) then
      !connectWeld = true
    endif
  enddo

  !result = object ARRAY()
  !result.append(!arriveWeld)
  !result.append(!leaveWeld)
  !result.append(!connectWeld)

  return !result
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkExistWeldOnComponent
-- Description: check exist weld on component
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element
-- Return:
--   [Data Type] [Description]
--    BOOLEAN
--
------------------------------------------------------------------------
define method .checkExistWeldOnComponent(!element is DBREF) is BOOLEAN
  !branchRef = bran of $!<element>
  !members = !branchRef.members

  !isTeeTypeElement = !element.hardType inset ('TEE','OLET')

  !prevComp = !members[!element.sequ - 1]
  handle any
    return false
  endhandle

  !nextComp = !members[!element.sequ + 1]
  handle any
    return false
  endhandle

  if (!isTeeTypeElement) then
    if (!element.cRef.badRef().not()) then
      if (!element.cEnd eq 'HEAD') then
        !connComp = !element.cRef.members[1]
        handle any
          return false
        endhandle
      elseif (!element.cEnd eq 'TAIL') then
        !connComp = !element.cRef.members[!element.cRef.mCount]
        handle any
          return false
        endhandle
      endif
    endif
    !result = !prevComp.tGeom.not() and !prevComp.hardType eq 'WELD' and !nextComp.hardType eq 'WELD' and !element.tGeom.not() and !connComp.hardType eq 'WELD'
  else
    !result = !prevComp.tGeom.not() and !prevComp.hardType eq 'WELD' and !nextComp.hardType eq 'WELD' and !element.tGeom.not()
  endif

  return !result
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getWeldGapFromConfigTable
-- Description: get weld gap from config table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element
-- Return:
--   [Data Type] [Description]
--    REAL
--
------------------------------------------------------------------------
define method .getWeldGapFromConfigTable(!element is DBREF) is REAL
  if (!this.zeroGap) then
    return 0
  endif

  -- find suitable piping spec from weld gap config. table
  !pipeRef = pipe of $!element

  !pipeSpec = !pipeRef.pSpec
  if (!pipeSpec.badRef()) then
    if (!pipeRef.mCount eq 1) then
      !pipeSpec = !pipeRef.members[1].pSpec
      if (!pipeSpec.badRef()) then
        !this.inputErrorList(!element.flnm, 'Failed to get pipe spec from ' & !element.flnm)
        return -1
      endif
    endif

    !this.inputErrorList(!element.flnm, 'Failed to get pipe spec from ' & !element.flnm)
    return -1
  endif

  !specIndex = !this.pipingSpecNames.findFirst(!pipeSpec.name)
  if (!specIndex.unset()) then
    !this.inputErrorList(!element.flnm, 'Failed to get suitable pipe spec using ' & !pipeSpec)
    return -1
  endif

  !selectedSpec = !this.configSpecMembers[!specIndex]
  !specMembers  = !selectedSpec.members

  -- find suitable bore
  !boreList  = !specMembers.evaluate(object BLOCK(|!specMembers[!evalIndex].number.string()|))

  !boreSize = -1
  if (!element.hardType eq 'BRAN') then
    if (!element.mCount gt 0) then
      !boreSize = !element.members[1].aBore.real().value()
      handle any
      endhandle
    else
      !boreSize = !element.hBore.real().value()
      handle any
      endhandle
    endif
  else
    !boreSize  = !element.aBore.real().value()
    handle any
    endhandle
  endif

  !boreIndex = !boreList.findFirst(!boreSize.string())
  if (!boreIndex.unset()) then
    --    !!alert.error('Failed to get suitable bore using ' & !element.aBore.value())
    return -1
  endif

  !selectedBoreData = !specMembers[!boreIndex]

  !weldGap = !selectedBoreData.members[1].ddprop.after(|( '|).before(|' )|).real()
  handle any
    !weldGap = -1
  endhandle

  return !weldGap
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      inputErrorList
-- Description: input error list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING       element name
--    2    R     STRING       error description
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .inputErrorList(!elementName is STRING, !errorDescription is STRING)
  !table = object ARRAY()
  !table.append(!elementName)
  !table.append(!errorDescription)

  !this.errorList.append(!table)
endmethod

------------------------------------------------------------------------
--
-- Method:      evaluateWallThickness
-- Description: evaluate wall thickness
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING       element reference
-- Return:
--   [Data Type] [Description]
--    1    R     STRING       return to wall thickness
--
------------------------------------------------------------------------
define method .evaluateWallThickness(!weldRef is DBREF) is STRING
  !wallThickness = '---'

  !wallThickness = !weldRef.ltWall.string(!!distanceFMT)
  handle any
    if (!weldRef.sequ eq 1) then
      if (!weldRef.owner.tGeom) then
        !wallThickness = !weldRef.owner.hWallt.string(!!distanceFMT)
        handle any
        endhandle
      else
        if (!weldRef.owner.hRef.badRef().not()) then
          !connectionRef = !weldRef.owner.hRef
          !thickness = pWallt 3 of $!connectionRef
          handle any
          elsehandle none
            !wallThickness = !thickness.string(!!distanceFMT)
          endhandle
        endif
      endif
    else
      if (!weldRef.mCount le !weldRef.owner.mCount) then
        !prevEntry = !weldRef.owner.members[!weldRef.seq - 1]
        !wallThickness = !prevEntry.lWallt.string(!!distanceFMT)
        handle any
          !nextEntry = !weldRef.owner.members[!weldRef.sequ + 1]
          handle any
          elsehandle none
            !wallThickness = !nextEntry.aWallt.string(!!distanceFMT)
            handle any
            endhandle
          endhandle
        endhandle
      endif
    endif
  endhandle

  return !wallThickness
endmethod

------------------------------------------------------------------------
--
-- Method:      evaluateMaterial
-- Description: evaluate wall thickness
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING       element reference
-- Return:
--   [Data Type] [Description]
--    1    R     STRING       return to wall thickness
--
------------------------------------------------------------------------
define method .evaluateMaterial(!weldRef is DBREF) is STRING
  !result  = '---'
  !tubeRef = !weldRef.lstu

  if (!tubeRef.badRef()) then
    if (!weldRef.sequ eq 1) then
      if (!weldRef.owner.tGeom) then
        !tubeRef = !weldRef.owner.hstu
      endif
    else
      if (!weldRef.mCount le !weldRef.owner.mCount) then
        !prevEntry = !weldRef.owner.members[!weldRef.seq - 1]
        !tubeRef   = !prevEntry.lstu
      endif
    endif
  endif

  if (!tubeRef.badRef().not()) then
    !result = !tubeRef.mtxxtext
  endif

  return !result
endmethod

------------------------------------------------------------------------
--
-- Method:      validateEntryForFittingToFittingWeld
-- Description: validateEntryForFittingToFittingWeld
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element ref
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .validateEntryForFittingToFittingWeld(!entry is DBREF)
  --Check that the flange is not at the start/end of a branch
  if (!entry.sequ.lt(!entry.owner.mCount).and(!entry.sequ.gt(1))) then
    -- Check to see if the next/previous component is a gasket as this will tell us where to position the weld
    !members = !entry.owner.members
    !nextComp = !members[!entry.sequ + 1]
    !prevComp = !members[!entry.sequ - 1]
    if(!nextComp.hardType eq 'GASK') then
      if (!this.weldGapTypeForFittings ne 'NOT') then
        !connectionKey = !this.evaluateCkey(!entry.acon, !prevComp.lcon)
        if(!connectionKey.empty().not()) then
          --Position the fitting to fitting weld at the arrive of the entry
          !this.inputWeldData(!entry, true, false, !connectionKey eq 'SW', '' ,!entry.hardType eq 'FLAN' and !entry.sKey eq 'FLSO', true)
        endif
      endif
    elseif(!prevComp.hardType eq 'GASK') then
      if (!this.weldGapTypeForFittings ne 'NOT') then
        !connectionKey = !this.evaluateCkey(!entry.lcon, !nextComp.acon)
        if(!connectionKey.empty().not()) then
          --Position the fitting to fitting weld at the leave of the entry
          !this.inputWeldData(!entry, false, false, !connectionKey eq 'SW', '' ,!entry.hardType eq 'FLAN' and !entry.sKey eq 'FLSO', true)
        endif
      endif
    else
      !this.validateEntryForWeld(!entry)
    endif
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkDBWritable
-- Description: checkDBWritable
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     PFWELDDATA       Weld data
-- Return:
--   [Data Type] [Description]
--      BOOLEAN     Result
------------------------------------------------------------------------
define method .checkDBWritable (!weldData is PFWELDDATA) is BOOLEAN
  !result = true
  if(!weldData.sourceElement.type neq 'BRANCH') then
    if (!this.checkDbWriteObject.checkDbWrite(!weldData.sourceElement.owner).not()) then
      !this.inputErrorList(!weldData.sourceElement.flnm, !this.checkDbWriteObject.errorMessage)
      !result = false
    endif
  else
    if (!this.checkDbWriteObject.checkDbWrite(!weldData.sourceElement).not()) then
      !this.inputErrorList(!weldData.sourceElement.flnm, !this.checkDbWriteObject.errorMessage)
      !result = false
    endif
  endif
  return !result
endmethod
-- End of method
