-- Define object
define object PFWELDDATA
  member .sourceElement         is DBREF
  member .isTeeConnection       is BOOLEAN
  member .isArrive              is BOOLEAN
  member .isSocketWeld          is BOOLEAN
  member .connectionEnd         is STRING
  member .isSlipOnFlange        is BOOLEAN
  -- this member will be used to move weld for slip on flange
  member .newPosition           is POSITION
  member .relatedElement        is DBREF
  member .isFittingToFitting    is BOOLEAN
  member .createdWeldRef        is DBREF
endobject
-- End of object definition
