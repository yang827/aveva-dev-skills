--   Type:          Object Definition
--   Group:         Pipe Fabrication
--     Keyword:     PF
--   Module:        Design
--   Replaces:
--
-- Author:          HyunJong ROH (Nick)
--                  DoHyoung Kim (Bright)
-- Created:         Tuesday 6th December 2011
--
-- Description:     result object for weld gap check
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  display()                        -                   display check result in the 3D view
--  fix(STRING)                      BOOLEAN             fix the problem
--  getMessage()                     STRING              return detailed result message
--  getResultLevel()                 REAL                return error level
--  getSolutionMethods()             ARRAY               return solution methods to fix the problem
--  zoom(ARRAY)                      -                   zoom the given elements
--
--------------------------------------------------------------------------------
define object PFWELDGAPCHECKRESULT

  member  .flangeComponent  is DBREF

  member  .branchComponent  is DBREF

  member  .distance         is REAL

  member  .minimum          is REAL

  -- 1 : branch, head
  -- 2 : branch, tail
  -- 3 : main, arrive
  -- 4 : main, leave
  member  .type             is REAL

  member  .nearPosition     is POSITION

  member  .surfacePosition  is POSITION

  member  .flangePosition   is POSITION

  member  .missingBoreSize  is REAL

  member  .missingBore      is BOOLEAN
  member  .missingBoreMessage is STRING

endobject


--------------------------------------------------------------------------------
--
-- Method:      display
--
-- Description: display check result in 3D view
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .display()
  if (!this.missingBore.set()) then
    if !this.missingBore then
      return
    endif
  endif

  ENHANCE $!this.flangeComponent COLOUR $!!gphColOpt.highlight
  ENHANCE $!this.branchComponent COLOUR $!!gphColOpt.highlight

  if !this.distance.leq(0) then
    !components = object ARRAY()
    !components.append(!this.flangeComponent)
    !components.append(!this.branchComponent)
    !this.zoom(!components)
    return
  endif

  if !this.type.eq(1) then
    -- branch, head
    !memberRefs = !!collectAllFor('BRAN MEM', '', !this.flangeComponent.owner)
    do !memberRef values !memberRefs
      ENHANCE $!memberRef COLOUR $!!gphColOpt.highlight
      if !memberRef.eq(!this.flangeComponent) then
        break
      endif
    enddo

  elseif !this.type.eq(2) then
    -- branch, tail
    !memberRefs = !!collectAllFor('BRAN MEM', '', !this.flangeComponent.owner)
    !index = !memberRefs.findFirst(!this.flangeComponent)
    if !index.set() then
      do !i from !index to !memberRefs.size()
        !memberRef = !memberRefs[!i]
        ENHANCE $!memberRef COLOUR $!!gphColOpt.highlight
      enddo
    endif

  elseif !this.type.eq(3) then
    -- main, arrive
    !memberRefs = !!collectAllFor('BRAN MEM', '', !this.flangeComponent.owner)
    !index = !memberRefs.findFirst(!this.flangeComponent)
    if !index.set() then
      do !i from !index to !memberRefs.size()
        !memberRef = !memberRefs[!i]
        ENHANCE $!memberRef COLOUR $!!gphColOpt.highlight
        if !memberRef.eq(!this.branchComponent) then
          break
        endif
      enddo
    endif
  elseif !this.type.eq(4) then
    -- main, leave
    !memberRefs = !!collectAllFor('BRAN MEM', '', !this.flangeComponent.owner)
    !index = !memberRefs.findFirst(!this.branchComponent)
    if !index.set() then
      do !i from !index to !memberRefs.size()
        !memberRef = !memberRefs[!i]
        ENHANCE $!memberRef COLOUR $!!gphColOpt.highlight
        if !memberRef.eq(!this.flangeComponent) then
          break
        endif
      enddo
    endif
  endif

  -- draw dimension with AID

  if !this.type.eq(1) or !this.type.eq(2) then
    --!projDirection = !this.branchComponent.pdir[1]

    !pointVector = object POINTVECTOR(!this.surfacePosition, !this.surfacePosition.direction(!this.nearPosition))
    !plane = !pointVector.plane()
    !projDirection = !this.flangePosition.direction(!this.nearPosition).projected(!plane)

    !leaderLength = !this.branchComponent.pod[3]
  else
    !projDirection = !this.flangePosition.direction(!this.nearPosition)

    if !this.type.eq(3) then
      !leaderLength = !this.branchComponent.aod
    else
      !leaderLength = !this.branchComponent.lod
    endif
  endif

  !pointVector = object POINTVECTOR(!this.flangeComponent.pos, !this.flangeComponent.adir)
  !line = !pointVector.line(1000mm)
  !nearestPosition = !line.near(!this.nearPosition)
  if !projDirection.dot(!nearestPosition.direction(!this.nearPosition)).lt(0) then
    !projDirection = !projDirection.opposite()
  endif

  -- draw leader lines
  !position1 = !this.nearPosition
  !position2 = !this.nearPosition.offset(!projDirection, !leaderLength + 30mm)
  AID LINE $!position1 TO $!position2 LINES SOLID

  !position3 = !this.surfacePosition
  !position4 = !this.surfacePosition.offset(!projDirection, !leaderLength + 30mm)
  AID LINE $!position3 TO $!position4 LINES SOLID

  -- draw dimension line
  !position5 = !this.nearPosition.offset(!projDirection, !leaderLength)
  !position6 = !this.surfacePosition.offset(!projDirection, !leaderLength)
  AID LINE $!position5 TO $!position6 LINES SOLID

  -- draw arrows
  !arrowDirection1 = !position6.direction(!position5)
  !position7 = !position5.offset(!arrowDirection1, -30mm)
  AID ARROW AT $!position7 DIR $!arrowDirection1 HEI 30mm PROP 1

  !arrowDirection2 = !position5.direction(!position6)
  !position8 = !position6.offset(!arrowDirection2, -30mm)
  AID ARROW AT $!position8 DIR $!arrowDirection2 HEI 30mm PROP 1

  -- draw dimension text
  !infoString = !this.distance.string(!!distanceFmt) + ' (Minimum ' + !this.minimum.string(!!distanceFmt) + ')'
  !textPosition = !position5.midPoint(!position6).offset(!projDirection, 50mm)
  AID TEXT '$!infoString' AT $!textPosition

  -- zoom
  !components = object ARRAY()
  !components.append(!this.flangeComponent)
  !components.append(!this.branchComponent)
  !this.zoom(!components)
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getMessage
--
-- Description: return detail check result string
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    STRING      detail check result string
--------------------------------------------------------------------------------
define method .getMessage() is STRING
  if (!this.missingBore.set()) then
    if !this.missingBore then
      return !this.missingBoreMessage
    endif
  endif

  if !this.distance.lt(0) then
    return 'Not enough distance to flange (minimum : ' + !this.minimum.string(!!distanceFmt) +')'
  else
    return 'Not enough distance to flange ' + !this.distance.string(!!distanceFmt) + ' (minimum : ' + !this.minimum.string(!!distanceFmt) +')'
  endif
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getResultLevel
--
-- Description: return error level
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    REAL        error level
--                1 : information, 2 : warning, 3 : error
--------------------------------------------------------------------------------
define method .getResultLevel() is REAL
  return 3
endmethod

--------------------------------------------------------------------------------
--
-- Method:      getSolutionMethods()
--
-- Description: return solution methods to fix the problem
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    ARRAY     array of solution methods
--------------------------------------------------------------------------------
define method .getSolutionMethods() is ARRAY
  return object ARRAY()
endmethod

--------------------------------------------------------------------------------
--
-- Method:      fix
--
-- Description: try to fix the problem
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      solution method
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     return true if the problem is fixed
--------------------------------------------------------------------------------
define method .fix(!dummyMethod is STRING) is BOOLEAN
  return false
endmethod

--------------------------------------------------------------------------------
--
-- Method:      zoom
--
-- Description: zoom the given element
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       elements to be zoomed
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .zoom(!components is ARRAY)

  !volume = object VOLUME(!components)

  !from = !volume.from
  !to   = !volume.to

  -- Through Point
  !throughPoint = !from.midPoint(!to)
  handle ANY
    return
  endhandle

  -- Set metric format
  !format           = object FORMAT()
  !format.units     = 'MM'
  !format.dp        = 0
  !format.dimension = 'L'

  -- Set through point
  !through[1] = !throughPoint.east.string(!format).real()
  !through[2] = !throughPoint.north.string(!format).real()
  !through[3] = !throughPoint.up.string(!format).real()
  !!fmSys.currentDocument().view.through = !through

  -- Set view radius
  !radius = !from.distance(!to).string(!format).real() / 2 * 1.25
  !radius = !radius.max(500mm)
  !!fmSys.currentDocument().view.radius  = !radius
endmethod
