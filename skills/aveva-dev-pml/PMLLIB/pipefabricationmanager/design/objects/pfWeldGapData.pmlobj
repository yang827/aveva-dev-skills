--
--  Description:
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  evaluateWeldContents()           ARRAY               evaluate weld contents
--  pfweldgapdata(STRING,ARRAY,ARRAY,ARRAY,ARRAY) -                   pfweldgapdata
--
------------------------------------------------------------------------
-- Define object
define object PFWELDGAPDATA
  member .boreSizeData      is ARRAY
  member .wallthicknessData is ARRAY
  member .weldGapData       is ARRAY
  member .weldGapRefData    is ARRAY
  member .specName          is STRING
endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      pfweldgapdata
-- Description: pfweldgapdata
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       bore size
--    2    R     ARRAY       wall thickness
--    3    R     ARRAY       weld gaps
--    4    R     ARRAY       weld gap entries
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pfweldgapdata(!specName is STRING, !boreSize is ARRAY, !wallThickness is ARRAY, !weldGaps is ARRAY, !weldGapEntries is ARRAY)
  !this.specName     = !specName
  !this.boreSizeData = !boreSize
  !this.wallthicknessData = !wallThickness
  !this.weldGapData = !weldGaps
  !this.weldGapRefData = !weldGapEntries
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateWeldContents
-- Description: evaluate weld contents
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    ARRAY
--
------------------------------------------------------------------------
define method .evaluateWeldContents() is ARRAY
  !result = object ARRAY()
  do !i index !this.boreSizeData
    !table = object ARRAY()
    !table.append(!this.boreSizeData[!i])
    !table.append(!this.wallthicknessData[!i])
    !table.append(!this.weldGapData[!i])

    !result.append(!table)
  enddo

  return !result
endmethod
-- End of method
