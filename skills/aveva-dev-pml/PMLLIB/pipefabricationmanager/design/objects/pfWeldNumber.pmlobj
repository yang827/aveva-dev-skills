------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  createWeldNumber(DBREF,BOOLEAN,BOOLEAN) -                   create weld number
--  evaluateWeldData(DBREF,BOOLEAN)  -                   evaluate weld data
--  pfweldnumber()                   -                   pfweldnumber
--  removeWeldNumber(DBREF)          -                   remove weld number
--
------------------------------------------------------------------------
-- Define object
define object pfweldnumber
  member .weldMember         is ARRAY
  member .updateMember       is ARRAY
  member .lastWeldNumber     is REAL
  member .checkDbWriteObject is COMCHECKDBWRITE
endobject
-- End of object definition

------------------------------------------------------------------------
--
-- Method:      pfweldnumber
-- Description: pfweldnumber
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pfweldnumber()
  !this.checkDbWriteObject.showAlert = true
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createWeldNumber
-- Description: create weld number
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       pipe ref
--    2    R     BOOLEAN     append mode
--    3    R     BOOLEAN     do changing name
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createWeldNumber(!pipeRef is DBREF, !appendMode is BOOLEAN, !doChangingName is BOOLEAN)
  if (!this.checkDbWriteObject.checkDbWrite(!pipeRef).not()) then
    return !result
  endif

  !this.evaluateWeldData(!pipeRef, !appendMode)

  !count = !this.lastWeldNumber
  !saveCe = !!ce

  do !weldRef values !this.updateMember
    !weldRef.wldNumber = $!<count>
    !count = !count + 1

    skip if (!doChangingName.not())
    !!ce = !weldRef
    unname
    call !!autoNameCe(false)
  enddo

  !!ce = !saveCe
  handle any
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      removeWeldNumber
-- Description: remove weld number
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       pipe ref
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeWeldNumber(!pipeRef is DBREF)
  if (!this.checkDbWriteObject.checkDbWrite(!pipeRef).not()) then
    return !result
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateWeldData
-- Description: evaluate weld data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       pipe ref
--    2    R     BOOLEAN     append mode
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .evaluateWeldData(!pipeRef is DBREF, !appendMode is BOOLEAN)
  !this.weldMember = !!collectAllFor('WELD', '', !pipeRef)
  if (!this.weldMember.unset()) then
    return
  endif

  !this.lastWeldNumber = 0
  !this.updateMember.clear()

  if (!appendMode) then
    !weldNumbers = !this.weldMember.evaluate(object BLOCK(|!this.weldMember[!evalIndex].wldNumber|))
    !sortedNumbers = !weldNumbers.sortUnique()

    !isValidNumber = true
    if (!sortedNumbers.size() eq 1 and !this.weldMember.size() gt 1) then
      !isValidNumber = false
      !errorCode     = 1
    elseif (!sortedNumbers.size() ne !this.weldMember.size()) then
      !isValidNumber = false
      !errorCode     = 2
    endif

    !this.updateMember.clear()
    do !entry values !this.weldMember
      skip if (!entry.wldNumber ne 0)
      !this.updateMember.append(!entry)
    enddo

    !this.lastWeldNumber = !sortedNumbers.last() + 1
  else
    !this.lastWeldNumber = 1
    !this.updateMember = !this.weldMember
  endif
endmethod
-- End of method


