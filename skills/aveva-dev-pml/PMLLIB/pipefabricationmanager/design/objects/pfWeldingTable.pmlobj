--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  pfWeldingTable()                 -                   constructor
--
--------------------------------------------------------------------------------
define object PFWELDINGTABLE

  member  .pipePiece          is DBREF

  member  .weldingMachine     is DBREF

  member  .arriveFlange       is DBREF

  member  .leaveFlange        is DBREF

  member  .arriveFlangeWelded is BOOLEAN

  member  .leaveFlangeWelded  is BOOLEAN

  member  .angle              is REAL

endobject

--------------------------------------------------------------------------------
--
-- Method:      pfWeldingTable
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfWeldingTable()
  !this.arriveFlangeWelded = false
  !this.leaveFlangeWelded = false
  !this.angle = 0degree
endmethod
