--  Description:    Bending element information
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  pfBendingElementInfo(DBREF)      -                   constructor
--
--------------------------------------------------------------------------------
define object PFBENDINGELEMENTINFO
  member .bendRef       is DBREF
  member .radius        is REAL
  member .insideLength  is REAL
  member .centreLength  is REAL
  member .outsideLength is REAL
endobject

--------------------------------------------------------------------------------
--
-- Method:      pfBendingElementInfo
--
-- Description: constructor
--
-- Method Type: Procedure
-- Arguments:
--   [#]  [R/RW] [Data Type] [Description]
--    1    R      DBREF      bend reference
--
-- Return:
--   [Data Type] [Description]
--
--------------------------------------------------------------------------------
define method .pfBendingElementInfo(!element is DBREF)
  !this.bendRef = !element
  !this.radius  = !element.rad

  !savedUnits = object COMUNITS(true)

  units mm bore

  !aDir    = !element.aDir
  !lDir    = !element.lDir
  !orthDir = !element.ori.zDir()
  !acDir   = !aDir.cross(!orthDir)
  !lcDir   = !lDir.cross(!orthDir)

  !outDia  = !element.aOd

  !arriveInnerPos = !element.aPos.offset(!acDir, !outDia * 0.5 * -1)
  !arriveOuterPos = !element.aPos.offset(!acDir, !outDia * 0.5)

  !leaveInnerPos  = !element.lPos.offset(!lcDir, !outDia * 0.5 * -1)
  !leaveOuterPos  = !element.lPos.offset(!lcDir, !outDia * 0.5)

  !arriveLine = object LINE(!arriveInnerPos, !arriveOuterPos)
  !leaveLine  = object LINE(!leaveInnerPos, !leaveOuterPos)
  !centrePos  = !arriveLine.intersection(!leaveLine)

  !innerDistance  = !centrePos.distance(!arriveInnerPos)
  !centreDistance = !centrePos.distance(!element.aPos)
  !outerDistance  = !centrePos.distance(!arriveOuterPos)

  !angle = !element.angle  / 360 deg

  !tempInsideLength = min(nint(2 * PI * !innerDistance   * !angle), nint(2 * PI * !outerDistance   * !angle))
  !tempCentreLength = nint(2 * PI * !centreDistance  * !angle)
  !tempOuterLength  = max(nint(2 * PI * !innerDistance   * !angle), nint(2 * PI * !outerDistance   * !angle))

  !this.insideLength  = !!comConvertUnknownValue(!tempInsideLength, !!distanceFMT.units)
  !this.centreLength  = !!comConvertUnknownValue(!tempCentreLength, !!distanceFMT.units)
  !this.outsideLength = !!comConvertUnknownValue(!tempOuterLength,  !!distanceFMT.units)

  !savedUnits.restoreSavedUnitsByPtype('DIST')
  !savedUnits.restoreSavedUnitsByPtype('BORE')
  !savedUnits.restoreSavedUnitsByPtype('ANGL')
endmethod
