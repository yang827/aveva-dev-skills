------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addSourceElements()              -                   add source elements
--  checkOptionFilePath()            BOOLEAN             check option file path
--  close()                          -                   close
--  constructDrawingStatus(ARRAY)    ARRAY               create a string describing the files available
--  createDrawings()                 -                   create drawings
--  errorListRightClick(ARRAY)       -                   error list right click
--  evaluateDrawingPath(DBREF)       ARRAY               evaluate drawing path
--  evaluateSourceList()             -                   evaluate source list
--  getPlotFiles(STRING,STRING,DBREF) ARRAY
--  initialise()                     -                   initialise
--  isValidFilePath(STRING,BOOLEAN)  BOOLEAN             is valid file path
--  loadLayout()                     -                   load layout
--  loadOptionFile()                 -                   load option file
--  navigateOnExplorer()             -                   navigate on explorer
--  pfIsoDrawings()                  -                   constructor
--  populateContents()               -                   populate contents
--  populateSourceList(ARRAY,BOOLEAN) -                   populate source list
--  popupMenus()                     -                   popup menus
--  removeSelectedItems()            -                   remove selected items
--  saveLayout()                     -                   save layout
--  saveOptionFile()                 -                   save option file
--  selectChangeOnSourceListGrid(ARRAY) -                   select change on source list grid
--  setHierarchyFlag()               -                   set hierarchy flag
--  setIsoOptionFile(BOOLEAN)        -                   set iso option file
--  setResultPltFilePath(BOOLEAN)    -                   set result plt file path
--  showFilter(BOOLEAN)              -                   show filter
--  showPreviewDrawing()             -                   show preview drawing
--  sourceListGridRightClick(ARRAY)  -                   source list grid right click
--
------------------------------------------------------------------------
import 'GridControl'
handle any
endhandle

import 'PMLFileBrowser'
handle any
endhandle

-- Define form
--- form definition
setup form !!pfIsoDrawings dialog dock
  !this.formTitle  = |Isometrics Drawing|
  !this.initcall   = |!this.initialise()|
  !this.quitcall   = |!this.close()|

  frame .mainFrame tabset anchor all
    frame .createDrawing 'Create Drawing'
      button .addCe 'Add CE'    callback |!this.addSourceElements()|
      para   .ceName  width 25

      button .createIsometrics anchor t+r 'Create Drawing'  width 10 callback |!this.createDrawings()|
      button .refreshList      anchor t+r 'Refresh'         width 10 callback |!this.populateContents()|
      path down

      container .sourceListControl PMLNetControl anchor all at x0 'sourceList'  width 60 height 15

      toggle .useHierarchy 'Use Hierarchy' anchor l+b callback |!this.setHierarchyFlag()|
      option .drawingTypeList   'Element Type' tagwidth 10 anchor b+r  at xmax form-size  ymin width 10
    exit

    frame .createOptions 'Drawing Options'
      frame .optionContents anchor l+r+t at x0
        frame .fabIsoOptionDefinition panel anchor l+r+t at y0
          -- iso option file path
          para   .fabIsoOptionFile         text 'ISO Option File Path'
          path down
          text   .fabIsoOptionFilePath     anchor l+r+t width 40 is STRING
          path right
          button .fabIsoOptionFileBrowser  anchor r+t pixmap width 16 height 16   callback |!this.setIsoOptionFile(TRUE)|
          path down

          -- result path which used to export the result picture file.
          para   .fabIsoResultFile         at x0 text 'Result File Path'
          text   .fabIsoResultFilePath     anchor l+r+t width 40 is STRING
          path right
          button .fabIsoResultFileBrowser  anchor r+t pixmap width 16 height 16   callback |!this.setResultPltFilePath(TRUE)|
          path down
        exit

        frame .instIsoOptionDefinition panel anchor l+r+t at y0
          para   .instIsoOptionFile        at x0 text 'ISO Option File Path'
          path down
          text   .instIsoOptionFilePath    anchor l+r+t width 40 is STRING
          path right
          button .instIsoOptionFileBrowser  anchor r+t pixmap width 16 height 16   callback |!this.setIsoOptionFile(FALSE)|
          path down

          -- result path which used to export the result picture file.
          para   .instIsoResultFile         at x0 text 'Result File Path'
          text   .instIsoResultFilePath     anchor l+r+t width 40 is STRING
          path right
          button .instIsoResultFileBrowser  anchor r+t pixmap width 16 height 16   callback |!this.setResultPltFilePath(FALSE)|
          path down
        exit
      exit

      button .saveOption 'Apply' callback |!this.saveOptionFile()|
      path right
      button .dismissOption 'Dismiss'  at xMax1 Cancel
    exit

    frame .errorList 'Error List'
      container .errorListControl      PMLNetControl anchor all at x0 'ErrorList'  width 60
    exit
  exit

  member .optionFile           is FILE
  member .layoutDefault        is FILE
  member .isFabricationDrawing is BOOLEAN
  member .sourceElementsNames  is ARRAY
  member .removeElementsNames  is ARRAY
  member .previewFlag          is BOOLEAN

  using namespace 'Aveva.Pdms.Presentation'
  member .sourceListGrid       is NETGRIDCONTROL
  member .errorListGrid        is NETGRIDCONTROL
exit
-- End of method

------------------------------------------------------------------------
--
-- Method:      pfIsoDrawings
-- Description: constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pfIsoDrawings()
  -- set icons
  !this.fabIsoOptionFileBrowser.addPixmap(!!pml.getPathname('openbrowser.png'))
  !this.instIsoOptionFileBrowser.addPixmap(!!pml.getPathname('openbrowser.png'))

  !this.fabIsoResultFileBrowser.addPixmap(!!pml.getPathname('openbrowser.png'))
  !this.instIsoResultFileBrowser.addPixmap(!!pml.getPathname('openbrowser.png'))

  -- it should be changed in the next service pack.
--  var !projCode proj code
--  !projIso = |%|& !projCode & |iso%|
--
--  -- set iso option file path
--  !this.fabIsoOptionFilePath.val = '$!projIso\STD\pfSpoolDwg.pmldat'
--  !this.instIsoOptionFilePath.val = '$!projIso\STD\pfSpoolDwg.pmldat'

  !this.fabIsoOptionFilePath.val  = !!pml.getPathname('pffabdrwg.pmldat').replace(|/|,|\|)
  !this.instIsoOptionFilePath.val = !!pml.getPathname('pfinstdrwg.pmldat').replace(|/|,|\|)

  !pdmsUserPath = !!evarSplit('PDMSUSER')[1]

  -- set result file path
  !this.fabIsoResultFilePath.val  = !pdmsUserPath
  !this.instIsoResultFilePath.val = !pdmsUserPath

  !this.drawingTypeList.dText = split('PIPE,BRAN,PSPOOL,SPLDRG',',')

  -- create instance of grid control
  using namespace 'Aveva.Pdms.Presentation'

  -- add .Net control to PML container for contents
  !this.sourceListGrid            = object NETGRIDCONTROL()
  !this.sourceListControl.control = !this.sourceListGrid.handle()

  !this.errorListGrid             = object NETGRIDCONTROL()
  !this.errorListControl.control  = !this.errorListGrid.handle()

  -- add events on Grids
  !this.sourceListGrid.addeventhandler('OnPopup',           !this, 'sourceListGridRightClick')
  !this.sourceListGrid.addeventhandler('afterSelectChange', !this, 'selectChangeOnSourceListGrid')

  !this.errorListGrid.addeventhandler('OnPopup', !this, 'errorListRightClick')

  !this.populateSourceList(object ARRAY(), false)
  !this.populateSourceList(object ARRAY(), true)

  !this.sourceListGrid.outlookGroupStyle(false)
  !this.errorListGrid.outlookGroupStyle(false)

  !this.popupMenus()

  -- set option file path
  !optionFilePath = !pdmsUserPath & |\| & 'pfmIsoDwg.pmldat'
  !this.optionFile = object FILE(!optionFilePath)

  !layoutFilePath = !pdmsUserPath & |\| & 'pfmIsoDwgUI.pmldat'
  !this.layoutDefault = object FILE(!layoutFilePath)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      sourceListGridRightClick
-- Description: source list grid right click
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       args
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .sourceListGridRightClick(!args is ARRAY)
  !this.sourceListControl.showPopup(!args[0], !args[1])
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      errorListRightClick
-- Description: error list right click
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       args
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .errorListRightClick(!args is ARRAY)
  !this.errorListControl.showPopup(!args[0], !args[1])
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectChangeOnSourceListGrid
-- Description: select change on source list grid
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       passed array
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectChangeOnSourceListGrid(!passedArray is ARRAY)
  if(!passedArray.unset()) then
    return
  endif

  !this.showPreviewDrawing()
  !this.navigateOnExplorer()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      popupMenus
-- Description: popup menus
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .popupMenus()
  -- Popup Menus for errors Grid
  !popup = !this.newMenu('popupDefault')
  !popup.add( 'toggle',   'Preview Drawing', '!this.showPreviewDrawing()','')
  !popup.add( 'toggle',   'Navigate on Explorer', '!this.navigateOnExplorer()','')
  !popup.add( 'separator' )

  !popup.add( 'callback', 'Remove Selected', '!this.removeSelectedItems()','' )
  !popup.add( 'separator' )
  !popup.add( 'callback', 'Print Preview', '!this.sourceListGrid.printPreview()' )
  !popup.add('CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.sourceListGrid, ||, |Save As|)' )
  !popup.add( 'separator' )
  !popup.add( 'toggle',   'Show Filter', |!this.showFilter(true)|,'selecting')

  !this.sourceListControl.popup   = !popup

  -- Popup Menus for errors Grid
  !popup = !this.newMenu('popupErrorList')
  !popup.add( 'callback', 'Print Preview', '!this.errorListGrid.printPreview()' )
  !popup.add('CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.errorListGrid, ||, |Save As|)' )
  !popup.add( 'separator' )
  !popup.add( 'toggle',   'Show Filter', |!this.showFilter(false)|,'selecting')

  !this.errorListControl.popup   = !popup
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
-- Description: initialise
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()
  !this.sourceElementsNames.clear()
  !this.removeElementsNames.clear()

  if (!this.isFabricationDrawing.unset()) then
    return error 1 |Please define iso drawing type.|
  endif

  !this.fabIsoOptionDefinition.visible   = !this.isFabricationDrawing
  !this.instIsoOptionDefinition.visible  = !this.isFabricationDrawing.not()

  if (!this.isFabricationDrawing) then
    !this.formTitle = |Fabrication Isometrics...|
  else
    !this.formTitle = |Installation Isometrics...|
  endif

  !this.loadOptionFile()
  !this.loadLayout()
  !this.setHierarchyFlag()

--  !this.evaluateSourceList()
  !this.populateSourceList(object ARRAY(), false)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      populateSourceList
-- Description: populate source list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       contents
--    2    R     BOOLEAN     is error list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .populateSourceList(!contents is ARRAY, !isErrorList is BOOLEAN)
  if (!isErrorList) then
    !headings = split('Element Name,Type,Description',',')
    !gridName    = 'errorListGrid'
  else
    !headings = split('Element Name,Type,Sheets,Date',',')
    !gridName    = 'sourceListGrid'
  endif

  using namespace 'Aveva.Pdms.Presentation'
  !nds = object NETDATASOURCE('Source List', !headings, !contents)

  !this.$!<gridName>.bindToDataSource(!nds)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setIsoOptionFile
-- Description: set iso option file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     BOOLEAN     is fabrication type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setIsoOptionFile(!isFabricationType is BOOLEAN)
  using namespace 'Aveva.Pdms.Presentation'

  -- Initialise variables
  !fileBrowser = object PMLFILEBROWSER('OPEN')

  var !projCode proj code
  !projIsoStdDir = |%|& !projCode & |iso%\STD\|

  !fileBrowser.show(!projIsoStdDir, '', 'Set Iso Option File', false, 'dat files (*.*)|*.*', 1)

  if (!fileBrowser.file().empty()) then
      return
  endif

  if (!isFabricationType) then
    !sourceGadgetName = 'fabIsoOptionFilePath'
  else
    !sourceGadgetName = 'instIsoOptionFilePath'
  endif

  !this.$!<sourceGadgetName>.val = !fileBrowser.file()
  handle any
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setResultPltFilePath
-- Description: set result plt file path
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     BOOLEAN     is fabrication type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setResultPltFilePath(!isFabricationType is BOOLEAN)
  using namespace 'Aveva.Pdms.Presentation'

  -- Initialise variables
  !folderBrowser = object PMLFOLDERBROWSER()

  -- Show the folder browser
  !folderBrowser.show('Select Output Folder',true)
  !path = !folderBrowser.selectedPath()
  if !path.empty() then
    return
  endif

  if (!isFabricationType) then
    !sourceGadgetName = 'fabIsoResultFilePath'
  else
    !sourceGadgetName = 'instIsoResultFilePath'
  endif

  -- Use the selected folder
  !this.$!<sourceGadgetName>.val = !folderBrowser.selectedPath()
  handle any
    !!alert.message('Cancel selecting output folder')
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadOptionFile
-- Description: load option file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadOptionFile()
  if !this.optionFile.exists().not() then
    return
  endif

  !readData = !this.optionFile.readFile()
  handle ANY
    !!alert.error(|$!!error.text|)
    return
  endhandle

  !this.fabIsoOptionFilePath.val  = !readData[1]
  !this.fabIsoResultFilePath.val  = !readData[2]
  !this.instIsoOptionFilePath.val = !readData[3]
  !this.instIsoResultFilePath.val = !readData[4]
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkOptionFilePath
-- Description: check option file path
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    BOOLEAN
--
------------------------------------------------------------------------
define method .checkOptionFilePath() is BOOLEAN
  if (!this.isFabricationDrawing) then
    if (!this.isValidFilePath(!this.fabIsoOptionFilePath.val, true).not()) then
      !this.fabIsoOptionFilePath.setFocus()
      return false
    endif

    if (!this.isValidFilePath(!this.fabIsoResultFilePath.val, true).not()) then
      !this.fabIsoResultFilePath.setFocus()
      return false
    endif
  else
    if (!this.isValidFilePath(!this.instIsoOptionFilePath.val, true).not()) then
      !this.instIsoOptionFilePath.setFocus()
      return false
    endif

    if (!this.isValidFilePath(!this.instIsoResultFilePath.val, true).not()) then
      !this.fabIsoResultFilePath.setFocus()
      return false
    endif
  endif

  return true
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      saveOptionFile
-- Description: save option file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveOptionFile()
  -- check iso option file path
  if (!this.checkOptionFilePath().not()) then
    return
  endif

  -- save options
  !this.optionFile.open('OVER')
  handle any
    !!alert.error('Error Saving Option File')
    return
  endhandle

  !this.optionFile.writeRecord(|$!this.fabIsoOptionFilePath.val|)
  !this.optionFile.writeRecord(|$!this.fabIsoResultFilePath.val|)
  !this.optionFile.writeRecord(|$!this.instIsoOptionFilePath.val|)
  !this.optionFile.writeRecord(|$!this.instIsoResultFilePath.val|)

  !this.optionFile.close()

  !this.populateContents()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      isValidFilePath
-- Description: is valid file path
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      file path
--    2    R     BOOLEAN     show error
-- Return:
--   [Data Type] [Description]
--    BOOLEAN
--
------------------------------------------------------------------------
define method .isValidFilePath(!filePath is STRING, !showError is BOOLEAN) is BOOLEAN
  if (!filePath.empty()) then
    if (!showError) then
      !!alert.message('Please input file name')
    endif
    return false
  endif

  !file = object FILE(!filePath)
  handle any
    if (!showError) then
      !!alert.error(!!error.text)
    endif

    return false
  endhandle

  if (!file.exists().not()) then
    if (!showError) then
      !!alert.error('The $!<filePath> does not exist.')
    endif
    return false
  endif

  return true
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      evaluateSourceList
-- Description: evaluate source list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .evaluateSourceList()
  !this.ceName.val = !!ce.flnm

  -- search source elements
  if (!this.useHierarchy.val) then
    !isValidType = !!ce.hardType inset ('PIPE','BRAN','PSLIST','PSPOOL','SPLDRG')
    if (!isValidType.not()) then
      !!alert.warning(|This function is only available for PIPE, BRANCH, PSLIST, PSPOOL or SPLDRG|)
      return
    endif

    if (!!ce.hardType eq 'PSLIST') then
      !sourceElementType = 'PSPOOL'
    else
      !sourceElementType = !!ce.hardType
    endif
  else
    !sourceElementType = !this.drawingTypeList.displayText()
  endif

  !collection = object COLLECTION()
  !collection.addType(!sourceElementType)
  !collection.scope(!!ce)

  !sourceElements = !collection.results()

--  !newLine='
--'
  if (!sourceElements.unset()) then
--    !!alert.message('There was no ' & !sourceElementType & !newLine & |Please choose element type.|)
    return
  endif

  do !entry values !sourceElements
    if (!entry.hardType eq 'PSLIST') then
      !members = !entry.members

      do !member values !members
        !elementName = !member.flnm
        skip if (!this.sourceElementsNames.findFirst(!entry.flnm).set())
        !this.sourceElementsNames.append(!elementName)
      enddo
    else
      !elementName = !entry.flnm
      skip if (!this.sourceElementsNames.findFirst(!entry.flnm).set())
      !this.sourceElementsNames.append(!elementName)
    endif
  enddo

  !this.populateContents()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      populateContents
-- Description: populate contents
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .populateContents()

  !contents = object ARRAY()

  do !elementName values !this.sourceElementsNames
    !entry = object DBREF(!elementName)
    handle any
      !entry = object DBREF()
    endhandle

    if (!entry.badRef()) then
      -- insert error message
      skip
    endif

    !table = object ARRAY()
    !table.append(!entry.flnm)
    !table.append(!entry.type)

    !drawingFiles = !this.evaluateDrawingPath(!entry)
    if (!drawingFiles.empty()) then
      !drawingStatus[1] = 'No Drawings Available'
      !drawingStatus[2] = '---'
    else
      !drawingStatus = !this.constructDrawingStatus(!drawingFiles)
    endif

    !table.append(!drawingStatus[1])
    !table.append(!drawingStatus[2])

    !contents.append(!table)
  enddo

  !this.populateSourceList(!contents, false)
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      .constructDrawingStatus
-- Description: create a string describing the files available
--
------------------------------------------------------------------------
define method .constructDrawingStatus(!files is ARRAY)is ARRAY

  !date = !files[1].dtm()
  !count= !files.size()

  if !count.gt(1) then
    !stringArray[1] = !count & ' Sheets '
  else
    !stringArray[1] = '1 Sheet '
  endif

  !stringArray[2] = !date.date() & ' ' & !date.monthString() & ' ' & !date.year() & ' ' & !date.hour() & ':'  & !date.minute()

  return !stringArray

  endmethod


------------------------------------------------------------------------
--
-- Method:      evaluateDrawingPath
-- Description: evaluate drawing path
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element
-- Return:
--   [Data Type] [Description]
--    STRING
--
------------------------------------------------------------------------
define method .evaluateDrawingPath(!element is DBREF) is ARRAY

  if (!this.isFabricationDrawing) then
    !resultPath = !this.fabIsoResultFilePath.val
  else
    !resultPath = !this.instIsoResultFilePath.val
  endif

  if (!this.isFabricationDrawing) then
    !prefix = '[FAB' & '_' & !element.type & ']'
  else
    !prefix = '[INST'  & '_' & !element.type & ']'
  endif

  -- get the list of current plotfiles for the passed element
  !plotfiles = !this.getPlotFiles(!resultPath,!prefix,!element)

 -- now what do we do with the array of files when it comes back
  return !plotfiles

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getplotfiles
-- Description: return an array of file objects based on the passed
-- path, prefix and element name
--
-------------------------------------------------------------------------
define method .getPlotFiles(!resultPath is STRING,!prefix is STRING, !element is DBREF )is ARRAY

  !return = ARRAY()
  !filename = !prefix & !!generateFileName(!element.name)

  !directory = object FILE(!resultPath)
  -- check that the directory exists
  !exists = !directory.exists()
  !type= !directory.type()
  handle any
    !type= 'null'
  endhandle

  if !exists.not() or !type.neq('DIRECTORY') then
    !!alert.error('Plot File pathname ' & !resultPath &  ' is not valid - Cannot find Preview Files')
    return !return
  endif

  !files = !directory.files()
  -- look for multiple files
  do !file values !files
    if !file.entry().match(!filename).gt(0) and !file.entry().match('.plt').eq(!file.entry().length() - 3)then
      !return.append(!file)
    elseif   !file.entry().match(!filename).gt(0) and !file.entry().match('.plt').eq(0) and !file.entry().match('.hit').eq(0)then
      skip if !file.entry().match('-matl').gt(0)
      !return.append(!file)
    endif
  enddo
  return !return

  endmethod

------------------------------------------------------------------------
--
-- Method:      setHierarchyFlag
-- Description: set hierarchy flag
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setHierarchyFlag()
 !this.drawingTypeList.active = !this.useHierarchy.val.not()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      addSourceElements
-- Description: add source elements
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .addSourceElements()
  !this.evaluateSourceList()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createDrawings
-- Description: create drawings
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createDrawings()
  !selectedItems = !this.sourceListGrid.getSelectedRows()
  if (!selectedItems.unset()) then
    !!alert.message('Select item(s) to create spool drawing')
  endif

  -- check iso option file path
  if (!this.checkOptionFilePath().not()) then
    return
  endif

  !isFabrication = !this.isFabricationDrawing
  if (!isFabrication) then
    !isoOptionFilePath = !this.fabIsoOptionFilePath.val
    !isoResultPath     = !this.fabIsoResultFilePath.val
  else
    !isoOptionFilePath = !this.instIsoOptionFilePath.val
    !isoResultPath     = !this.instIsoResultFilePath.val
  endif

  !isoDrawingManager = object PFISODRAWINGMANAGER()
  !isoDrawingManager.createIsometrics(!this.drawingTypeList.displayText(), !isoOptionFilePath, !isoResultPath, !selectedItems, !isFabrication)

  do !index values !this.sourceListGrid.getSelectedRowTags()
    !selectedData = !this.sourceListGrid.getRow(!index)
    !elementName = !selectedData[1]

    -- go and get the plotfaile data. This can be single or multiple so this now returns an array
    !plotFilePath = !this.evaluateDrawingPath(!elementName.dbRef())

    if (!plotFilePath.empty()) then
      !drawStatus = '---'
    else
      !drawStatus = 'O'
    endif
    !this.sourceListGrid.setCellValue(!index.real(), 3, !drawStatus)
  enddo

  if (!isoDrawingManager.errorList.set()) then
    !!alert.message(!isoDrawingManager.errorList.size() & ' Error occurred')
    !this.populateSourceList(!isoDrawingManager.errorList, true)
  else
    !this.populateContents()
  endif

  !this.showPreviewDrawing()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showPreviewDrawing
-- Description: show preview drawing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showPreviewDrawing()
  !checkPreview = !this.sourceListControl.popup.selected('Preview Drawing')
  handle any
  elsehandle none
    if (!checkPreview.set() and !checkPreview) then
      !previewFlag = true
    else
      !previewFlag = false
    endif
  endhandle

  if (!previewFlag.not()) then
    if (define(!!pfPlotPreview)) then
      !!isdPreviewiso.hide()
    endif
    return
  endif

  !items = !this.sourceListGrid.getRows()
  if (!items.unset()) then
    !!alert.message('There is no item in the grid')
    return
  endif

  !selectedItems = !this.sourceListGrid.getSelectedRows()
  if (!selectedItems.unset()) then
    return
  endif

  !elementName  = !selectedItems[1][1]
  !plotFilePath = !this.evaluateDrawingPath(!elementName.dbRef())
  if !plotFilePath.size().eq(0) then
     !!isdPreviewiso.hide()
     handle any
     endhandle
     return
  endif
  !displayText = ARRAY()
  !rtext = ARRAY()
  do !a from 1 to !plotFilePath.size()
    !displayText.append(!elementName & ' Sht ' & !a &' of ' & !plotFilePath.size() )
    !rtext.append(!plotFilePath[!a].fullname())
  enddo

 -- changed to use the existing preview dialogue from Isodraft
 if (undefine(!!isdPreviewiso)) then
    pml reload form !!isdPreviewiso
 endif

 -- populate the isodraft preview form
 !!isdPreviewiso.resetDisplay(!displayText, !rtext , '[FAB]mess')
 if !this.isFabricationDrawing then
   !!isdPreviewiso.formTitle     = 'Preview Fabrication Drawing'
 else
   !!isdPreviewiso.formTitle     = 'Preview Installation Drawing'
 endif
 !!isdPreviewiso.isoMode = FALSE
 !!isdPreviewiso.setMode(FALSE)
 !!isdPreviewiso.show()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      navigateOnExplorer
-- Description: navigate on explorer
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .navigateOnExplorer()
  !selectedItems = !this.sourceListGrid.getSelectedRows()
  if (!selectedItems.unset()) then
    return
  endif

  !checkNavigate = !this.sourceListControl.popup.selected('Navigate on Explorer')
  handle any
  elsehandle none
    if (!checkNavigate.set() and !checkNavigate) then
      !navigateFlag = true
    else
      !navigateFlag = false
    endif
  endhandle

  if (!navigateFlag.not()) then
    return
  endif

  !element = !selectedItems[1][1].dbRef()
  handle any
    return
  endhandle

  !!ce = !element
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      removeSelectedItems
-- Description: remove selected items
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .removeSelectedItems()
  !selectedItems = !this.sourceListGrid.getSelectedRows()
  if (!selectedItems.unset()) then
    return
  endif

  do !item values !selectedItems
    !elementName = !item[1]

    !removeIndex = !this.sourceElementsNames.findFirst(!elementName)
    skip if (!removeIndex.unset())

    !this.removeElementsNames.append(!elementName)
    !this.sourceElementsNames.remove(!removeIndex)
  enddo

  !this.removeElementsNames.unique()

  !this.populateContents()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showFilter
-- Description: show filter
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     BOOLEAN     is source grid
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showFilter(!isSourceGrid is BOOLEAN)
  if (!isSourceGrid) then
    !selecting  = !this.popupDefault.fieldproperty('selecting','SELECTED')
    !this.sourceListGrid.outlookGroupStyle(!selecting)
  else
    !selecting = !this.popupErrorList.fieldproperty('selecting','SELECTED')
    !this.errorListGrid.outlookGroupStyle(!selecting)
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadLayout
-- Description: load layout
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadLayout()
  if !this.layoutDefault.exists().not() then
    return
  endif

  !readData = !this.layoutDefault.readFile()
  handle ANY
    return
  endhandle

  !this.useHierarchy.val     = object BOOLEAN(!readData[1])
  handle any
  endhandle

  !this.drawingTypeList.val  = !readData[2].real()
  handle any
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      saveLayout
-- Description: save layout
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveLayout()
  -- save options
  !this.layoutDefault.open('OVER')
  handle any
    return
  endhandle

  !this.layoutDefault.writeRecord('$!this.useHierarchy.val')
  !this.layoutDefault.writeRecord('$!this.drawingTypeList.val')

  !this.layoutDefault.close()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      close
-- Description: close
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .close()
  !this.saveLayout()
endmethod
-- End of method
