--
--  Description:     Form for Pipe Isometric Drawing whether Fabrication or Installation Drawing
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  loadDefaultFile()                -                   load default file
--  pfPipeIsometricDrawing()         -                   constructor
--  saveDefaultFile()                -                   save default file
--  setResultPltFilePath()           -                   set result plt file path
--
------------------------------------------------------------------------

import 'PMLFileBrowser'
handle any
endhandle

-- Define form
setup form !!pfPipeIsometricDrawing
  !this.formTitle  = 'Isometric Drawing'
  !this.initcall   = |!this.loadDefaultFile()|

  paragraph .pgDrawList    at x0   text 'Select Source Element Type'

  path down

  rgroup .sourceTypes '' at x0.5 ymax callback '' VERTICAL
    add tag 'PIPE                        '
    add tag 'PSPOOL                      '
    add tag 'SPLDRG                      '
  exit

--  para   .paraResultIsoPath       at x1         ymax text 'Result File Path'
--  text   .txtResultIsoPath        at x1         ymax  width 27 is STRING
--  button .btnResultIsoBrowser     at xmax+0.5   ymin  pixmap width 16 height 16   callback |!this.setResultPltFilePath()|

  path down

  button .apply   'Apply'   at x0 callback |!this.saveDefaultFile()| width 5
  button .dismiss 'Dismiss' at xmax form-size ymin CANCEL

  member .sourceElementTypes is ARRAY
--  member .functionType       is STRING
  member .defaultFile        is FILE
  member .outputPath         is STRING
exit

------------------------------------------------------------------------
--
-- Method:      pfPipeIsometricDrawing
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pfPipeIsometricDrawing()
  !this.sourceElementTypes = split('PIPE,PSPOOL,SPLDRG',',')

  -- Browser Icons
--  !this.btnResultIsoBrowser.addPixmap(!!pml.getPathname('openbrowser.png'))
--  !this.btnISOOptfileBrowser.addPixmap(!!pml.getPathname('openbrowser.png'))

  -- result path to used to be saved the result picture.

  !pdmsUserPath = !!evarSplit('PDMSUSER')[1]
--  !this.txtResultIsoPath.val = !pdmsUserPath
  !defaultFilePath = !pdmsUserPath & |\| & 'pfmIsoEnv.pmldat'

  !this.outputPath = !pdmsUserPath
  !this.defaultFile = object FILE(!defaultFilePath)

  !this.loadDefaultFile()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadDefaultFile
--
-- Description: load default file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadDefaultFile()
  if (!this.defaultFile.unset() or !this.defaultFile.exists().not()) then
    return
  endif

  !readData = !this.defaultFile.readFile()
  handle ANY
    write |$!!error.text|
    return
  endhandle

  !this.sourceTypes.val = !readData[1].real()
  handle any
  endhandle

  !this.sourceTypes.val

--  !this.txtResultIsoPath.val = !readData[2]
--  handle any
--  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      saveDefaultFile
--
-- Description: save default file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveDefaultFile()
  !this.defaultFile.open('OVER')
  handle any
    write '[warning] Failed to save the log file for pipe spool dwg'
  elsehandle none
    !this.defaultFile.writeRecord(!this.sourceTypes.val.string())
--    !this.defaultFile.writeRecord(!this.txtResultIsoPath.val)
    !this.defaultFile.close()
  endhandle

  !this.hide()
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setResultPltFilePath
--
-- Description: save result plt file path
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setResultPltFilePath()
  using namespace 'Aveva.Pdms.Presentation'

  -- Initialise variables
  !folderBrowser = object PMLFOLDERBROWSER()

  -- Show the folder browser
  !folderBrowser.show('Select Output Folder',true)
  !path = !folderBrowser.selectedPath()
  if !path.empty() then
    return
  endif

--  -- Use the selected folder
--  !this.txtResultIsoPath.val = !folderBrowser.selectedPath()
--  handle any
--    !!alert.message('Cancel selecting output folder')
--  endhandle

  !this.hide()
endmethod
-- End of method
