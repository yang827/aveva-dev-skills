--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addCe()                          -
--  changeDrawingTemplate(GADGET,STRING) -                   change drawing template
--  changeDrawingType()              -                   change drawing type
--  changeSpoolType()                -                   change spool type among SHOP, SITE and FITT
--  checkClaimStatus(DBREF)          BOOLEAN             check claim status
--  checkDrwgElementName(STRING)     -                   check dept / regi name for drawing
--  checkElement(ARRAY)              BOOLEAN             check selected element
--  checkIsoOptionFileExist()        BOOLEAN             check iso option file existing
--  checkNamingRulePath()            BOOLEAN             check naming rule path
--  close()                          -                   close form
--  createDrawing()                  -                   create drawing
--  deleteDrawing()                  -                   delete selected drawing
--  errorListRightClick(ARRAY)       -                   error list popup callback
--  frameTabset(GADGET,STRING)       -                   open callback to check drawing option mode
--  getSpoolList()                   ARRAY               get spool list
--  gridControl(STRING)              -                   get current grouping settings
--  highlightSpool(DBREF)            -                   highlight selected spools
--  initialise()                     -                   initialise this form
--  isValidStatus(DBREF)             BOOLEAN
--  loadDrawingDefaultFile(BOOLEAN)  -
--  loadEnvironmentFile()            -
--  navigateSpoolDrawingOnExplorer() -                   navigate spool drawing on explorer
--  navigateSpoolOnExplorer()        -                   navigate spool element on explorer if current is "navigate spool mode"
--  openDrawing()                    -                   open drawing
--  pfPipeSpoolDwg()                 -                   constructor
--  populateErrorList()              -                   Update the error list
--  populateSpoolList()              -                   Update the list of spools
--  popupMenus()                     -                   Setup popup menus
--  printDrawing()                   -                   print drawing with selected items
--  publishDwgOptionGadgetContents(GADGET,STRING) -                   populate template list on combo box gadget
--  refreshSpoolList()               -                   refresh spool list
--  removeAll()                      -
--  removeSelected()                 -                   method to remove one or more items from the grid
--  saveEnvironmentFile()            -
--  selectSpoolListGrid(ARRAY)       -                   select callback for spool list
--  setIsoOptionFIle()               -                   set iso option file
--  setNamingRuleFilePath()          -
--  setPipeSketchOptions()           BOOLEAN             set pipe sketch options
--  setPreviewFlag(BOOLEAN)          -                   This moves the preview from a right click to a toggle
--  setResultPltFilePath()           -                   set result path for exporting plt file
--  showDrawingTemplate()            -                   Show drawing template Preview on this form
--  showPreview(STRING)              -                   show preview about spool or plt file
--  showPreviewGadget()              -                   show preview gadget if current is "preview mode".
--  showProcessResult(REAL,STRING)   -                   show progress result briefly
--  showSpoolDimension()             -                   show spool dimension on current 3d view
--  showSpoolDrawing()               -                   Show spool drawing Preview
--  spoolListRightClick(ARRAY)       -                   Pop-up callback for spool list
--  spoolUpdate(STRING)              -                   spool update
--  transRegiName(STRING)            STRING              translate registry name
--  updateGridIcons()                -
--  useDesiHierarchy()               -                   use desi hierarchy or not for creating drawing
--  useMarineEnv()                   -                   use marine environment
--  writeErrorMessage(STRING,STRING) -                   write error message
--  zoomInSelectedSpool()            -                   zoom in selected spool on 3d view if current is "Zoom-in spool mode".
--
------------------------------------------------------------------------
import 'GridControl'
handle any
endhandle

import 'PMLFileBrowser'
handle any
endhandle

import 'PipeFabricationAddin'
handle any
endhandle

-- Define form
layout form !!pfPipeSpoolDwg dialog dock
  !this.formTitle  = |Pipe Spool Drawing|
  !this.initcall   = |!this.initialise()|
  !this.quitcall   = |!this.close()|

  -- Associate TRACKER attribs with this form
--  track 'DBCHANGED' call |!!pipespooldwg.populateSpoolList()|

  -- main frame
  frame .frameMain tabset anchor all at x0 y0
    -- create drawing frame
    frame .frameMakeDwg 'Create Drawing'    anchor all            at xmin     ymin
      -- controls to display current element
      button .btnCE       'Add CE'                                  at x1       ymin0.5     width 5   callback |!this.addCe()|
      para   .paraCE                                            at xmax1    ymin        width 20

      -- controls to execution
      button .btnCreateDrawing    'Create Drawing' anchor r+t     at xmax   ymin          width 10   callback |!this.createDrawing()|
      button .btnRefreshSpoolList 'Refresh'        anchor r+t     at xmax0.5  ymin        width 8    callback |!this.refreshSpoolList()|

      -- PML container to host .NET grid control
      container .spoolList      PMLNetControl anchor all          at x1       ymax0.5     'spoolList'  width 83

      toggle .tglPreviewPlot     'Preview Drawings' tagwidth 13  anchor l+b  at x1       ymax.spoolList + 0.3     callback |!this.setPreviewFlag(!this.tglPreviewPlot.val)|
      toggle .tglPreviewDrawing  'Open Drawing' tagwidth 9  anchor l+b  at x1       ymax.spoolList + 0.3     callback |!this.openDrawing()|
      toggle .tglShowSpoolDim    'Show Spool Dimension'     anchor l+b  at xmax.tglPreviewPlot     ymax.spoolList + 0.3     callback |!this.showSpoolDimension()|
      option .drawingTypeList    'Drawing Type' tagwidth 10 anchor b+r  at xmax form-size  ymin callback |!this.changeDrawingType()| width 24
    exit

    -- drawing options frame
    frame .frameOptions 'Drawing Options'           anchor all            at xmin     ymin height 21
      -- detail drawing options
      frame .frameOptionDetail panel
        -- drawing options frame
        frame .frameDwgoptions 'Drawing Options' anchor l+t at xmin ymax0.5
          text   .txtDeptName tagwidth 10 'Dept. Name' anchor l+t at x1 ymax0.3 callback |!this.checkDrwgElementName('DEPT')| width 20 is STRING
          text   .txtRegiName tagwidth 10 'Regi. Name' anchor l+t at x1 ymax0.3 callback |!this.checkDrwgElementName('REGI')| width 20 is STRING

          toggle .tglUseDesiHier 'Using DESI Hierarchy' at x1 ymax+0.2 callback '!this.useDesiHierarchy()'
          toggle .tglUseMarineEnv 'Using Marine Environment' at x1 ymax callback '!this.useMarineEnv()'
        exit

        frame .frameNamingOptions 'Sketch Naming Options' anchor l+t at xmin ymax0.5
          para   .paraNamingRulePath   at x1 ymax text 'Naming Rule File'
          text   .txtNamingRulePath    at x1 ymax width 27 is STRING
          button .btnNamingRuleBrowser at xmax+0.5 ymin pixmap width 16 height 16 callback |!this.setNamingRuleFilePath()|
        exit

        -- iso options frame
        frame .frameISOoptions 'ISO Options' anchor l+t at xmin ymax0.5
          -- iso option file path
          -- result path which used to export the result picture file.
          para   .paraResultIsoPath       at x1         ymax text 'Result File Path'
          text   .txtResultIsoPath        at x1         ymax  width 27 is STRING
          button .btnResultIsoBrowser     at xmax+0.5   ymin  pixmap width 16 height 16   callback |!this.setResultPltFilePath()|

          -- iso template file path
          para   .paraIsoTmplPath         at x1         ymin1 text 'Template Registry'
          combo  .cboTmplsList            at x1         ymax  callback   |!this.changeDrawingTemplate(| width 25

          -- drawing type list
          para   .paraDrwgType            at x1         ymin1 text 'Drawing Template'
          combo  .cboDrawingTypes         at x1         ymax  callback   |!this.changeDrawingTemplate(| width 25
          para   .paraIsoType             at x1         ymax  text ''   width 30
        exit
      exit

      -- drawing preview
      frame .frameTmplPreview 'Preview'     anchor all at xmax1.5  ymin.frameDwgoptions
        view .vwTmplPreview plot  width 34 height 17.5
        exit
      exit

      -- controls to execution
      button .btnApply    'Apply'    anchor l+t     at x1     ymax.frameISOoptions + 0.5      width 10 height 1.2  callback |!this.setPipeSketchOptions()|
      button .btnDismiss  'Dismiss'  anchor l+t    at xmax0.5  ymin      width 10  height 1.2 callback |!this.close()|
    exit

    -- error list frame
    frame .frameErrorList 'Error List'    anchor all            at xmin     ymin
      -- PML container to host .NET grid control
      container .errorListControl      PMLNetControl anchor all       at x1       ymax0.5     'ErrorList'  width 60
    exit
  exit

  using namespace 'Aveva.Pdms.Presentation'
  -- grid for spool list
  member .spoolListGrid     is NETGRIDCONTROL
  -- grid for error list
  member .errorGrid         is NETGRIDCONTROL
  -- array which has error contents
  member .errorList         is ARRAY
  -- default file
  member .drawingDefaultFile is FILE
  -- iso option contents
  member .isoOptionContents is ARRAY
  -- flag for preview the result picture file
  member .previewFlag       is BOOLEAN
  -- activated 3d view which used to be displayed progress
  member .current3DView     is FORM
  -- flag used to be checked drawing option mode or not
  member .isDwgOptionMode    is BOOLEAN
  -- object used to be created pipe spool dimension on 3D view
  member .pipeModelDim      is PIPEMODELDIMENSION
  -- object used to be checked pipe fabrication
  member .spoolManager      is PIPEFABRICATIONMANAGER
  -- store top db element
  member .element           is DBREF
  --CW store existing pipe elements in an array
  member .existList         is ARRAY
  member .removedList       is ARRAY
  member .fileManager       is PFFILEMANAGER

  if(!!module().productfamily.upCase() eq 'MARINE') then
    member .mardradraftingapi is MARDRADRAFTINGAPI
  endif

  member .marPtypes         is ARRAY

  member .pdmsUserPath      is STRING

  member .marDrawingTypeData is COMMARDRAWINGTYPES

  member .previewDirPath    is STRING

  member .environmentFile   is FILE

  member .namingErrorHappened is BOOLEAN

  member .selectErrorHappned is BOOLEAN
exit
-- End of method

------------------------------------------------------------------------
--
-- Method:      pfPipeSpoolDwg
--
-- Description: Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pfPipeSpoolDwg()
  -- Create instance of grid control
  using namespace 'Aveva.Pdms.Presentation'

  -- Add .Net control to PML container for contents
  !this.spoolListGrid     = object NETGRIDCONTROL()
  !this.spoolList.control = !this.spoolListGrid.handle()

  !this.errorGrid         = object NETGRIDCONTROL()
  !this.errorListControl.control = !this.errorGrid.handle()

  -- Add events on spoolListGrid
  !this.spoolListGrid.addeventhandler('OnPopup',           !this, 'spoolListRightClick')
  !this.spoolListGrid.addeventhandler('afterSelectChange', !this, 'selectSpoolListGrid')

  !this.errorGrid.addeventhandler('OnPopup', !this, 'errorListRightClick')

  -- Load information from Configuration
  !this.spoolListGrid.columnExcelFilter(true)
  !this.spoolListGrid.outlookGroupStyle(false)
  !this.spoolListGrid.columnSummaries(true)
  !this.spoolListGrid.fixedHeaders(true)
  !this.spoolListGrid.fixedRows(false)
  !this.spoolListGrid.singleRowSelection(false)

  -- Load information from Configuration
  !this.errorGrid.columnExcelFilter(true)
  !this.errorGrid.outlookGroupStyle(false)
  !this.errorGrid.columnSummaries(true)
  !this.errorGrid.fixedHeaders(false)
  !this.errorGrid.fixedRows(false)
  !this.errorGrid.singleRowSelection(false)

  -- Setup popup-menus
  !this.popupMenus()

  -- open callback to check drawing option mode
  !this.frameMakeDwg.callback = '!this.frameTabset('
  !this.frameOptions.callback = '!this.frameTabset('
  !this.frameErrorList.callback = '!this.frameTabset('

  -- Browser Icons
  !this.btnResultIsoBrowser.addPixmap(!!pml.getPathname('openbrowser.png'))
--  !this.btnISOOptfileBrowser.addPixmap(!!pml.getPathname('openbrowser.png'))
  !this.btnNamingRuleBrowser.addPixmap(!!pml.getPathname('openbrowser.png'))

  !this.filemanager = object PFFILEMANAGER()

  !this.pdmsUserPath = !this.filemanager.pdmsUserPath
  -- result path to used to be saved the result picture.
  !this.txtResultIsoPath.val = !this.pdmsUserPath

  !this.txtNamingRulePath.val = !!pml.getPathname('pfsketchnaming.pmldat')
  handle any
    !this.txtNamingRulePath.val = ''
  endhandle

  !defaultPath = !this.pdmsUserPath & |\| & 'pfmSpoolDwg.pmldat'
  !this.drawingDefaultFile = object FILE(!defaultPath)

  !envFilePath = !this.pdmsUserPath & |\| & 'pfmSpoolDwgEnv.pmldat'
  !this.environmentFile    = object FILE(!envFilePath)

  -- flag for checking current tab
  !this.isDwgOptionMode = false

  if(!!module().productfamily.upCase() eq 'MARINE') then
    !this.marDrawingTypeData.evaluateDrawingTypesForNewDrawing()

    !this.drawingTypeList.dText = !this.marDrawingTypeData.drawingTypes
    !this.drawingTypeList.rText = !this.marDrawingTypeData.marDBNames

    !this.marPtypes = !this.marDrawingTypeData.marPtypes

    if (!this.marDrawingTypeData.drawingTypes.set()) then
      !index = !this.marDrawingTypeData.drawingTypes.findFirst('Pipe sketch')
      if (!index gt 0) then
        !this.drawingTypeList.val = !index
      endif
    endif

    !marDbName = !this.drawingTypeList.rText[!this.drawingTypeList.val]
    !result = !this.marDrawingTypeData.getPaddData(!marDbName)

    if (!result.set()) then
      !this.tglUseMarineEnv.val = true
    endif
  else
    !this.drawingTypeList.visible = false
    !this.tglUseMarineEnv.visible = false
  endif

endmethod
-- End of method

define method .addCe()
  !this.removedList.clear()

  if (!this.spoolListGrid.getRows().unset()) then
    !this.existList.clear()
  endif
  !this.initialise()
endmethod

------------------------------------------------------------------------
--
-- Method:      initialise
--
-- Description: initialise this form
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()
  !this.selectErrorHappned = false

  --Ship coordinates form must be hidden if shown, as it contains a grid which
  --may contain the same information in as this form which was causing an error
  if(!!module().productfamily.upCase() eq 'MARINE') then
    if (defined(!!shipcoords)) then
      if (!!shipcoords.shown()) then
        !!shipcoords.hide()
      endif
    endif

    !this.useMarineEnv()
  endif

  !validSelection = true
  !this.element = PIPE
  handle ANY
    !this.element = ZONE
    handle ANY
      !this.element = GPSET
      handle any
        if (!this.selectErrorHappned.not()) then
          !!alert.message('Select GPSET, ZONE or element below a GPSET or ZONE level!')
        endif
        !validSelection = false
--        return error 1 'Error Initialise Form - Select GPSET, ZONE or element below a GPSET or ZONE level'
      endhandle
    endhandle
  endhandle

  -- empty the filemanager
  !this.fileManager = object PFFILEMANAGER()

  if (!this.spoolListGrid.getRows().unset()) then
    !this.btnCreateDrawing.active    = !validSelection
    !this.btnRefreshSpoolList.active = !validSelection
  endif

  !this.errorList.clear()

  !this.previewFlag  = false

  !this.element = !!ce
  !this.paraCE.val = !this.element.fullname

  -- populate spool list
  !this.populateSpoolList()

  var !templateRegi eval name for all REGI with (SPPURPOSE eq 'PSPOOL')

  if (!templateRegi.unset()) then
    !!alert.error('There is no drawing template. Please ')
    return
  endif

  !this.cboTmplsList.dText = !templateRegi

  var !templateDrwgList eval name for all DRWG for $!templateRegi[1]
  !this.cboDrawingTypes.dText = !templateDrwgList

  -- preview drawing template
  if (!templateDrwgList.size() gt 0) then
    !dwgRef = !this.cboDrawingTypes.displayText().dbRef()
    handle any
    elsehandle none
      !dwgFunc = !dwgRef.func
      if (!dwgFunc.upCase().occurs('2D SKETCH') gt 0) then
        !this.paraIsoType.val = '>> Drawing Type : 2D sketch'
      else
        !this.paraIsoType.val = '>> Drawing Type : ISO sketch'
      endif
    endhandle

    !this.showPreview('TMPL')
  endif

  !this.vwTmplPreview.borders = true

  !this.current3DView = !!fmsys.currentDocument()

  !this.spoolManager.initializeFabrication()

   -- preview drawing template
  if (!templateDrwgList.size() gt 0) then
    !this.changeDrawingTemplate(!this.cboDrawingTypes,'')
  endif

  !isDraftMode = !!module().modKey.upCase() eq 'MARDRA' or !!module().modKey.upCase() eq 'DRA'

  !this.tglShowSpoolDim.visible   = !isDraftMode.not()
  !this.tglPreviewDrawing.visible = !isDraftMode
  !this.tglPreviewPlot.visible = !isDraftMode.not()

  !this.marDrawingTypeData.evaluate()

  -- LOAD DEFAULT FILE
  !logFilePath = |$!this.pdmsUserPath\pfPipeSpoolDwg.log|
  !defaultFile = object FILE(!logFilePath)
  if (!defaultFile.exists().not()) then
    return
  endif

  !readData = !defaultFile.readFile()
  handle (41,319)
    write |$!!error.text|
    return
  endhandle

  if (!readData.empty()) then
    return
  endif

  -- load iso option file
  !this.loadDrawingDefaultFile(true)

  !this.drawingTypeList.visible = !this.tglUseMarineEnv.val

  !this.loadEnvironmentFile()

  !this.txtDeptName.active = !this.tglUseMarineEnv.val.not()
  !this.txtRegiName.active = !this.tglUseMarineEnv.val.not()
  !this.tglUseDesiHier.active = !this.tglUseMarineEnv.val.not()


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      refreshSpoolList
--
-- Description: refresh spool list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .refreshSpoolList()
  !this.populateSpoolList()
endmethod

------------------------------------------------------------------------
--
-- Method:      popupMenus
--
-- Description: Setup popup menus.
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .popupMenus()

  -- Popup Menus for errors Grid
  !popup = !this.newMenu('popupDefault')

  !popup.add( 'toggle',   'Navigate Spool on Explorer', '!this.navigateSpoolOnExplorer()','')
  if (!!module().modKey.upCase() eq 'MARDRA' or !!module().modKey.upCase() eq 'DRA') then
    !popup.add( 'toggle', 'Navigate Spool Drawing on Explorer', '!this.navigateSpoolDrawingOnExplorer()','')
    !popup.add( 'separator' )
  endif

  if (!!module().modKey.upCase() ne 'MARDRA' and !!module().modKey.upCase() ne 'DRA') then
    !popup.add( 'toggle',   'Zoom-in Selected Spool in 3D View', '!this.zoomInSelectedSpool()','' )
    !popup.add( 'separator' )
  endif

  !popup.add( 'callback', 'Remove Selected', '!this.removeSelected()','' )
  !popup.add( 'callback', 'Remove All', '!this.removeAll()','' )
  !popup.add( 'separator' )
  !popup.add( 'callback', 'Select All', '!this.spoolListGrid.selectAllRows()','' )
  !popup.add( 'callback', 'Unselect All', '!this.spoolListGrid.clearRowSelection()','' )
  --!popup.add( 'separator' )
  !popup.add( 'separator' )
  !popup.add('CALLBACK', 'Print Selected Drawings', '!this.printDrawing()' , || )
  !popup.add( 'callback', 'Print Preview Current Form List', '!this.spoolListGrid.printPreview()' )
  !popup.add('CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.spoolListGrid, ||, |Save As|)' )
  !popup.add( 'separator' )
  !popup.add( 'toggle',   'Show Filter', |!this.gridControl('SPOOL_LIST')|,'selecting')

  !this.spoolList.popup   = !popup

  -- Popup Menus for errors Grid
  !popup = !this.newMenu('popupErrorList')
  !popup.add( 'callback', 'Print Preview', '!this.errorGrid.printPreview()' )
  !popup.add('CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.errorGrid, ||, |Save As|)' )
  !popup.add( 'separator' )
  !popup.add( 'toggle',   'Show Filter', |!this.gridControl('ERROR_LIST')|,'selecting')

  !this.errorListControl.popup   = !popup
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      frameTabset
--
-- Description: open callback to check drawing option mode
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      GADGET      the gadget to be visible
--    2   R      STRING      action
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .frameTabset(!gadget is GADGET, !action is STRING)
  if ( !action.neq('SHOWN') ) then
    return
  endif

  if (!gadget eq !this.frameOptions) then
    !this.isDwgOptionMode = true
  else
    !this.isDwgOptionMode = false
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      openDrawing
--
-- Description: open drawing
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .openDrawing()
  if (!!module().modKey.upCase() inset ('DES','MARODES')) then
   return
  endif

 if (!this.tglPreviewDrawing.val.not()) then
    return
  endif

  if (!this.spoolListGrid.getSelectedRows().unset()) then
    return
  endif

  !dwgStatus = !this.spoolListGrid.getSelectedRows()[1][4]
  if (!dwgStatus eq 'none') then
    return
  endif

  !spoolName = !this.spoolListGrid.getSelectedRows()[1][2]
  !spoolRef  = !spoolName.dbRef()
  handle any
    return
  endhandle

  if (!spoolRef.badRef()) then
    !!alert.message('Selected Spool has invalid reference')
    return
  endif

  if (!spoolRef.isNamed.not()) then
    !spoolName = '/' & !spoolRef.refNo.string().replace('/','_')
  endif

  --!sheetName = !spoolName & '_Spool'
  !sheetName =  !!pfEvaluateSketchName(!this.txtNamingRulePath.val, !spoolRef, !this.errorList) & '/S1'
  handle any
    -- spool does not exist
    --write 'Check Selected Spool was deleted, Please'
    !!alert.error('Unable to open drawing - it was deleted')
    return
  endhandle


  !sheetRef = !sheetName.dbRef()
  handle any
    return
  endhandle

  if (!sheetRef.badRef()) then
    return
  endif

  !!opensheet(!sheetRef)
endmethod

------------------------------------------------------------------------
--
-- Method:      showSpoolDimension
--
-- Description: show spool dimension on current 3d view
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showSpoolDimension()
  -- it'll be removed spool dimension if show spool dimension mode is on.
  if (!this.tglShowSpoolDim.val.not()) then
    !this.pipeModelDim.clearDimension()
    return
  endif

  if (!this.spoolListGrid.getSelectedRows().unset()) then
    return
  endif

  -- get spool reference on spoolListGrid
  !spool = !this.spoolListGrid.getSelectedRows()[1][2].dbRef()
  handle any
    -- spool does not exist
    --write 'Check Selected Spool was deleted, Please'
    return
  endhandle

  if (undefined(!spool)) then
    return
  endif

  if (!spool.badRef())then
    return
  endif

  -- display spool dimension
  !this.pipeModelDim.drawDimension(!spool)
endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      showPreviewGadget
--
-- Description: show preview gadget if current is "preview mode".
--
--
------------------------------------------------------------------------
define method .showPreviewGadget()


  -- show spool drawing if current "preview mode" is ticked.
  if (!this.previewFlag) then
     !this.showPreview('SPOOL')
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      navigateSpoolDrawingOnExplorer
--
-- Description: navigate spool drawing on explorer
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
------------------------------------------------------------------------
define method .navigateSpoolDrawingOnExplorer()
  -- check navigate spool mode
  !checkNaviSpoolDwg = !this.spoolList.popup.selected('Navigate Spool Drawing on Explorer')
  handle any
  elsehandle none
    if (!this.spoolListGrid.getSelectedRows().unset()) then
      return
    endif

    -- it'll be navigated to selected spool on spool list
    if (!checkNaviSpoolDwg.set() and !checkNaviSpoolDwg) then
      !spoolRef = !this.spoolListGrid.getSelectedRows()[1][2].dbRef()
      handle any
        !spoolRef = object DBREF()
      endhandle

      if (!spoolRef.badRef()) then
        return
      endif

      !sheetName =  !!pfEvaluateSketchName(!this.txtNamingRulePath.val, !spoolRef, !this.errorList) & '/S1'
      !sheetRef = !sheetName.dbRef()
      handle any
        return
      endhandle

      if (!sheetRef.badRef()) then
        return
      endif

      !!ce = !sheetRef
      handle any
        return
      endhandle

      !this.spoolList.popup.select('Navigate Spool on Explorer', false)
    endif
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      navigateSpoolOnExplorer
--
-- Description: navigate spool element on explorer if current is "navigate spool mode".
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .navigateSpoolOnExplorer()
  -- check navigate spool mode
  !checkNaviSpool = !this.spoolList.popup.selected('Navigate Spool on Explorer')
  handle any
  elsehandle none
    if (!this.spoolListGrid.getSelectedRows().unset()) then
      return
    endif

    -- it'll be navigated to selected spool on spool list
    if (!checkNaviSpool.set() and !checkNaviSpool) then
      !spool = !this.spoolListGrid.getSelectedRows()[1][2].dbRef()
      handle any
        -- spool does not exist
        --write 'Check Selected Spool was deleted, Please'
        return
      endhandle

      if (undefined(!spool)) then
        return
      endif

      if (!spool.badRef()) then
        return
      endif

      !!ce = !spool
      handle any
        return
      endhandle

      !this.spoolList.popup.select('Navigate Spool Drawing on Explorer', false)
      handle(61,558)
      endhandle
    endif
  endhandle


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      zoomInSelectedSpool
--
-- Description: zoom in selected spool on 3d view if current is "Zoom-in spool mode".
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .zoomInSelectedSpool()
  -- check zoom-in spool mode
  !checkZoomInSpool = !this.spoolList.popup.selected('Zoom-in Selected Spool in 3D View')
  handle any
  elsehandle none
    if (!checkZoomInSpool.set() and !checkZoomInSpool) then
      if (!this.spoolListGrid.getSelectedRows().unset()) then
        return
      endif

      !spool = !this.spoolListGrid.getSelectedRows()[1][2].dbRef()
      handle any
        -- spool does not exist
--        write 'Check Selected Spool was deleted, Please'
        return
      endhandle

      if (undefined(!spool)) then
        return
      endif

      if (!spool.badRef()) then
        return
      endif

      add $!spool

      -- zoom-in & highlight selected spool
      !!zoomToPipeElement(!spool)
      handle any
      endhandle
    endif
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      changeSpoolType
--
-- Description: change spool type among SHOP, SITE and FITT
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    MENU       popup menu which used to defined spool type
--    1     R    STRING     dummy string
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changeSpoolType()

  !rowTags = !this.spoolListGrid.getSelectedrowTags()
  if !rowTags.unset() then
    return
  endif

  !getSelectedSpoolType = !this.spoolList.popup.pickedfieldname

  !checkDBWrite    = object COMCHECKDBWRITE()
  !checkDBWrite.showAlert = false

  do !rowTag values !rowTags
    !entry = !this.spoolListGrid.getRow(!rowTag)
    !spoolRef = !entry[2].dbRef()
    handle any
      skip
    endhandle

    skip if (!spoolRef.badRef())

    !oldSpoolType = !spoolRef.pstype
    handle any
      skip
    endhandle

    skip if (!oldSpoolType eq !getSelectedSpoolType)

    if (!checkDBWrite.checkDBWrite(!spoolRef).not()) then
      !this.writeErrorMessage(!spoolRef.name, !checkDBWrite.errorMessage)
      skip
    endif

    !spoolRef.pstype = !getSelectedSpoolType
    !this.spoolListGrid.setCellValue(!rowTag.real(),4,'none')
    !this.spoolListGrid.setCellValue(!rowTag.real(),5,!getSelectedSpoolType)
  enddo

endmethod
-- End of method

-------------------------------------------------------------------
--
-- Method:      gridControl
--
-- Description: get current grouping settings
--
-- Method Type: Procedure
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .gridControl(!gridType is STRING)
  -- get current grouping settings
  if (!gridType eq 'SPOOL_LIST') then
    !selecting  = !this.popupDefault.fieldproperty('selecting','SELECTED')
    !this.spoolListGrid.outlookGroupStyle(!selecting)
  elseif (!gridType eq 'ERROR_LIST') then
    !selecting = !this.popupErrorList.fieldproperty('selecting','SELECTED')
    !this.errorGrid.outlookGroupStyle(!selecting)
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      printDrawing
--
-- Description: print selected drawing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .printDrawing()

  if (!this.spoolListGrid.getSelectedRows().unset()) then
    return
  endif

  !this.errorList.clear()
  !plotFileList = object ARRAY()

  !selectedRowsSize = !this.spoolListGrid.getSelectedRows().size()
  do !i indices !this.spoolListGrid.getSelectedRows()

    !spoolref = !this.spoolListGrid.getSelectedRows()[!i][2].dbRef()
    handle any
      !spoolRef = object DBREF()
    endhandle

    !isValidCondition = !this.isValidStatus(!spoolRef)

    --- this bit is to do with recording the directory and registry where the drawing was created.
    if !isValidCondition then
      -- this code creates a basic filemanager with just the spool and regi names
      !this.fileManager = object PFFILEMANAGER(!spoolRef,!this.txtRegiName.val)
    endif

     !inValidDwgStatus = !this.spoolListGrid.getSelectedRows()[1][4].upCase() inset ('NONE','INCONSISTENT','---')

    if (!spoolRef.badRef() or !inValidDwgStatus or !isValidCondition.not()) then
        -- We don't have a plotfile so we need to deal with it '
      skip
    endif

      if !this.fileManager.plotfile.exists() then
        !plotFileList.append(!this.fileManager.plotfile.string())
      else
        !this.writeErrorMessage(!spoolName, 'Error printing drawing - No picture file')
      endif
  enddo

  using namespace 'Aveva.Pdms.PipeFabrication.PrintPlotFiles'
  !print = object PRINTPLOTFILES()
  !print.printFileList(!plotFileList)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      showProcessResult
--
-- Description: show progress result briefly
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    REAL        maximum progress size
--    1     R    STRING      prefix string for success case.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showProcessResult(!totalSize is REAL, !successMessage is STRING)

  !failed  = !this.errorList.size()
  !success = !totalSize - !failed

  !summary = |Total Count : | & '$!totalSize' & | , $!successMessage :| & '$!success' & | , Failed : | & '$!failed'
  !!alert.message(!summary)
endmethod
------------------------------------------------------------------------
--
-- Method:      spoolListRightClick
--
-- Description: Pop-up callback for spool list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    ARRAY       array for popup
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .spoolListRightClick(!args is ARRAY)
  !this.spoolList.showPopup(!args[0], !args[1])
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      spoolListRightClick
--
-- Description: Pop-up callback for spool list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    ARRAY       array for popup
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .errorListRightClick(!args is ARRAY)
  !this.errorListControl.showPopup(!args[0], !args[1])
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      selectSpoolListGrid
--
-- Description: select callback for spool list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    ARRAY      dummy array
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .selectSpoolListGrid(!passedArray is ARRAY)
  if(!passedArray.unset()) then
    return
  endif

  -- show preview spool drawing if current is "spool preview mode".
  !this.showPreviewGadget()
  -- zoom in selected spool if current is "zoom-in spool mode".
  !this.zoomInSelectedSpool()
  -- navigate selected spool on explorer if current is "navigate spool mode".

  if (!this.tglPreviewDrawing.visible) then
    if (!this.tglPreviewDrawing.val.not()) then
      -- navigate selected spool on explorer if current is "navigate spool drawing mode".
      !this.navigateSpoolOnExplorer()
      !this.navigateSpoolDrawingOnExplorer()
    else
      !this.showPreview('SPOOL')
    endif
  else
    !this.navigateSpoolOnExplorer()
  endif

  -- show spool dimension if current is "show spool mode".
  !this.showSpoolDimension()
  -- show preview spool drawing if current is "show preview mode".
  --.PDF

  !this.openDrawing()

  --Check if the selected spool on the form has a drawing
  !currentSpoolInfo = !!pfPipeSpoolDwg.spoolListGrid.getSelectedRows()[1]
  !unuseddrawingStatus = !currentSpoolInfo[4]

  unenhance all
  handle any
  endhandle

  do !entry values !this.spoolListGrid.getSelectedRows()
    !spoolRef = !entry[2].dbRef()
    handle (2,813)
      skip
    endhandle
    skip if (!spoolRef.badRef())

    !this.highlightSpool(!spoolRef)
    handle any
    endhandle
  enddo
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      highlightSpool
--
-- Description: highlight selected spools
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    ARRAY      dummy array
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .highlightSpool(!spoolRef is DBREF)
  !spoolManager    = object PIPESPOOLMANAGER()
  !elements = !spoolManager.getBranchElements(!spoolRef)

  !colour = !!gphcolopt.highlight()

  do !entry values !elements
    if (!entry.type eq 'BRAN') then
      ENHANCE TOTAL HEAD TUBE OF $!<entry> COLOUR $!<colour.code>
      handle ANY
      endhandle
    else
      ENHANCE $!<entry> COLOUR $!<colour.code>
      handle ANY
      endhandle

      ENHANCE TOTAL ARRIVE TUBE OF $!<entry> COLOUR $!<colour.code>
      handle ANY
      endhandle

      ENHANCE TOTAL LEAVE TUBE OF $!<entry> COLOUR $!<colour.code>
      handle ANY
      endhandle
    endif
  enddo
endmethod
------------------------------------------------------------------------
--
-- Method:      showPreview
--
-- Description: show preview for spool drawing or drawing template
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     preview type ( Spool , Drawing Template )
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showPreview(!gridType is STRING)
  -- show spool drawing

  if (!gridType eq 'SPOOL') then
    -- if there is nothing to draw - return
    if (!this.spoolListGrid.getSelectedRows().unset() OR !this.previewFlag.not()) then
      return
    endif
    !this.showSpoolDrawing()
  else
    -- we are showing a drawing template on the Drawing Options Tab
    !this.showDrawingTemplate()
  endif

endmethod
-- End of method
------------------------------------------------------------------------
--
-- Method:      .showSpoolDrawing()
--
-- Description: Show spool drawing Preview
--
------------------------------------------------------------------------
define method .showSpoolDrawing()


    -- Get data from the UDAs of the Pipe Spool
    !spoolRef  = !this.spoolListGrid.getSelectedRows()[1][2].dbRef()
    handle any
      !spoolRef = object DBREF()
    endhandle

    !isValidCondition = !this.isValidStatus(!spoolRef)


    --- this bit is to do with recording the directory and registry where the drawing was created.
    if !isValidCondition then
      -- this code creates a basic filemanager with just the spool and regi names
      !this.fileManager = object PFFILEMANAGER(!spoolRef,!this.txtRegiName.val)
    else
       !description = !this.spoolListGrid.getSelectedRows()[1][2]
       !!alert.error('Spool ' & !description & 'is invalid and cannot be previewed')
       return
    endif

    !isValidDwgStatus = !this.spoolListGrid.getSelectedRows()[1][4].upCase() inset ('NONE','INCONSISTENT','---')

    if (!spoolRef.badRef() or !isValidDwgStatus or !isValidCondition.not()) then
        -- We don't have a plotfile so we need to deal with it '
      return
    endif

    if(!!module().productfamily.upCase() eq 'MARINE') then
      if !this.fileManager.plotfile.exists() then
        !this.displayImage(!this.fileManager.plotfile)
      else
        !!alert.message('Cannot find plot file $!this.fileManager.plotfile')
      endif
    else
     if !this.fileManager.plotfile.exists() then
       !this.fileManager.createPreviewfile()
       !this.displayImage(!this.fileManager.previewfile)
     else
       !!alert.message('Cannot find plot file $!this.fileManager.plotfile')
     endif
    endif

endmethod

------------------------------------------------------------------------
--
-- Method:      .displayImage()
--
-- Description: display the passed file
--
------------------------------------------------------------------------
   define method .displayImage(!file is FILE)

      if !file.string().match('.tiff').gt(0) then
         -- show the file in the preview
         !!pfPlotPreview.showPlot('$!file')
         handle any
         endhandle
      else
         --display the file in ACROBAT
         syscom 'Start ""  "$!file" /A toolbar=0&statusbar=0&view=Fit  &'
      endif

   endmethod

------------------------------------------------------------------------
--
-- Method:      showDrawingTemplate()
--
-- Description: Show drawing template Preview on this form
--
------------------------------------------------------------------------
define method .showDrawingTemplate()

  if (!this.cboDrawingTypes.displayText().empty()) then
      return
  endif

    -- template drawing preview
    !templateDrwgName = !this.cboDrawingTypes.displayText().after('TMP/').replace('/','_')
    !templateDrwgName = !!generateFileName(!templateDrwgName)
    !plotFilePath = |%pdmsdflts%\pipesketch\| & !templateDrwgName  & '.plt'
    !this.vwTmplPreview.add(|/$!plotFilePath|)
    handle any
      !this.vwTmplPreview.add(|%pdmsdflts%\pipesketch\noPiece.plt|)
      handle any
      endhandle
    endhandle

  endmethod

------------------------------------------------------------------------
--
-- Method:      populateSpoolList
--
-- Description: Update the list of spools
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .populateSpoolList()


  -- Headings
  !header  = 'Pipe,Spool,Fab Check Status,Drwg.Status,Spool Type'
  !headings = !header.split(',')

  !widths = '150,80,80'
  !initWidths = !widths.split(',')

  -- Build tables
  !table        = !this.getSpoolList()

  -- Load grid
  using namespace 'Aveva.Pdms.Presentation'
  !nds          = object NETDATASOURCE('Pipe Spool Result', !headings, !table)
  !this.spoolListGrid.bindToDataSource(!nds)

  -- Set Columns widths
  do !i indices !initWidths
    !this.spoolListGrid.setColumnWidth(!i + 2, !initWidths[!i].real())
  enddo

  -- tidy up the display
  !this.spoolListGrid.autoFitColumns()

  !this.updateGridIcons()
endmethod
-- End of method

define method .updateGridIcons()
 -- get icons
  !valid        = !!pml.getPathname('greenball12.png')
  !failed       = !!pml.getPathname('redball12.png')

  !rows = !this.spoolListGrid.getRows()

  do !rowIndex indices !rows
    if (!rows[!rowIndex][3].upCase() eq 'VALID') then
      !this.spoolListGrid.setCellImage(!rowIndex,3,!valid)
    else
      !this.spoolListGrid.setCellImage(!rowIndex,3,!failed)
    endif
  enddo
endmethod

-----------------------------------------------------------------------
--
-- Method:      populateErrorList
--
-- Description: Update the error list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .populateErrorList()
  -- Headings
  !header  = split('Element Description')

  -- Build tables
  !table = ARRAY()
  do !c indices !this.errorList
    !table[!c] = !this.errorList[!c].split('@')
  enddo

  -- Load grid
  using namespace 'Aveva.Pdms.Presentation'
  !nds          = object NETDATASOURCE('Error Result', !header, !table)
  !this.errorGrid.bindToDataSource(!nds)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      changeDrawingTemplate
--
-- Description: change drawing template
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    GADGET      gadget for iso drawing template or drawing type
--    2     R    STRING      dummy string
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .changeDrawingTemplate(!gadget is GADGET, !dummyAction is STRING)

  if (!gadget eq !this.cboTmplsList) then
    -- change template registry
    !templateRegi = !this.cboTmplsList.displayText().trim()

    var !templateDrwgList eval name for all DRWG for $!templateRegi
    !this.cboDrawingTypes.dText = !templateDrwgList
  endif
    !dwgRef = !this.cboDrawingTypes.displayText().dbRef()
    handle any
    elsehandle none
      !dwgFunc = !dwgRef.func
      if (!dwgFunc.upCase().occurs('2D SKETCH') gt 0) then
        !this.paraIsoType.val = '>> Drawing Type : 2D sketch'
      else
        !this.paraIsoType.val = '>> Drawing Type : Iso sketch'
      endif
    endhandle

  !this.showPreview('TMPL')

endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      setResultPltFilePath
--
-- Description: set result path which used to be created the result picture file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setResultPltFilePath()
  using namespace 'Aveva.Pdms.Presentation'

  -- Initialise variables
  !folderBrowser = object PMLFOLDERBROWSER()

  -- Show the folder browser
  !folderBrowser.show('Select Output Folder',true)
  !path = !folderBrowser.selectedPath()
  if !path.empty() then
    return
  endif

  -- Use the selected folder
  !this.txtResultIsoPath.val = !folderBrowser.selectedPath()
  handle any
    !!alert.message('Cancel selecting output folder')
  endhandle
endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      setResultPltFilePath
--
-- Description: set result path which used to be created the result picture file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setNamingRuleFilePath()
  using Namespace 'Aveva.Pdms.Presentation'
  !browser = object PMLFILEBROWSER('OPEN')

  --default to first location from PDMSUSER evar
  !directory = !!evarSplit('pmllib')[1] & |pipefabricationmanager\draft\functions\|

  !title = 'Assign Naming Rule File'

  !existFlag = false
  !filter = 'Default File (*.pmldat)|*.pmldat'
  !filterIndex = 2

  --show Browser
  !browser.show(!directory, '', !title, !existFlag, !filter, !filterIndex)
  handle (1000,0)
    !!alert.message('Cancel definition')
  endhandle

  if (!browser.file().empty()) then
    return
  endif

  !file = object FILE(!browser.file())
  if (!file.exists().not()) then
    !!alert.message('The file does not exist')
    return
  endif

  !this.txtNamingRulePath.val =  !browser.file()
endmethod
-- End of method

-----------------------------------------------------------------------
--
-- Method:      setIsoOptionFIle
--
-- Description: set iso option file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setIsoOptionFIle()
  using namespace 'Aveva.Pdms.Presentation'

  -- Initialise variables
  !fileBrowser = object PMLFILEBROWSER('OPEN')

  var !projCode proj code
  !homeDir = |%|& !projCode & |iso%\STD\|

  !fileBrowser.show(!homeDir, '', 'Set Iso Option File', false, 'dat files (*.pmldat)|*.pmldat', 1)

  if (!fileBrowser.file().empty()) then
      return
  endif

  -- read iso option file
  !this.drawingDefaultFile = object FILE(!fileBrowser.file())
  --!this.txtIsoOptPath.val = !fileBrowser.file()
  !this.loadDrawingDefaultFile(true)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      loadIsoOptionFile
--
-- Description: load iso option file
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .loadDrawingDefaultFile(!loadAllData is BOOLEAN)
  if (!this.drawingDefaultFile.unset()) then
    return
  endif

  if !this.drawingDefaultFile.exists().not() then
--     !!appdesmain.createPipeSpoolDwg.active = FALSE
--     handle ANY
--     endhandle
--     return error  4 'Cannot find option file "pfPipeSpool.pmldat" - Please contact your System Administrator'
    return
  endif

  !readData = !this.drawingDefaultFile.readFile()
  handle ANY
    write |$!!error.text|
    return
  endhandle

  !this.isoOptionContents.clear()

  !otherOptions = object ARRAY()

  do !data values !readData
    !contents = !data.split(',')

    if (!contents[1].upCase().trim() eq 'ISOMARGIN') then
      !this.isoOptionContents[1] = !data

    elseif (!contents[1].upCase().trim() eq 'ISOCHARCHEIGHT') then
      !this.isoOptionContents[2] = !data
    elseif (!contents[1].upCase().trim() eq 'ISOVIEWTYPE') then
      !this.isoOptionContents[3] = !data
    else
      !otherOptions.append(!data)
    endif
  enddo

  if (!loadAllData.not()) then
    return
  endif

  !tmpDrwgType = ''
  do !data values !otherOptions

    !contents = !data.split(',')

    -- load option for creating iso picture file
    if (!contents[1].upCase().occurs('DWGTYPE') gt 0) then
      !tmpDrwgType = !contents[2]

    elseif (!contents[1].upCase().occurs('ISOTMPLPATH') gt 0) then
      -- populate template list on combo box gadget
      !this.publishDwgOptionGadgetContents(!this.cboTmplsList, !contents[2])

      !checkElem = !contents[2].dbRef()
      handle any
        !this.writeErrorMessage(!contents[2], 'Error loading iso Option file - Iso template path is wrong')
      elsehandle none
        if (!checkElem.badRef().not()) then
          var !templateDrwgList eval name for all DRWG for $!contents[2]
          !this.cboDrawingTypes.dText = !templateDrwgList
        endif
      endhandle

    elseif (!contents[1].upCase().occurs('ISOFILEPATH') gt 0) then
      !this.txtResultIsoPath.val = !this.filemanager.removeTrailingBackslash(!contents[2])
    elseif (!contents[1].upCase().occurs('DWGDEPTNAME') gt 0) then
      !this.txtDeptName.val = !contents[2]

    elseif (!contents[1].upCase().occurs('DWGREGINAME') gt 0) then
      !this.txtRegiName.val = !contents[2]

    elseif (!contents[1].upCase().occurs('USEMARENV') gt 0 ) then
      if (!this.tglUseMarineEnv.active) then
        !this.tglUseMarineEnv.val = !contents[2].boolean()
      endif
    elseif (!contents[1].upCase().occurs('NAMINGRULE') gt 0 ) then
      !this.txtNamingRulePath.val = !contents[2]
    endif
  enddo

  !this.publishDwgOptionGadgetContents(!this.cboDrawingTypes, !tmpDrwgType)
  !this.showPreview('TMPL')

  if (!this.cboDrawingTypes.dText.unset()) then
    return
  endif

  !dwgRef = !this.cboDrawingTypes.displayText().dbRef()
  handle any
  elsehandle none
    !dwgFunc = !dwgRef.func
    if (!dwgFunc.upCase().occurs('2D SKETCH') gt 0) then
      !this.paraIsoType.val = '>> Drawing Type : 2D sketch'
    else
      !this.paraIsoType.val = '>> Drawing Type : ISO sketch'
    endif
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      publishDwgOptionGadgetContents
--
-- Description: populate template list on combo box gadget
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    GADGET     garget for iso drawing template or drawing type
--    2     R    STRING     dummy string
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .publishDwgOptionGadgetContents(!gadget is GADGET, !findStr is STRING)
  !index = !gadget.dText.find(!findStr)
  if (!index.unset()) then
    return
  endif

  !gadget.val = !index[1]
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkNamingRulePath
--
-- Description: check naming rule path
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    STRING     return to check result
------------------------------------------------------------------------
define method .checkNamingRulePath() is BOOLEAN
  if (!this.txtNamingRulePath.val.empty()) then
    if (!this.namingErrorHappened.not()) then
      !!alert.error(|Error Creating Spool Drawing - Need to define Naming Rule Definition File|)
      !this.txtNamingRulePath.setFocus()
      !this.namingErrorHappened = true
    endif
    return false
  elseif (!this.txtNamingRulePath.val.empty().not()) then
    !tempFile = object FILE(!this.txtNamingRulePath.val)
    handle any
      if (!this.namingErrorHappened.not()) then
        !!alert.error(|Error Creating Spool Drawing - Invalid path|)
        !this.txtNamingRulePath.setFocus()
        !this.namingErrorHappened = true
      endif
      return false
    elsehandle none
      if (!tempFile.exists().not()) then
        if (!this.namingErrorHappened.not()) then
          !!alert.error(|Error Creating Spool Drawing - The default file for naming rule does not exist |)
          !this.txtNamingRulePath.setFocus()
          !this.namingErrorHappened = true
        endif
        return false
      endif
    endhandle
  endif

  return true
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setPipeSketchOptions
--
-- Description: set pipe sketch options
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    1     R    BOOLEAN    return defining result about pipe sketch option
--
------------------------------------------------------------------------
define method .setPipeSketchOptions() is BOOLEAN
  -- check input values
  if (!this.cboDrawingTypes.displayText().unset() or !this.cboDrawingTypes.displayText() eq '') then
    !!alert.error('Error Creating Spool Drawing - Need to define drawing type.')
    return false
  endif

  if (!this.tglUseMarineEnv.val.not()) then
    if (!this.txtDeptName.unset() or !this.txtDeptName.val.empty()) then
      !!alert.error('Error Creating Spool Drawing - Need to define department name')
      return false
    endif

    if (!this.txtRegiName.unset() or !this.txtRegiName.val.empty()) then
      !!alert.error('Error Creating Spool Drawing - Need to define registry name')
      return false
    endif
  endif

  if (!this.checkNamingRulePath().not()) then
    return false
  endif

  !this.loadDrawingDefaultFile(false)

  !dwgDeptName = !this.txtDeptName.val
  !dwgRegiName = !this.txtRegiName.val

  if (!dwgDeptName eq !dwgRegiName) then
    !!alert.message('The DEPT name have to different with REGI name')
    return false
  endif

  !dwgTypeName    = !this.cboDrawingTypes.displayText()
  !dwgTmplPath    = !this.cboTmplsList.displayText()

  -- check drawing template
  !dwgTemplRef = !dwgTypeName.dbRef()
  handle any
    !dwgTemplRef = object DBREF()
  endhandle

  if (!dwgTemplRef.badRef()) then
    !!alert.message('Invalid Drawing Type')
    return false
  endif

  !isoMargin      = ''
  !isoCharCheight = ''
  !isoViewType    = ''

  if (!this.isoOptionContents.set()) then
    do !val values !this.isoOptionContents

      if (!val.upCase().occurs('ISOMARGIN') gt 0) then
        !isoMargin      = !val.after('isoMargin,')

      elseif (!val.upCase().occurs('ISOCHARCHEIGHT') gt 0) then
        !isoCharCheight = !val.after('isoCharCheight,')

      elseif (!val.upCase().occurs('ISOVIEWTYPE') gt 0) then
        !isoViewType = !val.after('isoViewType,')
      endif
    enddo
  endif

  !isoResultPath  = !this.txtResultIsoPath.val

  !this.drawingDefaultFile.open('OVER')
  handle any
    !!alert.error('Error Saving Default File')
    return false
  endhandle

  if !!isImperialLength('DIST') then
    !outputUnit = 'IMPERIAL'
  else
    !outputUnit = 'METRIC'
  endif

  if(!!module().productfamily.upCase() eq 'MARINE') then
    !useMarineEnv = !this.tglUseMarineEnv.val

    !marDbName = !this.drawingTypeList.rText[!this.drawingTypeList.val]
    !result = !this.marDrawingTypeData.getPaddData(!marDbName)

    if (!result.set()) then
      !marEnvDept = !result[1]
      !marEnvRegi = !result[2]
    else
      !marEnvDept = ''
      !marEnvRegi = ''
    endif
  endif

  !this.drawingDefaultFile.writeRecord('DwgType,$!dwgTypeName')
  !this.drawingDefaultFile.writeRecord('DwgDeptName,$!dwgDeptName')
  !this.drawingDefaultFile.writeRecord('DwgRegiName,$!dwgRegiName')
  !this.drawingDefaultFile.writeRecord('isoTmplPath,$!dwgTmplPath')
  !this.drawingDefaultFile.writeRecord('isoViewType,$!isoViewType')
  !this.drawingDefaultFile.writeRecord('isoMargin,$!isoMargin')
  !this.drawingDefaultFile.writeRecord('isoCharCheight,$!isoCharCheight')
  !this.drawingDefaultFile.writeRecord('isoFilePath,$!isoResultPath')
  !this.drawingDefaultFile.writeRecord('outputUnits,$!outputUnit')
  if(!!module().productfamily.upCase() eq 'MARINE') then
    !this.drawingDefaultFile.writeRecord('UseMarEnv,$!useMarineEnv')
    !this.drawingDefaultFile.writeRecord('MarEnvDept,$!marEnvDept')
    !this.drawingDefaultFile.writeRecord('MarEnvRegi,$!marEnvRegi')
  endif

  !namingRuleDefFilePath = !this.txtNamingRulePath.val
  !this.drawingDefaultFile.writeRecord('NamingRule,$!namingRuleDefFilePath')

  -- calculate isomargin and view size
  !olayRefVnote = !!collectAllFor('VNOT',|purp of owner eq 'OLAY'|, !dwgTemplRef)

  if (!olayRefVnote.set()) then
    !olayRefRect = !!collectAllFor('RECT','', !olayRefVnote[1])

    if (!olayRefRect.set()) then
      !sheeSize = size of shee of $!olayRefRect[1]
      !isoSize = |W $!<sheeSize[1]> H $!<sheeSize[2]>|

      !xypos = xypos of ptrf of $!olayRefRect[1]

      !xlen  = xlen of $!olayRefRect[1]
      !ylen  = ylen of $!olayRefRect[1]

      !xmin  = !xypos.east - ( !xlen / 2 )
      !xmax  = !xypos.east + ( !xlen / 2 )

      !ymin  = !xypos.north - ( !ylen / 2 )
      !ymax  = !xypos.north + ( !ylen / 2 )

      -- calculation iso margin and size
      !isoMargin1 = object STRING(!xmin)
      !isoMargin2 = object STRING(!sheeSize[1] - !xmax)
      !isoMargin3 = object STRING(!sheeSize[2] - !ymax)
      !isoMargin4 = object STRING(!ymin)
      --- if the template is using an iso these extra lines need to be written to define where to put the iso
      !this.drawingDefaultFile.writeRecord('isoSize,$!isoSize')
      !this.drawingDefaultFile.writeRecord('isoMargin1,$!isoMargin1')
      !this.drawingDefaultFile.writeRecord('isoMargin2,$!isoMargin2')
      !this.drawingDefaultFile.writeRecord('isoMargin3,$!isoMargin3')
      !this.drawingDefaultFile.writeRecord('isoMargin4,$!isoMargin4')
    endif
  endif

  !this.drawingDefaultFile.close()

  if (!this.isDwgOptionMode) then
    !!alert.message(|Option file saved|)
  endif

  -- reset the fileManager
  !this.fileManager = object PFFILEMANAGER(!dwgRegiName ,!dwgDeptName)

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getSpoolList
--
-- Description: get spool list
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    1     R    ARRAY      return collected spool list
--
------------------------------------------------------------------------
define method .getSpoolList() is ARRAY
  !spoolData = object ARRAY()

  if (!this.selectErrorHappned.not()) then
    !element = !this.element
    if (!element.badRef()) then
      !!alert.message('Selected Item has bad reference')
      return !spoolData
    endif

    if (!element.type eq 'WORL') then
      return !spoolData
    endif

    if (!!module().modKey.upCase() inset ('MARODES','DES')) then
      getwork
    endif

    !this.namingErrorHappened = false

    -- define base element which used to collect pipe element
    !baseRef = object DBREF()

    if (!element.type eq 'PIPE') then
      !baseRef = !element
    elseif (!element.ahlist.findFirst('PIPE').set()) then
      !baseRef = !element.ownlst[!element.ahlist.find('PIPE')[1]]

    elseif (!element.type eq 'ZONE') then
      !baseRef = !element

    elseif (!element.type eq 'GPSET') then
      !baseRef = !element

    elseif (!element.ahlist.findFirst('ZONE').set()) then
      !baseRef = !element.ownlst[!element.ahlist.find('ZONE')[1]]

    elseif (!element.type eq 'SITE') then
      !baseRef = !element

    elseif (!element.ahlist.findFirst('SITE').set()) then
      !baseRef = !element.ownlst[!element.ahlist.find('SITE')[1]]

    else
      !!alert.error('Error Creating Spool Drawing -  Select pipe elements')
      return !spoolData
    endif

    if (!baseRef.badRef()) then
      return !spoolData
    endif

    if (!baseRef.hardType eq 'GPSET') then
      !collectElements = '( PIPE PSPOOL )'
    else
      !collectElements = ' PIPE '
    endif

    var !pipeList coll all $!<collectElements> for $!baseRef

  --  --var !pipeList coll all PIPE for $!baseRef
    if (!pipeList.unset()) then
      --!!alert.message('Cannot find pipes from ' & !baseRef.name)
      return !spoolData
    endif

    !this.existList.appendArray(!pipeList)
    !this.existList.unique()
  endif

  if (!this.existList.unset()) then
    return object ARRAY()
  endif

  !checkDBWrite    = object COMCHECKDBWRITE()
  !checkDBWrite.showAlert = false

  -- define spool data
  !spoolData = object ARRAY()

  !spoolRefList = object ARRAY()

--  !partNoCheckObj = object PFPARTNO()

  do !pipeRef values !this.existList
    !checkRef = object DBREF(!pipeRef)
    handle any
      !badRef = true
    elsehandle none
      !badRef = !checkRef.badRef()
    endhandle

    skip if (!badRef)

    var !spoolList coll all PSPOOL for $!pipeRef

    if (!spoolList.unset()) then
      !table = object ARRAY()

      -- initialize spool data
      !entry = !pipeRef.dbRef()
      !table.append(!entry.fullname)
      !table.append('(none)')
      !table.append('---')
      !table.append('---')
      !table.append('---')

      !checkString = !entry.fullname & ' ' & !table[2]
      skip if (!this.removedList.findFirst(!checkString).set())

      !spoolData.append(!table)
    else
      do !i indices !spoolList

        !table    = object ARRAY()

        !entry    = !spoolList[!i].dbRef()

        !table.append(!entry.ownlst[3].fullname)
        !table.append(!entry.fullname)

        !checkString = !entry.ownlst[3].fullname & ' ' & !entry.fullname

        skip if (!spoolRefList.findFirst(!entry).set())
        skip if (!this.removedList.findFirst(!checkString).set())

        !spoolRefList.append(!entry)

        -- check production status
        !pipePieces   = !entry.pprfa
        --!pipePieces = !spoolManager.getPipePieces(!entry)

        !checkValid = false
        if (!pipePieces.set()) then
          !checkValid = !entry.psvld
          do !pieceRef values !pipePieces
            --!checkValid = !fabManager.validatePipePiece(!pieceRe
            !checkValid = !pieceRef.ppmodi.not()
            if (!checkValid.not()) then
              break
            endif
          enddo
        else
          !checkValid = true
        endif

          if (!checkValid) then
            !table.append('valid')
          else
            !table.append('Needs to be Released')
            --!this.writeErrorMessage(!entry.name, 'Error creating spool drawing - failure of production check')
          endif

          if (!this.checkNamingRulePath().not() or !checkValid.not()) then
            !table.append('none')
          else
            !drwgName =  !!pfEvaluateSketchName(!this.txtNamingRulePath.val, !entry, !this.errorList) & '/S1'
            handle any
              !table.append('none')
            elsehandle none
              --!drwgName = !entry.fullname & '_Spool/S1'
              var !checkdwg exist $!drwgName
              handle (47,15)
                !checkdwg = 'FALSE'
              endhandle

              !regiName = !drwgName.dbRef().owner.owner.namn
              handle any
                !regiName = ''
              endhandle

              if (!checkdwg eq 'TRUEA') then
                !drawingLastModifiedDate = object DATETIME(lastm of $!drwgName )
                !modifySpoolFlag = false
                do !pieceRef values !pipePieces
                  !pieceModifiedDate = object DATETIME(!pieceRef.lastm)
                  if (!pieceModifiedDate.gt(!drawingLastModifiedDate)) then
                    !modifySpoolFlag = true
                    break
                  endif
                enddo

                if (!modifySpoolFlag) then
                  !table.append('inconsistent')
                else
                  !firstMember = object DBREF()
                  !viewList = !!collectAllFor('VIEW', '', !drwgName.dbRef())
                  handle any
                  elsehandle none
                    do !viewRef values !viewList
                      !firstMember = !viewRef.idlname.members[1].idname
                      handle any
                      elsehandle none
                        break
                      endhandle
                    enddo
                  endhandle

                  if (!firstMember.badRef()) then
                    !table.append('none')
                  else
                    -- get the filename information
                    !this.fileManager = object PFFILEMANAGER(!entry,!regiName)
                    !table.append(!this.fileManager.getSpoolFileData(!entry,!regiName))
                  endif
                endif

              else
                !table.append('none')
              endif
            endhandle
          endif

        -- spool type
        if (!entry.pstyp.empty()) then
          !table.append('SHOP')
        else
          !table.append(!entry.pstyp)
        endif
        !spoolData.append(!table)
      enddo
    endif
  enddo

  !this.populateErrorList()
  return !spoolData
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkElement
--
-- Description: check selected element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    ARRAY       selected element on spool list grid
-- Return:
--   [Data Type] [Description]
--    1     R    BOOLEAN     return result which element is valid or not
--
------------------------------------------------------------------------
define method .checkElement(!selectedElement is ARRAY) is BOOLEAN
  !pipeRef  = !selectedElement[1].dbRef()
  handle any
    !this.writeErrorMessage(!selectedElement[1], 'Error creating spool drawing - Invalid Reference.')
    return false
  elsehandle none
    !result = !!pipeValidDataCheck(!pipeRef.ref.string())
    if (!result eq false) then
      !this.writeErrorMessage(!selectedElement[1], 'Error creating spool drawing - Failure of validation check ')
    endif
    return !result
  endhandle

  -- check element is valid or not
  if (!pipeRef.badRef()) then
    !this.writeErrorMessage(!selectedElements[1], 'Error creating spool drawing - Invalid Reference.')
    return false
  endif

  -- check db write rights
  if (!pipeRef.dbwrite.not()) then
    !this.writeErrorMessage(!selectedElements[!i][1], 'Error creating spool drawing - Cannot modify.')
    return false
  endif

  return true
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      spoolUpdate
--
-- Description: spool update
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING       action type ('DELETE', 'CREATE/UPDATE')
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .spoolUpdate(!type is STRING)
  if (!this.spoolListGrid.getSelectedRows().unset()) then
    return
  endif

  !mem = !this.paraCE.val.dbRef()
  handle any
    !mem = object DBREF()
  endhandle

  !selectedElements = !this.spoolListGrid.getSelectedRows()

  !pipeList  = object ARRAY()

  -- clear error list
  !this.spoolManager.errorMessage.clear()
  !this.errorList.clear()

  !maxProgress  = !selectedElements.size()
  !count   = 0

  !checkNaviSpool = !this.spoolList.popup.selected('Navigate Spool on Explorer')
  if (!checkNaviSpool) then
    !this.spoolList.popup.select('Navigate Spool on Explorer',false)
  endif

  if (!type eq 'DEL') then
    -- delete selected spool
    !confirmDelete = true

    !checkNaviSpool = !this.spoolList.popup.selected('Navigate Spool on Explorer')

    do !i indices !selectedElements
      !spoolRef = !selectedElements[!i][2].dbRef()
      handle any
       !this.writeErrorMessage(!selectedElements[!i][2], 'Error deleting selected spool - Invalid Reference.')
        skip
      endhandle

      skip if (undefined(!spoolRef))

      if (!this.checkClaimStatus(!spoolRef).not()) then
        skip
      endif

      if (!confirmDelete) then
        if (!!alert.confirm('Are you sure you want to delete all spool data on current element?') neq 'YES') then
        return
        endif
      endif

      !confirmDelete = false

      -- delete reference plot file
      if (!this.txtResultIsoPath.val.set()) then
        !regiName = substring(!this.txtRegiName.val,2)
        !delFiles = !this.txtResultIsoPath.val & |\| & !regiName & |\| & !spoolRef.namn & |*|
        syscom |del $!delFiles|
        handle any
          !this.writeErrorMessage(!selectedElements[!i][2], 'Error deleting spool drawing - Wrong path for result plot file')
        endhandle
      endif

      -- delete selected spool
      !this.spoolManager.deleteSpool(!spoolRef)
      handle any
        !this.writeErrorMessage(!selectedElements[!i][2], 'Error deleting spool drawing - Cannot modify.')
        skip
      endhandle

      !count = !count + 1
    enddo

    !this.showPreview('SPOOL')
    handle any
    endhandle
  else
    --!mem = !!ce
    do !i indices !selectedElements
      -- show progress
      !!displayProgress(!i, !maxProgress)
      if (!this.checkElement(!selectedElements[!i]).not()) then
        !count = !count + 1
        skip
      endif

      !pipeRef  = !selectedElements[!i][1].dbRef()

      if (!this.checkClaimStatus(!pipeRef).not()) then
        !count = !count + 1
        skip
      endif

      !spoolRef = !selectedElements[!i][2].dbRef()
      handle any
      endhandle

      if (!pipeList.findFirst(!pipeRef).set()) then
        skip
      endif

      !pipeList.append(!pipeRef)

      !!ce = !pipeRef

      -- update selected spool
      !this.spoolManager.makeSpool(!type, !pipeRef)

      if (!this.spoolManager.errorMessage.set()) then
        !count = !count + 1
        !this.writeErrorMessage(!this.spoolManager.errorMessage.last()[1],!this.spoolManager.errorMessage.last()[2])
        skip
      endif

      !count = !count + 1
    enddo

  endif

  if (!mem.badRef().not()) then
   !!ce = !mem
  endif

  !this.populateSpoolList()
  if (!count gt 0) then
    !this.showProcessResult(!selectedElements.size(), 'Checked')
  endif
  if (!checkNaviSpool) then
    !this.spoolList.popup.select('Navigate Spool on Explorer',true)
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      writeErrorMessage
--
-- Description: write error message
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     element name
--    2     R    STRING     error contents
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .writeErrorMessage(!element is STRING, !message is STRING)

  !dataType = !element.objectType()
  if !dataType.eq('DBREF') then
    if !element.isNamed then
      !name = !element.name
    else
      !name = !element.namtyp
    endif
  elseif !dataType.eq('STRING') then
    !name = !element
  elseif !dataType.eq('FILE') then
    !name = !element.string()
  endif
  !this.errorList.append(!name & '@'  & !message)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createDrawing
--
-- Description: create drawing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createDrawing()

  -- tracing can be enabled as follows
  var !spooldebug evar 'TRACE_SPOOLDRAWINGS'
  if !spooldebug.neq('') then
    $r101/c:\temp\pfPipeSpoolDwg.createDrawing.pmldat
  endif

  -- turn the preview flag off to stop getting multiple views
  !this.spoolList.popup.select('Preview Drawing',false)
  handle any
  endhandle
  !this.previewFlag = FALSE
  !this.tglPreviewPlot.val = false

  !doneFile = object FILE('$!this.pdmsUserPath\spooldwgdone.log')
  !doneFile.open('OVER')
  handle any
    !!alert.error(!!error.text)
    return
  endhandle

  !doneFile.writeRecord('IN-PROGRESS')
  !doneFile.close()

  if (!this.spoolListGrid.getSelectedRows().unset()) then
    !!alert.message('Select item(s) to create spool drawing')
    return
  endif

  !this.errorList.clear()

  -- set pipe sketch options
  if (!this.setPipeSketchOptions().not()) then
    return
  endif

  -- get selections from spool grid
  !selections  = !this.spoolListGrid.getSelectedRows()
  !spoolList  = object ARRAY()
  do !i indices !selections
    skip if (!selections[!i][3].upCase() ne 'VALID')
    !spoolList.append(!selections[!i][2].dbRef())
    handle (2,113)(2,109)
    endhandle
  enddo

--  if (!this.checkIsoOptionFileExist().not()) then
--    return
--  endif

  if (!spoolList.unset()) then
    !!alert.error('Error Creating Spool Drawing -  Check Prod.Stat.')
    return
  endif

  -- Get the Registry and Directory
  !registryName  = substring(!this.txtRegiName.val,2)
  !directoryName = object FILE(!this.txtResultIsoPath.val)
  !directoryFullName = !directoryName.fullname()
  handle ANY
    !!alert.error('Invalid directory name ' & !this.txtResultIsoPath.val )
    return
  endhandle

  -- get the basic file names
  !this.fileManager = object PFFILEMANAGER(!registryName, !this.txtResultIsoPath.val)


  -- Store Data for the Sketch Registry and Plot Storage Directory on the Pipe Spool itself
  !pipeList = object ARRAY()
  do !i indices !spoolList
    !spoolList[!i].attribute(':SKTCHREGI') = !registryName
    handle ANY
      skip
    endhandle
    !spoolList[!i].attribute(':SKTCHDIR')  = !directoryFullName
    handle ANY
    elsehandle none
      !pipeRef = pipe of $!spoolList[$!i]
      skip if (!pipeList.findFirst(!pipeRef).set())
      !pipeList.append(!pipeRef)
    endhandle
  enddo

--  getwork

  SAVEWORK
  handle any
  elsehandle none
    do !pipeRef values !pipeList
      uncl members of $!<pipeRef>
      handle any
      endhandle
    enddo
  endhandle

  if (!!module().modKey.upCase() eq 'MARDRA') then
    !this.mardradraftingapi.dwgClose()
  endif

  do !c indices !spoolList
    !entry = !spoolList[!c]
    -- Check if drawing exists already, if does not exist skip out of loop
    -- if it does exist check for claimed/locked status and remove from list of spools if locked
    -- also prompt user continue to modify drawing in current location if it exists but a new location (regi/dept) has
    -- been specified
    --!drwgName = !entry.name & '_Spool'
    !drwgName =  !!pfEvaluateSketchName(!this.txtNamingRulePath.val, !entry, !this.errorList) & '/S1'
    !drwgRef  = object DBREF(!drwgName)
    handle any
      skip
    endhandle

    skip if (!drwgRef.badRef())

    !errorFlag = false

    -- if already exists and regi or dept specified different to existing location show alert confirm form
    !existingRegistryName = namn of regi of $!drwgRef
    !existingDeptName     = namn of dept of $!drwgRef

    if !registryName.neq(!existingRegistryName) then
      if !!alert.confirm('Pipe spool drawing for spool $!entry.namn already exists in Dept. $!existingDeptName , Regi. $!existingRegistryName .O.K. to move it to Registry $!registryName ?').eq('NO') then
       !this.writeErrorMessage(!drwgName, 'Pipe spool drawing for spool $!entry.namn already exists in Dept. $!existingDeptName, Regi. $!existingRegistryName, user refused to move it to Registry $!<registryName>.')
        !errorFlag = true
      endif
    endif

    -- see if element is claimed
    if (!drwgRef.lclm) then
      -- see if the current user has claimed it
      var !user user
      if (!user.neq(!drwgRef.userC)) then
        !this.writeErrorMessage(!drwgName, 'Error creating spool drawing - Cannot modify : Claimed by $!user')
        !errorFlag = true
      endif
--      !errorFlag = true
    endif

    if (!drwgRef.lock) then
      !this.writeErrorMessage(!drwgName, 'Error creating spool drawing - Cannot modify : locked')
      !errorFlag = true
    endif

    if !errorFlag then
      !spoolList[!c].delete()
    endif
  enddo

  -- update component info ( including checking loose part)
  -- 1. insert component position with ship coordinates format to :UDA
  -- 2. check loose part using pipe piece element

  !spoolDwg = object PFPIPESPOOLDWG()
--  !spoolDwg.updateSpoolInformation(!spoolList)
  !this.errorList.appendArray(!spoolDwg.errorList)

  if(!!module().productfamily.upCase() eq 'MARINE') then
    !marDbName = !this.drawingTypeList.rText[!this.drawingTypeList.val]
    !result    = !this.marDrawingTypeData.getPaddData(!marDbName)

    !isMarineMode = !this.tglUseMarineEnv.val
    if (!isMarineMode) then
      !spoolDwg.isMarEnvMode = true
      !spoolDwg.deptName = !result[1]
      !spoolDwg.regiName = !result[2]
    else
      !spoolDwg.isMarEnvMode = false
    endif

    if (!!module().modKey.upCase() eq 'MARDRA') then
      if (!isMarineMode) then
        !spoolDwg.marPtype = !this.marPtypes[!this.drawingTypeList.val]
      else
        !spoolDwg.marPtype = 7
      endif
    else
      !spoolDwg.marPtype = -1
    endif
  endif

  if (!this.paraIsoType.val.upCase().occurs('ISO') gt 0) then
      !doneFile.open('READ')

      PROMPT 'Creating ISO View. Please Wait...'

      !!pfPipeMakeIsoView(!spoolList,!this.drawingDefaultFile.fullname(), !this.pdmsUserPath)

      do
        !doneFile.open('READ')
        !stop = !doneFile.readRecord()
        skip if (!stop.neq('DONE'))
          !doneFile.close()
        break
        !doneFile.close()
      enddo

      !creationErrorFile = object FILE('$!this.pdmsUserPath\isocreateerror.dat')
      if (!creationErrorFile.exists()) then
        !isoCreationError = !creationErrorFile.readFile()

        do !errorString values !isoCreationError
          !elementName = !errorString.part(1,'@')
          !errorDesc   = !errorString.part(2,'@')

          !this.writeErrorMessage(!elementName, !errorDesc)
        enddo
        --
      endif

      PROMPT DISMISS
  endif

  !doneFile = object FILE('$!this.pdmsUserPath\spooldwgdone.log')
  !doneFile.open('OVER')
  !doneFile.writeRecord('IN-PROGRESS')
  !doneFile.close()

  -- waiting until overlay drawing finished before making an underlay drawing
--  !created = FALSE

  var !device device
  if (!device.upCase() eq 'GRAPHICS') then
    !isGraphicalMode = true
  else
    !isGraphicalMode = false
  endif

  PROMPT 'Creating Spool Drawings. Please Wait...'
  if (!!module().modKey.upCase() ne 'MARDRA' and !!module().modKey.upCase() ne 'DRA') then
     -- waiting until overlay drawing finished before making an underlay drawing
    do !i from 1 to 50
      pause 0.5

      if (!i eq 1) then
        !!pfPipeMakeSpoolDrwg(!spoolList,!this.drawingDefaultFile.fullname())
        handle any
          !!alert.error('Error creating drawing - ' & !!error.text)
          break
        endhandle
      endif

      !doneFile.open('READ')
      !stopFlag = !doneFile.readRecord()

      break if (!stopFlag eq 'DONE')

    enddo

    !doneFile.close()
  else
    !isoOptionFileName = !this.drawingDefaultFile.fullname()

    !totalSize = !spoolList.size()
    PROMPT 'Creating Spool Drawings. Please Wait...'

    do !i indices !spoolList
      -- make the iso underlay
      !spoolDwg.makeUnderlyingDrwg(!spoolList[!i], !isoOptionFileName)
      if (!isGraphicalMode) then
        !!displayProgress(!i, !totalSize)
      endif
    enddo
  endif

  PROMPT DISMISS

  !this.showPreview('SPOOL')

  -- get errors
  !errorLogFile = !spoolDwg.errorLogFile
  if !errorLogFile.exists() then
    !this.errorList.appendArray(!errorLogFile.readFile())
    !errorLogFile.deleteFile()
  endif

  if !this.errorList.set() then
    !this.frameErrorList.visible = true
  endif

  -- update errors displayed
  !this.populateErrorList()

  -- update spool grid list
  !selected = !this.spoolListGrid.getSelectedrowTags()
  !this.populateSpoolList()
  !this.spoolListGrid.setSelectedrowTags(!selected)

  if (!this.tglPreviewDrawing.val.not()) then
    if (!!module().modKey.upCase() eq 'MARDRA') then
      if (!this.mardradraftingapi.mDraft[1].dwgCurrent()) then
        !this.mardradraftingapi.mDraft[1].dwgSave()
        handle any
          !!alert.message('Failed to save drawing')
          return
        endhandle

        !this.mardradraftingapi.mDraft[1].dwgClose()
      endif
    endif
  endif

  if (!!module().modKey.upCase() eq 'MARDRA') then
    !this.mardradraftingapi.refreshCanvas()
    refresh
  endif


endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkIsoOptionFileExist
--
-- Description: check iso option file existing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--    1     R    BOOLEAN    return the result about iso option file exist or not.
--
------------------------------------------------------------------------
define method .checkIsoOptionFileExist() is BOOLEAN
  return
  !isoOptionFile = object FILE(!this.txtIsoOptPath.val)
  if (!isoOptionFile.exists().not()) then
    !!alert.error('Error loading Iso Option File Drawing - Iso Option file does not exist')
    return false
  endif
  return true
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      checkDrwgElementName
--
-- Description: check dept / regi name for drawing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    STRING     drawing element type for checking (DEPT, REGI)
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkDrwgElementName(!dwgElementType is STRING)
  !mem = !!ce

  if (!dwgElementType eq 'DEPT') then
    if (!this.txtDeptName.val.empty()) then
      !!alert.error('Error Creating Spool Drawing - Need to define department name')
      return
    endif

    if (substring(!this.txtDeptName.val,1,1) ne '/') then
      !this.txtDeptName.val = '/' & !this.txtDeptName.val
    endif

    !checkName = !this.txtDeptName.val
  else
    if (!this.txtRegiName.val.empty()) then
      !!alert.error('Error Creating Spool Drawing - Need to define registry name')
      return
    endif

    !this.txtRegiName.val = !this.transRegiName(!this.txtRegiName.val)

    if (substring(!this.txtRegiName.val,1,1) ne '/') then
      !this.txtRegiName.val = '/' & !this.txtRegiName.val
    endif

    !checkName = !this.txtRegiName.val
  endif

  !element = object DBREF(!checkName)
  handle any
    return
  elsehandle none
    if (!element.badRef()) then
      return
    endif
  endhandle
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      useDesiHierarchy
--
-- Description: use desi hierarchy or not for creating drawing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .useDesiHierarchy()
  !element = !!ce

  !zoneRef = object DBREF()
  !validSelection = true
  if (!element.type ne 'ZONE') then
    if (!element.ahlist.findFirst('ZONE').unset()) then
      if (!element.type eq 'GPSET') then
        !zoneRef = !element
      else
        if (!element.ahlist.findFirst('GPSET').unset()) then
          if (!this.selectErrorHappned.not()) then
            !!alert.message('Select GPSET, ZONE or element below a GPSET or ZONE level!')
            !validSelection = false
            !this.selectErrorHappned = true
          endif
--          return error 1 'Error Initialise Form - Select GPSET, ZONE or element below a GPSET or ZONE level'
        else
          !zoneRef = !element.ownlst[!element.ahlist.find('GPSET')[1]]
        endif
      endif
    endif

    if (!zoneRef.badRef() and !validSelection) then
      !zoneRef = !element.ownlst[!element.ahlist.find('ZONE')[1]]
    endif
  else
    !zoneRef = !element
  endif

  if (!this.spoolListGrid.getRows().unset()) then
    !this.btnCreateDrawing.active    = !validSelection
    !this.btnRefreshSpoolList.active = !validSelection
  endif

  if (!this.tglUseDesiHier.val) then
    !regi = !zoneRef.name & '_REGI'
    !dept = !zoneRef.owner.name & '_DEPT'

    !this.txtDeptName.val = !dept
    !this.txtRegiName.val = !this.transRegiName(!regi)

    !this.checkDrwgElementName('DEPT')
    !this.checkDrwgElementName('REGI')

  else
    !this.txtDeptName.val = ''
    !this.txtRegiName.val = ''
  endif

  !!ce = !element
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      useMarineEnv
--
-- Description: use marine environment
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
--
------------------------------------------------------------------------
define method .useMarineEnv()
  if (!this.tglUseMarineEnv.val.not()) then
    !this.useDesiHierarchy()
  endif

  !marDbName = !this.drawingTypeList.rText[!this.drawingTypeList.val]
  handle any
    return
  endhandle

  !result = !this.marDrawingTypeData.getPaddData(!marDbName)

  !canMappingPaddDataAndDrawingType = !result.unset()
  if (!canMappingPaddDataAndDrawingType) then
--    !this.tglUseMarineEnv.active = !canMappingPaddDataAndDrawingType.not()
--    !this.tglUseMarineEnv.val = !canMappingPaddDataAndDrawingType.not()
  else
    !this.tglUseMarineEnv.active = true
  endif

  !this.txtDeptName.active = !this.tglUseMarineEnv.val.not()
  !this.txtRegiName.active = !this.tglUseMarineEnv.val.not()
  !this.tglUseDesiHier.active = !this.tglUseMarineEnv.val.not()

  if (!this.tglUseMarineEnv.val) then
    !marDbName = !this.drawingTypeList.rText[!this.drawingTypeList.val]
    !result = !this.marDrawingTypeData.getPaddData(!marDbName)
    if (!result.set()) then
      !marEnvDept = !result[1]
      !marEnvRegi = !result[2]
    else
      !marEnvDept = ''
      !marEnvRegi = ''
    endif

    !this.txtDeptName.val = !marEnvDept
    !this.txtRegiName.val = !marEnvRegi
  endif

  !this.drawingTypeList.visible = !this.tglUseMarineEnv.val
--  endif
endmethod

------------------------------------------------------------------------
--
-- Method:      checkClaimStatus
--
-- Description: check claim status
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    1     R    BOOLEAN    return db claim status
--
------------------------------------------------------------------------
define method .checkClaimStatus(!element is DBREF) is BOOLEAN

  !checkDBWrite    = object COMCHECKDBWRITE()
  !checkDBWrite.showAlert = false
  !result = !checkDBWrite.checkDBWrite(!element)

  if (!result.not()) then
    !this.writeErrorMessage(!element.name, 'Error creating spool drawing -' + !checkDBWrite.errorMessage)
  endif

  return !result
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      deleteDrawing
--
-- Description: delete selected drawing
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .deleteDrawing()
  if (!this.spoolListGrid.getSelectedRows().unset()) then
    return
  endif

  !this.errorList.clear()
  !mem = !!ce

  do !entry values !this.spoolListGrid.getSelectedRows()
    !spoolRef = !entry[2].dbRef()
    skip if (!spoolRef.badRef())

    --!drwgName = !spoolRef.fullname & '_Spool'
    !drwgName =  !!pfEvaluateSketchName(!this.txtNamingRulePath.val, !spoolRef, !this.errorList) & '/S1'
    !drwgEntry = object DBREF(!drwgName)
    handle any
      !this.writeErrorMessage(!spoolRef.name, 'Error creating spool drawing - No drawing in DB')
      skip
    elsehandle none
      if (!drwgEntry.badRef()) then
        !this.writeErrorMessage(!spoolRef.name, 'Error creating spool drawing - Invalid Reference.')
        skip
      endif

      if (!drwgEntry.dbwrite.not()) then
        !this.writeErrorMessage(!spoolRef.name, 'Error creating spool drawing - Cannot modify')
        skip
      endif

      !!ce = !drwgEntry
      delete drwg
    endhandle
  enddo

  !!ce = !mem

  !this.showProcessResult(!this.spoolListGrid.getSelectedRows().size(), 'success')
  !this.populateErrorList()
endmethod
-- End of method

define method .isValidStatus(!spoolRef is DBREF) is BOOLEAN

  if (!spoolRef.badRef()) then
    return false
  endif

  !pipePieces   = !spoolRef.pprfa
  if (!pipePieces.unset()) then
    return false
  endif

  !isValidCondition = true
  do !ppieceRef values !pipePieces
    !isValidCondition = !ppieceRef.ppmodi.not()
    skip if (!isValidCondition)
    !isValidCondition = false
    break
  enddo

  return !isValidCondition
endmethod

define method .removeAll()
   !data = !this.spoolListGrid.getRows()

   do !rowData values !data
     !insertString = !rowData[1] & ' ' & !rowData[2]
     !this.removedList.append(!insertString)
   enddo

  !this.spoolListGrid.clearGridData()
  !this.existList.clear()
endmethod

-----------------------------------------------------------------------
--
-- Method:      checkPostName
--
-- Description: check file name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .transRegiName(!pathName is STRING) is STRING
  !invalidStr  = |` ~ ! @ # $ % ^ & * ( ) + = [ ] { } \ || ; : ' " , < > . ? /|
  !invalidList = !invalidStr.split('')

  !result = ''
  do !i from 1 to !pathName.length()
    !char = substring(!pathName, !i, 1)

    !index = !invalidList.find(!char)
    if (!index.set()) then
      if (!i eq 1 AND !char eq '/') then
        !result = !result + !char
      else
        !result = !result + '_'
      endif
    else
      !result = !result + !char
    endif

  enddo

  return !result
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      close
--
-- Description: close form
--
--
------------------------------------------------------------------------
define method .close()

  -- write dummy file to restore iso option file setting when execute this program.
  !logFilePath = |$!this.pdmsUserPath\pfPipeSpoolDwg.log|
  !defFile = object FILE(!logFilePath)
  !defFile.open('OVER')
  handle any
    write '[warning] Failed to save the log file for pipe spool dwg'
  elsehandle none
    if (!this.drawingDefaultFile.set() and !this.drawingDefaultFile.exists()) then
      !logData = |ISOOPTFILE,| & !this.drawingDefaultFile.fullname()
      !defFile.writeRecord(!logData)
      !defFile.close()
    endif
  endhandle

  !this.pipeModelDim.clearDimension()
  handle any
  endhandle

  unenhance all
  handle any
  endhandle

  !this.saveEnvironmentFile()

  !this.existList.clear()
  !this.removedList.clear()
  !this.hide()
endmethod
------------------------------------------------------------------------
--
-- Method:      changeDrawingType
--
-- Description: change drawing type
--
------------------------------------------------------------------------
define method .changeDrawingType()
  if(!!module().productfamily.upCase() ne 'MARINE') then
    return
  endif

  !isMarineMode = !this.tglUseMarineEnv.val
  if (!isMarineMode.not()) then
    return
  endif

  !marDbName = !this.drawingTypeList.rText[!this.drawingTypeList.val]
  !result    = !this.marDrawingTypeData.getPaddData(!marDbName)

  !this.txtDeptName.val = !result[1]
  handle any
  endhandle
  !this.txtRegiName.val = !result[2]
  handle any
  endhandle

  -- reset the fileManager to create the directories
  --!this.fileManager = object PFFILEMANAGER(!result[2] ,!result[1])

endmethod

------------------------------------------------------------------------
--
-- Method:      removeSelected
--
-- Description: method to remove one or more items from the grid
-- currently the whole list is refreshed after producing drawings
--
--
------------------------------------------------------------------------
-- P40138  12.1.1#RC4-Outfitting Pipe Spool Drawing form defect no remove option
define method .removeSelected()

   using namespace 'Aveva.Pdms.Presentation'
   if (!this.spoolListGrid.getSelectedRows().unset()) then
      return
   endif

   !list = !this.spoolListGrid.getSelectedRows()
   !data = !this.spoolListGrid.getRows()

   !header  = 'Pipe,Spool,Prod.Stat.,Drwg.Stat.,Spool Type'
   !headings = !header.split(',')

   do !a values !list
     !removeIndex = !data.findFirst(!a)
     !insertString = !data[!removeIndex][1] & ' ' & !data[!removeIndex][2]
     !this.removedList.append(!insertString)
     !data.remove(!removeIndex)
   enddo

   !nds = object NETDATASOURCE('Pipe Spool Result', !headings, !data)
   !this.spoolListGrid.bindToDataSource(!nds)

   !this.updateGridIcons()
endmethod

define method .loadEnvironmentFile()
  if (!this.environmentFile.exists().not()) then
    return
  endif

  !readData = !this.environmentFile.readFile()
  !this.tglPreviewDrawing.val = object BOOLEAN(!readData[1])
  handle any
  endhandle

  !this.drawingTypeList.val = !readData[2].real()
  handle any
  endhandle
endmethod

define method .saveEnvironmentFile()
  !this.environmentFile.open('OVER')
  handle any
    return false
  endhandle

  !previewDrawingFlag = !this.tglPreviewDrawing.val
  !sourceDrawingTypeFlag = !this.drawingTypeList.val

  !this.environmentFile.writeRecord('$!previewDrawingFlag')
  !this.environmentFile.writeRecord('$!sourceDrawingTypeFlag')

  !this.environmentFile.close()
endmethod

------------------------------------------------------------------------
--
-- Method:     .setPreviewFlag
--
-- Description: This moves the preview from a right click to a toggle
--
--
------------------------------------------------------------------------
define method .setPreviewFlag(!flag is BOOLEAN)

!this.previewFlag = !flag
if !flag then
  !this.showSpoolDrawing()
endif

endmethod

-- End of code
-- End of method
