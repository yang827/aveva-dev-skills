--  Created:         11 January 2013
--
--  Description:     draw view frame on marine draft
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       view ref
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!mardradrawviewframe(!viewRef is DBREF)
  import 'marAPI'
  handle (1000,0)
  endhandle

  using namespace 'AVEVA.Marine.UI'
  using namespace 'AVEVA.Marine.Drafting'
  using namespace 'AVEVA.Marine.Geometry'
  using namespace 'AVEVA.Marine.Utility'

  !mDraft       = object MARDRAFTING()

  -- get view information
  !frameStatus = !viewRef.lframe
  !frameColour = !viewRef.nlColour

  !viewCentrePos = !viewRef.xyPos
  !viewSize = !viewRef.size

  !xMin = !viewCentrePos.east  - ( !viewSize[1] / 2 )
  !yMin = !viewCentrePos.north - ( !viewSize[2] / 2 )

  !xMax = !viewCentrePos.east  + ( !viewSize[1] / 2 )
  !yMax = !viewCentrePos.north + ( !viewSize[2] / 2 )

  -- assign points to create view frame
  !mStartPos = object MARPOINTPLANAR(!xMin, !yMin)
  !mEndPos   = object MARPOINTPLANAR(!xMax, !yMax)

  if (!frameStatus) then
    -- create view frame
    !saveColour = !mDraft.colourget()

    !mColour = object MARCOLOUR(!frameColour)
    handle any
     !mColour = object MARCOLOUR('GRAY')
    endhandle

    !mDraft.colourSet(!mColour)

    !mRectanglePlanar = object MARRECTANGLEPLANAR(!mStartPos, !mEndPos)
    !mDraft.rectangleNew(!mRectanglePlanar)

    !mDraft.colourSet(!saveColour)
  else
    -- remove view frame
    !unusedHandle = !mDraft.contourIdentify(!mStartPos)
    handle any
      return
    endhandle
  endif

  !mDraft.dwgRepaint()
  handle any
  endhandle

  savework
  handle any
  endhandle

endfunction
-- End of function definition
