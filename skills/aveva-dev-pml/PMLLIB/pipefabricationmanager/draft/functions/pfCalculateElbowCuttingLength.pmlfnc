-- Define function
define function !!pfCalculateElbowCuttingLength(!elementName is STRING) is REAL
  !element = !elementName.dbRef()

  !result = !element.aPos.distance(!element.pos).string(!!distanceFMT).real().value()
--  !p1OffsetDir = !element.adir.cross(!element.ori.zDir())
--  !p2OffsetDir = !element.ldir.cross(!element.ori.zDir())
--
--  !line1 = object LINE(!ELEMENT.aPos, !ELEMENT.aPos.OFFSET(!p1OffsetDir, 100mm))
--  !line2 = object LINE(!ELEMENT.lPos, !ELEMENT.lPos.OFFSET(!p2OffsetDir, 100mm))
--
--  !centrePos = !line1.intersection(!line2)
--  !angle = !centrePos.angle(!element.aPos, !element.lPos)
--  !theta = !angle * 0.5
--
--  !length = !element.aPos.wrt( /* ).distance(!element.lPos.wrt( /* ))
--  !rad    = ((!length * 0.5) / sin(!theta))
--
--  !result = ( 2 * 3.14159 * !rad *  ( !theta / 360 deg) ) * 2

  return !result
endfunction
-- End of function definition
