--
--  Description:     call create iso drawing form
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       sheet reference
--    2    R     STRING      result  file path
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!pfCreateIsoDrawing(!drawingType is STRING)
  if (undefined(!!pfPipeIsometricDrawing)) then
    pml load form !!pfPipeIsometricDrawing
  endif

  !!pfPipeIsometricDrawing.functionType = !drawingType
  show !!pfPipeIsometricDrawing
endfunction
