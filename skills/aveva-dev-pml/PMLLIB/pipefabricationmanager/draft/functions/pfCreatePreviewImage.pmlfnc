--
--  Description:     create preview image
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       sheet reference
--    2    R     STRING      result  file path
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!pfCreatePreviewImage(!namingRulePath is STRING, !spoolRef is DBREF, !resultPath is STRING)
  -- currently the format of !namingRulePath and !resultPath are as followa
  -- D:\AVEVA\Marine\OH121~1.SP4\PMLLIB\/pipefabricationmanager/draft/functions/pfsketchnaming.pmldat
  -- D:\AVEVA\Marine\DATA12~1.SP4\pdmsuser\preview\
  -- Result path needs to be the plotfile directory

  var !spooldebug evar 'TRACE_SPOOLDRAWINGS'
  if !spooldebug.neq('') then
    $r101/c:\temp\pfCreatePreviewImage.pmldat
  endif


  -- this whole file is for marine only - it takes the isodraft dxf file and reads in to Marine draft
  -- then produces a tiff plot file of the final drawing
  if(!!module().productfamily.upcase() ne 'MARINE') then
    return
  endif

  !marDraDraftingApi = object MARDRADRAFTINGAPI()
  !closeMode = false

  --!dwgName = !spoolRef.name & '_Spool/S1'
  !dwgName =  !!pfEvaluateSketchName(!namingRulePath, !spoolRef, object ARRAY()) & '/S1'
  !size = !dwgName.dbref().size
  handle any
    return
  endhandle
  if (!marDraDraftingApi.mDraft[1].dwgCurrent().not()) then
    !marDraDraftingApi.mDraft[1].dwgOpen(!dwgName)
    handle any
      return
    endhandle
    !closeMode = true
  endif

  -- scale the plot size to make the tiff files more readable
  !xFactor = !size[1] * 5
  !yFactor = !size[2] * 5

  if (!resultPath.substring(-1,1) ne |\|) then
    !previewDir = !resultPath & |\|
  else
    !previewDir = !resultPath
  endif

  !checkDir = object FILE(!previewDir)
  if (!checkDir.exists().not()) then
    syscom 'MD "$!checkDir"'
  endif

  !resultFullPath = !previewDir + !spoolRef.namn.replace('/','_')  & '.tiff'
  -- export the plot file
  !marDraDraftingApi.mDraft[1].dwgTifExport(!resultFullPath,!xFactor,!yFactor)


  --!marDraDraftingApi.mDraft[1].dwgSave()
  if (!closeMode) then
    !marDraDraftingApi.mDraft[1].dwgClose()
  endif

endfunction
