--    Group:         Pipe Fabrication
--      Keyword:     PF
--    Module:        Design
--  Author:          Jaehun Choi(Daniel)
--  Created:         27 August 2013
--
--  Description:     evaluate sketch name
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      naming definition path
--    2    R     DBREF       spool reference
--    3    W     ARRAY       error list
-- Return:
--   [Data Type] [Description]
--    1    R     STRING      return to evaluated sketch name
--
------------------------------------------------------------------------
-- Define function
define function !!pfEvaluateSketchName(!namingDefPath is STRING, !spoolRef is DBREF, !errorList is ARRAY) is STRING
  !result = ''

  !file = object FILE(!namingDefPath)
  if (!file.exists().not()) then
    !errorList.append('Failed to get sketch Name from !!pfEvaluateSketchName' & !!error.text)
    return !result
  endif

  !readData = !file.readFile()
  if (!readData.unset()) then
    return !result
  endif

  !commentStartCommand = '$('
  !commentEndCommand   = '$)'

  !commentBlockFlag = false
  do !data values !readData
    !firstWord = substring(!data.trim(),1,2)

    skip if (!firstWord eq '--')

    if (!firstWord eq !commentStartCommand) then
      !commentBlockFlag = true
    elseif (!firstWord eq !commentEndCommand) then
      !commentBlockFlag = false
      !data = !data.replace(!commentEndCommand, '')
    endif

    skip if (!commentBlockFlag or !data.empty())

    !ruleData = !data
    break
  enddo

  !saveCe = !!ce
  !!ce = !spoolRef

  if (!ruleData.occurs('!!') gt 0) then
    !result = $!ruleData
    handle any
      !errorList.append('Failed to get sketch Name from !!pfEvaluateSketchName' & !!error.text)
    endhandle

    !!ce = !saveCe
    handle any
    endhandle
    return !result
  endif

  !length = !ruleData.length()

  !keyWord = ''

  !firstIndex = -1
  !lastIndex  = -1

  !startIndex = -1
  !prevIndex  = -1

  !prefix = ''

--  !keyWords = object ARRAY()
  !skipFlag   = false
  do !i to $!length
    !token = substring(!ruleData, !i, 1)

    if (!token eq |<|) then
      !firstIndex = !i + 1

      if (!startIndex eq -1) then
        !startIndex = !i
      endif

      !skipFlag   = true
    elseif (!token eq |>|) then
      !lastIndex = !i
      !skipFlag   = false
    endif

    skip if (!skipFlag)

    !keyWord = substring(!ruleData, !firstIndex, !lastIndex - !firstIndex)
    !skipFlag = true

    skip if (!keyWord.empty())

    if (!keyWord.upcase() eq 'INDEX') then
      !extraction = !spoolRef.sequ.string()
    else
      var !extraction $!<keyWord>
      handle any
        !extraction = !keyWord
      endhandle
    endif

    if (!prevIndex eq -1) then
      !prevIndex = !lastIndex
      !result = !extraction
    else
      !splitter = substring(!ruleData, !prevIndex + 1, (!firstIndex - !prevIndex - 2))
      !prevIndex = !lastIndex

      !result = !result & !splitter & !extraction
    endif
  enddo

  if (!lastIndex ne !length) then
    !result = !result & substring(!ruleData, !lastIndex + 1)
  endif

  if (!startIndex gt 1) then
    !prefix = substring(!ruleData, 1, !startIndex - 1)
  endif

  !result = '/' & !prefix & !result

  !!ce = !saveCe
  handle any
  endhandle

  !result = !result.replace('#','_')

  return !result
endfunction
