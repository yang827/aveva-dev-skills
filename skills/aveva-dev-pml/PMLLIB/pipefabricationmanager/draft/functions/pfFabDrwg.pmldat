Atext 318 ''
Atext 324 'REMARKS'
Atext 331 'MM'
Atext 371 'TOTAL SHOP FABRICATION WEIGHT'
Atext 372 'TOTAL ASSEMBLY WEIGHT'
Atext 400 ''
Atext 401 ''
Atext 402 ''
Atext 403 ''
Atext 404 ''
Atext 405 ''
Atext 406 ''
Atext 407 ''
Atext 410 ''
Atext 411 ''

Tagging OFF
Instname  NAME

Delimiter  COLON
InsulationControl  ON
TracingControl  ON

var !projectNumber proj number
ProjectNumber '$!projectNumber'
Attaname  OFF
Tolerance  Offset 1mm
Tolerance  Angle  0.06
Specbreak  COMPONENT  SpecChanges OFF
Axes  WORL /*
ContinuationSymbols OFF
Itemcode Valves DEFAULT
Itemcode Instruments DEFAULT
Itemcode Pcoms DEFAULT
Itemcode Traps DEFAULT
Itemcode Vents DEFAULT
Itemcode Filters DEFAULT
Itemcode  TOTAL
Itemcode  from SPREF
Itemcode for Supports from SPREF
Bolting  length description ON
Bolting  length itemcode APPEND
Bolting  Units  METRIC
Coords  ON AT Pipe
Coords  ON AT Nozz
Coords  ON AT Open
Coords  ON AT Clos
Coords  ON AT Vent
Coords  ON AT Dran
Coords  OFF AT Shee
Coords  ON AT Misc
Elevation    INTERSECTION
Skewbox  TRIANGLE NSTD Standout 4mm Hatch 3mm Partial  OFF Tags Angles
Zerolengthskews ON
Fallskews THREEDBOX  ON
-- weld table
TextPosition WeldTable Corner BL  X 268mm Y 49mm CharHeight 2.5mm
  Column 1 Heading 'WELD
 NO' Fill WLDN Width 4
  Column 2 Heading 'SHOP
/FLD' Fill SHOP Width 4
  Column 3 Heading 'WELD
TYPE' Fill WELDTYPE Width 4
  Column 4 Heading 'WELD
PROC' EMPTY Width 4
  Column 5 Heading 'WELDER
  ID' EMPTY Width 6
  Column 6 Heading 'VISUAL
ACCEPT' EMPTY Width 6  
  Column 7 Heading 'NDT
NO' EMPTY Width 3
  Column 8 Heading 'FAB.Q
ACCEP' EMPTY Width 5      

TextPosition PROJNUMB X 325mm Y 45mm CharHeight 3mm
!system = namn of mdSysf of pipe
handle any
  !system = ''
endhandle

TextPosition '$!system' X 330mm Y 40mm CharHeight 3mm
TextPosition OWNER X 325mm Y 35mm CharHeight 3mm
TextPosition PSPE X 342mm Y 30mm CharHeight 3mm
TextPosition DATE X 328mm Y 25mm CharHeight 3mm
  
!session = current session
!drawn   = !session.name

TextPosition '$!drawn' X 330mm Y 20mm CharHeight 3mm
  
--TextPosition BendTable Corner BL  X 439mm Y 30mm CharHeight 3mm
if (!!ce.type eq 'PSPOOL') then
  !note = !!ce.:note
  handle any
    !note = ''
  endhandle
  TextPosition '*Note: $!note' X 15 Y 15 CharHeight 4mm
endif

-- fix : SI59710
TextPosition DetailPlots Corner TL  X 25mm Y 80mm CharHeight 2.1mm Direction  RIGHT Stack 20 Direction  UP  Scale 100
SymbolFile "%pdmsEXE%\iso_symbols/mds-skeys" READONL
handle ANY
endhandle

Bendradius DISTANCE
