PPIECE ON
-- AVEVA - Units serialisation file
-- --------------------------------

-- Initialise variables
!u = object COMUNITS()
!!comFormats.allowUserSaveFile = true

-- Set saved units
!u.setUnits('', 'Bore', 'mm')
!u.setUnits('', 'Length', 'mm')
!u.setUnits('', 'Mass', 'kg')
!u.setUnits('', 'Temperature', 'degC')
!u.setUnits('', 'EMF', 'volt')
!u.setUnits('', 'Current', 'ampere')
!u.setUnits('', 'Angle', 'degree')
!u.setUnits('', 'Pressure', 'pascal')
!u.setUnits('', 'Force', 'newton')
!u.setUnits('', 'Impedance', 'ohm')
!u.setUnits('', 'Time', 'second')
!u.setUnits('', 'Energy', 'kWh')
!u.setUnits('', 'Power', 'kW')

-- Angle always Degrees case
!u.setUnits('', 'Angle', 'degree')

-- Set the formats for the above set units
!!comFormats.setStandardFormats()
