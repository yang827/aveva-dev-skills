--  Created:         27 August 2013
--
--  Description:     get sketch name
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--    1    R     STRING      return to evaluated sketch name
--
------------------------------------------------------------------------
-- Define function
define function !!pfGetSketchName() is STRING
  var !projectNumber proj number

  -- user code
  var !user user
  if (substring(!user,1,1) eq 'P') then
    !userCode = 'P'
  else
    !userCode = 'G'
  endif

  !stage = !!ce.:stage

  !system = substring(!!ce.namn,2,2)
  !index  = substring('000' & !!ce.sequ, -3, 3)

  !result = '/' & !projectNumber & !userCode & '_' & !stage & '_' & !system & !index
  handle any
    !result = ''
  endhandle

  return !result
endfunction
