--
--  Description:     create iso drawing
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      type
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!pfIsoDrawing(!type is STRING)
  if (undefined(!!pfIsoDrawings)) then
    pml load form !!pfIsoDrawings
  endif

  if (!!pfIsoDrawings.shown()) then
    !!pfIsoDrawings.hide()
  endif

  !!pfIsoDrawings.isFabricationDrawing = !type eq 'FAB'

  show !!pfIsoDrawings at xr0.5 yr0.3
endfunction
-- End of function definition
