--
--  Description:     mark bend table on iso view
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!pfMarkBendTableOnIsoView(!displayType is STRING)
  -- evaluate bending table
  if (!!ce.hardType eq 'BRAN') then
    !members = !!ce.members
    !tempSpools = !!collectAllFor('PSPOOL','', pipe of ce)

    !pipeSpools = object ARRAY()
    do !spoolRef values !tempSpools
      !index = !members.findFirst(!spoolRef.psarfa[1])
      skip if (!index.unset())

      skip if (!pipeSpools.findFirst(!spoolRef).set())

      !pipeSpools.append(!spoolRef)
    enddo
  else
    !pipeSpools = !!collectAllFor('PSPOOL', '',ce)
  endif

  !bendingTables = object ARRAY()
  !pipeSpoolManager = object PFPIPESPOOLMANAGER()

  do !pSpoolRef values !pipeSpools
    !subBendTable = !pipeSpoolManager.getBendingTables(!pSpoolRef)
    skip if (!subBendTable.unset())

    do !bendTable values !subBendTable
      skip if (!bendTable.activities.unset())

      !bendingTables.append(!bendTable)
    enddo
  enddo

  if (!bendingTables.unset()) then
    return
  endif

  -- crate bending table
  !startXpos = 370mm
  !startYPos = 100mm

  !stepY      = -4.5mm
  !lineOffset = 3mm

  !charHeight = 2.5mm

  -- initialise position
  !titleXpos = !startXpos + 30mm

  !ptNoXpos   = !startXpos
  !bendMcXpos = !startXpos + 25mm
--  !clutchXpos = !startXpos + 48mm
--  !checkXpos  = !startXpos + 67mm

--  !feedXposition   = !startXpos + 87mm
--  !rotateXposition = !startXpos + 105mm
--  !bendXposition   = !startXpos + 130mm

  !feedXposition   = !startXpos + 48mm
  !rotateXposition = !startXpos + 67mm
  !bendXposition   = !startXpos + 86mm

  -- create title
  TextPosition 'Bending Table'  X $!titleXpos  Y $!startYPos CharHeight $!charHeight
  !startYPos = !startYPos + !stepY + !lineOffset

  if (!displayType eq 'FRB') then
    !feedTitle   = 'Feed'
    !rotateTitle = 'Rotate'
    !bendTitle   = 'Bend'
  else
    !feedTitle   = 'X'
    !rotateTitle = 'Y'
    !bendTitle   = 'Z'
  endif

--  !separateLine = '____________________________________________________________________'
  !separateLine = '______________________________________________'

  do !table values !bendingTables
    TextPosition '$!separateLine' X $!startXpos   Y $!startYPos CharHeight $!charHeight
    !startYPos = !startYPos + !stepY

    -- create sub title
    TextPosition 'PIECE NO' X $!ptNoXpos  Y $!startYPos CharHeight $!charHeight
    TextPosition 'Bend M/C' X $!bendMcXpos  Y $!startYPos CharHeight $!charHeight
--    TextPosition 'Clutch'   X $!clutchXpos  Y $!startYPos CharHeight $!charHeight
--    TextPosition 'Check'    X $!checkXpos  Y $!startYPos CharHeight $!charHeight

    TextPosition '$!feedTitle'     X $!feedXposition    Y $!startYPos CharHeight $!charHeight
    TextPosition '$!rotateTitle'   X $!rotateXposition  Y $!startYPos CharHeight $!charHeight
    TextPosition '$!bendTitle'     X $!bendXposition    Y $!startYPos CharHeight $!charHeight

    !startYPos = !startYPos + !stepY

    -- get bending data
    if (!table.bendingmachine.badRef()) then
      !bendMachName = 'Manual'
    else
      !bendMachName = !table.bendingmachine.flnn.substring(1,8)
    endif

--    !clutch         = !table.lengthinsidemachine.nint().value().string()
--    !check          = !table.lengthoutsidemachine.nint().value().string()

    if (!table.pipePiece.aelrfa[1].hardType eq 'BRAN') then
      !partNo = !table.pipePiece.aelrfa[1].ptnhead
    else
      !partNo = !table.pipePiece.aelrfa[1].ptnTube
    endif

    -- fill contents
    TextPosition '$!partNo'       X $!ptNoXpos  Y $!startYPos CharHeight $!charHeight
    TextPosition '$!bendMachName' X $!bendMcXpos  Y $!startYPos CharHeight $!charHeight
--    TextPosition '$!clutch'       X $!clutchXpos  Y $!startYPos CharHeight $!charHeight
--    TextPosition '$!check'        X $!checkXpos   Y $!startYPos CharHeight $!charHeight

    do !activateTable values !table.activities
      !feed   = !activateTable.feed.nint().value().string()
      !rotate = !activateTable.rotate.nint().value().string()
      !bend   = !activateTable.bend.nint().value().string()

      TextPosition '$!feed'     X $!feedXposition   Y $!startYPos CharHeight $!charHeight
      TextPosition '$!rotate'   X $!rotateXposition Y $!startYPos CharHeight $!charHeight
      TextPosition '$!bend'    X $!bendXposition   Y $!startYPos CharHeight $!charHeight

      !startYPos = !startYPos + !stepY
    enddo

    TextPosition '$!separateLine'        X $!startXpos   Y $!startYPos CharHeight $!charHeight
    !startYPos = !startYPos + !stepY  + !lineOffset
  enddo

endfunction
-- End of function definition
