--  Created:         07 February 2013
--
--  Description:     mark consistency check result on drawing
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       sheet reference
--    2    R     BOOLEAN     consistency check result
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!pfMarkConsistencyResultOnDrawing(!sheetRef is DBREF, !checkResult is BOOLEAN)
  if (!checkResult) then
    return
  endif

  !errorMessage = 'Modelling Consistency Check not passed'

  !size = !sheetRef.size

  !xMid = !size[1] * 0.5
  !yMid = !size[2] * 0.5

  !angle = atan(!size[2] / !size[1])

  !saveCe = !!ce
  !!ce = !sheetRef
  new note
  new texp
  chei 10

  btext '$!<errorMessage>'
  just centre
  xyposition X $!<xMid> Y $!<yMid>
  txcolour 2
  adeg $!<angle>
  !!ce = !saveCe
  handle any
  endhandle
endfunction
