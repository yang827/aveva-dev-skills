--
--  Description:
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      sheet name
--    2    R     BOOLEAN     is include blank
--    3    R     STRING      attribute 1
--    4    R     STRING      attribute 2
--    5    R     STRING      attribute 3
--    6    R     STRING      attribute 4
--    7    R     STRING      attribute 5
-- Return:
--   [Data Type] [Description]
--    STRING     return to string for marking barcode
--
------------------------------------------------------------------------
-- Define function
define function !!pfPipeCreateBarcode(!sheetName is STRING, !isIncludeBlank is BOOLEAN, !attr1 is STRING, !attr2 is STRING, !attr3 is STRING, !attr4 is STRING, !attr5 is STRING) is STRING
  !result = ''
  !sheetRef = !sheetName.dbRef()
  handle any
    !sheetRef = object DBREF()
  endhandle

  if (!sheetRef.badRef()) then
    return
  endif

  !argumentList = object ARRAY()
  do !i from 1 to 5
    !argumentList.append(!attr$!i)
  enddo

  !!ce = !sheetRef

  do !argument values !argumentList
    skip if (!argument.empty())

    !subResult = $!<argument>
    handle any
      !subResult = ''
    endhandle

    if (!argument.upcase() eq 'PROJ CODE') then
      var !projCode PROJ CODE
      !subResult = !projCode
    endif

    skip if (!subResult.empty())
    if (!isIncludeBlank) then
      !result = !result + ' ' + !subResult
    else
      !result = !result + !subResult
    endif
  enddo

  if (!isIncludeBlank) then
    !result = substring(!result, 2)
  endif

  return !result
endfunction
-- End of function definition
