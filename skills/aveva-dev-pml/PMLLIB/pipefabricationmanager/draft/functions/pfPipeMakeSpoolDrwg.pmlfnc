--    Group:         Pipe Fabrication
--      Keyword:     PF
--    Module:        Design
--  Author:          Jaehun Choi(Daniel)
--  Created:         11 January 2013
--
--  Description:     make spool drawing as a background process
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     ARRAY       spool list
--    2    R     STRING      option file path
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!pfPipeMakeSpoolDrwg(!spoolList is ARRAY, !optionFilePath is STRING)
  var !projCode proj code
  var !mdb mdb
  var !user user
  var !unique unique
  var !installenv evar 'pdms_installed_dir'
  var !installenvaddin evar 'marineaddin'

  !debugMode = false

  -- create temporary login file
  !userlogin = object PMLUSERLOGIN()
  !userlogin.project(!projCode)
  !userlogin.mdb(!mdb)

  var !path evar pdmswk
  !path = !path.replace(';','')
  !userlogin.saveToFile(!path & '\temp_login_' & !user & '.tmp')

  -- create macro file for spool drawing
  !macfile = object FILE('%pdmsuser%\makespooldrwg.mac')
  !macfile.open('OVER')

  -- run temporary user login file as first line of makespooldrwg.mac to set project, username, password and MDB
  !macfile.writeRecord('$m "/$!path\temp_login_' & !user & '.tmp"')

  -- write current mdb
  !macfile.writeRecord(!mdb)
  -- log-in outfitting draft module
  if(!!module().productfamily.upcase() eq 'MARINE') then
    !macfile.writeRecord(|marinedrafting|)
  else
    !macfile.writeRecord(|draft|)
  endif

  -- fill out contents
  do !entry values !spoolList
    !entryName = !entry.fullname
    !macfile.writeRecord(|!!pfpipemakeunderlyingdrwg('$!entryName','$!optionFilePath','$!unique')|)
  enddo

  -- write to file to record run as complete
  !macfile.writeRecord(|!donefile = object FILE('%pdmsuser%\spooldwgdone.log')|)
  !macfile.writeRecord(|!donefile.open('OVER')|)
  !macfile.writeRecord(|!donefile.writeRecord('DONE')|)
  !macfile.writeRecord(|!donefile.close()|)

  -- write macro file
  if (!debugMode.not()) then
    !macfile.writeRecord(|FINISH|)
  endif
  !macfile.close()

  -- create batch file to batch run

--  var !pdmsuser evar pdmsuser
--  !pdmsuser = !pdmsuser.replace(';','')
  !pdmsuser = !!evarSplit('PDMSUSER')[1]

  !batchFile = object FILE('$!pdmsuser\makespooldrwg.bat')
  !batchFile.open('OVER')
  !batchFile.writeRecord(|setlocal|)
  !batchFile.writeRecord(|set savepath=%path%|)
  !batchFile.writeRecord(|set pdms_installed_dir=$!installenv|)
  !batchFile.writeRecord(|set pdms_installed_addin_dir=$!installenvaddin|)
  !batchFile.writeRecord(|set AVEVA_MARINE=YES|)
  !batchFile.writeRecord(|set MARINE=YES|)
  !batchFile.writeRecord(|call "%pdms_installed_addin_dir%\evars.bat" "%pdms_installed_addin_dir%"|)
  if (!debugMode) then
    !batchFile.writeRecord(|"%pdms_installed_dir%\MON"  tty -macro="$!pdmsuser/makespooldrwg.mac"|)
  else
    !batchFile.writeRecord(|"%pdms_installed_dir%\MON"  tty  -noconsole -macro="$!pdmsuser/makespooldrwg.mac"|)
  endif

  !batchFile.writeRecord(|endlocal|)
  !batchFile.writeRecord(|exit|)
  !batchFile.close()

  -- create spool drawing by batch run
  if (!debugMode) then
    SYSCOM 'START /MIN cmd.exe /C "$!batchFile" &'
    return
  endif

--  var !pdmsExe split evar pdmsexe
--  !pdmsExePath = !pdmsExe[1].replace(';','')
--
--  !batchFileFullPath = !batchFile.fullname()
--  SYSCOM '$!pdmsExePath\runbatchproc.vbs $!batchFileFullPath'
--  $.

  -- wait until the background process is finished
  !batchFileFullPath = !batchFile.fullname()
  import 'PipeFabricationAddin'
  handle any
  endhandle

  using namespace 'Aveva.Pdms.PipeFabrication.RunBatchProc'
  !runBatchProc = object RUNBATCHPROCESS()
  handle any
    SYSCOM 'START /MIN cmd.exe /C "$!batchFile" &'
  elsehandle none
    !runBatchProc.run(!batchFileFullPath)
  endhandle
endfunction
-- End of function definition
