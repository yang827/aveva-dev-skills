--
--  Description:     make underlying drawing for pipe spool drawing - does not use IsoDraft
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      spoolname
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!pfPipeMakeUnderlyingDrwg(!spoolName is STRING,!optionFile is STRING,!uniqueId is STRING)

  var !spooldebug evar 'TRACE_SPOOLDRAWINGS'
  if !spooldebug.neq('') then
    $r101/c:\temp\pfPipeMakeunderlyingdrwg.pmldat
  endif

  !element = !spoolName.dbref()
  if (!element.badref()) then
    return
  endif

  !pipeSpoolDwg = object PFPIPESPOOLDWG(!uniqueId)
  -- kicks off the process of creating a drawing where the result one or more? file names
  !path[1] = !pipeSpoolDwg.makeUnderlyingDrwg(!element, !optionFile)
  handle ANY
    !pipeSpoolDwg.writeErrorMessage(!!error.line,!!error.text)
    handle (2,779)
      !pipeSpoolDwg.createResultFile()
    elsehandle none
      !pipeSpoolDwg.createResultFile()
    endhandle
    return
  endhandle

  if !path[1].set() then
    !pipeSpoolDwg.resultList.writeFile('append',!path)
  endif

endfunction
-- End of function definition
