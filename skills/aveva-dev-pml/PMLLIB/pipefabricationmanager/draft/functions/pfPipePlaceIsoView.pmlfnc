--
--  Description:
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      sheet name
--    2    R     ARRAY       dxf file data
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!pfPipePlaceIsoView(!sheetName is STRING, !spoolName is STRING, !dxfFileData is ARRAY)
  if (!!module().modKey.upCase() ne 'MARDRA') then
    return
  endif

   var !spooldebug evar 'TRACE_SPOOLDRAWINGS'
  if !spooldebug.neq('') then
    $r101/c:\temp\pfPipePlaceIsoView.pmldat
  endif

  !isoViewName = !sheetName & '/ISO'
  !isoViewRef  = !isoViewName.dbRef()

  !isoViewPos  = !isoViewRef.xyPs
  !isoViewSize = !isoViewRef.size
  !dxfFilePath = !dxfFileData[2]
  import 'marAPI'
  handle (1000,0)
  endhandle

  using namespace 'AVEVA.MARINE.DRAFTING'
  using namespace 'AVEVA.Marine.Geometry'
  using namespace 'AVEVA.Marine.MarInterpretationObject'

  !mDrafting = object MARDRAFTING()
  if (!mDrafting.dwgCurrent()) then
    !mDrafting.dwgClose()
  endif

  !checkDBWrite    = object COMCHECKDBWRITE()
  !checkDBWrite.showAlert = false

  !sheetRef = object DBREF(!sheetName)

  !importDxfFileName = '__ISO_TEMP_DWG__' & !sheetRef.namn.replace('/','_')
  !importDxfSheetRef = object DBREF('/' & !importDxfFileName)
  handle any
    !importDxfSheetRef = object DBREF()
  endhandle

  -- If it use delete method on marAPI, sometimes it's not working properly.
  if (!importDxfSheetRef.badRef().not()) then
    if (!checkDBWrite.checkDBWrite(!importDxfSheetRef).not()) then
      return
    endif

    !!ce = DRWG of $!importDxfSheetRef
    delete DRWG
  endif

  !subpictureName = '__ISO_TEMP_VIEW1__' & !sheetRef.namn.replace('/','_')
  !subpicutreRef = object DBREF('/' & !subpictureName)
  handle any
    !subpicutreRef = object DBREF()
  endhandle

  -- If it use delete method on marAPI, sometimes it's not working properly.
  if (!importDxfSheetRef.badRef().not()) then
    if (!checkDBWrite.checkDBWrite(!importDxfSheetRef).not()) then
      return
    endif
    !!ce = DRWG of $!importDxfSheetRef
    delete DRWG
  endif
  !checkFile = object FILE(!dxfFilePath)
  if (!checkFile.exists().not()) then
    !mDrafting.dwgOpen(!sheetName)
    !toPoint   = object MARPOINTPLANAR(!isoViewPos.east,!isoViewPos.north)
    !handle = !mDrafting.textNew('< FAILED TO CREATE A ISO VIEW >', !toPoint)
    !curExtentArea = !mDrafting.elementExtentGet(!handle)
    !xPos = ( !curExtentArea.corner1().x() + !curExtentArea.corner2().x() ) / 2
    !yPos = !curExtentArea.corner1().y()

    !fromPoint = object MARPOINTPLANAR(!xPos, !yPos)
    !toPoint   = object MARPOINTPLANAR(!isoViewPos.east, !yPos)

    !vector = object MARVECTORPLANAR()
    !vector.setFromPoints(!fromPoint, !toPoint)
    !transF = object MARTRANSFORMATIONPLANAR()
    !transF.translate(!vector)

    !mDrafting.elementTransform(!handle, !transF)
    return
  endif

  !importDxfFileName = '__ISO_TEMP_DWG__'  & !sheetRef.namn.replace('/','_')
  !mDrafting.dwgDxfImport(!dxfFilePath,!importDxfFileName)
  !checkFile.deleteFile()
  handle any
  endhandle

  !viewHandle = !mDrafting.elementChildFirstGet()

  !subpictureName = '__ISO_TEMP_VIEW1__'
  !mDrafting.subpictureNameSet(!viewHandle, !subpictureName)
  !mDrafting.subpictureSave(!viewHandle)
  handle any
    !saveFlag = false
    !subpictureName = '__ISO_TEMP_VIEW'
    do !i from 2 to 10
      !subpictureName = !subpictureName & !i &  '__'
      !mDrafting.subpictureNameSet(!viewHandle, !subpictureName)
      !mDrafting.subpictureSave(!viewHandle)
      handle any
      elsehandle none
        !saveFlag = true
        break
      endhandle
    enddo

    if (!saveFlag.not()) then
      return
    endif
  endhandle

  !mDrafting.dwgClose()
  handle any
  endhandle

  !mDrafting.dwgOpen(!sheetName)

  !subpHandle = !mDrafting.subpictureInsert(!subpictureName,1)

  !subpArea   = !mDrafting.elementExtentGet(!subpHandle)
  !fromCenterX = (!subpArea.corner1().x() + !subpArea.corner2().x()) / 2
  !fromCenterY = (!subpArea.corner1().y() + !subpArea.corner2().y()) / 2

 -- calculate scale
  !sourceWidth  = abs(!subpArea.corner1().x() - !subpArea.corner2().x())
  !sourceHeight = abs(!subpArea.corner1().y() - !subpArea.corner2().y())

  !limitWidth  = !isoViewSize[1]
  !limitHeight = !isoViewSize[2]

  !sourceRatio  = !sourceHeight / !sourceWidth
  !limitRatio   = !limitHeight / !limitWidth

  if (!limitRatio gt !sourceRatio) then
    !scale = !limitWidth / !sourceWidth
  else
    !scale = !limitHeight / !sourceHeight
  endif

  !mDrafting.viewScale(!subpHandle, !scale)

  -- move subpicture to specified position.
  !fromPoint = object MARPOINTPLANAR(!fromCenterX,!fromCenterY)
  !toPoint   = object MARPOINTPLANAR(!isoViewPos.east,!isoViewPos.north)

  !vector = object MARVECTORPLANAR()
  !vector.setFromPoints(!fromPoint, !toPoint)
  !transF = object MARTRANSFORMATIONPLANAR()
  !transF.translate(!vector)

  !mDrafting.viewScale(!subpHandle, 0.7)

  !mDrafting.elementTransform(!subpHandle, !transF)
--  !mDrafting.dwgSave()
--  handle any
--  endhandle

  !mDrafting.dwgDelete(!subpictureName, 'SB_PDB')
  handle any
  endhandle

  !mDrafting.dwgDelete(!subpictureName, 'SBD_PICT')
  handle any
  endhandle

  savework
  handle any
  endhandle
endfunction
-- End of function definition
