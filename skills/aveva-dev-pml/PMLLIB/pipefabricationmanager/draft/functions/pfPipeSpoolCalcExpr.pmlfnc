--  Description:     calculate evaluation on pipe spool
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!pfPipeSpoolCalcExpr(!entryName is STRING, !query is STRING) is STRING
--  !spoolManager = object PIPESPOOLMANAGER()
  !entry = $!entryName

  warning off

  if (!entry.type neq 'PPIECE' and !entry.type neq 'PSPOOL') then
    !unusedSpoolElement = object DBREF('/' & !entry.spln)
    handle any
    endhandle
  endif

  if (!query.upcase() eq 'QTY') then
    if (!entry.type eq 'PPIECE') then
--      !result = !entry.ppCutLength.nint()
      !result = !entry.:pfCutLength.nint()
    else
      !result = 1
    endif
  elseif (!query.upcase() eq 'AC') then
    if (!entry.type eq 'PPIECE') then
--      !result = !entry.ppFinLength.nint()
      !result = !entry.:pfFinLength.nint()
    else
      !result = 1
    endif

  elseif(!query.upcase() eq 'INS_FIX') then
    if (!entry.:PIECETYPE.upcase().occurs('FIX') gt 0) then
      !result = 'O'
    else
      !result = ''
    endif

  elseif(!query.upcase() eq 'INS_PENI') then
    if (!entry.:PIECETYPE.upcase().occurs('PENI') gt 0) then
      !result = 'O'
    else
      !result = ''
    endif
  elseif(!query.upcase() eq 'INS_ADJ') then
    if (!entry.:PIECETYPE.upcase().occurs('ADJ') gt 0) then
      !result = 'O'
    else
      !result = ''
    endif

  elseif(!query.upcase() eq 'IN_AC') then
    if (!entry.:TREAT.empty() OR !entry.:TREAT.occurs(',') eq 0) then
      !result = ''
    endif

    !result = !entry.:TREAT.part(1,',')

  elseif(!query.upcase() eq 'OUT_AC') then
    if (!entry.:TREAT.empty() OR !entry.:TREAT.occurs(',') eq 0) then
      !result = ''
    endif

    !result = !entry.:TREAT.part(2,',')

  elseif (!query.upcase() eq 'IN_PAINT') then
    if (!entry.:PAINT.empty() OR !entry.:PAINT.occurs(',') eq 0) then
      !result = ''
    endif

    !result = !entry.:PAINT.part(1,',')


  elseif (!query.upcase() eq 'OUT_PAINT') then
    if (!entry.:PAINT.empty() OR !entry.:PAINT.occurs(',') eq 0) then
      !result = ''
    endif

    !result = !entry.:PAINT.part(2,',')

  elseif (!query.upcase() eq 'INSUL') then
    !result = ''
    if (!entry.iPara.set()) then
      if (!entry.iPara[1] gt 0) then
        !result = 'O'
      endif
    endif
--    !mtoElements = !spoolManager.getMtoElements(!entry)
--    !result = 'O'
--    do !tempEntry values !mtoElements
--      skip if (!tempEntry.type inset ('WELD','ATTA'))
--
--      if (!entry.ispec.badref()) then
--        !result = ''
--        break
--      endif
--    enddo

  elseif (!query.upcase() eq 'TOT_WEIGHT') then
    !result = !!pfPipeSpoolGetWeight(!entry).value().string('D2')

  elseif(!query.upcase() eq 'BD_NOR') then
    if (!entry.:BENDCON.upcase().occurs('NOR') gt 0) then
      !result = 'O'
    else
      !result = ''
    endif

  elseif(!query.upcase() eq 'BD_COLD') then
    if (!entry.:BENDCON.upcase().occurs('COLD') gt 0) then
      !result = 'O'
    else
      !result = ''
    endif

  elseif(!query.upcase() eq 'BD_HF') then
    if (!entry.:BENDCON.upcase().occurs('HF') gt 0) then
      !result = 'O'
    else
      !result = ''
    endif

  elseif(!query.upcase() eq 'SHIP_XPOS') then
   if (!entry.type eq 'PPIECE') then
      !tubeRef   = il tube of $!entry.aelrfa[1]
      !centrePos = !tubeRef.aPos.midPoint(!tubeRef.lPos).wrt(world)
    else
      !wvol = !entry.wvol
      !xCentre = ( !wvol[1] + !wvol[4] ) / 2
      !yCentre = ( !wvol[2] + !wvol[5] ) / 2
      !zCentre = ( !wvol[3] + !wvol[6] ) / 2
      !centrePos = E $!xCentre N $!yCentre U $!zCentre
    endif

    !result = !!comTranslateShipPosition(!centrePos)[1]
    handle (2,752)
      !result = ''
    endhandle

  elseif(!query.upcase() eq 'SHIP_YPOS') then
   if (!entry.type eq 'PPIECE') then
      !tubeRef   = il tube of $!entry.aelrfa[1]
      !centrePos = !tubeRef.aPos.midPoint(!tubeRef.lPos).wrt(world)
    else
      !wvol = !entry.wvol
      !xCentre = ( !wvol[1] + !wvol[4] ) / 2
      !yCentre = ( !wvol[2] + !wvol[5] ) / 2
      !zCentre = ( !wvol[3] + !wvol[6] ) / 2
      !centrePos = E $!xCentre N $!yCentre U $!zCentre
    endif

    !result = !!comTranslateShipPosition(!centrePos)[2]
    handle (2,752)
      !result = ''
    endhandle

  elseif(!query.upcase() eq 'SHIP_ZPOS') then
   if (!entry.type eq 'PPIECE') then
      !tubeRef   = il tube of $!entry.aelrfa[1]
      !centrePos = !tubeRef.aPos.midPoint(!tubeRef.lPos).wrt(world)
    else
      !wvol = !entry.wvol
      !xCentre = ( !wvol[1] + !wvol[4] ) / 2
      !yCentre = ( !wvol[2] + !wvol[5] ) / 2
      !zCentre = ( !wvol[3] + !wvol[6] ) / 2
      !centrePos = E $!xCentre N $!yCentre U $!zCentre
    endif

    !result = !!comTranslateShipPosition(!centrePos)[3]
    handle any
      !result = ''
    endhandle

  elseif(!query.upcase() inset ('XPOS','EAST')) then
   if (!entry.type eq 'PPIECE') then
      !tubeRef   = il tube of $!entry.aelrfa[1]
      !centrePos = !tubeRef.aPos.midPoint(!tubeRef.lPos).wrt(world)
    else
      !wvol = !entry.wvol
      !xCentre = ( !wvol[1] + !wvol[4] ) / 2
      !yCentre = ( !wvol[2] + !wvol[5] ) / 2
      !zCentre = ( !wvol[3] + !wvol[6] ) / 2
      !centrePos = E $!xCentre N $!yCentre U $!zCentre
    endif

    !result = !centrePos.east
    handle (2,752)
      !result = ''
    endhandle

  elseif(!query.upcase() inset ('YPOS','NORTH')) then
   if (!entry.type eq 'PPIECE') then
      !tubeRef   = il tube of $!entry.aelrfa[1]
      !centrePos = !tubeRef.aPos.midPoint(!tubeRef.lPos).wrt(world)
    else
      !wvol = !entry.wvol
      !xCentre = ( !wvol[1] + !wvol[4] ) / 2
      !yCentre = ( !wvol[2] + !wvol[5] ) / 2
      !zCentre = ( !wvol[3] + !wvol[6] ) / 2
      !centrePos = E $!xCentre N $!yCentre U $!zCentre
    endif

    !result = !centrePos.north
    handle (2,752)
      !result = ''
    endhandle

  elseif(!query.upcase() inset ('ZPOS','UP')) then
   if (!entry.type eq 'PPIECE') then
      !tubeRef   = il tube of $!entry.aelrfa[1]
      !centrePos = !tubeRef.aPos.midPoint(!tubeRef.lPos).wrt(world)
    else
      !wvol = !entry.wvol
      !xCentre = ( !wvol[1] + !wvol[4] ) / 2
      !yCentre = ( !wvol[2] + !wvol[5] ) / 2
      !zCentre = ( !wvol[3] + !wvol[6] ) / 2
      !centrePos = E $!xCentre N $!yCentre U $!zCentre
    endif

    !result = !centrePos.up
    handle (2,752)
      !result = ''
    endhandle

  elseif (!query.upcase() inset ('SHIPX_FROM_RSO', 'SHIPXPOS_FROM_RSO', 'SHIPY_FROM_RSO', 'SHIPYPOS_FROM_RSO','SHIPZ_FROM_RSO', 'SHIPZPOS_FROM_RSO')) then
    if (!query.upcase() inset ('SHIPX_FROM_RSO','SHIPXPOS_FROM_RSO')) then
      !searchDir = 'X'
    elseif (!query.upcase() inset ('SHIPY_FROM_RSO','SHIPYPOS_FROM_RSO')) then
      !searchDir = 'Y'
    else
      !searchDir = 'Z'
    endif

    if (!entry.type eq 'PPIECE') then
      !tubeRef   = il tube of $!entry.aelrfa[1]
      !centrePos = !tubeRef.aPos.midPoint(!tubeRef.lPos).wrt(world)
    else
      !wvol = !entry.wvol
      !xCentre = ( !wvol[1] + !wvol[4] ) / 2
      !yCentre = ( !wvol[2] + !wvol[5] ) / 2
      !zCentre = ( !wvol[3] + !wvol[6] ) / 2
      !centrePos = E $!xCentre N $!yCentre U $!zCentre
    endif

    !result = !!comTranslateRsoPosition(!searchDir, !centrePos)
    handle any
      !result = ''
    endhandle

  elseif(!query.upcase() eq 'FLG_ROT') then
    -- ANGLE OF FLANGE ROTATE
    !components = !entry.belrfa

    !flangeList = object ARRAY()
    do !entry values !components
      skip if (!entry.type ne 'FLAN')

      !flangeList.append(!entry)
    enddo

    !angleList = object ARRAY()
    do !i from 1 to !flangeList.size() - 1
      !cosAngle  = !flangeList[!i].pzdir[1].dot(!flangeList[!i + 1].pzdir[1])
      handle any
        skip
      endhandle

      !angle     = acos(!cosAngle)
      if (abs(nint(!angle)) eq 90 OR nint(!angle) eq 0) then
        skip
      endif


      !angleList.append(!angle)
    enddo

    !flangeRotateAngle  = 0
    if (!angleList.set()) then
      !flangeRotateAngle = !angleList.last()
    endif

    if (!flangeRotateAngle eq 0) then
      !result = ''
    else
      !result = !flangeRotateAngle.nint().string()
    endif

  elseif(!query.upcase() eq 'BORE') then
    !result = !!comValueConvert(!entry.abore.string(!!boreFMT).real(), !!boreFMT.units).string()

  elseif (!query.upcase().occurs ('GRID') gt 0) then
    !centreOfGravityPos = !entry.nCofg
    handle any
      !result = ''
    elsehandle none
      !basePos = !!pfTranslateShipPosition(!centreOfGravityPos)

      !xPosVal = !basePos[1]
      !yPosVal = !basePos[2]
      !zPosVal = !basePos[3]

      !conditions = !query.split(';')

      !splitter = ' '

      if (!conditions.size() ne 2) then
        !result = ''
      else
        !posCondition = !conditions[1]
        !splitter = !conditions[2]

        if (!posCondition.upcase() eq 'GRIDX') then
          !xPosVal = !basePos[1]
          !yPosVal = !centreOfGravityPos.north.string(!!distanceFMT).real().value().string()
          !zPosVal = !centreOfGravityPos.up.string(!!distanceFMT).real().value().string()
        elseif (!posCondition.upcase() eq 'GRIDY') then
          !xPosVal = !centreOfGravityPos.east.string(!!distanceFMT).real().value().string()
          !yPosVal = !basePos[2]
          !zPosVal = !centreOfGravityPos.up.string(!!distanceFMT).real().value().string()
        elseif (!posCondition.upcase() eq 'GRIDZ') then
          !xPosVal = !centreOfGravityPos.east.string(!!distanceFMT).real().value().string()
          !yPosVal = !centreOfGravityPos.north.string(!!distanceFMT).real().value().string()
          !zPosVal = !basePos[3]
        elseif (!posCondition.upcase() eq 'GRIDXY') then
          !xPosVal = !basePos[1]
          !yPosVal = !basePos[2]
          !zPosVal = !centreOfGravityPos.up.string(!!distanceFMT).real().value().string()
        elseif (!posCondition.upcase() eq 'GRIDXZ') then
          !xPosVal = !basePos[1]
          !yPosVal = !centreOfGravityPos.north.string(!!distanceFMT).real().value().string()
          !zPosVal = !basePos[3]
        elseif (!posCondition.upcase() eq 'GRIDYZ') then
          !xPosVal = !centreOfGravityPos.east.string(!!distanceFMT).real().value().string()
          !yPosVal = !basePos[2]
          !zPosVal = !basePos[3]
        elseif (!posCondition.upcase() eq 'NOGRID') then
          !xPosVal = !centreOfGravityPos.east.string(!!distanceFMT).real().value().string()
          !yPosVal = !centreOfGravityPos.north.string(!!distanceFMT).real().value().string()
          !zPosVal = !centreOfGravityPos.up.string(!!distanceFMT).real().value().string()
        endif

        if (!splitter.upcase() eq 'ENU') then
          !centreOfGravityValue = 'E ' & !xPosVal & ' N ' & !yPosVal & ' U ' & !zPosVal
        elseif (!splitter.upcase() eq 'XYZ') then
          !centreOfGravityValue = 'X ' & !xPosVal & ' Y ' & !yPosVal & ' Z ' & !zPosVal
        else
          !centreOfGravityValue = !xPosVal & '$!splitter' & !yPosVal & '$!splitter' &  !zPosVal
        endif

        !result = !centreOfGravityValue
      endif
    endhandle
  else
    !result = !entry.$!<query>
    handle any
      !result = ''
    endhandle
  endif

  warning on

  return !result.string()
endfunction
-- End of function definition
