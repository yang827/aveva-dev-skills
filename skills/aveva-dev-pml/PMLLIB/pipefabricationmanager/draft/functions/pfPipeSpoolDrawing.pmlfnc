-- Define function
define function !!pfPipeSpoolDrawing()
  !!pipeSetProductionCheckOption()
  if (!!productionChecksEnabled) then
    !!alert.message('Cannot use this function. Please check PRODUCTIONCHECKSENABLED in the batch file.')
    return
  endif

--  if(!!module().productfamily.upCase() eq 'MARINE') then
--    !productName = 'Outfitting'
--  else
--    !productName = 'Design'
--  endif
--
--  if (!!ce.dbType ne 'PADD') then
--    !departments = !!collectAllFor('DEPT', |dbwrite eq true|, world)
--    if (!departments.unset()) then
--      !!alert.warning(|Function currently unavailable. Please check Draft DB write access and ensure $!<productName> has R/W access to Draft via the Module Definition in Admin|)
--      return
--    endif
--  endif

  -- load form
  if (undefine(!!pfPipeSpoolDwg)) then
    pml reload form !!pfPipeSpoolDwg
  endif

  -- show form
  show !!pfPipeSpoolDwg at xr0.5 yr0.3
endfunction
