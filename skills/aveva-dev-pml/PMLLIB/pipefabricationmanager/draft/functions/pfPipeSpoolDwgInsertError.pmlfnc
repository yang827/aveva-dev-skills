--
--  Description:     insert error message while creating pipe spool drawing
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      element
--    2    R     STRING      error desc
--    3    R     ARRAY       error list
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!pfPipeSpoolDwgInsertError(!element is STRING, !errorDesc is STRING, !errorList is ARRAY)
  !errorList.append(!element & '@'  & !errorDesc)
endfunction
-- End of function definition
