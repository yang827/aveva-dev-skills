--  File:            pfPipeSpoolGetWeight.pmlfnc
--    Type:          Function Definition
--    Group:         PFM
--      Keyword:     PFM
--    Module:        PFM
--  Author:          Daniel(Jaehun Choi)
--  Created:         24 April 2013
--
--  Description:     calculate pipe spool weight for PFM
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!pfPipeSpoolGetWeight(!spool is DBREF) is REAL
  -- Initialise variables
  !pipeSpoolManager = object PIPESPOOLMANAGER()
  !totalWeight      = 0

  -- get all pipe elements contained in the spool include tube
  !components     = !pipeSpoolManager.getBranchElements(!spool)

  do !compRefe values !components
    !type = !compRefe.hardType

    -- check for component type
    skip if (!type eq 'PPIECE')

    -- check for bad spref / cmpref
    skip if (!compRefe.spre.badRef())
    skip if (!compRefe.spre.cmpr.badRef())

    !weight = 0

    -- calculate tube weight
    if (!type eq |TUBI|) then
      if (!compRefe.spre.cmpr.badRef() OR !compRefe.spre.cmpr.uwei.unset()) then
        !totalWeight = -1
        break
      endif

      if (!compRefe.spref.cmpr.uwei.upcase().occurs('RPRO') gt 0) then
        !property = !compRefe.spre.cmpr.uwei.after('RPRO').replace(')','').trim()
        !unitWeight = !compRefe.prop.attribute(!property).real()
        handle any
          !unitWeight = object REAL()
        endhandle
      else
        !unitWeight = !compRefe.spre.cmpr.uwei.real()
        handle (2,441)
          !unitWeight = !compRefe.spre.cmpr.uwei.after('(').before(')').real()
        endhandle
      endif

      if (!unitWeight.unset()) then
        !totalWeight = -1
        break
      endif

      !weight     = !compRefe.itle * !unitWeight

    -- calculate bend weight
    elseif (!type eq |BEND|) then
      if (!compRefe.spre.cmpr.badRef() OR !compRefe.spre.cmpr.uwei.unset()) then
        !totalWeight = -1
        break
      endif

      if (!compRefe.spref.cmpr.uwei.upcase().occurs('RPRO') gt 0) then
        !property = !compRefe.spre.cmpr.uwei.after('RPRO').replace(')','').trim()
        !unitWeight = !compRefe.prop.attribute(!property).real()
        handle any
          !unitWeight = object REAL()
        endhandle
      else
        !unitWeight = !compRefe.lstube.spre.cmpr.uwei.real()
        handle (2,441)
          !unitWeight = !compRefe.lstube.spre.cmpr.uwei.after('(').before(')').real()
        endhandle
      endif

      if (!unitWeight.unset()) then
        !totalWeight = -1
        break
      endif

      !weight     = !compRefe.fitlen * !unitWeight
    -- calculate weight all other components
    else
      if (!compRefe.spre.cmpr.badRef() or !compRefe.spre.cmpr.cwei.unset()) then
        !totalWeight = -1
        break
      endif

      if (!compRefe.spref.cmpr.cwei.upcase().occurs('RPRO') gt 0) then
        !property = !compRefe.spre.cmpr.cwei.after('RPRO').replace(')','').trim()
        !weight = !compRefe.prop.attribute(!property).real()
        handle any
          !weight = object REAL()
        endhandle
      else
        !weight = !compRefe.spre.cmpr.cwei.real()
        handle (2,441)
          !weight = !compRefe.spre.cmpr.cwei.after('(').before(')').real()
        endhandle
      endif

      if (!weight.unset()) then
        !totalWeight = -1
        break
      endif
    endif

    -- Add weight to the total
    !totalWeight = !totalWeight + !weight
  enddo

  return !totalWeight
endfunction
