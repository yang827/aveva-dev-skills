--  Author:          Daniel(Jaehun Choi)
--  Created:         18 April 2013
--
--  Description:     translate position from world position to ship position
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define function !!pfTranslateShipPosition(!position is POSITION) is ARRAY
  if(!!module().productfamily.upcase() eq 'MARINE') then

  !shipGrid     = object SHIPGRID()
  !shipPosition = !shipGrid.shipGridPosition(!position)

  -- translate position
  !shipPos[1] = !shipPosition.xPrefix & ' ' & !shipPosition.xGridLine & '+' & nint(!shipPosition.xOffset.value())
  !shipPos[2] = !shipPosition.yPrefix & ' ' & !shipPosition.yGridLine & '+' & nint(!shipPosition.yOffset.value())
  !shipPos[3] = !shipPosition.zPrefix & ' ' & !shipPosition.zGridLine & '+' & nint(!shipPosition.zOffset.value())

  !shipPos[1] = !shipPos[1].replace('+-', '-')
  !shipPos[2] = !shipPos[2].replace('+-', '-')
  !shipPos[3] = !shipPos[3].replace('+-', '-')
  else
    !shipPos = object ARRAY()
    !shipPos.append(!position.east.nint().value())
    !shipPos.append(!position.north.nint().value())
    !shipPos.append(!position.up.nint().value())
  endif

  -- return result
  return !shipPos
endfunction
