--    Module:        Design
--  Author:          Jaehun Choi(Daniel)
--  Created:         17 January 2014
--
--  Description:     calculate suitable ADEG of view
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       element reference
--    2    R     DBREF       view reference
-- Return:
--   [Data Type] [Description]
--    1    R     REAL        return to ADEG
--
------------------------------------------------------------------------
-- Define function
define function !!pfCalculateAdeg(!viewRef is DBREF) is REAL
  !result = object REAL()

  !!ce = !viewRef

  !viewList  = !!collectAllFor('VIEW','', !viewRef.owner)
  !viewIndex = !viewList.findFirst(!viewRef)

  var !tubeList vscan for all tubi
  if (undefined(!tubeList) or !tubeList.unset()) then
    return !result
  endif

  !maxLength = -999
  !dir2D = object DIRECTION()

  !maxFromPos = object POSITION()
  !maxToPos   = object POSITION()

  do !tubeName values !tubeList
    !ownerRef  = !tubeName.after('TUBI').dbRef()
    !tubeRef    = il tube of $!ownerRef

    !from3dPos = !tubeRef.aPos.wrt(world)
    !to3dPos   = !tubeRef.lPos.wrt(world)

    var !from2D shpos of $!from3dPos
    var !to2D   shpos of $!to3dPos

    !distance = !from2D.position().distance(!to2D.position())

    if (!maxLength lt !distance) then
      !maxLength = !distance
      !dir2D    = !from2D.position().direction(!to2D.position())
      handle any
      endhandle

      !maxFromPos = !from3dPos
      !maxToPos   = !to3dPos
    endif
  enddo

  if (!maxLength lt 0 or !dir2D.unset()) then
    return !result
  endif

  !isVertical   = !dir2D.dot(Y).abs() gt 0.999
  !isHorizontal = !dir2D.dot(X).abs() gt 0.999

  !additionalAngle = 0

  if (!viewIndex gt 1) then
    !!ce = !viewList[1]

    var !refFrom2D shpos of $!maxFromPos
    var !refTo2D   shpos of $!maxToPos

    if (!viewIndex eq 2) then
      if (!isHorizontal) then
        !tempLine = object LINE(!refFrom2D.position(), !refFrom2D.position().offset(N, 100mm))
        !refDir   = !tempLine.near(!refFrom2D.position()).direction(!tempLine.near(!refTo2D.position()))
        handle (2,891)
        elsehandle none
          if (!refDir.north.asin() gt 0) then
            if (!dir2D.east.asin() gt 0) then
              !result = 90
            else
              !result = -90
            endif
          else
            if (!dir2D.east.asin() gt 0) then
              !result = -90
            else
              !result = 90
            endif
          endif

          return !result
        endhandle

      elseif (!isVertical) then
        !tempLine = object LINE(!refFrom2D.position(), !refFrom2D.position().offset(N, 100mm))
        !refDir   = !tempLine.near(!refFrom2D.position()).direction(!tempLine.near(!refTo2D.position()))
        handle (2,891)
        elsehandle none
          if (!refDir.dot(!dir2D) gt 0.999) then
            !result = 0
          else
            !result = 180
          endif

          return !result
        endhandle
      endif
    elseif (!viewIndex eq 3) then
      if (!isHorizontal) then
        !tempLine = object LINE(!refFrom2D.position(), !refFrom2D.position().offset(E, 100mm))
        !refDir   = !tempLine.near(!refFrom2D.position()).direction(!tempLine.near(!refTo2D.position()))
        handle (2,891)
        elsehandle none
          if (!refDir.dot(!dir2D) gt 0.999) then
            !result = 0
          else
            !result = 180
          endif

          return !result
        endhandle
      elseif (!isVertical) then
        !tempLine = object LINE(!refFrom2D.position(), !refFrom2D.position().offset(E, 100mm))
        !refDir   = !tempLine.near(!refFrom2D.position()).direction(!tempLine.near(!refTo2D.position()))
        handle (2,891)
        elsehandle none
          if (!refDir.east.asin() gt 0) then
            if (!dir2D.north.asin() gt 0) then
              !result = -90
            else
              !result = 90
            endif
          else
            if (!dir2D.north.asin() gt 0) then
              !result = 90
            else
              !result = -90
            endif
          endif

          return !result
        endhandle
      endif
    endif

    SAME

    !isValidDist = !refFrom2D.position().distance(!refTo2D.position()) gt 0.5mm
    if (!isValidDist) then

      !baseDir = !refFrom2D.position().direction(!refTo2D.position())

      var !refFrom2D shpos of $!maxFromPos
      var !refTo2D   shpos of $!maxToPos


      !currentDir = !refFrom2D.position().direction(!refTo2D.position())
      !additionalAngle = !baseDir.angle(!currentDir)
      if (!additionalAngle gt 0.1mm and !baseDir.dot(!currentDir).abs() ne 1) then
        if (!baseDir.cross(!currentDir).dot(U) gt 0) then
          !additionalAngle = !additionalAngle * -1
        endif
      endif

    endif
  endif

  if (!additionalAngle ne 0) then
    !result = !additionalAngle
  endif

  if (!result.set()) then
    return !result
  endif

  if (!isVertical or !isHorizontal) then
    return !result
  endif

  !angle = !dir2D.angle(E)
  !cross = !dir2D.cross(E)

  if (!cross.up lt 0) then
    !angle = !angle * -1
  endif

  return !angle
endfunction
