--  Created:         14 April 2014
--
--  Description:     calculate cut length for elbow
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       elbow reference
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!pfcalculatecutlengthforelbow(!elbowRef is DBREF) is ARRAY
  !result  = object ARRAY()

  !savedUnits = object COMUNITS(true)

  units mm bore
--  units mm distance

  !aDir    = !elbowRef.aDir
  !lDir    = !elbowRef.lDir
  !orthDir = !elbowRef.ori.zDir()
  !acDir   = !aDir.cross(!orthDir)
  !lcDir   = !lDir.cross(!orthDir)

  !outDia     = !elbowRef.aOd

  !arriveInnerPos = !elbowRef.aPos.offset(!acDir, !outDia * 0.5 * -1)
  !arriveOuterPos = !elbowRef.aPos.offset(!acDir, !outDia * 0.5)

  !leaveInnerPos  = !elbowRef.lPos.offset(!lcDir, !outDia * 0.5 * -1)
  !leaveOuterPos  = !elbowRef.lPos.offset(!lcDir, !outDia * 0.5)

  !arriveLine = object LINE(!arriveInnerPos, !arriveOuterPos)
  !leaveLine   = object LINE(!leaveInnerPos, !leaveOuterPos)
  !centrePos  = !arriveLine.intersection(!leaveLine)

  !innerDistance  = !centrePos.distance(!arriveInnerPos)
  !centreDistance = !centrePos.distance(!elbowRef.aPos)
  !outerDistance  = !centrePos.distance(!arriveOuterPos)

  !angle = !elbowRef.angle  / 360 deg

  !insideLength  = min(2 * PI * !innerDistance  * !angle, 2 * PI * !outerDistance  * !angle)
  !centreLength  = 2 * PI * !centreDistance * !angle
  !outsideLength = max(2 * PI * !innerDistance  * !angle, 2 * PI * !outerDistance  * !angle)

  !savedUnits.restoreSavedUnitsByPtype('DIST')
  !savedUnits.restoreSavedUnitsByPtype('BORE')
  !savedUnits.restoreSavedUnitsByPtype('ANGL')

  !result.append(!insideLength.value().string(!!distanceFMT).real().value().string('D0'))
  !result.append(!centreLength.value().string(!!distanceFMT).real().value().string('D0'))
  !result.append(!outsideLength.value().string(!!distanceFMT).real().value().string('D0'))

  return !result
endfunction
