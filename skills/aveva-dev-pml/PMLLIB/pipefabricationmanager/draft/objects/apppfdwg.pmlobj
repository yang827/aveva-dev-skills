define object APPPFDWG
endobject


define method .apppfdwg()
endmethod

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !!pipeSetProductionCheckOption()

  if !!productionChecksEnabled then
    return
  endif

  if(!!module().productfamily.upCase() eq 'MARINE') then
    return
  endif

  !bmenu = object APPBARMENU()
  !bmenu.add(|Pipe Fabrication|, |PFDWG|)

  !!appMenuCntrl.addBarMenu(!bmenu, |ADPCORE|)

  !menu = object APPMENU(|PFDWG|)
  !menu.add(|CALLBACK|, |Pipe Spool Drawing...|, |!!pfPipeSpoolDrawing()|, |Pipe Spool Drawing...|)
  !!appMenuCntrl.addMenu(!menu, |ADPCORE|)
endmethod
-- End of method definition for .modifyMenus()
