--
--  Description:     Object used to evaluate expression
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  calcEvaluate(DBREF,STRING,STRING) STRING              calculate evaluate
--  checkInputArguments(DBREF,STRING) BOOLEAN             check input arguments
--  getEvaluateResult(DBREF,STRING,STRING) STRING              get evaluate result
--
------------------------------------------------------------------------
define object PFCOMEVALUATEEXPRESSION
  member .errorList is ARRAY
  -- evaluation result
  member .result    is STRING
endobject
-- End of object definition for PFCOMEVALUATEEXPRESSION

------------------------------------------------------------------------
--
-- Method:      checkInputArguments
--
-- Description: check element and query which used to be extract data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    DBREF      check element
--    1     R    STRING     query string
-- Return:
--   [Data Type] [Description]
--    1     R    BOOLEAN    return true if element and query is valid.
--
------------------------------------------------------------------------
define method .checkInputArguments(!entry is DBREF, !query is STRING) is BOOLEAN
  !this.errorList.clear()

 -- check element is valid or not
  if (!entry.badref()) then
    !!pfpipespooldwginserterror(!query, 'invalid element', !this.errorList)
--    !this.errorList.append(|invalid element|)
    return false
  endif

  -- check query string
  if (!query.empty()) then
    !!pfpipespooldwginserterror('-', 'query is empty', !this.errorList)
--    !this.errorList.append(|query is empty|)
    return false
  endif

  return true
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      calcEvaluate
--
-- Description: calculate evaluate
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    DBREF      source element for calculation with a query
--    2     R    STRING     query string
--    3     R    STRING     character to split query for defining attribute name, attribute value
-- Return:
--   [Data Type] [Description]
--    1     R    STRING     return evaluation value
------------------------------------------------------------------------
define method .calcEvaluate(!entry is DBREF, !query is STRING, !splitCharacter is STRING) is STRING
  if (!this.checkInputArguments(!entry, !query).not()) then
    return 'FAIL'
  endif

  !entryName = !entry.fullname

  -- get result from given function
  if (substring(!query,1,2) eq '!!') then
    !result = $!query
    handle (2,9)
      return |Too many values given for attribute on $!query|
    elsehandle any
      return |It was failed to get result using $!query on $!entryName|
    endhandle
  else
    !splitdata = !query.split(!splitCharacter)
    if (!splitdata.size() ne 2) then
      return |check query string : $!query, it should consist of attribute name and value|
    endif

    !attrName  = !splitdata[1]
    !attrValue = !splitdata[2]

    !attribute = !entry.attribute(!attrName)
    !dataType  = !attribute.objecttype()

    if (!dataType eq 'REAL') then
      !result = !attrValue.real()
    elseif (!dataType eq 'BOOLEAN') then
      !result = !attrValue.boolean()
    elseif (!dataType eq 'STRING') then
      !result = |$!attrValue|
    elseif (!dataType eq 'DBREF') then
      !result = !attrValue
    else
      return |The $!attrName on $!query cannot used to be extracted.|
    endif
  endif

  !entry.$!attrName = !result
  handle any
    return !!error.text
  endhandle

  return 'SUCCESS'
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getEvaluateResult
--
-- Description: get evaluate
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1     R    DBREF      source element for calculation with a query
--    2     R    STRING     query string
--    3     R    STRING     character to split query for defining attribute name, attribute value
-- Return:
--   [Data Type] [Description]
--    1     R    STRING     return evaluation value
------------------------------------------------------------------------
define method .getEvaluateResult(!entry is DBREF, !query is STRING, !splitCharacter is STRING) is STRING
  if (!this.checkInputArguments(!entry, !query).not()) then
    return ''
  endif

  !entryName = !entry.name

  -- get result from given function
  if (substring(!query,1,2) eq '!!') then
    !funcName     = !query.before('(')
    !argsStartPos = !query.match('(')
    !argsEndPos   = !query.match(')')
    if (!argsStartPos eq 0) then
--      !this.errorList.append(|check $!query|)
      !!pfpipespooldwginserterror(!entry.flnm, |check $!query|, !this.errorList)
      return ''
    endif

    -- get argument
    !argsStr = substring(!query, !argsStartPos + 1, !argsEndPos - !argsStartPos - 1)
    !args    = !argsStr.split(',')

    !firstArg = !args[1].upcase().trim()
--    !entryName = name of $!firstArg of $!entry
--    handle any
--    endhandle
    if (!firstArg.occurs('SHEE') gt 0) then
      !entryName = name of shee of $!entry
    endif

    if (!args.size() eq 1) then
      !result = $!evalStr
      handle any
        !result = ''
        !!pfpipespooldwginserterror(!entry.flnm, !!error.text, !this.errorList)
--        !this.errorList.append(|!!error.text & 'On ' & !entry.fullname|)
      endhandle
    elseif (!args.size() eq 2) then
      !evalStr = |$!funcName('$!entryName',$!args[2])|
      !result  = $!evalStr
      handle any
        !!pfpipespooldwginserterror(!entry.flnm, |check $!query|, !this.errorList)
--        !this.errorList.append(|check $!query|)
        !result = ''
      endhandle
    elseif (!args.size() eq 3 and !args[3] eq |'|) then
      !args[2] = !args[2] & ',' & |'|
      !evalStr = |$!funcName('$!entryName',$!args[2])|
      !result  = $!evalStr
      handle any
        !!pfpipespooldwginserterror(!entry.flnm, |check $!query|, !this.errorList)
--        !this.errorList.append(|check $!query|)
        !result = ''
      endhandle
    else
      -- for bar code
      !evalStr = |$!funcName('$!entryName', $!args[1], $!args[2], $!args[3], $!args[4], $!args[5], $!args[6])|
      !result  = $!evalStr
      handle any
        !!pfpipespooldwginserterror(!entry.flnm, |check $!query|, !this.errorList)
--        !this.errorList.append(|check $!query|)
        !result = ''
      endhandle
    endif

    -- remove units : ex) 10mm -> 10
    !tempResult = !result.real()
    handle any
    elsehandle none
      !result = !tempResult.value().string()
    endhandle

    return !result
  endif

  -- get result from attribute
  !mem = !!ce
  !!ce = !entry

  !splitPos = !query.match(!splitCharacter)
  if (!splitPos eq 0) then
--    !this.errorList.append(|check split character|)
    !!pfpipespooldwginserterror('', |check split character|, !this.errorList)
    return ''
  endif

  !attQuery = substring(!query, !splitPos + 1)
  if (!query.occurs('.') gt 1) then
    !attribute = !entry.$!attQuery
    handle (2,754)
      !!pfpipespooldwginserterror(!attQuery, |undefined UDA|, !this.errorList)
    elsehandle any
      !!pfpipespooldwginserterror(!attQuery, !!error.text, !this.errorList)
      return ''
    endhandle
  else
    !attribute = !entry.attribute(!attQuery)
    handle (2,805)
      !!pfpipespooldwginserterror(!attQuery, |invalid attribute name|, !this.errorList)
--      !this.errorList.append(|$!attQuery is invalid attribute name|)
      return ''

    elsehandle (99,532)
      !!pfpipespooldwginserterror(!attQuery, |undefined UDA|, !this.errorList)
--      !this.errorList.append(|$!attQuery is undefined UDA or UDET|)
      return ''
    elsehandle any
      !!pfpipespooldwginserterror(!attQuery, !!error.text, !this.errorList)
      return ''
    endhandle
  endif

  $!mem
  return !attribute.string()
endmethod
-- End of method
