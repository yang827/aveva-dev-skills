--
--  File:            pfPipeSpoolDwg.pmlobj
--    Type:          Object Definition
--    Group:         PIPE
--      Keyword:     PIPE
--    Module:        draft
--  Author:          Daniel(Jaehun Choi)
--  Created:         23 July 2010
--
--  Description:     Object used to pipe spool drawing
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arrangeLabelTask(DBREF)          -                   arrange label task
--  calculateSingleViewProperties(ARRAY) -
--  checkForIsoAndBoss()             -                   checks for the existence of a boss and isometric view
--  checkLooseData(DBREF)            -                   check loose information
--  createResultFile()               -                   create result file
--  displayDrawingInformation(STRING) -                   display drawing information
--  displayExtraInformation(STRING)  -                   display extra information
--  evaluateActivateValue(STRING)    STRING
--  evaluateAdditionalPosData()      -
--  evaluateElbowAngleOnCata(DBREF)  REAL                evaluate elbow angle from Catalogue
--  evaluateSpoolEndData(DBREF)      ARRAY
--  executeTasks()                   -
--  getAssemblyTable()               ARRAY               get assembly table
--  getBendingTable()                ARRAY               get bending table
--  getCentrePosOnPipePiece(DBREF)   POSITION
--  getDrawingInfoTable()            ARRAY               get drawing information table
--  getElboCutTable()                ARRAY
--  getEndpointTable()               ARRAY               get end-point table
--  getMtoElements()                 -
--  getMtoTable()                    ARRAY               get mto table
--  getPieceCutTable()               ARRAY
--  getPrefixForAssemblyTable(DBREF,STRING) STRING
--  getTaskParameter(DBREF)          ARRAY               get Task Parameter
--  getWeldingTable()                ARRAY               get welding table
--  initializeDrawing()              BOOLEAN             initialize drawing
--  isValidVolume(DBREF)             BOOLEAN             check whether an element has valid volume
--  makeUnderlyingDrwg(DBREF,STRING) STRING              make underlying drawing
--  markAdditionalSpoolInfo(DBREF)   -                   mark additional spool information
--  markBendingTable()               -                   mark bending Table
--  markEndPointConnection(DBREF,DBREF) -                   mark end point connection
--  markPartNo(DBREF)                -                   mark part no
--  markShipPositionOnComponent(DBREF) -                   mark ship position on component for iso-drawing
--  markSpoolDim(DBREF,DBREF,DBREF)  -                   mark spool dimension on a view
--  markWeldingTable(ARRAY)          -                   mark welding table
--  pfPipeSpoolDwg()                 -                   constructor
--  pfPipeSpoolDwg(STRING)           -                   constructor using explicit unique ID of calling process when run in a background
--  setSameScales(DBREF,ARRAY)       -
--  updateLooseInfo(DBREF,REAL)      -                   update loose information
--  updateSpoolInformation(ARRAY)    -                   update spool information
--  writeErrorMessage(ANY,STRING)    -                   write error message
--  writeTableData(ARRAY,STRING)     -                   write table data
--
------------------------------------------------------------------------

define object PFPIPESPOOLDWG
  member .spoolElement        is DBREF

  -- it used to be referenced when define dept,regi name and overlay for iso picture
  member .isoOptionFile       is FILE

  -- it used to be checked if create spool drawing is complete or not
  -- because, there is only this method to check it on outfitting design module on current version.
  -- it'll be removed if command of outfitting draft can use on outfitting design like isodraft mode in future
  member .resultList          is FILE

  member .regiName            is STRING
  member .deptName            is STRING
  member .dwgTmplName         is STRING

  member .pltFileDir          is STRING
  member .pipeSpoolType       is STRING

  member .outputUnits         is STRING

  member .invalidShopElement  is ARRAY

  member .mtoElements         is ARRAY
  member .queryElements       is ARRAY

  member .noteRef             is DBREF

  member .errorList           is ARRAY
  member .errorLogFile        is FILE

  member .isSketchType        is BOOLEAN

  -- it used to be evaluate a expression
  member .evaluateExpression  is PFCOMEVALUATEEXPRESSION
  member .pipeSpoolManager    is PIPESPOOLMANAGER

  if(!!module().productfamily.upCase() eq 'MARINE') then
    member .marDraDraftingApi   is MARDRADRAFTINGAPI
    member .marPtype            is REAL
    member .isMarEnvMode        is BOOLEAN
  endif

  member .pdmsUserPath        is STRING
  member .isGraphicalMode     is BOOLEAN
  member .previewDirPath      is STRING

  member .posDataElements     is ARRAY
  member .posDataContents     is ARRAY

  member .threadConnectionTypes is ARRAY

  member .pfmDefaults           is PFCONTEXT

  member .distanceUnit          is STRING
  member .quantityUnit          is STRING
  member .namingRuleDefPath     is STRING
  member .limitTextLengthDesc   is REAL

  member .assemblyTables        is ARRAY

  member .fileManager           is PFFILEMANAGER
endobject
-- End of object definition for pfPipeSpoolDwg

------------------------------------------------------------------------
--
-- Method:      pfPipeSpoolDwg
--
-- Description: Constructor
--
------------------------------------------------------------------------
define method .pfPipeSpoolDwg()
  !this.pdmsUserPath = !!evarSplit('PDMSUSER')[1]

  var !uniqueId unique
  !this.pfPipeSpoolDwg(!uniqueId)

  !currUnit = object COMUNITS(TRUE)
  !this.distanceUnit = !currUnit.getcurrentunitsbyptype('DIST').upCase()
  handle any
    !this.distanceUnit = 'MM'
  endhandle

  !this.quantityUnit = 'EA'
  !this.limitTextLengthDesc = object REAL()

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      pfPipeSpoolDwg
--
-- Description: constructor using explicit unique ID of calling process when run in a background
--
------------------------------------------------------------------------

define method .pfPipeSpoolDwg(!uniqueId is STRING)


  !this.resultList = object FILE('$!this.pdmsUserPath/' & !uniqueId & 'pspooldwgresult.log')
  !this.errorLogFile = object FILE('$!this.pdmsUserPath/' & !uniqueId & 'pspooldwgerror.log')

  !currUnit = object COMUNITS(TRUE)
  !this.distanceUnit = !currUnit.getcurrentunitsbyptype('DIST').upCase()
  handle any
    !this.distanceUnit = 'MM'
  endhandle

  !this.quantityUnit = 'EA'

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initializeDrawing
--
-- Description: initialize drawing - ensures that required elements are
-- in place before starting to draw.
--
--
------------------------------------------------------------------------
define method .initializeDrawing() is BOOLEAN

  !this.mtoElements.clear()

  -- load thread key
  !this.threadConnectionTypes.clear()
  !threadTableOwner = !!collectAllFor('DDSE', |upcase(func) eq 'THREAD'|, world)
  if (!threadTableOwner.set()) then
    !members = !threadTableOwner[1].members
    do !entry values !members
      !connectionType = !entry.dKey
      !this.threadConnectionTypes.append(!connectionType)
    enddo
  endif

  var !device device
  if (!device.upCase() eq 'GRAPHICS') then
    !this.isGraphicalMode = true
  else
    !this.isGraphicalMode = false
  endif

  !readData = !this.isoOptionFile.readFile()
  handle (41,319)
    !this.writeErrorMessage(!this.isoOptionFile,'Error creating underlying drawing  - failed to load iso option file')
    return false
  endhandle

  !marEnvDept = ''
  !marEnvRegi = ''

  do !data values !readData
    if (!data.upCase().occurs('DWGTYPE') gt 0) then
      !this.dwgTmplName  = !data.part(2,',')

    elseif (!data.upCase().occurs('DWGDEPTNAME') gt 0) then
      !loadDeptName = !data.part(2,',')
      if (substring(!loadDeptName,1,1) ne '/') then
        !loadDeptName = '/' & !loadDeptName
      endif

    elseif (!data.upCase().occurs('DWGREGINAME') gt 0) then
      !loadRegiName = !data.part(2,',')
      if (substring(!loadRegiName,1,1) ne '/') then
        !loadRegiName = '/' & !loadRegiName
      endif

    elseif (!data.upCase().occurs('ISOFILEPATH') gt 0) then
      !this.pltFileDir = !data.part(2,',')
      !this.previewDirPath = !this.pltFileDir & |\preview\|

    elseif (!data.upCase().occurs('OUTPUTUNITS') gt 0) then
      !this.outputUnits = !data.part(2,',').upCase()

    elseif (!data.upCase().occurs('USEMARENV') gt 0) then
      !this.isMarEnvMode = !data.part(2,',').boolean()

    elseif (!data.upCase().occurs('MARENVDEPT') gt 0) then
      !marEnvDept = !data.part(2,',')

    elseif (!data.upCase().occurs('MARENVREGI') gt 0) then
      !marEnvRegi = !data.part(2,',')

    elseif (!data.upCase().occurs('NAMINGRULE') gt 0) then
      !this.namingRuleDefPath = ''

      !tempFile = object FILE(!data.part(2,','))
      handle any
      elsehandle none
        if (!tempFile.exists()) then
          !this.namingRuleDefPath = !data.part(2,',')
        endif
      endhandle
    endif
  enddo
  -- sort out the plotfile directory
  !this.fileManager = object PFFILEMANAGER(!this.spoolElement, !this.pltFileDir, !loadRegiName, !loadDeptName )

  if(!!module().productfamily.upCase() eq 'MARINE') then
    if (!this.isMarEnvMode) then
      !this.fileManager.departmentName = !marEnvDept
      !this.fileManager.regiName = !marEnvRegi
    endif
  endif

  -- check whether consistency check result will be marked or not
  !this.pfmDefaults = object PFCONTEXT()
  !this.pfmDefaults.initialize()

  -- checking drawing template
  !checkDwgTmpl = !this.dwgTmplName.dbRef()
  handle any
    !this.writeErrorMessage(!this.dwgTmplName, 'Error creating underlying drawing - Invalid Reference.')
    return false
  elsehandle none
    if (!checkDwgTmpl.badRef()) then
      !this.writeErrorMessage(!this.dwgTmplName, 'Error creating underlying drawing - Invalid Reference.')
      return false
    endif
  endhandle

  !this.pltFileDir = !this.fileManager.plotDirectory.fullName()

  return true

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      makeUnderlyingDrwg
--
-- Description: make underlying drawing
-- This is called by makeUnderlyingDrwg Function which runs in batch mode
--
------------------------------------------------------------------------
define method .makeUnderlyingDrwg(!element is DBREF, !isoOptionFilePath is STRING) is STRING
  warning off
  trace off

  var !spooldebug evar 'TRACE_SPOOLDRAWINGS'
  if !spooldebug.neq('') then
    $r101/c:\temp\makeUnderlyingDrwgmethod.pmldat
  endif

  !this.errorList.clear()
  !resultPath = STRING()

  !dept = nulref
  !regi = nulref
  !dwg  = nulref

  -- set spool element
  !this.spoolElement = !element
  !this.isoOptionFile = object FILE(!isoOptionFilePath)

  !this.limitTextLengthDesc = object REAL()

  --set up format objects
  !!setGlobalFormats()

  -- Initialise Drawing - make sure that all pre-requisites are in place before drawing
  if (!this.initializeDrawing().not()) then
    -- if there is a problem, create a results file and return
    !this.createResultFile()
    return !resultPath
  endif

  -- derive the default drawing name
  if (!this.spoolElement.isNamed) then
    !baseDwgName = !this.spoolElement.name & '_Spool'
  else
    !baseDwgName = '/' & !this.spoolElement.refNo.string().replace('/','_') & '_Spool'
  endif

  !baseDwgName = !baseDwgName.replace('#','_')

  -- derive a rule based drawing name
  if (!this.namingRuleDefPath.empty().not()) then
    !dwgName = !!pfEvaluateSketchName(!this.namingRuleDefPath, !this.spoolElement, !this.errorList)
    if (!dwgName.empty()) then
      !dwgName = !baseDwgName
    endif
  else
    !dwgName = !baseDwgName
  endif

  -- save work to flush old SDB files in Marine Drafting
  if (!!module().modKey.upCase() eq 'MARDRA') then
    SAVEWORK
    handle any
    endhandle
  endif
  -- check DEPT if exists

  !deptString = !this.fileManager.departmentName
  if !deptString.eq('') then
    -- stop it creating a blank registry
  else
    !dept = !deptString.dbRef()
    handle ANY
    endhandle

    if !dept.badRef() then
      context draw
      new DEPT $!this.fileManager.departmentName
      handle ANY
        !this.writeErrorMessage(!this.fileManager.departmentName, 'Error creating underlying drawing - Cannot Create Department.')
        !this.createResultFile()
        return !resultPath
      endhandle
      !dept = !!ce
    endif
  endif

  -- check REGI if exists
  !regiString = !this.fileManager.regiName
  !regi = !regiString.dbRef()
  handle ANY
  endhandle
  if !regi.badRef() then
    !!ce = !dept
    new REGI $!this.fileManager.regiName
    handle ANY

      !this.writeErrorMessage(!this.fileManager.regiName, 'Error creating underlying drawing - Cannot Create Registry.')
      !this.createResultFile()
      return !resultPath
    endhandle
    !regi = !!ce
  else
    if !regi.owner.neq(!dept) and !this.isGraphicalMode then
      !!alert.error('Error creating underlying drawing - Registry $!this.fileManager.regiName appears under different Department than $!this.fileManager.departmentName')
      !this.createResultFile()
      return !resultPath
    endif
  endif

  -- check DRWG if exists
  !dwg = !dwgName.dbRef()
  handle ANY
  endhandle
  if !dwg.badRef() then
    !!ce = !regi
    new DRWG $!dwgName
    handle any
      !this.writeErrorMessage(!!ce, 'Cannot use drawing name ' & !!error.text)
      name $!baseDwgName
      handle any
        $!baseDwgName
        handle any
          return
        endhandle

        delete DRWG
        handle ANY
          !this.writeErrorMessage(!!ce, !!error.text)
          !this.createResultFile()
          return !resultPath
        endhandle
      endhandle
    endhandle
    !dwg = !!ce
  else
    -- check if read-write
    !!ce = !dwg

    delete DRWG
    --delete DRWG memb
    handle ANY
      !this.writeErrorMessage(!!ce, 'Error modify underlying drawing. ' & !!error.text)
      !this.createResultFile()
      return !resultPath
    endhandle

    if (!!module().modKey.upCase() eq 'MARDRA') then
      SAVEWORK
      handle any
      endhandle
    endif

    new DRWG $!dwgName
    handle any
      !this.writeErrorMessage(!!ce, 'Cannot use drawing name ' & !!error.text)
      name $!baseDwgName
      handle any
        $!baseDwgName

        delete DRWG
        handle ANY
          !this.writeErrorMessage(!!ce, !!error.text)
          !this.createResultFile()
          return !resultPath
        endhandle
      endhandle
    endhandle

    !dwg = !!ce

    if !dwg.owner.neq(!regi) then
      !!ce = !regi
      include $!dwg
      handle ANY
        !!ce = !regi
        new DRWG
        handle ANY
          !this.writeErrorMessage(!dwg, 'Error modify underlying drawing - cannot move existing ' & !dwg.namtyp & ' to Registry ' & !this.fileManager.regiName & '.')
          !this.createResultFile()
          return !resultPath
        endhandle
        !deleteDwg = !dwg
        !dwg = !!ce
        !!ce = !deleteDwg
        delete DRWG

        -- this step have to prepaired to flush wasted SDB files
        if (!!module().modKey.upCase() eq 'MARDRA') then
          SAVEWORK
          handle any
          endhandle
        endif

        !dwg.name = !dwgName
        handle any
          name $!baseDwgName
          handle any
            !this.writeErrorMessage(!!ce, !!error.text)
            !this.createResultFile()
            return !resultPath
          endhandle
        endhandle
      endhandle
      !!ce = !dwg
    endif
  endif

  !!ce.linkref = !this.dwgTmplName.dbRef()

  !dwgName = !dwg.flnm

  -- copy DRWG from template
  copy $!this.dwgTmplName rename $!this.dwgTmplName $!dwgName

  !drawingType = !!ce.func
  if (!drawingType.upCase().occurs('2D SKETCH') gt 0) then
    !isSketchType = true
  else
    !isSketchType = false
  endif

  !this.isSketchType = !isSketchType

  !sheetRef = sheet 1

  if (!sheetRef.bsrf.badRef()) then
    !!alert.error('Backing sheet reference was broken. Please check Backing sheet reference on the drawing template')
    return
  endif

  if(!!module().productfamily.upCase() eq 'MARINE') then
    if (!this.marPtype.unset()) then
      !this.marPtype = 7
    endif
  endif

  if (!!module().modKey.upCase() eq 'MARDRA') then
    !!ce = !sheetRef
    input begin
    marPtype $!this.marPtype
    input finish
    same
  endif

  -- CW - P-40137 - Fix to Add date and Loginname to pipesketch

  !session = current session
  !n = !session.name
  !!ce.author = !n

  !a = object DATETIME()
  !b = !a.date() & ' ' & !a.monthstring().substring(1,3) & ' ' & !a.year()
  !!ce.date = !b

  !name = !!ce.name
  !title = !name.after('/').before('_Spool').replace('#','_')

  !!ce.title = !title
  --navigate to sheet level
  1
  !!ce.title = !title

  --navigate back to drg level
  end
  update anno

  !this.evaluateAdditionalPosData()

  -- view update
  var !viewList coll all view for drwg

  !createOption      = !sheetRef.func.split(';')
  if (!createOption.set()) then
    !matchSameScale  = (!createOption[1].upCase().trim() eq 'SAME-SCALE' OR !createOption[1].upCase().trim() eq '')
  else
    !matchSameScale  = false
  endif

  !isFourView          = false
  !isNoneFixedViewDirs = false
  if (!createOption.size() gt 1) then
    !isFourView   = !createOption[2].upCase().trim() eq 'FOUR_VIEWS_ON'

    if (!createOption.size() gt 2) then
      !isNoneFixedViewDirs = !createOption[3].upCase().trim() eq 'FIXED_VIEW_DIR'
    endif
  endif

  !viewDirections = object ARRAY()
  if (!isSketchType) then
    if (!isNoneFixedViewDirs) then
      var !viewDirections eval dir for all view for $!sheetRef
    else
      !viewDirections = !!pfGetViewDirections(!this.spoolElement, !isFourView)
    endif
  endif
  !oriDirections = !viewDirections

  if (!isFourView.not() and !isSketchType and !viewDirections.size() eq 1) then
    !this.calculateSingleViewProperties(!viewList)
  endif

  -- set draw-list on view
  do !i indices !viewList
    !view     = !viewList[!i].dbRef()
    !!ce  = !view

    dir $!viewDirections[$!i]
    handle any
    endhandle

    if (!view.func ne 'ISO_VIEW') then
      -- add item on drawlist
      goto idlname
      delete idli mem
      new adde

      !!ce.idna = !this.spoolElement

      !!ce = !view

      auto
      handle any
      endhandle

      update desi
      handle any
      endhandle

      if (!i le !viewDirections.size() and !isNoneFixedViewDirs.not()) then
        !adeg = !!pfCalculateAdeg(!!ce)
        if (!adeg.set()) then
          !!ce = !view
          if (!i.eq(2)) then
            !adeg = !viewDirections[3].direction().angle(object DIRECTION(|Z|)) - 180
            if (!oriDirections[3].direction().angle(object DIRECTION(|Z|)) inset (0,180)) then
            else
              adeg $!adeg
            endif
          else
            adeg $!adeg
          endif
        endif
      endif
    else
      !userLabelLayer = object DBREF(!view.name & '/USER_Labs')
      handle (2,109)
        -- there is no user label layer for the view
      elsehandle none
        !userLabelLayer.lvis = false
      endhandle
    endif

    if (!isSketchType) then
      !!ce = !view
      lvis true
      lframe false
      !this.markAdditionalSpoolInfo(!view)
    else
      -- invisible overlay area
      !overlayAreaLayer = object DBREF(!view.name & '/Overlay')
      handle (2,109)
        -- there is no overlay element for displaying iso plot file
      elsehandle none
        !overlayAreaLayer.lvis = false
      endhandle
    endif

    !!ce = !view

    if (!i eq 1 and !viewDirections.size() gt 1 and !isNoneFixedViewDirs.not()) then
      var !viewRightDir viewDir Right
      var !viewDownDir  viewDir Down
      !viewDirections[2] = !viewRightDir
      !viewDirections[3] = !viewDownDir

    endif


    !this.executeTasks()

  enddo

  -- set all the view scales to the same
  if (!matchSameScale) then
    !this.setSameScales(!sheetRef, !viewList)
  endif

  !!ce = !sheetRef

  update all
  handle any
  endhandle

  -- this is about dxf plots depending on an evar 'PF_CONVERT_PLT' - this needs to be tested against the new preview options
  !convertPltFlag = true
  var !convertPltFlagStr evar 'PF_CONVERT_PLT'
  handle any
  elsehandle none
    if (!convertPltFlagStr.empty().not()) then
      !convertPltFlag = !convertPltFlagStr.boolean()
    endif
  endhandle

  if (!isSketchType.not()) then

    -- we are using an overlay drawing
    if(!!module().productfamily.upCase() ne 'MARINE' or !convertPltFlag.not()) then
      --    if (!!module().modKey.upCase() eq 'MARDRA') then
      -- create olay for displaying iso drawing if current drawing type is iso spool drawing
      !olayName = !dwgName & '/Overlay'
      new olay $!olayName
      !olayPath = !this.fileManager.overlayFileName
      Osfname /$!olayPath
      handle any
        !this.writeErrorMessage(!olayPath, 'Error creating underlying drawing - Failure of loading overlay file')
        handle any
        endhandle
      endhandle
    else
      if (!convertPltFlag) then
        -- in a marine environment this is set to true by default
        !saveCe = !!ce
        !doneFile = object FILE('$!this.fileManager.pdmsUserPath\isoviewname.log')
        if (!doneFile.exists()) then
          if (!this.spoolElement.isNamed) then
            !spoolName = !this.spoolElement.namn
          else
            !spoolName = !this.spoolElement.refNo.string()
          endif
          !data[1] = !this.fileManager.isoDirectory.string()
          !data[2] = !this.fileManager.dxfName & '.iso.dxf'

          -- place the iso view
          !!pfPipePlaceIsoView(!sheetRef.name, !spoolName, !data)
        endif
        !!ce = !saveCe
        handle any
        endhandle
      endif
    endif
  endif

  if(!!module().productfamily.upCase() eq 'MARINE') then
    -- set draw-list on view
    do !viewName values !viewList
      !viewRef = !viewName.dbRef()
      !!mardradrawviewframe(!viewRef)
      handle any
      endhandle
    enddo
  endif

  -- update mto and other list on the drawing
  if (!sheetRef.bsrf.badRef()) then
    write 'BSRF was broken'
    return ''
  endif

  !sourceNoteTitles = !!collectAllFor('NOTE',|sppurp eq 'TABLE' and func ne ''|, !sheetRef.bsrf)
  !sourceNoteList   = !!collectAllFor('NOTE',|sppurp eq 'CELLS' and func ne ''|, !sheetRef.bsrf)

  !displayList = object ARRAY()
  !unitTextRef = object DBREF()

  !!ce = !sheetRef

  do !i index !sourceNoteList
    ----  do !entry values !sourceNoteList
    !sourceTitleRef = !sourceNoteTitles[!i]
    !sourceNoteRef  = !sourceNoteList[!i]

    skip if (!sourceTitleRef.func ne !sourceNoteRef.func)

    if (!sourceNoteRef.func eq 'MTO' and !unitTextRef.badRef()) then
      !unitTextRef = !!collectAllFor('TEXP', |matchw(upcase(etext), '*-DIST/*')|, !sourceNoteRef)[1]
      handle any
      endhandle
    endif

    if (!sourceTitleRef.lvis.not()) then
      !tempList = !sourceTitleRef.name.split('/')
      !newNote  = '/' & !dwgName & '/' & !tempList.last()
      !noteName = !sourceTitleRef.name
      new note $!newNote copy $!noteName ren $!noteName $!newNote
      handle (41,12)
        new note copy $!noteName
      endhandle
      if (!sourceTitleRef.func eq 'BENDINGA' and !this.pfmDefaults.xyzBendingTable) then
        !feedTextRef = !!collectAllFor('TEXP', |upcase(BTEXT) eq 'FEED'|, !!ce)[1]
        handle any
        elsehandle none
          !feedTextRef.bText = 'X'
        endhandle

        !rotateTextRef = !!collectAllFor('TEXP', |upcase(BTEXT) eq 'ROTATE'|, !!ce)[1]
        handle any
        elsehandle none
          !rotateTextRef.bText = 'Y'
        endhandle

        !bendTextRef = !!collectAllFor('TEXP', |upcase(BTEXT) eq 'BEND'|, !!ce)[1]
        handle any
        elsehandle none
          !bendTextRef.bText = 'Z'
        endhandle
      endif

      LVIS TRUE
    endif

    !tempList = !sourceNoteRef.name.split('/')
    !newNote  = '/' & !dwgName & '/' & !tempList.last()
    !noteName = !sourceNoteRef.name

    new note $!newNote copy $!noteName ren $!noteName $!newNote
    handle (43,364)
    endhandle

    LVIS TRUE

    -- add display detail list (Material list, etc..)
    !table[1] = !!ce.function.upCase()
    !table[2] = !!ce

    !displayList.append(!table)
  enddo

  -- define units for drawing
  if (!unitTextRef.badRef().not() and !unitTextRef.eText.empty().not()) then
    !distanceUnit = !unitTextRef.eText.part(1,'-')
    if (!distanceUnit.upCase() ne 'UNIT') then
      !this.distanceUnit = !distanceUnit
    endif
    !this.quantityUnit = !unitTextRef.eText.part(2,'-').after('/')
  endif

  !noteFunctions = 'MTO,OTHERDATA,BENDING,BENDINGA,ASSEMBLY,ENDPOINT,WELDING,ELBOCUTINFO,PIECECUTINFO'
  !functionList  = !noteFunctions.split(',')

  !this.getMtoElements()

  do !item values !displayList
    !this.noteRef = !item[2]

    !index = !functionList.findFirst(!item[1])

    skip if (!index.unset())
    !this.displayDrawingInformation(!functionList[!index])
  enddo

  -- added by daniel to cover barcode
  !barCodeNoteList = !!collectAllFor('NOTE',|sppurp eq 'BARC'|, !sheetRef.bsrf)
  if (!barCodeNoteList.set()) then
    !tmpList    = !barCodeNoteList[1].name.split(|/|)
    !newNote    = |/| & !dwgName & !tmpList.last()
    !sourceNote = !barCodeNoteList[1].name

    new note $!newNote copy $!sourceNote ren $!sourceNote $!newNote
    handle (43,364)
    endhandle

    lvis true
    !sourceTextList = !!collectAllFor('TEXP', '', !!ce)

    !textList = !!collectAllFor('TEXP', '', !barCodeNoteList[1])
    do !i index !textList
      !entry   = !textList[!i]
      !evalStr = !entry.eText

      if (!evalStr.unset() or !evalStr.empty()) then
        !result = ''
      else
        !result = !this.evaluateExpression.getEvaluateResult(!sourceTextList[!i], !evalStr, '.').replace('#','##')
      endif

      !sourceTextList[!i].bText = |$!result|
    enddo
  endif

  if (!this.spoolElement.psarfa[1].hardType eq 'BRAN') then
    !consistencyCheckResult = !this.spoolElement.psarfa[1].:PFConsChk
  else
    !consistencyCheckResult = !this.spoolElement.psarfa[1].owner.:PFConsChk
  endif

  if (!this.pfmDefaults.allowConsCheckDrawing) then
    if (!this.spoolElement.psarfa[1].hardType eq 'BRAN') then
      !consistencyCheckResult = !this.spoolElement.psarfa[1].:PFConsChk
    else
      !consistencyCheckResult = !this.spoolElement.psarfa[1].owner.:PFConsChk
    endif
    !!pfMarkConsistencyResultOnDrawing(!sheetRef, !consistencyCheckResult)
  endif

  !resultPath = ''
  if(!!module().productfamily.upCase() ne 'MARINE') then

    !file = !this.fileManager.plotFile
    !oldFile = !file
    if !oldFile.exists() then
      !oldFile.deleteFile()
      if !oldFile.exists() then
      endif
    endif
    -- make the new PDF file
    PLOT shee PDF "$!file" 'COLOUR STANDARD,ISOCOL,NOVIEW' A4V over
    handle any
    endhandle
  endif

  if (!!module().modKey.upCase() NE 'MARDRA' and !this.isGraphicalMode.not()) then
    savework
    handle any
    endhandle
  else
    if (!!module().modKey.upCase() eq 'MARDRA') then
      if (!this.marDraDraftingApi.mDraft[1].dwgCurrent()) then
        !this.marDraDraftingApi.mDraft[1].dwgSave()
        handle any
        endhandle
      else
        savework
        handle any
        endhandle
      endif
    endif
  endif

  -- save the tiff file
  if(!!module().productfamily.upCase() eq 'MARINE') then
    !!pfcreatepreviewimage(!this.namingRuleDefPath, !this.spoolElement, !this.fileManager.plotDirectory.string() & '\')
  endif

  !this.executeTasks()

  !!ce = !sheetRef.owner

  !this.executeTasks()

  -- Test if drawing template contains an isometric view and spool contains a boss connection.
  !this.checkForIsoAndBoss()

  !this.createResultFile()

  return !resultPath

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      .calculateSingleViewProperties
-- Description: sets view properties size and centre pos
--
------------------------------------------------------------------------
define method .calculateSingleViewProperties(!viewList is ARRAY)

  !xList = object ARRAY()
  !yList = object ARRAY()

  !xPosList = object ARRAY()
  !yPosList = object ARRAY()

  do !viewName values !viewList
    !viewRef   = !viewName.dbRef()

    !viewPos   = !viewRef.xyPos

    !xPos = !viewPos.east
    !yPos = !viewPos.north

    !viewWidth = !viewRef.size[1]
    !viewHeight= !viewRef.size[2]

    !xMin = !xPos -  ( !viewWidth * 0.5 )
    !xMax = ( !viewWidth * 0.5 )  + !xPos
    !yMin = !yPos - ( !viewHeight * 0.5 )
    !yMax = ( !viewHeight * 0.5 ) + !yPos

    !xList.append(!xMin)
    !xList.append(!xMax)
    !yList.append(!yMin)
    !yList.append(!yMax)

    !xPosList.append(!xPos)
    !yPosList.append(!yPos)
  enddo

  !xList.sort()
  !yList.sort()
  !xPosList.sort()
  !yPosList.sort()

  !viewSize[1] = !xList.last() - !xList.first()
  !viewSize[2] = !yList.last() - !yList.first()

  !xCentrePos = ( !xPosList.last() + !xPosList.first() ) * 0.5
  !yCentrePos = ( !yPosList.last() + !yPosList.first() ) * 0.5

  !saveCe = !!ce

  !!ce = !viewList[1].dbRef()

  !viewList[1].dbRef().size = !viewSize

  xyPos $!xCentrePos $!yCentrePos

  do !i from !viewList.size() to 2 by -1
    !viewRef = !viewList[!i].dbRef()
    !!ce = !viewRef
    delete VIEW
    !viewList.remove(!i)
  enddo

  !tagLayers = !!collectAllFor('LAYE',|purp eq 'LABA'|, !!ce)
  if (!tagLayers.set()) then
    !!ce = !saveCe
    return
  endif

  !!ce = !viewList[1].dbRef()

  FUNC 'SINGLE'

  !tagLayerName = !!ce.name & '\Tags'
  var !exist exist $!tagLayerName
  if (!exist eq 'TRUEA') then
    !tagLayerName = ''
  endif

  NEW LAYE
  if (!tagLayerName.empty().not()) then
    name $!tagLayerName
  endif

  PURP LABA

  !!ce = !saveCe
  handle any
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      setSameViewScales
-- Description: find the smallest scale and set all the other views to this
--
------------------------------------------------------------------------
define method .setSameScales(!sheet is DBREF,!viewList is ARRAY)
  var !viewScales eval vscal for all view for $!<sheet>
  !viewScaleList = !viewScales.evaluate(object BLOCK(|!viewScales[!evalIndex].real()|))
  if(!viewScaleList.size() eq 1) then
    !minViewScale = !viewScaleList[1] * 0.75
  else
    !minViewScale = !viewScaleList.sort()[1]
  endif

  do !viewName values !viewList
    !!ce = !viewName.dbRef()
    vscale $!minViewScale
    update desi
    handle any
    endhandle
  enddo

endmethod


------------------------------------------------------------------------
--
-- Method:      createResultFile
--
-- Description: create result file
--
--
------------------------------------------------------------------------
define method .createResultFile()
  -- append error list to error file
  !this.errorLogFile.writeFile('append',!this.errorList)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getTaskParameter
--
-- Description: get Task Parameter
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getTaskParameter(!taskRef is DBREF) is ARRAY
  !parameter = object ARRAY()

  do !tkpara value !taskRef.mem
    !index = !parameter.size() + 1
    !parameter[!index] = object ARRAY()
    !parameter[!index].append(!tkpara.function)
    !parameter[!index].append(!tkpara.pType)
    !parameter[!index].append(!tkpara.tpValue)
  enddo

  return !parameter
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      markSpoolDim
--
-- Description: mark spool dimension on a view
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .markSpoolDim(!taskRef is DBREF, !spoolRef is DBREF, !viewRef is DBREF)
  !!ce = !viewRef

  !spoolDim = object PFPIPESPOOLDIMENSION()
  !spoolDim.dimOptions = !this.getTaskParameter(!taskRef)
  !spoolDim.spoolRef   = !spoolRef

  !spoolDim.createDimension(!viewRef)

  !dimRefList = !!collectAllFor('LDIM','', !viewRef)

  if (!dimRefList.unset()) then
    return
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      .evaluateAdditionalPosData()
--
-- Description:
--
------------------------------------------------------------------------
define method .evaluateAdditionalPosData()

  !spoolRef = !!ce

  !pipeSpoolManager = object PFPIPESPOOLMANAGER()
  !this.assemblyTables  = !pipeSpoolManager.getActivityTables(!this.spoolElement)

  !this.posDataElements.clear()
  !this.posDataContents.clear()

  !feedRefList = object ARRAY()

  do !table values !this.assemblyTables
    !activityType   = !table.activityType
    !component      = !table.component
    !referenceEntry = !table.referencePlaneComponent

    !remarksData    = !table.remarks

    if (!activityType inset ('FLANGE','ELBOW', 'TEE', 'BRANCH')) then
      skip if (!referenceEntry.badRef() or !referenceEntry.hardType ne 'BEND')
      skip if (!this.posDataElements.findFirst(!referenceEntry).set())

      !this.posDataElements.append(!referenceEntry)

      --      !posInfo    = 'p0 of ' & !referenceEntry
      --
      --      !posTable = object ARRAY()
      --      !posTable.append(!remarkInfo)
      --      !posTable.append(!posInfo)
      --      !this.posDataContents.append(!posTable)

    elseif (!activityType eq 'CUT') then
      skip if (!remarksData.unset())

      --      !cutPart    = !remarksData[1]
      !cutElement = !remarksData[3]

      skip if (!this.posDataElements.findFirst(!cutElement).set())

      skip if (!cutElement.hardType ne 'BEND')

      !this.posDataElements.append(!cutElement)

      --      !posTable = object ARRAY()
      --      !posTable.append(!remarkInfo)
      --      !posTable.append(!posInfo)
      --      !this.posDataContents.append(!posTable)
    elseif (!activityType eq 'THRD') then
      !threadComponent  = !remarksData[3]

      skip if (!threadComponent.badRef() or !threadComponent.hardType ne 'FTUB')
      !this.posDataElements.append(!threadComponent)
    elseif (!activityType eq 'BUTT') then
      !refComponent  = !remarksData[3]
      handle any
        skip
      endhandle

      !feedRefList.append(!refComponent)

      skip if (!refComponent.hardType ne 'BEND')

      !this.posDataElements.append(!refComponent)
    elseif (!activityType eq 'SEND') then
      -- for slanted pipe end
      !this.posDataElements.append(!component)
    elseif (!activityType eq 'MITRE') then
      !this.posDataElements.append(!remarksData[1])
    endif
  enddo

  --  !bendingTables = !pipeSpoolManager.getBendingTables(!this.spoolElement)
  --  do !table values !bendingTables
  --    !pipePieceRef = !table.pipePiece
  --    !boundaryElements = !pipePieceRef.aelrfa
  --
  --    !tempBendEntries = object ARRAY()
  --    do !entry values !boundaryElements
  --      if (!entry.hardType eq 'BEND') then
  --        skip if (!tempBendEntries.findFirst(!entry).set())
  --
  --        !tempBendEntries.append(!entry)
  --      endif
  --    enddo
  --
  --    if (!tempBendEntries.set()) then
  --      if (!pipePieceRef.bwithf) then
  --        !this.posDataElements.append(!tempBendEntries.last())
  --      else
  --        !this.posDataElements.append(!tempBendEntries.first())
  --      endif
  --    endif
  --
  --
  ----    !boundaryElements = !pipePieceRef.aelrfa
  --
  ----    do !entry values !boundaryElements
  ----      if (!entry.hardType eq 'BEND') then
  ----        skip if (!this.posDataElements.findFirst(!entry).set())
  ----
  ----        !this.posDataElements.append(!entry)
  ----      endif
  ----    enddo
  --  enddo
  --

  do !index index !this.posDataElements
    !remarkInfo = 'P' & !index

    !feedIndex = !feedRefList.findFirst(!this.posDataElements[!index])
    if (!feedIndex.set()) then
      !posInfo    = 'p2 of ' & !this.posDataElements[!index]
    else
      !posInfo    = 'p0 of ' & !this.posDataElements[!index]
    endif

    !posTable = object ARRAY()
    !posTable.append(!remarkInfo)
    !posTable.append(!posInfo)
    !this.posDataContents.append(!posTable)
  enddo
  !arriveRef = !this.spoolElement.psarfa
  !leaveRef  = !this.spoolElement.pslrfa
  --Collecting all the members in the spool
  !spoolMembers = !this.spoolElement.belrfa

  do !entry values !arriveRef
    !set = TRUE
    --checking whether the entry is a part of the spool or not

    if (!spoolMembers.find(!entry).size().gt(0)) then
      !set = FALSE
    endif
    --If the entry is not part of the spool then create a reference
    if(!set AND !entry.hardType ne 'BRAN') then
      !remarkInfo = 'P' & ( !this.posDataElements.size() + 1)
      !posInfo    = 'PL of ' & !entry.name
      !this.posDataElements.append(!entry)
      !posTable = object ARRAY()
      !posTable.append(!remarkInfo)
      !posTable.append(!posInfo)
      !this.posDataContents.append(!posTable)

    else

      if (!entry.hardType ne 'BRAN' and !entry.shop.not() and !entry.sequ lt !entry.owner.mCount) then
        !arriveRefOwner = BRAN of $!<entry>
        !nextEntry = !arriveRefOwner.members[!entry.sequ + 1]
        if (!nextEntry.tGeom) then
          !remarkInfo = 'P' & ( !this.posDataElements.size() + 1)
          !posInfo    = 'PL of ' & !entry.name
          !this.posDataElements.append(!entry)

          !posTable = object ARRAY()
          !posTable.append(!remarkInfo)
          !posTable.append(!posInfo)
          !this.posDataContents.append(!posTable)
        endif
      endif
    endif
    !validType = !entry.hardType inset ('BRAN', 'WELD')
    --    skip if (!entry.type ne 'BRAN' )
    skip if (!validType.not())

    if (!entry.hardType eq 'BRAN') then
      skip if(!entry.hRef.badRef().not())
    endif

    skip if (!entry.tGeom.not())

    !remarkInfo = 'P' & ( !this.posDataElements.size() + 1)
    if (!entry.hardType eq 'BRAN') then
      !posInfo = 'PH of ' & !entry.name
    else
      !posInfo = 'P0 of ' & !entry.name
    endif

    !this.posDataElements.append(!entry)

    !posTable = object ARRAY()
    !posTable.append(!remarkInfo)
    !posTable.append(!posInfo)
    !this.posDataContents.append(!posTable)
  enddo

  do !entry values !leaveRef
    !set = TRUE
    --    skip if (!entry.type ne 'BRAN')
    --checking whether the entry is a part of the spool or not
    if (!spoolMembers.find(!entry).size().gt(0)) then
      !set = FALSE
    endif
    --If the entry is not part of the spool then create a reference

    if(!set AND !entry.hardType ne 'BRAN') then
      !remarkInfo = 'P' & ( !this.posDataElements.size() + 1)
      !posInfo    = 'PA of ' & !entry.name
      !this.posDataElements.append(!entry)

      !posTable = object ARRAY()
      !posTable.append(!remarkInfo)
      !posTable.append(!posInfo)
      !this.posDataContents.append(!posTable)

    else
      if (!entry.hardType ne 'BRAN' and !entry.shop.not() and !entry.sequ gt 1) then
        !leaveRefOwner = BRAN of $!<entry>
        !previousEntry = !leaveRefOwner.members[!entry.sequ - 1]
        if (!previousEntry.tGeom) then
          !remarkInfo = 'P' & ( !this.posDataElements.size() + 1)
          !posInfo    = 'PA of ' & !entry.name
          !this.posDataElements.append(!entry)

          !posTable = object ARRAY()
          !posTable.append(!remarkInfo)
          !posTable.append(!posInfo)
          !this.posDataContents.append(!posTable)
        endif
      endif
    endif
    !validType = !entry.hardType inset ('BRAN', 'WELD')
    skip if (!validType.not())

    if (!entry.hardType eq 'BRAN') then
      skip if(!entry.tRef.badRef().not())
    endif

    if (!entry.mCount eq 0) then
      skip if (!entry.tGeom.not())
    else
      !lastMember = !entry.members[!entry.mCount]
      skip if (!lastMember.tGeom.not())
    endif

    !remarkInfo = 'P' & ( !this.posDataElements.size() + 1)

    if (!entry.hardType eq 'BRAN') then
      !posInfo = 'PT of ' & !entry.name
    else
      !posInfo = 'P0 of ' & !entry.name
    endif

    !this.posDataElements.append(!entry)

    !posTable = object ARRAY()
    !posTable.append(!remarkInfo)
    !posTable.append(!posInfo)
    !this.posDataContents.append(!posTable)
  enddo

endmethod

------------------------------------------------------------------------
--
-- Method:      markEndPointConnection
--
-- Description: mark end point connection
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .markEndPointConnection(!spoolRef is DBREF, !viewRef is DBREF)
  if (!viewRef.owner.bsrf.badRef()) then
    !!alert.error('Backing sheet reference was broken. Please check Backing sheet reference on the drawing template')
    return
  endif

  !noteRef = !!collectAllFor('NOTE', |upcase(func) eq 'ENDPOINT'|, !viewRef.owner.bsrf)
  if (!noteRef.unset()) then
    return
  endif

  !labelLayerRef = !!collectAllFor('LAYE',|purp eq 'LABA'|, !viewRef)
  if (!labelLayerRef.unset()) then
    return
  endif

  !endPosData = object ARRAY()

  !arriveRef = !this.spoolElement.psarfa
  !leaveRef  = !this.spoolElement.pslrfa

  do !entry values !arriveRef
    if (!entry.type eq 'BRAN') then
      !hRef = !entry.hRef
      if unset(!hRef) eq false then
        if !hRef.type inset ('TEE', 'OLET') then
          skip
        endif
      endif
    endif

    if (!entry.type eq 'BRAN') then
      !endPos = 'PH of ' & !entry.name
    else
      !endPos = 'PL of ' & !entry.name
    endif
    !endPosData.append(!endPos)
  enddo

  do !entry values !leaveRef
    if (!entry.type eq 'BRAN') then
      !tRef = !entry.tRef
      if unset(!tRef) eq false then
        if !tRef.type inset ('TEE', 'OLET') then
          skip
        endif
      endif
    endif

    if (!entry.type eq 'BRAN') then
      !endPos = 'PT of ' & !entry.name
    else
      !endPos = 'PA of ' & !entry.name
    endif

    !endPosData.append(!endPos)
  enddo

  !!ce = !labelLayerRef[1]

  do !i indices !endPosData
    !tagName = 'C' & !i
    !tagPos  = !endPosData[!i]

    new glab on $!tagPos
    handle any
      skip
    endhandle

    bText |$!tagName|
    cheight 2mm
    lframe false
    CPOFFSET 0 -1.25mm

    --    txColour RED
    --    LLColour red
  enddo

  !!ce = !labelLayerRef[1]
  UPDATE ANNO
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      markAdditionalSpoolInfo
--
-- Description: mark additional spool information
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .markAdditionalSpoolInfo(!viewRef is DBREF)
  -- mark spool dimension
  !drwgRef = DRWG

  !dimTask = !!collectAllFor('TASK', |func eq 'Spool Dimension'|, !drwgRef)
  if (!dimTask.set()) then
    !this.markSpoolDim(!dimTask[1], !this.spoolElement, !viewRef)
    handle any
    endhandle
  endif

  !this.markEndPointConnection(!this.spoolElement, !viewRef)

  !this.markPartNo(!viewRef)
  handle any
    write |Failed to mark part no. $!!error.text()|
  endhandle

  if (!viewRef.func eq 'SINGLE') then
    !saveCe = !!ce
    SPREAD LOCAL radius 20mm
  else
    !this.arrangeLabelTask(!drwgRef)
  endif

  --  !!pipeSpoolDim(!parameter, !this.spoolElement, !viewRef)

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      arrangeLabelTask
--
-- Description: arrange label task
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       drawing reference
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .arrangeLabelTask(!drwgRef is DBREF)
  !arrangeLabelTask = !!collectAllFor('TASK', |SPPURP eq 'ARRLAB'|, !drwgRef)

  -- Get arrange label task and read parameters
  VAR !allTaskParameters COLL ALL TKPARA FOR $!arrangeLabelTask[1]
  VAR !allTPVa EVAL TPVALUE FOR ALL FROM !allTaskParameters

  -- Build parameter string
  -- 'true','true','true','true','10','1'
  do !index ind !allTPVa
    !tPVa = !allTPVa[!index]
    if (!index.eq(1)) then
      !parameters = |'| & !tPVa & |'|
    else
      !parameters = !parameters & |,'| & !tPVa & |'|
    endif
  enddo

  update anno
  handle any
    WRITE |$!!error.text|
  endhandle
  -- Arrange the labels

  !!pipeSketchesArrangeLabels($!parameters)
  handle any
    write |Failed to arrange labels. $!!error.text()|
  endhandle

  update anno
  handle any
    WRITE |$!!error.text|
  endhandle
endmethod


------------------------------------------------------------------------
--
-- Method:      markPartNo
--
-- Description: mark part no
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .markPartNo(!viewRef is DBREF)
  -- get mto elements on spool
  if (!this.mtoElements.unset()) then
    !this.getMtoElements()
  endif

  !labelLayerRef = !!collectAllFor('LAYE',|purp eq 'LABA'|, !viewRef)
  if (!labelLayerRef.unset()) then
    return
  endif

  !!ce = !labelLayerRef[1]

  !drwgRef = DRWG
  !labelDefTask = !!collectAllFor('TASK', |func eq 'Tag Defaults'|, !drwgRef)
  !labelOptions = !this.getTaskParameter(!labelDefTask[1])

  --<RM> P-40140 replaced the collection syntax that was used previously with a loop because the collection
  --was introducing extra tubi elements into the mto list that were not required -end
  !pipePieceList = object ARRAY()
  !pipePiecePos  = object ARRAY()

  !mitreCount = 0
  !mitreStep  = object REAL()
  do !i indices !this.mtoElements
    !entry = !this.mtoElements[!i]
    !mtoTag = !i
    NEW SLAB ON $!entry ATEX |$!mtoTag|

    LLColour red
    handle any
    endhandle

    LFColour red
    handle any
    endhandle

    Txcolour red
    handle any
    endhandle

    if (!entry.type eq 'PPIECE') then
      -- Tag at centre of tube
      if (!entry.aelrfa[1].hardType eq 'BEND' and !entry.aelrfa[1].actNcuts gt 0) then
        !mitreBendRef = !entry.aelrfa[1]
        if (!mitreStep.unset()) then
          if (!pipePiecePos.set()) then
            !fromPos = !mitreBendRef.pPos[10]
            !endPos  = !mitreBendRef.pPos[!mitreBendRef.actNcuts * 10]

            if (!pipePiecePos[1].distance(!fromPos) lt !pipePiecePos[1].distance(!endPos)) then
              !mitreCount = 1
              !mitreStep  = 1
            else
              !mitreCount = !mitreBendRef.actNcuts
              !mitreStep  = -1
            endif
          else
            !mitreCount = !mitreBendRef.actNcuts
            !mitreStep  = -1
          endif
        endif

        if (!mitreCount gt 0) then
          if (!mitreStep gt 0) then
            !isValidMitreCount = !mitreCount lt !mitreBendRef.actNcuts
          else
            !isValidMitreCount = !mitreCount le !mitreBendRef.actNcuts
          endif

          if (!isValidMitreCount) then
            !fromPpoint  = !mitreBendRef.pPos[!mitreCount * 10]
            !toPpoint    = !mitreBendRef.pPos[(!mitreCount + !mitreStep) * 10]

            !mitreCount  = !mitreCount + !mitreStep
            !mitreMidPos = true
          else
            !mitreMidPos = false
          endif
        else
          !mitreMidPos = false
        endif

        if (!entry.sequ ne !entry.owner.mCount) then
          if (!mitreBendRef.tGeom) then
            if (!mitreMidPos and !mitreCount gt 0) then
              !pipePiecePosition = !fromPpoint.midPoint(!toPpoint)
            else
              !pipePiecePosition  = !this.getCentrePosOnPipePiece(!entry)
              --!tubeRef = il tube of $!<mitreBendRef>
            endif
          else
            !pipePiecePosition = !mitreBendRef.pPos[ !mitreBendRef.actNcuts * 10 ].midPoint(!entry.aelrfa[2].pos)
            handle any
              !pipePiecePosition = !mitreBendRef.pPos[ !mitreBendRef.actNcuts * 10 ]
            endhandle
          endif

        else
          if (!entry.aelrfa[2].hardType eq 'BRAN' and !mitreBendRef.tGeom) then
            !tubeRef = il tube of $!<mitreBendRef>
            !pipePiecePosition = !mitreBendRef.pPos[ !mitreBendRef.actNcuts * 10 ].midPoint(!tubeRef.lPos)
          else
            !pipePiecePosition = !mitreBendRef.pPos[ !mitreBendRef.actNcuts * 10 ].midPoint(!entry.aelrfa[2].pos)
            handle any
              !pipePiecePosition = !mitreBendRef.pPos[ !mitreBendRef.actNcuts * 10 ]
            endhandle
          endif
        endif
      else
        --!pipePiecePosition = !!positionAlongPipePiece(!entry, 0.5)
        !pipePiecePosition  = !this.getCentrePosOnPipePiece(!entry)
      endif

      if (!pipePiecePosition.set()) then
        POS $!pipePiecePosition
        !pipePiecePos.append(!pipePiecePosition)
      endif

      !pipePieceList.append(!entry)
    endif

    do !para values !labelOptions
      !func    = !para[1]
      --      !pType   = !para[2]
      !tpValue = !para[3]

      $!func $!tpValue
    enddo
  enddo

  !pipePieceList.unique()

  --- mark additional pos no
  do !posData values !this.posDataContents
    !markInfo = !posData[1]
    !posInfo  = !posData[2]

    NEW SLAB ON $!posInfo ATEX |$!markInfo|
    handle any
      DELETE SLAB
      skip
    endhandle

    pos $!posInfo
    LLColour red
    handle any
    endhandle

    LFColour red
    handle any
    endhandle

    Txcolour red
    handle any
    endhandle

    do !para values !labelOptions
      !func    = !para[1]
      !tpValue = !para[3]
      $!func $!tpValue
    enddo
  enddo

  !pipeSpoolManager = object PFPIPESPOOLMANAGER()

  -- mark bending information
  -- 1. if bending machine is manual, it will be marked bending radius
  !bendingTables    = !pipeSpoolManager.getBendingTables(!this.spoolElement)

  if (!bendingTables.set()) then
    do !table values !bendingTables
      !activities = !table.activities
      skip if (!activities.unset())

      !pieceRef = !table.pipePiece
      !index    = !this.mtoElements.findFirst(!pieceRef).string()

      if (!table.bendingMachine.badRef()) then
        !machine  = 'MANUAL'
      else
        !machine  = !table.bendingMachine.namn
      endif

      skip if (!machine ne 'MANUAL')

      !boundaryElements = !pieceRef.aelrfa
      do !comp values !boundaryElements
        skip if (!comp.hardType ne 'BEND')

        !radius = !comp.rad.nint().value().string()
        new glab
        ddname $!comp
        bText |$!radius|
        cheight 2mm

        Txcolour RED
        LLColour RED
      enddo
    enddo
  endif

  -- Arrange the labels
  !!ce = !labelLayerRef[1]

  !drwgRef = DRWG
  !arrangeLabelTask = !!collectAllFor('TASK', |SPPURP eq 'ARRLAB'|, !drwgRef)

  -- Get arrange label task and read parameters
  VAR !allTaskParameters COLL ALL TKPARA FOR $!arrangeLabelTask[1]
  VAR !allTPVa EVAL TPVALUE FOR ALL FROM !allTaskParameters

  -- Build parameter string
  -- 'true','true','true','true','10','1'
  do !index ind !allTPVa
    !tPVa = !allTPVa[!index]
    if (!index.eq(1)) then
      !parameters = |'| & !tPVa & |'|
    else
      !parameters = !parameters & |,'| & !tPVa & |'|
    endif
  enddo

  !!ce = !labelLayerRef[1]
  update anno

  do !entry values !this.mtoElements
    !markInfo = ''

    !isLoosePart = !entry.loose
    handle any
      !isLoosePart = false
    endhandle

    if (!isLoosePart and !entry.hardType eq 'FLAN' and !entry.compType.upCase() eq 'ALLO' and !entry.aExcess eq 0 and !entry.lExcess eq 0) then
      !isLoosePart = false
    endif

    if (!isLoosePart) then
      new glab
      ddname $!entry
      bText |LOOSE|
      cheight 2mm

      Txcolour RED
      LLColour RED
    endif

    skip if (!markInfo.empty())

    new glab
    ddname $!entry
    bText |$!markInfo|
    cheight 2mm

    Txcolour RED
    LLColour RED
  enddo

  !!pipeSketchesArrangeLabels($!parameters)

  !!ce = !labelLayerRef[1]
  update anno
endmethod

-- End of method

------------------------------------------------------------------------
--
-- Method:      markWeldingTable
--
-- Description: mark Welding Table
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .markWeldingTable(!tableData is ARRAY)

  !this.noteRef.lvis = true
  !mem = !!ce

  if (!this.noteRef.badRef()) then
    return
  endif

  -- Navigate to sheet
  !!ce = !this.noteRef.owner
  setstar
  tail
  --!sheet = !this.noteRef.owner.name
  !backingSheet = !!ce.bsrf.name
  !tableType = 'WELDING'

  -- Collect the table entry notes from the backing sheet

  var !table collect all note with (SPPURP eq 'TABLE' and FUNC eq !tableType) for $!backingSheet
  -- Get the name of the note
  !tableName = !table[1].dbRef().name

  !!ce = !this.noteRef

  -- Copy the table notes from the backing sheet
  --new note */$!tableType$n.table copy $!tableName rename $!tableName */$!tableType$n.table
  --setstar
  --!newTableName = !!ce.name
  !newTableName = !this.noteRef.name


  --Adjust the contents of the welding table
  var !cells collect all textp for $!this.noteRef
  do !i indices !cells
    do !j indices !tableData
      if !j eq 1 then
        !!ce = !cells[!i].dbRef()
        --        !newName = !this.noteRef.name & '/cell'& !j & '.'& !i
        --        rename $!newName
        !!ce.bText = !tableData[!j][!i].replace('#','##')
      else
        !!ce = !cells[!i].dbRef()
        --        new textp  copy prev
        --        by y $!cellSpacing
        --        !newName = !this.noteRef.name & '/cell'& !j & '.'& !i
        --        rename $!newName
        !!ce.bText = !tableData[!j][!i].replace('#','##')
      endif
    enddo
  enddo

  !!ce = !this.noteRef
  update all
  handle any
  endhandle

  !!ce = !mem

endmethod

-- End of method

------------------------------------------------------------------------
--
-- Method:      markBendingTable
--
-- Description: mark bending Table
--
-- Method Type: get task parameter
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
--define method .markBendingTable(!tableData is ARRAY)
define method .markBendingTable()
  if (!this.noteRef.badRef()) then
    return
  endif

  !this.noteRef.lvis = true
  !mem = !!ce

  -- Navigate to sheet
  !!ce = !this.noteRef.owner
  setstar

  --!sheet = !this.noteRef.owner.name
  !backingSheet = !!ce.bsrf.name
  !tableType = 'BENDING'

  -- Collect the table entry notes from the backing sheet
  var !table collect all note with (SPPURP eq 'TABLE' and FUNC eq !tableType) for $!backingSheet

  -- Initialise the text elements for the bending table
  var !allNotes collect all note with (SPPURP eq 'CELLS' and FUNC eq !tableType) for sheet
  if (!allNotes.size().neq(0)) then
    var !allText collect all textp for $!allNotes[1]
    !!ce = !allNotes[1].dbRef()
    !allText[1].dbRef().bText = ''
    !allText[2].dbRef().bText  = ''
    !allText[3].dbRef().bText  = ''
    --    !allText[4].dbRef().bText  = ''
    update all
    handle any
    endhandle
  endif

  -- Get the name of the note
  !tableName = !table[1].dbRef().name
  !!ce = !this.noteRef

  -- Copy the table notes from the backing sheet
  --  new note */$!tableType$n.table copy $!tableName rename $!tableName */$!tableType$n.table
  --  setstar
  --  !newTableName = !!ce.name
  !newTableName = !this.noteRef.name

  --  --Adjust each length of the rows
  --  !firstStraElement = !newTableName & '/ColumnLine1'
  --  !secondStraElement = !newTableName & '/ColumnLine2'
  --  !thirdStraElement = !newTableName & '/ColumnLine3'
  --
  --  !cellSpacing = !firstStraElement.dbRef().length
  --  !firstStraElement.dbRef().length = !cellSpacing + !cellSpacing
  --  !secondStraElement.dbRef().length = !cellSpacing + !cellSpacing
  --  !thirdStraElement.dbRef().length = !cellSpacing + !cellSpacing

  -- Initialise Variables
  !result = ARRAY()
  !pipePieceIndex = ''
  !bendingMachine = ''
  !bendingMachineClutch = ''
  --  !bendingMachineCheckSum = ''

  !ppmPipeSpoolManager = object PFPIPESPOOLMANAGER()
  !bendingTables    = !ppmPipeSpoolManager.getBendingTables(!this.spoolElement)
  handle any
    write |Failed to get bending table. $!!error.text()|
    return
  endhandle

  if (!bendingTables.unset()) then
    return
  endif

  if (!bendingTables[1].activities.unset()) then
    return
  endif

  !pieceRef = !bendingTables[1].pipePiece
  !pipePieceIndex = !this.mtoElements.findFirst(!pieceRef).string()
  if (!bendingTables[1].bendingMachine.badRef()) then
    !bendingMachine = 'MANUAL'
  else
    !bendingMachine = !bendingTables[1].bendingMachine.namn
  endif

  if (!bendingTables[1].pipePiece.bwithf) then
    !bendingMachineClutch = 'END'
  else
    !bendingMachineClutch = 'START'
  endif

  !allText[1].dbRef().bText = !pipePieceIndex
  !allText[2].dbRef().bText = !bendingMachine.replace('#','##')
  !allText[3].dbRef().bText = !bendingMachineClutch.replace('#','##')

  !!ce = !mem

endmethod

-- End of method

------------------------------------------------------------------------
--
-- Method:      displayDrawingInformation
--
-- Description: display drawing information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayDrawingInformation(!funcType is STRING)
  !tableData = object ARRAY()

  if (!funcType eq 'MTO') then
    !tableData = !this.getMtoTable()

  elseif (!funcType eq 'OTHERDATA') then
    !tableData = !this.getDrawingInfoTable()

    --  elseif (!funcType eq 'BENDING') then
    --    !this.markBendingTable()

  elseif (!funcType eq 'BENDINGA') then
    !tableData = !this.getBendingTable()
    handle any
      write |Failed to get bending table. $!!error.text()|
    endhandle

  elseif (!funcType eq 'ASSEMBLY') then
    !tableData = !this.getAssemblyTable()
    --    handle any
    --      write |$!!error.text()|
    --    endhandle

    !this.displayExtraInformation('ASSEMBLY')

  elseif (!funcType eq 'ENDPOINT') then
    !tableData = !this.getEndpointTable()
    !this.displayExtraInformation('ENDPOINT')

  elseif (!funcType eq 'WELDING') then
    !tableData = !this.getWeldingTable()
    handle any
      write |Failed to get welding table. $!!error.text()|
    endhandle

    !this.markWeldingTable(!tableData)
  elseif (!funcType eq 'ELBOCUTINFO') then
    !tableData = !this.getElboCutTable()
  elseif (!funcType eq 'PIECECUTINFO') then
    !tableData = !this.getPieceCutTable()
  endif

  --if (!tableData.unset() and !funcType ne 'BENDING') then
  if (!tableData.unset()) then
    !sheetRef = SHEE

    !saveCe = !!ce

    !sourceNoteTitleRef = !!collectAllFor('NOTE',|sppurp eq 'TABLE' and func eq '$!funcType'|, !sheetRef)[1]
    handle any
    elsehandle none
      !!ce = !sourceNoteTitleRef
      delete NOTE
    endhandle

    !sourceNoteRef   = !!collectAllFor('NOTE',|sppurp eq 'CELLS' and func eq '$!funcType'|, !sheetRef)[1]
    handle any
    elsehandle none
      !!ce = !sourceNoteRef
      delete NOTE
    endhandle

    !!ce = !saveCe
    handle any
    endhandle
  endif

  --  if (!tableData.unset()) then
  --    !!ce = !this.noteRef
  --    delete note
  --    return
  --  endif

  --Welding table is created using a different method.
  if (!funcType neq 'WELDING') then
    --    if (!tableData.neq('') or !tableData.set()) then
    if (!tableData.set()) then
      !this.writeTableData(!tableData, !funcType)
    endif
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      displayExtraInformation
--
-- Description: display extra information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .displayExtraInformation(!infoType is STRING)

  !drwgRef  = drwg
  if (!drwgRef.func.upCase().trim().occurs('2D SKETCH') gt 0) then
    return
  endif
  !viewList = !!collectAllFor('VIEW','', !drwgRef)
  do !viewRef values !viewList
    if (!infoType eq 'SPOOL_DIM') then
      !dimTask = !!collectAllFor('TASK', |func eq 'Spool Dimension'|, !drwgRef)
      if (!dimTask.set()) then
        !this.markSpoolDim(!dimTask[1], !this.spoolElement, !viewRef)
      endif
    elseif (!infoType eq 'ENDPOINT') then
      !this.markEndPointConnection(!this.spoolElement, !viewRef)
    elseif (!infoType eq 'PARTNO') then
      !this.markPartNo(!viewRef)
    endif
  enddo

  !this.arrangeLabelTask(!drwgRef)
  handle any
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      writeErrorMessage
--
-- Description: write error message
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .writeErrorMessage(!element is ANY, !message is STRING)

  !datatype = !element.objectType()
  if !datatype.eq('DBREF') then
    if !element.isNamed then
      !name = !element.name
    else
      !name = !element.namtyp
    endif
  elseif !datatype.eq('STRING') then
    !name = !element
  elseif !datatype.eq('FILE') then
    !name = !element.string()
  endif

  !this.errorList.append(!name & '@'  & !message)
endmethod

------------------------------------------------------------------------
--
-- Method:      updateSpoolInformation
--
-- Description: update spool information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateSpoolInformation(!spoolList is ARRAY)
  !this.errorList.clear()
  !this.invalidShopElement.clear()

  !spoolFabManager = object PIPEFABRICATIONMANAGER()
  --  !pipeList = object ARRAY()

  do !spoolRef values !spoolList

    !this.pipeSpoolType = !spoolRef.pstyp
    !pipeRef  = !spoolRef.owner.owner

    if (!pipeRef.dbwrite.not()) then
      !this.writeErrorMessage(!pipeRef, 'Error creating underlying drawing - Cannot Modify.')
      skip
    endif

    --    if (!pipeList.findFirst(!pipeRef).unset()) then
    --      partno create $!pipeRef
    --      handle any
    --        exit
    --        handle any
    --        elsehandle none
    --          partno create $!pipeRef
    --        endhandle
    --      endhandle
    --      !pipeList.append(!pipeRef)
    --    endif

    !spoolFabManager.updatePartNo(!spoolRef)

    !mtoElements = !this.pipeSpoolManager.getMtoElements(!spoolRef)

    -- insert component position with ship coordinates format
    do !element values !mtoElements
      skip if (!element.type inset ('WELD','ATTA','PPIECE'))

      if (!element.type eq 'FLAN') then
        !element.:isoShipCoord = ''
        handle any
          !this.writeErrorMessage(!element, !!error.text)
          skip
        endhandle
        !element.:isoLoose = ''
        handle any
          !this.writeErrorMessage(!element, !!error.text)
          skip
        endhandle
      endif

      -- check shop status
      if (!element.type inset ('ELBO', 'BEND', 'TEE','OLET', 'REDU', 'FLAN') AND !element.shop.not()) then
        !this.writeErrorMessage(!element, 'Error creating underlying drawing - Invalid shop status')
        !element.shop = true
        handle any
        endhandle

        !this.invalidShopElement.append(!element)
      elseif (!element.type inset ('GASK', 'VALV', 'INST') AND !element.shop) then
        !this.writeErrorMessage(!element, 'Error creating underlying drawing - Invalid shop status.')
        !element.shop = false
        handle any
        endhandle

        !this.invalidShopElement.append(!element)
      endif

      -- TM commented out for 12.1 because 12.1 can output ship coordinates.
      --!this.markShipPositionOnComponent(!element)

    enddo

    -- check loose part
    !pipePieces = !this.pipeSpoolManager.pprfa
    --!pipePieces = !this.pipeSpoolManager.getPipePieces(!spoolRef)
    do !piece values !pipePieces
      !this.checkLooseData(!piece)
    enddo
  enddo

endmethod


------------------------------------------------------------------------
--
-- Method:      markShipPositionOnComponent
--
-- Description: mark ship position on component
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .markShipPositionOnComponent(!component is DBREF)
  !shipPositions = !!pfTranslateShipPosition(!component.pos.wrt( /* ))

  !shipPos = 'X:' & !shipPositions[1] & $
  ' $Y:' & !shipPositions[2] & $
  ' $Z:' & !shipPositions[3]
  handle any
    return
  endhandle
  !shipPos = !shipPos.replace('mm','')
  !component.:isoShipCoord = '$!shipPos'
  handle any
    !this.writeErrorMessage(!component, !!error.text)
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      checkLooseData-
--
-- Description: check loose information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkLooseData(!element is DBREF)
  -- get excess data from ppiece
  --<RM> P-33078 choose the greatest value from machine and user excess for leave and arrive (agreed with AH) -start
  !userArriveExcess = !element.uaexss
  !machineArriveExcess = !element.baexss
  if !machineArriveExcess.gt(!userArriveExcess) then
    !arriveExcess = !machineArriveExcess
  else
    !arriveExcess = !userArriveExcess
  endif

  !userLeaveExcess = !element.ueexss
  !machineLeaveExcess = !element.blexss
  if !machineLeaveExcess.gt(!userLeaveExcess) then
    !leaveExcess = !machineLeaveExcess
  else
    !leaveExcess = !userLeaveExcess
  endif
  --<RM> P-33078 choose the greatest value from machine and user excess for leave and arrive (agreed with AH) -end

  -- check excess values
  var !mode mode
  if (!mode.upCase() neq 'FORWARDS') then
    forward
  endif

  -- update loose information
  if (!element.pparef.type inset('FLAN','FBLI')) then
    !this.updateLooseInfo(!element.pparef, !arriveExcess)
  endif

  if (!element.pplref.type inset ('FLAN','FBLI')) then
    !this.updateLooseInfo(!element.pplref, !leaveExcess)
  endif

  if (!!module().modKey.upCase() ne 'MARDRA') then
    $!mode
  endif

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      updateLooseInfo
--
-- Description: update loose information
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .updateLooseInfo(!component is DBREF, !excess is REAL)

  !loose = !this.pipeSpoolType.eq('FITT').and(!excess.neq(0))

  if !loose then
    !inputData = 'LOOSE +$!excess'
    if !excess.lt(0) then
      !inputData = 'LOOSE -$!excess'
    endif
  else
    !inputData = ''
  endif

  -- mark component position with ship coordinates format
  -- TM commented out for 12.1 because 12.1 can output ship coordinates.
  -- !this.markShipPositionOnComponent(!component)
  !component.:ISOLOOSE = !inputData
  handle any
    !this.writeErrorMessage(!component, 'Error creating underlying drawing - Failure of updating loose information')
  endhandle

  !component.loose = !loose
  handle any
    !this.writeErrorMessage(!component, 'Error creating underlying drawing - Failure of updating loose information')
  endhandle

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      writeTableData
--
-- Description: write table data
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .writeTableData(!tableData is ARRAY, !type is STRING)
  !this.noteRef.lvis = true
  !firstRowLine = !this.noteRef.name & '/FirstLine'
  !checkRowLine = object DBREF(!firstRowLine)
  handle any
    !checkRowLine = object DBREF()
  endhandle

  !yOffset = 0
  !yStep   = 0

  -- Get the direction of the build from the STRA element in the table note.
  !firstColumnLine = !this.noteRef.name & '/ColumnLine1'
  !checkColumnLine = object DBREF(!firstColumnLine)
  handle any
    !checkColumnLine = object DBREF()
  elsehandle none
    !buildDirection = 'Y'
    !yStep = !firstColumnLine.dbRef().length
    if (!firstColumnLine.dbRef().adeg.nint() ne 90) then
      --      !buildDirection = 'Y'
      --    else
      !yStep = !yStep * -1
    endif
  endhandle

  if (!type eq 'MTO' and !this.limitTextLengthDesc.unset()) then
    !columnLines = !!collectAllFor('STRA', |adeg ne 0|, !this.noteRef)

    !descIndex = -1
    do !i index !this.queryElements
      !textRef = !this.queryElements[!i]
      skip if (!textRef.bText ne '?desc?')

      !!ce = !textRef
      bTEXT |A|
      var !extent SPLIT EXTENT BTEXT

      !textXminPos = min(!extent[6].real(), !extent[2].real())
      !textXmaxPos = max(!extent[6].real(), !extent[2].real())

      !textWidthPerChar = !textXmaxPos - !textXminPos
      !descIndex = !i
      break
    enddo

    !maxLineXpos     = object REAL()
    !minLineXpos     = object REAL()

    do !i index !columnLines
      !lineXpos = !columnLines[!i].ptfa[1].xyPos.east
      if (!lineXpos gt !textXminPos and !maxLineXpos.unset()) then
        !maxLineXpos = !lineXpos
        if (!i gt 1) then
          !minLineXpos = !columnLines[!i - 1].ptfa[1].xyPos.east
        else
          !minLineXpos = 0
        endif
        break
      endif
    enddo

    if (!maxLineXpos.set() and !minLineXpos.set()) then
      !limitLineWidth = !maxLineXpos - (!minLineXpos + abs(!textXminPos - !minLineXpos))
      !this.limitTextLengthDesc = nint(!limitLineWidth / !textWidthPerChar) + 1
    endif
  endif

  !i = 1

  !additionalLineCount = 0

  do !entry values !tableData
    !rowData = !entry.split('!')

    if (!rowData.size() gt 1) then
      do !j indices !this.queryElements
        !!ce = !this.queryElements[!j]
        unname

        !textPosition = xypos of ptrf
        if (!i gt 1) then
          !xPos         = !textPosition.east

          new texp copy prev

          xyPos $!xPos $!yPos
          handle (46,28)
          elsehandle any
          endhandle
        endif

        !newText = !rowData[!j]
        handle any
          !newText = ''
        endhandle

        !bText  = bText
        if (!type eq 'MTO' and !j eq !descIndex and !this.limitTextLengthDesc.set() and !newText.length() gt !this.limitTextLengthDesc) then
          !startIndex = 0
          do
            !insertStr  = substring(!newText, !startIndex, !this.limitTextLengthDesc + !startIndex)
            break if (!insertStr.empty())

            if (!startIndex gt 0) then
              new texp copy prev
              by $!buildDirection$!yStep
              !i = !i + 1
              !additionalLineCount = !additionalLineCount + 1
            endif

            bTEXT |$!insertStr|
            !startIndex = !startIndex + !this.limitTextLengthDesc
          enddo
        else
          BTEXT |$!newText|
          --if (!j eq 1) then
          --endif
          --BY Y $!tempYS

        endif
      enddo
    else
      !!ce = !this.queryElements[!i]
      handle any
        skip
      endhandle
      unname

      !newText = !tableData[!i].replace('#','##')
      !bText   = bText
      BTEXT |$!newText|
    endif

    if (undefined(!textPosition)) then
      !i = !i + 1
      skip
    endif

    if (!checkRowLine.badRef().not()) then
      !yOffset = !yStep * !i

      if (defined(!buildDirection)) then
        if (!buildDirection.occurs('-') gt 0) then
          !yPos    = !textPosition.north - !yOffset
        else
          !yPos    = !textPosition.north + !yOffset
        endif
      endif

      if (!checkRowLine.purp ne 'LINE') then
        new stra copy $!firstRowLine
        by $!buildDirection$!yOffset
      endif
    endif

    !i = !i + 1
  enddo

  !textList = !!collectAllFor('TEXP', ||, !this.noteRef)
  do !textRef values !textList
    !bText = !textRef.bText
    skip if (!bText.substring(1,1) ne '?' or !bText.substring(-1,1) ne '?')
    !!ce = !textRef
    delete TEXP
  enddo

  -- extension column line
  !columnLineExtension = !yStep.abs() * ( !i - 1 )

  var !columnLines coll all STRA with occurs(name, '/ColumnLine') gt 0 for $!this.noteRef
  do !i indices !columnLines
    !entry = !columnLines[!i].dbRef()
    !entry.length = !columnLineExtension
  enddo

  !removeLines = !!collectAllFor('STRA', |purp eq 'LINE'|, !this.noteRef)
  do !entry values !removeLines
    !!ce = !entry
    delete STRA
  enddo

  !lastRowLineRef = object DBREF(!this.noteRef.name & '/LastLine')
  handle any
  elsehandle none
    if (!lastRowLineRef.badRef().not()) then
      !!ce = !lastRowLineRef
      delete STRA
    endif
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      getDrawingInfoTable
--
-- Description: get drawing information table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getDrawingInfoTable() is ARRAY
  -- Collect all the pipe pieces for the pipe spool
  !refSpoolData = object ARRAY()

  if (!this.noteRef.badRef()) then
    return object ARRAY()
  endif

  !this.queryElements = !!collectAllFor('TEXP','', !this.noteRef)

  !entry = !this.spoolElement

  !wvol = !entry.wvol
  !xCentre = ( !wvol[1] + !wvol[4] ) / 2
  !yCentre = ( !wvol[2] + !wvol[5] ) / 2
  !zCentre = ( !wvol[3] + !wvol[6] ) / 2
  !centrePos = E $!xCentre N $!yCentre U $!zCentre

  do !i indices !this.queryElements
    !item    = !this.queryElements[!i]
    !table   = object ARRAY()

    !evalStr = !item.eText

    if (!evalStr.unset() or !evalStr.empty()) then
      !result = ''

    elseif (!evalStr.upCase() inset ('XPOS','EAST')) then
      !result = !centrePos.east.nint().value().string()

    elseif (!evalStr.upCase() inset ('YPOS','NORTH')) then
      !result = !centrePos.north.nint().value().string()

    elseif (!evalStr.upCase() inset ('ZPOS','UP')) then
      !result = !centrePos.up.nint().value().string()

    elseif (!evalStr.upCase() inset ('SHIPX','SHIPXPOS')) then
      !result = !!pfTranslateShipPosition(!centrePos)[1]
      handle (2,752)
        !result = ''
      endhandle

    elseif (!evalStr.upCase() inset ('SHIPY','SHIPYPOS')) then
      !result = !!pfTranslateShipPosition(!centrePos)[2]
      handle (2,752)
        !result = ''
      endhandle

    elseif (!evalStr.upCase() inset ('SHIPZ','SHIPZPOS')) then
      !result = !!pfTranslateShipPosition(!centrePos)[3]
      handle (2,752)
        !result = ''
      endhandle

    elseif (!evalStr.upCase() inset ('SHIPX_FROM_RSO', 'SHIPXPOS_FROM_RSO', 'SHIPY_FROM_RSO', 'SHIPYPOS_FROM_RSO','SHIPZ_FROM_RSO', 'SHIPZPOS_FROM_RSO')) then
      if (!evalStr.upCase() inset ('SHIPX_FROM_RSO','SHIPXPOS_FROM_RSO')) then
        !searchDir = 'X'
      elseif (!evalStr.upCase() inset ('SHIPY_FROM_RSO','SHIPYPOS_FROM_RSO')) then
        !searchDir = 'Y'
      else
        !searchDir = 'Z'
      endif

      !result = !!comTranslateRsoPosition(!searchDir, !centrePos)
      handle (2,752)
        !result = ''
      endhandle
    else
      !result = !this.evaluateExpression.getEvaluateResult(!entry, !evalStr, '.')
    endif

    !refSpoolData.append(!result)
  enddo

  !this.errorList.appendArray(!this.evaluateExpression.errorList)
  return !refSpoolData

endmethod
-- End of method

--------------------------------------------------------------------------
----
---- Method:      getPartNo
----
---- Description: get part-no on component
----
---- Method Type: Function/Procedure
---- Arguments:
----   [#] [R/RW] [Data Type] [Description]
---- Return:
----   [Data Type] [Description]
----
--------------------------------------------------------------------------
--define method .getPartNo(!element is DBREF) is REAL
--  if (!element.type eq 'PPIECE') then
--    !partNo = !element.aelrfa[1].ptntube
--    handle any
--      !partNo = -1
--    endhandle
--  else
--    !partNo = !element.ptno
--    handle any
--      !partNo = -1
--    endhandle
--  endif
--
--  return !partNo
--endmethod
---- End of method

define method .getMtoElements()
  -- get mto elements on spool
  !mtoElements = !this.pipeSpoolManager.getMtoElements(!this.spoolElement)

  !mtoCol = object ARRAY()
  do !i from 1 to !mtoElements.size()
    !item = !mtoElements[!i]
    !dtxrtext = !item.dtxrtext
    handle any
      !dtxrtext = '(unset)'
    endhandle

    if (!item.hardType eq 'OLET') then
      skip if (!item.compType inset ('SSAH','SSAT','STUH','SEXH','SSUH','SSUT','TAPH','BOSH','BOST'))
    endif

    skip if (!item.hardType eq 'FTUB' and !item.compType inset('SEND', 'THRD'))

    skip if (!item.actType eq 'PTAP')

    if (!item.hardType eq 'ATTA') then
      skip if (!this.isValidVolume(!item).not())
    endif

    skip if (!item.hardType eq 'WELD')

    skip if (!item.hardType eq 'BEND' and !item.actNcuts gt 0)

    if !dtxrtext.neq(|TEE SET ON|) then
      !mtoCol.append(!item)
    endif
  enddo

  !this.mtoElements = !mtoCol
endmethod

------------------------------------------------------------------------
--
-- Method:      getMtoTable
--
-- Description: get mto table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getMtoTable() is ARRAY
  !this.queryElements = !!collectAllFor('TEXP','', !this.noteRef)

  if (!this.noteRef.badRef()) then
    return object ARRAY()
  endif

  --<RM> P-40140 replaced the collection syntax that was used previously with a loop because the collection
  --was introducing extra tubi elements into the mto list that were not required -end

  !mtoData  = object ARRAY()

  -- replacement com unit
  --  !currUnit = object COMUNITS(TRUE)
  --var !currUnit unit
  --!unit = !currUnit.split()[3]
  --  !unit = !currUnit.getcurrentunitsbyptype('DIST').upCase()
  !excessForThreadLength = 0

  !partNoForSketchType = 1

  do !i indices !this.mtoElements
    !entry = !this.mtoElements[!i]
    !type  = !entry.type

    skip if (!type eq 'WELD')

    if (!type eq 'ATTA') then
      skip if (!this.isValidVolume(!entry).not())
    endif

    skip if (!type eq 'FTUB' and !entry.desp[1] lt 0.5)

    if (!type eq 'PPIECE') then
      if (!entry.aelrfa[1].type eq 'BRAN') then
        !partNo = !entry.aelrfa[1].ptnhead
      else
        !partNo = !entry.aelrfa[1].ptntube
      endif
      !unit = !this.distanceUnit
    else
      !partNo = !entry.ptno
      !unit   = !this.quantityUnit
    endif

    !table = object ARRAY()
    if (!this.isSketchType) then
      !table.append(!partNoForSketchType)
      !partNoForSketchType = !partNoForSketchType + 1
    else
      !table.append(!partNo)
    endif

    !findIndex = 0

    do !j indices !this.queryElements
      !item = !this.queryElements[!j]
      if (defined(!evalResult)) then
        !evalResult.delete()
      endif

      if (!item.bText.upCase().occurs('UNIT') gt 0) then
        !table.append(!unit)
        skip
      endif

      !evalStr = !item.eText
      if (!evalStr.empty()) then
        skip
      endif

      !evalResult = !this.evaluateExpression.getEvaluateResult(!entry, !evalStr, '.')
      handle (2,751)
        skip
      endhandle

      if (!item.bText.upCase().occurs('DESC') gt 0 and !entry.hardType eq 'ELBO') then
        !catAngle = !this.evaluateElbowAngleOnCata(!entry)
        !showCutAngle = abs(!catAngle - !entry.angle) gt 0.9deg

        --if (int(!entry.ang) ne 90) then
        if (!showCutAngle) then
          !cutLenVal= !entry.:cutLength
          handle any
            !midPos= !entry.pPos
            !arrPos= !entry.apos
            !dist= !midPos.distance(!arrPos)
            !cutLenVal = !dist
          endhandle
          !evalResult =!evalResult & 'Cut' & !entry.ang.string(!!angleFMT).real().value() & 'Deg.' & 'Length' & !cutLenVal.string('d2')
        endif
      endif

      if (!evalResult.occurs('#') gt 0) then
        !evalResult = !evalResult.replace('#','##')
      endif

      !threadFlag = false

      if (!entry.hardType eq 'PPIECE') then
        --        if (!entry.pparef.hardType eq 'FTUB') then
        --          if (!entry.pparef.desp[1] lt 0.5) then
        --            !threadFlag = true
        --          endif
        --        endif
        !boundaryComponent = !entry.aelrfa
        do !checkEntry values !boundaryComponent
          skip if (!checkEntry.hardType eq 'BRAN')
          skip if (!checkEntry.hardType ne 'FTUB' and !checkEntry.compType ne 'THRD')
          !threadFlag = true
        enddo

        --        --if (!entry.pparef.hardType eq 'BRAN' and !entry.pparef.mCount gt 0) then
        --        if (!entry.pparef.hardType eq 'FTUB') then
        --          if (!entry.pparef.desp[1] lt 0.5) then
        --            !threadFlag = true
        --          endif
        ----          !firstMember = !entry.pparef.members[1]
        ----          if (!firstMember.hardType eq 'FTUB') then
        ----            if (!firstMember lt 0.5) then
        ----              !threadFlag = true
        ----            endif
        ----          endif
        --        endif
        --
        ----        if (!entry.pplref.hardType eq 'FTUB') then
        ----          if (!entry.pplref.desp[1] lt 0.5) then
        ----            !threadFlag = true
        ----          endif
        ----        endif
        --
        ----        if (!entry.pplref.hardType eq 'BRAN' and !entry.pplref.mCount gt 0) then
        --        if (!entry.pplref.hardType eq 'FTUB') then
        --            if (!entry.pplref.desp[1] lt 0.5) then
        --              !threadFlag = true
        --            endif
        --
        ----          !lastMember = !entry.pplref.members[!entry.pplref.mCount]
        ----          if (!lastMember.hardType eq 'FTUB') then
        ----            if (!lastMember.desp[1] lt 0.5) then
        ----              !threadFlag = true
        ----            endif
        ----          endif
        --        endif

        !pieceMembers = !entry.aelrfa
        if (!pieceMembers[1].hardType eq 'BRAN' and !pieceMembers[1].hRef.badRef().not()) then
          !tempBranRef = !pieceMembers[1]

          if (!this.threadConnectionTypes.findFirst(!tempBranRef.hconn).set() and !tempBranRef.hRef.badRef().not()) then
            !threadFlag = true
          endif
        endif

        --        do !compRef values !pieceMembers
        --          skip if (!compRef.hardType ne 'OLET')
        ----          !isThreaded = !compRef.skey inset ('THSC')
        --          !isThreaded = matchw(!compRef.skey,'TH*') OR matchw(!compRef.skey,'WT*')
        --          handle any
        --            !isThreaded = false
        --          endhandle
        --
        --          skip if (!isThreaded.not())
        --
        --          !threadFlag = true
        --
        --          !p3Pos = !compRef.pPos[3].wrt( /* )
        --          !endPos = !p3Pos.offset(!compRef.ori.zDir().wrt( /* ), !compRef.para[8])
        --
        --          !excessForThreadLength = !p3Pos.distance(!endPos)
        --        enddo
      endif

      if (!evalStr.upCase().occurs('AC') gt 0 and !threadFlag) then
        !tempResult = !evalResult.real() +  !excessForThreadLength
        !evalResult = '*' & !tempResult.nint().value().string(!!distanceFMT).real().value()
      endif

      if (!evalStr.upCase().occurs('QTY') gt 0) then
        !findIndex = !j
      elseif (!evalStr.upCase().occurs('AC') gt 0) then
        !findIndex = !j
      else
        !findIndex = -1
      endif

      if (!type eq 'PPIECE' and !this.isSketchType) then
        !findIndex = 0
      endif

      if (!this.outputUnits.unset()) then
        !this.outputUnits = 'METER'
      endif

      if (!this.isSketchType) then
        !extractIndex = !i
      else
        !extractIndex = !partNo
      endif

      if (!mtoData.size() gt 0 AND !findIndex gt 0) then
        !groupData  = !mtoData[!extractIndex].split('!')
        handle any
        elsehandle none
          !groupResult = !groupData[!findIndex].real() + !evalResult.real()
          handle any
            if (defined(!groupResult)) then
              !groupResult.delete()
            endif
            !groupResult = ''
          endhandle
          !evalResult   = !groupResult.string()
        endhandle
      endif

      if (!evalStr.upCase().occurs('QTY') gt 0 or !evalStr.upCase().occurs('AC') gt 0) then
        !evalResult = !evalResult.real().string(!!distanceFMT).real().value().string()
        handle (2,441)
        endhandle
      endif

      !table.append(!evalResult)
    enddo

    !insertStr = ''
    do !j indices !table
      if (!j ne !table.size()) then
        !insertStr = !insertStr + !table[!j].string() + '!'
      else
        !insertStr = !insertStr + !table[!j].string()
      endif
    enddo

    !mtoData[!extractIndex] = !insertStr
    handle any
    endhandle
  enddo

  return !mtoData
endmethod
-- End of method

define method .evaluateActivateValue(!value is STRING) is STRING
  !result = !value
  if (!value.empty()) then
    !result = '---'
  endif

  return !result
endmethod

define method .getPrefixForAssemblyTable(!referenceEntry is DBREF, !initialPrefix is STRING) is STRING
  if (!referenceEntry.badRef()) then
    return ''
  endif

  !prefix = !initialPrefix

  if (!referenceEntry.hardType eq 'BEND') then
    if (!referenceEntry.actNcut gt 0) then
      !prefix = 'MP'
    else
      !prefix = 'BP'
    endif
  elseif (!referenceEntry.hardType eq 'FLAN') then
    !prefix = 'F'
  elseif (!referenceEntry.hardType eq 'ELBO') then
    !prefix = 'E'
  elseif (!referenceEntry.hardType inset('TEE', 'CROS')) then
    !prefix = 'T'
    --elseif (!referenceEntry.hardType eq 'PPIECE' and !referenceEntry.aelrfa[1].hardType eq 'BRAN') then
  elseif (!referenceEntry.hardType eq 'PPIECE') then
    !boundaryComponent = !referenceEntry.aelrfa
    !isConnectToOtherBranch = false
    do !comp values !boundaryComponent
      !isValidType = !comp.hardType inset ('BRAN', 'WELD')

      skip if (!isValidType.not())

      if (!comp.hardType eq 'WELD') then
        if (!comp.owner.hRef.badRef().not()) then
          !isConnectToOtherBranch = !comp.owner.hRef.actType eq 'PTAP'
        endif
      else
        !isConnectToOtherBranch = !comp.hRef.hardType inset ('TEE','OLET','PTAP','PIPCA') or !comp.tRef.hardType inset ('TEE','OLET','PTAP','PIPCA')
      endif

      break if(!isConnectToOtherBranch)
    enddo

    if (!isConnectToOtherBranch) then
      !prefix = 'BS'
    endif


  elseif (!referenceEntry.hardType inset ('OLET')) then
    !prefix = ''
  endif

  return !prefix
endmethod

------------------------------------------------------------------------
--
-- Method:      getAssemblyTable
--
-- Description: get assembly table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getAssemblyTable() is ARRAY
  -- get assembly activity table

  -- it'll be removed when PP's activity table can cover this. [Daniel]
  --  !assemblyTables = !this.pipeSpoolManager.getActivityTables(!this.spoolElement)

  if (!this.noteRef.badRef()) then
    return object ARRAY()
  endif

  --  !ppmPipeSpoolManager = object PFPIPESPOOLMANAGER()
  --  !ppAssemblyTables = !ppmPipeSpoolManager.getActivityTables(!this.spoolElement)

  !this.queryElements =  !!collectAllFor('TEXP','', !this.noteRef)
  !result = object ARRAY()

  --  !cutIndex = 1
  do !i indices !this.assemblyTables
    --    !incline  = '---'
    --    !turn     = '---'
    --    !rotate   = '---'
    --    !planeRef = '---'
    --
    !activityType   = !this.assemblyTables[!i].activityType
    !component      = !this.assemblyTables[!i].component
    !referenceEntry = !this.assemblyTables[!i].referencePlaneComponent

    !rotate         = !this.evaluateActivateValue(!this.assemblyTables[!i].rotation.nint().value().string())
    handle any
      !rotate = '---'
    endhandle

    !incline        = !this.evaluateActivateValue(!this.assemblyTables[!i].inclination.nint().value().string())
    handle any
      !incline = '---'
    endhandle

    !turn           = !this.evaluateActivateValue(!this.assemblyTables[!i].turning.nint().value().string())
    handle any
      !turn = '---'
    endhandle

    !remarksData    = !this.assemblyTables[!i].remarks

    !partNo = !this.mtoElements.findFirst(!component).string()
    --
    --    !index  = !activityTypes.findFirst(!activityType)
    --    skip if (!index eq 0)
    --
    --    !prefix = !prefixList[!index]
    !remarks        = '---'
    !prefix  = ''

    if (!activityType eq 'FLANGE') then
      !prefix = !this.getPrefixForAssemblyTable(!referenceEntry, 'F')

      if (!referenceEntry.badRef().not()) then
        --        !remarks = !prefix & !referenceEntry.tyseq
        if (!referenceEntry.hardType eq 'BEND') then
          --!remarks = !prefix & !referenceEntry.tyseq
          !bendIndex = !this.posDataElements.findFirst(!referenceEntry)
          !posData   = !this.posDataContents[!bendIndex][1].replace('P', '')
          !remarks = !prefix & !posData
        elseif (!referenceEntry.hardType eq 'FTUB' and !referenceEntry.compType inset ('SEND','THRD')) then
          !remarks = 'P' & !this.posDataElements.findFirst(!referenceEntry)
        else
          !remarks = !prefix & !this.mtoElements.findFirst(!referenceEntry).string()
        endif
      else
        !remarks = !prefix
      endif

      !remarks = !remarks & ':  :'

    elseif (!activityType eq 'BRANCH') then
      !prefix = !this.getPrefixForAssemblyTable(!referenceEntry, 'F')
      if (!referenceEntry.badRef().not() and !remarksData.set()) then
        if (!remarksData[1].set()) then
          if (!remarksData[1].hardType ne 'OLET') then
            --            !remarks = !prefix & !remarksData[1].tyseq
            !remarks = !prefix & !this.mtoElements.findFirst(!referenceEntry).string()
            handle any
              !remarks = '---'
            endhandle

            if (!referenceEntry.badRef().not()) then
              if (!referenceEntry.hardType eq 'PPIECE') then
                --!remarks = !remarks & ': ' & !this.mtoElements.findFirst(!remarksData[1]).string()  & ': EXT'
                !remarks = !remarks & ': ' & !this.mtoElements.findFirst(!remarksData[1]).string()  & ':' & !remarksData[2]
              elseif (!referenceEntry.hardType eq 'FTUB' and !referenceEntry.compType inset ('SEND','THRD')) then
                !remarks = 'P' & !this.posDataElements.findFirst(!referenceEntry)
              else
                !remarks = !remarks & ':  :'
              endif
            else
              !remarks = !remarks & ':  :'
            endif
          endif
        else
          if (!referenceEntry.hardType eq 'BEND') then
            --!remarks = !prefix & !referenceEntry.tyseq
            !bendIndex = !this.posDataElements.findFirst(!referenceEntry)
            !posData   = !this.posDataContents[!bendIndex][1].replace('P', '')
            !remarks = !prefix & !posData
          elseif (!referenceEntry.hardType eq 'FTUB' and !referenceEntry.compType inset ('SEND','THRD')) then
            !remarks = 'P' & !this.posDataElements.findFirst(!referenceEntry)
          else
            !remarks = !prefix & !this.mtoElements.findFirst(!referenceEntry).string()
          endif

          if (!remarksData[2] eq 'SDL') then
            if (!remarksData[3] gt 0) then
              !bossExcessInfo = '+' & !remarksData[3].nint().value().string()
            elseif (!remarksData[3] lt 0) then
              !bossExcessInfo = '-' & !remarksData[3].nint().value().string()
            else
              !bossExcessInfo = ''
            endif
            !remarks = !remarks & ':  :' & !remarksData[2] & !bossExcessInfo
          else
            !remarks = !remarks & ':  :' & !remarksData[2]
          endif
        endif
      else
        !remarks = !remarks & ':  :'
      endif
    elseif (!activityType eq 'ELBOW') then
      !prefix = !this.getPrefixForAssemblyTable(!referenceEntry, 'E')
      if (!referenceEntry.badRef().not()) then
        if (!referenceEntry.hardType eq 'BEND') then
          !bendIndex = !this.posDataElements.findFirst(!referenceEntry)
          !posNo     = !this.posDataContents[!bendIndex][1].replace('P', '')
        else
          !posNo = !this.mtoElements.findFirst(!referenceEntry).string()
        endif
        !remarks = !prefix & !posNo
      else
        !remarks = !prefix
      endif

      !remarks = !remarks & ':  :'

    elseif (!activityType eq 'CUT') then
      if (!remarksData.set()) then
        !cutLength   = !remarksData[2]
        !cutEntry    = !remarksData[3]

        !bendIndex = !this.posDataElements.findFirst(!cutEntry)
        !posData   = !this.posDataContents[!bendIndex][1]

        if (!remarksData[1] eq 'ARRIVE') then
          !cutRefPart = 1
        else
          !cutRefPart = 2
        endif

        if (!component.hardType eq 'PPIECE') then
          !bendingEndData = !this.evaluateSpoolEndData(!component)
          if (!bendingEndData.set()) then
            !incline = !bendingEndData[!cutRefPart]
            handle (2,752)
            endhandle
          endif
        endif
        !remarks = !cutLength.nint().value().string() & ':  :' & !posData
      endif

      !rotate = 'CUT'
      --      !remarks = nint(!remarksData[2].value()) & ': :'
    elseif (!activityType eq 'TEE') then
      !prefix = !this.getPrefixForAssemblyTable(!referenceEntry, 'T')
      if (!referenceEntry.hardType eq 'BEND') then

        !bendIndex = !this.posDataElements.findFirst(!referenceEntry)
        !posData   = !this.posDataContents[!bendIndex][1].replace('P', '')
        !remarks = !prefix & !posData
      elseif (!referenceEntry.hardType eq 'FTUB' and !referenceEntry.compType inset ('SEND','THRD')) then
        !remarks = 'P' & !this.posDataElements.findFirst(!referenceEntry)
      else
        !remarks = !prefix & !this.mtoElements.findFirst(!referenceEntry).string()
      endif

      !remarks = !remarks & ':  :'
    elseif (!activityType eq 'LOOSE') then
      !remarks = 'LOOSE'
    elseif (!activityType eq 'BUTT') then
      !rotate = 'BUTT'
      !buttValue =!remarksData[2].nint().value().string()
      handle any
        !buttValue =!remarksData[2].string()
      endhandle

      if (!remarksData.size() gt 1) then
        !refComp   = !remarksData[3]

        if (!refComp.hardType eq 'BEND') then
          !bendIndex = !this.posDataElements.findFirst(!refComp)
          !incline   = !this.posDataContents[!bendIndex][1]
          !remarks   = !buttValue
        elseif (!referenceEntry.hardType eq 'FTUB' and !referenceEntry.compType inset ('SEND','THRD')) then
          !remarks = 'P' & !this.posDataElements.findFirst(!referenceEntry)
        else
          !posData = !prefix & !this.mtoElements.findFirst(!referenceEntry).string()
          !remarks = !buttValue & ':  :' & !posData
        endif
      else
        !remarks = !buttValue & ':  :'
      endif

      -- remarkData[2]? ?? ???? ?? ???? incl.?? ? ??? ????.
    elseif (!activityType eq 'FLFRM') then
      !rotate = 'FLFRM'
      !rooseFlangeRef = !remarksData[1]
      !rooseFlangeVal = !remarksData[2]
      !incline = !this.mtoElements.findFirst(!rooseFlangeRef).string()
      !remarks = !rooseFlangeVal.nint().value().string() & ':  :'
    elseif (!activityType eq 'THRD') then
      --      !refPart          = !remarksData[1]
      !threadEngagement = !remarksData[2]
      !threadType       = !remarksData[4]
      !threadComponent  = !remarksData[3]
      !threadConnection = !remarksData[5]

      !rotate  = 'THRD'
      --Checking whether the thread is at the arrive part or leave part and storing the component
      if(!remarksData[1] eq 'ARRIVE') then
        !com =  !component.aelrfa[1]
        if(!com.hardType.eq('BRAN')) then
          !com = !com.members[1]
        endif
      else
        !com =  !component.aelrfa[2]
        if(!com.hardType.eq('BRAN')) then
          !com = !com.members[!com.members.size()]
        endif
      endif
      --Extracting the part number of the component
      !partN = !this.mtoElements.findFirst(!com).string()
      --If It is not there in mto table then checking the references
      !comOwner = object DBREF()
      if(!partN eq '') then
        do !posData values !this.posDataContents
          !markInfo = !posData[1]
          !posInfo  = !posData[2]
          !comOwner = !posInfo.after('of').dbRef()
          if(!comOwner.eq(!com)) then
            !partN = !markInfo
          endif
        enddo
      endif

      if (!threadComponent.badRef().not()) then
        if (!threadComponent.hardType eq 'FTUB') then
          !bendIndex = !this.posDataElements.findFirst(!threadComponent)
          !incline   = !this.posDataContents[!bendIndex][1].replace('P', '')
        else
          !incline = !this.mtoElements.findFirst(!threadComponent).string()
        endif
      endif

      !remarks = !threadEngagement.nint().value().string() & ':' & !threadType & ':' & !threadConnection & ':' & !partN
    elseif (!activityType eq 'SEND') then
      -- for slanted pipe end
      !prefix = !this.getPrefixForAssemblyTable(!referenceEntry, '')
      if (!referenceEntry.badRef().not()) then
        --        !remarks = !prefix & !referenceEntry.tyseq
        if (!referenceEntry.hardType eq 'BEND') then
          --!remarks = !prefix & !referenceEntry.tyseq
          !bendIndex = !this.posDataElements.findFirst(!referenceEntry)
          !posData   = !this.posDataContents[!bendIndex][1].replace('P', '')
          !remarks = !prefix & !posData
        elseif (!referenceEntry.hardType eq 'FTUB' and !referenceEntry.compType inset ('SEND','THRD')) then
          !remarks = 'P' & !this.posDataElements.findFirst(!referenceEntry)
        else
          !remarks = !prefix & !this.mtoElements.findFirst(!referenceEntry).string()
        endif
      else
        !remarks = !prefix
      endif

      !remarks = !remarks & ':Cut ' & !component.desp[1].value().string('D0') & ':'

      !posIndex = !this.posDataElements.findFirst(!component)
      !partNo   = !this.posDataContents[!posIndex][1]

    elseif (!activityType eq 'MITRE') then
      !rotate = 'MITRE'

      --!remarks = 'MP' & !partNo & ':  : ' & !remarksData[2].sequ
      !partNo   = 'P' & !partNo

      !remarks = ':  : ' & !remarksData[1].actNcut

    elseif (!activityType eq 'MCUT') then
      !rotate = 'CUT'

      !bendComp  = !remarksData[5]
      !bendIndex =  !this.posDataElements.findFirst(!bendComp)
      --!incline   = !this.posDataContents[!bendIndex][1]
      !incline   = !this.mtoElements.findFirst(!remarksData[3]).string()

      !toComponent = !remarksData[4]
      if (!toComponent.badRef()) then
        !branchPosData = object ARRAY()
        do !posEntry values !this.posDataElements
          skip if (not(!posEntry.hardType inset ('BRAN','BEND')))

          if (!posEntry.hardType eq 'BEND') then
            skip if (!posEntry.actNcuts lt 1)
          endif

          !posIndices = !this.posDataElements.find(!posEntry)
          do !posIndex values !posIndices
            !branchPosData.append(!this.posDataContents[!posIndex][1])
          enddo
        enddo
        if (!remarksData[1] eq 'ARRIVE') then
          !toPartNo = !branchPosData.first()
          handle any
            !toPartNo = '-1'
          endhandle
        else
          !toPartNo = !branchPosData.last()
          handle any
            !toPartNo = '-1'
          endhandle
        endif
      else
        if (!toComponent.hardType eq 'BEND') then
          !prefix   = !this.getPrefixForAssemblyTable(!toComponent, '')
          !bendIndex = !this.posDataElements.findFirst(!toComponent)
          !toPartNo  = !prefix & !this.posDataContents[!bendIndex][1].replace('P', '')
        elseif (!toComponent.hardType eq 'FTUB' and !toComponent.compType inset ('SEND','THRD')) then
          !remarks = 'P' & !this.posDataElements.findFirst(!toComponent)
        else
          !prefix   = !this.getPrefixForAssemblyTable(!toComponent, '')
          !toPartNo = !prefix & !this.mtoElements.findFirst(!toComponent).string()
        endif
      endif

      !remarks   = !remarksData[2].value().string('D0') & ':  : ' & !toPartNo
    else
      skip
    endif

    skip if (!rotate eq '---' and !incline eq '---' and !turn eq '---' and !remarks eq  ':  :')

    var !queryElements eval etext for all texp for $!this.noteRef

    !table = object ARRAY()

    do !query values !queryElements
      if (!query.empty() or !query eq 'unset') then
        !table.append('')
        skip
      endif

      if (!query.upCase() eq 'INDEX') then

        --is appended to the mto list and the tee is not - end
        !table.append(!partNo)

      elseif (!query.upCase() eq 'ROTATE') then
        !table.append(!rotate)

      elseif (!query.upCase() eq 'INCLINE') then
        !table.append(!incline)

      elseif (!query.upCase() eq 'TURN') then
        !table.append(!turn)

      elseif (!query.upCase() eq 'REMARKS') then
        !table.append(!remarks)
      endif
    enddo

    !insertStr = ''
    do !j indices !table
      if (!j eq !table.size()) then
        !insertStr = !insertStr & !table[!j]
      else
        !insertStr = !insertStr & !table[!j] & '!'
      endif
    enddo

    !result.append(!insertStr)
  enddo
  return !result
endmethod
-- End of method

define method .evaluateSpoolEndData(!pipePieceRef is DBREF) is ARRAY
  !result = object ARRAY()

  !firstComponent = !pipePieceRef.pparef
  !lastComponent  = !pipePieceRef.pplref

  !branchRef = bran of $!firstComponent
  !members   = !branchRef.members

  -- evaluate first connection
  if (!firstComponent.hardType eq 'BRAN') then
    !branIndex = !this.posDataElements.find(!firstComponent).first()
    handle (2,752)
    elsehandle none
      !posData   = !this.posDataContents[!branIndex][1]
      !result.append(!posData)
    endhandle
  elseif (!firstComponent.hardType inset ('BEND','WELD')) then
    if (!firstComponent.hardType eq 'BEND' and !firstComponent.actNcuts gt 0) then
      return !result
    endif

    if (!firstComponent.hardType eq 'WELD') then
      if (!branchRef.mCount gt 0 and !firstComponent.sequ gt 1) then
        !prevRef = !members[!firstComponent.sequ - 1]
        !posData   = !this.mtoElements.findFirst(!prevRef).string()
        !result.append(!posData)
      endif
    else
      !bendIndex = !this.posDataElements.findFirst(!firstComponent)
      handle (2,752)
      elsehandle none
        !posData   = !this.posDataContents[!bendIndex][1]
        handle any
        elsehandle none
          !result.append(!posData)
        endhandle
      endhandle
    endif
  else
    if (!firstComponent.shop) then
      !posData   = !this.mtoElements.findFirst(!firstComponent).string()
      if (!posData.empty().not()) then
        !result.append(!posData)
      endif
    else
      if (!pipePieceRef.bwithf.not()) then
        !result = object ARRAY()
        --if (!table.pipePiece.bwithf) then
        !bendIndex = !this.posDataElements.findFirst(!firstComponent)
        handle (2,752)
        elsehandle none
          !posData   = !this.posDataContents[!bendIndex][1]
          handle any
          elsehandle none
            !result.append(!posData)
          endhandle
        endhandle
      endif
    endif
  endif

  -- evaluate last connection
  if (!lastComponent.hardType eq 'BRAN') then
    !branIndex = !this.posDataElements.find(!lastComponent).last()
    handle (2,752)
    elsehandle none
      !posData   = !this.posDataContents[!branIndex][1]
      !result.append(!posData)
    endhandle
  elseif (!lastComponent.hardType inset ('BEND','WELD')) then
    if (!lastComponent.hardType eq 'BEND' and !lastComponent.actNcuts gt 0) then
      return !result
    endif

    if (!lastComponent.hardType eq 'WELD') then
      if (!branchRef.mCount gt 0 and !lastComponent.sequ lt !branchRef.mCount) then
        !nextRef = !members[!lastComponent.sequ + 1]
        !posData   = !this.mtoElements.findFirst(!nextRef).string()
        !result.append(!posData)
      endif
    else
      !bendIndex = !this.posDataElements.findFirst(!lastComponent)
      handle (2,752)
      elsehandle none
        !posData   = !this.posDataContents[!bendIndex][1]
        handle any
        elsehandle none
          !result.append(!posData)
        endhandle
      endhandle
    endif
  else
    if (!lastComponent.shop) then
      !posData   = !this.mtoElements.findFirst(!lastComponent).string()
      if (!posData.empty().not()) then
        !result.append(!posData)
      endif
    else
      if (!pipePieceRef.bwithf) then
        !result = object ARRAY()
        !bendIndex = !this.posDataElements.findFirst(!lastComponent)
        handle (2,752)
        elsehandle none
          !posData   = !this.posDataContents[!bendIndex][1]
          handle any
          elsehandle none
            !result.append(!posData)
          endhandle
        endhandle
      endif
    endif
  endif

  return !result
endmethod

------------------------------------------------------------------------
--
-- Method:      getBendingTable
--
-- Description: get bending table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getBendingTable() is ARRAY

  -- get bending elements
  --  !bendElements = object ARRAY()

  if (!this.noteRef.badRef()) then
    return object ARRAY()
  endif

  !this.queryElements.clear()
  !textElements = !!collectAllFor('TEXP','', !this.noteRef)

  !wasteElements = object ARRAY()
  do !textRef values !textElements
    if (!textRef.eText.upCase() inset ('BMACH','SPOOL','CLUTCH')) then
      !wasteElements.append(!textRef)
    else
      !this.queryElements.append(!textRef)
    endif
  enddo

  --  !this.queryElements =  !!collectAllFor('TEXP','', !this.noteRef)
  !queryElements = !this.queryElements.evaluate(object BLOCK('!this.queryElements[!evalIndex].etex'))

  --  -- get bend element
  --  do !entry values !this.mtoElements
  --    skip if (!entry.type ne 'PPIECE')
  --
  --    !boundaryComps = !entry.aelrfa
  --    do !comp values !boundaryComps
  --      skip if (!comp.type ne 'BEND')
  --      !bendElements.append(!comp)
  --    enddo
  --  enddo

  !bendingMachineKey = 'BENDING MACHINE'
  !bendingMachineKeyRef = !!collectAllFor('TEXP', |upcase(ETEXT) eq 'BMACH'|, !this.noteRef)[1]
  handle any
  elsehandle none
    !bendingMachineKey = !bendingMachineKeyRef.bText
    if (!bendingMachineKey.empty()) then
      !bendingMachineKey = 'BENDING MACHINE'
    endif
  endhandle

  !spoolKey = 'SPOOL:'
  !spoolKeyRef          = !!collectAllFor('TEXP', |upcase(ETEXT) eq 'SPOOL'|, !this.noteRef)[1]
  handle any
  elsehandle none
    !spoolKey = !spoolKeyRef.bText
    if (!spoolKey.empty()) then
      !spoolKey = 'SPOOL:'
    endif
  endhandle

  !clutchKey = 'CLUTCH:'
  !clutchKeyRef         = !!collectAllFor('TEXP', |upcase(ETEXT) eq 'CLUTCH'|, !this.noteRef)[1]
  handle any
  elsehandle none
    !clutchKey = !clutchKeyRef.bText
    if (!clutchKey.empty()) then
      !clutchKey = 'CLUTCH:'
    endif
  endhandle

  !saveCe = !!ce
  do !entry values !wasteElements
    !!ce = !entry
    delete TEXP
  enddo

  !!ce = !saveCe
  handle any
  endhandle

  -- get bending tables & pipe pieces
  !ppmPipeSpoolManager = object PFPIPESPOOLMANAGER()
  !bendingTables       = !ppmPipeSpoolManager.getBendingTables(!this.spoolElement)

  --!pipePieces       = !ppmPipeSpoolManager.getPipePieces(!this.spoolElement)
  --  !pipePieces       = !this.spoolElement.pprfa

  --  !this.pipeSpoolManager = object PIPESPOOLMANAGER()
  --  !bendingTables    = !this.pipeSpoolManager.getBendingTables(!this.spoolElement)
  --  !pipePieces       = !this.pipeSpoolManager.getPipePieces(!this.spoolElement)

  !result = object ARRAY()
  !reverseBendingData = !this.pfmDefaults.reverseBendingDataOrder
  --  do !table values !bendingTables

  if !reverseBendingData.not() then
    do !i from !bendingTables.size() to 1 by -1
      !table = !bendingTables[!i]
      !activities = !table.activities
      skip if (!activities.unset())
      !pieceRef = !table.pipePiece
      !index    = !this.mtoElements.findFirst(!pieceRef).string()
      if (!table.bendingMachine.badRef()) then
        !machine  = 'MANUAL'
      else
        !machine  = !table.bendingMachine.namn
      endif

      --do !bendData values !activities
      do !j from !activities.size() to 1 by -1
        !bendData = !activities[!j]
        !feed   = !bendData.feed.nint().value().string()
        !rotate = !bendData.rotate.nint().value().string()
        !bend   = !bendData.bend.nint().value().string()
        !insertString = !feed & '!' & !rotate & '!' & !bend
        !result.append(!insertString)
      enddo

      !bendingEndData = !this.evaluateSpoolEndData(!pieceRef)
      skip if (!bendingEndData.unset())
      !clutchPart = ''
      if (!table.pipePiece.bwithf) then
        --      !clutchPart = 'END'
        if (!bendingEndData.size() eq 1) then
          !clutchPart = !bendingEndData[1]
        else
          !clutchPart = !bendingEndData[2]
        endif
      else
        --      !clutchPart = 'START'
        !clutchPart = !bendingEndData[1]
      endif

      --!insertString = !index & '!' & !machine & '!' & !clutchPart
      --!result.append(!insertString)
      !result.append('!')
      !result.append(!bendingMachineKey & !machine & '!')
      !result.append(!spoolKey & !index & ' ' & !clutchKey & !clutchPart & '!')
      if (!i ne 1) then
        !result.append('!')
      endif
    enddo
  else
    do !i from 1 to !bendingTables.size()
      !table = !bendingTables[!i]
      !activities = !table.activities
      skip if (!activities.unset())

      !pieceRef = !table.pipePiece
      !index    = !this.mtoElements.findFirst(!pieceRef).string()

      if (!table.bendingMachine.badRef()) then
        !machine  = 'MANUAL'
      else
        !machine  = !table.bendingMachine.namn
      endif

      --do !bendData values !activities
      do !j from 1 to !activities.size()
        !bendData = !activities[!j]
        !feed   = !bendData.feed.nint().value().string()
        !rotate = !bendData.rotate.nint().value().string()
        !bend   = !bendData.bend.nint().value().string()

        !insertString = !feed & '!' & !rotate & '!' & !bend
        !result.append(!insertString)
      enddo
      !bendingEndData = !this.evaluateSpoolEndData(!pieceRef)
      skip if (!bendingEndData.unset())

      !clutchPart = ''
      if (!table.pipePiece.bwithf) then
        --      !clutchPart = 'END'
        if (!bendingEndData.size() eq 1) then
          !clutchPart = !bendingEndData[1]
        else
          !clutchPart = !bendingEndData[2]
        endif
      else
        --        !clutchPart = 'START'
        !clutchPart = !bendingEndData[1]
      endif

      --!insertString = !index & '!' & !machine & '!' & !clutchPart
      --!result.append(!insertString)
      !result.append('!')
      !result.append(!bendingMachineKey & !machine & '!')
      !result.append(!spoolKey & !index & ' ' & !clutchKey & !clutchPart & '!')
      if (!i ne 1) then
        !result.append('!')
      endif
    enddo
  endif



  --  -- find index of bending table
  --  do !entry values !pipePieces
  --    !index = -1
  --    do !i indices !bendingTables
  --
  ----      if (!bendingTables[!i].pipePiece() eq !entry) then
  --      if (!bendingTables[!i].pipePiece eq !entry) then
  --        !index = !i
  --        break
  --      endif
  --    enddo
  --    skip if (!index eq -1)
  --
  --    -- get bending table
  --    !bendingTable = !bendingTables[!index]
  --    handle any
  --      skip
  --    endhandle
  --
  --    -- get bending information
  --    !tableArray = ARRAY()
  --
  ----    !a = !bendingTable.activities()
  --    !a = !bendingTable.activities
  --    if !a.size()lt(!bendElements.size()) then
  --        !size = !a.size()
  --    else
  --        !size = !bendElements.size()
  --    endif
  --    -- do !i indices !bendElements
  --    do !i from 1 to !size
  --
  ----     !bendActivities = !bendingTable.activities()[!i]
  --     !bendActivities = !bendingTable.activities[!i]
  --      -- Get the feed directly from the object
  --      --!feed   = !bendingTable.activities()[!i].feed().nint().string()
  --      -- Get the rotate directly from the object
  --      --!rotate = !bendingTable.activities()[!i].rotate().nint().string()
  --      -- Get the bend directly from the object
  --      --!bend   = !bendingTable.activities()[!i].bend().nint().string()
  --
  --      --!bendrad  = !bendElements[!i].radius.nint().string()
  --      --!bendingMachine = !bendingTable.bendingMachine().namn
  --
  --      --var !queryElements eval etext for all texp for $!this.noteRef
  --      --!partNo = !entry.aelrfa[1].ptntube
  --
  --      !bendShipPos  = !!pfTranslateShipPosition(!bendElements[!i].pos.wrt( /* ))
  --      !bendWorldPos = !bendElements[!i].pos.wrt( /* )
  --
  --      !table = object ARRAY()
  --      do !query values !queryElements
  --
  --        if (!query.empty() or !query eq 'unset') then
  --          !table.append('')
  --          skip
  --        endif
  --
  --        if (!query.upCase() eq 'INDEX') then
  --          !table.append(!entry.aelrfa[1].ptntube)
  --
  --        elseif (!query.upCase() eq ends) then
  --          !table.append(!bendActivities.feed.nint().value().string())
  --
  --        elseif (!query.upCase() eq 'ROTATE') then
  --          !table.append(!bendActivities.rotate.nint().value().string())
  --
  --        elseif (!query.upCase() eq 'BEND') then
  --          !table.append(!bendActivities.bend.nint().value().string())
  --
  --        elseif (!query.upCase() eq 'BENDRAD') then
  --          !table.append(!bendElements[!i].radius.nint().value().string())
  --
  --        elseif (!query.upCase() eq 'BENDPOINT') then
  --          -- Bend point is not set anywhere above ??? TO DO
  --          !table.append('---')
  --        elseif (!query.upCase() eq 'BENDMACH') then
  --          !table.append(!bendingTable.bendingMachine.namn)
  --          handle (2,754)
  --            !table.append('---')
  --          endhandle
  --
  --        elseif (!query.upCase() eq 'SHIPPOSX') then
  --          !table.append(!bendShipPos[1])
  --
  --        elseif (!query.upCase() eq 'SHIPPOSY') then
  --          !table.append(!bendShipPos[2])
  --
  --        elseif (!query.upCase() eq 'SHIPPOSZ') then
  --          !table.append(!bendShipPos[3])
  --
  --        elseif (!query.upCase() eq 'BENDPOSX') then
  --          !table.append(!bendWorldPos.east.nint().value())
  --
  --        elseif (!query.upCase() eq 'BENDPOSY') then
  --          !table.append(!bendWorldPos.north.nint().value())
  --
  --        elseif (!query.upCase() eq 'BENDPOSZ') then
  --          !table.append(!bendWorldPos.up.nint().value())
  --
  --        else
  --          !table.append('')
  --        endif
  --
  --      enddo
  --      !tableArray.append(!table)
  --    enddo
  --
  --    do !k indices !tableArray
  --      !insertStr = ''
  --      do !j indices !tableArray[!k]
  --
  --        skip if (!tableArray[!k][!j].empty())
  --        handle any
  --        endhandle
  --
  --        if (!j eq !tableArray[!k].size()) then
  --          !insertStr = !insertStr & !tableArray[!k][!j]
  --        else
  --          !insertStr = !insertStr & !tableArray[!k][!j] & '!'
  --        endif
  --
  --      enddo
  --      !result.append(!insertStr)
  --    enddo
  --  enddo

  return !result
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      getEndpointTable
--
-- Description: get end-point table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getEndpointTable() is ARRAY

  !arriveRef = !this.spoolElement.psarfa
  !leaveRef  = !this.spoolElement.pslrfa

  if (!this.noteRef.badRef()) then
    return object ARRAY()
  endif

  !this.queryElements =  !!collectAllFor('TEXP','', !this.noteRef)
  !posList = object ARRAY()

  -- Get the Start Positions
  do !entry values !arriveRef
    if (!entry.type eq 'BRAN') then
      !hRef = !entry.hRef
      if unset(!hRef) eq false then
        if !hRef.type inset ('TEE', 'OLET') then
          skip
        endif
      endif
    endif
    if (!entry.type eq 'BRAN') then
      !posList.append(!entry.hpos.wrt(/* ))
    else
      !posList.append(!entry.lPos.wrt(/* ))
    endif
  enddo


  -- Get the End Positions
  do !entry values !leaveRef
    if (!entry.type eq 'BRAN') then
      !tRef = !entry.tRef
      if unset(!tRef) eq false then
        if !tRef.type inset ('TEE', 'OLET') then
          skip
        endif
      endif
    endif
    if (!entry.type eq 'BRAN') then
      !posList.append(!entry.tpos.wrt(/* ))
    else
      !posList.append(!entry.apos.wrt(/* ))
      handle any
        !posList.append(!entry.pos.wrt(/* ))
      endhandle
    endif
  enddo

  !result = object ARRAY()
  !posList.unique()

  var !queryElements eval etext for all texp for $!this.noteRef

  !posData = object ARRAY()
  do !i indices !posList

    !table = object ARRAY()

    !shipPositions = !posList[!i]

    do !query values !queryElements
      if (!query.empty() or !query eq 'unset') then
        !table.append('')
        skip
      endif

      if (!query.upCase().occurs('INDEX') gt 0) then
        !table.append('C' & !i)
      elseif (!query.upCase() inset ('XPOS','EAST')) then
        !table.append(!shipPositions.east.nint().value())

      elseif (!query.upCase() inset ('YPOS','NORTH')) then
        !table.append(!shipPositions.north.nint().value())

      elseif (!query.upCase() inset ('ZPOS','UP')) then
        !table.append(!shipPositions.up.nint().value())

      elseif (!query.upCase() inset ('SHIPX','SHIPXPOS')) then
        !table.append(!!pfTranslateShipPosition(!shipPositions)[1])
        handle (2,752)(2,754)
          !table.append('')
        endhandle

      elseif (!query.upCase() inset ('SHIPY','SHIPYPOS')) then
        !table.append(!!pfTranslateShipPosition(!shipPositions)[2])
        handle (2,752)(2,754)
          !table.append('')
        endhandle

      elseif (!query.upCase() inset ('SHIPZ','SHIPZPOS')) then
        !table.append(!!pfTranslateShipPosition(!shipPositions)[3])
        handle (2,752)(2,754)
          !table.append('')
        endhandle

      elseif (!query.upCase() inset ('SHIPX_FROM_RSO', 'SHIPXPOS_FROM_RSO', 'SHIPY_FROM_RSO', 'SHIPYPOS_FROM_RSO','SHIPZ_FROM_RSO', 'SHIPZPOS_FROM_RSO')) then
        if (!query.upCase() inset ('SHIPX_FROM_RSO','SHIPXPOS_FROM_RSO')) then
          !searchDir = 'X'
        elseif (!query.upCase() inset ('SHIPY_FROM_RSO','SHIPYPOS_FROM_RSO')) then
          !searchDir = 'Y'
        else
          !searchDir = 'Z'
        endif

        !table.append(!!comTranslateRsoPosition(!searchDir, !shipPositions))
        handle ANY
          !table.append('')
        endhandle

      else
        !table.append('')
      endif

    enddo

    !insertStr = ''
    do !j indices !table
      if (!j eq !table.size()) then
        !insertStr = !insertStr & !table[!j]
      else
        !insertStr = !insertStr & !table[!j] & '!'
      endif
    enddo
    !result.append(!insertStr)
  enddo

  --Adjust the size of the area for the endpoint table
  !drawingType = func of drwg
  if (!drawingType.upCase().occurs('2D SKETCH') gt 0) then
    !isSketchType = true
  else
    !isSketchType = false
  endif

  !this.isSketchType = !isSketchType

  if (!isSketchType) then
    var !rect collect all rect for $!this.noteRef
    !sizeOfEndPoint = !result.size() + 2
    !rect[1].dbRef().nlcolour = 1
    handle any
    elsehandle none
      !rect[1].dbRef().nlstyle = 8001
      !defaultLength = 4 * !sizeOfEndPoint & 'mm'

      !rect[1].dbRef().ylength = !defaultLength.real()
    endhandle
  endif

  return !result
endmethod
-- End of method


------------------------------------------------------------------------
--
-- Method:      getWeldingTable
--
-- Description: get welding table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .getWeldingTable() is ARRAY
  -- Core returns a weldingMachine dbref but this is not on sketch


  -- Core Pipe Spool Manager object
  --  !pipeSpoolManager = object PIPESPOOLMANAGER()
  !ppmPipeSpoolManager = object PFPIPESPOOLMANAGER()
  !weldingTables = !ppmPipeSpoolManager.getWeldingTables(!this.spoolElement)

  !result = object ARRAY()
  do !weldingTable values !weldingTables
    if (!weldingTable.arriveFlangeWelded) then
      !arriveFlangeTag = !this.mtoElements.findFirst(!weldingTable.arriveFlange).string()
    else
      !arriveFlangeTag = ''
    endif

    if (!weldingTable.leaveFlangeWelded) then
      !leaveFlangeTag = !this.mtoElements.findFirst(!weldingTable.leaveFlange).string()
    else
      !leaveFlangeTag = ''
    endif

    !offsetAngle = !weldingTable.angle.value().string()

    !table = object ARRAY()
    !table.append(!arriveFlangeTag)
    !table.append(!leaveFlangeTag)
    !table.append(!offsetAngle.real().string(!!angleFMT))

    !result.append(!table)
  enddo

  return !result


  --  -- Welding Table
  --  -- Get the pipe piece data for the pspool
  --  !weldingTables = !this.spoolElement.pprfa
  --
  --  -- Initialise variable
  --  !result = ARRAY()
  --  !newResult = ARRAY()
  --
  --  do !i indices !weldingTables
  --    --Get the data for the weld arrive / leave flange from the pipe piece
  --    !pipePiece =  !weldingTables[!i]
  --    !weldArrive = !pipePiece.awdarr
  --    !weldLeave = !pipePiece.awdlev
  --    !pieceComponent = !this.spoolElement.belrfa
  --
  --    -- Which welding Table
  --    !arriveFlangeTag = ''
  --    !leaveFlangeTag  = ''
  --    !relativeAngle   = ''
  --
  --    -- Get the connection 1
  --    if (!weldArrive) then
  --      -- Get the flange tag index for the MTO Elements array .findFirst method
  --      !arriveFlangeTag = !this.mtoElements.findFirst(!pieceComponent.first()).string()
  --      handle ANY
  --        !!pipeSketchesLog('Welding Table Arrive Flange error')
  --      endhandle
  --    endif
  --
  --    -- Get the connection 2
  --    if (!weldLeave) then
  --      -- Get the flange tag index for the MTO Elements array .findFirst method
  --      !leaveFlangeTag = !this.mtoElements.findFirst(!pieceComponent.last()).string()
  --      handle ANY
  --        !!pipeSketchesLog('Welding Table Leave Flange error')
  --      endhandle
  --    endif
  --
  --    -- Get the relative angle directly from the object
  --    !weldingTables= !ppmPipeSpoolManager.getWeldingTables(!this.spoolElement)
  --    !relativeAngle = !weldingTableForAngle[!i].angle().string('D2')
  --    handle ANY
  --      !!pipeSketchesLog('Welding Table relative angle error')
  --    endhandle
  --
  --    -- Only record result if relevant
  --    if (!arriveFlangeTag.eq('') and !leaveFlangeTag.eq('') and !relativeAngle eq '0') then
  --      skip
  --    elseif !weldArrive.eq(false) and !weldLeave.eq(false) then
  --    -- Skip if there is no welding table available.
  --      skip
  --    else
  --      !result[!i] = ARRAY()
  --      !result[!i][1] = !arriveFlangeTag
  --      !result[!i][2] = !leaveFlangeTag
  --      !result[!i][3] = !relativeAngle
  --    endif
  --
  --    !insertStr = ''
  --
  --    do !j indices !result[!i]
  --      if (!j eq !result[!i].size()) then
  --        !insertStr = !insertStr & !result[!i][!j]
  --      else
  --        !insertStr = !insertStr & !result[!i][!j] & ','
  --      endif
  --    enddo
  --    !newResult.append(!insertStr)
  --
  --  enddo

  -- Compress the result array
  --  !result.compress()
  --  !result.unique()

  --if the result is null, create a minimum array for the welding table.
  --Otherwise there will no line for the table.
  if !result.size().eq(0)then
    !result = ARRAY()
    !result[1] = ARRAY()
    !result[1][1] = ''
    !result[1][2] = ''
    !result[1][3] = ''
    !result[2] = ARRAY()
    !result[2][1] = ''
    !result[2][2] = ''
    !result[2][3] = ''
  elseif !result.size().eq(1)then
    !result[2] = ARRAY()
    !result[2][1] = ''
    !result[2][2] = ''
    !result[2][3] = ''
  endif

  return !result
endmethod
-- End of method

define method .getElboCutTable() is ARRAY
  !result = object ARRAY()

  !this.queryElements.clear()
  !this.queryElements = !!collectAllFor('TEXP','', !this.noteRef)

  do !entry values !this.mtoElements
    skip if (!entry.hardType ne 'ELBO')
    --skip if (!entry.ang.nint() eq 90)

    !catAngle = !this.evaluateElbowAngleOnCata(!entry)
    skip if (abs(!catAngle - !entry.angle) le 0.9deg)

    !partNo  = !this.mtoElements.findFirst(!entry).string()
    !cutData = !!pfcalculatecutlengthforelbow(!entry)
    skip if (!cutData.unset())

    !insertString = !partNo & '!' & !cutData[1] & '!' & !cutData[2] & '!' & !cutData[3]
    !result.append(!insertString)
  enddo

  return !result
endmethod

define method .getPieceCutTable() is ARRAY
  !result = object ARRAY()

  !this.queryElements.clear()
  !this.queryElements = !!collectAllFor('TEXP','', !this.noteRef)

  do !entry values !this.mtoElements
    skip if (!entry.hardType ne 'PPIECE')

    !partNo    = !this.mtoElements.findFirst(!entry).string()
    !cutLength = !entry.:pfCutLength.string(!!distanceFMT).real().value().string('D0')
    !bore      = !!pfPipeSpoolCalcExpr(!entry.name, 'BORE')

    !insertString = '!' & !partNo & '!' & !cutLength & '!' & !bore
    !result.append(!insertString)
  enddo

  return !result
endmethod

------------------------------------------------------------------------
--
-- Method:      checkForIsoAndBoss
--
-- Description: get end-point table
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .checkForIsoAndBoss()

  -- This method will check for the existence of a boss connection and
  -- that the template being used contains an isometric detail view (Isodraft)
  -- If so it will add a warning to the error list
  -- This check is being made because Isodraft does not support boss connections.

  -- Check for isometric view
  !isoExists = false
  var !isoViewCheck coll all vnot with func eq 'OLAY_POS' for $!this.dwgTmplName
  if !isoViewCheck.size().gt(0) then
    !isoExists = true
  endif
  -- Check for boss
  !bossExists = false

  do !testForBoss values !this.mtoElements
    if !testForBoss.type.eq('OLET') and !testForBoss.catref.compType inset('STUH','STUT','BOSH','BOST','TAPH','TAPT','SSUH','SSUT','SEXH','SEXT','SSAH','SSAT') then
      !bossExists = True
    endif
  enddo

  if (!isoExists) and (!bossExists) then
    !this.writeErrorMessage(!this.spoolElement,'Warning - Boss connection found in spool. Please check dimensions.')
  endif

endmethod
-- End of method

define method .getCentrePosOnPipePiece(!pieceRef is DBREF) is POSITION
  !result = object POSITION()

  if (!pieceRef.hardType ne 'PPIECE') then
    return !result
  endif

  if (!pieceRef.cmprfa.set()) then
    !boundaryElements = !pieceRef.cmprfa
  else
    !boundaryElements = !pieceRef.aelrfa
  endif

  do !entry values !boundaryElements
    skip if (!entry.tGeom.not())

    !tubeRef = il tube of $!<entry>

    !result = !tubeRef.itposition
    handle any
    elsehandle none
      break
    endhandle
  enddo

  if (!result.unset()) then
    !fromComp = !pieceRef.pparef
    !toComp   = !pieceRef.pplref

    if (!fromComp.hardType eq 'BRAN') then
      !fromPos = !fromComp.hpos.wrt(world)
    else
      !fromPos = !fromComp.pos.wrt(world)
    endif

    if (!toComp.hardType eq 'BRAN') then
      !toPos = !toComp.tpos.wrt(world)
    else
      !toPos = !toComp.pos.wrt(world)
    endif

    !result = !fromPos.midPoint(!toPos)
    handle any
    endhandle
  endif

  return !result
endmethod

------------------------------------------------------------------------
--
-- Method:      isValidVolume
--
-- Description: check whether an element has valid volume
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .isValidVolume(!entry is DBREF) is BOOLEAN
  !volume = object LOCALVOLUME(!entry, !entry)
  !result = !volume.from.distance(!volume.to) gt 0.1mm
  handle any
    !result = false
  endhandle

  return !result
endmethod

------------------------------------------------------------------------
--
-- Method:      evaluateElbowAngleOnCata
--
-- Description: evaluate elbow angle from Catalogue
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .evaluateElbowAngleOnCata(!element is DBREF) is REAL
  !result = -1

  -- if angle of elbow is not 90 deg, it will be marked cutting information.
  !pointSet = !element.catref.ptref.members
  handle any
    return !result
  endhandle

  !catDirList = object ARRAY()
  do !pointRef values !pointSet
    skip if (!pointRef.hardType ne 'PTAX')

    !axisDir = !pointRef.paxi.direction()
    handle any
      skip
    endhandle

    skip if (!axisDir.unset())

    if (!catDirList.unset()) then
      !catDirList.append(!axisDir)
    else
      !insertFlag = false
      do !catDir values !catDirList
        skip if (!catDir.isParallel(!axisDir))
        !insertFlag = true
        break
      enddo

      if (!insertFlag) then
        !catDirList.append(!axisDir)
      endif
    endif
  enddo

  !catDirList.unique()
  !catAngle = object REAL()
  if (!catDirList.size() gt 1) then
    !catAngle = !catDirList.first().angle(!catDirList.last())
    if (!catAngle gt 90) then
      !catAngle = 180 - !catAngle
    endif
  else
    !catAngle = 90deg
  endif

  return !catAngle
endmethod

define method .executeTasks()
  !taskList = !!collectAllFor('TASK', |pmlfunc ne ''|, !!ce)
  if (!taskList.unset()) then
    return
  endif

  do !taskRef values !taskList
    skip if (!taskRef.func.upCase() inset ('SPOOL DIMENSION', 'TAG DEFAULTS'))
    skip if (!taskRef.sppurp eq 'ARRLAB')

    !pmlFunction = !taskRef.pmlFunction
    $!<pmlFunction>
    handle any
      !this.writeErrorMessage(!taskRef, !!error.text)
    endhandle
  enddo
endmethod
