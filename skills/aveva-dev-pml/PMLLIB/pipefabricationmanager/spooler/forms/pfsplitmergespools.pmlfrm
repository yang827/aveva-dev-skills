--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  createNewElement()               -                   create new element
--  highLightSpool(DBREF)            -                   high light spool
--  initialise()                     -                   initialise
--  pfsplitmergespools()             -                   constructor
--  setSpoolLimit()                  -
--  showSearchOption()               -
--  showSpoolLimit()                 -                   show spool limit
--  tidy()                           -                   tidy
--  track()                          -                   track
--
------------------------------------------------------------------------
--- form definition
setup form !!pfsplitmergespools
  !iconSize = !!comSysOpt.iconSize()
  !this.formTitle  = 'Multiple Spool'
  !this.initcall   = |!this.initialise()|
  !this.quitcall   = '!this.tidy()'

  frame .storage 'Storage' anchor l+r+t
    button .createElement 'Create Element' pixmap width $!iconSize height $!iconSize tooltip 'Create Element' callback |!this.createNewElement()|
    option .createType    width 10  toolTip 'Type of Element'

    text   .activeSplDrg anchor l+r+t width 30 is STRING tooltip 'Active Spool Drawing'
  exit

  path down

  frame .functions 'Spool Functions' anchor l+r+t width.storage height 2.5
    button .addElement  pixmap at x1 width $!iconSize height $!iconSize tooltip 'Add to Spool Drawing by Pick'    callback |!this.spoolManager.pickElements(TRUE)|
    hdist 2
    path right
    button .removeElement pixmap width $!iconSize height $!iconSize tooltip  'Remove from Spool Drawing by Pick'    callback |!this.spoolManager.pickElements(FALSE)|
    button .includeFields toggle pixmap width $!iconSize height $!iconSize tooltip  'Include Field Components'
    button .updatePartNumber 'Update PartNumber'  at xmax2 tooltip  'Update Part Number' width 15                  callback |!this.spoolManager.updatePartNumber()|
    button .deleteAllMembers 'Delete All Members' tooltip  'Delete All Members' width 15              callback |!this.spoolManager.deleteAllMembers()|
  exit

  path down

  option .searchOption 'Search Within' tagwidth 10 callback |!this.setSpoolLimit()| width 10



--- form definition
  -- setup form tracking
  track |ISODCE| |DESICE| callback '!this.track()'

  member .spoolManager   is PFSPOOLER
  member .shownError     is BOOLEAN
  member .spoolAidColour is STRING
  member .fieldAidColour is STRING
exit

------------------------------------------------------------------------
--
-- Method:      pfsplitmergespools
-- Description: constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pfsplitmergespools()
  -- set icons
  !this.createElement.addPixmap(!!pml.getPathName('createelement16.png'))
  !this.addElement.addPixmap(!!pml.getPathName('spldrgadd24.png'))
  !this.removeElement.addPixmap(!!pml.getPathName('spldrgremove24.png'))
  !this.includeFields.addPixmap(!!pml.getPathName('includefieldson24.png'))

  -- set element types for creating
  !this.createType.dText = split('Department,Registry,Spool Drawing',',')

  !this.spoolManager.ownerForm = !this
  !this.shownError = false

  !this.spoolAidColour = 'CYAN'
  !this.fieldAidColour = 'GREEN'

  !this.searchOption.dText = split('Pipe,Branch,Zone,Site,World',',')
  !this.searchOption.rText = split('PIPE,BRAN,ZONE,SITE,WORLD',',')

endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      track
-- Description: track
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .track()
  !element = !!ce
  handle any
    return
  endhandle

  !dbType  = !element.dbType
  -- check db type
  if (!dbType ne 'ISOD' and !dbType ne 'DESI') then
    return
  endif

  !checkDBWrite    = object COMCHECKDBWRITE()

  -- check current element
  if (!dbType eq 'ISOD') then
    !sourceEntry = SPLDRG of $!<element>
    handle (2,111)
      !sourceEntry = ISOREG of $!<element>
      handle (2,111)
        !sourceEntry = ISODEP of $!<element>
        handle (2,111)
          return
        endhandle
      endhandle
    elsehandle NONE
      --return
    endhandle

    !checkDBWrite.showAlert = false
    if (!checkDBWrite.checkDBWrite(!sourceEntry)) then
      !dbWriteFlag = true
      --!this.deleteAllMembers.active = !sourceEntry.mCount gt 0
    else
      !dbWriteFlag = false
    endif

    if (!dbWriteFlag.not()) then
      !this.addElement.active     = !dbWriteFlag
      !this.removeElement.active  = !dbWriteFlag
      !this.includeFields.active  = !dbWriteFlag
    endif

    if (!dbWriteFlag and !sourceEntry.mCount gt 0 and !this.spoolManager.isPickMode.not()) then
      !this.deleteAllMembers.active   = true
      !this.updatePartNumber.active   = true
    else
      !this.deleteAllMembers.active   = false
      !this.updatePartNumber.active   = false
    endif

  else
    !sfRef = !element.sfRef
    handle (2,201)
      return
    endhandle

    if (undefined(!sfRef) or !sfRef.unset()) then
      return
    endif
    !sourceEntry = SPLDRG of $!sfRef
    handle any
      return
    endhandle
  endif

  !checkDBWrite.showAlert = false

  if (!checkDBWrite.checkDBWrite(!sourceEntry).not()) then
    if (!this.shownError.not()) then
      !!alert.error(!checkDBWrite.errorMessage)
      !this.shownError = true
    else
      !this.shownError = false
    endif
  endif

  if (!this.activeSplDrg.val ne !sourceEntry.flnm) then
    !this.shownError = false
  endif

  !this.activeSplDrg.val = !sourceEntry.flnm
  handle (2,751)
    return
  elsehandle none
    if (!sourceEntry.type.eq(|SPLDRG|)) then
        !this.createType.val = 3
        handle any
          return
        endhandle
    elseif (!sourceEntry.type.eq(|ISOREG|)) then
        !this.createType.val = 2
        handle any
          return
        endhandle
    elseif (!sourceEntry.type.eq(|ISODEP|)) then
        !this.createType.val = 1
        handle any
          return
        endhandle
    endif
  endhandle

   if (!sourceEntry.type.eq('SPLDRG') )then
     !this.setSpoolLimit()
  endif

  if (!dbType eq 'ISOD' ) then
     !this.showSpoolLimit()
--  else
--    unenhance all
--    handle any
--    endhandle
  endif
if (!sourceEntry.type.eq('SPLDRG') )then
   !this.showSearchOption()
endif

endmethod
-- End of method

define method .showSearchOption()

  !splDrwg = object DBREF(!this.activeSplDrg.val)
  handle any
    !splDrwg = object DBREF()
  endhandle

  if (!splDrwg.badRef()) then
    return
  endif
  if (!splDrwg.sflimit.occurs('PIPE') gt 0) then
    !index   = 1
  else
   !index   = !this.searchOption.rText.findFirst(!splDrwg.sflimit)
  endif

  if (!index.unset()) then
    return
  endif

  !this.searchOption.val = !index
endmethod



------------------------------------------------------------------------
--
-- Method:      showSpoolLimit
-- Description: show spool limit
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .showSpoolLimit()
  if (!this.spoolManager.isPickMode) then
    return
  endif

  unenhance all
  handle any
    return
  endhandle

  if (!!ce.hardType eq 'SPLDRG') then
    !spoolList = !!ce.members
--    !spoolList = !!collectAllFor('SPOOL', '', !!ce)

    do !entry values !spoolList
      !isValidType = !entry.hardType inset('SPOOL','FIELD')
      skip if (!isValidType.not())

      !this.highLightSpool(!entry)
    enddo
  elseif (!!ce.hardType inset ('SPOOL','FIELD')) then
    !this.highLightSpool(!!ce)
  else
    !sfRef = !!ce.sfRef
    handle any
      return
    endhandle

    if (undefined(!sfRef) or !sfRef.unset()) then
      return
    endif

    if (!sfRef.hardType ne 'SPOOL') then
      return
    endif

    !this.highLightSpool(!sfRef)
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      highLightSpool
-- Description: high light spool
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       spool ref
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .highLightSpool(!spoolRef is DBREF)
  !spoolMembers = !spoolRef.splMem
  handle ANY
    return
  endhandle

  if (!spoolRef.hardType eq 'SPOOL') then
    !aidColour = !this.spoolAidColour
  else
    !aidColour = !this.fieldAidColour
  endif

  do !spoolEntry values !spoolMembers
    enhance $!<spoolEntry> colour $!<aidColour>
    handle any
    endhandle
  enddo
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
-- Description: initialise
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()
  if (undefined(!!pfspooler)) then
    !!pfspooler = object PFSPOOLER()
  endif

  !this.track()
  !this.searchOption.active = true

  import 'PipeFabricationAddin'
  handle any
  endhandle

  using namespace 'Aveva.Pdms.PipeFabrication.FabricationExplorer'

  !fabExplorer = object PFFABRICATIONEXPLORERPML()
  handle (46,87)
    !!alert.error(!errorMessage)
    return
  endhandle

  if (!!appDesMain.explorersMenu.selected('Fabrication Explorer').not()) then
    !fabExplorer.show()
    handle any
      !!alert.error(!errorMessage)
      return
    endhandle
  endif
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      createNewElement
-- Description: create new element
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .createNewElement()
  !elementTypes = split('ISODEP,ISOREG,SPLDRG',',')

  if (undefined(!!pfSpoolDrwgMemberCreate)) then
    pml load form !!pfSpoolDrwgMemberCreate
  endif

  !!pfSpoolDrwgMemberCreate.type = !elementTypes[!this.createType.val]
  show !!pfSpoolDrwgMemberCreate at xr0.5 yr0.3

endmethod
-- End of method

define method .setSpoolLimit()
  !checkDBWrite    = object COMCHECKDBWRITE()

  !sourceEntry = object DBREF(!this.activeSplDrg.val)
  handle ANY
    return
  endhandle

  !checkDBWrite.showAlert = true
  if (!sourceEntry.unset() OR !checkDBWrite.checkDBWrite(!sourceEntry).not()) then
    return
  endif

  !spoolLimit = !this.searchOption.rText[!this.searchOption.val]
  !sourceEntry.sflimit = '$!<spoolLimit>'
  handle (2,754)
    !!alert.error(!!error.text)
  endhandle
endmethod

------------------------------------------------------------------------
--
-- Method:      tidy
-- Description: tidy
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .tidy()
  unenhance all
  handle any
  endhandle
  !!edgCntrl.remove(!this.spoolManager.edgPacket)
endmethod
-- End of method
