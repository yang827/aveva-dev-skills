--
--  Description:
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   apply
--  initialise()                     -                   initialise
--  pfSpoolDrwgMemberCreate()        -                   constructor
--  setAutoName()                    -                   set auto name
--
------------------------------------------------------------------------
--- form definition
setup form !!pfSpoolDrwgMemberCreate at xr 0.5 yr 0.5
  !this.formTitle  = 'Create'
  !this.initcall  = |!this.initialise()|

  text    .name 'Name'         tagwidth 8 at x0.5     ymax    callback |!this.name.val = !!checkName(!this.name.val, 'NEW')| width 30 name
  button  .autoName                       at xmax+0.5 ymin    pixmap  call |!this.setAutoName()| tooltip 'AutoNaming'

  button .apply   'Apply'      at x0.5 ymax   callback '!this.apply()'
  button .dismiss 'Dismiss'  at xmax form-size ymin cancel

  member .type    is STRING
  member .undo    is UNDOABLE
exit

------------------------------------------------------------------------
--
-- Method:      pfSpoolDrwgMemberCreate
-- Description: constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .pfSpoolDrwgMemberCreate()
  !this.autoName.addPixmap(!!pml.getPathname('autoname.png'))
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      initialise
-- Description: initialise
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()
  if (!this.type eq 'ISODEP') then
    !createType = 'Department'
  elseif (!this.type eq 'ISOREG') then
    !createType = 'Registry'
  else
    !createType = 'Spool Drawing'
  endif

  !this.formTitle = 'Create ' & !createType
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      setAutoName
-- Description: set auto name
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .setAutoName()
  !newName = !!comautoname(!this.type)
  if (!newName.unset()) then
    return
  endif

  if (!newName.substring(1,1) ne '/') then
    !newName = '/' & !newName
  endif

  !this.name.val = !newName
endmethod
-- End of method

------------------------------------------------------------------------
--
-- Method:      apply
-- Description: apply
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .apply()
  if (!!ce.dbType ne 'ISOD') then
    !isoDeptList = !!collectAllfor('ISODEP','',world)
    if (!isoDeptList.unset()) then
      !!alert.error('Please select a member on Fabrication Explorer')
      return
    endif

    !!ce = !isoDeptList[1].owner
  endif

  -- check input variables
  if (!this.name.val.empty()) then
    !!alert.error('Please enter a name for element')
    !this.name.setFocus()
    return
  endif

  !!pfSplitMergeSpools.activeSpldrg.val= !this.name.val

  var !exist EXIST $!<this.name.val>
  if (!exist eq 'TRUEA') then
    !!alert.error('Name ' & !this.name.val & ' already used.')
    !this.name.setFocus()
    return
  endif

  !this.undo.description('createSpoolDrawingMembers')
  !this.undo.add()

  -- create element
  new $!this.type $!this.name
  handle any
    !!alert.error(!!error.text)
    return
  endhandle

  if (!this.type eq 'SPLDRG') then
    !sfLimit = !!pfSplitMergeSpools.searchOption.rText[!!pfSplitMergeSpools.searchOption.val]
    SFLimit $!<sfLimit>
  endif

  !this.undo.endUndoable()

  savework
  uncl all

  !this.name.val = ''

  !this.hide()
endmethod
-- End of method
