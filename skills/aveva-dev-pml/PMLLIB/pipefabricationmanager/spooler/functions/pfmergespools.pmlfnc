--  Author:          Jaehun Choi(Daniel)
--  Created:         11 January 2013
--
--  Description:     merge spools
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     DBREF       spool drawing ref
--    2    R     ARRAY       element list
--    3    R     BOOLEAN     is merge mode
--    4    R     STRING      include field flag
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!pfmergespools(!spoolDrawingRef is DBREF, !elementList is ARRAY, !isMergeMode is BOOLEAN, !includeFieldFlag is STRING)
  var !projCode proj code
  var !mdb mdb
  var !user user
--  var !unique unique
  var !installenv evar 'pdms_installed_dir'

  !debugMode = false

  -- create temporary login file
  !userlogin = object PMLUSERLOGIN()
  !userlogin.project(!projCode)
  !userlogin.mdb(!mdb)

  var !path evar pdmswk
  !path = !path.replace(';','')
  !userlogin.saveToFile(!path & '\temp_login_' & !user & '.tmp')

  -- write contents file
  !pdmsuser = !!evarSplit('PDMSUSER')[1]
  !contentsFile = object FILE('$!pdmsuser\pfspoolmerge.dat')
  !contentsFile.open('OVER')
  do !entry values !elementList
    !contentsFile.writeRecord(!entry.flnm)
  enddo
  !contentsFile.close()

  -- create macro file for merge spools
  !macfile = object FILE('$!pdmsuser\pfmergespools.mac')
  !macfile.open('OVER')

  -- run temporary user login file as first line of makespooldrwg.mac to set project, username, password and MDB
  !macfile.writeRecord('$m "/$!path\temp_login_' & !user & '.tmp"')

  -- write current mdb
  !macfile.writeRecord(!mdb)
  -- log-in spooler module
  !macfile.writeRecord(|spooler|)
  !macfile.writeRecord('SPOOLING OPTIONS INCLUDEFIELDS ' & !includeFieldFlag)

  !!ce = !spoolDrawingRef
  !spoolDrawingName = !spoolDrawingRef.name

  !macfile.writeRecord(|!!pfspoolingmege('$!spoolDrawingName', '$!isMergeMode')|)

  -- write to file to record run as complete
  !macfile.writeRecord(|!donefile = object FILE('%pdmsuser%\ppmergespools.log')|)
  !macfile.writeRecord(|!donefile.open('OVER')|)
  !macfile.writeRecord(|!donefile.writeRecord('DONE')|)
  !macfile.writeRecord(|!donefile.close()|)

  !macfile.writeRecord(|QUIT|)
  !macfile.writeRecord(|FINISH|)

  !macfile.close()

  -- create batch file to batch run
  !batchFile = object FILE('$!pdmsuser\pfmergespools.bat')
  !batchFile.open('OVER')
  !batchFile.writeRecord(|setlocal|)
  !batchFile.writeRecord(|set savepath=%path%|)
  !batchFile.writeRecord(|set pdms_installed_dir=$!installenv|)
  !batchFile.writeRecord(|set AVEVA_MARINE=YES|)
  !batchFile.writeRecord(|set MARINE=YES|)
  !batchFile.writeRecord(|call "%pdms_installed_addin_dir%\evars.bat" "%pdms_installed_addin_dir%"|)
  if (!debugMode) then
    !batchFile.writeRecord(|"%pdms_installed_dir%\MON"  tty -macro="$!pdmsuser/pfmergespools.mac"|)
  else
    !batchFile.writeRecord(|"%pdms_installed_dir%\MON"  tty  -noconsole -macro="$!pdmsuser/pfmergespools.mac"|)
  endif

  !batchFile.writeRecord(|endlocal|)
  !batchFile.writeRecord(|exit|)
  !batchFile.close()
  -- create spool drawing by batch run
  if (!debugMode) then
    SYSCOM 'START /MIN cmd.exe /C "$!batchFile" &'
    $.
  endif

  -- wait until the background process is finished
  !batchFileFullPath = !batchFile.fullname()
  import 'PipeFabricationAddin'
  handle any
  endhandle

  using namespace 'Aveva.Pdms.PipeFabrication.RunBatchProc'
  !runBatchProc = object RUNBATCHPROCESS()
  handle any
    SYSCOM 'START /MIN cmd.exe /C "$!batchFile" &'
  elsehandle none
    !runBatchProc.run(!batchFileFullPath)
  endhandle

endfunction
-- End of function definition
