--
--  Description:     spooling merge
--
----------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1    R     STRING      spool drawing name
--    2    R     STRING      merge mode
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
-- Define function
define function !!pfspoolingmege(!spoolDrawingName is STRING, !mergeMode is STRING)
  !spoolDrawingRef = !spoolDrawingName.dbRef()
  handle (2,813)
    return
  endhandle

  if (!spoolDrawingRef.dbWrite.not()) then
    return
  endif

  !isMergeMode = object BOOLEAN(!mergeMode)

  !pdmsUser = !!evarSplit('pdmsuser')[1]
  !contentsFile = object FILE('$!pdmsUser\pfspoolmerge.dat')
  if (!contentsFile.exists().not()) then
    return
  endif

  !!ce = !spoolDrawingRef

  !pdmsUserPath  = !!evarSplit('PDMSUSER')[1]
  !errorFile     = object FILE('$!pdmsUserPath\pfmergespools.err')

  !errorFile.open('OVER')
  handle any
    !errorFile = object FILE()
  endhandle

  !errorContents = object ARRAY()
  !contentsFile.open('READ')

  do
    !record = !contentsFile.readRecord()
    break if (!record.unset())

    !element = !record.dbRef()
    handle (2,813)
      !errorContents.append(!!error.text)
      !element = object DBREF()
    endhandle

    skip if (!element.badRef())

    if (!isMergeMode) then

      SPOOLING ADD CE $!element
      handle any
        !errorContents.append(!!error.text)
      endhandle
    else
      !spoolRef = !element.sfRef
      skip if (!spoolRef.badRef())

      -- this command may return fatal error
      SPOOLING REMOVE $!spoolRef
      handle any
        !errorContents.append(!!error.text)
      endhandle
    endif
  enddo

  -- if "SAVEWORK" and "GETWORK" used, the fatal error will be happened sometimes in design module.
  -- so, this way is used.

  !pfSpooler = object PFSPOOLER()
  !macFilePath = !pfSpooler.tempMacroPath

  FILE /$!macFilePath OVER
  handle any
    !errorContents.append(!!error.text)
  elsehandle none
    OUTPUT CE CHANGE SINCE LATEST
    TERM
  endhandle

--  input begin
--  delete SPLDRG mem
--  handle any
--   !errorContents.append(!!error.text)
--  endhandle
--  input finish
--
--  savework
--  uncl all

--  !members = !!ce.members
--  if (!!ce.mCount eq 1 and !!ce.members[1].type eq 'FIELD') then
--    input begin
--    delete SPLDRG mem
--    handle any
--      !errorContents.append(!!error.text)
--    endhandle
--    input finish
--  endif

--  SAVEWORK
--  handle any
--  endhandle
--
--  UNCL ALL
--  handle any
--  endhandle

  if (!errorContents.set()) then
    do !errorText values !errorContents
      !errorFile.writeRecord(!errorText)
      handle any
      endhandle
    enddo
  endif

  !errorFile.close()
  handle any
  endhandle

  !pfSpooler = object PFSPOOLER()
  !pfSpooler.createFinishFile()
endfunction
-- End of function definition
