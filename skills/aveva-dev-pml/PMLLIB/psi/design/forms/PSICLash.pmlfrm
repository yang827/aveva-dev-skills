--
-- File:		PSIClash.pmlfrm
--   Type:		Form Definition
--   Group:		Pipe Stress
--     Keyword:		PSI
--   Module:		Design
--   Replaces:
--
-- Author:		Tony Martin
-- Created:		26/01/2006 11:01
--
--
-- Description:
-- Form Definition for PSI Clash Detection
--
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
--
-- Define Form
    kill !!PSIClash

    Setup Form  !!PSIClash

      !!PSIClash.formtitle = ' PSI Clash '
      !!PSICLash.icontitle = 'PSI'
      !this.initcall = '!this.init()'

      rgroup .fncdtype ' Evaluation method' Horizontal
           add tag 'Expression'
           add tag 'Function'
      exit


-- Frame for Heading Data
      frame .fhdg | Expression Data | at xmin.fncdtype ymax
        text .fncdescr    |Description : |  at x1      ymax call || width 35 is string
        text .fncexprn    |Text        : | at x1       ymax call || width 35 scroll 256 is string
       exit

-- Bottom Line
      button .dismiss | Dismiss | at xmax form-size ymax+0.5  call |!this.cancel()|  CANCEL
      button .apply   | Save |    at x0             ymin  call ||

-- member .expressions is ARRAY
--member .mode is STRING
--member .currentexpression is PSIExpression
--member .order is REAL

    exit
-- End of form definition
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
--
-- Method: init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
define method .init()



endmethod
------------------------------------------------------------------------------------------------


------------------------------------------------------------------------------------------------
--
-- Method: cancel
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
define method .cancel()

     -- Hide the form
     !this.hide()

endmethod

------------------------------------------------------------------------------------------------
