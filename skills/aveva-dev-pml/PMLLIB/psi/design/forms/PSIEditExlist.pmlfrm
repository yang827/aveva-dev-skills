--
--   File:    PSIEditExlist.pmlfrm
--   Type:    Form Definition
--   Group:   Pipe Stress
--   Keyword:   PSI
--   Module:    Design
--   Replaces:
--
-- Author:    Tony Martin
-- Created:   03/04/2006 09:35
--
--
-- Description:
-- Form Definition for Editing Pipe Stress ignore list Expressions
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -
--  init()                           -
--  writeExpression()                -
--
------------------------------------------------------------------------------------------------
--
-- Define Form

    setup form  !!psiEditExList at xr0.6 yr0.07
      !!psiEditExList.formtitle = ' PSI Exclude Element '
      !!psiEditExList.icontitle = 'PSI'
      !!psiEditExList.initcall = '!!psiEditExList.init()'

-- Frame for Heading Data
      frame .fhdg | Excluded Components |

        text .functionType     |Component Type  |  at x1       ymax call || width 35 is STRING
        text .functionAtt      |Test Attribute  |  at x1       ymax call || width 35 is STRING
        text .functionExprn    |Attribute Value |  at x1       ymax call || width 35 scroll 256 is STRING
       exit

-- Bottom Line
      button .dismiss | Dismiss | at xmax form-size ymax+0.5  call |!this.cancel()|  CANCEL
      button .apply   | Apply |    at x0             ymin  call |!this.writeExpression()|

-- member .expressions is ARRAY
member .mode is STRING
member .currentExpression is PSIEXPRESSION
member .order is REAL
member .list is STRING

    exit
-- End of form definition
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
--
-- Method: init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
define method .init()

  !this.functionType.val = !this.currentExpression.description
  !this.functionAtt.val = !this.currentExpression.expression
  !this.functionExprn.val = !this.currentExpression.dataType

endmethod
------------------------------------------------------------------------------------------------


------------------------------------------------------------------------------------------------
--
-- Method: cancel
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
define method .cancel()

     -- Hide the form
     !this.hide()

endmethod

------------------------------------------------------------------------------------------------


------------------------------------------------------------------------------------------------
define method .writeExpression()

   if !this.functionType.val.unset() then
       !!alert.error('No Component Type Specified')
       return
   endif
   if !this.functionAtt.val.unset() then
       !!alert.error('No Comparison Attribute Specified')
       return
   endif
   if !this.functionExprn.val.unset() then
       return
       !!alert.error('No Expression Specified')
   endif

   !string = !this.functionType.val & '\' & !this.functionAtt.val & '\' & !this.functionExprn.val & '\'

   !this.currentExpression = object PSIEXPRESSION(!string)
   if !this.mode eq'edit' then
      $!!<psiDefaults.currentlist>[!this.order] = !this.currentExpression.textString
   elseif !this.mode eq 'add' then
      if !this.order.gt(0) then
         $!!<psiDefaults.currentlist>.insert(!this.order,!this.currentExpression.textString)
      else
          $!!<psiDefaults.currentlist>[1] = !this.currentExpression.textString
      endif
   endif

   -- refresh the lists

    !!psiDefaults.expressiondata(!this.list)

endmethod
------------------------------------------------------------------------------------------------
