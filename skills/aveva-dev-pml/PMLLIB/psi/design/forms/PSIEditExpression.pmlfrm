--
-- File:		PSIEditExpression.pmlfrm
--   Type:		Form Definition
--   Group:		Pipe Stress
--     Keyword:		PSI
--   Module:		Design
--   Replaces:
--
-- Author:		Tony Martin
-- Created:		26/01/2006 11:02
--
--
-- Description:
-- Form Definition for Editing Pipe Stress Expressions
--
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
--
-- Define Form

    Setup Form  !!PSIEditExpression at xr0.6 yr0.07
      !!PSIEditExpression.formtitle = ' PSI Expression Editor '
      !!PSIEditExpression.icontitle = 'PSI'
      !this.initcall = '!this.init()'
      rgroup .fncdtype ' Evaluation method' Horizontal
           add tag 'Expression'
           add tag 'Function'
      exit


-- Frame for Heading Data
      frame .fhdg | Expression Data | at xmin.fncdtype ymax
        text .fncdescr    |Description    | at x1   ymax call || width 35 is string
        text .fncexprn    |Expression Text| at x1   ymax call || width 35 scroll 256 is string
       exit

-- Bottom Line
      button .dismiss | Dismiss | at xmax form-size ymax+0.5  call |!this.cancel()|  CANCEL
      button .apply   | Apply |    at x0             ymin  call |!this.writeexpression()|

-- member .expressions is ARRAY
member .mode is STRING
member .currentexpression is PSIExpression
member .order is REAL
member .list is STRING

    exit
-- End of form definition
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
--
-- Method: init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
define method .init()

  !this.fncdescr.val = !this.currentexpression.description
  !this.fncexprn.val = !this.currentexpression.expression
  --q var  !this.currentexpression.datatype
  if !this.currentexpression.datatype.eq('Function') then
       !this.fncdtype.val = 2
  else
       !this.fncdtype.val = 1
  endif

endmethod
------------------------------------------------------------------------------------------------


------------------------------------------------------------------------------------------------
--
-- Method: cancel
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
define method .cancel()

     -- Hide the form
     !this.hide()

endmethod

------------------------------------------------------------------------------------------------


------------------------------------------------------------------------------------------------
define method .WriteExpression()

   if !this.fncdescr.val.unset() then
        !this.fncdescr.val = ''
   endif
   if !this.fncexprn.val.unset() then
       !this.fncexprn.val  = ''
   endif
   --if !this.fncdtype.val.unset() then
   --    !this.fncdtype.val = ''
   --endif

    if !this.fncdtype.val.eq(1) then
        !type = 'Expression'
    else
        !type = 'Function'
    endif

   !STRING = !this.fncdescr.val & '\' & !this.fncexprn.val & '\' & !type

   !this.currentexpression = object psiexpression(!STRING)
   if !this.mode eq 'edit' then
      $!!<psidefaults.currentlist>[!this.order] = !this.currentexpression.textstring
   elseif !this.mode eq 'add' then
      if !this.order.gt(0) then
         $!!<psidefaults.currentlist>.insert(!this.order,!this.currentexpression.textstring)
      else
          $!!<psidefaults.currentlist>[1] = !this.currentexpression.textstring
      endif
   endif

   -- refresh the lists
    !!psidefaults.expressiondata(!this.list)

endmethod
------------------------------------------------------------------------------------------------
