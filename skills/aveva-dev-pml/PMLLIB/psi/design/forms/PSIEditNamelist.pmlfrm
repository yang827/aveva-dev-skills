--
--   File:    PSIEditNamelist.pmlfrm
--   Type:    Form Definition
--   Group:   Pipe Stress
--   Keyword: PSI
--   Module:  Design
--   Replaces:
--
-- Author:    Tony Martin
-- Created:   03/04/2006 09:35
--
--
-- Description:
-- Form Definition for Editing Pipe Stress ignore list Expressions
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -
--  init()                           -
--  testExpression()                 -
--  writeExpression(BOOLEAN)         -
--
------------------------------------------------------------------------------------------------
--
-- Define Form

    setup form  !!psiEditNamelist at xr0.6 yr0.07
      !!psiEditNamelist.formtitle = ' PSI Element Name Rule'
      !!psiEditNamelist.icontitle = 'PSI'
      !!psiEditNamelist.initcall  = '!!psiEditNamelist.init()'

-- Frame for Heading Data
      frame .fhdg | Component Name Rules |

        option .componentType     |Component Type  |  at x1 ymax tooltip |Type of component needed to execute rule| call || width 35
        text     .componentRule     |Component Rule  |  at x1 ymax tooltip  |Boolean expression TRUE or FALSE| call || width 35 is STRING
        option .componentPoint    |Component Point |  at x1 ymax tooltip |Node to be tested (1 = start 2 = end 3 = branch)| call | | width 35
        text   .nameRule      |Name Attribute  |  at x1 ymax tooltip |Attribute Which Contains the Name| call || width 35 scroll 256 is STRING
        !optArray[1] = '1'
        !optArray[2] = '2'
        !optArray[3] = '3'
        !optArray[4] = '0'
        !this.componentPoint.dtext = !optArray

        !typeArray[1] =  'ATTA'
        !typeArray[2] =  'BRAN'
        !typeArray[3] =  'ELBO'
        !typeArray[4] =  'BEND'
        !typeArray[5] =  'TEE '
        !typeArray[6] =  'VALV'
        !typeArray[7] =  'REDU'
        !typeArray[8] =  'FLAN'
        !typeArray[9] =  'CROS'
        !typeArray[10] = 'GASK'
        !typeArray[11] = 'FTUB'
        !typeArray[12] = 'SHU '
        !typeArray[13] = 'COUP'
        !typeArray[14] = 'CLOS'
        !typeArray[15] = 'OLET'
        !typeArray[16] = 'LJSE'
        !typeArray[17] = 'CAP '
        !typeArray[18] = 'FBLI'
        !typeArray[19] = 'VTWA'
        !typeArray[20] = 'VFWA'
        !typeArray[21] = 'FILT'
        !typeArray[22] = 'WELD'
        !typeArray[23] = 'PCOM'
        !typeArray[24] = 'UNIO'
        !typeArray[25] = 'INST'

        !this.componentType.dtext = !typeArray

       exit

-- Bottom Line
      button .dismiss | Dismiss | at xmax form-size ymax+0.5  call |!this.cancel()|  CANCEL

      button .apply   | Apply |    at x0             ymin  call |!this.writeExpression(true)|
      butto  .test    | Test  |    at xmax +5        ymin  call |!this.testExpression()|

-- member .expressions is ARRAY
member .mode is STRING
member .currentExpression is PSIEXPRESSION
member .order is REAL
member .list is STRING

    exit
-- End of form definition
------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------
--
-- Method: init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
define method .init()


   !this.componentType.select('DTEXT',!this.currentExpression.componentType )
   handle ANY
     -- gets the previous selection
   endhandle
   !this.componentRule.val  = !this.currentExpression.componentRule
   handle ANY
   endhandle
   !this.nameRule.val  = !this.currentExpression.nameRule
   handle ANY
   endhandle
   !this.componentPoint.select('DTEXT',!this.currentExpression.componentPoint)
   handle ANY
   endhandle

endmethod
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
--
-- Method: cancel
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
define method .cancel()

     -- Hide the form
     !this.hide()

endmethod

------------------------------------------------------------------------------------------------


------------------------------------------------------------------------------------------------
define method .writeExpression(!write is BOOLEAN)


   if !this.componentType.val.unset() then
       !!alert.error('No Component Type Specified')
       return
   endif


   if !this.componentRule.val.unset() then
       !!alert.error('No Comparison Attribute Specified')
       return
   endif

   if !this.nameRule.val.unset() then
       !!alert.error('No Expression Specified')
       return
   endif

   if !this.componentPoint.val.unset() then
       !!alert.error('No component point Specified')
       return
   endif

   !string = !this.componentType.selection() & '\' & !this.componentRule.val & '\' & !this.nameRule.val & '\' & !this.componentPoint.selection()  & '\'

   !this.currentExpression = object PSIEXPRESSION(!string)

   if !write.not() then
      !this.currentExpression.node = object STRESSNODE(!!ce,!this.componentPoint.val.real(),10)
     return
   endif
   if !this.mode eq'edit' then
      $!!<psiDefaults.currentList>[!this.order] = !this.currentExpression.textString
   elseif !this.mode eq 'add' then
      if !this.order.gt(0) then
         $!!<psiDefaults.currentList>.insert(!this.order,!this.currentExpression.textString)
      else
         $!!<psiDefaults.currentList>[1] = !this.currentExpression.textString
      endif
   endif

   -- refresh the lists

    !!psiDefaults.expressiondata(!this.list)

endmethod
------------------------------------------------------------------------------------------------

define method .testExpression()

!this.writeExpression(FALSE)
!return = !this.currentExpression.evaluateName()

if !return[1].eq(0) then
   !!alert.message('Expression result - $!return[3]')
else
   !!alert.message('Expression result - $!return[2]')
endif

endmethod
