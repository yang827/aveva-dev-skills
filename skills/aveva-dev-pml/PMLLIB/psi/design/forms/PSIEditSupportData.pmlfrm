------------------------------------------------------------------------------------------------
--
------------------------------------------------------------------------------------------------
-- Define method
define method .cancel()

     -- clear the display arrows
     if !this.valueChanged then
       if !!alert.confirm('Support values have not been Saved - do you want to continue').neq('YES') then
         return
       endif
     endif

     -- need to make this more specific rather than everything
     -- this could be for the
     !this.restraintgroup.displayall(FALSE)

     -- Hide the form
     !this.hide()


endmethod
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
-- method to take the real array from a the :node udas and convert them to strings for display in the nodeList

define method .converttostring(!input is ARRAY)is ARRAY

!output = ARRAY()
do !a from 1 to 4
  if defined(!input[!a]) then
    !output[!a] = !input[!a].string()
  else
    !output[!a] = '0'
  endif
enddo

return !output

endmethod
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method:      initialise
--
------------------------------------------------------------------------
define method .initialise()

   --Define Grid Options

	 !this.dbCtrl.bulkEditableGrid(FALSE)
	
   var !att[1] ' Support Type '
   var !att[2] ' Node Stiffness '
   var !att[3] ' Node Friction '
   var !att[4] ' Node Gap '

   !arr1 = object ARRAY()
   !arr2 = object ARRAY()
   !arr3 = object ARRAY()
   !arr4 = object ARRAY()

   do !arr from 1 to 4
       !type = !this.nodeTypeArray[!arr].real()
       !arr$!<arr>.append(!this.types[!type.real()])
       !arr$!<arr>.append(!this.nodeStiffnessArray[!arr])
       !arr$!<arr>.append(!this.nodeFrictionArray[!arr])
       !arr$!<arr>.append(!this.nodeGapArray[!arr])
   enddo

   !!arr5 = object ARRAY()
   !!arr5[1] = !arr1
   !!arr5[2] = !arr2
   !!arr5[3] = !arr3
   !!arr5[4] = !arr4

   !temp = 'Test'
   using namespace  'Aveva.Pdms.Presentation'
   !nds = object NETDATASOURCE(!temp, !att, !!arr5, 'test')
   !this.dbCtrl.bindToDataSource(!nds)
   !this.dbCtrl.editableGrid(TRUE)

   !this.dbCtrl.createValueList('temp', !this.types)
   !this.dbCtrl.assignValueListToColumn('temp', 1)

   !this.dbCtrl.fixedRows(FALSE)
   !this.dbCtrl.fixedheaders(FALSE)

endmethod
-- End of method definition
------------------------------------------------------------------------
--
-- Method:      .netBeforeCellUpdateCallback(!a is ARRAY)
--
-- this method is called when the user enters a value in a field
-- array 0 is the new value
-- array 1 is the row number (1 based)
-- array 2 is the column heading
-- array 3 is boolean to say if its valid
-- array 4 is a string -- '' in this case
------------------------------------------------------------------------
define method .netBeforeCellUpdateCallback(!a is ARRAY)

  if !a[0].eq('') then
    !!alert.error('Cells must contain a value')
    !this.cellError = TRUE
    -- if you set the passed array !a[3] to false the grid control
    -- resets to its previous value
    !a[3] = FALSE
    return
  endif
  if !a[2].neq(' Support Type ') then
    !test = !a[0].real()
    handle ANY
      !!alert.error('Cells must contain a numeric value')
      !this.cellError = TRUE
      !a[3] = FALSE
      return
    endhandle
  endif
  if !a[2].eq( ' Support Type ') then
    -- its a STRING type which needs to validate the number against the type list
    !this.setSupportType(!a)
  elseif !a[2].eq( ' Node Stiffness ') then
    !this.setStiffnessValue(!a)
  elseif   !a[2].eq(' Node Friction ' ) then
    !this.setFrictionValue(!a)
  else
  -- its ' Node Gap '
    !this.setGapValue(!a)
  endif

  !this.valueChanged = TRUE
  !this.cellError = FALSE
endmethod
-- End of method definition
------------------------------------------------------------------------

-----------------------------------------------------------------------
--
-- Method:      .setSupportType
--
-- method which selects the support type value from the types array
------------------------------------------------------------------------
define method .setSupportType(!list is ARRAY)

!test = !this.types.findFirst(!list[0])
handle ANY
  !test = 0
endhandle
!row = !list[1].real()
!this.nodeTypeArray[!row] = !test.string()

endmethod
-- End of method definition
------------------------------------------------------------------------

-----------------------------------------------------------------------
--
-- Method:      .setStiffnessValue
