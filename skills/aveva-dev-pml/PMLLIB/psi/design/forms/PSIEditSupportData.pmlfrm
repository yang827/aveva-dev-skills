--
--
-- Description:
-- Form Definition for Editing Pipe Stress support udas
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -
--  converttostring(ARRAY)           ARRAY
--  init()                           -
--  initialise()                     -
--  netBeforeCellUpdateCallback(ARRAY) -
--  psiEditSupportData()             -
--  saveToCE()                       -
--  setFrictionValue(ARRAY)          -
--  setGapValue(ARRAY)               -
--  setStiffnessValue(ARRAY)         -
--  setSupportType(ARRAY)            -
--  setupRestraints()                -
--  updateRestraintPicture()         -
--  writeexpression()                -
--
------------------------------------------------------------------------------------------------
-- Define Form
    import 'GridControl'
    handle any
    endhandle

    setup form  !!psiEditSupportData at xr0.6 yr0.07
    !!psiEditSupportData.formtitle    = ' PSI Support Node Data'
    !!psiEditSupportData.icontitle    = 'PSI'
    !!psiEditSupportData.initCall     = '!!psiEditSupportData.init()'
    !!psiEditSupportData.killingCall  = '!!psiEditSupportData.cancel()'
    !!psiEditSupportData.quitCall     = '!!psiEditSupportData.cancel()'
      -- Frame for Heading Data
      frame .fhdg | Support Node Data |

        button .ceButton          |Current Element|  at x1 ymax  tooltip |Current piping component| call |!this.init()|

        para   .currentElementName  at xmax ymin width 30 lines 1
        option .showsupports      |Draw Supports|   at xmin.ceButton ymax tooltip |Show restraint Representation| call |!this.updateRestraintPicture()|  width 13
        -- define PML Container to host the .net control
        container .netFrame PMLNetCONTROL 'NET' at x1 ymax.showsupports  width 50.5  hei 5.5

      exit

-- Bottom Line
      button .dismiss | Dismiss | at xmax form-size ymax+0.5  call |!this.cancel()|

      button .apply   | Save |    at x0             ymin  call |!this.writeexpression()|
      path right
      button .copy    |Copy To Current Element| call |!this.saveToCE()|

-- member .expressions is ARRAY
member .mode is STRING
member .ce is DBREF

member .nodeTypeArray      is ARRAY
member .nodeStiffnessArray is ARRAY
member .nodeGapArray       is ARRAY
member .nodeFrictionArray  is ARRAY
member .valueChanged       is BOOLEAN
member .tagID              is REAL
member .types              is ARRAY
member .display            is ARRAY
member .directions         is ARRAY
member .restraintgroup     is PSIRESTRAINTGROUP
member .cellError          is BOOLEAN

using namespace 'Aveva.Pdms.Presentation'
-- my .net control
member .dbCtrl is NETGRIDCONTROL


!a[1] = 'Current element'
!a[2] = 'Pipe'
!a[3] = 'Branch'
!a[4] = 'off'

!this.showsupports.dtext = !a

exit
-- End of form definition
------------------------------------------------------------------------------------------------

define method .psiEditSupportData()

   using namespace 'Aveva.Pdms.Presentation'

   -- create instance of .net control
   !this.dbCtrl = object NETGRIDCONTROL()

   -- add PML event handlers to .net control
   !this.dbCtrl.addeventhandler('BeforeCellUpdate', !this, 'NETBeforeCellUpdateCallback')
    -- add .net control to PML container
   !this.netFrame.control = !this.dbCtrl.handle()

   --Define Grid Options
	!this.dbCtrl.outlookGroupStyle(FALSE)
	!this.dbCtrl.columnExcelFilter(FALSE)
	!this.dbCtrl.columnSummaries(FALSE)
	!this.dbCtrl.setLabelVisibility(FALSE)
  -- pml setup
  !this.tagID = !!aidNumbers.add('Pipe Stress Restraints')

  !this.setupRestraints()
  !heading[1]  = | Number |
  !heading[2] =  | Type   |
  !heading[3] =  | Stiffness |
  !heading[4] =  | Friction  |
  !heading[5] =  | Gap |

  !this.valueChanged = FALSE
  !this.cellError = FALSE

endmethod
------------------------------------------------------------------------------------------------
--
-- Method: init
--
-- Description:
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------------------------------
-- Define method
define method .init()

   !this.currentElementName.val = ''
   !this.ce = !!ce
   !test = !!ce.:nodeType
   handle (2,204)
     return error 1 'Element does not contain Support attributes'
     -- it never gets to here but it stops the syntax checker from bleating
     !test = ARRAY()
   endhandle
   !this.currentElementName.val = !!ce.flnn

   !this.nodeTypeArray =  !this.converttostring(!!ce.:nodeType)
   do !a index !this.nodeTypeArray
     !this.nodeTypeArray[!a] = STRING(!this.nodeTypeArray[!a].real() + 1)
   enddo
    -- get the node attributes
   !this.nodeStiffnessArray  = !this.converttostring(!!ce.:NodeStiff )
   !this.nodeGapArray        = !this.converttostring(!!ce.:NodeGap)
   !this.nodeFrictionArray   = !this.converttostring(!!ce.:NodeFriction)

   -- init the grid control
   !this.initialise()

   !this.updateRestraintPicture()

   !this.valueChanged = FALSE

endmethod
------------------------------------------------------------------------------------------------
define method .saveToCE()

   if !this.cellError then
    !!alert.error('Unable to Save Changes as one or more values are invalid')
    return
  endif

   !test = !!ce.:nodeType
   handle (2,204)
     return error 1 'Element does not contain Support attributes'
     -- it never gets to here but it stops the syntax checker from bleating
     !test = ARRAY()
   endhandle

   !this.ce = !!ce

   !this.writeexpression()

endmethod

------------------------------------------------------------------------------------------------
-- method to set the attributes on the current element
define method .writeexpression()

  if !this.cellError then
    !!alert.error('Unable to Save Changes as one or more values are invalid')
    return
  endif

  !!ce = !this.ce
  :NodeType     unset
  :NodeStiff    unset
  :NodeGap      unset
  :NodeFriction unset

  !nodeTypeLine  = ':NodeType '
  !stiffnessLine = ':NodeStiff '
  !gapLine       = ':NodeGap '
  !frictionLine  = ':NodeFriction '
  do !a from 1 to 4
     skip if !this.nodeTypeArray[!a].real().eq(1)
     !number = !this.nodeTypeArray[!a].real() - 1
     !nodeTypeLine   = !nodeTypeLine & !number & ' '
     !stiffnessLine = !stiffnessLine & !this.nodeStiffnessArray[!a] & ' '
     !gapLine   = !gapLine  & !this.nodeGapArray[!a] & ' '
     !frictionLine  = !frictionLine & !this.nodeFrictionArray[!a] & ' '
  enddo

  -- issue the commands
  $!nodeTypeLine
  handle (47,62)
    $!nodeTypeLine unset
  endhandle
  $!stiffnessLine
    handle (47,62)
    $!stiffnessLine unset
  endhandle
  $!gapLine
    handle (47,62)
    $!gapLine unset
  endhandle
  $!frictionLine
    handle (47,62)
    $!frictionLine  unset
  endhandle

  !this.init()


endmethod
------------------------------------------------------------------------------------------------
-- method to manage the restraint group display
define method .updateRestraintPicture()

    -- first of all remove the existing graphics
    !this.restraintgroup.displayall(FALSE)
    if !this.showsupports.val.eq(4) then
      return
    elseif !this.showsupports.val.eq(2) then
     -- we are showing the supports for the whole pipe
      !this.restraintgroup = object PSIRESTRAINTGROUP(!this.ce.owner.owner)
      !this.restraintgroup.displayall(TRUE)
    elseif !this.showsupports.val.eq(3) then
     -- we are showing the supports for the whole pipe
      !this.restraintgroup = object PSIRESTRAINTGROUP(!this.ce.owner)
      !this.restraintgroup.displayall(TRUE)
    elseif !this.showsupports.val.eq(1) then
      -- we are only drawing the nodes for the current element
      !this.restraintgroup = object PSIRESTRAINTGROUP(!this.ce)
      !this.restraintgroup.displayall(!this.ce,true)
    endif

endmethod
------------------------------------------------------------------------------------------------


------------------------------------------------------------------------------------------------
-- method to set up the list of restraints by number
define method .setupRestraints()

   !types = ARRAY()
   !display = ARRAY()
   !direction = ARRAY()
   !types[1]  = 'ANC'     !display[1]  = 'box'       !direction[1]  =  'X'
   !types[2]  = 'X'       !display[2]  = 'arrow2'    !direction[2]  =  'X'
