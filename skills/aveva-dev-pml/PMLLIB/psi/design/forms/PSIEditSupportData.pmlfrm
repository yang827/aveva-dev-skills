   !types[60] = '-XSNB'   !display[60] = 'arrow2'    !direction[60] =  '-X'
   !types[61] = '-YSNB'   !display[61] = 'arrow2'    !direction[61] =  '-Y'
   !types[62] = '-ZSNB'   !display[62] = 'arrow2'    !direction[62] =  '-Z'

   !types.insert(1,|unset|)

   --!this.supportTypes.dtext = !types
   !this.types       = !types
   !this.display     = !display
   !this.directions  = !direction


endmethod
