-- method which selects the support stiffness to the stiffness array
------------------------------------------------------------------------
define method .setStiffnessValue(!list is ARRAY)

!test = !list[0].real()
handle ANY
  !test = 0
endhandle
!row = !list[1].real()
!this.nodeStiffnessArray[!row] = !test.string()

endmethod
-- End of method definition
------------------------------------------------------------------------

