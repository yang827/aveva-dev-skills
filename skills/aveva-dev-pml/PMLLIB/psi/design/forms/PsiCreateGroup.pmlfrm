-- Define Form
setup form !!psiCreateGroup

  !!psiCreateGroup.formtitle    = |New Stress Group Name|
  !!psiCreateGroup.icontitle    = ||
  !!psiCreateGroup.callback     = ||
  !!psiCreateGroup.formrevision = | $Revision: 1.0 $ |
  !!psiCreateGroup.initcall = |!this.init()|

-- Body of Form

  text .name call |!this.checkName(!this.name,'new')| width 40 is STRING
  path down

  button .ok ' OK ' call |!this.creategroup()|
  button .dismiss ' Dismiss ' at xmax form-size ymin cancel

  member .form is FORM

exit
-------------------------------------------------------------------------------------------
define method .creategroup()

  -- go to the default stress group zone
  !!ce = !this.form.defaultzone
    handle ANY
     !!alert.error('Unable to create stress group - Default zone not defined')
     return
    endhandle

  --  P-14022 fix to CP Syntax error message is displayed while clicking OK button on 'New Stress Group Name' form.
  if !this.name.val.unset() then
    !!alert.warning(|New Stress Group Name must be set!|)
    return
  endif

  new pipe $!this.name
  !group = object STRESSGROUP(!!ce)
  !dtext = !this.form.grouplist.dtext
  !rtext = !this.form.grouplist.rtext
  !dtext.append(!!ce.namn)
  !rtext.append(!!ce.string())
  !this.form.grouplist.dtext = !dtext
  !this.form.grouplist.rtext = !rtext
  !this.form.groups.append(!group)
  !this.form.grouplist.select('RTEXT',!!ce.string())
  aid clear text  all
  unenhance all
  -- P-18126
  !this.hide()
  !this.form.selected()

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .init()

  !this.name.val = 'unset'

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .checkName(!gadget is GADGET, !operation is STRING)

  if !this.name.val.occurs('/').gt(1) then
    !!alert.warning('Not a Valid Stress Group Name.')
    !this.name.clear()
    return
  endif

  !!nameGadget (!gadget,!operation)

endmethod
-------------------------------------------------------------------------------------------
