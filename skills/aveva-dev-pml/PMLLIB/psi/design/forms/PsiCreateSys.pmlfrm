-- Define form
setup form !!PsiCreateSys

-- Form Information

  !!PsiCreateSys.formTitle     = 'Create Pipe Stress System'
  !!PsiCreateSys.iconTitle     = 'PSI'
  !!PsiCreateSys.callback      = ''
  !!PsiCreateSys.formRevision  = ' $Revision: 1.0 $ '

  text .name |System Name   |  call |!this.namecheck()| width 50 STRING

  button .OK |   OK   | at x0 ymax call |!this.create()| OK
  button .Cancel | CANCEL | at xmax form-8 ymin CANCEL

exit

-- Init Method
define method .init()

  !this.name.val = 'unset'
  show !!PsiCreateSys

endmethod

define method .NameCheck()

endmethod

define method .Create()

  !!PsiMainView.SystemName.val = 'Stress System = ' + !this.name.val

endmethod

-- End of form definition for !!PsiCreateSys
