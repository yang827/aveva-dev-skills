--
-- Define Form
setup form !!psiDefaults

   import 'pmlFileBrowser'
   handle any
   endhandle


  --Initialization for form
  !this.initcall = '!this.init()'

  --Form title
  !this.formtitle   =  'Pipe Stress Interface Defaults'

  --Define and add Main menu
  menu .fileMenu

    !this.fileMenu.add('CALLBACK','Save',|!this.saveRestore(true)|)
    !this.fileMenu.add('CALLBACK','Save As...',|!this.saveFileAs()|)
    !this.fileMenu.add('CALLBACK','Load',|!this.saveRestore(false)|)
    !this.fileMenu.add('CALLBACK','Load From...',|!this.restoreFrom()|)
    !this.fileMenu.add('CALLBACK','Base Settings',|!this.resetDefaults(true)|)
    !this.fileMenu.add('CALLBACK','Exit',|!this.okCall('APPLY')|)
  bar
   !this.bar.add('Defaults File','fileMenu')

frame .pages tabset anchor all

    frame .page1 'Database Units' at 0 0 dock fill

         frame .units  'Current Stored Units For Building Stress Groups'

            path down

             paragraph  .pressText        text 'Pressure      '
             paragraph  .temperatureText  text 'Temperature   '
             paragraph  .weightText       text 'Weight        '
             paragraph  .forceText        text 'Force         '
             paragraph  .wallText         text 'Wall Thickness'
             paragraph  .fluidText        text 'Fluid Density '


             paragraph .pressTextValue          at xmax .pressText       ymin .pressText         width 15 lines 1
             paragraph .temperatureTextValue    at xmax .temperatureText ymin .temperatureText   width 15 lines 1
             paragraph .weightTextValue         at xmax .weightText      ymin .weightText        width 15 lines 1
             paragraph .forceTextValue          at xmax .forceText       ymin .forceText         width 15 lines 1
             paragraph .wallTextValue           at xmax .wallText        ymin .wallText          width 15 lines 1
             paragraph .fluidTextValue          at xmax .fluidText       ymin .fluidText         width 15 lines 1

       exit
       button .refreshUnits 'Refresh Current Units' at xmax+2 ymin tooltip |Reset PSI units to Current Session Units| call |!this.getUsedUnits()|
exit


    frame .page2 'Interface settings' at 0 0 dock fill

      text .zonepurp      |Stress Zone Purpose    | at x1.5 ymax tooltip |Stress Zone Purpose attribute| call |!this.modified = true| width 12 is STRING
      path down
      para .highcolp at x1.5 ymax   text   |Stress Group Colour     |
      button .highcolb      || at xmax ymin  tooltip |Graphics Colour of current Stress Group| call |!this.setColour('highcolb')| width 12
      para .retcolp  at x1.5 ymax   text   |Load Case Colour        |
      button .retcolb       || at xmax ymin  tooltip |Graphics Colour of the returning Load Case Branches|   call    |!this.setColour('retcolb')| width 12
      text .startnode     |Start Node Number      | at x1.5 ymax tooltip |The number to start numbering from| call |!this.modified = true| width 12 is REAL
      text .nodeIncrement |Node Increment         | at xmin ymax tooltip |The increment number between the nodes| call |!this.modified = true| width 12 is REAL
      option .stressReady   |Stress Ready Attribute | at xmin ymax tooltip |Turns the stress ready checking on and off| call |!this.modified = true| width 10
      !stressReady[1] = 'On'
      !stressReady[2] = 'Off'
      !this.stressReady.dtext = !stressReady
      text .maxDeflection |Max Allowable Movement | at xmin ymax tooltip |Max distance that a stressed pipe can move| call |!this.modified = true| width 12 is REAL

      option .flangeRigid |Separate Valves/Flanges| at xmin.maxDeflection ymax.maxDeflection tooltip |Treat connected flanges as separate rigids| call |!this.modified = true| width 10
      !rigid[1] = 'No'
      !rigid[2] = 'Yes'
      !this.flangeRigid.dtext = !rigid


      option .strGroup      |Branch Selection       | at xmin ymax tooltip |Allows branches to exist in one or multiple stress groups| call |!this.multiselect(true) | width 10
      !group[1] = 'Multiple '
      !group[2] = 'Single'


      !this.strGroup.dtext = !group

      option .scanGroup  |Stress Zone Search     | at xmin ymax tooltip |Search current or all stress zones| call |!this.modified = true| width 10
      !group[1] = 'Current'
      !group[2] = 'All    '

      !rtexGroup[1] = 'false'
      !rtexGroup[2] = 'true '

      !this.scanGroup.dtext = !group
      !this.scanGroup.rtext = !rtexGroup

    exit

      frame .page3 'Expressions' at 0 0 dock fill

        option .etype 'User Defined Properties' call |!this.expressionData('expList')| width 16

        !prop[1] = 'Weight'
        !prop[2] = 'Wall Thickness'
        !prop[3] = 'Material'
        !prop[4] = 'Fluid Density'
        !prop[5] = 'SIFs'
        !prop[6] = 'Corrosion Allowance'
        !prop[7] = 'Insulation Density'
        !prop[8] = 'Ignored Components'
        !prop[9] = 'Stress Ready'
        !prop[10] = 'Temperature1'
        !prop[11] = 'Temperature2'
        !prop[12] = 'Temperature3'
        !prop[13] = 'Temperature4'
        !prop[14] = 'Temperature5'
        !prop[15] = 'Temperature6'
        !prop[16] = 'Temperature7'
        !prop[17] = 'Temperature8'
        !prop[18] = 'Temperature9'
        !prop[19] = 'Pressure1'
        !prop[20] = 'Pressure2'
        !prop[21] = 'Pressure3'
        !prop[22] = 'Pressure4'
        !prop[23] = 'Pressure5'
        !prop[24] = 'Pressure6'
        !prop[25] = 'Pressure7'
        !prop[26] = 'Pressure8'
        !prop[27] = 'Pressure9'

        !this.etype.dtext = !prop

        list      .expList   anchor all columns width 65 lines 11
        !pixmap = !!pml.getPathname('uparrow16.png')

        hdist 0

        button .up at xmax ymin+1 anchor R+T pixmap "$!<pixmap>" call |!this.moveSelection('U','expList')|
        !pixmap = !!pml.getPathname('downarrow16.png')
        button .down at xmin ymax.expList-2  anchor R+B pixmap "$!<pixmap>" call |!this.moveSelection('D','expList')|
        button .addExp ' Add... '  at xmin .expList ymax .expList anchor L+B call |!this.editExpression(1,'expList')|
        path right
        hdist 12
        button .editexp ' Edit... ' anchor L+B call |!this.editExpression(2,'expList')|
        button .deleteExp ' Delete ' anchor L+B call |!this.editExpression(3,'expList')|

        path down
        hdist 0

    exit

      frame .page4 'Node Names' at 0 0  dock fill

        option .nameType 'Name Transfer Rules' call |!this.expressionData('nexpList')| tooltip |Define Rules for Node Naming| width 16

        !nprop[1] = 'Node Name Expressions'
        !this.nameType.dtext = !nprop

        list      .nexpList   anchor all columns width 65 lines 11
        !pixmap = !!pml.getPathname('uparrow16.png')

        hdist 0

        button .nup at xmax ymin+1 anchor R+T pixmap "$!<pixmap>" call |!this.moveSelection('U','nexpList')|
        !pixmap = !!pml.getPathname('downarrow16.png')
        button .ndown at xmin ymax.expList-2  anchor R+B pixmap "$!<pixmap>" call |!this.moveSelection('D','nexpList')|
        button .naddExp ' Add... '  at xmin .nexpList ymax .nexpList anchor L+B call |!this.editExpression(1,'nexpList')|
        path right
        hdist 12
        button .neditexp   ' Edit... ' anchor L+B call |!this.editExpression(2,'nexpList')|
        button .ndeleteExp ' Delete ' anchor L+B call |!this.editExpression(3,'nexpList')|

        path down
        hdist 0

      exit

    frame .page6 'Node Form Display Columns' at 0 0 dock fill

       path down
       vdist 0
       hdist 0

       toggle .number                  'Sequence        ' at x0.5 y0.5 call |!this.refreshNodeForm()|
       toggle .nodeNumber              'Node Number     ' call |!this.refreshNodeForm()|
       toggle .componentName           'component Name  ' call |!this.refreshNodeForm()|
       toggle .nodeName                'Node Name       ' call |!this.refreshNodeForm()|
       toggle .componentType           'Component Type  ' call |!this.refreshNodeForm()|
       toggle .component               'Component       ' call |!this.refreshNodeForm()|
       toggle .point                   'Point           ' call |!this.refreshNodeForm()|
       toggle .ppoint                  'PPoint           ' call |!this.refreshNodeForm()|
       toggle .bore                    'Bore            ' call |!this.refreshNodeForm()|
       toggle .od                      'O/D             ' at xmax .number ymin.number call |!this.refreshNodeForm()|
       toggle .wall                    'Wall Thickness  '  call |!this.refreshNodeForm()|
       toggle .cora                    'Corrosion Allowance ' call |!this.refreshNodeForm()|
       toggle .resttype                'Restraint Type  '   call  |!this.refreshNodeForm()|
       toggle .restfrict               'Restraint Friction  ' call |!this.refreshNodeForm()|
       toggle .bendradius              'Radius          '  call |!this.refreshNodeForm()|
       toggle .alphaAngle              'Alpha Angle     ' call |!this.refreshNodeForm()|
       toggle .sif                     'SIF             ' call |!this.refreshNodeForm()|
       toggle .lTubeLength             'Leave tube Length' call |!this.refreshNodeForm()|
       toggle .weight                  'Weight          ' at xmax .bendradius ymin.number call |!this.refreshNodeForm()|
       toggle .material                'Material        '   call |!this.refreshNodeForm()|
       toggle .rigidweight             'Rigid Weight    '  call |!this.refreshNodeForm()|
       toggle .rigid                   'Rigid           '  call |!this.refreshNodeForm()|
       toggle .reststiff               'Restraint Stiffness  ' call |!this.refreshNodeForm()|
       toggle .bendType                'Bend Type       ' call |!this.refreshNodeForm()|
       toggle .position                'Position        ' call |!this.refreshNodeForm()|
       toggle .connection              'Connection Ref  ' call |!this.refreshNodeForm()|
       toggle .typeOfConnection        'Connected Type  ' call |!this.refreshNodeForm()|
       toggle .errorFlag               'Error Flag      ' at xmax .position ymin.number call |!this.refreshNodeForm()|
       toggle .linkednode              'Linked Node     ' call |!this.refreshNodeForm()|
       toggle .insulationmat           'Insulation Mat  ' call |!this.refreshNodeForm()|
       toggle .insulationThickness     'Insulation Thickness' call  |!this.refreshNodeForm()|
       toggle .status                  'Status          ' call |!this.refreshNodeForm()|
       toggle .restgap                 'Restraint Gap   ' call |!this.refreshNodeForm()|
       toggle .pressure                'Pressure        ' call |!this.refreshNodeForm()|
       toggle .temperature             'Temperature     '  call |!this.refreshNodeForm()|

    exit

exit

  button .ok     |   OK   | at x0 ymax anchor L+B call |!this.okCall('OK')|
  para .defFile  at xmax+3 ymin width 60 lines 1
  button .cancel | Cancel | at xmax form-size ymin call |!this.okCall('CANCEL')|anchor R+B


  member .defaultsFile          is FILE
  member .modified              is BOOLEAN
  member .notSaved              is ARRAY
  member .gadgetData            is ARRAY
  member .weightArray           is ARRAY
  member .wallArray             is ARRAY
  member .corrosionArray        is ARRAY
  member .materialArray         is ARRAY
  member .stressOkArray         is ARRAY
  member .temperature1Array     is ARRAY
  member .temperature2Array     is ARRAY
  member .temperature3Array     is ARRAY
  member .temperature4Array     is ARRAY
  member .temperature5Array     is ARRAY
  member .temperature6Array     is ARRAY
  member .temperature7Array     is ARRAY
  member .temperature8Array     is ARRAY
  member .temperature9Array     is ARRAY
  member .pressure1Array        is ARRAY
  member .pressure2Array        is ARRAY
  member .pressure3Array        is ARRAY
  member .pressure4Array        is ARRAY
  member .pressure5Array        is ARRAY
  member .pressure6Array        is ARRAY
  member .pressure7Array        is ARRAY
  member .pressure8Array        is ARRAY
  member .pressure9Array        is ARRAY
  member .fluidArray            is ARRAY
  member .sifArray              is ARRAY
  member .insulArray            is ARRAY
  member .ignoredArray          is ARRAY
  member .componentNameArray    is ARRAY
-- stores the name of the current list
  member .currentList           is STRING
  member .colourgadget          is STRING
  member .mode             is REAL
  member .pressValue       is STRING
  member .temperatureValue is STRING
  member .weightValue      is STRING
  member .forceValue       is STRING
  member .wallValue        is STRING
  member .fluidValue       is STRING

exit
------------------------------------------------------------------------

-- this is the constructor method which reads the defaults xml file and builds
-- all the saved data
------------------------------------------------------------------------
define method .psiDefaults()

  pml load form !!psiEditExpression
  pml load form !!psiEditexList
  pml load form !!psiEditNameList

-- list the gadgets which do not need to change
-- the gadget values are saved but not restored from the xml file

   !this.notSaved.append('GADGETDATA')
   !this.notSaved.append('MATSOURCE')
   !this.notSaved.append('FLUIDSOURCE')
   !this.notSaved.append('GADGETDATA')
   !this.notSaved.append('ETYPE')
   !this.notSaved.append('WALLTEXT')
   !this.notSaved.append('FLUIDTEXT')
   !this.notSaved.append('FORCETEXT')
   !this.notSaved.append('PRESSTEXT')
   !this.notSaved.append('WEIGHTTEXT')
   !this.notSaved.append('TEMPERATURETEXT')
   !this.notSaved.append('TWALLTEXTVALUE')
   !this.notSaved.append('TFLUIDTEXTVALUE')
   !this.notSaved.append('TFORCETEXTVALUE')
   !this.notSaved.append('TPRESSTEXTVALUE')

   -- we need to examine a way of allowing multiple defaults files for PSI
   if !this.loadDefaultsFile().not() then
      !this.loadStandardDefaults()
   endif

    !this.defFile.val = 'Defaults File = ' & !this.defaultsFile.string()

    !this.saveRestore(FALSE)

    !this.page3.callback = '!this.frameEvent('
    !this.page4.callback = '!this.frameEvent('

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to look for a link url to get hold of a user defined defaults file
------------------------------------------------------------------------
define method .loadDefaultsFile()is BOOLEAN

-- the fileName is stored in the function of the stress zone
!test = !!psiSystem.defaultZone.function
handle ANY
 return FALSE
endhandle
if !test.set() then
   !file = object FILE(!test)
    handle ANY
       return FALSE
    endhandle
    !exists = !file.exists()
    handle ANY
      return FALSE
    endhandle
    if !exists then
      !this.defaultsFile = !file
      return TRUE
    endif
    return FALSE
else
    return FALSE
endif

endmethod
------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .reselectZone()

  hide !!psiDefaults
  show !!psiStressZone

endmethod
-------------------------------------------------------------------------------------------

------------------------------------------------------------------------
define method .loadStandardDefaults()

   var !code proj code
   --!fileName = '%' & !code & 'dflts%/Psi-defaults.xml'
   !fileName = |%pdmsuser%/Psi-defaults.xml|
   !this.defaultsFile = object FILE('$!fileName')

   if !this.defaultsFile.exists().not() then
     !!alert.error('Cannot Find Defaults file - $!fileName')
     !this.resetDefaults(false)
     !this.saveRestore(true)
     !this.savedefault()
     !!alert.message('Defaults file created $!this.defaultsFile')
   else
     !this.saveRestore(FALSE)
   endif

endmethod

------------------------------------------------------------------------
define method .frameEvent(!frame is GADGET, !dummyEvent is STRING)
  --method to trigger methods from selecting tabs

  if !frame.eq(!this.page3) then
    !this.mode = 1
    !this.expressionData('expList')
  elseif !frame.eq(!this.page4) then
    !this.mode = 3
   !this.expressionData('nexpList')
  endif

endmethod
------------------------------------------------------------------------
------------------------------------------------------------------------
-- method to swap the expression list between different types
define method .expressionData(!listName is STRING)

 if !listName eq 'expList' then
    !this.mode = 1
    if !this.etype.val eq 1 then
      !this.setExpList(!this.weightArray,'expList')
      !this.currentList = '!!psiDefaults.weightArray'
    elseif !this.etype.val eq 2 then
      !this.setExpList(!this.wallArray,'expList')
      !this.currentList = '!!psiDefaults.wallArray'
    elseif !this.etype.val eq 3 then
      !this.setExpList(!this.materialArray,'expList')
      !this.currentList = '!!psiDefaults.materialArray'
    elseif !this.etype.val eq 4 then
      !this.setExpList(!this.fluidArray,'expList')
      !this.currentList = '!!psiDefaults.fluidArray'
    elseif !this.etype.val eq 5 then
      !this.setExpList(!this.sifArray,'expList')
      !this.currentList = '!!psiDefaults.sifArray'
    elseif !this.etype.val eq 6 then
      !this.setExpList(!this.corrosionArray,'expList')
      !this.currentList = '!!psiDefaults.corrosionArray'
   elseif !this.etype.val eq 7 then
      !this.setExpList(!this.insulArray,'expList')
      !this.currentList = '!!psiDefaults.insulArray'
    elseif !this.etype.val eq 8 then
      !this.setExpList(!this.ignoredArray,'expList')
      !this.currentList = '!!psiDefaults.ignoredArray'
      !this.mode        =  2
   elseif !this.etype.val eq 9 then
      !this.setExpList(!this.stressOkArray,'expList')
      !this.currentList = '!!psiDefaults.stressOkArray'
      !this.mode        =  1
    elseif !this.etype.val eq 10 then
      !this.setExpList(!this.temperature1Array,'expList')
      !this.currentList = '!!psiDefaults.temperature1Array'
    elseif !this.etype.val eq 11 then
      !this.setExpList(!this.temperature2Array,'expList')
      !this.currentList = '!!psiDefaults.temperature2Array'
    elseif !this.etype.val eq 12 then
      !this.setExpList(!this.temperature3Array,'expList')
      !this.currentList = '!!psiDefaults.temperature3Array'
    elseif !this.etype.val eq 13 then
      !this.setExpList(!this.temperature4Array,'expList')
      !this.currentList = '!!psiDefaults.temperature4Array'
    elseif !this.etype.val eq 14 then
      !this.setExpList(!this.temperature5Array,'expList')
      !this.currentList = '!!psiDefaults.temperature5Array'
    elseif !this.etype.val eq 15 then
      !this.setExpList(!this.temperature6Array,'expList')
      !this.currentList = '!!psiDefaults.temperature6Array'
    elseif !this.etype.val eq 16 then
      !this.setExpList(!this.temperature7Array,'expList')
      !this.currentList = '!!psiDefaults.temperature7Array'
    elseif !this.etype.val eq 17 then
      !this.setExpList(!this.temperature8Array,'expList')
      !this.currentList = '!!psiDefaults.temperature8Array'
    elseif !this.etype.val eq 18 then
      !this.setExpList(!this.temperature9Array,'expList')
      !this.currentList = '!!psiDefaults.temperature9Array'
    elseif !this.etype.val eq 19 then
      !this.setExpList(!this.pressure1Array,'expList')
      !this.currentList = '!!psiDefaults.pressure1Array'
    elseif !this.etype.val eq 20 then
      !this.setExpList(!this.pressure2Array,'expList')
      !this.currentList = '!!psiDefaults.pressure2Array'
    elseif !this.etype.val eq 21 then
      !this.setExpList(!this.pressure3Array,'expList')
      !this.currentList = '!!psiDefaults.pressure3Array'
    elseif !this.etype.val eq 22 then
      !this.setExpList(!this.pressure4Array,'expList')
      !this.currentList = '!!psiDefaults.pressure4Array'
    elseif !this.etype.val eq 23 then
      !this.setExpList(!this.pressure5Array,'expList')
      !this.currentList = '!!psiDefaults.pressure5Array'
    elseif !this.etype.val eq 24 then
      !this.setExpList(!this.pressure6Array,'expList')
      !this.currentList = '!!psiDefaults.pressure6Array'
    elseif !this.etype.val eq 25 then
      !this.setExpList(!this.pressure7Array,'expList')
      !this.currentList = '!!psiDefaults.pressure7Array'
    elseif !this.etype.val eq 26 then
      !this.setExpList(!this.pressure8Array,'expList')
      !this.currentList = '!!psiDefaults.pressure8Array'
    elseif !this.etype.val eq 27 then
      !this.setExpList(!this.pressure9Array,'expList')
      !this.currentList = '!!psiDefaults.pressure9Array'
    endif
  else
      -- its name list
     !this.mode =  3
  -- its the name list is 'nexpList'
    !this.setExpList(!this.componentNameArray,'nexpList')
    !this.currentList = '!!psiDefaults.componentNameArray'
  endif

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to make expression objects and
define method .setExpList(!array is ARRAY,!list is STRING)

  !description = ARRAY()
  !expression  = ARRAY()
  !function    = ARRAY()
  !dataType    = ARRAY()
  !rtext       = ARRAY()
  !rows = ARRAY()

  if !array.size().eq(0) then
    !this.$!<list>.clear()
     !temp = object PSIEXPRESSION()
     if !list.eq('nexpList') then
        !temp.textstring = | / / / / |
     elseif !list.eq('expList') then
        !temp.textstring = | / / / |
     else
        !temp.textstring = | / / |
     endif
     !heading = !temp.heading()
     !this.$!<list>.setHeadings( !heading )
     return
  endif

  if !list.eq('nexpList') then
   -- its a four column name rule
    do !a values !array
      !object  = object PSIEXPRESSION(!a)
      !rtext.append(!a)
      !description     .append(!object.componentType   )
      !expression      .append(!object.componentRule   )
      !dataType        .append(!object.nameRule        )
      !function        .append(!object.componentPoint  )
    enddo
    if !description.size().neq(0) then
     !heading = !object.heading()
     !rows.append(!description)
     !rows.append(!expression )
     !rows.append(!function   )
     !rows.append(!dataType   )
    endif
  else
   do !a values !array
       !object  = object PSIEXPRESSION(!a)
       !rtext.append(!a)
       !description     .append(!object.description)
       !expression      .append(!object.expression )
       !dataType        .append(!object.dataType   )
   enddo
   !heading = !object.heading()
   !rows.append(!description)
   !rows.append(!expression )
   !rows.append(!dataType   )
 endif


--  !rows.append(!description)
--  !rows.append(!expression )
--  !rows.append(!unusedFunction   )


    !this.$!<list>.setHeadings( !heading )
    !this.$!<list>.setColumns( !rows )
    --Ew inserted
    !this.$!<list>.rtext = !rtext


endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .compose(!input is ARRAY,!heading is ARRAY)is ARRAY

   if !input.size().eq(0) then
        !text = ''
        do !a values !heading
        !text = !text & !a & ' '
        enddo
        !dtext[1] = !text
        return !dtext
   endif

   do !a index !heading
      !input[!a].insert(1,!heading[!a])
   enddo

   !dtext = ARRAY()
   !size = !input[1].width()
   do !a index !input[1]
    var !dtext[!a] compose |$!input[1][$!a]| width $!size
   enddo

   do !a from 2 to !input.size()
      !size = !input[!a].width()
      do !b index !input[!a]
       var !dtext[!b] compose |$!dtext[$!b]| space 1 |$!input[$!a][$!b]| width $!size
      enddo
   enddo
  return !dtext

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .moveSelection(!dir is STRING,!listName is STRING)

   --EW Inserted list Name will either be 'expList' or 'resList'
   --depending on where the method .moveSelection is called from
   !list = !listName

   !selection = !this.$!<list>.val
   !size = !this.$!<list>.dtext.size()
   !dtext = !this.$!<list>.dtext
   !rtext = !this.$!<list>.rtext

   if !size.eq(1).or(!size.eq(0)) then
       !!alert.error('Not Enough Members to Reorder')
       return
   endif
   if !dir.eq('U') then
     if !selection.eq(1) then
         !!alert.error('Item is Already First in the List')
         return
     else
        !tempD = !dtext.removefrom(!selection,1)
        !tempR = !rtext.removefrom(!selection,1)
        !dtext.insert(!selection - 1,!tempD[1])
        !rtext.insert(!selection - 1,!tempR[1])
     endif
   else
     if !selection.eq(!dtext.size()) then
         !!alert.error('Item is Already Last in the List')
         return
     else
         !tempD = !dtext.removefrom(!selection + 1,1)
         !tempR = !rtext.removefrom(!selection + 1,1)
         !dtext.insert(!selection,!tempD[1])
         !rtext.insert(!selection,!tempR[1])
     endif
   endif

  !this.$!<list>.dtext = !dtext
  !this.$!<list>.rtext = !rtext

  $!<this.currentList> = !this.$!<list>.rtext


endmethod
-------------------------------------------------------------------------------------------

------------------------------------------------------------------------
define method .editExpression(!mode is REAL,!listName is STRING)

   --EW Inserted list Name will either be 'expList' or 'resList'
   --depending on where the method .moveSelection is called from
   !list = !listName

   if !this.mode.eq(1) then
     !form = '!!psiEditExpression'
   elseif !this.mode.eq(2) then
     !form = '!!psiEditexList'
   elseif !this.mode.eq(3) then
     !form = '!!psiEditNameList'
   endif
   ---------------------------------------
   if !mode eq 1 then
   -- its adding a new expression to the current list
     $!<form>.currentExpression = object PSIEXPRESSION()
     $!<form>.mode = 'add'
     $!<form>.order = !this.$!<list>.val
     $!<form>.list = !listName
     show $!<form>
     !this.modified = TRUE

   ---------------------------------------
   elseif !mode eq 2 then

    if !this.$!<list>.dtext.size().gt(0) then
      $!<form>.currentExpression = object PSIEXPRESSION(!this.$!<list>.selection())
      $!<form>.mode = 'edit'
      $!<form>.order = !this.$!<list>.val
      $!<form>.list = !listName
      show $!<form>
      !this.modified = TRUE
    else
      !!alert.error('No Expressions to Edit')
    endif

---------------------------------------
   else
    -- its delete mode
     if !this.$!<list>.dtext.size().gt(0) then
       if !!alert.confirm('Are You Sure You Want to Delete This Expression?').eq('YES') then
         !dtext = !this.$!<list>.dtext
         !rtext = !this.$!<list>.rtext
         !dtext.deleteFrom(!this.$!<list>.val,1)
         !rtext.deleteFrom(!this.$!<list>.val,1)
         !this.$!<list>.dtext = !dtext
         !this.$!<list>.rtext = !rtext
         !this.modified = TRUE
         $!!<psiDefaults.currentList> = !rtext
         !!psiDefaults.expressionData(!listName)
       endif

     else
       !!alert.error('No Expressions to Edit')
     endif
   endif
---------------------------------------

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .init()

!this.modified = FALSE
!this.multiSelect(FALSE)
!this.getUsedUnits()

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to get gadget data for saving to file
-- loops
define method .getFormData()is ARRAY

  !return = ARRAY()


  !return.append(|<Form>|)
  !return.append(|<FormName>!!psiDefaults</FormName>|)

  !attributes = !this.attributes()

  -- Loop through attributes
  do !i indices !attributes

    !type = !this.attribute(!attributes[!i]).objecttype()

    -- don't bother to look at the gadget if its in the not saved list
    if !this.notSaved.findfirst(!attributes[!i]).set() then
       -- its in the ignored list
        --$p skipping $!attributes[$!i]
       skip
    endif

    if !type.eq('GADGET') then

       !object = '!!psiDefaults' & '.' & !attributes[!i]
       !gadgetType = $!<object>.type()
       handle (61,563)
       -- cannot get type
         skip
       endhandle

       !return.appendarray( !this.getGadgetData(!object,!gadgetType) )

    elseif !type.eq('ARRAY') then

       !return.appendarray( !this.getArrayData(!attributes[!i],!gadgetType) )

    endif

  enddo

  !return.append(|</Form>|)

  return !return

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .getArrayData(!object is STRING,!gadgetType is STRING)is ARRAY

 !return = ARRAY()


   !name = '!!psiDefaults' & '.' & !object


   !return.append(|<Array>|)
   !return.append(|<ArrayName>$!name</ArrayName>|)
   !return.append(|<ArrayVal>|)


   !arrayMem = !this.attribute('$!object')
   --q var !arrayMem

   do !a values !arrayMem
     !return.append(|<Value>$!a</Value>|)
   enddo

   !return.append(|</ArrayVal>|)
   !return.append(|</Array>|)

return !return


endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .getGadgetData(!object is STRING,!gadgetType is STRING)is ARRAY

 !return = ARRAY()

   !return.append(|<Gadget>|)
   !return.append(|<gadgetName>$!object</gadgetName>|)
   !return.append(|<GadgetType>$!gadgetType</GadgetType>|)
   !dataType =  $!<object>.attribute('DATATYPE')
   handle ANY
      !dataType = 'unset'
   endhandle
if !gadgetType inset(|BUTTON|) then
     !col = $!<object>.attribute('BACKGROUND')
     !return.append(|<BackGround>$!col</BackGround>|)
     !return.append(|</Gadget>|)
elseif !gadgetType inset(|TEXT|) then
   handle ANY
     !dataType = ''
   endhandle
   !return.append(|<DataType>$!dataType</DataType>|)
   !val = $!<object>.val.string()
   handle ANY
      !val = $!<object>.val.string()
   endhandle
   !return.append(|<Value>$!val</Value>|)
   !return.append(|</Gadget>|)
elseif !gadgetType inset(|TOGGLE|) then
   !return.append(|<DataType>$!dataType</DataType>|)
   !val = $!<object>.val.string()
   handle ANY
      !val = $!<object>.val.string()
   endhandle
   !return.append(|<Value>$!val</Value>|)
   !return.append(|</Gadget>|)
elseif !gadgetType inset(|RGROUP|) then
   !return.append(|<DataType>REAL</DataType>|)
   !val = $!<object>.val.string()
   handle ANY
      !val = $!<object>.val.string()
   endhandle
   !return.append(|<Value>$!val</Value>|)
   !return.append(|</Gadget>|)
elseif !gadgetType.eq(|LIST|) then
 --  if !this.ignoreGadget('$!object').not() then
         !dtext = $!<object>.dtext
         !rtext = $!<object>.rtext
         !return.append(|<Dtext>|)
         do !a values !dtext
            !return.append(|<Value>$!a</Value>|)
         enddo
         !return.append(|</Dtext>|)
         !return.append(|<Rtext>|)
         do !a values !rtext
            !return.append(|<Value>$!a</Value>|)
         enddo
         !return.append(|</Rtext>|)
         !return.append(|</Gadget>|)
         !selection.delete()
         handle (2,751)
         endhandle
   --endif
   !selection = $!<object>.val
   if !selection.objecttype().eq('REAL') then
      !return.append(|<Selection>$!selection</Selection>|)
   else
    -- its an array
      !return.append(|SelectionArray|)
      do !a values !selection
        !return.append(|<Value>$!a</Value>|)
      enddo
      !return.append(|/SelectionArray|)
   endif
elseif !gadgetType.eq(|TEXTPANE|) then
   !lines = $!<object>.val
   !return.append(|<Dtext>|)
   do !a values !lines
      !return.append(|<Value>$!a</Value>|)
   enddo
   !return.append(|</Dtext>|)
   !return.append(|</Gadget>|)
else
   --q var !object
   -- its a bar or something else
    !return.append(|</Gadget>|)
endif


return !return


endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to set gadget data
-- reads lines from the defaults file
------------------------------------------------------------------------
define method .restoreData()

  -- read file
  !this.gadgetData = !this.defaultsFile.readfile()
  !this.readDefaultLines()

endmethod

------------------------------------------------------------------------
-- method to set gadget data
-- reads lines from the defaults file
------------------------------------------------------------------------
define method .readDefaultLines()


  !i = 1
  -- Loop through attributes !i is varied according to the methods called so we rely on error trapping to break the loop
  do
     !line = !this.gadgetData[!i]
     handle ANY
       break
     endhandle
     if !line.match('<!').gt(0) then
        -- its a comment
        !i = !i + 1
        skip
     endif

     if !line.trim('LRM').lowcase().eq('<gadget>') then
         -- its the start of a gadget
        !i = !i + 1
        -- we have found a gadget the next line should be the name
        !gadgetName = !this.getText(!i)
        if !gadgetName.match('!!').eq(0).or(!gadgetName.match('.').eq(0)) then
           -- its a crap bit of code so skip
           skip
        endif
        !i = !i + 1
        -- after a gadget name we expect to find the gadget type
        !gadgetType = !this.getText(!i)
        if !gadgetType inset('TEXT','RGROUP') then
                --$P gadget is $!gadgetType
            !i = !i + 1
            !dataType = !this.getText(!i)
             !i = !i + 1
            !gadgetValue = !this.getText(!i)
            if !dataType.eq('STRING') then
                $!<gadgetName>.val = !gadgetValue
                handle (2,759)
                   skip
                elsehandle ANY
                   $!<gadgetName>.val = ''

                endhandle
            elseif !dataType.eq('REAL') then
                $!<gadgetName>.val = !gadgetValue.real()
                handle (2,759)
                   skip
                elsehandle ANY
                  $!<gadgetName>.val = 0

--  $P $!!error.text
--  $P $!<gadgetName>.val = $!gadgetValue

                endhandle
            else
                $!<gadgetName>.val = !gadgetValue.boolean()
                handle (2,759)
                   skip
                elsehandle ANY

--  $P toggle
--  $P $!!error.text
--  $P $!<gadgetName>.val = $!gadgetValue

                endhandle
            endif
        elseif !gadgetType inset('TOGGLE') then
            !i = !i + 1
            !dataType = !this.getText(!i)
            !i = !i + 1
            !gadgetValue = !this.getText(!i)
            $!<gadgetName>.val = !gadgetValue.boolean()
                handle (2,759)
                   skip
            elsehandle ANY

--  $P toggle
--  $P $!!error.text
--  $P $!<gadgetName>.val = $!gadgetValue

            endhandle
        elseif !gadgetType inset('LIST') then
             !dtext = !this.readDRtext(!i,'dtext')
             !i = !dtext.removelast()
            -- dont bother to look at the gadget if its in the not saved list
            !name = '$!<gadgetName>'
            if !this.notSaved.findfirst(!name).set() then
                  -- its in the ignoredlist
                  -- $p skipping $!attributes[$!i]
              skip
            endif
            $!<gadgetName>.dtext = !dtext
            handle (2,759)
                skip
            endhandle
            !rtext = !this.readDRtext(!i,'rtext')
            !i = !rtext.removelast()
            !selection = !this.readSelection(!i)
            !returnType = !selection.removelast()
            if !returnType.eq('STRING') then
                $!<gadgetName>.val = $!selection[1]
                handle (61,620)
                  skip
                endhandle
            else
               !i = !selection.removelast()
               $!<gadgetName>.val = !selection
            endif
        elseif !gadgetType inset('TEXTPANE')  then
            handle (2,759)
              skip
            endhandle
            !dtext = !this.readDRtext(!i,'dtext')
            !i = !dtext.removelast()
            $!<gadgetName>.val = !dtext
            handle (2,759)
              skip
            endhandle
        elseif !gadgetType inset('BUTTON')  then
            handle (2,759)
              skip
            endhandle
            !i = !i + 1
            !backGround = !this.getText(!i)
            $!<gadgetName>.backGround = !backGround.real()
            handle ANY
            endhandle
            skip
        endif
     elseif  !line.trim('LRM').lowcase().eq('<array>') then
       --its the start of an array
        !i = !i + 1
        !gadgetName = !this.getText(!i)
        skip if !gadgetName.lowcase().eq('!!psidefaults.notsaved')
        if !gadgetName.match('!!').eq(0).or(!gadgetName.match('.').eq(0)) then
           -- its a crap bit of code so skip
           skip
        endif
        --!i = !i + 1
        !array = !this.readDRtext(!i,'arrayval')
            !i = !array.removelast()
            $!<gadgetName>.val = !array
            handle (2,759)
                $!<gadgetName> = !array
                handle ANY
$(                $P $!!error.text
                  $P $!<gadgetName> = $!array
$)
                   skip
                endhandle
            endhandle
       -- !gadgetType = !this.getText(!i)
     endif
     !i = !i + 1
  enddo

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .readDRtext(!i is REAL,!textType is STRING) is ARRAY

   do
     !i = !i + 1
     if !this.gadgetData[!i].trim('LRM').lowcase().eq('<$!textType>') then
       -- its the start of a dtext
       !dtext = ARRAY()
       break
     endif
   enddo
   do
     !i = !i + 1
     if !this.gadgetData[!i].trim('LRM').lowcase().eq('</$!textType>') then
     -- its the end of a dtext
       break
     else
       !dtext.append(!this.getText(!i))
     endif
   enddo

   !dtext.append(!i)
   return !dtext

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .readSelection(!index is REAL)is ARRAY

!i = !index
   do
     !i = !i + 1
     if !this.gadgetData[!i].trim('LRM').lowcase().match('<selectionarray>').gt(0) then
       -- its the start of an array
       !dtext = ARRAY()
         do
           !i = !i + 1
           if !this.gadgetData[!i].trim('LRM').lowcase().eq('</selectionarray>') then
             -- its the end of a dtext
             break
           else
             !dtext.append(!this.getText(!i).real())
           endif
         enddo
     elseif  !this.gadgetData[!i].trim('LRM').lowcase().match('<selection>').gt(0) then
       -- its the start of an array
        !gadgetValue[1] = !this.getText(!i)
        !gadgetValue.append(!i)
        !gadgetValue.append('STRING')
        return !gadgetValue
     endif
     if defined(!dtext) then
         !dtext.append(!i)
         !dtext.append('ARRAY')
         return !dtext
     endif
   enddo

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- new save restore method based on saving a fileName in the database


 ------------------------------------------------------------------------
--
-- Method:      .saveRestoreAs(!action is BOOLEAN)()
--
-- Description: Save the displayed grid data to a user-selected MS Excel File
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/Rw] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .saveFileAs()

  Using Namespace 'Aveva.Pdms.Presentation'
  !browser   = object PMLFILEBROWSER('save')

  -- Default to first location from PDMSUSER evar
  !pdmsUser  = !!evarSplit('PDMSUSER')
  !directory = !pdmsUser[1]

  !seedFile  = 'psiDefaults'
  !title     = 'Save defaults As'

  !existFlag = False
  !filter = 'Xml Default files (*.xml)|*.xml'
  !filterIndex = 1

  -- Show Browser
  !browser.show(!directory, !seedFile, !title, !existFlag, !filter, !filterIndex)

  -- Set Selected File
  !saveFile = object FILE( !browser.file() )
  if ( !saveFile.set() ) then
    !this.defaultsFile = !saveFile
  else
    !!alert.error('Save File Not Defined')
      return
  endif

  -- now go and set the url
  !this.saveDefault()
  handle ANY
    return
  endhandle

  -- use the existing method to save the data
  !this.saveRestore(TRUE)

endmethod
-- End Of Method Definition For .saveFileAs()
------------------------------------------------------------------------
define method .restoreFrom()

  using Namespace 'Aveva.Pdms.Presentation'
  !browser   = object PMLFILEBROWSER('load')

  -- Default to first location from PDMSUSER evar
  !pdmsUser  = !!evarSplit('PDMSUSER')
  !directory = !pdmsUser[1]

  !seedFile  = 'psiDefaults'
  !title     = 'Restore Defaults From'

  !existFlag = False
  !filter = 'Xml Default files (*.xml)|*.xml'
  !filterIndex = 1

  -- Show Browser
  !browser.show(!directory, !seedFile, !title, !existFlag, !filter, !filterIndex)

  -- Set Selected File
  !saveFile = object FILE( !browser.file() )
  if ( !saveFile.set() ) then
    !this.defaultsFile = !saveFile
  else
    !!alert.error('Save File Not Defined')
      return
  endif

  -- now go and set the url
  !this.saveDefault()
  handle ANY
    return
  endhandle

  -- use the existing method to save the data
  !this.saveRestore(FALSE)

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- method to save the default file name at stresszone level
define method .saveDefault()

-- we need to create a linkwl below the stress site
-- save the current position
    !current = !!ce

    !!ce = !!psiSystem.defaultZone
    !!ce.function= !this.defaultsFile.string()
    !this.defFile.val = 'Defaults File = ' & !this.defaultsFile.string()

    !!ce= !current

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .saveRestore(!action is BOOLEAN)

   -- Standard save/restore method
   !this.gadgetData = !this.getFormData()
   if !action then
      -- save the data
      !this.defaultsFile.writefile('Write',!this.gadgetData)
      handle ANY
         !!alert.error('$!!error.text')
      endhandle
   else
      !this.restoreData()
      handle ANY
         !!alert.error('$!!error.text')
      endhandle
      !this.expressionData('expList')
      --!this.expressionData('resList')
      !this.expressionData('nexpList')
   endif

   !this.modified = FALSE


endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .ignoreGadget(!name is STRING)is BOOLEAN

  -- !gadgetName = !name.after('.').lowcase()

  do !a values !this.notSaved

    --$P a is $!A
    --$P name is $!name
    if !name.lowcase() eq(!a.lowcase())then
           --$P ignoring $!name
       return TRUE
    endif
  enddo

  return FALSE

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .okCall(!dummyButton is STRING)

  if !this.modified then
    !test = !!alert.question('Defaults have been Modified - Do You Want to Save?')
    if !test.eq('YES') then
      !this.saveRestore(TRUE)
    elseif !test.eq('CANCEL') then
       return
    else
      !this.saveRestore(FALSE)
    endif
  endif

  !this.hide()

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .multiSelect(!modified is BOOLEAN)

  !this.modified = !modified

  if !this.strGroup.selection().eq('Single') then
       !this.scanGroup.active  = TRUE
  else
       !this.scanGroup.active  = FALSE
  endif

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .refreshNodeForm()

  !this.modified = TRUE
  if !!psiShowNodes.shown() then
     !!psiShowNodes.init()
  endif

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .setColour(!gadget is STRING)

-- Check and Load the main Colour Select Form if it has not been loaded
  if (undefined(!!colourSelect)) then
    pml load form !!colourSelect
  endif

  !this.colourgadget = !gadget
  !currentColour = !!colourSelect.currentColour.backGround
  !!colourSelect.action = '!!psiDefaults.colourReturn(|$!currentColour|)'
  show !!colourSelect

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .colourReturn(!newColour is STRING)

!!psiDefaults.$!<this.colourgadget>.backGround = !!colourSelect.currentColour.backGround
if !newColour.real().eq(!!colourSelect.currentColour.backGround) then
   if !this.modified.not() then
        return
   else
       !this.modified = FALSE
   endif
else
       !this.modified = TRUE
endif

endmethod
------------------------------------------------------------------------
-- method to get the pdms12.1.1 stored units which are currently in Play
-- the user presses the button and a new set get displayed
-- problem is what to do about the current stress groups in memory
------------------------------------------------------------------------
define method .getUsedUnits()

  !unitsValue = object COMUNITS()

  !this.pressValue       = !unitsValue.getcurrentUnitsBypType('Pressure')
  !this.temperatureValue = !unitsValue.getcurrentUnitsBypType('Temperature')
  !this.weightValue      = !unitsValue.getcurrentUnitsBypType('Mass')
  !this.forceValue       = !unitsValue.getcurrentUnitsBypType('Force')
  !this.wallValue        = !unitsValue.getcurrentUnitsBypType('Length')
  !this.fluidValue       = !unitsValue.getcurrentUnitsBypType('Density')

  !this.pressTextValue.val       = !unitsValue.getcurrentUnitsBypType('Pressure')
  !this.temperatureTextValue.val = !unitsValue.getcurrentUnitsBypType('Temperature')
  !this.weightTextValue.val      = !unitsValue.getcurrentUnitsBypType('Mass')
  !this.forceTextValue.val       = !unitsValue.getcurrentUnitsBypType('Force')
  !this.wallTextValue.val        = !unitsValue.getcurrentUnitsBypType('Length')
  !this.fluidTextValue.val       = !unitsValue.getcurrentUnitsBypType('Density')

endmethod

