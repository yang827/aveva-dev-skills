!fileLines.append(|<BackGround>0</BackGround>|)
!fileLines.append(|</Gadget>|)
!fileLines.append(|<Gadget>|)
!fileLines.append(|<gadgetName>!!psiDefaults.NUP</gadgetName>|)
!fileLines.append(|<GadgetType>BUTTON</GadgetType>|)
!fileLines.append(|<BackGround>0</BackGround>|)
!fileLines.append(|</Gadget>|)
!fileLines.append(|<Gadget>|)
!fileLines.append(|<gadgetName>!!psiDefaults.SIF</gadgetName>|)
!fileLines.append(|<GadgetType>TOGGLE</GadgetType>|)
!fileLines.append(|<DataType>unset</DataType>|)
!fileLines.append(|<Value>TRUE</Value>|)
!fileLines.append(|</Gadget>|)
!fileLines.append(|<Gadget>|)
!fileLines.append(|<gadgetName>!!psiDefaults.BORE</gadgetName>|)
!fileLines.append(|<GadgetType>TOGGLE</GadgetType>|)
!fileLines.append(|<DataType>unset</DataType>|)
!fileLines.append(|<Value>TRUE</Value>|)
!fileLines.append(|</Gadget>|)
!fileLines.append(|<Gadget>|)
!fileLines.append(|<gadgetName>!!psiDefaults.CORA</gadgetName>|)
!fileLines.append(|<GadgetType>TOGGLE</GadgetType>|)
!fileLines.append(|<DataType>unset</DataType>|)
!fileLines.append(|<Value>TRUE</Value>|)
!fileLines.append(|</Gadget>|)
!fileLines.append(|<Gadget>|)
!fileLines.append(|<gadgetName>!!psiDefaults.DOWN</gadgetName>|)
!fileLines.append(|<GadgetType>BUTTON</GadgetType>|)
!fileLines.append(|<BackGround>0</BackGround>|)
!fileLines.append(|</Gadget>|)
