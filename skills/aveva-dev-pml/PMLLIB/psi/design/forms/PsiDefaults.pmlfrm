--- if all else fails the form should have an option to resume some sort of basic settings
-- this method is a last resort if the old defaults form is corrupt in some way
-- This is called from the base setting menu
define method .resetDefaults(!message is boolean)

if !message then
  if !!alert.confirm('This will reset the current defaults to the Sample Data Settings. - Do you Want To Continue?').eq('NO') then
     return
   endif
endif

!fileLines = array()
!fileLines.append(|<Form>|)
