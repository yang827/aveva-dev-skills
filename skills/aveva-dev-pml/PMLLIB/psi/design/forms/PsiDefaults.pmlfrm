  !this.gadgetData = !fileLines
  !this.readDefaultLines()

  !this.modified = TRUE

endmethod

----------------------------------------------------------------------------------
-- method .getText reads and returns the text between > < from the xml data
-- returns the text between the <> characters
define method .getText(!number is REAL) is STRING

  return !this.gadgetData[!number].after('>').before('<')

endmethod


--------------------------------------------------------------------------
--
-- Method:      fileBrowserLoad
--
-- Description: Load the PML fileBrowser to Save the location of the Report File
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--
-- Return:
--   [Data Type] [Description]
--
---------------------------------------------------------------------------
define method .fileBrowserLoad()

  using namespace 'Aveva.Pdms.Presentation'

  !browser = object PMLFILEBROWSER('SAVE')

  -- Show Browser

  var !userEvar '%PDMSUSER%'

  !browser.show(!userEvar, 'MyReport.txt', 'Clash Report', false, 'txt files (*.txt)|*.txt', 2)

  !fileName = !browser.file()

  !this.txtFile.val = !fileName
  handle ANY
  endhandle

endmethod
-- End of method definition for .fileBrowserLoad()
-- End of code
