-- Define form
setup form !!psiErrors size 10 16 resize

-- Form Information

  !!psiErrors.formTitle     = 'Pipe Stress System Errors'
  !!psiErrors.iconTitle     = 'PSI'
  !!psiErrors.callback      = ''
  !!psiErrors.formRevision  = ' $Revision: 1.0 $ '

-- <wd>14may2008 -- DUN923 -- AVEVA PSI12.0 conversion from VANTAGE PSI11.6
--    -- Check PDMS version from banner name
--  var !banner banner
--   if !banner.matchwild('*11.5*') then
--    !version = '11.5'
--   else
--    !version = '11.6'
--   endif
-- <wd>14may2008 -- DUN923 -- AVEVA PSI12.0 conversion from VANTAGE PSI11.6


-- <wd>14may2008 -- DUN923 -- AVEVA PSI12.0 conversion from VANTAGE PSI11.6 ---------------------------------------
--  -- PDMS Version 11.5 Form Definition --
--  ---------------------------------------
--
--    if !version.eq('11.5') then
--
--        frame .page1 'Data Consistency Errors'
--
--        textpane .dErrorList  width 50 lines 13
--        !this.dErrorList .setEditable(FALSE)
--
--        exit
--
--        frame .page2 'Node Errors' at xmin ymax
--
--        textpane .nErrorList  width 50 lines 13
--        !this.nErrorList .setEditable(FALSE)
--
--        exit
--
--     button .dismiss | Dismiss | at xmax form-size ymax  CANCEL
--
-- ---------------------------------------
-- -- PDMS Version 11.6 Form Definition --
-- ---------------------------------------
--    else

    frame .pages tabset  anchor all

       frame .page1 'Data Consistency Errors' dock fill

         textpane .dErrorList anchor all  width 50 lines 26
         !this.dErrorList .setEditable(FALSE)

       exit

       frame .page2 'Node Errors' at 0 0 dock fill

         textpane .nErrorList  anchor all width 50 lines 26
         !this.nErrorList .setEditable(FALSE)

       exit

    exit
    -- button .OK |   OK   | at x0 ymax anchor L+B call || OK
    button .dismiss | Dismiss | at xmax form-size ymax anchor R+B CANCEL

--  endif
-- <wd>14may2008 -- DUN923 -- AVEVA PSI12.0 conversion from VANTAGE PSI11.6

member .dataerrors is ARRAY
member .nodeerrors is ARRAY

exit



