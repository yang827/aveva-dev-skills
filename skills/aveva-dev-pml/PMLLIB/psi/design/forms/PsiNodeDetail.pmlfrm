-- Define form
 setup form !!psiNodeDetail

   init '!this.init()'

   path down
   vdist 0
   text  .number          'Sequence        '  width 24 is REAL
   text  .nodeNumber      'Node number     '  call '!this.modifyNodeNumber()' width 24 is REAL
   text  .nodeName        'Node Name       '  width 24 is STRING
   text  .componentType   'component Type  '  width 24 is STRING
   text  .component       'component       '  width 24 is STRING
   text  .nextType        'Next Type       '  width 24 is STRING
   text  .previousType    'Previous Type   '  width 24 is STRING
   text  .point           'Point           '  width 24 is STRING
   text  .bore            'Bore            '  width 24 is STRING
   text  .outsideDiameter 'O/D             '  width 24 is STRING
   text  .wallThickness   'Wall Thickness  '  width 24 is REAL
   text  .bendRadius      'Radius          '  width 24 is REAL
   text  .alphaAngle      'Alpha Angle     '  width 24 is REAL
   text  .sif             'SIF             '  width 24 is STRING
   text  .lTubeLength     'Leave Tube Len  '  width 24 is STRING
   text  .weight          'Weight          '  call '!this.modifyWeight()' width 24 is STRING
   text  .material        'Material        '  width 24 is STRING
   text  .rigidWeight     'Rigid Weight    '  width 24 is STRING
   text  .rigid           'Rigid           '  width 24 is STRING
   text  .position        'Position        '  width 24 is STRING
   text  .connection      'Connection      '  width 24 is STRING
   text  .connectionType  'Connection Type '  width 24 is STRING
   text  .typeOfConnection'typeOfConnection'  width 24 is STRING
   text  .errorFlag       'errorFlag       '  width 24 is STRING
   text  .linkedNode      'Linked Node     '  width 24 is STRING
   text  .insulationMat   'Insulation Mat  '  width 24 is STRING
   text  .insulationThickness   'Insulation Thk  '  width 24 is STRING

  path down

  button .apply 'Apply' call '!this.ok()' ok
  button .dismiss 'Dismiss' at xmax form -size ymin  cancel

  member .currentgroup is STRESSGROUP
  member .currentNode  is STRESSNODE
  member .modified is BOOLEAN


exit


---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
define method .init()

!this.modified = FALSE

  !this.number          .active = FALSE
  !this.nodeNumber      .active = FALSE
  !this.nodeName        .active = FALSE
  !this.component       .active = false
  !this.componentType   .active = false
  !this.connection      .active = false
  !this.connectionType  .active = false
  !this.linkedNode      .active = false
  !this.position        .active = false
  !this.wallThickness            .active = false
  !this.point           .active = false
  !this.outsideDiameter              .active = false
  !this.insulationMat   .active = false
  !this.insulationThickness   .active = false
  !this.material        .active = false
  !this.nextType        .active = false
  !this.previousType    .active = false
  !this.bore            .active = false
  !this.alphaAngle      .active = false
  !this.sif             .active = false
  !this.rigidWeight     .active = false
  !this.errorFlag       .active = false
  !this.typeOfConnection.active = false


  -- allow editing of the weight only if the weight is zero
  -- ew changed to allow editing if weight is unset
  if !this.currentNode.weight.eq(0).or(!this.currentNode.weight.unset()) then
      !this.weight      .active = TRUE
  else
      !this.weight      .active = FALSE
  endif

  !this.lTubeLength     .active = false
  !this.bendRadius      .active = false
  !this.rigid           .active = false

 !this.currentNode = !!psishownodes.currentNode
handle any
return
endhandle

  !this.number           .val = !this.currentNode.number
  !this.nodeNumber       .val = !this.currentNode.nodeNumber
  !this.nodeName         .val = !this.currentNode.nodeName
  !this.component        .val = !this.currentNode.component.string()
  !this.componentType    .val = !this.currentNode.componentType
  !this.nextType         .val = !this.currentNode.nextType
  !this.previousType     .val = !this.currentNode.previousType

  !this.connection       .val = !this.currentNode.connection.string()
  !this.connectionType   .val = !this.currentNode.typeOfConnection
  !this.linkedNode       .val = !this.currentNode.linkedNode.string()
  !this.typeOfConnection .val = !this.currentNode.typeOfConnection
  !this.position         .val = !this.currentNode.position.string(!!distancefmt).before('WRT')
  !this.wallThickness    .val = !this.currentNode.wallThickness
  !this.point            .val = !this.currentNode.point.string()
  !this.bore             .val = !this.currentNode.bore.string()
  !this.errorFlag        .val = !this.currentNode.errorFlag.string()
  !this.outsideDiameter               .val = !this.currentNode.outsideDiameter.string()
  !this.insulationMat    .val = !this.currentNode.insulationMat
  !this.insulationThickness    .val = !this.currentNode.insulationThickness.string()
  !this.material         .val = !this.currentNode.material.string()
  !this.weight           .val = !this.currentNode.weight.string()

  !this.lTubeLength      .val = !this.currentNode.lTubeLength.string()
  !this.bendRadius           .val = !this.currentNode.bendRadius
  !this.alphaAngle       .val = !this.currentNode.alphaAngle
  !this.sif              .val = !this.currentNode.sif.string()
  !this.rigid            .val = !this.currentNode.rigid.string()
  !this.rigidWeight      .val = !this.currentNode.rigidWeight.string()

endmethod
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
-- method to allow user weights to be added to a node
define method .modifyWeight()

!this.modified = FALSE
if !this.weight.val.neq( !this.currentNode.weight.string()) then
   --!component = !this.currentNode.component
   do !a index !this.currentgroup.nodelist
      if !this.currentgroup.nodelist[!a].component.eq(!this.currentNode.component) then
        !this.currentgroup.nodelist[!a].weight = !this.weight.val.real()
        !this.modifyErrors(!a)
      endif
   enddo
   !this.modified = TRUE
   !this.currentgroup.parsenodes()
endif

endmethod
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
-- method to remove weight errors
define method .modifyErrors(!node is REAL)


!temp = !this.currentgroup.nodelist[!node].errorlines
do !a index !temp
  if !temp[!a].match('Unable to Find Weight').gt(0) then
      !temp.removefrom(!a,1)
  endif
enddo

if !temp.size().eq(0) then
     !this.currentgroup.nodelist[!node].errorFlag = FALSE
endif

!this.currentgroup.nodelist[!node].errorlines = !temp

endmethod
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
-- method to allow user nodes to be renumbered
define method .modifyNodeNumber()

!this.modified = FALSE

   do !a index !this.currentgroup.nodelist
      if !this.currentgroup.nodelist[!a].number.eq(!this.currentNode.number) then
         !this.currentgroup.nodelist[!a].nodeNumber = !this.nodeNumber.val.real()
      endif
   enddo

   !this.modified = TRUE

endmethod
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
define method .ok()

if !this.modified then

  if !!alert.confirm(|Changes to Weights are Temporary and Will be Lost when you refresh - Do You want to Use the Temporary Weight?| ).eq('YES') then

     !!psisystem.currentgroup = !this.currentgroup
     !!psisystem.groups[!!psisystem.grouplist.val] = !this.currentgroup
     !!psishownodes.currentgroup = !this.currentgroup
     !!psishownodes.formtitle = 'Stress group $!this.currentgroup.stressgroupname Node Details'
     if !!psishownodes.shown() then
       !!psishownodes.init()
     else
        show !!psishownodes
     endif

  endif

endif

endmethod
---------------------------------------------------------------------------------------------------
