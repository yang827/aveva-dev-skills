---------------------------------------------------------------------------------------------------
define method .init()


-- <wd>14may2008 -- DUN923 -- AVEVA PSI12.0 conversion from VANTAGE PSI11.6
--   -- Check PDMS version from banner name
--    var !banner banner
--   if !banner.matchwild('*11.5*') then
--    !this.v115 = TRUE
--   else
--    !this.v115 = FALSE
--   endif
-- <wd>14may2008 -- DUN923 -- AVEVA PSI12.0 conversion from VANTAGE PSI11.6

  !number           = ARRAY()
  !nodeNumber       = ARRAY()
  !newNumber        = ARRAY()
  !nodePos = ARRAY()
  !this.backup      = !this.currentGroup

  do !a values !this.currentGroup.nodeList

    if !a.nodeNumber.set() then
      !nodeNumber      .append(!a.nodeNumber       .string())
      !number          .append(' ')
      !newNumber       .append(!a.nodeNumber       .string())
      !nodePos         .append(!a.number.string())
    endif

  enddo

  -- go and sort the node numbers eliminating duplicates
  !newRows = !this.sortrows(!nodeNumber,!nodePos)

  !rows     = ARRAY()
  !headings = ARRAY()
  !rtext    = ARRAY()

  !headings.append('Original Number')
  !rows.append(!newRows[1])
  !headings.append('New Number')
  !rows.append(!newRows[1])

   -- remember the heading because we need it again for 11.5 issues
   !this.headings = !headings

-- <wd>14may2008 -- DUN923 -- AVEVA PSI12.0 conversion from VANTAGE PSI11.6
--    --Ew inserted below
--  if !this.v115 then
--    !dtext = !this.compose(!rows, !this.headings)
--    !dtext.removeFirst()
--
--    $(
--    !rtext = ARRAY()
--    do !a index !dtext
--      !rtext.append(!dtext[!a].split()[1] & '/' & !dtext[!a].split()[2])
--    enddo
--    $)
--
--   !this.nodeList.dtext = !dtext
--  -- !this.nodeList.rtext = !rtext
--
--  else

    !this.nodeList.setHeadings( !this.headings )
    !this.nodeList.setColumns( !rows )
    --  !this.nodeList.rtext = !rtext

--  endif
-- <wd>14may2008 -- DUN923 -- AVEVA PSI12.0 conversion from VANTAGE PSI11.6


   --Ew commented out and replaced with above !this.nodeList.setHeadings( !headings )
   --Ew commented out and replaced with above !this.nodeList.setColumns( !rows )
  !this.nodeList.rtext = !newRows[2]
  !this.newVal.val = !this.nodeList.selection('dtext').split()[2].real()
  !this.modified = FALSE
  if !this.increment.val.unset() then
    !this.increment.val = 10
  endif

endmethod

-----------------------------------------------------------------------


------------------------------------------------------------------------
define method .compose(!input is ARRAY,!heading is ARRAY)is ARRAY


   if !input.size().eq(0) then
        !text = ''
        do !a values !heading
        !text = !text & !a & ' '
        enddo
        !dtext[1] = !text
        return !dtext
   endif

   do !a index !heading
      !input[!a].insert(1,!heading[!a])
   enddo

   !dtext = ARRAY()
   !size = !input[1].width()
   do !a index !input[1]
    var !dtext[!a] compose |$!input[1][$!a]| width $!size
   enddo

   do !a from 2 to !input.size()
      !size = !input[!a].width()
      do !b index !input[!a]
       var !dtext[!b] compose |$!dtext[$!b]| space 1 |$!input[$!a][$!b]| width $!size
      enddo
   enddo
   return !dtext

endmethod
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
define method .select(!number is REAL)

  !this.newVal.val = !this.nodeList.dtext[!number].split()[2].real()
  if !number.lt(!this.nodeList.dtext.size()) then
    !this.increment.val =  !this.nodeList.dtext[!number + 1].split()[2].real() - !this.nodeList.dtext[!number].split()[2].real()
  else
    !this.increment.val =  !this.nodeList.dtext[!number].split()[2].real() - !this.nodeList.dtext[!number - 1].split()[2].real()
  endif

endmethod
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
define method .sortrows(!nodeNumbers is ARRAY,!seq is ARRAY)is ARRAY

   !duplicates = ARRAY()

   do !a values !nodeNumbers
      !dupes = !nodeNumbers.find(!a)
      if !dupes.size().gt(1) then
         !duplicates.append(!dupes)
      endif
   enddo

   do !a values !duplicates
     do !b from 2 to !a.size()
        !nodeNumbers.deletefrom(!a[!b],1)
        !seq[!a[1]] = !seq[!a[1]] & ',' & !seq[!a[!b]]
        handle ANY
           skip
        endhandle
        !seq.deletefrom(!a[!b],1)
     enddo
   enddo

   !seq.compress()
   !nodeNumbers.compress()

   !ret[1] = !nodeNumbers
   !ret[2] = !seq

   return !ret

endmethod
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
define method .testoutput()is BOOLEAN

   !dtext = !this.nodeList.dtext
   !numbers = ARRAY()
   do !a index !dtext
      !numbers.append(!dtext[!a].split()[2].real())
   enddo
   !numbers.unique()
   if !numbers.size().lt(!dtext.size()) then
      !!alert.error('Duplicate Numbers Found - Update Aborted')
      return FALSE
   endif

   return TRUE

endmethod
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
-- method to save the changes and re initialise the groups
define method .apply()

   !save = !!ce
   if !this.testoutput().not() then
      return
   endif

   !dtext = !this.nodeList.dtext
   !rtext = !this.nodeList.rtext

   do !a index !dtext
      !newNumber = !dtext[!a].split()[2].real()
      !nodes = !rtext[!a].split(',')
     do !b values !nodes
        !this.currentGroup.nodeList[!b.real()].nodeNumber = !newNumber
      enddo
   enddo

   !this.backup = !this.currentGroup
   !!psishownodes.currentGroup = !this.currentGroup
   !!psishownodes.init()

   !!psisystem.currentGroup = !this.currentGroup
   !!psisystem.groups[!!psisystem.grouplist.val] =  !this.currentGroup

   if !this.currentGroup.savedata().not() then
      return
   endif

   !!psisystem.currentGroup.refreshnodetags()

   !!ce = !save
   handle ANY
     -- in case we were at the rest which may get replaced
   endhandle

   !this.init()

endmethod
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
-- this method renumbers the list based on the new input value
-- it depends on the .option rgroup which can be single or cascade (1 or 2)
define method .renumber(!newNumber is REAL)

-- in all cases the new number cannot be the same as the old number so test for this first
   !unusedCurrentValue = !this.nodeList.selection('dtext').split()[2].real()
   !unusedActualNodeNumbers = !this.nodeList.selection('rtext').split(',')

   -- if the new number is below the previous one, stop it
   !previousValue = !this.nodeList.dtext[!this.nodeList.val - 1].split()[2].real()
   handle NONE

      if !newNumber.leq(!previousValue) then
         !!alert.error('Node Number Below or Equal to Previous Number')
         return
      endif
   elsehandle ANY
      -- no previous nodes
   endhandle
   -- if the user is trying to update just one number but it needs to cascade
   !nextValue = !this.nodeList.dtext[!this.nodeList.val + 1].split()[2].real()
   handle NONE
      if !newNumber.geq(!nextValue).and(!this.option.val.eq(1)) then
         if !!alert.confirm('Node Number Greater or Equal to Next Number - Do you want to update all').eq('YES')then
            !this.option.val = 2
         endif
      endif
   elsehandle ANY
      -- last node
   endhandle

   !rtext = !this.nodeList.rtext

   !selected = !this.nodeList.val
   -- its a single renumber
   !val = !this.nodeList.selection('dtext').split()

-- <wd>14may2008 -- DUN923 -- AVEVA PSI12.0 conversion from VANTAGE PSI11.6
--   if !this.v115 then
--      !line[1][1] = !this.nodeList.selection('dtext').split()[1]
--      !line[2][1] = !newNumber
--      !text = !this.compose(!line, !this.headings)
--      !text.removeFirst()
--      !newVal = !text[1]
--   else
      !newVal = !val[1] & '	' & !newNumber
--   endif
-- <wd>14may2008 -- DUN923 -- AVEVA PSI12.0 conversion from VANTAGE PSI11.6

   !dtext = !this.nodeList.dtext
   !dtext[!this.nodeList.val] = !newVal
   !this.nodeList.dtext = !dtext

   if !this.option.val.eq( 2) then
      -- this bit cascades the remaining
      !dtext = !this.nodeList.dtext
      if !selected.eq( !dtext.size() - 1) then
        return
      endif
      !previousNumber = !newNumber

-- <wd>14may2008 -- DUN923 -- AVEVA PSI12.0 conversion from VANTAGE PSI11.6
--      if !this.v115 then
--         do !a from !selected + 1 to !dtext.size()
--            !val = !dtext[!a].split()
--            !previousNumber = !previousNumber + !this.increment.val
--            !line[1][1] = !val[1]
--            !line[2][1] = !previousNumber.string()
--            --!newVal = !val[1] & ' ' & !previousNumber
--            !text = !this.compose(!line, !this.headings)
--             !text.removeFirst()
--             !newVal = !text[1]
--             !dtext[!a] = !newVal
--         enddo
--      else
         do !a from !selected + 1 to !dtext.size()
            !val = !dtext[!a].split()
            !previousNumber = !previousNumber + !this.increment.val
            !newVal = !val[1] & '	' & !previousNumber
            !dtext[!a] = !newVal
         enddo
--      endif
-- <wd>14may2008 -- DUN923 -- AVEVA PSI12.0 conversion from VANTAGE PSI11.6

      !this.nodeList.dtext = !dtext
   endif

   !this.nodeList.rtext = !rtext

   !this.nodeList.val = !selected

endmethod
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
define method .reset()

  !this.currentGroup = !this.backup
  !this.init()

endmethod
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
define method .cancel()

   !this.hide()

endmethod
---------------------------------------------------------------------------------------------------
