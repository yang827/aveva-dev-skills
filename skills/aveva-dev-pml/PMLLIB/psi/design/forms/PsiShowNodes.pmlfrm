import 'GridControl'
handle any
endhandle

-- Define form
setup form !!psiShowNodes resi

  using namespace 'Aveva.Pdms.Presentation'

   init '!this.init()'


   --list .nodeList call |!this.reselect()| anchor all columns  width 100 lines 20
   container .nodeList nobox PmlNetControl 'Nodes' anchor all  at xmin ymax width 120 hei 16

   path down

   rgroup .displayFormat 'Display Format' call '!this.init()' anchor l+b frame horizontal
      add tag 'All Nodes'
      add tag 'Active Nodes'
   exit

   path right
   button .renNum 'Renumber Nodes...' at xmax+0.5 ymin+.5 call '!this.renumber()' anchor l+b
   button .nodeAtts 'Node Attributes...' call '!this.displayNodeDetail()' anchor l+b

   button .dismiss 'Dismiss' at xmax form -size ymin+.5 anchor r+b ok

   menu .gotoMenu
    !this.gotoMenu.add('CALLBACK','Selected Node',|!this.gotoNode()|)
    !this.gotoMenu.add('CALLBACK','Node Component','!this.goto()')

   menu .displayMenu
    !this.displayMenu.add('CALLBACK','Node Attributes',|!this.displayNodeDetail()|)
    !this.displayMenu.add('CALLBACK','Node Errors','!this.showErrors()')

   menu .numbersMenu
    !this.numbersMenu.add('CALLBACK','Show','!this.currentGroup.drawnodes()')
    !this.numbersMenu.add('CALLBACK','Hide','!this.currentGroup.undrawnodes()')

   menu .addrem
    !this.addrem.add('MENU','Goto','gotoMenu')
    !this.addrem.add('SEPARATOR')
    !this.addrem.add('MENU','Display','displayMenu')
    !this.addrem.add('SEPARATOR')
    !this.addrem.add('MENU','Node Numbers','numbersMenu')
    !this.addrem.add('CALLBACK','Renumber Nodes','!this.renumber()')
    !this.addrem.add('SEPARATOR')
    !this.addrem.add('CALLBACK', 'Export to Excel...', '!!exportToExcel(!this.nodeListGrid, ||, |Save As|)' )
  	!this.addrem.add('CALLBACK', 'Print Preview...', '!this.nodeListGrid.printpreview()' )

    !this.nodeList.popup = !this.addrem

    member .currentGroup is STRESSGROUP
    member .grouptype    is REAL
    member .nodeListGrid is NETGRIDCONTROL
    member .currentNode  is STRESSNODE

exit
---------------------------------------------------------------------------------------------------

define method .psiShowNodes()

  !this.grouptype = 1

  -- Define grid control namespace
  using namespace 'Aveva.Pdms.Presentation'

  --Create Grid Controls
  !this.nodeListGrid  = object NETGRIDCONTROL()

  --Make the associations to call the functions to pop-up the menus.
  !this.nodeListGrid.addeventhandler('OnPopup', !this, 'assocRightClick')

  --Define Grid Options
  !this.nodeListGrid.fixedHeaders(FALSE)
  !this.nodeListGrid.columnExcelFilter(TRUE)
  !this.nodeListGrid.outlookGroupStyle(FALSE)
  !this.nodeListGrid.fixedRows(FALSE)
  !this.nodeListGrid.setAlternateRowColor('WHITE')
  !this.nodeListGrid.headerSort(FALSE)
  !this.nodeListGrid.singleRowSelection(TRUE)

  --Add the grid controls to their containers.
  !this.nodeList.control  = !this.nodeListGrid.handle()

endmethod

---------------------------------------------------------------------------------------------------
define method .init()

-- set the alternative fixed display for return nodes
if !this.grouptype.eq(2) then
  !this.altDisplay()
  return
else

  if !this.currentGroup.complete.not() then
      -- panic fix to sort out errors in numbering
     !!psisystem.refreshgroup(FALSE)
     !this.currentGroup = !!psisystem.currentGroup
     --routine to get all the remaining data for the group
     --!this.currentGroup.getNodeData()
     !!psisystem.groups[!!psisystem.grouplist.val] = !this.currentGroup
  endif

endif
!this.nodeListGrid.clearGrid()
!this.nodeListGrid.clearGridData()

   !headings = ARRAY()

  -- !this.list.setHeadings( !headings )
   if !!psidefaults.number.val then
      !headings.append('Sequence')
   endif
   if !!psidefaults.nodeNumber.val then
      !headings.append('NodeNo')
   endif
   if !!psidefaults.nodeName.val then
      !headings.append('NodeName')
   endif
   if !!psidefaults.componentName.val then
      !headings.append('componentName')
   endif
   if !!psidefaults.componentType.val then
      !headings.append('Type')
   endif
   if !!psidefaults.component.val then
      !headings.append('RefNo')
   endif
   if !!psidefaults.point.val then
       !headings.append('Point')
   endif
   if !!psidefaults.ppoint.val then
       !headings.append('PPoint')
   endif
   if !!psidefaults.bore.val then
      !headings.append('Bore')
   endif
   if !!psidefaults.od.val then
      !headings.append('O/D')
   endif
   if !!psidefaults.wall.val then
      !headings.append('Wall Thickness')
   endif
   if !!psidefaults.cora.val then
      !headings.append('Corrosion Allowance')
   endif
   if !!psidefaults.bendradius.val then
     !headings.append('Radius')
   endif
   if !!psidefaults.alphaAngle.val then
     !headings.append('Alpha Angle')
   endif
   if !!psidefaults.sif.val then
      !headings.append('SIF')
   endif
   if !!psidefaults.lTubeLength.val then
     !headings.append('LTube Length')
   endif

   if !!psidefaults.weight.val then
     !headings.append('Weight')
   endif
   if !!psidefaults.material.val then
     !headings.append('Material')
   endif
   if !!psidefaults.rigidWeight.val then
     !headings.append('Rigid Weight')
   endif
   if !!psidefaults.rigid.val then
     !headings.append('Rigid')
   endif
   if !!psidefaults.position.val then

-- Determine the Co-Ordinates System in use,
--"ENU" (Normally used for AVEVA PLANT) or "XYZ" (Normally used for AVEVA MARINE)
--            !headings.append('East')
--            !headings.append('North')
--            !headings.append('Up')
      var !coord COORD
      if (!coord.upcase().eq('ENU')) then
        !headings.append('East')
        !headings.append('North')
        !headings.append('Up')
      elseif (!coord.upcase().eq('XYZ')) then
        !headings.append('X')
        !headings.append('Y')
        !headings.append('Z')
      endif

  endif
   if !!psidefaults.connection.val then
      !headings.append('Conn Ref')
   endif
   if !!psidefaults.typeOfConnection.val then
     !headings.append('Connected Type')
   endif
   if !!psidefaults.errorFlag.val then
      !headings.append('Error')
   endif
   if !!psidefaults.linkedNode.val then
      !headings.append('Linked Node')
   endif
   if !!psidefaults.insulationMat.val then
      !headings.append('Insu Material')
   endif
   if !!psidefaults.insulationthickness.val then
      !headings.append('Insu Thickness')
   endif
   if !!psidefaults.status.val then
      !headings.append('Status')
   endif
   if !!psidefaults.bendType.val then
      !headings.append('Bend Type')
   endif
   if !!psidefaults.pressure.val then
      !headings.append('Pressure')
   endif
   if !!psidefaults.temperature.val then
      !headings.append('Temperature')
   endif
 --CW
   if !!psidefaults.resttype.val then
      !headings.append('Restraint Type')
   endif
   if !!psidefaults.reststiff.val then
      !headings.append('Restraint Stiffness')
   endif
   if !!psidefaults.restfrict.val then
      !headings.append('Restraint Friction')
   endif
   if !!psidefaults.restgap.val then
      !headings.append('Restraint Gap')
   endif


   !rows = ARRAY()
   !row = ARRAY()

   do !a values !this.currentGroup.nodeList

      if !this.displayFormat.val.eq(2).and(!a.nodeNumber.unset()) or !this.displayFormat.val.eq(2).and(!a.nodeNumber.eq(-1)) then
        skip
      endif

      !row.clear()

      if !headings.findFirst('Sequence').set() then
        !row.append(!a.number           .string())
      endif
      if !headings.findFirst('NodeNo').set() then
        !row.append(!a.nodeNumber       .string())
      endif
      if !headings.findFirst('NodeName').set() then
        !row.append(!a.nodeName       )
      endif
      if !headings.findFirst('componentName').set() then
        !row.append(!a.componentName       .string())
      endif
      if !headings.findFirst('Type').set() then
        !row.append(!a.componentType    .string())
      endif
      if !headings.findFirst('RefNo').set() then
        !row.append(!a.component        .string())
      endif
      if !headings.findFirst('Point').set() then
        !row.append(!a.point            .string())
      endif
      if !headings.findFirst('PPoint').set() then
        !row.append(!a.ppoint           .string())
      endif
      if !headings.findFirst('Bore').set() then
        !row.append(!a.bore             .string())
      endif
      if !headings.findFirst('O/D').set() then
        !row.append(!a.outsideDiameter  .string())
      endif
      if !headings.findFirst('Wall Thickness').set() then
        !row.append(!a.wallthickness    .string('D3'))
      endif
      if !headings.findFirst('Corrosion Allowance').set() then
        !row.append(!a.corrosionallowance.string())
      endif
      if !headings.findFirst('Radius').set() then
        !row.append(!a.bendradius       .string('D3'))
      endif
      if !headings.findFirst('Alpha Angle').set() then
        !row.append(!a.alphaAngle       .string())
      endif
      if !headings.findFirst('SIF').set() then
        !row.append(!a.sif              .string())
      endif
      if !headings.findFirst('LTube Length').set() then
        !row.append(!a.lTubeLength      .string())
      endif
      if !headings.findFirst('Weight').set() then
        !row.append(!a.weight           .string('D3'))
      endif
      if !headings.findFirst('Material').set() then
        !row.append(!a.material         .string())
      endif
      if !headings.findFirst('Rigid Weight').set() then
        !row.append(!a.rigidWeight      .string('D3'))
      endif
      if !headings.findFirst('Rigid').set() then
        !row.append(!a.rigid            .string())
      endif
      if !headings.findFirst('East').set() or !headings.findFirst('X').set() then
        !row.append(!a.position.east    .string('D3'))
      endif
      if !headings.findFirst('North').set() or !headings.findFirst('Y').set() then
        !row.append(!a.position.north   .string('D3'))
      endif
      if !headings.findFirst('Up').set() or !headings.findFirst('Z').set() then
        !row.append(!a.position.up      .string('D3'))
      endif
      if !headings.findFirst('Conn Ref').set() then
        !row.append(!a.connection       .string())
      endif
      if !headings.findFirst('Connected Type').set() then
        !row.append(!a.typeOfConnection .string())
      endif
      if !headings.findFirst('Error').set() then
        !row.append(!a.errorFlag        .string())
      endif
      if !headings.findFirst('Linked Node').set() then
        !row.append(!a.linkedNode       .string())
      endif
      if !headings.findFirst('Insu Material').set() then
        !row.append(!a.insulationMat    .string())
      endif
      if !headings.findFirst('Insu Thickness').set() then
        !row.append(!a.insulationthickness.string())
      endif
      if !headings.findFirst('Status').set() then
        !row.append(!a.status                    )
      endif
      if !headings.findFirst('Bend Type').set() then
        !row.append(!a.bendType         .string())
      endif
      if !headings.findFirst('Pressure').set() then
        !row.append(!a.pressure         .string())
      endif
      if !headings.findFirst('Temperature').set() then
        !row.append(!a.temperature      .string())
      endif
      -- get the details from the
      if !a.restraintgroup.restraints.set() then
        !a.restraintgroup.getDisplaystring()
      endif

      if !headings.findFirst('Restraint Type').set() then
        !row.append(!a.restraintGroup.typestring )
      endif
      if !headings.findFirst('Restraint Stiffness').set() then
        !row.append(!a.restraintgroup.stiffnessstring  )
      endif
      if !headings.findFirst('Restraint Friction').set() then
        !row.append(!a.restraintGroup.frictionstring       )
      endif
      if !headings.findFirst('Restraint Gap').set() then
        !row.append(!a.restraintgroup.gapstring      )
      endif

      !rows.append(!row)

   enddo

  using namespace 'Aveva.Pdms.Presentation'

  -- Set toolTip and title
  !toolTip = 'List of Nodes'
  !title = 'Node List'

  --Create data source object
  !data = object NETDATASOURCE(!title, !headings, !rows)
  !data.toolTipText(!toolTip)

  -- Bind the data source to the control grid.
  !this.nodeListGrid.bindToDataSource(!data)

  !this.nodeListGrid.selectRow(1)

endmethod
---------------------------------------------------------------------------------------------------

define method .compose(!input is ARRAY,!heading is ARRAY)is ARRAY

   do !a index !heading
      !input[!a].insert(1,!heading[!a])
   enddo

   !dtext = ARRAY()
   !size = !input[1].width()
   do !a index !input[1]
    var !dtext[!a] compose |$!input[1][$!a]| width $!size
   enddo

   do !a from 2 to !input.size()
      !size = !input[!a].width()
      do !b index !input[!a]
       var !dtext[!b] compose |$!dtext[$!b]| space 1 |$!input[$!a][$!b]| width $!size
      enddo
   enddo
  return !dtext

endmethod


---------------------------------------------------------------------------------------------------
define method .altDisplay()
   !this.nodeListGrid.clearGrid()
   !this.nodeListGrid.clearGridData()

   !headings = ARRAY()
   !headings = ARRAY()
   if !!psidefaults.number.val then
      !headings.append('Sequence')
   endif
   !headings.append('NodeNo')
   !headings.append('Type')
   !headings.append('RefNo')
   !headings.append('Point')
   !headings.append('PPoint')
   !headings.append('Bore')
   !headings.append('O/D')

-- Determine the Co-Ordinates System is in use,
--"ENU" (Normally used for AVEVA PLANT) or "XYZ" (Normally used for AVEVA MARINE)
--            !headings.append('East')
--            !headings.append('North')
--            !headings.append('Up')
   var !coord COORD
   if (!coord.upcase().eq('ENU')) then
     !headings.append('East')
     !headings.append('North')
     !headings.append('Up')
   elseif (!coord.upcase().eq('XYZ')) then
     !headings.append('X')
     !headings.append('Y')
     !headings.append('Z')
   endif

   !headings.append('Deflection')
   !headings.append('Restraint Type')
   !headings.append('Restraint Stiffness')
   !headings.append('Restraint Gap')
   !headings.append('Restraint Friction')
   !headings.append('Status')

   !rows = object ARRAY()
   !row = object ARRAY()

   do !a values !this.currentGroup.nodeList

     if !this.displayFormat.val.eq(2).and(!a.nodeNumber.unset()) or !this.displayFormat.val.eq(2).and(!a.nodeNumber.eq(-1)) then
       skip
     endif

     !row.clear()

     if !headings.findFirst('Sequence').set() then
       !row.append(!a.number           .string())


     endif
     !row.append(!a.nodeNumber          .string())
     !row.append(!a.componentType       .string())
     !row.append(!a.component           .string())
     !row.append(!a.point               .string())
     !row.append(!a.ppoint              .string())
     !row.append(!a.bore                .string())
     !row.append(!a.outsideDiameter     .string())
     !row.append(!a.position.east       .string('D3'))
     !row.append(!a.position.north      .string('D3'))
     !row.append(!a.position.up         .string('D3'))
     if !a.deflection.string().eq('Unset') then
        !row.append('')
     else
        !row.append(!a.deflection          .string())
     endif

      -- get the details from the
      if !a.restraintgroup.restraints.set() then
        !a.restraintgroup.getDisplaystring()
      endif

      if !headings.findFirst('Restraint Type').set() then
        !row.append(!a.restraintGroup.typestring )
      endif
      if !headings.findFirst('Restraint Stiffness').set() then
        !row.append(!a.restraintgroup.stiffnessstring  )
      endif
      if !headings.findFirst('Restraint Gap').set() then
        !row.append(!a.restraintgroup.gapstring      )
      endif
      if !headings.findFirst('Restraint Friction').set() then
        !row.append(!a.restraintGroup.frictionstring       )
      endif

      !rows.append(!row)

   enddo

  using namespace 'Aveva.Pdms.Presentation'

  -- Set toolTip and title
  !toolTip = 'List of Nodes'
  !title = 'Node List'

  --Create data source object
  !data = object NETDATASOURCE(!title, !headings, !rows)
  !data.toolTipText(!toolTip)

  -- Bind the data source to the control grid.
  !this.nodeListGrid.bindToDataSource(!data)

  !this.nodeListGrid.selectRow(1)


endmethod
---------------------------------------------------------------------------------------------------


---------------------------------------------------------------------------------------------------
-- method to focus the graphics onto the currently selected node.
define method .gotoNode()

  !number = !this.nodeListGrid.getSelectedRowTags()
  !currentNode = !this.currentGroup.nodeList[!number[1].real()]
  !pos[1] = !currentNode.position.east
  !pos[2] = !currentNode.position.north
  !pos[3] = !currentNode.position.up
  --!pos.wrt(/* )
  !element =  !currentNode.component
  !!ce = !element
  var !units units
  if !units.match('INCH').gt(0) then
     pin 1 at $!currentNode.position
     mm dist
     var !pin1Pos pin 1 POSITION
     !posi = !pin1Pos.position().wrt(/* )
     !pos[1] = !posi.east
     !pos[2] = !posi.north
     !pos[3] = !posi.up
     $!units
     pin 1 off
  endif
  !!gph3ddesign1.view.through = !pos
  handle ANY
    do !a from 1 to 10
      !!<gph3ddesign>$!a$n.view.through = !pos  wrt /*
      handle ANY
        --$P $!!error.text
        skip
      elsehandle NONE
        break
      endhandle
    enddo
  endhandle


endmethod
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
define method .displayNodeDetail()
--CW
if !this.displayFormat.val.eq(1) then
!number = !this.nodeListGrid.getSelectedRowTags()
else
!number = !this.nodeListGrid.getSelectedrows()[1]
endif
  handle ANY
     return
  endhandle
  !currentNode = !this.currentGroup.nodeList[!number[1].real()]
    !this.currentNode = !currentNode

  handle any
     !!alert.error('Select a Node')
     return
  endhandle

  !!psinodedetail.currentGroup = !this.currentGroup
  !!psinodedetail.formtitle = 'Node Number $!number'
  if !!psinodedetail.shown() then
     !!psinodedetail.init()
  else
     show !!psinodedetail
  endif

endmethod
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
define method .reselect()


if !!psinodedetail.shown().not() then
   return
endif
	
!number = !this.nodeList.dtext[!this.nodeList.val].split()[1].real()
handle ANY
    return
endhandle


!currentNode = !this.currentGroup.nodeList[!number]
!!psinodedetail.currentNode = !currentNode
!!psinodedetail.currentGroup = !this.currentGroup
!!psinodedetail.formtitle = 'Node Number $!number'
!!psinodedetail.init()


endmethod
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
define method .showErrors()

!number = !this.nodeListGrid.getSelectedRowTags()
!currentNode = !this.currentGroup.nodeList[!number[1].real()]

!errors = !currentNode.errorlines

if !errors.size().eq(0) then
   !errors[1] = 'No Errors Found'
endif

!!psierrors.nerrorlist.val = !errors

show !!psierrors

endmethod
---------------------------------------------------------------------------------------------------

---------------------------------------------------------------------------------------------------
define method .goto()

  !number = !this.nodeListGrid.getSelectedRowTags()
  !currentNode = !this.currentGroup.nodeList[!number[1].real()]
  !!ce = !currentNode.component
  handle ANY
    !!alert.error('Cannot goto Current Node Component')
  endhandle

endmethod
---------------------------------------------------------------------------------------------------
---------------------------------------------------------------------------------------------------
-- method to renumber the nodes in the current STRESSGROUP
define method .renumber()

!!psiNodeNumbers.currentGroup = !this.currentGroup
!!psiNodeNumbers.selected = !this.nodeListGrid.getSelectedRowTags()[1].real()
handle any
endhandle

show !!psiNodeNumbers

endmethod
---------------------------------------------------------------------------------------------------
define method .assocRightClick(!data is ARRAY)

  !this.nodeList.showPopup(!data[0], !data[1])

endmethod
--End of method definition
