-- Define Form
Setup Form !!PsiStressGrouplist

  !this.initcall = '!this.init()'
  !this.formtitle    = |CE Group List|
  !this.icontitle    = ||
  !this.formrevision = | $Revision: 1.0 |


  -- Body of Form
  list .Groups width 28 length 8


    path down
    vdist 0.1

  -- Bottom Line
    button .Ok |   OK   | call |!this.setdefault()| ok
    button .Cancel | Cancel | at xmax form-size ymin call || cancel

-- End form definition

member .form is form
member .ce   is DBREF

exit

-------------------------------------------------------------------------------------------
define method .init()



endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .setdefault()

return
!!psisystem.defaultzone = !this.zone.selection().dbref()
!!psisystem.zone.val    = !this.zone.selection('dtext')

show !!psisystem

endmethod
-------------------------------------------------------------------------------------------




-- End of file PsiStressGrouplist.pmlfrm
