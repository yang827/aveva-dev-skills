--
-- File:      PsiStressZone.pmlfrm
--   Type:    Form Definition
--   Group:   PSI interface form
--   Keyword: PSI
--   Module:  Design
--
-- Author:    T.Martin
-- Created:   09/09/2005 09:23
--
--
-- Description:
-- Form Definition creating default site
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init()                           -
--  setDefault()                     -
--

-- Define Form
setup form !!psiStresszone

  !this.initcall     = '!this.init()'
  !this.formtitle    = |Default Creation Zone|
  !this.icontitle    = ||
  !this.formrevision = | $Revision: 1.0 |


  -- Body of Form
  list .zone width 28 length 8

    path down
    vdist 0.1

  -- Bottom Line
    button .ok |   OK   | call |!this.setDefault()| ok
    button .cancel | Cancel | at xmax form-size ymin call || cancel

-- End form definition

member .form is STRING


exit

-------------------------------------------------------------------------------------------
define method .init()

-- Load psiSystem form if not already loaded

    if undefined(!!psiSystem.groups) then
      pml load form !!psiSystem
    endif

  var !zones Coll all ZONE with purp eq 'PSI'
  if !zones.size().eq(0) then
    !!alert.error('No Pipe Stress Zones Found please Create a Zone and Set its purpose to $!!psiDefaults.zonepurp' )
    handle ANY
      !!alert.error('No Pipe Stress Zones Found please Create a Zone and Set its purpose to "PSI"' )
    endhandle
    !this.zone.clear()
    return
  else
    var !names eval namn for all from !zones
    !this.zone.dtext = !names
    !this.zone.rtext = !zones
  endif

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .setDefault()

!!psiSystem.defaultzone = !this.zone.selection().dbref()
!!psiSystem.zone.val    = !this.zone.selection('dtext')
-- we have just set the current stress zone and this is the first point where we can load
-- !!psiDefaults because we don't know the default file in use.

--if undefined(!!psiDefaults.filename)then
  -- reload !!psiDefaults every time because reselecting should validate the current default file
  pml load form !!psiDefaults
--endif

show $!this.form

endmethod
-------------------------------------------------------------------------------------------
