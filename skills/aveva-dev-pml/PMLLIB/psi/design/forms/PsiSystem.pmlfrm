-------------------------------------------------------------------------------------------
define method .deleteSelectedCase(!deleteAll is BOOLEAN)

 if (!deleteAll) then
    --Loop through and delete all load cases
    do !item values !this.loadcases.dtext
      !this.currentGroup.deleteSelCase(!item)
    enddo
 else
 -- Delete selected load case
   !this.currentGroup.deleteSelCase(!this.loadcases.selection())
 endif

  --Update load cases list
 !this.selected()

endmethod
