-------------------------------------------------------------------------------------------
-- method to read the return file back from file
-- this code is only run after an input file is found, so the bit for converting the file and
-- setting the filename is from the read button
define method .readSystem()

  !file = !this.inputFile

  -- go and read all the file lines build a set of stress nodes ans stress components
  !this.returnGroup = object STRESSGROUP(!file)
  handle 1
    return
  endhandle

  -- at this point we have a return object which contains a set of STRESS COMPONENT objects
  -- rather than do this in the object,

  -- now run the method for searching through the object and building pipe components
  -- !this.returnGroup.parseBranches()

  -- now go and try to tidy the branch and sort out the new items
  --!this.returnGroup.addNewItems()

  --!this.returnGroup.alignComponents()

  -- fill in the list of stress groups
  do !a index !this.groups
    if !this.groups[!a].pipe.eq(!this.returnGroup.pipe) then
        !this.groups[!a] = !this.returnGroup
        !this.currentGroup = !this.returnGroup
        !this.groupList.val = !a
       -- !this.selected()
        break
    endif
  enddo
  !this.currentGroup.caseGroups = ARRAY()

 -- ew added to update load case list when a stress file is read in
  !this.loadcases.dtext = !this.currentGroup.caseNames

  --- now go and display the results
  !this.selectCase(1)
  !this.selected()

  --!this.returnGroup.displayReturns()
  --!this.init()

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------

define method .clash(!type is REAL)

-- Type 1 will be load case
-- Type 2 will be main

  if !type.eq(1) then
-- Check if load case selected
    if !this.loadcases.val eq 0 then
      !!alert.error('No load case selected')
      return
    endif
-- Collect all the branches that belong to the load case
    do !loop values !this.currentGroup.caseGroups[!this.loadcases.val].branches
      !savePipe = !this.currentGroup.caseGroups[!this.loadcases.val].branches[1].owner
      desclash
        !!ce = !loop
        obst all
        OBSTRUCTION HULL DESIGN ON
        handle ANY
        -- for the plant version
        endhandle
        OBSTRUCTION HULL PRODUCTION ON
        handle ANY
        -- for the plant version
        endhandle
        report header off
        report summary off
        report main off
        report graphics off
        check ce
          handle (69,85)
            override on
          endhandle
        check ce
        var !clashes clash count clashes
        report header off
        report summary off
        report main off
        report graphics off
        !addList = ARRAY()
        do !clashLoop from 1 to $!clashes
          var !hitting clash $!clashLoop second
          if !hitting.match('(').gt(0) then
             !hitting = !hitting.before('(')
          endif
          !addList.append($!hitting)
        enddo
      exit
-- If the stress group pipe is the same do not add it and if its the original pipe
-- Create original pipe list
      !originalPipes = ARRAY()
      do !addOrig values !this.currentGroup.branches
        !originalPipes.append(!addOrig.owner)
      enddo
      !originalPipes.unique()
      do !add values !addList
        if !add.owner.type.eq('PIPE') then
          !addPipe = !add.owner
        elseif !add.owner.type.eq('BRAN') then
          !addPipe = !add.owner.owner
        else
          !addPipe = !!ce
        endif
        do !testForOrig values !originalPipes
          if !testForOrig.eq(!addPipe) then
            skip
          endif
          if !savePipe.eq(!addPipe) then
            skip
          endif
          add $!add
        enddo
      enddo
    enddo
  endif

endmethod
