setup form !!psiSystem

  import |pmlnetutilities|
  handle any
  endhandle

  init  |!this.init()|

  !this.formtitle  =  'Pipe Stress Interface'
  para .wzone text 'Stress Zone:  '
  para .zone at xmax ymin width 30 lines 1
  button .reselectZone linklabel  'Reselect Stress Zone' callback '!this.reselectZone()'
  para .cgroup at xmin.wzone ymax-0.2 text 'Current Group:'
  para .selectedgroup at xmax ymin width 30 lines 1

    path down
    vdist 0
    frame .tabset tabset at x0 ymax

      frame .stgroups 'Groups' at x1 y1

        list .groupList 'Existing Groups' at X1 ymax call |!this.selected() | anchor left anchor top single zerosel width 29 length 8
        list .groupMem 'Group members'   at xmax+4 ymin call '!this.setBranVis()' single zerosel  widt 28 length 8
        !pixmap = !!pml.getPathName('uparrow16.png')
        button .up at xmax ymin+2 pixmap "$!<pixmap>" width 16 height 16 call |!this.moveBran('U')|
        !pixmap = !!pml.getPathName('downarrow16.png')
        button .down at xmin ymax.groupMem-2 pixmap "$!<pixmap>" width 16 height 16 call |!this.moveBran('D')|
        button .create       'Create Stress Group...'  at x1 ymax.groupList+0.5 call '!!psiCreateGroup.form = !this
        show !!psiCreateGroup'
        button .addrembutton 'Add/Remove Members    ' at xmin.groupMem ymin call '!this.editGroup()'
        button .refresh      'Rebuild Selected Group' at x1 ymax call '!this.refreshGroup(true)'
        button .ce           'Find Groups...        ' at xmin.groupMem ymin Tooltip |Find what Groups CE belongs to| call |!this.findGroups()|

      exit

      frame .nodeedit 'Output/Input' at x1 y1

        frame .output 'Output' at x1 y.0
          button .editnodes       'Edit Nodes...       ' at x1 y0.5 call |!this.showGroup(1)|
          button .dataCheck       'Check Group...      ' at xmax ymin call '!this.dataCheck(true)'
          button .writefile       'Write Data to File  ' at xmax ymin call '!this.writeCurrent()'
        exit

        frame .inoutput 'Input' at x1 ymax
          button .editreturnnodes 'Edit Return Nodes...' at x1 y0.5 call |!this.showGroup(2)|
          button .convert         'Convert Stress Data ' at xmax ymin call '!this.readCurrent()'
          button .readfile        'Read Stress File    ' at xmax ymin call '!this.getFilename()'
          list .loadcases 'Load Case Models'             at x1 ymax.readfile call '!this.selectCase(!this.loadcases.val)' single width 63 hei 6
           !pixmap = !!pml.getPathName('autoclashoff16.png')
          button .clash1 tooltip 'Clash Check Load Case' pixmap "$!<pixmap>" at xmin ymax call '!this.clash(1)'
        exit
      exit

      frame .display 'Display' at x1 y1

      frame .graphics1 'Graphics'

          rgroup .toggle1 horizontal at x1 ymax+0.3
           add tag |Main Nodes| call '!this.selectCase(1)'
           add tag |Case Nodes| call '!this.selectCase(1)'
           -- add tag |Clear Nodes| call 'aid clear all'
          exit
          button .clearnodes |Clear Nodes| call 'aid clear all' at xmax ymin+.1
          toggle .branches    'Branches  ' at x2 ymin+1.5 call '!this.setBranVis()'
          toggle .graphics    'Graphics  ' at x15 ymin call '!this.saveRestore(!this.graphics.val)'
          toggle .connected   'Connected ' at x28 ymin call '!this.drawConnected()'

        exit

        vdist 0.3
        frame .ani 'Animation' at x1 ymax

          para .speedtext at x1 ymax text 'Speed'
          slider .slider at xmax ymin horiz range 1 10 step 1 val 5 width 50
          button .showseq     '  Show  ' at xmax ymin call '!this.sequence()'
        exit
        frame .misc 'Active Stress Group' at x1 ymax+0.3
          path right
          para .maingroup at x5 ymax text 'Main Group: '
          option .showpipe1 '' at xmax ymin call '!this.selectCase(!this.loadcases.val)' width 8
          !a[1] = 'Solid'   !b[1]  = '0'
          !a[2] = 'Off'     !b[2]  = '-1'
          !a[3] = '10%'     !b[3]  = '10'
          !a[4] = '20%'     !b[4]  = '20'
          !a[5] = '30%'     !b[5]  = '30'
          !a[6] = '40%'     !b[6]  = '40'
          !a[7] = '50%'     !b[7]  = '50'
          !a[8] = '60%'     !b[8]  = '60'
          !a[9] = '70%'     !b[9]  = '70'
          !a[10] = '80%'    !b[10] = '80'
          !this.showpipe1.dtext = !a
          !this.showpipe1.rtext = !b

          para .caseGroup at xmax+5 ymin text 'Load Case Group:'
          option .showpipe2 '' at xmax ymin call '!this.selectCase(!this.loadcases.val)' width 8
          !a[1] = 'Solid'   !b[1]  = '0'
          !a[2] = 'Off'     !b[2]  = '-1'
          !a[3] = '10%'     !b[3]  = '10'
          !a[4] = '20%'     !b[4]  = '20'
          !a[5] = '30%'     !b[5]  = '30'
          !a[6] = '40%'     !b[6]  = '40'
          !a[7] = '50%'     !b[7]  = '50'
          !a[8] = '60%'     !b[8]  = '60'
          !a[9] = '70%'     !b[9]  = '70'
          !a[10] = '80%'    !b[10] = '80'
          !this.showpipe2.dtext = !a
          !this.showpipe2.rtext = !b

          para .dummy at xmax+4.5 ymin text ' '
          path down
        exit
      exit

    exit
     vdist 0
  button .close ' Close ' at xmax form -size ymax  call '!this.close()'


-- Menu for group list

  menu .addrem
  !this.addrem.add('CALLBACK','Delete current Group','!this.delGroup()')
  !this.addrem.add('CALLBACK','Show Node Details','!this.showGroup(1)')
  !this.addrem.add('CALLBACK','Refresh Current Group','!this.refreshGroup(true)')
  !this.groupList.setpopup(!this.addrem)

  menu .delcase
  !this.delcase.add('CALLBACK','Delete selected load case','!this.deleteSelectedCase(false)')
  !this.delcase.add('CALLBACK','Delete all load cases','!this.deleteSelectedCase(true)')
  !this.loadcases.setpopup(!this.delcase)

-- Form Members

  member .groups       is ARRAY
  member .currentGroup is STRESSGROUP
  member .returnGroup  is STRESSGROUP
  member .defaultsfile is FILE
  member .zonepurp     is STRING
--  member .stressCol  is REAL
  member .defaultzone  is DBREF
  member .outputfile   is FILE
  member .inputFile    is FILE
  member .displaylist  is ARRAY
  member .lines        is ARRAY
  member .caseNames    is ARRAY
  member .cases        is ARRAY
  member .stressPipe   is DBREF
  member .originalbran is ARRAY
  member .newbran      is ARRAY
  member .newgroups    is ARRAY
  member .caselists    is ARRAY
  member .grouptype     is REAL
  member .coreloc      is FILE
  member .psiDir       is FILE

exit
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .psiSystem()

import 'pmlFileBrowser'
handle any
endhandle
!!psiSystem.quitcall = |!!psiSystem.close()|
!this.grouptype = 1


endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .init()

  var !zones Coll all ZONE with purp eq 'PSI'
  handle any
  elsehandle none
    if !zones.size().gt(1) then
      !this.reselectZone.visible = TRUE
    else
      !this.reselectZone.visible = FALSE
    endif
  endhandle
  -- test that we have all the bits in place to run PSI
  !this.getPSILocation()
  handle any
    return error 456 noalert
  endhandle

 !this.getpsiDirectories()
  handle any
    return error 456 noalert
  endhandle


  -- P26754 test to see if the bends exist
  /PSI-SPEC/VARI
  handle ANY
    !!alert.error('PSI zero length bends do not exist - you will be unable to load return Groups - Please contact your system Administrator')
  elsehandle NONE
    same
  endhandle

-- populate the list with the relevant stress pipes
  !this.getStressObjects()
  if !this.groupList.dtext.size().eq(0) then
     return
  endif
--  !this.nodeNumbers.val = TRUE
  !this.selected()
  !this.displaylist = ARRAY()

  --Reset to selected group name to null
  !this.selectedgroup.val = ''

  --Clear load cases list gadget when form is loaded
  !this.loadcases.clear()

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to delete the current stress group
define method .delGroup()

  !stressGroup = !this.groupList.rtext[$!this.groupList.val].dbref()
  !name = !stressGroup.name
  if !!alert.confirm('OK to Delete Stress Group $!name').eq('YES') then
    !!ce = !stressGroup
    delete pipe
    !this.init()
    --EW remove centre line and node numbering from view
    !this.currentGroup.undrawnodes()
  endif

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .moveBran(!dir is STRING)

 --EW Only do if there is a value highlighted in the group members list
   if !this.groupMem.val.lt(1) then
     return
   endif

!branches = !this.currentGroup.branches

!selection = !this.groupMem.val
!size = !this.groupMem.dtext.size()

if !size.eq(1).or(!size.eq(0)) then
    !!alert.error('Not Enough Members to Reorder')
    return
endif
if !dir.eq('U') then
  if !selection.eq(1) then
      !!alert.error('Branch is Already First in the List')
  else
     !temp = !branches[!selection - 1]
     !branches[!selection - 1]  = !branches[!selection]
     !branches[!selection] = !temp
  endif
else
  if !selection.eq(!branches.size()) then
      !!alert.error('Branch is Already Last in the List')
  else
     !temp = !branches[!selection + 1]
     !branches[!selection + 1]  = !branches[!selection]
     !branches[!selection] = !temp
  endif
endif

  !this.currentGroup.branches = !branches
  !this.currentGroup.savegroup()
  !this.groups[$!this.groupList.val] = !this.currentGroup
  !this.refreshGroup(TRUE)
  !this.selected()

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to highlight the picked group when picked on the select list
define method .selected()

 --Only do if there is a value highlighted in the group list
   if !this.groupList.val.lt(1) then
     return
   endif

  --Remove the selected group from the graphical view
  !this.removeStressedPipe(!this.currentGroup)

  -- we have selected a different group so we need to remove the highlights from the previous one
  !this.currentGroup.highlightgroup(FALSE)
    handle ANY
    endhandle
  !this.currentGroup.undrawnodes()

  if !this.groups[!this.groupList.val].stage.eq(1) then
    !this.groups[!this.groupList.val].stage2()
    !this.currentGroup = !this.groups[!this.groupList.val]
  endif

  if !this.currentGroup.branches.size().eq(0) then
    return
  endif

  !this.currentGroup.promptstart()

  -- go to the stress pipe
  !!ce = !this.groupList.selection().dbref()
  handle ANY
      !!alert.error('Group has been renamed or Deleted')
      return
  endhandle

  !this.selectedgroup.val = !this.groupList.selection('dtext')
  handle ANY
  endhandle

  !this.currentGroup = !this.groups[!this.groupList.val]

  -- go and read the existing load cases so that we have separate stress groups
  !this.currentGroup.readexisting()
  !this.currentGroup.highlightgroup(TRUE)
  !this.currentGroup.drawnodes()

-- set the group members list
  !this.updateGroupMem(!this.currentGroup)
  !this.setBranVis()

  --!this.addCases(!this.currentGroup)
  !this.loadcases.dtext = !this.currentGroup.caseNames

  !this.selectCase(!this.loadcases.val)

  !this.currentGroup.promptend()

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to deal with adding a set of branches for a load case
define method .selectCase(!number is REAL)


  if !this.loadcases.val eq 0 then
    !this.toggle1.val = 1
  endif

  if !number.eq(0) then
    !this.toggle1.val = 1
  endif

  -- remove any other case branches
  !!ce = !this.currentGroup.pipe
  handle any
    return
  endhandle
  rem ce

   if (!this.toggle1.val eq 1) then
     !source = !this.currentGroup
     !target = !this.currentGroup.caseGroups[!number]
       handle ANY
         !target = object STRESSGROUP()
       endhandle
  elseif (!this.toggle1.val eq 2) then
     !source = !this.currentGroup.caseGroups[!number]
       handle ANY
         !source = object STRESSGROUP()
       endhandle
     !target = !this.currentGroup
  endif

  -- now draw the source and target groups where
  -- source is drawn in the normal highlight colour
  -- target is drawn with the obscure value and the other colour

  !source.highlightgroup(FALSE)
     handle ANY
     endhandle
  !source.highlightgroup(TRUE)
     handle ANY
     endhandle


   if (!this.toggle1.val eq 1) then
    !source.drawgroup(!!psidefaults.highcolb.background,!this.showpipe1.selection().real())
    !target.drawgroup(!!psidefaults.retcolb.background,!this.showpipe2.selection().real())
       handle ANY
       endhandle
  elseif (!this.toggle1.val eq 2) then
    !target.drawgroup(!!psidefaults.highcolb.background,!this.showpipe1.selection().real())
    !source.drawgroup(!!psidefaults.retcolb.background,!this.showpipe2.selection().real())
       handle ANY
       endhandle
  endif

  aid clear text all
  !source.drawnodes()
     handle ANY
     endhandle

  if !!psishownodes.shown() then
     !!psishownodes.currentGroup = !this.groups[!this.groupList.val]
     !!psishownodes.formtitle = 'Stress group $!this.currentGroup.pipe.name Node Details'
     !!psishownodes.init()
  endif

endmethod

-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to update the list of group members in the newly selected group
define method .updateGroupMem(!group is STRESSGROUP)

  !dtext = ARRAY()
  !rtext = ARRAY()

  !branches = !group.branches

  if !branches.unset() then
    !this.groupMem.clear()
    aid clear text all
    unmark all
    !dtext[1] = 'No Members'
    !this.groupMem.dtext = !dtext
    return
  endif

  do !a values !branches
    !dtext.append(!a.flnn)
    !rtext.append(!a.string())
  enddo

   !this.groupMem.dtext = !dtext
   !this.groupMem.rtext = !rtext


endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to re initialise the selected stress group
define method .refreshGroup(!showMessage is BOOLEAN)

   --Only do if there is a value highlighted in the group list
   if !this.groupList.val.lt(1) then
     !!alert.error('Please select an existing group or create a new one')
     return
   endif


   -- display prompt
   !this.currentGroup.promptstart()
   if !this.currentGroup.pipe.set() then
      !main = !this.currentGroup.getRest('main')
      if !main.set() then
        !reset = TRUE
        if !main.purpose.eq('REN') then
          if !showMessage.not() then
             !reset = FALSE
          else
             if !!alert.confirm('Do You want to Keep Existing Node numbers?').eq('YES') then
               !reset = FALSE
             else
               !reset = TRUE
             endif
          endif
        endif
        if !reset then
           !!ce = !main
            delete rest
        endif
      endif
    endif

   -- go to stress pipe
   !!ce = !this.groupList.selection().dbref()
   -- make a new stress group object
   !this.groups[!this.groupList.val] = object STRESSGROUP(!!ce)
   -- put the current group back into the form
   !this.currentGroup = !this.groups[!this.groupList.val]

   -- highlight the group on the screen
   !this.currentGroup.highlightgroup(TRUE)

   !!ce = !this.currentGroup.pipe

   !purp = 'STD'
   !main = !this.currentGroup.getRest('main')
   if !main.set() then
      !this.currentGroup.resetnumbers(!main)
      !purp = 'REN'
   endif

   -- !this.currentGroup.saveData()
   !this.currentGroup.writerestdata('main',!purp)
   -- sort out the node tags
   !this.currentGroup.refreshnodetags()

   -- test
   !this.groups[!this.groupList.val] = !this.currentGroup

   if !!psishownodes.shown() then
      !this.showGroup(!this.grouptype)
   endif

    !this.currentGroup.promptend()

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .showGroup(!type is REAL)

   --Only do if there is a value highlighted in the group list
   if !this.groupList.val.lt(1) then
     !!alert.error('Please select an existing group or create a new one')
     return
   endif

   !this.grouptype = !type
   !!psishownodes.grouptype = !type

   if !type eq(1) then
       !!psishownodes.rennum.active =  TRUE
       !!psishownodes.currentGroup = !this.groups[!this.groupList.val]
       !!psishownodes.formtitle = 'Stress group $!this.currentGroup.pipe.name Node Details for: Main stress group'
   elseif !this.loadcases.dtext.size().gt(0) then
       -- save the current setting in case we refresh the whole thing
      !val = !this.loadcases.val
      -- update the current group if its not been updated
      if !this.currentGroup.complete.not() then
        !this.currentGroup.getNodeData()
        !this.groups[!this.groupList.val] = !this.currentGroup
      endif
      !this.loadcases.val = !val
      if !this.groups[!this.groupList.val].caseGroups.size().eq(0) then
         !!alert.error('No Nodes to Edit')
         !this.grouptype = !type
         !!psishownodes.grouptype = !type
         return
      endif
      !!psishownodes.rennum.active   = FALSE
      !!psishownodes.currentGroup = !this.groups[!this.groupList.val].caseGroups[!this.loadcases.val]
      !!psishownodes.formtitle = 'Stress group $!this.currentGroup.pipe.name Node Details for Load Case:'& !this.loadcases.selection('DTEXT')
      handle ANY
      endhandle
   endif

   if !!psishownodes.shown() then
     !!psishownodes.init()
   else
      show !!psishownodes
   endif

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .getFilename()

   using namespace 'Aveva.Pdms.Presentation'

    --Only do if there is a value highlighted in the group list
   if !this.groupList.val.lt(1) then
     !!alert.error('Please select an existing group or create a new one')
     return
   endif

  -- Initialise variables
  !fileBrowser = object PMLFILEBROWSER('OPEN')
  var !projCode proj code
  var !psiDir evar '$!projCode$npsi'
  !path = !psiDir & '\return'

  !stressPipe = !this.groups[!this.groupList.val].stressgroupname.after('/')

  var !projCode proj code

  !fileBrowser.show(!path, !stressPipe & 'Ret.xml', 'Stress Report Output', TRUE, 'dat files (*.xml)|*.xml', 1)

  if (!fileBrowser.file().empty()) then
      return
  endif

   !this.inputFile = object FILE( !fileBrowser.file() )

   !this.readSystem()
   handle ANY
--     !!alert.error('error $!!error.text reading stress group')
   endhandle

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .checkUnits()is BOOLEAN

  var !units units

  if !units.neq(!this.currentGroup.units) then
      !!alert.error('Bore or Distance units have changed - Please refresh the stress group')
      return FALSE
  else
      return TRUE
  endif

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to build a report and write the current stress group to file
define method .readCurrent()

  --Only do if there is a value highlighted in the group list
  if !this.groupList.val.lt(1) then
    !!alert.error('Please select an existing group or create a new one')
    return
  endif

  -- Generate xml file name
  !stressGroup = !this.currentGroup.stressgroupname.after('/')
  -- Convert .xml file to .cii
  !commandString = !this.coreloc.string() & '\convert_to_xml.bat ' & !this.psiDir.string() & ' ' & !stressGroup & ' ' & !this.coreloc.string()
  syscom '$!commandString'

  --syscom '$!<coredir>\convert_to_xml.bat $!psiDir $!stressGroup $!<coredir>'

  !fileName =  !this.psiDir.string() & '\' & 'return' & '\' & !stressGroup & 'Ret.xml'
  !return = object FILE('$!fileName')
  !path = !this.getLongPath(!return)
  --!x = object FILE(!psiDir & '\' & 'return' &'\' & !stressGroup & 'Ret.xml')
  if !return.exists() then
    !time = !path.dtm()
    !!alert.message('File ' & !path & ' created at ' & !time )
  else
    !!alert.error('error creating file ' & !path & ' in the conversion to xml - Please refer to the log file directory')
  endif

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to build a report and write the current stress group to file
define method .writeCurrent()

  --Only do if there is a value highlighted in the group list
  if !this.groupList.val.lt(1) then
    !!alert.error('Please select an existing group or create a new one')
    return
  endif

  if !this.checkUnits().not() then
    return
  endif

  -- Generate xml file name

  if !this.currentGroup.complete.not() then
    !this.refreshGroup(FALSE)
    --!this.currentGroup.getNodeData()
    !this.groups[!this.groupList.val] = !this.currentGroup
  endif

  !this.currentGroup.buildoutput()
  !stressGroup = !this.currentGroup.stressgroupname.after('/')
  !fileName =  !this.psiDir.string() & '\' & 'output' & '\' & !stressGroup & '.xml'
  !outputFileName = object FILE('$!fileName')
  !this.currentGroup.writedata(!outputFileName)

  !commandString = !this.coreloc.string() & '\convert_to_cii.bat' & ' ' & !this.psiDir.string() & ' ' & !stressGroup & ' ' & !this.coreloc.string()
  syscom '$!commandString'

  !finshedfileName =  !this.psiDir.string() & '\' & 'input' & '\' & !stressGroup & '.cii'
  !targetFile = object FILE(!finshedfileName)
  !path = !this.getLongPath(!targetFile)
  if !targetFile.exists() then
    !time = !targetFile.dtm()
    !!alert.message('File ' & !path & ' written at ' & !time )
  else
    !!alert.error('error writing cii file ' & !targetFile & ' Please refer to the log file directory')
  endif

endmethod
-------------------------------------------------------------------------------------------

define method .getpsiDirectories()

   -- Output/Input directories stored in environment variables

  var !projCode proj code
  var !psiDir evar '$!projCode$npsi'
  !psiDir = !psiDir.replace(';','')
  !psiDirectory = object FILE(!psiDir)
  if !psiDirectory.set() then
    !input  = !this.getDirectory(!psiDirectory,'input' )
    !output = !this.getDirectory(!psiDirectory,'output' )
    !return = !this.getDirectory(!psiDirectory,'return' )
    !logs   = !this.getDirectory(!psiDirectory,'logs' )
    if !input.set().and(!output.set()).and(!return.set()).and(!logs.set()) then
        -- found all directories
    else
      !!alert.error('Cannot find project Stress directories $!psiDir "input","output","return" and "logs"')
      !this.psiDir = object FILE()
      return error 456
    endif
  else
    !!alert.error('Cannot find project Stress directories $!psiDir ')
    return error 456
  endif

  if !psiDirectory.string().match(' ').gt(0) then
     !this.psiDir = !this.getShortPath(!psiDirectory )
  else
     !this.psiDir = !psiDirectory
  endif


  endmethod

-----------------------------------------------------------------------------
define method .getPSILocation() is FILE

  var !exidir evar 'aveva_design_installed_dir'
  !split = !exidir.split(';')
  do !directory values !split
    !file = object FILE(!directory)
    !associatedProductsDir = !this.getDirectory(!file,'asso_products' )
    break if !associatedProductsDir.set()
  enddo
  if !associatedProductsDir.set() then
    !psiLoc =  !this.getDirectory(!associatedProductsDir,'PSI' )
    if !psiLoc.set() then
      !coreloc = !this.getDirectory(!psiLoc,'core' )
      if !coreloc.set().not() then
        !!alert.error('Cannot find directory $!associatedProductsDir PSI/core - Please install PSI')
        return error 456
      endif
    else
      !!alert.error('Cannot find directory asso_products\PSI - Please install PSI')
      return error 456
    endif
  else
    !!alert.error('Cannot find directory ' & !file.string() & 'asso_products - PSI not loaded')
    return error 456
  endif

  if !coreloc.string().match(' ').gt(0) then
    !this.coreloc = !this.getShortPath(!coreloc )
  else
    !this.coreloc = !coreloc
  endif

  -- now test for files
  !filelist[1] = 'CaesarToPdms.dll'
  !filelist[2] = 'cii2psi.exe'
  !filelist[3] = 'convert_to_cii.bat'
  !filelist[4] = 'convert_to_xml.bat'
  !filelist[5] = 'psi2cii.exe'
  do !file values !filelist
    !test = !this.getfile( !file, !this.coreloc)
    if !test.not() then
      !!alert.error('Cannot find PSI file $!this.coreloc\$!file - PSI not loaded')
      return error 456
    endif
  enddo

endmethod
-----------------------------------------------------------------------------

-----------------------------------------------------------------------------
define method .getDirectory(!directory is FILE, !search is STRING)is FILE

  !subdirs = !directory.subdirs()
  handle any
  endhandle
  do !directorymatch values !subdirs
    if !directorymatch.entry().upcase().eq( !search.upcase() ) then
      return !directorymatch
    endif
  enddo

  return object FILE()

endmethod
-----------------------------------------------------------------------------

-----------------------------------------------------------------------------
define method .getfile(!name is STRING, !source is FILE) is BOOLEAN

  !files = !source.files()
  do !entry values !files
    if !entry.entry().upcase().eq(!name.upcase()) then
      return TRUE
    endif
  enddo

  return FALSE

endmethod

-----------------------------------------------------------------------------
-- convert the name to shortpath
-----------------------------------------------------------------------------
define method .getShortPath(!file is FILE ) is FILE

   using namespace |Aveva.pdms.PMLNet|
   !fileUtilities = object FILEUTILITIES()
   !newpath =  !fileUtilities.getShortPath(!file.string())
   return object FILE(!newpath)

endmethod
-----------------------------------------------------------------------------

-----------------------------------------------------------------------------
-- convert the name to longpath
-----------------------------------------------------------------------------
define method .getLongPath(!file is FILE ) is FILE

   using namespace |Aveva.pdms.PMLNet|
   !fileUtilities = object FILEUTILITIES()
   !newpath =  !fileUtilities.getLongPath(!file.string())
   return object FILE(!newpath)

endmethod
-----------------------------------------------------------------------------

-----------------------------------------------------------------------------
define method .getRest(!case is STRING,!pipe is DBREF ) is DBREF

   !return = object DBREF()
   var !rest coll all rest with desc eq '$!case' for $!pipe
   if !rest.set() then
     !return = !rest[1].dbref()
   endif

   return !return

endmethod
