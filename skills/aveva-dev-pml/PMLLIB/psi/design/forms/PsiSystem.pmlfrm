-------------------------------------------------------------------------------------------
-- method to check the current group for errors
-- calls a display routine if !input is true
define method .dataCheck(!dummyInput is BOOLEAN)

   --Only do if there is a value highlighted in the group list
   if !this.groupList.val.lt(1) then
     !!alert.error('Please select an existing group or create a new one')
     return
   endif

  -- how do we check a group
  -- loop through the branches and check them to file
  !lines = ARRAY()

  do !a values !this.currentGroup.branches

      alpha file /%pdmswk%\aadatchk over
      check $!a
      alpha file end
      !file = object FILE('%pdmswk%\aadatchk')
      !out = !file.readfile()
      !lines.appendarray(!out)
      !file.deletefile()
  enddo

  !!psierrors.derrorlist.val = !lines
  !this.nodeCheck()

  show !!psierrors


-- this method needs to be revised to deal with proper data consistency errors and excluded lists

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .nodeCheck()

  -- EW Get node data so that error flag is set
  if !this.currentGroup.complete.not() then
     !this.currentGroup = !!psiSystem.currentGroup
     --routine to get all the remaining data for the group
     !this.currentGroup.getNodeData()
     !!psiSystem.groups[!!psiSystem.groupList.val] = !this.currentGroup
  endif

   !results = ARRAY()

   -- EW Get errors for each node in the node list if the flag is set
    do !a values !this.currentGroup.nodelist
      if !a.errorflag.set() then
        !results.append(!a.componenttype & ' ' & !a.component )
        --EW Only display node number if it has been set
        if !a.nodenumber.set() then
          !results.append('Node Number: ' & !a.nodenumber)
        endif
        !results.appendarray(!a.errorlines)
        !results.append('')
      endif

   enddo

   if !results.size().eq(0)then
      !results[1] = |No Errors Found|
   endif
   !!psierrors.nerrorlist.val = !results

endmethod
