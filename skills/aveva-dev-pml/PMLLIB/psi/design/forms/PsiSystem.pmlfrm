-------------------------------------------------------------------------------------------
define method .findGroups()

   -- currently there is no option to search all stress zones in the defaults file
   !groups = !!psifindGroups(!!ce,FALSE)

   if !groups[1] then
      !groups.removefirst()
      -- add the rest to a new form and show it

      !dtext  = ARRAY()
      !rtext = ARRAY()

      do !a values !groups
        !dtext.append(!a.name)
        !rtext.append(!a.string())
      enddo

      if unDefined(!!psiStressGroupList) then
        pml load form !!psiStressGroupList
      endif
      !!psiStressGroupList.groups.dtext = !dtext
      !!psiStressGroupList.groups.rtext = !rtext

      show !!psiStressGroupList

   else
      if undefined(!groups[2]) then
         !!alert.error('Not in any stress groups')
      endif
   endif

endmethod
