-------------------------------------------------------------------------------------------
define method .reselectZone()

  hide !!psiSystem
  !!psiStressZone.form = '!!psiSystem'
  show !!psiStressZone

endmethod
-------------------------------------------------------------------------------------------
-------------------------------------------------------------------------------------------
define method .removeStressedPipe(!group is STRESSGROUP)

  if !group.caseGroups.size().eq(0) then
    return
  endif

  do !caseGroup values !group.caseGroups
    do !branch values !caseGroup.branches
      rem $!branch
    enddo
  enddo

endmethod
