-------------------------------------------------------------------------------------------
define method .getStressObjects()

-- Clear gadgets in case they will filled before

   if !this.defaultzone.unset() then
     return error 1 'No stress Zones Found'
   endif

   !this.groupMem.clear()
   !this.groupList.clear()

   !objects = ARRAY()
   !dtext = ARRAY()
   !rtext = ARRAY()
   var !pipes Coll all pipe for $!this.defaultzone
   if !pipes.size().eq(0) then
   else
     var !unusedNames eval name for all from !pipes
     do !a values !pipes
        !objects.append(object STRESSGROUP(!a.dbref(),1))
        !rtext.append(!a)
        !dtext.append(!a.dbref().namn)
     enddo
   endif

   !this.groupList.dtext = !dtext
   !this.groupList.rtext = !rtext
   !this.groups = !objects

endmethod
