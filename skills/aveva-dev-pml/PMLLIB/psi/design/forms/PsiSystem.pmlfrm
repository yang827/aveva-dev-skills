-- method to save the graphics at the current state
define method .saveDisplay()

var !coll COLLECT ALL FROM DRAWLIST
!this.displaylist =  !coll

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to add all the items in the original display list
define method .restoreDisplay()

do !a values !this.displaylist
   add $!a
enddo

!this.displaylist = ARRAY()

endmethod
