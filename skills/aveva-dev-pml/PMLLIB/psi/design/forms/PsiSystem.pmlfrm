------------------------------------------------------------------------------
-- method to set turn node visibility on or off
define method .setNodeVis()

-- Remove nodes from display
  !this.currentGroup.undrawnodes()

-- Show nodes if required

    !this.currentGroup.drawnodes()

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to mark either the current branch or all branches in the stress group

define method .setBranVisOld(!x is REAL)

-- Unmark all branches
  unmark all

-- Show required branch tags
  if !x.eq(1) then
    do !a values !this.groupMem.rtext
      !bran = !a.dbref()
      handle ANY
        skip
      endhandle
      mark $!bran
    enddo
  elseif !x.eq(2) then
    !bran = !this.groupMem.selection().dbref()
    handle ANY
      return
    endhandle
    mark $!bran
  endif

endmethod
------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .setBranVis()

-- Unmark all branches
  unmark all

-- Show required branch tags if the form value is set
  if !this.branches.val then
    do !a values !this.groupMem.rtext
      !bran = !a.dbref()
      handle ANY
        skip
      endhandle
      mark $!bran
    enddo
  endif

endmethod
------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to run when closing main form, remove aids and close all forms
define method .close()

-- Hide form
  hide !!psiSystem

-- Remove all tags
  !clearNode = object STRESSNODE()
  !clearNode.undrawnode()
  !this.setBranVis()

--Remove case group from the graphical view
  !this.removeStressedPipe(!this.currentGroup)
-- remove the highlights from the current group
  !this.currentGroup.highlightgroup(FALSE)
    handle ANY
    endhandle
  !this.currentGroup.undrawnodes()

-- Unenhance groups
  unenhance all
  aid clear line all

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .sequence()

-- Get list of branches in group
  !branches = !this.groupMem.rtext

-- Goto Stress Group Pipe
  !!ce = !this.currentGroup.pipe

-- Hide nodes if shown

    !reShowNodes = FALSE
    !this.setNodeVis()
    !reShowNodes = TRUE

-- Animate sequence

  refresh

  do !loop value !branches
    var !collAllMem append coll all for $!loop
  enddo

-- Work out speed from slider gadget
     !pause = 0.6

  do !animate values !collAllMem
    if !animate.dbref().type.neq('BRAN') or !animate.dbref().type.neq('GASK') or !animate.dbref().type.neq('ATTA')then
      enhance $!animate col 5
      !pos = !animate.dbref().position.wrt(/* )
        handle ANY
        elsehandle NONE
          aid text num 7500 '*' at $!pos
        endhandle
-- mark $!animate
      refresh
      pause $!pause
      enhance $!animate col $!this.currentGroup.highlightcolour
-- unmark $!animate
      aid clear text 7500
        handle ANY
        endhandle
      refresh
    endif
  enddo

-- Show nodes if they were shown

  if !reShowNodes then
    !this.setNodeVis()
  endif

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .drawConnected()

-- get list of branches

  !branches = !this.currentGroup.branches

  if !this.connected.val then

    do !addConnected values !branches
      !href = !addConnected.href
      !tref = !addConnected.tref
      add $!href
      handle ANY
      endhandle
      add $!tref
      handle ANY
      endhandle

      do !a values !addConnected.members
-- Skip if type is BRAN
        skip if !a.type.eq('BRAN')
-- Get the CREF of the Branch Member and ADD it to the GRAPHICAL VIEW/DRAW LIST
        !findCref = !a.attlist.find('CREF')
        if (!findCref.unset()) then
          skip
        else
          add $!a.cref
          handle ANY
-- CREF is INVALID so handle the error
          endhandle
        endif

      enddo

    enddo

  else

-- REMOVE Connected Elements
    do !remConnected values !branches

      !href = !remConnected.href
      if !href.badref().not() then
        if !href.type.eq('NOZZ') then
          rem $!href
        elseif !href.type.eq('BRAN') then
          !isHrefPartOfGroup = !this.currentGroup.branches.find(!href)
          if !isHrefPartOfGroup.unset() then
            rem $!href
          endif
        else
          !hrefOwner = !href.owner
          !isHrefPartOfGroup = !this.currentGroup.branches.find(!hrefOwner)
          if !isHrefPartOfGroup.unset() then
            rem $!href
          endif
        endif
      endif

      !tref = !remConnected.tref
      if !tref.badref().not() then
        if !tref.type.eq('NOZZ') then
          rem $!tref
        elseif !tref.type.eq('BRAN') then
          !isTrefPartOfGroup = !this.currentGroup.branches.find(!tref)
          if !isTrefPartOfGroup.unset() then
            rem $!tref
          endif
        else
          !trefOwner = !tref.owner
          !isTrefPartOfGroup = !this.currentGroup.branches.find(!trefOwner)
          if !isTrefPartOfGroup.unset() then
            rem $!tref
          endif
        endif
      endif


-- REMOVE any connected branches from 3D view
      do !r values !remConnected.members
-- Skip if type is BRAN
        skip if !r.type.eq('BRAN')
-- Get the CREF of the Branch Member and REMOVE it from the GRAPHICAL VIEW/DRAW LIST
        !findCref = !r.attlist.find('CREF')
        if (!findCref.unset()) then
          skip
        else
          if (!branches.findfirst(!r.cref).set()) then
-- Branch belongs to the Current Stress Group so ignore it
            skip
          else
            remove $!r.cref
            handle ANY
-- CREF is INVALID so handle the error
            endhandle
          endif
        endif
      enddo
    enddo
  endif

endmethod
