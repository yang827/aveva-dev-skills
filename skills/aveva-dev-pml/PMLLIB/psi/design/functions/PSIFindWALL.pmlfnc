-- Created:		21/12/2005 10:43
--
--
-- Description:
-- Function to find if a branch belongs to a stressgroup
--
--------------------------------------------------------------------------------
--
--
--------------------------------------------------------------------------------
-- Define Function
define function !!PsiFindWall(!component is dbref,!point is real)is real

  -- if the user wants to have different wall thicknesses for components then there is a uda
  -- :cwall on a CMPD. This has three values to represent p1 p2 p3
  if !component.type.eq('BRAN') then
       -- we need to get the hstu

       !wall = !component.hstu.cmpref.:twall
       handle ANY
         -- $P $!!ERROR.text
         return 0
       endhandle
      -- the wall is now set but we may need to reset it if its the tail
      if !point.eq(2) then
           if !component.mcount.gt(0) then
              !wall = !component.members[!component.mcount].lstu.cmpref.:twall
              handle ANY
               --$P $!!ERROR.text
                 return 0
              endhandle
           else
            !wall = !component.hstu.cmpref.:twall
            handle ANY
               -- $P $!!ERROR.text
                   return 0
            endhandle
          endif
      endif
  else
       -- if the component has its :cwall set then it has different wall thicknesses
       -- to the tube its connected to
       -- :CWALL is a UDA with three values for p1 p2 and p3
       !y = :cwall of cmpref of spref of $!component
       handle ANY
          !y = ARRAY()
       endhandle
       ----------------------------------------------------------------
       if !y.set() then
            if !y[1].set() then
               !wall = !y[1]
            endif
            if !y[2].set() then
               !wall = !y[2]
            endif
            if !y[3].set() then
              !wall = !y[3]
            endif
            if !y[4].set() then
              !wall = !y[4]
            endif
       else $* get the wall thickness from the tube
            if !point.eq(1) then
                 if !component.order.gt(1) then
                    !prev = !component.owner.members[!component.order - 1]
                    !wall = :twall of cmpref of lstu of $!prev
                    handle ANY
                       !wall = 0
                    endhandle
                 else
                    !bran = !component.owner
                    !wall = :twall of cmpref of hstu of $!bran
                    handle ANY
                      !wall = 0
                    endhandle
                 endif
            else
              !wall = :twall of cmpref of lstu of $!component
              handle ANY
                !wall = 0
              endhandle
            endif
      endif
  endif

return !wall
