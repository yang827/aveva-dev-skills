--
-- Author:		Neale Morris
-- Created:		Tuesday 8th November 2005
--
--
-- Description:
-- Function to display the PSI splash screen on entry
--
--------------------------------------------------------------------------------
--
-- Arguments:
--    [#]   [R/RW]   [Data Type]   [Description]
-- Return:
--    [Data Type]   [Description]
--
--------------------------------------------------------------------------------

-- Define Function
define function !!PsiShowSplash(!Mode is BOOLEAN)

  if !Mode then

-- Display splash screen if it not already displayed
-- The splashscreen exe and png file is in the software directory in a directory splash called PsiSplashScreen.bmp

    if (undefined(!!PsiSplash)) then
      var !SplashBitMap file /%pmllib%\..\splash\psisplashscreen.png
        handle ANY
          return
        endhandle
      !FileName = object file(!SplashBitMap)
      !Fullname = !Filename.fullname()
      var !SplashProgram file /%pmllib%\..\splash\splashscreen.exe
        handle ANY
          return
        endhandle
      syscom '%pdmsexe%/splashscreen $!SplashBitMap &'
      !!PSISplash = TRUE
    endif

  else

-- In the unlikly event of PSI loading before the splashscreen times out then
-- kill it

    syscom '%pdmsexe%/splashscreen -kill &'

  endif

endfunction
