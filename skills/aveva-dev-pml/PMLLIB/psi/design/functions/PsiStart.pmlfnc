--
-- File:    PsiStart.pmlfnc
--   Type:    Function Definition
--   Group:   Pipe Stress Interface
--   Keyword:   PSI
--   Module:    design
--   Replaces:
--
-- Author:    Tony Martin
-- Created:   26/01/2006 10:02
--
--
-- Description:
-- Function to show the psi main form or start psi if its not been started
--------------------------------------------------------------------------------
-- this form is called as a result of pressing either:
-- option 1 the psi start button to show !!psiSystem
-- option 2 the psiDefaults button
--
-- PSI can now have alternative defaults files stored in the function of the default stress zone
-- this creates a problem because the defaults file can no longer be loaded automatically
-- and it relies on having a stress zone to define the default defaults file.
-- this function was originally to prompt for a default stress group and then
-- show the psiSystem form.
-- Now it also shows the defaults form so it needs to ensure that the defaults are
-- loaded correctly before showing the appropriate form.
--------------------------------------------------------------------------------

-- Define Function
define function !!psiStart(!load is REAL)

  !forms[1] = |!!psiStressZone|
  !forms[2] = |!!psiCreateGroup|
  !forms[3] = |!!psiShowNodes|
  !forms[4] = |!!psiSystem|
  !forms[5] = |!!psiErrors|
  !forms[6] = |!!psiNodeDetail|
  !forms[7] = |!!psiNodeNumbers|

  --!forms[5] = !!psiDefaults

   do !a values !forms
     -- if we haven't got a psiSystem we haven't got a default stress zone
      if (undefined($!<a>)) then
          pml load form $!a
      endif
   enddo

   if !load.eq(1) then
     !form = '!!psiSystem'
   else
     !form = '!!psiDefaults'
   endif

   if !!psiSystem.defaultZone.badref() then
     if !load.eq(1) then
       !!psistresszone.form = !form
     else
       !!psistresszone.form = !form
     endif
     show !!psistresszone
   else
     show $!form
   endif


endfunction
