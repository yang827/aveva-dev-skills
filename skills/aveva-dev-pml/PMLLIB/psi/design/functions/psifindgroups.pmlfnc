--
--
-- Description:
-- Function to find if a branch belongs to a stressgroup
--
--------------------------------------------------------------------------------
--
--
--------------------------------------------------------------------------------

-- Define Function
define function !!PsiFindGroups(!element is dbref,!Mode is BOOLEAN)is ARRAY

   !return[1] = FALSE

   !bran = bran of $!element
   handle ANY
      !!alert.error('Not at a Branch')
      !return[2] = 'level'
      return !return
   endhandle

   -- mode defines if we look for all stress zones or just the current one true means search all zone
   if !mode then
      !zonelist = !!PsiStressZone.zone.rtext
      -- add the current zone in case it was created in this session
      !zonelist.append(!!psisystem.defaultzone.string())
      !zonelist.unique()
      !pipes = ARRAY()
      do !a values !zonelist
         var !pipes append coll all pipe for $!a
      enddo
   else
      var !pipes coll all pipe for $!!psisystem.defaultzone
      handle ANY
         -- zone not defined
      endhandle
   endif

   if !pipes.set() then

     do !b values !pipes
        !test = !b.dbref().:psisystem.findfirst(!bran)
        if !test.set() then
           !return[1] = TRUE
           !return.append(!b.dbref())
        endif
     enddo

   endif

     return !return

endfunction
