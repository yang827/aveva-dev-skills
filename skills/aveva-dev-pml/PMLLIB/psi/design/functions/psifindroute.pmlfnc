--
--------------------------------------------------------------------------------

-- Define Function
define function !!PsiFindRoute(!element is dbref)is ARRAY

-- !element should be a stresspipe
-- stresspipes can now have equipment so we need to find a route through
!members = !element.:PSISystem
if !members.size().eq(0) then
    !return[1] = FALSE
    !return[2] = 'No Members'
    return !return
elseif !members.size().eq(1) then
    !return[1] = TRUE
    return !return
endif

-- first collect all the items in the group and see what they are
!equipment = ARRAY()
!branches  = ARRAY()
do !a values !members
  if !a.type.eq('EQUI') then
     !equipment.append(!a)
  else
     !branches.append(!a)
  endif
enddo

-- loop through the branches and collect all the ends
!refs = ARRAY()
do !a values !branches
  !refs.append(!a.href)
  !refs.append(!a.tref)
  do !b values !a.members
    if !b.type inset('TEE','ELBO','OLET','VTWA') then
        -- crosses pcoms shus will need to be dealt with later
      if !b.cref.set() then
        !refs.append(!b.cref)
      endif
    endif
  enddo
enddo

!nozrefs = ARRAY()
do !a values !equipment
  do !b values !a.members
    if !b.type.eq('NOZZ') then
        -- crosses pcoms shus will need to be dealt with later
      if !b.cref.set() then
        !nozrefs.append(!b.cref)
      endif
    endif
  enddo
enddo

!connected = ARRAY()

-- now we have got all the connections then we need to sort out if there is connectivity
do !a values !branches
  do !b values !refs
    if !b eq !a then
      !connected .append(!a)
    endif
  enddo
enddo

do !a values !nozrefs
  do !b values !branches
    if !b eq !a then
      !connected .append(!b)
    endif
  enddo
enddo

!connected.unique()
!branches.sort()

if !branches.eq(!connected) then
    !return[1] = TRUE
else
    !return[1] = FALSE
    !return[2] = 'Network is not Connected'
endif

return !return


-- loop through the equipment and check that they have a sube with the corrcet bits
-- collect all the nozzle crefs




--loop through all the branches and tick off the ones which connect to something else










endfunction
