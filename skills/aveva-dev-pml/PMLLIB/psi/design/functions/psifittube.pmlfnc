--
-- Description:
-- Function to put bends between components
--------------------------------------------------------------------------------
--
--
--------------------------------------------------------------------------------

-- Define Function
define function !!PsiFitTube(!element is dbref)

   !tulen = !element.ltlength

   if !tulen.lt(1) then
     return
   else

   !save = !!ce
   !bore = !element.lbore
   !lstu = !element.lstu
   !!ce = !element
   new bend
   desp $!bore
   spref /PSI-SPEC/VARI
   lstu $!lstu
   fconn
   dir to pa of next
   nex
   back
   new bend
   desp $!bore
   spref /PSI-SPEC/VARI
   lstu $!lstu
   fconn
   dir to next
   forw
   !!ce = !save


endfunction
