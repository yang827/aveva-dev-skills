-- Define Function
define function !!psiresttype(!type is STRING)is REAL

!types = ARRAY()
!types[1]  = 'ANC'
!types[2]  = 'X'
!types[3]  = 'Y'
!types[4]  = 'Z'
!types[5]  = 'RX'
!types[6]  = 'RY'
!types[7]  = 'RZ'
!types[8]  = 'GUI'
!types[9]  = 'LIM'
!types[10] = 'XSNB'
!types[11] = 'YSNB'
!types[12] = 'ZSNB'
!types[13] = '+X'
!types[14] = '+Y'
!types[15] = '+Z'
!types[16] = '-X'
!types[17] = '-Y'
!types[18] = '-Z'
!types[19] = '+RX'
!types[20] = '+RY'
!types[21] = '+RZ'
!types[22] = '-RX'
!types[23] = '-RY'
!types[24] = '-RZ'
!types[25] = '+LIM'
!types[26] = '-LIM'
!types[27] = 'XROD'
!types[28] = 'YROD'
!types[29] = 'ZROD'
!types[30] = '+XROD'
!types[31] = '+YROD'
!types[32] = '+ZROD'
!types[33] = '-XROD'
!types[34] = '-YROD'
!types[35] = '-ZROD'
!types[36] = 'X2'
!types[37] = 'Y2'
!types[38] = 'Z2'
!types[39] = 'RX2'
!types[40] = 'RY2'
!types[41] = 'RZ2'
!types[42] = '+X2'
!types[43] = '+Y2'
!types[44] = '+Z2'
!types[45] = '-X2'
!types[46] = '-Y2'
!types[47] = '-Z2'
!types[48] = '+RX2'
!types[49] = '+RY2'
!types[50] = '+RZ2'
!types[51] = '-RX2'
!types[52] = '-RY2'
!types[53] = '-RZ2'
!types[54] = 'XSPR'
!types[55] = 'YSPR'
!types[56] = 'ZSPR'
!types[57] = '+XSNB'
!types[58] = '+YSNB'
!types[59] = '+ZSNB'
!types[60] = '-XSNB'
!types[61] = '-YSNB'
!types[62] = '-ZSNB'

  !index = 0

  do !val values !types
    !index = !index + 1
    if !val.eq(!type) then
     return !index
    endif
  enddo

  return 0

endfunction
