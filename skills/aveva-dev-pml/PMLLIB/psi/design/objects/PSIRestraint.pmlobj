-- Description:
-- PSIRESTRAINT object for reading restraint attributes
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidArrow(REAL,POSITION,DIRECTION,REAL) -
--  aidBox(REAL,POSITION,DIRECTION,REAL) -
--  aidCylinder(REAL,POSITION,DIRECTION,REAL) -
--  display(BOOLEAN)                 -
--  drawSupport()                    -
--  generatePositions(DBREF)         ARRAY
--  getDirection(STRING)             STRING
--  getDisplaytext()                 ARRAY
--  getNearestAxis(DIRECTION)        DIRECTION
--  getRestraintData(REAL)           -
--  getmost(ARRAY,STRING)            ARRAY
--  getxmlLines()                    ARRAY
--  mapDirections(ARRAY)             -
--  psiRestraint(ARRAY,REAL,REAL)    -
--  psiRestraint(DBREF,REAL)         -
--
define object PSIRESTRAINT

member .lineNumber          is REAL
member .nodeNumber          is REAL
member .restraintType       is STRING
member .stiffness           is STRING
member .gap                 is STRING
member .friction            is STRING
member .owner               is DBREF
member .restraintIndex      is REAL
member .display             is STRING
member .direction           is STRING
member .tagId               is REAL
member .componentIndex      is REAL
member .originPosition      is POSITION
member .arriveDirection     is DIRECTION
member .leaveDirection      is DIRECTION
member .eastPosition        is POSITION
member .eastDirection       is DIRECTION
member .northPosition       is POSITION
member .northDirection      is DIRECTION
member .upPosition          is POSITION
member .upDirection         is DIRECTION
member .westPosition        is POSITION
member .westDirection       is DIRECTION
member .southPosition       is POSITION
member .southDirection      is DIRECTION
member .downPosition        is POSITION
member .downDirection       is DIRECTION
member .xmlLines            is ARRAY
member .tubeDirection       is DIRECTION

-- lines read from return file look like this:
--        <Restraint>
--          <Type>X</Type>
--          <Stiffness>5900</Stiffness>
--          <Gap>0</Gap>
--          <Friction>0</Friction>
--        </Restraint>

endobject
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
define method .psiRestraint(!lines is ARRAY,!point is REAL,!number is REAL)

  !this.nodeNumber = !number
  do !a from !point + 1 to !lines.size()
    if !lines[!a].eq('</Restraint>') then
      !this.lineNumber = !a
      break
    endif
    !varName = !lines[!a].after('<').before('>').upcase()
    !value   = !lines[!a].after('>').before('<')

    if !varName.eq('TYPE') then
      !this.restraintType = !value
    else
      !this.$!<varName> = !value
    endif

  enddo

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
-- Constructor method for building a single restraint from a dbref
define method .psiRestraint(!owner is DBREF,!itemNumber is REAL)

   !this.owner = !owner
   !this.componentIndex = !itemNumber

   !this.restraintIndex = !owner.:nodeType[!itemNumber]
   !this.stiffness      = !owner.:NodeStiff[!itemNumber].string()
   !this.gap            = !owner.:NodeGap[!itemNumber].string()
   !this.friction       = !owner.:NodeFriction[!itemNumber].string()
   --fill in the text and directions
   !this.getRestraintData(!this.restraintIndex)
   !this.tagId = !!aidNumbers.add('$!owner$!this.restraintIndex')

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .getxmlLines() is ARRAY

-- xml output looks like this:
--        <Restraint>
--          <Type>X</Type>
--          <Stiffness>5900</Stiffness>
--          <Gap>0</Gap>
--          <Friction>0</Friction>
--        </Restraint>

!lines = ARRAY()
!lines.append(|<Restraint>|)
!lines.append('<Type>'      & !this.restraintType & '</Type>')
!lines.append('<Stiffness>' & !this.stiffness     & '</Stiffness>')
!lines.append('<Gap>'       & !this.gap           & '</Gap>')
!lines.append('<Friction>'  & !this.friction      & '</Friction>')
!lines.append('</Restraint>')

return !lines

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------

define method .getDisplaytext() is ARRAY


!lines[1] = !this.restraintType
!lines[2] = !this.stiffness
!lines[3] = !this.gap
!lines[4] = !this.friction
return !lines

endmethod
------------------------------------------------------------------------



------------------------------------------------------------------------
-- method to set up the list of restraints by number
define method .getRestraintData(!index is REAL)

   !types = ARRAY()
   !display = ARRAY()
   !direction = ARRAY()
   !types[1]  = 'ANC'     !display[1]  = 'box'       !direction[1]  =  'X'
   !types[2]  = 'X'       !display[2]  = 'arrow2'    !direction[2]  =  'X'
   !types[3]  = 'Y'       !display[3]  = 'arrow2'    !direction[3]  =  'Y'
   !types[4]  = 'Z'       !display[4]  = 'arrow2'    !direction[4]  =  'Z'
   !types[5]  = 'RX'      !display[5]  = 'arrow2'    !direction[5]  =  'X'
   !types[6]  = 'RY'      !display[6]  = 'arrow2'    !direction[6]  =  'Y'
   !types[7]  = 'RZ'      !display[7]  = 'arrow2'    !direction[7]  =  'Z'
   !types[8]  = 'GUI'     !display[8]  = 'arrow4'    !direction[8]  =  'leave'
   !types[9]  = 'LIM'     !display[9]  = 'arrow2'    !direction[9]  =  'leave'
   !types[10] = 'XSNB'    !display[10] = 'arrow2'    !direction[10] =  'X'
   !types[11] = 'YSNB'    !display[11] = 'arrow2'    !direction[11] =  'Y'
   !types[12] = 'ZSNB'    !display[12] = 'arrow2'    !direction[12] =  'Z'
   !types[13] = '+X'      !display[13] = 'arrow1'    !direction[13] =  'X'
   !types[14] = '+Y'      !display[14] = 'arrow1'    !direction[14] =  'Y'
   !types[15] = '+Z'      !display[15] = 'arrow1'    !direction[15] =  'Z'
   !types[16] = '-X'      !display[16] = 'arrow1'    !direction[16] =  '-X'
   !types[17] = '-Y'      !display[17] = 'arrow1'    !direction[17] =  '-Y'
   !types[18] = '-Z'      !display[18] = 'arrow1'    !direction[18] =  '-Z'
   !types[19] = '+RX'     !display[19] = 'arrow1'    !direction[19] =  'X'
   !types[20] = '+RY'     !display[20] = 'arrow1'    !direction[20] =  'Y'
   !types[21] = '+RZ'     !display[21] = 'arrow1'    !direction[21] =  'Z'
   !types[22] = '-RX'     !display[22] = 'arrow1'    !direction[22] =  '-X'
   !types[23] = '-RY'     !display[23] = 'arrow1'    !direction[23] =  '-Y'
   !types[24] = '-RZ'     !display[24] = 'arrow1'    !direction[24] =  '-Z'
   !types[25] = '+LIM'    !display[25] = 'arrow1'    !direction[25] =  'arrive'
   !types[26] = '-LIM'    !display[26] = 'arrow1'    !direction[26] =  'leave'
   !types[27] = 'XROD'    !display[27] = 'rod'    !direction[27] =  'X'
   !types[28] = 'YROD'    !display[28] = 'rod'    !direction[28] =  'Y'
   !types[29] = 'ZROD'    !display[29] = 'rod'    !direction[29] =  'Z'
   !types[30] = '+XROD'   !display[30] = 'rod'    !direction[30] =  'X'
   !types[31] = '+YROD'   !display[31] = 'rod'    !direction[31] =  'Y'
   !types[32] = '+ZROD'   !display[32] = 'rod'    !direction[32] =  'Z'
   !types[33] = '-XROD'   !display[33] = 'rod'    !direction[33] =  '-X'
   !types[34] = '-YROD'   !display[34] = 'rod'    !direction[34] =  '-Y'
   !types[35] = '-ZROD'   !display[35] = 'rod'    !direction[35] =  '-Z'
   !types[36] = 'X2'      !display[36] = 'arrow2'    !direction[36] =  'X'
   !types[37] = 'Y2'      !display[37] = 'arrow2'    !direction[37] =  'Y'
   !types[38] = 'Z2'      !display[38] = 'arrow2'    !direction[38] =  'Z'
   !types[39] = 'RX2'     !display[39] = 'arrow2'    !direction[39] =  'X'
   !types[40] = 'RY2'     !display[40] = 'arrow2'    !direction[40] =  'Y'
   !types[41] = 'RZ2'     !display[41] = 'arrow2'    !direction[41] =  'Z'
   !types[42] = '+X2'     !display[42] = 'arrow1'    !direction[42] =  'X'
   !types[43] = '+Y2'     !display[43] = 'arrow1'    !direction[43] =  'Y'
   !types[44] = '+Z2'     !display[44] = 'arrow1'    !direction[44] =  'Z'
   !types[45] = '-X2'     !display[45] = 'arrow1'    !direction[45] =  '-X'
   !types[46] = '-Y2'     !display[46] = 'arrow1'    !direction[46] =  '-Y'
   !types[47] = '-Z2'     !display[47] = 'arrow1'    !direction[47] =  '-Z'
   !types[48] = '+RX2'    !display[48] = 'arrow1'    !direction[48] =  'X'
   !types[49] = '+RY2'    !display[49] = 'arrow1'    !direction[49] =  'Y'
   !types[50] = '+RZ2'    !display[50] = 'arrow1'    !direction[50] =  'Z'
   !types[51] = '-RX2'    !display[51] = 'arrow1'    !direction[51] =  '-X'
   !types[52] = '-RY2'    !display[52] = 'arrow1'    !direction[52] =  '-Y'
   !types[53] = '-RZ2'    !display[53] = 'arrow1'    !direction[53] =  '-Z'
   !types[54] = 'XSPR'    !display[54] = 'arrow2'    !direction[54] =  'X'
   !types[55] = 'YSPR'    !display[55] = 'arrow2'    !direction[55] =  'Y'
   !types[56] = 'ZSPR'    !display[56] = 'arrow2'    !direction[56] =  'Z'
   !types[57] = '+XSNB'   !display[57] = 'arrow1'    !direction[57] =  'X'
   !types[58] = '+YSNB'   !display[58] = 'arrow1'    !direction[58] =  'Y'
   !types[59] = '+ZSNB'   !display[59] = 'arrow1'    !direction[59] =  'Z'
   !types[60] = '-XSNB'   !display[60] = 'arrow1'    !direction[60] =  '-X'
   !types[61] = '-YSNB'   !display[61] = 'arrow1'    !direction[61] =  '-Y'
   !types[62] = '-ZSNB'   !display[62] = 'arrow1'    !direction[62] =  '-Z'


   !this.restraintType = !types[!index]
   !this.display       = !display[!index]
   !this.direction     = !direction[!index]

endmethod

------------------------------------------------------------------------------------------------
define method .display(!action is BOOLEAN)

   if !action then
      !this.drawSupport()
   else
      !!aidNumbers.hide(!this.tagId)
   endif

endmethod
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
define method .drawSupport()

   !atts = !this.generatePositions(!this.owner)
   !positions         = !atts[1]
   !directions        = !atts[2]
   !directionString   = !this.direction.string()
   !display           = !this.display
   !tagId             = !this.tagId

   if !directionString inset ('arrive','leave') then
      !directionString = !this.getDirection(!directionString)
   endif


if !display.eq('arrow2') then
  if !directionString inset('X','-X') then
     -- draw 2 arrows in the x direction
     --pin 1 at   $!positions[1]
     --pin 2 at     $!positions[2]
     !this.aidArrow(!tagId , !this.eastPosition, !this.eastDirection, 200mm)
     !this.aidArrow(!tagId , !this.westPosition, !this.westDirection, 200mm)
  elseif !directionString inset('Y','-Y') then
     -- draw 2 arrows in the y direction
     !this.aidArrow(!tagId , !this.northPosition, !this.northDirection, 200mm)
     !this.aidArrow(!tagId , !this.southPosition, !this.southDirection, 200mm)
  else
     -- !direction is inset('Z','-Z') then
     -- draw 2 arrows in the Z direction
     -- draw 2 arrows in the y direction
     !this.aidArrow(!tagId , !this.upPosition, !this.upDirection, 200mm)
     !this.aidArrow(!tagId , !this.downPosition, !this.downDirection, 200mm)
  endif

elseif !display.eq('arrow1') then
  --draw 1 arrow in the !direction direction.
  if !directionString.eq('-X') then
    !this.aidArrow(!tagId , !this.eastPosition, !this.eastDirection, 200mm)
  elseif !directionString.eq('X') then
    !this.aidArrow(!tagId , !this.westPosition, !this.westDirection, 200mm)
  elseif !directionString.eq('-Y') then
    !this.aidArrow(!tagId , !this.northPosition, !this.northDirection, 200mm)
  elseif !directionString.eq('Y') then
    !this.aidArrow(!tagId , !this.southPosition, !this.southDirection, 200mm)
  elseif !directionString.eq('-Z') then
    !this.aidArrow(!tagId , !this.upPosition, !this.upDirection, 200mm)
  elseif !directionString.eq('Z') then
    !this.aidArrow(!tagId , !this.downPosition, !this.downDirection, 200mm)
  endif
elseif !display.eq('rod') then
   -- draw a cylinder in the !direction direction
  if !directionString inset('X') then
    !this.aidCylinder(!tagId , !this.eastPosition, !this.eastDirection, 200mm)
  elseif !directionString.eq('-X') then
    !this.aidCylinder(!tagId , !this.westPosition, !this.westDirection, 200mm)
  elseif !directionString.eq('Y') then
    !this.aidCylinder(!tagId , !this.northPosition, !this.northDirection, 200mm)
  elseif !directionString.eq('-Y') then
    !this.aidCylinder(!tagId , !this.southPosition, !this.southDirection, 200mm)
  elseif !directionString.eq('Z') then
    !this.aidCylinder(!tagId , !this.upPosition, !this.upDirection, 200mm)
  elseif !directionString.eq('-Z') then
    !this.aidCylinder(!tagId , !this.downPosition, !this.downDirection, 200mm)
  endif
elseif !display.eq('arrow4') then
  -- its a guide which needs to be in line with the direction
  if !this.tubeDirection.eq(U).or(!this.tubeDirection.eq(D)) then
     !this.aidArrow(!tagId , !this.eastPosition, !this.eastDirection, 200mm)
     !this.aidArrow(!tagId , !this.westPosition, !this.westDirection, 200mm)
     !this.aidArrow(!tagId , !this.northPosition, !this.northDirection, 200mm)
     !this.aidArrow(!tagId , !this.southPosition, !this.southDirection, 200mm)
  elseif !this.tubeDirection.eq(E).or(!this.tubeDirection.eq(W)) then
     !this.aidArrow(!tagId , !this.northPosition, !this.northDirection, 200mm)
     !this.aidArrow(!tagId , !this.southPosition, !this.southDirection, 200mm)
     !this.aidArrow(!tagId , !this.upPosition, !this.upDirection, 200mm)
     !this.aidArrow(!tagId , !this.downPosition, !this.downDirection, 200mm)
  else
     !this.aidArrow(!tagId , !this.upPosition, !this.upDirection, 200mm)
     !this.aidArrow(!tagId , !this.downPosition, !this.downDirection, 200mm)
     !this.aidArrow(!tagId , !this.eastPosition, !this.eastDirection, 200mm)
     !this.aidArrow(!tagId , !this.westPosition, !this.westDirection, 200mm)
  endif
elseif !display.eq('box') then
  -- draw a box rotated 45 degrees from the node direction
  !this.aidBox(!tagId , !positions[1], !directions[1], 400mm)
else
   -- draw nothing
endif

endmethod
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
-- method to generate four positions in the cardinal directions of the passed component
define method .generatePositions(!element is DBREF)is ARRAY

!nDirection = ARRAY()
!return = ARRAY()
!this.originPosition  = !element.position.wrt(/* )
!this.arriveDirection = !element.adir.wrt(/* )
--!this.leaveDirection = !element.ldir.wrt(/* )
!this.leaveDirection = !this.arriveDirection.opposite()

!this.tubeDirection = !this.getNearestAxis(!this.arriveDirection)
if !element.type.eq('ELBO') then
   do !a from 1 to 6
     !nPosition[!a] = !element.position.wrt(/* )
   enddo
   !nDirection[1] = !element.ldir.wrt(/* )

   !this.eastDirection    = x wrt /*
   !this.eastPosition     = !element.position.wrt(/* )
   !this.northDirection   = y wrt /*
   !this.northPosition    = !element.position.wrt(/* )
   !this.upDirection      = z wrt /*
   !this.upPosition       = !element.position.wrt(/* )
   !this.westDirection    = w wrt /*
   !this.westPosition     = !element.position.wrt(/* )
   !this.southDirection   = s wrt /*
   !this.southPosition    = !element.position.wrt(/* )
   !this.downDirection    = d wrt /*
   !this.downPosition     = !element.position.wrt(/* )

else
   -- its assumed to be a circular component
   !pos = !element.position.wrt(/* )
   !direction = !element.adir.wrt(/* )
   !lDiam = !element.loDiam
   !plane = object PLANE()
   !plane.orientation = z is $!direction
   !plane.position = !pos

   -- xy object for getting the x coordinate
   !xy = object XYPOSITION()
   !xy.x = (-1 * (!lDiam / 2))
   !xy.y = 0
   -- the +x position
   !nPosition[1]  = !plane.threeDPosition(!xy)
   !nDirection[1] = !pos.direction(!nPosition[1])
   -- pos 4 the +Z position
   !xy.y = (-1 * (!lDiam / 2))
   !xy.x = 0
   !nPosition[2]  = !plane.threeDPosition(!xy)
   !nDirection[2] = !pos.direction(!nPosition[2])
    --pos 3 the +Y coordinate
   !xy.y = 0
   !xy.x = (!lDiam / 2)
   !nPosition[3] = !plane.threeDPosition(!xy)
   !nDirection[3] = !pos.direction(!nPosition[3])
   -- pos 4 the -x position
   !xy.y = (!lDiam / 2)
   !xy.x = 0
   !nPosition[4]  = !plane.threeDPosition(!xy)
   !nDirection[4] = !pos.direction(!nPosition[4])
endif
  -- this gives 4 positions and 4 directions -- the next problem is mapping them onto xyz
  !return[1] = !nPosition
  !return[2] = !nDirection
  !this.mapDirections(!return)

  return !return

endmethod
------------------------------------------------------------------------


------------------------------------------------------------------------
-- given 6 directions we need to align them with xyz somehow.
define method .mapDirections(!input is ARRAY)

  if !this.owner.type.eq('ELBO') then
    return !input
  endif

  if !this.tubeDirection .eq(U) then
     !this.upDirection = !this.arriveDirection
     !this.downDirection = !this.leaveDirection
  elseif !this.tubeDirection .eq(d) then
     !this.downDirection = !this.arriveDirection
     !this.upDirection = !this.leaveDirection
  elseif !this.tubeDirection .eq(e) then
     !this.eastDirection = !this.arriveDirection
     !this.westDirection = !this.leaveDirection
  elseif !this.tubeDirection .eq(w) then
     !this.westDirection = !this.arriveDirection
     !this.eastDirection = !this.leaveDirection
  elseif !this.tubeDirection .eq(n) then
     !this.northDirection = !this.arriveDirection
     !this.southDirection = !this.leaveDirection
  elseif !this.tubeDirection .eq(s) then
     !this.southDirection = !this.arriveDirection
     !this.northDirection = !this.leaveDirection
  endif

  if !this.tubeDirection .eq(U).or(!this.tubeDirection .eq(D)) then
    -- we are looking for east,west,north,south
    !index = !this.getmost(!input,'east')
    !this.eastPosition  = !input[1][!index[1]]
    !this.eastDirection = !input[2][!index[1]]
    !this.westPosition  = !input[1][!index[2]]
    !this.westDirection = !input[2][!index[2]]
    !index = !this.getmost(!input,'north')
    !this.northPosition  = !input[1][!index[1]]
    !this.northDirection = !input[2][!index[1]]
    !this.southPosition  = !input[1][!index[2]]
    !this.southDirection = !input[2][!index[2]]
    -- get the outside positions for along the tube
    !this.upPosition = !this.northPosition
    !this.downPosition = !this.northPosition
  elseif !this.tubeDirection .eq(e).or(!this.tubeDirection .eq(W)) then
    -- we are looking for up,down,north,south
    !index = !this.getmost(!input,'up')
    !this.upPosition  = !input[1][!index[1]]
    !this.upDirection = !input[2][!index[1]]
    !this.downPosition  = !input[1][!index[2]]
    !this.downDirection = !input[2][!index[2]]
    !index = !this.getmost(!input,'north')
    !this.northPosition  = !input[1][!index[1]]
    !this.northDirection = !input[2][!index[1]]
    !this.southPosition  = !input[1][!index[2]]
    !this.southDirection = !input[2][!index[2]]
    -- get the outside positions for along the tube
    !this.eastPosition  = !this.northPosition
    !this.westPosition  = !this.northPosition
  else
    -- we are looking for up,down,east,west
    !index = !this.getmost(!input,'east')
    !this.eastPosition  = !input[1][!index[1]]
    !this.eastDirection = !input[2][!index[1]]
    !this.westPosition  = !input[1][!index[2]]
    !this.westDirection = !input[2][!index[2]]
    !index = !this.getmost(!input,'up')
    !this.upPosition  = !input[1][!index[1]]
    !this.upDirection = !input[2][!index[1]]
    !this.downPosition  = !input[1][!index[2]]
    !this.downDirection = !input[2][!index[2]]
    --get the outside positions for along the tube
    !this.northPosition = !this.eastPosition
    !this.southPosition = !this.eastPosition
  endif

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .getmost(!values is ARRAY,!direction is STRING)is ARRAY

  !positions =  !values[1]
  !directions = !values[2]

  !east = ARRAY()
  !north = ARRAY()
  !up = ARRAY()
  do !a values !positions
    !east.append(!a.east)
    !north.append(!a.north)
    !up.append(!a.up)
  enddo

  if !direction.eq('east') then
    !index = !east.sortedindices()
    !return[1] = !index[!index.size()]
    !return[2] = !index[1]
  elseif  !direction.eq('north') then
    !index = !north.sortedindices()
    !return[1] = !index[!index.size()]
    !return[2] = !index[1]
  else
    !index = !up.sortedindices()
    !return[1] = !index[!index.size()]
    !return[2] = !index[1]
  endif

  return !return

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
define method .getNearestAxis(!direction is DIRECTION )is DIRECTION
-- method to get the nearest orthogonal axis to the passed direction
-- seems to work

!d[1] = x
!d[2] = w
!d[3] = y
!d[4] = s
!d[5] = z
!d[6] = d

!r = ARRAY()
do !index index !d
  !r[!index] = !direction.angle(!d[!index])
enddo

!z = !r
!z.sort()
!index = !r.findfirst(!z[1])
return !d[!index]

endmethod
------------------------------------------------------------------------

------------------------------------------------------------------------
--
-- Method: aidArrow
--
-- Description: Creation of aid arrows
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .aidArrow(!aidNumber is REAL , !pos is POSITION, !dir is DIRECTION, !height is REAL )

 -- reverse the arrow
 !direction = !dir.opposite()
 !pv = object POINTVECTOR()
 !pv.position = !pos
 !pv.direction = !dir
 !newPv = !pv.offset(!height)
 AID ARROW NUMBER $!<aidNumber> AT $!<newPv.position> DIR $!<direction> HEIGHT $!<height> prop 0.7
 Aid text NUMBER $!<aidNumber>  '$!<this.restraintType>' AT $!<newPv.position>

endmethod
------------------------------------------------------------------------
--
-- Method: aidCylinder
--
-- Description: Creation of aid cylinders
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .aidCylinder(!aidNumber is REAL , !pos is POSITION, !dir is DIRECTION, !height is REAL )

 !direction = !dir.opposite()
 !pv = object POINTVECTOR()
 !pv.position = !pos
 !pv.direction = !dir
 !newPv = !pv.offset(!height / 2)
 AID CYLINDER NUMBER $!<aidNumber> AT $!<newPv.position> diameter 35mm ori z is $!dir height 200mm filled on

endmethod
------------------------------------------------------------------------
--
-- Method: aidBox
--
-- Description: Creation of aid box for an anchor
--
-- Method Type: Procedure
-- [#] [R/RW] [Data Type] [Description]
-- Return:
-- [Data Type] [Description]
--
------------------------------------------------------------------------
define method .aidBox(!aidNumber is REAL , !pos is POSITION, !dir is DIRECTION, !height is REAL )

   !pos = !this.owner.position.wrt(/* )
   !direction = !this.owner.adir.wrt(/* )
   !lDiam = !this.owner.loDiam
   !plane = object PLANE()
   !plane.orientation = z is $!direction
   !plane.position = !pos

   -- xy object for getting the x coordinate
   !xy = object XYPOSITION()
   !xy.x =  (!lDiam / 2)
   !xy.y = (!lDiam / 2)
   !offset = !plane.threeDPosition(!xy)
   !offsetDirection = !plane.position.direction(!offset)
   !orientation = x is $!offsetDirection and z is $!direction
   !zlength = 20
   !ylength = 1.4 * !lDiam
   !xlength = !ylength

 AID BOX NUMBER $!<aidNumber> POSITION $!<pos> ORIENTATION $!<orientation>  XLENGTH $!<xlength> YLENGTH $!<ylength> ZLENGTH $!<zlength> FILLED ON

endmethod
--------------------------------------------------------------------------
-- method to return the inline direction of the arrive/leavetube
define method .getDirection(!input is STRING)is STRING

   if !input.eq('arrive') then
      !tubeDirection = !this.tubeDirection.string()
   else
      !tubeDirection = !this.tubeDirection.opposite().string()
   endif

  if !tubeDirection.split()[1].eq('U') then
     !returnString = 'Z'
  elseif !tubeDirection.split()[1].eq('D') then
     !returnString = '-Z'
  elseif !tubeDirection.split()[1].eq('E') then
     !returnString= 'X'
  elseif !tubeDirection.split()[1].eq('W') then
     !returnString = '-X'
  elseif !tubeDirection.split()[1].eq('N') then
     !returnString = 'Y'
  else
     !returnString = '-Y'
  endif

return !returnString

endmethod
