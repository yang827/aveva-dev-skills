--
-- Author:  T.Martin
-- Created: 12/01/2012 09:01:40
--
--
-- Description:
-- PSIRestraintGroup - object for gathering and displaying PSI restraints
-- based on :nodeType :NodeStiff :NodeGap :NodeFriction UDAs with up to 4 values
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  addRestraintTexts(ARRAY)         -
--  displayAll(BOOLEAN)              -
--  displayAll(DBREF,BOOLEAN)        -
--  displayAll(DBREF,REAL,BOOLEAN)   -
--  getDisplayString()               -
--  getOutputLines()                 ARRAY
--  hideAll(BOOLEAN)                 -
--  psiRestraintGroup(DBREF)         -
--  psiRestraintGroup(PSIRESTRAINT)  -
--
define object PSIRESTRAINTGROUP


member .source           is DBREF       $* the source pipe or stress pipe
member .restraints       is ARRAY       $* a list of PSIRestraint objects
member .position         is POSITION
member .translation      is POSITION
member .rotation         is ORIENTATION
member .number           is REAL
member .typeString       is STRING
member .stiffnessString  is STRING
member .gapString        is STRING
member .frictionString   is STRING


endobject
--------------------------------------------------------------------------------------
-- constructor object which allows a pipe, branch or individual element to be passed
-- this builds a set of PSIRESTRAINT objects for each individual restraint node part
define method .psiRestraintGroup(!component is DBREF)

  if !component.type inset('PIPE','BRAN') then
    var !components coll all bran mem for $!component
    do !a values !components
    skip if !a.match('IL TUB').gt(0)
       !this.getComponentRestraints(!a.dbref())
    enddo
  else
      !this.getComponentRestraints(!component)
  endif

  !this.getDisplayString()

endmethod
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
-- method to define a single restraint object
define method .psiRestraintGroup(!restraint is PSIRESTRAINT)

   !this.restraints[1] = !restraint

endmethod

--------------------------------------------------------------------------------------
-- method to take a piping component and build a set of psi restraint objects
 define method .getComponentRestraints(!component is DBREF)

  !unusedTest = !component.:nodeType
  handle ANY
    -- component does not have the restraint attributes
    -- do nothing
    return
  endhandle
  !restraintArray = ARRAY()
  do !a from 1 to !component.:nodeType.size()
    !restraintArray[!a] = object PSIRESTRAINT(!component,!a)
  enddo

  !this.restraints.appendarray(!restraintArray)

endmethod
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
-- method to display/hide all the restraints in a restraint group
define method .displayAll(!action is BOOLEAN)

    do !a values !this.restraints
      !a.display(!action)
    enddo

endmethod
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
-- -- method to display/hide all the restraints for a specific component
-- component could be a branch or pipe
define method .displayAll(!element is DBREF,!action is BOOLEAN)

    do !a values !this.restraints
      if !a.owner.eq(!element) then
        !a.display(!action)
      endif
    enddo

endmethod
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
-- -- method to display/hide a single element of a restraint group
define method .displayAll(!element is DBREF,!index is REAL,!action is BOOLEAN)

    do !a values !this.restraints
      if !a.owner.eq(!element).and(!a.componentindex.eq(!index)) then
        !a.display(!action)
      endif
    enddo

endmethod
------------------------------------------------------------------------------------------------


------------------------------------------------------------------------------------------------
-- method to remove all display for the whole group
define method .hideAll(!action is BOOLEAN)

    do !a values !this.restraints
      !a.display(FALSE)
    enddo

endmethod
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
-- method to get all of the xml lines to add to the output file for the output xml file
define method .getOutputLines() is ARRAY

    !lines = ARRAY()
    do !a values !this.restraints
      !lines.appendarray(!a.getXMLLines()  )
    enddo

    return !lines

endmethod
------------------------------------------------------------------------------------------------

------------------------------------------------------------------------------------------------
-- method to concatenate the lines for the node data display form
define method .getDisplayString()

    !this.typeString      = ''
    !this.stiffnessString = ''
    !this.gapString       = ''
    !this.frictionString  = ''
    do !a values !this.restraints
       !return = !a.getdisplaytext()
       !this.typeString       = !this.typeString & ',' & !return[1]
       !this.stiffnessString  = !this.stiffnessString & ','  & !return[2]
       !this.gapString        = !this.gapString & ',' & !return[3]
       !this.frictionString   = !this.frictionString  & ','& !return[4]
    enddo
    !this.typeString       = !this.typeString.after(',')
    !this.stiffnessString  = !this.stiffnessString.after(',')
    !this.gapString        = !this.gapString.after(',')
    !this.frictionString   = !this.frictionString.after(',')

endmethod
------------------------------------------------------------------------------------------------
-- method to build a restraint group from the stored text elements
define method .addRestraintTexts(!split is ARRAY)

if !split[1].eq('Restraints-') then
   !number = 1
else
   !number = 7
endif
 !types  = !split[!number + 1].split()
 handle ANY
        --$P $!!error.text
 endhandle
 !stiffness = !split[!number + 2].split()
 handle ANY
        --$P $!!error.text
 endhandle
 !gap  = !split[!number + 3].split()
 handle ANY
        --$P $!!error.text
 endhandle
 !friction   = !split[!number + 4].split()
 handle ANY
        --$P $!!error.text
 endhandle
 do !a values !types
   !this.restraints.append(object PSIRestraint())
 enddo

 do !b index !this.restraints

    !this.restraints[!b].restraintType = !types[!b]
    !this.restraints[!b].stiffness = !stiffness[!b]
    handle any
    endhandle
    !this.restraints[!b].gap = !gap[!b]
    handle any
    endhandle
    !this.restraints[!b].friction = !friction[!b]
    handle any
    endhandle

 enddo

endmethod
-- end of code
