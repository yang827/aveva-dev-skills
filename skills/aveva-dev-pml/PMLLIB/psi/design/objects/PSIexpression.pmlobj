--
--   File:      PSIExpression.pmlobj
--   Type:      Object Definition
--   Group:     PSI Applications
--   Keyword:   PSI
--   Module:    design
--   Replaces:
--
-- Author:  T.Martin
-- Created: 15/12/2005 14:03
--
--
-- Description:
-- Generic Expression object to define how to get data for the interface
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  evaluate()                       ARRAY
--  evaluateName()                   ARRAY
--  extractKeyWords()                -
--  heading()                        ARRAY
--  load(STRING)                     -
--  maketext()                       -
--  psiExpression()                  -
--  psiExpression(STRING)            -
--  psiExpression(STRING,STRESSNODE) -
--  test()                           BOOLEAN
--

-- Define Object
define object PSIEXPRESSION

  member .description     is STRING
  member .expression      is STRING
  member .textString      is STRING
  member .dataType        is STRING
  member .node            is STRESSNODE
  member .type            is REAL
  -- type can be:
  -- 1 is a conventional expression in the form "description\value\function\" or expression giving 3 values split on \
  -- 2 is an exclude list in the form "component type\attribute\value\" giving 4 values split on \
  -- 3 is a naming rule   in the form "component type\ppoint\expression\index
  member .componentType     is STRING
  member .componentRule     is STRING
  member .nameRule          is STRING
  member .componentPoint    is STRING



endobject
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .psiExpression()

  !this.dataType        = 'unset'
  !this.expression      = 'unset'
  !this.textString      = 'unset'
  !this.description     = 'unset'
  !this.componentType   = 'unset'
  !this.componentRule   = 'unset'
  !this.nameRule        = 'unset'
  !this.componentPoint  = 'unset'

  !this.type = 1


endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .psiExpression(!textString is STRING)

-- !this.textString is in the format
-- |Description text\(expression)\function|

-- new type for exclusion lists
-- |type\attribute\expression\|

!this.load(!textString)

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .psiExpression(!textString is STRING,!node is STRESSNODE)

-- !this.textString is in the format
-- |Description text\(expression)\function\dataType|
  !this.node = !node
  !this.load(!textString)


endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .load(!textString is STRING)



  if !textString.split('\').size().eq(3) then
     -- its a conventional expression
     !this.type = 1
  elseif !textString.split('\').size().eq(4) then
    -- its an exclusion
    !this.type = 2
  elseif !textString.split('\').size().eq(5) then
    -- its a Name expression
    !this.type = 3
  else
     !!alert.error('error in expression')
     return
  endif

  !this.textString    = !textString
  if !this.type.neq(3) then
    !this.description   = !textString.split('\')[1]
    handle ANY
    endhandle
    !this.expression    = !textString.split('\')[2]
    handle ANY
    endhandle
    !this.dataType      = !textString.split('\')[3]
    handle ANY
    endhandle
  else
    !this.componentType    = !textString.split('\')[1]
    handle ANY
    endhandle
    !this.componentRule    = !textString.split('\')[2]
     handle ANY
    endhandle
    !this.nameRule       = !textString.split('\')[3]
     handle ANY
    endhandle
    !this.componentPoint   = !textString.split('\')[4]
     handle ANY
    endhandle
  endif

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .heading() is ARRAY

if !this.textString.split('\').size().eq(4) then
   !heading[1] = ' Type '
   !heading[2] = ' Attribute '
   !heading[3] = ' Value '
elseif !this.textString.split('\').size().eq(3) then
   !heading[1] = 'Description'
   !heading[2] = 'Expression'
   !heading[3] = 'Function / Expression'
else
   !heading[1]  = |Component Type  |
   !heading[2] =  |Component Rule  |
   !heading[3] =  |Component Point |
   !heading[4] =  |Name Attribute  |
endif

return !heading

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .maketext()

  !textString = ''
  !textString = !textString &  !this.description  & '\'
  !textString = !textString &  !this.expression   & '\'
  !textString = !textString &  !this.dataType

  !this.textString = !textString

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to evaluate the current expression
define method .evaluate()is ARRAY

  if !this.type.eq(3) then
    !return = !this.evaluateName()
    return !return
  endif
  -- call a new method to extract expression keywords
  !this.extractKeyWords()

  !return[1] = 0   $* no error encountered
  !return[2] = ''  $* no error text to return

  -- execute the expression
  !s = $!this.expression
  handle ANY
    !return[1] = 1
    !return[2] = '$!!error.text'
    !return[3] = 'error'
  elsehandle NONE
    !return[3] = !s.value().string()
  endhandle

  return !return

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to evaluate the current expression
define method .evaluateName()is ARRAY


     !return[1] = 0   $* no error encountered
     !return[2] = ''  $* no error text to return

    -- call a new method to extract expression keywords
    --!this.extractKeyWords()
    -- check that the current component is of the correct type
    if !this.node.component.type.neq( !this.componentType ) then
       !return[1] = 1
       !return[2] = 'element type ' & !this.node.component.type & ' is not a ' &  !this.componentType
       return !return
    endif
    if !this.componentRule.set() then
       !a = $!this.componentRule
       handle ANY
         !return[1] = 1
         !return[2] = !!error.text
         !return[3] = 'error in Component Rule'
         return !return
       elsehandle NONE
         if !a.not() then
           !return[1] = 1
           !return[2] = 'Component Attribute Rule Failed.'
           !return[3] = ''
           return !return
         endif
       endhandle
    endif

    -- check that the current point is the one we want to use.
    if !this.node.point.neq(!this.componentPoint.real()) then
         !return[1] = 1
         !return[2] = 'incorrect point'
         !return[3] = ''
         return !return
    endif

      --evaluate the component condition
      !x = $!this.componentRule
      handle ANY
          !return[1] = 1
         !return[2] = 'Error in component rule ' & !this.componentRule
         !return[3] = ''
         return !return
      elsehandle NONE
        if !x.not() then
         !return[1] = 1
         !return[2] = 'Did not match Rule'
         !return[3] = ''
         return !return
        endif
      endhandle

  !s = $!this.nameRule
  handle ANY
    !return[1] = 1
    !return[2] = '$!!error.text'
    !return[3] = ''
  elsehandle NONE
    !return[3] = !s
  endhandle

  return !return

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
-- method to test if the passed component matches the test
define method .test()is BOOLEAN
   -- type of component is  !this.description
   -- attribute is !this.expression
  -- condition is !this.dataType

  if !!ce.type.eq('$!this.description') then
    if !!ce.$!<this.expression>.eq(!this.dataType) then
        return TRUE
    endif
  endif
  return FALSE

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
-- this method is required to enable keywords to be used instead of freaky pml
define method .extractKeyWords()

if !this.node.unset() then
  return
endif
-- component specific adjustments nee to be inserted in front of the general ones
  if !this.node.component.type.eq('ELBO').and(!this.node.ppoint.eq(0)) then
    !this.expression = !this.expression.replace('!this.node.ppoint','1')
  endif

  if !this.node.component.type.eq('TEE').and(!this.node.ppoint.eq(0)) then
    !this.expression = !this.expression.replace('!this.node.ppoint','1')
  endif

  if !this.node.component.type.eq('OLET').and(!this.node.ppoint.eq(0)) then
    !this.expression = !this.expression.replace('!this.node.ppoint','1')
  endif

   if !this.node.component.type.eq('BRAN').and(!this.node.ppoint.eq(2)) then
    !this.expression = !this.expression.lowcase().replace('hwallt','twallt')
    !this.expression = !this.expression.lowcase().replace('hcorro','tcorro')
  endif

-- General adjustments for keywords
  if !this.expression.match('CURRENTPPOINT').gt(0)then
    !this.expression = !this.expression.replace('CURRENTPPOINT',!this.node.ppoint.string())
  endif
  if !this.expression.match('!this.node.ppoint').gt(0)then
    -- can we do some post processing to extract keywords
    !this.expression = !this.expression.replace('!this.node.ppoint',!this.node.ppoint.string())
  endif
  if !this.expression.match('CURRENTCOMPONENT').gt(0)then
    !this.expression = !this.expression.replace('CURRENTCOMPONENT',!this.node.component.string() & '.dbref()')

  endif
  if !this.node.component.type.eq('ELBO').and(!this.node.ppoint.eq(0)) then
    !this.expression = !this.expression.replace('!this.node.ppoint','1')
  endif

endmethod
--------------------------------------------------------------------------------
