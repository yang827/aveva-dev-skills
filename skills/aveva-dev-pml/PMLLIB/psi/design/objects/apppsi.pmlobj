--   Group:         Application Switching
--     Keyword:     APP
--   Module:        design
--   Replaces:
--
-- Author:          Tony Martin
-- Created:         28/09/2005 11:30
--
--
-- Description:     Object for PSI application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  menus()                          -                   Creates menus for this application
--  modifyForm()                     -                   Makes modifications to the main form
--  modifyMenus()                    -                   Runs all other menu creation methods
--  toolbars()                       -                   Creates toolbars for this application
--  utilsMenu()                      -                   Adds options to the Utilities menu
--
------------------------------------------------------------------------
define object APPPSI

endobject
-- End of object definition for apppsi

------------------------------------------------------------------------
--
-- Method:      .modifyForm()
--
-- Description: Makes modifications to the main form
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyForm()
  !this.toolbars()
endmethod
-- End of method definition for .modifyForm()
------------------------------------------------------------------------
--
-- Method:      .utilsMenu()
--
-- Description: Adds options to the Utilities menu
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .utilsMenu()
  !menu = object APPMENU('sysUtil')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', |Pipe Stress Interface...|, |!!PsiStart(1)|, 'PSI')
  !!appMenuCntrl.addMenu(!menu, 'PIPE')
endmethod
-- End of method definition for .utilsMenu()
------------------------------------------------------------------------
--
-- Method:      .toolbars()
--
-- Description: Creates toolbars for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .toolbars()

  frame .stressBar toolbar 'PSI Toolbar'
    !pixmap = !!pml.getPathname('psi.png')
    button .modifystress tooltip 'Show Pipe Stress form' pixmap "$!<pixmap>" width 16 height 16 callback '!!PsiStart(1)'
    !pixmap = !!pml.getPathname('psitools.png')
    button .modifydef at x 1 y1 tooltip 'Modify PSI Defaults' pixmap "$!<pixmap>" width 16 height 16 callback  '!!PsiStart(2)'
    !pixmap = !!pml.getPathname('psisupports.png')
    button .showrests  at xmax ymin tooltip 'Modify Restraint Attributes' pixmap "$!<pixmap>" width 16 height 16 callback  'Show !!psiEditSupportData'
  exit

  !!appTbarCntrl.addToolbar('stressBar','PIPE')

endmethod
-- End of method definition for .toolbars()

------------------------------------------------------------------------
--
-- Method:      .menus()
--
-- Description: Creates menus for this application
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .menus()

endmethod
-- End of method definition for .menus()

------------------------------------------------------------------------
--
-- Method:      .modifyMenus()
--
-- Description: Runs all other menu creation methods
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .modifyMenus()
  !this.utilsMenu()
endmethod
-- End of method definition for .modifyMenus()
