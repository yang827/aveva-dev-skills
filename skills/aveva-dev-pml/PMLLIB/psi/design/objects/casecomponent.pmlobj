-- Description:
-- Stressnode object
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  casecomponent(ARRAY,DBREF,REAL)  -
--
define object casecomponent

member .casename     is STRING
member .source       is DBREF
member .component    is DBREF
member .position     is POSITION
member .Translation  is POSITION
member .rotation     is orientation
member .number       is REAL

-- lines read from return file look like this:
--<Load>
--  <LoadCaseName>CASE 1 (OPE) W+T1+P1</LoadCaseName>
--  <Translation>-2442667.25 -1067.451 -64823828480</Translation>
--  <Rotation>13486281 2080911.125 143150.8281</Rotation>
--</Load>

endobject
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
define method .casecomponent(!lines is ARRAY,!component is DBREF,!point is REAL)

  !this.number = !point
  !this.source = !component
  --!this.position = !component.position.wrt(/* )

   !this.casename = !lines[2].after('>').before('<').split()[3] & !lines[2].after('>').before('<').split()[4]

   !translation = object POSITION('N0')
   !translation.wrt(/* )

   !translation.east  =  !lines[3].after('>').before('<').split()[1].real()
   !translation.North =  !lines[3].after('>').before('<').split()[2].real()
   !translation.up    =  !lines[3].after('>').before('<').split()[3].real()

   !this.translation = !translation
   -- ignore rotation for the time being

endmethod
--------------------------------------------------------------------------------------
