-- Created: 08/02/2006 10:17
--
--
-- Description:
-- stressComp object
-- gathers together a set of nodes relating to each component
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applyPosition(STRING)            -
--  createComponent(STRING)          -
--  deleteCase(STRING)               -
--  getCaseComps()                   -
--  getConnections()                 -
--  getFinalTube(STRESSNODE)         REAL
--  getGap()                         REAL
--  getPointDeflection(STRING,STRESSNODE) POSITION
--  getPosition()                    POSITION
--  getPositions()                   -
--  getSupports()                    -
--  insertComponent(STRING,BOOLEAN)  -
--  orientate()                      -
--  positionExtra(BOOLEAN)           -
--  setBranchDeflection(STRING)      BOOLEAN
--  setDeflection(STRING)            BOOLEAN
--  setSupportAttributes()           -
--  stressComp(ARRAY,STRING,STRING)  -
--

-- Define Object
--------------------------------------------------------------------------------
define object STRESSCOMP

member .owner         is DBREF
member .sourceComp    is DBREF
member .cref          is DBREF
member .cend          is STRING
member .actualComp    is DBREF
member .comptext      is STRING
member .nodes         is ARRAY
member .node          is STRESSNODE
member .type          is STRING
member .status        is STRING
member .caselist      is ARRAY
member .position      is POSITION
member .datum         is STRING
member .deflections   is ARRAY
member .deflected     is BOOLEAN
member .point         is REAL
member .rigidstart    is BOOLEAN
member .rigidend      is BOOLEAN
member .moved         is BOOLEAN
member .tubeLength    is REAL
member .supports      is ARRAY
member .restraintList is ARRAY

endobject
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .stressComp(!nodes is ARRAY,!comp is STRING,!type is STRING)

  !this.restraintList = ARRAY()
  !this.tubeLength = 0
  !this.rigidstart = FALSE
  !this.rigidend   = FALSE
  !this.moved = FALSE
  -- this .nodes is a list of nodes
  !this.nodes      = !nodes
  !this.comptext   = !comp
  !this.sourceComp = !comp.dbref()
  handle ANY
    !this.status = 'NEW'
    !this.type = !type
  elsehandle NONE
      if !type.eq('RIGID') then
         !this.type = !this.sourceComp.type
      else
         !this.type = !type
      endif
  endhandle
  if !this.nodes[1].rigid.eq('START') then
      !this.rigidstart = TRUE
  endif
  if !this.nodes[!this.nodes.size()].rigid.eq('END') then
      !this.rigidend = TRUE
  endif
  -- loop through the components and find out if there is a deflection
  --!this.getCaseComps()
  !this.getPositions()
  if !this.type inset('TEE','OLET','VTWA') then
     !this.getConnections()
  endif
  -- get any support elements
  !this.getSupports()
  handle ANY
   -- q var !!error
  endhandle

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .getConnections()

  !this.cref = !this.sourceComp.cref
  !this.cend = !this.sourceComp.cend

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .getCaseComps()

do !a values !this.nodes
    do !b values !a.caselist
       !array = ARRAY()
       !pos = !this.getdeflection(!b.caseName)
       !array[1] = !b
       !array[2] = !pos
       !array[3] = !a.point
       !this.deflections.append(!array)
    enddo
enddo


endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .getPointDeflection(!case is STRING,!node is STRESSNODE)is POSITION

    do !a values !node.caselist
       if !a.caseName.eq(!case) then
          return !a.translation
       endif
    enddo

    return object POSITION()

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .setDeflection(!case is STRING)is BOOLEAN


   !deflection = !this.getPointDeflection(!case,!this.node)
   if !deflection.unset() then
       return TRUE
   else
       !this.node.deflection = !deflection
   endif

   !maxOffset = !!psiDefaults.maxDeflection.val.real()
   !pos = object POSITION('n0e0u0')


   -- if the deflection is greater than the maximum allowable offset then delete the lot
   if !pos.distance(!deflection).gt(!maxOffset) then
       !!alert.error('$!case is invalid - Case Deleted' )
       !this.deleteCase(!case)
       return FALSE
   else
       --- output position to trace file
       !test = !deflection.string().position()
       -- !!ce = !caseComp.component
       -- assume that ce is the component just created
       by $!deflection
       return TRUE
   endif

   !pos = !!ce.position.string().position()

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .setBranchDeflection(!case is STRING)is BOOLEAN


   !!ce = !this.owner
   handle any
   endhandle
   !deflection = !this.getPointDeflection(!case,!this.node)
   if !deflection.unset() then
       return TRUE
   endif

   !maxOffset = !!psiDefaults.maxDeflection.val.real()
   --!return = object POSITION()
   !pos = object POSITION('n0e0u0')


     -- if the deflection is greater than the maximum allowable offset then delete the lot
   if !pos.distance(!deflection).gt(!maxOffset) then
       !!alert.error('$!case is invalid - Case Deleted' )
       !this.deleteCase(!case)
       return FALSE
   else
       if !this.point.eq(1) then
          move ph by $!deflection
       else
          move pt by $!deflection
       endif
       return TRUE
   endif



endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .createComponent(!case is STRING)


  --q var !this.status
 -- q var !this.sourceComp.string()
 -- q var !this.type
  !!ce = !this.owner
  handle any
    return
  endhandle
  new $!this.type after last mem
  handle ANY
       new $!this.type
  endhandle

  !test = !!ce.string().dbref()
  if !this.sourceComp.set() then
     copy $!this.sourceComp
     !pos = !this.sourceComp.position.wrt( /* )
     at $!pos
  else
     select
     handle any
        -- need to sort out how to direct new components
     endhandle
  endif

  !this.actualComp = !!ce

  !this.applyPosition(!case)
  !this.setSupportAttributes()

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .insertComponent(!case is STRING,!move is BOOLEAN)


  new $!this.type
  !test = !!ce.string().dbref()
  if !this.sourceComp.set() then
     copy $!this.sourceComp
     --!pos = !this.sourceComp.position.wrt( /* )
     --at $!pos
  else
     select
     handle any
        -- need to sort out how to direct new components
     endhandle
  endif

  !this.actualComp = !!ce

  if !this.position.set() then
    !this.applyPosition(!case)
    !a = !this.setDeflection(!case)
    -- go and orientate the component with the previous one
    !this.orientate()
    --- this is a fiddle to make it look better with inline components
    if !this.sourceComp.set() then
         !this.positionExtra(!move)
    endif
  else
    !this.positionExtra(!move)
  endif
  -- set the support attributes
  !this.setSupportAttributes()

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .applyPosition(!case is STRING)

  !gap = !this.getGap()

  if !this.position.set() then
   if !this.point.eq(0)  then
      at $!this.position
   elseif !this.point.eq(1) then
      POSITION pa at $!this.position
   else
      POSITION pl at $!this.position
   endif

  else
      -- the position is not set so we need to define one
      ori
      handle (61,18)
        prev
        handle ANY
        endhandle
        dir to nex
        handle ANY
         ori
        endhandle
        same
        ori
      endhandle
      if (!this.sourceComp.sequence - 1).gt(0) then
         -- there is a previous component
        !prevType = !this.sourceComp.owner.members[!this.sourceComp.sequence - 1].type
      else
        !prevType = 'BRAN'
      endif
      if !prevType.neq('FTUB') then
           --!gap = !this.sourceComp.atlen
           !gap = !this.getGap()
           --- we have a problem here because the previous component may be an ignored item and we really need to ignore it as well
           -- at this point we have no knowledge of the previous node so we don't know about its arrive tube
           if !gap.lt(1) then
                pos pa at pl of prev

                handle any
                  pos pa at ph
                endhandle
            else
              -- pos pa dist $!gap from prev
              pos pa dist $!gap from pl of prev
              handle any
                pos pa dist $!gap from ph
             endhandle
           endif
      endif
  endif

  !pos = !!ce.position.string().position()



endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .positionExtra(!moved is BOOLEAN)

      -- go and find the correct orientation
      !this.orientate()

      if !moved then
        -- the previous component has moved so we cannot adjust its position any more
        return
      endif

      !gap = !this.getGap()
      --!gap = !this.sourceComp.atlen
      if !gap.lt(1) then
        pos pa at pl of prev
        handle any
          pos pa at ph
        endhandle
      else
        $(
        pos pa dist $!gap from pl of prev
        handle any
            pos pa dist $!gap from ph
        endhandle
        $)
        -- P-15679 changed because the gap can be from a new element and it screws up the position
        thro ce
        handle ANY
        endhandle
      endif

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .orientate()

   if !!ce.ppls.findFirst(3).set() then
      !spare = 6 - !!ce.arrive - !!ce.leave
      ori and p$!spare is p$!spare of $!<this.sourceComp>
      handle any
        -- Orientate the component first
        ori
        -- Try getting the y direction of the source component and rotating so the y directions match up.
        !ydir = !this.sourceComp.ori.ydir().wrt(world)
        rotate about pl and Y is $!ydir
        handle ANY
          ori
        endhandle
      endhandle
   else
      ori
   endif

endmethod
--------------------------------------------------------------------------------


--------------------------------------------------------------------------------
define method .getPositions()

  !this.status = 'false'

  -- loop through the nodes and see if we can apply a position
  do !a values !this.nodes
    -- if it comes back from analysis then it might have moved
    --   P-8541 allow -1 ATTA and weld to take a new position.
    if !a.nodenumber.eq(-1).and(!this.type.neq('ATTA').and(!this.type.neq('WELD')).and(!this.type.neq('VALV')).and(!this.type.neq('GASK'))) then
       skip
    elseif !a.status.upcase().eq('DELETED') then
       !this.status = 'DELETED'
       skip
    endif

    if !a.newposition.distance(n0).gt(2) then
       !this.position = !a.newposition
       if !a.newposition.distance(!a.position).gt(3) then
           !this.moved = TRUE
       endif
    else
        !this.position = !a.position
    endif

    !this.point    = !a.point
    !this.node     = !a
    !this.status   = !a.status
    handle any
    endhandle
    break
  enddo

endmethod
--------------------------------------------------------------------------------

--------------------------------------------------------------------------------
define method .getPosition() is POSITION

 if !this.node.unset() then
        --$P no component
        return object POSITION()
 else
  if !this.point.eq(1) then
     !position = !this.actualComp.apos.wrt(/* )
     handle any
        !position = !this.actualComp.hpos.wrt(/* )
        handle any
          return object POSITION()
        endhandle
     endhandle
  elseif  !this.point.eq(2) then
     !position = !this.actualComp.lpos.wrt(/* )
     handle any
        !position = !this.actualComp.tpos.wrt(/* )
        handle any
          return object POSITION()
        endhandle

     endhandle
  else
     !position = !this.actualComp.position.wrt(/* )
     handle any
       return object POSITION()
     endhandle
  endif
 endif

return !position

endmethod
--------------------------------------------------------------------------------


-------------------------------------------------------------------------------------------
define method .deleteCase(!caseName is STRING)

  --!save = !!ce
  --!!alert.error('Invalid case $!caseName - Case Deleted')
  pipe
  --!!ce = !this.pipe
  var !bran  coll all bran with description eq |$!caseName| for ce
  do !a values !bran
    !!ce = !a.dbref()
    delete bran
  enddo

endmethod
-------------------------------------------------------------------------------------------
-- The current object has a component which is about to be positioned
-- if the component is preceded by one or more deleted items we need to get its arrive tube length
define method .getGap() is REAL

 !node1 = !this.nodes[1]

if defined(!node1.ignoredList[1]) then
 return !this.getFinalTube(!node1.ignoredList[1])
else
 return !node1.atubeLength
endif

endmethod

-------------------------------------------------------------------------------------------
-- recursive method to find the arrive tube length of a component
--
define method .getFinalTube(!node is STRESSNODE) is REAL
   if defined(!node.ignoredList[1]) then
      return !this.getFinalTube(!node.ignoredList[1])
   else
      return !node.atubeLength
   endif

endmethod
-------------------------------------------------------------------------------------------
-- method to collect any support values during the component reading process
--
define method .getSupports()

do !a values !this.nodes

   if !a.restraintGroup.restraints.set() then
       !this.restraintList = !a.restraintGroup.restraints
   endif
enddo

endmethod

-------------------------------------------------------------------------------------------
-- method to collect any support values during the component reading process
--
define method .setSupportAttributes()

    if !this.restraintList.size().eq(0) then
      return
    endif
  !test = !this.actualComp.:nodeType
  handle (2,204)
    return
  elsehandle NONE
     !nodeType      = ARRAY()
     !nodeStiff     = ARRAY()
     !nodeGap       = ARRAY()
     !nodeFriction  = ARRAY()

    do !a values !this.restraintList
     -- go and convert the string to a real
     !nodeType      .append(!!psiresttype(!a.restraintType) )
     handle ANY
      !nodeType      .append( 0)
     endhandle
     !nodeStiff     .append(!a.stiffness.real()       )
     !nodeGap       .append(!a.gap.real()             )
     !nodeFriction  .append(!a.friction.real()        )
    enddo
  endhandle
  !this.actualComp.:nodeType      = !nodeType
  !this.actualComp.:NodeGap       = !nodeGap
  !this.actualComp.:NodeStiff     = !nodeStiff
  !this.actualComp.:NodeFriction  = !nodeFriction

 endmethod
-- end of code
