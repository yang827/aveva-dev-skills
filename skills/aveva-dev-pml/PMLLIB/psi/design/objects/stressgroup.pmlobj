-- method to save the graphics at the current state
define method .saveDisplay()

  var !coll COLLECT ALL FROM DRAWLIST
  !this.displayList =  !coll

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- restore the previously save drawlist
define method .restoreDisplay()

  do !a values !this.displayList
     add $!a
  enddo

  !this.displayList = ARRAY()

endmethod
------------------------------------------------------------------------------

-----------------------------------------------------------------------------
define method .getRest(!case is STRING) is DBREF

   !this.lastMod = object DATETIME()
   !return = object DBREF()
   var !rest coll all rest with desc eq '$!case' for $!this.pipe
   if !rest.set() then
     !return = !rest[1].dbref()
     !func = !return.function
     if !func.split().size().eq(4).and(!func.split(':').size().eq(3)) then
        !lastMod = object DATETIME(!func.split()[4].real(),!func.split()[3],!func.split()[2].real(),!func.split(':')[1].real(),!func.split(':')[2].real())
        -- 09:20:55 4 April 2006
        handle ANY
          --$P error in date format
        elsehandle NONE
           !this.lastMod = !lastMod
        endhandle
     endif
   endif

   return !return

endmethod
-----------------------------------------------------------------------------


------------------------------------------------------------------------------
define method .buildNodes()


  !this.lastNode = 1
  !this.lastPosition = !this.pipe.owner.position.wrt(/* )
  !this.lines = ARRAY()

  -- build the lines for the file header
  !this.buildHeader()
  -- go and get the stress pipe data
  !this.getPipeData()

  -- go and read the branch information
  do !a values !this.branches
     if !a.type.eq('EQUI') then
        -- need to work out how to do equipment later
        skip
     else
         -- need to work out connectivity later
         !this.branchData(!a)
     endif
  enddo
  -- terminate the open xml pipe and terminate the file
  !this.endReport()

  -- go and write the report to file
  -- !this.writeData()

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to build the xml output for the file
define method .buildOutput()

   !this.lines = ARRAY()
   !this.saveData = ARRAY()

   !this.buildHeader()
   !this.getPipeData()

   !date = object DATETIME()
  !!ce = !this.pipe
   :PSIDATE '$!date'
     handle NONE
       savework
     elsehandle ANY
     endhandle

   !lines = !this.lines

   do !a index !this.nodeList
      if !this.nodeList[!a].componentType.eq('BRAN').and(!this.nodeList[!a].point.eq(1)) then
          !lines.appendArray(!this.nodeList[!a].branchlines)
      endif

      -- test to see if the current component support has been defined already
      !addSupport = !this.removeMultipleSupports(!a)
      -- compile the lines
      !lines.appendArray(!this.nodeList[!a].makenodelines(!addSupport))


      if !this.nodeList[!a].componentType.eq('BRAN').and(!this.nodeList[!a].point.eq(2))  then
         !lines.append(|</Branch>|)
      endif

   enddo

   !this.lines = !lines

   !this.endReport()

endmethod
------------------------------------------------------------------------------
define method .removeMultipleSupports(!index is REAL) is BOOLEAN


     -- if its the first node always output or if it dosn't have a node number then add the restraints
     if !index.eq(1).or(!this.nodeList[!index].nodeNumber.unset()) then
       return FALSE
       -- if the previous node belongs to a different component then
     endif

     if (!this.nodeList[!index - 1].component.neq(!this.nodeList[!index].component)) then
       -- this is the first point of a new component
       if !index.eq(!this.nodeList.size()) then
          return TRUE
       endif
       if !this.nodeList[!index + 1].nodeNumber.unset() then
       -- test to see if the next component is the same
          return TRUE
       endif
       -- we have got to the point where the current node number is set, the next node number is set so we need to investigate
       if !this.nodeList[!index + 1].bore.gt(!this.nodeList[!index].bore) then
          -- the next node carries the restraint
          return FALSE
       endif
     else
       -- the current component is the same as the previous component
       if !this.nodeList[!index - 1].bore.gt(!this.nodeList[!index].bore) then
          return FALSE
       else
          return TRUE
       endif
     endif

    return TRUE

endmethod

------------------------------------------------------------------------------
-- method to store the saved data for a stress run
-- now enhanced to include data for a return
define method .saveData()is BOOLEAN

   -- compile the header
   !!ce = !this.pipe
   !rest = !this.getRest('main')
   if !rest.set() then
      -- if the main restraint exists then check to see if its been renamed already
      if !rest.purpose.eq('REN') then
        if !!alert.confirm('Node Renumbering already Exists - Do You want to Overwrite It?').eq('NO') then
           return FALSE
        endif
     endif
     !purp = 'REN'
     !!ce = !rest
     delete rest
   else
      -- its not been built before
      !purp = 'STD'
   endif

   !this.writeRestData('main',!purp)

   return TRUE

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .writeRestData(!case is STRING,!purp is STRING)


--$P entering rest data
   !!ce = !this.pipe
   !date = object DATETIME()
   !name = !!ce.name & '-' & !case
   !test = !name.dbref()
   handle NONE
     !!ce = !test
     delete rest
     !!ce = !this.pipe
   elsehandle (2,109)
   endhandle
   new rest
   name $!name
   function '$!date'
   desc '$!case'
   purp $!purp

  !this.buildSaveData()
   !index = 1
   do !a index !this.saveData
     if !this.saveData[!a].split(',')[1].eq('Restraints-') then
      -- its a restraint text
        !newName = !name & '-R' & (!index - 1)
     elseif !this.saveData[!a].split(',')[1].neq('') then
      !nodeNumber = !this.saveData[!a].split(',')[1]
      !newName = !name & '-N' & !index & '-Node' & !nodeNumber
      !index = !index + 1
     else
      !newName = !name & '-N' & !index
      !index = !index + 1
     endif
      new text $!newName
      !!ce.stext = !this.saveData[!a]
   enddo

   !this.lines[3] = |<DateTime>$!date</DateTime>|
   pipe
   handle any
   endhandle

  return TRUE

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
-- method to write out the opening statements for a stress pipe
define method .buildHeader()


  !lines = ARRAY()

  !lines.append(|<?xml version="1.0" encoding="utf-8"?>|)
  !lines.append(|<PipeStressExport xmlns="http://aveva.com/pipeStress116.xsd">|)
  !date = object DATETIME()
  !lines.append(|<DateTime>$!date</DateTime>|)
  !lines.append(|<Source>AVEVA PSI</Source>|)
  !lines.append(|<Version>12.1.1</Version>|)
--


  !current = current session
  !username = !current.name
  !lines.append(|<UserName>$!username</UserName>|)
  !lines.append(|<Purpose>Preliminary stress run</Purpose>|)
  !proj = current project
  !code = !proj.code()
  !lines.append(|<ProjectName>$!code</ProjectName>|)
  !mdb = !current.mdb()
  !lines.append(| <MDBName>$!mdb</MDBName>|)
  -- where might we get title from??????????????????????????/
  !lines.append(|<TitleLine>PSI stress Output</TitleLine>|)
  !lines.append(|<!-- Configuration information -->|)
  -- now get units
  -- don't know how to do units as it depends on the units used in Caesar
  -- leave this in for the time being until the issue of units is understood better.
  !lines.appendArray(!this.getUnits())

  !this.lines = !lines


endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
define method .getUnits()is ARRAY

  !lines = ARRAY()

------------------------------------------------------------------------
-- get the pdms12.1.1 stored units which are currently in Play
-- the user presses the button and a new set get displayed
-- problem is what to do about the current stress groups in memory
------------------------------------------------------------------------

  !unitsValue = object COMUNITS()

  !bore           = !unitsValue.GETCURRENTUNITSBYPTYPE('Bore')
  !pressure       = !unitsValue.GETCURRENTUNITSBYPTYPE('Pressure')
  !temperature    = !unitsValue.GETCURRENTUNITSBYPTYPE('Temperature')
  !weight         = !unitsValue.GETCURRENTUNITSBYPTYPE('Mass')
  !force          = !unitsValue.GETCURRENTUNITSBYPTYPE('Force')
  !distance           = !unitsValue.GETCURRENTUNITSBYPTYPE('Length')
  !fluid          = !unitsValue.GETCURRENTUNITSBYPTYPE('Density')

  !lines.append(|<Units>|)
  !lines.append(|<DistanceUnits>$!distance</DistanceUnits>|)
  !lines.append(|<BoreUnits>$!bore</BoreUnits>|)
  !lines.append(|<PressureUnits>$!pressure</PressureUnits>|)
  !lines.append(|<TemperatureUnits>$!temperature</TemperatureUnits>|)
  !lines.append(|<WeightUnits>$!weight</WeightUnits>|)
  !lines.append(|<ForceUnits>$!force</ForceUnits>|)
  !lines.append(|<WallThicknessUnits>$!distance</WallThicknessUnits>|)
  !lines.append(|<FluidDensityUnits>$!fluid</FluidDensityUnits>|)

  !lines.append(|</Units>|)


  return !lines

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to get pipe header information
define method .getPipeData()

  !lines = !this.lines
  !lines.append(|<Pipe>|)
  !name = !this.stressGroupName
  !lines.append(|<FullName>$!name</FullName>|)
  !ref = !this.pipe.refno.string()
  !lines.append(|<Ref>$!ref</Ref>|)
  !this.lines = !lines


endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .branchData(!branch is DBREF)

   !lines = !this.lines


   -- the node works out if its connected to a tee or not
--  if !branch.hpos.wrt(/* ).distance(!this.lastPosition).gt(1) then
     !node = object STRESSNODE(!branch,1,!this.lastNode)
     -- !this.lastPosition = !node.position
     !this.nodeList.append(!node)
     !this.incrementNode(1)
 --  endif

   if !branch.members.size().gt(0) then
       do !a values !branch.members

         !!ce = !a
         if !this.exclude() then
            -- avoid the component in the list
            !this.nodeList.appendArray( !this.skippedComps(!a) )
            skip
         endif

         -- In line components including reducers
         if !a.type inset('FLAN','FBLI','CAP','GASK','CLOS','LJSE','WELD','UNIO','VALV','REDU','COUP','PCOM','INST','SHU','FILT','TRAP') then
            !this.nodeList.appendArray(!this.twoEndComps(!a))
         -- bends and elbows
         elseif !a.type inset('ELBO','BEND') then
             !this.nodeList.appendArray(!this.bendComps(!a) )
         -- tees and three way elements
         elseif !a.type inset('TEE','OLET','VTWA') then
              !this.nodeList.appendArray(!this.teeComps(!a))
         elseif !a.type inset('VFWA','FLEX','CROS') then
               -- no method yet create
              !this.nodeList.appendArray(!this.crossComps(!a))
         -- potential pipe supports
         elseif !a.type inset('FTUB') then
              !this.nodeList.appendArray(!this.tubeComps(!a))
         elseif !a.type inset('ATTA') then
              !this.nodeList.appendArray(!this.attaComps(!a))
         else
            !!alert.error('component type $!a.type not implemented')
         endif
     enddo
   endif
  -- the node works out if its connected to a tee or not
  !node = object STRESSNODE(!branch,2,!this.lastNode)
  !this.nodeList.append(!node)
  !this.incrementNode(1)

  !!ce = !this.pipe

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .twoEndComps(!comp is DBREF)is ARRAY

      !nodes = ARRAY()

      !node = object STRESSNODE(!comp,1,!this.lastNode)
      !nodes.append(!node)
      !this.incrementNode(1)
      !this.lastPosition = !node.position

      -- input a node
      !node = object STRESSNODE(!comp,2,!this.lastNode)
      !nodes.append(!node)
      !this.incrementNode(1)
      !this.lastPosition = !node.position

      return !nodes


endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .tubeComps(!comp is DBREF)is ARRAY

      !nodes = ARRAY()

      -- if the current position is the same as the previous one then skip node 1
      -- if !comp.apos.wrt(/* ).distance(!this.lastPosition).gt(1) then
      !node = object STRESSNODE(!comp,1,!this.lastNode)
      !nodes.append(!node)
      !this.incrementNode(1)
      --endif

      -- input a node
      !node =  object STRESSNODE(!comp,2,!this.lastNode)
      !nodes.append(!node)
      !this.incrementNode(1)
      !this.lastPosition = !node.position

      return !nodes

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
define method .bendComps(!comp is DBREF)is ARRAY

     !nodes = ARRAY()

      !node = object STRESSNODE(!comp,1,!this.lastNode)
      !nodes.append(!node)
      !this.incrementNode(1)
      !this.lastPosition = !node.position

-- for a bend only output the intersection node

       -- input a mid point node
      !node = object STRESSNODE(!comp,0,!this.lastNode)
      !nodes.append(!node)
      !this.incrementNode(1)
      !this.lastPosition = !node.position


      !node = object STRESSNODE(!comp,2,!this.lastNode)
      !nodes.append(!node)
      !this.incrementNode(1)
      !this.lastPosition = !node.position

      return !nodes

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .teeComps(!comp is DBREF)is ARRAY


   --- we need to look at where to put SIFS
   -- for a tee we need to find the spare end and detail its node
   -- This needs to be remembered and used to connect the appropriate branch members
   !nodes = ARRAY()

   -- p1
   !node = object STRESSNODE(!comp,1,!this.lastNode)
   !nodes.append(!node)
   !this.incrementNode(1)

   -- p2
   !node = object STRESSNODE(!comp,3,!this.lastNode)
   !nodes.append(!node)
   !this.incrementNode(1)


   -- p0 make a node at the intersection of the tee
   !node = object STRESSNODE(!comp,0,!this.lastNode)
   !nodes.append(!node)
   !this.incrementNode(1)

   -- p2
   !node = object STRESSNODE(!comp,2,!this.lastNode)
   !nodes.append(!node)
   !this.incrementNode(1)

   return !nodes

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .crossComps(!comp is DBREF)is ARRAY


   !nodes = ARRAY()

   !numbers[1] = 1  !numbers[2] = 2 !numbers[3] = 3 !numbers[4] = 4
   !arrive = !comp.arrive
   !leave  = !comp.leave
   !numbers[!arrive].delete()
   !numbers[!leave].delete()
   !numbers.compress()
   -- p1
   !node = object STRESSNODE(!comp,!arrive,!this.lastNode)
   !nodes.append(!node)
   !this.incrementNode(1)

   -- p3
   !node = object STRESSNODE(!comp,!leave,!this.lastNode)
   !nodes.append(!node)
   !this.incrementNode(1)


   -- p0 make a node at the intersection of the tee
   !node = object STRESSNODE(!comp,0,!this.lastNode)
   !nodes.append(!node)
   !this.incrementNode(1)

   -- p2
   !node = object STRESSNODE(!comp,!numbers[1],!this.lastNode)
   !nodes.append(!node)
   !this.incrementNode(1)

    -- p4
   !node = object STRESSNODE(!comp,!numbers[2],!this.lastNode)
   !nodes.append(!node)
   !this.incrementNode(1)

   return !nodes

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .attaComps(!comp is DBREF)is ARRAY

   !nodes = ARRAY()


   !node = object STRESSNODE(!comp,0,!this.lastNode)
   !nodes.append(!node)
   !this.incrementNode(1)
   !this.lastPosition = !node.position


   -- add restraint details
   -- by default make it a REST
   -- !lines.insert(!lines.size() - 1,|<RestraintType>REST</RestraintType>|)

   return !nodes


endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .skippedComps(!comp is DBREF)is ARRAY

  !nodes = ARRAY()
  !node = object STRESSNODE(!comp,0,!this.lastNode)
  !node.status('IGNORED')
  !nodes.append(!node)
  !this.incrementNode(1)
  !this.lastPosition = !node.position

  return !nodes

endmethod
------------------------------------------------------------------------------



------------------------------------------------------------------------------
define method .endReport()

  !lines = !this.lines

  !lines.append(|</Pipe>|)
  !lines.append(|</PipeStressExport>|)

  !this.lines = !lines

endmethod
