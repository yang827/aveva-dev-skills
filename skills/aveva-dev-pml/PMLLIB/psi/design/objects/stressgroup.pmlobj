------------------------------------------------------------------------------
define method .refreshNodeTags()

     !this.unDrawNodes()
     !this.drawNodes()

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .drawNodes()



   aid clear line 1111
   handle ANY
   endhandle
   do !a index !this.nodeList
        !this.nodeList[!a].drawnode()
        skip
        if !a eq 1 then
          !startPos = !this.nodeList[!a].position
          skip
        else
          if !a.lt(!this.nodeList.size()) then
             if !this.nodeList[!a].componentType.eq('BRAN').and(!this.nodeList[!a + 1].componentType.eq('BRAN')) then
                   !startPos = !this.nodeList[!a + 1].position
                   skip
             endif
          endif
          --aid line number 1111 $!startPos to $!this.nodeList[$!a].position linestyle dashdot
          handle ANY
          endhandle
          !startPos = !this.nodeList[!a].position
        endif
   enddo

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .unDrawNodes()

  aid clear line 1111
  handle ANY
  endhandle
  -- in order to speed up the remove from graphics process, we will clear aid text
  aid clear text all


endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .incrementNode(!increment is REAL)

   !this.lastNode = !this.lastNode + !increment

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to reduce rounding to less than 1mm for positional equivalence
define method .isSamePosition(!pos1 is POSITION, !pos2 is POSITION)is BOOLEAN

 if !pos1.distance(!pos2).lt(1) then
    return TRUE
 else
    return FALSE
 endif

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
-- method to look for nodes which should not be there
-- how does it work?
-- loop through the nodes to find Branches which are in the same place as another node
-- if the node number is duplicated elsewhere in the list then its ok
-- if its not duplicated then it can be deleted
define method .tidyBranchNodes()


   do !a index !this.nodeList
      if !this.nodeList[!a].componentType.eq('BRAN') then
         -- look for another node with the same number
         if !this.findMatching(!a).not() then
           -- if it can't find another node with the same number so its not a continuation
           -- look to see if its the head and if there is no tube after it
           -- this means there is another node at this point
           if !this.nodeList[!a].point.eq(1).and(!this.nodeList[!a].lTubeLength.lt(1)) then
               -- there is another node at this point so give it the node number
               if !this.nodeList[!a + 1].nodeNumber.unset() then
                   -- set the next node to have the current node number
                   !this.nodeList[!a + 1].nodeNumber = !this.nodeList[!a].nodeNumber
               endif
               -- unset the current node number
               !this.nodeList[!a].nodeNumber = object REAL()
           elseif   !a.eq(1) then
                skip

           endif
         endif
      endif
   enddo

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to loop through the nodes and find out if there is a matching node number
define method .findMatching(!nodeIndex is REAL) is BOOLEAN

do !a index !this.nodeList
   -- if its the same node that we are looking for then skip
   skip if !a.eq(!nodeIndex)
   if !this.nodeList[!a].nodeNumber eq !this.nodeList[!nodeIndex].nodeNumber then
     return TRUE
   endif
enddo

return FALSE

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to redefine the node numbers if they have been modified
define method .resetNumbers(!rest is DBREF)

   !deleteList = ARRAY()
   do !a values !rest.members
      !split = !a.stext.split(',')
        if !split[1].neq('').and(!split[1].neq('-1')) then
          if !this.setNewNodeNumber(!split).not() then
             !deleteList.append(!a)
          endif
        endif
   enddo

   do !b values !deleteList
      !!ce = !b
      delete text
   enddo

   -- update the tag display
   !this.refreshNodeTags()


endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to find the node with the same refno as that passed
define method .setNewNodeNumber(!split is ARRAY)is BOOLEAN

   !test = !split[2].dbref()
   handle ANY
     -- delete the rest item
     return FALSE
   endhandle

   do !a index !this.nodeList
      -- if we have found the component return true if we have found the right end
      if !this.nodeList[!a].component.eq(!test) then
        if !this.nodeList[!a].point.eq(!split[4].real()) then
          !this.nodeList[!a].nodeNumber = !split[1].real()
          return TRUE
        endif
      endif
   enddo
   return FALSE
endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .clearRest(!rest is DBREF)

     !!alert.error('Problem with Existing Node Data - Stress Pipe Will Be Renumbered')
     !!ce = !a
     delete rest
     !this.resolveGroup()

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
-- method to resolve the current nodes and builds stress comp elements
-- loops through all of the nodes read from file?????????????
define method .buildComps()

  !this.components = ARRAY()
  !unusedNodeGroup = ARRAY()

  !this.currentLine = 1
  do
      if !this.currentLine.gt(!this.nodeList.size()) then
         return
      endif
      !list = !this.nodeList.from(!this.currentLine,6)
      !newComp = !this.getComp(!list)
      if !newComp.nodes[1].nodeNumber.neq(-2) then

         !this.gettubeLength(!newComp)
      endif
      !this.components.append(!newComp)
  enddo

--now build the pipes

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to build a list of "STRESSCOMP" objects based on parsing the nodes
define method .getComp(!nodes is ARRAY) is STRESSCOMP


    -- the first component in the list is the start of a new component so its nodes get loaded
    !compNodes[1] = !nodes[1]
    !source = !nodes[1].component
    !type   = !nodes[1].componentType
    !status = !nodes[1].status
    !number = !nodes[1].nodeNumber

    -- build the first stress comp
    do !a from 2 to !nodes.size()
          if !status.upcase().eq('NEW').or(!number.eq(-2)) then
             break
          endif
          -- if the node component source is the same as the previous node then
          -- add this node to the current node list
          if !nodes[!a].component.eq(!source)then
            -- it must be the same component so it to the stress comp node list
            !compNodes.append(!nodes[!a])
          else
            break
          endif
    enddo
    !this.currentLine = !this.currentLine + !a - 1
    -- return the component
    !return = object STRESSCOMP( !compNodes,'$!source',!type)
    return !return

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
-- method to go through the list and get the arrive tube length if previous items are ignored
define method .gettubeLength(!comp is STRESSCOMP)is STRESSCOMP

-- the source component isn't set in situations where new components have been added
if !comp.sourceComp.unset() then
  return !comp
endif

if !comp.sourceComp.atlen.geq(1mm) then
   !comp.tubeLength = !comp.sourceComp.atlen
   return !comp
endif

!atlen = 0
do !a from !this.components.size() to 0 by -1
  if !a.eq(0) then
    !comp.tubeLength = !atlen
    return !comp
  endif
  if !this.components[!a].nodes[1].nodeNumber.neq(-2) then
    !comp.tubeLength = !atlen
    return !comp
  else
    !atlen = !this.components[!a].nodes[1].atubelength
  endif
enddo

endmethod
------------------------------------------------------------------------------


-------------------------------------------------------------------------------------------
-- method to read the date and time when a stressGroup was output and check if the return file
-- matches the output file format <DateTime>16:19:22 24 January 2006</DateTime>
define method .readDateTime()is BOOLEAN
  !fileTime = ''

  do !a index !this.lines
     if !this.lines[!a].match('<DateTime>').gt(0) then
       !fileTime = !this.lines[!a].after('>').before('<')
       break
     endif
  enddo

  -- read the last saved date
  !!ce = !this.pipe
  !dateString = Func of rest 1
  if !dateString.eq(!fileTime) then
     return TRUE
  else
     return FALSE
  endif


endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .readPipeDetails()

--  <Pipe>
--    <FullName>/100-B-2+</FullName>
--    <Ref>=15392/10052</Ref>
--    <Branch>

!this.pipe = object DBREF()

--!this.cases = ARRAY()
!done = FALSE
!pipeRef = object DBREF()

do !a index !this.lines
   if !this.lines[!a].match('<Pipe>').gt(0) then
     !pipeName = !this.lines[!a + 1].after('>').before('<').dbref()
     handle ANY
        --$P $!!error.text
     elsehandle NONE
        !this.pipe = !pipeName
     endhandle
     !pipeRef = !this.lines[!a + 2].after('>').before('<').dbref()
     handle ANY
        --$P $!!error.text
     elsehandle NONE
        if !pipeRef.set() then
           !this.pipe = !pipeRef
        endif
     endhandle
     break
   endif
enddo


if !this.pipe.unset() then
      !!alert.error('Original stress Pipe has Been Deleted')
      return error 1
else
  !this.init(!this.pipe)
endif

!func = !this.pipe.:PsiDate

     if !func.split().size().eq(4).and(!func.split(':').size().eq(3)) then
        !lastMod = object DATETIME(!func.split()[4].real(),!func.split()[3],!func.split()[2].real(),!func.split(':')[1].real(),!func.split(':')[2].real())
        -- 09:20:55 4 April 2006
        handle ANY
          --$P error in date format
        elsehandle NONE
        endhandle
     endif

if !this.pipeHasChanged(!lastMod) then
   return ERROR 22
endif


endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .readLoadCases() is ARRAY

!caseNames = ARRAY()
!done = FALSE

do !a index !this.lines
   if !this.lines[!a].match('<LoadCaseList>').gt(0) then
     do !b from !a
        if !this.lines[!b].match('<LoadCaseNames>').gt( 0 ) then
          !caseText = !this.lines[!b].after('>').before('<').split()
          !caseNames.append(!caseText[3] & !caseText[4])
        elseif !this.lines[!b].match('</LoadCaseList>').gt(0) then
          !done = TRUE
          break
       endif
     enddo
    endif
    if !done then
       break
    endif
enddo

return !caseNames

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to read all load cases within a stress pipe
define method .readExisting()

   !this.caseGroups = ARRAY()
   !this.caseNames  = ARRAY()
   var !bran coll all bran for $!this.pipe
   if !bran.size().gt(0)then
      var !caseNames eval desc for all from !bran
      !caseNames.unique()
      !this.caseNames = !caseNames
      !branches = ARRAY()
      do !a values !caseNames
        !this.caseGroups.append(object stressGroup(!this.pipe,!a))
      enddo
   endif


endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to build the branches for each of the load cases
define method .buildBranches()


 !branchSize = !this.pipe.:PsiSystem.size()
 !ce = !!ce

 !!ce = !this.pipe
 !w = mcount bran

 if !w.gt(0) then
   if !!alert.confirm('Load Cases Already Exist For This Stress Pipe - Do you want to Delete Them?').eq('YES') then
     !this.deleteOldBran()
   else
     !!ce = !ce
     return error 17
   endif
 endif

 do !a values !this.caseNames
   !current = !this.pipe.name & '-' & !a
   !branches = ARRAY()
   do !b from 1 to !branchSize
      !branName = !current & '/B' & !b
      !!ce = !this.pipe
      last mem
      handle (2,113)
      endhandle
      new bran $!branName
      handle (41,12)
        delete bran
       new bran $!branName
      endhandle
      !!ce.:PsiSystem[1] = !this.pipe.:PsiSystem[!b]
      !this.copyBranch()
      !!ce.description = !a
   enddo
 enddo

 !!ce = !ce

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to delete the existing stress group branches
define method .deleteOldBran()

 !!ce = !this.pipe
 do !a values !!ce.members
   if !a.type.eq('BRAN') then
       !!ce = !a
       delete branch
   endif
 enddo


endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method for copying the branch heads and tails (:PsiSystem[1] contains the name of the source branch
define method .copyBranch()

   !save = !!ce.:PsiSystem
   copy like $!!ce.:PsiSystem[1]
   !!ce.:PsiSystem = !save

   !!ce.hpos  = !!ce.:PsiSystem[1].hpos
   !!ce.hdir  = !!ce.:PsiSystem[1].hdir
   !!ce.hconn = !!ce.:PsiSystem[1].hconn
   !!ce.hbor  = !!ce.:PsiSystem[1].hbore
   !!ce.tpos  = !!ce.:PsiSystem[1].tpos
   !!ce.tdir  = !!ce.:PsiSystem[1].tdir
   !!ce.tconn = !!ce.:PsiSystem[1].tconn
   !!ce.tbor  = !!ce.:PsiSystem[1].tbor
   !name = !!ce.name

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to read the stored nodes from the file lines
define method .readNextNode()is STRESSNODE

  !lines = ARRAY()

  !return = object STRESSNODE()
  do
     if !this.lines[!this.currentLine].match('<Node>').gt(0) then
       break
     endif
     !this.currentLine = !this.currentLine + 1
  enddo

  !lines.append(!this.lines[!this.currentLine].trim('lr'))
  !this.currentLine = !this.currentLine + 1
  do
      !lines.append(!this.lines[!this.currentLine].trim('lr'))
      if !this.lines[!this.currentLine].match('</Node>').gt(0) then
         break
      endif
      !this.currentLine = !this.currentLine + 1
  enddo

  !return = object STRESSNODE(!lines)
  handle ANY
        --q var !!error
  endhandle

  !this.currentLine = !this.currentLine + 1
  return !return

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- this method is the start of the rebuilding process having read in a set of nodes from the
-- return file
define method .parseBranches(!caseName is STRING) is BOOLEAN

-- we have a list of branches and we also have a list of branch components

!!ce = !this.pipe
!return = TRUE
-- do !a index !this.caseNames
 !deleted = FALSE
--$P case name is $!this.caseNames[$!a]
-- identify the branches associated with the case list
--   var !branches coll all bran with match(description,'$!this.caseNames[$!a]') gt 0 for $!this.pipe
   var !branches coll all bran with match(description,'$!caseName') gt 0 for $!this.pipe
   var !connections eval :PsiSystem[1]for all from !branches
  --  var !connections eval (refno of :PsiSystem[1]) for all from !branches
   -- run through all the components and decide which branch the components will go in
   do !comp index !this.components

     if !this.components[!comp].type.eq('BRAN') then
        -- is the component type is branch find the first branch in the group
        !ref = !connections.findFirst(!this.components[!comp].sourceComp.name)
       --$P !ref = !connections.findFirst($!this.components[$!comp].sourceComp.name)
        !this.components[!comp].owner = !branches[!ref].dbref()
        handle ANY
           !!alert.error('Stress Group Return Branches do Not match the Original Output - Read Aborted')
           -- I think it errors because the branch has been deleted
           -- if there is an error   the case is abandoned
           !deleted = TRUE
           break
        endhandle
        !currentOwner = !branches[!ref].dbref()
         !this.components[!comp].actualComp = !currentOwner
        --$P current owner is $!currentOwner

     else
        !this.components[!comp].owner =  !currentOwner
     endif
   enddo

   if !deleted.not() then
      if !this.parseComponents(!branches,!caseName) then
          return TRUE
      else
          return FALSE
      endif
      --$P case name is $!caseName
   endif


endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- return process after reading from a return xml file
define method .parseComponents(!branches is ARRAY,!caseName is STRING) is BOOLEAN
-- we are passed a set of strings representing the refs of the branches
-- we now need to loop through each node
   forwards


   !this.saveData = ARRAY()
   !this.rigids = ARRAY()
   -- this.components is a list of case components
   do !comp index !this.components

       -- this is the stress comp we are dealing with it can have one or more nodes
       if !this.components[!comp].type.eq('BRAN') then
          if !this.components[!comp].setbranchdeflection(!caseName).not() then
             return FALSE
          endif
          skip
       endif

       -- go and build the component
       if !this.components[!comp].type inset('ELBO','TEE','BEND') then
           if !this.components[!comp].status.upcase().eq('DELETED') then
              skip
           else
              !this.components[!comp].createcomponent(!caseName)
           endif
       else
          skip
       endif

         -- go and move the component by its deflection
         if !this.components[!comp].setdeflection(!caseName).not() then
            -- could not find a deflection
            --return FALSE
         else
         -- the deflection was successful
         -- set the node deflection for display later
           !this.nodeList[!this.components[!comp].node.number].deflection = !this.components[!comp].node.deflection
           handle any
            -- q var  !this.nodeList[!this.components[!comp].node.number].deflection
           endhandle
         endif


       if !this.components[!comp].status.upcase().eq('NEW') then

          if !!ce.type inset('ELBO','BEND') then
             ori
             !pos = !this.components[!comp + 1].position
             dir tow $!pos
             handle ANY
               dir tow $!pos $* doing this twice is necessary in certain cases
               handle ANY
                 dir to nex
                 handle ANY
                    ori
                 endhandle
               endhandle
             endhandle
         endif
      endif


       if !this.components[!comp].rigidstart then
           !this.rigidItems = ARRAY()
           !this.rigidItems.append(!!ce)
           !this.rigidActive = TRUE
       elseif !this.components[!comp].rigidend then
           !this.rigidItems.append(!!ce)
           !!save = !!ce
            -- realign the rigid We hope!
           --!

            !this.rigids.append(!this.rigidItems)
            !this.rigidItems = ARRAY()
       endif
       if !this.rigidActive then
            !this.rigidItems.append(!!ce)
       endif
    -- end of creation loop
    enddo

    -- now go and sort out the tee connections
    !this.connectBran(!caseName)

    -- now go and align the elbows as good as we can
    !this.alignBasic()


    -- now go and reconnect the tee connections
    !this.connectBran(!caseName)

    -- now go and tidy the elbows once more
    !this.alignBasic()

    if undefined(!!debug) then
    -- now we have a basic layout we can go and build the remaining components in line.
    !this.buildRemaining(!caseName)
    endif


   -- hopefully write the nodes out to a new rest
   --!this.writeRestData(!caseName,'CASE')
   do !a values !this.components
      !node = !a.node
      if !node.unset() then
        skip
      else
        !seq = !a.node.number
        !pos = !a.getposition()
        if !pos.unset() then
           skip
        endif
      endif
      !this.nodeList[!seq].position = !pos
      !this.nodeList[!seq].component= !a.actualComp
      handle any
      endhandle
   enddo

   -- no longer required because the atta attributes are now read earlier.
   -- !this.setAtta()

   !this.complete = TRUE
   return TRUE

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to build the remaining components after the basic layout has been defined
define method .buildRemaining(!caseName is STRING)


  !moved = FALSE
  do !comp index !this.components

     if !this.components[!comp].status.upcase().eq('DELETED') then
        if !this.components[!comp].type.neq('BRAN') then
           !moved = FALSE
           skip
        endif
     endif
     if !this.components[!comp].actualComp.set() then
        !!ce = !this.components[!comp].actualComp
        if !this.components[!comp].moved then
          !moved = TRUE
        else
          !moved = FALSE
        endif
        skip
     else
       !this.components[!comp].insertcomponent(!caseName,!moved)
     endif
  enddo


endmethod
-------------------------------------------------------------------------------------------


-------------------------------------------------------------------------------------------
-- set the alignment of elbows and tees
define method .alignBasic()

   -- this.components is a list of case components
   do !comp index !this.components
   !line1 = object LINE()
   !line2 = object LINE()

       -- this is the stress comp we are dealing with it can have one or more nodes
       !stressComp = !this.components[!comp]
       if !stressComp.type.eq('BRAN') then
          skip
       endif

       -- go and align the component
       if !stressComp.type inset('ELBO','TEE') then
             !!ce = !stressComp.actualComp
             handle any
                -- the component has been deleted
                skip
             endhandle

             -- fiddle to get it to output in the trace file
             !test = !!ce.string().dbref()

             !line1.startposition = !!ce.position.wrt(/* )
             prev
             handle (2,113)
                !line1.endposition = !!ce.owner.hpos.wrt(/* )
             elsehandle NONE
                !line1.endposition = !!ce.position.wrt(/* )
                 same
             endhandle

             !line2.startposition = !!ce.position.wrt(/* )
             next
             handle (2,113)
                !line2.endposition = !!ce.owner.tpos.wrt(/* )
             elsehandle NONE
                 !line2.endposition = !!ce.position.wrt(/* )
                 same
             endhandle
             -- find the next elbo
             !adir = !line1.direction().wrt(/* )
             handle any
                QUERY VAR !!error
                skip
             endhandle
             !ldir = !line2.direction().wrt(/* )
             !unusedAngle = !!ce.angle
             --ori pa is $!adir and pl is $!ldir
              dir to $!line2.endposition
             handle any
                ori pa is $!adir and pl is $!ldir
                handle any
                endhandle
             endhandle
             --angle $!unusedAngle
       endif
  enddo

  !this.alignTees()



endmethod
-------------------------------------------------------------------------------------------

$(
-------------------------------------------------------------------------------------------
define method .alignElbows(!comp is STRESSCOMP)
--$P align elbows
  !!ce = !comp.actualComp
  !line1 = object LINE()
  !line2 = object LINE()

               -- fiddle to get it to output in the trace file
             !test = !!ce.string().dbref()

      -- do the arrive
      !line1.startposition = !!ce.position.wrt(/* )
      prev
      handle (2,113)
         !line1.endposition = !!ce.owner.hpos.wrt(/* )
      elsehandle NONE
         --if !!ce.type.eq('TEE')or(!!ce.type.eq('VTWA')) then
           --if !!ce.arrive.eq(3).or!!ce.leave.eq(3) then
             !line1.endposition = !!ce.position.wrt(/* )
             same
      endhandle

      !line2.startposition = !!ce.position.wrt(/* )
      next elbo
      handle (2,113)
         !line2.endposition = !!ce.owner.tpos.wrt(/* )
      elsehandle NONE
          !line2.endposition = !!ce.position.wrt(/* )
          same
      endhandle
      -- find the next elbo
      !adir = !line1.direction().wrt(/* )
      !ldir = !line2.direction().wrt(/* )
      !unusedAngle = !!ce.angle
      --ori pa is $!adir and pl is $!ldir
      dir to $!line2.endposition
      handle any
      endhandle
      --angle $!unusedAngle
       endif
  enddo

endmethod
-------------------------------------------------------------------------------------------
$)

-------------------------------------------------------------------------------------------
define method .alignTees()


  !line1 = object LINE()
  !line2 = object LINE()

do !comp values !this.components

    if !comp.actualComp.set() then
        !!ce= !comp.actualComp
    else
        skip
    endif
    if !!ce.type inset('TEE','VTWA') then
      !spare = 6 - !!ce.arrive - !!ce.leave
      if !!ce.arrive.eq(3) then
         ori and pl is $!!ce.ldir
         handle any
         --$P error in tee ORIENTATION
         --$P ori and pl is $!!ce.ldir
          -- it will be the same ori as the original
         endhandle
      elseif !!ce.leave.eq(3) then
          !line2.startposition = !!ce.position.wrt(/* )
         next
         handle (2,113)
            !line2.endposition = !!ce.owner.tpos.wrt(/* )
         elsehandle NONE
             !line2.endposition = !!ce.position.wrt(/* )
             same
         endhandle
         !dir = !line2.direction().wrt(/* )
         ori and p3 is $!dir
         handle any
         --$P error in tee ORIENTATION
         --$P ori and p3 is $!line2.direction().wrt(/* )
          -- it will be the same ori as the original
         endhandle
      else
         !line2.startposition = !!ce.position.wrt(/* )
         next
         handle (2,113)
            !line2.endposition = !!ce.owner.tpos.wrt(/* )
         elsehandle NONE
             !line2.endposition = !!ce.position.wrt(/* )
             same
         endhandle
         !dir =   !line2.direction().wrt(/* )
         ori pl is $!dir and p3 is $!!ce.pdir[3]
         handle any
             --$P error in tee ORIENTATION
             --$P ori pl is $!dir and p3 is $!!ce.pdir[3]
             -- it will be the same ori as the original
         endhandle
      endif
    endif

enddo


endmethod
-------------------------------------------------------------------------------------------


-------------------------------------------------------------------------------------------
define method .connectBran(!caseName is STRING)


   var !branches coll all bran with match(description,'$!caseName') gt 0 for $!this.pipe
   var !connections eval :PsiSystem[1]for all from !branches
   do !comp values !this.components

     if !comp.type.eq('TEE') then
        -- if the component type is a tee find the branch its connected to
        if !comp.cref.unset() then
         skip
        endif
        !ref = !connections.findFirst(!comp.cref.name)
        !connectBran = !branches[!ref].dbref()
        handle ANY
           -- I think it errors because the branch has been deleted
           -- if there is an error   the case is abandoned
           skip
        endhandle
        !!ce = !connectBran
        if !comp.cend.eq('HEAD') then
            !end = 'PH'
            !eRef = 'HREF'
        elseif !comp.cend.eq('TAIL') then
            !end = 'PT'
            !eRef = 'TREF'
        else
            !end =  !comp.cend
        endif
        !spare = 6 - !comp.actualComp.arrive - !comp.actualComp.leave
       --$P  POSITION $!end at p$!spare of $!comp.actualComp
       POSITION $!end at p$!spare of $!comp.actualComp
       handle any
       --$P $!!error.text
        skip
       endhandle
       --set href tref
       $!eRef $!comp.actualComp
       !!ce = !comp.actualComp
       cref same
     endif
   enddo



endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .setNodeComps(!caseName is STRING)

   do !a index !this.nodeList
      if !this.nodeList[!a].componentType.eq('BRAN') then
        !this.nodeList[!a].component = !this.getNewBran(!this.nodeList[!a].component)
        skip
      endif
      if !this.nodeList[!a].status.eq('New') then
        skip
      endif
      !test = !this.branches.findFirst(!this.nodeList[!a].component.owner)
      handle ANY
      -- q var !!error
      --  q var !this.branches
      --  q var !this.nodeList[!a]
        skip
      endhandle
      if !test.unset() then
        !this.nodeList[!a].component = !this.nodeList[!a - 1].component
        handle ANY
        endhandle
      endif
   enddo

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .getNewBran(!bran is DBREF)is DBREF

do !a values !this.branches
   !!ce = !a
   if !a.:PsiSystem.findFirst(!bran).set() then
       return !a
   endif
enddo

return object DBREF()


endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .buildSaveData()

   !this.saveData = ARRAY()
   do !a values !this.nodeList
     !this.saveData.appendArray(!a.compilesaveData())
   enddo

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
-- method to loop through the items which have moved and align them
define method .alignComponents()


-- find out if the lstu is drawn dotted
do !bran values !this.branches
  Check $!bran !names !errors
  handle ANY
   --$P $!!ERROR.text
    return
  endhandle

  --q var !names q var !errors
  do !i index !names
     if !errors[!i].match('39').gt(0).and(!i.gt(0)) then
          !this.fitTube(!names[!i].dbref(),39)
     endif
     if !errors[!i].match('51').gt(0).and(!i.gt(0)) then
          !this.fitTube(!names[!i].dbref(),51)
     endif
     if !errors[!i].match('92').gt(0).and(!i.gt(0)) then
          !this.fitTube(!names[!i].dbref(),92)
     endif

  enddo
enddo

endmethod
-------------------------------------------------------------------------------------------


-------------------------------------------------------------------------------------------
define method .fitTube(!element is DBREF,!message is REAL)

 -- fiddle to get it to output in the trace file
       !test = !element.string().dbref()
  if !!ce.type.eq('ATTA') then
    --return
  endif
      -- fiddle to get it to output in the trace file
       !test = !!ce.string().dbref()

  forw
  if !element.type.eq('BRAN') then
      return
  endif
   !save = !!ce
   !bore = !element.lbore
   !!ce = !element
   if !message.eq(39).or(!message.eq(92)) then
     prev
     handle ANY
        -- prev means we are at the branch head
        head
        !lstu = !!ce.hstu
     elsehandle NONE
        !lstu = !!ce.lstu
     endhandle
   elseif   !message.eq(51) then
        !lstu = !!ce.lstu
   endif
   !ltlen = !!ce.ltlen
   if !ltlen.lt(5) then
     return
   endif
   new bend
   desp $!bore
   spref /PSI-SPEC/VARI
   lstu $!lstu
   fconn
   if !message.eq(39).or(!message.eq(92)) then
      dir to pa of next
      handle (61,47)(61,19)(61,34)
         angle 0
         fconn
      endhandle
      nex
   else
     dir to pt
     handle (61,47)(61,19)(61,34)
         angle 0
         fconn
     endhandle
     tail
   endif
   back
   new bend
   desp $!bore
   spref /PSI-SPEC/VARI
   lstu $!lstu
   flip
   fconn

   dir to next
   handle (61,47)(61,19)
     -- q var !!error
      angle 0
      fconn
   elsehandle (2,113)(61,34)

      dir to tail
       handle (61,47)(61,19)
        angle 0
        fconn
      endhandle
   endhandle

   forw
   !!ce = !save


endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .deleteCase(!caseName is STRING)

  !save = !!ce
  !!alert.error('Invalid case $!caseName - Case Deleted')
  !!ce = !this.pipe
  var !bran  coll all bran with description eq |$!caseName| for ce
  do !a values !bran
    !!ce = !a.dbref()
    delete bran
  enddo
  !this.saveData = ARRAY()

  !!ce = !save
  handle ANY
  endhandle

endmethod
-------------------------------------------------------------------------------------------

-------------------------------------------------------------------------------------------
define method .deleteSelCase(!caseName is STRING)

-- Delete selected load case
  !save = !!ce
  !!ce = !this.pipe
  var !bran  coll all bran with description eq |$!caseName| for ce
  do !a values !bran
    !!ce = !a.dbref()
    delete bran
  enddo
  !this.saveData = ARRAY()

  !!ce = !save
  handle ANY
  endhandle

  !!ce = !this.pipe

  --Delete case restraint
  var !rest coll all rest with description eq |$!caseName| for ce
   do !i values !rest
     !!ce = !i.dbref()
    delete rest
  enddo


endmethod

-------------------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to find any excluded items from the piping components
-- returns true if the component is to be ignored
define method .exclude()is BOOLEAN

   if !!psiDefaults.ignoredArray.size().eq(0) then
        return FALSE
   endif

   do !a values !!psiDefaults.ignoredArray
      !exp = object PSIEXPRESSION(!a)
      if !exp.test() then
        return TRUE
      endif
   enddo

   return FALSE

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .contCheck() is BOOLEAN

!cont = ARRAY()


if (!this.branches.size().eq(1)) then
  return TRUE
endif


do !a index !this.branches
   var !tees coll all (tee olet vtwa) for $!this.branches[$!a]
   var !cref eval cref for all from !tees
   !cref.append (!this.branches[!a].href.string())
   !cref.append (!this.branches[!a].tref.string())
   do !b values !cref
      !test = !b.dbref()
      handle ANY
        skip
      endhandle
      !match = !this.branches.findFirst(!test)
      if !match.set() then
        !cont.append(TRUE)
        skip
      endif
   enddo
enddo


if !cont.size().lt(!this.branches.size()) then
      return FALSE
else
      return TRUE
endif


endmethod
------------------------------------------------------------------------------
-- sets the tube length if the current item is ignored
define method .resetTubeLengths(!node is REAL)
-- !node is the current node number

!length = !this.nodeList[!node].lTubeLength
handle ANY
   !this.nodeList[!node - 1].lTubeLength = 0
   return
endhandle
if !length.geq(1).and(!node.gt(1)) then
   if !this.nodeList[!node - 1].lTubeLength.lt(1) then
      !this.nodeList[!node - 1].lTubeLength = !this.nodeList[!node].lTubeLength
   endif
endif

endmethod

-----------------------------------------------------------------------------
