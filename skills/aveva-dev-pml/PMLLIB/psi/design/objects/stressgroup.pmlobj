------------------------------------------------------------------------------
-- method to highlight the selected group
define method .highlightGroup(!onOff is BOOLEAN)

 do !a values !this.branches
   !this.highlight(!a,!onOff)
 enddo
 $(
  -- not implemented
  do !a values !this.equipment
   !this.highlight(!a,!onOff)
 enddo
 $)

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
-- method for adding/removing highlights to the passed element
define method .highlight(!item is DBREF,!addRem is BOOLEAN)

  if !item.badRef() then
     return
  endif

  rem $!item
  add $!item
  if !addRem then
     if !item.type.eq('BRAN') or !item.type.eq('EQUI') then
       enhance $!item colour $!this.highlightColour
     else
       enhance owner of $!item colour $!this.highlightColour
     endif
  else
     if !item.type.eq('BRAN') or !item.type.eq('EQUI') then
       unenhance $!item
     else
       unenhance owner of $!item
     endif
  endif

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .drawGroup(!col is REAL,!trans is REAL)

  if !trans eq -1 then
    do !a values !this.branches
       if !a.badRef() then
         skip
       endif
         rem $!a
    enddo
  else
    autocol off
    do !a values !this.branches
       if !a.badRef() then
         skip
       endif
       rem $!a
       add $!a col $!col transl $!trans edges on
    enddo
    autocol on
  endif

endmethod
