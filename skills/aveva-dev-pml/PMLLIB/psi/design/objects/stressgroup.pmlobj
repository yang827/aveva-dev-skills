-- Define Object
define object STRESSGROUP

  member .pipe                  is DBREF
  member .stressGroupName       is STRING
  member .branches              is ARRAY
  member .equipment             is ARRAY
  member .highlightColour       is REAL
  member .returnColour          is REAL
  member .displayList           is ARRAY
  member .lines                 is ARRAY
  member .increment             is REAL
  member .lastNode              is REAL
  member .lastPosition          is POSITION
  member .nodeList              is ARRAY
  member .currentNode           is STRESSNODE
  member .rigidWeight           is REAL
  member .rigidActive           is BOOLEAN
  member .parsed                is BOOLEAN
  member .complete              is BOOLEAN
  member .currentWallThickness  is REAL
  member .units                 is STRING
  member .saveData              is ARRAY
  member .rigidItems            is ARRAY
  member .currentLine           is REAL
  member .caseNames             is ARRAY
  member .caseLists             is ARRAY
  member .components            is ARRAY
  member .caseGroups            is ARRAY
  member .lastMod               is DATETIME
  member .stage                 is REAL
  member .rigids                is ARRAY
  member .varName               is STRING

endobject
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- constructor method to build the basics from the main rest New constructor
-- for speeding up the starting process
define method .stressGroup(!case is STRING,!pipe is DBREF)
--$P constructor Case/pipe called

  -- initialise the common variables
  !this.init(!pipe)

  !this.parsed = FALSE
  !caseRest = !this.getRest(!case)

  if !caseRest.set() then
    if !this.pipeHasChanged(!this.lastMod) then
      if !!alert.confirm('Pipe has changed since the stress group was last updated. Do you want to rebuild?').eq('YES') then
         !!ce = !caseRest
         delete rest
         !this.resolveGroup()
         !this.complete = TRUE
      else
         !this.readCaseRest(!caseRest)
         !this.complete = FALSE
      endif
    else
       -- now we have a pdms restraint so we need to build the nodes
       !this.readCaseRest(!caseRest)
       !this.complete = FALSE
    endif
  endif

 -- !this.showGroup()
 -- !this.highlightGroup(TRUE)
  !this.refreshNodeTags()


endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .stressGroup(!pipe is DBREF,!dummyStage is REAL)

--$P new constructor called
-- initialise the common variables
 !this.init(!pipe)

 !this.stage = 1

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .stage2()

 -- now we need to read the case branches
  !caseRest = !this.getRest('main')
  if !caseRest.set() then
     !this.readCaseRest(!caseRest)
  else
     -- build the group to the point of having nodes
     !this.resolveGroup()
  endif
  !this.stage = 2
  !this.readExisting()

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
-- constructor method to build a stress group from a pipe
-- this method builds everything
-- called by the refresh methods
define method .stressGroup(!pipe is DBREF)
 --$P constructor (pipe) called

 -- initialise the common variables
  !this.init(!pipe)

  if !this.branches.size().eq(0) then
    return
  endif

  -- now we need to read the case branches
  !rest = !this.getRest('main')
  if !rest.set() then
     !!ce = !rest
     --delete rest
  endif

   -- go and get any load case groups
  !this.readExisting()

   -- go and build a node for every ppoint
  !this.buildNodes()
  -- go and get the appropriate connection references
  !this.resolveRefs()
  -- set all the node numbers
  !this.parseNodes()
  -- new method for adding node names from components
  !this.parseNodeNames()

  -- set the group parsed attribute
  !this.parsed = TRUE

  -- due to the way the parsing takes place, it is possible to have
  -- branch elements which are not connected to anything but still
  -- have nodes. The next routine scans for unconnected branch nodes
  -- and removes the node number
  -- this may result in small gaps in the numbering
  !this.tidyBranchNodes()

  !this.complete = TRUE


endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- constructor method to build a stress group partially from a pipe
-- !show is a boolean to rebuild the whole thing or partial
-- when the PSI system form is shown the groups are loaded with a FALSE parameter
define method .stressGroup(!pipe is DBREF,!show is BOOLEAN)
--$P constructor C(pipe/BOOLEAN) called

   -- initialise the common variables
 !this.init(!pipe)

   -- go and get any load case groups
  !this.readExisting()

  if !show then
     !this.resolveGroup()
  endif

  !this.parsed = FALSE
  !this.complete = FALSE
  -- don't need to do anything with stored nodes until its been parsed

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
-- method to build a stressGroup based on cases
define method .stressGroup(!pipe is DBREF,!case is STRING)
--$P constructor (pipe/Case) called

  !this.init(!pipe)

  var !branches coll all bran with desc eq '$!case' for $!this.pipe
  !list = ARRAY()

  do !a values !branches
    !list.append(!a.dbref())
  enddo

  !this.branches = !list

  -- now we need to read the case branches
  !caseRest = !this.getRest(!case)
  if !caseRest.set() then
     !this.readCaseRest(!caseRest)
  endif

  -- set the complete flag so that it does not go and get node details
  !this.complete = TRUE


endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- constructor method for reading the return file and saving all the data
define method .stressGroup(!returnFile is FILE)
--$P constructor (file) called


  !lines = !returnFile.readfile()
  !this.lines = !lines
  !this.readPipeDetails()
  handle 1
     return error 1
  elsehandle 22
     if !!alert.confirm('The Pipe attributes have changed since the last import - Do you want to import the Stress File?').eq('NO') then
           return
     endif
   -- if we get an error from the read pipe method then we need to ask
   -- the user if he wants to continue
   --  return
  endhandle



-- After checking with <tm> Do NOT uncomment the CODE below
--$*************************************************************
-- need to uncomment this before release
$(
  if !this.readDateTime().not() then
     !!alert.error('Return File Date does not Match Source File ')
     return
  endif
 $)
--$************************************************************


  !this.caseNames = !this.readLoadCases()
  -- read all of the load case names from the xml data
  if !this.caseNames.size().eq(0) then
     -- if there are no load cases we can't proceed
     !!alert.error('No Load Cases Defined')
     return
  endif

  !this.caseLists = ARRAY()

  -- build the branches based on the original branches and the case names
  !this.buildBranches()
  handle ANY
    !!alert.warning('Read File Aborted')
    return
  endhandle

  !this.currentLine = 1
  -- start at line one of the xml file and build a set of stress nodes based on their content
  do
     !node = !this.readNextNode()
     handle ANY
         --$P $!!error.text
        break
     endhandle
     if !node.status.eq('New') then
       !node.lTubeLength = 2
       -- so that the node is not included in the ignored list
     endif
     !node.number = !this.nodeList.size() + 1
     -- the following bit is supposed to add the previous node to the current nodes ignored list if:
     -- 1) the previous node is ignored (node number = -2)
     -- 2) the current node aTube lt(1) or the previous nodes lTube lt(1)
     if !node.number.gt(1) then
       -- if the previous node is ignored
       if !this.nodeList[!node.number - 1].nodeNumber.eq(-2).and(!this.nodeList[!node.number - 1].lTubeLength.lt(1)) then
          -- q var !this.nodeList[!node.number - 1]
          -- the component is ignored so add a copy of the ignored node to the
          -- only add it to the list if the leave tube length is unset
           !node.ignoredList.append(!this.nodeList[!node.number - 1])
       endif
     endif
     !comp = !node.actualcomponent
     !this.nodeList.append(!node)
  enddo

  -- at this point we have loaded all of the nodes from file and we have one stress group
  -- with just nodes and a list of case names.

  -- we have a node list with numbers
  -- now go and resolve the nodes
  !this.varName = 'Main Group'
  do !aCase values !this.caseNames
     !group = !this
     var !bran  coll all bran with description eq |$!aCase| for $!this.pipe
     !branches = ARRAY()
     do !a values !bran
        !branches.append(!a.dbref())
     enddo
     !group.branches = !branches
     !group.varName = !aCase
     !group.caseGroups = ARRAY()
     !this.caseGroups.append(!group)
  enddo


  do !a index !this.caseGroups
    -- build a list of case components
    !this.caseGroups[!a].buildComps()
    !caseName = !this.caseNames[!a]
    -- go through the branches and build the components
    if !this.caseGroups[!a].parseBranches(!caseName).not() then
      -- could we do something to delete the case group
      skip
    endif
    -- finally align the components
    !this.caseGroups[!a].alignComponents()

    !this.caseGroups[!a].complete = TRUE
    --$P writing node
    !this.caseGroups[!a].writeRestData(!caseName,'CASE')
  enddo
  -- now go and look through the branches build the components and all sorts

  !this.complete = TRUE

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .pipeHasChanged(!date is DATETIME)is BOOLEAN

      do !a values !this.branches
        !func = !a.lastMod.hier
        !lastMod = object DATETIME(!func)
        if !lastMod.gt(!date) then
          return TRUE
        endif
      enddo

      return FALSE

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .init(!pipe is DBREF)

  !this.complete = FALSE
  var !units units
  !this.units = !units
  !this.readColours()
  !this.rigidActive = FALSE
  !this.currentWallThickness = 0
  !this.readColours()
  !this.stressGroupName = !pipe.name
  handle ANY
  endhandle
  !this.pipe = !pipe
  !this.evaluateGroup()

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .readCaseRest(!case is DBREF)

!caseTextArray = !this.getCaseElements(!case)
   do !a from 1 to !caseTextArray.size()
       -- now we have two lines we need to be able to deal with both old and new style texts
       -- is it an old style text?

      !this.nodeList.append(object STRESSNODE(!caseTextArray[!a],!a))
   enddo

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to split the new type restraint data into two parts
define method .getCaseElements(!case is DBREF) is ARRAY
!return = ARRAY()

do !a from 1 to !case.members.size()
  -- this could be an old type of restraint or a new one. the difference is the number of lines.
  if !case.members[!a].stext.split(',').size().gt(6).and(!case.members[!a].stext.split(',')[3].split().size().gt(1)) then
    -- its a node
    if defined(!combined) then
      !return.append(!combined)
      !combined.delete()
    endif
    !combined[1] = !case.members[!a]
  else
    -- its a restraint
    !combined[2] = !case.members[!a]
  endif
enddo

if !return.unset() then
  return !return
endif

if !return[!return.size()].neq(!combined) then
   !return.append(!combined)
endif

return !return

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to fill in the detail in the stress nodes also causes an error
-- with node renumbering
define method .getNodeData()

  !this.promptStart()

  do !a values !this.nodeList
     !a.getdata()
  enddo

 !this.resolveRefs()
  -- set all the node numbers
  --ew Taken out as it seems to be causing the node numbering to start from 20
  -- when the "edit nodes" button is pressed
 -- !this.parseNodes()
  -- set the group parsed attribute
  !this.parsed = TRUE

  -- due to the way the parsing takes place, it is possible to have
  -- branch elements which are not connected to anything but still
  -- have nodes. The next routine scans for unconnected branch nodes
  -- and removes the node number
  -- this may result in small gaps in the numbering
  !this.tidyBranchNodes()

  -- if there are any cases read the nodes
  !this.readExisting()

  !this.complete = TRUE
  !this.promptEnd()

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
define method .readColours()

  !this.highlightColour = !!psiDefaults.highcolb.background
  handle ANY
    !this.highlightColour = !!gphcolopt.highlight.code
  endhandle
  !this.returnColour = !!psiDefaults.retcolb.background
  handle ANY
    !this.returnColour = !!gphcolopt.highlight.code + 1
  endhandle

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to complete the stress group and build its nodes
define method .resolveGroup()

  !this.promptStart()

  -- go and build a node for every ppoint
  !this.buildNodes()
  -- go and get the appropriate connection references
  !this.resolveRefs()
  -- set all the node numbers
  !this.parseNodes()
  -- parse node names
  !this.parseNodeNames()
  --
  !this.parsed = TRUE
  -- tidy extra branches
  !this.tidyBranchNodes()
  -- if the numbers have been changed or the group has been written to an xml file
  -- we need to get the numbers and apply them to the nodes

  -- for the time being, we will assume that the nodes match and we can read them in
  -- this is probably the case as the stored text relates to ppoint, dbref and node number
  !main = !this.getRest('main')

  -- we have established that there is a restraint, so we need to go and get the
  -- node numbers associated with the old elements
  if !main.set() then
    !this.resetNumbers(!main)
  else
    !this.saveData()
  endif

  !this.promptEnd()

  -- due to the way the parsing takes place, it is possible to have
  -- branch elements which are not connected to anything but still
  -- have nodes. The next routine scans for unconnected branch nodes
  -- and removes the node number
  -- this may result in small gaps in the numbering
  !this.tidyBranchNodes()

  !this.complete = TRUE



endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .promptStart()

  prompt 'Please Wait... Generating Group'


endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
define method .promptEnd()

  prompt dismiss

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
-- method to set the starting value of the first node
-- if there is a rest in place then set the first node to be the next value
-- after the last numbered item
-- this allows for new components being added
define method .setStartNode()

  !this.increment =  !!psiDefaults.nodeincrement.val
  !this.lastNode =  !!psiDefaults.startnode.val
endmethod
-----------------------------------------------------------------------------


------------------------------------------------------------------------------
-- method to loop through the nodes and set the node numbers
-- this is the main bit which works out what nodes to allocate as valid
define method .parseNodes()

 !this.setStartNode()

 !unusedOriginPos = n0
 !this.lastPosition = n0
do !a index !this.nodeList
  -- fix to deal with ignored elements
  if !this.nodeList[!a].status.eq('IGNORED') then
     -- we have come to an ignored node such as a weld.
     -- This has significance because its LTLEN is used to decide on the connection of the next component.
     -- go off and set the tube length based on its atlen
     !this.resetTubeLengths(!a)
  endif
enddo

do !a index !this.nodeList
   !test = !this.nodeList[!a]
   if !test.status.eq('IGNORED') then
        -- fix to avoid last position problems
        skip
    endif
   if  !test.componentType.eq('BRAN') then
       -- go and set the branch head/tail nodes
       !this.setBranchNode(!a)
   elseif !test.componentType inset('TEE','OLET','VTWA')  then
       !this.setTeeNode(!a)
   elseif !test.componentType inset('CROS','VFWA')  then
       !this.setCrossNode(!a)
   elseif !test.componentType inset('BEND','ELBO') then
       !this.setBendNode(!a)
   elseif !test.componentType.eq('REDU') then
        !this.setReduNode(!a)
   elseif !test.componentType.eq('ATTA') then
        !this.setAttaNode(!a)
   elseif !test.componentType.eq('FTUB') then
       !this.setStdNode(!a,FALSE,3)
   else
      -- its a flange or some other inline component
      if !!psiDefaults.flangerigid.val.eq(2) then
         if !test.point.eq(1) then
            !this.setAlternateP1(!a)
         else
            !this.setAlternateP2(!a)
         endif
      else
         !this.setInLineNode(!a)
      endif

   endif

    if  !this.nodeList[!a].nodeNumber.eq(!this.lastNode) then
      !this.incrementNode(!this.increment)
    endif

    -- remember the current position so that we check it against the next one to avoid duplicates
    !this.lastPosition = !this.nodeList[!a].position

enddo

-- now we have sorted out the valid nodes then we need to get the appropriate linked connections
-- this is done by the method "get prev node number"

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
-- method to add node names to the nodes associated with branch ends and rigid items
define method .parseNodeNames()

do !a index !this.nodeList
  -- fix to deal with ignored elements
  skip if !this.nodeList[!a].nodeName.set()
  if !this.nodeList[!a].componentName.neq('').and(!this.nodeList[!a].componentName.lowcase().neq('unset')) then

     -- if the component name is set and the node number is set its a straight swap of names
     if !this.nodeList[!a].nodeNumber.set() then
       -- it could be -1 or -2 so we need to check if its greater than 1 - a proper node.
       if !this.nodeList[!a].nodeNumber.gt(0) then
        -- the name is set and the number is set so everything is fine. Just copy the name to the node name
        !this.nodeList[!a].nodeName = !this.nodeList[!a].componentName
       endif
     elseif !this.nodeList[!a].point.eq(1).and(!this.nodeList[!a].componentType.eq('BRAN')) then
          !this.setNextNodeName(!a,!this.nodeList[!a].componentName)
     elseif !this.nodeList[!a].point.eq(1) then
          -- if point eq 1 we need to go back to the previous numbered node
         !this.setPreviousNodeName(!a,!this.nodeList[!a].componentName)
     else
          -- if the point eq 2 we need to get the next numbered node
          !this.setNextNodeName(!a,!this.nodeList[!a].componentName)
     endif
  endif
enddo

endmethod

------------------------------------------------------------------------------
-- go back to the previous numbered node and set its name
define method .setPreviousNodeName(!number is REAL,!name is STRING)

    do !a from !number to 1 by -1
        if !this.nodeList[!a].nodeNumber.set() then
           if !this.nodeList[!a].nodeNumber.gt(0) then
              !this.nodeList[!a].nodeName = !name
              break
           endif
         endif
    enddo

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- go forward to the next numbered node and set its name
define method .setNextNodeName(!number is REAL,!name is STRING)

    do !a from !number to  !this.nodeList.size()
        if !this.nodeList[!a].nodeNumber.set() then
           if !this.nodeList[!a].nodeNumber.gt(0) then
              !this.nodeList[!a].nodeName = !name
              break
           endif
       endif
    enddo


endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
-- method used to set normal in line nodes when separate flanges are not being used
define method .setInLineNode(!a is REAL)

!unusedD = !this.nodeList[!a].component.string().dbref()

     !previousComp = !this.getAdjacentComp(!a,-1)
     !nextComp     = !this.getAdjacentComp(!a,1)

     if !this.nodeList[!a].point.eq(1) then

        if  !previousComp.lTubeLength.geq(1) or !previousComp.componentType.eq('FTUB') then $* we need to start a new rigid
           -- the previous node was the leave of a component and it had tube
           -- give the node a number and start a new rigid
           !this.setStdNode(!a,TRUE,0)
        else $* its the start of a component and there is no gap
           if !previousComp.componentType inset('ELBO','BEND','TEE','OLET','REDU','BRAN') and !previousComp.nodeNumber.unset() then
               -- there is no tube, but the previous component is an elbow so its the start of a rigid
               !this.setStdNode(!a,TRUE,0)
               -- TM 12.1.1 fix for tees which have components connected directly to p3
           elseif !previousComp.componentType.eq('BRAN').and(!previousComp.typeOfConnection inset('TEE','OLET')) then
               !this.setStdNode(!a,TRUE,0)
           else
               !this.setStdNode(!a,FALSE,1)
           endif
        endif
     else  $* point is 2
        if !this.nodeList[!a].lTubeLength.geq(1) or !nextComp.componentType.eq('FTUB') then
           -- its got some tube after it so we need to add a node and finish the current rigid
           !this.setStdNode(!a,TRUE,2)
        else $* its the end of a component and there is no gap
             -- if the next component is an elbow or the next component is a bend then we need a node
            if !nextComp.componentType inset('ELBO','BEND','TEE','OLET','REDU','WELD') then
                !this.setStdNode(!a,TRUE,2)
            elseif !nextComp.componentType.eq('BRAN') then
                --TM 27/06/2006 09:47
                -- there is no gap between this and the end of the branch so leave the end rigid to next
                -- end the rigid
                -- new comment need to end the rigid because the branch does not get a node number
                --!this.setStdNode(!a,TRUE,2)
                -- tm fix to stop zero length components getting 2 nodes to be put here

                if !nextComp.typeOfConnection inset('TEE','VTWA','OLET') then
                  if !this.nodeList[!a].position.distance(!nextComp.connection.position.wrt(/* )).gt(1mm) then
                    !this.setStdNode(!a,TRUE,2)
                  else
                    !this.setStdNode(!a,FALSE,1)

                  endif
                else  $* its not a tee
                  -- TM changed to try and get the node right for branches 11/11/2006 09:56
                      !this.setStdNode(!a,FALSE,1)
                endif
            else
                !this.setStdNode(!a,FALSE,1)
            endif
        endif
     endif

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
-- only used when separate flanges are required
-- method used to set normal in line nodes when separate flanges are being used
define method .setAlternateP1(!a is REAL)

     !previousComp = !this.getAdjacentComp(!a,-1)
     !nextComp     = !this.getAdjacentComp(!a,1)


     -- point = 1  its the start of the current component
        if  !previousComp.lTubeLength.geq(1) then $* we need to start a new rigid
           -- the previous node was the leave of a component and it had tube
           -- give the node a number and start a new rigid
           !this.setStdNode(!a,TRUE,0)
        else $* its the start of a component and there is no gap
          -- deal with the last item being a spare gasket
          if !this.nodeList[!a].componentType.eq('FTUB') then
            !this.setStdNode(!a,FALSE,0)
            return
          endif
          if !previousComp.componentType.eq('FTUB')  then
             if !this.nodeList[!a].componentType inset('VALV','FILT','INST','COUP','FLAN','FBLI','VTWA') then
                !this.setStdNode(!a,TRUE,0)
                return
             endif
          endif
          if !this.nodeList[!a].componentType.eq('GASK') then
               if !nextComp.componentType.eq('BRAN') then
                   -- add to the rigid
                   !this.setStdNode(!a,FALSE,1)
               elseif !nextComp.componentType inset('FLAN','FBLI') and !this.nodeList[!a].previoustype inset('FLAN','FBLI')  then
                   !this.setStdNode(!a,FALSE,1)
               elseif !previousComp.componentType.eq('BRAN')  then
                   !this.setStdNode(!a,FALSE,1)
               elseif !previousComp.componentType inset('FLAN','FBLI') then
                   -- we are separating flanges so this must be the start of a rigid
                   --!this.setStdNode(!a,TRUE,0)
                   !this.setStdNode(!a,FALSE,0)

               else
                   !this.setStdNode(!a,FALSE,1)
               endif
           -- if this or the previous component was a flange then we need to start a new rigid
          elseif !this.nodeList[!a].componentType inset('FLAN','FBLI') then
             -- if the component before last is a branch then
             if !previousComp.componentType.eq('GASK') and !this.nodeList[!a - 1].previoustype.eq('BRAN') then
                !this.setStdNode(!a,FALSE,1)
             --elseif !previousComp.componentType.eq('GASK') and !previousComp.nodeNumber.set() then
             elseif !previousComp.nodeNumber.set() then
                !this.setStdNode(!a,FALSE,0)
             else
                -- start a new rigid
                !this.setStdNode(!a,TRUE,0)
                --!this.setStdNode(!a,FALSE,0)
             endif
          elseif !this.nodeList[!a].componentType.eq('CAP') then
                  !this.setStdNode(!a,FALSE,0)
          elseif !previousComp.componentType inset('FLAN','FBLI')  then
              -- start a new rigid
             !this.setStdNode(!a,TRUE,0)
          else
             -- add to the current rigid
             !this.setStdNode(!a,FALSE,1)
          endif

       endif

endmethod
------------------------------------------------------------------------------



------------------------------------------------------------------------------
-- only used when separate flanges are required
-- method used to set normal in line nodes when separate flanges are being used
define method .setAlternateP2(!a is REAL)

-- p2 is being used
      !previousComp = !this.getAdjacentComp(!a,-1)
      !nextComp     = !this.getAdjacentComp(!a,1)


       if !this.nodeList[!a].lTubeLength.geq(1) then
          -- its got some tube after it so we need to add a node and finish the current rigid
          !this.setStdNode(!a,TRUE,2)
       else $* its the end of a component and there is no gap
           -- if the current or next component is a flange -
           -- set a node number and end the rigid
           if !nextComp.componentType.eq('FTUB') then
              !this.setStdNode(!a,TRUE,2)
              return
           endif
           if !nextComp.componentType.eq('BRAN') then
               -- check the distance in case its p3 of a tee
                if !nextComp.typeOfConnection.eq('TEE') then
                   if (!this.nodeList[!a].position.distance(!nextComp.connection.position.wrt(/* )).gt(1mm)) then
                      !this.setStdNode(!a,TRUE,2)
                   else
                      !this.setStdNode(!a,FALSE,1)
                   endif
                else
                 --!this.setStdNode(!a,TRUE,2)
                  !this.setStdNode(!a,FALSE,1)
                endif
           elseif !nextComp.componentType.eq('GASK').and(!nextComp.component.order.eq(!this.nodeList[!a + 1].component.owner.mcount)) then
                -- if the next component is a gasket and its the last member just add to the current rigid
                !this.setStdNode(!a,FALSE,1)
           elseif !this.nodeList[!a].componentType.eq('GASK') then
              if !previousComp.componentType.eq('BRAN') then
                 -- if its the last gasket in the branch - terminate the rigid
                 !this.setStdNode(!a,FALSE,1)
              elseif !nextComp.componentType.eq('FLAN').and(!previousComp.componentType.eq('FLAN'))  then
                    !this.setStdNode(!a,TRUE,2)
              elseif !nextComp.componentType.eq('FLAN') then
                 !this.setStdNode(!a,TRUE,2)
              else
                 !this.setStdNode(!a,FALSE,1)
              endif
           elseif !this.nodeList[!a].componentType.eq('FLAN') then
                !this.setStdNode(!a,TRUE,2)
           elseif !nextComp.componentType inset('FLAN','FBLI') then
                -- if the next item is a flange we need to terminate the rigid
               --!this.setStdNode(!a,TRUE,2)
               !this.setStdNode(!a,FALSE,1)
           elseif !this.nodeList[!a].componentType.eq('CAP') then
               !this.setStdNode(!a,TRUE,0)
           else
               -- we are part way through a rigid so we need to continue it
               !this.setStdNode(!a,FALSE,1)
           endif
       endif



endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to get the next or previous active component
define method .getAdjacentComp(!number is REAL,!direction is REAL)is STRESSNODE

    if !direction.eq(0) then
        return object STRESSNODE()
    endif

    !count = !number + !direction
    do
       if !this.nodeList[!count].status.neq('IGNORED') and !this.nodeList[!count].component.neq(!this.nodeList[!number].component)then
          return !this.nodeList[!count]
       endif
       !count = !count + !direction
       if !count.gt(!this.nodeList.size()).or(!count.lt(1) ) then
          return object STRESSNODE()
       endif
    enddo

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to deal with single or multiple ATTAS
-- get the restraint data if there is any and add it to the last atta with a number
define method .setAttaNode(!a is REAL)

--   -- we are at an atta
--  if !this.nodeList[!a - 1].lTubeLength.gt(0) then
      !this.setStdNode(!a,TRUE,3)
--   else
--      !this.setStdNode(!a,FALSE,3)
--   endif

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- simple method hopefully
-- from the current node look at the rest and see if we have a matching node
-- which has been given a number. In theory all branches should have nodes so
-- all connections should be resolvable
-- returns the number of the node to which its connected
-- !current is the node being parsed
-- !ref is the DBREF of the current node
-- !type is the type of component we are at
define method .getPrevNodeNumber(!current is REAL,!ref is DBREF,!type is STRING)is REAL

  -- PARAMETERS
  -- !current is the current index looping through the node list
  -- !ref is the current node's component dbref
  -- !type is HEAD, TAIL or TEE
  do !a index !this.nodeList
    if !a.eq( !current) then
       -- we have got to the current point and not found the node so
       -- the node won't have a number yet
       if !a.eq(!this.nodeList.size()) then
           skip
       endif
       -- if we are at the tail of a branch and we are connected to a tee then we need to move the position to the tee
       if !this.nodeList[!a + 1].componentType inset('TEE','OLET','VTWA','CROS','VFWA') then
           if !this.nodeList[!a + 1].component.owner.neq(!this.nodeList[!a].component) then
              !this.nodeList[!a].position = !this.nodeList[!a + 1].component.pos.wrt(/* )
           endif
       elseif  !this.nodeList[!a + 1].componentType inset('BRAN') then
           -- we are at the end of a branch and we need to get the tee
           if !type.eq('TAIL') then
               !this.nodeList[!current].position = !this.nodeList[!current].component.tref.position.wrt(/* )
               handle any
                  -- in case the tref is not set
               endhandle
           endif
       endif
       break
    endif
    -- if we are looking at q connected component
    if !this.nodeList[!a].componentType inset('TEE','OLET','VTWA') then
       -- if its a tee, we need to match the connection reference and p0 to get the node number
       if !this.nodeList[!a].component.eq(!ref) and !this.nodeList[!a].point.eq(0) then
           -- set the branch connection to the POSITION of p0 of the tee
           !this.nodeList[!current].position = !this.nodeList[!a].position
           return !this.nodeList[!a].nodeNumber
       endif
    elseif !this.nodeList[!a].componentType inset('CROS','VFWA') then
       -- if its a tee, we need to match the connection reference and p0 to get the node number
       if !this.nodeList[!a].component.eq(!ref)  then
          -- we have found the point
          -- get the p0 node for the cross
          !number = !this.getCrossOrigin(!a)
          -- set the branch connection to the POSITION of the cross
          -- get the p0 node

           !this.nodeList[!current].position = !this.nodeList[!number].position
           return !this.nodeList[!number].nodeNumber

           --we need to work out how to get the correct position and p0 node number
       endif

    else $* its something weird
        -- test to see if the current selection matches the reference we are looking for
        if !this.nodeList[!a].component.eq(!ref).and(!this.nodeList[!a].linkednode.eq( !this.nodeList[!current].component ))then
           if !this.nodeList[!a].componentType inset('TEE','OLET','VTWA') then
              !this.nodeList[!current].position = !this.nodeList[!a].position
           else
              !this.nodeList[!a].position = !this.nodeList[!current].position
           endif
           return !this.nodeList[!a].nodeNumber
        endif
    endif
  enddo

  -- if we get here then we haven't found anything so return the standard node
  return !this.lastNode

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
-- method to find the origin node for a cross
define method .getCrossOrigin(!nodeNumber is REAL)is REAL

!start = !nodeNumber
do !a from !start to !start + 5
   if !this.nodeList[!a].point.eq(0).and(!this.nodeList[!a].componentType.eq('CROS')) then
      return !a
  endif
enddo

return !nodeNumber

endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
-- method to add numbers to stress nodes
-- !action is as follows:
-- 0 = its the start of a rigid
-- 1 = it needs to be added to the current rigid
-- 2 = its the end of a rigid
-- 3 =
-- 4 =  start a rigid with no weight
-- !on gives the node a number
------------------------------------------------------------------------------
define method .setStdNode(!number is REAL,!on is BOOLEAN,!action is REAL)


  if !on then
   !this.nodeList[!number].nodeNumber = !this.lastNode
   !this.incrementNode(!this.increment)
  endif
  if !action.eq(0) then
     -- start a new rigid
     !this.startRigid(!number,TRUE)
  elseif !action.eq(1) then
     -- ad the component weight to the active rigid
     !this.addToRigid(!number)
  elseif !action.eq(2) then
     -- end the rigid total the weights and add the total to the current node
     !this.endRigid(!number)
  elseif !action.eq(3) then
     if !this.rigidActive then
         !this.addToRigid(!number)
     endif
     -- do nothing (no rigid method)
  else $* its 4 start a rigid with no weight
      !this.startRigid(!number,FALSE)
  endif

  if !this.nodeList[!number].wallthickness.unset().not() then
      !this.currentWallThickness = !this.nodeList[!number].wallthickness
  endif

  if !this.nodeList[!number].wallthickness.unset().or(!this.nodeList[!number].wallthickness.eq(0)).and(!this.currentWallThickness.neq(0)) then
        !this.nodeList[!number].wallthickness = !this.currentWallThickness
  endif

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to set the current branch node
define method .setBranchNode(!current is REAL)

      -- go and look for the connection and work out the node value
      -- if its a tee and not the origin, the node is ignored
      -- we need to work out what to do with the spare end of a tee
      -- work for later

      if !this.nodeList[!current].point.eq(1) then
        !type = 'HEAD'
         if !this.nodeList[!current].lTubeLength.eq(0) then
            !this.startRigid(!current,TRUE)
         endif

      elseif !this.nodeList[!current].point.eq(2) then
       !x = !this.nodeList[!current].component.string().dbref()
        !type = 'TAIL'
        if !this.rigidActive then
            if !this.nodeList[!current - 1].lTubeLength.eq(0) then
                   -- add up the weights and end the rigid
                  -- !this.endRigid(!current)
                  -- TM try to fix node problem Sat 11/11/2006 08:33
                   !this.setStdNode(!current,TRUE,2)
            endif
        endif
      endif

      if !this.isSamePosition(!this.nodeList[!current].position,!this.lastPosition) then
          -- if the current node is in the same position as the previous one
       if !current.gt(1) then
          if !this.nodeList[!current - 1].rigid.set() then
              !this.endRigid(!current)
          endif
       endif
     endif

      -- reposition the node to a tee if necessary
      !this.nodeList[!current].nodeNumber = !this.getPrevNodeNumber(!current,!this.nodeList[!current].linkednode,!type)

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method for dealing with tees
define method .setTeeNode(!current is REAL)

      if !this.nodeList[!current].point.neq(0) then
        -- it could be 1 2 or 3
        if !this.nodeList[!current].point.eq(2) then
            !this.setStdNode(!current,FALSE,3)
        else
          -- it is 1 or 3
          if !this.nodeList[!current].point.eq(1) then
            !this.setStdNode(!current,FALSE,2)
          else
          -- its 3
            !this.setStdNode(!current,FALSE,3)
          endif
        endif
      else  $* its point zero and needs to look at connections
        !this.nodeList[!current].nodeNumber = !this.getPrevNodeNumber(!current,!this.nodeList[!current].linkednode,'TEE')
        !this.setStdNode(!current,FALSE,3)
      endif
      !this.lastPosition = !this.nodeList[!current].position

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method for dealing with crosses
define method .setCrossNode(!current is REAL)

      if !this.nodeList[!current].point.neq(0) then
        if !this.nodeList[!current].point.eq(2) then
          !this.setStdNode(!current,FALSE,3)
        else
          !this.setStdNode(!current,FALSE,0)
        endif
      else  $* its point zero and needs to look at connections
        !numbers = !this.getCrossNodes(!current)
        -- we need to go and set nodes so that they have the correct point
        !unusedOriginal = !this.nodeList[!current].nodeNumber
        do !a values !numbers
            !this.nodeList[!current].nodeNumber = !this.getPrevNodeNumber(!current,!this.nodeList[!a].linkednode,'CROS')
        enddo
        !this.setStdNode(!current,FALSE,3)
      endif
      !this.lastPosition = !this.nodeList[!current].position

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to get the node numbers of all of the points on a cross
-- used as we have found a cross and there is no single cref which we can attach to p0
-- we are currently at p0 so we need to look back to previous nodes and forward to the next 2
define method .getCrossNodes(!number is REAL)is ARRAY

!return = ARRAY()
do !a from !number - 2 to !number + 2
  if !this.nodeList[!a].connection.set() then
    !return.append(!a)
  endif
enddo

return !return

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .setBendNode(!current is REAL)

     !previousComp = !this.getAdjacentComp(!current,-1)
     !nextComp     = !this.getAdjacentComp(!current,1)
      -- output the zero node
      if !this.nodeList[!current].point.neq(0) then
         !this.setStdNode(!current,FALSE,3)
      else
         -- need to put the previous and next stress node into an array
         -- because pml refuses to pass two stress nodes in the call to the method "set bend type"
         !array[1] = !previousComp
         !array[2] = !nextComp
         !this.nodeList[!current].bendType = !this.setBendType(!current, !array )
         !this.nodeList[!current].nodeNumber = !this.lastNode

      endif

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .setBendType( !num is REAL,!list is ARRAY)is REAL

     !bendType = 0
     if !list[1].componentType.eq('FLAN') then
        if !list[1].position.distance(!this.nodeList[!num - 1].position).lt(!this.nodeList[!num].outsidediameter) then
            !bendType  = !bendType + 1
        endif
     elseif !list[2].componentType.eq('FLAN') then
        if !list[2].position.distance(!this.nodeList[!num + 1].position).lt(!this.nodeList[!num].outsidediameter) then
            !bendType  = !bendType + 1
        endif
     endif

     return !bendType

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to deal with reducer points
define method .setReduNode(!current is REAL)

     if !this.nodeList[!current].point.eq(1) then
         if !this.nodeList[!current - 1].lTubeLength.gt(0) and !this.nodeList[!current - 1].componentType.neq('FTUB') then
            --if there is tube between the previous component create a node
            !this.setStdNode(!current,TRUE,3)
         else $* there is no gap between this and the previous so we ought to have a node somewhere
            if !this.nodeList[!current - 1].nodeNumber.unset() then
                !this.setStdNode(!current,TRUE,3)
            else
             -- special case for the node being the first one in a new branch
                if !this.nodeList[!current].component.order.eq(1) then
                   !this.setStdNode(!current,TRUE,3)
                else
                   !this.setStdNode(!current,FALSE,3)
                endif
            endif
         endif
     else $* its point number 2
         if !this.nodeList[!current].lTubeLength.gt(0) and !this.nodeList[!current + 1].componentType.neq('FTUB') then
             -- if there is a gap after the reducer we need a node
             !this.setStdNode(!current,TRUE,3)
         else  $* there is no tube
            if !this.nodeList[!current + 1].componentType.eq('BRAN') then
              if !this.nodeList[!current + 1].typeOfConnection inset ('TEE','OLET','VTWA') then
                !this.setStdNode(!current,TRUE,3)
              else
                  -- leave the node to the branch
                 !this.nodeList[!current + 1].weight = !this.nodeList[!current].weight
              endif
            else
               !this.setStdNode(!current,TRUE,4)
            endif
             -- we need to set the node to record that it is a reducer
             -- and start the rigid with no weight
         endif
         -- reducers should never be part of a rigid

     endif

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to loop through the nodes to set references
define method .resolveRefs()


 do !a index !this.nodeList
    !node = !this.nodeList[!a]
    !ref = object DBREF()
    if !node.componentType.eq('BRAN') then
       if !node.point.eq(1) then
          !ref = !node.component.href
          !type = !ref.type
          handle ANY
          endhandle
       elseif !node.point.eq(2) then
          !ref = !node.component.tref
          !type = !ref.type
          handle ANY
          endhandle
       endif
   elseif !node.componentType inset('TEE','OLET','VTWA') then
         -- only set the value if the point is 0
         if !node.point.eq(0) then
           !ref = !node.component.cref
           !type = !ref.type
           handle ANY
           endhandle
         endif
   endif

   !this.nodeList[!a].linkednode = !ref

 enddo

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to deal with the current rigid and total the weights
define method .startRigid(!nodeNumber is REAL,!add is BOOLEAN)

  if !add then
    !this.rigidWeight = !this.nodeList[!nodeNumber].weight
  else
    !this.rigidWeight = 0
  endif
  !this.rigidActive = TRUE
  !this.rigidItems  = ARRAY()
  !this.nodeList[!nodeNumber].rigid = 'START'

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to add the current element to the currently rigid output
define method .addToRigid(!nodeNumber is REAL)

  !this.rigidWeight = !this.rigidWeight + !this.nodeList[!nodeNumber].weight
  handle ANY
          -- add unable to get weight message
  endhandle
  !this.rigidItems.append(!this.nodeList[!nodeNumber].component)

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to end the current rigid - adds the total weight to the current node
define method .endRigid(!nodeNumber is REAL)

  if !this.rigidActive.not() then
    !this.rigidWeight = 0
    !this.rigidActive = FALSE
    return
  endif

  !this.rigidWeight = ((!this.rigidWeight + !this.nodeList[!nodeNumber].weight) / 2)
  handle ANY
          -- add unable to get weight message
  endhandle
  !this.nodeList[!nodeNumber].rigidWeight  =   !this.rigidWeight
  !this.nodeList[!nodeNumber].rigid = 'END'
  !this.rigidActive = FALSE


endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to take an existing group and split it into equipment and branches
define method .evaluateGroup()

  !x = !this.pipe
  !list = !x.:PSISYSTEM
  do !a values !list
    if !a.objectType().neq('DBREF') then
      skip
    endif
    if !a.badRef() then
      skip
    else
      !this.branches.append(!a)
    endif
  enddo


endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method for saving the data into the stressGroup (called by the add/rem routine)
define method .saveGroup()

  !!ce = !this.pipe
  !list = ARRAY()
  -- Reset the UDA
  :PsiSystem  default
  do !a values !this.branches
     !list.append(!a)
  enddo

  !!ce.:PsiSystem = !list
  handle ANY
  endhandle

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
------------------------------------------------------------------------------
define method .clearGroup()

  do !a values !this.branches
    !this.highlight(!a,FALSE)
  enddo

  !this.branches = ARRAY()


endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .showGroup()

    !col = !!gphcolopt.highlight.code
    if !this.branches.size().eq(0) then
        !!alert.error(' No Support Group defined')
        return
    else
       !this.saveDisplay()
       remove all
       do !a values !this.branches
         -- add $!a Col $!col
         add $!a
       enddo
    endif

    !view = !this.getView()
    !!view3DLimits (!view, 'DRAW')

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .getView() is GADGET

   do !a from 1 to 10
     !gadget = '!!gph3ddesign' & !a & '.VIEW'
     !type = $!<gadget>.objectType()
     handle ANY

     elsehandle NONE
        if !type.eq('GADGET') then
           return $!gadget
        endif
     endhandle
   enddo

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method for picking a set of branches.equipment and highlighting them as part of the stressGroup
define method .addRemove()
-- pick an item then add/remove it and highlight it

   site
   !items = !this.branches
   do !a
     var !x pick
     handle ANY
       !this.branches = !items
       !this.saveGroup()
       prompt dismiss
       break
     endhandle
     !item = !x[1].dbref()
     !unusedOlist = !item.olist
     if !item.ddepth.geq(4) then
       -- we should have hit a piping component
       if !item.owner.type.neq('BRAN') and !item.type.neq('BRAN') then
         !!alert.error('please hit a piping component')
         skip
       endif
       if !item.type.neq('BRAN') then
         !item = !item.owner
       endif
       if !item.owner.type.neq('PIPE') then
             !!alert.error('Cannot add HVAC components')
             skip
       endif

       !test = !items.findFirst(!item)
       if !test.set() then
          !name = !items[!test].name
          if !!alert.confirm('Remove Branch $!name').eq('YES') then
            !this.highlight(!item,FALSE)
            !items.removefrom(!test,1)
          endif
       else
         if !!psiDefaults.stressready.val.eq(1) then
           -- the stress ready attribute is needed
           if !this.checkStressOk(!item).not() then
              !!alert.error('Branch $!item.name Not ready for stressing')
              skip
           endif
         endif

         -- now check to see if we are allowing multiple selections
         if !!psiDefaults.strgroup.selection().eq('Single') then
            -- we need to check to see if the pipe belongs to anther group
            !usedTest = !!psifindgroups(!item,!!psiDefaults.scangroup.selection().trim().boolean())
            if !usedTest[1] then
               !remName = !usedTest[2].name
               !groupName = !usedTest[3].name
               !!alert.error('Branch $!remName Is Already Part of Stress Group $!groupName')
               skip
            endif
         endif
         -- need to add something here so that we can check a stress attribute

         -- this for the ready for stressing attribute

         -- whatever that is going to be

         !this.highlight(!item ,TRUE)
         !items.append(!item)
       endif
     endif
   enddo


   if !this.branches.set() then
      if !items.neq( !this.branches ) then
          -- delete any rest elements
          !!ce = !this.pipe
          rest 1
          handle ANY
          elsehandle NONE
              delete rest
          endhandle
      else
         --$P rest is same
      endif
      !this.resolveGroup()
   else
       --ew
       -- No branches in group, delete main rest if it exists
      !!ce = !this.pipe
      rest 1
      handle ANY
      elsehandle NONE
            delete rest
      endhandle
   endif

   !!psiSystem.setnodevis()

   --ew added to fix node numbering problem
   --now rebuilds "empty group" properly
   !!psiSystem.refreshgroup(FALSE)
   prompt dismiss


endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
define method .checkStressOk(!bran is DBREF) is BOOLEAN

    !!ce = !bran
    !exp = object PSIEXPRESSION(!!psiDefaults.stressokarray[1])
    !test = !exp.evaluate()
    if !test[3].neq('') then
      !return = !test[3].boolean()
      handle ANY
        !return = FALSE
      endhandle
    endif
    return !return

endmethod
