--------------------------------------------------------------------------------------
-- if the component type is a branch, we need to work out the node position
-- but there is also a need to add some extra details for the branch used on branch 1 only
define method .branchData(!branch is DBREF)

  !lines = ARRAY()

    -- go to the bran so that the getProperty methods work

    !lines.append(|<Branch>|)
    !lines.append(|<Branchname>| & !branch.name & |</Branchname>|)

    !this.temperature = !this.getProperty('Temperature1','-100000').real()


    !lines.append(|<Temperature>|)
    do !a from 1 to 9
      !temp = !this.getProperty('Temperature$!a','-100000')
      !lines.append(|<Temperature$!a>$!temp</Temperature$!a>| )
    enddo
    !lines.append(|</Temperature>|)

   -- issue
   -- pressure on branch is just a real, so we have no way of knowing what the units are
   -- issue

   !this.pressure = !this.getProperty('pressure1','0').real()

    !lines.append(|<Pressure>|)
    do !a from 1 to 9
       !press = !this.getProperty('pressure$!a','0')
       !lines.append(|<Pressure$!a>$!press</Pressure$!a>|)
    enddo
    !lines.append(|</Pressure>|)


   -- get the material number
   !mat = !this.getProperty('Material','0')
   !this.material = !mat
   !lines.append(|<MaterialNumber>$!mat</MaterialNumber>|)

   !insul = !this.getProperty('Insul','0')
   !this.insulationMat = !insul
   !lines.append(|<InsulationDensity>$!insul</InsulationDensity>|)


   !flui = !this.getProperty('Fluid','0')
   !lines.append(|<FluidDensity>$!flui</FluidDensity>|)

   !this.branchLines = !lines

   if !this.point.eq(1) then
       !this.connection = !branch.href
       !this.typeOfConnection = !branch.href.type
       handle ANY
         !this.typeOfConnection = !branch.hconn
       endhandle
   else
       !this.connection = !branch.tref
       !this.typeOfConnection = !branch.tref.type
       handle ANY
         !this.typeOfConnection = !branch.tconn
       endhandle
   endif

endmethod
--------------------------------------------------------------------------------------


------------------------------------------------------------------------------
-- method for making a general node.
-- parameters are:
-- !comp is the component for the node
-- !end is the arrive, leave or origin
define method .makenodeLines(!addrest is BOOLEAN )is ARRAY

      !lines = ARRAY()

      if !this.componentType.eq('BRAN') and !this.point.eq(1) then
       -- !lines.appendArray(!this.branchLines)
      endif

      -- input a node
      !lines.append(|<Node>|)
      if !this.status.eq('IGNORED') then
         !num = -2
      elseif !this.nodeNumber.unset() then
         !num = -1
      else
         !num = !this.nodeNumber
      endif
      !lines.append(|<NodeNumber>$!num</NodeNumber>|)
      if !this.nodeName.set() then
      !name = !this.nodeName.substring(1,10)
        if !name.neq(!this.nodeName) then
          !!alert.warning(|Node Name $!this.nodeName truncated to $!name|)
        endif
      endif
      !lines.append(|<NodeName>$!this.nodeName</NodeName>|)
      !lines.append(|<Endpoint>$!this.point</Endpoint>|)
     if !this.rigid.eq('END') then
          !lines.append(|<Rigid>2</Rigid>|)
          !lines.append(|<ComponentType>RIGID</ComponentType>|)
          if !this.rigidWeight.unset() then
              !this.rigidWeight = 0
           endif
          !lines.append(|<Weight>$!this.rigidWeight</Weight>|)
     else
        if !this.rigid.eq('START')  then
          !lines.append(|<Rigid>1</Rigid>|)
        endif
        !lines.append(|<ComponentType>$!this.componentType</ComponentType>|)
          if !this.weight.unset() then
              !this.weight = 0
          endif
          !lines.append(|<Weight>$!this.weight</Weight>|)
     endif

      !lines.append(|<ComponentRefNo>$!this.component</ComponentRefNo>|)
      !lines.append(|<OutsideDiameter>$!this.outsideDiameter</OutsideDiameter>|)
      !lines.append(|<WallThickness>$!this.wallThickness</WallThickness>|)
      !lines.append(|<CorrosionAllowance>$!this.corrosionAllowance</CorrosionAllowance>|)

      if !this.alphaAngle.set() then
         !lines.append(|<AlphaAngle>$!this.alphaAngle</AlphaAngle>|)
      endif

      !lines.append(|<InsulationThickness>$!this.insulationThickness</InsulationThickness>|)
      -- get a nice position output with 2 DP
      !east = !this.position.east.value().string(!!realFMT)
      !north = !this.position.north.value().string(!!realFMT)
      !up= !this.position.up.value().string(!!realFMT)

      !lines.append(|<Position>$!east $!north $!up</Position>|)
      !lines.append(|<BendRadius>$!this.bendRadius</BendRadius>|)
      if !this.componentType inset('ELBO','BEND') then
         !lines.append(|<BendType>$!this.bendType</BendType>|)
      endif
      !lines.append(|<SIF>$!this.sif</SIF>|)
      if !this.restLines.size().gt(0).and(!addrest) then
        !lines.appendArray(!this.restLines)
      endif
      !lines.append(|</Node>|)

      return !lines

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to get the position of the current point
define method .getPosition()

    if !this.componentType.eq('BRAN') then
      if !this.point eq 1 then
         !this.position = !this.component.hpos.wrt(/* )
      elseif !this.point eq 2 then
        !this.position = !this.component.tpos.wrt(/* )
      endif
    else
      if !this.point eq 1 then
         !this.position = !this.component.apos.wrt(/* )
      elseif !this.point eq 2 then
        !this.position = !this.component.lpos.wrt(/* )
      elseif !this.point eq 3 then
        -- get the spare end whatever it is
        !spare = 6 - (!this.component.arrive + !this.component.leave)
        !this.position = !this.component.ppos[!spare].wrt(/* )
      else $* its the origin
        !this.position = !this.component.pos.wrt(/* )
      endif
    endif

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- only get leave tube if the point is the pleave
define method .getILTube()


  if !this.point.eq(2) then
    !this.lTubeLength = !this.component.ltLength.int()
    if !this.componentType.neq('BRAN') then
      if !this.position.neq(!this.component.lpos.wrt(/* )) then
       !this.lTubeLength = 0
      endif
    endif
  else $* point = 1
     !this.lTubeLength = !this.component.ltLength.int()
  endif

  if !this.componentType.eq('ATTA') then
      !this.lTubeLength = !this.getAttaTube()
  endif

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to get the tube length of atta elements because itlen always returns zero
define method .getAttaTube()is REAL

   !startPos = !this.component.lposition.wrt(/* )
   if !this.component.order.lt(!this.component.owner.members.size()) then
      !endPos = !this.component.owner.members[!this.component.order + 1].lposition.wrt(/* )
   else
      !endPos = !this.component.owner.tpos
   endif

   !tubeLength = !startPos.distance(!endPos).int()

   return !tubeLength


endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
-- method to get the outside diameter based on the tube o/d
define method .getOd()

  !this.outsideDiameter = 0


  if !this.componentType.eq('BRAN') then
    if !this.point.eq(1) then
       !this.outsideDiameter = !this.component.phod.value()
    else
       if !this.component.mcount.gt(0) then
         !this.outsideDiameter = !this.component.members[!this.component.mcount].lod.value()
       else
         !this.outsideDiameter = !this.component.phod.value()
       endif
    endif
  else
    if !this.point eq 2 then
      !this.outsideDiameter = !this.component.lod.value()
      handle any
        !this.outsideDiameter = 0
      endhandle
    else $* if its  1 or 0 ( the origin)
      !this.outsideDiameter = !this.component.aod.value()
      handle ANY
        !this.outsideDiameter = 0
      endhandle
    endif
  endif


 if !this.componentType.eq('REDU')and(!this.point.eq(2)) then
    !alphaAngle = atan(( abs(!this.component.aod - !this.component.lod.value()) / 2 ) / (0.6 * !this.component.apos.distance(!this.component.lpos)))
    handle ANY
        !this.alphaAngle = object REAL()
    elsehandle NONE
       !this.alphaAngle =  !alphaAngle.value().string('D2').real()
    endhandle
 endif


endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
define method .getInsulation()

   !insul = !this.component.inth.value()
   if !insul.unset() then
      !this.insulationThickness = 0
   else
      !this.insulationThickness = !insul
   endif


endmethod
------------------------------------------------------------------------------


------------------------------------------------------------------------------
-- method to get wall thicknesses
-- sets
-- arriveWall
-- leaveWall
-- branchWall
------------------------------------------------------------------------------
define method .getWallThickness()

  -- wall thickness is nominally taken from the arrive and leave tube of the component
  -- using the :TWALL attribute on a TUBD

  !this.wallThickness = 0
  !this.wallThickness = !this.getProperty('Wall','0').real()
  handle ANY
        -- $P error with wall thickness
     !this.wallThickness = 0
  endhandle

endmethod
------------------------------------------------------------------------------

 ------------------------------------------------------------------------------
-- method to get corrosion allowance
-- sets
-- corrosion allowance
------------------------------------------------------------------------------
define method .getCora()

  -- using the cora attribute on a cmpref
  !this.corrosionAllowance = 0
  !this.corrosionAllowance = !this.getProperty('Corrosion','-1000000').real()
  handle ANY
     !this.corrosionAllowance = 0
  endhandle
  -- override the default -1000000 if its been returned
  if !this.corrosionAllowance.eq(-1000000) then
      !this.corrosionAllowance = 0
  endif

endmethod
