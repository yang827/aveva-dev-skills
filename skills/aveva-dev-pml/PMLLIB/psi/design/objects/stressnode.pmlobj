--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------
-- method for building a text string to save the data for a stress run
-- builds the text strings to be saved for each run
define method .compileSaveData() is ARRAY

   !saveString = ''
   !saveString = !saveString & !this.nodeNumber            & ','
   !saveString = !saveString & !this.component.string()      & ','
   !saveString = !saveString & !this.position.string().before(' WRT')     & ','
   handle ANY
     !saveString = !saveString &  'N0E0U0'
   endhandle
   !saveString = !saveString & !this.point                 & ','
   handle ANY
     --!saveString = !saveString &  '-1,'
     !saveString = !saveString &  ','
   endhandle
   !saveString = !saveString & !this.componentType & ','
   handle ANY
     !saveString = !saveString &  ','
   endhandle
   !saveString = !saveString & !this.deflection.string().before(' WRT') & ','
   handle ANY
     !saveString = !saveString &  'E0N0U0,'
   endhandle
   !saveString = !saveString & !this.status & ','
   handle ANY
     !saveString = !saveString &  ','
   endhandle

   !returnString[1] = !saveString

   !restraintString = 'Restraints-,'

   !this.restraintGroup.getDisplaystring()
   !restraintString = !restraintString & !this.restraintGroup.typestring.replace(',',' ') & ','
   !restraintString = !restraintString & !this.restraintGroup.stiffnessstring.replace(',',' ') & ','
   !restraintString = !restraintString & !this.restraintGroup.gapstring.replace(',',' ') & ','
   !restraintString = !restraintString & !this.restraintGroup.frictionstring.replace(',',' ') & ','
   !restraintString.replace(' ','')

   !returnString[2] = !restraintString

   return !returnString

endmethod
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
-- method to get the bore of the component
define method .getBore()

  if !this.point.eq(1).or(!this.point.eq(0)) then
    if !this.component.type.eq('BRAN') then
       !this.bore = !this.component.hbore
    else
      !this.bore = !this.component.abore
    endif
  elseif !this.point.eq(2) then
    if !this.component.type.eq('BRAN') then
       !this.bore = !this.component.tbore
    else
       !this.bore = !this.component.lbore
    endif
  else
    !this.bore = !this.component.ppbor[!this.point]
    handle ANY
     !this.bore = object BORE()
    endhandle
  endif

endmethod
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
-- method to get radius of the current bend
define method .getRadius()

  !adir = !this.component.adir
  !ldir = !this.component.ldir
  !angle = !adir.angle(!ldir) / 2
  !adj = !this.component.apos.distance(!this.component.pos)
  if !adj.eq(0) then
      !this.bendRadius = 0
  else
      !bendRadius = tan( !angle ) * !adj
      !this.bendRadius = !bendRadius.value()
  endif

endmethod
--------------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .getAdjacent()

if !this.component.type.eq('BRAN') then
   return
endif

!return = !!ce
!!ce = !this.component

   if !this.component.order.eq(1) then
       !this.previousType = 'BRAN'
       !this.nextType = type of next
       handle ANY
         !this.nextType = 'BRAN'
       endhandle
   elseif  !this.component.order.eq(!this.component.owner.mcount)  then
      !this.nextType = 'BRAN'
      !this.previousType = type of prev
   else
      !this.nextType     = type of next
      !this.previousType = type of prev
   endif

!!ce = !return

endmethod
------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .getSif()

  !this.sif = 0
  if !this.component.type.eq('BRAN') then
        !this.sif = 0
        return
  endif

 !this.sif = !this.getProperty('SIF','0').real().nint()
 handle ANY
      !this.sif = 0
 endhandle

endmethod
