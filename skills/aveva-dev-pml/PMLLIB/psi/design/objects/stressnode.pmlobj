--------------------------------------------------------------------------------------
define method  .getBendType(!comp is DBREF)
-- method to see if there is a flange within a certain distance of the arrive and leav of the current
-- elbo or bend

!this.bendType = 0

!next = next
!prev = prev
!plod = pl od


 if !prev.type.eq('FLAN') and !prev.ltLength.lt(!plod) then
   !this.bendType = 1
   --$P before is flan and type = 1
   --q var !comp.name
   if !next.type.eq('FLAN') and !comp.ltLength.lt(!plod) then
     !this.bendType = 2
     --$P next is flan and type = 2
     --q var !comp.name
   endif
 endif


endmethod
