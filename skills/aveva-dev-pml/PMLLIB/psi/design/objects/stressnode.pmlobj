-------------------------------------------------------------------------------------
-- method for getting the current component weight
define method .getWeight()

  !this.rigidWeight = 0
  !this.weight = 0
  if !this.component.type.eq('BRAN') then
        !this.weight = 0
        return
  endif

  !this.weight = !this.getProperty('Weight','0').real()
  handle ANY
    !this.weight = 0
  endhandle

endmethod
