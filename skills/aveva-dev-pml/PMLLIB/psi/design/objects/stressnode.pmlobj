--------------------------------------------------------------------------------------
define method .stressNode(!lines is ARRAY)


!this.status = 'Undefined'
!a = 1
do
  !a = !a + 1
  if !lines[!a].match('/>').gt(0) then
     -- its a line with no value returned
     if !lines[!a].match('Endpoint').gt(0) then
        -- its a new component from analysis
        !this.point = 0
     else
        skip
     endif
  elseif !lines[!a].eq('<Load>') then
    !this.readLoads(!lines,!a)
    break
  elseif !lines[!a].eq('</Node>') then
    break
  elseif !lines[!a].eq('<Restraint>') then
     !a = !this.readRestraint(!lines, !a)
     skip
  elseif !lines[!a].eq('</Restraint>') then
     skip
  endif

  !varName = !lines[!a].after('<').before('>')
  !value   = !lines[!a].after('>').before('<')
  -- run th method appropriate to the type of attribute we are parsing
  !this.$!<varName>(!value)
  handle ANY
         if !varName.upcase() inset('STIFFNESS','GAP','FRICTION','TYPE') then
            --  q var !varName
            --  q var !!error
         endif

  endhandle
enddo

  if !this.component.type.eq('ATTA') then
     !this.getActualTube(!this.component)
  endif

!this.position.origin = /*

-- for this constructor method we need to compile the saveData in a different way
-- we also need a new constructor method to build nodes from the final string


endmethod
--------------------------------------------------------------------------------------


--------------------------------------------------------------------------------------
-- method to read the saved nodes for a particular case group
define method .stressNode(!textName is ARRAY,!number is REAL)

-- text format is
-- 50,=15392/26313,E 6867 N 5385.200195 U 1490 WRT /*,0,E0N0U0,STD
-- 105,Unset,E 5360 N 5385.200195 U 5390,  ,Unset,New,Z, , ,
  if !textName[1].badref() then
    return
  endif

 !real = FALSE

 !this.number = !number
 !split = !textName[1].stext.split(',')
 handle any
   return
 endhandle
 !this.nodeNumber = !split[1].real()
 if !this.nodeNumber.eq(-1) then
      !this.nodeNumber = object REAL()
 endif
 !this.component = !split[2].dbref()
 handle ANY
    !this.componentType = !split[2]
 elsehandle NONE
   !this.componentType = !this.component.type
   !real = TRUE
 endhandle
 !this.position = !split[3].position()
 handle ANY
 endhandle
 !this.point = !split[4].real()
 handle ANY
   !this.point = -1
 endhandle
 !this.componentType = !split[5]
  handle ANY
        --$P $!!error.text
 endhandle
 !this.deflection = !split[6].position()
 handle ANY
 endhandle
 !this.status = !split[7]
 handle ANY
        --$P $!!error.text
 endhandle
 if defined(!textName[2]) then
   !split = !textName[2].stext.split(',')
   !this.restraintGroup.addRestraintTexts(!split)
 else
   -- now do the restraints
   if !split[8].neq('') then
       -- we have an old type restraint
       !this.restraintGroup.addRestraintTexts(!split)
   endif
 endif

 if !real then
   !this.getOd()
   !this.getBore()
 endif

endmethod
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
-- new method for getting the data after building the node from a rest element
-- for some reason it does not do the same thing as the method it was copied from
define method .getData()

  !comp = !this.component
  !!ce = !this.component
    handle ANY
      return
    endhandle
  -- set the type of the component
  !this.componentType = !comp.type
  -- if we are dealing with a branch, get extra information
  if !comp.type.eq('BRAN') then
     !!ce = !comp
     !this.branchData(!comp)
  elseif !comp.type inset('TEE','OLET','VTWA') then
     !this.connection = !comp.cref
  elseif !comp.type inset('BEND','ELBO') then
     !this.getRadius()
  endif
  -- find the appropriate wall thickness
  !this.getWallThickness()
  -- find the corrosion allowance
  !this.getCora()
  -- get the pipe od
  !this.getOd()
  -- get the insulation material
  !this.getInsulation()
  -- get the position of the current node
  !this.getPosition()
  -- get the length of leave tube of the current component
  !this.getILTube()
   -- get the component weight
  !this.getWeight()
  -- get the current ppoint bore
  !this.getBore()

  -- get the previous and next component
  !this.getAdjacent()

  !this.getSif()

  !test = !this.component.:nodeType
  handle ANY
  elsehandle NONE
    !this.restraintGroup = object PSIRESTRAINTGROUP(!comp)
    !this.restLines  = !this.restraintGroup.getOutputLines()
  endhandle

endmethod
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
-- method to read the matching case deflection for a particular load case
define method .applyCaseList(!case is STRING)is CASECOMPONENT

   !return = object CASECOMPONENT()

   do !a values !this.caseList
   --q var !this.caseList
      if !a.casename.eq(!case) then
         !this.deflection = !a.translation
         return !a
      endif
   enddo

  return !return
  --if there is a matching case, return the appropriate CASECOMPONENT

endmethod


--------------------------------------------------------------------------------------
define method .readLoads(!lines is ARRAY,!line is REAL)

-- we know that !lines[!line] is a node so expect three more lines
do !a from !line to !lines.size()
  if !lines[!a].eq('</Node>') then
    return
  elseif   !lines[!a].eq('<Load>') then
   !nodeLines = !lines.from(!a,5)
   !this.caseList.append(object CASECOMPONENT(!nodeLines,!this.component,!this.point))
  endif
enddo

endmethod
