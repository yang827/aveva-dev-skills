--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  Endpoint(STRING)                 -
--  alphaAngle(STRING)               -
--  applyCaseList(STRING)            CASECOMPONENT
--  bendRadius(STRING)               -
--  branchData(DBREF)                -
--  compileSaveData()                ARRAY
--  componentRefNo(STRING)           -
--  componentType(STRING)            -
--  drawNode()                       -
--  friction(STRING)                 -
--  gap(STRING)                      -
--  getActualTube(DBREF)             -
--  getAdjacent()                    -
--  getAttaTube()                    REAL
--  getBendType(DBREF)               -
--  getBore()                        -
--  getCora()                        -
--  getData()                        -
--  getILTube()                      -
--  getInsulation()                  -
--  getName()                        -
--  getOd()                          -
--  getPosition()                    -
--  getProperty(STRING,STRING)       STRING
--  getPropertyList(STRING,STRING)   ARRAY
--  getRadius()                      -
--  getSif()                         -
--  getWallThickness()               -
--  getWeight()                      -
--  insulationThickness(STRING)      -
--  makenodeLines(BOOLEAN)           ARRAY
--  modStat(STRING)                  -
--  newPosition(STRING)              -
--  nodeNumber(STRING)               -
--  outsideDiameter(STRING)          -
--  position(STRING)                 -
--  psiRestType(REAL)                STRING
--  readLoads(ARRAY,REAL)            -
--  readRestraint(ARRAY,REAL)        REAL
--  rigid(STRING)                    -
--  setpPoint()                      -
--  sif(STRING)                      -
--  status(STRING)                   -
--  stiffness(STRING)                -
--  stressNode(ARRAY)                -
--  stressNode(ARRAY,REAL)           -
--  stressNode(DBREF,REAL,REAL)      -
--  type(STRING)                     -
--  unDrawNode()                     -
--  wallThickness(STRING)            -
--  weight(STRING)                   -
--

-- Define Object
define object STRESSNODE

  member .number              is REAL       $* sequence number
  member .nodeNumber          is REAL       $* actual node number passed to the stress package
  member .nodeName            is STRING     $* the node name extracted via an expression
  member .componentName       is STRING     $* this is the name of the actual component - transferred to other nodes
  member .nodeNamePoint       is REAL       $* the numbered node point to which the node name is added
  member .bore                is BORE       $* bore (Added to make the node form more readable)
  member .component           is DBREF      $* pdms component reference
  member .componentType       is STRING     $* component type the node is associated with
  member .connection          is DBREF      $* if the component is connected to something then this is its cref/href/tref
--  member .ConnectionType      is STRING     $* the type of the connection if set
  member .linkedNode          is DBREF      $* previous, next and branch node number
  member .connectedEnd        is STRING     $* the end of the connected item head or tail
  member .position            is POSITION   $* position of the node in world coordinates
  member .newPosition         is POSITION   $* new position after stressing
  member .wallThickness       is REAL       $* node wall thickness
  member .corrosionAllowance  is REAL       $* corrosion allowance
  member .pPoint              is REAL       $* actual point we are dealing with
  member .point               is REAL       $* node point 0 = origin 1 = pa 2 = pl (for bran 1 = ph 2 = pt)
  member .lines               is ARRAY      $* ARRAY of output lines in xml format
  member .branchLines         is ARRAY      $* if the component type is branch these are the branch output lines in xml
  member .outsideDiameter     is REAL       $* this is the pipe od
  member .insulationMat       is STRING     $* current node insulation material
  member .insulationThickness is REAL       $* current node insulation thickness
  member .material            is STRING     $* current component material. set if different to branch
  member .weight              is REAL       $* weight of the current component
  member .aTubeLength         is REAL       $* length of arrive tube for each component
  member .lTubeLength         is REAL       $* length of leave tube for each component
  member .bendRadius          is REAL       $* the radius of the current bend
  member .rigid               is STRING     $* flag to say if the node is the end of a rigid
  member .typeOfConnection    is STRING     $* the type of element a branch node is connected to
  member .errorLines          is ARRAY      $* list of errors encountered in getting data
  member .errorFlag           is BOOLEAN    $* boolean to indicate if the node built with errors
  member .rigidWeight         is REAL       $* if is a rigid, we output the total weight
  member .alphaAngle          is REAL       $* alpha angle for reducers
  member .previousType        is STRING     $* type of component before the item
  member .nextType            is STRING     $* type of component after  the item
  member .temperature         is REAL
  member .pressure            is REAL
  member .sif                 is REAL
  member .restLines           is ARRAY      $* if the component is a restraint this holds the details
  member .caseList            is ARRAY      $* an array of CASECOMPONENTs
  member .modified            is BOOLEAN
  member .restraint           is STRING
  member .type                is STRING
  member .stiffness           is STRING
  member .gap                 is STRING
  member .friction            is STRING
  member .actualComponent     is STRING
  member .load                is REAL
  member .deflection          is POSITION
  member .rotation            is DIRECTION
  member .status              is STRING
  member .bendType            is REAL       $* bend type can be 0 1 or 2 depending on adjacent flanges
  member .ignoredList         is ARRAY      $* array to store any ignored components to get the ltlength
  member .restraintGroup      is PSIRESTRAINTGROUP      $* group to store multiple restraints using

endobject
--------------------------------------------------------------------------------------


--------------------------------------------------------------------------------------
-- constructor method
-- used by the stress group object to create a series of nodes
-- this is the standard method used by the original parsing mechanism
define method .stressNode(!comp is DBREF,!end is REAL,!nodeNumber is REAL)

  !this.errorFlag = FALSE
  !this.bendRadius = 0
  !this.bendType = 0
  !this.insulationThickness = 0

  -- the node point 0,1,2,3 to indicate origin, start or end or p3 respectively
  !this.point = !end
  -- set the component ref of the node
  !this.component = !comp
  -- go and get the appropriate ppoint
  !this.setpPoint()

  -- set the type of the component
  !this.componentType = !comp.type
  -- if we are dealing with a branch, get extra information
  if !comp.type.eq('BRAN') then
     !!ce = !comp
     !this.branchData(!comp)
  elseif !comp.type inset('TEE','OLET','VTWA') then
     !this.connection = !comp.cref
  elseif !comp.type inset('BEND','ELBO') then
     !this.getRadius()
     !this.bendType = 0
  --   !this.getBendType(!comp)
  --ew inserted case for cross
  elseif !comp.type inset('CROS') then
      !this.connection = !comp.crfArray[!end]
  endif
  -- find the appropriate wall thickness
  !this.getWallThickness()
  -- get the corrosion allowance
   !this.getCora()
  -- save the current node number
    !this.number = !nodeNumber
  -- get the pipe od
  !this.getOd()
  -- get the insulation material
  !this.getInsulation()
  -- get the position of the current node
  !this.getPosition()
  -- get the length of leave tube of the current component
  !this.getILTube()
   -- get the component weight
  !this.getWeight()
  -- get the current ppoint bore
  !this.getBore()

  -- get the previous and next component
  !this.getAdjacent()

  !this.getSif()
  -- if the component has the attribute :nodeType we need to add restraint data
  !test = !this.component.:nodeType
  handle any
  elsehandle NONE
    !this.restraintGroup = object PSIRESTRAINTGROUP(!comp)
    !this.restLines  = !this.restraintGroup.getOutputLines()
  endhandle

  -- get the name of a current name rule
  !this.getName()

endmethod
