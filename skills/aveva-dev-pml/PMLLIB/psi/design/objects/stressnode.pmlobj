--------------------------------------------------------------------------------------
-- method to put aid text at each node
define method .drawNode()

  if !this.nodeNumber.unset().or(!this.nodeNumber.eq(-1)).or(!this.nodeNumber.eq(-2))then
    return
  endif

  !number = !this.nodeNumber + 3678
  if (!this.componentType eq 'ATTA') then
     !text = 'S' & '$!this.nodeNumber'
   else
     !text = '$!this.nodeNumber'
  endif
  aid text number $!number '$!text' at $!this.position
  handle ANY
  endhandle


endmethod
--------------------------------------------------------------------------------------

--------------------------------------------------------------------------------------
-- method to remove aid text for nodes
define method .unDrawNode()

  if !this.nodeNumber.unset() then
    aid Clear text all
    return
  endif
  !number = !this.nodeNumber + 3678
  aid clear text $!number
  handle ANY
      aid clear text all
  endhandle

endmethod
--------------------------------------------------------------------------------------

------------------------------------------------------------------------------
define method .getProperty(!prop is STRING,!default is STRING)is STRING

--$p property is $!prop
-- get the material from either the spec or matx
-- this depends on an option in the defaults file
-- e.g. select material from spec, tube or both
-- if both is used, it looks at the tube first then the spec if the tube is not set
-- this is based on the uda :MATNUM on solid and smte


   -- the property passed through is in the form prop + 'array' such as MATERIALARRAY
   -- to loop through the list of
   if !!psidefaults.$!<prop>array.size().eq(0) then
         !this.errorFlag = TRUE
         !this.errorLines.append('No $!prop Definition Expressions')
         return !default
   endif

   -- this loops through the expressions available for a property and returns the first none default result
   -- it does not matter how many expressions are in the list it will always return the first valid result.
   do !a values !!psidefaults.$!<prop>array
      !exp = object PSIEXPRESSION(!a,!this)
      !mat = !exp.evaluate()
      if !mat[1].eq(1) then $* there has been an error so add it to the ARRAY
         !this.errorFlag = TRUE
         !this.errorLines.append('Error in $!prop Definition')
         !this.errorLines.append('$!mat[2]')
         !mat[3] = ''
      elseif !mat[3].neq(!default) then
         -- its found a valid value so it does not need to look further
         return !mat[3]
         break
      endif
   enddo

   return !default

endmethod
------------------------------------------------------------------------------

-- new method for getting multiple properties like pipe support details
------------------------------------------------------------------------------
define method .getPropertyList(!prop is STRING,!default is STRING)is ARRAY


-- get the material from either the spec or matx
-- this depends on an option in the defaults file
-- e.g. select material from spec, tube or both
-- if both is used, it looks at the tube first then the spec if the tube is not set
-- this is based on the uda :MATNUM on solid and smte

   if !!psidefaults.$!<prop>array.size().eq(0) then
         !this.errorFlag = TRUE
         !this.errorLines.append('No $!prop Definition Expressions')
         return !default
   endif

   do !a values !!psidefaults.$!<prop>array
      !exp = object PSIEXPRESSION(!a,!this)
      !mat = !exp.evaluate()
      if !mat[1].eq(1) then $* there has been an error so add it to the ARRAY
         !this.errorFlag = TRUE
         !this.errorLines.append('Error in $!prop Definition')
         !this.errorLines.append('$!mat[2]')
         !mat[3] = ''
      elseif !mat[3].neq(!default) then
         -- its found a valid value so it does not need to look further
         return !mat[3]
         break
      endif
   enddo

   return !default

endmethod
-----------------------------------------------------------------------------
define method .setpPoint()
-- method to work out the ppoint being used

if !this.component.type.eq('BRAN') then
  !this.pPoint = !this.point
  return
endif

if !this.point.eq(1) then
  !this.pPoint = !this.component.arrive
elseif !this.point.eq(2) then
  !this.pPoint = !this.component.leave
else
  !this.pPoint = !this.point
endif


endmethod

------------------------------------------------------------------------------
-- method to set the atlength and lt length of the return stress nodes.
define method .getActualTube(!component is DBREF )

if !component.type.neq('ATTA') then
   !this.aTubeLength = !component.atlen
   !this.lTubeLength = !component.ltlen
   return
endif
-- now we are only looking at an atta
if !component.spkbrk then
   !this.aTubeLength = !component.atlen
   !this.lTubeLength = !component.ltlen
else
-- its an offline atta
-- arrive tube
   if !component.sequence.eq(1) then
     !bran = !component.owner
     var !atlen const distance Ph of $!bran to pa of $!component
   else
     !comp = !component.owner.members[!component.sequence - 1]
     var !atlen const distance Pl of $!comp to pa of $!component
   endif
   !this.aTubeLength = !atlen.real()
    handle ANY
      --q var !!error
   endhandle

-- leave tube
   if !component.sequence.eq(!component.owner.members.size()) then
     !bran = !component.owner
     var !ltlen const distance Pl of $!component to pt of $!bran

   else
     !comp = !component.owner.members[!component.sequence + 1]
     var !ltlen const distance Pl of $!component to pa of $!comp
   endif
   !this.lTubeLength = !ltlen.real()
endif

endmethod
