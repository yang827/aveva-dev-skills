-- method to read restraints returned from the xml file
define method .readRestraint(!lines is ARRAY, !index is REAL)is REAL

      !rest = object PSIRESTRAINT(!lines,!index,!this.nodeNumber)
      !this.restraintGroup.restraints.append(!rest)
      return !rest.lineNumber

endmethod
