--
-- File:            rtrcopyconstraints.pmlfrm
--   Type:          Form Definition
--   Group:         Router application
--     Keyword:     RTR
--   Module:        router
--   Replaces:      --
--
-- Author:          Patricia Gardener
-- Created:
--
--
-- Description:
-- Copy constraints (from 1 branch in Router form to others)
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  copy()                           -                   copy the constraints
--  fromCheck()                      -                   check 'from' branch has constraints
--  fromOK()                         BOOLEAN             report if 'from' branch has constraints
--  initialise()                     -                   initialisation
--  refresh()                        -                   refresh lists (because something has changed)
--  rtrCopyConstraints()             -                   Constructor.
--
------------------------------------------------------------------------

setup form !!rtrCopyConstraints

  title    |Copy Constraints|
  iconti   |Copy Constraints|
  revision | $$Revision: 1.7 $ |

  !this.callback = |!this.initialise()|

  path right
  list _from |From| SINGLE width 32 length 12
  hdist 0.2
  list _to |To  | MULTIPLE width 32 length 12

  path down
  vdist 0.5

  button _apply  | Apply | at xmin_from apply
  button _cancel |Dismiss| at xmax form-size ymin cancel

-- End of form definition for !!rtrCopyConstraints
exit

------------------------------------------------------------------------
--
-- Method:      .rtrCopyConstraints()
--
-- Description: Constructor.
--
------------------------------------------------------------------------

define method .rtrCopyConstraints()

  -- Callbacks
  !this.from.callback     = |!this.fromCheck()|
  !this.apply.callback    = |!this.copy()|

endmethod
-- End of method definition for .rtrCopyConstraints()

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .initialise()

  !this.refresh()

  if ( !this.from.dtext.size() eq 0 ) then
    !string = !!messageFile.messageString(162, 120)
    return error 1 |$!string|
  elseif ( !this.to.dtext.size() eq 0 ) then
    !string = !!messageFile.messageString(162, 121)
    return error 2 |$!string|
  endif

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      .refresh()
--
-- Description: refresh lists (because something has changed)
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .refresh()

  !fromDtext = ARRAY()
  !toDtext   = ARRAY()

  do !branch values !!cdRouter.pipeList.rText

    if ( !!rtrNumberOfConstraints ( !branch.dbRef() ) eq 0 ) then
      !toDtext.append(!branch.dbRef().name)
    else
      !fromDtext.append(!branch.dbRef().name)
    endif
  enddo

  !this.to.dtext   = !toDtext
  !this.from.dtext = !fromDtext

endmethod
-- End of method definition for .refresh()

------------------------------------------------------------------------
--
-- Method:      .fromCheck()
--
-- Description: check 'from' branch has constraints
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .fromCheck()

  if ( not !this.fromOK() ) then
    -- Branch no longer constrained. Refresh lists & return
    !branch = !this.from.selection()
    !this.refresh()
    !!messageFile.error(162, 19, !branch)
  endif

endmethod
-- End of method definition for .fromCheck()

------------------------------------------------------------------------
--
-- Method:      .fromOK()
--
-- Description: report if 'from' branch has constraints
--
-- Method Type: Function
--
------------------------------------------------------------------------

define method .fromOK() is BOOLEAN

  !branch = !this.from.selection()

  return ( !!rtrNumberOfConstraints( !branch.dbRef() ) gt 0 )

endmethod
-- End of method definition for .fromOK() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      .copy()
--
-- Description: copy the constraints
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .copy()

  !fromBranch = !this.from.selection()
  if ( !fromBranch eq '' ) then
    !this.refresh()
    return
  endif

  !oldCe = !!ce

  if ( !this.fromOK() ) then

    do !toBranch values !this.to.selection()
      !!ce = !toBranch.dbRef()

      if ( !!rtrNumberOfConstraints( !!ce ) eq 0 ) then

        ROUTER
        COPYCONSTRAINT $!fromBranch
        handle ( 2, 583 )
          !!messageFile.warning(162, 21, !!ce.name)
        endhandle
        EXIT
      else
        !this.refresh()
        !!messageFile.error(162, 20, !!ce.name)
      endif
    enddo
  else
    !this.refresh()
    !!messageFile.error(162, 19, !fromBranch)
  endif

  -- Expect which branches have constraints to change so refresh
  !this.refresh()
  !this.from.select( 'RTEXT', !fromBranch )
  handle (61, 567 )
    -- fromBranch no longer in Main Router form
  endhandle

  !!ce = !oldCe

endmethod
-- End of method definition for .copy()
