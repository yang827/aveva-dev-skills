------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            rtrcreaterack.pmlfrm
--   Type:          Form Definition
--   Group:         Router application
--     Keyword:     RTR
--   Module:        router
--   Replaces:      FCHPRACK
--
-- Author:          Patricia Gardener
-- Created:
--
--
-- Description:
-- Create a pipe-rack for Router (either by converting structure or
--                                       by creating stand-alone planes )
-- Or Modify existing pipe-rack
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add()                            -                   Add data for new RPLA to rplaData array
--  aidBox()                         -                   Show AID box for plane
--  anchor()                         -                   If true, display positions wrt anchor plane
--  changeCornerPosition()           -                   Corner Position of rack changed - change length and width.
--  changeElevation()                -                   Change stored Height for current RPLA
--  changeFunction()                 -                   Change stored function for current RPLA
--  changeGapType()                  -                   Change stored gap-type for current RPLA
--  changeLength()                   -                   Length of rack changed - move current corner,
--  changeOverhang()                 -                   Change stored Ylength for current RPLA when
--  changePackMethod()               -                   Change stored pack method for current RPLA
--  changePipePositioning()          -                   Change stored pipe positioning for current RPLA
--  changePurpose()                  -                   Change purpose RPLA
--  changeWidth()                    -                   Width of rack changed - move current corner,
--  convert()                        -                   prepare to obtain details of geometry & planes from structure
--  convertStructure(DBREF)          -                   obtain details of geometry & planes from structure
--  cornerFromPick(EDGPOSITIONDATA)  -                   called by EDG to define length and width of Rack from
--  cornerPick()                     -                   initiates EDG to define corner of Rack
--  createPlanes()                   -                   Create RPLG and go on to obtain details of planes
--  currentRpla()                    REAL                For the current Plane in !this.members find its position
--  default()                        -                   initialise with default values
--  dismiss()                        -                   Delete aid box
--  displayCorner()                  -                   display of other corner selected
--  findInnerCorners(DBREF,DBREF)    -                   determine width from corner elements of STRU
--  initialise()                     -                   initialisation
--  lengthMeasure(LINE)              -                   Respond to EDG measure of length
--  levelFromPick(EDGPOSITIONDATA)   -                   called by EDG to define height of Plane from
--  levelPick()                      -                   initiates EDG to define height of plane
--  listPlanes()                     -                   fill in list of planes in RPLG
--  lockX()                          -                   toggle on xLock
--  lockY()                          -                   toggle on yLock
--  lockZ()                          -                   toggle on zLock
--  measureLength()                  -                   Initiate EDG to measure length
--  measureOverhang()                -                   Initiate EDG to measure overhang
--  measureWidth()                   -                   Initiate EDG to measure width
--  modify()                         -                   Modify data for selected RPLA
--  modifyAll()                      -                   change property for ALL planes
--  modifyRack()                     -                   Form is being used for modify (rather than create) rack
--  nameCheck()                      -                   method when name typed in
--  newRplaData()                    RTRRPLA             Create new rplaData object for current data
--  overhangMeasure(LINE)            -                   Respond to EDG measure of overhang
--  refreshGadgetCoord()             -
--  remove()                         -                   Delete selected RPLA
--  rtrCreateRack()                  -                   Constructor.
--  selectPlane()                    -                   display details of selected plane ( can be generic
--  showCornerPosition()             -                   Use data from Form and corner member data
--  showDimensions()                 -                   display length and width.
--  stage1()                         -                   Re-active stage1 fields
--  stage2()                         -                   Rack defined; now refine
--  swapCorner()                     -                   method corner changed
--  swapDirection()                  -                   method direction changed
--  widthMeasure(LINE)               -                   Respond to EDG measure of width
--  wrt()                            -                   Change origin of displayed positions
--
------------------------------------------------------------------------

setup form !!rtrCreateRack

  title    |Create Pipe Rack|
  iconti   |Define Rack|
  revision | $$Revision: 1.10 $ |

  !this.callback = '!this.initialise()'

  -- Icons

  !measureIcon = !!pml.getPathName('measure16.png')
  !pickIcon    = !!pml.getPathName('navigate16.png')

  path down
  vdist 0.2
  text _name |Name     | width 20 name
  para _struText text |in STRU |
  para _stru at xmax_struText ymin_struText text || width 20 lines 1

  option _convertType   at xmin_struText || width 4
  path right
  button _convertButton |Convert...|

  option _rackDir |             Rack Direction | width 14

  path down

  frame _dimensions  |Dimensions:| at xmin_struText

    option _corner width 8
    path right
    button _pickCorner |Pick| tooltip 'Pick Corner of Rack' pixmap sel "$!<pickIcon>" width 16 height 16

    para _lock at xmax_pickCorner+6 ymax_pickCorner text |Lock|

    option _x1O at xmin_corner ymax_lock width 5
    text _x1 width 10 is REAL format !!distanceFmt
    toggle _xLock

    option _y1O at xmin_corner ymax_x1O width 5
    text _y1 width 10 is REAL format !!distanceFmt
    toggle _yLock

    option _z1O at xmin_corner ymax_y1O width 5
    text _z1 width 10 is REAL format !!distanceFmt
    toggle _zLock

    text _length |   Length of Rack         | at xmax_lock ymin_xLock width 10 is REAL format !!distanceFmt
    button _lengthButton |Pick| tooltip 'Length of Rack' pixmap sel "$!<measureIcon>" width 16 height 16
    path down
    text _width  |   Width of Travel planes | at xmax_lock width 10 is REAL format !!distanceFmt
    path right
    button _widthButton |Pick| tooltip 'Width of Rack' pixmap sel "$!<measureIcon>" width 16 height 16

  exit
  path down

  text  _datum at xmin_struText |Positions Wrt | width 25 name
  path right
  toggle _wrtAnchor |Wrt Anchor Plane|

  path down
  button _createButton at xmin_struText+7 |Create Multiple Planes...|
  path right
  button _modifyButton at xmax_createButton+9 |Modify All Planes...|
  path down

  frame _planeDetails at xmin_struText |Plane attributes:|

    option _purpose |Purpose   | width 10
    text _elevation |Elevation | width 10 is REAL format !!distanceFmt
    path right
    button _pickLevel |Pick| tooltip 'Pick Level of plane' pixmap sel "$!<pickIcon>" width 16 height 16

    path down
    text _overhang  |Overhang  | at xmin_purpose width 10 is REAL format !!distanceFmt
    path right
    button _overhangButton |Pick| tooltip 'Overhang of Entry/Exit planes' pixmap sel "$!<measureIcon>" width 16 height 16

    path down
    text _function |  Function         | at xmax_purpose+3 ymin_purpose width 20 STRING

    option _plpp   |  Pipe Positioning | width 18
    option _plww   |  Pipe to Pipe Gap | width 18
    option _plpm   |  Packing Method   | width 18

  exit

  button _addPlane at xmin_struText+8 |Include|
  path right
  button _modifyPlane at xmin_struText+30 |Replace|
  button _deletePlane at xmin_struText+52 |Remove|

  path down
  list _members |Planes| at xmin_struText SINGLE width 65 length 10

  vdist 0.5

  button _cancel |Dismiss| at xmin_modifyPlane ok

 -- Members

  member .rplg is DBREF
  member .corner1Position is POSITION
  member .corner2Position is POSITION
  member .currentRplaData is RTRRPLA
  member .rplaData is ARRAY
  member .anchorNumber is REAL
  member .aidArrowNumber is REAL

-- End of form definition for !!rtrCreateRack
exit

------------------------------------------------------------------------
--
-- Method:      .rtrCreateRack()
--
-- Description: Constructor.
--
------------------------------------------------------------------------

define method .rtrCreateRack()

  !this.refreshGadgetCoord()

  !dtext[1] = |STRU|
  !dtext[2] = |FRMW|
  !dtext[3] = |SBFR|
  !this.convertType.dtext = !dtext

  !dtext.clear()

  !dtext[1] = |Corner 1|
  !dtext[2] = |Corner 2|
  !dtext[3] = |Centre  |
  !this.corner.dtext = !dtext

  !dtext.clear()

  !dtext[1] = |Centre of pipe|
  !dtext[2] = |Bottom of pipe|
  !dtext[3] = |Top of pipe|
  !rtext[1] = |CENT|
  !rtext[2] = |ABOV|
  !rtext[3] = |BELO|
  !this.plpp.dtext = !dtext
  !this.plpp.rtext = !rtext

  !dtext.clear()
  !rtext.clear()

  !dtext[1] = |Wall to Wall|
  !dtext[2] = |Wall to Flange|
  !dtext[3] = |Flange to Flange|
  !rtext[1] = |WW|
  !rtext[2] = |WF|
  !rtext[3] = |FF|
  !this.plww.dtext = !dtext
  !this.plww.rtext = !rtext

  !dtext.clear()
  !rtext.clear()

  !dtext[1] = |Nearest edge|
  !dtext[2] = |By Weight|
  !rtext[1] = |NEAR|
  !rtext[2] = |WEIG|
  !this.plpm.dtext = !dtext
  !this.plpm.rtext = !rtext

  !dtext.clear()
  !rtext.clear()

  !dtext[1] = |Travel|
  !dtext[2] = |Entry/Exit|
  !rtext[1] = |PRRP|
  !rtext[2] = |PREX|
  !this.purpose.dtext = !dtext
  !this.purpose.rtext = !rtext

  !dtext.clear()
  !rtext.clear()

  -- Callbacks
  !this.name.callback          = |!this.nameCheck()|
  !this.corner.callback        = |!this.swapCorner()|
  !this.rackDir.callback       = |!this.swapDirection()|
  !this.length.callback        = |!this.changeLength()|
  !this.lengthButton.callback  = |!this.measureLength()|
  !this.width.callback         = |!this.changeWidth()|
  !this.widthButton.callback   = |!this.measureWidth()|
  !this.x1.callback            = |!this.changeCornerPosition()|
  !this.x1O.callback           = |!this.changeCornerPosition()|
  !this.y1.callback            = |!this.changeCornerPosition()|
  !this.y1O.callback           = |!this.changeCornerPosition()|
  !this.z1.callback            = |!this.changeCornerPosition()|
  !this.z1O.callback           = |!this.changeCornerPosition()|
  !this.xLock.callback         = |!this.lockX()|
  !this.yLock.callback         = |!this.lockY()|
  !this.zLock.callback         = |!this.lockZ()|
  !this.pickCorner.callback    = |!this.cornerPick()|
  !this.datum.callback         = |!this.wrt()|
  !this.wrtAnchor.callback     = |!this.anchor()|
  !this.createButton.callback  = |!this.createPlanes()|
  !this.modifyButton.callback  = |!this.modifyAll()|
  !this.convertButton.callback = |!this.convert()|
  !this.members.callback       = |!this.selectPlane()|
  !this.purpose.callback       = |!this.changePurpose()|
  !this.function.callback      = |!this.changeFunction()|
  !this.plpp.callback          = |!this.changePipePositioning()|
  !this.plpm.callback          = |!this.changePackMethod()|
  !this.plww.callback          = |!this.changeGapType()|
  !this.elevation.callback     = |!this.changeElevation()|
  !this.pickLevel.callback     = |!this.levelPick()|
  !this.overhang.callback      = |!this.changeOverhang()|
  !this.overhangButton.callback = |!this.measureOverhang()|
  !this.addPlane.callback      = |!this.add()|
  !this.modifyPlane.callback   = |!this.modify()|
  !this.deletePlane.callback   = |!this.remove()|
  !this.okCall                 = |!this.dismiss()|

  -- Members

  !this.aidArrowNumber = !!aidNumbers.add('Router Rack')

endmethod
-- End of method definition for .rtrCreateRack()

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .initialise()

  !this.formTitle = 'Create Pipe Rack'

  var !coordinate coordinate
  !coordXYZ = !coordinate.eq('XYZ')

  -- refresh only if the co-ordinate system is changed before display
  !x1Oval = !this.x1O.dtext[1].trim().upcase()
  if (  (!x1Oval.eq('EAST') and  !coordXYZ )  or (!x1Oval.eq('X') and  !coordXYZ.not() ) ) then
     !this.refreshGadgetCoord()
  endif

  !oldCe = !!ce

  -- make sure that the user is at a STRU or can navigate to a STRU

  STRU
  handle any
    !!messageFile.error( 162, 1)
  endhandle

  -- connect form to current structure
  !this.stru.val = !!ce.fullName

  -- and find position
  !this.corner1Position = !!ce.position.wrt( /* )
  !this.corner2Position = !!ce.position.wrt( /* )

  !!ce = !oldCe

  !this.name.val = ''

  -- select defaults
  !this.default()

  !this.members.dtext = ARRAY()
  !this.members.rtext = ARRAY()

  -- type to convert depends on type of ce

  if ( !!ce.type eq 'FRMW' ) then
    !this.convertType.select('DTEXT', 'FRMW')
  elseif( !!ce.type eq 'SBFR' ) then
    !this.convertType.select('DTEXT', 'SBFR')
  else
    !this.convertType.select('DTEXT', 'STRU')
  endif

  -- ensure first stage fields active

  !this.stage1()

  -- grey out later parts of form

  !this.createButton.active    = false
  !this.modifyButton.active    = false
  !this.wrtAnchor.active       = false
  !this.purpose.active         = false
  !this.elevation.active       = false
  !this.pickLevel.active       = false
  !this.overhang.active        = false
  !this.overhangButton.active  = false
  !this.function.active        = false
  !this.plpp.active            = false
  !this.plww.active            = false
  !this.plpm.active            = false
  !this.addPlane.active        = false
  !this.modifyPlane.active     = false
  !this.deletePlane.active     = false

endmethod
-- End of method definition for .initialise()
------------------------------------------------------------------------
--
-- Method:refreshGadgetCoord
--
-- Description:refresh the gadgets related to the present coordinate system
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .refreshGadgetCoord()

  var !coordinate coordinate
  !coordXYZ = !coordinate.eq('XYZ')

  -- Arrays
  if (!coordXYZ) then
    !dtext[1] = |X / -X|
    !dtext[2] = |Y / -Y|
  else
    !dtext[1] = |North/South|
    !dtext[2] = |East/West|
  endif
  !rtext[1]   = 'North'
  !rtext[2]   = 'East'

  !this.rackDir.dtext  = !dtext
  !this.rackDir.rtext  = !rtext

  !dtext.clear()
  !rtext.clear()

  if (!coordXYZ) then
     !dtext[1] = | X|
     !dtext[2] = |-X|
  else
     !dtext[1] = |East  |
     !dtext[2] = |West |
  endif

  -- use this rtext for all gadgets
  !rtext[1] = |1|
  !rtext[2] = |-1|

  !this.x1O.dtext = !dtext
  !this.x1O.rtext = !rtext

  !dtext.clear()

  if (!coordXYZ) then
   !dtext[1] = | Y|
   !dtext[2] = |-Y|
  else
   !dtext[1] = |North|
   !dtext[2] = |South|
  endif

  !this.y1O.dtext = !dtext
  !this.y1O.rtext = !rtext

  !dtext.clear()

  if (!coordXYZ) then
      !dtext[1] = | Z|
      !dtext[2] = |-Z|
  else
      !dtext[1] = | Up  |
      !dtext[2] = |Down |
  endif

  !this.z1O.dtext = !dtext
  !this.z1O.rtext = !rtext

 endmethod
------------------------------------------------------------------------
--
-- Method:      .default()
--
-- Description: initialise with default values
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .default()

  -- select defaults
  !this.datum.val = '/*'
  !this.wrtAnchor.val = false

  !this.rackDir.select('RTEXT', 'North')
  !this.purpose.select('DTEXT', 'Travel')

  !this.length.val = 0
  !this.width.val  = 0

endmethod
-- End of method definition for .default()

------------------------------------------------------------------------
--
-- Method:      .modifyRack( )
--
-- Description: Form is being used for modify (rather than create) rack
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .modifyRack( )

  !this.formTitle = 'Modify Pipe Rack'
  !this.convertButton.active = false
  !this.rplg = !!ce
  !this.name.val = !!ce.name

  -- Find anchor plane (i.e. first Travel plane)
  do !rpla values !!ce.members
    if ( !rpla.purp ne 'PREX' ) then
      !centre = !rpla.position
      !ori = !rpla.ori
      !length = !rpla.xLength
      !width = !rpla.yLength
      break
    endif
  enddo

  -- Corners of Rack are corners of anchor plane
  !travelDirection = !ori.xDir()
  !up      = object DIRECTION('U')
  !eastDir = object DIRECTION('E')
  !westDir = object DIRECTION('W')
  !northDir = object DIRECTION('N')
  !southDir = object DIRECTION('S')

  -- check orthogonal
  if ( !ori.zDir() ne !up ) then
    hide !!rtrPlanesOfRack
    !this.stage1()
    !!messageFile.error( 162, 13)
  elseif ( !travelDirection eq !eastDir or !travelDirection eq !westDir ) then
    !this.rackDir.select('RTEXT', 'East')
    !this.corner1Position = !centre.offset( !eastDir, ( !length / 2 ) )
    !this.corner2Position = !centre.offset( !eastDir, ( - !length / 2 ) )
    !this.corner1Position = !this.corner1Position.offset( !northDir,  ( !width / 2 ) )
    !this.corner2Position = !this.corner2Position.offset( !northDir, ( - !width / 2 ) )
  elseif ( !travelDirection eq !northDir or !travelDirection eq !southDir ) then
    !this.rackDir.select('RTEXT', 'North')
    !this.corner1Position = !centre.offset( !eastDir, ( !width / 2 ) )
    !this.corner2Position = !centre.offset( !eastDir, ( - !width / 2 ) )
    !this.corner1Position = !this.corner1Position.offset( !northDir,  ( !length / 2 ) )
    !this.corner2Position = !this.corner2Position.offset( !northDir, ( - !length / 2 ) )
  else
    hide !!rtrPlanesOfRack
    !this.stage1()
    !!messageFile.error( 162, 13)
  endif

  !this.showDimensions()
  !this.showCornerPosition()

  !this.stage2()

endmethod
-- End of method definition for .modifyRack( )

------------------------------------------------------------------------
--
-- Method:      .showCornerPosition()
--
-- Description: Use data from Form and corner member data
--              show XYZ values of corner (of anchor plane) on form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .showCornerPosition()

  -- Get info
  !xLength = !this.length.val
  !yLength = !this.width.val
  !arrowLength = !xLength / 3
  !centre = !this.corner1Position.midPoint(!this.corner2Position)
  if ( !this.rackDir.selection() eq |North|) then
    !xDir = object DIRECTION('N')
    !yDir = object DIRECTION('E')
    !ori  = object ORIENTATION( 'X is N')
  else
    !xDir = object DIRECTION('E')
    !yDir = object DIRECTION('N')
    !ori  = object ORIENTATION( 'Y is N')
  endif

  -- Remove any old AID
  !aidNumber = !this.aidArrowNumber
  !!aidNumbers.hide(!aidNumber)

  -- Corner positions data
  !this.displayCorner()

  -- Draw arrow to show direction of travel

  AID ARROW NUMBER $!aidNumber AT $!centre DIRECTION $!xDir HEIGHT $!arrowLength PROPORTION 0.1
  !xDir = !xDir.opposite()
  AID ARROW NUMBER $!aidNumber AT $!centre DIRECTION $!xDir HEIGHT $!arrowLength PROPORTION 0.1
  AID BOX NUMBER $!aidNumber AT $!centre XLEN $!xLength YLEN $!yLength ZLEN 0 ORIENTATION $!ori


  -- If have positive length & width now able to create planes
  if ( !xLength gt 0 and !yLength gt 0 and not !this.modifyButton.active ) then
    !this.createButton.active = true
  else
    !this.createButton.active = false
  endif

endmethod
-- End of method definition for .showCornerPosition()

------------------------------------------------------------------------
--
-- Method:      .displayCorner()
--
-- Description: display of other corner selected
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .displayCorner()

  if ( !this.corner.val eq 1 ) then
    !cornerPosition = !this.corner1Position
  elseif ( !this.corner.val eq 2 ) then
    !cornerPosition = !this.corner2Position
  else
    -- Centre
    !cornerPosition = !this.corner1Position.midPoint(!this.corner2Position)
    -- Work with positions wrt datum
    !datum = !this.datum.val.dbRef()
    !cornerPosition = !cornerPosition.wrt( !datum )
  endif

  -- Divide text up and put in appropriate fields
  --!cornerSplit = !cornerPosition.string().split()
  if(!cornerPosition.east.neq(0) ) then
  if (!cornerPosition.east.lt(0) ) then
     !this.x1O.select('RTEXT', '-1')
  else
   !this.x1O.select('RTEXT', '1')
  endif
  endif
  !this.x1.val = !cornerPosition.east.abs()

  if (!cornerPosition.north.neq(0) ) then
   if (!cornerPosition.north.lt(0) ) then
      !this.y1O.select('RTEXT', '-1')
  else
     !this.y1O.select('RTEXT', '1')
  endif
  endif

  !this.y1.val = !cornerPosition.north.abs()

  if (!cornerPosition.up.neq(0) ) then
  if (!cornerPosition.up.lt(0) ) then
      !this.z1O.select('RTEXT', '-1')
  else
     !this.z1O.select('RTEXT', '1')
  endif
  endif
  !this.z1.val = !cornerPosition.up.abs()

  -- Display aid IF user is still modifying geometry
  if ( !this.pickCorner.active ) then
    !aidNumber = !this.aidArrowNumber

    !text = !this.corner.selection('DTEXT')
    AID TEXT NUMBER $!aidNumber '$!text' AT $!cornerPosition
  endif

endmethod
-- End of method definition for .displayCorner()

------------------------------------------------------------------------
--
-- Method:      .nameCheck()
--
-- Description: method when name typed in
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .nameCheck()

  !!nameGadget(!this.name, 'NEW')

endmethod
-- End of method definition for .nameCheck()

------------------------------------------------------------------------
--
-- Method:      .swapCorner()
--
-- Description: method corner changed
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .swapCorner()

  if ( !this.pickCorner.active ) then
    !this.x1.active  = true
    !this.x1O.active = true
    !this.xLock.val  = false
    !this.y1.active  = true
    !this.y1O.active = true
    !this.yLock.val  = false
  endif
  !this.displayCorner()

endmethod
-- End of method definition for .swapCorner()

------------------------------------------------------------------------
--
-- Method:      .swapDirection()
--
-- Description: method direction changed
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .swapDirection()

  !this.showDimensions()

endmethod
-- End of method definition for .swapDirection()

------------------------------------------------------------------------
--
-- Method:      .changeLength()
--
-- Description: Length of rack changed - move current corner,
--                unless it is 'locked' when move other
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .changeLength()

  if ( !this.length.val lt 0 ) then

    -- Invalid value; revert to previous
    !this.showDimensions()
    !!messageFile.error(162, 7)
  endif

  -- Get info
  !length = !this.length.val
  !cornerNumber = !this.corner.val
  if ( !this.rackDir.selection() eq |North|) then
    if ( !this.yLock.val ) then
      -- Switch corner
      !cornerNumber = 3 - !cornerNumber
    endif
    if ( !this.corner1Position.north gt !this.corner2Position.north ) then
      !lengthDir = object DIRECTION('N')
    else
      !lengthDir = object DIRECTION('S')
    endif
    !widthDir = object DIRECTION('E')
    !width = !this.corner1Position.east - !this.corner2Position.east
  else
    if ( !this.xLock.val ) then
      -- Switch corner
      !cornerNumber = 3 - !cornerNumber
    endif
    if ( !this.corner1Position.east gt !this.corner2Position.east ) then
      !lengthDir = object DIRECTION('E')
    else
      !lengthDir = object DIRECTION('W')
    endif
    !widthDir = object DIRECTION('N')
    !width = !this.corner1Position.north - !this.corner2Position.north
  endif

  -- Move stored corner position(s)
  if ( !cornerNumber eq 1 ) then
    !this.corner1Position = !this.corner2Position.offset(!lengthDir, !length)
    !this.corner1Position = !this.corner1Position.offset(!widthDir, !width)
  elseif ( !cornerNumber eq 2 ) then
    !this.corner2Position = !this.corner1Position.offset(!lengthDir, - !length)
    !this.corner2Position = !this.corner2Position.offset(!widthDir, - !width)
  else
    -- Centre displayed; move both corners
    !centre = !this.corner1Position.midPoint(!this.corner2Position)
    !this.corner1Position = !centre.offset(!lengthDir, (!length / 2))
    !this.corner1Position = !this.corner1Position.offset(!widthDir, (!width / 2))
    !this.corner2Position = !centre.offset(!lengthDir, (-!length / 2))
    !this.corner2Position = !this.corner2Position.offset(!widthDir, (-!width / 2))

  endif

  !this.showCornerPosition()

endmethod
-- End of method definition for .changeLength()

------------------------------------------------------------------------
--
-- Method:      .measureLength()
--
-- Description: Initiate EDG to measure length
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .measureLength()

  -- Define the measure packet
  !packet        = object EDGPACKET()
  !packet.defineMeasure('distance')
  !packet.action = '!!rtrCreateRack.lengthMeasure(!this.return[1])'
  !!edgCntrl.add(!packet)


endmethod
-- End of method definition for .measureLength()

------------------------------------------------------------------------
--
-- Method:      .lengthMeasure(!line is LINE)
--
-- Description: Respond to EDG measure of length
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE
--
------------------------------------------------------------------------
define method .lengthMeasure(!line is LINE)

  -- Unset line, is zero
  if(!line.unset()) then
    !this.length.val = 0
  else
    !this.length.val = !line.length()
  endif

  !this.changeLength()

endmethod
-- End of method definition for .lengthMeasure(LINE)

------------------------------------------------------------------------
--
-- Method:      .changeWidth()
--
-- Description: Width of rack changed - move current corner,
--                unless it is 'locked' when move other
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .changeWidth()

  if ( !this.width.val lt 0 ) then

    -- Invalid value; revert to previous
    !this.showDimensions()
    !!messageFile.error(162, 8)
  endif

  -- Get info
  !width = !this.width.val
  !cornerNumber = !this.corner.val
  if ( !this.rackDir.selection() eq |North|) then
    if ( !this.xLock.val ) then
      -- Switch corner
      !cornerNumber = 3 - !cornerNumber
    endif
    if ( !this.corner1Position.east gt !this.corner2Position.east ) then
      !widthDir = object DIRECTION('E')
    else
      !widthDir = object DIRECTION('W')
    endif
    !lengthDir = object DIRECTION('N')
    !length = !this.corner1Position.north - !this.corner2Position.north
  else
    if ( !this.yLock.val ) then
      -- Switch corner
      !cornerNumber = 3 - !cornerNumber
    endif
    if ( !this.corner1Position.north gt !this.corner2Position.north ) then
      !widthDir = object DIRECTION('N')
    else
      !widthDir = object DIRECTION('S')
    endif
    !lengthDir = object DIRECTION('E')
    !length = !this.corner1Position.east - !this.corner2Position.east
  endif

  -- Move stored corner position(s)
  if ( !cornerNumber eq 1 ) then
    !this.corner1Position = !this.corner2Position.offset(!lengthDir, !length)
    !this.corner1Position = !this.corner1Position.offset(!widthDir, !width)
  elseif ( !cornerNumber eq 2 ) then
    !this.corner2Position = !this.corner1Position.offset(!lengthDir, - !length)
    !this.corner2Position = !this.corner2Position.offset(!widthDir, - !width)
  else
    -- Centre displayed; move both corners
    !centre = !this.corner1Position.midPoint(!this.corner2Position)
    !this.corner1Position = !centre.offset(!lengthDir, (!length / 2))
    !this.corner1Position = !this.corner1Position.offset(!widthDir, (!width / 2))
    !this.corner2Position = !centre.offset(!lengthDir,( -!length / 2))
    !this.corner2Position = !this.corner2Position.offset(!widthDir, (-!width / 2))
  endif

  !this.showCornerPosition()

endmethod
-- End of method definition for .changeWidth()

------------------------------------------------------------------------
--
-- Method:      .measureWidth()
--
-- Description: Initiate EDG to measure width
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .measureWidth()

  -- Define the measure packet
  !packet        = object EDGPACKET()
  !packet.defineMeasure('distance')
  !packet.action = '!!rtrCreateRack.widthMeasure(!this.return[1])'
  !!edgCntrl.add(!packet)


endmethod
-- End of method definition for .measureWidth()

------------------------------------------------------------------------
--
-- Method:      .widthMeasure(!line is LINE)
--
-- Description: Respond to EDG measure of width
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE
--
------------------------------------------------------------------------
define method .widthMeasure(!line is LINE)

  -- Unset line, is zero
  if(!line.unset()) then
    !this.width.val = 0
  else
    !this.width.val = !line.length()
  endif

  !this.changeWidth()

endmethod
-- End of method definition for .widthMeasure(LINE)

------------------------------------------------------------------------
--
-- Method:      .showDimensions()
--
-- Description: display length and width.
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .showDimensions()

  if ( !this.rackDir.selection() eq |North|) then

    !temp = !this.corner1Position.north - !this.corner2Position.north
    !this.length.val = !temp.abs()
    !temp = !this.corner1Position.east - !this.corner2Position.east
    !this.width.val = !temp.abs()
  else

    !temp = !this.corner1Position.east - !this.corner2Position.east
    !this.length.val = !temp.abs()
    !temp = !this.corner1Position.north - !this.corner2Position.north
    !this.width.val = !temp.abs()
  endif

endmethod
-- End of method definition for .showDimensions()

------------------------------------------------------------------------
--
-- Method:      .changeCornerPosition()
--
-- Description: Corner Position of rack changed - change length and width.
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .changeCornerPosition()

  -- Find new eastings of corner

  !east1 = !this.x1.val
  if ( !this.x1O.selection() eq |-1| )  then
    !east1 = - !east1
  endif

  -- Find new northings of corner

  !north1 = !this.y1.val
  if ( !this.y1O.selection() eq |-1| )  then
    !north1 = - !north1
  endif

  -- Find new height of corners (Applies to BOTH )

  !up1 = !this.z1.val
  if ( !this.z1O.selection() eq |-1| )  then
    !up1 = - !up1
  endif
  !this.corner1Position.up = !up1
  !this.corner2Position.up = !up1

  -- Move stored corner position(s)
  if ( !this.corner.val eq 1 ) then
    !this.corner1Position.east = !east1
    !this.corner1Position.north = !north1
  elseif ( !this.corner.val eq 2 ) then
    !this.corner2Position.east = !east1
    !this.corner2Position.north = !north1
  else
    !oldCentre = !this.corner1Position.midPoint(!this.corner2Position)
    !eastChange = !east1 - !oldCentre.east
    !northChange = !north1 - !oldCentre.north
    !this.corner1Position.east = !this.corner1Position.east + !eastChange
    !this.corner2Position.east = !this.corner2Position.east + !eastChange
    !this.corner1Position.north = !this.corner1Position.north + !northChange
    !this.corner2Position.north = !this.corner2Position.north + !northChange
  endif

  !this.showDimensions()
  !this.showCornerPosition()

endmethod
-- End of method definition for .changeCornerPosition()

------------------------------------------------------------------------
--
-- Method:      .lockX()
--
-- Description: toggle on xLock
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .lockX()

  if ( !this.xLock.val eq true ) then
    !this.x1.active = false
    !this.x1O.active = false
  else
    !this.x1.active = true
    !this.x1O.active = true
  endif

endmethod
-- End of method definition for .lockX()

------------------------------------------------------------------------
--
-- Method:      .lockY()
--
-- Description: toggle on yLock
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .lockY()

  if ( !this.yLock.val eq true ) then
    !this.y1.active = false
    !this.y1O.active = false
  else
    !this.y1.active = true
    !this.y1O.active = true
  endif

endmethod
-- End of method definition for .lockY()

------------------------------------------------------------------------
--
-- Method:      .lockZ()
--
-- Description: toggle on zLock
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .lockZ()

  if ( !this.zLock.val eq true ) then
    !this.z1.active = false
    !this.z1O.active = false
  else
    !this.z1.active = true
    !this.z1O.active = true
  endif

endmethod
-- End of method definition for .lockZ()

------------------------------------------------------------------------
--
-- Method:      .cornerPick()
--
-- Description: initiates EDG to define corner of Rack
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .cornerPick()

  !packet = object EDGPACKET()

  !string = 'Position ' + !this.corner.selection('DTEXT') + ' of Rack'

  !packet.definePosition(!string)
  !packet.description = !string
  !packet.action      = '!!rtrCreateRack.cornerFromPick(!this.return[1])'
  !packet.close       = ''
  !packet.type        = 'createRplg'
  !packet.key         = 'routerRackPosition'
  !packet.remove      = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .cornerPick()

------------------------------------------------------------------------
--
-- Method:      .cornerFromPick()
--
-- Description: called by EDG to define length and width of Rack from
--              pick on corner SCTN
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Data Array
--
------------------------------------------------------------------------
define method .cornerFromPick(!data is EDGPOSITIONDATA)

  !atCorner = !data.item
  !rawCorner = !data.position.wrt( /* )

  -- Do not move centre
  if ( !this.corner.val lt 3 ) then
    if ( !this.corner.val eq 1 ) then
      !otherCorner = !this.corner2Position
    else
      !otherCorner = !this.corner1Position
    endif

    -- But replace raw corner position with position inside framework
    if ( !atCorner.set() and !atCorner.type eq |SCTN| ) then
      !rawCorner = !atCorner.position.wrt( /* )
      if ( !this.rackDir.selection() eq |North|) then
        if ( !rawCorner.east lt !otherCorner.east ) then
          PIN1 AT $!rawCorner DIR E
        else
          PIN1 AT $!rawCorner DIR W
        endif
      else
        if ( !rawCorner.north lt !otherCorner.north ) then
          PIN1 AT $!rawCorner DIR N
        else
          PIN1 AT $!rawCorner DIR S
        endif
      endif
      PIN1 BEHIND $!atCorner
      !rawCorner = !!posOfPin(1)
      PIN1 OFF
    endif
  endif

  -- Now work with positions wrt datum
  !datum = !this.datum.val.dbRef()
  !rawCorner = !rawCorner.wrt( !datum )

  -- Don't changed locked components
  if ( !this.xLock.val ) then
    if ( !this.x1O.selection()  eq '1' ) then
      !rawCorner.east = !this.x.val
    else
      !rawCorner.east = - !this.x.val
    endif
  endif

  if ( !this.yLock.val ) then
    if ( !this.y1O.selection()  eq '1'  ) then
      !rawCorner.north = !this.y.val
    else
      !rawCorner.north = - !this.y.val
    endif
  endif

  if ( !this.zLock.val ) then
    if ( !this.z1O.selection()  eq '1' ) then
      !rawCorner.up = !this.z.val
    else
      !rawCorner.up = - !this.z.val
    endif
  endif

  -- Update stored corner position(s)
  if ( !this.corner.val eq 1 ) then
    !this.corner1Position = !rawCorner
  elseif ( !this.corner.val eq 2 ) then
    !this.corner2Position = !rawCorner
  else
    !oldCentre = !this.corner1Position.midPoint(!this.corner2Position)
    !eastChange = !rawCorner.east - !oldCentre.east
    !northChange = !rawCorner.north - !oldCentre.north
    !this.corner1Position.east = !this.corner1Position.east + !eastChange
    !this.corner2Position.east = !this.corner2Position.east + !eastChange
    !this.corner1Position.north = !this.corner1Position.north + !northChange
    !this.corner2Position.north = !this.corner2Position.north + !northChange

  endif

  !this.showDimensions()
  !this.showCornerPosition()

endmethod
-- End of method definition for .cornerFromPick(EDGPOSITIONDATA)


------------------------------------------------------------------------
--
-- Method:      .wrt()
--
-- Description: Change origin of displayed positions
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .wrt()

  !!nameGadget(!this.datum, 'OLD')

  if (!this.datum.val eq 'unset') then

    !this.datum.val = '/*'
  endif

  !newDatum = !this.datum.val.dbRef()

  -- Update stored positions
  !this.corner1Position = !this.corner1Position.wrt(!newDatum)
  !this.corner2Position = !this.corner2Position.wrt(!newDatum)

  -- Update positions on form
  !this.displayCorner()

  -- Update rplaData
  if ( !this.elevation.active ) then
    !this.currentRplaData.position = !this.currentRplaData.position.wrt(!newDatum)
    do !x to !this.rplaData.size()
      !this.rplaData[!x].position = !this.rplaData[!x].position.wrt(!newDatum)
    enddo
    !this.listPlanes()
    !this.selectPlane()
  endif

  !this.wrtAnchor.val = false

endmethod
-- End of method definition for .wrt()

------------------------------------------------------------------------
--
-- Method:      .anchor()
--
-- Description: If true, display positions wrt anchor plane
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .anchor()

  if ( !this.wrtAnchor.val ) then
    !this.datum.val = !this.rplaData[!this.anchorNumber].id.name
    !this.wrt()
    !this.wrtAnchor.val = true
  endif

endmethod
-- End of method definition for .anchor()

------------------------------------------------------------------------
--
-- Method:      .createPlanes()
--
-- Description: Create RPLG and go on to obtain details of planes
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .createPlanes()

  -- De-activate fields
  !this.convertButton.active = false
  !this.createButton.active = false

  !oldCe = !!ce

  $!<this.stru.val>
  NEW RPLG
  !this.rplg = !!ce
  if ( !this.name.val ne ''  and !this.name.val.upcase() ne 'UNSET' ) then
    NAME $!<this.name.val>
  endif

  show !!rtrPlanesOfRack

  !!ce = !oldCe

endmethod
-- End of method definition for .createPlanes()

------------------------------------------------------------------------
--
-- Method:      .modifyAll()
--
-- Description: change property for ALL planes
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .modifyAll()

  !oldCe = !!ce
  !!ce = !this.rplg
  show !!rtrPlanesOfRack

  !this.pickCorner.active   = true
  !this.x1.active           = true
  !this.x1O.active          = true
  !this.xLock.active        = true
  !this.y1.active           = true
  !this.y1O.active          = true
  !this.yLock.active        = true
  !this.zLock.val           = true
  !this.length.active       = true
  !this.lengthButton.active = true
  !this.width.active        = true
  !this.widthButton.active  = true

  !!ce = !oldCe

endmethod
-- End of method definition for .modifyAll()

------------------------------------------------------------------------
--
-- Method:      .convert()
--
-- Description: prepare to obtain details of geometry & planes from structure
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .convert()

  !this.createPlanes()
  !!rtrPlanesOfRack.converting()

  -- Start EDG to pick structure to convert

  !packet = object EDGPACKET()

  !string = 'Create Rack from'

  !packet.definePosition(!string)
  !packet.description = !string
  !packet.action      = '!!rtrCreateRack.convertStructure(!this.return[1].item)'
  !packet.escape      = '!!rtrCreateRack.stage1()'
  !packet.close       = ''
  !packet.type        = 'createRplg'
  !packet.key         = 'routerRackPosition'
  !packet.remove      = true
  !packet.pickPacket.picks[1].pick.input[3]   = '(type eq |SCTN|)'

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .convert()

------------------------------------------------------------------------
--
-- Method:      .convertStructure()
--
-- Description: obtain details of geometry & planes from structure
--                which owns the picked SCTN
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .convertStructure(!element is DBREF)

  !oldCe = !!ce

  -- Find the item of the required type (STRU / FRMW / SBFR to convert
  !!ce = !element
  $!this.convertType
  handle any
    -- cannot navigate to required type
    !!ce = !oldCe
    hide !!rtrPlanesOfRack
    !this.stage1()
    !!messageFile.error( 162, 24, !this.convertType.selection())

  -- Inappropriate warning message is displayed while creating a Pipe Rack Plane in Pipe Router window
    handle any
    if !this.convertType.selection('DTEXT') eq 'STRU' then
      !!alert.error(|Picked element is not in a STRU.|)
      return
    elseif !this.convertType.selection('DTEXT') eq 'FRMW' then
      !!alert.error(|Picked element is not in a FRMW.|)
      return
    else
      !!alert.error(|Picked element is not in a SBFR.|)
      return
    endif
    endhandle
  endhandle
  !steelwork = !!ce

  -- check orthogonal
  !ori = !steelwork.ori
  handle any
    STRU
    !ori = !!ce.ori
    !!ce = !steelwork
  endhandle

  if ( !ori.set() ) then
    !xDir = !ori.xDir()
    !up   = object DIRECTION('U')
    !east  = object DIRECTION('E')
    !west  = object DIRECTION('W')
    !north = object DIRECTION('N')
    !south = object DIRECTION('S')

    if ( !ori.zDir() ne !up ) then
      hide !!rtrPlanesOfRack
      !this.stage1()
      !!messageFile.error( 162, 28, !steelwork.name)
    elseif ( !xDir ne !east and !xDir ne !west and !xDir ne !north and !xDir ne !south) then
      hide !!rtrPlanesOfRack
      !this.stage1()
      !!messageFile.error( 162, 28, !steelwork.name)
    endif
  endif

  -- make list of all SCTN in structure
  var !sctnList COLLECT ALL SCTN FOR CE
  if ( !sctnList.size() lt 4 ) then
    -- not enough sections
    !!ce = !oldCe
    hide !!rtrPlanesOfRack
    !this.stage1()
    !!messageFile.error( 162, 23, !steelwork.name )
  endif

  -- determine limits of structure - first 'guess' as corners
  var !temp VOL CE
  !!ce = !oldCe

  !temp1 = !temp.before('to')
  !temp2 = !temp.after('to')
  !corner1 = !temp1.position()
  !corner2 = !temp2.position()
  -- put 'origin' at base of structure (i.e. move corner 2 down)
  !corner2.up = !corner1.up
  !this.corner1Position = !corner1
  !this.corner2Position = !corner2

  -- Find east & north extents; larger is direction of rack
  !eastExtent = !corner2.east - !corner1.east
  !northExtent = !corner2.north - !corner1.north

  if ( !northExtent gt !eastExtent ) then

    !this.rackDir.select( 'RTEXT', 'North' )
    !this.length.val = !northExtent

    -- Need to refine corners to Inside steelwork in width
    !minEast = !corner2
    !maxEast = !corner1

    do !x indices !sctnList

      !item = !sctnList[!x].dbRef()
      !position = !item.position.wrt( /* )

      if ( !position.east lt !minEast.east ) then

        !minEast = !position
        !minEastItem = !item
      endif

      if ( !position.east gt !maxEast.east ) then

        !maxEast = !position
        !maxEastItem = !item
      endif
    enddo

    !this.findInnerCorners( !minEastItem , !maxEastItem )

  else
    -- Rack runs East/West
    !this.rackDir.select( 'RTEXT', 'East' )
    !this.length.val = !eastExtent

    -- Need to refine corners to Inside steelwork in width
    !minNorth = !corner2
    !maxNorth = !corner1

    do !x indices !sctnList

      !item = !sctnList[!x].dbRef()
      !position = !item.position.wrt( /* )

      if ( !position.north lt !minNorth.north ) then

        !minNorth = !position
        !minNorthItem = !item
      endif

      if ( !position.north gt !maxNorth.north ) then

        !maxNorth = !position
        !maxNorthItem = !item
      endif
    enddo

    !this.findInnerCorners( !minNorthItem , !maxNorthItem )
  endif

  -- Find Levels (for numbers of planes and their heights)
  if ( not !!rtrPlanesOfRack.levelsFromStructure( !steelwork ) ) then
    -- Failed to find levels
    hide !!rtrPlanesOfRack
    !this.stage1()
    !!messageFile.error( 162, 26, !steelwork.name)
  endif

  !this.showDimensions()
  !this.showCornerPosition()
endmethod
-- End of method definition for .convertStructure(DBREF)

------------------------------------------------------------------------
--
-- Method:      .findInnerCorners( !item1 is DBREF, !item2 is DBREF )
--
-- Description: determine width from corner elements of STRU
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .findInnerCorners( !item1 is DBREF, !item2 is DBREF)

  !position1 = !item1.position.wrt( /* )
  !position2 = !item2.position.wrt( /* )

  if ( !this.rackDir.selection() eq |North|) then

    if ( !position1.east lt !position2.east ) then

      !minEast = !position1
      !maxEast = !position2
      !minEastItem = !item1
      !maxEastItem = !item2
    else

      !minEast = !position2
      !maxEast = !position1
      !minEastItem = !item2
      !maxEastItem = !item1
    endif

    -- Replace current positions with positions inside framework
    PIN1 AT $!minEast DIR E
    PIN2 AT $!maxEast DIR W
    PIN1 BEHIND $!minEastItem
    PIN2 BEHIND $!maxEastItem

    !this.corner1Position.east = !!posOfPin(1).east
    !this.corner2Position.east = !!posOfPin(2).east

  else

    if ( !position1.north lt !position2.north ) then

      !minNorth = !position1
      !maxNorth = !position2
      !minNorthItem = !item1
      !maxNorthItem = !item2
    else

      !minNorth = !position2
      !maxNorth = !position1
      !minNorthItem = !item2
      !maxNorthItem = !item1
    endif

    -- Replace current positions with positions inside framework
    PIN1 AT $!minNorth DIR E
    PIN2 AT $!maxNorth DIR W
    PIN1 BEHIND $!minNorthItem
    PIN2 BEHIND $!maxNorthItem

    !this.corner1Position.north = !!posOfPin(1).north
    !this.corner2Position.north = !!posOfPin(2).north

  endif

  PIN1 OFF
  PIN2 OFF

endmethod
-- End of method definition for .findInnerCorners( DBREF, DBREF)

------------------------------------------------------------------------
--
-- Method:      .stage1()
--
-- Description: Re-active stage1 fields
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .stage1()

  if ( defined(!!rtrPlanesOfRack) ) then
    hide !!rtrPlanesOfRack
  endif

  -- Re-activate fields
  !this.name.active          = true
  !this.convertType.active   = true
  !this.convertButton.active = true
  !this.rackDir.active       = true
  !this.pickCorner.active    = true
  !this.x1.active            = true
  !this.x1O.active           = true
  !this.xLock.active         = true
  !this.y1.active            = true
  !this.y1O.active           = true
  !this.yLock.active         = true
  !this.z1.active            = true
  !this.z1O.active           = true
  !this.zLock.active         = true
  !this.length.active        = true
  !this.lengthButton.active  = true
  !this.width.active         = true
  !this.widthButton.active   = true
  !this.createButton.active  = true

  -- show aid arrow etc.
  !this.showCornerPosition()

endmethod
-- End of method definition for .stage1()

------------------------------------------------------------------------
--
-- Method:      .stage2()
--
-- Description: Rack defined; now refine
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .stage2()

  -- De-activate fields
  !this.name.active          = false
  !this.convertButton.active = false
  !this.rackDir.active       = false
  !this.pickCorner.active    = false
  !this.x1.active            = false
  !this.x1O.active           = false
  !this.xLock.active         = false
  !this.y1.active            = false
  !this.y1O.active           = false
  !this.yLock.active         = false
  !this.z1.active            = false
  !this.z1O.active           = false
  !this.zLock.active         = false
  !this.length.active        = false
  !this.lengthButton.active  = false
  !this.width.active         = false
  !this.widthButton.active   = false
  !this.createButton.active  = false

  -- hide aid arrow etc.
  !aidNumber = !this.aidArrowNumber
  !!aidNumbers.hide(!aidNumber)

  -- Fill in plane list

  !this.listPlanes()

  -- and activate fields
  !this.modifyButton.active    = true
  !this.wrtAnchor.active       = true
  !this.purpose.active         = true
  !this.elevation.active       = true
  !this.pickLevel.active       = true
  !this.overhang.active        = true
  !this.overhangButton.active  = true
  !this.function.active        = true
  !this.plpp.active            = true
  !this.plpm.active            = true
  !this.plww.active            = true

  -- Fill plane details

  !this.selectPlane()

endmethod
-- End of method definition for .stage2()

------------------------------------------------------------------------
--
-- Method:      .listPlanes()
--
-- Description: fill in list of planes in RPLG
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .listPlanes()

  !dtext[1] = 'Travel Planes:'
  !rtext[1] = 'PRRP'

  -- check to see if Pipe Rack is valid (travel and EE planes)

  !nTravel = 0
  !nEntryExit = 0
  !elevations = ARRAY()
  !rplaRefs = ARRAY()
  !levels = ARRAY()

  -- Look through all planes in RPLG
  do !rpla values !this.rplg.members

    -- Get PURP for plane

    !purpose = !rpla.purp

    ------------------
    -- Collect levels
    ------------------
    !pos = !rpla.position.wrt( !this.datum.val.dbRef() )
    !elevations.append( !pos.up )
    !rplaRefs.append( !rpla )

    if ( !purpose eq 'PREX' ) then

      -- if an E/E plane store info until loop is done.
      !nEntryExit = !nEntryExit + 1
      !levels.append( |EE| )
    else
      -- Travel plane. Add to list. If first it is anchor plane
      !nTravel = !nTravel + 1
      !levels.append( |$!nTravel| )

      !rtext[!nTravel + 1] = |$!rpla.ref|

      if ( !nTravel eq 1 ) then
        !this.anchorNumber = !nEntryExit + 1

        !dtext[!nTravel + 1] = |  Anchor travel plane              | + !!rtrAlignDistance(!pos.up)
      else

        !dtext[!nTravel + 1] = |  Level $!nTravel travel plane             | + !!rtrAlignDistance(!pos.up)
      endif
    endif
  enddo

  -- Error if no travel plane or no entry / exit plane
  if( !nTravel lt 1) then
    !!messageFile.error(162, 11, !this.rplg.name)
    return

  elseif( !nEntryExit lt 1 ) then
    !!messageFile.error(162, 12, !this.rplg.name)
    return
  endif

  -- Store info for planes in !this.rplaData
  !this.rplaData = !!rtrGetRackDetails(!this.rplg)

  !index = !nTravel + 2
  !dtext[!index] = 'Entry/Exit Planes:'
  !rtext[!index] = 'PREX'

  ----------------------------------------------
  -- Find sort-order of !elevations (plane levels)
  ----------------------------------------------

  !heightOrder = !elevations.sortedIndices()

  -------------------------------------------
  -- Work out where entry/exit planes are in relation to Travel Planes
  -------------------------------------------

  !lastPlane = ||

  do !x from 1 to !heightOrder.size()

    if ( !levels[!heightOrder[!x]] eq |EE| ) then

      !index = !index + 1
      !refToAdd = !rplaRefs[!heightOrder[!x]]
      !rtext[!index] = !refToAdd.string()
      !elevation = !elevations[!heightOrder[!x]]

      if ( !lastPlane eq || or !lastPlane eq |EE| ) then
      -- this is an EE plane, lowest of all or above another EE plane.

        !tryTravel = !x + 1
        !travelLevel = |EE|
        if ( !tryTravel le !heightOrder.size() ) then
          !travelLevel = !levels[!heightOrder[!tryTravel]]
        endif

        if ( !travelLevel eq |EE| ) then

          !dtext[!index] = |  Alternative entry/exit plane     | + !!rtrAlignDistance(!elevation)

        else
          !dtext[!index] = |  Level $!travelLevel lower entry/exit plane   | + !!rtrAlignDistance(!elevation)

        endif
      else

        !dtext[!index] = |  Level $!lastPlane upper entry/exit plane   | + !!rtrAlignDistance(!elevation)
      endif
    endif

    !lastPlane = !levels[!heightOrder[!x]]
  enddo

  -- Now display list
  !this.members.dtext = !dtext
  !this.members.rtext = !rtext

endmethod
-- End of method definition for .listPlanes()

------------------------------------------------------------------------
--
-- Method:      .selectPlane()
--
-- Description: display details of selected plane ( can be generic
--                 'Travel' or 'Entry/Exit' )
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .selectPlane()

  -- delete old AID box

  if ( !this.currentRplaData.set() ) then
    !boxNumber = !this.currentRplaData.aidNumber
    !!aidNumbers.hide(!boxNumber)
  endif

  if ( !this.members.selection() eq 'PRRP' ) then
    -- Generic Travel plane
    !this.currentRplaData = !this.newRplaData()
    !this.currentRplaData.purpose = 'PRRP'
    !this.addPlane.active = true
    !this.modifyPlane.active = false
    !this.deletePlane.active = false
    !this.overhang.active = false
    !this.overhangButton.active = false
    !this.purpose.select('RTEXT', 'PRRP')
  elseif ( !this.members.selection() eq 'PREX' ) then
    -- Generic Entry / Exit  plane
    !this.currentRplaData = !this.newRplaData()
    !this.currentRplaData.purpose = 'PREX'
    !this.addPlane.active = true
    !this.modifyPlane.active = false
    !this.deletePlane.active = false
    !this.overhang.active = true
    !this.overhangButton.active = true
    !this.purpose.select('RTEXT', 'PREX')
  else
    -- find which RPLA is being looked at.
    !num = !this.currentRpla()
    !this.currentRplaData =  !this.rplaData[!num]
    !this.addPlane.active = true
    !this.modifyPlane.active = true
    !this.deletePlane.active = true
    !this.overhang.active = true
    !this.overhangButton.active = true
    -- Don't delete anchor plane; or entry / exit plane if ONLY one
    if ( !num eq !this.anchorNumber ) then
      !this.deletePlane.active = false
      !this.overhang.active = false
      !this.overhangButton.active = false
    elseif ( !this.currentRplaData.purpose eq 'PREX' ) then
      -- Don't allow Entry / Exit plane to be deleted if only one
      !index = !this.members.rtext.size() - 1
      if ( !this.members.rtext[!index] eq 'PREX' ) then
        !this.deletePlane.active = false
      endif
    endif
    !id = !this.rplaData[!num].id
    if ( !id.purp eq 'PREX' ) then
      !this.purpose.select('RTEXT', 'PREX')
    else
      !this.purpose.select('RTEXT', 'PRRP')
    endif
  endif

  -- Put plane details in form
  !this.function.val = !this.currentRplaData.function
  !position = !this.currentRplaData.position

  !datum = !this.datum.val.dbRef()
  !position = !position.wrt(!datum)
  !this.elevation.val = !position.up

  !this.plpp.select('RTEXT', !this.currentRplaData.pipePosition )
  !this.plpm.select('RTEXT', !this.currentRplaData.packMethod )
  !this.plww.select('RTEXT', !this.currentRplaData.gapType )

  -- Work out overhang attr of RPLA (i.e in comparison to travel plane)
  !halfYdiff = ( !this.currentRplaData.yLength - !this.rplaData[!this.anchorNumber].yLength ) / 2

  !this.overhang.val = !halfYdiff

  !this.aidBox( )

endmethod
-- End of method definition for .selectPlane()

------------------------------------------------------------------------
--
-- Method:      .newRplaData()
--
-- Description: Create new rplaData object for current data
--
-- Method Type: RTRRPLA Function
--
------------------------------------------------------------------------
define method .newRplaData() is RTRRPLA

  !result = object RTRRPLA()
  -- Leave id unset

  -- Geometry
  !result.position = !this.rplaData[!this.anchorNumber].position
  !result.xLength  = !this.rplaData[!this.anchorNumber].xLength
  !result.yLength  = !this.rplaData[!this.anchorNumber].yLength
  !result.ori      = !this.rplaData[!this.anchorNumber].ori

  -- Routing details
  !result.function      = ''
  !result.pipePosition  = !this.rplaData[!this.anchorNumber].pipePosition
  !result.packMethod    = !this.rplaData[!this.anchorNumber].packMethod
  !result.gapType       = !this.rplaData[!this.anchorNumber].gapType

  !result.aidNumber = !!aidNumbers.add('Router Rack')

  return !result

endmethod
-- End of method definition for .newRplaData() RTRRPLA

------------------------------------------------------------------------
--
-- Method:      .currentRpla()
--
-- Description: For the current Plane in !this.members find its position
--              in !this.rplaData array
--
-- Method Type: Real Function
--
------------------------------------------------------------------------
define method .currentRpla() is REAL

  !rpla = !this.members.selection()
  if ( !rpla eq 'PRRP' or !rpla eq 'PREX' ) then
    return 0
  endif

  !rplaRef = !rpla.dbRef()
  !num = 0

  do !index from 1 to !this.rplaData.size()
    if ( !this.rplaData[!index].id eq !rplaRef ) then
      !num = !index
      break
    endif
  enddo

  return !num

endmethod
-- End of method definition for .currentRpla() REAL

------------------------------------------------------------------------
--
-- Method:      .aidBox()
--
-- Description: Show AID box for plane
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .aidBox()

  !pos = !this.currentRplaData.position
  !ori = !this.currentRplaData.ori
  !boxNumber = !this.currentRplaData.aidNumber
  !xLength = !this.currentRplaData.xLength
  !yLength = !this.currentRplaData.yLength

  -- Draw box to show position and size

  !!aidNumbers.hide(!boxNumber)

  AID BOX NUMBER $!boxNumber AT $!pos XLEN $!xLength YLEN $!yLength ZLEN 0 ORIENTATION $!ori

endmethod
-- End of method definition for .aidBox()

------------------------------------------------------------------------
--
-- Method:      .changePurpose()
--
-- Description: Change purpose RPLA
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .changePurpose()

  !this.modifyPlane.active = false
  !this.deletePlane.active = false
  !this.currentRplaData.purpose = !this.purpose.selection()

endmethod
-- End of method definition for .changePurpose()

------------------------------------------------------------------------
--
-- Method:      .changeFunction()
--
-- Description: Change stored function for current RPLA
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .changeFunction()

  !this.currentRplaData.function = !this.function.val

endmethod
-- End of method definition for .changeFunction()

------------------------------------------------------------------------
--
-- Method:      .changePipePositioning()
--
-- Description: Change stored pipe positioning for current RPLA
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .changePipePositioning()

  !this.currentRplaData.pipePosition = !this.plpp.selection()

endmethod
-- End of method definition for .changePipePositioning()

------------------------------------------------------------------------
--
-- Method:      .changePackMethod()
--
-- Description: Change stored pack method for current RPLA
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .changePackMethod()

  !this.currentRplaData.packMethod = !this.plpm.selection()

endmethod
-- End of method definition for .changePackMethod()

------------------------------------------------------------------------
--
-- Method:      .changeGapType()
--
-- Description: Change stored gap-type for current RPLA
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .changeGapType()

  !this.currentRplaData.gapType = !this.plww.selection()

endmethod
-- End of method definition for .changeGapType()

------------------------------------------------------------------------
--
-- Method:      .changeElevation()
--
-- Description: Change stored Height for current RPLA
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .changeElevation()

  !this.currentRplaData.position.up = !this.elevation.val

  -- Update aidBox
  !this.aidBox()

endmethod
-- End of method definition for .changeElevation()

------------------------------------------------------------------------
--
-- Method:      .levelPick()
--
-- Description: initiates EDG to define height of plane
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .levelPick()

  !packet = object EDGPACKET()

  !packet.definePosition('Elevation of Plane')
  !packet.description = 'Elevation of Plane'
  !packet.action      = '!!rtrCreateRack.levelFromPick(!this.return[1])'
  !packet.close       = ''
  !packet.type        = 'createRplg'
  !packet.key         = 'routerRackPosition'
  !packet.remove      = true

  !!edgCntrl.add(!packet)

endmethod
-- End of method definition for .levelPick()

------------------------------------------------------------------------
--
-- Method:      .levelFromPick()
--
-- Description: called by EDG to define height of Plane from
--              pick on corner SCTN
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      ARRAY       Data Array
--
------------------------------------------------------------------------
define method .levelFromPick(!data is EDGPOSITIONDATA)

  !atLevel = !data.item
  !rawLevel = !data.position.wrt( /* )

  -- Replace raw level with top (bottom) of steel

  if ( !atLevel.set() and !atLevel.type eq |SCTN| ) then
    !rawLevel = !atLevel.position.wrt( /* )
    if ( !this.plpp.selection() eq |ABOV|) then
      if ( !!alert.confirm(!!messageFile.messageString(162,22)) eq 'YES' ) then
        -- Replace current positions with 'Top of Steel'
        PIN1 AT $!rawLevel DIR U
        PIN1 BEHIND $!atLevel
        !rawLevel = !!posOfPin(1)
        PIN1 OFF
      endif
    elseif ( !this.plpp.selection() eq |BELO|) then
      if ( !!alert.confirm(!!messageFile.messageString(162,23)) eq 'YES' ) then
        -- Replace current positions with 'Bottom of Steel'
        PIN1 AT $!rawLevel DIR D
        PIN1 BEHIND $!atLevel
        !rawLevel = !!posOfPin(1)
        PIN1 OFF
      endif
    endif
  endif

  !datum = !this.datum.val.dbRef()
  !rawLevel = !rawLevel.wrt( !datum )

  !this.elevation.val = !rawLevel.up
  !this.changeElevation()

endmethod
-- End of method definition for .levelFromPick(EDGPOSITIONDATA)


------------------------------------------------------------------------
--
-- Method:      .changeOverhang()
--
-- Description: Change stored Ylength for current RPLA when
--               overhang RELATIVE to ANCHOR plane changed
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .changeOverhang()

  -- Overhang must be non-negative
  if ( !this.overhang.val lt 0 ) then
    !!messageFile.error( 162, 6)
    !this.overhang.val = 0
  endif

  -- Ylength is the 'Y' of anchor plane plus 2 * overhang of current plane.
  !anchorY = !this.rplaData[!this.anchorNumber].yLength
  !yLength = !anchorY + 2 * !this.overhang.val
  !this.currentRplaData.yLength = !yLength

  -- Update corner position Y values in form
  !this.aidBox()

endmethod
-- End of method definition for .changeOverhang()

------------------------------------------------------------------------
--
-- Method:      .measureOverhang()
--
-- Description: Initiate EDG to measure overhang
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .measureOverhang()

  -- Define the measure packet
  !packet        = object EDGPACKET()
  !packet.defineMeasure('distance')
  !packet.action = '!!rtrCreateRack.overhangMeasure(!this.return[1])'
  !!edgCntrl.add(!packet)


endmethod
-- End of method definition for .measureOverhang()

------------------------------------------------------------------------
--
-- Method:      .overhangMeasure(!line is LINE)
--
-- Description: Respond to EDG measure of overhang
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      LINE
--
------------------------------------------------------------------------
define method .overhangMeasure(!line is LINE)

  -- Unset line, is zero
  if(!line.unset()) then
    !this.overhang.val = 0
  else
    !this.overhang.val = !line.length()
  endif

  !this.changeOverhang()

endmethod
-- End of method definition for .overhangMeasure(LINE)

------------------------------------------------------------------------
--
-- Method:      .add()
--
-- Description: Add data for new RPLA to rplaData array
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .add()

  -- Create new RPLA in database
  !oldCe = !!ce
  !!ce = !this.rplg
  -- Create at end of list
  1
  LAST
  NEW RPLA
  !newId = !!ce
  !!ce = !oldCe

  !num = !this.rplaData.size() + 1
  !this.rplaData.append( !this.currentRplaData )
  !this.rplaData[!num].id = !newId

  -- and transfer from there to database
  !this.rplaData[!num].commit()

  -- Update displayed list
  !dtext = !this.members.dtext
  !rtext = !this.members.rtext

  if ( !this.currentRplaData.purpose eq 'PREX' ) then
    -- Put new entry / exit plane at end of list
    !index = !rtext.size() + 1
    !dtext[!index] = |  New Entry/Exit plane             | + !!rtrAlignDistance(!this.elevation.val)
    !rtext[!index] = !newId.string()
  else
    -- Find start of Entry / Exit planes in list; new travel plane will go just before this
    do !index to !rtext.size()
      if ( !rtext[!index] eq 'PREX' ) then
        break
      endif
    enddo
    !temp = |  New Travel plane                 | + !!rtrAlignDistance(!this.elevation.val)
    !dtext.insert(!index, !temp )
    !rtext.insert(!index, !newId.string())
  endif

  !this.members.dtext = !dtext
  !this.members.rtext = !rtext

endmethod
-- End of method definition for .add()

------------------------------------------------------------------------
--
-- Method:      .modify()
--
-- Description: Modify data for selected RPLA
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .modify()

  -- First 2 cases should not occur
  if ( !this.members.selection() eq 'PRRP' ) then
    !this.selectPlane()
  elseif ( !this.members.selection() eq 'PREX' ) then
    !this.selectPlane()
  else
    -- find which RPLA is being looked at.
    !num = !this.currentRpla()

    -- put current data in local store
    !id = !this.rplaData[!num].id
    !this.rplaData[!num] = !this.currentRplaData
    !this.rplaData[!num].id = !id

    -- and transfer from there to database
    !this.rplaData[!num].commit()

    !index = !this.members.val
    !dtext = !this.members.dtext
    !rtext = !this.members.rtext
    !string = !dtext[!index].substring(1,35) + !!rtrAlignDistance(!this.elevation.val)
    !dtext[!index] = !string
    !this.members.dtext = !dtext
    !this.members.rtext = !rtext
    !this.members.select( 'RTEXT', !id.string() )

  endif

endmethod
-- End of method definition for .modify()

------------------------------------------------------------------------
--
-- Method:      .remove()
--
-- Description: Delete selected RPLA
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .remove()

  -- Remove AID
  !boxNumber = !this.currentRplaData.aidNumber
  !!aidNumbers.remove(!boxNumber)

  !index = !this.members.val

  -- and delete RPLA
  -- First 3 cases should not occur
  if ( !this.members.selection() eq 'PRRP' ) then
    !this.selectPlane()
  elseif ( !this.members.selection() eq 'PREX' ) then
    !this.selectPlane()
  elseif ( !index eq 2 ) then
    -- Should not happen - cannot delete Anchor plane
    !this.selectPlane()
  else

    !num = !this.currentRpla()
    !id = !this.rplaData[!num].id

    !oldCe = !!ce
    !!ce = !id
    DELETE RPLA
    !!ce = !oldCe
    handle any
      -- Might have been at RPLA
    endhandle

    -- Update displayed list
    !dtext = !this.members.dtext
    !rtext = !this.members.rtext

    !dtext[!index].delete()
    !rtext[!index].delete()
    !dtext.compress()
    !rtext.compress()
    !this.members.dtext = !dtext
    !this.members.rtext = !rtext

    !this.selectPlane()
  endif

endmethod
-- End of method definition for .remove()

------------------------------------------------------------------------
--
-- Method:      .dismiss()
--
-- Description: Delete aid box
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .dismiss()

  -- Remove AID
  !boxNumber = !this.currentRplaData.aidNumber
  !!aidNumbers.remove(!boxNumber)

endmethod
-- End of method definition for .dismiss()
