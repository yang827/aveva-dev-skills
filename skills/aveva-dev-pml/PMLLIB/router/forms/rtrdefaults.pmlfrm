-- File:            rtrdefaults.pmlfrm
--   Type:          Form Definition
--   Group:         Router application
--     Keyword:     RTR
--   Module:        router
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Fri Jul 3 10:02:36 BST 1998
--
--
-- Description:
-- Shows the defaults for the current Router session, such as minimum
-- tube length.
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  rtrDefaults()                    -                   Constructor.
--
------------------------------------------------------------------------

setup form !!rtrDefaults

  title    |Pipe Router Defaults|
  iconti   |Defaults|
  revision | $$Revision: 1.12 $ |

  bar
    add |File| _FILE
  exit

  menu _FILE
    add |Save|         |CALLR MRRDEF 1|
    add |Save as...|   |CALLR MRRDEF 2|
    add separator
    add |Load|         |CALLR MRRDEF 3|
    add |Load from...| |CALLR MRRDEF 4|
  exit

  path down

  para _filename width 46 lines 1

  frame .writeTo 'Output messages to file'
    text _directory |Directory| width 20 string
    text _fl        |Filename | width 20 string

    path right
    option _overwrite width 9

    !over[1] = |Overwrite|
    !over[2] = |Append|

    !this.overwrite.dText = !over

    path down
    toggle _remove at xmin_fl |Remove Message file at end of session| STATES |OFF| |ON|
  exit

  option _onError   |Action on error        | width 20

  !getError[1] = |Stop|
  !getError[2] = |Continue|
  !getError[3] = |Pause|

  !this.onError.dText = !getError

  option _dirChange |Change direction using | width 20

  !changeDir[1]         = |Bend|
  !changeDir[2]         = |Elbow|
  !changeDir[3]         = |Rule    |
  !this.dirChange.dText = !changeDir

  option _rlSt |Default rule set/world | width 20

  !defaultRules[1] = |unset|
  !ruleRefs[1] = |unset|

  var !defaultSets COLLECT ALL RLWL
  var !defaultSets APPEND COLLECT ALL RLST

  do !defaultSet values !defaultSets
    !setName = !defaultSet.dbRef().fullName
    !defaultRules.append(!setName)
    if ( !setName.occurs(' ') eq 0 ) then
      !ruleRefs.append(!setName)
    else
      !ruleRefs.append(!defaultSet)
    endif
  enddo

  !this.rlSt.dText = !defaultRules
  !this.rlSt.rText = !ruleRefs

  option _rlWhere |Applied to all         | width 6

  !where[1] = |Site|
  !where[2] = |Zone|
  !where[3] = |Pipe|
  !where[4] = |Branch|

  !this.rlWhere.dText = !where

  frame .attr 'Extend Searching Volume' $* For Adding Planes/Racks Automatically'
    para _attr2 at x1 y0.4 text 'for adding planes/racks automatically'
    text _elev   |In Z Direction         | width 20 is REAL format !!distanceFmt
    text _width  |In X/Y Directions      | width 20 is REAL format !!distanceFmt
    text _minRun |Minimum Travel Distance| width 20 is REAL format !!distanceFmt
  exit

  frame .plane 'Pipe Rack Spacing'
    text _gap    |Pipe gap               | width 20 is REAL format !!distanceFmt
    text _round  |Pipe gap rounding      | width 20 is REAL format !!boreFmt
  exit

  button _dismiss |Dismiss| at xmax form-size ok

  member .data is STRING

exit

------------------------------------------------------------------------
--
-- Method:      .rtrDefaults()
--
-- Description: Constructor.
--
------------------------------------------------------------------------

define method .rtrDefaults()

  --  if( !!cdsfile eq |null|) then
  --    !!rtrDefaults.data |%PDMSDFLTS%/DES-ROUTER|
  --  else
  --    !!rtrDefaults.data = !!cdsfile
  --  endif

  !this.data         = |%PDMSDFLTS%/DES-ROUTER|
  !this.filename.val = |Defaults File Name : | + !this.data

endmethod
-- End of method definition for .rtrDefaults()
