--
-- File:            rtrimportpid.pmlfrm
--   Type:          Form Definition
--   Group:         Router application
--     Keyword:     RTR
--   Module:        router
--   Replaces:      FPID
--
-- Author:          Patricia Gardener
-- Created:
--
--
-- Description:
-- Import data from P&ID via neutral file
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  importFileCheck(FILE)            -                   check import file
--  importFileName()                 -                   import file name entered
--  initialise()                     -                   initialisation
--  logFileCheck(FILE)               -                   check log file
--  logFileName()                    -                   log file name entered
--  rtrImportPID()                   -                   Constructor.
--  runImport()                      -                   do that actual import
--  viewLog()                        -                   show log file
--
------------------------------------------------------------------------

setup form !!rtrImportPID

  title    |Import P&ID|
  iconti   |Import|
  revision | $$Revision: 1.2 $ |

  !this.callback = |!this.initialise()|

  path down
  bar
    add |Display|  _Display
--    add help
  exit

  menu _Display
    add |Log File...| |!this.viewLog()|
  exit

  path down

  para   _instruct1 width 71 lines 2
  para   _instruct2 width 71 lines 2

  text   _importFile |Import File | width 51  scroll 70 string
  path right
  button _importBrowse  |Browse...|

  path down
  text   _logFile |Log File    |  at xmin form width 51 scroll70 string
  path right
  button _logBrowse |Browse...|

  path down

  frame   _options at xmin form ymin+2.0 |Options:|

    toggle _delete   |Modify elements, do not ask.|
    toggle _keepFile |Do NOT delete generated macro.|
    toggle _showLog  |Show log file after import.|
    toggle _unNameTees |Un-name tees after import.|
  exit

  para   _errorReport at ymax+1 width 30 lines 2

  list _replace |Modified Pipes & Branches:|at xmax_options+3 ymin_options width 35 lines 10

  button _run    |Run Import| at xmin form apply
  button _cancel | Dismiss  | at xmax form-size ymin cancel

  -- Members

  member .numberError is REAL
  member .numberWarning is REAL

-- End of form definition
exit

------------------------------------------------------------------------
--
-- Method:      .rtrImportPID()
--
-- Description: Constructor.
--
------------------------------------------------------------------------

define method .rtrImportPID()

  !instruct = !!messageFile.messageString(162,40)
  !instruct = !instruct + !!messageFile.messageString(162,41)

  !this.instruct1.val = !instruct

  !instruct = !!messageFile.messageString(162,42)
  !instruct = !instruct + !!messageFile.messageString(162,43)

  !this.instruct2.val = !instruct

  -- Callbacks
  !this.importFile.callback = '!this.importFileName()'
  !this.importBrowse.callback = '!!fileBrowser(|"%PDMSUSER%"|, ||, |P&ID Import file|, TRUE, |!!rtrImportPID.importFileCheck(!!fileBrowser.file)|)'
  !this.logFile.callback ='!this.logFileName()'
  !this.logBrowse.callback = '!!fileBrowser(|"%PDMSUSER%"|, ||, |P&ID Import log|, TRUE, |!!rtrImportPID.logFileCheck(!!fileBrowser.file)|)'
  !this.run.callback = '!this.runImport()'

endmethod
-- End of method definition for .rtrImportPID()

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .initialise()

  !this.importFile.val = ''
  !this.logFile.val = ''

  !this.run.active = false
  !this.showLog.active = false

  !this.numberError = 0
  !this.numberWarning = 0

  !this.errorReport.val = ''
  !this.replace.dtext = ARRAY()

endmethod
-- End of method definition for .initialise()

------------------------------------------------------------------------
--
-- Method:      .importFileName()
--
-- Description: import file name entered
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .importFileName()

  !file = object FILE( !this.importFile.val )

  !this.importFileCheck( !file )

endmethod
-- End of method definition for .importFileName()

------------------------------------------------------------------------
--
-- Method:      .importFileCheck()
--
-- Description: check import file
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .importFileCheck( !file is FILE )

  !this.importFile.val = !file.name()
  !this.run.active = false
  if ( !file.unset() ) then
    !!messageFile.error( 162, 44)
    return
  elseif ( not !file.exists() ) then
    !!messageFile.error( 162, 45)
    return
  endif

  !this.run.active = true
  !this.errorReport.val = ''
  !this.replace.dtext = ARRAY()

endmethod
-- End of method definition for .importFileCheck( !file is FILE )

------------------------------------------------------------------------
--
-- Method:      .logFileName()
--
-- Description: log file name entered
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .logFileName()

  !file = object FILE( !this.logFile.val )

  !this.logFileCheck( !file )

endmethod
-- End of method definition for .importFileName()

------------------------------------------------------------------------
--
-- Method:      .logFileCheck()
--
-- Description: check log file
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .logFileCheck( !file is FILE )

  if ( !file.unset() ) then
    !this.logFile.val = ''
    !this.showLog.active = false
  else
    !file.open( 'WRITE' )
    handle ANY
      !this.logFile.val = ''
      !this.showLog.active = false
      return
    endhandle
    !this.logFile.val = !file.name()
    !this.showLog.active = true
  endif

endmethod
-- End of method definition for .logFileCheck( !file is FILE )

------------------------------------------------------------------------
--
-- Method:      .runImport()
--
-- Description: do that actual import
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .runImport()

  !this.numberError = 0
  !this.numberWarning = 0

  !inFile = object FILE( !this.importFile.val )
  !outFile = object FILE( !this.logFile.val )
  !ifUnNameTees = !this.unNameTees.val
  !ifKeep = !this.keepFile.val
  !ifAsk = not !this.delete.val
  !replaced = ARRAY()
  !!rtrPIDProcess( !inFile, !outFile, !ifAsk, !ifUnNameTees, !ifKeep, !replaced )
  !this.replace.dtext = !replaced

  if ( !this.showLog.val ) then

    !this.viewLog()
  endif
  !string = !!messageFile.messageString(162,51,!this.numberError.string())
  !string = !string + !!messageFile.messageString(162,52,!this.numberWarning.string())

  !this.errorReport.val = !string

endmethod
-- End of method definition for .runImport()

------------------------------------------------------------------------
--
-- Method:      .viewLog()
--
-- Description: show log file
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .viewLog()

  !file = object FILE( !this.logFile.val )
  if ( !file.unset() ) then
    !this.logFile.setFocus()
    !!messageFile.error( 162, 46)
    return
  elseif ( not !file.exists() ) then
    !this.logFile.setFocus()
    !!messageFile.error( 162, 47)
    return
  endif

  !string = !!messageFile.messageString(162, 53)
  prompt |$!string|

  show !!fileViewer
  !!fileViewer(!this.logFile.val, 'View log file')
  prompt ''

endmethod
-- End of method definition for .viewLog()
