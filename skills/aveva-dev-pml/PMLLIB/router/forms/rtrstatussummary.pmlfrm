-- File:            rtrstatussummary.pmlfrm
--   Type:          Form Definition
--   Group:         Router application
--     Keyword:     RTR
--   Module:        router
--   Replaces:
--
-- Author:          P.Gardener
-- Created:
--
--
-- Description:
-- Display a summary of number of branches on main router form by status (BSTAT)
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  initialise()                     -                   initialisation
--  rtrStatusSummary()               -                   Constructor.
--
------------------------------------------------------------------------


setup form !!rtrStatusSummary

  title    |Pipe Router Status Summary|
  iconti   |Branch Status|
  revision | $$Revision: 1.2 $ |

  !this.callback = '!this.initialise()'
  vdist 0
  path down

  para _summary0 width 55 lines 1
  para _summary1 width 55 lines 1
  para _summary2 width 55 lines 1
  para _summary3 width 55 lines 1
  para _summary4 width 55 lines 1
  para _summary5 width 55 lines 1
  para _summary6 width 55 lines 1
  para _summary7 width 55 lines 1
  para _summary8 width 55 lines 1
  para _summary9 width 55 lines 1
  para _summary10 width 55 lines 1


  button _update  |Update | at xmin form
  path right
  button _dismiss |Dismiss| at xmax form-size ok

exit

------------------------------------------------------------------------
--
-- Method:      .rtrStatusSummary()
--
-- Description: Constructor.
--
------------------------------------------------------------------------

define method .rtrStatusSummary()

  -- Callbacks
  !this.update.callback          = |!this.initialise()|

endmethod
-- End of method definition for .rtrStatusSummary()

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: initialisation
--
------------------------------------------------------------------------

define method .initialise()

  do !stat from 0 to 10
     !nBran[!stat] = 0
  enddo

  !branchList = !!cdRouter.pipeList.rtext
  !width = !branchlist.size().string().length() + 1

  do !br values !branchList
     !stat = !br.dbRef().bstat
     !nBran[!stat] = !nBran[!stat] + 1
  enddo

  do !stat from 0 to 10
     !line = !this.summary$!stat
     var !comp compose '$!nBran[$!stat]' width $!width '$!!bstat[$!stat]'
     !line.val  = !comp[1]
  enddo

endmethod
-- End of method definition for .initialise()
