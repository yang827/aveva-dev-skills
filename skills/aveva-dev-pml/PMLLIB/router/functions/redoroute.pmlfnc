--
-- Description:
-- redo the undone  pipes
--
------------------------------------------------------------------------
define function !!redoRoute()

   -- Call REDODB, if the call is successful then check redo has not
   -- undone the 'end mark'. If last mark is 'end mark' then undo the last
   -- last redo and grey out the redo button
   REDODB 1
   handle any
      !!alert.error('No routes can be re-done')
      !!cdRouter.btnRedo.active = false
      return
   endhandle

   -- check the last mark
   REDODB 1
   !mark = MARKDB
   if ((!mark.set()) and (!mark[!mark.maxIndex()] eq 'endmark')) then
      --undo last redo action and grey out redo button
      !!cdRouter.btnRedo.active = false
   endif
   UNDODB 1
   handle any
   endhandle
   -- making sure the undo button is activated after a successful redo
   !!cdRouter.btnUndo.active = true

   !!rtrformupdate()

endfunction
-- End of function definition for !!redoRoute
