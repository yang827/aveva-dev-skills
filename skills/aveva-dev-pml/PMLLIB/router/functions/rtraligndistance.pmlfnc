-- File:            rtraligndistance.pmlfnc
--   Type:          Function Definition
--   Group:         Router application
--     Keyword:     RTR
--   Module:        router
--   Replaces:
--
-- Author:          Patricia Gardener
-- Created:
--
--
-- Description:
-- Passed a REAL which is a distance, returns a string with 10 characters
--   (i.e. blank-padded) BEFORE the 'major' unit (mm / feet / inch )
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL       Distance
-- Return:
--   [Data Type] [Description]
--    STRING      distance formatted
--
------------------------------------------------------------------------

define function !!rtrAlignDistance(!distance is REAL) is STRING

  !result1 = !distance.distance()
  !stringLength = !result1.length()

  !blanks = '        '
  !padded = !blanks + !result1

  -- Get current unit.
  var !unit UNIT
  !units = !unit.split()
  -- Depending on the current unit, find decimal point / feet part
  if ( !units[3] eq |FINC|) then
    !alignAt = !result1.match('ft')
    if ( !alignAt eq 0 ) then
      !alignAt = !result1.match(|'|)
      if ( !alignAt eq 0 ) then
        !padded = ' ' + !padded
        !alignAt = 1
      endif
    endif
  else
    !alignAt = !result1.match(|.|)
    if ( !alignAt eq 0 ) then
      !padded = !padded + ' '
      !stringLength = !stringLength + 1
      !alignAt = !stringLength
    endif
  endif

  if ( !alignAt gt 8 ) then
    return !result1
  endif

  !result = !padded.substring( !alignAt )

  return !result

endfunction
-- End of function definition for !!rtrAlignDistance
