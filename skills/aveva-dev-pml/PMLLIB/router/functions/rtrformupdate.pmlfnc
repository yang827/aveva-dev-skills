-- File:            rtrformupdate.pmlfnc
--   Type:          Function Definition
--   Group:         Router application
--     Keyword:     RTR
--   Module:        router
--
-- Author:          Tony Martin
-- Created:
--
--
--
-- Description:
-- Passed branch reference, this finds the branch in the main router form
-- and updates its status in the list without the need to refresh the whole
-- list
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbRef       recently routed branch
------------------------------------------------------------------------
define function !!rtrformupdate()

  !dtext = !!cdRouter.pipeList.dtext
  !rtext = !!cdRouter.pipeList.rtext
  !selected = !!cdRouter.pipeList.val

  do !number indices !!cdRouter.pipeList.rtext
    !item = !!cdRouter.pipeList.rtext[!number].dbRef()
    !branchStatus = !item.bStat
    !status = !!bStat[!branchStatus.real()]
    !line = !!cdRouter.pipeList.dtext[!number]
    !ll = !line.split()

    !newline = !ll[1] & '	' & !ll[2] & '	' & !status
    !dtext[!number] = !newline
  enddo

  !!cdRouter.pipeList.dtext = !dtext
  !!cdRouter.pipeList.rtext = !rtext

  -- reselect previously selected branches
  !!cdRouter.pipeList.val = !selected

endfunction
