--
-- File:            rtrgeticonnum.pmlfnc
--   Type:          Function Definition
--   Group:         Router application
--     Keyword:     RTR
--   Module:        router
--   Replaces:      rtrgeticonSnum.pmlfnc ( in design )
--
-- Author:          P.Mooney
-- Created:         Fri Jun 19 16:08:35 BST 1998
--
--
-- Description:
-- Passed in an element for a branch and returns the number a new constraint
-- would go after. EG

--    plane 1
--    /Rack1
--    REDUCER 1
--    ELBO 1

-- if a new constraint was to go after ELBO 1, it would be go after constraint
-- 2, after the plane and the rack.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbRef       The branch to get the constraints from
-- Return:
--   [Data Type] [Description]
--    ARRAY       The constraint list. See format in above comment.
--
------------------------------------------------------------------------

define function !!rtrGetIconNum(!dummyBranch is DBREF, !element is DBREF) is REAL

  !oldCe    = !!ce

  !sequNum  = !element.sequ
  !iconsNum = 0

  do !x

    ROUTER

      var !after ICONS POINT $!x COMPONENT
      handle any
        var !after ICONS PLANE $!x COMPONENT
        handle any
          -- no more constraints, break out of loop
          EXIT
          break
        endhandle

        EXIT

      elsehandle none
        EXIT
      endhandle

    if ( !after eq |HEAD| ) then
        !iconsNum = !iconsNum + 1

    else

      !afterSequNum = !after.dbRef().sequ

      if(!afterSequNum lt !sequNum) then
        !iconsNum = !iconsNum + 1

      else
          break
      endif
    endif

  enddo

  !!ce = !oldCe

  return !iconsNum

endfunction
-- End of function definition for !!rtrGetIconNum
