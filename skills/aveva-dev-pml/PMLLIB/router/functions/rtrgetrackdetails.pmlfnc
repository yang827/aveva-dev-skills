--
-- File:            rtrgetrackdetails.pmlfnc
--   Type:          Function Definition
--   Group:         Router application
--     Keyword:     RTR
--   Module:        router
--   Replaces:      MMKSTRG FORM
--
-- Author:          Patricia Gardener
-- Created:
--
--
-- Description:
-- Passed a RPLG, stores details of it's RPLA's in array;
--  This array can then be used as a temporary copy during development
--   of the pipe-rack and stored or discarded on OK / CANCEL
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbRef       RPLG representing the pipe-rack (owns the RPLAs)
-- Return:
--   [Data Type] [Description]
--    ARRAY       Array of rplaData objects
--
------------------------------------------------------------------------

define function !!rtrGetRackDetails(!rplg is DBREF) is ARRAY

  !rplgData = ARRAY()

  -- Check !rplg is RPLG
  if ( !rplg.type ne 'RPLG' ) then
    !!messageFile.error(162, 14)
    return !rplgData
  endif

  do !rpla values !rplg.members

    !rplgData.append(object RTRRPLA(!rpla))
  enddo

  return !rplgData

endfunction
-- End of function definition for !!rtrGetRackDetails
