-- File:            rtrnumberofconstraints.pmlfnc
--   Type:          Function Definition
--   Group:         Router application
--     Keyword:     RTR
--   Module:        router
--   Replaces:
--
-- Author:          Patricia Gardener
-- Created:
--
--
-- Description:
-- Passed a Branch, reports the number of Router constraints on it
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      dbRef       the Branch
-- Return:
--   [Data Type] [Description]
--    REAL        The number of constraints
--
------------------------------------------------------------------------

define function !!rtrNumberOfConstraints(!branch is DBREF) is REAL


  -- Check !branch is BRAN
  if ( !branch.type ne 'BRAN' ) then
    return 0
  endif

  !oldCe = !!ce

  !!ce = !branch
  ROUTER
  var !numberConstraints ICONS NUMB
  EXIT
  !!ce = !oldCe

  return !numberConstraints.real()

endfunction
-- End of function definition for !!rtrNumberOfConstraints
