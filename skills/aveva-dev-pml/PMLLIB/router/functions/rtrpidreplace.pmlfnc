-- File:            rtrpidreplace.pmlfnc
--   Type:          Function Definition
--   Group:         Router application
--     Keyword:     RTR
--   Module:        router
--   Replaces:      MDELETE
--
-- Author:          Patricia Gardener
-- Created:
--
--
-- Description:
-- Passed a Branch or Pipe, determines if it should be deleted
--  (e.g. by asking the User if that is required) to be replaced
--  during P&ID input
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      the Branch Pipe name
--    2   RW     ARRAY       pipes and branches replaced during import
-- Return:
--   [Data Type] [Description]
--    BOOLEAN     true if pipe / branch should be deleted
--
------------------------------------------------------------------------

define function !!rtrPIDreplace(!branchName is STRING, !ask is BOOLEAN, !replaced is ARRAY) is BOOLEAN

  -- Check !branchName is valid
  !branch = !branchName.dbRef()

  handle ANY
    !tryName = '/' & !branchName
    !branch = !tryName.dbRef()
    handle ANY
      return true
    endhandle
  endhandle

  -- Check !branch is BRAN or PIPE
  !type = !branch.type
  if ( !type ne 'BRAN' and !type ne 'PIPE' ) then
    return false
  endif

  if ( !ask ) then
    if ( !!alert.confirm(!!messageFile.messageString(162,50,!branchName)) eq 'NO') then

      return false
    endif
  endif

  -- Delete the pipe or branch
  -- !oldCe = !!ce
  -- !!ce = !branch
  -- DELETE $!type
  -- !!ce = !oldCe
  -- handle ANY
    -- Pipe / Branch was ce
  -- endhandle
  if ( !type eq 'BRAN' ) then
    !string = 'Branch ' + !branchName
  else
    !string = 'Pipe   ' + !branchName
  endif
  !replaced.append( !string )
  return true

endfunction
-- End of function definition for !!rtrPIDreplace(!branchName is STRING, !ask is BOOLEAN, !replaced is ARRAY )
