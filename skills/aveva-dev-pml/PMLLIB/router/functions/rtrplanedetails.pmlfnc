--   Type:          Function Definition
--   Group:         Router application
--     Keyword:     RTR
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Mon Jun 8 12:02:44 BST 1998
--
--
-- Description:
-- gets the details of the plane so it can be added to the main list gadget
-- on the branch detail form
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!rtrPlaneDetails(!planeNum is REAL, !iconsNum is STRING) is STRING

  !currentEle = !!ce

  ROUTER
    var !rplane ICONS PLANE $!iconsNum RPLA
  EXIT

  $!rplane
  var !ty TYPE

  -- Get type of element for BD form list
  if(!ty eq |RPLA|) then
    !type = 'Routing Plane ' + !planeNum.string()
  else
    !type = 'Pipe Rack ' + !planeNum.string()
  endif

  !rplane = NAME

  ---------------------------------------------------------
  -- if constraint is pipe rack, get info from first plane
  -- If no RPLA's exist, set flag to not get position etc.
  ---------------------------------------------------------

  !noPlanes = FALSE

  if ( match(|$!type|,|Pipe Rack|) gt 0) then
    RPLA1
    handle any
      !record[1] = !rplane & '	' & !type & '	' & |Unpositioned| & '	' & |No Planes|
      !noPlanes = TRUE
    endhandle
  endif

  if(!noPlanes eq FALSE) then

    var !pos  POS WRT $_cdPoints_WRT
    var !enex PLED
    handle any
      var !en ||
    elsehandle none
      var !en |Entry/Exit $!enex   |
    endhandle

    -- Get X Direction, hence, travel direction

    !planeOri = !!ce.ori
    !xDir     = !planeOri.yDir().orthogonal(!planeOri.zDir())

    if(!xDir.east neq 0) then
      if ( !!coords.xyzflag ) then
         !dir = |Dir X/-X|
      else
         !dir = |Dir E/W|
      endif

    elseif(!xDir.north neq 0) then
      if ( !!coords.xyzflag ) then
         !dir = |Dir Y/-Y|
      else
         !dir = |Dir N/S|
      endif

    elseif(!xDir.up neq 0) then
      if ( !!coords.xyzflag ) then
         !dir = |Dir Z/-Z|
      else
         !dir = |Dir U/D|
      endif

    else
      var !dir |ERROR|
      write 'WARNING: xdir not correctly computed.'
    endif

    -- make up record for BD form list
    !record[1] = !rplane & '	' & !type & '	' & !pos & '	' & !dir

    -- put a text marker next to plane
    AID TEXT NUMBER $!!noOfSp |$!rplane| AT $!pos WRT $_cdPoints_WRT

  endif

  -- add RPLA to Constraint Types global array
  !!conAvail.append(!rplane)

  !!ce = !currentEle

  return !record[1]

endfunction
-- End of function definition for !!rtrPlaneDetails
