--
-- File:            rtrpointdetails.pmlfnc
--   Type:          Function Definition
--   Group:         Router application
--     Keyword:     RTR
--   Module:        design
--   Replaces:
--
-- Author:          P.Mooney
-- Created:         Mon Jun 8 12:08:59 BST 1998
--
--
-- Description:
-- gets the details of a point constraint and adds it to the branch detail form.
-- Displays design aids too.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!rtrPointDetails(!points is REAL, !iconsNum is STRING) is STRING

  ----------------------------------------------------------------------
  -- Field space widths.
  --
  -- **WARNING **
  --
  -- If these numbers are changed, change in MINPL and IPOINTS also
  -- rtrPlaneDetails()
  ----------------------------------------------------------------------

  var !f2 26
  var !f3 16
  var !f4 38
  var !f5 12

  -- Calculate whether we are working in metric or imperial units
  if(!!isImperialLength('DIST')) then
    PRECISION VAR 1/16
    var !default ||
  else
    PRECISION VAR 1DP
    var !default |PRECISION VAR 6DP|
  endif

  -- store name of point
  !field1 = 'Point ' + !points.string()


  -- get position and direction for core
  ROUTER
    var !field3 ICONS POINT $!iconsNum ACTUAL POSITION WRT $_cdPoints_WRT
    var !field4 ICONS POINT $!iconsNum DIR
    handle any
      EXIT
      var !field4 ||
      ROUTER
    elsehandle none
      exit
      var !coordinate coordinate
      if (!coordinate eq 'XYZ') then
         !field4.trim()
         !field4 = !field4.replace('E','X').replace('W','-X').replace('N','Y').replace('S','-Y').replace('U','Z').replace('D','-Z')
      else
         !field4.trim()
         !field4 = !field4.replace('X','E').replace('-X','W').replace('Y','N').replace('-Y','S').replace('Z','U').replace('-Z','D')
      endif
      ROUTER
    endhandle

    var !field5 ICONS POINT $!iconsNum LEAV
    handle(62,707)
      EXIT
      var !field5 ||
      ROUTER
    elsehandle none
      exit
      if (!coordinate eq 'XYZ') then
         !field5.trim()
         !field5 = !field5.replace('E','X').replace('W','-X').replace('N','Y').replace('S','-Y').replace('U','Z').replace('D','-Z')
         var !field5 |Leave $!field5|
      else
         !field5.trim()
         !field5 = !field5.replace('X','E').replace('-X','W').replace('Y','N').replace('-Y','S').replace('Z','U').replace('-Z','D')
         var !field5 |Leave $!field5|
      endif
      ROUTER
    endhandle

    EXIT

    -- Change arrive to direction
    if(|$!field5| eq || and |$!field4| neq ||) then
      var !field4 |Direction $!field4|
    elseif(|$!field4| neq ||) then
      var !field4 |Arrive $!field4|
    endif

    ROUTER
      var !unusedFx ICONS POINT $!iconsNum FIXED
    EXIT

    !field2 = 'Constraint'

    if(!field3 eq |HEAD|) then
      !field3 = 'Head W-P'
    endif

    -- construct record to be displayed
    !record = !field1 & '	' & !field2 & '	' & !field3 & '	' & !field4 & '  ' & !field5

    -- draw sphere with name
    AID SPHERE NUMBER $!!noOfSp $!field3  WRT $_cdPoints_WRT DIAMETER 250 MM

    var !eval[1] ||
    var !eval SPLIT |$!field4|

    if(!field5 neq || or !eval[1] eq |Direction|) then
      if(!eval[1] eq |Direction|) then
        var !leave SPLIT |$!field4|
      else
        var !leave SPLIT |$!field5|
      endif
      AID ARROW NUMBER $!!noOfSp AT $!field3 WRT $_cdPoints_WRT DIRECTION $!leave[2] HEIGHT 400 MM
    endif

    if(!field4 neq ||) then
      var !arrive SPLIT |$!field4|
      var !plane  CONSTRUCT PLANE $!arrive[2] THROUGH $!field3 DISTANCE 400 MM
      var !aPos   CONSTRUCT POSITION $!plane
      AID LINE NUMBER $!!noOfSp $!aPos WRT $_cdPoints_WRT TO $!field3 WRT $_cdPoints_WRT
    endif


    AID TEXT NUMBER $!!noOfSp |$!field1| AT $!field3 WRT $_cdPoints_WRT

    var !!conAvail APPEND |$!field1|

  $!default

  return !record

endfunction
-- End of function definition for !!rtrPointDetails
