--
-- File:            rtrwritelog.pmlfnc
--   Type:          Function Definition
--   Group:         Graphic View
--     Keyword:     ROUTER
--   Module:        design
--   Replaces:      UWRITLOG
--
-- Author:          P.Gardener
-- Created:
--
--
-- Description:
-- writes out message to log file (if Parameter 1 contains an open file )
--  AND command line.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      FILE        Log file
--    2   R      STRING      Message to print. If eq 'BANNER' then it
--                           prints out a banner.
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define function !!rtrWriteLog(!logFile is FILE, !message is STRING)

  var !device DEVICE

  if(!message.match('BANNER') eq 1 ) then

    -- Start. Output banner

    !text = !message.split()
    !importFileName = !text[2]

    var !user USER
    var !date CLOCK
    var !project PROJ NAME
    var !mdb  MDB

    !string1 = | ****************************************************************|
    !string2 = ||
    !string3 = |  PDMS Router Import|
    !string4 = |    Import File : | + !importFileName
    !string5 = |    Date        : | + !date
    !string6 = |    User        : | + !user
    !string7 = |    Project     : | + !project
    !string8 = |    Database    : | + !mdb


    if ( !logFile.set() ) then
      !logFile.writeRecord( !string1 )
      !logFile.writeRecord( !string2 )
      !logFile.writeRecord( !string3 )
      !logFile.writeRecord( !string2 )
      !logFile.writeRecord( !string4 )
      !logFile.writeRecord( !string5 )
      !logFile.writeRecord( !string6 )
      !logFile.writeRecord( !string7 )
      !logFile.writeRecord( !string8 )
      !logFile.writeRecord( !string2 )
      !logFile.writeRecord( !string1 )
      !logFile.writeRecord( !string2 )

    endif

    -- $P $!string1
    -- $P $!string2
    -- $P $!string3
    -- $P $!string2
    -- $P $!string4
    -- $P $!string5
    -- $P $!string6
    -- $P $!string7
    -- $P $!string8
    -- $P $!string2
    -- $P $!string1

    if(!device ne |TTY|) then
      !string = !!messageFile.messageString(162,59)
      prompt '$!string'
    endif

  elseif(!message eq |FINISH|) then

    -- End of Import File

    if(!device ne |TTY|) then
      prompt ||
    endif

    if( !logFile.set() ) then
      !string = !!messageFile.messageString(162,60)
      !logFile.writeRecord( !string )
    endif

  else

    -- Other message

    -- $P $!message

    if(!device ne |TTY| AND !message ne ||) then
      prompt |$!message|
    endif

    if( !logFile.set() ) then
      !logFile.writeRecord( !message )
    endif

    -- If error or warning add to total for rtrImportPID form

    if ( defined(!!rtrImportPID) ) then
      if ( !message.part(1) eq 'ERROR:' ) then
        !!rtrImportPID.numberError = !!rtrImportPID.numberError + 1
      elseif ( !message.part(1) eq 'WARNING:' ) then
        !!rtrImportPID.numberWarning = !!rtrImportPID.numberWarning + 1
      endif
    endif

  endif

return

endfunction
-- End of function definition for !!rtrWriteLog(!logFile is FILE, !message is STRING)
