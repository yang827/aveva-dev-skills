--
-- Description:
-- Undo the routed pipes
--
------------------------------------------------------------------------
define function !!undoRoute()

   -- To check whether user has made any changes to the database
   -- since the last routing. if REDODB produces error then undo
   -- action will not be available
   REDODB 1
   handle none
      UNDODB 1
   elsehandle any
      -- clear the MARKDB stack
      MARKDB CLEAR

      -- Grey out undo and redo button
      !!cdRouter.btnUndo.active = false
      !!cdRouter.btnRedo.active = false
   endhandle

   -- Implement undo action
   UNDODB 1
   handle any
      !!cdRouter.btnUndo.active = false
      return
   endhandle

   !!cdRouter.btnRedo.active = true
   !mark = MARKDB
   if (!mark.set().not()) then
      !!cdRouter.btnUndo.active = false
   endif

   !!rtrformupdate()

endfunction
-- End of function definition for !!undoRoute
