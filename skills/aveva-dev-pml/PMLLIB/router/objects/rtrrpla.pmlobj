-- File:            rtrrpla.pmlobj
--   Type:          Object Definition
--   Group:         Router Planes
--     Keyword:     RPLA
--   Module:        Router
--   Replaces:
--
-- Author:          P.Gardener
-- Created:
--
--
-- Description:
-- Contains details of Routing Planes within Routing Plane Group
--  for Rack definition
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  aidNumber()                      REAL                Get aidNumber
--  commit()                         -                   Store details of RPLA in database
--  function()                       STRING              Get function
--  gapType()                        STRING              Get gapType
--  ori()                            ORIENTATION         Get ori
--  packMethod()                     STRING              Get packMethod
--  pipePosition()                   STRING              Get pipePosition
--  position()                       POSITION            Get position
--  rtrRpla(DBREF)                   -                   Constructor - Get details of RPLA
--  xLength()                        REAL                Get xLength
--  yLength()                        REAL                Get yLength
--
------------------------------------------------------------------------

-- Define object

define object RTRRPLA

  -- Identity of plane
  member .id is DBREF

  -- Geometry
  member .position is POSITION
  member .xLength is REAL
  member .yLength is REAL
  member .ori is ORIENTATION

  -- Routing details
  member .purpose is STRING        $* Purpose of plane - PREX for Entry/Exit
  member .function is STRING       $* Function of plane (for Rules)
  member .pipePosition is STRING   $* Pipe Position: CENTRE, ABOVE, BELOW
  member .packMethod is STRING     $* Packing method: NEAR or WEIGHT
  member .gapType is STRING        $* gap method: Wall-to-wall,
                                   --  Wall-to-flange or Flange-to-flange

  -- Aid Number
  member .aidNumber is REAL

endobject
-- End of object definition for RTRRPLA


------------------------------------------------------------------------
--
-- Method:      .rtrRpla
--
-- Description: Constructor - Get details of RPLA
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       The RPLA
--
------------------------------------------------------------------------

define method .rtrRpla(!rpla is DBREF)

  -- Check !rpla is RPLA
  if ( !rpla.type ne 'RPLA' ) then
    !!messageFile.error(162, 14)
    return
  endif

  !this.id = !rpla
  !this.position = !rpla.position.wrt(World)
  !this.xLength = !rpla.xLength
  !this.yLength = !rpla.yLength
  !this.ori = !rpla.ori.wrt(World)

  !this.purpose = !rpla.purp

  if ( !rpla.function.unset() ) then
    !this.function = ''
  else
    !this.function = !rpla.func
  endif

  if ( !rpla.plpp.unset() or !rpla.plpp eq '' ) then
    !this.pipePosition = 'ABOV'
  else
    !this.pipePosition = !rpla.plpp
  endif

  if ( !rpla.plpm.unset() or !rpla.plpm eq ''  ) then
    !this.packMethod = 'NEAR'
  else
    !this.packMethod = !rpla.plpm
  endif

  if ( !rpla.plww.unset() or !rpla.plww eq ''  ) then
    !this.gapType = 'WW'
  else
    !this.gapType = !rpla.plww
  endif

  !this.aidNumber = !!aidNumbers.add('Router Rack')

endmethod
-- End of method definition for .rtrRpla(DBREF)

------------------------------------------------------------------------
--
-- Method:      commit
--
-- Description: Store details of RPLA in database
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------

define method .commit()

  if ( !this.id.badRef() ) then
    !!messageFile.error( 162, 16, !this.id.name )

  else

    !oldCe = !!ce
    !!ce = !this.id

    POS $!<this.position>
    ORI $!this.ori
    XLEN $!this.xLength
    YLEN $!this.yLength

    PURP $!this.purpose
    if ( !this.function.upcase() ne 'UNSET' and !this.function ne '') then
      FUNC |$!this.function|
    endif

    PLPP $!this.pipePosition
    PLPM $!this.packMethod
    PLWW $!this.gapType

    !!ce = !oldCe
  endif

endmethod
-- End of method definition for .commit()

