-- Define object

define object RULESAPPLY

  -- HIGH or LOW priority
  member .priority is STRING
  -- Name of Branch etc. to which ruleset applies
  member .brName is STRING
  -- Name of ruleset
  member .ruleSetName is STRING
  -- Apply to Branch / Pipe / Zone / Site
  member .hierarchy is STRING

endobject
-- End of object definition for RULESAPPLY
