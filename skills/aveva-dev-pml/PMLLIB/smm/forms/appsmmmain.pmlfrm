-- Description:     Main form for Schematic Model Manager
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  appSMMMain()                     -                   Constructor method
--  initialise()                     -                   takes the place of the DES\GEN\ISYSTEM macro
--
------------------------------------------------------------------------
setup form !!appSMMMain at xr 0 yr 0 main

  -- !iconSize = !!comSysOpt.iconSize()
  -- icon size is now 16 because we can't change the size of icons on toolbars
  -- !iconSize = 16
  var !projectCode PROJECT CODE

  title     |Schematic Model Manager - AVEVA Engineering (Project:$!projectCode)|
  iconTitle |AVEVA Schematic Model Manager|
  revision  | $$Revision: 1.1 $ |
  !this.quitCall = |CALLIB XEXIT|

  -- Main bar Menu
  bar
  --  add |Design|    _sysDes
  --  add |Display|   _sysView
  --  add |Query|     _sysQry
  --  add |Utilities| _sysUtil
  --  add window
  --  add help
  exit

exit

------------------------------------------------------------------------
--
-- Method:      .appSMMMain()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .appSMMMain()

  -- set initialisation callback
  !this.initcall = '!this.initialise()'

  -- find current project and global status
  -- !project = current project
  -- !isGlobal = !project.isGlobal()

endmethod
-- End of method definition for .appSMMMain()

------------------------------------------------------------------------
--
-- Method:      .initialise()
--
-- Description: takes the place of the DES\GEN\ISYSTEM macro
--
-- Method Type: Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .initialise()

endmethod
-- End of method definition for .initialise()
