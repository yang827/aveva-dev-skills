import 'Aveva.Pdms.Database.View'
handle (1000,0)
endhandle
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            dbviewio.pmlobj
--   Type:          Object Definition
--   Group:         Aveva.Database.View
--
--   Keyword:       Aveva.Database.View
--   Module:        All
--   Replaces:
--
-- Author:
-- Created:         Mon May 12th 2008
--
--
-- Description:
-- XML input and output support for Database View structures
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  callback(ARRAY)                  -
--  createXSDForView(STRING,STRING)  BOOLEAN
--  createXSDForViews(ARRAY,STRING)  BOOLEAN
--  dbviewio()                       -
--  importFile(STRING)               REAL
--  loadXSL(STRING)                  BOOLEAN
--  transformView(STRING,STRING)     BOOLEAN
--  transformView(STRING,STRING,ARRAY,ARRAY) BOOLEAN
--  transformViews(ARRAY,STRING)     BOOLEAN
--  transformViews(ARRAY,STRING,ARRAY,ARRAY) BOOLEAN
--  unitsOfMeasureDbFormats(ARRAY,ARRAY,ARRAY) -                   Outputs the units of measure given the format information for each dimension
--
------------------------------------------------------------------------
define object DBVIEWIO

  member .dbviewionet              is ARRAY
  member .instanceNo               is REAL
  member .referencesAsNames        is BOOLEAN
  member .resolvableNames          is BOOLEAN
  member .outputDateTimeAsLocal    is BOOLEAN

endobject
-- End of object definition for DBVIEWIO

------------------------------------------------------------------------
--
-- Method:      DBVIEWIO
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .dbviewio()

  USING NAMESPACE 'Aveva.Pdms.Database.View'

  if (defined(!!xslviewpmlinstance)) then
    !this.instanceNo = !!xslviewpmlinstance.dbviewionet.size() + 1
    !!xslviewpmlinstance.dbviewionet[!this.instanceNo] = object DbViewIONet()
  endif

  if (not defined(!!xslviewpmlinstance)) then
    !!xslviewpmlinstance = !this
    !!xslviewpmlinstance.dbviewionet[1] = object DbViewIONet()
    !this.instanceNo = 1
  endif

  !!xslviewpmlinstance.dbviewionet[!this.instanceNo].addEventHandler('Response',!!xslviewpmlinstance,'callback')

  !this.referencesAsNames = false

endmethod
-- End of method definition for DBVIEWIO()

------------------------------------------------------------------------
--
-- Method:      CALLBACK
--
-- Description: callback for DbViewIONet
--
-- Method Type:
-- Arguments: event arguments
--
-- Return: Void
--
------------------------------------------------------------------------

define method .callback(!array is ARRAY)

  do !msgIndx indices !array
    write | $!array[$!msgIndx] |
  enddo

endmethod
-- End of method definition for .callback()

------------------------------------------------------------------------
--
-- Method:      LoadXSL
--
-- Description: loads an XSL transform into memory for use by the transform methods
--
-- Method Type:
-- Arguments:
--  1 R STRING the filename of the transform to load
--
-- Return: Boolean
--
------------------------------------------------------------------------

define method .loadXSL(!filename is STRING) is BOOLEAN

  !file = object FILE(!filename)
  !fullFilename = !file.pathname() + '\' + !file.entry()
  return !!xslviewpmlinstance.dbviewionet[!this.instanceNo].LoadXSL(!fullFilename)

endmethod
-- End of method definition for .loadXSL()
------------------------------------------------------------------------
--
-- Method:      unitsOfMeasureDbFormats
--
-- Description: Outputs the units of measure given the format information for each dimension
--
-- Method Type:
-- Arguments:
--  1 T ARRAY The names of the dimension to apply formatting to
--  2 T ARRAY The units of measure to use for the associated dimension
--  3 T ARRAY The labels to apply to the associated units
-- Return:  Boolean
--
------------------------------------------------------------------------

define method .unitsOfMeasureDbFormats(!dimensions is ARRAY, !units is ARRAY, !labels is ARRAY)
	!!xslviewpmlinstance.dbviewionet[!this.instanceNo].UnitsOfMeasureDbFormats(!dimensions,!units, !labels)
endmethod
-- End of method definition for .unitsOfMeasureDbFormats()
------------------------------------------------------------------------
--
-- Method:      TransformView
--
-- Description: Transforms the named Database View using the loaded transform
--
-- Method Type:
-- Arguments:
--  1 R STRING the name of the view to transform
--  2 R STRING the filename to write the result of the transform to
-- Return:  Boolean
--
------------------------------------------------------------------------

define method .transformView(!viewName is STRING, !outputFilename is STRING) is BOOLEAN

  !file = object FILE(!outputFilename)
  !fullFilename = !file.pathname() + '\' + !file.entry()
  !!xslviewpmlinstance.dbviewionet[!this.instanceNo].ReferencesAsNames(!this.referencesAsNames)
  !!xslviewpmlinstance.dbviewionet[!this.instanceNo].ResolvableNames(!this.resolvableNames)
  !!xslviewpmlinstance.dbviewionet[!this.instanceNo].OutputDateTimeAsLocal(!this.outputDateTimeAsLocal)
  return !!xslviewpmlinstance.dbviewionet[!this.instanceNo].TransformView(!viewName, !fullFilename)

endmethod
-- End of method definition for .transformView()
------------------------------------------------------------------------
--
-- Method:      TransformView
--
-- Description: Transforms the named Database View using the loaded transform
--
-- Method Type:
-- Arguments:
--  1 R STRING the name of the view to transform
--  2 R STRING the filename to write the result of the transform to
-- Return:  Boolean
--
------------------------------------------------------------------------

define method .transformView(!viewName is STRING, !outputFilename is STRING, !argumentNames is ARRAY, !argumentValues is ARRAY) is BOOLEAN

  !file = object FILE(!outputFilename)
  !fullFilename = !file.pathname() + '\' + !file.entry()
  !!xslviewpmlinstance.dbviewionet[!this.instanceNo].ReferencesAsNames(!this.referencesAsNames)
  !!xslviewpmlinstance.dbviewionet[!this.instanceNo].ResolvableNames(!this.resolvableNames)
  !!xslviewpmlinstance.dbviewionet[!this.instanceNo].OutputDateTimeAsLocal(!this.outputDateTimeAsLocal)
  !viewNames = ARRAY()
  !viewNames[1] = viewName
  return !!xslviewpmlinstance.dbviewionet[!this.instanceNo].TransformView(!viewNames, !fullFilename,!argumentNames,!argumentValues)

endmethod
-- End of method definition for .transformView()
------------------------------------------------------------------------
--
-- Method:      TransformViews
--
-- Description: Transforms the named Database Views using the loaded transform
--
-- Method Type:
-- Arguments:
--  1 R ARRAY the names of the views to transform
--  2 R STRING the filename to write the result of the transform to
--
-- Return:  Boolean
--
------------------------------------------------------------------------

define method .transformViews(!viewNames is ARRAY, !outputFilename is STRING) is BOOLEAN

  !file = object FILE(!outputFilename)
  !fullFilename = !file.pathname() + '\' + !file.entry()
  !!xslviewpmlinstance.dbviewionet[!this.instanceNo].ReferencesAsNames(!this.referencesAsNames)
  !!xslviewpmlinstance.dbviewionet[!this.instanceNo].ResolvableNames(!this.resolvableNames)
  !!xslviewpmlinstance.dbviewionet[!this.instanceNo].OutputDateTimeAsLocal(!this.outputDateTimeAsLocal)
  return !!xslviewpmlinstance.dbviewionet[!this.instanceNo].TransformViews(!viewNames,!fullFilename)

endmethod
-- End of method definition for .transformViews()
------------------------------------------------------------------------
--
-- Method:      TransformViews
--
-- Description: Transforms the named Database Views using the loaded transform
--
-- Method Type:
-- Arguments:
--  1 R ARRAY the names of the views to transform
--  2 R STRING the filename to write the result of the transform to
--  3 R ARRAY The names of the parameters being passed into the transform
--  4 R ARRAY The values of the parameters being passed into the transform
--
-- Return:  Boolean
--
------------------------------------------------------------------------

define method .transformViews(!viewNames is ARRAY, !outputFilename is STRING, !argumentNames is ARRAY, !argumentValues is ARRAY) is BOOLEAN

  !file = object FILE(!outputFilename)
  !fullFilename = !file.pathname() + '\' + !file.entry()
  !!xslviewpmlinstance.dbviewionet[!this.instanceNo].ReferencesAsNames(!this.referencesAsNames)
  !!xslviewpmlinstance.dbviewionet[!this.instanceNo].ResolvableNames(!this.resolvableNames)
  !!xslviewpmlinstance.dbviewionet[!this.instanceNo].OutputDateTimeAsLocal(!this.outputDateTimeAsLocal)
  return !!xslviewpmlinstance.dbviewionet[!this.instanceNo].TransformViews(!viewNames,!fullFilename,!argumentNames,!argumentValues)

endmethod
-- End of method definition for .transformViews()
------------------------------------------------------------------------
--
-- Method:      IMPORTFILE
--
-- Description: Imports a specified xml file into the database
--
-- Method Type:
-- Arguments:
--  1 R STRING filename of the file to load
--
-- Return:
--  REAL 0 success, -1 error, 1 warning
--
------------------------------------------------------------------------

define method .importFile(!filename is STRING) is REAL
	
  !file = object FILE(!filename)
  !fullFilename = !file.pathname() + '\' + !file.entry()
  return !!xslviewpmlinstance.dbviewionet[!this.instanceNo].ImportFile(!fullFilename)
	
endmethod
-- End of method definition for .importFile()
------------------------------------------------------------------------
--
-- Method:      CreateXSDForView
--
-- Description: Create a schema file that defines the structure for the named view
--
-- Method Type:
-- Arguments:
--  1 R STRING the name of the database view to include in the schema
--  1 R STRING the filename for the schema to create
--
-- Return:  Boolean
--
------------------------------------------------------------------------

define method .createXSDForView(!viewName is STRING,!outputFilename is STRING) is BOOLEAN

  !file = object FILE(!outputFilename)
  !fullFilename = !file.pathname() + '\' + !file.entry()
  return !!xslviewpmlinstance.dbviewionet[!this.instanceNo].CreateXSDForView(!viewName,!fullFilename)

endmethod
-- End of method definition for .createXSDForView()
------------------------------------------------------------------------
--
-- Method:      CreateXSDForViews
--
-- Description: Create a schema file that defines the structure for the named views
--
-- Method Type:
-- Arguments:
--  1 R ARRAY the names of the database views to include in the schema
--  1 R STRING the filename for the schema to create
--
-- Return:  Boolean
--
------------------------------------------------------------------------

define method .createXSDForViews(!viewNames is ARRAY,!outputFilename is STRING) is BOOLEAN

  !file = object FILE(!outputFilename)
  !fullFilename = !file.pathname() + '\' + !file.entry()
  return !!xslviewpmlinstance.dbviewionet[!this.instanceNo].CreateXSDForViews(!viewNames,!fullFilename)

endmethod
-- End of method definition for .createXSDForViews()
