------------------------------------------------------------------------
--
-- Method:      CALLBACK
--
-- Description: callback for dbviewionet
--
-- Method Type:
-- Arguments: event arguments
--
-- Return: Void
--
------------------------------------------------------------------------

define method .callback(!array is ARRAY)

  do !msgIndx indices !array
    write | $!array[$!msgIndx] |
  enddo

endmethod
-- End of method definition for .callback()

------------------------------------------------------------------------
--
-- Method:      AddDefinitions
--
-- Description: Loads a definition set from file
--
-- Method Type:
--   1 R STRING The name of the application asking for the definition set to be loaded
--   2 R STRING The filename of the definition file to load
--   3 R BOOLEAN if true the loaded definitions are not displayed to the user
-- Arguments:
-- Return: BOOLEAN
--
------------------------------------------------------------------------

define method .addDefinitions(!applicationName is STRING, !filename is STRING, !visible is BOOLEAN) is BOOLEAN
  return !this.addDefinitions(!applicationName, '', !filename, !visible)
endmethod
-- End of method definition for .addDefinitions()

------------------------------------------------------------------------
--
-- Method:      AddDefinitions
--
-- Description: Loads a definition set from file
--
-- Method Type:
--   1 R STRING The name of the application asking for the definition set to be loaded
--   2 R STRING The name of the definition set once loaded. This overwrites the name from the loaded file if not empty
--   3 R STRING The filename of the definition file to load
--   4 R BOOLEAN if true the loaded definitions are not displayed to the user
-- Arguments:
-- Return: BOOLEAN
--
------------------------------------------------------------------------

define method .addDefinitions(!applicationName is STRING, !setName is STRING, !filename is STRING, !visible is BOOLEAN) is BOOLEAN
  USING NAMESPACE 'Aveva.Pdms.Database.View'
  !dbviewsets = object dbviewsetsnet()
  !file = object FILE(!filename)
  !fullName = !file.pathName() + '\' + !file.entry()
  return !dbviewsets.AddDefinitions(!applicationName, !setName, !fullName, !visible)
endmethod
-- End of method definition for .addDefinitions()

