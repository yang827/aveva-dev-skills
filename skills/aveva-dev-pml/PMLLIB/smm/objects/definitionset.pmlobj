import 'Aveva.Pdms.Database.View'
handle (1000,0)
endhandle
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            definitionset.pmlobj
--   Type:          Object Definition
--   Group:         Aveva.Database.View
--
--   Keyword:       Aveva.Database.View
--   Module:        All
--   Replaces:
--
-- Author:
-- Created:         Mon May 12th 2008
--
--
-- Description:
-- support for accessing Database View information using PML
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  applicationName()                STRING
--  boolean()                        STRING
--  callback(ARRAY)                  -
--  changed()                        BOOLEAN
--  dbViewSets()                     ARRAY               The names of the all of the defined database view sets
--  dbViews()                        ARRAY               The names of the all of the defined database views in the definition set
--  definitionSet(STRING)            -
--  definitionSource()               STRING
--  description()                    STRING
--  fileName()                       STRING
--  isValid()                        BOOLEAN
--  name()                           STRING
--  readOnly()                       BOOLEAN
--  save()                           STRING
--  saveAs(STRING)                   BOOLEAN
--
------------------------------------------------------------------------
define object DEFINITIONSET

  member .definitionsetnet         is ARRAY
  member .instanceNo               is REAL

endobject
-- End of object definition for DEFINITIONSET

------------------------------------------------------------------------
--
-- Method:      DEFINITIONSET
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .definitionSet(!name is STRING)

  USING NAMESPACE 'Aveva.Pdms.Database.View'

  if (defined(!!defsetinstance)) then
    !this.instanceNo = !!defsetinstance.definitionsetnet.size() + 1
    !!defsetinstance.definitionsetnet[!this.instanceNo] = object DefinitionSetNet()
  endif

  if (not defined(!!defsetinstance)) then
    !!defsetinstance = !this
    !!defsetinstance.definitionsetnet[1] = object DefinitionSetNet()
    !this.instanceNo = 1
  endif

  !!defsetinstance.definitionsetnet[!this.instanceNo].SetTo(!name)
  !!defsetinstance.definitionsetnet[!this.instanceNo].addEventHandler('Response',!!defsetinstance,'callback')

endmethod
-- End of method definition for definitionSet()

------------------------------------------------------------------------
--
-- Method:      CALLBACK
--
-- Description: callback for dbviewionet
--
-- Method Type:
-- Arguments: event arguments
--
-- Return: Void
--
------------------------------------------------------------------------

define method .callback(!array is ARRAY)

  do !msgIndx indices !array
    write | $!array[$!msgIndx] |
  enddo

endmethod
-- End of method definition for .callback()

------------------------------------------------------------------------
--
-- Method:      ApplicationName
--
-- Description: The name of the application that created the definition set
--
-- Method Type:
-- Arguments:
-- Return: STRING
--
------------------------------------------------------------------------

define method .applicationName() is STRING
  return !!defsetinstance.definitionsetnet[!this.instanceNo].ApplicationName()
endmethod
-- End of method definition for .applicationName()

------------------------------------------------------------------------
--
-- Method:      Changed
--
-- Description: Indicates whether the definitions in this set have changed since they were loaded
--
-- Method Type:
-- Arguments:
-- Return: BOOLEAN
--
------------------------------------------------------------------------

define method .changed() is BOOLEAN
  return !!defsetinstance.definitionsetnet[!this.instanceNo].Changed()
endmethod
-- End of method definition for .changed()

------------------------------------------------------------------------
--
-- Method:      dbViews
--
-- Description: The names of the all of the defined database views in the definition set
--
-- Method Type:
-- Arguments:
-- Return: ARRAY - STRING
--
------------------------------------------------------------------------

define method .dbViews() is ARRAY
  return !!defsetinstance.definitionsetnet[!this.instanceNo].DbViews()
endmethod
-- End of method definition for .dbViews()

------------------------------------------------------------------------
--
-- Method:      dbViewSets
--
-- Description: The names of the all of the defined database view sets
--
-- Method Type:
-- Arguments:
-- Return: ARRAY - STRING
--
------------------------------------------------------------------------

define method .dbViewSets() is ARRAY
  return !!defsetinstance.definitionsetnet[!this.instanceNo].DbViewSets()
endmethod
-- End of method definition for .dbViewSets()

------------------------------------------------------------------------
--
-- Method:      DefinitionSource
--
-- Description: Identifies the type of source for the definitions
--
-- Method Type:
-- Arguments:
-- Return: STRING
--
------------------------------------------------------------------------

define method .definitionSource() is STRING
  return !!defsetinstance.definitionsetnet[!this.instanceNo].DefinitionSource()
endmethod
-- End of method definition for .definitionSource()

------------------------------------------------------------------------
--
-- Method:      Description
--
-- Description: The description of the definition set
--
-- Method Type:
-- Arguments:
-- Return: STRING
--
------------------------------------------------------------------------

define method .description() is STRING
  return !!defsetinstance.definitionsetnet[!this.instanceNo].Description()
endmethod
-- End of method definition for .description()

------------------------------------------------------------------------
--
-- Method:      FileName
--
-- Description: The file the definitions have been loaded from, if any
--
-- Method Type:
-- Arguments:
-- Return: STRING
--
------------------------------------------------------------------------

define method .fileName() is STRING
  return !!defsetinstance.definitionsetnet[!this.instanceNo].FileName()
endmethod
-- End of method definition for .fileName()

------------------------------------------------------------------------
--
-- Method:      IsValid
--
-- Description: Indicates the definition set is useable
--
-- Method Type:
-- Arguments:
-- Return: BOOLEAN
--
------------------------------------------------------------------------

define method .isValid() is BOOLEAN
  return !!defsetinstance.definitionsetnet[!this.instanceNo].IsValid()
endmethod
-- End of method definition for .isValid()

------------------------------------------------------------------------
--
-- Method:      Name
--
-- Description: The name of the definition set
--
-- Method Type:
-- Arguments:
-- Return: STRING
--
------------------------------------------------------------------------

define method .name() is STRING
  return !!defsetinstance.definitionsetnet[!this.instanceNo].Name()
endmethod
-- End of method definition for .name()

------------------------------------------------------------------------
--
-- Method:      Readonly
--
-- Description: The description of the definition set
--
-- Method Type:
-- Arguments:
-- Return: BOOLEAN
--
------------------------------------------------------------------------

define method .readOnly() is BOOLEAN
  return !!defsetinstance.definitionsetnet[!this.instanceNo].ReadOnly()
endmethod
-- End of method definition for .readOnly()

------------------------------------------------------------------------
--
-- Method:      Save
--
-- Description: Saves, if allowed, the definitions in this definition set
--
-- Method Type:
-- Arguments:
-- Return: BOOLEAN
--
------------------------------------------------------------------------

define method .save() is STRING
  return !!defsetinstance.definitionsetnet[!this.instanceNo].Save()
endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      SaveAs
--
-- Description: Saves this set of definitions to a file
--
-- Method Type:
-- Arguments:
--   1 R STRING the filename of the file to create/overwrite
-- Return: BOOLEAN
--
------------------------------------------------------------------------

define method .saveAs(!filename is STRING) is BOOLEAN
  !file = object FILE(!filename)
  !fullFilename = !file.pathname() + '\' + !file.entry()
  return !!defsetinstance.definitionsetnet[!this.instanceNo].SaveAs(!fullFilename)
endmethod
-- End of method definition for .saveAs()

------------------------------------------------------------------------
--
-- Method:      Visible
--
-- Description: Inidicates that definitions within this definition set are visible to the user
--
-- Method Type:
-- Arguments:
-- Return: BOOLEAN
--
------------------------------------------------------------------------

define method .boolean() is STRING
  return !!defsetinstance.definitionsetnet[!this.instanceNo].Visible()
endmethod
-- End of method definition for .visible()
