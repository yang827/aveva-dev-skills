--    Type:          Object Definition
--    Group:         Undefined
--      Keyword:     Undefined
--    Module:        Undefined
import 'Aveva.Pdms.SchematicModelManager.Pml'
handle (1000,0)
endhandle
------------------------------------------------------------------------
--
-- Copyright 1974 to current year. AVEVA Solutions Limited and its subsidiaries. All rights reserved in original code only.
--
-- File:            smm.pmlobj
-- Author:
-- Created:         Thurs June 19th 2008
--
--
-- Description:
--
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  attributeMappingFile()           STRING
--  callback(ARRAY)                  -
--  importFile(STRING)               REAL
--  importFile(STRING,STRING)        REAL
--  importFilesInDir(STRING)         REAL
--  importFilesInDir(STRING,STRING)  REAL
--  importFromFileSet(STRING)        REAL
--  logFile()                        STRING
--  projectFile()                    STRING
--  smm()                            -
--
------------------------------------------------------------------------
define object SMM

	member .dbtransform          is ARRAY
	member .instanceNo           is REAL

endobject
-- End of object definition for SMM

------------------------------------------------------------------------
--
-- Method:      SMM
--
-- Description:
--   Constructor
--
------------------------------------------------------------------------
define method .smm()

  USING NAMESPACE 'Aveva.Pdms.SchematicModelManager.PML'

  if (defined(!!smminstance)) then
    !this.instanceNo = !!smminstance.dbtransform.size() + 1
    !!smminstance.dbtransform[!this.instanceNo] = object SCHEMATICMODELMANAGERNET()
  endif

  if (not defined(!!smminstance)) then
    !!smminstance = !this
    !!smminstance.dbtransform[1] = object SCHEMATICMODELMANAGERNET()
    !this.instanceNo = 1
  endif

  !!smminstance.dbtransform[!this.instanceNo].addEventHandler('ImportStatus',!!smminstance,'callback')

endmethod
-- End of method definition for SMM()

------------------------------------------------------------------------
--
-- Method:      CALLBACK
--
-- Description: callback for SMM object
--
-- Method Type:
-- Arguments: event arguments
--
-- Return: Void
--
------------------------------------------------------------------------
define method .callback(!message is ARRAY)

 do !msgIndx indices !message
   write | $!message[$!msgIndx] |
 enddo

endmethod
-- End of method definition for .callback()
------------------------------------------------------------------------
--
-- Method:      IMPORTFILE
--
-- Description: Imports a specified xml file into the database
--        with release comments
-- Method Type:
-- Arguments:
--  1 R STRING filename of the file to load
--  2 R STRING releaseComments for this file
-- Return:
--  REAL 0 success, -1 error, 1 warning
--
------------------------------------------------------------------------
define method .importFile(!filename is STRING, !releaseComments is STRING) is REAL

    return !!smminstance.dbtransform[!this.instanceNo].ImportFile(!filename, !releaseComments)

endmethod
-- End of method definition for .importFile()
------------------------------------------------------------------------
--
-- Method:      IMPORTFILE
--
-- Description: Imports a specified xml file into the database
--
-- Method Type:
-- Arguments:
--  1 R STRING filename of the file to load
--
-- Return:
--  REAL 0 success, -1 error, 1 warning
--
------------------------------------------------------------------------
define method .importFile(!filename is STRING) is REAL
	
	return !!smminstance.dbtransform[!this.instanceNo].ImportFile(!filename, '')
	
endmethod
-- End of method definition for .importFile()
------------------------------------------------------------------------
--
-- Method:      IMPORTFILESINDIR
--
-- Description: Attempts to import all *.xml files in a specified directory
--        with release comments
-- Method Type:
-- Arguments:
--  1 R STRING directory of the files to load
--  2 R STRING release comments for the files in the directory
-- Return:
--  REAL 0 success, -1 error, 1 warning
--
------------------------------------------------------------------------
define method .importFilesInDir(!directory is STRING, !releaseComments is STRING) is REAL

	return !!smminstance.dbtransform[!this.instanceNo].ImportFilesInDir(!directory, !releaseComments)
 		
endmethod
-- End of method definition for .importFilesInDir()
------------------------------------------------------------------------
--
-- Method:      IMPORTFILESINDIR
--
-- Description: Attempts to import all *.xml files in a specified directory
--
-- Method Type:
-- Arguments:
--  1 R STRING directory of the files to load
--
-- Return:
--  REAL 0 success, -1 error, 1 warning
--
------------------------------------------------------------------------
define method .importFilesInDir(!directory is STRING) is REAL

	return !!smminstance.dbtransform[!this.instanceNo].ImportFilesInDir(!directory, '')
	
endmethod
-- End of method definition for .importFilesInDir()
------------------------------------------------------------------------
--
-- Method:      IMPORTFROMFILESET
--
-- Description: imports all files listed in the given import file set.
--
-- Method Type:
-- Arguments:
--  1 R STRING The filename of the file set
--
-- Return:
--  REAL 0 success, -1 error, 1 warning
--
------------------------------------------------------------------------
define method .importFromFileSet(!filename is STRING) is REAL
	
	return !!smminstance.dbtransform[!this.instanceNo].ImportFromFileSet(!filename)
 	 	 	
endmethod
-- End of method definition for .importFromFileSet()
------------------------------------------------------------------------
--
-- Method:      LOGFILE
--
-- Description: provides the fully qualified filename of the import log file.
--
-- Method Type:
-- Arguments:
--  NONE
--
-- Return:
--  STRING the full filename of the log file including the file path.
--
------------------------------------------------------------------------
define method .logFile() is STRING
	
	return !!smminstance.dbtransform[!this.instanceNo].LogFile()

endmethod
-- End of method definition for .logFile()
------------------------------------------------------------------------
--
-- Method:      PROJECTFILE
--
-- Description: provides the fully qualified filename of the project options file.
--
-- Method Type:
-- Arguments:
--  NONE
--
-- Return:
--  STRING the full filename of the project options file including the file path.
--
------------------------------------------------------------------------
define method .projectFile() is STRING
	
	return !!smminstance.dbtransform[!this.instanceNo].ProjectFile()

endmethod
-- End of method definition for .projectFile()
------------------------------------------------------------------------
--
-- Method:      ATTRIBUTEMAPPINGFILE
--
-- Description: provides the fully qualified filename of the attribute Mapping file.
--
-- Method Type:
-- Arguments:
--  NONE
--
-- Return:
--  STRING the full filename of the attribute Mapping file including the file path.
--
------------------------------------------------------------------------
define method .attributeMappingFile() is STRING
	
	return !!smminstance.dbtransform[!this.instanceNo].AttributeMappingFile()

