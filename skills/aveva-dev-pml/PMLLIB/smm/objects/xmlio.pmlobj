------------------------------------------------------------------------
--
-- Method:      IMPORTFILE
--
-- Description: Imports a specified xml file into the database
--
-- Method Type:
-- Arguments:
--  1 R STRING filename of the file to load
--
-- Return:
--  REAL 0 success, -1 error, 1 warning
--
------------------------------------------------------------------------
define method .importFile(!filename is STRING) is REAL
	
    !file = object FILE(!filename)
    !fullFilename = !file.pathname() + '\' + !file.entry()
    return !!xslpmlinstance.xmlionet[!this.instanceNo].ImportFile(!fullFilename)
	
endmethod
-- End of method definition for .importFile()
------------------------------------------------------------------------
--
-- Method:      IMPORTWITHACCEPTREJECT
--
-- Description: If a file is imported using this method in graphics mode then
--              the accept reject interface is opened during the import.
--
-- Method Type:
-- Arguments:
--  1 R STRING filename of the file to register
--
-- Return:
--  true if registered, false if there was a error in the file path provided
--
------------------------------------------------------------------------
define method .importWithAcceptReject(!filename is STRING) is REAL
	
  USING NAMESPACE 'Aveva.Pdms.AcceptReject'

  !file = object FILE(!filename)
  !fullFilename = !file.pathname() + '\' + !file.entry()
	
  !result = 0

  !arnet = object ARXmlNet()
  !ok = !arnet.Register(!fullFilename)
  if (not !ok) then
    write | Unable to register '$!fullFilename' |
    !result = -1
  else
    !result = !!xslpmlinstance.xmlionet[!this.instanceNo].ImportFile(!fullFilename)
  endif

  return !result

endmethod
-- End of method definition for .importWithAcceptReject()
