--
-- File:            xmlio.pmlobj
--   Type:          Object Definition
--   Group:         Aveva.Database.Xml
--
--   Keyword:       Aveva.Database.Xml
--   Module:        All
--   Replaces:
--
-- Author:
-- Created:         Mon May 12th 2008
--
--
-- Description:
-- XML input and output support for Db structures
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  callback(ARRAY)                  -
--  chooseSingleFile(STRING)         STRING
--  createXSDForCE(STRING)           BOOLEAN
--  createXSDForDB(STRING)           BOOLEAN
--  createXSDForDataSet(STRING,ARRAY) BOOLEAN
--  createXSDForMDB(STRING)          BOOLEAN
--  importFile(STRING)               REAL
--  importWithAcceptReject(STRING)   REAL
--  loadXSL(STRING)                  BOOLEAN
--  open(STRING)                     -                   Opens a file in a separate application using standard applications
--  showLimitedPseudoAttributes(ARRAY,ARRAY) -
--  transformCE(STRING)              BOOLEAN
--  transformCE(STRING,ARRAY,ARRAY)  BOOLEAN
--  transformFile(STRING,STRING)     BOOLEAN
--  transformFile(STRING,STRING,ARRAY,ARRAY) BOOLEAN
--  transformMDB(STRING)             BOOLEAN
--  transformMDB(STRING,ARRAY,ARRAY) BOOLEAN
--  unitsOfMeasureDbFormats(ARRAY,ARRAY,ARRAY) -                   Outputs the units of measure given the format information for each dimension
--  xmlio()                          -
--
------------------------------------------------------------------------
define object XMLIO

  member .xmlionet                 is ARRAY
  member .instanceNo               is REAL
  member .showPseudoAttributes     is BOOLEAN
  member .showDisplayAttributes    is BOOLEAN
  member .showDistributedAttributes is BOOLEAN
  member .expandSecondaryHierarchy is BOOLEAN
  member .referencesAsNames        is BOOLEAN
  member .resolvableNames          is BOOLEAN
  member .outputDateTimeAsLocal    is BOOLEAN

endobject
-- End of object definition for XMLIO

------------------------------------------------------------------------
--
-- Method:      XMLIO
--
-- Description:
--   Constructor
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .xmlio()

  USING NAMESPACE 'Aveva.Pdms.Database.Xml'

  if (defined(!!xslpmlinstance)) then
    !this.instanceNo = !!xslpmlinstance.xmlionet.size() + 1
    !!xslpmlinstance.xmlionet[!this.instanceNo] = object XmlIONet()
  endif

  if (not defined(!!xslpmlinstance)) then
    !!xslpmlinstance = !this
    !!xslpmlinstance.xmlionet[1] = object XmlIONet()
    !this.instanceNo = 1
  endif

  !!xslpmlinstance.xmlionet[!this.instanceNo].addEventHandler('Response',!!xslpmlinstance,'callback')

  !this.showPseudoAttributes = false
  !this.showDisplayAttributes = false
  !this.showDistributedAttributes = false
  !this.expandSecondaryHierarchy = false
  !this.referencesAsNames = false
  !this.outputDateTimeAsLocal = false

endmethod
-- End of method definition for XMLIO()

------------------------------------------------------------------------
--
-- Method:      CALLBACK
--
-- Description: callback for XmlIONet
--
-- Method Type:
-- Arguments: event arguments
--
-- Return: Void
--
------------------------------------------------------------------------

define method .callback(!array is ARRAY)

  do !msgIndx indices !array
    write | $!array[$!msgIndx] |
  enddo

endmethod
-- End of method definition for .callback()

------------------------------------------------------------------------
--
-- Method:      LoadXSL
--
-- Description: loads an XSL transform into memory for use by the transform methods
--
-- Method Type:
-- Arguments:
--  1 R STRING the filename of the transform to load
--
-- Return: Boolean
--
------------------------------------------------------------------------

define method .loadXSL(!filename is STRING) is BOOLEAN

  !file = object FILE(!filename)
  !fullFilename = !file.pathname() + '\' + !file.entry()
  return !!xslpmlinstance.xmlionet[!this.instanceNo].LoadXSL(!fullFilename)

endmethod
-- End of method definition for .loadXSL()
------------------------------------------------------------------------
--
-- Method:      ChooseSingleFile
--
-- Description: Opens the file dialog with the filter provided in
--              single select mode.  Returns the single filename or an empty string
--
-- Method Type:
-- Arguments:
--  1 R STRING the filename to write the result of the transform to
--
-- Return: String - the file chosen or an empty string if cancelled
--
------------------------------------------------------------------------

define method .chooseSingleFile( !filter is STRING ) is STRING

  return !!xslpmlinstance.xmlionet[!this.instanceNo].ChooseSingleFile( !filter )

endmethod
-- End of method definition for .chooseSingleFile()
------------------------------------------------------------------------
--
-- Method:      open
--
-- Description: Opens a file in a separate application using standards
--               windows open behaviour
--
-- Method Type:
-- Arguments:
--  1 R The file to open
--
-- Return: Void
--
------------------------------------------------------------------------

define method .open(!filename is STRING)

  !file = object FILE(!filename)
  !fullFilename = !file.pathname() + '\' + !file.entry()
  !!xslpmlinstance.xmlionet[!this.instanceNo].open(!fullFilename)

endmethod
-- End of method definition for .open()

------------------------------------------------------------------------
--
-- Method:      ShowLimitedPseudoAttributes
--
-- Description: Outputs the Pseudo attributes for each element type specified
--
-- Method Type:
-- Arguments:
--  1 T ARRAY The element types to output pseudo attributes on
--  2 T ARRAY The attributes to output, each array element should be a list of attributes for the associated element type
-- Return:  Boolean
--
------------------------------------------------------------------------

define method .showLimitedPseudoAttributes(!elementTypes is ARRAY, !attributes is ARRAY)
	!!xslpmlinstance.xmlionet[!this.instanceNo].ShowLimitedPseudoAttributes(!elementTypes,!attributes)
	!this.showPseudoAttributes = !!xslpmlinstance.xmlionet[!this.instanceNo].ShowPseudoAttributes()
endmethod
-- End of method definition for .showLimitedPseudoAttributes()
------------------------------------------------------------------------
--
-- Method:      unitsOfMeasureDbFormats
--
-- Description: Outputs the units of measure given the format information for each dimension
--
-- Method Type:
-- Arguments:
--  1 T ARRAY The names of the dimension to apply formatting to
--  2 T ARRAY The units of measure to use for the associated dimension
--  3 T ARRAY The labels to apply to the associated units
-- Return:  Boolean
--
------------------------------------------------------------------------

define method .unitsOfMeasureDbFormats(!dimensions is ARRAY, !units is ARRAY, !labels is ARRAY)
	!!xslpmlinstance.xmlionet[!this.instanceNo].UnitsOfMeasureDbFormats(!dimensions,!units, !labels)
endmethod
-- End of method definition for .unitsOfMeasureDbFormats()
------------------------------------------------------------------------
--
-- Method:      TransformCE
--
-- Description: Transforms the current element using the loaded transform
--
-- Method Type:
-- Arguments:
--  1 R STRING the filename to write the result of the transform to
-- Return:  Boolean
--
------------------------------------------------------------------------

define method .transformCE(!outputFilename is STRING) is BOOLEAN

  !file = object FILE(!outputFilename)
  !fullFilename = !file.pathname() + '\' + !file.entry()
  !!xslpmlinstance.xmlionet[!this.instanceNo].ShowPseudoAttributes(!this.showPseudoAttributes)
  !!xslpmlinstance.xmlionet[!this.instanceNo].ShowDisplayAttributes(!this.showDisplayAttributes)
  !!xslpmlinstance.xmlionet[!this.instanceNo].ShowDistributedAttributes(!this.showDistributedAttributes)
  !!xslpmlinstance.xmlionet[!this.instanceNo].ExpandSecondaryHierarchy(!this.expandSecondaryHierarchy)
  !!xslpmlinstance.xmlionet[!this.instanceNo].ReferencesAsNames(!this.referencesAsNames)
  !!xslpmlinstance.xmlionet[!this.instanceNo].ResolvableNames(!this.resolvableNames)
  !!xslpmlinstance.xmlionet[!this.instanceNo].OutputDateTimeAsLocal(!this.outputDateTimeAsLocal)
  return !!xslpmlinstance.xmlionet[!this.instanceNo].transformCE(!fullFilename)

endmethod
-- End of method definition for .transformCE()
