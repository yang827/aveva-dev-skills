------------------------------------------------------------------------
--
-- Method:      TransformFile
--
-- Description: Transforms a file using the loaded style sheet
--
-- Method Type:
-- Arguments:
--  1 R STRING the filename of the file to transform
--  2 R STRING the filename to write the result of the transform to
-- Return:  Boolean
--
------------------------------------------------------------------------

define method .transformFile(!inputFilename is STRING, !outputFilename is STRING) is BOOLEAN

  !file = object FILE(!inputFilename)
  !input = !file.pathname() + '\' + !file.entry()
  !file = object FILE(!outputFilename)
  !output = !file.pathname() + '\' + !file.entry()
  return !!xslpmlinstance.xmlionet[!this.instanceNo].transformFile(!input, !output)

endmethod
-- End of method definition for .transformFile()
