-- Created:         Mon Mar 23 13:46:42 GMT 1998
--
--
-- Description:
-- Drawlist add within volume
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   apply action
--  checkCoord()                     -                   action on entering E/W N/S U/D option
--  checkCoord(GADGET)               -                   action on entering coordinate
--  checkEmpty(GADGET)               -                   check for null coord
--  checkVol()                       REAL                validates the volume against the minimum size restrictions
--  clearBox()                       -                   clear aid box
--  contract()                       -                   contract volume displayed
--  dismiss()                        -                   dismiss action
--  display()                        -                   display volume coords
--  drawBox()                        -                   draw aid box
--  expand()                         -                   expand volume displayed
--  getView()                        -                   get graphical view gadget
--  init()                           -                   initialisation
--  setViewLimits()                  -                   set graphical view limits
--  setVol()                         -                   set volume object
--  splAddWithin()                   -                   constructor
--  volumeCe()                       -                   get volume of current element
--  volumePick()                     -                   get volume from 3D picks
--
------------------------------------------------------------------------

setup form !!splAddWithin

  !!splAddWithin.formTitle     = 'Add Within Volume'
  !!splAddWithin.iconTitle     = 'Volume'
  !!splAddWithin.callback      = '!!splAddWithin.init()'
  !!splAddWithin.formRevision  = ' $Revision: 1.11 $ '

  -- Body of form definition

  -- calculated volume
  member .volume is VOLUME

  -- minimum acceptable volume size
  member .minVolSize is REAL

  -- aid number for volume box
  member .aidNumber is REAL

  -- Which graphical display form
  member .view is GADGET

  member .fromPosLink is POSITIONLINK

  member .toPosLink    is POSITIONLINK

  bar
    add 'Volume' .volumeMenu
  exit

  frame .from 'From' at xmin ymax+0.2
    option .fromEW at xmin+1 ymax width 5
    text .fromX at xmax+1 ymin width 14 is REAL format !!distanceFmt
    option .fromNS at xmin.fromEW ymax+0.1 width 5
    text .fromY at xmax+1 ymin width 14 is REAL format !!distanceFmt
    option .fromUD at xmin.fromEW ymax+0.1 width 5
    text .fromZ at xmax+1 ymin width 14 is REAL format !!distanceFmt
  exit

  frame .to 'To' at xmin.from ymax+0.2
    option .toEW at xmin+1 ymax width 5
    text .toX at xmax+1 ymin width 14 is REAL format !!distanceFmt
    option .toNS at xmin.toEW ymax+0.1 width 5
    text .toY at xmax+1 ymin width 14 is REAL format !!distanceFmt
    option .toUD at xmin.toEW ymax+0.1 width 5
    text .toZ at xmax+1 ymin width 14 is REAL format !!distanceFmt
  exit

  button .apply ' Apply ' at xmin.from ymax+0.5
  button .dismiss 'Dismiss' at xmax form-size ymin cancel

exit
-- End of form definition for !!splAddWithin

------------------------------------------------------------------------
--
-- Method:      !splAddWithin()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .splAddWithin()

  -- define menus
  !this.newMenu('volumeMenu')
  !this.volumeMenu.add('callback', 'CE', '!!splAddWithin.volumeCe()')
  !this.volumeMenu.add('callback', 'Expand', '!!splAddWithin.expand()')
  !this.volumeMenu.add('callback', 'Contract', '!!splAddWithin.contract()')
  !this.volumeMenu.add('callback', '3D Picks', '!!splAddWithin.volumePick()')

  var !coords coordinate

   !this.fromPosLink.linkOption('!!splAddWithin.fromPosLink',!this.fromEW,!this.fromNS,!this.fromUD, !coords )
   !this.fromPosLink.linkInput('!!splAddWithin.fromPosLink',!this.fromX,!this.fromY,!this.fromZ)

   !this.toPosLink.linkOption('!!splAddWithin.toPosLink',!this.toEW,!this.toNS,!this.toUD, !coords )
   !this.toPosLink.linkInput('!!splAddWithin.toPosLink',!this.toX,!this.toY,!this.toZ)

  -- set callbacks
  !this.fromEW.callback = '!!splAddWithin.checkCoord()'
  !this.fromNS.callback = '!!splAddWithin.checkCoord()'
  !this.fromUD.callback = '!!splAddWithin.checkCoord()'
  !this.toEW.callback = '!!splAddWithin.checkCoord()'
  !this.toNS.callback = '!!splAddWithin.checkCoord()'
  !this.toUD.callback = '!!splAddWithin.checkCoord()'
  !this.fromX.callback = '!!splAddWithin.checkCoord(!!splAddWithin.fromX)'
  !this.fromY.callback = '!!splAddWithin.checkCoord(!!splAddWithin.fromY)'
  !this.fromZ.callback = '!!splAddWithin.checkCoord(!!splAddWithin.fromZ)'
  !this.toX.callback = '!!splAddWithin.checkCoord(!!splAddWithin.toX)'
  !this.toY.callback = '!!splAddWithin.checkCoord(!!splAddWithin.toY)'
  !this.toZ.callback = '!!splAddWithin.checkCoord(!!splAddWithin.toZ)'
  !this.apply.callback = '!!splAddWithin.apply()'
  !this.cancelCall = '!!splAddWithin.dismiss()'

  -- allocate an aid text number
  !this.aidNumber = !!aidNumbers.add(STRING())

  -- define the minimum volume size - can be updated to suit the customer's needs
  !this.minVolSize = 99.9

endmethod
-- End of method definition for .splAddWithin()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .init()

  -- default to zeros
  !this.checkEmpty(!this.fromX)
  !this.checkEmpty(!this.fromY)
  !this.checkEmpty(!this.fromZ)
  !this.checkEmpty(!this.toX)
  !this.checkEmpty(!this.toY)
  !this.checkEmpty(!this.toZ)

  var !coords coordinate

   !this.fromPosLink.linkOption('!!splAddWithin.fromPosLink',!this.fromEW,!this.fromNS,!this.fromUD, !coords )
   !this.toPosLink.linkOption('!!splAddWithin.toPosLink',!this.toEW,!this.toNS,!this.toUD, !coords )

  !this.setVol()
  -- Get graphical view gadget
  !this.getView()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !volumeCe()
--
-- Description: get volume of current element
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .volumeCe()

  !this.volume = !!volume(!!ce)
  !this.display()

endmethod
-- End of method definition for .volumeCe()

------------------------------------------------------------------------
--
-- Method:      !expand()
--
-- Description: expand volume displayed
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .expand()

  !this.volume.from.east  = !this.volume.from.east  - 1000mm
  !this.volume.from.north = !this.volume.from.north - 1000mm
  !this.volume.from.up    = !this.volume.from.up    - 1000mm
  !this.volume.to.east    = !this.volume.to.east    + 1000mm
  !this.volume.to.north   = !this.volume.to.north   + 1000mm
  !this.volume.to.up      = !this.volume.to.up      + 1000mm

  !this.display()

endmethod
-- End of method definition for .expand()

------------------------------------------------------------------------
--
-- Method:      !contract()
--
-- Description: contract volume displayed
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .contract()

  if ((!this.volume.to.east - !this.volume.from.east) gt 3000mm) then
    !this.volume.from.east  = !this.volume.from.east  + 1000mm
    !this.volume.to.east    = !this.volume.to.east    - 1000mm
  endif
  if ((!this.volume.to.north - !this.volume.from.north) gt 3000mm) then
    !this.volume.from.north = !this.volume.from.north + 1000mm
    !this.volume.to.north   = !this.volume.to.north   - 1000mm
   endif
   if ((!this.volume.to.up - !this.volume.from.up) gt 3000mm) then
    !this.volume.from.up    = !this.volume.from.up    + 1000mm
    !this.volume.to.up      = !this.volume.to.up      - 1000mm
  endif
  !this.display()

endmethod
-- End of method definition for .contract()

------------------------------------------------------------------------
--
-- Method:      !volumePick()
--
-- Description: get volume from 3D picks
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .volumePick()

  -- get two 3D picks
  do !i to 2

    PIN9 AT @

    -- View direction not orthogonal
    handle (61,565)
      PIN9 OFF
      return error 1 |View direction must be orthogonal for 3D pick. Reset view direction and try again.|
    -- user exit from submode
    elsehandle (61,528)
      PIN9 OFF
      return
    endhandle

    -- get picked position
    var !pickedPos[!i] PIN9 POSITION IN WORLD
    PIN9 OFF

  enddo

  -- ensure volume coords are low to high
  !this.volume.from = !pickedPos[1].position()
  !this.volume.to = !pickedPos[2].position()
  if (!this.volume.from.east gt !this.volume.to.east) then
    !from = !this.volume.from.east
    !this.volume.from.east = !this.volume.to.east
    !this.volume.to.east = !from
  endif
  if (!this.volume.from.north gt !this.volume.to.north) then
    !from = !this.volume.from.north
    !this.volume.from.north = !this.volume.to.north
    !this.volume.to.north = !from
  endif
  if (!this.volume.from.up gt !this.volume.to.up) then
    !from = !this.volume.from.up
    !this.volume.from.up = !this.volume.to.up
    !this.volume.to.up = !from
  endif

  !this.display()

endmethod
-- End of method definition for .volumePick()

------------------------------------------------------------------------
--
-- Method:      !display()
--
-- Description: display volume coords
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .display()

  !this.fromPosLink.setPosition(!this.volume.from)
  !this.toPosLink.setPosition(!this.volume.to)

  -- display aid box
  !this.drawBox()

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      !drawBox()
--
-- Description: draw aid box
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .drawBox()

  -- clear aid box
  !this.clearBox()

  -- calculate box parameters
  if (!this.volume.from.eq(!this.volume.to)) then
    !midPoint = !this.volume.from
    !xLen = 0.0
    !yLen = 0.0
    !zLen = 0.0
  else
    !line = object LINE()
    !line.startPosition = !this.volume.from
    !line.endPosition = !this.volume.to
    !midPoint = !line.proportion(0.5)

    !xLen = ABS(!this.volume.to.east  - !this.volume.from.east)
    !yLen = ABS(!this.volume.to.north - !this.volume.from.north)
    !zLen = ABS(!this.volume.to.up    - !this.volume.from.up)
  endif

  -- draw box
  AID BOX NUMBER $!<this.aidNumber> AT $!midPoint $
          ORI Y IS N AND Z IS U XLEN $!xLen YLEN $!yLen ZLEN $!zLen FILL OFF

endmethod
-- End of method definition for .drawBox()

------------------------------------------------------------------------
--
-- Method:      !clearBox()
--
-- Description: clear aid box
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .clearBox()

  -- clear old box
  AID CLEAR BOX $!<this.aidNumber>

  -- ignore error if box not already displayed
  handle any
  endhandle

endmethod
-- End of method definition for .clearBox()

------------------------------------------------------------------------
--
-- Method:      !checkEmpty()
--
-- Description: check for null coord
--
-- Method Type: Procedure
-- Arguments:
--  [1] [R] [GADGET] [Text gadget to check]
--
------------------------------------------------------------------------

define method .checkEmpty(!gadget is GADGET)

  -- zeroise if null
  if (!gadget.val.string().trim() eq '') then
    !gadget.val = 0
  endif

endmethod
-- End of method definition for .checkEmpty(GADGET)

------------------------------------------------------------------------
--
-- Method:      !checkCoord()
--
-- Description: action on entering coordinate
--
-- Method Type: Procedure
-- Arguments:
--  [1] [R] [GADGET] [Text gadget to check]
--
------------------------------------------------------------------------

define method .checkCoord(!gadget is GADGET)

  -- zeroise if null
  !this.checkEmpty(!gadget)

  -- Set the volume object
  !this.setVol()

  -- Set the graphical view limits, so can view the whole of the aid box
  !this.setViewLimits()

  -- display aid box
  !this.drawBox()

endmethod
-- End of method definition for .checkCoord(GADGET)

------------------------------------------------------------------------
--
-- Method:      !checkCoord()
--
-- Description: action on entering E/W N/S U/D option
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .checkCoord()

  -- display aid box
  !this.drawBox()

endmethod
-- End of method definition for .checkCoord()

------------------------------------------------------------------------
--
-- Method:      !apply()
--
-- Description: apply action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .apply()
  !cv = !this.checkVol()
  if (!cv.eq(0)) then
    -- add within volume
    ADD ALL WITHIN $!<this.volume.from> TO $!<this.volume.to>

    -- update drawlist
    !!splDrawlist.display()
  elseif (!cv.eq(2)) then
    !res = !!alert.confirm('The defined volume is too small! Do you want to enlarge it?')
    !ms = !this.minVolSize + 0.1
    if (!res.eq('YES')) then
      !this.volume.to.east = !this.volume.from.east + !ms
      !this.volume.to.north = !this.volume.from.north + !ms
      !this.volume.to.up = !this.volume.from.up + !ms
      !this.display()
      !this.setViewLimits()
      !this.drawBox()
      Write 'The limits have been changed. Click Apply again, if you accept them ...'
    endif
  endif
endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      !checkVol()
--
-- Description: Verifies, that the volume meets the minimum size restrictions
--
-- Method Type: Function
--
------------------------------------------------------------------------

define method .checkVol() is REAL
  !p = !this.volume.from
  !q = !this.volume.to
  if (unset(!p) or unset(!q)) then
    !res = 1 $* positions not set
  else
    !res = 2 $* volume too small
    !mvs = !this.minVolSize
    if (ABS(!p.east - !q.east) gt !mvs) then
      if (ABS(!p.north - !q.north) gt !mvs) then
        if (ABS(!p.up - !q.up) gt !mvs) then
          !res = 0 $* volume OK
        endif
      endif
    endif
  endif
  return !res
endmethod
-- End of method definition for .checkVol()

------------------------------------------------------------------------
--
-- Method:      !dismiss()
--
-- Description: dismiss action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .dismiss()

  -- clear aid box
  !this.clearBox()

endmethod
-- End of method definition for .dismiss()

------------------------------------------------------------------------
--
-- Method:      .setVol()
--
-- Description: set volume object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .setVol()

  !fromEastWest   = !this.fromEW.selection('DTEXT') & !this.fromX.val
  !fromNorthSouth = !this.fromNS.selection('DTEXT') & !this.fromY.val
  !fromUpDown     = !this.fromUD.selection('DTEXT') & !this.fromZ.val
  !toEastWest     = !this.toEW.selection('DTEXT') & !this.toX.val
  !toNorthSouth   = !this.toNS.selection('DTEXT') & !this.toY.val
  !toUpDown       = !this.toUD.selection('DTEXT') & !this.toZ.val

  !this.volume.from = object POSITION(!fromEastWest & ' ' & !fromNorthSouth & ' ' & !fromUpDown)
  !this.volume.to   = object POSITION(!toEastWest & ' ' & !toNorthSouth & ' ' & !toUpDown)

endmethod
-- End of method definition for .setVol()

--------------------------------------------------------------------
--
-- Method:      .getView()
--
-- Description: get graphical view gadget
--
-- Method Type: Procedure
--
--------------------------------------------------------------------
define method .getView()

  -- Get first defined design view
  do !number from 1

    -- Look for defined form
    if (defined(!!gph3DDesign$!<number>)) then
      !this.view = !!gph3DDesign$!<number>.view
      break
    endif

  enddo

endmethod
-- End of method definition for .getView()

--------------------------------------------------------------------
--
-- Method:      .setViewLimits()
--
-- Description: set graphical view limits
--
-- Method Type: Procedure
--
--------------------------------------------------------------------
define method .setViewLimits()

  !limitsArray[1] = !this.volume.from.east
  !limitsArray[2] = !this.volume.to.east
  !limitsArray[3] = !this.volume.from.north
  !limitsArray[4] = !this.volume.to.north
  !limitsArray[5] = !this.volume.from.up
  !limitsArray[6] = !this.volume.to.up

  !this.view.limits = !limitsArray

endmethod
-- End of method definition for .setViewLimits()
