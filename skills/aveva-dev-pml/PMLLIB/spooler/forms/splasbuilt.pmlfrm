--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Wed Feb 18 13:18:53 GMT 1998
--
--
-- Description:
-- Modify data as built for all numbering
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dismiss()                        -                   Dismiss method
--  display(DBREF)                   -                   Update attribute display following modification
--  init()                           -                   Form initialisation on show action
--  listData(DBREF)                  -                   Display attribute data for element
--  listMembers()                    -                   Display the elements to modify
--  modifyAtts()                     -                   modify spldrg member attributes
--  setAttribute(DBREF,STRING,BOOLEAN) -                   boolean attribute setting from user input
--  setAttribute(DBREF,STRING,REAL)  -                   real attribute setting from user input
--  setAttribute(DBREF,STRING,STRING) -                   string attribute setting from user input
--  splAsBuilt()                     -                   Constructor method for form object
--  track(FORM,STRING)               -                   Database tracking method
--  validate(DBREF,STRING,BOOLEAN)   BOOLEAN             validate boolean attribute from user input
--  validate(DBREF,STRING,REAL)      BOOLEAN             validate real attribute from user input
--  validate(DBREF,STRING,STRING)    BOOLEAN             validate string attribute from user input
--
------------------------------------------------------------------------

-- Define form
setup form !!splAsBuilt

  !!splAsBuilt.iconTitle     = 'Modify'
  !!splAsBuilt.callback      = '!!splAsBuilt.init()'
  !!splAsBuilt.formRevision  = ' $Revision: 1.28 $ '

  -- Body of form definition

  -- pointer to the main form !!splUpdate
  member .main is FORM

  --store current edit form
  member .editForm is FORM

  --store current attribute list gadget selection
  member .selectIndex is REAL

  -- Define gadgets

  -- current SPLDRG paragraph
  paragraph .splDrgName at xmin ymax width 60 height 1

  -- element list frame
  frame .elementFrame '' at xmin ymax

    -- list of elements to assign data to
    list .elements '------------------------------' at xmin+1 ymax+0.5 width 30 height 8

  exit

  -- data list frame
  frame .dataFrame '' at xmax+0.5 ymin
    -- list of data to assign to elements
    list .modifyAtts 'Attribute data' at xmin+1 ymax+0.5 width 30 height 8

  exit

  -- cancel the form
  button .dismiss   'Dismiss' at xmax form-size ymax+0.5 cancel

  -- setup form tracking
  track |ISODCE| |DESICE| callback '!!splAsBuilt.track('

exit
-- End of form definition for !!splAsBuilt

------------------------------------------------------------------------
--
-- Method:      !splAsBuilt()
--
-- Description: Constructor method for form object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .splAsBuilt()

  -- link the form to its implied owner, it should not be possible
  -- for this form to be displayed without its owner being visible,
  -- as this form is shown from the owning modify form.
  !this.main = !!splModify

  -- set callbacks
  !this.elements.callback = '!!splAsBuilt.listData(!!splAsBuilt.elements.selection().dbref())'
  !this.modifyAtts.callback = '!!splAsBuilt.modifyAtts()'
  !this.cancelCall = '!!splAsBuilt.dismiss()'

endmethod
-- End of method definition for .splAsBuilt()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: Form initialisation on show action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .init()

  -- form interlocking
  if (defined(!!splUpdate)) then
    if (!!splUpdate.shown()) then
      -- 'Modify not allowed whilst Update form is active.'
      !!messageFile.error(154, 1)
    endif
  endif
  if (defined(!!splRenumber)) then
    if (!!splRenumber.shown()) then
      -- 'Modify not allowed whilst Renumber form is active.'
      !!messageFile.error(154, 2)
    endif
  endif
  if (defined(!!splStringAtt)) then
    !!splStringAtt.hide()
  endif
  if (defined(!!splRealAtt)) then
    !!splRealAtt.hide()
  endif
  if (defined(!!splBooleanAtt)) then
    !!splBooleanAtt.hide()
  endif

  -- set spldrg name on form
  if (substring(!this.main.ce.namn,1,1) EQ '=') then
     !this.splDrgName.val = !this.main.ce.flnn
  else
     !this.splDrgName.val = !this.main.ce.namn
  endif

  -- set the form text strings (form title, list titles)
  !this.formTitle = 'Display/Modify Data for ' & !this.main.attribute(!this.main.objectName).formTitleText
  !this.elements.tag = !this.main.attribute(!this.main.objectName).elementListText

  -- start asbuilt mode for the current numbering object
  !this.main.attribute(!this.main.objectName).start()

  -- list the elements to modify
  !this.listMembers()

  -- clear modify form numbering object data
  !this.main.specificObject = STRING()

  -- initialise tracking to display appropriate to ce
  !this.track(!!splAsBuilt, !!ce.dbType)

  -- list data if there are elements to modify
  if (!this.elements.rtext.size() gt 0) then
    !this.listData(!this.elements.selection().dbref())
  else
    !this.modifyAtts.clear()
  endif

  !this.editForm = object FORM()
  !this.selectIndex = !this.modifyAtts.val
endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !track()
--
-- Description: Database tracking method
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [FORM] [Form passed by tracking mechanism]
--   [2] [R] [STRING] [Database type of current element]
--
------------------------------------------------------------------------

-- Define method
define method .track(!dummyForm is FORM, !dummyType is STRING)

  -- Select element derived from CE
  !member = !this.main.attribute(!this.main.objectName).trackSelect()
  if (!member.unset().not()) then
    !this.elements.select('RTEXT', !member.string())
    !this.listData(!this.elements.selection().dbref())
  endif

endmethod
-- End of method definition for .track(FORM, STRING)

------------------------------------------------------------------------
--
-- Method:      !listMembers()
--
-- Description: Display the elements to modify
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .listMembers()

  -- populate new elements list from current action object
  !tempArray = !this.main.attribute(!this.main.objectName).listMembers()
  !this.elements.dtext = !tempArray[1]
  !this.elements.rtext = !tempArray[2]

endmethod
-- End of method definition for .listMembers()

------------------------------------------------------------------------
--
-- Method:      !listData()
--
-- Description: Display attribute data for element
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF] [Element to retrieve attributes from]
--
------------------------------------------------------------------------

-- Define method
define method .listData(!element is DBREF)

  -- initialise local array for list values
  !values[1]   = ARRAY()
  !values[2]   = ARRAY()

  -- get attribute data for selected element
  !data = !this.main.splDrgAtts.getAttributes(!element)

  -- define new line char
!nl='
'
  --size large string in the array
   !attLrgSz = !data.attributes.width()
   --define space char.s
   !spaceChr = '                   '
   --define display format for attributes
   !dspFormt = SUBSTRING(!spaceChr,1,!attLrgSz + 1)
   --check the name attribute is set
   !nameSet = false
   if (substring(!element.namn,1,1) NE '=') then
      !nameSet = true
   endif
   -- initialise array index for rtext and dtext of gadget modifyAtts to 1
   !id = 1
  -- loop through the list of attributes and copy values to return array
  do !j indices !data.attributes

      !attribute = SUBSTRING(!data.attributes[!j] + !spaceChr,1,!attLrgSz)
      !attributeString = !data.attributes[!j]


      --split multi-line string attribute value into an array
      !valStr = !data.values[!j].string().split(!nl)
      !valType= !data.values[!j].objectType().string()
      if (not !valStr.empty()) then
         if (!data.attributes[!j].upcase() eq 'NAME') then
            if (not !nameSet) then
               !values[1][!id] = !attribute + ':' + 'unset'
            else
               !values[1][!id] = !attribute + ':' + substring(!element.namn,1,!element.namn.string().length())
            endif
         elseif ((!valStr.size() EQ 1) and (!valStr[1] EQ !nl)) then
            !values[1][!id] = !attribute + ':' + 'unset'
         else
           -- Set just in case distance evaluation fails
           !values[1][!id] = !attribute + ':' + !valStr[1]
           -- We need to know if a core attribute is a distance for formatting
           var !testUnit attdef $!attributeString unit
           handle ANY
           elsehandle NONE
             if (!testUnit[1] eq 'DIST') then
               !values[1][!id] = !attribute + ':' + !valStr[1].real().string(!!distanceFmt)
               handle ANY
               endhandle
             endif
           endhandle
         endif
      else
         !values[1][!id] = !attribute + ':' + 'unset'
      endif
      !values[2][!id] = !valType.upcase() + ':' + !attribute.upcase()
      !id = (!id + 1)

      if (!valStr.size() gt 1) then
         do !k from 2 to !valStr.size()
            if (not !valStr[!k].empty()) then
               !values[1][!id] = !dspFormt + !valStr[!k]
               !values[2][!id] = !valType.upcase() + ':' + !attribute.upcase()
               !id = !id + 1
            endif
  enddo
      endif
   enddo

  -- Rebuild list
  !this.modifyAtts.dtext = !values[1]
  !this.modifyAtts.rtext = !values[2]

  -- highlight selected element
  !this.main.attribute(!this.main.objectName).highlight(!this.elements.selection().dbref())

endmethod
-- End of method definition for .listData(DBREF)

------------------------------------------------------------------------
--
-- Method:      !modifyAtts()
--
-- Description: modify spldrg member attributes
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .modifyAtts()

  -- define new line character
!nl ='
'
  !value = ''
  -- Handle multi line text selections
  !data = !this.main.splDrgAtts.getAttributes(!this.main.ce)
  !strSz = !data.attributes.width() + 2
  !slcRtxt = !this.modifyAtts.selection('RTEXT')
  !getRtxt = !this.modifyAtts.rtext.find(!slcRtxt)
  if (!getRtxt.size() GT 1) then
     do !j indices !getRtxt
        !dtxt = !this.modifyAtts.dtext[!getRtxt[!j]]
        !value = !value & substring(!dtxt,!strSz,!dtxt.length()) + !nl
     enddo
  else
     !value = !this.modifyAtts.selection('DTEXT').after(':').before(!nl).trim()
  endif

  -- Get attribute data to be modified
  !attribute = !this.modifyAtts.selection('RTEXT').after(':').trim()
  !dataType = !this.modifyAtts.selection('RTEXT').before(':').trim()

   -- check write access to the selected attribute
  var !modifyAtt ATTDEF $!<attribute> QSET
  if (!modifyAtt[1].upcase() eq 'TRUE') then
     if (!!ce.dbType.upcase() eq 'DESI') then
        var !modifyAtt ATTDEF $!<attribute> LGSPLA
     endif
  endif

  if (!modifyAtt[1].upcase() EQ 'TRUE') then

  -- Attributes for info only
  !infoAttList = 'XXXXXXXXXX'
  if (!infoAttList.match(!attribute.upcase()) gt 0) then
    -- 'Attribute #attribute may not be modified'
    !!messageFile.error(154, 91, !attribute)
  endif

  -- List/reference attributes for display
  !dispAttList = 'SPLMEM IWDOWNERS AWDOWNER JNTOWNERS'
  !modifyAttList = 'RWDOWNER'
  if (!dispAttList.match(!attribute.upcase()) gt 0) then
        !this.selectIndex = !this.modifyAtts.val
    show !!splAttDisp
        !!splAttDisp.init(!this.elements.selection().dbref(), !attribute)

  elseif (!modifyAttList.match(!attribute.upcase()) gt 0) then
        !this.selectIndex = !this.modifyAtts.val
        !!ce = !this.elements.selection().dbref().rwdowner
    show !!splAttWeld

  else
    -- Modification not allowed if data not up to date
    if (!this.main.objectModify.not()) then

      -- 'Data is not up to date so may not be modified'
      !!messageFile.error(154, 96, !attribute)

    else
      -- Attributes requiring validation of user value (allow for array)
      !validateAttList = 'SPLNUMBER WLDNUMBER JNTNUMBER PARTNUMBER BOLTPARTNUMBERS MTOPARTNUMBERS PBENDNUMBER'
      !validate = false
      if (!validateAttList.match(!attribute.upcase().before('[')) gt 0) then
        !validate = true
      endif

      -- Invoke modification form
           !this.selectIndex = !this.modifyAtts.val
           !!splAttModify(!this, !this.elements.selection().dbref(), !attribute, !value, !dataType, !validate)

    endif
  endif
  else
     -- warn user that attribute cannot be modified
     !!alert.warning('$!attribute cannot be modified')
     !this.modifyAtts.val = !this.selectIndex
     if (!this.editForm.unset().not()) then
        !this.editForm.show()
     endif
  endif
endmethod
-- End of method definition for .modifyAtts()

------------------------------------------------------------------------
--
-- Method:      !dismiss()
--
-- Description: Dismiss method
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .dismiss()

  -- Reset display and tidy up
  !this.main.attribute(!this.main.objectName).unhighlight()

endmethod
-- End of method definition for .dismiss()

------------------------------------------------------------------------
--
-- Method:      !display()
--
-- Description: Update attribute display following modification
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF] [Element to display data for]
--
------------------------------------------------------------------------

-- Define method
define method .display(!element is DBREF)

  -- This method is called from the attribute modification forms
  -- (splStringAtt, splRealAtt, splBooleanAtt) when ok'd

  -- relist elements, select element in list, then relist attribute data
  !this.listMembers()
  !this.elements.select('RTEXT', !element.string())
  !selection = !this.modifyAtts.val
  !this.listData(!element)
  !this.modifyAtts.val = !selection

  -- Attributes requiring redisplay of parent modify form (if smax etc change)
  !validateAttList = 'SPLNUMBER WLDNUMBER JNTNUMBER PARTNUMBER BOLTPARTNUMBER MTOPARTNUMBER PBENDNUMBER'
  !attribute = !this.modifyAtts.selection('DTEXT').before(':').trim()
  if (!validateAttList.match(!attribute.upcase()) gt 0) then
    !this.main.display(!this.main.ce)
  endif

endmethod
-- End of method definition for .display(DBREF)

------------------------------------------------------------------------
--
-- Method:      !validate()
--
-- Description: validate string attribute from user input
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF]  [Element to set attribute on]
--   [2] [R] [STRING] [Attribute]
--   [3] [R] [STRING] [Value]
-- Return value:
--   [BOOLEAN]  [True if validated]
--
------------------------------------------------------------------------

-- Define method
define method .validate(!element is DBREF, !attribute is STRING, !value is STRING) is BOOLEAN

  -- This method is called from the attribute modification forms
  -- (splStringAtt, splRealAtt, splBooleanAtt) when validation required

  return !this.main.attribute(!this.main.objectName).validate(!element, !attribute, !value)

endmethod
-- End of method definition for .validate(DBREF, STRING, STRING) BOOLEAN

