--
-- File:            splattdisp.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Tue Mar 17 09:53:46 GMT 1998
--
--
-- Description:
-- Display list or reference attribute for spooling db element
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  dismiss()                        -                   dismiss action
--  display()                        -                   highlight picked item in graphics view
--  highlight(DBREF)                 -                   Highlight the selected element
--  init(DBREF,STRING)               -                   Form initialisation called from !!splAsBuilt.modifyAtts()
--  splAttDisp()                     -                   constructor
--  unhighlight()                    -                   unhighlight the selected element
--
------------------------------------------------------------------------

setup form !!splAttDisp

  !!splAttDisp.formTitle     = 'Display Attribute'
  !!splAttDisp.iconTitle     = 'Display'
  !!splAttDisp.callback      = ''
  !!splAttDisp.formRevision  = ' $Revision: 1.14 $ '

  -- Body of form definition

  -- element current to the form
  member .ce is DBREF

  -- attribute name
  member .name is STRING

  -- stores element marked
  member .markedElement is DBREF

  -- gadget to display name of forms current element
  paragraph .ceText at xmin ymax width 40 lines 2

  -- attribute name
  paragraph .attribName at xmin ymax+0.2 width 30 lines 1

  -- attribute display
  list .display at xmin ymax width 40 height 10

  -- dismiss button
  button .dismiss 'Dismiss' at xmax form-size ymax cancel

exit
-- End of form definition for !!splAttDisp

------------------------------------------------------------------------
--
-- Method:      !splAttDisp()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .splAttDisp()

  -- define callbacks
  !this.display.callback = '!!splAttDisp.display()'
  !this.cancelCall = '!!splAttDisp.dismiss()'

endmethod
-- End of method definition for .splAttDisp()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: Form initialisation called from !!splAsBuilt.modifyAtts()
--
-- Method Type: Procedure
-- Arguments:
--  [1]  [R]  [DBREF]    [element being displayed]
--  [2]  [R]  [STRING]   [attribute name]
--
------------------------------------------------------------------------

define method .init(!element is DBREF, !attribute is STRING)

  -- Initialise member data
  !this.ce = !element
  !this.name = !attribute
  !this.display.clear()

  -- Display ce for form
  !this.ceText.val = !this.ce.flnn

  -- Get attribute data (special case for each attribute)
  if (!this.name.upcase() eq 'SPLMEM') then

    -- attribute description
    if (!this.ce.type eq 'SPOOL') then
      !this.attribName.val = 'Spool members'
    elseif (!this.ce.type eq 'FIELD') then
      !this.attribName.val = 'Field members'
    endif

    -- attribute contents is array of dbrefs
    !dText = !this.ce.splMem.evaluate(OBJECT BLOCK('!this.ce.splMem[!evalIndex].fullName'))
    !rText = !this.ce.splMem.evaluate(OBJECT BLOCK('!this.ce.splMem[!evalIndex].string()'))

  elseif (!this.name.upcase() eq 'IWDOWNERS' or !this.name.upcase() eq 'JNTOWNERS') then

    -- attribute name and description
    if (!this.name.upcase() eq 'IWDOWNERS') then
      !this.attribName.val = 'Implied weld owners'
      !data = !!splIwdOwners(!this.ce)
    elseif (!this.name.upcase() eq 'JNTOWNERS') then
      !this.attribName.val = 'Implied joint owners'
      !data = !!splJntOwners(!this.ce)
    endif

    -- return data is 2 * (description, dbref, ppoint number)
    !dText = ARRAY()
    !rText = ARRAY()
    !dText.append(!data[1])
    !rText.append(!data[2].string())
    !dText.append(!data[4])
    !rText.append(!data[5].string())

  elseif (!this.name.upcase() eq 'AWDOWNER') then

    -- attribute description
    !this.attribName.val = 'Attached weld owner'

    -- return data is description, dbref, weld number
    !data = !!splAwdOwner(!this.ce)
    !dText = ARRAY()
    !rText = ARRAY()
    !dText.append(!data[1])
    !rText.append(!data[2].string())

  endif

  -- Display attribute data
  if (!dText.size() gt 0) then
    !this.display.dText = !dText
    !this.display.rText = !rText
    !this.display()
  endif

endmethod
-- End of method definition for .init(DBREF, STRING)

------------------------------------------------------------------------
--
-- Method:      !display()
--
-- Description: highlight picked item in graphics view
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .display()

  -- highlight selected item
  !this.highlight(!this.display.selection().dbRef())

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      !highlight()
--
-- Description: Highlight the selected element
--
-- Method Type: Procedure
-- Arguments:
-- [1]  [R]  [DBREF]    [Element selected for highlighting]
--
------------------------------------------------------------------------

-- Define method
define method .highlight(!element is DBREF)

  -- reset display
  !this.unhighlight()

  -- mark the selected element
  !this.markedElement = !element
  MARK $!<this.markedElement>

endmethod
-- End of method definition for .highlight(DBREF)

------------------------------------------------------------------------
--
-- Method:      !unhighlight()
--
-- Description: unhighlight the selected element
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .unhighlight()

  -- unmark the previously marked element
  if (!this.markedElement.set()) then
    if (!this.markedElement.badRef().not()) then
      UNMARK $!<this.markedElement>
    endif
    !this.markedElement = object DBREF()
  endif

endmethod
-- End of method definition for .unhighlight()

------------------------------------------------------------------------
--
-- Method:      !dismiss()
--
-- Description: dismiss action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .dismiss()

  -- Reset display
  !this.unhighlight()

endmethod
-- End of method definition for .dismiss()
