--
-- File:            splcreate.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Mon Aug 11 14:50:10 BST 1997
--
--
-- Description:
-- Form for creating spooler elements
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  auto()                           -                   method to define an auto generated name
--  cancel()                         -                   cancel action
--  init()                           -                   form initialisation
--  nameCheck()                      -                   method when name typed in
--  ok()                             -                   ok action
--  splCreate()                      -                   constructor
--
------------------------------------------------------------------------

-- Define form
setup form !!splCreate

  !!splCreate.formTitle     = 'Create'
  !!splCreate.iconTitle     = 'Create'
  !!splCreate.callback      = '!!splCreate.init()'
  !!splCreate.formRevision  = ' $Revision: 1.20 $ '

  member .dbRef is DBREF

  -- Body of form definition
  -- Name Option
  option .auto at xmin ymin width 8

  -- Element Name
  text .name at xmax ymin width 32 name

  -- Bottom Line
  button .ok     |  OK  | at xmin form+0 ymax+0.5 ok
  button .cancel |Cancel| at xmax form-size ymin cancel

exit
-- End of form definition for !!splCreate

------------------------------------------------------------------------
--
-- Method:      !splCreate()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .splCreate()

  -- define gadget callbacks
  !this.auto.callback   = |!!splCreate.auto()|
  !this.name.callback   = |!!splCreate.nameCheck()|
  !this.okCall     = |!!splCreate.ok()|
  !this.cancelCall = |!!splCreate.cancel()|

  !dText[1] = 'Name'
  !rText[1] = 'NAME'
  !dText[2] = 'AutoName'
  !rText[2] = 'AUTO'
  !this.auto.dText = !dText
  !this.auto.rText = !rText

endmethod
-- End of method definition for .splCreate()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init()

  !this.dbRef = !!ce
  !this.name.val = 'unset'
  !this.formTitle = 'Create ' & !!ce.type

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !auto()
--
-- Description: method to define an auto generated name
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .auto()

  !autoName = !!namOpt.nameString(!this.dbRef, '', false, false)
  if (!autoName.unset().not()) then
    !this.name.val = !autoName
  endif

endmethod
-- End of method definition for .auto()

------------------------------------------------------------------------
--
-- Method:      !nameCheck()
--
-- Description: method when name typed in
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .nameCheck()

  !!nameGadget(!this.name, 'NEW')

endmethod
-- End of method definition for .nameCheck()

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: ok action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .ok()

  -- navigate to the element
  !!ce = !this.dbRef
  handle any
    return
  endhandle

  if (!this.name.val.upcase() ne 'UNSET') then
    -- set name
    NAME $!<this.name.val>
  endif

  -- set default splprefix
  SPLPREFIX '$!!<splNumOpt.splPrefix>'

  -- perform any user action on create
  if (!!splCreateAction(!this.dbRef).not()) then
    !this.cancel()
  else
    -- update gadgets so new active splDrg name is displayed
    !!spooler.functions.gadgetSetup(!!ce)
  endif

endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      !cancel()
--
-- Description: cancel action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .cancel()

  -- navigate to element
  !!ce = !this.dbRef
  handle any
    return
  endhandle

  -- delete element
  DELETE $!!<ce.type>

endmethod
-- End of method definition for .cancel()
