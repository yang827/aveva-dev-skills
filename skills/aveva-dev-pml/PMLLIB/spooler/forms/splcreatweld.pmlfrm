--
--
-- Description:
-- Create weld on splDrg
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   apply create weld
--  atPpoint(DBREF,REAL)             -                   create weld at ppoint
--  dismiss()                        -                   dismiss create weld
--  inTube(DBREF,STRING)             -                   create weld in tube
--  inTubePos(DBREF,STRING)          -                   position weld in tube in front or behind item
--  init()                           -                   initialisation
--  pPointOrTube()                   -                   action on selecting ppoint or tube option
--  removeEdg()                      -                   remove EDG packet for first pick
--  removeTubeEdg()                  -                   remove EDG packet for second tube pick
--  rollbackEdg()                    -                   update form following EDG rollback on graphics form
--  rollbackTubeEdg()                -                   update form following EDG rollback on graphics form
--  splCreatWeld()                   -                   constructor
--
------------------------------------------------------------------------

setup form !!splCreatWeld

  !this.formTitle     = 'Create Weld'
  !this.iconTitle     = 'Weld'
  !this.callback      = '!this.init()'
  !this.formRevision  = ' $Revision: 1.24 $ '

  -- pick ppoint/tube EDG packet
  member .edgPacket is EDGPACKET

  -- second pick for tube EDG packet
  member .edgTubePacket is EDGPACKET

  -- store item from first tube pick
  member .tubePick is DBREF

  -- Body of form definition

  option .fieldOrShop  'Type ' at xmin ymax+0.2 width 5

  option .pPointOrTube 'At   ' at xmin ymax+0.2 width 12

  frame .tubeQual 'Position in Tube' at xmin ymax+0.2
    text .distance 'Distance ' at xmin+1 ymax width 14 is REAL format !!distanceFmt
    option .inTubePos at xmin+6 ymax width 16
  exit

  text .allowance 'Allowance ' at xmin ymax+0.5 width 14 is REAL format !!distanceFmt

  button .apply ' Apply ' at xmin.fieldOrShop ymax+0.5
  button .dismiss 'Dismiss' at xmax form-size ymin cancel

exit
-- End of form definition for !!splCreatWeld

------------------------------------------------------------------------
--
-- Method:      !splCreatWeld()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .splCreatWeld()

  -- setup gadgets
  !dText = ARRAY()
  !dText[1] = 'Field'
  !dText[2] = 'Shop'
  !this.fieldOrShop.dText = !dText

  !dText[1] = 'Design Point'
  !dText[2] = 'In Tube'
  !this.pPointOrTube.dText = !dText

  !dText[1] = 'From Previous'
  !dText[2] = 'In Front of Item'
  !dText[3] = 'Behind Item'
  !this.inTubePos.dText = !dText

  -- define callbacks
  !this.pPointOrTube.callback = '!this.pPointOrTube()'
  !this.apply.callback = '!this.apply()'
  !this.cancelCall = '!this.dismiss()'

endmethod
-- End of method definition for .splCreatWeld()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .init()

  -- turn attaBreak off so that weld position relative to previous piping component can be determined
  ATTABREAK OFF bran

  -- activate tube qualification gadgets if required
  !this.pPointOrTube()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !pPointOrTube()
--
-- Description: action on selecting ppoint or tube option
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .pPointOrTube()

  -- activate tube qualification gadgets if required
  !this.distance.active = (!this.pPointOrTube.selection() eq 'In Tube')
  !this.inTubePos.active = (!this.pPointOrTube.selection() eq 'In Tube')

endmethod
-- End of method definition for .pPointOrTube()

------------------------------------------------------------------------
--
-- Method:      !apply()
--
-- Description: apply create weld
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .apply()

  -- remove EDG packets if not completed
  !this.removeTubeEdg()
  !this.removeEdg()

  -- weld at ppoint
  if (!this.pPointOrTube.selection() eq 'Design Point') then

    -- define an edg packet for the pick
    !packet = object EDGPACKET()
    !packet.key         = 'SplCreatWeld'
    !packet.description = 'Create weld at design point'
    !packet.type        = 'Spooler'
    !packet.priority    = 0
    !packet.action      = '!!splCreatWeld.atPpoint(!this.return[1].item, !this.return[1].point)'
    !packet.remove      = false
    !packet.close       = '!!splCreatWeld.rollbackEdg()'
    !packet.pickPacket.stdPpoint('Pick a Design Point for WELD ')
    !packet.pickPacket.picks[1].pick.input[2]   = 'PCON ne ''NULL'' and PCON ne ''0'''
    !packet.pickPacket.picks[1].pick.input[3]   = '((type of owner) eq |BRAN|)'
    !packet.pickPacket.picks[1].pick.input[5]   = '(type ne |TUBI|)'
    !packet.pickPacket.picks[1].pick.modifiable = false

    -- store and activate the packet
    !this.edgPacket = !packet
    if (!!edgCntrl.add(!packet).not()) then
      !this.rollbackEdg()
    endif

  -- weld in tube
  elseif (!this.pPointOrTube.selection() eq 'In Tube') then

    -- define an edg packet for the pick
    !packet = object EDGPACKET()
    !packet.key         = 'SplCreatWeld'
    !packet.description = 'Create weld in tube'
    !packet.type        = 'Spooler'
    !packet.priority    = 0
    !packet.action      = '!!splCreatWeld.inTube(!this.return[1].item, !this.return[1].type)'
    !packet.remove      = false
    !packet.close       = '!!splCreatWeld.rollbackEdg()'
    !packet.pickPacket.stdElement('Pick a position in tube for WELD ')
    !packet.pickPacket.picks[1].pick.input[3]   = '(type eq |TUBI|)'
    !packet.pickPacket.picks[1].pick.input[5]   = ''
    !packet.pickPacket.picks[1].pick.modifiable = false

    -- store and activate the packet
    !this.edgPacket = !packet
    if (!!edgCntrl.add(!packet).not()) then
      !this.rollbackEdg()
    endif

  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      !atPpoint()
--
-- Description: create weld at ppoint
--
-- Method Type: Procedure
-- Arguments:
--  [1] [R] [DBREF] [element picked]
--  [2] [R] [REAL]  [ppoint picked]
--
------------------------------------------------------------------------

define method .atPpoint(!element is DBREF, !pPoint is REAL)

  -- ignore P0
  if (!pPoint gt 0) then

    -- shop selection
    !shop = (!this.fieldOrShop.selection() eq 'Shop')

    -- default allowance
    if (!this.allowance.val.string().trim() eq '') then
      !allowance = 0
    else
      !allowance = !this.allowance.val
    endif

    -- get list position to create weld at
    !!ce = !element
    if (!pPoint eq !!ce.leave) then
      !where = 'AFTER'
      !connect = 'CONNECT TO PREVIOUS'
    elseif (!pPoint eq !!ce.arrive) then
      !where = 'BEFORE'
      !connect = 'CONNECT TO NEXT'
    else
      -- weld will be created in other branch
      !!ce = !element.cref
      handle any
        !!ce = !element.crfa[!pPoint]
        handle any
        endhandle
      endhandle
      if (!!ce.type eq 'BRAN') then
        -- find which end of branch refers back (cend not available for crfa)
        if (!!ce.href eq !element) then
          !where = 'AFTER'
          !connect = 'CONNECT TO PH'
        elseif (!!ce.tRef eq !element) then
          if (!!ce.members.size() gt 0) then
            LAST MEMBER
          endif
          !where = 'AFTER'
          !connect = 'CONNECT TO PT'
        endif
      endif
    endif

    -- check we have a valid position to create weld
    if (defined(!where)) then

      -- element now current will used for tube/insu/trace specs and sfref
      !refElement = !!ce
      !oldTubeRef = ILEAVE TUBE OF $!refElement
      -- leave tube may not exist
      handle any
        !oldTubeSfref = object DBREF()
      elsehandle none
        -- store sfref now as it will be lost when leave tube is replaced
        !oldTubeSfref = !oldTubeRef.sfref
      endhandle

      -- create weld
      NEW WELD $!where
      -- primary element has not been claimed (in multiwrite db)
      handle (2,605)
        -- need alert
        !!alert.error('Cannot create welds if owning branch has not been CLAIMed.')
      elsehandle any
      endhandle
      CHOOSE WITH SHOP $!shop

      -- Spec does not contain elements matching given criteria
      handle (61,162) (61,164)
        DELETE WELD

        !!splCreatWeld.removeEdg()
        -- need alert and no error return in EDG
        !!alert.error(!!messageFile.messageString(61,164))
        return

      -- Handle specific question cannot be answered to pop up choose form
      elsehandle any
      endhandle

      -- connect to appropriate position (tests ppoints)
      $!connect

      -- cannot find ppoints (probably not selected, e.g. choose cancelled)
      handle (7,41)
        DELETE WELD

      elsehandle any
        DELETE WELD
        !!alert.error(!!error.text)

      elsehandle none
        -- set weld attributes
        SHOP $!shop
        if (!refElement.type eq 'BRAN') then
          LSTU $!<refElement.hstu>
        else
          LSTU $!<refElement.lstu>
        endif
        ISPEC $!<refElement.iSpec>
        TSPEC $!<refElement.tSpec>
        ALLOW $!allowance
        -- add weld into splDrg if both sides were in same splDrg
        !weld = !!ce
        if (!oldTubeSfref.set()) then
          if (!refElement.sfref.set()) then
            if (!refElement.sfref eq !oldTubeSfref) then
              SPOOLING ADD $!<refElement.sfref.owner> $!weld
              handle any
              endhandle
            endif
          endif
          -- add weld leave tube into splDrg of old leave tube
          -- if this is a field weld the splDrg will now need updating by user
          !weldTube = ILEAVE TUBE OF $!weld
          -- leave tube may not exist
          handle any
          elsehandle none
            SPOOLING ADD $!<oldTubeSfref.owner> $!weldTube
            -- tube may already be added if shop weld
            handle any
            endhandle
          endhandle
        endif
      endhandle

    endif
  endif

  -- remove first edg packet
  !!splCreatWeld.removeEdg()

endmethod
-- End of method definition for .atPpoint(DBREF, REAL)

------------------------------------------------------------------------
--
-- Method:      !inTube()
--
-- Description: create weld in tube
--
-- Method Type: Procedure
-- Arguments:
--  [1] [R] [DBREF]  [picked element]
--  [2] [R] [STRING] [element or tubing indicator]
--
------------------------------------------------------------------------

define method .inTube(!element is DBREF, !type is STRING)

  -- store picked tube
  !this.tubePick = ILEAV TUBE OF $!element

  if (!this.inTubePos.selection() eq 'From Previous') then

    -- no second pick required
    !this.inTubePos(!element, 'TUBING')

  else

    -- define an edg packet for the second pick
    !packet = object EDGPACKET()
    !packet.key         = 'SplCreatWeld'
    !packet.description = 'Identify reference for weld in tube'
    !packet.type        = 'Spooler'
    -- must have a different priority to the first packet
    !packet.priority    = 1
    !packet.action      = '!!splCreatWeld.inTubePos(!this.return[1].item, !this.return[1].type)'
    !packet.remove      = false
    !packet.close       = '!!splCreatWeld.rollbackTubeEdg()'
    !packet.pickPacket.stdElement('Pick an element for WELD distance ')
    !packet.pickPacket.picks[1].pick.input[3]   = ''
    !packet.pickPacket.picks[1].pick.input[5]   = '(type ne |TUBI|)'
    !packet.pickPacket.picks[1].pick.modifiable = false

    -- store and activate the packet
    !this.edgTubePacket = !packet
    if (!!edgCntrl.add(!packet).not()) then
      !this.rollbackTubeEdg()
    endif

  endif

endmethod
-- End of method definition for .inTube(DBREF, STRING)

------------------------------------------------------------------------
--
-- Method:      !inTubePos()
--
-- Description: position weld in tube in front or behind item
--
-- Method Type: Procedure
-- Arguments:
--  [1] [R] [DBREF]  [picked element]
--  [2] [R] [STRING] [element or tubing indicator]
--
------------------------------------------------------------------------

define method .inTubePos(!element is DBREF, !type is STRING)

  -- shop selection
  !shop = (!this.fieldOrShop.selection() eq 'Shop')

  -- default allowance
  if (!this.allowance.val.string().trim() eq '') then
    !allowance = 0
  else
    !allowance = !this.allowance.val
  endif

  -- default distance
  if (!this.distance.val.string().trim() eq '') then
    !distance = 0
    !this.distance.val = 0
  else
    !distance = !this.distance.val
  endif

  -- Test for zero distance, since cannot use this in later direction calc
  if (!distance.eq(0)) then
   !setDist = 10
  else
    !setDist = !distance
  endif

  -- get data for element preceding tube piece
  !!ce = !this.tubePick
  PREVIOUS
  handle any
    END
    var !refDirection PHEAD DIRECTION WRT /*
    var !refPosition PHEAD POSITION WRT /*
  elsehandle none
    var !refDirection PLEAVE DIRECTION WRT /*
    var !refPosition PLEAVE POSITION WRT /*
  endhandle

  -- create a reference point vector at start of tube
  !refPoint = object POINTVECTOR()
  !refPoint.position = object POSITION(!refPosition)
  !refPoint.direction = object DIRECTION(!refDirection)

  -- create a point vector where weld is requested
  if (!this.inTubePos.selection() eq 'From Previous') then
    !newPoint = !refPoint.offset(!setDist)
  elseif (!this.inTubePos.selection() eq 'In Front of Item') then
    -- adjust checking distance if element flipped
    if (!element.type ne 'BRAN') then
      if (!element.arrive eq 2) then
        !distance1 = !distance + !element.fitlen
      else
        !distance1 = !distance
      endif
    else
      !distance1 = !distance
    endif
    !newPoint = !refPoint.through(!element.position).offset(- !distance1)
  elseif (!this.inTubePos.selection() eq 'Behind Item') then
    if (!element.type ne 'BRAN') then
      if (!element.leave eq 2) then
        !distance1 = !distance + !element.fitlen
      else
        !distance1 = !distance
      endif
    else
      !distance1 = !distance
    endif
    !newPoint = !refPoint.through(!element.position).offset(!distance1)
  endif

  -- check if requested point is within available tube
  !dirPoint = !refPoint.towards(!newPoint.position)
  if (!dirPoint.direction ne !refPoint.direction or $
      !newPoint.position.distance(!refPoint.position) gt !this.tubePick.itlength) then
    -- 115 'Position is not within available tube length'
    -- need alert and no error return in EDG
    !!alert.error(!!messageFile.messageString(154, 115))

  else
    -- position after appropriate ATTA
    ATTABREAK ON bran
    !!ce = !element.ref
    !len = 0
    if (!this.inTubePos.selection() eq 'In Front of Item') then
      do
        PREVIOUS
        handle any
          break
        elsehandle none
          var !ctype type
          if (!ctype eq 'ATTA') then
            var !ltlen ltlen
            !len = !len + !ltlen.real()
            if (!distance le !len) then
              break
            endif
          else
            break
          endif
        endhandle
      enddo
    else
      do
        NEXT
        handle any
          break
        elsehandle none
          var !ctype type
          if (!ctype eq 'ATTA') then
            var !atlen atlen
            !len = !len + !atlen.real()
            if (!distance le !len) then
              PREVIOUS
              break
            endif
          else
            PREVIOUS
            break
          endif
        endhandle
      enddo
    endif
    ATTABREAK OFF bran

    -- store element so can get attributes later
    !startElement = !!ce
    !oldTubeRef = ILEAVE TUBE OF $!startElement
    -- leave tube may not exist
    handle any
      !oldTubeSfref = object DBREF()
    elsehandle none
      -- store sfref now as it will be lost when leave tube is replaced
      !oldTubeSfref = !oldTubeRef.sfref
    endhandle

    -- create weld
    NEW WELD
      -- primary element has not been claimed (in multiwrite db)
      handle (2,605)
        -- need alert
        !!alert.error('Cannot create welds if owning branch has not been CLAIMed.')
      elsehandle any
      endhandle
    CHOOSE WITH SHOP $!shop

    -- Spec does not contain elements matching given criteria
    handle (61,162) (61,164)
      DELETE WELD
      !!splCreatWeld.removeTubeEdg()
      !!splCreatWeld.removeEdg()
      -- need alert and no error return in EDG
      !!alert.error(!!messageFile.messageString(61,164))
      return

    -- Handle specific question cannot be answered to pop up choose form
    elsehandle any
    endhandle

    -- orientate and test ppoints
    ORIENTATE
    var !unusedPPointTest PARRIVE BORE

    -- cannot find ppoints (probably not selected, e.g. choose cancelled)
    handle (2, 201)
      DELETE WELD

    elsehandle any
      DELETE WELD
      !!alert.error(!!error.text)

    elsehandle none
      -- set weld attributes
      SHOP $!shop
      if (!startElement.type eq 'BRAN') then
        LSTU $!<startElement.hstu>
      else
        LSTU $!<startElement.lstu>
      endif
      ISPEC $!<startElement.iSpec>
      TSPEC $!<startElement.tSpec>
      -- allowance not relevant to shop weld
      if (!shop.not()) then
        ALLOW $!allowance
      endif
      -- add weld and leave tube into splDrg
      -- if this is a field weld the splDrg will now need updating by user
      !weld = !!ce
      if (!oldTubeSfref.set()) then
        SPOOLING ADD $!<oldTubeSfref.owner> $!weld
        handle any
        endhandle
        !weldTube = ILEAVE TUBE OF $!weld
        -- leave tube may not exist
        handle any
        elsehandle none
          SPOOLING ADD $!<oldTubeSfref.owner> $!weldTube
          -- tube may already be added if shop weld
          handle any
          endhandle
        endhandle
      endif

      -- set to appropriate position
      if (!!splCreatWeld.inTubePos.selection() eq 'From Previous') then
        -- needs From Previous so positioned correctly after ATTA
        DISTANCE $!distance FROM PREVIOUS
        handle (2,113)
          DISTANCE $!distance
        endhandle
      elseif (!!splCreatWeld.inTubePos.selection() eq 'In Front of Item') then
        DISTANCE $!distance INFRONT $!element
      elseif (!!splCreatWeld.inTubePos.selection() eq 'Behind Item') then
        DISTANCE $!distance BEHIND $!element
      endif
    endhandle

  endif

  -- remove EDG packet for second tube pick
  !!splCreatWeld.removeTubeEdg()

  -- remove first edg packet
  !!splCreatWeld.removeEdg()

endmethod
-- End of method definition for .inTubePos(DBREF, STRING)

------------------------------------------------------------------------
--
-- Method:      !rollbackEdg()
--
-- Description: update form following EDG rollback on graphics form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .rollbackEdg()

  -- unset edg packet
  !this.edgPacket = object EDGPACKET()

endmethod
-- End of method definition for .rollbackEdg()

------------------------------------------------------------------------
--
-- Method:      !removeEdg()
--
-- Description: remove EDG packet for first pick
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .removeEdg()

  -- remove first edg packet (which will cause !this.rollbackEdg to be called)
  if (!this.edgPacket.type.set()) then
    !!edgCntrl.remove(!this.edgPacket)
  endif

endmethod
-- End of method definition for .removeEdg()

------------------------------------------------------------------------
--
-- Method:      !rollbackTubeEdg()
--
-- Description: update form following EDG rollback on graphics form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .rollbackTubeEdg()

  -- unset edg packet
  !this.edgTubePacket = object EDGPACKET()

endmethod
-- End of method definition for .rollbackTubeEdg()

------------------------------------------------------------------------
--
-- Method:      !removeTubeEdg()
--
-- Description: remove EDG packet for second tube pick
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .removeTubeEdg()

  -- remove second edg packet (will cause !this.rollbackTubeEdg to be called)
  if (!this.edgTubePacket.type.set()) then
    !!edgCntrl.remove(!this.edgTubePacket)
  endif

endmethod
-- End of method definition for .removeTubeEdg()

------------------------------------------------------------------------
--
-- Method:      !dismiss()
--
-- Description: dismiss create weld
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .dismiss()

  -- turn attaBreak back to default
  ATTABREAK SPKBRK bran

  -- remove EDG packet for second tube pick if not completed
  !this.removeTubeEdg()

  -- remove first edg packet
  !this.removeEdg()

endmethod
-- End of method definition for .dismiss()
