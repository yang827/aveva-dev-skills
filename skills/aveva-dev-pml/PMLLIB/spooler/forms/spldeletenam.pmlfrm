--
--
-- Description:
-- Delete named element in Spooler
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init()                           -                   Initialisation
--  splDeleteNam()                   -                   Constructor method for form object
--
------------------------------------------------------------------------

-- Define form
setup form !!splDeleteNam

  !!splDeleteNam.formTitle     = 'Delete Name'
  !!splDeleteNam.iconTitle     = 'Delete'
  !!splDeleteNam.callback      = '!!splDeleteNam.init()'
  !!splDeleteNam.formRevision  = ' $Revision: 1.7 $ '

  -- Body of form definition
  text .name |Name| at xmin ymax width 30 is STRING
  button .ok |  OK  | at xmin ymax+0.5 ok
  button .cancel |Cancel| at xmax form-size ymin cancel

exit

-- End of form definition for !!splDeleteNam

------------------------------------------------------------------------
--
-- Method:      !splDeleteNam()
--
-- Description: Constructor method for form object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .splDeleteNam()

  -- set gadget callbacks
  !this.name.callback = |!!nameGadget(!!splDeleteNam.name, 'OLD')|
  !this.okCall = |!!splDelete(!!splDeleteNam.name.val.dbRef(), false, true)|

endmethod
-- End of method definition for .splDeleteNam()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: Initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .init()

  !this.name.clear()

endmethod
-- End of method definition for .init()
