--
-- File:            spldeletesel.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Thu Jul 24 13:39:56 BST 1997
--
--
-- Description:
-- Delete members form for the spooler module, this should be replaced with a
-- more generic solution, when methods for dbref objects are available
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  init()                           -                   Spooler delete members selection initialisation
--  ok()                             -                   Spooler delete members selection
--  splDeleteSel()                   -                   Constructor method for form object
--
------------------------------------------------------------------------

-- Kill existing form definition
kill !!splDeleteSel

-- Define form
setup form !!splDeleteSel

  !!splDeleteSel.formTitle     = 'Delete Selection'
  !!splDeleteSel.iconTitle     = 'Delete Selection'
  !!splDeleteSel.callback      = '!!splDeleteSel.init()'
  !!splDeleteSel.formRevision  = ' $Revision: 1.9 $ '

  paragraph .ceText width 30 lines 1

  frame .membFrame 'Members' at xmin ymax+0.2
    list .members multiple width 30 length 10
  exit

  button .ok     '  OK  ' at xmin.membFrame ymax+0.5 ok
  button .cancel 'Cancel' at xmax form-size ymin cancel

exit

------------------------------------------------------------------------
--
-- Method:      !splDeleteSel()
--
-- Description: Constructor method for form object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .splDeleteSel()

  -- set gadget callbacks
  !this.okCall = |!!splDeleteSel.ok()|

endmethod
-- End of method definition for .splDeleteSel()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description:  Spooler delete members selection initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .init()

  -- set name
  !this.ceText.val = !!ce.fullName

  -- get members of owning forms current element
  !ceMembers = !!ce.members

  do !i indices !ceMembers
    !dText[!i] = !ceMembers[!i].fullType & ' ' & !ceMembers[!i].name
    !rText[!i] = !ceMembers[!i].string()
  enddo

  !this.members.dText = !dText
  !this.members.rText = !rText

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: Spooler delete members selection
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .ok()

  -- delete selected members
  do !element values !this.members.selection()
    !!splDelete(!element.dbRef(), false, true)
  enddo

endmethod
-- End of method definition for .ok()
