--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Mon Jul 28 16:17:54 BST 1997
--
--
-- Description:
-- Spooler module drawlist including spooler specific options
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  add(STRING)                      -                   add an element to the drawlist
--  addColour()                      -                   set the add colour member
--  auto()                           -                   form initialisation
--  dismiss()                        -                   dismiss action
--  display()                        -                   display drawlist contents
--  init()                           -                   form initialisation
--  remove(STRING)                   -                   remove action
--  removeEdg()                      -                   remove EDG packet
--  removeElement(DBREF)             -                   remove element from drawlist
--  rollbackEdg()                    -                   update form following EDG rollback on graphics form
--  splDrawlist()                    -                   constructor
--
------------------------------------------------------------------------

-- Define form
setup form !!splDrawlist

  !!splDrawlist.formTitle     = 'Drawlist'
  !!splDrawlist.iconTitle     = 'DRAWLIST'
  !!splDrawlist.callback      = '!!splDrawlist.init()'
  !!splDrawlist.formRevision  = ' $Revision: 1.25 $ '

  member .addColour is COLOUR

  -- edg packet active for pick
  member .edgPacket  is EDGPACKET

  -- Body of form definition

  frame .addFrame 'Add to drawlist' at xmin ymax
    toggle .auto 'Auto' at xmin+1 ymax+0.2
    paragraph .colPara at xmax+1 ymin text 'Colour'
    button .colourView '  ' at xmax+1 ymin
    option .translVal at xmax+1 ymin width 6
    toggle .edges 'Edges' at xmax ymin
    button .add    ' Add CE  '  at xmin.auto ymax+0.4
    button .addVol 'Volume...' at xmax+1 ymin
  exit

  frame .drLstframe 'drawlist' at xmin.addFrame ymax+0.5 width 40
    list .drawlist at xmin+1 ymax+0.2 multi width 35 height 14
  exit

  frame .remDrLstFrame 'Remove from drawlist' at xmin.addFrame ymax+0.5 width 40
    button .remItem ' Item ' at xmin+1 ymax+0.2
    button .remId '  Id  ' at xmax+1 ymin
    button .remCe '  CE  ' at xmax+1 ymin
    button .remAll ' All  ' at xmax+1 ymin
  exit

  button .dismiss 'Dismiss' at xmax form-size ymax+0.5 cancel

exit

-- End of form definition for !!splDrawlist

------------------------------------------------------------------------
--
-- Method:      !splDrawlist()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .splDrawlist()

  -- set the colour selection button background
  !this.addColour.colour(1)

  -- initialise gadgets
  -- translucency options
  !dText = ARRAY()
  !dText[1] = 'Solid'
  !dText[2] = '12%'
  !dText[3] = '25%'
  !dText[4] = '50%'
  !dText[5] = '75%'
  !dText[6] = '87%'

  !rText = ARRAY()
  !rText[1] = '0'
  !rText[2] = '12'
  !rText[3] = '25'
  !rText[4] = '50'
  !rText[5] = '75'
  !rText[6] = '87'

  !this.translVal.dText = !dText
  !this.translVal.rText = !rText
  !this.edges.val = true

  -- set the gadget callbacks
  !this.auto.callback = |!this.auto()|
  !this.add.callback = |!!splDrawlist.add('CE')|
  !this.addVol.callback = |!!splDrawlist.add('VOLUME')|
  !this.colourView.callback = |!!colourSelectLoad('!!splDrawlist.addColour()', 'Drawlist Element Add Colour', !!splDrawlist.addColour.code)|
  !this.remItem.callback = |!!splDrawlist.remove('SELECTED')|
  !this.remId.callback = |!!splDrawlist.remove('PICK')|
  !this.remCe.callback = |!!splDrawlist.remove('CE')|
  !this.remAll.callback = |!!splDrawlist.remove('ALL')|
  !this.cancelCall = '!!splDrawlist.dismiss()'

endmethod
-- End of method definition for .splDrawlist()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init()

  -- set the colour gadgets
  !this.colourView.background = !this.addColour.code

  -- display drawlist
  !this.display()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !auto()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .auto()

  !active = !this.auto.val.not()

  !this.colPara.active = !active
  !this.colourView.active = !active
  !this.translVal.active = !active
  !this.edges.active = !active
endmethod
-- End of method definition for .auto()

------------------------------------------------------------------------
--
-- Method:      !add()
--
-- Description: add an element to the drawlist
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .add(!action is STRING)

  -- Initialise variables
  !element = !!ce

  -- get translucency and edges values
  if (!this.edges.val) then
    !edges = 'ON'
  else
    !edges = 'OFF'
  endif
  if (!this.translVal.selection() eq '0') then
    -- solid
    !translCommand = ''
  else
    -- a level of translucency
    !translCommand = 'TRANSL ' & !this.translVal.selection() & ' EDGES ' & !edges
  endif

  -- Add CE
  if (!action eq 'CE') then

    if (!!ce.type eq 'WORL') then
      return error 1 |Cannot add the World|
    elseif (!!ce.type eq 'SITE') then
      if (!!alert.confirm('Are you sure you want to add a site?') eq 'NO') then
        return
      endif
    endif

    !saveValue = !!gphColOpt.autoColour()
    if (!this.auto.val) then
      !!gphColOpt.autoColour(true)
      REM CE
      ADD $!element $!translCommand
    else
      !!gphColOpt.autoColour(false)
      REM CE
      ADD $!element COLOUR $!<this.addColour.code> $!translCommand
    endif
    !!gphColOpt.autoColour(!saveValue)

  -- Add items by volume
  elseif (!action eq 'VOLUME') then

    show !!splAddWithin

  endif

  -- display drawlist
  !this.display()

endmethod
-- End of method definition for .add(STRING)

------------------------------------------------------------------------
--
-- Method:      !remove()
--
-- Description: remove action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .remove(!action is STRING)

  -- remove selected
  if (!action eq 'SELECTED') then

    -- remove the edg packet if active
    !this.removeEdg()

    do !element values !this.drawlist.selection()
      !this.removeElement(!element.dbRef())
    enddo

  -- remove CE
  elseif (!action eq 'CE') then

    -- remove the edg packet if active
    !this.removeEdg()

    !this.removeElement(!!ce)

  -- remove all
  elseif (!action eq 'ALL') then

    -- remove the edg packet if active
    !this.removeEdg()

    REMOVE ALL

  -- set edg for remove by Pick
  elseif (!action eq 'PICK') then

    -- may already be in edg mode
    if (!this.edgPacket.type.unset()) then

      -- define an edg packet for the pick
      !packet = object EDGPACKET()
      !packet.key         = 'Remove'
      !packet.description = 'Remove from drawlist'
      !packet.type        = 'Spooler'
      !packet.priority    = 0
      !packet.action      = '!!splDrawlist.removeElement(!this.return[1].item)'
      !packet.remove      = false
      !packet.close       = '!!splDrawlist.rollbackEdg()'
      !packet.pickPacket.stdElement('Pick an element to be removed ')
      !packet.pickPacket.picks[1].pick.input[3]   = ''
      !packet.pickPacket.picks[1].pick.input[5]   = ''
      !packet.pickPacket.picks[1].pick.modifiable = false

      -- store and activate the packet
      !this.edgPacket = !packet
      if (!!edgCntrl.add(!packet).not()) then
        !this.rollbackEdg()
      endif

    endif

  endif

  -- display drawlist
  !this.display()

endmethod
-- End of method definition for .remove(STRING)

------------------------------------------------------------------------
--
-- Method:      !removeElement()
--
-- Description: remove element from drawlist
--
-- Method Type: Procedure
-- Arguments:
--  [1] [R] [DBREF] [element to be removed]
--
------------------------------------------------------------------------
define method .removeElement(!element is DBREF)

  -- remove it
  if (!element.type eq 'SITE') then
    REMOVE SITE $!element
  else
    REMOVE $!element
  endif

endmethod
-- End of method definition for .removeElement(DBREF)

------------------------------------------------------------------------
--
-- Method:      !display()
--
-- Description: display drawlist contents
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .display()

  -- get drawlist contents as array
  var !drawlist EVALUATE FULLNAME FOR ALL FROM DRAWLIST
  !this.drawlist.dText = !drawlist

  -- activate remove gadgets if there is something to remove
  !active = (!this.drawlist.dText.size() gt 0)
  !this.remItem.active = !active
  !this.remId.active = !active
  !this.remCe.active = !active
  !this.remAll.active = !active

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      !addColour()
--
-- Description: set the add colour member
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .addColour()

  -- get the colour that has just been selected
  !this.addColour.colour(!!colourSelectGet())

  -- set the colour gadgets
  !this.colourView.background = !this.addColour.code

endmethod
-- End of method definition for .addColour()

------------------------------------------------------------------------
--
-- Method:      !rollbackEdg()
--
-- Description: update form following EDG rollback on graphics form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .rollbackEdg()

  -- unset edg packet
  !this.edgPacket = object EDGPACKET()

endmethod
-- End of method definition for .rollbackEdg()

------------------------------------------------------------------------
--
-- Method:      !removeEdg()
--
-- Description: remove EDG packet
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .removeEdg()

  -- remove edg packet (which will cause !this.rollbackEdg to be called)
  if (!this.edgPacket.type.set()) then
    !!edgCntrl.remove(!this.edgPacket)
  endif

endmethod
-- End of method definition for .removeEdg()

------------------------------------------------------------------------
--
-- Method:      !dismiss()
--
-- Description: dismiss action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .dismiss()

  -- remove the edg packet if active
  !this.removeEdg()

endmethod
-- End of method definition for .dismiss()
