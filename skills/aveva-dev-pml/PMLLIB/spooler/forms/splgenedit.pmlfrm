--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Mon Feb 2 15:01:53 GMT 1998
--
--
-- Description:
-- Edit spooling network search options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  display()                        -                   Display settings after init/load
--  init()                           -                   Initialisation
--  load()                           -                   load the defaults
--  ok()                             -                   action for ok callback
--  save()                           -                   save the settings
--  splGenEdit()                     -                   Constructor
--
------------------------------------------------------------------------

-- Define form
setup form !!splGenEdit

  !!splGenEdit.formTitle     = 'Spooling Settings'
  !!splGenEdit.iconTitle     = 'Spooling'
  !!splGenEdit.callback      = '!!splGenEdit.init()'
  !!splGenEdit.formRevision  = ' $Revision: 1.11 $ '

  -- local form data store
  member .data is SPLGENOPT

  -- Body of form definition
  bar
    add 'File' .fileMenu
  exit

  frame .netSearch 'Network Searching' at xmin ymax+0.2 width 38
    option .constraint 'Search within ' at xmin+1 ymax width 6
    option .priority   'Scan priority ' at xmin ymax+0.2 width 6
    toggle .multiway 'Search Off-legs' at xmin ymax+0.2
    -- toggle .includeFields 'Include Adjacent Field Components' at xmin ymax+0.2
  exit

  frame .splDrgOrder 'SPLDRG Member Order' at xmin.netSearch ymax+0.5 width 38
    option .numberingOrder 'Order by ' at xmin+1 ymax width 18
  exit

  button .ok     '  OK  ' at x0 ymax+0.5 ok
  button .cancel 'Cancel' at xmax form-size ymin  cancel

exit
-- End of form definition for !!splGenEdit

------------------------------------------------------------------------
--
-- Method:      !splGenEdit()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   None
--
------------------------------------------------------------------------

define method .splGenEdit()

  -- build menu bar
  !this.newMenu('fileMenu')
  !this.fileMenu.add('callback', 'Save Defaults', '!!splGenEdit.save()')
  !this.fileMenu.add('callback', 'Load Defaults', '!!splGenEdit.load()')
  !this.fileMenu.add('separator')
  !this.fileMenu.add('callback', 'Close', '!!splGenEdit.hide()')

  -- set gadget callbacks
  !this.constraint.callback = '!!splGenEdit.data.constraint(!!splGenEdit.constraint.selection())'
  !this.priority.callback = '!!splGenEdit.data.priority(!!splGenEdit.priority.selection())'
  !this.multiway.callback = '!!splGenEdit.data.multiway(!!splGenEdit.multiway.val)'
  -- !this.includeFields.callback = '!!splGenEdit.data.includeFields(!!splGenEdit.includeFields.val)'
  !this.numberingOrder.callback = '!!splGenEdit.data.numberingOrder(!!splGenEdit.numberingOrder.selection())'
  !this.okCall = '!!splGenEdit.ok()'

  !dText[1] = 'World'
  !rText[1] = 'WORL'
  !dText[2] = 'Site'
  !rText[2] = 'SITE'
  !dText[3] = 'Zone'
  !rText[3] = 'ZONE'
  !dText[4] = 'Pipe'
  !rText[4] = 'PIPE'
  !dText[5] = 'Branch'
  !rText[5] = 'BRAN'
  !this.constraint.dText = !dText
  !this.constraint.rText = !rText

  !dText.clear()
  !rText.clear()
  !dText[1] = 'Arrive'
  !rText[1] = 'PA'
  !dText[2] = 'Leave'
  !rText[2] = 'PL'
  !this.priority.dText = !dText
  !this.priority.rText = !rText

  !dText.clear()
  !rText.clear()
  !dText[1] = 'Inline then Offleg'
  !rText[1] = 'BRANCH'
  !dText[2] = 'Offleg then Inline'
  !rText[2] = 'ISODRAFT'
  !this.numberingOrder.dText = !dText
  !this.numberingOrder.rText = !rText

endmethod
-- End of method definition for .splGenEdit()

------------------------------------------------------------------------
--
-- Method:      !display()
--
-- Description: Display settings after init/load
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .display()

  -- (re)initialise form gadgets to main data settings
  !this.constraint.select('rtext', !this.data.constraint())
  !this.priority.select('rtext', !this.data.priority())
  !this.multiway.val = !this.data.multiway()
  -- !this.includeFields.val = !this.data.includeFields()
  !this.numberingOrder.select('rtext', !this.data.numberingOrder())

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: Initialisation
--
-- Method Type: Procedure
-- Arguments:
--   None
--
------------------------------------------------------------------------

define method .init()

  -- copy the current global settings and unset the global flag
  !this.data = !!splGenOpt.localCopy()

  -- initialise form gadgets to main data settings
  !this.display()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !save()
--
-- Description: save the settings
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .save()

  -- save all the data
  !this.data.save()

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      !load()
--
-- Description: load the defaults
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .load()

  -- load the data
  !this.data.load()

  -- reinitialise form gadgets to main data settings
  !this.display()

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: action for ok callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()

  -- set all the global representation options
  !this.data.copyToGlobal()

endmethod
-- End of method definition for .ok()
