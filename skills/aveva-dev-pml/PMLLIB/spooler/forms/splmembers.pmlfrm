--
-- File:            splmembers.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          C.Brown
-- Created:         Thu Jul 24 13:39:56 BST 1997
--
--
-- Description:
-- Members list for the spooler module,
-- contains gadgets specific to the creation of SPLDRG elements
-- and event driven graphics operations.
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  close()                          -                   Close method for form exit
--  findName(GADGET)                 -                   Navigate to named element
--  init()                           -                   form initialisation method
--  navigate(DBREF)                  -                   Navigate method for members list selection
--  navigate(DBREF,STRING)           -                   Navigate method for EDG pick
--  splMembers()                     -                   Constructor method for splMembers form
--
------------------------------------------------------------------------

-- Define form
setup form !!splMembers

  !!splMembers.formTitle     = 'Spooler Members'
  !!splMembers.iconTitle     = 'MEMBERS'
  !!splMembers.callback      = '!!splMembers.init()'
  !!splMembers.formRevision  = ' $Revision: 1.44 $ '

  member .isodCe     is DBREF
  member .desiCe     is DBREF
  member .currentDb  is STRING
  member .splDrg     is DBREF
  member .edgPacket  is EDGPACKET

  -- Default members list size in global variables for dynamic loading
  if (undefined(!!splMemWidth)) then
    !!splMemWidth = 22
  endif
  if (undefined(!!splMemHeight)) then
    !!splMemHeight = 10
  endif
  !activeWidth = !!splMemWidth - 4
  !frameWidth = !!splMemWidth + 5
  -- default state for extract flag in members list
  if (undefined(!!splExtractFlag)) then
    !!splExtractFlag = ''
  endif

  -- Body of form definition

  -- Define Bar Menu
  bar
    add 'Control'   .controlMenu
    add 'Goto'  .navigateMenu
    add 'Drawlist'  .drawlistMenu
  exit

  frame .database 'Members' at xmin ymax+0.2 width $!frameWidth
    button   .prev at xmin+1        ymax     pixmap width 9 height 12
    text     .find     at xmax          ymin     width $!activeWidth string
    button   .next     at xmax          ymin     pixmap width 9 height 12
    selector .dbList   at xmin.prev ymax+0.2 single width $!!splMemWidth height $!!splMemHeight database auto $!!splExtractFlag
  exit

exit
-- End of form definition for !!splMembers

------------------------------------------------------------------------
--
-- Method:      !splMembers()
--
-- Description: Constructor method for splMembers form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .splMembers()

  -- define menus (navigate menu built dynamically)
  !this.newMenu('controlMenu')
  !this.newMenu('switchMenu')
  !this.newMenu('navigateMenu')
  !this.newMenu('drawlistMenu')

  !this.controlMenu.add('menu', 'Switch', 'switchMenu')
  !this.controlMenu.add('callback', 'Resize...', 'show !!splMemResize')
  !this.controlMenu.add('separator')
  !this.controlMenu.add('callback', 'Drawlist...', 'show !!splDrawlist')
  !this.controlMenu.add('separator')
  !this.controlMenu.add('toggle', 'Show Extract Claims', '!!spooler.functions.extractClaims(')
  !this.controlMenu.add('separator')
  !this.controlMenu.add('callback', 'Close', '!!splMembers.close()')

  !this.switchMenu.add('toggle', 'Fabrication', '!!spooler.functions.dbSwitch(')
  !this.switchMenu.add('toggle', 'Design', '!!spooler.functions.dbSwitch(')

  !this.drawlistMenu.add('callback', 'Add CE', |!!splDrawlistAdd('CE', 0)|)
  !this.drawlistMenu.add('callback', 'Add Owner', |!!splDrawlistAdd('OWNER', 0)|)
  !this.drawlistMenu.add('callback', 'Add CE with Colour...', |!!colourSelectLoad('!!splDrawlistAdd(''CE'', !!colourSelect.setColour)', 'Add Current Element', REAL())|)
  !this.drawlistMenu.add('separator')
  !this.drawlistMenu.add('callback', 'Remove CE', ' REMOVE CE')
  !this.drawlistMenu.add('callback', 'Remove Owner', 'REMOVE OWNER')
  !this.drawlistMenu.add('callback', 'Remove All', 'REMOVE ALL')

  !this.prev.addPixmap(!!pml.getPathName('leftarrow9x12.png'))
  !this.next.addPixmap(!!pml.getPathName('rightarrow9x12.png'))

  -- set callbacks
  !this.cancelCall        = '!!splMembers.close()'

  !this.prev.callback = 'PREVIOUS'
  !this.next.callback     = 'NEXT'
  !this.find.callback     = '!!splMembers.findName(!!splMembers.find)'
  !this.dbList.callback   = '!!splMembers.navigate(!!splMembers.dbList.selection().dbRef())'

endmethod
-- End of method definition for .splMembers()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: form initialisation method
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .init()

  -- initialise state of extract claim marker
  if( undefined(!!showMemExtracts) ) then
    !!showMemExtracts = false
  endif
  !this.controlMenu.select(|Show Extract Claims|,!!showMemExtracts)

  !!spooler.functions.linkMembers(!this)

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !navigate(DBREF)
--
-- Description: Navigate method for members list selection
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF] [Element to navigate to]
--
------------------------------------------------------------------------

-- Define method
define method .navigate(!element is DBREF)

  if (!element.type eq 'WORL' and !element.dbType ne !!splMembers.currentDb) then
    !!ce = WORLD
  elseif (!element ne !!ce) then
    !!ce = !element
  else
    -- element is same as current element, there is nothing to do
  endif

endmethod
-- End of method definition for .navigate(DBREF)

------------------------------------------------------------------------
--
-- Method:      !navigate(DBREF,STRING)
--
-- Description: Navigate method for EDG pick
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF]  [Element picked]
--   [2] [R] [STRING] [Tubing indicator]
--
------------------------------------------------------------------------

-- Define method
define method .navigate(!element is DBREF, !pickType is STRING)

  if (!pickType eq 'TUBING') then
    !!ce = ILEAVE TUBE OF $!element
  else
    !!ce = !element
  endif

endmethod
-- End of method definition for .navigate(DBREF, STRING)

------------------------------------------------------------------------
--
-- Method:      !findName()
--
-- Description: Navigate to named element
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [GADGET] [Text gadget holding element to navigate to]
--
------------------------------------------------------------------------

-- Define method
define method .findName(!name is GADGET)

  call !!nameGadget(!name, 'OLD')
  if (!name.val ne 'unset') then
    !!ce = !name.val.dbRef()
    !name.clear()
  endif

endmethod
-- End of method definition for .findName(GADGET)

------------------------------------------------------------------------
--
-- Method:      !close()
--
-- Description: Close method for form exit
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .close()

  -- remove the edg packet if form is closed while a pick is active
  --  !this.removeEdg()

  !!spooler.functions.unlinkMembers()

  !!splMembers.hide()

endmethod
-- End of method definition for .close()
