--
-- File:            splmeminclu.pmlfrm
--   Type:          Form Definition
--   Group:         Members list routines
--     Keyword:     MBL
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Thu Mar 26 08:26:27 GMT 1998
--
--
-- Description:
-- Include elements into member in splmembers form
--
-- Commented out [move to end] style - still uses before/after option
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   apply action
--  dismiss()                        -                   dismiss action
--  include(DBREF)                   -                   include operation
--  init()                           -                   initialisation
--  removeEdg()                      -                   remove EDG packet
--  rollbackEdg()                    -                   update form following EDG rollback on graphics form
--  splMemInclu()                    -                   constructor
--  track(FORM,STRING)               -                   Database tracking method
--
------------------------------------------------------------------------

setup form !!splMemInclu

  !!splMemInclu.formTitle     = 'Include'
  !!splMemInclu.iconTitle     = 'Include'
  !!splMemInclu.callback      = '!!splMemInclu.init()'
  !!splMemInclu.formRevision  = ' $Revision: 1.8 $ '

  -- Body of form definition
  member .ce is DBREF

  paragraph .ceText at xmin ymax width 35

  -- string defining where to include to e.g. 'AFTER =12/3456'
  member .destination is STRING

  -- edg packet active for pick
  member .edgPacket  is EDGPACKET

  option .includeOpt 'Include ' at xmin ymax+0.2 width 10

  option .beforeAfter at xmax+1 ymin width 6

  frame .memFrame 'Members' at xmin.includeOpt ymax+0.2
    list .membList at xmin+1 ymax width 35 height 15
  exit

  button .apply ' Apply ' at xmin ymax+0.5

  button .dismiss 'Dismiss' at xmax form-size ymin cancel

  -- setup form tracking
  track |ISODCE| |DESICE| |CATACE| |PROPCE| |PADDCE| callback '!!splMemInclu.track('

exit
-- End of form definition for !!splMemInclu

------------------------------------------------------------------------
--
-- Method:      !splMemInclu()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .splMemInclu()

  -- define gadgets
  !dText = ARRAY()
  !dText[1] = 'Before'
  !dText[2] = 'After'
  !this.beforeAfter.dText = !dText

  -- set callbacks
  !this.apply.callback = '!!splMemInclu.apply()'
  !this.cancelCall = '!!splMemInclu.dismiss()'

endmethod
-- End of method definition for .splMemInclu()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .init()

  -- connect form to current element
  !this.ce = !!ce
  !this.destination = ''

  if (!this.ce.list.unset()) then
    -- 'Current element may not own other items'
    !!messageFile.error(2, 855)
  elseif (!this.ce.type eq 'SPLDRG') then
    -- 'User is not allowed to include or reorder SPLDRG members'
    !!messageFile.error(154, 114)
  endif

  !this.ceText.val = !this.ce.fullName

  -- suppress hierarchy and delete operations whilst form is active
  !!splMainBarCntrl('nodelete nohierarchy')

  -- create members list for display with dbrefs as replacement text
  !members = !this.ce.members
  !dText = !members.evaluate(OBJECT BLOCK('!members[!evalIndex].fullName.before(| of |)'))
--   !rText = !members.evaluate(OBJECT BLOCK('|BEFORE | & !members[!evalIndex].string()'))
  !rText = !members.evaluate(OBJECT BLOCK('!members[!evalIndex].string()'))

  -- add move to end option and display list
--   !dText.append('[move to end]')
--   if (!rText.size() gt 0) then
--     !rText.append(!rText.last().replace('BEFORE', 'AFTER'))
--   else
--     !rText.append('')
--   endif
  !this.membList.dText = !dText
  !this.membList.rText = !rText

  !this.track(!!splMemInclu, !!ce.dbType & 'CE')

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !track()
--
-- Description: Database tracking method
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [FORM] [Form passed by tracking mechanism]
--   [2] [R] [STRING] [Database type of current element]
--
------------------------------------------------------------------------

-- Define method
define method .track(!dummyForm is FORM, !dummyType is STRING)

  -- display allowable include options
  -- can't get here if !this.ce cannot own members
  !dText = ARRAY()

  -- include CE if not itself, CE type is in form CE's list,
  -- CE is in same db, and not already in list
  if (!this.ce ne !!ce) then
    if (!this.ce.list.findFirst(!!ce.type).set()) then
      if (!this.ce.dbName eq !!ce.dbName) then
        if (!this.ce.members.findFirst(!!ce).unset()) then
          !dText.append('CE')
        endif
      endif
    endif
  endif

  -- include CE Members if CE type matches form CE's type and is in same db
  if (!this.ce ne !!ce) then
    if (!this.ce.type eq !!ce.type) then
      if (!this.ce.dbName eq !!ce.dbName) then
        if (!!ce.members.size() gt 0) then
          !dText.append('CE Members')
        endif
      endif
    endif
  endif

  -- include Identify
  !dText.append('Pick')

  !this.includeOpt.dText = !dText

endmethod
-- End of method definition for .track(FORM, STRING)

------------------------------------------------------------------------
--
-- Method:      !apply()
--
-- Description: apply action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .apply()

  -- get position in current list to include to
--   !this.destination = !this.membList.selection()
  if (!this.membList.dText.size() eq 0) then
    !this.destination = ''
  else
    !this.destination = !this.beforeAfter.selection() & ' ' & !this.membList.selection()
  endif

  -- include CE
  if (!this.includeOpt.selection() eq 'CE') then

    -- remove the edg packet if active
    !this.removeEdg()

    !element = !!ce
    !this.include(!element)

  -- include CE Members
  elseif (!this.includeOpt.selection() eq 'CE Members') then

    -- remove the edg packet if active
    !this.removeEdg()

    do !element values !!ce.members
      !this.include(!element)
      !this.destination = 'AFTER ' & !element.string()
    enddo

  -- set edg for include by Pick
  elseif (!this.includeOpt.selection() eq 'Pick') then

    -- may already be in edg mode
    if (!this.edgPacket.type.unset()) then

      -- define an edg packet for the pick
      !packet = object EDGPACKET()
      !packet.key         = 'Include'
      !packet.description = 'Include'
      !packet.type        = 'Spooler'
      !packet.priority    = 0
      !packet.action      = '!!splMemInclu.include(!this.return[1].item)'
      !packet.remove      = false
      !packet.close       = '!!splMemInclu.rollbackEdg()'
      !packet.pickPacket.stdElement('Pick an element to be included ')
      !packet.pickPacket.picks[1].pick.input[3]   = '((type of owner) eq |BRAN| and (not(unset(sfref))))'
      !packet.pickPacket.picks[1].pick.input[5]   = '((type of owner) eq |BRAN| and (not(unset(sfref))))'
      !packet.pickPacket.picks[1].pick.modifiable = false

      -- store and activate the packet
      !this.edgPacket = !packet
      if (!!edgCntrl.add(!packet).not()) then
        !this.rollbackEdg()
      endif

    endif

  endif

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      !include()
--
-- Description: include operation
--
-- Method Type: Procedure
-- Arguments;
--  [1] [R] [DBREF]  [element to include]
--
------------------------------------------------------------------------

define method .include(!element is DBREF)

  -- do some intelligent referencing from picked item
  !includeItem = !element
  if (!element.owner.type eq 'BRAN') then
    if (!element.sfref.set()) then
      if (!this.ce.type eq 'ISOREG') then
        !includeItem = !element.sfref.owner
      elseif (!this.ce.type eq 'ISODEP') then
        !includeItem = !element.sfref.owner.owner
      endif
    endif
  endif

  -- check element can be included
  if (!this.ce ne !includeItem) then
    if (!this.ce.list.findFirst(!includeItem.type).set()) then
      if (!this.ce.dbName eq !includeItem.dbName) then
        if (!this.ce.members.findFirst(!includeItem).unset()) then

          -- include element
          !!ce = !this.ce
          INCLUDE $!includeItem $!this.destination

          -- reinitialise form
          !this.init()

        endif
      endif
    endif
  endif

endmethod
-- End of method definition for .include(DBREF)

------------------------------------------------------------------------
--
-- Method:      !rollbackEdg()
--
-- Description: update form following EDG rollback on graphics form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .rollbackEdg()

  -- display default include option
  !this.includeOpt.val = 1

  -- unset edg packet
  !this.edgPacket = object EDGPACKET()

endmethod
-- End of method definition for .rollbackEdg()

------------------------------------------------------------------------
--
-- Method:      !removeEdg()
--
-- Description: remove EDG packet
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .removeEdg()

  -- remove edg packet (which will cause !this.rollbackEdg to be called)
  if (!this.edgPacket.type.set()) then
    !!edgCntrl.remove(!this.edgPacket)
  endif

endmethod
-- End of method definition for .removeEdg()

------------------------------------------------------------------------
--
-- Method:      !dismiss()
--
-- Description: dismiss action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .dismiss()

  -- remove the edg packet if active
  !this.removeEdg()

  -- reenable hierarchy and delete operations
  !!splMainBarTrack(!!spooler, 'ISODCE')

endmethod
-- End of method definition for .dismiss()
