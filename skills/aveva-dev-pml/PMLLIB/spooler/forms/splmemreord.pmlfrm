--
-- File:            splmemreord.pmlfrm
--   Type:          Form Definition
--   Group:         Members list routines
--     Keyword:     MBL
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Thu Mar 26 08:26:27 GMT 1998
--
--
-- Description:
-- Reorder member in splmembers form
--
-- Commented out [move to end] style - still uses before/after option
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   apply reorder
--  destination()                    -                   select destination for reorder action
--  dismiss()                        -                   dismiss action
--  init()                           -                   initialisation
--  membList(DBREF)                  -                   action on select member to be reordered
--  splMemReord()                    -                   constructor
--
------------------------------------------------------------------------

setup form !!splMemReord

  !!splMemReord.formTitle     = 'Reorder Members'
  !!splMemReord.iconTitle     = 'Reorder'
  !!splMemReord.callback      = '!!splMemReord.init()'
  !!splMemReord.formRevision  = ' $Revision: 1.5 $ '

  -- Body of form definition
  member .ce is DBREF

  -- store item which selected element is initially before
  member .next is STRING

  paragraph .ceText at xmin ymax width 35

  frame .membFrame 'Reorder' at xmin ymax+0.2
    list .membList 'Members' at xmin+1 ymax+0.4 width 35 height 15
  exit

  frame .destFrame 'To' at xmax.membFrame+1 ymin
    option .beforeAfter at xmin+1 ymax width 6
    list .destination at xmin ymax+0.2 width 35 height 15
  exit

  button .apply ' Apply ' at xmin.membFrame ymax+0.5
  button .dismiss 'Dismiss' at xmax form-size ymin cancel

exit
-- End of form definition for !!splMemReord

------------------------------------------------------------------------
--
-- Method:      !splMemReord()
--
-- Description: constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .splMemReord()

  -- define gadgets
  !dText = ARRAY()
  !dText[1] = 'Before'
  !dText[2] = 'After'
  !this.beforeAfter.dText = !dText

  -- set callbacks
  !this.membList.callback = '!!splMemReord.membList(!!splMemReord.membList.selection().dbRef())'
  !this.destination.callback = '!!splMemReord.destination()'
  !this.beforeAfter.callback = '!!splMemReord.destination()'
  !this.apply.callback = '!!splMemReord.apply()'
  !this.cancelCall = '!!splMemReord.dismiss()'

endmethod
-- End of method definition for .splMemReord()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .init()

  -- suppress hierarchy and delete operations whilst form is active
  !!splMainBarCntrl('nodelete nohierarchy')

  -- connect form to current element
  !this.ce = !!ce
  !this.ceText.val = !this.ce.fullName

  -- create members list for display with dbrefs as replacement text
  !members = !this.ce.members
  !this.membList.dText = !members.evaluate(OBJECT BLOCK('!members[!evalIndex].fullName.before(| of |)'))
  !this.membList.rText = !members.evaluate(OBJECT BLOCK('!members[!evalIndex].string()'))

  -- display destination list for first member
  !this.membList(!this.membList.selection().dbRef())

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !membList()
--
-- Description: action on select member to be reordered
--
-- Method Type: Procedure
-- Arguments;
--  [1] [R] [DBREF] [element to be reordered]
--
------------------------------------------------------------------------

define method .membList(!element is DBREF)

  -- get current list, get member index after selected member, exclude ce
  !members = !this.ce.members
  !elementIndex = !members.findFirst(!element)
  !members.remove(!elementIndex)

  -- create members list for display with dbrefs as replacement text
  !dText = !members.evaluate(OBJECT BLOCK('!members[!evalIndex].fullName.before(| of |)'))
--   !rText = !members.evaluate(OBJECT BLOCK('|BEFORE | & !members[!evalIndex].string()'))
  !rText = !members.evaluate(OBJECT BLOCK('!members[!evalIndex].string()'))

  -- add move to end option and display list
--   !dText.append('[move to end]')
--   if (!rText.size() gt 0) then
--     !rText.append(!rText.last().replace('BEFORE', 'AFTER'))
--   else
--     !rText.append('')
--   endif
  !this.destination.dText = !dText
  !this.destination.rText = !rText

  -- elementIndex now points to element after that selected
  -- store text for initial situation and deactivate apply button
--   !this.next = !rText[!elementIndex]
--   !this.destination.select('RTEXT', !this.next)
  if (!elementIndex gt !this.destination.rText.size()) then
    !this.next = 'After ' & !rText.last()
    !this.beforeAfter.select('DTEXT', 'After')
    !this.destination.select('RTEXT', !rText.last())
  else
    !this.next = 'Before ' & !rText[!elementIndex]
    !this.beforeAfter.select('DTEXT', 'Before')
    !this.destination.select('RTEXT', !rText[!elementIndex])
  endif
  !this.apply.active = false

endmethod
-- End of method definition for .membList(DBREF)

------------------------------------------------------------------------
--
-- Method:      !destination()
--
-- Description: select destination for reorder action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .destination()

  -- deactivate apply button until valid position selected
--   !this.apply.active = (!this.destination.selection() ne !this.next)
  !this.apply.active = (!this.beforeAfter.selection() & ' ' & !this.destination.selection() ne !this.next)

endmethod
-- End of method definition for .destination()

------------------------------------------------------------------------
--
-- Method:      !apply()
--
-- Description: apply reorder
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .apply()

  -- reorder it
  !!ce = !this.ce
  !member = !this.membList.selection()
--   !destination = !this.destination.selection()
  if (!this.destination.dText.size() eq 0) then
    !destination = ''
  else
    !destination = !this.beforeAfter.selection() & ' ' & !this.destination.selection()
  endif
  REORDER $!member $!destination

  -- rebuild lists
  !this.init()

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      !dismiss()
--
-- Description: dismiss action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .dismiss()

  -- reenable hierarchy and delete operations
  !!splMainBarTrack(!!spooler, 'ISODCE')

endmethod
-- End of method definition for .dismiss()
