-- File:            splmemresize.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Wed Jan 21 08:04:31 GMT 1998
--
--
-- Description:
-- Resize spooler members list
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  default()                        -                   Reset defaults for Spool members resize form
--  init()                           -                   Initialisation for Spool members resize form
--  rangeCheck(GADGET,REAL,REAL)     -                   Preserve sensible minimum members list size
--  resize()                         -                   Regenerate Spool members form with new size
--  splMemResize()                   -                   Constructor for Spool members resize form
--
------------------------------------------------------------------------

-- Define form
setup form !!splMemResize

  !!splMemResize.formTitle     = 'Resize'
  !!splMemResize.iconTitle     = 'Resize'
  !!splMemResize.callback      = '!!splMemResize.init()'
  !!splMemResize.formRevision  = ' $Revision: 1.10 $ '

  -- Integer format object must be global variable
  !!splMemResizeFmt = object FORMAT()
  !!splMemResizeFmt.dp = 0

  -- Body of form definition
  bar
    add |Control| .controlMenu
  exit

  text .width  |Width  | at xmin+2 ymax+0.5 width 3 is REAL format !!splMemResizeFmt
  text .height |Height | at xmin ymax+0.5 width 3 is REAL format !!splMemResizeFmt

  button .ok |  OK  | at xmin-2 ymax+0.5 ok
  button .cancel |Cancel| at xmax+2 ymin cancel

exit
-- End of form definition for !!splMemResize

------------------------------------------------------------------------
--
-- Method:      !splMemResize()
--
-- Description: Constructor for Spool members resize form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .splMemResize()

  !this.newMenu('controlMenu')
  !this.controlMenu.add('callback', 'Defaults', '!!splMemResize.default()')

  !this.okCall = '!!splMemResize.resize()'
  !this.width.callback = '!!splMemResize.rangeCheck(!!splMemResize.width, 20, 60)'
  !this.height.callback = '!!splMemResize.rangeCheck(!!splMemResize.height, 5, 20)'

endmethod
-- End of method definition for .splMemResize()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: Initialisation for Spool members resize form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .init()

  -- Display current settings
  !this.width.val = !!splMemWidth
  !this.height.val = !!splMemHeight

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !default()
--
-- Description: Reset defaults for Spool members resize form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .default()

  -- Display default settings
  !this.width.val = 22
  !this.height.val = 10

endmethod
-- End of method definition for .default()

------------------------------------------------------------------------
--
-- Method:      !resize()
--
-- Description: Regenerate Spool members form with new size
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .resize()

  -- Use new settings to rebuild Spool members
  !!splMemWidth = !this.width.val
  !!splMemHeight = !this.height.val

  -- Must tidy up any splmembers EDG modes
  !!splMembers.close()
  kill !!splMembers
  show !!splMembers free at xr 0 yr 0.1

endmethod
-- End of method definition for .resize()

------------------------------------------------------------------------
--
-- Method:      !rangeCheck()
--
-- Description: Preserve sensible minimum members list size
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [Real] [One end of range]
--   [2] [R] [Real] [Other end of range]
--
------------------------------------------------------------------------

define method .rangeCheck(!gadget is GADGET, !firstLimit is REAL, !secondLimit is REAL)

  -- min and max of range can be in any order
  !minValue = MIN(!firstLimit, !secondLimit)
  !maxValue = MAX(!secondLimit, !firstLimit)
  !gadget.val = MIN(!maxValue, max(!minValue, !gadget.val))

endmethod
-- End of method definition for .rangeCheck(GADGET, REAL, REAL)
