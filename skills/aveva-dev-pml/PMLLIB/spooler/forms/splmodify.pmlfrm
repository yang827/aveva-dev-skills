--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Wed Feb 18 09:03:56 GMT 1998
--
--
-- Description:
-- Modify splDrg including asbuilt data for all numbering
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Cancel method
--  ce()                             DBREF               links form to the current element
--  check()                          -                   check which numbering data can be modified
--  display(DBREF)                   -                   Update attribute display following modification
--  init()                           -                   Form initialisation on show action
--  listData(DBREF)                  -                   Display attribute data for splDrg
--  modify(STRING,BOOLEAN)           -                   modify numbering data
--  modifyAtts()                     -                   modify splDrg attributes
--  objectInit(DBREF)                -                   initialise numbering object data
--  setAttribute(DBREF,STRING,BOOLEAN) -                   boolean attribute setting from user input
--  setAttribute(DBREF,STRING,REAL)  -                   real attribute setting from user input
--  setAttribute(DBREF,STRING,STRING) -                   string attribute setting from user input
--  splModify()                      -                   Constructor method for form object
--  validate(DBREF,STRING,BOOLEAN)   BOOLEAN             validated boolean attribute setting from user input
--  validate(DBREF,STRING,REAL)      BOOLEAN             validated real attribute setting from user input
--  validate(DBREF,STRING,STRING)    BOOLEAN             validated string attribute setting from user input
--
------------------------------------------------------------------------
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***

-- Define form
setup form !!splModify

  !!splModify.formTitle     = 'Display/Modify SPLDRG'
  !!splModify.iconTitle     = 'Modify'
  !!splModify.callback      = '!!splModify.init()'
  !!splModify.formRevision  = ' $Revision: 1.22 $ '

  -- Body of form definition

  -- element current to the form
  member .ce is DBREF

  -- object so calling function can display data for lower element
  -- since we cannot show the asBuilt form whilst trying to show this
  member .specificObject is STRING

  -- attribute list for splDrg elements
  member .splDrgAtts is SPLATTRIBUTES

  -- members used to access all numbering operations
  member .spoolN is SPLSPOOLN
  member .fieldN is SPLFIELDN
  member .weldN  is SPLWELDN
  member .jointN is SPLJOINTN
  member .partN  is SPLPARTN
  member .bendN  is SPLBENDN

  -- members used to suppress modification of numbering objects not up to date
  member .modifySpoolN is BOOLEAN
  member .modifyFieldN is BOOLEAN
  member .modifyWeldN  is BOOLEAN
  member .modifyJointN is BOOLEAN
  member .modifyPartN  is BOOLEAN
  member .modifyBendN  is BOOLEAN

  -- members to control numbering object displayed by !!splAsBuilt form
  member .objectName is STRING
  member .objectModify is BOOLEAN

  -- members to store previous attribute selections and edit form history
  member .selectIndex is REAL
  member .editForm is FORM

  -- form gadgets

  -- CE button, initialises form to the current element
  button .setCe 'CE' at xmin ymax

  -- gadget to display name of forms current element
  paragraph .ceText at xmax+1 ymin width 30 lines 2

  -- splDrg attribute data
  frame .atts 'Spldrg Attributes' at xmin.setCe ymax+0.2 width 38
    list .modifyAtts at xmin+1 ymax width 33 height 6
  exit

  -- gadgets to control modification of numbering
  frame .modifying 'Element Data' at xmin.setCe ymax+0.5 width 38
    button .modifyField ' Field Data...  ' at xmin+1 ymax
    button .modifySpool ' Spool Data...  ' at xmin ymax+0.2
    button .modifyWeld  ' Weld Data...   ' at xmin ymax+0.2
    button .modifyJoint ' Joint Data...  ' at xmax+2 ymin.modifyField
    button .modifyPart  ' Part Numbers...' at xmin ymax+0.2
    button .modifyBend  ' Bend Numbers...' at xmin ymax+0.2
  exit

  -- form dismiss gadget
  button .dismiss 'Dismiss' at xmax form-size ymax+0.5 cancel

exit
-- End of form definition for !!splModify

------------------------------------------------------------------------
--
-- Method:      !splModify()
--
-- Description: Constructor method for form object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .splModify()

  -- set gadget callbacks
  !this.setCe.callback = '!!splModify.init()'
  !this.modifyAtts.callback = '!!splModify.modifyAtts()'
  !this.modifyField.callback = '!!splModify.modify(|fieldN|, !!splModify.modifyFieldN)'
  !this.modifySpool.callback = '!!splModify.modify(|spoolN|, !!splModify.modifySpoolN)'
  !this.modifyWeld.callback = '!!splModify.modify(|weldN|, !!splModify.modifyWeldN)'
  !this.modifyJoint.callback = '!!splModify.modify(|jointN|, !!splModify.modifyJointN)'
  !this.modifyPart.callback = '!!splModify.modify(|partN|, !!splModify.modifyPartN)'
  !this.modifyBend.callback = '!!splModify.modify(|bendN|, !!splModify.modifyBendN)'
  !this.cancelCall = '!!splModify.cancel()'

endmethod
-- End of method definition for .splModify()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: Form initialisation on show action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .init()

  -- form interlocking
  if (defined(!!splUpdate)) then
    if (!!splUpdate.shown()) then
      -- 'Modify not allowed whilst Update form is active.'
      !!messageFile.error(154, 1)
    endif
  endif
  if (defined(!!splRenumber)) then
    if (!!splRenumber.shown()) then
      -- 'Modify not allowed whilst Renumber form is active.'
      !!messageFile.error(154, 2)
    endif
  endif

  -- connect the form to current element
  !originalElement = !this.ce()

  -- activate allowable numbering modification buttons
  !this.check()

  -- list splDrg attributes
  !this.listData(!this.ce)

  -- initialise numbering object data
  !this.objectInit(!originalElement)

  !this.selectIndex = !this.modifyAtts.val
  !this.editForm = object FORM()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !ce()
--
-- Description: links form to the current element
--
-- Method Type: Function
-- Returns:
--  [DBREF]  [original element at or below splDrg]
--
------------------------------------------------------------------------

-- Define method
define method .ce() is DBREF

  -- store original element
  !element = !!ce

  -- link the form and the numbering objects to the current element spldrg
  !this.ce = !!spldrg()
  if (substring(!this.ce.namn,1,1) EQ '=') then
     !this.ceText.val = !this.ce.flnn
  else
     !this.ceText.val = !this.ce.namn
  endif

  -- set the current element for each numbering object
  !this.fieldN.ce(!this.ce)
  !this.spoolN.ce(!this.ce)
  !this.weldN.ce(!this.ce)
  !this.jointN.ce(!this.ce)
  !this.partN.ce(!this.ce)
  !this.bendN.ce(!this.ce)

  -- retain original ce
  !!ce = !element
  return !element

endmethod
-- End of method definition for .ce() DBREF

------------------------------------------------------------------------
--
-- Method:      !objectInit()
--
-- Description: initialise numbering object data
--
-- Method Type: Procedure
--  Arguments:
--   [1]  [R]  [DBREF]  [Element at or below splDrg]
--
------------------------------------------------------------------------

-- Define method
define method .objectInit(!element is DBREF)

  -- initialise numbering object data
  !this.specificObject = STRING()
  !splWeldTypes = 'AWELD IWELD RWELD'

  -- check if we started at an element appropriate for numbering data
  -- beware owner check below (can't get this far if started at world)

  if (!element.type eq 'SPOOL' and !this.modifySpool.active) then
    if (!element.owner eq !this.ce) then
      !this.specificObject = 'spoolN'
      !this.objectModify = !this.modifySpoolN
    endif

  elseif (!element.type eq 'FIELD' and !this.modifyField.active) then
    if (!element.owner eq !this.ce) then
      !this.specificObject = 'fieldN'
      !this.objectModify = !this.modifyFieldN
    endif

  elseif (!element.type eq 'WLDGRP' and !this.modifyWeld.active) then
    if (!element.owner eq !this.ce) then
      !this.specificObject = 'weldN'
      !this.objectModify = !this.modifyWeldN
    endif

  elseif (!splWeldTypes.match(!element.type) gt 0 and !this.modifyWeld.active) then
    if (!element.owner.owner eq !this.ce) then
      !this.specificObject = 'weldN'
      !this.objectModify = !this.modifyWeldN
    endif

  elseif (!element.type eq 'WELD' and !this.modifyWeld.active) then
    if (!element.wldref.unset().not()) then
      if (!element.wldref.owner.owner eq !this.ce) then
        !this.specificObject = 'weldN'
        !this.objectModify = !this.modifyWeldN
      endif
    endif

  elseif (!element.type eq 'JNTGRP' and !this.modifyJoint.active) then
    if (!element.owner eq !this.ce) then
      !this.specificObject = 'jointN'
      !this.objectModify = !this.modifyJointN
    endif

  elseif (!element.type eq 'IJOINT' and !this.modifyJoint.active) then
    if (!element.owner.owner eq !this.ce) then
      !this.specificObject = 'jointN'
      !this.objectModify = !this.modifyJointN
    endif

  elseif (!element.owner.type eq 'BRAN' and !this.modifyPart.active) then
    if (!element.sfref.unset().not()) then
      if (!element.sfref.owner eq !this.ce) then
        !this.specificObject = 'partN'
        !this.objectModify = !this.modifyPartN
      endif
    endif

  endif

  -- would like to display form here but cannot (yet) so called in splmodify.pml
  -- !this.modify(!this.specificObject, !this.objectModify)

endmethod
-- End of method definition for .objectInit(DBREF)

------------------------------------------------------------------------
--
-- Method:      !check()
--
-- Description: check which numbering data can be modified
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .check()

  -- check if SPLDRG needs aligning and updating
  -- global numbering options control which checks are made

  -- grey out modification of numbering data that is not being maintained
  !this.modifyField.active = !!splNumOpt.fields()
  !this.modifySpool.active = !!splNumOpt.spools()
  !this.modifyWeld.active  = !!splNumOpt.welds()
  !this.modifyJoint.active = !!splNumOpt.joints()
  !this.modifyPart.active  = !!splNumOpt.parts()
  !this.modifyBend.active  = !!splNumOpt.bends()

  -- disallow modification of numbering data that is not up to date
  !this.modifyFieldN = false
  !this.modifySpoolN = false
  !this.modifyWeldN  = false
  !this.modifyJointN = false
  !this.modifyPartN  = false
  !this.modifyBendN  = false

  if (!this.spoolN.alignReqd().not()) then

    if (!!splNumOpt.fields()) then
      !this.modifyFieldN = true
    endif

    if (!!splNumOpt.spools()) then
      !this.modifySpoolN = !this.spoolN.updateReqd().not()
    endif

    if (!!splNumOpt.welds()) then
      !weldJointAlign = !this.weldN.alignReqd()
      if (!weldJointAlign.not()) then
        !this.modifyWeldN = !this.weldN.updateReqd().not()
      endif
    endif

    if (!!splNumOpt.joints()) then
      -- welds and joints alignment are checked together
      if (!!splNumOpt.welds().not()) then
        !weldJointAlign = !this.jointN.alignReqd()
      endif
      if (!weldJointAlign.not()) then
        !this.modifyJointN = !this.jointN.updateReqd().not()
      endif
    endif

    if (!!splNumOpt.parts()) then
      !this.modifyPartN = !this.partN.updateReqd().not()
    endif

    if (!!splNumOpt.bends()) then
      !this.modifyBendN = !this.bendN.updateReqd().not()
    endif

  endif

endmethod
-- End of method definition for .check()

------------------------------------------------------------------------
--
-- Method:      !modifyAtts()
--
-- Description: modify splDrg attributes
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .modifyAtts()

  -- define new line character
!nl ='
'
  !value = ''
  -- Handle multi line text selections
  !strSz = !this.splDrgAtts.getAttributes(!this.ce).attributes.width() + 2
  !slcRtxt = !this.modifyAtts.selection('RTEXT')
  !getRtxt = !this.modifyAtts.rText.find(!slcRtxt)
  if (!getRtxt.size() GT 1) then
     do !j indices !getRtxt
        !dtxt = !this.modifyAtts.dText[!getRtxt[!j]]
        !value = !value + substring(!dtxt,!strSz,!dtxt.length()) + !nl
     enddo
  else
     !value = !this.modifyAtts.selection('DTEXT').after(':').trim()
  endif

  -- Get attribute data to be modified
  !attribute = !this.modifyAtts.selection('RTEXT').after(':').trim()
  !dataType = !this.modifyAtts.selection('RTEXT').before(':').trim()

  -- Attributes for info only
  !infoAttList = 'SMAXIMUM WMAXIMUM JMAXIMUM PMAXIMUM BMAXIMUM'
  if (!infoAttList.match(!attribute.upcase()) gt 0) then
    -- 'Attribute #attribute may not be modified'
    !!alert.warning('Attribute $!attribute may not be modified')
    !this.modifyAtts.val = !this.selectIndex
    if (!this.editForm.unset().not()) then
       --show the previous edit form
       !this.editForm.show()
  endif
  else
  -- Attributes requiring validation of user value
  !validateAttList = 'XXXXXXXXXX'
  !validate = false
  if (!validateAttList.match(!attribute.upcase()) gt 0) then
    !validate = true
  endif

  -- Invoke modification form
     !this.selectIndex = !this.modifyAtts.val
  !!splAttModify(!this, !this.ce, !attribute, !value, !dataType, !validate)
  endif
endmethod
-- End of method definition for .modifyAtts()

------------------------------------------------------------------------
--
-- Method:      !modify()
--
-- Description: modify numbering data
--
-- Method Type: Procedure
-- Arguments:
--  [1] [R] [STRING]  [Name of numbering object to perform modification]
--  [2] [R] [BOOLEAN] [Flag controlling object modification]
--
------------------------------------------------------------------------

-- Define method
define method .modify(!objectName is STRING, !objectModify is BOOLEAN)

  -- if splAsBuilt already shown, first tidy up its graphics, then hide it
  if (defined(!!splAsBuilt)) then
    if (!!splAsBuilt.shown()) then
      !!splAsBuilt.dismiss()
      !!splAsBuilt.hide()
    endif
  endif

  -- Set appropriate object and show form
  !this.objectName   = !objectName
  !this.objectModify = !objectModify
  show !!splAsBuilt at xr 0 yr 0.6

endmethod
-- End of method definition for .modify(STRING, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !listData()
--
-- Description: Display attribute data for splDrg
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF] [Element to retrieve attributes from]
--
------------------------------------------------------------------------

-- Define method
define method .listData(!element is DBREF)

  -- initialise local array for list values
  !values[1]   = ARRAY()
  !values[2]   = ARRAY()

  -- get attribute data
  !data = !this.splDrgAtts.getAttributes(!element)
  -- define new line char
!nl='
'
   --size large string in the array
   !attLrgSz = !data.attributes.width()
   --define space char.s
   !spaceChr = '                   '
   --define display format for attributes
   !dspFormt = SUBSTRING(!spaceChr,1,!attLrgSz + 1)
   --check the name attribute is set
   !nameSet = false
   if (substring(!element.namn,1,1) NE '=') then
      !nameSet = true
   endif
   -- initialise array index for rtext and dtext of gadget modifyAtts to 1
   !id = 1
  -- loop through the list of attributes and copy values to return array
  do !j indices !data.attributes

      !attribute = SUBSTRING(!data.attributes[!j] + !spaceChr,1,!attLrgSz)

      --split multi-line string attribute value into an array
      !valStr = !data.values[!j].string().split(!nl)
      !valType= !data.values[!j].objectType().string()
      if (not !valStr.empty()) then
         if (!data.attributes[!j].upcase() eq 'NAME') then
            if (not !nameSet) then
               !values[1][!id] = !attribute + ':' + 'unset'
            else
               !values[1][!id] = !attribute + ':' + substring(!element.namn,1,!element.namn.string().length())
            endif
         elseif (!valStr[1] EQ '') then
            !values[1][!id] = !attribute + ':' + 'unset'
         else
            !values[1][!id] = !attribute + ':' + !valStr[1]
         endif
      else
         !values[1][!id] = !attribute + ':' + 'unset'
      endif
      !values[2][!id] = !valType.upcase() + ':' + !attribute.upcase()
      !id = (!id + 1)

      if (!valStr.size() gt 1) then
         do !k from 2 to !valStr.size()
            if ((not !valStr[!k].empty()) and (!valStr[!k] NE '')) then
               !values[1][!id] = !dspFormt + !valStr[!k]
               !values[2][!id] = !valType.upcase() + ':' + !attribute.upcase()
               !id = !id + 1
            endif
  enddo
      endif
   enddo

  -- Rebuild list
  !this.modifyAtts.dText = !values[1]
  !this.modifyAtts.rText = !values[2]

endmethod
-- End of method definition for .listData(DBREF)

------------------------------------------------------------------------
--
-- Method:      !display()
--
-- Description: Update attribute display following modification
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF] [Element to display data for]
--
------------------------------------------------------------------------

-- Define method
define method .display(!element is DBREF)

  -- This method is called from the attribute modification forms
  -- (splStringAtt, splRealAtt, splBooleanAtt) when ok'd

  -- for this form, simply relist attribute data, keeping selection
  !selection = !this.modifyAtts.val
  !this.listData(!element)
  !this.modifyAtts.val = !selection

endmethod
-- End of method definition for .display(DBREF)

------------------------------------------------------------------------
