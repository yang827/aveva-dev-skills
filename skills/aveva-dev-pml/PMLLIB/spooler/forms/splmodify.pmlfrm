------------------------------------------------------------------------
--
-- Method:      !cancel()
--
-- Description: Cancel method
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .cancel()

  -- dismiss asbuilt modify if active
  -- it may be a child form or it may be called from function !!splModify
  if (defined(!!splAsBuilt)) then
    if (!!splAsBuilt.shown()) then
      !!splAsBuilt.dismiss()
      !!splAsBuilt.hide()
    endif
  endif

endmethod
-- End of method definition for .cancel()
