--
--
-- Description:
-- Set MTO status attributes
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   MTO status setting
--  ce(BOOLEAN)                      -                   Check current element
--  dismiss()                        -                   Tidy up
--  getBranchMto(DBREF)              STRING              Get MTO status for components in branch
--  getCompMto(DBREF)                STRING              Get MTO status for single component or implied tube
--  getPipeMto(DBREF)                STRING              Get MTO status for components in pipe
--  getSpldrgMto(DBREF)              STRING              Get MTO status for components in SPLDRG
--  getSpoolMto(DBREF)               STRING              Get MTO status for components in SPOOL or FIELD
--  init()                           -                   MTO status initialisation
--  markCe(BOOLEAN)                  -                   Mark or unmark form CE
--  mtoc()                           -                   Check if apply button valid for selected status
--  next()                           -                   Reinitialise form for next member
--  previous()                       -                   Reinitialise form for previous member
--  setBranchMto(DBREF,STRING)       -                   Set MTO status for components in branch
--  setCompMto(DBREF,STRING)         -                   Set MTO status for single component or implied tube
--  setPipeMto(DBREF,STRING)         -                   Set MTO status for components in pipe
--  setSpldrgMto(DBREF,STRING)       -                   Set MTO status for components in SPLDRG
--  setSpoolMto(DBREF,STRING)        -                   Set MTO status for components in SPOOL or FIELD
--  splMtoStatus()                   -                   Constructor
--  track(FORM,STRING)               -                   Database tracking method
--
------------------------------------------------------------------------
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--

-- Define form
setup form !!splMtoStatus

  !!splMtoStatus.formTitle     = 'Set MTO status on isometric'
  !!splMtoStatus.iconTitle     = 'MTO status'
  !!splMtoStatus.callback      = '!!splMtoStatus.init()'
  !!splMtoStatus.formRevision  = ' $Revision: 1.22 $ '

  -- Body of form definition
  member .ce is DBREF
  member .marked is BOOLEAN
  member .ceMtoc is STRING

  -- Forms current element buttons and display
  frame .ceFrame 'Piping components' at xmin ymax
    button .previous at xmin+1 ymax pixmap height 16 width 16
    paragraph .ceText at xmax+1 ymin width 45 lines 2
    button .next at xmax+1 ymin pixmap height 16 width 16
  exit

  -- Option for MTOC setting
  frame .pipeFrame 'Drawing and MTO status' at xmin.ceFrame ymax+0.5
    option .mtoc at xmin+1 ymax width 49
  exit

  button .apply   ' Apply ' at xmin form ymax+0.5 apply
  button .dismiss 'Dismiss' at xmax form-size ymin cancel

  -- setup form tracking
  track |ISODCE| |DESICE| callback '!!splMtoStatus.track('

exit

-- End of form definition for !!splMtoStatus

------------------------------------------------------------------------
--
-- Method:      !splMtoStatus()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .splMtoStatus()

  -- MTOC options
  !mtoDtext = ARRAY()
  !mtoDtext[1] = |Drawn solid and dimensioned,    included in MTO|
  !mtoDtext[2] = |Drawn solid and dimensioned,    excluded from MTO|
  !mtoDtext[3] = |Drawn dotted and dimensioned,   excluded from MTO|
  !mtoDtext[4] = |Drawn dotted and undimensioned, excluded from MTO|
  !mtoDtext[5] = |Mixed settings|
  !mtoRtext = ARRAY()
  !mtoRtext[1] = |ON|
  !mtoRtext[2] = |OFF|
  !mtoRtext[3] = |DOTD|
  !mtoRtext[4] = |DOTU|
  !mtoRtext[5] = |mixed|
  !this.mtoc.dText = !mtoDtext
  !this.mtoc.rText = !mtoRtext

  -- callbacks
  !this.previous.callback = '!!splMtoStatus.previous()'
  !this.next.callback = '!!splMtoStatus.next()'
  !this.mtoc.callback = '!!splMtoStatus.mtoc()'
  !this.apply.callback = '!!splMtoStatus.apply()'
  !this.cancelCall = '!!splMtoStatus.dismiss()'

  -- pixmaps
  !this.previous.addPixmap(!!pml.getPathName('leftarrow16.png'))
  !this.next.addPixmap(!!pml.getPathName('rightarrow16.png'))

endmethod
-- End of method definition for .splMtoStatus()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: MTO status initialisation
--
-- Method Type: Procedure
-- Arguments:
--   None
--
------------------------------------------------------------------------

define method .init()

  -- error if current element is inappropriate
  !this.ce(true)

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !ce()
--
-- Description: Check current element
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [True if errors to be output]
--
------------------------------------------------------------------------

define method .ce(!report is BOOLEAN)

  -- Beware of owner check at world
  if (!!ce.type eq 'WORL') then
    if (!report) then
      -- 'Must be at Piping or Spool Drawing element'
      !!messageFile.error(154, 111)
    endif
    return error 1 noalert
  endif

  -- Find suitable element for initialisation
  if (match('SPOOL FIELD SPLDRG BRAN PIPE', !!ce.type) eq 0) then
    if (!!ce.owner.type ne 'BRAN') then
      if (!report) then
        -- 'Must be at Piping or Spool Drawing element'
        !!messageFile.error(154, 111)
      endif
      return error 1 noalert
    endif
  endif

  -- Connect appropriate CE to form
  !this.markCe(false)
  !this.ce = !!ce
  !this.ceText.val = !this.ce.fullName
  !this.markCe(true)

  -- Display MTO status if available
  if (!this.ce.type eq 'SPOOL' or !this.ce.type eq 'FIELD') then
    !mtoStatus = !this.getSpoolMto(!this.ce)
  elseif (!this.ce.type eq 'SPLDRG') then
    !mtoStatus = !this.getSpldrgMto(!this.ce)
  elseif (!this.ce.type eq 'PIPE') then
    !mtoStatus = !this.getPipeMto(!this.ce)
  elseif (!this.ce.type eq 'BRAN') then
    !mtoStatus = !this.getBranchMto(!this.ce)
  elseif (!this.ce.owner.type eq 'BRAN') then
    !mtoStatus = !this.getCompMto(!this.ce)
    !!ce = !this.ce
  endif

  -- May be nothing to detail
  if (!mtoStatus eq 'unset') then
    -- 'No piping material'
    !!messageFile.error(154, 112)
  elseif ( !mtoStatus inset(|ON|, |OFF|, |DOTD|, |DOTU|, |mixed|) ) then
    !this.mtoc.select('RTEXT', !mtoStatus)
  endif

  -- Store initial value
  !this.ceMtoc = !mtoStatus

  -- Validate apply button
  !this.mtoc()

endmethod
-- End of method definition for .ce(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !track()
--
-- Description: Database tracking method
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [FORM] [Form passed by tracking mechanism]
--   [2] [R] [STRING] [Database type of current element]
--
------------------------------------------------------------------------

-- Define method
define method .track(!dummyForm is FORM, !dummyType is STRING)

  -- no error if current element is inappropriate
  !this.ce(false)

endmethod
-- End of method definition for .track(FORM, STRING)

------------------------------------------------------------------------
--
-- Method:      !previous()
--
-- Description: Reinitialise form for previous member
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .previous()

  -- Initialise for previous member
  !!ce = !this.ce
  !tryPrev = true

  -- Try arrive tube
  if (!!ce.type ne 'TUBI') then
    IARRIVE TUBE
    handle any
    elsehandle none
      !tryPrev = false
      !this.init()
    endhandle
  endif

  -- Try component
  if (!tryPrev) then
    PREVIOUS
    handle any
      !!alert.error(!!error.text)
    elsehandle none
      !this.init()
    endhandle
  endif

endmethod
-- End of method definition for .previous()

------------------------------------------------------------------------
--
-- Method:      !next()
--
-- Description: Reinitialise form for next member
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .next()

  -- Initialise for next member
  !!ce = !this.ce
  !tryNext = true

  -- Try leave tube
  if (!!ce.type ne 'TUBI') then
    ILEAVE TUBE
    handle any
    elsehandle none
      !tryNext = false
      !this.init()
    endhandle
  endif

  -- Try component
  if (!tryNext) then
    NEXT
    handle any
      !!alert.error(!!error.text)
    elsehandle none
      !this.init()
    endhandle
  endif

endmethod
-- End of method definition for .next()

------------------------------------------------------------------------
--
-- Method:      !markCe()
--
-- Description: Mark or unmark form CE
--
-- Method Type: Procedure
-- Arguments
-- 1  R  BOOLEAN  Mark if true, unmark if false
--
------------------------------------------------------------------------

define method .markCe(!mark is BOOLEAN)

  if (!mark) then
    -- Mark new form CE
    MARK $!<this.ce>
    !this.marked = true
  else
    -- Unmark previous form CE
    if (!this.ce.unset().not() and !this.marked) then
      if (!this.ce.badRef().not()) then
        UNMARK $!<this.ce>
      endif
      !this.marked = false
    endif
  endif

endmethod
-- End of method definition for .markCe(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !mtoc()
--
-- Description: Check if apply button valid for selected status
--
-- Method Type: Procedure
-- Arguments:
--   None
--
------------------------------------------------------------------------

define method .mtoc()

  if (!this.mtoc.selection() eq 'mixed') then
    -- Cannot set mixed status - for info only
    !this.apply.active = false
  else
    -- Check if different to initial setting
    !this.apply.active = (!this.mtoc.selection() ne !this.ceMtoc)
  endif

endmethod
-- End of method definition for .mtoc()

------------------------------------------------------------------------
--
-- Method:      !apply()
--
-- Description: MTO status setting
--
-- Method Type: Procedure
-- Arguments:
--   None
--
------------------------------------------------------------------------

define method .apply()

  -- Go to form CE
  !!ce = !this.ce

  -- Spool or Field
  if (!this.ce.type eq 'SPOOL' or !this.ce.type eq 'FIELD') then
    !this.setSpoolMto(!this.ce, !this.mtoc.selection())

  -- Spldrg
  elseif (!this.ce.type eq 'SPLDRG') then
    !this.setSpldrgMto(!this.ce, !this.mtoc.selection())

  -- Pipe
  elseif (!this.ce.type eq 'PIPE') then
    !this.setPipeMto(!this.ce, !this.mtoc.selection())

  -- Branch
  elseif (!this.ce.type eq 'BRAN') then
    !this.setBranchMto(!this.ce, !this.mtoc.selection())

  -- Piping component/tubi
  else
    !this.setCompMto(!this.ce, !this.mtoc.selection())
  endif

  -- Store new value
  !this.ceMtoc = !this.mtoc.selection()

  -- Grey out apply button until setting is changed
  !this.apply.active = false

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      !dismiss()
--
-- Description: Tidy up
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .dismiss()

  -- Unmark form ce
  !this.markCe(false)

endmethod
-- End of method definition for .dismiss()

------------------------------------------------------------------------
--
-- Method:      !setCompMto()
--
-- Description: Set MTO status for single component or implied tube
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF] [Component/tubi]
--   [2] [R] [STRING] [MTO status]
--
------------------------------------------------------------------------

define method .setCompMto(!element is DBREF, !status is STRING)

  -- Checking for appropriate type, and resetting of CE,
  -- is done in calling function, to avoid repetition
  !!ce = !element
  if (!element.type eq 'TUBI') then
    PREVIOUS
    -- List exhausted means head tube
    handle (2,113)
      END
    endhandle
    if (!!ce.type eq 'BRAN') then
      -- Head tube
      MTOH $!status
    else
      -- Leave tube
      MTOT $!status
    endif
  else
    -- Component
    MTOC $!status
  endif

endmethod
-- End of method definition for .setCompMto(DBREF, STRING)

------------------------------------------------------------------------
--
-- Method:      !getCompMto()
--
-- Description: Get MTO status for single component or implied tube
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF] [Component/tubi]
-- Returns:
--   [STRING] [MTO status]
--
------------------------------------------------------------------------

define method .getCompMto(!element is DBREF) is STRING

  -- Checking for appropriate type, and resetting of CE,
  -- is done in calling function, to avoid repetition
  !!ce = !element
  if (!element.type eq 'TUBI') then
    PREVIOUS
    -- List exhausted means head tube
    handle (2,113)
      END
    endhandle
    if (!!ce.type eq 'BRAN') then
      -- Head tube
      !mtoStatus = !!ce.mtoh
    else
      -- Leave tube
      !mtoStatus = !!ce.mtot
    endif
  else
    -- Component
    !mtoStatus = !!ce.mtoc
  endif

  -- A blank MTO status (the default) is equivalent to ON
  if (!mtoStatus eq '') then
    !mtoStatus = 'ON'
  endif
  return !mtoStatus

endmethod
-- End of method definition for .getCompMto(DBREF) STRING

------------------------------------------------------------------------
--
-- Method:      !setBranchMto()
--
-- Description: Set MTO status for components in branch
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF] [Branch]
--   [2] [R] [STRING] [MTO status]
--
------------------------------------------------------------------------

define method .setBranchMto(!branch is DBREF, !status is STRING)

  -- Set MTO status attributes for head tube and branch members
  if (!branch.type eq 'BRAN') then
    -- Use collection in order to include tubes
    var !members COLLECT ALL BRANCH MEMBERS FOR $!branch
    do !i indices !members
      !this.setCompMto(!members[!i].dbRef(), !status)
    enddo
  endif

  -- Restore db position
  !!ce = !this.ce

endmethod
-- End of method definition for .setBranchMto(DBREF, STRING)

------------------------------------------------------------------------
--
-- Method:      !getBranchMto()
--
-- Description: Get MTO status for components in branch
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF] [Branch]
-- Returns:
--   [STRING] [MTO status]
--
------------------------------------------------------------------------

define method .getBranchMto(!branch is DBREF) is STRING

  -- Get MTO status attributes for head tube and branch members
  !mtoStatus = ARRAY()
  if (!branch.type eq 'BRAN') then
    -- Use collection in order to include tubes
    var !members COLLECT ALL BRANCH MEMBERS FOR $!branch
    do !i indices !members
      !mtoStatus.append(!this.getCompMto(!members[!i].dbRef()))
    enddo
  endif

  -- Restore db position
  !!ce = !this.ce

  -- Check if all status equal or some differences
  !status = 'unset'
  do !i indices !mtoStatus
    if (!status eq 'unset') then
      !status = !mtoStatus[!i]
    endif
    if (!mtoStatus[!i] ne !status) then
      !status = 'mixed'
      break
    endif
  enddo
  return !status

endmethod
-- End of method definition for .getBranchMto(DBREF) STRING

------------------------------------------------------------------------
--
-- Method:      !setPipeMto()
--
-- Description: Set MTO status for components in pipe
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF] [Pipe]
--   [2] [R] [STRING] [MTO status]
--
------------------------------------------------------------------------

define method .setPipeMto(!pipe is DBREF, !status is STRING)

  -- Set MTO status attributes for branches
  !branches = !pipe.members
  do !i indices !branches
    !this.setBranchMto(!branches[!i], !status)
  enddo

endmethod
-- End of method definition for .setPipeMto(DBREF, STRING)

------------------------------------------------------------------------
--
-- Method:      !getPipeMto()
--
-- Description: Get MTO status for components in pipe
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF] [Pipe]
-- Returns:
--   [STRING] [MTO status]
--
------------------------------------------------------------------------

define method .getPipeMto(!pipe is DBREF) is STRING

  -- Get MTO status attributes for head tube and branch members
  !mtoStatus = ARRAY()
  !branches = !pipe.members
  do !i indices !branches
    !mtoStatus.append(!this.getBranchMto(!branches[!i]))
  enddo

  -- Check if all status equal or some differences
  !status = 'unset'
  do !i indices !mtoStatus
    if (!status eq 'unset') then
      !status = !mtoStatus[!i]
    endif
    if (!mtoStatus[!i] ne !status and !mtoStatus[!i] ne 'unset') then
      !status = 'mixed'
      break
    endif
  enddo
  return !status

endmethod
-- End of method definition for .getPipeMto(DBREF) STRING

------------------------------------------------------------------------
--
-- Method:      !setSpoolMto()
--
-- Description: Set MTO status for components in SPOOL or FIELD
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF] [SPOOL or FIELD]
--   [2] [R] [STRING] [MTO status]
--
------------------------------------------------------------------------

define method .setSpoolMto(!spool is DBREF, !status is STRING)

  -- Set MTO status attributes for spool members
  if (!spool.type eq 'SPOOL' or !spool.type eq 'FIELD') then
    !members = !spool.splMem
    do !i indices !members
      !this.setCompMto(!members[!i], !status)
    enddo
  endif

  -- Restore db position
  !!ce = !this.ce

endmethod
-- End of method definition for .setSpoolMto(DBREF, STRING)

------------------------------------------------------------------------
--
-- Method:      !getSpoolMto()
--
-- Description: Get MTO status for components in SPOOL or FIELD
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF] [SPOOL or FIELD]
-- Returns:
--   [STRING] [MTO status]
--
------------------------------------------------------------------------

define method .getSpoolMto(!spool is DBREF) is STRING

  -- Get MTO status attributes for spool members
  !mtoStatus = ARRAY()
  if (!spool.type eq 'SPOOL' or !spool.type eq 'FIELD') then
    !members = !spool.splMem
    do !i indices !members
      !mtoStatus.append(!this.getCompMto(!members[!i]))
    enddo
  endif

  -- Restore db position
  !!ce = !this.ce

  -- Check if all status equal or some differences
  !status = 'unset'
  do !i indices !mtoStatus
    if (!status eq 'unset') then
      !status = !mtoStatus[!i]
    endif
    if (!mtoStatus[!i] ne !status) then
      !status = 'mixed'
      break
    endif
  enddo
  return !status

endmethod
-- End of method definition for .getSpoolMto(DBREF) STRING

------------------------------------------------------------------------
--
-- Method:      !setSpldrgMto()
--
-- Description: Set MTO status for components in SPLDRG
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [DBREF] [SPLDRG]
--   [2] [R] [STRING] [MTO status]
--
------------------------------------------------------------------------

define method .setSpldrgMto(!splDrg is DBREF, !status is STRING)

  -- Set MTO status attributes for spools and fields
  !spools = !splDrg.members
  do !i indices !spools
    !this.setSpoolMto(!spools[!i], !status)
  enddo

endmethod
-- End of method definition for .setSpldrgMto(DBREF, STRING)

------------------------------------------------------------------------
--
-- Method:      !getSpldrgMto()
--
-- Description: Get MTO status for components in SPLDRG
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [DBREF] [SPLDRG]
-- Returns:
--   [STRING] [MTO status]
--
------------------------------------------------------------------------

define method .getSpldrgMto(!splDrg is DBREF) is STRING

  -- Get MTO status attributes for spools and fields
  !mtoStatus = ARRAY()
  !spools = !splDrg.members
  do !i indices !spools
    !mtoStatus.append(!this.getSpoolMto(!spools[!i]))
  enddo

  -- Check if all status equal or some differences
  !status = 'unset'
  do !i indices !mtoStatus
    if (!status eq 'unset') then
      !status = !mtoStatus[!i]
    endif
    if (!mtoStatus[!i] ne !status and !mtoStatus[!i] ne 'unset') then
      !status = 'mixed'
      break
    endif
  enddo
  return !status

endmethod
-- End of method definition for .getSpldrgMto(DBREF) STRING
