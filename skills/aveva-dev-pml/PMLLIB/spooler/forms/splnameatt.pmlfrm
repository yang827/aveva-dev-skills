--
-- File:            splnameatt.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          S.Karthigeyan
-- Created:         <day> <date> <time> <year>
--
--
-- Description:
-- Display and Modify a name attribute
-- This form is always called from another form list gadget
-- The parent form must provide a display method to enable it to be updated
-- and validate and setAttribute methods if validation is required
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Cancel method
--  init(FORM,DBREF,STRING,STRING,BOOLEAN) -                   form initialisation
--  nameCall()                       -                   gadget txtName Callback
--  ok()                             -                   ok call method
--  splNameAtt()                     -                   Constructor method for object form
--  validate()                       -                   validate name gadget input value
--
------------------------------------------------------------------------

setup form !!splNameAtt

   !!splNameAtt.formTitle     = 'Modify Name Attribute'
   !!splNameAtt.iconTitle     = 'Modify Name'
   !!splNameAtt.callback      = ''
   !!splNameAtt.formRevision  = ' $Revision:'

   -- element current to the form
   member .ce is DBREF

   -- parent form
   member .main is FORM

   -- special attribute validation flag
   member .validate is BOOLEAN

   -- attribute name
   member .name is STRING

   -- original attribute value
   member .initialValue is STRING

   --form definition

   paragraph .valCe at xmin + 0.2 ymax width 40 lines 1
   frame .famName 'Modify Name' at xmin.valCe ymax
      paragraph .lblName at xmin+0.5 ymax text 'Name' width 5 lines 1
      text .txtName at xmax+0.2 ymin width 40 is STRING
   exit
   button .btnOk '  OK  ' at xmin form ymax+0.5 OK
   button .btnCancel 'Cancel' at xmax form-size ymin CANCEL
exit
-- End of form definition for !!splNameAtt

------------------------------------------------------------------------
--
-- Method:      .splNameAtt()
--
-- Description: Constructor method for object form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method  .splNameAtt()

   !this.okCall = '!this.ok()'
   !this.cancelCall = '!this.cancel()'
   !this.txtName.callback = '!this.nameCall()'
endmethod
-- End of method definition for .splNameAtt()
------------------------------------------------------------------------
--
-- Method:      init()
--
-- Description: form initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .init(!parentForm is FORM, !ce is DBREF, !attribute is STRING, !initialValue is STRING, !validate is BOOLEAN)

   !this.main = !parentForm
   !this.ce = !ce
   !this.initialValue = !initialValue
   !this.name = !attribute
   !this.validate = !validate
   !this.main.editForm = !this

   --initialise gadgets with the arguments passed in
   !this.txtName.val = !this.initialValue
   if (substring(!ce.namn,1,1) EQ '=') then
       !this.valCe.val= 'unset'
   else
       !this.valCe.val= !this.ce.namn
   endif
   if (!validate) then
      !this.btnOk.active= false
   else
      !this.btnOk.active= true
   endif
endmethod
-- End of method definition for .init(FORM, DBREF, STRING, STRING, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      .ok()
--
-- Description: ok call method
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()
   !this.validate()
   if (!this.validate) then
      !!ce = !this.ce
      if (!this.txtName.val NE '') then
         !value = '/'+!this.txtName.val
         NAME $!<value>
      elseif (substring(!this.ce.namn,1,1) NE '=') then
         UNNAME
      endif
   endif
   --update to parent form
   !this.main.display(!this.ce)

   -- unset the member in !!splmodify form to store current edit form
   !this.main.editForm = object FORM()
endmethod
-- End of method definition for .ok()

------------------------------------------------------------------------
--
-- Method:      .nameCall()
--
-- Description: gadget txtName Callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .nameCall()

   if(!this.initialValue NE !this.txtName.val) then
      !this.btnOk.active = true
   else
      !this.btnOk.active = false
   endif

endmethod
-- End of method definition for .nameCall()
------------------------------------------------------------------------
--
-- Method:      .validate()
--
-- Description: validate name gadget input value
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .validate()

   if (!this.txtName.val.set()) then
   if (!this.txtName.val NE !this.initialValue) then
      var !strSz ATTDEF $!<this.name> SIZE
      if (!this.txtName.val.length() gt !strSz[1].real()) then
         !!alert.warning ('The string length exceed the limit of $!strSz and the string is truncated')
         !this.txtName.val = SUBSTRING(!this.txtName.val,1,!strSz)
      endif
      !this.validate = true
      else
         !this.validate = false
      endif
   else
      !this.validate = false
   endif

endmethod
-- End of method definition for .validate()
------------------------------------------------------------------------
--
-- Method:      !cancel()
--
-- Description: Cancel method
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .cancel()
   !this.main.editForm = object FORM()
endmethod
-- End of method definition for .cancel()
