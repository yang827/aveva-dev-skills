-- File:            splnumedit.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Tue Mar 3 14:26:27 GMT 1998
--
--
-- Description:
-- Spooler numbering options
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  display()                        -                   Display settings after init/load
--  init()                           -                   Initialisation
--  load()                           -                   load the defaults
--  ok()                             -                   action for ok callback
--  save()                           -                   save the settings
--  splNumEdit()                     -                   Constructor
--  toggle(GADGET)                   -                   Toggle the part number gadgets
--
------------------------------------------------------------------------

setup form !!splNumEdit

  !!splNumEdit.formTitle     = 'Numbering Settings'
  !!splNumEdit.iconTitle     = 'Numbering'
  !!splNumEdit.callback      = '!!splNumEdit.init()'
  !!splNumEdit.formRevision  = ' $Revision: 1.12 $ '

  -- local form data store
  member .data is SPLNUMOPT

  -- Body of form definition
  bar
    add 'File' .fileMenu
  exit

  frame .maintain ' Include ' at xmin ymin
    toggle .spools 'Spool data'   at xmin+1 ymax
    toggle .fields 'Field data'   at xmin   ymax
    toggle .welds  'Weld data '   at xmin   ymax
    toggle .pBends 'Pulled Bend numbers' at xmin   ymax
    toggle .joints 'Joint data  ' at xmax.spools+3 ymin.spools
    toggle .parts  'Part numbers' at xmin   ymax
    toggle .bends  'Bend numbers' at xmin   ymax
  exit

  frame .options ' Options ' at xmin ymax+0.5
    text .splPrefix 'Default spool prefix   ' at xmin+1 ymax width 6 is STRING
    option .perSpool 'Part numbering   ' at xmin ymax+0.2 width 10
  exit

  frame .update ' Update Choice Handling ' at xmin ymax+0.5
    rgroup .interactive at xmin+1 ymax vertical
      add tag ' Use first available data ' select 'FIRST'
      add tag ' Always generate new data ' select 'NEW'
      add tag ' Manual data selection    ' select 'ASK'
    exit
  exit

  button .ok     '  OK  ' at x0 ymax+0.5 ok
  button .cancel 'Cancel' at xmax form-size ymin  cancel

exit
-- End of form definition for !!splNumEdit

------------------------------------------------------------------------
--
-- Method:      !splNumEdit()
--
-- Description: Constructor
--
-- Method Type: Procedure
-- Arguments:
--   None
--
------------------------------------------------------------------------

define method .splNumEdit()

  -- build menu bar
  !this.newMenu('fileMenu')
  !this.fileMenu.add('callback', 'Save Defaults', '!!splNumEdit.save()')
  !this.fileMenu.add('callback', 'Load Defaults', '!!splNumEdit.load()')
  !this.fileMenu.add('separator')
  !this.fileMenu.add('callback', 'Close', '!!splNumEdit.hide()')

  -- set gadget callbacks
  !this.spools.callback = '!!splNumEdit.data.spools(!!splNumEdit.spools.val)'
  !this.fields.callback = '!!splNumEdit.data.fields(!!splNumEdit.fields.val)'
  !this.welds.callback = '!!splNumEdit.data.welds(!!splNumEdit.welds.val)'
  !this.joints.callback = '!!splNumEdit.data.joints(!!splNumEdit.joints.val)'
  !this.parts.callback = '!this.toggle(!this.parts)'
  !this.bends.callback = '!!splNumEdit.data.bends(!!splNumEdit.bends.val)'
  !this.pBends.callback = '!this.toggle(!this.pBends)'
  !this.splPrefix.callback = '!!splNumEdit.data.splPrefix(!!splNumEdit.splPrefix.val)'
  !this.perSpool.callback = '!!splNumEdit.data.perSpool(!!splNumEdit.perSpool.selection())'
  !this.interactive.callback = '!!splNumEdit.data.interactive(!!splNumEdit.interactive.selection())'
  !this.okCall = '!!splNumEdit.ok()'

  !dText[1] = 'per SPLDRG'
  !rText[1] = 'per SPLDRG'
  !dText[2] = 'per SPOOL'
  !rText[2] = 'per SPOOL'
  !this.perSpool.dText = !dText
  !this.perSpool.rText = !rText

endmethod
-- End of method definition for .splNumEdit()

------------------------------------------------------------------------
--
-- Method:      !display()
--
-- Description: Display settings after init/load
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .display()

  -- (re)initialise form gadgets to main data settings
  !this.spools.val = !this.data.spools()
  !this.fields.val = !this.data.fields()
  !this.welds.val = !this.data.welds()
  !this.joints.val = !this.data.joints()
  !this.parts.val = !this.data.parts()
  !this.bends.val = !this.data.bends()
  !this.pBends.val = !this.data.pulledBends()
  !this.splPrefix.val = !this.data.splPrefix()
  !this.perSpool.select('RTEXT', !this.data.perSpool())
  !this.interactive.select(!this.data.interactive())

endmethod
-- End of method definition for .display()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: Initialisation
--
-- Method Type: Procedure
-- Arguments:
--   None
--
------------------------------------------------------------------------

define method .init()

  -- copy the current global settings and unset the global flag
  !this.data = !!splNumOpt.localCopy()

  -- initialise form gadgets to main data settings
  !this.display()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !save()
--
-- Description: save the settings
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .save()

  -- save all the data
  !this.data.save()

  -- For modify attributes form
  !this.ok()

endmethod
-- End of method definition for .save()

------------------------------------------------------------------------
--
-- Method:      !load()
--
-- Description: load the defaults
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .load()

  -- load the data
  !this.data.load()

  -- reinitialise form gadgets to main data settings
  !this.display()

endmethod
-- End of method definition for .load()

------------------------------------------------------------------------
--
-- Method:      .toggle(GADGET)
--
-- Description: Toggle the part number gadgets
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .toggle(!gadget is GADGET)

  -- when part numbers is off then pulled bends must also be off
  if (!gadget.name().eq('PARTS') and !this.parts.val.not()) then
    !this.pBends.val = false

  -- when pulled bends is on then part numbers must also be on
  elseif (!this.pBends.val) then
    !this.parts.val = true
  endif

  -- save the settings
  !this.data.parts(!this.parts.val)
  !this.data.pulledBends(!this.pBends.val)

endmethod
-- End of method definition for .toggle(GADGET)
------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: action for ok callback
--
-- Method Type: Procedure
--
------------------------------------------------------------------------
define method .ok()

  -- set all the global representation options
  !this.data.copyToGlobal()

  -- Check if variable !!splModify exists
  if (defined(!!splModify)) then
    -- Test for shown modify attributes form
    if (!!splModify.shown()) then
      !!splModify.init()
    endif
  endif

endmethod
-- End of method definition for .ok()
