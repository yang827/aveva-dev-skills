-- File:            splnwelds.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Wed Apr 29 11:34:55 BST 1998
--
--
-- Description:
-- display and set nwelds attribute
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Set nwelds attribute
--  ce(BOOLEAN)                      -                   Check current element
--  dismiss()                        -                   Tidy up
--  init()                           -                   Initialisation
--  markCe(BOOLEAN)                  -                   Mark or unmark form CE
--  nWelds()                         -                   Reactivate apply button if applicable
--  next()                           -                   Reinitialise form for next member
--  previous()                       -                   Reinitialise form for previous member
--  splNWelds()                      -                   Constructor
--  track(FORM,STRING)               -                   Database tracking method
--
------------------------------------------------------------------------

-- Define form
setup form !!splNWelds

  !!splNWelds.formTitle     = 'Number of Attached Welds'
  !!splNWelds.iconTitle     = 'NWelds'
  !!splNWelds.callback      = '!!splNWelds.init()'
  !!splNWelds.formRevision  = ' $Revision: 1.11 $ '

  -- Integer format object must be global variable
  !!splNWeldsFmt = object FORMAT()
  !!splNWeldsFmt.dp = 0

  -- Body of form definition
  member .ce is DBREF
  member .ceNWelds is REAL
  member .marked is BOOLEAN

  -- Forms current element buttons and display
  frame .ceFrame 'Piping component' at xmin ymax
    button .previous at xmin+1 ymax pixmap height 16 width 16
    paragraph .ceText at xmax+1 ymin width 30 lines 2
    button .next at xmax+1 ymin pixmap height 16 width 16
  exit

  -- nwelds setting
  text .nWelds 'Number of Attached Welds ' at xmin.ceText ymax+0.5 width 2 is REAL format !!splNWeldsFmt

  button .apply at xmin form ymax+0.5 ' Apply ' apply
  button .dismiss at xmax form-size ymin 'Dismiss' cancel

  -- setup form tracking
  track |DESICE| callback '!!splNWelds.track('

exit

-- End of form definition for !!splNWelds

------------------------------------------------------------------------
--
-- Method:      !splNWelds()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .splNWelds()

  -- callbacks
  !this.previous.callback = '!!splNWelds.previous()'
  !this.next.callback = '!!splNWelds.next()'
  !this.nWelds.callback = '!!splNWelds.nWelds()'
  !this.apply.callback = '!!splNWelds.apply()'
  !this.cancelCall = '!!splNWelds.dismiss()'

  -- pixmaps
  !this.previous.addPixmap(!!pml.getPathName('leftarrow16.png'))
  !this.next.addPixmap(!!pml.getPathName('rightarrow16.png'))

endmethod
-- End of method definition for .splNWelds()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: Initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .init()

  -- error if current element is inappropriate
  !this.ce(true)

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !ce()
--
-- Description: Check current element
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [True if errors to be output]
--
------------------------------------------------------------------------

define method .ce(!report is BOOLEAN)

  -- Beware of owner check at world
  if (!!ce.type eq 'WORL') then
    if (!report) then
      -- 'Must be at Piping component'
      !!messageFile.error(154, 113)
    endif
    return error 1 noalert
  endif

  -- Check for valid type
  if (!!ce.owner.type ne 'BRAN') then
    if (!report) then
      -- 'Must be at Piping component'
      !!messageFile.error(154, 113)
    endif
    return error 1 noalert
  endif

  -- Move off implied tube
  if (!!ce.type eq 'TUBI') then
    PREVIOUS
    -- List exhausted means this is head tube
    handle (2,113)
      if (!report) then
        -- 'Must be at Piping component'
        !!messageFile.error(154, 113)
      endif
      return error 1 noalert
    endhandle
  endif

  -- Connect appropriate CE to form
  !this.markCe(false)
  !this.ce = !!ce
  !this.ceText.val = !this.ce.fullName
  !this.markCe(true)

  -- Get current nwelds attribute value (welds don't have it)
  if (!this.ce.type eq 'WELD') then
    !this.nWelds.val = 0
    !this.nWelds.active = false
  else
    !this.nWelds.val = !this.ce.nWelds
    !this.nWelds.active = true
  endif

  -- Store initial value
  !this.ceNWelds = !this.nWelds.val

  -- Grey out apply button until setting is changed
  !this.apply.active = false

endmethod
-- End of method definition for .ce(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !track()
--
-- Description: Database tracking method
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [FORM] [Form passed by tracking mechanism]
--   [2] [R] [STRING] [Database type of current element]
--
------------------------------------------------------------------------

-- Define method
define method .track(!dummyForm is FORM, !dummyType is STRING)

  -- no error if current element is inappropriate
  !this.ce(false)

endmethod
-- End of method definition for .track(FORM, STRING)

------------------------------------------------------------------------
--
-- Method:      !previous()
--
-- Description: Reinitialise form for previous member
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .previous()

  -- Initialise for previous member
  !!ce = !this.ce
  PREVIOUS
  handle any
    !!alert.error(!!error.text)
  elsehandle none
    !this.init()
  endhandle

endmethod
-- End of method definition for .previous()

------------------------------------------------------------------------
--
-- Method:      !next()
--
-- Description: Reinitialise form for next member
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .next()

  -- Initialise for next member
  !!ce = !this.ce
  NEXT
  handle any
    !!alert.error(!!error.text)
  elsehandle none
    !this.init()
  endhandle

endmethod
-- End of method definition for .next()

------------------------------------------------------------------------
--
-- Method:      !markCe()
--
-- Description: Mark or unmark form CE
--
-- Method Type: Procedure
-- Arguments
--   [1] [R] [BOOLEAN] [Mark if true, unmark if false]
--
------------------------------------------------------------------------

define method .markCe(!mark is BOOLEAN)

  if (!mark) then
    -- Mark new form CE
    MARK $!<this.ce>
    !this.marked = true
  else
    -- Unmark previous form CE
    if (!this.ce.unset().not() and !this.marked) then
      if (!this.ce.badRef().not()) then
        UNMARK $!<this.ce>
      endif
      !this.marked = false
    endif
  endif

endmethod
-- End of method definition for .markCe(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !nWelds()
--
-- Description: Reactivate apply button if applicable
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .nWelds()

  -- validate number entered
  if (!this.nWelds.val.string().trim() eq '') then
    !this.nWelds.val = 0
  endif
  !this.apply.active = (!this.nWelds.val ne !this.ceNWelds and $
                        !this.nWelds.val ge 0 and !this.nWelds.val le 20)

endmethod
-- End of method definition for .nWelds()

------------------------------------------------------------------------
--
-- Method:      !apply()
--
-- Description: Set nwelds attribute
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .apply()

  -- Set nwelds attribute for form's ce
  !!ce = !this.ce
  !value = !this.nWelds.val
  NWELDS $!value

  -- Store new value
  !this.ceNWelds = !this.nWelds.val

  -- Grey out apply button until setting is changed
  !this.apply.active = false

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      !dismiss()
--
-- Description: Tidy up
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .dismiss()

  -- Unmark form ce
  !this.markCe(false)

endmethod
-- End of method definition for .dismiss()
