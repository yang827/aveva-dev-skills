-- File:            splrealatt.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Wed Feb 18 10:39:34 GMT 1998
--
--
-- Description:
-- Display and modify a real attribute
-- This form is always called from another form list gadget
-- The parent form must provide a display method to enable it to be updated
-- and validate and setAttribute methods if validation is required
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  cancel()                         -                   Cancel method
--  init(FORM,DBREF,STRING,REAL,BOOLEAN) -                   Form initialisation called from !!splAttModify()
--  ok()                             -                   Set attribute value
--  splRealAtt()                     -                   Constructor method for form object
--  validate()                       -                   Validate attribute value
--
------------------------------------------------------------------------
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***

-- Define form
setup form !!splRealAtt

  !!splRealAtt.formTitle     = 'Modify attribute'
  !!splRealAtt.iconTitle     = 'Modify'
  !!splRealAtt.callback      = ''
  !!splRealAtt.formRevision  = ' $Revision: 1.15 $ '

  -- Body of form definition

  -- element current to the form
  member .ce is DBREF

  -- parent form
  member .main is FORM

  -- special attribute validation flag
  member .validate is BOOLEAN

  -- attribute name
  member .name is STRING

  -- original attribute value
  member .initialValue is REAL

  -- gadget to display name of forms current element
  paragraph .ceText at xmin ymax width 40 lines 2

  -- attribute name
  paragraph .attribName at xmin ymax+0.2 width 40 lines 1

  -- attribute value
  text .attribValue at xmin ymax width 14 is REAL

  -- ok/cancel buttons
  button .ok '  OK  ' at xmin form ymax+0.5 ok
  button .cancel 'Cancel' at xmax form-size ymin cancel

exit
-- End of form definition for !!splRealAtt

------------------------------------------------------------------------
--
-- Method:      !splRealAtt()
--
-- Description: Constructor method for form object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .splRealAtt()

  -- set gadget callbacks
  !this.attribValue.callback = '!!splRealAtt.validate()'
  !this.okCall = '!!splRealAtt.ok()'
  !this.cancelCall = '!this.cancel()'

endmethod
-- End of method definition for .splRealAtt()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: Form initialisation called from !!splAttModify()
--
-- Method Type: Procedure
-- Arguments:
--  [1]  [R]  [FORM]     [parent form]
--  [2]  [R]  [DBREF]    [element being modified]
--  [3]  [R]  [STRING]   [attribute name]
--  [4]  [R]  [REAL]     [attribute initial value]
--  [5]  [R]  [BOOLEAN]  [validation flag]
--
------------------------------------------------------------------------

define method .init(!parentForm is FORM, !ce is DBREF, !attribute is STRING, !initialValue is REAL, !validate is BOOLEAN)

  -- Initialise member data
  !this.main = !parentForm
  !this.ce = !ce
  !this.name = !attribute
  !this.initialValue = !initialValue
  !this.validate = !validate

  --store current form in it's parent form
  --!this.main.editForm = !this

  -- Display ce for form
  !this.ceText.val = !this.ce.flnn

  -- Initialise attribute data
  !this.attribName.val = !this.name
  !this.attribValue.val = !this.initialValue

  -- Ok button not active until value is changed
  !this.ok.active = false

endmethod
-- End of method definition for .init(FORM, DBREF, STRING, REAL, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !validate()
--
-- Description: Validate attribute value
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .validate()

  if (!this.attribValue.val eq !this.initialValue) then
    -- value is unchanged
    !this.ok.active = false

  elseif (!this.validate) then
    -- validate user input and activate ok button
    !this.ok.active = (!this.main.validate(!this.ce, !this.name, !this.attribValue.val))

  else
    -- activate ok button if value changed
    !this.ok.active = true
  endif

  -- Leave focus on value if invalid or unchanged
  if (!this.ok.active.not()) then
    !this.attribValue.setFocus()
  endif

endmethod
-- End of method definition for .validate()

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: Set attribute value
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .ok()

  if (!this.validate) then
    -- Attribute requiring special setting
    !this.main.setAttribute(!this.ce, !this.name, !this.attribValue.val)

  else
    -- Make form CE current and set attribute
    !!ce = !this.ce
    $!<this.attribName.val> $!<this.attribValue.val>
  endif

  -- Update parent form
  !this.main.display(!this.ce)
  !this.main.editForm = object FORM()

endmethod
-- End of method definition for .ok()
------------------------------------------------------------------------
--
-- Method:      !cancel()
--
-- Description: Cancel method
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .cancel()
   !this.main.editForm = object FORM()
endmethod
-- End of method definition for .cancel()
