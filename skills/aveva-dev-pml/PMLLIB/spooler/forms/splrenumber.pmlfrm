--
-- File:            splrenumber.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Fri Feb 20 10:28:16 GMT 1998
--
  --
-- Description:
-- Renumber all numbering data for splDrg
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Apply action for form
--  ce()                             -                   links form to the current element
--  check()                          BOOLEAN             check which renumbering will be performed
--  init()                           -                   Form initialisation on show action
--  splRenumber()                    -                   Constructor method for form object
--
------------------------------------------------------------------------
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***

-- Define form
setup form !!splRenumber

  !!splRenumber.formTitle     = 'Renumber Spool Drawing'
  !!splRenumber.iconTitle     = 'Renumber'
  !!splRenumber.callback      = '!!splRenumber.init()'
  !!splRenumber.formRevision  = ' $Revision: 1.15 $ '

  -- Body of form definition

  -- stores the element that is current to the form
  member .ce is DBREF

  -- members used to access all numbering operations
  member .spoolN is SPLSPOOLN
  member .weldN  is SPLWELDN
  member .jointN is SPLJOINTN
  member .partN  is SPLPARTN
  member .bendN  is SPLBENDN

  -- members used to control renumber actions
  member .spoolAlign    is BOOLEAN
  member .spoolRenumber is BOOLEAN
  member .weldAlign     is BOOLEAN
  member .weldRenumber  is BOOLEAN
  member .jointAlign    is BOOLEAN
  member .jointRenumber is BOOLEAN
  member .partRenumber  is BOOLEAN
  member .bendRenumber  is BOOLEAN

  -- form gadgets

  -- CE button, initialises form to the current element
  button .setCe 'CE' at xmin ymax

  -- gadget to display name of forms current element
  paragraph .ceText at xmax+1 ymin width 30 lines 2

  -- gadgets to display renumbering settings
  frame .contents 'Status' at xmin.setCe ymax+0.2 width 40
    textpane .status at xmin+1 ymax width 34 height 10
  exit

  -- form apply/dismiss gadgets
  button .apply   ' Apply ' at xmin ymax+0.5 apply
  button .dismiss 'Dismiss' at xmax form-size ymin cancel

exit
-- End of form definition for !!splRenumber

------------------------------------------------------------------------
--
-- Method:      !splRenumber()
--
-- Description: Constructor method for form object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .splRenumber()

  -- suppress user modification of check output
  !this.status.setEditable(false)

  -- set gadget callbacks
  !this.setCe.callback = '!!splRenumber.init()'
  !this.apply.callback = '!!splRenumber.apply()'

endmethod
-- End of method definition for .splRenumber()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: Form initialisation on show action
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .init()

  -- form interlocking
  if (defined(!!splUpdate)) then
    if (!!splUpdate.shown()) then
      -- 'Renumber not allowed whilst Update form is active.'
      !!messageFile.error(154, 7)
    endif
  endif
  if (defined(!!splModify)) then
    if (!!splModify.shown()) then
      -- 'Renumber not allowed whilst Modify form is active.'
      !!messageFile.error(154, 8)
    endif
  endif
  if (defined(!!splAsBuilt)) then
    if (!!splAsBuilt.shown()) then
      -- 'Renumber not allowed whilst Modify form is active.'
      !!messageFile.error(154, 8)
    endif
  endif

  -- connect the form to !element
  !this.ce()

  -- activate apply button if any renumber is allowed
  !this.apply.active = !this.check()

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !ce()
--
-- Description: links form to the current element
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .ce()

  -- link the form and the numbering objects to the current element splDrg
  !this.ce = !!splDrg()
  !this.ceText.val = !this.ce.fullName

  -- set the current element for each numbering object
  !this.spoolN.ce(!this.ce)
  !this.weldN.ce(!this.ce)
  !this.jointN.ce(!this.ce)
  !this.partN.ce(!this.ce)
  !this.bendN.ce(!this.ce)

endmethod
-- End of method definition for .ce()

------------------------------------------------------------------------
--
-- Method:      !check()
--
-- Description: check which renumbering will be performed
--
-- Method Type: Function
-- Returns:
--  [BOOLEAN]  [true if there is renumbering to perform]
--
------------------------------------------------------------------------

-- Define method
define method .check() is BOOLEAN

  -- check if SPLDRG needs aligning
  -- global numbering options control which checks are made
  -- results are displayed in textpane
  !this.spoolAlign    = false
  !this.spoolRenumber = false
  !this.weldAlign     = false
  !this.weldRenumber  = false
  !this.jointAlign    = false
  !this.jointRenumber = false
  !this.partRenumber  = false
  !this.bendRenumber  = false
  !this.status.clear()
  !checkResults = ARRAY()

  -- check if splDrg has been issued
  if (!this.ce.issued) then
    -- 'Spool drawing has been issued - renumbering is not allowed'
    !checkResults.append(!!messageFile.messageString(154, 63))

  else
    if (!this.spoolN.alignReqd()) then
      -- 'Contents need aligning with model'
      !checkResults.append(!!messageFile.messageString(154, 26))
      !this.spoolAlign = true
    else
      -- Contents are aligned with Model
      !checkResults.append(!!messageFile.messageString(154, 27))
    endif

    if (!!splNumOpt.spools()) then
      !this.spoolRenumber = true
      -- 'Spools will be renumbered'
      !checkResults.append(!!messageFile.messageString(154, 20))
    endif

    if (!!splNumOpt.welds()) then
      if (!this.weldN.alignReqd()) then
        -- 'Welds need aligning with model'
        !checkResults.append(!!messageFile.messageString(154, 29))
        !this.weldAlign = true
      else
        -- 'Welds are aligned with model'
        !checkResults.append(!!messageFile.messageString(154, 30))
      endif
      -- 'Welds will be renumbered'
      !checkResults.append(!!messageFile.messageString(154, 21))
      !this.weldRenumber = true
    endif

    if (!!splNumOpt.joints()) then
      if (!this.jointN.alignReqd()) then
        -- 'Joints need aligning with model'
        !checkResults.append(!!messageFile.messageString(154, 32))
        !this.jointAlign = true
      else
        -- 'Joints are aligned with model'
        !checkResults.append(!!messageFile.messageString(154, 33))
      endif
      -- 'Joints will be renumbered'
      !checkResults.append(!!messageFile.messageString(154, 22))
      !this.jointRenumber = true
    endif

    if (!!splNumOpt.parts()) then
      !this.partRenumber = true
      if (!!splNumOpt.pulledBends()) then
         -- 'Parts, Pulled Bends & Tubes will be renumbered'
        !checkResults.append('Parts & Pulled Bends will be renumbered')
      else
        -- 'Parts will be renumbered'
        !checkResults.append(!!messageFile.messageString(154, 23))
      endif
    endif

    if (!!splNumOpt.bends()) then
      !this.bendRenumber = true
      -- 'Bends will be renumbered'
      !checkResults.append(!!messageFile.messageString(154, 24))
    endif

  endif

  -- display status of all checks
  !this.status.val = !checkResults

  if (!this.spoolAlign or !this.spoolRenumber or !this.weldAlign or !this.weldRenumber or $
      !this.jointAlign or !this.jointRenumber or !this.partRenumber or !this.bendRenumber) then
    !returnValue = true
  else
    !returnValue = false
  endif

  -- return whether any alignments or updates need performing
  return !returnValue

endmethod
-- End of method definition for .check() BOOLEAN

------------------------------------------------------------------------
--
-- Method:      !apply()
--
-- Description: Apply action for form
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .apply()

  !answer = !!alert.confirm('All existing numbering data will be lost. Are you sure you want to renumber this spool drawing?')
  if (!answer.boolean().not()) then
    return
  endif

  -- Align SPLDRG contents
  if (!this.spoolAlign) then
    !this.spoolN.align()
    !this.spoolN.alignTidy()
  endif

  -- Renumber spools
  if (!this.spoolRenumber) then
    SPLPREFIX '$!!<splNumOpt.splPrefix>'
    !this.spoolN.renumber()
  endif

  if (!this.weldAlign and !this.jointAlign) then
    !this.weldN.alignBoth()
    !this.weldN.alignTidy()
  elseif (!this.weldAlign) then
    !this.weldN.align()
    !this.weldN.alignTidy()
  elseif (!this.jointAlign) then
    !this.jointN.align()
    !this.jointN.alignTidy()
  endif

  -- Renumber welds
  if (!this.weldRenumber) then
    !this.weldN.renumber()
  endif

  -- Renumber joints
  if (!this.jointRenumber) then
    !this.jointN.renumber()
  endif

  -- Renumber parts
  if (!this.partRenumber) then
    !this.partN.renumber()
  endif

  -- Renumber bends
  if (!this.bendRenumber) then
    !this.bendN.renumber()
  endif

  !dText[1] = 'Renumber complete'
  !this.status.val = !dText

  -- deactivate apply button until form reinitialised
  !this.apply.active = false

endmethod
-- End of method definition for .apply()
