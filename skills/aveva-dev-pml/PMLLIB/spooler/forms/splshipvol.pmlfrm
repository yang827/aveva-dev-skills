--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Tue Mar 10 15:03:30 GMT 1998
--
--
-- Description:
-- Display spool shipping volume
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  ce(BOOLEAN)                      -                   Check current element
--  dismiss()                        -                   Tidy up
--  display(ARRAY)                   STRING              Format spool volume according to units
--  highlight()                      -
--  init()                           -                   Initialisation
--  roundDown(REAL)                  REAL                Round down a value to nearest 1mm or 1/32 inch
--  splShipVol()                     -                   Constructor
--  track(FORM,STRING)               -                   Database tracking method
--  unhighlight()                    -                   unhighlight the selected element
--
------------------------------------------------------------------------

setup form !!splShipVol

  !!splShipVol.formTitle     = 'Spool Shipping Volume'
  !!splShipVol.iconTitle     = 'SplVol'
  !!splShipVol.callback      = '!!splShipVol.init()'
  !!splShipVol.formRevision  = ' $Revision: 1.7 $ '

  -- Body of form definition
  member .ce is DBREF
  member .marked is BOOLEAN

  -- Forms current element display
  frame .ceFrame 'Spool' at xmin ymax
    paragraph .ceText at xmin+1 ymax width 42 lines 2
  exit

  -- Shipping volume
  frame .volFrame 'Shipping Volume' at xmin.ceFrame ymax+0.2
    paragraph .volume at xmin+1 ymax width 42 lines 1
  exit

  button .dismiss at xmax form-size ymax+0.5 'Dismiss'

  -- setup form tracking
  track |ISODCE| |DESICE| callback '!!splShipVol.track('

exit
-- End of form definition for !!splShipVol

------------------------------------------------------------------------
--
-- Method:      !splShipVol()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .splShipVol()

  -- callbacks
  !this.dismiss.callback = '!!splShipVol.dismiss()'

endmethod
-- End of method definition for .splShipVol()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: Initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .init()

  -- error if current element is inappropriate
  !this.ce(true)

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !ce()
--
-- Description: Check current element
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [True if errors to be output]
--
------------------------------------------------------------------------

-- Define method
define method .ce(!report is BOOLEAN)

  -- check for spool
  !spool = object DBREF()
  if (!!ce.type eq 'SPOOL') then
    !spool = !!ce
  else
    -- is the element a pipe component with a valid sfref to a spool?
    if (!!ce.type ne 'WORL') then
      if (!!ce.owner.type eq 'BRAN') then
        if (!!ce.sfref.unset().not()) then
          if (!!ce.sfref.type eq 'SPOOL') then
            !spool = !!ce.sfref
          endif
        endif
      endif
    endif
    if (!spool.unset()) then
      if (!report) then
        -- 'Unable to navigate to #type element from current database position'
        !!messageFile.error(154, 110, 'SPOOL')
      endif
      return error 1 noalert
    endif
  endif

  -- connect form to spool
  !this.unhighlight()
  !this.ce = !spool
  !this.ceText.val = !this.ce.fullName
  !this.highlight()

  -- format and display spool volume
  !this.volume.val = !this.display(!this.ce.splVolume)

endmethod
-- End of method definition for .ce(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !track()
--
-- Description: Database tracking method
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [FORM] [Form passed by tracking mechanism]
--   [2] [R] [STRING] [Database type of current element]
--
------------------------------------------------------------------------

-- Define method
define method .track(!dummyForm is FORM, !dummyType is STRING)

  -- no error if current element is inappropriate
  !this.ce(false)

endmethod
-- End of method definition for .track(FORM, STRING)

------------------------------------------------------------------------
--
-- Method:      !display()
--
-- Description: Format spool volume according to units
--
-- Method Type: Function
-- Arguments:
--   [1] [R] [ARRAY] [Spool volume]
-- Returns:
--   [STRING] [Formatted volume]
--
------------------------------------------------------------------------

-- Define method
define method .display(!splVol is ARRAY) is STRING

  -- format components
  !sides = ARRAY()
  do !i indices !splVol
    !sides[!i] = !this.roundDown(!splVol[!i]).queryString()
  enddo

  -- return combined string
  return (!sides[1] & ' x ' & !sides[2] & ' x ' & !sides[3])

endmethod
-- End of method definition for .display(ARRAY) STRING

------------------------------------------------------------------------

-- Define method
define method .highlight()

  -- highlight the selected element
  !highlightCol = !!gphColOpt.highlight()
  ENHANCE $!<this.ce> COLOUR $!<highlightCol.code>
  !this.marked = true

endmethod
-- End of method definition for .highlight()

------------------------------------------------------------------------
--
-- Method:      !unhighlight()
--
-- Description: unhighlight the selected element
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .unhighlight()

  -- reset display
  if (!this.ce.unset().not() and !this.marked) then
    if (!this.ce.badRef().not()) then
      UNENHANCE $!<this.ce>
      REPRESENTATION UPDATE
    endif
    !this.marked = false
  endif

endmethod
-- End of method definition for .unhighlight()

------------------------------------------------------------------------
--
-- Method:      !dismiss()
--
-- Description: Tidy up
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .dismiss()

  -- Unmark form ce
  !this.unhighlight()

  -- Hide form
  !this.hide()

endmethod
-- End of method definition for .dismiss()

------------------------------------------------------------------------
--
-- Method:      roundDown()
--
-- Description: Round down a value to nearest 1mm or 1/32 inch
--
-- Method Type: Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Original value
-- Return:
--   [Data Type] [Description]
--    REAL        rounded value
--
------------------------------------------------------------------------
define method .roundDown(!value is REAL) is REAL

  !format           = object FORMAT()
  !format.dimension = 'L'
  if (!!isImperialLength('DIST')) then
    -- round down to 1/16 inch
    !tempValue            = !!comValueConvert(!value,'INCH')
    !format.units         = 'INCH'
    !format.inchSeparator = '.'
    !format.denominator   = 16
    !format.fraction      = true
    !tempValue            = !tempValue.string(!format).real(!format)
    if( !tempValue gt !value ) then
      -- Subtract 1/16 inch to round down
      !tempValue = !tempValue - 1/16in
    endif
  else
    -- Round down to zero DP
    !tempValue      = !!comValueConvert(!value,'MM')
    !format.units   = 'MM'
    !tempValue      = !tempValue.string('D0').real(!format)
  endif

  return !tempValue

endmethod
-- End of method definition
