--
-- File:            splshopflag.pmlfrm
--   Type:          Form Definition
--   Group:         General Application
--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Thu Feb 12 11:14:42 GMT 1998
--
--
-- Description:
-- Modify piping component shop flag
--
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  apply()                          -                   Set shop flag
--  ce(BOOLEAN)                      -                   Check current element
--  dismiss()                        -                   Tidy up
--  init()                           -                   Initialisation
--  markCe(BOOLEAN)                  -                   Mark or unmark form CE
--  next()                           -                   Reinitialise form for next member
--  previous()                       -                   Reinitialise form for previous member
--  shop()                           -                   Reactivate apply button if applicable
--  splShopFlag()                    -                   Constructor
--  track(FORM,STRING)               -                   Database tracking method
--
------------------------------------------------------------------------

-- Define form
setup form !!splShopFlag

  !!splShopFlag.formTitle     = 'Shop/Field'
  !!splShopFlag.iconTitle     = 'Shop'
  !!splShopFlag.callback      = '!!splShopFlag.init()'
  !!splShopFlag.formRevision  = ' $Revision: 1.19 $ '

  -- Body of form definition
  member .ce is DBREF
  member .ceShop is BOOLEAN
  member .marked is BOOLEAN

  -- Forms current element buttons and display
  frame .ceFrame 'Piping component' at xmin ymax
    button .previous at xmin+1 ymax pixmap height 16 width 16
    paragraph .ceText at xmax+1 ymin width 30 lines 2
    button .next at xmax+1 ymin pixmap height 16 width 16
  exit

  -- Shop flag setting
  rgroup .shop at xmin.ceText ymax+0.5 vertical
    add tag ' Fabrication material' select 'TRUE'
    add tag ' Erection material' select 'FALSE'
  exit

  button .apply at xmin form ymax+0.5 ' Apply ' apply
  button .dismiss at xmax form-size ymin 'Dismiss' cancel

  -- setup form tracking
  track |DESICE| callback '!!splShopFlag.track('

exit

-- End of form definition for !!splShopFlag

------------------------------------------------------------------------
--
-- Method:      !splShopFlag()
--
-- Description: Constructor
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .splShopFlag()

  -- callbacks
  !this.previous.callback = '!!splShopFlag.previous()'
  !this.next.callback = '!!splShopFlag.next()'
  !this.shop.callback = '!!splShopFlag.shop()'
  !this.apply.callback = '!!splShopFlag.apply()'
  !this.cancelCall = '!!splShopFlag.dismiss()'

  -- pixmaps
  !this.previous.addPixmap(!!pml.getPathName('leftarrow16.png'))
  !this.next.addPixmap(!!pml.getPathName('rightarrow16.png'))

endmethod
-- End of method definition for .splShopFlag()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: Initialisation
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .init()

  -- error if current element is inappropriate
  !this.ce(true)

endmethod
-- End of method definition for .init()

------------------------------------------------------------------------
--
-- Method:      !ce()
--
-- Description: Check current element
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [BOOLEAN] [True if errors to be output]
--
------------------------------------------------------------------------

define method .ce(!report is BOOLEAN)

  -- Beware of owner check at world
  if (!!ce.type eq 'WORL') then
    if (!report) then
      -- 'Must be at Piping component'
      !!messageFile.error(154, 113)
    endif
    return error 1 noalert
  endif

  -- Check for valid type
  if (!!ce.owner.type ne 'BRAN') then
    if (!report) then
      -- 'Must be at Piping component'
      !!messageFile.error(154, 113)
    endif
    return error 1 noalert
  endif

  -- Connect appropriate CE to form
  !this.markCe(false)
  !this.ce = !!ce
  !this.ceText.val = !this.ce.fullName
  !this.markCe(true)

  -- Get current shop attribute value
  if (!this.ce.type eq 'TUBI') then
    PREVIOUS
    -- List exhausted means head tube
    handle (2,113)
      END
    endhandle
    if (!!ce.type eq 'BRAN') then
      -- Head tube
      var !tubeShop HEADTUBE SHOP
    else
      -- Leave tube
      var !tubeShop LEAVETUBE SHOP
    endif
    !this.shop.select(!tubeShop.upcase())
    !!ce = !this.ce
  else
    !this.shop.select(!this.ce.shop.string().upcase())
  endif

  -- Store initial value
  !this.ceShop = !this.shop.selection().boolean()

  -- Grey out apply button until setting is changed
  !this.apply.active = false

endmethod
-- End of method definition for .ce(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !track()
--
-- Description: Database tracking method
--
-- Method Type: Procedure
-- Arguments:
--   [1] [R] [FORM] [Form passed by tracking mechanism]
--   [2] [R] [STRING] [Database type of current element]
--
------------------------------------------------------------------------

-- Define method
define method .track(!dummyForm is FORM, !dummyType is STRING)

  -- no error if current element is inappropriate
  !this.ce(false)

endmethod
-- End of method definition for .track(FORM, STRING)

------------------------------------------------------------------------
--
-- Method:      !previous()
--
-- Description: Reinitialise form for previous member
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .previous()

  -- Initialise for previous member
  !!ce = !this.ce
  !tryPrev = true

  -- Try arrive tube
  if (!!ce.type ne 'TUBI') then
    IARRIVE TUBE
    handle any
    elsehandle none
      !tryPrev = false
      !this.init()
    endhandle
  endif

  -- Try component
  if (!tryPrev) then
    PREVIOUS
    handle any
      !!alert.error(!!error.text)
    elsehandle none
      !this.init()
    endhandle
  endif

endmethod
-- End of method definition for .previous()

------------------------------------------------------------------------
--
-- Method:      !next()
--
-- Description: Reinitialise form for next member
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .next()

  -- Initialise for next member
  !!ce = !this.ce
  !tryNext = true

  -- Try leave tube
  if (!!ce.type ne 'TUBI') then
    ILEAVE TUBE
    handle any
    elsehandle none
      !tryNext = false
      !this.init()
    endhandle
  endif

  -- Try component
  if (!tryNext) then
    NEXT
    handle any
      !!alert.error(!!error.text)
    elsehandle none
      !this.init()
    endhandle
  endif

endmethod
-- End of method definition for .next()

------------------------------------------------------------------------
--
-- Method:      !markCe()
--
-- Description: Mark or unmark form CE
--
-- Method Type: Procedure
-- Arguments
-- 1  R  BOOLEAN  Mark if true, unmark if false
--
------------------------------------------------------------------------

define method .markCe(!mark is BOOLEAN)

  if (!mark) then
    -- Mark new form CE
    MARK $!<this.ce>
    !this.marked = true
  else
    -- Unmark previous form CE
    if (!this.ce.unset().not() and !this.marked) then
      if (!this.ce.badRef().not()) then
        UNMARK $!<this.ce>
      endif
      !this.marked = false
    endif
  endif

endmethod
-- End of method definition for .markCe(BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !shop()
--
-- Description: Reactivate apply button if applicable
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .shop()

  !this.apply.active = (!this.shop.selection().boolean() ne !this.ceShop)

endmethod
-- End of method definition for .shop()

------------------------------------------------------------------------
--
-- Method:      !apply()
--
-- Description: Set shop flag
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .apply()

  -- Set shop flag for form's ce
  !!ce = !this.ce
  !value = !this.shop.selection()
  if (!this.ce.type eq 'TUBI') then
    PREVIOUS
    -- List exhausted means head tube
    handle (2,113)
      END
    endhandle
    if (!!ce.type eq 'BRAN') then
      -- Head tube
      CHOOSE HSTU WITH SHOP $!value
      handle any
        !!ce = !!splShopFlag.ce
        !!splShopFlag.shop.select(!!splShopFlag.ceShop.string())
        !!alert.error(!!error.text)
      endhandle
    else
      -- Leave tube
      CHOOSE LSTU WITH SHOP $!value
      handle any
        !!ce = !!splShopFlag.ce
        !!splShopFlag.shop.select(!!splShopFlag.ceShop.string())
        !!alert.error(!!error.text)
      endhandle
    endif
    !!ce = !!splShopFlag.ce
  else
    SHOP $!value
  endif

  -- Store new value
  !!splShopFlag.ceShop = !this.shop.selection().boolean()

  -- Grey out apply button until setting is changed
  !!splShopFlag.apply.active = false

endmethod
-- End of method definition for .apply()

------------------------------------------------------------------------
--
-- Method:      !dismiss()
--
-- Description: Tidy up
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .dismiss()

  -- Unmark form ce
  !this.markCe(false)

endmethod
-- End of method definition for .dismiss()
