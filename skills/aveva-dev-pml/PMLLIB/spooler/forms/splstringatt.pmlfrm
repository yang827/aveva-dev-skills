--     Keyword:     GEN
--   Module:        spooler
--   Replaces:
--
-- Author:          M.Lewis
-- Created:         Wed Feb 18 10:39:34 GMT 1998
--
--
-- Description:
-- Display and modify a string attribute
-- This form is always called from another form list gadget
-- The parent form must provide a display method to enable it to be updated
-- and validate and setAttribute methods if validation is required
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  arrToStr(ARRAY)                  STRING              Array of strings into multi-line string
--  cancel()                         -                   Cancel method
--  init(FORM,DBREF,STRING,STRING,BOOLEAN) -                   Form initialisation called from !!splAttModify()
--  multToSngl(STRING)               STRING              remove return char.s from the text string
--  ok()                             -                   Set attribute value
--  singleStr(STRING)                -                   check an text attribute is a multi string or not
--  splStringAtt()                   -                   Constructor method for form object
--  spltStr(STRING)                  ARRAY               split multi-line strings into array
--  validate()                       -                   Validate attribute value
--
------------------------------------------------------------------------
-- *** OLD STYLE PML ***
-- *** COMMAND LINE SYNTAX ***

-- Define form
setup form !!splStringAtt

  !!splStringAtt.formTitle     = 'Modify attribute'
  !!splStringAtt.iconTitle     = 'Modify'
  !!splStringAtt.callback      = ''
  !!splStringAtt.formRevision  = ' $Revision: 1.17 $ '

  -- Body of form definition

  -- element current to the form
  member .ce is DBREF

  -- parent form
  member .main is FORM

  -- special attribute validation flag
  member .validate is BOOLEAN

  -- special multiString validation flag
  member .multiStr is BOOLEAN

  -- attribute name
  member .name is STRING

  -- original attribute value
  member .initialValue is STRING

  -- gadget to display name of forms current element
  paragraph .ceText at xmin ymax width 40 lines 2

  -- attribute name
  paragraph .attribName at xmin ymax+0.2 width 40 lines 1

  -- attribute value
  textPane .attribValue at xmin ymax width 40  height 5

  -- ok/cancel buttons
  button .ok '  OK  ' at xmin form ymax+0.5 ok
  button .cancel 'Cancel' at xmax form-size ymin cancel

exit
-- End of form definition for !!splStringAtt

------------------------------------------------------------------------
--
-- Method:      !splStringAtt()
--
-- Description: Constructor method for form object
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .splStringAtt()

  -- set gadget callbacks
  !this.okCall = '!!splStringAtt.ok()'
  !this.cancelCall = '!this.cancel()'

endmethod
-- End of method definition for .splStringAtt()

------------------------------------------------------------------------
--
-- Method:      !init()
--
-- Description: Form initialisation called from !!splAttModify()
--
-- Method Type: Procedure
-- Arguments:
--  [1]  [R]  [FORM]     [parent form]
--  [2]  [R]  [DBREF]    [element being modified]
--  [3]  [R]  [STRING]   [attribute name]
--  [4]  [R]  [STRING]   [attribute initial value]
--  [5]  [R]  [BOOLEAN]  [validation flag]
--
------------------------------------------------------------------------

define method .init(!parentForm is FORM, !ce is DBREF, !attribute is STRING, !initialValue is STRING, !validate is BOOLEAN)

  -- Initialise member data
  !this.main = !parentForm
  !this.ce = !ce
  !this.name = !attribute
  !this.initialValue = !initialValue
  !this.validate = !validate

  -- Display ce for form
  !this.ceText.val = !this.ce.flnn

  --store current edit form in the parent form
  !this.main.editForm = !this

  -- Initialise attribute data
  !this.attribName.val = !this.name
  !this.attribValue.val = !this.spltStr(!this.initialValue)
  -- Ok button not active until value is changed
  !this.ok.active = true

endmethod
-- End of method definition for .init(FORM, DBREF, STRING, STRING, BOOLEAN)

------------------------------------------------------------------------
--
-- Method:      !validate()
--
-- Description: Validate attribute value
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .validate()

  if (!this.attribValue.val eq !this.spltStr(!this.initialValue)) then
    -- value is unchanged
    !this.ok.active = false

  elseif (!this.validate) then
    -- validate user input and activate ok button
    !this.ok.active = (!this.main.validate(!this.ce, !this.name, !this.arrToStr(!this.attribValue.val)))

  elseif (!this.name.upcase() eq 'NAME') then
    -- check for name and activate ok button
    if (!this.arrToStr(!this.attribValue.val).trim() eq '' or !this.arrToStr(!this.attribValue.val).unset()) then
      -- unnaming
      !this.attribValue.val = ''
      !this.ok.active = true
    else
      -- validate name
      !checkedName = !!checkName(!this.arrToStr(!this.attribValue.val), 'NEW')
      if (!checkedName.set()) then
        !this.arrToStr(!this.attribValue.val) = !checkedName
      endif
      !this.ok.active = (!checkedName.set() and (!this.arrToStr(!this.attribValue.val) ne !this.initialValue))
    endif

  else
    -- activate ok button if value changed
    !this.ok.active = true
  endif

  -- Leave focus on value if invalid or unchanged
  if (!this.ok.active.not()) then
    !this.attribValue.setFocus()
  endif

endmethod
-- End of method definition for .validate()

------------------------------------------------------------------------
--
-- Method:      !ok()
--
-- Description: Set attribute value
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

define method .ok()
  -- define constants for types text and word strings
  !text = 4
  !word = 6
  !maxWrd = 6
  !this.validate()
  if (!this.validate) then
    -- Attribute requiring special setting
    !this.main.setAttribute(!this.ce, !this.name, !this.arrToStr(!this.attribValue.val))

  elseif (!this.initialValue NE !this.arrToStr(!this.attribValue.val)) then
    -- check for multi-string text attribute
    !this.singleStr(!this.attribName.val)
    -- Make form CE current and set attribute
    !!ce = !this.ce
    !attValStr=!this.arrToStr(!this.attribValue.val)
    var !attTyp ATTDEF $!<this.attribName.val> TYPE
    if (!attTyp[1].real() EQ !text) then
       var !attStrSz ATTDEF $!<this.attribName.val> SIZE
       if (!attValStr.length() GT !attStrSz[1].real()) then
          !!alert.warning ('The string length exceed the limit of $!text characters and the string is truncated')
          !attValStr = SUBSTRING(!attValStr,1,!attStrSz[1].real())
          if (!this.multiStr.not()) then
             !attValStr = !this.multToSngl(!attValStr)
          endif
          $!<this.attribName.val> |$!<attValStr>|
       elseif (!attValStr.empty()) then
          !attValStr ='unset'
          $!<this.attribName.val> $!<attValStr>
    else
          if (!this.multiStr.not()) then
             !attValStr = !this.multToSngl(!attValStr)
    endif
          $!<this.attribName.val> |$!<attValStr>|
       endif
    elseif (!attTyp[1].real() EQ !word) then
       if (!attValStr.length() gt !maxWrd) then
          !mxWord = !word - 2
          !!alert.warning ('The string length exceed the limit of $!mxWord and the string is truncated')
          !attValStr = SUBSTRING( !attValStr,1,!word)
       elseif (!attValStr.empty()) then
          !attValStr ='unset'
       endif
       if (!this.multiStr.not()) then
          !attValStr = !this.multToSngl(!attValStr)
       endif
       $!<this.attribName.val> $!<attValStr>
    endif
  endif

  -- Update to parent form
  !this.main.display(!this.ce)
  !this.main.editForm = object FORM()
endmethod
-- End of method definition for .ok()
------------------------------------------------------------------------
--
-- Method:      !spltStr()
--
-- Description: split multi-line strings into array
--
-- Method Type: function
--
------------------------------------------------------------------------
--
define method .spltStr(!initAttVal is STRING) is ARRAY
-- define new line char.
!nl='
'
  !strArray = !initAttVal.split(!nl)
  return !strArray
endmethod
-- End of method definition for .spltStr(STRING) ARRAY
--End of method definition for !spltStr( STRING) ARRAY

------------------------------------------------------------------------
--
-- Method:      !arrToStr()
--
-- Description: Array of strings into multi-line string
--
-- Method Type: function
--
------------------------------------------------------------------------
--
define method .arrToStr(!attValArray is ARRAY) is STRING
--define new line character
!multStr=''
!nl='
'
  if (!attValArray.size() GT 1) then
     do !i indices !attValArray
        !multStr= !multStr+!attValArray[!i]+!nl
     enddo
  elseif (!attValArray.empty()) then
     !multStr = 'unset'
  else
     !multStr = !attValArray[1]
  endif
return !multStr
endmethod
-- End of method definition for .arrToStr(ARRAY) STRING
--End of method definition for !arrToStr(ARRAY) STRING

------------------------------------------------------------------------
--
-- Method:      !cancel()
--
-- Description: Cancel method
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .cancel()
   --unset the member variable to which store the current edit form details
  !this.main.editForm = object FORM()
endmethod
-- End of method definition for .cancel()
--End of method definition for .cancel()

------------------------------------------------------------------------
--
-- Method:      !singleStr()
--
-- Description: check an text attribute is a multi string or not
--
-- Method Type: Procedure
--
------------------------------------------------------------------------

-- Define method
define method .singleStr(!attribute is STRING)

   !this.multiStr = true
   !snglStrAtt = 'CKEY MTOCOMPONENT MTOTUBE SPLPREFIX WLDPREFIX'
   if (!snglStrAtt.match(!attribute.upcase()) gt 0) then
      !this.multiStr = false
   endif
endmethod
-- End of method definition for .singleStr(STRING)

------------------------------------------------------------------------
--
-- Method:      !multToSngl()
--
-- Description: remove return char.s from the text string
--
-- Method Type: function
--
------------------------------------------------------------------------

-- Define method
define method .multToSngl(!multiStr is STRING) is STRING

   --define new line character
!nl = '
'
   !snglStr = ''
   !tmpStr = !multiStr.split(!nl)
   if (!tmpStr.size() GT 1) then
      do !j indices !tmpStr
         if (!tmpStr[!j].empty().not()) then
            !snglStr = !snglStr + !tmpStr[!j]
         endif
       enddo
   elseif (!tmpStr[1].empty().not()) then
      !snglStr = !tmpStr[1]
   endif
   return !snglStr
endmethod
-- End of method definition for .multToSngl(STRING) STRING
