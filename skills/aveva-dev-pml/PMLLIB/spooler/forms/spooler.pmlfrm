--
--
-- Description:     main form for Spooler application
--
------------------------------------------------------------------------
--
-- Methods defined:
--
--  Method call                      Return              Description
--  ===========                      ======              ===========
--  spooler()                        -                   Constructor method
--
------------------------------------------------------------------------
setup form !!spooler at xr0 yr0 size 100 1 MAIN
  !this.formtitle = 'Spooler - AVEVA PDMS'
  !this.icontitle = 'Spooler - AVEVA PDMS'
  !this.callback  = '!!splMainBarInit('
  !this.formrevision  = '$$Revision: 1.15 $ '
  !this.quitCall      = |CALLIB XEXIT|

  -- !iconSize = !!comSysOpt.iconSize()
  -- icon size is now 16 because we can't change the size of icons on toolbars
  !iconSize = 16

  -- member to control calling of constructor function
  member .shown is BOOLEAN
  member .functions is SPLFUNCTIONS

  member .isodBar is BOOLEAN
  member .desiBar is BOOLEAN

  ------------------------------------------------------------------------
  -- Main bar Menu
  ------------------------------------------------------------------------
  bar
  exit

  !bar = !this.bar
  !bar.add('Spooler', 'spooler')
  !bar.add('Display', 'display')
  !bar.add('Query', 'query')
  !bar.add('Settings', 'settings')
  !bar.add('Utilities', 'utilities')
  !bar.add('Window', 'WINDOW')
  !bar.add('Help', 'help')

  -------------------------------------------
  -- Main toolbar
  -------------------------------------------
  -- get work
  button .mtbGetWork tooltip 'Get Work' pixmap width $!iconSize height $!iconSize callback |GETWORK|

  -- save work
  button .mtbSaveWork tooltip 'Save Work' pixmap width $!iconSize height $!iconSize callback |CALLG MSAVEW|

  -- Add CE to drawlist
  button .mtbAddCe tooltip 'Add CE to Drawlist' pixmap width $!iconSize height $!iconSize callback |!!splDrawlistAdd('CE', 0)|

  -- Remove CE from drawlist
  button .mtbRemoveCe tooltip 'Remove CE from Drawlist' pixmap width $!iconSize height $!iconSize callback |REMOVE CE|

  -- Remove All from drawlist
--  button .mtbRemoveAll tooltip 'Remove All from Drawlist' pixmap width $!iconSize height $!iconSize callback |REMOVE ALL|

  -- single navigate
  --     button .mtbNavigate tooltip 'Navigate to Element' pixmap width $!iconSize height $!iconSize callback |!!gphViews.navigate()|

  -- measure
  button .mtbMeasure tooltip 'Measure' pixmap width $!iconSize height $!iconSize callback |!!gphViews.measure('DISTANCE')|

  -- axes on CE
  button .mtbAxes tooltip 'Display Axes on CE' pixmap width $!iconSize height $!iconSize callback |!!gphViews.tag('AXES')|

  -- List Creation/modification
  button .mtbCreateList tooltip 'Create/Modify Lists' pixmap width $!iconSize height $!iconSize callback |CALLIB SHOWFORM _CDCLIST|

  -- Active List/Collection
  option .list tooltip 'Active List' callback |CALLIB ILIST $$_LIST| width 15

  -- Delete CE
  button .deleteCe tooltip 'Delete CE' pixmap width $!iconSize height $!iconSize callback |CALLIB MDELCE CE true|

  button .create tooltip 'Create Element' pixmap width $!iconSize height $!iconSize callback '!!splCreate(!this.createType.selection())'
  option .createType tooltip 'Type of Element' width 15
  button .update tooltip 'Update Current Spool Drawing' pixmap width $!iconSize height $!iconSize callback '!!splUpdate()'
  button .modify tooltip 'Modify Current Spool Drawing' pixmap width $!iconSize height $!iconSize callback '!!splModify()'

  text   .activeSplDrg tooltip 'Active Spool Drawing' width 30 is STRING
  button .pickNavigate tooltip 'Navigate Pick Mode' pixmap width $!iconSize height $!iconSize callback |!this.functions.pick('NAVIGATE')|
  button .pickAdd tooltip 'Add to Spool Drawing Pick Mode' pixmap width $!iconSize height $!iconSize callback |!this.functions.pick('ADD')|
  button .pickRemove tooltip 'Remove From Spool Drawing Pick Mode' pixmap width $!iconSize height $!iconSize callback |!this.functions.pick('REMOVE')|

  -- toggle .includeFields tooltip 'Include Field Components' pixmap width $!iconSize height $!iconSize callback '!this.functions.includeFields()'
  button .includeFields toggle tooltip 'Include Field Components' pixmap width $!iconSize height $!iconSize callback '!this.functions.includeFields()'

  -- EDG Positioning toolbar
  -- Working Plane
  !wpOn  = !!pml.getPathName('workingplaneon' & !iconSize & '.png')
  !wpOff = !!pml.getPathName('workingplaneoff' & !iconSize & '.png')

  frame .edgPositioningToolbar toolbar 'Positioning Control'
    button .wp toggle 'Turn working plane on/off' tooltip 'Turn working plane on/off' pixmap unsel "$!<wpOff>" sel "$!<wpOn>" width $!iconSize height $!iconSize

    -- Pick Types  (Element, Pline, etc)
    option .pick     width  8

    -- Pick Option (position deriving mechanism)
    option .pickType width 10

    -- Explicit Positioning Form
    if(undefined(!!edgFormat)) then
      !!edgFormat = object FORMAT()
    endif
    text   .input    width 14 is REAL format !!edgFormat

    -- Explicit position pick form
    !explicitIcon         = !!pml.getPathName('xyz' & !iconSize & '.png')
    button .explicit 'Explicit Position' tooltip 'Explicit Position' pixmap "$!<explicitIcon>" width $!iconSize height $!iconSize callback |show !!edgEPosition free|
  exit
  !this.edgPositioningToolbar.active = false
  !this.edgPositioningToolbar.visible = false

  !!appCntrl.modifyForm()

  -- setup form tracking
  track |ISODCE| |DESICE| |CATACE| |PROPCE| |PADDCE| callback '!!spooler.functions.track('

exit
-- End of form definition

------------------------------------------------------------------------
--
-- Method:      .spooler()
--
-- Description: Constructor method
--
-- Method Type: Constructor
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
-- Return:
--   [Data Type] [Description]
--
------------------------------------------------------------------------
define method .spooler()
  -- For Marine/Schematic Header
  !mm = object AVEVAModuleManager()
  !product = !mm.CurrentProductName()
  !this.formTitle = 'Spooler - AVEVA $!product'

  !project = current project
  !isGlobal = !project.isGlobal()

  ------------------------------------------------------------------------
  -- Spooler pulldown Menu
  ------------------------------------------------------------------------
  !menu = !this.newMenu('spooler')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Save Work', 'CALLG MSAVEW', 'SaveWork')
  !menu.add('CALLBACK', 'Get Work', 'GETWORK', 'GetWork')
  !menu.add('CALLBACK', 'Extract Control...', 'call !!admExtractCntrl()', 'ExtractControl')
  !menu.add('CALLBACK', 'Session Comment...', 'show !!msgsavework', 'SessionComment')
  -- add menu fields for switching to other applications
  !menu.add('SEPARATOR')
  !!appCntrl.appMenu(!menu, |!!appxload('MODULE', 'APPNAME', false)|)
  -- since we only have one application at the moment, hide the menu that switches between applications
  !this.spooler.setFieldProperty('GEN', 'VISIBLE', false)

  !menu.add('SEPARATOR')
  !menu.add('MENU', 'Modules', 'modules', 'Modules')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Exit', 'CALLIB XEXIT', 'Exit')

  ------------------------------------------------------------------------
  -- Display pulldown Menu
  ------------------------------------------------------------------------
  !menu = !this.newMenu('display')
  !menu.add('CALLBACK', 'Graphical View', '!!gphViews.addDesign()', 'GraphicalView')
  !menu.add('CALLBACK', 'View Control...', 'show !!gphControl', 'ViewControl')
  !menu.add('FORM', 'Plot View...', 'plotView', 'PlotView')

  -- core-controlled menu fields added for PDMS 11.6
  !menu.add('SEPARATOR')
  !explorersMenu = !this.newMenu('explorersMenu')
  !menu.add('MENU', 'Explorers', 'explorersMenu')
  !explorersMenu.add('TOGGLE',   'Design Explorer',     '',                                 'Design Explorer')
  !explorersMenu.add('TOGGLE',   'Fabrication Explorer',     '',                            'Fabrication Explorer')
  !menu.add('CALLBACK', 'Drawlist',              '!!gphViews.drawlist()' ,           'sysViewDrawlist')
  !menu.add('TOGGLE',   'My Data',               '', 'My Data')
  !menu.add('TOGGLE',   'Reference List',        '', 'Reference List')
  !menu.add('TOGGLE',   'Attributes...',         '', 'Attributes Utility')
  !menu.add('TOGGLE',   'Search...',             '', 'Find Utility')
  !menu.add('TOGGLE',   'Search Results...',     '', 'Output Utility')
  !menu.add('SEPARATOR')
  !menu.add('TOGGLE',   'Status Controller',  '',                                       'Status Controller')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Members...',          'CALLIB UFORMS MEMB _CDCMEMBER FREE',    'members')
  !menu.add('CALLBACK', 'Advanced Members...', 'CALLIB UFORMS MEMB _CDCADVMEMBER FREE', 'advMembers')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Command Window...',     'show _cadcBth free',               'commandLine')

  -- Sub menus for display pulldown menu

  ------------------------------------------------------------------------
  -- Query pulldown Menu
  ------------------------------------------------------------------------
  !menu = !this.newMenu('query')
  !menu.add('CALLBACK', 'General...', 'CALLIBQ XATTFORM _CDGENQ FREE', 'General')
  !menu.add('TOGGLE',   'Attributes...',  '',                                 'Attributes Utility')
  !menu.add('CALLBACK', 'Properties...', |!!comProp(!!ce, 'QUERY')|, 'Properties')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Spool Shipping Volume...', 'splShipVol', 'SpoolShippingVolume')
  !menu.add('SEPARATOR')
  !menu.add('FORM', 'Project...', 'qryProject', 'Project')
  !menu.add('FORM', 'User Status...', 'userStatus', 'UserStatus')
  !menu.add('FORM', 'Data Access Control...', 'qrydac', 'DataAccessControl')
  !menu.add('CALLBACK', 'DB Changes...', |!!displayOutput('Change')|, 'DBChanges')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Measure Distance...', |!!gphViews.measure('DISTANCE')|, 'MeasureDistance')
  !menu.add('CALLBACK', 'Measure Angle...', |!!gphViews.measure('ANGLE')|, 'MeasureAngle')
  !menu.add('CALLBACK', 'Axes...', |!!gphViews.tag('AXES')|, 'Axes')
  -- Added Global Communications and (Locking and Isolation) form
  if (!isGlobal) then
    !menu.add('SEPARATOR')
    !menu.add('menu', 'Global Status',            'glbStates')

     ----------------------------- Global State Menu -----------------------------
    !glbStates      = !this.newMenu('glbStates')
    if(undefined(!!admControl)) then
      call !!comDefineGlobal(object ADMCONTROL())
    endif
    if(!!admControl.isValid('Locking and Isolation')) then
      !glbStates.add('callback',  'Locking & Isolation...',  'show !!glbQryLockIsol')
    endif

    -- None off line working
    if(!!admControl.isValid('Communications')) then
      !glbStates.add('callback',  'Communications...',       'show !!glbModulesPing')
    endif
  endif
  ------------------------------------------------------------------------
  -- Settings pulldown Menu
  ------------------------------------------------------------------------
  !menu = !this.newMenu('settings')
  !menu.add('CALLBACK', 'System...', '!!comSysOpt.edit()', 'System')
  !menu.add('CALLBACK', 'Graphics...', 'show !!gphsettings free', 'Graphics')
  !menu.add('CALLBACK', 'Naming...', '!!namOpt.edit()', 'Naming')
  !menu.add('FORM', 'Units...', 'comFormatsSelect', 'Units')
  !menu.add('MENU', 'Coordinates', 'sysCoord', 'Coordinates')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Spooling...', '!!splGenOpt.edit()', 'Spooling')
  !menu.add('CALLBACK', 'Numbering...', '!!splNumOpt.edit()', 'Numbering')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Comparison Date...', |!!compdate('MENU','SET')|, 'ComparisonDate')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Explorer...', '', 'Explorer Settings')
  !menu.add('CALLBACK', 'Reset Window Layout', '', 'RESET LAYOUT')

  -- Sub menus for settings pulldown menu
  ------------------------------------------------------------------------
  -- Utilities pulldown Menu
  ------------------------------------------------------------------------
  !menu = !this.newMenu('utilities')
  !menu.add('CALLBACK', 'Data Consistency...', |!!loadUi('Data Consistency')|, 'DataConsistency')
  !menu.add('CALLBACK', 'Data Checker...', 'show !!chkStoreView', 'DataChecker')
  !menu.add('MENU', 'Autonaming', 'utilName', 'Autonaming')
  !menu.add('SEPARATOR')
  !menu.add('CALLBACK', 'Lists...', 'CALLIB SHOWFORM _CDCLIST', 'Lists')
  !menu.add('FORM', 'Claimlists...', 'lstClaim', 'Claimlists')
  !menu.add('CALLBACK', 'DB Listing...', |!!displayOutput('Datal')|, 'DBListing')
  if (!isGlobal) then
    !menu.add('SEPARATOR')
    !menu.add('CALLBACK', 'Transactions...', 'show !!glbTransactions', 'Transactions')
  endif
  !menu.add('SEPARATOR')
  !menu.add('MENU', 'Reporting', 'sysExpReporting', 'expreporting')
  !menu.add('MENU', 'Standard Reporting', 'sysStdReporting', 'stdreporting')
  !menu.add('MENU', 'Export', 'sysRxp', 'export')
  !menu.add('separator')
  !menu.add('CALLBACK', |Pipe Isometric...|,   |!!isdRunIso('STA', true)|   )
  !menu.add('CALLBACK', |System Isometric...|, |!!isdRunIso('SYS', true)|   )
  --!menu.add('TOGGLE',   |Show Pipe System|,    |!!isdRunIso('SHO', !!spooler.utilities.selected('Show Pipe System') )|   )

  -- Sub menus for utilities pulldown menu

  -- Autonaming
  !menu = !this.newMenu('utilName')
  !menu.add('CALLBACK', 'CE only', '!!autoNameCe(false)', 'CEonly')
  !menu.add('CALLBACK', 'CE offspring', '!!autoNameCe(true)', 'CEoffspring')

  -- Report menu
  !menu = !this.newMenu('utilRep')
  !menu.add('CALLBACK', 'Run...', |!!loadUi('Reports Run')|, 'Run')
  !menu.add('CALLBACK', 'Create...', |!!loadUi('Reports Create')|, 'Create')
  !menu.add('CALLBACK', 'Modify...', |!!loadUi('Reports Modify')|, 'Modify')
  !menu.add('CALLBACK', 'Delete...', |!!loadUi('Reports Delete')|, 'Delete')

  -- Reporting menu
  !menu = !this.newMenu('sysStdReporting')
  !menu.add('MENU', 'Reports', 'utilRep', 'reports')
  !menu.add('CALLBACK', 'Quick Reports...', 'show !!rptQuick', 'quickReports')

   -- Dev Xpress Reporting menu
  !menu = !this.newMenu('sysExpReporting')
  !menu.add('CALLBACK', 'Run Report...', '', 'Run Report')
  !menu.add('CALLBACK', 'Designer...', '', 'Reporting Designer')

  -- Review Export
  !menu = !this.newMenu('sysRxp')
  !menu.add('CALLBACK', 'Run...', 'CALLXR XEXPMAIN RUN', 'Run')
  !menu.add('CALLBACK', 'Create...', 'CALLXR XEXPMAIN CREATE', 'Create')
  !menu.add('CALLBACK', 'Modify...', 'CALLXR XEXPMAIN MODIFY', 'Modify')
  !menu.add('CALLBACK', 'Delete...', 'CALLXR XEXPMAIN DELETE', 'Delete')
  !menu.add('CALLBACK', 'Dump Attributes...', 'show !!cdxattdump at xr 0.5 yr 0.5', 'DumpAttributes')
  !menu.add('CALLBACK', 'Select Driver ...', 'CALLXR INIT
  show _CDXDRVSEL', 'SelectDriver')

  var !user user
  !u=object user(!user)
  !teamList = !u.teamList()
  do !teamName values !teamList
    if (!teamName.name eq 'AVEVANETADMIN') then
      !menu.add('SEPARATOR')
      !menu.add('CALLBACK', 'Publish To AVEVA Net Configuration', '', 'AVEVA NET Configuration')
      break
    endif
  enddo

   -- Coordinates menu
  !menu = !this.newMenu('sysCoord')
  !menu.add('TOGGLE', 'ENU', '!!setcoordinate(!this, |ENU|)', 'Enucoord')
  !menu.add('TOGGLE', 'XYZ', '!!setcoordinate(!this, |XYZ|)', 'Xyzcoord')

  --set the toggles
  var !coordinate coordinate
  if !coordinate.eq('XYZ') then
  	!menu.setFieldProperty('Xyzcoord','SELECTED',TRUE)
  else
    !menu.setFieldProperty('Enucoord','SELECTED',TRUE)
  endif

-- [AK] Fix a problem initialising the main form
  !!appCntrl.setMainForm()
  !!appCntrl.modifyMenus()

  !iconSize = 16

  !this.functions.mainForm = !this

  !!moduleMenus(!this)

  !this.activeSplDrg.setEditable(false)

  -------------------------------------------
  -- Main toolbar pixmaps
  -------------------------------------------
  !this.mtbGetWork.addPixmap(!!pml.getPathName('getwork' & !iconSize & '.png'))
  !this.mtbSaveWork.addPixmap(!!pml.getPathName('savework' & !iconSize & '.png'))
  !this.mtbAddCe.addPixmap(!!pml.getPathName('addce' & !iconSize & '.png'))
  !this.mtbRemoveCe.addPixmap(!!pml.getPathName('removece' & !iconSize & '.png'))
--  !this.mtbRemoveAll.addPixmap(!!pml.getPathName('removeall' & !iconSize & '.png'))
  --  !this.mtbNavigate.addPixmap(!!pml.getPathName('navigate' & !iconSize & '.png'))
  !this.mtbMeasure.addPixmap(!!pml.getPathName('measure' & !iconSize & '.png'))
  !this.mtbAxes.addPixmap(!!pml.getPathName('axes' & !iconSize & '.png'))

  !deleteCePix   = !!pml.getPathName('deletece' & !iconSize & '.png')
  !this.deleteCe.addPixmap(!deleteCePix)

  !this.mtbCreateList.addPixmap(!!pml.getPathName('createlist' & !iconSize & '.png'))

  !createPixmap = !!pml.getPathName('createelement' & !iconSize & '.png')
  !this.create.addPixmap(!createPixmap)

  !updatePixmap = !!pml.getPathName('spldrgnumber' & !iconSize & '.png')
  !this.update.addPixmap(!updatePixmap)

  !modifyPixmap = !!pml.getPathName('modify' & !iconSize & '.png')
  !this.modify.addPixmap(!modifyPixmap)

  !pickNavPix = !!pml.getPathName('navigate' & !iconSize & '.png')
  !this.pickNavigate.addPixmap(!pickNavPix)

  !pickAddPix = !!pml.getPathName('spldrgadd' & !iconSize & '.png')
  !this.pickAdd.addPixmap(!pickAddPix)

  !pickRemovePix = !!pml.getPathName('spldrgremove' & !iconSize & '.png')
  !this.pickRemove.addPixmap(!pickRemovePix)

  !incFieldsOnPix = !!pml.getPathName('includefieldson' & !iconSize & '.png')
  -- !incFieldsOffPix = !!pml.getPathName('includefieldsoff' & !iconSize & '.png')
  !this.includeFields.addPixmap(!incFieldsOnPix)

endmethod
